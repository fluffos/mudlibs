/*
** Weg im Hochland
** ---
** 1996-04-08 (Woody) 1.0  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:10]));
  SetProp (P_INT_SHORT, "Weg im Hochland");
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich auf einem immer schmaler werdenden Weg im Hochland. "+
    "Einige Graeser saeumen den Weg, und vor Dir erhebt sich das Gebirge, "+
    "das nun schon in bedrohliche Naehe gerueckt ist. Beim Anblick der "+
    "hohen Bergspitzen fuehlst Du die Ehrfurcht vor der Natur besonders "+
    "stark, und Du ueberlegst, ob es nicht besser waere, umzukehren.\n"));

  AddDetail ( ({"himmel", "sonne"}),
    "Strahlend blauer Himmel ueber Dir, und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden"}), bs("Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt. Er fuehrt nach Norden "+
    "ins Gebirge hinauf und nach Sueden bergab in tiefere Gefilde."));
  AddDetail ("gebirge", bs("Das Gebirge erhebt sich nach Norden hin "+
    "maechtig. Es ist die Heimat\ndiverser Gebirgsvoelker und birgt "+
    "zahllose Geheimnisse in seinen zerkluefteten Hoehen, aber auch in "+
    "seinem Inneren."));
  AddDetail ("bergspitzen", "Die Bergspitzen ragen hoch hinauf, Dir wird "+
    "beim Anblick ganz schwindlig.\n");
  AddDetail ("graeser", "Nur noch wenige Graeser durchsetzen das kahle "+
    "Landschaftsbild des Hochlands.\n");
  AddDetail ("hochland", "Du befindest Dich in ihm.\n");
  AddDetail ("landschaftsbild", "Es ist hier im Hochland ziemlich kahl.\n");
  AddDetail ( ({"bach", "baechlein"}), bs("Westlich von Dir erkennst Du ein "+
    "kleines Baechlein, das seinen Ursprung wohl im noerdlich gelegenen "+
    "Gebirge nimmt."));
  AddDetail ("temperatur", "Um die genaue Temperatur festzustellen, "+
    "benoetigst Du ein Thermometer,\naber es kommt Dir hier schon ziemlich "+
    "kuehl vor, subjektiv.\n");

  AddItem (NPC("wildkaninchen"), REFRESH_DESTRUCT);

  AddExit("nordwestoben","/d/gebirge/dusty/weg/l27");
  AddExit("nordwesten","/d/gebirge/dusty/weg/l27");
  AddExit("sueden",ROOM("room_a02"));

  SetProp (P_HIDE_EXITS, ({"nordwesten"}) );
}

