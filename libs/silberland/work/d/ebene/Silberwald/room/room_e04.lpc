/*
** Seitenweg im Silberwald
**
** 1996-03-03 (Woody) 0.1  Pilz finden
** 1996-04-08 (Woody) 1.0  Release
** 1996-06-18 (Woody) 1.1  :reset() aufrufen
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

int reisigweg;
object *pilzfound, *det;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Unterholz im Silberwald");
  SetProp (P_INT_LONG, bs(
    "Du findest Dich im Unterholz unter dichten Baeumen wieder, gerade "+
    "noch genug Platz, um sich ein wenig umsehen zu koennen. Ein kleiner "+
    "Durchlass im Suedosten fuehrt Dich auf den schmalen Seitenweg "+
    "zurueck, waehrend Du im Norden noch ein bisschen weiter "+
    "ins Dickicht vordringen kannst."));

  AddDetail ("sonne", "Durch die dichten Baeume hindurch "+
    "ist sie kaum noch zu entdecken.\n");
  AddDetail ("boden", "Am Boden siehst Du massenhaft Reisig rumliegen.\n");
  AddSpecialDetail (({"grasbueschel","gras","bueschel"}), "d_gras");
  AddDetail ( ({"weg","seitenweg","seitenpfad","pfad"}), "Du kannst im "
    "Suedosten einen schmalen Weg erkennen.\n");
  AddDetail ("dickicht", "Hier ist fast kein Durchkommen mehr.\n");
  AddDetail ("durchlass", "Der Durchlass ist gerade gross genug, dass Du "+
    "noch durchkommst.\n");
  AddDetail ("unterholz", "Du siehst einen kleinen Durchlass im Unterholz.\n");
  AddDetail ( ({"steinpilz", "steinpilze", "pilz", "pilze", "schwammerl"}),
    "Wer suchet, der findet.\n");
  AddDetail ("himmel",
    bs("Du blickst hinauf und siehst durch die dichten Zweige "+
    "hindurch einen strahlend blauen Himmel.\n"));
  AddDetail ( ({"wald", "silberwald"}), bs("Der Silberwald ist wohl der "+
    "bekannteste Wald im ganzen Land. Genau so hast Du Dir immer "+
    "schon einen Wald vorgestellt: Die sanfte Stille wird nur ab und zu "+
    "durch das leise Schreien eines Kaeuzchens unterbrochen, und abseits "+
    "des Pfades saeumen Tannen, Fichten und Foehren den Weg.\n"));
  AddDetail ( ({"baeume", "nadelbaeume", "tannen", "fichten", "foehren"}),
    bs("Die Baeume strahlen ein sattes, immerwaehrendes, beruhigendes "+
    "Gruen aus. Sie stehen hier deutlich enger beieinander und lassen "+
    "entsprechend weniger Raum fuer den Weg ueber."));
  AddDetail ("baum", "Du siehst die Baeume vor lauter Wald nicht.\n");
  AddDetail ("gruen", "Du starrst vertraeumt ins Gruene.\n");
  AddDetail ( ({"zweige", "aeste"}), "Sie werden von den Baeumen getragen.\n");
  AddDetail ( ({"geraeusche", "kaeuzchen"}),
    "Vielleicht solltest Du es mit lauschen probieren?\n");
  AddDetail ("duft", "Vielleicht solltest Du es mit riechen probieren?\n");
  AddSpecialDetail ("reisig", "d_reisig");
  AddDetail ("massen", "Massen? Ach ja, das Reisig. Es liegt in Massen am "+
    "Boden rum :).\n");

  AddSound (DEFAULT_SOUND, bs("Du hoerst neben den typischen Geraeuschen "+
    "eines Waldes das leise Plaetschern eines Baches sowie gelegentliche "+
    "Schreie eines Kaeuzchens."));
  AddSound ("geraeusche", bs("Du vernimmst all die wundervollen Geraeusche, "+
    "die in einem unvergleichlichen Ensemble die Stimmung eines ver"+
    "traeumten Waldes ausmachen."));
  AddSound ("kaeuzchen", bs("Das gelegentliche leise Schreien eines "+
    "Kaeuzchens hat eine irgendwie beruhigende Wirkung auf Dich."));
  AddSmell (({DEFAULT_SMELL, "duft"}), bs("Der Duft von Reisig und "+
    "Nadelbaeumen erinnert Dich ein wenig an Weihnachten..."));

  pilzfound = ({});
  reisigweg = 0;
  det = ({});
  AddCmd (({"raeum", "raeume"}), "raeum");
  AddCmd (({"durchsuch", "durchsuche", "such", "suche"}), "such");

  AddExit("norden", "durchs Dickicht nach Norden#"+ROOM("room_e03"));
  AddExit("suedosten", "durch einen engen Durchlass#"+ROOM("room_f05"));
}

raeum(str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WAS willst Du beiseite raeumen?\n"), 0);
  if (str=="reisig weg" || str=="reisig beiseite") {
    if (reisigweg)
      write ("Das hat schon jemand vor Dir getan.\n");
    else
    {
      write (bs("Du raeumst etwas Reisig beseite und entdeckst einige "+
        "Grasbueschel, die bisher unter dem Reisig verborgen waren."));
      say (TPN+" raeumt etwas Reisig beiseite.\n");
    }
    return (reisigweg = 1);
  }
  else
    return (notify_fail ("Das kannst Du nicht beiseite raeumen.\n"), 0);
}

d_reisig()
{
  if (reisigweg)
    return "Du siehst etwas beiseite geraeumtes Reisig und ein paar "+
           "Grasbueschel.\n";
  else
    return bs("Reisig liegt massenhaft am Boden. Vielleicht "+
              "ist etwas unter seinen Massen verborgen? Dazu "+
              "muesstest Du ihn allerdings erstmal beiseite raeumen.");
}

d_gras()
{
  if (!reisigweg)
    return "Ja, hier ist ein Grasbueschel. Aber Du hast es noch nicht "+
            "entdeckt!\n";
  det += ({ TP });
  return bs("Eines der Grasbueschel scheint etwas zu verbergen. Du koenntest "+
    "es ja mal durchsuchen.");
}

such(str)
{
  object ob;

  if (!stringp(str) || str=="")
    return ::imposs();

  if (member_array (TP, det) == -1)
    return (
      write ("Bevor Du etwas suchst, schau Dich erstmal genauer um!\n"), 1);

  switch (str)
  {
    case "gras":  case "in gras":  case "im gras":
    case "bueschel":  case "in bueschel":  case "im bueschel":
    case "grasbueschel":  case "in grasbueschel":  case "im grasbueschel":
      if (member_array (TP, pilzfound) == -1)
      {
        ob = clone_object(OBJ("div/pilz"));
        if (ob->move(TP) == ME_TOO_HEAVY)
        {
          write (bs(
            "Du findest einen herrlich duftenden Steinpilz. Leider "+
            "kannst Du ihn nicht mehr tragen. Du versteckst ihn daher "+
            "wieder sorgfaeltig hinter dem Grasbueschel, hinter dem Du "+
            "ihn entdeckt hast, um ihn spaeter wieder abzuholen."));
          ob->remove();
        }
        else
        {
          write (bs("Du findest einen herrlich duftenden Steinpilz und "+
            "steckst ihn sogleich ein.\n"));
          say (capitalize(TPN)+" scheint etwas gefunden zu haben.\n", TP);
          pilzfound += ({ TP });
        }
      }
      else
      {
        write (bs(
          "Du knickst ein Grasbueschel zur Seite und siehst eine Stelle, "+
          "an der vor kurzem jemand einen Pilz gefunden und mitgenommen "+
          "haben muss. Vielleicht warst es ja Du selber?\n"));
      }
      return 1;
    default:
      return ::imposs(str);
  }
}

reset()
{
  pilzfound = det = ({ });
  reisigweg = 0;
  ::reset();
}
