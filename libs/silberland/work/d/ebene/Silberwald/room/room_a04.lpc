/*
** Weg im Hochland
** ---
** 1996-04-08 (Woody) 1.0  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:16]));
  SetProp (P_INT_SHORT, "Weg im Hochland");
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich auf einem lichten Weg im Hochland. Einige Baeume "+
    "stehen hier vereinzelt rum und es wird merklich kuehler. Weiter unten, "+
    "im Suedosten, beginnt der bekannte Silberwald, weiter im Norden jedoch "+
    "fuehrt ein immer steiler werdender Weg zum hohen Gebirge hinauf. Der "+
    "kleine Bach im Westen begleitet den Weg in beide Richtungen. Ein "+
    "schmaler Steg fuehrt ueber den Bach weiter nach Westen auf einen "+
    "huegeligeren Waldweg zu. Du kannst einen kleinen Wegweiser am Wegrand "+
    "erkennen."));

  AddDetail ("wegweiser", "Hmmm, lies doch mal!\n");
  AddReadDetail ("wegweiser",
    "\n ,------------------------------------.\n"
      " |           Gebirge,                 |\n"
      " |                Felonia             |\n"
      " | Huegelland,       .                |\n"
      " |  Hobbingen,       |                |\n"
      " | Kristallwald,  ---+                |\n"
      " |    Elessar         \\_              |\n"
      " |                      ` Silberwald, |\n"
      " |                      Midas, Pier,  |\n"
      " |                     Fischerdorf    |\n"
      " `---------------.----,---------------'\n"
      "                 |    |\n"+
      "                 |    |\n\n");



  AddDetail ( ({"himmel", "sonne"}),
    "Strahlend blauer Himmel ueber Dir, und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden"}), "Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\nEr fuehrt nach Norden "+
    "ins Gebirge hinauf und nach Suedosten zum Wald hinunter.\n");
  AddDetail ("gebirge", bs("Das Gebirge erhebt sich nach Norden hin "+
    "maechtig. Es ist die Heimat\ndiverser Gebirgsvoelker und birgt "+
    "zahllose Geheimnisse in seinen zerkluefteten Hoehen, aber auch in "+
    "seinem Inneren."));
  AddDetail ( ({"wald", "silberwald"}), bs("Der Silberwald faengt etwas "+
    "weiter unten, im Suedosten an und ist wohl der bekannteste Wald im "+
    "ganzen Land, ein wunderbarer Ort der Erholung."));
  AddDetail ( ({"baum", "baeume", "nadelbaeume", "fichten"}), bs(
    "Einige Fichten stehen hier vereinzelt am Wegrand, sie sind die ersten "+
    "Anzeichen des nahen Silberwaldes."));
  AddDetail ("wegrand", "Am Wegrand stehen einige Fichten, hinter ihnen "+
    "im Westen plaetschert ein\nBaechlein seelenruhig bergab. Ausserdem "+
    "entdeckst Du einen Wegweiser.\n");
  AddDetail ( ({"bach", "baechlein"}), bs("Westlich von Dir erkennst Du ein "+
    "kleines Baechlein, das seinen Ursprung wohl im noerdlich gelegenen "+
    "Gebirge nimmt."));
  AddDetail ("steg", bs("Der kleine Steg im Westen scheint auf einen "+
    "etwas huegeligeren Waldweg zuzufuehren. Du wirst neugierig."));
  AddDetail ("waldweg", bs("Der Waldweg jenseits des Stegs im Westen "+
    "scheint deutlich huegeliger zu sein. Du kannst sicher mehr erkennen, "+
    "wenn Du ihn einfach erkundest."));

  AddSound (DEFAULT_SOUND,
    bs("Du hoerst nichts als das leise Rauschen und Plaetschern "+
    "des Baechleins."));
  AddSound ( ({"rauschen", "plaetschern"}),
    bs("Du lauschst bedaechtig dem leisen Plaetschern, es beruhigt "+
    "Deine Nerven ein wenig."));

  AddExit("norden",ROOM("room_a03"));
  AddExit("westen",ROOM("steg"));
  AddExit("suedosten",ROOM("room_b05"));
}
