/*
** Weg im Silberwald
**
** 1996-01-27 (Woody) 1.0  Initial Version
** 1996-03-03 (Woody) 1.1  Klettern auf Baumstamm aktiviert, lieg auf moos
** 1996-03-06 (Woody) 1.2  detail "stamm" incl. "kletter/... auf stamm"
** 1996-04-08 (Woody) 1.3  LONG ueberarbeitet
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Weg im Silberwald");
  SetProp (P_INT_LONG, bs(
    "Der Weg wird zunehmends steiler, auch die Baeume stehen nicht mehr so "+
    "dicht beieinander wie weiter unten. Sie scheinen nicht mehr ganz den "+
    "festen Halt im Erdreich vorzufinden, der sie weiter suedoestlich so "+
    "zahlreich auftreten laesst. Dafuer hoerst Du das Plaetschern des "+
    "Baechleins umso lauter."));

  AddDetail ("sonne", "Durch die dichten Baeume hindurch "+
    "ist sie kaum noch zu entdecken.\n");
  AddDetail ( ({"pfad", "weg", "boden"}), "Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\nEr steigt nach Nordwesten hin "+
    "deutlich an und faellt nach Suedosten ab.\n");
  AddDetail ( ({"steinpilz", "steinpilze", "pilz", "pilze", "schwammerl"}),
    "Wer suchet, der findet.\n");
  AddDetail ("himmel",
    bs("Du blickst hinauf und siehst durch die dichten Zweige "+
    "hindurch einen strahlend blauen Himmel.\n"));
  AddDetail ("erdreich", "Es bietet den Baeumen hier noch ein wenig Halt.\n");
  AddDetail ( ({"wald", "silberwald"}), bs("Der Silberwald ist wohl der "+
    "bekannteste Wald im ganzen Land. Genau so hast Du Dir immer "+
    "schon einen Wald vorgestellt: Die sanfte Stille wird nur ab und zu "+
    "durch das leise Schreien eines Kaeuzchens unterbrochen, leises "+
    "Plaetschern laesst auf einen nahen Bach schliessen, und abseits "+
    "des Pfades saeumen Tannen, Fichten und Foehren den Weg.\n"));
  AddDetail ( ({"baeume", "nadelbaeume", "tannen", "fichten", "foehren"}),
    "Die Baeume strahlen ein sattes, immerwaehrendes, beruhigendes Gruen aus.\n");
  AddDetail ("baum", "Du siehst die Baeume vor lauter Wald nicht.\n");
  AddDetail ("gruen", "Du starrst vertraeumt ins Gruene.\n");
  AddDetail ( ({"zweige", "aeste"}), "Sie werden von den Baeumen getragen.\n");
  AddDetail ("waldbewohner", "Du kannst sie zwar nicht sehen, vernimmst aber "+
    "ihre Geraeusche.\n");
  AddDetail ( ({"geraeusche", "plaetschern", "kaeuzchen"}),
    "Vielleicht solltest Du es mit lauschen probieren?\n");
  AddDetail ("duft", "Vielleicht solltest Du es mit riechen probieren?\n");
  AddDetail ("reisig", "Es liegt in Massen auf dem ausgetrampelten Pfad.\n");

  AddSound (DEFAULT_SOUND, bs("Du hoerst neben den typischen Geraeuschen "+
    "eines Waldes das leise Plaetschern eines Baches sowie gelegentliche "+
    "Schreie eines Kaeuzchens."));
  AddSound ("geraeusche", bs("Du vernimmst all die wundervollen Geraeusche, "+
    "die in einem unvergleichlichen Ensemble die Stimmung eines ver"+
    "traeumten Waldes ausmachen."));
  AddSound ("plaetschern", bs("Im Suedwesten vernimmst Du das leise "+
    "Plaetschern eines Baechleins, das wohl seinen Ursprung irgendwo im "+
    "noerdlich gelegenen Gebirge hat."));
  AddSound ("kaeuzchen", bs("Das gelegentliche leise Schreien eines "+
    "Kaeuzchens hat eine irgendwie beruhigende Wirkung auf Dich."));
  AddSmell (({DEFAULT_SMELL, "duft"}), bs("Der Duft von Reisig und "+
    "Nadelbaeumen erinnert Dich ein wenig an Weihnachten..."));

  AddDetail ( ({"bach", "baechlein"}), bs(
    "Das kleine vertraeumte Baechlein plaetschert ruhig vor sich hin. "+
    "Ein etwas dickerer, teilweise mit Moos bewachsener Baumstamm liegt "+
    "quer ueber dem Bach."));
  AddDetail ( ({"baumstamm","baum","stamm"}), bs("Der Baumstamm scheint "+
    "relativ kraeftig zu sein. Gewiss kann er jemanden ohne groessere "+
    "Probleme tragen."));
  AddDetail ( ({"moos", "moosbewuchs"}), bs("Der Baumstamm duerfte schon "+
    "laenger hier querliegen, das herrlich satte Gruen des Moosbewuchses "+
    "duerfte jedenfalls nicht ueber Nacht entstanden sein. Am liebsten "+
    "wuerdest Du es Dir darauf so richtig gemuetlich machen."));

  AddCmd ( ({"lieg","liege"}), "liege");
  AddCmd ( ({"kletter","klettere","steig","steige","betritt","betrete"}),
    "kletter");

  AddExit("nordwesten",ROOM("room_b05"));
  AddExit("suedosten",ROOM("room_d07"));
}

liege(string str)
{
  notify_fail ("Wo willst Du es Dir bequem machen?\n");
  if (!stringp(str)) return 0;
  switch (str)
  {
    case "im moos": case "in moos": case "in dem moos":
    case "auf moos": case "auf dem moos":
      notify_fail ("Dazu musst Du schon erst auf den Baumstamm rauf.\n");
      break;
    case "moos":
      notify_fail ("Deine Grammatik laesst ziemlich zu wuenschen uebrig.\n");
      break;
    default:
      notify_fail ("Da kannst Du nicht liegen!\n");
  }
  return 0;
}

kletter(string str)
{
  notify_fail ("Wo willst Du hin?\n");
  if (stringp(str))
    switch (str)
    {
      case "baum": case "auf baum": case "auf den baum":
      case "stamm": case "auf stamm": case "auf den stamm":
      case "baumstamm": case "auf baumstamm": case "auf den baumstamm":
        TP->move (ROOM("room_b07"), M_GO, "auf einen Baumstamm",
          "klettert", "kommt heraufgeklettert");
        return 1;
      case "":
        break;
      default:
        notify_fail ("Dahin kommst Du von hier aus nicht!\n");
    }
  return 0;
}
