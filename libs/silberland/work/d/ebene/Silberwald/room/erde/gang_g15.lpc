#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:18]));
  SetProp(P_INT_SHORT, "Unter der Erde");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem riesigen Maulwurfsgang, um Dich herum ist "+
    "nur Erde, Erde und nochmals Erde, und ein paar kleine Steinchen. Du "+
    "kannst wohl nichts anderes machen als dem Gang ins Ungewisse zu "+
    "folgen.");
  SetProp(P_KILL_NAME, "Ungeschicktes Klettern");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({"gang", "maulwurfsgang"}),
    "Die Maulwuerfe, die diesen grossen Gang geschaffen haben, muessen "+
    "wirklich gross gewesen sein, dass sogar Du hier Platz findest.");
  AddDetail( ({"maulwuerfe"}),
    "Sie sind die Erschaffer dieses Ganges.");
  AddDetail( ({"platz"}),
    "Vermutlich das einzige, was Du hier einnimmst.");
  AddDetail( ({"erschaffer"}),
    "Bezueglich des Ganges, in dem Du stehst, waren das Maulwuerfe.");
  AddDetail( ({"erde"}),
    "Erde, Erde, und nochmals Erde, wohin Dein Auge reicht.");
  AddDetail( ({"auge"}),
    "Dein Auge gewoehnt sich nur langsam an die Dunkelheit.");
  AddDetail( ({"dunkelheit"}),
    "Das, was hier herrscht.");
  AddDetail( ({"stein", "steinchen", "steine"}),
    "Ab und zu findet sich ein kleines Steinchen in den Erdmassen.");
  AddDetail( ({"erdmassen", "massen"}),
    "Erde in Massen nennt man Erdmassen.");
  AddDetail( ({"boden", "waende", "wand"}),
    "Alles aus Erde.");
  AddDetail( ({"decke"}),
    "Du kannst ein kleines Loch in der Decke erkennen. Vielleicht kannst "
    "Du ja da durch hoch zurueck ins Freie klettern? Es scheint aber nicht "
    "ganz ungefaehrlich zu sein...");
  AddDetail( ({"loch"}),
    "Das Loch in der Decke koennte Freiheit fuer Dich bedeuten, aber das "+
    "hochklettern erfordert bestimmt einiges an Geschick!");
  AddSound( DEFAULT_SOUND,
    "So sehr Du Dich auch anstrengst, hier tief unter der Erde kannst Du "+
    "beim besten Willen nichts hoeren.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier unten ziemlich muffig.");
  // DETAILS END

  // EXITS START
  AddExit("norden", "./gang_g14");
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd( ({"kletter", "klettere"}), "klettere" );
}

int klettere(string str)
{
  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  if (member( ({"hoch", "raus", "rauf", "durch loch", "loch"}) , str) == -1)
    return 0;
  write ("Du faengst an zu klettern... ");
  if (random(20) > TP->QueryAttribute(A_DEX)) {
    write ("stuerzt aber ungeschickterweise wieder ab.\n");
    say (CAP_TPN+" stuerzt bei einem Kletterversuch klaeglich ab.\n");
    TP->do_damage(5);
    return 1;
  }
  write ("und tatsaechlich, Du schaffst es!\n"
    "Nur langsam gewoehnen sich Deine Augen wieder ans Licht...\n");
  TP->move(PARK("room/room_g15"), M_GO | M_NO_SHOW,
    "ins Freie", "klettert", "kommt aus der Erde geklettert");
  return 1;
}
