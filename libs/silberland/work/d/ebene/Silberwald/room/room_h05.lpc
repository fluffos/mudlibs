inherit "std/room";

#pragma strict_types

#define PEGASUS_ID	"\a\n\a\tol_susagep"
#define PEGASUS_FN	"/d/nacht/anatol/rassen/r/susagep"

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"


string detNase() {
    if (this_player()) 
        say(break_string(this_player()->Name(WER)+ " schielt."));
  return "Du schielst.\n";
}

public void create() {
    ::create();
    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
    SetProp(P_INT_SHORT, "Lichtung im Silberwald");
    SetProp(P_INT_LONG,    // Obacht, _query_int_long()!
        "Du befindest Dich auf einer kleinen Lichtung mitten im Silberwald, "
        "direkt neben einem kleinen Seitenpfad. Am westlichen Rand steht eine "
        "kleine Huette, ansonsten, scheint es, als haetten die "
        "Baeume hier viel Platz gelassen.");

    AddDetail("huette",
        "Hier hat Silvia eine Huette gebaut - Du kannst sie nach Westen "
        "betreten.");
    AddDetail("sonne", "Von hier ist sie wieder hell und klar zu sehen.");
    AddDetail(({"seitenpfad","pfad","weg"}), "Du befindest Dich "+
        "auf einer Lichtung neben einem kleinen Seitenpfad.");
    AddDetail(({"boden"}),
        "Die Lichtung ist grasbewachsen. Am Rand der Lichtung hat sich etwas "
        "Reisig angesammelt, etwas weiter in der Mitte kannst Du zwei oder "
        "drei seltsame Haufen ausmachen.");
    AddDetail(({"lichtung","rand"}),
        "Die Lichtung ist so gross, dass hier ein ausgewachsener Greif "
	"landen koennte.");
    AddDetail("greif",
        "Du schaust Dich um - kein Greif. Glueck gehabt.");
    AddDetail("glueck",
        "Glueck ist, wenn man in der Nahrungskette so weit hinten steht, "
	"dass man allen, die noch weiter hinten sind, bequem aus dem Weg gehen "
	"kann.");
    AddDetail("nahrungskette",
        "Du stehst, vermutlich, eher weiter hinten in der Nahrungskette. Ein Greif "
	"kaeme aber noch nach Dir. Uh-oh.");
    AddDetail("pferd",
        "Du schaust hinter ein oder zwei Grashalmen - "
        "nirgendwo ist ein Pferd dahinter.");
    AddDetail(({"grashalm","grashalme","halm"}),
        "Die meisten Grashalme sind angeknabbert.");
    AddDetail(({"raum","platz"}),
        "Der Wald hat hier Raum fuer... etwas... geschaffen.");
    AddDetail("gras",
        "Das Gras ist recht kurz gerupft, wer war das wohl...?");
    AddDetail(({"pferdeaepfel","pferdeapfel","haufen",
             "seltsamer haufen","seltsame haufen"}),
        "Iiiiiiiiiiiiih, Pferdeaepfel! Wobei.. diese hier zeichnet ein "
        "seltsamer silbriger Glanz aus. Wer oder was auch immer sie da "
        "hinge... legt hat, es war kein normales Pferd. "
	"Bloss nicht dran riechen!");
    AddDetail(({"glanz","silbriger glanz"}),
        "Der silbrige Glanz auf den Pferdeaepfeln, der ist wirklich "
        "seltsam. ");
    AddDetail(({"steinpilz", "steinpilze", "pilz", "pilze", "schwammerl"}),
        "Wer suchet, der findet.");
    AddDetail("himmel",
        "Du blickst hinauf und siehst fast unverdeckt einen strahlend "
        "blauen Himmel.");
    AddDetail( ({"wald", "silberwald"}), "Der Silberwald ist wohl der "
        "bekannteste Wald im ganzen Land. Genau so hast Du Dir immer "
        "schon einen Wald vorgestellt: Die sanfte Stille wird nur ab und zu "
        "durch das leise Schreien eines Kaeuzchens unterbrochen, und abseits "
        "des Pfades saeumen Tannen, Fichten und Foehren den Weg.");
    AddDetail( ({"baeume", "nadelbaeume", "tannen", "fichten", "foehren"}),
        "Die Baeume strahlen ein sattes, immerwaehrendes, beruhigendes "
        "Gruen aus. Sie stehen hier deutlich enger beieinander und lassen "
        "entsprechend weniger Raum fuer den Weg ueber.");
    AddDetail("baum", "Du siehst die Baeume vor lauter Wald nicht.");
    AddDetail("gruen", "Du starrst vertraeumt ins Gruene.");
    AddDetail(({"zweige", "aeste"}), "Sie werden von den Baeumen getragen.");
    AddDetail(({"geraeusche", "kaeuzchen"}),
        "Vielleicht solltest Du es mit Lauschen probieren?");
    AddDetail("duft", "Vielleicht solltest Du es mit Riechen probieren?");
    AddDetail(({"rand","vergleich"}),"Der Rand der Richtung sieht, im Vergleich zu ihrer "
        "Mitte, eher nicht wie leergefegt aus.");
    AddDetail("mitte",
        "Bis auf zwei oder drei seltsame Haufen ist das Gras in der Mitte "
	"wie ausgepustet sauber.");
    AddDetail("blick",
        "Es lohnt sich vielleicht, die Lichtung etwas genauer anzuschauen.");
    AddDetail("reisig", "Ein wenig Reisig liegt auch hier. Seltsam allerdings, "
        "dass sich das Reisig am Rand der Lichtung sammelt und zwischen dem Gras in der "
	"Mitte ungewoehnlich wenig liegt. Die Baeume waeren gross genug, um ihr "
	"Reisig quer ueber die ganze Lichtung zu streuen. Wie weggewedelt...");
    AddSpecialDetail("nase","detNase");
    AddSound(({DEFAULT_SOUND,"geraeusche"}), "Du vernimmst all die "+
        "wundervollen Geraeusche, die in einem unvergleichlichen Ensemble "+
        "die Stimmung eines vertraeumten Waldes ausmachen.");
    AddSound ("ensemble", "Es klingt einfach wundervoll.");
    AddSound ("kaeuzchen", "Das gelegentliche leise Schreien eines "+
        "Kaeuzchens hat eine irgendwie beruhigende Wirkung auf Dich.");
    AddSmell (({DEFAULT_SMELL,"duft","duftnote","komposition"}), "Der Duft von Reisig und "
        "Nadelbaeumen erinnert Dich ein wenig an Weihnachten... Hier "
        "wird die Komposition allerdings von der etwas strengeren "
        "Duftnote nach Pferdeaepfeln bereichert.");
    AddSmell (({"pferdeapfel","pferdeaepfel","aepfel","haufen"}),
        "Waeh, da gehst Du mit der Nase besser nicht naeher ran.");

    // Seherhaus Silvia - in der Raumlangbeschreibung sichtbar.
    SetProp(P_HIDE_EXITS,({"westen"}));

    AddExit("suedwesten",ROOM("room_g06"));
}


// load transporter blueprint, if not loaded already. 

public void init() { 
    ::init();
    catch(call_other(PEGASUS_FN,"???"));
}

// be consistent.

public string _query_int_long() {
    string mylong;

    mylong=
        "Du befindest Dich auf einer kleinen Lichtung mitten im Silberwald, "
        "direkt neben einem kleinen Seitenpfad. Am westlichen Rand steht eine "
        "kleine Huette, ansonsten, scheint es, als haetten die "
        "Baeume hier viel Platz gelassen.";

    if (present(PEGASUS_ID))
        return break_string(mylong +
            " Es ist auch klar, warum: Gefluegelte Pferde brauchen fuer Start "
	    "und Landung offenbar viel Platz.",77);
    else
        return break_string(mylong +
            " Es ist auf den ersten Blick aber nicht zu erkennen, warum. "
	    ,77);
}

