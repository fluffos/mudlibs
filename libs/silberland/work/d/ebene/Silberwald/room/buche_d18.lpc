#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21]));
  SetProp (P_INT_SHORT, "Auf einer dicken Buche");
  SetProp (P_INT_LONG,
    "Du stehst auf den dicken, festen Aesten einer maechtigen Buche. Weit "
    "unter Dir erstreckt sich der vertraeumte Silberwald. Erstaunt stellst "
    "Du fest, dass die kleineren Zweige der Buche um Dich herum "
    "verschwunden sind und so nicht mehr beim Klettern stoeren. "
    "Am dicken Stamm des Baumes kannst Du regelmaessig angeordnete "
    "Vertiefungen erkennen, die bis zu einer weiter oben liegenden, "
    "hoelzernen Plattform fuehren.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"baum", "buche"}),
    "Die majestaetische Buche beeindruckt Dich. Sie wirkt immer noch jung "+
    "und frisch, obwohl sie schon viele Jahrzehnte alt sein muss, um eine "+
    "solche Groesse zu erreichen.");
  AddDetail ( ({"groesse"}),
    "Du kannst leider nicht erkennen, wie weit es ueber Dir noch nach oben "+
    "geht, da eine hoelzerne Plattform Deine Sicht versperrt. Von unten sah "+
    "der Baum jedenfalls riesig aus.");
  AddDetail ( ({"aeste", "ast"}),
    "Die Aeste der Buche sind dick genug, um Dich muehelos tragen zu "+
    "koennen. Durch die Aeste hindurch kannst du den weit unter Dir "+
    "liegenden Weg sehen und bekommst ein mulmiges Gefuehl. Ein Sturz aus "+
    "dieser Hoehe wuerde bestimmt toedlich enden.");
  AddDetail ( ({"angst", "gefuehl"}),
    "Die beachtliche Hoehe macht Dir trotz den dicken Aesten der Buche "+
    "Angst. Du beschliesst, bei jedem Schritt sehr vorsichtig zu sein, um "+
    "Dein Schicksal nicht noch mehr herauszufordern.");
  AddDetail ( ({"schritt"}),
    "Jeder Schritt koennte Dein letzter sein!");
  AddDetail ( ({"schicksal", "zweifel"}),
    "Je laenger Du darueber nachdenkst, desto unsicherer fuehlst Du Dich. "+
    "Du solltest wohl besser weiter nach oben klettern und alle Zweifel "+
    "hinter Dir lassen. Oder solltest Du vielleicht doch besser umkehren?");
  AddDetail ( ({"sturz"}),
    "Ein falscher Schritt... und Du waerst schneller wieder am Boden, als "+
    "Dir lieb ist.");
  AddDetail ( ({"hoehe"}),
    "Du befindest Dich schon ungefaehr 8 Meter ueber dem Boden.");
  AddDetail ( ({"boden", "weg"}),
    "Dich beschleicht ein mulmiges Gefuehl, wenn Du zwischen den Aesten "+
    "hindurch auf den weit unter Dir liegenden Boden siehst.");
  AddDetail ( ({"zweige"}),
    "Die kleineren Zweige der Buche wurden offenbar fein saeuberlich "+
    "gestutzt oder abgeschnitten, um hier ein besseres Klettern zu "+
    "ermoeglichen.");
  AddDetail ( ({"klettern"}),
    "Das machst Du gerade!");
  AddDetail ( ({"stamm"}),
    "Der Stamm der grossen Buche ist so dick, dass Du ihn selbst mit "+
    "doppelt so langen Armen nicht umfassen koenntest. Er weist "+
    "regelmaessige, rechteckige Vertiefungen auf, die bis zu einer "+
    "hoelzernen Plattform reichen und wohl beim Klettern helfen sollen.");
  AddDetail ( ({"arm", "arme"}),
    "Du umarmst den Stamm.\nDer Stamm fuehlt sich geschmeichelt. ;-)\n");
  AddDetail ( ({"plattform"}),
    "Du kannst von hier aus leider nicht viel von der Plattform erkennen. "+
    "Sie scheint aus Holz zu sein und versperrt Dir die weitere Sicht nach "+
    "oben.");
  AddDetail ( ({"holz"}),
    "Um welches Holz es sich handelt, kannst Du von hier aus nicht "+
    "erkennen.");
  AddDetail ( ({"sicht"}),
    "Eine Plattform versperrt Dir die Sicht nach oben.");
  AddDetail ( ({"vertiefung", "vertiefungen"}),
    "Sie wurden wohl absichtlich von jemandem hier angebracht, um ein "+
    "weiteres Klettern zu ermoeglichen. Jede der Vertiefungen wurde "+
    "speziell versiegelt, um den Baum nicht zu sehr zu verletzen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel wird von den vielen Zweigen verdeckt, aber Du siehst, dass "+
    "er tiefblau ist. Oder hochblau? Naja, egal. ;)");
  AddDetail ( ({"jahrzehnt", "jahrzehnte"}),
    "Ein Jahrzehnt sind zehn Jahre (welch Ueberraschung!).");
  AddDetail ( ({"ueberraschung"}),
    "Das war keine fuer Dich, oder?");
  AddDetail ( ({"jahr", "jahre"}),
    "Du weisst, was ein Jahr ist, oder?");
  AddDetail ( ({"meter"}),
    "Acht Meter sind etwa vier ausgewachsene Elfen, uebereinander "+
    "gestapelt. Aber wer will das schon ;-)");
  AddDetail ( ({"elf", "elfen"}),
    "Elfen fuehlen sich im Wald besonders wohl.");
  AddDetail ( ({"silberwald", "wald"}),
    "Der vertraeumte Silberwald erstreckt sich weit unter Dir. Du kommst "+
    "Dir auf einmal so erhaben vor...");
  AddSound ( ({DEFAULT_SOUND}),
    "Leise rascheln die Blaetter der Buche im Wind.");
  AddSound ( ({"blaetter", "rascheln"}),
    "Sie rascheln leise, bewegt durch den Wind.");
  AddSound ( ({"wind"}),
    "Er bringt die Blaetter zum rascheln.");
  AddDetail ( ({"wind"}),
    "Direkt sehen kannst Du nur, wie er die Blaetter der Buche raschelnd "+
    "bewegt.");
  AddDetail ( ({"blaetter", "blatt"}),
    "Die vielen Blaetter der Buche bewegen sich im Wind sachte hin und "+
    "her.");
  AddSmell ( ({DEFAULT_SMELL,"geruch"}),
    "Es riecht ein wenig nach Wald und Meer hier oben.");
  AddSmell ( ({"wald"}),
    "Ein leicht harziger Geruch, sehr angenehm im Abgang. ;)");
  AddSmell ( ({"abgang"}),
    "Willst Du Deinen eigenen Abgang erriechen!?\n");
  AddSmell ( ({"meer"}),
    "Ja, wie soll man das beschreiben... die Luft ist einfach frisch.");
  AddSmell ( ({"luft"}),
    "Du atmest tief ein - das tut gut!");
  // DETAILS END

  // EXITS START
  AddExit ("unten", "./room_d18");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"klopf", "klopfe"}), "klopf");
}

int klopf (string str)
{
  object ob;
  mapping m;

  notify_fail ("Wogegen willst Du klopfen?\n");
  if (!str) return 0;
  notify_fail("Dagegen kannst Du hier nicht klopfen.\n");

  if (str == "plattform" || str == "gegen plattform")
  {
    m = QueryProp(P_EXITS);
    if (!m["oben"])
      return 0;

    write("Du klopfst gegen die hoelzerne Plattform.\n");
    say(TP->Name()+" klopft gegen die hoelzerne Plattform.\n");

    if (ob = find_object(m["oben"]))
    {
      tell_room(ob,
          "Huch! Du hoerst ein Klopfen. Es scheint von unten zu kommen...\n");
    }
    return 1;
  }
  else if (str == "gegen holz" || str == "auf holz")
  {
    write("Du klopfst auf Holz. *toitoitoi*\n");
    say(TP->Name() + " klopft auf Holz. *toitoitoi*\n");
    return 1;
  }
  else if (str == "stamm" ||
           str == "auf stamm" ||
           str == "gegen stamm" ||
           str == "baum" ||
           str == "auf baum" ||
           str == "gegen baum")
  {
    write("Du klopfst gegen den Stamm. Hoert man nur fast nix davon!\n");
    say(TP->Name() + " klopft gegen den Stamm der Buche. "+
        "Ohne hoerbares Resultat.\n");
    return 1;
  }
  return 0;
}
