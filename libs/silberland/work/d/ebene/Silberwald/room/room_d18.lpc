#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

#define SCHLACHT_LOG "/d/ebene/log/schlacht.log"


inherit "std/room";


mapping canclimb = ([]);

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:21]));
  SetProp (P_INT_SHORT, "Am Waldrand");
  SetProp (P_INT_LONG,
    "Hier endet der Waldpfad, und mit ihm auch der Wald, der sich nach "
    "Norden hin jedoch weithin erstreckt und groesstenteils unerschlossen "
    "vor Dir liegt. Hier stehen nur noch einige Baeume unmotiviert am "
    "am Waldrand. Als Dein Blick weiter nach Sueden wandert, wagst Du "
    "kaum, Deinen Augen zu trauen: Du erblickst in nahezu unmittelbarer "
    "Naehe das weite, blaue Meer und einen in der Unendlichkeit "
    "verschwindenden Horizont! Doch dem Meer vorgelagert erkennst Du ein "
    "kleines Fischerdorf und ein Pier, an dem offenbar des oefteren "
    "Schiffe anlegen. Ueber die Holzbruecke weiter im Suedwesten, die "
    "ueber den ehemals kleinen, hier aber schon ziemlich rauschenden Bach "
    "fuehrt, gelangst Du dorthin.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sonne"}),
    "Die Sonne strahlt Dich an, einen schoeneren Tag als heute kannst "+
    "Du Dir kaum noch vorstellen...");
  AddDetail ( ({"tag"}),
    "Guten Tag auch.");
  AddDetail ( ({"himmel"}),
    "Der strahlend blaue Himmel lacht Dich an, und mittendrin strahlt "+
    "die Sonne, als ob sie voller guter Laune waere...");
  AddDetail ( ({"laune"}),
    "Ist das nicht herrlich?");
  AddDetail ( ({"boden", "pfad", "weg", "waldpfad"}),
    "Der Weg, den Du entlang gehst, fuehrt weiter nach Norden in den "+
    "Wald hinein und im Suedwesten auf eine Bruecke zu, hinter der Du "+
    "ein Fischerdorf und das weite Meer erkennen kannst.");
  /* baumhaus modifications */
  AddDetail ( ({"baeume", "nadelbaeume" }),
    "Der Wald ist voll von immergruenen Nadelbaeumen, die dem Wald seine "
    "vertraeumte Atmosphaere verleihen. Mehr davon gibt es wohl tiefer "
    "im Wald, weiter im Norden. Seltsam. Am Rand des Waldes siehst Du "
    "direkt an die Nadelbaeume angrenzend einen grossen Laubbaum.");
  AddDetail ( ({"waldrand","rand"}),
    "Am Rand des Nadelwaldes erblickst Du voellig verdattert einen Laubbaum.");
  AddDetail ( ({"baum"}),
    "Du musst schon etwas genauer werden.");
  AddDetail ( ({"laubbaum"}),
    "Hmmm, es scheint sich um eine grosse starke Buche zu handeln.");
  AddDetail ( ({"buche"}),
    "Du blickst empor - und erblickst ein lauschiges kleines Plaetzchen in der "
    "Buche, an dem zwischen den Aesten eine Art Plattform zu erkennen ist. "
    "Als Du den Blick wieder senkst, erkennst Du einen kleinen Eingang "
    "im Wurzelwerk.");
  AddDetail ( ({"plattform"}),
    "Genaueres kannst Du von hier unten leider nicht erkennen.");
  AddDetail ( ({"ast","aeste"}),
    "Die Aeste sind recht tragfaehig, scheint Dir.");
  AddDetail ( ({"zweig","zweige"}),
    "Klar gibts auch Zweige. Die haengen von den Aesten weg.");
  AddDetail ( ({"blatt","blaetter"}),
    "Wie jeder Laubbaum hat auch diese Buche hier Blaetter. Na toll.");
  AddDetail ( ({"plaetzchen"}),
    "Lauschig, lauschig! Lausch doch mal.");
  AddSound ( ({"plaetzchen"}),
    "Naja, hoeren kannst Du es letztendlich doch nicht.");
  AddDetail ( ({"rinde"}),
    "Du betrachest die Rinde genauer. Ihre Farbe ist irgendwie... seltsam.");
  AddDetail ( ({"farbe"}),
    "Ohweh! Hoffentlich ist es kein Rindenwahnsinn!!");
  AddDetail ( ({"rindenwahnsinn"}),
    "Wenn doch, dann muss der ganze Wald geschlachtet werden... weia.");
  AddSpecialDetail ( ({"stamm","stumpf","stuempfe","aststumpf",
        "aststuempfe"}), "d_kletterhilfe");
  AddDetail ( ({"hilfe"}),
    "Hilf Dir doch selbst!");
  AddDetail ( ({"zwerg"}),
      ([
               0 : "Zwerge auf Baeumen? Du lachst.\n",
         "zwerg" : "Du schaffst das schon.\n",
      ]) );
  /* end */
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere des Waldes ist nicht so ohne weiters beschreibbar - "+
    "man muss einfach mal einen Tag hier idlen, um sie wirklich geniessen "+
    "zu lernen...");
  AddDetail ( ({"frieden", "ruhe"}),
    "Ruhe und Frieden erfuellt Dich hier.");
  AddDetail ( ({"bach", "fluesschen", "fluss"}),
    "Der kleine vertraeumte Bach ist inzwischen fast schon ein kleiner "+
    "Fluss geworden. Die Holzbruecke weiter suedwestlich fuehrt ueber "+
    "ihn hinweg zum Fischerdorf.");
  AddSound ( ({DEFAULT_SOUND}),
    "Das Rauschen des Baches, eigentlich fast schon Fluesschens bohrt "+
    "sich durch die Stille hindurch und ist kaum zu ueberhoeren...");
  AddSound ( ({"plaetschern"}),
    "Das Plaetschern des Baches wirkt irgendwie beruhigend.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du atmest die frische Luft des Waldes ein und fuehlst Dich einfach "+
    "nur wohl.");
  AddDetail ( ({"blick"}),
    "Dein Blick verliert sich in der Unendlichkeit des Horizontes im "+
    "Sueden...");
  AddDetail ( ({"meer","weite"}),
    "Das blaue Meer erstreckt sich suedlich vor Dir in schier unendliche "+
    "Weite.");
  AddDetail ( ({"unendlichkeit"}),
    "Stell es Dir am besten so vor, dass da immer mehr ist, als Du sehen "+
    "kannst.");
  AddDetail ( ({"horizont"}),
    "Der Horizont erstreckt sich bis weit hinter das Meer in der "+
    "Unendlichkeit.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Das Fischerdorf weiter im Suedwesten jenseits der Bruecke scheint "+
    "hier ein ziemlich eigenstaendiges Leben zu fuehren.");
  AddDetail ( ({"leben"}),
    "Kannst ja mal hinschauen, wenn Du moechtest.");
  AddDetail ( ({"pier", "schiff", "schiffe"}),
    "Von hier aus kannst Du noch kaum was davon erkennen...");
  AddDetail ( ({"bruecke", "holzbruecke"}),
    "Die Bruecke fuehrt ueber den Bach, der inzwischen schon zu einem "+
    "stattlichen Fluesschen geworden ist, zum Fischerdorf hinueber.");
  AddDetail ( ({"silberwald", "wald", "nadelwald"}),
    "Du stehst hier am Anfang des Silberwaldes, den Du nach Norden hin "+
    "betreten kannst. Sein riesiges Areal ist nur zu einem Bruchteil durch "+
    "Wege erschlossen, dennoch ist er fuer seine Atmosphaere weithin "+
    "bekannt und geschaetzt.");
  AddDetail ( ({"anfang", "ende"}),
    "Es ist bestimmt nicht der Anfang vom Ende. ;-)");
  AddDetail ( ({"wege"}),
    "Auf einem dieser Wege stehst Du grade.");
  AddDetail ( ({"areal"}),
      ([
               0 : "Der Silberwald ist einfach  R I E S I G .",
         "zwerg" : "1, 2, viele Quadratmeter."
      ])
    );
  AddDetail ( ({"quadratmeter"}),
    "Ein Quadratmeter ist... ach, vergiss es. ;-)");
  AddDetail ( ({"bruchteil"}),
    "Du wirst doch nicht glauben, dass das, was Du vom Wald kennst, "
    "alles ist?");
  AddDetail ( ({"auge", "augen"}),
    "Du reibst Dir die Augen.");
  AddDetail ( ({"naehe"}),
    "Man koennte fast sagen, in greifbarer.");
  AddDetail ( ({"art"}),
    "Genau kannst Du es leider nicht erkennen.");
  AddDetail ( ({"wurzelwerk"}),
    "Im Wurzelwerk kannst Du einen etwas versteckten Eingang erkennen.");
  AddDetail ( ({"eingang"}),
    "Sieht fast so aus wie ein kleiner Durchlass.");
  AddDetail ( ({"durchlass"}),
    "Du koenntest Dich versuchen, durchzuzwaengen. Oder einfach nach "+
    "\"unten\" gehen.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", ROOM("room_d17"));
  AddExit ("suedwesten", ROOM("room_c19"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"faell", "faelle", "schlachte", "schlacht"}), "schlachten");
  AddCmd ( ({"hilf", "helf", "helfe"}), "hilf");
  AddCmd ( ({"kletter", "klettere"}), "kletter");
  AddCmd ( ({"zwaeng", "zwaenge"}), "zwaeng");

  // SPECIAL SETTINGS
  SetProp( P_HIDE_EXITS, ({ "unten" }) );
}

int kletter(string str)
{
  string origstr;

  if (!str)
    return notify_fail ("Wohin willst Du klettern?\n"), 0;

  // too easy ;)
  if (str == "rauf" || str == "hinauf" || str == "empor")
    return notify_fail("Und wohin genau willst Du klettern?\n"), 0;

  // simplify parsing
  str = regreplace( str, "\\<laubbaum\\>", "buche", 0 );
  origstr = str;
  str = regreplace( str,
      "(ueber|an|mit *(hilfe)*) " +
      "(den |der |von (den )*)*(ast)*(stumpf|stuempfen*)",
      "", 0 );
  str = regreplace( str, "^  *", "", 0);
  str = regreplace( str, "  *$", "", 0);
  str = regreplace( str, "   *", " ", 1);
  // write(sprintf("Vereinfacht auf %O\n", str));

  if (str != origstr) {
    canclimb[getuid(TP)] = 1;
    notify_fail("Und wohin genau willst Du klettern?\n");
  }
  else
    notify_fail("Dahin kannst Du von da aus nicht klettern!\n");

  if (str[0..3] == "auf ") str = str[4..];      // simplify parsing
  if (str != "buche" && str != "buche empor" &&
      str != "buche hinauf" && str != "buche rauf" &&
      str != "buche hoch" && str != "auf buche")
    return 0;

  if (canclimb[getuid(TP)])
  {
    write("Geschickt kletterst Du an den Aststuempfen nach oben.\n");
    TP->move(ROOM("buche_d18"), M_GO,
        "die Buche empor", "klettert", "kommt heraufgeklettert");
  }
  else
  {
    write(BS("Du versuchst, den Stamm der Buche emporzuklettern, rutscht "
          "aber immer wieder ab. Vielleicht solltest Du den Baum vorher "
          "etwas genauer unter die Lupe nehmen?"));
    say(BS(TP->Name() + " versucht, einen Baum zu erklimmen, scheitert "
          "aber klaeglich."));
    TP->command_me("weine");
  }
  return 1;
}

int zwaeng(string str)
{
  mixed exits;
  exits = QueryProp(P_EXITS);
  if (!exits["unten"]) return 0;

  notify_fail ("Wo willst Du Dich durchzwaengen?\n");
  if (str != "durch durchlass") return 0;

  TP->command_me("unten");
  TP->move(exits["unten"], M_GO,
      "durch einen Durchlass", "zwaengt sich", "zwaengt sich herein");

  return 1;
}

int hilf(string str)
{
  object ob;

  notify_fail ("Wem willst Du helfen?\n");
  if (!str) return 0;

  ob = find_player(str);
  if (!ob && present(str,TO) && living(present(str,TO)))
    ob=present(str,TO);

  if (str=="dir"||str=="mir"||str=="dir selbst"||str=="mir selbst"||ob==TP)
  {
    write("Du hilfst Dir selbst. Wobei eigentlich?\n");
    say(TP->Name()+" hilft sich selbst, wobei auch immer...\n");
    return 1;
  }

  if (!ob)
    return notify_fail("So jemanden kennst Du nicht.\n"), 0;

  if (environment(ob) != TO)
  {
    if ( ob->Message( TP->Name() + " will Dir helfen, wie aufmerksam!\n",
          MSGFLAG_TELL ) == MESSAGE_OK )
      notify_fail(ob->Name()+" ist zu weit weg von Dir, "
          "freut sich aber bestimmt.\n");
    else
      notify_fail("");

    return 0;
  }

  write("Du hilfst "+ob->name(WEM)+", wie aufmerksam von Dir!\n");
  tell_room(ME, TP->Name()+" hilft "+ob->name(WEM)+", wie aufmerksam!\n",
      ({ TP,ob }) );
  ob->Message(TP->Name()+" hilft Dir, wie aufmerksam von "+
      TP->QueryPronoun(WEM)+"!\n", MSGFLAG_SOUL);

  return 1;
}

int schlachten(string str)
{
  object ob;

  notify_fail ("Was willst Du schlachten?\n");
  if (!str) return 0;

  if (str[<3..] == " ab")
    str = str[0..<4];

  if (str=="baum" || str=="baeume" || str=="wald")
  {
    object waf;
    if (!(waf = TP->QueryProp(P_WEAPON)) ||
        (waf->QueryProp(P_WEAPON_TYPE) != WT_AXE))
      return notify_fail("Du solltest dazu schon eine "
          "gezueckte Axt haben!\n"), 0;

    if (this_player()->QueryProp(P_ATTACK_BUSY))
      return write("Du bist noch zu erschoepft dazu.\n"),1;
    this_player()->SetProp(P_ATTACK_BUSY, 4);

    write(break_string("Du holst ganz weit mit "+waf->name(WEM,1)+
          " aus und drischt wie verrueckt auf die arme Buche ein. "
          "Doch scheinst Du nicht mit der Haerte ihrer Rinde "
          "gerechnet zu haben... "+waf->name(WEM,1)+" scheint es "
          "nicht so gut getan zu haben :-(", 78));
    Message(break_string(TP->Name()+" holt ganz weit mit "+waf->name(WEM)+
          " aus und drischt wie verrueckt auf die arme Buche ein. "
          "Doch "+TP->QueryPronoun()+" scheint nicht mit der Haerte "
          "der Rinde gerechnet zu haben... "+waf->name(WEM,1)+" scheint es "
          "nicht so gut getan zu haben.", 78), MSGFLAG_NO_TP | MSGFLAG_VISUAL);
    write_file (SCHLACHT_LOG,
        sprintf ("[%s] %s schlachtet: '%s' mit %s [%O]\n",
          ctime()[4..], capitalize(getuid(TP)), str, waf->name(WEM), waf));
    // Erst nach dem mitloggen die waffe beschaedigen, die koennte ja kaputt gehen. (Feyaria)
    waf->Damage(random(10)+11);
    if (!objectp(waf))
      write_file (SCHLACHT_LOG,
          sprintf ("[%s] %s verliert die Axt.\n",
            ctime()[4..], capitalize(getuid(TP))));
    return 1;
  }
  else if (ob=present(str,TO))
  {
    write_file (SCHLACHT_LOG,
        sprintf ("[%s] %s schlachtet %s\n",
          ctime()[4..], capitalize(getuid(TP)), ob->name(WEN)));
    if (query_once_interactive(ob))
      if (ob==TP)
        write("Selbstmord ist WIRKLICH keine Loesung!\n");
      else
        write("Um Himmels willen! Du willst doch keinen Playerkill begehen!\n");
    else if (living(ob))
      write("NPCs schlachte man anders ab.\n");
    else
      write("Hae? "+ob->Name(WEN)+" schlachten? Gehts Dir noch ganz gut?\n");
    return 1;
  }
  return 0;
}

string d_kletterhilfe(string was)
{
  canclimb[getuid(TP)] = 1;
  if (was=="stamm")
    return BS("Der Stamm mit seiner alten Rinde weist ein paar abgehackte "
           "Aststuempfe auf, an denen Du eventuell hochklettern koenntest.");
  else  // "stumpf","stuempfe","aststumpf","aststuempfe"
    return "Mit denen als Hilfe muesste das sogar ein Zwerg schaffen.\n";
}
