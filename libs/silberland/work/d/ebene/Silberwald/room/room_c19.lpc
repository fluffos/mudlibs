#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#define FISCHERDORF(x) WASSER("woody/fischerdorf/"+x)

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Vor einer Bruecke");
  SetProp (P_INT_LONG,
    "Du stehst unmittelbar vor einer Holzbruecke, die ueber einen kleinen "+
    "Fluss nach Westen hin weiter zu einem kleinen Fischerdorf und zum "+
    "Meer bringt. Weiter nach Nordosten hin fuehrt ein kleiner Waldpfad "+
    "hinein in den Silberwald, der fuer seine wunderbare, entspannende "+
    "Atmosphaere weithin bekannt ist.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sonne"}),
    "Die Sonne strahlt Dich an wie in ihren besten Tagen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ueber Dir ist tiefblau, keine einzige Wolke ist zu sehen.");
  AddDetail ( ({"bruecke", "holzbruecke"}),
    "Die Holzbruecke fuehrt ueber einen kleinen Fluss hinueber zum "+
    "Fischerdorf nach Westen und in weiterer Folge zum Meer.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Das Fischerdorf liegt weiter im Westen, mehr erkennst Du wohl, wenn "+
    "Du einfach hingehst...");
  AddDetail ( ({"pfad", "waldpfad"}),
    "Der Waldpfad fuehrt nach Nordosten hin in den beruehmten Silberwald "+
    "hinein.");
  AddDetail ( ({"silberwald", "wald"}),
    "Noerdlich von Dir erstreckt sich der Silberwald in seiner "+
    "unglaublichen Groesse und Schoenheit, allerdings ist er nur zum Teil "+
    "durch Pfade erschlossen...");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere ist unbeschreiblich und wird daher auch hier nicht "+
    "beschrieben...");
  AddDetail ( ({"boden"}),
    "Der lehmige Boden unter Dir ist schon etwas ausgetrampelt.");
  AddDetail ( ({"lehm"}),
    "Einfacher, trockener Lehm.");
  AddDetail ( ({"meer"}),
    "Das blaue Meer erstreckt sich suedlich vor Dir in schier unendliche "+
    "Weite.");
  AddDetail ( ({"weg"}),
    "Das, worauf Du Dich gerade befindest. Er fuehrt weiter nach Nordosten "+
    "in den Wald hinein und endet hier vor einer Bruecke im Westen.");
  AddDetail ( ({"fluss"}),
    "Der kleine Fluss rauscht unter der Bruecke hindurch weiter hinab zum "+
    "Ufer, wo er ins weite, blaue Meer muendet.");
  AddDetail ( ({"ufer"}),
    "Das Ufer ist da, wo das Meer anfaengt.");
  AddDetail ( ({"weite"}),
    "Schier unendlich.");
  AddDetail ( ({"pfade"}),
    "Einer dieser Pfade fuehrt nach Nordosten in den Wald hinein.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst nur das Rauschen des Flusses im Westen.");
  AddSound ( ({"rauschen"}),
    "Es rauscht bestaendig vor sich hin.");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("room_d18"));
  AddExit ("westen", FISCHERDORF("room/bruecke"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
