/*
** Weg im Silberwald
**
** 1996-04-08 (Woody) 1.0  Initial Version
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Flachland");
  SetProp (P_INT_LONG, bs(
    "Ein stattlicher Weg fuehrt durch eine sanfte, flache Landschaft. "+
    "Westlich von Dir legt sich eine gruene Grasdecke ueber das Land, "+
    "weiter im Sueden kannst Du einen groesseren Park erkennen, zu dem "+
    "ein kleiner Weg nach Suedwesten fuehrt. Gegen Norden hingegen geht "+
    "es langsam aufwaerts in hoehere Gegenden, vermutlich auf einen Wald "+
    "zu. Im Osten siehst Du eine lange Stadtmauer, die wohl eine grosse "+
    "Stadt umgeben muss. Ein kleines Schild steht am Wegrand."));

  AddDetail (({"wegrand","rand"}), "Da steht ein kleines Schild umher.\n");
  AddDetail ("schild",
      "Das Schild zeigt nach Suedwesten. Ausserdem kannst Du es lesen.\n");
  AddReadDetail ("schild",
    "\n ,-----------------------------.\n"+
      " |  A N F A E N G E R P A R K  |\n"+
      " `-------------.    ,----------'\n"+
      "               |    |\n\n");
  AddDetail (({"himmel","sonne"}), "Strahlend blauer Himmel ueber Dir, "+
    "und mitten in ihm die helle Sonne.\n");
  AddDetail (({"pfad","weg","boden"}), "Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\n");
  AddDetail (({"gras","grasdecke"}), bs("Im Westen kannst Du eine weite "+
    "Wiese ausmachen, die Du aber wegen einer Abzaeunung nicht direkt "+
    "erreichen kannst."));
  AddDetail ("wiese", bs("Die Wiese hinter der Abzaeunung im Westen scheint "+
    "gross, gruen und saftig zu sein. Seltsamerweise ist jedoch weit und "+
    "breit keine Kuh in Sicht."));
  AddDetail ("abzaeunung", "Sie hindert Dich daran, die Wiese von hier "+
    "aus direkt zu betreten.\n");
  AddDetail (({"land","landschaft"}), "Die Landschaft ist vorwiegend "+
    "flach und gruen.\n");
  AddDetail ("park", bs("Der Park weiter im Sueden scheint fuer Anfaenger "+
    "gedacht zu sein. Betreten kannst Du ihn Richtung Suedwesten."));
  /*
  AddDetail (({"feld","felder"}), bs("Die Felder im Sueden werden von den "+
    "Bauern bestellt, um die nahe Stadt mit Getreide zu versorgen."));
  */
  AddDetail ("stadt", "Die Stadt liegt weiter im Osten.\n");
  AddDetail ("stadtmauer", bs("Weiter im Osten erkennst Du eine maechtige "+
    "Stadtmauer. In ihrer Mitte befindet sich ein grosser Torbogen, am "+
    "linken und rechten Ende erkennst Du zwei hoehere Aussichtstuerme."));
  AddDetail ("torbogen", "Durch den Torbogen kann man die Stadt vermutlich "+
    "betreten.\n");
  AddDetail (({"tuerme","aussichtstuerme"}), bs("Die Aussichtstuerme sind "+
    "ziemlich hoch. Bestimmt kann man von dort oben so manches erkennen, "+
    "was einem bei einer Betrachtung aus der Naehe verborgen bleibt. Und "+
    "eine tolle Aussicht hats dort oben sicher auch."));
  AddDetail ("wald", "Du koenntest versuchen, auf dem Pfad zu ihm zu "+
    "gelangen.\n");

  AddExit("nordwesten",ROOM("room_i11"));
  AddExit("suedwesten",PARK("room/room_i13"));
  AddExit("osten",ROOM("room_k12"));

  AddItem (NPC("kuh"), REFRESH_DESTRUCT);
}
