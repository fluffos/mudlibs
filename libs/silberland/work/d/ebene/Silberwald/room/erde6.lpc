#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Unter der Erde");
  SetProp (P_INT_LONG,
    "Du befindest Dich in einem riesigen Maulwurfsgang, um Dich herum ist "+
    "nur Erde, Erde und nochmals Erde, und ein paar kleine Steinchen. Du "+
    "kannst wohl nichts anderes machen als dem Gang ins Ungewisse zu "+
    "folgen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"gang", "maulwurfsgang"}),
    "Die Maulwuerfe, die diesen grossen Gang geschaffen haben, muessen "+
    "wirklich gross gewesen sein, dass sogar Du hier Platz findest.");
  AddDetail ( ({"maulwuerfe"}),
    "Sie sind die Erschaffer dieses Ganges.");
  AddDetail ( ({"platz"}),
    "Vermutlich das einzige, was Du hier einnimmst.");
  AddDetail ( ({"erschaffer"}),
    "Bezueglich des Ganges, in dem Du stehst, waren das Maulwuerfe.");
  AddDetail ( ({"erde"}),
    "Erde, Erde, und nochmals Erde, wohin Dein Auge reicht.");
  AddDetail ( ({"auge"}),
    "Dein Auge gewoehnt sich nur langsam an die Dunkelheit.");
  AddDetail ( ({"dunkelheit"}),
    "Das, was hier herrscht.");
  AddDetail ( ({"stein", "steinchen", "steine"}),
    "Ab und zu findet sich ein kleines Steinchen in den Erdmassen.");
  AddDetail ( ({"erdmassen", "massen"}),
    "Erde in Massen nennt man Erdmassen.");
  AddSound ( ({DEFAULT_SOUND}),
    "So sehr Du Dich auch anstrengst, hier tief unter der Erde kannst Du "+
    "beim besten Willen nichts hoeren.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht hier unten ziemlich muffig.");
  AddDetail ( ({"boden", "decke"}),
    "Alles aus Erde.");
  AddDetail ( ({"waende"}),
    "Die Waende sind allesamt voller Erde. Die Westwand faellt Dir auf.");
  AddDetail ( ({"wand", "westwand"}),
    "Die Erde in der Westwand scheint etwas lockerer zu sein, vielleicht "+
    "kannst Du Dich ja nach Westen durchgraben?");
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd (({"grab", "grabe"}), "grabe");
}

int grabe(string str)
{
  notify_fail("Wohin willst Du Dich durchgraben?\n");
  if (!str) return 0;
  if (member( ({"nach westen", "durch westwand",
                "durch westwand durch", "nach westen durch"}),
              str) == -1) return 0;
  write ("Du graebst Dich muehsam nach Westen durch.\n");
  TP->move(ROOM("erde5"), M_GO,
    "durch die Westwand", "graebt sich", "kommt hereingeklettert");
  return 1;
}
