#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Eine Lichtung");
  SetProp (P_INT_LONG,
    "Du stehst auf einer Lichtung mitten im Silberwald, die nur Magier "+
    "betreten koennen. Das macht die Lichtung irgendwie geheim - findest "+
    "Du jedenfalls. Das Licht der Sonne faellt durch die Baeume und "+
    "erhellt diesen Platz, die Lichtflecken tanzen regelrecht am Boden, "+
    "als der Wind durch die Aeste streicht.");
  SetProp (P_HIDE_EXITS, ({ "osten" }) );
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sonne"}),
    "Die Sonnenstrahlen fallen auf Dein Gesicht und waermen es sanft.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "./room_b07");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
