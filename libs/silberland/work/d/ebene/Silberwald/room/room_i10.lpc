/*
** Anstieg zum Silberwald
** ---
** 1996-04-08 (Woody) 1.0  Initial Version
** 1996-09-02 (Woody) 1.1  kein neuer Uhu nach Reset, wenn noch einer da ist
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

#define UHU NPC("uhu")

int cloned;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Ein Anstieg");
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich auf einem leicht ansteigenden Pfad. Einzelne Baeume "+
    "saeumen den Weg, weiter im Nordwesten scheint ein groesserer Wald "+
    "zu sein, waehrend gegen Sueden hin das Land zusehends flacher wird. "+
    "Ein kleiner Weg fuehrt ausserdem nach Nordosten ins Ungewisse, "+
    "am Anfang desselben kannst Du ein kleines Schild erkennen."));

  AddDetail ("schild", "Hmmm, lies doch mal!\n");
  AddReadDetail ("schild",
    "\n ,-------------------------.\n"+
      " |  F e e n s c h l o s s  |\n"+
      " `----------.    ,---------'\n"+
      "            |    |\n\n");

  AddDetail ("land",
    "Das Land im Sueden scheint etwas flacher zu sein.\n");
  AddDetail (({"himmel","sonne"}), "Strahlend blauer Himmel ueber Dir, "+
    "und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden"}), "Du befindest Dich auf ihm. "+
    "Etwas Reisig liegt herum.\n");
  AddDetail ( ({"steinpilz", "steinpilze", "pilz", "pilze", "schwammerl"}),
    "Wer suchet, der findet.\n");
  AddDetail ("wald", bs("Du stehst unmittelbar vor einem grossen Wald. "+
    "Nach Nordwesten hin werden die Baeume zusehends dichter und die "+
    "Stimmung noch ruhiger."));
  AddDetail ("stimmung", "Ruhig, sehr ruhig.\n");
  AddDetail ( ({"baum", "nadelbaum"}), bs("Nicht nur ein Baum, nein, "+
    "gleich ein paar stehen hier rum. Aber ein Baum hat besonders starke "+
    "Aeste, die Dir aus irgendeinem Grund besonders auffallen.\n"));
  AddDetail ( ({"baeume", "nadelbaeume"}),
    "Vereinzelt stehen hier bereits einige Nadelbaeume rum.\nEin Baum faellt "+
    "Dir besonders auf.\n");
  AddDetail ( ({"zweige", "aeste"}), "Sie werden von den Baeumen getragen. "+
    "Auf einem Ast bemerkst Du irgendetwas.\n");
  AddSpecialDetail ("ast", "ast");

  AddDetail ("reisig",
    "Ein wenig davon liegt auf dem ausgetrampelten Pfad.\n");

  AddExit("nordwesten",ROOM("room_h09"));
//  AddExit("nordosten",EBENE("trogor/room/grotte_s1"));
  AddExit("nordosten",EBENE("ronja/feenquest/room/weg1"));
  AddExit("sueden",ROOM("room_i11"));

  cloned = 0;
}

ast()
{
  if (cloned)
  {
    if (present ("uhu"))
      return "Der Uhu, der auf dem Ast sass, sitzt nun vor Dir.\n";
    else
      return "Du siehst genauer hin und stellst fest, dass Du Dich "+
        "getaeuscht haben musst.\n";
  }
  else
  {
    write ("Als Du genauer hinsiehst, kannst Du ein Tier auf dem Ast sitzen "+
      "sehen.\nDu scheuchst es auf, um es genauer erkennen zu koennen.\n");
    clone_object (UHU)->move(ME, M_NOCHECK | M_NO_ATTACK);
    cloned = 1;
  }
  return "";
}

reset()
{
  if (!present("uhu")) cloned = 0;
  ::reset();
}
