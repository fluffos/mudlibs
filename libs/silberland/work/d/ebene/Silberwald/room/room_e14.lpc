#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Weg im Silberwald");
  SetProp (P_INT_LONG,
    "Du gehst den nach Suedwesten hin etwas abschuessigen, schmalen aber "+
    "dennoch schon ziemlich ausgetrampelt wirkenden Pfad durch den "+
    "Silberwald entlang und geniesst die Ruhe und den Frieden des Waldes. "+
    "Nordwestlich von Dir kannst Du einen kleinen Bach hinter den Baeumen "+
    "entdecken, der sich den Pfad entlang abwaerts windet.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sonne"}),
    "Die Sonne mueht sich, mit ihren Strahlen das Blaetterdach der Baeume "+
    "zu durchdringen, was nicht immer leicht zu sein scheint...");
  AddDetail ( ({"boden", "pfad", "weg"}),
    "Der Weg, den Du entlang gehst, windet sich leicht abschuessig durch "+
    "den Wald.");
  AddDetail ( ({"baeume", "nadelbaeume"}),
    "Der Wald ist voll von immergruenen Nadelbaeumen, die dem Wald seine "+
    "vertraeumte Atmosphaere verleihen.");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere des Waldes ist nicht so ohne weiters beschreibbar - "+
    "man muss einfach mal einen Tag hier idlen, um sie wirklich geniessen "+
    "zu lernen...");
  AddDetail ( ({"frieden", "ruhe"}),
    "Ruhe und Frieden erfuellt Dich hier.");
  AddDetail ( ({"bach"}),
    "Der kleine vertraeumte Bach windet sich entlang des Pfades abwaerts.");
  AddDetail ( ({"bach"}),
    "Der kleine vertraeumte Bach windet sich entlang des Pfades abwaerts. "
    "Vielleicht kann man auf die andere Seite gelangen?");
 AddDetail ( ({"seite"}),
    "Auf der anderen Seite des Baches kannst Du etwas erkennen, dass nach "
    "einem Pfad aussieht. Der Bach ist hier ungefaehr 2 Meter breit, "
    "dafuer aber recht flach. Du solltest eigentlich ohne Probleme auf die "
    "andere Seite waten koennen.");
  AddDetail ( ({"himmel"}),
    "Der strahlend blaue Himmel ist durch das dichte Blaetterdach der "+
    "Baeume kaum noch zu sehen...");
  AddDetail ( ({"blaetterdach"}),
    "Genaugenommen handelt es sich um ein Nadeldach.");
  AddDetail ( ({"dach", "nadeldach"}),
    "Die hohen Baeume mit ihren dichten Zweigen bilden eine Art "+
    "schuetzendes Dach ueber dem ausgetrampelten Pfad.");
  AddDetail ( ({"zweige", "nadeln"}),
    "Die Baeume haben Nadeln, und die haengen an den Zweigen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Die Ruhe und Stille des Waldes wird nur durch das sanfte Plaetschern "+
    "des Baches unterbrochen, der den Weg begleitet.");
  AddSound ( ({"plaetschern"}),
    "Das Plaetschern des Baches wirkt irgendwie beruhigend.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du atmest die frische Luft des Waldes ein und fuehlst Dich einfach "+
    "nur wohl.");
  AddDetail ( ({"silberwald", "wald"}),
    "Du stehst mittendrinnen und geniesst seine Atmosphaere...");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("room_f13"));
  AddExit ("suedwesten", ROOM("room_d15"));
  // EXITS END

  // ITEMS START
  AddItem (NPC("reh"), REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd ( ({"cmd_wate", "wate"}), "cmd_wate");
}

int cmd_wate (string str)
{
  notify_fail ("Durch was oder wohin moechtest Du waten?\n");
  if (!str) return 0;
  if ( str == "auf andere seite" ||
       str == "auf die andere seite" ||
       str == "durch bach" ||
       str == "durch den bach" ||
       str == "durch bach hindurch" ||
       str == "durch den bach hindurch" )
  {
    write(BS("Frohen Mutes watest Du durch den Bach. Das Wasser "
          "ist so seicht, dass Deine Fuesse kaum nass werden. "
          "Zumindest nicht nennenswert."));

    TP->move("/d/ebene/zuni/waldsee/room/room_e6", M_GO,
        "durch den Bach", "watet", "watet durch den Bach herein");

    return 1;
  }
}
