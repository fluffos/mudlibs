/*
** Weg im Hochland
** ---
** 1996-04-08 (Woody) 1.0  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:13]));
  SetProp (P_INT_SHORT, "Weg im Hochland");
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich auf einem lichten Weg im Hochland. Nur einige "+
    "Graeser wachsen hier, kaum mehr ein Baum ist zu sehen. Der Weg wird "+
    "nach Norden immer steiler, das Klima immer rauher. Der kleine Bach "+
    "im Westen plaetschert von alledem unbeeindruckt friedlich vor sich "+
    "hin."));

  AddDetail ( ({"himmel", "sonne"}),
    "Strahlend blauer Himmel ueber Dir, und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden"}), bs("Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\nEr fuehrt nach Norden "+
    "ins Gebirge hinauf und nach Sueden bergab in tiefere Gefilde."));
  AddDetail ("gebirge", bs("Das Gebirge erhebt sich nach Norden hin "+
    "maechtig. Es ist die Heimat\ndiverser Gebirgsvoelker und birgt "+
    "zahllose Geheimnisse in seinen zerkluefteten Hoehen, aber auch in "+
    "seinem Inneren."));
  AddDetail ( ({"baeume", "baum"}), "Hier oben wachsen kaum mehr Baeume, "+
    "zumindest kannst Du keine ausmachen.\n");
  AddDetail ("graeser", bs("Einige Graeser breiten sich ueber das gen Norden "+
    "immer kahler werdende Erscheinungsbild der Landschaft aus."));
  AddDetail ( ({"bach", "baechlein"}), bs("Westlich von Dir erkennst Du ein "+
    "kleines Baechlein, das seinen Ursprung wohl im noerdlich gelegenen "+
    "Gebirge nimmt."));
  AddDetail ("klima", "Es wird gen Norden immer rauher.\n");

  AddExit("norden",ROOM("room_a02"));
  AddExit("sueden",ROOM("room_a04"));
}
