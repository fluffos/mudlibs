#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

string *sitzt=({});
#define SITZT(wer) (member(sitzt, getuid(wer))!=-1)

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:21]));
  SetProp (P_INT_SHORT, "Weg im Silberwald");
  SetProp (P_INT_LONG,
    "Du folgst dem nach Sueden hin leicht abschuessigen Pfad immer "+
    "weiter, ohne zu wissen, wo er Dich hinfuehrt. Der Wald erfuellt Dich "+
    "mit Ruhe und Frieden, das leise Plaetschern des wegbegleitenden "+
    "Baches dringt beruhigend an Dein Ohr. Am Wegrand steht, etwas "+
    "unmotiviert, eine Bank, offenbar ein Rastplatz fuer Wanderer.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sonne"}),
    "Die Sonne mueht sich, mit ihren Strahlen das Blaetterdach der Baeume "+
    "zu durchdringen, was nicht immer leicht zu sein scheint...");
  AddDetail ( ({"boden", "pfad", "weg"}),
    "Der Weg, den Du entlang gehst, windet sich leicht abschuessig durch "+
    "den Wald.");
  AddDetail ( ({"baeume", "nadelbaeume"}),
    "Der Wald ist voll von immergruenen Nadelbaeumen, die dem Wald seine "+
    "vertraeumte Atmosphaere verleihen.");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere des Waldes ist nicht so ohne weiters beschreibbar - "+
    "man muss einfach mal einen Tag hier idlen, um sie wirklich geniessen "+
    "zu lernen...");
  AddDetail ( ({"frieden", "ruhe"}),
    "Ruhe und Frieden erfuellen Dich hier.");
  AddDetail ( ({"bach"}),
    "Der kleine vertraeumte Bach windet sich entlang des Pfades abwaerts.");
  AddDetail ( ({"himmel"}),
    "Der strahlend blaue Himmel ist durch das dichte Blaetterdach der "+
    "Baeume kaum noch zu sehen...");
  AddDetail ( ({"blaetterdach"}),
    "Genaugenommen handelt es sich um ein Nadeldach.");
  AddDetail ( ({"dach", "nadeldach"}),
    "Die hohen Baeume mit ihren dichten Zweigen bilden eine Art "+
    "schuetzendes Dach ueber dem ausgetrampelten Pfad.");
  AddDetail ( ({"zweige", "nadeln"}),
    "Die Baeume haben Nadeln, und die haengen an den Zweigen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Die Ruhe und Stille des Waldes wird nur durch das sanfte Plaetschern "+
    "des Baches unterbrochen, der den Weg begleitet.");
  AddSound ( ({"plaetschern"}),
    "Das Plaetschern des Baches wirkt irgendwie beruhigend.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du atmest die frische Luft des Waldes ein und fuehlst Dich einfach "+
    "nur wohl.");
  AddDetail ( ({"bank", "rastplatz"}),
    "Die Bank am Wegrand besteht aus teilweise schon etwas morschen "+
    "Holzlatten, bietet aber fuer muede Wanderer eine immer noch "+
    "ausreichend einladende Moeglichkeit, sich ein wenig auszuruhen.");
  AddDetail ( ({"holzlatten", "latten"}),
    "In den relativ dicken Holzlatten der Bank kannst Du eine Inschrift "+
    "erkennen.");
  AddDetail ( ({"inschrift"}),
    "Du kannst sie lesen.");
  AddReadDetail ( ({"inschrift"}),
    "Du entzifferst die in die Holzlatten der Bank geritzte Inschrift "+
    "muehselig: \"Laechle, denn es koennte schlimmer kommen...\"");
  AddDetail ( ({"silberwald", "wald"}),
    "Du stehst mittendrinnen und geniesst seine Atmosphaere...");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ([ EX_DEST: ROOM("room_e14"), EX_TESTFUNC: "gehe" ]));
  AddExit ("sueden",    ([ EX_DEST: ROOM("room_d16"), EX_TESTFUNC: "gehe" ]));
  // EXITS END

  AddCmd ( ({"laechel", "laechle"}), "laechel");
  AddCmd ( ({"setz", "setze", "sitz"}), "sitz");
  AddCmd ( ({"steh", "stehe"}), "steh");

  // ITEMS START
  // ITEMS END

}

int gehe(string str)
{
  if (SITZT(TP)) return write("Dazu solltest Du erstmal aufstehen!\n"),0;
  return 1;
}

int laechel(string str)
{
  write (bs(
    "Als Du versuchst zu laecheln, kommt wie aus dem Nichts eine kleine "
    "Regenwolke an, giesst Dich von oben bis unten nass, und verschwindet "
    "ebensoschnell wieder im Nichts, wie sie gekommen ist."));
  say (bs(
    CAP_TPN+" versucht, zu laecheln. Ploetzlich kommt wie aus dem Nichts "
    "eine kleine Regenwolke an, giesst "+TPP(WEN)+" von oben bis unten "
    "nass und verschwindet ebensoschnell wieder im Nichts."));
  return 1;
}

int sitz(string str)
{
  notify_fail("Worauf willst Du Dich sitzen?\n");
  if (!str) return 0;
  if (str!="auf bank") return 0;
  if (SITZT(TP))
    write("Aber Du sitzt doch schon auf der Bank!\n");
  else {
    write(bs(
      "Du setzt Dich auf die Bank, die daraufhin ein bedenkliches "
      "Knarren von sich gibt."));
    say(CAP_TPN+" setzt sich auf die Bank.\n");
    sitzt += ({ getuid(TP) });
  }
  return 1;
}

int steh(string str)
{
  if (!SITZT(TP))
    return notify_fail("Aber Du stehst doch schon!\n"), 0;
  if (str!="auf")
    return notify_fail("WIE stehen? Vermutlich willst Du AUFstehen...\n"),0;
  write("Du erhebst Dich von der knarrenden Bank.\n");
  say(CAP_TPN+" erhebt sich von der knarrenden Bank.\n");
  sitzt -= ({ getuid(TP) });
  return 1;
}

PlayerQuit(object ob)
{
  if (SITZT(ob))
    sitzt -= ({ getuid(ob) });
}
