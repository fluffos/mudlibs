/*
** Weg im Silberwald
**
** 1996-04-08 (Woody) 1.0  Release
** 1996-04-10 (Woody) 1.1  Zugang zur Hoehle
** 1997-02-03 (Woody) 1.2  Wildschwein hier angesiedelt ;)
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Weg im Silberwald");
  SetProp (P_INT_LONG,
    "Der Wald lichtet sich immer mehr, dafuer ist der Weg nicht mehr ganz "+
    "so steil wie weiter unten. Auch die Sonne findet nun wieder etwas "+
    "mehr Durchkommen. Der Boden wird nach oben hin zunehmend haerter. "+
    "Einige Felsbloecke fallen Dir auf.");

  AddDetail ("sonne",
    "Die Sonne leuchtet den Pfad wieder halbwegs gut aus.\n");
  AddDetail ( ({"pfad", "weg", "boden"}), "Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\nEr fuehrt nach Nordwesten "+
    "bergauf und nach Suedosten zum Wald hinunter.\n");
  AddDetail ( ({"steinpilz", "steinpilze", "pilz", "pilze", "schwammerl"}),
    "Wer suchet, der findet.\n");
  AddDetail ("himmel",
    "Du blickst hinauf und siehst durch die dichten Zweige "
    "hindurch einen strahlend blauen Himmel.\n");
  AddDetail ("atmosphaere", "Die Atmosphaere verzaubert Dich einfach: "
    "Stille, nur durchbrochen von gelegentlichen Schreien eines Kaeuzchens, "
    "leises Plaetschern eines nahen Baechleins, und unzaehlige Nadelbaeume, "
    "die den Weg saeumen lassen Dich andaechtig verharren.");
  AddDetail ( ({"wald", "silberwald"}), "Der Silberwald ist wohl der "
    "bekannteste Wald im ganzen Land. Genau so hast Du Dir immer "
    "schon einen Wald vorgestellt: Die sanfte Stille wird nur ab und zu "
    "durch das leise Schreien eines Kaeuzchens unterbrochen, leises "
    "Plaetschern laesst auf einen nahen Bach schliessen, und abseits "
    "des Pfades saeumen Tannen, Fichten und Foehren den Weg.");
  AddDetail ( ({"baeume", "nadelbaeume", "tannen", "fichten", "foehren"}),
    "Die Baeume strahlen ein sattes, immerwaehrendes, beruhigendes Gruen aus.");
  AddDetail ("baum", "Du siehst die Baeume vor lauter Wald nicht.");
  AddDetail ("gruen", "Du starrst vertraeumt ins Gruene.");
  AddDetail ( ({"zweige", "aeste"}), "Sie werden von den Baeumen getragen.");
  AddDetail ( ({"bach", "baechlein"}),
    "Suedwestlich von Dir erkennst Du "
    "hinter einigen Baeumen ein kleines, vertraeumtes Baechlein. Vielleicht "
    "gibt es ja irgendwo eine Moeglichkeit, zu ihm zu gelangen?");
  AddDetail ( ({"geraeusche", "plaetschern", "kaeuzchen"}),
    "Vielleicht solltest Du es mit lauschen probieren?");
  AddDetail ("duft", "Vielleicht solltest Du es mit riechen probieren?");
  AddDetail ("reisig", "Es liegt in Massen auf dem ausgetrampelten Pfad.");

  AddDetail (({"fels","felsbloecke","bloecke"}), "Als Du die Felsbloecke "
    "naeher betrachtest, entdeckst Du ein kleines Loch. Ausserdem kannst "
    "ein kleines Warnschild daneben entdecken.");
  AddDetail (({"schild","warnschild"}), "Du kannst es lesen.");
  AddReadDetail (({"schild","warnschild"}), "Auf dem Warnschild steht: "
    "Vorsicht vor dem Baer!");
  AddDetail ("loch", "Ein mittelgrosses Loch, das in eine dunkle Hoehle "
    "zu fuehren scheint. Du koenntest versuchen, hineinzuklettern, wenn "
    "Du den Mut dazu aufbringst.");

  AddSound (DEFAULT_SOUND, "Du hoerst neben den typischen Geraeuschen "
    "eines Waldes das leise Plaetschern eines Baches sowie gelegentliche "
    "Schreie eines Kaeuzchens.");
  AddSound ("geraeusche", "Du vernimmst all die wundervollen Geraeusche, "
    "die in einem unvergleichlichen Ensemble die Stimmung eines ver"
    "traeumten Waldes ausmachen.");
  AddSound ("plaetschern", "Im Suedwesten vernimmst Du das leise "
    "Plaetschern eines Baechleins, das wohl seinen Ursprung irgendwo im "
    "noerdlich gelegenen Gebirge hat.");
  AddSound ("kaeuzchen", "Das gelegentliche leise Schreien eines "
    "Kaeuzchens hat eine irgendwie beruhigende Wirkung auf Dich.");

  AddSmell (({DEFAULT_SMELL,"duft"}), "Der Duft von Reisig und "
    "Nadelbaeumen erinnert Dich ein wenig an Weihnachten...");

  AddCmd ( ({"kletter","klettere","steig","steige","betritt","betrete"}),
    "kletter");

  // AddExit("nordwesten", ([ EX_DEST: ROOM("room_a04"),
  //                          EX_TESTFUNC: "guest_check" ]) );
  AddExit("nordwesten",ROOM("room_a04"));
  AddExit("suedosten",ROOM("room_c06"));

  AddItem (NPC("wildschwein"), REFRESH_DESTRUCT);
}


int kletter(string str)
{
  notify_fail("Wo willst Du hin?\n");
  if (stringp(str))
    switch (str)
    {
      case "hoehle": case "in hoehle": case "loch": case "in loch":
        TP->move (ROOM("hoehle/hoe1"), M_GO, "in die Hoehle");  // == b04
        return 1;
      case "":
        break;
      default:
        notify_fail ("Dahin kommst Du von hier aus nicht!\n");
    }
  return 0;
}


// 1. hat mich keiner gefragt (ist ja schon eine Frechheit an sich),
// 2. moechte ich sowas in meinen Gebieten ohnehin nicht.
// Gaeste duerfen also wieder frei passieren. So.
// Woody, 29.9.2000

