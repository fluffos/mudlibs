#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:17]));
  SetProp (P_INT_SHORT, "Auf einem Steg");
  SetProp (P_INT_LONG,
    "Ein kleiner schmaler Steg fuehrt ueber das Baechlein weiter nach "+
    "Westen auf einen huegeligen Waldweg zu. Das Wasser unter Dir "+
    "plaetschert leise vor sich hin, und Dein Blick gleitet vom Waldweg "+
    "im Westen weiter nach Osten, wo Du das Hochland und eine Wegkreuzung "+
    "erkennen kannst, an der sich ein zum Gebirge emporschlaengelnder Weg "+
    "sowie ein etwas abschuessiger Pfad durch den Wald treffen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holzsteg", "steg"}),
    "Der schmale Holzsteg scheint Dich grade noch tragen zu koennen.");
  AddDetail ( ({"bach", "baechlein"}),
    "Das kleine vertraeumte Baechlein unter Dir plaetschert leise vor sich "+
    "hin.");
  AddDetail ( ({"pfad", "waldweg", "weg", 
                "wege"}),
    "Du kannst insgesamt drei Wege erkennen: Ein leicht huegeliger Waldweg "+
    "im Westen und zwei Wege im Osten, von denen einer ins Gebirge hinauf "+
    "fuehrt und ein anderer durch den Silberwald etwas abschuessig in die "+
    "Ebene hinunter.");
  AddDetail ( ({"gebirge"}),
    "Das Gebirge haengt etwas drohend im Norden ueber Dir.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist rein und klar, wie bei jedem Gebirgsbach.");
  AddDetail ( ({"gebirgsbach", "gebirgsbaeche"}),
    "Gebirgsbaeche zeichnen sich durch ihr klares Wasser und sanftes "+
    "Plaetschern aus. So auch dieser hier.");
  AddDetail ( ({"plaetschern"}),
    "Dem kannst Du am besten lauschen.");
  AddDetail ( ({"blick"}),
    "Er gleitet ueber die Landschaft.");
  AddDetail ( ({"landschaft"}),
    "Sie erstreckt sich rings um Dich.");
  AddDetail ( ({"hochland"}),
    "Das Hochland ist weiter im Osten. Du kannst zwei Wege dort erkennen.");
  AddDetail ( ({"kreuzung", "wegkreuzung"}),
    "An der Kreuzung im Osten treffen sich zwei Wege. Eigentlich drei, "+
    "wenn man diesen hier mitzaehlt.");
  AddDetail ( ({"holz"}),
    "Altes, aber zum Glueck noch nicht morsches Holz.");
  AddDetail ( ({"silberwald", "wald"}),
    "Der Silberwald erstreckt sich suedlich und suedoestlich weithin bis "+
    "hinunter in die Ebene. Ein weiterer, etwas huegeligerer Wald schliesst "+
    "gleich jenseits des Steges im Westen an.");
  AddDetail ( ({"ebene"}),
    "Um zur Ebene zu gelangen, musst Du erst ein Stueck bergab laufen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Unter Dir rauscht der Bach leise talwaerts.");
  AddSound ( ({"rauschen"}),
    "Das staendige Rauschen mag ja anfangs ganz schoen sein, aber "+
    "inzwischen nervt es Dich schon ein wenig. Du beschliesst, Deine Reise "+
    "bald fortzusetzen.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", ROOM("room_a04"));
  AddExit ("westen", "/d/huegelland/feyaria/weg/room/0101");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
