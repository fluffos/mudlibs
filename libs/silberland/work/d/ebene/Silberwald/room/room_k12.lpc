/*
** Landweg
**
** 1996-04-08 (Woody) 1.0  Initial Version
** 1996-06-18 (Woody) 1.1  ::reset() aufrufen
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../silberwald.h"

int kleeda;
object *entdeckt;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Landweg");
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich auf einem breiten Landweg, der wohl schon von "+
    "vielen Abenteurern begangen wurde, da er sehr ausgetrampelt wirkt. "+
    "Oestlich von Dir erhebt sich die maechtige Stadt Midas, ein Zentrum "+
    "des Handels und der Kultur, die Du durch einen gewaltigen Torbogen "+
    "betreten kannst, waehrend Du im Westen gruenes Flachland ausmachen "+
    "kannst."));

  AddDetail ( ({"himmel","sonne"}), "Strahlend blauer Himmel ueber "+
    "Dir, und mitten in ihm die helle Sonne.\n");
  AddDetail ( ({"pfad", "weg", "boden", "landweg"}), bs("Der Boden unter "+
    "Dir ist von der Durchfahrt zahlreicher Abenteurer schon ziemlich "+
    "ausgetrampelt. Nur wenige Pflanzen koennen hier noch wachsen."));
  AddSpecialDetail (({"pflanzen","wegrand"}), "d_pflanzen");
  AddSpecialDetail (({"kleeblatt","klee"}), "d_kleeblatt");
  AddDetail (({"midas","stadt"}), bs("Du kannst die Stadt nach Osten hin "+
    "durch den gewaltigen Torbogen hindurch betreten."));
  AddDetail (({"bogen","torbogen"}), bs("Der Torbogen ist kunstvoll in die "+
    "maechtige Stadtmauer eingearbeitet. Du kannst eine Steintafel oberhalb "+
    "des Torbogens erkennen."));
  AddDetail (({"steintafel","tafel"}), "Du erkennst eine Inschrift in der "+
    "Tafel.\n");
  AddDetail ("inschrift", "Du kannst sie lesen.\n");
  AddReadDetail ("inschrift", "Auf der Steintafel steht in grossen "+
    "Lettern: MIDAS.\n");
  AddDetail (({"stadtmauer","mauer"}), bs("Die maechtige Stadtmauer "+
    "schuetzt die Bewohner dieser Stadt vor den Angriffen naher Ork- und "+
    "Goblinstaemme."));
  AddDetail ("flachland", "Nach Westen wird die Gegend zusehends gruener.\n");
  AddDetail ("gegend", "Du starrst Loecher in selbige.\n");

  AddCmd (({"pflueck", "pfluecke"}), "pfluecke");
  AddExit("westen",ROOM("room_j12"));
  AddExit("osten",MIDAS("room/room_a5"));

  kleeda = 1;
  entdeckt = ({});
}

string d_pflanzen()
{
  if (kleeda)
  {
    entdeckt += ({TP});
    return "Am Wegrand kannst Du ein kleines, vierblaettriges "+
      "Kleeblatt erkennen.\n";
  }
  else
    return "Hier wachsen kaum noch Pflanzen, und das bisschen, was noch "+
      "waechst, scheint\nirgendjemand bereits mitgenommen zu haben.\n";
}

string d_kleeblatt()
{
  if (kleeda)
  {
    if (member_array(TP, entdeckt) == -1)
      return "Ja, hier ist ein Kleeblatt, aber Du hast es noch "+
        "nicht entdeckt.\n";
    else
      return "Du koenntest es pfluecken.\n";
  }
  else
    return "Du kannst kein Kleeblatt mehr finden!\n";
}

pfluecke(str)
{
  notify_fail ("WAS willst Du pfluecken?\n");
  if (!stringp(str) || str=="") return 0;
  if (str=="klee" || str=="kleeblatt")
  {
    if (member_array(TP, entdeckt) == -1)
      return (notify_fail("Dazu musst Du das Kleeblatt erst einmal "+
        "entdecken!\n"), 0);
    if (!kleeda)
      return (notify_fail("Du kannst kein Kleeblatt mehr finden. "+
        "Irgendjemand war schneller als Du.\n"), 0);
    write ("Du pflueckst ein kleines, vierblaettriges Kleeblatt und "+
      "steckst es sofort ein.\n");
    say (TPN+" pflueckt ein kleines, vierblaettriges Kleeblatt.\n");
    kleeda = 0;
    CLONE (OBJ("div/kleeblatt"), TP);
    return 1;
  }
  else
    return (notify_fail(capitalize(str)+"? Sowas kannst Du hier nicht "+
      "pfluecken.\n"), 0);
}

reset()
{
  if (!kleeda) tell_room (ME, "Du hast das Gefuehl, als ob sich hier "+
    "irgendetwas veraendert haette.\n");
  kleeda = 1;
  entdeckt = ({});
  ::reset();
}
