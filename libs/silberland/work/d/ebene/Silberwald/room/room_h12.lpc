#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Flachland");
  SetProp (P_INT_LONG,
    "Du folgst dem breiten Weg durchs gruene Flachland. Hier scheint noch "+
    "alles in Ordnung zu sein, die sanften Geraeusche der Natur fangen "+
    "Dich ein und vermitteln Dir ein unvergleichliches Gefuehl von Ruhe "+
    "und Frieden. Weiter im Westen kannst Du schon den grossen Silberwald "+
    "erkennen, waehrend im Osten eine groessere Stadt zu sein scheint.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail (({"himmel","sonne"}), "Strahlend blauer Himmel ueber Dir, "+
    "und mitten in ihm die helle Sonne.\n");
  AddDetail (({"pfad","weg","boden"}), "Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\n");
  AddDetail ("wiese", bs("Weiter suedlich kannst Du eine weite Wiese "+
    "ausmachen, die Du aber wegen einer Abzaeunung nicht erreichen "+
    "kannst."));
  AddDetail (({"land","landschaft"}), bs("Die Landschaft ist vorwiegend "+
    "flach und gruen. Nur nach Norden hin steigt sie deutlich an."));
  AddDetail ("stadt", "Die Stadt liegt weiter im Osten.\n");
  AddDetail (({"ruhe","frieden"}), "Ja, dieser Ort hier vermittelt Ruhe "+
    "und Frieden.\n");
  AddDetail ("ort", "Ein ruhiger, friedlicher und stiller Ort. Nicht "+
    "Oertchen, wohlgemerkt.\n");
  AddDetail ("oertchen", bs(
    "Ein Oertchen ist auch meist ruhig, friedlich und still, aber irgendwie "+
    "doch etwas ganz anderes, als dieses idyllische Stueckchen Land hier."));
  AddDetail ("stueckchen", "Mehr als Nichts, aber weniger als ein Stueck.\n");
  AddDetail ("stueck", "Mehr als ein Stueckchen.\n");
  AddDetail ("nichts", "Nichts ist weniger als Etwas.\n");
  AddDetail ("etwas", "Etwas ist immerhin schon nicht mehr Nichts.\n");
  AddDetail ("graeser", "Sie beugen sich nur der sanften Gewalt "+
    "des Windes.\n");
  AddDetail ("gewalt", "Bitte nicht hier.\n");
  AddDetail ( ({"silberwald", "wald"}),
    "Der Weg nach Suedwesten fuehrt auf den Wald zu, aber auch weiter im "+
    "Norden scheint es einen weiteren Weg in den Wald zu geben.");
  AddDetail ( ({"flachland"}),
    "Du stehst mitten im Flachland, vor einem grossen Wald, der sich "+
    "weithin nach Westen erstreckt.");
  AddDetail ( ({"ordnung"}),
    "Hier scheint die Welt noch in Ordnung zu sein...");
  AddDetail ( ({"welt"}),
    "Diese Welt ist zwar nicht ganz so gross wie andere, aber erreicht "+
    "doch durchaus bemerkenswerte Ausmasse...");
  AddDetail ( ({"geraeusche"}),
    "Den Geraeuschen kann man besser lauschen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du lauschst den sanften Klaengen der Natur und fuehlst Dich wohl.");
  AddDetail ( ({"gefuehl"}),
    "Gefuehle lassen sich nicht so ohne weiters untersuchen, sie sind "+
    "einfach da.");
  AddDetail ( ({"ausmasse"}),
    "Wenn Du sie ermitteln willst, musst Du die Welt schon selber "+
    "erkunden!");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("room_i11"));
  AddExit ("suedwesten", ROOM("room_g13"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
