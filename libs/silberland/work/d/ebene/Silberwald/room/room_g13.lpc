#include <properties.h>
#include <moving.h>
#include "../silberwald.h"

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

int geld=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Flachland");
  SetProp (P_INT_LONG,
    "Der breite Weg fuehrt Dich weiter durchs Flachland nach Westen hin "+
    "naeher zum Wald, ein wenig abschuessig, und nach Nordosten zu weiter "+
    "ins offene Land, offenbar auf eine groessere Stadt zu, die Du von "+
    "hier aus noch nicht so genau erkennen kannst. Er ist von gruenem Gras "+
    "gesaeumt. Eine kleine Strasse geht nach Norden ab auf ein Gebaeude zu.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail (({"himmel","sonne"}), "Strahlend blauer Himmel ueber Dir, "+
    "und mitten in ihm die helle Sonne.\n");
  AddDetail (({"pfad","weg","boden"}), "Du befindest Dich auf ihm. "+
    "Er wirkt bereits etwas ausgetrampelt.\n");
  AddDetail (({"land","landschaft"}), bs("Die Landschaft ist vorwiegend "+
    "flach und gruen. Nur nach Norden hin steigt sie deutlich an."));
  AddDetail ("stadt", "Die Stadt liegt weiter im Osten.\n");
  AddDetail (({"ruhe","frieden"}), "Ja, dieser Ort hier vermittelt Ruhe "+
    "und Frieden.\n");
  AddDetail ("graeser", "Sie beugen sich nur der sanften Gewalt "+
    "des Windes.\n");
  AddDetail ("gewalt", "Bitte nicht hier.\n");
  AddDetail ( ({"silberwald", "wald"}),
    "Der Weg nach Westen fuehrt auf den Wald zu, aber auch weiter im "+
    "Norden scheint es einen weiteren Weg in den Wald zu geben.");
  AddDetail ( ({"flachland"}),
    "Du stehst mitten im Flachland, vor einem grossen Wald, der sich "+
    "weithin nach Westen erstreckt.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du lauschst den sanften Klaengen der Natur und fuehlst Dich wohl.");
  AddDetail ( ({"gras"}),
    "Das Gras ist sattgruen und wuchert hier links und rechts des Weges "+
    "wild vor sich hin. Einige Erdhuegelchen fallen Dir auf.");
  AddDetail ( ({"erdhuegel", "erdhuegelchen", "huegel", 
                "huegelchen"}),
    "Du betrachtest die kleinen Erdhuegelchen genauer und stellst fest, "+
    "dass sie wohl von einem Maulwurf stammen. Die Erde scheint etwas "+
    "nachgiebig zu sein.");
  AddDetail ( ({"erde"}),
    "Vielleicht kannst Du ja drin graben?");
  AddDetail ( ({"loch"}),
    "Ein Loch? Wo? Vielleicht hast Du Dich ja auch nur getaeuscht...");
  AddDetail ( ({"strasse"}),
    "Die Strasse fuehrt Richtung Norden auf ein groesseres Gebaeude zu.");
  AddDetail ( ({"gebaeude"}),
    "Es scheint sich hierbei um eine Art Bauernhof zu handeln.");
  AddDetail ( ({"bauernhof"}),
    "Schau doch einfach mal hin!");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("room_h12"));
  AddExit ("westen", ROOM("room_f13"));
  AddExit ("norden", "/d/ebene/rohkopfrex/bauernhof/strasse/strasse1");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"grab", "grabe"}), "grabe");

}

int grabe(string str)
{
  object ob;
  notify_fail ("Wo oder worin willst Du graben?\n");
  if (!str) return 0;
  if ((str != "in erde") && (str != "erde")) return 0;
  if (!(ob=present("schaufel", TP)) && !(ob=present("hacke", TP))) {
    if (!geld && (random(100) > 80)) {
      write ("Du buddelst mit blossen Haenden in der Erde "
             "und findest ein paar Muenzen.\n");
      TP->AddMoney( (100+random(200)) / ((TP->QueryProp(P_LEVEL)/5) || 1) );
      geld = 1;
    } else
      write ("Du graebst mit blossen Haenden ein wenig in der Erde, "
             "findest aber nichts.\n");
    say (CAP_TPN+" buddelt mit blossen Haenden etwas in der Erde rum.\n");
  }
  else
  {
    write (bs("Du graebst mit D"+ob->name(WEM)+" in der Erde und stoesst "
      "auf ein kleines Loch. Du graebst immer weiter und weiter, bis das "
      "Loch gross genug ist, dass Du durchpasst. Ploetzlich jedoch verlierst "
      "Du den Halt und plumpst hinein...")+
      "\n\nAAAAAAaaaaaaaaarrrrrhhhhhh...\n\n\n"+
      "Zum Glueck landest Du einigermassen weich auf erdigem Untergrund.\n"
      "Wo Du wohl nun wieder gelandet sein magst...?\n");
    say (bs(CAP_TPN+" buddelt mit "+ob->name(WEM)+" ein Loch in die Erde, "
      "verliert den Halt und plumpst hinein. Du bleibst mit offenem "
      "Mund zurueck..."));
    TP->move(ROOM("erde/gang_g13"), M_GO | M_SILENT | M_NO_SHOW);
    if (ob=environment(TP))
      tell_room(ob, CAP_TPN+" plumpst von oben herein.\n", ({TP}));
  }
  return 1;
}

reset()
{
  ::reset();
  geld=0;
}
