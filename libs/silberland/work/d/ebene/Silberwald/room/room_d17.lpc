#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/Silberwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:21]));
  SetProp (P_INT_SHORT, "Weg im Silberwald");
  SetProp (P_INT_LONG,
    "Der schmale Waldpfad fuehrt Dich nach Sueden hin noch weiter "+
    "abwaerts, waehrend eine leichte Steigung nach Norden hin noch etwas "+
    "tiefer in den Wald hineinfuehrt. Ausser den vielen Baeumen kannst Du "+
    "auch hier nichts weiter sehen und beschliesst daher, Deine Reise "+
    "zuegig fortzusetzen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sonne"}),
    "Die Sonne mueht sich, mit ihren Strahlen das Blaetterdach der Baeume "+
    "zu durchdringen, was nicht immer leicht zu sein scheint...");
  AddDetail ( ({"boden", "pfad", "weg"}),
    "Der Weg, den Du entlang gehst, windet sich leicht abschuessig durch "+
    "den Wald.");
  AddDetail ( ({"baum", "baeume", "nadelbaeume"}),
    "Der Wald ist voll von immergruenen Nadelbaeumen, die dem Wald seine "+
    "vertraeumte Atmosphaere verleihen.");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere des Waldes ist nicht so ohne weiters beschreibbar - "+
    "man muss einfach mal einen Tag hier idlen, um sie wirklich geniessen "+
    "zu lernen...");
  AddDetail ( ({"frieden", "ruhe"}),
    "Ruhe und Frieden erfuellt Dich hier.");
  AddDetail ( ({"bach"}),
    "Der kleine vertraeumte Bach windet sich entlang des Pfades abwaerts.");
  AddDetail ( ({"himmel"}),
    "Der strahlend blaue Himmel ist durch das dichte Blaetterdach der "+
    "Baeume kaum noch zu sehen...");
  AddDetail ( ({"blaetterdach"}),
    "Genaugenommen handelt es sich um ein Nadeldach.");
  AddDetail ( ({"dach", "nadeldach"}),
    "Die hohen Baeume mit ihren dichten Zweigen bilden eine Art "+
    "schuetzendes Dach ueber dem ausgetrampelten Pfad.");
  AddDetail ( ({"zweige", "nadeln"}),
    "Die Baeume haben Nadeln, und die haengen an den Zweigen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Die Ruhe und Stille des Waldes wird nur durch das sanfte Plaetschern "+
    "des Baches unterbrochen, der den Weg begleitet.");
  AddSound ( ({"plaetschern"}),
    "Das Plaetschern des Baches wirkt irgendwie beruhigend.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du atmest die frische Luft des Waldes ein und fuehlst Dich einfach "+
    "nur wohl.");
  AddDetail ( ({"silberwald", "wald"}),
    "Du stehst mittendrinnen und geniesst seine Atmosphaere...");
  AddDetail ( ({"steigung"}),
    "Nach Norden hin verlaeuft der Weg etwas aufwaerts, tiefer in den Wald "+
    "hinein. Ja, man kann direkt von einer Steigung sprechen, wenngleich "+
    "die Berge noch in weiter Ferne liegen...");
  AddDetail ( ({"berg", "berge"}),
    "Im Norden, sehr weit in der Ferne, kannst Du einige Berge erkennen.");
  AddDetail ( ({"ferne"}),
    "Das Gegenteil von Naehe.");
  AddDetail ( ({"naehe"}),
    "Du gehst ganz nah ran und erkennst, dass das Naehe sein muss.");
  AddDetail ( ({"gegenteil"}),
    "Du siehst hier zwar verschiedene Teile wie den Wald, Baeume, einen "+
    "Weg, aber ein Gegen-Teil siehst Du nirgends.");
  AddDetail ( ({"teil", "teile"}),
    "Dinge.");
  AddDetail ( ({"ding", "dinge"}),
    "Irgendwas bestimmtes?");
  AddDetail ( ({"irgendwas"}),
    "Jaja. Aber was?");
  AddDetail ( ({"was"}),
    "Schau Dich lieber um anstatt sinnlose Details weiterzuverfolgen :-).");
  AddDetail ( ({"detail", "details"}),
    "Nein, das ist zu billig!");
  // DETAILS END

  // EXITS START
  AddExit ("norden", ROOM("room_d16"));
  AddExit ("sueden", ROOM("room_d18"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
