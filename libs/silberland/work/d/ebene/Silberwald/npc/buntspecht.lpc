** 1997-03-12  1.1  P_SIZE
** 2002-04-22  1.2  P_WEIGHT
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Buntspecht");
  SetProp (P_LONG, "Der Buntspecht sitzt am Baumstamm und trommelt "+
    "an einem duerren Ast.\n");
  SetProp (P_NAME, "Buntspecht");
  SetProp (P_GENDER, MALE);
  AddId (({"buntspecht","specht"}));
  create_default_npc (6);
  SetProp (P_BODY, 15);
  SetProp (P_SIZE, 30+random(10));
  SetProp(P_WEIGHT, 600);
  SetProp (P_HANDS, ({" mit seinem spitzen Schnabel", 40}));
  SetProp (P_ALIGN, -100);
  SetProp (P_XP, 20000);
}
