/*
** Braunbaer, Silberwald  (w) Woody@SL
** ---
** 1996-04-10  1.0  Release
** 1996-11-08  1.1  Spell nicht mehr magic, show damage
** 1997-03-12  1.2  P_SIZE
** 1999-02-22  1.3  P_HEAL und P_AGGRESSIVE
** 2000-11-20  1.4  Nicht mehr aggressiv wg. Miniquest
** 2002-04-22  1.5  P_WEIGHT
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#include "../silberwald.h"

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"braunbaer","baer"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Braunbaer");
  SetProp (P_SHORT, "Ein Braunbaer");
  SetProp (P_LONG, "Der Braunbaer macht einen sehr gereizten Eindruck, "
    "so als ob er gerade aus seinem Schlaf gerissen wurde. Er funkelt "
    "Dich boese an.");
  SetProp (P_AGGRESSIVE, 0);
  SetProp (P_HEAL, 25);
  SetProp (P_KILL_MSG,
    "Warum musstest Du mich auch in meinem Schlaf stoeren!");
  SetProp (P_ALIGN, 150);
  SetProp (P_RACE, "Baer");
  create_default_npc(22);

  SetProp (P_SIZE, 200+random(15));
  SetProp(P_WEIGHT, 200000);
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_HANDS, ({" mit seinen kraeftigen Pranken", 180+random(40), 
                     ({DT_BLUDGEON, DT_RIP}) }) );

  SetProp(P_SPELLRATE, 20);

  AddSpell(1,250,
    "Der Braunbaer schleudert Dich zu Boden.\n",
    "Der Braunbaer schleudert @WEN zu Boden.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

/*
  SetAttackChats(6, ({
    "Der Braunbaer...\n",
    "Der Braunbaer...\n"}) );
*/
  SetProp (P_DIE_MSG, " brummt noch ein letztes Mal und verendet.\n");
  SetProp (P_DEFAULT_INFO, "brummt nur boese.\n");
  AddInfo ("baer", "nickt.\n");
  AddInfo ("braunbaer", "nickt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Braunbaer hat keine Lust, Deine Sachen zu tragen.\n" }) );

  seteuid(getuid(this_object()));
  clone_object("/p/armour/cloak/baerenfell")->move(this_object(),M_NOCHECK);
  command("trage alles");
  
}


// Hehe, wie fies. Auch der grosse Braunbaer mag Honig! :)
void give_notify(object ob)
{
  if (!interactive(TP))                 // just to be sure. :)
    return;

  if (ob->id("\nhonigtopf"))
  {
    SetProp(P_FOOD,0);
    command_me( "iss honig" );
    if (ob) ob->remove();
    return;
  }
  ::give_notify(ob);
}

