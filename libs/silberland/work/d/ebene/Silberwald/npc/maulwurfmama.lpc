inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../silberwald.h"

mixed DefendOther(int dam, mixed dam_type, mixed spell, object enemy)
{
  object baby;

  Kill(enemy);
  baby = previous_object();
  if (!baby) return 0;
  if (!random(3)) return 0;
  environment()->Message( Name(WER,1) + " wirft sich schuetzend vor " +
      baby->name(WEN,1) + ".\n", MSGFLAG_VISUAL );
  return ({ dam/10, dam_type, spell });
}

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Eine Maulwurfmama");
  SetProp(P_LONG, "Die Maulwurfmama funkelt Dich boese an. Du hast sie "
    "offenbar empfindlich in ihrer Ruhe gestoert! Sie beschuetzt ihr "
    "Junges mit aller Kraft, ihre spitzen Schaufelpfoten stets fuer einen "
    "Kampf bereit.");
  SetProp(P_NAME, "Maulwurfmama");
  SetProp(P_GENDER, FEMALE);
  AddId("maulwurf");
  AddId("maulwurfmama");
  AddId("mama");
  SetProp(P_RACE, "Maulwurf");
  create_default_npc(15);
//  SetProp (P_BODY, 30);
  SetProp(P_SIZE, 18+random(5));
  SetProp(P_WEIGHT, 4500);
  SetProp(P_HANDS, ({" mit ihren kraeftigen Schaufelpfoetchen", 100}));
  SetProp(P_ALIGN, 80);
//  SetProp (P_XP, 60000);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_LIGHT:2.0, DT_FIRE:2.0]) );
  // Faktor 3 (DREI!!!) bei Licht- und Feuerangriffen.
}
