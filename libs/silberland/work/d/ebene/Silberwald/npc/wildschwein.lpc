/*
** Ein Wildschwein  (w) Woody@SL
** ---
** 1996-04-04  1.0  Release
** 1997-03-12  1.1  P_SIZE
** 2002-04-22  1.1  P_WEIGHT
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Wildschwein");
  SetProp (P_LONG, "Ein gefaehrlich wirkendes Wildschwein. Es "+
    "schnaubt Dich an.\n");
  SetProp (P_NAME, "Wildschwein");
  SetProp (P_GENDER, NEUTER);
  SetProp(P_RACE, "Schwein");
  AddId ( ({"wildschwein", "schwein"}) );
  create_default_npc (10);
  SetProp (P_BODY, 50);
  SetProp (P_SIZE, 60+random(20));
  SetProp(P_WEIGHT, 120000);
  SetProp (P_HANDS, ({" mit seinen Vorderpfoten", 65}));
  SetProp (P_ALIGN, -100);
  SetProp (P_XP, 45000);
  SetProp (P_MURDER_MSG, "Bei Thor waer mir das nicht passiert, %s!");

  SUID;
  CLONEME (OBJ("waffe/eckzaehne"));
  command ("zuecke eckzaehne");
}
