/*
** Ein Eichhoernchen (ursprgl. von Dusty)
** ---
** 2002-04-22  P_WEIGHT
*/

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../silberwald.h"
inherit "std/npc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Eichhoernchen");
  SetProp(P_LONG,
    "Das Eichhoernchen kuckt Dich verwundert mit seinen wunderschoenen\n"
    "nussbraunen Augen an, und legt dabei den Kopf leicht schief. Es hat\n"
    "eine kleine Nuss in den Pfoten, an der es hin und wieder knabbert.\n");
  SetProp(P_NAME,"Eichhoernchen");
  AddId(({"horn", "eichhoernchen", "hoernchen"}));
  SetProp(P_GENDER, NEUTER);
  create_default_npc(6);
  // SetProp(P_MAX_HP, 80);
  // SetProp(P_HP, 80);
  // SetProp(P_XP, 10000);
  SetProp(P_ALIGN, 50);
  SetProp(P_HEAL, 1);
  SetProp(P_HANDS, ({" mit seinen Knabberzaehnchen", 65}));
  SetProp(P_SIZE, 25+random(3));
  SetProp(P_WEIGHT, 1500);
  // SetProp(P_BODY, 20);
  SetProp(P_RACE, "hoernchen");

  SUID;
  CLONEME("/d/ebene/obj/div/haselnuss");
}

