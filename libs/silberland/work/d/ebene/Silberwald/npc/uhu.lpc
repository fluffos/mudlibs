inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Uhu");
  SetProp (P_LONG, "Der Uhu sitzt unbewegt auf dem Ast und starrt Dich "+
    "durchdringlich an.\nFast wuerdest Du sagen, sein Blick 'klebt' auf "+
    "Dir.\n");
  SetProp (P_NAME, "Uhu");
  SetProp(P_RACE, "Vogel");
  SetProp (P_GENDER, MALE);
  AddId ("uhu");
  create_default_npc (7);
//  SetProp (P_BODY, 20);
  SetProp (P_SIZE, 30);
  SetProp(P_WEIGHT, 4000);
  SetProp (P_MSGIN, "flattert aufgeregt herunter");
  SetProp (P_HANDS, ({" mit seinen kleinen Krallen", 55, DT_RIP}));
  SetProp (P_ALIGN, 50);
//  SetProp (P_XP, 20000);
}
