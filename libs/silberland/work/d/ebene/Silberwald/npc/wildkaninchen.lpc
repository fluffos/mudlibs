inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Wildkaninchen");
  SetProp (P_LONG, "Ein niedliches kleines Wildkaninchen, das sich "+
    "offenbar verirrt hat.\n");
  SetProp (P_NAME, "Wildkaninchen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_RACE, "Hase");
  AddId ( ({"wildkaninchen", "kaninchen"}) );
  create_default_npc (7);
//  SetProp (P_BODY, 40);
  SetProp (P_SIZE, 25+random(5));
  SetProp(P_WEIGHT, 3000);
  SetProp (P_HANDS, ({" mit seinen Vorderpfoten", 50}));
  SetProp (P_ALIGN, 100);
//  SetProp (P_XP, 30000);
  SetProp (P_MSGOUT, "hoppelt von dannen");
  SUID;
  CLONEME (OBJ("div/karotte"));

  SetMove (SILBERWALD(""), 1, 0, 30, 60, 60, ROOM("room_a01"));
  ActivateMove (1);
}
