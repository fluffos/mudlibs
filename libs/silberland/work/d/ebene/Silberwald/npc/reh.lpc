inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein scheues Reh");
  SetProp (P_LONG,
    "Das Reh schaut Dich mit sanftem Blick und ein wenig scheu durch "
    "seine nussbraunen Augen an. Vorsichtig weicht es ein paar "
    "Schritte zurueck, ohne jedoch gleich Reissaus zu nehmen.");
  SetProp (P_NAME_ADJ, "scheu");
  SetProp (P_NAME, "Reh");
  SetProp(P_RACE, "Reh");
  SetProp (P_GENDER, NEUTER);
  AddId ("reh");
  AddAdjective ( ({"scheu", "scheues"}) );
  create_default_npc (8);
  SetProp (P_WIMPY, 45);
//  SetProp (P_BODY, 20+random(10));
  SetProp (P_SIZE, 110+random(20));
  SetProp(P_WEIGHT, 80000);
  SetProp (P_HANDS, ({" mit seinen zarten Beinen", 50+random(20) }));
  SetProp (P_ALIGN, 100+random(50));
//  SetProp (P_XP, 25000+random(5000));
}
