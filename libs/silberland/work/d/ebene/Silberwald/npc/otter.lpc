inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Otter");
  SetProp (P_LONG, "Der niedliche kleine Otter sieht Dich mit seinen "+
    "Kulleraugen an und\nwackelt froehlich mit seinen rundlichen, fast "+
    "ganz im Pelz versteckten\nOhren. Sein dunkelbraunes Fell schuetzt "+
    "ihn vor widriger Witterung.\n");
  SetProp (P_NAME, "Otter");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Otter");
  AddId ("otter");
  create_default_npc (6);
//  SetProp (P_BODY, 20);
  SetProp (P_SIZE, 40);
  SetProp(P_WEIGHT, 6000);
  SetProp (P_HANDS, ({" mit seinen Vorderpfoten", 60}));
  SetProp (P_ALIGN, -100);
//  SetProp (P_XP, 20000);
  SUID;
  CLONEME (OBJ("ruestung/otterfell"));
  command ("ziehe otterfell an");
}
