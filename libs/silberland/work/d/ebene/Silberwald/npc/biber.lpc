inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Biber");
  SetProp (P_LONG, "Der kleine putzige Biber wuselt geschaeftig hin und "
      "her. Staendig schaut er sich nach allen Richtungen um. Sucht er wohl "
      "etwas? Ob er sich verirrt hat? Hier ist doch gar kein Damm! Seltsam.");
  SetProp (P_NAME, "Biber");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Biber");
  AddId ("biber");
  create_default_npc (7);
//  SetProp (P_BODY, 20);
  SetProp (P_SIZE, 80);
  SetProp(P_WEIGHT, 6000);
  SetProp (P_HANDS, ({ " mit seinen scharfen Zaehnen", 70, DT_RIP }));
  AddSpell(1,90+random(11),
      "Der Biber erwischt Dich mit seinem Schwanz.\n",
      "Der Biber erwischt @WEN mit seinem Schwanz.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetProp (P_ALIGN, 79);
//  SetProp (P_XP, 23412);  // ;-)
  SUID;
  CLONEME (OBJ("ruestung/biberfell"));
  command ("ziehe biberfell an");
}

