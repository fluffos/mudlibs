#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

#define TEDDYFILE "/obj/teddy"
#define TEDDYLOG "/d/ebene/log/babybaer.log"

inherit "std/npc";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(12);

  AddId(({"babybaer", "baer", "junge", "junges"}));

  SetProp(P_NAME,"Babybaer");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Babybaer");
  SetProp(P_LONG, BS(
   "Der kleine Baer glaenzt Dich mit seinen wunderschoen scheinenden "
   "winzigen Augen an. Sein Fell spiegelt sich im Widerschein Deiner "
   "Lichtquelle wie Silber. Sicherlich ist seine fuersorgliche Mutter "
   "nicht sehr weit entfernt, um sich um ihn zu kuemmern, damit aus ihm "
   "einmal ein grosser Honigbaer werden kann."));

  SetProp(P_ALIGN, 300);
  SetProp(P_HEAL, 15);
  SetProp(P_HANDS, ({ " mit zierlichen Tatzen", 80 }) );
  SetProp(P_SIZE, 70);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_RACE, "Baer");
  SetProp(P_SOUND, "Du hoerst im Inneren des Baeren ein Brummen.\n");

  AddDetail( ({"augen"}),
      "Sie blitzen und blinzeln Dich freundlich an." );
  AddDetail( ({"fell"}),
      "Es ist sehr glatt und sieht gepflegt aus." );
  AddDetail( ({"widerschein","lichtquelle"}),
      "Du hast bestimmt eine Lichtquelle bei Dir, es sei denn, Du kannst "
      "im Dunkeln sehen." );
  AddDetail( ({"silber"}),
      "Es ist natuerlich kein echtes Silber. Lohnt also nicht, dem armen "
      "kleinen Baerchen das Fell abzujagen. ;-)" );
  AddDetail( ({"mutter"}),
      "Sie ist bestimmt nicht weit." );
  AddDetail( ({"honigbaer"}),
      "Bestimmt wird er das eines Tages." );

  /*
  // Dantes Version, die behauptet, dass der Topf VOR der Hoehle ist :)
  AddInfo( ({"honig","topf","honigtopf","hunger"}),
      "Bitte bringe mir einen Topf mit Honig. Ich haette ihn so gerne, denn "
      "Honig ist fuer kleine Baeren das Allerbeste und meine Lieblingsspeise! "
      "Der Topf muss ganz in der Naehe sein! Ich glaube vor der Hoehle, aber "
      "ich darf da nicht hinaus! Fuer mich ist es dort draussen noch zu "
      "gefaehrlich, und eigentlich trau ich mich ja auch noch gar nicht. "
      "Nicht mal um einen Topf mit Honig. Wenn Du ihn mir bringst, habe "
      "ich auch eine Kleinigkeit fuer Dich!", "sagt: ");
  */

  AddInfo( ({"honig","topf","honigtopf","hunger"}),
      "Bitte bringe mir doch einen Topf mit Honig! Honig ist fuer kleine "
      "Baeren wie mich das Allerbeste und natuerlich meine Lieblingsspeise! "
      "Irgendwo ganz in der Naehe muss einer sein, ich rieche es ganz genau, "
      "aber finden kann ich ihn nirgendwo! Dabei bin ich doch soooooooo "
      "hungrig! Wenn Du ihn findest, habe ich auch eine Kleinigkeit fuer "
      "Dich!", "sagt: ");

  AddInfo( ({"kleinigkeit","teddy","teddybaeren","teddybaer"}),
      "Es handelt sich um einen kleinen suessen Teddybaeren, der auf "
      "magische Weise verzaubert ist.", "sagt freundlich: ");

  AddInfo( ({"lieblingsspeise"}),
      "Das ist Honig, was denn sonst?", "brummt: ");

  AddInfo( ({"weise"}),
      "Ich weiss es leider nicht genauer.", "bedauert: ");

  AddInfo("baer",
      "*BRUMM* Ich bin einer, wenn auch nur ein kleiner!", "sagt: ");

  AddInfo( DEFAULT_INFO,
      ({
        "brummt leise vor sich hin.\n",
        "murmelt irgendwas von Honig.\n",
        "sagt: Aha. Aber hast Du auch Honig fuer mich?\n",
        "schaut Dich fragend und hungrig an.\n"
      }) );

  SetChats( 3, ({
      "Der Babybaer murmelt: Hach, ein kleiner Topf Honig... waer das fein!\n",
      "Der Babybaer jammert: Ich haette so gerne einen Topf Honig!\n",
      "Der Babybaer brummt leise.\n",
      "Der Babybaer sagt: Honig ist das Allerbeste fuer kleine Baeren!\n",
      "Der Babybaer sagt: Bitte bringe mir einen Topf Honig!\n" }) );

  AddCmd( ({"jag","jage"}), "jage" );

  seteuid(getuid());    // Rechte fuers Loggen setzen.
}


nosave void knuddeln()
{
  MENV->Message( "Der Babybaer knuddelt "+TP->name(WEN)+" ganz fest.\n",
              MSGFLAG_VISUAL+MSGFLAG_NO_TP );
  tell_object( TP, "Der Babybaer knuddelt Dich ganz fest.\n" );
}


void give_notify(object ob)
{
  object teddy;
  string wer;

  if (!interactive(TP))                 // just to be sure. :)
    return;

  if (ob->id("\nhonigtopf"))
  {
    write_file(TEDDYLOG,
        sprintf("[%s] %O bringt mir Honig :-)\n", dtime(), TP));

    MENV->Message( break_string("Uih, leeeeeecker!!! Danke, "+
          (wer=capitalize(getuid(TP)))+", ich hatte echt schon "
          "Riiiiiiesenhunger! *freu*",
          78, "Der Babybaer jubelt: "), MSGFLAG_SOUND );

    SetProp(P_FOOD,0);
    command_me( "iss honig" );
    if (ob) ob->remove();

    if(deep_present("\nuniversalteddy",TP))
    {
      MENV->Message( break_string("Oh, ich sehe Du hast ja schon einen Teddy"+
            ( present("\nuniversalteddy",TP) ?
              " bei Dir" : ", auch wenn Du ihn versuchst, zu verstecken" )+
            "! Na dann brauchst Du ja keinen zweiten! Also, danke nochmal!",
            78, "Der Babybaer sagt: "), MSGFLAG_SOUND );
      knuddeln();
      return;
    }

    if(present("\nuniversalteddy",environment()))
    {
      MENV->Message( break_string("Schau mal "+wer+", da liegt sogar noch "
            "ein Teddy am Boden herum! Hoffentlich ist er nicht zu schmutzig! "
            "Du kannst ihn gerne haben, aber pass gut auf ihn auf!", 78,
            "Der Babybaer sagt: "), MSGFLAG_SOUND );
      knuddeln();
      return;
    }

    if (! teddy = present("\nuniversalteddy"))
    {
      teddy = clone_object(TEDDYFILE);
      teddy->move(ME, M_NOCHECK);
    }
    MENV->Message( break_string("Zum Dank will ich Dir einen kleinen "
          "suessen Teddy schenken, dem ein wenig Magie innewohnt!",
          78, "Der Babybaer sagt: "), MSGFLAG_SOUND );

    if (! give_obj(teddy,TP)) {
      MENV->Message( break_string("Ohje, "+wer+", Du kannst den Teddy ja "
            "gar nicht mehr tragen! Ich leg ihn mal vorsichtig hier "
            "zur Seite, aber hol ihn Dir bald, sonst schnappt ihn Dir "
            "vielleicht noch jemand weg!", 78,
            "Der Babybaer sagt: "), MSGFLAG_SOUND );
      command_me( "leg teddy ab" );
    }
    knuddeln();
    return;
  } // if (ob->id("\nhonigtopf"))

  MENV->Message( break_string("Ein Topf mit Honig waer mir lieber als "+
        ob->name(WER)+", aber trotzdem danke! Da hast Du "+
        ob->QueryPronoun(WEN)+" wieder!", 78,
        "Der Babybaer brummt: "), MSGFLAG_SOUND );
  give_obj( ob,TP );
}


int jage(string str)
{
  string s1,s2;

  notify_fail("Was willst Du wem abjagen?\n");
  if (!stringp(str)) return 0;
  if (sscanf(str,"%s %s ab",s1,s2)!=2) return 0;
  if (!id(s1)) return 0;
  notify_fail("Das kannst Du dem Baeren nicht abjagen!\n");
  if (s2!="fell") return 0;

  write(
      "Du jagst den kleinen armen Baeren quer durch die ganze Hoehle.\n"
      "Ganz erschoepft und ausser Atem bleibst Du schliesslich stehen.\n"+
      break_string(
        "Der kleine Baer sieht Dich ganz verwundert an - aber sein Fell "
        "hat er immer noch. So leicht jagt man einem Baeren wohl nicht das "
        "Fell ab, selbst wenn es nur ein kleiner ist. Aber vielleicht hat "
        "ja nur Dein Mitleid Deinen Eifer gebremst ;-)", 78) );
  MENV->Message(
      break_string(TP->Name()+" jagt den kleinen Babybaeren quer durch die "
        "ganze Hoehle und bleibt schliesslich voellig ausser Atem stehen. "
        "Du musterst "+TP->Name(WEN,1)+" verwundert und schuettelst "
        "verstaendnislos den Kopf.", 78), MSGFLAG_VISUAL+MSGFLAG_NO_TP);
  return 1;
}


void NotifyEating(object wer)
{
  // *ROTFL* ohne die Abfrage war's lustig ;)
  if (wer==ME)
    return;

  MENV->Message(
      break_string("Der Babybaer bekommt ganz grosse Augen.\n"
        "Der Babybaer schaut "+wer->name(WEN,1)+" ganz furchtbar traurig "
        "an und stupst "+wer->QueryPronoun(WEN)+" mit der Nase an. Er muss "
        "wohl ziemlich hungrig sein...",
        78, 0, 1), MSGFLAG_VISUAL+MSGFLAG_NO_TP);
  tell_object(wer,
      "Der Babybaer bekommt ganz grosse Augen.\n"+
      break_string(
        "Der Babybaer schaut Dich ganz furchtbar traurig an und stupst Dich "
        "mit seiner Nase. Er ist wohl ziemlich hungrig, und Du isst da "
        "einfach Honig vor seiner Nase... wie grausam!", 78)
      );
}

