/*
** Maulwurfbaby  (w) Woody@SL
** ---
** Apr 15, 2004  Release
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../silberwald.h"


void init()
{
  ::init();
  if (TP && TP->id("maulwurfmama"))
    AddDefender(TP);
}

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Ein Maulwurfbaby");
  SetProp(P_LONG, "Das Maulwurfbaby kuckt Dich mit kleinen schwarzen "
    "Knopfaugen ganz veraengstigt an. Es ist offenbar erst vor kurzem "
    "zur Welt gekommen und kennt bis jetzt nicht viel ausser seiner "
    "Mama und ist auf ihren Schutz angewiesen.");
  SetProp (P_NAME, "Maulwurfbaby");
  SetProp (P_GENDER, NEUTER);
  AddId ("maulwurf");
  AddId ("maulwurfbaby");
  AddId ("baby");
  SetProp(P_RACE, "Maulwurf");
  create_default_npc(3);
//  SetProp (P_BODY, 30);
  SetProp(P_SIZE, 5+random(5));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_HANDS, ({" mit seinen kleinen Pfoetchen", 40}));
  SetProp(P_ALIGN, 150);
//  SetProp (P_XP, 60000);
  SetProp (P_RESISTANCE_STRENGTHS, ([DT_LIGHT:2.0, DT_FIRE:2.0]) );
  // Faktor 3 (DREI!!!) bei Licht- und Feuerangriffen.
}
