/*
** Ein Hase (ursprgl. von Dusty)
** ---
** 2002-04-22  P_WEIGHT
*/

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
inherit "std/mnpc";

#include "../silberwald.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Hase");
  SetProp(P_LONG, bs(
    "Der Hase schaut Dir ruhig in die Augen und knibbelt dabei an einem "
    "Stuecklein Loewenzahn. Sein Schnaeuzlein bewegt sich geschaeftig auf "
    "und ab.... ob Du nicht auch Gusto auf Loewenzahn bekommst?"));
  SetProp(P_NAME,"Hase");
  AddId("hase");
  SetProp(P_GENDER, MALE);
  create_default_npc(8);
  // SetProp(P_MAX_HP, 80);
  // SetProp(P_HP, 80);
  // SetProp(P_XP, 10000);
  SetProp(P_ALIGN, 50);
  SetProp (P_MSGOUT, "schlaegt einen Haken");
  SetProp(P_HEAL, 1);
  SetProp(P_HANDS, ({ " mit seinen Pfoetchen", 50 }));
  SetProp(P_SIZE, 30+random(5));
  SetProp(P_WEIGHT, 3000);
  // SetProp(P_BODY, 20);
  SetProp(P_RACE, "Hase");

  SetProp (P_MNPC_AREA, SILBERWALD(""));
  SetProp (P_MNPC_WAIT, ({ 30+random(20), 30, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("room_h09"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

  SUID;
  CLONEME("/d/ebene/obj/div/loewenzahn");
}

