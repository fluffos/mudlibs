inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Maulwurf");
  SetProp (P_LONG, "Der Maulwurf funkelt Dich boese an. Du hast ihn "
    "offenbar empfindlich in seiner Ruhe gestoert! Und besonders "
    "allergisch reagieren Maulwuerfe bekanntlich auf Licht...");
  // Die letzte Bemerkung geht o.k., weil der Spieler ohne Licht den
  // Maulwurf ja gar nicht untersuchen koennte... also hat er eins :)
  SetProp (P_NAME, "Maulwurf");
  SetProp (P_GENDER, MALE);
  AddId ("maulwurf");
  SetProp(P_RACE, "Maulwurf");
  create_default_npc (10);
//  SetProp (P_BODY, 30);
  SetProp (P_SIZE, 15+random(5));
  SetProp(P_WEIGHT, 4000);
  SetProp (P_HANDS, ({" mit seinen kleinen Pfoten", 80}));
  SetProp (P_ALIGN, -100);
//  SetProp (P_XP, 60000);
  SetProp (P_RESISTANCE_STRENGTHS, ([DT_LIGHT:2.0, DT_FIRE:2.0]) );
  // Faktor 3 (DREI!!!) bei Licht- und Feuerangriffen.
}
