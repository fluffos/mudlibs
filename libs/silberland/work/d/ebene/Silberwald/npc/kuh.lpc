/*
** Eine dumme Kuh  (w) Woody@SL
** ---
** 2023-01-30  1.0  Release
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../silberwald.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine dumme Kuh");
  SetProp (P_LONG,
    "Die braun-weiss gefleckte Kuh blickt Dir direkt in die Augen und kaut "
    "gemuetlich an einem Bueschel Gras. Sie wirkt nicht unbedingt so, als "
    "wuerde sie gerade an einer komplizierten mathematischen Aufgabe "
    "knobeln, vielmehr kann sie wohl nichts aus der Ruhe bringen. "
    "An ihrem Ohr ist ein kleines gelbes Schild befestigt.");
  SetProp (P_NAME_ADJ, "dumm");
  SetProp (P_NAME, "Kuh");
  SetProp(P_RACE, "Kuh");
  SetProp (P_GENDER, FEMALE);
  AddId ("kuh");
  AddAdjective ( ({"dumm", "dumme"}) );
  create_default_npc (11);
  SetProp (P_WIMPY, 0);
//  SetProp (P_BODY, 20+random(10));
  SetProp (P_SIZE, 130+random(20));
  SetProp(P_WEIGHT, 200000);
  SetProp (P_HANDS, ({" mit ihren Hoernern", 80+random(20) }));
  SetProp (P_ALIGN, 75+random(25));
//  SetProp (P_XP, 25000+random(5000));

  AddDetail( ({"ohr","ohren"}),
      "Die Kuh hat sehr huebsche, braune Ohren. "
      "An einem Ohr ist ein kleines, gelbes Schild befestigt." );
  AddDetail( ({"schild"}),
      "Auf dem gelben Schild steht: 'Bernetes'. Ob das der Name der Kuh ist?" );

  AddInfo( ({"bernetes"}),
      "Muuuuuuuh!", "muht: " );

}
