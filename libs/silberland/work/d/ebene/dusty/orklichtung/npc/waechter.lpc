// Dusty, August 2002

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Halborkwaechter");
  SetProp(P_LONG, 
  	"Der Halborkwaechter (halb Mensch, halb Ork, halb Waechter) knurrt Dich "
  	"boese an. Ein riesiger Kerl mit gewaltig boesen Augen, abstehenden "
  	"Ohren und langen Zaehnen, mit denen er Dich am liebsten "
  	"zerfleischen wuerde. Ob er wirklich so gefaehrlich ist, wie "
  	"er ausschaut?");
  SetProp(P_NAME, "Halborkwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "halborkwaechter", "orkwaechter", "halbork", "ork"}));

  create_default_npc(14);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " kippt einfach um.\n");
  
  SetChats(3, ({
	BS("Der Halborkwaechter ruelpst unanstaendig."),
	BS("Der Halborkwaechter schreit unmotiviert in der Gegend herum."),
	BS("Der Halborkwaechter tritt Dich vors Schienbein und findet das "
	   "sehr lustig.")
	           }));

  AddDetail( ({"augen"}), BS( "Boese verschlagene Augen glitzern Dich an." ));
  AddDetail( ({"ohren"}), BS( "Grosse Segelohren." ));
  AddDetail( ({"zaehne"}), BS( "Schaut irgendwie so aus wie in einem Alptraum." ));
  AddDetail( ({"gesicht"}), BS( "Ohren, Nase, Zaehne. Schaut nicht nett aus." ));
  AddDetail( ({"nase"}), BS( "Eine schiefe oftmals gebrochene Nase." ));

  AddInfo(DEFAULT_INFO, "knurrt Dich boese und zaehneflaetschend an.\n");

  SUID;
  CLONEME(WEAPON ("/sword/krummsaebel") );
  command("zuecke saebel");
  if(random(6) < 2)
  {
    CLONEME(ARMOUR ("/belt/guertel" ));
  }
  
  if( random(100)<50) CLONEME(ARMOUR ("/boots/sandalen" ));
  else CLONEME(ARMOUR ("/boots/fellstiefel" ));
  command("trage alles");
}

void init()
{ 
   ::init();
   if(interactive(TP))
     call_out("zutritt", 0);
     call_out("toetentoetentoeten", 0);

}

void zutritt()
{
  tell_room(MENV, "Der Halborkwaechter knurrt: Betreten auf eigene Gefahr!\n");
}
  
toetentoetentoeten()
{
  object ob;  
  if((ob=present("menschenfrau")) && ENV(TO) && !IsEnemy(ob))
  {
    tell_room(ENV(TO), "Der Waechter schreit: 'DU!!!! Du kommst mir nicht "
      "mehr aus!\n");
    Kill(ob);
  }
}
