// Dusty, August 2002

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Halbork");
  SetProp(P_LONG, BS(
    	"Der Halbork ist ein mittelmaessig grosser Mischling zwischen Ork und Mensch. Witzig an "
	"ihm ist, dass er neben grossen Hauern blonde Haare und blaue Augen hat. Schaut "
	"ziemlich kurios aus."));
  SetProp(P_NAME, "Halbork");
  SetProp(P_GENDER, MALE);
  AddId(({"halbork", "ork"}));

  create_default_npc(11);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -75);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  
  SetChats(3, ({
	BS("Der Halbork denkt ueber irgendwas nach."),
	BS("Der Halbork ordnet sich die Haare."),
	BS("Der Halbork putzt sich die Hauer.")	           }));

AddDetail( ({"hauer"}), BS( "Grosse Hauer, die ihn sichtlich stoeren." ));
AddDetail( ({"haare"}), BS( "Bei einem Ork schauen blonde Haare seltsam aus." ));
AddDetail( ({"augen"}), BS( "Blau blau blau wie der Enzian!" ));


  AddInfo(DEFAULT_INFO, "interessiert sich nicht fuer Dich.\n");

  SUID;
  CLONEME(WEAPON ("/sword/krummsaebel") );
  command("zuecke saebel");
  if(random(6) < 2)
  {
    CLONEME(ARMOUR ("/armour/ringelpanzer" ));
    CLONEME(ARMOUR ("/belt/guertel" ));
  }
  if ( random(100)<50) CLONEME(ARMOUR ("/boots/fellstiefel" ));
  else if( random(100)<50) CLONEME(ARMOUR ("/boots/sandalen" ));
  else CLONEME(ARMOUR ("/boots/lederstiefel") );
  command("trage alles");
}

init()
{
  ::init();
  call_out("toetentoetentoeten", 0);
}
  
toetentoetentoeten()
{
  object ob;  
  if((ob=present("menschenfrau")) && ENV(TO) && !IsEnemy(ob))
  {
    tell_room(ENV(TO), "Der Halbork bruellt: Da bist Du ja! "
                       "Bleibt stehen und stirb!\n");
    Kill(ob);
  }
}
