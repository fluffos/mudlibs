// Dusty, August 2002

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Halbork");
  SetProp(P_LONG, BS(
    	"Dieser Halbork ist ziemlich klein. Er hat weisse Haare und "
    	"rot leuchtende Augen. Irgendwie schaut er krank aus. "
    	"Oder vielleicht fehlt ihm nur was?"));
  SetProp(P_NAME, "Halbork");
  SetProp(P_GENDER, MALE);
  AddId(({"halbork", "ork"}));

  create_default_npc(12);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 140);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " kippt tot um.\n");
  
  SetChats(3, ({
	BS("Der Halbork sagt: Mir fehlt alle Farbe."),
	BS("Der Halbork tritt von einem Fuss auf den anderen."),
	BS("Der Halbork schaut in der Gegend herum.")	           }));

  AddDetail( ({"haare"}), BS( "Die sind weiss. So wie alles an ihm farblos ist." ));
  AddDetail( ({"augen"}), BS( "Sie leuchten Dich rot unterlaufen an." ));


  AddInfo(DEFAULT_INFO, "geniesst und schweigt.\n");

 AddInfo( ({"farbe"}),
          "Ich habe keine, ich bin glaub ich etwas farblos.", "bedauert: ");
 AddInfo( ({"albino"}),
          "JAA, ich glaub, ich bin so einer!", "ruft traurig aus: ");
 AddInfo( ({"halborks", "orks"}),
          "Wir wohnen hier, auf dieser Lichtung! Leider wollen die im "
          "Orkdorf uns nicht!", "bedauert: ");
 AddInfo( ({"orkdorf"}),
          "Ich weiss nicht, wo das ist. Aber auch wenn, hingehen duerften "
          "wir sowieso nicht, weil die moegen uns nicht.", "bedauert: ");


  SUID;
  CLONEME(WEAPON ("/sword/krummsaebel") );
  command("zuecke saebel");
  if(random(6) < 2)
  {
    CLONEME(ARMOUR ("/helm/lederhelm" ));
  }
  CLONEME(ARMOUR ("/boots/fellstiefel" ));
  command("trage alles");
}

init()
{
  ::init();
  call_out("toetentoetentoeten", 0);
}
  
toetentoetentoeten()
{
  object ob;  
  if((ob=present("menschenfrau")) && ENV(TO) && !IsEnemy(ob))
  {
    tell_room(ENV(TO), "Der Halbork mustert die Menschenfrau kurz und "
                       "entscheidet, sie als Mahlzeit zu betrachten.\n");
    Kill(ob);
  }
}
