inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

string query_retter();

object retter;

void create()
{

 // WENN MAN DIE KILLT IST MAN FURCHTBAR BOESE

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Menschenfrau");
  SetProp(P_LONG,
    "Die Menschenfrau schaut Dich mit aengstlichen Augen an. Sie ist mit "
    "blauen Flecken uebersaeht und sieht verzweifelt aus. Sie ist ziemlich "
    "abgemagert und zuckt nervoes herum, sobald sie irgendwo ein Geraeusch "
    "hoert. Irgendwie kommt sie Dir bekannt vor. Du kommst aber nicht drauf, "
    "woher.");
  SetProp(P_NAME, "Menschenfrau");
  SetProp(P_GENDER, FEMALE);
  AddId(({"frau", "menschenfrau"}));

  create_default_npc(5);
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 155);
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " seufzt ein letztes Mal.\n");
  
  AddInfo(DEFAULT_INFO, "rollt aengstlich mit den Augen.\n");

  AddInfo( ({"midas", "ueberfall"}),
      "Dddaaa kkkkommm ich hheeer.... aaaber auf einmaaaal wwwwwaren dddda"
	"ganz vvvvviele Oooooorks!", "stammelt: ");

  AddInfo( ({"entfuehrung", "geschichte"}),
      "Iiich hhhabe mmmmich gewwehrt aaalls sssiee mmmmich iiiin iiihr LLLaaager "
	"mmmmitnnehmen wwwwollten...... dddda hhhaben sie mmmmich, wwweil ssssie vvvvon "
	"vvvielen wwwilden KKkkkriegern vvvvon Mmmmidas vvvverfolgt wwwurden "
	"im Wwwald lllliegen lllassen uuuund dddiese schschschrecklichen "
	"Kkkeerle hhhier hhhaben mich geffffunnden unnnd wwwollten mmmmich fffresssen.", 
	"stammelt: ");
  AddInfo( ({"fressen", "pfahl", "orkhaeuptling"}),
      "Iiiiiccchhh hhhhabe mmmmich ggrad nnnnoch bbbefreien kkkkoennen in ddder Nnnacht "
	"bbbevor sssie mmmmich fffressen wwwollten.", "stammelt: ");
  AddInfo( ({"versteck"}),
          "Ich hhoffe, dddie findeen mich hier nnnnicht.", "stammelt: ");
  AddInfo( ({"hilfe", "aufgabe"}), "@@aufgabe@@", "stammelt: ");
  AddInfo( ({"retter"}), "@@query_retter@@ rettet mich!", "wimmert: ");
  AddInfo( ({"ork", "orks"}),
          "Wwwoooooooo?", "ruft entsetzt aus: ");

  SetChats( 5, ({
    "Die Menschenfrau versteckt sich hinter Dir.\n", 
    "Die Menschenfrau jammert was von wegen 'Entfuehrung aus Midas'.\n", 
    "Die Menschenfrau fuerchtet sich vor dem Orkhaeuptling.\n", 
    "Die Menschenfrau massiert ihre Handgelenke.\n", 
    "Die Menschenfrau zuckt erschrocken zusammen.\n", 
//    "Die Menschenfrau wimmert: "+ #'query_retter +" will mich retten!\n"
    "Die Menschenfrau reibt sich ihren Ellbogen.\n"
     }));

}

string aufgabe ()
{

  retter=TP;
  retter->AddPursuer(TO);
  return 
    "Wwwilllst Du mmmir hellllfen???? Wenn jjjja, dddaaan bbbbring mmmmich "
    "hier rrrrraus. Iiiich wwwwilll nur nach Mmmmmidas, dddort "
    "kkkkennn iiich mmmich wieder aus. Danke! DANKE!";
	
}

string query_retter()
{
  if(objectp(retter) && interactive(retter))
    return retter->Name();
  else
    return "Niemand";
}

init()
{
  string *filepfad;
  object ob,dummy;

  ::init();
  
  ob=present("buerger");
 
  if (   ob  
      && sizeof(filepfad=explode(file_name(ob),"/"))>=3 
      && filepfad[2]=="Midas" 
      && ENV(TO) )
  {
    tell_room(ENV(TO), 
      "\nDie Menschenfrau jubelt: Juhuuu! PAPA!\n"
      "Die Menschenfrau faellt "+ob->name(WEM)+" in die Arme.\n"+
      ob->Name()+" sagt: Hallo, mein Liebling! *freu*\n"+
      BS("Die Menschenfrau und "+ob->name(WER)+" gehen nach Hause, um Ihre "
         "Wiedervereinigung zu feiern.") +"\n");
         
    if(objectp(retter) && interactive(retter) && !present("\ndummyobj",retter))
    {
      dummy=clone_object(OBJ("dummy"));
      dummy->move(retter, M_NOCHECK);
      dummy->set_retter(retter);
      tell_object(retter, "Du fuehlst Dich nun erfahrener.\n");
      write_file(LOG("frauzurueck.log"), 
         dtime()+": "+retter->Name()+" hat die Menschenfrau gerettet.\n");
   }

    ob->move("/room/npcasylraum", M_GO);
    ob->remove();
    move("/room/npcasylraum", M_GO);

    call_out("remove",0);
  }
}

