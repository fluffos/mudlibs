// Dusty - August 2002

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();     
  SetProp(P_SHORT, "Krach Oger");
  SetProp(P_LONG, "Krach Oger ist ein Prachtexemplar seiner Rasse: \n"+
	"Dumm, gross und klobig. Man hoert ihn schon von weitem herankommen, "+
	"denn er laeuft einfach ueber alles, was ihm im Wege steht, ohne "+
	"Ruecksicht auf die Schaeden, die er anrichtet. Er hat wirre braune "
  "Haare und riesige Haende.\n");
  SetProp(P_NAME, "Krach Oger");
  SetProp(P_GENDER, MALE);
  AddId(({"oger", "krach oger", "krach", "Keulenkaempfer"}));

  create_default_npc(19);
  SetProp(P_ALIGN, -200);
  SetProp(P_RACE, "Oger");
  SetProp(P_SPELLRATE,50);
  SetProp(P_ARTICLE, 0);  
  SetProp(P_HANDS, ({" mit seinen klobigen Ogerhaenden", 200, DT_BLUDGEON}));
  SetProp(P_SIZE, 300);  
  
  AddDetail( ({"haare"}), BS( "Sie haengen ihm wirr vom Kopf herab." ));
  AddDetail( ({"haende"}), BS( "Schaufelgrosse Haende, bedrohlich!" ));

  
  AddSpell(1,300, 
    "Der Oger trampelt ueber Dich hinweg.\n",
    "Der Oger trampelt ueber @WEN hinweg.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,200, 
    "Krach Oger wirft einen Baum nach Dir.\n",
    "Krach Oger wirft einen Baum nach @WEM.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
      "Krach Oger grinst: 'Ich geh heim, Du gehst ein.'\n",
      "Krach Oger sagt: 'Pfffffffffffffffrz.'\n",
	    "Der Oger denkt nach und ueberhitzt sich sein Gehirn dabei.\n",
	    "Krach Oger bohrt daemlich in der Nase.\n",
	    "Krach Oger sagt: 'Gib mir Speck, sonst bist Du weg!'\n",
	    "Krach Oger teilt Dir mit: 'Wenn ich hau, schreist Du AU!'\n",
	    "Krach Oger grunzt: 'Magen leer, graemt mich sehr...'\n"
    	"Krach Oger reimt: 'Bin ich boes wirst Du nervoes.'\n"}));
 
  SetAttackChats(2, ({
	  "Krach Oger grinst vor Freude ueber eine zuenftige Pruegelei.\n",
	  "Krach Oger reibt sich gierig die Haende.\n"}));

  SetProp (P_DIE_MSG, " beendet sein haessliches Leben.\n");
  SetProp (P_DEFAULT_INFO, 
    "grinst Dich dumm an. Wahrscheinlich versteht er Dich nichtmal, so "
    "daemlich wie er ist.");

  SetProp( P_REJECT, ({ REJECT_KEEP,BS(
    "Krach Oger weiss zwar nicht, was er mit Deiner Gabe anfangen soll, "
    "behaelt sie sich aber trotzdem.") }));

  SetProp(P_MSGIN, "stampft gewalttaetig wichtig herein");
  SetProp(P_MSGOUT, "stampft, um Baeume zu Brezeln zu verformen,");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ROOM("orkweg") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("orkweg4"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MAYLOAD | MOV_MOVES );

SUID;
  CLONEME(WEAPON ("/club/keule"));
  command("zuecke keule");
}
