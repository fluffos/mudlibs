// Dusty - August 2002

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Halborkin");
  SetProp(P_LONG, BS(
      "Die Halborkin ist eine wahre Schoenheit ihrer Rasse. Dir erscheint sie allerdings ziemlich "
	"abstossend. Sie bleckt Dir ihre langen Zaehne entgegen, wirkt aber nicht unfreundlich. "
	"Falls je ein Orkabkoemmling als freundlich bezeichnet werden koennte, dann waere sie das "
	"sicher."));
  SetProp(P_NAME, "Halborkin");
  SetProp(P_GENDER, FEMALE);
  AddId(({"orkin", "halborkin" }));

  create_default_npc(10);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 160);
  SetProp(P_ALIGN, -20);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " faellt mit einem schrillen Schrei zu Boden.\n");
  
  SetChats(1, ({
	BS("Die Halborkin sagt: 'Der Viertelork ist mein Soehnchen!'"),
	BS("Die Halborkin fragt stolz: 'Ist mein Sohn nicht huebsch?'"),
	BS("Die Halborkin sagt: 'Wenn Menschen nicht so gut schmecken wuerden...'")
           }));
  AddDetail( ({"zaehne"}), BS( "Lange Orkzaehne." ));
  AddDetail( ({"schoenheit"}), BS( "Wenn Du orkisches Blut in Dir haettest, faendest Du sie schoen." ));

  AddInfo( ({"viertelork"}),
       "Mein Soehnchen! Ist er nicht huebsch? Sein Vater war der netteste "
      "Mensch, den wir je gegessen haben!", "sagt: ");
  AddInfo( ({"mensch"}),
          "Ja, die Menschen. Mein Vater war einer.", "kratzt sich am Kopf und sagt: ");
  AddInfo( ({"vater"}),
          "Meiner war ein Mensch und der Vater meines Sohnes war auch einer.", "nickt: ");
  AddInfo( ({"sohn", "soehnchen"}),
          "Der ist auch meistens hier im Lager zu finden.", "sagt: ");



  AddInfo(DEFAULT_INFO, "zuckt mit den Schultern und brummelt was von wegen 'Keine Ahnung'.\n");

  SUID;
  CLONEME(WEAPON ("/knife/fleischermesser") );
  command("zuecke messer");
  CLONEME(ARMOUR ("/ring/ring" ));
   command("trage alles");
}

init()
{
  ::init();
  call_out("toetentoetentoeten", 0);
}
  
toetentoetentoeten()
{
  object ob;  
  if((ob=present("menschenfrau")) && ENV(TO) && !IsEnemy(ob))
  {
    tell_room(ENV(TO), "Die Halborkin schreit: 'Da ist ja die, die mir "
                       "ausgekommen ist letztes Mal! STIRB!'\n");
    Kill(ob);
  }
}
