inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Viertelork");
  SetProp(P_LONG, BS(
  "Dieser Typ ist nur zu einem Viertel Ork. Dafuer ist er umso motivierter, boese "
	"und gemein zu sein. Eine haessliche Narbe entstellt sein ohnehin nicht gerade "
	"ansehnliches Gesicht. Scheint eine unsympathische Ratte zu sein."));
  SetProp(P_NAME, "Viertelork");
  SetProp(P_GENDER, MALE);
  AddId(({"ork", "viertelork", "mensch"}));

  create_default_npc(8);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " tritt Dich noch mal kraeftig.\n");
  
  SetChats(1, ({
	BS("Der Viertelork rempelt Dich an."),
	BS("Der Viertelork ueberlegt, wie er Dich am besten umbringen koennte."),
	BS("Der Viertelork denkt sich brutale Foltermethoden aus.") }));
  AddDetail( ({"narbe"}), BS( "Die Narbe geht von links nach rechts uebers "
    "ganze Gesicht." ));
  AddDetail( ({"gesicht"}), BS( "Angeekelt wendest Du Dich ab." ));
  AddDetail( ({"ratte"}), BS( "Das war eher bildlich gesprochen." ));


  AddInfo(DEFAULT_INFO, "versucht, Dich in die Nase zu beissen.\n");

 AddInfo( ({"methoden", "foltermethoden"}),
          "Hast Du irgendwelche originelle Ideen?", "fragt Dich mit "
          "leuchtenden Augen: ");
 AddInfo( ({"ideen"}),
          "Oh, mir faellt schon eine ganze Menge ein!", "ruft aus: ");
 AddInfo( ({"menge"}),
          "Ja, ich habe schon einige Ideen! Magst Du probieren?", "fragt: ");


  SUID;
  CLONEME(WEAPON ("/sword/holzschwert") );
  command("zuecke schwert");
  CLONEME(ARMOUR ("/boots/fellstiefel" ));
  if( random(6)<2) CLONEME(ARMOUR ("/belt/guertel") );
  command("trage alles");
}

init()
{
  ::init();
  call_out("toetentoetentoeten", 0);
}
  
toetentoetentoeten()
{
  object ob;  
  if((ob=present("menschenfrau")) && ENV(TO) && !IsEnemy(ob))
  {
    tell_room(ENV(TO), "Der Viertelork erkennt die Menschenfrau wieder "
      "und toegelt wild auf sie ein.\n");
    Kill(ob);
  }
}
