inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

// CLONES

  SetProp(P_SHORT, "Orkhaeuptling");
  SetProp(P_LONG,
    "Du siehst hier eindeutig den Haeuptling des Orklagers vor Dir. Er ist "
    "wohl auch ein Mischling zwischen Mensch und Ork, aber hier hat "
    "eindeutig mehr Ork als Mensch mitgemacht. Er schaut Dich gering"
    "schaetzig aus halb geschlossenen "
    "Augen an, aber vielleicht kann er ja ein paar Fragen beantworten?");
  SetProp(P_NAME, "Orkhaeuptling");
  SetProp(P_GENDER, MALE);
  AddId(({"ork", "orkhaeuptling", "haeuptling"}));

  create_default_npc(20);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) - 150);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_MSGIN, "rennt laut bruellend herein und schreit Dich an: \n"
  "'DAS IST MEIN THRON! AUF DEM SITZ NUR ICH!'");
  SetProp(P_DIE_MSG, " bruellt laut auf und faellt tot um.\n");
  
  AddDetail( ({"augen"}), 
    "Seine Augen sind zwar halb geschlossen, Du kannst aber sehen, dass sie "
    "gelb sein muessen. Passt ueberhaupt nicht zu seinen hellroten "
    "Haaren." );
  AddDetail( ({"auge", "aug"}), 
    "Beide Augen sehen gleich aus.");
  AddDetail( ({"haare", "haar"}), 
    "Die Haare des Orkhaeuptlings sind ordentlich gekaemmt. Da scheint der "
    "menschliche Einfluss durchgeschlagen zu haben." );

  
  AddInfo(DEFAULT_INFO, "sagt: Ich bin ein fast reinrassiger Ork!\n");

  AddInfo( ({"ork", "orks"}),
     "Ich weiss nicht, wo die richtigen Orks wohnen! Wenn ich das wuesste, "
     "haette ich laengst mal dort vorbeigeschaut. Obwohl die Mischlinge "
     "ja angeblich gar nicht gerne sehen...", 
		 "bruellt: ");
  AddInfo( ({"abstammung", "mischlinge", "rasse"}),
     "Aeh... meine Oma war so ein... aehhh Mensch.", "antwortet verlegen: ");
  AddInfo( ({"pack"}),
     "Was gibts denn da noch.... Ahja, Elfen und Dunkelelfen, Zwerge, "
     "Hobbits, Feen. Dann gibts noch Oger, aber da haben wir erst einen "
     "erwischt. Ahja, und Trolle.", "ueberlegt: ");
  AddInfo( ({"elfen"}),
          "Haben duenne Knochen. Sind leichte Opfer, ziemlich Weicheier!", 
          "kichert: ");
 AddInfo( ({"dunkelelfen"}),
          "Sind nachtschwarz, schmecken aber nicht wirklich.", "bedauert: ");
 AddInfo( ({"zwerge"}),
          "Ganz schoen wehrhaft. Aber wenn man sie mal gegart hat, dann "
          "schmecken sie toll!", "grinst: ");
 AddInfo( ({"feen"}),
          "An denen ist nicht viel dran, aber die Fluegel schmecken. Die " 
          "knacken ganz toll!", "laechelt abwertend: ");
 AddInfo( ({"hobbits"}),
          "Jaaa, an denen ist vor allem viel Fett!", "sabbert: ");
 AddInfo( ({"thron"}),
          "Das ist MEIN Thron! Nur ich sitz da drauf!", "kreischt: ");
 AddInfo( ({"trolle"}),
          "Die brennen total lustig!", "kichert: ");
 AddInfo( ({"oger"}),
          "Wenn man mal einen erwischt hat, dann hat man auf jeden Fall "
            "nachher genug.", "grinst: ");
 AddInfo( ({"mensch", "menschen"}),
          "Menschen sind Weichlinge und gehoeren gegessen! Genauso wie das "
          "andere Pack!", "bruellt: ");
 AddInfo( ({"haeuptling", "chef"}),
          "Ich bin hier der Chef!", "bruellt: ");
  AddInfo( ({"ueberfall", "ueberfall auf midas"}),
   "Bitte WIR sind das nicht. Ich weiss auch nicht, wo die richtigen "
	 "Orks herkommen, aber manchmal kommen sie bei uns vorbei und verpruegeln "
	 "uns oder laden ihren Muell bei uns ab. So wie dieses bloede Weib! ", 
	 "bruellt verstimmt: ");
 AddInfo( ({"midas"}),
      "Dieses Frauenzimmer, das ist aus Midas! Die Orks haben sie "
      "vorbeigebracht, weil sie sie nicht den ganzen Weg bis zum Orkdorf "
      "mitschleppen wollten!", "bruellt: ");
  AddInfo( ({"opfer", "pfahl"}),
      "Wir amuesieren uns auch manchmal. Selber schuld, wer hier hereinkommt "
      "und sich nicht verteidigen kann!", "bruellt: ");
  AddInfo( ({"frauenzimmer", "weib", "buergerin", "menschenweib"}),
      "Diese bloede Gurke ist einfach verschwunden!!! Nichtmal Spass haben "
      "konnten wir mit der. Seitdem werden alle doppelt so gruendlich "
      "verwahrt! Nochmal passiert uns das nicht!", "bruellt: ");
  AddInfo( ({"mahlzeiten"}),
          "Wer hier hereinkommt und mir nicht gefaellt, wird gegessen!", 
          "bruellt: ");

  SetChats(3, ({
  "Der Orkhaeuptling grummelt: Wo ist nur dieses Menschenweib hingekommen?\n", 
  "Der Orkhaeuptling starrt Dich an, dann den Pfahl im Norden "
    "und faengt an zu sabbern.\n", 
  "Der Orkhaeuptling droht: Wenn ich dieses Frauenzimmer finde!\n", 
  "Der Orkhaeuptling denkt an gebrateten Zwerg und trenzt.\n", 
  "Der Orkhaeuptling fragt sich, wann denn Essenszeit ist.\n"}) );

  SetProp(P_SPELLRATE, 30);

  AddSpell(1,200, 
    "Der Orkhaeuptling spuckt Dir einen spitzen Stein ins Auge.\n",
    "Der Orkhaeuptling spuckt @WEM einen spitzen Stein ins Auge.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,100, 
    "Der Orkhaeuptling boxt Dir in die Magengrube.\n",
    "Der Orkhaeuptling boxt @WEM in den Magen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SUID;

  CLONEME(WEAPON ("/axe/kriegsbeil" ));
  command("zuecke kriegsbeil");
  CLONEME(ARMOUR ("/belt/guertel" ));
  CLONEME(ARMOUR ("/armour/lederpanzer") );
  command("trage alles");
}

init()
{
  ::init();
  call_out("toetentoetentoeten", 0);
}
  
toetentoetentoeten()
{
  object ob;  
  if((ob=present("menschenfrau")) && ENV(TO) && !IsEnemy(ob))
  {
    tell_room(ENV(TO), "Der Haeuptling bruellt: Da bist Du ja! "
                       "Stirb, Menschenfrau!\n");
    Kill(ob);
  }
}

