inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"
#include <moving.h>

int knochenda;

create()
{
   ::create();
   knochenda=1;
   SetProp( P_INT_SHORT, "Auf einer Lichtung" );
   SetProp( P_INT_LONG,BS(
  "Du stehst jetzt inmitten der Lichtung. Die Lichtung ist hier breiter, der "
	"Wald wirkt hier irgendwie anders als vorhin. Der Boden ist hier total "
	"zerwuehlt. Du siehst einen grossen Pfahl aus dem Boden ragen. "
	"Im Sueden kannst Du einen grossen Thron erkennen. Der Himmel schimmert "
	"wieder durch die Baeume. Ausserdem stinkt es hier." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST ]) );

  AddDetail( ({ "sueden" }), 
                break_string( "Im Sueden steht ein Thron.", 78 ) );
  AddDetail( ({ "leute" }), 
                break_string( "Du siehst hier keine. Keine lebenden Leute "+
                "halt.", 78 ) );
  AddDetail( ({ "orks" }), 
                break_string( "Sie sind sicher nicht weit weg.", 78 ) );
   AddDetail( ({"baum", "baeume", "nadelbaeume"}), 
	BS( 	"Rund um Dich siehst Du nur Baeume. Naja, das ist auch klar, wenn Du "
		"auf einer Lichtung stehst." ));
  AddDetail( ({"boden"}), BS( "Der Boden ist hier total zerwuehlt. Hier "
    "koennte eine ganze Armee begraben sein und man wuerde nichts sehen." ));
  AddDetail( ({"armee"}), BS( "Aehm, so wars nicht gemeint. Aber Du kannst "
    "Dir durchaus vorstellen, dass hier jemand sein letztes Stuendlein "
    "schlagen gehoert haben koennte. Und recht weit weg tragen tun die Orks "
    "ihre Opfer sicher nicht." ));

  AddDetail( ({"lichtung", "orklichtung"}), BS( "Hier stehst Du inmitten "
    "der Lichtung." ));
  AddDetail( ({"wald"}), BS( "Der Wald ist hier ganz dicht und "
    "undurchdringlich. Bis auf eine Stelle im Unterholz, die Dir seltsam "
    "erscheint." ));
  AddDetail( ({"stelle"}), BS( "An einer Stelle siehst Du "
	  "Spuren von relativ kleinen nackten Fuessen ins Unterholz hineingehen." ));
  AddDetail( ({"fuesse"}), BS( "Die Fuesse siehst Du nicht, nur die "
    "Fussspuren." ));
  AddDetail( ({"unterholz"}), BS( "Es wirkt total dicht, bis auf eine "
    "Stelle, an der Fussspuren durchs selbige in den Wald hineinfuehren." ));
  AddDetail( ({"fussspuren", "spuren"}), BS( "Eindeutige Fussspuren fuehren "
    "in den Wald hinein. Nur das Unterholz hindert Dich daran, hineinzugehen. "
    "Vielleicht solltest Du das Unterholz beiseite schlagen?" ));

  AddDetail( ({"pfahl"}), BS( "Ein dicker grosser Pfahl mit Einbuchtungen "
    "darin. Scheinbar werden hier die Opfer der Halborks dran festgebunden, "
    "damit sie nicht mehr entkommen koennen, falls sie zu einer Zeit hier "
    "reinkommen, wo die Halborks keinen Hunger haben." ));
   AddDetail( ({"stuendlein"}), BS( "Ob Deines schon geschlagen hat?" ));
   AddDetail( ({"einbuchtungen"}), BS( "Die Einbuchtungen sind wohl dazu "
    "da, damit man die Fesseln besser festzurren kann. *schauder*" ));
   AddDetail( ({"fesseln"}), BS( "Vermutlich verwenden die Orks Seile oder "
    "Schnuere, weil hier nur ein paar Fusselreste zu sehen sind. Ausserdem "
    "faellt Dir erst jetzt auf, dass eingetrocknete Blutspuren ueber den "
    "ganzen Pfahl verteilt sind." ));
   AddDetail( ({"opfer"}), BS( "Vermutlich Leute, die sich nichts ahnend "
    "hier her verirrt haben. Bis auf Dich sind allerdings keine zu sehen." ));
   AddDetail( ({"halborks", "halbork"}), BS( "Halb Orks, halb Menschen." ));
   AddDetail( ({"zeit"}), BS( "Wer zu falschen Zeit am falschen Ort ist, "
    "kann in Probleme kommen." ));
   AddDetail( ({"hunger"}), BS( "Halborks sind genauso blutruenstig wie "
    "Orks, aber viel feiger. Aber Hunger haben sie genausoviel wie normale "
    "Orks." ));
   AddDetail( ({"seile", "schnuere"}), BS( "Hier sind nur Reste zu sehen, "
    "aber Du hast sowieso keine Lust, gefesselt zu werden." ));
   AddDetail( ({"fusselreste", "reste", "ueberreste"}), BS( "Kleine blutverschmierte "
    "Ueberreste von Schnueren oder Seilen. Scheinbar fesseln die Halborks "
    "ihre Opfer sehr gruendlich, bevor sie sie essen." ));
   AddDetail( ({"blutspuren"}), BS( "Auf dem Pfahl und den Fusselresten "
    "sind ueberall welche." ));
   AddDetail( ({"spuren"}), BS( "Hier gibt es diverse Spuren. Fussspuren, "
    "Blutspuren...." ));
   AddDetail( ({"ort"}), BS( "Zum Beispiel hier in diesem Lager!" ));
   AddDetail( ({"lager", "halborklager"}), BS( "Du bist im Halborklager, "
    "das stimmt." ));
   AddDetail( ({"probleme"}), BS( "NOCH hast Du keine!" ));
   AddDetail( ({"thron"}), BS( "Im Sueden erkennst Du sowas wie einen Thron. "
    "Oder zumindest ein ueberdimensionaler Sessel, von dem aus man die ganze "
    "Lichtung ueberblicken kann." ));
   AddDetail( ({"himmel"}), BS( "Der Himmel ist blaugrau." ));
   AddDetail( ({"sessel"}), BS( "Der Sessel oder Thron oder wie auch immer "
    "steht im Sueden." ));

   AddSound( ({ "geraeusch", "geraeusche" }), BS( "Du hoerst nichts, "  
    "absolut garnichts." ));
   AddSmell (DEFAULT_SMELL,
    bs("Hier stinkt es nach Angstschweiss, Blut und Halborks."));
   
   AddSmell( ({ "angstschweiss" }), BS( "Vermutlich noch vom letzten Opfer "
    "der Halborks." ));
   AddSmell( ({ "orks", "ork", "halborks", "halbork" }), 
	    BS( "Ein ganz eindeutiger Geruch." ));
   AddSmell( ({ "blut" }), BS( "Es riecht hier nach blut, irgendwie "
    "metallisch." ));

  AddSmell (DEFAULT_SMELL,
    bs("Hier stinkt es nach Angstschweiss."));

   AddExit( "norden", ROOM("lichtung1") );
   AddExit( "sueden", ROOM("lichtung3") );
   AddExit( "nordwesten", ROOM("lichtung4") );

     AddItem(NPC("halbork2"), REFRESH_DESTRUCT);


 AddCmd(({"wuehl", "wuehle"}),"wuehlen");
 AddCmd(({"fessel", "fessel", "fessle"}),"fesseln");
 AddCmd(({"schlag", "schlage", "dresche", "drisch"}),"schlagen");

}


zuwachsen()
{
   RemoveExit("osten");
   tell_room(TO, "Das Unterholz wuchert den Ausgang im Osten wieder zu.\n");
}


int schlagen(string str)
{
  object weap;
  string wtyp;
  
  notify_fail("Was willst Du beiseite schlagen?\n");
  if (str != "unterholz beiseite")
     return 0;

  if(member(m_indices(QueryProp(P_EXITS)),"osten")>=0)
  {
     notify_fail("Das Unterholz wurde doch bereits beiseitegeschlagen!\n");
     return 0;
  }

  if(!weap=TP->QueryProp(P_WEAPON))
  {
    notify_fail("Du hast doch gar keine Waffe gezueckt!\n");
    return 0;
  }

  if (present("viertelork"))
  {
    notify_fail(BS("Der Viertelork hindert Dich daran."));
    return 0;
  }

  wtyp=weap->QueryProp(P_WEAPON_TYPE);
  if((wtyp != WT_SWORD)   &&   (wtyp != WT_AXE))
  {
    notify_fail(BS(
      "Du schlaegst und drischst auf das Unterholz ein, aber es gelingt Dir "
      "nicht, Dich durchzuschlagen. Vielleicht solltest Du eine andere "
      "Waffe probieren?"));
    say(BS(TP->Name()+" drischt sinnlos auf das Unterholz ein."));
    return 0;
  }
  
  write(BS("Du schlaegst das Unterholz beiseite und legst einen Ausgang nach "
        "Osten frei."));
  say(TP->Name()+" hackt wie wild auf das Unterholz ein.\n");  
  AddExit("osten", ROOM("versteck"));
  call_out("zuwachsen",20);
  return 1;
}



int wuehlen(string str)
{
  object ob;
  notify_fail("Worin willst Du wuehlen?\n");
  if (!str) return 0;
  if (str=="in boden"||str=="boden" ||str=="erde" ||str=="in erde")
  {
    if(!knochenda)
    {
      write("Hm. Irgendwer hat da scheinbar vor Dir schon mal gewuehlt.\n");
      return 1;
    }
    write(BS("Du beginnst wie ein Trueffelschwein in der Erde "
      "herumzuwuehlen. Nach kurzer Suche findest Du einen Knochen. IGITT! "
      "Du hast irgendwie keine Lust mehr, hier noch weiter zu suchen, wer "
      "weiss was da noch kommen koennte."));
    say(BS(TP->Name()+" faengt an zu schnueffeln und wuehlt im matschigen "
      "Boden herum."));
    ob=CLONEOB(OBJ("knochen.lpc"));
    ob->move(ENV(TP));
    ob->move(TP);
    knochenda=0;
    return 1;
  }
  return 0;
}
  
int fesseln(string str)
{
  notify_fail("Wenn hier jemand gefesselt wird, dann hoechstens Du selbst!\n"); 
  say(TP->Name()+" ueberlegt kurz etwas, laesst es dann aber doch bleiben.\n");
  return 0;
}
  
void reset() 
{
  knochenda=1;
  ::reset();
}
