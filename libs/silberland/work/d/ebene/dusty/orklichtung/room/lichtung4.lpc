inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../def.h"
#include <moving.h>

int axtda;
int nadelda;


create()
{
   ::create();
   axtda=1;
   nadelda=1;
   SetProp( P_INT_SHORT, "Auf einer Lichtung" );
   SetProp( P_INT_LONG,
    	"Du stehst hier auf einer Lichtung mitten im Wald. Ueberall siehst Du Baeume, "
	"Straeucher und Unterholz. Der Boden ist auch hier zertrampelt und matschig, "
	"den Himmel kannst Du von kaum erkennen. Im Suedosten erblickst Du einen "
	"in den Boden gerammten Pfahl." );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST ]) );

  AddDetail( ({ "wald" }), 
                break_string( "Du bist hier auf einer Lichtung im Wald.", 78 ) );
  AddDetail( ({ "suedosten" }), 
                break_string( "Im Suedosten siehst Du einen Pfahl.", 78 ) );
  AddDetail( ({ "fuesse" }), 
                break_string( "Stinken sie?", 78 ) );
   AddDetail( ({"baum", "baeume"}), 
	   "Rund um Dich siehst Du Nadelbaeume. Tannen!" );
   AddDetail( ({"boden"}), 
	BS( "Der Boden ist matschig. Es macht lustige Geraeusche, wenn Du Deine "
	  "Fuesse hebst." ));
 AddDetail( ({"nadelbaeume", "tannen"}), BS( "Nadelbaeume sind Baeume mit "
  "Nadeln dran." ));
 AddDetail( ({"nadeln", "tannennadeln"}), BS( "Viele viele Tannennadeln "
  "sind hier ueberall!" ));
 AddDetail( ({"straeucher", "gestruepp", "unterholz"}), BS( "Straeucher, "
  "Gestruepp und Unterholz saeumen den Rand der Lichtung." ));
 AddDetail( ({"himmel"}), BS( "Du kannst den Himmel von hier aus kaum erkennen." ));
 AddDetail( ({"rand", "rande"}), BS( "Am Rand der Lichtung siehst Du Straeucher, "
	"Gestruepp und Unterholz. Ahja, und Nadelbaeume." ));
 AddDetail( ({"lichtung"}), BS( "Du stehst am westlichen Rande derselben." ));
 AddDetail( ({"pfahl"}), BS( "Im Suedosten siehst Du einen in den Boden gerammten Pfahl." ));
 AddDetail( ({"orklager", "lager"}), BS( "Spaetestens der Geruch hat Dir verraten, dass hier irgendwo "
	"Orks gewesen sein muessen." ));
 AddDetail( ({"geruch"}), BS( "Riech mal!" ));
 AddDetail( ({"geraeusche"}), BS( "Lauschen hilft!" ));
 AddDetail( ({"matsch"}), BS( "Brauner Matsch, in dem man leicht einsinkt." ));


 AddSound( ({ "geraeusch", "geraeusche" }), BS( "Die einzigen Geraeusche, die Du hoerst, sind "
	"die Deiner Fuesse, wenn Du sie hebst." ));
 AddSmell(DEFAULT_SMELL, "Es riecht nach Orks und nach Menschen. Und nach Matsch!");   
 AddSmell( ({ "ork", "orks" }), BS( "Hier riecht es ganz nach Orks." ));
 AddSmell( ({ "menschen", "mensch"}), BS( "Komischerweise riecht es hier auch nach Mensch." ));
 AddSmell( ({ "matsch"}), BS( "Riecht matschig." ));
 AddSound( ({ "fuesse"}), BS( "Hihi! Es macht ein saugendes Geraeusch *gnatsch*." ));

 AddExit( "osten", ROOM("lichtung1") );
 AddExit( "suedosten", ROOM("lichtung2") );
 AddExit( "nordosten", ROOM("orkweg4") );

 AddItem(NPC("halborkin"), REFRESH_DESTRUCT);
 AddItem(NPC("halbork"), REFRESH_DESTRUCT);

}
