inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../def.h"
#include <moving.h>

int gesessen;

create()
{
   ::create();
   
   gesessen=0;
   SetProp( P_INT_SHORT, "Auf einer Lichtung" );
   SetProp( P_INT_LONG,BS(
    	"Du bist am suedlichen Ende der Lichtung angelangt. Hier ist der "
    	"Boden fast nicht zermatscht, Buesche und Unterholz begrenzen die "
    	"Lichtung. Der Wald ist dicht und undurchdringlich. Ausserdem siehst "
    	"Du einen auffaelligen Thron vor Dir stehen, der von Bueschen "
    	"umrahmt ist. Der Himmel ist hier gar nicht zu erblicken.")); 
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST ]) );

  AddDetail( ({ "gras" }), 
                break_string( "Grashalme sinds.", 78 ) );
  AddDetail( ({ "pflanzen" }), 
                break_string( "Buesche.", 78 ) );
  AddDetail( ({ "tier" }), 
                break_string( "Keines hier, kein Tier.", 78 ) );
  AddDetail( ({ "koenig" }), 
                break_string( "In dem Thron sollte ein Koenig oder sowas "+
                "sitzen.", 78 ) );
  AddDetail( ({ "norden" }), 
                break_string( "Du kannst hier nur nach Norden.", 78 ) );
   AddDetail( ({"baum", "baeume", "wald"}), 
	BS( 	"Der Wald ist undurchdringlich und dicht, es gibt hier nirgends ein "
	"Durchkommen." ));
   AddDetail( ({"thron"}), BS( "Normalerweise wuerde in so einem Thron ein "
   "Koenig oder ein anderes hohes Tier sitzen. Dieser hier ist jedoch leer. "
   "Vielleicht magst Du Dich mal hinsetzen?" ));
   AddDetail( ({"ende"}), BS( "Hier gehts nur mehr wieder nach Norden." ));
   AddDetail( ({"boden"}), BS( "Der Boden ist hier kaum zermatscht. Frische "
    "Grashalme wachsen hier, sogar Gaensebluemchen kannst Du eines "
    "entdecken." ));
   AddDetail( ({"grashalme", "halme", "halm", "grashalm"}), BS( "Hier "
   "wachsen welche, sie sind aber nicht essbar und ausserdem uninteressant. "
   "Es schaut nur schoen aus." ));
   AddDetail( ({"gaensebluemchen", "bluemchen"}), BS( "Ein ganz keckes "
   "Gaensebluemchen steckt den Kopf aus den Grashalmen heraus. Was das wohl "
   "schon alles mit angesehen hat?" ));
   AddDetail( ({"kopf", "koepfchen"}), BS( "Ein gelbes Koepfchen mit weissen "
   "Blaettlein dran." ));
   AddDetail( ({"blaetter", "blaettlein"}), BS( "Weisse Blaetter zieren das "
   "gelbe Koepfchen des Gaensebluemchens." ));
   AddDetail( ({"himmel"}), BS( "Du kannst den Himmel nur erahnen." ));
   AddDetail( ({"lichtung"}), BS( "Du bist am suedlichen Ende derselben." ));
   AddDetail( ({"durchkommen"}), BS( "Es gibt keines." ));
   AddDetail( ({"buesche"}), BS( "Diese Buesche sind sicher nicht natuerlich "
   "hier gewachsen. Sie stehen ordentlich und offensichtlich zur Zierde um den "
   "Thron herum. Wer sich da solche Muehe gemacht hat?"));
 AddDetail( ({"zierde"}), BS( "Die Buesche sind wohl zur Zierde des "
  "eigentlich ziemlich haesslichen Thrones gepflanzt worden." ));
 AddDetail( ({"muehe"}), BS( "Hm. Als Du nochmal drueber nachdenkst, wer "
  "sich da solche Muehe gemacht haben koennte, faellt Dir ein "
	"kleines weisses Band um den Stamm eines der Buesche auf." ));
 AddDetail( ({"band"}), BS( "Auf dem Band steht etwas geschrieben." ));
 AddDetail( ({"stamm"}), BS( "Der Stamm (soweit man bei einem Busch Stamm "
 "sagen kann) hat ein kleines weisses Band drumherum gewickelt." ));
 AddReadDetail( ({"band"}), BS( "In verblichenen Buchstaben steht hier geschrieben:"
	"'H*b**kusb***che, S***n aus E**te d** J****s **** gepf****t v** Blu Menerde, "
	"F*****e Kap***g**ten F**onia." ));
 AddDetail( ({"hibiskusbuesche", "hibiskus", "h*b**kusb***che"}), BS( "Ahja, das ist "
	"also H*b**kus, gut zu wissen." ));
  AddDetail( ({"kapellgarten"}), BS( "Hm. Warst Du dort noch nicht?" ));
  AddDetail( ({"felonia"}), BS( "Das ist die Stadt im Gebirge, wo die Zwerge hausen." ));
  AddSound( ({ "geraeusch", "geraeusche" }), BS( "Du hoerst nichts, absolut garnichts." ));
  AddSmell( ({ "orks", "menschen" }), BS( "Riecht ungewaschen." ));
  AddDetail( ({"unterholz"}), BS( "Das Unterholz ist unauffaellig." ));

  AddSmell (DEFAULT_SMELL,
    bs("Hier riechts nach Orks und Menschen."));

   AddExit( "norden", ROOM("lichtung2") );

//  AddItem(NPC("krach"), REFRESH_DESTRUCT);
  AddCmd(({"pfluecke", "pflueck", "reisse", "reiss"}),"reissen");
  AddCmd(({"sitz", "sitze", "setz", "setze"}),"sitzen");

}

int sitzen(string str)
{
  notify_fail("Worauf willst Du sitzen?\n");
  if (str!="auf thron" && str!="nieder" && str!="hin" && str!="in thron"
      && str!="dich hin")
    return 0;
  if (present("haeuptling"))
  {
    notify_fail(BS("Der Haeuptling hindert Dich daran, Dich auf den Thron zu "
                "setzen."));
    return 0;
  }
  if (gesessen)
  {
    notify_fail(BS("Du setzt Dich kurz auf den Thron. Als nix passiert, "
                "stehst Du enttaeuscht wieder auf."));
    return 0;
  }
  
  write("Du setzt Dich auf den Thron und springst sofort wieder auf.\n");
  say(TP->Name()+" setzt sich auf den Thron, springt aber sofort "
      "wieder auf.\n");
  clone_object(NPC("haeuptling"))->move(TO,M_GO);
  gesessen=1;
  return 1;
}



int reissen(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if(str!="gaensebluemchen" && str!="gaensebluemchen aus")
    return 0;
  
  write(BS("Als Du versuchst, das Gaensebluemchen auszureissen, "
     "verschwindet es auf einmal im Boden. Wow! Deswegen hat es also "
     "bis jetzt hier ueberlebt! - Oh, jetzt ist es wieder da!")); 
  say(TP->Name()+" bueckt sich und tut irgendwas.\n");
  return 1;
}
  
reset()
{
  gesessen=0;
  ::reset();
}
