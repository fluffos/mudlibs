inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../def.h"
#include <moving.h>

int axtda;
int nadelda;


create()
{
   ::create();
   axtda=1;
   nadelda=1;
   SetProp( P_INT_SHORT, "Auf einer Lichtung" );
   SetProp( P_INT_LONG,
    	"Du stehst auf einer kleinen Lichtung mitten im Wald. Scheinbar bist Du "
	"hier in einem Orklager oder so gelandet, aber irgendwie haettest Du Dir das "
	"viel groesser und boeser vorgestellt. Rundherum siehst Du Baeume, Straeucher "
	"und am Rand der Lichtung Unterholz. Der Boden ist wild zertrampelt und matschig, "
	"den Himmel kannst "
	"Du von hier kaum erkennen. Etwas weiter im Sueden erblickst Du einen "
	"in den Boden gerammten Pfahl. Irgendwie ist es hier sehr still, Du "
	"kannst nicht das geringste Geraeusch vernehmen." );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST ]) );

  AddDetail( ({ "auge" }), 
                break_string( "*pieks*", 78 ) );
  AddDetail( ({ "ork", "orks" }), 
                break_string( "Sie sind sicher ganz nahe!", 78 ) );
  AddDetail( ({ "sueden" }), 
                break_string( "Im Sueden erblickst Du einen Pfahl.", 78 ) );
  AddDetail( ({ "tannen" }), 
                break_string( "Hohe Tannen versperren hier fast die Sicht "+
                "zum Himmel.", 78 ) );
   AddDetail( ({"baum", "baeume", "wald",}), 
	   "Rund um Dich siehst Du nur Nadelbaeume. Naja, das ist auch klar, wenn Du "
		 "auf einer Lichtung stehst." );
   AddDetail( ({"boden"}), 
	   BS( "Der Boden besteht aus zertrampeltem Gras und ist ziemlich matschig." ));
   AddDetail( ({"nadelbaeume"}), BS( "Nadelbaeume sind Baeume mit Nadeln dran. Damit kann "+
	   "man jemanden stechen." ));
 AddDetail( ({"nadeln"}), BS( "Dir sticht eine besonders grosse Nadel ins Auge. AUA!" ));
 AddDetail( ({"nadel"}), BS( "Vielleicht kannst Du sie ja ausreissen?" ));
 AddDetail( ({"straeucher"}), BS( "Straeucher und Gestruepp saeumen den Rand der "+
	"Lichtung." ));
 AddDetail( ({"gestruepp"}), BS( "Gestruepp und Straeucher saeumen den Rand der "
	"Lichtung. Hoppla, irgendwie steht aus dem Gestruepp etwas heraus?" ));
 AddDetail( ({"etwas"}), BS( "Du inspizierst das Gebuesch naeher und siehst, dass der "
	"Stiel von etwas aus ihm herausragt." ));
 AddSpecialDetail( ({"stiel"}), "axt" );

 AddDetail( ({"unterholz"}), BS( "Das Unterholz ist unauffaellig." ));
 AddDetail( ({"himmel"}), BS( "Du kannst den Himmel von hier aus kaum "
  "erkennen, so hoch stehen hier die Tannen." ));
 AddDetail( ({"rand", "rande"}), BS( "Am Rand der Lichtung siehst Du "
  "Straeucher, Gestruepp und Unterholz. Ahja, und Nadelbaeume." ));
 AddDetail( ({"lichtung"}), BS( "Du stehst am oestlichen Rande derselben." ));
 AddDetail( ({"pfahl"}), BS( "Im Sueden siehst Du einen in den Boden "
  "gerammten Pfahl." ));
 AddDetail( ({"orklager", "lager"}), BS( "Spaetestens der Geruch hat Dir "
  "verraten, dass hier irgendwo Orks gewesen sein muessen." ));
 AddDetail( ({"geruch"}), BS( "Riech mal!" ));
 AddDetail( ({"gras"}), BS( "Zertrampeltes, ehemalig gruenes Gras." ));

 AddSound( ({ "geraeusch", "geraeusche" }), BS( "Du hoerst nichts, absolut "
  "garnichts." ));
 AddSmell(DEFAULT_SMELL, "Es riecht nach Orks und nach Menschen.");   
 AddSmell( ({ "ork", "orks" }), BS( "Hier riecht es ganz nach Orks." ));
 AddSmell( ({ "menschen", "mensch"}), BS( "Komischerweise riecht es hier "
  "auch nach Mensch - geraeuchertem, gepoekeltem, gegrilltem...." ));
 AddSmell( ({ "geraeuchterter mensch", "geraeucherten mensch" }), 
  BS( "Wuerzig!" ));
  AddSmell( ({ "gepoekelten mensch", "gepoekelter mensch" }), 
  BS( "Pikant!" ));
 AddSmell( ({ "gegrillter mensch", "gegrillten mensch" }), 
  BS( "Sicher schwer verdaulich..." ));
    
 AddExit( "sueden", ROOM("lichtung2") );
 AddExit( "norden", ROOM("orkweg4") );
 AddExit( "westen", ROOM("lichtung4") );


 AddItem(NPC("viertelork"), REFRESH_DESTRUCT);
 AddItem(NPC("waechter"), REFRESH_DESTRUCT);

 AddCmd(({"reisse", "reiss"}),"reissen");

}

int reissen(string str)
{
  string was;
  object nadel;
  notify_fail("Was willst Du ausreissen?\n");
  if(!str) return 0;   // Bugfix Feyaria
  if (sscanf(str,"%s aus", was) && (was=="tannennadel" || was=="nadel"))
  {
    if(!nadelda || deep_present("\ndustynadel", TO))
    {
      write("Du reisst und reisst, aber die Nadel geht nicht ab.\n");
      return 1;
    }
    write("Du reisst eine Nadel aus und steckst sie ein.\n");
    say(TP->Name()+" reisst eine Tannennadel aus und steckt sie ein.\n");
    nadel=CLONEOB(OBJ("nadel.lpc"));
    nadel->move(ENV(TP));
    nadel->move(TP);
    nadelda=0;
    return 1;
  }
  return 0;
}


string axt (string str)
{
  object ob;
  
  if(axtda)
  {
    axtda=0;
	  ob=clone_object("/p/weapon/axe/handaxt.lpc");
	  ob->move(ENV(TP));
	  ob->move(TP);
    return BS( "Als Du an dem Stiel herumruettelst, hast Du ihn auf einmal "
  	"in der Hand. Hoppla, das ist ja eine Axt! Vielleicht kannst Du die hier "
	  "noch brauchen?" );
	}
  else
  {
    return BS("Komisch. Scheinbar hast Du Dich getaeuscht...");
  }
  
}


void reset() 
{
  axtda=1;
  nadelda=1;
  ::reset();
}
