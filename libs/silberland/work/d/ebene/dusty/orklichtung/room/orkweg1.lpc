// Dusty, August 2002

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>

inherit ROOM("stdwald.lpc");


create()
{
  ::create();

SetProp( P_INT_LONG, BS("Du stehst am Rande eines Tannenwalds. Im Osten wird "
  "der Wald dichter, im Westen liegt ein Trampelpfad. Der Boden ist von "
  "dichten Tannennadeln bedeckt. Irgendwie geht von dem Tannenwald eine " 
  "seltsame Schwingung aus, die Dich etwas beunruhigt. Ausserdem "
	"fehlen Dir hier irgendwie die ueblichen Geraeusche des Waldes. Seltsam."));

  AddDetail( ({"baum", "baeume", "wald", "tanne", "tannen", "tannenwald"}), 
	 "Die Tannen stehen stramm herum. Hier sind sie noch nicht so dicht wie "
	 "weiter im Osten." );
  AddDetail( ({"rand", "rande"}), BS( "Hier beginnt der dunkle Tannenwald, "
    "du stehst also am Rand von selbigem." ));
  AddDetail( ({"pfad", "trampelpfad"}), BS( "Der Trampelpfad im Westen ist "
    "hier noch deutlich zu sehen." ));
  AddDetail( ({"schwingung"}), BS( "Die seltsame Schwingung, die Du hier "
    "empfindest, verheisst nichts Gutes. Du kannst sie aber nicht zuordnen." ));
  AddDetail( ({"geraeusche"}), BS( "Lausch doch mal!" ));
  AddDetail( ({"gutes"}), BS( "Nichts Gutes!" ));
  AddDetail( ({"osten"}), BS( "Jaja, im Osten wird der Wald dichter!" ));
  AddDetail( ({"westen"}), BS( "Im Westen liegt ein ausgetrampelter Pfad." ));

  AddSound( ({"geraeusche","geraeusch"}), BS( "Im Westen hoerst Du "
    "froehliches Gezwitscher und die uebliche Geraeuschkulisse eines "
    "Waldes, im Osten hoerst Du ... gar nichts?" ));
  AddSound( ({"gezwitscher","vogelgezwitscher"}), BS( "Im Westen: TSCHILP!!! FIEP!!!, im Osten: *stille*" ));

   AddSmell (DEFAULT_SMELL,
     "Hier riechts nach Wald, Baeumen, und etwas fremdem.");

  AddExit( "westen", LAMUERTEWALD("11y_28x") );
  AddExit( "nordosten", LAMUERTEWALD("12y_30x") );
  AddExit( "osten", ROOM("orkweg2") );

}

