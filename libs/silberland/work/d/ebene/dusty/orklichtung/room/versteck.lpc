// Dusty, August 2002

inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../def.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einem Versteck" );
  SetProp( P_INT_LONG, BS( 
   	"Du hast offensichtlich ein Versteck gefunden. Getarnt von Bueschen und Unterholz "
	"scheint hier jemand Zuflucht vor den Halborks gefunden zu haben. Allerdings "
	"liegt hier viel Unrat und Knochen herum, wahrscheinlich sind das alles Ueberreste, "
  "die man unauffaellig nach den Mahlzeiten der Halborks klauen kann." )); 
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST ]) );
  AddDetail( ({ "blicke" }), 
                break_string( "Siehst Du keine.", 78 ) );
  AddDetail( ({ "silberland" }), 
                break_string( "Du bist hier im Silberland, ja!", 78 ) );
  AddDetail( ({ "biologe" }), 
                break_string( "Hier im Silberland gibt es keinen Biologen.", 78 ) );
  AddDetail( ({ "lieblingsspeise" }), 
                break_string( "Schaut aus, als ob die Halborks hier Menschen "+
                "als Lieblingsspeise haben.", 78 ) );
  AddDetail( ({"versteck"}), BS( "Du stehst gerade in einem." ));
  AddDetail( ({"buesche", "unterholz"}), BS( "Gibt beides eine gute Tarnung vor neugierigen "
	"Blicken." ));
  AddDetail( ({"tarnung"}), BS( "Wenn man die Fussspuren draussen nicht bemerken wuerde, "
	"waere die Tarnung sogar perfekt." ));
  AddDetail( ({"fussspuren"}), BS( "Hier ist der ganze Boden voller Spuren. Aber nicht nur "
	"von Fuessen." ));
  AddDetail( ({"spuren"}), BS( "Spuren von Blut, Unrat, Knochen und allerhand anderem, was "
	"ich jetzt nicht genau beschreiben will." ));
  AddDetail( ({"blut", "blutspuren"}), BS( "Eingetrocknetes und noch nicht ganz geronnenes "
	"Blut ist hier zu sehen." ));
  AddDetail( ({"unrat", "unratsspuren"}), BS( "Allerhand Unrat, keine naeheren Beschreibung "
	"wert." ));
  AddDetail( ({"knochen", "knochenspuren"}), BS( "Knochen von Menschen oder Elfen, Zwergen, "
	"Tieren - und sogar Feenfluegel liegen hier herum!" ));
  AddDetail( ({"anderes", "beschreibung"}), BS( "Graust Dir denn vor garnichts?" ));
  AddDetail( ({"zuflucht"}), BS( "Hier hat offensichtlich jemand eine gefunden." ));
  AddDetail( ({"halbork", "halborks"}), BS( "Woodyseidank gerade keine da!" ));
  AddDetail( ({"menschen", "mensch", "menschenknochen"}), BS( "Menschen duerften die "
	"Lieblingsspeise der Halborks sein. Muss wohl was mit Blutrache zu tun haben." ));
  AddDetail( ({"elfen", "elf", "elfenknochen"}), BS( "Schmeckt scheinbar aehnlich wie "
	"Mensch." ));
  AddDetail( ({"zwerg", "zwerge", "zwergenknochen"}), BS( "Die Zwergenknochen sind kleiner, "
	"dafuer aber dicker als die der Menschen." ));
  AddDetail( ({"tiere", "tierknochen"}), BS( "Allerhand Tiere duerften hier entlanggekommen "
	"sein. Da Du aber kein Biologe bist, kennst Du die einzelnen Arten nicht auseinander." ));
 AddDetail( ({"arten"}), BS( "Auf jeden Fall waren es viele Arten." ));
 AddDetail( ({"fluegel", "feenfluegel"}), BS( "Ganz kaputte Feenfluegel liegen hier auch "
	"herum :-(" ));
 AddDetail( ({"ueberreste"}), BS( "Alles Ueberreste von den kannibalischen Mahlzeiten der "
	"Halborks." ));
 AddDetail( ({"mahlzeiten"}), BS( "Es scheint sehr oft Fleisch zu geben." ));
 AddDetail( ({"fleisch"}), BS( "Waehlerisch sind sie nicht, das steht fest!" ));
  AddDetail( ({"boden"}), 
    "Der Boden ist voller Knochen und Unrat.");
  AddDetail( ({"himmel"}), 
    "Den Himmel sieht man gar nicht, so zugewuchert ist es hier.");

  AddItem(NPC("menschenfrau"), REFRESH_DESTRUCT);

  AddExit( "westen", ROOM("lichtung2") );
}
