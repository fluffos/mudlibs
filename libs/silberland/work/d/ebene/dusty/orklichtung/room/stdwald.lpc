// Dusty, August 2002

inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../def.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Am Waldweg" );
  SetProp( P_INT_LONG,  
  "Du bist auf einem Weg im Tannenwald. Die maechtigen, dunklen Tannenbaeume "
  "stehen sehr eng zusammen und lassen sehr wenig Licht zum Boden durch"
  "dringen. Irgendwie kennst Du gemuetlichere Waldwege als diesen. Auch die "
  "absolute Stille in der Du "
  "Dich befindest, traegt nicht zu Deinem Wohlbefinden bei."); 
	
  SetProp( P_LIGHT, 1 );
    
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST ]) );

  AddDetail( ({"boden"}), 
    "Der Boden ist mit abgefallenen Tannennadeln bedeckt." );
  AddDetail( ({"nadeln", "tannennadeln"}), 
    "Sie daempfen jeden Deiner Schritte." );
  AddDetail( ({"himmel"}), 
    "Es ist keiner zu entdecken." );
  AddDetail( ({"befinden", "wohlbefinden"}), 
    "Es war schon mal besser." );
  AddDetail( ({"licht"}), 
    "Es kommt hier fast keines durch. Grad noch genug, "
  	"um hier etwas zu sehen." );
  AddDetail( ({"weg", "waldweg", "waldwege", "wege"}),  
    "Das sind Wege, die durch "
  	"Wald fuehren. Irgendwie ist dieser hier aber ungemuetlich." );
  AddDetail( ({"baum", "baeume", "wald", "tannenwald"}), 
	 	"Der Wald ist undurchdringlich und dicht, es gibt hier ausser am "
	  "Weg nirgends ein Durchkommen." );
  AddDetail( ({"tannenbaum", "tannenbaeume", "tanne", "tannen"}), 
  	"Die Tannenbaeume ragen hoch und finster neben Dir auf. " );
  AddDetail( ({"geaest", "aeste", "ast"}), 
  	"Die Aeste tragen massenhaft Tannennadeln. Viele andere Tannennadeln "
  	"sind bereits auf den Boden gefallen." );
  AddDetail( ({"haare"}), 
  	"Deine Haare stehen Dir zu Berge. " );
  
  AddSmell (DEFAULT_SMELL,
     "Hier riechts nach Wald, Baeumen, und etwas fremdem.");
  AddSmell( ({"fremdes"}), BS( "Die Haare stellen sich Dir ein wenig auf." ));
  AddSmell( ({"wald"}), BS( "Der Wald riecht gut. Vor allem nach Baeumen." ));
  AddSmell( ({"baeume", "baum"}), BS( "Schon ein paar Baeume riechen nach "
    "Wald." ));
  AddSound (DEFAULT_SOUND,
     "Stille. Nicht mal Vogelgezwitscher!");
  AddSound( ({"geraeusche","geraeusch"}), 
    "Irgendwie ist hier nicht mal Vogelgezwitscher zu hoeren." );
  AddSound( ({"stille"}), 
    "Stille ist still, sehr still..." );
  AddSound( ({"schritte"}), 
    "Sie werden durch die Tannennadeln gedaempft." );
 
  AddSound( ({"gezwitscher","vogelgezwitscher"}), BS( "Nix zu hoeren!" ));
}