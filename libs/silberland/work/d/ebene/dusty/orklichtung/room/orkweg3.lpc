// Dusty, August 2002

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../def.h"

inherit ROOM("stdwald.lpc");

create()
{
  "stdwald"::create();
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG)+BS(
     "Im Osten duerfte der Wald ploetzlich aufhoeren. Es schimmert sandgelb "
     "durchs Geaest. "
     "Im Sueden kannst Du undeutliche Schemen von Personen erkennen.")); 

  AddDetail( ({"personen", "sueden", "schemen"}), 
    "Du bist Dir nicht ganz sicher, ob Du Dich nicht "
  	"getaeuscht hast. Es waere aber sicher gut, vorsichtig zu sein." );
  AddDetail( ({"sandgelb", "gelb", "schimmer", "schimmern"}), 
    "Sandgelb schimmert es durchs Geaest. Was da wohl im Osten sein mag? ");
  AddDetail( ({"geaest", "aeste", "osten"}), 
    "Das Geaest behindert zwar den Blick nach Osten, trotzdem kannst Du "
    "erkennen, dass dahinter etwas sein muss.");

  AddCmd("sei",  "vorsichtig");


  AddExit( "sueden", ROOM("orkweg4") );
  AddExit( "westen", ROOM("orkweg2") );
  AddExit( "osten", LAMUERTEWALD("11y_29x") );

}

int vorsichtig(string str)
{
  if (str=="vorsichtig")
  {
    write("Jaja, ich pass schon auf. Immer diese Belehrungen...\n");
    return 1;
  }
  else
    return 0;
}
