// Dusty, August 2002


#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../def.h"

inherit ROOM("stdwald.lpc");

create()

{
  
  ::create();
  SetProp( P_INT_LONG, QueryProp(P_INT_LONG)+
     BS("Im Sueden ist eine Lichtung.")); 

  AddDetail( ({"lichtung"}), BS( "Im Sueden ist eine mittelgrosse Lichtung." ));

  AddExit( "norden", ROOM("orkweg3") );
  AddExit( "suedwesten", ROOM("lichtung4") );
  AddExit( "sueden", ROOM("lichtung1") );

AddSmell (DEFAULT_SMELL,
    bs("Hier riechts nach Wald und Orks, aber auch Menschen."));
 AddSmell( ({ "ork", "orks" }), BS( "Riecht irgendwie wie nach 2 Monaten nicht "
	"mehr gewaschen." ));
 AddSmell( ({ "wald"}), BS( "Waldgerueche riechen hauptsaechlich nach Baeumen." ));
 AddSmell( ({ "menschen" }), BS( "Hm. Komisch, irgendwie nicht zuordenbar." ));



 AddItem(NPC("waechter"), REFRESH_DESTRUCT);
 AddItem(NPC("krach"), REFRESH_DESTRUCT);

}