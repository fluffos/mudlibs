    ""
    ""
    ""
    "" )); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
//  AddSound( ({""}), BS( "" ));
//  AddSmell( ({""}), BS( "" ));

  
  AddExit( "westen", ROOM("lichtung2") );
}