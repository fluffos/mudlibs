#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../def.h"

inherit ROOM("stdwald.lpc");

create()
{
  "stdwald"::create();

  SetProp( P_INT_LONG, QueryProp(P_INT_LONG)); 

  AddExit( "westen", ROOM("orkweg1") );
  AddExit( "osten", ROOM("orkweg3") );
}