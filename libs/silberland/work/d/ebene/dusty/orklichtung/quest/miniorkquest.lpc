inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../def.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({ "\questobj", "miniorkquest"}));
  SetProp (P_NAME, "miniorkquest");
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_NODROP, 1);
}
