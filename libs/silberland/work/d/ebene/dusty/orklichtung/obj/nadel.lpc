// Dusty@SilberLand
// Eine Piekse-Nadel
// August 2002

inherit "std/thing";

#include <properties.h>
#include <weapon.h>
#include <moving.h>
#include "../def.h"

int abnutzung;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  abnutzung=3;

  SetProp (P_SHORT, "Eine lange Tannennadel");
  SetProp (P_LONG,
          "Eine lange Tannennadel. Damit kann sicher total gut Leute pieksen. "
          "Die bricht aber sicher auch irgendwann ab, weil sie leider sehr "
          "duenn ist.");
  SetProp (P_NAME, "Tannennadel");
  SetProp (P_GENDER, FEMALE);
  AddId ( ({"tannennadel", "nadel", "\ndustynadel"}) );
  SetProp (P_VALUE, 2);
  SetProp (P_WEIGHT, 20);
  SetProp (P_MATERIAL, MAT_PLANT); // (was is a pflanze)

  
  AddCmd( ({"piekse", "pieks", "stich", "steche"}), "stich");

}

int stich (string str)
{
  object opfer;
  notify_fail("Wen willst Du pieksen?\n");
  
  opfer=find_player(str);
  if( objectp(opfer) && (ENV(opfer)==ENV(TP)))
  { 
    if (opfer ==TP)
    {
      notify_fail("Du willst Dich selber pieksen? Nein, so spielt's das "
                  "nicht!\n");
      return 0;
    }
    
    if (ENV(TO) != TP)
    {
      notify_fail("Heb doch die Nadel erstmal auf!\n");
      return 0;
    }
        
    write("Du piekst "+opfer->name(WEN)+" mit Deiner Tannennadel. Hehe.\n");
    say(BS(TP->Name() +" piekst "+opfer->name(WEN)+" mit einer Tannennadel "
        "und grinst fies dabei."),({opfer, TP}) );
    tell_object(opfer, BS( "AUA! "+
       TP->Name()+" piekst Dich in den Hintern und findet das sehr lustig."));
	  opfer->reduce_hit_point(3+random(3));
	  
	  if (!--abnutzung)
	  {
	    write("Du stichst in Deinem Sadismus viel zu fest zu und die Nadel "
	          "bricht ab.\n");
	    TO->remove();
	  }
	  
		return 1;
  }
  else 
    return 0; 
    
  
}
