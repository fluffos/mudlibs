// Dusty@SilberLand
// Ein Knochen
// August 2002

// Properties:
// P_FOOD_INFO : mapping
// ([ F_HEAL:mixed,       Heilung, int (LP+SP) oder array ({LP, SP})
//    F_SOAK:int,         Saettigung
//    F_DRINK:int,        Trink-Saettigung
//    F_ALCOHOL:int,      Alkoholgehalt
//    F_POISON:int,       Giftgehalt
//    F_MSG:string,       Text beim Essen/Trinken fuer den Spieler
//    F_MSG_ROOM:string,  Text beim Essen/Trinken fuer den Raum
//                        (Spielername+" " wird automatisch vorangestellt)
//    F_VERB:string ])    Verb (wird bei der Fehlermeldung benoetigt);
//                        Default ist "essen" (Verb in Nennform!!)
//
// (F_HEAL und F_POISON wird NACH 'BeimEssen' gesetzt, F_SOAK und
// F_ALCOHOL davor, um abzutesten, ob der Spieler das noch essen kann)
//
// Funktionen:
//
// void BeimEssen(object pl);
//   Wird in der 'Essfunktion' aufgerufen. Das Nahrungsobjekt wird
//   anschliessend zerstoert, wenn die Funktion second_life() nicht
//   existiert oder 0 zurueckliefert.
//
// int second_life(object pl);
//   Wenn diese Funktion einen Wert ungleich 0 zurueckgibt, so hat
//   das Objekt ein "zweites Leben" und wird nicht destructed nach
//   der Konsumierung. Hier koennte man auch das Clonen leerer
//   Flaschen, Obstkerne, etc. implementieren.
//


inherit "std/food";

#include <properties.h>
#include <weapon.h>
#include <moving.h>
#include <food.h>
#include "../def.h"

int abnutzung;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  abnutzung=3;

  SetProp (P_SHORT, "Ein elfischer Oberschenkelknochen");
  SetProp (P_LONG,
          "Ein elfischer Oberschenkelknochen. Es haengen noch Fleischreste "
          "dran. Ziemlich ungustioes. Da sind auch kleine Loecher in dem "
          "Knochen drin.");
  SetProp (P_NAME, "Oberschenkelknochen");
  SetProp (P_GENDER, MALE);
  AddId ( ({"knochen", "oberschenkelknochen", "oberschenkel", "\ndustyknochen"}) );
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 20);
  SetProp (P_MATERIAL, MAT_BONE);
  SetProp(P_FOOD_INFO,
   ([ F_HEAL:0,       //Heilung, int (LP+SP) oder array ({LP, SP})
      F_SOAK:0,         //Saettigung
      F_DRINK:0,        //Trink-Saettigung
      F_ALCOHOL:0,      //Alkoholgehalt
      F_POISON:0,       //Giftgehalt
      F_VERB:"essen" ]) );    //Verb (wird bei der Fehlermeldung benoetigt);
  
  
  
  AddDetail( ({"fleischreste", "reste"}), BS( "Verschimmelte Fleischreste. "
    "*yuck*" ));
  AddDetail( ({"loecher", "loch"}), BS( "Die muessen wohl Orkzaehne "
    "verursacht haben." ));
  AddDetail( ({"zaehne", "orkzaehne"}), BS( "Tatsaechlich! Da haengt doch "
    "wirklich noch ein Zahn drin - ob der von einem Viertelork oder von "
    "einem Halbork kommt kannst Du zwar nicht sagen, aber schoen schaut er "
    "nicht aus." ));
  AddDetail( ({"zahn"}), BS( "Du versuchst den Zahn aus dem Knochen zu ziehen, "
    "er sitzt aber zu fest drin." ));

}

  
void BeimEssen(object pl)
{
  if (pl->QueryProp(P_RACE)=="Oger")
  {
    write("Hmm! Knochen! Gut! Mampf! Essen!\n"+
          "Du frisst den Knochen auf einen Sitz zusammen. *KNURPS*\n");
    tell_room(ENV(pl),
       pl->Name()+" frisst einen Knochen auf einen Sitz zusammen. *KNURPS*\n",
       ({pl}) );
  }
  else
    write("Nein, das wuerdest nicht mal Du mehr essen wollen.\n");

  ::BeimEssen(pl);
}


int second_life(object pl)
{
  if (pl->QueryProp(P_RACE)=="Oger")
    return 0;
  else
    return 1;
}
