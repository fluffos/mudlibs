inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <exploration.h>

#include "../def.h"

object retter;
int triggered;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  
  triggered=0;
  
  AddId (({ "\ndummyobj" }));
  SetProp (P_SHORT, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
  
  AddCmd("","trigger",1);
  
}

set_retter(object ob) { retter=ob; }

trigger()
{
  if(objectp(retter) && TP==retter && !triggered)
  {
    triggered=1;
    // DB("Debug teilt Dir mit: "+retter->Name()+" kriegt einen Retter-FP!");
    EPMASTER->GiveExplorationPoint("rettemenschenfrau", EP_MISC);
  }
  call_out("remove",0);
}

