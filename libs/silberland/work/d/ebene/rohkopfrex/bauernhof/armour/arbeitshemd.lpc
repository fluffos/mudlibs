#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>


void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Arbeitshemd");
  SetProp(P_LONG,
    "Das Arbeitshemd traegt man normalerweise nur zum Arbeiten, weshalb "+
    "es nichts ausmacht wenn es ein bisschen dreckig wird. Dieses hier "+
    "ist jedoch schon so dreckig, dass man seine richtige Farbe nicht "+
    "mehr erkennen kann.");
  SetProp(P_NAME, "Arbeitshemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", "arbeitshemd"}) );

  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_CLOTH);

}


