#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Schuerze");
  SetProp(P_LONG,
    "So eine Schuerze haben oft Koeche an, wenn sie vorm Herd stehen "+
    "und ein koestliches Essen zubereiten.");
  SetProp(P_NAME, "Schuerze");
  SetProp(P_GENDER, FEMALE);
  AddId("schuerze");

  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 250);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_CLOTH);

}


