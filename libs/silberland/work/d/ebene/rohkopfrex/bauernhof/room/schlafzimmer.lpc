#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <verben.h>

int luft;
string geruch(string str);

create() {

  ::create();

  SetProp(P_INT_SHORT, "Das Schlafzimmer");
  SetProp(P_INT_LONG,
    "Das Schlafzimmer ist zum Schlafen da. Drum stehen hier wohl auch diese "
    "zwei Betten, die aber gar nicht gemuetlich ausschauen. Nur die dicken "
    "Bettdecken sind richtig wuschelig und kuschelig, da wird den Bauersleut' "
    "auch im tiefsten Winter nicht kalt werden."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));

  AddDetail( ({"schlafzimmer","zimmer"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"wand", "waende"}),
    "Das Schlafzimmer hat ganz normale Waende mit zwei Fenstern drin."
  );

  AddDetail( ({"fenster"}) ,
    "In der westlichen und in der oestlichen Wand ist jeweils ein Fenster. "
    "Leider kannst Du nicht hinausschauen, weil die Vorhaenge zugezogen "
    "sind, das duerfte auch der Grund sein, dass es hier ein bisschen "
    "kuehler ist als im uebrigen Bauernhof. Aber trotzdem ist es hier "
    "nicht ganz finster, sondern nur ein ganz klein bisschen dunkel."
  );

  AddDetail( ({"vorhang", "vorhaenge"}),
    "Die Vorhaenge haengen vor den Fenstern, darum kannst Du auch nicht "
    "hinausschauen. Sie sind mit schoenen Blumenmustern verziert."
  );

  AddDetail( ({"muster", "blumenmuster"}),
    "Die Vorhaenge sind mit einem einfachen aber schoenen Blumenmuster "
    "verziert."
  );

  AddDetail( ({"bett", "betten"}),
    "Diese zwei Betten schauen ueberhaupt nicht bequem aus. Sie sind kurz "
    "und schmal und haben eine ganz harte Matratze. Auch die Polster sind "
    "ganz hart. Nur die Bettdecken, die auf jedem Bett liegen, sind richtig "
    "weich und kuschelig, wenn die nicht waeren, koennten sich die Bauern "
    "genausogut einfach auf den kalten Boden legen um zu schlafen."
  );

  AddDetail( ({"unter bett", "unter betten"}),
    "Du schaust, was Du unterm Bett so findest. Aber ausser ein wenig Staub "
    "ist dort eigentlich nichts zu sehen."
  );

  AddDetail( ({"staub"}) ,
    "Unter den Betten liegt allerhand Staub. Aber der interessiert Dich "
    "herzlich wenig."
  );

  AddDetail( ({"matratze", "matratzen"}),
    "Diese Matratzen duerfen recht unbequem sein. Sie sind hart und "
    "haben vom vielen draufliegen schon eine tiefe Mulde in der Mitte."
  );

  AddDetail( ({"mitte"}) ,
    "In der Mitte der Matratzen befindet sich je eine Mulde. Die "
    "Matratzen sind wohl schon ziemlich alt. "
  );

  AddDetail( ({"mulde","mulden"}) ,
    "Die Matratzen sind schon ganz schoen ausgelegen. Die linke Mulde "
    "ist etwas tiefer als die rechte. Hier schlaeft wohl Sophie, die koennte "
    "ruhig mal etwas abnehmen. "
  );

  AddDetail( ({"polster"}) ,
    "Das sind kleine ganz harte Polster."
  );

  AddDetail( ({"decken", "bettdecke", "bettdecken"}),
    "Auf jedem der zwei Betten liegt eine dicke wuschelige Bettdecke. In "
    "die willst Du Dich am liebsten gleich einkuscheln und nie wieder "
    "hervorkommen, so gemuetlich schauen sie aus."
  );

  AddDetail( ({"decke"}) ,
    "Die Decke ist ueber Dir, Du schaust hinauf und erkennst aber nichts "
    "Besonderes daran."
  );

  AddDetail( ({"boden"}) ,
    "Zum Glueck stehen Betten auf dem Boden, denn der schaut wirklich "
    "zu hart aus, um darauf zu schlafen."
  );

  AddSmell(DEFAULT_SMELL, #'geruch );

  AddSound(DEFAULT_SOUND,
    "Im Schlafzimmer ist es ganz schoen leise, das ist gut, wenn man schlafen "
    "will."
  );

  AddCmd( ({"luefte","lueft"})+CMD_OEFFNEN, "cmd_lueften");

  AddExit("norden", ROOM "esszimmer" );

  luft = 0;
}

void reset()
{
  ::reset();
  luft = 0;
}

string geruch(string str)
{
  string s;

  if(luft)
  {
    s = "Es riecht frisch, vermutlich wurde vor kuzem gelueftet.";
  }
  else
  {
    s = "Hier riechts ein bisschen abgestanden, vielleicht sollte einmal "
        "gelueftet werden.";
  }
  return BS(s);
}

int cmd_lueften(string str)
{
  notify_fail("Willst Du lueften beziehngsweise die Fenster oeffnen ?\n");

  if(!(str == "" || str == "fenster"))
  {
    return 0;
  }

  if(luft)
  {
    TELLPLAYER(BS("Obwohl vor kurzem erst gelueftet wurde, reisst Du "
                  "die Fenster nochmal auf und laesst die gute "
                  "Landluft herein."));
  }
  else
  {
    TELLPLAYER(BS("Hier ist ja wirklich ein ziemlicher Mief. Daher "
                  "oeffnest Du die Fenster und lueftest mal so richtig "
                  "durch."));
  }

  TELLOTHERS(TPN+" reisst die Fenster auf und lueftet mal so richtig durch.\n");
  WRITELOG(TPUID+" lueftet das Schlafzimmer");
  luft = 1;
  return 1;
}
