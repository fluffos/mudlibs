#include "../def.h"

inherit ROOM "blumenraum_inh";

#include <properties.h>
#include <language.h>

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Auf einer Wiese");
  SetProp(P_INT_LONG,
    "Du stehst auf einer Strasse, die nach Norden zu einem Bauernhof fuehrt "
    "und sich nach Sueden noch etwas weiter zwischen den Wiesen "
    "dahinschlaengelt. Links und rechts von Dir sind die wunderschoensten "
    "gruenen Wiesen, auf denen viele praechtige Blumen wachsen. "
    "Im Westen kannst du einen alten Heustadl betreten."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));

  AddDetail( ({"boden"}) ,
    "Du stehst auf einer Strasse, die zwischen wunderschoenen Wiesen "
    "verlaeuft. Du schaust noch etwas laenger auf den Boden, aber das "
    "wird dir bald zu langweilig. Vielleicht kannst Du hier auch Dinge "
    "untersuchen, die etwas betrachtenswerter sind als der Boden."
  );

  AddDetail( ({"strasse", "schotterstrasse", "weg"}),
    "Du stehst auf der Strasse. In der Mitte davon wuchert schon etliches "
    "Unkraut, was daran liegen koennte, dass alle Leute und Fabelwesen, "
    "die diesen Weg benuetzen, entweder auf der linken oder auf der "
    "rechten Seite gehen, aber nie in der Mitte."
  );

  AddDetail( ({"seite"}) ,
    "Du schaust auf die rechte Seite und siehst eine schoene "
    "Blumenwiese. Dein Blick wandert ganz langsam immer weiter nach "
    "links und Du siehst als naechstes die rechte Seite der Strasse. "
    "Dann schaust Du genau auf die Strasse. Dein Blick schwenkt weiter "
    "und Du siehst die linke Seite der Strasse. Und gleich darauf "
    "die praechtige Blumenwiese auf der linken Seite, die der Wiese "
    "rechts so aehnelt, wie ein Ei dem anderen."
  );

  AddDetail( ({"himmel"}) ,
    "Der Himmel ist ganz schoen weit oben. Vielleicht, wenn Du einmal "
    "Zeit dazu hast, steigst Du auf den groessten Berg, den Du im "
    "Silberland finden kannst, und untersuchst ihn etwas "
    "genauer. Aber von hier herunten geht das nicht so gut."
  );

  AddDetail( ({"wiese", "wiesen", "blumenwiese", "blumenwiesen"}) ,
    "Auf jeder Seite der Strasse erstrecken sich wunderschoene Wiesen. "
    "Du bist ueberwaeltigt von der Blumenpracht, die darauf waechst."
  );

  AddDetail( ({"blume", "blumen"}),
    "Eins, zwei, drei, vier, .... Naja, ist vielleicht keine so "
    "gute Idee, alle Blumen zu zaehlen. Du schaust sie Dir besser in "
    "ihrer Gesamtheit an. Das ist doch ueberwaeltigend."
  );

  AddDetail( ({"bauernhof"}) ,
    "Du kannst ihn mehr erahnen als sehen, so weit ist der Bauernhof "
    "entfernt. Wenn Du ihn so richtig genau untersuchen willst, musst "
    "Du noch ein grosses Stueckchen weiter nach Norden gehen."
  );

  AddDetail( ({"stadl", "heustadl"}),
    "Der Heustadl steht westlich von Dir. Er ist anscheinend nur aus "
    "Holz gebaut worden, das jetzt schon alt und verwittert ausschaut. "
    "Was aber nicht bedeutet, dass der Stadl schon baufaellig ist, der "
    "wirkt zwar nicht mehr wie ein Neubau, wird aber trotzdem zur "
    "Erntezeit noch seinen Sinn erfuellen, und das ganze Heu "
    "den Winter ueber schoen trocken halten."
  );

  AddDetail( ({"holz"}) ,
    "Der Heustadl besteht aus Holz. Es schaut aus, als ob das Holz schon "
    "ziemlich alt und verwittert ist, aber genau wirst Du das erst "
    "feststellen koennen, wenn Du naeher dran bist."
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Du kannst nach Westen gehen und den Heustadl betreten, oder nach Norden "
    "und dem Bauernhof etwas naeher kommen, oder nach Sueden und auf der "
    "Strasse noch etwas weiterwandern."
  );

  AddDetail( ({"unkraut"}) ,
    "In der Mitte der Strasse wachsen viele Pflanzen, die Leute, die das "
    "stoert nennen sie Unkraut, die anderen einfach nur Gras. Und ein "
    "paar wenige Pflanzenkundler werden die richtigen Namen dafuer kennen "
    "und diese Pflanzen dann so nennen."
  );

  AddDetail( ({"pflanze", "pflanzen"}),
    "Du stehst hier zwischen den wunderschoensten Wiesen und eine Wiese "
    "besteht aus Blumen und Graesern, und Blumen und Graeser sind Pflanzen."
  );

  AddDetail( ({"gras", "graeser"}) ,
    "Auf der Wiese waechst zwischen all den schoenen Blumen auch etwas "
    "gruenes Gras."
  );

  AddDetail( ({"pracht", "blumenpracht"}),
    "Die vielen praechtigen Blumen verschmelzen zu einer einzigen wahren "
    "Blumenpracht."
  );

  AddDetail( ({"gesamtheit"}) ,
    "Du versuchst, die Blumenpracht in ihrer Gesamtheit zu erfassen, "
    "schaffst es aber nicht. Dazu ist der sterbliche Geist einfach "
    "noch nicht in der Lage."
  );

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach gruenem Gras und bunten Blumen."
  );

  AddSmell( ({"gras"}) ,
    "Das Gras riecht so richtig saftig gruen."
  );

  AddSmell( ({ "blumen","blume","wiesenblume","wiesenblumen" }),
    "Die Blumen haben einen so angenehmen bunten Geruch, dass es Dir "
    "richtig leid tut, dass Du diese Luft wieder ausatmen musst."
  );

  AddSound( DEFAULT_SOUND,
    "Nur wenn Du ganz leise bist, kannst du den schwachen Wind "
    "ueber das Gras wehen hoeren."
  );

  AddExit("norden", ROOM "wiese1");
  AddExit("westen",  ROOM "stadl1");
  AddExit("sueden", STRASSE "strasse1");
}
