#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>

string sound(string str);

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Im Schweinestall");
  SetProp(P_INT_LONG,
    "Du stehst jetzt direkt in einer Box, in der sich sonst nur Schweine "
    "aufhalten. Gefaellts Dir hier? Nach Westen gehts jedenfalls wieder "
    "raus aus dieser Box."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:25]));

  AddDetail( ({"box", "schweinebox"}),
    "Du stehst jetzt in einer Schweinebox. Wahrscheinlich gibts im Silberland "
    "nicht sehr viele Lebewesen die sich hier gerne aufhalten, ausser den "
    "Schweinen und ... anscheinend Dir."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden ist zentimetertief mit stinkendem Dreck bedeckt und Du "
    "stehst mitten darin."
  );

  AddDetail( ({"wand", "waende"}),
    "Sogar die Waende sind ueber und ueber mit Dreck und Mist angespritzt."
  );

  AddDetail( ({"decke"}) ,
    "An der Decke ist so wenig Dreck, dass man sie fast als sauber "
    "bezeichnen koennte."
  );

  AddDetail( ({"silberland"}) ,
    "Du stehst in einer Schweinebox, "
    "die Box ist im Schweinestall, der Schweinestall im Bauernhof und der "
    "Bauernhof im Silberland."
  );

  AddDetail( ({"stall", "schweinestall"}),
    "Der Schweinestall ist der Ort, wo der Bauer seine Schweine haelt."
  );

  AddDetail( ({"bauernhof"}) ,
    "Der Bauernhof gehoert den Bauern, sie zuechten hier Schweine, Kuehe "
    "und Huehner."
  );

  AddDetail( ({"dreck"}) ,
    "Hier im Schweinestall gibt es jede Menge Dreck und Mist, ohne dem "
    "wuerde es den Schweinen nicht gefallen."
  );

  AddDetail( ({"mist"}) ,
    "Der ganze Dreck, der hier ueberall herumliegt, besteht zum groessten "
    "Teil aus Mist, den die Schweine selbst produzieren."
  );

  AddSpecialDetail( ({"schweine","tiere"}) , "detail_tiere" );

  AddSmell( DEFAULT_SMELL,
    "Hier kannst Du keinen anderen Geruch wahrnehmen, ausser diesem "
    "ungeheuerlich unangenehmen Gestank."
  );

  AddSmell( ({"mist", "dreck"}),
    "Der groesste Teil des Gestankes geht von dem ganzen Dreck und Mist aus, "
    "der hier auf dem Boden herumliegt."
  );

  AddSmell( ({"gestank" }),
    "WUUAAEE! Ist das grauslich! Es waere bestimmt gesuender, wenn Du das "
    "nicht recht oft machst.");

  AddSound( ({DEFAULT_SOUND, "schwein", "schweine", "grunzen", "gegrunze"}) , #'sound );

  AddRoomMessage( ({
    "Hier stinkts.\n",
    "Hier riechts unangenehm.\n"}), 45 );

  AddItem(NPC "schwein", REFRESH_DESTRUCT);
  AddItem(NPC "schwein", REFRESH_DESTRUCT);
  AddItem(NPC "schwein", REFRESH_DESTRUCT);

  AddExit("westen", ROOM "s_stall1" );
}

string sound(string str)
{
  string s;
  object room;

  if(!present("schwein",TO))
  {
    return "Es ist absolut still hier.\n";
  }

  switch(str)
  {
    case DEFAULT_SOUND:
      s = "Nur ein paar Schweine kannst Du grunzen hoeren.";
      break;

    case "schwein":
    case "schweine":
      s = "Die Schweine grunzen ganz schoen laut.";
      break;

    case "grunzen":
    case "gegrunze":
      s = "Oink, Oink, Oink!";
      break;
  }
  return BS(s);
}

string detail_tiere(string str)
{
  int schweine;
  int katzen;
  int gesamt;
  string s;

  schweine  = sizeof(filter_objects(all_inventory(TO), "id", "schwein"));
  if(str == "tiere")
  {
    katzen = (present("katze",TO)) ? 1 : 0; //bei tiere katze mitzaehlen
  }
  else
  {
    katzen = 0; // sonst nicht
  }
  gesamt = schweine + katzen;

  if(!gesamt) return "Es befinden sich keine Tiere im Schweinestall.\n";

  s = (gesamt == 1) ? "Es befindet sich " : "Es befinden sich ";

  switch(schweine)
  {
    case 0 :
      if(katzen ) s += " eine Katze";
      break;

    case 1 :
      s += "ein Schwein";
      if(katzen ) s += " und eine Katze";
      break;

    case 2 :
      s += "zwei Schweine";
      if(katzen ) s += " und eine Katze";
      break;

    default:
      s += "einige Schweine";
      if(katzen ) s += " und eine Katze";
      break;
  }

  s += " im Schweinestall.\n";

  return s;
}
