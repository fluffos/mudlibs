#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>

string sound(string str);

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Der Schweinestall");
  SetProp(P_INT_LONG,
    "Hier stinkts. Bei dem Gestank versagen Dir im ersten Moment alle "
    "Sinne. Zum Glueck bist Du nicht umgefallen, dann haettest Du "
    "sicher genauso gerochen wie der Stall hier. In den Boxen stehen "
    "und liegen einige Schweine, die sich hier sichtlich wohl fuehlen. "
    "Nach Westen kommst Du wieder in den Hof zurueck und nach Osten "
    "kannst Du direkt zu ein paar Schweinen in eine Box steigen, wenn "
    "Du das willst."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"hof"}) ,
    "Wenn Du nach Westen gehst, kommst Du in den Hof, dann kannst Du "
    "ihn genauer untersuchen."
  );

  AddDetail( ({"stall", "schweinestall"}),
    "Du bist gerade im Schweinestall. Hier ist es dreckig und es stinkt. "
    "Neben Dir sind Boxen in denen einige Schweine stehen und liegen."
  );

  AddDetail( ({"box", "boxen", "schweinebox", "schweineboxen"}),
    "Damit die Schweine nicht frei im Stall herumlaufen, sind sie "
    "in einigen Boxen eingesperrt. Nach Osten kannst Du in eine "
    "hineingehen."
  );

  AddDetail( ({"schwein", "schweine"}),
    "Die Schweine sind in Boxen eingesperrt. Dort waelzen sie sich am "
    "liebsten in ihrem eigenen Dreck."
  );

  AddDetail( ({"dreck", "mist"}),
    "Am Boden liegt eine Menge Dreck und Mist. Die Bauersleut haben "
    "es wahrscheinlich schon aufgegeben, hier ordentlich sauber zu machen."
  );

  AddDetail( ({"boden"}) ,
    "Es liegt so viel Dreck und Mist herum, dass Du dazwischen den Boden "
    "nicht sehen kannst. Wahrscheinlich gaebe es dort auch nichts Wichtiges "
    "zu sehen."
  );

  AddDetail( ({"wand", "waende"}),
    "Die Schweine haben hier schon so eine Sauerei gemacht, dass sogar die "
    "Waende von oben bis unten mit Dreck bespritzt sind."
  );

  AddDetail( ({"decke"}) ,
    "Die Decke ist noch der sauberste Platz hier im Schweinestall, aber "
    "dort kommst Du sowieso nicht hin und ausserdem so richtig sauber ist "
    "sie eh auch nicht."
  );

  AddDetail( ({"hof"}) ,
    "In den Hof gelangst Du, wenn Du nach Westen gehst."
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Es gibt zwei Ausgaenge: Der eine nach Westen bringt Dich in den Hof und "
    "der andere nach Osten in eine Schweinebox."
  );

  AddSmell( DEFAULT_SMELL,
    "Hier stinkts einfach fuerchterlich."
  );

  AddSound( ({DEFAULT_SOUND, "schwein", "schweine","grunzen","gegrunze"}) , #'sound );

  AddRoomMessage( ({"Hier stinkts.\n"}), 30);

  AddExit("westen", ROOM "hof1" );
  AddExit("osten",  ROOM "s_stall2" );
}

string sound(string str)
{
  string s;
  object room;

  call_other(ROOM "s_stall2.lpc", "???"); //raum laden
  room = find_object(ROOM "s_stall2.lpc");

  if(!present("schwein",room))
  {
    return "In der Schweinebox im Osten ist es absolut still.\n";
  }

  switch(str)
  {
    case DEFAULT_SOUND:
      s = "In der Schweinebox im Osten hoerst Du ein paar Schweine grunzen.";
      break;

    case "schwein":
    case "schweine":
      s = "Du horchst den Schweinen beim Grunzen zu. Aber weil Du kein "
          "Schweinisch verstehst, weisst Du nicht was sie sagen.";
      break;

    case "grunzen":
    case "gegrunze":
      s = "Oink, Oink, Oink!";
      break;
  }
  return BS(s);
}

