#include "../def.h"

inherit ROOM "blumenraum_inh";

#include <properties.h>
#include <language.h>

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Auf einer laendlichen Strasse");
  SetProp(P_INT_LONG,
    "Du stehst auf einer Strasse, die sich nach Norden hin zwischen "
    "wunderschoenen Wiesen dahinschlaengelt und im Sueden in einer "
    "Kreuzung mit einem breiten Weg muendet. Auf beiden Seiten der Strasse "
    "sind praechtige gruene Wiesen, auf denen herrliche Blumen wachsen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD, ENV_TEMPERATURE:20]));

  AddDetail( ({"boden"}),
    "Du stehst mit beiden Fuessen fest auf einer laendlichen Strasse."
  );

  AddDetail( ({"strasse"}),
    "Diese Strasse, auf der Du gerade stehst, besteht aus richtig grobem "
    "Schotter. Sie wurde anscheinend in letzter Zeit nicht recht oft "
    "benutzt, denn es waechst schon allerhand Unkraut darauf."
  );

  AddDetail( ({"schotter"}) ,
    "Der Schotter, aus dem die Strasse zu einem grossen Teil besteht, ist "
    "so grob, dass die einzelnen Steine schon beinahe Felsen genannt "
    "werden koennten."
  );

  AddDetail( ({"stein", "steine"}) ,
    "Die Strasse besteht aus Schotter und der Schotter besteht aus Steinen."
  );

  AddDetail( ({"fels", "felsen"}),
    "Du kannst hier keine Felsen sehen, obwohl einige Steine wirklich "
    "ganz schoen gross sind."
  );

  AddDetail( ({"unkraut"}) ,
    "Wenn es mitten auf der Strasse waechst, nennst du es Unkraut, wuerde "
    "es irgendwo mitten auf der Wiese wachsen, wuerdest Du ihm gar keinen "
    "Namen geben, weil es Dir dann nicht aufgefallen waere. Jedenfalls "
    "nicht auf diesen Wiesen zwischen all den schoenen Blumen."
  );

  AddDetail( ({"himmel"}) ,
    "Der Himmel ist ganz weit ueber deinem Kopf. Ob dort oben wirklich die "+
    "Goetter wohnen?"
  );

  AddDetail( ({"sonne"}) ,
    "Ja, die ist noch da, sonst waers ja auch stockdunkel, nicht wahr?"
  );

  AddDetail( ({"gott", "goetter"}) ,
    "Da die Goetter allgegenwaertig sind (wie sie es jedenfalls selber "
    "behaupten), sind sie in jedem Ding rund um Dich herum, und auch "
    "in Dir. Untersuch also irgendetwas, und Du wirst Gott (oder einen "
    "Gott) untersuchen!"
  );

  AddDetail( ({ "wiese", "wiesen", "blumenwiese", "blumenwiesen" }),
    "Auf den Wiesen um Dich herum wachsen die wunderschoensten Blumen, "
    "die Du Dir vorstellen kannst."
  );

  AddDetail( ({ "blume", "blumen", "wiesenblume", "wiesenblumen" }),
    "Es sind zwar nur schlichte Wiesenblumen, aber trotzdem sind sie "
    "wunderschoen."
  );

  AddDetail( ({ "ausgang", "ausgaenge" }),
    "Es gibt zwei Ausgaenge: der noerdlich fuehrt Dich noch weiter "
    "die Strasse entlang und der suedlich zu einer Kreuzung mit einem "
    "breiten Weg."
  );

  AddDetail( ({"weg"}) ,
    "Im Sueden muendet die Strasse in einen breiten Weg."
  );

  AddDetail( ({"kreuzung"}),
    "Die Kreuzung kannst Du Dir im Sueden besser anschauen."
  );

  AddDetail( ({"gras"}) ,
    "Das gruenste Gras, das Du Dir vorstellen kannst."
  );

  AddDetail( ({"seite", "seiten"}),
    "Auf beiden Seiten der Strasse befinden sich wunderschoene Blumenwiesen."
  );

  AddSmell( DEFAULT_SMELL,
    "Der Geruch der schoenen Blumen liegt in der Luft."
  );

  AddSmell( ({"gras"}),
    "Wegen dem Duft der Blumen, kannst Du das Gras fast nicht riechen."
  );

  AddSmell( ({ "blume", "blumen" }),
    "Die Blumen duften herrlich!"
  );

  AddSound( DEFAULT_SOUND,
    "Hier ist es wunderbar ruhig.");

  AddExit("sueden", ANSCHLUSS);
  AddExit("norden", ROOM "wiese2.lpc");
}
