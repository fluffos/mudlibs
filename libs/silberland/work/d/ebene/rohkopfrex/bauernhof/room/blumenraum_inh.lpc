#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <moving.h>

int blumen;

void create() {

  ::create();

  AddDetail( ({"gras"}) ,
    "Das ist saftiges gruenes Gras."
  );

  AddCmd( ({"pflueck", "pfluecke"}), "cmd_pfluecken" );

  blumen=3;

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "exit_aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

int cmd_pfluecken(string str)
{
  object ob;

  notify_fail("Was willst Du denn pfluecken?\n");

  if(!str || str=="") return 0;
  if(!(str == "blume"     ||
       str == "blumen"    ||
       str=="wiesenblume" ||
       str=="wiesenblumen"))
  {
    return 0;
  }

  if(!blumen)
  {
    notify_fail(BS("Hier sind schon so viele Blumen ausgerissen worden, "
                   "dass Du Dir keine mehr zu nehmen traust."));
    return 0;
  }

  if (str=="blumen")
  {
    notify_fail(BS("Du willst gleich mehrere Blumen auf einmal pfluecken? Nimm "
                   "doch besser nur immer eine auf einmal!"));
    return 0;
  }

  blumen--;

  ob = clone_object(OBJ "wiesenblume");
  if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
  {
    TELLPLAYER(BS("Du pflueckst eine schoene Wiesenblume, doch selbst "
                  "diese kleine Wiesenblume ist zu schwer fuer "
                  "Dich, Du Schwaechling!\n"));
    TELLOTHERS(BS(TPN+" pflueckt sich eine schoene Wiesenblume, "
                  "mag sie dann aber anscheinen doch nicht haben "
                  "und wirft sie achtlos fort."));
    ob->move(TO,M_NOCHECK|M_SILENT);
    WRITELOG(TPUID+" pflueckt eine Blume und laesst sie fallen");
  }
  else
  {
    TELLPLAYER("Du pflueckst eine schoene Wiesenblume.\n");
    TELLOTHERS(TPN+" pflueckt eine schoene Wiesenblume.\n");
    WRITELOG(TPUID+" pflueckt eine Blume");
  }

  return 1;
}

reset() {
  ::reset();
  if(blumen > 3) return;
  blumen+=random(2);
}

