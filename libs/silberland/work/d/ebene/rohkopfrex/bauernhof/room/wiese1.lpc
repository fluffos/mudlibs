#include "../def.h"

inherit ROOM "blumenraum_inh";

#include <properties.h>
#include <language.h>

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Auf einer Wiese");
  SetProp(P_INT_LONG,
    "Du stehst jetzt auf einer Strasse die zwischen den schoensten Wiesen "
    "nach Norden zu einem Bauernhof fuehrt. Wenn Du nach Suedwesten schaust "
    "kannst Du in nicht so weiter Ferne noch einen Heustadl sehen, der "
    "sicher auch noch zum Bauernhof dazugehoert. Aus dem Osten hoerst Du "
    "ab und zu ein leises Wiehern."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));


  AddDetail( ({"norden"}) ,
    "Im Norden scheint der Bauernhof zu sein."
  );

  AddDetail( ({"Suedwesten"}) ,
    "Im Suedwesten kannst Du einen Heustadl erkennen."
  );

  AddDetail( ({"ferne"}) ,
    "Unweit kannst Du einen Heustadl im Suedwesten erkennen."
  );

  AddDetail( ({"boden"}) ,
    "Du stehst auf einer Schotterstrasse. Nach Sueden fuehrt sie Dich weiter "
    "durch diese schoenen gruenen Wiesen und nach Norden direkt zu einem "
    "Bauernhof."
  );

  AddDetail( ({"strasse", "schotterstrasse"}),
    "Diese Strasse besteht aus groben, grauen Schotter. Auf der "
    "Strassenmitte waechst schon so viel Gras, dass es beinahe so aussieht, "
    "als ob das hier keine Strasse ist, sondern zwei schmale Wege, die nur "
    "ganz zufaellig parallel zueinander verlaufen."
  );

  AddDetail( ({"weg","wege"}) ,
    "Es sind natuerlich keine zwei Wege, die hier paralell verlaufen, "
    "sondern eine Strasse, die in der Mitte schon wieder mit Gras "
    "zugewachsen ist. "
  );

  AddDetail( ({"mitte","strassenmitte"}) ,
    "Urspruenglich war die Strasse gaenzlich mit Schotter bedeckt, aber "
    "allmaehlich hat sich das Gras in der Mitte doch wieder durchgesetzt. "
  );

  AddDetail( ({"schotter"}) ,
    "Grober Sand wird oft auch als Schotter bezeichnet. Du kannst "
    "hier ganz viel davon sehen, weil die ganze Strasse, auf der Du "
    "gerade stehst daraus gemacht worden ist."
  );

  AddDetail( ({"wiese", "wiesen", "blumenwiese", "blumenwiesen"}) ,
    "Auf beiden Seiten der Strasse, befinden sich die schoensten "
    "Blumenwiesen, die Du seit langem gesehen hast."
  );

  AddDetail( ({"seiten","seite"}) ,
    "Links und rechts von der Strasse siehst Du saftige Blumenwiesen."
  );

  AddDetail( ({"gras","grases"}) ,
    "Die Wiesen, die sich an beiden Seiten der Strasse befinden, bestehen "
    "zu einem grossen Teil aus gruenem Gras, welches vor kurzem gemaeht "
    "wurde. Trotzdem finden sich einige Wiesenblumen dazwischen. "
  );

  AddDetail( ({"teil"}) ,
    "Der ueberwiegende Teil der Wiese besteht aus Gras, doch auch viele "
    "Wiesenblumen wachsen dazwischen. "
  );

  AddDetail( ({"sand"}) ,
    "Viele, viele kleine Steine zusammengenommen ergeben etwas, das "
    "Sand genannt wird. Sind diese Steine etwas groesser heisst der Sand "
    "dann Schotter und daraus kann man unter anderem eine Strasse machen, "
    "genau, wie die auf der Du gerade stehst."
  );

  AddDetail( ({"stein", "steine"}),
    "Die Strasse besteht aus vielen verschieden grossen Steinen."
  );

  AddDetail( ({"blume", "blumen","wiesenblume","wiesenblumen"}),
    "Auf den Blumenwiesen, links und rechts von der Strasse, wachsen "
    "unzaehlbar viele Blumen. Rote Blumen und blaue Blumen, grosse "
    "Blumen und kleine Blumen, gelbe Blumen und weisse Blumen, "
    "frische Blumen und duerre Blumen, Blumen, die Du kennst und Blumen, "
    "die Du noch nie zuvor gesehen hast. Es faellt Dir schwer Deinen "
    "Blick von dieser Pracht abzuwenden."
  );

  AddDetail( ({"blick"}) ,
    "Du wirfst noch einmal einen Blick auf die Blumen, erinnerst Dich aber "
    "dann doch daran, dass Du eigentlich etwas anderes vorhattest. Oder "
    "etwa nicht?"
  );

  AddDetail( ({"himmel"}) ,
    "Der Himmel ist ganz weit ueber Dir. Du stellst Dir vor, dass irgendwo "
    "dort oben die Goetter sitzen und auf Dich herabschauen und wuenscht Dir, "
    "dass sie Dir immer wohlgesonnen sein werden, und Dich auf all deinen "
    "Reisen durchs Silberland immer beschuetzen."
  );

  AddDetail( ({"goetter"}) ,
    "Die Goetter des Silberlandes heissen Dusty und Woody."
  );

  AddDetail( ({"dusty"}) ,
    "Dusty ist gerade nicht hier."
  );

  AddDetail( ({"woody"}) ,
    "Woody ist gerade nicht hier."
  );

  AddSpecialDetail( ({"reisen"}) , "detail_reisen" );

  AddDetail( ({"silberland","land"}) ,
    "Das Land, in dem Du Dich befindest, nennt man Silberland."
  );

  AddDetail( ({"bauernhof","bauernhoefen"}) ,
    "Am Besten Du gehst nach Norden, denn dort kannst Du Dir den "
    "Bauernhof noch viel besser anschauen."
  );

  AddDetail( ({"besten","beste"}) ,
    "Ja das wird das Beste sein, nach Norden zu gehen, wenn Du "
    "zum Bauernhof willst. "
  );

  AddDetail( ({"stadl", "heustadl"}),
    "Der Heustadl steht suedlich oder etwas genauer suedwestlich von "
    "deinem jetzigen Standort. Von dieser Entfernung kannst Du ihn "
    "nicht so gut sehen, vielleicht ist es besser, wenn Du ihn aus "
    "der Naehe betrachtest, falls Du den Weg dorthin findest."
  );

  AddDetail( ({"naehe","entfernung"}) ,
    "Du musst schon etwas naeher hingehen, um in die Naehe des Heustadls "
    "zu kommen. "
  );

  AddDetail( ({"standort"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Du kannst Dich hier zwischen zwei Ausgaengen entscheiden. Der noedliche "
    "wird Dich zum Bauernhof und der suedliche noch etwas weiter "
    "auf dieser Strasse entlang fuehren."
  );

  AddDetail( ({"pracht", "blumenpracht"}),
    "Die Gesamtheit all dieser praechtigen Blumen ergibt eine "
    "ueberwaeltigende Blumenpracht."
  );

  AddDetail( ({"gesamtheit"}) ,
    "Die Gesamtheit ist ueberwaeltigend. So viele Blumen wachsen auf der "
    "Wiese!"
  );

  AddSmell( DEFAULT_SMELL,
    "Du riechst den frischen Geruch des Grases und die Duefte all der Blumen "
    "die hier wachsen."
  );

  AddSmell( ({"geruch"}) ,
    "Hier ist noch nichts von der typischen \"Landluft\" zu riechen. "
  );

  AddSmell( ({"gras","grases"}) ,
    "Das Gras riecht herrlich frisch."
  );

  AddSmell( ({"blume", "blumen","wiesenblume","wiesenblumen","duft","duefte"}),
    "Weil Du Dich fuer keine einzelne Blume entscheiden kannst, an der Du "
    "riechen sollst, ziehst Du einfach eine ordentlich Portion Luft durch "
    "die Nase in deine Lunge und erfaehrst so den Duft aller Blumen "
    "auf einmal. Du bist ueberwaeltigt."
  );

  AddDetail( ({"luft","landluft"}) ,
    "Gemeinhin herrscht bei Bauernhoefen ja so die typische \"Landluft\" "
    "vor, doch hier auf der Wiese ist davon nichts zu riechen. Ganz im "
    "Gegenteil, die Luft hier ist richtig frisch und angenehm. "
  );

  AddDetail( ({"gegenteil"}) ,
    "Vom Geruch der typischen \"Landluft\" ist nichts zu riechen."
  );

  AddDetail( ({"geruch"}) ,
    "Riech ihn doch einfach mal!"
  );

  AddDetail( ({"lunge"}) ,
    "So eine Portion guter landluft tut deiner Lunge richtig gut."
  );

  AddDetail( ({"nase"}) ,
    "Lass Dich bloss nicht daran herumfuehren !"
  );

  AddDetail( ({"portion"}) ,
    "Du atmest mal so richtig eine riesige Portion dieser frischen Landluft "
    "ein. "
  );

  AddDetail( ({"pferd", "pferde"}),
    "Seher kannst Du kein Pferd, nur hoeren."
  );

  AddSound( ({DEFAULT_SOUND,"gerausch","geraeusche"}) ,
    "Du kannst schon einige Geraeusche des Bauernhofes wahrnehmen. Das "
    "Muhen von Kuehen, das Grunzen von Schweinen und auch das Gackern "
    "einiger Huehner."
  );

  AddSound( ({"schweine","schweinen","grunzen"}) ,
    "OINK !"
  );

  AddSound( ({"kuh","kuehe","kuehen","muh","muhen"}) ,
    "Mmmmmmmmmmmuuuuuuuuuuuuuuuuhhhhhhhhhhhhhh"
  );

  AddSound( ({"gackern","huhn","huehner"}) ,
    "Komisch, gerade jetzt wo Du ganz gnau hinhoerst ist nichts "
    "von den Huehnern zu hoeren. Man hat sie doch wohl nicht "
    "geschlachtet?"
  );

  AddSound( ({"wiehern", "pferd", "pferde" }),
    "Aus dem Osten hoerst Du ein Wiehern, wahrscheinlich befinden "
    "sich dort die Pferde des Bauernhofes."
  );

  AddItem("/d/ebene/Park/npc/schmetterling", REFRESH_DESTRUCT);

  AddExit("norden", ROOM "hof2");
  AddExit("sueden", ROOM "wiese2");
  AddExit("osten", ANSCHLUSS_RIDU);
}

string detail_reisen(string str)
{
  return BS(TP->Forschung());
}

