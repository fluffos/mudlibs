#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>

string rieche_heu(string s);

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Im Heustadl");
  SetProp(P_INT_LONG,
    "Jetzt stehst du in einem ganz typischen alten Heustadl. Recht viel "
    "Heu ist zwar gerade nicht herinnen, insbesondere hier beim Eingang. "
    "Gehst Du etwas weiter nach Westen, kannst Du Dir noch die letzten "
    "Heureste von der vorjaehrigen Ernte anschauen. Oder Du gehst nach "
    "Osten und verlaesst den Stadl wieder. Am Boden siehst Du eine "
    "offene Falltuere, durch die Du scheinbar in eine Art Keller gelangst."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"eingang"}) ,
    "Durch den Eingang gehen die meisten Leute in den Stadl herein. "
    "Und anscheinend haben sich die Erbauer des Stadls einen kleinen "
    "Witz erlaubt, denn der Eingang funktioniert in beide Richtungen, "
    "und so kann man damit den Stadl auch wieder verlassen."
  );

  AddDetail( ({"witz"}),
    "Du kannst Dich nicht entsinnen, jemals weniger gelacht zu haben."
  );

  AddDetail( ({"erbauer"}),
    "Hoechstwahrscheinlich war es Xaver selbst, der hier Hand anlegte."
  );

  AddDetail( ({"xaver","bauer"}),
    "Xaver ist der Bauer, dem der Bauernhof gehoert."
  );

  AddDetail( ({"bauernhof"}),
    "Auf dem befindest Du Dich derzeit."
  );

  AddDetail( ({"ernte"}),
    "Die Ernte fiel voriges Jahr wohl besonders ertragreich aus."
  );

  AddDetail( ({"heurest", "heureste", "rest", "reste"}),
    "Die letzten Heureste liegen im hinteren Teil des Stadls, um sie "
    "genauer zu untersuchen, musst Du zuerst dorthin gehen."
  );

  AddDetail( ({"wand", "waende"}),
    "Die Waende in diesem Teil des Stadls bestehen aus Holzbrettern, "
    "sie haben weder Fenster noch sonstige Besonderheiten."
  );

  AddDetail( ({"besonderheiten"}),
    "Du suchst sicher auch nach der Nadel im Heuhaufen, oder?"
  );

  AddDetail( ({"nadel","heuhaufen"}),
    "Da kannst Du hier lange suchen, schau lieber im hinteren Teil des Stadls."
  );

  AddDetail( ({"boden","holzboden"}) ,
    "Ein ganz gewohnlicher Holzboden auf dem noch ein wenig altes Heu "
    "herumliegt."
  );

  AddDetail( ({"brett", "bretter", "holzbrett", "holzbretter"}),
    "Fast der ganze Stadl besteht aus Holzbrettern. Der Boden, die "
    "Waende und wie sollte es anders sein auch die Decke. Alle Bretter sind "
    "recht alt und abgenuetzt, aber fuer so einen Stadl sind sie "
    "genau richtig."
  );

  AddDetail( ({"decke"}) ,
    "Ein paar lose Holzbretter, die auf den Dachpfosten liegen, bilden "+
    "die Decke."
  );

  AddDetail( ({"pfosten", "dachpfosten", "holzpfosten"}),
    "Der ganze Dachstuhl ist aus dicken Holzpfosten gebaut, auf denen "
    "auch ein paar Holzbretter liegen und somit den Boden eines ersten Stockes "
    "bilden."
  );

  AddDetail( ({"dachstuhl"}) ,
    "Du kannst von hier einen Grossteil des Dachstuhls sehen. Nur ein paar "
    "lose Bretter, die den Boden eines Dachgeschossen bilden, versperren Dir "
    "an einigen Stellen die Sicht."
  );

  AddDetail( ({"dachgeschoss", "ersten stock", "erster stock","stock"}),
    "Durch ein paar lose Bretter, die auf dicken Pfosten unter dem Dach "
    "liegen, wird so etwas wie ein erster Stock oder Dachgeschoss "
    "gebildet."
  );

  AddDetail( ({"dach","unterseite"}) ,
    "Wenn Du zwischen den Brettern, die hier eine Decke bilden nach oben "
    "schaust, siehst Du die Unterseite des Daches."
  );

  AddDetail( ({"heu"}) ,
    "Hier liegen nur einige wenige Reste Heu auf dem Boden. Wenn Du aber "
    "in den hinteren Teil des Stadls gehst, kannst Du noch einen, wenn "
    "auch kleinen, Heuhaufen betrachten."
  );

  AddDetail( ({"heuhaufen"}) ,
    "Ein kleiner Heuhaufen befindet sich im hinteren Teil des Stadls."
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Von hier aus kannst Du in zwei Richtungen weitergehen: Nach Osten "
    "aus dem Stadl heraus und nach Westen in den hintern Teil das Stadls."
  );

  AddDetail( ({"stadl", "heustadl"}),
    "Du stehst jetzt gerade in einem urigen alten Heustadl."
  );

  AddDetail( ({"maus", "maeuslein"}),
    "Du schaust Dich genau um, aber keine Maus weit und breit zu entdecken."
  );

  AddDetail( ({"fuesse"}),
    "Deine Fuesse waren auch schon mal sauberer!"
  );

  AddSmell( DEFAULT_SMELL,
    "Du kannst altes Heu riechen, hoffentlich hast Du keinen Heuschnupfen."
  );

  AddSmell( ({"heu"}), #'rieche_heu );

  AddSound( DEFAULT_SOUND,
    "Erst als Du ganz leise bist, hoerst Du ein leises Kratzen unter deinen "
    "Fuessen. Das ist wahrscheinlich nur ein kleines Maeuslein."
  );

  AddSound( ({"maus", "maeuslein", "mauschen"}) ,
    "Du lauschst ganz genau und kannst doch keine Maus mehr hoeren."
  );

  AddItem(NPC "katze", REFRESH_DESTRUCT);

  AddExit("osten", ROOM "wiese2");
  AddExit("westen",  ROOM "stadl2");

}

void niesen(object player)
{
  player->command_me("nies");
  return;
}

string rieche_heu(string str)
{
  call_out("niesen",0,TP);
  return "Du riechst an den paar Heuresten, die da am Boden liegen.\n";
}
