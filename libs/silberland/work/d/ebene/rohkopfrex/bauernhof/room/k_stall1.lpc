#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>

string sound(string str);

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Der Kuhstall");
  SetProp(P_INT_LONG,
    "Du bist jetzt im Kuhstall. Hier ist es nicht sehr spannend. Nur ein paar "+
    "Kuehe stehen hier herum, die gelangweilt ihr Heu fressen, und "+
    "die Kuehe die nichts fressen, kauen trotzdem. Sind diese Tiere so "+
    "dumm, dass sie nicht merken, wann sie fressen und wann nicht? "+
    "Nach Westen gehts wieder raus, eine kleine Leiter fuehrt hingegen "
    "weiter nach oben."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"stall", "kuhstall"}),
    "In einem Kuhstall werden von Bauern meistens Kuehe gehalten."
  );

  AddDetail( ({"bauer", "bauern"}),
    "Die Bauern bewirtschaften den Bauernhof."
  );

  AddDetail( ({"bauernhof"}),
    "Der Kuhstall ist Teil des Bauernhofs."
  );

  AddDetail( ({"holzleiter","leiter","kleine leiter"}),
    "Eine kleine wacklige Holzleiter, hoffentlich haelt sie Dich aus!"
  );

  AddDetail( ({"heu"}) ,
    "Das Heu ist das Futter fuer die Kuehe, die hier gehalten werden."
  );

  AddDetail( ({"futter"}),
    "Die Kuehe werden mit Heu gefuettert."
  );

  AddDetail( "ausgang",
    "Es gibt nur einen Ausgang, und zwar nach fuehrt der nach Westen aus "
    "dem Kuhstall heraus in den Hof hinein."
  );

  AddDetail( ({"boden", "steinboden"}),
    "Auf dem kalten Steinboden liegt noch ganz schoen viel Heu, das die "+
    "Kuehe noch nicht gefressen haben und auch etwas Mist (das ist "+
    "dann anscheinend das Heu, das sie schon gefressen haben)."
  );

  AddDetail( ({"mist"}) ,
    "Mit dem einem Ende koennen die Kuehe Heu fressen, das dann in Form "+
    "von Mist am anderen Ende wieder herauskommt. Der faellt dann auf den "+
    "Boden, wo Du ihn jetzt betrachten kannst. Der Mist ist braun und "+
    "stinkt."
  );

  AddDetail( ({"decke"}) ,
    "Eine langweilige graue Decke."
  );

  AddDetail( ({"wand", "waende"}),
    "Nicht einmal an den Waenden kannst du etwas Interessantes entdecken."
  );

  AddSmell(DEFAULT_SMELL,
    "Hier herinnen stinkts nach Kuehen."
  );

  AddSmell( ({"mist"}) ,
    "Der Mist stinkt."
  );

  AddSmell( ({"heu"}) ,
    "Auch das Heu hat schon den Geruch des Stalles angenommen."
  );

  AddSpecialDetail( ({"kuehe","tiere"}) , "detail_tiere" );

  AddSound( ({DEFAULT_SOUND, "kuh", "kuehe", "muh", "muhen"}) , #'sound );

  AddItem(NPC "kuh" , REFRESH_DESTRUCT);
  AddItem(NPC "kuh" , REFRESH_DESTRUCT);

  AddExit("westen", ROOM "hof2" );

}

string sound(string str)
{
  string s;
  object room;

  if(!present("kuh",TO))
  {
    return "Es ist absolut still hier.\n";
  }

  switch(str)
  {
    case DEFAULT_SOUND:
      s = "Du kannst den Kuehen beim Muhen zuhoeren.";
      break;

    case "kuh":
    case "kuehe":
      s = "Eine Kuh macht Muh.";
      break;

    case "muh":
    case "muhen":
      s = "Mmmmmmmmmmmmmmmmmmmmmuuuuuuuuuuuuuuuuuuuuuuuuuuhhhhhhhhhhhhhhhhh.";
      break;
  }
  return BS(s);
}

string detail_tiere(string str)
{
  int kuehe;
  int katzen;
  int gesamt;
  string s;

  kuehe  = sizeof(filter_objects(all_inventory(TO), "id", "kuh"));
  if(str == "tiere")
  {
    katzen = (present("katze",TO)) ? 1 : 0; //bei tiere katze mitzaehlen
  }
  else
  {
    katzen = 0; // sonst nicht
  }
  gesamt = kuehe + katzen;

  if(!gesamt) return "Es befinden sich keine Tiere im Kuhstall.\n";

  s = (gesamt == 1) ? "Es befindet sich " : "Es befinden sich ";

  switch(kuehe)
  {
    case 0 : break;
    case 1 : s += "eine Kuh"; break;
    case 2 : s += "zwei Kuehe"; break;
    default: s += "viele Kuehe"; break;
  }

  if(katzen ) s += " und eine Katze";
  s += " im Kuhstall.\n";

  return s;
}
