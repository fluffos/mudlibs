#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>

int blumen;

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Das Esszimmer");
  SetProp(P_INT_LONG,
    "Das Esszimmer ist der vornehmste Raum des Bauernhofes. Hier wird "
    "nur zu besonderen Anlaessen und an Feiertagen gegessen, normalerweise "
    "ist den Bauern die Kueche gut genug, und dort ist es auch wesentlich "
    "gemuetlicher. Das ganze Zimmer wird hier durch den grossen Esstisch, "
    "beinahe koennte man schon Tafel dazu sagen, dominiert. Rundherum "
    "stehen schoen verzierte Stuehle. An den Waenden haengen noch ein "
    "paar Bilder. Es gibt zwei Ausgaenge, der eine nach Norden fuehrt "
    "Dich wieder in die Kueche und der andere nach Sueden ins Schlafzimmer."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"anlass","anlaessen"}) ,
    "Es scheint grade kein besonder Anlass zu sein."
  );

  AddDetail( ({"bauernhof","hof","bauernhofes"}) ,
    "Du befindest Dich im Bauernhof. Genauer gesagt, im Esszimmer."
  );

  AddDetail( ({"boden","holzboden"}) ,
    "Du stehst auf einem schon ziemlich abgetretenen Holzboden. Direkt unterm "
    "Tisch sehen die Bretter noch etwas besser aus, das kommt wohl daher, "
    "dass dort weniger herumgelaufen wird."
  );

  AddDetail( ({"brett", "bretter"}),
    "Der Boden besteht aus vielen Brettern, die schon recht abgenuetzt "
    "ausschauen."
  );

  AddDetail( ({"wand", "waende"}),
    "Du kannst nichts besonderes an den Waenden erkennen, ausser den Fenstern, "
    "durch die Du nach draussen schauen kannst, und ein paar Bildern."
  );

  AddDetail( ({"fenster"}) ,
    "Wenn das Esszimmer keine Fenster haette, waers ja dunkel hier drin,"
  );

  AddDetail( ({"bild", "bilder"}),
    "An den Waenden haengen ein paar Bilder, die alle irgendeine schoene "
    "Landschaft des Silberlandes darstellen."
  );

  AddDetail( ({"silberland","silberlandes"}) ,
    "Du befindest Dich mittendrin."
  );

  AddDetail( ({"landschaft"}) ,
    "Durch das westliche Fenster kannst Du Dir die Landschaft anschauen."
  );

  AddDetail( ({"fenster","fenstern"}) ,
    "Durch das westliche Fenster kannst Du schoene saftiggruene Wiesen "
    "sehen und durch das oestliche den Hof."
  );

  AddDetail( ({"wiese", "wiesen"}),
    "Die Wiesen siehst Du durch das westliche Fenster."
  );

  AddDetail( ({"hof"}) ,
    "Den Hof siehst Du durch das oestliche Fenster."
  );

  AddDetail( ({"decke"}) ,
    "An der Decke kannst Du wirklich nichts Spezielles erkennen. "
    "Sie schaut ganz genauso aus, wie du es in einem Bauernhof erwartest."
  );

  AddDetail( ({"spezielles"}) ,
    "Hier gibts es nichts Spezielles."
  );

  AddDetail( ({"bauer", "baeurin", "baeuerin", "bauern"}),
    "Der ganze Bauernhof gehoert dem Bauer und der Baeurin."
  );

  AddDetail( ({"kueche"}) ,
    "Wenn Du nach Norden gehst, gelangst Du direkt dorthin."
  );

  AddDetail( ({"tisch", "esstisch"}),
    "Der Esstisch steht mitten im Zimmer, man koennte sagen er dominiert "
    "den ganzen Raum. Darauf liegt ein schoenes Tischtuch, auf dem "
    "noch eine Blumenvase steht."
  );

  AddSpecialDetail( ({"vase"}), "detail_vase" );

  AddDetail( ({"tafel"}) ,
    "Wenn der Esstisch in einem etwas vornehmeren Haus stuende, wuerde "
    "er wahrscheinlich als Tafel bezeichnet."
  );

  AddDetail( ({"stuhl", "stuehle", "sessel"}),
    "Die Stuehle haben schoene Verzierungen, wie man sie von Bauernmoebel "
    "so kennt."
  );

  AddDetail( ({"bauernmoebel","moebel"}) ,
    "Naja, so sachen wie Stuehle eben."
  );

  AddDetail( ({"verzierung","verzierungen"}) ,
    "Die Moebel sind bemalt, vom Stil her ist es Bauernmalerei. Was "
    "sollte es auch sonst sein? Die einen finden sie schoen, die "
    "anderen nicht. "
  );

  AddDetail( ({"stil"}) ,
    "Es handelt sich ganz klar um Bauernmalerei."
  );

  AddDetail( ({"bauernmalerei","malerei"}) ,
    "Die Bauern bemalen ihre Stuehle gerne mit laendlichen Symbolen."
  );

  AddDetail( ({"bauern","bauer"}) ,
    "Xaver ist ein Bauer. Schau ihn dir halt genauer an."
  );

  AddDetail( ({"symbole","symbol","symbolen"}) ,
    "Es handelt sich durchweg um laendliche Symbole."
  );

  AddDetail( ({"zimmer", "esszimmer", "raum"}),
    "Das Zimmer, in dem Du gerade stehst, ist das Esszimmer des Bauernhofes."
  );

  AddDetail( ({"bauernhof", "bauernhaus", "haus"}),
    "Du stehst gerade in einem Bauernhof. Noch genauer im Esszimmer davon."
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Es gibt zwei Ausgaenge. Der eine fuehrt nach Norden in die Kueche "
    "und der andere nach Sueden ins Schlafzimmer."
  );

  AddDetail( ({"schlafzimmer"}) ,
    "Geh nach Sueden und Du kommst ins Schlafzimmer."
  );

  AddDetail( ({"tuch", "tischtuch"}),
    "Auf dem Tisch ist ein rot-weiss kariertes Tischtuch ausgebreitet."
  );

  AddDetail( ({"vase", "blumenvase"}),
    "Eine ganz schlichte Blumenvase, in der sich viele schoene Wiesenblumen "
    "befinden, steht mitten auf dem Esstisch."
  );

  AddDetail( ({"feiertag","feiertage","feiertagen"}) ,
    "Heute ist kein Feiertag. Zumindest im Silberland nicht."
  );

  AddSpecialDetail( ({"blume", "blumen","wiesenblume","wiesenblumen"}), "detail_blumen" );

  AddSmell(DEFAULT_SMELL,
    "Aus der Kueche stroemt der Duft eines guten Essens herueber."
  );

  AddSmell( ({"blume", "blumen"}),
    "Du magst den Geruch der Blumen."
  );

  AddSmell( ({"essen","essens"}) ,
    "Der Essensgeruch kommt aus der Kueche."
  );

  AddSmell( ({"essensgeruch","duft"}) ,
    "Da wird man sofort hungrig, wenn es so gut riecht."
  );

  AddSound(DEFAULT_SOUND,
    "Ganz gedaempft hoerst Du eine Kuh muhen.");

  AddSound( ({"kuh"}), "Es scheint so, als ob die Kuh Muh macht.");

  AddSound( ({"muh"}), "Mmmmmmmmmmmmuuuuuuuuhhhhhhhhhh");
/*
Fenstern, Feiertagen,
Essensgeruch, Essens, Duft, Bauernmoebel, Bauernmalerei, Bauernhofes,
Art, Anlaessen
*/

  AddCmd( CMD_NEHMEN           , "cmd_nehmen" );
  AddCmd( ({"steck","stecke"}) , "cmd_stecken" );

  AddExit("norden", ROOM "kueche" );
  AddExit("sueden", ROOM "schlafzimmer" );

  blumen = 0;
}

void reset()
{
  ::reset();

  if(blumen)
  {
    blumen = 0;

    if(present("sophie",TO))
    {
      tell_room(TO,BS("Sophie nimmt die verwelkten Blumen aus der Vase "
                      "und wirft sie sogleich fort."));
    }
    else
    {
      tell_room(TO,BS("Sophie kommt herein und entfernt die verwelkten "
                      "Wiesenblumen aus der Vase. Sofort verschwindet "
                      "sie wieder, wohl um die Wiesenblumen wegzuwerfen."
      ));
    }
  }
}

string detail_blumen(string str)
{
  string s;

  if(blumen)
  {
    s = "In der Vase steckt eine Blume, vermutlich ist sie "
        "von der Wiese vor dem Bauernhof.";
  }
  else
  {
    s = "Sowas siehst Du hier nicht.";
  }

  return BS(s);
}

string detail_vase(string str)
{
  if(blumen)
  {
    return "In der Vase befinden sich ein paar schoene Wiesenblumen.\n";
  }
  else

  return "Die Vase ist leer.";
}

int cmd_stecken(string str)
{
  string was, wohin;
  object ob;
  int n;

  notify_fail("Was willst Du wohin stecken ?\n");

  n = sscanf(str, "%s in %s", was,wohin);
  if(n==0)return 0;

  n = 0;

  if(member(({"blume","blumen","wiesenblume","wiesenblumen"}),was) > -1)
  {
    n += 1;
  }

  if(member(({"vase","blumenvase"}),wohin) > -1 )
  {
    n += 2;
  }

  if(n != 3)return 0;

  if(blumen)
  {
    TELLPLAYER("In der Blumenvase befinden sich bereits ein paar Blumen.\n");
    return 1;
  }

  if(ob=present("wiesenblume",TP))
  {
    WRITELOG(TPUID+" steckt Blumen in die Blumenvase");
    TELLPLAYER(BS("Du steckst Deine Wiesenblume in die Blumenvase. "
                  "Da wird sich Sophie aber freuen."));
    TELLOTHERS(TPN+" steckt eine Blume in die Vase.\n");
    ob->remove();
    blumen = 1;
    return 1;
  }

  if(ob=present("blume",TP))
  {
    TELLPLAYER("Sopie hat lieber Wiesenblumen in ihrer Vase.\n");
    return 1;
  }

  return 0;
}

int cmd_nehmen(string str)
{
  string was, wohin;
  object ob;
  int n;

  notify_fail("Was willst Du woraus nehmen ?\n");

  n = sscanf(str, "%s aus %s", was,wohin);
  if(n==0)return 0;

  n = 0;

  if(member(({"blume","blumen","wiesenblume","wiesenblumen"}),was) > -1)
  {
    n += 1;
  }

  if(member(({"vase","blumenvase"}),str))
  {
    n += 2;
  }

  if(n != 3)return 0;

  if(!blumen)
  {
    TELLPLAYER("In der Blumenvase befinden sich keine Blumen.\n");
    return 1;
  }

  ob = clone_object(OBJ "wiesenblume");
  if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
  {
    TELLPLAYER(BS("Du versuchst die Blume aus der Vase zu nehmen, doch selbst "
                  "diese kleine Wiesenblume ist zu schwer fuer "
                  "Dich, Du Schwaechling!\n"));
    TELLOTHERS(TPN+" begutachtet die Blume in der Vase.\n");
    ob->remove();
  }
  else
  {
    WRITELOG(TPUID+" nimmt sich die Blumen aus der Blumenvase");
    TELLPLAYER("Du nimmst Dir die Blume aus der Vase.\n");
    TELLOTHERS(TPN+" nimmt die Blume aus der Vase.\n");
    blumen = 0;
  }

  return 1;
}
