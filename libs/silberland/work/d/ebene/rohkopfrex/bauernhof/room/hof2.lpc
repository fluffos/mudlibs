#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <properties.h>

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Im Hof");
  SetProp(P_INT_LONG,
    "Du stehst jetzt im Hof vom Bauernhof! Nachdem Du dich kurz umgeschaut "
    "hast, glaubst Du zu erkennen, dass sich im westlichen Teil des Hauses "
    "die Wohnraeume der Bauern befinden und im oestlichen Teil die Staelle. "
    "Nach Norden gehts noch weiter durch den Hof und dann ins Haus hinein, "
    "nach Osten kannst Du in den Kuhstall gehen und nach Sueden gehts "
    "raus aus dem Hof."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD, ENV_TEMPERATURE:20]));

  AddDetail( ({"hof"}) ,
    "Du stehst jetzt im suedlichen Teil des Hofes."
  );

  AddDetail( ({"bauernhof", "bauernhaus", "haus"}),
    "Du stehst im Hof von einem schoenen grossen Bauernhaus."
  );

  AddDetail( ({"wohnraum", "wohnraeume"}),
    "Du versuchst durch ein Fenster in die Wohnraeume zu schauen, aber leider "
    "sind die Vorhaenge zugezogen."
  );

  AddDetail( ({"fenster"}) ,
    "Die Vorhaenge hinter den Fenstern sind zugezogen."
  );

  AddDetail( ({"vorhang", "vorhaenge"}),
    "Die Vorhaenge sind mit schoenen Blumenmustern verziert."
  );

  AddDetail( ({"muster", "blumenmuster"}),
    "Mit schoenen liebevoll gearbeiteten Blumenmustern sind die Vorhaenge "
    "hinter den Fenstern verziert."
  );

  AddDetail( ({"stall", "staelle"}),
    "Die Staelle sind im oestlichen Teil des Bauernhofes. Durch den Eingang "
    "im Osten gelangst Du in den Kuhstall, den Schweinestall kannst Du "
    "von hier aus nicht erreichen."
  );

  AddDetail( ({"kuhstall"}) ,
    "Wenn Du nach Osten gehst, kannst Du Dir den Kuhstall noch viel besser "
    "anschauen."
  );

  AddDetail( ({"schweinestall"}) ,
    "Den Schweinestall kannst Du von hier aus nicht erreichen."
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Es gibt hier drei Ausgaenge: Der noerdliche fuehrt Dich in einen "
    "weiteren Teil des Hofes, der suedliche raus aus dem Bauernhof und der "
    "oestliche in den Kuhstall hinein."
  );

  AddDetail( ({"boden"}),
    "Der Boden ist ueber und ueber mit Dreck bedeckt."
  );

  AddDetail( ({"dreck"}) ,
    "Der Dreck am Boden besteht aus Mist, Stroh und Heu. Dazwischen schaut "
    "noch etwas Schotter hervor, der wohl den Boden gebildet hat, als der "
    "Bauernhof noch ganz neu war."
  );

  AddDetail( ({"mist", "heu", "stroh", "schotter"}),
    "Das alles liegt am Boden herum: Mist, Heu, Stroh und darunter viel "
    "grober Schotter."
  );

  AddDetail( ({"himmel"}) ,
    "Pass auf, dass Dir der Himmel nicht auf den Kopf faellt!"
  );

  AddDetail( ({"wand", "waende"}),
    "An den Waenden kannst Du beim besten Willen nichts Interessantes "
    "entdecken.");

  AddSmell(DEFAULT_SMELL,
    "Hier riechts wie auf jedem Bauernhof: Ein bisschen nach all den Tieren "
    "die hier gehalten werden und ein bisschen nach Wiese, Heu und frischer "
    "Luft."
  );

  AddSound(DEFAULT_SOUND,
    "Du hoerst Geraeusche, wie Du sie vielleicht auch von anderen Bauernhoefen "
    "kennst: Kuehe muhen, Schweine grunzen und Huehner gackern."
  );

  AddItem(NPC "hansi", REFRESH_DESTRUCT);
  AddItem(NPC "greti", REFRESH_DESTRUCT);

  AddExit("norden", ROOM "hof1");
  AddExit("sueden", ROOM "wiese1");
  AddExit("osten",  ROOM "k_stall1");
}
