#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <verben.h>

void create() {

  ::create();

  SetProp(P_INT_SHORT, "In einer Kueche");
  SetProp(P_INT_LONG,
    "Das hier ist eine ganz typische baeuerliche Kueche, mit einem "
    "riesigen Holzofen darin. An der Wand hinter dem Tisch steht eine "
    "gemuetliche Holzbank und davor stehen drei Holzstuehle, alles ist "
    "so richtig rustikal, wie man sich das in einem Bauernhof auch vorstellt. "
    "Nach Westen fuehrt noch eine kleine Tuer in den Vorratsraum, nach Osten "
    "gehts zurueck in den Flur und im Sueden ist wahrscheinlich das "
    "Esszimmer."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"bauernhof", "haus", "bauernhaus", "gebaeude"}),
    "Das Gebaeude, in dem Du gerade stehst ist der Bauernhof."
  );

  AddDetail( ({"kueche"}) ,
    "Du stehst in einer schoenen baeuerlichen Kueche."
  );

  AddDetail( ({"boden", "kuechenboden"}),
    "Der Kuechenboden besteht fast zur Gaenze aus Holz, nur um den "
    "Ofen herum, wurde er aus Steinen gemacht."
  );

  AddDetail( ({"steinboden", "stein", "steine"}),
    "Um den Ofen herum wurde der Boden aus Steinen gefertigt. Das ist "
    "ganz wichtig, damit er sich auch nicht entzuenden kann."
  );

  AddDetail( ({"decke"}) ,
    "Die Decke in der Kueche hat sich von Rauch und Kuechendaempfen "
    "ganz dunkel, fast schon schwarz, gefaerbt."
  );

  AddDetail( ({"ofen", "holzofen"}),
    "Dieser Holzofen ist wirklich riesig. Darauf haben sicher genug Toepfe "
    "und Pfannen Platz, um ein Festessen fuer eine Riesengrossfamilie "
    "zuzubereiten. Jetzt steht gerade nur ein Topf darauf, in dem eine "
    "herrlich duftende Suppe vor sich hinkoechelt."
  );

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind so mit Geschirr und anderem Kochzeugs vollgehaengt, dass "
    "Du sie eigentlich ueberhaupt nicht richtig sehen kannst."
  );

  AddDetail( ({"geschirr"}) ,
    "An der Wand haengen eine Menge Toepfe und Pfannen, das restliche "
    "Geschirr ist ordentlich in Regalen einsortiert."
  );

  AddDetail( ({"toepfe"}) ,
    "Viele Toepfe haengen an Haken an der Wand. Ein einzelner steht auf dem "
    "grossen Holzofen und ist mit einer koestlich duftenden Suppe gefuellt."
  );

  AddDetail( ({"topf", "suppentopf"}),
    "Ein mittelgrosser Suppentopf steht auf dem Holzofen. In ihm kocht "
    "gerade eine Suppe, deren Geruch Dir das Wasser im Mund zusammenrinnen "
    "laesst."
  );

  AddDetail( ({"suppe"}) ,
    "In dem Suppentopf auf dem Ofen kocht eine herrlich duftende Suppe. Am "
    "liebsten wuerdest Du einmal davon kosten."
  );

  AddDetail( ({"pfanne", "pfannen"}),
    "Viele Pfannen sind mittels Haken an die Wand gehaengt worden."
  );

  AddDetail( ({"haken"}) ,
    "Die Haken stecken in der Wand, daran haengen einige Toepfe und Pfannen."
  );

  AddDetail( ({"regal", "regale"}),
    "Ein paar Regale sind an der Wand befestigt. Darin ist fein saeuberlich "
    "einen Menge Geschirr gestapelt: Teller, Schuesseln und Tassen."
  );

  AddDetail( ({"teller", "schuessel", "schuesseln", "tasse", "tassen"}),
    "Teller, Schuesseln und Tassen stehen in den Regalen, die an der Wand "
    "befestigt sind."
  );

  AddDetail( ({"zeug", "zeugs", "kochzeug", "kochzeugs"}),
    "Ziemlich viel Zeug, dass zum Kochen benoetigt wird, haengt entweder "
    "direkt an der Wand oder es ist ordentlich in die Regale eingeraeumt, "
    "die wiederum an der Wand haengen."
  );

  AddDetail( ({"tisch"}) ,
    "Ein ganz einfacher Holztisch. Seine Oberflaeche ist schon ziemlich "
    "abgenuetzt, wodurch der ganze Tisch richtig alt erscheint. Dahinter "
    "steht eine Holzbank und davor drei Holzstuehle."
  );

  AddDetail( ({"oberflaeche", "tischoberflaeche"}),
    "Die Tischoberflaeche ist schon ziemlich abgenuetzt."
  );

  AddDetail( ({"bank", "holzbank"}),
    "Die alte Holzbank steht hinter dem Tisch. Auf ihr sitzt der Bauer, "
    "wenn er nach seiner harten Arbeit sein Essen geniesst."
  );

  AddDetail( ({"stuhl", "sessel", "holzstuhl", "holzsessel", "stuehle"}),
    "In der Kueche stehen genau drei Stuehle, die sich alle zum Verwechseln "
    "aehnlich sehen. Sie sind aus Holz und scheinen schon genauso alt zu "
    "sein wie der Tisch und die Bank."
  );

  AddDetail( ({"tuer", "tueren"}),
    "Du kannst die Kueche durch drei Tueren verlassen: eine wird Dich in "
    "den Vorratsraum fuehren, die andere ins Esszimmer und die dritte in den "
    "Flur."
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Es gibt hier drei Ausgaenge: Der nach Westen fuehrt die in den "
    "Vorratsraum, der nach Sueden ins Esszimmer und nach Osten gelangst "
    "Du in den Flur."
  );

  AddDetail( ({"vorratsraum", "speiss"}),
    "Geh nach Westen und Du wirst den Vorratsraum besser untersuchen koennen."
  );

  AddDetail( ({"esszimmer"}) ,
    "Das Esszimmer wird nur zu besonderen Anlaessen benuetzt, normalerweise "
    "essen die Bauersleut hier in der Kueche."
  );

  AddDetail( ({"flur"}) ,
    "Der Flur ist im Osten, durch ihn musst Du durch, wenn Du wieder raus "
    "willst aus dem Bauernhof."
  );

  AddDetail( ({"feuer"}) ,
    "Das Feuer kannst Du nicht sehen, nur ganz leise knistern hoerst Du es "
    "aus dem Ofen."
  );

  AddDetail( ({"holz"}) ,
    "Hier sind so viele Dinge aus Holz, dass jedes Feuer seine Freude mit "
    "dieser Kueche haette, nur ist zum Glueck der Boden um den Ofen "
    "aus Stein, und so kann das Feuer nicht aus dem Ofen raus, und die "
    "Kueche nicht verbrennen."
  );

  AddSmell( DEFAULT_SMELL,
    "Der Duft der kochenden Suppe ist so ueberwaeltigend, dass Du etwas "
    "anderes nicht mehr riechen kannst."
  );

  AddSmell( ({"suppe"}) ,
    "Die Suppe riecht sooooo gut."
  );

  AddSmell( ({"topf"}) ,
    "Du haeltst Deine Nase ueber den Topf und holst tief Luft. MMMMMHHhh!"
  );

  AddSound( DEFAULT_SOUND,
    "Du hoerst die kochende Suppe blubbern und leise das Feuer im Ofen "
    "knistern."
  );

  AddSound( ({"suppe"}) ,
    "Du kannst hoeren, wie die Suppe leise blubbert."
  );

  AddSound( ({"feuer"}) ,
    "Das Feuer knistert ganz leise im Ofen."
  );

  AddItem(NPC "sophie", REFRESH_DESTRUCT);

  AddExit("osten",  ROOM "flur" );
  AddExit("westen", ROOM "speiss" );
  AddExit("sueden", ROOM "esszimmer" );

  AddCmd( CMD_ESSEN+({"koste","probier","probiere"}), "cmd_kosten" );
}

int cmd_kosten(string str)
{
  notify_fail("Was willst Du denn kosten?\n");

  if(-1 == member(({"suppe","von suppe"}),str))
  {
    return 0;
  }

  WRITELOG(TPUID+" kostet Suppe");
  TELLPLAYER(BS("Du kostest die heisse Suppe und verbrennst Dir ganz fuerchterlich "
                "Deine Zunge."));
  TELLOTHERS(TPN+" verbrennt sich die Zunge, als "+TPP(WER)+
            " die Suppe kosten will.\n");
  SetProp(P_KILL_NAME,"Eine heisse Suppe");
  TP->do_damage(3+random(5));

  return 1;
}
