#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>

int heugabel;

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Im Heustadl");
  SetProp(P_INT_LONG,
    "Im hinteren Teil des Stadls liegt doch noch mehr Heu herum, als Du "
    "Dir vorher gedacht hast. Hier steht eine Leiter mit der Du direkt "
    "unter das Dach der Scheune kraxeln kannst. Es muss doch ganz schoenen "
    "Spass machen, sich von da oben ins Heu fallen zu lassen. Wie auch "
    "immer, nach Osten kommst Du wieder in den vorderen Teil des Stadls."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"stadl", "scheune", "heustadl", "teil"}),
    "Du stehst jetzt gerade im hinteren Teil eines alten Heustadls."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus alten Holzbrettern, darauf liegt etwas Heu. Nicht "
    "viel, aber man kann es schon getrost als Heuhaufen bezeichnen."
  );

  AddDetail( ({"wand", "waende"}),
    "Alle Waende bestehen aus alten Holzbrettern. In der westlichen befindet "
    "sich ein Fenster, durch das Du nach draussen schauen kannst."
  );

  AddDetail( ({"fenster","durch fenster","nach draussen","raus"}) ,
    "Du schaust durch das Fenster nach draussen und erblickst eine "
    "wunderschoene Blumenwiese und davor einen kleinen rauschenden Bach."
  );

  AddDetail( ({"wiese", "blumenwiese"}) ,
    "Durch das Fenster kannst Du eine herrliche Blumenwiese sehen."
  );

  AddDetail( ({"spass"}) ,
    "Wenn Du es nicht probierst, wirst Du es nie erfahren!"
  );

  AddDetail( ({"blume", "blumen"}),
    "Viele bunte Blumen stehen auf der Wiese, die Du durchs Fenster sehen "
    "kannst."
  );

  AddDetail( ({"decke"}) ,
    "Ueber Dir liegen ein paar lose Bretter, die so was wie eine Decke "
    "bilden, oder den Boden des ersten Stockes, wenn man das so bezeichnen "
    "will. Du kannst jedenfalls die Leiter dazu benutzen um da hinauf zu "
    "kraxeln."
  );

  AddDetail( ({"brett", "bretter", "holzbrett", "holzbretter"}),
    "Fast der ganze Stadl besteht aus alten Holzbrettern. Du schaust Dir "
    "einige etwas genauer an, aber auch dann kannst Du nichts Besonderes "
    "daran erkennen."
  );

  AddDetail( ({"holzleiter","leiter"}) ,
    "Das ist eine ziemlich alte Holzleiter. Du kannst daran nach oben "
    "klettern, direkt unters Dach. Das heisst, wenn sie Dich aushaelt."
  );

  AddDetail( ({"heu"}) ,
    "Das ganze Heu, das wahrscheinlich von der vorjaehrigen Ernte "
    "uebrig geblieben ist, wurde hier aufgehaeuft, zu einem "
    "Haufen, der genau richtig ist, um von oben hineinzuspringen."
  );

  AddDetail( ({"ernte"}) ,
    "Sie ist wohl sehr ertragreich ausgefallen."
  );

  AddDetail( ({"heuschnupfen"}) ,
    "Der waere hier ganz fatal."
  );

  AddDetail( ({"dach"}) ,
    "Wenn Du Dir das Dach wirklich genau anschauen willst, dann kraxelst "
    "Du am besten die Leiter hinauf. Dort oben bist Du dem Dach naemlich "
    "viel naeher, und kannst es daher auch besser untersuchen."
  );

  AddDetail( ({"bach"}) ,
    "Der Bach rauscht relativ zuegig Richtung Sueden."
  );

  AddSpecialDetail( ({"haufen", "heuhaufen"}), "detail_haufen");

  AddSmell( DEFAULT_SMELL,
    "Du riechst hauptsaechlich den Geruch des Heues."
  );

  AddSmell( ({"heu"}) ,
    "Wenn Du Heuschnupfen haettest, muesstest Du jetzt niesen."
  );

  AddSound( DEFAULT_SOUND,
    "Du vernimmst ein leises Rauschen, direkt hinter dem Stadl "
    "verlaeuft ein kleiner Bach. Wenn Du durch das Fenster blickst, "
    "kannst Du ihn sogar sehen."
  );

  AddSound( ({"bach","rauschen","plaetschern"}),
    "Leise plaetschert und rauscht es vor sich hin."
  );

  AddExit("osten", ROOM "stadl1");

  AddCmd( CMD_KLETTERN + CMD_KRAXELN, "cmd_kraxeln");

  heugabel=1;
}

void reset()
{
  ::reset();
  if(!heugabel && !present("heugabel",TO)) heugabel=1;
}

string detail_haufen(string str)
{
  object obj;
  string s;

  if(heugabel)
  {
    s = "Du schaust Dir den Heuhaufen etwas genauer an, und findest dort "
        "zwischen dem ganzen Heu anstatt einer Nadel eine alte Heugabel. "
        "Das haette ja gefaehrlich enden koennen, wenn irgendwelche Kinder "
        "im Haufen herumgesprungen waeren. ";

    obj = clone_object(WEAPON "heugabel");

    if(ME_TOO_HEAVY==obj->move(TP,M_GET|M_SILENT))
    {
      s += "Du versuchst die Heugabel aus dem Heu herauszuziehen, doch die "
           "Heugabel ist viel zu schwer fuer Dich. ";

      obj->remove();
    }
    else
    {
      s += "Damit sich niemand daran verletzt, nimmst Du die Heugabel "
           "gleich an Dich. ";
      heugabel = 0;
      WRITELOG(TPUID+" nimmt eine Heugabel");
    }
  }
  else
  {
    s = "Es waere sicher lustig, wenn Du die Leiter hinaufkraxelst, und dann "
        "von dort oben in den Heuhaufen herunterspringst.";
  }

  return BS(s);
}

int cmd_kraxeln(string str)
{
  notify_fail("Wohin willst Du kraxeln?\n");

  if(-1 == member(({"nach oben"
                   ,"oben"
                   ,"rauf"
                   ,"auf leiter"
                   ,"leiter"
                   ,"hinauf"
                   }),str))
  {
    return 0;
  }

  TP->move(ROOM "stadl3", M_GO, "nach oben", "kraxelt","kommt heraufgekraxelt");
  return 1;
}

int heugabel_im_heu()
{
  return heugabel;
}
