#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create() {

  ::create();

  SetProp (P_INT_SHORT, "Im Flur des Bauernhauses");
  SetProp (P_INT_LONG,
    "Du stehst jetzt im Flur des Bauernhauses. "+
    "Nach Westen gehts in die Kueche und nach Sueden gehts wieder raus. "+
    "Auch nach Osten fuehrt noch ein Durchgang in einen finsteren Raum."
  );

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"flur"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"boden", "holzboden"}),
    "Das duerfte schon ein sehr alter Holzboden sein, denn die Bretter "+
    "sind schon recht abgetreten."
  );

  AddDetail( "holz",
    "Die Decke und der Boden bestehen aus Holz, das schon sehr alt sein "+
    "duerfte."
  );

  AddDetail( ({"brett", "bretter"}),
    "Die Bretter, aus denen der Boden gemacht ist, sind schon recht "+
    "abgetreten."
  );

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind recht schlicht. Du kannst nichts besonderes daran "+
    "entdecken."
  );

  AddDetail( ({"decke"}) ,
    "Eine ganz alte Holzdecke, sie passt gut in dieses Haus."
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Hier gibts drei Ausgaenge: Nach Westen gehts in die Kueche, nach "+
    "Osten in das Schlachtzimmer und nach Sueden gehts raus aus dem "+
    "Haus."
  );

  AddDetail( ({"raum"}) ,
    "Dieser Raum ist der Flur des Bauernhauses, in dem Du dich gerade "+
    "befindest."
  );

  AddDetail( ({"bauernhof", "bauernhaus", "haus"}),
    "Du stehst gerade im Bauernhof. Das Zimmer in dem Du gerade bist, ist "+
    "der Flur davon."
  );

  AddDetail( ({"kueche"}) ,
    "Du kannst erkennen, dass die Kueche im Westen ist."
  );

  AddDetail( ({"durchgang"}) ,
    "Der Durchgang nach Osten fuehrt in das Schlachtzimmer."
  );

  AddDetail( ({"schlachtzimmer"}) ,
    "Im Schlachtzimmer ist es finster."
  );

  AddSmell(DEFAULT_SMELL,
    "Von draussen kommt der Geruch des Misthaufens herein."
  );

  AddSmell( ({"haufen", "misthaufen"}),
    "Den Misthaufen kannst Du draussen besser riechen."
  );

  AddSound(DEFAULT_SOUND,
    "Du kannst Kuehe muhen, Huehner gackern und Schweine grunzen hoeren."
  );

  AddSound( ({"kuh", "kuehe"}),
    "Die Kuh macht muh."
  );

  AddSound( ({"schwein", "schweine"}),
    "Du kannst Schweine grunzen hoeren."
  );

  AddSound( ({"huhn", "huehner"}),
    "Die Huehner gackern ganz schoen laut."
  );

  AddItem(NPC "xaver", REFRESH_DESTRUCT);

  AddExit("sueden", ROOM "hof1" );
  AddExit("westen", ROOM "kueche" );
  AddExit("osten",  ROOM "schlachtzimmer" );
}

