#include "../def.h"
#include OSTERHASE

inherit "/std/room";

#include <properties.h>
#include <language.h>

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Das Schlachtzimmer");
  SetProp(P_INT_LONG,
    "Im Schlachtzimmer herrscht eine merkwuerdige Stimmung, "
    "wahrscheinlich sind das die Schwingungen des Todes. Hier ist es "
    "kalt und das bisschen Licht, das durch die kleine Tuer herein "
    "faellt, reicht bei weitem nicht aus, diesen duesteren Raum zu "
    "erhellen. Es schaut zwar so aus, als ob hier regelmaessig geputzt "
    "wird, aber trotzdem klebt ueberall, am Boden und auch an den "
    "Waenden, eingetrocknetes Blut. Am besten Du verlaesst diesen Ort "
    "wieder so schnell wie moeglich."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:12]));

  AddDetail( ({"raum"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"stimmung"}) ,
    "Die Stimmung die in diesem Raum herrscht ist wirklich ziemlich "
    "merkwuerdig. Sie kommt wahrscheinlich dadurch zustande, dass "
    "hier zwar Tiere gewaltvoll sterben muessen, aber das ganze "
    "nur aus dem Grund, weil die Bauern das Fleisch brauchen, um "
    "ueberleben zu koennen. Sie nehmen den Tieren das Leben, nur um "
    "ihr eigenes Leben und das ihrer Kinder behalten zu koennen."
  );

  AddDetail( ({"atmosphaere"}) ,
    "Die Atmosphaere in diesem Raum wird zum Grossteil von den "
    "Schwingungen des Todes bestimmt."
  );

  AddDetail( ({"schwingung", "schwingungen"}),
    "Die meisten der sogenannten hoeheren Lebewesen hier im Silberland "
    "wissen nicht sehr viel ueber die Schwingungen des Todes. Aber "
    "fast alle Tiere spueren es, wenn der Tod zu ihnen kommt. Wie "
    "sonst wuerdest Du das erklaeren, als dass der Tod geheimnisvolle "
    "Schwingungen aussendet."
  );

  AddDetail( ({"zimmer", "schlachtzimmer"}),
    "Du stehst gerade im Schlachtzimmer. In den uebrigen Teilen des "
    "Bauernhofes ist es richtig angenehm und nett, nur hier laeuft es Dir "
    "kalt den Ruecken runter."
  );

  AddDetail( ({"boden"}) ,
    "Zwar schaut der Boden so aus, als ob er gut geputzt waere, aber "
    "trotzdem kannst Du noch Reste von eingetrocknetem Blut erkennen."
  );

  AddDetail( ({"reste","blutreste"}) ,
    "Auf dem Boden finden sich noch Reste eingetrockneten Blutes. Das "
    "laesst sich wohl auch nur schwer entfernen."
  );

  AddDetail( ({"wand", "waende", "steinwand", "steinwaende","steinwaenden"}),
    "An den grauen Steinwaenden kleben eingetrocknete Blutreste. Ausserdem "
    "sind noch schwere Eisenringe in die Waende eingemauert."
  );

  AddDetail( ({"decke"}) ,
    "Sogar an der Decke klebt Blut."
  );

  AddSpecialDetail( ({"blut", "blutfleck", "blutflecken", "fleck", "flecken"}),
    "det_blut"
  );

  AddDetail( ({"bauernhof", "bauernhaus", "haus"}),
    "Das Schlachtzimmer ist nur ein Teil dieses sonst so schoenen "
    "Bauernhofes."
  );

  AddDetail( ({"ring", "ringe", "eisenringe", "eisenring"}),
    "An den Eisenringen koennen die Tiere festgebunden werden, die hier "
    "getoetet werden sollen. Sie sind schon etwas verrostet."
  );

  AddDetail( ({"tuer"}) ,
    "Durch die Tuer kannst Du wieder zurueck in den Flur gehen."
  );

  AddDetail( ({"ausgang"}) ,
    "Es gibt nur einen Ausgang, der fuehrt Dich nach Westen in den Flur "
    "zurueck."
  );

  AddDetail( ({"tod","todes"}) ,
    "Der geht hier wohl ein und aus. Dich froestelt."
  );

  AddDetail( ({"tier","tiere"}) ,
    "Im Moment sind keine da, aber den Geist der hier gestorbenen, den "
    "glaubst Du noch spueren zu koennen. Dir laeuft es eiskalt den Ruecken "
    "herunter. "
  );

  AddSmell( DEFAULT_SMELL,
    "Du riechst eigentlich nichts, ausser dem Geruch des Todes."
  );

  AddSmell( ({"tod"}),
    "Hole tief Luft und merke Dir diesen Geruch, wenn Du den das naechste "
    "Mal riechst, laufe um Dein Leben."
  );

  AddSound( DEFAULT_SOUND,
    "Stille. TOTENSTILLE."
  );

  AddSound( ({"stille","totenstille"}) ,
    "Du hoerst - absolut nichts."
  );

  AddCmd( ({"kratz", "kratze"}), "cmd_kratzen");

  AddExit("westen", ROOM "flur" );
}

/*
Teilen, Teil, Silberland, Ruecken, Raum,
Ort, Mal, Luft, Licht, Lebewesen, Leben, Kinder, Grund, Geruch, Flur,
Fleisch, Bauernhofes, Bauern
*/

string det_blut()
{
  string s;

  s = "Hier klebt ein Blutfleck neben dem anderen, das erzeugt nicht "
      "gerade eine einladende Atmosphaere.";

  if(present( OSTERHASENQUEST_ID, TP) )
  {
    s += " Falls Du blutrote Farbe brauchst, koenntest Du das "
         "eingetrocknete Blut von der Wand kratzen.";
  }

  return BS(s);
}

int cmd_kratzen(string str)
{
  object ob;

  if(!(ob=present( OSTERHASENQUEST_ID, TP)))
  {
    return 0;
  }

  notify_fail("Was willst Du von wo herunterkratzen?\n");

  if( str== "blut von wand" )
  {
    if(ob->query_color("rot"))
    {
      TELLPLAYER("Aber Du hast doch schon rote Farbe!\n");
    }
    else
    {
      TELLPLAYER(BS("Du kratzt etwas eingetrocknetes Blut von der Wand und mischt "
                    "es zu roter Farbe."));
      TELLOTHERS(TPN+" kratzt etwas eingetrocknetes Blut von der Wand.\n");
      ob->set_color("rot");
      WRITELOG(TPUID+" holt sich rote Farbe");
    }
    return 1;
  }
  return 0;
}


