/* speiss.c
 * bauernhof
 *
 * rohkopfrex@silberland
 *
 * ??.5.1997
 */

#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Der Vorratsraum");
  SetProp(P_INT_LONG,
    "Das ist der Vorratsraum vom Bauernhof, die Bauersleut' werden das "
    "wohl \"d' Speiss\" nennen. Aber wie auch immer es heisst, hier "
    "gibts eine Menge zu essen. Alles moegliche Gemuese und Obst stapelt "
    "sich in den Regalen an der Wand. Und von der Decke haengen saftige "
    "geraeucherte Schinken. In letzter Zeit ist es den Bauern anscheinend "
    "richtig gut gegangen, dass sie so einen Vorrat anlegen konnten."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:15]));

  AddDetail( ({"vorratsraum", "speiss"}),
    "Der Vorratsraum wird von den Bauern meistens Speiss oder d' Speiss "
    "genannt. Hier ist es kuehler als in den anderen Zimmern des "
    "Bauernhofes und somit ideal um Lebensmittel zu lagern."
  );

  AddDetail( ({"lebensmittel"}) ,
    "Hier gibts jede Menge Lebensmittel: viele verschiedene Sorten "
    "Obst und Gemuese sind fein saeuberlich in die Regale an der Wand "
    "eingeordenet worden. Am Boden stehen Saecke in denen sich "
    "Mehl, Salz oder Zucker befindet und von der Decke haengen saftige "
    "Raeucherschinken, Speckschwarten und Wuerste herunter."
  );

  AddDetail( ({"obst"}) ,
    "Hier gibts Aepfel, Birnen, Zwetschken und Kirschen, und wahrscheinlich "
    "liegen dahinter noch andere Sorten Obst. Das alles gibt es aber nicht nur "
    "in frischer Form, sondern auch eingelegt als Kompott, als Marmelade "
    "und sogar gedoerrtes Obst kannst Du sehen."
  );

  AddDetail( ({"doerrobst"}) ,
    "Damit es auch Obst zu essen gibt, wenn es gerade nicht frisch auf "
    "einem Baum waechst, hat es die Baeurin gedoerrt und hier in der "
    "Speiss eingelagert."
  );

  AddDetail( ({"kompott"}) ,
    "Die Baeurin hat das Kompott aus ganz frischen Fruechten zubereitet "
    "und es dann in ihre Kompottglaeser eingefuellt. Und genau diese "
    "Glaeser stehen jetzt hier und werden von Dir betrachtet."
  );

  AddDetail( ({"glas"}) ,
    "Du suchst nach Dingen, die aus Glas sind und findest: "
    "Kompottglaeser, Marmeladeglaeser und Glaeser mit eingelegten "
    "Fruechten."
  );

  AddDetail( ({"glaeser"}) ,
    "In dem einen Glas ist Marmelade, in dem anderen Kompott und in wieder "
    "einem anderen sind eingelegte Fruechte."
  );

  AddDetail( ({"marmeladeglas", "marmeladeglaeser"}),
    "In den Marmeladeglaesern ist Marmelade drinnen. Alle Glaeser sind "
    "handschriftlich beschriftet."
  );

  AddDetail( ({"kompottglas", "kompottglaeser"}),
    "Die Kompottglaeser stehen zwischen den Glasern mit der Marmelade "
    "und denen mit den eingelegten Fruechten."
  );

  AddDetail( ({"beschriftung"}) ,
    "Die Glaser mit der Marmelade, dem Kompott und den eingelegten "
    "Fruechten sind alle sorgfaeltig beschriftet. Und zwar ist die "
    "Schrift liebevoll von Hand geschrieben worden."
  );

  AddReadDetail( ({"beschriftung"}) ,
    "Du liest die Beschriftung vom ersten Glas: Erdbeermarmelade "
    "(Fruehling 97). Dann liest Du die Beschriftung von einem "
    "anderen Glas: Marillenmarmelade (97). Jetzt wird es Dir "
    "schon langsam langweilig, aber eines willst Du noch lesen: "
    "Apfelkompott (97)."
  );

  AddDetail( ({"schrift"}) ,
    "Die Schrift wurde liebevoll mit schwarzer Tinte auf die weissen "
    "Etiketten aufgebracht."
  );

  AddReadDetail( ({"schrift"}) ,
    "Du liest die Schrift von allen Etiketten ab: "
    "Erdbeermarmelade (Fruehling 97), Marillenmarmelade (97), "
    "Apfelkompott (97), Birnenkomp.... Weil Du jetzt erkannt hast, "
    "was Dir die Schrift im Grossen und Ganzen sagen will, hoerst "
    "Du mit dem lesen auf und wendest Dich wieder wichtigeren Dingen zu."
  );

  AddDetail( ({"tinte"}) ,
    "Schwarze Tinte auf weissen Etiketten."
  );

  AddDetail( ({"etiketten", "etikett"}),
    "Weisse Etiketten unter schwarzer Schrift."
  );

  AddReadDetail( ({"etiketten"}) ,
    "Du schliesst Deine Augen und tippst auf ein Glas, machst die "
    "Augen wieder auf und liest: Erdbeermarmelade (Fruehling 97). "
    "Du machst das ganze noch ein zweites und drittes Mal und "
    "liest: Marillenmarmelade (97) und Apfelkompott (97). "
    "Wenn Du das noch einmal ausprobierst und zum gleichen Ergebnis "
    "kommst, ist das entweder ein komischer Zufall, oder Du stehst an "
    "einem Ort des Silberlandes in dem die Zufallswahrscheinlichkeit nicht den "
    "normalen Naturgesetzen folgt."
  );

  AddReadDetail( ({"etikett"}) ,
    "Du liest das erste Etikett, das Dir auffaellt: Erdbeermarmelade "
    "(Fruehling 97)."
  );

  AddDetail( ({"gemuese"}) ,
    "Du bist ueberwaeltigt von der Sortenvielfalt, die sich die Bauern hier "
    "als Gemuesevorrat angelegt haben. Obwohl es zwar so viele verschiedene "
    "Sorten gibt, sind doch von jeder Art nur wenige Stuecke "
    "Gemuese hier eingelagert."
  );

  AddDetail( ({ "stueck", "stuecke" }),
    "Welche Stuecke willst Du untersuchen? Druecke Dich doch ein "
    "bisschen genauer aus."
  );

  AddDetail( ({"sorten"}) ,
    "Hier gibts viele verschiedene Sorten von Gemuese, bei einigen "
    "bist Du Dir gar nicht so sicher, was es ist. Und nicht nur "
    "vom Gemuese gibt es hier viele verschiedene Sorten, sondern "
    "auch Obstsorten gibts ganz schoen viel verschiedene."
  );

  AddDetail( ({"obstsorten"}) ,
    "Das sind eine ganze Menge verschiedene Obstsorten. Auf den ersten "
    "Blick kannst Du folgende erkennen: Aepfel, Birnen, Zwetschken und "
    "Kirschen."
  );

  AddDetail( ({"birne"     , "birnen"
             , "kirsche"   , "kirschen"
             , "pflaume"   , "pflaumen"
             , "zwetschke" , "zwetschken"
             , "zwetschge" , "zwetschgen"}),
    "Hier liegen Birnen, Zwetschgen und auch ein paar Kirschen."
  );

  AddDetail( ({"schinken", "raeucherschinken", "speck", "speckschwarte",
               "speckschwarten", "wurst", "wuerste", "wuerstel"}),
    "Was da nicht alles von der Decke herunterhaengt? Saftige "
    "Raeucherschinken, Speckschwarten und auch noch ein paar Wuerstel."
  );

  AddDetail( ({ "apfel", "aepfel" }),
    "Du siehst ein paar rote Aepfel, ein paar gruene Aepfel und ein "
    "paar rot-gruene Aepfel. Ein paar Aepfel sind klein, ein paar sind "
    "gross. Eben eine schoene Vielfalt an Aepfeln, genauso wie sie die "
    "Natur hervorbringt."
  );

  AddDetail( ({"sortenvielfalt", "vielfalt"}),
    "Eine Vielfalt wie sie nur die Natur hervorbringen kann."
  );

  AddDetail( ({"wand", "waende"}),
    "Vor den Waenden stehen ein paar Regale mit vielen verschiedenen "
    "Lebensmitteln. Ausserdem sind auch einige Saecke daran angelehnt."
  );

  AddDetail( ({"decke"}) ,
    "Von der Decke haengen einige Wuerste, Schinken und Speckschwarten."
  );

  AddDetail( ({"boden"}) ,
    "Alle Lebensmittel, die nicht in den Regalen Platz gefunden haben, "
    "stehen oder liegen am Boden."
  );

  AddDetail( ({"mehl", "salz", "zucker"}),
    "Die grossen Saecke, die am Boden stehen sind wahrscheinlich mit "
    "Mehl, Salz oder Zucker gefuellt. Natuerlich koennte es auch sein, "
    "dass sich verschiedene noch nicht gemahlene Getreidesorten darin "
    "befinden."
  );

  AddDetail( ({"getreidesorten"}) ,
    "In jedem Sack, der am Boden steht, ist sehr wahrscheinlich eine "
    "andere Getreidesorte eingefuellt worden. Da sie aber zu sind "
    "und Du sich auch nicht oeffnen willst (sonst schuettest Du noch "
    "etwas heraus), wirst Du das nicht genauer herausfinden koennen."
  );

  AddDetail( ({"sack", "saecke"}),
    "Ein paar grosse Saecke stehen am Boden und lehnen zum Teil "
    "an der Wand oder an den Regalen."
  );

  AddDetail( ({"vorrat"}) ,
    "Das ist schon ein ganz netter Vorrat, den sich die Bauern hier "
    "herinnen angelegt haben, aber man muss ja auch bedenken, dass sie "
    "damit einen ganzen Winter lang auskommen muessen."
  );

  AddDetail( ({"ausgang"}) ,
    "Es gibt nur einen Ausgang und der wird Dich zurueck in die "
    "Kueche bringen. (Er fuehrt nach Osten.)"
  );

  AddDetail( ({"regal", "regale"}),
    "Die Regale stehen an den Waenden, in ihnen lagern jede Menge "
    "Lebensmittel.");

  AddSmell( DEFAULT_SMELL,
    "Hier kannst Du die Gerueche aller moeglichen Lebensmittel auf einmal "
    "riechen.");
  AddSmell( ({"schinken", "raeucherschinken", "wurst", "wuerste", "wuerstel",
              "speck", "speckschwarte", "speckschwarten"}),
    "Dir rinnt das Wasser im Mund zusammen, als Du daran riechst.");
  AddSmell( ({"obst", "apfel"     ,"aepfel"
                    , "birne"     ,"birnen"
                    , "kirsche"   ,"kirschen"
                    , "zwetschge" ,"zwetschgen"
                    , "zwetschke" ,"zwetschken"}),
    "Jedes einzelne Stueck Obst riecht ausserst frisch."
  );

  AddSmell( ({"gemuese"}) ,
    "Das Gemuese riecht, als waere es gerade erst geerntet worden."
  );


  AddSound( DEFAULT_SOUND,
    "Ganz leise kannst Du die typischen Bauernhofgeraeusche hoeren: "
    "Das Muhen einer Kuh, das Gackern eines Huhnes und das Grunzen "
    "eines Schweines."
  );


  AddExit("osten", ROOM "kueche" );
}
