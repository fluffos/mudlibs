#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>

int spass;

void create() {

  ::create();

  SetProp(P_INT_SHORT, "Unter dem Dach des Heustadls");
  SetProp(P_INT_LONG,
    "Auch hier direkt unter dem Dach des Stadls liegt noch Heu herum, "
    "der wird anscheinend oefters ganz schoen angefuellt sein. Vorsichtig "
    "blickst Du auf den Heuhaufen hinab... Von unten hat es nicht so hoch "
    "ausgeschaut.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"boden"}) ,
    "So ein wirklich richtiger Boden ist das nicht, Du stehst nur auf "
    "ein paar Holzbrettern, die ganz lose auf einigen dicken "
    "Querbalken liegen."
  );

  AddDetail( ({"brett", "bretter", "holzbretter", "holzbrett"}),
    "Fast der ganze Stadl ist aus alten Holzbrettern gefertigt. Einige "
    "davon bilden den Boden auf dem Du gerade stehst."
  );

  AddDetail( ({"wand", "waende", "decke"}),
    "Weil Du hier direkt unterm Dach stehst, sind die Waende und die "
    "Decke ein und dasselbe, naemlich die Unterseite des Daches."
  );

  AddDetail( ({"dach"}),
    "Du steht direkt unterm Dach, und kannst Dir deswegen dessen "
    "Unterseite recht gut anschauen, aber Du entdeckst trotzdem "
    "nichts daran, das Dir irgendwie interessant erscheint."
  );

  AddDetail( ({"unterseite"}) ,
    "Du schaust, ob Du an der Unterseite des Daches etwas Wichtiges "
    "sehen kannst, aber findest nichts."
  );

  AddDetail( ({"querbalken"}),
    "Die Bretter, auf denen Du gerade stehst, liegen auf dicken "
    "Querbalken und nur weil sie da so lose liegen, kannst Du durch "
    "die breiten Spalten die Querbalken darunter ueberhaupt sehen."
  );

  AddDetail( ({"spalt", "spalten"}),
    "Da die Holzbretter, auf denen Du stehst nur ganz lose daliegen, "
    "sind, teilweise sogar sehr breite, Spalten dazwischen. Als Du "
    "durchschaust, siehst Du nach unten in den Stadl."
  );

  AddDetail( ({"heu"}) ,
    "Sogar hier heroben liegt noch ein kleines bisschen Heu herum. "
    "Zwar nicht viel, aber genug, dass es einem auffaellt."
  );

  AddDetail( ({"heuhaufen"}) ,
    "Hier heroben liegt bei weitem nicht genug Heu, um es einen "
    "Heuhaufen zu nennen, nicht einmal, wenn Du alles zusammenlegen "
    "wuerdest. Aber wenn Du nach unten schaust, kannst Du einen "
    "Heuhaufen sehen. Irgendwie wuenschst Du Dir, noch ein Kind zu sein, "
    "dann wuerdest Du Dich jetzt ohne zu zoegern, einfach nach unten "
    "ins Heu fallen lassen."
  );

  AddDetail( ({"stadl", "heustadl"}),
    "Du befindest Dich gerade in einem alten Stadl, oder noch genauer "
    "direkt unterm Dach von einem alten Heustadl."
  );

  AddDetail( ({"balken", "holzbalken"}),
    "Der Dachstuhl besteht zum Grossteil aus alten Holzbalken. Pass auf, "
    "dass Du Dir daran nicht den Kopf anhaust."
  );

  AddDetail( ({"leiter"}) ,
    "Die Leiter schaut nicht gerade vertrauenswuerdig aus. Und zwar nicht "
    "nur weil das Holz, aus dem sie gemacht wurde, schon sehr alt ist, "
    "sondern auch weil sie sehr, sehr wackelig dasteht."
  );

  AddSmell( DEFAULT_SMELL,
    "Hier riechts ganz stark nach altem Heu."
  );

  AddSmell( ({"heu"}) ,
    "Das Heu riecht nicht mehr nach frischem Gras, sondern nach altem, "
    "getrockneten Heu."
  );

  AddSound( DEFAULT_SOUND,
    "Du hoerst hier so gut wie Nichts."
  );

  AddSpecialExit("runter", "exit_unten");

  AddCmd( CMD_KLETTERN+CMD_KRAXELN , "cmd_kraxeln");
  AddCmd( ({"spring", "springe"})  , "cmd_springen");

  spass=3;
}

void reset()
{
  ::reset();
  spass=3;
}

int exit_unten(string dir)
{
  TELLPLAYER(BS("Du versuchst ganz vorsichtig die Leiter wieder "
                "nach unten zu kraxeln, aber so wie die knarrt "
                "und aechzt, hast Du viel zuviel Angst dass sie "
                "unter deinem Gewicht zusammenkracht und bleibst "
                "heroben stehen."));
  TELLOTHERS(BS(TPN+" versucht nach unten zu klettern, hat aber dann "
                "doch zu grosse Angst und bleibt heroben."));

  return 1;
}

int cmd_kraxeln(string str)
{
  notify_fail("Wohin willst Du kraxeln?\n");

  if(-1 == member( ({"nach unten"
                    ,"unten"
                    ,"runter"
                    ,"leiter"
                    ,"mit leiter"
                    }), str))
  {
    return 0;
  }

  exit_unten("");
  return 1;
}

int cmd_springen(string str)
{
  object stadl2;

  if(!str || str == "")
  {
    TELLPLAYER(BS("Du springst in die Luft, haust Dir an einem Balken vom "
                  "Dachstuhl den Kopf an und landest wieder genau da, wo "
                  "Du vorher gestanden bist."));
    TELLOTHERS(BS(TPN+" springt in die Luft, haut sich an einem Balken vom "
                  "Dachstuhl den Kopf an und landet wieder genau da, wo "+
                  TPP(WER)+" vorher gestanden ist."));
    return 1;
  }

  if(-1 == member( ({"nach unten"
                    ,"unten"
                    ,"runter"
                    ,"in heu"
                    ,"in heuhaufen"
                    ,"heu"
                    ,"heuhaufen"
                    ,"hinunter"
                    }), str))
  {
    notify_fail("Wohin willst Du springen?\n");
    return 0;
  }

  WRITELOG(TPUID+" springt ins Heu");
  TELLPLAYER("Du nimmst all Deinen Mut zusammen und springst nach unten.\n");
  TELLPLAYER("UUUUUiiiiiii...\n");
  TP->move(ROOM "stadl2", M_GO, "nach unten"
                               , "springt"
                               , "faellt von oben in den Heuhaufen");

  stadl2 = ENV(TP);

  if(stadl2->heugabel_im_heu())
  {
    TELLPLAYER(BS("Du landest im Heuhaufen und wirst von einem harten Gegenstand, "
                  "der im Heu steckt, ganz schoen heftig verletzt."));
    SetProp(P_KILL_NAME,"Ein Sprung in einen Heuhaufen");
    TP->do_damage(10+random(5));
    return 1;
  }

  if(present("heugabel", stadl2 ))
  {
    TELLPLAYER(BS("Als Du aus dem Heuhaufen herauskrabbelst, siehst Du "
                  "eine Heugabel im Raum liegen. Das haette ganz schoen "
                  "schlimm ausgehen koennen, wenn die im Heu gelegen "
                  "haette."));
    return 1;
  }

  if(spass && random(2)==0)
  {
    spass--;
    TELLPLAYER("...iiiiiuuuu.\n");
    TELLPLAYER(BS("Du fuehlst Dich wie ein kleines Kind, als Du im weichen Heu "
                  "landest."));
    TP->AddHp(10+random(5));
    return 1;
  }

  TELLPLAYER("Das war lustig, willst Du's nicht gleich noch einmal probiern?\n");

  return 1;
}
