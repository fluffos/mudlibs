#include "../def.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>

create() {

  ::create();

  SetProp(P_INT_SHORT, "Im Hof");
  SetProp(P_INT_LONG,
    "Du stehst jetzt im Hof vom Bauernhof! Im westlichen Fluegel des Hauses "
    "sind die Wohnraeume der Bauern und im oestlichen Teil sind die Kuh- "
    "und Schweinestaelle von wo auch ein ganz schoen unangenehmer Geruch "
    "herkommt. Etwas seitlich von Dir ist noch ein gemuetlicher Misthaufen. "
    "Jedenfalls waere er gemuetlich wenn du ein Huhn waerst. "
    "Falls es Dir hier zu langweilig wird, kannst "
    "Du nach Norden den Bauernhof betreten, nach Sueden gelangst Du "
    "in den suedlichen Teil des Hofes und nach Osten gehts in den "
    "Schweinestall."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD, ENV_TEMPERATURE:20]));

  AddDetail( ({"seiten", "seite"}),
    "Drei Seiten begrenzen den Hof."
  );

  AddDetail( ({"fluegel"}),
    "Im westlichen Fluegel des Hauses sind die Wohnraeume fuer die "
    "Bauersleut': Kueche, Esszimmer und Schlafraeume."
  );

  AddDetail( ({"hof"}) ,
    "Der Hof wird an drei Seiten vom Bauernhaus begrenzt."
  );

  AddDetail( ({"bauernhof", "bauernhaus", "haus"}),
    "Der Bauernhof ist gross und schoen."
  );

  AddDetail( ({"wohnraeume", "wohnraum"}),
    "Du schaust durch ein Fenster im westlichen Teil des Hauses und siehst "
    "in das Esszimmer hinein."
  );

  AddDetail( ({"esszimmer"}) ,
    "Das Esszimmer kannst Du sehen, wenn Du durch das Fenster im westlichen "
    "Teil des Hauses schaust."
  );

  AddDetail( ({"fenster"}) ,
    "Von hier aus kannst Du nur ein einziges Fenster erreichen und zwar eins "
    "im westlichen Teil des Hauses. Du blickst durch und siehst drinnen das "
    "Esszimmer."
  );

  AddDetail( ({"kuhstall", "schweinestall", "stall", "staelle"}),
    "Die Staelle sind im Osten."
  );

  AddDetail( ({"haufen", "misthaufen"}),
    "Ein schoener schmuddeliger Misthaufen, auf dem sich gerne die Huehner "
    "zum Gackern treffen."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus Schotter, der mit viel Mist, Heu und Stroh "
    "bedeckt ist."
  );

  AddDetail( ({"schotter", "mist", "heu", "stroh"}),
    "Etwas Schotter, etwas Mist, Heu und Stroh liegen einfach so am Boden "
    "herum."
  );

  AddDetail( ({"himmel"}) ,
    "Du hebst den Kopf und schaust Dir den Himmel an. Ist der aber weit oben!"
  );

  AddDetail( ({"ausgang", "ausgaenge"}),
    "Es gibt drei Ausgaenge: Der nach Norden fuehrt in das Bauernhaus hinein, "
    "der nach Sueden in einen weiteren Teil des Hofes und der nach Osten "
    "in den Schweinestall."
  );

  AddDetail( ({"dreck"}) ,
    "Huehner lieben es im Dreck zu scharren."
  );

  AddDetail( ({"wand", "waende"}),
    "Die Waende des Hauses waren einmal weiss, jetzt sind sie aber schon "
    "ziemlich dreckig."
  );

  AddDetail( ({"westlicher fluegel", "westliche fluegel", "westlichen fluegel"}),
    "Im westlichen Fluegel sind die Wohnraeume der Bauern untergebracht."
  );

  AddDetail( ({"oestlicher fluegel", "oestliche fluegel", "oestlichen fluegel",
               "oestlicher teil", "oestlichen teil", "oestliche teil"}),
    "Im oestlichen Teil des Bauernhofes sind die Staelle, dort wohnen "
    "die Schweine und Kuehe der Bauern. Wie Du Dir wahrscheinlich denken "
    "kannst kommt von dort ein etwas unangenehmer Geruch her."
  );

  AddDetail( ({"geruch", "gestenk"}),
    "Wenn Du riechst, kannst Du den Geruch vielleicht etwas besser "
    "untersuchen."
  );

  AddDetail( ({"osten"}),
    "Wenn Du nach Osten gehst, wirst Du in den Schweinestall gelangen"
  );

  AddDetail( ({"norden"}),
    "Geh' nach Norden und Du wirst Dich im Inneren des Bauernhofes "
    "wiederfinden."
  );

  AddDetail( ({"sueden"}),
    "Wenn Du nach Sueden gehst, bist Du noch immer im Hof, nur halt "
    "in einem anderen Teil davon."
  );

  AddSpecialDetail( ({"huehner","hennen","huehnerschar"}), "detail_huehner");

  AddSpecialDetail( ({"tiere"}), "detail_tiere");

  AddSmell(DEFAULT_SMELL,
    "Du riechst den Duft des Misthaufens, der sich mit dem Geruch aus den "
    "Staellen vermischt."
  );

  AddSmell( ({"haufen", "misthaufen"}),
    "Der Misthaufen stinkt."
  );

  AddSmell( ({"stall", "staelle", "schweinestall", "kuhstall"}),
    "Der Geruch aus den Staellen ist nicht sehr einladend."
  );

  AddSmell( ({"mist"}),
    "Warum riechst Du denn am Mist, weisst Du denn nicht, dass der stinkt?");

  AddSound(DEFAULT_SOUND,
    "Du kannst Kuehe muhen und Schweine grunzen hoeren."
  );

  AddSound( ({"kuh", "kuehe"}),
    "Wie macht die Kuh? Die Kuh macht muh!"
  );

  AddSound( ({"schwein", "schweine"}),
    "Du kannst ein Schwein grunzen hoeren: Oink!"
  );

  AddItem(NPC "henne", REFRESH_DESTRUCT);
  AddItem(NPC "henne", REFRESH_DESTRUCT);
  AddItem(NPC "henne", REFRESH_DESTRUCT);
  AddItem(NPC "hahn" , REFRESH_DESTRUCT);

  AddCmd( ({"scharre", "scharr"}), "cmd_scharren" );

  AddExit("norden", ROOM "flur");
  AddExit("sueden", ROOM "hof2");
  AddExit("osten",  ROOM "s_stall1");
}

string anz_huehner(int n)
{
  switch(n)
  {
    case 1 : return "ein Huhn";
    case 2 : return "zwei Huehner";
    default: return "einige Huehner";
  }
}

int cmd_scharren(string str)
{
  notify_fail("Wo willst Du denn scharren?\n");

  if(str!="dreck" && str!="in dreck" && str != "im dreck")
  {
    return 0;
  }

  WRITELOG(TPUID+" scharrt im Dreck");
  TELLPLAYER("Du scharrst ein bisschen im Dreck.\n");
  TELLOTHERS(TPN+" scharrt im Dreck.\n");

  return 1;
}

string detail_huehner(string str)
{
  int huehner;
  string s;

  huehner  = sizeof(filter_objects(all_inventory(TO), "id", "huhn"));

  if(!huehner) return BS("Im Moment befinden sich keine Huehner hier. Wo "
                         "die wohl alle hin sind ?");

  s = (huehner == 1) ? "Es befindet sich " : "Es befinden sich ";

  switch(huehner)
  {
    case 1 :
      s += "ein Huhn";
      break;

    case 2 :
      s += "zwei Huehner";
      break;

    default:
      s += "einige Huehner";
      break;
  }

  s += " hier und scharren im Mist.\n";

  return s;
}

string detail_tiere(string str)
{
  int huehner;
  int katzen;
  int haehne;
  int stat;
  string s;

  huehner  = sizeof(filter_objects(all_inventory(TO), "id", "huhn"));
  katzen = (present("katze",TO)) ? 1 : 0;
  haehne = (present("hahn",TO)) ? 1 : 0;

  stat = 0;
  if(katzen) stat += 1;
  if(haehne) stat += 2;
  if(huehner)stat += 4;

  switch(stat)
  {
    case 0 :
      s = "Es befinden sich keine Tiere hier. Merkwuerdig. "
          "Ein paar Huehner haettest Du schon erwartet.";
      break;

    case 1 :
      s = "Es befindet sich eine Katze hier. Ob die die "
          "ganzen Hennen gefressen hat ?";
      break;

    case 2 :
      s = "Einsam steht der Hahn auf dem Misthaufen. Wo ist bloss "
          "seine gesamte Huehnerschar geblieben?";
      break;

    case 3 :
      s = "Es befinden sich eine Katze und ein Hahn auf hier. Ob die "
          "Katze die Huehner gefressen hat und nun noch hinter dem "
          "Hahn her ist?";
      break;

    case 4 :
      s = "Es "+(huehner > 1 ? "befinden":"befindet")+" sich "
          +anz_huehner(huehner)+" hier auf dem Misthaufen. Von einem "
          "Hahn ist weit und breit keine Spur.";
      break;

    case 5 :
      s = "Es befinden sich "+anz_huehner(huehner)+" und eine Katze "
          "hier auf dem Misthaufen. Von einem Hahn ist weit und breit "
          "keine Spur. Ob die Katze den Hahn gefressen hat?";
      break;

    case 6 :
      s = "Es befinden sich "+anz_huehner(huehner)+" und ein Hahn "
          "hier auf dem Misthaufen.";
      break;

    case 7 :
      s = "Es befinden sich "+anz_huehner(huehner)+", ein Hahn und eine Katze "
          "hier auf dem Misthaufen.";
      break;

    default:
      s = "Es befindet sich ein Bug hier.";
      WRITELOG("Fehler auf dem Bauernhof, Hennen und Haehne zaehlen ging nicht");
      break;
  }

  return BS(s);
}
