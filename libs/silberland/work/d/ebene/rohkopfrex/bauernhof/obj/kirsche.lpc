#include "../def.h"

inherit "/std/food";

#include <properties.h>
#include <food.h>

void create() {
  int r,f,h;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Kirsche");
  SetProp(P_LONG, "Das ist eine schoene rote Kirsche.");
  SetProp(P_NAME, "Kirsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"obst","kirsche"}) );

  SetProp(P_SMELL, "Die Kirsche riecht kirschig. Echt kirschig.");

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);

  r = random(3);
  h = 2+r;
  f = 4+r;

  SetProp(P_FOOD_INFO,
    ([ F_HEAL     : ({ h, h }),
       F_SOAK     : f,
       F_MSG      : "Die Kirsche schmeckt echt lecker.",
       F_MSG_ROOM : "isst eine Kirsche und spuckt Dir anschliessend den "
                    "Kirschkern haarscharf am rechten Ohrlaeppchen vorbei."
     ])
  );

}

