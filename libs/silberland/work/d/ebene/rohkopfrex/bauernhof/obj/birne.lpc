#include "../def.h"

inherit "/std/food" ;

#include <properties.h>
#include <food.h>

void create() {
  int r,f,h;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Birne");
  SetProp(P_LONG, "Das ist eine koestliche Birne.");
  SetProp(P_NAME, "Birne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"obst","birne"}) );

  SetProp(P_SMELL, "Dir laeuft das Wasser im Munde zusammen!" );

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 30);

  r = random(3);
  h = 7+r;
  f = 2+r;

  SetProp(P_FOOD_INFO,
    ([ F_HEAL     : ({ h, h }),
       F_SOAK     : f,
       F_MSG      : "Du isst die Birne und schmatzt dabei.",
       F_MSG_ROOM : "schmatzt beim Birnenessen."
     ])
  );

}

