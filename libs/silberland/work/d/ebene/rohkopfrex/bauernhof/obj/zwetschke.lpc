#include "../def.h"

inherit "/std/food";

#include <properties.h>
#include <food.h>

void create() {
  int r,h,f;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zwetschke");
  SetProp(P_LONG, "Das ist eine koestliche violette Zwetschke.");
  SetProp(P_NAME, "Zwetschke");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"obst","zwetschke","zwetschge"}) );

  SetProp(P_INFO,
    "Das ist eine Zwetschke. Falls Du wirklich nicht weisst, was das ist: "
    "Eine Zwetschke schaut aus wie eine etwas kleinere Pflaume. Und schmeckt "
    "auch so.");

  SetProp(P_SMELL,
    "Der Geruch der Zwetschke erinnert Dich irgendwie an den einer Pflaume.");

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);

  r = random(3);
  h = 1+r;
  f = 4+r;

  SetProp(P_FOOD_INFO,
    ([ F_HEAL     : ({ h, h }),
       F_SOAK     : f,
       F_MSG      : "Du laesst Dir eine Zwetschke schmecken.",
       F_MSG_ROOM : "isst eine Zwetschke und spuckt den Kern auf den Boden."
     ])
  );

}

