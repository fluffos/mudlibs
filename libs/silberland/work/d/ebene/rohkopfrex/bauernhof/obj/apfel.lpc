#include "../def.h"

inherit "/std/food";

#include <properties.h>
#include <food.h>

void create()
{
  int r,h,f;

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein gruener Apfel");
  SetProp(P_LONG, "Das ist ein wunderschoener gruener Apfel.");
  SetProp(P_NAME, "Apfel");
  SetProp(P_GENDER, MALE);
  AddId( ({"obst","apfel"}) );

  SetProp(P_NAME_ADJ, ({"gruen"}) );
  AddAdjective( ({"gruenen","gruener","gruenem","gruenes","gruene"}) );

  SetProp(P_INFO,
    "Essen oder nicht essen, das ist die Frage die Dir der Apfel stellt.");

  SetProp(P_SMELL,
    "Der Apfel riecht nicht sehr stark, aber das ist"
    "wahrscheinlich ein eher guter Zeichen.");

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 70);

  r = random(3);
  h = 6+r;
  f = 3+r;

  SetProp(P_FOOD_INFO,
    ([ F_HEAL     : ({ h, h }),
       F_SOAK     : f,
       F_MSG      : "Du laesst Dir einen Apfel schmecken. HHMMMmmmm!",
       F_MSG_ROOM : "lasst sich einen Apfel schmecken."
     ])
  );

}

