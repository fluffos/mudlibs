#include "../def.h"

inherit "/std/thing";

#include <properties.h>
#include <language.h>

int leben;

void create() {

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine schoene Wiesenblume");
  SetProp(P_LONG,
    "Das ist zwar nur eine schlicht Wiesenblume, aber trotzdem ist sie "
    "wunderschoen. Wahrscheinlich ist es eh gerade ihre Einfachheit, die "
    "Dich so ungemein beeindruckt.");

  SetProp(P_NAME, "Wiesenblume");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "blume", "wiesenblume" }) );

  SetProp(P_WEIGHT, 5);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 20);

  SetProp(P_SMELL, "Die Wiesenblume duftet unheimlich gut.");

  leben = 2;
}

void reset()
{
  object ob;

  ::reset();
  leben--;
  if(!leben)
  {
    if(ob=ENV(TO))
    {
      if(interactive(ob))
      {
        tell_object(ob,"Die Wiesenblume verwelkt.\n");
      }
      else
      {
        tell_room(ob,"Die Wiesenblume verwelkt.\n");
      }
    }
    call_out("remove",0);
  }
}

