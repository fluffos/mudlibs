#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Nudelholz");
  SetProp(P_LONG, BS(
    "Das ist ein Nudelholz, oder besser Nudelwalker. Es ist dazu da um "+
    "irgendwelchen Teig schoen duenn auszurollen"));
  SetProp(P_NAME, "Nudelholz");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"nudelholz", "nudelwalker", "walker"}) );

  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 500);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 70);
  SetProp(P_WC_BONUS, (["sophie":90]) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_WOOD, MAT_IRON );

}




