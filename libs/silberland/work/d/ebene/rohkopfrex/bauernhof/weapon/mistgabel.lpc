#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>


void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Mistgabel");
  SetProp(P_LONG, BS(
    "Eine Mistgabel hat fuenf Zinken, im Gegensatz zu einer Heugabel, welche "+
    "nur drei hat."));
  SetProp(P_NAME, "Mistgabel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"mistgabel", "gabel"}) );

  SetProp(P_VALUE, 700);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 90);
  SetProp(P_WC_BONUS, (["xaver":40]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_WOOD, MAT_IRON}) );

  SetProp(P_SMELL, "Die Mistgabel stinkt nach Mist.\n");
}




