#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Heugabel");
  SetProp(P_LONG, BS(
    "Eine Heugabel hat drei Zinken, im Gegensatz zu einer Mistgabel, welche "+
    "fuenf hat."));
  SetProp(P_NAME, "Heugabel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"heugabel", "gabel"}) );

  SetProp(P_VALUE, 700);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 90);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_WOOD, MAT_IRON}) );

  SetProp(P_SMELL, "An der Heugabel hat sich der Geruch von Heu festgesetzt.\n");
}




