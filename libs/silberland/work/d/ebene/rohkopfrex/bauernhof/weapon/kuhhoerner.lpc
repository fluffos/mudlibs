#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Ein Paar Kuhhoerner");
  SetProp (P_LONG,
    "Die Hoerner einer Kuh koennen auch als Waffe eingesetzt werden.\n");
  SetProp (P_NAME,
    ({"ein Paar Kuhhoerner", "eines Paares Kuhhoerner",
      "einem Paar Kuhhoerner", "ein Paar Kuhhoerner"}));
  SetProp (P_ARTICLE, 0);
  SetProp (P_GENDER, NEUTER);
  AddId( ({ "paar kuhhoerner", "kuhhoerner", "hoerner" }) );

  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 80);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
