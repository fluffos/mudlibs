#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Katzenkralle");
  SetProp(P_LONG, "Die Kralle einer Hauskatze.\n");
  SetProp(P_NAME, "Katzenkralle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"katzenkralle", "kralle"}) );

  SetProp(P_VALUE, 550);
  SetProp(P_WEIGHT, 600);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE, DT_RIP);
  SetProp(P_WC, 75);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_HORN);
}
