#include "../def.h"

inherit "/std/npc";

#include <properties.h>
#include <language.h>

string wurmchat();

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zwergenhahn");
  SetProp(P_LONG,
    "Der Zwergenhahn ist kleiner als die Hennen, aber trotzdem kann er sich "
    "ganz gut behaupten. Er darf den Hennen die Wuermer wegschnappen, aber "
    "keine der Hennen traut sich das bei ihm."
  );

  SetProp(P_NAME, "Hahn");
  SetProp(P_GENDER, MALE);
  AddId( ({"hahn", "zwergenhahn"}) );

  create_default_npc(5);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 25);
  SetProp(P_HEAL, 20);
  SetProp(P_HANDS, ({" mit seinem Schnabel", 35}));
  SetProp(P_ALIGN, 100);

  SetChats( 5, ({
    "Der Hahn kraeht.\n",
    #'wurmchat
  }) );

  SetAttackChats( 5, ({
    "Der Hahn kraeht wie wild.\n"
  }) );
}

void reset()
{
  ::reset();

  if(member(({"06","07","08","09"}),dtime(time())[19 .. 20]) > -1)
  {
    domainshout("Kiiiiikerikiiiiiiiiiiiii\n", APATH, 1);
  }
  return;
}

string wurmchat()
{
  if(ENV(TO) && present("henne",ENV(TO)))
  {
    return "Der Hahn schnappt einer Henne ihren Wurm weg.\n";
  }
  return "Der Hahn pickt nach einem Wurm.\n";
}
/*
die(arg)
{
  WRITELOG("Ein Hahn wurde von "+TPUID+" umgebracht");
  ::die(arg);
}
*/
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Ein Hahn hat gerade "+UID(player)+" umgebracht");
  return;
}


