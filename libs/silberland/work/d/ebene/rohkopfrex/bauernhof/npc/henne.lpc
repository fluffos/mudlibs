#include "../def.h"

inherit "/std/npc";

#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include <combat.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Henne");
  SetProp(P_LONG, "Die Henne laeuft auf dem Misthaufen herum.");
  SetProp(P_NAME, "Henne");
  SetProp(P_GENDER, FEMALE);
  AddId ( ({"henne", "huhn"}) );

  create_default_npc (4);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 25);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,20);
  SetProp(P_BODY, 20);
  SetProp(P_HANDS, ({" mit ihrem Schnabel", 30}));
  SetProp(P_ALIGN, 100);

  SetChats( 5, ({
    "Die Henne gackert.\n",
    "Die Henne scharrt im Dreck.\n"
  }) );

  SetAttackChats( 5, ({
    "Die Henne gackert wie wild.\n"
  }) );

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Eine Henne hat gerade "+UID(player)+" umgebracht");
  return;
}


