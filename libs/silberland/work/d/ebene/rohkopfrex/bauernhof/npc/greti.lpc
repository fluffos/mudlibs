#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Greti, ein Bauernkind");
  SetProp(P_LONG,
    "Das ist Greti. Sie heisst eigentlich Margarete, aber sie mag es "
    "ueberhaupt nicht, wenn sie so genannt wird. Ihr gefaellt Greti oder "
    "Gretl viel besser. Am liebsten laeuft sie auf dem Bauernhof herum und "
    "spielt mit den Tieren oder aergert sie, aber da bekommt sie dann "
    "von ihrem Vater geschimpft. Ein grosses Maedchen wie sie soll sich "
    "anstaendig benehmen und die armen Tiere in Ruhe lassen. Schliesslich "
    "ist sie schon sieben."
  );

  SetProp(P_NAME, "Greti");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  AddId( ({"greti", "gretl", "margarete", "maedchen", "tochter", "kind", "bauernkind"}) );

  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);

  create_default_npc(10);

  SetProp(P_HANDS, ({
    " mit ihren Haenden",
    110,
    DT_BLUDGEON}) );

  AddInfo(DEFAULT_INFO,
    ({ "I derf net mit Dir redn.",
       "Am besten Du frogst mei Mama.",
       "Frog mein Papa, der weiss oiss.",
       "Bist Du wer Fremda?"}),
    "sagt: " );

  AddInfo( "greti", ({
    "I bin di greti.",
    "Warum kennst mi denn du?",
    "Wer bist denn du?"}),
    "sagt: ");
  AddInfo( "gretl",
    "So sagt immer da Papa zu mir.",
    "sagt: ");
  AddInfo( "margarete", ({
    "Nenn mi bitte net so.",
    "MMaerg...",
    "Sei doch stad."}),
    "sagt: ");
  AddInfo( ({"hansi", "hans", "johann"}), ({
    "Der Hansi sekiert mi immer.",
    "Du kennst leicht in Hansi net?",
    "Der Hansi is mei Bruada."}),
    "sagt: ");
  AddInfo( "xaver",
    "So sogt Mama immer zum Papa.",
    "sagt: ");
  AddInfo( ({"papa", "vater", "bauer"}), ({
    "Mein Papa hob i gaunz gern.",
    "Du kennst leicht mein Papa net?",
    "Host du a an Papa?"}),
    "sagt: ");
  AddInfo( "sophie",
    "So sogt da Papa immer zur Mama.",
    "sagt: ");
  AddInfo( "eltern",
    "I hob zwoa Oetern, d Mama und in Papa.",
    "sagt: ");
  AddInfo( ({"mama", "mutter", "baeuerin", "baeurin"}), ({
    "Mei Mamma is die beste Mama vum gaunzn Sueberlaund.",
    "I hab mei Mama soooooo liab."}),
    "sagt. ");
  AddInfo( ({"kuh", "kuehe"}),
    "Da san im Kuastoi.",
    "sagt: ");
  AddInfo( ({"schwein", "schweine"}),
    "Unsere Schweindl grunzn de gaunze Zeit.",
    "sagt: ");
  AddInfo( ({"huhn", "huehner", "henne", "hennen"}),
    "De haum mi schau a paar moi peckt.",
    "sagt: ");
  AddInfo( "katze",
    "D Katz is des liabst Tia vo unsern Bauernhof.",
    "sagt: ");
  AddInfo( ({"hof", "bauernhof"}),
    "Der Bauernhof keat mein Papa.",
    "sagt: ");

  SetChats(2,
    ({ "Greti singt ein Kinderlied.\n",
       "Greti spricht einen Kindervers.\n",
       "Greti dreht sich im Kreis.\n" }) );

  // SetAttackChats

  SetProp(P_DIE_MSG, " faellt weinend zu Boden und ist tot.\n");
  SetProp(P_KILL_MSG, "Warum host mi a net in Ruh g'lassn?\n");

  // SUID;
  // CLONEME
  // command

  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 40, 30, 5 }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hof2" );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS | MOV_INDOORS | MOV_OUTDOORS | MOV_MOVES);

  SetProp(P_MSGIN, "rennt herein");
  SetProp(P_MSGOUT, "rennt");

  SetProp(P_SMELL, "Greti riecht nach Wald und Wiese.\n");

}

void init()
{
  ::init();
  if (TP && TP->id("xaver")) AddDefender(TP);
  if (TP && TP->id("sophie")) AddDefender(TP);
  if (TP && TP->id("hansi")) AddDefender(TP);
}
/*
die(arg)
{
  WRITELOG("Greti wurde von "+TPUID+" umgebracht");
  ::die(arg);
}
*/
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Greti hat gerade "+UID(player)+" umgebracht");
  return;
}


