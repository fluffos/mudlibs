#include "../def.h"
#include OSTERHASE

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>

string hgabel;
string hgarticle;

string cl_heugabel(string frage);
string gabelchat();
string sense();
string leiter();
string milchkanne();

object mkanne;

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Xaver, der Bauer");
  SetProp(P_LONG,
    "Das ist Xaver. Er ist der Bauer, also der Chef vom Bauernhof. Xaver "
    "ist ein sehr netter Mensch, der es aber gar nicht gern hat, wenn "
    "er von seinen wichtigen Pflichten abgehalten wird, oder wenn jemand "
    "seinen Bauernhof durcheinander bringt."
  );

  SetProp(P_NAME, "Xaver");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  AddId( ({"xaver", "bauer", "mann"}) );

  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);

  create_default_npc(18);

  SetProp(P_HANDS, ({" mit zaehen Arbeitshaenden",200,DT_BLUDGEON}) );

  AddInfo(DEFAULT_INFO,
    ({ "Als Bauer hat mas scho schwer, ober schee is a.",
       "Jojo, wos soll i da sagn.",
       "A geh, wost net sagst.",
       "Geh Komm, beruhig di wieda.",
       "Kummt Zeit, kummt Rat.",
       "Jo mei, wos willst denn?" }),
    "sagt: ");

  AddInfo( ({"xaver", "bauer"}), ({
    "Da Xaver des bin i und i bin a da Bauer.",
    "Xaver, so sogn de meisten Leit zu mir.",
    "I bin der Bauer und horch auf den Namen Xaver."}),
    "sagt: ");
  AddInfo( ({"sophie", "baeurin", "baeuerin", "frau", "gattin", "sophal"}), ({
    "Mei Frau, des is di Sophie. De kau guat kochn.",
    "I bin verheirat mit der Sophie.",
    "Meistens nenn is Sophal, obwoi s eigentlich Sophie hoasst."}),
    "sagt: ");
  AddInfo( ({"greti", "gretl", "margarete", "tochter"}), ({
    "S Gretl is mei Tochter.",
    "Hots di leicht sekiert, di Greti. Des kau i fost net glaubn.",
    "D Greti is jo so a liabs Dirndl."}),
    "sagt: ");
  AddInfo( ({"hans", "hansi", "johann", "sohn"}), ({
    "Hot da Hansi leicht schon wieder wos angstoet.",
    "Da Hansi is da Bua von mia und da Sophie.",
    "I bin in Hansi sei Voter."}),
    "sagt: ");
  AddInfo( ({"hof", "bauernhof"}), ({
    "Mei Bauernhof is schau a stoizes Anwesen, stimmts?",
    "Gfeut da mei Bauernhof?"}),
    "sagt: ");
  AddInfo( "mistgabel",
    "De Mistgabl brauch i zum arbeitn.",
    "sagt: ");
  AddInfo( "heugabel",
    #'cl_heugabel,
    "sagt: ");
  AddInfo( "gabel",
    "Wos moanst do jetzt? Wuesst wos essn? Dann frag am besten die Sophie.",
    "sagt: ");
  AddInfo( ({"kuh", "kuehe"}),
    "De Kia stengan im Kuastoi.",
    "sagt: ");
  AddInfo( ({"schwein", "schweine", "sau", "saeue"}),
    "De Schweindl stengan im Saustoi.",
    "sagt: ");
  AddInfo( ({"huhn", "huehner", "henne", "hennen"}),
    "De Hendl rennan meistens aum Misthaufn umanaunda.",
    "sagt: ");
  AddInfo( ({"hahn", "zwerghahn", "zwergenhahn"}),
    "Wos kau i scho vuel ueber den Gickerl sogn?",
    "sagt: ");
  AddInfo( ({"katze", "katzen"}),
    "Mia hobn a a Katz aum Hof.",
    "sagt: ");
  AddInfo( ({"stadl", "heustadl"}),
    "Der Heistadl steht a bisserl abseits vum Hof auf der Wiesn.",
    "sagt. ");
  AddInfo( ({"schemel","melkschemel","moekschermerl"}) ,
    "Mei Moekschermerl is hinig i muss ma erst an neichen "
    "besurgn." );

  AddInfo( ({"sense"}),
    #'sense, "sagt: ");
  AddInfo( ({"leiter"}),
    #'leiter, "sagt: ");
  AddInfo( ({"kanne","milchkanne","muelipitschn"}),
    #'milchkanne, "sagt: ");

  SetChats(2,
    ({ "Xaver pfeift eine froehliche Melodie.\n",
       "Xaver schneuzt sich.\n",
       "Xaver raeuspert sich.\n",
       #'gabelchat
     }) );

  SetProp(P_DIE_MSG, " faellt um und ist tot.\n");
  SetProp(P_KILL_MSG, "Jojo, s' Lebn is hoat.\n");

  SUID;
  CLONEME(WEAPON "mistgabel" );
  CLONEME(ARMOUR "arbeitshemd" );
  CLONEME("/p/armour/boots/lederstiefel");
  mkanne = clone_object(OBJ "milchkanne");
  mkanne->move(TO,M_NOCHECK);
  command("zuecke mistgabel");
  command("zieh arbeitshemd an");
  command("zieh lederstiefel an");

  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({60, 45, 30}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "flur" );
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_OUTDOORS | MOV_MOVES);

  SetProp(P_SMELL, "Xaver riecht nach Bauernhof.\n");

  hgabel="";

}

void reset()
{
  object obj;

  ::reset();

  if (obj=present("heugabel",TO)) obj->remove();
  hgabel="";

  if(mkanne == 0)
  {
    mkanne = clone_object(OBJ "milchkanne");
    mkanne->move(TO,M_NOCHECK);
  }
}

string cl_heugabel(string frage)
{
  if(hgabel=="")
    return "De Heigabl muass i irgendwo verlegt habn, aber zur Not kann i eh d "
      "Mistgabl nehma.";

  if(TPUID==hgabel)
    return "De Heigabl de host ma jo eh Du gebracht. Host leicht glaubt i "
      "hab di vergessen?";

  return "De Heigabl hat mir "+hgarticle+hgabel+" gebracht. "
    "Des war a ganz sche nette Geste!";
}

give_notify(object obj)
{
  if (obj->id("heugabel"))
  {
    if (hgabel!="")
    {
      if (TPUID==hgabel)
      {
        command("sag I hob mei Heigabl schon. De hast mir ja eh Du "
          "selber gebracht.\n");
      }
      else
      {
        command("sag I hob mei Heigabl schon. De hat mir "+hgarticle+hgabel+
          " gegebn.\n");
      }

      obj->move(TP, M_GIVE|M_NOCHECK);
      TELLPLAYER("Xaver gibt Dir die Heugabel wieder zurueck.\n");
      TELLOTHERS("Xaver gibt "+TPN+" eine Heugabel.\n");
      return 1;
    }

    WRITELOG(TPUID+" gibt Xaver die Heugabel");
    hgabel=TPUID; hgarticle=TP->QueryArticle(WER, 1, 1);
    command("sag Jessas! De Heigabl hab i eh scho lang gnuag g'suacht. "
        "Du bist "+hgarticle+hgabel+", gell? Di muass i mir merken.\n");

    TELLPLAYER(BS("Du freust Dich so sehr ueber diese selbstlose Tat, dass Dir "
                  "richtig warm ums Herz wird."));
    TP->AddHp(30);
    return 1;
  }

  return ::give_notify(obj);
}

string sense()
{
  object ob;
  string s;

  if( present(OSTERHASENQUEST_ID, TP) && !present(OSTERHASENQUEST_SENSE, TP) )
  {
    ob = clone_object(OSTERHASENQUEST_DIR "sense");
    ob->SetProp(P_NODROP,0);

    if(ME_TOO_HEAVY==ob->move(TP, M_GIVE|M_SILENT))
    {
      s = "Na geh, des konnst Du jo goar nimma trogn, Du Zniachtl, "
          "des is jo vue zu schwa fia di!";
      ob->remove();
    }
    else
    {
      s = "I boarg Da mei Sensn.";
      ob->SetProp(P_NODROP,1);
      WRITELOG(TPUID+" kriegt von Xaver die Sense");
    }
  }
  else
  {
    s = "Zu wos brauchst denn Du a Sensn?";
  }
  return s;
}

string milchkanne()
{
  object ob;
  string s;

  if(mkanne == 0)
  {
    s = "Meine Muelibitsch brauch i soewa.";
    return s;
  }

  if(TP->QueryMoney() < 200)
  {
    s = "Fuea mei Muelipitschn, do kriag i oba 200 Bresln von Dia, sovue "
        "host jo goa net mit. Host nix, oft griagst nix! ";
    return s;
  }

  if(ME_TOO_HEAVY==mkanne->move(TP, M_GIVE|M_SILENT))
  {
    s = "Na geh, des konnst Du jo goar nimma trogn, Du Zniachtl, "
        "des is jo vue zu schwa fia di!";
  }
  else
  {
    tell_object(TP,"Xaver gibt Dir die Milchkanne.\n");
    s = "I geb Da mei Muelipitschn, do kriag i oba 200 Bresln von Dia.";
    TP->AddMoney(-200);
    mkanne = 0;
    WRITELOG(TPUID+" kriegt von Xaver die Milchkanne");
  }

  return s;
}

string leiter()
{
  object ob;
  string s;

  if( present(OSTERHASENQUEST_ID, TP) && !present( OSTERHASENQUEST_LEITER, TP) )
  {
    ob = clone_object(OSTERHASENQUEST_DIR "leiter");
    ob->SetProp(P_NODROP,0);

    if(ME_TOO_HEAVY==ob->move(TP, M_GIVE|M_SILENT))
    {
      s = "Na geh, des konnst Du jo goar nimma trogn, Du Zniachtl, "
          "des is jo vue zu schwa fia di!";
      ob->remove();
    }
    else
    {
      s = "I boarg Da mei Loata.";
      ob->SetProp(P_NODROP,1);
      WRITELOG(TPUID+" kriegt von Xaver die Leiter");
    }
  }
  else
  {
    s = "Im Heistadl steht a Loata.";
  }
  return s;
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
/*
die(arg)
{
  WRITELOG("Xaver wurde von "+TPUID+" umgebracht");
  ::die(arg);
}
*/
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Xaver hat gerade "+UID(player)+" umgebracht");
  return;
}

string gabelchat()
{
  if(hgabel != "")
  {
    return "Xaver brummelt: Wo hob i denn mei Heigabl liegn lossn?\n";
  }
  else
  {
    return "Xaver kratzt sich am Hintern.\n";
  }

}
