#include "../def.h"

inherit "/std/npc";

#include <properties.h>
#include <language.h>

void create() {

  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schwein");
  SetProp(P_LONG, "Ein Schwein das sich ein bisschen im Dreck waelzt.");
  SetProp(P_NAME, "Schwein");
  SetProp(P_GENDER, NEUTER);
  AddId("schwein");

  create_default_npc (10);
  SetProp(P_RACE, "Schwein");
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_BODY, 40);
  SetProp(P_SIZE, 60);
  SetProp(P_HANDS, ({" mit seinen Schweinshaxen", 55}));
  SetProp(P_ALIGN, 100);
  SetProp(P_XP, 35000);

  SetProp(P_SMELL, "Du schnupperst an einem Schwein, und es stinkt.\n");
  SetProp(P_SOUND, "Du lauschst an einem Schwein, aber genau jetzt gibt es keinen "
                   "Laut von sich.\n");

  SetChats(5, ({
    "Das Schwein grunzt.\n",
    "Das Schwein macht: Oink!\n" }) );
  SetAttackChats(5, ({
    "Das Schwein grunzt wild.\n",
    "Das Schwein grunzt Dich ganz veraergert an.\n"}) );

}
/*
die(arg)
{
  WRITELOG("Ein Schwein wurde von "+TPUID+" umgebracht");
  ::die(arg);
}
*/
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Ein Schwein hat gerade "+UID(player)+" umgebracht");
  return;
}


