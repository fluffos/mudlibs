#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

string info_essen(string str);

int essen;

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Sophie, die Baeurin");
  SetProp(P_LONG,
    "Sophie, oder Soffal, wie sie von Xaver, ihrem Mann genannt wird, ist "
    "die Baeurin. Ihr grosse Leidenschaft ist das Kochen, und auch das "
    "Essen ihrer selbstgekochten Speisen, wie man leicht an ihrem "
    "vollschlanken Koerperbau erkennen kann. Normalerweise ist sie eine "
    "sehr gemuetliche Frau, aber wehe, wenn ihr jemand in der Kueche "
    "dreinpfuschen will, dann kann sie auch zur Furie werden."
  );

  SetProp(P_NAME, "Sophie");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  AddId( ({"sophie", "soffal", "sophal", "frau", "baeurin", "baeuerin"}) );

  SetProp(P_SIZE, 165);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);

  create_default_npc(17);

  SetProp(P_HANDS, ({" mit ihren blossen Haenden",160,DT_BLUDGEON}) );

  AddInfo(DEFAULT_INFO,
    ({ "Geh wos redst denn so vuel?",
       "Mei bist du liab.",
       "Do fragst am besten den Xaver.",
       "So jung und will scho so viel wissn!" }),
    "sagt: ");
  AddInfo( ({"essen", "apfel", "aepfel", "birne", "birnen", "kirsche",
             "kirschen", "zwetschken", "zwetschke","zwetschge","zwetschgen"}),
    #'info_essen,
    "sagt: ");
  AddInfo( "obst", ({
    "Mia baun unser Obst selber an.",
    "Des natuerliche Obst vum Bauernhof is am gsuendesten." }),
    "sagt: ");
  AddInfo( ({"xaver", "bauer"}), ({
    "Da Xaver is mei Mann, er is der beste Bauer weit und breit.",
    "I hob eam so liab, den Xaver.",
    "Der Xaver is da Bauer, i bin sei Frau, di Baeurin." }),
    "sagt: ");
  AddInfo( ({"sophie", "baeuerin", "baeurin"}), ({
    "Soll i mi vorstelln? I bin di Sophie, die Bauerin vun dem Bauernhof.",
    "Sophie hoass i, und i bin di Baeurin vun do." }),
    "sagt:");
  AddInfo( ({"hans", "johann", "hansi", "bub", "bua", "sohn"}), ({
    "Hansi, so hoasst mei Bua.",
    "Hi und do kann ea a richtiga Lauser sei, der Hansi. Aber eigentlich "+
    "is er do a liaber Bua."}),
    "sagt: ");
  AddInfo( ({"margarete", "greti", "tochter", "maedchen", "diandl"}), ({
    "D' Greti is mei Tochter.",
    "Goi, sie is schau a liabs Diandl, die Greti.",
    "Host as schau troffn, die Greti. Na hoffentlich hots di net geagat."}),
    "sagt: ");
  AddInfo( ({"hof", "bauernhof", "bauernhof"}), ({
    "Gfeut a da, unser Bauernhof?",
    "Jo do bin i schon a bissal stolz drauf, auf unsern Bauernhof."}),
    "sagt: ");
  AddInfo( ({"kuh", "kuehe"}),
    "Glaubst de Kia rennan im Haus umanaunda? De san natuerli im Kuastoi.",
    "sagt: ");
  AddInfo( ({"schwein", "schweine", "sau", "saeue"}),
    "De Schweindl san im Saustoi.",
    "sagt: ");
  AddInfo( ({"huhn", "huehner", "henne", "hennen"}),
    "De Hendl suachan immer nua Wirma aufn Misthaufn.",
    "sagt: ");
  AddInfo( "hahn",
    "Der Gickerl weckt uns jeden Tog in der Fria auf.",
    "sagt: ");
  AddInfo( "schuerze",
    "De Schiazn is schau gaunz sche dreckig, stimmts?",
    "sagt: ");
  AddInfo( ({"nudelholz", "nudelwalker"}),
    "Den Nudlwalker brauch i zum Toag ausrolln.",
    "sagt: ");
  AddInfo( ({"kind", "kinder"}),
    "Unsere Kinder rennan den gaunzn Tog draussn umadum.",
    "sagt: ");

  SetChats(2,
    ({ "Sophie wischt sich die Haende in ihrer Schuerze ab.\n",
        "Sophie singt ein lustiges Lied.\n",
        "Sophie richtet sich ihre Haare.\n",
        "Sophie laechlet Dich muetterlich an.\n",
        "Sophie sagt: Wird Zeit, dass i wos koch'.\n"}) );

  SetProp(P_DIE_MSG, " stirbt mit einem Seufzen auf den Lippen.\n");
  SetProp(P_KILL_MSG, "A kurz Lebn kann jo a sche sei!\n");

  SUID;
  CLONEME(WEAPON "nudelholz" );
  CLONEME(ARMOUR "schuerze" );
  command("zuecke nudelholz");
  command("zieh schuerze an");

  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({60, 60, 15}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "kueche" );
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "verschwindet");

  SetProp(P_SMELL, "Sophie riecht nach koestlichem Essen.\n");

  essen=5;

}

void reset()
{
  ::reset();
  essen=5;
}

string gib_essen(string s, string msg,object player)
{
  object obj;
  string str;

  obj=clone_object(OBJ+s);

  if(ME_TOO_HEAVY==obj->move(player,M_GIVE|M_SILENT))
  {
    str = "Leg amal wos ab, wal des kannst nimma daheben!";
    obj->remove();
  }
  else
  {
    str = msg;
    essen--;
    WRITELOG(TPUID+" kriegt von Sophie "+s);
  }

  return BS(str);
}

string info_essen(string str)
{
  string s;

  s = "";

  if(ENV(TO) == find_object(ROOM "speiss" ))
  {
    if(TP->FindPotion("Sophie sagt: I glaub fost des magst liaber.\n")) return s;

    switch (str)
    {
      case "essen":
        return "Wos wuesst denn zum Essen?";

      case "apfel":
      case "aepfel":
        if (essen && !random(2))
        {
          s = gib_essen("apfel","Na guat, do nimm den Apfel und lass dan guat schmeckn.",TP);
        }
        else
        {
          s = "Du Bettler du! Schau dass'd weiter kummst.";
        }
        break;

      case "birne":
      case "birnen":
        if(essen && !random(2))
        {
          s = gib_essen("birne","Do hast dein Birn.",TP);
        }
        else
        {
          s = "Aber schau do! So vuel Obst hob i jo eh nimma.";
        }
        break;

      case "zwetschke":
      case "zwetschken":
      case "zwetschge":
      case "zwetschgen":
        if(essen && !random(2))
        {
          s = gib_essen("zwetschke",
                        "Weisst schon so verhungert ausschaust, kriagst a Zwetschkn "
                        "vun mir.",TP);
        }
        else
        {
          s = "Waunst a Zwetschkn wuellst, dann kauf da eine in an Gscheft.";
        }
        break;

      case "kirsche":
      case "kirschen":
        if(essen && !random(2))
        {
          s = gib_essen("kirsche","Da host, aber verschluck di net.",TP);
        }
        else
        {
          s = "Na i gib da koa Kirschn.";
        }
        break;
    }
    return BS(s);
  }

  switch (str)
  {
    case "essen":
      return
        "Fuer des Essen bin i zuastaendig und des is a guat so. "+
        "Soll i da wos sagn? Einmol hat der Xaver kocht, aber des hot "+
        "dann kana essen kinna. Pfui Teufoe!";
    case "apfel":
    case "aepfel":
      return
        "In da speiss habn ma sicher nu a paar Aepfel liegn.";
    case "birne":
    case "birnen":
      return
        "A Birn wuest? Jetzt hab i grad koane do, aber in da Speiss "+
        "lign sicher nu a paar";
    case "kirsche":
    case "kirschen":
      return
        "Zu de Kirschen muass i da wos sagn: Du muasst immer gut "
        "aufpassn, dass d Kern net schluckst, weil sunst kanns "
        "leicht passiern, dass da a Kirschbaum aus Bauch aussawochst. Haha!";
    case "zwetschke":
    case "zwetschken":
    case "zwetschge":
    case "zwetschgen":
      return
        "Es gibt Leit, de glaubn, dass Zwetschkn und Pflaumen, des gleiche "
        "is. Aba des stimmt net: Zwetschkn san a bissal kleiner als wie Zwetschkn.";
  }

  return "Jo wos soll i do dazua sogn?";

}

void init()
{
  ::init();
  if (TP && TP->id("xaver")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
/*
die(arg)
{
  WRITELOG("Sophie wurde von "+TPUID+" umgebracht");
  ::die(arg);
}
*/
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Sophie hat gerade "+UID(player)+" umgebracht");
  return;
}


