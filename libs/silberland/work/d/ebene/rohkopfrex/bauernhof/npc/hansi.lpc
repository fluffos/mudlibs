/* hansi.c
 * hansi, der sohn
 *
 * rohkopfrex@silberland.c
 *
 * ??.5.1997
 */

#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hansi, ein Bauernkind");
  SetProp(P_LONG,
    "Das ist der Hansi. Eigentlich heisst er ja Johann, aber wer will "
    "zu einem neunjaehrigen Buben schon Johann sagen? Darum nennen ihn "
    "alle Hansi oder Hansl. Nur wenn er was angestellt hat, dann kann "
    "man sein Mutter rufen hoeren: \"Johann! Aber sofort kummst her "+
    "zu mia!\" Und das kommt oefter vor, als man glaubt. Auch wenn er auf "
    "den ersten Blick wie ein kleiner Engel ausschaut, in Wirklichkeit "
    "ist er der groesste Lausbub, der da in der Gegend herumlaeuft."
  );
  SetProp(P_NAME, "Hansi");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  AddId( ({"johann","hans","hansi","hansl","bub","junge","sohn","bauernkind","kind"}) );

  SetProp(P_SIZE, 130);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);

  create_default_npc(13);

  SetProp(P_HANDS, ({
    " mit seinen Lausbubenhaenden",
    150,
    DT_BLUDGEON}) );

  AddInfo(DEFAULT_INFO,
    ({ "I sog Dir nix.",
       "Bae!",
       "Faung mi halt, wennst kannst.",
       "Haha, des sog i Dir net.",
       "Los mi in Ruh!" }),
    "sagt: " );

  AddInfo( ({"hans", "hansi"}), ({
    "I bin da Hansi. Und wea bist du?",
    "So hoass i. Aber jetzt loss mi in Rua."}),
    "sagt: ");
  AddInfo( "johann", ({
    "I hobs vuel liaber wennst mi Hansi nennst.",
    "I mog net, dasst mi Johann nennst.",
    "Den Naum mog i net so gern."}),
    "sagt: ");
  AddInfo( ({"greti", "gretl", "margarete"}), ({
    "De Greti geht immer schergaln.",
    "Des is mei kloane Schwester.",
    "Hots da leicht gsogt, wos i dau hob?"}),
    "sagt: ");
  AddInfo( ({"xaver", "bauer", "vater", "papa"}), ({
    "Du kennst leicht mein Papa?",
    "Kennst du wirklich mein Papa?",
    "Mei Papa hoasst Xaver."}),
    "sagt: ");
  AddInfo( ({"sophie", "baeurin", "baeuerin", "mutter", "mama"}),
    "Mei Mama hoasst Sophie.",
    "sagt: ");
  AddInfo( ({"kuh", "kuehe", "schwein", "schweine", "hahn", "huhn",
              "huehner", "henne", "hennen", "tiere", "katze"}), ({
    "Mia hobn a Haufn Viecher auf unsern Bauernhof.",
    "Host du scho olle Tiere gseng, de mia haum?",
    "So vue Viecha, wia mia, hot sunst koana!"}),
    "sagt: ");
  AddInfo( ({"bauernhof", "hof"}),
    "Der Bauernhof keat mia, mein Papa und meiner Mama.",
    "sagt: ");
  AddInfo( ({"messer", "taschenmesser"}),
    "Des hob i zum Geburtstog gschenkt kriagt.",
    "sagt: ");

  SetChats(2,
    ({ "Hansi sagt: Host Du a Schwert?\n",
       "Hansi bohrt in der Nase.\n",
       "Hansi streckt Dir die Zunge raus.\n",
       "Hansi zeigt Dir den Vogel.\n",
       "Hansi isst einen Nasenmann.\n"}) );

  // SetAttackChats

  SetProp(P_DIE_MSG, " faellt weinend zu Boden und ist tot.\n");
  SetProp(P_KILL_MSG, "Ha Ha!\n");

  SUID;
  CLONEME("/d/ebene/obj/waffe/taschenmesser");
  command("zuecke taschenmesser");

  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 40, 30, 5 }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hof2" );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS | MOV_INDOORS | MOV_OUTDOORS | MOV_MOVES);

  SetProp(P_MSGIN, "rennt herein");
  SetProp(P_MSGOUT, "rennt");

  SetProp(P_SMELL, "Hansi riecht nach Wald und Wiese.\n");

}

void init()
{
  ::init();
  if (TP && TP->id("sophie")) AddDefender(TP);
  if (TP && TP->id("xaver")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
/*
die(arg)
{
  WRITELOG("Hansi wurde von "+TPUID+" umgebracht");
  ::die(arg);
}
*/
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Hansi hat gerade "+UID(player)+" umgebracht");
  return;
}


