#include "../def.h"

inherit "/std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>

void create() {

  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine Kuh");
  SetProp(P_LONG,
      "Du erblickst eine " +
      ({ "grosse kraeftige", "kleine schmaechtige", "suesse kleine",
         "mittelgrosse", "ziemlich starke" })[random(5)] +
      " Kuh, die nicht gerade gescheit dreinschaut. Ihr Fell ist " +
      ({ "schwarz-weiss gescheckt", "dunkelbraun", "weiss" })[random(3)] +
      ", und sie scheint vom Bauern auch recht gut gepflegt zu werden. "
      "Ausserdem hat sie zwei kraeftige Hoerner auf ihrem Kopf, die "
      "ihr im Zweifelsfall doch schnell Respekt verschaffen koennen.");
  SetProp(P_NAME, "Kuh");
  SetProp(P_GENDER, FEMALE);
  AddId("kuh");

  create_default_npc (10);
  SetProp(P_RACE, "Rind");
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 120);
  SetProp(P_HANDS, ({" mit ihren Hoernern", 65, DT_PIERCE}));
  SetProp(P_ALIGN, 100);
  SetProp(P_XP, 45000);

  SetChats(5, ({
    "Die Kuh macht: Muh!\n",
    "Die Kuh wackelt mit ihrem Euter.\n",
    "Die Kuh peitscht mit ihrem Schwanz ein paar Fliegen weg.\n",
    "Die Kuh tritt Dir fast auf die Zehen.\n",
    "Die Kuh glotzt Dich aus ihren grossen Augen verwundert an.\n",
  }) );

  SetAttackChats(5, ({
    "Die Kuh schaut Dich ganz boese an.\n"
  }) );

  AddCmd( ({"melk","melke"})      , "cmd_melken");

  SUID;
  CLONEME(WEAPON "kuhhoerner" );
  command("zuecke hoerner");
}
/*
die(arg)
{
  WRITELOG("Eine Kuh wurde von "+TPUID+" umgebracht");
  ::die(arg);
}
*/
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG("Eine Kuh hat gerade "+UID(player)+" umgebracht");
  return;
}

int cmd_melken(string str)
{
  notify_fail("Was moechtest Du melken?\n");

  if(!str || str == "") return 0;
  if(!(str == "kuh"         ||
       str == "kuehe"       )) return 0;


  if(!present("milchkanne",TP))
  {
    TELLPLAYER("Du hast ja gar keine Milchkanne dabei.\n");
    return 1;
  }

  if(!present("melkschemel",TP))
  {
    TELLPLAYER("Du hast ja gar keinen Melkschemel dabei.\n");
    return 1;
  }

  TELLPLAYER("Diese Kuh wurde gerade erst gemolken, ihr Euter ist total "
             "leer.\n");

  return 1;
}


