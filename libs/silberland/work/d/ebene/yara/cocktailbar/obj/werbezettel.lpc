#include "../def.h"

inherit "/std/thing";

//////////////////////////////////////////////////////////////////////////////
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Werbeprospekt");
  SetProp(P_LONG, "Das Werbeprospekt verkuendet mit bunten Buchstaben die "
    "Neueroeffnung des Las Midas. Der Hintergrund zeigt Palmen, tropische "
    "Fruechte und einen Sonnenuntergang. Du kannst es lesen." );

//  SetProp(P_INFO, "");
  SetProp(P_NAME, "Werbeprospekt");
  SetProp(P_GENDER, NEUTER);
  AddId(({"\ny_lasmidaszettel","werbeprospekt","werbezettel",
    "zettel","prospekt"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 0);

  AddDetail(({"buchstaben"}), "Mit grossen bunten Buchstaben wird die "
    "Neueroeffnung des Las Midas verkuendet.");
  AddDetail(({"neueroeffnung"}), "Klingt interessant.");
  AddDetail(({"las midas"}), "Das scheint eine Cocktailbar zu sein.");
  AddDetail(({"palmen","fruechte","tropische fruechte","sonnenuntergang",
    "hintergrund"}), "Der Hintergrund des Prospekts zeigt Palmen und "
    "Fruechte vor einem Sonnenuntergang.");

  AddReadDetail(({"buchstaben","prospekt","werbeprospekt"}),
"\n             * * * * * * * * * * * * * * * * * * * * * * * * * *\n" 
"             *                                                 *\n"
"             *     \\                 |                 /       *\n"
"             *                                                 *\n"
"             *       \\      L A S   ~   M I D A S    /         *\n"
"             *                                                 *\n"
"             *         \\                           /           *\n"
"             *                  NEUEROEFFNUNG                  *\n"
"             *           \\                       /             *\n"
"             *      _  _                                       *\n"
"             *     _ \\/ __ \\         |         /               *\n"
"             *    /_\\ |/\\_\\                                    *\n"
"             *   ____\\|____  \\   _ _ _ _ _   /                 *\n"
"             *  / / \\ | /\\ \\   _/         \\_    _  _           *\n"
"             * /_/ _ \\|/ _\\_\\ |             |  _ \\/ _    __   _*\n"
"             *       / \\     |               |/_\\ |/\\_\\        *\n"
"             *       | |    |                 |__\\|____        *\n"
"             *       | |    |                / / \\| /\\ \\       *\n"
"             *~~~~~~~| |~~~~~~~~~~~~~~~~~~~~/_/~~\\|/~~\\_\\~~~~~~*\n"
"             *  ~~~  | |      ~~~~     ~~~~~~    / \\      ~~~~~*\n"
"             *    ~~ | |~~~       ~~~~~      ~~~~| |   ~~~     *\n"
"             *~~~~~~~| |~~~~~~~~~~~~~~~~~~~~~~~~~| |~~~~~~~~~~~*\n"
