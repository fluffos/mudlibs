** 2005-12-13  1.0  Yara  initial version
*/

inherit "/std/thing";
#include "../def.h"

mapping oelMap;
string oel; //art des oels

create() {
  ::create();
  if(!is_clone(TO)) return;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId(({"oel","massageoel","\ny_oel"}));
  SetProp (P_NAME, "Oel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NODROP,"");
//Das Oel ist unsichtbar im Player und verschwindet auch wenn es nicht benutzt wird
  call_out("verschwinde", 600);

  oelMap = ([
    "antistressoel":
      "Deine Haut kribbelt leicht.\n";
      "Du faengst an, den Alltag zu vergessen.\n";
      "Das Oel fuehlt sich gut an auf Deiner Haut.\n";
      "Der Duft des Oels entspannt Dich.\n";
      "Du nimmst den sanften Duft des Oels wahr.\n";
      "Aller Stress faellt von Dir ab.\n",
    
    "entspannungsoel":
      "Du fuehlst Dich leicht und unbeschwert.\n";
      "Lavendel- und Orangenduft umhuellt Dich.\n";
      "Deine Verspannungen loesen sich.\n";
      "Du nimmst den sanften Duft des Oels wahr.\n";
      "Du bist die Ruhe selbst.\n";
      "Zarter Duft umschwebt Dich.\n",
        
    "drachenoel":    
      "Du glaubst Eukalyptus und Lavendel zu riechen.\n";
      "Das Drachenoel riecht angenehm - ganz und gar nicht nach Drache.\n";
      "Deine Haut wird ganz warm von dem Drachenoel.\n";
      "Deine Muskeln entspannen sich langsam.\n";
      "Der Duft des Drachenoels steigt Dir in die Nase.\n";
      "Das Oel erfrischt Dich und verwoehnt Deine Haut.\n",
    
    "mondoel":
      "Du spuerst die wohltuende Wirkung der Massage.\n";
      "Du nimmst den sanften Duft des Oels wahr.\n";
      "Der Duft des Oels heitert Dich auf.\n";
      "Durch einen leichten Luftzug nimmst Du das kuehlende Oel auf Deiner Haut wahr.\n";
      "Du fuehlst Dich entspannt und im Einklang mit Dir selbst.\n";
      "Das Oel entspannt Deinen Koerper und Deine Sinne.\n",
    
    "orientoel":    
      "Das Oel riecht geheimnisvoll und suess.\n";
      "Ein fremder Duft umgibt Dich, Du kannst ihn nicht genau bestimmen.\n";
      "Du wirst von exotischen Dueften eingehuellt.\n";
      "Deine Seele begibt sich in voellige Harmonie mit deinem Koerper und deinem Geist.\n";
      "Der Duft von Jasmin steigt Dir in die Nase.\n";
      "Du faengst an, Dich nach fremden Laendern zu sehnen.\n",
    
    "duftoel":
      "Du denkst Dir: Ein bisschen weniger Duft haette es auch getan...\n";
      "Das Massageoel duftet betoerend.\n";
      "Das Oel prickelt auf Deiner Haut.\n";
      "Du riechst Veilchen, oder Flieder? Du kannst es nicht genau bestimmen.\n";
      "Der Duft von Jasmin steigt Dir in die Nase.\n";
      "Du riechst nach Rosen.\n"
  ]);
}


string getOel() {return oel;}
void setOel(string str) {oel = str; SetProp(P_NAME, capitalize(oel));}
void verdufte() {write("Der Duft laesst nach.\n"); TO->remove();}
//ohne duft verschwinden
void verschwinde() {TO->remove();}

void dufte() {
    remove_call_out("verschwinde");
    call_out("dufte1", random(15)+5);
    call_out("verdufte", 360);
}

void dufte1() {
    int i;
    i = random(5);
    write( oelMap[oel,i] ); //zufaellige Duftmeldung
    call_out("dufte1", 5+random(50));
}