/*
** Ein Massagetuch  Yara@SL
** ---
** 2005-12-13  1.0  Yara  initial version
*/


inherit "/std/armour";
#include "../def.h"

create() {
  ::create();
  if(!is_clone(TO)) return 0;

  AddId(({"massagetuch","tuch","\ny_tuch"}));
  SetProp(P_SHORT, "Ein flauschiges Tuch");
  SetProp(P_LONG, "Ein flauschiges grosses Tuch. "
      "Es ist bluetenweiss und duftet nach Rosen. ");

  SetProp (P_NAME, "Tuch");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 200);
  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_MATERIAL, ([ MAT_CLOTH:100]));
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WEIGHT, 200);
  SetProp(P_NAME_ADJ, "flauschig");
  AddAdjective(({"flauschiges","flauschig"}));
  SetProp(P_SMELL,"Zarter Rosenduft. "
      "Das war bestimmt kein billiges Waschmittel.\n");

  SetProp(P_WEAR_TEXT, ({"Du bindest ein flauschiges Tuch um.\n",
                          " bindet ein flauschiges Tuch um.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({"Du loest ein flauschiges Tuch.\n",
                            " loest ein flauschiges Tuch.\n" }) );
  SetProp(P_WORN_TEXT, "umgebunden" );
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());

  AddCmd(({"binde","bind"}), "cmdBinde");
  AddCmd(({"loese","loes"}), "cmdLoese");
}
  
int cmdBinde(string str) {
  notify_fail("Was willst Du umbinden?\n");
  if(str!="tuch um" && str!="flauschiges tuch um") return 0;

  if(QueryWorn()) {
    write("Du hast schon ein Tuch umgebunden.\n");
    return -1;
  }
  if(DoWear()==0) return 0;
  return 1;
}

int cmdLoese(string str) {
  notify_fail("Was willst Du loesen?\n");
  if(str!="tuch" && str!="flauschiges tuch") return 0;

  if(!QueryWorn()) {
    write("Du hast das Tuch gar nicht umgebunden.\n");
    return -1;
  }
  if(DoUnwear()==0) return 0;
  return 1;
}

int WearFunc(object me) {
  if(TP->QueryProp(P_GENDER)!=FEMALE)
    SetProp(P_EXTRA_LOOK, TP->Name() + " traegt ein flauschiges Tuch, "
      "welches seine feminine Seite unterstuetzt.\n");
  else
    SetProp(P_EXTRA_LOOK, TP->Name() + " traegt ein flauschiges Tuch.\n");
  return 1;
}

int RemoveFunc(object me) {
  SetProp(P_EXTRA_LOOK, 0);
  return 1;
}