#include "../def.h"

inherit "std/container";
#include <container.h>

void create() {
//  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Theke");
  SetProp(P_LONG,
    "Eine einfache Theke. Sie verlaeuft in einem elegantem Bogen und "
    "hat eine gruenlich schimmernde Oberseite. Du kannst Deinen "
    "Cocktail darauf abstellen. Vor der Theke stehen einige "
    "Barhocker." );
  SetProp(P_NAME, "Theke");
//  SetProp(P_NOGET, 1);
  SetProp(P_MAX_WEIGHT, 1000000);
  AddId(({"theke","\ny_theke"}));
}

varargs string long()
{
  string descr, inv_descr;

  descr = process_string(QueryProp(P_LONG));
  inv_descr = make_invlist(PL, all_inventory(ME), 0);

  if (stringp(inv_descr) && strlen(inv_descr))
    descr += "Darauf siehst Du:\n" + inv_descr;

  return descr;
}
