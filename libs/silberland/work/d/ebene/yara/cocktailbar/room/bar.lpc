//////////////////////////////////////////////////////////////////////////////
// sorgt dafuer, dass nur anwesende player auf den barhockern sitzen
void m_init(){
  int i;
  object* ob;
  ob = getSeats()->getSittingPlayers();

  for(i=0;i<sizeof(ob);i++)
    if(ob[i] && !present(ob[i]))
        getSeats()->removePlayer(ob[i]);
}

//////////////////////////////////////////////////////////////////////////////
void reset() {
  object ob;
  string owner;
  int lifeTime;
  mixed removeList;
  int i;
  
  removeList = ({});
  
  if(!theke) {
    call_other (OBJ + "theke", "???");
    theke = find_object(OBJ + "theke");
  }
  

  for(ob=first_inventory(theke);ob;ob=next_inventory(ob)) {
    owner = ob->getOwnerUId();
    lifeTime = time() - ob->QueryProp(P_CLONE_TIME);
    
    if(!find_living(owner) || lifeTime > 10800)   
      removeList += ({ob});
  }
  
  i = 0;
  while(i<sizeof(removeList)) {
    removeList[i]->remove();
    i++;
  }
  
  if(present("josh") && i)
    tell_room(TO, "Josh raeumt ein paar Glaeser von der Theke ab.\n");
  
  if (money) {
    ZENTRALBANK->PayIn(money);
    money = 0;
  }
  ::reset();
}

//////////////////////////////////////////////////////////////////////////////
// wer sitzt kann nicht gehn 
int test_exit(string str) {
  int i;

  if(!TP) return 1;
  
  if(getSeats()->playerSeated(TP)) {
    write("Du solltest vorher aufstehen.\n");
    return 0;
  }

  if(str == "osten") {
    object *ob;

    ob = deep_inventory(TP);
    for(i=0;i<sizeof(ob);i++)
      if(ob[i]->id("\ny_cocktail")) {
        parkDrink(ob[i]);
        printf("Du stellst %s auf der Theke ab.\n", ob[i]->name(WEN,0));
        say(BS(sprintf("%s stellt %s auf der Theke ab.", 
            TP->Name(), ob[i]->name(WEN,0))), TP);
      }
  }
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
// theke ist eine blue-print
string detTheke(string key) {return theke->long();}

//////////////////////////////////////////////////////////////////////////////
// die barhocker
string detHocker(string key) {
  string str;
  int cnt, fs;

  m_init();

  cnt = getSeats()->getSeatedCount();

  str = (cnt==1 ? "Auf einem Barhocker sitzt " : "Auf den Barhockern sitzen ");
  if(cnt == 0) 
    str += "zur Zeit keine Gaeste";
  else
    str += getSeats()->getFormattedNames(TP);

  str += ". Es sind ";
  fs = getSeats()->getFreeSeatCount();
  str += (fs== 0 ? "keine" : to_string(fs));
  str += " Plaetze frei.";
  
  return break_string(str);
}

//////////////////////////////////////////////////////////////////////////////
// wieviele barhocker sind frei?
string detPlatz(string key) {
  int cnt;
  string str;

  if(getSeats()->playerSeated(TP))
    return BS("Auf Deinem Barhocker sitzend, hast Du hier wirklich reichlich Platz.");

  str = "An der Theke ist reichlich Platz, ";

  if(getSeats()->getSeatedCount() == 0)
    str += "auch alle Barhocker sind noch frei.";
  else if(getSeats()->getSeatCount() - getSeats()->getSeatedCount() == 0)
    str += "aber leider sind alle Barhocker belegt, Du musst also stehen.";
  else 
    str += "es sind auch noch " + to_string(getSeats()->getFreeSeats()) +
                  " Barhocker frei.";

  return BS(str);
}

//////////////////////////////////////////////////////////////////////////////
// drink auf der theke abstellen
void parkDrink(object drink) {
  drink->move(theke,M_PUT);

  //log
  log_file(LOG+"theke.log", dtime(time()) + ": "+TP->Name()+" stellt "
    +drink->QueryProp(P_SHORT)+" ab\n");
}

//////////////////////////////////////////////////////////////////////////////
void MoneyIn(int amount) { money += amount; }

//////////////////////////////////////////////////////////////////////////////
int findDrinkId(string str) {
  int i;
  
  if(member( drinks, (int)str )) return (int)str;
  
  for(i=1;i<=sizeof(drinks);i++) {
    if( member(drinks[i,4],str) != -1 ) {
      return i;
    }
  }
  return 0;
}

// das was der barkeeper tut um den drink zu mixen
mixed getMixChats(int drinkNr) {return drinks[drinkNr,8];}

int getDrinkValue(int drinkNr) {return drinks[drinkNr,2];}
string getDrinkName(int id) {return drinks[id, 0];}

//////////////////////////////////////////////////////////////////////////////
mixed getDrinkProps(int drinkNr) {
  mixed arr;
  arr = ({drinks[drinkNr,0],    //name
          drinks[drinkNr,3],    //short
          drinks[drinkNr,4],    //ids
          drinks[drinkNr,5],    //long
          drinks[drinkNr,6],    //msg
          drinks[drinkNr,7],     //props
          drinks[drinkNr,9]     //details
        });

  return arr;
}

//////////////////////////////////////////////////////////////////////////////
mixed getDrinkIds() {
  int i, j;
  string tmp;

  tmp = "";

  for(i=1;i<=sizeof(drinks);i++)
    for(j=0;j<sizeof(drinks[i,4]);j++)
      tmp += drinks[i,4][j] + "|";

  return explode(tmp, "|");
}

//////////////////////////////////////////////////////////////////////////////
int cmdSitze(string str) {
  int ret, i;
  notify_fail("Worauf willst Du Dich setzen?\n");
  m_init();

  if(str != "auf hocker" &&
     str != "auf barhocker" &&
     str != "barhocker" &&
     str != "hocker" )  return 0;

  ret = getSeats()->seatPlayer(TP);
  switch (ret) {
    case -2:  write("Du sitzt doch schon auf einem Barhocker!\n");
              break;
    case 0:   write("Leider sind alle Barhocker besetzt.\n");
              break;
    default:  write("Du setzt Dich auf einen Barhocker.\n");
              say(TP->Name() + " setzt sich auf einen Barhocker.\n");
  }
  return 1;
}


//////////////////////////////////////////////////////////////////////////////
int cmdStehe(string str) {
  int ret;

  notify_fail("Wovon willst Du aufstehen?\n");
  if(str != "auf" && str != "von hocker auf")
    return 0;

  ret = getSeats()->removePlayer(TP);
  if(ret == -1) {
    write("Aber Du sitzt doch gar nicht auf einem Barhocker!\n");
    return -1;
  }
  else {
    write("Du stehst von einem Barhocker auf.\n");
    say(TP->Name() + " steht von einem Barhocker auf.\n",TP);
    return 1;
  }  
}

//////////////////////////////////////////////////////////////////////////////
int cmdKaufe(string str) {
  int drinkNr;
  object josh;
  
  notify_fail("Was willst Du kaufen?\n");
  
  if(!str) return 0;
  
  if(!(josh=present("josh"))) {
    write("Der Barkeeper ist leider nicht da.\n");
    return 1;
  }
  
  drinkNr = findDrinkId(str);
  if(!drinkNr) return 0;
  
  printf("Du bestellst einen %s.\n", getDrinkName(drinkNr));
  say(sprintf("%s bestellt einen %s.\n",
            TP->Name(), getDrinkName(drinkNr)), TP);

  josh->work(drinkNr,TP); //Auftrag an Josh
  
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdSpendiere(string str) {
  int drinkNr;
  object josh;
  mixed arr;
  object pl;
  
  notify_fail("Wem willst Du was spendieren?\n");
  
  if(!str) return 0;
  
  if(!(josh=present("josh"))) {
    write("Der Barkeeper ist leider nicht da.\n");
    return 1;
  }
  
  arr = explode(str," ");

  if(sizeof(arr)<2) return 0;

  if(!(pl=present(arr[0]))) return 0;

  str = implode(arr[1..]," ");
  
  drinkNr = findDrinkId(str);
  if(!drinkNr) return 0;

  printf("Du spendierst %s einen %s.\n", pl->Name(), getDrinkName(drinkNr));
  say(sprintf("%s spendiert %s einen %s.\n", 
            TP->Name(), pl->Name(), getDrinkName(drinkNr)), ({TP,pl}));  
  tell_object(pl, BS(TP->Name() + " spendiert Dir einen "
                     + getDrinkName(drinkNr) +"."));    

//Auftrag an Josh
  josh->work(drinkNr,pl);
  
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdMenue(string str) {
  int i;

  notify_fail("Tippe \"menue\".\n");
  if(str) return 0;

  write("Du schaust Dir die Barkarte an:\n");
  write("* L A S * M I D A S * * * * * * * * * * * * * * * *\n");
  write(sprintf("*%49s*\n"," "));
  write(sprintf("*%5s %-30s %-5s %-6s*\n"," "," ""Getraenke","Preis","Alk"));
  write(sprintf("*%49s*\n"," "));
  for(i=1;i<=sizeof(drinks);i++) {
    write(sprintf("*%5d. %-30s %4d %3s   *\n",
                    i,drinks[i,0],drinks[i,2],drinks[i,1]));
  }
  write(sprintf("*%49s*\n"," "));
  write("* * * * * * * * * * * * * * * * * * * * * * * * * *\n\n");
  
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdNimm(string str) {
  int nr;
  object drink;
  string what;
  int i;
  mixed tmp;
  mixed arr;
  mixed thekeInv;
  
  notify_fail("Was willst Du von wo nehmen?\n");
  
  if(!str) return 0;

  if(sscanf(str, "%s von theke", what) != 1)
    return 0;
  
  arr = explode(what, " ");

  if(sscanf(arr[sizeof(arr)-1], "%d", nr) != 1)
    nr = 1;
  else {
    arr = arr[0..<2];
    what = implode(arr, " ");
  }
  
  if(nr < 1) return 0;
  
  tmp = ({});
  thekeInv = all_inventory(theke);
  for(i=0;i<sizeof(thekeInv);i++) {
    if(thekeInv[i]->id(what))
      tmp += ({i});
  }

  if(nr > sizeof(tmp)) return 0;
  nr = tmp[nr-1];
  drink = thekeInv[nr];

  switch (drink->move(TP,M_GET)) {
    case ME_TOO_HEAVY:
      write(break_string("Du kannst das Glas nicht mehr tragen.",78));
      break;
    case ME_TOO_MUCH:
      write(break_string("Du hast schon zu viele Gegenstaende bei Dir.",78));
      break;
    default:
      write(break_string(
        "Du nimmst " + drink->QueryProp(P_SHORT) + " von der Theke.",78));
      say(break_string(
        TP->Name() + " nimmt " + drink->QueryProp(P_SHORT) + " von der Theke.",78));
  }
            
  return 1;   
}

//////////////////////////////////////////////////////////////////////////////
int cmdStelle(string str) {
  object ob;
  mixed tmp;
  object drink;
  string what;
  mixed arr;
  int nr;
  
  notify_fail("Was willst Du worauf stellen?\n");
  if(!str) return 0;
  if(sscanf(str, "%s auf theke", what) != 1 )
    return 0;
     
  arr = explode(what, " ");
  if(sscanf(arr[sizeof(arr)-1], "%d", nr) != 1)
    nr = 1;
  else {
    arr = arr[0..<2];
    what = implode(arr, " ");
  }

  if(nr < 1) return 0;
  
  tmp = ({});
  for(ob=first_inventory(TP);ob;ob=next_inventory(ob)) {
    if(ob->id(what))
      tmp += ({ob});
  }

  if(nr > sizeof(tmp)) return 0;
  drink = tmp[nr-1];
  
  if(!drink->id("\ny_cocktail")) {
    write(break_string(
      "Das kannst Du nicht auf der Theke abstellen.",78));
    return 1;
  }
  
  parkDrink(drink);
  
  write(break_string(
    "Du stellst " + drink->name(WEN) + " auf der Theke ab.",78));
  say(break_string(
    TP->Name() + " stellt " + drink->name(WEN) + " auf der Theke ab.",78));

  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdFuehle(string str) {
  notify_fail("Was willst Du fuehlen?\n");
  if(str!="milchglas" &&
     str!="oberseite" && 
     str!="theke" &&
     str!="material") return 0;

  write(BS("Die Oberseite der Theke fuehlt sich gar nicht wie Glas an, "
        "sondern eher wie Holz, warm und etwas rauh. Das erklaert aber "
        "immer noch nicht woher das eigenartige Leuchten kommt."));

  return 1;
}
