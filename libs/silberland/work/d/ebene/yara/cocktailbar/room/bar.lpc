inherit "std/room";

#include "../def.h"
#include <bank.h>
#include "../obj/drinks.h"


int money;
object theke;
object seats;

void m_init();
string detTheke(string key);
string detHocker(string key);
string detPlatz(string key);
void parkDrink(object drink);
int test_exit(string str);

// Initialisierung der Barhocker
object getSeats() {
  if(!seats) {
    seats = clone_object(OBJ + "seat");
    seats->initSeats(5,"sitzt auf einem Barhocker");
  }
  return seats;
}

