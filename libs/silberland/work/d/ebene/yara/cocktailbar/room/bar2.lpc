#include "../def.h"

inherit "std/room";

#include <properties.h>

object dame;
string err;

//////////////////////////////////////////////////////////////////////////////
// m_init sorgt dafuer, dass die spieler auch anwesend sind
void m_init()
{
  object pl1, pl2;

  if(!dame) dame = find_object(ROOM + "dame");

  pl1 = dame->get_player(0);
  pl2 = dame->get_player(1);

  if(pl1 && !present(pl1)) dame->remove_player(pl1);
  if(pl2 && !present(pl2)) dame->remove_player(pl2);
}

//////////////////////////////////////////////////////////////////////////////
string detSessel(string key) {
  string str;
  object pl;

  m_init();

  if(!dame) dame = find_object(ROOM + "dame");

  str = "In einem Sessel sitzt ";
  pl = dame->get_player(0);

  if(!pl) str += "niemand";
  else if(pl == TP) str += "Du";
  else str += pl->Name();
    
  str += ", in dem anderen sitzt ";
  pl = dame->get_player(1);
  
  if(!pl) str += "niemand";
  else if(pl == TP) str += "Du";
  else str += pl->Name();
    
  str += ".";
  
  return break_string("Auf gegenueberliegenden Seiten des Spieltisches stehen zwei "
    "sehr bequeme, weich gepolsterte Sessel. Geschwungene Beine "
    "gehen ueber in eine niedrige schoen gemaserte Lehne.\n" + str,78,0,BS_LEAVE_MY_LFS);
}

//////////////////////////////////////////////////////////////////////////////
string detZeit(string key){ return dtime()+"\n";}

//////////////////////////////////////////////////////////////////////////////
string detSchild(string key) {
  if(!dame) dame = find_object(ROOM + "dame");
  return dame->hilfe();
}

//////////////////////////////////////////////////////////////////////////////
int test_exit(string str){
  if(!dame) dame = find_object(ROOM + "dame");

  if(TP == dame->get_player(0) || TP == dame->get_player(1))  {
    write("Du solltest vorher aufstehen.\n");
    return 0;
  }
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
void create() {
  ::create();

  seteuid(getuid());

//Wir brauchen ein Damespiel. Hier wird die Blue-Print geladen...
  call_other (ROOM + "dame", "???");
  dame = find_object(ROOM + "dame");

  SetProp( P_INT_SHORT, "Eine gemuetliche Cocktailbar" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp( P_NOREST, 1 );
  SetProp( P_INT_LONG,
    "Auch hier ist das Licht sanft golden, aber die Gesellschaft "
    "ist um einiges ruhiger. Die Besucher widmen sich lieber ihrem "
    "Cocktail, im Gegensatz zu denen weiter vorn an der Theke. "
    "Dazu laedt auch die gemuetliche Raumgestaltung ein, die ihren "
    "Gaesten weiche Polstermoebel um kleine Tische, angeordnet auf "
    "einem majestaetisch rotem Teppich, praesentiert.");

  AddCmd(({"setz","sitz","setze","sitze"}), "cmdSitze");
  AddCmd(({"stehe","steh"}), "cmdStehe");

  AddCmd("brett", "cmdBrett");
  AddCmd("neu", "cmdNeu");
  AddCmd(({"ziehe","z","zieh"}), "cmdZiehe");
  AddCmd("weiter", "cmdWeiter");
  AddCmd("regeln", "cmdRegeln");

  AddExit( "norden", ([EX_DEST: ROOM+"bar", EX_TESTFUNC: "test_exit"]) );
  AddExit("osten", ([EX_DEST: ROOM+"studio", 
                     EX_MSG: "durch einen Vorhang nach Osten",
                     EX_TESTFUNC: "test_exit"
                    ]) );

  AddDetail("sessel", #'detSessel);
  AddDetail(({"zeit"}), #'detZeit);
  AddReadDetail("schild", #'detSchild);

  AddDetail("gesellschaft",
    "Besonders viele Gaeste sind zur Zeit nicht anwesend. Wenn Du mehr "
    "Gesellschaft suchst, findest Du an der Theke zumindest Josh.");
  AddDetail("theke",
    "Die Theke ist weiter vorn, dort stehen einige Leute, schluerfen "
    "Cocktails und unterhalten sich angeregt. Hier ist es viel ruhiger.");
 AddDetail("licht",
    "Das goldene Licht kommt von den vielen weissen, gelben und roetlichen "
    "Lampions, die von der Decke haengen und wird durch Kerzen auf den "
    "Tischen ergaenzt. Es verleiht dem Raum eine angenehme Atmosphaere "
    "und laesst ihn warm und entspannend wirken.");
  AddDetail("atmosphaere",
    "Du fuehlst Dich richtig wohl hier.");
  AddDetail(({"raum","cocktailbar","las","las midas", "bar"}),
    QueryProp(P_INT_LONG));
  AddDetail("lampions",
    "Die Lampions bestehen aus weissem, gelben und roetlichem Papier "
    "und tauchen den Raum in goldenes Licht.");
  AddDetail("papier",
    "Das farbige Papier ist durchscheinend, anders wuerden die Lampions "
    "auch ihren Zweck nicht erfuellen koennen.");
  AddDetail("zweck",
    "Die Lampions wurden hier aufgehaengt um den Raum auszuleuchten.");
  AddDetail("kerzen",
    "Auf den Tischen brennen Kerzen in schlichten glaesernen "
    "Kerzenhaltern.");
  AddDetail("kerzenhalter",
    "Die Kerzenhalter sind ovale Gebilde aus Glas, auf denen jeweils "
    "eine Kerze steckt. Seitlich haben sie eine Oeffnung, in "
    "die zur Dekoration eine Rosenbluete gesteckt wurde.");
  AddDetail("kerze",
    "In jedem Kerzenhalter steckt eine Kerze.");
  AddDetail(({"gebilde","glas"}),
    "Mundgeblasene Kerzenhalter aus Glas schmuecken die Tische.");
  AddDetail("oeffnung",
    "Die Kerzenhalter halten nicht nur eine Kerze sondern dienen auch "
    "als Vase fuer eine Rosenbluete.");
  AddDetail("vase",
    "Sie sind bestimmt mit Wasser gefuellt, sonst wuerde die Bluete "
    "schnell verwelken.");
  AddDetail("wasser",
    "Wasser eignet sich gut, um eine Bluete nicht zu schnell verwelken "
    "zu lassen.");
  AddDetail("dekoration",
    "Die Tische wurde mit Kerzenhaltern, in denen jeweils auch eine "
    "Rosenbluete steckt, dekoriert.");
  AddDetail(({"rosenbluete","bluete"}),
    "In jeder Oeffnung steckt eine Rosenbluete. Die meisten sind "
    "weiss oder cremefarben.");
  AddDetail("boden",
    "Auf dem Boden liegt ein roter Teppich.");
  AddDetail(({"besucher", "gaeste"}),
    "Dazu gehoerst auch Du.");
  AddDetail("cocktail",
    "Cocktails mixt Josh vorn an der Theke.");
  AddDetail("raumgestaltung",
    "Gemuetlich.");
  AddDetail("josh",
    "Der steht vorn an der Theke, Du musst schon hingehen, wenn Du ihn "
    "genauer sehen willst.");
  AddDetail("leute",
    "Ein paar stehen vorn an der Theke, einige sitzen auch hier "
    "und nippen an ihren Cocktails.");
  AddDetail("seiten",
    "Auf beiden Seiten des Spieltisches stehen bequeme Sessel.");
  AddDetail("lehne",
    "Die Lehne ist ziemlich niedrig, aber doch hoch genug, um sich "
    "bequem anzulehnen. Du bewunderst die schoene Maserung.");
  AddDetail("maserung",
    "Diese Maserung ist wirklich schoen, Du ueberlegst, welches Holz "
    "das sein koennte, hast aber keine Ahnung.");
  AddDetail("holz",
    "Immerhin erkennst Du deutlich, dass die Sessel aus Holz gemacht wurden.");
  AddDetail("ahnung",
    "Vielleicht findest Du es ja irgendwann mal heraus.");
  AddDetail(({"gegensatz","gegensaetze"}),
    "Das ist so etwas aehnliches wie das Gegenteil.");
  AddDetail("gegenteil",
    "Nicht zu verwechseln mit dem Gegenstueck.");
  AddDetail(({"gegenstueck","gegenstuecke"}),
    "Zwei Gegenstuecke passen zusammen, zwei Gegensaetze nicht.");
  AddDetail("decke",
    "An der Decke haengen viele bunte Lampions, die den Raum in ein "
    "goldenes Licht tauchen.");
  AddDetail("teppich",
    "Der Teppich ist eher dunkelrot.");
  AddDetail(({"polstermoebel","moebel"}),
    "Hauptsaechlich siehst Du bequeme Sessel.");
  AddDetail("beine",
    "Die Beine der Sessel sind schoen geschwungen und aus dem gleichen "
    "Holz gemacht, wie die Lehne.");
  AddDetail(({"tisch","spieltisch","spieltisches"}),
    "Auf dem Spieltisch liegt ein Damespiel. Daneben ist ein kleines "
    "Schild angebracht.");
  AddDetail("schild",
    "Vielleicht kann man es lesen?");
  AddDetail("tische",
    "Ein Tisch faellt Dir besonders auf.");
  AddDetail(({"damespiel","spiel"}),
    "Das ist ein quadratisches Spielbrett mit Schachbrettmuster.");
  AddDetail(({"spielbrett","brett"}),
    "Auf dem Spielbrett liegen schwarze und weisse Spielsteine.");
  AddDetail(({"spielsteine","steine","schwarze spielsteine","weisse spielsteine",
    "weisse steine","schwarze steine"}), "Die braucht man zum Damespielen.");
  AddDetail(({"schachbrettmuster","muster"}),
    "Man koennte auch Schach darauf spielen, aber Du kannst keine Schachfiguren finden.");
  AddDetail("schach",
    "Das ist ein sehr komplexes Brettspiel.");
  AddDetail("brettspiel",
    "Brettspiele heissen so, weil man ein Spielbrett benutzt.");
  AddDetail(({"spiel","dame"}),
    "Hier kann man Dame spielen.");
  AddDetail(({"schachfiguren","figuren"}),
    "Du kannst keine entdecken.");
  AddDetail(({"waende","wand"}),
    "An den Waenden haengen ein paar Bilder, die man wohl als moderne Kunst "
    "bezeichnen koennte. Der Weg nach Osten wird durch einen Perlenvorhang "
    "abgetrennt.");
  AddDetail(({"vorhang","perlenvorhang"}),
    "Der Perlenvorhang schraenkt die Sicht in den anderen Raum ein.");
  AddDetail(({"osten","weg"}),
    "Geh doch mal hin.");
  AddDetail(({"sicht"}),
    "Du kannst nicht besonders viel erkennen.");
//TODO: fp?
  AddDetail(({"perlen"}),
    "Das sind Holzperlen.");
  AddDetail(({"holz","holzperlen"}),
    "Aus Holz.");
  AddDetail(({"bilder"}),
    "Du kannst nicht erkennen, was die Bilder eigentlich darstellen. Moderne "
    "Kunst eben.");
  AddDetail(({"kunst"}),
    "Du bist Dir nicht sicher, ob Dir diese Kunst gefaellt.");
  AddSound( DEFAULT_SOUND,
    "Es ist ziemlich still.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht angenehm hier.");
}


//////////////////////////////////////////////////////////////////////////////
//Befehle
//////////////////////////////////////////////////////////////////////////////
int cmdWeiter(){
  if(!dame) dame = find_object(ROOM + "dame");
  dame->weiter();
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdZiehe(string str){
  notify_fail("Von wo nach wo willst zu ziehen?\n");
  if(!dame) dame = find_object(ROOM + "dame");
  return dame->ziehe(str);
}

//////////////////////////////////////////////////////////////////////////////
int cmdBrett(string str){
  if(!dame) dame = find_object(ROOM + "dame");
  dame->brett();
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdNeu(string str){
  if(!dame) dame = find_object(ROOM + "dame");
  dame->neu(str);
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdRegeln(string str) {
  if(!dame) dame = find_object(ROOM + "dame");
  dame->regeln();
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdSitze(string str) {
  int ret;
  notify_fail("Worauf willst Du Dich setzen?\n");
  if(str != "auf sessel" &&
     str != "in sessel" &&
     str != "sessel" ) return 0;

  m_init();

  if(!dame) dame = find_object(ROOM + "dame");

  ret = dame->set_player(TP);

  if( ret == -1 )
    write("Du sitzt doch schon in einem Sessel!\n");
  else if( ret == 0 )
    write("Beide Sessel sind schon besetzt.\n");
  else if( ret == 1 )
  {
    write("Du setzt Dich in einen Sessel.\n");
    say(TP->Name() + " setzt sich in einen Sessel.\n");
  }

  return 1;
}


//////////////////////////////////////////////////////////////////////////////
int cmdStehe(string str) {
  notify_fail("Wovon willst Du aufstehen?\n");
  if(str != "auf" &&
     str != "aus sessel auf" &&
     str != "von sessel auf") return 0;

  if(!dame) dame = find_object(ROOM + "dame");

  if( dame->remove_player(TP) == 0 )
      write("Aber Du sitzt doch gar nicht in einem Sessel!\n");
  else {
    write("Du stehst von einem Sessel auf.\n");
    say(TP->Name() + " steht von einem Sessel auf.\n",TP);
  }

  return 1;
}