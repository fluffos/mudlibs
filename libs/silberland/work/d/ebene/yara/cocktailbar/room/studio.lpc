#include "../def.h"
inherit "std/room";

object sessel;
int kekse;
int gem;
mapping mkTime;

string detSessel(string key);

//////////////////////////////////////////////////////////////////////////////
void create() {
  string descRaum;
  object obj;
  
  ::create();

  sessel = clone_object(OBJ + "seat");
  sessel->initSeats(2, "sitzt in einem Sessel");

  gem = 1;
  kekse = 5;
  
  mkTime = ([]);

  SetProp( P_INT_SHORT, "Aydens Massageraum" );
  SetProp( P_INT_LONG,
    "Zwei helle Korbsessel stehen sauber angeordnet um einen dazu passenden "
    "Korbtisch in einer Ecke. An der Wand gegenueber befindet sich ein Regal "
    "aus Buchenholz und in der Mitte des Raumes ist eine Massageliege, "
    "daneben ein kleiner Beistelltisch. Der Boden ist mit einem weichen "
    "Teppich ausgelegt und es ist angenehm temperiert." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_HOUSE]) );


//TODO fp
  AddCmd(({"sitze","sitz","setze","setz"}), "cmdSitze");
//TODO fp??
  AddCmd(({"stehe","steh"}), "cmdStehe");
//TODO fp
  AddCmd(({"nimm","nehme"}), "cmdNimm");
  AddCmd(({"iss","esse","ess"}), "cmdIss");
//TODO fp
  AddCmd(({"lauf","laufe","gehe","geh"}), "cmdLaufe");
//TODO fp
  AddCmd(({"durchsuche","wuehle","suche","such","wuehl","durchsuch"}), "cmdSuche");
//TODO fp??
  AddCmd(({"trinke","trink"}), "cmdTrinke");

  AddExit( "westen", ([EX_DEST: ROOM+"bar2", EX_TESTFUNC: "test_exit"]) );  
  
  AddItem( NPC + "ayden" , REFRESH_DESTRUCT);
  AddItem( OBJ + "liege" , REFRESH_REMOVE);

  AddDetail(({"korbsessel","sessel","korb"}),#'detSessel);

  AddDetail(({"korbtisch","tisch"}),
    "Der Korbtisch passt richtig gut zu den Korbsesseln. Kein Wunder, er ist "
    "ja auch aus dem gleichen Material gemacht. Auf dem Tisch steht eine "
    "Schale.");
//TODO fp
  AddDetail(({"linker sessel"}),"Der linke Sessel sieht genau so aus wie "
    "der rechte Sessel.");
//TODO fp    
  AddDetail(({"rechter sessel"}),"Der rechte Sessel sieht genau so aus wie "
    "der linke Sessel.");
  AddDetail(({"schale"}),"Auf dem Korbtisch steht eine Schale mit Keksen.");
  AddDetail(({"kekse","kekse"}),"Die Kekse sehen lecker aus.");
  AddDetail(({"material"}),"Die Korbmoebel sind aus Rattan geflochten. Das sind "
    "die verholzten Triebe einer Palmenart, die sich aufgrund ihrer Biegsamkeit "
    "wundervoll verarbeiten lassen.");
  AddDetail(({"korbmoebel","moebel"}), "Die Korbmoebel passen gut zu diesem "
    "ansonsten recht schlicht ausgestattetem Raum.");
  AddDetail(({"rattan"}), "Rattan laesst sich nicht nur gut verarbeiten, es "
    "sieht auch schoen aus und ist sehr widerstandsfaehig.");
  AddDetail(({"triebe"}), "Wahrscheinlich von einer Rattanpalme.");
  AddDetail(({"palmenart","art","rattanpalme"}), "Du vermutest, dass hier "
    "eine Rattanpalme zu Moebeln verarbeitet wurde. Warum "
    "sollte sie auch sonst so heissen.");
  AddDetail(({"biegsamkeit"}), "Rattan ist sehr biegsam und laesst sich gut "
    "zu Moebeln flechten.");  
  AddDetail(({"ecke"}),
    "In einer Ecke stehen zwei Korbsessel um einen Tisch.");
  AddDetail(({"wand"}),"An einer Wand steht ein Regal aus Buchenholz.");
  AddDetail(({"wunder"}),"Man koennte Ayden als ein Wunder bezeichnen, "
    "muss man aber nicht.");
  AddDetail(({"mitte"}),"In der Mitte des Raumes steht eine Massageliege.");
  AddDetail(({"holz","buchenholz"}),"Das Buchenholz hat eine roetliche "
    "Farbe.");
  AddDetail(({"farbe"}),"Durch das Daempfen der frisch geschlagenen Staemme "
    "erhaelt Buchenholz seine warme, leicht rotbraune Farbe.");
  AddDetail(({"daempfen","dampf"}),"Frisches Holz wird gedaempft um es "
    "haltbarer zu machen.");
  AddDetail(({"staemme","stamm"}),"Du kannst keine Staemme mehr erkennen, "
    "sie wurden unter anderem zu diesem Regal verarbeitet.");
  AddDetail(({"regal"}),"Ein Regal aus Buchenholz. In ihm liegen ein paar "
    "flauschig-weiche Tuecher.");
  AddDetail(({"tuecher","tuch"}),"Im Regal liegen ein paar flauschigweiche "
    "Tuecher. Frag Ayden danach, wenn Du eins haben moechtest.");
  AddDetail(({"teppich"}),"Auf dem Boden liegt ein weicher Teppich, so dass "
    "man hier auch bequem barfuss gehen kann, ohne gleich kalte Fuesse zu "
    "bekommen.");
  AddDetail(({"fuesse","fuss"}),"Kalte Fuesse sollte man unbedingt "
    "vermeiden.");
  AddDetail(({"tisch"}),"Welchen Tisch meinst Du? Den Korbtisch oder den "
    "Beistelltisch?");
  AddDetail(({"beistelltisch"}),"Auf dem Beistelltisch siehst Du viele "
    "kleine Flaeschchen, eine Schuessel mit Wasser und ein Handtuch.");
  AddDetail(({"handtuch"}),"Damit trocknet sich Ayden die Haende ab.");
  AddDetail(({"schuessel"}),"Ayden waescht sich nach jeder Massage die "
    "Haende, sonst waere er bald total verklebt.");
  AddDetail(({"haende","hand"}),"Wuerdest Du Dich von oelverklebten Haenden "
    "massieren lassen wollen?");
  AddDetail(({"wasser"}),"Das Wasser sieht klar und und frisch aus, aber zum "
    "trinken ist es bestimmt nicht geeignet.");
  AddDetail(({"flaeschchen","flaschen"}),"Das scheinen Aydens Massageoele zu "
    "sein.");
  AddDetail(({"oele","massageoele","massageoel","oel"}),"Die Oele duften "
    "bestimmt herrlich, Du traust Dich aber nicht, sie zu nehmen.");
  AddDetail(({"massage"}),"Eine Massage wuerde Dir sicher auch gut tun.");
  AddDetail(({"boden"}),"Auf dem Boden liegt ein weicher Teppich.");
  AddDetail(({"decke"}),"Die Decke ist weiss getuencht. Von der Decke haengt "
    "ein Windspiel.");
  AddDetail(({"windspiel","spiel"}),"Von der Decke haengt ein Windspiel. Es "
    "besteht aus einer halben Kokosnuss, um die fuenf verschieden lange "
    "Holzstaebe haengen, die bei dem leisesten Windhauch sanft gegen die "
    "Kokosnuss schlagen.");
  AddDetail(({"kokosnuss"}),"Die stammt bestimmt aus dem Dschungel.");
  AddDetail(({"windhauch"}),"Eigentlich ist es hier windstill, aber ab und "
    "an gibt es doch einen kleinen Luftzug.");
  AddDetail(({"luftzug"}),"Du schaust Dich um und ueberlegst, woher hier ein "
    "Luftzug kommen koennte. Erst faellt Dir nur der Eingang auf, doch dann "
    "entdeckst Du auf zwei Seiten des Raumes kleine Lueftungsschlitze knapp "
    "unter der Decke.");
  AddDetail(({"lueftungsschlitze","schlitze"}),"Da dieser Raum unterirdisch "
    "liegt und somit fensterlos ist, gibt es hier zwei kleine Lueftungsschlitze, "
    "die immer fuer einen sanften Luftzug sorgen. Die Lueftungsschlitze sind "
    "mit einem Bambusgeflecht vergittert.");
  AddDetail(({"aufgabe","bambusgeflecht","geflecht","gitter"}),"Die "
    "Lueftungsschlitze sind vergittert, damit sich keine kleinen Tiere Zugang "
    "verschaffen koennen.");
  AddDetail(({"zugang"}),"Unvergitterte Lueftungsschlitze waeren ein prima Zugang "
    "fuer kleine Tiere.");
  AddDetail(({"tiere"}),"Beispielsweise Maeuse.");
  AddDetail(({"maeuse"}),"Keine Maeuse zu sehen, die Gitter scheinen ihre "
    "Aufgabe vorbildlich zu erfuellen.");  
  AddDetail(({"eingang","ausgang"}), "Der Eingang ist gleichzeitig auch der "
    "Ausgang. Faszinierend!");
  AddDetail(({"seiten","seite"}), "Der Raum ist an vier Seiten von Waenden "
    "begrenzt.");
  AddDetail(({"dschungel"}),"Vielleicht aber auch von woanders, wer weiss.");
  AddDetail(({"holzstaebe","staebe"}),"Die Holzstaebe sind verschieden lang und "
    "erzeugen so unterschiedliche Toene, wenn sie gegen die Kokosnuss schlagen.");
  AddDetail(({"toene"}),"Toene kann man nicht sehen.");
  AddDetail(({"waende"}),"Die Waende sind leicht abgetoent, dadurch wirkt der "
    "Raum warm und gemuetlich.");
  AddDetail(({"raum","raumes"}),QueryProp(P_INT_LONG));

  AddSound(DEFAULT_SOUND,
    "Es ist sehr ruhig hier, nur manchmal hoerst Du leise tiefe Toene von "
    "dem Windspiel, was an der Decke haengt.");
  AddSound(({"toene","ton","windspiel"}),
    "Klooong Boonnnnnng Doooonnnnng");
  AddSmell(DEFAULT_SMELL,
    "Du nimmst verschiedene Duefte wahr, kannst sie aber nicht einordnen.");
  AddSmell(({"duefte","duft"}),
    "All die verschiedenen Duefte muessen von Aydens Massageoelen kommen.");
  AddSmell(({"massageoele","oele","oel","massageoel","flaeschchen","flaschen",
    "flasche"}),
    "Du traust Dich nicht, die kleinen Flaeschchen zu nehmen.");
}


//////////////////////////////////////////////////////////////////////////////
string playerSeated(object pl) {
  object liege;

  if(sessel->playerSeated(pl))
    return "dem Sessel";

  if(liege=present("\ny_liege"))
  {
    if((liege->get_liegender()) == pl)
      return "der Liege";
  }
  return "";
}

//////////////////////////////////////////////////////////////////////////////
void reset() {
  gem = 1;
  kekse = 5;
  mkTime = ([]);

  return ::reset();
}

//////////////////////////////////////////////////////////////////////////////
int PreventInsert(object ob) {
  if(ob->id("\ny_tuch")) {
    call_out("cleanUp",4);
    return 0;
  }

  return ::PreventInsert(ob);
}
  
//////////////////////////////////////////////////////////////////////////////
void cleanUp() {
  object ayd;  
  
  if(ayd=present("ayden", TO))
    ayd->cleanUp();
}

//////////////////////////////////////////////////////////////////////////////
// sorgt dafuer, dass nur anwesende player in den sesseln sitzen
void m_init(){
  int i;
  object* ob;
  object liege;

  ob = sessel->getSittingPlayers();
  for(i=0;i<sizeof(ob);i++)
    if(ob[i] && !present(ob[i]))
        sessel->removePlayer(ob[i]);

  if(liege=present("\ny_liege"))
    liege->m_init();
}

//////////////////////////////////////////////////////////////////////////////
string detSessel(string key) {
  string str;
  object* player;
  int cnt;

  m_init();
  
  cnt = sessel->getSeatedCount();
  player = sessel->getSittingPlayers();

  str = "Die Korbsessel sehen sehr gemuetlich aus. ";

  switch (cnt) {
    case 1: str += "In einem der beiden Sessel sitzt "
                  +sessel->getFormattedNames(TP)+".";
            break;
    case 0: str += "In den Sesseln sitzt zur Zeit niemand.";
            break;
    case 2: str += "In den beiden den Sesseln sitzen "
                   + sessel->getFormattedNames(TP) + ".";
            break;
    default: str+="";
  }

  return break_string(str);
}

// TODO tmp
//////////////////////////////////////////////////////////////////////////////
varargs int remove() {
  object ayden;
  object liege;
  
  if(ayden=present("ayden")) ayden->remove();
  if(liege=present("liege")) liege->remove();
  
  return ::remove();
}

//////////////////////////////////////////////////////////////////////////////
int cmdSitze(string str) {
  int ret;  

  notify_fail("Worauf willst Du Dich setzen?\n");
  if(str != "auf sessel" &&
     str != "in sessel" &&
     str != "sessel" &&
     str != "auf korbsessel" &&
     str != "in korbsessel" &&
     str != "korbsessel") return 0;

  m_init();

  if((sessel->playerSeated(TP))==0)
    if(""!= playerSeated(TP)) {
      write(BS("Du solltest vorher von "+playerSeated(TP)+" aufstehen.")); 
      return 1;
    }

  ret = sessel->seatPlayer(TP);

  switch (ret) {
    case -2:  write("Du sitzt doch schon in einem Sessel!\n");
              break;
    case 0:   write("Leider sind beide Sessel schon besetzt.\n");
              break;
    default:  write("Du setzt Dich in einen Sessel.\n");
              say(TP->Name() + " setzt sich in einen Sessel.\n");
  }

  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdStehe(string str) {
  int ret;

//  notify_fail("Wovon willst Du aufstehen?\n");
  if(str != "auf" &&
     str != "aus sessel auf" &&
     str != "aus korbsessel auf" &&
     str != "von sessel auf" &&
     str != "von korbsessel auf") return 0;

  ret = sessel->removePlayer(TP);
  if(ret == -1) {
    return 0;
  }
  else {
    write("Du stehst aus einem Sessel auf.\n");
    say(TP->Name() + " steht aus einem Sessel auf.\n",TP);
    return 1;
  }   
}

//////////////////////////////////////////////////////////////////////////////
int cmdNimm(string str) {
  object obj;
  notify_fail("Was willst Du nehmen?\n");
  
  if(member(({"flaeschchen","oele","oel"}), str) != -1) {
    write("Du traust Dich nicht.\n");
    return 1;
  }
  
  if(str != "keks" &&
     str != "kekse" &&
     str != "keks aus schale" &&
     str != "kekse aus schale") return 0;

  if (member(mkTime, TP) && (mkTime[TP] + 20) > time()) {
      write("Du hast doch gerade erst einen Keks gegessen!\n");
      return 1;
  }

  TP->heal_self(random(4)+1);
  write(BS("Du nimmst einen Keks aus der Schale und isst ihn gleich auf. "
    "Mjam, der war wirklich lecker."));
  say(TP->Name() + " nimmt einen Keks aus einer Schale und isst ihn auf.\n",TP);

  mkTime[TP] = time();
  log_file(LOG+"studio.log", ctime()+": "+TP->Name()+" Keks\n");

  kekse--;
  if(kekse <= 0) {
    tell_room(TO,BS("Ayden holt eine Papiertuete hervor und fuellt eine Schale "
      "mit Keksen auf."));
    kekse = 5;
    log_file(LOG+"studio.log", ctime()+": Keksschale\n");
  }
  
  return 1;  
}

//////////////////////////////////////////////////////////////////////////////
int cmdIss(string str) {
  notify_fail("Was willst Du essen?\n");
  if(str != "keks" &&
     str != "kekse" &&
     str != "kekse aus schale" &&
     str != "keks aus schale") return 0;
     
  write("Wie willst Du einen Keks essen, den Du nicht bei Dir hast?\n");
  return 1;
}

//TODO vllt erweitern, trinken mit fp-abzug?
//////////////////////////////////////////////////////////////////////////////
int cmdTrinke(string str) {
  notify_fail("Was willst Du trinken?\n");
  if(str != "wasser") return 0;
     
  write("Das ist kein Trinkwasser.\n");
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdLaufe(string str) {
  mixed armour;
  string s1;
  string s2;
  
  notify_fail("Wie willst Du laufen?\n");
  if(str != "barfuss") return 0;
  
  if( sizeof(armour = TP->QueryArmours(({AT_BOOT}))) > 0 ) {
    s1 = "Du ziehst Deine " + capitalize(armour[0]->QueryProp(P_NAME))
      + " aus und laeufst ein wenig barfuss herum. ";
    s2 = "Du ziehst Deine " + capitalize(armour[0]->QueryProp(P_NAME))
       + " wieder an.\n";
  }
  else {
    s1 = "";
    s2 = "";
  }

  write(BS(s1 + "Der Teppich fuehlt sich ganz weich an und Deine Fuesse "
    "sind auch ueberhaupt nicht kalt. Autsch! Irgendetwas hat Dich gerade "
    "gepiekst. Ob da etwas im Teppich verborgen ist?"));
  write(s2);

  log_file(LOG+"studio.log", ctime()+": "+TP->Name()+" barfuss\n");
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdSuche(string str) {
  string s;
  object ob;
  
  notify_fail("Was willst Du durchsuchen?\n");
  if(str != "teppich" &&
     str != "in teppich") return 0;
     
  if( (gem == 1) && ("/obj/gemmaster"->DistributeGem(1,0,0,TP)) ) {
    s = "Du durchsuchst akribisch den Teppich und findest einen kleinen "
      + "Edelstein. Den muss wohl eine Kundin hier verloren haben. Schnell "
      + "steckst Du ihn ein.";
    gem = 0;
  }
  else 
    s = "Du durchsuchst akribisch den Teppich, findest aber nichts. "
      + "Scheinbar hast Du Dich getaeuscht.";
  
  write(BS(s));
    
  log_file(LOG+"studio.log", ctime()+": "+TP->Name()+" Teppich\n");
  
  return 1;
}

//////////////////////////////////////////////////////////////////////////////
// wer sitzt oder liegt kann nicht gehn 
int test_exit(string str) {
  object liege;
  object *ob;
  mixed tuecher;
  int i;
  
  if(""!=playerSeated(TP)) {
    write(BS("Du solltest vorher von "+playerSeated(TP)+" aufstehen."));
    return 0;
  }

  ob = deep_inventory(TP);
  tuecher = ({});
  for(i=0;i<sizeof(ob);i++)
    if(ob[i]->id("\ny_tuch")) {
      write("Du laesst das Massagetuch hier.\n");
      say(TP->Name()+" gibt Ayden ein Massagetuch.\n", TP);
      ob[i]->move(TO, M_NOCHECK);
    }

  return 1;
}