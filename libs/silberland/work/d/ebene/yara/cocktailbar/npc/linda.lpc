#include "../def.h"

inherit "std/mnpc";

//////////////////////////////////////////////////////////////////////////////
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Linda");
  SetProp(P_LONG, "Vor Dir steht eine junge schlanke Frau mit langen braunen "
    "Haaren. Sie traegt eine Umhaengetasche aus Baumwolle aus der sie bunte "
    "Zettel verteilt.");
  SetProp(P_NAME, "Linda");
  SetProp(P_GENDER, FEMALE);

  SetProp(P_ARTICLE, 0);
  set_living_name("linda");
  create_default_npc(15);

  AddId(({"linda","frau"}));

  AddDetail(({"haare","haar"}), "Schoene lange braune Haare. Linda hat sie mit "
    "einer einfachen Spange zusammengefasst.");
  AddDetail(({"tasche","umhaengetasche"}), "Darin bewahrt sie viele bunte "
    "Zettel auf.");
  AddDetail(({"baumwolle"}), "Daraus ist die Umhaengetasche gemacht.");
  AddDetail(({"spange","haarspange"}), "Eine einfache Haarspange.");

  SetProp(P_HANDS, ({" mit ihren Haenden",
    QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "springt geschickt aus Deiner Reichweite.");
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_LOG_INFO, "yara/linda.info");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Linda will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_MNPC_AREA, "/d/ebene/Midas/room/room" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ({"/d/ebene/Midas/room/room_f5"}));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES );
//+ MOV_BACKWARDS

  AddInfo(DEFAULT_INFO, "laechelt und schweigt.\n");
  AddInfo("yara", "Yara hat mich erschaffen.","sagt: ");
  AddInfo("midas","Wir befinden uns in Midas.", "sagt: ");
  AddInfo( ({"las","midas","las midas","cocktailbar"}),
    "Das ist eine neue Cocktailbar hier in Midas. Die Bar hat neu eroeffnet, "
    "geh doch einfach mal hin.",
    "sagt: ");

  SetChats(3, ({
    "Linda sagt: Besuche doch das Las Midas, es hat neu eroeffnet.\n",
    "Linda verteilt bunte Zettel.\n",
    "Linda laechelt freundlich.\n",
    "Linda fragt: Hast Du schon vom Las Midas gehoert?\n"}) );

  SUID;
//  CLONEME(ARMOUR "" );
  command("trage alles");
}

void init() {
  object pl;
  pl=TP;
    if(find_player(lower_case(pl->name())))
      if(sizeof(filter_objects(all_inventory(pl), 
                               "id", "\ny_lasmidaszettel"))==0)
        call_out("give",random(4)+2, pl);
  ::init();
}

void give(object pl) {
  object ob;
  if(present(pl))
    if(ob=clone_object(OBJ+"werbezettel"))
      if(ob->move(pl, M_GIVE) == 1) {
        tell_object(pl, "Linda gibt Dir einen buntes Prospekt.\n");
        say("Linda gibt "+pl->Name(RAW)+" ein buntes Prospekt.\n",pl);
      }
}