      TP->Name(WER) + " versucht mit Ayden zu schmusen, aber Ayden weicht "
      "geschickt aus.",78),TP);
  }

  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdKnabbere(string str) {
  string what;
  notify_fail("Was willst Du knabbern?\n");
  
  if(!str) return 0;
  if(sscanf(str,"an %s",what) == 1) str = what;
  if (!id(str)) return 0;

  if(TP->QueryProp(P_GENDER) == FEMALE) {
    write(break_string(
      "Du naeherst Dich Ayden und knabberst zaertlich an seinem "
      "Ohr. Ayden umarmt Dich und haucht sanfte Kuesse auf Deinen "
      "Hals.",78));
    say(break_string(
      TP->Name(WER) + " knabbert Ayden am Ohr.",78),TP);
  }
  else {
    write(break_string(
      "Du versuchst an Aydens Ohr zu knabbern, aber er weicht "
      "geschickt aus.",78));
    say(break_string(
      TP->Name(WER) + " versucht an Aydens Ohr zu knabbern, aber "
      "Ayden weicht geschickt aus.",78),TP);
  }

  return 1;
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
        call_out("reaction", 0, TP,
        "sagt: Hab keine Angst "+TP->Name()+".",
        "sagt: Hab keine Angst "+TP->Name()+".");
      break;
    case "aergerlich":
//        call_out("reaction", 0, TP,
//        "poliert unbeteiligt ein paar Glaeser.",
//        "poliert unbeteiligt ein paar Glaeser.");
        break;
    case "albern":
        call_out("reaction", 0, TP,
        "kichert leise.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Hey lass das!",
        "sagt: Hey lass das, "+TP->Name()+"!");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TP->Name()+" an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "strahlt Dich an.", 
        "strahlt "+TP->Name()+" an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Ich muss noch arbeiten, aber vielleicht nach Dienstschluss?", 
        "sagt: Ich muss noch arbeiten, aber vielleicht nach Dienstschluss?");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->Name()+" an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "steht herum und sieht gut aus.", 
        "steht herum und sieht gut aus.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->Name()+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
