    notify_fail("Wen willst Du streicheln?\n");
    if (!id(str)) return 0;

  if(TP->QueryProp(P_GENDER) == FEMALE) {
    write(break_string(
      "Achtsam streichelst Du ueber Aydens Arm und blickst ihn "
      "vertraeumt an, da zieht er Dich zur Seite und streift Dir ueber "
      "den Ruecken, waehrend er zaertlich an Deinem Hals knabbert.",78));
    say(TP->Name(WER) + " und Ayden treten etwas abseits und streicheln sich "
      "zaertlich.\n",TP);
  }
  else {
    write("Ayden wirft Dir einen veraechtlichen Blick zu.\n"
          "Du haelst erschrocken inne.\n");
    say(break_string(
      TP->Name(WER) + " versucht Ayden zu streicheln, haelt aber erschrocken "
      "inne, als er Aydens veraechtlichen Blick bemerkt.",78),TP);
  }

  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdHimmel(string str) {
  string what;
  
  notify_fail("Wen willst Du anhimmeln?\n");
  
  if(!str) return 0;

  if(sscanf(str,"%s an",what) == 1) str = what;
  
  if (!id(str)) return 0;

  if(TP->QueryProp(P_GENDER) == FEMALE) {
    write(break_string(
      "Du himmelst Ayden mit verklaerten Augen an, was ihm wirklich gut "
      "zu gefallen scheint.",78));
    say(TP->Name(WER) + " himmelt Ayden an.\n",TP);
  }
  else {
    write(break_string(
      "Du himmelst Ayden mit verklaerten Augen an, was ihm nicht wirklich "
      "zu gefallen scheint.",78));
    say(break_string(
      TP->Name(WER) + " himmelt Ayden mit verklaerten Augen an, was Ayden "
      "nicht wirklich zu gefallen scheint.",78),TP);
  }

  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdHopse(string str) {
  string what;
  
  notify_fail("Um wen willst Du hopsen?\n");
  
  if(!str) return 0;

  if(sscanf(str,"um %s",what) == 1) str = what;
  
  if (!id(str)) return 0;

  if(TP->QueryProp(P_GENDER) == FEMALE) {
    write(break_string(
      "Uebermuetig hopst Du um Ayden herum und im passenden Augenblick "
      "faengt er Dich auf und dreht sich lachend mit Dir einmal im Kreis.",78));
    say(break_string(
      TP->Name(WER) + " hopst uebermuetig um Ayden herum und im "
      "passenden Augenblick faengt er sie auf und dreht sich "
      "lachend mit ihr einmal im Kreis.",78),TP);
  }
  else return 0;
    
  return 1;
}

