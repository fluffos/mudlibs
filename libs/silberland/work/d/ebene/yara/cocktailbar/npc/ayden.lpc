int cmdTanze(string str) {
  string what;
  
  notify_fail("Mit wem willst Du tanzen?\n");
  
  if(!str) return 0;

  if(sscanf(str,"mit %s",what) == 1) str = what;
  
  if (!id(str)) return 0;

  if(TP->QueryProp(P_GENDER) == FEMALE) {
    write(break_string(
      "Du tanzt mit Ayden eine leidenschaftlichen Tango.",78));
    say(break_string(
      TP->Name(WER) + " schnappt sich Ayden und die "
      "beiden tanzen einen leidenschaftlichen Tango.",78),TP);
  }
  else {
    write(break_string(
      "Ayden will nicht mit Dir tanzen.",78));
    say(break_string(
      TP->Name(WER) + " versucht mit Ayden zu tanzen, aber Ayden "
      "weigert sich vehement.",78),TP);
  }

  return 1;
}

//////////////////////////////////////////////////////////////////////////////
int cmdUmarme(string str) {
  notify_fail("Mit wem willst Du tanzen?\n");
  
  if (!id(str)) return 0;

  if(TP->QueryProp(P_GENDER) == FEMALE) {
    write(break_string(
      "Du lehnst Dich sanft an Ayden an, woraufhin er dich fest, aber "
      "liebevoll umarmt. Du fuehlst Dich so geborgen und sicher, dass Du "
      "Deinen Kopf gegen seinen lehnst und zu traeumen beginnst...",78));
    say(break_string(
      TP->Name(WER) + " wird zaertlich von Ayden umarmt.",78),TP);
  }
  else {
    write(break_string(
      "Du versuchst Ayden zu umarmen, aber er weicht geschickt aus.",78));
    say(break_string(
      TP->Name(WER) + " versucht Ayden zu umarmen, aber Ayden weicht "
      "geschickt aus.",78),TP);
  }

  return 1;
}

