  AddInfo(({"gast"}), "Der ist oft hier, wir kennen uns.", "sagt: ");
  AddInfo(({"mixer","mixbecher","shaker"}), "Damit kann ich alle Zutaten gut durchmischen.", "sagt: ");
  AddInfo(({"arbeiten","arbeit","job"}), "Yara hat mich hier angestellt.", "sagt: ");
  AddInfo(({"kakao","sahne","chilisosse","fluessigkeit","fluessigkeiten","wodka","zitronensaft","tomatensaft","rum","bananensaft",
    "kirschlikoer","grenadine","champagner","kirschsaft","orangensaft","moosbeerensaft","pfirsichlikoer","zuckersirup","tequila",
    "cointreau","cola","saft","saefte"}), "Das gehoert zu den Zutaten fuer meine Cocktails.");
  AddInfo(({"selleriestange","orangenscheibe","cocktailkirsche","strohhalm","palmblaetter","papier","karambolescheibe"}),
