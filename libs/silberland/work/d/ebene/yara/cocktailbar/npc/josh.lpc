  AddInfo("yara", "Yara hat mich hier angestellt, ihr gehoert die Bar.","sagt: ");
// TODO fp?
  AddInfo(({"punkte","leuchten","punkten"}), "Das Leuchten kommt von Gluehwuermchen, die in der Theke herumschwirren.", "fluestert: ",1);
  AddInfo(({"gluehwuermchen","wuermchen"}),
    "Ich glaube sie fuehlen sich wohl da drin, sonst wuerden sie nicht so schoen leuchten.", "sagt: ",1);
  AddInfo(({"musiker","musik","musikern"}), "Leider sind die Musiker alle krank. Angeblich haben sie sich "
