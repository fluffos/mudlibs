  AddInfo(({"rezepte","rezept"}), "Ich kenne einige Rezepte und manchmal denke ich mir auch neue aus.", "sagt: ");
  AddInfo(({"caipirinha"}), "Leider fehlt mir dafuer noch eine Zutat.", "sagt: ");
  AddInfo(({"zutaten"}), "Die moechte ich jetzt nicht alle aufzaehlen.", "sagt: ");
  AddInfo(({"zutat"}), "", "Die fehlende Zutat wird sicher bald geliefert.", "sagt: ");
  AddInfo(({"zeit"}), "Tip doch einfach mal \"zeit\".", "sagt: ");
  AddInfo(({"oeffnungszeiten","oeffnungszeit"}), "Die Bar hat fast durchgaengig geoeffnet.", "sagt: ");
  AddInfo(({"alkohol"}), "Die meisten meiner Cocktails enthalten Alkohol.", "sagt: ");
  AddInfo(({"mischung","getraenk","drink","drinks","getraenke","getraenken","cocktails","cocktail","menue","menu","karte"}),
