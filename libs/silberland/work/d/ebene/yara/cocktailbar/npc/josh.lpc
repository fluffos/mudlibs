  AddInfo(({"leute","gaeste","gaesten","leuten"}), "Im Moment sind nicht besonders viele da.", "sagt: ");
  AddInfo(({"bezahlung","lohn"}), "Die ist gar nicht schlecht, Yara bezahlt mich gut fuer meinen Job.", "sagt: ");
  AddInfo(({"theke"}), "Sie bietet alles was ein Barkeeper braucht, Glaeser, Getraenke und natuerlich Platz fuer die Gaeste.", "sagt: ");
  AddInfo(({"glaeser","glas","glaesern","longdrinkglas"}), "Ich fuelle Cocktails in Glaeser.", "sagt zwinkernd: ");
  AddInfo(({"platz"}), "Es ist genug Platz, Du kannst Dich hinsetzen aber auch stehenbleiben.", "sagt: ");
