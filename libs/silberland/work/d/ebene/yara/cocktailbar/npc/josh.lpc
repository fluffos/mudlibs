  AddInfo(({"eis"}),"Das lasse ich aus Smoersky anliefern.");
  AddInfo(({"smoersky"}),"Da ist es sehr kalt.");
//TODO
  AddInfo(({"kaffee"}), "Kaffee gibt es sicher auch bald.", "sagt: ");
//  AddInfo(({"alkoholfrei"}), "Wie waers mit einem Druida Colada?", "sagt: ");
  RemoveInfo("sex"); AddInfo(({"sex"}), "laeuft dunkelrot an.");
  ids = bar->getDrinkIds(); for(i=0;i<sizeof(ids);i++) AddInfo( lower_case(ids[i]), #'infoDrinks, "sagt: ");
//  AddInfo(({}), "", "sagt: ");

}

void trinke(object ob) {
  int i;
  if(!ob) return;

  i = random(10);
  switch (i) {
    case 0: case 1: case 2: command("trinke cocktail");
            break;
    case 3: case 4: case 5: command("nippe cocktail");
            break;
    case 6: case 7: case 8: command("schluerfe cocktail");
            break;
    case 9: command("trinke cocktail aus");
  }

  if(ob) call_out("trinke", random(30)+5, ob);
}

//////////////////////////////////////////////////////////////////////////////
void give_notify(object ob) {
  object tmp;
  int cnt;

  if(ob->id("\ny_cocktail")) {
    for(cnt=0,tmp=first_inventory(TO);tmp;tmp=next_inventory(tmp)) {
      if(ob->id("\ny_cocktail")) cnt++;
    }      
    if(cnt > 1) {
      tell_room(environment(TO), "Josh hat schon einen Cocktail.\n"
                                  "Josh legt "+ob->name(WEN, 0)+ " ab.\n");
      ob->move(environment(TO), M_NOCHECK);
    }
    else {
      tell_room(environment(TO), "Josh freut sich.\n");
      trinke(ob);
    }
  }
  else if(ob->id("getraenk") ||
          ob->id("drink") ||
          ob->id("wasser") ||
          ob->id("trank") ||
          ob->id("flasche") ||
          ob->id("glas") ||
          ob->id("milch") ||
          ob->id("kaffee") ||
          ob->id("becher")) {
    tell_room(environment(TO), "Josh freut sich und trinkt "
                                +ob->name(WEN, 1)+" aus.\n");
    ob->remove();
  }
  else if(ob->QueryProp(P_FOOD_INFO) ||
          ob->id("kuchen") ||
          ob->id("keks") ||
          ob->id("bonbon") ||
          ob->id("eis") ||
          ob->id("nahrung") ||
          ob->id("food")) {
    tell_room(environment(TO), "Josh freut sich und isst "
                                +ob->name(WEN, 1)+" auf.\n");
    ob->remove();
  }
  else {
    tell_room(environment(TO), "Josh moechte das nicht tragen und legt "
                               +ob->name(WEN, 1)+ " ab.\n");    
    ob->move(environment(TO), M_NOCHECK);
  }
}

void mix(int mixChatIndex) {
  mixed chats;
  object drink;
  int drinkNr;
  object pl;
  int bTheke;

  bTheke = 0;

//Drink und Empfaenger aus Queue holen
  drinkNr = queue[0][0];
  pl = queue[0][1];
  
//TODO das wird hier unnoetig oft neu gesetzt...
  chats = bar->getMixChats(drinkNr);
  say(break_string(chats[mixChatIndex], 78));
  
  if( sizeof(chats) != (mixChatIndex + 1) ) 
    //Mixmeldungen abarbeiten
    call_out("mix", 3, mixChatIndex + 1);
  else
  {
    drink = clone_object(OBJ + "cocktail");
    drink->setDrink( bar->getDrinkProps(drinkNr), pl );
    
    if(!present(getuid(pl))) {
      say(break_string("Huch, wo ist denn " + pl->Name() + "?",78,"Josh sagt: "));
      bTheke = 1;
    }
    else {
      switch (drink->move(pl,M_GIVE)) {
        case ME_TOO_HEAVY: 
          say(break_string("Du kannst das Glas nicht mehr tragen, "
              +pl->Name()+".",78, "Josh sagt: "));
          bTheke = 1; break;
        case ME_TOO_MUCH: 
          say(break_string("Du hast schon zu viele Gegenstaende bei Dir, "
              +pl->Name()+".",78,"Josh sagt: "));
          bTheke = 1; break;
        default: 
          pl->Message("Josh gibt Dir ein Glas.\n", MSGFLAG_VISUAL);
          say("Josh gibt " + pl->Name() + " ein Glas.\n",pl);
      }
    }
    
    if(bTheke) {
      say("Josh stellt ein Glas auf der Theke ab.\n");
      bar->parkDrink(drink);
    }

//Synchronisation    
    while(busy);
    busy = 1;    
// naechstes element der queue
      queue = queue[1..];
      if(sizeof(queue) != 0) call_out("mix", 3, 0);
    busy = 0;
  }
}


void work(int drinkNr, object pl) {
  int value, sum;

//josh kann sich 5 bestellungen merken  
  if(sizeof(queue)>=5) { 
    write(break_string(
      "Ich bin leider im Moment zu beschaeftigt. Bestelle bitte "
      "spaeter noch einmal.",78,"Josh sagt: "));
    return;
  }

//referenz auf die bar
  call_other (ROOM+"bar", "???");
  bar = find_object(ROOM+"bar");

//bezahlung
  value = bar->getDrinkValue(drinkNr);
  if(TP->QueryMoney() < value) {
    say(break_string(
      "Du hast doch gar nicht genug Geld bei Dir, "+TP->Name(RAW)+
      ".",78,"Josh sagt: "));
    return;
  }
  TP->AddMoney(-value);
  bar->MoneyIn(value);

//log
  log_file(LOG+"bar.log", dtime(time()) + ": " + TP->Name() + 
    " bezahlt " + value + " Muenzen fuer " +
    (bar->getDrinkProps(drinkNr))[0] + "\n");
  sum = to_int(read_file("/log/"+LOG+"money.sum",1));
  sum += value;
  write_bytes("/log/"+LOG+"money.sum", 0, to_string(sum));

  say(break_string("Ein "+(bar->getDrinkProps(drinkNr))[0]+" fuer "
      +pl->Name()+". Kommt sofort.", 78, "Josh sagt: "));
  write("Du bezahlst " + value + " Muenzen.\n\n");

//Synchronisation    
  while(busy);
  busy=1;  
    queue += ({ ({drinkNr,pl}) });
  
    if(sizeof(queue)==1)
      call_out("mix",1,0);
  busy=0;  
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
        call_out("reaction", 0, TP,
        "sagt: Hab keine Angst "+TP->Name()+".",
        "sagt: Hab keine Angst "+TP->Name()+".");
      break;
    case "aergerlich":
        call_out("reaction", 0, TP,
        "poliert unbeteiligt ein paar Glaeser.",
        "poliert unbeteiligt ein paar Glaeser.");
        break;
    case "albern":
        call_out("reaction", 0, TP,
        "kichert leise.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Dir serviere ich gleich keine Drinks mehr!",
        "sagt: Dir serviere ich gleich keine Drinks mehr, "+TP->Name()+"!");
      break;
    case "frech":
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "strahlt Dich an.", 
        "strahlt "+TP->Name()+" an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Ich muss noch arbeiten, aber vielleicht nach Dienstschluss?", 
        "sagt: Ich muss noch arbeiten, aber vielleicht nach Dienstschluss?");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TP->Name()+" an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "kuemmert sich um einen Gast.", 
        "kuemmert sich um einen Gast.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TP->Name()+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
