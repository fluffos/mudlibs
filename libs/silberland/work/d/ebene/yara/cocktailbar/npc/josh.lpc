inherit NPC + "y_npc_inh";

mixed queue; //bestellqueue
object bar;
int busy;  //synchronisation

string infoDrinks(string key) {
  int id;
  id = bar->findDrinkId(key);
  return "Ich kann Dir einen " + bar->getDrinkName(id) + " mixen, bestell "
         "Dir einfach einen.";
}

string infoDate(string key) {
  if(TP->QueryProp(P_GENDER)==FEMALE)
    return "Gern, aber erst nach Dienstschluss.";
  else
    return "Ich gehe lieber mit Frauen aus.";
}

