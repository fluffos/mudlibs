/*
** Eine Kaugummiblase, gehoert zu kaugummi.c Yara@SL
** ---
** 2005-12-06  1.0  Yara  initial version
*/

#include "../def.h"

inherit "std/npc";

#define MAXS 10

int size;
object owner;





void create() {
  if (!is_clone(TO)) return;
  
  ::create();
  
  size = 1;
  
  SetProp(P_NAME, "Kaugummiblase");
  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
SetProp(P_MSGIN, "");
SetProp(P_MMSGIN, "");
  
  AddId("\ny_kblase");
  
  
  AddCmd(({"haue","piekse","pieks","zerplatze",
           "platze","zerplatze","hau"}),"cmdHaue");
           
  seteuid(getuid());
  
  call_out("platze",random(20)+5,1);
}



void setOwner(object pl) {
  owner = pl;
}



void platze(int rmv) {
  tell_object(owner,"Die Kaugummiblase zerplatzt.\n");
  say(owner->name(WESSEN) + " Kaugummiblase zerplatzt.\n",owner);
  
  if(rmv) remove();
}



void grow() {
  size++;
  if(size > MAXS) platze(1);
}





int cmdHaue(string str) {
  string s1,s2;
  
  notify_fail("Auf was willst Du hauen?\n");
  
  if(str != "auf blase" &&
     str != "blase" &&
     str != "auf kaugummiblase" &&
     str != "kaugummiblase" &&
     str != "kaugummi" &&
     str != "auf kaugummi" &&
     str != "auf " + getuid(owner) &&
     str != getuid(owner)) return 0;   
     

  if(!random(8)) {
    platze(0);

    if(TP == owner) {
      s1 = "Du haust Dir auf den Mund!";
      s2 = TP->name() + " haut sich auf den Mund!";
    }
    else {
      s1 = "Du haust " + owner->name() + " auf den Mund!";
      s2 = TP->name() + " haut " + owner->name() + " auf den Mund!";
    }     

    write(break_string(s1,78));
    say(break_string(s2,78),({TP,owner}));
    if(TP != owner) tell_object(owner,TP->name() + " haut Dir auf den Mund!\n");
    
    remove();
  }
  else {    
    if(TP == owner) {
      s1 = "Du haust auf Deine Kaugummiblase.";
      s2 = TP->name() + " haut auf " + owner->QueryPossPronoun(FEMALE,WEN) +
           " Kaugummiblase.";
    }
    else {
      s1 = "Du haust auf " + owner->name(WESSEN) + " Kaugummiblase.";
      s2 = TP->name() + " haut auf " + owner->name(WESSEN) + " Kaugummiblase.";
    }     

    write(break_string(s1,78));
    say(break_string(s2,78),({TP,owner}));
    if(TP != owner) tell_object(owner,TP->name() + " haut auf Deine Kaugummiblase.\n");

    platze(1);
  }    

  return 1;
}