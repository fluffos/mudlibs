#include "../def.h"

inherit "/std/armour";

string *farben = ({"rot","gelb","gruen","blau","weiss","schwarz"});

//////////////////////////////////////////////////////////////////////////////
void create() {
  ::create();

  SetProp(P_GENDER, MALE);
  AddId(({"ring","blechring","\ny_blechring"}));

  SetProp(P_INFO, "Ein einfacher kleiner Ring. Wahrscheinlich stammt er "
    "aus einem Kaugummiautomaten.");

  SetProp(P_NAME_ADJ, ({"klein",farben[random(sizeof(farben))]}));
  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_MATERIAL, MAT_MISC_SOLID);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 0);

  AddDetail("blech","Der Ring ist nur aus billigem Blech.");

  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}

//////////////////////////////////////////////////////////////////////////////
int WearFunc(object me) {
  SetProp(P_EXTRA_LOOK, TP->name(WESSEN)+" Finger schmueckt "+name()+".\n");
  return 1;
}

int RemoveFunc(object me) {
  SetProp(P_EXTRA_LOOK, 0);
  return 1;
}
