#include "../def.h"

inherit OBJ+"blechring";

//////////////////////////////////////////////////////////////////////////////
void create() {
  string *keys;
  string item;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Sonnenring");
  SetProp(P_GENDER, MALE);
  AddId("sonnenring");

  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, "Du siehst einen kleinen Ring. Er ist nur aus Blech, "
    "wird aber von einer kleinen gelben Sonne verziert." );

  AddDetail("sonne", "Eine kleine gelb bemalte Sonne verziert den Ring "
                     "und lacht Dich an.");

  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}

//////////////////////////////////////////////////////////////////////////////
int WearFunc(object me) {
  SetProp(P_EXTRA_LOOK, TP->name(WESSEN)+
                        " Finger schmueckt "+name(WER,0)+".\n");
  return 1;
}

int RemoveFunc(object me) {
  SetProp(P_EXTRA_LOOK, 0);
  return 1;
}
