#include "../def.h"

inherit "std/thing";

#define MAXK 20

int cnt;
object kblase;
int chewed;
mixed color;
mixed taste;

void create() {
  string str;
  
  if (!is_clone(TO)) return;
  ::create();

  cnt = 0;
  kblase = 0;
  chewed = 0;
  
  SetProp(P_SHORT, "Ein Kaugummi");
  
  color = ({"rosa","weisser","brauner","blauer","gruener","gelber","roter"});
  taste = ({"Pfefferminzgeschmack",
            "Erdbeergeschmack",
            "Bananengeschmack",
            "Colageschmack",
            "Heidelbeergeschmack",
            "Himbeergeschmack",
            "Kraeutergeschmack"
  });
  
  str = "Ein leckerer ";
  str += color[random(sizeof(color))];
  str += " Kaugummi mit ";
  str += taste[random(sizeof(taste))];
  str += ".";
  
  SetProp(P_LONG,str);
  
  SetProp(P_INFO, "Du kannst damit eine Kaugummiblase blasen.");
  SetProp(P_NAME, "Kaugummi");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE,1);

  AddId(({"kaugummi","gummi"}));

  SetProp(P_MATERIAL, MAT_FOOD );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
//  SetProp(P_NOBUY, 1);

  AddCmd(({"kaue","kau"}),"cmdKaue");
  AddCmd(({"blase","blas"}),"cmdBlase");
  AddCmd(({"spucke","spuck"}),"cmdSpucke");
}






int cmdKaue(string str) {
  notify_fail("Was willst Du kauen?\n");
  
  if(!id(str)) return 0;
  
  if(kblase && present(kblase,environment(TP))) kblase->platze(1);
  
  SetProp(P_SHORT, TP->name(WESSEN) + " Kaugummi (gekaut)");
  
  if(cnt > MAXK) {
    write("Der Kaugummi schmeckt ueberhaupt nicht mehr.\n");
    write("Du kaust auf einem alten Kaugummi herum.\n");
    say(break_string(
      TP->name() + " kaut auf einem alten Kaugummi herum.",78),TP);
    return 1;
  }
  
  cnt += 1;
  chewed = 4;
  
  write(break_string(
    "Du kaust genuesslich auf Deinem Kaugummi herum.",78));
  say(break_string(
    TP->name() + " kaut genuesslich auf einem Kaugummi herum.",78),TP);
    
  return 1;
}









int cmdBlase(string str) {
  string sw,ss;
  mixed sarray;
  
  notify_fail("Was willst Du aufblasen?\n");
  
  if(str != "kaugummiblase auf" &&
     str != "kaugummi auf" &&
     str != "gummi auf" &&
     str != "kaugummi" &&
     str != "gummi" &&
     str != "blase auf" &&
     str != "blase") return 0;
  

  if(cnt < 2) {
    write("Der Kaugummi ist doch noch viel zu hart.\n");
    return 1;
  }
  
  if(cnt > MAXK) {
    write("Der Kaugummi ist schon viel zu ausgekaut dafuer.\n");
    return 1;
  }
  
  if(chewed == 0) {
    write("Du solltest den Kaugummi erst mal wieder kauen.\n");
    return 1;
  }

  sarray = ({
    ({"Die Blase wird groesser."," Kaugummiblase wird groesser."}),
    ({"Die Blase wird immer groesser."," Kaugummiblase wird immer groesser."}),
    ({"Gleich wird die Blase platzen."," Kaugummiblase wird gleich platzen."})
  });

  if(!kblase || !present(kblase,environment(TP))) {
    sw = "Du konzentrierst Dich und blaest eine kleine Kaugummiblase.";
    ss = TP->name() + 
         " konzentriert sich und blaest eine kleine Kaugummiblase.";
    
    kblase = clone_object(OBJ + "kblase.lpc");
    kblase->setOwner(TP);
    TP->AddPursuer(kblase);
    kblase->move(ENV(TP), M_NOCHECK);
  }
  else {
    sw = sarray[random(sizeof(sarray))][0];
    ss = TP->name(WESSEN) + sarray[random(sizeof(sarray))][1];
  }
  
  write(break_string(sw,78));
  say(break_string(ss,78),TP);
  
  if(!random(3) && present(kblase,environment(TP))) {
    kblase->platze(1);
    chewed--;
  }

  return 1;
}







int cmdSpucke(string str) {
  string what;
  
  notify_fail("Was willst Du ausspucken?\n");
  
  if(!str) return 0;
  if(sscanf(str,"%s aus",what) == 1) str = what;
  if(!id(str)) return 0;
  
  write(break_string("Du spuckst Deinen Kaugummi auf den Boden, "
    "wie ruecksichtslos von Dir.",78));
  say(break_string(TP->name() + " spuckt " + TP->QueryPossPronoun(MALE,WEN) +
    " Kaugummi ruecksichtslos auf den Boden.",78),TP);
    
  remove();
  
  return 1;
}