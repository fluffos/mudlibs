/*
** Eine Plueschaxt Yara@SL
** ---
** 2005-12-06  1.0  Yara  initial version
*/

#include "../def.h"

inherit "/std/weapon";

string *farben = ({"rot","gelb","gruen","blau","weiss","schwarz"});

//////////////////////////////////////////////////////////////////////////////
void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Plueschaxt");
  SetProp(P_NAME_ADJ, ({"winzig",farben[random(sizeof(farben))]}));
  SetProp(P_GENDER, FEMALE);
  AddId(({"axt","plueschaxt"}));
  
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, "Wie suess, eine winzige Axt aus Pluesch. "
                  "Du kannst sie zuecken." );

  SetProp(P_INFO, "Sieht aus, als kaeme die Plueschaxt aus einem "
                  "Kaugummiautomaten.");

  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 0);

  SetProp(P_WC, 0);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS,1);

  SetWieldFunc(TO);
  SetUnwieldFunc(TO);
}

int WieldFunc(object me) {
  SetProp(P_EXTRA_LOOK, "Wie suess, "+TP->Name(WER)+" hat "
                        +name()+" gezueckt.\n");
  return 1;
}

int UnwieldFunc(object me) {
  SetProp(P_EXTRA_LOOK, 0);
  return 1;
}