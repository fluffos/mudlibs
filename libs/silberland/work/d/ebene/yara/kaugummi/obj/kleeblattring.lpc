#include "../def.h"

inherit OBJ+"blechring";

//////////////////////////////////////////////////////////////////////////////
void create() {
  string *keys;
  string item;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Kleeblattring");
  SetProp(P_GENDER, MALE);
  AddId("kleeblattring");

  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, "Du siehst einen kleinen Ring. Er ist nur aus Blech, "
    "wird aber von einem vierblaettrigen gruenen Kleeblatt verziert." );

  AddDetail("kleeblatt", "Eine kleines vierblaettriges Kleeblatt verziert den "
                     "Ring. Es ist gruen bemalt und vielleicht bringt es "
                     "Glueck.");

  AddDetail("glueck", "Das kannst Du wahrhaftig gebrauchen.");

  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}

//////////////////////////////////////////////////////////////////////////////
int WearFunc(object me) {
  object ob;
  SetProp(P_EXTRA_LOOK, TP->name(WESSEN)+
                        " Finger schmueckt "+name(WER,0)+".\n");
  return 1;
}

int RemoveFunc(object me) {
  SetProp(P_EXTRA_LOOK, 0);
  return 1;
}
