#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/players/cirion/projekte/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf einem engen Waldpfad");
  SetProp (P_INT_LONG,
    "Der Dickicht zu beiden Seiten des Waldpfades ist hier zu hohen "+
    "Hecken verwachsen, die ein Durchdringen voellig unmoeglich machen. "+
    "Er wird so zu einer Art Hohlweg, und die seltsam gewundenen und "+
    "verwachsenen Baeume tun ein uebriges dazu, dass kein Lichtstrahl "+
    "jemals den Waldboden hier erreicht. Eine bedrueckende Stille "+
    "herrscht hier, nur dann und wann von einem unnatuerlich wirkenden "+
    "Laut durchbrochen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "./x03y02");
  AddExit ("osten", "./x05y01");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
