#include "../def.h"

inherit ROOM"std_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einem schmalen Waldpfad");
  SetProp (P_INT_LONG,
    "Der schmale Waldpfad verlaeuft hier von West nach Ost. Dichte "+
    "Laubbaeume stehen zu beiden Seiten des Weges und verdunkeln ihn, und "+
    "es ist totenstill. Nur dann und wann hoert man ein seltsames Knacken "+
    "oder den Laut eines Tieres. Seitlich des Weges steht dichtes "+
    "Unterholz, nur nach Nordosten kann man sich vielleicht "+
    "hindurchzwaengen. Nach Osten hin scheint es noch dunkler zu werden, "+
    "waehrend der Wald im Westen wesentlich heller und einladender "+
    "aussieht.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"knacken", "laut"}),
    "Da muesstest Du wohl mal lauschen!");
  AddSound ( ({DEFAULT_SOUND}),
    "Es ist totenstill... moment! - War da nicht ein Knacken? - Nein, Du "+
    "musst Dich wohl getaeuscht haben...");
  AddSound ( ({"knacken"}),
    "Du lauschst... da war doch was? - Nein, es bleibt ruhig wie bisher. "+
    "Vielleicht hast Du Dich wirklich getaeuscht?");
  AddSound ( ({"laut"}),
    "Du lauschst und lauschst - es ist nichts zu hoeren. Seltsam, eben war "+
    "da doch noch ein Laut...");
  AddDetail ( ({"boden", "waldboden"}),
    "Der Waldboden ist von dichtem Unterholz und Gebuesch dicht bedeckt. "+
    "Nur nach Nordosten scheint ein Durchlass im Gebuesch zu sein. Der "+
    "schmale Waldpfad schlaengelt sich von Ost nach West durch den Wald, "+
    "aber auch er ist von Ranken ueberwachsen.");
  AddDetail ( ({"pfad", "waldpfad", "waldweg",
                "weg"}),
    "Der schmale Waldpfad, der sich hier von Ost nach West durch den Wald "+
    "schlaengelt, scheint nicht sehr oft benutzt zu werden, denn er ist "+
    "ueberall von Ranken ueberwachsen, und Fussspuren kannst Du auch keine "+
    "erkennen.");
  AddDetail ( ({"fussspuren", "spuren"}),
    "Du kannst auf dem Pfad keine Spuren erkennen.");
  AddDetail ( ({"ranke", "ranken"}),
    "Ueberall wachsen Ranken aus dem Gestruepp und Unterholz seitlich des "+
    "Weges ueber selbigen. Manche der Ranken scheinen auch Stacheln oder "+
    "Dornen zu haben, wie ein Brombeergestruepp. Beeren kannst Du "+
    "allerdings keine sehen.");
  AddDetail ( ({"beere", "beeren", "brombeere",
                "brombeeren", "brombeergestruepp"}),
    "Da sind keine Brombeeren. Eigentlich sieht das Gestruepp und die "+
    "Ranken auch nur annaehernd wie Brombeergestruepp aus.");
  AddDetail ( ({"dorn", "dornen", "stachel",
                "stacheln"}),
    "Seltsame Dornen und Stacheln haben die Ranken. Besser Du schaust, "+
    "dass Du da nicht drankommst, und Dich nicht im Gestruepp verfaengst.");
  AddDetail ( ({"gebuesch", "gestruepp", "unterholz"}),
    "Bis auf den schmalen Pfad ist der gesamte Waldboden von dichtem "+
    "Gestruepp und Unterholz bedeckt. Ausser im Nordosten scheint scheint "+
    "Durchkommen zu sein, und wenn Du ehrlich bist, moechtest Du auch nicht "+
    "durch dieses dornige und stachelige Gestruepp.");
  AddDetail ( ({"durchkommen", "durchlass"}),
    "Hm, vielleicht koenntest Du Dich nach Nordosten durch das Gestruepp "+
    "zwaengen.");
  AddDetail ( ({"baumkrone", "baumkronen", "himmel",
                "krone", "kronen"}),
    "Je weiter Du nach Osten kommst, desto dichter und undurchlaessiger "+
    "scheinen die Baumkronen zu werden. Sie beugen sich fast drohend ueber "+
    "Dich. Vom Himmel ist hier kaum noch etwas zu erkennen.");
  AddDetail ( ({"baeume", "baum", "laubbaeume",
                "laubbaum", "wald"}),
    "Bei den Baeumen um Dich herum scheint es sich hauptsaechlich um "+
    "Laubbaeume zu handeln: Eschen, Eichen und Buchen wechseln sich ab, nur "+
    "dann und wann siehst Du einen schlankeren Nadelbaum. Aber bei manchen "+
    "Baeumen bist du gar nicht so sicher, ob es sich wirklich um normale "+
    "Laubbaeume handelt, denn sie scheinen in seltsamen Formen zu wachsen.");
  AddDetail ( ({"form", "formen"}),
    "Als Du versuchts, die seltsamen Formen genauer auszumachen, scheint "+
    "es fast so, als wollen sie sich Deinem Blick entziehen. Jedenfalls "+
    "kannst Du nicht genau sagen, was nun an den Baeumen ungewoehnlich oder "+
    "anders ist.");
  AddDetail ( ({"blick"}),
    "Wie willst Du wohl Deinen eigenen Blick untersuchen?");
  AddDetail (({"eiche","eichen", "blatt", "blaetter"}),
    "Grosse, dunkle Eichen mit ihren charakteristischen Blaettern wachsen "
    "zu beiden Seiten des Weges zwischen den andren Baeumen. Sie wirken "
    "alt und ehrwuerdig und scheinen schon seit Ewigkeiten hier zu stehen.");
  AddDetail (({"esche","eschen"}),
    "Zwischen den Baeumen des Waldes sind immer wieder alte, grosse "
    "Eschen.");
  AddDetail (({"buche","buchen"}),
    "Hohe, schlanke Buchen mit ungewoehnlich dichten Kronen, die kaum einen "
    "Sonnenstrahl durchlassen wachsen zwischen den uebrigen Baeumen des "
    "Waldes.");
  AddDetail ( ({"sonnenstrahl", "sonnenstrahlen", "strahl",
                "strahlen"}),
    "Die dichten Baumkronen lassen kaum einen Sonnenstrahl hindurch, und "+
    "wenn, dann erreicht er nicht den Waldboden.");
  AddDetail ( ({"kiefer", "kiefern", "nadelbaeume",
                "nadelbaum"}),
    "Bei den Nadelbaeumen, die vereinzelt zwischen den Laubbaeumen stehen, "+
    "handelt es sich anscheinend um schlanke Kiefern mit etwas weniger "+
    "dichten Kronen.");
  AddDetail ( ({"seite", "seiten"}),
    "Zu beiden Seiten des Weges stehen Laubbaeume und beugen ihre dichten, "+
    "dunklen Kronen ueber ihn.");
  AddDetail ( ({"tier", "tiere"}),
    "Du kannst kein einziges Tier erkennen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./x00y02");
  AddExit ("nordosten", "./x02y01");
  AddExit ("osten", "./x02y02");
  // EXITS END
  SetProp(P_HIDE_EXITS, ({"nordosten"}));

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"zwaeng", "zwaenge"}), "cmd_zwaeng");
}

int cmd_zwaeng (string str)
{
  notify_fail ("Wo durch moechtest Du Dich zwaengen?\n");
  if (!str || member(({"durch dickicht",
                       "durch gestruepp",
                       "durch unterholz",
                       "nach nordosten"}), str) == -1)
    return 0;
  if (!this_player()->move(ROOM"x02y01",M_GO))
    return 0;
  return 1;
}
