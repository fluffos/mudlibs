#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/cirion/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Auf einem schmalen Waldpfad");
  SetProp (P_INT_LONG,
    "Der schmale Waldpfad windet sich von Nord nach Sued durch das dichte "+
    "Dickicht des dunklen Waldes. Rings um den Weg stehen hohe, seltsam "+
    "gewundene und verwachsene Baeume, die unnatuerlich und krank auf "+
    "Dich wirken. Von den Baeumen haenge seltsame Ranken herab, die sich "+
    "manchmal ein wenig bewegen. Manchmal glaubst Du auch irgendwo in der "+
    "Dunkelheit des Waldes eine Bewegung wahrzunehmen, doch Tiere sind "+
    "keine zu sehen, und es ist unnatuerlich still.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./x08y02");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
