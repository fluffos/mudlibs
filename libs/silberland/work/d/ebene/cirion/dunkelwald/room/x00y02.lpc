#include "../def.h"

inherit ROOM"std_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einem schmalen Waldpfad");
  SetProp (P_INT_LONG,
    "Ein schmaler Pfad fuehrt nach Osten tiefer in den Wald hinein. Hohe, "+
    "dunkelgruene Laubbaeume umgeben ihn, und dichtes Unterholz macht ein "+
    "Vorankommen abseits des Pfades unmoeglich. Der Pfad selbst scheint "+
    "nur selten benutzt zu werden, denn ueberall wachsen Ranken ueber ihn "+
    "hinweg, und es scheint so, als wuerde der Wald sein Reich bald "+
    "zurueckerobern. Etwas ruhiger als im Westen ist es hier, und voellig "+
    "windstill.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail (({"waldpfad","pfad","weg"}),
    "Der schmale Waldpfad schlaengelt sich nach Osten hin tiefer in den "
    "dunklen Wald hinein. Rechts und links des Pfades waechst dichtes "
    "Unterholz. Er scheint selten benutzt zu werden, denn ueberall wird "
    "er von Ranken ueberwachsen.");
  AddDetail (({"unterholz","holz","ranke","ranken","buesche"
              ,"rankenpflanzen","gebuesch","gebuesche"}),
    "Dichtes Unterholz waechst zu beiden Seiten des Pfades und macht ein "
    "Verlassen so gut wie unmoeglich. Das Unterholz selbst besteht aus "
    "hohen Bueschen und Rankenpflanzen, deren Ranken auch ueberall ueber "
    "den Pfad hinwegwachsen.");
  AddDetail (({"baeume"}),
    "Dich umgeben im im Wesentlichen grosse, dunkle Laubbaeume, die zu "
    "beiden Seiten des Weges wachsen.");
  AddDetail (({"laubbaum", "laubbaeume", "wald"}),
    "Die meisten Baeume hier sind dunkle, grosse und wahrscheinlich uralte "
    "Laubbaeume. Du erkennst Eichen, Eschen und Buchen, die zu beiden "
    "Seiten des Weges wachsen, aber ab und zu erkennst Du auch einen "
    "einzelnen Nadelbaum, der zwischen den Laubbaeumen steht.");
  AddDetail (({"eiche","eichen"}),
    "Grosse, dunkle Eichen mit ihren charakteristischen Blaettern wachsen "
    "zu beiden Seiten des Weges zwischen den andren Baeumen. Sie wirken "
    "alt und ehrwuerdig und scheinen schon seit Ewigkeiten hier zu stehen.");
  AddDetail (({"esche","eschen"}),
    "Zwischen den Baeumen des Waldes sind immer wieder alte, grosse "
    "Eschen.");
  AddDetail (({"buche","buchen"}),
    "Hohe, schlanke Buchen mit ungewoehnlich dichten Kronen, die kaum einen "
    "Sonnenstrahl durchlassen wachsen zwischen den uebrigen Baeumen des "
    "Waldes.");
  AddDetail (({"nadelbaum","nadelbaeume"}),
    "Vereinzelte Nadelbaeume kannst Du zwischen den Laubbaeumen des Waldes "
    "erkennen. Dabei scheint es sich nur um hohe Kiefern zu handeln.");
  AddDetail (({"kiefer","kiefern"}),
    "Einzelne, hohe Kiefern kannst Du zwischen den uebrigen Baeumen "
    "erkennen. Sie haben einen langen, kahlen Stamm und eine dichte Krone, "
    "die allerdings weniger dicht ist als die der Laubbaeume ringsum, so "
    "dass an diesen Stellen einige hellere Flecken im Wald sind.");
  AddDetail (({"stelle","stellen","fleck","flecken"}),
    "An den Stellen, wo die Kiefern zwischen den Laeubbaeumen stehen, sind "
    "einige heller Stellen inmitten des sonst ziemlich dunklen Waldes.");
  AddDetail (({"boden","waldboden"}),
    "Der Waldboden besteht aus dunkler, weicher Erde und ist fast ueberall "
    "von dichtem Unterholz und Gebuesch bewachsen. Dazwischen liegt "
    "haufenweise altes Laub.");
  AddDetail (({"laub"}),
    "Das Laub ist grossteils schon halb verrottet, es muss schon laengere "
    "Zeit hier herumliegen. Sicherlich wird es auch nie weggeraeumt.");
  AddDetail (({"erde"}),
    "Ganz normale, dunkle, weiche Erde.");
  AddDetail (({"seite","seiten"}),
    "Zu beiden Seiten des Pfades waechst dichtes Unterholz und hohe "
    "Baeume.");
  AddDetail ( ({"himmel", "krone", "kronen", "strahl", "strahlen",
                "sonnenstrahl", "sonnenstrahlen"}),
    "Durch die Kronen der Baeume hindurch ist an manchen Stellen der blaue "+
    "Himmel zu erkennen. Es faellt jedoch selten ein Sonnenstrahl hindurch, "+
    "und wenn, dann erreicht er nicht den Boden.");
  AddDetail ( ({"baumstaemme", "baumstamm", "staemme",
                "stamm"}),
    "Die Staemme der Nadelbaeume sind laenger und schmaeler als die der "+
    "Laubbaeume.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "/d/ebene/lamuerte/wwald/room/16y_30x");
  AddExit ("osten", "./x01y02");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
