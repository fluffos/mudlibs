#include "../def.h"

inherit "std/room";
nosave int last_attack;

void create()
{
  ::create();
  SetProp(P_ATTACK_PROB, 0);
}

void init()
{
  ::init();
  if (QueryProp(P_ATTACK_PROB) && query_once_interactive(this_player()))
  {
    if ( time() - 500 > last_attack - 3 * QueryProp(P_ATTACK_PROB)
      && !this_player()->QueryClass(CL_UNDEAD)
      && !this_player()->QueryProp(P_GHOST)
      && random(109-QueryProp(P_ATTACK_PROB)) < 10 )
    {
      call_out("check_attack",(100 - QueryProp(P_ATTACK_PROB)) + random(100 - QueryProp(P_ATTACK_PROB)),getuid(this_player()));
    }
  }
}

nosave void check_attack(string uid)
{
  object pl;

  if ((pl = present(uid)) && query_once_interactive(pl))
  {
    last_attack = time();
    //TODO: ATTACK!
    tell_room(this_object(), "ATTACK");
  }
}