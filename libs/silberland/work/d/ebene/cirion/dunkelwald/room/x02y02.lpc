#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/players/cirion/projekte/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "An einem umgestuerzten Baum");
  SetProp (P_INT_LONG,
    "Hier ist quer ueber den schmalen Pfad, der sich von West nach Ost "+
    "durch den dichten, dunklen Laubwald windet ein riesiger Eichenstamm "+
    "gestuerzt. Er muss schon sehr lange hier liegen, denn er ist schon "+
    "dicht bewachsen. Es ist totenstill hier, nur dann und wann "+
    "durchbricht ein seltsames Geraeusch die Stille. Rechts und links des "+
    "Pfades waechst undurchdringlicher Dickicht, und nach Osten hin "+
    "scheint der Wald noch dunkler und gespenstischer zu werden.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./x01y02");
  AddExit ("osten", "./x03y02");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
