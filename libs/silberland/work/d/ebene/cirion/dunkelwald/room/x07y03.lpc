#include <properties.h>
#include <moving.h>

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Inmitten eines dunklen Waldes");
  SetProp (P_INT_LONG,
    "Du stehst inmitten des dichten Gestruepps in der Dunkelheit des "
    "seltsamen, unnatuerlich wirkenden Waldes. Das dunkle Blaetterdach "
    "ueber Dir laesst keinen Lichtstrahl hindurch, und es wuerde auch sonst "
    "keiner die Erde erreichen, da sie ueber und ueber mit rankenartigen "
    "Pflanzen bewachsen ist, die Dir immer wieder unangenehm in die Beine "
    "kratzen. Die grossen Laubbaeume sind seltsam verwachsen und scheinen "
    "Dir bedrohlich, und der Dickicht macht eine Fortbewegung in die "
    "meisten Richtungen unmoeglich.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "./x06y04");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
