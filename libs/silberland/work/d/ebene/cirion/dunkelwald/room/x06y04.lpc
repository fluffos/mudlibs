#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/cirion/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Bei einer uralten, knorrigen Eiche");
  SetProp (P_INT_LONG,
    "Du hast Dich durch das Dickicht vorgekaempft, bis Du vor einer "
    "riesigen, uralten, knorrigen Eiche wirklich nicht mehr weiter kommen "
    "kannst. Rund um Dich herum ist der Dickicht so dicht geworden, und "
    "so mit dornigen Bueschen durchsetzt, dass der einzige Ausweg zurueck "
    "nach Nordosten fuehrt. Die Krone der Eiche woelbt sich weit ueber "
    "Dich. Frueher einmal mag sie ein praechtiger Baum gewesen sein, doch "
    "nun sind ihre Aeste verkrueppelt und sie strahlt nur noch eine "
    "Boesartigkeit und einen Hass auf alles Lebende aus, der beinah "
    "koerperlich spuerbar ist. Ihre Blaetter lassen keinen einzigen Strahl "
    "der Sonne durch, so dass das Licht hier aus nicht mehr als einem "
    "duesteren schwummrigen Leuchten besteht, welches aus keiner "
    "bestimmten Quelle zu kommen scheint.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"leuchten", "licht", "lichtquelle", 
                "quelle"}),
    "Ein schwummriges, undefinierbares duesteres Leuchten ist das einzige "+
    "Licht, welches hier zu erkennen ist, und Du kannst keine Lichtquelle "+
    "ausmachen, aus der es zu kommen scheint, denn das dichte dunkle "+
    "Blaetterdach der Eiche ueber Dir laesst keinen einzigen Strahl der "+
    "Sonne hindurch.");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", "./x07y03");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
