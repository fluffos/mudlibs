#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/cirion/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "An einer kleinen steinernen Bruecke");
  SetProp (P_INT_LONG,
    "Der schmale Waldpfad fuehrt hier zu einer Bruecke aus dunklem "+
    "Basaltgestein, die sich nach Suedosten ueber einen kleinen, dunklen "+
    "Fluss woelbt. Rund um Dich herum ist dichtes Unterholz, und hohe, "+
    "dunkle, seltsam verwachsene Baeume ragen ueber Dich herueber. Kein "+
    "Sonnestrahl faellt durch die Blaetter herab, und manche der Baeume "+
    "scheinen sich seltsam zu bewegen, obwohl es voellig windstill ist. "+
    "Immer wieder hast Du das Gefuehl, im Augenwinkel eine Bewegung "+
    "wahrzunehmen, doch wenn Du hinschaust, kannst Du nichts erkennen. Im "+
    "Norden kannst Du eine kleine, seltsame Lichtung erkennen, in deren "+
    "Mitte ein grosser, dunkler Monolith steht.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", "./x06y00");
  AddExit ("norden", "./x07y00");
  AddExit ("suedosten", "./x08y02");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
