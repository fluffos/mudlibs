#include "../def.h"

inherit ROOM"std_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "An einem dunklen Fluss");
  SetProp (P_INT_LONG,
    "Du stehst am Ufer eines kleinen, dunklen Flusses, der hier langsam "+
    "von Nordosten in Richtung Suedwesten fliesst. Es ist hier ziemlich "+
    "finster, das Blaetterdach der seltsamen, gewundenen Baeume laesst "+
    "nicht den kleinsten Lichtrahl hindurch. Rund um Dich herum ist "+
    "dichtes Dickicht, nur nach Nordwesten kann man es vielleicht "+
    "durchdringen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", "./x03y02");
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd(({"spring","spring"}), "cmd_spring");
}

string _query_int_long()
{
  string s, *names;
  int n;

  s = Query(P_INT_LONG);
  names = map_array(filter_array(all_inventory(find_object(ROOM"x05y03")),
                                 #'living),
                    #'name);
  if (n = sizeof(names))
  {
    s += "Am gegenueberliegenden Ufer erkennst Du " + (n==1?"eine":"einige") +
         " Gestalt" + (n==1?"":"en") + ": " +
         call_other("/std/player/soul","CountUp",names);
  }
  return s;
}

int cmd_spring(string str)
{
  notify_fail("Worueber moechtest Du springen?\n");
  if (!str ||
      member(({"ueber fluss",
               "ueber den fluss"}), str) == -1)
    return 0;
  if (this_player()->move(ROOM"x05y03",M_GO|M_SILENT) < 0)
  {
    tell_object(this_player(),
      "Du nimmst zwei Schritte Anlauf, bleibst aber im letzten Augenblick "
      "stehen.\n");
    return 1;
  }
  tell_object(this_player(),break_string(
    "Du nimmst zweit Schritte Anlauf und springst mit einem gekonnten Satz "
    "ueber den dunklen Fluss."));
  tell_room(this_object(),break_string(
    this_player()->Name()+" nimmt zweit Schritte Anlauf und springt mit "
    "einem gekonnten Satz ueber den dunklen Fluss."));
  tell_room(find_object(ROOM"x05y03"),break_string(
    this_player()->Name()+" kommt mit einem gekonnten Satz quer ueber den "
    "dunklen Fluss gesprungen."),({this_player()}));
  return 1;
}
