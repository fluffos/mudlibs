#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/cirion/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "An einem dunklen Basaltmonolithen");
  SetProp (P_INT_LONG,
    "Hier oeffnet sich eine kleine Lichtung im Wald, inmitten der ein "+
    "riesiger Basaltmonolith aufgerichtet wurde. In den Monolithen sind "+
    "seltsame Zeichen graviert, die irgendwie verschwommen wirken. Rund "+
    "um den Monolithen waechst kein Gras, dort ist der Boden einfach nur "+
    "grau. Die Baeume rund um die Lichtung sind hoch und dunkel und "+
    "wirken seltsam unnatuerlich, fast wie bedrohliche Riesen, die Dich "+
    "umringen. Das Loch in der Blaetterdecke ueber Dir laesst zwar Licht "+
    "hindurch, doch der Himmel ist bewoelkt und dunkel, und auch das "+
    "Licht wirkt seltsam falsch und fehl am Platze. Hinzu kommt eine "+
    "unnatuerliche Stille, die kein Laut durchdringt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./x06y00");
  AddExit ("sueden", "./x07y01");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
