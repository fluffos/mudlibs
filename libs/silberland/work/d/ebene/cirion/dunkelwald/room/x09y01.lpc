#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/cirion/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "An einem dunklen Teich");
  SetProp (P_INT_LONG,
    "Nachdem Du ein Stueck am Ufer entlangegangen bist, kommst du an "+
    "einen grossen, dunklen, ja fast schwarzen Teich, der sich von hier "+
    "aus weiter nach Nordosten und Osten erstreckt. Aus ihm wird der "+
    "kleine Fluss gespeist, und er wiederum wird von dem Fluss gespeisst, "+
    "welcher aus dem Norden in den Teich fliesst. Ganz im Osten kannst Du "+
    "erkennen, dass der Teich an einer steilen, dunklen Felswand endet. "+
    "Rund um den Teich herum stehen die Baeume dicht an dicht, in "+
    "seltsamen, verkruemmten Formen gewachsen die widernatuerlich "+
    "erscheinen. Aus den Augenwinkeln meinst Du manchmal eine Bewegung "+
    "wahrzunehmen, doch wenn Du genau hinsiehst, kannst Du nichts "+
    "erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "./x08y02");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
