#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/players/cirion/projekte/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf einem schmalen Waldpfad");
  SetProp (P_INT_LONG,
    "Der schmale Waldpfad macht hier einen leichten Knick nach Nordosten. Es "+
    "ist hier so dunkel, dass Du kaum den Waldboden erkennen kannst. Das "+
    "Dickicht lichtet sich hier ein wenig, und in einige Richtungen ist "+
    "es sicher moeglich, es zu durchdringen. Dafuer haben die Baeume hier "+
    "noch seltsamere Formen, und Du hast fast das Gefuehl, sie wuerden "+
    "Dich beobachten. Es ist voellig still hier, nur dann und wann "+
    "durchbricht ein seltsamer, unnormaler Laut die Stille.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSound ( ({DEFAULT_SOUND}),
    "Es ist voellig still hier. Nur dann und wann durchbricht ein "+
    "seltsamer, unnormaler Laut die Stille.");
  AddSound ( ({"stille"}),
    "Eine unheilvolle, bedrueckende Stille scheint ueber dem gesamten Wald "+
    "zu liegen.");
  AddSound ( ({"laut"}),
    "Hin und wieder durchbricht ein unnatuerlicher Laut die Stille. "+
    "Manchmal ist es ein seltsames, knirschendes Knacken, und ab und zu ist "+
    "auch ein Aechzen zu vernehmen, als wuerde ein Tier unterdrueckt aber "+
    "voller Qual aufstoehnen.");
  AddSound ( ({"knacken"}),
    "Dieses seltsame, knirschende Knacken wird wohl von einem der Baeume "+
    "stammen. Dir bekommst eine Gaensehaut.");
  AddSound ( ({"aechzen"}),
    "Ein stoehnender, unnatuerlicher Laut durchbricht die Stille, dass Du "+
    "verschreckt zusammenzuckst. Es hoert sich fast an wie ein Tier, "+
    "welches vor Qualen aufstoehnt.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./x02y02");
  AddExit ("nordwesten", "./x02y01");
  AddExit ("suedosten", "./x04y03");
  AddExit ("nordosten", "./x04x01");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
