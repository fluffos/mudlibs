#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/cirion/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "An einer kleinen steinernen Bruecke");
  SetProp (P_INT_LONG,
    "Der schmale Waldpfad fuehrt hier zu einer Bruecke aus dunklem "+
    "Basaltgestein, die sich nach Nordosten ueber einen kleinen, dunklen "+
    "Fluss woelbt. Nach Sueden fuehrt der Pfad noch tiefer in den "+
    "dunklen, dichten Wald hinein, dessen seltsame, verdreht gewachsene "+
    "Baeume ueberall um Dich herum wachsen. Kein Sonnenstrahl faellt "+
    "durch ihre Blaetter herab, und es ist weder ein Tier zu sehen noch "+
    "zu hoeren. Zwischen den Baeumen waechst dichtes Dickicht, nur nach "+
    "Nordosten koenntest Du ein Stueck am Fluss aufwaerts gehen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", "./x07y01");
  AddExit ("nordosten", "./x09y01");
  AddExit ("sueden", "./x08y03");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
