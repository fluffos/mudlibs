#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/ebene/cirion/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf einem schmalen Waldpfad");
  SetProp (P_INT_LONG,
    "Der schmale, dunkle Waldpfad macht hier einen Knick von Suedwesten "+
    "nach Suedosten. In Richtung Westen ist das Dickicht fast "+
    "undurchdringlich, doch im Osten kannst Du eine kleine Lichtung im "+
    "Wald erkennen, auf der ein grosser, dunkler Monolith zu stehen "+
    "scheint. Die Baeume um Dich herum sind dicht, laubbewachsen und "+
    "dunkel, und sie lassen keinen Lichtschimmer auf den Waldboden "+
    "durchdringen. Irgendwie scheinen sie seltsam verwachsen und gewunden "+
    "zu sein, und manchmal hast Du im Augenwinkel das Gefuehl, dass einer "+
    "der Baeume Dich anstarrt. Nach Osten und Sueden hin scheinen die "+
    "Baeume noch grosser und kranker gewachsen zu sein.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "./x05y01");
  AddExit ("osten", "./x07y00");
  AddExit ("suedosten", "./x07y01");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
