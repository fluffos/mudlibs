#include "../def.h"

inherit ROOM"std_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Inmitten eines duesteren Waldes");
  SetProp (P_INT_LONG,
    "Du stehst inmitten des duesteren Waldes. Dunkle Laubbaeume erheben "+
    "sich ueber Dir und lassen keinen einzigen Strahl der Sonne bis zum "+
    "Boden gelangen. Du bist nicht einmal sicher, ob dort oben ueberhaupt "+
    "noch die Sonne ist. Auch die Laubbaeume sehen seltsam aus, gewunden, "+
    "fast gequaelt. Dir ist nicht sehr wohl bei Ihrem Anblick. Ausserdem "+
    "ist es hier totenstill, nur dann und wann ist ein seltsames "+
    "Geraeusch zu hoeren, was Dein Unwohlsein eher noch verstaerkt. Rund "+
    "um Dich herum ist dichtes Unterholz, nur nach Suedosten und "+
    "Suedwesten kannst Du vielleicht weiter vordringen.");
  SetProp (P_ATTACK_PROB, 50);
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSound ( ({DEFAULT_SOUND}),
    "Du lauschst...es ist totenstill. Halt - war da nicht eben ein "+
    "Geraeusch?");
  AddSound ( ({"geraeusch"}),
    "Du lauschst noch angestrengter - doch es ist nichts mehr zu hoeren.");
  AddDetail ( ({"anblick"}),
    "Beim Anblick der Baeume hier wird Dir schon etwas anders.");
  AddDetail ( ({"boden", "dickicht", "gestruepp", 
                "unterholz", "waldboden"}),
    "Du stehst hier mitten im dicksten Dickicht, zwischen Gestruepp und "+
    "Unterholz das den gesamten Waldboden ringsum bedeckt und ein "+
    "Vorankommen fast unmoeglich macht. Dicke Ranken wachsen ueberall durch "+
    "das Dickicht.");
  AddDetail ( ({"vorankommen", "vordringen"}),
    "Nach Suedosten oder Suedwesten koennte es Dir vielleicht gelingen, "+
    "durch das Dickicht voranzukommen.");
  AddDetail ( ({"baeume", "baum", "laubbaeume", 
                "laubbaum", "wald"}),
    "Dicht an dicht ragen seltsam gewundene, fast gequaelt aussehende "+
    "Laubbaeume rund um Dich herum aus dem Gestruepp am Boden des Waldes "+
    "heraus. Ihr dichtes Blaetterwerk woelbt sich ueber Dich und verdeckt "+
    "den Himmel.");
  AddDetail ( ({"baumkrone", "baumkronen", "blaetterwerk", 
                "himmel", "krone", "kronen", 
                "sonne", "sonnenstrahl", "sonnenstrahlen", 
                "strahl", "strahlen"}),
    "Das dichte Blaetterwerk der Baumkronen ueber Dir verdeckt den Himmel "+
    "und laesst keinen einzigen Sonnenstrahl hindurch. Du bist gar nicht "+
    "sicher, ob die Sonne ueberhaupt noch dort oben ist.");
  AddDetail ( ({"ranken"}),
    "Dicke, gewunden, teils mit Dornen und Stacheln bewehrte Ranken ragen "+
    "ueberall aus dem Dickicht heraus. Du musst aufpassen, dass Du Dich "+
    "nicht darin verfaengst. Da! - eine der Ranken scheint sich zu bewegen!");
  AddDetail ( ({"ranke"}),
    "Du drehst Dich blitzschnell herum, um nach der Ranke zu sehen - Du "+
    "hast Dich anscheinend getaeuscht. Alle Ranken sind ganz still.");
  AddDetail ( ({"dorn", "dornen", "stachel", 
                "stacheln"}),
    "Die Ranken haben teils dicke Dornen oder Stacheln. Du musst "+
    "aufpassen, dass Du Dich nicht darin verfaengst.");
  AddDetail ( ({"unwohlsein"}),
    "Hier in diesem Wald kann einem wohl nur unwohl sein.");
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "./x01y02");
  AddExit ("suedosten", "./x03y02");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
