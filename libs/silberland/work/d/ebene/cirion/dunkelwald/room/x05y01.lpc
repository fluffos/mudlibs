#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/players/cirion/projekte/dunkelwald/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf einem engen Waldpfad");
  SetProp (P_INT_LONG,
    "Zu beiden Seiten des schmalen Waldpfades waechst hier dichtes "+
    "Dickicht, welches sich zu hohen Hecken verbunden hat, die ein "+
    "Durchdringen voellig unmoeglich machen. Ueber Dir woelbt sich das "+
    "dichte Blaetterdach der seltsam gewachsenen und verwundenen Baeume, "+
    "die keinen Lichtstrahl hindurchlassen. Von einigen Baeumen haengen "+
    "seltsame Ranken herab, und manchmal hast Du das Gefuehl, im "+
    "Augenwinkel eine Bewegung der Ranken zu erkennen. Es ist totenstill, "+
    "nur dann und wann durchdringt ein unnatuerlich wirkender Laut die "+
    "Stille.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./x04x01");
  AddExit ("nordosten", "./x06y00");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
