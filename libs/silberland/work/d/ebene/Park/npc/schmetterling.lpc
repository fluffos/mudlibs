/*
** Ein Schmetterling  (w) Woody@SL
** ---
** 1996-05-04  1.0  Release
*/

inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../park.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein bunter Schmetterling");
  SetProp (P_LONG, "Der Schmetterling flattert aufgeregt in der Luft umher.\n");
  SetProp (P_NAME, "Schmetterling");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Insekt");
  AddId ("schmetterling");
  create_default_npc (2);
  SetProp (P_SIZE, 6);
  SetProp (P_HEAL, 3);
  SetProp (P_MSGIN, "flattert herein");
  SetProp (P_HANDS, ({" mit seinen Fluegeln", 25}));
  SetProp (P_ALIGN, 50);
  SetProp (P_MAX_KILL_LEV, 5);
  SetProp (P_NOKILL_MSG, ({
    "Der Schmetterling entkommt Dir, weil Du schon zu gross fuer ihn bist.\n",
    "Der Schmetterling entwischt @@WEM@@ geschickt.\n"}));
}
