/*
** Ein Igel  (w) Woody@SL
** ---
** 1996-05-03  1.0  Release
*/

inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../park.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Igel");
  SetProp (P_LONG, bs("Der Igel grinst Dich einfach nur frech an. Er "+
    "scheint ausserdem unheimlich stolz auf sein kleines Fellchen zu sein."));
  SetProp (P_NAME, "Igel");
  SetProp (P_GENDER, MALE);
  AddId ("igel");
  create_default_npc (4);
  SetProp(P_RACE, "Igel");
  SetProp (P_HEAL, 10);
  SetProp (P_SIZE, 12);
  SetProp (P_HANDS, ({" mit seinen kleinen Pfoten", 30}));
  SetProp (P_ALIGN, 50);
  SetProp (P_MAX_KILL_LEV, 10);
  SetProp (P_NOKILL_MSG, ({
    "Der Igel sieht Dich und rollt sich erschrocken ein.\n",
    "Der Igel rollt sich erschrocken ein.\n"}));
  SUID;
  CLONEME (OBJ ("ruestung/igelfellteil"));
}
