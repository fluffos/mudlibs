/*
** starter.c  Woody@SL
** ---
** Basisklasse fuer Anfaengermonster, das ab einem bestimmten Level
** nicht mehr angegriffen werden kann. (P_MAX_KILL_LEV)
**
** 15.04.98 - Woody - _query_noattack() -> man kann nimmer Spells ueben :)
**
*/

inherit "std/npc";   // not moving (poor beginners ;))

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../park.h"


create()
{
  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  SetProp(P_SHORT, "Ein Anfaengermonster");
  SetProp(P_NAME, "Anfaengermonster");
  AddId(({"anfaengermonster", "monster"}));
  SetProp(P_MAX_KILL_LEV, 10);
  SetProp(P_NOKILL_MSG, ({"Das Anfaengermonster lacht Dich nur aus.\n",
    "Das Anfaengermonster lacht @@WEN@@ nur aus.\n"}) );
}

/*
explode_str() - ersetzt @@...@@ Makros
-------------
str ......... der String
ob .......... das Objekt, dessen Name eingesetzt werden soll
*/
varargs string explode_str(string str, object ob)
{
  string s,s1,s2,x;
  s2=str;
  s="";
  while (sscanf(s2, "%s@@%s@@%s", s1, x, s2) == 3)
  {
    switch (x)
    {
      case "WER": s+=s1+ob->name(WER,1); break;
      case "WESSEN": s+=s1+ob->name(WESSEN,1); break;
      case "WEM": s+=s1+ob->name(WEM,1); break;
      case "WEN": s+=s1+ob->name(WEN,1); break;
    }
  }
  s+=s2;
  return s;
}

void Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if (enemy->QueryProp(P_LEVEL) > QueryProp(P_MAX_KILL_LEV))
  {
    mixed str;
    if (stringp(str=QueryProp(P_NOKILL_MSG)))
      tell_object (enemy, str);
    else if (pointerp(str)) {
      tell_object (enemy, explode_str(str[0], enemy));
      tell_room (MENV, explode_str(str[1], enemy), ({enemy}));
    }
    enemy->StopHuntFor(ME, 1);
    ME->StopHuntFor(enemy, 1);
    return;
  }
  ::Defend(dam, dam_type, spell, enemy);

}

string _query_noattack()
{
  mixed str;
  if (TP && (TP!=ME) &&
      (TP->QueryProp(P_LEVEL) > QueryProp(P_MAX_KILL_LEV)))
  {
    if (stringp(str=QueryProp(P_NOKILL_MSG)))
      tell_object (TP, str);
    else if (pointerp(str)) {
      tell_object (TP, explode_str(str[0], TP));
      tell_room (MENV, explode_str(str[1], TP), ({ TP }));
    }
    return "scheint kein adaequater Gegner fuer Dich zu sein.";
  }
}

