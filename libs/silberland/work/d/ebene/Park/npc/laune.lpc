/*
** Eine ueble Laune  (w) Woody@SL
** ---
** 1996-05-04  1.0  Release
*/

inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../park.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine ueble Laune");
  SetProp (P_LONG, "Oh weh, was fuer eine ueble Laune!\n");
  SetProp (P_NAME,
    ({"ueble Laune", "ueblen Laune", "ueblen Laune", "ueble Laune"}));
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Monster");
  AddId (({"laune", "ueble laune"}));
  create_default_npc (7);
  SetProp (P_SIZE, 150);
  SetProp (P_HEAL, 20);
  SetProp (P_MSGIN, "greift um sich");
  SetProp (P_HANDS, ({" mit ihrem ganzen Unmut", 50}));
  SetProp (P_ALIGN, -300);
  SetProp (P_MAX_KILL_LEV, 15);
  SetProp (P_NOKILL_MSG, ({bs("Die ueble Laune ist heute viel zu uebel "+
    "gelaunt, um mit einem hohen Spieler wie Dir zu kaempfen."),
    "Die ueble Laune bricht den Kampf mit @@WEM@@ missgelaunt ab.\n"}));
}
