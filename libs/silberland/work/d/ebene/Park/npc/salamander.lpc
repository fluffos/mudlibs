/*
** Ein kleiner Feuersalamander  (w) Woody@SL
** ---
** 1996-05-03  1.0  Release
*/

inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../park.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein roter Feuersalamander");
  SetProp (P_LONG, bs("Der kleine rote Feuersalamander flitzt nervoes hin "+
    "und her, und das in beachtlicher Geschwindigkeit. Bestimmt ist er "+
    "gleich wieder weg.\n"));
  SetProp (P_NAME, "Feuersalamander");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Echse");
  AddId (({"salamander","feuersalamander"}));
  create_default_npc (4);
  SetProp (P_HEAL, 10);
  SetProp (P_SIZE, 20);
  SetProp (P_MSGIN, "flitzt herein");
  SetProp (P_MSGOUT, "flitzt");
  SetProp (P_WIMPY, 20);
  SetProp (P_HANDS, ({" mit seinen kleinen Krallen", 40}));
  SetProp (P_ALIGN, -50);
  SetProp (P_MAX_KILL_LEV, 11);
  SetProp (P_NOKILL_MSG, ({bs("Der kleine rote Feuersalamander flitzt "+
    "durch deine Beine hindurch und grinst Dich von hinten herausfordernd "+
    "und abwartend an."),
    bs("Der kleine rote Feuersalamander flitzt durch @@WESSEN@@ Beine, "+
    "stellt sich abwartend hin und grinst frech.\n")}));
}
