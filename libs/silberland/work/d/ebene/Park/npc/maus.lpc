/*
** Eine Maus  (w) Woody@SL
** ---
** 1996-05-04  1.0  Release
*/

inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../park.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Maus");
  SetProp (P_LONG, bs("Die kleine graue Maus blickt Dich mit ihren noch "+
    "kleineren schwarzen Knopfaugen misstrauisch an.\n"));
  SetProp (P_NAME, "Maus");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Nagetier");
  AddId ("maus");
  create_default_npc (2);
  SetProp (P_SIZE, 12);
  SetProp (P_HEAL, 8);
  SetProp (P_MSGIN, "trappselt herein");
  SetProp (P_HANDS, ({" mit ihren kleinen Pfoten", 25}));
  SetProp (P_ALIGN, 20);
  SetProp (P_MAX_KILL_LEV, 8);
  SetProp (P_NOKILL_MSG, ({"Die Maus ruempft nur veraechtlich die Nase.\n",
    "Die Maus mustert @@WEN@@ amuesiert und trappselt ein Stueck nach hinten.\n"}));
  SUID;
  CLONEME (OBJ("waffe/zahn"));
  command ("zuecke zahn");
}
