/*
** Eine Ameise  (w) Woody@SL
** ---
** 1996-05-04  1.0  Release
*/

inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../park.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Ameise");
  SetProp (P_LONG, bs("Beinahe haettest Du die winzige Ameise uebersehen, "+
    "die da vor Dir auf dem Boden umherhuscht.\n"));
  SetProp (P_NAME, "Ameise");
  SetProp (P_GENDER, FEMALE);
  AddId ("ameise");
  create_default_npc (1);
  SetProp(P_RACE, "Insekt");
  SetProp (P_SIZE, 2);
  SetProp (P_HEAL, 2);
  SetProp (P_MSGIN, "huscht herein");
  SetProp (P_HANDS, ({" mit ihren Fuehlern", 10}));
  SetProp (P_ALIGN, 10);
  SetProp (P_MAX_KILL_LEV, 3);
  SetProp (P_NOKILL_MSG, ({
    "Du bist schon zu gross fuer die kleine Ameise. Du erroetest.\n",
    "Die Ameise weicht geschickt vor @@WEM@@ aus. @@WER@@ erroetet.\n"}));
  SUID;
  CLONEME (OBJ("waffe/azange"));
  command ("zuecke zange");
}
