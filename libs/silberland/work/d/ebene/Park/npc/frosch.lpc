/*
** Ein Frosch  (w) Woody@SL
** ---
** 1996-05-03  1.0  Release
*/

inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../park.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Frosch");
  SetProp (P_LONG, "Der Frosch quakt nur laut vor sich hin und beachtet "+
    "Dich gar nicht.\n");
  SetProp (P_NAME, "Frosch");
  SetProp (P_GENDER, MALE);
  AddId ("frosch");
  create_default_npc (4);
  SetProp(P_RACE, "Frosch");
  SetProp (P_HEAL, 10);
  SetProp (P_SIZE, 12);
  SetProp (P_MSGIN, "huepft herein");
  SetProp (P_HANDS, ({" mit seiner langen Zunge", 30}));
  SetProp (P_ALIGN, -100);
  SetProp (P_MAX_KILL_LEV, 10);
  SetProp (P_NOKILL_MSG, ({
    "Der Frosch huepft geschickt aus Deiner Reichweite.\n",
    "Der Frosch huepft geschickt aus @@WESSEN@@ Reichweite.\n"}));
}
