/*
** Park, base room  (w) Woody@SL
** ---
** Mai 1996  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "../park.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich im Anfaengerpark. Hier koennen Anfaenger "+
    "in Ruhe ihre ersten Kaempfe austragen. Die Sonne scheint Dir auf "+
    "die Nase, die Blumenwiese, auf der Du stehst, gruent und blueht, "+
    "und eigentlich findest Du, das heute ein viel zu schoener Tag ist, "+
    "um wehrlose Tiere zu toeten."));

  SetProp (P_INT_SHORT, "Im Anfaengerpark");

  AddSmell( DEFAULT_SMELL, bs("Du riechst Fruehling, Blumen...*schmacht*... "+
	                      "und Fruehlingsblumen!"));

  AddSmell( ({"blumen", "blume", "bluemchen", "fruehlingsblumen"}),
		bs("Mhhhhmmm........ wie hast Du doch waehrend des strengen "+
		   "Winters den Blumenduft vermisst!"));
	
  AddSmell( ({"fruehling", "fruehjahr"}),
		bs("Fruueeeeeeeeeeeeeeeehlllllllllinggggggggggggggg!"));

  Add

  AddDetail( ({ "nase" }), 
                break_string( "Deine eigene Nase solltest Du doch langsam "+
                "kennen!", 78 ) );
  AddDetail( ({ "gaense" }), 
                break_string( "Noe, Gaense kannst Du, soweit Du auch "+
                "siehst, nicht erblicken.", 78 ) );
  AddDetail( ({ "gaensebluemchen", "bluemchen" }), 
                break_string( "Das Gaensebluemchen hat einen gruenen "+
                "Stengel, leuchtendgelbes Inneres, und weisse Blaetter, die "+
                "allerdings einen roetlichen Hauch besitzen.", 78 ) );
  AddDetail( ({ "blumen" }), 
                break_string( "Viele Blumen verschiedener Herkunft kannst "+
                "Du erkennen. Ein Gaensebluemchen gefaellt Dir besonders.", 78 ) );
  AddDetail( ({ "blumenwiese", "wiese" }), 
                break_string( "Auf der Wiese befinden sich allerhand "+
                "Blumen, die Du von irgendwo her zu kennen scheinst.... "+
                "vielleicht vom Biologieunterricht?", 78 ) );
  AddDetail( ({ "park", "anfaengerpark" }), 
                break_string( "Du stehst im Anfaengerpark. Hier sind nur "+
                "harmlose Monster, die Du auch als Beginner besiegen kannst.", 78 ) );
  AddDetail ("sonne", "Die Sonne strahlt hell von oben herab.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"wand","waende"}),
    "Nicht hier. Sie wuerden Dich nur beengen.\n");
  AddDetail ("weg", "Unter Dir.\n");
}
