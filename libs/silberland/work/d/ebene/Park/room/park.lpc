/*
** Park, base room  (w) Woody@SL
** ---
** Mai 1996  Woody  Release
** Dusty verbessert am 3.5.96
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "../park.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich im Anfaengerpark. Hier koennen Anfaenger "+
    "in Ruhe ihre ersten Kaempfe austragen. Die Sonne scheint Dir auf "+
    "die Nase, die Blumenwiese, auf der Du stehst, gruent und blueht. "+
    "Wie ist das Leben doch schoen!"));

  SetProp (P_INT_SHORT, "Im Anfaengerpark");

  AddSmell( DEFAULT_SMELL, bs("Du riechst Fruehling, Blumen...*schmacht*... "+
                      "und Fruehlingsblumen!"));

  AddSmell( ({"fruehling", "fruehjahr"}),
		bs("Fruueeeeeeeeeeeeeeeehlllllllllinggggggggggggggg!"));

  AddSmell ( ({"gaensebluemchen"}),
		bs("Das Gaensebluemchen hat keinen Geruch, wenigstens keinen, "+
		"den Du hier herausriechen koenntest."));

  AddSound( DEFAULT_SOUND, bs("Du hoerst die Voegel zwitschern, die "+
		     "Tierchen durch die Wiese huschen, diverse Kriechtiere "+
		     "durch die Wiese kriechen...."));
		
  AddSound( ({"voegel", "voeglein"}),
		bs("TSCHIIIIIIIIIIIIIIILLPPPPP"));

  AddSound( ({ "tierchen", "tiere", "kriechtiere" }),
                break_string( "Alle Tiere machen leise Geraeusche, ob sie "+
                "sich unterhalten?", 78 ) );

  AddSound( ({"geraeusche", "geraeusch"}),
		bs("*raschel* *kriech*"));

  AddDetail("leben",
    "In diesem schoenen Park kann man das Leben so richtig geniessen...\n");
  AddDetail( ({ "farbe", "farben" }), 
                break_string( "Ja, es gibt viele Farben auf dieser Welt.", 78 ) );
  AddDetail( ({ "hauch" }), 
                break_string( "Ein Hauch von roetlicher Farbe - wie der "+
                "Sonnenuntergang.", 78 ) );
  AddDetail( ({ "sonnenuntergang" }), 
                break_string( "Der ist jetzt noch nicht, dafuer ist es noch "+
                "zu frueh - ausserdem scheint hier NIE die Sonne "+
                "unterzugehen.", 78 ) );
  AddDetail( ({ "schimmer" }), 
                break_string( "Roetlich. Wie der Sonnenuntergang!!!", 78 ) );
  AddDetail( ({ "blaetter" }), 
                break_string( "Die innen weissen Blaetter haben aussen "+
                "einen leichten roetlichen Schimmer.", 78 ) );
  AddDetail( ({ "inneres" }), 
                break_string( "Leuchtendgelb!", 78 ) );
  AddDetail( ({ "stengel" }), 
                break_string( "Der Stengel des Gaensebluemchens ist gruen.", 78 ) );
  AddDetail( ({ "geraeusche", "geraeusch" }), 
                break_string( "Wie waers, wenn Du nach Geraeuschen lauscht, "+
                "nicht sie untersuchst?", 78 ) );
  AddDetail( ({ "tierchen", "tiere", "kriechtiere" }), 
                break_string( "Alle Tiere machen leise Geraeusche, ob sie "+
                "sich unterhalten?", 78 ) );
  AddDetail( ({"voegel","vogel","amsel","drossel","fink","star","vogelschar"}), 
                break_string( "Amsel, Drossel, Fink und Star, alle Voeglein "+
                "sind schon da.....", 78 ) );
  AddDetail( ({ "nase" }), 
                break_string( "Deine eigene Nase solltest Du doch langsam "+
                "kennen!", 78 ) );
  AddDetail( ({ "gaense" }), 
                break_string( "Noe, Gaense kannst Du, soweit Du auch "+
                "siehst, nicht erblicken.", 78 ) );
  AddDetail( ({ "gaensebluemchen", "bluemchen" }), 
                break_string( "Das Gaensebluemchen hat einen gruenen "+
                "Stengel, leuchtendgelbes Inneres, und weisse Blaetter, die "+
                "allerdings einen roetlichen Hauch besitzen.", 78 ) );
  AddDetail( ({ "blumen" }), 
                break_string( "Viele Blumen verschiedener Herkunft kannst "+
                "Du erkennen. Ein Gaensebluemchen gefaellt Dir besonders.", 78 ) );
  AddDetail( ({ "blumenwiese", "wiese" }), 
                break_string( "Auf der Wiese befinden sich allerhand "+
                "Blumen, die Du von irgendwo her zu kennen scheinst.... "+
                "vielleicht vom Biologieunterricht?", 78 ) );
  AddDetail( ({ "park", "anfaengerpark" }), 
                break_string( "Du stehst im Anfaengerpark. Hier sind nur "+
                "harmlose Monster, die Du auch als Beginner besiegen kannst.", 78 ) );
  AddDetail ("sonne", "Die Sonne strahlt hell von oben herab.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"wand","waende"}),"Nicht hier. Sie wuerden Dich nur beengen.\n");
  AddDetail ( ({"boden", "weg"}), "Unter Dir.\n");
}
