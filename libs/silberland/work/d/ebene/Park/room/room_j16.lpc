
inherit "/d/ebene/Park/room/park";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../park.h"

create()
{
  ::create();
#define AppendProp(x,y) SetProp(x,QueryProp(x)+y)

  AppendProp(P_INT_LONG, "Ein altes, schaebiges Haus steht suedlich von Dir.");

  AddDetail("haus", "Ein altes, schaebiges Haus. Der Schrat wohnt darin.");
  AddDetail("schrat", "Besuch ihn doch einfach mal!");

  AddExit("norden", ROOM("room_j15"));
  AddExit("osten", ROOM("room_k16"));
  AddExit("westen", ROOM("room_i16"));
  AddExit("sueden", "/d/ebene/fidget/schrat/room/hausflur");

  AddItem (NPC("maus"), REFRESH_DESTRUCT);
}
