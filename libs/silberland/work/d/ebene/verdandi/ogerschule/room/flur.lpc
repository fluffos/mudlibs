
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einem Flurbereich einer Ogerhoehle" );
  SetProp( P_INT_LONG,
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10+random(4), 
                           ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddExit( "osten",     "./kueche" );
  AddExit( "norden",    "./bad" );
  AddExit( "nordosten", "./kinderzimmer" );
  AddExit( "westen",    "./room-l7" );
}
