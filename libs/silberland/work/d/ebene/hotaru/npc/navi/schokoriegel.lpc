/*-----------------------------------------------------------------------------\
| Navis Schokoriegel                                   (C) by Hotaru, 09.07.01 |
|------------------------------------------------------------------------------|
| Wird nicht in die Leiche gelegt und zerstoert sich selbst, daher wohl kaum   |
| balancepflichtig.                                                            |
\-----------------------------------------------------------------------------*/

inherit "std/food";

#include <properties.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();

  AddId (({"schokoriegel","riegel"}));
  SetProp (P_SHORT, "Ein leckerer Schokoriegel");
  SetProp (P_LONG,
    "Du siehst einen leckeren Schokoriegel. Er wurde mit Splittern aus "
    "fein gehackten Nuessen bestreut und komplett mit brauner Schokolade "
    "ueberzogen."
  );
  SetProp (P_NAME, "Schokoriegel");
  SetProp (P_NAME_ADJ, "lecker");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 80);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, ({ MAT_MISC_FOOD }));
  SetProp (P_FOOD_INFO, ([
    F_HEAL     : 150+random(50),
    F_SOAK     : 0,
    F_MSG      : "Du futterst genuesslich den Schokoriegel und fuehlst Dich "
                 "deutlich gestaerkt.",
    F_MSG_ROOM : "futtert einen Schokoriegel und sieht deutlich gestaerkt aus."
  ]));
}

void init()
{
  ::init();
  // Remove if inside player
  if (this_player() &&
      interactive(this_player()) &&
      environment(this_object()) == this_player()) {
    tell_object(this_player(),
      "Der Schokoriegel schmilzt in Deinen Haenden.\n"
    );
    call_out("remove",0);
    return;
  }
  // Remove if dropped
  if (this_player() && environment(this_player()) &&
      environment(this_player())->id("Raum")) {
    remove();
    return;
  }
}
