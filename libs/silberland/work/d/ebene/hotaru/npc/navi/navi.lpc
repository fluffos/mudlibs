// === Main functions =======================================================

// See if Navi has no environment and if so, make her move
void CheckEnvironment()
{
  if (!environment())
    move("/gilden/abenteurer", M_GO);
}

// Inspect current room
void GetRoomInfo()
{
  object env, furz;
  string filename, *mout, textout;
  int i;

  if (!this_object() || !env=environment(this_object())) return;
  filename = file_name(env);

  // Are we guiding someone?
  if (FollowingPlayer) {
    // Ensure that the player is not in the death room (simply checking for
    // P_GHOST would not suffice as Navi should also be able to guide ghosts
    // to their praying points)
    if (file_name(environment(FollowingPlayer)) != "/room/death/death_room") {
      // Make player follow
      if (environment(FollowingPlayer) && (environment(FollowingPlayer) != env)) {
        if (!DoSilentMove) {
          tell_object(FollowingPlayer, "Du folgst Navi.\n\n");
          mout = explode(FollowingPlayer->QueryProp(P_MSGOUT),"#");
          textout = mout[0] + " Navi hinterher" + (sizeof(mout)>1?mout[1]:"");
          FollowingPlayer->move(env, M_GO, "",
            textout, FollowingPlayer->QueryProp(P_MSGIN)
          );
        } else {
          FollowingPlayer->move(env, M_NOCHECK|M_SILENT, "", "", "");
          DoSilentMove = 0;
        }
      }
    }
  }

  // Add room to "last visited" queue (max: 50 entries)
  LastVisited -= ({ filename });
  LastVisited += ({ filename });
  if (sizeof(LastVisited) > 50) LastVisited = LastVisited[1..];

  // Explore
  RoomMeetCounter = 0;
  DelayExploreMode(EXP_DELAY);

  // Check for farts and clear the air ;)
  if ((JustGuiding == "") && (find_call_out("furzrache") == -1)) {
    if (present("_furz_", env)) {
      while (furz=present("_furz_", env)) destruct(furz);
      playseq(this_object(), ({
        "@ME ruempft angewidert die Nase.",
        "@ME zueckt ein penetrantes Duftbaeumchen.",
        "@ME flattert in einem Affentempo kreuz und quer durch den Raum.\n"
        "Alle widerlichen Duenste verziehen sich auf einen Schlag.°°",
        "@ME steckt das Duftbaeumchen zufrieden wieder zurueck."
      }));
      DelaySequences = 10;
      call_out("playseq", 10, this_object(), ({}));
      write_log("Verfurzte Luft in " + filename + " gereinigt");
    }
  }

  // Check room and map it
  if (!strstr(filename,"/d/seher/haus/",0)) {
    //say("Navi weigert sich, dieses Seherhaus zu mappen.\n");
    return;
  }
  if (!strstr(filename,"/players/",0)) {
    //say("Navi weigert sich, diesen Workroom zu mappen.\n");
    return;
  }
  if (WAY_MASTER->AddRoom(env)) {
    if (JustGuiding == "") say("Navi kritzelt etwas auf ihre Karte.\n");
  } else {
    //if (JustGuiding == "") say("Navi sieht sich um und nickt wissend.\n");
  }
}

void ShowStats()
{
  object env;
  mapping roommap;
  if (!env=environment(this_object())) return;

  roommap = WAY_MASTER->GetRoomMap();

  say("Navi sagt: Ich kenne schon sagenhafte " + sizeof(m_indices(roommap))
      + " Raeume!\n");
  say("Navi strahlt wie eine ganze Honigkuchenpferdehorde.\n");
  //say("<Navi> Ich kenne schon folgende Räume:\n");
  //say(break_string(implode(m_indices(roommap)," "), 60, "<Navi>   "));
}

// Makes Navi "go away" -> teleport to a random guild
void GoAway()
{
  object env;
  string *targets;
  if (!env=environment(this_object())) return;
  targets = ({
    "/gilden/abenteurer",
    "/gilden/abenteurer/hobbitgilde",
    "/gilden/abenteurer/trollgilde",
    "/gilden/abenteurer/ogergilde",
    "/gilden/abenteurer/elfengilde"
  });
  targets -= ({ file_name(env) });

  move(targets[random(sizeof(targets))], M_NOCHECK|M_SILENT, "", "", "");
  if (!this_object() || !env=environment(this_object())) return;
  tell_room(env, "Navi flattert herein.\n");
}

void GiveMap()
{
  object player;
  if (!player=this_player()) return;
  if (!present("midaskarte", player)) {
    playseq(player, ({
      "@ME sagt: $Oh, ich habe sogar noch eine dabei! Hier...°",
      "@ME gibt @WEM eine Karte.°°",
      "§@ME sagt: $Mit \"unt karte\" kannst Du sehen, wo Du gerade bist."
    }));
    clone_object("/d/ebene/obj/div/midaskarte")->move(player, M_GET|M_SILENT);
  } else {
    playseq(player, ({
      "@ME sagt: $Aber Du hast doch schon eine Karte!°",
      "§@ME sagt: $Mit \"unt karte\" kannst Du sehen, wo Du gerade bist."
    }));
  }
}

