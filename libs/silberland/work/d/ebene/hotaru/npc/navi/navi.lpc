// === Overridden functions and other stuff =================================

// Called when meeting players
void init()
{
  string fname;

  ::init();
  if (TP && interactive(TP)) {
    RoomMeetCounter++;
    DelayExploreMode(EXP_DELAY_MEET);

    fname = file_name(TP);
    if (HelpStatus[fname] && HelpStatus[fname]["guide_einfuehrung"] &&
        HelpStatus[fname]["guide_einfuehrung"] == 3) {
      remove_call_out("guide_laufhilfe_her");
      if (find_call_out("playseq") == -1) {
        playseq(TP, ({"",
          "§@ME sagt: $Super! Nicke, um die Einfuehrung fortzusetzen."
        }));
      }
    }

    //call_out("ausruesten", 2, TP);
    //call_out("greet_part2", 1);
    //call_out("showroominfo",0);
  }
}

// Called every time when Navi enters a room
varargs int move(mixed dest, int method,
                 string dir, string textout, string textin)
{
  int retval;
  retval = ::move(dest,method,dir,textout,textin);
  if ((method & M_GO) || (method & M_TPORT) || (method & M_NOCHECK)) {
    GetRoomInfo();
  }
  return retval;
}

int in_libs(string text)
{
  string tempstr, answer, *libs, *result;
  int i;
  libs = m_indices (libraries);
  answer=0;
  // Search for text in libraries - exact match
  for (i=sizeof(libs)-1; i>=0; i--)
    if (result=INFOLIB_MASTER->GetInfo(libs[i], text, libraries[libs[i]],
        this_player() )) {
      answer=result[0];
      break;
    };
  // No answer found? -> try fuzzy match
  if (!answer) {
    tempstr = FUZZY_MASTER->GetFuzzyCode(text);
    for (i=sizeof(libs)-1; i>=0; i--)
      if (result=INFOLIB_MASTER->GetInfo(libs[i], tempstr, libraries[libs[i]],
          this_player() )) {
        answer=result[0];
        break;
      }
  }
  if (!answer) return 0;
  GuideTarget = "";
  answer = process_string(answer);
  return 1;
}

// Called on "frag navi nach xyz"
int do_frage(string question, string text)
{
  mixed answer, silent;
  string indent, tempstr, fname;
  object *nodeaf;
  int j, foundanswer;

  DelayExploreMode(EXP_DELAY_HELP);
  AddLock(TP, LOCK_ASK);

  // Check for: frage navi nach "waffen" etc.
  if(sscanf(text, "\"%s\"", tempstr)==1) {
    text = "anfuehrungszeichen";
  }
  if(sscanf(text, "<%s>", tempstr)==1) {
    text = "klammern";
  }
  // Analyze question
  tempstr = ParseTarget(text);
  if(sscanf(tempstr, "TARGET %s", tempstr)==1) {
    // Handle way question
    write_log(TP->Name() + " fragt nach: " + text);
    catch_tell(TP->Name() + " fragt Dich: " + text + "\n");
    // Output question to others
    nodeaf=filter_array(all_inventory(environment(PL)), #'living);
    for(j=sizeof(nodeaf)-1;j>=0;j--)
      if(!nodeaf[j]->QueryProp(P_DEAF))
        nodeaf-=({ nodeaf[j] });
    nodeaf+=({ PL });
    say(question, nodeaf);
    return 1;
  }

  answer=indent=0;
  if (!member(infos, text))
  {
    string *libs, *result;
    int i;
    libs = m_indices (libraries);
    // Search for text in libraries - exact match
    for (i=sizeof(libs)-1; i>=0; i--)
      if (result=INFOLIB_MASTER->GetInfo(libs[i], text, libraries[libs[i]],
                                         this_player() )) {
        answer=result[0];
        indent=result[1];
        if (sizeof(result) > 2) silent=result[2];
        break;
      }

    // No answer found? -> try fuzzy match
    if (!answer) {
      tempstr = FUZZY_MASTER->GetFuzzyCode(text);
      for (i=sizeof(libs)-1; i>=0; i--)
        if (result=INFOLIB_MASTER->GetInfo(libs[i], tempstr, libraries[libs[i]],
                                           this_player() )) {
          answer=result[0];
          indent=result[1];
          if (sizeof(result) > 2) silent=result[2];
          break;
        }
    }

    // User asking for himself?
    if (!answer) {
      if (lower_case(text)==lower_case(TP->Name())) {
        answer=
    "sagt: Das bist Du! Ich kann Dir aber nicht viel ueber Dich erzaehlen...\n"
    "sagt: Normalerweise solltest Du Dich ja selbst am besten kennen.\n"
    "grinst.";
        indent="";
      }
    }

    // User asking for a help topic?
    if (!answer) {
      tempstr = regreplace(lower_case(text),"[^a-z]","",1);
      if (tempstr != "") {
        // Try exact match
        if (file_size("/doc/helpdir/" + tempstr) <= 0) {
          // Nothing found? Cut last char...
          tempstr = tempstr[0..<2];
          if (file_size("/doc/helpdir/" + tempstr) <= 0) tempstr = "";
        }
        if (tempstr != "") {
          answer=
    "sagt: Ueber dieses Thema gibt es eine ausfuehrliche Hilfeseite. Tipp\n"
    "sagt: einfach \"hilfe " + tempstr + "\", um sie zu lesen!\n";
          indent="";
        }
      }
    }

    // Still no answer found?
    if (!answer) {
      write_log(TP->Name() + " fragt nach: " + text + " (unbekannt)");
      if( this_interactive() && QueryProp(P_LOG_INFO) )
        smart_npc_log(text);
      text = DEFAULT_INFO;
    }
  }

  if (!answer)  // nothing found in libraries
  {
    if (pointerp(answer=infos[text,0]))
      answer=answer[random(sizeof(answer))];
    indent=infos[text,1];
    silent=infos[text,2];
    foundanswer=0;
  } else {
    write_log(TP->Name() + " fragt nach: " + text);
    foundanswer=1;
  }

  nodeaf=filter_array(all_inventory(environment(PL)), #'living);
  for(j=sizeof(nodeaf)-1;j>=0;j--) {
    fname = file_name(nodeaf[j]);
    if (!(HelpStatus[fname]) ||
        !(HelpStatus[fname]["guide_einfuehrung_lasttime"]) ||
        (time() - HelpStatus[fname]["guide_einfuehrung_lasttime"] > 200)) {
      if(!nodeaf[j]->QueryProp(P_DEAF)) nodeaf -= ({ nodeaf[j] });
    }
  }
  nodeaf+=({ PL, this_object() });

  if (!silent || !intp(silent))
    say(question, nodeaf);

  if ( closurep(answer) )
  {
    answer = funcall(answer, text);
    if (!stringp(answer))
      return 1;
  }
  answer = process_string(answer);

  if (indent)
    answer = break_string(answer, 78, ME->Name(WER,2)+" "+indent, 1);
  else
    answer = break_string(ME->Name(WER,2)+" "+answer, 78, 0, 1);

  // Nice new feature: "say_hello_navi,_help_me" prevents line break
  answer = regreplace(answer, "_", " ", 1);

  if( PL->QueryProp(P_DEAF) )
    tell_object(PL, ME->Name(WER,2)+ " sagt etwas, aber Du kannst nichts "
                "hoeren.\n");
  else
    tell_object(PL, answer);
  if (intp(silent) && silent)
    return 1;
  // small modification to prevent scrolling
  if (!stringp(silent) && foundanswer) {
    indent="";
    silent="antwortet @WEM etwas.";
  }
  if (stringp(silent))
  {
    silent=DefaultReplace(silent,PL);
    silent=process_string(silent);
    if (indent)
      silent = break_string(silent, 78, ME->Name(WER,2)+" "+indent, 1);
    else
      silent = break_string(ME->Name(WER,2)+" "+silent, 78, 0, 1);
    say(silent, nodeaf);
  }
  else
    say(answer, nodeaf);

  return 1;
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

mixed _query_noattack()
{
  object env;
  if (!(TP && interactive(TP))) return 0;
  if (!env=environment(this_object())) return 0;
  if (TP == this_object()) return 0;
  // Don't allow players to kill a helper more than twice
  if (HELP_MASTER->CountHelperKills(TP) >= 2) {
    say(
      TP->Name(WER,1) + " versucht, Navi anzugreifen.\n"
      "Navi schuettelt den Kopf.\n"
      "Navi sagt: Ich kaempfe nicht mehr mit Dir, " + TP->Name(WER,1) + "!\n",
      TP
    );
    write("Navi schuettelt den Kopf.\n");
    return "sagt: Ich kaempfe nicht mehr mit Dir, " + TP->Name(WER,1) + "!";
  }
  // Only fight if level > 35
  if (TP->QueryProp(P_LEVEL) > 35) {
    say(
      TP->Name(WER,1) + " versucht, Navi anzugreifen.\n"
      "Navi schuettelt den Kopf.\n"
      "Navi sagt: Tut mir leid! Die Magier haben mir das Kaempfen verboten.\n",
      TP
    );
    write("Navi schuettelt den Kopf.\n");
    return "sagt: Tut mir leid! Die Magier haben mir das Kaempfen verboten.";

    //AddLock(TP, LOCK_FIGHT);
    //return 0;
  }

  say(
    TP->Name(WER,1) + " versucht, Navi anzugreifen.\n"
    "Navi taetschelt " + TP->Name(WEM,1) + " besorgt den Kopf.\n"
    "Navi sagt: Ich will nicht mit Dir kaempfen, " + TP->Name(WER,1) + "!\n", TP
  );
  write("Navi taetschelt Dir besorgt den Kopf.\n");
  return "sagt: Ich will nicht mit Dir kaempfen, " + TP->Name(WER,1) + "!";
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int retval;
  retval = ::Defend(dam, dam_type, spell, enemy);
  if (this_object() && (this_object()->QueryProp(P_HP) < (300 - random(100)))) {
    if (present("schokoriegel", this_object())) {
      command("iss schokoriegel");
    } else {
      if (QuerySkillAttribute(SA_SPEED) == 100) {
        playseq(enemy, "@ME wird ploetzlich viel schneller!!");
        ModifySkillAttribute(this_object(), SA_SPEED, 260, 60);
      }
    }
  }
  return retval;
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  object env;
  if (victim && FollowingPlayer && (victim == FollowingPlayer)) {
    if (env=environment(this_object())) {
      tell_room(env, "Navi ruft: OH NEIIIN! " + upperstring(JustGuiding) +
                     "!!!\n");
      tell_room(env, "Navi trauert um " + JustGuiding + ".\n");
    }
    if (killer) {
      write_log("Fuehrung abgebrochen: Spieler wurde von " + killer->Name(WEM) +
                " getoetet!");
    } else {
      write_log("Fuehrung abgebrochen: Spieler wurde getoetet!");
    }
    AllowAbort = 1;
    AbortGuide(0);
  }
}

varargs void die(int poisondeath)
{
  if (TP && poisondeath == 0) {
    write_log("Navi umgebracht von " + capitalize(TP->Name()) + "!!!");
    HELP_MASTER->AddHelperKill(TP);
    HELP_MASTER->RemoveHelper(this_object());
  }
  ::die(poisondeath);
}

varargs int remove(int silent)
{
  if (previous_object()) write_log("Navi zerstoert von " +
                                   geteuid(previous_object()) + "/" + 
                                   geteuid(TP) + "!!!");
  HELP_MASTER->RemoveHelper(this_object());
  return ::remove(silent);
}
