          "per","pol",
          "qua","que",
          "rad","rak","ran","ras","ray","ril","ris","rod","roth","ryn",
          "sam","say","shy","skel","sul",
          "tai","tan","tas","ther","tia","tin","ton","tor","tur",
          "um","und","unt","urn","usk","ust",
          "ver","ves","vor",
          "war","wor",
          "yer"
        }),
    "v":({
          "a","e","i","o","u","y"
        }),
    "V":({
          "a","e","i","o","u","y",
          "ae","ai","au","ay",
          "ea","ee","ei","eu","ey",
          "ia","ie",
          "oe","oi","oo","ou",
          "ui"
        }),
    "c":({
          "b","c","d","f","g","h","j","k","l","m","n","p","q","r","s","t","v",
          "w","x","y","z"
        }),
    "B":({
          "b","bl","br",
          "c","ch","chr","cl","cr",
          "d","dr",
          "f",
          "g",
          "h",
          "j",
          "k",
          "l","ll",
          "m",
          "n",
          "p","ph",
          "qu",
          "r","rh",
          "s","sch","sh","sl","sm","sn","st","str","sw",
          "t","th","thr","tr",
          "v",
          "w","wh",
          "z","zh"
        }),
    "C":({
          "b",
