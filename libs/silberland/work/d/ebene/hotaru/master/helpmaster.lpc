#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

#define HELPMASTER_FILE "/d/ebene/hotaru/master/helpmaster"

private mapping helperkills;
nosave mapping helpers;

varargs void SaveData(int savenow);

// === Functions that can be called from outside ============================ \\

void AddHelper(object helper)
{
  if (!helper) return;
  helpers += ([ helper:([]) ]);
}

void RemoveHelper(object helper)
{
  if (!helper) return;
  helpers -= ([ helper ]);
  SaveData();
}

void AddHelperKill(object killer)
{
  string fname;
  if (!killer || !interactive(killer)) return;
  fname = file_name(killer);
  if (!member(helperkills, fname)) {
    helperkills += ([ fname:1 ]);
  } else {
    helperkills[fname] += 1;
  }
  SaveData();
}

int CountHelperKills(object killer)
{
  string fname;
  if (!killer || !interactive(killer)) return 0;
  fname = file_name(killer);
  if (helperkills[fname]) return helperkills[fname];
                     else return 0;
}

int RemoveHelperKills(object killer)
{
  string fname;
  if (!killer || !interactive(killer)) return 0;
  fname = file_name(killer);
  if (member(helperkills, fname)) {
    helperkills -= ([ fname ]);
    SaveData();
    return 1;
  }
  return 0;
}

mixed GetHelperKills()
{
  return helperkills;
}

mixed GetHelpers()
{
  return helpers;
}

// === Internal stuff ======================================================= \\

void create()
{
  // Don't allow master to be cloned
  if (is_clone(this_object())) { destruct(this_object()); return; }

  seteuid(getuid());

  // Load data from savefile
  if (!restore_object(HELPMASTER_FILE)) {
    helperkills = ([ ]);
  }
  helpers = ([ ]);
  
  SaveData();
}

// Saves the data - just call it with "SaveData()", it internally manages not to
// save too often in sequence. Minimum delay between saves is 60 secs.
varargs void SaveData(int savenow)
{
  object ob;
  if (!savenow) {
    // Only call_out if no other SaveData call_out was found
    if (find_call_out("SaveData")==-1) call_out("SaveData", 60, 1);
    return;
  }
  save_object(HELPMASTER_FILE);

  // Clone Navi if necessary
  /*if (!sizeof(helpers)) {
    call_other("/d/ebene/hotaru/npc/navi/navi", "???");
    if (!catch(ob=find_living("navi"))) {
      ob->move("/gilden/abenteurer",M_GO);
    }
  }*/
}