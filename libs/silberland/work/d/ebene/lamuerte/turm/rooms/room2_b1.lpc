#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm");

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INT_LONG,
   "Du betrittst einen weiteren Raum im duesteren Gang. Auch hier, wie anscheinend "+
   "in der ganzen zweiten Etage des Turms, haengt der Boden leicht schief, vom Nordosten "+
   "in den Sueden abfallend. Ein steinerner Torbogen fuehrt im Osten an der Innenseite des "+
   "Gangs in das Zentrum dieser Etage. Die Totenschaedel ueber dem Torbogen beaengstigen "+
   "Dich ein wenig, es scheint als waere dort drinnen eine Art Gruft.");

ZWEITER

  AddDetail("gruft",
   "Du musst schon reingehen um mehr davon zu sehen.");
  
  AddDetail("gefaelle",
   "Es geht tatsaechlich vom Nordosten in den Sueden bergab!");
  
  AddDetail(({"fackel","fackeln"}),
   "Die Fackeln an den Waenden gibt es hier nicht, darum ist es auch sehr dunkel."); 

  AddDetail("geruch",
   "Keine Zeit!");

  AddDetail(({"bogen","torbogen"}),
   "Der Torbogen fuehrt tatsaechlich in eine kleien Gruft der Untoten.");
 
  AddDetail(({"schaedel","totenschaedel"}),
   "Die Schaedel ueber dem Torbogen sind von toten Untoten. *grins*");

  AddDetail(({"seite","innenseite"}),
   "Der Gang besteht aus zwei Mauern. Die Innere hat einen Torbogen.");

  AddDetail("zentrum",
   "Das Zentrum dieser Etage liegt hier gleich ums Eck im Osten.");
  

 AddExit("nordosten", "./room2_a2.lpc" );
 AddExit("osten", "./room2_b2.lpc" );
 AddExit("sueden", "./room2_c1.lpc" );

}

