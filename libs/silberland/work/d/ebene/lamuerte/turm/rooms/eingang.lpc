#include "../turm.h"

inherit "std/room";

#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <moving.h>

int a=0;
string playerin="";

verlassturm();
void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vorm Turm der tausend Tode");
  SetProp(P_INT_LONG, 
      "Du stehst inmitten einer grasbewachsenen Landschaft. Vor Dir erhebt "
      "sich ein steinerner Turm in den Himmel. Du kannst nicht genau erkennen "
      "wie hoch er ist, denn die Spitze verschwindet hinter den Wolken. Im Westen "
      "befindet sich ein Tor welches in den Turm fuehrt, neben dem Tor ist ein "
      "Steinhaufen zu sehn, im Osten fuehrt Dich ein Weg dorthin, wo Du "
      "hergekommen bist.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail( ({"landschaft","gegend"}),
      "Tja, Landschaft soweit Du sehen kannst. Nur dieser Turm stoert die Aussicht.");
  AddDetail( ({"himmel"}), 
      "Es ist etwas bedeckt.");
  AddDetail( ({"aussicht"}),                
      "Die Aussicht waere wunderbar, wuerde der Turm nicht im Wege stehen.");  
  AddDetail( ({"gras"}),
      "Das Gras ist gruen und saftig.");
  AddDetail( ({"spitze"}),
      "Keine Chance die Spitze des Turms hinter den Wolken zu entdecken.");
  AddDetail (({"wolke","wolken"}),
      "Du starrst in die Wolken. Eine davon sieht aus wie Du." );
  AddDetail(({"weg","boden"}),
      "Der Boden ist grasbewachsen. Einige Blumen stehen gelangweilt in der Gegend umher.");
  AddDetail( ({"blume","blumen"}),
      "Eins, zwei, drei, vier, fuenf..... aehm, es sind mindestens mehr als fuenf, da bist Du Dir "
      "ganz sicher.");
  AddDetail("turm",
      "Massiv gebaut, kein 'Fertigteil-Turm', soviel steht fest. Er wirkt bedrohlich auf Dich, es "
      "ist wahrscheinlich nicht ungefaehrlich ihn zu betreten. Ein kleines Schild haengt neben dem Eingang.");  
  AddDetail( ({"mauer", "turmmauer", "wand", "waende"}),
      "Die Turmmauer ist zwar alt sieht aber noch recht passabel aus.");
  AddDetail( ({"fertigteil", "fertigteil-turm"}),
      "Ein Fertigteil-Turm haette nicht so stabile Waende.");
  AddDetail("eingang",
      "Das Tor bildet den Eingang.");
  AddDetail("schild",
      "Man kann es lesen.");
  AddReadDetail("schild",
      "ACHTUNG!!! Es lauern VIELE Gefahren in diesem Turm. Betreten auf eigene Gefahr. Den ersten Heldentod starb "+
      "Zwergenpaladin Orw ohne jede Angst am Don,  8. Jun 2000, 23:40." );

  AddDetail(({"steinhaufen","steine","haufen"}),
      "Bei naeherer Betrachtung stellst Du fest, das die Steine eigentlich kein Haufen sind, sondern "
      "kreisfoermig angeordnet sind. Die Luft ueber dem Steinkreis scheint zu schimmern.");
  AddDetail(({"steinkreis","kreis"}),
      "Der Steinkreis scheint von einer magischen Aura umgeben zu sein.");
  AddDetail("luft",
      "Die Luft ueber dem Steinkreis schimmert, ab und an sieht es so aus als ob man die Umrisse eines "
      "Golems zu erkennen, doch es ist wirklich ein sehr unscharfes Bild.");
  AddDetail("bild",
      "Es ist nicht klar zu erkennen.");
  AddDetail(({"golem","golems"}),
      "Sind die Golems nicht ganz oben im Turm?");
  AddDetail(({"umriss","umrisse"}),
      "Du bist Dir nicht sicher, doch ab und an scheint sich in der schimmernden Luft ueber dem "
      "Steinkreis ein Umriss eines Golems zu sehen zu sein.");
  AddDetail(({"aura"}),
      "Die Aura scheint eine art Schutz zu sein.");
  AddDetail("schutz",
      "Schutz wogegen? Vielleicht soll nicht jeder dorthinkommen.");

  AddCmd(({"betrete","huepf","spring","geh","gehe","steig","steige"}),"teleport");


  AddDetail("tor","Das Tor steht weit offen.");
  //  AddExit( "rein","./room1_d4.lpc" );
  AddExit( "osten","/d/ebene/lostboy/steppe/room/steppe6" );
  AddSpecialExit( "rein","wache" );
}

int teleport(string str)
{ object ob;
  object me;

  notify_fail("Wohin willst du?\n");
  //notify_fail("Als Du bemerkst das nichts passiert, verlaesst Du den Steinkreis wieder.\n");
  //return 0;

  if (!str) return 0;

  if (str == "in kreis" || str == "kreis" || str == "in haufen" || str == "haufen" || str =="steinkreis") { 

    if (!ob=deep_present("todesschienen",this_player()) ||
        IS_WIZARD(this_player()) ) {
      write("Die Aura die den Steinkreis einhuellt haelt Dich ab den Steinkreis zu betreten.\n");
      write("\n");
      say(this_player()->QueryProp(P_NAME)+" donnert gegen eine Aura und wird zurueckgeschleudert.\n");
      return 1;
    }

    write ("Du betrittst den Steinkreis. Du reisst die Augen auf und auf einmal siehst Du...\n");
    say(this_player()->QueryProp(P_NAME)+" betritt einen Steinkreis und verschwindet vor Deinen Augen.\n");

    this_player()->move("/d/ebene/lamuerte/turm/rooms/room3_c4.lpc",M_NOCHECK);


    if (me=find_player("lamuerte"))
      tell_object(me,"[TDTT] "+this_player()->QueryProp(P_NAME)+
          " Teleportiert sich in die Golemzone vom Turm.\n");


    return 1;
  }
}


wache()
{ object me;

  if (this_player()->QueryProp(P_GHOST)==1){
    write("Geister haben keinen Zutritt!\n");
    return 1;
  }

  if (this_player()->QueryProp(P_LEVEL)<20){
    write("Du fuerchtest Dich, dorthin willst Du nicht gehen!\n");
    return 1;
  }


  if (me=find_player("lamuerte"))
  {tell_object(me,"[TDTT] "+this_player()->QueryProp(P_NAME)+
      " betritt gerade den Turm.\n");
  }
  this_player()->move("/d/ebene/lamuerte/turm/rooms/room1_d4.lpc", M_GO, 0, "verschwindet im Turm", "kommt herein");
  return 1;
}

verlassturm()
{
  a=0;
}

string tfunc(string tor)
{
  if (a==0) 
    return "Das "+capitalize(tor)+" ist offen.\n";
  else
    return "Das "+capitalize(tor)+" ist geschlossen.\n";
}

