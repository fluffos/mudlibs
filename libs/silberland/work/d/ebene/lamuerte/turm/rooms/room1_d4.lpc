#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem duesteren Gang");
  SetProp(P_INT_LONG, 
    "Du befindest Dich in einem duesteren Gang. Das Gewoelbe in dem Du "
    "Dich befindest ist aus schweren Steinkloetzen erbaut worden. Alles " 
    "sieht hier herinnen kalt und unheimlich aus, die Dimension scheint hier im Inneren ganz schoen verzerrt zu sein. Die Luft ist feucht und kalt, "
    "so kalt, dass Dir beinahe Dein Atem stockt. Im Westen fuehrt der Gang weiter "
    "ins Innere des Turms, der oestliche Teil fuehrt Dich hier heraus.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({"atem","luft"}),
    "Du hauchst umher, alles ist ok, noch ok.");
  AddDetail( ({"himmel"}), 
    "Himmel gibt es hier herinnen keinen.");
  AddDetail( ({"licht"}),                
    "Von aussen dringt hier kein natuerliches Licht ein. Alles wird von den "  
    "ueberdimensional grossen Fackeln an den Waenden beleuchtet.");         
  AddDetail( ({"fackel","fackeln"}),
    "Die Fackeln haengen in Halterungen an den Waenden.");
  AddDetail( ({"halterung","halterungen"}),
    "Die Halterungen bestehen aus Blech. Fehlende Fackeln in einigen von den Halterungen "+
    "lassen darauf schliessen, dass sie herausgebrochen wurden.");
  AddDetail ("blech",
    "Es sieht nicht sehr stabil aus.");
  AddDetail ("dimension",
      "Ganz schoen verzerrt hier herinnen, Du bekommst beinahe Kopfweh davon.");

ERSTER


//  AddSpecialExit( "osten", "raus" );
  AddExit( "raus", "./eingang.lpc" );
  AddExit("westen", "/d/ebene/lamuerte/turm/rooms/1.lpc" );
  call_other("/d/ebene/lamuerte/turm/rooms/eingang.lpc","???", 0);

}
FACKEL

raus()
{
 find_object("/d/ebene/lamuerte/turm/rooms/eingang.lpc")->verlassturm();
 this_player()->move("/d/ebene/lamuerte/turm/rooms/eingang.lpc", M_GO, 0,
                    "verlaesst den Turm", "kommt aus dem Turm"); 
 return 1;
}
