#include "../turm.h"

inherit "std/room";

#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

void create()
{ 
  ::create();

  SetProp(P_INT_SHORT, "Eine kleine Schatzkammer");
  SetProp(P_INT_LONG, 
    "Du stehst in einer kleinen Schatzkammer, sollte sie nicht jemand vor Dir ausgeraeumt "+
    "haben, koennte es sein, dass Du noch einiges hier drinnen findest. Den einzigen "+
    "Ausgang den Du erblicken kannst, findest Du im Sueden.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN:TT_HOUSE]) );


  AddDetail(({"ausgang","labyrinth"}),
      "Der ist im Sueden.");
  AddDetail(({"kammer","schatzkammer","schatz"}),
           "Du stehst in ihr!");
  AddDetail(({"wand","waende"}),
           "Die Waende bestehen aus Stein.");
  AddDetail("boden",
           "Der Boden auf dem Du stehst besteht so wie fast alles hier drinnen aus Stein.");
  AddDetail("stein",
           "Das Gestein rund um Dich ist Granit.");
  AddDetail("granit",
           "Du untersuchst das Granit, es ist wirklich ein hartes Gestein.");
  AddDetail("gestein",
           "Ja, lauter Granit rund um Dich.");
  AddDetail("decke",
           "Die Decke befindet sich in ca. 2 m ueber Dir. Also hier kommt bestimmt kein Golem herein.");
  AddDetail(({"turm","turms"}),
           "Du befindest Dich im Inneren des Turms am Ende eines Labyrinth.");
  AddDetail("inneren",
           "Damit ist gemeint, das Du im Turm stehst und nicht draussen.");
  AddDetail("ebene",
           "Das hier ist Ebene III, das Labyrinth der tausend Tode. Sie wird von Golems regiert.");
  AddDetail(({"tod","tode"}),
           "Nana, willst Du schon sterben? Sei froh das der Tod nicht hier ist.");
  AddDetail(({"golem","golems"}),
           "Die golems bewohenn die im sueden liegende Ebene und verschieben ab und an die Waende.");
 AddExit("sueden", "./room3_d4.lpc" );

 AddCmd("nimm","nimm");
 AddCmd("trans","nimm");

 CLONEME("/d/ebene/lamuerte/turm/obj/truhe.lpc");
  
}


void treasure()
{object ob;
  string *myitems;
  int *chances,x;

  if(ob=present("schatztruhe"))
      {
      ob->treasure();
      }
}



nimm(string str)
{
  if (IS_WIZARD(this_player()) ) {
   write_file("/d/ebene/lamuerte/turm/NIMM.log","!!!!"+ctime()+": "+capitalize(getuid(this_player()))+":"+this_player()->QueryProp(P_NAME)+" : "+str+"\n");
   }
  else {
   write_file("/d/ebene/lamuerte/turm/NIMM.log",this_player()->QueryProp(P_NAME)+" : "+str+"\n");
   }
}


