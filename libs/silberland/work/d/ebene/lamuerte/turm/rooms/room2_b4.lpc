#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm");
  SetProp(P_INT_LONG, 
    "Der Gang verlaeuft hier vom Sueden kommend in den Nordwesten weiter. Das Licht "+
    "ist hier schon nur mehr sehr schwach, denn es haengen nur noch vereinzelt diese "+
    "Fackeln an den aus Granit geschlagenen Steinen der Mauer. Du bemerkst, dass der Gang "+
    "ein leichtes Gefaelle vom Sueden in den Nordwesten hat. Der Boden hier drinnen "+
    "sollte auch wieder einmal gewischt werden, sieht ja ekelhaft aus.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail("gefaelle",
   "Es geht tatsaechlich im Nordwesten bergab!");
  
  AddDetail(({"fackel","fackeln"}),
   "Die Fackeln geben nur noch schwaches Licht. Sie sind fest in der Wand verankert."); 

  AddDetail("geruch",
   "Du solltest es mit >rieche< probieren!");

  AddSmell("moder",
      "Riecht grauenhaft!!\n");

  AddSmell("knochen",
      "*KLAPPERDIKLAPP DACK KLAPP KLAPP*\n");
  ZWEITER

 AddItem("/d/ebene/lamuerte/turm/npc/skelett.lpc",REFRESH_DESTRUCT);  

 AddExit("nordwesten", "./room2_a3.lpc" );
 AddExit("sueden", "./room2_c4.lpc" );

}

