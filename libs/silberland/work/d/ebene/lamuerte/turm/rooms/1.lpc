#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem tiefen Loch");
  SetProp(P_INT_LONG, 
    "Der vom Osten kommende Gang endet hier im Inneren des Turms vor einem tiefen Loch im Nordwesten. "+
    "Es sieht so aus, als ob dieser Turm keinen Boden haette. Das Innere des Turms ist "+
    "aus dem selben Gestein wie all das Gewoelbe hier herinnen. Im Nordwesten "+
    "siehst Du einige Mauervorspruenge an den Innenwaenden des kreisrunden Turms, welche " +
    "nur erkennbar sind, weil Fackeln ueber ihnen angebracht sind." );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );

  ERSTER

  AddDetail("loch",
   "Das Loch ist sicherlich sehr tief, da Du, wenn Du hinunterblickst, nichts als schwarz "+
   "siehst. Besser man faellt dort nicht rein. Vorsicht bevor Du weitergehst.");

  AddDetail(({"wand","waende"}),
   "Auch hier sind die Waende aus Granit, Einige Fackeln sind darauf angebracht.\n");

  AddDetail( ({"fackel","fackeln"}),
    "Die Fackeln haengen in Halterungen an den Waenden.");

  AddDetail( ({"halterung","halterungen"}),
    "Die Halterungen bestehen aus Blech. Fehlende Fackeln in einigen von den Halterungen "+
    "lassen darauf schliessen, dass sie herausgebrochen wurden.");

  AddDetail ("blech",
    "Das Blech ist teilweise voller Rost.");

  AddDetail ("rost",
   "Braun und scheusslich, Rost eben.");

  AddDetail (({"mauervorsprung","mauervorspruenge","vorsprung","vorspruenge"}),
   "Zum Rueberspringen sind diese Vorspruenge zu weit weg, aber irgendwie muss man ja wohl "+
   "rueberkommen.");

  AddDetail (({"innenwand","innenwaende"}),
   "Auf der kreisrunden Innenwand des Turms befinden sich einige interessant "
   "aussehende Mauervorspruenge, die Du vielleicht naeher betrachten solltest.");

  AddDetail(({"steinplatte","platte"}),
            "Die Platte schwebt ab und an hier vorbei.");

  AddSpecialExit( "nordwesten", "tod" );
  AddSpecialExit( "osten", "raus" );

  call_other("/d/ebene/lamuerte/turm/rooms/platte.lpc","???");
}

FACKEL

int green()
{RemoveSpecialExit( "nordwesten" );
  AddDetail(({"steinplatte","platte"}),
     "Die Platte schwebt vor Dir.");
 AddExit( "nordwesten", "./platte.lpc");
}

int red()
{RemoveExit( "nordwesten" );
  AddDetail(({"steinplatte","platte"}),
     "Die Platte schwebt ab und an hier vorbei.");
  AddSpecialExit( "nordwesten", "tod");
}

int tod(string str) 
{ this_player()->move("/d/ebene/lamuerte/turm/rooms/tod", M_NOCHECK, 0,
                    "stuerzt sich in den Tod", "stuerzt herein");
 return 1;
}

int raus(string str)
{ this_player()->move("/d/ebene/lamuerte/turm/rooms/room1_d4.lpc", M_GO, 0,
                    "geht nach Osten", "kommt herein");
 return 1;
}

