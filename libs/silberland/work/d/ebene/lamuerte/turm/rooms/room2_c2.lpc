#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Gruft Koenig Tomaaukkhen's");

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 2, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INT_LONG,
   "Du betrittst die Gruft von Koenig Tomaaukkhen. Eigentlich ist sie sehr untypisch fuer eine Gruft eines "
   "Koenigs, da sie weder sehr gross ist, noch gibt es irgendwelche prunkvollen Gegenstaende in ihr. Der Sarg "
   "in dem der Koenig begraben wurde, steht lieblos in der Mitte des Raums. Nichtmal er ist mit irgendwelchen "
   "wetvollen Materialien verziert, sondern schlicht und einfach aus Stein gehalten. Der einzige Weg hier raus "
   "liegt im Osten.");

ZWEITER
 
  AddDetail(({"koenig","tomaaukkhen"}),
   "Er ist in diesem schlichten Sarg begraben. Geruechten nach soll er jedoch als Untoter in diesem Sarg liegen.");

  AddDetail(({"untote","untoter"}),
   "Untote gibt es viele in dieser Ebene, doch dieser in dem Sarg vor Dir ist sicher der Brutalste.");
 
  AddDetail(({"geruecht","geruechte","geruechten"}),
   "Sie besagen, er toete jeden der diesen Sarg oeffnet. Anscheinend muss er halbwegs stark sein.");
 
  AddDetail(({"material","materialien"}),
   "Welche denn? Wertvolle gibt es hier drinn keine, darum lassen sie sich auch schlecht untersuchen."); 

  AddDetail(({"sarg","saerge"}),
   "Du suchst herum findest aber nichts degleichen.");
 
  AddDetail("schild",
   "Wie waers mit lesen?");

  AddDetail("warnung",
   "Auf diesem Schild an der Wand ist sie naeher beschrieben.");

  AddDetail(({"bereichen","bereich","eingangsbereich"}),
   "Dieser liegt noerdlich von hier aus gesehen."); 

  AddDetail("gruft",
   "Es sieht es genauso trostlos aus wie im Rest der Gruft, es steht aber ein Sarg hier.");
  
  AddDetail(({"waende","wand"}),
   "Die aus Stein bestehenden Waende sind auch hier uebervoll mit Spinnweben!");
  
  AddDetail(({"netz","spinnennetz","spinnweben","spinnwebe","weben"}),
   "Eins, zwei, drei... Verdammt viele Spinnweben, sehen alle gleich aus.");
   
  AddDetail(({"fackel","fackeln"}),
   "Die Fackeln an den Waenden gibt es hier nicht, darum ist es auch sehr dunkel."); 
 
  AddDetail("gang",
   "Naja, es ist ehere eine Gruft als ein Gang.");

  AddDetail("geruch",
   "Es riecht verdammt modrig hier drinnen!");

  AddDetail(({"bogen","torbogen"}),
   "Der Torbogen fuehrt westlich aus der Gruft der Untoten.");
 
  AddDetail(({"schaedel","totenschaedel"}),
   "Die Schaedel ueber dem Torbogen sind von toten Untoten. *grins*");

  AddDetail("auge",
   "Du greifst Dir ins Auge, autsch das brennt.");

  AddDetail("raum",
   "Es ist eher eine Gruft als ein Raum.");

   AddItem( "/d/ebene/lamuerte/turm/obj/koenigssarg.lpc", REFRESH_REMOVE);

 AddExit("osten", "./room2_c3.lpc" );

}

