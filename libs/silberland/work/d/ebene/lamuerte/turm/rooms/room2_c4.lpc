#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm");
  SetProp(P_INT_LONG, 
    "Du findest Dich in einem duesteren Gang wieder. Hier hast Du festen Boden unter "+
    "Deinen Fuessen. Der Gang verlaeuft den Turm entlang weiter in noerdliche Richtung. "+
    "Runter geht es ueber eine Treppe in die erste Ebene des Todesturms. Einige Fackeln "+
    "schaffen auch hier etwas Licht, so dass Du nicht ganz im Dunklen stehst. Dieser Teil "+
    "des Turms gehoert den Untoten, also jenen, die hier vor Dir gestorben sind und nun als "+
    "Untote den Fluch des Turms buessen muessen.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );
 
  i=0;

  AddSmell(({"moder","fuss","fuesse","geruch"}),
    "Igitt, das ist ja grauenvoll!");


  AddDetail("fluch",
   "Er besagt, dass man als Untoter im Turm weiterlebt wenn man hier drinnen stirbt.");

  AddDetail(({"fuss","fuesse","fuessen"}),
   "Deine Fuesse riechen ein wenig streng.");

  AddDetail("treppe",
   "Die Treppe fuehrt in die erste Etage.");
 
  AddDetail("teil",
   "Was is los? Der Teil in dem Du stehst ist gemeint.");
  AddDetail(({"fackel","fackeln"}),
   "Sie stecken lose in ihren Halterungen und erleuchten den Raum.");
  
  AddDetail(({"halterung","halterungen"}),
   "Diese hier sehen nicht besonders bruchfest aus.");

  AddDetail(({"dunkel","dunklen","dunkl"}),
   "Noch ist es nicht ganz dunkel.");


ZWEITER

  AddDetail("boden",
   "Du siehst etwas Moos. Vielleicht kann man es vom Boden schaben.");

 AddDetail("moos",
     "Es ist gruen und moosig.");

 AddItem( "/d/ebene/lamuerte/turm/obj/stein.lpc", REFRESH_REMOVE);

 AddCmd(({"schab","schabe"}),"sfunc"); 
 AddCmd(({"brich","breche"}),"fackel"); 

 AddExit("norden", "./room2_b4.lpc" );
 AddExit("runter", "./8.lpc" );

}

sfunc(wosn)
 {
  string was,wohin;
  notify_fail("WAS willst Du von WO herunterschaben?\n");
  if(!wosn)
  {
    return 0;
  }

  if(sscanf(wosn,"%s von %s", was , wohin)!=2)
  {
    return 0;
  }

  if (i>=3)
  {write("Es sitzt zu fest.\n");
   return 1;
  }

  if(was=="moos" && wohin == "boden")
  {
     clone_object("/d/ebene/lamuerte/turm/obj/moos.lpc")->move(this_player(),M_NOCHECK);
     write ("Du kratzt etwas Moos vom Boden.\n");
     i++;
     return 1;
  }
  return 1;
}

reset()
 {::reset();
  i=0;
 }

 
FACKEL
