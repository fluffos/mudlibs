#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Gruft");

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 2, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INT_LONG,
   "Dieser Bereich der grossen Gruft ist deutlich enger als der im Norden. Ein kleines Schild an der Wand "+
   "welches blutverschmiert ist soll anscheinend als so eine Art Warnung dienen. Wuerde nicht schaden es zu "+
   "lesen. Auffallend ist weiters, dass sich hier keiner dieser Saerge befindet, welche Dir in den noerdlich "+
   "liegenden Bereichen der Gruft aufgefallen sind. Weiter im Westen geht es ans Ende der Gruft.");

ZWEITER
  AddReadDetail("schild",
   "Achtung, im Westen liegt die Gruft von Koenig Tomaaukkhen, dem ehemaligen Besitzer dieses Turms. "+
   "Betreten auf eigene Gefahr."); 
 
  AddDetail("ende",
   "Das Ende der Gruft ist im Westen, hoffentlich wird es nicht auch Dein Ende!");

  AddDetail(({"sarg","saerge"}),
   "Du suchst herum findest aber nichts dergleichen.");
 
  AddDetail("schild",
   "Wie waers mit lesen?");

  AddDetail("warnung",
   "Auf diesem Schild an der Wand ist sie naeher beschrieben.");

  AddDetail(({"bereichen","bereich","eingangsbereich"}),
   "Dieser liegt noerdlich von hier aus gesehen."); 

  AddDetail("gruft",
   "Es sieht es genauso trostlos aus wie im Rest der Gruft, nur Sarg gibts hier keinen.");
  
  AddDetail(({"waende","wand"}),
   "Die aus Stein bestehenden Waende sind auch hier uebervoll mit Spinnweben!");
  
  AddDetail(({"netz","spinnennetz","spinnweben","spinnwebe","weben"}),
   "Eins, zwei, drei... Verdammt viele Spinnweben, sehen alle gleich aus.");
   
  AddDetail(({"fackel","fackeln"}),
   "Die Fackeln an den Waenden gibt es hier nicht, darum ist es auch sehr dunkel."); 
 
  AddDetail("gang",
   "Naja, es ist ehere eine Gruft als ein Gang.");

  AddDetail("geruch",
   "Es riecht verdammt modrig hier drinnen!");

  AddDetail(({"bogen","torbogen"}),
   "Der Torbogen fuehrt westlich aus der Gruft der Untoten.");
 
  AddDetail(({"schaedel","totenschaedel"}),
   "Die Schaedel ueber dem Torbogen sind von toten Untoten. *grins*");

  AddDetail("auge",
   "Du greifst Dir ins Auge, autsch das brennt.");

  AddDetail("raum",
   "Es ist eher eine Gruft als ein Raum.");

   AddItem( "/d/ebene/lamuerte/turm/obj/sarg.lpc", REFRESH_REMOVE);

 AddExit("norden", "./room2_b3.lpc" );
 AddExit("westen", "./room2_c2.lpc" );

}

