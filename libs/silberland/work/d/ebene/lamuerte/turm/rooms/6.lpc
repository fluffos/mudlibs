#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int stellung=0;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Mauervorsprung im Turm");
  SetProp(P_INT_LONG,
    "Du stehst auf einem Mauervorsprung. Im Sueden liegt das tiefe Loch, welches Dich Dein "+
    "Leben kosten koennte. An der Wand findest Du nebst einigen Fackeln einen Knopf welcher auf "+
    "@@hebel@@ gestellt ist. Das nasskalte Gewoelbe erinnert Dich an nichts Gutes. Selbst auf diesem "+
    "Vorsprung sammelt sich Wasser, welches den Boden rutschig macht und Du vorsichtig sein musst, damit "+
    "Du nicht hinunter faellst.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );

  VORSPRUNG
  AddDetail(({"steinplatte","platte"}),
            "Die Platte schwebt ab und an hier vorbei.");

  AddCmd(({"druecke","drueck"}),"zieh");
  AddCmd("druecke","zieh");
  AddSpecialExit( "sueden", "tod" );
}
int stellk()
{stellung=1-stellung;
 return 1;
}

int stellung()
{return stellung;
}

int zieh(string str)
{
  notify_fail("Worauf willst Du druecken?\n");
  if(!str) return 0;
  if( member( ({"knopf", "auf knopf"}), str)!=-1 )
  { stellk();
    write("Du drueckst auf einen Knopf.\n");
    return 1;
   }
  return 0;
}

hebel()
{if (stellung==1){ return "ein";}
 return "aus";
}

int green()
{RemoveSpecialExit( "sueden" );
  AddDetail(({"steinplatte","platte"}),
            "Die Platte schwebt vor Dir.");
  AddExit( "sueden", "./platte.lpc");
}

int red()
{RemoveExit( "sueden" );
  AddDetail(({"steinplatte","platte"}),
            "Die Platte schwebt ab und an hier vorbei.");
 AddSpecialExit( "sueden", "tod");
}

int tod()
{ this_player()->move("/d/ebene/lamuerte/turm/rooms/tod", M_NOCHECK, 0,
                    "stuerzt sich in den Tod", "stuerzt herein");
 return 1;
}

FACKEL
