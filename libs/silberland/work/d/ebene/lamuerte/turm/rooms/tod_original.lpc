inherit "std/room";  

#include <wizlevels.h>
#include <properties.h>
#include <moving.h>

create()
{
::create();

 SetProp(P_INDOORS, 1);
 SetProp(P_LIGHT, 1);
 SetProp(P_INT_SHORT, "Du bist ...tot");
 SetProp(P_INT_LONG, "Du bist ...tot.\n");
 
 SetProp(P_KILL_NAME, "Der Turm der tausend Tode");

        
}	

init(){
object ob,next;
  ::init();
  write_file("/d/ebene/lamuerte/turm/TODESRAUM.log",ctime()+
          ": Der Turm kostete gerade "+
           this_player()->QueryProp(P_NAME)+" das Leben.\n");
  SetProp(P_KILL_NAME, "Der Turm der tausend Tode");
  this_player()->do_damage(100000,this_object());
   if(ob=present("leiche")) ob->remove();
  call_out("dienow",1);
}


dienow(){
object *things;
object ob,next;
int x;

 if (IS_WIZARD(this_player()) || this_player()->QueryProp(P_TESTPLAYER)) {
   write("Na gut, Dich lass ma mal nicht gleich sterben...\n");
   return 1;
 }

 things=deep_inventory(this_object() )  ;


 for(x=sizeof(things)-1;x>=0;x--){
   ob=things[x];


    if(!ob->short()) {
      ob->move(this_player(),M_NOCHECK);
         write_file("/d/ebene/lamuerte/turm/INVISOBJ.log",ctime()+
         ": Invisobjekt "+file_name(ob)+"\n");
    }
    else if(ob->id("geld") || ob->id("geldboerse") || ob->QueryProp(P_NOBUY)!=0) {
          ob->move("/d/ebene/lamuerte/turm/rooms/schatz.lpc",M_NOCHECK);
    }
    else if((ob->QueryProp(P_NODROP) != 1) || (ob->QueryProp(P_NEVERDROP) != 1) ){
          ob->move("/d/ebene/lamuerte/turm/rooms/supermarkt_store.lpc",M_NOCHECK);
    }
    
 }

}



GetExits()
{
 return "";
}
