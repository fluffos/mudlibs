inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "/d/ebene/Midas/midas.h"
#include "/sys/laden.h"

#define VGL_PREIS 400
#define LAGER ("/d/ebene/lamuerte/turm/rooms/supermarkt_store.lpc")
create()
{
  ::create();
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Im Laden von Los Wucherandos");
  SetProp(P_INT_LONG, bs(
    "Du stehst inmitten einer kleinen Ausbuchtung in einem der Gaenge im "+
    "Turm der tausend Tode. Hinter der Theke steht Wucherandos. Er verkauft "+
    "alles was er in somanchen Leichen findet. Eigentlich ist es ein sehr "+
    "gewinnbringendes Geschaeft, denn Wucherandos hat in "+
    "keinster Weise Anschaffungskosten bei den Dingen die er hier verkauft."));

    SetStorageRoom (LAGER);
  
  AddDetail("boden",
      "Du siehst einige Schleifspuren am Boden.");

  AddDetail(({"spuren","schleifspuren"}),
      "Scheint als kommen sie von den Ruestungsteilen die Wucherandos imer in den Laden schleift.");

  AddDetail(({"teile","ruestungsteile"}),
      "Wucherandos sammelt alle Teile auf die er so im Turm findet und verkauft sie dann.");

  AddDetail("ausbuchtung",
      "Du stehst in der kleinen Ausbuchtung, oestlich fuehrt Dich Dein Weg zurueck ins Labyrinth.");

  AddDetail("theke",
      "Die Theke ist aus dunklem Holz gebaut, hinter ihr steht Wucherandos dem der Laden gehoert.");

  AddDetail("holz",
      "Es ist dunkel gebeizte Buche.");

  AddDetail("buche",
      "Das ist eine Holzart.");
  
  AddDetail(({"art","holzart"}),
      "Jaja... sonst noch was?");

  AddDetail(({"gang","gaenge"}),
      "Die liegen im Osten.");

  AddDetail("turm",
      "Du stehst in ihm.");

  AddDetail(({"leiche","leichen"}),
      "Sei froh das Du keine bist!");

  AddDetail(({"wolle","baumwolle"}),
      "Sieht flauschiwuschelkuschelweich aus.");

  AddDetail("weg",
      "Der Weg von hier nach draussen liegt im Osten.");

  AddDetail(({"tod","tode"}),
      "Du fuehlst Deinen Puls. Alles klar, Du lebst noch.");

  AddDetail("puls",
      "*bumm* *bumm* *bummbumm* *bumm* *bumm* *bummbumm*");

  AddDetail("labyrinth",
      "Es liegt im Osten.");

  AddDetail("geschaeft",
      "Du fragst Dich ob Du nicht auch solch einen Laden aufmachen solltest.");

  AddDetail("laden",
      "Du stehst in ihm.");

  AddDetail(({"kosten","anschaffungskosten"}),
      "Sie sind gleich null!");

  AddDetail(({"dinge","dingen"}),
      "Probier mal zeige!.");

  AddDetail("wucherandos",
      "Eine dunkle Gestalt, eingehuellt in eine schwarze Stoffrobe.");

  AddDetail("gestalt",
      "Wen meinst Du?!");

  AddDetail(({"robe","stoffrobe"}),
      "Die Robe von Wucherandos besteht aus schwarzem Stoff, welcher verhindert, dass man sein Gesicht und seinen "+
      "Koerper sieht.");

  AddDetail("stoff",
      "100% Baumwolle.");

  AddDetail(({"gesicht","koerper"}),
      "Das kannst Du nicht genau erkennen.");

  AddDetail("decke",
      "Nichts wirklich intressantes dort oben.");

  AddDetail("boden",
      "Er besteht unglaublicher weise aus Granit.");

  AddDetail("granit",
      "Es ist hart und steinig.");

  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus Granit.");

  AddSmell(DEFAULT_SMELL,"Es stinkt fuerchterlich hier drinnen.\n");
  RemoveItem( "/obj/entsorg" );

  SetBuyFact (1);
  AddExit("osten", ("/d/ebene/lamuerte/turm/rooms/maze/x1y9"));
}

sell()
{
  notify_fail("Tut mir leid, ich kaufe nichts an! Waer ja viel zu teuer!!!!\n");
  return 0;
}
force_sell() { return sell(); }
evaluate() { return sell(); }

varargs AddFixedObject(string str, int val, mixed ids)
{
    return;
}

