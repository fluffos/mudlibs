inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "Im Labyrinth der tausend Tode");
  SetProp( P_INT_LONG, "Du stehst inmitten eines Labyrinths und hast keine "+
  "Ahnung wohin Du gehen sollst. Es fuehrt nur ein Ausgang weiter in den Gaengen dieses "+
  "riesiegen Gewirrs von Wegen, welches von steinernen Golems bewohnt wird. Du kannst nur "+
  "hoffen bald hier rauszufinden." );
  SetProp( P_LIGHT, 1);
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN:TT_HOUSE]) );
  if(random(1000)>600){
    AddItem("/d/ebene/lamuerte/turm/npc/golem.lpc",REFRESH_NONE)->create_default_golem(random(3)+1,random(2)+1);
  }  
  if(random(1000)>600){
    AddItem("/d/ebene/lamuerte/turm/npc/golem.lpc",REFRESH_NONE)->create_default_golem(random(6)+1,random(3)+1);
  }       
  if(random(1000)>600){
    AddItem("/d/ebene/lamuerte/turm/npc/golem.lpc",REFRESH_NONE)->create_default_golem(random(10)+1,random(4)+3);
  }
  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus Stein. Die Golems verschieben sie ab und an.");
  AddDetail("boden",
      "Der Boden, auf dem Du stehst, besteht so wie fast alles hier drinnen aus Stein.");
  AddDetail("stein",
      "Das Gestein rund um Dich ist Granit.");
  AddDetail("granit",
      "Du untersuchst den Granit, es ist wirklich ein hartes Gestein.");
  AddDetail("gestein",
      "Ja, lauter Granit rund um Dich.");
  AddDetail("decke",
      "Die Decke befindet in ziemlich grosser Hoehe ueber Dir, sonst wuerden ja keine Golems reinpassen.");
  AddDetail(({"labyrinth","labyrinths"}),
      "Du stehst mitten in ihm. Es bildet die dritte Ebene des Turms der tausend Tode.");
  AddDetail(({"turm","turms"}),
      "Du befindest Dich im Inneren des Turms in einem Labyrinth.");
  AddDetail("inneren",
      "Damit ist gemeint, das Du im Turm stehst und nicht draussen.");
  AddDetail("ebene",
      "Das hier ist Ebene III, das Labyrinth der tausend Tode. Sie wird von Golems regiert.");
  AddDetail(({"tod","tode"}),
      "Nana, willst Du schon sterben? Sei froh das der Tod nicht hier ist.");
  AddDetail(({"golem","golems"}),
      "Die Golems bewohnen diese Ebene, und verschieben ab und an die Waende.");
  AddDetail("ahnung",
      "Hmm, wohin sollst Du wohl gehen...");
  AddDetail("ausgang",
      "Ein Ausgang fuehrt Dich hier heraus. Wo jedoch der Ausgang vom Labyrinth ist weisst Du nicht.");
  AddDetail(({"gang","gaenge","gaengen"}),
      "Es gib so viele hier, ein richtiges Gewirr!");
  AddDetail(({"gewirr","gewirrs"}),
      "Naja, so viele Gaenge in so viele Richtungen, das ist doch ein richtiges Gewirr.");
  AddDetail(({"richtung","richtungen"}),
      "Hier gibt es nur eine in die Du weiter kommst...");
  AddDetail(({"weg","wege","wegen"}),
      "Es sind zu viele ,um zu sagen, welcher der richtige Weg ist.");
   AddExit("norden","/d/ebene/lamuerte/turm/rooms/maze/x1y6");
}
