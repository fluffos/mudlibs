#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


object ob;
int i;

void create()
{
  ::create();



  SetProp(P_INT_SHORT, "Ausgang aus dem Labyrinth");
  SetProp(P_INT_LONG, 
      "Hier endet der Turm der tausend Tode in einer grossen Halle, die der "
      "Anfuehrer der Golems. Der Raum hat sowie auch die restliche Ebene "
      "eine Decke in ziemlicher Hoehe, welche ungefaehr sieben Meter ueber "
      "Dir ist. Auf einer der Waende haengt ein kleines Brett welches aus "
      "Holz gefertigt ist. Einige Schriftzeichen lassen vermuten, dass man "
      "es lesen kann. Eine Tuer ist im Norden zu sehen.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_NOQUIT,"Du bist zu sehr mit Kaempfen beschaeftigt um das zu tun.\n");
  i=0;
  
  AddDetail("anfuehrer",
      "Ist er nicht hier?");
  AddDetail("halle",
      "Die Halle ist riesig gross. Alles besteht aus Stein.");
  AddDetail("hoehe",
      "Naja, ganz schoen hoch.");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus Stein.");
  AddDetail("boden",
      "Der Boden auf dem Du stehst besteht so wie fast alles hier drinnen aus Stein.");
  AddDetail("stein",
      "Das Gestein rund um Dich ist Granit.");
  AddDetail("granit",
      "Du untersuchst das Granit, es ist wirklich ein hartes Gestein.");
  AddDetail("gestein",
      "Ja, lauter Granit rund um Dich.");
  AddDetail(({"decke", "golemhoehe"}),
      "Die Decke befindet sich in ca. 7 m ueber Dir. Also ganz normale Golemhoehe.");
  AddDetail(({"labyrinth","labyrinths"}),
      "Du stehst am Ausgang des Labyrinths.");
  AddDetail(({"turm","turms"}),
      "Du befindest Dich im Inneren des Turms am Ende eines Labyrinth.");
  AddDetail("inneren",
      "Damit ist gemeint, das Du im Turm stehst und nicht draussen.");
  AddDetail("ebene",
      "Das hier ist Ebene III, das Labyrinth der tausend Tode. Sie wird von Golems regiert.");
  AddDetail(({"tod","tode"}),
      "Nana, willst Du schon sterben? Sei froh das der Tod nicht hier ist.");
  AddDetail(({"golem","golems"}),
      "Die golems bewohenn die im sueden liegende Ebene und verschieben ab und an die Waende.");
  AddDetail("ausgang",
      "Du befindest Dich ja im Ausgang des Labyrinths. Im Norden koennte es weiter gehen.");
  AddDetail("raum",
      "Du siehst Dich im Raum um, auffaellig ist das Holzbrett.");
  AddDetail(({"brett","holzbrett"}),
      "Man kann es lesen.");
  AddDetail("holz",
      "Duerfte sich um Fichte handeln.");
  AddDetail("fichte",
      "Das Holzbrett an der Wand besteht aus Fichte.");
  AddReadDetail(({"brett","holzbrett"}),
      "ACHTUNG! Hier endet vorerst der Turm der tausend Tode. Im Norden liegt "
      "nur noch eine Schatzkammer, in der wertvolle Gegenstaende verstorbener "
      "Spieler aufbewahrt werden und welche von Ush Nazgul bewacht wird. "
      "Also vergiss es, Ush ist viel zu schwer fuer Dich, Du kommst da nie rein!");
  AddDetail("treppe",
      "Sie fuehrt rauf in die naechste Ebene.");
  AddDetail("schriftzeichen",
      "Duerften sich durch lesen zu einem Satz zusammenfuegen lassen,");
  AddDetail("satz",
      "Lies das Brett.");

  ob=AddItem("/d/ebene/lamuerte/turm/npc/ush.lpc",REFRESH_DESTRUCT);

  // AddExit("rauf", "./room4_d4.lpc");
  AddExit("sueden", "./maze/x9y9.lpc" );

  AddSpecialDetail(({"tuer","eingang","tor","tuere","eingangstor"}),"tfunc");
  AddSpecialExit("norden","ofunc");
  AddCmd("oeffne","aufunc");

}


string tfunc()
{
  if (i==0)
  {
    write("Die Tuer, welche den Eingang zur Schatzkammer darstellt, "+
        "ist fest verschlossen.\nMal mit oeffnen versuchen?\n");
    return "";
  }

  if (i!=0)
  {
    write("Die Tuer zur Schatzkammer steht offen.\n");
    return "";
  }
  write ("error in Door, contact WIZARD!!");
  return "";
}


int aufunc(string str)
{
  object ob;

  if (!str)
  {
    notify_fail("So nicht!\n");
    return 0;
  }

  if (str=="tuer" || str == "tor" || str=="eingangstor")
  {
    if (!IS_WIZARD(this_player()) && !ob=present("ush\ntorkey",this_player()))
    {
      write ("Du brauchst den richtigen Schluessel um hier durchzukommen.\n");
      return 1;
    }

    write("Du steckst den Schuessel ins Schloss, sperrst auf und oeffnest\n"+
        "die Tuer. Durch magische Kraefte verschwindet der Schluessel.\n");
    say(this_player()->QueryProp(P_NAME)+" oeffnet eine Tuer.\n"); 
    if (!IS_WIZARD(this_player())) ob->remove();
    i=1;
    return 1;
  }

  notify_fail("Was willst Du denn oeffnen?\n");
  return 0;
}

int ofunc()
{
  if (i==0)
  {
    write("WUMMMS. Du rennst mit voller Wucht gegen die Tuer!\n");
    this_player()->AddHP(-20);
    return 1;
  }

  this_player()->move("/d/ebene/lamuerte/turm/rooms/schatz.lpc",M_GO,"durch die Tuere");
  return 1;
}


void reset()
{
  ::reset();
  i=0;
}

