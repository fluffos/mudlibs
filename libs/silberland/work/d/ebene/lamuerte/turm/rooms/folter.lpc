#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Folterkammer der Koenigsmumie");
  SetProp(P_INT_LONG, 
    "AUUUUUUUUUUTSCH, Du wurdest wohl von der Koenigsmumie in ihre persoenliche Folterkammer "+
    "gesteckt. Hier wird sie sich nun persoenlich um Deine Leiden unter zwei Augen bemuehen. "+
    "Ob Dich die Mumie wohl noch rauslaesst, bevor Du stirbst?!!");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );
 


}

init()
{::init();
 if(find_call_out("mumrus")==-1) call_out("mumraus",16);
}

int follow_now()
{ object ob;

  if(ob=present("koenigsmumie",this_object())){
     ob->move("/d/ebene/lamuerte/turm/rooms/room2_c2.lpc", M_NOCHECK, "erscheint", "vor Deinen Augen", "erscheint");
  return 1;
  }
 return 1;
}
mumraus()
 {object *people;
  object hp,ob;
  int x;

 people=filter_array(all_inventory(this_object()), #'interactive );
 for(x=sizeof(people)-1;x>=0;x--)
  { if (present(people[x]))
    {tell_object(people[x],"WUMMMMMMMMSS! Die seltame Kraefte reissen Dich wieder zurueck in die Gruft.");
     people[x]->move("/d/ebene/lamuerte/turm/rooms/room2_c2.lpc", M_NOCHECK, "faellt", "aus dem Nichts herein", "faellt aus dem Nichts herein");
    }
   }

 call_out("follow_now",4);
 return 1;
  
 }

