#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i=1;
int j=8;

string *DIRS = ({ "suedosten", "sueden", "suedwesten", "westen", "nordwesten", "norden", "nordosten", "osten" });

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer schwebenden Steinplatte");
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf einer schwebenden Steinplatte. Alles ist sehr "+
    "wacklig hier. Du hast Angst in eine der Richtungen zu gehen, denn unter Dir "+
    "ist ein tiefes, schwarzes Loch. Dieses Loch wuerde den sicheren Tod fuer "+
    "Dich bedeuten. Wenn Du nur wuesstest welchen Ausgang Du nehmen sollst.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );

  AddSpecialDetail(({"kompass","richtungsstein"}),"kompass");

  AddDetail(({"stein","platte","steinplatte"}),
   "Die Steinplatte schwebt ueber diesem tiefen Loch. Sie ist sehr wackelig. "+
   "Ein kleines Ornament welches in einem Stein der Platte ist, sticht Dir ins Auge.");
  
  AddDetail(({"angst"}),
   "Du machst Dir vor Angst beinahe in die Hosen.");
  
  AddDetail(({"hose","hosen"}),
   "Uii, gestrichen voll...");

  AddDetail(({"ausgang","richtungen","richtung"}),
   "Du bist Dir ganz und gar nicht sicher welche die richtige Richtung ist.");

  AddDetail(({"loch"}),
   "Das Loch wuerde Dich sicher umbringen.\n");

  AddDetail(({"tod", "sterben"}),
   "MAMIII! Du bist zu jung zum Sterben!\n");
 
  AddDetail(({"wand","wande"}),
   "Die Steinplatte is von keinen Waenden umgeben."); 

  AddDetail("decke",
   "Die Decke ist zwei Meter ueber Dir.");

  AddDetail("boden",
   "Du stehst auf einer Steinplatte.");
 
  AddDetail("ornament",
   "Das Ornament erinnert Dich an einen Kompass.");

 call_out("beweg",5);
 call_out("initall",1);
}

int initall()
{int x;

 call_other("/d/ebene/lamuerte/turm/rooms/1.lpc","???");
 call_other("/d/ebene/lamuerte/turm/rooms/2.lpc","???");
 call_other("/d/ebene/lamuerte/turm/rooms/3.lpc","???");
 call_other("/d/ebene/lamuerte/turm/rooms/4.lpc","???");
 call_other("/d/ebene/lamuerte/turm/rooms/5.lpc","???");
 call_other("/d/ebene/lamuerte/turm/rooms/6.lpc","???");
 call_other("/d/ebene/lamuerte/turm/rooms/7.lpc","???");
 call_other("/d/ebene/lamuerte/turm/rooms/8.lpc","???");

 for (x=0;x<=7;x++)
 {AddExit(DIRS[x],"/d/ebene/lamuerte/turm/rooms/tod.lpc");
 }
}

kompass()
{
 return("Er zeigt nach "+DIRS[i-1]+".\n");
}

int beweg()
{
 i++;
 j=j+1;
 if (j>=9) j=1;
 if (i>=9) i=1;

 find_object("/d/ebene/lamuerte/turm/rooms/"+i+".lpc")->green();
 find_object("/d/ebene/lamuerte/turm/rooms/"+j+".lpc")->red();
 tell_room(this_object(),"Der schwebende Stein bewegt sich.\n");
 
 tell_room(find_object("/d/ebene/lamuerte/turm/rooms/"+i+".lpc"),"Der Boden beginnt zu beben. Eine schwebende Steinplatte erscheint.\n");
 tell_room(find_object("/d/ebene/lamuerte/turm/rooms/"+j+".lpc"),"Der Boden hoert auf zu beben. Die Steinplatte verschwindet.\n");
 
 RemoveExit(DIRS[i-1]);
 AddExit(DIRS[i-1],"/d/ebene/lamuerte/turm/rooms/"+i+".lpc");
 RemoveExit(DIRS[j-1]);
 AddExit(DIRS[j-1],"/d/ebene/lamuerte/turm/rooms/tod.lpc");
 
//write(DIRS[i-1]+"\n"+DIRS[j-1]+"\n");

 call_out("beweg",15);

 return 1;
}
