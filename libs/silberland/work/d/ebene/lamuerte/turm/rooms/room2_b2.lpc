#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Gruft");

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 2, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INT_LONG,
   "Du findest Dich in einem Raum der grossen Gruft wieder. An einer der Waende ist ein "+
   "steinerner Sarg zu sehen welcher mit Spinnweben behangen ist. Hier drinnen ist "+
   "es deutlich kuehler als in den aeusseren Gaengen der zweiten Etage. Weiter in den Osten "+
   "gelangst Du tiefer ins Innere der Gruft, im Westen fuehrt Dich Dein Weg durch einen Torbogen aus der Gruft "+
   "heraus.");

ZWEITER

  AddDetail("gruft",
   "Dir stechen die Saerge welche gegen die Wand gelehnt sind ins Auge.");
  
  AddDetail(({"waende","wand"}),
   "Die aus Stein bestehenden Waende sind uebervoll mit Spinnweben! Ein Sarg sticht Dir ins Auge.");
  
  AddDetail(({"netz","spinnennetz","spinnweben","spinnwebe","weben"}),
   "Eins, zwei, drei... Verdammt viele Spinnweben, sehen beinahe alle gleich aus, bis auf die Mittlere.");
   
  AddDetail(({"mittlere"}),
   "Das Spinnennetz in der Mitte hat einen Riss.");
 
  AddDetail("riss",
   "Du blickst durch den Riss im Netz und entdeckst ein Loch dahinter in der Wand durch welches der Wind pfeift.");

  AddDetail("wind",
   "Der Wind blaest Dir ins Gesicht.");
  
  AddDetail("gesicht",
   "Du fummelst in Deinem Gesicht herum.");
 
  AddDetail("loch",
   "Es ist zu Dunkel um was zu sehen, aber man kann in das Loch greifen.");
 
  AddDetail(({"fackel","fackeln"}),
   "Die Fackeln an den Waenden gibt es hier nicht, darum ist es auch sehr dunkel."); 
 
  AddDetail("gang",
   "Naja, es ist ehere eine Gruft als ein Gang.");

  AddDetail("geruch",
   "Es riecht verdammt modrig hier drinnen!");

  AddDetail(({"bogen","torbogen"}),
   "Der Torbogen fuehrt westlich aus der Gruft der Untoten.");
 
  AddDetail(({"schaedel","totenschaedel"}),
   "Die Schaedel ueber dem Torbogen sind von toten Untoten. *grins*");

  AddDetail("auge",
   "Du greifst Dir ins Auge, autsch das brennt.");

  AddDetail("raum",
   "Es ist eher eine Gruft als ein Raum.");

   AddItem( "/d/ebene/lamuerte/turm/obj/sarg.lpc", REFRESH_REMOVE);

 AddCmd(({"greif","greife"}),"gfunc");

 AddExit("osten", "./room2_b3.lpc" );
 AddExit("westen", "./room2_b1.lpc" );

}

gfunc(wosn)
 {
  string wohin;
    notify_fail("Wohin willst Du greifen?\n");

  if(!wosn)
  {
    return 0;
  }

  if(sscanf(wosn,"in %s", wohin)!=1)
  {
    notify_fail("Greife in was?\n");
    return 0;
  }

  if (i>=1)
  {write("Du fummelst im Loch herum, findest aber nichts.\n");
   return 1;
  }


  if(wohin=="loch")
  {
     if(random(1000)>(this_player()->QueryAttribute(A_DEX))*2)
     {
      write("Autsch, Du zwickst Dir die Finger ein.\n");
      this_player()->reduce_hit_point(5+random(10));
      return 1;
     }

     clone_object("/d/ebene/lamuerte/turm/obj/heiltrank.lpc")->move(this_player(),M_NOCHECK);
     write ("Du holst einen kleinen Trank aus dem Loch.\n");
     i++;
     return 1;
  }
  return 0;
}

reset()
 {::reset();
  i=0;
 }
