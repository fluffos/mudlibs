inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "Im Labyrinth der tausend Tode");
  SetProp( P_INT_LONG, "In diesem Teil des Labyrinths fuehrt Dich Dein Weg in zwei Richtungen "+
  "weiter auf der Suche nach dem Ausgang. Ein Hinweis, wo der Ausgang wirklich liegt, waere "+
  "nicht schlecht, doch die Golems verraten es mit Sicherheit nicht." );
  SetProp( P_LIGHT, 1);
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN:TT_HOUSE]) );
  
  if(random(1000)>600){ 
   AddItem("/d/ebene/lamuerte/turm/npc/golem.lpc",REFRESH_NONE)->create_default_golem(random(3)+1,random(1)+1);
  }
  if(random(1000)>800){
    AddItem("/d/ebene/lamuerte/turm/npc/golem.lpc",REFRESH_NONE)->create_default_golem(random(6)+1,random(3)+1);
  }  
  if(random(1000)>400){
    AddItem("/d/ebene/lamuerte/turm/npc/golem.lpc",REFRESH_NONE)->create_default_golem(random(10)+1,random(4)+1);
  }       

  AddDetail(({"wand","waende"}),
           "Die Waende bestehen aus Stein. Die Golems verschieben sie ab und an.");
  AddDetail("boden",
           "Der Boden, auf dem Du stehst, besteht so wie fast alles hier drinnen aus Stein.");
  AddDetail("stein",
           "Das Gestein rund um Dich ist Granit.");
  AddDetail("granit",
           "Du untersuchst den Granit, es ist wirklich ein hartes Gestein.");
  AddDetail("gestein",
           "Ja, lauter Granit rund um Dich.");
  AddDetail("decke",
           "Die Decke befindet in ziemlich grosser Hoehe ueber Dir, sonst wuerden ja keine Golems reinpassen.");
  AddDetail(({"labyrinth","labyrinths"}),
           "Du stehst mitten in ihm. Es bildet die dritte Ebene des Turms der tausend Tode.");
  AddDetail(({"turm","turms"}),
           "Du befindest Dich im Inneren des Turms in einem Labyrinth.");
  AddDetail("inneren",
           "Damit ist gemeint, das Du im Turm stehst und nicht draussen.");
  AddDetail("ebene",
           "Das hier ist Ebene III, das Labyrinth der tausend Tode. Sie wird von Golems regiert.");
  AddDetail(({"tod","tode"}),
           "Nana, willst Du schon sterben? Sei froh das der Tod nicht hier ist.");
  AddDetail(({"golem","golems"}),
           "Die Golems bewohnen diese Ebene, und verschieben ab und an die Waende.");

  AddDetail("suche",
      "Du suchst wohl den Ausgang. Wenn man lang genug herumlaeuft, findet man ihn sicher.");
  AddDetail("ausgang",
      "Such ihn doch!");
  AddDetail("hinweis",
      "Ein Hinweis wuerde es zu leicht machen, so gross ist das Labyrinth dann auch wieder nicht.");
  AddDetail("teil",
      "Dieser Teil ist eine Art Gang, welcher in zwei Richtungen fuehrt.");
  AddDetail("gang",
      "Der Gang besteht komplett aus Granit.");
  AddDetail("weg",
      "Hmm, geh einfach dem richtigen Weg nach.");
  AddDetail("suche",
      "Was suchst Du? Hast Du was verloren?!");
   AddExit("westen","/d/ebene/lamuerte/turm/rooms/maze/x3y7");
   AddExit("osten","/d/ebene/lamuerte/turm/rooms/maze/x5y7");
}
