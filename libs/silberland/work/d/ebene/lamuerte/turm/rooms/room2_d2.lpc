#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm");
  SetProp(P_INT_LONG, 
    "Du findest Dich in einem engen Teil eines Gangs der zweiten Ebene im Turm der tausend "+
    "Tode wieder. Das Klappern, welches auch im Nordwesten zu hoeren war, ist hier schon "+
    "deutlich lauter geworden. Es ist ganz klar zu erkennen das es aus dem Osten kommt. "+
    "Ein kleiner Riss zwischen den Fackeln an einer der Waende scheint recht auffaellig zu sein. Der staendig " +
    "abfallende Gang geht natuerlich auch hier vom Nordwesten in den Osten weiterlaufend "+
    "leicht bergab." );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );
 
  i=0;

  AddSmell(({"fuss","fuesse","geruch"}),
    "Igitt, das ist ja grauenvoll!");

  AddSound(({"knochen","zerbrechen","brechen","klappern"}),
    "Knirsch, Knarr, Knirsch, Knarr... Ein lautes Geraeusch ist aus dem Osten zu hoeren.");

  AddDetail(({"fackel","fackeln"}),
   "Sie stecken lose in ihren Halterungen und erleuchten den Raum.");
  
  AddDetail(({"halterung","halterungen"}),
   "Diese hier sehen nicht besonders bruchfest aus.");

  AddDetail(({"untote","untoter","untoten"}),
   "Dieser Teil des Turms gehoert den Untoten. Hoffentlich erschlaegt Dich keiner!");
  
  AddDetail("teil",
   "Du kannst nichts besonderes daran erkennen."); 
 
  AddDetail(({"brocken","fleischbrocken"}),
   "Igitt die sehen ja grauenhaft aus.");

ZWEITER

  AddDetail(({"wand","waende"}),
   "Die Waende bestehen auch hier aus Gestein. An einer kannst Du einen Riss ausmachen.");


  AddDetail("riss",
   "Es ist zu dunkel um zu sehen was sich in dem Riss befindet. Man koennte aber mit den Fingern "+
   "reingreifen.");

 AddDetail(({"finger","fingern"}),
   "Sie sind schmutzig.");
 
 AddCmd(({"greif","greife"}),"gfunc"); 
 AddCmd(({"brich","breche"}),"fackel"); 
 AddExit("nordwesten", "./room2_c1" );
 AddExit("osten", "./room2_d3" );

}

gfunc(wosn)
 {
  string wohin;
    notify_fail("Wohin willst Du greifen?\n");
  if(!wosn)
  {
    return 0;
  }

  if(sscanf(wosn,"in %s", wohin)!=1)
  {
    notify_fail("Greife in was?\n");
    return 0;
  }

  if (i>=1)
  {write("Du fummelst im Riss herum, findest aber nichts.\n");
   return 1;
  }

  if(wohin=="riss")
  {
     if(random(500)>(this_player()->QueryAttribute(A_DEX))*2)
     {
      write("Autsch, Du zwickst Dir die Finger ein.\n");
      this_player()->reduce_hit_point(20);
      return 1;
     }

     clone_object("/d/ebene/lamuerte/turm/obj/heiltrank.lpc")->move(this_player(),M_NOCHECK);
     write ("Du holst einen kleinen Trank aus dem Riss.\n");
     i++;
     return 1;
  }
  return 0;
}

reset()
 {::reset();
  i=0;
 }

 
FACKEL
