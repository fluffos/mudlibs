#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int i;

check_maze();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eingang zur dritten Ebene");
  SetProp(P_INT_LONG, 
    "Du findest Dich im Eingangsbereich der dritten Ebene im Turm der tausend Tode wieder. "+
    "Vor Dir liegt ein Labyrinth welches Du im Norden betreten kannst. Es ist verhaeltnissmaessig "+
    "klein, doch es aendert von Zeit zu Zeit sein Aussehen, weil die in ihm lebenden Golems die "+
    "Waende ab und an verschieben. In einer Ecke dieses Raums fuehrt eine schmale Treppe runter in die "+
    "zweite Ebene des Turms, an einer Wand ist ein Steinkreis zu sehen.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );
 
  i=0;

DRITTER

  AddDetail("aussehen",
   "Man kann nicht genau sagen wie das Labyrinth momentan aussieht da es oft sein Aussehen veraendert.");

  AddDetail(({"eck","ecke"}),
   "Dort befindet sich eine kleine Treppe die in die zweite Etage fuehrt.");
  
  AddDetail("treppe",
   "Sie fuehrt nach unten in die zweite Etage des Turms.");

  AddDetail(({"teil","bereich","eingangsbereich"}),
   "In diesem Teil befindet sich der Eingang in das Labyrinth.");
  
  AddDetail("eingang",
   "Der liegt im Norden.");

  AddDetail(({"steinhaufen","steine","haufen"}),
      "Bei naeherer Betrachtung stellst Du fest, das die Steine eigentlich kein Haufen sind, sondern "+
      "kreisfoermig angeordnet sind. Die Luft ueber dem Steinkreis scheint zu schimmern.");
  AddDetail(({"steinkreis","kreis"}),
      "Der Steinkreis scheint von einer magischen Aura umgeben zu sein.");
  AddDetail("luft",
     "Die Luft ueber dem Steinkreis schimmert, ab und an sieht es so aus als ob man die Umrisse eines "+
     "Golems zu erkennen, doch es ist wirklich ein sehr unscharfes Bild.");
  AddDetail("bild",
     "Es ist nicht klar zu erkennen.");
  AddDetail(({"golem","golems"}),
     "Sind die Golems nicht kanz oben im Turm?");
  AddDetail(({"umriss","umrisse"}),
      "Du bist Dir nicht sicher, doch ab und an scheint sich in der schimmernden Luft ueber dem "+
      "Steinkreis ein Umriss eines Eingangs zu sehen zu sein.");
  AddDetail(({"aura"}),
      "Die Aura scheint eine Art Schutz zu sein.");
  AddDetail("schutz",
      "Schutz wogegen? Vielleicht soll nicht jeder dorthinkommen.");

  
  AddDetail("");

 check_maze();
// AddExit("norden", "./room2_d2" );
 AddCmd(({"betrete","huepf","spring","geh","gehe","steig","steige"}),"teleport");

 AddExit("runter", "./room2_d3" );
 RemoveExit("norden", "./maze/x1y1.lpc" );

}


int teleport(string str)
{ object ob;
  object me;

  notify_fail("Wohin willst du?\n");

  if (!str) return 0;

  if (str == "in kreis" || str == "kreis" || str == "in haufen" || str == "haufen" || str =="steinkreis") {

    if (!ob=deep_present("todesschienen",this_player()) ||
        IS_WIZARD(this_player()) ) {
      write("Die Aura die den Steinkreis einhuellt haelt Dich ab den Steinkreis zu betreten.\n");
      write("\n");
      say(this_player()->QueryProp(P_NAME)+" donnert gegen eine Aura und wird zuruekgeschleudert.\n");
      return 1;
    }

    write ("Du betrittst den Steinkreis. Du reisst die Augen auf und auf einmal siehst Du...\n");
    say(this_player()->QueryProp(P_NAME)+" betritt einen Steinkreis und verschwindet vor Deinen Augen.\n");


    this_player()->move("/d/ebene/lamuerte/turm/rooms/eingang.lpc",M_NOCHECK);

    if (me=find_player("lamuerte"))
       {tell_object(me,"[TDTT] "+this_player()->QueryProp(P_NAME)+
      " Teleportiert sich aus der Golemzone vom Turm.\n");


    write ("Dir ist ein wenig uebel, diese Teleporter sind wohl nicht fuer Dich.\n");

    return 1;
    }
  }
}



int check_maze(){
  if(i!=0) return 1;

  call_other("/d/ebene/lamuerte/turm/rooms/maze.lpc", "???", 0);
  call_other("/d/ebene/lamuerte/turm/rooms/maze.lpc", "test_maze");

  call_out("del_maze",1);
  call_out("build_maze",2);

  return 1;
}

int build_maze(){
  call_other("/d/ebene/lamuerte/turm/rooms/maze.lpc", "do_build");  
  call_other("/d/ebene/lamuerte/turm/rooms/maze.lpc", "show_maze", "write");  
  i=1; 
  AddExit("norden", "/d/ebene/lamuerte/turm/rooms/maze/x1y1" );
  write("Ein Ausgang oeffnet sich.\n");
  return 1;
} 

int del_maze(){
  call_other("/d/ebene/lamuerte/turm/rooms/maze.lpc", "do_del");  
  
  return 1;
}

reset(){
  ::reset();
  write("Ein Ausgang schliesst sich.\n");
  RemoveExit("norden", "./maze/x1y1.lpc" );
  i=0;
  call_out("check_maze",2);
}

