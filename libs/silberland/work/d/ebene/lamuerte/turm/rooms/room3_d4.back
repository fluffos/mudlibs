#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


  object ob;
void create()
{
  ::create();



  SetProp(P_INT_SHORT, "Ausgang aus dem Labyrinth");
  SetProp(P_INT_LONG, 
    "Hier endet der Turm der tausend Tode in einer grossen Halle, die der Anfuehrer der Golems. "+
    "Der Raum hat sowie auch die restliche Ebene eine Decke in zimlicher Hoehe, welche ungefaehr "+
    "sieben meter ueber Dir ist. Auf einer der Waende haengt ein kleines Brett welches aus "+
    "Holz gefertigt ist. Einige Schriftzeichen lassen vermuten, dasz man es lesen kann.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN:TT_HOUSE]) );


  AddDetail("anfuehrer",
      "Ist er nicht hier?");
  AddDetail("halle",
      "Die Halle ist riesig gross. Alles besteht aus Stein.");
  AddDetail("hoehe",
      "Naja, ganz schoen hoch.");
  AddDetail(({"wand","waende"}),
           "Die Waende bestehen aus Stein.");
  AddDetail("boden",
           "Der Boden auf dem Du stehst besteht so wie fast alles hier drinnen aus Stein.");
  AddDetail("stein",
           "Das Gestein rundum Dich ist Granit.");
  AddDetail("granit",
           "Du untersuchst das Granit, es ist wirklich ein hartes Gestein.");
  AddDetail("gestein",
           "Ja, lauter Granit rundum Dich.");
  AddDetail("decke",
           "Die Decke befindet sich in ca. 2 m ueber Dir. Also hier kommt bestimmt kein Golem herein.");
  AddDetail(({"labyrinth","labyrinths"}),
           "Du stehst am Ausgang des Labyrinths.");
  AddDetail(({"turm","turms"}),
           "Du befindest dich im Inneren des Turms am ende eines Labyrinth.");
  AddDetail("inneren",
           "Damit ist gemeint, das du im Turm stehst und nicht draussen.");
  AddDetail("ebene",
           "Das hier ist Ebene III, das Labyrinth der tausend Tode. Sie wird von Golems regiert.");
  AddDetail(({"tod","tode"}),
           "Nana, willst Du schon sterben? Sei froh das der Tod nicht hier ist.");
  AddDetail(({"golem","golems"}),
           "Die golems bewohenn die im sueden liegende Ebene und verschieben ab und an die Waende.");
  AddDetail("ausgang",
      "Du befindest Dich ja im Ausgang des Labyrinths. Im Norden koennte es weiter gehen.");
  AddDetail("raum",
      "Du siehst Dich im Raum um, auffaellig ist das Holzbrett.");
  AddDetail(({"brett","holzbrett"}),
      "Man kann es lesen.");
  AddDetail("holz",
      "Duerfte sich um Fichte handeln.");
  AddDetail("fichte",
      "Das Holzbrett an der Wand besteht aus Fichte.");
  AddReadDetail(({"brett","holzbrett"}),
      "ACHTUNG! Hier endet vorerst der Turm der tausend Tode. Im Norden liegt nur noch eine Schatzkammer, "+
      "in der wertvolle Gegenstaende verstorbener Spieler aufbewahrt werden und welche von Ush Nazgul bewacht wird. "+
      "Also vergiss es, Ush ist viel zu schwer fuer Dich, Du kommst da nie rein!");
  AddDetail("treppe",
      "Sie fuehrt rauf in die naechste Ebene.");
  AddDetail("schriftzeichen",
      "Duerften sich durch lesen zu einem Satz zusammenfuegen lassen,");
  AddDetail("satz",
      "Lies das Brett.");

 ob=AddItem("/d/ebene/lamuerte/turm/npc/ush.c",REFRESH_DESTRUCT);

// AddExit("rauf", "./room4_d4.c");
 AddExit("sueden", "./maze/x9y9.c" );
 AddExit( "norden", ([
        EX_DEST  : "./schatz",
        EXG_ID   : "ush",
        EXG_PLMSG: "Ush laesst Dich nicht vorbei!\n",
        EXG_RMMSG: "Ush haelt @wen@ zurueck.\n" ]) );


 
}


