#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int offzu=0;
int *DOORS = ({0,0,0,0,0,0});
int *CODE = ({0,0,0,0,0,0});

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Mauervorsprung im Turm");
  SetProp(P_INT_LONG, 
    "Du findest Dich auf einem Mauervorsprung wieder, doch dieser ist anders als die anderen. "+
    "Eine grosse Tuer @@offzu@@ Dir den Weg nach oben in die naechste Etage des Turms. Du kannst einige "+
    "unleserliche Zeichen an der Tuer finden. Ansonsten sieht es hier genauso trostlos aus wie "+
    "im Rest des Turms. Ein grosser Knopf ist an der Tuer angebracht. Im Westen liegt das Loch.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );

  VORSPRUNG

  AddDetail ( ({"tuer","tuere"}),
    "Die Tuer ist aus Metall gemacht, einige Zeichen auf ihr scheinen der Schluessel zu sein mit "+
    "dem man hier durchkommt.");
  AddDetail ( ({"metall"}),
    "Duerfte sich um Eisen handeln.");
  AddDetail ( ({"eisen"}),
    "Es ist stahlhart obwohl es nur Eisen ist. ");
  AddDetail ( ({"weg"}),
    "Der Weg fuehrt ueber Stufen bis zu einer Tuer.");
  AddDetail ( "etage",
    "Waere toll wenn Du es in die naechste schaffst.");
  AddDetail ( "rest",
    "Du untersuchst den Rest, findest aber nur Reste.");
  AddDetail ( "reste",
          "Du untersuchst die Reste, findest aber nur den Rest.");
  AddDetail ( "knopf",
    "Du kannst den Knopf druecken, er dient zum Oeffnen der Tuer. Ueber ihm sind einige kleine Lampen.");
  AddDetail ( "schluessel",
    "Fuer diese Tuer gibt es keinen Schluessel.");
  AddDetail ( ({"stufe","stufen"}),
    "Ueber die Stufen geht es durch die Tuer in die naechste Etage des Turms.");

  AddDetail(({"steinplatte","platte"}),
           "Die Platte schwebt ab und an hier vorbei.");

  
  AddSpecialDetail("zeichen","showzeich");
  AddSpecialDetail("lampen","showlamp");
  AddSpecialExit( "westen", "tod" );
  AddSpecialExit( "oben", "checkrauf");

  AddCmd(({"drueck","druecke"}),"zieh");
  call_out("passcode",1);
}

int otor()
{if (offzu==1)
  { write ("Die Tuer ist doch schon offen!\n");
    return 1;
  }
 
 if (CODE[0]==DOORS[0] && CODE[1]==DOORS[1] && CODE[2]==DOORS[2] && CODE[3]==DOORS[3] && CODE[4]==DOORS[4] && CODE[5]==DOORS[5]) {

 write("Die Tuer oeffnet sich!\n");
 offzu=1;
 return 1;
 }
 write("Die Tuer ruehrt sich nicht.\n");
 return 1;
}

int checkdoors()
{int x;
 int y;
 y=2;

 for (x=0;x<=5;x++)
 {
 DOORS[x]=find_object("/d/ebene/lamuerte/turm/rooms/"+y+".lpc")->stellung();
 y++;
// write (DOORS[x]+"\n");
 }
 return 1;

 }


int zieh(string str)
{
  notify_fail("Worauf willst Du druecken?\n");
  if(!str) return 0;
  if( member( ({"knopf", "auf knopf"}), str)!=-1 )
  { call_out("checkdoors",1); 
    write("Du drueckst auf einen Knopf.\n");
    call_out("otor",3);
    return 1;
   }
  return 0;
}

string showzeich()
{int x,k;
 for (x=0;x<=5;x++)
 {k=x+1;
  if (CODE[x]==0) write("Zeichen "+k+" schimmert rot.\n");
  if (CODE[x]==1) write("Zeichen "+k+" schimmert gruen.\n");
 }
 return "Du bist verwirrt.\n";
}

showlamp()
{call_out("checkdoors",1);
 call_out("showla",3);
 return "Du betrachtest die Lampen.\n";
}

string showla()
{int x,k;
 for (x=0;x<=5;x++)
 {k=x+1;
  if (DOORS[x]==0) write("Lampe "+k+" schimmert rot.\n");
  if (DOORS[x]==1) write("Lampe "+k+" schimmert gruen.\n");
 }
 return "Du bist verwirrt.\n";
}

int passcode()
{int x;
 for (x=0;x<=5;x++)
 {
 CODE[x]=random(2);
// write(CODE[x]+"\n");
 }
 return 1;
}


 
checkrauf()
{
 if(offzu==0)
 { write("Wummm, Du rennst volle Kanne gegen die Tuer.\n");
   return 1;
 }
 
  this_player()->move("/d/ebene/lamuerte/turm/rooms/room2_c4.lpc", M_GO, 0,
                    "geht ueber die Stiege nach oben", "kommt ueber die Stiege herauf");
  return 1;
}

offzu()
{
 if (offzu==0) return "versperrt";
 return "eroeffnet";
} 

int green()
{RemoveSpecialExit( "westen" );
  AddDetail(({"steinplatte","platte"}),
            "Die Platte schwebt vor Dir.");
  AddExit( "westen", "./platte.lpc");
}

int red()
{RemoveExit( "westen" );
  AddDetail(({"steinplatte","platte"}),
            "Die Platte schwebt ab und an hier vorbei.");
  AddSpecialExit( "westen", "tod");
}

int tod() 
{ this_player()->move("/d/ebene/lamuerte/turm/rooms/tod", M_NOCHECK, 0,
                    "stuerzt sich in den Tod", "stuerzt herein");
 return 1;
}

reset()
 {::reset();
 offzu=0;
 passcode();
 }

FACKEL    
