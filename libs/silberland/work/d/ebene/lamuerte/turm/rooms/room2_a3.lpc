#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm");
  SetProp(P_INT_LONG, 
    "Das leichte Gefaelle des Gangs wird hier etwas steiler. Man kann sagen, dass es "+
    "regelrecht bergab geht in den Westen. Im Gegensatz dazu, wie sollte es auch anders "+
    "sein, fuehrt der Gang in den Suedosten leicht bergauf. Da hier keine Fackel mehr "+
    "den oh so fuerchterlichen Gang erleuchtet, ist es eine gute Idee eine Lichtquelle "+
    "bei sich zu haben. Das Bild an der Mauer links neben Dir faellt Dir sofort auf.");

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );

ZWEITER

  AddDetail("gefaelle",
   "Hier ist es ganz schoen steil.");
  
  AddDetail(({"gegensatz"}),
   "Du untersuchst ihn, findest aber nichts."); 

  AddDetail("fackel",
   "An den Waenden gibt es keine mehr.");

 AddSpecialDetail("bild","bfunc");

 AddItem("/d/ebene/lamuerte/turm/npc/zombie.lpc",REFRESH_DESTRUCT);


 AddExit("westen", "./room2_a2.lpc" );
 AddExit("suedosten", "./room2_b4.lpc" );

}

bfunc()
{string show;

 show=read_file("/d/ebene/lamuerte/turm/obj/bild.txt");
 tell_object(this_player(),show);
// tell_object(this_player(),"...Lamuerte\n");
return "";
} 
