#include "../turm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int i;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm");
  SetProp(P_INT_LONG, 
    "Der vom Westen kommende Gang endet hier im Thronsaal von Khe'dmir, dem Anfuehrer der "+
    "Untoten. Ein aus Knochen geschaffener Luster haengt in einer Ecke des Raums. "+
    "Genau darunter befindet sich der Thronstuhl von Khe'dmir. An der Decke haengen "+
    "faulige Fleischbrocken aus denen einige Knochen herausragen. Einige Fackeln an den Waenden "+
    "erhellen den Saal. Am Ende des Raums fuehrt eine schmale Treppe in die naechste Etage des Turms. "+
    "Ein Grabstein steht hier ziemlich verwaist in der Gegend herum.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN:TT_HOUSE]) );
 
  i=0;


ZWEITER

  AddSmell(({"fuss","fuesse","geruch"}),
    "Igitt, das ist ja grauenvoll!");

  AddSound(({"knochen","zerbrechen","brechen","klappern"}),
    "Knirsch, Knarr, Knirsch, Knarr... Die Knochen in den zuckenden Fleischbrocken an der Decke machen den Laerm.");

  AddDetail("gegend",
    "Die Gegend ist nicht sonderlich einladend hier.");

  AddDetail("grabstein",
    "Auf dem Grabstein ist zu lesen: Hier ruht Che'dmir. Ein kleines Kupferschild sticht hervor.");

  AddDetail("kupferschild",
    "Dieser Grabstein wurde von Cherub bestellt. Beschwer Dich doch einach bei ihm.");

  AddDetail("anfuehrer",
   "Der Anfuehrer der Untoten nennt sich Khe'dmir.");

  AddDetail(({"raum","raums","saal","thronsaal"}),
   "Er ist verhaeltnissmaessig klein, aber sieht dennoch furchterregend aus.");

  AddDetail("luster",
   "Der Luster ist aus Knochen gebaut. Einige Kerzen stecken darin.");
  
  AddDetail(({"kerze","kerzen"}),
   "Sie geben ein warmes Licht ab.");

  AddDetail(({"stuhl","thronstuhl"}),
   "Auf dem aus Knochen geschaffenen Thronstuhl nimmt Khe'dmir platz wenn er gerade lust dazu hat.");

  AddDetail("treppe",
   "Sie fuehrt nach oben in die naechste Etage.");
 
  AddDetail("ecke",
   "Der Raum hat vier davon, in einer steht ein Thronstuhl.");

  AddDetail("ende",
   "Am Ende dieses Saals befindet sich die Treppe, welche in die dritte Ebene fuehrt.");

  AddDetail(({"fackel","fackeln"}),
   "Sie stecken lose in ihren Halterungen und erleuchten den Raum.");
  
  AddDetail(({"halterung","halterungen"}),
   "Diese hier sehen nicht besonders bruchfest aus.");

  AddDetail(({"untote","untoter","untoten"}),
   "Dieser Teil des Turms gehoert Khe'dmir, dem Anfuehrer der Untoten!");
  
  AddDetail("teil",
   "Du kannst nichts besonderes daran erkennen."); 
 
  AddDetail(({"brocken","fleischbrocken"}),
   "Sie zucken ein wenig, dadurch reiben sich die Knochen die darin stecken aneinander.");

  AddDetail("knochen",
   "Vieles in diesem Raum scheint daraus gemacht zu sein.");

  AddDetail(({"wand","waende"}),
   "Die Waende bestehen auch hier aus Gestein. An einer kannst Du einen Riss ausmachen.");


  AddDetail("riss",
   "Es ist zu dunkel um zu sehen was sich in dem Riss befindet. Man koennte aber mit den Fingern "+
   "reingreifen.");

 AddDetail(({"finger","fingern"}),
   "Sie sind schmutzig.");

 AddItem("/d/ebene/lamuerte/turm/npc/chedmir.lpc",REFRESH_DESTRUCT);
 
 AddCmd(({"greif","greife"}),"gfunc"); 
 AddCmd(({"brich","breche"}),"fackel"); 
 AddExit("westen", "./room2_d2" );
// AddExit("rauf", "./room3_c4" );
 AddExit( "rauf", ([
       EX_DEST  : "./room3_c4",
       EXG_ID   : "khedmir",
       EXG_PLMSG: "Khe'dmir laesst Dich nicht vorbei!\n",
       EXG_RMMSG: "Khe'dmir haelt @wen@ zurueck.\n" ]) );



}

gfunc(wosn)
 {
  string wohin;
    notify_fail("Wohin willst Du greifen?\n");
  if(!wosn)
  {
    return 0;
  }

  if(sscanf(wosn,"in %s", wohin)!=1)
  {
    notify_fail("Greife in was?\n");
    return 0;
  }

  if (i>=1)
  {write("Du fummelst im Riss herum, findest aber nichts.\n");
   return 1;
  }

  if(wohin=="riss")
  {
     if(random(500)>(this_player()->QueryAttribute(A_DEX))*2)
     {
      write("Autsch, Du zwickst Dir die Finger ein.\n");
      this_player()->reduce_hit_point(20);
      return 1;
     }

     clone_object("/d/ebene/lamuerte/turm/obj/heiltrank.lpc")->move(this_player(),M_NOCHECK);
     write ("Du holst einen kleinen Trank aus dem Riss.\n");
     i++;
     return 1;
  }
  return 0;
}

reset()
 {::reset();
  i=0;
 }

 
FACKEL
