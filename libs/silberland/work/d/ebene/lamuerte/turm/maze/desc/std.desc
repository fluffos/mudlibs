inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "In einem Labyrinth");
  SetProp( P_INT_LONG, "Du stehst inmitten eines Labyrinths und hast keine "+
  "Ahnung wohin Du gehen sollst. Es ist alles so verwirrend aehnlich hier drinn. "+
  "Hoffentlich findest Du jemals wieder raus." );
  SetProp( P_LIGHT, 1);
