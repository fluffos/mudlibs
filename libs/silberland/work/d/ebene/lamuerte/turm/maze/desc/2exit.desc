inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "In einem Labyrinth");
  SetProp( P_INT_LONG, "Du stehst inmitten eines Labyrinths und hast keine "+
  "Ahnung wohin Du gehen sollst. Zwei Ausgaenge fuehren von hier entlang weiter im "+
  "Labyrinth. Ein Tip fuer welchen Du Dich enscheiden solltest waere Gold wert." );
  SetProp( P_LIGHT, 1);
  SetProp(P_NO_TPORT, NO_TPORT);
