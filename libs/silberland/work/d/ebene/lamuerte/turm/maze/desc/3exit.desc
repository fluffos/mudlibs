inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "In einem Labyrinth");
  SetProp( P_INT_LONG, "Du stehst auf einer T-Kreuzung inmitten eines riesigen "+
  "Labyrinths. Jeder Weg koennte auch hier der Richtige sein, was es Dir nicht gerade "+
  "leicht macht zu entscheiden welchen davon Du einschlagen sollst." );
  SetProp( P_LIGHT, 1);
  SetProp(P_NO_TPORT, NO_TPORT);
