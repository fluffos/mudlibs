inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "In einem Labyrinth");
  SetProp( P_INT_LONG, "Du stehst inmitten eines Labyrinths und hast keine "+
  "Ahnung wohin Du gehen sollst. Es fuehrt nur ein Ausgang weiter in den Gaengen dieses "+
  "riesiegen Gewirrs von Wegen. Du kannst nur hoffen bald hier rauszufinden." );
  SetProp( P_LIGHT, 1);
  SetProp(P_NO_TPORT, NO_TPORT);
