inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "In einem Labyrinth");
  SetProp( P_INT_LONG, "Du befindest Dich auf einer Kreuzung von der vier Wege weiterfuehren "+
  "in die Tiefen des Labyrinths. Von wo auch immer Du hergekommen bist, Du kannst Dir "+
  "schoen langsam all die Richtungen nicht mehr merken." );
  SetProp( P_LIGHT, 1);
  SetProp(P_NO_TPORT, NO_TPORT);
