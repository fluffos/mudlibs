#pragma strict_types
inherit "/room/genRoom";
#include "/room/genRoom.h"

void reset( int tick )
{

   ::reset( tick );
   if( tick ) return;

   set_landscape( OPATH );
   set_type( OUTDOOR );
   set_short( "Along the mountain path" );
   set_long( "The mountains form a huge inpassable wall in front of you. " +
             "In the shadow of the western mountains you discover a hole "+
             "in the rock which might lead you to the other side.\n" );
   add_exit( "north",0,"#1116|966","n",VISIBLE );
<EXITS>

   replace_program( "room/genRoom" );

}

