#pragma strict_types
inherit "/room/genRoom";
#include "/room/genRoom.h"

void reset( int tick )
{

   ::reset( tick );
   if( tick ) return;

   set_landscape( ICAVE );
   set_type( INDOOR_DARK );
   set_short( "Inside the crack" );
   set_long( "Passing through the spiderwebs at the entrance to the crack " +
             "the sound of clicking feets gets louder. You see some cocoons "+
             "hanging down from the ceiling.\n" );

<EXITS>

   add_exit( "down",0,"spider_lair","d",VISIBLE );
   add_desc( "cocoons","They are about human size.\n" );
   add_desc( "cocoon","You notice a human finger peeking out of it.\n" );

   replace_program( "room/genRoom" );

}

