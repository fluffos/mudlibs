#pragma strict_types
inherit "/room/genRoom";
#include "/room/genRoom.h"

void reset( int tick )
{

   ::reset( tick );
   if( tick ) return;

   set_landscape( WATER_NOSWIM );
   set_type( INDOOR_DARK );
   set_short( "Near a roaring underground river" );
   set_long( "Small drips of water start to form all about your body. " + 
             "The roaring sound of the river is deafening your ears. "+
             "But at least, you think,  all the water keeps the spiders away.\n" );
   
<EXITS>
      
   add_property( "no_mob" );

   replace_program( "room/genRoom" );

}

