inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "In einem Labyrinth");
  SetProp( P_INT_LONG, "Du stehst in einem dunklen Teil des Labrinths, hierher "+
  "brachten Dich magische kraefte, als die Mauern des Labyrinths einstuertzen. ");
  SetProp( P_LIGHT, 1);
  AddExit("norden","/d/ebene/lamuerte/turm/rooms/room3_c4.lpc");
}
