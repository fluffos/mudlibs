#pragma strict_types
inherit "/room/genRoom";
#include "/room/genRoom.h"

void reset( int tick )
{

   ::reset( tick );
   if( tick ) return;

   set_landscape( OPATH );
   set_type( OUTDOOR );
   set_short( "At the end of the path" );
   set_long( "The mountain raises huge in front of you. You don't see any " +
             "paths or other ways to travel on this steep mountainside. "+
             "A dark hole penetrates the rocky surface, leading into the"+
             " mountain.\n" );
   add_desc( "hole","A dark hole in the mountain, maybe your way to the "+
                    "other side?\n" );
   add_exit( "south",0,"#1116|968","s",VISIBLE );

<EXITS>

   replace_program( "room/genRoom" );

}

