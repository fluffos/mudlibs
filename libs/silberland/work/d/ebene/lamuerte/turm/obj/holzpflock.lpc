inherit "std/thing"; 
#include <language.h>
#include <properties.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Holzpflock");
  SetProp(P_LONG, 
   "Ein langer Holzpflock. Er ist ca. 2.95m lang und hat halbwegs ein Gewicht. Auf ihm "+
   "findest Du einige festgeklebte und total vertrocknete Schlingpflanzen. Fuer was der "+
   "wohl gut sein kann?");
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_NAME,"Holzpflock");
  SetProp(P_GENDER, MALE);
  SetProp(P_NODROP,1);  
  SetProp(P_NEVERDROP,1);  
  AddId( ({"\npflock","pflock","holzpflock"}));
 
  seteuid(getuid());
}

