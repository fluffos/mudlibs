inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>
#include <new_skills.h>

object me;

create()
{ 
  if(!is_clone(this_object())) return;
  ::create( ({"trink", "trinke"}) );
  SetProp(P_SHORT,"Ein blauer Trank");
  SetProp(P_LONG, 
   "Ein kleines Flaeschchen. Es enthaelt eine blaue, blubbernde Fluessigkeit\n"
   +"die magische Kraefte hat. Man kann es trinken.\n");
  SetProp(P_VALUE,1800);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Trank");
  SetProp(P_NOSELL,"Den blauen Trank verkaufst Du sicher nicht!\n");

  AddId (({"trank","flasche","flaeschchen","heiltrank"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({220,220}), F_DRINK:10, F_ALCOHOL:4,
     F_VERB: "trinken" ,
     F_MSG:"Du trinkst das eiskalte blubbernde Getraenk. \n"
          +"Irgendwie fuehlst Du Dich viel besser.\n",
     F_MSG_ROOM:"trinkt ein magisch blubberndes blaues Getraenk.\n" ]) );
}

mampf(string what, object pl)
{object ob;
 string roomname;
 int duration;
 
  ob=environment(this_player());
  roomname=file_name(ob);
  me=this_player();
     
    write("Ein Flammenschild baut sich rund um Deinen Koerper auf.\n");
    say(this_player()->QueryProp(P_NAME)+" wird von einem Flammenschild eingehuellt.\n");

    duration=random(1)+15;
    me->SetProp(P_TMP_DEFEND_HOOK,
               ({ time()+duration-1, this_object(), "pot_fireshield"}));
    call_out("pot_fireshield_end", duration, me );

  
//  ::mampf(what, pl);
  return 1;
}

mixed pot_fireshield(int dam, mixed dam_type, mixed spell, object enemy)
{

  if (!pointerp(dam_type)) dam_type = ({ dam_type });

      enemy->do_damage((dam/2)+1,me);
      say(enemy->QueryProp(P_NAME)+" verbrennt sich an einem Flammenschild.\n");
      return ({ dam/4, dam_type, spell, enemy });
}


void pot_fireshield_end(object caster)
{
  tell_object(me, "Dein Flammenschild loest sich auf.\n");
  caster->SetProp(P_TMP_DEFEND_HOOK, 0);
}

