inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <wizlevels.h>

void create()
{
  if( !is_clone(this_object()) )  return;

  ::create();
  if(file_name(previous_object())!="/p/daemon/itemd/itemd" && !IS_ARCH(previous_object())) {
    raise_error("Illegales Clonen des Uniques! ");
    destruct();
    return;
  }

  SetProp(P_SHORT, "Eine Golemlanze namens 'Donnerdorn'");
  SetProp(P_LONG,
    "Donnerdorn ist eine sehr maechtige zweihaendige Lanze. Er wurde "
    "von einem Drachen gehuetet. Doch einer der brutalsten und auch tapfersten "
    "Krieger schlachtete den Drachen in einem Kampf um Leben und Tod ab, und so "
    "kam diese Lanze, welche eigentlich nie mehr aus dem Besitz des Drachen kommen "
    "sollte, in den Haenden der Sterblichen. Die Lanze verlangt seinem Traeger viel Erfahrung und "
    "Koennen ab, darum kann Donnerdorn auch nur von wenigen Helden gefuehrt werden." );
  SetProp(P_NAME, "Donnerdorn");
  SetProp(P_INFO, 
    "Dies ist der Donnerdorn, eine maechtige Waffe vor der jeder Golem "
    "des Landes zusammenzuckt. Er besteht aus reinstem Mithril und ist mit vielen Dornen uebersaeht."
    "Diese Waffe gibt es nur einmal im ganzen Silberland, also "
    "schaetz Dich gluecklich wenn Du sie hast und auch zuecken kannst.") ;
  SetProp(P_GENDER, MALE);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
  SetProp(P_WC, 270);
  SetProp(P_SIZE, 200);
  SetProp(P_WC_FIX, 30);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:100]) );
  SetProp(P_WEIGHT, 8000);
  SetProp(P_VALUE, 50000);
  SetProp(P_HIT_FUNC, this_object()); 
  SetProp(P_WIELD_RESTRICTIONS, ([P_XP:40000000,
                                  P_LEVEL: 40, 
                                  SR_SEER: 1,
                                  A_INT: 12,
                                  A_CON: 20,
                                  A_DEX: 20,
                                  A_STR: 25]) );

  AddId( ({"golemlanze", "donner", "dorn", "donnerdorn", "lanze"}) );

  AddDetail("dornen",
      "Die Dornen sind auf der ganzen Lanze verteilt. Sie bestehen aus Mithril und sind "+
      "extrem scharf.");
  AddDetail("waffe",
      "Donnerdorn ist wirklich eine praechtige Waffe.");
  AddDetail( ({"dorn","donnerdorn","lanze"}),
      "Wenn Du die Waffe so betrachtest, moechtest Du am liebsten gleich einen Golem umlegen.");
  AddDetail( "golem",
      "Gott sei Dank, Du bist kein Golem, Du brauchst keine Angst vor der fuercherlichen Waffe haben.");
  AddDetail("krieger",
      "Du kleiner Hosenmatz warst das? Nein das gibts ja nicht, Du hast den Drachen erlegt?");
  AddDetail("hosenmatz",
      "Du untersuchst Dich selbst. Bist Du nicht schon etwas zu alt fuer solche Doktorspielchen?");
  AddDetail( ({"spielchen","doktorspielchen"}),
      "Wenn Du nicht bald was umbringst mit Donnerdorn, sondern nur dauernd die Details untersuchst, "+
      "wird er bald verfaulen.");
  AddDetail("details",
      "Es gibt einfach zu wenig davon, oder?");
  AddDetail( ({"drache","drachen"}),
      "Geh, such Dir einen und toete ihn.");
  AddDetail("leben",
      "Ist das nicht schoen?");
  AddDetail("tod",
      "Ist er nicht grausam?");
  AddDetail(({"sterblicher","sterbliche","sterblichen"}),
      "Du bist einder von denen, das ist gut, Du wirst bald sterebn.");
  AddDetail("traeger",
      "Man muss ganz schoen gut sein, um der Traeger Donnerdorns zu sein.");
  AddDetail( ({"held","helden"}),
      "Du bist kein Held, Du bist ein Hosenmatz.");
  AddDetail("erfahrung",
      "Hast Du genug um Donnerdorn zu fuehren?");

   SetProp(P_NAME, "Donnerdorn");
}


int HitFunc(object enemy)
{
  int schaden;
  object me;

  me=this_object()->QueryProp(P_WIELDED);

  if( lower_case(enemy->QueryProp(P_RACE)) == "golem" )
  {
    if( random(200)==100 )
    {
      write("Donnerdorn **V E R N I C H T E T** Deinen Gegner.\n");
      if(random(30) >= 10) 
      {
        write("Donnerdorn saugt von Deiner Energie einiges ab.\n");
        me->do_damage(random(10)+10,this_object());
      }
      return 500+random(500);
    }
    if( random(30) >= 15 )
    {
      if(random(50000)<1 && enemy->QueryProp(P_BODY)>=100 ){
        call_out("RemoveIt",0);
        return 1;
      }
      write("Donnerdorn durchbohrt Deinen Gegner.\n");
      if(random(30) >= 15) 
      {
        write("Donnerdorn saugt etwas Energie von Dir ab.\n");
        me->do_damage(random(2)+1,this_object());
      }
      schaden=150+random(200);
      return schaden + enemy->QueryProp(P_LEVEL);
    }
    if(random(30) >= 22) 
    {
      write("Donnerdorn saugt Energie von Dir ab.\n");
      me->do_damage(random(1)+1,this_object());
    }
    return random(20) + enemy->QueryProp(P_LEVEL);
  }
  return -300;
}


void RemoveIt()
{
  write("Donnerdorn versucht sich verzweifelt noch am Leben zu halten.\n"
      "Er saugt Dir V I E L Energie ab doch zerbroeselt.\n");
  this_player()->do_damage(random(200)+1,this_object());
  this_object()->remove(1);
}

int count = 0;

void reset()
{
  if( !is_clone(this_object()) )  return;
  ::reset();
  if(count++ > QueryProp(P_WC))
  {
    if(environment())
      tell_object(environment(), "Donnerdorn loest sich auf!\n");
    remove();
  }
}

int QueryCount()
{
  return count;
}

