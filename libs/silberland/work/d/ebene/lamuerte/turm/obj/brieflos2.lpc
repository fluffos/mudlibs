
inherit "std/thing"; 

#include <language.h>
#include <properties.h>
#include <moving.h>

int i,j,g;
int kauft;
int jackpot,jacktimes;
string n,jackwho;
object ob;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Brieflosautomat (Weihnachtsedition 2002) (Jackpot: @@howmuchjack@@ Muenzen)");
  SetProp(P_LONG, 
   "Ein kleiner gelber Brieflosautomat, welcher fuer 100 Muenzen ein Brieflos rausrueckt. An der "+
   "seite ist ein kleiner Hebel angebracht welchen man ziehen kann, woduch man ein Brieflos "+
   "erhaelt. Bis jetzt wurden @@howmuch@@ Lose verkauft. Im Jackpot befeinden sich "+
   "@@howmuchjack@@ Muenzen. Bisher wurde der Jackpot @@jackwon@@ mal abgesahnt. Letzter Gewinner "+
   "war: @@jackwinna@@.");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_NAME,"Brieflosautomat");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOGET,"Unmoeglich, er ist viel zu schwer!\n");  
  AddId( ({"automat","losautomat","brieflosautomat"}));
  i=0; 
  kauft=0;
  jackwho="Niemand";
  seteuid(getuid());
  jackpot=100;
  AddDetail("hebel",
   "Den hebel kann man mit 'ziehe hebel' betaetigen.");
 

  AddCmd (({"ziehe","zieh"}),"ofunc");
  
  
}

howmuch(){
  return (string) kauft;
}

howmuchjack(){
  return (string) jackpot;
}

jackwon(){
 return (string) jacktimes;
}

jackwinna(){
  return (string) jackwho;
}  
string aufzu() {
  if (i==0) return "geschlossen";
  return "offen";
}

int ofunc(string str) {
  int j;
  notify_fail("Was willst Du ziehen?\n");
  
  if (!str) return 0;

  if (str=="hebel" || str=="an hebel" ){

     if (i==1) {
        write("Der Automat laedt gerade nach, einen Moment bitte!\n");
        return 1;
     }

    if ( this_player()->QueryMoney() < 100 ) {
      write("Du hast nicht genug Geld um Dir ein Los zu leisten!\n");
      return 1;
    } 
    this_player()->AddMoney(-100);

    kauft++;

    write("Du ziehst fest an dem kleinen Hebel des Brieflosautomaten.\n");
    write("Ein Los kommt herunter, welches Du sofort aufreisst.\n");
    if(!random(10)) say(this_player()->Name()+" laesst sich ein Brieflos herunter.\n"); 

    g=random(1000);

    //say((n=this_player()->Name())+" reisst ein Brieflos auf.\n",
    //          ({ this_player() }) );

    j=random(2000);
    if(j==1001) {
      write ("Du gewinnst "+jackpot+" muenzen!\n");
      write ("Das war er J A C K -!- P O T !!!!\n");
      write ("-*-G-R-A-T-U-L-A-T-I-O-N-*-\n");
      jackwho=this_player()->QueryProp(P_NAME)+" mit "+jackpot+" Muenzen Gewinn";
      jacktimes=jacktimes+1;
      write("Ein riesiger Haufen Geld faellt vom Himmel herab.\n");
      say("Ein riesiger Haufen Geld faellt vom Himmel herab.\n");

      ob=clone_object("/obj/money");
      ob->SetProp(P_AMOUNT,jackpot);
      ob->move(environment(this_object()), M_NOCHECK);
      this_object()->jackdec(jackpot);  // <----- AB HIER ist jackpot==0 !!!
      //tell_room(environment(this_object()),
      //    sprintf("ob:%O  jackpot:%O  amt:%O  env(ob):%O\n",
      //((      ob, jackpot, ob->QueryProp(P_AMOUNT), environment(ob)));
      domainshout(this_player()->Name()+
          " hat deb Jackpot beim Brieflosautomaten geknackt!\n");

      jackpot=1;
      return 1;
    }
    
    if (g > 890) {
    g=g-500;
    write ("Du gewinnst "+g+" muenzen!\n");
    say(this_player()->QueryProp(P_NAME)+" freut sich ueber einen Gewinn!\n", ({ this_player() }) );
    this_object()->jackdec(g);
    this_player()->AddMoney(g-random(50));
    return 1;
    }
  
    write("Du hast leider nichts gewonnen!\n");
    //say(this_player()->QueryProp(P_NAME)+" wirft die Niete enttaeuscht auf den Boden.\n",({ this_player() }) );
    this_object()->jackadd(98+random(1));

    return 1;
   
  }
 return 0;
}




int jackadd(int i) {
   jackpot=jackpot+i;
   return 1;
}

int jackdec(int i) {
  jackpot=jackpot-i;
  if (jackpot < 0) jackpot=0;
  return 1;
}

int jackamount() {
  return jackpot;
}

