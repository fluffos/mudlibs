inherit "/std/armour";

#include "../vt100.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

int hp,sp,i;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  hp=20;
  sp=35;
  i=0;
  AddId( ({"schiene","schienen","todesschienen","beinschienen","beinschiene",
           "trollschiene" }));
  SetProp(P_SHORT,VT_NORMAL+"->*<-");
  SetProp(P_LONG,
  "\tDie magisch gluehenden Beinschienen aus dem Turm der tausend Tode. Man muss\n"+
  "schon sehr erfahren sein um sie tragen zu koennen. Dieses paar kann\n"+
  "@@schaden@@\n");
  SetProp(P_NAME, "Todesschiene");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_AC, 7+random(3)); //max 9
  SetProp(P_VALUE,2200);
  SetProp(P_WEIGHT, 500);  
  SetProp(P_VALUE, 1500);
  SetProp(P_MAGIC,1); 
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, ([MAT_BONE:30, MAT_MAGIC:70]));
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR: 23,
                                 P_LEVEL: 25]) );
  SetProp(P_INFO,"Das sind wohl die besten Beinschienen weit und breit.\n");
  SetProp(P_M_HEALTH_MOD,([P_HP:hp,P_SP:sp]));
  SetProp(P_WEAR_FUNC, this_object());
}

short()
{
  if(!this_player())  return VT_NORMAL+"->*<- Beinschienen (gluehend)..";
 
  if (this_object()->QueryProp(P_WORN)!=0)
  {  
    switch(this_player()->QueryProp(P_TTY))
    {
      case "ansi": return VT_TA_B+VT_MAGENTA+"-"+VT_YELLOW+">"+VT_RED+"*"+VT_YELLOW+"<"+VT_MAGENTA+"-"+VT_NORMAL+" Beinschienen (gluehend) (getragen).."; break;
      case "vt100": return VT_NORMAL+"->*<- Beinschienen (gluehend) (getragen)..";
    }
  }

    switch(this_player()->QueryProp(P_TTY))
    {
      case "ansi": return VT_TA_B+VT_MAGENTA+"-"+VT_YELLOW+">"+VT_RED+"*"+VT_YELLOW+"<"+VT_MAGENTA+"-"+VT_NORMAL+" Beinschienen (gluehend).."; break;
      case "vt100": return VT_NORMAL+"->*<- Beinschienen (gluehend)..";
    }
  return VT_NORMAL+"->*<- Beinschienen..";
}

name()
{
  if(!this_player())  return VT_NORMAL+"->*<- Beinschienen";
    
  switch(this_player()->QueryProp(P_TTY))
    {
      case "ansi": return VT_TA_B+VT_MAGENTA+"-"+VT_YELLOW+">"+VT_RED+"*"+VT_YELLOW+"<"+VT_MAGENTA+"-"+VT_NORMAL+" Beinschienen"; break;
      case "vt100": return VT_NORMAL+"->*<- Beinschienen";
    }
  return VT_NORMAL+"->*<- Beinschienen";
}

string extra_look()
{
    return capitalize(environment()->QueryPronoun())+
          " besitzt die magisch gluehenden Todesschienen.\n";
}


schaden()
 {int good;
  good=this_object()->QueryProp(P_AC);
  if (good<=4) return ("sehr wenig Schaden verhindern.");
  if (good==5) return("wenig Schaden verhindern.");
  if (good==6) return("so manchen Schaden verhindern.");
  if (good==7) return("schon einigen Schaden verhindern.");
  if (good==8) return("ganz schoen viel Schaden verhindern.");
  if (good==9) return("jeden Schaden dieser Welt verhindern.");
  return("göttlichen Schaden verhindern und trieft nur so vor Waffenbalsam!");
 }

 reset(){
   ::reset();
  

   if(this_player() && this_object()->QueryProp(P_WORN)!=0){

     if(environment(this_object())->QueryProp(P_NAME)=="Ush Nazgul") return 1;

     write("Die Todesschienen beginnen sich zu erhitzen. AUTSCH! Das haltst Du nicht lange aus.\n");
//     write("Schnell versuchst Du sie fuer einen Moment loszuwerden.\n");
//     this_player()->command_me("ziehe todesschienen aus");

    if (random(100)>75) {

       hp=hp-2; 
       sp=sp-3;
       SetProp(P_M_HEALTH_MOD,([P_HP:hp,P_SP:sp]));
       this_player()->UpdateAttributes();

     write("Deine Todesschienen gluehen voller Hitze auf!\n");  
    } 
    i=1;
    call_out("abkuehl",8);
   }
 
 }

int abkuehl(){
    if(hp<=0 || sp <=0){
      write("Deine Todesschienen loesen sich in Luft auf.\n");  
      this_object()->remove();
      return 1;
    }
     write("Deine Todesschienen kuehlen wieder ab.\n");  
     i=0;
     return 1;
}

int WearFunc(object me)
{  //write ("I:"+i+"\n");
    if(i==1){
      write("Die Schienen sind viel zu heiss um sie jetzt schon anzuziehen.\n"); 
      return 0;
    }
      if(i==0) return 1;
   }
