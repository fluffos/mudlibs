inherit "obj/container";

#include <container.h>
#include <properties.h>
#include <language.h>
#include <material.h>
#include <moving.h>
#include <defines.h>

create()
{

  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Schatztruhe");
  SetProp(P_SHORT, "Eine Schatztruhe");
  SetProp(P_LONG, 
          "Das ist eine schwere Schatztruhe aus Eichenholz. Sie ist"
         +" mit schweren Baendern beschlagen und sieht sehr stabil aus.");
  AddDetail(({"eichenholz", "holz"}), 
            "Die Truhe ist aus schwerem alten Eichenholz gefertigt.");
  AddDetail(({"eisenbaender", "baender"}), 
            "Die Truhe ist mit schweren Eisenbaendern beschlagen.");
  SetProp(P_MATERIAL, ([MAT_IRON:15, MAT_OAK:85]));
  SetProp(P_WEIGHT, 8000);
  SetProp(P_NOGET, "Die Truhe ist viel zu schwer um sie nehmen zu koennen.\n");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MAX_WEIGHT, 20000);
  AddId("schatztruhe");
  AddId("truhe");
  SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
  SetProp(P_CNT_KEY, "\nturmschatzkey");


}

void treasure()
{
  call_out("give_treasure",1);
  return;
}
void give_treasure()
{
  object ob;

  "/obj/gemmaster"->DistributeGem(5, 15, 1, 1);

  ob=clone_object("/obj/money");
  ob->SetProp(P_AMOUNT, 5000+random(15700));
  ob->move(this_object(), M_NOCHECK);

  ob=clone_object("/p/std/dragons/obj/schuppe.lpc");
  ob->SetProp(P_AMOUNT, random(15)+1);
  ob->move(this_object(), M_NOCHECK);

  return;
}
