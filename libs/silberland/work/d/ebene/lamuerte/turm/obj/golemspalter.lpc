inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

void create()
{
  if( !is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Der Golemspalter namens 'Donnerklinge'");
  SetProp(P_LONG,
    "Der Golemspalter ist eines der begehrtesten Zweihanschwerter die "
    "es im Silberland zu finden gibt. Lange glaubten die Buerger des Landes, "
    "es gaebe keine Waffe gegen grosse Golems ausser die Magie. Doch mit diesem "
    "Schwert wurde auch Kaempfern die Moeglichkeit geschaffen etwas gegen diese "
    "grausamen Biester zu unternehmen. Das Schwert verlangt seinem Traeger viel Erfahrung und "
    "Koennen ab, darum kann der Golemspalter auch nur von wenigen Helden gefuehrt werden." );
  SetProp(P_NAME, "Golemspalter");
  SetProp(P_GENDER, MALE);
  AddId( ({"donner", "kling", "donnerklinge", "golemspalter", "schwert", "spalter"}) );
  SetProp(P_INFO, 
    "Dies ist der Golemspalter, eine maechtige Waffe vor der jeder Golem "
    "des Landes Ehrfurcht hat, bis auf einen. Er ist sehr schwer, darum ist es auch "
    "beinahe unmoeglich, ihn zu fuehren. Schaetz Dich gluecklich, wenn Du "
    "ihn ueberhaupt zuecken kannst.") ;

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_WC, 280);
  SetProp(P_WC_FIX, 25);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:90, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 50000);
  SetProp(P_HIT_FUNC, this_object()); 
  SetProp(P_WIELD_RESTRICTIONS, ([P_XP:40000000, 
                                  SR_SEER: 1,
                                  A_INT: 10,
                                  A_CON: 20,
                                  A_DEX: 25,
                                  A_STR: 30]) );

  AddId("\nberserker_spalten_waffe");
}


int HitFunc(object enemy)
{
  int schaden;

  if( lower_case(enemy->QueryProp(P_RACE)) == "golem" )
  {
    if( random(200)==100 )
    {
      write("  Dein Golemspalter **S P A L T E T** Deinen Gegner.\n");
      return 500+random(500);
    }
    if( random(30) >= 20 )
    {
      if(random(5000)<1 && enemy->QueryProp(P_BODY)>=100 ){
        call_out("RemoveIt",0);
        return 1;
      }
      write("  Dein Golemspalter durchbohrt Deinen Gegner.\n");
      schaden=80+random(190) + random(enemy->QueryProp(P_BODY) / 2);
      return enemy->QueryProp(P_LEVEL)+schaden;
    }
    return random(enemy->QueryProp(P_BODY) / 2) + enemy->QueryProp(P_LEVEL);
  }
  return -200;
}


void RemoveIt()
{
  write("Dein Golemspalter zerbroeselt.\n");
  this_object()->remove(1);
}
                
