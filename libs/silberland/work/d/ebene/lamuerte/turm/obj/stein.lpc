inherit "std/thing"; 
#include <properties.h>
#include <moving.h>

int i;

string *way;
int j;

dienow();

void create()
{ 
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein kugelfoermiger Stein");
  SetProp(P_LONG, 
      "Ein etwa 120cm im Durchmesser grosser, granitfarbener, kugelrunder "
      "Stein. Er sieht aus als wuerde er gut rollen, doch um diesen "
      "tonnenschweren Brocken wegschieben zu koennen wuerde man mehr als "
      "fuenfzig Pferde brauchen.");
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20000);
  SetProp(P_NAME,"Stein");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOGET,"Huch, Dir kommt beinahe ein Furz aus als Du versuchst den Stein wegzubewegen.\n");  
  AddId( ({"\nstein","stein","kugel"}));

  AddDetail("brocken",
      "Dieser Brocken strahlt eine geheimnissvolle Aura aus.");

  AddDetail("aura",
      "Diese Aura verbirgt ein Geheimnis.");

  AddDetail("geheimnis",
      "Das Geheimnis dieses magischen Stein ist es, dass wenn er jemanden ueberrollt "+
      "dessen Sachen spurlos verschwinden.");

  AddDetail("sachen",
      "Naja, die Sachen verschwinden. Ob es dazu eine Erklaerung gibt?");

  AddDetail("erklaerung",
      "Nagut, es ist so: Die Mumien sind bei Wucherandos angestellt. Der "
      "wiederum verkauft einen Teil der Sachen, welche ihm die "
      "Mumien bringen nachdem sie die vom Stein ueberrollten Leichen "
      "ausgeraeumt haben, den andern Teil davon gibt er an Ush ab damit der "
      "ihm wiederum seinen Laden nicht kaputtschlaegt.");

  AddDetail(({"ush","wucherandos","laden"}),
      "Der ist nicht hier!");

 AddCmd(({"beweg","bewege","roll","rolle","schieb","schiebe"}),"rfunc");
   j=0;
     seteuid(getuid());

}


int rfunc(string wosn)
{
  object ob,pflo;
  string was,wohin;
  notify_fail("Syntax: bewege <stein> mit <gegenstand>\n");

  if (i>=5){
    write ("Du brauchst den Stein nicht mehr zu bewegen, er rollt schon von selbst!\n");
    return 1;
  }
  if(!wosn)
  {
    write("Syntax: bewege <stein> mit <gegenstand>\n" );
    return 1;
  }
  if(sscanf(wosn,"%s mit %s", was , wohin)==2)
  {
    if(!ob=present("\npflock",this_player()))
    {
      write("Du brauchst eine Art Hebel oder Balken oder Stange um den Stein wegbewegen zu koennen.\n");
      return 1;
    }
  }
  if(wohin == "pflock" || wohin == "holzpflock" )
  {
    say(this_player()->QueryProp(P_NAME)+" versucht den kugelfoermigen Stein ins Rollen zu bringen.\n");
    if (!pflo=deep_present("\npflock",this_player()) || !present("\npflock",this_object()) || random(100)>50)
    {
      write("Als Du nach Deinem Pflock greifen willst siehst Du, dass Du gar keinen hast.\n");
    }
    else
    {
      i++;
      if(i==1) write("HORUCK! Der Stein scheint sich ein wenig bewegt zu haben.\n");
      if(i==2) write("Uff fast waere der Stein ins Rollen gekommen.\n");
      if(i==3) write("Du versuchst den Stein wegzuhebeln, Dieser wackelt aber nur ein wenig.\n");
      if(i==4) write("KNIRSCH! Der Stein faengt an, sich zu bewegen. Einmal noch und er faengt an zu rollen!\n");
      if(i==5)
      {
        write("*KNARR* Der Stein bewegt sich langsam in den Norden, alles was dort drinnen ist wird UEBERROLLT!\n");
        write("Lauf bloss nicht zu rasch hinterher sonst ueberrollt er Dich auch noch gleich mit!\n");
        call_out("roll_down",4);
        //      i=0;
      }
    }
    return 1;
  }
  return 0;
}


int roll_down()
{
  if(j>=7) {
   this_object()->remove();
   return 1; 
   }
  way=({"room2_b4","room2_a3","room2_a2","room2_b1","room2_c1","room2_d2","room2_d3"});
  tell_room(environment(this_object()),"Der Stein rollt aus dem Raum.\n");
  call_other("/d/ebene/lamuerte/turm/rooms/"+way[j], "???", 0);
  this_object()->move("/d/ebene/lamuerte/turm/rooms/"+way[j],M_NOCHECK);
  tell_room(environment(this_object()),"Eine riesige Steinkugel ueberrollt Dich.\n");
  dienow();
  j=j+1;
  call_out("roll_down",1);
  return 1; 
}

void dienow()
{
  object *people;
  object ob,next;
  int x;

  people = filter_array( all_inventory(environment(this_object()) ), #'living );

  for (x = sizeof(people); x-->0; )
  {
    if (present(people[x]))
    {
      tell_object(people[x],"Ahhhhhhhhhhh! Der Stein hat Dich voll erwischt.");

      // SPIELER
      if (query_once_interactive(people[x]))
      {
        people[x]->move("/d/ebene/lamuerte/turm/rooms/tod", M_NOCHECK, "faellt", "in den Tod", "faellt herein");
        // people[x]->do_damage(100000);  // Das macht der Tod-Raum schon...
      }
      // NPC
      else if ((random(100)>10) && people[x]->QueryProp(P_NAME) != "Che'dmir")
      {
          for(ob=first_inventory(people[x]);ob;) {
             next=next_inventory(ob);
             ob->remove(); 
             ob=next;
          }
          people[x]->die(); 
      }
    }
  }
  return;
}
 
