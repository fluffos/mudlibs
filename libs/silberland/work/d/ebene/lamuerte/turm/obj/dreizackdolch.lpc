inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein kritischer knoecherner Dreizackdolch der toedlichen Vergiftung (schimmernd)");
  SetProp(P_LONG,
      "Dieser Dolch hat eine Klinge aus tiefschwarzen Gebeinen. Schmerz und Wut "
      "pulsiert aus diesem abgrundtief verhassten Objekt, Du fuehlsti, dass "
      "dieser Dolch alles Gute hasst und nur darauf wartet, es zu zerstoeren.");
  SetProp(P_NAME, "Dreizackdolch der Vergiftung");
  SetProp(P_NAME_ADJ, ({"knoechern"}));
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "dreizackdolch", "verflucht"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_POISON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 2000);
  SetProp(P_SIZE, 35);
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());
  SetProp (P_WC_BONUS, ([ "skelett" : 10 ]) );
  SetProp(P_INFO,
      "Dieser Dolch vernichtet alles Gute. Selbst Du hast Angst vor ihm. "
      "Er verleiht Skeletten die Kraft des kritischen Treffers. "
      "Legenden erzaehlen von Skeletten welche mit diesem Dolch "
      "toedliche Treffer landeten.");

}

int WieldFunc(object waffe)
{
  if (!environment(this_object())->id("skelett"))
  {       
    tell_object(environment(this_object()), "Diese Waffe kann nur ein Skelett benutzen!\n");
    return 0;
  }
  else
  { 
    if(environment(environment(this_object())))
      tell_room(environment(environment(this_object())), 
          environment(this_object())->Name(WER,1)+" blitzt giftgruen auf!\n");
    if (!random(10))
      environment(this_object())->SetProp(P_NAME_ADJ, ({"giftig","funkelnd"}));
    else if (!random(10))
      environment(this_object())->SetProp(P_NAME_ADJ, ({"leuchtend"}));
    else if (!random(10))
      environment(this_object())->SetProp(P_NAME_ADJ, ({"blitzend"}));
    else 
    environment(this_object())->SetProp(P_NAME_ADJ, ({"giftig"}));
    return 1;
  }
}

int do_remove()
{    
  if(environment(this_object()) && environment(environment(this_object())))
    tell_room(environment(environment(this_object())), 
        this_object()->Name(WER,1) + " zerbricht!\n");
  this_object()->remove(0);
  return 1;
}

int UnwieldFunc(object weapon)
{
  if(!random(10))
  {
    call_out("do_remove",0);
    return 1;
  }
  return 1;
} 

int HitFunc(object enemy)
{
  if (enemy->QueryProp(P_ALIGN)>0)
  {
    //Positiver Wert, Gutes muss zerstoert werden. 
    if (!random(200))
    {//crithit
      tell_room(environment(environment(this_object())), 
          environment(this_object())->Name(WER,1)+
          " landet einen kritischen Treffer!\n");
      if (!random(1000))
      {//assassinate
        tell_room(environment(environment(this_object())), 
            environment(this_object())->Name(WER,1)+
            " landet einen FINALEN TODESTREFFER!\n");
        return 11190+random(enemy->QueryProp(P_ALIGN)*12);
      }
      return 190+random(enemy->QueryProp(P_ALIGN)*2);
    }
    return enemy->QueryProp(P_LEVEL)+random(enemy->QueryProp(P_ALIGN)/10);
  }
  //Negativer Wert, Boeses trifft das Skelett jetzt nicht mehr wirklich. 
  if (!random(10))
  {
    tell_room(environment(environment(this_object())), 
        environment(this_object())->Name(WER,1)+
        " trifft sich selbst!\n");
    return -random(-enemy->QueryProp(P_ALIGN));
  }
  return -random(-enemy->QueryProp(P_ALIGN)/10);
}

