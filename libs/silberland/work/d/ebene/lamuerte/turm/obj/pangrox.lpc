inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

object pl;
string *wasn = ({"hi\n","hallo\n","gugug\n","gugux\n","oida\n","blah\n"});
setprops();
randomsay();
create()

{ if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Angrox Inside - Wir haben das Problem eingekreist");
  SetProp(P_LONG, 
 "Das ist Angrox die Puppe. Er ist ziemlich winzig, wenn auch nur fuer einen Zwerg.\n"+
 "Er ist absolut fit.\n"+
 "Sind ihre Augen rot, macht sie blau, bis sie schwarz sieht.\n"+
 "Er traegt 75 Freundschaftsbaender am Handgelenk.\n"+
 "Er traegt 75 Freundschaftsbaender am Handgelenk.\n"+
 "Er hat einen Teddy unter seinen Arm geklemmt.\n"+
 "Angrox die Puppe hat einen Anstecker, einen Wappenrock, ein blutrotes Stirnband, ein\n"+
 "Druidenamulett und eine perverse Schaedelmaske an und keine Waffe gezueckt.\n");

  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_ARTICLE,0);
  SetProp(P_NOATTACK,"sagt: Geh weg Du wicht! Hast soundso keine chance!");
  SetProp(P_GENDER, MALE);
 SetProp(P_SPELLRATE, ((20)*5));
  SetProp(P_NAME,"Angrox");

  AddId( ({"angrox","puppe"}));

  setprops(); 
  
  seteuid(getuid());
}

setprops()
{
  if(pl=find_player("angrox")) {
   this_object()->SetProp(P_SHORT,pl->QueryProp(P_PRESAY)+""+pl->QueryProp(P_NAME)+" "+pl->QueryProp(P_TITLE));
   this_object()->SetProp(P_PRESAY,pl->QueryProp(P_PRESAY));
  }
 
  return 1;
}


reset()
 {
  ::reset();
  setprops();
  }

void catch_tell( string str )
{
 string scstr,plrn;
 object folman;

 randomsay();

 if(!sscanf(str,"%s sagt: %s",plrn,scstr)) return 0;
// write (plrn+" : "+scstr+".\n");
 if(plrn=="Angrox") return 0; 
 if ( member_array(scstr,wasn) != -1 ) 
  {
     call_out("talkit",3,"Angrox sagt: Gugux!"); 
  return 0;
  }

 if(scstr=="komm mit\n")
  {
   call_out("talkit",3,"Angrox sagt: Ok, ich komm mit Dir, "+plrn+".\n");
   if(!folman=find_player(lower_case(plrn))) return 0;
   folman->AddPursuer(this_object());
//   set_living_name(lower_case("avon"+folman->QueryProp(P_NAME)));
   return 0;
  }

 if(scstr=="verschwinde\n")
  {
   this_object()->remove();
   return 0;
  }


  return 0;
}

talkit(str)
{
      tell_room(environment(this_player()), break_string(str));
 return "";
}

randomsay()
{
       switch(random(502)) {

       case 0 .. 22 : call_out("talkit",3,"Angrox laechelt Dich an."); break;
       case 30 .. 42 : call_out("talkit",3,"Angrox sagt: Ich muss dann los"); break;
       case 50 .. 52 : call_out("talkit",3,"Angrox ruft: Ahhhrg! Telefonterror!"); break;
       case 60 .. 62 : call_out("talkit",3,"Angrox gaehnt."); break;
       case 70 .. 72 : call_out("talkit",3,"Angrox sagt: AFK"); break;
       case 80 .. 82 : call_out("talkit",3,"Angrox ruelpst."); break;
       case 90 .. 102 : call_out("talkit",3,"Angrox sagt: Oida"); break;
       default : break;
        }

}
