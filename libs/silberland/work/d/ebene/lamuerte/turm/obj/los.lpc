inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <moving.h>

int i,j;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Brieflos");
  SetProp(P_LONG, 
   "Ein kleines Brieflos, welches Du mit 'reisse los auf' aufreissen kannst.");
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_NAME,"Brieflos");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nlos","brieflos","los"}));
  seteuid(getuid());


  AddCmd (({"reiss","reisse"}),"ofunc");
  
  
}


int ofunc(string str) {
  int g;
  string n;
  
  notify_fail("Was willst Du aufreissen?\n");
   
  if (!str) return 0;

  if (str=="los" || str=="los auf" ){
  g=random(1000);

  say((n=capitalize(this_player()->Name()))+" reisst ein Brieflos auf.\n",
      ({ this_player() }) );
  
  if (g > 790) {
      g=g-500;
      write ("Du gewinnst "+g+" muenzen!\n");
      say(n+" freut sich ueber einen Gewinn!\n", ({ this_player() }) );
      this_player()->AddMoney(g);
      this_object()->remove();
      return 1;
  }

      write("Du hast leider nichts gewonnen!\n");
      say(n+" wirft die Niete enttaeuscht auf den Boden.\n",({ this_player() }) );
      this_object()->remove();
      return 1;
    } 

    
  }

