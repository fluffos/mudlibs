inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <moving.h>

int i,j;
int kauft;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Brieflosautomat");
  SetProp(P_LONG, 
   "Ein kleiner gelber Brieflosautomat, welcher fuer 100 Muenzen ein Brieflos rausrueckt. An der "+
   "Seite ist ein kleiner Hebel angebracht, welchen man ziehen kann, woduch man ein Brieflos "+
   "erhaelt. Bis jetzt wurden @@howmuch@@ Lose verkauft.");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_NAME,"Brieflosautomat");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOGET,"Unmoeglich, er ist viel zu schwer!\n");  
  AddId( ({"automat","losautomat","brieflosautomat"}));
  i=0; 
  kauft=0;
  seteuid(getuid());

  AddDetail("hebel",
   "Den hebel kann man mit 'ziehe hebel' betaetigen.");
 

  AddCmd (({"ziehe"}),"ofunc");
  
  
}

howmuch(){
  return (string) kauft;
}

string aufzu() {
  if (i==0) return "geschlossen";
  return "offen";
}

int ofunc(string str) {
  notify_fail("Was willst Du ziehen?\n");
  
  if (!str) return 0;

  if (str=="hebel" || str=="an hebel" ){
     if ( deep_present("\nlos",this_player() ) ) {
       write("Nein, reiss doch zuerst ein Altes los auf bevor Du ein neues kaufst!\n");
         return 1;
     }    

     if (i==1) {
        write("Der Automat laedt gerade nach, einen Moment bitte!\n");
        return 1;
     }

    if (this_player()->AddMoney(-100)!=1) {
      write("Du hast nicht genug Geld um Dir ein Los zu leisten!\n");
      return 1;
    } 

    
    write("Du ziehst fest an dem kleinen Hebel des Brieflosautomaten.\n");
    write("Ein Los kommt herunter, welches Du sofort einsteckst.\n");
      say(this_player()->QueryProp(P_NAME)+" laesst sich ein Brieflos herunter.\n"); 
      clone_object( "/d/ebene/lamuerte/turm/obj/los.lpc")->move( this_player(), M_NOCHECK );
   kauft++;
      return 1;
  }
 return 0;
}

