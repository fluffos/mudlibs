inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Schazkammerschluessel");
  SetProp(P_LONG, 
   "Ein kleier Schluessel zur Schatzkammer im Turm der tausend Tode.");

  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
  
  AddId( ({"ush\ntorkey","schluessel","brauner"}));
 
  seteuid(getuid());
  

}


reset(){
  ::reset();
  write("Ein Schatzkammerschluessel verrostet komplett.\n");
  this_object()->remove(1);
  }

