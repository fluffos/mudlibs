inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <new_skills.h>
#include <combat.h>

int zeit, first_use;
#define COST 25

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  zeit=time();
  SetProp(P_SHORT,"Ein Knochenschwert namens Che'dmir's Klinge");
  SetProp(P_LONG,
   "Das riesige Knochenschwert ist scharf wie eine Rasierklinge und etwa "+
   "zwei Meter lang. Sein Griff ist mit einem kleinen Totenschaedel geschmueckt. Es hatte mal Che'dmir gehoert "+
   "welcher es wiederum an Khe'dmir vererbt hat. Und nun hast Du es, also trage es mit Stolz!");
  SetProp(P_NAME, "Knochenschwert");
  AddId( ({"schwert","knochenschwert","klinge"}));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 66);
  SetProp(P_WEIGHT,  800);                                                    
  SetProp(P_VALUE, 2500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE,DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BONE:80,MAT_MAGIC:20]) );
  SetProp(P_QUALITY_DECAY,150);
  SetProp(P_HIT_FUNC, this_object());
  SetProp (P_WC_BONUS, ([ "KHEDMIR" : 500 ]) );
  SetProp (P_WIELD_RESTRICTIONS, ([P_XP: 1000000,
                                   A_DEX: 19,
                                   A_STR: 25,     
                                   A_CON: 10,
                                   A_INT: 5   ]));
                                    
  SetProp(P_INFO,
   "Dieses Schwert hat eine Besonderheit man kann mit dem Befehl [schwertspalt <gegner]>\n"+
   "alle heiligen Zeiten eine Spezialattacke ausfuehren, um des Gegners Knochen zu zerbroeseln.\n");

  AddCmd(({"schwertspalt"}),"sfunc");

  SetProp(P_WIELD_FUNC, TO);
}

int sfunc(string str, int fastload)
{
  object enemy;
  int i;
  notify_fail("Wen moechtest Du mit Deinem Knochenschwert schwertspalten?\n");
  if( stringp(str) && (enemy=present(str, environment(TP))) )
  {
    if (!QueryProp(P_WIELDED))
    {
      write("Du musst dazu Knochenschwert zuecken!\n");
      return 1;
    }
    if ( first_use > time() )
    {
      write( "Du hast das Knochenschwert doch gerade erst gezueckt!\n");
      return 1;
    }
    if ( zeit > time() )
    {
      write("So schnell hintereinander kannst Du niemanden schwertspalten!\n");
      return 1;
    }
    if (TP->QueryProp(P_SP)<COST)
    {
      write("Du hast nicht genug Magiepunkte dafuer!\n");
      return 1;
    }
    if (PL->QueryProp(P_ATTACK_BUSY))
   {
      write("He! Nicht so schnell!\n");
      return 1;
    }
    PL->SetProp(P_ATTACK_BUSY, 1);
    printf("Du * S C H W E R T S P A L T E S T * %s mit Che'dmir's Klinge.\n", enemy->name(WEN));
    say(sprintf(BS("%s schwertspaltet %s mit %s Knochenschwert auf."), CAP(TPN),
       enemy->name(WEN), TPPP(FEMALE,WEM) ), ({enemy,TP}) );
    tell_object(enemy, CAP(TPN)+" schwertspaltet Dich mit Che'dmir's Klinge.\n ");

    //war wohl zu stark geht sowioeso net durch ballance...
//    enemy->Defend(random(290)+(52*(this_player()->QueryAttribute(A_STR))),
      enemy->Defend(random(18*(this_player()->QueryAttribute(A_STR))),
         DT_SLASH, ([SP_NAME:"schwertspalten", SP_SHOW_DAMAGE:1,
         SP_REDUCE_ARMOUR:([AT_HELMET:0, AT_BRACERS:0, AT_BOOT:0, AT_AMULET:0,
                            AT_GLOVE:0, AT_TROUSERS:0, AT_RING:0, AT_BELT:0])
         ]), TP);
    TP->restore_spell_points(-COST);
    TP->SetProp(P_DISABLE_ATTACK, 1+random(2));
    if (fastload) return 1;
    if (random(5555)==13)
    {
      write("Das war zu viel fuer Dein Knochenschwert.\n"
            "Das Knochenschwert bricht auseinander und nichts bleibt uebrig.\n");
      remove(1); return 1;
    }
    zeit=time()+(random(120)); 
    return 1;
  }
  else
    return 0;
}

int bereit()
{
  write("Che'dmir's Klinge blitzt grell auf.\n");
  return (QueryProp(P_WORN) && zeit<time());
}

int WieldFunc()
{
  first_use=time()+4; 
  return 1;
}

int HitFunc(object enemy)
{
 if(random(333)==233)
 {
   write("Che'dmir's Klinge reisst tiefe Wunden in Deinen Gegner.\n");
   return random(666); //yes!
 }
 return -50;
}
