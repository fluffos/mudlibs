//28.10.2001 F_HEAL 70,70 abgeweerter auf 35/35
inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <food.h>

create()
{ 
  if(!is_clone(this_object())) return;
  ::create( ({"iss", "esse"}) );
  SetProp(P_SHORT,"Ein Stueck Moos");
  SetProp(P_LONG, 
   "Ein Stueck feuchtes Moos. In der Not kann man es essen.");  
  SetProp(P_VALUE,0);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1); 
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, NEUTER);
  
  SetProp(P_NAME,"Moos");
  
  AddId (({"moos"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({35,35}), P_FOOD:12 , 
     F_VERB: "essen" ,
     F_MSG:"Du isst das grauenhaft schmeckende Moos. \n"
          +"Dir wird fast schlecht dabei.\n",
     F_MSG_ROOM:"isst ein Stueckchen Moos.\n" ]) );
}


