inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <moving.h>

int i,j;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Sarg");
  SetProp(P_LONG, 
   "Ein grosser steinerner Sarg. Er ist gegen die Wand gelehnt und momentan @@aufzu@@. Auf ihm "+
   "sind beinahe unleserliche Zeichen graviert die Dich an auf den Kopf gestellte Kreuze "+
   "erinnern.");
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_NAME,"Sarg");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOGET,"Unmoeglich, er ist viel zu schwer!\n");  
  AddId( ({"sarg"}));
  i=0; 
  j=0;
  seteuid(getuid());

  AddDetail("zeichen",
   "Hmm, probieren solltest Du es ob Du sie lesen kannst.");
 
  AddReadDetail("zeichen",
   "Oe fne t Du Di sen Sa g, ste t Di  ein Ge echt bev r!"); 

  AddCmd (({"oeffne"}),"ofunc");
  AddCmd (({"schliesse","schliess"}),"sfunc");
  
}


string aufzu() {
  if (i==0) return "geschlossen";
  return "offen";
}

int ofunc(string str) {
  notify_fail("Was willst Du oeffnen?\n");
  
  if (!str) return 0;

  if (str=="sarg" || str=="den sarg" ){
     if (i==1) {
        write("Der Sarg ist doch schon offen!\n");
        return 1;
     }
        write("Du oeffnest einen Sarg.\n");
        say(this_player()->QueryProp(P_NAME)+" oeffnet den Sargdeckel.\n"); 
        if ( present("mumie",environment(this_object()) ) ) j=1; 
        if (j!=1) clone_object( "/d/ebene/lamuerte/turm/npc/mumie.lpc")->move( environment(this_object()), M_NOCHECK );
        j=1;
        i=1;
        return 1;
  }
 return 0;
}

int sfunc(string str) {
  notify_fail("Was willst Du schliessen?\n");
  
  if (!str) return 0;
  
  if (str=="sarg" || str=="den sarg") {
     if (i==0) {
        write("Der Sarg ist doch schon geschlossen!\n");
        return 1;
     }  
        write("Du schliesst einen Sarg.\n");
        say(this_player()->QueryProp(P_NAME)+" schliesst den Sargdeckel.\n"); 
        i=0;
        return 1;
  }
 return 0;
}

reset()
{::reset();
 if (i!=0) tell_room(environment(this_object()),"Ein Sargdeckel faellt zu.\n");
 j=0;
 i=0;
}
