inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>

int todeszeit=3600; 
int zeit=time()+todeszeit;
object player=this_player();
string backuproom,backupdir;

testfunc();
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"(Eine unsichtbare Wand)");
  SetProp(P_LONG, 
   "Ein kleine unsichtbare Wand. Du kannst sie mit plaziere <ausgang> aufstellen. Sie wird dann "+
   "Disen Ausgang fuer einige Zeit blokieren. Du kannst die Wand an folgenden Ausgaengen Plazieren: @@pla@@");
  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Wand");
  AddId( ({"wand"}));

  backuproom="";
  backupdir=""; 
  AddCmd("plaziere","aufstell"); 
  seteuid(getuid());
}

aufstell(string str)
{string *BLAH;
 string *SCHNARR;
 string backup;

 int x;
 int y;
 y=0;
 BLAH=m_values(environment(this_player())->QueryProp(P_EXITS));
 SCHNARR=m_indices(environment(this_player())->QueryProp(P_EXITS));

 if (!str){
   write("Wohin?\n");
   return 1;
 }
 
 if (member_array(str,SCHNARR)==-1)
 { write("Dort funktioniert das nicht!\n"); 
  return 1; 
 }

 backuproom=environment(this_player())->QueryProp(P_EXITS)[str];
 backupdir=str;

 environment(this_player())->RemoveExit(backupdir);
 environment(this_player())->AddExit(backupdir,([ EX_TESTFUNC: #'testfunc ]) );

 this_object()->move(environment(this_player()), M_NOCHECK); 
 this_object()->SetProp(P_INVIS,1);
 this_object()->SetProp(P_NOGET,"");
 call_out("orig",240);
 write("Heimlich stellst Du die unsichtbare Wand auf. Sie verschwidet vor Deinen Augen.\n");
 return 1;
}


testfunc()
{ write ("Du rennst gegen eine unsichtbare Wand. PATSCH!\n");
  tell_room(environment(this_object()),"Eine unsichtbare Wand wackelt ein wenig.\n");
 return 0;
}

orig()
{environment(this_object())->RemoveExit(backupdir);
 environment(this_object())->AddExit(backupdir,backuproom);
 this_object()->remove();
 return 1;
}

string pla()
{
 string *SCHNARR;
 string *BLAH;
 string platz;
 int x;
 int y;

 platz="";
 y=0;
 SCHNARR=m_indices(environment(this_player())->QueryProp(P_EXITS));
 BLAH=m_values(environment(this_player())->QueryProp(P_EXITS));

 if (sizeof(BLAH)>0) {
  for (x=1;x<=sizeof(BLAH);x++)
  {
  if (x<sizeof(BLAH)) platz=platz+SCHNARR[y]+", ";
  if (x==sizeof(BLAH)) platz=platz+SCHNARR[y]+".";
  y++;
 }
 return platz;
 }

 return "Nirgends!\n";
}
