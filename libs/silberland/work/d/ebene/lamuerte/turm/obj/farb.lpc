inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../vt100.h"

string col,tit;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine Farbbombe");
  SetProp(P_LONG, 
   "Eine kleine Farbbombe, welche Du mit 'wirf bombe auf <spieler>' werfen kannst.");
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_NAME,"Farbbombe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nfbomb","bombe","farbbombe"}));
  seteuid(getuid());
  col=VT_TA_B+VT_MAGENTA+"F"+VT_YELLOW+"a"+VT_RED+"r"+VT_YELLOW+"b"+VT_MAGENTA+"b"+VT_MAGENTA+"o"+VT_YELLOW+"m"+VT_RED+"b"+VT_YELLOW+"e"+VT_NORMAL;
  tit=VT_TA_FO+VT_TA_B+VT_RED+"R"+VT_GREEN+"G"+VT_BLUE+"B"+VT_NORMAL+"";


  AddCmd (({"wirf","werfe"}),"wfunc");
  
  
}


int wfunc(string str) {
  string who; 
  object vic;

  notify_fail("Was willst Du auf wen werfen?\n");
   
  if (!str) return 0;

  if (sscanf(str, "bombe auf %s", who) != 1) {
      write("Kommando: wirf bombe auf <spielername>\n");
     return 1;
  }

  if (!vic=present(who,environment(this_player())) ){
      write(capitalize(who)+" siehst Du hier nirgends!\n");
      return 1;
  }

  if(!interactive(vic) || !query_once_interactive(vic)){
     write(vic->QueryProp(P_NAME)+" will nicht eingefaerbt werden.\n");
     return 1;
  }

  if(vic->QueryProp(P_NAME)==this_player()->QueryProp(P_NAME)){
    write("Du haust Dir ne "+col+" auf den Kopf!\n");
    say("Du siehst Farben im Raum herumspritzen.\n");
    vic->SetProp(P_PRESAY,tit);
    remove();
    return 1;
  }

  write("Du wirfst eine "+col+" auf "+vic->QueryProp(P_NAME)+".\n");
  tell_object(vic,this_player()->QueryProp(P_NAME)+" wirft eine "+col+" auf Dich.\n");
  vic->SetProp(P_PRESAY,tit);
  remove();
  return 1;
}

