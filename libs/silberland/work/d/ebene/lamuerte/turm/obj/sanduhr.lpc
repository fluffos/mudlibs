inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

int todeszeit=3600; 
int zeit=time()+todeszeit;
object player=this_player();

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine Sanduhr");
  SetProp(P_LONG, 
   "Ein kleine aus Granit geschlagene Sanduhr. Sie verschafft Dir den Eintritt zu einem Turm. "+
   "Mit 'restzeit' siehst Du wieviel Zeit Dir noch bleibt, um den Turm der tausend "+
   "Tode zu bezwingen. Andernfalls wirst Du Lars die Hand schuetteln.");
  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Sanduhr");
//  SetProp(P_NODROP,1);  
  AddId( ({"\nturmkey","schluessel","uhr","sanduhr"}));
 
  seteuid(getuid());
  AddCmd("restzeit","restzeit"); 
  AddCmd(({"quit","ende","schlafe ein"}),"noquit");
  call_out("stirb",todeszeit); 
}

int noquit()
{write("Nein, nicht mit dieser verdammten Sanduhr!\n");
 return 1;
}

restzeit()
{int actzeit; 
 int jo;
 actzeit=time();
 jo=((zeit)-actzeit)*1234;
 write("Du hast noch "+jo+" Sandkoerner bis zu Deinem Untergang.\n");
 return 1;
}


stirb()
{write("Deine Sanduhr explodiert und reisst Dich mit in den Tod!\n"); 
 tell_room(environment(player),"*WOOOOOOOOOOOOOOOOOOOOM*\n");
 if(player && find_player (player && lower_case(player->QueryProp(P_NAME))) ) 
 { environment(this_object())->die();
  this_object()->remove();
  return 1;
 }
  this_object()->remove();
}
