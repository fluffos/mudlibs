inherit "std/unit";
inherit "std/food"; 

#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

void create()
{
  if(!is_clone(this_object())) return;
  unit::create();
  SetProp(P_SHORT,"Ein blauer Trank");
  SetProp(P_LONG, 
   "Ein kleines Flaeschchen. Es enthaelt eine blaue, blubbernde Fluessigkeit "
   "die magische Kraefte hat. Man kann es trinken.");
  SetCoinsPerUnits(100, 1);
  SetGramsPerUnits(50, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, ({"Trank", "Traenke"}));
  SetProp(P_NAME_ADJ, "blau");
  SetProp(P_NOSELL,"Den blauen Trank verkaufst Du sicher nicht!\n");
  SetProp(P_MATERIAL, ([ MAT_GLASS:15, MAT_MISC_DRUG:85]) );

  AddSingularId( ({"trank","glasflaeschchen","flaeschchen","heiltrank"}) );
  AddPluralId(  ({"traenke", "heiltraenke"}) );
  AddId( ({"daemonentrank"}) );

  AddCmd( ({"trink", "trinke"}), "eat");
}


varargs int eat(string what, object pl)
{
  if (file_name(environment(this_player()))[0..22]=="/d/ebene/lamuerte/turm/")
  {
    // hier setzen, falls es schon mal umgesetzt wurde, aber nicht
    // konsumiert wurde (weil man zB. grad voll war)  (woody)
    SetProp(P_FOOD_INFO, ([
       F_HEAL: 160+random(41), F_DRINK:14, F_ALCOHOL:0,
       F_VERB: "trinken" ,
       F_MSG:"Du trinkst das eiskalte blubbernde Getraenk. \n"
            +"Irgendwie fuehlst Du Dich viel besser.\n",
       F_MSG_ROOM:"trinkt ein magisch blubberndes blaues Getraenk.\n" ]) );
  }
  else
  {
    // verpufft nicht mehr heilt nur weniger ausserhalb vom turm...
    SetProp(P_FOOD_INFO, ([F_HEAL: 10+random(15), F_DRINK:4, F_ALCOHOL:0,
           F_VERB: "trinken" ,
           F_MSG:"Du trinkst das eiskalte blubbernde Getraenk. \n"
                +"Irgendwie fuehlst Du Dich ein klein bisschen besser.\n",
           F_MSG_ROOM:"trinkt ein magisch blubberndes blaues Getraenk.\n" ]) );
  }
  return ::eat(what, pl);
}

int second_life(object pl)
{
  AddAmount(-1);
  return QueryProp(P_AMOUNT);
}

