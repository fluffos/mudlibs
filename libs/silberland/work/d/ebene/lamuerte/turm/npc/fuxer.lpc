inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>

#define MENV environment(this_object())

void fpl();
int *gotit=({0,0,0,0,0,0});
int done=0;
int i=0;
int co=0;
object player;
int bw=0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Fuxer");
  SetProp(P_LONG, 
  "Ein kleiner unscheinbarer Fuxer. Er ist etwar 60 cm gross und hat kleine, rote, gemeine Augen. " 
  "Er koennte der Schluessel zum Turm der tausend Tode sein.");
  SetProp(P_NAME, "Fuxer");
  SetProp(P_GENDER, MALE);
  AddId(({"\nfux","fuxer"}));
  create_default_npc(30);
  SetProp(P_ATTRIBUTES,(["int":25,"str":30,"con":25,"dex":25]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, 1);
  SetProp(P_HANDS,({" mit seinen kleinen Haenden",400}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 50+random(20) );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:30]) );  

  seteuid(getuid(this_object()));
 
  AddInfo(DEFAULT_INFO,
   ({ "kennt sich ueberhaupt nicht aus.\n",
      "zuckt ratlos mit den Schuldern.\n",
      "sagt: Was? Das glaubst ja selber nit, Du Seicherl.\n",
      "ignoriert Dich.\n",
      "sagt: Ja Du bist Deinem Ziel schon greifbar nah!\n",
      "sagt: Du wirst es wohl nie schaffen, frag nicht so bloed.\n",
      "zittert.\n",
      "sagt: Frag nicht so lang, gehen wir endlich!\n",
      "streckt Dir die Zunge raus.\n",
      "sagt: Red deidsch i vasteh nit wos Du meinen!\n",
      "sagt: Ja, die Frage stellen sich alle Verlierer.\n",
      "schuettelt den Kopf.\n",
      "nickt heftig auf Deine Frage hin.\n",
      "sagt: Das ist doch nicht das Richtige!\n",
      "sieht Dich artig an, weiss aber nicht was Du meinst.\n",
      "sagt: Na Du hast Sorgen.\n",
      "sagt: Ach ja, davon hab ich gehoert.\n",
      "sagt: Ich glaube, diese Frage stellt sich fuer uns nicht.\n",
      "sagt: Du musst deutlicher reden, ich hab Deine Frage nicht verstnden.\n"
    }) ); 
  AddInfo(({"teil","teile","gegenstaende","gegenstand"}),"@@brauch@@"); 
  AddInfo(({"sanduhr","uhr"}),"@@dosanduhr@@");

  AddInfo(({"turm","todesturm","turm der tausend tode"}),
   "sagt: Der Schluessel zum Turm ist eine Sanduhr.\n"+
   "Der Fuxer sagt: Nur ich kann sie bauen, denn ich kenne den Lebenssand!\n"+
   "Der Fuxer sagt: Wenn Du mir die noetigen Teile bringst, kann ich\n"+
   "Der Fuxer sagt: Dir vielleicht bei der Aufgabe helfen.\n");

  AddInfo(({"sand","lebenssand"}),
   "sagt: Ja! Ohne den koennte man diese\n"
   "Der Fuxer sagt: speziele Sanduhr nicht bauen. Man braucht sie um in\n"
   "Der Fuxer sagt: den Turm der tausend Tode zu kommen.\n");

  AddInfo("aufgabe",
   "sagt: Bei Deiner Aufgabe im Turm kann ich Dir nicht helfen.\n"+
   "Der Fuxer sagt: nur soviel kann ich sagen, es soll sehr\n"+
   "Der Fuxer sagt: gefaehrlich dort drinnen sein. Meine Aufgabe\n"+
   "Der Fuxer sagt: ist nur Dir diese Uhr zu bauen.\n");

}

give_notify(obj)
{
 
  if (gotit[0]!=1 && member_array("qblatt",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Fuxer sagt: Oh, danke fuer das Seerosenblatt!\n");
     gotit[0]=1;
     obj->remove();
     brauch(); 
     return 1; 
     }

  if (gotit[1]!=1 && member_array("qbrett",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Fuxer sagt: Oh, danke fuer das Brett!\n");
     gotit[1]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

  if (gotit[2]!=1 && member_array("qnagel",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Fuxer sagt: Naegel! Damit kann ich mir eine kleine Kiste zusammennageln!\n");
     gotit[2]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

  if (gotit[3]!=1 && member_array("qhammer",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Fuxer sagt: Ein Hammer! Danke, den brauch ich zum Naegel nageln :)!\n");
     gotit[3]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

 
  if (gotit[4]!=1 && member_array("qkohle",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Fuxer sagt: Ah! Mit dem Stueck Kohle kann ich gut zeichnen!\n");
     gotit[4]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }

  if (gotit[5]!=1 && member_array("qglas",obj->QueryProp(P_IDS) ) != -1 )
    {write("Der Fuxer sagt: Perfekt, darin kann ich den Sand einfuellen.\n");
     gotit[5]=1;
     obj->remove();
     brauch(); 
     return 1; 
    }
  
  write("Der Fuxer sagt: Nein, das brauch ich wirklich nicht mehr!\n");
  write("Der Fuxer gibts Dir wieder zurueck.\n"); 
  obj->move(this_player(),M_NOCHECK); 
 
 }



brauch()
{int x;

 if (gotit[0]==1 && gotit[2]==1  && gotit[3]==1  && gotit[4]==1  && gotit[5]==1  && gotit[1]=1)

  {
 write("Der gnom sagt: Ich hab alles die Sanduhr!\n"+ 
  "Frag ihn einfach nach dem 'baue uhr' und er wird Dir die Sanduhr es Lebens zusammebbauen.\n");
   done=1;
   return ("Der Fuxer zappeld ungeduldig.");
  } 

 write ("Der Fuxer sagt: Ich brauch noch:\n"); 
 for (x=0;x<=5;x++)
 {if(gotit[x]!=1)
  {
    if (x==0) write("Der Fuxer sagt: Ein Seerosenblatt um den Lebenssand einzufuellen.\n");
    if (x==1) write("Der Fuxer sagt: Ein Brett um Boden, Deckel und Steben zu schnitzen.\n");
    if (x==2) write("Der Fuxer sagt: Naegel um alles zusammenzunageln.\n");
    if (x==3) write("Der Fuxer sagt: Einen Hammer zum haemmern.\n");
    if (x==4) write("Der Fuxer sagt: Ein Kohlestueck um die Lebenseinheiten daraufzuschreiben.\n");
    if (x==5) write("Der Fuxer sagt: Einen Glaszylinder als Behaelter.\n");
  }

  }
 
  return ("schaut Dich erwartungsvoll an.\n"); 

}

dosanduhr()
{
 object objyeti;
 done=1;

 if (bw==1) 
 {
 write("Der Fuxer sagt: Tut mir leid ich habe bereits eine Uhr gebaut.\n"+
       "Der Fuxer sagt: Ich bin auf der suche nach neuem Lebenssand, wenn\n"+
       "Der Fuxer sagt: ich wieder welchen habe kann ich Dir helfen.\n"+
       "Der Fuxer sagt: Komm spaeter wieder.\n");
 return ("sucht weiter nach Lebenssand.");
 }

 if(done!=1)
 {
 return ("sagt: Wie soll ich sie bauen?\nDer Fuxer sagt: Ich hab ja nicht mal alle Teile fuer die Sanduhr!\n");
 }

 do_uhr();
 return("sagt: So lustig ist es zu arbeiten.\n");
 
}



do_uhr()
{
 object ob;


 if (i==1) write("Der Fuxer haemmert und werkt an der Sanduhr.\n");
 if (i==2) write("Der Fuxer zimmert sich aus dem Brett, dem Nagel und dem Hammer eine kleine Kiste.\n");
 if (i==3) write("Der Fuxer nimmt das Seerosenblatt, setzt es auf den Glaszylinder und fuellt den Sand ein.\n");
 if (i==4) write("Der Fuxer setzt den Glaszylinder in die Kiste.\n");
 if (i==5) write("Der Fuxer zeichnet eine Skala auf die Kiste.\n");
 if (i==6) write("Der Fuxer begutachtet sein Werk.\n"); 
 if (i==7) write("Der Fuxer grinst.\n");
 if (i==8) { 
   write("Der Fuxer sagt: Hier hast Du die Sanduhr, damit sollte Dich die Wache in den Turm lassen!\n"); 
   ob=clone_object("/d/ebene/lamuerte/turm/obj/sanduhr.lpc");
   ob->set_owna(this_player()->QueryProp(P_NAME));
   ob->move(this_player(),M_NOCHECK);
   call_out("killgnome",5);
   bw=1;
   } 

 i=i+1;
 
 if (co!=1 && co<=8) call_out("do_uhr",2);
}

killgnome()
{
 write(
 "Der Fuxer winkt Dir noch zu und wuenscht Dir Glueck im Turm.\n"); 
  remove_call_out("do_uhr");
 i=1;
//this_object()->remove();
}

resetbuild()
{bw=0;
 return 1;
}
