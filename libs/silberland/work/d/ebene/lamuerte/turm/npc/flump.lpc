
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <defines.h>


object *enems=({});
int ridden;
string rider;

create()
{
  if (!is_clone(this_object())) return;
  
::create(); 
  
  SetProp(P_SHORT, "Murgo, der Esel");
  SetProp(P_LONG, 
  "Ein kleiner stinkender Esel. Er sieht sehr gefraessig aus.");
  SetProp(P_INT_LONG,
      "Auf dem Ruecken eines Esels.");
  SetProp(P_INT_SHORT,
      "Auf dem Esel");
  SetProp(P_NAME, "Murgo, der Esel");
  SetProp(P_RACE, "Esel");
  SetProp(P_SIZE, 195);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"esel","\nesel","murgo"}));
  create_default_npc(30);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_HANDS, ({" mit seinen Hufen",500})); 
  SetProp(P_SPELLRATE,50);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_SLASH:0.2, DT_FIRE: 0.5])    );
  SetProp( P_REJECT, REJECT_KEEP);
  SetProp(P_ARTICLE,0);

AddInfo( DEFAULT_INFO,"kannn nicht sprechen.");
      
  ridden=0;
  rider="none";
  AddCmd("reite","do_ride"); 
  AddCmd("steige","do_mount"); 
  AddCmd(({"sag","sage"}),"do_say"); 
  AddCmd("fuehre","do_lead");
}

string int_long(mixed viewer,mixed viewpoint, int shortflag)
{
    string s;
      s=QueryProp(P_INT_LONG);
        if (environment() && QueryProp(P_TRANSPARENT))
              s += "Ausserhalb siehst Du:\n" +
                         environment()->int_short(viewer,this_object());
          return s;
}

string int_short(mixed viewer,mixed viewpoint, int shortflag)
{
    string s;
      s=QueryProp(P_INT_SHORT)+".\n";
        if (environment() && QueryProp(P_TRANSPARENT))
              s += "Ausserhalb siehst Du:\n" +
                         environment()->int_short(viewer,this_object());
          return s;
}


do_mount(string str)
{

  notify_fail("Wo willst Du histeigen?\n");

  if(!str) return 0;

  if( str=="auf esel" || str=="auf"){ 
    if(ridden==1){
      write(capitalize(rider)+" sitzt schon euf dem Esel. Da ist kein Platz mehr fuer Dich.\n");
      return 1;
    }

//    if(this_player()->QueryProp(P_NAME)!="UTX") {
//      say(this_player()->QueryProp(P_NAME)+" will Murgo besteigen, schafft es aber nicht.\n");
//      return 1;
//    }
    write("Du steigst auf den Esel.\n");
    this_player()->move(this_object(), M_GO, "auf den Ruecken eines Esels", "klettert", "klettert herein");
    ridden=1;
    rider=this_player()->QueryProp(P_NAME);
    SetProp(P_SHORT, capitalize(rider)+" sitzt auf einem Esel");
    AddDetail(lower_case(rider),"Jo, sitzt gerade auf einem Esel!");
    return 1;
  }


  if(str=="ab" || str=="herunter" || str=="herab" || str=="von esel" || str=="von esel herunter" || str=="von esel ab"){
    if(lower_case(rider)!=lower_case(this_player()->QueryProp(P_NAME))){
      write("Du sitzt doch gar nicht auf dem Esel.\n}");
      return 1;
    }
    write("Du steigst vom Esel.\n");
   ridden=0;
   rider="none";
   SetProp(P_SHORT, "Murgo, der Esel");
    this_player()->move(environment(this_object()), M_GO, "vom Ruecken eines Esels", "klettert", "klettert vom Ruecken eines Esels");
   RemoveDetail(lower_case(rider));
   return 1;
  }

}



do_ride(string str)
{string *BLAH;
 string *SCHNARR;
 string rname,rdir;

 int x;
 int y;
 y=0;
 BLAH=m_values(environment(this_object())->QueryProp(P_EXITS));
 SCHNARR=m_indices(environment(this_object())->QueryProp(P_EXITS));

 if(lower_case(rider)!=lower_case(this_player()->QueryProp(P_NAME))){
   write("Reiten? Dazu brauchst Du zuerst einen reitbaren Untersatz!\n");
   return 1;
 }
   
 if (!str){
   write("Wohin?\n");
   return 1;
 }

   
 if (member_array(str,SCHNARR)==-1)
 { write("Murgo will dort nicht hingehen!\n"); 
  return 1; 
 }

 rname=environment(this_object())->QueryProp(P_EXITS)[str];
 rdir=str;

 write("Du reitest nach "+capitalize(rdir)+".\n");
 tell_room(environment(this_object()),"Ein Esel trabt mit "+capitalize(rider)+" auf dem Ruecken nach "+capitalize(rdir)+".\n");
 this_object()->move(rname, M_GO+M_SILENT);
 write(int_short(this_player(),this_player(),1));
 tell_room(environment(this_object()),"Ein Esel trabt mit "+capitalize(rider)+" auf dem Ruecken herein.\n");
 return 1;
}

catch_tell(string str){
 string plrn,blah;

 if(ridden!=1) return 1;
 
 plrn="nix"; 
 if(sscanf(str,"Ein Esel trabt mit %s auf dem Ruecken nach %s",plrn,blah)==2){
     return 1;
  }

 if(sscanf(str,"Ein Esel trabt mit %s auf dem Ruecken %s.",plrn,blah)==2){
     return 1;
  }

 sscanf(str,"%s bruellt %s",plrn,blah);
 
 if(lower_case(plrn)==lower_case(rider)) return 1; 

  if(ridden==1){
    tell_object(find_player(lower_case(rider)),str); 
  }
  return 1;
}

do_say(string str){
 if(lower_case(rider)==lower_case(this_player()->QueryProp(P_NAME))){
  tell_room(environment(this_object()),capitalize(rider)+" bruellt vom Ruecken eines Esels herunter: "+str+"!!!\n");
  write("Du bruellst vom Ruecken eines Esels herunter: "+str+"!!!\n");
  return 1;
 }
}
