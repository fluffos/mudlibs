
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>

int i;

create()
{
  if (!is_clone(this_object())) return;
  
::create(); 
  
  SetProp(P_SHORT, "Khe'dmir, Anfuehrer der Untoten");
  SetProp(P_LONG, 
  "Du siehst Khe'dmir den Anfuehrer der Untoten. Er regiert diese Ebene des Turms. Naeher betrachtet "+
  "siehst Du ein riesiges Skelett vor Dir das um einiges groesser ist als Du. Mit "+
  "seinem riesigen Knochenschwert spaltet er die Schaedel seiner Gegner mit Leichtigkeit entzwei.");
  SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Khe'dmir");
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 295);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"CHEDMIR","untoter","Khe'dmir","khe","khedmir","skelett"}));
  create_default_npc(40);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 8); 
  SetProp(P_HANDS, ({" mit sein knochigen Klauen",300,DT_TERROR})); 
  SetProp(P_SPELLRATE,30);
  SetProp(P_RESISTANCE, ({ DT_SLASH, DT_POISON, DT_TERROR,
                           DT_PIERCE}));
  SetProp(P_VULNERABILITY, ({ DT_LIGHT }));
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "betritt den Raum");
  SetProp(P_MSGOUT, "verschwindet vor Deinen Augen");

  SetProp(P_DIE_MSG, " loest sich in einen Knochenhaufen auf.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Hilfe ich wurde vernichtet!");
  SetProp(P_KILL_NAME, "Khe'dmir der Anfuehrer der Untoten");
  SetProp(P_KILL_MSG, "Endlich hab ich wieder meine ruhe!");

  SetProp( P_REJECT, REJECT_KEEP);
  clone_object("/d/ebene/lamuerte/turm/obj/knochenschwert")->move(this_object());  
  clone_object("/d/ebene/lamuerte/turm/obj/dreizackdolch")->move(this_object());  
  command("zuecke dolch");
  set_living_name("khedmir");
  AddInfo( DEFAULT_INFO,"kannn nicht sprechen.");

  AddSpell(9,450+random(730),
      "  Khe'dmir S C H W E R T S P A L T E T Deinen Koerper.\n",
      "  Khe'dmir spaltet @WEN.\n",
      DT_SLASH, ([SP_SHOW_DAMAGE: 1]) );

}

