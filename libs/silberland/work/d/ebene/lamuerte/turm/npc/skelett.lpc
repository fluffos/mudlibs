inherit "/p/std/npc/skeleton";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h> 
#include <mnpc.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG, "Ein untotes Skelett. Es klappert wie wild mit seinen Knochen. ");
  SetProp(P_NAME, "Skelett");
  SetProp(P_GENDER, NEUTER);
  AddId(({"untoter", "skelett"}));
  create_default_skeleton(35);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen knochigen Haenden",600})); 
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 160+random(20) );
  AddId("skelett"); 
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Skelett will nichts von Dir haben.\n"
    "@WEN einfach nicht von Dir nehmen.\n" }) );
 
  SetProp (P_MNPC_AREA, "/d/ebene/lamuerte/turm/rooms/");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_DEFAULTROOM, "/d/ebene/lamuerte/turm/rooms/room2_b1.lpc");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
   SetProp(P_RESISTANCE_STRENGTHS, ([DT_SLASH:0.2, DT_FIRE: 0.5])    );

  
  //  give_gems();   
   "/obj/gemmaster"->DistributeGem(0, 3, 1, 1);
}


int give_gems(){
  string *gems;

  if(random(199)>=99) return 1; 

  gems=({"amethyst","aquamarin","bergkristall","bernstein","diamant","granat","lapislazuli","onyx","opal","rubin","saphir","smaragd","topas","turmalin","zirkon"});
  
 clone_object("/obj/gems/"+gems[random(sizeof(gems))])->move(this_object());

  return 1;
}


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int i;
  for(i=1; present("untoter " + i) ;i++)
  {
     present("untoter " + i)->Kill(enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);

}
