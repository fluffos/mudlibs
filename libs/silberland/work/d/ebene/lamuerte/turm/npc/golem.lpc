// Golems, erschaffen aus meinen Drachen files            
// lam
// create_default_golem(int level,int gsize)
// level 1..11
// size  1..6
//
// Fehler in P_NAME_ADJ behoben  07.05.2006  Yara

#pragma strong_types

inherit "/std/npc";

#include <properties.h>
#include <wizlevels.h>
#include <npc.h>
#include <language.h>
#include <attributes.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#ifndef AddProp
#define AddProp(x,y) SetProp(x, QueryProp(x)+(y))
#endif

ENVCHECKPROC

nosave int _set_level(int arg);
int areadamage, golemage, golemtype, golemalign;


void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"golem", "STD_Golem", "\n_STD_Golem"}));
  SetProp(P_NAME,"Golem");
  SetProp(P_SHORT,"Ein UNDEFINIERTER Golem"); 
  SetProp(P_LONG,
      "Ein riesiger Steingolem steht vor Dir. Du solltest ihn wohl nicht reizen, "+
      "ansonsten wird er Dich zu Brei schlagen. Am besten beachtest Du ihn erst gar "+
      "nicht und schleichst klammheimlich an ihm vorbei.");
  SetProp(P_MSGIN, "baut sich vor Dir auf.\nDie Erde faengt an zu beben");
  SetProp(P_MSGOUT, "geht#.\nDer Boden unter deinen Fuessen bebt");
  SetProp(P_MMSGIN, "erscheint aus einer anderen Dimension");
  SetProp(P_MMSGOUT, "zerfaellt");
  SetProp(P_GENDER, MALE );
  SetProp(P_RACE, "Golem");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TEMPERATURE_RANGE, ([0:-10, 1:50]));
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_MAX_WEIGHT, 140006263);

  //
  // VON ANGROX EINGEBAUT (11.09.2000)
  //SetProp(P_AGGRESSIVE, (float)((random(4)+1)/10.0));
  SetProp(P_AGGRESSIVE, (float)((random(4)+6)/10.0));
  //
  // 

  //  SetProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.8, DT_PIERCE:-0.7, DT_SQUEEZE:-0.8, DT_WHIP:-0.9, DT_RIP:-0.7, DT_SLASH:-0.8, DT_FIRE:-1 ])    );

}

void create_default_golem(int level,int gsize)
{ 
  string *groesse, *gestein;
  int scalevalue,y,x;
  object *inv,cash;  

  if(level < 1 || level > 11) level=1;
  if(gsize < 1 || gsize > 6) gsize=1;

  golemtype = level;
  golemage= gsize;

  create_default_npc(20+level*2+gsize*2);
  SetProp(P_HANDS, ({" mit seinen steinernen Pranken", 250+level*10+gsize*25, 
        DT_BLUDGEON }) );
  SetProp(P_BODY, (250+(level*15)+(gsize*20)));
  SetProp(P_XP, (int) (1.3*(QueryProp(P_XP))) );

  SetProp(P_WEIGHT, 450000*gsize+40000*level );
  SetProp(P_SIZE, (300+(level*4*gsize)) );
  SetProp(P_SPELLRATE, 10+(level+gsize)*5 );
  groesse = ({ "mannesgross", "buschgross", "baumhoh", "haushoh", 
               "felshoh", "berghoh"});
  gestein=({ "Lehm", "Sandstein", "Granit", "Marmor", "Basalt", "Porphyr", 
             "Kalkstein", "Diabas", "Gneis", "Schiefer", "Quarz" });
  SetProp(P_NAME, gestein[level-1]+"golem");
  SetProp(P_NAME_ADJ, groesse[gsize-1]);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_ALIGN,  -((gsize/3+1)*190));
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:-1]) );
  SetProp(P_NOMAGIC, 3+gsize*2+level*4); 
  AddId( ({ lower_case(gestein[level-1])+"golem",lower_case(gestein[level-1]) }) );

  SetProp(P_LONG,
      "Ein "+groesse[gsize-1]+"er "+gestein[level-1]+"golem steht vor Dir. "
      "Du solltest ihn wohl nicht reizen, ansonsten wird er Dich zu Brei "
      "schlagen. Am besten beachtest Du ihn erst gar "
      "nicht und schleichst klammheimlich an ihm vorbei.");

  SetProp(P_DIE_MSG, " zerbroeselt.\n");
  SetProp(P_MURDER_MSG, "Die Golemhorde wird sich raechen, %s!");
  SetProp(P_KILL_MSG, "Die Golemhorde hat zugeschlagen!");
  //  SetProp(P_AGGRESSIVE,([P_RACE:(["Dunkelelf":0.0, 0:0.1])]));
  SetProp(P_AGGRESSIVE,0);

  (cash=clone_object("/obj/money"))->SetProp(P_AMOUNT,random(level*gsize*345)+199);
  cash->move(this_object(),M_NOCHECK);

  for(x=0;x<=(int) ((this_object()->QueryProp(P_LEVEL)/10)-3);x++)
  {
    cash=clone_object("/d/ebene/lamuerte/turm/obj/heiltrank.lpc");
    cash->move(this_object(),M_NOCHECK);
  }

  "/obj/gemmaster"->DistributeGem((level/4)+(gsize/2), 3, 1, 1);

  if(random(100)>80) {
    "/obj/gemmaster"->DistributeGem(1, 0, 0, 1, "diamant");
  }

  if((level+gsize)>(random(7)+5)){
    clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    if(random(100)>(50-(level+gsize))) 
      clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    if(random(100)>(80-(level+gsize))) 
      clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    if(random(100)>(97-(level+gsize))) 
      clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
  }

  AddSpell(1,1,
      "",
      "",
      ({DT_BLUDGEON}),"block_spell");

  switch ( level) 
  {   
    case 1:
      AddSpell(2,70*((level+gsize)/3)+100,
          "  Der Lehmgolem wirft Dir einen Lehmklumpen nach.\n",
          "  Der Lehmgolem wirft @WEM einen Lehmklumpen nach.\n",
          ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.1, DT_PIERCE:0.1, DT_SQUEEZE:-0.2, 
                                        DT_WHIP:-0.3, DT_RIP:-0.2, DT_SLASH:-0.1 ])    );
      break;
    case 2: 
      AddSpell(2,90*((level+gsize)/3)+90,
          "  Der Sandsteingolem wirft Dir eisig kalte Sandkoerner ins Gesicht.\n",
          "  Der Sandsteingolem wirft @WEM eisig kalte Sandkoerner ins Gesicht.\n",
          ({DT_COLD}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.2, DT_PIERCE:0.1, DT_SQUEEZE:-0.3, 
                                       DT_WHIP:-0.4, DT_RIP:-0.3, DT_SLASH:-0.2])    );
      break;
    case 3:    
      AddSpell(2,110*((level+gsize)/3)+80,
          "  Der Granitgolem zerreisst Dich in der Luft.\n",
          "  Der Granitgolem zerreisst @WEN in der Luft.\n",
          ({DT_RIP}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.2, DT_PIERCE:0.1, DT_SQUEEZE:-0.3, 
                                        DT_WHIP:-0.4, DT_RIP:-0.3, DT_SLASH:-0.2 ])    );
      break;
    case 4:
      AddSpell(2,130*((level+gsize)/3)+70,
          "  Der Marmorgolem zerquetscht Dich mit seinen grossen Pranken.\n",
          "  Der Marmorgolem zerquetscht @WEN mit seinen grossen Pranken.\n",
          ({DT_SQUEEZE}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.3, DT_PIERCE:0.1, DT_SQUEEZE:-0.4, 
                                        DT_WHIP:-0.4, DT_RIP:-0.3, DT_SLASH:-0.3 ])    );
      break;
    case 5:
      AddSpell(2,170*((level+gsize)/3)+30,
          "  Der Basaltgolem laesst einen fuerchterlichen Schrei los. Du bist beinahe taub!\n",
          "  Der Basaltgolem laesst einen fuerchterlichen Schrei los. Nun ist @WER ist beinahe taub!\n",
          ({DT_SOUND}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.4, DT_PIERCE:0.1, DT_SQUEEZE:-0.4, 
                                        DT_WHIP:-0.5, DT_RIP:-0.4, DT_SLASH:-0.3])    );
      break;   
    case 6:
      AddSpell(2,170*((level+gsize)/3)+30,
          "  Der Porphyrgolem stapmft Dich mit seinen Fuessen in die Erde.\n",
          "  Der Porphyrgolem stapmft @WEN mit seinen Fuessen in die Erde.\n",
          ({DT_SQUEEZE}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.5, DT_PIERCE:0.1, DT_SQUEEZE:-0.5, 
                                        DT_WHIP:-0.5, DT_RIP:-0.5, DT_SLASH:-0.4 ])    );
      break;
    case 7:
      AddSpell(2,170*((level+gsize)/3)+60,
          "  Der Kalksteingolem blaest Dir Kalkstaub ins Gesicht.\n",
          "  Der Kalksteingolem blaest @WEM Kalkstaub ins Gesicht.\n",
          ({DT_LIGHT}),([SP_SHOW_DAMAGE:1])); //Naja blendet auch wie helles licht...
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.6, DT_PIERCE:0.1, DT_SQUEEZE:-0.6, 
                                        DT_WHIP:-0.5, DT_RIP:-0.6, DT_SLASH:-0.5])    );
      break;
    case 8:
      AddSpell(2,190*((level+gsize)/3)+30,
          "  Der Diabasgolem haelt Dich am Ruecken fest und donnert Deinen ganzen Koerper gegen den Boden.\n",
          "  Der Diabasgolem haelt @WEN am Ruecken fest und donnert Ihn gegen den Boden.\n",
          ({DT_RIP}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.7, DT_PIERCE:0.1, DT_SQUEEZE:-0.6, 
                                        DT_WHIP:-0.6, DT_RIP:-0.6, DT_SLASH:-0.6 ])    );
      break;
    case 9:
      AddSpell(2,210*((level+gsize)/3)+50,
          "  Der Gneisgolem berserkt Dich wie wild geworden nieder.\n",
          "  Der Gneisgolem berserkt @WEN nieder.\n",
          ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.7, DT_PIERCE:0.1, DT_SQUEEZE:-0.6, 
                                        DT_WHIP:-0.7, DT_RIP:-0.6, DT_SLASH:-0.6 ])    );
      break; 
    case 10:
      AddSpell(2,220*((level+gsize)/3)+50,
          "  Der Schiefergolem zerfetzt Dich in einzelne Atome.\n",
          "  Der Schiefergolem zerfetzt @WEN in einzelne Atome.\n",
          ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.8, DT_PIERCE:0.1, DT_SQUEEZE:-0.7, 
                                        DT_WHIP:-0.8, DT_RIP:-0.7, DT_SLASH:-0.7])    );
      break;
    case 11:
      AddSpell(2,250*((level+gsize)/3)+70,
          "  Der Quarzgolem **VERNICHTET** Dich mit einem Schlag.\n",
          "  Der Quarzgolem **VERNICHTET** @WEN.\n",
          ({DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
      AddSpell(1,1,
          "  Der Quarzgolem zerstoert Deine Ruestung als er Steine vom Himmel fallen laesst.\n",
          "  Der Quarzgolem zerstoert Deine Ruestung als er Steine vom Himmel fallen laesst.\n",
          ({DT_BLUDGEON}),"area_spell");
      AddSpell(1,100,
          "  Der Quarzgolem zertruemmert Deinen Schaedel. Du brichst am Boden zusammen.\n",
          "  Der Quarzgolem zertruemmert @WESSEN Schaedel. Er bricht leblos am Boden zusammen.\n",
          ({DT_BLUDGEON}),"paralyze_spell",([SP_SHOW_DAMAGE:1]));
      AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.8, DT_PIERCE:0.1, DT_SQUEEZE:-0.8, 
                                        DT_WHIP:-0.9, DT_RIP:-0.7, DT_SLASH:-0.8])    );

  }
} 


void area_spell(object enemy,int damage, mixed dam_type)
{
  int i,j;
  object *inv; 
  object *armours;

  inv=filter_array(all_inventory(environment(this_object())), #'living );
  for(i=sizeof(inv)-1;i>=0;i--) 
  {
    if(member_array("golem",inv[i]->QueryProp(P_IDS))!=-1 ||
        IS_LEARNING(inv[i])) 
      damage=0; 
    else
    {
      inv[i]->Defend(random(areadamage), dam_type, 
          ([SP_SHOW_DAMAGE:1,SP_NAME:"Meteorblast"]), this_object());
      armours=inv[i]->QueryProp(P_ARMOURS); 
      for(j=0;j<sizeof(armours);j++)
      {
        if( !random(3) && armours[i]->QueryProp(P_AC) && 
            !armours[i]->id("todesschienen"))
        {
          armours[i]->SetProp(P_AC, armours[i]->QueryProp(P_AC)-1);
          armours[i]->SetProp(P_DAMAGED, armours[i]->QueryProp(P_DAMAGED)+1);
        }
      }
    }
  }
  return;
}


void paralyze_spell(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: random(4)+2,
        PARALYZE_MSG: "Du versuchst Dich zu bewegen, Deinen Koerper gehorcht aber nicht.\n",
        PARALYZE_MSG_OTHER: "%s windet sich am Boden liegend vor Schmerzen.\n",
        PARALYZE_END: "Du spuerst wie Leben in Deinen Koerper zurueckkehrt.\n",
        PARALYZE_END_OTHER: "%s springt wieder auf die Beine!\n"]));
}


void block_spell(object enemy, int damage, mixed dam_type)
{
  object ob;

  if(!ob=present("\ngolemstein",this_object())) return ;
  ob->aufstell();

}

void create_leader(){
  object ob;
  this_object()->SetProp(P_SHORT,"Ush Nazgul, Quarzgolem und Anfuehrer der Golemhorde");
  this_object()->AddId(({"ush","nazgul","anfuehrer"}));
  ob=clone_object("/d/ebene/lamuerte/turm/obj/todesschienen.lpc");
  ob->move(this_object(),M_NOCHECK);
  this_object()->SetProp(P_MAX_HP,7912);
  command_me("ziehe alles an");
  set_living_name("nazgul");
  SetProp(P_DIE_MSG, " zerbroeselt.\n");
  SetProp(P_MURDER_MSG, "Ich dachte ich bin unbesiegbar!!!!");
  SetProp(P_KILL_NAME, "Ush Nazgul, Quarzgolem und Anfuehrer der Golemhorde");
  SetProp(P_KILL_MSG, "KEINER KANN MICH TOETEN! HAHAHAH!!!!");
  SetProp(P_ARTICLE,0);
  SetProp(P_NAME,"Ush Nazgul");

}

void die(int poisondeath)
{
  object spieler, ob;
  spieler=this_object()->QueryProp(P_KILLER);
  write_file("/d/ebene/lamuerte/turm/GOLEM.log",
      ctime()+": "+capitalize(getuid(this_player()))+" killt: "+this_object()->QueryProp(P_SHORT)+"\n");
  if( !IS_LEARNER(this_player()) && this_object()->QueryProp(P_NAME)=="Ush Nazgul" ) 
    domainshout(capitalize(this_player()->Name())+
        " hat Ush Nazgul, Quarzgolem und Anfuehrer der Golemhorde bezwungen.\n");
  ::die(poisondeath);
}

int Defend(int dam, mixed dtype, int spell, object enemy){
  object ob;

  if (ob=present("donnerdorn",enemy) ){
    if(ob->QueryProp(P_WIELDED) && (this_object()->QueryProp(P_HP)) > 1500) {
      tell_room(environment(),enemy->QueryProp(P_NAME)+" U L T R A S L A Y E D  einen Golem mit einem Donnerdorn!\n");
      return :: Defend(500 + dam*2, dtype, spell, enemy);
    }
  }
  return ::Defend(dam, dtype, spell, enemy);
}

