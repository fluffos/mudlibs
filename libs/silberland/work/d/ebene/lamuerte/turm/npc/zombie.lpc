inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h> 
#include <mnpc.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Zombie");
  SetProp(P_LONG, "Ein ekelhaft riechender Zombie. Einige Fleischfetzen haengen ihm vom Leib, welcher nur "+
   "halb mit alten Stoffetzen eingehuellt ist. Teilweise ragen Knochen aus seinem Leib heraus.");
  SetProp(P_NAME, ({"Zombie", "Zombies", "Zombie", "Zombie"}));
  SetProp(P_GENDER, MALE);
  AddId(({"untoter", "zombie"}));
  create_default_npc(35);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_AGGRESSIVE, 0.2);
  SetProp(P_HANDS, ({" mit seinen modrigen Haenden",750})); 
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 160+random(50) );
  AddId("zombie"); 
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Da der Zombie nichts von Dir haben will, nimmt er\n"
    "@WEN einfach nicht an.\n" }) );
 
  SetProp (P_MNPC_AREA, "/d/ebene/lamuerte/turm/rooms/");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_DEFAULTROOM, "/d/ebene/lamuerte/turm/rooms/room2_b1.lpc");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
  //give_gems();   
  "/obj/gemmaster"->DistributeGem(0, 3, 1, 1);
}


int give_gems(){
  string *gems;

  if(random(599)>=99) return 1; 

  gems=({"amethyst","aquamarin","bergkristall","bernstein","diamant","granat","lapislazuli","onyx","opal","rubin","saphir","smaragd","topas","turmalin","zirkon"});
  
 clone_object("/obj/gems/"+gems[random(sizeof(gems))])->move(this_object());
 clone_object("/obj/gems/"+gems[random(sizeof(gems))])->move(this_object());

  return 1;
}


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int i;
  for(i=1; present("untoter " + i) ;i++)
  {
     present("untoter " + i)->Kill(enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);

}
