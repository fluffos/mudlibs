
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"

int i,*chances;
object ob;
string err;

void create()
{
  if (!is_clone(this_object())) return;

  ::create(); 

  SetProp(P_SHORT, "Die Mumie von Koenig Tomaaukkhen");
  SetProp(P_LONG, 
      "Eine furchterregende mit weissen Stoffresten umwickelte Mumie, "
      "irgendwer muss sie aus einem der Saerge rausgelassen haben. Durch "
      "den Stoff am Kopf schimmern zwei dunkelrote blutruenstige Augen und "
      "am Koerper hat sie sechs lange Stoffbaender mit denen sie zusaetzlich "
      "zu ihren Haenden zuschlagen kann!");
  SetProp(P_NAME, "Koenigsmumie");
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 295);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_GENDER, FEMALE);
  AddId(({"KOENIGSMUMIE","koenig","koenigsmumie","mumie","\nmumie"}));
  create_default_npc(45);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 8); 
  SetProp(P_MAX_HP,1500); 
  SetProp(P_HANDS, ({" mit ihren stinkenden Stoffresten",900,DT_SLASH})); 
  SetProp(P_SPELLRATE,80);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_SLASH:0.2, DT_FIRE: 0.5])    );
  SetProp(P_NOMAGIC,55);

  SetProp(P_MSGIN, "betritt den Raum");
  SetProp(P_MSGOUT, "verschwindet vor Deinen Augen");

  SetProp(P_DIE_MSG, " loest sich in einen Stoffhaufen auf.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Argh, jetzt bin ich wirklich tot!");
  SetProp(P_KILL_NAME, "Die Mumie Koenig Tommaaukkhens");
  SetProp(P_KILL_MSG, "Endlich hab ich wieder meine Ruhe!");


  SetProp( P_REJECT, REJECT_KEEP);
  SetProp(P_ATTRIBUTES, ([A_INT:20, A_DEX:45, A_STR:75, A_CON:30]) );

  chances=({1000,2500,6000,9400,10000});
  if(random(100)>20){
    ob=clone_object("/p/weapon/spear/pike");
  }
  else{
    ob=clone_object("/p/weapon/axe/obsidianaxt");
  }
  if(find_object(ITEMD) && random(2))
    catch(find_object(ITEMD)->identify(ob,-1,51,51,chances,1));
  ob->move(this_object(),M_NOCHECK);
  ob->SetProp (P_WC_BONUS, ([ "KOENIGSMUMIE" : 650 ]) );

  command_me("zuecke speer");
  command_me("zuecke axt");

  if(random(20)>5)
    clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(this_object());
  if(random(20)>8)
    clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(this_object());
  if(random(20)>11)
    clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(this_object());
  if(random(20)>15)
    clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(this_object());
  if(random(20)>18)
    clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(this_object());

  clone_object("/d/ebene/lamuerte/fernglas/obj/qnagel.lpc")->move(this_object(),M_NOCHECK);

  AddInfo( DEFAULT_INFO,"kannn nicht sprechen.");

  AddSpell(9,450+random(330),
      "  Die Mumie versprueht giftige Faulgase im Raum.\n",
      "  Die Mumie vergiftet @WEN.\n",
      DT_POISON,([SP_SHOW_DAMAGE:1]) );

  AddSpell(4,450+random(300),
      "  Die Mumie trifft Dich mit einem ihrer Stoffbaender.\n",
      "  Die Mumie trifft @WEN mit einem ihrer Stoffbaender.\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 550+random(550),
      "  Die Mumie spricht ihren Folterzauber.\n",
      "  Die Mumie schmeisst @WEN aus ihrer Gruft.\n",
      DT_MAGIC, "cast_move",([SP_SHOW_DAMAGE:1]));


}

int resfolt()
{
  i=0;
  return 1;
}

int follow()
{
  this_object()->move("/d/ebene/lamuerte/turm/rooms/folter.lpc",M_NOCHECK);
  return 1;
}

void cast_move(object enemy, int damage, mixed dam_type)
{

  if(i==0) {
    tell_object(enemy,
        "\nDie Koenigsmumie schmeisst Dich in ihre Folterkammer.\n");
    enemy->do_damage(10, this_object());
    enemy->move("/d/ebene/lamuerte/turm/rooms/folter.lpc",M_NOCHECK);
    call_out("follow",4);
    i=1;
    call_out("resfolt",18);
  }
}

public varargs void die(int pd) {
  object killer;
  killer = QueryProp(P_KILLER) || this_player();
  if(objectp(killer)) {
    if(killer->id("\nranger_pet")) {
      killer = killer->QueryOwner();
    }

    if(killer->QueryProp(P_GUILD) == "waldlaeufer" && !RANGER_CHECK_TASK(killer, 15)) {
      killer->Message("Raziel teilt Dir mit: Du hast es geschafft! Das ist ein empfindlicher Schlag fuer unsere Feinde!\n", MSGFLAG_TELL);
      RANGER_SET_TASK(killer, 15);
    }
  }

  ::die(pd);
  return;
}
