} 


void area_spell(object enemy,int damage, mixed dam_type)
{
  int i,j;
  object *inv; 
  object *armours;
  
  inv=filter_array(all_inventory(environment(this_object())), #'living );
  for(i=sizeof(inv)-1;i>=0;i--) 
  {
    if(member_array("golem",inv[i]->QueryProp(P_IDS))!=-1 ||
        IS_LEARNING(inv[i])) 
      damage=0; 
    else
    if(member_array("elementar",inv[i]->QueryProp(P_IDS))!=1)
      damage=10002;
    else
    {
      inv[i]->Defend(random(areadamage), dam_type, 
       ([SP_SHOW_DAMAGE:1,SP_NAME:"Meteorblast"]), this_object());
      armours=inv[i]->QueryProp(P_ARMOURS); 
      for(j=0;j<sizeof(armours);j++)
      {
        if( !random(3) && armours[i]->QueryProp(P_AC) && 
            !armours[i]->id("todesschienen"))
        {
          armours[i]->TakeFlaw(30+random(30));
        }
      }
    }
  }
  return;
}


void paralyze_spell(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_PARALYZED, ([
                 PARALYZE_TIME: random(3)+2,
                 PARALYZE_MSG: "Du versuchst Dich zu bewegen, Dein Koerper gehorcht aber nicht.\n",
                 PARALYZE_MSG_OTHER: "%s windet sich am Boden liegend vor Schmerzen.\n",
                 PARALYZE_END: "Du spuerst wie Leben in Deinen Koerper zurueckkehrt.\n",
                 PARALYZE_END_OTHER: "%s springt wieder auf die Beine!\n"]));
}


void block_spell(object enemy, int damage, mixed dam_type)
{
  object ob;

  if(!ob=present("\ngolemstein",this_object())) return ;
  ob->aufstell();
  
}

void create_leader(){
  object ob;

  this_object()->SetProp(P_SHORT,"Ush Nazgul, Quarzgolem und Anfuehrer der Golemhorde");
  this_object()->AddId(({"ush","nazgul","anfuehrer"}));
  ob=clone_object("/d/ebene/lamuerte/turm/obj/todesschienen.lpc");
  ob->move(this_object(),M_NOCHECK);


//  this_object()->SetProp(P_MAX_HP,1000);
  command_me("zuecke axt");
  command_me("zuecke schwert");
     SetProp(P_DIE_MSG, " zerbroeselt.\n");
     SetProp(P_MURDER_MSG, "Ich dachte ich bin unbesiegbar!!!!");
     SetProp(P_KILL_NAME, "Ush Nazgul, Quarzgolem und Anfuehrer der Golemhorde");
     SetProp(P_KILL_MSG, "KEINER KANN MICH TOETEN! HAHAHAH!!!!");
     SetProp(P_ARTICLE,0);
     SetProp(P_NAME,"Ush Nazgul");
  set_living_name("nazgul");
  
}

void die(int poisondeath)
{
  object spieler, ob;
    spieler=this_object()->QueryProp(P_KILLER);
     write_file("/d/ebene/lamuerte/turm/USHKILLED.log",
                  ctime()+": "+capitalize(getuid(this_player()))+" killte: "+this_object()->QueryProp(P_SHORT)+"\n");
            if( !IS_LEARNER(this_player()) && this_object()->QueryProp(P_NAME)=="Ush Nazgul" ) 
                  domainshout(capitalize(this_player()->Name())+
                              " hat Ush Nazgul, Quarzgolem und Anfuehrer der Golemhorde bezwungen.\n");

  ob=clone_object("/d/ebene/lamuerte/turm/obj/ushkey.lpc");
  ob->move(this_object(),M_NOCHECK);

  ob=clone_object("/d/ebene/lamuerte/turm/obj/schatzkey.lpc");
  ob->move(this_object(),M_NOCHECK);

  call_other("/d/ebene/lamuerte/turm/rooms/schatz.lpc","???");
  call_other("/d/ebene/lamuerte/turm/rooms/schatz.lpc","treasure");

            ::die(poisondeath);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
    command_me("iss leiche");
    write_file("/d/ebene/lamuerte/turm/USHKILLS.log",ctime()+
               ": Ush hat "+
               player->QueryProp(P_NAME)+
               " umgebracht.\n");
}






int Defend(int dam, mixed dtype, int spell, object enemy){
object ob;

  if (ob=present("donnerdorn",enemy) ){
      if(ob->QueryProp(P_WIELDED) && (this_object()->QueryProp(P_HP)) > 2000) {
      tell_room(environment(),enemy->QueryProp(P_NAME)+" U L T R A S L A Y E D Ush mit einem Donnerdorn!\n");
        return :: Defend((this_object()->QueryProp(P_HP)*2), dtype, spell, enemy);
      }
    }
           return ::Defend(dam, dtype, spell, enemy);
}

