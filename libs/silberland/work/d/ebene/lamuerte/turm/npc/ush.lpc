        ({DT_BLUDGEON}),"paralyze_spell",([SP_SHOW_DAMAGE:1]));
//        AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.8, DT_PIERCE:0.1, DT_SQUEEZE:-0.8, DT_WHIP:-0.9, DT_RIP:-0.7, DT_SLASH:-0.8, DT_FIRE:-1 ])    );
    AddProp(P_RESISTANCE_STRENGTHS,([
    DT_SLASH      :-0.8,    DT_BLUDGEON    :-0.8,    DT_PIERCE     :0.1,
    DT_SQUEEZE    :-0.8,    DT_WHIP        :-0.8,    DT_RIP        :-0.8,
