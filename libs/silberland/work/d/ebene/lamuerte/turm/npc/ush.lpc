   SetProp(P_AGGRESSIVE,1);


   (cash=clone_object("/obj/money"))->SetProp(P_AMOUNT,(level*gsize*345)+random(199));
   cash->move(this_object(),M_NOCHECK);

  //give gems to golem
//  if(level>3 && gsize>1){
//   for(y=1;y<=((level/4)+(gsize/2));y++) {
//     clone_object("/obj/gems/"+gems[random(sizeof(gems))])->move(this_object());
//   }
//   if(random(100)>75) clone_object("/obj/gems/"+gems[random(sizeof(gems))])->move(this_object());
//  }

   "/obj/gemmaster"->DistributeGem((level/4)+(gsize/2), 3, 1, 1);

  if((level+gsize)>(random(7)+5)){
    clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    if(random(100)>(50-(level+gsize))) clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    if(random(100)>(80-(level+gsize))) clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);
    if(random(100)>(97-(level+gsize))) clone_object("/d/ebene/lamuerte/turm/obj/golemstein.lpc")->move(this_object(),M_NOCHECK);

  }

        
  AddSpell(6,300,
    "",
    "",
    ({DT_BLUDGEON}),"block_spell");




    switch ( level) 
