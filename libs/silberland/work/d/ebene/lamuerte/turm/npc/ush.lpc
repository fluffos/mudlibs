        AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.3, DT_PIERCE:0.1, DT_SQUEEZE:-0.4, DT_WHIP:-0.4, DT_RIP:-0.3, DT_SLASH:-0.3, DT_FIRE:-1 ])    );
