        break;   
      case 6:
        AddSpell(2,170*((level+gsize)/3)+30,
          "  Der Porphyrgolem stapmft Dich mit seinen Fuessen in die Erde.\n",
          "  Der Porphyrgolem stapmft @WEN mit seinen Fuessen in die Erde.\n",
          ({DT_SQUEEZE}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.5, DT_PIERCE:0.1, DT_SQUEEZE:-0.5, DT_WHIP:-0.5, DT_RIP:-0.5, DT_SLASH:-0.4, DT_FIRE:-1 ])    );
        break;
      case 7:
        AddSpell(2,170*((level+gsize)/3)+60,
          "  Der Kalksteingolem blaest Dir Kalkstaub ins Gesicht.\n",
          "  Der Kalksteingolem blaest @WEM Kalkstaub ins Gesicht.\n",
          ({DT_LIGHT}),([SP_SHOW_DAMAGE:1])); //Naja blendet auch wie helles licht...
        AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.6, DT_PIERCE:0.1, DT_SQUEEZE:-0.6, DT_WHIP:-0.5, DT_RIP:-0.6, DT_SLASH:-0.5, DT_FIRE:-1 ])    );
        break;
      case 8:
        AddSpell(2,190*((level+gsize)/3)+30,
          "  Der Diabasgolem haelt Dich am Ruecken fest und donnert Deinen ganzen Koerper gegen den Boden.\n",
