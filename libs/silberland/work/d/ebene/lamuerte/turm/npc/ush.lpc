          ({DT_RIP}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:-0.7, DT_PIERCE:0.1, DT_SQUEEZE:-0.6, DT_WHIP:-0.6, DT_RIP:-0.6, DT_SLASH:-0.6,  DT_FIRE:-1 ])    );
        break;
      case 9:
        AddSpell(2,210*((level+gsize)/3)+50,
