
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <defines.h>
#include <new_skills.h>

object *enems=({});

void create()
{
  if (!is_clone(this_object())) return;

  ::create(); 

  SetProp(P_SHORT, "Eine Mumie");
  SetProp(P_LONG, 
  "Eine mit weissen Stoffresten umwickelte Mumie, irgendwer muss sie aus einem "+
  "der Saerge rausgelassen haben. Durch den Stoff am Kopf schimmern zwei rote "+
  "blutruenstige Augen und am Koerper hat sie vier Haende!");
  SetProp(P_NAME, "Mumie");
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 195);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_GENDER, FEMALE);
  AddId(({"mumie","\nmumie"}));
  create_default_npc(30);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_HANDS, ({" mit ihren stinkenden Stoffresten",500})); 
  SetProp(P_SPELLRATE,50);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_SLASH:0.2, DT_FIRE: 0.5])    );
  SetProp( P_REJECT, REJECT_KEEP);


  AddInfo( DEFAULT_INFO,"kannn nicht sprechen.");

  AddSpell(1,200+random(300),
      "  Die Mumie versprueht giftige Faulgase im Raum.\n",
      "  Die Mumie vergiftet @WEN.\n",
      DT_POISON,([SP_SHOW_DAMAGE:1]) );


}

