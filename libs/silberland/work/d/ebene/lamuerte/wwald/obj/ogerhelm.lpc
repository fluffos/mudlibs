inherit "std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Ogerhelm");
  SetProp(P_LONG, 
   "Dies ist ein Ogerhelm. Er ist aus einem Dir unbekannten Material "
   "gefertigt, welches sehr hart zu sein scheint. Der Helm ist ein "
   "Meisterstueck der Schmiedekunst, noch nie zuvor hast Du einen solch "
   "meisterhaft geformten Helm gesehen.");
  SetProp(P_NAME, "Ogerhelm");
  AddId(({"helm","ogerhelm"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 600);
  SetProp(P_AC, 7);	// abgewertet - woody
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE: 200]) );
}
