inherit "std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Seidenschuhe");
  SetProp(P_LONG,"Diese Schuhe sind aus reinster Seide genaeht.\n"
    "Die Sohle bestehr aus Leder, welches die Schuhe etwas langlebiger\n"
    "zu machen scheint.\n");
  SetProp(P_NAME, "Seidenschuhe");
  AddId(({"schuhe","seidenschuhe"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,0);
  SetProp(P_WEIGHT,300);
  SetProp(P_VALUE,300);
  SetProp(P_AC, 2);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_MATERIAL, MAT_SILK);
}
