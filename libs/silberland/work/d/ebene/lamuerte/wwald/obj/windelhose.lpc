inherit "std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Windelhose");
  SetProp(P_LONG,
    "Die Windelhose eines Jungogers. Sie stinkt fuerchterlich!\n");
  SetProp(P_NAME, "Windelhose");
  AddId(({"hose","ogerhose","windel","windelhose"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT,500);
  SetProp(P_VALUE,200);
  SetProp(P_AC, 1);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
}
