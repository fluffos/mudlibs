inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Koboldskralle");
  SetProp(P_LONG,
        "Eine kleine aus Aesten und Dornen geflochtene Knute. Als \n"+
        "Griff dient ein auf der einen Seite angebrachtes rundes Holzstueck.\n"+
        "Auf der anderen Seite sind Dornen, Steine und Splitter eingeflochten,\n"+
        "mit denen zwar kein allzugrosser Schaden angerichtet wird, jedoch\n"+
        "beim Gegner fuerchterliche Schmerzen verursacht.\n");
  SetProp(P_NAME, "Koboldskralle");
  AddId( ({"\nkkralle","kralle","koboldskralle" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WC, 115);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 4000); 
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD: 85, MAT_HORN:5, MAT_STONE:5, MAT_PLANT:5]) );
}
