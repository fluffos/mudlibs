/* FILE: frage.c
   INFO: Die Script Falle, mit pragma strict_types exakt geschrieben.
   DATE: 11.4.97
   (w) LaMuerte
*/

#pragma strict_types


inherit "std/thing";
#include "../files.h"
#include <language.h>
#include <properties.h>
#include <moving.h>

int whatword;
string aword;
int attempt;

int fragefunc ();

void 
create ()
{ object ob;
  if (!is_clone (this_object ()))
    return;
  if (ob=present("frage\n",this_player())) ob->remove();
  thing::create ();
  SetProp (P_SHORT, 0);
  SetProp (P_LONG, 0);
  SetProp (P_IDS,0);
  SetProp (P_WEIGHT,0);
  SetProp (P_KILL_NAME,"Ein Wasserdaemon");
  SetProp (P_KILL_MSG,"Haha endlich hab ich wieder wen erwischt!");
  AddId ("frage\n");

  seteuid (getuid ());
  attempt = 0;
  fragefunc ();
  AddCmd ("antworte", "afunc");
}

int 
fragefunc ()
{
  string *word, uword;
  int x, to;

  word = ({
	   "josef", "martin", "grunzen", "zigarre", "cola", "eis", "kamel",
	   "karte", "tisch", "maus", "frau", "mann", "kassette", "sand",
	   "heft", "buch", "computer", "blumen", "pflanze", "geruest",
	   "kanne", "rauch", "schall", "licht", "ofen", "kupplung", "wolf",
	   "hose", "midas", "woody", "dorn", "bild", "kassette", "stachel",
	   "angrox", "schiff", "fenster", "radio", "marlboro", "gras", "wiese",
	   "mauer", "fenster", "garage", "koerper", "rahm", "glas", "hebel",
	   "fliege", "dose", "boden", "decke", "wand", "waende", "vogel", "feuer",
	   "telefon", "schachtel", "krebs", "oger", "erde", "milch", "fleisch",
	   "kasten", "haare", "gewand", "ruestung", "schwert", "eisen", "blech"
	  });


  to = random (7) + 1;
  whatword = random (to - 1) + 1;
 
 if (attempt<=0)
 write(
  "Der Daemon sagt: Hier gibt es kein Entkommen, ich werde Dir aber\n"+
  "Der Daemon sagt: helfen, wenn Du mir eine Antwort gibst.\n" );

 if (attempt>=1)
 write(
  "\nDer Daemon sagt: So, extra fuer Dich hab ich mir noch eine\n"+
  "Der Daemon sagt: Frage einfallen lassen. Also, bemuehe Dich!\n" );
  
write(
  "Der Daemon sagt: Antworte mit dem " + whatword + ". Wort von:\n"+
  "Der Daemon sagt: ");
  for (x = 0; x <= to; x++)
    {
      uword = word[random (sizeof (word))];
      write (uword);
      if (whatword == x + 1)
	aword = uword;
    }
  
  if (attempt<=0) write (
         "\nDer Daemon sagt: Als Hilfe verrate ich Dir noch, dass es keine\n"+
         "Der Daemon sagt: zusammengesetzten Woerter gibt.\n"+
         "Der Daemon sagt: Sagst Du das falsche Wort musst Du sterben,\n"+
         "Der Daemon sagt: ansonsten entlasse ich Dich in die Freiheit.\n"+
         "Der Daemon sagt: Antworte mit: antworte <wort>\n");

  if (attempt>=1) write (
         "\nDer Daemon sagt: Ich hoff Du hast Dir genau gemerkt, was ich\n"+
         "Der Daemon sagt: Dir geraten habe. Dies ist Deine allerletzte\n"+
         "Der Daemon sagt: Chance!\n"+
         "Der Daemon sagt: Antworte mit: antworte <wort>\n");

  return 1;
}

void do_die(object vic)
{
   vic->die(); 
   remove ();
}

int 
afunc (string str)
{
  if( !present("wasserdaemon", environment(this_player())))
   return 0; 
 if (!str) 
 {
  write("Was willst Du denn antworten?\n"); 
  return 1;
 }
 
 if(find_call_out("fragefunc")!=-1)
  {write("Der Daemon sagt: Warte, ich ueberlege gerade noch!\n");
   return 1;
  }
  
  attempt++;


  if ( find_call_out( "do_die" ) != -1 )
    return( 1 );

  if ((string) lower_case(str) == aword)
    {
      write ("Der Daemon sagt: Gut, Du sollst Deine Freiheit haben.\n");
      write ("Der Daemon sagt: Ich werde Dich von hier weg teleportieren.\n");
      say ("Der Wasserdaemon spricht einige magische Worte.\n"+
           (string)this_player()->QueryProp(P_NAME)+" verschwindet.\n");
      this_player ()->move (ROOM("9y_23x.lpc"), 
                            M_GO+M_SILENT);
                            
      remove ();
      return 1;
    }

  if (attempt == 1) {
     write("Der Daemon sagt: Nun gut, AUSNAHMSWEISE bekommst Du noch ne neue\n"
           "Der Daemon sagt: Frage. Beantwortest Du sie falsch, gehts Dir\n"
           "Der Daemon sagt: ENDGUELTIG an den Kragen. Lass mich ueberlegen.\n");
     call_out("fragefunc",30);
     return( 1 );
  }

  write ("HEHE, gleich ist es AUS mit DIR, wird das ein SPASS :)\n");
  write_file("/players/lamuerte/LOG/SCRIPTER", 
           sprintf("%s: %-15.15s is verreckt\n", 
                    ctime(time()), 
                    (string) this_player()->QueryProp(P_NAME) 
        
                  )
  
          );
  call_out(  "do_die", 1, this_player() );
  return 1;
}
