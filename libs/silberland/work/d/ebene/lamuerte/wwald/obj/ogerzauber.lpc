inherit "/std/thing";

#include <properties.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
   SetProp(P_SHORT, 0);
   SetProp(P_LONG, 0);
   SetProp(P_IDS, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_NEVERDROP, 0);

   AddCmd("pfeil", "nope");
   AddCmd("feuerball", "chance");
  
    call_out("spellover",3);
  }

chance()
{int zufall;
  if (!present("ogermagier", environment(this_player()))) {
    remove();
    return 0;
  }
  
  zufall=random(100);
  
  if (zufall>=0 && zufall <=33)
   {
     write("Der Oger Magier zaubert ein magisches Schild hervor.\n"+
           "Dein Zauber prallt daran ab.\n");
//      write("NIX GETROFFEN SPELL!!!!");
//      write("HP: "+this_player()->QueryProp(P_HP));
     
     return 1;
    }
  
  if (zufall>=34 && zufall <=66)
   {
     write("Der Oger Magier wendet Deinen Zauber gegen dich.\n");
//      write("HP SPELLL!!!!");
//      write("HP VORHER: "+this_player()->QueryProp(P_HP));
    
      this_player()->SetProp(P_HP,(this_player()->QueryProp(P_HP)-(random(20)+20)));
//      write("HP NACHER: "+this_player()->QueryProp(P_HP));
     return 1;
    }


  if (zufall>=66 && zufall <=99) 
  {  object ob;
     ob=present("ogermagier",environment(this_object()));
      if (!ob) 
       {remove();
        return 0;
       }
      write("Es scheint als ob der Oger Magier die Energie deines Zaubers\n"
            +"aufsaugen wuerde.\n");
  //      write("SELBER HEILEN SPELL!!!!");
     
       if ((ob->QueryProp(P_HP))<(ob->QueryProp(P_MAX_HP-70)))
        {
  //       write("OGER HP VORHER: "+ob->QueryProp(P_HP));
         ob->SetProp(P_HP,(P_HP-(random(50)+20))); 
  //       write("OGER HP NACHHER: "+ob->QueryProp(P_HP));
         
        }
     return 1; 
  }
   
  return 1;
}


nope()
{  write("Dieser Zauber ist nicht maechtig genug um gegen den Oger Magier\n"+
          "irgendetwas ausrichten zu koennen.\n");
     return 1;
}

spellover()
{remove();
 return 0;
}