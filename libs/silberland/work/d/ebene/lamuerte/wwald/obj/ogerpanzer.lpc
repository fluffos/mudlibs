inherit "std/armour";

#include <properties.h>
#include <combat.h>
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Ogerpanzer");
  SetProp(P_LONG,
    "Dieser Panzer ist aus einem Material gefertigt, welchs Du noch\n"+
    "bei keinem anderen Panzer gesehen hast. Er ist nicht gerade leicht,\n"+
    "jedoch sehr stabil und aus einem ausserordentlich harten Material\n"+
    "geschaffen.\n");

  SetProp(P_NAME, "Ogerpanzer");
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 3000);
  SetProp(P_GENDER, MALE);
  AddId("ruestung");
  AddId("ogerpanzer");
  AddId("panzer");
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 30);	// abgewertet - woody
  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE: 200]) );
}
