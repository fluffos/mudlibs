inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Ogerkeule");
  SetProp(P_LONG,
        "Die Keule ist aus massivem Holz gefertigt. Bei diesem Gewicht\n"+
        "koennte man meinen, einen Baum in den Haenden zu halten. Das \n"
        "Griffstueck ist mit Lederbaendern umwickelt, das Kopfstueck mit\n"+
        "hunderten Eisendornen gespickt.\n");
  SetProp(P_NAME, "Ogerkeule");
  AddId( ({"keule","ogerkeule" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WC, 135);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS, (["oger":50, "ladenwaechter":100]));
  SetProp(P_WEIGHT, 2800);
  SetProp(P_VALUE, 500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:80, MAT_IRON:15, MAT_LEATHER:5]) );
}
