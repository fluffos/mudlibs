inherit "std/thing"; 
#include <language.h>
#include <properties.h>

void create()
{ 
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Ast");
  SetProp(P_LONG, 
   "Ein kleiner abgenutzter Ast.");

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Ast");
  SetProp(P_NAME_ADJ,"abgenutzt");
  
  AddId( "ast");
 
  seteuid(getuid());
}

void reset()
{
  ::reset();
  if(!is_clone(this_object())) return;
  remove();
}
