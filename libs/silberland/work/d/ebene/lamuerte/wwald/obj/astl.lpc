inherit "std/thing"; 
#include <language.h>
#include <properties.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Ast");
  SetProp(P_LONG, 
   "Ein kleiner Ast, welcher mit Baumharz beschmiert ist.");

  SetProp(P_NOGET,0);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NODROP,1);
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,200);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Ast");
  
  AddId( ({"ast","astl","\naskofski"}));
 
  seteuid(getuid());
  

}

