inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Ogerschwert");
  SetProp(P_LONG,
        "Du schaust Dir das Ogerschwert genau an. Leicht ist es ja nicht\n"+
        "gerade, dafuer sieht seine gewellte, lange Klinge sehr gefaehrlich \n"+
        "aus. In der Klinge des Schwertes sind seltsame Symbole eingraviert,\n"+
        "die Dir absolut unleserlich erscheinen.\n");
  SetProp(P_NAME, "Ogerschwert");
  AddId( ({"schwert","ogerschwert" }));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WC, 135);	// abgewertet - woody
  SetProp(P_WC_BONUS, (["oger":50, "ladenwaechter":100]) );
  SetProp(P_WEIGHT, 2800);
  SetProp(P_VALUE, 1500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE,DT_SLASH);
  SetProp(P_NR_HANDS, 1);
}
