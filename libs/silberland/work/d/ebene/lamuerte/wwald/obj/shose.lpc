inherit "std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Seidenhose");
  SetProp(P_LONG,"Eine seiderne Hose. Sie ist mit bunten Farben bemalt.\n"
    "Einst gehoerte sie einem Magier.\n");
  SetProp(P_NAME, "Seidenhose");
  AddId(({"hose","seidenhose"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT,300);
  SetProp(P_VALUE,900);
  SetProp(P_AC, 4);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0,T_HEAT_PROT:1]) );
}
