inherit "std/armour";

#include <properties.h>
#include <combat.h>
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Seidenjacke");
  SetProp(P_LONG,
    "Diese Jacke ist aus feinster Seide genaeht worden. Sie ist in lustig\n"+
    "bunten Farben bedruckt. Einst gehoerte sie einem Magier. Wie eine\n"+
    "perfekte Ruestung sieht sie ja nicht aus, jedoch ist sie dank ihrer\n"+
    "kuenstlerischen Bemalung sicher einiges wert.\n");

  SetProp(P_NAME, "Seidenjacke");
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 4000);
  SetProp(P_GENDER, FEMALE);
  AddId(({"jacke","seidenjacke"}));
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_AC, 10);	
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0,T_HEAT_PROT:1]) );
}
