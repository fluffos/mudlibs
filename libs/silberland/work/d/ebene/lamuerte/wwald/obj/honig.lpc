inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <food.h>

create()
{ 
  if(!is_clone(this_object())) return;
  ::create( ({"iss", "esse"}) );
  SetProp(P_SHORT,"Ein Stueck Honig");
  SetProp(P_LONG, 
   "Ein Stueck leckerer Waldhonig. Den muss man fast essen.\n");  
  SetProp(P_VALUE,0);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1); 
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  
  SetProp(P_NAME,"Honig");
  
  AddId (({"honig","waldhonig"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({40,40}), F_SOAK: 10, 
     F_VERB: "essen" ,
     F_MSG:"Du isst ein Stueck leckeren Waldhonig. \n"
          +"Irgendwie fuehlst Du Dich gut.\n",
     F_MSG_ROOM:"isst ein Stueckchen Honig.\n" ]) );
}


