inherit "std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Magierkappe");
  SetProp(P_LONG, 
   "Diese Kappe ist aus feinem Leder genaeht worden. Sie sieht eigentlich\n"
  +"nicht recht aufregend aus. Einst gehoerte sie einem Magier.\n");
  SetProp(P_NAME, "Magierkappe");
  AddId(({"kappe","magierkappe"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 200);
  SetProp(P_AC, 3);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, MAT_LEATHER);
}
