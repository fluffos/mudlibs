inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

int verwendet=0,re=0;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"amulett","knochenamulett"}));
  SetProp (P_SHORT, "Ein Knochenamulett");
  SetProp (P_LONG, "Das Knochenamulett eines Magiers.\n");
  SetProp (P_INFO, break_string("Das Knochenamulett ist zweifelsohne "
    "magisch. Es befinden sich einige Runen darauf.",78) );
  SetProp (P_NAME, "Knochenamulett");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 5000);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 3);
  SetProp (P_MATERIAL, MAT_BONE);
  AddCmd(({"reibe","reib"}),"reib_sub");
  AddDetail(({"rune","runen"}),
   "Die Runen zeigen ein altes Ritual, welches von Magiern ausgeuebt wird.\n");
  AddDetail("ritual",
   "Ein Magier reibt an einem knochigen Gebilde, danach verschwindet er.\n"+
   "Oh! Auf dem Amulett steht ganz klein eingeritzt: Achtung! Dieses \n"+
   "Amulett birgt vielleicht Gefahr in sich. Bitte nicht reiben!\n");

}

reib_sub(string str)
{
 notify_fail("Was willst Du reiben?\n");
 if (!str || !id(str)) return 0;
 
 if (!(this_object()->QueryProp(P_WORN)))
  {write("Du hast das Amulett gar nicht umgehaengt!\n");
   return 1;
  }
 
 if (re>=1)
  {write("Du reibst noch schneller an dem Amulett.\n");
   return 1;
  }
  
  if ((this_player()->QueryAttribute(A_DEX))<=(19+random(5)))
  {write("Du bist zu ungeschickt, lass das lieber.\n");
   return 1;
  }
  
 if (verwendet>=2)
  {write("Dein Amulett hat nicht genug magische Kraft.\n");
   write("Das Amulett zerfaellt zu Staub.\n");
   this_object()->remove();
   return 1;
  }
  write("Du beginnst wie wild an Deinem Amulett zu reiben.\n");
  re=1;
  call_out("telefunc",8);
 return 1;
}

telefunc()
{
  say(capitalize(this_player()->name())+" reibt an seinem Amulett und "+
   "verschwindet vor Deinen Augen.\n");
 write("Ein seltsames Gefuehl ueberkommt Dich.\n");
 this_player()->move("/gilden/abenteurer", M_GO+M_SILENT, "in die Gilde");
 verwendet++;
 re=0;
 this_player()->reduce_hit_point(20+random(130));
return 1;
}


