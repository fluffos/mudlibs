/*FILE: wdaemon.c
  INFO: Der Wasserdaemon, NPC zur Scriptfalle ../obj/frage.c
  DATE: 11.04.97
  (w) Lamuerte

  25.8.98: woody: move() der frage M_NOCHECK gemacht
*/ 

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <npc.h>
#include <wizlevels.h>
#include "files.h"
int aw,zf;

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Wasserdaemon");
  SetProp(P_LONG, 
  "Ein Wasserdaemon. In vielen Sagen wird erzaehlt, dass er unbezwingbar\n"+
  "sei. Er sieht sehr gefaehrlich aus. Tust Du ihm nichts, tut er Dir \n"
  "nichts. Greifst Du ihn an, bist Du sicher tot.\n");
  SetProp(P_NAME, "Wasserdaemon");
  SetProp(P_GENDER, MALE);
  create_default_npc(15);
  SetProp(P_ATTRIBUTES,(["int":20,"str":90,"con":40,"dex":20]));
  SetProp(P_ALIGN, 0);
  SetProp(P_XP,0);
  SetProp(P_MAX_HANDS, 13); 
  SetProp(P_HANDS, ({" mit seinen Haenden",1500})); 
  SetProp(P_MAX_SP,100);
  SetProp(P_MAX_HP,10000);
  SetProp(P_DEFAULT_INFO,"sagt: Ich will eine Antwort!\n");
  SetProp(P_NOATTACK, "sagt: So kommst Du da nie raus....\n");
  
  AddId(({"daemon","wasserdaemon"}));
  AddCmd(({"ende","quit"}),"efunc");
  SetProp( P_REJECT, REJECT_KEEP);
   
}

void init()
{
  if( this_player() && interactive(this_player()) && !IS_LEARNING(this_player()))
    call_out("ffunc",20); 
  ::init();
}

void ffunc()
{
  clone_object(OBJ("frage.lpc"))->move(this_player(),M_NOCHECK);
} 

efunc()
{
  write("Bis Bald!\nClosing down.\nConnection closed by foreign host.\n"+
       "LPmudQuoting\n---- No World ----\n");
  call_out("rfunc",5);
}

rfunc()
{
  write ("Nein, so leicht gehts nicht!\n");
}
