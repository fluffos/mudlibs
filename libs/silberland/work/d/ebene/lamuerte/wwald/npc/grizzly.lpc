inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Grizzly");
  SetProp(P_LONG, "Ein riesiger, boeser, fuerchterlicher Grizzlybaer. "
      "Wenn er nicht gerade vorbeilaufende Spieler frisst, wird er von den "
      "Ogern gerne als Reittier verwendet, weil ein Pferd ja nie etwas so "
      "schweres wie einen Oger tragen koennte.");
  SetProp(P_NAME, "Grizzly");
  SetProp(P_GENDER, MALE);
  AddId(({"grizzly", "baer"}));
  create_default_npc(23);
  SetProp(P_ALIGN, -100);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HANDS, ({" mit seinen Pranken", 400, DT_BLUDGEON }));
  SetProp(P_SIZE, 195);
  SetProp(P_DIE_MSG, " brummt noch einmal und faellt tot um.\n");
  // set_living_name("grizzly");

  // Ruestung
  seteuid(getuid(this_object()));
  clone_object("/d/gebirge/eros/ruestung/grizzlyfell")->move(this_object());
  command("ziehe alles an");
  
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Grizzly reisst @WEN gierig an sich.\n" }) );

  SetProp(P_DEFAULT_INFO,
      "brummt etwas Unfreundliches und Unverstaendliches.\n");

  // Spell
  SetProp(P_SPELLRATE, 40);
  AddSpell(1,800,
    "Der Grizzly schlitzt Dich mit seinen Krallen fast auf.\n",
    "Der Grizzly schlitzt @WEN mit seinen Krallen fast auf.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

}
