inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <new_skills.h>
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Blocker");
  SetProp(P_LONG, "Ein kleiner Blocker, der dich freundlich anschaut.\n");
  SetProp(P_NAME, "Blocker");
  SetProp(P_GENDER, MALE);
  AddId(({"blocker"}));
  create_default_npc(17);
  SetProp(P_ALIGN, 0);
  SetProp(P_XP,0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_RACE, "Blocker");
  SetProp(P_SIZE, 50+random(10) );
  SetProp(P_NOATTACK,"Der Blocker sagt: Ich bin nur ein Statist!\n"+
                     "Der Blocker sagt: Mich braucht man nicht angreifen!");
   
  AddCmd("norden","nfunc");
}

nfunc()
{write("Der Blocker hindert Dich daran weiter zu gehen.\n");
 write("Der Blocker sagt: Tut mir leid, "+this_player()->QueryProp(P_NAME)+ 
       ", LaMuerte bastelt grad herum,\n"+
       "Der Blocker sagt: da is es zu gefaehrlich weiter in diese\n"+
       "Der Blocker sagt: Richtung zu gehen.\n");
 return 1;
}      
