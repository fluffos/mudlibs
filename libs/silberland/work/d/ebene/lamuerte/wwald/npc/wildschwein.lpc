// wandert nun auch am Orkweg herum, da die Raeume eingeschoben wurden.
// Dusty+Stahldorn, August 2002

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Wildschwein");
  SetProp(P_LONG, "Ein grausames Wildschwein.\n");
  SetProp(P_NAME, "Wildschwein");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schwein", "wildschwein"}));
  create_default_npc(10);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_HANDS, ({" mit seinen Hauern",100})); 
  SetProp(P_RACE, "Schwein");
  SetProp(P_SIZE, 60+random(20) );
  // set_living_name("schwein");

  // Ruestung
 
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Da das Wildschwein weder Taschen noch Haende hat, kann es\n"
    "@WEN ungeschickterweise nicht tragen...\n" }) );

  SetProp (P_MNPC_AREA, ({ ROOM(""),
       "/d/ebene/dusty/orklichtung/room/orkweg" }) );
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("17y_30x.lpc"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
   
}
