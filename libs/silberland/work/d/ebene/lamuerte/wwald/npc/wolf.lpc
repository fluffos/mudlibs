// wandert nun auch am Orkweg herum, da die Raeume eingeschoben wurden.
// Dusty+Stahldorn, August 2002

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Wolf");
  SetProp(P_LONG, "Ein boeser Wolf.\n");
  SetProp(P_NAME, "Wolf");
  SetProp(P_GENDER, MALE);
  AddId(({"wolf", "wolf"}));
  SetProp(P_RACE, "Wolf");
  create_default_npc(15);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_HANDS, ({" mit seinen Pranken",170})); 
  // set_living_name("wolf");

  // Ruestung
 
  seteuid(getuid(this_object()));
  clone_object("/p/armour/cloak/wolfsfell")->move(this_object());
  command("ziehe alles an");

  SetProp( P_REJECT, REJECT_KEEP);
 
   SetProp (P_MNPC_AREA, ({ ROOM(""), 
     "/d/ebene/dusty/orklichtung/room/orkweg" }) );
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, ROOM("17y_30x.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
   // (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT,1100);
   // ob->move(this_object());
}
