inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include <new_skills.h>
#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */

  SetProp(P_SHORT, "Ein Jungoger");
  SetProp(P_LONG,
    "Ein kleiner Oger, der aber doch schon fast so gross ist wie Du.\n");
  SetProp(P_NAME, "Jungoger");
  SetProp(P_GENDER, MALE);
  AddId(({"oger", "jungoger"}));
  create_default_npc(12);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 120+random(20) );
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_TERROR: 0.3, DT_WATER: -0.5]) );
  SetProp(P_DIE_MSG, " wird nie ein echter Menschenfresser werden.\n");
  // set_living_name("joger");

  // Ruestung
 
  seteuid(getuid(this_object()));
  
  clone_object(OBJ("windelhose"))->move(this_object());
  command("trage alles");
  clone_object("/p/std/skills/sewing_tanning/obj/holz.lpc")->move(this_object());
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Jungoger bedankt sich artig und steckt @WEN ein.\n" }) );
 
  SetProp(P_SPELLRATE,30);

  AddSpell(3,230,  
   "Der Oger schiesst mit einer Steinschleuder.\n",
   "Der Oger trifft @WEN mit einem Stein.\n",
   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetChats(10, ({
   "Der Oger faselt vor sich hin.\n",
   "Der Oger sagt: Blubb Blah blubba!\n",
   "Der Oger spielt mit einem Ast.\n",
   "Der Oger springt im Kreis herum.\n",
   "Der Oger versteckt sich hinter einem Baum.\n",
   "Der Oger zeigt mit seinem Finger auf Dich.\n",
   "Der Oger hustet.\n"
  }));

 SetAttackChats(30, ({
   "Der Oger beisst Dir in die grosse Zehe.\n",
   "Der Oger schreit: Geh weg, sonst hol ich meinen grossen Bruder!\n",
   "Der Oger tritt Dir ins Schienbein.\n",
   "Der Oger zieht Dich an den Ohren.\n"
   }));
}
