inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Oger");
  SetProp(P_LONG, "Ein Oger.\n");
  SetProp(P_NAME, "Oger");
  SetProp(P_GENDER, MALE);
  AddId(({"oger"}));
  create_default_npc(19);
  SetProp(P_ALIGN, -100);
  SetProp(P_XP, QueryProp(P_XP) * 3 / 2);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_RACE, "Oger");
  SetProp(P_FOOD, 0);
  SetProp(P_SIZE, 240+random(50) );
  SetProp(P_AGGRESSIVE,([P_RACE:(["Oger":0.0, 0:0.7])]) );
  SetProp(P_DIE_MSG, " faellt krachend zu Boden.\n");
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_TERROR: 0.3, DT_WATER: -0.5]) );
  // set_living_name("noger");

  // Ruestung
 
  seteuid(getuid(this_object()));
  
  clone_object("/p/armour/trousers/fellhose")->move(this_object());
  command("trage alles");
  clone_object(OBJ("keule"))->move(this_object());
  command("zuecke keule");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Oger steckt @WEN sofort ein.\n" }) );
 
  SetProp(P_SPELLRATE,30);
  AddSpell(1,300+random(200), 
    "Der Oger schleicht geschickt an Dir vorbei.\n"
    "Der Oger trifft Dich hart am Hinterkopf.\n",
    "Der Oger schleicht sich an @WEM vorbei und "
    "trifft @WEN hart am Hinterkopf.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command("iss leiche");
}
