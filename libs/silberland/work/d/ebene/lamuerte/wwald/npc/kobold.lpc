inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Kobold");
  SetProp(P_LONG, "Ein kleiner, gemeiner Kobold.\n");
  SetProp(P_NAME, "Kobold");
  SetProp(P_GENDER, MALE);
  AddId(({"kobold"}));
  create_default_npc(18);
  SetProp(P_ALIGN, -500);
  SetProp(P_HANDS, ({" mit seinen kleinen Koboldhaendchen",170, DT_BLUDGEON})); 
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 50+random(10) );
  SetProp(P_DIE_MSG, " stirbt einen gemeinen Koboldtod.\n");
  
  //  set_living_name("kobold");

  // Ruestung
 
  seteuid(getuid(this_object()));

  clone_object("/p/std/skills/sewing_tanning/obj/holz.lpc")->move(this_object());
  clone_object(OBJ("kralle"))->move(this_object());
  command("zuecke kralle");
  SetProp(P_REJECT, ({ REJECT_KEEP,
    "Der Kobold rafft @WEN gierig an sich.\n" }) );

  SetProp(P_SPELLRATE,2);
  AddSpell(1,1500,
    "Der Kobold erhebt seine Haende.\nDu siehst wie sie in dunklem Blau "
    "zu leuchten beginnen.\nLangsam bildet sich eine weisse Lanze ueber "
    "den blauschimmernden Haenden.\nDaemonisch grinsend, mit lautem "
    "Gelaechter wirft er Dir die eisigblaue\nLanze nach.\n",
    "Der Kobold wirft eine Eislanze nach @WEM.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]));
}
