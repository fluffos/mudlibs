inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Ogerwaechter");
  SetProp(P_LONG, "Ein Ogerwaechter, der Dich grausam angrinst.\n");
  SetProp(P_NAME, "Oger");
  SetProp(P_GENDER, MALE);
  AddId(({"oger","waechter","ogerwaechter", "Speerkaempfer", "Keulenkaempfer"}));
  SetProp(P_RACE, "Oger");

  create_default_npc(20);
  SetProp(P_ALIGN, -200);
  SetProp(P_XP,280000);
  SetProp(P_AGGRESSIVE,([P_RACE:(["Oger":0.0, 0:1])]) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({"mit seiner Kelle",200}));
  SetProp(P_MAX_HP, 300);
  SetProp(P_FOOD, 0); // tichtig hungrig zum leichenfressen....
  SetProp(P_SIZE, 250+random(50) );
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_TERROR: 0.3, DT_WATER: -0.5]) );
  SetProp(P_DIE_MSG, " faellt krachend zu Boden.\n");
  SetProp(P_KILL_NAME, "Ein allesfressender Oger");
  SetProp(P_KILL_MSG, "hat wieder genug zu Essen.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0]) );
//  set_living_name("oger");

  // Ruestung
 
  seteuid(getuid(this_object()));
  
  clone_object("/p/armour/trousers/fellhose")->move(this_object());
  clone_object(OBJ("ogerpanzer"))->move(this_object());
  clone_object(OBJ("ogerhelm"))->move(this_object());
  command("trage alles");

  switch ( random(4) )
  {
    case 0: clone_object(OBJ("ogerschwert"))->move(this_object());
            command ("zuecke schwert");
            break;
//    case 1: clone_object("/p/weapon/spear/angriffspeer")->move(this_object());
//  Welcher Sack hat den Bug in mein File eingebaut?
//  -Lamuerte-
    case 1: clone_object("/p/weapon/spear/angriffsspeer.lpc")->move(this_object());
            command ("zuecke speer");
            break;
    case 2: clone_object("/p/weapon/spear/jagdspiess")->move(this_object());
            command ("zuecke spiess");
            break;
    case 3: clone_object("/p/weapon/club/stachelkeule")->move(this_object());
            command ("zuecke keule");
            break;
  }


  SetProp( P_REJECT,
    ({ REJECT_KEEP, "Der Ogerwaechter steckt @WEN erfreut ein.\n" }) );

  SetProp(P_SPELLRATE,30); //40% Wahrscheinlichkeit fuer den Spell
                           //geaendert auf 30, spell dafuer besser
                           //LaM
  AddSpell(1,500+random(300),
    "Der Ogerwaechter greift Dich mit riesiger Fressgier an.\n",
    "Der Ogerwaechter greift @WEN mit riesiger Fressgier an.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command("iss leiche");
  write_file("attackoger.deads.log",ctime()+": Der NPC hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
}
