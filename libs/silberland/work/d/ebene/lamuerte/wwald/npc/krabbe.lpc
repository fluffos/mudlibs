// 24.11.96  Woody  hat kein Geld mehr bei sich, kein livingname, rejectdrop
//

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include "files.h"

void create()
{
  // object ob;
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Eine Krabbe");
  SetProp(P_LONG, "Eine rote Krabbe.\n");
  SetProp(P_NAME, "Krabbe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"krabbe"}));
  create_default_npc(5);
  SetProp(P_ALIGN, -100);
  SetProp(P_HANDS, ({" mit ihren Scheren",50, DT_RIP})); 
  SetProp(P_RACE, "Schalentier");
  SetProp(P_SIZE, 10); 
  SetProp(P_DIE_MSG, " graebt sich toedlich verwundet im Sand ein.\n");
  
  // (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT,790);
  // ob->move(this_object());
  // set_living_name("krabbe");

  // Ruestung
 
  seteuid(getuid(this_object()));

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Krabbe ist viel zu ungeschickt, um @WEN zu tragen.\n"}) );
}

