inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Norbadenweg" );
  SetProp(P_INT_LONG,
      "Hier beginnt ein gepflasterter Weg, den die Norbaden erbaut "
      "haben. Er fuehrt suedlich zu einer alten Holzmuehle, und "
      "erleichterte den Norbaden den Holztransport. Am schlechten "
      "Zustand des Weges kannst Du erkennen, dass er wohl schon seit "
      "geraumer Zeit nicht mehr benutzt worden ist.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "pflaster", "steine", "pflastersteine" }), 
       "Die Pflastersteine sind aus Granit.");
  AddDetail( "norbaden", "Es sind keine Norbaden zu sehen.");

  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({"weg","norbadenweg"}), 
      "Ein gepflasterter Weg durch den Wald, der einem das Gehen"
      + " wirklich erleichtert. Mit grossen Wagen wurde hier Holz transportiert.");
  AddDetail( "boden",
      "Der Boden ist ein Pflaster aus Steinen.");
  AddDetail( "zustand",
      "Der Weg ist in einem schlechten Zustand, er wird schon lange "
      "nicht mehr benutzt.");
  AddDetail( ({"holz"}),
      "Der ganze Wald ist voller Holz.");
  AddDetail( ({"wagen"}),
      "Grosse Wagen transportierten hier einst das Holz.");
  
  AddDetail( "wald", "Ein ganz gewoehnlicher Wald.\n");

  AddDetail( "baum", "Baeume stehen herum, soweit das Auge reicht.\n");

  AddDetail( ({ "muehle", "holzmuehle"}),
      "Von hier aus kannst Du nichts Derartiges sehen.\n");

  AddExit( "westen", ROOM("16y_29x") );
  AddExit( "sueden", ROOM("15y_30x") );
  AddExit("nordosten",ROOM("umfahrung1.lpc"));
}


