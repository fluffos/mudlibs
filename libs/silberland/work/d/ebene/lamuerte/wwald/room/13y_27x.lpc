inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Hoehlendurchgang");
  SetProp(P_INT_LONG,
        "Du betrittst einen Hoehlendurchgang. Im Norden bemerkst Du ein "
        "leises Rascheln, in westlicher Richtung fuehrt der Weg "
        "durch die kleine Hoehle hindurch Richtung Wald. Auch hier liegen diese "
        "merkwuerdigen Stachel. ");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({ "decke", "boden", "wand", 
        "waende" }), 
       "Sowohl die Decke, der Boden als auch die "
        "Waende bestehen aus glattem Felsgestein. Wahrscheinlich "
        "Granit.");
  AddDetail( ({ "granit" }), 
       "Das Granit ist hart und glatt.");
  AddDetail( ({ "weg" }), 
       "Der Weg ist hier ziemlich ausgetrampelt. "
        "Offensichtlich benuetzen ihn auch die Tiere des Waldes.");
  AddDetail( ({ "wald" }), 
       "Der Wald ist unheimlich, aber er hat auf "
        "seine Weise auch eine gewisse Schoenheit.");
  AddDetail( ({ "stachel", "stuecke" }), 
       "Diese Stachel sehen merkwuerdig aus, keine "
        "Ahnung welche Tiere solch grosse Stachel haben.");
  AddSound(DEFAULT_SOUND,"Du hoerst irgendetwas rascheln.\n");
  AddSound("rascheln",
      "Man erkennt nicht was es ist, aber es kommt aus dem Norden.\n");


  AddItem(NPC("wolf"),REFRESH_DESTRUCT);

  AddDetail( ({ "moos" }), 
       "Das Moos ist gruen, weich und waechst auf Felsen.");
  AddDetail( ({ "fels", "felsen" }), 
       "Der Fels ist mit Moos bewachsen.");
  AddDetail( ({ "durchgang" }), 
       "Der Durchgang besteht aus Granit. Er sieht beeindruckend aus.");
  AddDetail( "licht", "Ohne Fackel geht es wohl nicht.\n");

  AddDetail( "stachel", "Riesige Stuecke von Stacheln.\n");

  AddDetail( "hoehle",
      "Ein kleiner in den Fels gehauener Durchgang.\n");

  AddDetail ( "weg",
      "Der Weg fuehrt durch einen Durchgang, der in den Fels gehauen ist.\n");

  AddExit( "westen", ROOM("13y_26x") );
  AddExit( "osten", ROOM("13y_28x") );
  AddExit( "norden", ROOM("14y_27x") );
}


