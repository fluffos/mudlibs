inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung" );
  SetProp(P_INT_LONG,
      "Du bist erleichtert als Du eine kleine Lichtung erreichst. Du hoerst die "
      "Voegel froehlich zwitschern und die Bienen leise summen. Inmitten der " 
      "Lichtung steht ein Wegweiser, der aus einer Holzplatte gefertigt ist.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddSound( ({"bienen","gesumse","summen"}),
      "Du hoerst das leise Summen der fleissigen Bienen.\n");
  AddSound( ({"zwitschern","gezwitscher","voegel","vogel"}),
      "Du hoerst das leise Zwitschern der lustigen Voegel.\n");



  AddDetail( ({ "karte" }), 
      "Eine Uebersicht vom Ogerwald.");
  AddDetail( ({ "uebersicht" }), 
      "Eine Karte vom Ogerwald." );
  AddDetail( ({ "baum" }), 
      "Ein grosser Baum, an dem eine Holzplatte "+
        "angebracht ist." );
  AddDetail( ({ "wegweiser" }), 
      "Eine Holzplatte, die an einem Baum befestigt "+
        "ist." );
  AddDetail( ({"voegel", "bienen", "vogel" , "biene"}),
      "Tierchen des Waldes, wie gut das es sie gibt.\n"); 

  AddDetail( "lichtung",
      "Die Lichtung ist etwa 6 mal 4 Meter gross. Es sieht alles\n"
      + "sehr friedlich aus. In der Mitte der Lichtung steht ein Wegweiser.\n");

  AddReadDetail( ({"wegweiser","karte"}),
      ".---------------------------------------.\n"
      + "|                                  N    |\n"
      + "|               K r  da         W     o |\n"
      + "|                 /                S    |\n"
      + "|                |                      |\n"
      + "|                  ---  bo d o le       |\n"
      + "|                |                      |\n"
      + "|                \\                      |\n"
      + "|         F   i   -Sc l   t             |\n"
      + "._______________________________________.\n"
      );
  AddDetail( ({"kyranda"}),
      "Im Nordosten gehts nach Kyranda.");
  AddDetail( ({"kobolde"}),
      "Die Kobolde sind im Osten.");
      
  AddDetail( ({"platte", "holz", "holzplatte" }),
      "Eine Holzplatte auf der eine Karte eingebrannt ist.\n");

  AddDetail("boden",
      "Ein ganz normaler Boden.\n");
  AddDetail("himmel",
      "Ein ganz normaler Himmel.\n");

  AddExit( "nordosten", ROOM("12y_24x") );
  AddExit( "osten", ROOM("11y_24x"));
  AddExit( "sueden", ROOM("10y_23x"));
}


