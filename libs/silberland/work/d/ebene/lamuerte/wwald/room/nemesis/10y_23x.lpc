inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Pfad" );
  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem kleinen Pfad, der weiter nach Norden auf "
    "eine Lichtung zufuehrt. Suedlich von Dir kannst Du einen kleinen Bach "
    "erkennen, den Du ueber eine kleine schwankende und nicht sonderlich "
    "vertrauenserweckende Bruecke ueberqueren kannst.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail ( ({ "pfad", "weg" }),
    "Der kleine Pfad fuehrt zwischen einigen vereinzelt herumstehenden "
    "Baeumen nach Norden hin auf eine Lichtung zu, auf der Du einen "
    "Wegweiser sehen kannst.");
  AddDetail ( ({ "lichtung", "wegweiser" }),
    "Wenn Du nach Norden gehst, kannst Du mehr davon erkennen.");
  AddDetail ( ({ "norden" }),
    "Im Norden kannst Du eine Lichtung erkennen.");
  AddDetail ( ({ "boden" }),
    "Der Boden unter Deinen Fuessen ist erdig und teilweise etwas "
    "feucht, wohl von dem nahen Baechlein suedlich von Dir.");
  AddDetail ( ({ "erde" }),
    "Die Erde unter Deinen Fuessen ist dank des nahen Baches etwas feucht.");
  AddDetail ( ({ "fuesse" }),
    "Du schaust Dir Deine Fuesse genauer an und seufzt.\n"
    "Du denkst . o O ( Jaja, die waren auch schon mal sauberer... )\n");
  AddDetail ( ({ "sueden", "bach", "baechlein" }),
    "Das kleine vertraeumte Baechlein im Sueden plaetschert ruhig "
    "vor sich hin.");
  AddDetail ( ({ "bruecke" }),
    "Die kleine Bruecke suedlich von Dir solltest Du moeglichst schnell "
    "passieren, sie sieht nicht sonderlich vertrauenserweckend aus...");
  AddDetail ( ({ "baeume" }),
    "Vereinzelt stehen einige Baeume entlang des Weges, ganz so, als ob "
    "sie ihn begleiten wollten...");
  AddSound( ({DEFAULT_SOUND, "plaetschern", "baechlein", "bach"}),
    "Du hoerst Ein Plaetschern aus dem Sueden. Es kommt wohl von dem "
    "kleinen Baechlein.");
  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");

  AddExit( "norden", ROOM("11y_23x") );
  AddExit( "sueden", ROOM("9y_23x"));
}

