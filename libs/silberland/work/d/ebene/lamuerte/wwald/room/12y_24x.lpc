inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Pfad");
  SetProp(P_INT_LONG,
      "Der kleine Pfad verbindet die kleine Lichtung mit einem Felsdurchgang. "
      "Geroell und Steine liegt hier herum, welche Dir das Vorwaertskommen "
      "etwas erschweren. Du solltest aufpassen, dass Dir kein Stein auf den "
      "Kopf faellt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({ "fels", "felsen" }), 
       "Felsspat, Quarz und Glimmer. Duerfte sich um "+
        "Granit handeln.");
  AddDetail( ({ "felsspat", "quarz","glimmer" }), 
       "Ein Bestandteil des Gesteins. ");

  AddDetail("weg",
      "Du untersuchst den Weg. Es scheint ihm gut zu gehen.\n");
  AddDetail( ({ "durchgang" }), 
       "Der Durchgang ist sehr eng. Du solltest "+
        "schleunigst schauen, dass Du hier weg kommst, bevor noch "+
        "was Schlimmes geschieht...");
  AddDetail( ({"pfad", "boden"}),
      "Du stehst auf einem steinigen Pfad.\n");

  AddDetail( "geroell", "Das Geroell ist sehr rutschig.\n");

  AddDetail( ({"steine","stein"}), "Die Steine liegen nur im Weg herum. \n");

  AddDetail( ({"felsdurchgang", "lichtung"}),
      "Der Felsdurchgang liegt im Nordosten, die kleine Lichtung "
      + "hingegen im Suedwesten. Von hier aus kann man nichts naeheres "
      + "erkennen.");

  AddExit( "osten", ROOM("12y_25x") );
  AddExit( "suedwesten", ROOM("11y_23x") );
}

