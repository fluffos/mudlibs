inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Buschweg" );
  SetProp(P_INT_LONG,
      "Du befindest Dich inmitten eines grossen gruenen Gestruepps. "
      "Es ist etwas dunkler hier, und Du kannst nichts sehen ausser "
      "den Zweige dieses Gestruepps. Ein kleiner ausgetrampelter Weg "
      "fuehrt hier vom Westen her kommend in den Norden weiter, wo es "
      "ein wenig heller zu sein scheint. Anscheinend kommt man in " 
      "dieser Richtung wieder ins Freie.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail("gestruepp",
      "Das Gestruepp ist ziemlich dicht, man kann nichts ausser dem Gestruepp sehen.\n");

  AddDetail("weg",
      "Ein ausgetrampelter Weg fuehrt vom Westen kommend in Richtung Norden.");

  AddDetail("zweige",
      "Die vielen Zweige bilden zusammen ein dichtes Gestruepp.");

  AddDetail("licht",
      "Es kommt aus dem Westen, anscheinend geht das dort raus aus dem Gestruepp.");

  AddDetail("richtung",
      "Du musst schon selbst entscheiden in welche Richtung Du gehst.");

  AddDetail("himmel",
      "Himmel siehst Du hier keinen.\n");

  AddDetail("boden",
      "Ein ausgetrampelter Weg ist am Boden zu sehen.\n");


  AddSmell(({DEFAULT_SMELL, "gestruepp"}),
      "Es riecht nach Gestruepp.\n"); 
  AddSound(({DEFAULT_SOUND, "gestruepp"}),
      "Das Gestruepp raschelt, wenn Du Dich bewegst.\n"); 

  AddExit( "westen", ROOM("buschweg1.lpc") );
  AddExit( "norden","/d/ebene/lamuerte/burg/weg/17x6y.lpc");
  AddCmd ( ({"beweg","bewege"}), "bfunc" );
}


bfunc (str)
{object me; 
  write("Du bewegst Dich.\nDu hoerst ein RASCHELRASCHEL.\n");
  return 1;
}
