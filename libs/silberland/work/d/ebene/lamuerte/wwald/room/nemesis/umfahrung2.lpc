inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

int i;

void create()
{
  ::create();
  i=1;

  SetProp(P_INT_SHORT,"Im Wald");
  SetProp(P_INT_LONG,
      "Alles rund um Dich ist mit vielen Baeumen bewachsen. Der Wald ist hier "+
      "schon etwas dichter geworden und die vielen Zweige verhindern den Blick "+
      "auf den Himmel, wenn Du nach oben siehst. Von einem hohlen Baum, in "+
      "welchem sich ein Loch befindet, kannst Du surrende Geraeusche wahrnehmen. "+
      "Im Nordosten geht es weiter in den Wald hinein, im Suedwesten lichten "+
      "sich die Baeume etwas." 
      );

  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddSmell(DEFAULT_SMELL,
      "Es duftet nach Wald. Nebenbei nimmst Du einen suesslichen Geruch wahr.");
  AddSmell("wald",
      "Der Wald riecht wunderbar nach Wald. :)\n");
  AddSmell("geruch",
      "Es riecht etwas suesslich.\n");

  AddSound(({DEFAULT_SOUND, "geraeusche"}),
      "Du nimmst ein leises Summen wahr.\n");
  AddSound(({"summen", "surren"}),
      ".....SSsSSuusuSZzzszZSSUusSzzSsSSSSS.....");
  AddDetail(({"wald","waldes"}),
      "Der Wald ist voller Baeume, welche herrlich duften. Irgendwie baut es Dich "+
      "auf, dass Du in einer solch prachtvollen Umgebung stehst. ");

  AddDetail(({"baum","baeume"}),
      "Es sind ausschliesslich Nadelbaeume. Einer von ihnen hat ein Loch."); 

  AddDetail(({"nadelbaum","nadelbaeume"}),  
      "Es muessen tausende Nadeln sein. Der Baum ist total mit ihnen bewachsen.");

  AddDetail(({"nadel","nadeln"}),
      "Eins, zwei, drei, vier....siebenhunderteinundsiebzig... Nein es sind zu vielei,"+ 
      " es wuerde Jahre dauern um alle zu sehen.");

  AddDetail ("jahre",
      "Geschaetzt fuenfzehneinhalb Jahre wuerdest Du brauchen um alle Nadeln zu "+
      "zu zaehlen."); 

  AddDetail("boden",
      "Feines Waldgras bedeckt den Boden." );

  AddDetail(({"gras","waldgras", "gruen"}),
      "Das Gras sieht saftig aus. Sein Gruen ist sehr kraeftig.");

  AddDetail("zweige",
      "Es sind zu viele Zweige um alle auf einmal zu untersuchen, aber "+
      "im Gesamten sehen sie toll aus.");

  AddDetail("himmel",
      "Du kannst den Himmel vor lauter Zweigen nicht sehen.");

  AddDetail("blick",
      "Du blickst herum und stellst fest, dass Du im Wald stehst.");

  AddDetail("loch",
      "Es ist zu dunkel in dem Loch, um zu sehen was drinnen ist, doch "+
      "Du hoerst ein Summen, welches aus dem Loch zu kommen scheint. " +
      "Ob man da was reinstecken kann?");

  AddDetail("summen",
      "Du hoerst es, sehen kannst Du es nicht.");

  AddDetail("geraeusche",
      "Du kannst Sie nicht sehen, nur hoeren.");

  AddCmd( ({"steck","stecke","schieb","schiebe"}), "sfunc"); 

  AddExit("nordosten",ROOM("19y_33x.lpc")); 
  AddExit("suedwesten",ROOM("umfahrung1.lpc"));
}


int sfunc(string wosn)
{
  object astl,honey;
  string was,wohin;

  if(!wosn)
  {
    notify_fail("Was willst Du wohin schieben??\n");
    return 0;
  }
  if(sscanf(wosn,"%s in %s", was , wohin)!=2)
  {
    notify_fail("Was willst Du wohin schieben?\n");
    return 0;
  }
  if(was=="ast" && wohin == "loch")
  {
    if ((astl=deep_present("\naskofski",this_player()))) 
    {
      if (honey=deep_present("xxxyz",this_player()))
      {write ("Als Du den Ast in das Loch steckst, rutscht er Dir aus der "+
          "Hand und\nverschwindet darin.\n");
      astl->remove(); 
      return 1;
      }  
      write("Du schiebst den Ast in das Loch und holst etwas Honig heraus.\n");
      clone_object(OBJ("honig.lpc"))->move(this_player(),M_NOCHECK); 
      clone_object(OBJ("astl_abgenutzt.lpc"))->move(this_player(),M_NOCHECK); 
      astl->remove(); 
      write_file("/d/ebene/lamuerte/wwald/log/honig.log",ctime()+
          ": Ein stueck Honig wurde gerade von "+
          this_player()->QueryProp(P_NAME)+
          " genommen.\n");
      return 1;
    } 
    else
    {
      notify_fail("Nein, dieser Ast passt hier bestimmt nicht rein.\n");
      return 0;
    } 
  }
  notify_fail("Das soll gehen? Schieeeb... Aeh, aber was und wohin?\n");
  return 0; 
} 

