inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Waldweg" );
  SetProp(P_INT_LONG,
      "Der Weg schlaengelt sich in suedwestlicher Richtung durch "
      "eine Waldschlucht. Der ueberaus dichte Bewuchs erschwert Dir hier "
      "das Vorwaertskommen. Im Suedosten kannst Du einen kleinen "
      "Wegweiser erkennen. Nordoestlich geht es zu einer Lichtung.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "himmel", "blau" }), 
      "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({ "wurzel", "wurzeln" }), 
      "Damit holt sich der Baum Nahrung aus der "
      "Erde. Sie sehen stinknormal aus.");
  AddDetail( ({ "wald" }), 
      "Der Wald sieht eigentlich aus wie ein Wald, "
      "nur etwas groesser.");
  AddDetail( "weg", "Der Weg fuehrt vom Nordosten nach Suedosten.\n");

  AddDetail( ({ "dicht", "bewuchs", "boden" }),
      "Wurzeln, hohes Gras und Steine erschweren das Vorwaertskommen.\n");

  AddDetail( ({"wurzel", "wurzeln", "gras", "steine" }),
      "Du kannst nichts besonderes erkennen.\n");

  AddDetail( "wegweiser",
      "Von hier aus ist er nicht lesbar.\n");

  AddDetail( ({ "licht", "lichtung"}),
      "Die Lichtung der Oger liegt im Nordosten.\n");

  AddDetail ( ({ "schlucht", "waldschlucht" }),
      "Ein enger steiniger Weg durch den Wald.\n");

  AddExit( "nordosten", ROOM("18y_29x") );
  AddExit( "suedosten", ROOM("16y_29x") );
}


