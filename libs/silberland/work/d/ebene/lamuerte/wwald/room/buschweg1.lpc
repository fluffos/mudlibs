inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Buschweg" );
  SetProp(P_INT_LONG,
      "Du befindest Dich inmitten eines grossen gruenen Gestruepps. "
      "Es ist etwas dunkler hier, und Du kannst nichts sehen ausser "
      "die Zweige dieses Gestruepps. Ein kleiner ausgetrampelter Weg "
      "fuehrt nach Osten weiter wo es noch ein wenig dunkler zu sein scheint. " 
      "Vom Westen her dringt etwas mehr Licht duch das Gestruepp, anscheinend "
      "kann man es in dieser Richtung verlassen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail("gestruepp",
      "Das Gestruepp ist ziemlich dicht, man kann nichts ausser das Gestruepp sehen.\n");

  AddDetail("weg",
      "Ein ausgetrampelter Weg fuehrt Richtung Osten.");

  AddDetail("zweige",
      "Die vielen Zweige bilden zusammen ein dichtes Gestruepp.");

  AddDetail("licht",
      "Es kommt aus dem Westen, anscheinend geht das dort raus aus dem Gestruepp.");

  AddDetail("richtung",
      "Du musst schon selbst entscheiden, in welche Richtung Du gehst.");

  AddDetail("himmel",
      "Himmel siehst Du hier keinen.\n");

  AddDetail("boden",
      "Ein ausgetrampelter Weg ist am Boden zu sehen.\n");


  AddSmell(({DEFAULT_SMELL, "gestruepp"}),
      "Es riecht nach Gestruepp.\n"); 
  AddSound(({DEFAULT_SOUND, "gestruepp"}),
      "Das Gestruepp raschelt, wenn Du Dich bewegst.\n"); 

  AddExit( "westen", ROOM("19y_33x") );
  AddExit( "osten",ROOM("buschweg2.lpc"));
  AddCmd ( ({"beweg","bewege"}), "bfunc" );
}


bfunc (str)
{object me; 
  write("Du bewegst Dich.\nDu hoerst ein RASCHELRASCHEL.\n");
  return 1;
}
