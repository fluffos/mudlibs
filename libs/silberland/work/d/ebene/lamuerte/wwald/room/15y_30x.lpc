inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Norbadenweg" );
  SetProp(P_INT_LONG,
      "Der Norbadenweg fuehrt in Nord-Sued-Richtung durch den Wald. Trotz "
      "der teilweise herumliegenden Pflastersteine, ist es hier "
      "weitaus bequemer zu gehen als auf den unwegsamen Waldwegen. "
      "Linker und rechter Hand ragen riesige Baeume in den Himmel.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "wolke", "wolken" }), 
       "Die Wolken sind weiss, klein und vereinzelt "+
        "am Himmel zu sehen.");
  AddDetail( ({ "pflaster", "granit" }), 
       "Gewoehnliche Pflastersteine, aus Granit "+
        "gefertigt.");
  AddDetail( ({ "baum", "baeume", "holz" }), 
       "Gewoehnliche Baeume. Sie bestehen aus Holz.");

  AddDetail( ({"weg","norbadenweg"}), "Ein gepflasterter Weg durch den Wald.\n");
  AddDetail( ({"boden"}),
      "Der Boden ist ein Pflaster.");

  AddDetail( "wald", "Ein ganz gewoehnlicher Wald.\n");

  AddDetail ( "himmel", 
      "Klarer blauer Hintergrund mit einigen weissen Wolken geschmueckt.\n");

  AddDetail( ({"baum", "baume"}), 
      "Baeume stehen herum, soweit das Auge reicht.\n");

  AddDetail( ({ "steine", "pflastersteine"}),
      "Alte Pflastersteine, die einst die Norbaden verlegten.\n");
  AddDetail ( ({"norbaden", "norbade"}),
      "Die Norbaden haben einst diesen Weg gepflastert.");

  AddExit( "norden", ([ EX_DEST: ROOM("16y_30x"), EX_TESTFUNC: "guest_check" ]) );
  AddExit( "sueden", ROOM("14y_30x") );
}

  int guest_check() {
    if(this_player()->QueryGuest())
    { 
      write(break_string(
            "Ploetzlich auftretende astrale Verwirbelungen machen es Dir "
            "(als Gast!) unmoeglich, weiter nach Norden zu gehen!"
            ,78));
      return 0;
    }
    return 1;
  }

