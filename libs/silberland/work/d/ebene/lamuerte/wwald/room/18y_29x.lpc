inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung" );
  SetProp(P_INT_LONG,
      "Das westliche Ende der Lichtung ist erreicht. Der Geruch wird langsam "
      "wieder ertraeglich. Ein steiniger Weg verschwindet in westlicher "
      "Richtung, leicht bergab in einen Wald."); 

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "himmel", "blau" }), 
      "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({ "nadel", "nadeln" }), 
       "Die Nadeln sind gruen, klein und spitz.");
  AddDetail( ({ "rinde" }), 
       "Die Rinde ist braun und gehoert dem Baum.");
  AddDetail( ({ "baum", "baeume" }), 
       "Die Baeume sind gross, haben eine braune Rinde und gruene Nadeln.");
  AddDetail( ({ "steine" }), 
      "Es sind grosse, kleine, eckige und runde Steine.");
  AddDetail( ({ "erde", "boden" }), 
      "Die Erde ist braun und kuehl. Es liegen "
      "einige Steine herum.");
  AddSmell(DEFAULT_SMELL,"Es riecht nach Verfaultem.\n");
  AddSmell("wald","Es riecht gut. Endlich ist der Gestank vorbei.\n");

  AddDetail ("weg",
      "Ein schmaler, begehbarer mit Steinen gespickter, zum gehen geeigneter "
      "streifen Erde.\n");

  AddDetail( ({ "geruch", "intensiv", "luft" }),
      "Langsam brennt Deine Nase nicht mehr, der Gestank verzieht sich.\n");

  AddDetail( "lichtung",
      "Du stehst auf der Lichtung der Oger.");

  AddDetail( "wald",
      "Es duftet nach Nadelbaeumen, Du stehst ja auch in einem Wald.\n");

  AddItem(NPC("oger.lpc"),REFRESH_DESTRUCT);
  AddItem(NPC("attackoger.lpc"),REFRESH_DESTRUCT);


  AddExit( "osten", ROOM("18y_30x") );
  AddExit( "sueden", ROOM("17y_29x") );
  AddExit( "suedwesten", ROOM("17y_28x") );
  AddExit( "norden", "/d/ebene/zordan/ogerhoehle/room/draussen");
}

