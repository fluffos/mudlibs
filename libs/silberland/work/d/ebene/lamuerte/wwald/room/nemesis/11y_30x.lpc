inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();

  SetProp(P_INT_SHORT, "Am Fluss" );
  SetProp(P_INT_LONG,
    "Du bist am Ende einer kleinen Sandbank angelangt. Vor Dir siehst Du den "
    "Lamsen, welcher ein kleiner Fluss ist. Die Sonne kann hier ungehindert "
    "scheinen. Das Wasser ist kuehl und klar. Du siehst Dein Spiegelbild "
    "im rauschenden Wasser des Flusses.");
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_WATER]) );

  AddItem(NPC("krabbe"),REFRESH_REMOVE);
  AddItem(NPC("krabbe"),REFRESH_REMOVE);
  AddItem(NPC("krabbe"),REFRESH_REMOVE);

  AddSound(DEFAULT_SOUND,"Du hoerst den Fluss rauschen.\n");
  AddSound("rauschen","Das Rauschen wirkt irgendwie beruhigend.\n");
  AddSound("fluss","Der Fluss rauscht heftig.\n");
  
  AddDetail("boden",
   "Ein wirklich schoener, ganz super toller Boden.\n");
 
  
  AddDetail( ({ "sonne" }), 
                 "Die Sonne erwaermt hier alles. So manches "+
                "Leben wird durch sie erweckt.");
  AddDetail( "leben",
      "Ja, Du lebst!");
  AddDetail( ({"bank", "sandbank"}),
    "Sand, Sand und nochmal Sand.\n");
  AddDetail( "ende",
      "Hier endet die Sandbank, dahinter ist dann der Fluss.");

  AddCmd( ({"betrachte", "betracht"}),"reinschau");

  AddDetail( ({"bild","spiegelbild"}),
   "Das Spiegelbild sollte man naeher betrachten.\n"); 
 
  AddDetail( "sand", "Viele kleine Koernchen.\n");

  AddDetail( "koernchen", "Die vielen Koernchen nennt man Sand.\n");

  AddDetail( ({"fluss", "lamsen"}),
   "Das Wasser des Flusses sieht wirklich sehr erfrischend aus.\n");

  AddDetail( "wasser",
   "Vielleicht solltest Du es mal mit waschen probieren...\n");

  AddCmd( ({"wasche", "waschen"}), "waschi");

  AddExit( "westen", ROOM("11y_29x"));
}

int waschi(string was)
{
  notify_fail ("WAS willst Du waschen?\n");
  if (!was) return 0;
  if (was != "gesicht") {
    write ("Das braucht nicht gewaschen zu werden.\n");
    return 1;
  } 
  write("Du waescht Dir Dein Gesicht. Es ist wirklich angenehm.\n");
  say(this_player()->QueryProp(P_NAME)+" waescht sich "+
      this_player()->QueryPossPronoun(NEUTER,WEN,SINGULAR)+" Gesicht.\n");
  return 1;
}

int reinschau(string was)
{
  notify_fail ("Was moechtest Du betrachten?\n");
  if (!was) return 0;
  if (was != "spiegelbild" && was != "bild" && was !="spiegelbild naeher") {
    write ("Nichts besonders daran zu finden.\n");
    return 1;
  } 

  write(break_string(
        "Du betrachtest Dein unklares Spiegelbild. Irgendwie bist Du heute wieder " +
        "extrem schoen. Muss wohl der kalte Kaffee gewesen sein. Ein" +
        (this_player()->QueryProp(P_GENDER)==FEMALE?"e ":" ")+
        this_player()->QueryProp(P_RACESTRING)[0] +" bleibt halt immer noch ein"+
        (this_player()->QueryProp(P_GENDER)==FEMALE?"e ":" ")+
        this_player()->QueryProp(P_RACESTRING)[0] +".",78));
  return 1;
}
