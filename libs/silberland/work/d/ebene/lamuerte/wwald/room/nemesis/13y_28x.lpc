inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein duesterer Pfad" );
  SetProp(P_INT_LONG,
      "Du stehst auf einem dunklen Pfad. "
      "Hier ist es wirklich sehr dunkel. Von aussen kann kein Licht "
      "mehr eindringen. Du siehst einen riesigen Stachel am Boden "
      "liegen, der furchterregend aussieht.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddItem(NPC("grizzly"));

  AddDetail( ({ "erde", "erdig", "steine", "steinig", "teil" }), 
       "Bestandteile des Bodens. Erde auf der Steine "+
        "herumliegen.");
  AddDetail( ({ "boden" }), 
       "Ein erdiger, steiniger Pfad.");
  AddDetail( ({ "stueck" }), 
       "Das Stueck sieht genauso aus wie die anderen "+
        "Stachel auch, nur das es kuerzer ist, da es ja kein ganzer "+
        "Stachel ist, sondern nur ein Teil davon.");
  AddDetail( "licht", "Ohne Fackel geht es wohl nicht.\n");

  AddDetail( "stachel", 
      "Ein Stueck eines langen braunen Stachels.\n");

  AddDetail( ({"baum", "baumkronen", "himmel"}),
      "Du kannnst den Himmel nicht durch die Baumkronen sehen.\n");

  AddDetail( ({"pfad"}),
      "Ein Stachel liegt auf dem Pfad.\n");

  AddExit( "westen", ROOM("13y_27x") );
  AddExit( "osten", ROOM("13y_29x") );
}


