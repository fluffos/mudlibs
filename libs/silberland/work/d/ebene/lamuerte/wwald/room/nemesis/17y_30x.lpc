inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung" );
  SetProp(P_INT_LONG,
      "Du befindest Dich in der suedoestlichen Ecke der Lichtung, "
      "die von dichten, undurchdringlichen Baeumen abgeschlossen ist. "
      "Der ueble Geruch hat auch hier noch in keinster Weise ein Ende "
      "gefunden. In der Naehe eines Busches, ist eine verloschene "
      "Feuerstelle zu sehen. ");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddSmell(({DEFAULT_SMELL, "geruch"}),
      "Dir wird schlecht bei diesem ueblen Geruch.\n");

  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({ "lichtung" }), 
       "Die Lichtung bietet Wohnraum fuer die Oger.");
  AddDetail( ({ "ecke" }), 
       "Du untersuchst alles, findest nichts und bist verbluefft.");
  AddDetail( ({ "boden" }), 
       "Du untersuchst den Boden, findest aber nichts.");
  AddDetail( ({ "baum", "baeume" }), 
       "Die Baeume eines Waldes. Nichts besonderes zu finden.");
  AddDetail( ({ "geruch", "intensiv", "luft" }),
      "Ein wirklich nicht auszuhaltender Gestank erfuellt die Luft.\n");

  AddDetail( ({"feuerstelle", "feuer", "stelle"}),
      "Du wuehlst in der Feuerstelle, kannst jedoch nichts entdecken.\n");

  AddDetail( "wald",
      "Es duftet nach Nadelbaeumen, Du stehst ja auch in einem Wald.\n");

  AddDetail(  "busch" ,
      "Ein gruener Busch, hinter dem sich eine Feuerstelle befindet.\n");


  AddItem(NPC("jungoger"),REFRESH_DESTRUCT);
  AddItem(NPC("attackoger"),REFRESH_DESTRUCT);

  AddExit( "norden", ROOM("18y_30x") );
  AddExit( "westen", ROOM("17y_29x") );
}

