/* Trampelpfad (Lamuerte)
 * ---
 * 23.11.96  Woody  Weg zu den Kobolden mit Warnung versehen
 */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

string *gewarnt=({});
#define WARNED (member(gewarnt, getuid(this_player()))!=-1)

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Trampelpfad" );
  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem Trampelpfad. Es wird langsam wieder "
    "kuehler, da die Sonne nicht mehr durch das dichte Baumwerk dringen "
    "kann. Aus dem Norden hoerst Du seltsame, beunruhigende Geraeusche.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({"boden", "pfad", "trampelpfad"}),
    "Ein ausgetrampelter Pfad.\n");

  AddDetail( "kuehl", "Brrrr.. langsam wird es kalt.\n");

  AddDetail( ({"baum", "baumwerk", "baeume", "wald", "sonnenlicht", "sonne", "himmel"}),
   "Dichtes Baumwerk versperrt zum Grossteil das Einfallen des Sonnenlichts.");

  AddDetail( ({ "geraeusche", "geraeusch"}),
    "Probiers mal mit lauschen!");
  AddSound( ({ "geraeusche", "geraeusch"}),
    "Die Geraeusche hoeren sich sehr seltsam an.");

  
  AddSound(DEFAULT_SOUND,"Du hoerst Unheimliches aus dem Norden.\n");


//  AddExit( "osten", ROOM("11y_29x") );
  AddExit( "osten", HALBORKROOM("orkweg1") );
  AddSpecialExit( "nordwesten", "kobolde");
  AddExit( "westen", ROOM("11y_27x") );
}


int kobolde(string str)
{
  if (WARNED)
    return this_player()->move(ROOM("12y_27x"), M_GO,
      "aengstlich nach Nordwesten");
  write (
    "Eine innere Stimme scheint Dich eindringlich davor zu warnen,\n"
    "weiter nach Nordwesten zu gehen... Du haeltst noch einmal ein.\n");
  say (break_string(
    capitalize(this_player()->name())+" will offenbar nach Nordwesten "+
    "gehen, haelt aber jaeh inne...", 78));
  gewarnt += ({getuid(this_player())});
  if (this_player()->QueryProp(P_WIMPY) < 120)
    write (
      "Und vielleicht solltest Du, wenn Du doch weitergehen willst,\n"
      "die ganze Sache doch etwas vorsichtiger angehen...\n");
  return 1;
}

void reset()
{
  ::reset();
  gewarnt=({});
}

