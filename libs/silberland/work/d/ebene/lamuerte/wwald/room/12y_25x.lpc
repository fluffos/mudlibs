inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Pfad");
  SetProp(P_INT_LONG,
      "Ein kleiner Pfad verbindet hier den Felsdurchgang mit der "
      "Lichtung. Steiniges Geroell liegt herum, welches Dich beim "
      "Vorwaertskommen etwas aufhaelt. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]) );

  AddItem(NPC("wolf"),REFRESH_DESTRUCT);

  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({ "steine", "felsen" }), 
       "Du bist Dir sicher dass es sich um Granit "+
        "handelt.");
  AddDetail("granit",
      "In das Granit ist '...dank Larissa gibt es dieses schoene Granit...' "
      "eingeritzt.\n"); 
  AddDetail( ({"pfad", "boden"}),
      "Du stehst auf einem steinigen Pfad.\n");

  AddDetail( "geroell", "Das Geroell ist sehr rutschig.\n");

  AddDetail( ({"felsdurchgang", "lichtung", "durchgang"}),
      "Der Felsdurchgang liegt im Nordosten, die kleine Lichtung "
      "hingegen im Suedwesten. Von hier aus kann man nichts Naeheres "
      "erkennen.");

  AddExit( "nordosten", ROOM("13y_26x") );
  AddExit( "westen", ROOM("12y_24x") );
}

