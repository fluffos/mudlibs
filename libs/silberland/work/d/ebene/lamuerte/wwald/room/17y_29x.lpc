inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung" );
  SetProp(P_INT_LONG,
      "Wie ueberall auf dieser Lichtung riecht es sehr streng. "
      "Am besten man verlaesst diesen Ort so schnell wie nur moeglich. "
      "Der Boden ist hier mit frischem Stroh ausgelegt. Es hat den Anschein "
      "als ob sich hier ein grosses Wesen eine Art Schlafstaette "
      "eingerichtet hat.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddSmell(DEFAULT_SMELL,"Es stinkt.\n");

  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({ "baum", "nadelbaum", "nadelbaeume" }), 
       "Die Baeume sind beeindruckend gross.");
  AddDetail( ({ "bett" }), 
       "Stroh, welches als Schlafstaette dient.");
  AddDetail( ({ "schlaflager", "schlafstaette" }), 
       "Stroh, welches zu einer Art von Bett "+
        "gestapelt ist.");
  AddDetail( ({ "geruch", "intensiv", "luft" }),
      "Ein wirklich nicht auszuhaltender Gestank erfuellt die Luft.\n");

  AddDetail ("wesen",
      "Etwas, das sicherlich groesser ist als Du, normalerweise boese schaut\n"
      +"und noch nicht zu Abend gegessen hat.\n");

  AddDetail ("stroh",
      "Viel weiches Stroh, das zu einem einfachen Schlaflager zusammengelegt\n"
      + "wurde.\n");

  AddDetail ( ({"boden", "schlafstaette"}),
      "Der Boden ist mit Stroh ausgelegt.\n");

  AddDetail( "lichtung",
      "Du stehst auf der Lichtung der Oger.\n");

  AddDetail( "wald",
      "Es duftet nach Nadelbaeumen, Du stehst ja auch in einem Wald.\n");

  AddItem(NPC("oger"), REFRESH_DESTRUCT);

  AddExit( "norden", ROOM("18y_29x") );
  AddExit( "osten", ROOM("17y_30x") );

}


