inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "files.h"

int i=0;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Norbadenweg" );
  SetProp(P_INT_LONG,
      "Du befindest Dich am Ende des Norbadenweges. Hier steht ein "
      "total verfallenes Haus. Auf einem Schild kannst Du erkennen, "
      "dass es sich frueher um eine Holzmuehle gehandelt hat. Dem "
      "Zustand nach zu urteilen, ist sie schon sehr lange nicht "
      "mehr in Betrieb gewesen. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddItem (NPC("wolf"),REFRESH_DESTRUCT);

  AddReadDetail("schild",
      "Du versuchst das Schild zu lesen, doch mehr als 'H lzm ehle' ist nicht\n"+
      "zu erkennen.\n");
  AddDetail( "boden",
      "Der Boden besteht aus Pflastersteinen.");

  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({ "ende" }), 
       "Tja, hier ist der Weg aus.");
  AddDetail( ({"stein"}),
      "Ein Granitstein neben dem anderen.");

  AddDetail("pflasterstein",
      "Der Stein ist ein Stein, und hat nichtmal ein Bein.\n");

  AddDetail("bein",
      "Das Bein vom Stein kann nicht sein, da der Stein hat gar kein Bein.\n");

  AddDetail( ({"weg","norbadenweg"}), "Das Ende des Norbadenweges.\n");

  AddDetail( "wald", "Ein ganz schoen grosser Wald.\n");

  AddDetail( "schild", "Ein kleines, unleserliches Kupferschild.\n");

  AddDetail("kupfer",
      "Du untersuchst das Kupfer, doch Du findest ueberhaupt ganz und gar nix.");

  AddDetail( ({"muehle", "haus", "holzmuehle", "muehle"}),
      "An ein Betreten ist da nicht zu denken.\n");

  AddCmd( ({"betrete","betritt"}),"betr");

  AddExit( "norden", ROOM("13y_30x") );
  // AddExit( "suedwesten", ROOM("11y_29x") );
  AddExit( "suedwesten", HALBORKROOM("orkweg1") );
}

betr(string was)
{
  notify_fail ("Wo willst Du reingehen?\n");
  if (!was) return 0;
  if (was=="muehle" || was=="holzmuehle")
  {
    say (this_player()->name(WEM)+" faellt ein Ziegel auf den Kopf.\n");
    this_player()->reduce_hit_point(80);
    if(i==0) {
      write("Als Du das Haus betrittst, bemerkst Du ein unheimliches Knarren.\n"
          "Einige Steine und Holzbretter broeckeln aus der Decke und treffen Dich hart.\n"
          "Du nimmst eines der Bretter und entschliesst Dich, wieder zu gehen.\n");
      clone_object("/d/ebene/lamuerte/burg/miniquest/fernglas/obj/qbrett.lpc")->move(this_player(),M_NOCHECK);
      i=1;
      return 1; 
    }
    write("Als Du das Haus betrittst, bemerkst Du ein unheimliches Knarren.\n"
        "Einige Steine und Holzbretter broeckeln aus der Decke und treffen Dich hart.\n"
        "Du entschliesst Dich, wieder zu gehen.\n");

    return 1;
  }
  return 0;
}

reset(){
  ::reset();

  i=0;
}
