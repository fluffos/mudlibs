inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Waldweg" );
  SetProp(P_INT_LONG,
      "Der Weg sieht nicht gerade besonders abwechslungsreich "
      "aus. Wie ueberall stehen eine Unmenge von Baeumen "
      "herum. Kein Wunder Du stehst ja auch inmitten eines "
      "riesigen Waldes. Am Wegesrand steht ein hoelzerner Wegweiser.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddItem(NPC("grizzly"),REFRESH_REMOVE);
  AddItem(NPC("wildschwein"),REFRESH_DESTRUCT);
  AddItem(NPC("wildschwein"),REFRESH_DESTRUCT);

  AddDetail( ({ "rad", "wegesrand" }), 
       "Du siehst Dir den Uebergang zwischen Wald "
        "und Weg an und stellst fest, dass ein echter Wegesrand nur "
        "so aussehen kann.");
  AddDetail( ({ "baeume", "baum" }), 
       "Die Baeume weisen nichts ungewoehnliches auf.");
  AddDetail( ({"weg",  "boden"}),
      "Ein Weg durch den Wald.\n");

  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( "wald", "Ein ganz gewoehnlicher Wald.\n");

  AddDetail( "baum", "Baeume stehen herum, soweit das Auge reicht.\n");

  AddDetail( "wegweiser",
      "Ein Wegweiser aus Holz. Ob Du ihn wohl lesen kannst?\n");

  AddReadDetail("wegweiser",
      "             ++    \n"
      "             + +   \n"
      "++++++++++++++  +  \n"
      "+ Richtung Osten + \n"
      "+  NORBADENWEG   + \n"
      "++++++++++++++  +  \n"
      "             + +   \n"
      "             ++    \n");


  AddDetail( ({"holz", "birkenholz"}),
      "Es handelt sich um Birkenholz.\n");

  AddExit( "nordwesten", ROOM("17y_28x") );
  AddExit( "osten", ROOM("16y_30x") );
}


