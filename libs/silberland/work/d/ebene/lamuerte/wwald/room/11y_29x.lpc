inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Sandbank" );
  SetProp(P_INT_LONG,
      "Du befindest Dich auf einer kleinen, wunderschoenen Sandbank. "
      "Es wimmelt hier nur so von Muecken. Im Osten fuehrt die Sandbank zu "
      "einem kleinen Fluss, im Westen fuehrt der Weg zurueck in den Wald. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]) );


  AddDetail( ({ "sonne", "sonnenbrand", "pelz" }),
      "Die Sonne brennt Dir auf den Pelz. "+
      "Hoffentlich holst Du Dir keinen Sonnenbrand.");
  AddDetail( ({"sonnenlicht", "licht"}),
      "Das Sonnenlicht blendet Dich.");
  AddDetail( ({"himmel"}),
      "Vom Himmel strahlt die Sonne herunter. Hier ist deutlich mehr "
      "Licht wie im Wald.");

  AddDetail( ({ "wald" }), 
       "Der Wald liegt weiter im Westen.");
  AddDetail( ({ "muecken" }), 
       "Sie sind laestig und stechen. Gut wenn man "+
        "ein Insektengift haette.");
  AddDetail( ({"gift", "insektengift"}),
     "Leider hast Du kein Gift gegen die Muecken."); 
  AddDetail( ({"bank", "sandbank", "boden"}),
      "Sand, Sand und nochmal Sand.\n");

  AddDetail( "sand", "Viele kleine Koernchen.\n");

  AddDetail( "koernchen", "Die vielen Koernchen nennt man Sand.\n");

  AddDetail( "fluss", "Der Fluss befindet sich oestlich von Dir.\n");

  AddDetail( ({"muecke", "tierchen", "fluegel"}),
      "Eine Muecke ist ein Tierchen mit Fluegeln, das Dich sticht, wenn "
      +"Du nicht aufpasst.\n");

  AddExit( "osten", ROOM("11y_30x") );
  // AddExit( "nordosten", ROOM("12y_30x") );
  // AddExit( "westen", ROOM("11y_28x") );
  AddExit( "westen", HALBORKROOM("orkweg3") );
}


