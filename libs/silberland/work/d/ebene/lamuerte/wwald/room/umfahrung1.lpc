inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

int i;

create()
{
  ::create();
  i=1;
  SetProp(P_INT_SHORT,"Im Wald");
  SetProp(P_INT_LONG,
      "Du stehst am Beginn eines schoenen Waldes. Alles rund um Dich ist gruen. "
      "Die Zweige der Baeume, welche Dich umgeben, sind mit vielen kleinen, "
      "Nadeln gespickt, die intensiv nach Baumharz duften. Im Suedwesten "
      "kannst Du einen Weg erspaehen, weiter im Nordosten wird der Wald noch "
      "etwas dichter." 
      );

  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_FOREST]) );

  AddSmell(DEFAULT_SMELL,
      "Es duftet nach Wald und Baumharz.");
  AddSmell(({"harz","baumharz"}),
      "Das Harz hat einen holzigen Geruch.");
  AddSmell("wald",
      "Der Wald riecht wunderbar nach Baumharz.");
  AddSmell("geruch",
      "Es riecht nach Wald und Harz.");

  AddSound(DEFAULT_SOUND,
      "Es herrscht absolute Stille.");

  AddDetail( ({"ast"}),
      "Welchen Ast meinst Du? Es gibt hier viele Aeste.");

  AddDetail( ({"ast mit baumharz", "baumharzahst"}),
      "Der ist aber schoen, Du koenntest ihn vielleicht noch gebrauchen.");

  AddDetail("beginn",
      "Ja, der Beginn. Schau Dich doch um!");

  AddDetail(({"wald","waldes"}),
      "Der Wald ist voller Baeume, welche herrlich duften. Irgendwie baut es Dich "
      "auf, dass Du in einer solch prachtvollen Umgebung stehst. ");

  AddDetail("umgebung",
      "In Deiner Umgebung siehst Du einen Wald.");

  AddDetail(({"baum","baeume"}),
      "Es sind ausschliesslich Nadelbaeume zu zaehlen. Scheinen eine Monokultur "
      "zu sein.");

  AddDetail("himmel",
      "Du kannst den Himmel vor lauter Zweigen nicht sehen.");

  AddDetail("zweige",
      "Es sind zu viele Zweige um alle auf einmal zu untersuchen, aber "
      "im Gesamten sehen sie toll aus.");

  AddDetail("boden",
      "Ein typischer Boden im Wald.");

  AddDetail(({"kultur","monokultur"}),
      "Tja, Du hast recht, es ist eine Monokultur, nur Nadelbaeume zu sehen.");

  AddDetail(({"nadelbaum","nadelbaeume"}),  
      "Es muessen tausende Nadeln sein. Der Baum ist total mit ihnen bewachsen.");

  AddDetail(({"nadel","nadeln"}),
      "Eins, zwei, drei, vier....siebenhunderteinundsiebzig... Nein es sind zu viele," 
      " es wuerde Jahre dauern um alle zu sehen.");

  AddDetail ("jahre",
      "Geschaetzt fuenfzehneinhalb Jahre wuerdest Du brauchen um alle Nadeln zu "
      "zaehlen."); 

  AddDetail(({"harz","baumharz"}),
      "Du suchst Dir einen Baum und erblickst einen Ast von dem Baumharz "
      "trieft. Es ist Dir aber zu klebrig um es anzufassen. ");

  AddDetail("weg",
      "Der Weg liegt weiter suedwestlich. Von hier aus kann man nichts "
      "genaueres erkennen. Geh doch einfach hin, wenn Du was sehen willst."); 

  AddCmd( ({"brich","breche"}), "bfunc"); 

  AddExit("nordosten",ROOM("umfahrung2.lpc")); 
  AddExit("suedwesten",ROOM("16y_30x.lpc"));
}


int bfunc(string wosn)
{
  string was,womit; 

  if(!wosn)
  {
    write("Was willst Du abbrechen??\n");
    return 1;
  }
  if(wosn=="ast")
  {
    write("Welchen Ast willst Du abbrechen? Den mit den Nadeln?\n");
    return 1;
  }
  if(sscanf(wosn,"%s mit %s ab", was, womit)!=2)
  {
    write("Welchen Ast? Den mit den gruenen Nadeln? Hehe.\n");
    return 1;
  }    
  if( ( was=="ast" && (womit=="harz" || womit=="baumharz") ) && i==1)
  {
    if (deep_present("\naskofski",this_player()!=0)) 
    {
      write("Nein, ein Ast von dieser Sorte genuegt.\n");
      return 1;
    } 
    write("Du brichst den Ast, welcher voller Baumharz ist, ab.\n");
    clone_object(OBJ("astl.lpc"))->move(this_player(),M_NOCHECK); 
    i=0;
    return 1; 
  }
  if (i==0)
  {
    write("Nein, Du bist kein Umweltschaender, und Aeste abbrechen "
        "gehoert sich so und\nanders nicht.\n");
    return 1;
  }
  write ("Brechen, schieben, huepfen, was immer Du willst.\n");
  return 1; 
} 

void reset()
{
  ::reset();
  i=1;
}  
