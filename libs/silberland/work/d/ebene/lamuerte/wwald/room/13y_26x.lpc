inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Hoehlendurchgang");
  SetProp(P_INT_LONG,
      "Du stehst vor einem Hoehlendurchgang, welcher wirklich beeindruckend "
      "aussieht. Ein grosser Stachel liegt vor Deinen Fuessen. Der Eingang "
      "ist ungefaehr vier Meter hoch. Eine weitere kleine Hoehle kannst Du "
      "nach Norden hin betreten.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "moos" }), 
       "Das Moos ist gruen, weich und waechst auf "+
        "Granitgestein.");
  AddDetail( ({ "felsen", "fels" }), 
       "Der Felsen besteht aus Granit, ist glatt und "+
        "teilweise mit Moos bewachsen.");
  AddDetail( ({ "eingang" }), 
       "Der Eingang ist ungefaehr vier Meter hoch, "+
        "aus Granit und sieht sehr robust aus.");
  AddDetail( ({ "granit" }), 
       "Das Granit ist hart und glatt.");
  AddDetail( ({ "decke", "boden", "wand", 
        "waende" }), 
       "Sowohl die Decke, der Boden als auch die "+
        "Waende bestehen aus glattem Felsgestein. Wahrscheinlich "+
        "Granit.");
  AddDetail( ({ "stachel" }), 
       "Der Stachel ist gewaltig gross. Du koenntest "+
        "ihn nicht einmal tragen.");
  AddDetail( "licht", "Ohne Fackel geht es wohl nicht.\n");


  AddDetail( "stachel", "Riesige Stuecke von Stacheln.\n");

  AddDetail( ({"hoehle"}),
      "Eine groessere siehst Du im Osten, eine kleinere im Norden.\n");
  AddDetail( ({"durchgang", "hoehlendurchgang"}),
      "Ein kleiner in den Fels gehauener Durchgang.\n");

  AddDetail ( "weg",
      "Der Weg fuehrt durch einen Durchgang, der in den Fels gehauen ist.\n");

  AddExit( "osten", ROOM("13y_27x") );
  AddExit( "suedwesten", ROOM("12y_25x") );
}
