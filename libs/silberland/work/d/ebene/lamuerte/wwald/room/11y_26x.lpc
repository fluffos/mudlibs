/* Trampelpfad (Lamuerte)
 * ---
 * 23.11.96  Woody  Weg zu den Kobolden mit Warnung versehen
 */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

string *gewarnt=({});
#define WARNED (member(gewarnt, getuid(this_player()))!=-1)

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Trampelpfad" );
  SetProp(P_INT_LONG,
      "Der Pfad wirkt irgendwie einschuechternd. Kleine rote Punkte "
      "sind am Boden zu sehen und ein unheimlicher Geruch liegt in der Luft. "
      "Von hier aus kannst Du die Geraeusche genauer lokalisieren. Sie "
      "scheinen aus dem Nordosten zu kommen und verheissen nichts Gutes...");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "luft" }), 
       "Die Luft ist klar, aber mit einem "+
        "unangenehmen Geruch versehen.");
  AddDetail( ({ "traubensaft", "saft" }), 
       "Es duerfte sich um Kirschensaft handeln.");
  AddDetail( ({ "kirschsaft" }), 
       "Oder doch Traubensaft? Deine Geschmacksnerven sind verwirrt.");

  AddSound(DEFAULT_SOUND,
      "Du hoerst diese komischen Geraeusche von ueberall her.\n");
  AddSound( ({"geraeusch","geraeusche"}),
      "Du kannst die Geraeusche einfach nichts und niemandem zuordnen.\n");
  AddSmell(DEFAULT_SMELL,
      "Es riecht irgendwie komisch im Wald.\n");
  AddSmell(({"geruch","wald", "verwesungsgeruch", "verwesung", "verwestes"}),
      "Du hast den Geruch des Todes in der Nase.\n"); 

  AddItem(NPC("wolf"),REFRESH_DESTRUCT);

  AddDetail( ({ "himmel", "blau" }), 
       "Der Himmel zeigt sich heute in seinem "+
        "schoensten Blau.");
  AddDetail ( ({"punkte", "rot", "boden"}),
      "Es koennte sich um Blut handeln, das hier am Boden verteilt ist.\n");

  AddDetail ( "geruch",
      "Es riecht nach Verwestem.\n");

  AddDetail ( "blut",
      "Du steckst Deinen Finger in die rote Fluessigkeit, schleckst ihn ab\n"
      +"und stellst fest, dass es doch nur Traubensaft ist.\n"); 

  AddDetail( ({"pfad", "trampelpfad"}),
      "Ein ausgetrampelter Pfad fuehrt von Osten nach Westen durch den Wald.\n");

  AddDetail( ({"baum", "baumwerk", "baeume", "wald", "licht", "sonne", "sonnenlicht"}),
      "Dichtes Baumwerk versperrt zum Grossteil das Einfallen des Sonnenlichts.\n");

  AddDetail( ({ "geraeusche", "graeusch"}),
      "Die Geraeusche hoeren sich sehr seltsam an.\n");

  AddExit( "osten", ROOM("11y_27x") );
  AddSpecialExit( "nordosten", "kobolde");
  AddExit( "westen", ROOM("11y_25x") );
}

int kobolde(string str)
{
  if (WARNED)
    return this_player()->move(ROOM("12y_27x"), M_GO,
        "aengstlich nach Nordosten");
  write (
      "Eine innere Stimme scheint Dich eindringlich davor zu warnen,\n"
      "weiter nach Nordosten zu gehen... Du haeltst noch einmal ein.\n");
  say (break_string(
        capitalize(this_player()->name())+" will offenbar nach Nordosten "+
        "gehen, haelt aber jaeh inne...", 78));
  gewarnt += ({getuid(this_player())});
  if (this_player()->QueryProp(P_WIMPY) < 120)
    write (
        "Und vielleicht solltest Du, wenn Du doch weitergehen willst,\n"
        "die ganze Sache doch etwas vorsichtiger angehen...\n");
  return 1;
}

void reset()
{
  ::reset();
  gewarnt=({});
}

