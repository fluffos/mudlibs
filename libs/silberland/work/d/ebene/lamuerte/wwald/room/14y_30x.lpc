inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Norbadenweg" );
  SetProp(P_INT_LONG,
      "Hier zweigt ein duesterer Pfad vom Norbadenweg ab. Im Sueden "
      "kannst Du schon das Ende des gepflasterten Weges erkennen. "
      "Auf einem Baum neben Dir sitzt eine Eule, die ihren Kopf "
      "verdreht als sie Dich entdeckt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({"weg","norbadenweg"}), "Ein gepflasterter Weg durch den Wald.");

  AddDetail( "wald", "Ein ganz gewoehnlicher Wald.");

  AddDetail( ({"baum", "baeume"}), 
      "Viele Baeume stehen hier herum, soweit das Auge reicht.");

  AddDetail( ({"himmel"}),
      "Den Himmel kann man kaum sehen, darum ist es auch so duester hier.");

  AddDetail( ({"pfad", "boden"}),
      "Der Pfad sieht nicht gerade einladend aus.");

  AddDetail( "eule",
      "Einer der vielen Bewohner in diesem Wald. Als Du sie genauer "
      +"untersuchen willst ruft sie: BUUUH BUHUHU, was Dich wirklich "
      +"ziemlich erschreckt. Es ist wohl besser sie in Ruhe zu lassen, "
      +"immerhin stehen die Eulen ja unter Naturschutz.");

  AddDetail( "naturschutz",
      "Also, diese netten Tierchen sollte man nicht toeten.");

  AddDetail("tierchen",
      "Du siehst eine Eule.");

  AddExit( "norden", ROOM("15y_30x") );
  AddExit( "sueden", ROOM("13y_30x") );
  AddExit( "suedwesten", ROOM("13y_29x") );
}


