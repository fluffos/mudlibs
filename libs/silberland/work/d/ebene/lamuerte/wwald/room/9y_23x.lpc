int sfunc()
{
  object ob;
  int alc,max_alc;
  int rnd;
  ob=this_player();
  alc=this_player()->QueryProp(P_ALCOHOL);
  max_alc=this_player()->QueryProp(P_MAX_ALCOHOL);

  if (!member(runterfaller, getuid(this_player())) &&
      (ob->QueryProp(P_GUILD)!="zechpreller" || !random(3) ) &&
      random(alc)>=((max_alc *  80) / 100) && !ob->QueryProp(P_GHOST))
  { 
    write ("Beim Versuch weiter nach Sueden zu gehen, purzelst Du "+
        "ins Wasser.\n\n"); 
    say(this_player()->QueryProp(P_NAME)+" faellt in den Burggraben.\n");
    ob->move(ROOM("wasser"),M_GO+M_SILENT);
    runterfaller+=([getuid(this_player()):1]);
    return 1;
  }
  ob->move(KREUZUNG,M_GO,"nach Sueden");
  return 1;
}



int nfunc()
{
  object ob;
  int alc,max_alc;
  int rnd;
  ob=this_player();
  alc=this_player()->QueryProp(P_ALCOHOL);
  max_alc=this_player()->QueryProp(P_MAX_ALCOHOL);

  if (!member(runterfaller, getuid(this_player())) &&
      (ob->QueryProp(P_GUILD)!="zechpreller" || !random(3) ) &&
      random(alc)>=((max_alc *  80) / 100) && !ob->QueryProp(P_GHOST))
  { 
    write ("Beim Versuch weiter nach Norden zu gehen, purzelst Du "+
        "ins Wasser.\n\n"); 
    say(this_player()->QueryProp(P_NAME)+" faellt von der Bruecke.\n");
    ob->move(ROOM("wasser"),M_GO+M_SILENT);
    runterfaller+=([getuid(this_player()):1]);
    return 1;
  }
  ob->move(ROOM("10y_23x.lpc"),M_GO,"nach Norden");
  return 1;
}

void reset()
{
  ::reset();
  runterfaller=([]);
}

