inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Koboldhoehle");
  SetProp(P_INT_LONG,
      "Du betrittst die Hoehle der Kobolde. Auf einem von der Sonne "
      "erwaermten, flachen Felsbrocken in der Hoehle ist das Heim der "
      "Kobolde. Sei froh wenn sie gerade nicht zu Hause sind, denn diese "
      "Wesen sind klein, gemein und laestig.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_CAVE]) );

  // AddItem(NPC("kobold"),REFRESH_REMOVE);	// 2 reichen...
  AddItem(NPC("kobold"),REFRESH_REMOVE);
  AddItem(NPC("kobold"),REFRESH_REMOVE);
  AddItem(NPC("wolf"),REFRESH_DESTRUCT);

  AddDetail( ({ "wand", "waende", "boden", "granit", "gestein" }), 
       "Granit, Granit, Granit. Hier ist aber auch "+
        "wirklich alles aus dem selben Gestein.");
  AddDetail( ({ "decke", "stein" }), 
       "Die Decke besteht aus Gestein, wobei es sich "+
        "beim Gestein um Granit handelt.");
  AddDetail( ({ "sonne" }), 
       "Die Sonne blendet Dich als Du durch das Loch "+
        "schaust.");
  AddDetail( ({ "loch" }), 
       "Durch das runde Loch dringt die Sonne.");
  AddDetail ( "sonne",
      "Durch ein Loch in der Decke der Hoehle, leuchet Sonnenlicht auf einen Stein.\n");

  AddDetail( ({"kobold","wesen"}),
      "Kleine Wesen, die gerne Unsinn treiben. Irgendwie stellst Du Aehnlichkeit\n"
      +"mit Dir fest.\n"); 

  AddDetail( ({"hoehle", "heim"}),
      "Eine kleine Hoehle, das Heim der Kobolde.\n");

  AddDetail( ({"felsen", "brocken", "felsbrocken"}),
      "Der Felsbrocken weist keine besonderen Merkmale auf.\n");

  AddExit( "suedosten", ROOM("11y_28x") );
  AddExit( "suedwesten", ROOM("11y_26x") );
}

