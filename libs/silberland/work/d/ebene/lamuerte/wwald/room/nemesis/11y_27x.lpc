inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Trampelpfad" );
  SetProp(P_INT_LONG,
      "Der Trampelpfad fuehrt schnurgerade durch den Wald. "
      "Eigentlich ist nichts Auffaelliges zu erkennen, nur die doch "
      "etwas seltsamen Geraeusche kommen Dir nicht ganz geheuer vor. "
      "Sie scheinen aus dem Norden zu kommen, doch in diese Richtung "
      "fuehrt ja gar kein Weg... Du fuehlst Dich etwas unsicher.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );


  AddSound(DEFAULT_SOUND,
      "Du hoerst nichts, oder doch?\n");
  AddSound( ({"geraeusche","geraeusch"}),
      "Leise und unheimlich, ueberall und nirgends kommen sie her.\n");

  AddDetail( ({"pfad", "trampelpfad", "weg"}),
      "Ein ausgetrampelter Pfad.\n");

  AddDetail( "boden", "Du untersuchst den Boden, findest aber nichts besonderes.\n");

  AddDetail( "kuehl", "Brrrr.. langsam wird es kalt.\n");

  AddDetail( ({"baum", "baumwerk", "baeume", "wald", "himmel", "sonne"}),
      "Es ist ziemlich dunkel, da die Baeume die Sonne verdecken.\n");

  AddDetail( ({ "geraeusche", "geaeusch"}),
      "Die Geraeusche hoeren sich sehr seltsam und etwas bedrohlich an.\n");

  AddExit( "osten", ROOM("11y_28x") );
  AddExit( "suedwesten", ROOM("10y_26x") );
  AddExit( "westen", ROOM("11y_26x") );
}

