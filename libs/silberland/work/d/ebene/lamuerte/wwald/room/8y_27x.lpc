inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Felsplateau" );
  SetProp(P_INT_LONG,
      "Die Schlucht muendet hier in einem felsigen Plateau. "
      "Es sieht aus, also ob man inmitten der Tiefe eines Vulkankraters "
      "stehen wuerde. Im Westen und im Osten sind steinerne Eingaenge "
      "in den Fels gehauen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]) );

  AddSound("musik", 
      "Trallllallaaaaa.... Tuerilieeee.... Dam dadadadammm....\n"+
      "Das horcht sich ja grauenhaft an.\n");
  AddDetail( ("weg",
        "Der Weg sieht eigentlich ganz normal aus.\n"
        ));
  AddDetail( ({ "platz","boden"}), 
       "Irgendwie wirkt er beengend." );
  AddDetail( ({ "vulkan","krater","vulkankrater"}), 
       "Natuerlich ist es kein Vulkankrater, "
        "aber es sieht doch irgendwie so aehnlich aus." );

  AddDetail( ({ "stein", "steine","brocken","felsbrocken" }), 
       "Es liegen einige Steinbrocken herum, die "
        "sehr normal aussehen.");
  AddDetail( ({ "eingaenge", "eingang" }), 
      "Die Eingaenge fuehren in den Fels.\n");
  AddDetail( ({ "fels" }), 
      "Der Fels besteht aus Granit.\n");
  AddDetail( ({ "granit" }), 
       "Der Granit sieht aus wie Granit. Vielleicht "
        "ist es ja Granit?!");
  AddDetail( ({ "berg", "berges" }), 
      "Der Berg sieht tatsaechlich aus wie ein Berg.\n");
  AddDetail( ({ "plateau" }), 
      "Ein runder Platz inmitten eines Berges. Es "+
      "weist keine Besonderheiten auf.");
  AddDetail( ({ "gestein","wand","waende","decke"}), 
      "Es handelt sich um Granit.\n");
  AddDetail( ({ "schlucht" }), 
      "Ein Weg durch das Gestein.\n");
  AddDetail( "himmel",
      "Himmelblauer Himmel.");
  AddSound(DEFAULT_SOUND,"Du hoerst Musik aus den Eingaengen.");

  AddDetail( ({"tief","tiefe"}),
      "Du stehst inmitten der Tiefe. Du bekommst ein mulmiges Gefuehl "
      +"im Bauch als Du nach oben siehst."); 

  AddExit( "nordwesten", ROOM("9y_26x"));
  AddExit( "westen", GAMBLE("room/bj.lpc"));
  AddExit( "osten", GAMBLE("room/einraum.lpc"));
}

