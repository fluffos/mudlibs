inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Trampelpfad" );
  SetProp(P_INT_LONG,
      "Der Pfad fuehrt immer weiter in die Schlucht. Die Waende links und rechts "
      "von Dir ragen hoch hinauf. Nach Suedosten kommst Du immer tiefer in die "
      "Schlucht, nach Norden gehts Richtung Wald.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail( ({ "granit" }), 
       "Der Granit sieht aus wie Granit. Vielleicht "
        "ist es ja Granit?!");
  AddDetail( ({ "wand", "waende", "felswand", "felswaende" }), 
       "Hohe Felswaende aus Granit.");
  AddDetail( ({"pfad", "trampelpfad", "boden"}),
      "Der Pfad fuehrt einerseits in die Tiefe, andererseits zurueck in den Wald.\n");

  AddDetail( ({"felsritzer","schlucht", "felsritzerschlucht"}), 
      "Tief unten in der Schlucht sind die Felsritzer beheimatet.\n");

  AddDetail( "wald",
      "Der Wald ist irgendwo im Norden.\n");
  AddDetail( "himmel",
      "Himmelblauer Himmel.");

  AddExit( "norden", ROOM("10y_26x") );
  AddExit( "suedosten", ROOM("8y_27x") );
}

