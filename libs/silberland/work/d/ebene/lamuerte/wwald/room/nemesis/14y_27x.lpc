inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Hoehlendurchgang");
  SetProp(P_INT_LONG,
    "Du stehst in einem kleinen Raum. Ein Strohhaufen bildet "
    "eine Art von Bett. Die Dimensionen des Tieres, das hier haust, "
    "kannst Du Dir ungefaehr durch den ueberdimensionalen Haufen "
    "vorstellen. Es koennten wohl mindestens fuenf Menschen darin schlafen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_CAVE]) );

  AddItem(NPC("wolf.lpc"),REFRESH_DESTRUCT);

  AddDetail( ({ "boden", "decke", "wand", "waende", "granit" }), 
                 "Boden, Decke und Waende bestehen aus kaltem, "+
                "glatten Granit.");
  AddDetail( "licht", "Ohne Fackel geht es wohl nicht.\n");

  AddDetail( ({"haufen","strohhaufen"}), "Diesen haufen hat Ghorwin gemacht!.\n");

  AddDetail( "raum", "Ein kleiner Raum in einer Felsenhoehle.\n");

  AddDetail( "tier",
    "Sei froh, wenn es nicht da ist.\n");

  AddDetail ( ({"stroh","haufen","bett"}),
    "Der Haufen ist rund und hat einen Durchmesser von ca. 4 Metern.\n");

  AddExit( "sueden", ROOM("13y_27x") );
}

