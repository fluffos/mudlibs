inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein duesterer Pfad" );
  SetProp(P_INT_LONG,
      "Du stehst auf einem dunklen Pfad. "
      "Diese duestere Umgebung vermittelt ein Gefuehl von Angst. Von aussen "
      "kann kaum noch Licht eindringen. Vielleicht ist jetzt der richtige "
      "Moment, um umzukehren. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail("umgebung",
      "Die Umgebung sieht nicht gerade gemuetlich aus.");

  AddDetail( ({"baum", "baumkronen", "himmel"}),
      "Du kannnst kaum den Himmel durch die Baumkronen sehen.\n");

  AddDetail( ({"pfad", "boden"}),
      "Der Pfad wirkt unheimlich auf Dich.\n");

  AddDetail( "licht",
      "Es wird immer dunkler, Angst steigt in Dir auf.\n");
  AddDetail( ({"moment"}),
      "Im naechsten Moment kann es zu spaet sein.");
  AddDetail( ({"angst", "gefuehl"}),
      "Diese duestere Umgebung vermittelt ein Gefuehl von Angst.");

  AddExit( "westen", ROOM("13y_28x") );
  AddExit( "nordosten", ROOM("14y_30x") );
}

