inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>

create()
{
 ::create();
  SetProp(P_INT_SHORT,"In einer alten Muehle");
  SetProp(P_INT_LONG,break_string(
    "Du stehst in einer alten, verfallenen Holzmuehle. Inmitten des Raumes " +
    "steht das Saegewerk, welches sich in keinem guten Zustand mehr befindet. "+
    "Boden und Waende sind mit einer dicken Staubschicht bedeckt, und auch "+
    "die Fenster sind so stark verschmutzt, dasz kaum noch Licht von aussen "+
    "eindringen kann."));

AddSound(DEFAULT_SOUND,break_string("Du hoerst ein leises scharren.",78));
AddSound("scharren",break_string("Auf den ersten Blick ist nicht zu sehen "+
         "was hier scharrt, es kommt wohl vom Ungeziefer, das sich hier "+
         "eingenistet hat.",78));

  AddDetail ( ({"holzmuehle", "muehle"}),
    "Du stehst inmitten der verlassenen Muehle. Nur noch wenige "+
    "Gegenstaende erinnern daran, dasz hier vor langer Zeit Holz verarbeitet "+
    "wurde.");
  AddDetail ( ({"gegenstaende", "gegenstand"}),
    "Eigentlich erinnert nur noch das Saegewerk daran, was hier einst "+
    "erzeugt wurde.");
  AddDetail ( ({"saegewerk", "werk"}),
    "Ein langer Holzbalken fuehrt vom Saegewerk durch die Wand nach aussen "+
    "zu einem Wasserrad, so wurde das Saegeblatt des Saegewerks "+
    "angetrieben. Hiermit wurden Holzbretter erzeugt.");
  // DETAILS END

SetProp(P_LIGHT,1);
SetProp(P_INDOORS,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
//AddItem(NPC("2),REFRESH_DESTRUCT);


}
