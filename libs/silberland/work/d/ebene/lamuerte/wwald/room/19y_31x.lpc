inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Wald entlang" );
  SetProp(P_INT_LONG,
      "Ein kleiner Trampelpfad, links und rechts von Baeumen gesaeumt, "
      "fuehrt in Richtung eines hellen Lichtes, welches die Baumspitzen "
      "durchdringt. Leises Vogelgezwitscher ist von weit oben aus einer "
      "Baumkrone zu hoeren.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );


  AddSound(DEFAULT_SOUND,"Du hoerst die Voegel zwitschern.\n");
  AddSound(({"vogel","gezwitscher","vogelgezwitscher"}),
      "Triller... Triller... Fiep.... Quietsch...\n"+
      "Auf Dauer koennte das nervend sein.\n"); 
  AddDetail( ({ "wolken" }), 
       "Die Wolken sind nur vereinzelt am Himmel zu "+
        "sehen.");
  AddDetail( ({ "himmel" }), 
       "Der Himmel ist wunderbar blau. Es sind nur "+
        "vereinzelt Wolken zu sehen.");

  AddDetail( ({ "pfad", "trampelpfad", "boden" }), 
       "Ein kleiner ausgetrampelter Pfad.");
  AddDetail( ({ "vogel" }), 
       "Froehlich fliegen die Voegel um ihr Nest "+
        "herum, sicher vor allen Gefahren dieser Welt.");
  AddDetail( ({ "nest", "vogelnest" }), 
       "In schwindeleregender Hoehe erspaehst Du ein "+
        "kleines Nest, welches Du nie erreichen wirst.");
  AddDetail( ({ "wald", "gebiet", "waldgebiet" }),
      "Der Wald sieht eigentlich ganz normal aus.\n");

  AddDetail( ({ "baumkronen", "baumspitze", "baum", "baeume", "krone", "baumkrone" }),
      "Oben, in der Baumkrone des hoechsten Baumes, siehst Du ein Vogelnest.\n");

  AddDetail( ({ "duft", "duften"}),
      "Es duftet nach Nadelbaeumen.");
  AddSmell( ({DEFAULT_SMELL, "duft", "nadelbaeume", "baeume", "nadelbaum"}),
      "Die Nadelbaeume verbreiten einen guten Duft.");

  AddDetail( ({ "licht", "lichtung"}),
      "Es scheint als waere weiter im Suedwesten die Lichtung.\n");

  AddExit( "osten", ROOM("19y_32x") );
  AddExit( "suedwesten", ROOM("18y_30x") );
}


