inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Norbadenweg" );
  SetProp(P_INT_LONG,
      "Der gepflasterte Weg fuehrt nach Sueden zu einem verfallenen "
      "Gebaeude. Am Wegesrand hat eine Ameisenkolonie ihre Zelte "
      "rund um einen Pflasterstein aufgeschlagen. Die hohen Baeume "
      "sehen hier auch nicht anders aus als im restlichen Wald. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "wegesrand" }), 
      "Pflastersteine und Ameisen. Eigentlich nichts "+
      "besonderes." );
  AddDetail( ({ "zelt", "zelte" }), 
      "Das Feldlager der Ameisen sieht aus wie "+
      "eine Miniaturnachbildung von Creas Feldlager." );
  AddDetail( ({"feldlager", "miniaturnachbildung", "nachbildung"}),
      "Das hier ist nur eine Nachbildung, das wirkliche Feldlager "
      "liegt weiter in Sueden.");
  AddDetail( ({"crea", "creative"}),
      "Creative, der Schoepfer des Feldlagers.");
  AddDetail( ({ "haus" }), 
      "Du kannst das Gebaeude von hier aus noch "+
      "nicht erkennen." );
  AddDetail ("gebaeude",
      "Ein altes, halb verfallenes Haus, welches kaum noch bewohnt sein wird.\n");
  AddDetail( ({ "himmel", "blau" }), 
      "Der Himmel zeigt sich heute in seinem schoensten Blau.");
  AddDetail( ({"stein", "pflasterstein", "steine", "pflastersteine"}),
      "Ein Granitstein neben dem Anderen.\n");
  AddDetail( ({"weg","norbadenweg", "boden"}), 
      "Ein gepflasterter Weg durch den Wald.\n");
  AddDetail( "wald", "Ein ganz schoen grosser Wald.\n");
  AddDetail( ({"baum","baeume"}), 
      "Baeume stehen herum, soweit das Auge reicht.\n");
  AddDetail( ({"ameisen", "kolonie", "ameisenkolonie", "tierchen"}),
      "Eine niedliche kleine Ameisenkolonie. Du bist begeistert vom\n"
      "Fleiss dieser kleinen Tierchen.\n");
  AddDetail( ({"fleiss"}),
      "Die Ameisen sind wirklich fleissig, genauso wie ich hier beim Details "
      "schreiben.");
  AddDetail( ({"detail", "details"}),
      "Und noch ein Detail mehr.....");

  AddExit( "norden", ROOM("14y_30x") );
  AddExit( "sueden", ROOM("12y_30x") );
}

