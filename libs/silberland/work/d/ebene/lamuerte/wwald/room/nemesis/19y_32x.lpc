inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Wald entlang" );
  SetProp(P_INT_LONG,
      "Der Waldweg fuehrt geradeaus von Osten nach Westen auf eine Lichtung zu. "
      "Das dichtverwachsene Gebiet lockert sich hier einwenig, doch "
      "Baeume stehen noch immer herum, soweit das Auge reicht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "wolken" }), 
       "Die Wolken sind nur vereinzelt am Himmel zu "+
        "sehen.");
  AddDetail( ({ "himmel" }), 
       "Der Himmel ist wunderbar blau. Es sind nur "+
        "vereinzelt Wolken zu sehen.");
  AddDetail( ({ "nadelbaum", "nadelbaeume" }), 
       "Die Nadelbaeume sehen hier sehr lustig aus.");
  AddDetail( ({ "beeren", "schlingpflanzen", "gras", 
        "moos", "waldgras" }), 
       "Sieht alles ganz normal aus.");
  AddDetail( ({ "pflanze", "pflanzen" }), 
       "Beeren, Schlingpflanzen, Waldgras und Moos, "+
        "alles was im Wald so waechst.");
  AddDetail( ({ "waldweg", "weg", "boden" }), 
       "Ein kleiner, mit Pflanzen ueberwucherter "+
        "Waldweg.");
  AddDetail( ({ "wald", "gebiet", "waldgebiet" }),
      "Der Wald sieht eigentlich ganz normal aus.\n");

  AddDetail( ({ "baum", "baeume" }),
      "Es handelt sich um Nadelbaeume.\n");

  AddDetail( ({ "duft", "duften"}),
      "Es duftet nach Nadelbaeumen.\n");

  AddDetail( "auge",
      "Du steckst Dir Deinen Finger ins Auge, autsch!\n");

  AddDetail( ({ "licht", "lichtung"}),
      "Es scheint als waere im Westen wirklich eine Lichtung.\n");

  AddItem(NPC("grizzly"),REFRESH_REMOVE);

  AddExit( "osten", ROOM("19y_33x") );
  AddExit( "westen", ROOM("19y_31x") );
}

