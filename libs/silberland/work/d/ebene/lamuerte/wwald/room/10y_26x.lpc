inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Trampelpfad" );
  SetProp(P_INT_LONG,
      "Du stehst am nordoestlichen Eingang der Felsritzerschlucht. "
      "Ein kleiner Pfad fuehrt hinunter in die Tiefe. Im Nordosten "
      "gelangst Du zurueck in den Wald. ");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail( ({ "weg", "boden" }), 
      "Der Weg ist steinig und ziemlich steil.");
  AddDetail( ({"pfad", "trampelpfad"}),
      "Der Trampelpfad fuehrt einerseits in die Tiefe, andererseits zurueck in den Wald.");
  AddDetail( ({"felsritzer","schlucht", "felsritzerschlucht"}), 
      "Tief unten in der Schlucht sind die Felsritzer beheimatet.");
  AddDetail( ({"eingang"}),
      "Hier ist der Eingang zur Felsritzerschlucht.");
  AddDetail( "wald",
      "Der Wald liegt im Nordosten.");
  AddDetail( "tiefe",
      "Die Schlucht ist wirklich sehr tief.");
  AddDetail( ({ "himmel", "blau" }),
      "Der Himmel zeigt sich heute in seinem schoensten Blau.");

  AddExit( "nordosten", ROOM("11y_27x") );
  AddExit( "sueden", ROOM("9y_26x") );
}

