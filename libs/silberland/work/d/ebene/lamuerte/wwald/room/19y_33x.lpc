inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Wald entlang" );
  SetProp(P_INT_LONG,
      "Du befindest Dich mitten im Wald. "
      "Rings um Dich stehen Nadelbaeume, die wunderbar duften. "
      "Ein weiteres Eindringen ist von hier aus undenkbar, da "
      "der dichte Bewuchs ein Vorwaertskommen beinahe unmoeglich macht. "
      "Weiter im Westen lichtet sich der Wald etwas.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "wolken" }), 
       "Die Wolken sind nur vereinzelt am Himmel zu "+
        "sehen.");
  AddDetail( ({ "himmel" }), 
       "Der Himmel ist wunderbar blau. Es sind nur "+
        "vereinzelt Wolken zu sehen.");
  AddDetail(({"bewuchs", "pflanzen"}),
      "Du untersuchst alle Pflanzen, die Du siehst. Es ist hier wirklich\n"+
      "alles sehr dicht bewachsen. Ob man wohl durchklettern kann?\n");

  AddDetail(({"weg", "boden"}),
      "Es gibt zwei Wege. Einer fuehrt in Richtung Norden aus dem Wald, "+
      "der andere fuehrt in westliche Richtung zu einer Lichtung.");

  AddDetail( ({ "nadelbaeume" }), 
       "Du untersuchst alle Nadelbaeume, findest "+
        "jedoch nichts besonderes.");
  AddSmell(DEFAULT_SMELL,"Die Baeume duften erfrischend.\n"); 

  AddDetail( ({ "wald", "gebiet", "waldgebiet" }),
      "Der Wald sieht eigentlich ganz normal aus.\n");

  AddDetail( ({ "baum", "baeume" }),
      "Es handelt sich um Nadelbaeume.\n");

  AddDetail( ({ "duft", "duften"}),
      "Es duftet nach Nadelbaeumen.\n");

  AddDetail( ({ "licht", "lichtung"}),
      "Es scheint als sei weiter im Westen eine Lichtung.\n");

  AddExit( "westen", ROOM("19y_32x") );
  AddExit("suedwesten",ROOM("umfahrung2.lpc"));
  AddCmd ( ({"kletter","klettere"}), "kfunc" );
  AddExit( "osten", ROOM("buschweg1"));
}


int kfunc (string str)
{
  object me; 
  notify_fail("Was? Wo? Wie? Wann?\n");

  if (str=="durch bewuchs" || str=="durch pflanzen" || str=="durch" ||
      str=="pflanzen" || str=="durch gebuesch" || str == "durch busch" || str == "durch gestruepp")
  {
    write("Die Pflanzen sind wirklich undurchdringlich!\n");
/*    
    write("Du schiebst einige der Pflanzen beiseite und kletterst nach Osten hinduch.\n");
    this_player()->move("/d/ebene/lamuerte/wwald/room/buschweg1.lpc",M_GO,
        "im Dickicht","verschwindet","kommt an");
    if (me=find_player("lamuerte"))
      tell_object(me,"[KYRANDA] "+this_player()->QueryProp(P_NAME)+
        " betritt gerade Kyranda.\n");
*/
    return 1;
  }

  return 0;
}
