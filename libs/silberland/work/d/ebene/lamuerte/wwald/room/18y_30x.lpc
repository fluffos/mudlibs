inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung" );
  SetProp(P_INT_LONG,
      "Du stehst in einer grossen Lichtung, die Sonnenstrahlen erwecken "
      "hier so manches Leben. Doch etwas passt hier ganz und gar nicht. "
      "Ein intensiver, ranziger, einfach grauenvoller Geruch haengt "
      "in der Luft. Es scheint als ob hier Oger hausen, welche keinerlei "
      "Wert auf Reinheit legen. Im Sueden und Westen erstreckt sich die "
      "dicht von Baeumen umwachsene Lichtung weiter. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddSmell (DEFAULT_SMELL,"Es riecht echt grauenhaft.\n");


  AddDetail( ({ "geruch", "intensiv", "luft" }),
      "Ein wirklich nicht auszuhaltender Gestank erfuellt die Luft.\n");

  AddDetail( "oger",
      "Zum Glueck ist im Moment keines von diesen Untieren hier.\n");

  AddDetail( ({"wald", "baum", "baeume", "nadelbaeume"}),
      "Es duftet nach Nadelbaeumen, Du stehst ja auch in einem Wald.\n");

  AddDetail( ({ "licht", "lichtung"}),
      "Es scheint als waere weiter im Westen eine Lichtung.\n");

  AddDetail ( ({"sonne", "sonnenstrahlen", "strahlen"}),
      "Es tut gut wieder einige Sonnenstrahlen zu erhaschen.\n");
  AddDetail( ({"boden"}),
      "Der Boden ist von riesigen Fuessen zerstampft.");
  AddDetail( ({"fuesse", "ogerfuesse"}),
      "Das waren sicher Ogerfuesse.");
  AddDetail( ({ "himmel", "blau" }), 
    "Der Himmel zeigt sich heute in seinem schoensten Blau.");

  AddItem(NPC("attackoger.lpc"),REFRESH_DESTRUCT);

  AddExit( "nordosten", ROOM("19y_31x") );
  AddExit( "westen", ROOM("18y_29x") );
  AddExit( "sueden", ROOM("17y_30x") );
}

