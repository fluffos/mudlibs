inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();

 SetProp(P_INT_SHORT, "Eine Lichtung" );
 SetProp(P_INT_LONG,
   "Ein intensiver, ranziger Geruch haengt, zum Schneiden dick, \n"
 + "in der Luft. Es scheint als ob hier die Oger hausen.\n"
 + "Die Lichtung ist von dichtem Wald umschlossen. Im\n"
 + "Westen und Sueden geht die Lichtung weiter.\n"
 );
SetProp( P_LIGHT, 1 );
SetProp( P_INDOORS, 1 );

 AddDetail( ({ "geruch", "intensiv", "luft" }),
   "Ein wirklich nicht auszuhaltender Gestank erfuellt die Luft.\n");

 AddDetail( "oger",
   "Zum Glueck ist im Moment keines von diesen Untieren hier.\n");

 AddDetail( "wald",
   "Es duftet nach Nadelbaeumen, Du stehst ja auch in einem Wald.\n");

 AddDetail( ({ "licht", "lichtung"}),
   "Es scheint als waere weiter im Westen eine Lichtung.\n");

 AddExit( "nordosten", "/players/lamuerte/home/rooms/19y_31x" );
 AddExit( "westen", ROOM("18y_29x") );
 AddExit( "sueden", ROOM("17y_30x") );
}



