inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Trampelpfad" );
  SetProp(P_INT_LONG,
      "Das Sonnenlicht kann langsam wieder einigermassen durch "
      "die Baumkronen dringen. Die Baeume sind nicht mehr ganz so "
      "dicht aneinandergereiht. Im Westen ist eine kleine Lichtung "
      "zu sehen. Oestlich ist der Wald bedeutend unheimlicher.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "himmel", "blau" }), 
       "Der Himmel zeigt sich heute in seinem "+
        "schoensten Blau.");
  AddDetail( ({ "wolken", "woelkchen" }), 
       "Einige weisse Woelkchen sind am Himmel zu "+
        "sehen.");
  AddDetail( ({ "baumkrone", "krone", "baumkronen", 
        "kronen" }), 
       "Die Spitzen der Baeume sehen von hier unten "+
        "aus als ob sie bis in die Wolken reichen wuerden.");
  AddDetail( ({"boden", "pfad", "trampelpfad"}),
      "Ein ausgetrampelter Pfad fuehrt von Osten nach Westen durch den Wald.\n");

  AddDetail( ({"baum", "baumwerk", "baeume", "wald"}),
      "Die Baeume lichten sich ein wenig.\n");

  AddDetail( "lichtung",
      "Die Lichtung erstreckt sich im Westen. Das Sonnenlicht ist\n"
      +"dort um einiges heller und wirkt richtig angenehm.\n");
  AddDetail( ({"sonnenlicht", "licht", "sonne"}),
      "Das Licht der Sonne ist hier angenehm hell.");


  AddExit( "osten", ROOM("11y_26x") );
  AddExit( "westen", ROOM("11y_24x") );
}


