inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INT_SHORT, "Der Blackjack Raum" );
  SetProp(P_INT_LONG,
    "Ein kleiner duesterer Raum. In der Mitte steht ein Holztisch, der mit \n"
    "einem gruenen Filztuch ueberzogen ist. Du kannst hier BlackJack spielen.\n"
    "Mit 'spiel' kann es losgehen.\n");
  AddSound(DEFAULT_SOUND,"Du hoerst Musik. Ja! Es ist Elvis!\n");
  AddSound("musik","Die Musik laesst Dich Deine Sorgen vergessen.\n");
  AddDetail( ({ "spiel" }), 
                 "Sowas siehst Du hier nicht, doch Du kannst "
                "es tun!" );
  AddDetail( ({ "holz" }), 
                 "Es duerfte sich um Buchenholz handeln." );
  AddDetail( ({ "black", "jack", "blakjack" }), 
                 "Sowas sieht man nich, man spielt es, "
                "dummerchen!" );
  AddDetail( ({ "filz", "tuch", "filztuch" }), 
                 "Ein gruener Stoff mit dem der Tisch "
                "ueberzogen ist." );
  AddDetail( ({ "mitte","tisch","holztisch" }), 
                 "Du willst Dich in die Mitte des Raumes "
                "stellen, doch der Tisch hindert Dich an Deinem Vorhaben. Als "
                "Du dann versuchst auch unter den Tisch zu kriechen, eilen "
                "zwei Waechter herein und zerren Dich wieder heraus. Sie "
                "belehren Dich, dass Du hier Spielen kannst, aber auf dem "
                "Tisch, nicht darunter und verschwinden wieder." );
  AddDetail("raum",
    "Du siehst Dich im Raum um, kannst aber nichts Auffaelliges entdecken.\n"
    "Solltest Du ein Spielchen wagen?\n");

 AddSound(DEFAULT_SOUND,"Du hoerst Musik.\n");
 
  AddSpecialExit("osten","kacke");
  AddCmd( "spiel", "spiel" ); 
}



kacke()
{  
   object *inv;
   int i;
   inv=all_inventory(this_player());
   for(i=0;i<sizeof(inv);i++) {
     if (inv[i]->id("bjt")) { inv[i]->remove(); }
   }
   this_player()->move(WWALD("room/8y_27x"),M_GO);
   return 1;
}



spiel()
{ clone_object(OBJ("karten.lpc"))->move(this_player(), M_NOCHECK);
  return 1;
}

