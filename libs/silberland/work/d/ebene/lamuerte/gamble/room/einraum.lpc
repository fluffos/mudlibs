
inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INT_SHORT, "Der Raum der einarmigen Banditen" );
  SetProp(P_INT_LONG,
    "Du stehst in einer riesigen Halle. Ueberall stehen hier 'Einarmige Banditen' \n"
   "herum, die nur darauf warten, dass Du mit ihnen spielst.\n"
   "Mit 'spiel' kann es losgehen.\n");
  AddDetail( ({ "banditen", "einarmig", "einarm", 
                "einarmige", "bandit", "automat" }), 
                 "Es handelt sich um eine Art von "
                "Spielautomat." );
  AddDetail( ({ "granit" }), 
                 "Du untersuchst den Stein und stellst fest "
                "dass es Granit ist." );
  AddDetail( ({ "fels" }), 
                 "Duerfte Granit sein." );
  AddDetail( ({ "stein" }), 
                 "Normaler Fels." );
  AddDetail( ({ "halle" }), 
                 "Die Halle ist in den Stein gemeisselt, weist "
                "aber keine Besonderheiten auf." );
  AddDetail( ({ "spiel" }), 
                 "Sowas siehst Du hier nicht, doch Du kannst "
                "es tun!" );

  AddSpecialExit("westen","kacke");
  AddCmd( "spiel", "spiel" ); 
  AddSound(DEFAULT_SOUND,"Du hoerst Musik.\n");
}

kacke()
{  
   object *inv;
   int i;
   inv=all_inventory(this_player());
   for(i=0;i<sizeof(inv);i++) {
     if (inv[i]->id("einarm")) { inv[i]->remove(); }
   }
   this_player()->move(WWALD("room/8y_27x"),M_GO);
   return 1;
}

spiel()
{ clone_object(OBJ("einarm.lpc"))->move(this_player(), M_NOCHECK);
  return 1;
}

