inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

int a,b,c,d;
int anzahl=0;
int maxmuenz=50;


//*******CREATE******
create()
{if (!is_clone(this_object())) return;
	::create();
	SetProp(P_SHORT, 0);
        SetProp(P_LONG, 0);
        SetProp(P_WEIGHT, 0);
        SetProp(P_NODROP, 1);
	AddId("einarm");
        beginn();
	SetProp(P_GENDER, MALE);
}



// ******INIT******
init()
{
  ::init();
  add_action("ehilfe","ehilfe");
  add_action("ziehe_hebel","ziehe");
  add_action("ziehe_hebel","zieh");
  add_action("setze_geld","einsatz");
}
 
//******BEGINN*****
beginn()
{
 tell_object(this_player(),
   "Moege das Spiel beginnen. Eine Uebersicht der Gewinne bekommst Du\n"
 + "mit dem Befehl 'ehilfe'. Mit 'einsatz <geld>' kannst Du festlegen,\n"
 + "um wieviel Muenzen Du pro Runde spielen willst. Starten kannst Du\n"
 + "den Automaten mit 'ziehe hebel'.\n");
   
return 1;
}  


//******HILFE****
ehilfe()
{int z,zz,zzz;
 tell_object(this_player(),
  "Uebersichtsseite der Gewinne.\n"
 +"-----------------------------\n\n");
 
  for(z=2;z<=9;z++)
   {zz=(z+z);
    zzz=(z+z+z);
    tell_object(this_player(),
      "2x"+z+" "+z+" facher Gewinn.      "
    + "3x"+z+" "+zz+" facher Gewinn.      "
    + "4x"+z+" "+zzz+" facher Gewinn.\n");
   }
   
  tell_object(this_player(),
  "\nBEFEHLE: 'einsatz <geld>'  -  'ehilfe'   -  'ziehe hebel'\n"); 
return 1; 
}  
    

//******SETZEN******
setze_geld(str)
{
  string dummy;
  int anz;
 
  if (!str) 
  {
   tell_object(this_player(),"Setze wieviele Muenzen?\n");
   return 1;
  }
  if ( (sscanf(str,"%d muenze%s", anz, dummy) != 2) ||
       (dummy != "" && dummy != "n") )
  {
    write ("Syntax: einsatz <anzahl> muenze(n)\n");
    return 1;
  }
  if (anz < 5)
  {
    tell_object(this_player(),"Mindesteinsatz 5 Muenzen!\n");
    return 1;
  }
  if (this_player()->QueryMoney() < anz)
  {
    tell_object(this_player(), "Soviel Geld hast Du nicht!\n");
    return 1;
  }
  if (anz > maxmuenz)
  {
    write("Das Hauslimit liegt zur Zeit bei "+maxmuenz+" Muenzen.\n");
    anz=maxmuenz;
  }
  anzahl=anz;
 
  tell_object(this_player(),"Gesetzt: "+anzahl+" Muenzen.\n");
  // Wird sowieso spaeter beim Hebelziehen gemacht
  // this_player()->AddMoney(-anzahl);
  return 1; 
}


//***REROLL****
reroll()
{
  a=random(7)+2;
  b=random(7)+2;
  c=random(7)+2;  
  d=random(7)+2;
}


//****** AUSGABE******
ausgabe()
{
 tell_object(this_player(),"\n"
  + "   ---------     ---------     ----------     --------- \n"
  + "  |    "+a+"    |   |    "+b+"    |   |    "+c+"     |   |    "+d+"    |\n"
  + "  |   "+a+a+a+"   |   |   "+b+b+b+"   |   |   "+c+c+c+"    |   |   "+d+d+d+"   |\n"
  + "  | "+a+a+a+a+a+a+a+" |   | "+b+b+b+b+b+b+b+" |   | "+c+c+c+c+c+c+c+"  |   | "+d+d+d+d+d+d+d+" |\n"
  + "  |   "+a+a+a+"   |   |   "+b+b+b+"   |   |   "+c+c+c+"    |   |   "+d+d+d+"   |\n"
  + "  |    "+a+"    |   |    "+b+"    |   |    "+c+"     |   |    "+d+"    |\n"
  + "   ---------     ---------     ----------     --------- \n\n");
} 

//******SPIELEN******
ziehe_hebel(str)
{
  if (str && (str=="hebel" || str=="an hebel"))
  {
    if (anzahl < 5)
    {
      if (anzahl)
        tell_object (this_player(), "Mindesteinsatz 5 Muenzen!\n");
      else
        write ("Gib doch erst mal Deinen Einsatz an!\n");
      return 1;
    }
    if (this_player()->QueryMoney() < anzahl)
    {
      write ("Wo hast Du denn Deinen Einsatz ("+anzahl+
        " Muenzen) gelassen???\n");
      return 1;
    }
    reroll();
    ausgabe();
    auswert();
    return 1;
  }
  else
  {
    tell_object(this_player(),"An was willst Du denn ziehen?\n"); 
    return 1;
  }
   
 return 0;
}  
   

//******AUSWERTUNG******
auswert()
{
  int gewinn;
 
  this_player()->AddMoney(-anzahl);   // ZUALLERERST den Einsatz abziehen
  if (a==b)
  {
    gewinn=((a)*anzahl);
    tell_object(this_player(),
     "GEWONNEN!\n"
     "Du hast soeben "+gewinn+" Muenzen gewonnen.\n\n");
    this_player()->AddMoney(gewinn);
    return 1;
  }
  if ((a==b) && (b==c))
  {
    gewinn=((a+b)*anzahl);
    tell_object(this_player(),
     "GEWONNEN!\n"
     "Du hast soeben "+gewinn+" Muenzen gewonnen.\n\n");
    this_player()->AddMoney(gewinn);
    return 1;
  }
  if ((a==b) && (b==c) && (c==d))
  {
    gewinn=((a+b+c)*anzahl);
    tell_object(this_player(),
     "GEWONNEN!\n"
     "Du hast soeben "+gewinn+" Muenzen gewonnen.\n\n");
    this_player()->AddMoney(gewinn);
    return 1;
  }
  tell_object(this_player(),
    "VERLOREN!\n"
    "Du hast soeben "+anzahl+" Muenzen verloren.\n\n");
  if (!random(10))
    tell_object(this_player(), "Jemand troestet Dich.\n");
  return 1;
}
