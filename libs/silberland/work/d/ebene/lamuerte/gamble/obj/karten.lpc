inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

int spieler_karten;
int comp_karten;
int seti=0;
int anzahl;
int maxmuenz=500;
int geb=0;


//*******CREATE******
create()
{if (!is_clone(this_object())) return;
	::create();
	SetProp(P_SHORT, 0);
	SetProp(P_LONG, 0);
	SetProp(P_WEIGHT, 0);
        SetProp(P_NODROP, 1);
	AddId("bjt");
	bjhilfe();
	SetProp(P_GENDER, MALE);
}



// ******INIT******
init()
{::init();
    
   add_action("karten_geben","geben");
   add_action("setze_geld","einsatz");
   add_action("karten_zeigen","zeigen");
   add_action("bjhilfe","bjhilfe");
}
 
//******BJHILFE****
bjhilfe()
{tell_object(this_player(),
  "\nBLACK-JACK Hilfsseite\n\n"
+ "Blackjack  ist ein einfaches Spiel, durch welches Du Deinen Einzatz,\n"
+ "den Du mit dem Befehl 'einsatz <betrag>' festlegst, verdoppeln kannst.\n"
+ "Ziel des Spieles ist es, so nahe als moeglich an die Zahl 21 zu gelangen.\n"
+ "Durch den Befehl 'geben' wird Dir eine Karte gegeben, und die Summe Deiner\n"
+ "Kartenwerte steigt. Du solltest jedoch nicht ueber die 21 kommen, denn sonst\n"
+ "gewinnt die Bank. Glaubst Du nun nahe genug an der 21 zu sein, so kannst Du\n"
+ "mit dem Befehl 'zeigen' Deinen Wert mit dem der Bank vergleichen, wobei der\n"
+ "Hoehere gewinnt.\n\n"
+ "          Viel Spass!\n"
+ "\nPS: Mit 'bjhilfe' kannst Du jederzeit die Hilfsseite aufrufen! ;-)\n");
return 1;
}  
    



//******RESET******
resetk()
 {seti=0;
  geb=0;
  spieler_karten=0;
  comp_karten=0;
 }

//******SETZEN******
setze_geld(str)
{
  string dummy;
  int anz;
 
  if (seti==1)
  {

    tell_object(this_player(),"Du hast schon gesetzt!\n");
    tell_object(this_player(),"Momentan: "+anzahl+" Muenzen.\n");
   return 1;
  }
  
  if (!str) 
  {
   tell_object(this_player(),"Setze wieviele Muenzen?\n");
   return 1;
  }
  if ( (sscanf(str,"%d muenze%s", anz, dummy) != 2) ||
       (dummy != "" && dummy != "n") )
  {
    write ("Syntax: einsatz <anzahl> muenze(n)\n");
    return 1;
  }
  if (anz < 10)
  {
    tell_object(this_player(), "Mindesteinsatz 10 Muenzen!\n");
    return 1;
  }
  if (this_player()->QueryMoney() < anz)
  {
    tell_object(this_player(),"Soviel Geld hast Du nicht!\n");
    say(capitalize(this_player()->QueryProp(P_NAME))+
      " versucht mal wieder, einen Automaten zu ueberlisten!\n");
    return 1;
  }
  if (anz > maxmuenz)
  {
   write("Das Hauslimit liegt zur Zeit bei "+maxmuenz+" Muenzen.\n");
   anz=maxmuenz;
  }
  anzahl=anz;
  tell_object(this_player(),"Gesetzt: "+anzahl+"\n");
  this_player()->AddMoney(-anzahl);
  seti=1;
  comp_karten=random(11)+15;
 return 1; 
}


//*******KARTEN AUSGEBEN******
karten_geben()
{int i,z;
 if (seti==0) 
 {
  tell_object(this_player(),"Du hast noch keinen Einsatz gemacht!\n");
  return 1;
 }
 
 i=random(10)+1;
 spieler_karten=spieler_karten+i;
 tell_object(this_player(),"Summe Deiner Karten: "+spieler_karten+"\n"); 
   
 if (spieler_karten>21)
  {
   tell_object(this_player(),"Tja, das war zuviel des Guten!\n"+
   "Du hast "+anzahl+" Muenzen verloren.\n");
   resetk(); 
   return 1;
  } 
 geb=1;
 return 1;
}
 
//******KARTEN ZEIGEN******
karten_zeigen()
{
  if (geb==0) 
  {
    tell_object(this_player(),"Du bist doch nicht mal im Spielen!\n");
    return 1;
  }

  write ("Die Bank hat: "+comp_karten+", Du hast: "+spieler_karten+".\n");

  if ((spieler_karten <= comp_karten) && (comp_karten <= 21))
  {
    write ("Die Bank gewinnt.\n"
      "Du hast "+anzahl+" Muenzen verloren.\n");
    resetk();
    return 1; 
  }

  // Ab hier die Moeglichkeiten, dass der Spieler gewinnt:

  if (comp_karten > 21)
    write ("Die Bank verliert.\n");
  else if (spieler_karten > comp_karten)
    write ("Du hast gewonnen!\n");
  else
    write("HUCH ?!?\n");

  write ("Du hast "+anzahl+" Muenzen gewonnen!\n");
  this_player()->AddMoney(anzahl*2);   
  resetk();
  return 1;
}
