inherit "std/thing"; 
#include <language.h>
#include <properties.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Hammer");
  SetProp(P_LONG, 
   "Ein kleiner Hammer. Viel zu klein um ihn zu verwenden. Er koennte "+
   "einem Gnom gehoeren. Auf der Oberseite befindet sich eine Gravur.");

  AddDetail("gravur",
   "Du kannst die Gravur nicht entziffern.\n");
  AddDetail("oberseite",
   "Du untersuchst die Oberseite. Alles was Du findest ist eine Gravur."); 
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Hammer");
  SetProp(P_MATERIAL, MAT_IRON ); 
  SetProp(P_INFO,
   "Die Gravur leuchtet auf.\n");
  
  AddId (({"hammer","qhammer"}));
 
  seteuid(getuid());
  
}

