inherit "std/thing"; 
#include <language.h>
#include <properties.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Seerosenblatt");
  SetProp(P_LONG, 
   "Ein weisz glaenzendes Seerosenblatt. Es duftet noch leicht nach "+
   "der Rose von der es stammt.");

  AddDetail("rose",
   "Nein, es ist wirklich keine Rose an dem Blatt zu finden.\n");
 
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Seerosenblatt");
  SetProp(P_MATERIAL, MAT_MISC_HERBAL ); 
  SetProp(P_INFO,
   "Ihr Blatt, Herr Rosenblatt.\n");
  
  AddId (({"blatt","rosenblatt","seerosenblatt","qblatt"}));
 
  seteuid(getuid());
  
}

