inherit "std/thing"; 
#include <language.h>
#include <properties.h>

void create()
{ 
  if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Fleischklumpen");
  SetProp(P_LONG, 
   "Ein stinkender, modriger Fleischklumpen. Es sieht so aus als ob er "+
   "er sich bald aufloesen wird."); 


  AddDetail("fleischklumpen",
   "Der Fleischklumen loest sich bald auf, so vermodert wie der ist.\n");

 
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,50);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Fleischklumpen");
  SetProp(P_MATERIAL, MAT_FLESH ); 
  
  AddId (({"fleisch","klumpen","fleischbrocken","fleischklumpen","qfutter"}));
 
  seteuid(getuid());
  
}

void reset()
{
  object ob;
  if(!is_clone(this_object())) return;
  ::reset();

  if ((ob = environment()) && (interactive(ob) || 
        ((ob = environment(ob)) && interactive(ob))))
    tell_object(ob, "Der stinkende Fleischklumpen verfault und loest sich auf.\n");
  remove();
}

