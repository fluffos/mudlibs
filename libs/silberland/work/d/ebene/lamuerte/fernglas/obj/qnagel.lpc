inherit "std/thing"; 
#include <language.h>
#include <properties.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Nagel");
  SetProp(P_LONG, 
   "Ein langer Nagel. Er glaenzt silbrig und ist fast so lang wie eine "+
   "grosse Gurke. Rost, welcher sich wohl ueber einige Zeit angesetzt "+
   "hat, ueberzieht die Haelfte des Nagels."); 


  AddDetail("gurke",
   "Gurke? An was Du immer denkst.\n");

  AddDetail("rost",
   "Der Rost ist braeunlich. Sieht nicht besonders schmackhaft aus.\n"); 

  AddDetail("haelfte",
   "Eine mit Rost, eine ohne.\n");

 
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,50);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Nagel");
  SetProp(P_MATERIAL, MAT_IRON ); 
  
  AddId (({"nagel","qnagel"}));
 
  seteuid(getuid());
  
}

