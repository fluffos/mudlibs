inherit "std/thing"; 
#include <language.h>
#include <properties.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Brett");
  SetProp(P_LONG, 
   "Ein langes Brett. Es scheint sehr robust zu sein, es handelt sich "+
   "um feinstes Ulmenholz. Am Anfang und am Ende des Bretts ist ein "+
   "kleines Loch zu sehen. Es musz wohl schon einmal wo angenagelt "+
   "gewesen sein.");

  AddDetail("nagel",
   "Von einem Nagel ist nichts mehr zu sehen auf dem Brett.\n");

  AddDetail(({"holz","ulmenholz"}),
   "Jaja, echtes einzigartiges Ulmenholz.\n");

  AddDetail("ende",
   "Am Ende siehst Du ein Loch.\n");

  AddDetail("anfang",
   "Ein kleines Loch ist am Anfang zu sehen.\n");

  AddDetail("loch",
   "Das Loch duerfte durch einen Nagel entstanden sein.\n");
 
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,110);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Brett");
  SetProp(P_MATERIAL, MAT_ELM_WOOD ); 
  SetProp(P_INFO,
   "Ulmenholz aus Ulm.\n");
  
  AddId (({"brett","qbrett"}));
 
  seteuid(getuid());
  
}

