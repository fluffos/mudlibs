inherit "std/thing"; 
#include <language.h>
#include <properties.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Glaslinsen");
  SetProp(P_LONG, 
   "Du siehst einige Glaslinsen, aus welchen ein geschickter Fernglasgnom "+
   "sicher eine Optik fuer ein Fernglas bauen kann.");

  SetProp(P_VALUE,0);
  SetProp(P_ARTICLE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Glaslinsen");
  SetProp(P_MATERIAL, MAT_CARBON ); 
  SetProp(P_INFO,
   "Einige Glaslinsen, essen kann man sie nicht.\n");
  
  AddId (({"glaslinse", "glaslinsen", "linse","linsen","qlinse"}));
 
  seteuid(getuid());
  
}

