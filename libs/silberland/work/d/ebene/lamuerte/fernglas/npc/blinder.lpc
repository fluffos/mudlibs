inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

string gfunc;
create()
{ 
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  
  SetProp(P_SHORT, "Reinhold");
  SetProp(P_LONG, 
   "Das ist Reinhold. Er ist gut gebaut, hat eine Knickerbocker an, traegt ein "+
   "original suedtiroler Holzhackerhemd und hat einen grossen Rucksack umgehangt. "+
   "Frueher war er mal ein bekannter Fernglasmacher, doch nun ist er blind und laeuft "+
   "ahnungslos in der Gegend herum.");
  SetProp(P_NAME, "Reinhold");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOATTACK, "sagt: Lass das, Du wirst doch keinen Blinden angreifen!");
  AddId(({"reini","reinhold"}));
  
  set_living_name("reinhold");
  
  create_default_npc(18);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 

  SetProp (P_REJECT,
     ({ REJECT_DROP, "Reinhold wirft @WEN einfach weg.\n" }) );

  
   SetProp (P_MNPC_AREA, "/d/ebene/Midas/room/");
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, "/d/ebene/Midas/room/room_d6");
   SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  
    SetChats(4, ({
     "Reinhold versucht nach Norden zu gehen aber donnert gegen eine Wand.\n", 
     "Reinhold stoesst sich den Kopf.\n",
     "Reinhold laeuft mit voller Wucht gegen Dich.\n Reinhold sagt: Tschuldigung ich bin blind.\n",
     "Reinhold tastet sich mit seinem Blindenstock vorwaerts.\n",
     "Reinhold knallt mit voller Wucht gegen einen Stein.\n Reinhold schreit AUAAAA!\n",
     "Reinhold singt: Ich will wieder sehen!\n",
     "Reinhold donnert mit voller Wucht gegen Dich.\nReinhold sagt: Tschuldige, ich bin ein Blinder.\n",
     "Reinhold grinst.\n",
     "Reinhold sagt: Naja, jetzt wo ich blind bin, brauch ich auch kein Fernglas mehr.\n",
     "Reinhold tastet unsicher alles mit seinem Blindenstock ab.\n" }));
                      
   AddInfo(DEFAULT_INFO,
     ({"sagt: Du willst mir wirklich helfen?\n"}) );
   


  AddInfo("augenlicht",
   "sagt: Ja, ich bin BLIND. Musst Du mir das auch noch vorhalten???\n");

  AddInfo(({"hilfe","helfen"}),
   "sagt: Ich brauche Deine Hilfe nicht. Ich komm schon so klar.\n");

  AddInfo(({"quest","aufgabe"}),
   "sagt: Ich habe keine Augfgabe fuer Dich. Was willst Du ueberhaupt?\n"+
   "Reinhold sagt: Blinde kommen so auch gut zurecht!!\n");


   AddInfo("fernglas",
    "sagt: Ja, ich war frueher ein bekannter Fernglasmacher, doch als \n"+
    "Reinhold sagt: ich beim testen eines Fernglases in die Sonne blickte, \n"+
    "Reinhold sagt: verlor ich mein Augenlicht. Danke das Du mich daran erinnerst\n"+
    "Reinhold sagt: Ich hoffe Dir gehts jetzt besser. Immer auf die Blinden.\nReinhold arglt.\n");

   AddInfo(({"sonne"}),
    "sagt: Die hab ich schon lange nicht mehr gesehen.\n");
 
  AddInfo("fernglasmacher",
    "sagt: Ich habe auch Lehrlinge gehabt, einen davon hab ich noch. Er\n"+
    "Reinhold sagt: kann Dir vielleicht eins bauen. Er ist zwar ein dummer \n"+
    "Reinhold sagt: Gnom, aber wenn Dir das egal ist, frag mich nach Gnom und\n"+
    "Reinhold sagt: ich schick ihn mit Dir mit. \n");
 
   AddInfo(({"pack","lehrlinge","lehrling"}),
    "sagt: Sind ein faules Pack, aber was solls.\n");
   
   AddInfo("gnom", "@@gfunc@@");
 
}

gfunc()
 {
  object gnom;


  if(present("lam\nfernglas",this_player())){
      write("Reinhold sagt: Der Gnom will nicht mit Dir mitgehen!\n");
      return("grinst Dich an.\n");
  }
  
  if (find_living(lower_case("gnomvon"+this_player()->QueryProp(P_NAME)))!= 0 ) 
    return "sagt: Dein Gnom ist hier um Dir zu helfen!\n"; 
 
 write("Reinhold sagt: Nun, ich vertraue Dir diesen Gnom an. Er wird Dir helfen.\n");
 
  gnom=clone_object("/d/ebene/lamuerte/fernglas/npc/gnom");
  gnom->move((environment(this_player())),M_NOCHECK); 
  gnom->set_fpl(this_player()->QueryProp(P_NAME));

  return("wuenscht noch ein schoenes Abenteuer!\n"); 
}
 
