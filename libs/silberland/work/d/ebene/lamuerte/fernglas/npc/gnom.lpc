inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>

#define MENV environment(this_object())

void fpl();
int *gotit=({0,0,0,0,0,0});
int done=0;
int i=0;
int building=0;
object player = this_object();
string uidplayer = getuid();
string *items = ({
      "ein Seerosenblatt", "ein Brett", "einen Nagel", "einen Hammer",
      "Glaslinsen", "ein bisschen Futter" });

string brauch();
void do_build(int i);

void create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Gnom");
  SetProp(P_LONG, 
      "Ein kleiner unscheinbarer Gnom. Sein Spezialgebiet ist es Fernglaeser zu erstellen. "
      "Er soll Dir helfen die Teile fuer ein Fernglas zu finden. Danach wird er sie fuer Dich "
      "zusammenbauen.");
  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);
  AddId(({"\ngno","gnom"}));
  create_default_npc(12);
  SetProp(P_ATTRIBUTES,(["int":25,"str":30,"con":25,"dex":25]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, 1);
  SetProp(P_HANDS,({" mit seinen kleinen Haenden",100}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 50+random(20) );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:30]) );  

  seteuid(getuid(this_object()));

  AddInfo(DEFAULT_INFO,
      ({ "kennt sich ueberhaupt nicht aus.\n",
       "zuckt ratlos mit den Schuldern.\n",
       "sagt: Was? Das glaubst ja selber nit, Du Seicherl.\n",
       "ignoriert Dich.\n",
       "sagt: Ja Du bist Deinem Ziel schon greifbar nah!\n",
       "sagt: Du wirst es wohl nie schaffen, frag nicht so bloed.\n",
       "zittert.\n",
       "sagt: Frag nicht so lang, gehen wir endlich!\n",
       "streckt Dir die Zunge raus.\n",
       "sagt: Red deidsch i vasteh nit wos Du meinen!\n",
       "sagt: Ja, die Frage stellen sich alle Verlierer.\n",
       "schuettelt den Kopf.\n",
       "nickt heftig auf Deine Frage hin.\n",
       "sagt: Hmmm, Eishoehlen vielleicht?",
       "sagt: Das ist doch nicht das Richtige!\n",
       "sieht Dich artig an, weiss aber nicht was Du meinst.\n",
       "sagt: Na Du hast Sorgen.\n",
       "sagt: Ach ja, davon hab ich gehoert.\n",
       "sagt: Ich glaube, diese Frage stellt sich fuer uns nicht.\n",
       "sagt: Du musst deutlicher reden, ich hab Deine Frage nicht verstanden.\n"
       }) ); 
  AddInfo(({"teil","teile","gegenstaende","gegenstand"}),"@@brauch@@"); 
  AddInfo(({"bauen","bau","zusammenbau","zusammenbaun"}),"@@dobuild@@");
  AddInfo("blah",
      "sagt: Ja ich bein ein kleiner Blah.\n");

  AddInfo(({"blatt","seerosenblatt"}),
      "sagt: Das gibts in einem Gebiet nordoestlich von Midas!\n"+
      "Der Gnom sagt: Ich brauchs zum polieren der Linsen.\n");

  AddInfo(({"brett"}),
      "sagt: Das Brett welches ich brauch, ist bei einer Muehle zu finden.\n");

  AddInfo(({"reinhold"}),
      "sagt: Ja, den kenn ich, Du wohl auch, oder?\n");
  AddInfo("muehle",
      "sagt: Welche Muehle? Das weiss ich nicht mehr.\n");

  AddInfo("gebiet",
      "sagt: Ja Gebiete gibt es viele.\n");

  AddInfo("midas",
      "sagt: Jo, ich kenn Max, der kommt aus Midas.\n");

  AddInfo("max",
      "sagt: Nein der hat nichts damit zu tun.\n");

  AddInfo(({"linsen","linse","glaslinse","glaslinsen"}),
      "sagt: Ohne die kann ich keine Optik bauen.\n");

  AddInfo("optik",
      "sagt: Ja, Linsen gibts in Smoersky.\n");

  AddInfo("smoersky",
      "sagt: Dort muessen wir auch hin.\n");

  AddInfo("futter",
      "sagt: Etwas schwarzes Drachenfleisch waer nicht schlecht.\n");

  AddInfo(({"nagel","naegel"}),
      "sagt: Ich brauche einen Spezialnagel.\n");

  AddInfo("spezialnagel",
      "sagt: Ja, Ush hat ihn mir gestohlen.\n");

  AddInfo("ush",
      "sagt: Ist wohl schwierig den zu besiegen?! Aber er hat ihn eh nicht persoenlich.\n");

  AddInfo(({"fleisch","drachenfleisch"}),
      "sagt: Oh, keine Ahnung wo es das geben koennte.\n");

  AddInfo(({"hammer"}),
      "sagt: Hmm, vielleicht liegt bei Haegar wo einer rum?.\n");

  AddInfo("haegar",
      "sagt: Kennst Du den nicht???\n");


  AddInfo(({"fernglaeser","fernglas"}),
      "sagt: Ja, wenn Du mir alle Teile besorgst, kann ich ein\n"+
      "Der Gnom sagt: Fernglas daraus basteln. Hab ich alles,\n"+
      "Der Gnom sagt: kannst Du mich nach bauen fragen, damit ich\n"+
      "Der Gnom sagt: es fuer Dich bastle.\n"); 


}


void set_fpl(string wem)
{
  if (!player = find_player(lower_case(wem)))
  {
    this_object()->remove();
    return;
  }
  uidplayer = getuid(player);

  player->AddPursuer(this_object());
  SetProp(P_SHORT,"Der Gnom von " + player->name(WEM));
  set_living_name( lower_case( "gnomvon" + uidplayer ) );
} 


void reset()
{
  ::reset();
  if ( !is_clone(this_object())) return;
  if (uidplayer && find_player(uidplayer)) {
    if (!player) player=find_player(uidplayer);
    return;
  }
  this_object()->remove();
}


void give_notify(object obj)
{

  if (!gotit[0] && obj->id("qblatt")) {
    write("Der Gnom sagt: Oh, danke! Das brauch ich um die Linsen zu polieren.\n");
    gotit[0]=1;
    obj->remove();
    brauch(); 
    return; 
  }

  if (!gotit[1] && obj->id("qbrett")) {
    write("Der Gnom sagt: Oh, danke fuer das Brett! Damit bau ich das Gehaeuse!\n");
    gotit[1]=1;
    obj->remove();
    brauch(); 
    return; 
  }

  if (!gotit[2] && obj->id("qnagel")) {
    write("Der Gnom sagt: Ein Nagel! Damit fixiere ich alle Teile fuer das Fernglas!\n");
    gotit[2]=1;
    obj->remove();
    brauch(); 
    return; 
  }

  if (!gotit[3] && obj->id("qhammer")) {
    write("Der Gnom sagt: Ein Hammer! Danke, den brauch ich zum Naegel nageln :)!\n");
    gotit[3]=1;
    obj->remove();
    brauch(); 
    return; 
  }


  if (!gotit[4] && obj->id("qlinse")) {
    write("Der Gnom sagt: Ah! Die Linsen brauch ich fuer die Optik des Fernglases!\n");
    gotit[4]=1;
    obj->remove();
    brauch(); 
    return; 
  }

  if (!gotit[5] && obj->id("qfutter")) {
    write("Der Gnom sagt: Na, ohne Futter wuerd ich so und so nicht arbeiten!\n");
    gotit[5]=1;
    obj->remove();
    brauch(); 
    return; 
  }

  write("Der Gnom sagt: Nein, das brauch ich wirklich nicht mehr!\n");
  write("Der Gnom gibts Dir wieder zurueck.\n"); 
  obj->move(this_player(),M_NOCHECK); 
}


string brauch()
{
  int x;
  string *fehlt;

  if (getuid(this_player()) != uidplayer)
    return "sagt: Nix da.\n";

  if (gotit[0] + gotit[1] + gotit[2] + gotit[3] + gotit[4] + gotit[5] >= 6)
  {
    write("Der Gnom sagt: Ich hab alles fuer das Fernglas!\n"+ 
        "Frag ihn einfach nach bauen, wenn er Dir das Fernglas bauen soll.\n");
    done = 1;
    return ("freut sich.");
  } 

  fehlt = ({ });
  for (x=0; x<=5; x++)
  {
    if (!gotit[x])
      fehlt += ({ items[x] });
  }
  write( break_string( "Ich brauch noch " + this_player()->CountUp(fehlt) + ".", 0, "Der Gnom sagt: " ) );
  return "grinst.\n"; 
}

string dobuild()
{
  if (building)
    return "murrt: Jaja, bin doch schon dabei!\n";

  if (getuid(this_player()) != uidplayer)
    return "sagt: Nix da.\n";

  if (!done)
    return "sagt: Nix da, ich hab ja nicht mal alle Teile fuer das Fernglas!\n";

  building=1;
  do_build(0);
  return "sagt: So lustig ist es, zu arbeiten.\n";
}


void do_build(int i)
{
  object ob;

  switch (i) {
    case 1: write("Der Gnom schraubt und werkt an dem Fernglas.\n");
            break;
    case 2: write("Der Gnom haemmert sich aus Brett und Nagel ein kleines Gehaeuse.\n");
            break;
    case 3: write("Der Gnom zieht das Seerosenblatt und die Glaslinsen aus seiner Tasche.\n");
            break;
    case 4: write("Der Gnom setzt alle Teile geschickt zusammen.\n");
            break;
    case 5: write("Der Gnom poliert die Glaslinsen, damit man auch was sehen kann.\n");
            break;
    case 6: write("Der Gnom begutachtet sein Werk.\n");
            break;
    case 7: write("Der Gnom grinst.\n");
            break;
    case 8: write("Der Gnom sagt: Hier hast Du das Fernglas, ich muss jetzt zurueck!\n");
            ob=clone_object("/d/ebene/lamuerte/fernglas/obj/fernglas");
            ob->move(this_player(),M_NOCHECK);
            write_file("/d/ebene/lamuerte/fernglas/QUEST.log",
                ctime()+": "+capitalize(getuid(this_player()))+" bestand die Quest. \n");
            call_out("killgnome", 1);
            return;
  }

  if (building)
    call_out( "do_build", 8, i+1 );
}

void killgnome()
{
  write( "Der Gnom winkt Dir noch ein letztes Mal zu und verschwindet.\n" );
  this_object()->remove();
}
