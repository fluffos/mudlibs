int access_rights(string name, string file, int readflag, int def)
{
  string *s;
  int n;

  if(name == "hasibaerchi" && file[0..14] == "/d/ebene/Gaffos") return 1;

  
  /*
  tell_object(find_player("creative"), sprintf(
        "***********ACCESS****************+\n"
        "name=%s\nfile=%s\nreadflag=%d\ndef=%d"
        "\n***************ENDE************\n", 
        name, file, readflag, def));
        */
  
  if (readflag)
    {
     if (file[0..7]=="brunnen/" )
     {
       if( lower_case(name)=="d.ebene.creative" || lower_case(name)=="d.ebene.lamuerte" ) 
         return 1;
       return 0;
     }
     return def;
    }

  if (readflag)
    {
     if (file[0..4]=="burg/")
       return 0;
     return def;
    }
  return def;
}
