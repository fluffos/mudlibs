inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Schmiedehammer");
  SetProp(P_LONG,
        "Das ist der Hammer von Haegar dem Schmied aus Kyranda. "+
        "Er wird normalerweise von ihm zur Herstellung von "+
        "Drachenruestungen verwendet.");
  SetProp(P_NAME, "Schmiedehammer");
  
  AddId( ({"\nhaegarhammer","hammer","schmiedehammer" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_WC, 100);
  SetProp(P_WEIGHT, 1800);                                                        SetProp(P_VALUE, 2500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_NR_HANDS, 2);
}

  
  