 }


 write("\n-Bonus Eigenschaft II:\n");
 for (z=0;z<=sizeof(bon_types)-1;z++)
 {
   write (z+") "+capitalize(bon_types[z][0])[0..(strlen(bon_types[z][0])-2)]+".\n");
 }
