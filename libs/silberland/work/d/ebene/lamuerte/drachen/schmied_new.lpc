 write("---------------------------------------------------------------------------*=>\n");

 for(i=0;i<100;i++)
 {
   str1=str2=str3="";
   if(i<sizeof(COLORS))
     str1=capitalize(COLORS[i]);
   else if (i==sizeof(COLORS))
     str1="";
   else if (i==sizeof(COLORS)+1)
     str1="---------------------*=>";
   else if (i==sizeof(COLORS)+2)
     str1="[Haupteigenschaften]";
   else if (i==sizeof(COLORS)+3)
     str1="---------------------*=>";
