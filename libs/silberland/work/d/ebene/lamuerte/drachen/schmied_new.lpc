     str1=capitalize(std_types[i-sizeof(COLORS)-4][0]);


   if(i< sizeof(bon_types))
     str2=capitalize(bon_types[i][0])[0..(strlen(bon_types[i][0])-2)];
   if(i< sizeof(bon_types))
     str3=capitalize(bon_types[i][1])[0..(strlen(bon_types[i][1])-2)];
   if(str1!="" || str2!="" || str2!="" )
     printf("%-25s %-25s %-25s\n",str1,str2,str3);
 } 

   

