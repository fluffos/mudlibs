#include "../def.h"

inherit "std/container";

#include <properties.h>

string boxcode=0;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine offene unkodierte Holztruhe");
  SetProp(P_LONG,
    "Eine riesiege titanverstaerkte Holztruhe aus magischem Birnenholz. Sie wurde aufwaendig "
    "verarbeitet. Vor allem ihre Oberseite, diese ist mit 62 kleinen Marmorwuerfel "
    "besetzt, welche Buchstaben und Zahlen eingraviert haben. Die Gravur blitzt in "
    "goldener Farbe. Diese Holztruhe kann man nicht nur oeffnen und schliessen, "
    "man kann Sie mit Hilfe der Marmorwuerfel auch kodieren.");
  SetProp(P_NAME, "Holztruhe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"truhe","holztruhe","\nlockbox"}));
  
  AddDetail("oberseite",
      "Viele kleine Marmorwürfel sind in das Birnenholz eingelassen.");
  AddDetail(({"holz","birnenholz"}),
      "Es sieht magisch aus!");
  AddDetail(({"wuerfel","marmorwuerfel"}),
      "Es sind Zeichen eingraviert.");
  AddDetail("zeichen",
      "AaBbCcDdEeFfggHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz1234567890");
  AddDetail("gravur",
      "Die Gravur is mit viel Liebe in die kleinen Marmorwuerfel eingearbeitet.");
  AddDetail("liebe",
      "Lamuertes Liebe hat euch diese wunderbare Holztruhe anno MMX beschert.");
  AddDetail("unterseite",
      "Die Unterseite ist nicht zu sehen, die Truhe ist auch viel zu schwer "
      "um sie hochzuheben und darunter zu blicken");
  AddDetail("farbe",
      "Die Farbe blitzt in Gold aus den Marmorwuerfeln hervor");
  AddDetail("hilfe",
      "Kommandos: oeffne, schliesse, kodiere");
  AddDetail("mmx",
      "Naja, 2010 halt...");

  SetProp(P_MATERIAL, ([ MAT_TITANIUM : 20, MAT_PEAR_WOOD : 70, MAT_MARBLE: 10 ]) );
  SetProp(P_WEIGHT, 666000);
  SetProp(P_VALUE, 16072010);
  SetProp(P_NOGET, "Du laesst die Holztruhe doch besser da wo sie ist.\n");

  SetProp(P_MAX_WEIGHT, 1000000);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_WEIGHT_PERCENT, 0);

  AddCmd(({ "oeffne" }), "do_open");
  AddCmd(({ "schliesse" , "schliess"}), "do_close");
  AddCmd(({ "kodiere" }), "set_code");

}

string get_code()
{
 return boxcode;
}

int set_code(string pin)
{ string *strs;
  
  notify_fail("Kommando: kodiere <code>\n");

 if (!pin || !this_player() )
   return 0;
   if (strs = regexp( ({pin}), "^[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]$"));
   if (!sizeof(strs)) 
   {
     write("Kodierung muss aus einer Kombination aus 6 Zahlen und/oder Buchstaben bestehen!\n");
     return 1;
   }
 if (QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN)
 {
   write ("Die Holztruhe muss geschlossen werden bevor sie kodiert werden kann.\n");
   return 1;
 }
 if (!boxcode)
 {
   write ("Die Holztruhe wurde auf "+pin+" kodiert.\n");
   SetProp(P_SHORT, "Eine geschlossene von "+this_player()->QueryProp(P_NAME)+" kodierte Holztruhe");
   boxcode=pin;
   return 1;
 }
 if(boxcode && boxcode==pin)
 {
   write ("Die Kodierung der Holztruhe wurde aufgehoben.\n");
   SetProp(P_SHORT, "Eine geschlossene unkodierte Holztruhe");
   boxcode=0;
   return 1;
 }

 write("Kodierung fehlgeschlagen!\n");
 return 1;
}

int do_open(string args)
{
  notify_fail("Was willst Du oeffnen?\n");

  if (!args || !this_player() )
  return 0;

  if(get_code())
  {
    write("Die Holztruhe ist kodiert und kann nicht geoeffnet werden.\n");
    return 1;
  }

 if (QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN)
 {
   write("Die Holztruhe ist doch schon offen!\n");
   return 1;
 }

 if (strstr(args, "truhe") < 0) return 0;
 
  write("Du oeffnest die Holztruhe.\n");
  say( this_player()->Name(WER,1)+" oeffnet die Holztruhe.\n");
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
  SetProp(P_SHORT, "Eine offene unkodierte Holztruhe");
 return 1;
}

int do_close(string args)
{
 notify_fail("Was willst Du schliessen?\n");
 
 if (!args || !this_player() )
  return 0;

 if (QueryProp(P_CNT_STATUS) == CNT_STATUS_CLOSED)
 {
   write("Die Holztruhe ist doch schon geschlossen!\n");
   return 1;
 }

 if (strstr(args, "truhe") < 0) return 0;
 
  write("Du schliesst die Holztruhe.\n");
  say( this_player()->Name(WER,1)+" schliesst die Holztruhe.\n");
  SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
  SetProp(P_SHORT, "Eine geschlossene unkodierte Holztruhe");
 return 1;
}

int query_weight_contents(){return 0;}

