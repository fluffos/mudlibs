
inherit "std/repair";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <npc.h>

int i=0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Haegar der Meisterschmied");
  SetProp(P_LONG, 
  "Du betrachtest Haegar. Mit seinem grossen Schmiedehammer formt er "+
  "die Drachenruestungen. Er ist viel groesser als Du und mit Sicherheit "+
  "auch viel staerker als Du. Irgendwie sieht er angsteinfloessend aus. "+
  "Greif ihn ja nicht an, denn er wuerde Dich in null komma nix toeten.");
  SetProp(P_NAME, "Haegar");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_GENDER, MALE);
  AddId(({"meisterschmied","schmied","haegar"}));
  set_living_name("haegar");
  
  create_default_npc(50);
  SetProp(P_ALIGN, -100);
  SetProp(P_XP,1);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem grossen Schmiedehammer",1560})); 
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_SPELLRATE, 95);
  SetProp( P_REJECT, ({REJECT_GIVE,
        "Der Schmied sagt: Wenn ich was brauche nehm ichs mir schon.\n"}) );
  SetProp(P_NOATTACK,1);

  AddSpell(1,2000,
   "  Haegar wirft Dir einen gluehenden Eisenklotz nach.\n",
   "  Haegar wirft @WEN einen gluehenden Eisenklotz nach.\n",
   ({DT_FIRE,DT_MAGIC}) );
  AddInfo(DEFAULT_INFO,
   ({"sagt: Ja, sicher was sonst.\n",
     "sagt: Was willst Du? Eine Drachenruestung?\n",
     "sagt: Mach schon, entweder Du kaufst was, oder Du gehst.\n",
     "sagt: Ich hab nicht ewig Zeit.\n",
     "sagt: Achja? Lamuerte hat mir davon erzaehlt.\n"}) );  
  AddInfo(({"farben","farbe","blau","weiss","rot","gruen"}),
    "Wenn Du bei mir bestellst, brauch ich auch eine Angabe "+
    "ueber die Farbe der Ruestung. Wobei ROT eine unheimlich "+
    "starke Farbe ist, BLAU ist meiner Meinung nach etwas fuer sehr "+
    "gescheite Leute, GRUEN wuerde ich mal fuer eine aeusserst "+
    "ausdauernde Farbe halten und WEISS ist die Farbe der "+
    "Geschickten. Wobei die Farben erst dann wirklich wichtig "+
    "sind, wenn man die richtigen Eigenschaften dazuwaehlt.", "sagt: ");
 AddInfo(({"art","arten"}),
    "Du kannst die Art der Ruestung entweder mit der Nummer "+
    "oder mit dem Namen der Ruestung auswaehlen.", "sagt: ");
 AddInfo( ({"schuppen","drachenschuppen"}),
   "Naja, normalerweise haben Drachen die Schuppen mit.\n", "sagt: ");
 AddInfo( ({"urlaub","ferien"}),
   "Ach war mein Urlaub schoen. Ich sollte vielleicht bald wieder mal "+
   "wegfahren. Naja, Lamuerte ist schuld, dass ich jetzt wieder "+
   "arbeiten muss.\n", "sagt: " );
 AddInfo( "lamuerte",
   "Ah! Gut dass Du mich daran erinnerst! Ich muss mal "+
   "wieder Urlaub bei ihm beantragen!\n", "sagt: ");
 AddInfo( ({"ruestungsteil","ruestung","ruestungen","drachenruestung","drachenruestunen"}),
   "Willst Du Drachenruestungen? Naja, mit genuegend Geld, "+
   "Schuppen und meinem Hammer laesst sich darueber reden.\n", "sagt: ");   
 AddInfo( ({"erhoehung","preiserhoehung"}),
   "sagt: Ach Du armer Schlucker, kannst Du Dirs nicht leisten bei mir\n"+
   "Haegar sagt: einzukaufen?\n"+
   "Haegar grinst.\n");
 AddInfo(({"hammer"}),"@@gibhammer@@","",""); 
 AddInfo( "zeit",
   "Die neue Technik der Drachenruestungsherstellung ist "+
   "um einiges schwieriger als frueher. Ich brache jetzt "+
   "so an die zwei Stunden um einen Ruestungsteil fertig"+
   "zustellen.\n", "sagt: ");
 AddInfo( ({"kraft","kraefte"}),
   "So wie Du sie kaufst, werden sie Dich immer staerken.", "sagt: ");
 AddInfo( "technik",
   "Die Technik dazu ist geheim. Sonst machts ja jeder.", "sagt: ");
 AddInfo( ({"hart","haerte"}),
   "Diese Eigenschaft macht die Drachenruestung physisch noch schutzbringender.", "sagt: ");
 AddInfo( ({"prophet","propheten"}),
   "Drachenruestungen der Propheten geben Dir Attribute.", "sagt: ");
 AddInfo( ({"unsterblich","unsterblichen"}),
   "Der Fluch der Unsterblichen schuetzt die Drachenruestung vor Armageddon.", "sagt: ");
 AddInfo( ({"hexe","hexerei"}),
   "Diese Art der Ruestung unterstuetzt Deine Zauber.", "sagt: ");
 AddInfo( ({"baer","baeren"}),
   "Baerige Drachenruestungen verhelfen dem Traeger zu mehr Vitalitaet.", "sagt: ");
 AddInfo( ({"feste","fest"}),
   "Eine gute Zusatzfaehigkeit um Deine Ruestungsklasse aufzumoebeln.", "sagt: ");
 AddInfo( ({"beschlagen","beschlagene"}),
   "Eine gute Zusatzfaehigkeit um Dir besseren Schutz zu gewaehren.", "sagt: ");
 AddInfo( ({"heilig","heilige"}),
   "Eine gute Zusatzfaehigkeit, um noch mehr Attribute zu bekommen.", "sagt: ");
 AddInfo( ({"gesalbt","gesalbte"}),
   "Diese Bonuseigenschaft verleiht dem Traeger einen Bonus auf Attribute.", "sagt: ");
 AddInfo( ({"energiegeladen","energiegeladene"}),
   "Diese Bonuseigenschaft fuellt den Traeger mit magischer Energie.", "sagt: ");
 AddInfo( ({"magisch","magische"}),
   "Diese Bonuseigenschaft unterstuetzt Dich mit Magiepunkten.", "sagt: ");
 AddInfo( ({"berserkende","berserkend"}),
   "Die berserkende Eigenschaft bringt Dir laengers Leben.", "sagt: ");
 AddInfo( ({"stark","starke"}),
   "Die Bonuseigenschaft 'staerke' wertet Deine Lebensenergie auf.", "sagt: ");
 AddInfo( ({"glitschig","glitschige"}),
   "Die glitschige Bonuseigenschaft versieht die Ruestung mit Feuerschutz.", "sagt: ");
 AddInfo( ({"gehuellt","gehuellte"}),
   "Die gehuellte Bonuseigenschaft nimmt Dir die Angst vor Feuer.", "sagt: ");
 AddInfo( ({"strahlend","strahlende"}),
   "Die strahlende Bonuseigenschaft versieht die Ruestung mit Schutz gegen Eis.", "sagt: ");
 AddInfo( ({"flammend","flammende"}),
   "Die flammende Bonuseigenschaft nimmt Dir die Angst vor Eis.", "sagt: ");
 AddInfo( ({"glatt","glatte"}),
   "Die glatte Bonuseigenschaft versieht die Ruestung mit Schutz gegen Wasser.", "sagt: ");
 AddInfo( ({"beschichtet","beschichtete"}),
   "Die beschichtete Bonuseigenschaft macht Dich zum Wasserliebhaber.", "sagt: ");
 AddInfo( ({"stromlinige","stromlinig"}),
   "Die stromlinige Eigenschaft einer Ruestung macht sie luftwiederstandsfaehig.", "sagt: ");
 AddInfo( ({"luftig","luftige"}),
   "Der luftige Bonus gibt der Ruestung mehr Schutz gegen ein Element.", "sagt: ");
 AddInfo( ({"gewuchtet","gewuchtete"}),
   "Gewuchtete Ruestungsteile sind extrem leicht.", "sagt: ");
 AddInfo( ({"krallenbesetzt","krallenbesetzte"}),
   "Krallenbesetzte Ruestungsteile sind super leicht zu tragen.", "sagt: ");
 AddInfo( ({"durchloechert","durchloecherte"}),
   "Diese Bonuseigenschaft verleiht der Ruestung enormen Hitzeschutz.", "sagt: ");
 AddInfo( ({"fellumgebene","fellumgeben"}),
   "Fellumgebene Ruestungsteile machen das Leben bei hohen Temperaturen leichter.", "sagt: ");
 AddInfo( ({"klirrende","klirrend"}),
   "Mit klirrenden Ruestungen kannst Du Eis und Schnee links liegen lassen.", "sagt: ");
 AddInfo( ({"strohueberzogene","strohueberzogen"}),
   "Mit strohueberzogenen Ruestungen wird Dir nicht so schnell kalt.", "sagt: ");
 AddInfo( ({"unverwuestliche","unverwuestlich"}),
   "Diese Teile werden nie kaputt.", "sagt: ");
 AddInfo( ({"diamantene","diamanten"}),
   "Mit dieser Ruestung brauchst Du kein Geld zum Ausbessern nach dem Kampf.", "sagt: ");
 AddInfo( ({"anschmiegsame","anschmiegsam"}),
   "Diese Ruestung wird Dich selbst durch den Tod begleiten.", "sagt: ");
 AddInfo( ({"koerperfoermige","koerperfoermig"}),
   "Diese Ruestung wirst Du nichtmal hergeben wenn Du stirbst.", "sagt: ");
 AddInfo( ({"eigenschaften","eigenschaft","haupteigenschaft","bonus","bonus eigenschaft","bonuseigenschaft","haupteigenschaften"}),
   "Frag ruhig naeher, zB. nach 'hexerei' oder 'anschmiegsam'.", "sagt: ");
 AddInfo( ({"kiste","holzkiste","teil", "truhe", "holztruhe"}),
   "Ein wahrlich meisterhaftes Teil, aber nachdem ich hier genug Platz habe, kann jeder sie benutzen der will.", "sagt begeistert: ");
 AddInfo ("platz",
   "Sieh Dich doch um, es ist genug Platz hier fuer mich.", "sagt: ");
 AddInfo( ({"kodierung", "kodieren"}),
   "Angeblich kann man diese niemals knacken, aber ich denke ein Meisterdieb koennte es wohl.", "sagt nachdenklich: ");
 AddInfo( ({"dieb","meisterdieb"}),
   "Es soll eine Diebesgilde geben deren Anfuehrer alle Schloesser dieser Welt knacken kann.", "sagt: ");
 AddInfo( ({"gilde","diebesgilde"}),
   "Es gibt sie wirklich! Sie ist jedoch so geheim das ihre Mitglider die dort erlernten Fertigkeiten niemals vor Anderen oder gar oeffentlich anwenden wuerden. Es geht ja nicht nur um Schloesserknacken, sondern auch um eine uralte geheime und sehr maechtige Kampfkunst die vieles in den Schatten stellt.", "fluestert: ");
 AddInfo( ({"anfuehrer"}),
   "Bei mir gehen so viele aus und ein, er war sicher schon mal hier, jedoch inkognito und deshalb kann ich nicht sagen wer es ist.", "sagt: ");
 AddInfo( "mitglieder",
   "Es gibt sie, sie haben jedoch ihren eigentlichen Gilden nie abgeschworen, man kann kann also nie sagen wer dabei ist oder nicht und wer dabei ist darf auch nie daruber sprechen oder seine dort erlernten Fertigkeiten vor Anderen anwenden.", "sagt: ");
 AddInfo ( ({"fertigkeiten","schloesserknacken","knacken","kampfkunst","schatten"}), 
   "Nein, keine weitere Diskussion, ich hab ohnehin schon zu viel erzaehlt.", "brummt: ");
 

}

int rep_auswahl(object ob)
{
  if( ob->_is_drobj() )
    return 1; 
  write("Haegar sagt: Ich repariere nur meine Drachenruestungen!\n");
  return 0;
}

gibhammer()
{if (i==0) {
  write("Haegar sagt: Meinen bekommst Du nicht, aber den alten Kannst Du haben.\n");
  clone_object("/d/ebene/lamuerte/fernglas/obj/qhammer.lpc")->move(this_player(),M_NOCHECK);
  i=1;
  return ("drueckt Dir einen alten Hammer in die Hand.\n");
  }
 return ("sagt: Tut mir leid, ich hab keinen Hammer uebrig.\n");
}

reset(){
  ::reset();
  i=0;
  }
 
give_notify(obj)
{ 
  //ruckwandlung deaktiviert einfuerungsphase war laneg genug.
  //write("Haegar sagt: Nein, das brauch ich nicht!\n");
  //write("Haegar gibts Dir wieder zurueck.\n");
  //obj->move(this_player(),M_NOCHECK);
  //return 1;
  
  if ( member_array("\nbein",obj->QueryProp(P_IDS) ) != -1 ||
       member_array("\narm",obj->QueryProp(P_IDS) ) != -1 ||
       member_array("\nstiefel",obj->QueryProp(P_IDS) ) != -1 )
  { write("Haegar sagt: Oh, hier hast Du 27 Schuppen dafuer.\n");
    obj->remove();
    if(obj=present("\nschupp",this_player())){
      obj->AddAmount(27);
     return 1;
    }
    obj=clone_object("/p/std/dragons/obj/schuppe.lpc");
    obj->AddAmount(26);
    obj->move(this_player(),M_NOCHECK);
    return 1;
  }

  if ( member_array("\nschild",obj->QueryProp(P_IDS) ) != -1 ||
       member_array("drachenhelm",obj->QueryProp(P_IDS) ) != -1 )
  { write("Haegar sagt: Oh, hier hast Du 31 Schuppen dafuer.\n");
    obj->remove();
    if(obj=present("\nschupp",this_player())){
      obj->AddAmount(31);
     return 1;
    }
    obj=clone_object("/p/std/dragons/obj/schuppe.lpc");
    obj->AddAmount(30);
    obj->move(this_player(),M_NOCHECK);
    return 1;
  }

  if ( member_array("\npanzer",obj->QueryProp(P_IDS) ) != -1 )
  { write("Haegar sagt: Oh, hier hast Du 50 Schuppen dafuer.\n");
    obj->remove();
    if(obj=present("\nschupp",this_player())){
     obj->AddAmount(51);
    return 1;
    }
    obj=clone_object("/p/std/dragons/obj/schuppe.lpc");
    obj->AddAmount(50);
    obj->move(this_player(),M_NOCHECK);
    return 1;
  }

  if ( member_array("\nhaegarhammer",obj->QueryProp(P_IDS) ) != -1 )
  { write("Haegar sagt: Danke fuer den Hammer.\n");
    return 1;
  }

  write("Haegar sagt: Nein, das brauch ich nicht!\n");
  write("Haegar gibts Dir wieder zurueck.\n");
  obj->move(this_player(),M_NOCHECK);

}

