inherit "/d/ebene/lamuerte/drachen/drobj/stddrachenruestung";

#include <properties.h>
#include <combat.h>
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenschild");

  SetProp(P_NAME, "Drachenschild");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "\nschild", "drachenschild", "schild" }) );
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_AC, 30);
  stat_set(2);
}

long ()
 {return(break_string(
     "Dieses Schild ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Es bietet trotz seiner unheimlichen Leichtheit "+
    "einen enormen Schutz. Das Schild schimmert "+rcol+".",78)
);
}

