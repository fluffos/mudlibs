inherit "/d/ebene/lamuerte/drachen/drobj/stddrachenruestung";

#include <properties.h>
#include <combat.h>
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Drachenarmschienen");
//  SetProp(P_LONG,
//    "Diese Schienen sind aus vielen kleinen Drachenschuppen gefertigt "+
//    "worden. Die Schienen bieteten trotz ihrer unheimlichen Leichtheit "+
//    "einen enormen Schutz. Sie schimmern in magischem @@color@@."
//    );

  SetProp(P_NAME, "Drachenarmschienen");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "\narm", "armschienen", "drachenarmschienen"}) );
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_AC, 10);
  SetProp(P_ARTICLE,0);
  stat_set(1);
}

long ()
 {return(break_string(
   "Diese Schienen sind aus vielen kleinen Drachenschuppen gefertigt "+
   "worden. Die Schienen bieteten trotz ihrer unheimlichen Leichtheit "+
   "einen enormen Schutz. Sie schimmern in magischem "+rcol+".",78)
  );
}

