inherit "/d/ebene/lamuerte/drachen/drobj/stddrachenruestung";

#include <properties.h>
#include <combat.h>
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenhelm");
  //SetProp(P_LONG,
  //  "Dieser Helm ist aus vielen kleinen Drachenschuppen gefertigt "+
  //   "worden. Er bietet trotz seiner unheimlichen Leichtheit "+
  //  "einen enormen Schutz. Dieser helm leuchtet @@color@@."
  //  );

  SetProp(P_NAME, "Drachenhelm");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "drachenhelm", "helm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_AC, 15);
  stat_set(2);  
}

long () 
 {return(break_string( 
    "Dieser Helm ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Er bietet trotz seiner unheimlichen Leichtheit "+
    "einen enormen Schutz. Dieser helm leuchtet "+rcol+".",78)
    );
}
