inherit "/d/ebene/lamuerte/drachen/drobj/stddrachenruestung";

#include <properties.h>
#include <combat.h>
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Drachenstiefel");

  SetProp(P_NAME, "Drachenstiefel");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "\nstiefel", "stiefel", "drachenstiefel"}) );
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_ARTICLE,0);
  SetProp(P_AC, 10);
  stat_set(1);
}

long ()
 {return(break_string(
    "Diese Stiefel sind aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Die Stiefel bieteten trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz. Sie schimmern "+rcol+".",78)
);
}

