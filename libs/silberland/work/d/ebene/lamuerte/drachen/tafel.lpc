#include <properties.h>
#include <language.h>
inherit "/std/thing";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine neue Holztafel");
  SetProp(P_LONG,"Auf diese Tafel hat Haegar was raufgemalt. Lies doch mal!\n");
  AddId(({"tafel", "tafle"}));
  SetProp(P_NAME, "Tafel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOGET, "Die Tafel ist unverrueckbar.\n");
  SetProp(P_WEIGHT, 1200);

 AddReadDetail (({"tafel","holztafel"}),

    "\n    ____________________________________________\n"
      "   |  Seit gegruesst edle Drachentoeter(innen)  | \n"
      "   |  ----------------------------------------  | \n"     
      "   |                                            | \n"
      "   |  Nachdem ich nun lange die Kunst des       | \n"
      "   |  Drachenruestungsschmieden perfektioniert  | \n"
      "   |  habe, kann ich euch freudiges berichten!  | \n"
      "   |  Von nun an, habe ich meine Palette von    | \n"
      "   |  unterschiedlichen Ruestungsteilen um ein  | \n"
      "   |  vielfaches erhoeht! Probiert doch einfach | \n"
      "   |  einmal euch die 'liste' anzusehen.        |\n"
      "   |                                            | \n"
      "   |                                            | \n"
      "   |                     MfG.                   | \n"
      "   |                     Haegar Meisterschmied  | \n"
      "   |_________________          _________________| \n"
      "                     |        |\n\n");
/*      "   |  Durch die neuen Arten der Ruestungen      | \n"
      "   |  ist die Nachfrage enorm gestiegen und     | \n"
      "   |  ich komme mit der Arbeit kaum hinterher,  | \n"
      "   |  daher bleibt mir keine Zeit um eure       | \n"
      "   |  zerschlissenen Ruestungen zu erneuern.    | \n"
      "   |  Jedoch konnte ich meine Preise durch      | \n"
      "   |  die neue materialsparende Bauart und      | \n"
      "   |  die schnellere Fertigung deutlich senken. | \n"
      "   |                                            | \n"
      "   |  Ein ganz besonderer Leckerbissen ist      | \n"
      "   |  auch noch die Kunst eine Ruestung         | \n"
      "   |  wieder zu zerlegen. Wenn Ihr mir          | \n"
      "   |  eine Drachenruestung, egal ob alt oder    | \n"
      "   |  neu gebt, wandle ich sie, mit leichten    | \n"
      "   |  Verlusten, wieder in Schuppen um.         | \n"
      "   |                                            | \n"
      "   |                     MfG.                   | \n"
      "   |                     Haegar Meisterschmied  | \n"
      "   |_________________          _________________| \n"
      "                     |        |\n\n");
*/
}

