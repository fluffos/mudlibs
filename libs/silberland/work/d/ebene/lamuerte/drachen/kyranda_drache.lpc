// Ein Drache aus Kyranda

inherit "/p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <new_skills.h> // P_GUILD_LEVEL
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP

#define ELEMENT_SECURE "secure_prop"


create() { 
  int x;
  object fleisch;
  
  
  if (!is_clone(this_object())) return;
  ::create();    

  create_default_dragon(1,5,0,10);
  SetProp(P_AGGRESSIVE,1); 
  clone_object("/d/ebene/lamuerte/drachen/schmiedehammer.lpc")-> move(this_object(),M_NOCHECK);
  
  set_living_name("kyrandadrache");  

}

void die(int poisondeath)
{
  object enemy, ob;

  if (enemy = QueryProp(P_KILLER) || this_player())
  {
    if ((enemy->QueryProp(P_GUILD) == "druidenzirkel") &&
        (enemy->QueryProp(P_GUILD_LEVEL) == 12) )
    {
      ob = clone_object("/gilden/druidenzirkel/obj/task");
      ob->SetProp(ELEMENT_SECURE, 99);
      ob->move(enemy, M_NOCHECK);
    }

    if (ob = present("\nzechpreller_quest_11", enemy)) {
      ob->Mark(poisondeath);
    }
  }

  ob = clone_object("/d/ebene/lamuerte/fernglas/obj/qfutter");
  ob->move(this_object(), M_NOCHECK);
  ::die(poisondeath);
}
