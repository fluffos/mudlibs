inherit "std/armour";

#include <properties.h>
#include <combat.h>

mapping stats = ([ A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]);
int defend_value = 10;
string rcol;
int statvalue = 0;
int isalo = 30;

void setcol(string farbe);

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Drachenruestung");
  SetProp(P_LONG,
    "Diese Ruestung ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Diese Ruestung bietet trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz."
    );

  SetProp(P_NAME, "Drachenruestung");
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_DEFEND_FUNC, this_object() );
//  SetProp(P_AUTOLOADOBJ,isalo);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_INFO,"Es scheint als wuerde diese Ruestung sogar den naechsten\n"+
  "Reboot ueberstehen.\n");
  AddId( "HELM","drachenruestung" );
}

void set_resist(int value)
{ defend_value = value;
  return;
}   

int modify_stat(string what, int value)
{ 
 stats[what]=value;
 return stats[what];
}

varargs int DoWear(int silent, int all)
{
  int ret;
  object ob;
  ret = ::DoWear (silent, all);
  if (objectp(ob=QueryProp(P_WORN))) 
  {
   SetProp (P_X_ATTR_MOD, stats );
   ob->UpdateAttributes();
  } 
   return ret;
}


varargs int DoUnwear(int silent)
{
  int ret;
  object ob;
  ob=QueryProp(P_WORN);
  ret = ::DoUnwear (silent);
  if (!QueryProp(P_WORN)) 
  {
    SetProp (P_X_ATTR_MOD, 0);
    if (objectp(ob)) ob->UpdateAttributes();
   }
    return ret;
}                     
                           


int DefendFunc(  string dtype, mixed spell, object enemy )
{
   if (member(dtype, DT_FIRE)>=0) {
      return( defend_value );
   }
}


string color()
{return(rcol);
}

void setcol(string farbe)
{rcol=farbe;
 AddId(farbe);
 //SetProp(P_AUTOLOADOBJ, isalo );

 //AddAdjective(farbe);
 //SetProp(P_NAME_ADJ,farbe);

 if (farbe=="rot") 
  {modify_stat("str",statvalue);
  return;
  }
 if (farbe=="blau") 
  {modify_stat("int",statvalue);
   return;
  }
 if (farbe=="gruen") 
  {modify_stat("con",statvalue);
   return;
  }
 if (farbe=="weiss") 
  {modify_stat("dex",statvalue);
  return;
   }

 write(
 "Da stimmt was nicht mit Der Ruestung! Lamuerte oder Erzie benachrichtigen.\n");
}
   
stat_set(int value)
{statvalue=value;
}


query_isalo()
{return (isalo);
}
 
reset()
{object ob;
 ::reset();
 ob=this_object();
 while (ob=environment(ob))
  {
   if (isalo>0 && interactive (ob) ) 
    {isalo--;
    }
  } 
  
// SetProp(P_AUTOLOADOBJ, isalo );
 if (isalo<1)
  {Set(P_AUTOLOADOBJ, 0);
   if (find_player("lamuerte"))
    // tell_object(find_player("lamuerte"),"Nope\n");
   SetProp(P_INFO,"Es scheint als wuerde Diese Ruestung den naechstn Reboot\n"+
   "nicht mehr ueberstehen.\n");
  }
}
 
 //Wargha, irgendwe soitamal _set_autoloadobj ausdocen!!!!!
 

int _up_count( int i)
{
  isalo+=i;
  

  if (isalo>=31)
  {isalo=30;
   return ( 0 );
  }

  return ( 0 );
}

mixed _query_autoloadobj()
 {
  if (isalo<=0) return ( 0 );
  return ( ({isalo, rcol}) );
 }  

void _set_autoloadobj( mixed args )
{ 
  

  object ob;
  ob=QueryProp(P_WORN);

  if (sizeof(args) > 1)
  {
    isalo=args[0];
    rcol=args[1];
  }

   SetProp (P_X_ATTR_MOD, ([ A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]));
   stats=([ A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]); 
   if (objectp(ob)) ob->UpdateAttributes();
    
  setcol (rcol);
  

}
   
   
int _is_drobj()
{return 1;
}                   
