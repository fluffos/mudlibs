inherit "/d/ebene/lamuerte/drachen/drobj/stddrachenruestung";

#include <properties.h>
#include <combat.h>
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenpanzer");
//  SetProp(P_LONG,
//    "Diese Ruestung ist aus vielen kleinen Drachenschuppen gefertigt "+
//    "worden. Sie bietet trotz ihrer unheimlichen Leichtheit "+
//    "einen enormen Schutz. Die Ruestung schimmert @@color@@. "
//    );

  SetProp(P_NAME, "Drachenpanzer");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "\npanzer", "drachenpanzer", "panzer" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_MATERIAL, MAT_BONE);
  SetProp(P_AC, 40);
  stat_set(3);
}

long ()
 {return(break_string(
    "Diese Ruestung ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Sie bietet trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz. Die Ruestung schimmert "+rcol+".",78));
 }


