inherit "/d/ebene/lamuerte/drachen/dnpc.lpc";

#include "vt100.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <npc.h>

object player;
string *commanders;
int s;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  create_default_dragon(12,5,0,20);

  this_object()->SetProp(P_SHORT, "Der "+VT_RED"Hausdrache"+VT_NORMAL+" von Lamuerte");
  this_object()->SetProp(P_AGGRESSIVE,0);
  this_object()->SetProp(P_LONG,
   "Das ist Lamuertes Hausdrache. Er sieht wirklich nicht gerade ausgesprochen "+
   "freundlich aus. Er ist ungefaehr fuenfzehn mal so grosz wie Du und wuerde Dich "+
   "als Vorspeise seines Fruehstucks gern vernaschen. Du solltest Dir wahrscheinlich "+
   "Hilfe besorgen, wenn Du hier Drachentoeter spielen willst.");

  s=0;

 if (!player=find_player(lower_case("lamuerte")))
 {
  this_object()->remove();
  return;
 }

  commanders=({ "lamuerte" });

  set_living_name("hausdrache");
  this_object()->AddId("hausdrache"); 
  player->AddPursuer(this_object());
  SetProp(P_NOATTACK, 1);
}



reset()
{
   ::reset();
 if(player && find_player (player && lower_case(player->QueryProp(P_NAME))) ) return;

    this_object()->remove();
 }


void catch_tell( string str )
{
 string scstr,plrn,vscstr;
 object folman,enm;


 if(!sscanf(str,"%s sagt: %s",plrn,scstr) ) return 0;
 //write (plrn+" : "+scstr+".\n");
 if(member_array(lower_case(plrn),commanders)==-1){
//   say("Der Hausdrache wird "+capitalize(plrn)+" bald verspeisen.\n");
   return 0; 
 }
 if(scstr=="komm mit\n")
  {
   if(!folman=find_player(lower_case(plrn))) return 0;
   say("Der Hausdrache laeuft nun "+capitalize((plrn))+" nach.\n");
   folman->AddPursuer(this_object());
   return 0;
  }

 if(scstr=="sitz\n")
  {
   if(s==1){
    say("Der Hausdrache setzt sich nochmals nieder.\n"); 
    return 0;
   }
   if(!folman=find_player(lower_case(plrn))) return 0;
   folman->RemovePursuer(this_object());
   say("Der Hausdrache setzt sich nieder.\n");
   s=1;
   return 0;
  }


 if(scstr=="verschwinde\n")
  {
   this_object()->remove();
   return 0;
  }

 if(sscanf(scstr,"vertraue %s\n",vscstr) ){
   if(lower_case(plrn)!="lamuerte") return 0;
   say("Der Hausdrache vertraut sich "+capitalize((vscstr))+" an.\n");
   commanders+=({vscstr});
   return 0;
 }

 if(sscanf(scstr,"verachte %s\n",vscstr) ){
   if(lower_case(plrn)!="lamuerte") return 0;
   say("Der Hausdrache wendet sich von "+capitalize((vscstr))+" ab.\n");
   commanders-=({vscstr});
   return 0;
 }


 if(sscanf(scstr,"toete %s\n",vscstr) ){
   if(lower_case(plrn)!="lamuerte") return 0;
   if(enm=present(vscstr)){
   say("Der Hausdrache wird maechtig boese.\n");
   Kill(enm);
    return 0;
   }
   commanders-=({vscstr});
   return 0;
 }
  return 0;


}
