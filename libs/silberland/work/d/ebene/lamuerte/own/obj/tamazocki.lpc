inherit "std/thing";


#include <properties.h>
#include <language.h>

int hungry=0,hungermod=0,mood=20,tlob=0,tquael=0,ttrain=0,tplay=0,tage=1,tweight=30,tsize=2,tstr=1,tint=1,tdex=1,tcon=1;
string tname="Zockie";

int loopchk;

int operate();
int report_things();
int statdec(int x, int amount);
int statinc(int x, int amount);

//int online0/1,hungry0/1,mood+30,tlob05,tage,tweight,tsize,tstr,tint,tdex,tcon;

string VERS="0.1";


void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_NAME,"Tamazocki");
  SetProp(P_SHORT,"Ein Tamazocki");
  SetProp(P_LONG,"Du haeltst einen kleinen, steinernen, Kaefig in deinen Haenden. Er ist dazu da, um ein "+
                 "kleines Tamazocki Wesen zu zuechten. Mit 'tamahilfe' siehst Du was man mit diesem "+
                 "Tamazocki so alles anstellen kann."
                 );
  AddId( ({"zocki","tamazocki"}) );
  SetProp(P_GENDER, NEUTER);
  AddCmd(({"tamahilfe"}), "helpfunc");
  AddCmd(({"tamastatus"}), "statusfunc");
  AddCmd(({"tamaname"}), "tamaname");
  AddCmd(({"tamafuetter"}), "tamafuetter");
  AddCmd(({"tamalob"}), "tamalob");
  AddCmd(({"tamafolter"}), "tamafolter");
  AddCmd(({"tamatraining"}), "tamatraining");
  AddCmd(({"tamaspiel"}), "tamaspiel");

  call_out("do_loop",40+random(50));

}


int do_loop(){
  if(loopchk>=3 && interactive(environment(this_object())) ){
    operate();
    loopchk=0;
  }
  else if (interactive(environment(this_object())) ){
    report_things();
    loopchk++;
  }
  call_out("do_loop",40+random(50));
}

int helpfunc(){
  write("Tamazocki "+VERS+" Hilfesystem.\n");
  write("---------------------------\n");
  write("tamastatus: Statusseite des Tamazocki.\n"+
        "tamaname <name>: Du vergibst fuer das Wesen dan Namen <name>.\n"+
        "tamafuetter: Das Wesen im Kaefig Fuetten.\n"+
        "tamalob: Das Wesen loben.\n"+
        "tamafolter: Das Wesen Foltern.\n"+
        "tamatraining: Das Wesen trainieren.\n"+
        "tamaspiel: Mit dem Wesen spielen.\n"
        );
  return 1;
}

int tamaname(string str){
  if(tname!="Zockie") {
    write("Du hast schon einen Namen vergeben!\n");
    return 1;
  }
  if(!str) return 0;
  tname=capitalize(str[0..10]);
  write("Dein Wesen heisst jetzt: "+tname+".\n");
//  this_object()->AddId(lower_case(str));
  return 1;
}

int tamafuetter(){
  if(!hungry){
    write("Du fuetterst "+tname+". \n"+tname+"freut laechelt.\n");
    hungermod++;
    hungry=1;
    return 1;
  }
  write(tname+" wird ganz uebel von dem vielen essen.\n");
  hungermod++;
  return 1;
}

int tamalob(){
  if(tlob<5){
    write("Du lobst "+tname+".\n"+tname+"springt in seinem Kaefig herum voller Freude.\n");
    tlob++;
    return 1;
  }
    write("Du lobst "+tname+".\n"+tname+"bleibt unbeeindruckt am Kaefigboden sitzen.\n");
    tlob++;
  return 1;
}

int tamatraining(){
  write("Du trainierst "+tname+". Nun sieht "+tname+" total erschoepft aus.\n");
  ttrain++;
  return 1;
}

int tamaspiel(){
  write("Du spielst mit "+tname+". "+tname+" freut sich riesig.\n");
  tplay++;
  return 1;
}

int tamafolter(){
  write("Du quaelst "+tname+".\n"+tname+" schreit fuerchterlich auf vor Schmerzen.\n");
  tquael++;
  return 1;
}



int statusfunc(){
  write("Tamazocki "+VERS+" Status.\n");
  write("---------------------------\n");
  write("Name: "+tname+"\n");
  if(!hungry) write("Hunger:   [NEIN]\n"); 
  if(hungry)  write("Hunger:   [JA]\n"); 
  if(mood < 5 ) write("Gemuet:   [TOTAL SAUER]\n");
  if(mood > 5 && mood <= 10) write("Gemuet:   [EINGESCHNAPPT]\n");
  if(mood > 10 && mood <= 15) write("Gemuet:   [MURREND]\n");
  if(mood > 15 && mood <= 20) write("Gemuet:   [ZUFRIEDEN]\n");
  if(mood > 20 && mood <= 25) write("Gemuet:   [SEHR ZUFRIEDEN]\n");
  if(mood > 25 && mood <= 30) write("Gemuet:   [TOTAL FUT DRAUF]\n");
  write("Alter:    ["+tage+"]\n");
  write("Gweicht:  ["+tweight+"]\n");
  write("Hoehe:    ["+tsize+"]\n");
  write("Kraft:    ["+tstr+"]\n");
  write("Weise:    ["+tint+"]\n");
  write("Schnell:  ["+tint+"]\n");
  write("Ausdauer: ["+tint+"]\n");

  return 1;
}




int operate(){
 if (hungermod>3) {
   if(random(20)>15) write(tname+" hat verstopfung. Sieht nicht gut aus.\n");
   tweight=tweight+random(20);
   statdec(0,1);
   hungermod=0;
 }
 else if (hungermod<1 || hungry==0) {
   if(random(20)>15) write(tname+" stirbt beinahe vor lauter Hunger!\n");
   tweight=tweight-random(20);
   hungermod=0;
   statdec(0,1);
 }
 else {
   hungermod=0;
   statinc(0,1);
 }

 hungry=1;

 if(tlob>5){
   if(random(20)>15) write(tname+" liegt nur noch faul herum.\n");
   tlob=0;
   if(mood>2) mood=mood-random(2);
   statdec(0,1);
 }
 else if (tlob <1){
   if(random(20)>15) write(tname+" fuehlt sich minderwertig.\n");
   tlob=0;
   if(mood>2) mood=mood-random(2);
   statdec(0,1);
 }
 else{
   tlob=0;
   if(mood<28) mood=mood+random(2);
   statinc(0,1);
 }

 if(tquael>10 && mood <5) {
   if(random(20)>15) write(tname+"nimmt sich das leben, er hat es mit Dir nicht mehr ausgehalten.\n");
   say(this_player()->QueryProp(P_NAME)+" hat "+tname+" zum Selbstmord getrieben.\n");
   this_object()->remove(1);
 }

 if (ttrain > 8) {
   if(random(20)>15) write(tname+" kann sich kaum noch bewegen vor lauter Muskelkater.\n");
   tweight=tweight-ttrain;
   ttrain=0;
   statdec(0,2);
 }
 else if(ttrain<2){
   if(random(20)>15) write(tname+" sieht etwas schlaff aus.\n");
   ttrain=0;
   tweight=tweight+random(ttrain*10);
   statdec(0,1);
 }
 else{
   ttrain=0;
   statinc(0,1);
 }

 if(tplay<1)
   write(tname+" koennte wieder mal ein Spielchen vertragen.\n");
 else {
   mood=mood+random(1);
 }

 if(tweight>4950) {
   if(random(20)>15) write(tname+" explodiert weil er so fett ist und stirbt elendlich.\n");
   this_object()->remove(1);
 }
 else if(tweight>4800) {
   if(random(20)>15) write(tname+" fuehlt sich wirklich fett.\n");
   statdec(0,1);
 }
 else if(tweight<5) {
   write(tname+" stirbt an Magersucht.\n");
   this_object()->remove(1);
 }


 if(tage>950 && (random(100)>50)) write(tname+" fuehlt den Alterstod herannahen.\n"); 
 if(tage>1000 && (random(100)>50)) {
   write(tname+" stirbt an Altersschwaeche.\n"); 
   this_object()->remove(1);
 }

 tage=tage+random(1);
 write(tage+"\n");
 if(tsize<250 && tage<110) tsize=tsize+random(2);
 if(tage==110) write(tname+" hat seine Maximalgroesse erreicht.\n"); 
 
}


int statdec(int x,int amount){
  x=0;

  if(amount>5) amount=5;
  if(x==0){
  x=random(3)+1;
  if(x==1 && random(50)>20 && tstr>5) tstr=tstr-amount;
  if(x==2 && random(50)>20 && tint>5) tint=tint-amount;
  if(x==3 && random(50)>20 && tdex>5) tdex=tdex-amount;
  if(x==4 && random(50)>20 && tcon>5) tcon=tcon-amount;
  }
 return 1;
}

int statinc(int x,int amount){
  x=0;

  if(amount>5) amount=5;
  if(x==0){
  x=random(3)+1;
  if(x==1 && random(50)>20 && tstr<205) tstr=tstr+amount;
  if(x==2 && random(50)>20 && tint<205) tint=tint+amount;
  if(x==3 && random(50)>20 && tdex<205) tdex=tdex+amount;
  if(x==4 && random(50)>20 && tcon<205) tcon=tcon+amount;
  }
 return 1;
} 


int report_things(){
  if(hungry==0) write(tname+" will was essen!\n");
  if(tlob==0) write(tname+" will tobt wie ein Wilder herum! Lob ihn mal lieber.\n");
  if(tplay==0) write(tname+" will SPIELEN!!\n");
  if(ttrain<2) write(tname+" uebt sich im Schattenboxen! Anscheinend will "+tname+" trainieren.\n");
  if(random(50)>40) write(tname+" gackt. *PFURZ*\n");
  if(random(50)>40) write(tname+" schaut aus seinem Kaefig heraus.\n");
  if(random(50)>40) write(tname+" grinst Dich an.\n");
  if(random(50)>40) write(tname+" lacht.\n");

  return 1;
}
  
