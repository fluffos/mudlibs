inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Tablett voller FaScHINgSKraPfeN!");
  SetProp(P_LONG, 
   "Ein Tablett voller Faschingskrapfen. Lamuerte hat sie extra frisch fuer\nDich gebacken. Nimm Dir einen wenn Du noch keinen hast!\n");

  SetProp(P_NOGET,"Nein, nicht alle auf einmal!\n");
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Tablett");
  AddId(({"tablett","krapfentablett"}));
  
  AddDetail(({"krapfen","faschingskrapfen"}),
   "Nimm Dir einen Krapfen. Oder hast Du schon einen?");
  
 
  seteuid(getuid());
  AddCmd("nimm","nfunc");
}

 nfunc(str)
  { object ob;

    notify_fail("Achso?!");
    
    if (str!="krapfen")
    {   
    write("Jaja?!\n");
    return 0;    
    }
   if(!deep_present("\nkrapfen",this_player()))
   {
           clone_object("/d/ebene/lamuerte/own/obj/krapfen.lpc")->move(this_player(),M_NOCHECK);
    write("Du nimmst Dir einen Krapfen.\n");
    return 1;
  } 
 
  write("Du hast schon einen. Giersack!\n");
  return 1;
  }
