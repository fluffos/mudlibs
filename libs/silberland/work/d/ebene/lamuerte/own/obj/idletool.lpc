inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <food.h>
#include <moving.h>

int repl;
string rtext;

create()
{ 
  if(!is_clone(this_object())) return;
  ::create( ({"iss", "esse"}) );
  SetProp(P_SHORT,"Ein Ideltool");
  SetProp(P_LONG,break_string( 
   "Das ist ein wirklich wunderbares Idletool, es sieht fast aus wie "+ 
   "ein kleiner Palmtop nur dasz es aus Holz geschnitzt ist, denn im "+
   "Silberland gibt es natuerlich keine elektronischen Gegenstaende. Winzige "+
   "Idlinge sitzen in ihm, welche dem echten Idler das Leben erlecihtern. "+
   "Kommandos: iliste, imode, itext" 
   ,78));  
  SetProp(P_VALUE,0);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1); 
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Idletool");
 
  repl=0;
  rtext="Ich bin derzeit aber sowas von idle!";

  AddId (({"tool","idletool","\nidle"}));
 
    AddCmd("iliste","listfunc");
    AddCmd("imode","ronoff");
    AddCmd("itext","textfunc");
}


textfunc(string str)
{  notify_fail("Das will das Idletool so nicht!\n");
   if(!str) return 0;
   rtext=str;
   listfunc();
   if (repl==1) this_player()->command_me("weg "+rtext+"\n");
   return 1;
}

listfunc()
{object ob;
 write("-Idletool V0.1 Alpha - "+this_player()->QueryProp(P_NAME)+" Version--------------------------\n");
 write("-\n");
 if (repl==0) write("-IDLE Mode: AUS\n");
 if (repl==1) write("-IDLE Mode: EIN\n");
 write("-Idle Text: "+rtext+"\n");
 write("-----------------------------------------------------------\n");
 return 1;
}

ronoff()
{repl=1-repl;
 listfunc();
 write("-");
 if (repl==1) this_player()->command_me("weg "+rtext+"\n");
 if (repl==0){
   this_player()->command_me("weg");
   this_player()->command_me("thist");
 }
   return 1;
}


reset()
{::reset();
  if(repl==1) write("Dein Idletool erinnert Dich daran mal wieder nicht zu ideln, alter IDLER!\n"); 
}

    
