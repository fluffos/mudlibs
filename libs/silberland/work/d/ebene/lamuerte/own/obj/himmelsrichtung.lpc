inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Himmelsrichtungsanzeiger");
  SetProp(P_LONG, 
  "    N\n"+
  "    |\n"+
  " W--+--O\n"+
  "    |\n"+
  "    S \n");
 

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Himmelsrichtungsanzeiger");
  AddId(({"himmelsrichrungsanzeier","anzeiger","richtungsanzeier"}));
 
  seteuid(getuid());

}
 
 
