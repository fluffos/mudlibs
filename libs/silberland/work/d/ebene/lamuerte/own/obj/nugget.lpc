inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein McNugtet");
  SetProp(P_LONG, 
   "Ein kleines, ekelerregendes, fuerchterliches, unbarmherziges McNugget.\n"+
   "Es sieht sehr verfuehrerisch aus, doch Vorsicht! Es koennte Dir beim \n"+
   "Verzehr schlecht werden!\n");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"McNugget");
  SetProp(P_NOGET,0);
  SetProp(P_NODROP,1);
  AddId(({"nugget","mcnugget"}));
 
  seteuid(getuid());
  AddCmd(({"iss","esse"}),"efunc");

}

 efunc(str)
  { object ob;

    notify_fail("So nicht!");

    if (!str) 
     {
      write("Was willst denn essen?\n");
       return 1;
     }

    if(str=="nugget" || str=="mcnugget")
     {write ("Wahhh!! Du willst das scheussliche Nugget essen!\n"+
             "Du nimmst einen grossen Bissen!\n");
      call_out("kdr",4);
      return 1;
     }
   
  
  }   
   kdr()
    {write ("Dir wird schlecht.\n");
     call_out("dis",5);
     return 1;
    }

 dis()
  {write ("Du musst kotzen! Schnell lauf aufs Klo!\n");
   call_out("das",3);
   return 1;
  }
  
 das()
 {write("Ok, ich machs Dir leichter, aber jetzt geh endlich, bevor die\n"+ 
        "Tastatur vollgereiert ist!!\n");
  call_out("weg",2);
  return 1;
 }
 
 weg()
 {write("Bis gleich!\n");
  this_player()->disconnect();
  remove();
  return 1;
 }
