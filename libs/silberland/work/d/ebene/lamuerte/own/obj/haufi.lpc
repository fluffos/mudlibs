inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include <wizlevels.h>

create()
{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Haufi");
  SetProp(P_LONG, 
   "Ein kleines, braunes, Haufi. Es stinkt leicht und sieht nicht besonders "+
   "lecker aus. Anscheinend ist es noch relativ frisch, da es an und an "+
   "noch dampft. Man kann es verscharren.");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Haufi");
  AddCmd("verscharre","sfunc");
  AddId(({"haufi"}));
  seteuid(getuid());
}

int sfunc(string txt) {
  notify_fail("Was willst Du verscharren?\n");

  if(!txt) return 0;

  if(txt!="haufi") return 0;
  
  tell_object(this_player(),"Du verscharrst das Haufi.\n");
  tell_room(environment(this_player()),
      this_player()->QueryProp(P_NAME)+
      " verscharrt ein Haufi.\n",
      ({this_player()}));
  this_object()->remove( 0 );
  return 1;
}
      
