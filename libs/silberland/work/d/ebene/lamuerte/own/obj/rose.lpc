inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine Rose");
  SetProp(P_AUTOLOADOBJ,1);
  SetProp(P_LONG, 
   "Eine kleine rote Rose. Sie hat einen gruenen langen Stiel. Die Dornen "+
   "scheinen sorgfaeltig entfernt worden zu sein. Du hast sie von Lamuerte "+
   "bekommen. Wollte er sich fuer etwas entschuldigen? An der Rose haengt ein "+
   "kleines Schild, welches Du lesen kannst.");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Rose");
  SetProp(P_NEVERDROP,1);
  SetProp(P_AUTOLOADOBJ,4711);
  AddId(({"rose","rot","rote"}));
  
  AddDetail("stiel",
   "Der Stiel ist lang, gruen und die Dornen scheinen entfernt worden zu sien.");
  
  AddDetail("dornen",
   "Keine zu sehen.");
  
  AddDetail("schild",
   "Man kann es lesen.\n");
   
  AddReadDetail("schild",
   "Liebe UTX, diese Rose hab ich extra fuer Dich gepflueckt. Entschuldige, "
   "dass ich Dich beleidigt hab. Baba, Muarte.");

  seteuid(getuid());
}
