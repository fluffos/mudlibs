inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Bonbon");
  SetProp(P_LONG, 
   "Ein kleines, suesses Bonbon. Es kann somanche Dinge, ist aber nicht \n"+
   "fuer Spieler vorgesehen.\n");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Bonbon");
  SetProp(P_NOGET,0);
  SetProp(P_NODROP,1);
  AddId(({"bonbon","zuckerl"}));
 
  seteuid(getuid());
  AddCmd(({"iss","esse"}),"efunc");

}

 efunc(str)
  { object ob;

    notify_fail("So nicht!");

    if (!str) 
     {
      write("Was willst denn essen?\n");
       return 1;
     }

    if(str=="bonbon" || str=="zuckerl")
     {write ("Wahhh!! Du isst das Bonbon. Hoffentlich hats keiner gesehen!\n");
      call_out("kdr",4);
      return 1;
     }
   
  
  }   
   kdr()
    {write ("Du spuerst die magische Wirkung des Bonbons.\n");
     this_player()->SetProp(P_DEAF,0);
     remove();
     return 1;
    }

