inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>

int r=0;
string name,show;
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine Flasche");
  SetProp(P_LONG, 
   "Eine kleine Flasche Apfelkorn. Auf dem Etikett ist ein gruener Apfel und \n"+
   "eine Kornaehre zu sehen. Ein kleiner Schriftzug weist darauf hin, dass er \n"+
   "von Berentzen gebrannt wurde.\n");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Apfelkornflasche");
  AddId(({"flasche","korn","apfelkorn"}));
 
  seteuid(getuid());
  AddCmd(({"trink","trinke"}),"tfunc");



 AddDetail(({"flasche","korn","apfelkorn"}),
  "Scheint ein koestliches Gesoeff sein. Hmmm... Ob Du mal trinken solltest?!\n");
 AddDetail("gesoeff",
  "Du schraubst die Flasche auf und riechst daran. Purer Apfelkorn. Hmmm! "+
  "lecker!!");
 AddDetail("etikett",
  "Das Etikett ist wirklich unbedeutend verglichen mit dem Inhalt!");
 AddDetail("inhalt",
  "Los, trink schon, sonst wird er noch warm!");
 AddDetail("apfel",
  "Der Apfel sieht noch etwas unreif aus. Er ist total gruen.");
 AddDetail(({"korn","kornaehre","aehre"}),
  "Oh mann Du kannst kein echter Alkoholiker sein, anstatt zu trinken, "+
  "untersuchst Du da stundenlang die Flasche. Du Banause wirdt nie ein "+
  "echter Kampftrinker.");
 AddSpecialDetail(({"schrift","schriftzug"}),"ift");

 
 AddDetail("kampftrinker",
 "Tjo, trink mal diese Flasche, dann sehen wir weiter.");
 AddDetail("alkoholiker",
 "Uiiii! Du auch?!\n");
 AddDetail("banause",
 "Hmmm... Ja, Du bist wohl einer."); 

}
 
 
string ift()
 {show=read_file("/d/ebene/lamuerte/own/obj/apfel.txt");
 tell_object(this_player(),show);
 return ""; 
}

tfunc(str)
  { object ob;
    notify_fail("So nicht!");

    
    if (!str) 
     {
      write("Was willst denn trinken?\n");
       return 1;
     }

    if(str=="korn" || str=="apfelkorn" || str == "flasche")
     {
      if (r!=0)
       {write("Das machst Du ja schon!\n");
        return 1;
       }
      write ("Du setzt die Flasche an und nimmst einen grossen Zug von dem gruenlichen, "+
             "nach \nApfel riechenden Gesoeff.\n");
     
      name=this_player()->QueryProp(P_NAME);      
      say (name+" schraubt eine Apfelkornflasche auf und setzt sie an.\n");
      r=1;
      call_out("kdr",4);
      return 1;
     }
   
  
  }   
   kdr()
    {write ("Mann schmeckt das Zeug gut, du kannst gar nicht aufhoeren zu schlucken.\n");
     say(name+" wird gruen rosa gepunktet. Ob das am Apfelkorn liegt?!\n");
     call_out("dis",5);
     return 1;
    }

 dis()
  {write ("Uff! Geschafft, Du hast die ganze Flasche runtergezogen!!\n");
   say ("Ob "+name+" gleich kotzen wird? "+name+" wankt verdaechtig.\n");
   call_out("das",5);
   return 1;
  }
  
 das()
 {write("Uiiii! Die wird ganz schoen schwindelig! *HICK* Das war doch etwas \n"+ 
        "zu viel. Dir wird uebel und Du spuerst wie Dein Magen seinen Inhalt\n"+
        "langsam nach oben wuergt.\n");
  say(name+" scheint uebel zu werden. Schnell! In Deckung!\n");
  call_out("weg",7);
  return 1;
 }
 
 weg()
 {write("Uaarrgghh... Du reierst Dir die ganze Tastatur voll...\n");
  say (name+" reiert sich Tasten und Bildschirm voll.\n");
  this_player()->SetProp(P_ALCOHOL,100);
  call_out("verschwind",6);
  return 1;
 }

verschwind()
{write("Du wirfst die Flasche weg. Das is wohl nix fuer Dich.\n");
 say (name+" wirft Dir eine Flasche an den Kopf.\n"); 
 this_object()->remove();
return 1;
 }
