inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <food.h>
#include <moving.h>

create()
{ 
  if(!is_clone(this_object())) return;
  ::create( ({"iss", "esse"}) );
  SetProp(P_SHORT,"Ein feiner Faschingskrapfen");
  SetProp(P_LONG,break_string( 
   "Ein wirklich leckerer Faschingskrapfen. Er ist goldbraun gebacken "+ 
   "und auf beiden Seiten mit Staubzucker bestreut. Aus einem kleinen "+
   "Loch in der Seite des Krapfens quillt etwas Marillenmarmelade heraus. "+
   "Er ist noch lauwarm, sieht aus als waer er gerade frisch gebacken worden. "+
   "Mit: krapfschenk <spielername> kannst Du ihn verschenken." 
   ,78));  
  SetProp(P_VALUE,0);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1); 
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  
  SetProp(P_NAME,"Krapfen");
  
  AddId (({"krapfen","faschingskrapfen","\nkrapfen"}));

/*  AddSmell(DEFAULT_SMELL, "Der Krapfen duftet wunderbar suesz!\n");
*/

  AddDetail(({"zucker","staubzucker"}),
   "Der Staubzucker ist ganz fein auf dem Krapfen verstraeut.\n");

  AddDetail("loch",
   "Ein kleines Loch, da ist ja Marmelade drinnen!\n");

  AddDetail(({"marmelade","marillenmarmelade"}),
   "Hmm, die duftet herrlich nach Marillen!\n");
  
  AddDetail("seite",
   "In der Seite ist ein Loch.\n");
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,0}), F_SOAK:12 , 
     F_VERB: "essen" ,
     F_MSG:"Mit Genuss verspeist Du den leckeren Faschingskrapfen. \n"
          +"Irgendwie fuehlst Du Dich besser.\n",
     F_MSG_ROOM:"isst einen leckeren Krapfen. Dir Laeuft das Wasser im Mund zusammen.\n" ]) );

    AddCmd("krapfschenk","sfunc");

}


cmd_werfen()
{write("blah");
 return 1;
}

sfunc(str)
{object ob;
   
    if(!str)
    {write("SYNTAX: krapfschenk <spieler>\n");
     return 1;
    }

    if(!(ob=find_player(str)))
    {write("Der Spieler mit dem Namen "+str+" ist doch gar nicht da!\n");
     return 1;
    }

  if((present("\nkrapfen",ob)))
   {write (ob->QueryProp(P_NAME)+" hat schon einen Krapfen.\n");
   return 1;
   }

   if(!present(ob,environment(this_player())))
    {write("Du wirfst "+ob->QueryProp(P_NAME)+" einen Krapfen quer durchs Silberland zu.\n");
    say(this_player()->QueryProp(P_NAME)+" wirft einen Krapfen quer durchs SL.\n");

    tell_object(ob,this_player()->QueryProp(P_NAME)+" wirft Dir einen Krapfen vom anderen Ende der Welt zu.\n");
     this_object()->move(ob,M_NOCHECK);

     return 1;
    }
 
   write("Du drueckst "+ob->QueryProp(P_NAME)+" einen Faschingskrapfen in die Hand.\n");

    tell_object(ob,this_player()->QueryProp(P_NAME)+" schenkt Dir einen Krapfen.\n");
  this_object()->move(ob,M_NOCHECK);

  return 1;
}
