/* FILE: knebel.c
   INFO: Ein kleiner Knebel fuer Nervende Spieler.
   DATE: 06.97
   (w) LaMuerte
*/


inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>

create ()
{ object ob;
  if (!is_clone (this_object ()))
    return;
    
  thing::create ();
  SetProp (P_SHORT, 0);
  SetProp (P_LONG, 0);
  SetProp (P_IDS,0);

  AddId ("tuch");

  seteuid (getuid ());
  AddCmd ("","rfunc",1);

}

 
rfunc (str)
{string inp,*befugniss;
 inp=query_verb();
 befugniss=({"norden","sueden","westen","osten","nordosten","nordwesten",
             "suedosten","suedwesten","nordwestoben","nordwestunten",
             "nordostoben","nordostunten","suedwestunten","suedwestoben",
             "suedostoben","suedostunten","raus","rauf","runter","oben",
             "unten","nordoben","nordunten","westoben","westunten","ostoben",
             "ostunten","suedoben","suedunten","kaufe","verkaufe",
             "ja","nein","betrete","klettere","klettern","rgib","rnimm",
             "quit","ende","schau"});
if (member_array(inp,befugniss)==-1)
 { 
 write("Du bist geknebelt. Irgendwie hindert Dich der Knebel an Deiner\n"+
       "Bewegungsfreiheit.\n");
 say(this_player()->QueryProp(P_NAME)+ " murmelt etwas unverstaendliches.\n");
 return 1;
 }

}
