inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Rollmeter");
  SetProp(P_LONG, 
   "Ein langer Rollmeter. Mit ihm kannst Du deine Freunde abmessen. <miss person>");

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Rollmeter");
  
  AddId( "rollmeter");
  seteuid(getuid());
  AddCmd(({"miss","messe"}),"mfunc");

}

 mfunc(str)
  { object ob;

    notify_fail("So nicht!");
  

    if (!str) 
     {
      write("Was willst denn messen?\n");
       return 1;
     }



   ob=present(str,environment(this_player()));

 
    
   if (!ob)
    { write ("Du misst umher, kommst aber zu keinem Ergebnis.\n");
       return 1;
    }
  
 
 
   if ((ob->QueryProp(P_NAME))==(this_player()->QueryProp(P_NAME)) && 
      (this_player()->QueryProp(P_GENDER)==2))
    { write ("90-60-90. Was fuer ein wundervoller Rollmeter!\n");
       return 1;
    }
 
 
 
   if ((ob->QueryProp(P_NAME))==(this_player()->QueryProp(P_NAME)))
    { write ("Das hast Du schon oft genug im Bett gemacht.\n");
       return 1;
    }

  
   if ((ob->QueryProp(P_SIZE))<=1)
    { write("Das ist ein bisserl zu klein.\n");
        return 1;
    }


    write (ob->QueryProp(P_NAME)+" ist "+ob->QueryProp(P_SIZE)+" cm gross.\n");
    say(this_player()->QueryProp(P_NAME)+" spielt mit einem Rollmeter herum.\n");
     return 1;
  } 
    

