// ~(w) Lamuerte 2001
// ~Tschechen / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/tschechen.c
// ~Level:  20+well level
// ~Hands:  285,DT_SLASH   WC: default AC: default 
// ~R.Str:  SLASH:-0.4,BLUDGEON:-0.4,PIERCE:-0.4,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Area Spell

inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "./spells.h"


string *dwarv_names=
({
    ({"Mur","os","lav"}),
    ({"Chir","to","mat"}),
    ({"Vla","dos","lek"}),
    ({"Tsche","led","mir"}),
    ({"Krk","ol","sov"}),
    ({"Voit","si","nek"}),
    ({"Zek","dol","schil"}),
    ({"Vran","wol","pil"}),
    ({"Murk","kel","dil"}),
    ({"Sek","kal","ek"}),
    ({"Net","ma","sek"}),
    ({"Bra","ti","slav"}),
    ({"Dur","la","bev"}),
    ({"Bron","is","zeck"}),
    ({"Hirt","ro","mil"}),
    ({"Volg","sef","nack"}),
    ({"Chir","do","witsch"}),
    ({"Yez","ov","del"}),
    ({"God","hel","muk"}),
    ({"An","gro","xil"}),
});


create()
{
  string myname;
  int x;
  x=sizeof(dwarv_names);
  myname=dwarv_names[random(x)][0]+dwarv_names[random(x)][1]+dwarv_names[random(x)][2];
 
  if (!is_clone(this_object())) return;
  
::create(); 
  
  SetProp(P_SHORT, myname+", der kleine Bub");
  SetProp(P_LONG, 
  "Vor Dir steht ein kleiner Bub.");

  SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, myname);
  SetProp(P_RACE, "Kind");
  SetProp(P_SIZE, 45+random(33));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","bub",lower_case(myname)}));
  create_default_npc(random(9)+2);
  SetProp(P_ALIGN, -170);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Haenden",30,DT_SLASH}));
  SetProp(P_SPELLRATE,(10));
          
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,    DT_BLUDGEON    :-0.4,    DT_PIERCE     :-0.4,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "huepft mit einem lustigen 'Chalooo' herein");
  SetProp(P_MSGOUT, "huepft mit einem lustigen 'Pfiiirdgooood'");

  SetProp(P_DIE_MSG, " bleder CHUND ist tot.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");

   AddDefaultSpell(80,2,DS_PARALYZE,
       "  "+myname+" paralysiert Dich mit seinem Mundgeruch.\n",
       "  "+myname+" paralysiert @WEN mit seinem Mundgeruch.\n");
 
  AddDefaultSpell(51,2,DS_MASS_DAMAGE,
       "  "+myname+" trifft Dich mit einem Rundumschlag.\n",
       "  "+myname+" wuetet fuerchterlich.\n",DT_PIERCE);


  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

}

