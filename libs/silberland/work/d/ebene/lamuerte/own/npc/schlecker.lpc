// ~(w) Lamuerte 2002
// ~Woodys Erdbeerschlecker der Abwertung
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/schlecker.c
// ~Level:  32-34 
// ~Hands:  610,DT_BLUDGEON  WC: default AC: default 
// ~Spells: 
// ~R.Str:  SLASH:-1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-1,COLD:-1,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:AreaDamage Fire, Heals when attacked with Fire/Cold, More attcks/round

inherit "std/mnpc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "./spells.h"


string *heads=({"leergelutschter","abgeknabberter","halber","angelutschter","abgeschleckter","riesiger"});
int numbheads,curhp;

create()
{
  if (!is_clone(this_object())) return;
  
::create(); 

  numbheads=5;

  SetProp(P_SHORT, "Woody's "+heads[numbheads]+" Erdbeerschlecker der Abwertung");
  SetProp(P_LONG, 
  "Ein suesser Erdbeerschlecker, er wertet alles ab.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_AREA, "/d/ebene/lamuerte/brunnen/rooms/level"+well_level()+"/");
  SetProp (P_MNPC_WAIT, ({40, 70, 20}));
  SetProp (P_MNPC_DEFAULTROOM,
                    file_name(interactive(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL + MOV_MAYLOAD);

  SetProp(P_MAX_HP,QueryProp(P_HP)*3);  
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Woody's Erdbeerschlecker der Abwertung");
  SetProp(P_RACE, "Schlecker");
  SetProp(P_SIZE, 590+random(20));
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"\nbrunnenpc","schlecker","erdbeerschlecker","abwertung"}));
  create_default_npc(32+random(3));
  SetProp(P_ALIGN, -690);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit voller Abwertung",105,DT_COLD})); 
  SetProp(P_SPELLRATE,20);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-1,      DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-1,      DT_COLD        :-1,      DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "kommt an, und wertet Dich ab");
  SetProp(P_MSGOUT, "geht");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");


  curhp=this_object()->QueryProp(P_MAX_HP);
}



void Attack(object enemy) {
    ModifySkillAttribute(this_object(), SA_SPEED, ((random(numbheads)+1)*100), 2);
      ::Attack(enemy);
}


Defend(int dam, string dam_type, mixed spell, object enemy)
{ 
  object ob;
  int which,damdone;

  if (!pointerp(dam_type)) dam_type = ({ dam_type });

  if(this_object()->QueryProp(P_HP)<=((curhp/3)*2) || random(1999)==512 && numbheads > 0)
  {
    tell_room(environment(),
        "  ** Der Schlecker veraendert sich. **\n");
    numbheads--;
    curhp=this_object()->QueryProp(P_HP);
    SetProp(P_SHORT, "Woody's "+heads[numbheads]+" Erdbeerschlecker der Abwertung");
   return ::Defend(dam, dam_type, spell, enemy);
  }

  return ::Defend(dam, dam_type, spell, enemy);
}
