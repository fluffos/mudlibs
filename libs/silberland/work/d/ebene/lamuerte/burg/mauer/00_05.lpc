inherit "/d/ebene/lamuerte/burg/mauer/mauerraum.lpc";

#include <properties.h>
#include <language.h>
#include "files.h"

int *wi;
int res=0;

void create()
{
  ::create();

  res=0;

  SetProp(P_INT_SHORT,"Im Gang");
  SetProp(P_INT_LONG,
        "Du stehst inmitten der Burgmauer. Dieser Gang verbindet den Turm im Nordwe"
        "sten mit dem Turm im Suedwesten. Von hier aus ist es noch ein weiter Marsch "
        "bis hin zum Turm im Nordwesten, auch der Suedwestliche liegt weit "
        "entfernt. Du hast nun ungefaehr die Haelfte der Wegstrecke von einem zum"
        " anderen Turm geschafft." );
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));

  AddDetail(({"wassertropfen"}),
        "Du siehst momentan keinen.");
  AddDetail(({"mauer","burg","burgmauer"}),
        "Die Burgmauer bietet Schutz vor feindlichem Angriff. Ein Gang in dieser Mau"
        "er ermoeglicht den gesicherten Stellungswechsel von einem Turm zum naechst"
        "en. Sie ist aus Stein gebaut." );
  AddDetail(({"gang"}),
        "Der Gang fuehrt von Turm zu Turm.");
  AddDetail(({"weg"}),
        "Eigentlich ist es ja kein Weg sondern ein Gang.");
  AddDetail(({"turm"}),
        "Von hier aus ist kein Turm zu sehen." );
  AddDetail(({"stein","steine"}),
        "Die Burgmauer, somit auch der Gang, ist aus Steinen gemauert. Dir faellt "
        "ein kleiner Knopf auf einem der Steine auf." );
  AddDetail("boden",
      "Du findest Spuren, die mitten durch die Wand fuehren.");
  AddDetail(({"spur","spuren"}),
      "Die Spuren fuehren in die Wand hinein.");
  AddDetail("wand",
      "Als Du die Wand genauer betrachtest fallen Dir vier Oeffnungen auf.");
  AddDetail(({"oeffnung","oeffnungen"}),
      "Die Oeffnungen sehen aus als koenne man einen Schluessel hineinstecken "
      "und damit einen Mechanismus betaetigen. Die erste Oeffnung schimmert golden, die "
      "zweite silbern, die dritte schwarz und die vierte weiss.");
  AddDetail("mechanismus",
      "Hmm, sehen kann man ihn nicht."); 
  AddDetail("knopf",
      "Unglaublich, man kann den Knopf druecken.");

  AddSmell(DEFAULT_SMELL,
      "Die ist stickig hier drinnen.");
  AddSound(DEFAULT_SOUND,
      "Eiserne Stille. Hin und wieder wird sie durch Wassertropfen gestoert.");

  AddExit("norden",ROOM("00_06.lpc"));
  AddExit("sueden",ROOM("00_04.lpc"));

  AddCmd(({"steck","stecke"}),"sfunc");
  AddCmd(({"drueck","druecke"}),"dfunc");
  wi=({0,0,0,0,0});
}


int dfunc(string str)
{
  notify_fail("Was denn?!\n");

  if(!str)
    return 0;

  if(str!="knopf")
    return 0;

  if(wi[1]==1 && wi[2]==1 && wi[3]==1 && wi[4]==1)
  {
    write("Du drueckst den Knopf und ein Ausgang oeffnet sich.\n");
    AddExit("unten",ROOM("drachenhoehle.lpc"));
    return 1;
  }

  write("Du drueckst den Knopf. Aber, ist auch etwas geschehen?!\n");
  return -1;
}

int sfunc(string str)
{
  string keycol,opencol;
  object key;

  notify_fail("Was willst Du denn wohin stecken?\n");
  if(!str)
    return 0;

  if(sscanf(str,"%s schluessel in %s oeffnung",keycol,opencol)!=2)
   return 0;

  if (keycol=="goldenen" && opencol=="goldene")
  {
    if (wi[1]==1)
      write("Das is doch schon offen.\n");
    else if (!key=present("\nburggoldener",this_player()))
      write("Du hast doch den Schluessel gar nicht.\n");
    else
    {
      write("Du hoerst wie sich der Mechanismus bewegt.\n"+
          "Der goldene Schluessel zerfaellt zu Staub.\n");
      key->remove();
      wi[1]=1;
    }
    return 1;
  }

  if (keycol=="silbernen" && opencol=="silberne")
  {
    if (wi[2]==1)
      write("Das is doch schon offen.\n");
    else if (!key=present("\nburgsilberner",this_player()))
      write("Du hast doch den Schluessel gar nicht.\n");
    else
    {
      write("Du hoerst wie sich der Mechanismus bewegt.\n"+
          "Der silberne Schluessel zerfaellt zu Staub.\n");
      key->remove();
      wi[2]=1;
    }
    return 1;
  }

  if (keycol=="weissen" && opencol=="weisse")
  {
    if (wi[3]==1)
      write("Das is doch schon offen.\n");
    else if (!key=present("\nburgweisser",this_player()))
      write("Du hast doch den Schluessel gar nicht.\n");
    else
    {
      write("Du hoerst wie sich der Mechanismus bewegt.\n"+
        "Der weisse Schluessel zerfaellt zu Staub.\n");
      key->remove();
      wi[3]=1;
    }
    return 1;
  }

  if (keycol=="schwarzen" && opencol=="schwarze")
  {
    if (wi[4]==1)
      write("Das is doch schon offen.\n");
    else if (!key=present("\nburgschwarzer",this_player()))
      write("Du hast doch den Schluessel gar nicht.\n");
    else
    {
      write("Du hoerst wie sich der Mechanismus bewegt.\n"+
          "Der schwarze Schluessel zerfaellt zu Staub.\n");
      key->remove();
      wi[4]=1;
    }
    return 1;
  }

  write("Dieser Schluessel passt nicht in diese Oeffnung.\n"); 
  write("Probier mal: steck <farbe> schluessel in <farbe> oeffnung.\n"+
      "z.B. steck goldenen schluessel in goldene oeffnung.\n");

  return 1;
}

void reset()
{
  ::reset();

  if(wi[1]==1 && wi[2]==1 && wi[3]==1 && wi[4]==1)
  {
    res++;
    call_out("???",10);
  }

  if (res >= 2)
  {
    wi=({0,0,0,0,0});
    RemoveExit("unten");
    res=0;
    tell_room(this_object(),break_string(
          "Auf einmal schiebt sich eine Platte ueber den Ausgang "
          "nach unten.",78));
  }
}

