
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
 ::create();
  SetProp(P_INT_SHORT,"Eingang zur Drachenhoehle");
  SetProp(P_INT_LONG,
    "Du stehst am Eingang einer Drachenhoehle. Unter Dir lauert wohl eine "
    "gemeingefaehrliche Bestie. Ein Drache, der nur darauf wartet, Dich zu "
    "zerfleischen. Es erfordert wohl mehr als einen wahren Helden, um solch "
    "ein Ungetuem zu bezwingen.");
  SetProp(P_LIGHT,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_INDOORS,1);
  SetProp(P_NO_MNPC, 1);

  AddSmell(DEFAULT_SMELL, 
      "Die ist stickig hier drinnen.");
  AddSound(DEFAULT_SOUND,
      "Ab und an hoerst Du lautes Fauchen.");
  AddSound("fauchen",
      "Es hoert sich nicht gerade freundlich an.");
  AddDetail(({"eingang"}),
      "Ein riesiger Eingang in eine Drachenhoehle.");
  AddDetail(({"drachenhoehle","hoehle"}),
      "Schwarzes Gestein umgibt Dich.");
  AddDetail(({"steine","gestein"}),
      "Die Steine sind dunkelschwarz.");
  AddSpecialDetail(({"drache","bestie","ungetuem"}),"drache");
  AddDetail( ({"boden","decke","wand","waende"}),
      "Ziemlich schwarz, das Zeug.");   
  AddDetail(({"held","helden"}),
      "Du untersuchst Dich. Nein, das kann kein echter Held sein.");

  AddExit("oben",ROOM("00_05.lpc"));
  AddExit("unten",ROOM("drachenhoehle1.lpc"));
}

string race2string(string race, int gender)
{
  switch(race)
  {
    case "Elf":
      if( gender==FEMALE) return "Elfinnen";
      else return "Elfen";
      break;
    case "Zwerg":
      if(gender==FEMALE) return "Zwerginnen";
      else return "Zwergen";
      break;
    case "Hobbit":
      if(gender==FEMALE) return "Hobbitmaedchen";
      else return "Hobbits";
      break;
    case "Mensch":
      if(gender==FEMALE) return "Menschenmaedchen";
      else return "Menschen";
      break;
    case "Dunkelelf":
      if( gender==FEMALE) return "Dunkelelfinnen";
      else return "Dunkelelfen";
      break;
    case "Troll":
      if(gender==FEMALE) return "Trollweibern";
      else return "Trollen";
      break;
    case "Oger":
      if(gender==FEMALE) return "Ogerweibern";
      else return "Ogern";
      break;
    default:
      return race+"n";
  }
}

string drache()
{
  return break_string("Der Drache wartet weiter unten auf "+
   this_player()->QueryProp(P_NAME)+
   ". Warum? Er hat noch nicht gefruehstueckt und liebt das Fleisch von "
   "kleinen "+race2string( this_player()->QueryProp(P_RACE), 
                 this_player()->QueryProp(P_GENDER))+".",78);
}
