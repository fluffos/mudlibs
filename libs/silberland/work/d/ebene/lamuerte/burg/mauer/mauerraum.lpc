

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"
#include "coordinates.h"

create()
{
 ::create();
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_INDOORS,1);

  SetProp(P_COORDINATES, ({ 0,0,0 }));

  AddSmell(DEFAULT_SMELL,"Es ist stickig hier drinnen.");
  AddSound(DEFAULT_SOUND,"Eiserne Stille. Hin und wieder wird "+
  	"sie durch Wassertropfen gestoert.");

  AddDetail(({"wassertropfen"}),
    "Du siehst momentan keinen.");
  AddDetail(({"mauer","burg","burgmauer"}),
    "Die Burgmauer bietet Schutz vor feindlichem Angriff. "+
    "Ein Gang in dieser Mauer ermoeglicht den gesicherten Stellungswechsel "+
    "von einem Turm zum naechsten."); 
  AddDetail("schutz",
    "Komisch, Du siehst sowas hier nicht!?\n");
  AddDetail(({"feind","feinde","feindlich"}),
    "Keine Feinde zu sehen, oder doch?!\n");
  AddDetail( ({"angriff", "toeten"}),
    "Auf, auf zum froehlichen Toeten!\n");
  AddDetail(({"wechsel","stellung","stllungswechsel"}),
    "Naja, man kann von einem zum naechsten Turm wandern.\n");
  AddDetail(({"gang"}),
    "Der Gang fuehrt von Turm zu Turm.");
  AddDetail(({"weg"}),
    "Eigentlich ist es ja kein Weg sondern ein Gang.");
  AddDetail(({"turm"}),
    "Von hier aus ist kein Turm zu sehen.");
  AddDetail(({"stein","steine"}),
    "Die Burgmauer, somit auch der Gang, ist aus Steinen gemauert.");
  AddDetail("boden",
    "Er ist aus Steinen gebaut.\n");
  AddDetail(({"wand","waende"}),
    "Die Waende sind aus Stein gemauert.\n");
  AddDetail("himmel",
    "Den Himmel kann man von hier aus nicht sehen.\n");
  AddDetail("decke",
    "Die Decke ist ueber Dir.\n");

}

