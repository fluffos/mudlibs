inherit "/d/ebene/lamuerte/burg/mauer/mauerraum";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Im Gang");
 SetProp(P_INT_LONG,break_string(
  "Du stehst inmitten der Burgmauer. Dieser Gang verbindet den Turm im Nordo"+
  "sten mit dem Turm im Suedosten. Von hier aus ist es noch ein ganz schoenes "+
  "Stueck bis zum Turm im Nordosten. Der Suedoestliche ist von aus nicht all zu"+
  "weit entfernt."
,78));
AddSmell(DEFAULT_SMELL,break_string("Die ist stickig hier drinnen.",78));
AddSound(DEFAULT_SOUND,break_string("Eiserne Stille. Hin und wieder wird sie durch Wassertropfen gestoert.",78));
SetProp(P_LIGHT,1);
SetProp(P_INDOORS,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
AddDetail(({"wassertropfen"}),break_string(
  "Du siehst momentan keinen."
,78));
AddDetail(({"mauer","burg","burgmauer"}),break_string(
  "Die Burgmauer bietet Schutz vor feindlichem Angriff. Ein Gang in dieser Mau"+
  "er ermoeglicht den gesicherten Stellungswechsel von einem Turm zum naechst"+
  "en. Ein kleines Loch in der Wand sticht Dir ins Auge."
,78));
AddDetail(({"gang"}),break_string(
  "Der Gang fuehrt von Turm zu Turm."
,78));
AddDetail(({"weg"}),break_string(
  "Eigentlich ist es ja kein Weg sondern ein Gang."
,78));
AddDetail(({"turm"}),break_string(
  "Von hier aus ist kein Turm zu sehen."
,78));
AddDetail(({"stein","steine"}),break_string(
  "Die Burgmauer, somit auch der Gang, ist aus Steinen gemauert."
,78));
AddDetail("loch",
    "Das Loch ist gerade gross genug um sich durchzuzwaengen, ausser man ist zu gross.");
AddDetail(({"auge","augen"}),
    "In Deinen Augen funkelt dieses Loch.");
AddDetail("wand","Die Wand besteht aus Stein.");
    

AddExit("norden",ROOM("10_05.lpc"));
AddExit("sueden",ROOM("10_03.lpc"));
AddCmd( ({"zwaeng","zwaenge","kletter","klettere","steig","steige","huepf","huepfe","spring","springe"}), "do_loch");
}

int do_loch(string str)
{
  notify_fail("Wohin denn?\n"); 
   
  if(!str) return 0;
  
  if ( member_array(str,({"in loch","durch loch","loch","durchs loch","ins loch"})) != -1)
  { 
    if( this_player()->QueryProp(P_LEVEL) <= 21 ) 
    { 
      write("Du zwaengst Dich durch ein enges Loch.\n"); 
      this_player()->move("/d/ebene/lamuerte/drachen/schmied_new",M_GO,
          "in ein Loch","klettert","klettert aus der Mauer heraus");
      return 1;
    }
    else
    {
      write(break_string("Du versuchst Dich durch das Loch zu zwaengen, "+
          "bist aber zu gross dazu."));
      return 1;
    }
  return 0;
  }
}


