inherit "/d/ebene/lamuerte/burg/mauer/mauerraum";

#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Im Gang");
 SetProp(P_INT_LONG,break_string(
  "Du stehst inmitten der Burgmauer. Dieser Gang verbindet den Turm im Suedwe"+
  "sten mit dem Turm im Suedosten. Von hier aus ist es noch ein weiter Marsch "+
  "bis hin zum Turm im Suedosten, auch der Suedwestliche liegt weit "+
  "entfernt. Du hast nun ungefaehr die Haelfte der Wegstrecke von einem zum"+
  " anderen Turm geschafft."
,78));
AddSmell(DEFAULT_SMELL,break_string("Die ist stickig hier drinnen.",78));
AddSound(DEFAULT_SOUND,break_string("Eiserne Stille. Hin und wieder wird sie durch Wassertropfen gestoert.",78));
AddItem(NPC("soldat.lpc"), REFRESH_DESTRUCT);
AddItem(NPC("soldat.lpc"), REFRESH_DESTRUCT);
AddItem(NPC("oberwache.lpc"), REFRESH_DESTRUCT,
  ([P_MNPC_AREA: BURGMAUER(""), 
    P_MNPC_DEFAULTROOM: BURGMAUER("11x12y.lpc") ]) );
SetProp(P_LIGHT,1);
SetProp(P_INDOORS,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
AddDetail(({"wassertropfen"}),break_string(
  "Du siehst momentan keinen."
,78));
AddDetail(({"mauer","burg","burgmauer"}),break_string(
  "Die Burgmauer bietet Schutz vor feindlichem Angriff. Ein Gang in dieser Mau"+
  "er ermoeglicht den gesicherten Stellungswechsel von einem Turm zum naechst"+
  "en."
,78));
AddDetail(({"gang"}),break_string(
  "Der Gang fuehrt von Turm zu Turm."
,78));
AddDetail(({"weg"}),break_string(
  "Eigentlich ist es ja kein Weg sondern ein Gang."
,78));
AddDetail(({"turm"}),break_string(
  "Von hier aus ist kein Turm zu sehen."
,78));
AddDetail(({"stein","steine"}),break_string(
  "Die Burgmauer, somit auch der Gang, ist aus Steinen gemauert."
,78));



AddExit("osten",ROOM("06_00.lpc"));
AddExit("westen",ROOM("04_00.lpc"));
}
