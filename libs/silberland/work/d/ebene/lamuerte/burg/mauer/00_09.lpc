inherit "/d/ebene/lamuerte/burg/mauer/mauerraum";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Ein Turm");
  SetProp(P_INT_LONG,
        "Du befindest Dich im nordwestlichen Aussichtsturm der Burg Kyranda. Von hie"
        "r aus hat man eine wundervolle Aussicht auf das Silberland. Im Sueden und "
        "im Osten geht es geradeaus zu den naechsten Tuermen.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));

  AddDetail(({"turm","aussichtsturm"}),
        "Ein kleiner Turm welcher aus Steinen gebaut ist. Ein Tisch und ein Sessel s"
        "tehen hier. Wahrscheinlich fuer die Wachen.");
  AddDetail(({"tisch","sessel"}),
        "Eine wirklich robuste Holzkonstruktion.");
  AddDetail(({"holzkonstruktion"}),
        "Ein Tisch und ein Sessel.");
  AddDetail(({"steine","stein"}),
        "Die Steine fuehlen sich kuehl an.");
  AddDetail(({"wache","wachen"}),
        "Sie beseitigen unerwuenschte Eindringlinge.");
  AddDetail(({"burg"}),
        "Diese Burg wurde vor langer Zeit von den Kyrandern erbaut.");
  AddDetail(({"kyrander","kyrandern"}),
        "Ein nettes Voelkchen.");
  AddDetail(({"aussicht","silberland"}),
        "Eine wirklich sagenhafte Aussicht auf das Silberland.");

  AddSmell(DEFAULT_SMELL,"Du atmest die frische Luft ein.");
  AddSmell("luft","Die Luft hat keinen Duft.");
  AddSound(DEFAULT_SOUND,"Du hoerst die Buerger von Kyranda.");
  AddSound("buerger","Du hoerst die Buerger umhergehen.");

  AddItem(NPC("ogermage"),REFRESH_DESTRUCT);

  AddExit("suedunten",ROOM("00_08.lpc"));
  AddExit("ostunten",ROOM("01_09.lpc"));
  AddExit("sueden",ROOM("00_08.lpc"));
  AddExit("osten",ROOM("01_09.lpc"));

  SetProp(P_HIDE_EXITS, ({ "osten", "sueden" }));
}
