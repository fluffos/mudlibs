
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"In einer Hoehle");
  SetProp(P_INT_LONG,break_string(
    "Du stehst inmitten einer Drachenhoehle. Ringsum Dich ist ist alles "+
    "aus dunklem Gestein geformt. Ein riesiger Haufen an Stroh liegt in " +
    "der Mitte dieses unterirdischen Baus. Am Boden sind unzaehlige "+
    "Knochen zu sehen.",78));
  SetProp(P_LIGHT,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_INDOORS,1);
  AddSmell(DEFAULT_SMELL,break_string("Es ist aeusserst stickig.",78));
  AddSound(DEFAULT_SOUND,break_string("Ab und an hoerst Du lautes Fauchen.",78));
  AddSound("fauchen",break_string("Es hoert sich nicht gerade freundlich an.",78));

  AddDetail(({"stroh","haufen","strohhaufen"}),break_string(
    "Dieser riesige Haufen dient als Schlafstaette fuer einen Drachen.",78));
  AddDetail( ({"schlafstaette"}),
      "Ja, hier schlaeft der Drache.");
  AddDetail(({"drachenhoehle","hoehle"}),break_string(
    "Schwarzes Gestein umgibt Dich.",78));
  AddDetail(({"stein","steine","gestein"}),
    "Die Steine sind dunkelschwarz.\n");
  AddDetail(({"bau","baus"}),
    "Du fragst Dich wer wohl so grosse Loecher ins Gestein graebt.\n");
  AddDetail(({"loch","loecher"}),
    "Naja, LOCH war vielleicht ein wenig untertrieben...\n");
  AddDetail( ({"wand","waende","decke"}),
    "Scheint aus Stein geformt zu sein.\n");
  AddDetail("boden",
    "Viele Knochen liegen auf dem steinigen Boden.");
  AddDetail("knochen",
    "Ueberreste der letzten Helden, welche versucht haben den Drachen zu "+
    "erlegen.");
  AddDetail("helden",
    "Hoffentlich kommen sie bald um Dich zu unterstuetzen.\n"); 
  AddDetail("held",
    "Nein, Du bist wohl keiner von denen.\n");
 
  AddExit("oben",ROOM("drachenhoehle.lpc"));
  
  AddItem("/d/ebene/lamuerte/drachen/kyranda_drache.lpc",REFRESH_DESTRUCT);
}
