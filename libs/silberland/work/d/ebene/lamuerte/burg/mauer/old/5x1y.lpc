inherit "/d/ebene/lamuerte/burg/mauer/mauerraum";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Ein Turm.");
 SetProp(P_INT_LONG,break_string(
  "Du befindest Dich im nordwestlichen Aussichtsturm der Burg Kyranda. Von hie"+
  "r aus hat man eine wundervolle Aussicht auf das Silberland. Im Sueden und "+
  "im Osten geht es geradeaus zu den naechsten Tuermen."
,78));
AddSmell(DEFAULT_SMELL,break_string("Du atmest die frische Luft ein.",78));
AddSmell("luft",break_string("Die Luft hat keinen Duft.",78));
AddSound(DEFAULT_SOUND,break_string("Du hoerst die Buerger von Kyranda.",78));
AddSound("buerger",break_string("Du hoerst die Buerger umhergehen.",78));
SetProp(P_LIGHT,1);
SetProp(P_INDOORS,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
AddDetail(({"turm","aussichtsturm"}),break_string(
  "Ein kleiner Turm welcher aus Steinen gebaut ist. Ein Tisch und ein Sessel s"+
  "tehen hier. Wahrscheinlich fuer die Wachen."
,78));
AddDetail(({"tisch","sessel"}),break_string(
  "Eine wirklich robuste Holzkonstruktion."
,78));
AddDetail(({"holzkonstruktion"}),break_string(
  "Ein Tisch und ein Sessel."
,78));
AddDetail(({"steine","stein"}),break_string(
  "Die Steine fuehlen sich kuehl an."
,78));
AddDetail(({"wache","wachen"}),break_string(
  "Sie beseitigen unerwuenschte Eindringlinge."
,78));
AddDetail(({"burg"}),break_string(
  "Diese Burg wurde vor langer Zeit von den Kyrandern erbaut."
,78));
AddDetail(({"kyrander","kyrandern"}),break_string(
  "Ein nettes Voelkchen."
,78));
AddDetail(({"aussicht","silberland"}),break_string(
  "Eine wirklich sagenhafte Aussicht auf das Silberland."
,78));
AddItem("/d/ebene/lamuerte/wwald/npc/ogermage.lpc",REFRESH_REMOVE);
AddExit("suedunten",ROOM("6x1y.lpc"));
AddExit("ostunten",ROOM("5x3y.lpc"));
}
