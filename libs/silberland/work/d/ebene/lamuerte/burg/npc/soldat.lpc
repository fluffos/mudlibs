

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include <defines.h>
#include <moredef.h>
#include "files.h"
#include "soldaten.h"

inherit SOLDATEN_PATH "militaerperson";


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetMeUp(RANG_MASTER->GiveMeRank(RANG_CHARGE, TO));

   
   SetProp (P_MNPC_AREA, BURGMAUER(""));
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, BURGMAUER("10_05.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
   
}


