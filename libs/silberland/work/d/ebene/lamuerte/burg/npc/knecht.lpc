
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <npc.h>
#include "files.h"

create()
{ int zufall;
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Knecht");
  SetProp(P_LONG, "Ein einfach gekleideter Knecht. \n");
  SetProp(P_NAME, "Knecht");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  AddId(({"knecht"}));
  create_default_npc(14);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Haenden",130})); 
  SetProp(P_SMELL, "Der Knecht riecht nach Pferdmist.\n");


  SetProp( P_REJECT, REJECT_KEEP);

  AddInfo(DEFAULT_INFO, ({
   "sagt: Jaja, ich und meine Pferde. Ein wirklich gutes Gespann.\n",
   "wiehert laut.\n",
   "sagt: hast Du schon mal nen echten Drachen gesehen?\n",
   "sagt: Ja, da koenntest Du recht haben.\n",
   "sagt: Ach nein, hoer auf mir dauernd bloede Fragen zu stellen.\n",
   "sagt: Nein, davon hab ich noch nie was gehoert.\n" }) ); 
   
  AddInfo( ({"pferd", "pferde"}),
   "sagt: Ja, ich kann jedes Pferd reiten. Du auch?\n");
   
  AddInfo("reiten",
   "sagt: Versuchs doch einfach mal.\n");
   
  AddInfo( ({"drache" , "drachen"}),
   "sagt: Angeblich gibt es sogar in Kyranda einen Drachen.\n");
   
  AddInfo( "kyranda",
   "sagt: Hmm, Kyranda find ich einfach nett.\n");
}

