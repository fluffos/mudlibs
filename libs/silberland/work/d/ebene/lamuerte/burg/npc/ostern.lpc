
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <npc.h>
#include <defines.h>
#include "files.h"


object *enems=({});

void create()
{ 
  int zufall,azufall;
  object key;
  if (!is_clone(this_object())) return;

  ::create();       /* WICHTIG!!! */

  SetProp(P_SHORT, "Herbert Ostern");
  SetProp(P_ARTICLE,0);
  SetProp(P_LONG, 
      "Ostern sieht wirklich blutruenstig aus. Viele Narben zeichnen sein Gesicht.\n"+
      "Seine breiten Schultern lassen Dich klein und schwach aussehen. Hoffentlich\n"+
      "ist er gut gelaunt und toetet Dich nicht.\n");
  SetProp(P_NAME, "Herbert Ostern");
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 195);
  SetProp(P_GENDER, MALE);
  AddId(({"ostern","wache","herbert"}));
  create_default_npc(30);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem Schwert",500})); 
  SetProp(P_SPELLRATE,50);

  zufall=random(6);
  azufall=random(10);
  seteuid(getuid(this_object()));
  clone_object("/p/weapon/sword/bihaender")->move(this_object());
  command("zuecke schwert");

  key=clone_object(OBJ("turmkey.lpc"));
  key->setcol("silberner"); 
  key->move(this_object());

  if (zufall==0)  
    clone_object("/p/armour/armour/kettenhemd")->move(this_object());
  else if (zufall==1)
    clone_object("/p/armour/trousers/kettenhose")->move(this_object());
  else if (zufall==2)  
    clone_object("/p/armour/boots/kampfstiefel")->move(this_object());
  else if (zufall==3)  
    clone_object("/p/armour/gloves/titanhandschuhe")->move(this_object());
  else if (zufall==4)  
    clone_object("/p/armour/helm/titanhelm")->move(this_object());
  else if (zufall==5)  
    clone_object(OBJ("titanring.lpc"))->move(this_object());
  if (zufall!=2)
  {
    if (azufall==5)  
      clone_object(OBJ("osternstiefel.lpc"))->move(this_object());
  }
  command("ziehe alles an");

  SetProp( P_REJECT, REJECT_KEEP);


  AddInfo( DEFAULT_INFO,"sagt: Lass mich in Ruhe, oder ich toete Dich!\n"+
      "Ich hab genug zu tun in meinem Turm. Jaja, der Turm ist schon was ganz\n"+
      "besonderes.\n");   

  AddInfo(({"herbert","ostern"}),
      "sagt: Wir sind schon seit Generationen Waechter des Ostturms. Noch Fragen??\n");

  AddInfo(({"turm", "ostturm"}),"@@tfunc@@");

  AddSpell(1,500+random(600),
      " Herbert zerfleischt Dich mit lautem Geschrei.\n",
      " Herbert atomisiert @WEN.\n",DT_SLASH );
}

string tfunc()
{
  enems+=({this_player()});
  call_out("stups",1);
  return ("sagt: Geh! Ich will Dich nicht mehr sehen.\n");
}

void stups()
{
  write("Herbert Ostern wirft Dich aus dem Turm.\n");
  if (random(100)>=50)
    this_player()->move("/d/ebene/lamuerte/burg/mauer/10_08",M_GO);
  else 
    this_player()->move("/d/ebene/lamuerte/burg/mauer/09_09",M_GO);
}

void init()
{
  ::init(); 
  if(this_player()->QueryProp(P_GHOST)>=1)
  {
    write(
        "Ostern verwandelt Dich zurueck in ein Lebewesen. Du bist jetzt\n"+
        "wieder unter den Lebenden.\n");
    this_player()->SetProp(P_GHOST,0);
    write("Ostern sagt: So, jetzt kannst wieder sterben! Hahaha!\n");
    Kill(this_player());
  }  
  if (member_array(this_player(),enems)!=-1)
  {
    write("Ostern sagt: Stirb "+this_player()->QueryProp(P_NAME)+"!!!\n");
    Kill(this_player());
  }
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("iss leiche");
  write_file("/d/ebene/lamuerte/burg/log/ostern.log",ctime()+
      ": Herbert Ostern hat gerade "+
      player->QueryProp(P_NAME)+" umgebracht.\n");
}

