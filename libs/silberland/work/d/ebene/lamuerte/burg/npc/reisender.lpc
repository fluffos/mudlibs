
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Reisender");
  SetProp(P_LONG, "Ein Reisender, welcher in Kyranda Kraft tankt.\n");
  SetProp(P_NAME, ({ "Reisender", "ADJECTIVE" }) );
  SetProp(P_GENDER, MALE);
  AddId(({"reisender","urlauber"}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  create_default_npc(11);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem Fuss",100})); 
  set_living_name("reisender");
  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT,random(2000)+100);
  ob->move(this_object());

 
   SetProp (P_MNPC_AREA, BURGWEG(""));
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, BURGWEG("16x6y.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES);

   SetChats(5,({
    "Der Reisende sagt: Entschuldigung, wo ist hier der Kraeuterladen?\n",
    "Der Reisende sagt: Wie komm ich bloss nach Midas?\n",
    "Der Reisende sagt: Kann man hier irgendwo ein Bier bekommen?\n",
    "Der Reisende sagt: Wo war gleich die Pferdegasse?\n",
    "Der Reisende sagt: Mann, ich kenn mich hier ueberhaupt nicht aus.\n",
    "Der Reisende sagt: Wann geht die naechste Kutsche zum Ogerwald?\n",
    "Der Reisende sagt: Entschuldigung, kannst Du mir zeigen wo der Silberwald ist?\n"
    })); 
   
   

}


  
