mixed *QueryRank(int rang) 
{
  return ({ rang, raenge[rang,0],raenge[rang,1],raenge[rang,2],
            raenge[rang,3],raenge[rang,4] }); 
}


int typfilter(int key, string suchtyp)
{
  return (raenge[key,2]==suchtyp);
}


mixed *GiveMeRank(string typ, object wer)
{
  mapping untertyp;
  int rang;

  untertyp=filter_mapping(raenge,#'typfilter,typ);
  rang=m_indices(untertyp)[random(sizeof(untertyp))];
//STAHL_DB("Rang = "+rang);
//STAHL_DB(sprintf("%O",untertyp));


  return QueryRank(rang);
}

int QueryMaxLevel() {   return sizeof(m_indices(raenge));  }


string QueryKoerperbau(int rang)
{
  return koerperbau[random(sizeof(koerperbau))];
}

int QueryGroesse(int rang)
{
  return (164+random(36));
}

string QueryGroesseString(int num)
{
  return groesse[(num-164)/6];
}

string QueryMerkmal(int rang)
{
  return merkmal[random(sizeof(merkmal))];
}

string QueryHaarfarbe(int rang)
{
  return haarfarbe[random(sizeof(haarfarbe))];
}

