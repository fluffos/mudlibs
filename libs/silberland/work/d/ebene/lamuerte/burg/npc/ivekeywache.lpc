inherit SOLDATEN_PATH "militaerperson";


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetMeUp(RANG_MASTER->GiveMeRank(RANG_UO, TO));

  clone_object(OBJ("ntorkey.lpc"))->move(this_object());

  AddId(({"\nivekeywache"}));
 
}


