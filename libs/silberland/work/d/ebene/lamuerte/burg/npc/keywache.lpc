

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include <defines.h>
#include <moredef.h>
#include "files.h"
#include "soldaten.h"

inherit SOLDATEN_PATH "militaerperson";


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  if(random(10)>4)
    SetMeUp(RANG_MASTER->GiveMeRank(RANG_UO, TO));
  else
    SetMeUp(RANG_MASTER->GiveMeRank(RANG_CHARGE, TO));

  AddId(({"\nkeywache"}));
      
}


