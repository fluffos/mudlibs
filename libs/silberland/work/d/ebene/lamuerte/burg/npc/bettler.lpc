
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include <defines.h>
#include <moredef.h>
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Bettler");
  SetProp(P_LONG, "Ein Better, der hier um etwas Geld bittet.\n");
  SetProp(P_NAME, "Bettler");
  SetProp(P_GENDER, MALE);
  AddId(({"bettler"}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  create_default_npc(10);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Haenden",130})); 

  SetChats(10,({
   "Der Bettler sagt: Ich bin ein armer, alter Mann.\n",
   "Der Bettler fragt: Eine kleine Spende bitte?\n",
   "Der Bettler fragt: Habt ihr denn gar nichts fuer mich?\n",
   "Der Bettler sagt: Brrrr.. Ist mir kalt.\n",
   "Der Bettler fragt: Habt ihr etwas Geld fuer mich?\n"
   }));

  // Ruestung
  seteuid(getuid(this_object()));
  clone_object(OBJ("umhang.lpc"))->move(this_object());
  command("ziehe alles an");

  SetProp( P_REJECT, REJECT_KEEP);

  // 01.10.2020 - Gwenshara: Fuer die Bardengilde
  AddInfo( ({"prinz", "prinzen"}),
    "Einen Prinzen habe ich schon lange nicht mehr getroffen...",
    "sagt: "
  );

  AddInfo( ({"leben"}),
    "Mein Leben liegt schon lang zurueck.... Frueher habe ich am Schlachtfeld gegen "
    "die Orks gekaempft. Das weiss ich noch. Aber meine Herkunft liegt sogar fuer mich "
    "schon fast im Dunkel des Vergessens",
    "jammert: "
  );

  AddInfo( ({"schlachtfeld"}),
    "Ein grausamer Ort. Gefaehrlich. Brutal. Niemand verlaesst es so, wie er es betreten "
    "hat...",
    "sagt: "
  );

  AddInfo( ({"orks", "ork"}),
    "Orks sind gefaehrliche Kreaturen. Sie scheuen nicht davor zurueck uns abzuschlachten!",
    "sagt: "
  );

  AddInfo( ({"herkunft", "hintergrund"}),
    "Ich glaube, ich war frueher einmal ein Baeckersgeselle. Aber das Schlachtfeld hat mich"
    "an Koerper und Geist veraendert...",
    "seiert: "
  );

  AddInfo( ({"baecker", "baeckergeselle", "geselle", "baeckerei"}),
    "Damals, als es in Midas noch eine Baeckerei gab!",
    "sagt: "
  );

  AddInfo( ({"midas"}),
    "Das ist eine grosse Stadt, in der sich alle Helden der Welt treffen... Hast du vielleict "
    "etwas Kleingeld fuer mich?",
    "sagt: "
  );

}
give_notify(object obj) {
  mixed vars;
  object item;
  if(obj->id("muenzen")) {
   if((item=present("\npaladintaskitem", TP)) && item->GetTask(2, TP))
    {
     vars=item->GetVar();
     if(!mappingp(vars)) vars=([]);
     if(!member(vars, "bettler1")) vars+=(["bettler1":0]);
     vars["bettler1"]+=obj->QueryProp(P_AMOUNT);
     if(vars["bettler1"]>=3000) 
       item->SetFlag(1);
     item->SetVar(vars);
   }  
   say(BS("Der Bettler bedankt sich herzlich und versteckt "
        +"die Muenzen sofort!"));
   obj->remove();
  }
  ::give_notify(obj);
}
