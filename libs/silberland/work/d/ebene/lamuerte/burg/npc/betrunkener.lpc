
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Betrunkener");
  SetProp(P_LONG, "Ein ziemlich betrunkener Betrunkener.\n");
  SetProp(P_NAME, ({"der Betrunkene", "des Betrunkenen", "dem Betrunkenen",
   "den Betrunkenen"}) );
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE);
  AddId(({"betrnk","betrunkener"}));
  create_default_npc(12);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seiner Bierflasche",100})); 

  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT,random(1000)+100);
  ob->move(this_object());
  clone_object(OBJ("bier.lpc"))->move(this_object());
 
   SetProp (P_MNPC_AREA, BURGWEG(""));
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, BURGWEG("16x6y.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES);

   SetChats(5,({
    "Der Betrunkene sagt: Holllaaadriiioooo!\n",
    "Der Betrunkene sagt: Ist mir schlecht!\n",
    "Der Betrunkene sagt: Auf zum naechsten Bier!\n",
    "Der Betrunkene sagt: Aji aji aji ajii, die Goass is weg!\n",
    "Der Betrunkene sagt: Es gibt kein Bier auf Hawaii, es gibt kein Biiier.\n",
    "Der Betrunkene sagt: Wo is denn hier das Klo? Ich muss kotzen.\n",
    "Der Betrunkene fragt: Trinkst Du noch ein Bier mit?\n"
    })); 
}

_query_alcohol() { return 100; }
  
