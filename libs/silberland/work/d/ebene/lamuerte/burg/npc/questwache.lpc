//Irgendwie braucht man nen Wachkommandanten fuer die Rasende Reporter Quest, und da ich die geaenderten files net
//editieren darf (meine), hab ich mal den hier wieder reinghaengt.

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{ int zufall,azufall;
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Wachkommandant");
  SetProp(P_LONG, "Der Wachkommandant der Wache von Kyranda.\n");
  SetProp(P_NAME, "Wachkommandant");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  AddId(({"kommandant","wachkommandant"}));
  create_default_npc(20);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem Schwert",150})); 


  zufall=random(6);
  azufall=random(10);
  seteuid(getuid(this_object()));
  clone_object("/p/weapon/sword/langschwert")->move(this_object());
  command("zuecke schwert");
  if (zufall==0)  
   {clone_object("/p/armour/armour/kettenhemd.lpc")->move(this_object());
   }  
  if (zufall==1)
   {  clone_object("/p/armour/trousers/kettenhose.lpc")->move(this_object());
   }  
  if (zufall==2)  
  { clone_object("/p/armour/boots/kampfstiefel.lpc")->move(this_object());
  }
  if (zufall==3)  
  {clone_object("/p/armour/gloves/titanhandschuhe.lpc")->move(this_object());
  }
  if (zufall==4)  
  {clone_object("/p/armour/helm/titanhelm.lpc")->move(this_object());
  }
  if (zufall==5)  
  {clone_object(OBJ("titanring.lpc"))->move(this_object());
  }
  if (azufall==5)  
  {clone_object(OBJ("smaragtamulett.lpc"))->move(this_object());
  }
  command("ziehe alles an");

  SetProp( P_REJECT, REJECT_KEEP);

   SetProp (P_MNPC_AREA, "/d/ebene/lamuerte/burg/mauer");
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, "/d/ebene/lamuerte/burg/mauer/16x6y.lpc");
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES);
   
}

