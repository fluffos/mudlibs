// ~(w) Lamuerte 2001
// ~Sarnak's / Burggraben 
// ~Pfad:   /d/ebene/lamuerte/burg/npc/sarnak.c
// ~Level:  
// Sarnak 1 - 3    Neuling
// Sarnak 4 - 6    Brutling
// Sarnak 7 - 9    Raeuber
// Sarnak 10 - 12  Kurier
// Sarnak 13 - 15  Anhaenger
// Sarnak 16 - 18  Knarsch
// Sarnak 19 - 21  Legionaer
// Sarnak 22 - 24  Dragoner
// Sarnak 25 - 27  Ritter
// Sarnak 28 - 30  Orakel
// Sarnak 31 - 33  Juwelenorakel
// ~Hands:  15*lvl,DT_BLUDGEON  WC: default AC: default 
// ~Spells: Depends on Type/Level                  
// ~R.Str:  Depends on Type/Level

inherit "std/mnpc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <wizlevels.h>

string *stypes=({"Platzhalter",
    "Neuling","Brutling","Raeuber","Kurier","Anhaenger",
    "Knarsch","Legionaer","Dragoner","Ritter","Orakel","Juwelenorakel"});

create()
{
  if (!is_clone(this_object())) return;
::create(); 
  
  enable_commands();
  SetProp(P_SHORT, "Ein Sarnak");
  SetProp(P_LONG, 
  "Vor Dir waechst ein grosser Sarnak aus dem Boden. Dieses Ungetuem hat einen echsenfoermigen Koerper, "+
  "jedech geht es aufrecht auf zwei in krallenbesetzten Fuessen endenden Beinen. An seinem Gesaess waechst ein "+
  "langer Schwanz und seinen duennen Armen befinden sich durnige Haende mit jeweils drei Fingern. Sein Kopf "+
  "erinner sehr an den einer Echse, und sein spitz zusammenlaufendes Maul ist mit scharfen Zaehnen uebersaeht.");

  SetProp (P_MNPC_AREA, "/d/ebene/lamuerte/burg/graben/");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_DEFAULTROOM,  
      file_name(interactive(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL + MOV_MAYLOAD);

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Sarnak");
  SetProp(P_RACE, "Riesenechse");
  SetProp(P_SIZE, 190+random(80));
  SetProp(P_GENDER, MALE);
  AddId(({"\ngrabennpc","sarnak"}));
  create_default_npc(6);
  SetProp(P_ALIGN, -210);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen messerscharfen Klauen",75,DT_RIP})); 
  SetProp(P_SPELLRATE,60);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");

  SetProp(P_DIE_MSG, " krepiert.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal und ich bringe Dich um!");
  SetProp(P_KILL_MSG, "Hehe, einer weniger.");

  SetProp( P_REJECT, REJECT_KEEP);
  call_out("do_init_sarnak",1,random(4)+random(5)+random(4)+1);
}


int do_init_sarnak(int type){
  float re;
  int level;
  object ob;
  level=(type*3)-random(3);
  create_default_npc(level);
  re=(to_float(level)/80);
  SetProp(P_SHORT, "Ein Sarnak "+stypes[type]);
  SetProp(P_KILL_NAME, "Ein Sarnak "+stypes[type]);
  AddId(lower_case(stypes[type]));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-re,     DT_BLUDGEON    :-re,     DT_PIERCE     :-re,
    DT_SQUEEZE    :-re,     DT_WHIP        :-re,     DT_RIP        :0.3,
    DT_FIRE       :-re,     DT_COLD        :0.3,     DT_WATER      :-re,    
    DT_AIR        :-re,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,level);
  SetProp(P_NAME,"Sarnak "+stypes[type]);
  
  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT,random(level*100)+10);
  ob->move(this_object());

  if(random(50)==25 && level>24){
  clone_object("/d/ebene/lamuerte/burg/obj/sarnakmaske.lpc")->move(this_object());  
  write_file("/d/ebene/lamuerte/burg/npc/SARNAK_MASK.LOG",ctime()+
             "Drop: Sarnak Maske");
  }

  if(random(50)==25 && level>27){
  clone_object("/d/ebene/lamuerte/burg/obj/sarnakaxt.lpc")->move(this_object());  
  write_file("/d/ebene/lamuerte/burg/npc/SARNAK_AXE.LOG",ctime()+
             "Drop: Sarnak AXT");
  }

  if(random(1000)>200 && level>24){
    "/obj/gemmaster"->DistributeGem(3, type-6, 1, 1);
  }

  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  
  AddSpell(9, level+random(level*15),
     "  Ein Sarnak "+stypes[type]+" zerfleischt Dich mit seinen Krallen.\n",
     "  Ein Sarnak "+stypes[type]+" zerfleischt @WEN mit seinen Krallen.\n",DT_RIP );

  AddSpell(9, level+random(level*10),
     "  Ein Sarnak "+stypes[type]+" trifft Dich mit seinem Schwanz.\n",
     "  Ein Sarnak "+stypes[type]+" trifft @WEN mit seinem Schwanz.\n",DT_RIP );

 if(level>27){
 AddDefaultSpell(9,200,DS_PARALYZE,
       "  Ein Sarnak "+stypes[type]+" paralysiert Dich.\n",
       "  Ein Sarnak "+stypes[type]+" paralysiert @WEN.\n");
 }

 if(level>24){
  AddDefaultSpell(30,20,DS_POISON,
       "  Ein Sarnak "+stypes[type]+" vergiftet Dich.\n",
       "  Ein Sarnak "+stypes[type]+"vergiftet @WEN.\n");
 }
  
 return 1;
}

Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1 || member( dtype, DT_COLD ) != -1){
    if(random(100)>70) tell_room(environment(), "  Ein Sarnak saugt sich mit Energie an.\n");
    this_object()->AddHp(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
 return ::Defend(dam, dtype, spell, enemy);
}


void init()
{
  ::init();
  if (this_player() && interactive(this_player()))
    call_out("do_kill", 0, getuid(this_player()));
}

void do_kill(string who)
{
  object ob;
  string nm;
 
  
  if (!ob=find_player(who)) return;
  if (environment(ob) != environment()) return;
  if (who == "lamuerte"){
    return;
  }
  
  if (ob->QueryProp(P_INVIS)) {
    command_me("sag Hallo Jemand. *grins*");
    return;
  }

  if (IS_WIZARD(who)){
     //command_me("sag Hau ab "+capitalize(who)+", Spielerhilfe gilt nicht!");
     command_me("sag Kommt gehn wir "+capitalize(who)+" auf bloede Gedanken kommt.");
     return;
  }
  
  if(this_object()->QueryProp(P_LEVEL)<=17 && IS_SEER(who)){
   command_me("sag Lass mich ja in ruhe "+capitalize(who)+"!");
   return;
  }

  if(this_object()->QueryProp(P_LEVEL)>17 && ob->QueryProp(P_LEVEL)>this_object()->QueryProp(P_LEVEL) && IS_SEER(who)){
   command_me("sag "+capitalize(who)+" will uns vernichten, toetet ihn!");
   this_object()->Kill(ob); 
  }
  
  if (ob->QueryProp(P_GHOST)){
   command_me("sag "+capitalize(who)+" ich verwndle Dich von einem Geist in einen Lebenden!");
   command_me("sag Und jetzt stirb Du SAU!");
   ob->SetProp(P_GHOST,0);
   this_object()->Kill(ob);
  }

  if(ob->QueryProp(P_ALIGN)>800){
   command_me("sag "+capitalize(who)+" ist hier, alle auf ihn!");
   command_me("sag "+capitalize(who)+" stirb Du Ausgeburt des GUTEN!!!!");
   this_object()->Kill(ob); 
  }
  return;
}
