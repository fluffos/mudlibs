inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

object key;

create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Oger Magier");
  SetProp(P_LONG, "Der Oger Magier sieht wirklich gefaehrlich aus.\n"+
  "Er bewacht diesen Turm. Geh lieber schnell dort hin, von wo du gekommen\n"+
  "bist. Der Magier ist VIEL staerker als Du.\n");
  SetProp(P_NAME, "Oger Magier");
  SetProp(P_GENDER, MALE);
  AddId(({"oger","magier","ogermagier","oger magier", "Keulenexperte"}));
  create_default_npc(30,400);
  SetProp(P_ATTRIBUTES,(["int":40,"str":5,"con":40,"dex":20]));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit seinem Zauberstab",350}));
  SetProp(P_MAX_SP,200);
  SetProp(P_MAX_HP,250);
  SetProp(P_RACE, "Oger");
  SetProp(P_FOOD, 0); // tichtig hungrig zum leichenfressen....
  SetProp(P_SIZE, 200+random(100) );
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_KILL_NAME, "Ein boeser Oger Magier");
  SetProp(P_KILL_MSG, "hat seine Zauberkraefte demonstriert.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0]) );
  SetProp(P_SPELLRATE,80); //80% Spellrating->ist ja ein Magier 
  SetProp(P_DIE_MSG, " stirbt in einer magischen Explosion.\n");
  set_living_name("ogermage");

  // Ruestung
 
  seteuid(getuid(this_object()));

   key=clone_object(OBJ("turmkey.lpc"));
   key->setcol("schwarzer"); 
   key->move(this_object());
       
  
  clone_object("/p/armour/trousers/seidenhose")->move(this_object());
  clone_object("/p/armour/armour/seidenjacke")->move(this_object());
  if (random(100)<5) clone_object(OBJ("kamulett"))->move(this_object());
  clone_object("/p/armour/helm/magierkappe")->move(this_object());
  clone_object("/p/armour/boots/seidenschuhe")->move(this_object());

  command("trage alles");

  clone_object("/p/weapon/club/kampfstab")->move(this_object());
  command ("zuecke stab");

  SetProp( P_REJECT,
    ({ REJECT_KEEP, "Der Oger Magier steckt @WEN erfreut ein.\n" }) );

  AddSpell(1,200+random(100),
    "Der Oger Magier greift Dich mit dem Kampfstab an.\n",
    "Der Oger Magier greift @WEN mit einem Kampfstab an.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("iss leiche");
  write_file("/d/ebene/lamuerte/wwald/log/omage.log",ctime()+
             ": Der NPC hat gerade "+
             player->QueryProp(P_NAME)
             +" umgebracht.\n");
}

Defend(int dam,string *dam_type,mixed spell,object enemy)
{
 
 int rnd;
 int dt;
 
 dt=-1;
 
 if (random(100)>=80)
   {
    if((ME->QueryProp(P_SP))>=30)
    { 
     write("Der grausame Ogermagier heilt einige seiner Wunden.\n");
     ME->restore_spell_points(-10);
      if( (ME->QueryProp(P_HP)) <= (ME->QueryProp(P_MAX_HP)-40) )
         {
          ME->SetProp(P_HP,ME->QueryProp(P_HP)+30+random(10));
         }
    }
   }
   
 
 if (random(100)>=95)
   { 
    if((ME->QueryProp(P_SP))>=30)
    {
      write("Der grausame Ogermagier heilt sich.\n");
      ME->SetProp(P_HP,ME->QueryProp(P_MAX_HP));
      ME->restore_spell_points(-20);
    }
   }
   
 if (pointerp(dam_type)) dt=member_array("fire",dam_type);
  else 
 if (dam_type=="fire") dt=0;
  
 if(dt!=-1)
  {
    rnd=random(100);
   
    if (rnd>=90)
     {
      write("Der Oger Magier sagt: Hahaha! Laecherlich! Das kleine Feuerchen!\n");
      dam = 0;
     }
     dam=dam/4; //Naja, gegen Feuer is er halt geschuetzt....
  } 
  
 if(random(1000)>=998)
  {write("Der Magier haucht Dir den Tod ein.\n");
   this_player()->reduce_hit_point(random(150)+150);
  } 
 
 return ::Defend(dam,dam_type,spell,enemy);
}
