// ~Sarnak's / Burggraben 
// ~Pfad:   /d/ebene/lamuerte/burg/npc/sarnak.c
// ~Level:  
// Sarnak 1 - 3    Neuling
// Sarnak 4 - 6    Brutling
// Sarnak 7 - 9    Raeuber
// Sarnak 10 - 12  Kurier
// Sarnak 13 - 15  Anhaenger
// Sarnak 16 - 18  Knarsch
// Sarnak 19 - 21  Legionaer
// Sarnak 22 - 24  Dragoner
// Sarnak 25 - 27  Ritter
// Sarnak 28 - 30  Orakel
// Sarnak 31 - 33  Juwelenorakel
// Sarnak 34 - 36  Kriegsfuerst
// ~Hands:  15*lvl,DT_BLUDGEON  WC: default AC: default 
// ~Spells: Depends on Type/Level                  
// ~R.Str:  Depends on Type/Level

inherit "std/mnpc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <wizlevels.h>

string *stypes=({"Platzhalter",
    "Neuling","Brutling","Raeuber","Kurier","Anhaenger",
    "Knarsch","Legionaer","Dragoner","Ritter","Orakel","Juwelenorakel",
    "Kriegsfuerst"});

int *chances;

object freund;

void init()
{
  ::init();
  if (this_player() && interactive(this_player()) && !InFight()) 
  {
    say("Der Sarnak Kriegsfuerst WINKT MIT EINEM G R O S S E N ****ICH BIN JETZT STAERKER**** WAPPEN!\n");
    say("Der Sarnak Kriegsfuerst sagt: Bitte geh, ich muss Dich leider Angreifen!\n");
    say("Der Sarnak Kriegsfuerst sagt: "+capitalize(this_player()->QueryProp(P_NAME))+" so horch doch und lauf!\n");
    call_out("do_kill", 2, getuid(this_player()));
  }
 
  if( ((freund=present("orakel")) || (freund=present("juwelenorakel")))
      && !freund->QueryProp(P_PURSUERS) &&
     (!QueryProp(P_PURSUERS) || sizeof(QueryProp(P_PURSUERS)[1])<3 ) ) {
    say("Ein Sarnak Kriegsfuerst sagt: Folge mir Orakel!\n");
    freund->SetProp (P_MNPC_FLAGS, 0);
    freund->SetProp(P_MMSGOUT, "folgt seinem Kriegsfuerst");
    freund->SetProp(P_MSGOUT, "folgt seinem Kriegsfuerst");
    freund->SetProp(P_SHORT, 
        freund->QueryProp(P_SHORT)+
        ", es dient seinem Kriegsfuersten"
        );
    AddPursuer(freund);
   }
}


void create()
{
  if (!is_clone(this_object())) return;
  ::create(); 
  
  enable_commands();
  SetProp(P_SHORT, "Ein Sarnak");
  SetProp(P_LONG, 
  "Vor Dir waechst ein grosser Sarnak aus dem Boden. Dieses Ungetuem hat einen echsenfoermigen Koerper, "+
  "jedoch geht es aufrecht auf zwei in krallenbesetzten Fuessen endenden Beinen. An seinem Gesaess waechst ein "+
  "langer Schwanz und an seinen duennen Armen befinden sich dornige Haende mit jeweils drei Fingern. Sein Kopf "+
  "erinnert sehr an den einer Echse, und sein spitz zusammenlaufendes Maul ist mit scharfen Zaehnen uebersaeht, mit denen er oft an Baeumen knabbert.");

  SetProp (P_MNPC_AREA, "/d/ebene/lamuerte/burg/graben/");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_DEFAULTROOM,  
      file_name(interactive(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS + MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL + MOV_MAYLOAD);

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Sarnak");
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 190+random(80));
  SetProp(P_GENDER, MALE);
  AddId(({"\ngrabennpc","sarnak"}));
  create_default_npc(6);
  SetProp(P_ALIGN, -210);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen messerscharfen Klauen",75,DT_RIP})); 
  SetProp(P_SPELLRATE,60);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");

  SetProp(P_DIE_MSG, " krepiert.\n");
  SetProp(P_NOCORPSE, 0 );
  //SetProp(P_MURDER_MSG, "Komm nochmal und ich bringe Dich um!");
  SetProp(P_KILL_MSG, "Hehe, einer weniger.");

  SetProp( P_REJECT, REJECT_KEEP);

  chances=({0,1,3000,4200,4400});
  
  call_out("do_init_sarnak",1,12);
  seteuid(getuid(this_object()));
}


int do_init_sarnak(int type){
  float re;
  int level;
  object ob;
  string logfilename;

  level=(type*3)-random(3);
  create_default_npc(level);
  SetProp(P_HANDS, ({" mit seinen messerscharfen Klauen",QueryProp(P_HANDS)[1],DT_RIP})); 
  re=(to_float(level)/60);
  SetProp(P_SHORT, "Ein Sarnak "+stypes[type]);
  SetProp(P_KILL_NAME, "Ein Sarnak "+stypes[type]);
  AddId(lower_case(stypes[type]));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-re,     DT_BLUDGEON    :-re,     DT_PIERCE     :-re,
    DT_SQUEEZE    :-re,     DT_WHIP        :-re,     DT_RIP        :0.3,
    DT_FIRE       :-re,     DT_COLD        :-re,     DT_WATER      :0.1,    
    DT_AIR        :-re,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0.3, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,level);
  SetProp(P_NAME,"Sarnak "+stypes[type]);
  
  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT,random(level*100)+10);
  ob->move(this_object());

  if(random(100)>95 && level < 15)
  clone_object("/p/std/skills/sewing_tanning/obj/holz.lpc")->move(this_object());
  
  if(random(50)>=47 && level>24){
  clone_object("/d/ebene/lamuerte/burg/obj/sarnakmaske.lpc")->move(this_object());  
  write_file("/d/ebene/lamuerte/burg/log/SARNAK_MASK.LOG",ctime()+
             "Drop: Sarnak Maske\n");
  }

  else if(random(50)>=48 && level>27){
  clone_object("/d/ebene/lamuerte/burg/obj/sarnakumhang.lpc")->move(this_object());  
  write_file("/d/ebene/lamuerte/burg/log/SARNAK_CLOAK.LOG",ctime()+
             "Drop: Sarnak UMHANG\n");
  }
  
  
  if(random(100)>80)
  {
    SetProp(P_GUILD_LEVEL, 10);
    ob=clone_object("/d/ebene/lamuerte/burg/obj/sarnakaxt3.lpc");
    logfilename = "/d/ebene/lamuerte/burg/log/SARNAK_AXE.LOG";
    write_file(logfilename,ctime()+ "Drop: Super Sarnak AXT\n");
  }
  else 
  {
    if(random(100)>70)
    {
      ob=clone_object("/d/ebene/obj/waffe/mithrilschwert.lpc");
      logfilename = "/d/ebene/lamuerte/burg/log/SARNAK_SWORD.LOG";
      write_file(logfilename,ctime()+ "Drop: Sarnak MITHRILSCHWERT");
    }
    else if (random(100)>50)
    {
      ob=clone_object("/p/weapon/sword/bastardschwert.lpc");
      logfilename = "/d/ebene/lamuerte/burg/log/SARNAK_SWORD.LOG";
      write_file(logfilename,ctime()+ "Drop: Sarnak SCHWERT");
    }
    else
    {
      ob=clone_object("/d/ebene/lamuerte/burg/obj/sarnakaxt2.lpc");
      logfilename = "/d/ebene/lamuerte/burg/log/SARNAK_AXE.LOG";
      write_file(logfilename,ctime()+ "Drop: Sarnak AXT");
    }
    if(random(7) && find_object(ITEMD))
    {
      catch(find_object(ITEMD)->identify(ob,-1,51,51,chances,1));
      write_file(logfilename, "(magisch)\n");
    }
    else
      write_file(logfilename, "\n");
  }
  ob->move(this_object(),M_NOCHECK);
  ob->SetProp (P_WC_BONUS, ([ "sarnak" : 1000 ]) );

  command_me("zuecke axt");
  command_me("zuecke schwert");
  
  if(random(1000)>200 && level>24){
    "/obj/gemmaster"->DistributeGem(3, type-6, 1, 1);
  }

  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  
  AddSpell(9, 6*level+random(level*10),
     "  Ein Sarnak "+stypes[type]+" zerfleischt Dich mit seinen Krallen.\n",
     "  Ein Sarnak "+stypes[type]+" zerfleischt @WEN mit seinen Krallen.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(9, 5*level+random(level*7),
     "  Ein Sarnak "+stypes[type]+" trifft Dich mit seinem Schwanz.\n",
     "  Ein Sarnak "+stypes[type]+" trifft @WEN mit seinem Schwanz.\n",
     DT_WHIP, ([SP_SHOW_DAMAGE:1]) );

 if(level>27){
 AddDefaultSpell(1,2,DS_PARALYZE,
       "  Ein Sarnak "+stypes[type]+" paralysiert Dich.\n",
       "  Ein Sarnak "+stypes[type]+" paralysiert @WEN.\n");
 }

 if(level>24){
  AddDefaultSpell(30,20,DS_POISON,
       "  Ein Sarnak "+stypes[type]+" vergiftet Dich.\n",
       "  Ein Sarnak "+stypes[type]+" vergiftet @WEN.\n");
 }
 
 if(level>33){
   AddDefaultSpell(1, 600, DS_MASS_BLIND,
       "  Ein Sarnak "+stypes[type]+" zertruemmert deinen Schaedel.\n",
       "  Ein Sarnak "+stypes[type]+" zertruemmert deinen Schaedel.\n");
 }

 
 return 1;
}

Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1 || member( dtype, DT_COLD ) != -1){
    if(random(100)>70) tell_room(environment(), "  Ein Sarnak saugt sich mit Energie an.\n");
    this_object()->AddHp(dam/10);
    return ::Defend(0, dtype, spell, enemy);
  }
 return ::Defend(dam, dtype, spell, enemy);
}



void do_kill(string who)
{
  object ob;
  string nm;
 
  
  if (!ob=find_player(who)) return;
  if (environment(ob) != environment()) return;
  if (who == "lamuerte"){
    return;
  }
  
  if (ob->QueryProp(P_INVIS)) {
    command_me("sag Hallo Jemand. *grins*");
    return;
  }

  if (IS_WIZARD(who)){
     //command_me("sag Hau ab "+capitalize(who)+", Spielerhilfe gilt nicht!");
     command_me("sag Kommt gehn wir, bevor "+capitalize(who)+" auf bloede Gedanken kommt.");
     command_me(m_indices(environment(ob)->QueryProp(P_EXITS))[random(2)]);
     return;
  }
  
  if(this_object()->QueryProp(P_LEVEL)<=9 && IS_SEER(who)){
   command_me("sag Lass mich ja in Ruhe "+capitalize(who)+"!");
   command_me(m_indices(environment(ob)->QueryProp(P_EXITS))[random(2)]);
   return;
  }

  if(this_object()->QueryProp(P_LEVEL)>9 && ob->QueryProp(P_LEVEL)>this_object()->QueryProp(P_LEVEL) && IS_SEER(who)){
   command_me("sag "+capitalize(who)+" will uns vernichten, toetet "+ob->QueryPronoun(WESSEN)+"!");
   this_object()->Kill(ob); 
  }
  
  if (ob->QueryProp(P_GHOST)){
   command_me("sag "+capitalize(who)+" ich verwandle Dich von einem Geist in einen Lebenden!");
   command_me("sag Und jetzt stirb Du SAU!");
   ob->SetProp(P_GHOST,0);
   this_object()->Kill(ob);
  }

  if(ob->QueryProp(P_ALIGN)>800){
   command_me("sag "+capitalize(who)+" ist hier, alle auf "+ob->QueryPronoun(WEN)+"!");
   command_me("sag "+capitalize(who)+" stirb Du Ausgeburt des GUTEN!!!!");
   this_object()->Kill(ob); 
  }
  return;
}

void die(int poisondeath)
{
  object spieler, ob;
  spieler=this_object()->QueryProp(P_KILLER);
  write_file("/d/ebene/lamuerte/burg/npc/SARNAK_KRIEGSHERR_KILLED.LOG",
             ctime()+": "+capitalize(getuid(this_player()))+
             " killte: "+this_object()->QueryProp(P_SHORT)+"\n");
            
  ::die(poisondeath);
}

int counter=0;

void reset()
{
  ::reset();
  if( counter++>20)
  {
    move("/room/npcasylraum", M_TPORT);
    call_out("remove", 4);
  }
}
