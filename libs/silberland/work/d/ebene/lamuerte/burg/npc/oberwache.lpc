

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include <defines.h>
#include <moredef.h>
#include "files.h"
#include "soldaten.h"

inherit SOLDATEN_PATH "militaerperson";


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  if (random(100)>=90)
    SetMeUp(RANG_MASTER->GiveMeRank(RANG_GENERAL, TO));
  else
    SetMeUp(RANG_MASTER->GiveMeRank(RANG_OFFIZIER, TO));
    

   SetProp (P_MNPC_AREA, BURGWEG(""));
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, BURGWEG("16x6y.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES);
}


