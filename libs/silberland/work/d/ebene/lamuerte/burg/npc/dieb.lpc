inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"
#include <moredef.h>
#include <defines.h>


object key;

create()
{
  object dolch;
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Dieb");
  SetProp(P_LONG, 
  "Der Dieb beherrscht sein Handwerk meisterhaft. Wenn er sich versteckt, \n"+
  "ist er beinahe unsichtbar. Seine Attacken sind nicht zu unterschaetzen.\n"+
  "Er wurde als Waechter fuer diesen Turm eingestellt. Besser man laesst \n"+
  "ihn seine Arbeit tun.\n");
  SetProp(P_NAME, "Dieb");
  SetProp(P_GENDER, MALE);
  AddId(({"dieb","meisterdieb"}));
  create_default_npc(28);
  SetProp(P_ATTRIBUTES,(["int":10,"str":15,"con":25,"dex":35]));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit seinen Haenden",400}));
  SetProp(P_MAX_SP,200);
  SetProp(P_MAX_HP,440);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(40) );
  SetProp(P_KILL_NAME, "Ein Meisterdieb");
  SetProp(P_KILL_MSG, "hat seine Klinge spielen lassen.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0]) );
  SetProp(P_SPELLRATE,50);
  SetProp(P_MSGIN,"tritt aus Deinem Schatten hervor");
  set_living_name("meisterdieb");

  // Ruestung
 
  seteuid(getuid(this_object()));

  key=clone_object(OBJ("turmkey.lpc"));
  key->setcol("weisser"); 
  key->move(this_object());
      
  
  clone_object("/p/armour/boots/kampfstiefel")->move(this_object());
  clone_object("/p/armour/trousers/kettenhose")->move(this_object());

  command("trage alles");
  // 16.06.1999 Aenderung von Angrox: Dolch geht ueber itemd  
  if(!random(10) && 
      objectp(dolch=find_object(ITEMD)->GenerateUnique(OBJ("dolch"),1)))
   {
     dolch->move(TO);
   }
   else
    clone_object(OBJ("dolch_normal"))->move(this_object());  
 
  command ("zuecke dolch");

  SetProp( P_REJECT,
    ({ REJECT_KEEP, "Der Dieb nimmt @WEN an sich.\n" }) );

  AddSpell(1,600+random(200),
    "  Der Dieb rammt Dir seinen Dolch in den Ruecken.\n",
    "  Der Dieb rammt @WEN einen Dolch in den Ruecken.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("lache");
  write_file("/d/ebene/lamuerte/burg/log/dieb.log",ctime()+
             ": Der Dieb hat gerade "+
             player->QueryProp(P_NAME)+
             " umgebracht.\n");
}

Defend(int dam,mixed *dam_type,mixed spell,object enemy)
{
  if( !spell || (spell && mappingp(spell) && spell[SP_PHYSICAL_ATTACK]) )
  {
    if( random(QueryAttribute(A_DEX)) > enemy->QueryAttribute(A_DEX))
    {
      tell_object(enemy," Der Dieb weicht Deiner Attacke aus.\n");
      dam = 0;
    }
  } 
  return ::Defend(dam,dam_type,spell,enemy);
}

void die(int poisondeath) {
  object item;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(7, TP))
    item->SetFlag(0);
  ::die(poisondeath);
}


