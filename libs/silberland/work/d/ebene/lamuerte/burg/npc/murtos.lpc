inherit "std/repair";
inherit "std/npc/compare";

#include <properties.h>
#include <combat.h>
#include <moving.h>

void create()
{
  if (!is_clone(this_object())) return;

  repair::create(3,0);
  compare::create(753);

   SetProp(P_SHORT, "Murtos Gieros, der Waffenexperte");
   SetProp(P_LONG, 
     "Vor Dir steht Murtos Gieros, der Waffenexperte. Er ist selbst fuer "
     "einen Menschen sehr klein und hat kahlgeschorene Haare, weil wer wohl "
     "zu geizig fuer einen Friseur ist. Er kennt sich bei allen "
     "Waffen extrem gut aus, und kann sie sogar reparieren."); 

  AddId( ({ "murtos","gieros","mensch", "experte", "waffenexperte",
        "murtos gieros"}) );

  create_default_npc(25);

  SetProp(P_NAME, "Murtos Gieros"); 
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinem Expertenschwert", 200, DT_SLASH}) );
  SetProp(P_SIZE, 160);
  SetProp(P_NOATTACK, "haelt Dir sein gewaltiges Schwert an die Kehle.\n"
      "Du gibst freiwillig auf.");

  SetProp(P_REJECT, ({ REJECT_KEEP,
    "Murtos Gieros sagt: Gib mir noch mehr!\n" }) );

  SetProp(P_LOG_INFO,"lamuerte/murtos");
  AddInfo(DEFAULT_INFO, ({
    "sagt: Miysu zude gkhreay!\n",
    "sagt: Fezulos gorrama nixus Dere!\n",
    "sagt: Hugi noome erutsi zumm Goo!\n",
    "sagt: Allo Esto ixi!\n",
    "sagt: Uninteressant!\n",
    "sagt: Kennst Du die geheime Sprache der Waffenexperten?\n",
    "sagt: Das brauche ich als Waffenexperte nicht zu wissen.\n",
    "sagt: Was genau willst Du denn wissen, hmm...?\n" }) );

  AddInfo( ({"reparatur", "reparieren", "repariere"}),
    "Wenn Du willst, kann ich Deine Waffen reparieren. Gib "
    "dazu einfach 'repariere <name>' ein. Das kostet Dich aber viel Geld. "
    "Hahahahaha.", "sagt: ");
  AddLibrary( "/d/dschungel/feyaria/tijara/npc/material.lib",1);


  seteuid(getuid(this_object()));
  clone_object( "/p/weapon/sword/langschwert")->move(this_object(), M_NOCHECK);
  present("schwert")->SetProp(P_NAME, "Expertenschwert");
  present("schwert")->SetProp(P_SHORT, "Das meisterliche Expertenschwert");
  command( "zuecke schwert" );

}

int rep_auswahl(object ob)
{
  if (!ob->QueryProp(P_WEAPON_TYPE))
  {
    write("Murtos Gieros sagt: Ich repariere nur Waffen!\n");
    return 0;
  }
  if (ob->QueryProp(P_MAGIC) || 
      sizeof(ob->QueryProp(P_DAM_TYPE) & m_indices(MAGICAL_DAMAGE_TYPES)) )
  {
    this_player()->Message(break_string("Diese Waffe ist magisch, ich darf sie "
          "nach dem Magiewaffensperrvertrag von Kyranda nicht reparieren. "
          "Du musst sogar einen Verwaltungsbeitrag von 753 Muenzen bezahlen, "
          "um diese Waffe in Kyranda zu verwenden!", 
          78, "Murtos Gieros sagt: "), MSGFLAG_SAY);
    this_player()->AddMoney(-753);
    return 0;
  }
  if (ob->QueryProp("waffenbalsam"))
  {
    this_player()->Message(break_string("Diese Waffe wurde mit Waffenbalsam "
          "behandelt! Das kraenkt mich in meiner Berufsehre! Ich weigere mich "
          "daher, sie zu reparieren! Reparier sie nur weiterhin mit "
          "Waffenbalsam, Du brauchst mich ja eh nicht *schmoll*",
          78, "Murtos Gieros sagt: "), MSGFLAG_SAY);
    return 0;
  }
  return 1;
}

