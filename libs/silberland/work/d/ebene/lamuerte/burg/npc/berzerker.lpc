void die(int poisondeath)
{
  object ob;
  object enemy;
  
  if(ob=present("\nberserker_willenskraft",this_object()))
    ob->remove();

  if (enemy = QueryProp(P_KILLER) || this_player()) {
    if (ob = present("\nzechpreller_quest_11", enemy)) {
      ob->Mark(poisondeath);
    }
  }

  if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
    ob->Mark();
  }

  ::die(poisondeath);
}
