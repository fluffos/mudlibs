inherit "/p/std/npc/berserker_npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "files.h"

object key;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Berzerker");
  SetProp(P_LONG, 
  "Du siehst einen riesigen Troll vor Dir. Er ist mehr als doppelt so gross\n"+
  "wie Du. Sein Job ist es, diesen Turm zu bewachen. Er sieht nicht gerade\n"+
  "freundlich aus, besser Du verschwindest hier.\n");
  SetProp(P_NAME, "Berzerker");
  SetProp(P_GENDER, MALE);
  AddId(({"troll","berzerker", "Axtkaempfer"}));
  create_default_berserker(30, 6);
  SetProp(P_ATTRIBUTES,(["int":15,"str":50,"con":45,"dex":40]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit seinen grossen Klauen",400, DT_BLUDGEON}));
  SetProp(P_RACE, "Troll");
  SetProp(P_FOOD, 0); // richtig hungrig zum leichenfressen....
  SetProp(P_SIZE, 300+random(100) );
  SetProp(P_KILL_NAME, "Ein schraecklicher Berzerker");
  SetProp(P_KILL_MSG, "hat seine Todesaxt geschwungen.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0]) );
  SetProp (P_RESISTANCE_STRENGTHS, ([ DT_FIRE:0.7, DT_LIGHT:-0.5])  );


  // Ruestung
 
  seteuid(getuid(this_object()));
  
  key=clone_object(OBJ("turmkey.lpc"));
  key->setcol("goldener"); 
  key->move(this_object());
      
  clone_object("/p/armour/boots/kampfstiefel")->move(this_object());
  clone_object(OBJ("trollschienen"))->move(this_object());
  clone_object("/p/armour/trousers/kettenhose")->move(this_object());

  command("trage alles");

  if( random(3) )
    clone_object("/p/weapon/axe/stabaxt")->move(this_object());
  else
    clone_object(OBJ("todesaxt"))->move(this_object());
  command ("zuecke axt");

  SetProp( P_REJECT,
    ({ REJECT_KEEP, "Der Berzerker reisst @WEN an sich.\n" }) );

  SetProp(P_SPELLRATE, 25);
  AddSpell(4,666,
    " Der Berzerker atomisiert Dich im Kampfrausch.\n",
    " Der Berzerker atomisiert @WEN.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(1, 100, DS_PARALYZE,
    " Der Berzerker zertruemmert Deinen Kopf. Du kannst Dich nicht bewegen.\n",
    " Der Berzerker zertruemmert @WESSEN Kopf. @WER kann sich nicht bewegen.\n",
    2);


}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("iss leiche");
  write_file("/d/ebene/lamuerte/burg/log/berzerker.log",ctime()+
             ": Der Berzerker hat gerade "+
             player->QueryProp(P_NAME)+
             " umgebracht.\n");
}
