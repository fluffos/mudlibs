// Update 08.12.2023 (Wraz): Gewicht & Groesse angepasst

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Eine Ratte");
  SetProp(P_LONG, "Eine kleine, verschmuddelte Ratte.\n");
  SetProp(P_NAME, "Ratte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Ratte");
  SetProp(P_SIZE, 8+random(5)); // zuvor 25
  SetProp(P_WEIGHT, 400+random(81)); // zuvor nicht definiert (--> 75kg!)
  AddId(({"ratte"}));
  create_default_npc(10+random(4));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_HANDS, ({" mit ihren Zaehnen",100, DT_PIERCE})); 
  SetProp(P_AGGRESSIVE,1);



  SetProp( P_REJECT, REJECT_KEEP);

 
   SetProp (P_MNPC_AREA, BURGMAUER(""));
   SetProp (P_MNPC_WAIT, ({10, 20, 30}));
   SetProp (P_MNPC_DEFAULTROOM, BURGMAUER("11x12y.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

   clone_object("/d/ebene/lamuerte/burg/obj/rattenzahn.lpc")->move(this_object(),M_NOCHECK);
   if(random(100)>50)
   clone_object("/d/ebene/lamuerte/burg/obj/rattenzahn.lpc")->move(this_object(),M_NOCHECK);   
   if(random(100)>90)
   clone_object("/d/ebene/lamuerte/burg/obj/rattenzahn.lpc")->move(this_object(),M_NOCHECK);   
}

