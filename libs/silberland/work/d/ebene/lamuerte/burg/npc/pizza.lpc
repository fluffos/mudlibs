inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>


string *pizza_spices=
({
 "Oregano","Mozzarella","Tomaten","Ananas","Artischocken","Champignons",
 "Eier","Gorgonzola","Knoblauch","Mais","Gemuese","Muscheln","Oliven",     
 "Paprika","Parmesan","Pfefferoni","Salami","Sardellen","Schafkaese",
 "Schinken","Shrimps","Speck","Spinat","Tabasco","Thunfisch","Zwiebel",
 "Currysauce","Hackfleisch","Wuerstchen","Pommes","Majo","Grammeln",
 "Gambari","Parmaschinken","Broccoli","Jakobsmuscheln","Rucola","Rosmarin",
 "Zucchini","Bananen","Elfenaugen","Zwergennasen","Trollhaare","Pudding",
 "Schokoflocken","Zungenwurst","Potenztropfen","Schlafperlen","Spinnen",
 "Wuermer","Schnecken","Sauerkraut","Gummibaerchen","Gurkerl","Nutella",
 "Marmelade","Delfenaugen","Elfenohren","Feenfluegel","Trollrotz"
});

pizza_liste();

create()
{
  string myname;
  int x;
 
  if (!is_clone(this_object())) return;
  
::create(); 
  
  SetProp(P_SHORT, "Tonno, der Pizzabaecker");
  SetProp(P_LONG, 
  "Vor Dir steht ein Pizzabaecker.");
  SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Tonno");
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_GENDER, MALE);
  SetProp(P_NOATTACK,"sagt: Iche nix kaempfe, iche Pizza!");
  AddId(({"\npizzatonno","Pizzabaecker","tonno","baecker"}));
  AddId(SID_NOLEARN);
  create_default_npc(32);
  SetProp(P_ALIGN, 270);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem Pizzablech",2230,DT_SLASH}));
  SetProp(P_SPELLRATE,(10));
          
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,    DT_BLUDGEON    :-0.4,    DT_PIERCE     :-0.4,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
 
  myname="Tonno";
  
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "laeuft mit einer Pizza in der Hand herein");
  SetProp(P_MSGOUT, "huepft mit einer Pizza in der Hand");

  SetProp(P_DIE_MSG, " bleder CHUND ist tot.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");

   AddDefaultSpell(80,10,DS_PARALYZE,
       "  Tonno paralysiert Dich mit seinem Mundgeruch.\n",
       "  Tonno paralysiert @WEN mit seinem Mundgeruch.\n");
 
  AddDefaultSpell(511,2,DS_MASS_DAMAGE,
       "  Tonno trifft Dich mit einem Rundumschlag.\n",
       "  Tonno wuetet fuerchterlich.\n",DT_PIERCE);


  AddInfo( DEFAULT_INFO,"sagt: Willst Du Pizza, eh? Musse mich danak frage, ok?");

  AddInfo( ({"pizza","zutat","zutaten"}), #'pizza_liste, "sagt: ");

  AddCmd(({"kaufe","kauf"}),"do_buy");
}

string pizza_liste(){
  string res;
  int max,i;
 
   res= "Meine Zutatenliste: \n"; 
   max = sizeof(pizza_spices);
   for(i=0;i<max;i++) {
      res += sprintf( "- %2d. %14.14s  ", i+1, capitalize(pizza_spices[i]));
      if ( !((i+1)%3))
         res+="\n";
   }
   res+="\nKommando: kaufe pizza mit ... (max. 5 zutaten)\n";
   return( res );
}

int do_buy(string str){
  string *strs,blah;
  int x;
  int y;
  int money,cost;
  object ob;
  
  notify_fail("Tonno sagt: Was Du wolle kaufe, eh?\n");
  if(!str) return 0;
 
   if (sscanf(str,"pizza mit %s",blah)!=1) return 0;
   str=str[9..strlen(str)]; 
   strs=explode(implode(explode(str," und ")," ")," ");

   if(sizeof(strs)<3){
     write("Tonno sagt: Musse makke mindeste 3 Zutate!\n");
     return 1;
   }
   
   if(sizeof(strs)>5){
     write("Tonno sagt: Ik makke keine Pizze mit mehr als 5 Zutate, Stronzo!\n");
     return 1;
   }

   for(x=0;x<sizeof(strs);x++){
    if(member_array(capitalize(strs[x]),pizza_spices)==-1){
      if(!to_int(strs[x])||to_int(strs[x])>sizeof(pizza_spices)){
        write("Tonno sagt: "+capitalize(strs[x])+" hab ik nikt, Stronzo!\n");
        return 1;
      }
      y=to_int(strs[x]);
      strs[x]=pizza_spices[y-1];
    }
    else{
      strs[x]=capitalize(strs[x]);
    }
   }

   for(x=0;x<sizeof(strs);x++){
     for(y=x+1;y<sizeof(strs);y++){
         if(strs[x]==strs[y]){
           write("Tonno sagt: E nix doppelt Zutaten, eh!\n");
           return 1;
       }
     }
   }
   
   cost=400+((sizeof(strs))*70); 

    if (!money=(int)this_player()->QueryMoney()) {
     write("Tonno sagt: Du wolle bescheisse? Habe gar keine "
           "Geld, Porko!\n");
     return( 1 );
  }
 
  if (money<cost) {
    write( "Tonno sagt: Diese Pizza koste "+to_string(cost)+
        " Muenze! Soviel habe Du nikt!\n" );
    return 1;
  }          
  
   this_player()->AddMoney(-cost);  
 
   write("Tonno nimmt folgende Dinge: ");  
    str="";
   for(x=0;x<sizeof(strs)-2;x++){
    str+=strs[x]+", ";
    }
    str+=strs[sizeof(strs)-2]+" und ";
    str+=strs[sizeof(strs)-1];
  
    write(str+".\n");
    say("Tonno bereitet eine Pizza mit:\n"+str+".\n");  
    write("Tonno belegt die Pizza, schiebt sie in den Ofen und gibt sie Dir danach.\n");  
    write("Du bezahlst "+to_string(cost)+" Muenzen und freust Dich.\n");
    ob=clone_object("/d/ebene/lamuerte/burg/obj/pizz_obj.lpc");
    ob->do_create_pizza(str);
    ob->move(this_player(),M_NOCHECK);
    return 1;
}
