
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <mnpc.h>
#include "files.h"

create()
{ int zufall;
  if (!is_clone(this_object())) return;
  ::create();       /* WICHTIG!!! */
  SetProp(P_SHORT, "Ein Buerger");
  SetProp(P_LONG, "Ein Buerger von Kyranda, bei seinen taeglichen Geschaeften. \n");
  SetProp(P_NAME, "Buerger");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  AddId(({"buerger","einwohner"}));
  create_default_npc(11);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Haenden",155})); 
  set_living_name("buerger");


  SetProp( P_REJECT, REJECT_KEEP);

 
   SetProp (P_MNPC_AREA, BURGWEG(""));
   SetProp (P_MNPC_WAIT, ({20, 40, 60}));
   SetProp (P_MNPC_DEFAULTROOM, BURGWEG("16x6y.lpc"));
   SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES);
   
}

