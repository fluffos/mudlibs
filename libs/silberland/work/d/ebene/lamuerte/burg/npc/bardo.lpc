inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include <defines.h>
#include <moredef.h>

string k_func();

create()
{
  if (!is_clone(this_object())) return;
  
::create(); 
  
  SetProp(P_SHORT, "Bardo, der Naeher");
  //SetProp(P_LONG, 
  //"Vor Dir steht Bardo der Naeher. Er ist ein schlanker, gut gebauter Elf, "+
  //"welcher die Naeherei zu seinem Leben gemacht hat. Er bemerkt Dich kaum "+
  //"da er so vertieft in seine Naeherei ist.");
  SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Bardo");
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 175);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbardo","bardo","naeher"}));
  create_default_npc(32);
  SetProp(P_ALIGN, 570);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem Naehkaestchen",5230,DT_SLASH}));
  SetProp(P_SPELLRATE,(10));
          
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,    DT_BLUDGEON    :-0.4,    DT_PIERCE     :-0.4,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,35);

  SetProp(P_NOATTACK,"sagt: Geh weg, du haettest keine Chance!\n");
  
  SetProp(P_DIE_MSG, " bleder CHUND ist tot.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  enable_commands();
  set_living_name("bardo");
  
   AddDefaultSpell(80,10,DS_PARALYZE,
       "  Bardo paralysiert Dich mit seinem Mundgeruch.\n",
       "  Bardo paralysiert @WEN mit seinem Mundgeruch.\n");
 
  AddDefaultSpell(511,2,DS_MASS_DAMAGE,
       "  Bardo trifft Dich mit einem Rundumschlag.\n",
       "  Bardo wuetet fuerchterlich.\n",DT_PIERCE);


  AddInfo( DEFAULT_INFO,"sagt: Ich weiss es - sags Dir aber nicht.");

  AddInfo( "bardo",
      "Das bin ich - Bardo, MEISTER der Naeher - Die Genialitaet in Person!",
