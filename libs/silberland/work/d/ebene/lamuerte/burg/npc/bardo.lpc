  AddInfo( "chance",
      "Ich habe schon Tessa, Tower und Justavius am Gewissen, seit dem "+
      "hab ich ein Verbot bekommen Spieler zu metzeln.","sagt: ");
  
  AddInfo( ({"angel"}),
      "Angel? Hahahaha.","sagt: ");

  AddInfo( ({"iwo"}),
      "Der ist zwar nicht ganz dicht, aber er hat einen Kackstuhl! "
      ,"sagt: ");
  
  AddInfo( ({"kackstuhl"}),
      "Da musst Du Iwo schon selbst fragen. Dafuer ist er auch berechtigt "+
