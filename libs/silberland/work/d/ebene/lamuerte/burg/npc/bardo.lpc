  AddInfo( ({"forscherpunkt"}),
      "Dir fehlen noch einige du Wurm.","sagt: ");
  
  
  AddInfo( ({"tessa","tower"}),
      "Hehe, das war ein Spass den Spieler umzulegen, leider warn sie "+
      "viel zu schwach.","sagt: ");

  AddInfo( "justavius",
      "Justl? War eine leichtes, aber der gab sogar eine Kerbe!","sagt: ");

  AddInfo( "justl",
      "Fuer Dich heisst er: Gnaedierster Herr Justavius!","bruellt: ");

  AddInfo( "kerbe",
      "sagt: Gibst Du auch eine? Vielleicht sollte ich doch wieder mal "+
      "\nBardo sagt: einen Spieler toeten.\nBardo grinst gemein.\n");
  
  AddInfo( "gewissen",
      "Ja, Woody hat mir ins Gewissen geredet.","sagt: ");

  AddInfo( "woody",
      "Er ist auch beinahe ein Meister, aber ich bin besser, versteht sich.",
      "sagt: ");

  AddInfo("spieler",
      "Denen bringe ich ab und an was bei.","sagt: ");
  
  AddInfo("verbot",
      "Jaja, geh weg Du Hirt.","sagt: ");
  
  AddInfo( "ahnung",
      "sagt: Meine Ahnung sagt mir - Du bist ein HIRT!\nBardo hirtet im Kreis.\n");
 
  AddInfo( "hirt",
      "Die sind drueben, in der Hirtengilde.", "sagt: ");
  
  AddInfo( "hirtengilde",
      "Ist sie noch nicht angeschlossen? Frag doch Angrox danach.", "sagt: ");
 
  AddInfo( "angrox",
      "Angrox, so ein Hirt will was von Dir. Ausserdem singt er immer so "
