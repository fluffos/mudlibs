  AddInfo( ({"lieder", "lied"}),
      "singt 'Bardo Bardo - Deine Welt ist die Naaaaaaaaaaeherei'.\n"
      "Bardo singt 'Bardo Bardo - Denn in der Naeeeeeehstube bi-hist du daheim'\n"
      "Bardo singt 'Dunkles Leder - und eine Na-hadel im Sonnenschein'.\n"
      "Bardo singt 'Bardo Bardo - Du bist der Meister der Naeherei.'.\n");

  
  AddInfo( "meister",
  "Ich bin der Meister! Unfehlbar - Allwissend! Meine Faehigkeiten "+
  "uebersteigen Deine bei weiten, Du bist nur der Wurm zu meinen Fuessen, an "+
  "meiner Genitalitaet reicht keiner heran! Ich bin der Meister. Ich habe "+
  "gesprochen!", "sagt: ");

  AddInfo( ({"unfehlbar","allwissend"}),
      "Jawohl, so bin ich!", "sagt: ");
  
  AddInfo( ({"faehigkeit","faehigkeiten"}),
      "Unglaublich wie gut ich bin.", "sagt: ");
  
  AddInfo( "wurm",
      "Haha, geh mir aus den Augen!", "lacht schallend: ");
 
  AddInfo( ({"fuesse","fuessen"}),
      "Kniehe Er nieder und wasche Er sie mir!","sagt: ");

  AddInfo( ({"genial","genialitaet"}),
      "Ich bin es - aber ich sag dir nichts, ich hab keine Zeit.",
      "sagt: ");

  AddInfo( ({"zeit"}),
      "G E H *W*E*G* !!!!!!","sagt: ");
  
  AddInfo( ({"naeher","naehen"}), "Um naehen zu lernen musst Du Fleiss haben "+
      "und Dir einiges an Wissen aneignen." , "sagt: ");

  AddInfo("naeherei",
      "Gefaellt es Dir hier?", "sagt: ");
  
  AddInfo( ({"fleiss"}), "Es erfordert ganz schoen viel Uebung um "+
      "wirklich gut naehen zu koennen, einige Rassen wie Trolle oder "+
      "Oger werden das wol nie wirklich gut hinbekommen, die sind viel "+
      "zu fett. *grins*", "sagt: ");

  AddInfo( ({"rasse","rassen"}),
      "Ich sagte es doch schon, die fetten Oger und Trolle sind viel zu "+
      "bloed fuer die Naeherei!", "sagt: ");

  AddInfo( ({"oger","troll","trolle"}),
      "Ja, wie oft denn noch - sie SIND F E T T und S T I N K E N !!", 
      "sagt: ");

  AddInfo( ({"zwerg","zwerge","elf","elfen","mensch","menschen","fee","feen"
             "hobbit","dunkelelf","dunkelelfen","hobbits"}),
      "Hm, eventuell schafft diese Rasse mehr? Mal sehen.",
      "sagt: ");
  AddInfo ( ({"yetifell","wolfsfell","pumafell","tigerfell","braunbaerenfell","wuslerfell"}),  
      "Diese Art von Fell braucht man fuer die besten Naeharbeiten",
      "sagt: ");
 AddInfo ( ({"jaguarfell","grizzlyfell","fuchsfell","bueffelfell","baerenfell"}), "sagt: Diese Art von Fell braucht man zum Naehen, also los,\nBardo sagt: besorgs Dir.\n"+
     "Bardo grinst dreckig.\n");

  
  AddInfo( ({"uebung"}),
      "Man braucht Uebung im Gerben um aus Fellen Leder zu machen, "+
      "aber man braucht auch viel Uebung beim Naehen selbst.",
      "sagt: ");

  AddInfo( ({"fell","felle"}),
      "Felle brauche ich zum Gerben!",
      "sagt: ");
  
  AddInfo( ({"gerben"}),
      "Felle kann man gerben, bist Du wirklich so interessiert daran?",
      "sagt: ");

  AddInfo( ({"leder"}),
      "Das entsteht wenn man Felle gerbt. Interessiert Dich die Lehre des "+
      "Naehens denn wirklich so?",
      "sagt: ");

  AddInfo( ({"lehre"}),
      "Wenn Du es wirklich lernen willst, frag mich nach einem Naehkaestchen "+
      "mit dem kannst Du dann naehen.", "sagt: ");

  AddInfo( ({"seide"}),
      "Zum Naehen braucht man Raupenseide, Spinnenseide oder auch Magieseide.",
      "sagt: ");

  AddInfo( ({"raupenseide"}),
      "Die findet man bei, man glaubt es kaum, bei Raupen! Aber dem Kraeuterladen "
      "hab ich vorhin auch welche aus dem Sternenwald verkauft.",
      "sagt: ");

  AddInfo( "raupen",
      "Solche Wesen stecken normal auf Baeumen oder im Wald.",
      "sagt: ");

  AddInfo( "spinnenseide",
      "Die kaufe ich normalerweise zu, aber sie stammen von Spinnen.",
      "sagt: ");

  AddInfo("schild",
      "Lies es!","sagt: ");
  
  AddInfo( "spinnen",
      "Ich als Meister weiss wo Spinnen sind Du hingegen hast keine Ahnung.", "sagt: ");

  AddInfo( "magieseide",
      "Magieseide? Oh, die ist wertvoll, ich habe letztens 100.000 Goldmuenzen "+
      "bezahlt fuer 8 Stueck!","sagt: ");

  AddInfo( "holz",
      "Ich weiss alles und auch das die Sarnaks welches haben.",
      "sagt: ");

  AddInfo( ({"sarnak","sarnaks","oger"}),
      "Such sie halt.","sagt: ");
  
  AddInfo( "eisen",
      "Danach musst Du selber schuerfen, von mir bekommst Du keins.",
      "sagt: ");

  AddInfo( ({"stoff","reste","stoffreste"}),
      "Manchmal findet man sowas bei Untoten.",
      "sagt: ");

 AddInfo( ({"untote","untoten"}),
     "Hmmm, Skelette sind welche, oder?",
     "sagt meisterlich: ");
 
 AddInfo( ({"biberfell"}),
     "Ich, der Meister, sagt Dir, dem Wurm, das einer in der Naehe des "+
     "Feenschlossses gesehen wurde.","sagt: ");

  AddInfo( "feenschloss",
      "Ich kenne den Weg zum Teich am Feenschloss, Du auch?",
      "sagt grinsend: ");

  AddInfo( "teich",
      "Naja Biber moegens nass.", "sagt: ");

  AddInfo ("biber",
      "Zieh einem das Fell ueber die Ohren dann hast Du was zum gerben.",
      "sagt: ");

  AddInfo ("ohren",
      "Hae? Frag doch nicht So bloed.",
      "sagt: ");
  AddInfo ("sissi", 
      "Haha! Das ist doch die Schwester von Nell. Die ist nie und nimmer "
      "meisterlicher als ich, selbst mit ihrem unterdurchschnittlichen "
      "Hueftschwung. Sie wird nie so meisterlich Hueftschwingen koennen wie "
      "ich, der meisterliche Meister aller Meister!");

  
  
  
  AddInfo( "naehkaestchen",  #'k_func, "sagt: ");

}


string k_func(){

  if(deep_present("\nnaehkaestchen",this_player()))
    return "Du hast doch schon eins, ein neues gibt es nut wenn Du Deines verlierst!"+
      " Los - geh ueben!";

  clone_object("/p/std/skills/sewing_tanning/naehkaestchen.lpc")->move(
      this_player(),M_NOCHECK);
  tell_object(this_player(),"Bardo nimmt ein Naehkaestchen und gibt es Dir.\n");
  return "Hier nimm dieses Naehkaestchen.";
}

void nix_da(string pln)
{
  object pl;
 if(!pl=find_player(pln)) return;
 if(!present(pl))
 pl->Message("Bardo teilt Dir mit: Komm vorbei wenn Du was willst.\n", MSGFLAG_TELL); 
 else
 tell_room(environment(),"Bardo sagt: "+
     capitalize(pln)+" du Hirt, bist ja eh da, was soll das teile mit?\n");
 return;
}

void catch_tell(string str)
{
  object pl;
  if( !pl=find_player(lower_case(explode(str," ")[0])) ) return;
  if ((strstr(str, "teilt Dir mit: ") != -1)) {
    call_out("nix_da",3,getuid(pl));
  }
 return;
}


string long() {
  return BS(sprintf( 
   "Vor Dir steht Bardo der Naeher. Er ist ein schlanker, gut gebauter Elf, "+
  "welcher die Naeherei zu seinem Leben gemacht hat. Er bemerkt Dich kaum "+
  "da er so vertieft in seine Naeherei ist. Auch wenn er unscheinbar wirkt "
  "bist Du Dir sicher, dass er aus Dir ein schoenes Paar %senlederhandschuhe "
  "fabrizieren wird, solltest Du ihn angreifen!", CAP(TP->QueryProp(P_RACE))))
  +BS("Er ist in einer - wie sollte es anders sein - meisterlichen "
     "Verfassung.") ;
}
