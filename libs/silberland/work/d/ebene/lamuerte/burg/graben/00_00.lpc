inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Ein Zonencrea.");
 SetProp(P_INT_LONG,
  "Du befindest Dich im Zonencrea.\nKommando: 'mach'");
 AddCmd("mach","do_build");
 
}

int do_build(){
  int x;
  int y;
  int do_w;
  string rname1,rname2,dir1,dir2;
  int sizex,sizey;
  int addc,decc;
  sizex=10;
  sizey=10; 
  do_w=0;

  for (x=0;x<=sizex;x++){
    for(y=0;y<=sizey;y++){
      write("X:"+x+" Y:"+y+"\n");
     //linksaufab
      do_w=0;
     if((x==0 && y>0 && y<sizey) || (x==sizex && y>0 && y<sizey)){
      decc=y-1;
      addc=y+1;
      dir1="norden";
      rname1="room"+x+"x_"+addc+"y.lpc";  
      dir2="sueden";
      rname2="room"+x+"x_"+decc+"y.lpc";
      do_w=1;
     }

     //obenlinksrechts
     if((y==sizey && x>0 && x<sizey) || (y==0 && x>0 && x<sizey)){
      decc=x-1;
      addc=x+1;
      dir1="osten";
      rname1="room"+addc+"x_"+y+"y.lpc";  
      dir2="westen";
      rname2="room"+decc+"x_"+y+"y.lpc";
      do_w=1;
     }
     //so
     if(x==sizex && y==0){
      decc=x-1;
      addc=y+1;
      dir1="norden" ;
      rname1="room"+x+"x_"+addc+"y.lpc"; 
      dir2="westen";  
      rname2="room"+decc+"x_"+y+"y.lpc";
      do_w=1;
     }
     
     //nw 
     if(x==0 && y==sizey){
      decc=x+1;
      addc=y-1;
      dir1="osten" ;
      rname1="room"+decc+"x_"+y+"y.lpc"; 
      dir2="sueden";  
      rname2="room"+x+"x_"+addc+"y.lpc";
      do_w=1;
     }

     //sw 
     if(x==0 && y==0){
      addc=x+1;
      dir1="osten" ;
      rname1="room"+addc+"x_"+y+"y.lpc";  
      addc=y+1;
      dir2="norden";
      rname2="room"+x+"x_"+addc+"y.lpc";
      do_w=1;
     }

     //no 
     if(x==sizex && y==sizey){
      decc=x-1;
      dir1="westen" ;
      rname1="room"+decc+"x_"+y+"y.lpc";  
      decc=y-1;
      dir2="sueden";
      rname2="room"+x+"x_"+decc+"y.lpc";
      do_w=1;
     }

     if(do_w==1){
     write_file("/d/ebene/lamuerte/burg/graben/room"+x+"x_"+y+"y.lpc",
      "inherit \"std/room\";\n"+
      "#include <properties.h>\n"+
      "#include <language.h>\n\n"+
      "create()\n{"+
      "::create();\n\n"+
      "seteuid(getuid());\n"+
      "  SetProp(P_INT_SHORT,\"Im Wassergraben\");\n"+
      "  SetProp(P_INT_LONG,\n    \"Du befindest Dich im Burggraben. Es ist wirklich sehr \"\n    \"ungemuetlich, nichts was Dir auch im entferntesten wirklich gefallen wuerde. \"\n    \"Manchmal kann man ein leises Zischen hoeren, dann ist es jedoch wieder weg. \"\n    \"Am Besten ist, Du verziehst Dich bald wieder, denn es ist wirklich \"\n    \"ungemuetlich und feucht hier.\");\n\n"+
      "  SetProp(P_LIGHT,1);\n"+
      "  SetProp(P_INDOORS,0);\n"+
      "  AddDetail(({\"graben\",\"burggraben\"}),\n    \"Es ist ungemuetlich hier, schnell hau ab.\");\n"+
      "  AddDetail(({\"boden\",\"wasser\"}),\n    \"Ja, da ist Wasser am Boden, knocheltief. Du watest darin.\");\n"+
      "  AddDetail(({\"decke\",\"himmel\"}),\n    \"Ueber Dir befindet sich der Himmel und die Burgmauer von Kyranda.\");\n"+
      "  AddDetail(({\"burgmauer\",\"kyranda\"}),\n    \"Du siehst nur die Burgmauer welche Kyranda einschliesst.\");\n"+
      "  AddDetail(({\"wand\",\"waende\"}),\n    \"Die Waende interessieren Dich nicht Du willst nur weg von hier.\");\n"+
      "  AddItem(\"/d/ebene/lamuerte/burg/npc/sarnak\",REFRESH_DESTRUCT);\n"+
      "  if(random(2)>0)AddItem(\"/d/ebene/lamuerte/burg/npc/sarnak\",REFRESH_DESTRUCT);\n"+
      "  AddSound(DEFAULT_SOUND,\n    \"Ab und an hoerst Du ein unwichtiges Zischen.\");\n"+
      "  AddSound(\"zischen\",\n    \"*ZISCHHHHH*\");\n"+
      "  AddSmell(DEFAULT_SMELL,\n    \"Es stinkt hier.\");\n"+
      "  AddExit(\""+dir1+"\",\"/d/ebene/lamuerte/burg/graben/"+rname1+"\");"+
      "\n"+
      "  AddExit(\""+dir2+"\",\"/d/ebene/lamuerte/burg/graben/"+rname2+"\");"+
      "\n}\n");
     }
     do_w=0;
    }
  }
 return 1;
}
