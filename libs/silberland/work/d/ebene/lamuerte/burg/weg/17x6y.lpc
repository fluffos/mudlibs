inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include "files.h"

int i; //Schluessel da / nicht da Var.

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Auf einer Bruecke");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf der Zugbruecke der Burg Kyranda. Vor Dir liegt " 
    "das Haupteingangstor. Links und rechts der Bruecke siehst Du den Wasser"
    "graben, welcher sich entlang der Burgmauern erstreckt und welcher in "
    "Richtung runter betretbar ist. Ein steinernes Wappen ist ueber dem Tor "
    "angebracht. Im Sueden liegt ein grosses Gebuesch, in welches ein Weg fuehrt.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT, 1);
  SetProp(P_NO_MNPC,1);
  i=0;

  AddDetail( ({"richtung"}),
    "Du kannst hier nach Norden und Sueden.");

  AddDetail(({"bruecke", "zugbruecke"}),
    "Die Bruecke ist aus langen, stabilen Holzbalken gebaut. Sie kann hoch "
    "gezogen werden, um angreifenden Truppen den Weg ins Innere der Burg zu "
    "erschweren.");

  AddDetail( ({"innere","norden"}),
    "Ins Innere der Stadt kommt man nach Norden.");

  AddDetail(({"truppe","truppen"}),
    "Zur Zeit leben die Einwohner in Frieden. Es gibt keine Feinde.");

  AddSpecialDetail( ({"zeit"}), "det_zeit");

  AddDetail( ({"frieden", "feinde"}),
    "Ein Frieden haelt nur so lange, wie man sich keine Feinde macht.");

  AddDetail(({"holz","holzbalken"}),
    "Du huepfst auf den Balken herum. Sie biegen sich keinen Zentimeter.");

  AddDetail(({"zentimeter"}),
    "Dafuer scheinst Du jetzt um einige Zentimeter kleiner zu sein.");

  AddDetail(({"burg","bauwerk","kyranda", "stadt"}),
    "Die Burg ist ein wirklich prachtvolles Bauwerk. Sie wurde vor vielen "
    "Jahren von den Kyrandern erbaut.");

  AddDetail(({"jahre"}),
    "Das ist zu lange aus, da kann sich heute keiner mehr dran erinnern, wann "
    "das war.");

  AddDetail(({"kyrander","einwohner","bewohner", "meister", "architektur"}),
    "Die Kyrander sind die Einwohner dieser Burg. Sie waren immer schon "
    "Meister der Architektur.");

  AddDetail(({"tor","eingangstor","haupteingangstor"}),
    "Das Tor bildet in abgesenktem Zustand eine Bruecke, welche ueber "
    "den Wassergraben fuehrt. Hochgezogen kann man die Burg nicht betreten.");

  AddDetail(({"zustand"}),
    "Derzeit ist das Tor unten.");

  AddDetail(({"graben","wassergraben"}),
    "Der Wassergraben ist knietief mit schmutzigem Wasser gefuellt, das "
    "auch ziemlich riecht. Wahrscheinlich wurde und wird er auch zur "
    "Ablagerung organischer Ueberbleibsel verwendet.");

  AddDetail(({"ablagerung"}),
    "Soll heissen, alles moegliche wird da reingeschi... -schmissen.");

  AddDetail(({"wall","abwehrwall","mauer","burgmauer","mauern","burgmauern"}),
    "Die Burgmauer schuetzt die Bewohner der Burg. Sie ist aus schwerem "
    "Gestein erbaut, sicher genug um einen Abwehrwall darzustellen.");

  AddDetail(({"gestein","stein","steine"}),
    "Du wunderst Dich wie man mit der heutigen Technik solch riesen "
    "Steinkolosse transportieren kann. Als Du die Mauer betrachtest, "
    "sticht Dir ein steinernes Wappen ins Auge.");

  AddDetail(({"technik", "steinkolosse"}),
    "Die Steine sehen ziemlich schwer aus. Da muessen schon hunderte "
    "mitgeholfen haben um das bewerkstelligen.");

  AddDetail( ({"auge"}),
    "Autsch, das tut weh.");

  AddDetail(({"wappen"}),
    "Das Wappen ist aus Stein gehauen. Es zeigt zwei Drachen, welche "
    "mit dem Ruecken zueinander die Aussenkanten des Wappens bilden. "
    "Zwischen den Drachen ist in der Mitte des Wappens ein eisener Ring "
    "angebracht, von dem aus eine Art von Strahlen weg zu den Drachen "
    "eingemeisselt sind.");

  AddDetail(({"drachen","ruecken","aussenkanten","art","strahlen"}),
    "Das ist ein Teil des Wappens.");

  AddDetail( ({"teil"}),
    "Die einzelnen Teile ergeben das Wappen.");

  AddDetail(({"balken"}),
    "Die Balken sehen aeusserst belastbar aus.");

  AddDetail(({"ring","mitte"}),
    "Da ist ein Ring aus Metall. Es sieht so aus als ob er als Halterung "
    "fuer irgendetwas diente." );

  AddDetail(({"metall"}),
    "Kalt und hart. Echtes Metall eben.");

  AddDetail(({"gebuesch","sueden"}),
    "Das Gebuesch ist im Sueden.");

  AddDetail(({"wald"}),
    "Der Wald befindet sich weiter im Sueden.");

  AddDetail(({"weg"}),
    "Der Weg fuehrt in den Wald.");

  AddDetail(({"wasser"}),
    "Ihhh sieht das ekelhaft aus.");

  AddDetail(({"ueberbleibsel"}),
    "Lieber nicht. Das Wasser sieht so schon schlimm genug aus.");

  AddDetail(({"boden"}),
    "Du stehst auf einer Zugbruecke.");

  AddDetail(({"himmel"}),
    "Der Himmel ist ueber Dir.");

  AddSpecialDetail(({"halterung","schluessel"}),"hfunc");

  AddSound(DEFAULT_SOUND,
    "Du hoerst nur den Wind.");

  AddSound(({"wind"}),
    "Er blaest Dir in Deine Ohren.");

  AddSound( ({"ohren"}),
    "Und wenn Du nicht aufpasst blaest er auf der anderen Seite wieder raus.");

  AddSmell(DEFAULT_SMELL,
    "Irgendwas riecht hier ganz komisch. Eventuell musst Du Dich nochmal genau "
    "umsehen, damit Du weisst was es ist.");

  AddSmell(({"wasser","geruch"}),
    "Das Wasser hat einen sehr fauligen Geruch.");

  AddExit("norden",ROOM("16x6y.lpc")); 
  AddExit("sueden","/d/ebene/lamuerte/wwald/room/buschweg2.lpc");
  AddExit("runter","/d/ebene/lamuerte/burg/graben/room5x_0y");

  AddCmd (({"brich", "breche", "brech"}),"bfunc");
}

string hfunc()
{
  if (i==0)
  {
    write("Dir faellt ein kleiner Schluessel auf, welcher sich in der Halterung\n"
        "befindet. Vielleicht kann man ihn ja rausbrechen.\n");  
    return "";
  }
  if (i==1)
  {
    write("Dir faellt nichts besonderes an der Halterung auf.\n");
    return "";
  }
}


int bfunc(string str)
{
  string was,wo;
  object key; 

  if (!str)
  {
    notify_fail("Was willst Du WO rausbrechen?\n");
    return 0;
  }
  sscanf(str,"%s aus %s",was,wo);
  if(was!="schluessel")
  {
    write("Das kann man nicht herausbrechen.\n"); 
    return 1;
  }
  if(wo!="halterung")
  {
    write("Daraus kann man nichts herausbrechen.\n");
    return 1;
  }
  if (i==1)
  {
    write ("Du siehst ja gar keinen Schluessel!\n");
    return 1;
  }
  if ((key=deep_present ("seppo",this_player())))
  {
    write("Dieser dumme Schluessel, Du bekommst ihn einfach nicht aus seiner Halterung\n"
      "heraus. Irgendwie stimmt da was nicht.\n");
  return 1;
  }
  write("Du brichst den Schluessel aus der Halterung.\n");  
  clone_object("/d/ebene/lamuerte/burg/obj/key.lpc")->move(this_player(),
      M_NOCHECK);
  i=1; 
  return 1;
}

int checkkey()
{
  if (i==1) i=0;
  return 1;
}


void reset()
{
  ::reset();
  i=0;
}

string det_zeit()
{
  return "Es ist jetzt genau: " + dtime()[19..] + ".\n";
}
