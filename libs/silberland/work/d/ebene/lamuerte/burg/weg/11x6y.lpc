inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Der Burgweg macht hier eine Biegung und stellt weiter im Westen die "
    "Verbindung zur Pferdegasse dar. Weit im Sueden erkennt man von hier "
    "aus den grossen Torbogen in der Stadtmauer, welcher aus der Stadt "
    "fuehrt.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddDetail( ({"burgweg"}),
    "Du befindest Dich noch immer auf ihm. Er ist mit Kies ausgelegt.");

  AddDetail(({"verbindung"}),
    "Eine Verbindung verbindet meistens etwas. Klar, oder?");

  AddDetail(({"bogen","torbogen"}),
    "Der Torbogen stellt den Ausgang aus der Stadt dar.");

  AddDetail( ({"ausgang", "sueden"}),
    "Bis Du den erreichst musst Du noch weit nach Sueden gehen.");

  AddDetail( ({"stadt", "kyranda"}),
    "Schon wieder vergessen? Die Stadt in der Du dich befindest, heisst "
    "Kyranda.");

  AddDetail("einwohner",
    "Hmm.. Keiner da? Oder doch!"); 

  AddDetail(({"mauer","stadtmauer"}),
    "Die Mauer ist aus schwerem Gestein gebaut, um Eindringlinge "
    "fernzuhalten.");

  AddDetail( ({"eindringlinge"}),
    "Pass auf, dass Du Dich hier in der Stadt benimmst, sonst bekommst "
    "Du schnell Aerger.");

  AddDetail( ({"aerger"}),
    "Und der kann weh tun.");

  AddDetail(({"gestein", "steinbloecke"}),
    "Keine Ahnung, wie die Steinbloecke hier her geschafft haben.");

  AddDetail( ({"ahnung"}),
    "Die hast Du auch nicht ;) .");

  AddDetail(({"biegung"}),
    "Die Biegung hat hat einen Neigungswinkel von etwa 90 Grad.");

  AddDetail( ({"neigungswinkel","neigung", "winkel"}),
    "Hoppla ... jetzt hast Du Dich zu weit auf die Seite gelehnt, "
    "und bist umgefallen. Schnell stehst Du wieder auf.");

  AddDetail( ({"seite","grad"}),
    "Das waren jetzt genau 90 Grad.");

  AddDetail(({"pferdegasse","gasse"}),
    "Die Pferdegasse hat ihren Beginn weiter im Westen.");

  AddDetail( ({"beginn", "westen"}),
    "Der Beginn ist wie gesagt im Westen. Also nicht hier.");

  AddDetail(({"kiesweg","weg"}),
    "Der Kiesweg ist ziemlich ausgetreten. Offenbar wird er von vielen "
    "Einwohnern benutzt.");

  AddDetail(({"kies","boden"}),
    "Wie es bei einem Kiesweg so ist, ist der Boden aus Kies.");

  AddDetail(({"himmel", "blau"}),
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "
    "Hoffentlich faengt es nicht zu regnen an.");

  AddSound(DEFAULT_SOUND,
    "Du horchst herum, hoerst aber nichts. Nur der Kies knirscht etwas unter "
    "Deinen Fuessen.");

  AddSound(({"kies"}),
    "Knirsch*knarsch");

  AddSound(({"fuesse"}),
    "Du hoerst ganz leise: 'Wasch uns, wasch uns.'");

  AddSmell(DEFAULT_SMELL,
    "Irgendwie riechts vom Boden her nach Kaese.");

  AddSmell( ({"boden"}),
    "Du riechst am Boden rum, riechst aber nur deine Fuesse.");

  AddSmell(({"kaese","fuesse","kaesefuesse"}),
    "Wasch Dir mal wieder Deine Kaesefuesse.");

  AddExit("westen",ROOM("11x5y.lpc"));
  AddExit("sueden",ROOM("12x6y.lpc"));
}
