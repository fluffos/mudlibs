inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Hier fuehrt der Burgweg vom Sueden in den Norden. Dem Kiesweg nach zu "
    "urteilen, duerfte es sich um einen wichtigen Weg handeln, da er ziemlich "
    "niedergetreten aussieht. Ein kleines Schild auf einem Holzpflock steht "
    "inmitten des Weges. Ausserdem siehst Du im Westen einen soliden Verbau.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddDetail( ({"sueden", "norden"}),
    "Im Norden und Sueden siehst Du je eine kleine Kreuzung.");

  AddDetail(({"pflock","holzpflock","halterung"}),
    "Ein langer Pflock der in den Kies eingeschlagen ist. Er dient als "
    "Halterung fuer das Schild.");

  AddDetail(({"schild", "wegweiser"}),
    "Probiers mal mit lesen.");

  AddReadDetail(({"schild", "wegweiser"}),
    "+--------------------------+\n"
    "| Pferdegasse              |\n"
    "|      <>                  |\n"
    "|      <><><>              |\n"
    "|          **              |\n"
    "|  Burgweg <>              |\n"
    "|          <><> Marktgasse |\n"
    "|          <>              |\n"
    "|          <>              |\n"
    "|      Haupttor            |\n"
    "+--------------------------+\n"
    "  **  Du stehst hier.\n");

  AddDetail(({"kreuzung"}),
    "Eine Kreuzung verbindet verschiedene Wege miteinander.");

  AddDetail(({"boden"}),
    "Kies soweit das Auge reicht.");

  AddDetail( ({"auge"}),
    "Pass auf das Dir kein Kiesel ins Auge huepft.");

  AddDetail(({"einwohner","buerger"}),
    "Schau Dich um? Sieht Du nirgendwo einen Buerger herumlaufen?");

  AddDetail(({"kiesweg","weg","burgweg"}),
    "Der Kiesweg ist hier ziemlich ausgetreten. Offenbar wird er von vielen "
    "Einwohnern benutzt.");

  AddDetail( ({"kies","kiesel"}),
    "Daraus besteht ein Kiesweg normalerweise.");

  AddDetail(({"himmel", "blau"}),
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "
    "Hoffentlich faengt es nicht zu regnen an.");

  AddDetail( ({"holz"}),
    "Genauso wie der Wegweiser vermutlich aus Eiche gemacht.");

  AddDetail( ({"eiche"}),
    "Die gibts hier genauso wenig zu sehen, wie die Buche.");

  AddDetail( ({"buche"}),
    "Die gibts hier genauso wenig zu sehen, wie die Birke.");

  AddDetail( ({"birke"}),
    "Die gibts hier genauso wenig zu sehen, wie die Tanne.");

  AddDetail( ({"tanne"}),
    "Die gibts hier genauso wenig zu sehen, wie die Fichte.");

  AddDetail( ({"fichte"}),
    "Die gibts hier genauso wenig zu sehen, wie die aehm, aehm, wie "
    "irgendeine andere Baumart.");

  AddDetail( ({"baum", "baumart"}),
    "Du solltest langsam begriffen haben, dass es hier keinen Baum gibt.");

  AddDetail( ({"westen","verbau"}),
    "Solide und stabil aus Holz gebaut. Aber Du wirst schon eine "
    "Moeglichkeit, da rein zu kommen, finden.");

  AddDetail( ({"moeglichkeit"}),
    "Moeglich ist alles, wenn man nur will.");

  AddSmell(DEFAULT_SMELL,
    "Du riechst nur das Holz.");

  AddSmell(({"holz"}),
    "Riech holzig. Vielleicht ist da der Wurm drin?");

  AddSmell( ({"wurm"}),
    "Den willst Du tatsaechlich erriechen?");

  AddSound(DEFAULT_SOUND,
    "Du horchst herum, hoerst aber nichts.");

  AddSound( ({"wurm","holzwurm"}),
    "Jaaaa ... ganz leise hoerst Du einen Holzwurm knabbern.");

  AddExit("norden",ROOM("11x6y.lpc"));
  AddExit("sueden",ROOM("14x6y.lpc"));
}
