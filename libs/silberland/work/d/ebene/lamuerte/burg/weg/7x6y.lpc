inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Die Hauptgasse fuehrt hier vom Westen in den Osten an der Kirche "
    "der Stadt vorbei. Links und rechts wird das Gebaeude von zwei hohen "
    "Kirchtuermen abgeschlossen. In der Mitte des Gebaeudes fuehrt ein "
    "grosses Tor in die Kirche.");
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));

  AddDetail(({"hauptgasse"}),
    "Du kannst nach Osten oder Westen auf ihr weitergehen.");

  AddDetail( ({"westen", "osten"}),
    "Egal wo hin Du gehst, irgendwo kommst Du sicher an.");

  AddDetail( ({"himmel", "blau"}),
    "Du siehst nach oben. Nichts als strahlendes Blau.");

  AddDetail(({"boden"}),
    "Der Boden vor der Kirche zeigt ein wunderschoenes Mosaik.");

  AddDetail(({"mosaik"}),
    "Viele kleine Steinchen, welche als Gesamtheit ein Bild darstellen.");

  AddDetail(({"steinchen","steine"}),
    "Es muessen tausende Steine sein.");

  AddDetail(({"gesamtheit"}),
    "Ein wunderschoenes Bild.");

  AddSpecialDetail("bild","bfunc");

  AddDetail( ({"mitte"}),
    "Da ist das Tor.");

  AddDetail(({"tor"}),
    "Du untersuchst das Tor. Sieht so aus als ob es in die Kirche fuehrt.");

  AddDetail(({"stadt"}),
    "Du siehst Dich um und stellst fest, dass Du wirklich in der Stadt stehst.");

  AddDetail(({"kirche","gebaeude"}),
    "Die Kirche sieht mit ihren hohen Tuermen wirklich prachtvoll aus.");

  AddDetail(({"turm","tuerme", "kirchturm", "kirchtuerme"}),
    "Das sind wahrscheinlich die groessten Tuerme, die Du je gesehen hast. "
    "Sie muessen von Meisterhand erbaut worden sein.");

  AddDetail(({"meisterhand","meister", "baukunst"}),
    "Nur ein Meister der Baukunst kann solche Tuerme erbauen.");

  AddDetail(({"hauptgasse"}),
    "Die Hauptgasse fuehrt vom Westen in oestliche Richtung.");

  AddSound(DEFAULT_SOUND,
    "Du horchst herum, sollten nicht die Glocken laeuten?");

  AddSound(({"glocken"}),
    "Wird wohl gerade keiner messnern.");

  AddSmell(DEFAULT_SMELL,
    "Ein eigenartiger Geruch zieht aus der Kirche.");

  AddSmell( ({"geruch"}),
    "Du kannst es nicht definieren.");

  AddSmell( ({"kirche"}),
    "Reingehn und nicht dran riechen!");

  AddExit("westen",ROOM("7x5y.lpc"));
  AddExit("osten",ROOM("7x7y.lpc"));
  AddExit("sueden",ROOM("8x6y.lpc"));
  AddExit("norden", "/d/ebene/gwenshara/kyranda/room/gasse" );
}

string bfunc()
{
  write ("WOW! Was ist das denn!!\n");
  if(this_player()->QueryProp(P_GENDER)==NEUTER)
  {
    write("Das Bild sieht irgendwie verwischt aus.\n");
    return "";
  }
  else if(this_player()->QueryProp(P_GENDER)==MALE)
  {
    write("Das Bild des heiligen "+this_player()->QueryProp(P_NAME)+".\n");
    return "";
  }
  else if(this_player()->QueryProp(P_GENDER)==FEMALE)
  {
    write("Das Bild der heiligen "+this_player()->QueryProp(P_NAME)+ ".\n");
    return "";
  }
  write("Das Mosaik ergibt irgendwie keinen Sinn.\n");
  return "";
}
