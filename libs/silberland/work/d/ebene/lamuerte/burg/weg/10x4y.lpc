inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Die Pferdegasse fuehrt vom Sueden weiter in den Norden. Der Boden sieht "
    "ziemlich niedergetrampelt aus, da die Knechte oefters die Pferde in dieser "
    "Gasse ausreiten. Weiter im Sueden gelangst Du von hier aus zum Burgweg.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddDetail(({"boden"}),
    "Am Boden sind die Spuren von Pferden zu sehen.");

  AddDetail( ({"himmel"}),
    "Der Himmel ist ueber Dir.");

  AddDetail( ({"sonne"}),
    "Die kannst Du von hier aus nicht sehen. Die Burgmauer steht im Weg.");

  AddDetail( ({"burgmauer","mauer"}),
    "Die ist im Westen.");

  AddDetail(({"westen","sueden","norden"}),
    "Das sind Himmelsrichtungen.");

  AddDetail( ({"himmelsrichtungen"}),
      "Norden, Sueden, Westen usw....");

  AddDetail( ({"spuren"}),
    "Es handelt sich um den Abdruck eines Pferdehufs.");

  AddDetail(({"abdruck", "huf", "pferdehuf"}),
    "Sieht normalerweise hufeisenfoermig aus.");

  AddDetail( ({"hufeisen"}),
    "Das haben Pferde meist.");

  AddDetail(({"knechte"}),
    "Die Knechte sind fuer die Pflege der Pferde zustaendig.");

  AddDetail( ({"pflege"}),
    "Auch Pferde wollen gepflegt sein und sich gut fuehlen.");

  AddDetail( ({"pferd","pferde"}),
    "Momentan siehst Du hier keines.");

  AddDetail(({"burgweg", "stueck"}),
    "Der Burgweg befindet sich ein Stueck weiter im Sueden.");

  AddDetail(({"hauptgasse"}),
     "Die Hauptgasse befindet sich weiter im Norden.");

  AddDetail(({"pferdegasse","gasse"}),
    "Die Gasse verbindet den Burgweg mit der Hauptgasse.");

  AddSound(DEFAULT_SOUND,
    "Du horchst herum, hoerst aber nur den Kies unter Deinen Fuessen knirschen.");

  AddSound( ({"kies"}),
    "Du hoerst ihn leise rufen: 'Tritt mich, tritt mich.'");

  AddSound( ({"fuesse"}),
    "Die kannst Du nicht hoeren, bloss riechen.");

  AddSmell(DEFAULT_SMELL,
    "Irgendwie riechts hier nach Kaese.");

  AddSmell(({"fuesse","kaese"}),
    "Igitt ... Deine Fuesse gehoeren wieder einmal gewaschen.");

  AddExit("sueden",ROOM("11x4y.lpc"));
  AddExit("norden",ROOM("7x4y.lpc"));
  AddExit("westen", "/d/ebene/lamuerte/burg/shop/loewenherz");
}
