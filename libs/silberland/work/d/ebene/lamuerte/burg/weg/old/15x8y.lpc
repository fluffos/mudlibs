inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
        "Die Marktgasse fuehrt schnurgerade vom Westen in den Osten. Im Sueden "+
        "befindet sich eine Blockhuette, ueber der ein schmiedeeisernes Schild,"+
        " welches eine Axt und ein Schwert zeigt, haengt."
        );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_LIGHT,1);
  AddDetail( ({ "axt", "schwert" , "zeichen"}), 
       "Es handelt sich dabei wohl um das Zeichen "+
        "eines Schmieds.");
  AddDetail(({"huette","blockhuette"}),
        "Die Huette ist aus dicken Holzstaemmen gebaut. Dem Schild nach zu "+
        "urteilen, handelt es sich um einen Waffenhaendler."
        );
  AddDetail(({"staemme", "holz","holzstamm","holzstaemme"}),
        "Duerfte sich um Eichenholz handeln."
        );
  AddDetail("handel",
      "Es wird Handel mit Waren aller Art getrieben.\n");

  AddDetail("waren",
      "Alles, was sich verkaufen laesst, wird verkauft.\n");

  AddDetail("geschaefte",
      "Reger Handel, laesst Kyranda erbluehen.\n");

  AddDetail("kyranda",
      "Du stehst inmitten drinnen.\n");

  AddDetail("buerger",
      "Gar keiner da?! Oder doch?!\n");

  AddDetail( ({"himmel"}),
      "Himmelblauer Himmel.");

  AddDetail(({"boden", "weg"}),
      "Ein ganz normaler Weg.\n");

  AddDetail("eichenholz",
      "Edles Holz.\n");
  AddDetail(({"schild"}),
        "Das Schild sieht sehr widerstandsfaehig aus."
        );
  AddDetail(({"mauer","burgmauer"}),
        "Weit, weit im Osten ist die Mauer zu sehen."
        );
  AddDetail(({"marktgasse","gasse"}),
        "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "+
        "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne."
        );

  AddExit("osten",ROOM("15x9y.lpc"));
  AddExit("westen",ROOM("15x7y.lpc"));
  AddExit("sueden",BURG("shop/experte.lpc"));
}
