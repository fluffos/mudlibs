inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

int i;
mapping ruelpser = ([]);
string sfunc();

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
    "Die Marktgasse fuehrt sowohl im Norden als auch im Sueden weiter. "
    "In einiger Entfernung kannst Du in noerdlicher Richtung Schilder sehen, "
    "welche ueber den Eingaengen der Haeuser haengen. Weiter im Sueden erkennst "
    "Du eine Biegung, die in den Westen fuehrt. Im Osten geht es in ein kleines "
    "Haus.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);

  i=0;

  AddDetail(({"boden"}),
    "Du stehst auf der Marktgasse.");

  AddDetail(({"biegung"}),
    "Im Sueden biegt sich die Marktgasse nach Westen.");

  AddDetail( ({"sueden","westen"}),
    "Das kannst Du Dir erst ansehen, wenn Du dort bist.");

  AddDetail(({"eingang","eingaenge"}),
    "Oeffnungen durch die man die Haeuser betreten kann.");

  AddDetail( ({"oeffnungen"}),
    "Kurz Eingang genannt.");

  AddDetail(({"haeuser","lokale","verkaufslokale","unterkunft"}),
    "Die kleinen Blockhuetten dienen sowohl als Verkaufslokale als auch "
    "als Unterkunft fuer die Buerger.");

  AddDetail(({"schild","schilder","norden"}),
    "Die Schilder zeigen jede einzelne Handelszunft.");

  AddDetail(({"handel","zunft","handelszunft"}),
    "Jaja, handelsfreudig sind sie schon, die Kyrander.");

  AddDetail(({"kyrander","buerger"}),
    "Keiner da?! Oder doch!");

  AddDetail(({"geschaefte","geschaeft"}),
    "Vielleicht koenntest ja Du auch Geschaefte machen. Verkauf doch was.");

  AddDetail(({"haus"}),
    "Hui, das ist verfallen. Was da wohl drinnen sein mag?");

  AddDetail(({"osten"}),
    "Da steht ein altes Haus.");

  AddDetail(({"himmel", "sonne", "sonnenschein"}),
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.");

  AddDetail( ({"tag"}),
    "Wenn Du so weitermachst, stehst Du morgen noch hier.");

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "
    "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne.");

  AddDetail( ({"buehne"}),
    "Die ist von hier aus nicht zu sehen.");

  AddDetail(({"huetten","huette","blockhuette","blockhuetten"}),
    "Sie sehen gemuetlich aus.");

  AddDetail(({"richtung","richtungen"}),
    "Osten, Sueden, Norden, Westen sind alles Richtungen.");

  AddDetail( ({"entfernung"}),
    "Das heisst normalerweise, dass man hingehen soll, um es sich anzusehen.");

  AddSmell(DEFAULT_SMELL,
    "Aus dem Osten schlaegt Dir ueberwaeltigender Alkoholgeruch entgegen.");

  AddSmell( ({"osten","alkohol","alkoholgeruch","geruch"}),
    "Dir wird fast speiuebel.");

  AddSound(DEFAULT_SOUND,
    "Die aus dem Osten kommenden Geraeusche ueberdecken alles andere was man "
    "hoeren koennte.");

  AddSound( ({"osten","geraeusch","geraeusche"}),
    "Ein staendiges Ruelpsen und Kotzen anscheinend.");

  AddSound( ({"ruelpsen","kotzen"}), #'sfunc);

  AddExit("norden",ROOM("13x9y.lpc"));
  AddExit("sueden",ROOM("15x9y.lpc"));
  AddExit("osten", "/gilden/zechpreller");
  //achtung ... bitte raumausgang bei den zechis angleichen!
}

string sfunc()
{
  write( "Du musst Dich schon zusammenreissen um Dich nicht selbst zu uebergeben,\n");
  if (!member(ruelpser, getuid(this_player())))
  {   
    this_player()->AddHp(-10-random(20));
    this_player()->SetProp(P_FOOD, this_player()->QueryProp(P_FOOD) / 2);
    this_player()->SetProp(P_DRINK, this_player()->QueryProp(P_DRINK) / 2);
    this_player()->SetProp(P_ALCOHOL, this_player()->QueryProp(P_ALCOHOL) / 2);
  //  koennte man hier eventuell auch noch ein sabberlatzfunktion einbauen? (1x pro reset zb)?
    ruelpser += ([getuid(this_player()): 1]);
      return"schaffst es aber nicht.\n";
  }
  return "und schaffst es gerade noch.\n";
}

void reset()
{
  ::reset();
  ruelpser = ([]);
}

