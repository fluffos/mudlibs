inherit "std/room";

#include <moredef.h>
#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>

int da = 1;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Arkadische Promenade");
  SetProp(P_INT_LONG,
    "Du befindest Dich nun auf einem Holzweg rund um den Teich. Im Westen siehst "
    "Du den Teich noch weiter bis zum Mauereck gehen und nordwestlich und suedlich wird "
    "der Teich von der Burgmauer begrenzt.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));

  AddDetail( ({"himmel"}),
      "Irgendwo ueber Dir.");

  AddDetail(({"holzweg", "boden", "weg"}),
    "Der Weg auf dem Du gerade stehst, ist eigentlich eine Ansammlung von "
    "Holzbrettern, die zwischen mehreren Pfosten vernagelt sind. Auf der "
    "teichzugewandten Seite siehst Du einen Handlauf zwischen den Pfosten.");

  AddDetail(({"eck","mauereck"}),
    "Da macht die Mauer eine Biegung.");

  AddDetail( ({"biegung"}),
    "Was sich hinter der Biegung befindet, kannst Du nur innerhalb der Mauer sehen.");

  AddDetail(({"ansammlung"}),
    "Das heisst, dass es viele sind.");

  AddDetail(({"holzbretter"}),
    "Die sind alle schoen gleich lang gemacht, damit niemand hier durch eine "
    "Luecke runterfaellt.");

  AddDetail( ({"pfosten"}),
    "Sie wurden tief in den Teichgrund gerammt. Es sieht so aus, wie wenn einer "
    "der Naegel, die hier alles halten, locker waere.");

  AddDetail( ({"naegel"}),
    "Einer davon schaut aus, als waere er locker.");

  AddDetail( ({"nagel"}),
    "Tatsaechlich. Du koenntest versuchen ihn heraus zu ziehen.");

  AddCmd("ziehe|zieh&nagel raus|nagel heraus|nagel", "cmd_ziehe", 
      "Was willst Du herausziehen?");

  AddDetail(({"teichgrund"}),
    "Den kannst Du hier nirgends sehen.");

  AddDetail(({"handlauf", "stueck"}),
    "Ein einfaches, langes Stueck Holz das an der Teichseite angebracht wurde.");

  AddDetail(({"luecke"}),
    "Jetzt wo Du genauer hinsiehst, merkst Du das da tatsaechlich eine ist. "
    "Allerdings kannst Du nicht erkennen was in ihr ist.");

  AddCmd("greif|greife&in luecke|luecke","cmd_greif", "Greife wohinein?");

  AddDetail(({"holz", "eichenholz"}),
    "Das ist alles sehr stabiles Eichenholz.");

  AddDetail( ({"eiche"}),
    "Die steht jetzt nirgends mehr.");

  AddDetail( ({"seite","teichseite"}),
    "Da ist der Teich.");

  AddDetail(({"ueberdachung","giebeldach","dach"}),
    "Ein schlichtes Giebeldach, das, wie auch alles andere hier, aus Holz besteht.");

  AddDetail(({"teich"}),
    "Ein ganz normaler Teich. Du siehst einige Fische darin schwimmen und in Richtung "
    "Norden stehen einige Wasserpflanzen. Weiter im Norden siehst noch einige unscharfe "
    "Umrisse unter Wasser.");

  AddDetail( ({"umrisse"}),
    "Du kannst von hier aus nicht erkennen was es ist.");

  AddDetail( ({"wasser"}),
    "Sieht irgendwie abgestanden aus.");

  AddDetail( ({"fisch","fische"}),
    "Und schon ist er wieder weg.");

  AddDetail( ({"wasserpflanzen","pflanzen"}),
    "Die siehst Du dir am besten vom Rand des Teichs aus an.");

  AddDetail( ({"rand"}),
    "Der ist nicht hier.");

  AddDetail(({"sueden"}),
    "Da ist die Burgmauer.");

  AddDetail( ({"burgmauer","mauer"}),
    "Eine schlichte Mauer aus vielen grossen Steinen.");

  AddDetail( ({"steine"}),
    "Die wurden sicher von weit her nach Kyranda geschafft.");

  AddDetail( ({"kyranda","stadt"}),
    "So heisst die Stadt, in der Du Dich befindest.");

  AddSound(DEFAULT_SOUND,
    "Neben dem Plaetschern des Wassers hoerst Du auch noch ein leises "
    "Blubbern aus der Mitte des Teichs.");

  AddDetail( ({"mitte"}),
    "Irgendetwas scheint sich dort zu befinden.");

  AddSound(({"plaetschern","wasser"}),
    "Das entsteht wenn der Wind das Wasser an die Pfosten treibt.");

  AddSound(({"pfosten"}),
    "Untersuch ihn lieber.");

  AddSound( ({"wind"}),
    "Da ist so wenig, das man ihn nicht hoert.");

  AddSound( ({"blubbern", "luft", "luftblasen", "blasen"}),
    "Es steigen staendig Luftblasen von dort auf.");

  AddSmell(DEFAULT_SMELL,
    "Eigentlich riecht es hier nur nach mehr oder weniger abgestandenem "
    "Teichwasser. Aber der Geruch des Holzes ist doch staerker.");

  AddSmell(({"geruch","holz","ganze"}),
    "Das Ganze hier riecht noch immer wie frisch gesaegt und geschnitten.");

  AddSmell(({"teichwasser","wasser"}),
    "Riecht schon fast ein wenig wie am Friedhof.");

  AddSmell(({"friedhof"}),
    "Irgendwie modrig. Aber nur irgendwie.");

  AddExit("osten",ROOM("16x5y.lpc"));
  AddExit("nordwesten",ROOM("15x3y.lpc"));
}

int cmd_ziehe(string str)
{
  write(BS("Du ziehst den Nagel heraus, woraufhin ploetzlich alles zu "
        "wackeln und knirschen anfaengt. Dir ist so unwohl zu Mute, dass "
        "Du ihn wieder hineinsteckst."));
  return 1;
}

int cmd_greif(string str)
{
  if (da)
  {
    write("Du greifst in die Luecke und findest etwas.\n");
    clone_object(({ OBJ("keks"), OBJ("apfel"), OBJ("gruenflasch"),
          OBJ("bier")})[random(3)])->move(this_player(), M_NOCHECK);
    da = 0;
  }
  else
    write("Du greifst in die Luecke aber findest nichts.\n");
  return 1;
}

void reset()
{
  ::reset();
  da = 1;
}
