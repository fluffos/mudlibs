
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "files.h"

int i;


void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG, 
     "Die Marktgasse endet hier vor der Burgmauer. Weit im Westen ist "
     "eine Kreuzung zu erkennen, direkt vor Dir im Osten ein Eingang in die "
     "Burgmauer. Nordwestlich von Dir steht ein kleines Holzhaeuschen, ueber"
     "dem ein Schild haengt. Suedlich von Dir befindet sich eine Schmiede "
     "und noerdlich geht es in eine kleine Pizzastube.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);
  i=0;


  AddDetail(({"stube","pizzastube"}),
    "Die liegt im Norden.");

  AddDetail(({"kreuzung"}),
    "Die Kreuzung liegt weiter im Westen.");

  AddDetail( ({"westen","nordwesten","osten"}),
    "Geh hin, wenn Du naeheres erfahren willst.");

  AddDetail(({"holzhaeuschen","haeuschen","haus"}),
    "Von hier aus kann man nichts genaueres erkennen."); 

  AddDetail(({"schild"}),
    "Von hier aus kann man nicht genau erkennen, was auf dem Schild "
    "abgebildet ist.");

  AddDetail(({"himmel", "sonne", "sonnenschein"}),
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.");

  AddDetail( ({"sonne"}),
    "Rund und gelb strahlt sie vom Himmel.");

  AddSpecialDetail( ({"tag"}), "det_tag");

  AddDetail(({"mauer","burgmauer"}),
    "Die Burgmauer ist direkt vor Dir. Ein Tor fuehrt ins Innere der Mauer.");

  AddDetail( ({"innere"}),
    "Da Du draussen stehst, kannst Du logischerweise das Innere nicht sehen.");

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse endet hier.");

  AddDetail( ({"boden"}),
    "Er ist mit Kies bedeckt.");

  AddDetail(({"schmiede"}),
    "Die Schmiede ist allseits bekannt fuer ihre wertvollen Produkte.");

  AddDetail(({"produkt","produkte"}),
    "Oh GOTT! (Woody?!) Geh doch einfach mal rein in die Schmiede. =)");

  AddDetail( ({"gott"}),
      "Woody.");

  AddDetail( ({"woody"}),
      "Gott.");

  AddDetail( ({"kies"}),
    "Du faehrst im Kies mit Deinen Schuhspitzen herum, findest aber nichts.");

  AddDetail( ({"schuhspitzen","schuh","spitzen"}),
    "Die sind jetzt ganz dreckig.");

  AddDetail(({"eingang","eingangstor","tor"}),
    "Es ist mindestens 3 Trolle hoch und 5 Oger breit, hat in der Mitte, wo "
    "sich die Torfluegel treffen, eine grosse Gravur. Man koennte meinen, da "
    "passt sogar ein Drache durch. Weiter unten ist eine Tuer eingebaut.");

  AddDetail( ({"trolle","troll","oger","drache"}),
    "Sowas wirst Du in hier ganz sicher nie finden ... oder etwa doch?");

  AddDetail( ({"torfluegel","mitte","gravur"}),
    "In jeder Ecke der Gravur und an ihrer westlichen Seite ist ein Totenkopf "
    "eingraviert.");

  AddDetail( ({"ecke","seite","totenkopf"}),
    "Ob es da etwa gefaehrlich wird?");

  AddSpecialDetail(({"tuer","tuere"}), "tfunc");

  AddDetail( ({"schloss"}),
    "Fuer das gibt es sicher auch den passenden Schluessel.");

  AddDetail( ({"schluessel"}),
    "Nur eben nicht hier.");

  AddSmell(DEFAULT_SMELL,
    "Es duftet hier leicht nach Pizza.");
    
  AddSmell( ({"pizza"}),
    "Geh doch in die Pizzastube und kauf Dir eine.");

  AddSmell( ({"pizzastube"}),
    "Du riechst an ihr, riechst aber nichts besonderes. Untersuche sie gefaelligst.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leises Gemurmel und wie jemand etwas auf einen Amboss bearbeitet");
    
  AddSound( ({"gemurmel"}),
    "Das kommt vermutlich aus der Pizzastube.");
  
  AddSound( ({"pizzastube","schmiede"}),
    "Du lauschst an ihr, hoerst aber nichts besonderes. Untersuche sie gefaelligst.");

  AddSound( ({"amboss"}),
    "Das kommt wohl aus der Schmiede.");

  AddCmd("oeffne","aufunc");

  AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);

  AddExit("westen",ROOM("12x10y.lpc"));
  AddExit("norden",BURG("shop/pizzastube.lpc"));

  //AddSpecialExit("sueden", "sueden_sperre");

  AddExit("sueden","/d/ebene/lamuerte/drachen/schmied_new.lpc");

  AddSpecialExit("ostoben","ofunc");
  AddSpecialExit("osten","ofunc");

  SetProp(P_HIDE_EXITS, ({ "osten" }));

}

//sueden_sperre()
//{
//  write("Haegar ist gerade in Urlaub, deshalb ist seine Schmiede geschlossen.\n");
//  return 1;
//}

tfunc()
{
  string ret;
  ret = 
    "Man kann nicht immer das ganze Tor aufmachen, wenn jemand rein will ...\n"
    "Sie hat ausserdem ein kleines Schloss.\n";
  if (i==0)
  {
    ret +="Die Tuer ist fest verschlossen.\nMal mit oeffnen versuchen?\n";
    return ret;;
  }

  if (i!=0)
  {
    ret +="Die Tuer zur Burgmauer steht offen.\n";
    return ret;;
  }
  write ("error in Door, contact WIZARD!!");
  return "";
}

int aufunc(string str)
{
  object ob;
  if (!str)
  {
    notify_fail("So nicht!\n");
    return 0;
  }

  if (str=="tuer" || str == "tor" || str=="eingangstor" ||
      str=="tuer mit schluessel" || str=="tor mit schluessel" ||
      str=="tuer mit bund" || str=="tuer mit schluesselbund" ||
      str=="tor mit bund" || str=="tor mit schluesselbund")
  {
    if (!IS_WIZARD(this_player()) && !ob=deep_present("\ntorkey",this_player()))
    {
      write ("Du brauchst den richtigen Schluessel um hier durchzukommen.\n");
      return 1;
    }
    write("Du steckst den Schuessel ins Schloss, sperrst auf und oeffnest\n"+
        "die Tuer. Durch magische Kraefte verschwindet der Schluessel.\n");
    say(this_player()->QueryProp(P_NAME)+" oeffnet eine Tuer.\n"); 
    if (!IS_WIZARD(this_player())) ob->remove();
    i=1;
    return 1;
  }

  notify_fail("Was willst Du denn oeffnen?\n");
  return 0;
}

ofunc()
{
  if (i==0)
  {
    write("WUMMMS. Du rennst mit voller Wucht gegen das Eingangstor!\n");
    this_player()->reduce_hit_point(20);
    return 1;
  }

  this_player()->move(BURGMAUER("10_05.lpc"),M_GO,"durch die Tuere");
  return 1;
}

void reset()
{
  ::reset();
  i=0;
  find_object("/d/ebene/lamuerte/burg/weg/17x6y.lpc")->checkkey();
}  

string _query_int_long()
{
  return  break_string(
      "Die Marktgasse endet hier vor der Burgmauer. Weit im Westen ist "
      "eine Kreuzung zu erkennen, direkt vor Dir im Osten ein " +
      (i?"geoeffneter":"geschlossener")+ " Eingang in die "
      "Burgmauer. Westlich von Dir steht ein kleines Holzhaeuschen, ueber dem "
      "ein Schild haengt. Suedlich von Dir befindet sich eine Schmiede "
      "und noerdlich geht es in eine kleine Pizzastube.",78);
}

string det_tag()
{
  return "Heute ist der " + dtime()[0..16] + ".\n";
}
