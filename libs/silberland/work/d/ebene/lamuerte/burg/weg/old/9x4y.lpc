inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
        "Verfolgt man die Pferdegasse in den Norden gelangt man an eine Kreuzung, "+
        "welche von hier aus noch kaum auszumachen ist. Auch hier sieht der Boden "+
        "ziemlich niedergetrampelt von den Pferden aus. Weit im Sueden gelangst "+
        "Du von hier aus zum Burgweg." );

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));

  AddSound(DEFAULT_SOUND,"Du horchst herum, hoerst aber nichts.");
  AddDetail( ({"himmel", "blau"}),
      "Du siehst nach oben. Nichts als strahlendes Blau.\n");

  AddDetail(({"spur","spuren"}),
      "Eindeutig! Spuren von Pferden.\n");

  AddDetail(({"boden"}),
        "Am Boden sind die Spuren von Pferden zu sehen."
        );

  AddDetail(({"knechte"}),
        "Die Knechte sind fuer die Pflege der Pferde zustaendig."
        );

  AddDetail(({"kreuzung"}),
        "Die Kreuzung ist von hier aus kaum auszumachen."
        );

  AddDetail(({"pferde","pferd"}),
        "Es sind keine Pferde zu sehen."
        );

  AddDetail(({"burgweg"}),
        "Der Burgweg befindet sich weiter im Sueden."
        );

  AddDetail(({"hauptgasse"}),
        "Die Hauptgasse befindet sich weiter im Norden."
        );


  AddDetail(({"pferdegasse","gasse"}),
        "Die Gasse verbindet den Burgweg mit der Hauptgasse. "
        );



  AddExit("sueden",ROOM("10x4y.lpc"));
  AddExit("norden",ROOM("8x4y.lpc"));

}
