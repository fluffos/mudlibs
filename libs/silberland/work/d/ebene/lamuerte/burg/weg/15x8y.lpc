inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
    "Die Marktgasse fuehrt schnurgerade vom Westen in den Osten. Im Sueden "
    "befindet sich eine Blockhuette, ueber der ein schmiedeeisernes Schild, "
    "welches eine Axt und ein Schwert zeigt, haengt.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);

  AddDetail(({"axt", "schwert", "zeichen"}),
    "Es handelt sich dabei wohl um das Zeichen eines Waffenhaendlers.");

  AddDetail(({"huette","blockhuette"}),
    "Die Huette ist aus dicken Holzstaemmen gebaut. Dem Schild nach zu "
    "urteilen, handelt es sich um einen Waffenhaendler.");

  AddDetail(({"staemme", "holz","holzstamm","holzstaemme"}),
    "Duerfte sich um Eichenholz handeln.");

  AddDetail( ({"waffenhaendler", "sueden"}),
    "Der Waffenhaendler befindet sich im Sueden, geh hin und schau es Dir an.");

  AddDetail(({"eichenholz"}),
    "Edles Holz.");

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "
    "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne.");

  AddDetail( ({"westen","hauptweg"}),
    "Im Westen geht es zurueck auf den Hauptweg.");

  AddDetail(({"handel"}),
    "Es wird Handel mit Waren aller Art getrieben.");

  AddDetail(({"waren","art"}),
    "Alles, was sich verkaufen laesst, wird verkauft.");

  AddDetail(({"geschaefte","geschaeft"}),
    "Reger Handel laesst Kyranda erbluehen.");

  AddDetail(({"kyranda"}),
    "Du stehst inmitten drinnen.");

  AddDetail(({"buerger"}),
    "Gar keiner da?! Oder doch?!");

  AddDetail(({"himmel"}),
    "Himmelblauer Himmel.");

  AddDetail(({"boden", "weg"}),
    "Ein ganz normaler Weg.");

  AddDetail(({"schild"}),
    "Das Schild sieht sehr widerstandsfaehig aus.");

  AddDetail(({"mauer", "osten"}),
    "Weit, weit im Osten ist die Mauer zu sehen.");

  AddDetail( ({"buehne"}),
    "Das war zwar nur sprichwoertlich gemeint, aber eine Buehne gibt es "
    "in Kyranda auch.");

  AddSmell(DEFAULT_SMELL,
    "Das einzige was man hier riecht, ist der Geruch aus dem Sueden.");

  AddSmell( ({"geruch","sueden"}),
    "Das riecht wie heisses Metall.");

  AddSmell(({"metall"}),
    "Das siehst Du nicht, das riechst Du derzeit nur.");

  AddSound(DEFAULT_SOUND,
    "Das einzige was hier unueberhoerbar ist, sind die Geraeusche aus "
    "der Schmiede.");

  AddSound( ({"geraeusche","schmiede"}),
    "Hoert sich so an also wuerde jemand etwas schmieden.");

  AddExit("osten",ROOM("15x9y.lpc"));
  AddExit("westen",ROOM("15x7y.lpc"));
  AddExit("sueden",BURG("shop/experte.lpc"));
}
