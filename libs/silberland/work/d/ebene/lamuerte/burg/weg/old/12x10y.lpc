
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
        "Die Marktgasse fuehrt vom Westen in den Osten. Im Westen ist "+
        "eine Kreuzung zu erkennen, weiter im Osten ist die imposante Burgmauer "+
        "der Stadt zu erblicken. Es sieht so aus als ob in der Mauer ein Eingang "+
        "waere. Im Norden steht ein kleines Holzhaeuschen, ueber dem ein Schild "+
        "haengt und im Sueden gehts in einen Naehladen.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_LIGHT,1);

  AddDetail(({"kraeuter"}),
      "Die einzigen Kraeuter, die Du siehst, sind auf dem kleinen Schild aufgemalt.\n");

  AddDetail("naehladen",
      "Der ist im Sueden.");

  AddDetail(({"kreuzung"}),
      "Die Kreuzung liegt weiter im Westen.\n");

  AddDetail(({"eingang","eingaenge", "oeffnung", "oeffnungnen"}),
      "Oeffnungen, durch die man ein Haus betreten kann.\n");

  AddDetail(({"haeuschen","haus","haeuser","huette","blockhoette", "holzhaeuschen"}),
      "Die Haeuschen ist aus Holz gebaut. Ueber dem Eingang haengt ein "+
      "kleines Schild.");

  AddDetail(({"schild","schilder","eisenschilder"}),
      "Auf dem Schild sind die verschiedensten Kraeuter abgebildet.");

  AddDetail(({"himmel"}),
      "Blauer Himmel, ein wirklich wundervoller Tag.");

  AddDetail(({"punkt"}),
      "Du suchst den wirklich westlichsten Punkt den Du finden kannst.");

  AddDetail(({"mauer","burgmauer"}),
      "Die Burgmauer ist weiter im Osten. Es scheint, als ob dort ein Tor "+
      "in der Mauer waere.");

  AddDetail( ({"osten", "tor"}),
      "Im Osten scheint ein Tor zu sein.");

  AddDetail(({"marktgasse","gasse"}),
      "Die Marktgasse verlaeuft vom Westen in den Osten.\n");

  AddDetail("boden",
      "Der Boden weist keine Besonderheiten auf.\n");

  AddDetail("stadt",
      "Du stehst mitten drinnen.\n");

  AddDetail("holz",
      "Koennte Buchenholz sein.\n");

  AddDetail("buchenholz",
      "Ja, es ist Buchenholz.\n");

  AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",BURG("shop/kraeuterladen.lpc"));
  AddExit("westen",ROOM("12x9y.lpc"));
  AddExit("osten",ROOM("12x11y.lpc"));
  AddExit("sueden",BURG("shop/naehstube"));
}
