inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Die Hauptgasse endet hier in einer Sackgasse. Im Westen gelangt man "
    "zurueck, vorbei an der prachtvollen Kirche, zur Pferdegasse. Die "
    "Kirchtuerme der Kirche sind von hier aus gut zu sehen. Sie sehen wirklich "
    "beeindruckend aus.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddDetail( ({"himmel", "blau"}),
    "Du siehst nach oben. Nichts als strahlendes Blau.");

  AddSpecialDetail( ({"nichts"}), "bfunc");

  AddDetail(({"blau"}),
    "So blau wie Zechus.");

  AddDetail( ({"zechus"}),
    "Den findest Du woanders in der Stadt.");

  AddDetail(({"stadt"}),
    "Du siehst Dich um und stellst fest, dass Du wirklich in der Stadt stehst.");

  AddDetail("boden",
    "Du untersuchst den Boden, findest aber nichts.");

  AddDetail(({"kirche","gebaeude"}),
    "Die Kirche ist im Westen zu sehen.");

  AddDetail(({"westen"}),
    "Im Westen ist sowohl die Pferdegasse, als auch die Kirche.");

  AddDetail(({"turm","tuerme", "kirchturm", "kirchtuerme"}),
    "Das sind wahrscheinlich die groessten Tuerme die Du je gesehen hast. "
    "Sie muessen von Meisterhand erbaut worden sein.");

  AddDetail(({"meisterhand","meister", "baukunst"}),
    "Nur ein Meister der Baukunst kann solche Tuerme erbauen.");

  AddDetail(({"hauptgasse", "gasse"}),
    "Die Hauptgasse endet hier.");

  AddDetail(({"pferdegasse"}),
    "Die Pferdegasse beginnt irgendwo weiter im Westen.");

  AddDetail("sackgasse",
    "Die Gasse endet hier. Allerdings kannst Du eine Tafel an der Ostwand "
    "entdecken.");

  AddDetail( ({"tafel"}),
    "Lies sie.");

  AddReadDetail( ({"tafel"}),
    "+---------------------+\n"
    "|       Theater       |\n"
    "|                     |\n"
    "|  Derzeit wegen den  |\n"
    "|    Umbauarbeiten    |\n"
    "|    geschlossen.     |\n"
    "+---------------------+\n"
    ""
    "Du denkst Dir . o O (So ein Theater ...)");

  AddDetail("theater",
      "Das ist momentan geschlossen.");

  AddDetail( ({"ostwand","wand"}),
    "Sie besteht derzeit aus einer notduerftig zusammengezimmerten Holzwand.");

  AddDetail( ({"holzwand"}),
    "Sie besteht, wie sollte es auch anders sein, aus Holz.");

  AddDetail(({"holz","holzsorten","sorten"}),
    "Da sind so viele verschiedene Holzsorten verwendet worden das Du sie gar "
    "nicht zaehlen magst.");

  AddSound(DEFAULT_SOUND,
    "Du horchst herum, und hoerst Baulaerm?");

  AddSound(({"baulaerm"}),
    "Eine Kakophonie aus Haemmer-, Saege-, Hobelgeraeuschen und Stimmen.");

  AddSound(({"geraeusche","haemmergeraeusche","saegegeraeusche","hobelgeraeusche"}),
    "Hau Hau, Saeg Saeg, Ritsch Ratsch, Plonk.\n"
    "'Auuuuuuuuuutsch'\n'Achtung mir sind die Naegel runtergefallen.'\n"
    "'SAG DAS GEFAELLIGST VORHER.'");

  AddSound( ({"kakophonie"}),
    "Das ist NICHT das woran DU gerade denkst.");

  AddSmell(DEFAULT_SMELL,
    "Ein leichter Holzgeruch ist wahrnehmbar.");

  AddSmell( ({"holzgeruch","geruch","holz"}),
    "Der kommt von der Holzwand bzw. von der Tafel.");

  AddSmell( ({"holzwand","tafel", "wand"}),
    "Nicht riechen, untersuchen!");

  AddExit("westen",ROOM("7x6y.lpc"));
}

string bfunc()
{
  write("[Tod:Lars] Nichts hat gerade "+this_player()->QueryProp(P_NAME)+" umgebracht.\n");
  write("[Tod:"+this_player()->QueryProp(P_NAME)+"] Verdammt schon wieder wegen Nichts gestorben.\n");
  return "";
}
