
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
        "Du stehst inmitten einer Kreuzung auf der Marktgasse. Im Norden siehst "
        "Du den Eingang in eine Huette. Ueber der Huette haengt ein Schild, "
        "welches die Zunft der Bierbrauer zeigt. Im Osten verlaeuft die Gasse in "
        "Richtung der Burgmauer. Eine kleine Holzplatte an einem Pfosten steht im "
        "Mittelpunkt der Kreuzung.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);

  AddDetail(({"halterung","pfosten"}),
    "Der Pfosten dient als Halterung fuer die Holzplatte.");

  AddDetail(({"platte","holzplatte"}),
    "Die Holzplatte dient wohl als Wegweiser.");

  AddDetail(({"wegweiser"}),
    "Was soll mit dem schon sein?");

  AddReadDetail(({"wegweiser"}),
    "Brauerei\n"
    " <>\n"
    " <>\n"
    " <><><> Burgmauer\n"
    " <>\n"
    " <>\n"
    "Waffenhaendler\n\n");

  AddDetail(({"kreuzung","mittelpunkt"}),
    "Du stehst mitten drin.");

  AddDetail(({"eingang","oeffnungen"}),
    "Oeffnungen durch die man ein Haus betreten kann. Dir faellt auch der "
    "eine Eingang im Westen auf.");

  AddSpecialDetail( ({"westen"}), "det_westen");

  AddDetail(({"huette","blockhuette", "haus", "holzhuette"}),
    "Die Blockhuette ist aus Holz gebaut. Sie gehoert wohl dem Wirt von "
    "Kyranda.");

  AddDetail(({"schild"}),
    "Du kannst auf dem Schild im Norden die Zunft der Brauer ausmachen.");

  AddDetail( ({"zunft","brauer","bierbrauer","norden"}),
    "Wenn mehr Du mehr darueber wissen willst, geh einfach hin.");

  AddDetail( ({"richtung"}),
    "Hier gibts es drei beschriebene Richtungen: Norden, Osten, Sueden.");

  AddDetail(({"himmel"}),
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.");

  AddDetail( ({"sonne","schein","sonnenschein"}),
   "Die Sonne strahlt warm und einladend vom Himmel herab.");

  AddDetail( ({"tag"}),
    "Heute ist nicht gestern und nicht morgen.");

  AddDetail(({"mauer","burgmauer","osten"}),
    "Die Burgmauer ist weiter im Osten.");

  AddDetail(({"marktgasse","gasse"}),
    "Du stehst auf der Gasse. Vor Dir befindet sich eine Blockhuette.");

  AddDetail(({"wirt"}),
    "Der Wirt ist in der Holzhuette.");

  AddDetail(({"holz"}),
    "Echtes Holz! Einmalig!");

  AddDetail(({"kyranda", "stadt"}),
    "Schon gut, Du stehst ja inmitten der Stadt.");

  AddDetail(({"boden"}),
    "Ein stinknormaler, sehr gewoehnlicher Boden.");

  AddSmell(DEFAULT_SMELL,
    "Aus der Bierbrauerei kannst Du schon den verlockenden Duft frisch"
    "gebrauten Bieres riechen.");

  AddSmell( ({"duft","bier"}),
    "Was? Du weisst nicht wie Bier riecht? Dann ab in die Brauerei mit Dir!");

  AddSmell( ({"bierbrauerei","brauerei"}),
    "Nicht riechen; hingehen.");

  AddSound(DEFAULT_SOUND,
    "Eigentlich ist es hier ziemlich ruhig, nur hin und wieder hoerst Du aus "
    "dem Norden einige unangenehme Geraeusche.");

  AddSound( ({"geraeusche"}),
    "Ich glaube, die muss man hier nicht naeher beschreiben.");

  AddItem(NPC("betrunkener.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",BURG("shop/brauerei.lpc"));
  AddExit("sueden",ROOM("13x9y.lpc"));
  AddExit("osten",ROOM("12x10y.lpc"));

}

string det_westen()
{
  if (member(m_indices(QueryProp(P_EXITS)), "westen") != -1)
    return "Da kannst hineingehen wenn Du willst.\n";
  else
    return "Der Eingang nach Westen ist leider vernagelt.\n";
}
