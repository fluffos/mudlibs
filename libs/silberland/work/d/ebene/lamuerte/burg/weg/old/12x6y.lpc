inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
        "Hier fuehrt der Burgweg vom Sueden in den Norden. Dem Kiesweg nach zu urteilen, "+
        "duerfte es sich um einen wichtigen Weg handeln, da er ziemlich nieder"+
        "getreten aussieht. Ein kleines Schild auf einem Holzpflock steht inmitten "+
        "der des Weges."
        );
  AddSound(DEFAULT_SOUND,"Du horchst herum, hoerst aber nichts.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27]));


  AddDetail(({"holz","pflock","holzpflock","halterung"}),
        "Ein langer Pflock der in den Kies eingeschlagen ist. Er dient als" +
        " Halterung fuer das Schild."
        );



  AddDetail(({"schild"}),
        "Probiers mal mit lesen."
        );

  AddReadDetail(({"schild"}),
      "      Pferdegasse \n" +
      "          ><      \n" +
      "          **      \n" +
      "          <><> Marktgasse\n" +
      "          <> \n" +   
      "          <> \n" + 
      "       Haupttor \n"+     
      "\n"+
      "** Du stehst hier\n" 
      );

  AddDetail(({"kreuzung"}),
        "Eine Kreuzung verbindet verschiedene Wege miteinander."
        );

  AddDetail("boden",
      "Kies soweit das Auge reicht.\n");

  AddDetail("einwohner",
      "Schau Dich um? Sieht Du nirgendwo einen Buerger herumlaufen?\n");

  AddDetail(({"kies","kiesweg","weg","burgweg"}),
        "Der Kiesweg ist hier ziemlich ausgetreten. Offenbar wird er von vielen "+
        "Einwohnern benutzt."
        );

  AddDetail(({"himmel", "blau"}),
        "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "+
        "Hoffentlich faengt es nicht zu regnen an."
        );

  AddExit("norden",ROOM("11x6y.lpc"));
  AddExit("sueden",ROOM("14x6y.lpc"));

}
