inherit "std/room";

#include <moredef.h>
#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Arkadische Promenade");
  SetProp(P_INT_LONG,
    "Du befindest Dich nun auf einem Holzweg rund um den Teich. Im Sueden siehst "
    "Du den Teich noch weiter bis zum Mauereck gehen, im Westen und Suedosten wird "
    "der Teich von der Burgmauer begrenzt.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));

  AddDetail( ({"himmel"}),
      "Irgendwo ueber Dir.");

  AddDetail(({"holzweg", "weg", "boden"}),
    "Der Weg auf dem Du gerade stehst, ist eigentlich eine Ansammlung von "
    "Holzbrettern, die zwischen mehreren Pfosten vernagelt sind. Auf der "
    "teichzugewandten Seite siehst Du einen Handlauf zwischen den Pfosten.");

  AddDetail(({"boden"}),
    "Du bist gerade auf dem Holzweg.");

  AddDetail(({"eck","mauereck"}),
    "Da macht die Mauer eine Biegung.");

  AddDetail( ({"biegung"}),
    "Was sich hinter der Biegung befindet, kannst Du nur innerhalb der Mauer sehen.");

  AddDetail(({"ansammlung"}),
    "Das heisst, dass es viele sind.");

  AddDetail(({"holzbretter"}),
    "Die sind alle schoen gleich lang gemacht, damit niemand hier durch eine "
    "Luecke runterfaellt.");

  AddDetail( ({"luecke"}),
     "Die einzige Luecke die Du hier siehst, ist jene in der Ueberdachung.");

  AddDetail( ({"pfosten"}),
    "Sie wurden tief in den Teichgrund gerammt.");

  AddDetail(({"teichgrund"}),
    "Den kannst Du hier nirgends sehen.");

  AddDetail(({"handlauf", "stueck"}),
    "Ein einfaches, langes Stueck Holz das an der Teichseite angebracht wurde.");

  AddDetail(({"holz", "eichenholz"}),
    "Das ist alles sehr stabiles Eichenholz.");

  AddDetail( ({"eiche"}),
    "Die steht jetzt nirgends mehr.");

  AddDetail( ({"seite","teichseite"}),
    "Da ist der Teich.");

  AddDetail(({"ueberdachung","giebeldach","dach"}),
    "Ein schlichtes Giebeldach, das, wie auch alles andere hier, aus Holz besteht. "
    "Durch eine Luecke faellt ein Sonnenstrahl herein und zeichnet lustige Muster "
    "auf den Boden.");

  AddDetail( ({"sonnenstrahl"}),
    "Da Du ihn auf dem Weg zum Boden stoerst, kitzelt er Dich an der Nase.");

  AddDetail( ({"nase"}),
    "Haaaaaa-tschi! Gesundheit!");

  AddDetail( ({"muster"}),
    "Die ergeben eigentlich keinen Sinn, sind aber trotzdem schoen.");

  AddDetail( ({"sinn"}),
    "Keinen.");

  AddDetail(({"teich"}),
    "Ein ganz normaler Teich. Du siehst einige Fische darin schwimmen und am Rand "
    "stehen einige Wasserpflanzen. Im Osten siehst Du noch Umrisse unter Wasser.");

  AddDetail(({"wasser"}),
    "Sieht abgestanden aus.");

  AddDetail(({"umrisse"}),
    "Von hier aus kannst Du erkennen, dass es sich um alte Ueberreste eines gemauerten "
    "Brunnen handeln muss.");

  AddDetail( ({"ueberreste","brunnen"}),
    "Warum hat man diesen Ort bloss mit Wasser geflutet?");

  AddDetail( ({"ort"}),
    "Na, der Teich hier.");

  AddDetail( ({"fisch","fische"}),
    "Und schon ist er wieder weg.");

  AddDetail( ({"wasserpflanzen","pflanzen"}),
    "Die siehst Du dir am besten vom Rand des Teichs aus an.");

  AddDetail( ({"rand"}),
    "Der ist nicht hier.");

  AddDetail(({"suedseite"}),
    "Da ist die Burgmauer.");

  AddDetail( ({"burgmauer","mauer"}),
    "Eine schlichte Mauer aus vielen grossen Steinen. In einem siehst Du ein "
    "groesseres Loch.");

  AddDetail( ({"loch"}),
    "Es ist gerade mal gross genug das Du hindurchschauen kannst.");

  AddCmd("schau|schaue&in loch|loch","cmd_schau", "Wohin willst Du schauen?");

  AddDetail( ({"steine"}),
    "Die wurden sicher von weit her nach Kyranda geschafft.");

  AddDetail( ({"kyranda","stadt"}),
    "So heisst die Stadt in der Du Dich befindest.");

  AddSound(DEFAULT_SOUND,
    "Neben dem Plaetschern des Wassers hoerst Du auch noch ein leises "
    "Blubbern aus der Mitte des Teichs.");

  AddDetail( ({"mitte"}),
    "Irgendetwas scheint sich dort zu befinden.");

  AddSound(({"plaetschern","wasser"}),
    "Das entsteht wenn der Wind das Wasser an die Pfosten treibt.");

  AddSound(({"pfosten"}),
    "Untersuch ihn lieber.");

  AddSound( ({"wind"}),
    "Da ist so wenig, das man ihn nicht hoert.");

  AddSound( ({"blubbern", "luftblasen", "blasen", "luft"}),
    "Es steigen staendig Luftblasen von dort auf.");

  AddSmell(DEFAULT_SMELL,
    "Eigentlich riecht es hier nur nach mehr oder weniger abgestandenem "
    "Teichwasser. Aber der Geruch des Holzes ist doch staerker.");

  AddSmell(({"geruch","holz","ganze"}),
    "Das Ganze hier riecht noch immer wie frisch gesaegt und geschnitten.");

  AddSmell(({"teichwasser","wasser"}),
    "Riecht schon fast ein wenig wie am Friedhof.");

  AddSmell(({"friedhof"}),
    "Irgendwie modrig. Aber nur irgendwie.");

  AddItem( NPC("einwohner"), REFRESH_DESTRUCT);
  
  AddExit("norden",ROOM("14x3y.lpc"));
  AddExit("suedosten",ROOM("16x4y.lpc"));
}

int cmd_schau(string str)
{
  write(BS("Als Du hineinsiehst, siehst Du gerade noch einen riesigen "
        "Trollfinger auf Dein Auge zu kommen."));
  this_player()->AddHp(-10-random(10));
  return 1;
}
