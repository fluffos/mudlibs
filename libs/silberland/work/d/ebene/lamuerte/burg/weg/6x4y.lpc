inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Das Ende der Pferdegasse ist erreicht. Die Kreuzung im Sueden ist von "
    "hier aus gut zu erkennen. Im Westen befindet sich der Eingang zu den "
    "Stallungen, in denen die Pferde der Stadt untergebracht sind. Durch "
    "ein Fenster in den Stallungen kann man ins Innere sehen.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);

  AddDetail(({"ende"}),
    "Ende, end, fine, finito. Hier ist das Ende!");

  AddDetail(({"boden"}),
    "Es liegt Heu auf dem Boden herum.");;

  AddDetail(({"heu"}),
    "Strohgelb. Irgendwie erinnert Dich das an (D)eine Freundin.");

  AddDetail(({"freundin", "mudden"}),
    "Die solltest Du neben dem Mudden nicht ganz vergessen.");

  AddDetail( ({"himmel", "blau"}),
    "Du siehst nach oben. Nichts als strahlendes Blau.");

  AddDetail(({"stadt"}),
    "Sieht eigentlich ganz nett aus. Auch wenn Du von hier keine "
    "grossartigen Bauten sehen kannst.");

  AddDetail(({"eingang","westen"}),
    "Der Eingang im Westen fuehrt ins Innere der Stallungen.");

  AddDetail(({"bauten"}),
    "Von hier aus ist noch nichts Auffaelliges zu sehen.");

  AddDetail( ({"auffaelliges"}),
    "Nicht hier.");

  AddDetail(({"knechte", "knecht"}),
    "Die Knechte sind fuer die Pflege der Pferde zustaendig.");

  AddDetail( ({"pflege"}),
    "Pferde gehoeren geschniegelt und gestriegelt.");

  AddDetail(({"kreuzung","sueden"}),
    "Die Kreuzung befindet sich weiter im Sueden.");

  AddDetail(({"stallung","stallungen"}),
    "Du kannst durch ein Fenster der Stallungen ein Pferd erkennen.");

  AddDetail(({"fenster"}),
    "Es ist fast unglaublich, doch das Fenster ist aus echtem Glas!");

  AddDetail(({"glas"}),
    "Sauber geputzt. Du siehst hindurch und entdeckst ein Pferd. "
    "Hin und wieder siehst Du auch einen Knecht vorbeihuschen.");

  AddDetail(({"pferd", "pferde"}),
    "Das Pferd schaut Dich verabscheuend an.");

  AddDetail(({"burgweg"}),
    "Der Burgweg befindet sich weiter im Sueden.");

  AddDetail(({"hauptgasse"}),
    "Die Hauptgasse befindet sich in suedlicher Richtung.");

  AddDetail(({"pferdegasse","gasse"}),
    "Die Pferdegasse endet hier, bei den Stallungen. ");

  AddDetail(({"innere","inneres"}),
    "Du kannst durch ein Fenster reinsehen.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst ab und zu ein Pferd wiehern.");

  AddSound( ({"pferd", "wiehern"}),
    "*PFFRT*PLUMPS* ... Oh das war wohl jetzt kein Wiehern.");

  AddSmell(DEFAULT_SMELL,
    "Es riecht hier schon etwas nach Pferd.");

  AddSmell( ({"pferd"}),
    "Pferdig eben.");

  AddExit("westen",ROOM("6x3y.lpc"));
  AddExit("sueden",ROOM("7x4y.lpc"));
}
