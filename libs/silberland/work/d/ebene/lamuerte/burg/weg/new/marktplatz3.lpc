
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

int i;

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Marktplatz");
  SetProp(P_INT_LONG,break_string(
    "Hier haben sich die Schausteller angesiedelt, das liegt vermutlich daran, "+
    "dass sie vom Casino hier im Sueden ermutigt worden sind. Der Platz ist hier "+
    "sehr angenehm, da am Rand hohe Baeume wachsen, die Schatten spenden. Ein "+
    "glitzernder Teich in der Mitte des Platzes verschoenert auf geheimnisvolle "+
    "Weise den Marktplatz von Kyranda noch mehr."+
    "",78));

  AddSound(DEFAULT_SOUND,break_string("Lautes Geschnatter ertoent von allen Seiten.",78));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24]));

  AddDetail(({"boden"}),break_string(
    "Der Boden ist gepflastert, und hier eigentlich auch ziemlich sauber.",78));
  
  AddDetail("",
    "\n");
  AddDetail(({"burgweg"}),break_string(
    "Der Burgweg befindet sich ein Stueck weiter im Osten.",78));

  AddDetail(({"teich","teichs","ufer"}),break_string(
    "Das Ufer des Teichs ist mit Schilf bewachsen. Einige Seerosen treiben"+
    " auf der Wasseroberflaeche herum.",78));
      
  AddDetail(({"rose","rosen","seerose","seerosen"}),
    "Prachtvolle, weisse Seerosen treiben vom Wind gefuehrt auf dem "+
    "Teich herum. Unter den Blaettern schimmert etwas hervor.");

  AddDetail("blaetter",
   "Als Du die Blaetter genauer betrachtest, faellt Dir eine kleine "+
   "Buechse auf. Ob man sie herausangeln kann?");

  AddDetail( ({"dose","buechse"}),
   "Ja, da ist eine!\n");                 

  AddCmd(({"angel","angle"}),"anfunc");


  AddExit("osten",ROOM("marktplatz4"));
  AddExit("norden",ROOM("marktplatz1"));
  AddExit("sueden",GAMBLE("/room/einraum"));
}

anfunc(str)
 { object ob;
    string item, rod;
      
   notify_fail("Was moechtest Du angeln?\n");
     if (!stringp(str))
   return 0;
                     
    if (sscanf( str, "%s mit %s", item, rod) !=2 )
           {
   write("Angle was denn womit?\n");
      return 1;
           }
                                                         
  if ( (item=="buechse" || item=="dose")  && rod=="angel")
           {
                                                                
                                                                 
  if (!( ob=present ("angel",this_player())))
           {
    write("Du kommst nicht nahe genug ran.\n");
    say (this_player()->QuryProp(P_NAME)+" faellt fast in den Teich.\n");
         return 1;
           } 
       
       ob=present("angel",this_player());                                                                                                         if (ob)
     if (ob)
           { if(i>1 || (deep_present("\nfischbuechse",this_player()))) 
                    {
      write("Vergeblich versuchst Du Dir die Buechse zu angeln.\n");
           return 1;
                   };
      write("Du angelst Dir die Buechse.\n");
        seteuid(getuid(this_object()));
        clone_object(OBJ("\nfischbuechse"))->move(this_player());
                i=2;
              return 1;                                         
       } 
           
               } 
     write ("So angelt man doch nicht.\n");
             return 1;
                   
                 } 
                              
            reset()
           {::reset();
            i=0;
           }
                                 
