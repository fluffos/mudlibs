/* FILE: wasser.c
   INFO: Burggraben bei Kyranda. (SCRIPTFALLE)
   DATE: 11.04.97
   (w) LaMuerte
 */
 
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include "../files.h"

create()
{
 ::create();
 SetProp(P_INT_SHORT,"Im Burggraben");

 SetProp(P_INT_LONG,break_string(
  "Du schwimmst im Burggraben. Ueber Dir ist nur die Ziehbruecke zu sehen. " 
,78));
AddSound(DEFAULT_SOUND,break_string("Blubber, blubber, blubber.",78));
AddSmell(DEFAULT_SMELL,("Hier stinkts nack Kloake.\n"));
SetProp(P_LIGHT,1);
SetProp(P_NO_MNPC,1);
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5]));
AddItem(WWALD("npc/wdaemon.lpc"),REFRESH_DESTRUCT);
AddDetail(({"burggraben","graben"}),
  "Du schwimmst darin herum. Irgendwie ist es maechtig kalt hier drinnen.\n"+
  "Schau das Du rauskommst, bevor Du erfrierst.\n");
AddDetail(({"bruecke","ziehbruecke"}),
  "Die Bruecke ist ober Dir. Viel zu weit oben um raufzuklettern.\n");
   
}

