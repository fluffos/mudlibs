
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"In den Stallungen");
  SetProp(P_INT_LONG,
        "Du stehst inmitten der Stallungen. Irgendwie riecht es hier komisch. "+
        "Die Pferde, welche hier untergebracht sind, stehen in einzelnen durch "+
        "Holzplatten abgetrennten Boxen. Der Boden ist ueberall mit Stroh ausgelegt."+
        " Im Osten fuehrt ein Durchgang ins Freie." );

  AddItem(NPC("knecht.lpc"),REFRESH_DESTRUCT);
  AddSmell(DEFAULT_SMELL,"Es stinkt furchtbar nach Pferd.");
  AddSound(DEFAULT_SOUND,"Ab und an hoerst Du ein Pferd wiehern.");

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));

  AddSmell( ({"pferd","pferde"}),
      "Ihhhh... Das riecht aber wirklich pferdig.\n");

  AddDetail(({"durchgang"}),
        "Eine Oeffnung in der Wand die ins Freie fuehrt.");

  AddDetail("oeffnung",
      "Ein einfacher Durchgang.\n");

  AddDetail(({"stroh"}),
        "Du durchwuehlst das Stroh, findest aber nichts.");
  
  AddDetail(({"boden"}),
        "Man sieht den Boden vor lauter Stroh nicht mehr.");

  AddDetail(({"platten","holzplatten"}),
        "Die Holzplatten weisen nichts besonderes auf.");

  AddDetail(({"abteile", "boxen","box"}),
        "Die Boxen sind durch Holzplatten getrennte Abteile, welche Platz fuer ein "+
        "Pferd bieten.");

  AddDetail(({"pferd","pferde"}),
        "Du untersuchst die Pferde und stellst fest, dass sie alle "+
        "kerngesund sind.");

  AddDetail(({"stallung","stallungen"}),
        "Die Stallung ist fuer die Pferde der Buerger und der Durchreisenden "+
        "erbaut worden.");

  AddDetail("decke",
      "Die Decke weist keine Besonderheiten auf.\n");

  AddDetail(({"wand","waende"}),
      "Die Waende sehen nett aus.\n");


  AddCmd("reite","rfunc");

  AddExit("osten",ROOM("6x4y.lpc"));

}

rfunc(str)
{string was;
  if (!str)
  {write("Auf was willst Du reiten?\n");
    return 1;
  }

  if (!sscanf(str,"auf %s",was))
  {write ("Hmmmm.. So nicht.\n");
    return 1;
  }

  if (was=="pferd")
  {call_out("ride",2);
    write ("Du versuchst auf das Pferd aufzusteigen.\n");
    return 1;
  }

  write("Darauf kann man nicht reiten.\n");
  return 1;
}

ride()
{int i;
  i=random(100);
  if(i<90)
  {write("Das Pferd wirft Dich gnadenlos ab.\n");
    return 1;
  }

  write("Jehaaaa! Du bezwingst das Pferd! \n Du bist der Held des Tages!\n");
  return 1;
  //HIER MAL STP
}

