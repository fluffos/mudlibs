inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Hier kreuzen sich die Pferdegasse und die Hauptgasse. Im Norden kann "
    "man den Eingang zu den Pferdestallungen erkennen. Im Sueden verlaengert "
    "sich die Pferdegasse in Richtung Marktgasse. Im Osten beginnt die Hauptgasse, "
    "welche zur Kirche Kyranda fuehrt. Ein kleiner Wegweiser steht am Wegesrand.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddReadDetail(({"wegweiser"}),
    "+-------------------+\n"
    "+ Stallungen        +\n"
    "+ <>                +\n"
    "+ <>                +\n"
    "+ <><><> Hauptgasse +\n"
    "+ <>                +\n"
    "+ <>                +\n"
    "+ Marktgasse        +\n"
    "+-------------------+\n");

  AddDetail( ({"himmel", "blau"}),
    "Du siehst nach oben. Nichts als strahlendes Blau.");

  AddDetail(({"pfosten","nagel","brett"}),
    "Ein Bestandteil des Wegweisers der am Wegesrand steht.");

  AddDetail(({"wegweiser","bestandteil"}),
    "Der Wegweiser ist aus einem Pfosten, einem Nagel und einem Brett gebaut.");

  AddDetail(({"wegesrand", "rand", "wegrand"}),
    "Am Wegesrand steht ein kleiner Wegweiser.");

  AddDetail(({"stallungen","pferdestallungen", "norden","eingang"}),
    "Die Stallungen liegen weit im Norden. Geh hin, wenn Du sie "
    "untersuchen willst.");

  AddDetail(({"kreuzung"}),
     "Du stehst genau darauf.");

  AddDetail(({"pferde"}),
    "Es sind keine Pferde zu sehen.");

  AddDetail(({"burgweg","sueden"}),
    "Der Burgweg befindet sich weiter im Sueden.");

  AddDetail( ({"stadt","kyranda"}),
    "Die Stadt in der Du Dich befindest heisst Kyranda.");

  AddDetail( ({"richtung"}),
    "Hier gibt es in fast jeder Richtung etwas zu sehen.");

  AddDetail( ({"kirche","osten", "turm"}),
    "Von hier aus kannst Du nur den Turm der Kirche sehen.");

  AddDetail(({"hauptgasse"}),
    "Die Hauptgasse verlaengert sich in oestliche Richtung.");

  AddDetail(({"boden"}),
    "Als Du den Boden untersuchst, faellt Dir ein grosser Haufen Pferdemist "
    "auf. Iiihh ... sieht der ekelerregend aus.");

  AddDetail(({"mist","pferdemist", "haufen"}),
    "Du bist zwar ein Naturbursch, aber das willst Du einfach nicht untersuchen.");

  AddDetail( ({"naturbursch"}),
    "Naja, vielleicht bist Du ja auch ein Naturmaedl. Bei manchen erkennt man das "
    "eben nicht so genau.");

  AddSpecialDetail( ({"naturmaedl"}), "det_maedl");

  AddDetail(({"marktgasse"}),
    "Die ist von hier aus nicht zu sehen.");

  AddDetail(({"pferdegasse"}),
    "Die Gasse fuehrt gerade vom Norden in den Sueden.");

  AddDetail( ({"gasse"}),
    "Welche Gasse meinst Du?");

  AddSound(DEFAULT_SOUND,
    "Du horchst herum, hoerst aber kaum etwas.");

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Pferdemist.");
 
  AddSmell(({"pferdemist", "mist"}),
    "Du willst doch nicht etwa wirklich daran riechen?");

  AddExit("sueden",ROOM("10x4y.lpc"));
  AddExit("norden",ROOM("6x4y.lpc"));
  AddExit("osten",ROOM("7x5y.lpc"));
}

string det_maedl()
{
  if (this_player()->QueryProp(P_GENDER) == FEMALE)
    return "Ja, Du bist scheinbar wirklich eines.\n";
  else
    return "Nein, du bist doch eher ein Naturbursch.\n";
}
