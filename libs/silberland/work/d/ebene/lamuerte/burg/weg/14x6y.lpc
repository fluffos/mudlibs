inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Geradeaus fuehrt der Weg in Richtung Norden. Das Ufer eines "
    "Teichs erstreckt sich vom Suedwesten weiter in den Nordwesten. "
    "Weiter im Sueden fuehrt der Weg aus der Burg. Ausserdem kannst "
    "Du nach Nordwesten auf einen Holzsteg gehen.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddDetail(({"gesamtbild","bild"}),
    QueryProp(P_INT_LONG));

  AddDetail(({"weg","burgweg"}),
    "Der Burgweg fuehrt zu den wichtigsten Einrichtungen der Burg. Er ist "
    "mit Kies ausgelegt und am Rand sind einige Blumen zu sehen. Er fuehrt "
    "von Norden nach Sueden.");

  AddDetail( ({"norden","sueden"}),
    "Da verlaeuft der Burgweg.");

  AddDetail(({"einrichtungen"}),
    "Geh doch weiter, vielleicht findest Du sie noch!");

  AddDetail(({"boden"}),
    "Der Boden ist mit Kies bedeckt.");

  AddDetail(({"kies"}),
    "Der Kies erleichtert das Vorwaertskommen, Deine Schuhe werden auch "
    "nicht so schmutzig wie in der Erde.");

  AddDetail( ({"erde"}),
    "Wenn hier Erde waere, koenntest Du sie auch untersuchen.");

  AddDetail( ({"vorwaertskommen", "schuhe"}),
    "Da Deine Schuhe jetzt nicht dreckig sind, kommst Du schneller damit "
    "vorwaerts.");

  AddDetail( ({"suedwesten", "nordwesten"}),
    "Da siehst Du das Ufer des Teiches.");

  AddDetail(({"blumen","rand"}),
    "Einige unwichtige Blumen. Nichts aufregendes. Sie verschoenern nur das "
    " Gesamtbild des Weges.");

  AddDetail(({"teich","ufer"}),
    "Das Ufer des Teichs ist mit Schilf bewachsen. Einige Seerosen treiben "
    "auf der Wasseroberflaeche herum.");

  AddDetail(({"oberflaeche", "wasseroberflaeche"}),
    "Einige Seerosen treiben auf der Oberflaeche des Wassers herum.");

  AddDetail(({"wasser"}),
    "Das Wasser ist hier ziemlich nass.");

  AddDetail(({"rose","rosen","seerose","seerosen"}),
    "Grosse weisse Blumen, welche an der Wasseroberflaeche wachsen.");

  AddDetail(({"schilf"}),
    "Das Schilf ist braun, hat einen langen Stiel und einen dunkelbraunen "
    "Kopf.");

  AddDetail(({"stiel"}),
    "Der Stiel ist lang und braun.");

  AddDetail(({"kopf"}),
    "Der Kopf ist kurz und dunkelbraun.");

  AddDetail(({"burg","mauer","burgmauer","tor","eingangstor"}),
    "Du siehst Dir die Burgmauer an. Das Eingangstor sieht gewaltig aus.");

  AddDetail(({"himmel"}),
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "
    "Hoffentlich faengt es nicht zu regnen an.");

  AddDetail(({"regen"}),
    "Sieht nicht so aus, als ob es heute noch zu regnen beginnen wuerde.");

  AddDetail(({"blau","himmelblau"}),
    "Ein wirklich ausserordentlich blaues Himmelblau.");

  AddDetail( ({"nordwesten","holzsteg","steg"}),
    "Den kannst Du von hier aus nicht genau erkennen, geh doch einfach hin.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst einen Frosch quaken. Ansonsten ist es hier ziemlich ruhig.");

  AddSound( ({"frosch"}),
    "QUAK!");

  AddSmell(DEFAULT_SMELL,
    "Du riechst die Blumen am Weg, die Seerosen im Teich und den Teich selbst.");

  AddSmell(({"blumen","weg"}),
    "Herrlich wie die duften.");

  AddSmell( ({"seerosen"}),
    "Sie duften ... aeh seerosig.");

  AddSmell(({"teich","teichwasser","wasser"}),
    "Riecht schon etwas abgestanden, das Teichwasser.");

  AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",ROOM("12x6y.lpc"));
  AddExit("sueden",ROOM("15x6y.lpc"));
  AddExit("nordwestoben",ROOM("12x5y.lpc"));
}
