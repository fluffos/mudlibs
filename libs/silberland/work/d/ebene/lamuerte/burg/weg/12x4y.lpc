inherit "std/room";

#include <moredef.h>
#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Arkadische Promenade");
  SetProp(P_INT_LONG,
    "Du befindest Dich nun auf einem Holzweg rund um den Teich. Im Nordwesten siehst "
    "Du den Teich noch weiter bis zu einem Haus gehen, im Westen wird er von der "
    "Burgmauer begrenzt und nach Norden hin hast Du freien Blick auf die gesamte "
    "Laenge der Pferdegasse.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));

  AddDetail( ({"himmel"}),
      "Der ist irgendwo ueber Dir.");

  AddDetail(({"holzweg", "weg", "boden"}),
    "Der Weg auf dem Du gerade stehst, ist eigentlich eine Ansammlung von "
    "Holzbrettern, die zwischen mehreren Pfosten vernagelt sind. Auf den "
    "teichzugewandten Seiten siehst Du einen Handlauf zwischen den Pfosten.");

  AddDetail( ({"blick"}),
    "Der wird Dir gestattet, weil hier auf der Gassenseite der Holzverbau "
    "nur bis zur halben Hoehe des Daches geht.");

  AddDetail( ({"gassenseite"}),
    "Da ist die Gasse.");

  AddDetail( ({"holzverbau"}),
    "Einfache Bretter die, zwischen den Pfosten auf der Gassenseite hoch "
    "gezogen wurden.");

  AddDetail(({"hoehe"}),
    "Es ist gerade so hoch, dass Du ueber den Holzverbau springen kannst.");

  AddDetail(({"laenge", "pferdegasse", "gasse"}),
    "Von hier aus kannst Du sie gar nicht komplett sehen.");

  AddDetail(({"haus"}),
    "Du hast keine Ahnung wer oder was da drinnen ist. Das wirst Du von hier aus "
    "auch nie herausfinden.");

  AddDetail( ({"ahnung"}),
      "Du hast keine Ahnung, geht los und finde heraus, was da drinnen ist.");

  AddDetail(({"boden"}),
    "Du bist gerade auf dem Holzweg.");

  AddDetail(({"ansammlung"}),
    "Das heisst, dass es viele sind.");

  AddDetail(({"holzbretter","bretter"}),
    "Die sind alle schoen gleich lang gemacht, damit niemand hier durch eine "
    "Luecke runterfaellt.");

  AddDetail( ({"luecke"}),
     "Du siehst keine.");

  AddDetail( ({"pfosten"}),
    "Sie wurden tief in den Teichgrund gerammt.");

  AddDetail(({"teichgrund","stelle"}),
    "Hier befindest Du Dich an einer Stelle wo man noch den sandigen Untergrund "
    "des Teichs sehen kann.");

  AddDetail( ({"untergrund"}),
    "Er neigt sich sanft zur Mitte des Teichs hin.");

  AddDetail(({"handlauf", "stueck"}),
    "Ein einfaches, langes Stueck Holz das an der Teichseite angebracht wurde.");

  AddDetail(({"holz", "eichenholz"}),
    "Das ist alles sehr stabiles Eichenholz.");

  AddDetail( ({"eiche"}),
    "Die steht jetzt nirgends mehr.");

  AddDetail( ({"seite","teichseite"}),
    "Da ist der Teich.");

  AddDetail(({"ueberdachung","giebeldach","dach"}),
    "Ein schlichtes Giebeldach, das, wie auch alles andere hier, aus Holz besteht.");

  AddDetail(({"teich"}),
    "Ein ganz normaler Teich. Du siehst einige Fische darin schwimmen und am Rand "
    "stehen einige Wasserpflanzen.");

  AddDetail(({"wasser"}),
    "Sieht abgestanden aus.");

  AddDetail( ({"fisch","fische"}),
    "Und schon ist er wieder weg.");

  AddDetail( ({"wasserpflanzen","pflanzen"}),
    "Die siehst Du dir am besten vom Rand des Teichs aus an.");

  AddDetail( ({"rand"}),
    "Der ist hier auch direkt unter der Promenade.");

  AddDetail( ({"promenade"}),
    "Du befindest Dich auf ihr.");

  AddDetail( ({"burgmauer","mauer"}),
    "Eine schlichte Mauer aus vielen grossen Steinen.");

  AddDetail( ({"steine"}),
    "Die wurden sicher von weit her nach Kyranda geschafft.");

  AddDetail( ({"kyranda","stadt"}),
    "So heisst die Stadt in der Du Dich befindest.");

  AddSound(DEFAULT_SOUND,
    "Neben dem Plaetschern des Wassers hoerst Du auch noch ein leises "
    "Blubbern aus der Mitte des Teichs.");

  AddDetail( ({"mitte"}),
    "Irgendetwas scheint sich dort zu befinden.");

  AddSound(({"plaetschern","wasser"}),
    "Das entsteht wenn der Wind das Wasser an die Pfosten treibt.");

  AddSound(({"pfosten"}),
    "Untersuch ihn lieber.");

  AddSound( ({"wind"}),
    "Da ist so wenig, das man ihn nicht hoert.");

  AddSound( ({"blubbern", "blasen", "luftblasen", "luft"}),
    "Es steigen staendig Luftblasen von dort auf."); 

  AddSmell(DEFAULT_SMELL,
    "Eigentlich riecht es hier nur nach mehr oder weniger abgestandenem "
    "Teichwasser. Aber der Geruch des Holzes ist doch staerker.");

  AddSmell(({"geruch","holz","ganze"}),
    "Das Ganze hier riecht noch immer wie frisch gesaegt und geschnitten.");

  AddSmell(({"teichwasser","wasser"}),
    "Riecht schon fast ein wenig wie am Friedhof.");

  AddSmell(({"friedhof"}),
    "Irgendwie modrig. Aber nur irgendwie.");

  AddCmd(({"spring", "springe"}),"spring");

  AddExit("osten",ROOM("12x5y.lpc"));
  AddExit("suedwesten",ROOM("14x3y.lpc"));
}

int spring(string str)
{
  notify_fail("Worueber willst Du springen?\n");
  if (!str)
    return 0;
  if (str!="holzverbau" && str != "ueber holzverbau")
    return 0;
  write(BS("Mitten im Sprung bemerkst Du noch den spitzen Stein, der genau "
        "dort liegt wo Du hinspringst."));
  this_player()->move(ROOM("11x4y.lpc"), M_GO, "ueber den Holzverbau",
      "springt", "springt herein");
  write(BS("Es ist aber schon zu spaet. Du kannst nicht mehr ausweichen und "
        "landest genau mit einem Fuss darauf."));
  this_player()->AddHp(-10-random(10));
  return 1;
}
