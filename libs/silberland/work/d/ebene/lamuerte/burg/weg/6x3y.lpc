inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"In den Stallungen");
  SetProp(P_INT_LONG,
    "Du stehst inmitten der Stallungen. Irgendwie riecht es hier komisch. "
    "Die Pferde, welche hier untergebracht sind, stehen in einzelnen durch "
    "Holzplatten abgetrennten Boxen. Der Boden ist ueberall mit Stroh ausgelegt. "
    "Im Osten fuehrt ein Durchgang ins Freie." );
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));

  AddItem(NPC("knecht.lpc"),REFRESH_DESTRUCT);

  AddDetail(({"durchgang","osten"}),
    "Eine Oeffnung in der Wand die ins Freie fuehrt.");

  AddDetail( ({"freie"}),
    "Das ist nicht hier drinnen.");

  AddDetail("oeffnung",
    "Ein einfacher Durchgang.");

  AddDetail(({"stroh"}),
    "Du durchwuehlst das Stroh, findest aber nichts.");

  AddDetail(({"boden"}),
    "Man sieht den Boden vor lauter Stroh nicht mehr.");

  AddDetail(({"platten","holzplatten"}),
    "Die Holzplatten weisen nichts besonderes auf.");

  AddDetail(({"abteile", "boxen","box"}),
    "Die Boxen sind durch Holzplatten getrennte Abteile, welche Platz fuer ein "
    "Pferd bieten.");

  AddDetail( ({"platz"}),
    "So ein Pferd braucht schon mehr Platz als Du.");

  AddDetail(({"pferd","pferde"}),
    "Du untersuchst die Pferde und stellst fest, dass sie alle "
    "kerngesund sind.");

  AddDetail(({"stallung","stallungen"}),
    "Die Stallung ist fuer die Pferde der Buerger und der Durchreisenden "
    "erbaut worden.");

  AddDetail( ({"buerger", "durchreisende"}),
    "Siehst Du etwa hier einen in den Boxen stehen ... oder nur deren Pferde?");

  AddDetail(({"decke"}),
    "Die Decke weist keine Besonderheiten auf.");

  AddDetail(({"besonderheiten"}),
    "Keine.");

  AddDetail(({"wand","waende"}),
    "Die Waende sehen nett aus.");

  AddSmell(DEFAULT_SMELL,
    "Es stinkt furchtbar nach Pferd.");

  AddSmell( ({"pferd","pferde"}),
    "Ihhhh... Das riecht aber wirklich pferdig.");

  AddSound(DEFAULT_SOUND,
    "Ab und an hoerst Du ein Pferd wiehern.");

  AddSound(({"pferd"}),
    "WIEEEEEEHAAA.");

  AddCmd("reite","rfunc");

  AddExit("osten",ROOM("6x4y.lpc"));
}

int rfunc(string str)
{
  string was;
  notify_fail("Auf was willst Du reiten?\n");
  if (!str)
    return 0;
  if (sscanf(str,"auf %s",was) != 1)
    return 0;
  if (was!="pferd")
    return 0;

  write ("Du versuchst auf das Pferd aufzusteigen.\n");
  call_out("ride",2);
  return 1;
}

void ride()
{
  int i;
  i=random(100);
  if(i<90)
    write("Das Pferd wirft Dich gnadenlos ab.\n");
  else
    write("Jehaaaa! Du bezwingst das Pferd!\nDu bist der Held des Tages!\n");
  //HIER MAL STP
}
