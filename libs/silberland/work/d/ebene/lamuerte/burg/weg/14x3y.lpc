inherit "std/room";

#include <moredef.h>
#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>

  /*
   * Bugfix (Anatol) 27.10.2014
   * If reset() calls new_names() and there's no user of a specified
   * gender online, keep the previous name.
   * + Initialisation in create()
   * + If's in new_names().
   */

string fname;
string mname;

void new_names()
{
  object *male, *female;
  male = filter_array(users(),  lambda(({'player}),
        ({#'==, ({#'call_other, 'player, "QueryProp", P_GENDER}), MALE})));
  female = filter_array(users(),  lambda(({'player}),
        ({#'==, ({#'call_other, 'player, "QueryProp", P_GENDER}), FEMALE})));
  if (sizeof(male)) {
    mname = capitalize(getuid(male[random(sizeof(male))]));
  }
  if (sizeof(female)) {
    fname = capitalize(getuid(female[random(sizeof(female))]));
  }
}

void create()
{
  ::create();
  mname = "Kronang";
  fname = "Ayla";

  new_names();
  SetProp(P_INT_SHORT,"Arkadische Promenade");
  SetProp(P_INT_LONG,
    "Du befindest Dich nun auf einem Holzweg rund um den Teich. Im Norden siehst "
    "Du den Teich noch weiter bis zu einem Haus gehen, im Westen wird er von der "
    "Burgmauer begrenzt.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));

  AddDetail( ({"himmel"}),
      "Irgendwo ueber Dir.");

  AddDetail(({"holzweg", "weg", "boden"}),
    "Der Weg auf dem Du gerade stehst, ist eigentlich eine Ansammlung von "
    "Holzbrettern, die zwischen mehreren Pfosten vernagelt sind. Auf den "
    "teichzugewandten Seiten siehst Du einen Handlauf zwischen den Pfosten.");

  AddDetail(({"haus"}),
    "Du hast keine Ahnung wer oder was da drinnen ist. Das wirst Du von hier aus "
    "auch nie herausfinden.");

  AddDetail( ({"ahnung"}),
      "Du hast absoult keine Ahnung, du solltest es irgendwie herausfinden.");

  AddDetail(({"boden"}),
    "Du bist gerade auf dem Holzweg.");

  AddDetail(({"ansammlung"}),
    "Das heisst, dass es viele sind.");

  AddDetail(({"holzbretter", "holzbrett"}),
    "Die sind alle schoen gleich lang gemacht, damit niemand hier durch eine "
    "Luecke runterfaellt.");

  AddDetail( ({"luecke"}),
     "Du siehst keine.");

  AddDetail( ({"pfosten"}),
    "Sie wurden tief in den Teichgrund gerammt. Auf einem ist etwas eingeritzt.");

  AddDetail( ({"etwas"}),
    "Du koenntest versuchen es zu lesen.");

  AddCmd(({"lies","lese"}),"cmd_lesen");

  AddDetail(({"teichgrund"}),
    "Den kannst Du hier nirgends sehen.");

  AddDetail(({"handlauf", "stueck"}),
    "Ein einfaches, langes Stueck Holz das an der Teichseite angebracht wurde. "
    "Er sieht hier allerdings schon nicht mehr so stabil aus. Lehn Dich besser "
    "nicht daran an.");

  AddCmd(({"lehne","lehne"}), "cmd_lehne");

  AddDetail(({"holz", "eichenholz"}),
    "Das ist alles sehr stabiles Eichenholz.");

  AddDetail( ({"eiche"}),
    "Die steht jetzt nirgends mehr.");

  AddDetail( ({"seite","teichseite"}),
    "Da ist der Teich.");

  AddDetail(({"ueberdachung","giebeldach","dach"}),
    "Ein schlichtes Giebeldach, das, wie auch alles andere hier, aus Holz besteht.");

  AddDetail(({"teich"}),
    "Ein ganz normaler Teich. Du siehst einige Fische darin schwimmen und am Rand "
    "stehen einige Wasserpflanzen. Im Suedosten siehst noch Umrisse unter Wasser.");

  AddDetail(({"wasser"}),
    "Sieht abgestanden aus.");

  AddDetail(({"umrisse"}),
    "Von hier aus kannst Du erkennen, dass es sich um alte Ueberreste eines gemauerten "
    "Brunnen handeln muss.");

  AddDetail( ({"ueberreste","brunnen"}),
    "Warum hat man diesen Ort bloss mit Wasser geflutet?");

  AddDetail( ({"ort"}),
    "Na, der Teich hier.");

  AddDetail( ({"fisch","fische"}),
    "Und schon ist er wieder weg.");

  AddDetail( ({"wasserpflanzen","pflanzen"}),
    "Die siehst Du dir am besten vom Rand des Teichs aus an.");

  AddDetail( ({"rand"}),
    "Der ist nicht hier.");

  AddDetail( ({"burgmauer","mauer"}),
    "Eine schlichte Mauer aus vielen grossen Steinen.");

  AddDetail( ({"steine"}),
    "Die wurden sicher von weit her nach Kyranda geschafft.");

  AddDetail( ({"kyranda","stadt"}),
    "So heisst die Stadt in der Du Dich befindest.");

  AddSound(DEFAULT_SOUND,
    "Neben dem Plaetschern des Wassers hoerst Du auch noch ein leises "
    "Blubbern aus der Mitte des Teichs.");

  AddDetail( ({"mitte"}),
    "Irgendetwas scheint sich dort zu befinden.");

  AddSound(({"plaetschern","wasser"}),
    "Das entsteht wenn der Wind das Wasser an die Pfosten treibt.");

  AddSound(({"pfosten"}),
    "Untersuch ihn lieber.");

  AddSound( ({"wind"}),
    "Da ist so wenig, das man ihn nicht hoert.");

  AddSound( ({"blubbern", "luftblasen", "luft", "blasen"}),
    "Es steigen staendig Luftblasen von dort auf."); 

  AddSmell(DEFAULT_SMELL,
    "Eigentlich riecht es hier nur nach mehr oder weniger abgestandenem "
    "Teichwasser. Aber der Geruch des Holzes ist doch staerker.");

  AddSmell(({"geruch","holz","ganze"}),
    "Das Ganze hier riecht noch immer wie frisch gesaegt und geschnitten.");

  AddSmell(({"teichwasser","wasser"}),
    "Riecht schon fast ein wenig wie am Friedhof.");

  AddSmell(({"friedhof"}),
    "Irgendwie modrig. Aber nur irgendwie.");

  AddExit("nordosten",ROOM("12x4y.lpc"));
  AddExit("sueden",ROOM("15x3y.lpc"));

  AddItem("/gilden/bardengilde/obj/ehrenstatue", REFRESH_DESTRUCT, (["hero": "khartak"]));
}

int cmd_lesen(string str)
{
  notify_fail("Was willst Du lesen?\n");
  if (!str)
    return 0;
  if (str!="etwas")
    return 0;
  if(this_player()->QueryProp(P_MARRIED))
  {
    write("Hier steht: "+capitalize(getuid(this_player()))+" liebt "+
        this_player()->QueryProp(P_MARRIED)+".\n"); 
      return 1;
  }
  else
  {
    write("Hier steht: "+mname+" liebt "+fname+".\n");
    return 1;
  }
  return 1;
}

int cmd_lehne(string str)
{
  notify_fail("Woran moechtest Du Dich anlehnen?\n");
  if (!str)
    return 0;
  if (str!="handlauf" && str!="an handlauf" && str!="handlauf an" && 
      str!="an handlauf an")
    return 0;
  write(BS("Gerade als Du Dich mit Deinem vollem Gewicht auf den Handlauf "
      "lehnst, bricht er unter Dir weg."));
  write("Du faellst ins Wasser und kommst voellig durchnaesst woanders heraus.\n");
  this_player()->move(ROOM("15x6y"), M_GO, "in den Teich", "faellt");
  return 1;
}

void reset()
{
  ::reset();
  new_names();
}

