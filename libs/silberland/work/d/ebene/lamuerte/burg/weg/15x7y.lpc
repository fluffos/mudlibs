inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

int i;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
    "Hier befindet sich der westlichste Punkt der Marktgasse, die sich "
    "von hier aus weiter in den Osten erstreckt. Weit im Osten kannst Du "
    "die Burgmauer erblicken, welche sich den Himmel empor streckt. Im "
    "Westen beginnt der Burgweg.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);

  i=0;

  AddDetail(({"himmel"}),
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.");

  AddDetail( ({"tag"}),
    "Am liebsten wuerdest Du immer so einen Tag haben wollen.");

  AddDetail(({"punkt"}),
    "Du suchst den wirklich westlichsten Punkt den Du finden kannst.");

  AddDetail(({"mauer","burgmauer", "osten"}),
    "Von hier aus kann man die Mauer nicht genauer untersuchen. Bleibt "
    "wohl nur noch zu sagen, dass sie ziemlich hoch aussieht.");

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "
    "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne.");

  AddDetail(({"buerger"}),
    "Die Buerger sind im ganzen Silberland fuer ihren regen Handel bekannt.");

  AddDetail( ({"silberland"}),
    "Was glaubst Du wo Du hier bist?");

  AddDetail(({"handel"}),
    "Die Buerger handeln mit Waren aller Art.");

  AddDetail( ({"buehne"}),
    "Die ist auch in Kyranda.");

  AddDetail( ({"kyranda"}),
    "Du bist in Kyranda.");

  AddDetail(({"waren","art"}),
    "Wie gesagt ALLER ART, heisst mit allem was sie in die Finger bekommen.");

  AddDetail( ({"finger"}),
    "Ihh, die sind ja schmutzig, wasch sie Dir mal wieder. Sonst macht hier keiner "
    "Geschaefte mit Dir.");

  AddDetail( ({"geschaefte", "geschaeft", "moeglichkeit"}),
    "Die Buerger wollen aus jeder Moeglichkeit ein Geschaeft schoepfen.");

  AddDetail(({"blau"}),
    "Ganz schoen blau, dieses BLAU!");

  AddDetail(({"boden"}),
    "Es handelt sich um die Marktgasse.");

  AddSpecialDetail(({"sonne","sonnenschein"}), "bfunc");

  AddDetail(({"weg","burgweg", "westen"}),
    "Der Burgweg befindet sich weiter im Westen.");

  AddSmell(DEFAULT_SMELL,
    "Eigentlich riechst Du hier so gut wie nichts.");

  AddSound(DEFAULT_SOUND,
    "Im Westen hoerst Du schon etwas regeres Treiben als hier.");

  AddSound(({"treiben"}),
    "NEIN ... doch nicht das was Du jetzt denkst, Du Ferkel.");

  AddDetail( ({"ferkel","schwein"}),
    "Du hoerst gerade jemanden ein Schwein zum Schlachter bringen.");

  AddDetail( ({"schlachter"}),
    "Das wird vermutlich der im Ogerlager sein.");

  AddDetail( ({"ogerlager","lager", "heimat"}),
    ([0:"Ob Du da wirklich hin willst?\n",
     "oger": "Das ist Deine Heimat.\n"]));

  AddExit("osten",ROOM("15x8y.lpc"));
  AddExit("westen",ROOM("15x6y.lpc"));
}


string bfunc()
{
  string ret;
  
  ret = "Du blickst zu lang in die Sonne, ";
  if (random(100)<60)
  {
    this_player()->SetProp(P_BLIND, 3);
    return ret + "und sie blendet Dich.\n";
  }
  return ret + "aber kannst es gerade noch vermeiden,\ngeblendet zu werden.\n";
}
