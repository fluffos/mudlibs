
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
        "Die Pferdegasse fuehrt vom Sueden weiter in den Norden. Der Boden sieht "+
        "ziemlich niedergetrampelt aus, da die Knechte oefters die Pferde in dieser "+
        "Gasse ausreiten. Weiter im Sueden gelangst Du von hier aus zum Burgweg.");

  AddSound(DEFAULT_SOUND,"Du horchst herum, hoerst aber nichts.");

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));

  AddDetail(({"boden"}),
        "Am Boden sind die Spuren von Pferden zu sehen.");

  AddDetail( ({"himmel"}),
      "Der Himmel ist ueber Dir.");  

  AddDetail( ({"spuren", "abdruck", "huf", "pferdehuf"}),
      "Es handelt sich um den Abdruck eines Pferdehufs.\n");

  AddDetail(({"knechte"}),
        "Die Knechte sind fuer die Pflege der Pferde zustaendig.");

  AddDetail(({"burgweg"}),
        "Der Burgweg befindet sich ein Stueck weiter im Sueden.");

  AddDetail(({"hauptgasse"}),
        "Die Hauptgasse befindet sich weiter im Norden.");

  AddDetail(({"pferdegasse","gasse"}),
        "Die Gasse verbindet den Burgweg mit der Hauptgasse.");

  AddExit("sueden",ROOM("11x4y.lpc"));
  AddExit("norden",ROOM("7x4y.lpc"));
  AddExit("westen", "/d/ebene/lamuerte/brunnen/corpse/corpse_office");

}
