inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Hier ist der Beginn der Pferdegasse, welche die Stallungen und die "
    "Hauptgasse mit dem Burgweg und der Marktgasse verbindet. Die Pferdegasse "
    "fuehrt gerade von hier in den Norden und endet dort vor den Stallungen "
    "der Stadt. Im Sueden siehst Du einen Teil der Teichpromenade.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);
  AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT);

  AddDetail(({"promenade","teichpromenade"}),
    "Sie ist hier, bis auf halbe Hoehe, einseitig mit Brettern zugenagelt. Sie "
    "begrenzt den Teich hin zur Strasse.");

  AddDetail( ({"teich"}),
    "Am Rand, da wo das Ufer ist, siehst Du sogar unter der Teichpromenade hindurch.");

  AddDetail( ({"rand", "grasrand"}),
    "Ein schlichter Grasrand, der am Ufer auch noch ein paar Teichpflanzen aufweist.");

  AddDetail( ({"gras"}),
    "Gruen und saftig, so wie es sein soll.");

  AddDetail( ({"ufer"}),
    "Da siehst Du das Wasser in kleinsten Wellen schwappeln.");

  AddDetail( ({"teichpflanzen","wassergraeser","wassergras"}),
    "Einfache Wassergraeser, die da gerade genug Licht bekommen, um zu wachsen.");

  AddDetail( ({"licht"}),
    "Unter die Promenade kommt hier nicht wirklich viel Licht.");

  AddDetail( ({"wellen","wasser"}),
    "Schwipp, Schwapp ... guckst Du laenger, ist die Nase ab.");

  AddDetail( ({"nase"}),
    "Sie ist noch da ... Woodyseidank.");

  AddDetail( ({"hoehe"}),
    "Gerade so hoch das Du noch mit den Haenden hinaufkommst.");

  AddDetail( ({"haende"}),
    "Davon hast Du zwei.");

  AddDetail( ({"bretter"}),
    "Die sind aus Eichenholz.");

  AddDetail( ({"holz","eichenholz"}),
    "Das kommt von einer Eiche.");

  AddDetail( ({"eiche"}),
    "Die existiert jetzt nur mehr als Holz.");

  AddDetail(({"teil"}),
    "Das ganze kannst Du wohl nur von oben ueberblicken. Du koenntest ja mal "
    "versuchen hinaufzuklettern.");

  AddDetail(({"boden"}),
    "Das einzige was Dir auffaellt ist der spitze Stein im Boden, der etwas aufragt.");

  AddDetail( ({"stein"}),
    "Eigentlich ungefaehrlich, man sollte nur nicht direkt von oben mit zu viel Schwung "
    "darauf springen.");

  AddDetail( ({"schwung"}),
    "Den hast Du beim normalen gehen nicht.");

  AddDetail(({"hauptgasse"}),
    "Du kannst nichts besonderes daran finden.");

  AddDetail(({"stadt"}),
    "Du stehst mitten drinnen.");

  AddDetail( ({"strasse"}),
    "Es ist natuerlich eine der Gassen gemeint.");

  AddDetail(({"pferdegasse","stallungen","gasse", "beginn"}),
    "Die Pferdegasse fuehrt direkt zu den Stallungen, welche von hier aus "
    "noch nicht zu sehen sind.");

  AddDetail(({"burgweg","weg","marktgasse"}),
    "Der Burgweg fuehrt zur Marktgasse, welche eher im suedoestlichen "
    "Teil der Stadt liegt.");

  AddDetail(({"himmel", "blau"}),
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "
    "Hoffentlich faengt es nicht zu regnen an.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst nur das leise Plaetschern der Wellen.");

  AddSound(({"plaetschern","wellen", "platsch", "pltisch"}),
    "Plitsch Platsch");

  AddSmell(DEFAULT_SMELL,
    "Aus dem Norden dringt ein leichter Geruch zu Dir.");

  AddSmell( ({"geruch","norden"}),
    "Er ist noch zu undeutlich, um ihn zu definieren.");

  AddCmd(({"klettere","kletter"}), "cmd_klettere");

  AddExit("osten",ROOM("11x5y.lpc"));
  AddExit("norden",ROOM("10x4y.lpc"));
}

int cmd_klettere(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (!str)
    return 0;
  if (str != "promenade" && str != "auf promenade" && str != "hinauf" &&
      str != "rauf")
    return 0;
  write("Du kletterst die Wand ohne Probleme hinauf.\n");
  this_player()->move(ROOM ("12x4y.lpc"), M_GO, "die Wand hinauf", "klettert");
  return 1;
}
