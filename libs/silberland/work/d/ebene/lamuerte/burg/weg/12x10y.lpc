
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
    "Die Marktgasse fuehrt vom Westen in den Osten. Im Westen ist eine "
    "Kreuzung zu erkennen, weiter im Osten ist die imposante Burgmauer der "
    "Stadt zu erblicken. Es sieht so aus als ob in der Mauer ein Eingang "
    "waere. Im Norden steht ein kleines Holzhaeuschen, ueber dem ein Schild "
    "haengt und im Sueden gehts in einen Naehladen.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);

  AddDetail( ({"naehladen","naeherei"}),
    "Im Sueden.");

  AddDetail( ({"sueden"}),
    "Da gehts in den Naehladen.");

  AddDetail(({"kreuzung"}),
    "Die Kreuzung liegt weiter im Westen.");

  AddDetail(({"eingang", "oeffnungen"}),
    "Oeffnungen, durch die man ein Haus betreten kann.");

  AddDetail(({"holzhaeuschen","haeuschen","kraeuterladen", "haus"}),
    "Die Haeuschen ist aus Holz gebaut. Ueber dem Eingang haengt ein "
    "kleines Schild.");

  AddDetail( ({"norden"}),
    "Da steht immer noch das Holzhaeuschen, wenn es nicht gerade eben ein "
    "Magier abgerissen hat.");

  AddDetail( ({"magier"}),
    "Glueck gehabt, es war keiner da.");

  AddDetail( ({"glueck"}),
    "Darauf kann man sich aber nicht immer verlassen.");

  AddDetail(({"schild"}),
    "Auf dem Schild sind die verschiedensten Kraeuter abgebildet.");

  AddDetail(({"kraeuter"}),
    "Die einzigen Kraeuter, die Du siehst, sind auf dem kleinen Schild aufgemalt.");

  AddDetail(({"himmel"}),
    "Blauer Himmel, ein wirklich wundervoller Tag.");

  AddDetail( ({"sonne"}),
    "Oh ja, die ist ja auch noch da. Rund und gelb laechelt sie herunter. "
    "Du laechelst zurueck.");

  AddSpecialDetail( ({"tag"}), "det_tag");

  AddDetail(({"punkt","westen"}),
    "Du suchst den wirklich westlichsten Punkt, den Du finden kannst.");

  AddDetail(({"mauer","burgmauer"}),
    "Die Burgmauer ist weiter im Osten. Es scheint, als ob dort etwas "
    "in der Mauer waere, aber das siehst Du nicht so genau.");

  AddDetail( ({"etwas","osten", "tor"}),
    "Im Osten scheint ein Tor zu sein.");

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse verlaeuft vom Westen in den Osten.");

  AddDetail(({"boden"}),
    "Der Boden weist keine Besonderheiten auf.");

  AddDetail( ({"besonderheiten"}),
    "Wenn ich sage keine, dann meine ich auch KEINE.");

  AddDetail(({"stadt"}),
    "Du stehst mitten drinnen.");

  AddDetail("holz",
    "Koennte Buchenholz sein.");

  AddDetail("buchenholz",
    "Ja, es ist Buchenholz.");

  AddSmell(DEFAULT_SMELL,
    "Aus dem Kraeuterladen dringen Dir exotische Duefte entgegen.");

  AddSmell( ({"duefte","duft"}),
    "Da musst schon hineingehen, damit Du weisst, was das ist.");

  AddSmell( ({"kraeuterladen"}),
    "Du riechst an ihm, riechst aber nichts besonderes. Untersuch ihn gefaelligst.");

  AddSound(DEFAULT_SOUND,
    "Aus der Naeherei hoerst des oefteren jemanden 'Aua' schrein.");
    
  AddSound( ({"aua","naehmeister"}),
    "Anscheinend ist da jemand doch kein so grosser Naehmeister, wie er immer behauptet.");

  AddSound( ({"naeherei"}),
    "Du lauschst an ihr, hoerst aber nichts. Untersuch sie gefaelligst.");

  AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",BURG("shop/kraeuterladen.lpc"));
  AddExit("westen",ROOM("12x9y.lpc"));
  AddExit("osten",ROOM("12x11y.lpc"));
  AddExit("sueden",BURG("shop/naehstube"));
}

string det_tag()
{
  return "Heute ist der " + dtime()[0..16] + ".\n";
}
