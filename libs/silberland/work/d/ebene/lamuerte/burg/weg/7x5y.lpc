inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Du stehst am westlichen Ende der Hauptgasse. Von hier aus kann man schon "
    "die wundervolle Kirche der Stadt, welche weiter im Osten liegt, erblicken. "
    "Im Westen befindet sich eine Kreuzung, an der die Hauptgasse in die "
    "Pferdegasse muendet.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  AddItem(NPC("wache.lpc"),REFRESH_DESTRUCT);

  AddDetail(({"stadt","kyranda"}),
    "Du siehst Dich um und stellst fest, dass Du wirklich in der Stadt stehst.");

  AddDetail (({"boden"}),
    "Der Boden sieht sehr gepflegt aus.");

  AddDetail(({"ende"}),
    "Ein jaemmerliches Ende! (fast filmreif)");

  AddDetail( ({"himmel", "blau"}),
    "Du siehst nach oben. Nichts als strahlendes Blau.");

  AddDetail(({"kirche"}),
    "Die Kirche war das erste Gebaeude, welches in Kyranda erbaut wurde. "
    "Fuer ihr Alter sieht sie noch verhaeltnissmaessig gut aus.");

  AddDetail( ({"gebaeude", "alter"}),
    "Die Kirche ist so alt, dass keiner mehr weiss, wann sie wirklich gebaut wurde.");

  AddDetail(({"kreuzung","westen"}),
    "Um die Kreuzung zu untersuchen, solltest Du weiter westlich gehen.");

  AddDetail(({"gasse"}),
    "Welche Gasse meinst Du jetzt?");

  AddDetail(({"hauptgasse","osten"}),
    "Die Hauptgasse verlaengert sich in oestliche Richtung.");

  AddDetail(({"pferdegasse"}),
    "Die Pferdegasse liegt weiter im Westen.");

  AddSound(DEFAULT_SOUND,
    "Du horchst herum, hoerst aber nichts.");

  AddSmell(DEFAULT_SMELL,
    "Du riechst noch ganz leicht die Pferde.");

  AddSmell( ({"pferde","pferd"}),
    "Sie riechen ... pferdig eben.");

  AddExit("westen",ROOM("7x4y.lpc"));
  AddExit("osten",ROOM("7x6y.lpc"));
}
