
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Im Bordell");
  SetProp(P_INT_LONG,break_string(
    "Du boeser, warum kommst Du ins Bordell bevor es fertig ist? :-)",78));

  AddSound(DEFAULT_SOUND,break_string("Einschmeichelnde Musik "+
  	"ertoent aus dem Hintergrund",78));
  AddSmell(DEFAULT_SMELL,break_string("Hier riecht es eindeutig "+
  	"nach.... hm, mals Dir selber aus :-)"));
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24]));

  AddDetail(({"boden"}),break_string(
    "Du stehst auf einem flauschigen Teppichboden.",78));
  
  AddDetail("",
    "\n");
  AddExit("westen",ROOM("12x6y"));
  AddExit("oben", ROOM("bordell2"));
}
