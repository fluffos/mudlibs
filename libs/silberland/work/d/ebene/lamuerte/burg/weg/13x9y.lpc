inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

int i;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
    "Die Marktgasse verlaeuft hier vom Sueden in den Norden, wo sie in einer "
    "Kreuzung muendet. Du kannst im Norden der Kreuzung eine Blockhuette "
    "erkennen, ueber deren Eingang ein Schild angebracht ist. "
    "Weiter im Sueden kannst Du, zwar sehr unklar, aber immerhin doch, eine "
    "Biegung in der Gasse ausmachen.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);
  i=0;

  AddDetail("biegung",
    "Die Marktgasse fuehrt hier in erst suedlich und dann nach Westen weiter.");

  AddDetail(({"kreuzung","norden"}),
    "Die Kreuzung befindet sich weiter im Norden.");

  AddDetail(({"osten", "westen","norden", "sueden"}),
   "Alles Himmelsrichtungen.");

  AddDetail( ({"himmelsrichtungen","richtungen"}),
    "Jede geht woanders hin.");

  AddDetail(({"eingang","oeffnungen"}),
    "Oeffnungen durch die man ein Haus betreten kann.");

  AddDetail(({"huette","blockhuette","lokale","verkaufslokale","unterkunft", "haus"}),
    "Die kleinen Blockhuetten dienen sowohl als Verkaufslokale als auch "
    "als Unterkunft fuer die Buerger.");

  AddDetail(({"handel","geschaefte","geschaeft"}),
    "Ueberall wird nur gehandelt.");

  AddDetail(({"boden"}),
    "Du siehst einen Stein, ueber den Du stolpern koenntest.");

  AddSpecialDetail("stein","sfunc");

  AddDetail(({"buerger"}),
    "Da muss doch ein Buerger sein, Du bist Dir sicher! Oder doch nicht?!"); 

  AddDetail(({"schild"}),
    "Du kannst auf dem Schild im Norden die Zunft der Brauer ausmachen.");

  AddDetail( ({"zunft","brauer"}),
    "Da musst schon selbst nachschaun.");

  AddDetail(({"himmel"}),
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.");

  AddDetail( ({"tag"}),
    "Morgen ist heute gestern gewesen!");

  AddDetail( ({"sonne"}),
    "Rund und gelb lacht sie vom Himmel.");

  AddDetail(({"sonnenschein", "schein"}),
    "Sieh nicht zu oft in die Sonne, sonst wirst Du noch blind.");

  AddDetail(({"mauer","burgmauer"}),
    "Die Burgmauer fuehrt wohl um ganz Kyranda.");

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "
    "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne.");

  AddDetail( ({"buehne"}),
    "Ein Theater wirst du hier nicht finden.");

  AddDetail( ({"theater", "naehe"}),
    "Das findest in der Naehe der Kirche.");

  AddDetail(({"kirche"}),
    "Von hier aus kommst Du da nicht hin.");

  AddSmell(DEFAULT_SMELL,
    "Hier weht Dir sowohl aus dem Sueden als auch aus dem Norden ein "
    "leichter Alkoholgeruch entgegen.");

  AddSmell( ({"norden","sueden"}),
    "Nicht riechen, hingehn.");

  AddSmell( ({"alkohol","alkoholgeruch","geruch"}),
    "Der eine etwas milder, der andere etwas schaerfer.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst nur die ueblichen Stadtgeraeusche.");

  AddSound(({"stadt","stadtgeraeusche","geraeusche"}),
    "Naja wie es in einer Stadt eben so klingt. Von ueberall etwas zu "
    "hoeren, von nirgends etwas zu verstehen.");

  AddItem(NPC("reisender.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",ROOM("12x9y.lpc"));
  AddExit("sueden",ROOM("14x9y.lpc"));
}

string sfunc()
{
  int i;
  i=random(100);
  if (i<60)
  {   
    this_player()->AddHp(-10-random(20));
    return"AUTSCH! Du stolperst ueber den Stein.\n";
  }
  return "Glueck gehabt, Du bist nicht ueber den Stein gestolpert.\n";
}
