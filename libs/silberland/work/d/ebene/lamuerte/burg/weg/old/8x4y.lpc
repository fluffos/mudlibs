
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
        "Die Pferdegasse muendet im Norden in eine Kreuzung, "+
        "welche auch von hier aus schon zu sehen ist. Auch hier sieht der Boden "+
        "ziemlich niedergetrampelt von den Pferden aus. Weit, weit im Sueden gelangst "+
        "Du von hier aus zum Burgweg. Weit im Norden kann man schon die Stallungen "+
        "von Kyranda ausmachen.");

  AddItem(NPC("einwohner.lpc"),REFRESH_DESTRUCT);
  AddSound(DEFAULT_SOUND,"Du horchst herum, hoerst aber nichts.");

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));

  AddDetail( ({"himmel", "blau"}),
      "Du siehst nach oben. Nichts als strahlendes Blau.\n");

  AddDetail(({"boden"}),
        "Am Boden sind die Spuren von Pferden zu sehen.");

  AddDetail(({"stallungen"}),
        "Die Stallungen liegen weit im Norden.");

  AddDetail(({"knechte"}),
        "Die Knechte sind fuer die Pflege der Pferde zustaendig.");

  AddDetail(({"kreuzung"}),
        "Die Kreuzung ist ein Stueckchen weiter im Norden.");

  AddDetail(({"spur","spuren"}),
      "Die Spuren fuehren vom Sueden in den Norden.\n");

  AddDetail(({"pferde","pferd"}),
        "Es sind keine Pferde zu sehen.");

  AddDetail(({"burgweg"}),
        "Der Burgweg befindet sich weiter im Sueden.");

  AddDetail(({"hauptgasse"}),
        "Die Hauptgasse befindet sich weiter im Norden.");

  AddDetail(({"pferdegasse","gasse"}),
        "Die Gasse verbindet den Burgweg mit der Hauptgasse.");

  AddExit("sueden",ROOM("9x4y.lpc"));
  AddExit("norden",ROOM("7x4y.lpc"));

}
