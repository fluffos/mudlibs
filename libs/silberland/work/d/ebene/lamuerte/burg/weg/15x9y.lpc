inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
    "Die Marktgasse endet hier in einer Biegung, die vom Westen in den "
    "Norden weiterfuehrt. In einiger Entfernung kannst Du sowohl in "
    "westlicher als auch in noerdlicher Richtung Schilder, welche ueber "
    "den Eingaengen der Haeuser haengen, sehen.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_LIGHT,1);

  AddDetail(({"boden"}),
    "Ein Boden, ist ein Boden, ist ein Boden.\nOb er eine Tarnkappe hat? ;-)\n");

  AddDetail(({"tarnkappe"}),
    "Du kannst nicht feststellen, ob eine Tarnkappe da ist.");

  AddDetail(({"eingang","eingaenge"}),
    "Oeffnungen durch die man ein Haus betreten kann.");

  AddDetail( ({"oeffnungen"}),
    "Kurz Eingaengen genannt.");

  AddDetail(({"haus","haeuser","lokale","verkaufslokale","unterkunft",
        "huette", "huetten", "blockhuette", "blockhuetten"}),
    "Die kleinen Blockhuetten dienen sowohl als Verkaufslokale als auch als "
    "Unterkunft fuer die Buerger.");

  AddDetail(({"schild","schilder"}),
    "Die Schilder zeigen jede einzelne Handelszunft.");

  AddDetail(({"zunft","handelszunft"}),
    "Bei dem einen handelt sich um das Zeichen eines Schmiedes. "
    "Die Entfernung zum anderen ist zu gross, als dass Du etwas erkennen "
    "koenntest.");

  AddDetail( ({"entfernung"}),
    "Das soll heissen das es weiter weg ist.");

  AddDetail (({"zeichen"}),
    "Das Zeichen eines Schmiedes.");

  AddDetail(({"schmied","schmiedes"}),
    "Geh hin, wenn Du naeheres wissen willst.");

  AddDetail(({"himmel", "sonnenschein", "tag"}),
    "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.");

  AddDetail(({"marktgasse","gasse"}),
    "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "
    "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne.");

  AddDetail( ({"buerger","kyrander","volk"}),
    "Die Kyrander sind ein sehr geschaeftstuechtiges Volk.");

  AddDetail( ({"handel", "geschaefte", "buehne"}),
    "Hier wird viel gehandelt, wie man an den vielen Schildern sehen kann.");

  AddDetail( ({"biegung", "westen", "norden", "richtung"}),
    "Es ist eine ganz normale Biegung, wo ueberall anders auch.");

  AddSmell(DEFAULT_SMELL,
    "Eigentlich ist es hier ziemlich geruchlos. Nur ganz normaler "
    "Strassengeruch eben.");

  AddSmell(({"strasse","strassengeruch","geruch"}),
    "Du willst doch jetzt nicht wirklich an der Strasse riechen, oder?");

  AddSound(DEFAULT_SOUND,
    "Man hoert nur die ganz normalen Stadtgeraeusche.");

  AddSound( ({"stadt","stadtgeraeusche","geraeusche"}),
    "Von ueberall hoert man alles moegliche, doch verstehen tut man nichts.");

  AddExit("norden",ROOM("14x9y.lpc"));
  AddExit("westen",ROOM("15x8y.lpc"));
}
