
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Marktplatz");
  SetProp(P_INT_LONG,break_string(
    "Du stehst im Nordwesten des Marktplatzes. Hier haben viele Haendler ihre "+
    "Staende aufgebaut, daher geht es auch relativ laut zu. Dass Kyranda "+
    "eigentlich einmal sehr verlassen und einsam war, kann man kaum glauben, "+
    "wenn man hier steht. Dafuer ist es hier aber auch nicht mehr so sauber wie "+
    "vorher. Ausserdem stinkt der Geruch der Brauerei hier zum Himmel. In der Mitte "+
    "des Platzes siehst Du einen kleinen Teich.",78));

  AddSound(DEFAULT_SOUND,break_string("Lautes Geschnatter ertoent von allen Seiten.",78));
  AddSmell(DEFAULT_SMELL,break_string("Hier stinkt die Brauerei zum Kotzen"));
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24]));

  AddDetail(({"boden"}),break_string(
    "Der Boden ist gepflastert und sehr kotig.",78));

  AddDetail(({"wasser","oberflaeche","wasseroberflaeche"}),
    "Du siehst Dir Dein Spiegelbild auf der Wasseroberflaeche an.\n");
      
  AddDetail(({"bild","spiegelbild"}),
    "Siehst Du heut wieder gut aus!\n");
    
  AddDetail(({"teich","}),break_string(
    "Einige Seerosen treiben auf der Wasseroeberflaeche herum.",78));
            
  AddDetail(({"rose","rosen","seerose","seerosen"}),break_string(
    "Grosse weisse Blumen, welche an der Wasseroberflaeche wachsen.",78));
                             
  
  AddDetail("",
    "\n");
  AddDetail(({"burgweg"}),break_string(
    "Der Burgweg befindet sich ein Stueck weiter im Osten.",78));

  AddExit("sueden",ROOM("marktplatz3"));
  AddExit("osten",ROOM("marktplatz2"));
  AddExit("norden", BURG("/shop/brauerei"));
}
