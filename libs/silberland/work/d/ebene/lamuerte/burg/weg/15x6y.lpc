inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "files.h"

int i;
int j=0;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
    "Der Burgweg fuehrt weiter in den Norden. Richtung Osten gehts zur "
    "Marktgasse. Das Ufer eines Teichs ist im Westen zu sehen. Hinter Dir "
    "liegt das grosse Eingangstor welches aus der Burg fuehrt. Ausserdem "
    "kannst Du im Suedwesten auf einen Holzsteg gehen. Ueber Dir ist der "
    "strahlend blaue Himmel zu sehen.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS,0);

  AddDetail( ({"gesamtbild", "bild"}),
    QueryProp(P_INT_LONG) );

  AddDetail(({"boden","weg","burgweg","norden"}),
    "Der Burgweg fuehrt zu den wichtigsten Einrichtungen der Burg. Er ist " 
    "mit Kies ausgelegt und fuehrt nach Norden weiter. Am Rand sind einige "
    "Blumen zu sehen.");

  AddDetail(({"burg","mauer","burgmauer","tor","eingangstor"}),
    "Du siehst Dir die Burgmauer an. Das Eingangstor sieht gewaltig aus.");

  AddDetail(({"einrichtungen"}),
    "Vielleicht solltest Du weitergehen, um in Erfahrung zu bringen, wo "
    "sich diese sagenhaften Einrichtungen befinden.");

  AddDetail(({"erfahrung"}),
    "Jede Erfahrung macht Dich um eine Erfahrung reicher.");

  AddDetail(({"blumen", "rand"}),
    "Einige unwichtige Blumen wachsen am Rand des Weges. Nichts "
    "Aufregendes. Sie verschoenern nur das Gesamtbild des Weges.");

  AddDetail(({"aufregendes", "nichts"}),
      "Nichts.");
  
  AddDetail(({"gasse","marktgasse","osten"}),
    "Die Marktgasse befindet sich weiter im Osten.");

  AddDetail(({"kies"}),
    "Der Kies erleichtert das Vorwaertskommen und Deine Schuhe werden auch "
    "nicht so schmutzig wie in der Erde.");

  AddDetail( ({"schuhe", "erde"}),
    "Du kannst nur schmutzige Schuhe haben, wenn da Erde WAERE.");

  AddDetail( ({"vorwaertskommen"}),
    "Tipp Norden, Osten oder Sueden.");

  AddDetail( ({"richtung"}),
    "In fast jeder Richtung gibt es hier etwas zu sehen.");

  AddDetail(({"frosch"}),
    "Du kannst den Frosch zwar hoeren, zu sehen ist er aber nicht. Er wird "
    "sichs wohl irgendwo im Schilf gemuetlich gemacht haben.");

  AddDetail(({"teich","ufer","westen"}),
    "Das Ufer des Teichs ist mit Schilf bewachsen. Einige Seerosen treiben "
    "auf der Wasseroberflaeche herum.");

  AddDetail(({"oberflaeche", "wasseroberflaeche"}),
    "Einige Seerosen treiben auf der Oberflaeche des Wassers herum.");

  AddDetail(({"wasser"}),
    "Das Wasser ist hier ziemlich nass.");

  AddDetail(({"rose","rosen","seerose","seerosen"}),
    "Prachtvolle, weisse Seerosen treiben vom Wind gefuehrt auf dem "
    "Teich herum. Unter den Blaettern schimmert etwas hervor.");

  AddDetail(({"blaetter"}),
    "Als Du die Blaetter genauer betrachtest, faellt Dir eine kleine "
    "Buechse auf. Ob man sie herausangeln kann?");

  AddDetail(({"schilf"}),
    "Das Schilf ist braun, hat einen langen Stiel und einen dunkelbraunen " 
    "Kopf. Es scheint als haette sich ein Frosch darin versteckt.");

  AddDetail(({"stiel","kopf", "teil"}),
    "Ein Teil vom Schilf.");

  AddDetail( ({"dose","buechse"}),
    "Ja, da ist eine!"); 

  AddDetail(({"himmel"}),
    "Du siehst nach oben. Nichts als strahlendes Blau.");

  AddDetail(({"blau","himmelblau"}), 
    "Ein wirklich himmlisches Himmelblau.");

  AddDetail( ({"suedwesten","holzsteg"}),
    "Von hier erkennst Du ihn nicht so gut, geh doch einfach hin.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst einen Frosch quaken. Ansonsten ist es hier eher still.");

  AddSound("frosch",
    "Quaaaaaaaaaaaaaaaaaaaaaaaaaaaaak.");

  AddSmell(DEFAULT_SMELL,
    "Du riechst die Blumen am Weg, die Seerosen im Teich und den Teich selbst.");

  AddSmell(({"blumen","weg"}),
    "Herrlich wie die duften.");

  AddSmell( ({"seerosen"}),
    "Sie duften ... aeh seerosig.");

  AddSmell(({"teich","teichwasser","wasser"}),
    "Riecht schon etwas abgestanden, das Teichwasser.");

  AddCmd(({"angel","angle"}),"anfunc");

  AddExit("norden",ROOM("14x6y.lpc"));
  AddExit("sueden",ROOM("16x6y.lpc"));
  AddExit("osten",ROOM("15x7y.lpc"));
  AddExit("suedwestoben",ROOM("16x5y.lpc"));
}

int anfunc(string str)
{ 
  object ob;
  string item, rod;

  notify_fail("Was moechtest Du angeln?\n");
  if (!stringp(str))
    return 0;
  if (sscanf( str, "%s mit %s", item, rod) !=2 )
  {
    write("Angle GEGENSTAND mit WAS?!\n");
    return 1;
  }
  if ( (item=="buechse" || item=="dose")  && rod=="angel")
  {
    if (!( ob=present ("angel",this_player())))
    {
      write("Du kommst nicht nahe genug ran.\n");
      say (this_player()->Name(WER,1)+" faellt fast in den Teich.\n");
      return 1;
    } 
    ob=present("angel",this_player());
    if (ob)
    { 
      if(i>1 || (deep_present("\nfischbuechse",this_player()))) 
      {
        write("Vergeblich versuchst Du Dir die Buechse zu angeln.\n");
        if(j==0){
          write("Doch Du erwischst ein Seerosenblatt.\n");
          clone_object("/d/ebene/lamuerte/fernglas/obj/qblatt.lpc")->move(this_player(),M_NOCHECK);
          j=1;
          return 1;
        }
        return 1;
      }
      write("Du angelst Dir die Buechse.\n");
      seteuid(getuid(this_object()));
      clone_object(OBJ("fisch"))->move(this_player());
      i=2;
      return 1;
    } 
  } 
  write ("So angelt man doch nicht.\n");
  return 1;
} 

void reset()
{
  ::reset();
  i=0;
  j=0;
}
