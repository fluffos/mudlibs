inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

int i;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
   "Der Burgweg endet hier, und setzt sich als Pferdegasse im Westen fort, "
   "welche ihren Namen den Stallungen, welche im Nordwesten der Stadt liegen, "
   "zu verdanken hat. Inmitten des Weges, abgegrenzt durch einen Zaun, steht "
   "ein Apfelbaum, welcher von der grossen Naturverbundenheit der Buerger zeugt. "
   "Im Sueden siehst Du einen Teil der Teichpromenade.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]));
  SetProp(P_INDOORS, 0);

  i=0;

  AddDetail(({"promenade","teichpromenade"}),
    "Sie ist hier, bis auf halbe Hoehe, einseitig mit Brettern zugenagelt.");

  AddDetail( ({"hoehe"}),
    "Gerade so hoch das Du noch mit den Haenden hinaufkommst.");

  AddDetail( ({"haende"}),
    "Davon hast Du zwei.");

  AddDetail( ({"bretter"}),
    "Die sind aus Eichenholz.");

  AddDetail( ({"holz","eichenholz"}),
    "Das kommt von einer Eiche.");

  AddDetail( ({"eiche"}),
    "Die existiert jetzt nur mehr als Holz.");

  AddDetail(({"teil"}),
    "Das ganze kannst Du wohl nur von oben ueberblicken. Du koenntest ja mal "
    "versuchen hinaufzuklettern.");

  AddDetail( ({"apfel","aepfel"}),
    "Hmmm.. Die sehen aber lecker aus.");

  AddDetail(({"stallung","stallungen"}),
    "Von hier aus ist nichts dergleichen zu erkennen.");

  AddDetail(({"zaun"}),
    "Der Zaun wurde aufgestellt um den Baum zu schuetzen.");

  AddDetail("boden",
    "Nichts besonderes am Boden zu finden.");  

  AddDetail(({"baum","apfelbaum"}),
    "Der Baum sieht rundum gesund aus.");

  AddDetail(({"buerger", "natur", "naturverbundenheit"}),
    "Die Buerger von Kyranda lieben die Natur.");

  AddDetail( ({"stadt", "kyranda"}),
    "Du bist in der Stadt Kyranda.");

  AddDetail(({"pferdegasse","gasse", "beginn", "namen"}),
    "Die Pferdegasse hat ihren Beginn weiter im Westen.");

  AddDetail(({"kies","kiesweg","weg","burgweg"}),
    "Der Kiesweg ist ziemlich ausgetreten. Offenbar wird er von vielen "
    "Einwohnern benutzt.");

  AddDetail(({"himmel", "blau"}),
    "Du siehst nach oben. Der Himmel leuchtet in seinem schoensten Blau. "
    "Hoffentlich faengt es nicht zu regnen an.");

  AddDetail("einwohner",
    "Hmm.. Keiner da? Oder doch!"); 

  AddSound(DEFAULT_SOUND,
    "Du hoerst nur die Blaetter des Apfelbaums im Wind rascheln.");

  AddSound(({"blaetter","apfelbaum","baum","wind"}),
    "Sie bewegen sich nur ganz leicht.");

  AddSmell(DEFAULT_SMELL,
    "Du riechst Essen! Und noch einen suessen Nebengeruch.");

  AddSmell(({"essen"}),
    "Wird wohl einer der Aepfel auf dem Baum sein.");

  AddSmell(({"baum"}),
    "Der Baum riecht nach Baum.");

  AddSmell(({"nebengeruch","geruch"}),
    "Der Baum hat wohl schon wieder die naechsten Blueten angesetzt.");

  AddSmell(({"blueten"}),
    "Himmlisch, wie die duften.");

  AddCmd(({"pflueck","pfluecke"}),"pfunc");
  AddCmd(({"klettere","kletter"}), "cmd_klettere");


  AddExit("westen",ROOM("11x4y.lpc"));
  AddExit("osten",ROOM("11x6y.lpc"));
}

int pfunc(string str)
{
  if (!str)
  {
    write ("Was willst Du denn pfluecken?\n");
    return 1;
  }
  if (i==1)
  {
    write("Sieht so aus, als ob alle Aepfel abgeerntet wurden.\n");
    return 1;
  }
  if(str!="apfel")
  {
    write("Das kann man nicht pfluecken!\n");
    return 1;
  }
  write("Du pflueckst Dir einen schoenen Apfel.\n");
  clone_object("/d/ebene/lamuerte/burg/obj/apfel")->move(this_player(),
      M_NOCHECK);
  i=1;
  return 1;
}

void reset()
{
  ::reset();
  i=0;
}

int cmd_klettere(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (!str)
    return 0;
  if (str != "promenade" && str != "auf promenade" && str != "hinauf" &&
      str != "rauf")
    return 0;
  write("Du kletterst die Wand hinauf, ziehst Dir aber ein paar Holzsplitter ein.\n");
  this_player()->AddHp(-5-random(5));
  this_player()->move(ROOM("12x5y"), M_GO, "die Wand hinauf", "klettert");
  return 1;
}
