
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
 ::create();
  SetProp(P_INT_SHORT,"Am Marktplatz");
  SetProp(P_INT_LONG,break_string(
    "Hier, im Nordosten des Marktplatzes, ist es etwas ruhiger. Hier steht "+
    "lediglich ein fahrender Haendler, der von einigen Passanten umringt wird. "+
    "In der Mitte des Platzes siehst Du einen kleinen kuenstlich angelegten Teich "+
    "mit Seerosen, was die zum Kauf anregende Atmosphaere nochmal unterstreicht."+
    "Nach Norden kannst Du einen kleinen Laden betreten.",78));

  AddSound(DEFAULT_SOUND,break_string("Hier ist das Geschnatter etwas leiser.",78));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24]));

  AddDetail(({"boden"}),break_string(
    "Der Boden ist gepflastert.",78));
  
  AddDetail("",
    "\n");
  AddDetail(({"burgweg"}),break_string(
    "Der Burgweg befindet sich ein Stueck weiter im Osten.",78));

  AddDetail(({"wasser","oberflaeche","wasseroberflaeche"}),
    "Du siehst Dir Dein Spiegelbild auf der Wasseroberflaeche an.\n");
            
  AddDetail(({"bild","spiegelbild"}),
    "Siehst Du heut wieder gut aus!\n");
                      
  AddDetail(({"teich","}),break_string(
    "Einige Seerosen treiben auf der Wasseroeberflaeche herum.",78));
                                        
  AddDetail(({"rose","rosen","seerose","seerosen"}),break_string(
    "Grosse weisse Blumen, welche an der Wasseroberflaeche wachsen.",78));
                                                                           

  AddExit("sueden",ROOM("marktplatz4"));
  AddExit("westen",ROOM("marktplatz1"));
  AddExit("norden",BURG("shop/kraeuterladen"));
}
