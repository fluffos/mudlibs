inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "files.h"
#include <pub.h>
#include "/gilden/bardengilde/barden_extern.h"

void create()
{
 ::create();
  SetProp(P_INT_SHORT,"Don Tonno's Pizze");
  SetProp(P_INT_LONG,
    "Du stehst in Tonno's Pizzastube. Es ist ein eher enger Raum mit einer niedrigen "
    "Decke. Hinter einem Pult steht Tonno, welcher herrliche Pizzen zaubert. "
    "Zu Tonno's linker Hand ist ein grosser Pizzaofen in der Mauer eingearbeitet "
    "welcher die benoetigte Hitze zum Pizzabacken erzeugt.");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_LIGHT,1);
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "tonno");
  SetProp( P_PUBKEEPER_NAME, "Tonno");
  SetProp( P_PUBKEEPER_GENDER, MALE);


//Details
  AddDetail(({"hand"}),
    "Welche Hand?");
  AddDetail(({"linke hand"}),
      "Sie schaut genauso aus wie die rechte Hand, nur spiegelverkehrt.");
  AddDetail(({"rechte hand"}),
      "Sie schaut genauso aus wie die linke Hand, nur spiegelverkehrt.");
  AddDetail(({"pizzen","pizza","pizze"}),
    "Du siehst so viele leckere Zutaten fuer die Pizzen, dass Du Hunger bekommst. "
    "Frag doch Tonno einfach mal danach.");

  AddDetail( ({"zutaten"}),
    "Was eben so zu einer Pizza dazu gehoert. Leider fallen auch hin und wieder "
    "einige der Zutaten auf den Boden. Tonno nimmt es mit dem Saubermachen wohl "
    "nicht so genau.");

  AddDetail( ({"pizzabacken","saubermachen"}),
    "Eigentlich sind das ja keine richtigen Hauptwoerter ... wie bist Du bloss "
    "darauf gekommen die untersuchen zu wollen?");

  AddDetail( ({"hauptwoerter","hauptwort","wort"}),
    "Hauptwort ist hingegen ein richtiges Hauptwort.");

  AddDetail( ({"hunger"}),
    "Dein Magen grummelt schon ganz laut.");

  AddDetail( ({"magen", "grummmel"}),
    "*GRUMMMEL*HUNGER*");

  AddSound( ({"magen", "grummmel"}),
    "*GRUMMMEL*HUNGER*");

  AddDetail(({"raum","stube","pizzastube"}),
    "Es ist eng und heiss hier, aber Tonno hat es irgendwie geschafft, vor dem Pult "
    "noch ein paar Tische und Hocker fuer die Gaeste hinzustellen.");

  AddDetail( ({"tische","tisch","hocker"}),
    "Da sitzen die Gaeste die ihre Pizza gleich hier essen wollen.\n"
    "Sie sind aus Holz.\n"
    "Nicht die Gaeste, die Tische und Hocker!\n"
    "Bring doch nicht immer alles durch einander.\n");
    
  AddDetail( ({"gast","gaeste"}),
    "Du bist einer von ihnen.");

  AddDetail( ({"boden"}),
    "Der Boden ist etwas dreckig. Es sind aber fast nur heruntergefallene Zutaten.");

  AddDetail( ({"dreck"}),
    "Es ist hauptsaechlich nur dreckiges Mehl, das heruntergefallen ist und nun "
    "zertrampelt wird.");

  AddDetail("decke",
    "Sie ist schwarz, vom offenen Feuer im Pizzaofen. Du glaubst, dass sie mal aus Holz war.");

  AddDetail( ({"holz"}),
    "Meinst Du das Deckenholz oder das Einrichtungsholz.");

  AddDetail( ({"einrichtungsholz"}),
    "Das duerfte stabile Eiche sein.");
    
  AddDetail( ({"eiche"}),
    "Die hier drinnen ist schon lange tot.");

  AddDetail( ({"deckenholz"}),
    "Das kann man jetzt nicht mehr erkennen.");

  AddDetail(({"ofen","pizzaofen"}),
    "Er ist gross, heiss und ideal zum Pizzabacken. Aussehen tut er wie die obere "
    "Haelfte einer grossen Kugel, mit einem Einschub fuer die Pizzen.");

  AddDetail( ({"kugel"}),
    "Die ist normalerweise rund.");

  AddDetail( ({"einschub"}),
    "Ueber diesen Einschub holt Tonno die Pizzen mit seinem Paddel entweder aus dem "
    "Ofen heraus oder steckt sie hinein.");

  AddDetail( ({"paddel"}),
    "Das hat er wohl von aus dem Hafen geklaut.");
    
  AddDetail( ({"hafen"}),
    "Weit weg von hier.");

  AddDetail("feuer",
    "Das Feuer lodert im Pizzaofen. Auf einer Platte darueber brutzeln die Pizzen vor "
    "sich hin.");

  AddDetail( ({"platte"}),
    "Da passen schon einige Pizzen drauf.");

  AddDetail(({"wand","waende","mauer"}),
    "Ganz normale Waende, nur in der hinteren Wand ist der Pizzaofen eingearbeitet.");
 
  AddDetail("hitze",
    "Ja echt schoen warm hier.");
 
  AddDetail("pult",
    "Das Pult nimmt die hintere Haelfte des Raumes vor dem Ofen ein und ist leicht "
    "mehlig. Kommt wohl vom Pizzabacken.");

  AddDetail( "mehl",
    "Auf dem Pult liegt Mehl.");

  AddDetail( ({"haelfte"}),
    "Wenn Du weiter so gut forschst, gibt es vielleicht sogar eine halbe "
    "Pizza gratis.");

//Gerueche
  AddSmell(DEFAULT_SMELL,
    "Es duftet gut nach Pizza und Zutaten.");

  AddSmell( ({"pizza"}),
    "Du riechst den fast fertig gebackenen Teig."),

  AddSmell( ({"teig"}),
    "Frisch und knusprig.");

  AddSmell( ({"zutaten"}),
    "Du riechst Tomaten, Kaese, Zwiebel, Oregano, Pilze, Schinken, Salami "
    "und vieles mehr.");

  AddSmell( ({"tomaten", "kaese", "zwiebel", "oregano", "pilze", 
        "schinken", "salami"}),
    "Das sind nur einige der Zutaten. Du kannst aber nicht sehen, ob Tonno "
    "sie hinter seinem Pult lagert.");


//Geraeusche 
  AddSound(DEFAULT_SOUND,
      "Du hoerst das Feuer knistern und die Gaeste murmeln.");

  AddSound( ({"feuer", "knacks", "knister"}),
    "*Knacks*Knister*");

  AddSound( ({"gaeste","gemurmel"}),
    "Ein unverstaendliches Gemurmel.");

  AddItem(NPC("pizza.lpc"),REFRESH_DESTRUCT);

//Exits
  AddExit("sueden","/d/ebene/lamuerte/burg/weg/12x11y.lpc");

  AddDrink("Fluessige Pizza", ({"fluessige pizza"}),
      40, 7, 3, 3, "fluessigpizza" );
  AddDrink("Achterl Wein", ({"achterl", "achterl wein", "wein"}), 
      100, 20, 5, 2,
      ({"Tonno bringt Dir Dein Achterl Wein.\n"
        "Der Wein schmeckt so gut, dass Du Dich aergerst, dass er kein Vierterl gibt.",
       "Tonno bringt && ein Achterl Wein und moechte eigentlich ein Vierterl."}));
  AddDrink("Red Tonno", ({"tonno", "red", "red tonno", "tomatensaft"}),
      240, 40, 0, 12, 
      ({"Du schluerfst einen von Tonno selbstgepressten Tomatensaft.",
        "&& schluerft einen von Tonno selbstgepressten Tomatensaft."}) );
  AddDrink("Fruechtecocktail Gaffodorf", ({"fruechtecocktail", "cocktail", 
        "gaffodorf", "fruechtecocktail gaffodorf"}),
      450, ({20,80,20}), 0, 22, 
      ({"Du trinkst den Fruechtecocktail und glaubst im Gaffodorf zu sein.",
        "&& trinkt einen Fruechtecocktail."}) );
  AddFood ( "Mini Pizza", ({"mini-pizza", "minipizza", "mini"}),  
      45, ({17,5,3}), 4,
      ({"Du bestellst eine Mini-Pizza und wirst lange nicht satt.", 
       "&& bestellt eine winzig kleine Pizza."}) );
  AddFood ( "Pizza", ({"pizza"}),  
      170, ({30,25,5}), 9,
      ({"Du bestellst eine leckere Pizza.", 
       "&& bestellt eine leckere Pizza."}) );
  AddFood ( "Riesen Pizza", ({"riesen pizza", "riesenpizza", "riesen"}),  
      691, ({90,70,10}), 25,
      ({"Du bestellst eine Riesen Pizza.\n\n"
       "Tonno bringt Dir eine Pizza so gross wie ein Wagenrad.\n"
       "Jetzt bist Du bis oben hin komplett voll.", 
       "&& bestellt eine Pizza so gross wie ein Wagenrad.\n"
       "&& musst ja riesigen Hunger haben!"}) );
  AddFood ( "Die Pizza aller Pizzas", ({"pizza aller pizzas"}),  
      3852, 400, 55, "pizza_essen" );
}

public void pizza_essen() {
  object task;

  write(BS("Du bestellst die Pizza aller Pizzas.\n\n"
           "Tonno bringt Dir eine Pizza, die fast die ganze Pizzastube ausfuellt!.\n"
           "Jetzt bist Du bis oben hin komplett voll."));
  say(BS(TPN+" bestellt eine Pizza, fast so gross wie die ganze Pizzastube.\n"
         "Du traust Deinen Augen nicht, als "+TPN+" die ganze Pizza verschlingt!"));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(4);
  }
}

int fluessigpizza(object z, object e)  // z=Zahler, e=Empfaenger
{
  tell_object(e, break_string("Du trinkst fluessige Pizza und beschliesst, "
        "in Zukunft lieber wieder feste Pizza zu essen.", 78));
  tell_room(this_object(),break_string(mess(
          "&& trinkt fluessige Pizza und macht ein angewiedertes Gesicht."),78),
      ({e}));
  e->SetProp(P_FOOD, e->QueryProp(P_FOOD)-random(5));
  return 1;
}

