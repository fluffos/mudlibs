inherit "/std/pub";

#include <rooms.h>
#include <properties.h>
#include <mnpc.h>
#include "../files.h"

create(){
   ::create();

   
   AddDrink("Kinderpunsch",({"kinder","kinderpunsch"}),25,11,0,5,
            ({"Alkoholikus grinst Dich an als er Dir Deinen Kinderpunsch "
              "bringt und Du ihn hinunterwuergst.",
              "&& wird rot beim Kinderpunschtrinken."}));

   AddDrink("Punsch","punsch",45,10,5,1,
            ({"Alkoholikus serviert Dir einen heissen Punsch. Du schluerfst "
              "ihn genuesslich aus.",
              "&& trinkt genuesslich einen Punsch."}));

   AddDrink("Mad Punsch",
            ({"mad","madpunsch"}),
            70,23,6,1,
            ({"Alkoholikus grinst verdaechtig als er Dir deinen Mad Punsch reicht. "
              "Doch Du findest ihn lecker und trinkst ihn aus.",
              "&& wankt einwenig beim schluefen des Mad Punsch."}));

   AddDrink("Gluehmost",({"most","gluehmost"}),
            90,31,7,3,
            ({"Du spuerst ein leichtes druecken in Deinen Gedaermen "
              "als Du den Gluehmost trinkst.",
              "&& trinkt genuesslich einen Gluehmost."}));
   AddDrink("Feuerzangenbowle",({"feuer","bowle","feuerzangenbowle"}),
            110,38,9,4,
            ({"Alkoholikus schuettet Rotwein, Orangen, Zitronensaft, "
              "Zimt und Nelken in einen Porzellanbecher - mit einem kleinen "
              "Feuerball erhitzt er das Gemisch. Alkoholikus spannt die "
              "original "
              "Feuerzange (tm) sammt Zuckerhut ueber den Becher, uebergiesst "
              "sie mit 80% Rum, entflammt das Gemisch und stellt es Dir hin. "
              "Hastig saufst Du "
              "die noch brennende Feuerzangenbowle runter. Das war doch wohl "
              "etwas zu bald. Du dampfst ein wenig.", 
              "&& schuettet eine Feuerzangenbowle in sich rein. "
              "Du siehst aus den Ohren von && etwas Rauch aufsteigen."}));
   
   AddDrink("Holzertee",({"holzertee","tee","holzer"}),
            310,41,21,3,
            ({"Dir kommt vor als muesstest Du Dich uebergeben beim "
              "Genuss des warmen Schnapses der mal an einem Gluehfix "
              "vorbeigezogen wurde.",
              "&& trinkt verkrampft einen Holzertee."}));

   AddDrink("Flaming Gluehwein",({"flaming","wein","gluehwein"}),
            450,55,11,4,
            ({"Alkoholikus mixt einige Schnapssorten in einem Becher zusammen "
              "haengt ein feuchtes Gluehfix fuer eine Sekunde hinein und serviert Dir "
              "das Gesoeff. Du kippst beinahe um als Du es austrinkst.",
              "&& kippt beinahe um beim Genuss eines Flaming Gluehwein."}));

   
   AddFood("Surbratlsemmal", ({"surbratlsemmal","semmal", "surrbratensemmerl","surbratensemmal"}),
          30,30,36,
          ({"Du mapmfst das leckere Semmerl auf. Hmm, war das gut! Am liebsten "
            "wuerdest Du gleich noch eines trinken. Aeh, essen. Bloeder Gluehwien *hick*!",
            "&& mampft ein leckeres Surbratensemmal."}) );

   AddFood("Eine Tuete mit 19 Stueck Maroni", ({"tuete","maroni","19 stueck maroni"}),
          40,35,40,
          ({"Nacheinander schaelst Du alle Maroni und mampfst sie auf. Hmm warn "
            "die lecker!",
            "&& mampft 19 Stueck Maroni."}) );

   AddFood("Ein riesiges Raclettekaesbrot", ({"brot","kaesbrot","kaesebrot","raclettekaesbrot"}),
          92,95,89,
          ({"Gnuesslich verschlingst Du das grosse Brot mit dem darauf befindlichem "
            "Raclettekaese. Du bist irgendwie total vollgefressen.",
            "&& verschlingt ein Raclettekaesbrot."}) ); 

   AddFood("Ein warmes Sarnakschinkenweckerl", ({"sarnakschinkenweckerl","schinkenweckerl", "weckerl"}),
          1800,342,20,
          ({"Du schlingst das Sarnakschinkenweckerl auf ein mal runter. Das war "
            "wirklich ein Genuss, es war wohl Beinschinken eines Sarnak Orakels. Du willst sofort noch eins!",
            "&& mampft ein Sarnakschinkenweckerl."}) );
   
//   AddFood("Ein Schokonikolaus-Kraftriegel", ({"schoko","schokonikolaus","nikolaus","kraftriegel","riegel","schokonikolaus-kraftriegel"}),
//          100,342,10,
//          ({"Du knabberst den Schokonikolaus-Kraftriegel. "
//            "Mann, diese Wirkung! Schade das es ihn nut am Nikolaustag gibt.",
//            "&& mampft einen Schokonikolaus-Kraftriegel."}) );
   AddExit("norden", "/d/ebene/Midas/room/room_b5");

   SetProp(P_INT_SHORT,"Ein Punschstand");
   SetProp(P_INT_LONG,break_string("Du stehst vor einem kleinen "
               "Punschstand. Es duftet hier herrlich nach Punsch, Gluehwein, "
               "Gluehmost und Surbratensemmal. Schoen, dass es in der Weihnachtszeit "
               "solche Dinge gibt. Der Stand ist aus Holzbalken gebaut. Eine "
               "lange Theke, hinter der Alkoholikus der Punschstandbetreiber "
               "steht, dient zum ausschenken der heissen Getraenke. Du solltest Dir "
               "schnell was Warmes zu trinken kaufen, sonst erfrierst Du noch. "
               "Ein kleines Schild haengt an einer Seite des Punschstandes.",78));	
   SetProp(P_LIGHT,1);
   SetProp(P_INDOORS,0);
AddItem("/players/iwo/xthings/xdwarf.lpc",REFRESH_DESTRUCT, ([P_MNPC_FLAGS:0]) );

AddSmell(DEFAULT_SMELL,
 "Es riecht nach Weihnachten.\n");
 

AddDetail(({"punschstand","stand"}),
 "Der Punschstand sieht sehr einladend aus, Du solltest Dir ruhig (noch) einen genehmigen.");

AddDetail(({"alkoholikus","punschstandbetreiber","betreiber"}),
 "Alkoholikus steht hinter der Theke, er bewirtet alle mit einem breiten "
 "Grinsen. Anscheinend ist er auch schon etwas angeheitert.");

AddDetail("theke",
    "Die Theke ist schon etwas feucht, duerften einige vor Dir schon ihre Getraenke "
    "verschuettet haben.");

AddDetail("getraenke",
    "Es gibt hier Punsch, Gluehwein, Gluehmost etc.. alles was zu einem Punschstand "
    "so dazugehoert.");

AddDetail("schild",
    "Lies es doch einfach.");

AddDetail("punsch",
    "Etwas suess, doch sehr lecker. Probier doch (noch) einen!");

AddDetail(({"gluehwein","wein"}),
    "Alkoholikus mischt den besten Gluehwein den es gibt! Probier ihn!");

AddDetail(({"gluehmost","most"}),
    "Auch lecker, doch pass auf, der kann in die Hose gehen.");

AddDetail("hose",
    "Ist Deine noch sauber?");

AddDetail(({"semmel","surbratensemmal","semmal"}),
    "Kauf Dir eine!");

AddDetail(({"surrbraten","braten"}),
    "Hmm, Lecker, es git sogar einen zu kaufen hier!");

AddDetail("weihnachten",
    "Ja, bald ist es soweit!");

AddDetail("weihnachtszeit",
    "Schon ist sie schon, oder findest Du nicht?");

AddDetail(({"balken","holzbalken"}),
    "Duerfte Buchenholz sein.");

AddDetail(({"holz","buchenholz"}),
    "Ja, Du bist Dir sicher es ist Buchenholz.");

AddDetail("decke",
    "Ueber Dir ist nur das Vordach vom Punschstand zu sehen.");

AddDetail("vordach",
    "Es ist halbwegs gross und schuetzt die Punschler vor Schnee und Regen.");

AddDetail("punschler",
    "Naja, diese welche die halt an Punsch sauffa.");

AddDetail(({"wand","waende"}),
    "Die Waende vom Punschstand sind aus Holz.");

AddDetail("seite",
    "Ja, an einer Seite haengt ein Schild. Lies es.");

AddDetail("regen",
    "Naja, momentan ist keiner zu sehen.");

AddDetail("schnee",
    "Schnee ist gefrorener Regen.");

AddDetail("dinge",
    "Punsch und so halt...");

AddDetail("boden",
    "Der Boden pickt. Anscheinens wurde schon so mancher Gluehwein verschuettet.");

AddReadDetail("schild",
  "------------------\n" 
  "| Ho Ho Ho !!!!! |\n"
  "| Der Gewinn von |\n"
  "| diesem Punsch- |\n"
  "| stand wird fuer|\n"
  "| einen guten    |\n"
  "| Zweck gespendet|\n"
  "------------------\n"
);

}


