inherit "/std/pub";

#include <rooms.h>
#include <properties.h>
#include <mnpc.h>
#include "../files.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"Goranors Brauerei");
  SetProp(P_INT_LONG,"Du stehst in Goranors Brauerei. "
    "Die kleine Brauerei hat alles fuer den echten Biergeniesser. "
    "Die linke Haelfte der Brauerei ist voll mit Brauwerkzeug und "
    "Bottichen, in welchen Hopfen und Malz gelagert werden. Die "
    "andere Haelfte ist gemuetlich eingerichtet, um den Bewohnern "
    "von Kyranda und den Gaesten der Stadt ein gemuetliches Miteinander "
    "zu ermoeglichen.\n"
    "Solltest Du durstig sein, tippe: 'menue'.\n");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_HOUSE]));

  AddDetail("kyranda",
    "So heisst die Stadt.");

  AddDetail( ({"stadt"}),
    "Kyranda.");

  AddDetail(({"goranor","braumeister"}),
    "Goranor ist ein kleiner, etwas dicklicher Mann, der Dir sehr vertraut "
    "vorkommt. Er ist der Braumeister dieser Brauerei.");

  AddDetail( ({"mann"}),
    "Er huscht so geschaeftig hin und her, dass Du ihn Dir gar nicht richtig "
    "ansehen kannst.");

  AddDetail(({"bier"}),
    "Das beste Bier von ganz Kyranda wird sicherlich in dieser Brauerei "
    "hergestellt. Es ist ja auch die einzige in der Stadt.");

  AddDetail(({"biergeniesser"}),
    "Naja, viele Biergeniesser treffen sich hier, um gemuetlich einen zu heben.");

  AddDetail(({"zutat","zutaten","hopfen","malz"}),
    "Hopfen und Malz sind in den Bottichen gelagert.");

  AddDetail(({"brauerei","ort"}),
    "Es ist wirklich sehr gemuetlich hier drinnen.");

  AddDetail( ({"haelfte"}),
    "Wie das bei Haelften so ist, ergeben zwei davon ein Ganzes.");

  AddDetail(({"ganz","ganzes"}),
    "Das ist dann die Brauerei.");

  AddDetail(({"brauwerkzeug","werkzeug"}),
    "Du untersuchst die verschiedensten Werkzeuge, kannst "
    "aber nichts damit anfangen.");

  AddDetail(({"bottich","bottiche"}),
    "In den Bottichen werden die Zutaten, welche fuer die Bierherstellung "
    "benoetigt werden, gelagert.");

  AddDetail( ({"bierherstellung","herstellung"}),
    "Das ist ein langes und kompliziertes Verfahren."),

  AddDetail( ({"verfahren"}),
    "Das soll Dir am besten der Braumeister erklaeren.");

  AddDetail(({"bewohner"}),
    "Die Bewohner lieben diesen Ort.");

  AddDetail("boden",
    "Der Boden sieht sehr sauber aus.");

  AddDetail( ({"wand","waende"}),
    "Du findest nichts besonderes an den Waenden.");

  AddDetail( "decke",
    "Du findest absolut nix ungewoehnliches an der Decke.");

  AddDetail( ({"miteinander"}),
      "Die Bewohner von Kyranda leben gemuetlich miteinander.");

  AddDetail(({"gast","gaeste"}),
    "Auch Du bist einer von ihnen.");

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach herrlichem Bier und nach irgendeinem undefinierbarem "
    "Nebengeruch.");

  AddSmell( ({"nebengeruch","geruch"}),
    "Das wird wohl von den ruelpsenden Gaesten kommen.");

  AddSmell( ({"gaeste","gaesten"}),
    "Untersteh Dich an den Gaesten rumzuschnueffeln!");

  AddSmell( ({"bier"}),
    "Jetzt sag bloss, Du weisst nicht wie Bier riecht.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst das Murmeln der Gaeste, das Blubbern des Bieres in "
    "den Bottichen und das Ruelpsen der Biertrinker.");

  AddSound(({"murmeln", "gaeste","wortfetzen","worte","fetzen"}),
    "Du versuchst einige Wortfetzen zu erhaschen, verstehst aber nichts.");

  AddSound(({"blubbern", "bier", "bottiche"}),
    "Eigentlich ist es so leise, dass Du eher denkst, das es Dir eingebildet "
    "hast.");

  AddSound(({"ruelpsen", "biertrinker"}),
    "Das willst Du eigentlich gar nicht hoeren. Riechen tust Du es aber trotzdem.");

  AddItem(NPC("betrunkener.lpc"),REFRESH_DESTRUCT, ([P_MNPC_FLAGS:0]) );

  AddExit("sueden", BURGWEG("12x9y.lpc"));

   AddDrink("Kyrandas Alkoholfrei",({"alkfrei","alkoholfrei"}),40,11,0,5,
            ({"Der Braumeister bringt Dir das Bier, welches Du mit Gewalt "+
              "hinunterwuergst.",
              "&& trinkt ein Kindergetraenk."}));
   
   AddDrink("Kyrandas Leicht","leicht",60,10,5,1,
            ({"Der Braumeister bringt Dir das Bier, welches Du genuesslich "+
              "ausschluerfst.",
              "&& trinkt ein kuehles Leichtbier."}));

   AddDrink("Kyrandas Urtyp",
            ({"urtyp"}),
            100,23,8,1,
            ({"Als Du Dein Bier bekommst, schuettest Du alles auf einmal "+
              "in Dich rein.",
              "&& nimmt ein Bier ex."}));

   AddDrink("Kyrandas Weizenbier",({"weizen","weizenbier"}),
            150,31,9,3,
            ({"Schneller als Du schaun kannst, steht Dein Weizenbier "+
              "auf dem Tisch. Der\nBraumeister traut seinen Augen kaum, "+
              "als Du es in null komma nix wegputzt.",
              "&& trinkt genuesslich ein Weizenbier."}));

   AddDrink("Kyrandas Starkbier",({"stark","bier","starkbier"}),
            450,55,11,4,
            ({"Du kippst ein Starkbier wech. Schoen langsam schwindet Dein "+
              "Gleichgewichtssinn.",
              "&& trinkt ein Starkbier."}));

   AddFood("Bierbrezel", ({"brezel", "bierbrezel"}),
          30,10,5, "brezel");
}


int brezel(object z, object e)  // z=Zahler, e=Empfaenger
{
  tell_object(e, break_string(
        "Du knabberst an Deiner Bierbrezel und hast sofort wieder Lust "
        "auf ein Bier."));
  tell_room(this_object(), break_string(mess( "&& knabbert an einer Bierbrezel.")), ({e}) );
  e->SetProp(P_DRINK, e->QueryProp(P_DRINK) - 1);
  e->SetProp(P_ALCOHOL, e->QueryProp(P_ALCOHOL) - 1);
  return 1;
}
