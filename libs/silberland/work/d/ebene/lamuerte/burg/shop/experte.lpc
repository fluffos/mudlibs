inherit "std/laden";

#include <properties.h>
#include <laden.h>
#include "../files.h"

#define VGL_PREIS 753
#define LAGER (BURG("shop/experte_store.lpc"))

void create()
{
  ::create();
  mymoney=0;

  SetProp(P_INT_SHORT, "Im Laden des Waffenhaendlers");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Waffenladen von Kyranda. Waffenexperten aller "
    "Nationen treffen sich hier um ihre Erfahrungen mit den verschiedensten "
    "Waffen aller Rassen auszutauschen. Ausser einem Holzbrett, welches als "
    "Informationstafel dient, liegen auch noch Unmengen an Waffen und "
    "Ruestungen hinter dem Ladentisch.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Murtos");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOPKEEPER_ID, "murtos");

  AddDetail (({"waffenladen","laden"}),
   "Die vielen Waffen und Ruestungen, welche hinter dem Ladentisch lagern, "
   "beeindrucken Dich regelrecht.");

  AddDetail( ({"tisch", "ladentisch","schubladen"}),
    "Der Ladentisch und alles was dazu gehoert, besteht aus Holz."); 

  AddDetail (({"waffenexperten"}),
   "Es scheint gerade keiner aus den anderen Nationen hier zu sein.");

  AddDetail(({"nation","nationen"}),
    "Da gibt es z.B. den Hans aus dem Tamedhon, den Sengir aus dem Beutelland "
    "oder einen der zahllosen Schmiede aus dem Morgengrauen.");

  AddDetail( ({"hans","tamedhon","land","lande", "schmiede", "schmied", "lehrling"}),
    "Der war hier in der Schmiede in Kyranda mal Lehrling, aber so schlecht, "
    "das er rausgeworfen wurde und ins Lande Tamedhon ausgewandert ist.");

  AddDetail( ({"sengir","beutelland"}),
    "Der war zwar frueher hier sehr oft zugegen, aber seit das Beutelland gegruendet "
    "wurde, hat er dort als Zwergenschmied sein Glueck versuchen wollen.");

  AddDetail( ({"morgengrauen", "morgen"}),
    "Da graut es Dir jeden Morgen.");

  AddDetail( ({"zwergenschmied","glueck"}),
    "Besuch ihn doch dort einmal. Es liegt in Uebersee, hinter den sieben Bergen, bei "
    "den sieben Zwergen.");

  AddDetail(({"uebersee","berge","zwerge"}),
    "Das ist keinesfalls hier.");

  AddDetail(({"erfahrungen", "rassen","rasse"}),
    "Jede Rasse hat ihre, speziell fuer sie gefertigten, Waffen und Ruestungen, "
    "auch wenn es einigen Rassen unter bestimmten Bedingungen moeglich ist, die "
    "Waffen der anderen zu zuecken bzw. die Ruestungen zu tragen.");

  AddDetail(({"bedingung","bedingungen"}),
    "Das kommt immer darauf an was es ist.");

  AddDetail (({"waffen", "ruestungen","unmengen"}),
    "Versuchs mal mit <zeige>!");

  AddDetail (({"boden"}),
    "Du stehst genau darauf.");

  AddDetail( ({"holz", "holzstamm", "holzstaemme"}),
    "Das Holz stammt sicher aus dem Wald suedlich von Kyranda.");

  AddDetail( ({"wald"}),
    "Der Wald ist suedlich von Kyranda.");

  AddDetail( ({"kyranda","stadt"}),
    "Du befindest Dich in der Stadt Kyranda.");

  AddDetail (({"decke"}),
    "Die hoelzerne Decke ist aus maechtigen Holzstaemmen gefertigt.");

  AddDetail (({"waende", "wand"}), 
    "Auch die Waende sind aus Holz gefertigt.");

  AddDetail (({"brett", "holzbrett"}),
    "Eine Tafel mit Preisen. Du kannst sie lesen.");

  AddDetail (({"tafel","informationstafel"}),
      "Du kannst sie lesen.");

  AddReadDetail (({"tafel","informationstafel"}),
    "+------------------------------------------+\n"
    "|  Dank einer Idee eines Waffenexperten    |\n"
    "|  aus Midas, koennen auch wir fuer ein    |\n"
    "|  kleines Entgelt von "+VGL_PREIS+" Muenzen sagen,  |\n"
    "|  was Deine Waffe im Vergleich zu einer   |\n"
    "|  Anderen so drauf hat.                   |\n"
    "|                                          |\n"
    "|  Syntax: vergleiche <x> mit <y>          |\n"
    "+------------------------------------------+\n");

  AddSmell(DEFAULT_SMELL,
    "Es riecht hier nach vergammeltem Leder und Waffenputzmittel.");

  AddSmell( ({"leder"}),
    "Das liegt alles irgendwie hinter dem Ladentisch.");

  AddSmell( ({"waffenputzmittel","putzmittel"}),
    "Das hat der Ladenbesitzer sicher irgendwo in den Schubladen des Tisches. "
    "Oder es sich sicher im Lager verstaut.");

  AddDetail( ({"ladenbesitzer","besitzer", "murtos", "gieros"}),
    "Murtos Gieros ist der Besitzer dieses Ladens.");

  AddDetail( ({"lager"}),
    "Du fragst Dich, wo das sein mag.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst irgendwo ganz hinten jemanden eine Fluchtirade loslassen.");

  AddSound( ({"fluchtirade","tirade","fluch"}),
    "Haben diese verdammten Maeuse schon wieder das Leder angefressen.");

  AddDetail( ({"maeuse"}),
    "Maeuse? Hier? Du springst vor Schreck auf einen Stuhl.");

  AddDetail( ({"schreck","stuhl"}),
    "Als Du Dich von Deinem Schreck erholt hast, bemerkst Du das da gar kein "
    "Stuhl ist.");

  SetStorageRoom (LAGER);
  SetBuyFact (4);

  AddItem( NPC("murtos"), REFRESH_DESTRUCT);
  
  AddExit("norden", BURGWEG("15x8y.lpc"));
}

