inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "files.h"
#include "/p/daemon/skillmaster/skillmaster.h"


void create()
{
 ::create();
  SetProp(P_INT_SHORT,"Bardo's Naeherei");
  SetProp(P_INT_LONG,
    "Du stehst in Bardo's Naeherei. Es ist ein eher enger Raum mit einer niedrigen "
    "Decke. Hinter einem Pult steht Bardo, welcher ein Meister seines Faches ist. "
    "An den Waenden haengen einige Felle und einiges an Leder, welche Bardo braucht "
    "um seine Sachen zu naehen. Dir sticht ein Schild ins Auge.");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_LIGHT,1);

  AddDetail(({"naeherei","raum"}),
    "Du stehst mitten drinnen.");

  AddDetail(({"fach","faches"}),
    "Es scheint sich um Naeherei zu handeln.");

  AddDetail(({"schild"}),
    "Man kann es lesen.");

  AddReadDetail(({"schild"}),
    "+------------------------------+\n"
    "| Folgene Kommandos kannst Du  |\n"
    "| in dieser Naeherei benutzen: |\n"
    "|                              |\n"
    "|  - naehfertigkeit            |\n"
    "|  - gerbfertigkeit            |\n"
    "|  - topgerber                 |\n"
    "|  - topnaeher                 |\n"
    "|                   Bardo      |\n"
    "+------------------------------+\n");

  AddDetail(({"decke"}),
    "Sie ist sauber, Bardo scheint reinlich zu sein.");
  
  AddDetail(({"sachen"}),
    "Phuu, er macht viel - viel zu viel, um es aufzuzaehlen.");

  AddDetail(({"meister"}),
    "Du bist sicher keiner, aber Bardo, der ist einer.");

  AddDetail(({"fell","felle"}),
    "Es sind lauter verschiedene Felle.");

  AddDetail( ({"auge"}),
    "Autsch. Du bist zu nah rangegangen und hast Dir wirklich damit ins "
    "Auge gestochen.");

  AddDetail(({"boden"}),
    "Der Boden ist blank, man koennte von ihm essen.");

  AddDetail(({"wand","waende"}),
    "Ganz normale Waende.");

  AddDetail(({"leder"}),
    "Das Leder wird aus Fellen gemacht.");

  AddDetail("pult",
    "Das Pult ist blitzeblank.");

  AddSmell(({DEFAULT_SMELL, "leder"}),
    "Es riecht nach gegerbtem Leder.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst so gut wie gar nichts.");

  AddItem("/p/std/skills/sewing_tanning/npc/bardo.lpc",REFRESH_DESTRUCT);


  AddExit("norden","/d/ebene/lamuerte/burg/weg/12x10y.lpc");

  AddCmd("topnaeher", "tn_func");
  AddCmd("topgerber", "ge_func");
  AddCmd("gerbfertigkeit", "gge_func");
  AddCmd("naehfertigkeit", "ttn_func");
}

int tn_func(string str){
  int i;
  string output;
  notify_fail("Kommando: topnaeher <1-100>\n");
  if(!str) return 0;
  i=to_int(str);
  if(i<1 || i>100) return 0;
  output=SKILLMASTER->QueryTopList(i,"sk_sewing");
  tell_object(this_player(), "                    TOPNAEHER\n");
  this_player()->More(output);
  return 1;
}

int ge_func(string str){
  int i;
  string output;
  notify_fail("Kommando: topgerber <1-100>\n");
  if(!str) return 0;
  i=to_int(str);
  if(i<1 || i>100) return 0;
  output=SKILLMASTER->QueryTopList(i,"sk_tanning");
  tell_object(this_player(), "                    TOPGERBER\n");
  this_player()->More(output);
  return 1;
}

int gge_func(){
  SKILLMASTER->QuerySkill(this_player(),"sk_tanning",1);
  return 1;
}

int ttn_func(){
  SKILLMASTER->QuerySkill(this_player(),"sk_sewing",1);
  return 1;
}
