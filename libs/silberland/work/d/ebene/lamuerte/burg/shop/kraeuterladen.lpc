inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../files.h"

#define LAGER BURG("shop/kraut_store.lpc")

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Laden der Kraeuterfrau");
  SetProp(P_INT_LONG, 
    "Du stehst inmitten einer kleinen Holzhuette, welche der Kraeuterfrau "
    "von Kyranda gehoert. Sie ist allseits als Hexe bekannt, doch die "
    "Buerger von Kyranda sind froh, sie in ihrer Stadt zu haben, denn ihre "
    "Heilkraefte sind den Geruechten nach unglaublich gross. "
    "Im ganzen Laden haengen die verschiedensten Kraeuter an den Waenden.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

  SetProp(P_SPECIAL_SHOP, ([1:"Tut mir leid, wir kaufen nichts an!\n"]));
  SetStorageRoom (LAGER);
  SetBuyFact (5);

  AddDetail (({"laden", "raum"}), 
    "Ueberall haengen die Kraeuter herum. Du fragst Dich, wo man nur solch "
    "eine Vielfalt an verschiedenen Kraeutern herbekommen kann.");

  AddDetail (({"frau","kraeuterfrau"}),
   "Du siehst Dich um, siehst sie aber nicht.");

  AddDetail (({"kraut", "kraeuter", "vielfalt"}),
    "Versuchs mal mit <zeige>!");

  AddDetail (({"boden"}),
    "Du stehst genau darauf.");

  AddDetail (({"decke"}),
    "Die hoelzerne Decke ist aus maechtigen Holzstaemmen gefertigt.");

  AddDetail (({"waende", "wand"}),
    "Auch die Waende sind aus Holz gefertigt.");

  AddDetail(({"holzhuette","huette"}),
    "Die Huette sieht nicht gerade einladend aus.");

  AddDetail( ({"holz", "holzstaemme", "holzstamm"}),
    "Ja, echtes Holz! Sagenhaft!");

  AddDetail(({"kyranda"}),
    "So heisst die Stadt, in der Du Dich aufhaeltst.");

  AddDetail(({"stadt"}),
    "Den Namen hast Du doch gerade eben untersucht, ... schon wieder vergessen?");

  AddDetail( ({"buerger"}),
    "Die wirst Du hier drinnen nie zu sehen bekommen.");

  AddDetail( ({"hexe, geruechte"}),
    "Nach dem Du sie nirgends sehen kannst, weisst Du auch nicht ob die "
    "Geruechte der Wahrheit entsprechen.");

  AddDetail( ({"wahrheit"}),
    "Blicke in Dich hinein und finde sie.");

  AddDetail(({"heilkraefte"}),
    "Der Kraeuterfrau werden so manche Heilkraefte zugesprochen.");

  AddSmell(DEFAULT_SMELL,
    "Es stinkt fuerchterlich hier drinnen. Du kannst die vielen Gerueche "
    "gar nicht unterscheiden.");

  AddSmell( ({"gerueche", "kraeuter"}),
    "Es riecht nach Kraeutern.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst das leise Rascheln der Kraeuter.");

  AddSound( ({"rascheln", "kraeuter"}),
    "Jedesmal wenn ein Luftzug da ist, rascheln die Kraeuter.");

//koennte man hier den spieler einen fahren lassen und daraufhin sagen: (?)
  AddSound( ({"luftzug"}),
    "Doch nicht so ein Luftzug ... beherrsch Dich etwas.");

  AddExit("sueden", BURGWEG("12x10y.lpc"));
  
}

