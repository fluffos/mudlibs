//(w) lamuerte 97 

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>

int count=0;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Sinneskraut");
  SetProp(P_LONG, 
   "Ein kleines buendel Sinneskraut. Es sieht nicht sehr appetietlich\n"+
   "aus. Man kann es kauen.\n");

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,2000);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Sinneskraut");
  AddId(({"kraut","sinn","sinneskraut"}));
  
 
  seteuid(getuid());
  AddCmd(({"kau","kaue"}),"kfunc");

}

 kfunc(str)
  { string *ob;
    notify_fail("Was denn?!");
    
    if (!str)
     {write("Kauen? was denn?\n");
      return 1;
     }
    
    if (str!="kraut" && str!="sinneskraut")
    {write("Was willst Du kauen?\n");
     return 1;
    }
    
    write("Du kaust das Kraut.\n");    
    say(this_player()->QueryProp(P_NAME)+" kaut ein Kraut.\n");
    ob=environment(this_player())->QueryProp(P_IDS);
   
   if(!present("dieb",environment(this_player())))
   {
    if(member_array("dieb",ob)!=-1)
     {
      clone_object("/d/ebene/lamuerte/burg/npc/dieb.lpc")->move(
       "/d/ebene/lamuerte/burg/mauer/10_00.lpc",M_NOCHECK);
      this_object()->remove();
      return 1;
     }
   }
    write("Doch es passiert nichts.\n");
    return 1;    
    
    }
