inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

create()
{ 
  if(!is_clone(this_object())) return;
  ::create(({"kau","kaue"}));
  SetProp(P_SHORT,"Ein Silberblatt");
  SetProp(P_LONG, 
   "Ein Blatt von einem Silberbaum, welches richtiggehend spiegelt.\n"+
   "Man kann es kauen. \n");
  SetProp(P_NOGET,0);
  SetProp(P_NODROP,1);
  SetProp(P_VALUE,5000);
  SetProp(P_WEIGHT,5);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Silberblatt");
  SetProp(P_MATERIAL, ([MAT_PLANT:88, MAT_SILVER:12]) ); 
  AddId ( ({"blatt","silberblatt"}) );
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({250,250}), F_SOAK:25,
    F_VERB: "kauen" ,
    F_MSG: "Du kaust eine Weile an dem Blatt herum, dann spuckst Du es wieder "
      "aus.\nDu fuehlst Dich, als haette Dich der Blitz getroffen.\n",
    F_MSG_ROOM: "beginnt zu kauen.\n" ]) );

}

