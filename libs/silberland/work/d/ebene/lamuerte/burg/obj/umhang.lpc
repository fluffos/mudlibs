inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"umhang"}));
  SetProp(P_SHORT,"Ein Umhang");
  SetProp(P_LONG,
        "Der Umhang eines Bettlers. Er ist aus braunem Stoff gefertigt und \n"+
        "riecht ekelhaft. Vor lauter Loecher ist der Stoff kaum noch zu sehen.\n");
  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  SetProp(P_AC, 1);
  SetProp(P_DAMAGED, 4);
  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 2500); 
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
}
