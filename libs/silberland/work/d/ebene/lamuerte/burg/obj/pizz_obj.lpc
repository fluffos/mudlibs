inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <food.h>

string faul;

create()
{ 
  if(!is_clone(this_object())) return;
  ::create( ({"iss", "esse"}) );
  SetProp(P_SHORT,"Eine lecker Pizza");
  SetProp(P_LONG, 
   "Ein original Tonno Steinofen Pizza.\n");  
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, FEMALE);
  
  SetProp(P_NAME,"Pizza");
  
  AddId (({"pizza","pissa"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,0}), F_SOAK:12 , 
     F_VERB: "essen" ,
     F_MSG:"Du isst eine leckere Pizza die Du von Tonno gekauft hast.\n"
          +"Irgendwie fuehlst Du Dich gut.\n",
     F_MSG_ROOM:"isst eine Pizza.\n" ]) );
}

int do_create_pizza(string str){
  faul=str;
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,0}), P_FOOD:12 ,
     F_VERB: "essen" ,
     F_MSG:"Du isst eine leckere Pizza die Du von Tonno gekauft hast.\n"
          +"Sie ist mit "+str+" belegt worden.\nHmmmmmm! Lecker!\n",
     F_MSG_ROOM:"isst eine Pizza mit "+str+" Belag.\n" ]) );
  SetProp(P_SHORT,"Eine lecker Pizza mit "+str); 
  SetProp(P_LONG, 
   "Ein original Tonno Steinofen Pizza.\nBelegt mit "+str+".\nHmm Lecker!\n");  
}

reset(){
  ::reset();
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,0}), P_FOOD:52 ,
     F_VERB: "essen" ,
     F_MSG:"Du isst eine verfaulte Pizza die Du von Tonno gekauft hast.\n"
          +"Sie ist mit "+faul+" belegt worden.\nDu kotzt.\n",
     F_MSG_ROOM:"isst eine verfaulte Pizza mit "+faul+" Belag.\n" ]) );                                                         
  SetProp(P_SHORT,"Eine faulige Pizza mit "+faul); 
 } 
