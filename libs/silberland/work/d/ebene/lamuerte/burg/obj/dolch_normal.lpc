inherit "std/weapon";

#include <properties.h>
#include <combat.h>

#define ABS(x) (x>0?x:-x)

int s=0;
  
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Mithrildolch");
  SetProp(P_LONG,
   "Der Dolch hat eine lange sehr scharfe Klinge. Der Griff ist mit einem\n"+
   "Stoffband umwickelt, um im Kampf nicht aus der Hand zu gleiten.\n");
  SetProp(P_NAME, "Mithrildolch");
  AddId( ({"dolch","mithril","mithril dolch" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_WC, 80);
  SetProp(P_WC_BONUS, (["dieb":200]) );
  SetProp(P_WEIGHT,  800);
  SetProp(P_VALUE, 2500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE,DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:100]) ); 
  SetProp(P_INFO,
   "Der Dolch sieht neuwertig aus.\n");
}

