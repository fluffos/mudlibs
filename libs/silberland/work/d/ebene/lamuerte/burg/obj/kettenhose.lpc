inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"hose", "kettenhose"}));
  SetProp(P_SHORT,"Eine Kettenhose");
  SetProp(P_LONG,
   "Lauter kleine Eisenglieder, welche zu einer Hose zusammengekettet worden\n"
   "sind. Ein Meister der Schmiedekunst muss dieses prachtvolle Werk\n"
   "geschaffen haben.\n");
  SetProp(P_NAME, "Kettenhose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 7);
  SetProp(P_VALUE,1500);
  SetProp(P_WEIGHT, 700);  
  SetProp(P_VALUE, 1000); 
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, ([ MAT_IRON:100 ]) );
}
