inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine gedornte zweischneidige Sarnakaxt des Blutrausches (schimmernd)");
  SetProp(P_LONG,
      "Eine prachtvoll gearbeitete Sarnakaxt. Sie ist sehr selten zu finden "+
      "und liegt wunderbar in der Hand. Sie besteht aus einem einem langen "+
      "hoelzernen Schaft, welcher mit gegerbten Leder umwickelt ist um besser "+
      "in der Hand zu Liegen. Sie besitzt ein zweischneidiges Axtblatt "+
      "aus welchem zusaetzlich in der Mitte ein scharfer Dorn nach oben "+
      "ragt.");
  AddDetail("schaft",
      "Der Schaft besteht aus Eichenholz und ist mit Leder geriemt. Er ist "+
      "gut verarbeitet und sieht stabil aus.");
  AddDetail("leder",
      "Das Leder sieht sehr gut aus. Es ist wohl von Meisterhand gegerbt "+
      "worden.");
  AddDetail(({"blatt","axtblatt"}),
      "Das Axtblatt bestet aus gehaertetem Eisen, die Klinge des Blattes "+
      "besteht aus lauter scharfen Zaehnen und ist mit eingetrocknetem "+
      "Blut ueberzogen.");
  AddDetail("dorn",
      "Der Dorn sitzt zwischen den beiden Teilen des doppelten Axtblattes "+
      "genau in der Mitte. Er kann genutzt werden um gegnern mit einem "+
      "schnellen Stoss in die Augen "+
      "zu stechen. Wenn sich die Gelegenheit im Kampf dazu bietet wird "+
      "Dich Deine Sarnakaxt leiten.");

  SetProp(P_NAME, "Sarnakaxt des Blutrausches");
  SetProp(P_NAME_ADJ, ({"bihaendig","gedornt","zweischneidig"}) );
  AddId( ({"axt","sarnakaxt" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WC, 290);
  SetProp(P_WC_FIX, 10);
  SetProp(P_MAGIC, 1);
  SetProp(P_QUALITY_DECAY, 70);
  SetProp(P_MATERIAL, ([ MAT_IRON : 20, MAT_OAK : 80 ]) );
  SetProp(P_WEIGHT, 2800);  
  SetProp(P_VALUE, 5500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE,DT_SLASH);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD_LEVEL: 10,
                                  A_STR: 28, 
                                  A_DEX: 25, 
                                  A_CON: 28,
                                  ]));
  SetProp(P_INFO,break_string(
        "Du kannst stolz auf Deine Sarnakaxt sein, sie ist bereit alles fuer "+
        "Dich niederzumaehen was Du findest.",78));
  SetProp(P_HIT_FUNC, this_object());
  seteuid(getuid(this_object()));
}

int HitFunc(object enemy)
{
  int bonus;
  object wer;
  
  wer = QueryProp(P_WIELDED);
  bonus=0;
  if (member(({"Frosch", "Froglok"}), enemy->QueryProp(P_RACE)) != -1 || 
      enemy->QueryProp(P_FROG) || enemy->id("frosch"))
  {
    bonus += random(100);
    if (!random(10))
      tell_object(wer, "Deine Axt hasst Froesche!\n");
  }
  if (random(1000) >= 985)
  {
    tell_object(wer,
        "  Du stoesst den Dorn Deiner Axt in "+enemy->name(WESSEN)+" Augen.\n");
    tell_room(environment(wer), wer->Name(WER)+
        " stoesst den Dorn seiner Axt in "+enemy->name(WESSEN)+" Augen.\n",
        ({wer,enemy}) );
    tell_object(enemy,
        "  "+wer->Name(WER)+" stoesst Dir den Dorn "+
        this_player()->QueryPossPronoun(FEMALE, WEM)+ " Axt in die Augen.\n");
    tell_room(environment(wer), capitalize(enemy->name(WER))+
        " schreit laut!\n", ({enemy}));
    bonus += 20 + random(30);
    if(!random(3) && !enemy->QueryProp(P_BLIND))
    {
      enemy->SetProp(P_BLIND, 
          ([BLIND_TIME:3, 
            BLIND_MSG:wer->Name(WESSEN)+" Sarnakaxt hat Dich "
                      "getroffen. Du bist BLIND!\n", 
            BLIND_END_MSG:"Du kannst wieder sehen!\n"]) );
      tell_object(wer,
          "  Der Stoss mit dem Dorn Deiner Axt war ein Volltreffer!!!\n"+
          capitalize(enemy->name(WER))+" erblindet fuer einen Moment.\n");
      tell_room(environment(wer), enemy->name(WER)+
          " fasst sich an die Augen!",({wer, enemy}));
      bonus += 50 + random(50);
    } 
    if(!random(10) && !enemy->QueryProp(P_DISABLE_ATTACK))
    {
      tell_object(wer,
          "  Du landest einen ***KRITISCHEN*** Treffer!\n"+
          capitalize(enemy->name(WER))+" ist gelaehmt.\n");
      tell_object(enemy,
          "  Ein ***KRITSCHER*** Treffer laehmt Dich!\n");
      tell_room(environment(wer), capitalize(enemy->name(WER))+
          " ist kurz gelaehmt!",({wer, enemy}));
      enemy->SetProp(P_DISABLE_ATTACK,1+random(3));
      bonus += 100 + random(100);
    }
  }
  return (bonus+random(20));
}
