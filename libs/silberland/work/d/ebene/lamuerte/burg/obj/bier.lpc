inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

create()
{ 
  if(!is_clone(this_object())) return;
  ::create( ({"trink", "trinke"}) );
  SetProp(P_SHORT,"Eine Bierflasche");
  SetProp(P_LONG, 
   "Eine halbvolle Flasche Kyranda Urtyp. Sie sieht irgendwie schon ziemlich "
   +"verbraucht aus.\n");
  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Flasche");
  SetProp(P_MATERIAL, ({MAT_GLASS, MAT_ALCOHOL}) );
  
  AddId (({"flasche","bier","bierflasche", "\nbaking_zutat"}));
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,20}), F_DRINK:2, F_ALCOHOL:2,
     F_VERB: "trinken" ,
     F_MSG:"Du trinkst das lauwarme, abgestandene Bier. \n"
          +"Irgendwie fuehlst Du Dich zum Kotzen.\n",
     F_MSG_ROOM:"trinkt ein lauwarmes Bier.\n" ]) );
}


