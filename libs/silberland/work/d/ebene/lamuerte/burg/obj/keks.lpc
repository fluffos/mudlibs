inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein magisches Keks");
  SetProp(P_LONG, 
   "Ein kleines Keks, welches die Kraeuterfrau von Kyranda gebacken hat. \n"
   +"Es sieht aus wie ein Linzerauge.\n");

  SetProp(P_NOGET,0);
  SetProp(P_NODROP,1);
  SetProp(P_VALUE,900);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Keks");
  SetProp(P_NAME_ADJ, "magisch" );
  
  AddId ( ({"keks","magiekeks" }) );
  AddAdjective( ({"magisches"}) );
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,20}), F_SOAK:6,
    F_MSG: "Du isst ein Keks und fuehlst Dich magisch aufgeladen.\n", 
    F_MSG_ROOM: "isst ein Keks.\n" ]) );

}

