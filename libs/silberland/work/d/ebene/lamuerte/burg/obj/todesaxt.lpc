inherit "std/weapon";

#include <properties.h>
#include <combat.h>

#define ABS(x) (x>0?x:-x)
  
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Todesaxt");
  SetProp(P_LONG,
        "Eine grosse, sehr schwere Axt. Normalerweise kaempfen nur Trolle\n"+
        "mit solchen Waffen.\n");
  SetProp(P_NAME, "Todesaxt");
  AddId( ({"axt","todesaxt","todes" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WC, 280);
  SetProp(P_WC_FIX, 5);
  SetProp(P_QUALITY_DECAY, 60);
  SetProp(P_WEIGHT, 4800);  
  SetProp(P_VALUE, 2500); 
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_SIZE, 200);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 20]));
  SetProp(P_INFO,break_string(
   "Alle grossen Trolle, Oger und Riesen fuerchten diese Axt. Die Zwerge "+
   "hingegen, machen sich darueber laecherlich.",78));
  SetProp(P_HIT_FUNC, this_object());
  seteuid(getuid(this_object()));
}

int HitFunc(object enemy)
{
    int esize;
    esize=enemy->QueryProp(P_SIZE);
    if (member(({"troll", "oger", "riese"}),
        lower_case(enemy->QueryProp(P_RACE)))!=-1)
    {
      if (random(100)>=95)
      {
       write(
       "  Du zerschmetterst "+enemy->name(WEM)+" fast den Schaedel.\n");
       return (200+random(260));
      }
      return  10+random(50);
    }
    if (esize > QueryProp(P_WIELDED)->QueryProp(P_SIZE))
      return random(10);
    if (esize < (QueryProp(P_WIELDED)->QueryProp(P_SIZE)/3) || 
        enemy->QueryProp(P_RACE)=="Zwerg")
      return  -150+random(esize);
    return 0;   
}

