inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"schiene","schienen","trollschienen","armschienen","armschiene",
           "trollschiene" }));
  SetProp(P_SHORT,"Trollschienen");
  SetProp(P_LONG,
  "\tFuerchterlich schwere Armschienen. Man muss schon einige Erfahrung\n"+
  "haben um mit diesen Schienen etwas anfangen zu koennen. Diese hier koennen\n"+
  "aber @@schaden@@\n");
  SetProp(P_NAME, "Trollschiene");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 5+random(5)); //max 9
  SetProp(P_VALUE,2200);
  SetProp(P_WEIGHT, 500);  
  SetProp(P_VALUE, 1500); 
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_MATERIAL, ([MAT_IRON:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR: 23,
                                 P_LEVEL: 25]) );
  SetProp(P_INFO,"Das sind wohl die besten Armschienen weit und breit.\n");
}

schaden()
 {int good;
  good=this_object()->QueryProp(P_AC);
  if (good<=4) return ("sehr wenig Schaden verhindern.");
  if (good==5) return("wenig Schaden verhindern.");
  if (good==6) return("so manchen Schaden verhindern.");
  if (good==7) return("schon einigen Schaden verhindern.");
  if (good==8) return("ganz schoen viel Schaden verhindern.");
  if (good==9) return("jede Maenge Schaden verhindern.");
  if (good==10) return("extrem viel Schaden verhindern.");
  return("BUG! Mail to Lamuerte!!! Ask ArchWIZARD for HELP!");
 }
