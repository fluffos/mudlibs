inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"amulett","smaragtamulett" }));
  SetProp(P_SHORT,"Ein Smaragtamulett");
  SetProp(P_LONG,
        "Ein Amulett aus reinstem Smaragt. Es hat einen unschaetzbaren\n"+
        "wert.\n");
  SetProp(P_NAME, "Smaragtamulett");
  SetProp(P_NODROP,1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_AC, 5);
  SetProp(P_VALUE,1000);
  SetProp(P_WEIGHT, 200);                                                        SetProp(P_VALUE, 2500); 
  SetProp(P_NOBUY,1);
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_MATERIAL, ({MAT_JEWEL}));
  AddCmd(({"reibe","poliere"}),"reib");
}
  


reib(str)
{
if(str=="amulett"||str=="smaragtamulett"||) 
 {
  write (
   "Du isst das Chromkraut.\n");

   say (this_player()->QueryProp(P_NAME)+"isst ein Chromkraut.\n");
     
     remove();
   return 1;
 }
else        
 {write("Was willst Du essen?\n");
        return 1;
 }

}


