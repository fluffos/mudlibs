inherit "std/weapon";

#include <properties.h>
#include <combat.h>

  
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Sarnakaxt");
  SetProp(P_LONG,
        "Eine prachtvoll gearbeitete Sarnakaxt. Sie ist sehr selten zu finden "+
        "und liegt wunderbar in der Hand.");
  SetProp(P_NAME, "Sarnakaxt");
  AddId( ({"axt","sarnakaxt" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WC, 290);
  SetProp(P_WC_FIX, 10);
  SetProp(P_QUALITY_DECAY, 70);
  SetProp(P_WEIGHT, 2800);  
  SetProp(P_VALUE, 5500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE,DT_SLASH);
  SetProp(P_NR_HANDS, 2);
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 18]));
  SetProp(P_INFO,break_string(
   "Du kannst stolz auf Deine Sarnakaxt sein, sie ist bereit alles fuer "+
   "Dich niederzumaehen was Du findest.",78));
  SetProp(P_HIT_FUNC, this_object());
  seteuid(getuid(this_object()));
}

int HitFunc(object enemy)
{
  if (member(({"Frosch", "Froglok"}), enemy->QueryProp(P_RACE)) != -1 || 
      enemy->QueryProp(P_FROG) || enemy->id("frosch"))
  {
    if (!random(10))
      tell_object(this_player(), "Deine Axt hasst Froesche!\n");
    return random(50);
  }
  if (  enemy->QueryProp(P_ALIGN)<-300 )
  {
    if (random(100)>=95)
    {
      tell_object(this_player(),
          "  Du *maehst* "+enemy->name(WEN)+" nieder.\n");
      return (260+random(250));
    }
    return  random(30);
  }
  if( enemy->QueryProp(P_ALIGN)>300)
  {
    tell_object(this_player(),
        "  Du verfehlst "+enemy->name(WEN)+" um Laengen.\n");
    return  -50-random(100);
  }
  return 0;   
}

