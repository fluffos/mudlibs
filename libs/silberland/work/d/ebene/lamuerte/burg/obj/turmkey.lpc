inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

string keycol;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein @@color@@ Schluessel");
  SetProp(P_LONG, 
   "Ein kleiner @@color@@ Schluessel aus Kyranda.");

  SetProp(P_NOGET,0);
  SetProp(P_NODROP,0);
  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
  
  AddId("schluessel");
 
  seteuid(getuid());
  

}

string color()
{return(keycol);
}

void setcol(string farbe)
{keycol=farbe;
 AddId("\nburg"+farbe);
 AddAdjective(farbe);
 SetProp(P_NAME_ADJ,farbe[0..<3]);
}
