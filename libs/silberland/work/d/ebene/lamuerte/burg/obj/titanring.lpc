inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"ring","titanring" }));
  SetProp(P_SHORT,"Ein Titanring");
  SetProp(P_LONG,
        "Ein kleiner Titanring, der seinen Traeger vor Feinden schuetzt.\n"+
        "Er gehoerte einst einem Waechter von Kyranda.\n");
  SetProp(P_NAME, "Titanring");
  SetProp(P_GENDER, MALE);
  SetProp(P_AC, 3);
  SetProp(P_VALUE,1000);
  SetProp(P_WEIGHT, 200);  
  SetProp(P_VALUE, 500); 
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_NOBUY,1);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:100]));
}
