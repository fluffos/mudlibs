inherit "std/thing"; 

#include <properties.h>
#include "../files.h"
#include <rooms.h>

create()

{ 
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein brauner Schluessel");
  SetProp(P_LONG, 
   "Ein kleiner brauner Schluessel aus Kyranda. Vielleicht sperrt er das Burgtor?");

  SetProp(P_VALUE,50);
  SetProp(P_WEIGHT,30);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
  
  AddId( ({"schluessel","brauner"}));
 
}

string QueryDoorKey()
{
// return BURGWEG("12x11y.lpc")+":"+BURGMAUER("12x12y.lpc");
//  return BURGMAUER("12x12y")+":"+BURGWEG("test"); 
   return BURGWEG("test")+":"+BURGMAUER("12x12y");
  }
  
  
