#pragma strict_types


inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>

int running;
object vic;

int fragefunc ();

void 
create ()
{
  if (!is_clone (this_object ()))
    return;
  thing::create ();
  SetProp (P_SHORT, "");
  SetProp (P_LONG, "");

  SetProp (P_NOGET, 0);
  SetProp (P_NODROP, 0);
  SetProp (P_GENDER, MALE);
  AddId ("speedy");

  seteuid (getuid ());
  running = 0;
  AddCmd ("speedage", "speedy");
}


void do_age()
{
   int i;
   if ( !running )
      return;
   write( "Next loop...\n" );
   for( i=0; i < 1000; i++) 
      vic->heart_beat();

   call_out( "do_age", 1 );
}

int
speedy(string arg)
{
   vic = this_player();
   if (arg == "on") {
      write( "Los gehts...\n" );
      running = 1;
      call_out( "do_age", 0 );
      return( 1 );
   } else {
      write( "Und aus....\n" );
      while( remove_call_out( "do_age" ) != -1 );
      running = 0;
      return( 1 );
   }
}
