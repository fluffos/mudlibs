inherit "std/food";

#include <properties.h>
#include <food.h>

void create()
{
if (!is_clone(this_object())) return;
::create();

SetProp(P_SHORT, "Eine Fischbuechse");
SetProp(P_LONG,
"Eine halb verrostete Fischbuechse.\n");
SetProp(P_NAME, "Fischbuechse");
AddId(({"\nfischbuechse","fisch","dose","buechse","fischdose","fischbuechse"}));
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 250);
SetProp(P_GENDER,FEMALE);
SetProp(P_FOOD_INFO, ([F_HEAL : ({5, 0}), F_SOAK : 5]));
}

void BeimEssen()
{
write("Du oeffnest die Buechse und isst den Fisch.\nIhh.. schmeckt die komisch.\n");
say(this_player()->name()+" faengt an zu kauen.\n");
}
