inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include <new_skills.h>


int startxp=0;
int currxp;
int dynxp;
int tempxp;
int active=0;
int timer=0;
int showamount=500;
object owner;

string versnumb="1.0";

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein XPC");
  SetProp(P_LONG, 
   "Ein kleiner XPC. Er kann Dir sagen wieviele Erfahrungspunkte Du so machst. "+
   "Einschalten kann man Ihn mit <xpcstart>, ausschalten mit <xpcstop>, einen "+
   "Report kann man mit <xpcreport> erzwingen. Einen Reset gibts mit <xpcreset>.");
   // und mit <xpcwert 'grenzwert'> kann "+
   // "eingestellt werden bei wieviel EP zuwachs eie Benachrichtigung kommt.");

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,20000);
  SetProp(P_NEVERDROP,1);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"XPC");
  AddId(({"xpc"}));
 
  AddCmd("xpcstart","do_start"); 
  AddCmd("xpcstop","do_stop"); 
  AddCmd("xpcreport","do_report"); 
  AddCmd("xpcreset","do_reset"); 
  AddCmd("xpcwert","do_set"); 
 
  seteuid(getuid());
}





int do_start()
{
 if (active==1)
 {
   write("XP Zaehler bereits eingeschaltet.\n");
   return 1;
 }

 notify_fail("XP Zaehler eingeschaltet...\n");
 startxp=this_player()->QueryProp(P_XP);
 currxp=this_player()->QueryProp(P_XP);
 tempxp=this_player()->QueryProp(P_XP);
 dynxp=currxp-startxp;
 active=1;
 timer=time();
 SetProp(P_NODROP,"Der XPC ist gestartet, Du kannst ihn so nicht ablegen.\n");
 set_heart_beat(1);
 owner=this_player();
 return 0;
}

int do_stop()
{
 if (active==0)
 {
   write("XP Zaehler bereits ausgeschaltet.\n");
   return 1;
 }
 set_heart_beat(0);
 SetProp(P_NODROP,0);
 notify_fail("XP Zaehler ausgeschaltet...\n");
 active=0;
 return 0;
}

int do_report()
{
  if(active==0)
  {
    write("XP Zaehler nicht eingeschaltet.\n");
    return 1;
  }
  currxp=owner->QueryProp(P_XP);
  tell_object(owner,"[summe xp: "+(currxp-startxp)+"]");
  tell_object(owner," [in: "+((time()-timer)/60)+" min]");
  tell_object(owner," [schnitt: "+((time()-timer)?((currxp-startxp)/(time()-timer))*3660:(currxp-startxp))+"/h]");
  tell_object(owner," [last kill: "+((currxp-startxp)-dynxp)+"]\n");
  return 1; 
}

void res_xp()
{
  dynxp=((owner->QueryProp(P_XP)-startxp));
  return ;
}

void heart_beat() 
{if(!owner->InFight()) call_out("res_xp",0);
  if( (tempxp+showamount) < (owner->QueryProp(P_XP)) )
  { 
    call_out("do_report",0);
    tempxp=owner->QueryProp(P_XP);
  }
}


do_set(string xx)
{

  if(!active){
    tell_object(this_player(),"Der XPC ist nicht eingeschaltet.\n");
    return 1;
  }

  if(!xx){
    tell_object(owner,"Syntx: xpcwert <grenzwert>\n");
    return 1;
  }
 

  if ( to_int(xx) < 500 || to_int(xx) > 10000)
  {
    tell_object(owner,"Falscher Wert. (breeich: 500-10000)\n");
    return 1;
  }

  showamount=to_int(xx);
    tell_object(owner,"Grenzwert wurde auf "+showamount+" eingestellt.\n");
  return 1;
}

int do_reset()
{
 if (active!=1)
 {
   write("XP Zaehler ist doch nicht eingeschaltet.\n");
   return 1;
 }

  do_stop();
  write("XP Zaehler wird resettet.\n");
  call_out("do_start",3);
  return 1;
}
