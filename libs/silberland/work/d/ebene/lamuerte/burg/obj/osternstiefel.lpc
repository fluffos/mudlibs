inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"stiefel","osternstiefel" }));
  SetProp(P_SHORT,"Die Osternstiefel");
  SetProp(P_LONG,
        "Diese Stiefel gehoerten einst Ostern dem Schrecklichen. Sie sind aus leichtem,\n"+
        "aber sehr stabilem Metall gefertigt.\n");
  SetProp(P_NAME, "Osternstiefel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_AC, random(8)+2);
  SetProp(P_VALUE,2800);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1500); 
  SetProp(P_MATERIAL, ([MAT_METAL:100]) );
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
}
