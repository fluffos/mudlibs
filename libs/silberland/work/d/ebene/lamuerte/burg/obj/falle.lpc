/* FILE: falle.c
   INFO: Eine Untersuchescript Falle
   DATE: 11.4.97
   (w) LaMuerte
*/

inherit "std/thing";
#include "../files.h"
#include <language.h>
#include <properties.h>
#include <moving.h>

void create()
{ object ob;
  if (!is_clone (this_object ()))
    return;
  if (ob=present("falle\n",this_player())) ob->remove();
  thing::create ();
  SetProp (P_SHORT, 0);
  SetProp (P_LONG, 0);
  SetProp (P_IDS,0);
  SetProp(P_NAME, "Scriptfalle");

  AddId ("falle\n");

  seteuid (getuid ());
  call_out("die_now",20);
}


void die_now()
{
  object ob;
  ob=environment();
  if (!ob || !living(ob)) 
  {
    remove();
    return;
  }
  write("Die Scriptfalle schlegt NUN zu. *GRINS* \n");
  write_file( "/d/ebene/lamuerte/burg/log/SCRIPTFALLE", 
      sprintf( "TPN=%s wurde vom KUMAH niedergemetzelt\n",
        this_player()->QueryProp(P_NAME) ) ) ;
  // ob->die();
  ob->SetProp(P_GHOST, 1);
  ob->move("/room/death/death_room", M_NOCHECK);
  remove();
}
