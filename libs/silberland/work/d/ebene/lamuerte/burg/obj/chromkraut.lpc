inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

create()
{ 
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Chromkraut");
  SetProp(P_LONG, 
   "Ein kleines Bueschel Chromkraut. Laut Geruechten soll es, wenn man \n"
   +"es verspeist, ungeahnte Kraefte hervorrufen koennen, wenn man weiss wie.\n");

  SetProp(P_NOGET,0);
  SetProp(P_NODROP,1);
  SetProp(P_VALUE,3000);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Chromkraut");
  
  AddId ( ({"kraut","chromkraut"}) );
 
  SetProp(P_FOOD_INFO, ([F_HEAL: 0, F_SOAK: 1,
    F_MSG: "Du isst das Chromkraut.\n",
    F_MSG_ROOM: "isst ein Chromkraut.\n"]) ); 

}

