//Ein Amulett (lam)
//Hehe, wie aussagekraeftig. *grins*

inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

 int DefendFunc(string *dtyp, mixed spell, object enemy);
 

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"amulett","smaragdamulett" }));
  SetProp(P_SHORT,"Ein Smaragdamulett");
  SetProp(P_LONG,
   "Das Amulett wurde aus reinstem Gold gefertigt. An einer langen, goldenen "+
   "Kette haengt eine runde Scheibe in der ein Smaragd eingearbeitet ist. "+
   "Eine magisch blau schimmernde Aura umgibt das wertvolle Amulett.");
      
  SetProp(P_NAME, "Smaragdamulett");
  SetProp(P_NODROP,1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_AC, 5);
  SetProp(P_WEIGHT, 200);                       
  SetProp(P_VALUE, 2500); 
  SetProp(P_NOBUY,1);
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_MATERIAL, ([MAT_EMERALD:20, MAT_GOLD:80]));
  SetProp(P_INFO,
   "Dieses aus Gold gearbeitete Amulett hat einen unschaetzbaren Wert. Du \n"+
   "bist Dir nicht sicher, doch Du bildest Dir zumindest ein, dass Dir diese \n"+
   "blaue Aura Glueck bringt.\n"); 

 AddDetail(({"amulett","smaragdamulett"}),
  "Das Amulett besteht aus ueberwigend aus Gold. Ein grosser Smaragd haengt \n"+
  "an einer Kette herunter.\n");
 
 AddDetail("kette",
  "Die Kette ist aus purem Gold gefertigt worden. \n");
 
 AddDetail("gold",
  "Das Amulett ist ziemlich schwer, wahrscheinlich ist das eine Folge des reinen \n"+
  "Goldes aus dem es gefertigt wurde.\n");
 
 AddDetail("smaragd",
  "Er ist dunkelgruen, aber man kann noch durch ihn hindurch blickern. Er sitzt \n"+
  "auf einer goldenen Scheibe und wird von einer blau schimmerndern Aura umgeben. \n");
 
 AddDetail("scheibe",
  "Die Scheibe dient als Halterung fuer einen Smaragd. Auf ihr sind einige alte \n"+
  "Runen eingezeichnet, welche Dir ueberhaupt nichts sagen.\n");

 AddDetail("runen",
  "Du kannst einfach nichts mit diesen Schriftzeichen anfangen. Vielleicht kann\n"+
  "Dir ja ein Magier helfen?!\n");

AddDetail("schriftzeichen",
 "So sehr Du Dich auch bemuehst, Du kannst nichts mit ihnen anfangen.\n"); 

 AddDetail("magier",
  "Hups, lieber doch nicht, das waere ja Spielerhilfe.");
 
 AddDetail("glueck",
  "Ja, eindeutig. Das Ding bringt Dir Glueck.... oder doch nicht?!\n");
  
 AddDetail("aura",
  "Eine Art von magischem Feld umgibt diesen Smaragd. Du denkst, dass von \n"+
  "ihr aus Dein Glueck beeinflusst wird.\n");
 
 AddDetail("art",
  "Welche Art das ist, weisst Du selbst nicht genau.\n");
  
 AddDetail("feld",
  "Das Feld schimmert blau. Es umhuellt den Smaragd.\n");
  
 AddDetail("halterung",
  "Meinst Du jetzt die Scheibe oder wie?!\n");
}
 
  
  
