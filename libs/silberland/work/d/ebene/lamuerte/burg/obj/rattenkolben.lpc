inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

int amount;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  AddId( ({"stock","holzstock"}) );
  AddId("\ncoolholzstock");
  SetProp(P_SHORT, "Ein Holzstock");
  SetProp(P_LONG,
    "Der Holzstock sieht eigentlich nicht sehr aussergewoehnlich aus, nur "
    "eines sticht Dir sofort ins Auge: er hat Rattenzaehne an seinem vorderen "
    "Ende eingearbeitet.");
  SetProp(P_NAME, "Holzstock");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 40);
  SetProp(P_WC_FIXFACTOR, 0.2);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 0);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:4]) );  

  amount=1;
}

string query_zaehne()
{
  return to_string(amount);
}

int add_zaehne()
{
 amount++;

 if(amount>15) {
    amount=15;
    write("Du versuchst noch einen Zahn dazuzustecken, doch er zerbricht dabei.\n");
    return 1;
  }
 
 SetProp(P_VALUE, QueryProp(P_VALUE)+200);
 write("Du steckst einen Zahn in den Holzstock. Er sieht etwas gefaehrlicher aus.\n");
 SetProp(P_WC,(61+(5*amount)));
 
 if(amount==15)
 {
   write("Das Werk ist nun vollbracht.\n"
     "Du hast aus einem Holzstock einen Streitkolben des Rattenzahns gemacht!\n");
   SetProp(P_SHORT, "Ein Streitkolben des Rattenzahns");
   SetProp(P_NAME, "Streitkolben");
   SetProp(P_UNWIELD_TEXT, ({ "Du steckst einen Streitkolben zurueck.\n", " steckt einen Streitkolben zurueck.\n" }) );
   SetProp(P_WIELD_TEXT, ({ "Du zueckst einen Streitkolben.\n",
                                " zueckt einen Streitkolben.\n" }) );
   SetProp(P_WC_FIX, 30);
   SetProp(P_MATERIAL, ([MAT_BONE:40, MAT_BEECH:60]) );
   init();
   RemoveId(({"stock","holzstock","\ncoolholzstock"}));
   AddId(({"rattenkolben","kolben","streitkolben"}));
 }
}
 
long() 
{
  int n;
  n = query_zaehne();

  if(amount >= 15)
  {
    return(break_string(
        "Dies ist ein Streitkolben welcher viele scharfe Rattenzaehne an "
        "seinem vorderen Ende eingearbeitet hat. Er ist scharf und zerfetzt "
        "seine Gegner. Jemand hat ihn aus einem normalen Holzstock und einer "
        "Unzahl von Rattenzaehnen selbst gebastelt."));
  }
  else
  {
    return(break_string(
       "Der Holzstock sieht eigentlich nicht sehr aussergewoehnlich aus, nur "
       "eins sticht Dir sofort ins Auge er hat Rattenzaehne an seinem vorderen "
       "Ende eingearbeitet. Und zwar " +
        n + " Stueck.") );
  //(n == 1 ? "ein Exemplar." : n + " Exemplare."
  }
}
