inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

object who;
int timestamp;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"umhang","sarnakumhang"}));
  SetProp (P_SHORT, "Ein Sarnakumhang");
  SetProp (P_LONG, "Dies ist ein langer, schwerer Sarnakumhang. Er "+
        "besteht aus sehr gut gegerbtem Leder welches mit kraeftigen "+
        "Bindfaeden vernaeht ist. Am oberen Ende des Umhangs findest Du "+
        "zwei seidene Baender, mit denen der Umhang an Deinem Koerper Halt "+
        "findet.");
  SetProp (P_NAME, "Umhang");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1200);
  SetProp (P_VALUE, 2300);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_QUALITY_DECAY, 30);
  SetProp (P_AC, 3+random(7));
  SetProp (P_INFO, "Dieser Umhang kann in Extremsituationen Dein Leben retten.");
  SetProp (P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_BAD:300, P_LEVEL:15]) );
  
  SetProp(P_DEFEND_FUNC, this_object());
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  who=QueryProp(P_WORN);
    
  if (who->QueryProp(P_HP)<30 && !timestamp)  
  {
    tell_object (who, 
        "Energie fliesst von Deinem Sarnakumhang in Deinen Koerper.\n"+
        "Dein Sarnakumhang wird schwaecher.\n");
    who->AddHp(350);
    who->AddSp(random(350));
    this_object()->SetProp(P_AC,QueryProp(P_AC)-1);

    if(this_object()->QueryProp(P_AC)<1){
    tell_object (who, 
        "Dein Sarnakumhang zerbroeselt.\n");
    this_object()->remove( 0 );
    }
   timestamp=1;
  }
    return 0;
}

reset(){
::reset();
timestamp=0;
}
