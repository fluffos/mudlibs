inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein brauner Schluessel");
  SetProp(P_LONG, 
   "Ein kleiner brauner Schluessel aus Kyranda.");

  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
  
  AddId( ({"\ntorkey","schluessel","brauner"}));
 
  seteuid(getuid());
  

}

void init()
{
  ::init();
  if (this_player() && deep_present("\ntorkey 5", this_player()))
    call_out("remove", 0);
}
    
