inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

#define COST 2
#define TIME_BETWEEN 6 

int last;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"maske","sarnakmaske" }));
  SetProp(P_SHORT,"Eine Sarnakmaske");
  SetProp(P_LONG,
        "Eie Sarnakmaske, die ihrem Traeger ein boesartiges Aussehen gibt. "+
        "Sie ist aus einem sehr gut gegerbten Leder gemacht worden.\n");
  SetProp(P_NAME, "Sarnakmaske");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 8);
  SetProp(P_VALUE,800);
  SetProp(P_WEIGHT, 300);   
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_WEAR_RESTRICTIONS, ([SR_GOOD:-300, P_LEVEL:20]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  object wer;
  wer=QueryProp(P_WORN);
  if(wer->QueryProp(P_ALIGN) > 0)  // Bei Guten wirkt das nicht
    return 0;
  if( random(100) > 60 && // nicht jede runde
      objectp(enemy) &&  // ist gegner ueberhaupt da?
      living(enemy) && // nur bei lebewesen
      time() - last >= TIME_BETWEEN &&   // nur alle paar heart-beats
      !enemy->QueryProp(P_DISABLE_ATTACK) && // Gegner nicht schon disabled?
      wer->QueryProp(P_SP) > COST &&  // Genug Magiepunkte
      enemy->QueryProp(P_NOMAGIC) < random(100) && // Nomagic des Gegners beruecksichtigen
      !enemy->QueryProp(P_BLIND) && // Blinde sehen die Maske nicht
      enemy->QueryAttribute(A_STR) < wer->QueryAttribute(A_STR) ) // Nur bei schwaecheren Gegnern
  {
    tell_room( environment(wer), break_string(enemy->Name(WER)+" sieht "+
          wer->Name(WER,1)+ " mit "+ wer->QueryPossPronoun(FEMALE,WEM,SINGULAR)+
          " Sarnakmaske und erstarrt vor Schreck."), ({enemy,wer}) );
    tell_object(enemy, break_string("Du siehst "+ wer->name(WEN)+ 
          " mit "+ wer->QueryPossPronoun(FEMALE,WEM,SINGULAR)+
          " Sarnakmaske und wirst starr vor Schreck!"));
    tell_object(wer, break_string(enemy->Name(WER)+" sieht Dich mit Deiner"+ 
          " Sarnakmaske und erstarrt vor Schreck."));
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(1+random(2+random(3))) );
    wer->AddSp(-COST);
    last=time();
    return 0;
  }
}


string extra_look()
{
  return( capitalize(environment(this_object())->QueryPronoun(WER))+" traegt "+
    environment(this_object())->QueryPossPronoun(FEMALE, WEN, SINGULAR)+ " Sarnakmaske "
    "und sieht furchteinfloessend damit aus.\n");
}
