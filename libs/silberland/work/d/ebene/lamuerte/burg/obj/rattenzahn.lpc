//inherit "std/thing";
inherit "std/unit";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId( ({ "zahn", "rattenzahn" }) );
  SetProp(P_SHORT, "Ein Rattenzahn");
  SetProp(P_LONG,
      "Der Rattenzahn ist etwa 1 mal 3 Zentimeter gross und besitzt eine "
      "scharfe, spitze Form. Was Du wohl damit machen kannst...? Als Waffe "
      "scheint er Dir relativ ungeeignet, doch vielleicht kannst Du ihn "
      "auf einen Holzstock stecken?");
  SetProp(P_NAME, ({"Rattenzahn", "Rattenzaehne"}));
  SetProp(P_GENDER, MALE);


  AddSingularId( ({"rattenzahn", "zahn"}) );
  AddPluralId( ({"rattenzaehne", "zaehne"}) );
  SetCoinsPerUnits(30+random(11),1); // zuvor 300
  SetGramsPerUnits(40+random(11),1); // zuvor 200

  SetProp(P_MATERIAL, MAT_HORN);

  AddCmd( ({"steck","stecke","befestige","befestig"}), "cmd_stecken" );
}


int cmd_stecken(string str)
{
  string was, wie, wohin;
  object holzi;
  int n;

  notify_fail("Was willst Du wo befestigen?\n");

  if (!str)
    return 0;

  if (sscanf(str,"%s %s %s",was,wie,wohin) != 3)
    return 0;

  holzi = present(wohin, this_player());

  if (id(was) &&
     (wie == "auf" || wie == "an" || wie == "am" || wie == "ans") && holzi)
  {
    if (holzi->id("\ncoolholzstock"))   // spieler hat schon rattenkolben
    {
      holzi->add_zaehne();
      n = holzi->query_zaehne();

      if (n == 1)
        write("Du hast nun einen Zahn im Holzstock stecken.\n");
      else
        write("Du hast nun " + n + " Zaehne im Holzstock stecken.\n");

      //remove(1);
      AddAmount(-1);
      return 1;
    }
    else if (holzi->id("holzstock"))    // spieler hat nur normalen stock
    {
      write(
          "Du steckst einen Rattenzahn in das vordere Ende eines Holzstocks.\n"
          "Baust Du Dir etwa einen Streitkolben?\n");
      clone_object("/d/ebene/lamuerte/burg/obj/rattenkolben")->move(
          this_player(), M_NOCHECK);
      holzi->remove(1);
      //remove(1);
      AddAmount(-1);
      return 1;
    }
    else if (holzi->id("zahn"))         // zahn auf zahn? gehts noch? ;)
    {
      write(break_string(
            "Den Zahn auf den Zahn stecken? Hae? Nein nein, das klappt so "
            "nicht, Du brauchst schon einen Holzstock, auf den Du den Zahn "
            "stecken kannst."));
      return 1;
    }
    else                                // spieler hat irgendwas andres
    {
      write(break_string(
            "Mit " + holzi->name(WEM,1) + " klappt das nicht, Du brauchst "
            "schon einen Holzstock, auf den Du den Zahn stecken kannst."));
      return 1;
    }
  }
  return 0;
}
