inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create(({"trink","trinke"}));
  SetProp(P_SHORT,"Ein gruenes Flaeschchen");
  SetProp(P_LONG, 
   "Ein kleines Flaeschchen, welches mit einer gruenen Fluessigkeit \n"
   +"gefuellt ist. Am Flaschenhals haengt ein kleiner Zettel auf dem \n"
   +"'Abgefuellt in Kyranda' steht.\n");

  SetProp(P_NOGET,0);
  SetProp(P_NODROP,1);
  SetProp(P_VALUE,800);
  SetProp(P_WEIGHT,30);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Flasche");
  SetProp(P_NAME_ADJ, "gruen" );
  
  AddId ( ({"flaeschchen", "flasche"}) );
  AddAdjective ( ({"gruen", "gruene"}) );
 
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,18}), F_DRINK:4, F_ALCOHOL:1,
    F_VERB: "trinken" ,
    F_MSG: "Du trinkst die gruene Fluessigkeit, welche die Kraeuterfrau von\n"
           "Kyranda gebraut hat. Irgendwie fuehlst Du Dich besser.\n",
    F_MSG_ROOM: "trinkt aus einem kleinen gruenen Flaeschchen.\n" ]) );

}

