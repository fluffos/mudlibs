inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "/d/ebene/Midas/midas.h"
#include "../files.h"

#define VGL_PREIS 400
#define LAGER BURG("shop/kraut_store.lpc")

void create()
{
  ::create();
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Im Laden der Kraeuterfrau");
  SetProp(P_INT_LONG, bs(
    "Du stehst inmitten einer kleinen Holzhuette, welche der Kraeuterfrau "+
    "von Kyranda gehoert. Sie ist allseits als Hexe bekannt, doch die "+
    "Buerger von Kyranda sind froh, sie in ihrer Stadt zu haben, denn ihre "+
    "Heilkraefte sind den Geruechten nach unglaublich gross. "+
    "Im ganzen Laden haengen die verschiedensten Kraeuter an den Waenden."));

  AddSmell(DEFAULT_SMELL,"Es stinkt fuerchterlich hier drinnen.\n");
  AddSmell( ({"gerueche", "kraeuter"}),
      "Es riecht nach Kraeutern.");
  AddSound( ({ DEFAULT_SOUND, "rascheln", "kraeuter"}),
      "Du hoerst das leise Rascheln der Kraeuter.\n");
  AddDetail (({"laden", "raum"}), 
   "Ueberall haengen die Kraeuter herum. Du fragst Dich, wo man nur solch "+
   "eine Vielfalt an verschiedenen Kraeutern herbekommen kann.\n");
  AddDetail (({"frau","kraeuterfrau"}),
   "Du siehst Dich um, siehst sie aber nicht.\n");
  AddDetail (({"kraut", "kraeuter"}), "Versuchs mal mit <zeige>!\n");
  AddDetail ("boden",
    "Du stehst genau darauf.\n");
  AddDetail ("decke",
    "Die hoelzerne Decke ist aus maechtigen Holzstaemmen gefertigt.\n");
  AddDetail (({"waende", "wand"}), bs(
    "Auch die Waende sind aus Holz gefertigt."));
  AddDetail(({"holzhuette","huette"}),
   "Die Huette sieht nicht gerade einladend aus.\n");
  AddDetail( ({"holz", "holzstaemme", "holzstamm"}),
   "Ja, echtes Holz! Sagenhaft!\n");
  AddDetail("kyranda",
   "So heisst die Stadt, in der Du Dich aufhaeltst.\n");
  AddDetail("heilkraefte",
   "Der Kraeuterfrau werden so manche Heilkraefte zugesprochen.\n");
 

  SetStorageRoom (LAGER);
  SetBuyFact (5);
  AddExit("sueden", BURGWEG("12x10y.lpc"));
}

sell()
{
  notify_fail("Tut mir leid, wir kaufen nichts an!\n");
  return 0;
}
force_sell() { return sell(); }
evaluate() { return sell(); }

