** Beim Waffenexperten, Midas  (w) Woody@SL
** ---
** 1996-04-18  Woody  release
** 1996-06-27  Woody  typo bugfix: bsq() -> bs()
*/

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <bank.h>
#include "/d/ebene/Midas/midas.h"
#include "../files.h"

#define VGL_PREIS 600
#define LAGER (BURG("shop/experte_store.lpc"))

int mymoney;

void create()
{
  ::create();
  mymoney=0;
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Im Laden des Waffenhaendlers");
  SetProp(P_INT_LONG, bs(
    "Du befindest Dich im Waffenladen von Kyranda. Waffenexperten aller "+
    "Nationen treffen sich hier um ihre Erfahrungen mit den verschiedensten "+
    "Waffen aller Rassen auszutauschen. Ausser einem Holzbrett, welches als "+
    "Informationstafel dient, liegen auch noch Unmengen an Waffen und "+
    "Ruestungen hinter dem Ladentisch."));

  AddDetail (({"laden", "raum"}), 
   "Die vielen Waffen und Ruestungen, welche hinter dem Ladentisch lagern, "+
   "beeindrucken Dich regelrecht.\n");
  AddDetail( ({"tisch", "ladentisch"}),
    "Der Ladentisch besteht aus Holz.");   
  AddDetail (({"waffenexperte","waffenexperten"}),
   "Es scheint keiner hier zu sein.\n");
  AddDetail (({"waffen", "ruestungen"}), "Versuchs mal mit <zeige>!\n");
  AddDetail ("boden",
    "Du stehst genau darauf.\n");
  AddDetail( ({"holz", "holstamm", "holzstaemme"}),
    "Das Holz stammt sicher aus dem Wald suedlich von Kyranda.");  
  AddDetail( ({"wald"}),
    "Der Wald ist suedlich von Kyranda.");
  AddDetail( ({"kyranda"}),
    "Du befindest Dich in der Stadt Kyranda.");  
  AddDetail ("decke",
    "Die hoelzerne Decke ist aus maechtigen Holzstaemmen gefertigt.\n");
  AddDetail (({"waende", "wand"}), bs(
    "Auch die Waende sind aus Holz gefertigt."));
  AddDetail (({"tafel","informationstafel", "brett", "holzbrett"}),
    "Eine Tafel mit Preisen. Du kannst sie lesen.\n");
  AddReadDetail (({"tafel","informationstafel", "brett", "holzbrett"}),
    "+------------------------------------------+\n"+
    "|  Dank einer Idee eines Waffenexperten    |\n"+
    "|  aus Midas, koennen auch wir fuer ein    |\n"+
    "|  kleines Entgelt von "+VGL_PREIS+" Muenzen sagen,  |\n"+
    "|  was Deine Waffe im Vergleich zu einer   |\n"+
    "|  Anderen so drauf hat.                   |\n"+
    "|                                          |\n"+
    "|  Syntax: vergleiche <x> mit <y>          |\n"+
    "+------------------------------------------+\n");


  AddCmd(({"vergleiche", "vergleich"}), "compare");
  SetStorageRoom (LAGER);
  SetBuyFact (5);
  AddExit("norden", BURGWEG("15x8y.lpc"));
}

