inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Am Weg");
  SetProp(P_INT_LONG,
        "Die Hauptgasse endet hier in einer Sackgasse. Im Westen gelangt man "+
        "zurueck, vorbei an der prachtvollen Kirche, zur Pferdegasse. Die "+
        "Kirchtuerme der Kirche sind von hier aus gut zu sehen. Sie sehen wirklich "
        "beeindruckend aus."
        );
  AddSound(DEFAULT_SOUND,"Du horchst herum, hoerst aber nichts.");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26]));



  AddDetail( ({"himmel", "blau"}),
      "Du siehst nach oben. Nichts als strahlendes Blau.\n");

  AddDetail(({"stadt"}),
        "Du siehst Dich um und stellst fest, dass Du wirklich in der Stadt stehst."
        );

  AddDetail("boden",
      "Du untersuchst den Boden, findest aber nichts.\n");

  AddDetail(({"kirche","gebaeude"}),
        "Die Kirche ist im Westen zu sehen. "
        );

  AddDetail(({"turm","tuerme", "kirchturm", "kirchtuerme"}),
        "Das sind wahrscheinlich die groessten Tuerme die Du je gesehen hast. "
        "Sie muessen von Meisterhand erbaut worden sein."
        );

  AddDetail(({"meisterhand","meister", "baukunst"}),
        "Nur ein Meister der Baukunst kann solche Tuerme erbauen.");



  AddDetail(({"hauptgasse"}),
        "Die Hauptgasse endet hier." 
        );


  AddDetail(({"pferdegasse"}),
        "Die Pferdegasse beginnt igendwo weiter im Westen." 
        );

  AddDetail("sackgasse",
      "Die Gasse endet hier.\n");



  AddExit("westen",ROOM("7x6y.lpc"));


}
