
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"In der Kirche");
  SetProp(P_INT_LONG,
        "Du stehst in der Kirche von Kyranda. Links und rechts von Dir "+
        "befinden sich unzaehlbare Reihen von Kirchenbaenken. Ein roter "+
        "Teppich fuehrt vom Eingang der Kirche vor bis zu den Stufen, ueber welche "+
        "man zum Altar gelangt. Die Decke ist mit Gemaelden uebersaeht.");

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));

  AddSmell(DEFAULT_SMELL,"Es riecht nach Kerzenwachs.");
  AddSound(DEFAULT_SOUND,"Du hoerst die absolute Stille.");

  AddDetail(({"kerzen", "wachs", "kerzenwachs"}),
        "Ganz normale Kerzen aus Wachs.");

  AddDetail(({"boden"}),
        "Hart sieht er aus, dieser Boden.");

  AddDetail(({"wand", "waende"}),
        "Du siehst eine ganz normale Wand.");

  AddDetail(({"gemaelde", "abbilder", "abbild"}),
        "Die Gemaelde zeigen die verschiedensten kirchlichen Abbilder.");

  AddDetail(({"decke", "kunstwerk"}),
        "Die Decke zeigt ein Kunstwerk neben dem anderen.");

  AddDetail(({"altar"}),
        "Der Altar sieht sehr einfach aus. Er ist aus Stein gefertigt.");

  AddDetail(({"stein"}),
        "Der Stein fuehlt sich kalt an.");

  AddDetail(({"stufen"}),
        "Die Stufen sind aus Stein gefertigt.");

  AddDetail(({"eingang"}),
        "Der Eingang der Kirche befindet sich im Norden.");

  AddDetail(({"teppich", "puls"}),
        "Du untersuchst den Teppich, fuehlst aber nicht einmal seinen Puls. "+
        "Hoffentlich ueberlebt ers.");

  AddDetail(({"bank","baenke","kirchenbaenke"}),
        "Sie sind braun und sehen etwas ungemuetlich aus.");

  AddDetail(({"reihe", "reihen"}),
        "Wirklich unzaehlbar viele Reihen.");

  AddDetail(({"kirche"}),
        "Du stehst inmitten drinnen. Beeindruckend sind die bunt gesprenkelten "+
        "Fenster.");

  AddDetail(({"fenster", "motiv", "motive"}),
      "Bunte Hintergrundmalereien. Sie zeigen den heilige Motive.\n");

  AddDetail(({"malerei","hintergrundmalerei","hintergrundmalereien","malereien"}),
      "Das Sonnenlicht bricht sich beim Durchdringen der Malereien in alle\n"+
      "Spektralfarben.\n");

  AddDetail(({"sonnenlicht","licht"}),
      "Es ist hell.\n");

  AddDetail(({"farben","spektralfarben"}),
      "Naja, bunt, sehr bunt. Unvorstellbar bunt!\n");

  AddItem(NPC("bettler.lpc"),REFRESH_DESTRUCT);

  AddExit("norden",ROOM("7x6y.lpc"));
}
