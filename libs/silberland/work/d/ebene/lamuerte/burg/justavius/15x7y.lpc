inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
        "Hier befindet sich der westlichste Punkt der Marktgasse, die sich "+
        "von hier aus weiter in den Osten erstreckt. Weit im Osten kannst Du "+
        "die Burgmauer erblicken, welche sich den Himmel empor streckt. Im "+
        "Westen beginnt der Burgweg.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_LIGHT,1);
  AddDetail(({"himmel"}),
        "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag.");
  AddDetail(({"punkt"}),
        "Du suchst den wirklich westlichsten Punkt den Du finden kannst.");
  AddDetail(({"mauer","burgmauer"}),
        "Von hier aus kann man die Mauer nicht genauer untersuchen. Bleibt "+
        "wohl nur noch zu sagen, dass sie ziemlich hoch aussieht.");
  AddDetail(({"marktgasse","gasse"}),
        "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "+
        "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne.");
  AddDetail("buerger",
      "Die Buerger sind im ganzen SilberLand fuer ihren regen Handel bekannt.\n");

  AddDetail("handel",
      "Die Buerger handeln mit Waren aller Art.\n");

  AddDetail("waren",
      "Wie gesagt ALLER ART, heisst mit allem was sie in die Finger bekommen.\n");

  AddDetail( ({"geschaefte", "geschaeft"}),
      "Die Buerger wollen aus jeder Moeglichkeit ein Geschaeft schoepfen.\n");

  AddDetail("blau",
      "Ganz schoen blau, dieses BLAU!\n");

  AddDetail("boden",
      "Es handelt sich um die Marktgasse.\n");

  AddDetail(({"sonne","sonnenschein"}),
      "Die Sonne blendet dich.\n");

  AddDetail(({"weg","burgweg"}),
        "Der Burgweg befindet sich weiter im Westen."
        );

  AddExit("osten",ROOM("15x8y.lpc"));
  AddExit("westen",ROOM("15x6y.lpc"));
}
