
inherit "std/room";

#include <moredef.h>
#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Im Eingangstor");
  SetProp(P_INT_LONG,
        "Das Eingangstor bildet einen steinernen Bogen, der sich ueber Dir " +
        "schliesst. Hier beginnt ein mit Kies gepflasterter Weg, der in " +
        "noerdliche Richtung in die Burg fuehrt. Im Sueden geht es aus der " +
        "Burg raus.");

  AddSound(DEFAULT_SOUND,"Du hoerst einige Leute vorbeilaufen.");
  AddSound("leute","Reges Treiben im Inneren der Burg.");

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  AddItem(NPC("oberwache.lpc"),REFRESH_DESTRUCT);
  AddDetail(({"tor","eingangstor"}),
        "Das Tor ist hoch gebaut, um auch mit Karren ins Innere fahren zu koennen. "+
        "Du erkennst wie gewaltig breit diese Mauern wirklich sind."
        );

  AddDetail("holz",
      "Es handelt sich um Buchenholz.\n");

  AddDetail("buchenholz",
      "Holz von Buchen.\n");

  AddDetail("buchen",
      "Keine einzige Buche zu sehen.\n");

  AddDetail("buche",
      "Wahrscheinlich sind alle Buchen jetzt Raeder....\n");

  AddDetail("raeder",
      "Du siehst aber nur ein Rad.\n");

  AddDetail(({"bogen"}),
        "Du kannst nichts besonderes an dem Bogen finden."
        );

  AddDetail(({"burg"}),
        "Von hier aus sieht man nur das Eingangstor, nicht die ganze Burg."  
        );

  AddDetail(({"weg"}),
        "Der Weg ist breit genug um einen Karren hindurch zu bewegen. Er sieht " +
        "sehr gepflegt aus."
        );

  AddDetail("boden",
      "Der Boden ist mit Kies bedeckt.\n");

  AddDetail(({"kies"}),
        "Du wuehlst mit Deinen Fuessen im Kies herum. Kein einziges Stueck Muell " +
        "zu finden. Sieht so aus als ob die Kyrander ein sauberes Voelkchen sind."
        );


  AddDetail(({"einwohner","kyrander", "voelkchen", "volk"}),
        "Duerften nett sein diese Kyrander."  
        );


  AddDetail(({"decke","wand","waende","mauer","seitenmauer","mauern"}),
      
        "Als Du die Mauer untersuchst, faellt Dir ein Rad auf, welches an einer " +
        "Seitenmauer des Tors angebracht ist."  
        );

  AddDetail("rad",
        "Ein aus Holz gefertigtes Rad mit dem das Tor auf und zugemacht werden " +
        "kann."  
        );

  AddDetail(({"schloss","vorhaengeschloss"}),
        "Ein kleines Schloss welches unerwuenschtes Schliessen des Tors verhindern"
        +" soll."  
        );

  AddDetail(({"richtung","Richtung"}),
      "Oh! Eine Richtung zu untersuchen ist doch reichlich komisch, findest "+
      "Du nicht? Willst Du vielleicht auch noch das Wort Kumah untersuchen? "+
      "Nein, mach es lieber nicht, denn hierbei handelt es sich um eine "+
      "SCRIPTFALLE. Du wuerdest also sterben, wenn Du dieses verbloedete "+
      "Wort untersuchst. ");

  AddDetail("karren",
      "Weit und breit kein Karren zu sehen.\n"); 

  AddSpecialDetail(({"Kumah","kumah"}),"me_die_now");

  AddCmd("oeffne","aufmach");
  AddCmd(({ "drehe","dreh"}),"spinit");



  AddExit("norden",ROOM("15x6y.lpc"));
  AddExit("sueden",ROOM("17x6y.lpc"));
}

me_die_now()
{object ob;
  if (present("falle\n",this_player())) return "";
  ob = clone_object( OBJ("falle.lpc") );
  if (!ob) return "";
  ob->move( this_player(), M_NOCHECK );
  return "";
}

aufmach(str)
{object key;
  object ob;
  notify_fail("Was moechtest Du oeffnen?\n");
  if (!stringp(str))
    return 0;
  if (str!="tor" && str!="eingangstor" && str!="schloss" && str!="vorhaengeschloss")
  {write ("Das kannst Du nicht oeffnen.\n");
    return 1;
  }
  if (str=="tor" || str=="eingangstor")
  {
    write("Dieses Tor ist wohl etwas zu schwer fuer Dich. Die Kyrander nehmen\n"
        +"normalerweise dieses Rad an der Mauer zur Hilfe.\n");
    return 1;
  } 

  if (str=="schloss" || str=="vorhaengeschloss")
  {


    if (!(key=present ("seppo",this_player())))
    {write("Ohne Schluessel? Nie im Leben!\n");
      return 1;
    }
    write("Langsam oeffnest Du das Schloss. Doch was ist das!\n"+
        "Wie aus dem Nichts stehen zwei Wachen hinter Dir.\n");

    if(!objectp(ob=present("\nkeywache"))) {
      ob=clone_object(NPC("keywache.lpc"));
      ob->move(TO, M_GO);
    }
    ob->Kill(this_player());
    
    if(!objectp(ob=present("\nivekeywache"))) {
      ob=clone_object(NPC("ivekeywache.lpc"));
      ob->move(TO, M_GO);
    }
    ob->Kill(this_player());

    key->remove();

    return 1;
  } 

} 

spinit(str)
{notify_fail("Was moechtest Du drehen?\n");
  if (!stringp(str))
    return 0;
  if (str!="rad" && str!="holzrad")
  {write ("Du willst "+str+" drehen? Wie soll das gehen?\n");
    return 1;
  }

  write ("Als Du versuchst das Rad zu drehen, bemerkst Du, dass es mit\n"
      +"einem Vorhaengeschloss versperrt ist.\n");
  return 1;
} 

