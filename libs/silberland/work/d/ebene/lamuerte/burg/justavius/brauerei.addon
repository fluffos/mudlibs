            ({"Du kippst ein Starkbier wech. Schoen langsam schwindet Dein "+
              "Gleichgewichtssinn.",
              "&& trinkt ein Starkbier."}));

   AddFood("Bierbrezel", ({"brezel", "bierbrezel"}),
