inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "files.h"
#include <pub.h>

void create()
{
 ::create();
  SetProp(P_INT_SHORT,"Don Tonno's Pizze");
  SetProp(P_INT_LONG,
    "Du stehst in Tonno's Pizzastube. Es ist ein eher enger Raum mit einer niedrigen "
    "Decke. Hinter einem Pult steht Tonno, welcher herrliche Pizzen zaubert. "
    "Zu Tonno's linker Hand ist ein grosser Pizzaofen in der Mauer eingearbeitet "
    "welcher die benoetigte Hitze zum Pizzabacken erzeugt.");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_LIGHT,1);
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "tonno");
  SetProp( P_PUBKEEPER_NAME, "Tonno");
  SetProp( P_PUBKEEPER_GENDER, MALE);


  AddDetail(({"pizzen","pizza","pizze"}),
      "Frag doch Tonno danach.");

  AddDetail(({"raum","stube","pizzastube"}),
      "Es ist eng und heiss hier, aber es duftet gut.");

  AddDetail("boden",
      "Der Boden ist etwas dreckig.");
  AddDetail( "dreck",
      "Der Dreck liegt am Boden.");

  AddDetail("decke",
      "Sie ist schwarz, vom offenen Feuer im Pizzaofen.");

  AddDetail(({"ofen","pizzaofen"}),
      "Er ist gross, heiss und ideal zum Pizzabacken.");

  AddDetail("feuer",
      "Das Feuer lodert im Pizzaofen.");

  AddDetail(({"wand","waende","mauer"}),
      "Ganz normale Waende, nur in einer Wand ist ein Pizzaofen eingearbeitet.");
 
  AddDetail("hitze",
      "Ja echt schoen warm hier.");
 
  AddDetail("pult",
      "Das Pult ist leicht mehlig, kommt wohl vom Pizzabacken.");
  AddDetail( "mehl",
      "Auf dem Pult liegt Mehl.");

  
  AddSmell(DEFAULT_SMELL,
      "Es duftet nach Pizza.");
 
  AddSound(DEFAULT_SOUND,
      "Du hoerst ein Feuer knistern.");
  
  AddItem(NPC("pizza.lpc"),REFRESH_DESTRUCT);


  AddExit("sueden","/d/ebene/lamuerte/burg/weg/12x11y.lpc");
}

