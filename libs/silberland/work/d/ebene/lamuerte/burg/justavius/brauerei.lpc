inherit "/std/pub";

#include <rooms.h>
#include <properties.h>
#include <mnpc.h>
#include "../files.h"

void create(){
   ::create();
   
   
   AddExit("sueden", BURGWEG("12x9y.lpc"));

   SetProp(P_INT_SHORT,"Goranors Brauerei");
   SetProp(P_INT_LONG,break_string("Du stehst in Goranors Brauerei. "+
         "Die kleine Brauerei hat alles fuer den echten Biergeniesser. "+
         "Die linke Haelfte der Brauerei ist voll mit Brauwerkzeug und "+
         "Bottichen, in welchen Hopfen und Malz gelagert werden. Die "+
         "andere Haelfte ist gemuetlich eingerichtet, um den Bewohnern "+
         "von Kyranda und den Gaesten der Stadt ein gemuetliches Miteinander "+
         "zu ermoeglichen.\n"
         "Solltest Du durstig sein, tippe: 'menue'.\n",78));	
   SetProp(P_LIGHT,1);
   AddItem(NPC("betrunkener.lpc"),REFRESH_DESTRUCT, ([P_MNPC_FLAGS:0]) );

   AddSmell(DEFAULT_SMELL,
       "Es riecht nach herrlichem Bier.\n");


   AddDetail("kyranda",
       "So heisst die Stadt.\n");

   AddDetail(({"gorandor","braumeister"}),
       "Gorandor ist ein kleiner, etwas dicklicher Mann, der dir sehr vertraut "+
       "vorkommt. Er ist der Braumeister dieser Brauerei.\n");

   AddDetail("bier",
       "Das beste Bier von ganz Kyranda wird sicherlich in dieser Brauerei "+
       "hergestellt. Es ist ja auch die einzige in der Stadt.\n");

   AddDetail("biergeniesser",
       "Naja, viele Biergeniesser treffen sich hier, um gemuetlich einen zu heben.\n");


   AddDetail(({"zutat","zutaten","hopfen","malz"}),
       "Hopfen und Malz sind in den Bottichen gelagert.\n");

   AddDetail("brauerei",
       "Es ist wirklich sehr gemuetlich hier drinnen.\n");

   AddDetail(({"brauwerkzeug","werkzeug"}),
       "Du untersuchst die verschiedensten Werkzeuge, kannst "+
       "aber nichts damit anfangen.\n");

   AddDetail(({"bottich","bottiche"}),
       "In den Bottichen werden die Zutaten, welche fuer die Bierherstellung "+
       "benoetigt werden, gelagert.\n");         

   AddDetail(({"bewohner","kyrander","kyrandern"}),
       "Die Bewohner lieben diesen Ort.\n");

   AddDetail("boden",
       "Der Boden sieht sehr sauber aus.\n");

   AddDetail( ({"wand","waende"}),
       "Du findest nichts besonderes an den Waenden.\n");

   AddDetail( "decke",
       "Du findest absolut nix ungewoehnliches an der Decke.\n");

   AddDetail(({"gast","gaeste"}),
       "Auch Du bist einer von ihnen.\n"); 
}


