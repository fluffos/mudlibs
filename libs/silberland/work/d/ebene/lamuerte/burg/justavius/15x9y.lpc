inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT,"Marktgasse");
  SetProp(P_INT_LONG,
        "Die Marktgasse endet hier in einer Biegung die vom Westen in den "+
        "Norden weiterfuehrt. In einiger Entfernung kannst Du sowohl in "+
        "westlicher als auch in noerdlicher Richtung Eisenschilder, welche "+
        "ueber den Eingaengen der Haeuser haengen, sehen. "
        );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23]));
  SetProp(P_LIGHT,1);
  AddDetail("boden",
      "Ein Boden, ist ein Boden, ist ein Boden.\nOb er eine Tarnkappe hat? ;-)\n");
  AddDetail("tarnkappe",
      "Du kannst nicht feststellen ob eine Tarnkappe da ist.");
  AddDetail(({"eingang","eingaenge"}),
      "Oeffnungen durch die man ein Haus betreten kann.\n");
  AddDetail(({"haus","haeuser"}),
        "Die kleinen Blockhuetten dienen sowohl als Verkaufslokale als auch "+
        "als Unterkunft fuer die Buerger."
        );
  AddDetail(({"zunft","handelszunft"}),
      "Es handelt sich um das Zeichen eines Schmiedes.\n");
  AddDetail ("zeichen",
      "Das Zeichen eines Schmiedes.\n");
  AddDetail(({"schild","schilder","eisenschilder"}),
        "Die Schilder zeigen jede einzelne Handelszunft."
        );
  AddDetail(({"himmel", "sonnenschein", "tag"}),
        "Blauer Himmel, Sonnenschein, ein wirklich wundervoller Tag."
        );
  AddDetail(({"punkt"}),
        "Du suchst den wirklich westlichsten Punkt den Du finden kannst."
        );
  AddDetail(({"mauer","burgmauer"}),
        "Die Burgmauer fuehrt wohl um ganz Kyranda."
        );
  AddDetail(({"marktgasse","gasse"}),
        "Die Marktgasse ist fuer ihren regen Handel allseits bekannt. Hier "+
        "laufen die wichtigsten Geschaefte der Buerger ueber die Buehne."
        );
  AddDetail( ({"handel", "geschaefte"}),
      "Hier wird viel gehandelt, wie man an den vielen Schildern sehen kann.");

  AddExit("norden",ROOM("14x9y.lpc"));
  AddExit("westen",ROOM("15x8y.lpc"));
}
