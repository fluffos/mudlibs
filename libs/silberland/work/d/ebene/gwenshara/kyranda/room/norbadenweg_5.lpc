#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Am Norbadenweg noerdlich von Kyranda");
    SetProp(P_INT_LONG,
        "An dieser Stelle geht der bisher flache Norbadenweg in einen "
        "steiler werdenden Gebirgspfad ueber. Der Weg windet sich nun "
        "nach Nordwesten und fuehrt hinauf in die Auslaeufer des Gebirges.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

//--Details----------------------------------------------------------------

    AddDetail(({"norbadenweg", "weg"}),
        "Der Norbadenweg endet hier und geht in einen schmaleren Gebirgspfad ueber.");
    AddDetail("uebergang",
        "Der Uebergang vom weichen Land zum harten Fels ist kaum zu uebersehen.");
    AddDetail("stelle",
        "Diese Stelle markiert den Uebergang vom flachen Land zum Fels.");
    AddDetail("ebene",
        "Die Ebene liegt nun hinter Dir und verschwindet zwischen den Waeldern.");
    AddDetail(({"waeldern", "waelder"}),
        "Die Waelder lassen Dich einsam fuehlen.");
    AddDetail("boden",
        "Der Boden wird felsig und verliert den weichen Sand des Ostens.");
    AddDetail("halt",
        "Halt findest Du nur, wenn Du Deine Schritte genau setzt.");
    AddDetail("schritte",
        "Schritte hallen hier trocken ueber den Fels.");
    AddDetail("staub",
        "Staub klebt an Stiefeln und Steinen gleichermassen.");
    AddDetail("stiefeln",
        "Stiefeln schrammen ueber den Fels, der kaum nachgibt.");
    AddDetail("sand",
        "Sandreste aus dem Osten kleben noch zwischen den Steinen.");
    AddDetail("steinen",
        "Steinen bieten kaum Halt, solange sich Staub darauf sammelt.");
    AddDetail("ostens",
        "Ostens breitet sich die Ebene aus, wovon noch Sand und Staub zeugen.");
    AddDetail("gebirgspfad",
        "Der Gebirgspfad windet sich in engen Kurven den Hang hinauf.");
    AddDetail("pfad",
        "Pfad und Weg sind hier kaum noch voneinander zu unterscheiden.");
    AddDetail("kurven",
        "Kurven folgen dicht aufeinander und nehmen dem Pfad jede Sicht nach vorne.");
    AddDetail("gebirges",
        "Die Auslaeufer des Gebirges ragen hier schon wie Mauern auf.");
    AddDetail("mauern",
        "Mauern aus Fels flankieren den Pfad.");
    AddDetail("auslaeufer",
        "Auslaeufer aus Fels blockieren jede Sicht nach Norden.");
    AddDetail("sicht",
        "Sicht nach hinten hast Du nur, wenn Du Dich vorsichtig umdrehst.");
    AddDetail("fels",
        "Felsplatten liegen ueberall frei.");
    AddDetail("hang",
        "Hangkanten zwingen Dich, vorsichtig zu steigen.");
    AddDetail("himmel",
        "Der Himmel wirkt naeher, als wuerde das Gebirge ihn nach unten ziehen.");
    AddDetail("gebirge",
        "Das Gebirge selber wirkt wie eine Wand, die den Weg verschluckt.");
    AddDetail("wand",
        "Die Wand aus Fels scheint den Himmel zu beruehren.");
    AddDetail("land",
        "Land aus dem Osten wirkt hier fern und fremd.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "suedosten",  ROOM "norbadenweg_4" );
    AddExit( "norden", "/d/gebirge/gwenshara/festung/room/ostweg_7" );

//--Items & NPCs-----------------------------------------------------------
    AddItem("/d/ebene/Silberwald/npc/biber", REFRESH_DESTRUCT);
}
