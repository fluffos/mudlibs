#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Am Norbadenweg noerdlich von Kyranda");
    SetProp(P_INT_LONG,
        "Hier bist du am beruehmten Norbadenweg. Nach Westen hin beginnt "
        "er anzusteigen und zu einem Gebirgspfad zu werden. Im Osten liegt ein "
        "kleines Waeldchen.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

//--Details----------------------------------------------------------------

    AddDetail(({"norbadenweg", "weg"}),
        "Der Norbadenweg zieht hier gerade nach Westen und wirkt fast schon wie ein Gebirgspfad.");
    AddDetail("aufstieg",
        "Der Aufstieg wird hier spuerbar, auch wenn der Pfad noch breit wirkt.");
    AddDetail("boden",
        "Der Boden ist grob geschottert und bietet festen Halt fuer schwere Karren.");
    AddDetail( ({"abschnitt", "teil"}),
        "Dieser Abschnitt fuehlt sich an wie der letzte flache Teil vor dem Gebirge.");
    AddDetail("gebirge",
        "Das Gebirge liegt westlich von hier.");
    AddDetail("schotter",
        "Schotter knirscht bei jedem Schritt unter Dir.");
    AddDetail("schritt",
        "Schritt fuer Schritt scheint der Weg steiler zu werden.");
    AddDetail("fuesse",
        "Fuesse finden nur Halt, wenn sie sorgsam gesetzt werden.");
    AddDetail("kiesbett",
        "Das Kiesbett bildet den Pfad.");
    AddDetail("fundament",
        "Fundament und Wegbelag wirken so solide wie Stadtstrassen.");
    AddDetail("pfad",
        "Pfad und Weg werden hier fast eins, so schmal wird es.");
    AddDetail("schritt",
        "Schritt fuer Schritt wird der Aufstieg steiniger.");
    AddDetail("halt",
        "Halt findest Du nur dort, wo der Schotter dicht liegt.");
    AddDetail("karren",
        "Karren rumpeln ueber die Steine und hinterlassen eigenartige Spuren.");
    AddDetail("spuren",
        "Spuren verschwinden rasch, wenn neue Raeder sie ueberrollen.");
    AddDetail("gebirgspfad",
        "Der Gebirgspfad hebt sich bereits leicht an und fuehrt weiter ins Gestein.");
    AddDetail("gestein",
        "Gestein lugt bereits zwischen den Schotterfeldern hervor.");
    AddDetail("schotterfeldern",
        "Schotterfeldern wechseln sich mit rauhen Felsbrocken ab.");
    AddDetail("felsbrocken",
        "Felsbrocken markieren den Rand des Weges.");
    AddDetail("rand",
        "Randsteine halten den Schotter zusammen.");
    AddDetail("steine",
        "Steine ragen heraus und dienen als Trittstufen.");
    AddDetail("stein",
        "Stein, der offen liegt, erwaermt sich rasch.");
    AddDetail("trittstufen",
        "Trittstufen aus Stein erleichtern kurze Pausen.");
    AddDetail("pausen",
        "Pausen bleiben kurz, damit die Fuesse nicht auskuehlen.");
    AddDetail("waeldchen",
        "Das Waeldchen im Osten bietet Schatten und verdeckt den Blick zur Ebene.");
    AddDetail("schatten",
        "Schatten fallen lang ueber den Weg, sobald die Sonne sich senkt.");
    AddDetail("sonne",
        "Die Sonne brennt heiß, solange kein Hang sie verdeckt.");
    AddDetail("tag",
        "Tag fuer Tag wirkt dieser Abschnitt gleich, nur die Schatten wandern.");
    AddDetail("hang",
        "Hangschatten krauchen schon frueh am Tag den Weg entlang.");
    AddDetail("blick",
        "Ein Blick zurueck zeigt Dir den Weg, der zur Ebene fuehrt.");
    AddDetail("ebene",
        "Die Ebene verschwindet hinter dem Waeldchen, nur der Wind erinnert an sie.");
    AddDetail("wind",
        "Wind traegt den Duft von Staub und Gras herauf.");
    AddDetail("duft",
        "Der Duft erinnert an trockenen Schotter und heisse Steine.");
    AddDetail("staub",
        "Staub wirbelt auf, sobald Raeder oder Stiefel den Weg betreten.");
    AddDetail("stiefel",
        "Stiefel bekommen schnell Kratzer vom groben Schotter.");
    AddDetail("kratzer",
        "Kratzer zeugen von den spitzen Steinen.");
    AddDetail("gras",
        "Gras entlang des Randes riecht warm und leicht suesslich.");
    AddDetail("raeder",
        "Raeder graben flache Spuren in das Kiesbett.");
    AddDetail("himmel",
        "Der Himmel spannt sich hell ueber Dir und laesst die Luft klar erscheinen.");
    AddDetail("luft",
        "Luft, die hier heraufzieht, ist trocken und leicht.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "osten",  ROOM "norbadenweg_3" );
    AddExit( "nordwesten", ROOM "norbadenweg_5" );

//--Items & NPCs-----------------------------------------------------------
}
