#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "In der Nordtorgasse von Kyranda");
    SetProp(P_INT_LONG,
        "Du befindest dich in der Nordtorgasse von Kyranda. Hier stehen ein "
        "paar der groesseren Gebaeude der Stadt, die meisten davon aus hellem Stein, "
        "verziert mit kunstvollen Schnitzereien. Die Gasse fuehrt nach Norden zum "
        "Stadttor und nach Sueden zur prachtvollen Kirche.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail(({"boden", "pflaster", "steinpflaster"}),
        "Das Pflaster aus hellen Steinen ist glattgetreten und von den Schuhen der "
        "Buerger blank gescheuert.");
    AddDetail(({"gasse", "nordtorgasse"}),
        "Die Nordtorgasse fuehrt vom Stadttor tiefer in Kyranda hinein und ist von "
        "ordentlichen Fassaden gesaeumt.");
    AddDetail(({"gebaeude", "haeuser"}),
        "Die meisten Gebaeude bestehen aus hellem Stein und tragen kunstvolle "
        "Schnitzereien an Saeulen und Laibungen.");
    AddDetail(({"fassaden", "daecher"}),
        "Ornamentierte Fassaden steigen zu roten Daecher empor, die im Sonnenlicht "
        "aufglimmen.");
    AddDetail(({"fenster"}), 
        "Hohe Fenster mit bleiverglasten Feldern lassen Licht in die Gebaeude "
        "fallen.");
    AddDetail("feldern",
        "Die bunten Felder der Bleiverglasung werfen farbige Tupfer auf die Wande.");
    AddDetail(({"felder", "feld"}),
        "Jedes Feld der Bleiverglasung schimmert in einer anderen Farbe.");
    AddDetail(({"bleiverglasung", "bleirippen", "glasscheiben"}),
        "Feine Bleirippen halten die Glasscheiben in kunstvollen Mustern zusammen.");
    AddDetail(({"licht", "sonnenlicht"}),
        "Zerstreutes Sonnenlicht faellt zwischen den Daechern hindurch und laesst Staub "
        "glitzern.");
    AddDetail("sonne",
        "Die Sonne spiegelt sich in den Fenstern und malt goldene Streifen auf das Pflaster.");
    AddDetail("streifen",
        "Goldene Streifen wandern über die Steine, wenn Wolken aufbrechen.");
    AddDetail("staub",
        "Feiner Staub wirbelt bei jedem Schritt auf und tanzt im Licht.");
    AddDetail("tupfer",
        "Farbige Tupfer tanzen ueber die Hauswaenden, wenn die Sonne die Fenster trifft.");
    AddDetail("farbe",
        "Die Farbe der Scheiben wandert wie ein Regenbogen ueber das Pflaster.");
    AddDetail("himmel",
        "Zwischen den Daecher blickst Du auf einen klaren Himmel, der das Licht in "
        "die enge Gasse traeufeln laesst.");
    AddDetail("kirche",
        "Die Kirche im Sueden ist beruehmt fuer ihre hohen Fenster und das sanfte "
        "Laeuten ihrer Glocken.");
    AddDetail(({"glocken", "kirchenglocken"}),
        "Die Kirchenglocken senden klare Klaenge ueber die Daechern, wenn sie zum "
        "Gebet rufen.");
    AddDetail("gebet",
        "Ein sanftes Gemurmel von Gebeten begleitet manchmal das Laeuten der Glocken.");
    AddDetail("gemurmel",
        "Das Gemurmel der Betenden klingt wie fernes Wasser.");
    AddDetail("klaenge",
        "Die Klaenge hallen lange zwischen den Mauern nach und wirken beruhigend.");
    AddDetail("kyranda",
        "Kyranda ist eine wohlhabende Stadt, deren Mauern Reisenden Schutz bieten.");
    AddDetail("schnitzereien",
        "Die Schnitzereien zeigen florale Muster, Heilige und Szenen aus der "
        "Stadtgeschichte.");
    AddDetail(({"saeulen"}), 
        "Schlanke Saeulen tragen die Vordaecher und sind mit filigranen Mustern "
        "ueberzogen.");
    AddDetail("vordaecher",
        "Schmal geschwungene Vordaecher halten Regen von Tueren und Passanten fern.");
    AddDetail(({"laibungen"}), 
        "Die Laibungen der Tueren sind tief eingeschnitten und voller Reliefs, die "
        "Helden und buergerliche Szenen darstellen.");
    AddDetail("tueren",
        "Schwere Holztueren, teils mit Eisen beschlagen, fuehren in Handelshauser und "
        "Wohnungen.");
    AddDetail("holztueren",
        "Die Holztueren sind mit Ziernaegeln besetzt und wurden frisch eingeoelt.");
    AddDetail("ziernaegeln",
        "Die Ziernaegeln bilden schimmernde Muster.");
    AddDetail("fensterlaeden",
        "Fensterlaeden aus dickem Holz lassen sich komplett vor die Scheiben klappen.");
    AddDetail("holz",
        "Das Holz duftet nach frischem Harz und ist von den Handwerkern sorgfaeltig "
        "poliert worden.");
    AddDetail("harz",
        "Harzduft legt sich ueber die Gasse und erinnert an nahe Waelder.");
    AddDetail("duft",
        "Ein schwerer Duft aus Harz, Gewuerzen und Leder haengt in der Luft.");
    AddDetail("geruch",
        "Der Geruch verraet, welche Waren gerade gehandelt werden.");
    AddDetail("waelder",
        "Die Waelder liefern Holz, Harz und Geschichten fuer den Markt.");
    AddDetail("eisen",
        "Dunkel glaenzendes Eisen verstaerkt Tueren, Fensterlaeden und Gitter.");
    AddDetail("gitter",
        "Feine Gitter schuetzen die Fenster vor neugierigen Haenden.");
    AddDetail(({"stadt", "stadttor"}),
        "Das Stadttor liegt im Norden der Gasse und wird von wachsamen Augen "
        "behutet.");
    AddDetail("torwaechtern",
        "Torwaechter stehen in festem Schritt auf Posten und lassen niemanden ohne "
        "Fragen passieren.");
    AddDetail("posten",
        "Die Posten sind genau markiert; keine Wache verlaesst ihre Position.");
    AddDetail("fragen",
        "Jeder, der eintritt, muss Fragen nach Herkunft und Absicht beantworten.");
    AddDetail("augen",
        "Wachsame Augen folgen jedem Schritt bis zum Tor.");
    AddDetail("absicht",
        "Die Waechter wollen jede Absicht kennen, bevor sie Platz machen.");
    AddDetail("herkunft",
        "Wer seine Herkunft nennt, wird schneller vorgelassen.");
    AddDetail("tor",
        "Das Tor aus Eisenbanden steht offen, aber nie unbeobachtet.");
    AddDetail("stein",
        "Der helle Stein fuehlt sich angenehm kuehl und glatt an.");
    AddDetail("mauern",
        "Die Mauern der Stadt ragen unweit im Norden auf und werfen kuehlen Schatten "
        "in die Gasse.");
    AddDetail("schatten",
        "Die Schatten der Mauern schenken an heissen Tagen willkommene Kuehle.");
    AddDetail("kuehle",
        "Selbst zur Mittagsstunde liegt hier eine angenehme Kuehle in der Luft.");
    AddDetail("mittagsstunde",
        "Selbst zur Mittagsstunde bleibt der Schatten dicht und angenehm.");
    AddDetail("luft",
        "Die Luft schmeckt nach Stein, Staub und Marktgeruechen.");
    AddDetail(({"schuhe", "schuhen"}),
        "Unzaehlige Schuhe haben glitzernde Spuren im Pflaster hinterlassen.");
    AddDetail("spuren",
        "Schmale Spuren aus Staub und Lederfett erzaehlen von geschaeftigem Treiben.");
    AddDetail("lederfett",
        "Der Geruch von Lederfett liegt ueber den Stufen der Haendler und Reisenden.");
    AddDetail("stufen",
        "Flache Stufen vor den Laeden sind glattgeschliffen.");
    AddDetail("buerger",
        "Die Buerger Kyrandas gehen geschaeftig ihres Weges und nicken Reisenden kurz "
        "zu.");
    AddDetail(({"weg", "weges"}),
        "Der Weg fuehrt direkt zum Stadttor und weiter hinein in Kyrandas Marktviertel.");
    AddDetail("marktviertel",
        "Das Marktviertel hinter dem Tor ist voller Staende, Waren und lauter Stimmen.");
    AddDetail("markt",
        "Der Markt beginnt bereits hier mit lauten Rufen und dichtem Gedraenge.");
    AddDetail("reisenden",
        "Reisende saumen den Weg, schultern Buendel oder warten auf Einlass an den "
        "Torwaechtern.");
    AddDetail("reisen",
        "Laute Gesprache erzahlen von langen Reisen ueber Gebirge und Ebenen.");
    AddDetail("buendel",
        "In Tuechern geschlagene Buendel haengen ueber den Schultern wartender Gaeste.");
    AddDetail("tuechern",
        "Bunte Tuecher halten die Buendel zusammen und flattern im Wind.");
    AddDetail("schultern",
        "Viele Schultern sind von langen Reisen gebeugt und tragen schwere Lasten.");
    AddDetail("lasten",
        "Die Lasten bestehen aus Buendeln, Saecken und Tuchballen.");
    AddDetail("einlass",
        "Alle warten geduldig auf Einlass, waehrend die Waechter Fragen stellen.");
    AddDetail("gaeste",
        "Gaeste aus allen Landen tauschen Neuigkeiten waehrend des Wartens aus.");
    AddDetail("wartens",
        "Das Wartens vertreiben sie mit Geschichten und Gesang.");
    AddDetail("landen",
        "Aus fernen Landen bringen Haendler neue Waren und Geruechte.");
    AddDetail("schutz",
        "Hinter Kyrandas Mauern finden Haendler und Pilger Schutz vor Raeubern und "
        "Wetter.");
    AddDetail(({"haendler", "handwerker"}),
        "Haendler bieten Waren an improvisierten Staenden an, waehrend Handwerker ihre "
        "Werkzeuge tragen.");
    AddDetail("handelshauser",
        "Hinter massiven Fassaden liegen Handelshauser, in denen kostbare Waren lagern.");
    AddDetail("pilger",
        "Pilger mit weiten Maenteln kuessen den Boden, bevor sie in die Stadt treten.");
    AddDetail(({"maentel", "maenteln"}),
        "Die Maentel der Pilger sind mit Symbolen bestickt und rascheln ueber das Pflaster.");
    AddDetail("symbolen",
        "Die Symbole auf den Maenteln stehen fuer ferne Kulte.");
    AddDetail("raeubern",
        "Raeuber sollen sich selten in die Naehe Kyrandas wagen, so spricht man.");
    AddDetail("naehe",
        "Niemand wagt es, in unmittelbarer Naehe zum Tor Unfug zu treiben.");
    AddDetail("wetter",
        "Schwere Wolken oder heisse Sonne, alles bleibt draussen vor den Mauern.");
    AddDetail("wolken",
        "Wolken schuetten ihr Wasser oft ausserhalb der Stadt ab.");
    AddDetail("regen",
        "Regen sammelt sich in den Pflasterfugen, bevor er langsam abfliesst.");
    AddDetail("wasser",
        "Wasserlaeufe ziehen sich dann wie blanke Schnueren durch die Gasse.");
    AddDetail("pflasterfugen",
        "Die Pflasterfugen schimmern wie kleine Baeche nach einem Schauer.");
    AddDetail("wind",
        "Ein sanfter Wind treibt den Duft von Gewuerzen und Feuerstellen durch die "
        "Gasse.");
    AddDetail("feuerstellen",
        "Feuerstellen an den Staenden glimmen ruhig und halten Speisen warm.");
    AddDetail("muster",
        "Geometrische Muster ziehen sich ueber Stein und Holz und verraaten den "
        "Stolz der Handwerker.");
    AddDetail(({"stolz", "taten"}), 
        "Stolz berichten Reliefs und Wandinschriften von den Taten der Stadtgruender.");
    AddDetail("stadtgruender",
        "Wandinschriften preisen die Stadtgruender und ihre Abenteuer.");
    AddDetail("abenteuer",
        "Die Abenteuer der Stadtgruender sind in Bildern festgehalten.");
    AddDetail(({"reliefs", "szenen", "stadtgeschichte", "heilige", "heiliger", "helden"}), 
        "Reliefs an Saeulen schildern Szenen der Stadtgeschichte, Heldensagen und "
        "die Wunder verehrter Heiliger.");
    AddDetail("heldensagen",
        "Heldensagen sind in Stein gemeisselt und zeigen Mut und Weisheit.");
    AddDetail("mut",
        "Die dargestellten Helden trotzen jeder Gefahr mit offenem Blick.");
    AddDetail("weisheit",
        "Weisheit zeigt sich in den ruhigen Gesten der Abgebildeten.");
    AddDetail(({"wunder", "wundern"}),
        "Die Wunder der Heiligen sind mit goldenen Akzenten hervorgehoben.");
    AddDetail("akzenten",
        "Die Akzenten bestehen aus duennen Blattgoldlinien.");
    AddDetail("wandinschriften",
        "Wandinschriften ziehen sich ueber mehrere Hauswaende und nennen Wohltaten.");
    AddDetail("wohltaten",
        "Wohltaten fuer Stadt und Reisende werden darin stolz aufgelistet.");
    AddDetail("wande",
        "Wande aus hellem Stein reflektieren das Sonnenlicht.");
    AddDetail(({"hauswaenden", "hauswaende"}),
        "Die Hauswaenden stehen dicht beieinander und formen einen weichen Klangraum.");
    AddDetail("klangraum",
        "Der enge Klangraum laesst jedes Geraeusch kurz widerhallen.");
    AddDetail("melodie",
        "Wenn die Glocken laeuten, schwingt eine sanfte Melodie ueber die Nordtorgasse.");
    AddDetail("laeuten",
        "Das Laeuten breitet sich wie Wellen durch die Stadt aus.");
    AddDetail("wellen",
        "Wellen aus Klang rollen ueber die Daechern.");
    AddDetail("schritt",
        "Jeder Schritt hallt leise zwischen den Hauswaenden, ehe er im Geraeusch der "
        "Gasse untergeht.");
    AddDetail("geraeusch",
        "Ein Mosaik aus Stimmen, Hufschlaegen und Glocken bildet das Geraeusch der Gasse.");
    AddDetail("hufschlaegen",
        "Hufschlaege von Packpferden hallen dumpf durch den Klangraum.");
    AddDetail("mosaik",
        "Das Mosaik aus Lauten wirkt wie Musik ohne Pause.");
    AddDetail("treiben",
        "Stetes Treiben haelt die Gasse belebt, selbst wenn der Markt schliesst.");
    AddDetail(({"tage", "tagen"}),
        "Selbst an heissen Tagen bleibt der Schatten der Mauern angenehm.");
    AddDetail("passanten",
        "Passanten huschen vorbei und traegen Neuigkeiten von nah und fern.");
    AddDetail("neuigkeiten",
        "Neuigkeiten werden hier schneller getauscht als Waren.");
    AddDetail("stimmen",
        "Stimmen mischen sich zu einem pausenlosen Summen.");
    AddDetail("stadtwachen",
        "Die Stadtwachen mustern Reisende mit ernsten Blicken und achten auf Ordnung.");
    AddDetail("waechter",
        "Die Waechter tragen blanke Brustpanzer, Speere und ernste Gesichter.");
    AddDetail("wache",
        "Jede Wache wirkt angespannt, doch professionell.");
    AddDetail(({"speere"}), 
        "Die Speere ruhen griffbereit in den Haenden der Wachen.");
    AddDetail("brustpanzer",
        "Brustpanzer aus poliertem Metall spiegeln das Licht.");
    AddDetail("gesichter",
        "Ernste Gesichter verraten, dass hier niemand Unfug duldet.");
    AddDetail("unfug",
        "Wer Unfug plant, wird blitzschnell zurechtgewiesen.");
    AddDetail("position",
        "Jeder Posten haelt seine Position, egal wie ruhig es wirkt.");
    AddDetail("waren",
        "Gewuerze, Tuchballen und feine Werkzeuge werden offen zur Schau gestellt.");
    AddDetail("schau",
        "Die Schau der Haendler lockt jedes Auge an.");
    AddDetail("tuchballen",
        "Tuchballen liegen ordentlich gestapelt an den Staenden.");
    AddDetail("tuecher",
        "Tuecher mit Symbolen flattern ueber den Auslagen.");
    AddDetail("gewuerzen",
        "Gewuerzen entströmt ein warmer Duft, der den ganzen Weg fuellt.");
    AddDetail(({"staende", "staenden"}),
        "Staende aus Holz und Leinwand bilden ein buntes Band entlang der Gasse.");
    AddDetail("band",
        "Das Band aus Staenden und Markisen wirkt wie ein kleines Fest.");
    AddDetail("leinwand",
        "Leinwanddaecher flattern leicht im Wind.");
    AddDetail("werkzeuge",
        "Werkzeuge aus Metall und Holz klappern in Ledertaschen der Handwerker.");
    AddDetail("metall",
        "Metallblitze huschen ueber Klingen und Haken in den Auslagen.");
    AddDetail("ledertaschen",
        "Ledertaschen schuetzen die Werkzeuge vor Staub.");
    AddDetail("laeden",
        "Laeden entlang der Gasse bieten dauerhafte Geschaefte an.");
    AddDetail("wohnungen",
        "Ueber den Laeden liegen helle Wohnungen mit kleinen Balkonen.");
    AddDetail("balkonen",
        "Von den Balkonen haengt frisch gewaschene Waeche.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "sueden",  ANSCHLUSS_KYRANDA );
    AddExit( "norden", ROOM "nordtor" );

//--Items & NPCs-----------------------------------------------------------

}
