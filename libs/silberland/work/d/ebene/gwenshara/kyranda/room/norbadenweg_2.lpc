#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Am Norbadenweg noerdlich von Kyranda");
    SetProp(P_INT_LONG,
        "Der Norbadenweg setzt sich hier noerdlich von Kyranda fort. Er macht "
        "hier eine Biegung nach Nordwesten und verlaeuft dann weiter aus dem "
        "Waeldchen hinaus auf das Gebirge zu. ");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

//--Details----------------------------------------------------------------

    AddDetail(({"norbadenweg"}),
        "Der Norbadenweg fuehrt hier als breite Biegung zwischen Kyranda und dem Gebirge hindurch.");
    AddDetail("abschnitt",
        "Dieser Abschnitt wirkt gepflegt, obwohl hier kaum jemand verweilt.");
    AddDetail("biegung",
        "Die Biegung verschluckt kurz den Blick zur Stadt.");
    AddDetail("blick",
        "Ein kurzer Blick ueber die Rillen zeigt Dir sogar die Dachspitzen Kyrandas.");
    AddDetail("dachspitzen",
        "Dachspitzen blitzen nur fuer einen Moment auf, bevor die Kurve sie verdeckt.");
    AddDetail("boden",
        "Der Boden ist festgestampft und von Wagenrillen durchzogen.");
    AddDetail("wagenrillen",
        "Wagenrillen ziehen sich wie dunkle Linien laengs des Weges.");
    AddDetail("rillen",
        "Rillen verlaufen in Paaren und lassen kaum neues Gras wachsen.");
    AddDetail("paare",
        "Paare von Rillen zeigen, dass hier meist Karren entlangfuhren.");
    AddDetail("gras",
        "Gras findet sich kaum zwischen den tiefen Rillen im Weg.");
    AddDetail("linien",
        "Linien aus eingedruecktem Erdreich zeugen von schwerer Last.");
    AddDetail("erdreich",
        "Erdreich wurde hier so oft zusammengedrueckt, dass es hart wie Stein wirkt.");
    AddDetail(({"stein","oberflaeche"}),
        "Steinharte Rillen erinnern daran, wie oft die Wagen hier rollten.");
    AddDetail("wagen",
        "Wagen polieren die Oberflaeche jedes Mal erneut.");
    AddDetail("mal",
        "Jedes Mal, wenn ein Wagen hier vorbeifuhr, wurde der Weg weiter verdichtet.");
    AddDetail("karren",
        "Karren muessen die Kurve langsam nehmen, damit sie nicht abrutschen.");
    AddDetail("last",
        "Last schwerer Wagen hat den Weg fast glatt poliert.");
    AddDetail(({"wegspuren","spuren","spur"}),
        "Wegspuren kreuzen diesen Abschnitt und fuehren weiter nach Suedosten.");
    AddDetail("weges",
        "Der Weges Verlauf bleibt trotz der Biegung immer gut sichtbar.");
    AddDetail("verlauf",
        "Der Verlauf folgt einer weiten Kurve, ehe er Richtung Gebirge strebt.");
    AddDetail("weg",
        "Der Weg wirkt gepflegt, obwohl fast niemand verweilt.");
    AddDetail("gebirge",
        "Das Gebirge erhebt sich westlich und wirft lange Schatten.");
    AddDetail("schatten",
        "Schatten des Gebirges reichen bis zur Mitte des Weges.");
    AddDetail("mitte",
        "In der Mitte des Weges haelt sich das Regenwasser am laengsten.");
    AddDetail("regenwasser",
        "Regenwasser bildet flaache Spiegel zwischen den Rillen.");
    AddDetail("spiegel",
        "Spiegel aus Wasser leuchten nur kurz auf, bevor sie versickern.");
    AddDetail("wasser",
        "Wasser sammelt sich in den tiefsten Rillen des Weges.");
    AddDetail("waeldchen",
        "Das Waeldchen oestlich des Weges wirkt dicht und geheimnisvoll.");
    AddDetail("wegweiser",
        "Ein Wegweiser zeigt Richtung Kyranda, das hinter der Biegung liegt.");
    AddDetail("moment",
        "Nur einen Moment lang siehst Du die Stadt, bevor die Kurve sie verbirgt.");
    AddDetail("kurve",
        "Die Kurve zwingt Karren, langsamer zu werden.");
    AddDetail("himmel",
        "Der Himmel ueber Dir ist weit offen und laesst Wolken schnell ziehen.");
    AddDetail("wolken",
        "Wolken treiben in langen Zuegen ueber den Norbadenweg.");
    AddDetail("zuegen",
        "Zuegen aus Wolken ziehen wie lautlose Karawanen ueber Dich hinweg.");
    AddDetail("karawanen",
        "Karawanen folgen dem Weg seit Generationen auf dem Weg nach Kyranda.");
    AddDetail("generationen",
        "Generationen haben diese Spur gepraegt.");
    AddDetail("kyranda",
        "Kyranda liegt in Suedosten; Wegspuren zeigen bis zur Stadt.");
    AddDetail("stadt",
        "Die Stadt selbst bleibt hinter der Biegung verborgen.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "suedosten",  ROOM "norbadenweg_1" );
    AddExit( "westen", ROOM "norbadenweg_3" );

//--Items & NPCs-----------------------------------------------------------
}
