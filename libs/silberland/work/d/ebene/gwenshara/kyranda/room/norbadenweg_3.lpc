#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Am Norbadenweg noerdlich von Kyranda");
    SetProp(P_INT_LONG,
        "Du befindest dich hier am Norbadenweg noerdlich von Kyranda. Der Weg "
        "fuehrt hier sehr gerade auf das Gebirge im Westen zu. Im Osten beginnt "
        "ein kleines Waeldchen. Ein Wegweiser steht verloren am Wegesrand.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

//--Details----------------------------------------------------------------

    AddDetail(({"norbadenweg", "weg"}),
        "Der Norbadenweg laeuft hier schnurgerade zwischen Gebirge und Waeldchen hindurch.");
    AddDetail("pfad",
        "Der Pfad zeigt kaum Abzweigungen, nur die Richtung westwaerts.");
    AddDetail("boden",
        "Der Boden ist fest und nur von wenigen Hufspuren aufgerissen; das Erdreich wirkt staubig.");
    AddDetail("staubschicht",
        "Eine duenne Staubschicht bedeckt alles, was nicht bewegt wird.");
    AddDetail("hufspuren",
        "Hufspuren verraten, dass Zugtiere die Strecke vor kurzem nutzten.");
    AddDetail("gebirge",
        "Das Gebirge im Westen wirkt, als blockierte es jeden weiteren Schritt.");
    AddDetail("schritt",
        "Jeder Schritt klingt dumpf auf dem trockenen Erdreich.");
    AddDetail("waeldchen",
        "Das Waeldchen im Osten raeumt kaum Platz fuer mehr als einen Wanderer.");
    AddDetail("platz",
        "Platz ist hier ein rares Gut; nur schmale Streifen bleiben frei.");
    AddDetail("wanderer",
        "Wanderer muessen der Reihe nach gehen, wenn sie das Waeldchen betreten.");
    AddDetail("wegweiser",
        "Der Wegweiser am Wegesrand verweist stur auf Kyranda.");
    AddDetail("weg",
        "Der Weg bleibt schnurgerade, als traue er sich nicht, eine Kurve zu wagen.");
    AddDetail("kurve",
        "Kurve gibt es hier kaum.");
    AddDetail("wegesrand",
        "Am Wegesrand liegt grober Kies, der den Pfad vom Hauptweg trennt.");
    AddDetail("kies",
        "Kies knirscht unter Deinen Stiefeln, sobald Du vom Hauptweg abweichst.");
    AddDetail("kanten",
        "Die Kanten des Weges halten Kies und Erdreich voneinander getrennt.");
    AddDetail("gras",
        "Gras wächst nur als schmale Streifen zwischen Kies und Boden.");
    AddDetail("kies",
        "Kies knirscht unter Deinen Stiefeln, sobald Du vom Hauptweg abweichst.");
    AddDetail("himmel",
        "Der Himmel spannt sich wolkenlos über den geraden Weg.");
    AddDetail("kyranda",
        "Kyranda liegt hinter Dir; nur das Wegeholz erinnert daran.");
    AddDetail("wegeholz",
        "Wegeholz, aus dem Wegweiser, zeigt nach Suedosten.");
    AddDetail("abzweigungen",
        "Abzweigungen suchst Du hier vergeblich; der Pfad bleibt gerade.");
    AddDetail("erdreich",
        "Erdreich liegt fest zusammengepresst unter einer duennen Staubschicht.");
    AddDetail("gut",
        "Gut an Platz bleibt zwischen Gebirge und Waeldchen kaum uebrig.");
    AddDetail("hauptweg",
        "Der Hauptweg bleibt trotz Kurve klar zu erkennen.");
    AddDetail("reihe",
        "In Reihe musst Du durchs Waeldchen, sonst bleibst Du haengen.");
    AddDetail("stiefeln",
        "Stiefeln hinterlassen kaum Spuren auf dem trockenen Boden.");
    AddDetail("spuren",
        "Spuren sind so flach, dass sie nur im schrägen Licht zu erkennen sind.");
    AddDetail("licht",
        "Licht faellt ungehindert auf den geraden Pfad.");
    AddDetail("strecke",
        "Die Strecke bis zum Gebirge scheint endlos geradeaus zu fuehren.");
    AddDetail("streifen",
        "Schmale Streifen aus Gras saeumen die Kanten des Weges.");
    AddDetail("zugtiere",
        "Zugtiere haben den Boden weich getreten und wieder verlassen.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "osten",  ROOM "norbadenweg_2" );
    AddExit( "westen", ROOM "norbadenweg_4" );

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "norbadenwolf", REFRESH_DESTRUCT);
}
