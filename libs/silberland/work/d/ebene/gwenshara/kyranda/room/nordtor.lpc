#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Das Nordtor von Kyranda");
    SetProp(P_INT_LONG,
        "Du stehst vor dem Nordtor der Stadt Kyranda. Massive Holztore, verstaerkt "
        "mit Eisenbaendern, ragen vor dir empor. Ueber dem Torbogen prangt das Wappen "
        "der Stadt. Am Tor werden Waegen und Reisende kontrolliert, die in die Stadt "
        "eintreten moechten. Eine missmutige Stadtwache beobachtet jeden Schritt mit "
        "undurchdringlichem Blick.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail(({"tor", "tore", "holztor", "torbogen", "nordtor"}),
        "Die Holztore sind mit dunklen Eisenbaendern verstaerkt. Jeder Daumenbreit "
        "wirken sie, als wuerden sie selbst einem Rammbock spottend widerstehen, denn "
        "das Nordtor ist der wichtigste Zugang fuer Karawanen.");
    AddDetail("herz",
        "Im Herzen der Torfluegel sitzt ein massiver Kern aus Harz-getraenktem Holz.");
    AddDetail("holz",
        "Das Holz der Torfluegel ist dunkel gealtert und wirkt dennoch frisch geoelt.");
    AddDetail("harz",
        "Ein leichter Harzduft steigt aus den Falzen auf.");
    AddDetail("daumenbreit",
        "Selbst ein einzelner Daumenbreit Holz wirkt hier so solide wie eine ganze Wand.");
    AddDetail(({"eisenbaendern", "rammbock"}),
        "Die Eisenbaendern sind doppelt genietet, sodass selbst ein Rammbock kaum Erfolg haette.");
    AddDetail("bohlen",
        "Dicke Bohlen bilden das Herz des Tores und duften leicht nach Harz.");
    AddDetail("erfolg",
        "Erfolg haette hier nur, wer zuerst die Torwachen ueberzeugt.");
    AddDetail(({"wappen", "wappen der stadt"}),
        "Das Wappen Kyrandas zeigt ein stilisiertes Stadttor vor der aufgehenden Sonne "
        "und wirkt frisch poliert.");
    AddDetail("licht",
        "Licht glaenzt auf dem Wappen und laesst es über allem schweben.");
    AddDetail(({"wache", "stadtwache", "soldat"}),
        "Die Stadtwache steht missmutig neben dem Tor und mustert Reisende nach allen "
        "Regeln der Kunst. Offenkundig ist sie nicht in Plauderlaune.");
    AddDetail("regeln",
        "Hier werden Regeln ohne Ausnahme durchgesetzt.");
    AddDetail("ausnahme",
        "Eine Ausnahme gibt es nur mit hoechst offizieller Genehmigung.");
    AddDetail("genehmigung",
        "Die Genehmigung muss mit Siegel und Unterschrift vorgezeigt werden.");
    AddDetail("kunst",
        "Mit Kunst sind hier die strengen Protokolle der Torwachen gemeint.");
    AddDetail("protokolle",
        "Die Protokolle geben vor, welche Fragen wann gestellt werden.");
    AddDetail("torwachen",
        "Torwachen arbeiten in Paaren und wechseln nur auf Befehl.");
    AddDetail("paaren",
        "Immer zwei Wachen decken gegenseitig die Ruecken.");
    AddDetail("plauderlaune",
        "Wer auf Plauderlaune hofft, wird vom grimmigen Blick der Wache ernuechtert.");
    AddDetail("fragen",
        "Fragen nach Herkunft, Waren und Zweck gehoeren zum taeglichen Ritual.");
    AddDetail("herkunft",
        "Die Herkunft jedes Reisenden wird in ein dickes Register eingetragen.");
    AddDetail("zweck",
        "Auch der Zweck der Reise muss genau benannt werden.");
    AddDetail("fragen",
        "Die Fragen der Wachen drehen sich um Herkunft, Waren und Zweck.");
    AddDetail(({"boden", "tritt", "schritt"}),
        "Der Boden ist festgestampft, jeder Schritt klingt dumpf gegen die Torfluegel "
        "und zeigt Spuren unzaehliger Fuhrwerke.");
    AddDetail("pflaster",
        "Pflastersteine wurden so oft erneuert, dass sie wie in Schichten liegen.");
    AddDetail("gestein",
        "Grobes Gestein aus dem Gebirge schuetzt den Boden vor tieferer Erosion.");
    AddDetail("torfluegel",
        "Die Torfluegel bestehen aus dicken Bohlen und bewegen sich erstaunlich leise.");
    AddDetail("spuren",
        "Spuren von Tieren, Stiefeln und Wagenraedern ueberziehen den Boden.");
    AddDetail("furchen",
        "Furchen schneiden sich tief in den Boden, wo Wagen ewig warten.");
    AddDetail("rillen",
        "Rillen verlaufen parallel und zeigen, wie oft Zugochsen hier hielten.");
    AddDetail("stiefeln",
        "Stiefeln knirschen uebers Gestein und lassen kleine Rillen zurueck.");
    AddDetail("wagenraedern",
        "Wagenraedern haben tiefe, parallele Furchen ins Pflaster geschliffen.");
    AddDetail("tieren",
        "Tieren wie Zugochsen ruhen hier kurz, bevor sie weiter nach Kyranda ziehen.");
    AddDetail("fuhrwerke",
        "Fuhrwerke aus dem Norden warten gezuegelt, bis sie an der Reihe sind.");
    AddDetail("fuhre",
        "Jede Fuhre wird von den Wachen gesondert kontrolliert.");
    AddDetail("wagen",
        "Wagen stehen dicht gestaffelt bis weit auf den Weg hinaus.");
    AddDetail("bordwaenden",
        "Die Bordwaenden zeigen Kerben und Brandzeichen frueherer Karawanen.");
    AddDetail(({"reisende", "waegen"}),
        "Reisende und Waegen werden einzeln angehalten und befragt, bevor sie eintreten "
        "duerfen. Die Fuhrwerke tragen Waren aus dem Norden, waehrend die Reisenden ihre "
        "Papiere bereithalten.");
    AddDetail("papiere",
        "Ohne saubere Papiere bleibt das Tor verschlossen.");
    AddDetail("unterschrift",
        "Ohne die Unterschrift eines Beamten bewegt sich kein Wagen.");
    AddDetail("besucher",
        "Besucher aus allen Regionen versuchen hier ihr Glueck.");
    AddDetail("glueck",
        "Wer Glueck hat, findet eine gnaedige Wache und wenig Wartezeit.");
    AddDetail("waren",
        "Waren wie Felle, Salz und Metallbarren füllen die Wagenkaesten.");
    AddDetail("felle",
        "Felle aus dem Norden haengen ueber den Bordwaenden zum Auswettern.");
    AddDetail("auswettern",
        "Beim Auswettern trocknen die Haendler ihre Felle kurz im Torwind.");
    AddDetail("salz",
        "Salz knirscht in Saecken und wird mit Sorgfalt geprueft.");
    AddDetail("saecken",
        "Saecken tragen die Siegel der Zollmeister.");
    AddDetail("sorgfalt",
        "Mit Sorgfalt werden die Saecke versiegelt und gelistet.");
    AddDetail("siegel",
        "Siegel aus rotem Wachs zerbroeckeln, wenn jemand sie bricht.");
    AddDetail("metallbarren",
        "Metallbarren liegen ordentlich geschichtet und blitzen im Licht.");
    AddDetail("wagenkaesten",
        "Wagenkaesten sind mit Planen abgedeckt, damit nichts verloren geht.");
    AddDetail("planen",
        "Planen knistern im Wind und schuetzen die Fracht.");
    AddDetail("karawanen",
        "Karawanen bilden lange Schlangen, bis jede Fuhre kontrolliert ist.");
    AddDetail("schlangen",
        "Schlangen aus Wagen ziehen sich bis weit auf den Weg hinaus.");
    AddDetail("reihe",
        "Reihe um Reihe ruft der Wachoffizier die naechsten Wagen vor.");
    AddDetail("wachoffizier",
        "Der Wachoffizier kontrolliert die Listen und entscheidet, wer passieren darf.");
    AddDetail(({"stadt", "kyranda", "stadttor"}),
        "Das Stadttor markiert den Uebergang in die wohlhabende Stadt Kyranda.");
    AddDetail("weg",
        "Der Weg fuehrt schnurgerade ueber die Ebene und endet an diesem Tor.");
    AddDetail("uebergang",
        "Der Uebergang von der Ebene zur Stadt fuehlt sich hier deutlich an.");
    AddDetail("ebene",
        "Hinter Dir breitet sich die offene Ebene aus.");
    AddDetail("blick",
        "Der Blick der Wache ist so geschaerft, dass sich niemand unbeobachtet fuehlt.");
    AddDetail(({"himmel", "sonne"}),
        "Der Himmel spannt sich weit ueber dem Tor, und die Sonne glaenzt auf den Eisenbaendern.");
    AddDetail("mauer",
        "Die Mauer schliesst direkt an das Tor an und setzt den Schutz der Stadt fort.");
    AddDetail("schutz",
        "Schutz verspricht hier vor allem die massive Steinarchitektur.");
    AddDetail("wand",
        "Die Wand aus Stein ist von Patina ueberzogen und zeigt alte Wappenschilde.");
    AddDetail("stein",
        "Steinquader liegen fugenlos aufeinander.");
    AddDetail("steinarchitektur",
        "Die Steinarchitektur wirkt gleichermaßen streng wie elegant.");
    AddDetail("patina",
        "Patina laesst die Steine alt und respekteinflössend wirken.");
    AddDetail("wappenschilde",
        "Wappenschilde der Stadtherren prangen ueber dem Torbogen.");
    AddDetail("stadtherren",
        "Die Stadtherren ehren hier ihre Linie mit prunkvollen Schilden.");
    AddDetail("schritt",
        "Jeder Schritt hallt zwischen Torfluegel und Mauer wider.");
    AddDetail("torwachen",
        "Torwachen stehen in Paaren und lassen niemanden unkontrolliert hinein.");
    AddDetail("zugang",
        "Der Zugang zur Stadt bleibt nur fuer gepruefte Besucher offen.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "sueden",  ROOM "gasse" );
    AddExit( "norden", ROOM "norbadenweg_1" );

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "nordtorwache", REFRESH_DESTRUCT);
}
