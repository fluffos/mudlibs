#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Am Norbadenweg noerdlich von Kyranda");
    SetProp(P_INT_LONG,
        "Hier endet, oder beginnt, der Norbadenweg noerdlich von Kyranda. Der "
        "Weg fuehrt geradewegs nach Sueden zum Nordtor der Stadt. Nichts als "
        "Wald ist hier zu sehen. Tiefe Furchen im Boden zeugen davon, dass dieser "
        "Weg von schweren Fuhrwerken benutzt wird.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

//--Details----------------------------------------------------------------

    AddDetail(({"weg", "norbadenweg", "pfad"}),
        "Der Norbadenweg ist von tiefen Karrenfurchen durchzogen und zeigt die Spuren "
        "zahlloser reisender Wagenburgen, die hier ihren Weg zur Stadt fanden.");
    AddDetail("karren",
        "Breit bereifte Karren muessen hier oft rangiert haben, denn ihre Spuren ueberlagern sich.");
    AddDetail("wegspuren",
        "Wegspuren ziehen sich wie dunkle Linien von der Trasse bis zum Waldsaum.");
    AddDetail("trasse",
        "Die Trasse wirkt wie eine schmale Lichtung, die durch den Wald geschnitten wurde.");
    AddDetail("lichtung",
        "Diese Lichtung eroeffnet sich ploetzlich im Wald und gibt den Blick Richtung Kyranda frei.");
    AddDetail("wegrand",
        "Am Wegrand liegen Steinen, die wohl einst als Sitz zum Rasten dienten.");
    AddDetail("stelle",
        "Diese Stelle war lange Rastplatz fuer durchziehende Sippen.");
    AddDetail("boden",
        "Der Boden ist hart festgestampft und von Wagenrillen uebersaet.");
    AddDetail(({"fuhrwerken", "fuhrwerke"}),
        "Fuhrwerken sieht man noch an, dass sie hier im Schlamm haengen blieben.");
    AddDetail(({"wald", "baeume"}),
        "Der Wald rueckt so dicht an den Weg heran, dass Zweige gelegentlich das "
        "Gesicht streifen. Zwischen den Staemmen erkennt man alte Feuerstellen.");
    AddDetail("zweige",
        "Zweige peitschen sanft ueber Deine Schultern und streifen Regenwasser ab.");
    AddDetail("schultern",
        "Schultern bleiben selten trocken, wenn man sich an den Baeumen vorbei drueckt.");
    AddDetail("gesicht",
        "Der Duft von Moos begleitet Dein Gesicht nach jedem Streifzug.");
    AddDetail("streifzug",
        "Ein Streifzug zwischen den Staemmen fuehlt sich wie ein Ausflug in vergangene Rastplaetze an.");
    AddDetail("staemmen",
        "Staemmen stehen dicht neben der Trasse und scheinen den Weg zu bewachen.");
    AddDetail("feuerstellen",
        "Feuerstellen aus Steinen und Asche erinnern an Rastplaetze vergangener Wagenburgen.");
    AddDetail("asche",
        "Asche bedeckt die Mitte der Steinkreise in duennen Schichten.");
    AddDetail("moos",
        "Moos bedeckt Steinen und haelt Feuchtigkeit wie ein gruener Schwamm.");
    AddDetail("duft",
        "Ein erdiger Duft steigt von den feuchten Wurzeln und Rußspuren auf.");
    AddDetail("steinen",
        "Steinen liegen im Kreis, vielleicht um Kesseln und Sitze zu tragen.");
    AddDetail("rastplaetze",
        "Rastplaetze erkennt man an den kreisrunden Mustern im Gras.");
    AddDetail(({"furchen", "karrenfurchen"}),
        "Schwere Raeder haben tiefe Rillen hinterlassen, in denen sich Regenwasser "
        "sammelt und den Boden schimmern laesst. Die Spuren der Fuhrwerke ziehen "
        "sich schnurgerade zum Nordtor.");
    AddDetail(({"raeder"}),
        "Die Raeder sind so breit, dass die Fuhrwerke kaum vom Kurs abkommen konnten.");
    AddDetail("kurs",
        "Der Kurs Richtung Stadt ist unuebersehbar: immer entlang der doppelten Furchen.");
    AddDetail("regenwasser",
        "Regenwasser glaenzt in den Rillen und spiegelt den Himmel.");
    AddDetail("rillen",
        "Die Rillen fuehren wie kleine Kanaele das Wasser ab.");
    AddDetail("kanaele",
        "Wie Kanaele verlaeuft das Wasser entlang der Rillen bis in den Wald.");
    AddDetail("spuren",
        "Spuren von Fuhrwerken und wandernden Norbaden ueberschneiden sich am Wegrand.");
    AddDetail("wagenrillen",
        "Wagenrillen bilden ein Muster aus parallelen Linien im Schlamm.");
    AddDetail("schlamm",
        "Schlamm haftet an Stiefeln und trocknet zu festen Schollen.");
    AddDetail("wasser",
        "Wasser sammelt sich in den tiefsten Mulden und fließt nur langsam ab.");
    AddDetail(({"norbaden", "reisende"}),
        "Norbaden ziehen in Sippen durch das Land, handeln, musizieren und kennen "
        "unzige Geschichten ueber ferne Orte. Wagenburgen nutzen diese Stelle gern als Rast.");
    AddDetail("wagenburgen",
        "Wagenburgen stellen ihre Karren hier im Kreis, um Wind und Tiere fernzuhalten.");
    AddDetail("kreis",
        "Der Kreis aus Wagen hinterlaesst deutliche Abdruecke im Boden.");
    AddDetail("wind",
        "Wind pfeift vom Norden her ueber die Lichtung und wirbelt Staub auf.");
    AddDetail("tiere",
        "Tiere wie Hirsche oder Wildschweine meiden die rußigen Feuerstellen.");
    AddDetail("sippen",
        "Sippen reisen in dichten Gruppen, damit niemand die Rast stoert.");
    AddDetail("land",
        "Das Land hier ist frei von Mauern und laesst ausreichend Raum fuer Karren.");
    AddDetail("geschichten",
        "Geschichten ueber ferne Orte wechseln schneller den Besitzer als Waren.");
    AddDetail("orte",
        "Orte wie Midas oder Tijara dienen als Vergleich fuer Preise und Abenteuer.");
    AddDetail("rast",
        "Eine Rast an dieser Stelle bedeutet Sicherheit und Austausch mit anderen Reisenden.");
    AddDetail("himmel",
        "Der Himmel spannt sich offen ueber der Lichtung und laesst Wolken rasch ziehen.");
    AddDetail("wolken",
        "Wolken reissen immer wieder auf und schicken Lichtflecken ueber den Weg.");
    AddDetail("kyranda",
        "Hinter dem Nordtor beginnt die Stadt Kyranda, deren Dachspitzen Du von hier erahnen kannst.");
    AddDetail("dachspitzen",
        "Dachspitzen blitzen ueber den Baumwipfeln und verraten die Naehe der Stadt.");
    AddDetail("nordtor",
        "Das Nordtor blinkt in der Ferne, bewacht von wachsamen Augen.");
    AddDetail("augen",
        "Unsichtbare Augen scheinen jeden Wagen zu zaehlen, der sich naehert.");
    AddDetail("stadt",
        "Die Stadt wirkt aus dieser Entfernung ruhig, doch die Wegspuren verraten regen Verkehr.");
    AddDetail("verkehr",
        "Verkehr zwischen Kyranda und dem Norden reisst hier nie ab.");
    AddDetail("ferne",
        "In der Ferne verschwimmen Himmel und Waldsaum zu einem hellen Band.");
    AddDetail("entfernung",
        "Die Entfernung taeuscht: vom Tor her weht bereits gedämpfter Laerm.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "sueden",  ROOM "nordtor" );
    AddExit( "nordwesten", ROOM "norbadenweg_2" );

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "norbade", REFRESH_DESTRUCT);
}
