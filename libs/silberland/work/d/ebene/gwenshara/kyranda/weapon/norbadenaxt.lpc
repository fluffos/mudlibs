#include "../def.h"

inherit "std/weapon";

void create()
{
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine Norbadenaxt");
    SetProp(P_LONG,
        "Die breite Klinge dieser Norbadenaxt wurde mit filigranen Gravuren"
        " versehen und spiegelt sorgfaeltige Pflege. Ein dunkler Lederschaft"
        " sorgt fuer sicheren Halt, waehrend messingene Ringe das Holz"
        " verstaerken.");
    SetProp(P_NAME, "Norbadenaxt");
    SetProp(P_GENDER, FEMALE);
    AddId(({"norbadenaxt", "axt", "kampfbeil"}));
    AddAdjective(({"norbadische", "breite", "gravierte"}));

    SetProp(P_VALUE, 1800);
    SetProp(P_WEIGHT, 2500);
    SetProp(P_MATERIAL, ([ MAT_IRON:80, MAT_WOOD:20 ]));

    SetProp(P_WEAPON_TYPE, WT_AXE);
    SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}));
    SetProp(P_NR_HANDS, 2);
    SetProp(P_WC, 210);
    SetProp(P_WC_FIX, 40);
}
