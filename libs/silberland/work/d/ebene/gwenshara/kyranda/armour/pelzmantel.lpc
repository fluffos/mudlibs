#include "../def.h"

inherit "std/armour";

void create()
{
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein dicker Pelzmantel");
    SetProp(P_LONG,
        "Der voluminose Mantel ist aus dunklen Fellen gearbeitet und innen"
        " mit weichem Leder gefuettert. Breite Schultern und eine tiefe Kapuze"
        " schuetzen selbst bei nordischen Wintern vor Kaelte.");
    SetProp(P_NAME, "Pelzmantel");
    SetProp(P_GENDER, MALE);
    AddId(({"pelz", "mantel", "pelzmantel"}));
    SetProp(P_NAME_ADJ, ({"dick"}));
    AddAdjective(({"dicken", "dicker", "dickem", "dicke", "dickes"}));

    SetProp(P_WEIGHT, 3200);
    SetProp(P_VALUE, 1600);
    SetProp(P_MATERIAL, ([ MAT_LEATHER:60, MAT_FUR:40 ]));

    SetProp(P_ARMOUR_TYPE, AT_CLOAK);
    SetProp(P_AC, 8);
    SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
    SetProp(P_WORN_TEXT, "traegt");
    SetProp(P_WEAR_TEXT, ({"Du schlaengst Dir den dicken Pelzmantel um.\n",
                           " huellt sich in einen dicken Pelzmantel.\n"}));
    SetProp(P_UNWEAR_TEXT, ({"Du legst den schweren Mantel ab.\n",
                             " legt einen dicken Pelzmantel ab.\n"}));
    SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:8, T_HEAT_PROT:-4]));
}
