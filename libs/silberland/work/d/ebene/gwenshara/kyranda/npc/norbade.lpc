#include "../def.h"

inherit "std/mnpc";

void create()
{
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein Norbade auf Reisen");
    SetProp(P_LONG,
        "Der dunkelgebaeunte Norbade traegt sein Haar als glatte, rasierte"
        " Platte, waehrend ein beeindruckender Schnauzbart jede Regung seines"
        " Gesichts betont. Ein dicker Pelzmantel liegt schwer auf seinen"
        " Schultern, und eine verzierte Norbadenaxt haengt griffbereit an"
        " seinem Ledergurt.");
    SetProp(P_NAME, "Norbadischer Reisender");
    SetProp(P_GENDER, MALE);
    AddId(({"norbade", "reisender", "norbader", "haendler"}));
    AddAdjective(({"reisender", "dunkelhaeutiger", "norbaden"}));
    AddClass(CL_HUMAN);

    create_default_npc(24);
    SetProp(P_RACE, "Mensch");
    SetProp(P_SIZE, 190);
    SetProp(P_ALIGN, 150);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HANDS, ({" mit schweren Faustschlaegen", QueryProp(P_HANDS)[1], DT_BLUDGEON}));
    SetProp(P_WIMPY, 0);

    SetProp(P_MSGIN, "kommt den Weg entlang");
    SetProp(P_MSGOUT, "zieht den Norbadenweg entlang");

    SetChats(4, ({
        "Der Norbade summt eine sehnsuechtige Weise ueber wandernde Sippen.\n",
        "Der Norbade lacht kurz auf und zwirbelt seinen maechtigen Schnauzbart.\n",
        "Der Norbade schultert den Pelzmantel und blickt nach neuen Geschaeften aus.\n",
        "Der Norbade sagt: 'Kein Lager ist so frei wie das unserer Wagen.'.\n"
    }));

    SetAttackChats(3, ({
        "Der Norbade knurrt: 'Ich wollte heute eigentlich handeln, nicht kaempfen!'.\n",
        "Der Norbade pariert geschickt und laesst seinen Bart triumphierend flattern.\n"
    }));

    SetProp(P_SPELLRATE, 25);
    AddSpell(4, 250,
        Name(WER,1)+" schwingt die Norbadenaxt in weitem Bogen auf Dich nieder!\n",
        Name(WER,1)+" schwingt die Norbadenaxt auf @WEN nieder!\n",
        DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
    AddSpell(2, 270,
        Name(WER,1)+" rammt Dir den Schaft der Axt gegen die Rippen!\n",
        Name(WER,1)+" rammt @WEM den Axtschaft gegen die Rippen!\n",
        DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

    AddDetail(({"bart", "schnauzbart"}),
        "Der Bart ist zu verzierten Spitzen gewaetzt und komplettiert das stolze"
        " Auftreten des Norbaden.");
    AddDetail(({"kopf", "haare"}),
        "Die Kopfhaut ist sauber rasiert und spiegelt das Sonnenlicht.");

    AddInfo(({"norbaden", "norbade", "wagen"}),
        "Wir ziehen in Wagenburgen durchs Land, handeln und feiern unterm Sternenzelt.\n",
        "erklaert: ");
    AddInfo(({"pelzmantel", "axt"}),
        "Die Pelze halten sogar den Nordwind fern, und eine Norbadenaxt ist Handel"
        " und Schutz zugleich.\n",
        "erzaehlt: ");
    AddInfo(({"das schwarze auge", "rollenspiel"}),
        "Hast Du nie von unseren Legenden gehoert? In Aventurien kennt jedes Kind"
        " die Geschichten der Norbaden.\n",
        "meint: ");

    SetProp(P_MNPC_AREA, ({ ROOM "norbadenweg_", ROOM "nordtor" }));
    SetProp(P_MNPC_WAIT, ({ 20, 35, 20 }));
    SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_OUTDOORS | MOV_BACKWARDS);
    SetProp(P_MNPC_DEFAULTROOM, ROOM "norbadenweg_1");

    SUID;
    CLONEME(WEAPON "norbadenaxt");
    command("zuecke axt");
    CLONEME(ARMOUR "pelzmantel");
    command("trage pelzmantel");
}
