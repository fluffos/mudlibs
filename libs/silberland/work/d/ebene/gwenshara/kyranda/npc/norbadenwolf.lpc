#include "../def.h"

inherit "std/mnpc";

void create()
{
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein lauernder Wolf");
    SetProp(P_LONG,
        "Der graue Wolf zieht mit flachem Schritt am Norbadenweg entlang. Sein Fell"
        " ist von Staub und Schlamm verfilzt, doch die Augen funkeln wachsam."
        " Immer wieder hebt er die Schnauze und prueft den Wind nach fremden Geruechen.");
    SetProp(P_NAME, "Wolf");
    SetProp(P_GENDER, MALE);
    AddId(({"wolf", "raubtier", "norbadenwolf"}));

    create_default_npc(10);
    SetProp(P_RACE, "Wolf");
    SetProp(P_SIZE, 80);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HANDS, ({" mit reissenden Zaehnen", QueryProp(P_HANDS)[1], DT_PIERCE}));
    SetProp(P_WIMPY, 0);

    SetChats(3, ({
        "Der Wolf schnaubt und stuetzt die Pfoten in den schlammigen Weg.\n",
        "Der Wolf hebt den Kopf, spaeht zur Stadt und heult kurz auf.\n",
        "Der Wolf zieht Kreise am Wegrand und schnuppert an vergessenen Buendeln.\n"
    }));

    SetProp(P_MNPC_AREA, ({ ROOM "norbadenweg_" }));
    SetProp(P_MNPC_WAIT, ({ 15, 25, 20 }));
    SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_OUTDOORS | MOV_BACKWARDS);
    SetProp(P_MNPC_DEFAULTROOM, ROOM "norbadenweg_3");

    SUID;
}
