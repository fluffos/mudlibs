#include "../def.h"

inherit "std/npc";

void create()
{
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine missmutige Stadtwache");
    SetProp(P_LONG,
        "Der Soldat der Stadt Kyranda mustert jeden, der sich dem Nordtor naehert,"
        " mit einem missmutigen Blick. Seine Ruestung sitzt ordentlich, doch"
        " der Traeger wirkt, als haette er seit Stunden keine Pause gehabt."
        " Eine scharfes Schwert in den Fingern, wartet er nur darauf, dass jemand"
        " einen Fehler macht.");
    SetProp(P_NAME, "Stadtwache von Kyranda");
    SetProp(P_GENDER, MALE);
    AddId(({"stadtwache", "wache", "wachposten", "soldat"}));
    AddClass(CL_HUMAN);

    create_default_npc(20);
    SetProp(P_RACE, "Mensch");
    SetProp(P_SIZE, 185);
    SetProp(P_ALIGN, 200);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_WIMPY, 0);
    SetProp(P_HANDS, ({" mit seinen Faeusten", QueryProp(P_HANDS)[1] + 10, DT_BLUDGEON}));

    SetChats(3, ({
        "Die Stadtwache knurrt: 'Immer diese Reisenden...'.\n",
        "Die Stadtwache mustert Dich argwoehnisch und grummelt etwas Unfreundliches.\n",
        "Die Stadtwache klopft ungeduldig mit dem Speerschaft auf die Steine.\n"
    }));

    SetAttackChats(4, ({
        "Die Stadtwache faucht: 'Du haettest einfach weiterziehen sollen!'.\n",
        "Die Stadtwache knurrt kampfbereit und stoesst nach Dir.\n"
    }));

    AddInfo(DEFAULT_INFO,
        "brummt: 'Keine Geschichten, ich habe hier Dienst am Nordtor.'.\n");

    SUID;
    CLONEME("/p/weapon/sword/kurzschwert");
    command("zuecke schwert");
}
