#include <properties.h>
#include <language.h>
#include "../files.h"

#include <defines.h>
#include <moredef.h>

mixed saveload;

nosave mapping obs;

#define CHANNELD "p/daemon/channeld"
#define AUCSTORE "d/ebene/creative/feldlager/room/aucstore"

create()
{
  if (is_clone(this_object())) {
    destruct(this_object());
    return;
  }
  SUID;
  obs=([ ]);
  if (last_reboot_time()<file_time(LOG("auc_obs.o")))
    if (restore_object(LOG("auc_obs")))
      obs=saveload;
  saveload=0;
}

string name()
{
  return "Sensal Bodenstab";
}
  

int query_pending(string who)
{
  if (member(obs, who))
    return sizeof(obs[who])>0;
  else
    return 0;
}

void insert_ob(string ob, string customer)
{
  string *c_ob;
  
  if (query_pending(customer)) {
    c_ob=obs[customer];
    c_ob+=({ ob });
    obs[customer]=c_ob;
  }
  else {
    c_ob=({ ob });
    obs+=([ customer: c_ob ]);
  }
  saveload=obs;
  save_object(LOG("auc_obs"));
  saveload=0;
  return;
}

void remove_ob(string ob, string customer)
{
  int i;
  string *c_ob;

  if (!query_pending(customer))
    return;
  c_ob=obs[customer];
  if (member(c_ob, ob)>-1) {
    c_ob-=({ob});
    obs[customer]=c_ob;
  }
  saveload=obs;
  save_object(LOG("auc_obs"));
  saveload=0;
  return;
}

string get_ob(string customer)
{
  string ret;

  if (!query_pending(customer))
    return "";
  ret=obs[customer][0];
  remove_ob(ret, customer);
  return ret;
}

query_prevent_shadow() { return 1; }


void Channel(string str)
{
  CHANNELD->join("Auktion", this_object());
  CHANNELD->send("Auktion", this_object(), str, MSG_SAY);
  return;
}

