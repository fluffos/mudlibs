#include <language.h>
#include <properties.h>
#include "../files.h"
#include <material.h>
#include "../std/drink.h" 

inherit PATH+"std/drink";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_NAME, "Heiltrank");
  SetProp(P_SHORT, "Hannelores Wunderheiltrank");
  SetProp(P_GENDER, MALE);
  SetProp(P_LONG, BS("Das ist der Wunderheiltrank von Hannelore, der Wirtin."));
  SetProp(P_INFO, BS("Mit ihm kannst Du Dich voellig aufheilen."));

  SetProp(P_DRINK_INFO, ([ F_HEAL: ({ 250, 0 }), F_SOAK:10, F_ALCOHOL:0, F_POISON:0 ]));
  AddId("trank");
  AddId("heiltrank");
  AddId("wunderheiltrank");
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 100);
}

BeimTrinken()
{
  say(TPN+" trinkt Hannelores Wunderheiltrank.\n");
  write("Du kippst den Wunderheiltrank gierig in Dich hinein.\n");
}

