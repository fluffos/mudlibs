/*
  Urne
*/

inherit "/std/thing";
inherit "/std/more";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../ivory_tiger/quest.h"

int yari;

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  AddId("urne");
  SetProp(P_NAME, "Urne");
  SetProp(P_NOGET, "Die Urne steht fest am Boden, wie einzementiert.\n");
  SetProp(P_SHORT, "Eine Urne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LONG, 
          "Du siehst eine Urne, die wie einzementiert am Boden steht."
         +" Du kannst versuchen, in sie hineinzugreifen.");
  AddCmd(({"greif", "greife"}), "greif");
  yari=1;
}


int greif(string str)
{
  string s;
  object o;
  object quest_ob;
  
  notify_fail("Wo hinein moechtest Du greifen?\n");
  if (!str || str!="in urne") {
    return 0;
  }
  say(TPN+" wuehlt in einer Urne herum.\n");
  write("Du greifst in die Urne, wuehlst ein wenig herum und...\n");
  if (random(100)>90) {
    write("Autsch! Da scheint Dich etwas gezwickt zu haben.\n");
    TP->do_damage(random(10));
  }
  quest_ob=present(IV_QUEST_ITEM, TP);
  if (yari || (quest_ob && !quest_ob->check_flag(IV_GET_YARI) )) {
    write("Du ertastet etwas und steckst es sofort ein.\n");
    o=clone_object(OBJ("yari"));
    o->move(TP, M_GET);
    if(quest_ob) {
      o->AddId(IV_QUEST_YARI);
      quest_ob->set_flag(IV_GET_YARI);
    }
    yari=0;
  }
  else
    write("Du ertastest in der Urne leider nichts wesentliches.\n");
  return 1;
}

void reset()
{
  ::reset();
  //yari=random(2);
  yari=1;
}

