#include <properties.h>
#include <language.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_NAME, "Gaensebluemchen");
  SetProp(P_SHORT, "Ein Gaensebluemchen");
  SetProp(P_LONG, "Ein zierliches Gaensebluemchen.\n");
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  AddId(({"bluemchen", "gaensebluemchen", "blume", "\nblume"}));
  SetProp(P_GENDER, NEUTER);
  AddAdjective("zierlichies");
}

