#include <container.h>
#include <properties.h>
#include <material.h>
#include <moving.h>
#include "../files.h"

inherit STD("behaelter");
inherit "std/player/moneyhandler";

#define TRANK_ITEMS ({ OBJ("wurz"), OBJ("pulver"), OBJ("haar"), \
            OBJ("haut"), OBJ("minze"), OBJ("euter"), OBJ("feder"), \
	    OBJ("zweig") })

object last_sedda = 0;

void restart_items();

void create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Eine Truhe aus Metall");
  SetProp(P_MATERIAL, MAT_METAL);
  SetProp(P_NAME, "Truhe");
  AddId("truhe");

  SetProp(P_NOGET, BS(
          "Die Truhe ist nicht einfach so zum Wegnehmen."));
  SetProp(P_LONG, BS(
          "In dieser Truhe bewahrt Sedda ihre besonderen Utensilien auf. Du kannst das Wort \"Heiltrank\" entziffern."));
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp(P_GENDER, FEMALE);
  SetKey("\nseddakey");
  // restart_items();
  // SetZu();
}

void init()
{
  ::init();
  if (TP->id("sedda") && (last_sedda != TP))
  {
    restart_items();
    last_sedda = TP;
  }
}

int QueryAllowed()
{
  object ob;
  if (ob = present("\nseddakey", this_player()))
  {
    ob->remove();
    write(BS("Der Schluessel zerfaellt zu Staub."));
  }
  return 1;
}

void restart_items()
{
  string *items;
  object m;
  int i, t;

  items=TRANK_ITEMS;
  for (t=0; t<3; t++) {
    i=random(sizeof(items));
    clone_object(items[i])->move(TO, M_SILENT|M_NOCHECK);
    items-=({items[i]});
  }
  AddMoney(random(100)+10);
  if (!random(15)) {
    // Super, wer brauchtn den doofen printf() ?  [woody, 2005-05-12]
    // printf("Hurra!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n");
    "/obj/gemmaster"->DistributeGem(1, 35, 0, 1);
//    (m=clone_object(OBJ("gem")))->SetProp(P_AMOUNT, random(35)+1);
//    m->move(TO, M_SILENT|M_NOCHECK);
  }
  SetZu();
}

object query_last_sedda()
{
  return last_sedda;
}
