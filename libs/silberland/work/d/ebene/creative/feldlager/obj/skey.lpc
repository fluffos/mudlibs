#include <thing.h>
#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner silberner Schluessel");
  SetProp(P_NAME, "Schluessel");
  SetProp(P_LONG, BS(
          "Das ist wohl der Schluessel zu Seddas Truhe."));
  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 1);
  AddId(({"schluessel", "\nseddakey"}));
}
