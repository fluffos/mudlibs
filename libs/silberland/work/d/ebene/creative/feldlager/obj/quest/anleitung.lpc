#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../../quest.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Eine magische Anleitung");
  SetProp(P_LONG, BS(
          "Das ist eine magische Bauanleitung fuer Dein eigenes Zelt."
	 +" Du kannst sie lesen."));
  SetProp(P_NODROP, "Diese Bauanleitung wirft man nicht einfach weg.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 30);
  SetProp(P_INFO, BS(
          "Mit dieser magischen Bauanleitung laesst sich ein Zelt aufstellen."));
  SetProp(P_PHASE, MIN_P);
  SetProp(P_NAME, "Anleitung");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_READ_MSG, "@@anleitung@@");
  AddId("anleitung");
}

anleitung()
{
  string str;

  switch(QueryProp(P_PHASE)) {
    case 1: str=break_string(
      "\nWillkommen auf Deinem eigenen Bauplatz!\n \nWir haben dieses"
     +" Stueck Land extra fuer Dich reserviert, damit Du Dir darauf"
     +" ein eigenes Zelt bauen kannst.\nWir hoffen, dass Du viel Spass"
     +" dabei hast und wuenschen Dir alles Gute und viel Erfolg beim"
     +" Verwirklichen Deiner Plaene.\nDiese Anleitung wird Dir"
     +" dabei behilflich sein, Deine Aufgabe bestmoeglich zu"
     +" bewerkstelligen.\n \nDas erste, was Du tun musst, ist mit"
     +" Hilfe einer Gartenschere den ganzen Unrat, den"
     +" Du auf dem verwilderten Bauplatz vorfindest, zu beseitigen."
     +" So eine Gartenschere hat den Vorteil einer sehr scharfen Klinge"
     +" und liegt meist gut in der Hand. Du kannst also getrost die"
     +" Straeucher damit klein schneiden.\n ", 54, "   | ", 1); break;
    case 2: str=break_string(
      "\nGrossartig! Du hast also den Platz soweit hergerichtet, dass"
     +" keine Pflanzen mehr den Bau eines Zeltes stoeren. Jedoch gibt"
     +" es noch ein Problem:\n \nDa man gern einen ebenen Boden im"
     +" Zelt hat, waere es von Vorteil, den Untergrund hier zu planieren."
     +" Keine Angst, Du brauchst hierzu keine neumodischen Erfindungen"
     +" zu konstruieren, denn Du wirst in so manchem Laden das geeignete"
     +" Werkzeug finden.\n \nEin kleiner Tip: Versuch es doch einmal"
     +" mit einer Schaufel.\n ", 54, "   | ", 1); break;
    case 3: str=break_string(
      "\nJetzt ist schon richtig ein Fortschritt beim Bauen zu"
     +" erkennen. Bald schon wirst Du Dein eigenes Zelt haben."
     +" Doch bis dahin ist es noch ein weiter Weg.\n"
     +" \nDeine naechste Aufgabe ist es, eine geeignete Plane fuer"
     +" den Untergrund zu finden.\n \nAuch hier wieder ein kleiner"
     +" Tip von mir: Du bekommst ihn im Laden in Tijara.\n ", 54, "   | ", 1); break;
    case 4: str=break_string(
      "\nSieht schon richtig schoen aus, Deine Bauplatznachbarn"
     +" werden sicher gruen vor Neid. Du hast ja wirklich bald die"
     +" Haelfte der Aufgabe hinter Dir!\n \nDer naechste Schritt ist"
     +" es, die Zeltstangen fuer die Befestigung der Planen in den"
     +" Boden zu rammen. Dazu brauchst Du bestimmt einmal einen"
     +" Hammer, um die Stangen so gut wie moeglich im Boden zu"
     +" verankern, jedoch auch das geeignete Material fuer die Stangen"
     +" selber.\n \nDazu wieder ein Tip von mir: Besonders bewaehrt"
     +" haben sich in diesem Zusammenhang Fichtenstaemme.\nDie"
     +" richtige Sorte Fichten waechst meines Wissens im"
     +" Silberwald.\n ", 54, "   | ", 1); break;
    case 5: str=break_string(
      "\nAh, man kann schon die grobe Form des Zeltes erkennen."
     +" Das wird sicher das schoenste Zelt im ganzen Feldlager werden,"
     +" meinst Du nicht auch?\n \nDeine naechste Aufgabe ist es, die"
     +" Zeltplanen, die Du beim Klubhaus bekommst, mit den Stangen"
     +" gut zu verbinden, am besten mit Hilfe einer Schnur und einer"
     +" Naehnadel. Diese zu finden sollten kein grosses Problem"
     +" darstellen.\n \nAlso zuerst Planen zusammennaehen und dann"
     +" an den Stangen befestigen.\n ", 54, "   | ", 1); break;
    default: str=BS(
      "Diese Anleitung hat fuer Dich keinerlei Nutzen. Du hast sie"
     +" unrechtmaessig erworben, und damit ist sie einfach wertlos.");
  }
  str="   |\n   |   Bauanleitung, Phase "+QueryProp(P_PHASE)+":\n"
  "---+-----------------------------------------------------\n"+str;
  return str;
}

