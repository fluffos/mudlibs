#include <properties.h>
#include <material.h>
#include <language.h>
#include <material.h>
#include "../files.h"

inherit "std/unit";

#define GEMS ({ "Diamant", "Lapislazuli", "Rubin", "Saphir",  \
                  "Perle", "Opal", "Smaragd", "Tigerauge", \
		  "Aquamarin", "Blutstein" })
#define GEMSP ({ "Diamanten", "Lapislazuli", "Rubine", "Saphire", \
                   "Perlen", "Opale", "Smaragde", "Tigeraugen", \
		   "Aquamarine", "Blutsteine" })
#define GEMSG ({ MALE, MALE, MALE, MALE, FEMALE, MALE, MALE, NEUTER, \
                   MALE, MALE })
#define GEMVAL ({ 30, 10, 15, 20, 5, 25, 25, 10, 10, 5 })
#define NUMGEMS 10
#define MAXGEMS 30

create()
{
  int i;

  if (!is_clone(TO))
    return;
  ::create();

  i=random(NUMGEMS);
  SetProp(P_NAME, ({ GEMS[i], GEMSP[i] }) );
  SetProp(P_SHORT, "Edelstein");
  SetProp(P_MATERIAL, MAT_JEWEL);
  AddId("edelstein");
  AddPluralId("edelsteine");
  AddSingularId(lower_case(GEMS[i]));
  AddPluralId(lower_case(GEMSP[i]));
  SetProp(P_GENDER, GEMSG[i]);
  SetCoinsPerUnits(random(3)+1, GEMVAL[i]);
  SetGramsPerUnits(random(2)+1, 200-GEMVAL[i]*3);
}

