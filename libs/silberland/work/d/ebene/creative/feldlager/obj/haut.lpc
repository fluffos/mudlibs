#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Schlangenhaut");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 2);
  SetProp(P_SHORT, "Eine Schlangenhaut");
  SetProp(P_MATERIAL, MAT_SKIN);
  SetProp(P_LONG, "Das ist eine Schlangenhaut, also die Haut einer Schlange.");
  AddId(({"haut", "schlangenhaut", "\nshaut"}));
}
