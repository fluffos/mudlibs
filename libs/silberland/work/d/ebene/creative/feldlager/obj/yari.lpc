#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Yari");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_SHORT, "Ein Yari");
  SetProp(P_MATERIAL, MAT_MISC_SOLID);
  SetProp(P_LONG, 
          "Das ist ein Yari. Du stellst fest, dass es in etwa 30 Zentimeter"
         +" lang ist, rundlich und sehr stabil. Obwohl Du noch nie ein"
         +" Yari gesehen hast, weisst Du trotzdem, dass es sich hierbei"
         +" um ein Yari handelt.");
  AddId("yari");
  AddId("\nyariyari");
}
