#include <properties.h>
#include "../files.h"
#include <material.h>
#include <food.h>

inherit "std/unit";
inherit "std/food"; 

create()
{
  if (!is_clone(TO))
    return;
  unit::create();
  food::create( ({"trink", "trinke"}) );

  SetProp(P_NAME, ({"Heiltrank", "Heiltraenke"}) );
  SetProp(P_SHORT, "Hannelores Wunderheiltrank");
  SetProp(P_GENDER, MALE);
  SetProp(P_LONG, BS("Das ist der Wunderheiltrank von Hannelore, der Wirtin."));
  SetProp(P_INFO, BS("Mit ihm kannst Du Dich voellig aufheilen."));

  SetProp(P_FOOD_INFO, 
      ([ F_HEAL: ({ 250, 0 }), F_SOAK:10, F_ALCOHOL:0, F_POISON:0,
         F_MSG: "Du kippst den Wunderheiltrank gierig in Dich hinein.\n",
         F_MSG_ROOM: "trinkt Hannelores Wunderheiltrank.\n"]));
  AddId("\nhanneloretrank");
  AddSingularId( ({"trank","wunderheilheiltrank","heiltrank"}) );
  AddPluralId(  ({"traenke", "heiltraenke", "wunderheiltraenke"}) );
  SetCoinsPerUnits(10, 1);
  SetGramsPerUnits(20, 1);
}

