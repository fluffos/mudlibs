/*
  Anschlagtafel
*/

inherit "/std/thing";
inherit "/std/more";

#include "../files.h"
#include "../std/news.h"
#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO)) return;
  
  ::create();
  
  AddId("tafel");
  AddId("anschlagtafel");
  SetProp(P_NAME, "Tafel");
  SetProp(P_NOGET, "Die Tafel ist in den Boden gerammt.\n");
  AddCmd(({"les", "lies"}), "read");
}

short()
{
  return "Eine Anschlagtafel mit "+call_other(LNEWSD, "GetNewsNum")+" Nachricht"
        +(call_other(LNEWSD, "GetNewsNum")==1 ? "" : "en")+".\n";
}

long()
{
  mixed *n;
  string str;
  int i, j;
    
  if (i=call_other(LNEWSD, "GetNewsNum")) {
    n=call_other(LNEWSD, "GetNews");
    str="Derzeit vorhandene Nachrichten:\n";
    for (j=0; j<i; j++)
      str+=" "+sprintf("%2d",j+1)+". "+n[j][M_TITLE]+"\n";
  }
  else
    str="Derzeit keine vorhandenen Nachrichten.\n";

  return "Eine Anschlagtafel.\n"+str;
}


read(str)
{
  string s;
  mixed *n;
  int i;
  
  if (!str || !sscanf(str, "%d", i)) {
    write("Welche Nachricht (Nummer) moechtest Du denn lesen?\n");
    return 1;
  }
  if (i==0) {
    write("Das geht so nicht.\n");
    return 1;
  }
  if ((i-1)>=call_other(LNEWSD, "GetNewsNum"))
    s="So viele Nachrichten sind hier nicht angeschlagen.\n";
  else {
    n=call_other(LNEWSD, "GetNewsByNum", i-1);
    if (sizeof(n)) {
      s="Nachricht '"+n[M_TITLE]+"' vom "+dtime(n[M_TIME])+":\n";
      s+=n[M_MESSAGE];
      s+="[End of Message]\n";
    }
    else
      s="Upps, da is wohl was schiefgelaufen. -> "+n+"\n";
  }
  TP->More(s);
  return 1;
}

