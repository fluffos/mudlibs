#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Vogelfeder");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 2);
  SetProp(P_SHORT, "Eine Vogelfeder");
  SetProp(P_MATERIAL, MAT_FEATHER);
  SetProp(P_LONG, "Das ist eine Vogelfeder, Du hast sie aus Seddas Kiste.");
  AddId(({"feder", "vogelfeder", "\nsfeder"}));
}
