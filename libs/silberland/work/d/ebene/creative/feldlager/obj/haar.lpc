#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_NAME, "Hundehaar");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_SHORT, "Ein Hundehaar");
  SetProp(P_MATERIAL, MAT_HAIR);
  SetProp(P_LONG, "Das ist ein Hundehaar. Es stammt in jedem Fall von einem Hund.");
  AddId(({"hundehaar", "haar", "\nshaar"}));
}
