#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Pfanne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 190);
  SetProp(P_SHORT, "Eine Pfanne");
  SetProp(P_LONG, BS(
          "Das ist eine Pfanne zum braten, backen, kochen. Es scheint eine"
	 +" gusseiserne Pfanne zu sein."));
  SetProp(P_MATERIAL, MAT_IRON);
  AddId(({"pfanne", "\npfanne"}));
}

