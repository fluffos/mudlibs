#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Schwarzwurzel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 2);
  SetProp(P_SHORT, "Eine Schwarzwurzel");
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_LONG, "Das ist eine Schwarzwurzel. Du findest sie widerlich.");
  AddId(({"wurzel", "schwarzwurzel", "\nswurz"}));
}
