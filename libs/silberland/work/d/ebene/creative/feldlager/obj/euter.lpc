#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Kuheuter");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 4);
  SetProp(P_SHORT, "Ein Kuheuter");
  SetProp(P_MATERIAL, MAT_MISC_DEAD);
  SetProp(P_LONG, "Das ist ein Kuheuter, Du hast es aus Seddas Kiste.");
  AddId(({"euter", "kuheuter", "\nseuter"}));
}
