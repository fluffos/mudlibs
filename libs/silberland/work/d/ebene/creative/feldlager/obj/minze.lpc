#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Pfefferminzblaettchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_SHORT, "Ein Pfefferminzblaettchen fuer Monsieur");
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_LONG, "Das ist ein Pfefferminzblaettchen. Es ist irgendwie gruen.");
  AddId(({"blaettchen", "minzblaettchen", "pfefferminzblaettchen", "\nsminz"}));
}
