string short()
{
  int req;

  req=Query(U_REQ);
  if (!lastverb||query_verb()!=lastverb)
    Set(U_REQ,req=Query(P_AMOUNT));
  if (!req)
    return 0;
  if (req==1)
    return sprintf("%s%s.\n",capitalize( QueryArticle(WER,0,1)),
		   Query(P_NAME)[0]);
  else
    return sprintf("%d %s.\n",req,Query(P_NAME)[1]);
}
