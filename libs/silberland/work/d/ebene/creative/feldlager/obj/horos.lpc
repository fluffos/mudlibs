inherit "/players/eumel/zust/fluch";


init() {
     ::init();
     //if (find_call_out("remove")==-1) call_out("remove",7);
     add_action("paral","",1);
     id = "paralyse";
}

paral() {
    if (this_player()!=this_interactive()) return 0;
    if (!present("sedda", environment(this_player()))) {
       remove();
       return 0;
       }
    write("Du bist viel zu gebannt von Seddas Hypnose.\n");
    return 1;
}
