#include <properties.h>
#include <material.h>
#include <wizlevels.h>
#include "../files.h"

inherit "std/thing";

string envob;

create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine leuchtende Kristallkugel");
  SetProp(P_LONG, BS(
          "Das ist die Kristallkugel von Sedda, der Sterndeuterin."));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_NAME, "Kristallkugel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 100);
  SetProp(P_ARTICLE, 1);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_INFO, BS(
          "Das ist eine ganz besondere Kristallkugel. Mit ihr kannst Du"
	 +" in die Ferne schauen und andere Spieler finden. Du erkennst ein"
	 +" milchiges Schimmern im Inneren der Kugel."));
  AddDetail("schimmern", BS(
            "Mit Hilfe der Kugel kannst Du andere Spieler finden, dazu musst"
	   +" Du die Kugel rubbeln und Dir vorher einen Namen gewuenscht haben."));
  AddId(({"kugel", "kristallkugel"}));
  AddAdjective("leuchtende");
  AddCmd(({"rubble", "rubbel"}), "ribble");
  AddCmd(({"wuensch", "wuensche"}), "wish");
  envob="";
}

wish(string str)
{
  notify_fail("Dieser Spieler ist im Moment nicht da.\n");
  if (!find_player(str))
    return 0;
  notify_fail("Hm, Du kannst Dich einfach nicht auf "+CAP(str)
             +" konzentrieren.\n");
  if (IS_WIZARD(str))
    return 0;
  notify_fail(BS("Du stellst Dir "+CAP(str)+" ganz fest vor. Doch Du kannst"
             +" die Kristallkugel gar nicht sehen..."));
  if (TP->QueryProp(P_BLIND))
    return 0;
  envob=str;
  write("Ok, Du denkst jetzt ganz fest an "+CAP(str)+".\n");
  return 1;
}

ribble(string str)
{
  int sp;
  object env;
  string *ig;

  notify_fail("Woran willst Du rubbeln?\n");
  if (str!="an kugel" && str!="an kristallkugel")
    return 0;
  notify_fail("Du musst Dir schon vorher einen Namen wuenschen.\n");
  if (envob=="")
    return 0;
  notify_fail("Dieser Spieler kann von Dir nicht beobachtet werden.\n");
  if (!(env = find_player(envob)) || IS_LEARNER(envob) || env->QueryProp(P_TESTPLAYER) 
      || (pointerp(ig = env->QueryProp(P_IGNORE)) && sizeof(ig & ({"beobachte", getuid(TP)}))))
    return 0;
  notify_fail("Du hast nicht genug Magiepunkte.\n");
  if ((sp=this_player()->QueryProp(P_SP))<21)
    return 0;
  this_player()->SetProp(P_SP, sp-20);
  if (find_player(envob)->QueryProp(P_BLIND)) {
    write(BS(CAP(envob)+" ist blind! Du kannst "+env->QueryPossPronoun(FEMALE, WEN, SINGULAR) +
          " Umgebung nicht wahrnehmen."));
    envob="";
    return;
  }
  if (!random(5) || !(env=environment(find_player(envob))))
    write(BS("Du kannst Dich nicht genug konzentieren, irgendetwas ist schiefgelaufen.\n"));
  else {
    write(BS("Du reibst sanft ueber die Kugel und denkst dabei fest an "+CAP(envob)
       +". Als Du dann Deine Augen auf die Kugel richtest, siehst Du im trueben Inneren der Kugel:"));
    write("\n"+break_string(env->int_long(this_player(), 0), 77, " ", 1));
    say(CAP(getuid(TP))+" rubbelt an einer Kristallkugel herum.\n");
    envob="";
  }
  return 1;
}

