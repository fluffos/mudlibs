inherit "std/unit";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, ({"Klette", "Kletten"}));
  SetProp(P_SHORT, "Klette");
  AddDetail("widerhaken", BS(
            "Dieser Widerhaken scheint sich sogar durch Metall bohren zu koennen."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_PELT);
  SetProp(P_CURSED, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);
  AddId("klette");
  AddId("\nklette");
  AddSingularId("klette");
  AddPluralId("kletten");
  SetGramsPerUnits(10, 1);
  SetCoinsPerUnits(1, 3);
  AddCmd("entferne", "rem");
}

int rem(string str)
{
  if (environment() != TP)
    return 0;

  notify_fail("Was willst Du (wie) entfernen?\n");
  if (!str)
    return 0;
  if (str!="klette" && str!="kletten" && str!="klette mit gewalt" && str!="kletten mit gewalt")
    return 0;
  if (str=="klette") {
    tell_object(TP, BS(
                "So sehr Du auch an den stachligen Dingern herumzerrst, die"
               +" Widerhaken sind einfach zu wirkungsvoll. Du koenntest es"
               +" mit Gewalt versuchen, aber ob das wirklich geschickt waere?"));
    return 1;
  }
  if (str=="kletten" || str=="kletten mit gewalt") {
    tell_object(TP, BS(
                "Du kannst nur eine Klette (wenn ueberhaupt) entfernen!"));
    return 1;
  }
  tell_object(TP, BS(
              "Mit brutaler Gewalt reisst Du Dir eine Klette vom Leib."
             +" Autsch! Das hat Dir eine unschoene Schramme eingebracht,"
             +" die hoellisch brennt."));
  TP->do_damage(5);
  AddAmount(-1);        // viel sauberer (woody, 2004-09-20)
  // SetProp(P_AMOUNT, QueryProp(P_AMOUNT)-1);
  return 1;
}

string short()
{
  int req;
  string w1, w2;

  req=Query(P_REQUESTED_AMOUNT);
  if (!lastverb||query_verb()!=lastverb)
    Set(P_REQUESTED_AMOUNT, req=Query(P_AMOUNT));
  if (!req)
    return 0;
  if (ENV(TO) && living(ENV(TO))) {
    w1=" haengt an Dir";
    w2=" haengen an Dir";
  }
  else
    w1=w2="";
  if (req==1)
    return sprintf("%s%s%s.\n",capitalize( QueryArticle(WER,0,1)),
		   Query(P_NAME)[0], w1);
  else
    return sprintf("%d %s%s.\n",req,Query(P_NAME)[1],w2);
}

string long()
{
  string ret;

  ret=BS("Diese Art Klette hat einen fiesen Widerhaken der fast ueberall "
      "haengen bleibt.");
  if (ENV(TO) && living(ENV(TO)))
  {
    if (QueryProp(P_REQUESTED_AMOUNT) > 1)
      ret += "Ganze " + QueryProp(P_REQUESTED_AMOUNT) +
        " Stueck davon haengen an Dir!\n";
    ret += BS("Du koenntest versuchen, sie zu entfernen.");
  }
  return ret;
}

