#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Schwarzpulver");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 3);
  SetProp(P_SHORT, "Eine kleine Prise Schwarzpulver");
  SetProp(P_MATERIAL, MAT_GUNPOWDER);
  SetProp(P_LONG, "Das ist eine kleine Prise Schwarzpulver, zu wenig um "
      "irgendetwas explodieren zu lassen aber vielleicht kann man es ja "
      "auch anderweitig verwenden.");
  AddId(({"pulver", "schwarzpulver", "\nspulver"}));
}
