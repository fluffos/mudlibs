#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_NAME, "Tannenzweiglein");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 3);
  SetProp(P_SHORT, "Ein Tannenzweiglein");
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_LONG, "Das ist ein Tannenzweiglein, Du hast es aus Seddas Kiste.");
  AddId(({"tannenzweiglein", "zweig", "zweiglein", "\nszweig"}));
}
