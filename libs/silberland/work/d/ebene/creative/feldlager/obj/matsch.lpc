inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <material.h>
#include "../files.h"

object victim;

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Schlammklumpen");
  SetProp(P_SHORT, "Ein Schlammklumpen");
  AddDetail("widerhaken", BS(
            "Dieser Widerhaken scheint sich sogar durch Metall bohren zu koennen."));
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_EARTH);
  SetProp(P_NOGET, 1),
  SetProp(P_CURSED, "Du kannst den Schlammklumpen einfach nicht abstreifen.\n");
  SetProp(P_NOSELL, "Du kannst den Schlammklumpen einfach nicht abstreifen.\n");
  SetProp(P_NODROP, "Du kannst den Schlammklumpen einfach nicht abstreifen.\n");
  AddId(({"\nmatsch", "klumpen", "matschklumpen", "schlamm", "schlammklumpen", "matsch"}));
}

string long()
{
  if (ENV(TO) && living(ENV(TO)))
    return BS(
      "Dieser eklige Matschklumpen verziert Deine Hand und so sehr Du Dich"
     +" auch bemuehst, es gelingt Dir nicht, diese klebrige Masse abzustreifen."
     +" Aber vielleicht laesst sich trockener Schlamm besser beseitigen"
     +" als nasser... Musst Du wohl etwas warten.");
  return "Ein ekliger Matschklumpen.\n";
}

start_dry(object e)
{
  victim=e;

  while (!remove_call_out("remove")) ;
  call_out("remove", 50);
}

remove()
{
  object e;

  if (victim) {
    victim->FreeHands(TO);
    tell_object(victim, BS(
        "Nach wenigen Momenten trocknen die Matschklumpen an Deinen Haenden"
       +" und Fuessen und die unfreiwilligen Schlammpackungen lassen sich"
       +" problemlos abklopfen. Fuer einen Moment kommt Dir in den Sinn,"
       +" dass sowas gesund fuer den Teint sein soll, aber nach einem kritischen"
       +" Blick auf die braune Masse und angesichts des allgegenwaertigen"
       +" schauderlichen Geruchs, nimmst Du von weiteren Experimenten Abstand."));
  }
  ::remove();
}

string extra_look()
{
  int g;
  
  g=victim->QueryProp(P_GENDER);
  return (g==MALE?"Er":"Sie")+" hat einen ekligen Schlammklumpen auf der Hand kleben.\n";
}

