inherit "std/food";

#include <food.h>
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein Apfel");
  SetProp(P_LONG,
          "Das ist ein leicht wurmiger Apfel, der aber sehr schmackhaft aussieht.\n");
  SetProp(P_GENDER, MALE);
  AddId("\nApf");
  AddId("apfel");
  SetProp(P_NAME, "Apfel");
  SetProp(P_INFO, BS(
          "Du glaubst zu erkennen, dass genau dieser Apfel einem Gouffre besonders"
         +" schmecken wird."));
  SetProp(P_VALUE, 3);
  SetProp(P_WEIGHT, 200);
  SetProp(P_FOOD_INFO, ([ F_HEAL:({ 5, 3 }), F_SOAK:2,
          F_MSG:"Du isst einen Apfel. Glueck gehabt, war kein Wurm drin.\n",
          F_MSG_ROOM:"isst einen Apfel.\n"]));
}

void BeimEssen()
{
  if (ENV(TO) && ENV(TO)->id("gouffre"))
    ENV(TO)->do_damage(30+random(50));
}

