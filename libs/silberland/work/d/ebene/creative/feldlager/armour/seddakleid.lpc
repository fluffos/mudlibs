#include "../files.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

int wasCold;

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Das Winterkleid von Sedda");
  SetProp(P_LONG, BS( 
          "Das schoene Kleid ist ueber und ueber mit kleinen goldenen Puenktchen"
	 +" und magischen Symbolen uebersaet, ausserdem ist es aus einem"
	 +" besonders robusten Stoff gewebt. Auf der Rueckseite finden sich"
	 +" komplizierte Baender."));
  AddDetail("baender", BS(
            "Die Baender dienen zum Zuschnueren des Kleides."));
  AddDetail("rueckseite", BS(
            "Auf der Rueckseite des Kleides siehst Du die Baender, mit denen"
	   +" man sich das Kleid zuschnuert, um es fest am Koerper zu haben."));
  AddDetail("stoff", BS(
            "Der Stoff fuehlt sich sehr fest an."));
  AddDetail("puenktchen", BS(
            "Die Puenktchen stehen fuer die Sterne."));
  AddDetail("symbole", BS(
            "Du koenntest nie in den magischen Symbolen lesen."));
  SetProp(P_INFO, BS(
          "Dieses Kleid beschuetzt Dich vor boesen kalten Monstern."
	 +" Allerdings muss man schon sehr geschickt sein, um sich die Knoten"
	 +" auf der Rueckseite genau zu binden."));
  SetProp(P_NAME, "Winterkleid");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid", "winterkleid"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ({MAT_CLOTH, MAT_MAGIC}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:7,T_HEAT_PROT:-9]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:22]) );
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  wasCold=0;
}

int WearFunc(object me)
{
  mixed *r;

  if (member((r=TP->QueryProp(P_RESISTANCE)), DT_COLD)>-1)
    wasCold=1;
  else
    TP->SetProp(P_RESISTANCE, r+({DT_COLD}));
  return 1;
}

int RemoveFunc(object me)
{
  if (!wasCold)
    TP->SetProp(P_RESISTANCE, TP->QueryProp(P_RESISTANCE)-({DT_COLD}));
  return 1;
}

