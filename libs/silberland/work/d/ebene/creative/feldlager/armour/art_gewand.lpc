inherit "std/armour";

#include "../files.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId("ruestung");
  AddId("artistengewand");
  AddId("gewand");
  SetProp(P_SHORT, "Ein Artistengewand");
  SetProp(P_LONG, BS(
          "Das Artistengewand ist sehr bunt, jedoch nicht unbedingt die beste"
         +" Ruestung."));
  SetProp(P_NAME, "Artistengewand");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_CLOTH);
}

