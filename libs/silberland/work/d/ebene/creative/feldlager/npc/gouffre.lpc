inherit "std/npc";
inherit "std/player/moneyhandler";
inherit "std/npc/spells";
inherit "std/npc/sequencer";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#define ELOG(x) write_file(LOG("eat.log"), sprintf("%s: %s\n", dtime(time()), getuid(x)))

#define MAXEAT 4

int gegessen;

create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  SetProp(P_SHORT, "Das Gouffre");
  SetProp(P_LONG, BS(
          "Das Gouffre, auch Klettenviech genannt, ist sicher einer der"
         +" seltsamsten Bewohner dieser Welt. Es ist ein zottliges,"
         +" zerzaustes Wesen, dessen struppiger Pelz nur aus ineinanderhakenden"
         +" Kletten besteht. Staendig fallen einige ab oder werden"
         +" davongeschleudert, nur um gleich von neuen ersetzt zu werden."
         +" Irgendwie sieht das Gouffre selbst aus, wie eine ueberdimensionale"
         +" Klette mit vielen Armen und Beinen. So genau kannst Du gar nicht"
         +" ausmachen, wie viele Gliedmassen es hat, aber Du wuerdest mal"
         +" auf vier Arme und mindestens ebensoviele Beine tippen. Ein"
         +" runder Kopf mit zottigen Klettenhaaren betrachtet Dich aufmerksam"
         +" aus kleinen schwarzen Knopfaugen. Insgesamt ist das Gouffre ein"
         +" sehr freundliches Wesen und vielleicht solltest Du es gerade"
         +" deswegen nicht zu sehr reizen."));
  AddDetail(({"arme", "beine", "gliedmassen"}), BS(
            "So genau kanst Du nicht ausmachen, wie viele Gliedmassen"
           +" das Gouffre hat, aber Du wuerdest mal auf vier Arme und"
           +" mindestens ebensoviele Beine tippen."));
  AddDetail("kopf", BS(
            "Der Kopf des Gouffre sieht aus wie eine grosse Klette mit"
           +" schwarzen Knopfaugen, die Dich freundlich anblicken."));
  AddDetail(({"augen", "knopfaugen"}), BS(
            "Das Gouffre blickt Dich aus schwarzen Knopfaugen freundlich an."));
  AddDetail(({"pelz", "klettenhaare", "haare"}), BS(
            "Der struppige zerzauste Pelz des Gouffre besteht ganz und gar"
           +" aus braunen widerspenstigen Kletten, die sich zu langen"
           +" Klettenhaaren zusammenhaken. Staendig fallen einige ab oder"
           +" werden davongeschleudert, nur um gleich von neuen ersetzt zu werden."));

  SetProp(P_DEFAULT_INFO, ({
          "fiept klaeglich.\n",
          "fragt Dich: Kno ajo maaaaaaah?\n",
          "kitzelt Dich an Deinem Kinn.\n",
          "sagt: Dk mejo blu waaan me h...\n",
          "sagt: Ahoje Muaaaaaaa ew Bremo.\n" }));
  AddInfo("apfel",
          "schleckt sich genuesslich die Lippen ab.\n");
  SetChats(3, ({
           "Das Gouffre knabbert an einem Schilfhalm.\n",
           "Das Gouffre betrachtet veraergert den Himmel.\n",
           "Das Gouffre strahlt Dich an.\n",
           "Das Gouffre fiept.\n",
           "Das Gouffre sucht im Schilf nach einem Apfel.\n",
           "Das Gouffre fragt Dich: hap hap?\n",
           "Das Gouffre floetet Dich erfreut an.\n",
           "Das Gouffre grinst einen kleinen Schmetterling an und gibt ihm einen Schubs.\n",
           "Das Gouffre nagt an einem Kaefer.\n" }));
  SetProp(P_NAME, "Gouffre");
  AddId(({"klettenviech", "gouffre"}));
  SetProp(P_GENDER, NEUTER);
  create_default_npc(28);
  SetProp(P_ALIGN, 700);
  SetProp(P_RACE, "Klettomane");
  SetProp(P_BODY, 250);
  SetProp(P_MAX_HP, 2000);
  SetProp(P_MSGIN, "wacht auf und schaut Dich neugierig an");
  seteuid(getuid(this_object()));

  SetProp(P_RESISTANCE_STRENGTHS, ([
          DT_FIRE:-0.5, DT_COLD:0.1, DT_AIR:-0.3, DT_MAGIC:-0.1, DT_ELECTRIC:-0.2 ]));
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 110000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HANDS, ({"mit einer ordentlichen Ohrfeige", 180, DT_BLUDGEON}));
  SetProp(P_SPELLRATE, 85);
  AddDefaultSpell(1, 160, DS_FROG,
           "Das Gouffre macht einen unheimlichen Laut: MKRUUUU BA SO WEJKTH!!!\n",
           "Das Gouffre macht einen unheimlichen Laut: MKRUUUU BA SO WEJKTH!!!\n");
  AddSpell(8, 130,
           "Das Gouffre wirft ein paar Kletten nach Dir.\n",
           "Das Gouffre wirft ein paar Kletten nach @WEM.\n",
           DT_PIERCE, "k_few");
  AddSpell(5, 180,
           "Das Gouffre schuettelt sich und ueberhaeuft Dich mit Kletten.\n",
           "Das Gouffre schuettelt sich und ueberhaeuft @WEN mit Kletten.\n",
           DT_PIERCE, "k_med");
  AddSpell(1, 250,
           "Das Gouffre springt Dich an und umarmt Dich.\n",
           "Das Gouffre springt @WEN irre gefaehrlich schmusig an.\n",
           DT_PIERCE, "k_most");
  AddSpell(14, 90,
           "Das Gouffre schenkt Dir eine Klette.\n",
           "Das Gouffre schenkt @WEM eine Klette.\n", DT_PIERCE, "k_one");
  RegisterGive("apf", ({ ({"emote fiept froehlich.", 2}), ({"iss apfel", 2}) }));
  AddMoney(300+random(2700));
  "/obj/gemmaster"->DistributeGem(3, 10, 1, 1);
  gegessen=MAXEAT;
}

apf(object o)
{
  if (o->id("\nApf")) {
    if ((--gegessen)<1) {
      command_me("emote wirft den Apfel in hohem Bogen weg.");
      o->remove();
      return 0;
    }
    SetProp(P_FOOD, 80);
    ELOG(TP);
    return 1;
  }
  return 0;
}

void add_klette(object vic, int add)
{
  object kl;
  int a;

  if (!vic->id("Spieler"))
    return;
  a=0;
  if (!(kl=present("\nklette", vic))) {
    kl=clone_object(OBJ("klette"));
    kl->move(vic, M_NOCHECK);
  }
  kl->AddAmount(add);
}

#define VERBN ({"knuddelt", "wuschelt", "umarmt", "haetschelt", "drueckt"})

StartReaction(verb, gruppe, adverb, touch)
{
  int k;
  object kl;
  string wie, was;

  if (touch) {
    switch (gruppe) {
      case "fies": k=10+random(30); wie="hinterhaeltig"; break;
      case "aergerlich": k=15+random(20); wie="grummelnd"; break;
      case "traurig": k=3+random(10); wie="schnueffzend"; break;
      case "albern": k=5+random(3); wie="kichernd"; break;
      case "neutral": k=2; wie="grunzend"; break;
      case "intim": k=10+random(10); wie="schmusig"; break;
      case "froh": k=5+random(10); wie="froehlich"; break;
      case "aengstlich": k=3; wie="zitternd"; break;
      case "frech": k=5+random(8); wie="tueckisch"; break;
      case "nett": k=5; wie="laechelnd"; break;
      default: k=1; wie="unmoeglich";
    }
    was=VERBN[random(sizeof(VERBN))];
    tell_object(TP, "Das Gouffre "+was+" Dich "+wie+" und schenkt Dir ein paar Kletten.\n");
    tell_room(ENV(TO), "Das Gouffre "+was+" "+TP->Name(WEN)+" "+wie+".\n", ({TP}));
    add_klette(TP, k);
  }
}

StartReactionAll(verb, gruppe, adverb, touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

k_one(enemy, dam, dam_type)
{
  add_klette(enemy, 1);
}

k_few(enemy, dam, dam_type)
{
  add_klette(enemy, random(enemy->QueryProp(P_LEVEL)/2));
}

k_med(enemy, dam, dam_type)
{
  int x;

  if ((x=enemy->QueryProp(P_LEVEL)*enemy->QueryProp(P_MAX_HP)/100)<20)
    x=20;
  add_klette(enemy, 10+random(x));
}

k_most(enemy, dam, dam_type)
{
  int x, i;

  x=enemy->QueryProp(P_LEVEL)*enemy->QueryProp(P_MAX_HP) /
      ((i=sizeof(enemy->QueryProp(P_ARMOURS)))?i:2);
  add_klette(enemy, 35+random(x));
}

catch_tell(str)
{
  sequencer::catch_tell(str);
  npc::catch_tell(str);
}

give_notify(ob)
{
  sequencer::give_notify(ob);
  npc::give_notify(ob);
}

