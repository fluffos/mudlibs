inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <wizlevels.h>
#include <bank.h>
#include <mnpc.h>

#include "../files.h"

create()
{
  object ob;

  if (!is_clone(TO)) return;

  ::create();
  AddId("josef");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Josef");
  SetProp (P_SHORT, "Josef");
  SetProp (P_LONG, BS(
           "Das ist Josef. Grundsaetzlich muesste er Dir bekannt sein.")); 
  create_default_npc(100);
  SetProp(P_ALIGN, 1000);
  SetProp(P_HANDS, ({" mit hasser Luft", 6000, DT_BLUDGEON}) );
  SetProp(P_RESISTANCE, ({DT_SLASH, DT_BLUDGEON, DT_PIERCE, DT_SQUEEZE,
                          DT_WHIP, DT_RIP, DT_FIRE, DT_COLD, DT_WATER,
                          DT_AIR, DT_LIGHTNING, DT_EXPLOSION, DT_SOUND,
                          DT_LIGHT, DT_ELECTRIC, DT_ACID, DT_POISON,
                          DT_TERROR, DT_MAGIC}) );
  SetProp(P_MSGIN, "sagt: Ploetzlich geht die Tia auf und da Petrocelli kummt eina");
  SetProp(P_MSGOUT, "zagt#");
  SetProp(P_SIZE, 180);
  SetProp(P_KILL_MSG, "Gott mant... oh, hob i mi vagogelt... *schnipp*, jetzt bist tot");
  set_living_name("josef");
  seteuid(getuid(TO));

  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT, 1);
  ob->move(TO);

  SetProp(P_DIE_MSG, " meint: Ah! Reinhold Messner... und bohrt auffe...\n");
  SetProp(P_DEFAULT_INFO, "sagt: Do bin i jetzt assoziativ ueberfragt.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Josef ruft: Super! Endlich das richtige fuer meine Show!\n" }) );

  SetProp(P_MNPC_WAIT, ({ 30, 60, 120 }));
  SetProp(P_MNPC_DEFAULTROOM, "/gilden/abenteurer");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
  SetProp(P_ARTICLE, 0);
}

void do_say(string str, string action);

#define STS(x,y,z) if (strstr(str, x, 0)>-1) { call_out("do_say", 3, y, z); return; }
#define STSH(x,y,z,d) if (strstr(str, x, 0)>-1) { call_out("do_shout", 3, y, z, d); return; }

void catch_tell(string str)
{
  object who;
  
  str=lower_case(str);
  STS("josef", "Kraenk Di net, morgen wirds besser.", "grinst")
  STS("teifi", "Nana, i bin net da Staberl. I bin nur da Teifi.", "kichert")
  STS("hund", "Jo, frueher hob i no mit so an blinden Pianisten gspuet.", "sogt")
  STS("pianist", "Des woar der Otto Lechner. Ein Kettenraucher.", "grinst")
  STS("raucher", "A Mords-Trara in da Zeitung, Tierschutzverband gegen Blindenverband", "sagt")
  STS("luzi", "Geh Luzi, a klans Pakterl... sei a bissl sportlich.", "draengt")
  if (   strstr(str, " wer?", 0)>1
      || strstr(str, " wer!", 0)>1
      || strstr(str, " wer.", 0)>1
      || strstr(str, " wer ", 0)>1
      || strstr(str, " wer\n", 0)>1) {
    who=TP;
    if (IS_LEARNER(TP)) {
      tell_object(who, "Josef teilt Dir mit: Gschossen, du Magier! Aetsch.\n");
      return;
    }
    call_out("do_shout", 3, "Der Staascheisserkarl, "
           +CAP(who->query_real_name())+"! Gschossen! :)", "bruellt"); 
    tell_object(who, "Josef teilt Dir mit: Gschossen! Aetsch.\n");
    who->do_damage(40);
    return;
  }
  STS(" tot", "Na da is er ja endlich!", "erkennt")
  STS("anorak", "I nimm ma den ganz oben, der als anziger an blauen Anorak anhat, ok?", "fragt")
  STS("sven", "Du Josef, i deaf doch Du sagn, i bin naemlich Einkaufsleiter bei Ikea...", "sagt")
  STS("ikea", "... dass Du Di von jeda praepotenten Oaschgeign mit Du anredn losst... Suppa Du!", "meint ueberzeugt")
  STS("kaiser", "Und in ana goldenen Badwann sitzt... da Kaiser von Afrika...", "traeumt")
  STS("brille", "Da Arzt hat glaubt, i bin nur de Nochgeburt von da Bruelln...", "schimpft")
  STS("mischmaschin", "Mei Opa der hat immer so Installationen gmacht...", "denkt")
  STS("mainz", "Oeeed, oeeed, oeeed... so richtig baeeh!", "wuergt")
  STS("lainz", "I war net in Lainz, i war in Mainz!", "gruebelt")
  STS("ast", "Ast, net, des is unmenschlich!", "ruft")
  STS("poelten", "Josef Hader, Landeskabarettist, Sprechstunde 20-22 Uhr", "nickt")
  STS("hader", "Joeh, sie sind der Herr Hader, gell? I kenn sie aus meiner Jugend im Kabarett"
              +" Niedermayr, da war ich ein Topfenstrudel!", "erzaehlt")
  STS("lemming", "Hallo Lemminge, ich bin Karl-Heinz, ich bin Euer Animator! Ich bin total deprimiert"
                +" und schlecht drauf, das Leben ist Scheisse! Und darum wollen wir es einmal so richtig"
                +" hinter uns lassen und stellen uns in Zweierreihe auf, zickezacke zickezacke!", "spricht")
  STS("klein", "Und da klane Lemming sogt: Schau Papa, i konn schwimmen", "erzaehlt")
  STS("bua", "Sei Vota mant: Rotzbua, waunst net sofort untagehst, host a Floschn dass 'kracht!", "laestert")
  STS("milch", "... und hat Muech nocheglaat und de Mischmaschin eingschoit. Voi hoat!", "denkt nach")
  STS("hundertwasser", "...de gaunzen Scheissrohr in Wien san innen vom Hundertwasser ausgmoit!", "weiss")
  STS("trum", "Ploetzlich neben mir: A Scheisstruemmerl", "sagt")
  STS("kappe", "Und ploetzlich kummt a grosses schwarzes Scheisstruemmerl mit an Kappel und wuell an Foahschein"
              +" seng.", "grinst")
  STS("anruf", "Des is mein Anruf-Beantworter, und des mein Futon-einharter...", "singt")
  STS("maria", "Ploetzlich hab i a Erscheinung... es is Maria, die Tochter vom Fleischhauer.", "strahlt")
  STS("frau", "Imma wann i zu an Rendez-Vous kumma bin, hab i statt Rosen a Kilo Erdaepfel bracht...",
              "denkt logisch")
  STS("jesus", "Da geht ana uebers Wasser... Es is Jesus! (Na kloa, er hat an leuchtenden Schwimmreifen"
              +" am Kopf...", "erklaert")
  STS("karl", "Sers Luzi, na, wie gehts im Staascheisserkarl?", "fragt")
  STS("telefon", "'Sers Josef, da is da Lks Rstrts' - 'wwwwwwie bitte?' - 'waaaah! *klick*'", "erzaehlt")
  STS("gott", "Gott? Schrei mi net an!", "gruebelt")
  STS("reinhold", "... und boaht auffe... *ggggnnnnnn* weg woar er", "verlautet")
  STS("messner", "Na, Reinhold, warst a bissl zvue mitn Luis Trenker beinaund?", "fragt")
  STS("wueste", "A Wuerstelstand! Da steht... 'All drinks except Almdudler' wurscht. I renn hin...", "meint")
  STS("eltern", "...oba meine Eltern ham sie da scho nix mehr sagn traut, die ham scho an"
               +" Kredit bei mir rennen ghabt...", "erzaehlt")
  STS("neil", "Geh bitte, Neil, jetzt woat ma scho zwanzg Joah dass da a gscheiter Spruch einfoit",
              "erzaehlt aus dem All")
  STS("allegorie", "Ich bin die Impotenz, Bruederlein fein, Bruederlein fein...", "arglt")
  STS("hoden", "Imma wann i onaniert hab, hob i so an durscht kriagt...", "schwaermt")
  STS("gruess", "Gruess Gott, i bin da JOSEF HADER! - 'Supa. Mir woitn scho anruafn.'", "snifft")
  
}

void do_say(string str, string action)
{
  say(break_string(str, 78, "Josef "+action+": "));
  return;
}

void do_shout(string str, string action, int dam)
{
  object *u;
  int i;
  
  u=users();
  for (i=sizeof(u)-1; i>=0; i--)
    tell_object(u[i], break_string(str, 78, "Josef "+action+": "));
  return;
}

void Defend(int dam, string dam_type, int spell, object enemy)
{
  object en;
  if (!en=previous_object() || !living(en))
    en=this_player();
  tell_room(environment(), break_string("Bevor'st mi Du killst, stuerz i mi"
                                       +" vorn J-Wogn!", 78, "Josef schimpft: "),
            ({ TO }) );
  en->StopHuntFor(this_object(), 1);
}

init()
{
  object ob, prev;
  object *victim;
  int i, betrag, v;

  victim=({ });

  if (present("geld", ENV(TO)))
    command_me("nimm geld");

  for (ob=first_inventory(ENV(TO)); ob; ob=next_inventory(ob)) {
    if (living(ob) && ob!=TO) {
      if (sizeof(explode(file_name(ob),"#")) &&
          explode(file_name(ob),"#")[0]==NPC("josef")) {
        do_shout("Was willst Du hier, Doppelgaenger?", "ruft ganz entsetzt");
        ob->remove();
        command_me("nimm muenzen");
        ob=prev;
        continue;
      }
      if (!IS_LEARNER(ob)  && !ob->QueryProp(P_TESTPLAYER)
          && deep_present("geld", ob))
        victim+=({ob});
    }
    prev=ob;
  }
    
  if ((i=sizeof(victim))) {
    if (!random(8)) {
      betrag=(int)(deep_present("geld", 
                   victim[(v=random(i))]))->QueryProp(P_AMOUNT)/100;
      if (betrag)
        call_out("spende", 3, victim[v], betrag);
    }
  }

  ::init();
}

spende(object ob, int x)
{
  int i;
  string str;

  if (present(ob)) {
    str=ob->query_real_name();
    if (!stringp(str))
      str=ob->QueryProp(P_NAME);
    do_shout("Eine Spende! "+CAP(str)+" hat jetzt "
            +x+" Muenzen weniger!", "ruft");
    ob->AddMoney(-x);
    present("geld")->AddAmount(x);
  }
  if (!random(3)) {
    i=present("geld")->QueryProp(P_AMOUNT)-1;
    ZENTRALBANK->PayIn(i);
    do_shout("Das Silberland ist um "+i+" Muenzen reicher :)", "ruft erfreut");
    present("geld")->AddAmount(-i);
  }
}

