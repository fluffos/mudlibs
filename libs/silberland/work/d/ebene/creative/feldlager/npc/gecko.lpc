inherit "std/npc";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Gecko");
  SetProp(P_LONG, BS(
          "Das ist bloss ein kleiner Gecko, der Dich interessiert anschaut."
         +" Ausser den schoenen gelben Flecken kannst Du nichts an ihm"
         +" erkennen.")); 
  SetProp(P_NAME,"Gecko");
  AddId("gecko");
  SetProp(P_GENDER, MALE);
  create_default_npc(5);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_ALIGN, 50);
  SetProp(P_HEAL, 1);
  SetProp(P_HANDS, ({" mit seiner langen zuengelnden Zunge", 40}));
  SetProp(P_SIZE, 20);
  SetProp(P_BODY, 40);
  SetProp(P_RACE, "Echse");
  AddDetail(({"fleck", "flecken"}), BS(
            "Die Flecken des Geckos sind ausserordentlich gelb."));

  enable_commands();
  seteuid(getuid(this_object()));
}

