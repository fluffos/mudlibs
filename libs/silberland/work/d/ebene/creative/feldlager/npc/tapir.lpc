inherit "std/npc";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();
  AddId ("tapir");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Tapir");
  SetProp(P_SHORT, "Ein Tapir");
  SetProp(P_LONG, BS(
           "Das ist ein Tapir. Ein Tapir ist nix andres als ein Ameisenbaer."
          +" Das einzige boese, was er macht, ist, dass er Ameisen frisst." ));
  create_default_npc(14);
  SetProp(P_ALIGN, -200);
  SetProp (P_HANDS, ({" mit seiner langen Zunge", 90, DT_BLUDGEON}) );

  seteuid(getuid(TO));
  SetProp(P_DEFAULT_INFO, "hustet Dir was ins Gesicht.\n");
  SetProp(P_SIZE, 40);
  SetProp(P_RACE, "Tapir");
}

