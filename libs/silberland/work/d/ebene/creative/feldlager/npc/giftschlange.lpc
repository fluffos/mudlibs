inherit "std/npc";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Giftschlange");
  SetProp(P_LONG, BS(
          "Verdammt, Dich hat wirklich eine Schlange erwischt. Kaum mehr als"
         +" einen Meter lang liegt sie jetzt vor Dir auf dem Pfad und blickt"
         +" Dich wuetend an. Gelbgrau wie all das Gras um Dich herum ist sie"
         +" wirklich gut getarnt. Der Biss in Deiner Hand brennt hoellisch und"
         +" langsam wird Dir schummrig. Das war wohl dummerweise eine Giftschlange."));

  SetProp(P_NAME,"Giftschlange");
  AddId("schlange");
  AddId("giftschlange");
  SetProp(P_GENDER, FEMALE);
  create_default_npc(18);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_HANDS, ({" mit ihrer langen zuengelnden Zunge", 110, DT_POISON}));
  SetProp(P_SIZE, 20);
  SetProp(P_RACE, "Schlange");
  enable_commands();
  seteuid(getuid(this_object()));
}

