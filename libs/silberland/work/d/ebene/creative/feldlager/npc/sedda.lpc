#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

inherit "std/npc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Sedda, die Sterndeuterin");
  SetProp(P_LONG, BS(
          "Die Sterndeuterin sieht irgendwie ziemlich alt aus mit ihrem"
	 +" faltigen Gesicht und der krummen Nase; weiters hat sie ein tolles"
	 +" dunkelblaues Kleid an, das ueber und ueber mit magischen Symbolen"
	 +" und kleinen gelben Puenktchen bemalt ist."));

  AddDetail("gesicht", BS(
            "Das Gesicht der Sterndeuterin ist ueber und ueber mit Runzeln und Falten uebersaet."));
  AddDetail(({"runzeln", "falten"}), BS(
            "Sei froh, dass Du sie nicht selber im Gesicht hast."));
  AddDetail("nase", BS(
            "Die Nase der Sterndeuterin ist krumm und faltig."));
  AddDetail("kleid", BS(
            "Ein huebsches dunkles Kleid, eigentlich auf eine gewisse Art"
	   +" und Weise magisch angehaucht, und zusaetzlich so gut geschnitten,"
	   +" dass das Gewicht der Alten gut kaschiert wird."));
  AddDetail("gewicht", BS(
            "Du schaetzt nie, was die Sterndeuterin wiegt."));
  AddDetail("symbole", BS(
            "Das Kleid ist ueber und ueber mit magischen Symbolen bestickt."));
  AddDetail("puenktchen", BS(
            "Die Puenktchen duerften wohl Sinnbilder fuer Sterne sein."));
  AddDetail("sterne", BS(
            "Sterne? Klar. Hier ist doch eine Sterndeuterin."));
  AddInfo(({"trank", "heiltrank"}), BS(
          "meint: Da wird Dir Hannelore mehr sagen koennen."));
  AddInfo("horoskop", BS(
          "sagt: Du kannst mit \"kaufe horoskop\" gerne eines haben."));

  SetProp(P_WEIGHT, 107567);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Sedda");
  SetProp(P_GENDER, FEMALE);
  AddId(({"sterndeuterin", "sedda"}));
  create_default_npc(20);
  SetProp(P_ALIGN, -50);
  SetProp(P_XP, 250000);
  SetProp(P_MAX_HANDS, 0); 
  SetProp(P_MAX_SP, 350);
  SetProp(P_MAX_HP, 600);
  SetProp(P_SPELLRATE, 60);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160);
  SetProp(P_DEFAULT_INFO, "wirft einen nachdenklichen Blick in ihre Kristallkugel.\n");
  SetProp(P_HANDS, ({" mit toedlicher Schnelligkeit", 80, DT_WHIP}));
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Das Kamel hat in seinen Hoeckern keinen Platz mehr.\n" }) );
 
  AddSpell(30, 300, 
    BS("Sedda beschwoert einen kleinen Blitz hervor und trifft Dich genau ins Herz."),
    "Sedda beschwoert einen kleinen Blitz hervor und trifft @WEN genau ins Herz.\n",
    DT_ELECTRIC, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(1, 700, BS(
           "Sedda sucht in ihrer Verzweiflung Rat bei den Sternen."), BS(
	   "Sedda sucht in ihrer Verzweiflung Rat bei den Sternen."),
	   DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_VULNERABILITY, ({ DT_POISON }));
  SetProp(P_RESISTANCE, ({ DT_FIRE, DT_ACID, DT_ELECTRIC, DT_AIR, DT_WATER }));

  if (!random(20))
    clone_object(OBJ("kristallkugel"))->move(TO);
  clone_object(ARMOUR("seddakleid"))->move(TO);
  clone_object(OBJ("skey"))->move(TO);
  command_me("ziehe alles an");
}

