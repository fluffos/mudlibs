inherit "std/npc";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein doofes Testmonster");
  SetProp(P_LONG, BS(
          "Das ist bloss ein doofes Testmonster, das nix kann."));
  SetProp(P_NAME,"Testmonster");
  AddId("testmonster");
  SetProp(P_GENDER, NEUTER);
  create_default_npc(15);
  SetProp(P_ALIGN, 50);
  SetProp(P_SIZE, 20);
  SetProp(P_RACE, "doofmonster");
  seteuid(getuid(this_object()));
}

