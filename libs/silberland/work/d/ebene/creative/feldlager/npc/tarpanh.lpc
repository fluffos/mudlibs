inherit "std/mnpc";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();
  AddId("tarpan");
  AddId("pferd");
  AddId("wildpferd");
  AddId("wildpferdhengst");
  AddId("hengst");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Tarpan");
  SetProp(P_SHORT, "Ein Wildpferdhengst");
  SetProp(P_LONG, BS(
          "Der Tarpan ist eins der letzten Wildpferde, die frueher zu"
         +" Tausenden diese Ebene durchstreiften. Klein und staemmig, mit"
         +" kraeftigen Beinen, ist er ein ausdauernder Laeufer und vor seinen"
         +" scharfen Hufen solltest Du Dich in acht nehmen."));
  SetProp(P_RACE, "Pferd");
  SetProp(P_SIZE, 190);
  create_default_npc(18);
  SetProp(P_ALIGN, -200);
  SetProp (P_HANDS, ({" mit gewaltigem Hufausschlag", 180, DT_BLUDGEON}) );

  seteuid(getuid(TO));
  SetProp(P_DEFAULT_INFO, "wiehert traurig.\n");
  SetProp(P_MSGIN, "trabt herein");
  SetProp(P_MSGOUT, "galoppiert");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES|MOV_INFIGHT);
  SetProp(P_MNPC_AREA, 
          ({ ROOM("a7_a5"), ROOM("a8_a4"), ROOM("a8_a5"), ROOM("a8_a6"),
             ROOM("a9_a4"), ROOM("a9_a5"), ROOM("a9_a6"), ROOM("a0_a5") }) );

  SetProp(P_SPELLRATE, 75);
  AddSpell(1, 100,
     "Der Hengst schlaegt wild mit seinem Hinterhuf aus und trifft Dich voll ins Gesicht.\n",
     "Der Hengst schlaegt wild mit seinem Hinterhuf aus und trifft @WEN voll ins Gesicht.\n",
     DT_BLUDGEON);
           
  SetProp(P_MNPC_WAIT, ({ 20, 8, 12 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("a7_a5"));
}

