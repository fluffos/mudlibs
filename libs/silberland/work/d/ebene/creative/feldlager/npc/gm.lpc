inherit "std/npc";
inherit "std/npc/spells";
inherit "std/npc/sequencer";
inherit "std/player/moneyhandler";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Geck Meiwer, der irre Bastler");
  SetProp(P_LONG, BS (
           "Geck hat schon alles moegliche gebastelt. Er schafft es sogar,"
          +" eine Muehle mit einem Taschenmesser zu reparieren!"));
  SetProp(P_NAME, "Geck Meiwer");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId("geck");
  AddId("meiwer");
  create_default_npc(25);

  SetProp(P_DEFAULT_INFO, ({
          "sagt: Aber ich hab da noch eine Kugelschreibermine und einen Faden!\n"
          }));
  SetProp(P_RESISTANCE_STRENGTHS, ([
          DT_FIRE:-0.2, DT_COLD:0.4, DT_AIR:-0.3, DT_MAGIC:0.1, DT_ELECTRIC:-0.1 ]));
  SetProp(P_ALIGN, 300);
  SetProp(P_SIZE, 140);
  SetProp(P_WEIGHT, 90);
  SetAttribute(A_STR, 20);
  SetProp(P_HANDS, ({"mit einer Kugelschreibermine", 180, DT_PIERCE}));
  SetProp(P_SPELLRATE, 80);
  SetProp(P_KILL_MSG, "Und wer entklettet euch jetzt???");
  RegisterGive("something", ({
        ({"sag Wow, endlich!", 2}),
        ({"apfel", 2}) }) );
  AddMoney(200+random(500));
}

int something(object o ) {
}

catch_tell(str)
{
  sequencer::catch_tell(str);
  npc::catch_tell(str);
}

give_notify(ob)
{
  sequencer::give_notify(ob);
  npc::give_notify(ob);
}

