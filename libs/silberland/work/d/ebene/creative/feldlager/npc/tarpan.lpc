inherit "std/mnpc";

#include "../files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();
  AddId("pferd");
  AddId("wildpferd");
  AddId("wildpferdstute");
  AddId("stute");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Wildpferdstute");
  SetProp(P_SHORT, "Eine Wildpferdstute");
  SetProp(P_LONG, BS(
          "Der Tarpan ist eins der letzten Wildpferde, die frueher zu"
         +" Tausenden diese Ebene durchstreiften. Klein und staemmig, mit"
         +" kraeftigen Beinen, ist sie ein ausdauernder Laeufer und vor ihren"
         +" scharfen Hufen solltest Du Dich in acht nehmen."));
  create_default_npc(13);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Pferd");
  SetProp(P_SIZE, 180);
  SetProp (P_HANDS, ({" mit ihrer langen Zunge", 130, DT_BLUDGEON}) );

  seteuid(getuid(TO));
  SetProp(P_DEFAULT_INFO, "hustet Dir was ins Gesicht.\n");
  SetProp(P_MSGIN, "trabt herein");
  SetProp(P_MSGOUT, "galoppiert");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_BACKWARDS|MOV_MOVES|MOV_INFIGHT);
  SetProp(P_MNPC_AREA, 
          ({ ROOM("a7_a5"), ROOM("a8_a4"), ROOM("a8_a5"), ROOM("a8_a6"),
             ROOM("a9_a4"), ROOM("a9_a5"), ROOM("a9_a6"), ROOM("a0_a5") }) );

  SetProp(P_SPELLRATE, 65);
  AddSpell(1, 100,
     "Die Stute schlaegt wild mit ihrem Hinterhuf aus und trifft Dich voll in den Bauch.\n",
     "Die Stute schlaegt wild mit ihrem Hinterhuf aus und trifft @WEN voll in den Bauch.\n",
     DT_BLUDGEON);
           
  SetProp(P_MNPC_WAIT, ({ 20, 8, 12 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("a7_a5"));
}

