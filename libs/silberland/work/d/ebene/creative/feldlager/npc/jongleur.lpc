inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../files.h"

create()
{
  object ob;

  if (!is_clone(TO)) return;

  ::create();
  AddId("artist");
  AddId("jongleur");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Jongleur");
  SetProp (P_SHORT, "Ein Jongleur");
  SetProp(P_RACE, "Mensch");
  SetProp (P_LONG, BS(
           "Der Jongleur ist eine komische Gestalt. Er traegt bunte Sachen und"
          +" wirft mit seinen bloeden Kugeln herum. Aber das kann er.")); 
  create_default_npc(17);
  SetProp (P_ALIGN, -300);
  SetProp (P_HANDS, ({" bei einer Jongleurunterbrechung", 160, DT_BLUDGEON}) );
  set_living_name("jongleur");
  seteuid(getuid(TO));

  clone_object(ARMOUR("art_gewand"))->move(TO);
  command_me("ziehe ruestung an");
  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT, 300);
  ob->move(TO);

  SetProp(P_SPELLRATE,15);

  AddSpell(1,160, 
    "Der Jongleur wirft eine seiner Kugeln nach Dir.\n",
    "Der Jongleur wirft @WEM eine seiner Kugeln nach.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetProp(P_DIE_MSG, " stirbt mit einem Laecheln auf den Lippen.\n");
  SetProp(P_DEFAULT_INFO, "meint: 'Halt, Moment, hab grad keine Zeit.'\n");

  AddInfo("jongleur", "meint: Ja, sowas bin ich.");
  AddInfo(({"kugel", "kugeln"}), "sagt: So schoen jonglieren kann nur ich.\n");
  AddInfo(({"feldlager", "lager"}), "deutet auf die vielen Zelte.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Jongleur steckt es schnell ein und jongliert weiter.\n" }) );

  SetProp (P_MNPC_AREA, ROOM(""));
  SetProp (P_MNPC_WAIT, ({ 30, 60, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("a7_a7"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
  SetProp(P_SIZE, 160);
}

