/*
  Zone 3: Koppel
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Koppel");
  SetProp(P_INT_SHORT, "Auf der Koppel");
  SetProp(P_INT_LONG, BS(
          "Du stehst auf der Koppel. Ein wenig abgetretenes Gras"
	 +" ist das einzige, was man erkennen kann, ausser der"
	 +" Umzaeunung."));
  AddDetail("umzaeunung", BS(
            "Die Umzaeunung dient dazu, die Pferde nicht ausbrechen"
	   +" zu lassen."));
  AddDetail("umzaeunung", BS(
            "Die Umzaeunung dient dazu, die Pferde nicht ausbrechen"
	   +" zu lassen."));
  AddDetail("gras", BS(
            "Das Gras ist noch saftig und schmackhaft."));
  AddDetail("pferde", BS(
            "Oh ja, viele Pferde sind hier meistens!"));
  AddDetail("weg", BS(
            "Hier von Weg zu sprechen ist nicht das richtige Wort."
	   +" Eher ist hier richtige Steppe, eine Koppel eben."));
  AddDetail("steppe", BS(
            "Steppiger gehts gar nicht."));
  AddDetail(({"gatter", "tor"}), BS(
            "Ein Gatter fuehrt nach Westen, um die Pferde am Ausbrechen"
	   +" zu hindern."));
  AddDetail(({"ausbruch", "ausbrechen"}), BS(
            "Die Pferde duerfen auf keinen Fall ausbrechen!."));
  AddDetail("boden", BS(
            "Auf dem Boden waechst ein wenig abgenagtes Gras.")); 
  AddDetail("himmel", BS(
            "Am Himmel steht unerbittlich die Sonne."));
  AddDetail("sonne", BS(
            "Die Sonne ist heute mal wieder heiss."));
  AddDetail(({"koppel", "pferdekoppel"}), BS(
            "Du stehst mitten auf der grossen Pferdekoppel an."));
  AddSound(DEFAULT_SOUND, BS(
           "Fast ist Dir, als ob Du das Trampeln von Hufen hoertest."));
  AddSound(({"trampeln", "hufe"}), BS(
           "Du hast Dich wahrscheinlich getaeuscht."));
  AddSmell(DEFAULT_SMELL, BS(
           "Ein Pferd hat hier sicherlich irgendwo gekotet. Es stinkt"
          +" naemlich scheusslich."));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]));

  AddExit("nordosten", ROOM("a0_a5"));
  AddExit("norden", ROOM("a9_a5"));
  AddExit("westen", ROOM("a8_a6"));
  
}

