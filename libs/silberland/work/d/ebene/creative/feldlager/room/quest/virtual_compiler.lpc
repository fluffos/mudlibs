#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include <language.h>
#include "../../files.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, Q_ROOM("") );
  SetProp(P_STD_OBJECT, Q_ROOM("bauplatz"));
  SetProp(P_VALID_NAME, "bauplatz" );
}


string Validate(string file)
{
  string path, name, who;

  file=::Validate(file);
  if ((sscanf(file, "%s:%s", name, who)==2) &&
      name==QueryProp(P_VALID_NAME))
    return file;
}

int CustomizeObject()
{
  string name, foo, who;

  if (!(name=::CustomizeObject()) 
      || sscanf(name, "%s:%s", foo, who)!=2)
    return 0;
  /* previous_object()->AddExit("oben",STADT("turm/turm:"+(which+1)));
  if (which==1)
     previous_object()->AddExit("unten",STADT("turm/turm_r1"));
  else
     previous_object()->AddExit("unten",STADT("turm/turm:"+(which-1)));
  */
  return 1;
}


