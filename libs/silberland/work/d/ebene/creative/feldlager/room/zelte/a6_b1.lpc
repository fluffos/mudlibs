/*
  Eigene Zone: Zelte
*/

#include "../../files.h"
inherit "std/post";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Zelte");
  SetProp(P_INT_SHORT, "Im Postzelt");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich mitten im spaerlich eingerichteten Postzelt"
	 +" im Feldlager. Alles ist hier wohl schnell aufgestellt worden,"
	 +" um keine Zeit zu verlieren."));
  AddDetail(({"zelt", "post", "postzelt"}), BS(
            "Hier im Postzelt kannst Du alles machen was Du in jeder anderen"
	   +" Post auch kannst."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Das Feldlager befindet sich oestlich von Midas."));
  AddDetail("midas", BS(
            "Midas liegt ungefaehr westlich von hier."));
  AddDetail("zeit", BS(
            "Manchmal glaubt man, die Post haette genug Zeit, aber dem ist"
	   +" nicht so."));
  AddDetail("boden", BS(
            "Selbst der Boden sieht spaerlich und karg aus (wie auch immer"
	   +" man sich das vorstellen mag)."));
  AddDetail("decke", BS(
            "Du blickst nach oben an die Decke. Ziemlich langweilig da oben."));


  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);

  AddExit("raus", ROOM("a6_b1"));
}


