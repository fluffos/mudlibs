#include "../files.h"
inherit "/std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf der Ostallee, Kreuzung");
  SetProp(P_INT_LONG, BS(
          "Das hier ist die Kreuzung an der Ostallee, die den Weg von West"
          " nach Ost mit dem Feldlager im Sueden verbindet. Die Allee lichtet"
          " sich ein bisschen im Suedosten, damit der Weg in Richtung Feldlager"
          " auch schoen Platz hat. Noerdlich von Dir kannst Du ein sanftes"
          " Plaetschern ausmachen, scheinbar wird ab hier in Richtung Osten"
          " die Allee von einem kleinen Baechlein begleitet. Weiter nach Norden"
          " gelangst Du in einen grausamen Wald. Am Wegrand siehst"
          " Du ein Schild."));
  AddDetail("kreuzung", BS(
            "Die Kreuzung ist ein wichtiger Knotenpunkt, der die Ostallee"
            " mit dem Weg ins Feldlager verbindet."));
  AddDetail(({"allee", "ostallee"}), BS(
            "Im Norden befindet sich ein kleiner Bach hinter den Baeumen,"
            " suedoestlich von Dir machen die Baeume dem Weg ins Feldlager"
            " Platz."));
  AddDetail(({"baum", "baeume"}), BS(
            "Hinter den Baeumen im Norden hoerst Du einen kleinen Bach vor"
            " sich hin plaetschern.")); 
  AddDetail(({"bach", "baechlein"}), BS(
            "Hinter den Baeumen auf der Nordseite der Ostallee siehst Du ein"
            " froehlich vor sich hinplaetscherndes Baechlein, das eine Biegung"
            " von Ost nach Nord macht. Am Rande des Baechleins siehst Du"
            " eine Sumpfdotterblume wachsen."));
  AddDetail(({"blume", "dotterblume", "sumpfdotterblume"}), BS(
            "Eine wunderhuebsche schoen grad gewachsene Sumpfdotterblume."));
  AddDetail("schild", BS(
            "Lies es mal genau."));
  AddReadDetail("schild",
                "  ________________________\n"
                " /        Ogerwald         \\\n"
                "|            |             |\n"
                "|            +             |\n"
                "|           / \\            |\n"
                "|     Midas     Feldlager  |\n"
                " \\______           _______/\n"
                "        \\___   ___/\n"
                "            | |\n"
                "            | |\n"
                "            | |\n"
                "             -\n\n");
  AddDetail(({"lager", "feldlager"}), BS(
            "Das Feldlager liegt suedlich von hier."));
  AddDetail("weg", BS(
            "Im Suedosten fuehrt der Weg in Richtung Feldlager, im Westen"
            " gelangst Du nach Midas und im Osten gelangst Du vielleicht irgendwann mal in die noch"
            " unentdeckten Gebiete der Gaffos."));
  AddDetail("boden", BS(
            "Auf dem Boden kannst Du nichts besonderes erkennen."));
  AddDetail("midas", "Midas liegt im Westen.\n");
  AddDetail(({"gebiete", "gebiet", "gaffo", "gaffos"}), BS(
            "Wenn Du Dich traust, kannst Du getrost nach Osten gehen."));
  AddDetail("plaetschern", BS(
            "Dem Plaetschern kann man schoen lauschen."));
  AddSound("plaetschern", BS(
           "Du setzt Dich hin und geniesst die Ruhe, die von diesem echt"
           " sanften Plaetschern ausgeht. Du schliesst die Augen und traeumst"
           " von fernen Abenteuern."));
  AddDetail(({"rand", "wegrand"}), BS(
            "Am Wegrand befindet sich ein Schild."));
  AddDetail(({"firmament", "himmel"}), BS(
            "Am Himmel kann man eigentlich nichts besonderes erkennen. Ausser"
            " ein paar vorueberfliegenden Schwalben siehst Du nichts als"
            " azurblauen Firmament.")); 
  AddDetail("schwalben", BS(
            "Die Schwalben fliegen hoch, ein Gewitter duerfte so schnell nicht"
            " kommen."));
  AddDetail(({"wald", "ogerwald"}),
      "Der Ogerwald befindet sich im Norden.");
   
  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst ein sanftes Plaetschern aus dem Norden, ausserdem noch"
           " ein paar Schwalben, die hoch oben vergnuegt zwitschern."));
  AddSound("schwalben", BS(
           "Irgendwie ist da keinerlei Melodie erkennbar, es klingt aber doch"
           " schoen.")); 
  AddSmell(DEFAULT_SMELL, "Du riechst frisch geschnittenes Holz.\n");
  AddSmell("holz", "Der Geruch kommt aus Suedosten.\n");
  
  SetProp(P_LIGHT,1);
  AddExit("suedwesten", ROOM("a2_a3"));
  AddExit("suedosten", ROOM("a4_a3"));
  AddExit("norden", "/d/ebene/lamuerte/wwald/room/9y_23x.lpc");
  AddExit("osten", "/d/ebene/Gaffos/room/room_a05");

  AddCmd(({"pflueck", "pfluecke"}), "get");

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD]));
}

get(str)
{
  notify_fail("Was moechtest Du pfluecken?\n");
  if (!(str=="blume" || str=="sumpfdotterblume"))
    return 0;
  write("Diese Blume ist ausserhalb Deiner Reichweite.\n");
  return 1;
}

