/*
  Eigene Zone: Zelte
*/

#include "../../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#define SCHLACHTFELD_HAILO "/d/ebene/wraz/metzelorgie/npc/hailo"

create()
{
  ::create();

  SetProp(P_ZONE, "Zelte");
  SetProp(P_INT_SHORT, "Im Zelt des Heilers");
  SetProp(P_INT_LONG, BS(
          "Die Sonne scheint hell von aussen herein und erleuchtet den Raum"
          " ziemlich gut. Du siehst hier im Zelt des Heilers in der Mitte"
          " eine Liege stehen, wo die Patienten behandelt werden. An der"
          " Wand steht ein Regal mit diversen Medikamenten und anderen"
          " Utensilien, damit Hailo alles gleich parat hat."));
  AddDetail("sonne", BS(
            "Die Sonne scheint gut von draussen herein und erhellt das"
            " Zelt sehr gut, so dass Hailo immer das beste Licht hier drin"
            " hat."));
  AddDetail("raum", BS(
            "Du befindest Dich im Zelt von Hailo, dem Heiler. Er hat sich der"
            " modernen Medizin verschrieben und auch schon mehrere Buecher"
            " verfasst."));
  AddDetail("buecher", BS(
            "Die Buecher die Hailo verfasst hat, sind alle vergriffen."));
  AddDetail("zelt", BS(
            "Das Zelt besteht aus Zeltplanen, und auf der einen Seite leuchtet"
            " von der Sonne beschienen ein Symbol durch."));
  AddDetail(({"plane", "planen", "zeltplane", "zeltplanen"}), BS(
            "Die Zeltplanen haben auch auf der Innenseite eine weisse Farbe."));
  AddDetail("farbe", BS(
            "Sehr richtig, es sind weisse Zeltplanen."));
  AddDetail(({"symbol", "innenseite", "seite"}), BS(
            "Auf der westlichen Seite des Zelts leuchtet das Symbol, das Du"
            " aussen vielleicht schon bemerkt hast, durch."));
  AddDetail("mitte", BS(
            "In der Mitte des Raumes steht eine Liege. Sie ist in etwa"
            " 120 cm hoch."));
  AddDetail("liege", BS(
            "Auf der Liege werden die Patienten von Hailo behandelt."));
  AddDetail(({"patient", "patienten"}), BS(
            "Sei froh, wenn Du nicht unbedingt ein Patient von Hailo bist,"
            " denn wenn doch, waere irgendetwas mit Dir nicht in Ordnung."));
  AddDetail("ordnung", BS(
            "Bist Du denn auch wirklich in Ordnung?"));
  AddDetail(({"wand", "waende"}), BS(
            "An der oestlichen Wand steht ein Regal, die westliche Seite ist"
            " nicht verstellt, darum siehst Du auf der Zeltplane ein Symbol"
            " durchleuchten."));
  AddDetail(({"medikamente", "medizin"}), BS(
            "Hailo benoetigt fuer seine Patienten auch diverse Medikamente"
            " und Medizin, damit er alle wieder halbwegs gut hinkriegt."));
  AddDetail("regal", BS(
            "Auf dem Regal liegen diverse Medikamente und ein paar Werkzeuge,"
            " die fuer Hailo unbedingt notwendig sind."));
  AddDetail(({"utensilien", "geraet", "werkzeuge"}), BS(
            "Du siehst mehrere sterile Ampullen, ein Stethoskop, Ohrenstaebchen,"
            " Mullbinden, ... Alles was man eben so an medizinischem Geraet"
            " finden kann."));
  AddDetail(({"ampulle", "spritze", "spritzen", "ampullen"}), BS(
            "Nur Hailo ist dazu berechtigt, die Spritzen zu setzen."));
  AddDetail("stethoskop", BS(
            "Damit kann Hailo Deinen Herzschlag ueberpruefen."));
  AddDetail("herzschlag", BS(
            "Lausche doch mal Deinem Herzschlag."));
  AddDetail("herz", BS(
            "Das sitzt bei Dir genau am richtige Fleck."));
  AddDetail("fleck", BS(
            "Du bemerkst einen Fleck auf dem Kittel, der am Regal haengt."));
  AddDetail("kittel", BS(
            "Das ist Hailos Kittel, den er anzieht, wenn er eine schwierige"
            " Operation machen muss."));
  AddDetail("fleck", BS(
            "Auf Hailos Kittel siehst Du einen Fleck."));
  AddDetail(({"staebchen", "ohrenstaebchen"}), BS(
            "Mit den Ohrenstaebchen kann Hailo in Deinen Ohren herumbohren,"
            " damit Du wieder besser horchen kannst."));
  AddDetail("ohren", BS(
            "Davon hast Du zwei."));
  AddDetail(({"binden", "binde", "mullbinde", "mullbinden"}), BS(
            "Falls jemand ernsthaft verletzt ist, hilft Hailo gern mit einer"
            " Mullbinde aus."));
  AddDetail("boden", BS(
            "Auf dem Boden siehst du noch ein paar Kletten liegen."));
  AddDetail("kletten", BS(
            "Die Kletten auf dem Boden stammen wohl von der letzten Entklettung."));
  AddDetail("entklettung", BS(
            "Hailo kann sehr gut entkletten, Du koenntest ihn danach fragen."));
  AddDetail("decke", BS(
            "Durch die Zeltplanen gelangt genug Sonne, um das Zelt ausreichend"
            " auszuleuchten."));
  AddDetail("licht", BS(
            "Es handelt sich bei dem Licht hier drin um Sonnenlicht."));
  AddDetail("sonnenlicht", BS(
            "Das Sonnenlicht kommt vermutlich von der Sonne."));
  AddDetail(({"instrumente"}),
      "Die hat Hailo desinfiziert und dann sorgaeltig verstaut, darum kannst "
      "Du sie nicht sehen.");

  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst den Wind von draussen heftig gegen das Zelt prallen."));
  AddSound("wind", BS(
           "Heftig weht der Wind da draussen, Du bist froh, im Zelt zu sein."));
  AddSound("herzschlag", BS(
            "Du horchst an Deinem Herz. Entsetzt stellst Du fest, dass Du keinen"
            " Herzschlag besitzt. Oha, Du hast an der falschen Seite gelauscht. :)"));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht ganz scharf nach Desinfektionsmittel."));
  AddSmell(({"mittel", "desinfektionsmittel"}), BS(
           "Hailo benoetigt das Mittel um seine Instrumente zu sterilisieren"
           " und auch Wunden zu reinigen."));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);

  AddItem(SCHLACHTFELD_HAILO, REFRESH_DESTRUCT);
  AddExit("raus", ROOM("a5_a0"));
}

