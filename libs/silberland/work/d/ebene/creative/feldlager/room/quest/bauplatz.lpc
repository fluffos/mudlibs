#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../../files.h"

inherit PATH+"std/room";

void create()
{
   if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_INT_SHORT, "Auf dem Bauplatz");
  SetProp(P_INT_LONG, BS(
          "" ));

  // SetProp(P_INDOORS,1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27, ENV_TERRAIN:TT_PLAIN]));

  AddSound(DEFAULT_SOUND, "Das Brausen des Windes ist gedaempft "
		   +"zu hoeren.");
  AddSmell(DEFAULT_SMELL, "Die Luft ist kuehl und belebend.");
  
  AddExit("westen", ROOM("a9_b1"));
  previous_object()->CustomizeObject();
}


