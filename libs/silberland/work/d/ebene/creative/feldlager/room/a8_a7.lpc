/*
  Zone 1: Nordweg
*/

#include "../files.h"

inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include "/d/ebene/creative/ivory_tiger/quest.h"

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Abseits des Weges");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich in einer Art Nische inmitten eines kleinen Waldes."
         +" Am Boden kannst Du einen groesseren Laubhaufen erkennen. Weiter im"
         +" Westen befindet sich das Feldlager, und oestlich von Dir siehst Du"
         +" nur noch ein paar Baeume."));
  AddDetail("himmel", BS(
            "Ober Dir erstreckt sich der Himmel, so blau wie er nur sein kann."));
  AddDetail("weg", BS(
            "Der Weg fuehrt von Westen hierher, und findet hier auch ein Ende."));
  AddDetail("westen", BS(
	    "Weiter im Westen befindet sich das Feldlager."));
  AddDetail(({"lager", "feldlager"}), BS(
	    "Um zum Feldlager zu gelangen musst Du schon weiter nach Westen gehen."));
  AddDetail("ende", BS(
	    "Nun, das Ende des Weges eben. Weiter nach Osten geht es einfach nicht."));
  AddDetail("osten", BS(
	    "Oestlich von Dir siehst Du ein paar Baeume, die Dir den Weg einfach so"
	   +" blockieren."));
  AddDetail(({"baum", "baeume"}), BS(
	    "Die Baeume oestlich von Dir lassen niemand durch. Der Weg endet also genau hier."));
  AddDetail("nische", BS(
	    "Du befindest Dich in einer Art Nische eines kleinen Waeldchens. Oestlich von"
	    +" Dir siehst Du ein paar Baeume, weiter im Westen kannst Du das verlassene"
	    +" Zelt des Waechters erkennen."));
  AddDetail(({"wald", "waeldchen"}), BS(
	    "Die paar Baeume im Osten, so huebsch gruppiert, ergeben schon ein kleines Waeldchen."
	    +" Du denkst Dir, wie huebsch die einzelnen Baeume aussehen."));
  AddDetail("zelt", BS(
	    "Weiter westlich erkennst Du das verlassene Zelt. Langsam daemmert Dir, wieso"
	    +" dort kein Waechter zu finden ist."));
  AddDetail("waechter", BS(
	    "Das Fehlen des Waechters muss etwas mit diesem Raum hier zu tun haben."));
  AddDetail("raum", BS(
	    "Du blickst Dich noch einmal pruefend um, und vermutest, dass es etwas mit dem"
	    +" Laubhaufen auf dem Boden zu tun haben koennte."));
  AddDetail("boden", BS(
	    "Am Boden siehst Du einen groesseren Laubhaufen."));
  AddDetail("art", BS(
	    "Was eine Art ist? Eine Art ist eine Art Spezies."));
  AddDetail("spezies", BS(
	    "Spezies? Spezies ist eine Art Art."));
  AddDetail(({"haufen", "laubhaufen"}), BS(
	    "Am Boden erkennst Du einen groesseren Laubhaufen. Du fragst Dich, was wohl darunter"
	    +" sein mag."));
  AddDetail("laub", BS(
	    "Du schiebst das Laub ein wenig zur Seite, und entdeckst eine Falltuere."));
  AddDetail("seite", BS(
	    "Unauffaellig schiebst Du das Laub wieder zurueck, sah ja richtig unordentlich aus."
	    +" Du denkst . o O (hier? Im Freien?)"));
  AddDetail(({"freien", "freies"}), BS(
	    "Tatsaechlich, Du befindest Dich im Freien, wie man unschwer erkennen kann. Du spuerst"
	    +" den Wind auf Deiner Haut und fuehlst Dich wohl."));
  AddDetail("haut", BS(
	    "Du entdeckst etwas Orangenhaut, als Du Dich genauer betrachtest. Mist, warum hast"
	    +" Du bloss auf das eincremen vergessen?"));
  AddDetail("orangenhaut", BS(
	    "Du stellst fest, dass es sich doch nicht um Orangenhaut handelt. Du atmest erleichtert auf."));
  AddDetail("wind", BS(
	    "Du spuerst den Wind auf Deiner Haut, und denkst Dir, wie angenehm sich das doch anfuehlt."));
  AddDetail("fehlen", BS(
	    "Da fehlt doch was. Bloss was?"));
  AddDetail("augen", BS(
	    "Gottseidank, Du hast ja noch beide Augen im Kopf."));
  AddDetail("kopf", BS(
	    "Du betastest vorsichtig Deinen Kopf. Auch er scheint noch da zu sein wo er hingehoert."));


  AddSound(DEFAULT_SOUND, BS(
           "Das Rauschen der Blaetter auf dem Boden irritiert Dich nicht im geringsten."));
  AddSound("rauschen", BS(
	   "Das Rauschen der Blaetter klingt richtig angenehm. Du schliesst die Augen und traeumst vor Dich hin."));
  AddSound("blaetter", BS(
	   "Nicht nur die Blaetter auf dem Boden rauschen, auch natuerlich die an den Baeumen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Der Laubhaufen am Boden riecht leicht vermodert. Das mag an den feuchten Blaettern liegen."));
  AddSmell(({"laub", "blaetter"}), BS(
	   "Das Laub ist feucht, und drum riecht es ein wenig modrig. Du denkst Dir aber, das passt ja genau."));
  AddSmell(({"laubhaufen", "haufen"}), BS(
	   "Du denkst Dir, dass so ein feuchtes Laub ruhig vermodert riechen darf."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_PLAIN]));
  
  AddExit("westen", ROOM("a7_a7"));

  NewDoor("unten", "/d/ebene/creative/ivory_tiger/room/e5",
          ({"tuer", "tuere", "falltuer", "falltuere"}),
	  ({ D_NAME, "Falltuere", D_GENDER, FEMALE,
	     D_SHORT, "Eine versteckte Falltuere (%s).",
	     D_LONG, BS(
	       "Du siehst unter etwas Laub versteckt eine kleine"
	      +" eiserne Falltuere."),
	     D_FUNC, "loc_d",
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
             D_OPENTESTFUNC, "test_open",
             D_TESTFUNC, "test_through"
	  }));
}

loc_d()
{
  "/obj/doormaster"->SetDoorStatus("/d/ebene/creative/ivory_tiger/room/e5", D_STATUS_LOCKED);
}

test_open()
{
  object k;

  k=present(IV_QUEST_ITEM, TP);
  if (TP->QueryQuest(IV_QUEST) || k)
    return 0;
  write("Du strengst Dich unheimlich an, kannst die Falltuer jedoch nicht oeffnen.\n");
  return 1;
}

test_through()
{
  object k;

  k=present(IV_QUEST_ITEM, TP);
  if (TP->QueryQuest(IV_QUEST) || k)
    return 0;
  write(BS(
        "Verbluefft stellst Du fest, dass sich unterhalb der Falltuere noch ein Gitter"
       +" befindet. Du kannst nicht nach unten klettern."));
  return 1;
}

