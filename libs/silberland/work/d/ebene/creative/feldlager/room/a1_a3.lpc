#include "../files.h"
inherit "/std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf der Ostallee");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich auf der Ostallee, die von Midas in Richtung Osten"
         +" zu den sagenumwobenen neuen Gebieten fuehren soll. Weiter im Osten"
         +" kannst Du schon eine Kreuzung erkennen, im Westen siehst Du das"
         +" Osttor von Midas."));
  AddDetail("boden", BS(
            "Auf dem Boden liegt viel Staub, jedoch sind viele Fussspuren zu"
           +" erkennen. Hier muss wohl reger Betrieb herrschen."));
  AddDetail(({"wetter", "himmel"}), BS(
            "Das Wetter ist heute nicht uebel."));
  AddDetail("decke", "Ist dann im Freien doch nicht so ersichtlich :).\n");
  AddDetail("kreuzung", BS(
            "Die Kreuzung, die weiter im Osten liegt, fuehrt in Richtung Osten"
           +" zum Feldlager, und vielleicht auch in Richtung zu den Gaffos."));
  AddDetail(({"tor", "osttor"}), BS(
            "An den kleinen Fehlern am Tor merkst Du, dass hier vor kurzem noch Handwerker"
           +" fleissig gearbeitet haben."));
  AddDetail("fehler", "Kleine Fehler im Mauerwerk.\n");
  AddDetail(({"werk", "mauerwerk"}), BS(
              "Es sieht so aus, als waere das Tor noch nicht lange offen."
             +" Die kleinen Fehler im Tor deuten darauf hin, dass das Tor erst"
             +" im Nachhinein auch den Durchgang gekriegt hat."));
  AddDetail("durchgang", "Der Durchgang fuehrt nach Westen in die Stadt Midas.\n");
  AddDetail(({"spuren", "fussspuren"}), BS(
            "Du siehst ein Durcheinander von lauter Spuren im Staub. Die meisten"
           +" fuehren verwunderlicherweise nach Osten."));
  AddDetail("staub", BS(
            "Im Staub kannst Du ein paar besondere Spuren erkennen. Daneben siehst"
           +" Du noch eine eigenartige Faehrte."));
  AddDetail("faehrte", BS(
            "Die Faehrte kommt von Osten hierher, stoppt aber knapp vor dem Tor."
           +" Wahrscheinlich handelt es sich bei diesen Spuren um Wesen, die Midas"
           +" erforschen wollten, sich aber nicht in die Zivilisation getraut haben."
           +" Absonderlich erscheint Dir die Groesse der Spuren."));
  AddDetail("zivilisation", "Die Zivilisation gibts erst mal westlich von Dir.\n");
  AddDetail(({"groesse", "stapfen", "fussstapfen"}), BS(
            "Die einzelnen Fussstapfen haben schon eine beachtliche Groesse"
           +" von ca. 30-40 cm... Worum es sich hier handeln koennte?"));
  AddDetail(({"gaffo", "gaffos"}), BS(
            "Erstens siehst Du hier keine Gaffos, zweitens sind sie hoechstwahrscheinlich weiter im"
           +" Osten zu finden."));
  AddDetail("gebiete", BS(
            "Hast Du denn noch gar nichts von den Geruechten gehoert?"));
  AddDetail(({"stadt", "midas"}), "Midas liegt westlich von Dir.\n");
  AddDetail(({"allee", "ostallee"}), BS(
            "Die Ostallee ist an und fuer sich ihren Namen gar nicht wert,"
           +" da die Baeume, die sie umsaeumen eigentlich ueberhaupt nicht"
           +" praechtig und schoen aussehen, wie man sich das doch eigentlich"
           +" von einer Allee erwartet."));
  AddDetail(({"baum", "baeume"}),BS(
            "Eine reichliche Vielzahl von merkwuerdigen Baeumen."));
  AddDetail("vielzahl", BS(
            "An und fuer sich ist Vielzahl uebertrieben. Eigentlich sind"
           +" es ja nur Weiden."));
  AddDetail(({"trauerweiden", "weiden"}), "Trauerweiden.\n");
  AddDetail("geruechte", "Denen sollte man doch lauschen, oder?\n");
  AddSound("geruechte", BS(
           "Jemand wispert Dir ins Ohr: Da in der Ferne soll es"
          +" zu den Gaffos gehen!"));
  AddSound(DEFAULT_SOUND, BS(
           "Von Westen her droehnt das emsige vertraute Stimmengewirr, das"
          +" man in jeder Stadt findet."));
  AddSound(({"stimmengewirr", "gewirr"}), "Du kannst eine Stimme naeher fixieren.\n");
  AddSound(({"frau", "stimme"}), BS(
           "Als Du die Stimme naeher fixierst, hoerst Du eine Frau schimpfen:"
          +" 'Diese bloeden Gaffos!! Die klauen einem wirklich alles!'"));
  AddSmell(DEFAULT_SMELL, "Irgendwie riecht es hier streng.\n");
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN: TT_ROAD]));
  AddExit("westen", "/d/ebene/Midas/room/room_h5");
  AddExit("osten", "/d/ebene/creative/feldlager/room/a2_a3");
}
