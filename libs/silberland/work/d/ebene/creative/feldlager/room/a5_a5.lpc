/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Steppe, Weggabelung");
  SetProp(P_INT_LONG, BS(
          "Du stehst an der Weggabelung mitten in der Steppe. Das Gras ist"
          " hier schon ziemlich hoch, Du kannst eigentlich nicht erkennen,"
          " wo die beiden Wege suedlich von Dir hinfuehren, ausser, dass der"
          " eine nach Suedosten und der andere nach Suedwesten abzweigt. Im"
          " Nordwesten gelangst Du zurueck zur Ostallee."));
  AddDetail(({"weg", "weggabelung", "wege"}), BS(
            "Hier ist der Boden besonders ausgetreten, es duerfte sich um"
            " eine eher wichtige Kreuzung handeln."));
  AddDetail("kreuzung", BS(
            "An der Kreuzung steht ein Briefkasten."));
  AddDetail("boden", BS(
            "Der Boden ist ziemlich festgetreten von den vielen Wesen, die"
            " hier vorbeigekommen sind."));
  AddDetail("himmel", BS(
            "Der Himmel ist einheitlich diesig graublau, die Sonne steht"
            " hoch droben am Firmament."));
  AddDetail(({"firmament", "sonne"}), BS(
            "Die Sonne brennt vom Himmel herab, jedoch ist Dir nicht so richtig"
            " heiss."));
  AddDetail(({"kasten", "briefkasten"}), BS(
            "Bei dem Briefkasten duerfte es sich um die Sammelstelle der Post"
            " des Feldlagers handeln. Neben dem Briefkasten steht eine"
            " Anschlagtafel."));
  AddDetail("gras", BS(
            "Das Gras ist hier schon ziemlich hoch, von der Sonne ausgebleicht."));
  AddDetail("steppe", BS(
            "Du befindest Dich schon mitten drin, in der Steppe. Es ist eigentlich"
            " alles so, wie man es sich von einer Steppe vorstellt. Das Gras ist"
            " ausgebleicht, der Boden festgestampft, ein leichter Wind geht."));
  AddDetail("wind", BS(
            "Du siehst den Wind nicht, aber Du spuerst ihn.")); 
  AddDetail("nachricht", BS(
            "Syntax: lies <nr>"));
  AddDetail("grillen", BS(
            "Grillen kann man lauschen."));
  AddDetail(({"ostallee", "allee", "nordwesten"}),
      "Im Nordwesten gelangst Du zurueck zur Ostallee.");

  AddSound(DEFAULT_SOUND, BS(
           "Ausser ein paar Grillen, die im hohen Gras zirpen, ist nichts zu"
           " hoeren."));
  AddSound(({"grille", "grillen"}), BS(
           "Ganz schoen laut, wie Zirpen grillen koennen. :)")); 
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst Rindsuppe."));
  AddSmell(({"suppe", "rindsuppe"}), BS(
           "Im Feldlager duerfte gekocht werden. Koestlich, wie das duftet."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN]));

  AddItem(OBJ("tafel"));

  AddExit("nordwesten", ROOM("a4_a4"));
  AddExit("suedosten", ROOM("a6_a6"));
  AddExit("suedwesten", ROOM("a4_a6"));
  AddExit("osten", ROOM("a6_a5"));
}

