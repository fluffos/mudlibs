/*
  Zone 4: Klubhaus
*/

#include "../../files.h"
inherit "std/laden";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Klubhaus");
  SetProp(P_INT_SHORT, "Im Pfadfinderladen");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich mitten im Greisslerzelt, im Herz des Feldlagers."
	 +" Hier finden sich so einige interessante Objekte, die allerlei"
	 +" Abnehmer finden. An einer Wand haengt eine Tafel." ));
  AddDetail(({"zelt", "greisslerzelt"}), BS(
            "Du stehst mitten darin."));
  AddDetail("herz", BS(
            "Dein Herz schlaegt! Wie schoen..."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Du bist im Greisslerzelt inmitten des Feldlagers."));
  AddDetail("objekte", BS(
            "Fuer eine Liste der aktuell erhaeltlichen Objekte tippe <zeige>."));
  AddDetail("boden", BS(
            "Am Boden findest Du noch die Spuren verschiedener Objekte."));
  AddDetail(({ "wand", "waende"}), BS(
            "An einer Wand haengt eine Tafel."));
  AddDetail("spuren", BS(
            "Der Boden ist ziemlich schmutzig, Du siehst einfach nicht genau, was fuer Spuren das sind."));
  AddDetail("decke", BS(
            "In einem Zelt kann man nicht von Decke sprechen."));
  
  AddDetail( ({"tafel"}),
    "Die Tafel haengt an einer Wand. Du kannst sie lesen.");
  AddDetail("abnehmer", BS(
            "Wenn Du etwas kaufst, bist Du auch ein Abnehmer."));
  AddReadDetail ( ({"tafel"}),
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<zeige> rue|ver   Uebersicht ueber Ruestungen/Verschiedenes\n"
    "<zeige> panzer|helm|umhang|ring|....  \n"
    "                  Uebersicht ueber die jeweiligen Ruestungsarten.\n"
    "<unt> nummer      Gibt die Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
    "<versetze> etwas  Du verkaufst einen Gegenstand, auch wenn Dir der\n"
    "                  Haendler nicht den vollen Preis dafuer bezahlen will.\n"
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");


  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst die Zeltplanen aneinanderschlagen."));
  AddSound(({"plane", "planen", "zeltplane", "zeltplanen"}), BS(
           "Das ist aber kein lautes Geraeusch."));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht hier wie in einem Laden. Tausend Gerueche von ueberall her."));
  AddSmell("gerueche", BS(
           "Es sind so viele, dass man keinen besonderen ausmachen kann."));
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp(P_INDOORS, 1);
  SetStorageRoom(ROOM("klubhaus/lager"));
  
  AddExit("sueden", ROOM("klubhaus/st_1"));
}


