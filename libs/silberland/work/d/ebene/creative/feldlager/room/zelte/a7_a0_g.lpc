/*
  Eigene Zone: Zelte
*/

#include "../../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#define HOR_COST 60

object horvic;

create()
{
  ::create();

  SetProp(P_ZONE, "Zelte");
  SetProp(P_INT_SHORT, "Im Zelt der Sterndeuterin");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich im Zelt von Sedda, der Sterndeuterin. Die"
	 +" Zeltplanen sind auch von innen gelb, die Einrichtung hier ist im"
	 +" Grunde karg. In der Mitte des Raumes befindet sich ein Tisch,"
	 +" davor steht ein Besucherstuhl. An der einen Wand befindet sich"
	 +" ein Regal mit allerlei interessanten Dingen drauf, an der anderen"
	 +" Wand steht eine Truhe. Ueber der Truhe siehst Du eine Tafel."
	 +" Wenn Du nach oben blickst, kannst Du gut"
	 +" erkennen, dass eine Art Klappe aus Zeltplanen ueber Dir befestigt"
	 +" ist."));
  AddDetail("einrichtung", BS(
            "Wie fuer ein Zelt, das nicht fuer immer aufgeschlagen ist,"
	   +" eigentlich zu erwarten ist, ist die Einrichtung eher spaerlich"
	   +" und karg."));
  AddDetail("zelt", BS(
            "Du befindest Dich im Zelt von Sedda, der Sterndeuterin."));
  AddDetail(({"klappe", "planen", "zeltplanen", "plane", "zeltplane"}), BS(
            "Ueber Dir siehst Du eine Zeltplane, die im Bedarfsfall auch"
	   +" weggenommen werden kann, um die Sterne zu beobachten."));
  AddDetail("sterne", BS(
            "Jetzt am Tag wirst Du keine Sterne finden."));
  AddDetail(({"kugel", "kristallkugel"}), BS(
            "Im Zelt muss irgendwo eine Kristallkugel zu finden sein. Vermutlich"
           +" hat Sedda eine."));
  AddDetail("tafel", BS(
            "Man kann die Tafel auch lesen."));
  AddReadDetail("tafel", BS(
                "Du siehst: \"Horoskope! Nur "+HOR_COST+" Muenzen!\""));
  AddDetail("tag", BS(
            "Es ist hellichter Tag."));
  AddDetail(({"wand", "waende"}), BS(
            "An der einen Wand befindet sich ein Regal, an der anderen steht"
	   +" eine Truhe."));
  AddDetail("regal", BS(
            "Auf dem Regal mit 4 Faechern siehst Du allerlei merkwuerdige"
	   +" Dinge, darunter eine Wurzel, einen Kristall, eine Dose, ein"
	   +" Glas mit einer braunen Fluessigkeit und ein dicker Stapel"
	   +" Buecher."));
  AddDetail(({"faecher", "fach"}), BS(
            "Das Regal hat 4 Faecher, auf denen einige Dinge liegen."));
  AddDetail("dinge", BS(
            "Rund um Dich liegen viele interessante Dinge, vor allem auf dem Regal."));
  AddDetail("wurzel", BS(
            "Man koennte meinen, es handle sich um eine Wurzel eines aeusserst"
	   +" seltenen Krauts."));
  AddDetail(({"feenwaerterkraut", "kraut"}), BS(
            "Es wird sich wohl um ein Feenwaerterkraut handeln."));
  AddDetail("kristall", BS(
            "Der Kristall ist zierlich anzusehen und dient nur als"
	   +" Briefbeschwerer."));
  AddDetail("briefbeschwerer", BS(
            "Der Briefbeschwerer hat die Form eines Wuerfels und besteht aus"
	   +" reinstem Kristall."));
  AddDetail("wuerfel", BS(
            "Ein Wuerfel mit sechs Seiten, aus Kristall."));
  AddDetail("seiten", BS(
            "Auf den Seiten des Wuerfels sind kleine Tiere eingraviert."));
  AddDetail("tiere", BS(
            "Du kannst nicht genau erkennen, um welche Tiere es sich handelt."));
  AddDetail("mitte", BS(
            "In der Mitte des Raumes befindet sich ein Tisch."));
  AddDetail("tisch", BS(
            "Du siehst einen massiven Tisch in der Mitte des Raumes stehen."
	   +" Unterhalb der Tischplatte befindet sich eine klemmende Schublade"
	   +" und vor dem Tisch siehst Du einen Besucherstuhl."));
  AddDetail("tischplatte", BS(
            "Unterhalb der Tischplatte befindet sich eine hoffnungslos verklemmte"
	   +" Schublade."));
  AddDetail("boden", BS(
            "Hier auf dem Boden steht ein Tisch und ein Stuhl."));
  AddDetail("decke", BS(
            "Oben an der Decke siehst Du eine Klappe."));
  AddDetail(({"stuhl", "besucherstuhl"}), BS(
            "Auf den Stuhl koennen sich Leute setzen, die von Sedda etwas"
	   +" wissen wollen."));
  AddDetail("dose", BS(
            "Auf der Dose steht: Dose."));
  AddDetail("glas", BS(
            "Im Glas schwimmt eine scheussliche braune Fluessigkeit."));
  AddDetail("fluessigkeit", BS(
            "Irgendwie erinnert Dich die Fluessigkeit an Schlamm."));
  AddDetail("schlamm", BS(
            "Ja, tatsaechlich, auf dem Glas etwas abseits steht: \"Schlamm\""));
  AddDetail(({"lade", "schublade"}), BS(
            "Die Schublade klemmt."));
  AddDetail(({"stapel", "buecher", "buch"}), BS(
            "Die Buecher liegen mit dem Buchruecken zur Wand, leider kannst"
	   +" Du die Buchtitel nicht sehen."));
  AddDetail(({"ruecken", "buchruecken"}), BS(
            "Auf dem Ruecken eines Buches steht meist der Buchtitel."));
  AddDetail(({"titel", "buchtitel"}), BS(
            "Ein Buchtitel gibt Auskunft ueber den Inhalt eines Buches."));
  AddDetail("inhalt", BS(
            "Ein Buch ohne Inhalt haette wenig Sinn."));
  AddDetail("sinn", BS(
            "Genausowenig Sinn hat Dein Untersuchen bis ins kleinste Detail."));
  AddDetail("detail", BS(
            "Von denen hast Du wenn Du bis hierher gelangt bist, schon"
	   +" massig viel untersucht. :-)"));
  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst die Fluessigkeit im Glas leise schwappen."));
  AddSound("fluessigkeit", BS(
           "*schwapp*"));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht etwas faulig nach Schlamm."));
  AddSmell("schlamm", BS(
           "Schlamm riecht ja im allgemeinen etwas modrig, und dieser hier"
	  +" besonders."));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);

  seteuid(getuid(this_object()));
  AddItem(NPC("sedda"), REFRESH_REMOVE);
  AddItem(OBJ("truhe"), REFRESH_NONE);
  AddExit("raus", ROOM("a7_a0"));
  AddCmd(({"kaufe", "kauf"}), "hor");
  horvic=0;
}

reset()
{
  if (!present("sedda"))
    call_other(present("truhe"), "restart_items");
  ::reset();
}

hor(string str)
{
  notify_fail("Hier gibt es nur Horoskope zu kaufen.\n");
  if (str!="horoskop")
    return 0;
  notify_fail("Da musst Du schon warten, bis Sedda wieder da ist.\n");
  if (!present("sedda"))
    return 0;
  notify_fail("Hier bekommt gerade jemand die Sterne gedeutet.\n");
  if (horvic)
    return 0;
  notify_fail("Du hast nicht genug Geld.\n");
  if (TP->QueryMoney()<HOR_COST)
    return 0;
  TP->AddMoney(-HOR_COST);
  present("truhe")->AddMoney(HOR_COST);
  tell_room(TO, "Sedda legt das Geld in ihre Truhe.\n");
  write("Du nimmst Platz.\n");
  say(TPN+" nimmt Platz auf dem Besucherstuhl.\n");
  call_out("hor2", 1);
  horvic=TP;
  return 1;
}


hor2()
{
  write("Sedda beschwoert Dich: Du wirst muede... endlos muede...\n");
  horvic->SetProp(P_PARALYZED, ([
        PARALYZE_MSG: "Du bist muede.\n",
        PARALYZE_END: "",
        PARALYZE_END_OTHER: "",
        PARALYZE_TIME: 15, ]) );
  call_out("hor3", 4);
  return 1;
}

hor3()
{
  write("Sedda wirft einen intensiven Blick in ihre Kristallkugel.\n");
  call_out("hor4", 5);
  return 1;
}

#define GEN horvic->QueryProp(P_GENDER)
#define MAR horvic->QueryProp(P_MARRIED)
#define RAC ({"Elfen", "Zwergen", "Menschen", "Hobbits", "Trolle", "Oger", "Feen", "Dunkelelfen"})[random(8)]
// #define KIL horvic->QueryProp(P_LAST_KILLER) // Das geht net weil das 0 sein kann und ein object ist -> bad arguemtn to + is die folge
#define PLANET ({ "Venus", "Jupiter", "Mars", "Merkur", "Pluto"})[random(5)]
#define ZEICHEN ({ "Steinbock", "Wassermann", "Jungfrau", "Fische", "Skorpion", \
                   "Schuetze", "Loewe", "Widder", "Krebs", "Waage", "Zwilling", \
		   "Stier" })[random(12)]
#define HOR_LOVE \
  ({ \
     "Du wirst bald eine"+(GEN==MALE?"":"n")+" nette"+ \
     (GEN==MALE?" Frau":"n Mann")+" kennenlernen.\n", \
    "Derzeit sieht es ganz schlecht aus in Sachen Liebe...\n", \
    "Wie, Du bist"+(MAR?" ja schon":" noch nicht")+" verheiratet!?\n", \
    "Hast Du schon mal an "+(MAR?"Scheidung":"Heirat")+" gedacht?!\n", \
    "In Dir erwachen bald Fruehlingsgefuehle...\n", \
    "Die Sterne sagen mir, dass Du bald bei den "+RAC+  \
    " den heimatlichen Hafen der Ehe ansteuern wirst.\n", \
    "Das ist kein gutes Zeichen... "+PLANET+" und "+PLANET+" stehen"+ \
    " in keiner guten Konstellation...\n", \
    "Hmmm... "+PLANET+" im "+sprintf("%d", random(3)+2)+ \
    ". Hof im Zeichen "+ZEICHEN+"...\n", \
    "Kennst Du denn einen suessen Partner im Zeichen "+ZEICHEN+"?!\n", \
    "Mit einem Partner im Zeichen "+ZEICHEN+" hast Du diesen Monat kein Glueck...\n", \
    PLANET+" macht mir ernsthafte Sorgen!\n", \
    "Wo zum Teufel steckt denn "+PLANET+" schon wieder?\n", \
    "Machst Du Dir was aus "+RAC+"?\n", \
    "Die "+RAC+" werden diesen Monat besonders viel von Amors Pfeilen "+ \
    "verschiessen, vielleicht auch zu Dir...\n", \
    RAC+" sind um diese Jahreszeit besonders zaertlich.\n", \
  })
#define HOR_FIGHT \
  ({ \
     "Du wirst ganz erfolgreich Deine naechsten Kaempfe bestehen.\n", \
     "Hast Du bestimmt die richtige Ausruestung gewaehlt?\n", \
     "Also den Balrog wuerde ich in naechster Zeit nicht waehlen.\n", \
     "Du kannst mit gutem Gewissen einen Knarkhisten toeten.\n", \
     "Elsurion? Bist Du WAHNSINNIG?\n", \
     "Also ohne Mordorschwert kannst Du hoechstens Ameisen killen...\n", \
     "Vergiss nicht auf ein Schild!\n", \
     "Verlass Dich lieber auf das Plaudern... Kein Grund zum sinnlosen Toeten.\n", \
     PLANET+" hat gewaltige Auswirkung auf Deine Waffe!\n", \
     "Huete Dich vor Gegnern im Zeichen "+ZEICHEN+"!\n", \
     "Halt Dich von boesen Monstern fern... sie bringen nichts Gutes!\n", \
     "Lass doch die unschuldigen Soeldner in Ruhe.\n", \
     "Irgendwo wirst Du die geniale Ruestung finden!\n", \
     "Hast Du schon mal was von Verteidigung gehoert?\n", \
     "Also die naechste Zeit wird hart fuer Dich...\n", \
     "Deine Tode werden sich vervielfachen :(\n", \
     "Jetzt, schlag zu! "+ZEICHEN+" zu sein ist keine Schande.\n", \
     "Du musst unbedingt mit "+RAC+" zusammenarbeiten.\n", \
     RAC+" werden Dir im Kampf behilflich sein.\n", \
  })

// "Lass Dich ja nie wieder mit sowas wie "+KIL+" ein!\n", \ das macht einen bug!!
#define HOR_MON \
  ({ \
     "Du wirst in Kuerze viel Geld haben.\n", \
     "Deine laeppischen paar Muenzlein sind in Kuerze weg.\n", \
     "Der Neid-Klau-Sammli wird vor Dir nicht Halt machen.\n", \
     "Dein Bankkonto kannst Du abschreiben... :(\n", \
     "Gib den armen Wesen ein wenig Geld, es wird sich auszahlen.\n", \
     "Ueberlass Dein Gold nur "+PLANET+"!\n", \
     PLANET+" sagt ganz deutlich, es wird nur alles teurer.\n", \
     "Die Laeden wollen Dein Geld nicht...\n", \
     "Du solltest Selbstmord ins Auge fassen. "+PLANET+" verheisst nur Negatives.\n", \
     "Tja, in Kuerze schwimmst Du im Gold!\n", \
     "Du solltest bald einen Kredit beantragen...\n", \
     "Genial! "+PLANET+" und "+PLANET+" im Zeichen "+ZEICHEN+ \
     " sagen, dass Du reich wirst!\n", \
     "Dein Bankkonto wird Dir zu klein...\n", \
     "Ohne auf "+ZEICHEN+" zu schimpfen. Aber bei "+RAC+" ists derzeit "+ \
     "einfach leichter.\n", \
     "Musstest Du unbedingt bei "+RAC+" Geld leihen?\n", \
     RAC+" kennen keine Gnade wie Du weisst... Du wirst ausgeraubt.\n", \
  })

hor4()
{
  int i, j, r, t;
  mixed *h;
  string *h2;
  int *type;

  h=({ HOR_LOVE, HOR_FIGHT, HOR_MON });
  type=({1, 2, 3});
  for (j=random(10)%3; j>=0; j--) {
    t=random(sizeof(h));
    h2=h[t];
    for (i=random(2)+1; i>=0; i--) {
      r=random(sizeof(h2));
      tell_object(horvic, break_string(h2[r], 78, 
            (type[t]==1?" LIEBE> ":(type[t]==2?" KAMPF> ":" GELD> "))));
      h2-=({h2[r]});
    }
    h-=({h[t]});
    type-=({type[t]});
  }
  if( file_size("/d/ebene/lamuerte/brunnen/logs/top/stats/"+getuid(horvic)+".log")>0 )
    call_out("hor_well", 3);
  else
    call_out("hor5", 3);
  return 1;
}

hor_well()
{
  object fey;
  if (objectp(fey = find_player("feyaria")))
    tell_object(fey, "[Brunnen:] " + horvic->Name(WER,1) + 
        " bekommt Brunnen-Hosorkop von Sedda.\n");
  write(read_file("/d/ebene/lamuerte/brunnen/logs/top/stats/"+getuid(horvic)+".log"));
  call_out("hor5", 3);
}


hor5()
{
  write("Sedda schnippt in die Finger und Du erwachst wieder.\n");
  say(horvic->QueryProp(P_NAME)+" erwacht als Sedda mit den Fingern schnippt.\n");
  horvic->SetProp(P_PARALYZED, 0);
  horvic=0;
  return 1;
}

