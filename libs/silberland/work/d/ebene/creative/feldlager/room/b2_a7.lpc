/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#define GATE_SROOMS ({ "/d/ebene/creative/feldlager/room/b2_a7", \
                       "/d/ebene/creative/ivory_tiger/room/s1", \
                       "/d/ebene/creative/ivory_tiger/room/s2" })
#define TRYDELAY 8

int *which_open;
int *old_open;
int hebel;

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Vor einem Gittertor");

  SetProp(P_INT_LONG, BS(
          "Erstaunlich. Du traust kaum Deinen Augen... Hier vor Dir, in"
         +" nordwestlicher Richtung ausgerichtet, siehst Du ein hohes,"
         +" mit fiesen Dornen uebersaetes schmiedeeisernes Gittertor. Mitten"
         +" in der Landschaft. Das Tor mit dem eigenartigen Schluesselloch"
	 +" fasziniert Dich so sehr, dass Du kaum"
         +" noch einen Blick auf den Busch neben Dir werfen kannst."));
  AddDetail(({"loch", "schluesselloch"}), BS(
            "Das Schluesselloch ist zugeschweisst."));
  AddDetail("augen", BS(
            "Du hast... Zwei?"));
  AddDetail(({"richtungen", "richtung"}), BS(
            "Richtungen siehst Du viele. Aber nur eine ist fesselnd."));
  AddDetail("dornen", BS(
            "Diese Dornen wuerden Dich im Nu TOETEN, sofern Du jemals"
	   +" ueber das Tor gelangen koenntest."));
  AddDetail("landschaft", BS(
            "Von der Steppe, aus der Du soeben gekommen bist, ist hier noch"
	   +" genausoviel zu merken wie in all den andren steppigen Gebieten."));
  AddDetail(({"gebiete", "gebiet", "steppe"}), BS(
            "Ja, sehr wohl, Du befindest Dich mitten in steppigem Gebiet."));
  AddDetail("blick", BS(
            "Dein Blick kann sich einfach nicht von dem Tor loesen, so"
	   +" ungewoehnlich ist seine Praesenz."));
  AddDetail("praesenz", BS(
            "Du ueberzeugst Dich, dass Du auch wirklich nicht traeumst."
	   +" Tatsaechlich. Das Tor ist und bleibt ein Tor."));
  AddDetail("busch", BS(
            "Mitten in dem Busch befindet sich ganz versteckt ein kleiner Hebel."));
  AddDetail("hebel", BS(
            "Der Hebel laesst sich sicherlich ziehen."));
  AddDetail("boden", BS(
            "Auf den Boden kannst Du gar nicht schauen. Du siehst nur das Tor."));
  AddDetail("himmel", BS(
            "Der Himmel ist laengst nicht so interessant wie das Tor."));
  AddDetail("sonne", BS(
            "Hm, die Sonne ist sicher wie immer. Also warum nicht sich auf das"
	   +" Tor konzentrieren."));
  AddDetail("weg", BS(
            "Jaja, auf dem Weg bist Du hergekommen. Aber das Tor ist viiiel"
	   +" wichtiger."));

  AddSound(DEFAULT_SOUND, BS(
           "Ausser dem Pfeifen des Windes durch das Tor hoert man nichts."));
  AddSound(({"pfeifen", "wind", "tor"}), BS(
           "Es ist doch nur ganz ganz leise."));

  AddSmell(DEFAULT_SMELL, BS(
           "Der Busch neben Dir riecht etwas streng."));
  AddSmell("busch", BS(
           "Ah, ein streng riechender Busch!"));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  
  AddExit("sueden", ROOM("b2_a8"));

  NewDoor("nordosten", "/d/ebene/creative/ivory_tiger/room/s1",
          ({"tor", "gittertor"}),
	  ({ D_NAME, "Gittertor", D_GENDER, NEUTER,
	     D_SHORT, "Ein hohes Gittertor (%s).",
	     D_LONG, BS(
	       "Ein hohes, mit fiesen Dornen besetztes schmiedeeisernes"
	      +" Gittertor, das nach Nordwesten fuehrt."),
	     D_FUNC, "loc_d",
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY
	  }));
  AddCmd(({"kletter", "klettere"}), "kl");
  AddCmd(({"zieh", "ziehe"}), "pull");

  which_open=allocate(3);
  old_open=allocate(3);
  hebel=0;
}


shake_doors()
{
  int i;

  for (i=0; i<3; i++) {
    old_open[i]=which_open[i];
    which_open[i]=random(100)%2;
  }
}

reset()
{
  int i;

  ::reset();
  hebel=0;
  for (i=0; i<3; i++) {
    if (old_open[i])
      tell_room(GATE_SROOMS[i], "Das Tor schliesst sich geraeuschlos.\n");
    GATE_SROOMS[i]->loc_d();
  }
  tell_room(TO, BS("Der Hebel bewegt sich quietschend in seine"
                  +" Ausgangsposition zurueck."));
}

kl(str)
{
  notify_fail("Worueber willst Du klettern?\n");
  if (!str && str!="ueber tor" && str!="ueber gittertor")
    return 0;
  write(BS("Keine Chance, die Dornen sind zu spitz. Keine Ruestung der Welt"
       +" koennte Dich vor ihnen schuetzen."));
  return 1;
}

pull(str)
{
  int i;
  string s;

  notify_fail("Was willst Du ziehen?\n");
  if (!str)
    return 0;
  if (str!="hebel")
    return 0;
  notify_fail(BS(
              "Der Hebel wurde schon betaetigt, nun ruehrt er sich nicht mehr."));
  if (hebel)
    return 0;
  hebel++;
  write("Du ziehst kraeftig an dem Hebel, der sofort einrastet.\n");
  say(TPN+" zieht kraeftig an einem Hebel, der sofort einrastet.\n");
  shake_doors();
  for (i=0; i<3; i++) {
    if (old_open[i])
      tell_room(GATE_SROOMS[i], "Das Tor schliesst sich geraeuschlos.\n");
    GATE_SROOMS[i]->loc_d();
  }
  s="Du hoerst";
  for (i=0; i<3; i++)
    if (which_open[i]) {
      s+=" klick";
      tell_room(GATE_SROOMS[i], "Das Tor oeffnet sich auf wundersame Weise.\n");
      GATE_SROOMS[i]->unl_d();
    }
    else
      s+=" ...";
  s+=".";
  write(BS(s));
  call_out("drs", TRYDELAY);
  return 1;
}

unl_d()
{
  "/obj/doormaster"->SetDoorStatus("/d/ebene/creative/ivory_tiger/room/s1", D_STATUS_OPEN);
}

loc_d()
{
  "/obj/doormaster"->SetDoorStatus("/d/ebene/creative/ivory_tiger/room/s1", D_STATUS_LOCKED);
}

drs()
{
  while (!remove_call_out("drs")) ;
  hebel=0;
  tell_room(TO, BS("Der Hebel bewegt sich quietschend in seine"
                  +" Ausgangsposition zurueck."));
}

