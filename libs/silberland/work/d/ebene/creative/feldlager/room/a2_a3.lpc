#include "../files.h"
inherit "/std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int weather;
int gecko;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf der Ostallee");
  SetProp(P_INT_LONG, BS(
          "Der Weg hier auf der Ostallee fuehrt von Westen nach Osten."
         +" Im Westen kannst Du noch die Umrisse des Osttores von Midas"
         +" erkennen, weiter im Nordosten siehst Du eine Kreuzung."));
  AddDetail("kreuzung", BS(
            "Geh ein Feld weiter nach Nordosten und Du kannst sie Dir naeher"
           +" betrachten."));
  AddDetail("boden", BS(
            "Auf dem Boden kannst Du mehrere Spuren im Staub erkennen. Eine"
           +" Spur interessiert Dich besonders."));
  AddDetail("staub", BS(
            "Im Staub sieht man nichts weiter als ein paar Spuren."));
  AddDetail(({"spur", "spuren"}), BS(
            "Es sieht aus wie ein ovaler Fussabdruck eines Dir nicht bekannten"
           +" Wesens. Der Abdruck ist mindestens 30-40 cm lang und sieht"
           +" ziemlich furchterregend aus."));
  AddDetail("weg", BS(
            "Hier befindest Du Dich auf der Ostallee."));
  AddDetail(({"allee", "ostallee"}), BS(
            "Die Ostallee fuehrt im Westen von Midas aus direkt nach Osten"
           +" zu den unerforschten Gebieten."));
  AddDetail(({"baum", "baeume"}), BS(
            "Eine Allee besteht aus Baeumen."));
  AddDetail(({"gebiet", "gebiete"}), BS(
            "Viele Geruechte ranken sich um die neu entdeckten aber noch nicht"
           +"erforschten Gebiete im Osten."));
  AddDetail(({"abdruck", "fussabdruck"}), BS(
            "Der Fussabdruck sieht furchterregend aus."));
  AddDetail(({"umriss", "umrisse", "osttor", "tor"}), BS(
            "Weiter im Westen liegt noch das Osttor von Midas, aber mehr als"
           +" die Umrisse kannst Du nicht erkennen.")); 
  AddDetail(({"geruecht", "geruechte"}), BS(
            "Hier findest Du sie nicht, die Geruechte."));
  AddSpecialDetail("himmel", "heaven");
  AddSound(DEFAULT_SOUND, BS(
           "Ausser ein paar Geraeuschen ist nichts zu hoeren."));
  AddSound(({"geraeusch", "geraeusche"}), BS(
           "Du horchst genauer hin. Du hoerst sanft im Winde die Blaetter"
          +" rauschen."));
  AddSound(({"blatt", "blaetter"}), BS(
           "Du konzentrierst Dich etwas und siehst einen merkwuerdigen Busch"
          +" neben dem Weg."));
  AddDetail("busch", BS(
            "Du siehst nichts genaues, aber wenn man vielleicht die Zweige"
           +" auseinanderbiegt?"));  
  AddDetail(({"zweig", "zweige"}), BS(
            "Durch die Zweige kann man noch nichts genaues erkennen. Bieg sie"
           +" doch einmal auseinander."));
  AddSmell(DEFAULT_SMELL, "Es riecht nach Hundescheisse.\n");
  AddSmell(({"scheisse", "hundescheisse"}), BS(
           "Na, wie soll Hundescheisse schon riechen. Eklig :)"));
  SetProp(P_LIGHT,1);
  AddExit("westen", ROOM("a1_a3"));
  AddExit("nordosten", ROOM("a3_a2"));
  AddCmd(({"bieg", "biege"}), "bieg");

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD]));
  weather=0;
  gecko=1;
}

init()
{
  ::init();
  weather=random(4);
}

reset()
{
  ::reset();
  gecko=1;
}

bieg(str)
{
  notify_fail("Was moechtest Du auseinanderbiegen?\n");
  if (!(str=="zweige" || str=="zweige auseinander"
       || str=="busch" || str=="busch auseinander"))
    return 0;
  if (gecko) {
    write(BS("Du biegst vorsichtig die Zweige des Busches auseinander und"
            +" siehst darin einen kleinen Gecko, den Du aufscheuchst."));
    say(BS(TPN+" biegt die Zweige eines Busches auseinander und scheucht"
              +" einen kleinen Gecko auf."));
    gecko=0;
    clone_object(NPC("gecko"))->move(TO, M_GO|M_SILENT);
    call_out("g_flee", 4);
  }
  else {
    write(BS("Du biegst vorsichtig die Zweige des Busches auseinander,"
            +" findest aber nichts ausser Hundedreck."));
    say(BS(TPN+" biegt die Zweige eines Busches auseinander."));
  }
  return 1;
}

heaven()
{
  string str;
  
  str="Der Himmel ist ";
  switch(weather) {
    case 0: str+="relativ bewoelkt"; break;
    case 1: str+="strahlend blau"; break;
    case 2: str+="ein bisschen diesig"; break;
    case 3: str+="von schwarzen Wolken ueberzogen"; break;
  }
  str+=".";
  return BS(str);
}

g_flee()
{
  object g;
  
  if (g=present("gecko")) {
    tell_room(TO, "Der Gecko fluechtet nach Nordosten.\n");
    g->command_me("nordosten");
  }
}

