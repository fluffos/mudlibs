/*
  Zone 3: Mitte
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Mitte");
  SetProp(P_INT_SHORT, "Am Marktplatz");
  SetProp(P_INT_LONG, BS(
          "" ));
  
  AddSound(DEFAULT_SOUND, BS(
           "Leise Stimmen ertoenen von ueberall."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst nur Dich selber."));
  
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_ROAD]));

  AddExit("sueden", ROOM("a8_b2"));
  AddExit("nordwesten", ROOM("a7_a0"));
  AddExit("osten", ROOM("a9_b1"));
  AddCmd(({"betrete", "betritt"}), "zelt");
}

zelt(str)
{
  notify_fail("Was genau moechtest Du betreten?\n");
  if (str!="oranges zelt" && str!="zelt")
    return 0;
  write(BS(
        "Du betrittst das orange Zelt."));
  TP->move(ROOM("zelte/a8_b1"), M_GO, "ins orange Zelt");
  return 1;
}

