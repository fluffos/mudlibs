/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Steppenbeginn");
  SetProp(P_INT_LONG, BS(
          "Hier beginnt sich die Landschaft gegenueber dem Norden schon sehr"
         +" zu veraendern. Das Gras wird hoeher, und ist laengst nicht mehr"
         +" so gruen, mehr gelblich. Der Weg ist eigentlich nur noch ein"
         +" festgetretener Trampelpfad, aus dem ab und zu ein frisches"
         +" Grasbueschel herauslugt. Auch die Sonne, die fest am Himmel"
         +" steht, sieht laengst nicht mehr so freundlich aus."));
  AddDetail("landschaft", BS(
            "Die Landschaft veraendert sich mehr und mehr in eine Steppe,"
           +" wenn man nach Sueden schaut. Gen Norden kann man wiederum ein"
           +" bisschen mehr Gruen erkennen."));
  AddDetail("gruen", BS(
            "Im Norden kann man etwas gruenes erahnen.")); 
  AddDetail("weg", BS(
            "Der Weg ist zu einem festgetretenen Trampelpfad geworden."));
  AddDetail(({"pfad", "trampelpfad"}), BS(
            "Der Pfad ist so festgetreten, dass man kaum noch Spuren erkennen"
           +" kann."));
  AddDetail("boden", BS(
            "Aus dem Weg ist ein Trampelpfad geworden.")); 
  AddDetail(({"spur", "spuren"}), BS(
            "Eine Spur laesst sich noch als die eines Pferdes identifizieren."));
  AddDetail("gras", BS(
            "Es ist jetzt ca. huefthoch und total von der Sonne ausgebleicht."
            +" Die ganze Gegend erinnert Dich direkt schon an eine Steppe."));
  AddDetail("steppe", BS(
            "Hier beginnt die Steppe mehr und mehr, sich auszubreiten."));
  AddDetail(({"bueschel", "grasbueschel"}), BS(
            "Ab und zu sieht man in der Mitte des Pfades ein kleines Grasbueschel"
           +" aus der Erde hervorbrechen, dort, wo die meisten Lebewesen"
           +" eher nicht hinsteigen.")); 
  AddDetail("erde", BS(
            "Die Erde ist hier schon ziemlich ausgetrocknet und wirkt daher"
           +" ein bisschen rissig.")); 
  AddDetail("sonne", BS(
            "Die Sonne brennt unerbittlich vom Himmel herab, jedoch stoert"
           +" es nicht so, da der Wind eigentlich staendig weht."));
  AddDetail(({"brise", "wind"}), BS(
            "Am sanft dahinwogenden Gras erkennst Du, dass eine sanfte Brise"
           +" weht."));  
  AddDetail("himmel", BS(
            "Ein paar Wolken kann man erkennen, und ziemlich diesig ist es,"
           +" aber alles in allem ist die Sonne doch sehr dominant da oben.")); 
  AddDetail(({"wolke", "wolken"}), BS(
            "Eine Wolke sieht aus wie eine Katze."));
  AddDetail("katze", BS(
            "Die Katze ist doch nur eine Wolke."));
  AddSound(DEFAULT_SOUND, BS(
           "Man hoert, wie das Gras sich leicht saeuselnd im Winde wiegt."));
  AddSound(({"gras", "wind"}), BS(
           "Es klingt wie ein sanftes Rascheln.")); 
  AddSound("rascheln", BS(
           "Die einzelnen Grashalme erzeugen beim Aneinanderreiben dieses"
          +" Rascheln."));
  AddSmell(DEFAULT_SMELL, BS(
           "Man riecht nur den traegen Duft von Sonne auf lederner Haut."));
  AddSmell("haut", BS(
           "Es duerfte sich wohl um Deine eigene sonnenverbrannte Haut handeln. :)")); 
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN]));

  AddExit("norden", ROOM("a4_a3"));
  AddExit("suedosten", ROOM("a5_a5"));
}


