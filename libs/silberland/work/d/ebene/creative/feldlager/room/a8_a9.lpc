/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Wegbiegung");
  SetProp(P_INT_LONG, BS(
          "Der Weg hier macht eine dramatische Biegung von Osten direkt nach"
         +" Suedosten. Hier wird allerdings die Landschaft wieder wesentlich"
         +" steppiger."));

  AddDetail("biegung", BS(
            "Eine simple Wegbiegung. Viel einfacher gehts einfach nicht."));
  AddDetail("weg", BS(
            "Der Weg macht eine Biegung von Osten nach Suedosten."));
  AddDetail("boden", BS(
            "Auf dem Boden siehst Du nur Deine eigenen Spuren."));
  AddDetail(({"spur", "spuren"}), BS(
            "Du betrachtest Deine eigenen Spuren genauer. Du musst zugeben, dass"
           +" Die Spuren von Dir stammen koennten."));
  AddDetail(({"osten", "suedosten"}), BS(
            "Das sind die Richtungen, in die Du Deinen Weg fortsetzen kannst."));
  AddDetail(({"richtung", "richtungen"}), BS(
            "Es geht definitiv nur nach Osten und Suedosten weiter."));
  AddDetail("steppe", BS(
            "Interessanterweise wird hier die Landschaft wieder wesentlich"
           +" aehnlicher einer Steppe."));
  AddDetail("landschaft", BS(
            "Die Landschaft erinnert Dich an eine Steppe."));
  AddDetail("steppe", BS(
            "Du befindest Dich wiederum mittendrin. Das uebliche gilt es wiederum"
           +" zu untersuchen. Gras, Buesche, Straeucher, ..."));
  AddDetail("gras", BS(
            "Gelblich und ausgebleicht praesentiert sich hier das Gras, also"
           +" weniger ueberraschend."));
  AddDetail(({"busch", "buesche"}), BS(
            "Die Buesche sind ziemlich ausgedoerrt."));
  AddDetail(({"strauch", "straeucher"}), BS(
            "Auch die Straeucher sind ziemlich ausgedoerrt."));
  AddDetail("himmel", BS(
            "Am Himmel erkennst Du eigentlich nichts besonderes. Aber Du wuerdest"
           +" Dich freuen, wenn Du einmal eine Wolke finden wuerdest."));
  AddDetail("sonne", BS(
            "Die Sonne ueberstrahlt den Himmel."));
  AddDetail("wolke", BS(
            "Such doch einmal danach."));
  AddDetail("kampf", BS(
            "Zum heutigen Datum ist nichts mehr zu erkennen."));
  AddDetail("datum", BS(
            "Das weisst Du hoffentlich selber. :)"));
  AddDetail("zelt", BS(
            "Weiter im Suedwesten kannst Du die Umrisse eines Zeltes erahnen."));
  AddDetail(({"umriss", "umrisse"}), BS(
            "Im Suedwesten, einem Gebiet, das Du von hier nicht unbedingt direkt"
           +" erreichen kannst, befindet sich ein Zelt."));
  AddDetail(({"gebiet", "teil", "lager", "feldlager"}), BS(
            "Hier befindest Du Dich im oestlichen Teil des Feldlagers."));
  
  AddSound(DEFAULT_SOUND, BS(
           "Es klingt, wie wenn jemand kaempfen wuerde."));
  AddSound("kampf", BS(
           "Hier duerfte einmal ein Kampf stattgefunden haben."));
  AddSmell(DEFAULT_SMELL, BS(
           "Der Geruch nach Rindsuppe ist hier eindeutig extrem stark."));
  AddSmell(({"suppe", "rindsuppe"}), BS(
           "In einem Zelt im Sueden scheint jemand so etwas koestliches"
          +" wie Rindsuppe zuzubereiten.")); 

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN:TT_PLAIN]));

  AddItem(NPC("jongleur"), REFRESH_DESTRUCT);

  AddExit("osten", ROOM("a9_a9"));
  AddExit("suedosten", ROOM("a9_a0"));
}

