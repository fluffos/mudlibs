/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Raum");
  SetProp(P_INT_LONG, BS(
          "Dir wird fad vom vielen Detailuntersuchen. Hier ist einfach ein"
         +" total normaler Raum."));
  AddDetail(({"details", "detail"}), BS(
            "Hier gibt es keine Details."));
  AddDetail("boden", BS(
            "Wie zu erwarten findest Du nichts Besonderes am Boden."));
  AddDetail("besonderes", BS(
            "Hier ist nichts Besonderes. Warum sollte es auch?"));
  AddDetail("weg", BS(
            "Zwar gibt es in einem total normalen Raum auch einen Weg, aber"
           +" dieser hat einfach nichts Wichtiges zu bieten."));
  AddDetail("raum", BS(
            "Das ist das Ding, in dem Du Dich eben befindest."));
  AddDetail("ding", BS(
            "Du stoehnst ueber diese Detailtiefe."));
  AddDetail(({"tiefe", "detailtiefe"}), BS(
            "Immerhin schon die 3. Stufe."));
  AddDetail(({"stufen", "stufe"}), BS(
            "Mehr als 3 Stufen gibt es eh nicht. :)"));
  AddDetail("himmel", BS(
            "Am Himmel findet sich wie ueblich keine Wolke."));
  AddDetail("wolke", BS(
            "Nein, es ist wirklich keine Wolke zu erkennen."));
  AddDetail("sonne", BS(
            "Nur die Sonne ist erschreckend heiss."));
  
  AddSound(DEFAULT_SOUND, BS(
           "Man hoert in einem Standardraum ueberlicherweise wenig."));
  AddSmell(DEFAULT_SMELL, BS(
           "Genausoviel wie man hier hoeren kann, riecht man auch."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN:TT_PLAIN]));

  AddExit("nordosten", ROOM("b2_a8"));
  AddExit("westen", ROOM("a0_a9"));
}

