/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Steppe");

  SetProp(P_INT_LONG, BS(
          "In alle Richtungen dehnt sich die weite Ebene bis zum Horizont"
         +" aus. Ein Meer von Gras bewegt sich sanft im Wind, und in der"
         +" Hitze des Tages flimmert die Luft. Ein schmaler Trampelpfad"
         +" zieht sich wie eine Schnur von Westen nach Suedosten durch die"
         +" Steppe. Er scheint den kleinen Huegel oestlich von Dir zu"
         +" umrunden und verschwindet schon nach wenigen Metern aus Deinem"
         +" Blick."));
  AddDetail(({"richtungen", "richtung"}), BS(
            "Rund um Dich herum, in alle Richtungen, nichts als Gras."));
  AddDetail("ebene", BS(
            "Die weite Graslandschaft um Dich herum ist, bis auf wenige"
           +" vereinzelte Huegel, genauso flach wie eben. Drum eben der Name"
           +" eben. :)"));
  AddSpecialDetail(({"namen", "name"}), "getname");
  AddDetail("horizont", BS(
            "Du folgst dem scheinbar endlosen Grasmeer mit den Augen bis"
           +" dahin, wo sich Himmel und Erde zu beruehren scheinen - oder"
           +" vielmehr Himmel und Gras. Etwas Besonderes kannst Du am"
           +" Horizont allerdings nicht erkennen."));
  AddDetail("erde", BS(
            "Hm, eigentlich siehst Du nur Gras."));
  AddDetail("himmel", BS(
            "Der fahlblaue Himmel ueber Dir ist wolkenlos."));
  AddDetail(({"meer", "grasmeer"}), BS(
            "Wie eine weite Wasserflaeche wogt das Steppengras im Wind"
           +" auf und ab. Wellen laufen ueber die Ebene und leises Rauschen"
           +" erfuellt die Luft. Wenn nicht alles um Dich herum so fahlgelb"
           +" waere, koenntest Du wirklich meinen, auf einer Insel im Ozean"
           +" zu stehen. Aber so gelbes Wasser gibt es dann doch nicht, und"
           +" vor allem nicht so trockenes."));
  AddDetail(({"wasserflaeche", "flaeche", "wasser"}), BS(
            "Das Wasser entpuppt sich bei genauerem Hinsehen als Gras. Aber"
           +" Dir ist die Farbe schon gleich so komisch vorgekommen."));
  AddDetail(({"gelb", "farbe"}), BS(
            "Es handelt sich definitiv um sehr gelbliches Gelb."));
  AddDetail(({"wellen", "welle"}), BS(
            "In sanften Wellen bewegen sich die Graeser auf und ab."));
  AddDetail("rauschen", BS(
            "Hoer mal genau hin."));
  AddDetail("luft", BS(
            "Sie ist Luft fuer Dich."));
  AddDetail("insel", BS(
            "Das hier ist leider nur eine Steppe und nicht die Suedsee."
           +" Inseln haben wir hier nicht viele, aber wie waers mit ein"
           +" bisschen Gras?"));
  AddDetail(({"ozean", "suedsee", "see"}), BS(
            "Das befindet sich irre weit weg! Wenn Du dahin wolltest, haettest"
           +" Du Dich ziemlich verlaufen."));
  AddDetail(({"gras", "steppengras"}), BS(
            "Trockenes, gelbes Gras bedeckt die Ebene und Du kannst Dir kaum"
           +" vorstellen, dass es je gruen und lebendig ausgesehen hat. Eher"
           +" erinnert es an Stroh, das man einfach zu schneiden vergessen"
           +" hat."));
  AddDetail("stroh", BS(
            "Trockenes Gras ist Heu und kein Stroh! Oder? Ein Blick auf das"
           +" gelbe Grasmeer laesst Dich zweifeln."));
  AddDetail("heu", BS(
            "Du hast recht. Trockenes Gras IST Heu."));
  AddDetail("wind", BS(
            "Hin und wieder bewegt ein schwacher Windstoss das Gras. Gegen"
           +" die Hitze des Tages kommt er leider nicht an und so schwitzt"
           +" Du weiter vor Dich hin. Und das ohne Deo, igitt!"));
  AddDetail("deo", BS(
            "Du hast eben keines genommen..."));
  AddDetail("hitze", BS(
            "Wolkenloser Himmel und strahlende Sonne. Waerst Du jetzt im"
           +" Urlaub, koenntest Du zufrieden sein. So aber schwitzt Du vor"
           +" Dich hin und murmelst ein paar sehr unfreundliche Worte ueber"
           +" die Hitze."));
  AddDetail("sonne", BS(
            "Die Sonne strahlt blendend weiss vom Himmel."));
  AddDetail("urlaub", BS(
            "Nein, sowas hast Du nicht!"));
  AddDetail(({"worte", "wort"}), BS(
            "So etwas unanstaendiges wiederhole ich nicht!"));
  AddDetail("tag", BS(
            "Hm, da es hell ist und die Sonne scheint, ist es recht"
           +" wahrscheinlich, dass Tag ist."));
  AddDetail(({"pfad", "trampelpfad", "weg", "boden"}), BS(
            "Der schmale Trampelpfad zieht sich wie eine dunkle Schnur durch"
           +" die weite Steppe. Auch wenn er scheinbar nur noch wenig benutzt"
           +" wird, ist er doch noch gut so weit zu erkennen, dass Du ihm"
           +" folgen kannst. Du solltest ihn nicht verlassen, sonst wirst"
           +" Du Dich sicher verlaufen. Nach wenigen Metern verschwindet"
           +" der Weg hinter einem kleinen Huegel."));
  AddDetail("schnur", BS(
            "Wie eine dunkle Schnur zieht sich ein schmaler Trampelpfad von"
           +" Westen nach Suedosten durch die weite Ebene."));
  AddDetail(({"westen", "suedosten"}), BS(
            "Da kannst Du hingehen."));
  AddDetail("steppe", BS(
            "Langsam muesstest Du sie in und auswendig kennen: Gras unten,"
           +" Sonne oben, ein bisschen Wind und zuviel Hitze."));
  AddDetail(({"huegel", "igel", "grasdecke"}), BS(
            "Ein kleiner Huegel erhebt sich wenige Meter neben dem"
           +" Trampelpfad. Mit seiner dichten Grasdecke sieht er aus wie"
           +" ein ueberdimensionaler gelber Igel, und ausser, dass er Dir"
           +" den direkten Weg nach Osten versperrt, scheint er nichts"
           +" Bemerkenswertes darzustellen."));
  AddDetail("bemerkenswertes", BS(
            "Nichts Bemerkenswertes ist kaum bemerkenswert."));
  AddDetail("meter", BS(
            "Ein Meter hat definitionsgemaess 100 Zentimeter."));
  AddDetail("zentimeter", BS(
            "Hundert Zentimeter koennten ein Meter sein."));
  AddDetail("blick", BS(
            "Du beginnst zu schielen, kannst aber nichts Auffaelliges an"
           +" Deinem Blick erkennen."));

  AddSound(DEFAULT_SOUND, BS(
           "Wie leises Rauschen von Wasser klingt es, wenn der Wind das"
          +" Grasmeer bewegt."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst so, als solltest Du dringend mal wieder in richtigem"
          +" Wasser und nicht in Grasmeeren baden."));
  AddSmell("deo", BS(
           "Haettest Du eines genommen, wuerdest Du besser riechen."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  
  AddExit("westen", ROOM("b2_a8"));
  AddExit("suedosten", ROOM("b4_a9"));
}


getname()
{
  return "Du bist doch "+TP->QueryProp(P_NAME)+", was denkst denn Du?\n";
}

