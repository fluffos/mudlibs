/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Westlich vom Medizinmann");
  SetProp(P_INT_LONG, BS(
          "Im Osten kannst Du ganz deutlich das Zelt des Medizinmannes ausmachen."
         +" Jedoch kannst Du wohl nicht auf direktem Wege dorthin gelangen, obwohl"
         +" dieser Ort eine magische Anziehung auf Dich ausuebt."));
  AddDetail("anziehung", BS(
            "So sehr dieser magische Platz auch Deine Aufmerksamkeit auf sich"
           +" zieht, trotzdem gelangst Du nicht von hier auf direktem Wege"
           +" dorthin."));
  AddDetail("platz", BS(
            "Der Platz im Osten von Dir vermittelt Dir ein mulmiges Gefuehl."));
  AddDetail("aufmerksamkeit", BS(
            "Deine Aufmerksamkeit ist gefesselt von der magischen Ausstrahlung"
           +" des Platzes im Osten."));
  AddDetail("gefuehl", BS(
            "Dir wird mulmig, wenn Du nach Osten blickst."));
  AddDetail("ausstrahlung", BS(
            "Der Platz im Osten scheint etwas Magisches an sich zu haben.")); 
  AddDetail(({"magie", "magisches"}), BS(
            "Der Platz im Osten scheint von Magie umgeben."));
  AddDetail("osten", BS(
            "Im Osten von Dir befindet sich das Zelt des Medizinmannes."));
  AddDetail("weg", BS(
            "Der Weg hier verlaeuft von Nordwesten nach Nordosten, macht also"
           +" somit eine interessante Biegung.")); 
  AddDetail("biegung", BS(
            "Die wesentlich interessantere Biegung (was auch nicht unbedingt"
           +" graduell so viel Unterschied macht) befindet sich im Nordwesten."));
  AddDetail("unterschied", BS(
            "Du kannst den Unterschied selber herausfinden, indem Du nach Nordwesten"
           +" gehst."));
  AddDetail(({"nordwesten", "nordosten"}), BS(
            "Dorthin kannst Du gelangen."));
  AddDetail("zelt", BS(
            "Das Zelt im Osten ist ziemlich gross und mit interessanten Orakeln"
           +" verziert."));
  AddDetail("orakel", BS(
            "Um die Orakel naeher zu untersuchen, solltest Du schon vor das Zelt"
           +" treten."));
  AddDetail("boden", BS(
            "Auf dem Boden siehst Du den Weg."));
  AddDetail("himmel", BS(
            "Endlich erkennst Du den Wert der Farbe Azurblau."));
  AddDetail("wert", BS(
            "Herrlich ist diese Farbe sicherlich. Jedoch fast schon nervig auf"
           +" die Dauer."));
  AddDetail("dauer", BS(
            "Das dauert..."));
  AddDetail(({"farbe", "blau", "azurblau"}), BS(
            "Sensationell, wie herrlich blau der Himmel heute ist."));
  AddDetail("sonne", BS(
            "Woher weisst Du, dass es hier auch eine Sonne zu untersuchen gibt?"));

  AddSound(DEFAULT_SOUND, BS(
           "Vom Osten her droehnt monotones Getrommel."));
  AddSound("getrommel", BS(
           "*tom* *tom*, wirklich eintoenig, das Getrommel."));
  AddSmell(DEFAULT_SMELL, BS(
           "Vom Osten her riechen diverse Kraeuter herueber."));
  AddSmell("kraeuter", BS(
           "Zu viele verschiedene Gerueche verwirren Deine Nase."));
  AddDetail("nase", BS(
            "Du greifst Dir ins Gesicht. Ja, sie ist noch da."));
  AddDetail("gesicht", BS(
            "Ohne Spiegel kannst Du Dir nicht selber ins Gesicht sehen."));
  AddDetail("spiegel", BS(
            "Du hast keinen Spiegel bei Dir."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN:TT_PLAIN]));

  AddExit("nordosten", ROOM("a0_a9"));
  AddExit("nordwesten", ROOM("a8_a9"));
}

