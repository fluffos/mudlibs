/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

string *plrs=({});

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Westliche Boeschung");
  SetProp(P_INT_LONG, BS(
          "Hier faellt der Boden gegenueber dem Norden ein wenig ab, von"
         +" hier aus gen Westen gelangst Du in eine kleine Talsenke."
         +" Im Nordosten siehst Du noch die Kreuzung, weiter nach Westen"
         +" faellt der Boden noch mehr ab."
         +" Am Wegrand faellt Dir eine Unebenheit im Boden auf."
         ));
  AddDetail("kreuzung", BS(
            "Im Nordosten kannst Du die Kreuzung ganz deutlich sehen."));
  AddDetail(({"senke", "talsenke"}), BS(
            "Im Nordwesten findest Du die Talsenke, wenn Du sie naeher untersuchen"
           +" moechtest."));
  AddDetail("boden", BS(
            "Der Boden hier waere fuer einen gut ausgebildeten Trapper"
           +" wie ein offenes Buch."));
  AddDetail("trapper", BS(
            "Du jedenfalls nicht."));
  AddDetail("buch", BS(
            "Wenn Du ein Trapper waerest, koenntest Du im Boden lesen."));
  AddReadDetail("boden", BS(
                "Haeltst Du Dich fuer so gut ausgebildet?"));
  AddDetail("weg", BS(
            "Der Weg macht hier eine Biegung von West nach Nordost."));
  AddDetail("biegung", BS(
            "Du betrachtest die Biegung genauer. Im aeuessersten Winkel der"
           +" Kurve erkennst Du einen interessanten Haufen."));
  AddDetail("haufen", BS(
            "Du schaust Dir den Haufen genauer an. Er besteht aus"
           +" aufgehaeuftem Lehm."));
  AddDetail("lehm", BS(
            "Der Haufen Lehm scheint hier schon vor laengerem aufgestellt"
           +" worden zu sein, da der Lehm total ausgetrocknet ist. Aber der"
           +" Haufen ist zu gross, um einen Sinn zu ergeben."));
  AddDetail("sinn", BS(
            "Du versuchst zweifelhaft, einen Sinn zu ergruenden. Hm. Du"
           +" ueberlegst, den Haufen erst einmal zu durchwuehlen."));
  AddDetail("himmel", BS(
            "Der Himmel verwirrt Dich. Die Wolken ergeben ein schauriges"
           +" Bild."));
  AddDetail(({"wolke", "wolken"}), BS(
            "Die Wolken erwecken in Dir ein ganz spezielles Bild."));
  AddDetail("bild", BS(
            "Eigentlich sieht es aus wie eine Szene aus einem Fussballspiel."));
  AddDetail(({"spiel", "fussballspiel"}), BS(
            "Du betrachtest es genauer. Irgendwas ist an dieser Szene interessant."));
  AddDetail("szene", BS(
            "Kommst Du Dir nicht bloed vor? Im Himmel nach Stuermern zu"
           +" suchen?"));
  AddSpecialDetail("stuermer", "getcoin");
  /* seherhauskram */
  AddDetail(({"unebenheit"}),
            "Bei naeherer Betrachtung stellt sich die Unebenheit als Eingang zu einer Erdhoehle heraus.");
  AddDetail(({"betrachtung"}),
            "Schau genau!");
  AddDetail(({"eingang", "erdhoehle"}),
            "Du kannst sie einfach mit 'unten' betreten.");
  
  AddCmd(({"wuehl", "wuehle", "durchwuehle"}), "wuehl"); 
  AddSound(DEFAULT_SOUND, BS(
           "Hier gibt es absolut nichts, nein, wirklich gar _nichts_ zu"
          +" hoeren."));
  AddSound("nichts", BS(
           "Tja. Sich nichts anhoeren waere doch Schwachsinn. :)"));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht ganz streng nach Lehm."));
  AddSmell("lehm", BS(
           "Lehm riecht ziemlich eigenartig, wenn auch doch relativ"
          +" gewoehnlich.")); 

  SetProp(P_LIGHT,1);
  
  AddItem(NPC("tapir"), REFRESH_DESTRUCT);

  AddExit("westen", ROOM("a3_a6"));
  AddExit("nordosten", ROOM("a5_a5"));
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN]));
  SetProp(P_HIDE_EXITS, ({"unten"}));
  
  restore_object(LOG("stuermerlog"));
}

getcoin()
{
  string str;
  int arg;

  if ((sscanf(getuid(TP), "gast%d", arg)==1)) 
    return "Das war dann doch nur eine Wolke...\n";
  if (member(plrs, getuid(TP))==-1) {
    plrs+=({getuid(TP)});
    save_object(LOG("stuermerlog"));
    str=BS("Du erkennst den Stuermer Deines beliebtesten Fussballklubs"
          +" und wirst fuerstlich belohnt.");
    TP->AddMoney(500);
  }
  else
    str=BS("So sehr Du Dich auch anstrengst, aber Du erkennst den Stuermer"
         +" nicht.");
  return str;
}


// Da wird spaeter mal was fuer eine Quest praepariert.

wuehl(str)
{
  notify_fail("Was moechtest Du durchwuehlen?\n");
  if (!(str=="haufen" || str=="lehmhaufen"))
    return 0;
  write(BS(
        "Du durchwuehlst wild den Haufen und hoffst, was zu finden. Fast."
       +" Fast haettest Du was gefunden. Aber muss das immer so sein? In"
       +" der fernen Zukunft wuerde ich es noch mal probieren."));
  return 1; 
}

