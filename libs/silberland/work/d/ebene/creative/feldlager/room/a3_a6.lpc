/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Talsenke Nord");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich in einer kleinen Talsenke inmitten der weiten"
         +" Steppe. Hier ist die Vegetation schon etwas ueppiger. Ein paar"
         +" Buesche und Straeucher gibt es am Wegrand, und ein Baum waechst"
         +" abseits des Pfades. Ein schmaler Weg fuehrt von hier aus nach"
         +" Sueden."));
  AddDetail(({"rand", "wegrand"}), BS(
            "Am Rande des Weges wachsen ein paar uninteressante Straeucher und"
           +" Buesche."));
  AddDetail(({"tal", "senke", "talsenke"}), BS(
            "Im grossen und ganzen befindest Du Dich im nordwestlichsten Teil"
           +" des Feldlagers."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Ja, eigentlich befindest Du Dich schon mittendrin, obwohl hier"
           +" noch nichts von einem Lager an sich zu sehen ist."));
  AddDetail("teil", BS(
            "Das ist der nordwestliche Teil. Genau!"));
  AddDetail("steppe", BS(
            "Die Steppe sieht eigentlich ganz gewoehnlich aus. Ausgedoerrtes"
           +" Gras, gruene Buesche und dornige Straeucher, staubiger Weg,"
           +" brennende Sonne am Himmel (ja, die Temperatur wird irgendwie"
           +" schon etwas waermer), und weit und breit kaum Etwas zu sehen."));
  AddDetail("gras", BS(
            "Das Gras ist zwar hoch und gelblich, aber doch schon etwas"
           +" ausgedoerrt. Es duerfte hier schon ziemlich warm sein."
           +" Richtung Sueden ist das Gras sichtlich zusammengetreten, so"
           +" dass man einen Weg erkennen kann."));
  AddDetail(({"busch", "buesche"}), BS(
            "Es handelt sich um kaum interessante Buesche mit ein paar"
           +" Fruechten drauf."));
  AddDetail(({"frucht", "fruechte"}), BS(
            "Die Fruechte sehen giftig aus. Ich wuerde sie nicht essen."));
  AddDetail(({"dornen", "strauch", "straeucher", "gestruepp"}), BS(
            "Lauter dorniges Gestruepp."));
  AddDetail(({"pfad"}), BS(
            "Hier auf diesem Pfad, der etwas geschuetzt liegt (durch die"
           +" Talsenke), kann man eine Spur erkennen."));
  AddDetail(({"weg"}), BS(
            "Das Gras Richtung Sueden ist dermassen zusammengetreten, dass"
           +" man direkt von einem Weg sprechen kann."));
  AddSpecialDetail(({"spur", "spuren"}), "spur");
  AddDetail("himmel", BS(
            "Der Himmel ist aber wirklich knallblau heute."));
  AddDetail("sonne", BS(
            "Die Sonne ist reichlich unangenehm heiss."));
  AddDetail("vegetation", BS(
            "Hier findet sich ausser Gras, Straeucher und Bueschen noch ein"
           +" Baum."));
  AddDetail("baum", BS(
            "Auf dem Baum befindet sich etwas Typisches."));
  AddDetail("typisches", BS(
            "Ein Baum besitzt typischerweise einen Ast."));
  AddDetail("ast", BS(
            "Ja. Ein Baum hat Aeste."));
  AddDetail("aeste", BS(
            "So verblueffend es auch klingen mag: Dieser Baum besitzt mehrere"
           +" Aeste."));
  AddDetail(({"blaetter", "blatt"}), BS(
            "Auf den Aesten wachsen Blaetter."));
  AddDetail("boden", BS(
            "Auf dem Boden erkennst Du ein paar Spuren."));
  AddDetail("stamm", BS(
            "Auf den Wunsch vieler braver Abenteurer hab ich hier auch noch"
           +" das Detail Stamm eingefuegt. Nein. Falsch. :) Ein Baum hat natuerlich"
           +" einen Stamm. Aber dieser hier ist eher uninteressant."));
  AddDetail("detail", BS(
            "Hoert ihr jetzt endlich auf zu nerven? :))"));
  AddDetail("abenteurer", BS(
            "Bist das nicht Du?"));

  AddCmd("iss", "eat");   
  AddCmd(({"kletter", "klettere"}), "tree");
  
  AddSound(DEFAULT_SOUND, BS(
           "Die Blaetter des Baumes rauschen im Wind, ausserdem hoerst Du"
          +" Vogelgezwitscher."));
  AddSound(({"gezwitscher", "vogelgezwitscher"}), BS(
           "Nein, hier gibts keinen Zaubertrank.")); 
  AddSmell(DEFAULT_SMELL, BS(
           "Die Fruechte riechen verfuehrerisch gut."));
  AddSmell(({"frucht", "fruechte"}), BS(
           "Sie riechen leicht suesslich, auch etwas herb. Aber koestlich."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_PLAIN]));
  
//  AddExit("suedwesten", ROOM("a2_a7"));
  AddExit("osten", ROOM("a4_a6"));
  AddExit("sueden", "/d/ebene/wraz/nonnenkloster/room/w01.lpc");
  AddCmd(({"schuettle", "schuettel"}), "shake");
}

eat(str)
{
  notify_fail("Was moechtest Du essen?\n");
  if (!(str=="frucht" || str=="fruechte"))
    return 0;
  write("Du pflueckst Dir eine Frucht. Sie ist leicht giftig. Baeh.\n");
  say(TPN+" kostet von einer Frucht.\n");
  TP->reduce_hit_point(5);
  return 1;
}

spur()
{
  string str;

  if (present("pferd"))
    str="Neben Dir steht doch der Verursacher.\n";
  else
    str="Hierher duerfte sich einmal ein Pferd verirrt haben.\n";
  return str;
}

tree(str)
{
  string s;

  s=TP->_unparsed_args(1);
  notify_fail("Worauf moechtest Du klettern?\n");
  if (!(s=="baum" || s=="auf baum" || s=="geschickt die aeste hinauf"))
    return 0;
  if (s=="baum" || s=="auf baum") {
    write(BS(
          "Du bist zu ungeschickt, um auf den Baum zu klettern. Irgendwie gelingt"
         +" es Dir nicht, auf den Baum zu gelangen. Dir faellt allerdings ein, dass"
         +" die Elfin Niri aeusserst geschickt beim Klettern ist. Vielleicht solltest"
         +" Du sie einmal befragen"
         +(find_player("niri")?".":", wenn sie wieder einmal da ist.")));
    return 1;
  }
  TP->move(ROOM("vorraum_niri"), M_GO, "auf den Baum", "klettert", "klettert herauf");
  return 1;
}

shake(str)
{
  notify_fail("Was willst Du schuetteln?\n");
  if (!(str=="baum"))
    return 0;
  write("Du schuettelst den Baum. Nichts passiert.\n");
  return 1;
}
