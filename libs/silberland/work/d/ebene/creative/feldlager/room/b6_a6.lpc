/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Noerdlich des Sees");
  SetProp(P_INT_LONG, BS(
          "Nach Westen fuehrt der Weg in eine Talsenke hinab, auf"
         +" einen kleinen See zu, waehrend er im Suedosten in der Ebene"
         +" verschwindet. Dort verwandelt sich die Steppenlandschaft"
         +" zusehends in eine Halbwueste. Das Gras erscheint Dir noch"
         +" gelber und trockner als Du es in anderen Teilen der Steppe gesehen"
         +" hast und mehr und mehr weicht es einem staubigen mit Steinen"
         +" durchsetzten Boden. Ausserdem ist da noch etwas, das Dich"
         +" irgendwie an eine Pflanze erinnert."));
  AddDetail("luft", BS(
            "Die Luft ist trocken und staubig."));
  AddDetail("nase", BS(
            "Du greifst in Dein Gesicht und stellst beruhigt fest, dass"
           +" Deine Nase noch genau da ist, wo sie hingehoert."));
  AddDetail("gesicht", BS(
            "Du grabbelst an Deinem Gesicht herum und findest alles dort,"
           +" wo es hingehoert."));
  AddDetail(({"pfad", "trampelpfad", "weg"}), BS(
            "Kaum mehr als ein schmaler Trampelpfad ist dieser Weg, der"
           +" nach Westen in eine Talsenke hinab und nach Suedosten in die"
           +" Ebene hinein fuehrt."));
  AddDetail(({"senke", "talsenke"}), BS(
            "Im Westen senkt sich die Ebene deutlich ab und bildet eine"
           +" Senke an deren Grund Du einen See zu erkennen glaubst."));
  AddDetail("grund", BS(
            "Wenn Du Dir den Grund der Talsenke naeher ansehen willst,"
           +" solltest Du weiter nach Westen gehen."));
  AddDetail("see", BS(
            "Wenn Du Dir den See naeher ansehen willst, solltest Du"
           +" weiter nach Westen gehen."));
  AddDetail("westen", BS(
            "Nach Westen fuehrt der Weg in eine Talsenke hinab und Du glaubst,"
           +" einen See zu erkennen."));
  AddDetail("suedosten", BS(
            "Im Suedosten verschwindet der Weg in der Ebene. Dort wandelt"
           +" sich die Steppenlandschaft mehr und mehr in eine Halbwueste."));
  AddDetail("ebene", BS(
            "Im Suedosten erstreckt sich eine weite flache Ebene"
           +" bis zum Horizont. Keine Huegel, keine Senken, nichts das Deinen"
           +" Blick von dieser Endlosigkeit ablenkt. Die vertraute"
           +" Steppenlandschaft wandelt sich mehr und mehr in eine Halbwueste"
           +" mit trockenem, steinigem Boden."));
  AddDetail(({"endlosigkeit", "horizont"}), BS(
            "Du versinkst in der Betrachtung der Endlosigkeit des Horizonts,"
           +" bis Dir schummrig wird und Du Dich endlich abwenden kannst."));
  AddDetail("blick", BS(
            "Du schielst, bis Dir die Augen wehtun, kannst aber keine"
           +" Blick auf Deinen Blick werfen."));
  AddDetail("augen", BS(
            "Du tastest in Deinem Gesicht umher, findest Deine Augen,"
           +" piekst Dich dabei schmerzhaft und laesst solchen Unsinn"
           +" kuenftig sein."));
  AddDetail("unsinn", BS(
            "Das macht keinen Sinn."));
  AddDetail("sinn", BS(
            "Das macht sehr wohl Sinn."));
  AddDetail(({"beachtung", "betrachtung"}), BS(
            "Die Betrachtung der Betrachtung verdient keine Beachtung *reim*."));
  AddDetail(({"huegel", "senken"}), BS(
            "Davon gibts hier keine!"));
  AddDetail(({"steppe", "steppenlandschaft"}), BS(
            "Die vertraute Steppenlandschaft mit ihrem sanft wogenden Meer"
           +" aus Gras verwandelt sich zusehends in eine staubige Halbwueste."
           +" Das Gras erscheint Dir noch gelber und trockener als Du es"
           +" in anderen Teilen der Steppe gesehen hast, waehrend es"
           +" sichtbar duenner und spaerlicher wird und bald nur noch in"
           +" vereinzelten Buescheln steht."));
  AddDetail("meer", BS(
            "Wie ein goldgelbes Meer wogt das Gras in einer Steppe."));
  AddDetail("script", BS(
            "Na, bist Du eins?"));
  AddDetail("himmel", BS(
            "Wenn der Himmel bloss nicht immer so blau waere."));
  AddDetail(({"wueste", "halbwueste"}), BS(
            "Nach und nach geht die Steppe in eine staubige trockene"
           +" Halbwueste ueber, die sich in einer weiten flachen Ebene"
           +" bis zum Horizont erstreckt. Der braune staubige Boden ist"
           +" mit grossen und kleinen Steinen uebersaet und ausser"
           +" vereinzelten Grasbuescheln ist ein Ding, das Dich irgendwie an"
           +" eine Pflanze erinnert, das einzige Zeichen von Leben."));
  AddDetail(({"grasflaechen", "flaechen", "gras"}), BS(
            "Das Gras ist graugelb, trocken, verstaubt."));
  AddDetail("steine", BS(
            "Grosse und kleine Steine mit scharfkantigen Ecken bedecken den"
           +" Boden der Halbwueste."));
  AddDetail("ecken", BS(
            "Autsch, wirklich scharfkantig!"));
  AddDetail("zeichen", BS(
            "Du wartest, dass Dir jemand ein Zeichen gibt, aber nichts"
           +" geschieht."));
  AddDetail("leben", BS(
            "Erfreut stellst Du fest, dass Du noch lebst, aber sowas"
           +" kann sich bekanntlich schnell aendern."));
  AddDetail(({"bueschel", "grasbueschel"}), BS(
            "Anstelle der wogenden Grasflaechen stehen bald nur noch"
           +" vereinzelte Bueschel aus trockenem graugelben Gras auf"
           +" dem staubigen Boden."));
  AddDetail("teile", BS(
            "Das ist doch kein Puzzle hier!"));
  AddDetail("puzzle", BS(
            "Also Puzzles loesen musst Du noch oft genug."));
  AddDetail("boden", BS(
            "Braun, staubig und trocken, durchsetzt mit grossen und kleinen"
           +" scharfkantigen Steinen, aber ansonsten uninteressant."));
  AddDetail(({"blumen", "botanik"}), BS(
            "Das ist die Sache mit dem Gruenzeug, den Blumen (ohne Bienchen)"
           +" und all diesem Gemuese."));
  AddDetail(({"pflanze", "ding"}), BS(
            "Das Ding, das Dich irgendwie an eine Pflanze erinnert,"
           +" ist wirklich eine. Aber eine ganz besondere! Wahrscheinlich"
           +" verstehst Du zu wenig von Botanik um zu wissen, was eine"
           +" Welwitschia mirabilis ist, aber das hier ist eine!"
           +" Eine Welwas? Welwitschia mirabilis!"));
  AddDetail("sache", BS(
            "Also etwas genauer musst Du schon sagen, was Du untersuchen willst!"));
  AddDetail(({"gemuese", "gruenzeug"}), BS(
             "Aber das ist doch eine Welwitschia mirabilis, kein"
            +" Gemuese oder Gruenzeug!"));
  AddDetail("bienchen", BS(
            "_Ohne_ Bienchen hiess es da, Du Script!"));
  AddDetail(({"welwitschia", "welwitschia mirabilis"}), BS(
            "Die Welwitschia mirabilis ist eine ganz besondere Pflanze!"
           +" Sie gehoert zu den Wesen mit der laengsten Lebensdauer,"
           +" die es gibt. Man hat fuer einzelne Exemplare schon ein Alter"
           +" von mehr als 2000 Jahren ermittelt. Die Welwitschia besteht"
           +" aus nicht mehr als zwei langen, blassgruenen, bandfoermigen"
           +" Blaettern, die immer in dem Masse aus einer unterirdischen"
           +" Knolle nachwachsen, wie sie an der Spitze absterben. Mit"
           +" diesen Blaettern saugt die Welwitschia winzige Wassertroepfchen"
           +" aus der Luft, genauer gesagt aus dem Morgennebel, und das"
           +" reicht ihr zum Ueberleben."));
  AddDetail(({"wesen", "lebewesen"}), BS(
            "Ja, auch Pflanzen sind Lebewesen! Und die Welwitschia ist"
           +" eins der aeltesten, die es gibt."));
  AddDetail(({"dauer", "lebensdauer"}), BS(
            "Das ist die Zeit von der Geburt bist zum Tod...ach nein,"
           +" eher die Zeit vom letzten Beten bis zum naechsten Tod."));
  AddDetail("zeit", BS(
            "So viel Zeit hast Du nicht!"));
  AddDetail("geburt", BS(
            "Was? Wie? Wessen? Wer vermehrt sich?"));
  AddDetail("tod", BS(
            "Hast Du das nicht schon oft genug gemacht?"));
  AddDetail(({"studien", "beten"}), BS(
            "Nein, fuer religioese Studien ist hier nicht der richtige Ort."));
  AddSpecialDetail("ort", "oo");
  AddDetail("exemplare", BS(
            "Du siehst nur eine Welwitschia, aber auch die ist schon seeeeehr alt."));
  AddSpecialDetail("alter", "age");
  AddDetail("vergleich", BS(
            "Du vergleichst dies und das und alles und nichts und hast"
           +" schon bald die Nase voll davon."));
  AddDetail("jahre", BS(
            "Lass das lieber, das bringt nichts!"));
  AddDetail("blaetter", BS(
            "Die beiden breiten blassgruenen Blaetter der Welwitschia"
           +" wachsen bandfoermig  aus einer unterirdischen Knolle heraus"
           +" und schlaengeln sich in vielen Schlaufen und Windungen ueber-"
           +" und untereinander. Kein Wunder, dass es aussieht, als seien"
           +" es mehr als nur zwei Blaetter... jedes ist gut und gerne 8 Meter"
           +" lang und endet in einer trockenen, vielfach gespaltenen und"
           +" zerfaserten Spitze."));
  AddDetail("meter", BS(
            "Da Du nichts zum messen dabei hast, kannst Du die Meter nicht"
           +" genau untersuchen."));
  AddDetail(({"schlaufen", "windungen"}), BS(
            "Die Blaetter der Welwitschia schlaengeln sich in vielen"
           +" Schlaufen und Windungen ueber- und untereinander."
           +" Erstaunlich, dass sie sich nicht verknoten."));
  AddDetail("wunder", BS(
            "Sorry, heute gibts kein Wunder!"));
  AddDetail("knolle", BS(
            "Die Knolle der Welwitschia waechst unterirdisch, die"
           +" kannst Du nicht sehen."));
  AddDetail("spitze", BS(
            "Die beiden Blaetter der Welwitschia enden in trockenen,"
           +" vielfach gespaltenen zerfaserten Spitzen aus abgestorbenem"
           +" Material."));
  AddDetail(({"blatt", "material"}), BS(
            "Ein abgestorbenes Blatt halt."));
  AddDetail(({"troepfchen", "wassertroepfchen"}), BS(
            "Die Welwitschia filtert mit ihren Blaettern winzige"
           +" Wassertroepfchen aus dem Morgennebel und schafft es so,"
           +" zu ueberleben."));
  AddDetail("luft", BS(
            "Fuer Dich ist die Luft einfach nur trocken, aber die Welwitschia"
           +" schafft es, winzigste Wassertroepfchen aus ihr aufzunehmen."
           +" Naja, der Morgennebel hat sich wohl schon aufgeloest."));
  AddDetail(({"nebel", "morgennebel"}), BS(
            "Der hat sich leider schon aufgeloest."));
  AddDetail("ueberleben", BS(
            "Gar nicht so einfach, das mit dem ueberleben, aber wenn"
           +" Du aufpasst, schaffst Du es auch. Aber so alt wie die Welwitschia"
           +" wirst Du trotzdem nicht."));

  AddSound(DEFAULT_SOUND, BS(
           "Stille!"));
  AddSmell(DEFAULT_SMELL, BS(
           "Die trockene Luft kitzelt Dich in Deiner Nase."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_PLAIN]));
  
//  AddExit("suedosten", ROOM("b7_a7"));
  AddExit("westen", ROOM("b5_a6"));
}

oo()
{
  return QueryProp(P_INT_LONG);
}

age()
{
  string s;

  s="Du bist schon ";
  s+=time2string("%d %D und %h %H", 2*TP->QueryProp(P_AGE));
  s+=" alt....aber das ist nichts im Vergleich zur Welwitschia!";
  return BS(s);
}

