/*
  Baustelle. :)
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE,"Baustelle");
  SetProp(P_INT_SHORT, "Die beruehmtberuechtigte Baustelle");
  SetProp(P_INT_LONG, BS(
          "Das hier ist die beruehmt-beruechtigte Baustelle. Warum gibt es"
         +" diesen Raum ueberhaupt? Weil die zustaendigen Magier zu faul"
         +" sind, ein Gebiet vollstaendig fertigzumachen und es komplett"
         +" anzuschliessen."));
  AddDetail("boden", BS(
            "Ja, die Standarddetails gibt es. Aber mehr is wirklich beim"
           +" besten Willen nicht drin :)."));
  AddDetail("decke", "Decke? Da oben? Im Freien?.\n");
  AddDetail(({"wand", "waende"}), "*prust*, im Freien?\n");
  AddSound(DEFAULT_SOUND, "Du hoerst einfach nichts.\n");
  AddSmell(DEFAULT_SMELL, "Es riecht nach Baustelle.\n");
  SetProp(P_LIGHT,1);
  AddExit("nordosten", ROOM("a3_a6"));
}

