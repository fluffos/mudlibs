/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Nordspitze des Sees");
  SetProp(P_INT_LONG, BS(
          "Du stehst an der Nordspitze eines Tuempels am Boden der Talsenke"
         +" inmitten der endlos scheinenden Steppe. Nach Osten fuehrt der"
         +" Weg noch ein Stueck am Ufer entlang, um dann wieder anzusteigen"
         +" und in der Ebene unterzutauchen. Westlich erstreckt sich ein"
         +" dichter Wald aus hohen Schilfhalmen, wobei Dir im Suedwesten"
         +" das Schilf etwas weniger dicht erscheint. Nach Sueden fuehrt"
         +" ein Trampelpfad am schlammigen Ufer vorbei."));
  AddDetail("himmel", BS(
            "Der Himmel ist huebsch blau, und eine Sonne siehst Du auch."));
  AddDetail("ebene", BS(
            "Geh weiter nach Osten, da siehst Du mehr."));
  AddDetail(({"spitze", "nordspitze"}), BS(
            "Die Nordspitze des Tuempels ist auch nicht mehr als eine schlammige"
           +" Erinnerung an einen See."));
  AddDetail("erinnerung", BS(
            "Du versuchst, Dich zu erinnern, aber so sehr Du auch gruebelst,"
           +" Dir faellt einfach nicht ein, woran Du Dich erinnern wolltest."));
  AddDetail(({"see", "tuempel"}), BS(
            "Den austrocknenden Tuempel im Osten als See zu bezeichnen ist"
           +" schon ziemlich gewagt. Eigentlich liegt dort nicht mehr als ein"
           +" uebelriechender Haufen Matsch. Lediglich ganz weit draussen"
           +" schimmert noch etwas Wasser im Licht der Sonne."));
  AddDetail(({"haufen", "matsch"}), BS(
            "Das was frueher ein See war ist jetzt nicht mehr als ein"
           +" uebelriechender Haufen Matsch, den Du Dir wirklich nicht naeher"
           +" ansehen moechtest."));
  AddDetail("wasser", BS(
            "Viel ist es wirklich nicht mehr und weit weg ist es noch dazu."
           +" Auf naehere Untersuchungen musst Du daher leider verzichten."));
  AddDetail(({"untersuchung", "untersuchungen"}), BS(
            "Die Untersuchung der Untersuchung bringt trotz allen Untersuchungen"
           +" keine weiteren Untersuchungsergebnisse."));
  AddDetail(({"untersuchungsergebnisse", "ergebnisse"}), BS(
            "Nu isses aber genug!"));
  AddDetail("licht", BS(
            "Die Sonne scheint, also ist es hell."));
  AddDetail("sonne", BS(
            "Vorsichtig blinzelst Du Richtung Sonne, aber ausser dass Du"
           +" etwas geblendet wirst, bringt Dir das nichts ein."));
  AddDetail("osten", BS(
            "Im Osten liegt ein uebelriechender Haufen Matsch, der frueher"
           +" einmal ein See war. Ausserdem fuehrt dort noch ein Weg am"
           +" Ufer entlang, der wenig spaeter in der Weite der Steppe untertaucht."));
  AddDetail("boden", BS(
            "Der staubige Boden der Steppe verwandelt sich hier am Ufer des"
           +" Tuempels in klebrigen Schlamm, der in grossen Brocken an Deinen"
           +" Fuessen haftet und Dir das Gehen nicht wirklich leichter macht."));
  AddDetail("schlamm", BS(
            "Klebriger Schlamm, stinkender Matsch...Du interessierst Dich"
           +" ja fuer nette Dinge."));
  AddDetail(({"dinge", "abwinken"}), BS(
            "Nun uebertreib mal nicht mit dem untersuchen!"));
  AddDetail("brocken", BS(
            "In grossen Brocken haftet der klebrige Matsch an Deinen Fuessen."));
  AddDetail("fuesse", BS(
            "Sie sind vorhanden (gut!), aber dreckig (schlecht!)."));
  AddDetail(({"senke", "talsenke"}), BS(
            "Eine kleine Talsenke unterbricht hier die Weite der Steppe."
           +" Leider ist der See, den sie beherbergt, schon fast"
           +" ausgetrocknet, sonst waere hier sicher ein gemuetlicher Ort."));
  AddDetail("weite", BS(
            "Weite Steppe == Steppe bis zum Abwinken, ist das so verstaendlicher?"));
  AddSpecialDetail("ort", "oo");
  AddDetail("steppe", BS(
            "Geh ein wenig mehr nach Osten oder Sueden, da gibt es viel"
           +" mehr Steppe zu sehen!"));
  AddDetail("suedwesten", BS(
            "Im Suedwesten erscheint Dir das Schilf etwas weniger dicht."
           +" Vielleicht kannst Du Dir auch dort einen Weg bahnen."));
  AddDetail(({"weg", "pfad", "trampelpfad"}), BS(
            "Nach Osten fuehrt der Weg noch ein Stueck am Ufer entlang, um"
           +" dann wieder anzusteigen  und in der Steppe unterzutauchen"
           +" waehrend im Sueden ein Trampelpfad am schlammigen Ufer und"
           +" einem Wald aus Schilf vorbei fuehrt."));
  AddDetail("stueck", BS(
            "Du siehst Dir das Stueck, das der Weg im Osten noch am Ufer"
           +" entlangfuehrt gaaaaanz genau an, kannst aber nichts entdecken."));
  AddDetail("ufer", BS(
            "Am Ufer reicht der uebelriechende Matsch bis zu Deinen Fuessen heran."));
  AddDetail(({"wald", "schilf", "schilfhalme", "halme"}), BS(
            "Ein dichter Wald aus hohem Schilf erstreckt sich westlich"
           +" von Dir. Die dicken gruenen Halme stehen so dicht, dass"
           +" Du nicht erkennen kannst, was sich in ihnen verbirgt."
           +" Im Suedwesten scheinen sie etwas weniger undurchdringlich zu sein."));
  AddDetail("sueden", BS(
            "Nach Sueden fuehrt ein Trampelpfad am schlammigen Ufer des"
           +" Tuempels vorbei."));
  AddDetail(({"wind", "windhauch"}), BS(
            "Ein leichter Windhauch weht vom Tuempel heran und traegt"
           +" den unangenehmen Geruch des Schlamms herein."));
  AddDetail("geruch", BS(
            "So sehr stinkt des dann doch noch nicht, dass man das sehen koennte!"));

  AddSound(DEFAULT_SOUND, BS(
           "Knisternd wiegt sich das Schilf im Wind."));
  AddSmell(DEFAULT_SMELL, BS(
           "Fauliger Schlamm, stinkender Matsch. Igitt!"));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));

  AddExit("norden", "/d/wueste/arthoas/erg/room/path/raum01");
  AddExit("osten", ROOM("b6_a6"));
  AddExit("sueden", ROOM("b5_a7"));
  AddCmd(({"bahn", "bahne"}), "way");
  AddItem("/d/ebene/Silberwald/npc/biber", REFRESH_DESTRUCT);

}

oo()
{
  return QueryProp(P_INT_LONG);
}

way(str)
{
  notify_fail("Was willst Du Dir bahnen?\n");
  if (!str || str!="weg")
    return 0;
  write(BS(
        "Du stuerzt Dich auf das Schilf im Suedwesten und bahnst Dir, die"
       +" Halme niedertrampelnd, einen Weg."));
  TP->move(ROOM("b4_a7"), M_GO|M_SILENT);
  return 1;
}

