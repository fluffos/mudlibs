/*
  Eigene Zone: Zelte
*/

#include "../../files.h"
inherit "std/pub";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include <pub.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Zelte");
  SetProp(P_INT_SHORT, "Im Weinstadl");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich in der Kneipe: \"Weinstadl\". Hier finden sich"
	 +" neben total betrunkenen Typen auch die nettesten Gaeste vermischt"
	 +" mit kuriosen Gestalten. Das Lokal ist beruehmt fuer seine koestliche"
	 +" gebratene Ente, weiters gibt es nur hier den original \"Heurigen\""
	 +", den man sonst nirgendwo so guenstig und gut bekommt."));

  AddDetail(({"kneipe", "stadl", "weinstadl"}), BS(
            "Du befindest Dich in Hannelores Weinstadl. Die Gemuetlichkeit und"
	   +" Urigkeit der Atmosphaere erweckt ein gemuetliches Gefuehl in Dir."));
  AddDetail("gefuehl", BS(
            "Du fuehlst Dich wohl hier."));
  AddDetail(({ "typen", "typ" }), BS(
            "Manche Gestalt hat sich hier schon einen Rausch angetrunken,"
	   +" weil es einfach so urgemuetlich ist."));
  AddDetail("gestalt", BS(
            "Eine von den Gestalten koenntest Du sein."));
  AddDetail(({"gast", "gaeste", "gestalten"}), BS(
            "Ein Gast ist sowas wie Du."));
  AddDetail("boden", BS(
            "Am Boden ist noch ein Rest klebriger Fluessigkeit."));
  AddDetail("decke", BS(
            "Wo siehst Du hier eine Decke?"));
  AddDetail(({"fluessigkeit", "rest"}), BS(
            "Es duerfte sich um verschuetteten Wein handeln."));
  AddDetail("lokal", BS(
            "Der Weinstadl ist einfach ein Original in der ganzen Gegend."));
  AddDetail("original", BS(
            "Sowas wie den Weinstadl findest Du nirgends sonstwo."));
  AddDetail("gegend", BS(
            "Hast Du Dich hier denn schon mal ordentlich umgesehen?"));
  AddDetail(({"gemuetlichkeit", "urigkeit", "atmosphaere"}), BS(
            "Unglaublich wie wohl man sich hier fuehlen kann mit den alten Baenken,"
	   +" den schoenen Holztischen, den Zinntellern an der Wand, den"
	   +" Kellnern in den Landestrachten und dem sauguten Wein."));
  AddDetail(({"bank", "baenke"}), BS(
            "Es sind richtige Holzbaenke hier, wie in der guten alten Zeit."));
  AddSpecialDetail("zeit", "z");
  AddDetail(({"tisch", "tische", "holztisch", "holztische"}), BS(
            "Die Holztische sind schon ganz dunkel vom langen Gebrauch."));
  AddDetail("gebrauch", BS(
            "Die Tische hier sind wohl schon lange in Gebrauch."));
  AddDetail(({"teller", "zinnteller"}), BS(
            "Auf den Zinntellern sind viele Darstellungen aufgemalt oder auch"
	   +" eingraviert."));
  AddDetail(({"darstellung", "darstellungen"}), BS(
            "Du kannst Dir gar keinen speziellen Zinnteller aussuchen, so viele"
	   +" gibt es hier."));
  AddDetail("kellner", BS(
            "Die Kellner sind allesamt in alte Trachten eingekleidet."));
  AddDetail(({"tracht", "trachten", "landestracht"}), BS(
            "Du meinst, Tiroler Tracht zu erkennen."));
  AddDetail("tirol", BS(
            "Tirol liegt in Oesterreich, nicht im SilberLand."));
  AddDetail("oesterreich", BS(
            "Oesterreich ist ein schoenes Land."));
  AddDetail(({"land", "silberland"}), BS(
            "Das SilberLand ist auch ein sehr schoenes Land."));
  AddDetail(({"wand", "waende"}), BS(
            "An der Wand haengen viele Zinnteller."));
  AddDetail("ente", BS(
            "Du musst sie erst einmal probieren!"));
  AddDetail("heuriger", BS(
            "Du wirst bestimmt ein Glaserl Heurigen geniessen koennen."));
  AddDetail("rausch", BS(
            "Hoffentlich kriegst Du keinen von zuviel Wein."));
  AddDetail("wein", BS(
            "Im Weinstadl kriegst Du viele Sorten von gutem Wein."));
  AddDetail("sorten", BS(
            "Schau mal auf die Speisekarte."));
  AddDetail(({"karte", "speisekarte"}), BS(
            "Zum Anschauen der Speisekarte musst Du nur \"menue\" eintippen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht verdammt gut nach gebratener Ente."));
  AddSmell("ente", BS(
           "So eine koestlich riechende gebratene Ente hast Du schon lang nicht"
          +" mehr gerochen."));

  AddSound(DEFAULT_SOUND, BS(
           "Ein total betrunkener Typ lallt eine schaurige Melodie."));
  AddSound(({"typ", "melodie"}), BS(
           "Du versuchst die Melodie zu identifizieren, kommst aber nicht darauf, woher"
          +" sie stammen koennte."));

  AddDrink("Heuriger", ({"heurigen", "heuriger"}), 80, 30, 10, 6,
           ({ "Du trinkst gemuetlich einen herben Heurigen.", 
	      "&& trinkt gemuetlich einen aeusserst herben Heurigen." }) );
  AddDrink("Roter", ({"roten", "roter", "wein", "rotwein"}), 100, 35, 15, 5,
           ({ "Das Glaserl Roter mundet Dir vorzueglich.",
	      "Ein gutes Troepferl Roter scheint auch && zu munden." }) );
  AddDrink("Gruener Veltliner", ({ "weisser", "veltliner", "weissen" }),
           90, 32, 20, 3,
	   ({ "Mit Kennermiene tippst Du auf das Waldviertel.",
	      "Weinkenner && trinkt ein Vierterl vom Waldviertler Gruenen Veltliner." }) );
  AddFood("Gebratene Ente", "ente", 250, 50, 20,
          ({ "So eine gute Ente hast Du wohl noch nirgends bekommen.",
	     "&& schlemmt eine koestliche gebratene Ente nach Tiroler Art."}) );

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_PUBKEEPER_ID, "han\nelore");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_NAME, "Hannelore");
  SetProp(P_PUBKEEPER_GENDER, FEMALE);

  AddItem(NPC("hannelore"), REFRESH_REMOVE);
  AddExit("raus", ROOM("a6_a0"));
}

z()
{
  return "Heute ist "+dtime(time())+".\n";
}
