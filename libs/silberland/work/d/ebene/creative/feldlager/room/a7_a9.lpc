/*
  Zone 3: Mitte
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Mitte");
  SetProp(P_INT_SHORT, "Noerdlich des Marktplatzes");
  SetProp(P_INT_LONG, BS(
          "Suedlich von hier befindet sich eine Art Marktplatz im Feldlager."
	 +" Man hoert noch ein wenig Stimmenwirrwarr von dort herauftoenen. Weiter nordoestlich von Dir befindet sich die wichtige Lagerkreuzung, die den"
	 +" suedlichen, noerdlichen und oestlichen Teil voneinander trennt."
	 +" Ausser der ueblichen Hitze gibt es wenig Interessantes hier."));
  
  AddDetail(({"platz", "marktplatz"}), BS(
            "Im Sueden von Dir befindet sich der Marktplatz des Feldlagers."
	   +" Dort herrscht reges Treiben und es gibt einiges zu handeln und feilschen."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Du befindest Dich mitten darin."));
  AddDetail("treiben", BS(
            "Das rege Treiben bezieht sich auf den Sueden von hier aus gesehen."
	   +" Dort befindet sich naemlich ein Marktplatz."));
  AddDetail("sueden", BS(
            "Dort kann man bestimmt hingehen."));
  AddDetail("handel", BS(
            "Im Sueden von hier wird man wohl Handel treiben koennen."));
  AddDetail("hitze", BS(
            "Die Hitze ist wirklich unertraeglich heiss."));
  AddDetail("sonne", BS(
            "Die Sonne befindet sich am Himmel. Es duerfte sich wirklich um einen Fixstern handeln."));
  AddDetail("himmel", BS(
            "Am Himmel kann man gut die Sonne erkennen. Hell, gross, leuchtend, heiss."));
  AddDetail(({"stern", "fixstern"}), BS(
            "Wer sich gut mit Astronomie auskennt, der weiss, was ein Fixstern ist."));
  AddDetail("astronomie", BS(
            "Die Astronomie wird leider viel zu oft mit der Astrologie verwechselt."));
  AddDetail("astrologie", BS(
            "Die Astrologie beschaeftigt sich mit Sternenkonstellationen und deren Einfluss auf die Wesen."));
  AddSpecialDetail("wesen", "rac");
  AddDetail(({"konstellation", "konstellationen", "sternenkonstellation", "sternenkonstellationen"}), BS(
            "Schade, dass es nicht Nacht ist, sonst koenntest Du die aktuelle"
	   +" Sternenkonstellation genau erkennen."));
  AddDetail("horoskop", BS(
            "Geh zur Sternendeuterin im Feldlager."));
  AddDetail("einfluss", BS(
            "Der Einfluss der Sterne auf die Wesen dieser Welt drueckt sich"
	   +" zumeist durch ein Horoskop aus."));
  AddDetail(({"welt", "silberland"}), BS(
            "Diese Welt nennt sich SilberLand."));
  AddDetail(({"deuterin", "sternendeuterin"}), BS(
            "Die Sternendeuterin befindet sich irgendwo im Feldlager."));
  AddDetail(({"tag", "nacht"}), BS(
            "Derzeit ist definitiv Tag."));
  AddDetail(({"teile", "teil"}), BS(
            "Das Feldlager ist in drei grosse Teile aufgeteilt."));
  AddDetail(({"kreuzung", "lagerkreuzung"}), BS(
            "Die Kreuzung befindet sich nordoestlich von Dir."));
  AddDetail("ohr", BS(
            "Du fuehlst, ob Dein Ohr noch da ist. Glueck gehabt! Noch dran."));
  AddDetail("boden", BS(
            "Am Boden ist nichts Besonderes zu erkennen."));
  AddDetail("besonderes", BS(
            "Nichts Besonderes ist eben ueberhaupt nicht besonders."));
  AddDetail("interessantes", BS(
            "Wenig Interessantes ist eben ziemlich uninteressant."));
  AddDetail("mystik", BS(
            "Mystik... ja, das haengt irgendwie hier besonders mit den Sternen zusammen."));

  AddSound(DEFAULT_SOUND, BS(
           "Aus dem Sueden dringen verschiedene Stimmen an Dein Ohr."));
  AddSound(({"stimme", "stimmen"}), BS(
           "Geh ruhig naeher, damit Du sie genauer hoeren kannst."));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht ein bisschen nach Mystik."));
  AddSmell("mystik", BS(
           "Man kann nicht genau in Worte fassen, wie Mystik riecht."));
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN:TT_ROAD]));

  AddExit("nordosten", ROOM("a8_a8"));
  AddExit("sueden", ROOM("a7_a0"));
}

rac() { return "Du bist ein "+this_player()->QueryProp(P_RACE)+".\n"; }
