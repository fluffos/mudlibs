/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Uebergang zum Lager");

  SetProp(P_INT_LONG, BS(
          "Die weite Steppe dehnt sich nach Osten scheinbar unendlich aus."
         +" Bis zum Horizont siehst Du dort nur Gras, nichts als gelbes,"
         +" trockenes, wogendes Gras. Die Sonne brennt vom Himmel und laesst"
         +" die Landschaft flimmern. Ein unscheinbarer Trampelpfad verschwindet"
         +" in den Weiten der Steppe. Im Suedwesten dagegen bietet sich Deinen"
         +" Augen endlich eine Abwechslung, dort scheint eine Art Lager zu"
         +" sein. Du glaubst Zelte zu erkennen und den Rauch von Feuern."));
  AddDetail("steppe", BS(
          "Die weite Steppe dehnt sich weit nach Osten hin aus. Staubiges"
         +" trockenes Land, hohes Gras und sicher sehr wenig Wasser erwarten"
         +" den Abenteurer, der sich dorthin wagt."));
  AddDetail(({"land", "landschaft", "laender"}), BS(
          "Weite Steppe erstreckt sich weit nach Osten und ein grosses"
         +" Feldlager liegt im Suedwesten."));
  AddDetail("wasser", BS(
          "Das Gras in der Steppe sieht so verdorrt aus, dass es sicher"
         +" schon ewig kein Wasser mehr gesehen hat."));
  AddDetail("abenteurer", BS(
            "So nennt man Leute wie Dich, die ihre neugierige Nase auch in"
           +" gefaehrliche und manchmal toedliche Laender stecken muessen."));
  AddDetail("nase", BS(
            "Du fuehlst Dich angesprochen und greifst Dir an Deine neugierige"
           +" Nase."));
  AddDetail("osten", BS(
            "Die weite Steppe dehnt sich bis zum Horizont nach Osten aus."));
  AddDetail("horizont", BS(
            "Wenn Du nach Osten blickst laesst die Sonne alles vor Deinen"
           +" Augen flimmern und so bist Du Dir nicht sicher, ob Du den"
           +" Horizont wirklich sehen kannst. Nur im Suedwesten kannst Du"
           +" die Zelte eines Lagers ausmachen."));
  AddDetail("gras", BS(
            "Trocken und verdorrt steht das hohe Gras in der Sonne. Nur"
           +" gelegentlich bewegt ein Windstoss seine Halme."));
  AddDetail("windstoss", BS(
            "Hin und wieder bewegt ein Windstoss mit leisem Saeuseln die"
           +" trockenen Grashalme und weht Dir Staub und Sand in die Augen."));
  AddDetail("saeuseln", BS(
            "Du lauschst auf das Saeuseln."));
  AddDetail("staub", BS(
            "Es ist feiner trockener Staub in Deinen Augen."));
  AddDetail("sand", BS(
            "Pieksender Sand weht Dir in die Augen."));
  AddDetail(({"halme", "grashalme"}), BS(
            "Hohe trockene Grashalme bedecken die Steppe und wiegen sich"
           +" traege im Wind."));
  AddDetail("sonne", BS(
            "Die Sonne brennt vom wolkenlosen Himmel. Dir ist ziemlich heiss."));
  AddDetail("himmel", BS(
            "Fahlblau, dunstig und wolkenlos ist der Himmel ueber Dir. Die"
           +" Sonne knallt auf die Steppe herab und Dir ist ziemlich heiss."));
  AddDetail("augen", BS(
            "Obwohl Dir Sand und Staub in den Augen brennen, kannst Du im"
           +" Suedwesten endlich eine Abwechslung zu der scheinbar endlosen"
           +" Steppe ausmachen."));
  AddDetail("abwechslung", BS(
            "Zelte und Rauch im Suedwesten deuten auf ein Feldlager hin."
           +" Eine willkommene Abwechslung fuer deine Augen nach so viel"
           +" Steppe."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Im Suedwesten siehst Du viele Zelte. Ein ausgedehntes Feldlager"
           +" scheint dort errichtet worden zu sein. Rauch steigt von"
           +" vereinzelten Feuern auf und wenn Du naeher herangehst, kannst"
           +" Du sicher noch mehr erkennen."));
  AddDetail(({"zelte", "feuer"}), BS(
            "Geh etwas naeher heran, dann kannst Du sicher mehr erkennen."));
  AddDetail("rauch", BS(
            "Du siehst duenne Rauchfaeden am Himmel und erahnst den Geruch"
           +" von verbranntem Holz. Geh etwas naeher heran, dann kannst Du"
           +" sicher mehr erkennen."));
  AddDetail("holz", BS(
            "Du siehst hier kein Holz. Nur der Rauch am Himmel koennte"
           +" vielleicht mal Holz gewesen sein."));
  AddDetail("geruch", BS(
            "Wozu hast Du eine Nase?"));

  AddDetail(({"trampelpfad", "pfad", "weg"}), BS(
            "Der staubige Boden ist festgetreten von vielen Abenteurern,"
           +" die hier auf ihrem Weg durch die weite Steppe vorbeigekommen"
           +" sind."));
  AddDetail("boden", BS(
            "Der Boden ist staubig und ausser einem schmalem Trampelpfad"
           +" und viel Gras kannst Du nichts besonderes erkennen."));

  AddSound(DEFAULT_SOUND, BS(
           "Leise saeuselnd pfeifen vereinzelte Windstoesse durch das Gras."));
  AddSound(({"wind", "saeuseln"}), BS(
           "Du lauscht dem Saeuseln des Windes. Unspektakulaer, aber schoen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Schwach weht der Geruch von Feuern aus dem Feldlager im"
          +" Suedwesten hierher."));
  AddSmell("geruch", BS(
           "Es duerfte der Geruch von Rauch sein."));
  AddSmell("rauch", BS(
           "Rauch riecht rauchig."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  
  AddExit("suedwesten", ROOM("b1_a9"));
  AddExit("osten", ROOM("b3_a8"));
  AddExit("norden", ROOM("b2_a7"));
}

