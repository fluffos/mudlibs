/*
  Zone 3: Mitte
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int flowers;

create()
{
  ::create();

  SetProp(P_ZONE, "Mitte");
  SetProp(P_INT_SHORT, "Am Marktplatz");
  SetProp(P_INT_LONG, BS(
          "Du stehst am suedlichen Teil des Marktplatzes im Feldlager."
	 +" Hier gibt es nicht so viele aufregende Dinge zu beobachten wie"
	 +" vielleicht weiter noerdlich, jedoch siehst Du natuerlich auch"
	 +" hier ein stattliches schwarzes und ein buntes Zelt stehen."));
  AddDetail(({"zelte", "zelt"}), BS(
            "Du siehst vor Dir ein stattliches buntes und ein schwarzes Zelt"
	   +" mit einem Symbol darauf."));
  AddDetail("schwarzes zelt", BS(
            "Das schwarze Zelt hat ein Symbol aufgemalt."));
  AddDetail("buntes zelt", BS(
            "Das bunte Zelt ist einfach nur genial."));
  AddDetail("symbol", BS(
            "Das Symbol zeigt ein Posthorn."));
  AddDetail(({"posthorn", "horn"}), BS(
            "Das Posthorn steht fuer die Post im SilberLand."));
  AddDetail("silberland", BS(
            "Da bist Du ja wohl jetzt eingeloggt."));
  AddDetail("teil", BS(
            "Dieser Teil des Marktplatzes liegt eher im Sueden."));
  AddDetail("sueden", BS(
            "Hier gehts schon noch weiter suedlicher."));
  AddDetail(({"platz", "marktplatz"}), BS(
            "Der Marktplatz ist ein wichtiger Teil des Feldlagers."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Das Feldlager ist der Ort, an dem Du Dich im Moment befindest."));
  AddDetail("ort", BS(
            "Zum Untersuchen eines Ortes genuegt es, \"schau\" einzutippen."));
  AddDetail("dinge", BS(
            "Das interessanteste Ding hier ist ein schwarzes Zelt."));
  AddDetail(({"rand", "wegesrand", "weg", "boden"}), BS(
            "Am Wegesrand waechst eine Blume."));
  AddSpecialDetail(({"bluemchen", "gaensebluemchen", "blume"}), "fl"); 
  AddDetail("himmel", BS(
            "Der Himmel ist unertraeglich blau."));
  AddDetail("sonne", BS(
            "Wirds Dir nicht langsam fad, dauernd die Sonne zu untersuchen?"));
  AddSound(DEFAULT_SOUND, BS(
           "Hier hoert man von fern ein Posthorn blasen."));
  AddSound(({"horn", "posthorn"}), BS(
           "Es liegt wohl daran, dass hier die Post zu finden ist."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst einen angenehmen Blumenduft."));
  AddSmell(({"blumenduft", "duft"}), BS(
           "Der Blumenduft duerfte von einer Blume stammen."));
  AddSmell("blume", BS(
           "Untersuche sie mal."));

  
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_ROAD]));

  AddExit("norden", ROOM("a6_a0"));
  AddExit("nordwesten", ROOM("a5_a0"));
  SetProp (P_HIDE_EXITS, ({ "rein" }) );

  AddCmd(({"betrete", "betritt"}), "zelt");
  AddCmd(({"pflueck", "pfluecke"}), "flower");
  flowers=3;
}

reset()
{
  ::reset();
  flowers=3;
}

zelt(str)
{
  notify_fail("Was genau moechtest Du betreten?\n");
  if (str!="schwarzes zelt" && str!="buntes zelt")
    return 0;
  if (str=="schwarzes zelt") {
    write(BS(
          "Du betrittst das schwarze Zelt."));
    TP->move(ROOM("zelte/a6_b1"), M_GO, "ins schwarze Zelt");
  }
  else {
    // write("Das bunte Zelt ist nicht zugaenglich.\n");
    write(BS("Du betrittst das bunte Zelt von Spietato."));
    TP->move("/d/seher/haus/spietato:00:00", M_GO, "ins bunte Zelt");
  }

  return 1;
}


flower(str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if (str!="bluemchen" && str!="gaensebluemchen" && str!="blume")
    return 0;
  if (flowers>0) {
    write(BS("Du pflueckst ein Gaensebluemchen."));
    say(TPN+" pflueckt ein Gaensebluemchen.\n");
    clone_object(OBJ("blume"))->move(TP, M_SILENT);
    flowers--;
  }
  else
    write(BS("Nichts und niemand zum pfluecken da."));
  return 1;
}


fl()
{
  if (flowers>0)
    return "Es ist ein Gaensebluemchen.\n";
  else
    return "Hm, das war dann wohl eine Taeuschung. :(\n";
}

