#include "../../files.h"
#include <properties.h>
#include <language.h>

inherit "std/store";

create()
{
  ::create();

  if (!random(10))
    AddItem(OBJ("haar"), REFRESH_NONE);
  if (!random(10))
    AddItem(OBJ("wurz"), REFRESH_NONE);
  if (!random(10))
    AddItem(OBJ("minze"), REFRESH_NONE);
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/schaufel", REFRESH_REMOVE);
  AddItem("/obj/seil", REFRESH_REMOVE);
  AddItem(OBJ("pfanne"), REFRESH_REMOVE);
}

