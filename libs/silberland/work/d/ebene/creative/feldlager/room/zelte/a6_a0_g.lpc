/*
  Eigene Zone: Zelte
*/

#include "../../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Zelte");
  SetProp(P_INT_SHORT, "Im Auktionshaus");
  SetProp(P_INT_LONG, BS(
          "Das ist das Auktionshaus im Zeltlager. Fuer Versteigerungen aller"
	 +" Art ist Herr Sensal Bodenstab zustaendig, der Dir gern weiterhelfen"
	 +" wird. Du siehst hinter einer Theke ein paar kleinere Glasvitrinen"
	 +" in denen so mancherlei Gegenstaende liegen, die wohl keiner mehr"
	 +" haben will."));
  AddDetail(({"haus", "auktionshaus", "zelt", "auktionszelt"}), BS(
            "Man muesste genauer gesagt eher von einem Auktionszelt sprechen."));
  AddDetail("zeltlager", BS(
            "Du bist mitten im Feldlager, Sektion Zelte."));
  AddDetail("feldlager", BS(
            "Ja, das weisst Du doch schon dass Du im Feldlager bist."));
  AddDetail("sektion", BS(
            "Das Feldlager ist in 3 groessere Sektionen unterteilt."));
  AddDetail("sektionen", BS(
            "Da gibt es den noerdlichen, den oestlichen und den mittleren Teil."));
  AddDetail("teil", BS(
            "Ein Teil ist ein Teil eines Ganzen."));
  AddDetail("ganzes", BS(
            "Das Ganze ist in diesem Kontext das Feldlager."));
  AddDetail("kontext", BS(
            "Nu is aber genug. :-)"));
  AddDetail("theke", BS(
            "Vor Dir befindet sich eine schoen geschnitzte Theke aus Holz."));
  AddDetail("holz", BS(
            "Die Theke besteht aus Holz."));
  AddDetail("glas", BS(
            "Die Glasvitrinen sind Vitrinen mit Glas drumrum."));
  AddDetail(({"vitrine", "vitrinen", "glasvitrine", "glasvitrinen"}), BS(
            "Hinten im Raum befinden sich einige kleinere Glasvitrinen mit"
	   +" ein paar Gegenstaenden darin."));
  AddDetail("raum", BS(
            "Der Raum ist ja ein Zelt."));
  AddDetail("boden", BS(
            "Am Boden siehst Du wenig Interessantes, ausser natuerlich der"
	   +" Theke vor Dir."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Waende sind reichlich kahl. Nur im hinteren Teil des Raumes"
	   +" stehen ein paar Glasvitrinen an den Waenden."));
  AddDetail("gegenstaende", BS(
            "Bei den Gegenstaenden steht jeweils ein Taefelchen. Es handelt sich"
	   +" um ein Schwert des Grauens, ein poliertes Schild, einen Guertel"
	   +" mit vielen Taschen, einen Beutel der 4. Dimension, Schuhe der"
	   +" Geschwindigkeit, magische Armschienen und eine Kassette mit"
	   +" verschiedenen Ringen."));
  AddDetail("faelschung", BS(
            "Alles falsch, daher Faelschung."));
  AddReadDetail("taefelchen", BS(
            "Mist, auf jedem Schild steht: \"FAELSCHUNG\"."));
  AddDetail("taefelchen", BS(
            "Das sieht nicht gut aus, aber lies mal trotzdem..."));
  AddDetail("schwert", BS(
            "Das Schwert des Grauens vernichtet beim ersten Schlag fast jeden Gegner."));
  AddDetail("schild", BS(
            "Das polierte Schild scheint Zaubersprueche reflektieren zu koennen."));
  AddDetail("guertel", BS(
            "So ein Guertel mit vielen Taschen kann sehr praktisch sein, wenn"
	   +" man viel zu verstauen hat."));
  AddDetail("beutel", BS(
            "Der Beutel der 4. Dimension laesst alles, was man hineinsteckt,"
	   +" irrsinnig leicht werden. Und er hat trotzdem ungeheure Kapazitaet."));
  AddDetail("schuhe", BS(
            "Die Schuhe der Geschwindigkeit lassen Dich doppelt so schnell werden."));
  AddDetail(({"schienen", "armschienen"}), BS(
            "Die magischen Armschienen erhoehen Deine Magiepunkte."));
  AddDetail(({"kassette", "ringe"}), BS(
            "In der Kassette findest Du unter anderem einen Goldring, einen"
	   +" Rubinring, einen Aquamarinring und einen Diamantring."));
  AddDetail("goldring", BS(
            "Der Goldring erhoeht Deinen Ruestungswert."));
  AddDetail("rubinring", BS(
            "Der Rubinring hat wahrlich magische Faehigkeiten, er halbiert"
	   +" die Magiepunkte, die Du jeweils fuer Magie benoetigst."));
  AddDetail("aquamarinring", BS(
            "Der Aquamarinring ist huebsch anzusehen, kann aber nichts Besonderes."));
  AddDetail("diamantring", BS(
            "Dieser Diamantring ist ein maechtiges Artefakt. Wenn sehr boese"
	   +" Monster von ihm geblendet werden, erstarren sie sofort zu Stein."));
  AddDetail("decke", BS(
            "Ein Zelt hat im Prinzip keine Decke."));
  AddDetail("prinzip", BS(
            "Prinzipiell halt."));
  AddSound(DEFAULT_SOUND, BS(
           "Hier hoert man praktisch noch den Sound alter Versteigerungen."));
  AddSound(({"sound", "versteigerungen"}), BS(
           "Jemand ruft: Ich biete 1000 Muenzen!"));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht hier nach altem verstaubtem Zeugs, das keiner haben will."));
  AddSmell(({"zeug", "zeugs"}), BS(
           "Das Zeugs riecht alt und verstaubt."));


  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);

// Da Bodenstab blueprint...
//  AddItem(NPC("bodenstab"), REFRESH_DESTRUCT, 1);
  call_other(NPC("bodenstab") , "???");
  if(find_object(NPC("bodenstab"))) find_object(NPC("bodenstab"))->move(
      this_object(), M_NOCHECK);

  AddCmd(({"verlange","verlang"}), "SetPrice");

  AddExit("raus", ROOM("a6_a0"));
}


void reset() {
  ::reset();
  if(!present("\nauktionatorbodenstab")) {
    call_other(NPC("bodenstab") , "???");
    if(find_object(NPC("bodenstab"))) find_object(NPC("bodenstab"))->move(
        this_object(), M_NOCHECK);
  }
  return;
}

int SetPrice(string str) {
   string was, einheit;
   mixed wieviel;
   object ob;
   str=TP->_unparsed_args();
   if(!str || sscanf(str,"%d %s fuer %s", wieviel, einheit, was) != 3)
   {
     write("Syntax: verlange <x> muenze(n) fuer <gegenstand>\n");
     return 1;
   }
   if(member(({"muenzen", "muenze"}), lower_case(einheit))==-1 ||
       !intp(wieviel))
   {
     write("Syntax: verlange <x> muenze(n) fuer <gegenstand>");
     return 1;
   }
   if(wieviel < 101) {
     write("Dieser Preis ist zu niedrig!\n");
     return 1;
   }
   if(wieviel > 1000000000) {
     write("Dieser Preis ist zu hoch!\n");
     return 1;
   }
   if(!ob=present(was, TP)) 
   {
     write("Sowas hast Du nicht!\n");
     return 1;
   }
   ob->SetProp("auc_value", wieviel);
   write(sprintf("Ok, %s wird fuer %d Muenze(n) versteigert.\n", 
         ob->name(WER), wieviel));
   return 1;
}
