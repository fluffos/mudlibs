/*
  Zone 3: Koppel
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Koppel");
  SetProp(P_INT_SHORT, "Vor der Koppel");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich hier etwas abseits des Weges vor einer"
	 +" grossen Pferdekoppel. Westlich von Dir laufen wohl die"
         +" meisten Wesen vorbei, in Richtung Sueden. Oestlich von"
	 +" hier befindet sich eine Pferdekoppel."));
  AddDetail("wesen", BS(
            "Die meisten Wesen die hier vorbeikommen wuerdigen die"
	   +" Koppel keines Blickes."));
  AddDetail("blick", BS(
            "Naja, einen kleinen Blick kann man hier auf die Koppel"
	   +" schon werfen."));
  AddDetail("sueden", BS(
            "Weiter im Sueden von hier ist das Feldlager."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Frueher war das Feldlager noch voller Leben."));
  AddDetail("leben", BS(
            "Langsam erwacht das Feldlager aber wieder zum Leben."));
  AddDetail("weg", BS(
            "Der Weg im Westen fuehrt von Midas zum Feldlager."));
  AddDetail(({"midas", "hauptstadt", "stadt", "land", "silberland"}), BS(
            "Midas ist die Hauptstadt des SilberLand."));
  AddDetail("tor", BS(
            "Ein Gatter fuehrt nach Osten, um die Pferde durchzulassen."));
  AddDetail(({"pferd", "pferde"}), BS(
            "Die meisten Pferde stehen bestimmt auf der Koppel."));
  AddDetail("kreuzung", BS(
            "Sie befindet sich nordwestlich von Dir."));
  AddDetail(({"gras", "boden"}), BS(
            "Auf dem Boden waechst nicht mehr viel Gras, die Pferde duerften"
           +" das meiste niedergetrampelt haben.")); 
  AddDetail("himmel", BS(
            "Am Himmel steht unerbittlich die Sonne."));
  AddDetail("sonne", BS(
            "Die Sonne ist unerbittlich heiss."));
  AddDetail(({"koppel", "pferdekoppel"}), BS(
            "Oestlich von Dir faengt eine grosse Pferdekoppel an."));
  AddSound(DEFAULT_SOUND, BS(
           "Fast ist Dir, als ob Du das Trampeln von Hufen hoertest."));
  AddSound(({"trampeln", "hufe"}), BS(
           "Du hast Dich wahrscheinlich getaeuscht."));
  AddSmell(DEFAULT_SMELL, BS(
           "Ein Pferd hat hier sicherlich irgendwo gekotet. Es stinkt"
          +" naemlich scheusslich."));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]));

  AddExit("westen", ROOM("a5_a5"));
  
  NewDoor("osten", ROOM("a7_a5"),
          ({ "gatter", "pferdegatter" }), 
	  ({ D_NAME, "Pferdegatter", D_GENDER, NEUTER,
	     D_SHORT, "Ein %ses Gatter zur Koppel nach Osten.\n",
	     D_LONG, BS(
	       "Das Gatter ist wohl dazu da, die Pferde nicht hinauszulassen."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL
//	     D_OPENTESTFUNC, "opn"
	  }));
}

opn()
{
  write("Du hast keine Lust, das Pferdegatter jetzt zu oeffnen.\n");
  return 1;
}

