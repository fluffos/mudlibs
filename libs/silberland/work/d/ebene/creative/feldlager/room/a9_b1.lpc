/*
  Zone 3: Mitte
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Mitte");
  SetProp(P_INT_SHORT, "Oestlich des Marktplatzes");
  SetProp(P_INT_LONG, BS(
          "" ));
  
  AddSound(DEFAULT_SOUND, BS(
           "Leise Stimmen ertoenen von ueberall."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst nur Dich selber."));
  
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_ROAD]));

  // AddExit("nordosten", ROOM("a0_a0"));
  AddSpecialExit("osten", "bau");
  AddExit("westen", ROOM("a8_b1"));
}


bau()
{
  TP->move(Q_ROOM("bauplatz:"+getuid(TP)), M_GO, "auf den Bauplatz");
  return 1;
}

