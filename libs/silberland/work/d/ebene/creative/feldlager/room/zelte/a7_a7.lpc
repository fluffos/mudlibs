/*
  Eigene Zone: Zelte
*/

#include "../../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Zelte");
  SetProp(P_INT_SHORT, "Im verlassenen Zelt");
  SetProp(P_INT_LONG, BS(
          "Hier bist Du im verlassenen Zelt. Hier gibt es eigentlich kaum"
         +" etwas Besonderes zu schauen."));
  AddDetail("boden", BS(
            "Der Boden ist total festgestampft."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Waende sind nichts anderes als gewoehnliche Zeltplanen."));
  AddDetail("decke", BS(
            "Die Decke ist undicht. Wuerde es regnen, wuerdest Du nass."));
  AddDetail("zelt", BS(
            "Das Zelt besteht aus normalem Gestaenge und den Zeltplanen."));
  AddDetail(({"gestaenge", "verstrebungen", "verstrebung", "holz"}), BS(
            "Die Verstrebungen bestehen aus normalem Holz."));
  AddDetail(({"plane", "planen", "zeltplane", "zeltplanen"}), BS(
            "Die Zeltplanen bestehen eigentlich nur noch aus lauter Loechern"
           +" und Flicken.")); 
  AddDetail("loecher", BS(
            "Durch die Loecher kannst Du nach draussen sehen. Draussen sieht"
           +" es genau so aus, wie Du es zuerst schon gesehen hast, als Du Dich"
           +" draussen umgesehen hast."));
  AddDetail("flicken", BS(
            "Die Flicken bestehen aus Stoff."));
  AddDetail("stoff", BS(
            "Stoff, der scheinbar eine aehnliche Konsistenz hat wie Leder,"
           +" Dir jedoch unbekannt vorkommt."));
  AddDetail("leder", BS(
            "Hier findest Du kein Leder."));
  AddDetail("konsistenz", BS(
            "Toll, Du beherrscht Fremdwoerter. :)"));
  AddDetail(({"worte", "woerter", "fremdworte", "fremdwoerter", "wort", "fremdwort"}), BS(
            "Was gibts an Fremdwoertern schon zu untersuchen.")); 
  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst nur die Zeltplanen aneinanderschlagen."));
  AddSound(({"plane", "planen", "zeltplane", "zeltplanen"}), BS(
           "*flapp* *flapp* macht es unentwegt."));
  AddSmell(DEFAULT_SMELL, BS(
           "Hier drin riecht es so wie draussen. Die Zeltplanen sind so voller"
          +" Loecher, dass man hier nicht einmal von 'drinnen' sprechen kann."));

  SetProp(P_LIGHT,1);

  // Hier ist nicht einmal 'drin', drum lassen wir das INDOORS mal
  // SetProp(P_INDOORS, 1);
  
  AddExit("raus", ROOM("a7_a7"));
}


