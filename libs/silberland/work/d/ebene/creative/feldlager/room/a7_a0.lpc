/*
  Zone 3: Mitte
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Mitte");
  SetProp(P_INT_SHORT, "Am Marktplatz");
  SetProp(P_INT_LONG, BS(
          "Du bist am noerdlichen Ende des Marktplatzes. Ab und zu huscht"
	 +" eine emsige Gestalt durch den Raum um in einem der Zelte zu verschwinden."
	 +" Aus den Zelten hoert man leise Gespraeche."));
  AddDetail(({"platz", "marktplatz", "ende"}), BS(
            "Hier ist das noerdliche Ende des Marktplatzes."));
  AddDetail("gestalt", BS(
            "So schnell sausen die Leute in die Zelte und aus den Zelten heraus,"
	   +" dass Du sie gar nicht so genau beobachten kannst."));
  AddDetail("zelt", BS(
            "Welches Zelt genau meinst Du?"));
  AddDetail("zelte", BS(
            "Hier steht ein rotes und ein gelbes Zelt."));
  AddDetail("gelbes zelt", BS(
            "Das gelbe Zelt duerfte die Heimat der Sternendeuterin sein."));
  AddDetail("heimat", BS(
            "Deine Heimat ist wohl das SilberLand, nicht?"));
  AddDetail("silberland", BS(
            "Du befindest Dich gerade im SilberLand."));
  AddDetail(({"deuterin", "sternendeuterin"}), BS(
            "Im gelben Zelt wirst Du sie antreffen."));
  AddDetail("rotes zelt", BS(
            "Im roten Zelt befindet sich ein kleiner Laden."));
  AddDetail("laden", BS(
            "Betrete nur das rote Zelt, dann gelangst Du dorthin."));
  AddDetail("leute", BS(
            "Viele Leute sausen hier unentwegt hin und her."));
  AddDetail("raum", BS(
            "Der Raum ist hier."));
  AddDetail("boden", BS(
            "Am Boden ist nichts Besonderes zu erkennen."));
  AddDetail("himmel", BS(
            "Auch hier am Marktplatz siehst Du den Himmel - blau wie immer."));
  AddDetail("sonne", BS(
            "Die Sonne ist heute wieder einmal unerbittlich."));
  AddSound(DEFAULT_SOUND, BS(
           "Leise Stimmen ertoenen von ueberall."));
  AddSound("stimmen", BS(
           "Wart nur ein wenig, und Du wirst sie hoeren."));
  AddSound(({"gespraech", "gespraeche"}), BS(
           "Ab und zu dringt ein Gespraechsfetzen zu Dir."));
  AddSound(({ "fetzen", "gespraechsfetzen"}), BS(
           "Wart es nur ab."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst nur Dich selber."));

  AddRoomMessage(({"\"... das kostet aber in Midas weniger!\"\n",
                   "\"Verflixt, der Bursche hat mich betrogen!\"\n",
		   "\"Haben sie ein Mordorschwert auf Lager?\"\n",
		   "\"... Sie werden muede... ganz muede...\"\n",
		   "\"Wieviel kostet ein Horoskop?\"\n" }), 30);
  
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_ROAD]));

  AddExit("norden", ROOM("a7_a9"));
  AddExit("westen", ROOM("a6_a0"));
  AddItem("/p/service/thor/postcards/obj/postkasten.lpc", REFRESH_NONE);
//  AddExit("suedosten", ROOM("a8_b1"));
  AddCmd(({"betrete", "betritt"}), "zelt");
}

zelt(str)
{
  notify_fail("Was genau moechtest Du betreten?\n");
  if (str!="gelbes zelt" && str!="rotes zelt")
    return 0;
  str=explode(str, "s")[0];
  write(BS(
        "Du betrittst das "+str+" Zelt."));
  TP->move(ROOM("zelte/a7_a0"+(str=="gelbe"?"_g":"_r")), M_GO, "ins "+str+" Zelt");
  return 1;
}

