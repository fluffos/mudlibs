/*
  Zone 4: Klubhaus 
*/

#include "../../files.h"
inherit "std/pub";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Klubhaus");
  SetProp(P_INT_SHORT, "Im Partykeller");
  SetProp(P_INT_LONG, BS(
          "" ));
  
  AddSound(DEFAULT_SOUND, BS(
           "Leise Stimmen ertoenen von ueberall."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst nur Dich selber."));
  
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_PLAIN]));
  SetProp(P_INDOORS, 1);

  AddExit("westen", ROOM("klubhaus/keller"));
}


