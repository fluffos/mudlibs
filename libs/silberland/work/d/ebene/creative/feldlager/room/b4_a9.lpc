/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int schlange;

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Suedlich des Huegels");


  SetProp(P_INT_LONG, BS(
          "Du stehst genau am Fusse eines kleinen grasbewachsenen Huegels."
         +" Nach Nordwesten und Nordosten fuehrt ein ausgetretener"
         +" Trampelpfad durch das hohe Gras um den Huegel herum. Du kannst"
         +" nicht erkennen, wo der Pfad hinfuehrt, denn in noerdlicher"
         +" Richtung fuellt dieser grasbewachsene Buckel Deinen gesamten"
         +" Blick aus. Lediglich nach Sueden kannst Du die scheinbar endlose"
         +" Steppe bis zum fernen Horizont ueberblicken. Aber dorthin fuehrt"
         +" kein Weg und das im Sonnenlicht wogende Grasmeer haelt Dich davon"
         +" ab, Dich (auch ohne Weg) dorthin auf den Weg zu machen."
         +" Im Suedosten fuehrt der Weg ins dichte Gebuesch."));
  AddDetail("gebuesch", BS(
            "Weiter nach Suedosten fuehrt der Weg ins dichte Gebuesch."));
  AddDetail("fuss", BS(
            "Du kannst nichts Besonderes an Deinem Fuss erkennen."));
  AddDetail("besonderes", BS(
            "Da ist nichts Besonderes zum anschaun."));
  AddDetail(({"huegel", "buckel"}), BS(
            "Ein kleiner grasbewachsener Huegel liegt noerdlich von Dir."
           +" Obwohl er nicht gerade sehr hoch ist, fuellt er Dein ganzes"
           +" Blickfeld aus. Wie ein dichter Teppich bedeckt hohes Gras"
           +" diesen Buckel und verhindert, dass Du ueber ihn hinwegsehen"
           +" kannst. Aber wozu drueber gucken? Ein ploetzliches Schimmern"
           +" bringt Dich auf die Idee, das Gras mal genauer anzusehen."));
  AddDetail("teppich", BS(
            "Wie ein verfilzter und recht schmuddliger Teppich bedeckt hohes"
            +" Gras den Huegel."));
  AddDetail(({"schimmer", "schimmern"}), BS(
            "Zwischen den dichten Grashalmen blitzt es im Sonnenlicht ploetzlich"
           +" auf. Ob da etwas liegt? Vielleicht eine Phiole oder doch nur ein"
           +" glaenzender Faden? So neugierig, wie Du bist, magst Du Dir das"
           +" sicher naeher ansehen. Aber einfach so ins Gras greifen? Immerhin"
           +" soll es hier Schlangen geben."));
  AddDetail("idee", BS(
            "Du suchst und suchst und kannst sie nicht finden."));
  AddDetail(({"nordwesten", "nordosten"}), BS(
            "Der schmale Trampelfpad fuehrt durch das hohe Gras nach Nordwesten"
           +" und Nordosten."));
  AddDetail(({"trampelpfad", "pfad"}), BS(
            "Kaum mehr als einen Fuss breit windet sich der ausgetretene"
           +" Trampelpfad durch die Steppe. Manchmal scheint er im hohen"
           +" Gras spurlos zu verschwinden und hier am Huegel kannst Du ihn"
           +" kaum ueberblicken."));
  AddDetail("gras", BS(
            "Hohes Gras bedeckt alles um Dich herum. Duerre trockene Stengel"
           +" und zerfaserte Halme wiegen sich im Wind und nach Sueden hin"
           +" dehnt sich ein gelbes Meer aus Gras scheinbar endlos aus. Der"
           +" kleine Huegel im Norden traegt ebenfalls einen staubigen"
           +" Teppich, so verfilzt und dicht, dass Du nicht bis auf die"
           +" Erde oder eher den Sand hindurchblicken kannst. Ein schwaches"
           +" Schimmern fesselt Deine Aufmerksamkeit und beim zweiten Blick"
           +" meinst Du einen silbrig leuchtenden Faden (eine Phiole?) zu"
           +" erkennen."));
  AddDetail("stengel", BS(
            "Die duerren trockenen Stengel wiegen sich im Wind."));
  AddDetail(({"halme", "grashalme"}), BS(
            "Die trockenen zerfaserte Grashalme wiegen sich im Wind."));
  AddDetail("wind", BS(
            "Schwacher Wind bewegt murmelnd das Gras um Dich herum und weht"
           +" Dir Sand in die Augen."));
  AddDetail("augen", BS(
            "Ohne diesen kruemeligen Sand ueberall wuerden sich Deine Augen"
           +" wohler fuehlen."));
  AddDetail(({"erde", "sand", "boden"}), BS(
            "Durch das verfilzte Gras kannst Du nicht bis zum Boden"
           +" hindurchblicken. Vermutlich gibt es dort Erde und ganz sicher"
           +" Sand, denn der piekst Dich recht unangenehm in den Augen."));
  AddDetail("aufmerksamkeit", BS(
            "Du passt auf, aber mehr passiert nicht."));
  AddDetail("faden", BS(
            "Das koennte wirkliche eine schillernde Phiole sein."));
  AddDetail("phiole", BS(
            "Eine silberne Phiole liegt weit unten im verfilzten Gras. Gerade"
           +" als Du danach greifen willst, kommen dir die Schlangen in den"
           +" Sinn, die es hier geben soll. Vielleicht solltest Du doch lieber"
           +" mit etwas anderem im Gras stochern oder nach der Phiole angeln."));
  AddDetail(({"schlange", "schlangen"}), BS(
            "Du siehst hier keine Schlange, aber in all dem hohen Gras kann"
           +" sich so einiges verbergen, was Du gerade nicht sehen kannst."));
  AddDetail("richtung", BS(
            "Welche denn?"));
  AddDetail("blick", BS(
            "Du schaust Dir tief in die Augen. Oder so."));
  AddDetail("sueden", BS(
            "Im Sueden erstreckt sich die Steppe bis zum Horizont und kein Weg"
           +" fuehrt dorthin."));
  AddDetail(({"steppe", "land"}), BS(
            "Heiss und trocken, staubig und sandig und vor allem ziemlich grasig."));
  AddDetail("horizont", BS(
            "Weit im Sueden kannst Du ueber die Steppe bis zum Horizont sehen,"
           +" aber kein Weg fuehrt dorthin."));
  AddDetail("weg", BS(
            "Ein schmaler Trampelpfad fuehrt von Nordosten nach Nordwesten um den"
            " kleinen Huegel herum. Nach Sueden dehnt sich endlose und weglose"
           +" Steppe aus."));
  AddDetail(({"licht", "sonnenlicht", "sonne"}), BS(
            "Gleissend hell und wirklich heiss strahlt Dich die Sonne vom Himmel"
           +" an und Du ertappst Dich dabei, dass Du Dich nach einem"
           +" richtigen Regen sehnst."));
  AddDetail("himmel", BS(
            "Der Himmel ist heute mal wieder blau und wolkenlos."));
  AddDetail("regen", BS(
            "Hm, Du scheinst erste Halluzinationen zu haben und solltest Dich"
           +" vielleicht besser in den Schatten verkriechen."));
  AddDetail(({"halluzinationen", "halluzination"}), BS(
            "Wow, spannend!"));
  AddDetail("schatten", BS(
            "Ja gern, bloss wo ist einer?"));
  AddDetail(({"grasmeer", "meer"}), BS(
            "Ein sanft auf- und abwogende Grasflaeche erstreckt sich silbrig"
           +" glaenzend wie ein weites Meer nach Sueden."));
  AddDetail("huette", BS(
            "Ueber der Tuer befindet sich ein Schild."));
  AddReadDetail("schild", BS(
                "Lostboy's Seherhaus."));
  AddDetail("schild", BS(
            "Schilder kann man lesen."));

  AddCmd(({"greif", "greife"}), "get");
  AddCmd(({"nehme", "nimm"}), "take");
  AddCmd(({"stochere", "stocher"}), "grab");
  AddCmd(({"angele", "angle", "angel"}), "angel");

  AddSound(DEFAULT_SOUND, BS(
           "Leise murmelnd streicht der Wind durchs Gras und biegt es"
          +" knisternd bis zum Boden."));
  AddSmell(DEFAULT_SMELL, BS(
           "Der Duft von trockenem Gras und staubigem Land umgibt Dich."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  
  AddExit("nordwesten", ROOM("b3_a8"));
  AddExit("nordosten", ROOM("b5_a8"));
  AddExit("suedosten", "/d/ebene/lostboy/steppe/room/steppe1");

  schlange = 2;
}

reset()
{
  ::reset();
  schlange = 2;
}

get(str)
{
  notify_fail("Wohin moechtest Du greifen?\n");
  if (str!="in gras")
    return 0;
  take("phiole");
  return 1;
}

take(str)
{
  int pois;
  object ob;
  
  if (str!="phiole")
    return 0;
  if (TP->QueryProp(P_GHOST)) {
    write(BS(
        "Du greifst tief ins Gras, aber Deine Hand faehrt hindurch, Du "
        "spuerst nichts. Ploetzlich erinnerst Du Dich daran, dass Du "
        "ja ein Geist bist..."));
    return 1;
  }
  write(BS(
        "Du steckst den Arm tief ins Gras und greifst nach der glaenzenden"
       +" Phiole. Aber kaum haeltst Du sie in der Hand spuerst Du einen"
       +" stechenden Schmerz und laesst sie gleich wieder los."));
  pois=TP->QueryProp(P_POISON)+3;
  if (pois>TP->QueryProp(P_MAX_POISON))
    pois=TP->QueryProp(P_MAX_POISON);
  TP->SetProp(P_POISON, pois);
  if (!present("giftschlange") && schlange) {
    (ob=clone_object(NPC("giftschlange")))->move(TO, M_GO);
    ob->Kill(TP);
    schlange--;
  }
  return 1;
}

grab(str)
{
  string s, dummy;
  
  notify_fail("Womit moechtest Du im Gras stochern?\n");
  if (!stringp(str))
    return 0;
  if (str=="in gras" || str=="im gras")
    return 0;
  if (sscanf(str, "mit %s %s gras", s, dummy)) {
    return angel("mit "+s+" nach phiole");
  }
  return 0;
}

angel(str)
{
  string s;
  
  notify_fail("Wonach moechtest Du angeln? Und womit?\n");
  if (!stringp(str))
    return 0;
  if (str=="nach phiole") {
    write("Womit denn?\n");
    return 1;
  }
  if (sscanf(str, "mit %s nach phiole", s))
    if (s=="angel" || s=="stock" || s=="schwert")
      if (present(s, TP)) {
        if (TP->FindPotion(BS(
            "Du stocherst mit "+CAP(s)+" im Gras und angelst die Phiole aus den"
           +" verfilzten Halmen. Dein Glueck, dass Du das nicht mit mit"
           +" Deinen Haenden versucht hast, dann haette Dich naemlich die"
           +" Schlange sicher erwischt, die sich jetzt Die Zaehne an Deine"
           +(s=="angel"?"r ":"m ")+CAP(s)+" ausbeisst."))) ;
        else
          write(BS(
                "Du angelst nach der Phiole, bloederweise rutscht sie Dir"
               +" vo"+(s=="angel"?"n der ":"m ")+CAP(s)+"."));
        return 1;
        }
      else {
        write("Hast Du denn ein"+(s=="stock" ? "en " : " ")+CAP(s)+" bei Dir?\n");
        return 1;
      }
    else
      return 0;
  else
    return 0;
}

