/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Lagerkreuzung");
  SetProp(P_INT_LONG, BS(
          "Hier siehst Du eine der wichtigsten Lagerkreuzungen im gesamten"
         +" Feldlager. Im Norden gelangst Du in weiterer Folge zur Ostallee,"
         +" im Suedwesten kommst Du mitten ins Herz des Feldlagers. Nach"
         +" Suedosten kannst Du die oestliche Zone des Lagers erreichen."));
  AddDetail(({"lagerkreuzung", "lagerkreuzungen", "kreuzung", "kreuzungen"}), BS(
            "Du stehst mitten drauf."));
  AddDetail(({"herz", "fleck"}), BS(
            "Dein Herz befindet sich am rechten Fleck."));
  AddDetail(({"ostallee", "allee"}), BS(
            "Die Ostallee befindet sich noerdlich von Dir."));
  AddDetail("himmel", BS(
            "Die Sonne brennt unerbittlich herunter."));
  AddDetail("sonne", BS(
            "Wenn Du nicht bald was zu trinken bekommst, verdurstest Du noch."));
  AddDetail("boden", BS(
            "Hier am Boden ist ausser Deiner eigenen Spur nichts zu erkennen."));
  AddDetail("spur", BS(
            "Du betrachtest Deine Spur etwas eingehender. Aber zu einem anderen"
           +" Entschluss, als dass die Spur von Dir sein koennte, gelangst Du"
           +" nicht."));
  AddDetail("zone", BS(
            "Wie Du vielleicht schon bemerkt hast, ist das Lager in einzelne"
           +" Zonen aufgeteilt. Hier befindest Du Dich noch in der noerdlichsten"
           +" Zone des Feldlagers."));
  AddDetail(({"lager", "feldlager"}), BS(
            "In Richtung Suedwesten gelangst Du definitiv in die Mitte des"
           +" Feldlagers."));
  AddDetail("mitte", BS(
            "Mitte? Ist das nicht das Innerste eines Kreises?"));
  AddDetail("kreis", BS(
            "Das war doch nur ein rein theoretischer Ansatz."));
  AddDetail("ansatz", BS(
            "Nein, weiter fuehre ich diese Detailtiefe nicht."));
  AddDetail(({"tiefe", "detailtiefe"}), BS(
            "Du bist aeusserst mutig, so weit vorzudringen."));
  AddSound(DEFAULT_SOUND, BS(
           "Ein komisches Geraeusch dringt aus dem Nordwesten an Dein Ohr."));
  AddSound("geraeusch", BS(
           "Es klingt wie *flappflapp* oder so aehnlich."));
  AddSmell(DEFAULT_SMELL, BS(
           "Obwohl Du im Nordwesten noch einen Hauch von Rindsuppe"
          +" wahrgenommen hast, riecht es hier eigentlich nach nichts."));
  AddSmell(({"suppe", "rindsuppe"}), BS(
           "Im Nordwesten riecht es definitiv staerker danach."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN:TT_PLAIN]));

  AddExit("nordwesten", ROOM("a7_a7"));
  AddExit("suedosten", ROOM("a9_a9"));
  AddExit("suedwesten", ROOM("a7_a9"));
}

