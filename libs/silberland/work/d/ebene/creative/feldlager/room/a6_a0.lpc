/*
  Zone 3: Mitte
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Mitte");
  SetProp(P_INT_SHORT, "Am Marktplatz");
  SetProp(P_INT_LONG, BS(
          "Du bist am westlichen Teil des Marktplatzes. Von ueberall draengen"
	 +" wie gewohnt Stimmen an Dein Ohr. Ausser dem blauen und dem gruenen"
	 +" Zelt gibt es hier kaum wesentliche Dinge zu erkennen."));
  AddDetail(({"zelte", "zelt"}), BS(
            "Hier gibt es ein blaues und ein gruenes Zelt."));
  AddDetail("blaues zelt", BS(
            "Beim blauen Zelt handelt es sich um den Weinstadl."));
  AddDetail("weinstadl", BS(
            "Geh nur hinein, Du wirst es nicht bereuen."));
  AddDetail("gruenes zelt", BS(
            "Im gruenen Zelt findet sich eine Auktionsfirma."));
  AddDetail(({"firma", "auktionsfirma"}), BS(
            "Im Auktionszelt kannst Du Deine Objekte versteigern lassen."));
  AddDetail("objekte", BS(
            "Das was Du halt so bei Dir traegst."));
  AddDetail(({"platz", "marktplatz"}), BS(
            "Der Marktplatz ist im Prinzip der Mittelpunkt des gesamten"
	   +" Feldlagers. Hier tummeln sich die meisten Menschen, die im Zuge"
	   +" ihres Aufenthaltes im Feldlager verweilen."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Da stehst Du doch mittendrin!"));
  AddDetail("aufenthalt", BS(
            "Du haeltst Dich doch selber hier auf, oder ?!"));
  AddDetail(({"punkt", "mittelpunkt"}), BS(
            "Der Mittelpunkt des Feldlagers ist der Marktplatz, auf dem"
	   +" Du Dich soeben befindest."));
  AddDetail("menschen", BS(
            "Vielerlei Wesen treiben sich hier herum."));
  AddDetail("wesen", BS(
            "Da gibt es Hobbits, Menschen, Elfen, Zwerge, Gnome, Trolle,"
	   +" Gaffos, Schlammspringer, ..."));
  AddDetail("hobbits", BS(
            "Das sind kleine pelzige Wesen."));
  AddDetail("menschen", BS(
            "Nunja, auch sowas soll es geben. Schlimm, was?"));
  AddDetail("elfen", BS(
            "Komm mir bitte nicht mit Elfen."));
  AddDetail("zwerge", BS(
            "Zwerge? Genial. Sind die besten Kunden hier im Feldlager."));
  AddDetail("gnome", BS(
            "Tja, die Gnome tauchen eher selten hier auf..."));
  AddDetail("trolle", BS(
            "Wenn Trolle hier mal sind, dann nur bei Nacht."));
  AddDetail("nacht", BS(
            "Die Nacht kann grausam und kalt sein, hier mitten im Feldlager..."));
  AddDetail("boden", BS(
            "Am Boden findest Du die verschiedensten Spuren."));
  AddDetail("spuren", BS(
            "Eine Spur faellt Dir besonders auf."));
  AddDetail("spur", BS(
            "Es muss die Spur von Feyaria sein, die hier schon einmal voruebergegangen"
	   +" ist, sicherlich auf der Suche nach Bugs und Typos."));
  AddDetail(({"suche", "bugs", "typos"}), BS(
            "Wenn Du Bugs oder Typos findest, dann hilf uns Magiern doch."));
  AddDetail(({"stimme", "stimmen"}), BS(
            "Stimmen kann man gut lauschen."));
  AddDetail("sonne", BS(
            "Die Sonne steht unerbittlich am Himmel. Es ist heiss."));
  AddDetail("himmel", BS(
            "Am Himmel kannst Du sehr gut (weil unuebersehbar) die Sonne"
	   +" erkennen."));
  AddDetail(({"ding", "dinge"}), BS(
            "Ding? Ein Ding? Hmmm."));
  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst interessante Stimmen von ueberall."));
  AddSound("stimmen", BS(
           "So hoere doch!"));
  AddSmell(DEFAULT_SMELL, BS(
           "Hier riechts ein klein wenig nach Wein."));
  AddSmell("wein", BS(
           "Es handelt sich sicherlich um den Heurigenduft, der aus dem"
	  +" blauen Zelt kommt."));
  AddSmell(({"duft", "heurigenduft"}), BS(
           "Aus dem blauen Zelt riecht es nach koestlichem Heurigen."));

  AddRoomMessage(({"\"Herrgott Sakra Mistdiebe! Alarm!\"\n",
                   "\"Hallo? Ist da wer?\"\n",
		   "\"*hick* wos soi i do no sogn...\"\n",
		   "\"Geh Oide bring ma nu a Vierterl!\"\n",
		   "\"Also ich muss sagen, diese Ente... koestlich!\"\n" }), 30);
  
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26, ENV_TERRAIN:TT_ROAD]));

  AddExit("sueden", ROOM("a6_b1"));
  AddExit("osten", ROOM("a7_a0"));
  AddCmd(({"betrete", "betritt"}), "zelt");
  AddItem(OBJ("urne"), REFRESH_NONE);
}

zelt(str)
{
  notify_fail("Was genau moechtest Du betreten?\n");
  if (str!="blaues zelt" && str!="gruenes zelt")
    return 0;
  str=explode(str, "s")[0];
/*  if (str=="gruene") {
    write("Das Auktionshaus ist voruebergehend geschlossen.\n");
    return 1;
  } */
  write(BS(
        "Du betrittst das "+str+" Zelt."));
  TP->move(ROOM("zelte/a6_a0"+(str=="blaue"?"_b":"_g")), M_GO, "ins "+str+" Zelt");
  return 1;
}

