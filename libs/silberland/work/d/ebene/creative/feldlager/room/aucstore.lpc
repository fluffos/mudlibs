#include <properties.h>
#include <bank.h>
#include <moving.h>
#include <wizlevels.h>

inherit "/std/thing/properties";
inherit "/std/room/items";
inherit "/std/container/description";
inherit "/std/room/restrictions";

create()
{
  seteuid(getuid());
  properties::create();
  items::create();
}

void reset()
{
  items::reset();
} 

varargs string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  return "Ein Lagerraum.\n";
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  return break_string("Du stehst in einem Lagerraum, in dem Du "
      "eigentlich ueberhaupt nichts verloren hast", 78);
}


