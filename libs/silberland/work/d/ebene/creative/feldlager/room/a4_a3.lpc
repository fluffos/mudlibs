/*
  Hier beginnt nun das Feldlager.
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Am Holzstapel");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich suedlich der Ostallee. Im Nordwesten siehst Du"
         +" eine Kreuzung. Im Sueden veraendert sich die Landschaft"
         +" ziemlich deutlich, es sieht schon fast wie eine Steppe aus."
         +" Doch hier ist noch viel Gruen um Dich, sogar frisch geschnittenes"
         +" Holz liegt hier fein saeuberlich auf einem Stapel."));
  AddDetail(({"allee", "ostallee"}), BS(
            "Die Ostallee befindet sich noerdlich von Dir. Hier duerfte jemand"
           +" ein paar Baeume aus der Allee gefaellt haben, um Platz fuer diesen"
           +" Weg zu machen."));
  AddDetail(({"baum", "baeume"}), BS(
            "Ausser einem Holzstapel und den Baeumen der Allee siehst Du keine."));
  AddDetail("kreuzung", BS(
            "Die Kreuzung mit der Ostallee ist im Nordwesten."));  
  AddDetail(({"aenderung", "landschaft", "steppenlandschaft", "steppe"}), BS(
            "Suedlich von Dir beginnt eine weite Steppenlandschaft."));
  AddDetail(({"wiese", "blumenwiese", "gruen"}), BS(
            "Eine schoen gepflegte Blumenwiese. Und im Norden die Allee."));
  AddDetail(({"wegrand", "weg"}), BS(
            "Am Wegrand siehst Du einen groesseren Holzstapel, der irgendwie"
           +" faszinierend aussieht. Sonst ist am Weg kaum etwas Besonderes"
           +" zu erkennen."));
  AddDetail("boden", BS(
            "Auf dem Boden sieht man noch einige Saegespaene."));
  AddDetail(({"spaene", "saegespaene"}), BS(
            "Die Spaene duerften von Saegearbeiten stammen."));
  AddDetail(({"holz", "holzstapel", "stapel"}), BS(
            "Ein Holzstapel von nicht allzu beachtlicher Groesse. Elf Staemme"
           +" sind es, die hier aufeinandergestapelt neben dem Weg liegen."));
  AddDetail("staemme", BS(
            "Ein kleiner Stamm ist es, der Dich besonders fasziniert."));
  AddDetail(({"kleiner stamm", "kleinen stamm", "stamm"}), BS(
            "Du untersuchst den kleinen Stamm genauer, kannst jedoch nichts"
           +" Besonderes daran erkennen. Aber irgendwie ist der Baum auffaellig."
           +" Vielleicht solltest Du den Stamm einmal heben?"));
  AddDetail("himmel", BS(
            "Einen Himmel siehst Du oben, er ist blau wie immer."));
  AddSound(DEFAULT_SOUND, BS(
           "Seltsamerweise liegt hier noch das Geraeusch von einer Saege in"
          +" der Luft."));
  AddSound(({"saege", "geraeusch"}), BS(
           "Es muss an dem frisch geschnittenen Holz liegen, dass Du Dir"
          +" einbildest, es klaenge wie eine Saege.")); 
  AddSmell(DEFAULT_SMELL, "Es riecht hier sehr stark nach frischen Holz.\n");
  AddSmell("holz", BS(
           "Hier duerften vor kurzem noch ein paar Baeume der Allee abgeschnitten"
          +" worden sein, vielleicht um den Weg nach Sueden fertigzustellen. Ein"
          +" paar Staemme liegen neben dem Weg."));
  AddSmell(({"stamm", "staemme"}), BS(
           "Koestlich, wie frisch geschnittenes Holz duftet.")); 
  SetProp(P_LIGHT,1);
  SetProp(P_EXIT_PREPOSITION, "nach");
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN]));
    // fuer non-standard-Ausgaenge :)

  AddExit("nordwesten", ROOM("a3_a2"));
  AddExit("sueden", ROOM("a4_a4"));
  
  AddCmd(({"heb", "hebe"}), "heb");
  AddCmd(({"klopf", "klopfe"}), "knock");
  AddCmd("oeffne", "open");
  AddCmd(({"werfe", "wirf"}), "throw");
  AddCmd(({"spalt", "spalte"}), "spalt");

  AddItem("/d/ebene/Silberwald/npc/biber", REFRESH_DESTRUCT);
}


heb(str)
{
  notify_fail("Was moechtest Du heben?\n");
  if (!(str=="stamm" || str=="kleinen stamm" || str=="stamm an"
      || str=="kleinen stamm an"))
    return 0;
  write(BS(
        "Du hebst den kleinen Stamm in die Hoehe. Er ist ziemlich leicht."
       +" Vielleicht solltest Du einmal daran klopfen."));
  say(TPN+" hebt einen kleinen Stamm in die Hoehe.\n");
  return 1;
}

knock(str)
{
  notify_fail("Woran moechtest Du gern klopfen?\n");
  if (!(str=="an stamm" || str=="stamm" || "an kleinem stamm" ||
      str=="kleinen stamm"))
    return 0;
  write(BS(
        "Der Baumstamm scheint hohl! Was das wohl bedeuten mag? Wie koenntest"
       +" Du wohl ins Innere gelangen, Du Spalter? :)"));
  say(TPN+" klopft an einen Baumstamm.\n");
  return 1;
}

open(str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if (!(str=="stamm" || str=="kleinen stamm" || str=="baumstamm" ||
      str=="kleinen baumstamm"))
    return 0;
  write(BS(
        "Naja, die Idee ist nicht schlecht. Aber um den Stamm zu oeffnen,"
       +" musst Du schon rohe Gewalt anwenden. Vielleicht probier einmal,"
       +" den Stamm auf die Erde zu werfen."));
  return 1;
}

throw(str)
{
  notify_fail("Was moechtest Du wohinwerfen?\n");
  if (!(str=="stamm auf erde" || str=="kleinen stamm auf erde" ||
      str=="baumstamm auf erde" || str=="kleinen baumstamm auf erde"))
    return 0;
  write("Du wirfst den kleinen Baumstamm mit aller Wucht gegen die Erde.\n");
  say(TPN+" wirft einen kleinen Baumstamm mit aller Wucht auf die Erde.\n");
  tell_room(TO, "Der Baumstamm zerbirst in 100 Teile.\n");
  if ( !TP->FindPotion(BS(
      "Beim Zusammenraeumen der Truemmer findest Du ein kleines Flaeschchen, "
      "das Du sofort austrinkst.")) )
  {
    write("Enttaeuscht raeumst Du die Truemmer zusammen.\n");
    say(TPN+" raeumt enttaeuscht die Truemmer auf.\n");
  }
  return 1; 
}

spalt(str)
{
  notify_fail("Was moechtest Du spalten?\n");
  if (!(str=="stamm" || str=="kleinen stamm" ||
      str=="baumstamm" || str=="kleinen baumstamm"))
    return 0;
  if (present("axt", TP) || present("beil", TP))
    write(BS(
          "Deine Axt ist nicht dazu geeignet, den Baumstamm zu spalten. Aber"
         +" vielleicht laesst sich der Stamm einfach oeffnen?"));
  else
    write(BS(
          "Du hast keine Axt dabei."));
  return 1;
}
