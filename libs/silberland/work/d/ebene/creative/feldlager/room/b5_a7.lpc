/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "In der Talsenke");
  SetProp(P_INT_LONG, BS(
          "Am Boden der Talsenke, entpuppt sich der dunkelbraune Fleck tatsaechlich"
         +" als See, oder vielmehr als dessen verschlammter, fast ausgetrockneter"
         +" Rest. Der Weg, dem Du bis hierher gefolgt bist, steigt nach Sueden"
         +" leicht an und verschwindet in einem goldgelben Meer aus Gras. Nach"
         +" Norden fuehrt er am schlammigen Ufer des Tuempels entlang. Nach Westen"
         +" zweigt ein schmaler Pfad ab und fuehrt in einen Wald aus mannshohem"
         +" Schilf hinein."));
  AddDetail(({"meer", "gras"}), BS(
            "Das wogende Gras laesst Dich sehnsuechtig an ein Meer denken."));
  AddDetail("hand", BS(
            "Du musterst Deine Hand sehr genau. Sie sieht ueberraschenderweise aus wie vorhin."));
  AddDetail(({"boden", "untergrund"}), BS(
            "Der staubige Boden der Steppe verwandelt sich hier am Ufer des"
           +" Tuempels in klebrigen Schlamm, der in Klumpen an Deinen Fuessen"
           +" haftet. Sobald der Schlamm trocknet, verbackt er zu steinharten"
           +" Brocken und schon nach wenigen Schritten fluchst Du ueber diesen"
           +" Untergrund in nicht weniger phantasievollen Toenen, wie zuvor"
           +" ueber den Staub. Ein Abenteurer ist halt nie zufrieden..."));
  AddDetail("abenteurer", BS(
            "Ausser Dir kannst Du gerade keinen anderen Abenteurer entdecken und so"
           +" betrachtest Du Dich aufmerksam. Gar nicht so uebel! Vielleicht etwas zu"
           +" lange nicht mehr gebadet und diese Kleidung ist auch schon ziemlich"
           +" zerschlissen...naja....immerhin, ein unternehmungslustiger und (noch?)"
           +" lebendiger Abenteurer. Das ist doch schon was wert."));
  AddSpecialDetail("kleidung", "cloth");
  AddDetail(({"steppe", "sueden", "horizont"}), BS(
            "Nach Sueden dehnt sicht bis zum Horizont die weite grasbewachsene"
           +" Steppe aus."));
  AddDetail("himmel", BS(
            "Blau und wolkenlos."));
  AddDetail(({"schlamm", "matsch", "ufer"}), BS(
            "Gruenbrauner, ekliger und recht uebelriechender Schlamm saeumt"
           +" das Ufer des Tuempels und bleibt bei jedem Schritt an Deinen"
           +" Fuessen kleben."));
  AddDetail(({"matschklumpen", "klumpen"}), BS(
            "Grosse Matschklumpen kleben an Deinen Fuessen und machen das"
           +" Gehen schwierig. Vielleicht kannst Du den Schlamm ja mit den"
           +" Haenden abstreifen? Vielleicht macht das aber auch alles nur"
           +" schlimmer."));
  AddDetail("geruch", BS(
            "Kann man den sehen?"));
  AddDetail(({"fuesse", "haende"}), BS(
            "Igitt, was sind die dreckig. Lange nicht mehr gebadet, hm?"));
  AddDetail("fuss", BS(
            "Interessiert betrachtest Du zuerst Deinen linken Fuss, dann den rechten"
           +" und zuletzt noch den Fuss der Talsenke in der Du stehst. Nicht sonderlich"
           +" interessant das ganze. Da Du keine weiteren Fuesse mehr finden kannst"
           +" wendest Du dich wieder anderen Dingen zu."));
  AddDetail("brocken", BS(
            "Steinhart gebackene Brocken aus Schlamm liegen ueberall herum"
           +" und machen das Gehen beschwerlich. Pass auf, dass Du Dir nicht"
           +" die Knoechel verstauchst."));
  AddDetail("knoechel", BS(
            "Deine Knoechel sitzen etwas oberhalb von Deinen Fuessen und sind"
           +" nicht weniger dreckig als diese. Aber immerhin sind sie noch heil"
           +" und wenn Du beim Gehen aufpasst, werden sie es wohl auch bleiben."));
  AddDetail(({"schritt", "schritte", "gehen"}), BS(
            "Das Gehen auf dem schlammigen Boden ist gar nicht so einfach."));
  AddDetail("toene", BS(
            "Sichtbare Toene? Interessant!"));
  AddSpecialDetail("umgebung", "envv");
  AddDetail("staub", BS(
            "Im Vergleich zum bisherige Weg durch die Steppe ist es hier am"
           +" Ufer des Tuempels schlammig und langsam beginnst Du Dir den Staub"
           +" zurueck- und die Stechmuecken und den Schlamm wegzuwuenschen."
           +" Ein Abenteurer ist halt nie zufrieden..."));
  AddDetail(({"stechmuecken", "muecken"}), BS(
            "Die einzigen, denen ein solcher Schlammtuempel zu gefallen scheint,"
           +" sind Myriaden von Moskitos und als einziger Abenteurer weit"
           +" und breit hast Du ihre ungeteilte Aufmerksamkeit."));
  AddDetail(({"quaelgeister", "plagegeister", "moskito", "moskitos", "vampir", "vampire", "miniaturvampir", "miniaturvampire"}), BS(
            "Blutruenstige Plagegeister, die sich begeistert auf Dich stuerzen und"
         +" Dich aussaugen. Miniaturvampire sozusagen."));
  AddDetail("aufmerksamkeit", BS(
            "Die Muecken lieben Dich!"));
  AddDetail("myriaden", BS(
            "Viele! Gaaaanz viele!"));
  AddDetail(({"senke", "talsenke"}), BS(
            "Eine kleine Talsenke unterbricht hier die weite Steppe. Die Luft"
           +" hier am Boden der Senke erscheint Dir etwas kuehler, aber das"
           +" liegt wohl nur an dem schwachen Windhauch, der ueber den Tuempel"
           +" zu Dir her weht. Die Luft selbst traegt einen fauligen Geruch"
           +" nach warmen Schlamm zu Dir her. Der dunkle Fleck in der Senke"
           +" entpuppt sich tatsaechlich als Rest eines Sees, der bis auf einen"
           +" schmalen Wasserstreifen in der Mitte fast voellig ausgetrocknet ist."));
  AddDetail(({"windhauch", "luft"}), BS(
            "Ein schwacher Windhauch weht vom Tuempel zu Dir herueber und laesst"
           +" Dir die Luft in der Senke etwas kuehler erscheinen."));
  AddDetail(({"fleck", "wasser", "wasserstreifen", "mitte", "streifen", "see", "schlammtuempel", "tuempel"}), BS(
            "Der dunkle Fleck ist der schlammige Rest eines Sees, der einst"
           +" wohl fast die ganze Senke ausgefuellt hat. Jetzt ist davon"
           +" nur ein schmaler Wasserstreifen uebriggeblieben, der bald sicher"
           +" auch verdunstet sein wird. Ein idealer Platz fuer die Larven der"
           +" Moskitos, die Dich so begeistert umschwaermen."));
  AddDetail("platz", BS(
            "Du schaust Dich um... kein idealer Platz fuer Abenteurer wie Dich."));
  AddDetail(({"larven", "moskitolarven"}), BS(
            "Auch wenn Du keine Moskitolarven entdecken kannst, irgendwo muessen die"
           +" Quaelgeister, die Dich begeistert umschwaermen und langsam aussaugen ja"
           +" herkommen."));
  AddDetail(({"packungen", "schlammpackungen"}), BS(
            "Schlammpackungen sollen gut fuer den Teint sein, aber willst Du das"
           +" wirklich mit diesem Schlamm versuchen?"));
  AddDetail(({"rest", "aehnlichkeit"}), BS(
            "Irgendwann war das wohl mal ein See aber damit hat dieser"
           +" Schlammpfuhl schon lange keine Aehnlichkeit mehr."));
  AddDetail(({"pfuhl", "schlammpfuhl", "stellen"}), BS(
            "Nun sag mal, in deiner Familie muessen aber wirklich einige"
           +" Ferkel (oder Moskitos?) vertreten sein, dass Dich dieser"
           +" Schlammpfuhl so fasziniert. Als naechstes wirst Du Dich noch"
           +" in diesem Matsch suhlen wollen..."));
  AddDetail("glueck", BS(
            "Welch ein Glueck fuer Dich und alle, dass Du nicht an die wirklich"
           +" schoenen schlammigen Stellen herankommst, Du Ferkel."));
  AddDetail("ferkel", BS(
            "Hier gibt es nur ein Ferkel, ein zweibeiniges, Dich!"));
  AddDetail("familie", BS(
            "Das wuerde jetzt zu weit fuehren."));
  AddDetail("weg", BS(
            "Der Weg, dem Du bis hierher gefolgt bist, steigt nach Sueden"
           +" leicht an und verschwindet in einem goldgelben Meer aus Gras."
           +" Nach Norden fuehrt er am schlammigen Ufer des Tuempels entlang."));
  AddDetail("pfad", BS(
            "Nach Westen zweigt ein schmaler Pfad ab und fuehrt in einen Wald"
           +" aus mannshohem Schilf hinein. Seltsame Spuren begleiten den Pfad"
           +" und vereinzelt liegen stachlige Kletten herum."));
  AddDetail(({"spuren", "abdruecke"}), BS(
            "Die Spuren auf dem schmalen Pfad sehen wirklich seltsam aus. Zackig"
           +" und rundlich und so gar nicht nach Fuessen. Eher wie die"
           +" Abdruecke der Kletten, nur groesser, viel groesser."));
  AddDetail(({"kletten", "kugeln"}), BS(
            "Braune, stachlige Kletten, kleine Kugeln aus wirkungsvollen"
            +" Widerhaken liegen auf dem Pfad und warten nur darauf, sich"
            +" an allem festzuhalten, was ihnen zu nahe kommt."));
  AddDetail(({"haken", "widerhaken"}), BS(
            "Mit ihren unzaehligen elastischen Widerhaken halten sich"
           +" die Kletten an allem fest, was ihnen zu nahe kommt."));
  AddDetail("norden", BS(
            "Nach Norden fuehrt der Weg am schlammigen Ufer des Tuempels"
           +" entlang. Trotz der vereinzelten Spuren, die in diese Richtung"
           +" fuehren, erscheint er Dir nicht gerade vertrauenserweckend."));
  AddDetail("westen", BS(
            "Nach Westen zweigt ein schmaler Pfad ab und fuehrt in einen"
           +" Wald aus mannshohem Schilf hinein."));
  AddDetail("wald", BS(
            "Im Westen fuehrt der schmaler Pfad in einen dichten Wald aus"
           +" mannshohem Schilf hinein. Fingerdicke gruene Halme nehmen Dir"
           +" die Sicht und bald verschwindet der Pfad aus Deinem Blickfeld."));
  AddDetail("schilf", BS(
            "Ein dichter Wald aus hohem Schilf liegt westlich von Dir. Die"
           +" hohen Halme nehmen Dir die Sicht und bald verschwindet der schmale"
           +" Pfad aus Deinem Blickfeld. Hier und da siehst Du auch im"
           +" Schilf einige der seltsamen Kletten haengen."));
  AddDetail(({"schilfhalme", "halme"}), BS(
            "Gruene fingerdicke Schilfhalme."));
  AddDetail(({"sicht", "blickfeld"}), BS(
            "Die hohen Halme nehmen Dir die Sicht und bald verschwindet"
           +" der schmale Pfad aus Deinem Blickfeld."));

  AddSound(DEFAULT_SOUND, BS(
           "Ausser Deinem eigenen Fluchen ueber die ungastliche Umgebung"
          +" unterbricht nur das Summen und Schwirren der Stechmuecken die Ruhe."));
  AddSound("fluchen", BS(
           "So ein gestandenen Abenteurer wie Du kann doch sicher recht gut"
          +" fluchen. Lass mal hoeren..."));
  AddSmell(DEFAULT_SMELL, BS(
           "Die Luft traegt einen fauligen Geruch nach warmen Schlamm zu"
          +" Dir her. Wuargh!"));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  
  AddExit("westen", ROOM("b4_a7"));
  AddExit("norden", ROOM("b5_a6"));
  AddExit("sueden", ROOM("b5_a8"));
  //AddCmd(({"trink", "trinke"}), "wat");
  AddCmd(({"fluch", "fluche"}), "shit");
  AddCmd(({"suhl", "suhle"}), "suhl");
  AddCmd(({"streif", "streife"}), "strip");
}

cloth()
{
  object *w;
  string *tmp;
  string out;

  if (!sizeof(w=TP->QueryProp(P_ARMOURS)))
    return "Hoppla, Du bist ja nackt... tsts. :)\n";
  out="";
  if(sizeof(tmp=map_objects(w, "name", WEN))>1)
    out+=implode(tmp[0..<2], ", ")+(sizeof(tmp)>1?" und "+tmp[<1]:"");
  else out+=tmp[0];
  return BS("Du schaust an Dir herunter und stellst fest, dass Du "+out+" anhast.");
}


strip(str)
{
  object m;

  notify_fail("Was willst Du abstreifen?\n");
  if (!str || str!="schlamm ab")
    return 0;
  if (!TP->_query_free_hands()) {
    write("Du brauchst mindestens eine freie Hand dafuer!\n");
    return 1;
  }
  if (present("\nmatsch", TP)) {
    write("Du hast schon genug Matschklumpen an Dir!\n");
    return 1;
  }
  write(BS(
        "Hm, der Versuch, die Schlammklumpen an Deinen Fuessen mit den Haenden"
       +" abzustreifen war wohl doch nicht so klug. Nun hast Du Matschklumpen"
       +" an Fuessen und Haenden..."));
  say(TPN+" versucht, seine Schlammklumpen abzustreifen.\n");
  m=clone_object(OBJ("matsch"));
  m->move(TP, M_NOCHECK);
  m->start_dry(TP);
  TP->UseHands(m, 1);
  return 1;
}

shit(str)
{
  if (!str) {
    write("Du fluchst kurz und buendig. Etwas wortreicher koennt es schon sein.\n");
    say(TPN+" flucht lautstark.\n");
    return 1;
  }
  write(BS("Du fluchst energisch: "+str));
  say(BS(TPN+" flucht energisch: "+str));
  write_file(LOG("fluch.log"),
      sprintf("%s: (%s)\n%s\n", dtime(time()), CAP(getuid(TP)), str));
  return 1;
}

suhl(str)
{
  write(BS(
        "So ein Ferkel! Wie gerne wuerdest Du Dich jetzt genuesslich im"
       +" Matsch waelzen oder Dir eine Schlammpackung verpassen aber zum"
       +" Glueck sind Stellen mit dem schoensten Schlamm weit genug vom Ufer"
       +" entfernt  - da kommst Du nicht hin."));
  return 1;
}

envv()
{
  return QueryProp(P_INT_LONG);
}

