/*
  Zone 3: Mitte
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Mitte");
  SetProp(P_INT_SHORT, "Am Marktplatz");
  SetProp(P_INT_LONG, BS(
          "Du stehst am nordwestlichen Teil des Marktplatzes im Feldlager."
         +" Ausser einem stattlichen, sehr grossen Zelt siehst Du hier nur"
         +" ueppige Gruenpflanzen am Rand des Platzes. Auch ein kleines"
         +" Beet ist hier nebenan angelegt."));
  AddDetail("boden", BS(
            "Am Boden findest Du vereinzelt ein paar Kletten, weiter noerdlich"
           +" siehst Du ein Beet voller Kraeuter."));
  AddDetail("kletten", BS(
            "Die Kletten, die hier am Boden liegen, scheinen noch frisch, denn"
           +" sie haben noch eine sehr natuerliche Farbe."));
  AddDetail("farbe", BS(
            "Die Kletten sind unnatuerlich braun und klein und spitz."));
  AddDetail("rand", BS(
            "Der Rand des Marktplatzes ist logischerweise noerdlich von Dir."));
  AddDetail("zentrum", BS(
            "Das Zentrum des Marktplatzes liegt suedoestlich von hier."));
  AddDetail(({"pflanzen", "gruenpflanzen"}), BS(
            "Noerdlich von hier befindet sich ein Beet voller Kraeuter."));
  AddDetail("beet", BS(
            "Das Beet, das voller Kraeuter zu sein scheint, befindet sich"
           +" von hier aus gesehen im Norden."));
  AddDetail("kraeuter", BS(
            "Noerdlich von hier befindet sich ein Beet voll davon."));
  AddDetail("norden", BS(
            "Im Norden siehst Du ein Beet voller Kraeuter."));
  AddDetail("zelt", BS(
            "Du siehst vor Dir ein weisses Zelt mit einem Symbol darauf."));
  AddDetail("weisses zelt", BS(
            "Auf dem weissen Zelt kannst Du ein rotes Symbol erkennen."));
  AddDetail("symbol", BS(
            "Das Symbol ist quasi ein rotes Kreuz."));
  AddDetail("kreuz", BS(
            "Rotes Kreuz auf weissem Hintergrund steht nicht zwingend nur"
           +" fuer Kreuzfahrer. Ausserdem sind die Proportionen des Kreuzes"
           +" ganz anders."));
  AddDetail("hintergrund", BS(
            "Der Hintergrund der gemeint ist, ist nur die Zeltplane."));
  AddDetail(({"plane", "zeltplane"}), BS(
            "Die Zeltplane ist voellig weiss und hat ein Symbol daraufgemalt."));
  AddDetail(({"kreuzfahrerorden", "orden", "kreuzfahrer"}), BS(
            "Mist, wenn hier ein Kreuzfahrerorden gewesen waere, koenntest Du"
           +" jetzt begeistert sein. Aber so erinnert Dich das Kreuz nur"
           +" irgendwie an ... Linderung."));
  AddDetail("linderung", BS(
            "Betrete das Zelt, dann wirst Du es schon merken."));
  AddDetail("proportionen", BS(
            "Das Kreuz ist rundum symmetrisch, alle Kanten sind gleich lang."));
  AddDetail("kanten", BS(
            "Alle Kanten des Kreuzes sind gleich lang."));
  AddDetail("teil", BS(
            "Dieser Teil des Marktplatzes befindet sich nordwestlich des"
           +" Zentrums."));
  AddDetail(({"platz", "marktplatz"}), BS(
            "Am Marktplatz finden sich viele Zelte, die alle wichtige Einrichtungen"
           +" beherbergen."));
  AddDetail("zelte", BS(
            "Hier siehst Du leider nur ein Zelt, naemlich ein weisses Zelt.")),
  AddDetail("einrichtungen", BS(
            "Zu den wichtigen Einrichtungen zaehlen unter anderem Post, Laden,"
           +" Kneipe, ..."));
  AddDetail(({"post", "laden", "kneipe"}), BS(
            "Um dorthin zu gelangen musst Du schon weiter im Suedosten suchen."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Da befindest Du Dich ja jetzt."));
  AddDetail("himmel", BS(
            "Der Himmel ist ganz leicht diesig und verschleiert."));
  AddSound(DEFAULT_SOUND, BS(
           "Man kann die Zeltplanen im Wind flattern hoeren."));
  AddSmell(DEFAULT_SMELL, BS(
           "Interessanterweise riecht es hier sehr streng nach Desinfektionsmittel."));
  AddSmell(({"mittel", "desinfektionsmittel"}), BS(
           "Der Geruch dringt vehement aus dem Zelt."));
  
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 26, ENV_TERRAIN:TT_ROAD]));

  AddExit("suedosten", ROOM("a6_b1"));
  AddCmd(({"betrete", "betritt"}), "zelt");
}

zelt(str)
{
  notify_fail("Was genau moechtest Du betreten?\n");
  if (str!="zelt" && str!="weisses zelt")
    return 0;
  write(BS("Du betrittst das weisse Zelt."));
  TP->move(ROOM("zelte/a5_a0"), M_GO, "ins weisse Zelt");
  return 1;
}

