/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Talenge");
  SetProp(P_INT_LONG, BS(
          "Der Weg hier macht einen Knick von Suedwesten nach Osten. Weiters"
         +" engen zwei groebere Huegel den Pfad direkt ein, dass es gar keine"
         +" andere Moeglichkeit fuer den Weg gibt."));
  AddDetail("weg", BS(
            "Der Weg macht hier einen Knick von Suedwesten nach Osten."));
  AddDetail("knick", BS(
            "An dem Knick ist eigentlich nichts Besonderes zu erkennen."));
  AddDetail("pfad", BS(
            "Neben dem Pfad siehst Du einen Busch."));
  AddDetail("busch", BS(
            "Eigentlich ist nichts Besonderes dabei, in der Steppe einen"
           +" vereinsamten Busch zu finden."));
  AddDetail("steppe", BS(
            "Das gesamte Feldlager befindet sich inmitten der Steppe. Also"
           +" warum nicht auch hier."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Vielleicht kommst Du hinter das Geheimnis des Feldlagers."));
  AddDetail("geheimnis", BS(
            "Ich verrate Dir das Geheimnis sicher nicht auf Anhieb."));
  AddDetail("anhieb", BS(
            "Auch jetzt verrate ich Dir noch nichts."));
  AddDetail("huegel", BS(
            "Zwei kleinere Huegel weisen dem Pfad, der sich durch die Landschaft"
           +" schlaengelt, den Weg."));
  AddDetail("landschaft", BS(
            "Die an und fuer sich schoene Landschaft wird im Grunde nur noch"
           +" getruebt durch die sengende Sonne."));
  AddDetail("sonne", BS(
            "Beim Suchen der Sonne schaust Du fast automatisch auf den Himmel,"
           +" und siehe da, dort oben prangt sie, die Sonne."));
  AddDetail("himmel", BS(
            "Der Himmel ist wolkenlos und die Sonne laechelt Dich an."));
  AddDetail("moeglichkeit", BS(
            "Siehst Du eine andere Moeglichkeit?"));
  AddDetail("boden", BS(
            "Leider siehst Du nichts Besonderes am Boden."));   
  AddDetail("insekten", BS(
            "Du kannst sie nur hoeren, diese Insekten."));

  AddSound(DEFAULT_SOUND, BS(
           "Ausser ein paar laestigen Insekten ist nichts zu hoeren."));
  AddSound("insekten", BS(
           "Die Insekten klingen ueberraschenderweise nicht laestig."));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht hier ganz streng nach einem seltsamen Kraut."));
  AddSmell("kraut", BS(
           "Der Geruch kommt aus dem Sueden."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN:TT_PLAIN]));

  AddExit("osten", ROOM("b1_a9"));
  AddExit("suedwesten", ROOM("a9_a0"));

  AddItem("/d/ebene/lostboy/steppe/npc/fuchs", REFRESH_DESTRUCT,
      ([P_MNPC_AREA: ({"/d/ebene/lostboy/steppe/", "/d/ebene/creative/feldlager/"})]) );
}

