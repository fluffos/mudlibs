/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Oestlich des Huegels");

  SetProp(P_INT_LONG, BS(
          "Der schmale Trampelpfad fuehrt scheinbar endlos weiter durch die"
         +" Steppe. Im Suedwesten fuehrt er um einen kleinen grasbewachsenen"
         +" Huegel herum, im Norden faellt er leicht ab und strebt"
         +" schnurgerade durch eine Talsenke dem Horizont entgegen. Noch"
         +" immer umgibt Dich hohes gelbes Gras und nur wenig hier zieht"
         +" Deine Aufmerksamkeit auf sich. Ausser Gras, Gras und nochmal"
         +" Gras siehst Du nur diesen Huegel in Westen und einen seltsamen"
         +" dunklen Fleck noerdlich von Dir."));
  AddDetail(({"pfad", "trampelpfad", "weg"}), BS(
            "Ein schmaler und sehr staubiger Weg fuehrt durch das hohe Gras"
           +" in die Steppe hinein. Frueher wurde er wohl haeufig benutzt,"
           +" sogar Spuren von Wagenraedern meinst Du zu erkennen, aber"
           +" inzwischen waechst das Gras an den Raendern mehr und mehr"
           +" zusammen. Bald wird er wohl voellig zugewuchert sein. Nach"
           +" Suedwesten umrundet er einen kleinen Huegel, nach Norden"
           +" fuehrt er schnurgerade durch die Steppe hindurch."));
  AddDetail(({"spur", "spuren", "furche", "furchen"}), BS(
            "Obwohl das Gras den Weg schon ziemlich ueberwuchert hat, kannst"
           +" Du erkennen, dass er frueher wohl haeufiger benutzt wurde."
           +" Deutliche Furchen haben die Raeder der Wagen hinterlassen, mit"
           +" denen einst Haendler oder Reisende hier entlang kamen und an"
           +" manchen Stellen musst Du ziemlich aufpassen, dass Du nicht"
           +" stolperst. Allerdings sind all diese Spuren schon viel zu alt,"
           +" um weiter interessant zu sein."));
  AddDetail(({"haendler", "reisende"}), BS(
            "Die sind schon lange weg. Du bist hier ganz allein."));
  AddDetail(({"rad", "raeder", "wagen"}), BS(
            "Die sind schon lange weg, nur ihre Spuren im trockenen Boden"
           +" kannst Du noch erkennen."));
  AddDetail("boden", BS(
            "Trocken und staubig ist der Boden unter dem dichten Gras. Und"
           +" nur dort, wo der schmale Weg den Grasteppich unterbricht kannst"
           +" Du ihn ueberhaupt erkennen. Recht interessant schaut er"
           +" allerdings nicht aus."));
  AddDetail(({"rand", "raender"}), BS(
            "An den Raendern des Weges waechst das Gras mehr und mehr"
           +" zusammen und bald schon wird der ganze Pfad ueberwuchert sein."));
  AddDetail(({"steppe", "ebene"}), BS(
            "Scheinbar endlos dehnt sich die weite Graslandschaft um Dich herum"
           +" aus. Sanfte Huegel und Taeler lassen die Ebene wie eine wogende"
           +" Wasserflaeche erscheinen und die Bewegungen des dichten"
           +" Grasteppichs im Wind, verstaerken diesen Eindruck noch. Nur wenig"
           +" sticht aus dieser gleichfoermigen Landschaft heraus - ein kleiner"
           +" Huegel westlich von Dir und ein seltsamer dunkler Fleck weiter"
           +" im Norden."));
  AddDetail(({"tal", "taeler"}), BS(
            "Die Landschaft um Dich herum ist gar nicht so eben, wie es der"
           +" Name Ebene vermuten laesst. Vereinzelt siehst Du kleine Huegel"
           +" und Senken, die die Landschaft wie einen sanft gewellten"
           +" Teppich erscheinen lassen."));
  AddDetail(({"flaeche", "wasserflaeche"}), BS(
            "He, das ist doch nur Gras! Pass auf, dass Du nicht noch mehr"
           +" Sonne abbekommst!"));
  AddDetail(({"bewegungen", "bewegung"}), BS(
            "Sanft aber bestaendig streicht der Wind durch die weiten"
           +" Grasflaechen und laesst sie wie ein Meer auf und ab wogen."));
  AddDetail("wind", BS(
            "Sanft aber bestaendig streicht der Wind durch die weiten"
           +" Grasflaechen. Sein leises Rauschen klingt, als wuerden"
           +" unsichtbare Gestalten hinter Deinem Ruecken fluestern. Ob sich"
           +" im hohem Gras jemand verbirgt? Aber vielleicht hast Du auch nur"
           +" schon zu viel Sonne abbekommen."));

  AddDetail("abenteuer", BS(
            "Dir erzaehlt der Wind nichts weiter."));
  AddDetail("rauschen", BS(
            "Versuchs mal mit was anderem als untersuchen."));
  AddDetail(({"gestalt", "gestalten"}), BS(
            "Keine Gestalten zu sehen! Sind sie nun unsichtbar oder versteckt"
           +" oder vielleicht gar nicht da? Oder doch nur zuviel Sonne?"));
  AddDetail("ruecken", BS(
            "Du schaust Dir Deinen Ruecken an, kannst aber nichts besonderes"
           +" erkennen. Du kannst ja auch schlecht ohne Spiegel nach hinten"
           +" schauen."));
  AddDetail("spiegel", BS(
            "Hast Du denn einen Spiegel bei Dir?"));
  AddDetail("sonne", BS(
            "Die Sonne lacht Dich vom wolkenlosen Himmel an und freut sich,"
           +" dass Du nicht frierst."));
  AddDetail("himmel", BS(
            "Blau, Sonne, keine Wolken, also nichts neues."));
  AddDetail(({"suedwesten", "norden"}), BS(
            "Der schmale Weg fuehrt im Suedwesten an einem kleinen Huegel"
           +" vorbei und nach Norden duch eine Talsenke dem Horizont"
           +" entgegen."));
  AddDetail("huegel", BS(
            "Mehrere sanfte Huegel und Senken lassen die Ebene um Dich herum"
           +" wie einen gewellten Teppich erscheinen. Direkt westlich von"
           +" Dir erhebt sich ein recht kleiner Huegel, wie ein"
           +" grasbewachsener Buckel. Er ist nicht so langgestreckt, wie die"
           +" anderen Erhebungen in der Ebene und wirkt dadurch viel hoeher"
           +" als er eigentlich ist. Wenn Du dem Weg weiter nach Suedwesten"
           +" folgst, kannst Du ihn Dir sicher besser ansehen."));

  AddDetail(({"senke", "talsenke"}), BS(
            "Nach Norden fuehrt der Weg leicht abwaerts in eine Senke hinein."
           +" Ein dunkler Fleck in der sonst eintoenig gelben Landschaft faellt"
           +" Dir auf und macht Dich neugierig."));
  AddDetail(({"erhebung", "buckel"}), BS(
            "Der kleine Huegel westlich von Dir sieht aus wie ein"
           +" grasbewachsener Buckel."));
  AddDetail(({"teppich", "grasteppich"}), BS(
            "Das dichte Gras, erscheint Dir wie ein verstaubter graugelber"
           +" Teppich. Ziemlich abgelaufen, zerzaust und verfilzt. Nichts,"
           +" was Du Dir ins Wohnzimmer legen wuerdest."));
  AddDetail("wohnzimmer", BS(
            "Hast Du dort so einen seltsamen Teppich liegen, oder was erinnert"
           +" Dich jetzt daran?"));
  AddDetail("horizont", BS(
            "Unten befindet sich graugelbes Gras, oben strahlend blauer"
           +" Himmel. Recht huebsch, aber nicht weiter interessant."));
  AddDetail(({"graslandschaft", "landschaft", "gras", "flaeche", "grasflaeche"}), BS(
            "In alle Richtungen umgibt Dich die weite Graslandschaft."
           +" Gelbes trockenes Gras, wohin Du auch schaust. Nein halt, da im"
           +" Norden ist ein dunkler Fleck. Entweder ist das ziemlich"
           +" schlammbraunes Gras oder etwas ganz anderes."));
  AddDetail("aufmerksamkeit", BS(
            "Aufmerksam merkst Du auf, bemerkst aber nichts Interessantes."));
  AddDetail("westen", BS(
            "Im Westen erhebt sich ein kleiner grasbewachsener Huegel. Um ihn"
           +" Dir genauer anzusehen gehst Du besser etwas naeher heran."));
  AddDetail(({"fleck", "flaeche"}), BS(
            "Etwas weiter im Norden, am Fusse der kleinen Talsenke, erstreckt"
           +" sich eine auffaellige dunkelbraune Flaeche. Ein schmaler"
           +" Streifen in ihrer Mitte schimmert silbern im Sonnenlicht und"
           +" ein Luftzug traegt einen Hauch von Feuchtigkeit heran. Ob das"
           +" tatsaechlich Wasser ist? Ein See? Wohl kaum, eher ein Tuempel,"
           +" ein fast ausgetrocknetes Wasserloch. Vielleicht solltest Du"
           +" etwas naeher herangehen."));
  AddDetail(({"streifen", "mitte"}), BS(
            "Mitten in der dunkelbraunen Flaeche schimmert ein schmaler"
           +" Streifen und reflektiert das Sonnenlicht. Wohl der letzte Rest"
           +" Wasser in diesem austrocknenden Tuempel."));
  AddDetail("rest", BS(
            "Es handelt sich um den letzten Rest Wasser."));
  AddDetail(({"licht", "sonnenlicht"}), BS(
            "Ein schmaler Streifen in der seltsamen dunkelbraunen Flaeche"
           +" reflektiert das Sonnenlicht und blendet Dich fast, als Du"
           +" genauer hinschaust."));
  AddDetail(({"luftzug", "zug"}), BS(
            "Ein schwacher Luftzug weht aus der Talsenke herauf und traegt"
           +" einen Hauch von Feuchtigkeit heran. Vielleicht bildest Du Dir"
           +" das aber auch nur ein. Du waerst nicht der erste Abenteurer,"
           +" der verrueckt geworden ist."));
  AddDetail("abenteurer", BS(
            "Das sind so Leute wie Du."));
  AddDetail(({"hauch", "feuchtigkeit"}), BS(
            "Ein Luftzug traegt einen Hauch von Feuchtigkeit aus der Talsenke"
           +" zu Dir heran. Du kannst es kaum glauben, aber das da unten"
           +" scheint wirklich ein See zu sein. Naja, es war mal einer. Nun"
           +" wuerde man es eher Tuempel oder Wasserloch nennen."));
  AddDetail(({"wasser", "see", "tuempel", "wasserloch", "loch"}), BS(
            "Du bist noch zu weit weg, um Genaueres zu erkennen."));

  AddSound(DEFAULT_SOUND, BS(
           "Leises Fluestern erfuellt die Luft. Du schaust Dich um, kannst"
          +" aber niemanden entdecken. Es war doch nur der Wind, der dem"
          +" Gras von seinen Abenteuern erzaehlt."));
  AddSmell(DEFAULT_SMELL, BS(
           "Von Norden her riecht es etwas vermodert."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  
  AddExit("suedwesten", ROOM("b4_a9"));
  AddExit("norden", ROOM("b5_a7"));

}

