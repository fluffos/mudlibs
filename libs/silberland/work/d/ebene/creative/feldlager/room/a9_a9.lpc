/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Oestlicher Weg");
  SetProp(P_INT_LONG, BS(
          "Hier befindest Du Dich auf dem oestlichen Weg im grossen Gebiet"
         +" des Feldlagers. Das oestliche Gebiet umfasst noch viele unerforschte"
         +" Teile und einige Neuheiten."));
  AddDetail("weg", BS(
            "Der Weg hier fuehrt von der Kreuzung im Nordwesten ein bisschen"
           +" weiter ins Innere des Feldlagers nach Westen."));
  AddDetail(({"nordwesten", "westen"}), BS(
            "Nun, wenn es schon solche Ausgaenge gibt, benutz sie doch!")); 
  AddDetail("kreuzung", BS(
            "Die Kreuzung befindet sich im Nordwesten."));
  AddDetail(({"ausgang", "ausgaenge"}), BS(
            "Es gibt einen Ausgang nach Nordwesten und einen nach Westen."));
  AddDetail("gebiet", BS(
            "Im oestlichen Teil des Feldlagers gibt es noch einige unerforschte"
           +" Teile, die es noch zu entdecken gibt. Beeil' Dich, und Du koenntest"
           +" einer der ersten sein."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Das Feldlager erstreckt sich von hier aus in Richtung Sueden und"
           +" wird in dieser Dimension immer groesser."));
  AddDetail("dimension", BS(
            "Derzeit hat die Forschung gerade von der dritten Dimension gesprochen."
           +" Du fragst Dich, was das sein koennte."));
  AddDetail(({"teil", "teile"}), BS(
            "Die Teile, die noch nicht erforscht sind, sollten so bald als moeglich"
           +" entdeckt werden, um der Nachwelt eine gut dokumentierte Karte"
           +" zu hinterlassen."));
  AddDetail("karte", BS(
            "Nein, die Karte musst Du Dir schon selber malen."));
  AddDetail("nachwelt", BS(
            "Die Nachwelt ist eigentlich nichts Anderes, als diejenigen Spieler,"
           +" die nach Dir das Feldlager betreten werden."));
  AddDetail("spieler", BS(
            "Erst mal bist Du im Grunde Deines Herzens selber einer."));
  AddDetail("herz", BS(
            "Dein Herz klopft. Gott sei Dank."));
  AddDetail("grund", BS(
            "Deinem Herz auf den Grund zu gehen haette wenig Sinn."));
  AddDetail("sinn", BS(
            "Du solltest nicht jetzt ueber den Sinn des Lebens nachgruebeln."));
  AddDetail("leben", BS(
            "Du bist am Leben."));
  AddDetail("forschung", BS(
            "Immer wieder gibt es neue Sachen, die erforscht wurden."));
  AddDetail("sachen", BS(
            "Du selber koenntest auch einmal etwas Neues entdecken."));
  AddDetail("neues", BS(
            "Auf auf, mach Dich auf die Suche nach etwas Neuem!"));
  AddCmd(({"such", "suche"}), "search");
  AddDetail(({"neuheit", "neuheiten"}), BS(
            "Du selbst koenntest auf die Suche nach Neuheiten gehen."));
  AddDetail("suche", BS(
            "Eine Suche muss nicht immer eine Quest sein."));
  AddDetail(({"schwammerlsucherquest", "quest"}), BS(
            "Die Schwammerlsucherquest ist eine davon."));
  AddDetail("aufmerksamkeit", BS(
            "Pass auf, dass Dir nichts entgeht."));
  AddDetail("halluzination", BS(
            "Davon kann man direkt verrueckt werden. Also pass auf."));
  AddDetail("himmel", BS(
            "Was anderes als die hell herunterbrennenden Sonne haettest"
           +" Du sowieso nicht erwartet."));
  AddDetail("boden", BS(
            "Auf dem Boden gibts aber auch gar nichts zu sehen."));
  AddDetail("sonne", BS(
            "Direkt schon unheimlich, wie Dich die Sonne durch all die Raeume"
           +" verfolgt."));

  AddSound(DEFAULT_SOUND, BS(
           "Ein leichtes Plaetschern erregt Deine Aufmerksamkeit."));
  AddSound("plaetschern", BS(
           "War es eine Halluzination oder mehr?"));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht nach Schwammerln. Aber nur, weil hier von der"
          +" Schwammerlsucherquest die Rede ist."));
  AddSmell("schwammerl", BS(
           "Scheinbar taeuscht Dich Deine Nase. Es riecht doch nach weniger."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_PLAIN]));

  AddExit("nordwesten", ROOM("a8_a8"));
  AddExit("westen", ROOM("a8_a9"));
}

search(str)
{
  notify_fail("Wonach moechtest Du suchen?\n");
  if (!(str=="neues" || str=="nach neuem"))
    return 0;
  write(BS("Schade. Das Neue zu finden ist doch nicht so einfach."));
  return 1;
}

