/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Lagerbeginn");
  SetProp(P_INT_LONG, BS(
          "Nordwestlich von Dir kannst Du noch die Kreuzung sehen, die den"
         +" westlichen und den oestlichen Teil des Feldlagers miteinander"
         +" verbindet. Weiter im Suedosten kannst Du schon die Umrisse eines"
         +" Zeltes erkennen."));
  AddDetail("kreuzung", BS(
            "Sie befindet sich nordwestlich von Dir."));
  AddDetail(({"weg", "boden"}), BS(
            "Recht viel besonderes ist hier nicht zu finden. Schau Dich doch"
           +" einmal wo anders um.")); 
  AddDetail("himmel", BS(
            "Vom Himmel brennt nach wie vor die Sonne herunter. Keine Wolke ist"
           +" am tiefblauen Himmel zu erkennen.")); 
  AddDetail("sonne", BS(
            "Die Sonne ist unerbittlich heiss und langsam fuehlst Du, wie Dir"
           +" der Schweiss herunterrinnt."));
  AddDetail("schweiss", BS(
            "Langsam aber sicher verdoerrst Du hier. Du solltest Dir vielleicht"
           +" etwas zu trinken besorgen, ehe Du hier weitergehst."));
  AddDetail("zelt", BS(
            "Im Suedosten duerfte sich ein Zelt befinden. Aber es sieht relativ"
           +" sehr heruntergekommen aus."));
  AddDetail(({"wolke", "wolken"}), BS(
            "Hier am Himmel befinden sich keinerlei Wolken."));
  AddDetail("steppe", BS(
            "Die Steppe veraendert sich hier schon zusehends. An und fuer sich"
           +" bleibt die Landschaft gleich wie noerdlich von hier. Aber"
           +" irgendwie bemerkst Du, dass die Ebene hier weiter wirkt, und Du"
           +" kannst mehr Details vom Sueden erkennen."));
  AddDetail("landschaft", BS(
            "Im Norden siehst Du noch hohes Gras, das das Weiterblicken unmoeglich"
           +" macht. Aber wenn Du weiter nach Sueden blickst, kannst Du schon"
           +" mehrere Zelte erkennen, die auf viele Lebewesen hindeuten. Auch"
           +" Rauchschwaden kannst Du sehen."));
  AddDetail("zelte", BS(
            "Ja, im Sueden bzw. im Suedwesten befinden sich viele Zelte."));
  AddDetail("ebene", BS(
            "Die Ebene beginnt sich hier richtiggehend auszubreiten und nach"
           +" Sueden hin immer weiter zu werden."));
  AddDetail(({"detail", "details"}), BS(
            "Langsam aber sicher gelangst Du dem Feldlager naeher."));
  AddDetail(({"lager", "feldlager"}), BS(
            "In Richtung Suedosten liegt das Feldlager."));
  AddDetail("sueden", BS(
            "Im Sueden beginnt das Feldlager."));
  AddDetail("norden", BS(
            "Noerdlich von Dir befindet sich eine Kreuzung."));
  AddDetail(({"wesen", "lebewesen"}), BS(
            "Die Zelte suedoestlich von Dir weisen auf reges Treiben hin."));
  AddDetail("treiben", BS(
            "Gingst Du weiter, koenntest Du es Dir betrachten."));
  AddDetail(({"schwaden", "rauchschwaden"}), BS(
            "Irgendwer hat scheinbar suedlich von Dir ein Feuer angezuendet,"
           +" und drum kannst Du die Rauchschwaden sehen."));
  AddDetail("wasser", BS(
            "Es ist Dein eigenes Wasser, das Dir im Munde zusammenlaeuft."));
  AddDetail("mund", BS(
            "Haettest Du was zu essen, wuerdest Du es in Deinen Mund stopfen."));
  AddDetail("hunger", BS(
            "Dein Magen knurrt."));
  AddDetail("magen", BS(
            "Er knurrt laut, der Magen."));
  AddSound(DEFAULT_SOUND, BS(
           "Nichts, absolut nichts zu hoeren."));
  AddSound("nichts", BS(
           "Nichts ist halt einfach nichts."));
  AddSound(({"magen", "knurren"}), BS(
           "Dein Magen knurrt ziemlich laut."));
  AddSmell(DEFAULT_SMELL, BS(
           "Die Rindsuppe riecht etwas staerker. Dir laeuft das Wasser im"
          +" Mund zusammen."));
  AddSmell(({"suppe", "rindsuppe"}), BS(
           "Du bekommst Hunger."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_PLAIN]));

  AddRoomMessage( ({ "Dir laeuft das Wasser im Mund zusammen.\n",
                     "Dein Magen knurrt.\n"}), 25);

  AddExit("nordwesten", ROOM("a5_a5"));
  AddExit("suedosten", ROOM("a7_a7"));
}

