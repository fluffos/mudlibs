/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Talsenke Nord");
  SetProp(P_INT_LONG, BS(
            "Du sitzt auf einem dicken Ast auf dem Baum. Wenn du runter schaust"
           +" kannst du das ausgedoerrte Steppengras und ein paar Buesche und"
           +" Straeucher sehen. Wenn du nach oben schaust siehst du einen Bretterboden."
           +" Im Osten siehst du einen Turm und wenn du deinen Blick nach Sueden"
           +" wendest, kannst du ein paar bunte Flecken ausmachen. Was das wohl ist? Ausserdem hat der Stamm auch eine Oeffnung, und hinter dem Stamm scheint eine weitere Plattform zu sein."));
  AddDetail("ast", BS(
            "Ein breiter Ast auf dem Du bequem sitzen kannst."));
  AddDetail("aeste", BS(
            "Ein Baum hat ueblicherweise mehrere Aeste."));
  AddDetail(({"eiche", "baum"}), BS(
            "Eine alte Eiche mit knorrigen Aesten und dunkelgruenen Blaettern."));
  AddDetail(({"boden", "bretterboden"}), BS(
            "Der Bretterboden besteht aus hellen Brettern."));
  AddDetail("bretter", BS(
            "Die Bretter sind so geschickt zusammengenagelt, dass sie insgesamt einen"
           +" Bretterboden ergeben."));
  AddDetail("blaetter", BS(
            "Die Blaetter sind gruen und rauschen im Wind."));
  AddDetail("wind", BS(
            "Ein leichter Wind zerzaust Dein Haar."));
  AddDetail(({"haar", "haare"}), BS(
            "Deine Haare wehen im Wind."));
  AddDetail("voegel", BS(
            "Wenn Du genauer schaust, kannst Du vielleicht einen sehen."));
  AddDetail("genauer", BS(
            "Du schaust genauer und kannst einen roten und einen gelben Vogel ausmachen,"
           +" die gemeinsam um die Wetter traellern."));
  AddDetail(({"gras", "steppengras"}), BS(
            "Um das Gras genauer zu untersuchen musst Du wohl etwas naeher ran."));
  AddDetail(({"straeucher", "buesche"}), BS(
            "Um diese genauer untersuchen zu koennen musst Du wohl etwas naeher rangehen."));
  AddDetail(({"flecke", "flecken"}), BS(
            "Um die Flecke naeher zu untersuchen musst Du wohl weiter in die Richtung gehen."));
  AddDetail("richtung", BS(
            "Nunja, Du musst Dich suedlich halten."));
  AddDetail("blick", BS(
            "Du beginnst zu schielen und bekommst den irren Blick. Ieh!"));
  AddDetail("stamm", BS(
            "Der Baum hat einen ziemlich dicken Stamm mit tiefer spaltiger Rinde. An ihm bist"
           +" wohl heraufgeklettert."));
  AddDetail("rinde", BS(
            "Die Rinde ist mit tiefen Spalten durchzogen."));
  AddDetail("spalten", BS(
            "Die Spalten befinden sich an der Rinde."));
  AddDetail("wette", BS(
            "Wetten, dass Du runterfaellst, wenn Du nicht aufpasst?"));
  AddDetail("vogel", BS(
            "Ein gelber und ein roter Vogel. Sehen huebsch aus die zwei, wie sie tirilieren."));
  AddDetail("haar", BS(
            "Nun, wo hast Du denn Haare?"));
  AddDetail(({"glatze", "kopf"}), BS(
            "Wenn Du keine Glatze hast, so sollten sich Haare auf Deinem Kopf befinden."));
  AddDetail("himmel", BS(
            "Unglaublich! Du siehst einen Himmel ueber Dir! Aber nicht alles, schliesslich wird"
           +" Dein Blickfeld durch den Bretterboden und den Stamm etwas eingeschraenkt."));
  AddDetail(({"feld", "blickfeld"}), BS(
            "Dein Blickfeld ist etwas eingeschraenkt."));
  AddDetail("turm", BS(
            "Der Turm sieht alt und verwittert aus, aber naeheres kannst Du auch nicht erkennen."));

  AddSound(DEFAULT_SOUND, BS(
           "Nichts als Stille, nur die Blaetter des Baumes rauschen im Wind. Achja, "
          +" und ein paar Voegel zwitschern auch noch."));
  AddSound("stille", BS(
           "Still ist es eben, Du hoerst gar nichts ausser dem Rauschen der Blaetter."));
  AddSound(({"rauschen", "blaetter", "wind"}), BS(
           "Die Blaetter rauschen im Wind."));
  AddSound("voegel", BS(
           "Du kannst ein paar Voegel zwitschern hoeren. Du denkst Dir nichts dabei."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du kannst den morschen Bretterboden ueber Dir riechen."));
  AddSmell(({"boden", "bretterboden"}), BS(
           "Der Bretterboden riecht zwar morsch, er sieht aber stabil genug aus, um ihn"
          +" auch wirklich betreten zu koennen."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_PLAIN]));
  
  AddExit("unten", ROOM("a3_a6"));
}

