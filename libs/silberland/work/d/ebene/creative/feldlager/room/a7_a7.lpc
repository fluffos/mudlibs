/*
  Zone 1: Nordweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordweg");
  SetProp(P_INT_SHORT, "Verlassenes Zelt");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich hier vor dem verlassenen Zelt. Ausser dem Zelt"
         +" gibt es kaum Wesentliches zu erkennen."));
  AddDetail("zelt", BS(
            "Von aussen sieht es herrlich zerfleddert aus. Es duerfte sich"
           +" hierbei um einen alten Wachtposten handeln, der sich allerdings"
           +" durch nicht erklaerbare Gruende zurueckgezogen hat, naemlich in"
           +" Richtung Suedosten oder so. Aber betreten kannst Du es allemal."));
  AddDetail(({"posten", "wachtposten", "wachposten"}), BS(
            "Hier ist er nicht mehr, der Wachtposten. Vielleicht findest Du"
           +" ihn im Suedosten."));
  AddDetail(({"boden", "weg"}), BS(
            "Man kann hier noch deutliche Spuren erkennen."));
  AddDetail(({"spur", "spuren"}), BS(
            "Hier duerfte einmal ein Wachtposten gestanden haben. Der Boden ist"
           +" ganz ausgetreten vom langen Stehen des armen Waechters."));
  AddDetail("waechter", BS(
            "Hier gibt es keinen Waechter mehr."));
  AddDetail("himmel", BS(
            "Am Himmel siehst Du ueberhaupt keine Wolke mehr. Du wuenscht Dir"
           +" sehnsuechtig den naechsten Regen herbei."));
  AddDetail("regen", BS(
            "Nunja, wenn Du vielleicht zum Regengott Regen betest, vielleicht"
           +" schickt er Dir eine Wolke."));
  AddDetail("gott", BS(
            "Unsere Goetter heissen Woody und Dusty. Aber keiner von beiden ist"
           +" der Regengott."));
  AddDetail("regengott", BS(
            "Bete einmal zu ihm, hoffentlich bringt es was.")); 
  AddDetail("wolke", BS(
            "Eine einzige Regenwolke nur wuerde Deiner seelischen Verfassung"
           +" schon gut tun."));
  AddDetail("verfassung", BS(
            "Ich wuerde mal so vermuten: Du befindest Dich seelisch nicht"
           +" unbedingt in einem Hoch. Das mag an der heissen Sonne, an dem"
           +" mangelnden Wasser, oder an was sonst auch immer liegen."));
  AddDetail("hoch", BS(
            "Ein Hoch fuehlt sich anders an, oder? Beziehungsweise wettermaessig"
           +" kann man zumindest von einem Hoch sprechen."));
  AddDetail(({"bericht", "wetterbericht", "wetter"}), BS(
            "Lausche mal dem Wetterbericht."));
  AddSound(({"bericht", "wetterbericht", "wetter"}), BS(
            "Der Wetterbericht meldet: Auf ewig schoen. Uargh.")); 
  AddDetail("wasser", BS(
            "Schoen waers, wenn Du Wasser haettest."));
  AddDetail("regenmacher", BS(
            "Vom beruehmten Regenmacher aus dem Feldlager hast Du schon mal gehoert."));
  AddDetail("sonne", BS(
            "Schrecklich heiss, wie die Sonne vom Himmel herunterbrennt."));

  AddCmd("bete", "call");

  AddSound(DEFAULT_SOUND, BS(
           "Du glaubst schon den Regen zu hoeren."));
  AddSound("regen", BS(
           "Schade. Du musst Dich verhoert haben. Wo kein Regen ist, da kann"
          +" man ihn auch nicht hoeren.")); 
  AddSmell(DEFAULT_SMELL, BS(
           "Der Geruch nach Rindsuppe ist hier nicht mehr so stark."));
  AddSmell(({"suppe", "rindsuppe"}), BS(
           "Im Nordwesten roch die Suppe staerker."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_PLAIN]));

  AddItem(NPC("jongleur"), REFRESH_DESTRUCT);

  AddExit("nordwesten", ROOM("a6_a6"));
  AddExit("suedosten", ROOM("a8_a8"));

  AddExit("osten", ROOM("a8_a7")); //13.10.2019 freigegeben - Eros
  AddCmd(({"betrete", "betritt"}), "zelt");
}


call()
{
  write(BS(
        "Du kniest Dich nieder und betest und betest, es passiert jedoch nichts."
       +" Du bist wohl doch kein Regenmacher."));
  return 1;
}

zelt(str)
{
  notify_fail("Was moechtest Du betreten?\n");
  if (str!="zelt")
    return 0;
  write(BS(
        "Du schlaegst die zerfledderten Zeltplanen auseinander und betrittst"
       +" das Zelt."));
  TP->move(ROOM("zelte/a7_a7"), M_GO, "ins Zelt");
  return 1;
}

