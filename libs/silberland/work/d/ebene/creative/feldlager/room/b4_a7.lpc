/*
  Zone 2: Ostweg
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int gou;

create()
{
  ::create();

  SetProp(P_ZONE, "Ostweg");
  SetProp(P_INT_SHORT, "Auf der kleinen Lichtung");

  SetProp(P_INT_LONG, BS(
          "Der dichte Wald aus Schilf oeffnet sich zu einer kleinen Lichtung"
         +" in deren Zentrum Schilfhalme zu einem Huegel aufgehaeuft sind."
         +" Ganz eindeutig hat hier irgendwer oder besser irgendwas sein Lager."
         +" Ueberall liegen Kletten verstreut und gelegentlich fliegen weitere"
         +" aus der Mitte des Huegels auf. Ein schmaler Pfad fuehrt nach Osten"
         +" zurueck zum Ufer des Tuempels. Im Nordosten erscheint Dir das Schilf"
         +" etwas weniger dicht - vielleicht kannst Du Dir auch dort einen Weg bahnen.")); 
  AddDetail("boden", BS(
            "Du siehst den Boden einer mit ein paar Schilfhalmen bewachsenen Lichtung."));
  AddDetail("himmel", BS(
            "Da! Da war es wieder! Eine Klette fliegt aus der Mitte des Huegels auf."
           +" Du kannst Dich einfach nicht auf den Himmel konzentrieren, alles andere"
           +" fasziniert Dich zu sehr."));
  AddDetail(({"wald", "schilf"}), BS(
            "Ein dichter Wald aus hohem Schilf umgibt Dich und nur nach Osten"
           +" fuehrt ein schmaler Pfad heraus. Im Nordosten erscheint Dir das"
           +" Schilf etwas weniger dicht."));
  AddDetail("lichtung", BS(
            "Mitten im dichten Wald aus Schilf oeffnet sich eine kleine Lichtung."
           +" Umgeknickte Schilfhalme bedecken den Boden und im Zentrum der Lichtung"
           +" ist ein Haufen aus ausgerissenen Halmen aufgeschichtet. Ueberall"
           +" liegen Kletten verstreut und gelegentlich fliegen weitere aus der"
           +" Mitte des Haufens auf. Ganz offensichtlich hat hier irgendwer oder"
           +" besser irgendetwas sein Lager. Ganz wohl ist Dir nicht dabei, aber"
           +" Deine Neugier siegt und Du siehst Dich weiter um.")); 
  AddDetail("neugier", BS(
            "Das geht dann wohl doch zu weit! Du bist aber neugierig!"));
  AddDetail("zentrum", BS(
            "Im Zentrum der Lichtung sind abgerissene Schilfhalme zu einem Haufen"
           +" aufgeschichtet."));
  AddDetail(({"schilfhalme", "halme"}), BS(
            "Hohe, gruene Schilfhalme bilden einen dichten Ring um die Lichtung herum,"
           +" waehrend die abgeknickten und ausgerissenen Halme auf der Lichtung"
           +" bereits vertrocknet sind und unter Deinen Fuessen knirschen. Ein"
           +" Haufen aus graubraunen trockenen Halmen erhebt sich im Zentrum der"
           +" Lichtung und Du fragst Dich, wer wohl darin wohnen mag. Auch im"
           +" Schilf haengen ueberall diese seltsamen Kletten."));
  AddDetail("ring", BS(
            "Ein dichter Ring aus hohen gruenen Schilfhalmen umschliesst die"
           +" Lichtung."));
  AddDetail("fuesse", BS(
            "Interessiert betrachtest Du Deine Fuesse, kannst aber nichts Besonderes"
           +" an ihnen entdecken."));
  AddDetail("besonderes", BS(
            "NICHTS Besonderes - Du liest heute aber wirklich _sehr_ unaufmerksam."));
  AddDetail(({"huegel", "schilfhaufen", "haufen"}), BS(
            "Ein Haufen aus graubraunen trockenen Schilfhalmen erhebt sich"
           +" im Zentrum der Lichtung. Gelegentlich fliegt ein Schauer weiterer"
           +" Kletten aus der Mitte dieses Haufens auf und ausserdem meinst Du"
           +" ein Schnurren oder Schnarchen zu hoeren. Ob Dein Mut ausreicht,"
           +" diesen Haufen zu durchsuchen?"));
  AddDetail("mut", BS(
            "Hoffentlich bist Du mutig genug, den Haufen zu durchsuchen."));
  AddDetail(({"schnurren", "schnarchen", "knirschen"}), BS(
            "Das kann man doch nicht sehen!"));
  AddDetail("lager", BS(
            "Ganz offensichtlich ist dieser Haufen Schilf das Lager eines"
           +" Lebewesens. Wahrscheinlich schlaeft es gerade tief und fest"
           +" und Du musst das Schilf schon durchsuchen, um es zu finden."));
  AddSpecialDetail("lebewesen", "gg");
  AddDetail("muecken", BS(
            "Muecken, einfach nur Muecken."));
  AddSpecialDetail(({"kletten", "kugeln"}), "klet");
  AddDetail("widerhaken", BS(
            "Mit ihren unzaehligen elastischen Widerhaken halten sich die"
           +" Kletten an allem fest, was ihnen zu nahe kommt und so leicht"
           +" lassen sie nicht mehr los."));
  AddDetail("mitte", BS(
            "Aus der Mitte des Huegels fliegt hin und wieder ein Schauer"
           +" weiterer Kletten empor und regnet auf die Lichtung nieder."
           +" Kaum moeglich, keine Kletten abzubekommen."));
  AddDetail(({"schauer", "klettenschauer"}), BS(
            "Hin und wieder fliegt ein Schauer von Kletten aus der Mitte"
           +" des Haufens empor und regnet auf die Lichtung nieder."));
  AddDetail("pfad", BS(
            "Ein schmaler Pfad fuehrt nach Osten zurueck zum Ufer des Tuempels."
           +" Im Nordosten erscheint Dir das Schilf etwas weniger dicht"
           +" - vielleicht kannst Du Dir auch dort einen Weg bahnen."));
  AddDetail(({"tuempel", "ufer"}), BS(
            "Das liegt weiter im Osten."));
  AddDetail("osten", BS(
            "Ein schmaler Pfad fuehrt nach Osten zurueck zum Ufer des Tuempels."));
  AddDetail("nordosten", BS(
            "Im Nordosten erscheint Dir das Schilf etwas weniger dicht"
           +" - vielleicht kannst Du Dir auch dort einen Weg bahnen."));
  AddDetail("weg", BS(
            "Meinst Du den kleinen Pfad der nach Osten zurueck zum Tuempel"
           +" fuehrt oder willst Du versuchen, Dir einen Weg nach Nordosten"
           +" zu bahnen?"));
  AddDetail("glueck", BS(
            "Du kannst von Glueck reden, wenn Du Dir nicht zu viele Kletten"
           +" einfaengst."));
  AddDetail("schlaf", BS(
            "Nun uebertreibst Du aber wirklich. Es gibt auch ein paar"
           +" unbeschriebene Details."));
  AddDetail(({"detail", "details"}), BS(
            "Na los! Nur zu! Weiteruntersuchen!"));
  AddDetail("geschichten", BS(
            "Haettest Du bloss mal besser zugehoert, dann wuesstest Du jetzt"
           +" sicher mehr ueber Gouffres und Kletten. Nun ist's leider zu spaet."));
  AddDetail("nest", BS(
            "Der Haufen ausgerissener Schilfhalme ist ein gemuetliches Nest,"
           +" in dem das Gouffre prima schlafen koennte, wenn nicht staendig"
           +" stoerende Abenteurer vobei kaemen."));
  AddSpecialDetail("abenteurer", "guild");
  AddDetail("grund", BS(
            "Das Gouffre ist auch der Grund fuer die Klettenschauer, die hin"
           +" und wieder auf der Lichtung niedergehen. Immer wenn es sich im"
           +" Schlaf umdreht oder sich schuettelt, loesen sich einige der"
           +" Kletten aus seinem Pelz und fliegen davon."));

  AddSound(DEFAULT_SOUND, BS(
           "Ausser dem Knirschen des trockenen Schilfs unter Deinen Fuessen"
          +" meinst Du ein leises Schnurren oder Schnarchen zu hoeren, das"
          +" direkt aus dem Schilfhaufen zu kommen scheint."));
  AddSound("knirschen", BS(
           "Das trockene Schilf knirscht bei jedem Schritt unter Deinen Fuessen."));
  AddSound("schnurren", BS(
           "Ein tiefes gemuetliches Schnurren (oder ist es doch ein Schnarchen?)"
          +" ist aus dem Schilfhaufen zu hoeren."));
  AddSound("schnarchen", BS(
           "Ein zufriedenes Schnarchen (oder doch ein Schnurren?) ist aus dem"
          +" Schilfhaufen zu hoeren."));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht nach nassem und trockenem Schilf."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_PLAIN]));
  
  AddExit("osten", ROOM("b5_a7"));
  AddCmd(({"bahn", "bahne"}), "way");
  AddCmd(({"durchsuch", "durchsuche"}), "hauf");
  gou=1;
}

reset()
{
  ::reset();
  gou=1;
}

gg()
{
  if (present("gouffre"))
    return "Du erschreckst. Es handelt sich um das Gouffre.\n";
  else
    return BS(
        "Du schaust Dich um, kannst aber ausser Dir kein Lebewesen"
       +" entdecken. Naja, ausser den laestigen Muecken, die Dir bis"
       +" hierher gefolgt sind, aber die ignorierst Du eh schon laengst."
       +" Vielleicht verbirgt sich aber in dem Schilfhaufen noch"
       +" irgendwer oder irgendwas.");
}

guild()
{
  string gu;

  if ((gu=TP->QueryProp(P_GUILD))=="abenteurer")
    return "So Typen wie Du!\n";
  else
    return "Ok ok ok... Du gehoerst zur Gilde "+CAP(gu)+".\n";
}

way(str)
{
  notify_fail("Was willst Du Dir bahnen?\n");
  if (!str || str!="weg")
    return 0;
  write(BS(
        "Du stuerzt Dich auf das Schilf im Nordosten und bahnst Dir,"
       +" die Halme niedertrampelnd, einen Weg. Geschafft! Erschoepft"
       +" musst Du Dich ein wenig ausruhen."));
  TP->move(ROOM("b5_a6"), M_GO|M_SILENT);
  return 1;
}

hauf(str)
{
  notify_fail("Was willst Du durchsuchen?\n");
  if (!str)
    return 0;
  if (str!="haufen" && str!="schilfhaufen" && str!="schilf")
    return 0;
  if (present("gouffre")) {
    write("Der Gouffre hindert Dich daran, sein Lager zu untersuchen.\n");
    return 1;
  }
  if (!gou) {
    write(BS(
          "Du durchsuchst den Haufen eingehend und stellst fest, dass es sich"
         +" dabei um das Lager des Gouffre handelt."));
    return 1;
  }
  write(BS(
        "Vorsichtig naehrst Du Dich dem Schilfhaufen und machst Dich daran,"
       +" ihn zu durchsuchen. Schon bald findest Du den Bewohner der Lichtung"
       +" und den Grund fuer die Kletten ueberall. Eingekuschelt in ein Nest"
       +" aus Schilf schlaeft ein Gouffre, ein Klettenviech. Eins dieser"
       +" seltsamen Wesen von denen Du in irgendwelchen alten Geschichten"
       +" mal gehoert hast. Haettest Du bloss besser zugehoert. Das Gouffre"
       +" raekelt sich im Schlaf und wieder fliegt ein Schauer von Kletten"
       +" auf die Lichtung. Aber Du hast Glueck, diesmal trifft Dich keine."
       +" Das Gouffre gaehnt und beginnt aufzuwachen... Du meinst Dich zu"
       +" erinnern, dass Gouffres friedlich sind... hoffentlich..."));
  gou=0;
  call_out("newgou", 3);
  return 1;
}

newgou()
{
  object g;
  
  while (!remove_call_out("newgou")) ;
  g=clone_object(NPC("gouffre"));
  g->move(TO, M_GO);
}

klet()
{
  (clone_object(OBJ("klette")))->move(TP, M_NOCHECK);
  return BS(
        "Braune, stachlige Kletten, kleine Kugeln aus wirkungsvollen"
       +" Widerhaken liegen ueberall verteilt und warten nur darauf,"
       +" sich an allem festzuhalten, was ihnen zu nahe kommt. Hin"
       +" und wieder fliegen weitere aus der Mitte des Huegels auf"
       +" und regnen auf die Lichtung nieder. Schau an, Du hast Dir"
       +" auch schon eine eingefangen.");
}

