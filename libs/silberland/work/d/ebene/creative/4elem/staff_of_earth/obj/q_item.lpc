
/*

  QuestItem fuer die 4 Elemente Quest, Teil II
  Der Stab der Erde

*/

inherit "/std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>

nosave string holder;

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_IDS, ({ }));
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);

  holder="";
}

init()
{
  ::init();

  
}

int _set_holder(string str)
{
  if (!stringp(str))
    return 0;
  if (getuid(previous_object())!="creative")
    return 0;
  holder=str;
}

string _query_holder()
{
  if (getuid(previous_object())!="creative")
    return 0;
  return holder;
}
