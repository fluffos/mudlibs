#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../files.h"

inherit "std/mnpc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein schwarzer Skorpion");
  SetProp(P_LONG, "Ein gefaehrliches Tier, so ein Skorpion.\n");
  SetProp(P_NAME, "Skorpion");
  SetProp(P_GENDER, MALE);
  AddId(({"skorpion"}));
  create_default_npc(19);
  SetProp(P_ALIGN, -700);
  SetProp(P_XP, 350000);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_MAX_SP, 600);
  SetProp(P_MAX_HP, 200);
  SetProp(P_SPELLRATE, 70);
  SetProp(P_RACE, "Spinnentier");
  SetProp(P_SIZE, 10);
  SetProp(P_MNPC_AREA, ROOM(""));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 15, 80, 60 }));
  SetProp(P_DEFAULT_INFO, "rasselt unverstaendlich.\n");
  SetProp(P_HANDS, ({" mit seinen Greifzangen", 40, DT_BLUDGEON}));
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Der Skorpion mag nix.\n" }) );
 
  AddSpell(1, 300, 
    "Der Skorpion sticht Dich mit seinem giftigen Stachel.\n",
    "Der Skorpion sticht @WEN mit seinem Stachel.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]) );
  SetProp(P_MSGOUT, "krabbelt#");
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_WEIGHT, 800);
  SetProp(P_VULNERABILITY, ({ DT_COLD, DT_AIR, DT_WATER }));
  SetProp(P_RESISTANCE, ({ DT_FIRE, DT_POISON, DT_ACID }));
  SetProp(P_AGGRESSIVE, ([ P_RACE: (["Zwerg": 0.5, "Elf": 0.7, 
                                     "Mensch": 1.0]) ]) );
}

