/*
  Zone 1: Diamantenwueste
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  object o1, o2;

  ::create();

  SetProp(P_ZONE, "Nordduene");
  SetProp(P_INT_SHORT, "Vor der Diamantenwueste");
  SetProp(P_INT_LONG, BS(
          ""));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 31]));

  AddExit("sueden", ROOM("i4"));
  AddExit("westen", ROOM("h3"));
  AddExit("osten", ROOM("j3"));

  o1=AddItem(NPC("kamel"), REFRESH_DESTRUCT);
  o2=AddItem(NPC("skorpion"), REFRESH_DESTRUCT);
  o1->AddPursuer(o2);
}

