#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Taucherbrille");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SHORT, "Eine Taucherbrille");
  SetProp(P_MATERIAL, MAT_PLASTIC);
  SetProp(P_LONG, "Eine ziemlich nutzlos wirkende Taucherbrille.");
  AddId(({"brille", "taucherbrille"}));
  AddId("\ntbrille");
}

