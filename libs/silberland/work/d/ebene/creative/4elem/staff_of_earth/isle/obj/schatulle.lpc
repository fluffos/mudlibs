// Magische Schatulle zum Wandeln von Sonnenbrille in Taucherbrille

inherit "/obj/container";

#include <container.h>
#include "../files.h"
#include <language.h>
#include <properties.h>
#include <material.h>
#include <moving.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();

  SetProp(P_NAME, "Schatulle");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOGET, "Die Schatulle scheint festzusitzen.\n");
  SetProp(P_SHORT, "Eine kleine Schatulle");
  SetProp(P_LONG, BS(
          "Dies ist eine kleine Schatulle mit einer Aufschrift."));
  AddDetail("aufschrift", BS(
            "Aufschriften kann man im Allgemeinen lesen."));
  AddReadDetail("aufschrift", BS(
                "'Wandlerschatulle'"));
  SetProp(P_INFO, BS(
          "Du untersuchst die Schatulle genauer und stellst fest, dass lauter"
	 +" kleine Brillen darauf abgebildet sind. Aber lauter unterschiedliche."
	 +" Manche davon haben dunkle Glaeser, manche sehen aus wie Taucherbrillen."));
  SetProp(P_MATERIAL, MAT_METAL);
  SetProp(P_MAX_WEIGHT, 3000);
  AddId("schatulle");
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
  SetProp(P_CNT_KEY, "asdpß0hzq3bnjklfa");
}

PreventInsert(object ins)
{
  object ob;

  if (!present("brille", TO)) {
    if (ins->id("\ntbrille")) {
      SetProp(P_CNT_STATUS, CNT_STATUS_LOCKED);
      call_out("t2s", 2, ins);
      return 0;
    }
    if (ins->id("\nsbrille")) {
      SetProp(P_CNT_STATUS, CNT_STATUS_LOCKED);
      call_out("s2t", 2, ins);
      return 0;
    }
  }
  return 1;
}

s2t(object o)
{
  object ob;
  ob=clone_object("d/ebene/creative/4elem/staff_of_earth/isle/obj/tbrille");
  ob->move(TO, M_NOCHECK);
  o->remove();
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
  tell_room(ENV(TO), "Die Schatulle rappelt eigenartig.\n");
}

t2s(object o)
{
  object ob;
  ob=clone_object("d/ebene/creative/4elem/staff_of_earth/desert/obj/sbrille");
  ob->move(TO, M_NOCHECK);
  o->remove();
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
  tell_room(ENV(TO), "Die Schatulle rappelt eigenartig.\n");
}

