/*
   Ein Nomadenumhang
*/

#include "../files.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer Nomadenumhang");
  SetProp(P_LONG, BS( 
    "Ein Nomadenumhang ist leicht und schwarz."));
  SetProp(P_NAME, "Nomadenumhang");
  AddId(({"umhang", "nomadenumhang"}));
  AddAdjective(({"schwarzer"}));
  SetProp(P_INFO, BS(
    "Der Umhang beschuetzt Dich vor den sengenden Strahlen der Sonne."));
  SetProp(P_GENDER, MALE);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK );
  SetProp (P_AC, 8);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 900);
  SetProp(P_TEMPERATURE_PROTECTION, -3);
}

