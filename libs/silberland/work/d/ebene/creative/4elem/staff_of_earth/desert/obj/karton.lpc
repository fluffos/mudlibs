#include <properties.h>
#include <thing.h>
#include "../files.h"
inherit "/std/thing";

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Stueck Karton");
  SetProp(P_LONG, BS(
          "Aus diesem Karton scheint man etwas wichtiges basteln zu koennen."));
  AddId("karton");
  SetProp(P_NAME, "Karton");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 60);
  SetProp(P_MATERIAL, MAT_PAPER);
}

