#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../files.h"

inherit "std/npc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Schakal");
  SetProp(P_LONG, "Ein haesslicher Schakal.\n");
  SetProp(P_NAME, "Schakal");
  SetProp(P_GENDER, MALE);
  AddId(({"schakal"}));
  create_default_npc(10);
  SetProp(P_ALIGN, 100);
  SetProp(P_XP, 50000);
  SetProp(P_MAX_HANDS, 3); 
  SetProp(P_SPELLRATE,30);
  SetProp(P_RACE, "Schakal");
  SetProp(P_SIZE, 40);
  SetProp(P_DEFAULT_INFO, "bellt Dich fragend an.\n");
  SetProp(P_HANDS, ({" mit allen verfuegbaren Pfoten und ausgefahrenen Krallen", 30, DT_RIP}));
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Der Schakal schaut @WEN an und winselt laut.\n" }) );
 
  AddSpell(1, 100, 
    "Der Schakal beisst Dich in die Wade.\n",
    "Der Schakal beisst @WEN in die Wade.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );
  SetProp(P_VULNERABILITY, ({ DT_COLD, DT_SOUND, DT_ACID }));
  SetProp(P_RESISTANCE, ({ DT_FIRE }));
  SetProp(P_MSGOUT, "hoppelt unbeholfen#");
  SetProp(P_MSGIN, "trottet langsam herein");
  SetProp(P_WEIGHT, 15000);
  SetProp(P_WIMPY, 70);
}

