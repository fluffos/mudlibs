/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Auf der Uferpromenade");
  SetProp(P_INT_LONG, BS(
          "Du wanderst die Uferpromenade entlang. Eine Art huebscher Weg an dem"
	 +" ebenfalls huebschen Sandstrand hier auf der Insel. Nach Sueden"
	 +" gelangst Du zurueck zum Steg, nach Nordosten gehts weiter rund um die"
	 +" Insel."));
  AddDetail(({"boden", "ufer", "promenade", "uferpromenade", "strand", "weg", "sandstrand"}), BS(
            "Der Weg hier fuehrt einmal rund um die Insel Aoquin. Inselseitig gibts"
	   +" nur Gestruepp, meerseitig sieht man nur Meer."));
  AddDetail("art", BS(
            "Eine Art Weg eben."));
  AddDetail(({"aoquin", "insel"}), BS(
            "Du befindest Dich hier auf einer Insel namens Aoquin."));
  AddDetail("steg", BS(
            "Der Steg befindet sich suedlich von Dir. Von dort aus kannst Du zum"
	   +" Festland gelangen."));
  AddDetail(({"land", "festland"}), BS(
            "Das Festland liegt westlich von Dir."));
  AddDetail("meer", BS(
            "Gross und gewaltig liegt es hier vor Dir."));
  AddDetail("gestruepp", BS(
            "Die Vegetation hier auf der Insel scheint nicht sehr gepflegt. Es sieht"
	   +" so aus als ob hier nicht oft jemand vorbeikommt."));
  AddDetail("vegetation", BS(
            "Man sieht eigentlich nur Gestruepp und Baeume."));
  AddDetail(({"baum", "baeume"}), BS(
            "Die hoechsten Baeume der Insel befinden sich in der Mitte, auf dem"
	   +" Huegel."));
  AddDetail(({"mitte", "huegel"}), BS(
            "In der Mitte der Insel kann man einen Huegel erahnen."));
  AddDetail("himmel", BS(
            "Strahlend blau heute. Eine richtige Schoenwetterperiode scheint das"
	   +" zu sein."));
  AddDetail(({"schoenwetter", "wetter", "periode", "schoenwetterperiode"}), BS(
            "Es ist schon seit Tagen hier schoen."));
  AddDetail(({"montag", "dienstag", "mittwoch", "donnerstag", "samstag", "sonntag", "tag", "tage"}), BS(
            "Montag, Dienstag, ..."));
  AddDetail("freitag", BS(
            "Endlich Wochenende!"));
  AddDetail("wochenende", BS(
            "Wochenende ist einfach herrlich."));
  AddDetail("sonne", BS(
            "Ziemlich warm hier in der Sonne, findest Du nicht?"));
  AddSmell(DEFAULT_SMELL, BS(
           "Man riecht den Sand, das Meer, das Gestruepp."));
  AddSmell(({"sand", "meer", "gestruepp"}), BS(
           "Irgendwie gewoehnlich. Riecht wie immer."));
  AddSound(DEFAULT_SOUND, BS(
           "Leise rauscht das Meer..."));
  AddSound("meer", BS(
           "*rausch*"));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_PLAIN]));

  AddExit("nordosten", ROOM("d2"));
  AddExit("sueden", ROOM("c4"));
}

