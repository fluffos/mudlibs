/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int tide;

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Auf der Uferpromenade");
  SetProp(P_INT_LONG, BS(
          "Du schlenderst den suedlichen Teil der Insel auf der Uferpromenade"
	 +" entlang. Die Wellen umspielen idyllisch den Strand, von Ebbe und"
	 +" Flut ist kaum etwas zu merken, wie so oft bei einer Insel, die"
	 +" von einem Korallenriff umgeben ist."));
  AddDetail("teil", BS(
            "Grob gesehen gliedert sich die Insel in den noedlicheren und"
	   +" den suedlicheren Teil."));
  AddDetail(({"insel", "aoquin"}), BS(
            "Du stehst mitten auf der Insel Aoquin."));
  AddDetail(({"ufer", "promenade", "uferpromenade"}), BS(
            "Die Uferpromenade fuehrt einmal rund um die ganze Insel und"
	   +" erlaubt herrliche Ausblicke aufs weite Meer."));
  AddDetail(({"welle", "wellen"}), BS(
            "Die Wellen schlagen sanft und leise an den Strand."));
  AddDetail(({"weite", "ausblick", "ausblicke"}), BS(
            "Du schattest Dir mit der Hand die Augen ab und schaust aufs"
	   +" Meer. Nichts als endlose tiefgruene Weite."));
  AddSpecialDetail(({"haende", "hand"}), "hands");
  AddDetail("augen", BS(
            "Ui. Ohne Augen kannst Du doch gar nix untersuchen! Also musst"
	   +" Du welche besitzen."));
  AddDetail("meer", BS(
            "So eine schoene Farbe hat das Meer hier."));
  AddDetail("farbe", BS(
            "Das Meer ist richtig tiefgruen bis tuerkis."));
  AddDetail(({"sand", "strand", "sandstrand"}), BS(
            "Du gehst gerade am Strand entlang. Pass auf, dass Du nicht ins"
	   +" Wasser trittst."));
  AddDetail(({"meerwasser", "wasser"}), BS(
            "Das Wasser ist Meerwasser."));
  AddSpecialDetail(({"ebbe", "flut"}), "flood");
  AddDetail("boden", BS(
            "Du befindest Dich auf dem Strand."));
  AddDetail("himmel", BS(
            "Wie scheinbar ueberall ist der Himmel blau, blau, blau."));
  AddDetail("sonne", BS(
            "Das Wetter haelt hier wirklich schon lange an. Dauernd schoen."));
  AddDetail("wetter", BS(
            "So ein gutes Wetter wie hier haettest Du wohl ueberall gern."));
  AddDetail(({"riff", "korallenriff", "korallen", "koralle"}), BS(
            "Die Insel ist umgeben von einem Korallenriff. Daher ist das"
	   +" Wasser nicht so tief, aber gefaehrlich, denn Korallen sind"
	   +" spitz, so dass man sich leicht verletzten kann beim baden."));
  AddDetail(({"tang", "seetang"}), BS(
            "Der Tang treibt unerreichbar weit draussen vor dem Riff."));

  AddSound(DEFAULT_SOUND, BS(
           "Das Meer rauscht leise."));
  AddSound("meer", BS(
           "Es klingt so wundervoll, das Meer."));
  AddSmell(DEFAULT_SMELL, BS(
           "Hier riecht es stark nach Seetang."));
  AddSmell(({"tang", "seetang"}), BS(
           "Es duerfte hier irgendwo etwas Seetang angespuelt worden sein."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_PLAIN]));

  AddExit("osten", ROOM("e5"));
  AddExit("nordwesten", ROOM("c4"));
  AddCmd("bade", "bath");

  tide=random(100)%2;
}

reset()
{
  ::reset();

  tide++;
  tide%=2;
}


hands()
{
  int h;
  object w;
  string str;

  str="";
  h=TP->QueryProp(P_MAX_HANDS)-TP->QueryProp(P_USED_HANDS);
  if ((w=TP->QueryProp(P_WEAPON)))
    str=w->name(WEN, 0);
  switch (h) {
    case 2: return "Du hast sogar alle Haende frei!\n";
    case 1: return BS(
            "Du benutzt "+(str==""?"eigentlich nichts":str)+", und hast"
	   +" sogar noch eine Hand zur freien Verfuegung.");
    case 0: return BS(
            "Du haeltst gerade "+(str==""?"nichts Wesentliches":str)
	   +" in Haenden, aber eine freie Hand ist nicht verfuegbar.");
    default: return "Eine Hand eben.\n";
  }
}

flood()
{
  return BS("Derzeit herrscht "+(tide?"Flut":"Ebbe")+".");
}

bath(str)
{
  notify_fail("Bade worin?\n");
  if (!str && str!="meer" && str!="in meer")
    return 0;
  write(BS("Du verzichtest auf das Bad, Du koenntest Dir bei den scharfen"
       +" Korallen sicherlich ziemlich weh tun."));
  return 1;
}
