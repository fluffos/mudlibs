#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Strandpromenade");
  SetProp(P_INT_SHORT, "Am Ufer");
  SetProp(P_INT_LONG, BS(
          ""));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28]));

  AddExit("sueden", ROOM("l2"));
  AddExit("westen", ROOM("k1"));
}

