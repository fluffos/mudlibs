#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Sonnenbrille");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SHORT, "Eine Sonnenbrille");
  SetProp(P_MATERIAL, MAT_PLASTIC);
  SetProp(P_LONG, "Eine ziemlich nutzlos wirkende Sonnenbrille.");
  AddId(({"brille", "sonnenbrille"}));
  AddId("\nsbrille");
}

