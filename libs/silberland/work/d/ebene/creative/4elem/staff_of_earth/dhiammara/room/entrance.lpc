/*
  Zone 1: Eingang, kleine Hoehle
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Kleine Hoehle");
  SetProp(P_INT_SHORT, "In einer kleinen Hoehle");
  SetProp(P_INT_LONG, BS(
          ""));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24]));

  AddExit("raus", "/d/ebene/creative/4elem/staff_of_earth/desert/room/h6");
}

