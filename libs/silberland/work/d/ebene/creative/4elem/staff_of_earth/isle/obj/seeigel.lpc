#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Seeigel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 20);
  SetProp(P_SHORT, "Ein Seeigel");
  SetProp(P_MATERIAL, MAT_ANIMAL);
  SetProp(P_LONG, "Ein winziger leider schon toter Seeigel.");
  AddId(({"seeigel"}));
  AddId("\nkrebs");
}

