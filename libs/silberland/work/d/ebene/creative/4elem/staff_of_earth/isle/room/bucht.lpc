/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Im Meer");
  SetProp(P_INT_LONG, BS(
          "Du treibst in der kleinen Bucht vor der Insel Aoquin."
	 +" Das Wasser rund um Dich ist tiefgruen, herrlich anzusehen,"
	 +" wie die Korallen aus dem Meer herausleuchten."));
  AddDetail("bucht", BS(
            "Vor der Insel befindet sich eine kleine Bucht zwischen den Korallen,"
	   +" in der Du Dich gerade befindest."));
  AddDetail(({"insel", "aoquin"}), BS(
            "Du brauchst nur aus dem Wasser zu gehen, schon bist Du wieder auf"
	   +" der Insel."));
  AddDetail(({"boden", "meer", "wasser"}), BS(
            "Das Wasser ist herrlich tiefgruen."));
  AddDetail(({"koralle", "korallen"}), BS(
            "Dort drueben zwischen den Korallen scheint sich etwas zu bewegen!"));
  AddSpecialDetail("etwas", "krebs");
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht stark nach Salz."));
  AddSmell(({"salz", "meer"}), BS(
           "Darf es etwas mehr Salz sein?"));
  AddSound(DEFAULT_SOUND, BS(
           "Leise plaetschert das Wasser am Ufer."));
  AddSound(({"wasser", "ufer"}), BS(
           "Der Wellengang ist nicht sehr hoch, darum plaetschert es nur ein"
	  +" wenig."));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_UNDERWATER, ENV_WATER:40]));
  AddExit("raus", ROOM("d2"));
}

krebs()
{
  object ob, tb;
  string str;

  if (!(tb=present("\ntbrille", TP)))
    return BS("Mist, haettest Du eine Taucherbrille, koenntest Du es Dir genauer"
          +" betrachten.");
  if (present("\nkrebs", TP))
    return BS("Hm, obwohl Du die Taucherbrille aufgesetzt hast, scheint das Ding"
          +" etwas bemerkt zu haben. Jetzt jedenfalls ist es weg.");
  switch (TP->QueryProp(P_RACE)) {
    case "Mensch": str=BS("Du setzt Dir Deine Taucherbrille auf und steckst den"
                  +" Kopf unter Wasser. Da entdeckst Du einen klitzekleinen lieben"
		  +" Taschenkrebs mit einem M auf seinem Ruecken, den Du sofort"
		  +" mitnimmst.");
		   ob=clone_object(OBJ("tkrebs"));
		   break;
    case "Zwerg": str=BS("Muehsam versuchst Du Dir die Taucherbrille aufzusetzen."
                 +" Nach dem siebten Versuch schaffst Du es, haeltst den Kopf unter"
		 +" Wasser und findest eine kleine Languste, die Du Dir schnappst.");
		   ob=clone_object(OBJ("languste"));
		   break;
    case "Elf": str=BS("Behende streifst Du Dir die Taucherbrille ueber und"
                 +" suchst im Wasser nach dem Ding, das sich soeben bewegt hat."
		 +" Ah. Dort hinten ist ein Stueck Koralle, das Du sofort einsteckst.");
		ob=clone_object(OBJ("koralle"));
		break;
    default: str=BS("Wie funktioniert so eine doofe Taucherbrille? Ah, das wars. Du"
                   +" haengst sie Dir uebers Ohr und haeltst die Brille unter Wasser."
		   +" Komisch, man sieht ja gar nix... WAH! Da zwickt Dich ein"
		   +" Seeigel ins Bein! Sofort nimmst Du ihn mit.");
	     ob=clone_object(OBJ("seeigel"));
  }
  ob->move(TP, M_GET);
  return str;
}

