/*
  Master fuer die Diamantenwueste.
  
  Fuegt fuer Questende die Ausgaenge hinzu.
*/

#include <properties.h>
#include <moving.h>
#include "../files.h"

#define TI_PO() (this_interactive()||previous_object())
#define DHI "/d/ebene/creative/4elem/staff_of_earth/dhiammara/room/entrance"
#define LAB_RESET 240
#define DHI_ROOMS ({ROOM("g6"), ROOM("i6"), ROOM("f7"), \
                    ROOM("j7"), ROOM("f8"), ROOM("j8"), ROOM("g9"), \
                    ROOM("h9"), ROOM("i9"), DHI})

#pragma strict_types

nosave mapping rooms=([ROOM("g6"):0, ROOM("h6"):0, ROOM("i6"):0,
                       ROOM("f7"):0, ROOM("j7"):0, ROOM("f8"):0,
                       ROOM("j8"):0, ROOM("g9"):0, ROOM("h9"):0,
                       ROOM("i9"):0]);

nosave void set_exit();

void create()
{
  if (is_clone(this_object())) {
    destruct(this_object());
  }
  seteuid(getuid(this_object()));
  set_exit();
}

int query_prevent_shadow() { return 1; }

nosave void set_exit()
{
  string *dest;
  int i, j;
  
  dest=DHI_ROOMS;
  for (j=0; j<m_sizeof(rooms);j++) {
    i=random(sizeof(dest));
    rooms[m_indices(rooms)[j]]=dest[i];
    dest-=({dest[i]});
  }
  while (!remove_call_out("set_exit")) ;
  call_out("set_exit", LAB_RESET);
}

string QueryDest(string from)
{
  return (rooms[from]);
}

int SpecExit(object caller, object plr)
{
  string msg;
  
//  DEBUG("desmstr", sprintf("dest:%O\n", rooms));
//  DEBUG("desmstr", sprintf("cal:%O, plr:%O\n", caller, plr));

  msg=m_indices((mapping)caller->QueryProp(P_SPECIAL_EXITS))[0];
  plr->move(rooms[file_name(caller)], M_GO, "nach "+CAP(msg));
  return 1;
}

