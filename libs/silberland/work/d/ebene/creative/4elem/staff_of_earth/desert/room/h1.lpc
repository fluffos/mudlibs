/*
  Zone 1: Diamantenwueste
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordduene");
  SetProp(P_INT_SHORT, "Vor der Diamantenwueste");
  SetProp(P_INT_LONG, BS(
          "Hier bist Du noerdlich einer kleinen Senke der Nordduene angelangt."
         +" Die Duene schuetzt Dich vor dem grellen Sonnenlicht, das noch"
         +" dazu tausendfach von den vielen Diamantensplittern reflektiert"
         +" wird. An Deiner Stelle wuerde ich nicht ohne Schutz in den"
         +" Sueden gehen. Ein Skelett liegt am Wegesrand."));
  SetProp(P_LIGHT,1);
  
  AddDetail("schutz", BS(
            "Eine Sonnenbrille koennte schon helfen."));
  AddDetail(({"brille", "sonnenbrille"}), BS(
            "Auch wenn man so etwas nicht unbedingt kaufen kann, ist es doch"
           +" nicht so schwer, so etwas aehnliches zu basteln."));
  AddDetail("sand", BS(
            "Auch hier ist der Sand nichts anderes wie Diamantenstaub."));
  AddDetail(({"staub", "diamantenstaub", "diamant", "diamanten"}), BS(
            "Der Diamantenstaub liegt hier herum und bildet die oberste"
           +" Sandschicht.")); 
  AddDetail(({"schicht", "sandschicht"}), BS(
            "Die oberste Schicht besteht aus Diamantenstaub."));
  AddDetail("senke", BS(
            "Die Nordduene, die sich von Suedwesten bis Suedosten erstreckt,"
           +" hat einen kleinen Durchgang ganz im Sueden."));
  AddDetail(({"durchgang", "gang"}), BS(
            "Suedlich von Dir befindet sich ein Durchgang in der Nordduene."));
  AddDetail(({"nordduene", "duene"}), BS(
            "Die Nordduene erstreckt sich von Suedwesten bis Suedosten."));
  AddDetail(({"diamantensplitter", "splitter"}), BS(
            "Es rentiert sich bestimmt nicht, die vielen Diamantensplitter"
           +" aufzuheben."));
  AddDetail("sueden", BS(
            "Im Sueden setzt sich der Weg fort."));
  AddDetail("weg", BS(
            "Der Weg macht hier eine Biegung von Westen nach Sueden."));
  AddDetail("biegung", BS(
            "Der Weg fuehrt hier von Westen nach Sueden."));
  AddDetail("boden", BS(
            "Am Boden liegt eigentlich nur Sand."));
  AddDetail("himmel", BS(
            "Am Himmel siehst Du die Sonne."));
  AddDetail("sonne", BS(
            "Wie in einer Wueste nicht anders zu erwarten, gibts hier auch Sonne."));
  AddDetail("wueste", BS(
            "Du befindest Dich mittendrin."));
  AddDetail(({"sonnenlicht", "licht"}), BS(
            "Das gleissende Sonnenlicht brennt in Deinen Augen."));
  AddDetail(({"auge", "augen"}), BS(
            "Du solltest Deine Augen unbedingt schuetzen."));
  
  AddSound(DEFAULT_SOUND, BS(
           "Eine innere Stimme raet Dir: Geh nicht gen Sueden ohne Schutz!"));
  AddSound("stimme", BS(
           "Eine innere Stimme sagt Dir: Ohne Schutz wirst Du sterben!"));
  AddSound("seele", BS(
           "Du hoerst die unstete Seele eines Verstorbenen."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst im Prinzip ueberhauptnichts."));
  AddSmell("prinzip", BS(
           "Ein Prinzip wiederum riecht interessant."));  

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30]));

  AddRoomMessage(({"Eine leise Stimme wispert: Schuetze Dich, sonst bist Du tot!\n",
                   "Etwas fluestert: Das Licht... das Licht... es ist so grell...\n",
                   "Eine verstorbene Seele wimmert: Hier habe ich mein Augenlicht"
                  +" verloren!\n"}), 50);

  AddItem(OBJ("skelett"));

  AddExit("sueden", ROOM("h2"));
  AddExit("westen", ROOM("g1"));
}

