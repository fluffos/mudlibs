/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Am Steg");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich auf einem Steg, der hier in Richtung Westen"
	 +" einfach nicht mehr weiter fuehrt. Nach Osten allerdings fuehrt"
	 +" der Weg zu einer Insel. Das Wasser macht einen ruhigen Eindruck,"
	 +" es scheint also ungefaehrlich zu sein, hier mit einem Boot oder"
	 +" Schiff umherzufahren."));
  AddDetail("steg", BS(
            "Der Steg besteht wie ueblich aus Holz."));
  AddDetail("holz", BS(
            "Du siehst Holz. Es duerfte sich um Fichte handeln."));
  AddDetail("fichte", BS(
            "Fichtenholz verwendet man ueblicherweise hauptsaechlich als"
	   +" Bauholz, da es sehr stabil ist und recht lange haelt.")); 
  AddDetail("bauholz", BS(
            "Bauholz ist Holz zum Bauen."));
  AddDetail("westen", BS(
            "Westlich von Dir befindet sich Meer. Allerdings kannst Du im"
	   +" flirrenden Sonnenlicht eine Kuestenlinie ausmachen."));
  AddDetail(({"linie", "kueste", "kuestenlinie"}), BS(
            "Du bist auf die Insel wohl vom Festland gekommen. Das muesste"
	   +" die Kuestenlinie sein, die Du da sehen kannst."));
  AddDetail(({"festland", "land"}), BS(
            "Du stehst zwar auf festem Land, aber das Festland ist westlich."));
  AddDetail(({"sonne", "licht", "sonnenlicht"}), BS(
            "Die Sonne verursacht manchmal Sonnenbrand."));
  AddDetail("sonnenbrand", BS(
            "Ohne Sonnencreme kannst Du Dich eh nicht einschmieren."));
  AddDetail(({"creme", "sonnencreme"}), BS(
            "Hm. Versuch Dich zu erinnern, wo es die noch zu kaufen gab."));
  AddDetail("meer", BS(
            "Meer. Mehr Meer. Viel Meer. Steve Mahre. :)"));
  AddDetail("mahre", BS(
            "Wer erinnert sich nicht an die genialen Schifahrerzwillinge Phil"
	   +" und Steve Mahre..."));
  AddDetail(({"schifahrer", "zwillinge", "schifahrerzwillinge"}), BS(
            "Das ist jetzt aber belanglos, kommt es doch aus einer anderen"
	   +" Welt."));
  AddDetail("welt", BS(
            "HIER jedenfalls ist das SilberLand."));
  AddDetail("silberland", BS(
            "Na komm. Du bist ja definitiv im SilberLand eingeloggt."
	   +" Deine Forscherpunktegier ist aber wirklich unersaettlich."));
  AddDetail(({"gier", "punktegier", "forscherpunktegier"}), BS(
            "Jetzt ist es aber genug. :)"));
  AddDetail(({"insel", "aoquin"}), BS(
            "Diese Insel hier nennt sich Aoquin."));
  AddDetail("osten", BS(
            "Im Osten siehst Du nur noch mehr Steg."));
  AddDetail(({"wasser", "eindruck"}), BS(
            "Das Wasser hier ist nicht sehr tief, das duerfte auch der Grund"
	   +" dafuer sein, dass der Steg so weit hinausfuehrt. Scheinbar"
	   +" ist hier so eine Art Korallenriff, das das offene Meer von der"
	   +" Lagune abtrennt."));
  AddDetail("grund", BS(
            "Hast Du etwa guten Grund, den Grund zu untersuchen?"));
  AddDetail(({"riff", "korallenriff"}), BS(
            "Korallen. Huebsche unter Wasser befindliche Lebewesen."));
  AddDetail("lebewesen", BS(
            "Neben den Korallen gibts auch einige bunte Fische, aber leider"
	   +" verstecken sie sich so gut."));
  AddDetail("fische", BS(
            "Du hast jetzt keinen Hunger."));
  AddDetail("hunger", BS(
            "Du hast keinen."));
  AddDetail("lagune", BS(
            "In tollen Farben leuchtet die Lagune noerdlich und suedlich"
	   +" von Dir."));
  AddDetail("farben", BS(
            "Es handelt sich um ein tuerkisgruenes Blau."));
  AddDetail("blau", BS(
            "Die Lagune ist herrlich tuerkisgruen blau."));
  AddDetail("weg", BS(
            "Der Weg ist ein Steg."));
  AddDetail("himmel", BS(
            "So blau wie die Lagune ist auch der Himmel."));
  AddDetail("wellen", BS(
            "Wo ein Meer, da auch Wellen."));
  AddDetail("boden", BS(
            "Du siehst den Steg."));
  AddSound(DEFAULT_SOUND, BS(
           "Das Wasser rauscht, wenn die Wellen an das Ufer klatschen"));
  AddSound(({"wasser", "wellen"}), BS(
           "Es klingt einfach richtig klassisch nach tropischer Insel."));
  AddSound("klassisch", BS(
           "*rausch*"));
  AddSmell(DEFAULT_SOUND, BS(
           "Es riecht nach Meer."));
  AddSmell("meer", BS(
           "Meer riecht im Normalfall salzig und nach Tang."));
  AddSmell("tang", BS(
           "Da Du keinen Tang hier siehst, riecht es auch nicht danach."));
	    
  SetProp(P_LIGHT,1);


  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));

  AddExit("osten", ROOM("b4"));
}

