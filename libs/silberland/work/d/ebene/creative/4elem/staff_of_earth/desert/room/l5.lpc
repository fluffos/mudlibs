/*
  Zone 1: Diamantenwueste
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordduene");
  SetProp(P_INT_SHORT, "Vor der Diamantenwueste");
  SetProp(P_INT_LONG, BS(
          ""));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28]));

  AddExit("norden", ROOM("l4"));
  AddExit("westen", ROOM("k5"));
}

