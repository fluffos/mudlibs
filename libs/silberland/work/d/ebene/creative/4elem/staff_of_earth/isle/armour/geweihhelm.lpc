inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"
#include <environment.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"helm", "geweihhelm"}));
  SetProp(P_SHORT, "Ein Geweihhelm");
  SetProp(P_LONG, "Das ist der Geweihhelm des Fuersten der Waelder.\n");
  SetProp(P_INFO, BS("Dieser Helm ist ein guter Schutz gegen Blitze. Er scheint"
                 +" sich in seiner gewohnten Umgebung wohl zu fuehlen."));
  SetProp(P_NAME, "Geweihhelm");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 1000);

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_QUALITY_DECAY, ([DT_FIRE: 60]));
  SetProp(P_AC, 5+random(6));
  SetProp(P_NOBUY, 1);
  SetProp(P_DEFEND_FUNC, TO);

  SetProp(P_MATERIAL, ([MAT_TAR:10, MAT_CARTON:10, MAT_HORN:50, MAT_PELT:10,
                        MAT_LEATHER:30]));
}

string extra_look()
{
  object t;
  if ((t=QueryWorn()))
    return (t->name(WER)+" traegt ein praechtiges Geweih auf seinem Kopf.\n");
  return "";
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int r, a;

  r=0; a=QueryProp(P_AC);
  if (member(dtyp, DT_LIGHTNING)>=0)
    r=1+random(2);
  if (enemy->QueryProp(P_ALIGN)>0)
    r+=1;
  if (environment(enemy) && environment(enemy)->QueryTerrain()==TT_FOREST)
    r+=12-a;
  return r;
}

