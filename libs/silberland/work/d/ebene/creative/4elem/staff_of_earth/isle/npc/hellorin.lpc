#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

inherit "std/npc";

create()
{
  object b;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Hellorin, Fuerst der Waelder");
  SetProp(P_LONG, BS(""
	 ));
  
  SetProp(P_WEIGHT, 110000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Hellorin");
  SetProp(P_GENDER, MALE);
  AddId(({"fuerst", "hellorin"}));
  create_default_npc(30);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_MAX_SP, 1650);
  SetProp(P_SPELLRATE, 60);
  SetProp(P_RACE, "Phaerie");
  SetProp(P_SIZE, 230);
  SetProp(P_DEFAULT_INFO, "schuettelt erstaunt seinen Kopf.\n");
 
//  SetProp(P_HANDS, ({" mit ihrem patschnassen Handtuch", 100, DT_WHIP}));
  
  AddSpell(1, 1, "", "", DT_MAGIC, "blitz" );
  AddSpell(5, 250, BS(
           "Hellorin senkt den Kopf und zieht Dir eins mit dem Geweih ueber."), BS(
	   "Hellorin senkt den Kopf und zieht @WEM eins mit dem Geweih ueber."),
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(3, 600, BS(
           "Hellorin beschwoert ueble Maechte hervor und trifft Dich mit voller Wucht."), BS(
	   "Hellorin beschwoert ueble Maechte hervor und trifft @WEN mit voller Wucht."),
	   DT_UNHOLY, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_RESISTANCE, ({ DT_AIR, DT_LIGHTNING, DT_COLD, DT_WATER }));
  SetProp(P_VULNERABILITY, ({ DT_FIRE }));
  // enable_commands();
  seteuid(getuid(this_object()));
  set_living_name("hellorin");

  clone_object(ARMOUR("geweihhelm"))->move(TO);
  command_me("trage helm");
  (b=clone_object(OBJ("kblitz")))->SetProp(P_AMOUNT, 3);
  b->move(TO);
}

blitz(enemy, damage, type)
{
  object b;
  
  if ((b=present("blitz")))
    b->throw("blitz nach "+lower_case(enemy->name(WER)));
  else
    say("Hellorin faselt: \"Blitz adfso qgruuk?\"\n");
}

