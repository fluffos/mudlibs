/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Am Steg");
  SetProp(P_INT_LONG, BS(
          "Hier auf dem oestlichen Teil des Steges siehst Du den Weg, der rund"
	 +" um die Insel fuehrt, nach Norden und Suedosten abzweigen. Oestlich"
	 +" von hier ist das Gestruepp und die Vegetation so dicht, dass man"
	 +" unmoeglich durchgehen kann. Mitten auf der Insel kannst Du jedoch"
	 +" den kleinen Huegel erkennen, der dicht von Baeumen bewachsen ist."));
  AddDetail("himmel", BS(
            "Der Himmel ist herrlich azurblau."));
  AddDetail("sonne", BS(
            "Die Sonne steht brennend am Himmel."));
  AddDetail(({"teile", "teil"}), BS(
            "Der Steg besteht im Wesentlichen aus drei Teilen."));
  AddDetail("steg", BS(
            "Es ist ein Steg aus Holz."));
  AddDetail("boden", BS(
            "Der Steg bildet Deinen begehbaren Boden."));
  AddDetail("holz", BS(
            "Fichtenholz, so wie man es zum Beispiel aus einigen Fichten hier auf"
	   +" der Insel gewinnen koennte."));
  AddDetail(({"fichtenholz", "fichten", "fichte"}), BS(
            "Hier auf der Insel wachsen unter anderem auch einige Fichten."));
  AddDetail("beispiel", BS(
            "Faellt Dir ein vernuenftiges Beispiel ein?"));
  AddDetail(({"insel", "aoquin"}), BS(
            "Direkt oestlich von Dir erstreckt sich vor Deinen Augen die Insel"
	   +" Aoquin."));
  AddDetail(({"augen", "auge"}), BS(
            "Ich hoffe, Du besitzt zwei Augen im Kopf."));
  AddDetail("kopf", BS(
            "Sitzt der Kopf noch auf Deinem Koerper?"));
  AddDetail("koerper", BS(
            "An Dir ist doch hoffentlich noch alles dran? Arme, Beine?"));
  AddDetail(({"arm", "bein", "arme", "beine"}), BS(
            "Hm. Glueck gehabt. Noch alles da."));
  AddDetail("glueck", BS(
            "Glueck muss man eben haben."));
  AddDetail(({"weg", "norden", "suedosten"}), BS(
            "Nach Norden fuehrt der Weg um die noerdliche, nach"
	   +" Suedosten fuehrt er um die suedliche Inselhaelfte."));
  AddDetail(({"haelfte", "inselhaelfte"}), BS(
            "Die Insel besteht erstaunlicherweise aus zwei Haelften."));
  AddDetail(({"baeume", "baum"}), BS(
            "Mitten auf der Insel stehen fuerchterlich viele Baeume."));
  AddDetail("mitte", BS(
            "Die Insel hat nicht nur zwei Haelften sondern auch eine Mitte."
	   +" Und genau in der Mitte befindet sich ein Huegel."));
  AddDetail("huegel", BS(
            "Der Huegel steht zwar nicht unweit von hier, jedoch auf direktem"
	   +" Wege ist er nicht zu erreichen."));
  AddDetail(({"gestruepp", "vegetation"}), BS(
            "Dicht wuchert das Gestruepp hier, so dicht, dass kein Durchkommen"
	   +" moeglich ist."));
  AddDetail("durchkommen", BS(
            "Unmoeglich."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst ausser den ueblichen Pflanzen nichts Wesentliches."));
  AddSmell(({"pflanze", "pflanzen"}), BS(
           "Hm. Wie eben Pflanzen so riechen."));
  AddSound(DEFAULT_SOUND, BS(
           "Horch nur! Weit weit von Sueden hoert man etwas..."));
  AddSound("sueden", BS(
           "Scheinbar hast Du Dich getaeuscht. Hier herrscht nur Stille und"
	  +" das Gezwitscher kleiner Voegel."));
  AddSound("stille", BS(
           "Psssssssst..."));
  AddSound(({"voegel", "vogel", "gezwitscher"}), BS(
           "Sanft und leise zwitschern ein paar Voegel so vor sich her."));

  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_PLAIN]));

  AddExit("norden", ROOM("c3"));
  AddExit("suedosten", ROOM("d5"));
  AddExit("westen", ROOM("b4"));
}

