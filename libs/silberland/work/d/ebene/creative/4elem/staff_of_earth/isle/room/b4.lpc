/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Am Steg");
  SetProp(P_INT_LONG, BS(
          "Du stehst mitten auf einem Holzsteg, der das offene Meer und den Anlegeplatz"
         +" mit der Insel Aoquin verbindet. Westlich von Dir siehst Du das Meer, ganz"
	 +" entfernt kannst Du das Festland ausmachen. Noerdlich und suedlich kannst Du"
	 +" nur Wellen erkennen. Und weiter oestlich erstreckt sich beinahe majestaetisch"
	 +" die Insel vor Deinen Augen. Mittig auf der Insel scheint ein kleiner Huegel"
	 +" zu sein."));
  AddDetail(({"steg", "holzsteg"}), BS(
            "Wie Du sicher schon bemerkt hast, ist der Steg aus Holz."));
  AddDetail(({"fichte", "fichtenholz", "holz"}), BS(
            "Der Steg besteht aus Fichtenholz."));
  AddDetail("meer", BS(
            "Auf dem Meer sieht man ausser den Wellen und Gischtkronen nur Wasser."));
  AddDetail("wasser", BS(
            "Das Meer besteht ueberraschenderweise groesstenteils aus Wasser."));
  AddDetail(({"welle", "wellen"}), BS(
            "Wenn das Spiel der Wellen nicht so faszinierend waere, haette man an einer"
	   +" Welle lange nicht so viel Freude."));
  AddDetail("spiel", BS(
            "Herrlich zuzusehen, wie die Wellen gegen das Ufer schlagen und herrlich"
	   +" rauschen."));
  AddDetail("ufer", BS(
            "Rund um die Insel befindet sich das Ufer. Wellen branden heran."));
  AddDetail(({"aoquin", "insel"}), BS(
            "Du befindest Dich auf dem Steg der auf die Insel Aoquin fuehrt."));
  AddDetail("freude", BS(
            "Du freust Dich."));
  AddDetail(({"platz", "anlegeplatz"}), BS(
            "Der Anlegeplatz des Bootes befindet sich westlich von Dir."));
  AddDetail("boot", BS(
            "Mit was bist Du wohl hergekommen?"));
  AddDetail("festland", BS(
            "Woher bist Du wohl gekommen?"));
  AddDetail(({"mitte", "huegel"}), BS(
            "Ziemlich in der Mitte der Insel befindet sich ein Huegel. Ausser den Baeumen"
	   +" die darauf wachsen kannst Du nicht viel erkennen."));
  AddDetail(({"baum", "baeume"}), BS(
            "Auf dem Huegel wachsen die Baeume so dicht, dass man nichts Genaues erkennen"
	   +" kann."));
  AddDetail("augen", BS(
            "Mit den Augen kannst Du die Umgebung betrachten."));
  AddDetail("umgebung", BS(
            "Sieh Dich nur um!"));
  AddDetail("himmel", BS(
            "Der Himmel ist blau wie immer."));
  AddDetail("sonne", BS(
            "Die Sonne schaut von oben auf Dich herab und laechelt Dir"
	   +" richtiggehend zu."));
  AddDetail(({"gischt", "gischtkronen", "krone", "kronen", "gischtkrone"}), BS(
            "Am Kamm der Welle bildet sich immer eine kleine Gischtkrone."));
  AddDetail("kamm", BS(
            "Der Kamm der Welle eben."));
  AddDetail("boden", BS(
            "Am Boden befindet sich der Steg, rundherum das Wasser."));
  AddSmell(DEFAULT_SMELL, BS(
           "Man riecht hier den angenehm salzigen Duft des Meeres."));
  AddSmell(({"meer", "duft", "salz"}), BS(
           "Gaenzlich ungewohnt aber irgendwie erregend."));
  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst das Meer sanft rauschen."));
  AddSound(({"rauschen", "meer", "welle", "wellen", "ufer"}), BS(
           "Die Wellen schlagen gegen das Ufer und rauschen dabei."));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));

  AddExit("osten", ROOM("c4"));
  AddExit("westen", ROOM("a4"));
}

