/*
  Zone 1: Diamantenwueste
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nordduene");
  SetProp(P_INT_SHORT, "Vor der Diamantenwueste");
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich vor der grossen Diamantenwueste. Suedlich von"
         +" Dir siehst Du nur noch Sand, Sand, Sand. Eine grosse Duene,"
         +" die sich auch Nordduene nennt, versperrt Dir die Sicht gen Sueden."
         +" Weiter im Osten wird es zusehends heller. Du musst die Augen"
         +" schon sehr zusammenkneifen, dass Du ueberhaupt noch etwas sehen"
         +" kannst."));
  SetProp(P_LIGHT,1);
  
  AddDetail(({"wueste", "diamantenwueste"}), BS(
            "Du bist mittendrin, in der Diamantenwueste. Tausende von"
           +" funkelnden Diamanten sind rund um Dich."));
  AddDetail(({"diamant", "diamanten", "staub", "diamantenstaub"}), BS(
            "Im Prinzip handelt es sich nur um Diamantenstaub. Du denkst Dir,"
           +" dass es keinen Sinn hat, den Staub aufzuheben.")); 
  AddDetail("sinn", BS(
            "Es hat wirklich keinen Sinn, den Staub aufzuheben."));
  AddDetail("sand", BS(
            "Der Sand entpuppt sich beim naeheren Hinsehen als Diamantenstaub."));
  AddDetail(({"duene", "nordduene"}), BS(
            "Suedlich von Dir befindet sich die Nordduene. Sie versperrt Dir die"
           +" Sicht gen Sueden."));
  AddDetail("sicht", BS(
            "Im Sueden kannst Du gar nix sehen, schliesslich befindet sich"
           +" dort nur eine Duene. Im Norden gibts noch ein wenig Steppe, und"
           +" im Osten, tja, da wirds gleissend hell."));
  AddDetail("norden", BS(
            "Noerdlich von Dir befindet sich die Steppe."));
  AddDetail("steppe", BS(
            "Die Steppe befindet sich von hier aus gesehen im Norden."));
  AddDetail("sueden", BS(
            "Im Sueden kannst Du eine grosse Duene erkennen."));
  AddDetail("osten", BS(
            "Wenn Du gen Osten blickst, musst Du Deine Augen sehr eng"
           +" zusammenkneifen, damit Du ueberhaupt noch etwas siehst."));
  AddDetail(({"auge", "augen"}), BS(
            "Deine Augen werden, wenn Du nach Osten schaust, schnell muede."
           +" Vielleicht solltest Du etwas dagegen unternehmen. Ein Schutz"
           +" wuerde schon helfen."));
  AddDetail("schutz", BS(
            "So etwas aehnliches wie eine Sonnenbrille vielleicht."));
  AddDetail(({"brille", "sonnenbrille"}), BS(
            "Vielleicht kannst Du Dir eine Sonnenbrille basteln."));
  AddDetail("boden", BS(
            "Der Boden besteht aus Diamantenstaub"));
  AddDetail("himmel", BS(
            "Der Himmel befindet sich wie zu erwarten war oberhalb von Dir."));
  AddDetail("sonne", BS(
            "Am Himmel prangt unerbittlich die Sonne"));
  AddDetail(({"wolke", "wolken"}), BS(
            "Es sind keine Wolken zu sehen."));
  
  AddSound(DEFAULT_SOUND, BS(
           "Du lauscht ganz angestrengt, aber ausser einem lauen Lueftlein,"
          +" das ueber den Sand dahinweht, kannst Du nichts hoeren."));
  AddSound("lueftlein", BS(
           "Das Lueftlein reisst ein paar Sandkoerner mit."));
  AddSound("sand", BS(
           "Leise rieselt der Sand..."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst Sand."));
  AddSmell("sand", BS(
           "Auch, wenn Sand nach nix riecht, kommt Dir vor, Du riechst Sand.")); 

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29]));

  AddExit("osten", ROOM("h1"));
  AddExit("norden", "/d/ebene/creative/feldlager/room/a7_b4");

  AddItem(NPC("schakal"), REFRESH_DESTRUCT);
}

