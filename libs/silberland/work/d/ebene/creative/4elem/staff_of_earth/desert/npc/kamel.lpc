#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../files.h"

inherit "std/mnpc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Kamel");
  SetProp(P_LONG, "Ein Kamel mit sage und schreibe zwei Hoeckern.\n");
  AddDetail("hoecker", BS("Ein Kamel besitzt zwei Hoecker, um damit Wasser"
                         +" zu speichern."));
  AddDetail("wasser", BS("Das Wasser befindet sich in den Hoeckern."));
  SetProp(P_NAME, "Kamel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kamel"}));
  create_default_npc(18);
  SetProp(P_ALIGN, 700);
  SetProp(P_XP, 250000);
  SetProp(P_MAX_HANDS, 0); 
  SetProp(P_MAX_SP, 200);
  SetProp(P_MAX_HP, 600);
  SetProp(P_SPELLRATE, 60);
  SetProp(P_RACE, "Kamel");
  SetProp(P_SIZE, 210);
  SetProp(P_MNPC_AREA, ROOM(""));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 25, 70, 60 }));
  SetProp(P_DEFAULT_INFO, "schnaubt entruestet.");
  SetProp(P_HANDS, ({" mit seinen Vorderhufen", 80, DT_BLUDGEON}));
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Das Kamel hat in seinen Hoeckern keinen Platz mehr.\n" }) );
 
  AddSpell(1, 300, 
    "Das Kamel dreht sich geschickt um und tritt Dich in den Unterleib.\n",
    "Das Kamel schlaegt aus und trifft @WEN genau in den Unterleib.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  SetProp(P_MSGOUT, "trampelt#");
  SetProp(P_MSGIN, "trampelt herein");
  SetProp(P_WEIGHT, 140000);
  SetProp(P_VULNERABILITY, ({ DT_SLASH, DT_PIERCE, DT_COLD, DT_POISON }));
  SetProp(P_RESISTANCE, ({ DT_FIRE, DT_ACID, DT_AIR, DT_WATER }));
}

