#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../files.h"

inherit "std/mnpc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Wuestenschlange");
  SetProp(P_LONG, "Eine kleine gewandte listige Wuestenschlange.\n");
  SetProp(P_NAME, "Schlange");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schlange", "wuestenschlange"}));
  create_default_npc(16);
  SetProp(P_ALIGN, -300);
  SetProp(P_XP, 150000);
  SetProp(P_MAX_HANDS, 0); 
  SetProp(P_MAX_SP, 300);
  SetProp(P_MAX_HP, 100);
  SetProp(P_SPELLRATE,30);
  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 10);
  SetProp(P_MNPC_AREA, ROOM(""));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 15, 80, 60 }));
  SetProp(P_DEFAULT_INFO, "zischt Dich grausam an.\n");
  SetProp(P_HANDS, ({" mit einem kleinen unscheinbaren Biss", 40, DT_POISON}));
  seteuid(getuid(this_object()));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Die Schlange hat doch nix zum tragen.\n" }) );
 
  AddSpell(87, 200, 
    "Die Schlange schlaengelt vor und beisst Dich boese.\n",
    "Die Schlange beisst @WEN in die Wade.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(13, 600,
    "Die Schlange kriecht in Blitzesschnelle an Dir hoch und erwuergt Dich.\n",
    "Die Schlange versucht, @WEN zu erwuergen.\n",
    DT_SQUEEZE, ([SP_REDUCE_ARMOUR:
                  ([AT_ARMOUR: 10, AT_AMULET: 50, AT_SHIELD: 0, AT_HELMET: 10,
                    AT_RING: 0, AT_GLOVE: 5, AT_CLOAK: 15, AT_BOOT: 0,
                    AT_TROUSERS: 0, AT_MISC: 1]),
                  SP_SHOW_DAMAGE: 1]));
  SetProp(P_MSGOUT, "schlaengelt#");
  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_WEIGHT, 8000);
  SetProp(P_DIE_MSG, " zischt ein letztes Mal und faellt in sich zusammen.\n");
  SetProp(P_CORPSE_FLAGS, COR_NOSETWEIGHT);
  SetProp(P_VULNERABILITY, ({ DT_WHIP, DT_PIERCE, DT_COLD, DT_WATER }));
  SetProp(P_RESISTANCE, ({ DT_FIRE, DT_BLUDGEON, DT_SLASH, DT_POISON,
                           DT_ACID, DT_ELECTRIC, DT_HOLY }));
}

