/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

string *solved;

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Auf dem Huegel");
  SetProp(P_INT_LONG, BS(
          "Du bist auf dem Huegel, der sich mittig auf der Insel"
	 +" Aoquin befindet. Hier wachsen rundherum Baeume, so dass man die"
	 +" Aussicht gar nicht geniessen kann. Weiter nordoestlich gelangst Du"
	 +" zum hoechsten Punkt der Insel, der Weg nach Westen wird Dir komplett"
	 +" von dichtest beisammenstehenden Fichtenstaemmen versperrt. Weiter"
	 +" nach Sueden gelangst Du zur Uferpromenade zurueck."));
  AddDetail("huegel", BS(
            "Du stehst ja schon fast direkt drauf, auf dem Huegel."));
  AddDetail(({"insel", "aoquin"}), BS(
            "Der Huegel, auf dem Du stehst, befindet sich auf der Insel Aoquin."));
  AddDetail(({"baum", "baeume"}), BS(
            "Rund um Dich herum erblickst Du nur Baeume, von denen besonders"
	   +" die westlichen so dicht beisammen stehen, dass sie Dich absolut"
	   +" nicht durchlassen wollen."));
  AddDetail("aussicht", BS(
            ". o O (Wenn hier nur nicht so viele Baeume herumstehen wuerden!!!)"));
  AddDetail("punkt", BS(
            "Der hoechste Punkt der Insel befindet sich nordoestlich"
           +" von Dir."));
  AddDetail("weg", BS(
            "Der Weg hier fuehrt eigentlich nur nach Nordosten und Sueden."));
  AddDetail("nordosten", BS(
            "Nordoestlich von hier liegt der hoechste Punkt der Insel."));
  AddDetail("sueden", BS(
            "Suedlich von hier gehts langsam wieder ans Ufer zur Promenade."));
  AddDetail(({"promenade", "ufer", "uferpromenade"}), BS(
            "Die Uferpromenade fuehrt rund um die Insel."));
  AddDetail("westen", BS(
            "Westlich von Dir befinden sich einfach NUR Baumstaemme."));
  AddDetail(({"staemme", "fichtenstaemme", "baumstaemme"}), BS(
            "Die Fichtenstaemme westlich von Dir versperren Dir komplett den Weg."
	   +" Ein Baumstamm jedoch ist merkwuerdig."));
  AddDetail(({"stamm", "baumstamm", "fichtenstamm"}), BS(
            "Der Baumstamm hat ein seltsames Loch."));
  AddDetail(({"blatt", "blaetter"}), BS(
            "Ein Baum hat ja auch wirklich viele Blaetter."));
  AddDetail("himmel", BS(
            "Die Baeume hier versperrt jegliche Sicht auf den Himmel."));
  AddDetail("sicht", BS(
            "Das einzige was Du siehst ist der Weg und Baeume."));
  AddDetail("sonne", BS(
            "Erahnen kann man sie, im Schatten der Baeume jedoch sehen unmoeglich."));
  AddDetail("schatten", BS(
            "Direkt angenehm, so ein bisserl ein Schatten."));
  AddDetail("form", BS(
            "Reichlich ungewoehnliche Form fuer ein Loch."));
  AddDetail(({"igel", "languste", "krebs", "taschenkrebs", "seeigel", "koralle"}), BS(
            "So sieht das Loch nun eben mal aus!"));
  AddSpecialDetail("loch", "hole"); 
  AddDetail("boden", BS(
            "Der Boden ist festgestampft."));
  AddSmell(DEFAULT_SMELL, BS(
           "Hier riecht es gut nach Fichtenholz."));
  AddSmell(({"fichte", "fichtenholz", "holz"}), BS(
           "Obwohl hier kein Baum angesaegt ist, riecht es stark nach Fichte."));
  AddSound(DEFAULT_SOUND, BS(
           "Die Blaetter der Baeume rauschen leise im sanften Wind."));
  AddSound("wind", BS(
           "Der Wind weht so sanft, man hoert ihn kaum."));
  AddSound(({"baeume", "blaetter"}), BS(
           "Die Blaetter rauschen ganz leise."));
  AddCmd(({"schmeiss", "schmeisse"}), "throw");
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_HILL]));

  AddExit("nordosten", ROOM("g2"));
  AddExit("sueden", ROOM("f4"));
  AddSpecialExit("westen", "through");
  solved=({});
}

through()
{
  if (member(solved, getuid(TP))>=0) {
    write(BS("Du schluepfst geschickt durch das kleine Loch zwischen den Staemmen"
         +" hindurch."));
    TP->move(ROOM("e3"), M_GO, "durch ein kleines Loch zwischen den Baeumen", "schluepft", "schluepft geschickt herein");
    solved-=({getuid(TP)});
    return 1;
  }
  write(BS("AUA!!! Du rennst Dir Deinen Kopf an einem dicken Fichtenstamm an."));
  TP->reduce_hit_points(15);
  return 1;
}

hole()
{
  string str;

  str="Das Loch hat die Form eine";
  switch (TP->QueryProp(P_RACE)) {
    case "Mensch": str+="s kleinen Taschenkrebses"; break;
    case "Zwerg": str+="r kleinen Languste"; break;
    case "Elf": str+="s Korallenstuecks"; break;
    default: str+="s kleinen Seeigels";
  }
  str+=". Das Loch befindet sich sehr hoch oben, nicht erreichbar. Aber"
     +" dennoch sieht es so aus, als koennte man etwas hineinschmeissen.";
  return BS(str);
}

throw(str)
{
  object ob;
  string s1;

  notify_fail("Was willst Du wohin schmeissen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s in loch", s1)!=1) return 0;
  if (!(ob=present("\nkrebs", TP))) return 0;
  if (member(({"seeigel", "krebs", "taschenkrebs", "languste", "koralle", "korallenstueck", "stueck"}), s1)==-1) return 0;
  if (!ob->id(lower_case(s1))) return 0;
  write(BS("Du wirfst "+ob->name(WEN)+" in das Loch im Baumstamm. Ploetzlich entdeckst"
        +" Du eine Luecke zwischen den Staemmen, die nach Westen fuehrt."));
  s1=getuid(TP);
  say(BS(CAP(s1)+" wirft irgendetwas fuerchterlich schnell und hoch in die Luft."));
  solved+=({s1});
  ob->remove();
  return 1; 
}

