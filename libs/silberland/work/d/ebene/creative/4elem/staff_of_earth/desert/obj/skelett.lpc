/*

  Der Kartonmaster.

*/

#include <properties.h>
#include <container.h>
#include "../files.h"
inherit "/std/container";

// #define MAT_BONE "m:bone"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG, BS(
          "Das muesste das Skelett eines verstorbenen Abenteurers sein."
         +" Seine Knochen sind schon total zugewachsen. Sein Schaedel"
         +" sieht total furchterregend aus."));
  AddId("skelett");
  AddId("schaedel");
  AddDetail("knochen", BS(
            "Die Knochen sind schon total zugewachsen."));
  AddSpecialDetail("schaedel", "bones");
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_NAME, "Skelett");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 250);
  SetProp(P_MAX_WEIGHT, 60);
  SetProp(P_NOGET, "Das Skelett ist Dir viel zu schwer!\n");
  SetProp(P_MATERIAL, MAT_BONE);
  (clone_object(OBJ("karton")))->move(TO);
}

string bones()
{
  if (present("karton"))
    return BS("Durch die Augenhoehlen siehst Du ein Stueck Karton.");
  else
    return BS("Im Schaedel befindet sich leider gar nichts.");
}

reset()
{
  if (!present("karton"))
    (clone_object(OBJ("karton")))->move(TO);
  return ::reset();  
}
