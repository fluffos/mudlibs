/*
  Zone 1: Diamantenwueste
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Steinwueste");
  SetProp(P_INT_SHORT, "Bei Dhiammara");
  SetProp(P_INT_LONG, BS(
          ""));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29]));

  AddExit("norden", ROOM("h5"));
  AddExit("westen", ROOM("g6"));
  AddExit("osten", ROOM("i6"));
  AddExit("sueden", lambda( 0, ({#'call_other, DES_MASTER, "SpecExit", 
                                 ({#'this_object}), ({#'this_player}) }) ));
}

init()
{
  ::init();

  RemoveExit("sueden");
  AddExit("sueden", lambda( 0, ({#'call_other, DES_MASTER, "SpecExit", 
                                 ({#'this_object}), ({#'this_player}) }) ));
}

