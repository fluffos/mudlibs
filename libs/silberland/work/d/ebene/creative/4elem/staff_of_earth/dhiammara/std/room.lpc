/*
  Room
  Standardraum fuer die Wueste, Erdenstab-Quest.

  Dhiammara, die Wuestenstadt
*/

inherit "/std/room";
inherit "/std/more";

#include <wizlevels.h>
#include <properties.h>
#include "../files.h"
#include <ansi.h>

create()
{
  ::create();
  AddCmd(({"where", "whe", "wo"}), "whe");
  SetProp(P_SUBDOMAIN, "Dhiammara");
}


nosave int CheckZone(object u)
{
  if (!(ENV(u))) return 0;      // gerade einloggende Spieler...
  if (stringp(ENV(u)->QueryProp(P_ZONE)) 
        && ENV(u)->QueryProp(P_SUBDOMAIN)=="Diamantenwueste") {
    if (IS_LEARNER(u)) return 0;  // Magier nicht ins Array nehmen.
    if (getuid(u)==ROOTID) return 0;  // Merlin auch nicht :)
    if (u->QueryProp(P_NPC)) return 0;  // und auch keine NPC's :)
    return 1;
  }
  return 0;
}


whe()
{
  int i, j;
  object *usrs;
  string *who, *where, str, u_name, u_lev, u_loc, u_zone, u_end;

  usrs=filter_array(users(),"CheckZone");
  if (!(i=sizeof(usrs))) {
    write("Es befinden sich derzeit keine Spieler in der Diamantenwueste.\n");
    return 1;
  }
  switch(TP->QueryProp("tty")) {
    case "ansi" : u_name=ANSI_GREEN+ANSI_BOLD; u_lev=ANSI_YELLOW+ANSI_BOLD;
                  u_zone=ANSI_NORMAL; u_loc=ANSI_CYAN;
                  u_end=ANSI_NORMAL; break;
    case "vt100": u_name=ANSI_BOLD; u_lev=ANSI_NORMAL; u_loc=ANSI_BOLD;
                  u_zone=ANSI_NORMAL; u_end=ANSI_NORMAL; break;
    default     : u_name=u_lev=u_loc=u_zone=u_end="";
  }
  
  str="";
  for (j=0; j<i; j++) {
    str+=" | "+u_name+sprintf("%-12s",CAP(getuid(usrs[j])))+u_end+" | "+u_lev
        +sprintf("%2d",usrs[j]->QueryProp(P_LEVEL))+u_end+" | "+u_zone
        +sprintf("%-15s",environment(usrs[j])->QueryProp(P_ZONE))
        +u_end+" | "+u_loc+environment(usrs[j])->QueryProp(P_INT_SHORT)
        +u_end+".\n";
  }
  TP->More("Derzeit befinden sich folgende Spieler in Dhiammmara:\n"
       +"  Name           Lvl  Zone              Ort\n"
       +"-+--------------+----+-----------------+--------------------------\n"+str+"\n");
  return 1;
} 

