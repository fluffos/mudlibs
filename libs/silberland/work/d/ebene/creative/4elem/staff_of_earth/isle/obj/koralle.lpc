#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Korallenstueck");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 20);
  SetProp(P_SHORT, "Ein kleines Korallenstueck");
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_LONG, "Kein besonders schoenes Korallenstueck.");
  AddId(({"korallenstueck", "stueck", "koralle"}));
  AddId("\nkrebs");
}

