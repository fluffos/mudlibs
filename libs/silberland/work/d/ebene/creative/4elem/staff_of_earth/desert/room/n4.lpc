/*
  Zone 1: Diamantenwueste
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Strandpromenade");
  SetProp(P_INT_SHORT, "Am Steg");
  SetProp(P_INT_LONG, BS(
          ""));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27]));

  AddExit("sueden", ROOM("n5"));
  AddExit("osten", ROOM("o4"));
  AddExit("nordwesten", ROOM("m3"));
}

