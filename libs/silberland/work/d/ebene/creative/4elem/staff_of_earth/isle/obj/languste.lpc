#include <properties.h>
#include <material.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Languste");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 20);
  SetProp(P_SHORT, "Eine Languste");
  SetProp(P_MATERIAL, MAT_ANIMAL);
  SetProp(P_LONG, "Eine winzige leider schon tote Languste.");
  AddId(({"languste"}));
  AddId("\nkrebs");
}

