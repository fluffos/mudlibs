/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Auf dem Huegel");
  SetProp(P_INT_LONG, BS(
          "Du stehst auf einer kleinen Lichtung mitten auf dem Huegel, der auf"
	 +" der Insel Aoquin steht. Oestlich sieht man gerade noch eine kleine"
	 +" Luecke. Ansonsten ist hier nur der festgestampfte Boden zu sehen."));
  AddDetail("lichtung", BS(
            "Die Lichtung hier befindet sich mitten auf dem Huegel auf der Insel"
	   +" Aoquin."));
  AddDetail(({"insel", "aoquin"}), BS(
            "Die Insel Aoquin befindet sich in etwa suedoestlich der grossen"
	   +" Steppe."));
  AddDetail("steppe", BS(
            "Von der Steppe bist Du wahrscheinlich hierhergekommen."));
  AddDetail("huegel", BS(
            "Du stehst mitten darauf. Geniess die Aussicht."));
  AddDetail("aussicht", BS(
            "Mist. Wenn hier nicht so viele Baeumen wachsen taeten, koenntest"
	   +" Du viel mehr von der Aussicht geniessen."));
  AddDetail("luecke", BS(
            "Durch diese Luecke scheinst Du geschluepft zu sein."));
  AddDetail(({"baeume", "fichten", "baum", "fichte"}), BS(
            "Durchwegs Fichten wachsen hier und versperren die Aussicht rund um"
	   +" die Insel. Zwischen zweien der Fichten erkennt man noch eine kleine"
	   +" Luecke."));
  AddDetail("boden", BS(
            "Ausgetreten und festgestampft ist der Boden hier. Es scheint, als ob"
	   +" hier oefter jemand steht."));
  AddDetail("himmel", BS(
            "Der Himmel ist nicht zu sehen, da er von den Baeumen komplett"
	   +" verdeckt wird."));
  AddDetail("sonne", BS(
            "Auch wenn sie nicht zu sehen ist, spuerst Du die Waerme, die von"
	   +" ihr ausgeht."));
  AddDetail("waerme", BS(
            "Die Waerme muss von der Sonne kommen."));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht hier gut nach Fichte."));
  AddSmell("fichte", BS(
           "Die Fichte duftet nach Wald und Holz."));
  AddSmell("wald", BS(
           "Im Wald riecht es koestlich nach Baeumen und Rinde und Sonne und..."));
  AddSmell("holz", BS(
           "Du schnupperst begeistert am Holz. Welch herrlicher Geruch!"));
  AddSmell("baeume", BS(
           "So richtig herb und angenehm duften die Baeume hier."));
  AddSmell("rinde", BS(
           "So wie die Baeume riechen, riecht auch im Prinzip die Rinde."));
  AddSmell("sonne", BS(
           "Du glaubst sogar, die Sonne riechen zu koennen."));
  AddSound(DEFAULT_SOUND, BS(
           "Stille, nur einfach Stille. Und das leise Rauschen des Meeres."));
  AddSound(({"rauschen", "meer"}), BS(
           "Das Meeresrauschen klingt hier wie ueberall auf der Insel."));
  AddSound("insel", BS(
           "Die Insel selber ist komplett still."));
  AddSound("stille", BS(
           "Wenn es still ist, dann hoerst Du eigentlich NICHTS."));
  AddSound("nichts", BS(
           "Nichts klingt ungefaehr so: \"               \"."));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_FOREST]));

  AddExit("osten", ROOM("f3"));
  AddItem(NPC("hellorin"), REFRESH_DESTRUCT);
}

