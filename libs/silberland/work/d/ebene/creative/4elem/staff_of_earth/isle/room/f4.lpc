/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Auf dem Huegel");
  SetProp(P_INT_LONG, BS(
          ""));
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30]));

  AddExit("norden", ROOM("f3"));
  AddExit("osten", ROOM("g4"));
}

