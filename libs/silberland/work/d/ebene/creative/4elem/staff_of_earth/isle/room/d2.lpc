/*
  Zone 1: Insel Aoquin
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Insel Aoquin");
  SetProp(P_INT_SHORT, "Auf der Uferpromenade");
  SetProp(P_INT_LONG, BS(
          "Weiter fuehrt der Weg rund um die Insel auf der Uferpromenade."
	 +" Weiter im Nordosten findest Du den noerdlichsten Punkt,"
	 +" was weiter eigentlich nicht so wichtig ist. Ausser dem Meer und"
	 +" der gestrueppartigen Vegetation siehst Du nichts Besonderes."
	 +" Der Himmel ist heute mal wieder richtig tiefblau. Und die Sonne"
	 +" brennt unverschaemt von oben herab."));
  AddDetail(({"insel", "aoquin"}), BS(
            "Hier auf der Insel Aoquin ist nicht viel zu sehen, jedoch gefaellt"
	   +" es Dir wohl gut, sonst waerst Du nicht hier."));
  AddDetail(({"weg", "promenade", "ufer", "uferpromenade"}), BS(
            "Die Uferpromenade fuehrt rund um die Insel."));
  AddDetail("boden", BS(
            "Es liegt Sand am Boden."));
  AddDetail("sand", BS(
            "Wie es so ueblich ist am Meer, liegt am Ufer desselben etwas Sand."));
  AddDetail(({"nordosten", "punkt"}), BS(
            "Im Nordosten gelangst Du zum noerdlichsten Punkt der Insel."));
  AddDetail("westen", BS(
            "Westlich von Dir geht die Uferpromenade weiter in Richtung Steg."));
  AddDetail("steg", BS(
            "Den kannst Du von hier aus nicht sehen."));
  AddDetail(({"richtungen", "norden", "osten", "sueden", "suedwesten", "suedosten", "nordwesten", "richtung"}), BS(
            "Norden, Nordosten, Osten, Suedosten, Sueden, Suedwesten, Westen,"
	   +" Nordwesten, alle noch da."));
  AddDetail("himmel", BS(
            "Wie nicht anders zu erwarten ist er blau. Tiefblau."));
  AddDetail("sonne", BS(
            "Herrje, wie warm es hier doch ist! Etwas Abkuehlung koennte nicht"
	   +" schaden."));
  AddDetail("abkuehlung", BS(
            "Hm. Einmal ins Meer springen und Du bist wieder ein wenig frischer."));
  AddDetail("meer", BS(
            "Das Meer sieht richtig einladend aus. Nicht allzu tief und sicherlich"
           +" herrlich warm."));
  AddDetail("vegetation", BS(
            "Nichts ausser Gestruepp."));
  AddDetail("gestruepp", BS(
            "Du siehst ziemlich dorniges undurchdringbares Gestruepp."));
  AddSmell(DEFAULT_SMELL, BS(
           "Das Meer riecht salzig."));
  AddSmell("meer", BS(
           "Salzig riecht das Meer."));
  AddSound(DEFAULT_SOUND, BS(
           "Ein scheinbar ziemlich grosser Vogel macht einen gewaltigen Laerm."));
  AddSound(({"laerm", "vogel"}), BS(
           "Vielleicht handelt es sich um einen Tukan. Aber Du siehst ihn nicht,"
	  +" folglich kannst Du ihn auch nicht naeher bestimmen."));
  AddSound("tukan", BS(
           "Hoeren kannst Du ihn. Nur leider nicht sehen."));
  AddCmd(({"spring", "springe"}), "jump");
  SetProp(P_LIGHT,1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_PLAIN]));

  AddExit("osten", ROOM("e2"));
  AddExit("suedwesten", ROOM("c3"));
}

jump(str)
{
  notify_fail("Wohin willst Du springen?\n");
  if (str!="ins Meer" && str!="in meer" && str!="meer")
    return 0;
  write(BS(
        "Du huepfst mit einem weiten Satz ins Meer und landest klatschend im Wasser."));
  TP->move(ROOM("bucht"), M_GO, "ins Meer", "huepft", "springt ins Meer und landet klatschend neben Dir");
  return 1;
}
