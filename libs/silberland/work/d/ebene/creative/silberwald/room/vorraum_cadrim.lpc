/*
 * Vorraum zu Cadrim's Seherhaus
*/

#include "../../feldlager/files.h"
inherit "/std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include <combat.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Abseits des kleinen Pfades");
  SetProp(P_INT_LONG, BS(
            "Du gehst einen kleinen Schleichweg am Ufer des Silberteichs entlang. Hohes Gras"
           +" saeumt den Weg, den man eigentlich gar nicht als solchen bezeichnen kann."
           +" Von hier aus hast Du einen herrlichen Ausblick ueber den Teich. Ein paar"
           +" kleine Birken stehen am Wegrand, die so aussehen als waeren sie erst kuerzlich"
           +" gepflanzt worden. Im Westen erkennst Du eine kleine Blockhuette mit einem"
           +" Kraeutergarten davor."));

  AddDetail(({"schleichweg", "weg"}), BS(
            "Du gehst den kleinen Schleichweg am Ufer des Silberteichs entlang."));
  AddDetail("boden", BS(
            "Du befindest Dich auf einem kleinen Schleichweg am Ufer des Silberteiches."));
  AddDetail("ufer", BS(
            "Du befindest Dich am Ufer des Silberteiches. Ein kleiner Schleichweg"
           +" fuehrt hier vom Steg weiter im Osten zu einer kleinen Blockhuette."));
  AddDetail(({"teich", "silberteich"}), BS(
            "Der Silberteich befindet sich noerdlich von Dir. Du siehst ein paar Rohrkolben"
           +" am Ufer stehen, ausserdem kannst Du zwei kleine huebsche Birken erkennen."));
  AddDetail(({"kolben", "rohrkolben"}), BS(
            "Wie Du weisst wachsen schoene Rohrkolben erst nach laengerer Zeit und auch"
           +" nur dann wenn der Teich voellig natuerlich ist."));
  AddDetail("zeit", BS(
            "Hier muss der Teich schon ueber lange Zeit voellig intakt brachgelegen haben,"
           +" sonst koennten hier nicht so schoene Rohrkolben wachsen."));
  AddDetail("steg", BS(
            "Der Steg am Silberteich, von dem man in Richtung Feenschloss weiterreisen"
           +" kann, befindet sich weiter oestlich von hier."));
  AddDetail("richtung", BS(
            "In Richtung Osten befindet sich der Steg, westlich von Dir kannst Du eine"
           +" kleine Blockhuette ausmachen."));
  AddDetail(({"schloss", "feenschloss"}), BS(
            "Weit am anderen Ufer des Silberteiches befindet sich das Feenschloss. Du kannst"
           +" von hier aus nur die Turmzinnen erahnen."));
  AddDetail(({"zinnen", "turmzinnen"}), BS(
            "Weit weit oestlich von hier kannst Du die Turmzinnen des Feenschlosses erahnen."));
  AddDetail("birken", BS(
            "Ein paar kleinere Birken stehen am Ufer des Silberteiches. Es scheint sich um"
           +" Trauerbirken zu handeln, denn die Aeste haengen tief herab. Eine Birke faellt"
           +" Dir besonders auf."));
  AddDetail(({"rand", "wegrand"}), BS(
            "Am Wegrand stehen ein paar Trauerbirken."));
  AddDetail("trauerbirken", BS(
            "Trauerbirken haben tief herabhaengende Aeste."));
  AddDetail("aeste", BS(
            "Die Trauerbirken haben tief herabhaengende Aeste und sehen dadurch richtig traurig aus."));
  AddDetail("birke", BS(
            "Du musterst die Birke genauer und stellst fest, dass sich ein Vogel im Geaest"
           +" wohl ein Nest gebaut haben muss."));
  AddDetail("geaest", BS(
            "Im Geaest einer Birke erkennst Du ein kleines Vogelnest."));
  AddDetail("vogel", BS(
            "Du ueberlegst, ob es sich bei dem Vogel um eine Rohrdommel handeln koennte."));
  AddDetail(({"dommel", "rohrdommel"}), BS(
            "Rohrdommeln leben ueblicherweise am Wasser, aber Du glaubst Dich zu erinnern,"
           +" dass sich Rohrdommeln ihre Nester lieber in Ufernaehe im Schilf bauen."));
  AddDetail(({"nest", "vogelnest"}), BS(
            "Im Geaest der einen Birke siehst Du ein kleines sorgfaeltig geflochtenes Vogelnest."
           +" Der Erbauer muss wohl ausgewaehlte Zutaten verwendet haben."));
  AddDetail("erbauer", BS(
            "Der Erbauer des Nestes war zweifellos ein Vogel."));
  AddDetail("zutaten", BS(
            "Fuer das Vogelnest wurden ausschliesslich erlesene Zutaten ausgewaehlt. Darum"
           +" ist es auch so perfekt geflochten."));
  AddDetail(({"naehe", "ufernaehe"}), BS(
            "So sehr Du Dich bemuehst, Du kannst in Ufernaehe kein Nest einer Rohrdommel erkennen."
           +" Das einzige Nest weit und breit scheint sich auf der Birke zu befinden."));
  AddDetail("schilf", BS(
            "Dichtes Schilf umsaeumt den Silberteich, der dadurch gleich noch viel friedlicher"
           +" zu wirken scheint."));
  AddDetail("wasser", BS(
            "Du biegst ein paar Zweige des Schilfs auseinander und betrachtest das Wasser"
           +" des Silberteichs genauer. Klar und ruhig liegt es vor Dir. Du bekommst Lust, einen"
           +" Zeh in den Teich zu strecken, um zu testen ob das Wasser kalt ist."));
  AddDetail("lust", BS(
            "Du bekommst Lust, einen Zeh in den Teich zu strecken, um zu testen ob das Wasser kalt ist."));
  AddDetail("zweige", BS(
            "Du biegst die Zweige noch weiter auseinander und scheuchst einen kleinen Frosch"
           +" auf, der sofort in den Teich springt, ein paar Schwimmzuege macht und "
           +" daraufhin verschwindet."));
  AddDetail("frosch", BS(
            "Der Frosch ist schon laengst davongeschwommen."));
  AddDetail(({"zuege", "schwimmzuege"}), BS(
            "Du traust Dich nicht, selber ein paar Schwimmzuege zu machen. Eventuell solltest"
           +" Du mal einen Zeh in das Wasser strecken, ob es auch nicht zu kalt ist."));
  AddDetail("zeh", BS(
            "Ein paar davon hast Du ja. Du koenntest einen davon ins Wasser strecken."));
  AddDetail(({"huette", "blockhuette"}), BS(
            "Westlich von hier steht eine kleine schnuckelige Blockhuette aus Holz. An der linken Seite"
           +" kannst Du einen kleinen Kraeutergarten entdecken."));
  AddDetail(({"garten", "kraeutergarten"}), BS(
            "Wenn Du den Kraeutergarten naeher betrachten willst, musst Du schon die"
           +" Huette im Westen betreten."));
  AddDetail("holz", BS(
            "Die Blockhuette ist aus nordischer Fichte gezimmert."));
  AddDetail("fichte", BS(
            "Die nordische Fichte, die fuer die Blockhuette verwendet wurde, scheint wohl aus"
           +" der Gegend von Smoersky zu stammen."));
  AddDetail(({"gegend", "smoersky"}), BS(
            "Du weisst nicht wie Du darauf kommst, aber die nordische Fichte scheint aus der Gegend"
           +" von Smoersky zu stammen."));
  AddDetail("himmel", BS(
            "Unglaublich, der Himmel ist ja ueber Dir."));
  AddDetail("seite", BS(
            "Suedlich der Blockhuette erkennst Du einen Kraeutergarten."));
  AddDetail(({"platz", "brutplatz"}), BS(
            "Der Silberteich ist bestimmt ein guter Brutplatz fuer jede Menge Insekten."));
  AddDetail("insekten", BS(
            "Du willst gar nicht wissen, welche Insekten hier ihr Unwesen treiben und Dich komplett"
           +" zu zerstechen versuchen."));
  AddDetail("menge", BS(
            "Du betrachtest die unglaubliche Menge Insekten und beschliesst: das ist aber eine Menge!"));
  AddDetail("unwesen", BS(
            "Unzaehlige Insekten treiben hier ihr Unwesen und versuchen Dich zu zerstechen."));
  AddDetail("gras", BS(
            "Hohes Gras saeumt den kleinen Weg am Ufer des Silberteichs. Auch Schilf gehoert dazu."));
  AddDetail("kopf", BS(
            "Du greifst Dir an den Kopf um zu sehen ob er noch da ist. Glueck gehabt!"));
  AddDetail("glueck", BS(
            "Na, verlier Deinen Kopf nicht zu schnell!"));
  AddDetail("ausblick", BS(
            "Du blickst ueber den Teich und erkennst in weiter Ferne ein kleines Fischlein, das gerade"
           +" aus dem Teich gesprungen ist."));
  AddDetail("fischlein", BS(
            "Schwupps, da ist das Fischlein schon wieder ins Wasser eingetaucht."));
  AddDetail("ferne", BS(
            "In weiter Ferne siehst Du schon wieder ein Fischlein aus dem Wasser springen."));
  AddDetail(({"vielzahl", "kraeuter"}), BS(
            "Im Kraeutergarten waechst wohl eine Vielzahl an Kraeutern."));
  
  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst das leise Rascheln des Schilfes und das Surren von"
          +" Insekten, die um Deinen Kopf schwirren."));
  AddSound("rascheln", BS(
           "Eine leichte Brise weht durch das Schilf, daher kommt auch das Rascheln."));
  AddSound(({"wind", "brise", "schilf"}), BS(
           "Durch das Schilf weht eine leichte Brise. Du hoerst es rascheln."));
  AddSound("surren", BS(
           "Hier am Ufer des Silberteiches ist ein idealer Brutplatz fuer Insekten, deshalb"
          +" gibt es hier auch Tausende davon."));

  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht nach feuchtem Laub und nach etwas Wuerzigem, das Du nicht sofort einordnen"
          +" kannst."));
  AddSmell("laub", BS(
           "Die Birken die am Ufer stehen haben wohl ein wenig Laub verloren, danach riecht es hier"
          +" ziemlich intensiv."));
  AddSmell("wuerziges", BS(
           "Interessant wuerzige Duefte wehen vom Kraeutergarten herueber."));
  AddSmell(({"duefte", "garten", "kraeutergarten"}), BS(
           "Da muessen wohl eine Vielzahl Kraeuter wachsen, denn Du kannst keine einzelnen Kraeuter"
          +" identifizieren."));

  AddCmd(({"streck", "strecke"}), "water_temp");
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_PLAIN]));

  AddItem("/players/angel/personals/waldi", REFRESH_DESTRUCT, 1);
  
  AddExit("osten", "/d/ebene/ronja/feenquest/room/weg3");
}

water_temp(str) {
  string what, where;
  object *boots;

  notify_fail("Was willst Du wohinein strecken?\n");
  if (!str || str == "")
    return 0;
  if (sscanf(str, "%s in %s", what, where) != 2)
    return 0;
  if (! (what == "zeh" || what == "zehe"))
    return 0;
  if (! (where == "teich" || where == "silberteich" || where == "wasser"))
    return 0;
  boots=TP->QueryArmours(AT_BOOT);
  if (sizeof(boots) > 0) {
    notify_fail("Willst Du etwa Deine "+boots[0]->name(WER)+" nass machen?\n");
    return 0;
  }
  write("Du streckst vorsichtig einen Zeh ins Wasser und quiekst. Das Wasser ist ja soooo [#......] kalt!\n");
  say(TPN+" streckt vorsichtig einen Zeh ins Wasser und quiekt laut!\n");

  return 1;
}

