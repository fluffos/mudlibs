inherit "std/weapon";

#include <language.h>
#include <properties.h>
#include <combat.h>
#include <weapon.h>
#include <material.h>
#include <moving.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();
  SetProp(P_SHORT, "Ein Dornenspeer");
  SetProp(P_LONG, BS(
          "Das ist ein mit fiesen Dornen und Widerhaken besetzter"
          " Speer mit einer Spitze aus Stahl."));
  AddDetail("dornen", BS(
            "Die Dornen hinterlassen sicherlich tiefe Wunden."));
  AddDetail(({"widerhaken", "haken"}), BS(
            "Hoffentlich bringst Du den Speer aus Deinem Gegner"
            " noch heraus, wenn die Widerhaken feststecken."));
  SetProp(P_NAME, "Dornenspeer");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 2400);
  SetProp(P_VALUE, 1500+random(600));
  SetProp(P_MATERIAL, ([MAT_FIR:60, MAT_IRON:15, MAT_STEEL:25]));
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WC, 190);
  SetProp(P_WC_BONUS, (["arachai": 100]));
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_PIERCE}));
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:16, A_DEX:15]));
  SetProp(P_HIT_FUNC, TO);
  AddId("speer");
  AddId("dornenspeer");
}

int HitFunc(object enemy)
{
  int i;
  object *a, o;

  a=filter_objects(enemy->QueryProp(P_ARMOURS), "id", AT_ARMOUR);
  if (!sizeof(a) || sizeof(a) && a[0]->QueryMaterialGroup(MATGROUP_CLOTH)>10) {
    if ((i=random(1000)%80))
      return 40+i;
    else {
      if (!enemy->id("drache") && !enemy->id("skelett") && !enemy->QueryProp(P_GHOST)) {
        TO->DoUnwield(1);
        if (enemy->QueryProp(P_BODY)>200) {
          write(BS("Du triffst "+enemy->Name(WEN)+" an einer sehr verwundbaren Stelle,"
                  +" doch der Dornenspeer prallt von "+enemy->Name(WESSEN)+" Koerper ab."));
          tell_object(enemy, BS(
                       TP->Name(WER)+" trifft Dich an einer verwundbaren Stelle mit"
                     +" seinem Dornenspeer, doch der Speer prallt von Deinem Koerper ab."));
          tell_room(ENV(TP), BS(
                    TP->Name(WER)+" trifft "+enemy->Name(WEN)+" an einer sehr verwundbaren"
                   +" Stelle mit einem Dornenspeer, der jedoch von "+enemy->Name(WESSEN)
                   +" Koerper abprallt."), ({TP, enemy}));
          TP->command_me("lass dornenspeer fallen");
        }
        else {
          write(BS("Du triffst "+enemy->Name(WEN)+" an einer sehr verwundbaren Stelle."
                  +" Der Dornenspeer bleibt in "+enemy->Name(WESSEN)+" Fleisch stecken."));
          tell_object(enemy, BS(
                       TP->Name(WER)+" trifft Dich an einer verwundbaren Stelle mit"
                     +" seinem Dornenspeer, der in Deinem Fleisch steckenbleibt."));
          tell_room(ENV(TP), BS(
                    TP->Name(WER)+" trifft "+enemy->Name(WEN)+" an einer sehr verwundbaren"
                   +" Stelle mit einem Dornenspeer, der sofort in "+enemy->Name(WESSEN)
                   +" steckenbleibt."), ({TP, enemy}));
          o=clone_object(WEAPON("speer2"));
          o->SetProp("nenv", enemy);
          o->move(enemy, M_NOCHECK);
        }
      }
      return 40+1;
    }
  }
}

