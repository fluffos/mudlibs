inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>

#include "../files.h"

void create()
{
  object ob;

  ::create();
  AddId("tiger");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Tiger");
  SetProp (P_SHORT, "Ein huebscher Tiger");
  SetProp(P_RACE, "Tiger");
  SetProp (P_LONG, BS(
           "Das ist ein total lieber Tiger, der aber auch furchtbar boese werden"
          +" kann.")); 

  create_default_npc(12);
  seteuid(getuid(TO));

  SetProp(P_SPELLRATE,15);
  AddDefaultSpell(1, 100, DS_FEAR,
                  "Der Tiger springt Dich an und reisst sein Maul bedrohlich auf.\n",
                  "Der Tiger springt @WEN an und reisst sein Maul bedrohlich auf.\n");

  SetProp(P_DEFAULT_INFO, "knurrt Dich unwillig an.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER)+" will @WEN verschlingen, spuckt es aber wieder aus.\n" }) );

  SetProp(P_SIZE, 120);
  SetProp(P_TRANSPARENT, 0);
  SetAttribute(A_STR, 40);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  while(remove_call_out("react")!=-1) ;
  switch (gruppe) {
    case "fies":
      call_out("react", 0, TP, "faucht Dich laut an", "faucht "+TPN+" laut an"); break;
    case "frech":
      call_out("react", 0, TP, "zeigt Dir hinterhaeltig seine Krallen", "zeigt "+TPN+" seine Krallen"); break;
    case "traurig":
      call_out("react", 0, TP, "kuschelt sich an Dich an und troestet Dich", "troestet "+TPN); break;
    case "neutral":
      call_out("react", 0, TP, "blickt Dich mit seinen schoenen Bernsteinaugen unschluessig an", "schaut "+TPN+" unschluessig an"); break;
    case "nett":
      call_out("react", 0, TP, "schnurrt Dich zufrieden an", "schnurrt "+TPN+" an"); break;
    case "albern":
      call_out("react", 0, TP, "grinst unverschaemt", "grinst unverschaemt"); break;
    case "aengstlich":
      call_out("react", 0, TP, "schmatzt laut", "schmatzt laut"); break;
    case "intim":
      call_out("react", 0, TP, "schmiegt sich unverschaemt kuschlig an Dich an", "schmiegt sich an "+TPN+" an"); break;
    case "froh":
      call_out("react", 0, TP, "grinst", "grinst"); break;
    case "aergerlich":
      call_out("react", 0, TP, "knurrt Dich bedrohlich an", "knurrt "+TPN+" bedrohlich an"); break;
  }
}

void react(object to, string vic, string oth)
{
  if (present(to, ENV(TO))) {
    tell_object(to, BS(Name(WER, 1)+" "+vic+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+oth+"."), ({to}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

