
#include "../files.h"
#include <wizlevels.h>
#include <defines.h>

// Farben

#define COL ({ "roetlich", "blaeulich", "gruenlich", "violett", "silberfarben", "golden", "bronzefarben" })

// Räume

#define RMS ({ ROOM("f1"), ROOM("g1"), ROOM("h1"), ROOM("i1"), ROOM("h2"), ROOM("i3"), ROOM("j3"), \
               ROOM("l3"), ROOM("e5"), ROOM("f6"), ROOM("g6"), ROOM("h6"), ROOM("i5"), ROOM("j5") })

#define TIP ({ "Mauerbrocken", "Kristall", "Granit", "Terracotta", "Steinquader", "Holztor", "Ziegelstein", \
               "Moertel", "Fussabdruecke", "Ritzen", "Steinfliesen", "Spinnweben", "Steintor", "Huegel" })

#define TARGETS (sizeof(COL))

nosave string *col, *rms, *tip, *colors, *rooms, *hints;
nosave string p;
nosave int pressed, t, wrong_order;


void randomize();

void create()
{
  if (is_clone(this_object())) {
    destruct(this_object());
    return;
  }
  SUID;
  randomize();
  return;
}

void randomize() {
  int i, r;
  
  col=COL;
  rms=RMS;
  tip=TIP;
  colors=({ });
  rooms=({ });
  hints=({ });
  p="";
  t=time();
  pressed=0;
  wrong_order=0;
  
  for (i=TARGETS-1; i>=0; i--) {
    r=random(sizeof(col));
    colors+=({ col[r] });
    col-=({ col[r] });
    r=random(sizeof(rms));
    rooms+=({ rms[r] });
    rms-=({ rms[r] });
    hints+=({ tip[r] });
    tip-=({ tip[r] });
  }
  return ;
}

void reset() {
  randomize();
  //::reset();
}

string query_color() {
  int i;

  if ((i=member(rooms, file_name(PO)))>-1)
    return colors[i];
  else
    return "";
}

string query_list() {
  int i, sz;
  string s;

  sz=TARGETS;
  s=" +------------------------------------+\n";
  s+=" |     Lieblingsaufenthalte und       |\n";
  s+=" |         -farben der Tiger          |\n";
  s+=" +------------------------------------+\n";
  for (i=0; i<sz; i++) {
    s+=sprintf(" |  %-15s   %-15s |\n", hints[i], "("+colors[i]+")");
  }
  s+=" +------------------------------------+\n";
  return s;
}

void ready(object ti) {
  if (ti) 
    tell_object(ti, BS("Dich beschleicht das unheimliche Gefuehl, dass noch eine"
	              +" wichtige Aufgabe beim Wasserwerk auf Dich wartet."));
  return ;
}

int press_switch() {
  int m;

  if ((m=member(rooms, file_name(previous_object())))>-1 || IS_ARCH(getuid(TI))) {
    p=set_bit(p, m);
    if (!wrong_order && m==pressed) {
      pressed++;
      if (pressed==7)
	call_out("ready", 2, TI);
      return 1;
    }
    else {
      wrong_order=1;
      return 2;
    }
  }
  return 0;
}

void get_status() {
  int i, sz;
  string s;

  sz=TARGETS;
  s=" +------------------------------------+\n";
  s+=" | pressed in order: "+pressed+"                |\n";
  s+=" | time since reset: "+time2string("%02m:%02s", time()-t)+"            |\n";
  s+=" +------------------------------------+\n";
  for (i=0; i<sz; i++) {
    s+=sprintf(" | %s  %-15s %-15s |\n", (test_bit(p, i)?"+":"-"), explode(rooms[i], "/")[<1], "("+colors[i]+")");
  }
  s+=" +------------------------------------+\n";
  TP->More(s);
  return;
}

int all_ok() {
  return (pressed==7);
}

