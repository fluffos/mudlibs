#include "../files.h"

nosave string *keys;
nosave mapping used;

void create()
{
  if (is_clone(TO)) {
    destruct(TO);
    return;
  }

  keys=({ OBJ("keycd3"), OBJ("keyhi4"), OBJ("keyjk4"),
          OBJ("keyn34"), OBJ("keyl45"), OBJ("keyn45")
       });
  used=([]);
}

void AddFreeKey(string k) {
  string key_fname;
  key_fname=explode(k,"#")[0];
  if(member(keys,key_fname)==-1) {
    keys+=({key_fname});
  }
  return;
}

void CheckKey() {
  string *used_keys;
  int i;
  if(!sizeof(used)) return;
  used_keys=m_indices(used);
  for(i=sizeof(used_keys)-1;i>=0;i--) {
    if(!find_object(used[used_keys[i]])) {
      used=m_delete(used,used_keys[i]);
      AddFreeKey(used_keys[i]);
    }
  }
  return;
}

object DistributeKey()
{
  object ob;
  int i;

  ob=0;
  CheckKey();
  if (sizeof(keys)) {
//    tell_object(find_player("creative"), sprintf("sizeof: %d\n", sizeof(keys)));
    i=random(sizeof(keys));
    ob=clone_object(keys[i]);
    used+=([keys[i]:file_name(previous_object())]);
    keys-=({keys[i]});
  }
  return ob;
}

void RemoveKey(object k)
{
  string key;

  key=file_name(k);
  if(member(keys, key) ==1) return ;
  used=m_delete(used,key);
  AddFreeKey(key);
  return;
}

void DumpSize()
{
  int i;
  string *used_keys;
  printf("Anzahl noch zu verteilender Schluessel: %d\n", sizeof(keys));
  printf("Verteilte Schluessel:\n");
  if(!sizeof(used)) return;
  CheckKey();
  used_keys=m_indices(used);
  for(i=sizeof(used_keys)-1;i>=0;i--) {
    printf(sprintf("Key: %s\t-\t%s\n",used_keys[i],used[used_keys[i]]));
  }
  return ;
}


void DumpAll() {
  int i;
  string *free_keys;
  DumpSize();
  for(i=sizeof(keys)-1;i>=0;i--) {
    printf(sprintf("Key free: %s \n",keys[i]));
  }

  return ; 
}
