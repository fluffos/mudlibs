#include <language.h>
#include <properties.h>
#include "../files.h"

nosave object *helpers, *thieves;

void create()
{
  if (is_clone(TO)) {
    destruct(TO);
    return;
  }
  helpers=({});
  thieves=({});
}

int Help(object vic)
{
//  DEBUG("tmstr", sprintf("helpers -> %O\n",helpers));
  helpers-=({ 0 });
  if (sizeof(helpers))
    call_other(helpers[random(sizeof(helpers))], "Help", vic);
  return 0;
}

void RegisterThief(object t)
{
//  DEBUG("tmstr", sprintf("%O -> thieves\n",t));
  thieves-=({0});
  if (is_clone(t))
    thieves+=({t});
}

void RemoveThief(object t)
{
//  DEBUG("tmstr", sprintf("thieves -> %O\n",t));
  thieves-=({0});
  if (is_clone(t))
    thieves-=({t});
}

void RegisterHelper(object h)
{
//  DEBUG("tmstr", sprintf("%O -> helpers\n",h));
  helpers-=({0});
  if (is_clone(h))
    helpers+=({h});
}

void RemoveHelper(object h)
{
//  DEBUG("tmstr", sprintf("helpers -> %O\n",h));
  if (is_clone(h)) {
    helpers-=({h});
    helpers-=({0});
  }
}

mixed DumpHelpers()
{
  return helpers;
}

mixed DumpThieves()
{
  return thieves;
}

