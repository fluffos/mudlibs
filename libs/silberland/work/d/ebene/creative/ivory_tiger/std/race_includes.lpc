
int customize_race(string race);
#define DWAF ({"/p/weapon/knife/hiebdolch", "/p/weapon/knife/spitzdolch", "/p/weapon/knife/langdolch", "/p/weapon/knife/stilett"})

varargs int customize(int level,int gender, string race ) {
  object ob;

  if(!level) level=random(10)+20;
  if(!gender) gender=MALE;
  if(!race) race="mensch";

  create_default_npc(level);

  SetProp(P_GENDER, gender);
  if(gender==FEMALE) {
    AddId("diebin");
    SetProp(P_SIZE, 150+random(20));
  }  
  else {
    SetProp(P_SIZE, 150+random(40));
    AddId("dieb");
    AddDetail("bart", BS(
            "Der Bart des Diebs bedeckt sein Gesicht komplett."));
    AddDetail("gesicht", BS(
            "Das Gesicht des Diebes ist vollstaendig mit Bart ueberwuchert."));
    AddDetail("guertel", BS(
            "An dem schmalen Lederguertel haengt ein Schluesselbund."));
    AddDetail("schluesselbund", BS(
            "An dem Schluesselbund findest Du fuer jede passende Gelegenheit"
           +" einen Dietrich."));
    AddDetail("dietrich", BS(
         "Mit diesem Dietrich scheint der Dieb jede Tuer knacken zu koennen."));
  }

  if(level>30)      AddId( ({"Messermeister"}) );
  else if(level>20) AddId( ({"Messerexperte"}) );
  else if(level>15) AddId( ({"Messerkaempfer"}) );

  SetProp(P_BODY, level*5+random(40));
  SetProp(P_SPELLRATE,(int)(level*1.5));

  SetProp(P_TRANSPARENT, 0);
  SetProp(P_MAX_HELPERS, 1);
  SetProp(P_HELPERS, QueryProp(P_MAX_HELPERS));
  SetAttribute(A_STR, 40);
  
  customize_race(race);
  
  SetProp(P_DEFAULT_INFO, "ignoriert Dich und blickt sich gestresst um.\n");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Dieb schnappt @WEN und murmelt: 'Wahrscheinlich haette ich es sowieso gestohlen.'\n" }) );
  AddDefaultSpell(1, 300, DS_REDUCE_WC);
  AddDefaultSpell(1, 350, DS_DISARM);

  
  (ob=clone_object("/obj/money"))->SetProp(P_AMOUNT, random(200)+level*2);
  ob->move(TO);
  
  ob=call_other(KEYMASTER, "DistributeKey");
  if (ob)
    ob->move(TO);

  ob=clone_object(DWAF[random(sizeof(DWAF))]);
  ob->move(TO);
  command_me("zuecke Waffe");
}


int customize_race(string race) {
  return call_other(TO, "do_"+lower_case(race));
}


int do_mensch() {
   SetProp(P_BODY, QueryProp(P_BODY)-5);
   SetProp(P_RACE, "Mensch");
   AddId("mensch");
   SetProp(P_SIZE, 165+random(30));
   return 1;
}

int do_elf() {
   SetProp(P_BODY, QueryProp(P_BODY)-0);
   SetProp(P_RACE, "Elf");
   AddId("elf");
   SetProp(P_SIZE, 185+random(30));
   SetProp(P_RESISTANCE_STRENGTHS,
        ([ DT_MAGIC : -0.2,
           DT_HOLY  :  0.1,
           DT_UNHOLY:  0.3 ]) );
   return 1;
}

int do_zwerg() {
   SetProp(P_BODY, QueryProp(P_BODY)+10);
   SetProp(P_RACE, "Zwerg");
   AddId("zwerg");
   SetProp(P_SIZE, 110+random(20));
   SetProp(P_RESISTANCE_STRENGTHS,
       ([ DT_FIRE  : -0.2,
          DT_POISON: -0.4,
          DT_MAGIC :  0.2,
          DT_WATER :  0.4, ]) );
   return 1;
}

int do_hobbit() {
   SetProp(P_BODY, QueryProp(P_BODY)+10);
   SetProp(P_RACE, "Hobbit");
   AddId("hobbit");
   SetProp(P_SIZE, 85+random(20));
   SetProp(P_RESISTANCE_STRENGTHS,
    ([
       DT_TERROR : -0.1,
       DT_MAGIC : -0.1,
       DT_SOUND : 0.2,
       DT_SOUND : 0.2,
       DT_LIGHTNING : 0.1,
       DT_POISON : 0.1 ]));
   return 1;
}



int do_troll() {
   SetProp(P_BODY, QueryProp(P_BODY)+QueryProp(P_LEVEL)/2);
   SetProp(P_SIZE, 330+random(30));
   SetProp(P_RACE, "Troll");
   AddId("troll");
   SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_TERROR    : -0.3,
        DT_AIR       : -0.2,
        DT_MAGIC     :  0.2,
        DT_FIRE      :  0.7,
        DT_LIGHT     :  0.7, 
        DT_LIGHTNING :  0.4,
        DT_MIND      :  0.4]) ) ;
   return 1;
}

int do_oger() {
   SetProp(P_BODY, QueryProp(P_BODY)+10);
   SetProp(P_RACE, "Oger");
   AddId("oger");
   SetProp(P_SIZE, 250+random(30));
   SetProp(P_RESISTANCE_STRENGTHS,
        ([ DT_WATER  : -0.2,
           DT_TERROR :  0.3 ]) );
   return 1;
}

int do_dunkelelf() {
   SetProp(P_SIZE, 180+random(30));
   SetProp(P_RACE, "Dunkelelf");
   AddId("dunkelelf");
   SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_UNHOLY: -0.4,
         DT_LIGHT :  0.6,
         DT_HOLY  :  0.666 ]) );
   return 1;
}
