inherit "obj/container";

#include <container.h>
#include <properties.h>
#include <language.h>
#include <material.h>
#include <moving.h>
#include "../files.h"

create()
{
  object o;

  if (!is_clone(TO))
    return;

  ::create();
  SetProp(P_NAME, "Schatztruhe");
  SetProp(P_SHORT, "Eine Schatztruhe");
  SetProp(P_LONG, BS(
          "Das ist eine schwere Schatztruhe aus Eichenholz. Sie ist"
         +" mit schweren Baendern beschlagen und sieht sehr stabil aus."));
  AddDetail(({"eichenholz", "holz"}), BS(
            "Die Truhe ist aus schwerem alten Eichenholz gefertigt."));
  AddDetail(({"eisenbaender", "baender"}), BS(
            "Die Truhe ist mit schweren Eisenbaendern beschlagen."));
  SetProp(P_MATERIAL, ([MAT_IRON:15, MAT_OAK:85]));
  SetProp(P_WEIGHT, 8000);
  SetProp(P_IVORY, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MAX_WEIGHT, 20000);
  AddId("schatztruhe");
  AddId("truhe");
  SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
  o=clone_object("/obj/money");
  o->SetProp(P_AMOUNT, random(700));
  o->move(TO, M_NOCHECK);
}

