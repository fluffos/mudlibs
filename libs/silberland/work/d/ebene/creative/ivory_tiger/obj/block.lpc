inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <material.h>
#include "../files.h"
#include "../quest.h"

int cnt;

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  AddId(({"notizblock", "block"}));
  AddId(IV_NOTEPAD);
  SetProp(P_SHORT, "Ein kleiner Notizblock");
  SetProp(P_IVORY, 1);
  SetProp(P_NAME, "Notizblock");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_VALUE, 10+random(20));
  SetProp(P_WEIGHT, 200);
  
  cnt=0;
}

int Copy()
{
  if (TP->QueryQuest(IV_QUEST) || present(IV_QUEST_ITEM, TP))  {
    if (cnt)
      return 0;
    return cnt=1;
  }
  else
    return -1;
}

long()
{
  if (cnt)
    return BS(
        "Es handelt sich um einen kleinen Notizblock auf den ein Buch kopiert"
       +" wurde.");
  return BS(
      "Es handelt sich um einen kleinen Notizblock, der nur darauf wartet"
     +" beschrieben zu werden.");
}

int QueryCnt() { return cnt; }

