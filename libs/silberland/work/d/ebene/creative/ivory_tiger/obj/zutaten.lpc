#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Eine urwichtige Zutatenliste von Vannor");
  SetProp(P_LONG, BS(
          "Diese urwichtige Zutatenliste von Vannor enthaelt ein paar schnell"
         +" gekritzelte Notizen von Vannor. Du kannst ihn lesen."));
  SetProp(P_IVORY, 1);
  SetProp(P_READ_MSG,
      "\n +-------------------------------------------+\n"
     +" | Benoetigte Ingredienzien fuer den Balsam: |\n"
     +" |                                           |\n"
     +" |  Moospulver                               |\n"
     +" |  Wasser                                   |\n"
     +" |  Schlangenherzpulver                      |\n"
     +" |                                           |\n"
     +" |  Schlange: Eis- oder Drachenschlange      |\n"
     +" |                                           |\n"
     +" |  Pulver bekommt man durch Zerstossen      |\n"
     +" |  im Moerser                               |\n"
     +" +-------------------------------------------+\n\n");
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 30);
  SetProp(P_NAME, "Zutatenliste");
  SetProp(P_GENDER, FEMALE);
  AddId("zutatenliste");
  AddId("liste");
  AddId(IV_RECIPE_ID);
  AddAdjective(({"urwichtig", "urwichtige"}));
}

