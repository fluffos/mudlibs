inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../files.h"


create() {
  if(is_clone()) destruct(this_object());
  ::create();
}

int WearFunc(object armour) {
  if (armour->QueryProp(P_MAY_WEAR_BALMED)==environment(armour)->query_real_name())
    return 1;
  else {
    tell_object(ENV(armour), BS(armour->Name(WER)+" wurde mit einem magischen"
	+" Balsam behandelt! Nur der Erschaffer darf "+armour->name(WEN)
	+" auch wirklich tragen!\n"));
    return 0;
  }
}

int RemoveFunc(object armour) {
  return 1;
}
