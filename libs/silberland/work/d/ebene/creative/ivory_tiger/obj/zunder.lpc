inherit "std/thing";

#include <language.h>
#include <properties.h>
#include "../files.h"

#define ZUNDER_BURNTIME (20+random(10))

int burning;

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_NAME, "Zunder");
  SetProp(P_IVORY, 1);
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 50);
  SetProp(P_GENDER, MALE);
  AddId("zunder");
  SetProp(P_MATERIAL, ([MAT_WOOL:20, MAT_STRAW:35, MAT_MISC_PLANT:45]));
  burning=0;
}

string _query_short() {
  return "Zunder"+(burning?" (brennend).\n":"");
}

string _query_long() {
  return BS("Das ist ein Zunder. Mit ihm kann man wohl Kohle (in einem geeigneten Gefaess) zum Glimmen bringen."
      +(burning?" Er brennt gerade lichterloh.":""));
}

int remzunder(string owner) {
  object e;

  e=ENV(TO);
  if (e && explode(file_name(e), "#")[0]==OBJ("laterne"))
    e->do_write("Der Zunder in der Laterne flackert noch einmal hell auf und verglimmt.\n");
  else
    write(BS("Der Zunder flackert noch einmal hell auf und verglimmt."));
  if(e=find_player(owner)) {
    e->SetProp("lost_zunder", 1);
  }
  TO->remove();
  return 1;
}

int set_burning(string owner) {
  if (explode(file_name(previous_object()), "#")[0]!=OBJ("laterne"))
    return 1;
  call_out("remzunder", ZUNDER_BURNTIME, owner);
  burning=1;
  return 1;
}

query_burning() {
  return burning;
}

varargs int move(mixed dest, int method) {
  int ret;

  ret=::move(dest, method);
  if (ret==1 && burning && dest->id("Spieler")) {
    tell_object(dest, "Du verbrennst Dir die Finger an dem sehr heissen Zunder!\n");
    dest->do_damage(15);
  }
  return ret;
}

