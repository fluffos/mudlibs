// Generalschluessel

inherit "/std/thing";

#include "../files.h"
#include "../quest.h"
#include <language.h>
#include <properties.h>
#include <wizlevels.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein Generalschluessel");
  SetProp(P_IVORY, 1);
  SetProp(P_LONG, BS(
          "Mit diesem Schluessel kannst Du scheinbar mehr als nur eine Tuer"
         +" sperren."));
  AddId("schluessel");
  AddId(IV_GENERAL_KEY);
  AddId("gkey");
  SetProp(P_WEIGHT, 40);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Schluessel");
}

string *QueryDoorKey()
{
  return ({
	    ROOM("h4")+":"+ROOM("i4"),
	    ROOM("j4")+":"+ROOM("k4"),
	    ROOM("l4")+":"+ROOM("l5"),
	    ROOM("n3")+":"+ROOM("n4"),
	    ROOM("n4")+":"+ROOM("n5"),
	    ROOM("c3")+":"+ROOM("d3"),
	    ROOM("b3")+":"+ROOM("c3"),
	    ROOM("a3")+":"+ROOM("b3"),
	 });
}

remkey() {
  if (ENV(TO))
    tell_object(ENV(TO), "Der Generalschluessel loest sich sofort auf.\n");
  TO->remove();
}

varargs int move(mixed dest, int method) {
  if (dest && dest->id("Spieler") && !IS_WIZARD(dest))
    call_out("remkey", 0);
  return ::move(dest, method);
}

