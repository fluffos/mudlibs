inherit "/std/thing";

#include "../files.h"
#include "../quest.h"
#include <language.h>
#include <properties.h>
#include <thing.h>
#include <material.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein kleiner Holzschluessel");
  SetProp(P_LONG, BS(
          "Auch wenn dieser Holzschluessel recht klobig wirkt, ist er doch sehr"
         +" fein gearbeitet und sicher nicht zu faelschen."));
  AddId("schluessel");
  AddId("holzschluessel");
  AddId(IV_N34_KEY);
  SetProp(P_IVORY, 1);
  SetProp(P_WEIGHT, 80);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_NAME, "Schluessel");
}

string QueryDoorKey()
{
  return ROOM("n4")+":"+ROOM("n5");
}

