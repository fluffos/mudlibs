inherit "/std/thing";

#include "../files.h"
#include "../quest.h"
#include <language.h>
#include <properties.h>
#include <material.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein kleiner unscheinbarer Schluessel");
  SetProp(P_LONG, BS(
          "Dieser Schluessel ist an und fuer sich winzig, aber am Schluesselbart"
         +" erkennst Du eine winzige eingravierte Zeichnung."));
  AddDetail(({"schluesselbart", "bart"}), BS(
            "Am Schluesselbart findest Du eine winzige eingravierte Zeichnung."));
  AddDetail("zeichnung", BS(
            "Die Zeichnung zeigt einen bronzenen Tiger."));
  AddDetail("tiger", BS(
            "Der Tiger sieht furchterregend aus."));
  AddId("schluessel");
  AddId(IV_CD3_KEY);
  SetProp(P_IVORY, 1);
  SetProp(P_WEIGHT, 80);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_BRONCE);
  SetProp(P_NAME, "Schluessel");
}

string QueryDoorKey()
{
  return ROOM("c3")+":"+ROOM("d3");
}

