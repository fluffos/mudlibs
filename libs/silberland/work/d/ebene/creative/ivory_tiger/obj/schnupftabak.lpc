#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Etwas Schnupftabak");
  SetProp(P_LONG, BS(
          "Der Schnupftabak ist vermutlich aus einer Drachenschuppe hergestellt"
         +" worden. Er duerfte schnupfbar sein, allerdings solltest"
         +" Du ihn schleunigst in ein geeignetes Gefaess stecken, sonst verblaest"
         +" ihn noch der Wind!"));
  SetProp(P_NAME, "Schnupftabak");
  SetProp(P_GENDER, MALE);
  SetProp(P_IVORY, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 30);
  AddId("schnupftabak");
  AddId("tabak");
  AddId(IV_SNUFF);
}

check_env() {
  object env;
  string str;

  env=ENV(TO);
  str=BS("Der Schnupftabak wird vom Wind hinfortgeweht.");
  if (env) {
    if (env->id("Raum"))
      write(str);
    else
      tell_object(env, str);
  }
  TO->remove();
}

varargs int move(mixed dest, int method) {
  int ret;

  ret=::move(dest, method);
  if (dest->id(IV_SNUFFBOX))
    remove_call_out("check_env");
  else
    call_out("check_env", 30);
  return ret;
}

