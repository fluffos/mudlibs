inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

#define SPECIAL_CHARS "=+-.,*?!\"%&/()[];:0123456789"
#define VOCALS "aeiouAEIOU"
#define FILTER_CHARS SPECIAL_CHARS+VOCALS

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId("\nwechstabenverbuchsler");
  AddId("\nsprachfluch");
}

init() {
  ::init();
  if(interactive(ENV(ME)))
    ENV(ME)->SetProp(P_PERM_STRING, this_object());
}


string permutate_string (string str) {
  string *words, *pre, *out;
  int i, size, r;

  words=explode(str, " ");
  size=sizeof(words);
  pre=allocate(size);
  for (i=0; i<size-1; i++) {
    pre[i]="";
    while (member(FILTER_CHARS, words[i][0]) == -1) {
      pre[i]+=sprintf("%c", words[i][0]);
      words[i]=words[i][1..];
    }
  }
  pre-=({""});
  words-=({""});
  if (!sizeof(words)) {
    words=pre;
    pre=({});
  }
  out=allocate(size);
//  tell_object(find_player("creative"), sprintf("%O\n\n%O\n\n", words, pre));
  while(sizeof(pre)) {
    i=random(sizeof(words));
    while (words[i]=="" || member(SPECIAL_CHARS, words[i][0]) > -1)
      i=random(sizeof(words));
    r=random(sizeof(pre));
    out[i]=pre[r]+words[i];
    words[i]="";
    pre[r]="";
    pre-=({""});
  }
  for (i=0; i<size-1; i++) {
    if (words[i]!="")
      out[i]=words[i];
  }
  return implode(out, " ");
}

reset() {
  ::reset();
  remove();
}

