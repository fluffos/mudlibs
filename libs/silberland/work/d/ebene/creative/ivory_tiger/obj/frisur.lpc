inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"
#include "/sys/player/description.h"

string e_look;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId(IV_HAIRSTYLE);
  SetProp(P_SHORT, 0);
  
  SetProp(P_NAME, "Frisur");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, MAT_MISC);
  e_look="";
}

varargs void customize(string el, string pl, string col) {
  e_look=el;
  if(col) {
    pl->SetProp(P_TEMP_HAIR_COLOR, col);
  }
  return ;
}

string extra_look() {
  return e_look;
}

varargs int remove(int silent) {
  if(ENV(ME) && living(ENV(ME)))
    ENV(ME)->SetProp(P_TEMP_HAIR_COLOR, 0);
  return ::remove(silent);
}






