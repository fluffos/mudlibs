inherit "/std/thing";

#include "../files.h"
#include "../quest.h"
#include <language.h>
#include <properties.h>
#include <material.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein eiserner Schluessel");
  SetProp(P_LONG, BS(
          "Dieser Schluessel scheint zu einer Falltuer zu gehoeren. Auch wenn"
         +" Du das nur ahnst, bist Du Dir der Sache ziemlich sicher."));
  AddId("schluessel");
  AddId(IV_E5_KEY);
  SetProp(P_IVORY, 1);
  SetProp(P_WEIGHT, 80);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_NAME, "Schluessel");
}

string QueryDoorKey()
{
  return ROOM("e5")+":/d/ebene/creative/feldlager/room/a8_a7";
}

