inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <material.h>
#include "../files.h"
#include "../quest.h"

int cnt;

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  AddId("flasche");
  AddId("wasserflasche");
  AddId(IV_BOTTLE);
  SetProp(P_NAME, "Wasserflasche");
  SetProp(P_IVORY, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, MAT_GLASS);
  
  AddCmd(({"fuell", "fuelle"}), "fill");
  AddCmd(({"trink", "trinke"}), "drink");
  cnt=0;
}

string _query_short()
{
  return sprintf("Eine %s Wasserflasche",
      (cnt?"gefuellte":"leere"));
}

string _query_long()
{
  string str;
  
  str=BS(sprintf("Du betrachtest die Wasserflasche eingehend"
        +" und gelangst zu dem Ergebnis, dass sie %s ist.",
	(cnt?"voll klarem Wasser":"leer")));
  if (!cnt)
    str+="Du koenntest versuchen sie wo zu fuellen.\n";
  return str;
}

_query_weight() { return 400+cnt*1000; }

fill(str)
{
  object e,b;
  string *s;
  
  if (!str)
    return 0;
  s=explode(str, " ");
  if (! (s[0]=="wasserflasche" || s[0]=="flasche"))
    return 0;
  notify_fail("Womit willst Du die Flasche fuellen?\n");
  if (str!="flasche mit wasser" && str != "wasserflasche mit wasser" )
    return 0;
  if (cnt) {
    write("Die Flasche ist doch schon gefuellt!\n");
    return 1;
  }
  if (!((e=ENV(TO)) && (e=ENV(e))) || e!=find_object(ROOM("i6"))) {
    write(BS(
	"Bah, schon der Gedanke hier irgendwo nach verseuchtem Wasser"
       +" suchen zu muessen erscheint Dir widerlich."));
    return 1;
  }
  if (!e->QueryWater()) {
    write(BS(
	"Hier gibt es bestimmt klares Wasser. Bloss wo?"));
    return 1;
  }
  write(BS(
      "Du fuellst die Wasserflasche mit dem klaren Wasser auf."));
  say(BS(
      TPN+" fuellt eine Wasserflasche mit Wasser aus der Wasserleitung."));
  cnt=1;
  if(b=deep_present(IV_QUEST_ITEM, TP))
    b->set_flag(IV_FILL_BOTTLE);
  return 1;
}

drink(str)
{
  notify_fail("Was willst Du trinken?\n");
  if (!str || str!="wasser")
    return 0;
  if (!cnt) {
    write("In der Flasche ist kein Wasser drin.\n");
    return 1;
  }
  cnt=0;
  write("Du trinkst das Wasser aus der Flasche aus.\n");
  TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+2);
  TP->heal_self(1);
  return 1;
}

int QueryCnt() { return cnt; }

int SetCnt(int c) { cnt=c; return cnt; }

