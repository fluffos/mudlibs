#include <language.h>
#include <properties.h>
#include <material.h>
#include <container.h>
#include "../files.h"
#include <moving.h>
#include "../quest.h"

inherit "std/container";

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_NAME, "Schnupftabaksdose");
  SetProp(P_SHORT, "Eine Schnupftabaksdose");
  SetProp(P_IVORY, 1);
  SetProp(P_LONG, BS(
          "Das ist eine Schnupftabaksdose. Auf ihr ist ein kleiner"
         +" Drachen abgebildet. Vermutlich kann man Schnupftabak"
         +" hineinlegen."));
  SetProp(P_INFO, BS(
          "Diese Schnupftabaksdose hat nicht umsonst einen kleinen"
         +" Drachen darauf abgebildet. Du untersuchst die Dose genauer"
         +" und erkennst noch winzige Spuren von Drachenschnupftabak"
         +" darin."));
  SetProp(P_WEIGHT, 180);
  SetProp(P_MAX_WEIGHT, 300);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_BRONCE:100]));
  AddId("tabaksdose");
  AddId("schnupftabaksdose");
  AddId("tabakdose");
  AddId("dose");
  AddId("schnupftabakdose");
  AddId(IV_SNUFFBOX);
  AddDetail(({"schnupftabak", "tabak", "drachenschnupftabak"}), BS(
            "Drachenschnupftabak stellt man aus einer Drachenschuppe her,"
           +" die man in einem geeigneten Moerser zerstampfen kann."));
  SetProp(P_VALUE, 20);
  AddCmd(({"schnupf", "schnupfe"}), "snuff");
}

PreventInsert(object o)
{
  if (o->id(IV_SNUFF) && !present(IV_SNUFF, TO))
    return 0;
  return 1;
}

snuff(str)
{
  object o;

  notify_fail("Was moechtest Du schnupfen?\n");
  if (!str)
    return 0;
  if (member( ({"tabak", "schnupftabak", "drachenschnupftabak"}), str) == -1)
    return 0;
  if (!(o=present(IV_SNUFF, TO))) {
    write(BS(
          "Aber da ist doch gar kein Schnupftabak drin, den Du schnupfen koenntest."));
    return 1;
  }
  write(BS(
      "Du schuettelst den Inhalt der Tabaksdose auf Deinen Handruecken"
     +" und ziehst kraeftig die Nase dabei hoch. Alles kribbelt und es"
     +" fuehlt sich an als ob eine ganze Heerschaar von Ameisen Deine"
     +" Luftwege entlangwandert. Du bist ein bisschen benommen, fuehlst"
     +" Dich aber waehrenddessen wie ein Drache! Gerade als Du das Gefuehl"
     +" ein Drache zu sein zu geniessen beginnst, ist der ganze Spuk"
     +" schon wieder vorbei. Du fragst Dich, was das ganze soll..."
     +" Vielleicht ist der Tabak ja doch nicht fuer Dich geeignet."));
  o->remove();
  return 1;
}


