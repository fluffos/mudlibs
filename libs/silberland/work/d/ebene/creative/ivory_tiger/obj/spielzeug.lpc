inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  AddAdjective("kleines");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_VALUE, 10+random(20));
  SetProp(P_WEIGHT, 100+random(50));
  SetProp(P_GENDER, NEUTER);
  AddId("modell");
  customize();
}

customize() {
  string *toys, *wood;
  int i, *gend;

  toys=({ "Ochsenkarren", "Pferdewagen", "Zweihaender", "Bierkrug", "Drachenpanzer", "Peitsche",
          "Morgenstern", "Segelyacht", "Galeere", "Kirchenglocke", "Schaufel", "Blockhuette",
          "Gartenzaun", "Lastenballen"});
  wood=({ MAT_BEECH, MAT_PEAR_WOOD, MAT_OAK, MAT_EBONY, MAT_FIR, MAT_TEAK, MAT_BALSA,
          MAT_BIRCH_WOOD, MAT_ELM_WOOD, MAT_YEW_WOOD, MAT_ASH_WOOD, MAT_TICTOC_WOOD });
  gend=({ MALE, MALE, MALE, MALE, MALE, FEMALE, MALE, FEMALE, FEMALE, FEMALE, FEMALE,
          FEMALE, MALE, MALE });
  i=random(sizeof(toys));
  SetProp(P_NAME, "Modell eine"+(gend[i]==FEMALE?"r":"s")+" "+toys[i]+(gend[i]==FEMALE?"":"s"));
  SetProp(P_SHORT, "Ein "+QueryProp(P_NAME)+" aus Holz");
  AddId(lower_case(toys[i]));
  i=random(sizeof(wood));
  SetProp(P_MATERIAL, wood[i]);
}

start_remove() {
  if (find_call_out("end_remove")==-1)
    call_out("end_remove", 60);
}

end_remove() {
  object e;
  string str;

  e=ENV(TO);
  if (e) {
    str=BS(Name()+" faellt komplett auseinander, da ein wichtiges Einzelteil gefehlt hat.");
    if (e->id("Raum"))
      tell_room(e, str);
    else if (e->id("Spieler"))
      tell_object(e, str);
  }
  TO->remove();
}

string long() {
  string s;

  s="Das ist "+name()+". Es wurde scheinbar aus mehreren Einzelteilen"
         +" zusammengesetzt und besteht aus Holz.";
  if (find_call_out("end_remove")!=-1)
    s+=" Es sieht ziemlich wacklig aus und kann jeden Moment zusammenbrechen.";
  return BS(s);
}

