inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>
#include <material.h>
#include "../files.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_NAME, "Schokokokosnuss");
  SetProp(P_SHORT, "Eine Schokokokosnuss");
  AddId("kokosnuss");
  AddId("schokokokosnuss");
  SetProp(P_LONG, BS(
      "Die Schokokokosnuss besteht aussen aus reiner Schokolade, vielleicht solltest"
     +" Du sie ja mal essen, damit Du den Geschmack erst so richtig geniessen kannst!"));
  SetProp(P_INFO, BS(
          "Dir ist, als ob die Schokokokosnuss eine Ueberraschung in sich bergen wuerde."));
  AddDetail("ueberraschung", BS(
            "Um an die Ueberraschung zu kommen, musst Du die Schokokokosnuss schon aufessen!"));
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1),
  SetProp(P_FOOD_INFO, ([ 
      F_HEAL:random(5)+1, F_SOAK:10, F_DRINK:5,
      F_MSG:"Du beisst vorsichtig in die Schokokokosnuss und geniesst den ersten zarten Geschmack.\n",
      F_MSG_ROOM:"schlingt eine Schokokokosnuss hinunter.\n" ]));
  SetProp(P_WEIGHT, 250+random(100));
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:60, MAT_MISC_DRUG:5, MAT_FRUIT:35]));
  SetProp(P_GENDER, FEMALE);
}

void Eating(object pl) {
  object o;
  int i;

  i=random(7);

  switch(i) {
    case 2: write("Du findest in der Schokokokosnuss ... NICHTS. Schade eigentlich.\n"); return;
    case 3: write(BS("Ui, Glueck gehabt, Du hast eine der ganz seltenen Ueberraschungen gefunden!"));
            o=clone_object(OBJ("erzmagierstatue"));
            write("Es ist "+o->name(WER)+".\n");
            tell_room(ENV(pl), pl->Name()+" findet in der Schokokokosnuss eine seltene Ueberraschung!!!\n", ({ pl }));
            break;
    default: write("Du findest in der Schokokokosnuss eine kleine Ueberraschung.\n");
             o=clone_object(OBJ("bausatz"));
             write("Es ist "+o->name(WER)+".\n");
             tell_room(ENV(pl), pl->Name()+" findet in der Schokokokosnuss eine Ueberraschung!\n", ({ pl }));
  }
  if (o && o->move(pl)!=1) {
    write("Du laesst "+o->name(WER)+" fallen.\n");
    o->move(ENV(pl));
  }
}

