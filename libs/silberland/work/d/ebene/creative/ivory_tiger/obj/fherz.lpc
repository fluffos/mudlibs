inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>
#include <material.h>
#include "../files.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_NAME, "Feuerherz");
  SetProp(P_SHORT, "Das Feuerherz einer Feuerschlange");
  SetProp(P_IVORY, 1);
  AddId("herz");
  AddId("feuerherz");
  AddId(IV_HEART);
  SetProp(P_LONG, BS(
      "Dieses Feuerherz der Feuerschlange strahlt noch eine gewisse Hitze"
     +" aus und scheint noch ein wenig zu pulsieren. Es hat einen leicht"
     +" roetlichen Farbstich, und Dir graust davor, daran zu denken,"
     +" dass man es vielleicht essen koennte."));
  SetProp(P_INFO, BS(
      "Das Feuerherz, einmal zu Pulver zerstampft, mag Dir noch sehr nuetzlich"
     +" erscheinen. Ausserdem kann man es essen."));
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1),
  SetProp(P_FOOD_INFO, ([ 
      F_HEAL:({50, 35}), F_SOAK:22, F_DRINK:17,
      F_MSG:"Du wuergst das Feuerherz hinunter, fuehlst Dich aber seltsam regeneriert.\n",
      F_MSG_ROOM:" wuergt ein Feuerherz hinunter.\n" ]));
  SetProp(P_WEIGHT, 140);
  SetProp(P_MATERIAL, ([MAT_FLESH:90, MAT_BLOOD:10, MAT_FIRE:100]));
  SetProp(P_GENDER, NEUTER);
}

