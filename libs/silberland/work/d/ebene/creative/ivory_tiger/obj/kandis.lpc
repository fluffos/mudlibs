inherit "std/thing";

#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"


create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_NAME, "Brocken Kandiszucker");
  SetProp(P_NAME_ADJ, "gross");
  SetProp(P_SHORT, "Ein grosser Brocken Kandiszucker");
  SetProp(P_LONG, BS(
       "Ein grosser Brocken Kandiszucker. Viel zu gross fuer eine Tasse."
      +" Was man damit wohl machen kann?"));
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 150);
  SetProp(P_GENDER, MALE);
  SetProp(P_IVORY, 1);
  AddId("kandiszucker");
  AddId("zucker");
  AddId("brocken");
  AddId("kandis");
  AddId(IV_CANDY);
  SetProp(P_IVORY, 1);
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  AddAdjective(({"grosser", "grossen"}));
}

