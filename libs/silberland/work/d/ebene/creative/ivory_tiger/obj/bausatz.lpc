inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Ein kleiner Holzbausatz");
  SetProp(P_LONG, BS(
          "Diesen Bausatz solltest Du einmal zusammensetzen! Du kannst Dir"
         +" einfach noch nicht vorstellen, was aus den Einzelteilen entstehen"
         +" koennte."));
  AddDetail(({"einzelteile", "teile"}), BS(
          "Die Einzelteile ergeben keinen Sinn. Versuch doch mal den Bausatz"
         +" zusammenzusetzen, vielleicht siehst Du dann klarer."));
  SetProp(P_NAME, "Holzbausatz");
  AddAdjective("kleiner");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_VALUE, 10+random(20));
  SetProp(P_WEIGHT, 100+random(50));
  AddId("bausatz");
  AddId("holzbausatz");
  AddCmd(({"setze", "setz"}), "build");
}

build(str) {
  int i;

  notify_fail("Was willst Du zusammensetzen?\n");
  if (!str)
    return 0;
  if (str=="")
    return 0;
  if (!(str=="bausatz zusammen" || str=="holzbausatz zusammen"))
    return 0;
  if (find_call_out("build2")!=-1)
    return 0;
  write(BS("Du legst alle Einzelteile vor Dir hin und versuchst vorsichtig, den"
       +" Bausatz zusammenzusetzen."));
  tell_room(ENV(TP), BS(TP->Name()+" legt ein paar Einzelteile eines Bausatzes vor sich hin und"
      +" versucht ihn zusammenzusetzen."), ({TP}));
  i=(random(5)>3);
  if (!i)
    write(BS("Mist, da war wohl ein Teil zu wenig in der Schokokokosnuss!"));
  call_out("build2", 3+random(3), i, TP);
  return 1;
}

build2(int success, object plr) {
  if (success) {
    write("Du setzt die Einzelteile spielend leicht aneinander.\n");
    tell_room(ENV(plr),
        plr->Name()+" setzt die Einzelteile des Bausatzes spielend leicht aneinander.\n", ({plr}));
    call_out("build3", 3, success, plr);
  }
  else {
    write("Du muehst Dich heftig ab, die Einzelteile aneinanderzusetzen.\n");
    tell_room(ENV(plr),
        plr->Name()+" mueht sich ab, die Einzelteile eines Bausatzes aneinanderzusetzen.\n", ({plr}));
    call_out("build3", 8, success, plr);
  }
}

build3(int success, object plr) {
  object o;

  o=clone_object(OBJ("spielzeug"));
  write(BS("Gratuliere! Du hast ein "+o->name()+" zusammengebastelt und stellst es begeistert"
          +" vor Dir auf den Boden."));
  tell_room(ENV(plr), BS(plr->Name()+" hat ein "+o->name()+" zusammengebastelt und stellt es begeistert"
           +" vor sich auf den Boden hin."), ({plr}));
  if (!success) {
    write(BS("Leider hat Dir ein Einzelteil gefehlt, drum sieht das Endresultat etwas wacklig aus..."));
    tell_room(ENV(plr), BS("Ein Einzelteil fehlte wohl bei dem Bausatz, drum sieht das Resultat etwas"
             +" wacklig aus."), ({plr}));
    tell_room(ENV(plr), BS("Du grinst insgeheim."), ({plr}));
    o->start_remove();
  }
  else
    write(BS("Ein wunderschoenes Resultat. Du freust Dich."));
  o->move(ENV(plr));
  TO->remove();
}

