inherit "/std/thing";

#include <language.h>
#include <properties.h>
#include "../files.h"
#include "../quest.h"

#define ARCH_WIZARDS ({ "Dusty", "Woody", "Angrox", "Creative", "Feyaria", "Zordan", "Cirion" })
#define PROBABILITY  ({ 5, 1, 2, 3, 4, 6, 7 })

string wiz_name;

create() {
  int i, j;
  string *w;

  if (!is_clone(TO))
    return;

  ::create();

  w=({});
  for (i=sizeof(ARCH_WIZARDS)-1; i>=0; i--) {
    for (j=PROBABILITY[i]; j>=0; j--)
      w+=({ ARCH_WIZARDS[i] });
  }
  wiz_name=w[random(sizeof(w))];
  SetProp(P_NAME, wiz_name+"statue");
  SetProp(P_SHORT, "Eine kleine "+wiz_name+"statue");
  SetProp(P_LONG, BS("Du siehst eine stattliche Statue von "+wiz_name+"."
         +" Das Abbild von "+wiz_name+" steht auf einem kleinen Sockel aus"
         +" Ebenholz, und besteht aus purem Gold. Die Augen von "+wiz_name
         +" sind durch kleine eingearbeitete Diamanten ersetzt. Die Statue ist"
         +" ziemlich gross und auch ganz schoen schwer."));
  SetProp(P_INFO, BS("Die Statue scheint ziemlich wertvoll zu sein, nicht nur im"
         +" Gegenwert von Muenzen betrachtet. Eventuell solltest Du versuchen,"
         +" alle Statuen dieser Art zu sammeln und sie an der richtigen Stelle"
         +" abzugeben."));
  SetProp(P_VALUE, 200+random(500));
  SetProp(P_WEIGHT, 1000+random(1000));
  SetProp(P_GENDER, FEMALE);
  AddId("statue");
  AddId(lower_case(wiz_name)+"statue");
  SetProp(P_MATERIAL, ([MAT_EBONY:19, MAT_GOLD:80, MAT_DIAMOND:1]));
}

