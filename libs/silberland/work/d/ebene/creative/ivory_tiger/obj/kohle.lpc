inherit "std/thing";

#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"

#define COAL_BURNTIME (360+random(120))

int burning;

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_NAME, "Kohlestueck");
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 150);
  SetProp(P_GENDER, NEUTER);
  AddId("stueck");
  AddId("kohlestueck");
  AddId("kohle");
  SetProp(P_IVORY, 1);
  SetProp(P_MATERIAL, MAT_CARBON);
  burning=0;
}

string _query_short() {
  return "Ein Stueck Kohle"+(burning?" (glimmend).\n":"");
}

string _query_long() {
  return BS("Das ist ein kleineres Stueck Kohle."+(burning?" Es glimmt gerade froehlich vor sich hin.":""));
}

remkohle() {
  object e;

  e=ENV(TO);
  if (e && explode(file_name(e), "#")[0]==OBJ("laterne"))
    e->do_write("Das Stueck Kohle in der Laterne leuchtet noch einmal hell auf und verglimmt vollends.\n");
  else {
    if (e->id("Raum"))
      tell_room(e, "Das Stueck Kohle leuchtet noch einmal hell auf und verglimmt vollends.\n");
    else
      tell_object(e, "Das Stueck Kohle leuchtet noch einmal hell auf und verglimmt vollends.\n");
  }
  TO->remove();
}

set_burning() {
  if (explode(file_name(previous_object()), "#")[0]!=OBJ("laterne"))
    return;
  call_out("remkohle", COAL_BURNTIME);
  burning=1;
}

query_burning() {
  return burning;
}

scream(object dest) {
  tell_object(dest, "Du verbrennst Dir die Finger an dem heissen Kohlestueck und wirfst es gleich weg.\n");
  tell_room(ENV(dest), dest->Name()+" schreit laut und wirft ein glimmendes Kohlestueck weg.\n", ({dest}));
}

varargs int move(mixed dest, int method) {
  int ret;

  ret=::move(dest, method);
  if (ret==1 && burning && dest->id("Spieler")) {
    call_out("scream", 0, dest);
    dest->AddHp(-5);
    call_out("move", 0, ENV(dest), M_PUT);
  }
  return ret;
}

