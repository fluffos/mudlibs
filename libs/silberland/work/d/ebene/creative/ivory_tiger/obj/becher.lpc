inherit "std/container";

#include <properties.h>
#include <container.h>
#include <language.h>
#include <food.h>
#include <material.h>
#include "../files.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_NAME, "Saufbecher");
  SetProp(P_SHORT, "Ein goldener Saufbecher");
  SetProp(P_IVORY, 1);
  AddId("becher");
  AddId("saufbecher");
  AddId(IV_BOOZE_MUG);
  SetProp(P_LONG, BS(
      "Dieser goldene Saufbecher wird bei der jaehrlichen Saufmeisterschaft in Heriolfs Trinkhalle"
     +" vergeben."));
  SetProp(P_VALUE, 2000);
  SetProp(P_WEIGHT, 850);
  SetProp(P_MAX_WEIGHT, 1000);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_GENDER, MALE);
  SetProp(P_NOSELL, "Diesen Becher kannst Du nicht verkaufen, schliesslich hast du die Meisterschaft"
                   +" nicht gewonnen!\n");
  CLONEME(OBJ("notiz"));
}

PreventInsert(object o) {
  return 1;
}

