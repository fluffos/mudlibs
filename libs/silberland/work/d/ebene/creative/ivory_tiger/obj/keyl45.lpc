inherit "/std/thing";

#include "../files.h"
#include "../quest.h"
#include <language.h>
#include <properties.h>
#include <material.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein Schluessel aus Stahl");
  SetProp(P_LONG, BS(
          "Ein fein ziselierter gut gearbeiteter Stahlschluessel der scheinbar"
         +" nur in eine Stahltuer passen kann."));
  AddId("schluessel");
  AddId("stahlschluessel");
  AddId(IV_L45_KEY);
  SetProp(P_IVORY, 1);
  SetProp(P_WEIGHT, 80);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_STEEL);
  SetProp(P_NAME, "Schluessel");
}

string QueryDoorKey()
{
  return ROOM("l4")+":"+ROOM("l5");
}

