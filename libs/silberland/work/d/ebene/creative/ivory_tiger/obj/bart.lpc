inherit "/std/armour";

#include <armour.h>
#include <combat.h>
#include "../files.h"
#include "../quest.h"
#include <properties.h>
#include <language.h>
#include <material.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();

  AddId("bart");
  AddId(IV_BEARD);
  SetProp(P_NAME, "Bart");
  SetProp(P_IVORY, 1);
  SetProp(P_SHORT, "Ein falscher Bart");
  SetProp(P_LONG, BS(
          "Das ist ein falscher Bart, den man sich anziehen kann, um"
         +" damit ziemlich doof auszusehen."));
  SetProp(P_INFO, BS(
          "Vielleicht kann man sich mit dem Bart verkleiden, um sich"
         +" ein wenig zu verfremden. Anziehen genuegt."));
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_HAIR);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
}

string extra_look()
{
  if (TO->QueryWorn())
    return "Mit diesem falschen Bart sieht "+ENV(TO)->Name(WER)
          +" reichlich doof aus.\n";
  return "";
}

