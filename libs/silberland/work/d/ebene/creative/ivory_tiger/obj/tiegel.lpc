  string po;

  po=explode(file_name(previous_object()), "#")[0];
  
  if (!IS_ARCH(previous_object()) && po!="/d/dschungel/feyaria/tijara/npc/elsurion" && po!=NPC("moench"))
    return "";
  return owner;
}
*/
int set_owner(string str) {
  owner=str;
  return 1;
}

string query_owner() {
  return owner;
}

