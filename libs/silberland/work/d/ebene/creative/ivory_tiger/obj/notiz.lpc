#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Eine kleine unscheinbare Notiz");
  SetProp(P_LONG, BS(
          "Du koenntest versuchen die Notiz zu lesen."));
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 25);
  SetProp(P_IVORY, 1);
  SetProp(P_NAME, "Notiz");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_READ_MSG, BS(
          "Du erkennst auf der kleinen Notiz eine gezeichnete Anleitung, wie man aus"
         +" einer Krawattennadel einen Dietrich bastelt."));
  AddId("notiz");
  AddId(IV_LOCKPICKNOTE);
  AddAdjective(({"unscheinbare", "kleine"}));
  AddCmd(({"bastle", "bastel"}), "proceed");
}

proceed(str) {
  object o;

  notify_fail("Was willst Du woraus basteln?\n");
  if (!str)
    return 0;
  if (str =="")
    return 0;
  if (member(({ "dietrich aus krawattennadel", "dietrich aus nadel", "dietrich" }), str) == -1)
    return 0;
  o = deep_present(IV_TIE_PIN, TP);
  if (!o) {
    write("Du musst schon eine Krawattennadel bei Dir haben!\n");
    return 1;
  }
  write(BS("Du schaust Dir die Anleitung noch einmal genau an und bastelst haaregenau"
          +" nach der Anleitung einen Dietrich. Leider faellt Dir der Zettel beim"
          +" Verknoten der Finger hinunter und verschwindet auf Nimmerwiedersehen."
          +" Da Du die Anweisungen auf der Notiz nicht bis ganz zu Ende geschafft hast,"
          +" passt der Dietrich wohl nur in ganz wenige Schloesser."));
  say(BS(TP->Name()+" verknotet seine Finger, als er an einer Krawattennadel herumbiegt."));
  o->remove();
  o=clone_object(OBJ("keyl45"));
  o->move(TP, M_NOCHECK);
  IV_LOGQUEST(getuid(TP), "Dietrich gebastelt");
  call_out("remove", 0);
  return 1;
}

