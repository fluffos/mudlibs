inherit "std/thing";

#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"


create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_NAME, "Kandiszuckerwuerfel");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_SHORT, "Ein kleiner Kandiszuckerwuerfel");
  SetProp(P_LONG, BS(
       "Ein kleiner Kandiszuckerwuerfel. Eigentlich ideal um damit eine Tasse"
      +" Tee zu suessen."));
  SetProp(P_VALUE, 1);
  SetProp(P_WEIGHT, 15);
  SetProp(P_GENDER, MALE);
  SetProp(P_IVORY, 1);
  AddId("kandiszuckerwuerfel");
  AddId("zuckerwuerfel");
  AddId("wuerfel");
  AddId("kandis");
  AddId(IV_CANDY_SMALL);
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  AddAdjective(({"kleiner", "kleinen"}));
}

