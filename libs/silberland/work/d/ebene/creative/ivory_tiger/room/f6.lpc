/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

int viech, ding;

create()
{
  ::create();

  SetProp(P_ZONE, "Suedlicher Wehrturm");
  SetProp(P_INT_SHORT, "Wegbiegung");

  SetProp(P_INT_LONG, BS(
          "Du stehst an einer Wegbiegung im suedlichen Wehrturm, obwohl man"
         +" eigentlich hier nicht von einer Wegbiegung sprechen kann nachdem"
         +" Du ja unter der Erde in einem Gebaeude bist. Trotzdem fuehrt der"
         +" Weg hier von Osten kommend nach Nordwesten."));
  AddDetail("boden", BS(
            "Der Boden ist richtiggehend oed, so genau Du ihn Dir auch anschaust,"
           +" er bietet keinerlei Geheimnisse."));
  AddDetail(({"geheimnis", "geheimnisse"}), BS(
            "Sehr geheim scheint es hier nicht zu sein. Nichts ist zu sehen,"
           +" was auch nur den Anschein machen koennte, geheim zu sein."));
  AddDetail("nichts", BS(
            "Nichts zu untersuchen ist ja nicht sehr sinnvoll."));
  AddDetail("decke", BS(
            "Jawohl, eine Decke ober Dir gibts. Aber recht viel bietet sie"
           +" nicht, was es zu untersuchen gaelte. Halt Dich lieber mit"
           +" Deinem Blick etwas tiefer."));
  AddDetail("blick", BS(
            "Um Deinen Blick zu betrachten braeuchtest Du schon einen Spiegel."));
  AddDetail("spiegel", BS(
            "Einen Spiegel findest Du hier irgendwo. Nur nicht konkret hier."));
  AddDetail(({"wand", "waende"}), BS(
            "Sehr interessant scheint die noerdliche Mauer zu sein. Vielleicht"
           +" solltest Du da mal genauer schauen."));
  AddDetail(({"mauern", "mauer"}), BS(
            "Am interessantesten erscheint Dir die noerdliche Mauer."));
  AddDetail("noerdliche mauer", BS(
            "Die noerdliche Mauer besteht natuerlich aus Ziegeln und"
           +" dazwischen gibt es eine Menge Ritzen und Fugen."));
  AddDetail("ziegeln", BS(
            "Alle Mauern rund um Dich sind gemauert und bestehen daher aus"
           +" Ziegeln."));
  AddSpecialDetail("ritzen", "ritze");
  AddDetail("moertel", BS(
            "Natuerlich sind diese Mauern mit Moertel gemauert."));
  AddDetail("festigkeit", BS(
            "Du probierst die Festigkeit der Mauern aus, indem Du heftig an"
           +" die Mauern klopfst. Ok, es gibt nichts daran auszusetzen."));
  AddSpecialDetail("fugen", "fuge");
  AddSpecialDetail("tier", "animal");
  AddSpecialDetail("ding", "thing");
  AddDetail("erde", BS(
            "Sehr richtig, Du befindest Dich unter der Erde."));
  AddDetail(({"wehrturm", "turm"}), BS(
            "Der suedliche Wehrturm ist noch gut erhalten, trotz seines Alters."));
  AddDetail("alter", BS(
            "Auch wenn Du nicht versuchen willst, das Alter zu schaetzen, eine"
           +" ganz schoen lange Zeit ist es bestimmt her, dass diese Mauern"
           +" gebaut wurden."));
  AddDetail("zeit", BS(
            "Es ist bestimmt schon lange her, dass dieser Wehrturm entstanden ist."));
  AddDetail("gebaeude", BS(
            "Du stehst in einem alten Wehrturm, der Teil einer Festung war."));
  AddDetail(({"teile", "teil"}), BS(
            "Ein Teil ist eben nix Ganzes."));
  AddDetail("ganzes", BS(
            "Ein Ganzes besteht aus Teilen."));
  AddDetail("anschein", BS(
            "Allem Anschein nach scheint es nicht viel geheimes hier zu geben."));
  AddDetail("festung", BS(
            "Der suedliche Wehrturm ist Teil einer alten Festung, die allerdings im"
           +" Ganzen nicht mehr zu existieren scheint."));
  AddDetail( ({"ganzen"}),
      "Aber ein paar Teile sind uebrig geblieben.");
  AddDetail( ({"teile"}),
      "Die siehst Du hier. Der suedliche Wehrturm zum Beispiel.");
  AddDetail( ({"beispiel"}),
      "Es gibt dafuer auch sicher noch andere Beispiele.");
  AddDetail( ({"beispiele"}),
      "Beispiele von der alten Festung natuerlich.");
  AddDetail("weg", BS(
            "Von Weg kann man eigentlich nicht sprechen, da Du ja in einem"
           +" Gebaeude stehst und somit handelt es sich eher um einen Gang."));
  AddDetail("gang", BS(
            "Du stehst in einem Gang. Aber trotzdem wuerdest Du eher von einer"
           +" Wegbiegung sprechen als von einer Gangbiegung."));
  AddDetail(({"gangbiegung", "wegbiegung", "biegung"}), BS(
            "Der Weg macht hier eine Biegung von Osten nach Nordwesten."));

  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst ein eigenartiges Kratzen."));
  AddSound("kratzen", BS(
           "Du kannst Dir nicht erklaeren, woher das Kratzen kommen mag."
          +" Nachdem Du genauer hingehorcht hast, stellst Du fest, dass"
          +" es direkt von der Mauer kommt die Du noerdlich von Dir"
          +" siehst."));
  AddSound("mauer", BS(
           "Du legst Dein Ohr an die Mauer und lauscht ganz genau, was Du"
          +" da alles zu hoeren kriegst. Ausser dem Kratzen ist nichts zu"
          +" hoeren, aber dafuer ist dieses Geraeusch aeusserst deutlich."));
  AddSound("geraeusch", BS(
           "Wirklich ein eigentuemliches Geraeusch, dieses Kratzen. Vielleicht"
          +" solltest Du die noerdliche Mauer einmal etwas genauer untersuchen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Irgendwie riecht es ein wenig vermodert hier."));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("nordwesten", ROOM("e5"));
  AddExit("osten", ROOM("g6"));
  AddCmd(({"klopfe", "klopf"}), "knock");
  AddCmd(({"drueck", "druecke"}), "press");

  viech=0;
  ding=0;
}

knock(str)
{
  notify_fail("Woran willst Du klopfen?\n");

  if (!str || str=="")
    return 0;
  if (str!="an mauer" && str!="an noerdlicher mauer" && str!="an noerdliche mauer")
    return 0;

  if (!viech) {
    write(BS(
          "Du klopfst heftig an die noerdliche Mauer und brichst Dir fast"
         +" den Zeigefinger dabei ab. Doch scheinbar war Dein Klopfen von"
         +" Erfolg gekroent. Aus einer der Fugen broeselt etwas Moertel"
         +" herunter, und dahinter kannst Du ein winziges Tier sehen."));
    viech=1;
    ding=1;
    return 1;
  }
  write(BS(
        "Du klopfst heftig an die noerdliche Mauer. Autsch, net so fest."));
  return 1;
}

reset()
{
  viech=0;
  ding=0;
  ::reset();
}

fuge()
{
  if (!viech)
    return BS("Zwischen den Ziegeln befinden sich natuerlich einige"
             +" Fugen.");
  ding=1;
  return BS("Oh, Du siehst eine Fuge, bei der der Moertel herausgebrochen"
           +" ist. Dahinter kannst Du ein kleines Tier erkennen.");
}

animal()
{
  if (!viech)
    return "Sowas siehst Du hier nicht!\n";
  return  BS("Du kannst zwar nicht erkennen, um was fuer ein Tier es sich"
            +" handelt, aber Du bist sicher, dass es ein Tier ist."
            +(ding?" Neben dem Tier liegt ein Ding.":""));
}

thing()
{
  object o;
  
  if (!ding)
    return "Sowas siehst Du hier nicht!\n";
  ding=0;
  o=clone_object(ARMOUR("nschild"));
  o->move(TP, M_PUT|M_SILENT);
  say(BS(TPN+" greift an die Mauer und steckt etwas ein."));
  return BS("Du siehst neben dem Tier ein Schild, das Du sofort einsteckst.");
}

string ritze() {
  string s, c;

  s="Zwischen den Ziegeln, wo der Moertel die Festigkeit der"
    +" Mauer sichert, sieht man eben ein paar Ritzen.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" In einer besonders "+c+" schimmernden Ritze siehst Du einen Knopf in Form eines Tigers.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

