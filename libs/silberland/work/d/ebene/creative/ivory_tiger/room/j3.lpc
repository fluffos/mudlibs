/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Zwischengang");

  SetProp(P_INT_LONG, BS(
          "Hier in diesem Zwischengang zwischen zentralem Treffpunkt"
         +" und dem noerdlichen Wehrturm findest Du nur karge Mauern"
         +" und eine fade unbehauene Decke. Im Suedosten gelangst Du"
         +" direkt zum zentralen Treffpunkt, im Westen kommst Du zu dem"
         +" Holztor."));
  AddDetail(({"gang", "zwischengang"}), BS(
            "Der Gang verbindet das innere Gebiet mit dem noerdlichen"
           +" Wehrturm."));
  AddDetail("gebiet", BS(
            "Dieses Gebiet indem Du Dich befindest gehoert zur Tigergilde."));
  AddDetail(({"gilde", "tigergilde"}), BS(
            "Die Anhaenger der Tigergilde haben hier in diesem Gebiet ihren"
           +" Hauptsitz."));
  AddDetail("anhaenger", BS(
            "Zu den Anhaengern der Tigergilde zaehlen hauptsaechlich Diebe.")),
  AddDetail("diebe", BS(
            "Die Diebe laufen doch ueberall herum, Du hast bestimmt schon"
           +" einen gesehen."));
  AddDetail("treffpunkt", BS(
            "Suedwestlich von hier befindet sich der zentrale Treffpunkt."));
  AddDetail(({"tor", "holztor"}), BS(
            "Weiter westlich von hier gelangst Du zu dem grossen Holztor."));
  AddDetail(({"waende", "mauern", "wand"}), BS(
            "Rund um Dich siehst Du karge Mauern aus Ziegelstein."));
  AddSpecialDetail(({"stein", "ziegelstein"}), "ziegel");
  AddDetail("decke", BS(
            "Die Decke ist karg und unbehauen, man hat sich nicht mal die"
           +" Muehe gemacht, sie anzustreichen."));
  AddDetail("muehe", BS(
            "Du solltest Dich auch nicht bemuehen, die Decke anzustreichen,"
           +" denn langsam aber sicher wird alles wieder so grau werden"
           +" wie es jetzt schon ist."));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Der noerdliche Wehrturm befindet sich in etwa nordwestlich"
           +" von hier."));
  AddDetail("boden", BS(
            "Am Boden liegt ueberhaupt nichts, und Du stehst auch eigentlich"
           +" nur gelangweilt darauf herum."));
  AddDetail(({"sitz", "hauptsitz"}), BS(
            "Kein anderes Gebiet wie dieses koennte besser geeignet sein fuer"
           +" die Anhaenger der Tigergilde."));

  AddSound(DEFAULT_SOUND, BS(
           "So horch doch, kann man da nicht leise Stimmen hoeren?"));
  AddSound("stimmen", BS(
           "Tatsaechlich, von Sueden hoerst Du eine leise Stimme"
          +" summen."));
  AddSound("stimme", BS(
           "Die Stimme summt sehr leise vor sich hin... Du kennst doch"
          +" das Geraeusch... Ah, ein Teekessel!"));
  AddSound(({"kessel", "teekessel"}), BS(
           "Kein Wunder, suedlich von Dir ist ja die Teekueche."));

  AddSmell(DEFAULT_SMELL, BS(
           "Du erschnupperst den Geruch von kalten, feuchten Mauern"
          +" (baeh) und einen sachten Duft nach Zitronen (besser)."));
  AddSmell( ({"geruch"}),
           "Du erschnupperst den Geruch von kalten, feuchten Mauern"
          " (baeh) und einen sachten Duft nach Zitronen (besser).");
  AddSmell( ({"mauern"}),
      "Du drueckst Deine Nase fest gegen die feuchte Mauer und schnaufst tief "
      "ein. Ihhhh das stinkt.");
  AddSmell( ({"zitronen", "duft", "zitronenduft"}),
      "Mhhh, der Zitronenduft erfreut Deine Nase.");
  AddDetail( ({"nase"}),
      "Ja Du hast eine Nase, Du Nase!");
  AddSmell("mauern", BS(
           "Die Mauern riechen kalt und feucht. Grauslich."));
  AddSmell(({"tee", "zitronentee", "zitronen"}), BS(
           "Vielleicht wird gerade suedlich von hier der Zitronentee gekocht."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("suedosten", ROOM("k4"));
  AddExit("westen", ROOM("i3"));
  AddCmd(({"drueck", "druecke"}), "press");
}

string ziegel() {
  string s, c;

  s="Es handelt sich bei den Waenden um Mauern aus rotem Ziegelstein,"
    +" der nur spaerlich verfugt wurde.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" Du findest an einem Ziegelstein einen kleinen Knopf in Form eines Tigers, der von innen "+c+" leuchtet.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

