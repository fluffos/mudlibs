/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  int i;

  ::create();

  SetProp(P_ZONE, "Schatzkammer");
  SetProp(P_INT_SHORT, "Mittlere Schatzkammer");

  SetProp(P_INT_LONG, BS(
          "Die mittlere der 3 Schatzkammern ist auch randvoll mit den"
         +" schoensten Dingen die es hier im SilberLand gibt. Die"
         +" Diebe haben wirklich ganze Arbeit geleistet, um alle Truhen"
         +" zu fuellen."));
  AddDetail( ({"truhen"}),
      "Schau Dich doch mal genau um.");
  AddDetail(({"kammern", "schatzkammern", "kammer", "schatzkammer"}), BS(
            "Insgesamt gibt es 3 Schatzkammern hier in diesem Gebiet."));
  AddDetail("boden", BS(
            "Hier und da liegt noch ein kleiner Schatz herum, der aber"
           +" eher uninteressant ist."));
  AddDetail(({"schaetze", "schatz"}), BS(
            "Die wichtigsten Schaetze lagern in den Schatztruhen."));
  AddDetail(({"waende", "wand"}), BS(
            "Die Waende sind kahl, aber hie und da erhellt eine daran"
           +" haengende Fackel den Raum."));
  AddDetail(({"fackeln", "fackel"}), BS(
            "Einige Fackeln die an den Waenden haengen erhellen den Raum."));
  AddDetail("raum", BS(
            "Du befindest Dich in der mittleren Schatzkammer."));
  AddDetail("decke", BS(
            "An der Decke ist ein leicht goldenes Schimmern zu entdecken."));
  AddDetail(({"widerschein", "schimmern"}), BS(
            "Es handelt sich bei dem Schimmern um den Widerschein der am"
           +" Boden verstreuten Schaetze."));
  AddDetail(({"goldschild", "schild"}), BS(
            "Auf dem Goldschild siehst Du die sehr praezise Zeichnung"
           +" eines Tigers."));
  AddDetail(({"symbol", "tiger"}), BS(
            "Der Tiger stellt das heilige Symbol der Diebe dar."));
  AddDetail(({"arbeit", "diebe", "dieb"}), BS(
            "Derzeit siehst Du keine Diebe, aber es muessen schon einige"
           +" gearbeitet haben, um all die Schaetze zusammenzutragen."));
  AddDetail("gebiet", BS(
            "Das Gebiet ist das der Gilde des elfenbeinernen Tigers."));
  AddDetail(({"raeume", "gildenraeume", "gilde"}), BS(
            "Die Gildenraeume befinden sich weiter oestlich."));
  AddDetail("silberland", BS(
            "Du befindest Dich doch gerade im Silberland, oder?"));
  AddDetail("zeichnung", BS(
            "Die Zeichnung auf dem Schild ist gestochen scharf."));
  AddDetail("dinge", BS(
            "So viele schoene Dinge gibt es hier zu pluendern, nun fang"
           +" doch endlich an! :)"));
  AddDetail("eindringen", BS(
            "Waerst Du ein Dieb, so taetest Du Dich mit dem Schloss"
           +" leichter."));
  AddDetail("schloss", BS(
            "Das Schloss ist fuer einen wie Dich einfach unknackbar."));
            
  AddSound(DEFAULT_SOUND, BS(
           "In Anbetracht der ganzen Schaetze hoerst Du foermlich das"
          +" Geld in Deiner Hand klimpern."));
  AddDetail( ({"hand"}),
      "Du hast zwei davon.");
  AddDetail( ({"anbetracht"}), 
      "Schaetze! SCHAETZE!");
  AddSound("geld", BS(
           "Es gibt kaum schoenere Klaenge im ganzen Silberland!"));
  AddSound( ({"klaenge", "klimpern"}),
      "Die Klaenge des Goldes locken Dich.");

  AddSmell(DEFAULT_SMELL, BS(
           "Hier riecht es direkt nach Gold!"));
  AddSmell(({"gold", "reichtuemer"}), BS(
           "Da hier so viele Reichtuemer lagern, kannst Du das Gold schon"
          +" riechen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));

  AddExit("osten", ROOM("c3"));
  NewDoor("westen", ROOM("a3"),
          ({ "tuer"}), 
	  ({ D_NAME, "Tuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine %se Tuer mit einem Goldschild.\n",
	     D_LONG, BS(
	       "Die Tuere ist ueberaus kunstvoll gefertigt und ermoeglicht kein Eindringen."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY
	  }));

  i=3;
  while (--i)
    AddItem(OBJ("struhe"));
  call_out("fuellen", 0);
}

fuellen()
{
  int i;

  for (i=(random(100)%4)+1; i; i--)
    (clone_object("/p/armour/amulet/amulett"))->move(present("truhe "+(random(2)+1), TO), M_NOCHECK);
  for (i=(random(100)%6)+1; i; i--)
    (clone_object("/p/armour/ring/ring"))->move(present("truhe "+(random(2)+1), TO), M_NOCHECK);
}

