/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  int i;

  ::create();

  SetProp(P_ZONE, "Schatzkammer");
  SetProp(P_INT_SHORT, "Kleine Schatzkammer");

  SetProp(P_INT_LONG, BS(
          "Die kleine der drei Schatzkammern ist wie die anderen beiden"
         +" natuerlich gut gefuellt mit allerlei Schaetzen, die die Diebe"
         +" im Laufe ihrer Jahre zusammengetragen haben."));
  AddDetail("boden", BS(
            "Der Boden ist fast uebersaet mit kleinen Muenzen und allerlei"
           +" anderen Schaetzen, die aber in ihrem Wert so gering sind,"
           +" dass Du Dich gar nicht darauf konzentrierst."));
  AddDetail("muenzen", BS(
            "Die Muenzen die hier im Raum verstreut herumliegen, haben einen"
           +" zu kleinen Wert, sodass sie Dich nicht interessieren.")),
  AddDetail("wert", BS(
            "Der Wert der auf dem Boden befindlichen Muenzen ist nichtig"
           +" und zu gering, als dass Du Dich dafuer interessieren wuerdest."));
  AddDetail("jahre", BS(
            "Jahre muss es gedauert haben, diesen Reichtum zustandezubringen."));
  AddDetail(({"schatz", "schaetze"}), BS(
            "Wo Diebe sind, da sind auch meist Schaetze zu finden."));
  AddDetail(({"dieb", "diebe"}), BS(
            "Also wenn Du hier etwas nimmst, so koennte man Dich schon fast"
           +" selber als Dieb bezeichnen, aber das, was alles hier herumliegt,"
           +" stammt bestimmt nicht von Dir."));
  AddDetail(({"lauf", "laufe"}), BS(
            "Im Lauf der Jahre haben die Diebe so allerlei Schaetze"
           +" zusammentragen koennen, wie Du hier sehr gut sehen kannst."));
  AddDetail("raum", BS(
            "Dass Du in einem Raum stehst, das kannst Du Dir doch denken,"
           +" besteht er doch aus Decke, Boden und Waenden."));
  AddDetail("decke", BS(
            "Von der Decke siehst Du fast gar nichts, bist Du doch so"
           +" fasziniert von den Reichtuemern, die hier ueberall lagern."));
  AddDetail(({"reichtum", "reichtuemer"}), BS(
            "Wie viele Jahre es wohl gedauert haben mag, all diese Schaetze"
           +" zu klauen und hier zu sammeln?"));
  AddDetail("eindringen", BS(
            "Durch die Tuere einzudringen wuerde ich nicht versuchen, es"
           +" sei denn Du haettest einen Schluessel."));
  AddDetail("schluessel", BS(
            "Der Schluessel den Du hast muss schon zum Schloss passen."));
  AddDetail("schloss", BS(
            "Ja, die Tuere hat ein Schloss."));
  AddDetail(({"kammer", "schatzkammer"}), BS(
            "Du stehst in der kleinsten der drei Schatzkammern."));
  AddDetail(({"wand", "waende"}), BS(
            "An der Wand steht eine Schatztruhe."));
  AddDetail(({"silberschild", "schild"}), BS(
            "Auf dem Silberschild siehst Du die sehr praezise Zeichnung"
           +" eines Tigers."));
  AddDetail(({"symbol", "tiger"}), BS(
            "Der Tiger stellt das heilige Symbol der Diebe dar."));
  AddDetail("zeichnung", BS(
            "Die Zeichnung auf dem Schild ist gestochen scharf."));

  AddSound(DEFAULT_SOUND, BS(
           "Der Klang Deiner Schritte inmitten all der Muenzen wirkt"
          +" zwar metallisch aber ist doch irgendwie schoen anzuhoeren."));
  AddSound(({"klang", "schritte", "muenzen"}), BS(
           "*klimper* *schreit* hach das haettest Du oefter gerne!"));

  AddSmell(DEFAULT_SMELL, BS(
           "Der Geruch des Goldes fasziniert Dich."));
  AddSmell(({"gold", "geruch"}), BS(
           "Auch wenn Du es nicht glaubst, aber Gold hat direkt einen eigenen"
          +" Geruch."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));

  AddExit("osten", ROOM("d3"));
  NewDoor("westen", ROOM("b3"),
          ({ "tuer"}), 
	  ({ D_NAME, "Tuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine %se Tuer mit einem Silberschild.\n",
	     D_LONG, BS(
	       "Die Tuere ist ueberaus kunstvoll gefertigt und ermoeglicht kein Eindringen."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY
	  }));

  i=2;
  while (--i)
    AddItem(OBJ("struhe"));
  call_out("fuellen", 0);
}

fuellen()
{
  int i;

  for (i=(random(100)%2)+1; i; i--)
    (clone_object("/p/armour/amulet/amulett"))->move(present("truhe", TO), M_NOCHECK);
  for (i=(random(100)%3)+1; i; i--)
    (clone_object("/p/armour/ring/ring"))->move(present("truhe", TO), M_NOCHECK);
}

