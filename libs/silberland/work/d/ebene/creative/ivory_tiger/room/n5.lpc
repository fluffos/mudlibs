/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Andachtsraum");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich in dem Raum, in dem die Angehoerigen der"
	 +" Gilde des elfenbeinernen Tigers eine Art Gedenkstaette fuer"
	 +" Leute, die grossen Anteil am Entstehen des Gebietes hatten,"
	 +" errichtet haben."));
  AddDetail("boden", BS(
            "Am Boden siehst Du unmittelbar vor der Wand einen kleinen"
	   +" Opferstock."));
  AddDetail(({"wand", "waende"}), BS(
            "An der Wand befindet sich eine Tafel."));
  AddDetail(({"andachtsraum", "raum"}), BS(
            "Du bist im Andachtsraum."));
  AddDetail("angehoerige", BS(
            "Es gibt viele Angehoerige der Gilde des elfenbeinernen"
	   +" Tigers. Nicht jeder gibt es zu."));
  AddDetail("gilde", BS(
            "Die Gilde des elfenbeinernen Tigers existiert schon sehr"
	   +" lange."));
  AddDetail("tiger", BS(
            "Der Tiger ist das Symbol der Macht dieser Gilde."));
  AddDetail("symbol", BS(
            "Fuer Angehoerige der Gilde gilt der Tiger als unumschraenktes"
	   +" Symbol der Macht."));
  AddDetail("macht", BS(
            "Der Tiger verleiht Dir, sofern Du der Gilde beitrittst,"
	   +" seine Macht. Unterschaetze sie nicht!"));
  AddDetail(({"staette", "gedenkstaette"}), BS(
            "Dieses Gebiet ist ja nicht einfach so entstanden, nein, es"
	   +" hatten viele Mitarbeiter ihren Anteil daran, dass es zu"
	   +" dem geworden ist, was es jetzt ist. Dieser Raum hier dient"
	   +" als Gedenkstaette zum Andenken der Helfer."));
  AddDetail(({"leute", "helfer", "arbeiter", "mitarbeiter"}), BS(
            "Du kannst auf der Tafel nachlesen, wer aller mitgeholfen"
	   +" hat."));
  AddDetail("tafel", BS(
            "Die Tafel selber hat einen goldenen Rahmen."));
  AddDetail("rahmen", BS(
            "Der goldene Rahmen der Tafel sieht beeindruckend aus."));
  AddReadDetail("tafel", "@@tafel@@");
  AddDetail("andenken", BS(
            "Versuche auch Du, in Gedanken an jene zu denken, die hier"
	   +" mitgeholfen haben."));
  AddDetail("gedanken", BS(
            "Deine Gedanken kannst nur Du selber lesen."));
  AddReadDetail("gedanken", BS(
                "Eine gute Idee, darueber solltest Du einmal nachdenken."));
  AddDetail("decke", BS(
            "Die Decke ist wie in einer Kirche sehr hoch oben, der Lichtschein"
	   +" reicht nicht so weit."));
  AddDetail("kirche", BS(
            "Auch eine Kirche ist eine Art Gedenkstaette."));
  AddDetail("art", BS(
            "Es ist eben eine Art Gedenkstaette."));
  AddDetail(({"entstehen", "anteil"}), BS(
            "Nimm auch Du Anteil am Entstehen dieses Gebiets und spende."));
  AddDetail(({"bereich", "gebiet"}), BS(
            "Du befindest Dich im Bereich der Gilde des elfenbeinernen Tigers."
	   +" Das ganze Gebiet rund um Dich gehoert dazu."));
  AddDetail(({"schein", "lichtschein"}), BS(
            "An der Wand haengt neben der Tafel eine Fackel, die einen"
	   +" warmen Lichtschein produziert."));
  AddDetail(({"pechfackel", "fackel"}), BS(
            "Bei der Fackel an der Wand handelt es sich um eine Pechfackel."));

  AddCmd("spende", "giv");

  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst foermlich die armen Arbeiter, die hier mitgearbeitet"
	  +" haben, noch aechzen und stoehnen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Der Pechgeruch der Fackeln ist fast nicht auszuhalten."));
  AddSmell(({"fackeln", "pech", "pechgeruch"}), BS(
           "Die Pechfackeln stinken wirklich erbaermlich."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  AddItem(OBJ("opferstock"), REFRESH_DESTRUCT);
  
  AddExit("norden", ROOM("n4"));
  AddExit("westen", ROOM("m5"));
}

giv()
{
  write("Um zu spenden, leg einfach Deinen Obolus in den Opferstock.\n");
  return 1;
}

tafel()
{
  string str, dummy;
  object o;
  
  str= "  |\n";
  str+="  |     Gilde des elfenbeinernen Tigers, Gedenktafel\n";
  str+="--+------------------------------------------------------\n";
  str+="  |  Der Gildenmeister und seine Angehoerigen gedenken\n";
  str+="  | vor allem jenen, die regen Anteil am Entstehen des\n";
  str+="  | Gebietes gehabt haben. Dazu zaehlen:\n  |\n";
  str+="  | Zordan: half mit unermuedlichem Einsatz mit, dieses\n";
  str+="  |         Projekt zu realisieren.\n  |\n";
  str+="  | Crea*:   Ohne ihn waere hier nichts zustandegekommen.\n  |\n";
  str+="  | Angrox:  Ohne ihn waere noch weniger passiert.\n  |\n";
  str+="  | Woody,\n  | Dusty:  Preiset die Goetter.\n  |\n";
  if ((o=present("opferstock")) && strlen((dummy=o->Spender()))) {
    str+="  | Weiters halfen durch BETRAECHTLICHE Geldspenden:\n";
    str+=break_string(dummy, 45, "  | ");
  }
  str+="  |\n\n";
  return str;
}

