/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Schatzkammer");
  SetProp(P_INT_SHORT, "Vor der Schatzkammer");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich vor der grossen Schatzkammer. Nach Westen"
         +" geht die Tuer, hinter der Reichtuemer auf Dich warten."
         +" Hoffentlich hast Du den entsprechenden Schluessel mit,"
         +" damit Du nicht leer ausgehst."));
  AddDetail(({"kammer", "schatzkammer"}), BS(
            "Im Westen liegt die Schatzkammer, gefuellt mit allerlei"
           +" Reichtuemern."));
  AddDetail("reichtuemer", BS(
            "Die Schatzkammer wartet nur darauf, ausgepluendert zu werden."));
  AddDetail("boden", BS(
            "Auf dem Boden befindet sich eine kleine Luke."));
  AddDetail("luke", BS(
            "Der Weg durch die Luke fuehrt nach unten."));
  AddDetail("weg", BS(
            "Von unten kommend kannst Du nur zurueck oder nach Westen gehen."));
  AddDetail("westen", BS(
            "Im Westen befindet sich eine Tuer."));
  AddDetail("decke", BS(
            "An der Decke haengt ein brennender Docht."));
  AddDetail("docht", BS(
            "Der Docht der von der Decke herunterhaengt gibt genug Licht,"
           +" dass Du sehen kannst."));
  AddDetail("licht", BS(
            "Das Licht kommt von der Decke."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Wand besteht aus grob gehauenem Felsgestein."));
  AddDetail(({"gestein", "felsgestein"}), BS(
            "Hier ist nicht viel Wert auf Einrichtung gelegt worden. Vielmehr"
           +" zaehlt der Platz fuer die Schaetze."));
  AddDetail(({"schatz", "schaetze"}), BS(
            "Hoffentlich findest Du einen Schatz im Westen."));
  AddDetail("einrichtung", BS(
            "Recht spaerlich hier, findest Du nicht?"));
  AddDetail("wert", BS(
            "Der eigentliche Wert, um den es hier geht, liegt in der Schatzkammer."));
  AddDetail("platz", BS(
            "Hinter der Tuer ist viel Platz fuer allerhand Schaetze."));
  AddDetail(({"schild", "bronzeschild"}), BS(
            "Das Schild auf der Tuer zeigt einen bronzenen Tiger."));
  AddDetail("tiger", BS(
            "Auf dem Schild, das an der Tuer befestigt ist, erkennst Du einen"
           +" Tiger."));
  AddDetail("eindringen", BS(
            "Ohne Schluessel kannst Du nicht durch die Tuere."));
  AddDetail("schluessel", BS(
            "Man benoetigt einen Schluessel, um die Tuere zu oeffnen."));

  AddSound(DEFAULT_SOUND, BS(
           "Von unten, durch die Luke herauf, dringt ein leises unheimliches"
          +" Grollen an Dein Ohr."));
  AddSound("grollen", BS(
           "Dir wird leicht mulmig zumute, direkt unheimlich klingt dieses Grollen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Du kannst das Gold hinter der Tuer foermlich riechen."));
  AddSmell(({"geld", "duft", "gold"}), BS(
           "Wie herrlich ist doch der Duft des Geldes!"));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  NewDoor("westen", ROOM("c3"),
          ({ "tuer"}), 
	  ({ D_NAME, "Tuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine %se Tuer mit einem Bronzeschild.\n",
	     D_LONG, BS(
	       "Die Tuere ist ueberaus kunstvoll gefertigt und ermoeglicht kein Eindringen."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY
	  }));
  AddSpecialExit("unten", "ud");
}

ud()
{
  object des;

  des=UMSTR->init_new_player(this_player(), TO);
  this_player()->move(des, M_GO, "nach unten", "klettert durch eine Luke im Boden", "kommt von oben hereingeklettert");
  return 1;
}


