/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Unter der Luke");

  SetProp(P_INT_LONG, BS(
          "Du stehst knapp unterhalb der Luke, die die Erdoberflaeche"
         +" und diesen Raum verbindet. Ober Dir hoerst Du foermlich noch"
         +" den Wind rauschen, der die Blaetter der Baeume und Buesche"
         +" auseinanderbiegt. Hier herunten ist es allerdings eher kuehl,"
         +" und der Lichtschein der von oben hereinfaellt ist gerade noch"
         +" ausreichend, um die Umgebung hier zu erahnen."));
  AddDetail("boden", BS(
            "Der Boden ist festgetreten, und kaum staubig, weil hier von"
           +" oben noch genug Naturkraefte walten koennen, um es hier"
           +" sauber zu halten."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Waende hier sind kahl, es lohnt sich nicht naeher, die"
           +" bekritzelten Stellen zu betrachten."));
  AddDetail("stellen", BS(
            "Ein gar merkwuerdiges Graffiti findest Du hier. Sehr bunt, und"
           +" doch nicht von Menschenhand."));
  AddDetail(({"hand", "menschenhand"}), BS(
            "Du hast doch auch eine Hand."));
  AddDetail("graffiti", BS(
            "Das Graffiti zeigt das Bild eines seltsamen Tieres."));
  AddDetail(({"bild", "tier"}), BS(
            "Du kannst die schemenhaften Umrisse eines Tigers erkennen,"
           +" bist Dir jedoch nicht sicher."));
  AddDetail(({"umriss", "umrisse", "tiger"}), BS(
            "Es koennte sich tatsaechlich um einen Tiger handeln."));
  AddDetail("decke", BS(
            "Ueber Dir befindet sich die Luke, durch die Du wieder nach oben"
           +" gelangen kannst."));
  AddDetail("luke", BS(
            "Die Luke fuehrt nach oben. Sie ist unversperrt."));
  AddDetail("raum", BS(
            "Hier kann man richtiggehend von einem kargen Raum sprechen."));
  AddDetail(({"kraft", "naturkraft", "kraefte", "naturkraefte"}), BS(
            "Eine gewaltige Naturkraft ist unter anderem der Wind, den Du"
           +" auch hier unten noch gut hoeren kannst."));
  AddDetail("wind", BS(
            "Du hoerst ihn genau, den Wind."));
  AddDetail(({"blaetter", "baeume", "buesche"}), BS(
            "Hier herunten findest Du keine solchen. Da muesstest Du schon"
           +" durch die Luke klettern."));
  AddDetail(({"oberflaeche", "erdoberflaeche"}), BS(
            "Da Du Dich unter ihr befindest, musst Du hinaufgehen, um sie zu"
           +" betrachten."));
  AddDetail("umgebung", BS(
            "Viel gibt es hier nicht zu sehen... Hier ist nur die Luke in"
           +" der Decke und ein Ausgang nach Westen. Aber sonst gibt es"
           +" nichts Wichtiges zu entdecken."));
  AddDetail("ausgang", BS(
            "Im Westen scheint es weiterzugehen. Ob Du es wohl wagen solltest?"));
  AddDetail("licht", BS(
            "Das einzige Licht das Du sehen kannst kommt von oben."));
  AddDetail("wichtiges", BS(
            "Wenn ich sage nicht wichtig, dann meine ich nicht wichtig."));
  AddDetail(({"schein", "lichtschein"}), BS(
            "Durch die Luke in der Decke dringt noch gerade so viel Licht,"
           +" dass Du Die die Umgebung ein wenig betrachten kannst."));

  AddSound(DEFAULT_SOUND, BS(
           "Du kannst noch das Rauschen des Windes in den Baeumen und Bueschen"
          +" ober Dir hoeren."));
  AddSound( ({"wind","rauschen"}), BS(
           "Es hoert sich hier auch nicht anders als oben an."));

  AddSmell(DEFAULT_SMELL, BS(
           "Hier herunten riecht es schon ein wenig muffig."));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 19, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("oben", ROOM("s3"));
  AddExit("westen", ROOM("n4"));
  AddItem(NPC("murhu"), REFRESH_DESTRUCT);
}

init()
{
  ::init();
  call_other(ROOM("f1"), "???");
  call_other(ROOM("k4"), "???");
  call_other(ROOM("f6"), "???");
  call_other(ROOM("h6"), "???");
  call_other(ROOM("e5"), "???");
}

