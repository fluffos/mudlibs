/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

create()
{
  ::create();

  SetProp(P_ZONE, "Noerdlicher Wehrturm");
  SetProp(P_INT_SHORT, "Alter Wehrturm");

  SetProp(P_INT_LONG, BS(
          "Du stehst in einem ehemaligen Wehrturm, der heute nur noch"
         +" fuer die Nebenraeume die Mauern bereitstellt. Er ist im"
         +" Gegensatz zum suedlichen Wehrturm noch sehr gut erhalten."
         +" Hier hat man wohl gar nichts renovieren muessen. Jedoch"
         +" duerfte dieser Trakt weit aelter sein als die vormals"
         +" verfallenen Teile im suedlichen Wehrturm."));
  AddDetail(({"tuerme", "wehrtuerme", "turm", "wehrturm"}), BS(
            "Mitten im noerdlichen Wehrturm befindest Du Dich also nun,"
           +" und betrachtest mit Begeisterung das alte Gemaeuer."));
  AddDetail(({"mauern", "mauer", "gemaeuer"}), BS(
            "Obwohl die Mauern eigentlich schon sehr alt sind und"
           +" teilweise auch schon so aussehen, muss man sagen, dass"
           +" die Waende noch tiptop in Schuss sind."));
  AddDetail(({"wand", "waende"}), BS(
            "Ziegel fuer Ziegel wurde hier frueher wohl geschleppt und"
           +" gemauert. Das Resultat ist jedoch so gut geworden, dass"
           +" es bis zum heutigen Tag und noch lang darueber hinaus"
           +" fest sein wird und stabil bleibt."));
  AddDetail("ziegel", BS(
            "Die Waende sind Mauern aus Ziegel."));
  AddDetail("resultat", BS(
            "Als Resultat der Arbeit hier gilt bestimmt die Festigkeit"
           +" und Stabilitaet des noerdlichen Wehrturms."));
  AddDetail(({"festigkeit", "stabilitaet"}), BS(
            "Ueberzeugt pruefst Du die Stabilitaet des Wehrturms,"
           +" indem Du mit Deinem Knoechel gegen die Wande pochst."
           +" Zufrieden stellst Du fest, dass einfach nichts wackelt."));
  AddDetail("knoechel", BS(
            "Ja, an jedem Deiner Finger erkennst Du einen Knoechel.")),
  AddDetail("finger", BS(
            "Die Finger befinden sich an Deiner Hand, wie auch so zu"
           +" erwarten war."));
  AddDetail(({"hand", "haende"}), BS(
            "Haende hast Du gottseidank auch."));
  AddDetail("boden", BS(
            "Am Boden siehst Du Granitplatten."));
  AddSpecialDetail(({"platten", "granitplatten"}), "granite");
  AddDetail("decke", BS(
            "Obwohl hier im Raum keine fix montierte Lichtquelle den Raum"
           +" erleuchtet, siehst Du ein ganz leichtes Scheinen von den"
           +" anschliessenden Raeumen."));
  AddDetail("raum", BS(
            "Der Raum hier befindet sich im noerdlichen Wehrturm einer"
           +" alten Festung, der heute nur mehr als Lagerraum genutzt"
           +" wird."));
  AddDetail("lagerraum", BS(
            "Da der Wehrturm sehr maechtig ist, laesst sich hier auch"
           +" bestimmt viel lagern."));
  AddDetail("trakt", BS(
            "Dieser Trakt befindet sich im noerdlichen Wehrturm einer"
           +" alten Festung.")),
  AddDetail("festung", BS(
            "Ueber die alte Festung, zu dem dieser und der suedliche"
           +" Wehrturm gehoeren, ist nicht mehr viel bekannt."));
  AddDetail("schuss", BS(
            "Das Gemaeuer ist einfach noch sehr gut in Schuss."));
  AddDetail("scheinen", BS(
            "Aus den Nebenraeumen dringt ein schwacher Lichtschein."));
  AddDetail(({"schein", "lichtschein"}), BS(
            "Der Lichtschein erhellt den Raum nicht genug."));
  AddDetail("gegensatz", BS(
            "Im Gegensatz zum suedlichen Wehrturm ist hier alles noch"
           +" sehr gut in Schuss."));
  AddDetail(({"raeume", "nebenraeume"}), BS(
            "Im Osten findet sich eine Trinkhalle, weiter nach Westen"
           +" geht es weiter in das Innere des Wehrturms."));
  AddDetail(({"westen", "innere"}), BS(
            "Weiter nach westen gelangst Du ins Innere des Wehrturms."));
  AddDetail(({"lichtquelle", "quelle"}), BS(
            "Zu Deinem Bedauern gibt es hier im Raum keine fix montierte"
           +" Lichtquelle."));
  AddDetail("bedauern", BS(
            "Du bedauerst Dich."));
  AddDetail(({"nacht", "tag"}), BS(
            "Du befindest Dich unter der Erde, wie willst Du feststellen,"
           +" ob Tag oder Nacht ist?"));
  AddDetail(({"oberflaeche", "erdoberflaeche", "erde"}), BS(
            "Du befindest Dich unterhalb der Erdoberflaeche."));
  AddDetail("begeisterung", BS(
            "Du bist dermassen begeistert von Dir, dass Du in die Luft"
           +" springst."));
  AddDetail(({"atmen", "luft"}), BS(
            "Hier gibt es auch Luft zum Atmen. Sei froh."));
  AddDetail(({"teil", "teile"}), BS(
            "Die Festung hatte beziehungsweise hat immer noch zwei"
           +" Wehrtuerme, Du befindest Dich derzeit im noerdlichen Teil."));
  AddDetail(({"halle", "trinkhalle"}), BS(
            "In der urigen Trinkhalle haben schon manche Gesellen eine"
           +" durchzechte Nacht verbracht. Du findest sie von hier aus"
           +" im Osten."));
  AddDetail("gesellen", BS(
            "Vielleicht gibt es im Osten noch ein paar lustige Gesellen,"
           +" die mit Dir einen trinken wollen."));
  AddDetail("arbeit", BS(
            "Viel Arbeit war wohl noetig um all diese Ziegel hier"
           +" zu schleppen und zu vermauern."));
            

  AddSound(DEFAULT_SOUND, BS(
           "Du pochst mit Deinem Knoechel gegen die Wand und hoerst"
	  +" Dein eigenes Pochen. Wie realistisch. Sonst ist jedoch"
	  +" nichts zu hoeren."));
  AddSound( ({"pochen"}),
      "Du lauscht angestrengt, aber Du hoerst kein Pochen. Klar, es pocht "
      "ja auch niemand.");

  AddSmell(DEFAULT_SMELL, BS(
           "Fast wie in einem Spital riecht es hier, eine Art"
	  +" Vorleichengeruch."));
  AddSmell( ({"art"}), 
      "Naja, es richt beinahe so.");
  AddSmell(({"spital", "leichengeruch", "geruch", "vorleichengeruch"}), BS(
	   "Es riecht hier wie in einem Spital."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("i1"));
  AddExit("westen", ROOM("g1"));
  AddExit("sueden", ROOM("h2"));
  AddCmd(({"drueck", "druecke"}), "press");
}

string granite() {
  string s, c;

  s="Der Boden ist mit Granitplatten, die sehr genau quadratisch"
    +" zugeschnitten wurden, ausgelegt, und dazwischen verfugt.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" Der Granit schimmert "+c+", und Du erkennst daran einen Knopf in Form eines Tigers.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

