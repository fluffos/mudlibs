/*
  Ebony Tiger Guild
*/

#include "../files.h"
#include "../quest.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include <player/viewcmd.h>
#include "../files.h"

int luke;

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Im Zimmer des Adjutanten");

  SetProp(P_INT_LONG, BS(
          "Hier im Zimmer sieht es fast genau so aus wie in einer Teekueche."
         +" An den Waenden ein paar Regale mit Dosen drauf, an der Westwand"
         +" ein Herd, auf dem ein Teekessel steht. An der suedlichen Wand"
         +" haengt ein Waschbecken, allerdings ohne Wasserhahn."));
  AddDetail("zimmer", BS(
            "Du befindest Dich im Zimmer des Adjutanten."));
  AddDetail(({"kueche", "teekueche"}), BS(
            "Hier in diesem Zimmer bereitet der Adjutant des Gildenmeisters"
	   +" fuer den Chef hoechstpersoenlich immer eine gute Tasse Tee"
	   +" zu."));
  AddDetail(({"meister", "gildenmeister", "chef"}), BS(
            "Der Gildenmeister ist oberster Chef der Gilde und"
	   +" ist Teefanatiker. Er befindet sich ein Zimmer weiter"
	   +" westlich."));
  AddDetail(({"fanatiker", "teefanatiker"}), BS(
            "Wenn man die vielen Teesorten auf den Regalen betrachtet,"
	   +" kommt man zu dem Entschluss, dass der Gildenmeister"
	   +" wirklich ein Fanatiker sein muss."));
  AddDetail("entschluss", BS(
            "Bist Du aber entschlussfreudig!"));
  AddDetail("adjutant", BS(
            "Der Adjutant kocht hier fuer den Gildenmeister Tee."));
  AddDetail(({"tee", "teesorten", "sorten"}), BS(
            "Auf den Regalen befinden sich viele Dosen mit den"
	   +" verschiedensten Teesorten."));
  AddDetail(({"regale", "regal"}), BS(
            "Du siehst viele Dosen auf den Regalen. Kleine wie auch"
	   +" grosse."));
  AddDetail(({"dose", "dosen"}), BS(
            "Alle 15 Dosen sind beschriftet, um zu erkennen, was drin"
	   +" ist. Du kannst alle 15 Dosen lesen."));
  AddReadDetail("dose 1", BS("'Zimttee'."));
  AddDetail("dose 1", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 2", BS("'Orangentee'."));
  AddDetail("dose 2", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 3", BS("'Zitronentee'."));
  AddDetail("dose 3", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 4", BS("'Wintertraum'."));
  AddDetail("dose 4", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 5", BS("'Marzipantee'."));
  AddDetail("dose 5", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 6", BS("'Hagebuttentee'."));
  AddDetail("dose 6", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 7", BS("'Pfefferminztee'."));
  AddDetail("dose 7", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 8", BS("'Melissentee'."));
  AddDetail("dose 8", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 9", BS("'Brennesseltee'."));
  AddDetail("dose 9", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 10", BS("'Vanilletee'."));
  AddDetail("dose 10", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 11", BS("'Sylter Mischung'."));
  AddDetail("dose 11", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 12", BS("'Ceylon'."));
  AddDetail("dose 12", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 13", BS("'Gruener Tee'."));
  AddDetail("dose 13", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 14", BS("'Assam'."));
  AddDetail("dose 14", BS("Man kann lesen was draufsteht."));
  AddReadDetail("dose 15", BS("'Ulva Highlands'."));
  AddDetail("dose 15", BS("Man kann lesen was draufsteht."));
  AddSpecialDetail(({"kessel", "teekessel"}), "kettle");
  AddDetail("herd", BS(
            "An der westlichen Wand befindet sich ein Herd, auf"
	   +" dem ein Teekessel steht. So wie jeden Herd kann man "
            "auch diesen einheizen. Darober befindet sich"
	   +" eine kleine Luke."));
  AddDetail("waende", BS(
            "Auf allen Waenden befinden sich Regale."));
  AddDetail("westwand", BS(
            "An der Westwand steht ein Herd mit einem Teekessel."));
  AddDetail(({"wand", "suedwand", "suedliche wand"}), BS(
            "An der suedlichen Wand ist ein Waschbecken, damit"
	   +" immer frisches Wasser fuer den Tee da ist."));
  AddDetail("wasser", BS(
            "Das Wasser kommt aus dem Wasserhahn."));
  AddDetail(({"becken", "waschbecken"}), BS(
            "Das Waschbecken an der suedlichen Wand haengt ein bisschen"
	   +" schief."));
  AddDetail(({"hahn", "wasserhahn"}), BS(
            "Der Wasserhahn tropft ganz wenig."));
  AddDetail("boden", BS(
            "Auf dem Boden in der Ecke steht ein Mistkuebel."));
  AddDetail(({"ecke", "kuebel", "mistkuebel"}), BS(
            "Der Mistkuebel in der Ecke quillt vor Teeresten schon ueber."));
  AddDetail(({"reste", "teereste"}), BS(
            "Natuerlich entstehen auch Teereste bei der Zubereitung von"
	   +" Tee."));
  AddDetail("zubereitung", BS(
            "Das frag mal schoen den Adjutanten, der weiss das am besten."));
  AddDetail("decke", BS(
            "An der Decke ist noch ein wenig Dunst."));
  AddDetail("dunst", BS(
            "Der Dunst kommt vom vielen Teekochen."));
  AddDetail(({"kochen", "teekochen"}), BS(
            "Hier wird sehr haeufig Tee gekocht."));
  AddDetail("gilde", BS(
            "Der Gildenmeister ist im Zimmer westlich von Dir und kann"
	   +" Dir alles daruber erzaehlen."));
  AddDetail("tasse", BS(
            "Eine Tasse mit einer bunten Aufschrift steht auf einem"
	   +" Regal."));
  AddDetail("aufschrift", BS(
            "Versuch doch einmal sie zu lesen."));
  AddReadDetail("aufschrift", BS(
                "Auf der Tasse steht geschrieben 'C H E F'"));
  AddDetail("moment", BS(
            "Gleich wird das Wasser im Teekessel kochen!"));
  AddSpecialDetail("luke", "hole");
  AddSpecialDetail("durch luke", "through");

  AddSound(DEFAULT_SOUND, BS(
           "Das Wasser im Teekessel wird jeden Moment kochen, man hoert"
          +" es schon brodenln."));
  AddSound(({"wasser", "teekessel", "kessel"}), BS(
           "Das Wasser im Teekessel wird gleich kochen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Fast alle Dosen auf den Regalen geben einen koestlichen Geruch"
          +" ab; gemeinsam jedoch ist die Wirkung unheimlich stark."));
  AddSmell("dosen", BS(
           "Die einzelnen Gerueche lassen sich gar nicht ausmachen, so viele"
          +" Duftnoten tragen zum Gesamtgeruch bei."));
  AddSmell(({"geruch", "gerueche"}), BS(
           "Es riecht nach Orangen, Zimt, Kardamom, Minze, Zitrone, ..."));
  AddSmell(({"zitrone", "orange", "orangen", "zitronen"}), BS(
           "Die Orange wie auch die Zitrone riechen ein wenig saeuerlich,"
          +" typisch Zitrusfruechte eben."));
  AddSmell("minze", BS(
           "Die Minze scheint frisch gepflueckt, ihr Geruch ist besonders intensiv."));
  AddSmell("zimt", BS(
           "Zimt riecht koestlich und schmeckt noch viel besser."));
  AddSmell("kardamom", BS(
           "Der Kardamom scheint eine wichtige Zutat fuer aromatisierte Tees zu"
          +" sein. Man riecht ihn besonders gut."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("k4"));
  AddCmd("oeffne", "op");
  AddCmd(({"schliesse", "schliess"}), "cl");
  AddCmd(({"heiz", "heize"}), "heat");
  AddCmd(({"stell", "stelle"}), "put_kettle");
  luke=0;
  AddItem(NPC("adjutant"), REFRESH_DESTRUCT);
}

reset() {
  ::reset();
  if (luke)
    tell_room(TO, "Die Luke schliesst sich.\n");
  luke=0;
}

hole() {
  if (luke)
    return "Du siehst eine geoeffnete Luke. Man kann durchschauen.\n";
  return "Eine geschlossene Luke.\n";
}

through() {
  object env;
  int brief;

  if (!luke)
    return "Die Luke ist doch geschlossen.\n";
  call_other(ROOM("i4"), "???");
  env=find_object(ROOM("i4"));
  if (!(TP->QueryProp(P_BRIEF) & BRIEF_VMASK))
    return env->int_long(TP, TP, TP->QueryProp(P_SHORTINV) ? 0 : 2);
  if ((brief=(TP->QueryProp(P_BRIEF) & BRIEF_VMASK)) >= 2) return "";
    return env->int_short(TP, TP, TP->QueryProp(P_SHORTINV) ? 0 : 2);
}

op(str) {
  notify_fail("Was willst Du oeffnen?\n");
  if (!str || str!="luke")
    return 0;
  if (present("adjutant")) {
    write("Der Adjutant hindert Dich daran, die Luke zu oeffnen.\n");
    return 1;
  }
  if (luke) {
    write("Die Luke ist doch schon geoeffnet.\n");
    return 1;
  }
  write("Du oeffnest die Luke.\n");
  tell_room(TO, TPN+" oeffnet eine Luke.\n", ({TP}));
  luke=1;
  return 1;
}

cl(str) {
  notify_fail("Was willst Du schliessen?\n");
  if (!str || str!="luke")
    return 0;
  if (present("adjutant")) {
    write("Der Adjutant hindert Dich daran, die Luke zu schliessen.\n");
    return 1;
  }
  if (!luke) {
    write("Die Luke ist doch schon geschlossen.\n");
    return 1;
  }
  write("Du schliesst die Luke.\n");
  tell_room(TO, TPN+" schliesst eine Luke.\n", ({TP}));
  luke=0;
  return 1;
}

int check_kettle(object o) {
  return o->id(IV_KETTLE);
}

heat(str) {
  string s;
  object b, env, k, l, *inv;

  notify_fail("Was willst Du einheizen?\n");
  if (!str || str!="herd ein")
    return 0;
  if (present("apoc")) {
    write("Apoc sagt: Du kannst hier nicht einheizen!\n");
    write("Apoc verdreht die Augen...\n");
    write("Apoc sagt: Das ist MEIN Herd. Nimm den Naechsten!\n");
    return 1;
  }
  b=present(IV_QUEST_ITEM, TP);
  inv=all_inventory(this_object());
  inv=filter_array(inv, #'check_kettle);
  if (sizeof(inv)==0) {
    write(BS(
          "Du sinnloser Energieverschwender! Du solltest schon etwas"
         +" respektvoller umgehen! Wie waers, wenn Du einen Teekessel"
         +" auf den Herd stellen wuerdest?"));
    return 1;
  }
  if (sizeof(inv)>1) {
    write(BS(
          "Die Herdplatte ist viel zu schwach, als dass sie mehr als"
         +" einen Teekessel beheizen koennte. Du solltest die Teekessel"
         +" ein wenig reduzieren..."));
    return 1;
  }
  k=inv[0];
  if (TP->query_real_name() != k->get_owner()) {
    write(BS(
          "Dies ist nicht Dein eigener Teekessel. Willst Du Dir wirklich"
         +" die Muehe machen, und jemand anderem die Arbeit abnehmen?"
         +" Das glaubst Du ja wohl selber nicht! Stell lieber Deinen"
         +" eigenen Kessel auf den Herd..."));
    return 1;
  }
  l=present(IV_LANTERN, TP);
  if (!l) {
    write(BS(
          "Du brauchst den magischen Funken der heiligen Laterne des"
         +" Tarion, um den Herd einheizen zu koennen. Nur dises Laterne"
         +" hat die Macht, das Feuer auf die genaue Temperatur zu bringen."
         +" Hoffentlich reicht die Glut der Kohle in Tarions Laterne aus,"
         +" um das Feuer hier zu entfachen... Eventuell findest Du ja auch"
         +" noch etwas Kohle im Laden..."));
    return 1;
  }
  if (!l->query_burning()) {
    write(BS(
          "Also wenn die Laterne wenigstens einen winzigen Funken noch"
         +" beherbergen wuerde, so koenntest Du ja den Herd einheizen..."
         +" Sei doch so gut und bring die Laterne in brennendem Zustand!"));
    return 1;
  }
  call_other(ROOM("i4"), "???");
  env=find_object(ROOM("i4"));
  if (env && present("gildenmeister", env))
    if ((b=present(IV_BEARD, TP)) && member(TP->QueryProp(P_ARMOURS), b)>1)
      write(BS("Der Gildenmeister laesst Dich gewaehren."));
    else {
      write(BS("Eine Luke oeffnet sich und der Gildenmeister wirft einen"
           +" Blick genau auf Dich."));
      write(break_string(
            "Du da, Du kannst nicht mein Adjutant sein, Du traegst ja"
           +" keinen Bart! Verschwinde sofort aus der Kueche, sonst hole"
           +" ich die Wachen!!! In meiner Kueche darf NUR der Adjutant"
           +" etwas zubereiten!!!", 78, "Er schimpft: "));
      write(BS("Die Luke schliesst sich wieder."));
      return 1;
    }
  s="Du heizt den Herd ein.";
  if (!k->query_water())
    if (k->query_moss()) {
      s+=" Der Kessel wird heiss und das leicht mit Wasser"
        +" vollgesogene Moos verdampft dabei.";
      k->remove_moss();
    }
    else {
      s+=" Der Kessel wird unnoetig heiss. Beim Versuch den Kessel"
        +" vom Feuer zu nehmen verbrennst Du Dir die Finger.";
      TP->reduce_hit_point(10);
    }
  else {
    s+=" Das Wasser im Kessel beginnt sofort zu kochen.";
    if (k->query_moss()) {
      s+=" Das Moos kocht gut im klaren Wasser. Langsam wird es gar.";
      call_out("fertig", 8, k);
    }
    else {
      s+=" Es verdunstet jedoch rasend schnell.";
      k->remove_water();
    }
  }
  write(BS(s));
  return 1;
}

void fertig(object k) {
  object b;
  if(!objectp(k)) 
    return 0;
  write(BS("Das Moos ist fertiggekocht. Es ist zu einem ausgetrockneten"
          +" Moosbueschel geworden, das sofort zu Pulver zerfaellt."));
  k->remove_water();
  k->remove_moss();
  k->set_boil();
  if(b=deep_present(IV_QUEST_ITEM, TP))
     b->set_flag(IV_COOK_MOSS);
  return ;
}

put_kettle(str) {
  object k;

  notify_fail("Worauf willst du was abstellen?\n");
  if (!str)
    return 0;
  if (str=="")
    return 0;
  if (!(str=="kessel auf herd" || str=="teekessel auf herd"))
    return 0;
  notify_fail("So etwas hast Du nicht bei Dir!\n");
  if (!(k=present(IV_KETTLE, TP)))
    return 0;
  k->move(TO, M_NOCHECK);
  write("Du stellst den Teekessel auf den Herd.\n");
  say(TP->Name()+" stellt einen Teekessel auf den Herd.\n");
  return 1;
}

