#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int klump;

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Im Zimmer des Gildenmeisters");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich direkt im Zimmer des Gildenmeisters. Hierher"
         +" kommen alle, die Fragen haben, in der Hoffnung, Antwort zu"
         +" bekommen. Die Einrichtung laesst auf ein gemuetliches Wohnen"
         +" schliessen. Du siehst einen Arbeitstisch mit einem aeusserst"
         +" gemuetlichen Sessel davor, einige Regale mit Papierstapeln an"
         +" den Waenden und eine kleine Chaiselongue fuer die Schlummerstunden"
         +" des Chefs."));

  AddDetail("boden", BS(
            "Hier und da liegt noch ein vereinzelter Zettel am Boden."));
  AddDetail("zettel", BS(
            "Es duerfte sich dabei nur um ein Antragsformular handeln."));
  AddDetail(({"formular", "antragsformular"}), BS(
            "Du kannst auf dem Zettel das Wort 'Antragsformular' erkennen,"
           +" es ist schon ausgefuellt."));
  AddDetail("wort", BS(
            "Wort? Welches Wort meinst Du denn? Drueck Dich genauer aus."));
  AddDetail("zimmer", BS(
            "Dieses Zimmer ist das des Gildenmeisters."));
  AddDetail("fragen", BS(
            "Wenn Du Fragen an den Gildenmeister hast, dann stell sie ihm"
           +" doch."));
  AddDetail("hoffnung", BS(
            "Hoffst Du auch auf die Beantwortung all Deiner Fragen?"));
  AddDetail(({"antwort", "beantwortung"}), BS(
            "Vielleicht bekommst Du ja die richtige Antwort auf all Deine"
           +" Fragen."));
  AddDetail(({"wand", "waende"}), BS(
            "An den Waenden haengen einige Regale, und an der oestlichen"
           +" Wand befindet sich eine Luke."));
  AddDetail(({"regale", "regal"}), BS(
            "Auf den Regalen siehst Du viele Papierstapel und diversen"
           +" Krimskrams."));
  AddDetail(({"papierstapel", "stapel"}), BS(
            "Die Papierstapel bestehen aus lauter unwichtigen Zetteln"
           +" und Wechseln."));
  AddDetail("wechsel", BS(
            "Scheinbar gibt es hier auch einige verschuldete Mitglieder."));
  AddDetail("mitglieder", BS(
            "Du koenntest niemans Mitglied der Gilde werden."));
  AddDetail("gilde", BS(
            "Dies ist die Gilde des elfenbeinernen Tigers."));
  AddDetail("tiger", BS(
            "Pass auf, dass Dich der Tiger nicht erwischt."));
  AddDetail(({"tisch", "arbeitstisch"}), BS(
            "Am Arbeitstisch scheint der Gildenmeister die meiste Zeit zu"
           +" verbringen. Es tuermen sich viele Papierfetzen und Akten"
           +" die alle noch bearbeitet werden wollen."));
  AddDetail(({"papierfetzen", "fetzen"}), BS(
            "Unglaublich was ein Gildenmeister so alles bearbeiten muss!"));
  AddDetail("akten", BS(
            "Es handelt sich scheinbar um die Akten von allen observierten"
           +" Wesen... Du erkennst Namen wie 'Creative', 'Woody', 'Zordan', 'Elsurion',"
           +" 'Angrox' auf den Rueckenschildern."));
  AddSpecialDetail( ({"woody", "angrox", "zordan", "elsurion", "creative"}),
      "akten");
  AddDetail("wesen", BS(
            "Alle Wesen scheinen observiert zu werden!"));
  AddDetail(({"schilder", "rueckenschilder"}), BS(
            "Auf den Rueckenschildern der Akten erkennst Du erschreckend viele"
           +" Dir bekannte Namen."));
  AddSpecialDetail("namen", "names");
  AddDetail("chef", BS(
            "Der Chef ist der Gildenmeister."));
  AddDetail("luke", BS(
            "Durch die Luke bestellt der Chef meist etwas bei seinem"
           +" Adjutant."));
  AddDetail("adjutant", BS(
            "Den Adjutanten findest Du weiter im Osten."));
  AddDetail("sessel", BS(
            "Der Sessel ist gut gepolstert und sieht richtig gemuetlich aus."));
  AddDetail("wohnen", BS(
            "Wohnen kann man hier bestimmt sehr gut. Alles da was man braucht."));
  AddDetail("decke", BS(
            "Die Decke ist uebersaet mit Schlammspritzern."));
  AddDetail(({"schlamm", "spritzer", "klumpen", "schlammklumpen", "schlammspritzer"}), BS(
            "Du kannst versuchen Dir einen Schlammklumpen zu formen."));
  AddDetail("mitglied", BS(
            "Mitglied zu werden ist fuer Dich unmoeglich."));
  AddDetail(({"stuhl", "chaiselongue"}), BS(
            "Die Chaiselongue ist etwas aehnliches wie ein Stuhl, auf den man sich"
           +" hinlegen kann und die Fuesse hochlegen."));
  AddDetail("fuesse", BS(
            "Deine Fuesse hochlegen musst Du wirklich nicht, Du bist ausgerastet"
           +" genug."));
  AddDetail(({"stunden", "schlummerstunden"}), BS(
            "Fuer die Stunden in denen man etwas schlummern moechte ist die"
           +" Chaiselongue sehr gut geeignet."));
  AddDetail("zeit", BS(
            "Um alle Formalitaeten zu erledigen muss der Chef wohl viel Zeit"
           +" in diesem Zimmer zubringen."));
  AddDetail("formalitaeten", BS(
            "So eine Gilde regelt sich nicht allein, also muss sich der Chef eben"
           +" um die Formalitaeten kuemmern."));
  AddDetail("einrichtung", BS(
            "Dir wird wohlig warm ums Herz wenn Du die huebsche Einrichtung"
           +" (die noch dazu zweckmaessig ist) betrachtest."));
  AddDetail("herz", BS(
            "Hoffentlich schlaegt das Deine noch, sonst waerst Du tot!"));
  AddDetail("krimskrams", BS(
            "Viel Krimskrams liegt auf den Regalen, der es gar nicht wert ist,"
           +" ihn zu untersuchen."));

  AddSound(DEFAULT_SOUND, BS(
           "Man hoert rein gar nichts, die Stille ist aber dermassen"
          +" angenehm, dass man sich dabei richtig gut konzentrieren kann."));
  AddSound(({"ruhe", "stille"}), BS(
           "Du bist froh ueber diese Ruhe und geniesst sie direkt."));

  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht ein wenig nach Tee, der Gildenmeister scheint ja Tee"
          +" ueber alles zu lieben."));
  AddSmell("tee", BS(
           "Du kannst Dich nicht darauf einigen, um welchen Tee es sich"
          +" handelt, den Du erschnuppern kannst."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddItem(NPC("gm"), REFRESH_DESTRUCT);
  AddExit("westen", ROOM("h4"));
  AddCmd(({"form", "forme"}), "form");
  klump=1;
}

reset()
{
  ::reset();
  klump=1;
}

names()
{
  string *f, r;
  int i;

  f=TP->QueryProp("waitfor");
  r="Hoffentlich entdeckst Du nicht Deinen Namen irgendwo auf einem"
   +" der Rueckenschilder. Du erkennst unter anderem: ";

  if (sizeof(f)<1)
  return BS(r);


  if (sizeof(f)>1)
    for (i=sizeof(f)-1; i>=1; i--)
      r+="'"+CAP(f[i])+"', ";
  r+="'"+CAP(f[0])+"'.";
  return BS(r);
}

form(str)
{
  notify_fail("Was willst Du formen?\n");
  if (!str || str=="")
    return 0;
  if (str!="schlammklumpen" && str!="klumpen")
    return 0;
  if (!klump) {
    write(BS("Der Schlamm an der Decke reicht nicht aus fuer einen ordentlichen"
         +" Schlammklumpen."));
    return 1;
  }
  write(BS("Du schnappst Dir genuegend Schlamm von der Decke und formst einen"
       +" huebschen Schlammklumpen."));
  say(TPN+" formt sich einen Schlammklumpen.\n");
  (clone_object(OBJ("klumpen")))->move(TP);
  klump=0;
  return 1;
}

string akten(string who) {
  string akten;
  switch(who) {
    case "woody": 
      return 
           " ---------\n"
           "|  Woody  |\n"
           "+---------+----------------------------------------------------\n"
           "| Voller Name: Woody\n"
           "| Funktion   : Gott\n"
           "| \n"
           "| Subjekt verhaelt sich aeusserst verdaechtig. Angeblich im \n"
           "| Besitz von Informationen zu einem Ort namens 'Gaffodorf', \n"
           "| haelt dies jedoch sehr geheim.\n"
           "| \n\n"
	   "Den Rest kannst Du leider nicht entziffern.\n";
      break;
    case "angrox":  
      return 
           " ----------\n"
           "|  Angrox  |\n"
           "+----------+---------------------------------------------------\n"
           "| Voller Name: Angrox\n"
           "| Funktion   : Erzmagier fuer Gilden\n"
           "| \n"
           "| Subjekt weiss um das Geheimnis von magischen Gegenstaenden. \n"
           "| Unter staendiger Beobachtung von Lenti. Angeblich auch im \n"
	   "| Besitz mehrerer hochmagischer Yaris. \n"
           "| \n\n"
	   "Den Rest kannst Du leider nicht entziffern.\n";
      break;
    case "zordan":  
      return 
           " ----------\n"
           "|  Zordan  |\n"
           "+----------+---------------------------------------------------\n"
           "| Voller Name: Zordan\n"
           "| Funktion   : Erzmagier, Sheriff\n"
           "| \n"
           "| Subjekt aeusserst gefaehrlich, hat jedoch keine Kenntnis von\n"
	   "| von unserer Existenz. Trotz mehrerer Versuche Informationen\n"
	   "| von Spielern zu sammeln ist sein Wissen ueber unsere\n"
	   "| Organisation mehr als gering.\n"
	   "| Subjekt kennt weiters die Rezepturen mehrerer magischer\n"
	   "| Elexiere.\n"
	   "| \n\n"
	   "Den Rest kannst Du leider nicht entziffern.\n";
      break;
    case "creative":  
      return 
           " ------------\n"
           "|  Creative  |\n"
           "+------------+-------------------------------------------------\n"
           "| Voller Name: Creative\n"
           "| Funktion   : Untergrunderzmagier\n"
	   "| Codename   : Murga\n"
           "| \n"
           "| Wichtigster Informant, versorgt die Organisation mit \n"
	   "| neuesten Informationen der Magier und Goetter. Weiters\n"
	   "| stellt er der Organisation mehrere magische Yaris zur\n"
	   "| Verfuegung. Forscht gerade am Geheimnis des Kugelblitzes.\n"
	   "| \n\n"
	   "Den Rest kannst Du leider nicht entziffern.\n";
      break;
  }
  return "Leider kannst Du nichts entziffern.\n";

}
