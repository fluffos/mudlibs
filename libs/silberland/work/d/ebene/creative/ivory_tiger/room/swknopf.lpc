
press(str) {
  int r;

  if (call_other(SWMASTER, "query_color")=="")
    return 0;
  notify_fail("Was willst Du druecken?\n");
  if (str!="knopf")
    return 0;
  r=call_other(SWMASTER, "press_switch");
  switch(r) {
    case 0: write("Irgendetwas stimmt hier nicht!\n");
	    break;
    case 1: write("Du drueckst den Knopf und hoerst ein leises *klack* von irgendwoher.\n");
	    break;
    case 2: write("Du drueckst den Knopf und hoerst ein leises *klock* von irgendwoher.\n");
	    break;
    default: write("Du drueckst den Knopf, doch nichts passiert.\n");
  }
  return 1;
}

