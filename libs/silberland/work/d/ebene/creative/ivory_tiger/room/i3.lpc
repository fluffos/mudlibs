/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Vor dem Holztor");

  SetProp(P_INT_LONG, BS(
          "Du stehst vor einem renovierten Holztor, durch den ein Weg nach"
         +" Nordwesten fuehrt. Weiters gehts nach Osten und Suedwesten. Die"
         +" Erbauer des Holztores legten scheinbar viel Wert auf Stabilitaet,"
         +" denn obwohl es renoviert wurde, ist die Grundsubstanz immer noch"
         +" von ausgezeichneter Qualitaet."));
  AddSpecialDetail(({"tor", "holztor"}), "portal");
  AddDetail("erbauer", BS(
            "Ohne die Erbauer wuerde es dieses maechtige Tor wohl kaum geben."));
  AddDetail(({"substanz", "grundsubstanz", "holz"}), BS(
            "Das Holz des Tores ist von ausgezeichneter Qualitaet. Auf dem"
           +" rechten Pflock siehst Du eine kleine Schnitzerei."));
  AddDetail("pflock", BS(
            "Der rechte Pflock erregt Dein Interesse."));
  AddDetail("interesse", BS(
            "Haettest Du kein Interesse, wuerdest Du hier nicht so viel"
           +" herumforschen!"));
  AddDetail("schnitzerei", BS(
            "Die Schnitzerei zeigt einen Tiger, dem gerade das Fell gekaemmt wird."));
  AddDetail("tiger", BS(
            "Der Tiger auf der Schnitzerei ist irr gut dargestellt."));
  AddDetail("fell", BS(
            "So ein Tiger bestitzt wahrhaftig ein schoenes Fell."));
  AddDetail("boden", BS(
            "Am Boden siehst Du grosse Holzplanken."));
  AddDetail("holzplanken", BS(
            "Genauso wie das Tor ist der Boden mit bestem Holz verarbeitet."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Waende sind ueberraschenderweise tapeziert."));
  AddDetail(({"tapete", "tapeten"}), BS(
            "Wie kaum anders zu erwarten findest Du auf der Tapete einige"
           +" Zeichnungen von Tigern."));
  AddDetail(({"zeichnung", "zeichnungen"}), BS(
            "Die Zeichnungen des Tigers wiederholen sich oft auf der Tapete."));
  AddDetail("decke", BS(
            "Die Decke ist nichts anderes als grob behauener Stein."));
  AddDetail(({"erdreich", "reich", "gestein", "stein"}), BS(
            "Ober Dir befindet sich natuerlich nur Erdreich, und ein wenig"
           +" Gestein."));
  AddDetail(({"erscheinungen", "ermuedungserscheinungen"}), BS(
            "Sieht man vom Holz ab, das keine solchen Erscheinungen zeigt,"
           +" so koenntest Du doch mal wieder ein kleines Paeuschen vertragen."));
  AddDetail("paeuschen", BS(
            "So raste Dich doch ein mal aus, dann hast Du bestimmt genug"
           +" Paeuschen eingelegt."));
  AddDetail("qualitaet", BS(
            "Du bist erstaunt, in welcher Qualitaet sich das Holz ueber die"
           +" Jahre gehalten hat."));
  AddDetail("jahre", BS(
            "Es muss schon viele viele Jahre her sein, als dieses Tor gebaut"
           +" wurde."));
  AddDetail("stabilitaet", BS(
            "Du klopfst vorsichtig an das Holztor und stellst fest: sehr stabil."));
  AddDetail("wert", BS(
            "Stabilitaet an sich ist auf alle faelle einiges wert."));

  AddDetail("nordwesten", BS(
            "Weiter nach Nordwesten gehts scheinbar in ein altes Gemaeuer."));
  AddDetail("gemaeuer", BS(
            "Hier scheint frueher eine Festung gewesen zu sein."));
  AddDetail("festung", BS(
            "Die Festung war wohl eher ein System von unterirdischen Gaengen."));
  AddDetail(({"system", "gaenge", "gang"}), BS(
            "In einem dieser Gaenge befindest Du Dich ja gerade."));
  AddDetail("weg", BS(
            "Der Weg fuehrt von Osten nach Suedwesten."));

  AddSound(DEFAULT_SOUND, BS(
           "Nichts zu hoeren! Ausser vielleicht einem leisen Aechzen."));
  AddSound("aechzen", BS(
           "Das bist ja Du, der hier herumaechzt!"));

  AddSmell(DEFAULT_SMELL, BS(
           "Irgendwie riecht es hier abenteuerlich. Der Geruch scheint"
          +" vom Nordwesten her zu dringen."));
  AddSmell(({"nordwesten", "geruch"}), BS(
           "Hm, so abenteuerlich war der Geruch gar nicht. Aber Du bekommst"
          +" Durst, denn es riecht sehr gut nach frisch gebrautem Bier."));
  AddSmell("bier", BS(
           "Diesem Geruch koenntest Du fast mal nachgehen."));
  AddSmell("durst", 
      "Durst kann man nicht riechen, nur haben.");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("j3"));
  AddExit("suedwesten", ROOM("h4"));
  AddExit("nordwesten", ROOM("h2"));
  AddCmd(({"drueck", "druecke"}), "press");
}

string portal() {
  string s, c;

  s="Das Holztor fuehrt nach Nordwesten. Das Holz, aus dem es gemacht"
    +" ist, gehoert scheinbar zu den zaehesten, die es gibt, denn es"
    +" zeigt keine Ermuedungserscheinungen, obwohl es schon einmal"
    +" renoviert wurde.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" Du entdeckst an dem Tor einen Knopf in Form eines Tigers, der "+c+" leuchtet.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

