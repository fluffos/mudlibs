/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

create()
{
  ::create();

  SetProp(P_ZONE, "Noerdlicher Wehrturm");
  SetProp(P_INT_SHORT, "Im noerdlichen Wehrturm");

  SetProp(P_INT_LONG, BS(
          "Du stehst in einem alten Gang im noerdlichen Wehrturm, der"
         +" frueher mal zu einer gewaltigen Festung gehoert haben mag."
         +" Er wirkt jedoch noch sehr stabil und Du kannst getrost weiter"
         +" ins Unbekannte vorstossen."));
  AddDetail("gang", BS(
            "Du bist mitten im Gang des alten noerdlichen Wehrturms."));
  AddDetail("boden", BS(
            "Am Boden sitzt direkt an der noerdlichen Wand ein kleiner"
           +" Kaefer."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Waende sind wie ueberall hier stabil aus Ziegeln gebaut."));
  AddDetail("ziegel", BS(
            "Wieviel Ziegel man hier wohl gebraucht hat?"));
  AddDetail("kaefer", BS(
            "Der kleine Kaefer sitzt gemuetlich da und dreht aus dem Staub"
           +" und allem was sonst noch so herumliegt kleine Pillen."));
  AddDetail("staub", BS(
            "Sehr viel Staub liegt hier ueberraschenderweise gar nicht."));
  AddDetail(({"dreher", "pillendreher", "pillen"}), BS(
            "Weil der Kaefer solche kleinen Pillen dreht, nennt man ihn"
           +" wahrscheinlich auch Pillendreher."));
  AddDetail("festung", BS(
            "Um was es sich fuer eine Festung handelt, zu der einmal dieser"
           +" Wehrturm gehoert hat, ist nicht bekannt."));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Hast Du denn schon einmal den suedlichen Wehrturm besucht? Hier"
           +" befindest Du Dich naemlich im noerdlichen."));
  AddDetail("decke", BS(
            "Die Decke leuchtet von selber. Erstaunlich, es scheint so etwas"
           +" aehnliches zu sein wie Edelstein oder Kristall, denn woher"
           +" kaeme sonst diese Leuchtkraft?"));
  AddDetail("edelstein", BS(
            "Du entschliesst Dich, dass die Decke nicht aus Edelstein bestehen"
           +" kann, sonst waere das Leuchten nicht so stark."));
  AddDetail("leuchten", BS(
            "Die Decke leuchtet richtiggehend von sich aus."));
  AddDetail(({"leuchtkraft", "kraft"}), BS(
            "Du bist ueberrascht, mit welcher Kraft die Decke von sich aus"
           +" leuchten kann.")),
  AddSpecialDetail("kristall", "crystal");
  AddDetail("polaris", BS(
            "Du suchst Polaris? Dann bist Du hier bestimmt voellig falsch."));
  AddDetail(({"unbekanntes", "unbekannte"}), BS(
            "Unheimliche Geschichten hoert man vom noerdlichen Wehrturm."
           +" Boese Wesen soll es hier in den Katakomben geben."));
  AddDetail("katakomben", BS(
            "Die Katakomben befinden sich hier irgendwo im suedlichen Wehrturm."));
  AddDetail("wesen", BS(
            "Man hat schon ueble Geschichten gehoert, von Freiwilligen, die"
           +" in die Katakomben gingen und nie wieder zurueck kamen!"));
  AddDetail("freiwillige", BS(
            "Ausser den Dieben traut sich fast keiner in die Katakomben hinab."));
  AddDetail("geschichten", BS(
            "Bestimmt findest Du jemanden, der ueber die Katakomben bescheid"
           +" weiss."));
  AddDetail("diebe", BS(
            "Von Dieben wimmelt es doch nur so!"));

  AddSound(DEFAULT_SOUND, BS(
           "Ganz weit von Osten dringt noch das Klimpern von Besteck und"
          +" das Klirren von Glaesern an Dein Ohr."));
  AddSound( ({"ohr"}),
      "Dein Ohr ist ganz leise.");
  AddSound("klimpern", BS(
           "Da scheint jemand weit im Osten etwas gutes zu essen."));
  AddSound( ({"klirren", "glaesern", "glaeser"}), BS(
           "Hast Du nicht auch Durst und willst mit denen, die da gerade"
          +" beisammensitzen anstossen?"));
  AddSound( ({"klimpern", "besteck"}),
      "Du hoerst das Klimpern von Besteck.");

  AddSmell(DEFAULT_SMELL, BS(
           "Wenn Du einen Begriff suchst fuer das, wonach es hier riecht:"
          +" Du wuerdest 'neutral' am besten finden."));
  AddDetail( ({"begriff"}),
      "Du bist offenbar schwer von demselben, wenn Du das hier suchst.");
  AddDetail( ({"durst"}),
      "Naja, eine Kleinigkeit kann ja nicht schaden.");
  AddDetail( ({"kleinigkeit", "beispiel"}),
      "Eine lauwarme Milch zum Beispiel.");
  AddDetail( ({"milch"}),
      "Mjam, Du magst jetzt sofort eine euterwarme Milch.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("h1"));
  AddExit("westen", ROOM("f1"));
  AddCmd(({"zaehl", "zaehle"}), "cnt");
  AddCmd(({"drueck", "druecke"}), "press");
}

cnt(str)
{
  notify_fail("Was willst Du zaehlen?\n");
  if (str!="ziegel")
    return 0;
  write(BS(
      "Du zaehlst eifrig die Ziegel und glaubst, dass es in etwa "
     +(70+random(15))+" Ziegel sind. Oder doch nicht?"));
  return 1;
}

string crystal() {
  string s, c;

  s="Bestimmt ist die Decke aus dem speziellen Kristall, den man"
    +" nur noerdlich von Polaris findet.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" Der Kristall schimmert "+c+", und Du erkennst in greifbarer Naehe"
      +" einen Knopf in Form eines Tigers.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

