/*
  Ebony Tiger Guild
*/

#include "../files.h"
#include "../quest.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int block;

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Vor dem Zimmer des Meisters");

  SetProp(P_INT_LONG, BS(
          "Du stehst vor dem Zimmer des Gildenmeisters. Der Weg fuehrt"
         +" von Nordosten nach Suedosten und ist durch die vielen Fackeln"
         +" an der Wand gut ausgeleuchtet. Neben der Tuer haengt ein"
         +" Schild."));
  AddDetail("boden", BS(
            "Der Boden ist fast klinisch sauber, hier wird scheinbar"
           +" wirklich gut gekehrt."));
  AddDetail(({"wand", "waende"}), BS(
            "An der westlichen Wand haengen eine ganze Menge Fackeln,"
           +" die hier ein sehr gutes Licht abgeben."));
  AddDetail("menge", BS(
            "Du zaehlst nach... 1, 2, 3, 4, viele."));
  AddDetail("fackeln", BS(
            "Die Fackeln an der Wand brennen hell leuchtend und erhellen"
           +" den Raum sehr gut. Eine Fackel allerdings scheint erloschen."));
  AddDetail("fackel", BS(
            "Welche Fackel meinst Du? Eine brennende oder die erloschene?"));
  AddDetail("brennende fackel", BS(
            "Die brennende Fackel die Du untersuchst brennt, wie zu erwarten"
           +" war."));
  AddDetail("erloschene fackel", BS(
            "Da brennt tatsaechlich eine einzelne Fackel nicht. Du ueberlegst,"
           +" ob es dafuer einen Grund geben koennte."));
  AddDetail("grund", BS(
            "Du versuchst, mithilfe der anderen Fackeln die eine Fackel"
           +" anzuzuenden, aber es gelingt Dir nicht. Ein heftiger Wind"
           +" scheint die Fackel immer wieder auszublasen."));
  AddDetail("wind", BS(
            "Du spuerst den Wind ganz deutlich, wenn Deine Hand die Wand in der"
           +" Naehe der einen erloschenen Fackel absucht. Da muss wo ein Loch"
           +" sein."));
  AddDetail(({"meister", "gildenmeister", "zimmer"}), BS(
            "Im Zimmer oestlich von Dir ist er anzutreffen, der Gildenmeister."));
  AddDetail("schild", BS(
            "Man kann es lesen."));
  AddReadDetail("schild", BS(
                "'Gildenmeister - Sprechstunden taeglich von 10:00-12:00'"));
  AddDetail("gold", BS(
            "Die Tuere besteht aus purem Gold."));
  AddDetail("verzierungen", BS(
            "Wie Du schon vermutet hast, befinden sich auf der Tuere Verzierungen"
           +" in Form von Tigern."));
  AddDetail("form", BS(
            "Die Verzierungen auf der Tuere stellen Tiger dar."));
  AddDetail("tiger", BS(
            "Der Tiger ist das Symbol von allem hier."));
  AddDetail("symbol", BS(
            "Das Symbol, das hier ueberall zu finden ist, ist der Tiger."));
  AddDetail("raum", BS(
            "Neben diesem Raum liegt das Zimmer des Gildenmeisters. Es laesst"
           +" sich durch die Tuere betreten."));
  AddDetail("decke", BS(
            "Auch die Decke ist aufgrund der Fackeln sehr gut ausgeleuchtet."));
  AddDetail("licht", BS(
            "Die Fackeln an der Wand sorgen fuer ein angenehm helles Licht."));
  AddDetail("loch", BS(
            "Tatsaechlich, hinter der Fackel, ganz verdeckt durch abgebranntes"
           +" Pech, befindet sich ein Loch. Ob da was drinnen sein mag?"));
  AddDetail(({"pech", "pechfackel"}), BS(
            "Auch eine Pechfackel befindet sich hier."));
  AddDetail("weg", BS(
            "Der Weg fuehrt von Nordosten nach Suedosten. Nach Osten kommst"
           +" Du ins Zimmer des Gildenmeisters."));

  AddSound(DEFAULT_SOUND, BS(
           "Die Fackeln an der Wand flackern so heftig, dass man sich"
          +" fast die Ohren zuhalten muss."));
  AddDetail( ({"ohren"}),
      "Ja Du hast zwei Ohren. Am liebsten wuerdest Du beide zuhalten.");
  AddSound( ({"ohren"}),
      "Du kannst Deine Ohren nicht hoeren. Irgendwie kommst Du zu dem "
      "Schluss, dass Du heute etwas komisch drauf bist.");
  AddDetail( ({"schluss"}),
      "Ende.");
  AddDetail( ({"ende"}),
      "Schluss.");
  AddSound("flackern", BS(
           "Waaah ist das Flackern der Fackel laut."));

  AddSmell(DEFAULT_SMELL, BS(
           "Nachdem hier an der Wand unter anderem eine Pechfackel befestigt"
          +" ist, riecht es hier stark nach Pech."));
  AddSmell(({"pech", "pechfackel", "geruch", "pechgeruch"}), BS(
           "Der Pechgeruch ist ziemlich dominierend."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("l4"));
  AddExit("nordosten", ROOM("i3"));
  AddExit("suedosten", ROOM("i5"));

  NewDoor("osten", ROOM("i4"),
          ({ "goldtuer", "tuer", "tuere", "goldtuere"}), 
	  ({ D_NAME, "Goldtuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine Tuer aus purem Gold (%s).\n",
	     D_LONG, BS(
	       "Diese Tuere besteht aus purem Gold und hat zahlreiche Verzierungen."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY
	  }));
  block=1;
  AddCmd(({"greif", "greife"}), "hole");
}

hole(str)
{
  object b;
  int flag, block_da;
  notify_fail("Wo moechtest Du reingreifen?\n");
  if (!str || str!="in loch")
    return 0;
  if(b=deep_present(IV_QUEST_ITEM, TP))
    flag=b->check_flag(IV_GET_NOTEPAD);
  if ((!b && !TP->QueryQuest(IV_QUEST))) {
    write(BS(
          "Ein leeres Loch. Seltsam irgendwie."));
    return 1;
  }
  if (b && flag==1 && !b->check_flag(IV_GIVE_BOOK) && !deep_present(IV_NOTEPAD, TP))
    block_da=1;
  else if (b && flag==0) {
    block_da=1;
  }
  else if (TP->QueryQuest(IV_QUEST) && block) {
    block_da=1;
    block=0;
  }
  if (!block_da) {
    write(BS(
          "Du greifst mit Deiner Hand tief in das Loch und bemerkst, dass"
          +" hier vor kurzem noch etwas gelegen haben muss."));
  }
  else {
    if(objectp(b)) b->set_flag(IV_GET_NOTEPAD);
    b=clone_object(OBJ("block"));
    b->move(TP, M_NOCHECK);
    write(BS(
          "Du greifst mit Deiner Hand tief in das Loch und ertastest etwas"
          +" aus Papier, das Du sofort einsteckst."));
    block=0;
  }
  say(TPN+" greift mit seiner Hand hinter die Fackeln.\n");
  return 1;
}

reset()
{
  ::reset();
  
  block=1;
}

