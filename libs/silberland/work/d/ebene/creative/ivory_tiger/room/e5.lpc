/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

create()
{
  ::create();

  SetProp(P_ZONE, "Suedlicher Wehrturm");
  SetProp(P_INT_SHORT, "An der Treppe");

  SetProp(P_INT_LONG, BS(
          "Du siehst eine schmale leicht gewundene Treppe nach oben, die"
         +" durch ein dunkles Loch fuehrt. Jedoch faellt durch eine Ritze"
         +" von oben Licht herein."));
  AddDetail("boden", BS(
            "Der Boden hier ist kaum verstaubt, aber jede Menge Fussabdruecke"
           +" kannst Du hier auf dem leicht schmutzigen Boden sehen."));
  AddSpecialDetail(({"abdruecke", "fussabdruecke"}), "abdruck");
  AddDetail("platz", BS(
            "Du bist an der Treppe des ehemaligen Wehrturms, im suedlichen"
           +" Teil der alten Festung."));
  AddDetail("treppe", BS(
            "Die Treppe fuehrt nach oben."));
  AddDetail("loch", BS(
            "Nach oben siehst Du ein Loch, durch das die Treppe fuehrt. Mitten"
           +" im Loch siehst Du eine kleine Ritze, durch die spaerlich Licht"
           +" faellt."));
  AddDetail("ritze", BS(
            "Oben im Loch siehst Du eine kleine Ritze, durch die ein wenig"
           +" Licht faellt."));
  AddDetail("licht", BS(
            "Das Licht kommt von oben durch die Ritze."));
  AddDetail("decke", BS(
            "An der Decke siehst Du ein Loch. Und mitten im Loch kannst Du"
           +" eine Ritze erkennen, durch die das Licht durchfaellt."));
  AddDetail("festung", BS(
            "Hier befindest Du Dich im Wehrturm der alten Festung, die heute"
           +" ganz anderen Zwecken zu dienen scheint."));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Im suedlichen Wehrturm befinden sich unter anderem auch der"
           +" Laden und ein Friseur."));
  AddDetail("friseur", BS(
            "Warst Du schon beim Friseur?"));
  AddDetail("laden", BS(
            "Um zum Laden zu gelangen musst Du Dich weiter oestlich halten."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Waende sind ueber und ueber mit Spinnweben bedeckt."));
  AddDetail(({"weben", "spinnweben"}), BS(
            "Du untersuchst die Spinnweben genauer und stellst fest, dass die"
           +" Naehe zur Erdoberflaeche hier sehr viele Tiere angelockt hat."));
  AddDetail("naehe", BS(
            "Ueberrascht stellst Du fest, dass es bis zur Erdoberflaeche"
           +" nicht weit ist."));
  AddDetail(({"oberflaeche", "erdoberflaeche"}), BS(
            "Du bist quasi nur wenige Schritte von der Erdoberflaeche entfernt!"));
  AddDetail(({"schritte", "tips", "schritt"}), BS(
            "Wieviel Tips brauchst Du noch? Du musst nach oben."));
  AddDetail("tiere", BS(
            "Viele Tiere scheinen sich hier in den Fugen der Waende aufzuhalten."));
  AddDetail("fugen", BS(
            "Nachdem die Waende gemauert sind, haben sie natuerlich auch Fugen,"
           +" in denen sich jetzt verschiedene Tiere aufzuhalten scheinen,"
           +" darunter auch einige huebsche Spinnen."));
  AddDetail("spinnen", BS(
            "So sehr Du Dich auch bemuehst, kannst Du keine dieser niedlichen"
           +" Tiere sehen."));
  AddDetail("menge", BS(
            "Hier gibt es wirklich eine ganze Menge Fussabdruecke."));
  AddDetail("teil", BS(
            "Dieser Teil der Festung ist suedlicher als der noerdliche Teil."));
  AddDetail(({"zweck", "zwecke"}), BS(
            "Der Zweck der alten Festung ist noch nicht ganz offensichtlich."));

  AddSound(DEFAULT_SOUND, BS(
           "Das Pfeifen des Windes von oben erscheint Dir richtig"
          +" angenehm, hast Du doch so ein aehnliches Geraeusch schon"
          +" lange nicht mehr vernommen."));
  AddSound(({"geraeusch", "wind", "pfeifen"}), BS(
           "Je laenger Du hier unten verweilt hast, desto angenehmer muss"
          +" fuer Dich das Geraeusch des Windes klingen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Auch wenn Du es niemand eingestehen willst, aber es riecht hier"
          +" ein bisschen nach Freiheit."));
  AddSmell("freiheit", BS(
           "Nur ein Schritt trennt Dich von der freien Natur mit all ihren"
          +" Geruechen und Geraeuschen. Hier unten war doch alles ein wenig"
          +" eng und bedrueckend."));
  AddDetail( ({"natur"}),
      "Die muss gleich in der Naehe sein.");
  AddDetail( ({"naehe"}),
      "Gleich hier!");
  AddSmell( ({"geruechen", "duft"}),
      "Der Duft von Gras und Kuhdung steigt Dir die Nase hoch.");
  AddSmell( ({"gras"}),
      "Mhhh, wie herrich das Gras duftet.");
  AddSmell( ({"kuhdung"}),
      "Baeh, das stinkt. Oh, nein, das bist ja Du!");
  AddSmell( ({"nase"}),
      "Deine Nase riecht nach nix.");

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("oben", "/d/ebene/creative/feldlager/room/a8_a7");
  AddExit("suedosten", ROOM("f6"));
  AddCmd(({"drueck", "druecke"}), "press");
}

init()
{
  ::init();
  call_other(ROOM("f1"), "???");
  call_other(ROOM("k4"), "???");
  call_other(ROOM("f6"), "???");
  call_other(ROOM("h6"), "???");
  call_other(ROOM("e5"), "???");
}

string abdruck() {
  string s, c;

  s="Hier scheint ein haeufig frequentierter Platz zu sein, wenn"
    +" man die Menge Fussabdruecke betrachtet. Hoppla, da sind ja"
    +" Deine eigenen auch dabei!";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" Zwischen 2 besonders grossen und interessanten Fussabdruecken findest Du"
      +" einen kleinen unscheinbaren "+c+" leuchtenden Knopf in Form eines Tigers.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

