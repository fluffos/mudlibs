/*
  Ebony Tiger Guild
*/

#include "../files.h"
#include "../quest.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

nosave object turner;
nosave object turned;

nosave int laterne;

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Im Wasserwerk");

  SetProp(P_INT_LONG, BS(
          "Der Raum ist spaerlich eingerichtet. Gewaltige Raeder drehen"
         +" sich unaufhoerlich an den Waenden, ineinander verzahnt bis"
         +" zum kleinsten Rad. In der Mitte des Raumes steht ein Block"
         +" aus Stein, an dem eine gewaltige Kurbel angebracht ist."));
  AddDetail("raum", BS(
            "Dieser Raum ist dazu gedacht, die Wasserversorgung der"
           +" Gilde zu sichern."));
  AddDetail(({"werk", "wasserwerk", "wasserversorgung", "versorgung"}), BS(
            "Das Gebiet hier liegt unterhalb der Steppe, Wasser ist"
           +" demnach nicht im Ueberfluss vorraetig. Darum muss das"
           +" Wasser direkt aus dem Boden heraufgepumpt werden."));
  AddDetail("boden", BS(
            "Hier versucht man das Wasser aus dem Boden direkt"
           +" heraufzupumpen."));
  AddDetail("ueberfluss", BS(
            "In der Steppe ist Wasser nicht direkt im Ueberfluss vorhanden."));
  AddDetail("wasser", BS(
            "Wuerde hier nicht gearbeitet, gaebe es in den Raeumen der Gilde"
           +" kein Wasser."));
  AddDetail(({"gilde", "raeume"}), BS(
            "Du befindest Dich in einem Raum der Gilde."));
  AddDetail(({"wand", "waende"}), BS(
            "An den Waenden drehen sich gewaltige Raeder."));
  AddSpecialDetail(({"rad", "raeder"}), "wheel");
  AddDetail(({"steinblock", "block", "mitte"}), BS(
            "In der Mitte des Raumes steht ein gewaltiger Steinblock."));
  AddDetail("kurbel", BS(
            "Am Steinblock befestigt befindet sich eine riesige Kurbel,"
           +" die man betaetigen muss, um das Wasser aus dem Boden"
           +" hochzupumpen."));
  AddDetail(({"granit", "stein"}), BS(
            "Der Block in der Mitte des Raumes besteht aus extrem"
           +" harten Granit."));
  AddDetail("steppe", BS(
            "Direkt ober Dir befindet sich verwahrloste undurchdringbare"
           +" Steppenlandschaft."));
  AddDetail("gebiet", BS(
            "Du befindest Dich in der Gilde des elfenbeinernen Tigers."));
  AddDetail("tiger", BS(
            "Ob Tarion darueber etwas weiss?"));
  AddDetail("decke", BS(
            "Die Decke besteht genau wie der grosse Steinblock in der"
           +" Mitte des Raumes aus Granit."));
  AddDetail(({"landschaft", "steppenlandschaft"}), BS(
            "Du kannst von hier aus die Landschaft der Steppe gar nicht"
           +" untersuchen."));
  AddSpecialDetail("nische", "nische");
  AddSpecialDetail("laterne", "unt_laterne");

  AddSound(DEFAULT_SOUND, BS(
           "Die Raeder an den Waenden knarren unaufhoerlich waehrend"
          +" ihrer Bewegung."));
  AddSound(({"raeder", "rad"}), BS(
           "Die Raeder knarren sehr laut."));

  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht ein wenig muffig hier. Wie abgestandenes Wasser."));
  AddSmell("wasser", BS(
           "Nachdem hier vermutlich Wasser gefoerdert wird, riecht"
          +" es hier auch danach."));
  AddCmd(({"dreh", "drehe", "betaetige"}), "turn");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  AddItem(NPC("sklave"), REFRESH_DESTRUCT);
  
  AddExit("norden", ROOM("l5"));
  AddCmd(({"greif", "greife"}), "hole");
  turner=0; turned=0;
  laterne=1;
}

string wheel()
{
  if (present("sklave"))
    return "Die Raeder drehen sich irr schnell.\n";
  else
    return "Die Raeder drehen sich sehr langsam.\n";
}

int turn(string str)
{
  int r;

  notify_fail("Woran willst Du drehen?\n");
  if (!str)
    return 0;
  if (str!="kurbel" && str!="an kurbel")
    return 0;
  if (present("sklave")) {
    write("Tarion dreht schon energisch genug an der Kurbel.\n");
    return 1;
  }
  if (TP==turner) {
    r=5+random(TP->QueryAttribute(A_DEX));
    if (r>10) {
      write("Du drehst die Kurbel mit aller Kraft um eine ganze Umdrehung weiter. Die Anstrengung ueberfordert"
           +" Deine Kraefte ziemlich.\n");
      say(BS(TPN+" mueht sich sichtlich an der Kurbel ab und schafft eine volle Umdrehung."));
      TP->AddHp(r*(-3));
      turned=turner;
    }
    else {
      write("Du bemuehst Dich stark, die Kurbel zu drehen, schaffst es aber nicht.\n");
      say(BS(TPN+" sieht richtig laecherlich aus, wie er versucht an der Kurbel zu drehen."));
    }
    return 1;
  }
  if (TP->QueryAttribute(A_STR)>22) {
    write("Du drehst die Kurbel mit Mueh und Not nur ein kleines Stueckchen, weiter schaffst Du es nicht.\n");
    say(BS(TPN+" dreht die Kurbel aus Kraftmangel nur ganz ganz wenig um ihre Achse."));
    return 1;
  }
  write(BS("Du bist viel zu schwach. Werd erst mal so stark wie Tarion, dann"
       +" kannst Du auch an der Kurbel drehen."));
  return 1;
}

void set_turn(object plr) {
  string po;

  po=explode(file_name(PO), "#")[0];
  if (po!=NPC("sklave"))
    return;
  turner=plr;
}

object query_turned() {
  return turned;
}

void reset_turned() {
  turned=0;
}

int lantern_ok(object player) {
  object b;

  if (laterne)
    return 1;
  if (!player->QueryQuest(IV_QUEST) && (b=present(IV_QUEST_ITEM, player))) {
    if (!b->check_flag(IV_GET_LANTERN))
      return 1;
    return !deep_present(IV_LANTERN, player);
  }
}

string nische() {
  if (lantern_ok(TP))
    return BS(
        "In der Nische steht eine Laterne, die den Raum erhellt. Tarion mag es"
        +" lieber, wenn es hell ist.");
  else
    return BS(
        "Die Nische ist leer.");
}
string unt_laterne() {
  if (lantern_ok(TP))
    return BS(
        "In der Nische steht eine Laterne, die den Raum erhellt. Du koenntest "
        "in die Nische greifen um die Laterne zu holen.");
  else
    return BS(
        "Laterne? Wo?");
}

int hole(string str)
{          
  object b;
  int flag; 
  notify_fail("Wo moechtest Du reingreifen?\n");
  if (!str || str!="in nische")
    return 0;
  if (present("tarion")) {
    write(BS(
          "Tarion hindert Dich daran, in die Nische zu greifen."));
    return 1;
  }
  if (!lantern_ok(TP)) {
    write(BS("Die Nische ist leider leer. Vielleicht hast Du spaeter Glueck?"));
    return 1;
  }
  if (b=deep_present(IV_QUEST_ITEM, TP))
    b->set_flag(IV_GET_LANTERN);
  b=clone_object(OBJ("laterne"));
  b->move(TP, M_NOCHECK);
  write(BS(
        "Du greifst mit Deiner Hand in die Nische und nimmst Dir die Laterne"
        +" heraus. "));
  say(TPN+" greift mit seiner Hand in eine Nische.\n");
  laterne=0;
  return 1;
}

int query_laterne() {
  object b;
  int flag;
  if (!TI) return 0;
  b=deep_present(IV_QUEST_ITEM, TI);
  //tell_object(find_player("angrox"), sprintf("IVORY l6: TI = %O, questobject = %O, "
  //      "flag = %O, latern = %O\n", TI, deep_present(IV_QUEST_ITEM, TI), 
   //     b->check_flag(IV_GET_LANTERN), laterne));
  if(b) 
    flag=b->check_flag(IV_GET_LANTERN);
  else if (!TI->QueryQuest(IV_QUEST))
      return 0;
  else
      flag=1;
  if (flag) return laterne;
  else return 1;
}


int add_laterne() {
  string po;

  po=file_name(PO)[0..29];
  if (po == PATH)
    laterne=1;
}

