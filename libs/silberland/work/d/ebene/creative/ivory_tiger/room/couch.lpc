/*
  Ebony Tiger Guild
*/

#include "../files.h"
#include "../quest.h"
inherit "std/transport";

#include <moving.h>
#include <language.h>
#include <properties.h>

int ok, heb;

create() {
  ::create();

  SetProp(P_ZONE, "Suedlicher Wehrturm");
  SetProp(P_MAX_PASSENGERS, 1);
  SetProp(P_ENTERFAIL,
          "Auf der Couch sitzt schon jemand, da es zu eng ist, stehst Du wieder auf");
  SetProp(P_ENTERMSG, ({
          "setzt sich auf die Couch", "setzt sich neben Dich"}) );
  SetProp(P_LEAVEMSG, ({
          "steht auf", "steht von der Couch auf"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Couch");
  SetProp(P_SHORT, "Eine Couch");
  SetProp(P_INT_LONG, BS(
          "Du sitzt halb@@wo@@ auf einer gemuetlichen Couch"
         +" im kleinen Geschaeft des alten Wehrturms. Die Kissen sind sehr"
         +" gemuetlich und richtig kuschlig und die Lehne ist weich gepolstert."));
  SetProp(P_NO_TPORT, NO_TPORT_IN);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_INT_SHORT, "Auf der Couch");
  AddId("couch");
  AddDetail(({"polster", "kissen"}), BS(
            "Die Kissen sind mit einem sehr weichen Stoff bezogen. Richtig"
           +" einladend und gemuetlich sehen sie aus. Insgesamt besteht"
           +" die Couch aus 2 Sitzkissen und 3 Rueckenpolstern."));
  AddDetail(({"rueckenpolster", "lehne"}), BS(
            "Die drei Rueckenpolster bilden gleichzeitig die Lehne dieser"
           +" gemuetlichen Couch."));
  AddSpecialDetail("sitzkissen", "kis");
  AddDetail(({"unter kissen", "unter sitzkissen"}), BS(
            "Unter welches Sitzkissen moechtest Du schauen? Das linke oder das rechte?"));
  AddSpecialDetail(({"linkes sitzkissen", "linkes kissen"}), "lkis");
  AddSpecialDetail(({"rechtes sitzkissen", "rechtes kissen"}), "rkis");
  AddSpecialDetail(({"unter linkes sitzkissen", "unter linkes kissen"}), "slkis");
  AddSpecialDetail(({"unter rechtes sitzkissen", "unter rechtes kissen"}), "srkis");
  AddSpecialDetail("buch", "book");
  AddSpecialDetail(({"buchdeckel", "deckel"}), "deckl");
  AddSpecialDetail(({"zeichen", "schriftzeichen"}), "zei");
  AddSpecialDetail("schlitz", "schl");
  AddReadDetail(({"zeichen", "schriftzeichen"}), "@@schrzei@@");
  AddDetail("boden", BS(
            "Boden gibt es auf der Couch keinen."));
  AddDetail("decke", BS(
            "Eine Decke waere praktisch, Du koenntest Dich damit zudecken und"
           +" ein Schlaefchen halten, aber Du bist viel zu munter dazu."));
  AddDetail("schlaefchen", BS(
            "Nein, jetzt machst Du kein Schlaefchen, Du bist viel zu munter."));
  AddDetail(({"bezug", "stoff"}), BS(
            "Der Stoff, also der Bezug ist angenehm weich und kuschlig. Pass auf,"
           +" dass beim Rueberrutschen der Stoff nicht zu sehr beschaedigt wird."));
  AddDetail(({"wand", "waende"}), BS(
            "Die Waende der Couch sind ja nix andres wie die seitlichen Armlehnen."));
  AddDetail(({"lehnen", "armlehnen"}), BS(
            "Damit man sich gut aufstuetzen kann, hat die Couch seitlich"
           +" Armlehnen."));
  AddDetail("couch", BS(
            "Du befindest Dich auf einer gemuetlichen Couch. Sitzend."));
  AddDetail(({"geschaeft", "wehrturm"}), BS(
            "Die Couch steht im Geschaeft, welches sich wiederum im suedlichen"
           +" Wehrturm befindet."));
  AddDetail(({"backen", "pobacken"}), BS(
            "Du kannst Deine Pobacken nicht wirklich betrachten, aber Du versuchst,"
           +" sie mit Deinen Haenden zu betasten. Ah, gut, noch beide da."));
  AddSpecialDetail("haende", "hnds");

  AddSound(DEFAULT_SOUND, BS(
           "Die Kissen rascheln leicht, wenn Du Dich ein wenig bewegst."));
  AddSound(({"rascheln", "kissen"}), BS(
           "Wenn Du Dich bewegst, so rascheln die Kissen ganz leise."));

  AddSmell(DEFAULT_SMELL, BS(
           "Auch hier auf der Couch duftet es angenehm nach Holz, schliesslich ist"
          +" die ganze Umgebung mit Holz verkleidet."));
  AddSmell("holz", BS(
           "Hauptsaechlich und vor allem einheitlich Buchenholz schmuecken"
          +" Decke und Waende ausserhalb. Das Parkett am Boden ist Ahorn."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
 
  AddCmd(({"lieg", "liege", "leg", "lege", "setz", "sitz", "sitze"}),"myenter");
  AddCmd(({"steh", "stehe"}),"myleave");
  AddCmd(({"rutsch", "rutsche"}), "rutsch");
  AddCmd(({"hebe", "heb"}), "hkis");
  AddCmd(({"zieh", "ziehe"}), "pull");
  AddRoute(ROOM("g5"), 60, 0);
  connect(ROOM("g5"), "Kleines Geschaeft");
}

init() {
  ::init();
  ok=0;
  heb=0;
}

myenter(str) {
  string s;

  notify_fail("Worauf willst Du sitzen oder liegen?\n");
  if (!str)
    return 0;
  if (str!="couch" && str!="auf couch")
    return 0;
  s=query_verb();
  if (s=="lieg" || s=="liege" || s=="leg" || s=="lege") {
    tell_object(TP, 
        "Pah, Du bist ja gar nicht muede, hinlegen willst Du Dich jetzt nicht.\n");
    return 1;
  }

  if (ENV(TP)!=TO) {
    write("Du setzt Dich auf die Couch.\n");
    return Enter();
  }
  else
    write("Du sitzt bereits auf der Couch!\n");
  return 1;
}

myleave(str) {
  notify_fail("Willst Du denn nicht aufstehen?\n");
  if (!str || str!="auf")
    return 0;
  if (ENV(TP)==TO) {
    write("Du stehst auf.\n");
    return Leave();
  }
  else
    write("Du stehst ja bereits im Raum und sitzt nicht auf der Couch.\n");
  return 1;
}

rutsch(str) {
  notify_fail("Wohin willst Du rutschen?\n");
  if (!str)
    return 0;
  if (str!="rueber" && str!="nach rechts" && str!="nach links")
    return 0;
  if (ok && str=="nach rechts") {
    write("Du sitzt bereits auf der rechten Seite der Couch.\n");
    return 1;
  }
  if (!ok && str=="nach links") {
    write("Du sitzt bereits auf der linken Seite der Couch.\n");
    return 1;
  }
  if (heb)
    write("Du legst das Sitzkissen wieder an seinen Platz zurueck.\n");
  heb=0;
  write("Ok, Du rutscht auf die "+(ok?"linke":"rechte")+" Seite der Couch.\n");
  if (ok)
    write(BS(
          "Hmmm... verglichen mit der rechten Seite sitzt Du hier fast"
         +" etwas unbequem, irgendetwas drueckt von unten. Vielleicht"
         +" kannst Du das Kissen mal anheben und darunter schauen."));
  ok=1-ok;
  return 1;
}

string wo() {
  return (ok?"rechts":"links");
}

kis() {
  return BS(
      "Es gibt ein linkes und ein rechtes Sitzkissen. Du sitzt gerade auf"
     +" dem "+(ok?"rechten":"linken")+" davon.");
}

lkis() {
  if (!ok)
    return BS("Aber Du sitzt doch auf dem linken Kissen, das kannst Du dann nicht"
             +" untersuchen!");
  return BS("Das linke Kissen sieht genau aus wie das rechte, liegt jedoch"
           +" spiegelverkehrt dazu.");
}

rkis() {
  if (ok)
    return BS("Aber Du sitzt doch auf dem rechten Kissen, das kannst Du dann nicht"
             +" untersuchen!");
  return BS("Das rechte Kissen sieht genau aus wie das linke, liegt jedoch"
           +" spiegelverkehrt dazu.");
}

slkis() {
  if (!ok)
    return BS("Aber Du sitzt doch auf dem linken Kissen, da kannst Du dann nicht"
             +" darunterschauen!");
  if (!heb)
    return BS("Du hast das linke Kissen nicht angehoben, darum kannst Du auch nicht"
             +" darunterschauen!");
  return BS("Wie Du es vermutet hast. Unter dem Kissen liegt ein Buch, das"
           +" Dir ziemlich auf die Pobacken gedrueckt hat. Das Buch liegt"
           +" offen, mit den Buchdeckeln in einem Schlitz eingeklemmt,"
           +" vor Dir. Du kannst einige unleserliche Schriftzeichen erkennen.");
}

srkis() {
  if (ok)
    return BS("Aber Du sitzt doch auf dem rechten Kissen, da kannst Du dann nicht"
             +" darunterschauen!");
  if (!heb)
    return BS("Du hast das rechte Kissen nicht angehoben, darum kannst Du auch nicht"
             +" darunterschauen!");
  return BS("Mist, unter dem rechten Kissen liegt gar nix.");
}

hkis(str) {
  string which, d1, d2;

  notify_fail("Welches Kissen willst Du (an)heben?\n");
  if (!str)
    return 0;
  sscanf(str, "%s %skissen%s", which, d1, d2);
  if (d1!="" && d1!="sitz")
    return 0;
  if (d2!="" && d2!=" an")
    return 0;
  if (which!="linkes" && which!="rechtes")
    return 0;
  if (ok && which=="rechtes") {
    write(BS(
        "Du sitzt auf dem rechten Kissen, also kannst Du es auch nicht anheben!"));
    return 1;
  }
  if (!ok && which=="linkes") {
    write(BS(
        "Du sitzt auf dem linken Kissen, also kannst Du es auch nicht anheben!"));
    return 1;
  }
  if (heb) {
    write(BS(
        "Du hast das Kissen doch schon gehoben.\n"));
    return 1;
  }
  write("Du hebst das "+which[0..<2]+" Kissen an.\n");
  heb=1;
  return 1;
}

book() {
  if (ok && heb)
    if (present(IV_QUEST_ITEM, TP))
      return BS(
          "Du erinnerst Dich, dass Vannor mal erwaehnt hat, dass er auf der Suche"
         +" nach seltenen Buechern ist. Dieses hier scheint wirklich ein solches"
         +" zu sein. Du solltest den Inhalt des Buches zu Vannor bringen, er"
         +" wird Dir weiterhelfen koennen.");
    else
      return BS("Ein Buch mit merkwuerdigen Schriftzeichen.");
  else
    return "Sowas siehst Du da nicht!\n";
}

int MayCopy() {
  return (ok && heb);
}

zei() {
  if (ok && heb)
    return BS("Du kannst sie lesen.\n");
  return "Sowas siehst Du da nicht!\n";
}

schrzei() {
  if (ok && heb)
    return 
        "Vannor wird mit diesen Schriftzeichen wohl am meisten anfangen koennen,"
       +" denn\nso sehr Du Dich auch bemuehst, Du kannst die Schriftzeichen nicht"
       +" entziffern.";
  return "Was moechtest Du lesen?";
}

pull(str) {
  notify_fail("Was willst Du wo herausziehen?\n");
  if (!str)
    return 0;
  if (str!="buch aus schlitz" && str!="deckel aus schlitz" &&
      str!="buchdeckel aus schlitz")
    return 0;
  if (ok && heb) {
    write(BS(
        "So sehr Du Dich bemuehst, die Buchdeckel stecken zu fest in dem Schlitz. Wenn Du es nur irgendwie kopieren koenntest ..."));
    return 1;
  }
  return 0;
}

schl() {
  if (ok && heb)
    return BS(
        "Ein sehr enger Schlitz, in dem die Buchdeckel eines alten"
       +" Buches stecken.");
  return "Sowas siehst Du da nicht!\n";
}

deckl() {
  if (ok && heb)
    return BS("Die Buchdeckel sind fest in dem Schlitz eingeklemmt.");
  return "Sowas siehst Du da nicht!\n";
}

hnds() {
  int h;
  string str;
  object *u;

  h=TP->QueryProp(P_MAX_HANDS);
  str="Schau an, Du hast "+h+" Haende.";
  u=TP->QueryProp(P_HANDS_USED_BY);
  if ((h=sizeof(u))) {
    str+=" Du benuetzt gerade ";
    for (h=h-1; h>0; h--)
      str+=u[h]->name(WER, 0)+(h==1?" ":", ");
    str+=(sizeof(u)==1?"":"und ")+u[0]->name(WER, 0)+".";
  }
  return BS(str);
}

string long() {
  string str;
  object *i, u;

  str="Eine gemuetliche Couch, die zum draufliegen oder draufsitzen"
         +" einlaedt.\n";
  i=filter_array(all_inventory(this_object()), #'interactive);
  if (sizeof(i)>0) {
    u=i[0];
    if (!u->QueryProp(P_INVIS)) {
      str+=u->Name()+" hat es sich darauf bequem gemacht.\n";
    }
  }
  return str;
}

