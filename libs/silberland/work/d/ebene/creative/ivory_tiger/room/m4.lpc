/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Im Gang");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich mitten in einem duesteren Gang. An der Wand"
         +" siehst Du eine Fackel in einer Verankerung haengen. Das Flackern"
         +" der Flamme laesst die Malereien an den Waenden unheimlich wirken."
         +" Im Osten kommst Du in Richtung Ausgang, weiter nach Westen gehts"
         +" tiefer in das Herz der Raeumlichkeiten."));
  AddDetail("decke", BS(
            "Die Decke ist durch den Schein der Fackel gut beleuchtet. Jedoch"
           +" bietet sie wirklich nichts Besonderes, was man naeher betrachten"
           +" sollte."));
  AddDetail(({"wand", "waende"}), BS(
            "An der noerdlichen Wand haengt eine Fackel in einer Verankerung."
           +" Sie ist so hoch montiert, dass Du nicht rankommst."));
  AddDetail("boden", BS(
            "Auf dem Boden siehst Du im Staub einige Fussspuren."));
  AddDetail(({"staub", "spuren", "spur", "fussspuren", "fussspur"}), BS(
            "Die meisten Spuren die Du im Staub findest, stammen von Dir selber."));
  AddDetail("gang", BS(
            "Du befindest Dich in einem Gang der von Osten nach Westen fuehrt."));
  AddDetail("osten", BS(
            "Im Osten gelangst Du weiter nach Osten."));
  AddDetail("westen", BS(
            "Westlich von hier gelangst Du weiter nach Westen."));
  AddDetail("fackel", BS(
            "Die Fackel steckt in einer Verankerung, die an der Wand montiert ist."));
  AddDetail("verankerung", BS(
            "Die Verankerung ist an der Wand festgeschraubt."));
  AddDetail("flackern", BS(
            "Nachdem es sich bei dem Licht um eine Fackel handelt, flackert es auch"
           +" schon mal ab und zu."));
  AddDetail("flamme", BS(
            "Naeher in die Flamme zu sehen ist nicht gut fuer Deine Augen."));
  AddDetail("augen", BS(
            "Ohne Augen koenntest Du hier nichts untersuchen."));
  AddDetail("herz", BS(
            "Wenn Du Dein Herz meinst, so sei froh, wenn es noch schlaegt!"));
  AddDetail("ausgang", BS(
            "Der offizielle Ausgang befindet sich oestlich von hier."));
  AddDetail("licht", BS(
            "Hier brennt eine Fackel an der Wand, Du brauchst Dich also nicht"
           +" selber um Licht zu kuemmern."));
  AddDetail(({"raeumlichkeit", "raeumlichkeiten"}), BS(
            "Diese Raeumlichkeiten gehoeren zur Gilde des elfenbeinernen Tigers."));
  AddDetail("gilde", BS(
            "Ja, hier irgendwo muss auch ein Gildenmeister rumlungern."));
  AddDetail(({"meister", "mann", "gildenmeister"}), BS(
            "Der Gildenmeister ist nur sehr schwer erreichbar. Ein vielbeschaeftigter"
           +" Mann."));
  AddDetail(({"malerei", "malereien"}), BS(
            "An den Waenden siehst Du alte Malereien, die durchwegs Tiere zeigen."));
  AddDetail("tiere", BS(
            "Hauptsaechlich erkennst Du Tiger."));
  AddDetail("tiger", BS(
            "Der Tiger an der Wand aehnelt denen, die Du schon vorher an den Waenden"
           +" entdeckt hast."));
  AddDetail("schein", BS(
            "Nachdem die Fackel ziemlich weit oben haengt, reicht ihr Schein nicht"
           +" weit."));


  AddSound(DEFAULT_SOUND, BS(
           "Die Fackel ober Dir ergibt ein eigenartiges Geraeusch."));
  AddSound(({"fackel", "flackern", "geraeusch"}), BS(
           "Es klingt wie ueblich bei einer Fackel wie ein Flackern."));

  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht ein bisschen nach Petroleum."));
  AddSmell("petroleum", BS(
           "Die Fackel an der Wand duerfte nicht mit Pech wie ueblich"
          +" getraenkt sein sondern mit Petroleum."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("n4"));
  AddExit("westen", ROOM("l4"));
}


