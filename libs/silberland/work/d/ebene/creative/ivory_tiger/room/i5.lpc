/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"
int kandis=10;

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Vor dem Steintor");

  SetProp(P_INT_LONG, BS(
          "Du stehst vor einem alten Steintor, das nach Suedwesten zeigt."
         +" Der Weg fuehrt hier von Osten nach Nordwesten, und natuerlich"
         +" auch durch das Steintor hindurch nach Suedwesten. Reichlich"
         +" abenteuerliche Gerueche kommen durch das Tor hierher."));
  AddSpecialDetail(({"tor", "steintor"}), "steintor");
  AddDetail(({"bloecke", "marmorbloecke"}), BS(
            "Die Bloecke aus Marmor sind zwar nur grob behauen, bieten jedoch"
           +" eine Vielfalt an interessanten Mustern."));
  AddDetail("sockel", BS(
	    "Der Sockel des Steintors befindet sich am Boden."));
  AddDetail("marmor", BS(
            "Das Steintor besteht aus grob behauenem Marmor."));
  AddDetail(({"vielfalt", "muster"}), BS(
            "Wie Du das Tor naeher betrachtest, faellt Dir auf, dass es"
           +" voller interessanter Muster ist. Ein Flachrelief faellt"
           +" Dir dabei besonders auf."));
  AddDetail(({"relief", "flachrelief"}), BS(
            "Das Relief zeigt einen Tiger, dem gerade das Fell gekaemmt wird."));
  AddDetail("tiger", BS(
            "Der Tiger auf dem Flachrelief ist irr gut dargestellt."));
  AddDetail("fell", BS(
            "So ein Tiger bestitzt wahrhaftig ein schoenes Fell."));
  AddDetail("boden", BS(
            "Der Boden ist mit schoenen Steinplatten ausgelegt."));
  AddDetail(({"platten", "steinplatten"}), BS(
            "Die Platten sind diagonal verlegt um alles hier groesser"
           +" erscheinen zu lassen."));
  AddDetail("decke", BS(
            "An der Decke sieht man ein paar schwarze Spuren."));
  AddDetail(({"spuren", "russ"}), BS(
            "Die Spuren an der Decke duerften vom Russ der Fackeln stammen."));
  AddDetail(({"fackel", "fackeln"}), BS(
            "Hier gibts keine Fackeln, aber die, die hier vorueberkamen, hatten"
           +" sicher welche dabei."));
  AddDetail(({"wand", "waende"}), BS(
            "An den Waenden findest Du eine huebsche kleine Spinne."));
  AddDetail(({"eck", "spinne"}), BS(
            "Die Spinne sitzt lauernd in einem Eck und wartet darauf, dass die"
           +" Fliege, die direkt daneben hockt, naeherkommt."));
  AddDetail("fliege", BS(
            "Die Fliege wird sich hueten, naeher zur Spinne zu wandern,"
           +" dann wuerd sie ja gefressen. Vielleicht kannst Du ja die "
           "Fliege zur Spinne schubsen?"));
  AddDetail("suedwesten", BS(
            "Weiter nach Suedwesten gehts scheinbar in ein altes Gemaeuer."));
  AddDetail("gemaeuer", BS(
            "Hier scheint frueher eine Festung gewesen zu sein."));
  AddDetail("festung", BS(
            "Die Festung war wohl eher ein System von unterirdischen Gaengen."));
  AddDetail(({"system", "gaenge", "gang"}), BS(
            "In einem dieser Gaenge befindest Du Dich ja gerade."));
  AddDetail("weg", BS(
            "Der Weg fuehrt von Osten nach Nordwesten."));
  AddDetail(({"gerueche", "geruch"}), BS(
            "Das kannst Du bestimmt erriechen."));

  AddSound(DEFAULT_SOUND, BS(
           "Du hoerst Dein eigenes Herz klopfen."));
  AddSound("herz", BS(
           "Sei froh, dass Du es hoerst, sonst waerst Du nicht am Leben."));
  AddDetail( ({"leben"}),
      "Du lebst ... noch.");

  AddSmell(DEFAULT_SMELL, BS(
           "Von Suedwesten dringen abenteurliche Gerueche hierher."));
  AddSmell(({"gerueche", "suedwesten", "geruch"}), BS(
           "Komischerweise riecht es hier unter anderem nach Haarwasser."));
  AddSmell(({"wasser", "haarwasser"}), BS(
           "Seltsam, diesem Geruch solltest Du fast mal nachgehen."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("j5"));
  AddExit("nordwesten", ROOM("h4"));
  AddExit("suedwesten", ROOM("h6"));
  AddCmd(({"drueck", "druecke"}), "press");
  AddCmd(({"schubse", "schubs"}), "fliege");
  AddItem( NPC("lenti"), REFRESH_DESTRUCT);
}

string steintor() {
  string s, c;

  s="Das Steintor fuehrt nach Suedwesten. Es ist aus grob behauenen"
    +" Marmorbloecken gefertigt und wirkt irgendwie klobig.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" Am Sockel des Steintors siehst Du einen kleinen Knopf in Form eines Tigers, der "+c+" schimmert.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

int fliege (string str)
{
  object ob;
  if (!str) return 0;
  if (explode(str, " ")[0] != "fliege")
    return 0;
  if (present("\nsprachfluch", TP)) {
    write("Nein, dazu ist die Fliege viel zu schnell!\n");
    return 1;
  }
  write(BS("Du versuchst die kleine Fliege vorsichtig mit dem Finger zur "
      "Spinne zu schubsen. Leider ist die Fliege zu schnell fuer Deine "
      "plumpen, langsamen Bewegungen, und so faehrst Du mit dem Finger "
      "direkt zur Spinne, die Dich - es ist unglaublich - beisst."));
  call_out("gift_msg", 4);
  tell_room(ENV(TP), BS(sprintf("%s faehrt mit dem Finger zu einer Spinne und "
        "wird gebissen. So %s!", TP->Name(WER),
        TP->QueryProp(P_GENDER)==FEMALE?"ein Trampel":"ein Tollpatsch")), 
      ({TP}));

  if (!TP->QueryProp(P_PERM_STRING)) {
    // tell_room(ME, "Irgendetwas faellt vom Spinnennetz zu Boden.\n");
    ob=clone_object(OBJ("wech"));
    ob->move(TP, M_NOCHECK);
  }
  if(kandis>0) {
    kandis--;
    tell_room(ME, "Irgendetwas faellt vom Spinnennetz zu Boden.\n");
    ob=clone_object(OBJ("kandis"));
    ob->move(ME, M_NOCHECK);
  }
  return 1;
}

reset() {
  ::reset();
  kandis=10;
}

int gift_msg() {
  write(BS("Kurz nach dem Biss ist Dir irgendwie komisch zumute. Irgendwie "
        "weisst Du gar nicht mehr richtig was Du sagst."));
  return 1;
}
