/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include "../files.h"

create()
{
  int i;

  ::create();

  SetProp(P_ZONE, "Schatzkammer");
  SetProp(P_INT_SHORT, "Grosse Schatzkammer");

  SetProp(P_INT_LONG, BS(
          "Du bist in der grossen Schatzkammer der Gilde des elfenbeinernen"
         +" Tigers. Hier haben die Gildenmitglieder im Laufe der Zeit"
         +" gewaltige Reichtuemer angehaeuft. Das ist der groesste"
         +" und zugleich auch am besten ausgestattete Raum."));
  AddDetail(({"kammer", "schatzkammer"}), BS(
            "Du stehst im groessten Raum der Schatzkammer."));
  AddDetail(({"reichtuemer", "boden"}), BS(
            "Auf dem Boden liegen gewaltige Reichtuemer. Bedien Dich ruhig."));
  AddDetail(({"luster", "decke"}), BS(
            "An der Decke haengt ein gueldener Luster. Aber der ist nicht"
           +" zum mitnehmen."));
  AddDetail("zeit", BS(
            "In kurzer Zeit werden wieder Reichtuemer hier lagern!"));
  AddDetail("lauf", BS(
            "Wenn Du nicht davonlaufst, kriegst Du was von den Reichtuemern ab."));
  AddDetail(({"mitglieder", "gildenmitglieder"}), BS(
            "Die Diebe kommen hierher und horten ihre Reichtuemer."));
  AddDetail(({"dieb", "diebe"}), BS(
            "Du bist selber einer, wenn Du Dich hier bedienst!"));
  AddDetail(({"waende", "wand"}), BS(
            "Der Luster an der Decke beleuchtet die an sich weissen Waende."));
  AddDetail("raum", BS(
            "Das hier ist die Schatzkammer der Gilde."));
  AddDetail("gilde", BS(
            "Das hier ist die Schatzkammer der Gilde des elfenbeinernen Tigers."));

  AddSound(DEFAULT_SOUND, BS(
           "Die Kerzen auf dem Luster flackern, und ab und zu hoert man"
          +" eine Muenze klimpern."));
  AddSound(({"kerzen", "luster", "kerze"}), BS(
           "Die Kerzen auf dem Luster flackern ein wenig."));
  AddSound(({"muenze", "muenzen"}), BS(
           "Man hoert ab und zu eine Muenze klimpern."));

  AddSmell(DEFAULT_SMELL, BS(
           "Hier herinnen kannst Du Bienenwachs riechen."));
  AddSmell(({"bienenwachs", "wachs", "luster", "kerzen"}), BS(
           "Die Kerzen auf dem Luster scheinen aus Bienenwachs zu bestehen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("b3"));

  i=4;
  while (--i)
    AddItem(OBJ("struhe"));
  call_out("fuellen", 0);
}

fuellen()
{
  int i, j;
  object *gems;

  for (i=(random(100)%9)+1; i; i--)
    (clone_object("/p/armour/amulet/amulett"))->move(present("truhe "+(random(3)+1), TO), M_NOCHECK);
  for (i=(random(100)%12)+1; i; i--)
    (clone_object("/p/armour/ring/ring"))->move(present("truhe "+(random(3)+1), TO), M_NOCHECK);
  for (i=(random(100)%4)+1; i; i--) {
    gems=call_other("/obj/gemmaster", "DistributeGem", 5, 15, 1, 0);
    for (j=sizeof(gems)-1; j>=0; j--)
      gems[j]->move(present("truhe "+(random(3)+1), TO), M_NOCHECK);
  }
}

