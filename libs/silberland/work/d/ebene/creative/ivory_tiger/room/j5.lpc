/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Kahler Gang");

  SetProp(P_INT_LONG, BS(
          "Du stehst zwischen dem zentralen Treffpunkt und dem grossen"
         +" Steintor, der Weg fuehrt von Nordosten nach Westen. Interessant,"
         +" hier ist die Decke leicht gewoelbt, als ob ober Dir ein kleiner"
         +" Huegel waere."));
  AddDetail("decke", BS(
            "Die Decke ist leicht gewoelbt. Scheinbar befindet sich ober"
           +" Dir ein kleiner Huegel, von dem man sicher eine gute Aussicht"
           +" hat."));
  AddSpecialDetail("huegel", "huegel");
  AddDetail("oberflaeche", BS(
            "Die Oberflaeche geht Dich nix an, Du bist ja unter der Erde."
           +" Jedoch stellst Du fest, dass an der Decke ein paar komische"
           +" Striche zu sehen sind."));
  AddDetail("aussicht", BS(
            "Sieh Dich doch lieber hier um, anstatt von Aussicht zu traeumen."));
  AddDetail("erde", BS(
            "Du bist derzeit unter der Erde."));
  AddDetail(({"punkt", "treffpunkt"}), BS(
            "Der zentrale Treffpunkt befindet sich weiter nordwestlich von"
           +" hier."));
  AddDetail(({"tor", "steintor"}), BS(
            "Um zum Steintor zu gelangen musst Du Dich nach Westen halten."));
  AddDetail("boden", BS(
            "Der Boden ist nackt und kahl und reflektiert nicht mal irgendetwas."));
  AddDetail(({"wand", "waende"}), BS(
            "Es handelt sich um normale Waende, in etwa 3 Meter hoch, und"
           +" circa ebenso breit. Sie bestehen aus rohem, unbehauenen Stein."));
  AddDetail("meter", BS(
            "Naja, ein Meter ist irgendwie schon ziemlich breit."));
  AddDetail("stein", BS(
            "Der Stein rund um Dich ist unbehauen, Dir kommt es hier wie in"
           +" einer Hoehle vor."));
  AddDetail("hoehle", BS(
            "Eigentlich geht der Gang hier ja weiter nach Westen und"
           +" Nordosten, Du beschliesst, dass das hier doch keine Hoehle ist."));
  AddDetail(({"weg", "gang"}), BS(
            "Der Gang fuehrt von Nordosten nach Westen."));
  AddDetail("striche", BS(
            "Die Striche schauen aus wie eine angedeutete Karte."));
  AddDetail("karte", BS(
            "Probier mal die Karte zu lesen."));
  AddReadDetail("karte",
            "  -----------\n"
           +" /   xxxx    \\\n"
           +"|   x  x      | \n"
           +"|xxx    x     |\n"
           +"|      x x+x+x|  Ob Du damit etwas anfangen kannst?\n"
           +"|       x     |\n"
           +"|   x  x      |\n"
           +" \\   xxxx    / \n"
           +"  -----------\n");

  AddSound(DEFAULT_SOUND, BS(
           "Nichts, aber auch gar nichts zu hoeren."));

  AddSmell(DEFAULT_SMELL, BS(
           "Du riechst Dich selber irgendwie am intensivsten."));
  AddSmell("dich", BS(
           "Naja, ein bisserl Deo waere net schlecht..."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("nordosten", ROOM("k4"));
  AddExit("westen", ROOM("i5"));
  AddCmd(({"drueck", "druecke"}), "press");
}

string huegel() {
  string s, c;

  s="Von dem Huegel der sich an der Oberflaeche der Erde befinden"
    +" wird, hat man bestimmt eine gute Aussicht.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" An einer besonders tiefen Stelle der Woelbung an der Decke befindet sich ein"
      +" kleiner Knopf in Form eines Tigers, der eigenartigerweise "+c+" leuchtet.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

