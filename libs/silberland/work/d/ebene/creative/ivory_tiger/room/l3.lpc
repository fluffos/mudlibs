/*
  Ebony Tiger Guild
*/

#include "../files.h"
#include "../quest.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

#include "swknopf.lpc"

int fackelhalterung;

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Uebungsraum");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich im Uebungsraum der Gilde. Scheinbar kommen"
         +" die Angehoerigen der Gilde hierher, wenn es darum geht, einen"
         +" neuen Spruch oder eine neue Taktik auszuprobieren. Aber mit"
         +" diesem neumodischen Schnickschnack kannst Du nur wenig"
         +" anfangen."));
  AddDetail(({"raum", "uebungsraum"}), BS(
            "Der Uebungsraum ist nur fuer Gildenmitglieder gedacht."));
  AddDetail(({"diebesgilde", "gilde"}), BS(
            "Dies ist die Gilde des elfenbeinernen Tigers."));
  AddDetail("tiger", BS(
            "Pass bloss auf und verscherz es Dir ja nicht mit dem Tiger."));
  AddDetail(({"mitglieder", "gildenmitglieder", "angehoerige"}), BS(
            "Nachdem die Gildenmitglieder ausschliesslich Diebe sind,"
           +" handelt es sich vermutlich um eine Diebesgilde."));
  AddDetail("spruch", BS(
            "Das sind bestimmt lauter neumodische Ideen."));
  AddDetail("idee", BS(
            "Mit dem Befehl 'idee' kannst Du den Magiern helfen, auch"
           +" eigene Ideen in das Spiel einzubringen."));
  AddDetail(({"befehle", "befehl"}), BS(
            "Um eine Uebersicht ueber die Befehle zu erhalten tippe 'hilfe'."));
  AddDetail("uebersicht", BS(
            "Bei so vielen Befehlen muss man schon die Uebersicht behalten. :)"));
  AddDetail("spiel", BS(
            "Ist es Spiel oder Wirklichkeit?"));
  AddDetail("wirklichkeit", BS(
            "Wirklich, es ist nur ein Spiel."));
  AddDetail("magier", BS(
            "Ohne Magier gaebe es diese Welt gar nicht."));
  AddDetail("welt", BS(
            "Unsere Welt ist das SilberLand."));
  AddDetail("silberland", BS(
            "Das SilberLand besitzt wohl die einfallsreichsten und schoensten"
           +" Gebiete, die sich finden lassen."));
  AddDetail(({"gebiet", "gebiete"}), BS(
            "In diesem Gebiet findest Du sicher einige innovative Ideen."));
  AddDetail("diebe", BS(
            "Diebe findest Du hier an jeder Ecke."));
  AddDetail(({"ecken", "ecke"}), BS(
            "Auch dieser Raum hat 4 Ecken."));
  AddDetail(({"lehm", "boden"}), BS(
            "Der Boden besteht aus festgestampften Lehm."));
  AddDetail("decke", BS(
            "Das Kreuzgewoelbe das man hier ueberall zu finden scheint setzt"
           +" sich auch hier in diesem Raum fort."));
  AddDetail(({"gewoelbe", "kreuzgewoelbe"}), BS(
            "Das Kreuzgewoelbe ist wie auch ueberall anders sehr schoen"
           +" gearbeitet. An einer Stelle broeckelt allerdings schon der Moertel ab."));
  AddSpecialDetail(({"stelle", "moertel"}), "moertel");
  AddDetail("schnickschnack", BS(
            "Kuemmer Dich nicht darum."));
  AddDetail("taktik", BS(
            "Die richtige Taktik zu waehlen ist oft nicht einfach."));
  AddDetail(({"wand", "waende"}), BS(
            "An der westlichen Wand befindet sich eine Fackelhalterung."));
  AddSpecialDetail(({"fackelhalterung", "halterung"}), "halterung");
  AddDetail("fackel", BS(
            "Die Fackel erleuchtet den Raum. Sie scheint eine magische Ausstrahlung zu"
           +" besitzen."));
  AddDetail("ausstrahlung", BS(
            "Es duerfte sich bei der Fackel um eine magische, festmontierte Fackel handeln."));

  AddSound(DEFAULT_SOUND, BS(
           "Die Fackel ober Dir knistert Dir leise ins Ohr."));
  AddSound(({"knistern", "fackel"}), BS(
           "Fast melodisch, das Knistern der Fackel."));

  AddSmell(DEFAULT_SMELL, BS(
           "Ziemlich rauchig hier, findest Du nicht auch?"));
  AddSmell("rauch", BS(
           "Der Rauchgeruch duerfte von der Fackel an der Wand stammen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddCmd(({"ruettel", "ruettele", "ruettle"}), "shake");
  AddCmd(({"drueck", "druecke"}), "press");
  AddExit("sueden", ROOM("l4"));
  AddItem(NPC("nermal"), REFRESH_DESTRUCT);
  fackelhalterung=1;
}

reset() {
  ::reset();
  if (!fackelhalterung) {
    tell_room(TO, "Die Fackelhalterung dreht sich wie von Geisterhand in die "
        "Ausgangsposition zurueck.\n");
    SetProp(P_ROOM_MSG, ({}));
    SetProp(P_FUNC_MSG, 0);
    fackelhalterung=1;
  }
}

shake(str)
{
  notify_fail("Woran willst Du ruetteln?\n");
  if (!str || str=="") {
    write("Woran willst Du ruetteln?\n");
    return 1;
  }
  if (!(str=="an fackel" || str=="an fackelhalterung"))
    return 0;
  if (!fackelhalterung) {
    write(BS("Du ruettelst ein wenig an der Fackel herum. Nichts passiert."));
    return 1;
  }
  AddRoomMessage(({
        "Ein kleiner Funke faellt von der Fackel auf den Boden.\n"}), 50, "burn");
  call_out("WriteRoomMessage", random(QueryProp(P_MSG_PROB)));
  write(BS("Du ruettelst ein wenig an der Fackel und bewegst die "
        "Fackelhalterung dabei ein wenig nach links."));
  fackelhalterung=0;
  return 1;
}

halterung() {
  if (fackelhalterung)
    return BS("In der Fackelhalterung steckt eine Fackel. Du stellst"
	+" fest, dass die Fackel ein wenig locker sitzt. Eventuell koennte man an"
	+" der Fackel ruetteln.");
  return BS("Die Fackelhalterung ist ein wenig schraeg geneigt. Ab und zu faellt ein"
           +" kleiner Funke von der Fackel auf den Boden.");
}

burn() {
  object *l, o;
  int i;

  l = filter_objects( all_inventory(), "id", IV_LANTERN );
  for (i=sizeof(l); i-->0; ) {
    if (!call_other(l[i], "query_burning"))
      l[i]->start_burn();
  }

  l = filter_array( all_inventory(), #'living );
  for (i=sizeof(l); i-->0; ) {
    if ((o = present(IV_LANTERN, l[i])) && !call_other(o, "query_burning")) {
      l[i]->Message(
          "Stuende Deine Laterne jetzt am Boden, wuerde ihr Zunder "
          "bestimmt Feuer fangen.\n", MSGFLAG_VISUAL );
    }
  }
}

string moertel() {
  string s, c;

  s="Du siehst an einer Stelle des Kreuzgewoelbes etwas Moertel abbroeckeln.";
  c=call_other(SWMASTER, "query_color");
  if (c!="") {
    s+=" Genau dort siehst Du einen "+c+" schimmernden Knopf in Form eines Tigers.";
    AddDetail("knopf", BS("Der Knopf laesst sich bestimmt druecken."));
  }
  else
    RemoveDetail("knopf");
  return BS(s);
}

