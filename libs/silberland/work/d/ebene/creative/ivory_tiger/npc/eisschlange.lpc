
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Eisschlange");
  SetProp(P_LONG,
      "Diese kleine Eisschlange ist ein wahres Phaenomen, dass sie in "
      "dieser Temperatur ueberleben kann. Du bist Dir sicher das das "
      "keine normale Schlange ist, denn sonst koennte sie hier hoechstens "
      "als starrer Eisstock herumliegen.");
  SetProp(P_NAME, "Eisschlange");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "eisschlange","schlange" }) );

  create_default_npc(10+random(3));
  SetProp(P_HANDS, ({" mit ihren eiskalten Zaehnen",
                   QueryProp(P_HANDS)[1],DT_COLD}));
  SetProp(P_RACE, "Schlange");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-40,T_RANGE_MAX:5]));
  SetProp(P_SIZE, 20+random(5));
  SetProp(P_ALIGN, -150);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.5, DT_COLD:      -0.9, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON:  0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  -0.2 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt schlaengelnd an");
  SetProp(P_MSGOUT, "windet sich weiter");

  SetProp(P_DIE_MSG,  " bleibt regungslos liegen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Eisschlange kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,40);

  AddDefaultSpell(1, 350, DS_POISON, 
    "Die Eisschlange vergiftet Dich mit einem starken Biss.\n",
    "Die Eisschlange vergiftet @WEN mit einem starken Biss.\n");

  AddSpell(4,250,
    "Die Eisschlange beisst Dir ins Bein.\n",
    "Die Eisschlange beisst @WEM ins Bein.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,200,
    "Die Eisschlange beisst Dir in den Fuss.\n",
    "Die Eisschlange beisst @WEM in den Fuss.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Eisschlange windet sich lautlos durch den Schnee.\n",
    "Die Eisschlange baut sich gefahrvoll vor Dir auf.\n", }) );

  CLONEME(OBJ("eherz"));
}

