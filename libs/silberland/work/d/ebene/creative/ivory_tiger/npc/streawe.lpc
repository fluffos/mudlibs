#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("dieb");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Streawe");
  AddId("streawe");
  SetProp(P_SHORT, "Streawe, der Dieb");
  SetProp(P_LONG,
      "Eigentlich ist Streawe ein Hobbit, aber wenn man ihn so ansieht "
      "koennte man ihn mit einem grossen Haarbueschel verwechseln. Wenn er "
      "nicht Kleidung tragen wuerde, wuerde man nicht wissen wo vorne oder "
      "hinten ist. Er blickt Dich mit seinen kleinen Hobbitaugen gierig an. "
      "Er traegt einen Schluesselbund mit einigen Schluesseln mit sich.");

  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, -100);
  customize(0,0,"hobbit");
  SetProp(P_MAX_HELPERS, 2);
  SetProp(P_HELPERS, QueryProp(P_MAX_HELPERS));
  clone_object(ARMOUR("umhang"))->move(TO);
  command_me("ziehe umhang an");
}

