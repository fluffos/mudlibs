#include <language.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "/sys/living/life.h"
#include <moving.h>
#include <wizlevels.h>
#include "../files.h"

inherit STD("dieb");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Argax");
  AddId("argax");
  customize(0,0,"dunkelelf");
  SetProp(P_SHORT, "Argax, der Dieb");
  SetProp(P_ALIGN, -100);
  SetProp(P_LONG,
    "Du siehst einen Dunkelelfen, der sich staendig nach allen Seiten "
    "umsieht, so als wuerde er staendig verfolgt. Seine Finger zucken "
    "nervoes umher, so als ob sie staendig etwas zu stehlen versuchen. ");
      
  SetProp(P_ARTICLE, 0);
  clone_object(ARMOUR("schuhe"))->move(TO);
  command_me("ziehe schuhe an");
}

