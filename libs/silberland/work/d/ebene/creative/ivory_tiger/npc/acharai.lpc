#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("wache");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Acharai");
  AddId("acharai");
  AddId("waechter");
  SetProp(P_SHORT, "Acharai, der Waechter");
  SetProp(P_ALIGN, 300);
  SetProp(P_LONG,
      "Acharai, der Waechter steht vor Dir. Fuer einen Menschen ist er "
      "ganz schoen gross gewachsen. Er blickt sich staendig um, so als "
      "wuerde er etwas suchen. Nichtdesdotrotz ist er ein gefaehrlicher Gegner, "
      "stehts bereit die Gilde zu verteidigen. Er spielt sich staendig mit "
      "einem Schluesselbund, den er bei sich traegt.");
  SetProp(P_ARTICLE, 0);
  AddLibrary(NPC("npc.lib"), 1, 1);
  (clone_object(WEAPON("speer")))->move(TO);
  command_me("zuecke speer");
  customize(30+random(5),0,"mensch");

}

