#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"

inherit STD("wache");

string prosecco();
string info_add();

int key;

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Illuan");
  AddId("illuan");
  AddId("waechter");
  SetProp(P_SHORT, "Illuan, der Waechter");
  SetProp(P_ALIGN, 400);
  SetProp(P_LONG, #'info_add);
  SetProp(P_ARTICLE, 0);
  AddLibrary(NPC("npc.lib"), 2, 1);
  AddInfo("prosecco", #'prosecco, 0, "fluestert @WEM etwas zu.\n");
  customize(30+random(6),0,"elf");
  //clone_object(WEAPON("keule"))->move(TO);
  //command_me("zuecke keule");
  key=1;
}

string info_add() {
  string add;
  add="";
  if(TP->QueryProp(P_GENDER) == MALE)
    add="Er laechelt Dich an. Das solltest du auch machen!";
  return BS(
      "Dieser grossgewachsene Elf ist einer der Waechter hier. Dich "
      "verwundert das ein Elf hier unter der Erde lebt, aber da hier nur "
      "maennliche Wesen wohnen wird es Dir langsam klar. Er sieht auf "
      "alle Faelle nicht so aus als sei mit ihm zu spassen. Auf alle "
      "Faelle kannst Du ihm ansehen, dass er auch manchmal mit Pflanzen "
      "spricht. Leider wachsen hier unten nur Moose, und du glaubst Dich zu "
      "erinnern, dass diese sich nicht so gut artikulieren koennen. Er traegt "
      "einen Schluesselbund mit sich. "+add
      );
}

reset() {
  key=1;
  ::reset();
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!=-1)
    return;
  switch (gruppe) {
    case "nett":
      call_out("react", 0, TP); break;
    case "intim":
      call_out("react", 0, TP); break;
  }
}

void react(object to, string vic)
{
  if (present(to, ENV(TO))) {
    if (to->QueryProp(P_GENDER)==MALE) {
      tell_object(to, BS(Name(WER, 1)+" fluestert Dir zu: Moechtest Du ein Glas Prosecco?"));
      tell_room(ENV(TO), BS(Name(WER, 1)+" fluestert "+to->Name(WER, 1)+" etwas zu."), ({ to }));
    }
    else {
      tell_room(ENV(TO), BS(Name(WER, 1)+" sagt: Aber geh! Ich spreche lieber mit Pflanzen!"));
    }
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

string prosecco() {
  if (TP->QueryProp(P_GENDER)==MALE) {
    return "sagt: Antworte mir doch mit ja, so bekommst Du auch welchen von mir.";
  }
  else {
    return "sagt: Frag doch mal Heriolf danach.";
  }
}

catch_tell(str) {
  string who, what, out1, out2;
  object ob;

  if (!str)
    return ::catch_tell(str);
  if (sscanf(str, "%s antwortet Dir: %s\n", who, what)==2) {
    what=lower_case(what);
    if (what == "ja" || what == "mit ja") {
      if (TP->QueryProp(P_GENDER)!=MALE) {
        call_out("to", 0, TP, Name(WER, 1)+" fluestert Dir zu: Nein, Du bekommst von mir nichts!\n");
        call_out("tr", 0, Name(WER, 1)+" sagt: "+who+" will wohl mit mir anbandeln!\n", ({TP}));
        call_out("command_me", 2, "emote schuettelt sich angewidert.");
        return;
      }
      call_out("to", 0, TP, Name(WER, 1)+" fluestert Dir zu: Da hast Du ein Glaeschen!\n");
      call_out("tr", 0, Name(WER, 1)+" freut sich ungemein.\n", ({}));

      out1=Name(WER, 1)+" nimmt ein Glas und eine Flasche Prosecco und versucht,"
                       +" Dir ein Glaeschen einzugiessen. Leider ist er zu ungeschickt und"
                       +" verschuettet alles.";
      out2=Name(WER, 1)+" dreht den Ruecken zu Dir und kramt etwas ungeschickt"
                       +" in seinen Taschen.";
      if (key && !deep_present(IV_JK4_KEY, TP)) {
        out1+=" Beim Versuch, das Malheur aufzuwischen faellt ihm ein Schluessel aus der Tasche,"
             +" den Du sofort einsteckst.";
        out2+=" Ploetzlich bueckt er sich verzweifelt, und irgendetwas"
                       +" faellt ihm aus der Tasche, das "+TP->Name()+" sofort einsteckt."; 
        ob=clone_object(OBJ("keyjk4"));
        call_out("key_move", 3, ob, TP);
        IV_LOGQUEST(getuid(TP), "mit Illuan gesprochen");
        key=0;
      } else {
        out1+=" "+Name(WER, 1)+" erroetet leicht und wischt das Malheur schnell auf.";
        out2+=" "+Name(WER, 1)+" erroetet leicht, bueckt sich und fuchtelt auf dem Boden herum.";
      }

      call_out("to", 3, TP, BS(out1));
      call_out("tr", 3, BS(out2), ({TP}));
    }
  }
}

void tr(string str, mixed other) {
  tell_room(ENV(TO), str, other);
}

void to(object dest, string str) {
  tell_object(dest, str);
}

void key_move(object key, object dest) {
  key->move(dest, M_NOCHECK);
}

