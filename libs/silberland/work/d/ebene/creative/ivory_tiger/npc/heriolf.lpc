#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../files.h"
#include "../quest.h"

inherit STD("dieb");
inherit "std/npc/sequencer";

object mug_bringer;
int ok;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  SetProp(P_SHORT, "Heriolf, der geldgierige Trinkhallenbesitzer");
  SetProp(P_LONG, 
         "Heriolf der geldgierige Trinkhallenbesitzer ist zwar an sich "
         "geldgierig, aber er hat - so erscheint es dir - trotzdem "
	 "vernuenftige Preise - zumindest fuer die Tatsache das er ein "
	 "Zwerg ist. An seinem "
         "Guertel haengt neben dem Handtuch zum Trocknen der Glaeser noch "
         "ein Schluesselbund.");
  SetProp(P_WEIGHT, 110000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Heriolf");
  SetProp(P_ALIGN, 200);
  SetProp(P_MNPC_FLAGS, 0);
  AddLibrary(NPC("npc.lib"), 3, 1);
  AddInfo("prosecco", "So etwas fuehren wir hier nicht!\n", "sagt: ");
  AddInfo(({"becher", "saufbecher"}), "Du hast davon gehoert? Oh toll, dann koenntest Du mir ja den"
         +" Gefallen tun und ihn mir bringen!", "jubelt: ");
  AddInfo("gefallen", "Wuerdest Du mir denn den Saufbecher bringen? Dann kann ich Murhu eins auswischen"
         +" und den Becher wieder am Stammplatz aufstellen...", "sagt: ");
  AddInfo("fladenbrot", "Wir fuehren hier leckeres Fladenbrot!", "sagt: ");
  AddInfo(({"nadel", "krawattennadel"}), "Die moechtest Du wohl gerne haben, oder? Die kriegst Du nur "
      "gegen den Saufbecher. Hehe. Den haette ich gerne. Das was doppelplusgut.", "sagt: ");
  AddId("wirt");
  AddId("heriolf");
  customize(0,0,"zwerg");
  RegisterGive("mug", ({
               ({ "sag Hey, lass mal sehen...", 3 }),
               ({ "becher", 4 })
               }));
  add_action("b", "becher");
  ok=0;
}

catch_tell(str) {
  sequencer::catch_tell(str);
  dieb::catch_tell(str);
}

give_notify(ob) {
  sequencer::give_notify(ob);
//  dieb::give_notify(ob);
}

mug(object o) {
  mug_bringer=this_interactive();
  if (o->id(IV_BOOZE_MUG)) {
    if (present(IV_LOCKPICKNOTE, o)) {
      command_me("sag Ich nehme nur einen leeren Becher an.");
      give_obj(o, mug_bringer);
      return 0;
    }
    command_me("emote grinst breit.");
    o->remove();
    ok=1;
    return 1;
  }
  command_me("sag Also "+o->Name()+" bringt mir ueberhaupt nichts.");
  give_obj(o, mug_bringer);
  return 0;
}

b() {
  object pin, r;

  if (ok) {
    command_me("emote freut sich ungemein und stellt den Becher an seinen Stammplatz.");
    r=find_object(ROOM("i1"));
    if (r)
      r->set_winner("Heriolf");
    pin=clone_object(ARMOUR("nadel"));
    call_out("give_pin", 3, pin, mug_bringer);
  }
  ok=0;
  return 1;
}

void give_pin(object what, object where) {
  what->move(where, M_GIVE|M_NOCHECK);
  command_me("sag Danke, "+where->Name()+"! Hier hast Du etwas fuer Deine Muehe...");
  say(ME->Name(WER)+" gibt "+where->name(WEM)+" "+
      what->name(WEN)+".\n", where );
  if (living(where))
    tell_object(where, ME->Name(WER,1)+" gibt Dir "+what->name(WEN)+".\n");
}

