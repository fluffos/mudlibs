inherit "std/armour";

#include <armour.h>
#include <combat.h>
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h"

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_NAME, "Krawattennadel");
  SetProp(P_SHORT, "Eine Krawattennadel");
  SetProp(P_IVORY, 1);
  SetProp(P_LONG, BS(
          "Eine Krawattennadel mit einem kleinen Diamant drauf."));
  SetProp(P_INFO, BS(
          "Die Krawattennadel kannst Du nur an stoffene Kleidungsstuecke"
         +" anstecken."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 450+random(300));
  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_MATERIAL, ([MAT_GOLD:97, MAT_DIAMOND:3 ]));
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_WEAR_TEXT, ({ "Du steckst Dir die Krawattennadel an.\n", 
                          " steckt sich eine Krawattennadel an.\n" }));
  SetProp(P_UNWEAR_TEXT, ({ "Du steckst Dir die Krawattennadel ab.\n", 
                          " steckt sich eine Krawattennadel ab.\n" }));
  SetProp(P_WORN_TEXT, "angesteckt");
  AddId("nadel");
  AddId("krawattennadel");
  AddId(IV_TIE_PIN);
  SetProp(P_WEIGHT, 30+random(30));
  AddCmd(({"bastle", "bastel"}), "proceed");
}

WearFunc(object r, int s)
{
  object *a;

  a=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_ARMOUR);
  if (sizeof(a) && a[0]->QueryMaterialGroup(MATGROUP_CLOTH) > 10)
    return 1;
  a=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_CLOAK);
  if (sizeof(a) && a[0]->QueryMaterialGroup(MATGROUP_CLOTH) > 10)
    return 1;
  if (!s)
    write(BS("An Deinen Kleidungsstuecken ist zu wenig Stoff, um die" 
            +" Krawattennadel anzustecken!"));
  return 0;
}

proceed(str) {
  object o;

  notify_fail("Was willst Du woraus basteln?\n");
  if (!str)
    return 0;
  if (str =="")
    return 0;
  if (member(({ "dietrich aus krawattennadel", "dietrich aus nadel", "dietrich" }), str) == -1)
    return 0;
  o = deep_present(IV_LOCKPICKNOTE, TP);
  if (!o) {
    write("Du musst schon eine Anleitung zum Basteln bei Dir haben!\n");
    return 1;
  }
  write(BS("Du schaust Dir die Anleitung noch einmal genau an und bastelst haaregenau"
          +" nach der Anleitung einen Dietrich. Leider faellt Dir der Zettel beim"
          +" Verknoten der Finger hinunter und verschwindet auf Nimmerwiedersehen."
          +" Da Du die Anweisungen auf der Notiz nicht bis ganz zu Ende geschafft hast,"
          +" passt der Dietrich wohl nur in ganz wenige Schloesser."));
  say(BS(TP->Name()+" verknotet seine Finger, als er an einer Krawattennadel herumbiegt."));
  o->remove();
  o=clone_object(OBJ("keyl45"));
  o->move(TP, M_NOCHECK);
  IV_LOGQUEST(getuid(TP), "Dietrich gebastelt");
  call_out("remove", 0);
  return 1;
}

