inherit "std/armour";
inherit "std/armour/description";

#include <armour.h>
#include <thing.h>
#include <language.h>
#include <properties.h>
#include <material.h>
#include <combat.h>
#include <moving.h>
#include "/gilden/druidenzirkel/druiden_extern.h"
#include "../files.h"

void create()
{
  if (!is_clone(TO))
    return;
  armour::create();
  description::create();

  SetProp(P_SHORT, "Ein Guertel aus Gold");
  SetProp(P_NAME, "Goldguertel");
  SetProp(P_LONG, "Dieser Guertel wurde in feinster Zwergenschmiede- und Blattgoldtechnik"
                 " gefertigt. Du bist fasziniert wie duenn und leicht der Guertel doch"
                 " trotz des edlen Materials doch ist. Zusaetzlich ist der Guertel noch"
                 " an ein paar Stellen mit Edelsteinen besetzt.");
  SetProp(P_INFO, "Der Guertel scheint aus Mitrhilkettengliedern zu bestehen, die allesamt"
                 " vergoldet wurden. An exponierten Stellen sind herrlich geschliffene"
                 " Diamanten eingearbeitet. Ausserdem scheint den Guertel eine magische"
                 " Aura zu umgeben.");
  AddDetail(({"glieder", "kettenglieder", "mithrilkettenglieder"}), 
            "Die Mithrilkettenglieder sind allesamt vergoldet.");
  AddDetail("aura", 
            "Dieser Guertel scheint fuer jedermann gleichermassen angenehm zu tragen zu"
           " sein und duerfte selbst für Druiden einen idealen Rüstungsschutz bieten.");
  SetProp(P_WEIGHT, 600);
  SetProp(P_MATERIAL, ([MAT_GOLD: 30, MAT_DIAMOND: 5, MAT_MITHRIL:65]));
  SetProp(P_AC, 4);
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 2000);
  SetProp(P_WORN_TEXT, "umgeschnallt");
  SetProp(P_WEAR_TEXT, ({"Du schnallst Dir den Guertel um die Hueften.\n",
                         " schnallt sich einen Guertel um die Hueften.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du schnallst Dir den Guertel ab.\n",
                           " schnallt sich einen Guertel ab.\n"}));
  AddId("guertel");
  AddId("goldguertel");
  AddId(DRUID_ALLOWED_METAL_ITEM);
}

string short()
{
  string s;
  if (!(s=QueryProp(P_SHORT)) || QueryProp(P_INVIS)) return 0;
  return s+(QueryProp(P_WORN) ?
    " ("+(QueryProp(P_WORN_TEXT) || "getragen")+").\n":".\n");
}

varargs int remove(int silent)
{
  DoUnwear(silent);
  return ::remove(silent);
}

varargs move(mixed dest, int method)
{
  DoUnwear(method & M_SILENT);
  if ((method & M_NOCHECK) || (!QueryProp(P_WORN)))
    return ::move(dest, method);
}

