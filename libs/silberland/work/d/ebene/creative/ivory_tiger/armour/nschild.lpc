inherit "std/armour";

#include <armour.h>
#include <combat.h>
#include <language.h>
#include <properties.h>
#include "../files.h"

string traeger;

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Namensschild");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 100);
  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_MATERIAL, ([MAT_PAPER:80, MAT_PLASTIC:20 ]));
  SetProp(P_WEAR_TEXT, ({ "Du steckst Dir das Namensschild an.\n", 
                          " steckt sich ein Namensschild an.\n" }));
  SetProp(P_UNWEAR_TEXT, ({ "Du entfernst das Namensschild.\n", 
                          " entfernt ein Namensschild.\n" }));
  AddId("schild");
  AddId("namensschild");
  SetProp(P_WEIGHT, 50+random(10));
  traeger="";
  AddCmd("beschrifte", "writ");
}

_query_worn_text()
{
  if (traeger=="")
    return "angesteckt";
  return "beschriftet mit '"+traeger+"'";
}

writ(str)
{
  string args, womit;

  notify_fail("Syntax: beschrifte namensschild <text>\n");
  if (!str || str=="")
    return 0;
  args=TP->_unparsed_args();
  if (sscanf(args, "namensschild %s", womit)!=1)
    return 0;
  notify_fail("Das passt auf das Namensschild nicht drauf! Halte Dich kuerzer.\n");
  if (strlen(womit)>15)
    return 0;
  traeger=womit;
  write(BS("Ok, Du beschriftest das Namensschild mit '"+traeger+"'."));
  return 1;
}

long()
{
  if (traeger=="")
    return "Dieses Namensschild kann man auch beschriften wenn man mag.\n";
  return "Das Namensschild ist beschriftet mit '"+traeger+"'.\n";
}

short()
{
  if (traeger=="")
    return "Ein Namensschild";
  return "Ein Namensschild (beschriftet mit '"+traeger+"')";
}

_query_name()
{
  if (traeger=="")
    return "Namensschild";
  return "Namensschild (beschriftet mit '"+traeger+"')";
}

