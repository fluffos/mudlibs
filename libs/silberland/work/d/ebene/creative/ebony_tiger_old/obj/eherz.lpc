inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_NAME, "Eisherz");
  SetProp(P_SHORT, "Das Eisherz einer Eisschlange");
  AddId("herz");
  AddId("eisherz");
  AddId("\neherz");
  SetProp(P_LONG, BS(
      "Dieses Eisherz der Eisschlange schimmert foermlich noch eiskalt und"
     +" hat eine leicht blaeuliche Farbe. Dir graust davor, daran zu denken,"
     +" dass man es vielleicht essen koennte."));
  SetProp(P_INFO, BS(
      "Das Eisherz, einmal zu Pulver zerstampft, mag Dir noch sehr nuetzlich"
     +" erscheinen. Ausserdem kann man es essen."));
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1),
  SetProp(P_FOOD_INFO, ([ 
      F_HEAL:({45, 40}), F_SOAK:20, F_DRINK:15,
      F_MSG:"Du wuergst das Eisherz hinunter, fuehlst Dich aber seltsam regeneriert.\n",
      F_MSG_ROOM:" wuergt ein Eisherz hinunter.\n" ]));
  SetProp(P_WEIGHT, 140);
  SetProp(P_MATERIAL, ([MAT_FLESH:90, MAT_BLOOD:10, MAT_ICE:100]));
  SetProp(P_GENDER, NEUTER);
}

