inherit "/std/thing";

#include "../files.h"
#include <language.h>
#include <properties.h>
#include <material.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein kleiner Eisenschluessel");
  SetProp(P_LONG, BS(
          "Du lenkst Deine Aufmerksamkeit voll auf diesen praechtig gearbeiteten"
         +" Eisenschluessel. Jeder Schlosser haette seine Freude daran, wenn er"
         +" ihn sehen koennte, so schoen praezise ist er gefeilt."));
  AddId("schluessel");
  AddId("eisenschluessel");
  AddId("\nEkey");
  SetProp(P_WEIGHT, 80);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_NAME, "Schluessel");
}

string QueryDoorKey()
{
  return ROOM("n4")+":"+ROOM("n5");
}

