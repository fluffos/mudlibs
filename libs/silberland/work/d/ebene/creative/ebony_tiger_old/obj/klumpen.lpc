inherit "std/unit";

#include <properties.h>
#include <language.h>
#include "../files.h"
#include <combat.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  AddSingularId(({"klumpen", "schlammklumpen"}));
  AddPluralId(({"klumpen", "schlammklumpen"}));
  SetProp(P_WEIGHT, 400);
  SetProp(P_NOSELL, 1);
  SetProp(P_SHORT, "Schlammklumpen");
  SetProp(P_LONG, BS(
          "Ein ganz einfacher Schlammklumpen. Wahrscheinlich eines der"
	       +" unwichtigsten Dinge der Welt."));
  SetProp(P_INFO, BS(
          "Man kann den Klumpen nach manchen Gegnern schleudern."
	       +" Aber kaum jemand reagiert allergisch auf den Schlamm."));
  SetProp(P_NAME, ({"Schlammklumpen", "Schlammklumpen"}));
  SetProp(P_MATERIAL, MAT_EARTH);
  SetProp(P_GENDER, MALE);
}

init()
{
  ::init();
  add_action("throw","schleuder");
  add_action("throw","schleudere");
}

throw(str)
{
  string what, dest;
  object vic, env;
  int cnt;

  notify_fail("Schleudere Schlammklumpen nach wem?\n");
  if (!str) return 0;
  if (sscanf(str, "%s nach %s", what, dest) != 2)
    return 0;
  notify_fail("Du kannst nur einen Schlammklumpen auf einmal schleudern!\n");
  if (sscanf(what, "%d %s", cnt, what)==2 && cnt>1 && id(what))
    return 0;
  else
    if (!id(what))
      return 0;
  if (!(env=environment(this_object())))
    remove();
/*  notify_fail("Das kannst Du im Moment nicht tun!\n");
  if (env->QueryProp(P_ATTACK_BUSY))
    return 0; */
  
  vic=present(dest, environment(env));
  if (!vic) {
    write("Kein solches Lebewesen in der Naehe!\n");
    return 1;
  }

  notify_fail("Du kannst den Schlammklumpen nicht auf Spieler schleudern!\n");
  if (vic->id("Spieler"))
    return 0;

//  env->SetProp(P_ATTACK_BUSY, 1);

  write("Du schleuderst einen Schlammklumpen nach "+vic->name(WEM)+".\n");
  say(env->name(WER)+" wirft einen Schlammklumpen nach "+vic->name(WEM)+".\n");

  vic->do_damage(5);

  SetProp(P_AMOUNT, QueryProp(P_AMOUNT)-1);
/*
  write("Schaden:");
  for (i=0; i<sizeof(liv); i++)
    write(sprintf(" %d.", liv[i]->QueryProp(P_MAX_HP)-liv[i]->QueryProp(P_HP)));
  write("\n");
*/
  return 1;
}

