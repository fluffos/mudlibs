
inherit "obj/container";

#include <container.h>
#include <properties.h>
#include <language.h>
#include <material.h>
#include <moving.h>
#include "../files.h"

create()
{
  object o;

  if (!is_clone(TO))
    return;

  ::create();
  SetProp(P_NAME, "Registrierkassa");
  SetProp(P_SHORT, "Eine alte schwere Registrierkassa");
  SetProp(P_LONG, BS(
          "Die schwere Registrierkassa scheint wirklich schon ein sehr"
         +" altes Ding zu sein. Ausser der Kassenlade sieht man nichts"
         +" mehr daran."));
  AddDetail(({"lade", "kassenlade"}), BS(
            "An der Kassenlade befindet sich ein winziges Schloss."));
  AddDetail("schloss", BS(
            "Um an das Innere der Kassa zu gelangen muss man das Schloss"
           +" oeffnen."));
  SetProp(P_MATERIAL, ([MAT_IRON:85, MAT_OAK:15]));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_NOGET, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MAX_WEIGHT, 6000);
  AddId("kassa");
  AddId("registrierkassa");
  SetProp(P_CNT_STATUS, CNT_STATUS_LOCKED);
  SetProp(P_CNT_KEY, "\nKassakey");
  o=clone_object("/obj/money");
  o->SetProp(P_AMOUNT, random(70));
  o->move(TO, M_NOCHECK);
  o=clone_object(OBJ("tiegel"));
  o->move(TO, M_NOCHECK);
}

reset()
{
  object o;

  ::reset();
  if (!present("geld")) {
    o=clone_object("/obj/money");
    o->SetProp(P_AMOUNT, random(70));
    o->move(TO, M_NOCHECK);
  }
  if (!present("tiegel")) {
    o=clone_object(OBJ("tiegel"));
    o->move(TO, M_NOCHECK);
  }
  SetProp(P_CNT_STATUS, CNT_STATUS_LOCKED);
}

int do_open(string args)
{
  int old, ret;
  object k;

  old=QueryProp(P_CNT_STATUS);
  ret=::do_open(args);
  if (old==CNT_STATUS_LOCKED && QueryProp(P_CNT_STATUS)==CNT_STATUS_OPEN) {
    tell_object(TP,
        BS("Beim Herausziehen des Schluessels entgleitet er Dir zwischen"
          +" den Fingern und faellt in eine Ritze im Fussboden. Du hoerst"
          +" ihn nicht einmal aufprallen."));
    k=present("\nKassakey", TP);
    if (k)
      k->remove();
  }
  return ret;
}

