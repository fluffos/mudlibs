inherit "/std/thing";

#include "../files.h"
#include <language.h>
#include <properties.h>
#include <material.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein herrlicher Silberschluessel");
  SetProp(P_LONG, BS(
          "Du siehst einen schoenen, gut gearbeiteten Schluessel aus reinstem"
         +" Silber. Du siehst ein Symbol am Griff."));
  AddDetail(({"kreis", "symbol", "griff"}), BS(
            "Es handelt sich um einen eingravierten Kreis, durch den ein Tiger"
	   +" zu springen scheint."));
  AddDetail(({"gravur", "tiger"}), BS(
            "Die Gravur ist sehr fein, man kann den Tiger gut erkennen."));
  AddId("schluessel");
  AddId("\nADJkey");
  AddId("silberschluessel");
  SetProp(P_WEIGHT, 80);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_NAME, "Schluessel");
}

string QueryDoorKey()
{
  return ROOM("j4")+":"+ROOM("k4");
}

