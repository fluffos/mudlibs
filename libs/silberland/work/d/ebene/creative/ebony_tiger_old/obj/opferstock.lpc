inherit "obj/container";

#include "../files.h"
#include <language.h>
#include <material.h>
#include <properties.h>
#include <container.h>
#include <bank.h>

mixed saveload;

nosave mapping spender;

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_NAME, "Opferstock");
  SetProp(P_SHORT, "Ein Opferstock");
  SetProp(P_LONG, BS(
          "Das ist ein Opferstock. Er dient zum Spenden von Geld."));
  AddId("opferstock");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOGET, "Der Opferstock ist am Boden festgeschraubt.\n");
  SetProp(P_WEIGHT, 50000);
  SetProp(P_MATERIAL, ([MAT_MARBLE:80, MAT_BRASS:15, MAT_IRON:5]));
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
  SetProp(P_MAX_WEIGHT, 50000);
  SetProp(P_CNT_KEY, "ASDLKJ");
  if (restore_object(LOG("spender")))
    spender=saveload;
  else
    spender=([]);
  saveload=0;
}

PreventInsert(object o)
{
  int am;

  if (!o->id("geld"))
    return 1;
  am=o->QueryProp(P_AMOUNT);
  call_out("dank", 0, TP, am);
  o->remove();
  ZENTRALBANK->PayIn(am);
  if (member(spender, getuid(TP))==-1)
    spender+=([getuid(TP):am]);
  else
    spender[getuid(TP)]=spender[getuid(TP)]+am;
  saveload=spender;
  save_object(LOG("spender"));
  saveload=0;
  return 0;
}

dank(object wem, int am)
{
  tell_object(wem, BS(
              "Du spendest "+am+" Muenze"+(am==1?"":"n")+". Das Geld klackert weit"
	     +" nach unten und verschwindet im Nichts."));
}


string Spender()
{
  string *sub, *sp;
  string str;
  int i, am;

  str="";
  if (!sizeof(spender))
    return str;
  sub=({});
  sp=m_indices(spender);
  for (i=sizeof(sp)-1; i>=0; i--)
    if ((am=spender[sp[i]])>=1500)
      sub+=({CAP(sp[i])+" ("+(am>5000?am/1000+"k":am)+")"});
  if (!sizeof(sub))
    return str;
  for (i=sizeof(sub)-1; i>0; i--)
    str+=sub[i]+", ";
  str+=sub[i];
  return str;
}

