inherit "std/thing";

#include <language.h>
#include <properties.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Moospulver");
  SetProp(P_SHORT, "Etwas Moospulver");
  SetProp(P_LONG, BS(
          "Das Moospulver dient wohl als Ingredienz eines Balsams."));
  SetProp(P_VALUE, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_MATERIAL, MAT_MISC_HERBAL);
  AddId("moospulver");
  AddId("pulver");
}

