// Generalschluessel

inherit "/std/thing";

#include "../files.h"
#include <language.h>
#include <properties.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein Generalschluessel");
  SetProp(P_LONG, BS(
          "Mit diesem Schluessel kannst Du scheinbar mehr als nur eine Tuer"
         +" sperren."));
  AddId("schluessel");
  AddId("GKEY");
  SetProp(P_WEIGHT, 40);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Schluessel");
}

string *QueryDoorKey()
{
  return ({
	    ROOM("h4")+":"+ROOM("i4"),
	    ROOM("j4")+":"+ROOM("k4"),
	    ROOM("l4")+":"+ROOM("l5"),
	    ROOM("n3")+":"+ROOM("n4"),
	    ROOM("n4")+":"+ROOM("n5")
	 });
}

