inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <material.h>
#include "../files.h"

string ing;

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_NAME, "Pulver");
  SetProp(P_SHORT, "Ein geheimnisvolles Pulver");
  AddId("pulver");
  AddId("\nEBpulv");
  SetProp(P_LONG, BS(
      "Ein geheimnisvolles Pulver aus Dir unbekanntem Material. Pass auf dass"
     +" es Dir nicht durch die Finger rieselt."));
  SetProp(P_VALUE, 30);
  SetProp(P_WEIGHT, 40);
  SetProp(P_MATERIAL, MAT_MISC_DEAD);
  SetProp(P_GENDER, NEUTER);
  ing="";
}

_query_info()
{
  return BS(
      "Du untersuchst das Pulver genauer und erkennst, dass es "
     +(ing=="schuppe"?"von einer Drachenschuppe":"vom Herz einer Eisschlange")
     +" stammt.");
}

MadeFrom(str)
{
  ing=str;
}

string QueryMadeFrom()
{
  return ing;
}

