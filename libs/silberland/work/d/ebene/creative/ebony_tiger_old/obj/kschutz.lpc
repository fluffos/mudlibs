#include <language.h>
#include <properties.h>
#include <material.h>
#include "../files.h"
#include <moving.h>

inherit "std/thing";

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_NAME, "Balsam");
  SetProp(P_SHORT, "Ein Balsam");
  SetProp(P_LONG, BS(
          "Mit diesem Balsam kannst Du eine beliebige Ruestung Deiner"
         +" Wahl einbalsamieren."));
  SetProp(P_INFO, BS(
          "Der Balsam verleiht Deiner Ruestung einen wahrhaftig"
         +" meisterhaften Kaelteschutz."));
  SetProp(P_WEIGHT, 300);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_FAT:80, MAT_MISC_HERBAL:20]));
  AddId("balsam");
  AddId("\balm");
  SetProp(P_VALUE, 1000);
  AddCmd(({"balsamier", "balsamiere"}), "balm");
}

balm(str)
{
  object a;
  string was;
  mapping t;

  notify_fail("Was moechtest Du einbalsamieren?\n");
  if (!str)
    return 0;
  if (sscanf(str, "%s ein", was)!=1)
    return 0;
  if (!(a=present(was, TP))) {
    write("Das hast Du doch gar nicht bei Dir!\n");
    return 1;
  }
  if (!a->id("Ruestung")) {
    write("Der Balsam macht nur bei Ruestungen einen Sinn!\n");
    return 1;
  }
  if (a->QueryProp(P_AC)<4) {
    write(BS(
        "Die Ruestung bietet doch von vornherein kaum Schutz, wie willst"
       +" Du da durch den Balsam noch mehr erreichen."));
    return 1;
  }
  write(BS("Du balsamierst "+name(WEN, 2)+" heftig ein und siehst "
      +name(WEN, 2)+" einmal kurz heftig blaeulich aufgluehen."));
  t=a->QueryProp(P_TEMPERATURE_PROTECTION);
  a->SetProp(P_TEMPERATURE_PROTECTION, 
      ([T_COLD_PROT:t[T_COLD_PROT]+5, T_HEAT_PROT:t[T_HEAT_PROT]]));
  TO->remove();
  return 1;
}

