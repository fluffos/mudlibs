inherit "/std/thing";

#include "../files.h"
#include <language.h>
#include <properties.h>
#include <material.h>
#include <thing.h>

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein winziger Silberschluessel");
  SetProp(P_LONG, BS(
          "Pass bloss auf dass Du den winzigen Schluessel nicht zwischen den"
         +" Fingern verlierst, so klein ist er. Er scheint zu einem kleinen"
         +" Schloss zu gehoeren."));
  AddId("schluessel");
  AddId("silberschluessel");
  AddId("\nKassakey");
  SetProp(P_WEIGHT, 80);
  SetProp(P_NOSELL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_NAME, "Silberschluessel");
}

