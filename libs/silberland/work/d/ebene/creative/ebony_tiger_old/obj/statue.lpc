inherit "std/thing";

#include <language.h>
#include <properties.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_NAME, "Tigerstatue");
  SetProp(P_SHORT, "Eine kleine Tigerstatue");
  SetProp(P_LONG, BS("Das ist eine kleine Tigerstatue, die einen"
         +" furchterregenden Tiger waehrend einem Sprung darstellt."));
  SetProp(P_INFO, BS("Diese Statue hat irgendwie eine innere Aura. Das Material,"
         +" aus dem sie gefertigt ist, ist kostbarstes Elfenbein, und die Plattform,"
         +" auf dem der Tiger befestigt ist, ist aus edelstem Eichenholz."));
  AddDetail("aura", BS(
            "Nunja, recht genau kannst Du die Aura des Tiers nicht einordnen,"
           +" jedoch ist die Gegend, aus der sie stammt, doch irgendwie mystisch"
           +" und mit einer Art Macht behaftet."));
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 180);
  SetProp(P_GENDER, FEMALE);
  AddId("tigerstatue");
  AddId("statue");
  AddId("\tstatue");
  SetProp(P_MATERIAL, ([MAT_OAK:20, MAT_IVORY:80]));
}

