#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/thing";

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Ein alter vergilbter Zettel");
  SetProp(P_LONG, BS(
          "Dieser alte vergilbte Zettel enthaelt schoen geschriebene,"
         +" alte Schriftzeichen. Man kann ihn lesen."));
  AddDetail(({"zeichen", "schriftzeichen"}), BS(
            "Scheinbar handelt es sich um etwas aehnliches wie ein Rezept."));
  AddDetail("macht", BS(
            "Irgendetwas Besonderes muss der Text auf dem Zettel aussagen..."
           +" Du solltest einmal Vannor den Zettel geben, vielleicht kann"
           +" der mehr damit anfangen."));
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 30);
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_READ_MSG,
      "\n +------------------------------------------------------+\n"
     +" | 'Vom Hauch des Todes geschmiedet erschuf der Wurm    |\n"
     +" |  seinen Panzer. Unbrennbar steht es als Zeichen      |\n"
     +" |  des Feuers.                                         |\n"
     +" |                                                      |\n"
     +" |  Das Leben der Schlange soll nie erloeschen, ward    |\n"
     +" |  Sie doch geboren in kaeltester Nacht. Erstarrt auf  |\n"
     +" |  ewig haelt es das Eis.                              |\n"
     +" |                                                      |\n"
     +" |  Vermischt mit dem Hoechsten, was Gott uns schuf     |\n"
     +" |  erlangt es seine Erfuellung in Vollendung.          |\n"
     +" |                                                      |\n"
     +" |  Bestaerkt durch das Ziel und gekraeftigt            |\n"
     +" |  durch Substanz wird diese Essenz verheissen         |\n"
     +" |  das Licht.                                          |\n"
     +" |  Lasset uns geschuetzt sein vor dem Unbekannten,     |\n"
     +" |  das nur spuerbar.'                                  |\n"
     +" +------------------------------------------------------+\n\n");
  SetProp(P_INFO, BS(
          "Du spuerst, dass diesem Zettel eine ganz besondere Macht innewohnt."));
  AddId("rezept");
  AddId("zettel");
  AddId("EBrezep\t");
  AddAdjective(({"alter", "vergilbter", "alten", "vergilbten"}));
}

