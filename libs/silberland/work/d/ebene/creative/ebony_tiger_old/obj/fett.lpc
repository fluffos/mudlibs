inherit "std/thing";

#include <language.h>
#include <properties.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Fett");
  SetProp(P_SHORT, "Fluessiges Fett");
  SetProp(P_LONG, BS(
          "Fluessiges Fett ist die Grundlage einer jeden Creme oder eines jeden"
         +" Balsams."));
  SetProp(P_VALUE, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_MATERIAL, MAT_FAT);
  AddId("fett");
  AddId("fe\t\t");
}

