inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_NAME, "Moos");
  SetProp(P_SHORT, "Ein Bueschel Moos");
  AddId("bueschel");
  AddId("moos");
  AddId("\nEBMoos");
  SetProp(P_LONG, BS(
      "Das Bueschel Moos ist gut mit Wasser getraenkt. Wenn man es isst, so"
     +" gibt es bestimmt so einiges an Energie zurueck."));
  SetProp(P_VALUE, 3);
  SetProp(P_FOOD_INFO, ([ 
      F_HEAL:({25, 30}), F_SOAK:4, F_DRINK:6,
      F_MSG:"Du isst das Bueschel Moos auf und fuehlst Dich erleichtert.\n",
      F_MSG_ROOM:" isst ein Bueschel Moos.\n" ]));
  SetProp(P_WEIGHT, 140);
  SetProp(P_MATERIAL, ([MAT_EARTH:10, MAT_MISC_FOOD:90]));
  SetProp(P_GENDER, NEUTER);
}

