mixed FromTo(mixed from, mixed to)
{
  int f, t;
  string *way;

  if (stringp(from)) 
    f=member(Area, from);
  else
    if (intp(from))
      f=from;
  if (stringp(to))
    t=member(Area, to);
  else
    if (intp(to))
      t=to;
  way=({});
  if (t>=0 && f >=0) {
    while (!stringp(Ways[f][t])) {
      way+=({Ways[f][Ways[f][t]]});
      f=Ways[f][t];
    }
    way+=({Ways[f][t]});
  }
  return way;
}


