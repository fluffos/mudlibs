#include "../files.h"

nosave string *keys;
nosave string *used;

create()
{
  if (is_clone(TO)) {
    destruct(TO);
    return;
  }

  keys=({ OBJ("keycd3"), OBJ("keyhi4"), OBJ("keyjk4"),
          OBJ("keyn34"), OBJ("keyl45"), OBJ("keyn45")
       });
  used=({});
}

object DistributeKey()
{
  object ob;
  int i;

  ob=0;
  if (sizeof(keys)) {
    i=random(sizeof(keys));
    ob=clone_object(keys[i]);
    used+=({keys[i]});
    keys-=({keys[i]});
  }
  return ob;
}

RemoveKey(object k)
{
  string key;

  key=file_name(k);
  used-=({key});
  keys+=({key});
}

DumpSize()
{
  printf("Anzahl noch zu verteilender Schluessel: %d\n", sizeof(keys));
}

