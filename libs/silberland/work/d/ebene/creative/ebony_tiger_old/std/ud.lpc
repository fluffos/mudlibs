inherit "/d/ebene/creative/ebony_tiger/std/room.lpc";

#include "../files.h"
#include <room.h>
#include "../sys/vt100.h"
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();

  SetProp(P_LIGHT, 0);
  SetProp(P_INT_SHORT, "");

  AddSpecialExit("norden", "north");
  AddSpecialExit("osten", "east");
  AddSpecialExit("westen", "west");
  AddSpecialExit("sueden", "south");
}

int my_x, my_y;

set_xy(int x, int y)
{
  my_x=x; my_y=y;
}

query_x() { return my_x; }

query_y() { return my_y; }

init()
{
  ::init();

  UMSTR->init_player(this_player(), my_x, my_y);
}

/* exit()
{
  ::exit();

  if (IS_LEARNER(this_player()) && this_player()->QueryProp(P_WANTS_TO_LEARN))
    UMSTR->remove_player(this_player());
} */

int north()
{
  return UMSTR->move_north(this_player());
}

int south()
{
  return UMSTR->move_south(this_player());
}

int west()
{
  return UMSTR->move_west(this_player());
}

int east()
{
  return UMSTR->move_east(this_player());
}

string int_short(mixed vi, mixed vp, int f)
{
//  if (vi==find_player("creative"))
//    printf("%d\n", get_eval_cost());
  return VT_CLS+"\n\n"+UMSTR->query_surround(vi)+"\n"+::int_short(vi, vp, f);
}

string int_long(mixed vi, mixed vp, int f)
{
  return VT_CLS+"\n\n"+UMSTR->query_surround(vi)+"\n"+::int_long(vi, vp, f);
}

