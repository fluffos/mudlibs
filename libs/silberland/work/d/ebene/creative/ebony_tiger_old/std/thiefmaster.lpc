#include <language.h>
#include <properties.h>
#include "../files.h"

nosave object *helpers, *thieves;

create()
{
  if (is_clone(TO)) {
    destruct(TO);
    return;
  }
  helpers=({});
  thieves=({});
}

int Help(object vic)
{
  if (sizeof(helpers))
    helpers[random(sizeof(helpers))]->Help(vic);
}

RegisterThief(object t)
{
//  DEBUG("tmstr", sprintf("%O -> thieves\n",t));
  if (is_clone(t))
    thieves+=({t});
}

RemoveThief(object t)
{
//  DEBUG("tmstr", sprintf("thieves -> %O\n",t));
  if (is_clone(t))
    thieves-=({t});
}

RegisterHelper(object h)
{
//  DEBUG("tmstr", sprintf("%O -> helpers\n",h));
  if (is_clone(h))
    helpers+=({h});
}

RemoveHelper(object h)
{
//  DEBUG("tmstr", sprintf("helpers -> %O\n",h));
  if (is_clone(h))
    helpers-=({h});
}

mixed DumpHelpers()
{
  return helpers;
}

mixed DumpThieves()
{
  return thieves;
}

