inherit "/std/thing";

#include <language.h>
#include <properties.h>
#include <combat.h>
#include <weapon.h>
#include <material.h>
#include <moving.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();
  SetProp(P_SHORT, "Ein Dornenspeer (in Dir steckend)");
  SetProp(P_LONG, BS(
          "Das ist ein mit fiesen Dornen und Widerhaken besetzter"
         +" Speer mit einer Spitze aus Stahl, der in Deinem Koerper steckt."));
  AddDetail("dornen", BS(
            "Die Dornen hinterlassen sicherlich tiefe Wunden."));
  AddDetail(({"widerhaken", "haken"}), BS(
            "Hoffentlich bringst Du den Speer aus Dir heraus!!"));
  SetProp(P_NAME, "Dornenspeer");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 12400);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ([MAT_FIR:60, MAT_IRON:15, MAT_STEEL:25]));
  SetProp(P_ARTICLE, 1);
  AddId("speer");
  AddId("dornenspeer");
  SetProp(P_NODROP, "Der Speer steckt so tief, Du musst ihn schon herausreissen!\n");
  SetProp(P_NOSELL, "Der Speer steckt so tief, Du musst ihn schon herausreissen!\n");
  AddCmd(({"reiss", "reisse"}), "rip");
}

rip(str)
{
  object o;

  notify_fail("Was willst Du herausreissen?\n");
  if (!str)
    return 0;
  if (str!="speer heraus" && str!="dornenspeer heraus")
    return 0;
  write("Du reisst den Speer mit einem Ruck aus Deinem Koerper heraus.\n");
  say(BS(
      TP->Name(WER)+" reisst mit einem Ruck einen Dornenspeer aus "
     +(TP->QueryProp(P_GENDER)==FEMALE?"ihr":"sein")+"em Koerper heraus."));
  TP->do_damage(20+random(10));
  o=clone_object(WEAPON("speer"));
  o->move(TP, M_NOCHECK);
  TO->remove();
  return 1;
}

string extra_look()
{
  if (ENV(TO))
    return ENV(TO)->Name(WEM)+" steckt ein Dornenspeer im Fleisch.\n";
  return "";
}

int move(mixed dest, int method)
{
  object o;

  o=QueryProp("nenv");
  if (dest!=o) {
    o=clone_object(WEAPON("speer"));
    o->move(dest, M_NOCHECK);
    return 1;
  }
  return ::move(dest, method);
}

