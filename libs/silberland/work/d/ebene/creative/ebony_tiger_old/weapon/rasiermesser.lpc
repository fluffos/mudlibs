inherit "std/weapon";

#include <weapon.h>
#include <combat.h>
#include <properties.h>
#include <language.h>
#include <material.h>
#include <moving.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, "Ein scharfes Rasiermesser");
  SetProp(P_LONG, BS(
          "Mit diesem Rasiermesser geht bestimmt jeder Bart im Nu weg."));
  SetProp(P_NAME, "Rasiermesser");
  SetProp(P_VALUE, 100);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 30);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_STEEL);
  SetProp(P_WEIGHT, 40);
  AddId("messer");
  AddId("rasiermesser");
  AddCmd(({"rasier", "rasiere"}), "shave");
}

shave(str)
{
  object e, vic;

  notify_fail("Wen oder was willst Du rasieren?\n");
  if (!str)
    return 0;
  if ((e=ENV(TO)) && (e=ENV(e)) && (vic=present(str, e)) && living(vic)) {
    if (vic!=ENV(TO))
      if (vic->QueryProp(P_GENDER)==FEMALE) {
        write(BS(
            vic->name(WER)+" wuerde es nicht wollen, von Dir rasiert zu werden."));
        tell_object(vic, TPN+" hat ueberlegt, Dir eine Rasur zu verpassen.\n");
        tell_room(e, TPN+" ueberlegt, "+vic->name(WEN)+" zu rasieren.\n", ({ TP, vic }));
      }
      else {
        write(BS(
            "Nein, das wuerde Dein Rasiermesser nur voellig stumpf machen,"
           +" wenn Du "+vic->name(WEN)+" jetzt rasieren wolltest."));
        tell_object(vic, TPN+" hat ueberlegt, Dir eine Rasur zu verpassen.\n");
        tell_room(e, TPN+" ueberlegt, "+vic->name(WEN)+" zu rasieren.\n", ({ TP, vic }));
      }
    else {
      if (vic->QueryProp(P_GENDER)==FEMALE) {
        write(BS(
            "AUTSCH! Du versuchst, Deine Beine ein bisschen zu enthaaren, ziehst"
           +" Dir jedoch eine haessliche Schnittwunde zu."));
        tell_room(e, TPN+" will sich ihre Beine rasieren, ist aber zu ungeschickt.\n",
            ({ENV(TO)}) );
      }
      else {
        write(BS(
            "AUTSCH! So ein Mist! Beim Versuch, Dir den Bart zu stutzen, schneidest"
           +" Du Dir ganz arg in die Wange."));
        tell_room(e, TPN+" schneidet sich bei einem Rasierversuch in die Wange.\n",
            ({ENV(TO)}) );
      }
      TP->reduce_hit_point(30);
    }
  }
  else
    if (e && e==find_object(ROOM("h2")) && (str=="mooskopf" || str=="moos")
        && e->QueryMoss()) {
      write(BS(
          "Du rasierst den Mooskopf komplett kahl und steckst Dir"
         +" ein besonders schoenes Moosbueschel ein. Dabei bricht Dir leider"
         +" die Rasierklinge ab."));
      tell_room(e, TPN+" kratzt an der Wand herum.", ({ ENV(TO) }));
      (clone_object(OBJ("moos")))->move(TP, M_NOCHECK);
      e->NoMoss();
      TO->remove();
    }
    else
      return 0;
  return 1;
}

