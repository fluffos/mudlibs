inherit "std/weapon";

#include <weapon.h>
#include <combat.h>
#include <properties.h>
#include <language.h>
#include <material.h>
#include <new_skills.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, "Lenti's Messer");
  SetProp(P_LONG, BS(
          "Das ist das Messer von Lenti, dem Dieb. Es ist besonders lang"
         +" und scharf und sieht aeusserst gefaehrlich aus. Der Griff des"
         +" Messers ist reich verziert mit den schoensten Edelsteinen."));
  AddDetail("griff", BS(
            "Auf dem Griff des Messers gibt es herrliche Edelsteine."));
  AddDetail("edelsteine", BS(
            "Du bist einfach ueberwaeltigt von der Pracht der Edelsteine."));
  SetProp(P_NAME, "Lenti's Messer");
  SetProp(P_ARTICLE, 0);
  SetProp(P_VALUE, 1500);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 160);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:25, MAT_STEEL:60, MAT_OPAL:10, MAT_DIAMOND:1, MAT_SAPPHIRE:4]));
  SetProp(P_WEIGHT, 700);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:20,A_INT:10,P_LEVEL:20,SR_BAD:-600,
            SM_RACE:(["Zwerg":([A_DEX:18,A_INT:10,P_LEVEL:20]),
                      "Hobbit":([A_DEX:20,A_INT:8,P_LEVEL:19]),
                      "Elf":([A_DEX:16,A_INT:12,P_LEVEL:21]),
                      "Mensch":([A_DEX:21,A_INT:7,P_LEVEL:22])])
          ]));
  AddId("messer");
  SetProp(P_HIT_FUNC, TO);
}

int HitFunc(object e)
{
  int dam;

  dam=0;
  if (e->QueryAttribute(A_DEX)<15)
    dam+=10+random(30);
  if (e->QueryProp(P_SIZE)<80)
    dam+=40;
  if (e->QueryProp(P_RACE)=="Mensch")
    dam+=random(50);
  return dam;
}

