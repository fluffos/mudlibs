inherit "std/weapon";

#include <material.h>
#include <weapon.h>
#include <combat.h>
#include <language.h>
#include <properties.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Eine Keule");
  SetProp(P_LONG, BS("Das ist eine Keule, die mit spitzen Eisennaegel besetzt"
                    +" ist."));
  AddDetail(({"naegel", "eisennaegel"}), BS(
            "Diese Naegel scheinen besonders tiefe Wunden bei Gegnern zu reissen."));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 500);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Keule");
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 100);
  SetProp(P_WC_FIXFACTOR, 0.1);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_RIP}));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_CONIFER_WOOD:80, MAT_IRON:20]));
  AddId("keule");
}
