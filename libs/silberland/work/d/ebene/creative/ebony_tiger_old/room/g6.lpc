/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Suedlicher Wehrturm");
  SetProp(P_INT_SHORT, "Im Suedlichen Wehrturm");

  SetProp(P_INT_LONG, BS(
          "Du stehst in einem Gang eines alten Wehrturms. Trotzdem die"
         +" Festung schon lange nicht mehr existiert, hat man die alten"
         +" Gaenge und Raeume ordentlich restauriert, so dass sie wieder"
         +" benutzbar sind. Im Norden ist ein Lagerraum und gleichzeitig"
         +" auch ein Geschaeft."));
  AddDetail("boden", BS(
            "Der Boden ist mit Steinfliesen ausgelegt, die ein huebsches"
           +" Muster bilden. Oestlich davon ist nur festgetretene Erde."));
  AddDetail(({"fliesen", "platten", "granitplatten", "steinfliesen"}), BS(
            "Wahrscheinlich handelt es sich um Granitbruch, die so gut"
           +" es geht aneinander gelegt sind. Die Fugen sind gut ausgemoertelt,"
           +" so dass keine Luecke entsteht."));
  AddDetail(({"granitbruch", "steinbruch", "bruch"}), BS(
            "Wenn im Steinbruch mal etwas schiefgeht, so entsteht Granitbruch."));
  AddDetail("fugen", BS(
            "Zwischen den einzelnen Steinfliesen entstehen natuerlich durch"
           +" die unterschiedlichen Formen Fugen, die mit Moertel ausgefuellt"
           +" sind."));
  AddDetail("formen", BS(
            "Die Granitplatten haben total unterschiedliche Formen, es"
           +" handelt sich ja schliesslich um Bruch."));
  AddDetail("moertel", BS(
            "Die Fugen zwischen den unregelmaessigen Fliesen sind mit Moertel"
           +" gut ausgefuellt."));
  AddDetail("luecke", BS(
            "So sehr Du Dich auch anstrengst, hier war wirklich ein wahrer"
           +" Meister am Werk, Du kannst wirklich keine Luecke sehen."));
  AddDetail(({"werk", "meister"}), BS(
            "Die Festung ist uralt, es muss schon ein Meister am Werk"
           +" gewesen sein, sonst haette das Gemaeuer hier nicht ueberleben"
           +" koennen."));
  AddDetail("festung", BS(
            "So manches deutet darauf hin, dass dies der suedliche Wehrturm"
           +" einer alten Festung ist."));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Obwohl Du an und fuer sich unter der Erde bist, handelt"
           +" es sich hier um die Grundfeste eines alten Wehrturms."));
  AddDetail("decke", BS(
            "Die Decke ist gut gestuetzt durch Holzbalken, die quer zum"
           +" Gang verlegt sind."));
  AddDetail(({"balken", "holzbalken", "pfosten"}), BS(
            "Diese Pfosten sind wahrhaftig maechtig, sie koennen die Decke"
           +" wirklich gut stuetzen."));
  AddDetail("erde", BS(
            "Oestlich von hier ist der Boden des Ganges nur festgestampfte"
           +" Erde."));
  AddDetail("ganges", BS(
            "Das ist ein bekannter Fluss in Indien. Hoppla, das gehoert nicht"
           +" hierher. :)"));
  AddDetail("fluss", BS(
            "Fluss? Hier unten? Nie gesehen."));
  AddDetail("indien", BS(
            "So heisst unter anderem ein beruehmter Film."));
  AddDetail("film", BS(
            "Was allerdings ein Film ist, passt nun wirklich nicht hierher."));
  AddDetail(({"gaenge", "gang"}), BS(
            "Der Gang hier unten gehoert zum suedlichen Wehrturm einer alten"
           +" verfallenen Festung."));
  AddDetail("muster", BS(
            "Durch die verschiedenen Formen der Granitplatten ergibt sich ein"
           +" interessantes Muster am Boden."));
  AddDetail("raeume", BS(
            "Sehr viele Raeume hier unten wurden gut restauriert, um sie"
           +" wieder benutzen zu koennen. Dazu gehoert auch unter anderem"
           +" das Geschaeft im Norden."));
  AddDetail("geschaeft", BS(
            "Wahrscheinlich laesst sich hier unten so manches gut absetzen."));
  AddDetail(({"raum", "lagerraum"}), BS(
            "Der Lagerraum des Geschaeftes befindet sich ebenfalls im Norden."));
  AddDetail(({"waende", "wand"}), BS(
            "Die Waende sind wie ueberall hier aus grossen Steinbloecken und"
           +" bilden die Grundfeste des suedlichen Wehrturms."));
  AddDetail(({"bloecke", "steinbloecke"}), BS(
            "Massive unverrueckbare Steinbloecke zeugen von wahren Meistern,"
           +" die hier am Werk waren und diese Festung geschaffen haben."));
  AddDetail(({"feste", "grundfeste"}), BS(
            "Die Grundfeste der alten Festung sind so solide gebaut, dass die"
           +" alten Gaenge und Raeume auch jetzt noch benutzt werden."));
  AddDetail("gemaeuer", BS(
            "Obwohl es sich hier unten um ein wirklich altes Gemaeuer handelt,"
           +" sind doch viele Raeume benutzbar und werden bewohnt."));
  AddDetail(({"wurm", "holzwurm"}), BS(
            "An und fuer sich ist auf den Holzbalken nichts zu entdecken, was"
           +" auf einen Holzwurm hindeuten koennte."));

  AddSound(DEFAULT_SOUND, BS(
           "Du kannst nur ein leises Knistern vernehmen, das von oben"
          +" kommt."));
  AddSound("knistern", BS(
           "Das Knistern kommt direkt von den Holzbalken."));
  AddSound(({"balken", "holzbalken"}), BS(
           "Vielleicht hat sich hier irgendwo ein Holzwurm eingenistet."
          +" Du solltest Dir keine Sorgen machen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Von Westen her kommt ein gut wuerziger Geruch nach Pflanzen und"
          +" frischer Luft."));
  AddSmell(({"pflanzen", "luft", "geruch"}), BS(
           "In westlicher Richtung duerfte es einen Ausgang geben, deshalb"
          +" kannst Du hier schon die frische Luft riechen."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("westen", ROOM("f6"));
  AddExit("osten", ROOM("h6"));
  AddExit("norden", ROOM("g5"));
}

