/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int moss;

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Enger Gang");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich in einem engen Gang der vom Suedosten nach Norden"
         +" fuehrt. Im Suedosten befindet sich der zentrale Treffpunkt,"
         +" im Norden gelangst Du in die kleinen Nebenraeume. Der Gang dient"
         +" nur als Verbindungsmittel, ist also ueberhaupt nicht eingerichtet."));
  AddDetail(({"raeume", "nebenraeume"}), BS(
            "Nebenraeume der Gilde liegen eher im Norden."));
  AddDetail(({"mittel", "verbindung", "verbindungsmittel"}), BS(
            "Der Gang ist die Verbindung zwischen dem suedlicheren und noerdlichen"
           +" Gebiet."));
  AddDetail("gang", BS(
            "Der Gang fuehrt von Suedosten nach Norden."));
  AddDetail("suedosten", BS(
            "Im Suedosten gelangst Du weiter zum Treffpunkt."));
  AddDetail(({"punkt", "treffpunkt", "orientierungspunkt", "mitte"}), BS(
            "Nachdem der Treffpunkt ziemlich in der Mitte des Gebietes liegt,"
           +" dient er zur Orientierung fuer alle, die hier herumlaufen."));
  AddDetail("gebiet", BS(
            "Das hier ist die Gilde des Elfenbeinernen Tigers."));
  AddDetail("tiger", BS(
            "Wehe dem, der die Rache des Tigers zu spueren kriegt."));
  AddDetail("rache", BS(
            "Der allmaechtige Tiger, Beschuetzer der Gilde, ist sehr stark."));
  AddDetail(({"gilde", "beschuetzer"}), BS(
            "Der Beschuetzer der Gilde ist ein maechtiger Tiger."));
  AddDetail("orientierung", BS(
            "Du hoffst, die Orientierung nicht zu verlieren."));
  AddDetail("waende", BS(
            "An der westlichen Wand haengt eine Fackel, die den Gang erleuchtet."));
  AddDetail(({"westwand", "wand", "westliche wand"}), BS(
            "Die Fackel an der westlichen Wand fackelt aufgeregt, es muss hier"
           +" ein Luftzug zu spueren sein."));
  AddDetail(({"luft", "luftzug"}), BS(
            "Ein winziges Loch duerfte da irgendwo sein. Du gehst dem Luftzug nach"
           +" und entdeckst eine gewaltige Woelbung an einer Wand."));
  AddDetail("loch", BS(
            "Du kannst das Loch einfach nicht entdecken."));
  AddSpecialDetail("woelbung", "wlb");
  AddSpecialDetail(({"form", "kopf", "mooskopf"}), "head");
  AddSpecialDetail(({"bart", "moos"}), "beard");
  AddDetail("umgebung", BS(
            "Der Gang hier ist sehr eng. Wenn Du jemand begegnest, musst Du dich ganz"
           +" schmal machen."));
  AddDetail("boden", BS(
             "Auf dem Boden sind vereinzelt Wassertropfen zu sehen."));
  AddDetail(({"tropfen", "wassertropfen"}), BS(
            "Nachdem es hier einigermassen feucht ist, tropfen die Tropfen eben"
           +" ab und zu von der Decke."));
  AddDetail("decke", BS(
            "Von der Decke tropft ab und zu ein Tropfen herab."));
  AddRoomMessage(({"*tropf*\n",
                   "Ein Tropfen faellt von der Decke auf den Boden.\n",
                   "*plitsch*\n"}), 40);
  AddDetail("fackel", BS(
            "Die Fackel erhellt den Gang."));

  AddSound(DEFAULT_SOUND, BS(
           "Es kommt Dir vor, als ob Du ausser dem Flackern der Fackel"
          +" auch noch ein leises Pfeifen hoerst."));
  AddSound("fackel", BS(
           "Die Fackel flackert im lauen aber spuerbaren Luftzug."));
  AddSound(({"pfeifen", "luft", "luftzug"}), BS(
           "Irgendwo muss da ein Luftzug herkommen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Hier riecht es nach frischer Luft. Irgendwo muss da ein Luefterl"
          +" gehen."));
  AddSmell(({"luft", "luefterl"}), BS(
           "Du musst das Luefterl schon aufspueren!"));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("suedosten", ROOM("i3"));
  AddExit("norden", ROOM("h1"));
  moss=1;
}

int QueryMoss() { return moss; }

int NoMoss() { moss=0; }

reset()
{
  ::reset();
  moss=1;
}

wlb()
{
  if (moss)
    return BS(
        "Die Woelbung an der Wand hat fast die Form eines Kopfes. Durch die"
       +" feuchte Umgebung ist die Woelbung fast komplett mit Moos bewachsen.");
  return BS(
      "Die Woelbung an der Wand hat die Form eines Kopfes. Sie ist komplett kahl.");
}

head()
{
  if (moss)
    return BS(
        "Der Kopf hat wirklich eine eindeutige Form und ist ueber und ueber"
       +" mit Moos bewachsen.");
  return BS(
      "Die Woelbung sieht wirklich eindeutig wie ein Kopf aus.");
}

beard()
{
  if (moss)
    return BS(
        "Das Moos auf dem Kopf sieht fast wie ein Bart aus.");
  return BS(
      "Du findest hier nirgendwo genuegend Moos, um es ordentlich zu untersuchen.");
}

