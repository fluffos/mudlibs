/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Abstellraum");

  SetProp(P_INT_LONG, BS(
          "Hier ist die Abstellkammer in der Gilde. Die meisten"
	 +" Dinge, die man hier so finden kann sind mehr oder minder"
	 +" nur noch Geruempel. Dieser Ort wird von den Gildenmitgliedern"
	 +" dazu genutzt, wertloses Zeugs zu lagern."));
  AddDetail(({"kammer", "ort", "abstellkammer"}), BS(
            "Du befindest Dich in der Abstellkammer der Gilde."));
  AddDetail("gilde", BS(
            "Die Gilde des Elfenbeinernen Tigers ist hauptsaechlich unterirdisch."));
  AddDetail("tiger", BS(
            "Ein Tiger ist auf die Wand aufgemalt."));
  AddDetail("boden", BS(
            "Auf dem Boden liegt massenhaft Geruempel herum."));
  AddDetail("decke", BS(
            "Auf der Decke ist ein Punkt."));
  AddDetail("punkt", BS(
            "Der Punkt entpuppt sich als winzige Spinne."));
  AddDetail("spinne", BS(
            "Die Spinne hat 8 Beine, wie ueblich."));
  AddDetail("beine", BS(
            "Hm, Du musst schon sehr genau schauen, um die Beine der Spinne naeher"
           +" zu betrachten. Jedenfalls siehst Du, dass dort, wo die Spinne an"
           +" der Decke sitzt, ein kleines Symbol aufgemalt ist."));
  AddDetail("symbol", BS(
            "Du kannst Dich nicht entscheiden, ob das Symbol ein ernstgemeinter"
           +" Hinweis ist oder nur ein Fliegenschiss."));
  AddDetail(({"fliegenschiss", "schiss"}), BS(
            "Es koennte sich bei dem Symbol um einen Fliegenschiss handeln."));
  AddDetail("hinweis", BS(
            "Ah. Es ist doch kein Fliegenschiss. Es ist eine Aufschrift."));
  AddDetail("aufschrift", BS(
            "Da sind Buchstaben an der Decke!"));
  AddDetail(({"satz", "buchstaben"}), BS(
            "Die Buchstaben ergeben einen Satz, den kann man lesen."));
  AddReadDetail(({"aufschrift", "satz"}), BS(
                "An der Decke, versteckt unter einer kleinen Spinne, steht"
               +" geschrieben: 'Merlin was here.'"));
  AddDetail(({"wand", "waende"}), BS(
            "Auf der Wand ist ein Tiger aufgemalt."));
  AddDetail("geruempel", BS(
            "Ausser dem, was auf dem Boden liegt, gibts hier kein Geruempel."));
  AddDetail("zeugs", BS(
            "Auf dem Boden liegt massig Zeugs herum."));
  AddDetail(({"ding", "dinge"}), BS(
            "Hier auf dem Boden findest Du wertlose Dinge und Geruempel."));
  AddDetail(({"mitglieder", "gildenmitglieder"}), BS(
            "Die Mitglieder der Gilde findest Du doch hier ueberall."));

  AddSound(DEFAULT_SOUND, BS(
           "Hier ist es absolut still. Es herrscht Stille."));
  AddSound("stille", BS(
           "............................."));

  AddSmell(DEFAULT_SMELL, BS(
           "Hier riecht es nach etwas, aber Du kannst ueberhaupt nicht"
          +" einordnen, nach was."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("n5"));
  AddItem(NPC("streawe"), REFRESH_DESTRUCT);
  AddItem(OBJ("flasche"), REFRESH_REMOVE);
}

