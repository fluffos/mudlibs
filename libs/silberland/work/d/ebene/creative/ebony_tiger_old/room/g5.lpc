/*
  Eigene Zone: Zelte
*/

inherit "std/laden";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include "../files.h"

create()
{
  ::create();

  SetProp(P_ZONE, "Suedlicher Wehrturm");
  SetProp(P_INT_SHORT, "Kleines Geschaeft");
  SetProp(P_INT_LONG, BS(
          "Mitten im suedlichen Wehrturm, wo Du Dich hier befindest,"
         +" befindet sich dieses kleine Geschaeft, wo allerhand Kostbarkeiten"
         +" gehandelt werden. Klein aber fein ist es hier drin und der"
         +" Ladenbesitzer hat alle Haende voll zu tun mit Nachbestellen und"
         +" Ueberpruefen der Ware."));
  AddDetail("boden", BS(
            "Der Boden ist mit einem wirklich schoenen Parkett ausgelegt."));
  AddDetail("parkett", BS(
            "Das Parkett ist schwimmend verlegt, so wie es sich fuer ein"
           +" gutes Parkett gehoert."));
  AddDetail(({"kassettendecke", "decke"}), BS(
            "An der Decke befindet sich wie am Boden und auch an den Waenden"
           +" Holz. Es ist eine Kassettendecke mit Kassetten aus Buchenholz,"
           +" das sehr mit der uebrigen Einrichtung harmoniert."));
  AddDetail("einrichtung", BS(
            "So wie es hier eingerichtet ist, laesst es sich gemuetlich wohnen."
           +" Ueberall Holz, noch frisch duftend, an der Wand eine Couch, wo"
           +" man auch schlafen kann, eine kleine Kochecke mit einer"
           +" Waschgelegenheit, und Regale und Kaesten, damit man auch was"
           +" unterbringt."));
  AddDetail("holz", BS(
            "Holz siehst Du hier ueberall, am Boden, an der Decke, an den Waenden..."));
  AddDetail(({"waende", "wand"}), BS(
            "An der einen Wand haengt eine Tafel, die anderen Waende sind"
           +" voll mit Regalen, damit der Ladenbesitzer auch seine Waren"
           +" stapeln kann. Weiters siehst Du unter der Tafel eine Couch,"
           +" die sehr bequem aussieht. Weiters gibt es im nordoestlichen"
           +" Ecke eine kleine Kochnische mit einer Waschgelegenheit."));
  AddDetail("buchenholz", BS(
            "Das Buchenholz harmoniert sehr gut mit der uebrigen Einrichtung."));
  AddDetail(({"kochecke", "kochnische", "ecke", "nische"}), BS(
            "Du siehst eine kleine Kochnische, wo sich der Ladenbesitzer auch"
           +" ab und zu einmal etwas warmmachen kann, wenn er Hunger hat."));
  AddDetail(({"mann", "besitzer", "ladenbesitzer"}), BS(
            "Der Besitzer des Ladens hat genug zu tun, damit alle Waren schoen"
           +" ordentlich in den Regalen verschwinden."));
  AddDetail("regale", BS(
            "Allerlei Regale siehst Du hier an den Waenden, gefuellt mit"
           +" lauter kaeuflichen Sachen. Wenn Du 'zeige' tippst, so siehst"
           +" Du eine Liste aller kaeuflichen Waren."));
  AddDetail("kaesten", BS(
            "In den Kaesten befinden sich sicherlich so manche interessante"
           +" Waren. Wenn Du wissen willst, welche, so tipp einfach 'zeige'."));
  AddDetail("liste", BS(
            "Eine Liste aller kaeuflichen Sachen erhaeltst Du mit 'zeige'."));
  AddDetail(({"sachen", "waren", "ware"}), BS(
            "Alle Waren, die Du kaufen kannst, kannst Du Dir mit 'zeige'"
           +" anzeigen lassen."));
  AddDetail(({"laden", "geschaeft"}), BS(
            "Hier im suedlichen Wehrturm befindet sich ein kleines Geschaeft"
           +" in dem allerlei Waren gehandelt werden."));
  AddSpecialDetail("hunger", "hungry");
  AddDetail(({"hand", "haende"}), BS(
            "Ui, Du hast ja auch Haende! Ob Du dem Ladenbesitzer"
           +" etwa helfen willst?"));
  AddDetail(({"kassette", "kassetten"}), BS(
            "Die Kassetten an der Decke sind alle gleichmaessig und"
           +" lassen keinen Gedanken an unregelmaessige Arbeit aufkommen."));
  AddDetail(({"gedanken", "gedanke"}), BS(
            "Denk mal streng nach!"));
  AddDetail("arbeit", BS(
            "Der Ladenbesitzer hat hier alle Haende voll zu tun um mit der"
           +" Arbeit fertigzuwerden."));
  AddDetail(({"waschgelegenheit", "gelegenheit"}), BS(
            "Die Waschgelegenheit ist mehr als primitiv, Du glaubst nicht, dass"
           +" da ueberhaupt sauberes Wasser rauskommt."));
  AddDetail("wasser", BS(
            "Probiers gar nicht aus, hier bekommst Du kein Wasser."));
  AddDetail("nachbestellen", BS(
            "Um die Regale voll zu haben muss man auch mal ab und zu ein bisschen"
           +" Ware nachbestellen."));
  AddDetail("ueberpruefen", BS(
            "Der Ladenbesitzer ist ein ordentlicher Mann und achtet auch darauf,"
           +" dass seine Ware nicht ablaeuft, darum muss er sie ab und zu"
           +" ueberpruefen."));
  AddDetail(({"kostbarkeit", "kostbarkeiten"}), BS(
            "Wenn Du Glueck hast, so bekommst Du hier auch ab und zu"
           +" mal eine Kostbarkeit."));
  AddDetail("glueck", BS(
            "Bald kann es soweit sein, dann hast auch Du Glueck!"));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Hier im suedlichen Wehrturm befindet sich auch ein kleines"
           +" Geschaeft, in dem Du Dich gerade umsiehst."));
  AddSpecialDetail("couch", "cc");
  AddDetail("tafel", BS(
            "Vermutlich kann man sie lesen, wenn man lesen kann."));
  AddReadDetail ( ({"tafel"}),
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<zeige> rue|ver   Uebersicht ueber Ruestungen/Verschiedenes\n"
    "<zeige> panzer|helm|umhang|ring|....  \n"
    "                  Uebersicht ueber die jeweiligen Ruestungsarten.\n"
    "<unt> nummer      Gibt die Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
    "<versetze> etwas  Du verkaufst einen Gegenstand, auch wenn Dir der\n"
    "                  Haendler nicht den vollen Preis dafuer bezahlen will.\n"
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");


  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_HOUSE]));
  SetStorageRoom(ROOM("lager"));
  
  AddExit("sueden", ROOM("g6"));
  AddItem(ROOM("couch"), REFRESH_REMOVE, 1);
  AddCmd(({"helfe", "hilf"}), "hlp");
}

hungry()
{
  if (TP->QueryProp(P_FOOD)>50)
    return BS("Du stellst fest, dass Du eigentlich keinen Hunger hast.");
  return BS("Eigentlich koenntest Du schon einen Bissen vertragen.");
}

hlp(str)
{
  notify_fail("Wem willst Du helfen?\n");
  if (!str)
    return 0;
  if (str!="ladenbesitzer" && str!="besitzer")
    return 0;
  write(BS(
        "Dafuer braeuchtest Du ungefaehr 183 freie Haende, und soviel"
       +" hast Du nicht!!"));
  return 1;
}

