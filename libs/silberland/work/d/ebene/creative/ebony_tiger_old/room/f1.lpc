/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Noerdlicher Wehrturm");
  SetProp(P_INT_SHORT, "Vor einer kleinen Holztuer");

  SetProp(P_INT_LONG, BS(
          "Du stehst vor einer kleinen Holztuer die nach Suedwesten zeigt."
         +" Eigentlich kann man nicht mehr von Tuer sprechen, denn es ist"
         +" nur noch der Tuerstock da. Weiter nach Osten gelangst Du zur"
         +" Trinkhalle, was sich im Suedwesten befindet, willst Du"
         +" besser gar nicht wissen."));
  AddDetail("boden", BS(
            "Der Boden ist nackt und kahl, und wenn Du genau fuehlst, auch"
           +" irr kalt."));
  AddDetail(({"wand", "waende"}), BS(
            "Wie ueberall hier im alten noerdlichen Wehrturm kann man noch"
           +" Ueberreste der alten Mauern betrachten. Sehr stabil, fuer die"
           +" Ewigkeit gebaut."));
  AddSpecialDetail("ewigkeit", "reb");
  AddDetail(({"reste", "ueberreste"}), BS(
            "Ueberall hier im noerdlichen Wehrturm siehst Du die alten"
           +" aber noch sehr gut erhaltenen Ueberreste der Mauern."));
  AddDetail("mauern", BS(
            "Rund um Dich befinden sich Mauern."));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Der noerdliche Wehrturm ist viel besser erhalten als der"
           +" suedliche, jedoch siehst Du auch hier schon ein paar"
           +" Spuren des Verfalls."));
  AddDetail(({"spuren", "verfall"}), BS(
            "Leichte Risse in der Decke weisen Dich darauf hin, dass"
           +" nichts ewig haelt."));
  AddDetail(({"decke", "risse"}), BS(
            "An der Decke siehst Du ein paar Risse, die aber noch lang"
           +" nicht bedrohlich wirken."));
  AddDetail(({"tuer", "holztuer"}), BS(
            "Die Holztuer oder vielmehr der Tuerstock weist nach Suedwesten."));
  AddDetail("tuerstock", BS(
            "Ein sehr solider Tuerstock, hinter dem ein dunkles Loch"
           +" gaehnt."));
  AddDetail("loch", BS(
            "Um das naeher untersuchen zu koennen musst Du schon nach"
           +" Suedwesten gehen."));
  AddDetail(({"halle", "trinkhalle"}), BS(
            "Die Trinkhalle befindet sich von hier aus gesehen viel weiter"
           +" oestlich."));
  AddDetail("staub", BS(
            "Von den Rissen in der Decke rieselt doch tatsaechlich ein"
           +" wenig Staub herab."));

  AddSound(DEFAULT_SOUND, BS(
           "Ganz leise hoert man den Staub von der Decke rieseln. Nein,"
          +" es ist keine Sinnestaeuschung."));
  AddSound("staub", BS(
           "Wenn Du Dich stark konzentrierst, so hoerst Du ihn rieseln,"
          +" den Staub."));

  AddSmell(DEFAULT_SMELL, BS(
           "Ein bisschen vermodert riecht es hier. Ob das wohl von der"
          +" Tuer stammt?"));
  AddSmell("tuer", BS(
           "Du riechst genauer an der Tuer, und stellst enttaeuscht fest,"
          +" dass es Eichenholz ist."));
  AddSmell(({"holz", "eichenholz"}), BS(
           "Du hast das Holz am Duft erkannt!"));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("osten", ROOM("g1"));
  AddExit("suedwesten", ROOM("e2"));
  AddItem(NPC("acharai"), REFRESH_DESTRUCT);
}


reb()
{
  return BS(
    time2string("Die aktuelle Ewigkeit dauert schon ueber %x %X lang!\n",
        time()-last_reboot_time()));
}

