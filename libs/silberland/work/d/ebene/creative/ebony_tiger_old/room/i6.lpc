/*
  Ebony Tiger Guild
*/

#include "../files.h"
#include "../sys/vt100.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int w_run, chair_lev, blade;
string cust;

mapping flist =([
    "dauerwelle": ({1,400}),
    "punkerschnitt": ({1,190}),
    "pagenkopf": ({1,210}),
    "faerben": ({1,160}),
    "fellbuersten": ({1,100}),
    "waschen": ({1,80}),
    "legen": ({1,90}),
    "foehnen": ({1,60})
    ]);

create()
{
  ::create();

  SetProp(P_ZONE, "Suedlicher Wehrturm");
  SetProp(P_INT_SHORT, "Beim Friseur");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich in einem typischen Friseurgeschaeft. An den"
         +" Waenden haengen Gemaelde, auf denen allerlei Wesen abgebildet"
         +" sind, die die neuesten und modischen Frisuren tragen. An der"
         +" Ostwand befindet sich ein grosser Spiegel. Davor befindet sich"
         +" ein Tisch und ein Stuhl mit einem Hebel. Daneben ein Waschbecken"
         +" auf Raedern."));
  AddDetail("boden", BS(
            "Auf dem Boden liegen hier und da noch ein paar abgeschnittene"
           +" Haare herum."));
  AddDetail("haare", BS(
            "Auf dem Boden liegen ein paar Haarbueschel."));
  AddDetail(({"bueschel", "haarbueschel"}), BS(
            "Hier gehoert mal so richtig zusammengekehrt!"));
  AddDetail("decke", BS(
            "An der Decke haengen eigenartige Schalen aus Metall. "
	   +" Ein Pfosten dient als Deckenstuetze."));
  AddSpecialDetail(({"pfosten", "stuetze", "deckenstuetze"}), "board"); 
  AddSpecialDetail(({"messer", "rasiermesser"}), "bla");
  AddDetail("schalen", BS(
            "Die Schalen die von der Decke herunterhaengen sind mit einer"
           +" Fluessigkeit gefuellt."));
  AddDetail(({"petroleum", "fluessigkeit"}), BS(
            "Bei der Fluessigkeit handelt es sich um Petroleum. Sie brennt"
           +" und erhellt den Raum sehr gut."));
  AddDetail("metall", BS(
            "Das Metall reflektiert den Schein der brennenden Fluessigkeit"
           +" so gut, dass die ganze Leuchtkraft nach oben strahlt."));
  AddDetail(({"schein", "lichtschein", "leuchtkraft"}), BS(
            "Der Lichtschein strahlt an die Decke, die mit einer Farbe bemalt"
           +" ist."));
  AddDetail("farbe", BS(
            "Die weisse Farbe reflektiert den Lichtschein so gut, dass der Raum"
           +" hell erleuchtet ist."));
  AddDetail(({"geschaeft", "friseurgeschaeft", "raum"}), BS(
            "Du bist hier im Friseurgeschaeft."));
  AddDetail(({"wand", "waende", "wesen"}), BS(
            "An den Waenden haengen unter anderem ein Menschenportrait, ein"
           +" Elfengemaelde, ein Hobbitbild und ein Zwergenkopf."));
  AddDetail("frisuren", BS(
            "Die Frisuren der Wesen sind ziemlich neumodisch."));
  AddDetail(({"mensch", "portrait", "menschenportrait"}), BS(
            "Der Mensch auf dem Portrait hat schulterlange dunkelbraune Haare"
           +" und hat einen scheusslichen Haarschnitt."));
  AddDetail(({"pagenschnitt", "schnitt", "haarschnitt"}), BS(
            "Irgendwie sieht es wie ein schlechter Pagenschnitt aus, was der"
           +" Friseur aus dem Menschen gemacht hat."));
  AddDetail(({"gemaelde", "elfengemaelde", "elfenmaedchen"}), BS(
            "Das Elfenmaedchen auf dem Gemaelde hat eine Glatze."));
  AddDetail("glatze", BS(
            "Das scheint heutzutage ziemlich modern zu sein."));
  AddDetail(({"hobbitbild", "hobbitmaedchen", "bild"}), BS(
            "Die Frisur des Hobbitmaedchens ist richtiggehend huebsch."));
  AddDetail(({"welle", "dauerwelle", "stufen", "frisur"}), BS(
            "Das blonde Maedchen hat eine Dauerwelle mit 2 Stufen."));
  AddDetail("maedchen", BS(
            "Meinst Du das Hobbit- oder das Elfenmaedchen?"));
  AddDetail(({"kopf", "zwergenkopf"}), BS(
            "Erschreckt stellst Du fest, dass es sich dabei um kein Bild"
           +" handelt. Es ist wirklich ein echter abgehackter Zwergenkopf."
           +" Barbarisch!!!"));
  AddDetail(({"barbar", "tat", "barbaren"}), BS(
            "Die Barbaren die fuer diese Tat in Frage kommen sind schon"
           +" laengst ueber alle Berge."));
  AddDetail("berge", BS(
            "Berge gibts auch im SilberLand."));
  AddDetail("silberland", BS(
            "Du befindest Dich ja gerade im SilberLand."));
  AddDetail("ostwand", BS(
            "An der Ostwand haengt ein riesiger Spiegel."));
  AddDetail(({"in spiegel", "spiegel"}), BS(
            "Du siehst etwas gar Graessliches, gelangst aber zu dem Ergebnis,"
           +" dass es sich dabei um Dich selbst handeln muss."));
  AddDetail(({"ergebnis", "graessliches"}), BS(
            "Bah. Du erschauderst vor Dir selber."));
  AddDetail(({"becken", "waschbecken"}), BS(
            "Das Becken ist nicht ungewoehnlich fuer jemand, der"
	   +" sich schon mal die Haare waschen hat lassen. Man"
	   +" kann recht praktisch den Wasserhahn benuetzen."));
  AddDetail(({"wasserhahn", "hahn"}), BS(
            "Den Wasserhahn kann man aufdrehen, damit das Wasser"
	   +" aus der Wasserleitung sprudelt."));
  AddDetail("tisch", BS(
            "Vor dem Spiegel (und auch im Spiegel) siehst Du einen"
	   +" Tisch."));
  AddSpecialDetail(({"platz", "stuhl"}), "chair");
  AddDetail("arbeit", BS(
            "So ein Friseur hat besonders mit Hobbits viel Arbeit!"));
  AddDetail("kunde", BS(
            "Bist Du denn der naechste Kunde?"));
  AddDetail("raeder", BS(
            "Die Raeder am Waschbecken dienen dazu, das Waschbecken"
	   +" hin und her zu transportieren."));
  AddDetail("hebel", BS(
            "Man kann den Hebel auch druecken."));
  AddSpecialDetail(({"wasser", "wasserleitung", "leitung"}), "water");

  AddSound(DEFAULT_SOUND, BS(
           "Bedaechtig lauscht Du und gelangst zu dem Ergebnis, dass hier"
          +" das Schnippen der Schere und Kratzen von Rasierklingen"
          +" im Raum nachhallt."));
  AddSound(({"schnippen", "schere"}), BS(
           "*schnipp* *schnipp*"));
  AddSound(({"kratzen", "klingen", "rasierklingen"}), BS(
           "*schab* *schrapp* *kratz*"));

  AddSmell(DEFAULT_SMELL, BS(
           "Hier herinnen riecht es eindeutig nach Rasierwasser,"
	  +" Shampoo und Desinfiziermittel."));
  AddSmell(({"wasser", "rasierwasser", "duft"}), BS(
           "Das Rasierwasser hat einen betoerenden Duft."));
  AddSmell("shampoo", BS(
           "Das Shampoo duftet nach Lavendel."));
  AddSmell("lavendel", BS(
           "Koestlich dieser Lavendelgeruch."));
  AddSmell(({"mittel", "desinfiziermittel"}), BS(
           "Igitt, riech nur nicht zu lange daran."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("westen", ROOM("h6"));

  AddCmd(({"drehe", "dreh"}), "turn");
  AddCmd(({"drueck", "druecke"}), "push");
  AddCmd(({"hol", "hole"}), "fetch");
  AddCmd(({"kehr", "kehre"}), "sweep");
  AddCmd(({"sitz", "sitze", "setz", "setze"}), "sit");
  AddCmd(({"wuenschen", "wuensche", "wuensch"}), "wish");
  AddCmd(({"steh", "stehe"}), "sta");
  AddCmd(({"frisurliste"}), "list_f");
  
  AddItem(NPC("friseur"), REFRESH_DESTRUCT);
  w_run=0;
  chair_lev=0;
  blade=1;
  cust="";
}

water()
{
  if (w_run)
    return BS(
	"Das Wasser sprudelt durch die Wasserleitung ins Waschbecken."
       +" Es faellt Dir sofort auf wie irrsinnig klar das Wasser wirkt,"
       +" es muss direkt aus dem Boden heraufgepumpt werden.");
  else
    return BS(
	"Der Wasserhahn ist nicht aufgedreht, also sprudelt auch kein"
       +" Wasser aus der Leitung.");
}

turn(str)
{
  string what, how;
  object r;

  notify_fail("Was willst Du aufdrehen?\n");
  if (!str)
   return 0;
  if (sscanf(str, "%s %s", what, how)!=2)
    return 0;
  if (what!="hahn" && what!="wasserhahn" && what!="wasser")
    return 0;
  if (how!="ab" && how!="auf" && how!="zu")
    return 0;
  switch (how) {
    case "zu":
    case "ab": if (w_run) {
		 write("Du drehst den Wasserhahn ab.\n");
		 w_run=0;
		 say(TPN+" dreht den Wasserhahn ab.\n");
		 break;
	       }
	       else {
		 write("Das Wasser laeuft doch gar nicht.\n");
		 break;
	       }
   case "auf": if (!w_run) {
		 write("Du drehst den Wasserhahn auf.\n");
     if ((r=find_object(ROOM("l6"))) && !present("sklave", r)) {
       write("Die Wasserleitung roechelt nur klaeglich.\n");
       return 1;
     }
		 w_run=1;
		 say(TPN+" dreht den Wasserhahn auf.\n");
     if (r)
       tell_room(r, "Tarion dreht die Kurbel kraeftiger, da jemand Wasser benoetigt.\n");
		 while (!remove_call_out("abdrehen")) ;
		 call_out("abdrehen", 8);
		 break;
	       }
	       else {
		 write("Das Wasser laeuft doch schon!\n");
		 break;
	       }
  }
  return 1;
}

reset()
{
  ::reset();
  if (w_run)
    tell_room(TO, "Der Wasserstrahl versiegt.\n");
  w_run=0;
  if (chair_lev)
    tell_room(TO, "Der Stuhl sinkt in seine Ausgangsposition zurueck.\n");
  chair_lev=0;
  if (cust!="" && present(cust))
    tell_object(find_player(cust),
       "Du hast zu lange auf das Haareschneiden gewartet und stehst wieder auf.\n");
  cust="";
}

int QueryWater() { return w_run; }

push(str)
{
  notify_fail("Worauf willst Du druecken?\n");
  if (!str)
    return 0;
  if (str!="auf hebel" && str!="hebel")
    return 0;
  write(BS(
      "Du drueckst auf den Hebel. Der Stuhl hebt sich ein wenig."));
  say(TPN+" drueck mit dem Fuss auf einen Hebel.\n");
  chair_lev++;
  if (chair_lev>4) {
    if (present("friseur")) {
      tell_room(TO, "Der Friseur sagt: Lass das, spiel hier nicht herum!\n");
      write("Der Friseur gibt Dir eine laut klatschende Ohrfeige.\n");
      say("Der Friseur gibt "+TPN+" eine laut klatschende Ohrfeige.\n");
      TP->reduce_hit_point(15);
    }
    chair_lev=0;
    tell_room(TO, "Der Stuhl sinkt in seine Ausgangsposition zurueck.\n");
  }
  return 1;
}

chair()
{
  string str;
  str=BS(
	"Der Stuhl dient dazu um dem Kunden einen bequemen"
       +" Platz anbieten zu koennen und dem Friseur die Arbeit"
       +" zu erleichtern. Man kann ihn mit einem Hebel in der"
       +" Hoehe verstellen.");
  str+="Der Stuhl ist derzeit ";
  switch (chair_lev) {
    case 0: str+="ganz unten"; break;
    case 1: str+="etwas vom Boden entfernt"; break;
    case 2: str+="in mittlerer Hoehe"; break;
    case 3: str+="fast auf der hoechsten Stufe"; break;
    case 4: str+="ganz weit oben"; break;
    default: str+="kaputt";
  }
  return str+".\n";
}

fetch(str)
{
  object ob;

  notify_fail("Was willst Du holen?\n");
  if (!str || (str!="rasiermesser" && str!="messer"))
    return 0;
  if (!blade) {
    write("Hm, hier gibts gar kein Rasiermesser. Komisch.\n");
    return 1;
  }
  if (present("friseur")) {
    write("Der Friseur laesst Dich das Rasiermesser bestimmt nicht klauen.\n");
    return 1;
  }
  write(BS(
      "Ok, Du versuchst also Dein Glueck. Du steigst auf den Stuhl"
     +" und... und... und..."));
  if (chair_lev!=4)
    write("Mist. Der Stuhl ist zu niedrig.\n");
  else {
    write(BS(
	"Hurra. Du erreichst das Rasiermesser muehelos und ziehst es"
       +" aus dem Pfosten heraus."));
    blade=0;
    ob=clone_object(WEAPON("rasiermesser"));
    ob->move(TP, M_NOCHECK);
  }
  say(BS(
      TPN+" steigt auf einen Stuhl, kommt dann aber doch gleich"
     +" wieder runter."));
  return 1;
}

board()
{
  if (blade)
    return "Oben in dem Pfosten steckt ein scharfes Rasiermesser.\n";
  return "Ein gewoehnlicher Pfosten als Stuetze fuer die Decke.\n";
}

bla()
{
  if (blade)
    return BS(
            "Das Rasiermesser ist zu weit oben. Ob Du es Dir aber doch"
	   +" vielleicht holen kannst?");
  return "Du siehst hier kein Rasiermesser.\n";
}

abdrehen()
{
  if (w_run) {
    if (present("friseur")) {
      tell_room(TO, BS(
          "Der Friseur schimpft: Wer spielt da wieder am Waschbecken herum!"));
      tell_room(TO, "Der Friseur dreht den Wasserhahn ab.\n");
    }
    tell_room(TO, "Der Wasserstrahl versiegt wieder.\n");
    w_run=0;
  }
}

sweep(str)
{
  notify_fail("Was willst Du kehren?\n");
  if (!str)
    return 0;
  if (str!="boden" && str!="boden zusammen" && str!="zusammen")
    return 0;
  write("Du kehrst ein wenig mit den Fuessen die Haarbueschel zusammen.\n");
  say(TPN+" kehrt ein wenig mit den Fuessen die Haarbueschel zusammen.\n");
  return 1;
}

sit(str)
{
  object b;

  notify_fail("Worauf willst Du Dich setzen?\n");
  if (!str)
    return 0;
  if (str!="stuhl" && str!="auf stuhl")
    return 0;
  if (cust!="") {
    if (TP->query_real_name()==cust)
      write("Du sitzt doch schon auf dem Stuhl!\n");
    else
      write("Auf dem Stuhl sitzt schon "+CAP(cust)+", der moechte ja auch bedient werden!\n");
    return 1;
  }
  if ((b=present("\nfriseur"))) {
    write("Du setzt Dich auf den Stuhl und kannst Dir nun eine Frisur <wuenschen>.\n");
    say(TPN+" setzt sich auf den Stuhl und beginnt in einem Katalog zu blaettern.\n");
    cust=TP->query_real_name();
  }
  else {
    write("Du setzt Dich kurz auf den Stuhl, ueberlegst es Dir jedoch anders und stehst wieder auf.\n");
    say(TPN+" setzt sich auf den Stuhl, denkt kurz nach und steht wieder auf.\n");
  }
  return 1;
}

sta(str)
{
  notify_fail("Was willst Du tun? Aufstehen?!\n");
  if (!str)
    return 0;
  if (str!="" && str!="auf")
    return 0;
  if (cust=="") {
    write("Du sitzt doch gar nicht auf dem Stuhl!\n");
    return 1;
  }
  if (TP->query_real_name()!=cust) {
    write("Du sitzt doch gar nicht auf dem Stuhl!\n");
    return 1;
  }
  write("Du stehst erleichtert vom Friseurstuhl auf.\n");
  say(TPN+" steht auf.\n");
  cust="";
  return 1;
}

exit()
{
  ::exit();
  if (cust!="" && TP->query_real_name()==cust) {
    write("Du stehst schnell vom Friseurstuhl auf.\n");
    say(TPN+" steht schnell vom Friseurstuhl auf.\n");
  }
}

list_f()
{
  string out;
  int i, len;
  string *frisur;
  mixed *f_info;

  out=" Du kannst Dir derzeit folgende Frisuren \"wuenschen\":\n\n";
  len=sizeof(flist);
  frisur=m_indices(flist);
  f_info=m_values(flist);
  for (i=0; i<len; i++)
    out+=sprintf("    %s %s%-=30s %s%4d,--%s\n",
        f_info[i][0]?"*":" ", VT_TA_B+VT_GREEN, "<"+frisur[i]+">",
        VT_BLUE, f_info[i][1], VT_TA_AO);
  out+="\n Die mit * markierten Frisuren sind zur Zeit moeglich.\n"
      +" Mit \"wuensche <frisur>\" gehts los.\n\n";
  write(out);
  return 1;
}

wish(str)
{
  string *frisur;
  mixed *f_info;

  notify_fail("Mit \"frisurliste\" kannst Du Dir das aktuelle Angebot ansehen.\n");
  if (!str)
    return 0;
  notify_fail("Du kannst Dich doch nicht selber bedienen!\n");
  if (!present("\nfriseur"))
    return 0;
  frisur=m_indices(flist);
  f_info=m_values(flist);
  if (member(frisur, str)==-1) {
    write("Birn sagt: So eine Frisur kann ich Dir nicht bieten. Such Dir was andres.\n");
    return 1;
  }
  if (cust!=TP->query_real_name()) {
    if (cust!="")
      write("Birn sagt: Entschuldige, "+TPN+", aber ich kuemmere mich gerade um "+CAP(cust)+"!\n");
    else
      write("Birn sagt: Um von mir frisiert zu werden musst Du Dich schon auf dem Stuhl setzen!\n");
    return 1;
  }
  return 1;
}

