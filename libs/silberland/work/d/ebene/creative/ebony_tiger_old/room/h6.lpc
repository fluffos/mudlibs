/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Suedlicher Wehrturm");
  SetProp(P_INT_SHORT, "Alter Wehrturm");
  SetProp(P_INT_LONG, BS(
          "Ueberreste einer alten Festung sind das einzige, was Du hier"
         +" finden kannst. Altes Gemaeuer, voll mit Spinnweben und teils"
         +" auch ueberwachsen mit Moos und Wurzeln von irgendwelchen"
         +" Pflanzen, die im Lauf der Zeit ihren Weg bis hier unten bahnen"
         +" konnten. Die Umgebung wirkt duester und unheimlich, und Du"
         +" wuenscht Dich lieber schnell von hier weg."));
  AddDetail("boden", BS(
            "Der Boden ist an manchen Stellen ausgetreten, an den Waenden"
           +" hingegen ist der Boden auch voller Spinnweben."));
  AddDetail("stellen", BS(
            "Du findest wenig Stellen hier, an denen keine Spinnweben haengen."
           +" Der Verfall der letzten Jahre hat hier wirklich gute Arbeit"
           +" geleistet."));
  AddDetail("arbeit", BS(
            "Nicht nur der Verfall hat hier gute Arbeit geleistet,"
           +" sondern auch die Baumeister, die dies geschaffen haben."));
  AddDetail(({"meister", "baumeister"}), BS(
            "Dass dieses Gemaeuer schon vor langer Zeit entstanden ist,"
           +" bedurfte wahrhaftig grosser Baumeister."));
  AddDetail(({"wand", "waende"}), BS(
            "An den Waenden haengen Spinnweben und manche Steinbloecke,"
           +" die hier die Ueberreste der alten Festung noch stuetzen,"
           +" sind voller Erde und Wurzeln."));
  AddDetail(({"weben", "spinnweben"}), BS(
            "Auch wenn es grundsaetzlich furchtbar spannend sein kann,"
           +" den Spinnen beim Bau ihrer Spinnennetze zuzusehen oder"
           +" auch ab und zu eine Spinne beim Beutefang zu beobachten,"
           +" ist Dir die Umgebung so unheimlich, dass Du lieber darauf"
           +" verzichtest."));
  AddDetail(({"spinne", "spinnen"}), BS(
            "Zahlreiche Spinnen und Spinnennetze findest Du hier an den"
           +" Waenden und auch an der Decke."));
  AddDetail(({"netze", "spinnennetze"}), BS(
            "Die Spinnennetze sind so zart, dass sie nur ganz schwach"
           +" im Licht leuchten."));
  AddDetail("licht", BS(
            "Fuer das Licht sorgst doch Du!"));
  AddDetail("opfer", BS(
            "Zum Opfer fiel nicht nur dieser Gang hier unten, sondern auch"
           +" ein Insekt einer Spinne."));
  AddDetail("insekt", BS(
            "Du kannst nicht mehr feststellen, um was fuer ein Insekt es"
           +" sich handelt, nachdem die Spinne es schon komplett eingespinnt"
           +" hat und wahrscheinlich auch schon gaenzlich ausgesaugt."
           +" Baeh, Dir graust bei dem Anblick und Du wuenscht Dir nicht,"
           +" jemals in die Faenge einer Spinne zu geraten."));
  AddDetail("anblick", BS(
            "Du kannst gar nicht hinschauen... Igitt..."));
  AddDetail("faenge", BS(
            "Zum Glueck bist Du viel zu gross um von einer dieser Spinnen"
           +" angegriffen zu werden."));
  AddDetail("glueck", BS(
            "Du kannst von Glueck reden, dass Dich keine Spinne hier verspeisen"
           +" moechte."));
  AddDetail(({"fang", "beute", "beutefang"}), BS(
            "Wenn Du genau hinsiehst, kannst Du so manche Spinne erkennen,"
           +" die auf ihre Beute in geheimen Verstecken lauert."));
  AddDetail(({"verstecke", "versteck"}), BS(
            "Nein hier gibts definitiv nichts verstecktes, nur Spinnen, die"
           +" auf ihre Beute lauern."));
  AddDetail("festung", BS(
            "Frueher scheint hier eine Festung gestanden zu haben, den"
           +" Steinbloecken nach zu urteilen sogar eine ziemlich maechtige."));
  AddDetail(({"bloecke", "steinbloecke"}), BS(
            "Maechtige Steinbloecke zieren die Waende, teils ueberwuchert"
           +" mit Moos, Erde und Wurzeln. Sie gehoerten frueher wahrscheinlich"
           +" zu einer Festung."));
  AddDetail("gemaeuer", BS(
            "Alt ist das Gemaeuer hier schon, aber deswegen noch lange nicht"
           +" kaputt."));
  AddDetail("verfall", BS(
            "Dem Lauf der Zeit faellt so manches zum Opfer, das nicht"
           +" mehr benuetzt oder bewohnt wird."));
  AddDetail(({"reste", "ueberreste"}), BS(
            "Die Ueberreste der alten Festung stuetzen diesen Gang hier,"
           +" so dass er nicht einstuerzt."));
  AddDetail("moos", BS(
            "Moos ist bekannterweise so anspruchslos und pflegeleicht, dass"
           +" es an den irrsten Stellen waechst. So auch hier an den Waenden."));
  AddDetail("erde", BS(
            "Abgesehen von der Erde am Boden gibt es auch Erde an den Waenden,"
           +" zwischen den Steinbloecken, zusammengehalten von vielen Wurzeln."));
  AddDetail("wurzeln", BS(
            "Die Wurzeln halten die Erde zusammen, sie scheinen von Pflanzen"
           +" die an der Erdoberflaeche wachsen, zu stammen."));
  AddDetail(({"pflanzen", "oberflaeche", "erdoberflaeche"}), BS(
            "Direkt ueber Dir wachsen ein paar Pflanzen, deren Wurzeln bis"
           +" hier unten herabreichen."));
  AddDetail("weg", BS(
            "Du siehst zuerst mal den Weg, auf dem Du hergekommen bist, und"
           +" den Weg, den sich die Wurzeln durch den Boden gebahnt haben,"
           +" damit sie nun hier an der Decke sichtbar sind."));
  AddDetail("decke", BS(
            "An der Decke, die kaum zu erkennen ist, sieht man ein paar"
           +" Wurzeln herabhaengen."));
  AddDetail(({"lauf", "zeit"}), BS(
            "Der Lauf der Zeit veraendert oft schon mal vieles... jedoch aendert"
           +" er selber sich nie, denn die Zeit laeuft unaufhaltsam weiter."));
  AddDetail("gang", BS(
            "Dieser Gang war frueher mal der unterirdische Gang eines"
           +" Wehrturms."));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Ja, richtig, dies hier ist der unterirdische Gang eines alten"
           +" Wehrturms. Zu welcher Festung der wohl gehoert haben mag..."));
  AddDetail("treiben", BS(
            "Frueher, als die Festung noch stand, gab es bestimmt lustiges"
           +" und buntes Treiben hier unten."));
  AddDetail("bau", BS(
            "Spinnen beim Bau ihrer Spinnennetze beobachten zu koennen"
           +" ist immer wieder faszinierend. Doch hier unten ist es Dir"
           +" einfach ein bisschen zu unheimlich."));
  AddDetail("umgebung", BS(
            "Dir wird schon unheimlich wenn Du Dich nur ein wenig umsiehst."
           +" Alles wirkt duester und verfallen, und je laenger Du Dich"
           +" hier aufhaeltst, umso mulmiger wird Dir."));
  AddDetail("jahre", BS(
            "Du stellst Dir den Wehrturm in seinen fruehen Jahren vor und"
           +" stellst Dir das bunte Treiben vor... schoene Zeit war das"
           +" damals, bestimmt!"));

  AddSound(DEFAULT_SOUND, BS(
           "Trotzdem hier eigentlich sehr viel Lebewesen sind, gibt es"
          +" keine besonderen Geraeusche. Spinnen sind nun mal eben eher"
          +" sehr leise Tiere."));
  AddSound(({"spinne", "spinnen"}), BS(
           "Die Spinnen geben keinen Laut von sich. Wie klug, sonst waeren"
          +" alle Insekten vorgewarnt."));

  AddSmell(DEFAULT_SMELL, BS(
           "Dir kommt vor als ob es hier schon ein wenig nach Moder riecht."
          +" Nunja, das ist eigentlich auch kein Wunder... Schliesslich"
          +" ist hier nicht unbedingt der gastlichste Ort."));
  AddSmell(({"pflanzen", "erde", "moder"}), BS(
           "Es sind die Pflanzen und die Erde, die den Geruch von Moder"
          +" hier unten verbreiten."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("westen", ROOM("g6"));
  AddExit("nordosten", ROOM("i5"));
  AddExit("osten", ROOM("i6"));
  AddItem(NPC("argax"), REFRESH_DESTRUCT);
}

