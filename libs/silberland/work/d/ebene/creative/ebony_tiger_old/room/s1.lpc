/*
  Weg zur Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Pfad");
  SetProp(P_INT_SHORT, "Verborgener Pfad");

  SetProp(P_INT_LONG, BS(
          "Du fuehlst Dich ziemlich unsicher hier. Schliesslich scheint es"
	 +" so, als ob Du auf einem Weg wandelst, der eigentlich nicht fuer"
	 +" Dich bestimmt ist. Die Atmosphaere, ja, einfach alles deutet"
	 +" darauf hin, dass Du eher etwas Illegales tust, wenn Du Dich"
	 +" hier aufhaeltst."));
  AddDetail("weg", BS(
            "Hier auf dem Weg zu wandeln, auf dem nicht wirklich oft"
	   +" jemand vorbeizukommen scheint, ist Dir unheimlich."));
  AddDetail("boden", BS(
            "Der Boden ist ueberwuchert von Pflanzen."));
  AddDetail("pflanzen", BS(
            "Eigentlich bist Du gar nicht daran interessiert, was fuer"
	   +" Pflanzen hier wachsen. Deine Aufmerksamkeit richtet sich"
	   +" viel mehr auf die Umgebung, denn es koennte Dich ja jemand"
	   +" bemerken."));
  AddDetail("aufmerksamkeit", BS(
            "Sei bloss wachsam, denn denk nur dran, was passieren koennte,"
	   +" wenn Dich jemand beobachtet!"));
  AddDetail("umgebung", BS(
            "Fast alles an der Umgebung ist unerheblich, wenn Du Dir"
	   +" ins Gedaechtnis rufst, wie unwohl Du Dich hier fuehlst."));
  AddDetail("gedaechtnis", BS(
            "Sag bloss, Du warst schon einmal hier? Kannst Du Dich daran"
	   +" noch erinnern?"));
  AddDetail("atmosphaere", BS(
            "Alles ist hier unheimlich, selbst die Pflanzen machen den"
	   +" Eindruck, als ob sie Dich misstrauisch beobachten wuerden."));
  AddDetail("eindruck", BS(
            "Sei ehrlich, hast Du den Eindruck, dass diese Gegend hier"
	   +" vertrauenserweckend wirkt?"));
  AddDetail("gegend", BS(
            "Richtig unheimlich ist diese Gegend hier..."));
  AddDetail("himmel", BS(
            "Einmal etwas abwechslungsreiches zu untersuchen schadet sicher"
	   +" nicht, jedoch findest Du nicht einmal am Himmel etwas"
	   +" Besonderes. Im Gegenteil, auch der Himmel scheint Dich zu"
	   +" beobachten."));
  AddDetail("gegenteil", BS(
            "Das Gegenteil wovon? Voellig unerheblich, denn Du fuehlst Dich"
	   +" unwohl."));
  AddDetail(({"abwechslungsreiches", "abwechslung"}), BS(
            "Du findest Du hast Abwechslung noetig? Wenn Du hier auf diesem"
	   +" Weg weiterfindest, wirst Du genuegend davon bekommen."));
  AddDetail("sonne", BS(
            "Tatsaechlich, da ist sie, die Sonne. Du haettest fast auf"
	   +" sie vergessen, den allgegenwaertigen Begleiter auf Deinen"
	   +" Reisen."));
  AddDetail("begleiter", BS(
            "Du wuenschtest, Du haettest mehr als nur die Sonne als Begleiter"
	   +" bei Dir. Hier ist es einfach richtiggehend unangenehm."));
  AddDetail(({"reise", "reisen"}), BS(
            "Auf Reisen kannst Du jederzeit gehen, und vielleicht waere es"
	   +" auch besser als hier weiterzuforschen."));
  AddDetail("dornen", BS(
            "Auch dieses Gittertor ist von ganz gemeinen Dornen besetzt."));
  AddSound(DEFAULT_SOUND, BS(
           "Dir ist so unwohl zumute, dass Du nur Dein eigenes Herz"
	  +" klopfen hoerst."));
  AddSound("herz", BS(
           "Gottseidank, es schlaegt noch!"));

  AddSmell(DEFAULT_SMELL, BS(
           "Deine Gedanken drehen sich so schnell, dass Deinen anderen"
	  +" Organen keinerlei Zeit bleibt, etwas anderes zu tun. Du"
	  +" riechst daher gar nichts."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_PLAIN]));
  
  AddExit("suedosten", "/d/ebene/creative/feldlager/room/b2_a7");

  NewDoor("norden", ROOM("s2"),
          ({"tor", "gittertor"}),
	  ({ D_NAME, "Gittertor", D_GENDER, NEUTER,
	     D_SHORT, "Ein hohes Gittertor (%s).",
	     D_LONG, BS(
	       "Ein hohes, mit fiesen Dornen besetztes schmiedeeisernes"
	      +" Gittertor."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY,
	     D_FUNC, "loc_d"
	  }));
  AddCmd(({"kletter", "klettere"}), "kl");
}

kl(str)
{
  notify_fail("Worueber willst Du klettern?\n");
  if (!str && str!="ueber tor" && str!="ueber gittertor")
    return 0;
  write(BS("Keine Chance, die Dornen sind zu spitz. Keine Ruestung der Welt"
       +" koennte Dich vor ihnen schuetzen."));
  return 1;
}

unl_d()
{
  int r;

  r="/obj/doormaster"->GetDoorStatus(ROOM("s2"));
  "/obj/doormaster"->SetDoorStatus(ROOM("s2"), D_STATUS_OPEN);
  return r;
}

loc_d()
{
  int r;

  r="/obj/doormaster"->GetDoorStatus(ROOM("s2"));
  "/obj/doormaster"->SetDoorStatus(ROOM("s2"), D_STATUS_LOCKED);
  return r;
}

