/*
  Weg zur Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Pfad");
  SetProp(P_INT_SHORT, "Verborgener Pfad");

  SetProp(P_INT_LONG, BS(
          "Selten mutig bist Du wohl, dass Du soweit von suedlicher Richtung"
	 +" hierher vorgedrungen bist. Oder kommst Du gar schon von Norden her,"
	 +" nur auf der Flucht vor dem Boesen, welches dort auf Dich zu lauern"
	 +" scheint?"));
  AddDetail("himmel", BS(
            "Der Himmel hat wie ueblich nicht sehr viel zu bieten."));
  AddDetail("sonne", BS(
            "Die Sonne ist das einzig interessante Objekt, das es am Himmel zu"
	   +" beoabachten gilt."));
  AddDetail("objekt", BS(
            "So ein richtiges Objekt ist die Sonne ja gar nicht."));
  AddDetail("richtung", BS(
            "Offensichtlich gibt es nur zwei sinnvolle Richtungen... eine fuehrt"
	   +" durch das Tor, die andere geht in die Sicherheit, nach Sueden."));
  AddDetail("norden", BS(
            "Weiter im Norden warten boese Ueberraschungen auf Dich."));
  AddDetail(({"ueberraschung", "ueberraschungen"}), BS(
            "Lass Dich ueberraschen!"));
  AddDetail("sicherheit", BS(
            "Nunja, recht wohl ist Dir nicht zumute. In Midas waerst Du bestimmt"
	   +" viel sicherer."));
  AddDetail("midas", BS(
            "Du sehnst Dich zurueck nach Midas."));
  AddDetail("boden", BS(
            "Auf dem Boden sieht man nichts anderes als den Pfad, der von Sueden"
	   +" nach Norden fuehrt."));
  AddDetail(({"weg", "pfad"}), BS(
            "Der Weg fuehrt von Sueden vom Feldlager weg nach Norden ins"
	   +" Ungewisse."));
  AddDetail("ungewisse", BS(
            "Um dorthin zu gelangen, musst Du schon einen Schritt weiter nach"
	   +" Norden wagen."));
  AddDetail("schritt", BS(
            "Du kannst ihn wagen, wenn Dir nach weiteren Abenteuern geluestet."));
  AddDetail("abenteuer", BS(
            "Wenn Du weiter nach Norden gehst, so wirst Du bestimmt noch"
	   +" viele Abenteuer erleben."));
  AddDetail("sueden", BS(
            "Weiter im Sueden liegt das Feldlager."));
  AddDetail(({"lager", "feldlager"}), BS(
            "Ich bin sicher, Du wuerdest Dich dort sicherer fuehlen als hier."));
  AddDetail("dornen", BS(
            "Die Dornen auf dem Gittertor machen es Dir unmoeglich, auch"
	   +" nur ueber eine Moeglichkeit nachzudenken, wie man darueber"
	   +" kommen koennte."));
  AddDetail("moeglichkeit", BS(
            "Wenn Dir eine Moeglichkeit einfiele, bin ich mir sicher, wuerdest"
	   +" Du sie in die Tat umsetzen."));
  AddDetail("tat", BS(
            "So tu doch etwas!!!"));
  AddDetail("flucht", BS(
            "Auf der Flucht scheinst Du noch nicht zu sein, sonst wuerdest"
	   +" Du die Flucht nicht untersuchen."));
  AddDetail(({"boese", "boeses"}), BS(
            "Huete Dich vor dem Boesen!"));

  AddSound(DEFAULT_SOUND, BS(
           "Ein Baum nicht allzuweit weg scheint ein wenig zu knarren."));
  AddDetail("baum", BS(
            "Scheinbar hast Du Dich doch getaeuscht."));

  AddSmell(DEFAULT_SMELL, BS(
           "Hier riecht es, so seltsam es auch klingen mag, nach Furcht."));
  AddSmell(({"angst", "furcht"}), BS(
           "Es ist Deine eigene Angst, die Du foermlich zu riechen vermagst."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_PLAIN]));
  
  AddExit("sueden", ROOM("s1"));

  NewDoor("norden", ROOM("s3"),
          ({"tor", "gittertor"}),
	  ({ D_NAME, "Gittertor", D_GENDER, NEUTER,
	     D_SHORT, "Ein hohes Gittertor (%s).",
	     D_LONG, BS(
	       "Ein hohes, mit fiesen Dornen besetztes schmiedeeisernes"
	      +" Gittertor."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY,
	     D_FUNC, "loc_d"
	  }));
  AddCmd(({"kletter", "klettere"}), "kl");
}

kl(str)
{
  notify_fail("Worueber willst Du klettern?\n");
  if (!str && str!="ueber tor" && str!="ueber gittertor")
    return 0;
  write(BS("Keine Chance, die Dornen sind zu spitz. Keine Ruestung der Welt"
       +" koennte Dich vor ihnen schuetzen."));
  return 1;
}

unl_d()
{
  int r;

  r="/obj/doormaster"->GetDoorStatus(ROOM("s3"));
  "/obj/doormaster"->SetDoorStatus(ROOM("s3"), D_STATUS_OPEN);
  return r;
}

loc_d()
{
  int r;

  r="/obj/doormaster"->GetDoorStatus(ROOM("s3"));
  "/obj/doormaster"->SetDoorStatus(ROOM("s3"), D_STATUS_LOCKED);
  return r;
}

