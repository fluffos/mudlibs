/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int hung, sheet;

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "In der Bibliothek");

  SetProp(P_INT_LONG, BS(
          "Hier scheint der zweite Raum der grossen Bibliothek zu sein."
         +" Noch mehr Buecher als im ersten Raum befinden sich hier,"
         +" alle fein saeuberlich sortiert. Bestimmt lagern hier auch"
         +" einige Kostbarkeiten. Mitten im Raum steht ein Tisch, an"
         +" den Waenden wie auch im anderen Raum Regale."));
  AddDetail("boden", BS(
            "Auf dem Boden sieht man noch ein paar zerknuellte Zettel"
           +" liegen."));
  AddDetail("zettel", BS(
            "Die Zettel scheinen alle vom Bibliothekar zu stammen, der"
           +" hier fleissig Buecher kopiert."));
  AddDetail("bibliothekar", BS(
            "Der Bibliothekar ist immer auf der Suche nach neuen Buechern."));
  AddDetail("suche", BS(
            "Auch Du kannst nach Buechern suchen."));
  AddDetail("raum", BS(
            "Dies ist der zweite Raum der durchaus grossen Bibliothek."));
  AddDetail("bibliothek", BS(
            "Hier in der Bibliothek befinden sich die wichtigsten Buecher,"
           +" alle gesammelt vom weisen Bibliothekar."));
  AddDetail(({"buch", "buecher"}), BS(
            "Du siehst hier in der Bibliothek sowieso nichts anderes als"
           +" Buecher."));
  AddDetail("kostbarkeiten", BS(
            "Die wertvolleren Buecher stehen bestimmt im Safe."));
  AddSpecialDetail("safe", "saf");
  AddSpecialDetail(({"radierung", "bild"}), "pppic");
  AddDetail("zeit", BS(
            "Das Bild stammt schon aus frueher Zeit."));
  AddDetail("tiger", BS(
            "Auf dem Bild an der Wand erkennst Du einen Tiger."));
  AddSpecialDetail(({"waende", "wand"}), "wall");
  AddDetail("decke", BS(
            "Von der Decke herunter haengen ein paar Lampen die den Raum hier"
           +" perfekt erhellen."));
  AddDetail(({"lampen", "lampe"}), BS(
            "Die Lampen an der Decke erhellen den Raum sehr gut, so dass hier"
           +" gut Arbeit verrichtet werden kann."));
  AddDetail("arbeit", BS(
            "Der Bibliothekar, ein Moench, muss hier permanent Buecher kopieren,"
           +" um das Wissen fortzupflanzen."));
  AddDetail("wissen", BS(
            "Bei so viel Buechern muss doch das Wissen richtiggehend gesammelt sein."));
  AddDetail("moench", BS(
            "Der Bibliothekar ist gleichzeitig ein sehr enthaltsamer Moench."));
  AddDetail(({"regale", "regal"}), BS(
            "Alle Regale sind vollgestopft mit allerlei Buechern."));
  AddDetail("tisch", BS(
            "Direkt mitten im Raum steht ein Tisch, an dem der Bibliothekar den"
           +" Platz findet, den er benoetigt, um Kopien der Buecher anzufertigen."));
  AddDetail("platz", BS(
            "Wenn Du es Dir recht ueberlegst, so herrscht gar nicht so viel Platz"
           +" auf dem Tisch, da er komplett angeraeumt ist."));
  AddDetail("kopien", BS(
            "Die Buecher werden kopiert, damit das Wissen weitergegeben werden kann."));
  AddDetail(({"fass", "tintenfass"}), BS(
            "Auf dem Tisch befindet sich ein Tintenfass. Der Moench benuetzt es dazu,"
           +" seine Feder hineinzutunken."));

  AddSound(DEFAULT_SOUND, BS(
           "Stille, genau so wie es in einer Bibliothek sein soll, man will"
          +" schliesslich die aufmerksam Lesenden nicht stoeren."));
  AddSound("stille", BS(
           "Stille eben. Einfach nix zum hoeren."));

  AddSmell(DEFAULT_SMELL, BS(
           "Irgendwie kommt Dir vor, hier riecht es ziemlich staubig und"
          +" auch ein wenig nach Tinte."));
  AddSmell("tinte", BS(
           "Du entdeckst auf dem Tisch ein Tintenfass."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  AddCmd(({"such", "suche"}), "srch");
  AddCmd(({"haeng", "haenge"}), "pic");
  AddCmd(({"tunk", "tauch", "tunke", "tauche"}), "tinte");
  AddItem(NPC("moench"), REFRESH_DESTRUCT);
  hung=1; sheet=1;
  
  AddExit("sueden", ROOM("n3"));
}

reset()
{
  ::reset();
  sheet=1;
}

srch(str)
{
  notify_fail("Du suchst, findest aber nichts.\n");
  if (!str)
    return 0;
  if (str!="buecher" && str!="nach buechern")
    return 0;
  write(BS(
        "Vor lauter Buechern hier im Raum weisst Du gar nicht, wo Du mit"
       +" dem Suchen anfangen sollst."));
  return 1;
}

pic(str)
{
  string what;
  
  notify_fail("Was willst Du auf- oder abhaengen?\n");
  if (!str)
    return 0;
  if (sscanf(str, "bild %s", what)!=1)
    return 0;
  if (what!="auf" && what!="ab")
    return 0;
  switch(what) {
    case "auf": if (hung) {
                  write("Das Bild haengt doch schon.\n");
                  return 1;
                }
                write("Du haengst das Bild wieder auf.\n");
                say(TPN+" haengt ein Bild auf.\n");
                hung=1;
                break;
    case "ab":  if (!hung) {
                  write("Das Bild haengt ja gar nicht mehr.\n");
                  return 1;
                }
                write("Du haengst das Bild ab. Dahinter kommt ein Safe zum Vorschein.\n");
                say(TPN+" haengt ein Bild ab.\n");
                hung=0;
  }
  return 1;
}

saf()
{
  if (hung)
    return BS(
            "Du bemerkst an der Wand ein Bild. Hinter dem Bild koennte"
           +" sich ein Safe befinden.");
  if (!sheet)
    return BS(
            "Du untersuchst den Safe, dessen Tuer leicht angelehnt ist,"
           +" genauer, leider ist er jedoch leer.");
  (clone_object(OBJ("rezept")))->move(TP, M_NOCHECK);
  sheet=0;
  return BS(
      "Der Safe der sich hinter dem Bild befunden hat ist nur angelehnt."
     +" Als Du hineinblickst, bemerkst Du, dass ein Zettel darin liegt,"
     +" den Du sofort einsteckst.");
}

pppic()
{
  if (hung)
    return BS(
            "Das Bild haengt leicht schief und ist eine sehr schoene Radierung"
           +" aus frueher Zeit, die einen Tiger darstellt. Du traust Dich nicht,"
           +" es geradezuhaengen.");
  return BS(
          "Das Bild lehnt an der Wand, es ist eine sehr schoene Radierung"
         +" aus frueher Zeit. Es stellt einen Tiger dar.");
}

wall()
{
  if (hung)
    return BS(
            "An den Waenden befinden sich viele Regale, vollgestopft mit"
           +" allerlei Buechern. An der hinteren Wand haengt ein Bild.");
  return BS(
          "An den Waenden befinden sich viele Regale, vollgestopft mit"
         +" allerlei Buechern. An der hinteren Wand findet sich ein Safe.");
}

tinte(str)
{
  object f;
  string was, wo;

  notify_fail("Was willst Du wo hineintunken bzw. -tauchen?\n");
  if (!str)
    return 0;
  if (sscanf(str, "%s in %s", was, wo)!=2)
    return 0;
  if (was!="feder" && was!="schreibfeder")
    return 0;
  if (wo!="tintenfass" && wo!="fass")
    return 0;
  if (!(f=present("\nCfeder", TP))) {
    write("Du besitzt keine spezielle Schreibfeder dafuer.\n");
    return 1;
  }
  write("Du tunkst Deine Schreibfeder in das Tintenfass.\n");
  say(TPN+" tunkt eine Schreibfeder in das Tintenfass.\n");
  f->FillIt();
  return 1;
}

