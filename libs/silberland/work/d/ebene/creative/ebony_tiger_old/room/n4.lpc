/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int statue;

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Westlich der Luke");

  SetProp(P_INT_LONG, BS(
          "Du bist westlich der Luke, die nach oben fuehrt. Der Lichtschein"
         +" von Osten dringt nicht bis hierher, drum ist es hier ziemlich"
         +" dunkel. Von Westen ist der Schein einer Fackel zu erahnen, aber"
         +" mehr laesst sich nicht erkennen. Die Waende sind ueber und ueber"
         +" mit eigenartigen Malereien uebersaet. Und auf dem Boden, im Dunkel"
         +" verborgen, stoesst Du Dir den Fuss an einem Holzbrett."));
  AddDetail("luke", BS(
            "Die Luke ist von hier aus gesehen oestlich von Dir."));
  AddDetail("decke", BS(
            "Die Decke erscheint unnatuerlich weit weg, Du kannst keine naeheren"
           +" Details ausmachen."));
  AddDetail("details", BS(
            "Um Details zu untersuchen, bist Du doch wohl hierhergekommen."));
  AddDetail("boden", BS(
            "Selbst das Licht, das Du selber produzierst, ist nicht ausreichend,"
           +" das Dunkel, das den Boden wie ein Nebel umgibt, zu durchleuchten."));
  AddDetail(({"wand", "waende"}), BS(
            "An den Waenden siehst Du schemenhaft zahlreiche Malereien."));
  AddDetail("fuss", BS(
            "Es ist Dein Fuss."));
  AddDetail(({"licht", "schein", "lichtschein"}), BS(
            "Im Westen erahnst Du eine Fackel, im Osten dringt das Licht durch"
           +" die Luke. Und hier... sorgst Du selber fuer das Licht."));
  AddDetail("nebel", BS(
            "Wenn Du es nicht genauer wuesstest, taetest Du sagen, am Boden liegt"
           +" dichter Nebel."));
  AddDetail("dunkel", BS(
            "Der Boden ist ziemlich dunkel und schwer auszuleuchten."));
  AddDetail("westen", BS(
            "Im Westen, meinst Du, erleuchtet eine Fackel den Raum."));
  AddDetail(({"malerei", "malereien"}), BS(
            "In bunten Farben sind hier einzelne Szenen geschildert."));
  AddDetail("szenen", BS(
            "Die Szenen zeigen vorwiegend Menschen die Tiere jagen."));
  AddDetail("menschen", BS(
            "Ok, ob es Menschen sind kannst Du nicht erkennen. Beschraenken wir"
           +" uns auf Wesen."));
  AddDetail(({"baender", "eisenbaender"}), BS(
            "Die Eisenbaender auf der Holztuer sehen ziemlich stabil aus."));
  AddDetail("fackel", BS(
            "Da das Licht, das Du im Westen erahnen kannst, ziemlich flackert,"
           +" ist es wahrscheinlich, dass es von einer Fackel stammt."));
  AddDetail("farben", BS(
            "Die Malereien sind sehr bunt, sehr farbenpraechtig."));
  AddDetail("tiere", BS(
            "Du siehst die verschiedensten Tiere, jedoch nur schemenhaft."));
  AddDetail(({"brett", "holzbrett"}), BS(
            "Du hast Dir Deinen Fuss dran gestossen, aber da unten ist es"
           +" so dunkel, dass Du nichts sehen kannst."));
  AddSpecialDetail("wesen", "wesen");


  AddSound(DEFAULT_SOUND, BS(
           "Du kannst Dir lebhaft vorstellen wie es waehrend der Jagd geklungen"
          +" haben mag."));

  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht hier etwas muffig. Scheint daran zu liegen dass nicht oft"
          +" gelueftet wird."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));

  AddCmd(({"leucht", "leuchte"}), "lighten");
  
  AddExit("westen", ROOM("m4"));
  AddExit("osten", ROOM("o4"));
  statue=1;

  NewDoor("norden", ROOM("n3"),
          ({ "eisentuer", "eisentuere", "tuere", "tuer"}), 
	  ({ D_NAME, "Eisentuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine Eisentuer (%s).\n",
	     D_LONG, BS(
	       "Diese Eisentuere sieht aeusserst stabil aus."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY,
             D_KEYTESTFUNC, "des_key1"
	  }));
  NewDoor("sueden", ROOM("n5"),
          ({ "holztuer", "holztuere", "tuere", "tuer"}), 
	  ({ D_NAME, "Holztuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine Holztuer (%s).\n",
	     D_LONG, BS(
	       "Die Holztuere ist mit schweren Eisenbaendern beschlagen."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY,
             D_KEYTESTFUNC, "des_key2"
	  }));
}

wesen()
{
  return BS("Du vermutest, dass es sich um einen "+TP->QueryProp(P_RACE)
           +" handelt.");
}

lighten(string str)
{
  string what;

  notify_fail("Was willst Du ausleuchten?\n");
  if (!str || sscanf(str, "%s aus", what)!=1)
    return 0;
  what=lower_case(what);
  if (what=="decke") {
    write(BS(
	  "Du leuchtest die Decke aus, findest aber nix. Da muss es mehr"
	 +" geben."));
    return 1;
  }
  if (what=="boden") {
    write(BS(
	  "Du leuchtest den Boden aus und siehst das Holzbrett im Halbdunkel"
	 +" an der Wand. Das war scheinbar nix. Such weiter."));
    return 1;
  }
  if (what!="brett" && what!="holzbrett") {
    write(BS(
	  "Dort wirds zwar hell, wenn Du hinleuchtest, aber es bringt Dir nix."));
    return 1;
  }
  if (statue) {
    write(BS(
          "Du leuchtest den Boden aus und siehst auf dem Holzbrett eine kleine"
         +" Statue."));
    statue=0;
    clone_object(OBJ("statue"))->move(TO);
  }
  else
    write(BS("Du leuchtest das Holzbrett aus und findest es in leerem Zustand."));
  return 1;
}

reset()
{
  statue=1;
  ::reset();
}

des_key2()
{
  object k;

  k=present("\nHkey", TP);
  if (k) {
    k->remove();
    write("Dein Holzschluessel zerspringt in tausend winzige Holzspaene.\n");
  }
}

des_key1()
{
  object k;

  k=present("\nEkey", TP);
  if (k) {
    k->remove();
    write("Dein Eisenschluessel zerspringt in tausend winzige Teile.\n");
  }
}

