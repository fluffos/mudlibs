/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Dunkler Raum");

  SetProp(P_INT_LONG, BS(
          "Von Westen wie von Osten dringt ein leichter Fackelschein hierher,"
	 +" jedoch muss man schon selber fuer Licht sorgen, damit man sich"
	 +" hier zurechtfindet. An der Wand sieht man im fahlen Licht ein"
	 +" paar Zeichnungen."));
  AddDetail("wand", BS(
            "An der Wand findest Du ein paar Malereien."));
  AddDetail("malereien", BS(
            "Du kannst ueberhaupt nichts an den Malereien identifizieren."));
  AddDetail("decke", BS(
            "Das Kreuzgewoelbe, das hier ueberall die Decke zu bilden scheint,"
	   +" setzt sich auch hier fort."));
  AddDetail("boden", BS(
            "Am Boden gibt es ausser herumliegenden Staubfetzen nichts zu"
	   +" erkennen."));
  AddDetail(({"fetzen", "staub", "staubfetzen"}), BS(
            "Dir ekelt vor zuviel Staub."));
  AddDetail(({"wand", "waende"}), BS(
            "Herrliche undefinierbare Malereien zieren die Waende."));
  AddDetail(({"gewoelbe", "kreuzgewoelbe"}), BS(
            "Um so ein Gewoelbe zu erschaffen, braucht man tatkraeftige"
	   +" Mitarbeiter und viel Zeit."));
  AddDetail(({"arbeiter", "mitarbeiter"}), BS(
            "Wahrscheinlich haben hier Zwerge ihre Zeit damit zugebracht,"
	   +" an diesem schoenen Kunstwerk zu arbeiten."));
  AddDetail("zeit", BS(
            "Was? So spaet schon?"));
  AddDetail("zwerge", BS(
            "Zwerge sind fleissige Arbeiter."));
  AddDetail("kunstwerk", BS(
            "Du betrachtest das Kreuzgewoelbe fasziniert. Ein wahres Kunstwerk."));
  AddDetail("kratzer", BS(
            "An der Stahltuere findest Du nicht den geringsten Kratzer."));
  AddDetail(({"licht", "schein", "fackelschein"}), BS(
            "Von Westen und Osten her dringt ganz wenig Licht, zu wenig, um den"
	   +" Raum zu erhellen."));
  AddDetail("raum", BS(
            "Du befindest Dich schliesslich in einem Raum."));
  AddDetail("westen", BS(
            "Im Westen scheint eine Fackel zu haengen."));
  AddDetail("osten", BS(
            "Von Osten her dringt ein wenig Fackelschein."));
  AddDetail(({"zeichnung", "zeichnungen"}), BS(
            "Die Zeichnungen sind voellig unidentifizierbar."));
  
  AddCmd(({"kratz", "kratze"}), "scratch");

  AddSound(DEFAULT_SOUND, BS(
           "Das Flackern der Fackeln aus den Nachbarraeumen hinterlaesst ein"
	  +" recht mulmiges Gefuehl."));
  AddSound(({"flackern", "fackeln", "knistern"}), BS(
           "Es ist ein leises Knistern, klingt wie von Geisterhand."));

  AddSmell(DEFAULT_SMELL, BS(
           "Auch wenn hier keine Fackel haengt, riecht es ein wenig nach Pech."));
  AddSmell("pech", BS(
           "Riech nicht zu lange daran, es ist ein aeusserst unangenehmer"
	  +" Geruch."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("westen", ROOM("k4"));
  AddExit("osten", ROOM("m4"));
  AddExit("norden", ROOM("l3"));

  NewDoor("sueden", ROOM("l5"),
          ({ "stahltuer", "tuer"}), 
	  ({ D_NAME, "Stahltuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine Stahltuer (%s).\n",
	     D_LONG, BS(
	       "Du siehst eine Stahltuere ohne einen einzigen Kratzer."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY,
	     D_KEYTESTFUNC, "d_key"
	  }));

}


d_key()
{
  object k;

  k=present("\nSTkey", TP);
  if (k) {
    k->remove();
    write("Dein Stahlschluessel zerspringt in tausend winzige Stahlspitzen.\n");
  }
}

scratch(str)
{
  notify_fail("Woran willst Du kratzen?\n");
  if (!str || str!="an tuer" && str!="an stahltuer")
    return 0;
  write(BS("Du versuchst, mit allen Hilfsmitteln an der Tuere herumzukratzen,"
       +" doch die Tuer bleibt glatt und blank wie eh und je."));
  say(TPN+" kratzt an der Stahltuere herum.\n");
  return 1;
}

