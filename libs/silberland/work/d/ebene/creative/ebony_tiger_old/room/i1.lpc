/*
*/

#include "../files.h"
inherit "std/pub";

#include <moving.h>
#include <language.h>
#include <properties.h>
#include <pub.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Noerdlicher Wehrturm");
  SetProp(P_INT_SHORT, "In der Trinkhalle");
  SetProp(P_INT_LONG, BS(
          "Du stehst mitten in der Trinkhalle hier in der Gilde"
         +" des Elfenbeinernen Tigers. Wenn hier jemand mal Durst"
         +" kriegt, kommt er hierher, denn hier gibts ausgiebig"
         +" zu trinken und zu essen. Schon mancher ist hier ordentlich"
         +" versumpft und erzaehlt noch gern von diversen"
         +" Saufgeschichten. Nackte kahle Baenke und ebensolche Tische"
         +" sind hier ueberall zu finden, auch fuer die Dekoration"
         +" der Waende hat sich der Besitzer kaum etwas einfallen"
         +" lassen."));
  AddDetail("boden", BS(
            "Der Boden sollte auch mal wieder gewischt werden. Ueberall"
           +" klebt es und man sollte lieber gar nicht unter die Baenke"
           +" schauen."));
  AddDetail("unter baenke", BS(
            "BAH, Du wendest Dich angeekelt ab."));
  AddDetail(({"wand", "waende"}), BS(
            "An den Waenden haengen einfallslose Geweihe und ein paar"
           +" Bilder mit roehrenden Ogern."));
  AddDetail(({"bilder", "oger"}), BS(
            "Auf den Bildern an den Waenden sieht man ausser Ogern, die"
           +" mit weit aufgerissenem Maul durch die Gegend roehren, noch"
           +" ein praechtiges Gebirge im Hintergrund."));
  AddDetail(({"gebirge", "hintergrund", "grund"}), BS(
            "Im Hintergrund der Bilder erkennt man deutlich ein praechtiges"
           +" Gebirge. Es muss sich um die Gegend nordwestlich von Midas"
           +" handeln."));
  AddDetail(({"gegend", "gebirgszug", "zug", "midas"}), BS(
            "Obwohl Du Dich ja eigentlich noch gar nicht so gut auskennst,"
           +" glaubst Du den Gebirgszug zu erkennen."));
  AddDetail("decke", BS(
            "Von der Decke haengen nackte kahle Lampen die den Raum"
           +" ausreichend erhellen."));
  AddDetail("besitzer", BS(
            "Den Besitzer findest Du hinter der Theke."));
  AddDetail("theke", BS(
            "Die Theke steht im oestlichen Teil des Raums, dort muss man"
           +" hingehen, wenn man etwas zu trinken will, denn Bedienung"
           +" gibt es hier nicht."));
  AddDetail("teil", BS(
            "Im Osten des Raumes steht die Theke.")),
  AddDetail("bedienung", BS(
            "Also Bedienung gibts hier wirklich nicht. Bei den Preisen."));
  AddDetail("preise", BS(
            "Schau Dir doch die Preise an, hier ist es wirklich guenstig!"
           +" Dazu brauchst Du nur \"menue\" einzutippen."));
  AddDetail("dekoration", BS(
            "Also ein bisschen mehr haettest Du Dir vom Besitzer schon"
           +" erwartet. Man koennte hier viel mehr dekorieren."));
  AddDetail("tische", BS(
            "Die Tische hier im Raum werden nur selten gewischt, drum"
           +" sehen sie auch dementsprechend aus. Es sind Holzplatten auf"
           +" Metallgestellen und erfuellen grad mal ihren Zweck."));
  AddDetail(({"platten", "holzplatten", "gestelle", "metallgestelle"}), BS(
            "Baenke wie Tische sind nichts anderes wie Holzplatten die auf"
           +" Metallgestelle geschraubt worden sind."));
  AddDetail("zweck", BS(
            "Der Zweck der Baenke und Tische ist es, sich niederzusetzen und"
           +" einen drauf zu machen."));
  AddDetail(({"halle", "trinkhalle", "raum", "ort"}), BS(
            "Du bist in der Trinkhalle, dem Ort, wo alle herkommen, die nach"
           +" getaner Arbeit einen draufmachen wollen."));
  AddDetail("arbeit", BS(
            "Nunja, welche Arbeit die Diebe verrichten ist ja wohl klar."));
  AddDetail("diebe", BS(
            "In der Gilde des Elfenbeinernen Tigers werden hauptsaechlich"
           +" Diebe geschult."));
  AddDetail("gilde", BS(
            "All das hier ringsum gehoert zur Gilde des Elfenbeinernen Tigers."));
  AddDetail(({"symbol", "tiger"}), BS(
            "Der Elfenbeinerne Tiger ist das Symbol der Gilde."));
  AddDetail(({"trinken", "durst"}), BS(
            "Beim allgemeinen Trinken bekommst Du eigentlich sofort Durst."));
  AddDetail("baenke", BS(
            "Auf den Baenken siehst Du ein paar besoffene Gestalten, die"
           +" sich mit Mueh und Not immer wieder noch ein Bier holen."));
  AddDetail(({"mueh", "not", "gestalten"}), BS(
            "Muehsam holen sich die besonders besoffenen Gestalten noch"
           +" ein Bier, um sich gleich darauf wieder halb munter zuzuprosten."));
  AddDetail(({"geschichten", "geschichte", "saufgeschichte", "saufgeschichten"}), BS(
            "An jedem Tisch, wo fleissig getrunken wird, hoert man eine nach"
           +" der anderen Saufgeschichte."));
  AddDetail("maul", BS(
            "Weit reisst besonders der eine Oger da drueben das Maul auf,"
           +" um einmal kraeftig zu roehren."));
  AddDetail("lampen", BS(
            "An der Decke haengen Lampen, um den Raum zu erhellen."));
  AddDetail(({"geweihe", "geweih"}), BS(
            "Du fragst Dich besser nicht, von was oder wem diese Geweihe"
           +" stammen koennten."));
  AddDetail("bier", BS(
            "Tipp doch einfach mal \"menue\", dann siehst Du was hier angeboten"
           +" wird."));
  AddSmell(DEFAULT_SMELL, BS(
           "Es riecht sehr gut nach dem beruehmten gefuellten Fladenbrot,"
          +" das es hier geben soll."));
  AddSmell(({"brot", "fladenbrot"}), BS(
           "Es riecht einfach koestlich, aber Du kannst nicht herausriechen,"
          +" was da alles drin ist."));
  AddSound(DEFAULT_SOUND, BS(
           "Rund um Dich laermt es da alle sich entweder zuprosten oder"
          +" irgendwelche Geschichten erzaehlen."));
  AddSound("geschichten", BS(
           "Da fast alles rundherum Geschichten erzaehlst, kannst Du Dich"
          +" auf keine einzige konzentrieren."));
  AddRoomMessage(
      ({"'Geh no a Hoibe bittschaen...\n",
        "' ... und was soll ich Dir sagen, ich sah das offene Fenster,"
       +" und schon war ich drin ...'\n",
        "Ein Oger-Gast betrachtet einen seiner Ahnen auf einem Bild.\n",
        "Ein Tiger stuerzt herein und knurrt einen total betrunkenen"
       +" Elf an, schleckt ihm aber dann das Gesicht ab und verschwindet.\n",
        "Ein gefraessiger Hobbit schmatzt laut aus einer Ecke.\n"}), 50);

  AddDrink("Fluegerl", "fluegerl", 550, 40, 13, 10,
           ({"Du kippst das Fluegerl runter und glaubst, um das ganze Silberland fliegen "
            +" zu koennen.",
             "&& kippt ein Fluegerl und hebt fast 3 cm vom Boden ab."}));
  AddDrink("Halbe", "halbe", 85, 15, 5, 5,
           ({ "Weil Du so einen Durst hast kippst Du die Halbe in einem Zug.", 
	      "&& hebt eine Halbe wirklich in nur einem einzigen Zug." }) );
  AddDrink("Seiterl", "seiterl", 70, 10, 4, 3,
           ({ "Das Reiseseiterl is wirklich eine feine Einrichtung!",
	      "Das Reiseseiterl scheint && auch gut zu schmecken." }) );
  AddDrink("Gspritztn", ({"gespritzten", "gspritzter", "gspritztn", "spritzer"}), 90, 18, 7, 6,
	   ({ "Voller Freude stellst Du fest dass der Gspritzte gut gemischt ist.",
	      "Der Wirt mischt den Gspritztn wirklich gut, wie && gerade festgestellt hat." }) );
  AddDrink("Oobielai-Tung", ({"leitung", "obi", "obileitung", "oobielai", "oobielaitung",
           "oobielai-tung"}), 80, 15, 0, 10,
           ({"Dieses exotische Getraenk schmeckt ein bisserl nach Apfel.",
             "&& schmatzt genuesslich nach einem erfrischenden Oobielai-Tung."}));
  AddDrink("Kapielai-Tung", ({"leitung", "cappy", "cappyleitung", "kapielai", "kapielaitung",
           "kapielai-tung"}), 90, 20, 0, 11,
           ({"Obwohl Du nicht sagen kannst woraus das Ding besteht, schmeckst Du Orange heraus.", 
             "&& sieht wirklich gestaerkt aus nach einem Kapielai-Tung."}));
  AddFood("Dost", ({"dost", "toast"}), 150, 35, 10,
          ({"Eine hervorragende Mischung aus Brot, Kaese und Schinken.",
            "&& mampft einen Dost und verbrennt sich fast die Finger dabei."}));
  AddFood("Weisse", "weisse", 400, ({60, 40}), 20,
          ({"Du isst genuesslich die zwei dampfenden heissen weissen Wuerstel mit"
           +" Senf, die Du soeben bekommen hast.",
            "&& bekommt heisse weisse Wuerstel, die er gleich genuesslich verspeist."}));
  AddFood("Gefuelltes Fladenbrot", ({"brot", "fladenbrot"}), 800, ({70, 90}), 29,
          ({ "Du schlemmst das gefuellte Fladenbrot hinunter und reibst Dir den Bauch.",
	     "&& schlemmt ein gefuelltes Fladenbrot und reibt sich anschliessend den Bauch."}) );

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_PUBKEEPER_ID, "herio\lf");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_NAME, "Heriolf");
  SetProp(P_PUBKEEPER_GENDER, MALE);

  AddItem(NPC("heriolf"), REFRESH_DESTRUCT);

  AddExit("westen", ROOM("h1"));
}

