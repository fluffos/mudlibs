/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Vor dem Wasserwerk");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich hinter der Stahltuer vor dem Wasserwerk. Im Sueden"
         +" kannst Du das Werk betreten, dort befindet sich naemlich ein schmaler"
         +" Durchgang. An den Waenden sind ein paar Blutspritzer zu erkennen,"
         +" und an der Decke haengt eine Art Lampe."));
  AddDetail("boden", BS(
            "Auch auf dem Boden, sowie auf den Waenden finden sich kleine"
           +" Blutspritzer."));
  AddDetail(({"waende", "wand"}), BS(
            "Auf den Waenden siehst Du kleine Blutspritzer. Auch eine Peitsche"
           +" faellt Dir auf."));
  AddDetail("peitsche", BS(
            "Die Peitsche ist nicht fuer Dich bestimmt. Sie dient dazu, die Sklaven"
           +" zum Arbeiten zu bewegen."));
  AddDetail(({"sklave", "sklaven"}), BS(
            "Die Sklaven kuemmern sich um das Wasserwerk."));
  AddDetail(({"werk", "wasserwerk"}), BS(
            "Suedlich von Dir befindet sich das Wasserwerk."));
  AddDetail(({"spritzer", "blut", "blutspritzer"}), BS(
            "Die Blutspritzer scheinen von den Sklaven zu kommen, die mit der"
           +" Peitsche ordentlich verpruegelt worden sind."));
  AddDetail("decke", BS(
            "An der Decke haengt eine Lampe."));
  AddDetail(({"lampe", "art"}), BS(
            "Die Lampe verbreitet ein angenehm warmes Licht. Du kannst nicht"
           +" erkennen, was genau da brennt. Versuch doch, die Brennquelle"
           +" genauer zu untersuchen."));
  AddDetail(({"quelle", "brennquelle"}), BS(
            "In der Lampe befindet sich fluessiges Fett, deshalb brennt sie"
           +" ja auch."));
  AddDetail("fett", BS(
            "Es ist so viel fluessiges Fett in der Lampe, dass es nicht"
           +" auffallen wuerde, wenn Du etwas davon klaust. Vielleicht kannst"
           +" Du versuchen, ein wenig davon in ein geeignetes Gefaess zu"
           +" fuellen."));
  AddDetail("gefaess", BS(
            "Hier scheint nirgends ein geeignetes Gefaess zu sein."));
  AddDetail("licht", BS(
            "Die Lampe an der Decke verbreitet ein wirklich sehr schoenes Licht."));
  AddDetail("durchgang", BS(
            "Der Durchgang im Sueden fuehrt zum Wasserwerk."));
  AddDetail(({"tuer", "stahltuer"}), BS(
            "Die Stahltuer befindet sich von hier aus gesehen im Norden."));
  AddDetail(({"arbeiten", "arbeit"}), BS(
            "Die Sklaven verrichten hier viel Arbeit im Wasserwerk."));

  AddSound(DEFAULT_SOUND, BS(
           "Man hoert von weit weit her ein leises Rauschen."));
  AddSound("rauschen", BS(
           "Das Rauschen deutet auf das Wasserwerk im Sueden hin."));

  AddSmell(DEFAULT_SMELL, BS(
           "Die Blutspritzer am Boden und an den Waenden riechen ganz leicht"
          +" metallisch"));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("norden", ROOM("l4"));
  AddExit("sueden", ROOM("l6"));
  AddCmd(({"fuell", "fuelle"}), "fill");
}

fill(str)
{
  string was, wo;
  object o;

  notify_fail("Was willst Du wohin fuellen?\n");
  if (!str)
    return 0;
  if (sscanf(str, "%s in %s", was, wo)!=2)
    return 0;
  if (was!="fett")
    return 0;
  switch (wo) {
    case "tiegel": if (!(o=present("\tiegel", TP))) {
                     write("Sowas hast Du nicht bei Dir!\n");
                     return 1;
                   }
                   if (present("fe\t\t", o)) {
                     write(BS("Da ist doch schon Fett drin!"));
                     return 1;
                   }
                   write(BS(
                       "Du fuellst etwas von dem fluessigen Fett in den Tiegel."));
                   o->AddFat();
                   break;
    default: if (!(o=present(wo, TP))) {
               write("Sowas hast Du nicht bei Dir!\n");
               return 1;
             }
             write(BS(o->Name(WER, 0)+" ist wohl kein geeignetes Gefaess!"));
             break;
  }
  return 1;
}

