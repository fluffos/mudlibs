/*
  Weg zur Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Pfad");
  SetProp(P_INT_SHORT, "Verborgener Pfad");

  SetProp(P_INT_LONG, BS(
          "Du hast es geschafft! Du bist vor Deiner eigenen Angst geflohen"
	 +" und hast gesiegt. Sei es, dass Du von Sueden kommst und Dich"
	 +" die ganze Zeit gefragt hast, was du ueberhaupt hier willst,"
	 +" oder sei es, Du bist dem Boesen, das dort unten immer noch"
	 +" auf Dich lauert, entronnen. Preiset den Gott!"));
  AddDetail("gott", BS(
            "Woody oder Dusty?"));
  AddDetail("woody", BS(
            "Woody. Ich glaub nicht mal, dass der schon hier war."));
  AddDetail("dusty", BS(
            "Dusty. Hat sich doch schon Ewigkeiten nicht mehr mit"
	   +" Dir beschaeftigt."));
  AddDetail("boden", BS(
            "Im Boden eingelassen, auch wenn es fuer die Gegend hier"
	   +" ungewoehnlich erscheint, ist eine Luke."));
  AddDetail("luke", BS(
            "Wie nicht anders zu erwarten, fuehrt die Luke nach unten."));
  AddDetail("gegend", BS(
            "Die ganze Gegend hier gehoert noch zur Steppe."));
  AddDetail("steppe", BS(
            "Wenn Du mehr ueber die Steppe wissen willst, solltest Du schon"
	   +" weiter nach Sueden gehen."));
  AddDetail("sueden", BS(
            "Weiter im Sueden erfaehrst Du mehr ueber die Steppe."));
  AddDetail("ewigkeit", BS(
            "Hier ist schon die kleinste Zeitspanne eine Ewigkeit."));
  AddDetail(({"zeitspanne", "zeit"}), BS(
            "Ich wuerde mal schaetzen, das waren ein paar Sekunden."));
  AddDetail("sekunden", BS(
            "Kannst Du das selber so genau abschaetzen?"));
  AddDetail(({"boeses", "boese"}), BS(
            "Das Boese ist immer und ueberall."));
  AddDetail("angst", BS(
            "Ich merke es schon, Du hast Angst."));
  AddDetail("himmel", BS(
            "Auch wenn der Himmel praesent ist, hat er doch nichts Wesentliches"
	   +" zu bieten."));
  AddDetail("sonne", BS(
            "Bravo... sogar die Sonne ist hier. Doch sie zu bemerken war schon"
	   +" fast ein Wunder."));
  AddDetail("wunder", BS(
            "Wer glaubt heutzutage noch an Wunder..."));

  AddSound(DEFAULT_SOUND, BS(
           "Du konzentrierst Dich sehr auf Deine Ohren. Du bemerkst, dass von"
	  +" dem Tor, das im Sueden liegt, ein paar Stimmen erklingen."));
  AddSound("stimmen", BS(
           "Die Stimmen sind wie die von Toten und erzaehlen etwas ueber das"
	  +" Boese. Du horchst gleich wieder weg, denn Du willst Deine Gedanken"
	  +" nicht absichtlich trueben."));

  AddSmell(DEFAULT_SMELL, BS(
           "Von unten, durch die Luke, riecht es ein wenig muffig."));
  AddSmell("luke", BS(
           "Die Luke fuer sich riecht ueberhaupt nicht, doch durch sie"
	  +" weht ein etwas abgestandene Luft herauf."));
  AddSmell("luft", BS(
           "Die Luft, die durch die Luke heraufkommt, riecht, wie wenn"
	  +" sie gut daran taete, einmal durchlueftet zu werden."));

  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_PLAIN]));
  
  AddExit("sueden", ROOM("s2"));
  AddExit("unten", ROOM("o4"));

}

