/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Innerer Kreis");
  SetProp(P_INT_SHORT, "Zentraler Treffpunkt");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich hier am zentralen Platz in der Gilde des"
         +" Elfenbeinernen Tigers. Es scheinen sich hier alle wichtigen"
         +" Wege zu treffen, die in die einzelnen Gildenraeume fuehren."));

  AddDetail("boden", BS(
            "Der Boden ist hier zwar aus Lehm, aber schon so festgestampft,"
           +" dass er ganz hart geworden ist. Hier kann man ja fast schon"
           +" von Asphalt sprechen, so viele Fuesse haben hier schon den"
           +" Lehm verdichtet."));
  AddDetail("lehm", BS(
            "Der Boden besteht hauptsaechlich aus Lehm."));
  AddDetail("asphalt", BS(
            "Der Boden besteht zwar nicht aus Asphalt, aber er fuehlt sich"
           +" prinzipiell so an."));
  AddDetail("fuesse", BS(
            "Auch Deine Fuesse tragen dazu bei, dass der Boden haerter und"
           +" haerter wird."));
  AddDetail("decke", BS(
            "Die Decke hat eine eigenartige Form"));
  AddDetail("form", BS(
            "Man koennte meinen, dass es sich um ein Kreuzgewoelbe handelt."));
  AddDetail(({"gewoelbe", "kreuzgewoelbe"}), BS(
            "Sogar an einem Ort wie diesem findet sich ein architektonisches"
           +" Meisterwerk wie dieses Kreuzgewoelbe."));
  AddDetail("ort", BS(
            "Der Ort, das ist das, wo Du Dich gerade befindest. Und wo das"
           +" genau ist, weisst Du wohl, naemlich in den Raeumen der Gilde"
           +" des Elfenbeinernen Tigers."));
  AddDetail(({"gildenraeume", "raeume"}), BS(
            "Die Gilde besteht ja definitiv aus mehreren Raeumen."));
  AddDetail("gilde", BS(
            "Du befindest Dich in den Raeumen der Gilde des Elfenbeinernen"
	   +" Tigers."));
  AddDetail("platz", BS(
            "Dieser Platz hier ist derjenige, an dem alle Wege zusammentreffen."));
  AddDetail(({"weg", "wege"}), BS(
            "Die wichtigsten Wege innerhalb der Gilde treffen genau hier"
	   +" zusammen."));
  AddDetail("meisterwerk", BS(
            "Sehr viele arme Zwerge haben daran sicher Jahre ihres Lebens"
           +" schuften muessen, um dieses einzigartige Kreuzgewoelbe zu"
           +" schaffen."));
  AddDetail("leben", BS(
            "So am leben zu sein is doch schon was schoenes... Wie schnell"
           +" sich das doch aendern kann :-)"));
  AddSpecialDetail(({"zwerg", "kerle", "kerl", "zwerge"}), "dwarf");
  AddDetail("arbeit", BS(
            "So ein Kreuzgewoelbe macht massig Arbeit, fuer Jahre."));
  AddDetail(({"jahre", "jahr"}), BS(
            "Die Zwerge haben hier sicher mehr als ein Jahr daran gearbeitet."));
  AddDetail(({"waende", "wand"}), BS(
            "An der Wand siehst Du einige huebsche Zeichnungen und eine Fackel."));
  AddDetail("fackel", BS(
            "Die Fackel an der Wand ist sehr hoch oben und beleuchtet die"
           +" Zeichnungen recht schoen."));
  AddDetail(({"zeichnung", "zeichnungen"}), BS(
            "Wie nicht anders zu erwarten war, zeigt die Zeichnung einen Tiger."));
  AddDetail("tiger", BS(
            "Dieser Tiger hier sieht besonders furchterregend aus. Er hat sein"
           +" Maul weit aufgerissen, und sein Schwanz scheint peitschend hin-"
           +" und herzuschlagen."));
  AddDetail("maul", BS(
            "Sieh da, als Du das Maul genauer untersuchst bemerkst Du, dass"
           +" an der Stelle ein Loch in der Wand ist."));
  AddDetail("stelle", BS(
            "Dort, wo das Maul ist, befindet sich ein Loch in der Wand."));
  AddDetail("schwanz", BS(
            "Der Schwanz zeigt auf ein Rechteck."));
  AddDetail("rechteck", BS(
            "Als Du es genauer betrachtest, scheint es sich um eine Klappe"
           +" zu handeln."));
  AddDetail(({"mittel", "klappe"}), BS(
            "Die Klappe ist mit keinen Mitteln aufzukriegen."));
  AddDetail("loch", BS(
            "Das Loch scheint direkt dazu einzuladen, etwas hineinzulegen."));
  AddDetail("ahnung", BS(
            "Hast Du eine Ahnung!"));
  AddDetail("silber", BS(
            "Das Silber scheint sehr rein zu sein."));
  AddDetail("verzierungen", BS(
            "Auf der Tuere sieht man sehr schoen verschiedene Kreise, durch"
	   +" die jeweils Tiger zu springen scheinen."));
  AddDetail("kreise", BS(
            "Die Kreise sind in die Tuere eingraviert."));

  AddSound(DEFAULT_SOUND, BS(
           "Dir kommt vor, als ob hier ein Lueftlein pfeifen wuerde."));
  AddSound(({"wand", "pfeifen", "lueftlein"}), BS(
           "Das Pfeifen kommt irgendwo undefinierbar aus der Wand."));
  AddSmell(DEFAULT_SMELL, BS(
           "Hier drinnen riecht es staubig und muffig, sofern es danach"
	  +" ueberhaupt riechen kann."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  AddCmd(({"leg", "lege"}), "put_tiger");
  
  AddExit("osten", ROOM("l4"));
  AddExit("nordwesten", ROOM("j3"));
  AddExit("suedwesten", ROOM("j5"));

  NewDoor("westen", ROOM("j4"),
          ({ "silbertuer", "tuer"}), 
	  ({ D_NAME, "Silbertuer", D_GENDER, FEMALE,
	     D_SHORT, "Eine Tuer aus reinstem Silber (%s).\n",
	     D_LONG, BS(
	       "Diese Tuere besteht aus reinstem Silber und hat ein paar Verzierungen."),
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY,
	     D_KEYTESTFUNC, "d_key"
	  }));
  AddItem(NPC("illuan"), REFRESH_DESTRUCT);
}

dwarf()
{
  if (TP->QueryProp(P_RACE)=="Zwerg")
    return BS("Du musst das nachempfinden koennen, wie schwer diese armen kleinen"
             +" Kerle geschuftet haben muessen, denn Du bist auch einer.");
  else
    return BS("Du hast keine Ahnung, was fuer Arbeit es bedeutet, an diesem"
             +" Meisterwerk zu arbeiten.");
}

d_key()
{
  object k;

  k=present("\nADJkey", TP);
  if (k) {
    k->remove();
    write("Dein Silberschluessel zerspringt in tausend winzige Silbersterne.\n");
  }
}

put_tiger(str)
{
  object s;
  string what;
  
  notify_fail("GNI!\n");
  if (!str || sscanf(str, "%s in loch", what)!=1)
    return 0;
  what=lower_case(what);
  if (what=="tigerstatue" || what=="statue" && (s=present("\tstatue", TP))) {
    write(BS(
	  "Du legst die Tigerstatue in das Loch. Sofort verschwindet sie"
	 +" und es rumpelt laut. Die Klappe oeffnet sich, ein Schluessel"
	 +" faellt heraus, und sofort schliesst sich die Klappe wieder."));
    clone_object(OBJ("keybc3"))->move(TO);
    s->remove();
  }
  else
    write(BS("Das geht nicht."));
  return 1;
}
