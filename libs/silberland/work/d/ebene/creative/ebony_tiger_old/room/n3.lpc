/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create()
{
  ::create();

  SetProp(P_ZONE, "Nebenraeume");
  SetProp(P_INT_SHORT, "Bibliothek");

  SetProp(P_INT_LONG, BS(
          "Du befindest Dich in der Bibliothek. Die Regale an den Waenden"
         +" sind vollgestopft mit Buechern aller Art. Hier scheinen die"
         +" Mitglieder der Gilde ihr gesamtes Wissen zu lagern."));
  AddDetail("boden", BS(
            "Am Boden liegen verstreut einige Buecher herum."));
  AddDetail("decke", BS(
            "Die Decke ist genial ausgeleuchtet, sodass man ungehindert schon"
           +" mal in ein paar Buechern stoebern kann."));
  AddDetail("bibliothek", BS(
            "Du befindest Dich gerade in der Bibliothek."));
  AddDetail(({"waende", "wand"}), BS(
            "An den Waenden befinden sich einige Regale."));
  AddDetail(({"regal", "regale"}), BS(
            "Die Regale an den Waenden sind vollgestopft mit Buechern."));
  AddDetail(({"buch", "buecher"}), BS(
            "Welche Buecher meinst Du? Die Buecher in der wievielten Reihe?"
           +" (versuchs mal mit 'reihe x')"));
  AddDetail("reihen", BS(
            "Insgesamt siehst Du zehn Reihen."));
  AddDetail("reihe", BS(
            "Welche Reihe genau meinst Du?"));
  AddDetail("reihe 0", BS(
            "Bist Du Informatiker? :)"));
  AddDetail("informatiker", BS(
            "Nur Informatiker kommen darauf, bei 0 anzufangen."));
  AddDetail("reihe 1", BS(
            "Hier stehen fast ausschliesslich uninteressante neue Buecher."));
  AddDetail("reihe 2", BS(
            "Mist, hier findest Du nur Belletristik."));
  AddDetail("belletristik", BS(
            "Manche sagen auch Schund dazu."));
  AddDetail("schund", BS(
            "Belletristik ist fuer manche nur Schund."));
  AddDetail("reihe 3", BS(
            "Ein paar aeltere Dokumentenmappen stehen hier herum."));
  AddDetail(({"mappen", "dokumentenmappen"}), BS(
            "In der dritten Reihe findest Du uninteressante Dokumentenmappen."));
  AddDetail("reihe 4", BS(
            "Du siehst ein paar Hefte herumliegen."));
  AddDetail("hefte", BS(
            "Ah, Du hast soeben ein paar Comics gefunden!"));
  AddDetail("comics", BS(
            "Lass Dich beim Lesen nicht erwischen, sonst haelt Dich jeder fuer"
           +" ein Kleinkind!"));
  AddReadDetail(({"comic", "comics"}), BS(
                "Du ueberfliegst ein paar Seiten, legst das Heft jedoch schnell wieder"
               +" weg. Dich soll ja keiner erwischen!"));
  AddDetail("reihe 5", BS(
            "In der fuenften Reihe siehst Du alte schwere Schinken."));
  AddDetail("schinken", BS(
            "Bah, die Buecher sind so verstaubt, die greifst Du lieber nicht an."));
  AddDetail("reihe 6", BS(
            "Die sechste Reihe des Regals ist leer."));
  AddDetail("reihe 7", BS(
            "In der siebten Reihe findest Du lauter zusammengerollte Schriftrollen."));
  AddDetail(({"rollen", "schriftrollen"}), BS(
            "Jede der Schriftrollen ist mit einem roten Band zusammengebunden."));
  AddDetail("band", BS(
            "Das Band ist aus Satin."));
  AddDetail("satin", BS(
            "Die Baender die die Schriftrollen zusammenhalten sind aus Satin."));
  AddDetail("reihe 8", BS(
            "Du findest lauter Buecher mit einem blauen Einband."));
  AddDetail("einband", BS(
            "Die Buecher mit dem blauen Einband scheinen eine Art Schriftsammlung zu"
           +" beherbergen. Auf dem Ruecken der Buecher ist etwas gepraegt."));
  AddDetail("ruecken", BS(
            "Du kannst den Praegedruck lesen."));
  AddDetail(({"sammlung", "schriftensammlung", "schriftsammlung"}), BS(
            "Auf dem Ruecken der Buecher mit dem blauen Einband sieht man einen"
           +" Praegedruck."));
  AddReadDetail(({"druck", "praegedruck"}), BS(
                "'SilberLand-Presse Archiv, Zeitungsbaende III-XLVII'"));
  AddDetail(({"druck", "praegedruck"}), BS(
            "Man kann den Praegedruck lesen."));
  AddDetail("reihe 9", BS(
            "In der neunten Reihe siehst Du ganz dicke Waelzer."));
  AddDetail("waelzer", BS(
            "Ein besonderes fettes Exemplar faellt Dir ins Auge."));
  AddSpecialDetail(({"auge", "exemplar"}), "ouch");
  AddDetail("reihe 10", BS(
            "Die 10. Reihe ist zu hoch oben, Du siehst nicht was darin steht."));
  AddDetail("mitglieder", BS(
            "Die Mitglieder der Gilde scheinen hier auch ab und zu mal nachzuschlagen."));
  AddDetail("gilde", BS(
            "Such nur nach Informationen zur Gilde."));
  AddDetail("informationen", BS(
            "Die meisten Informationen kann Dir wohl der Bibliothekar geben."));
  AddDetail("bibliothekar", BS(
            "Wenn er nicht ein Zimmer noerdlich sitzt, ist er bestimmt auf der Suche"
           +" nach neuen Buechern."));
  AddDetail("suche", BS(
            "Such doch selber mal."));
  AddDetail("zimmer", BS(
            "Im Norden von Dir sitzt der Bibliothekar."));
  AddDetail("wissen", BS(
            "Hier in der Bibliothek ist sehr viel Wissen gespeichert."));
  AddDetail(({"arten", "art"}), BS(
            "Alle Arten von Buechern findet man hier in der Bibliothek."));

  AddSound(DEFAULT_SOUND, BS(
           "Ausser dem Pfeifen des Windes durch das Tor hoert man nichts."));

  AddSmell(DEFAULT_SMELL, BS(
           "Der Busch neben Dir riecht etwas streng."));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN:TT_HOUSE]));
  AddCmd(({"such", "suche"}), "srch");
  
  AddExit("norden", ROOM("n2"));
  AddExit("sueden", ROOM("n4"));
}

ouch()
{
  write("Das fette Exemplar faellt Dir ja tatsaechlich INS Auge!\n");
  say(TPN+" ist einfach zu bloed einen Text zu verstehen.\n");
  TP->reduce_hit_point(8);
  return "AUA!!!\n";
}

srch(str)
{
  notify_fail("Du suchst, findest aber nichts.\n");
  if (!str)
    return 0;
  if (str!="informationen")
    return 0;
  write("Du solltest lieber doch den Bibliothekar fragen.\n");
  return 1;
}


