/*
  Ebony Tiger Guild
*/

#include "../files.h"
inherit PATH+"std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

int key;

create()
{
  ::create();

  SetProp(P_ZONE, "Noerdlicher Wehrturm");
  SetProp(P_INT_SHORT, "Alte Apotheke");

  SetProp(P_INT_LONG, BS(
          "Sogar eine kleine Apotheke hat hier ihren Platz gefunden."
         +" Doch irgendwie scheint sie nur noch als Lagerplatz fuer"
         +" ein paar Kraeuter und Buecher zu sein, denn einen Verkaeufer"
         +" findest Du nirgends mehr."));
  AddDetail("boden", BS(
            "Am Boden ist ein sehr schoenes Parkett verlegt."));
  AddDetail("parkett", BS(
            "Das Parkett besteht aus sehr grossen Holzdielen, die gut"
           +" aneinander verlegt sind. Du siehst ausserdem einen Teppich"
           +" auf dem Parkett liegen."));
  AddDetail(({"dielen", "holzdielen"}), BS(
            "Die Holzdielen sind sehr eng verlegt. Nur 3 Stueck davon sind"
           +" irgendwie andersrum gelegt."));
  AddSpecialDetail("stueck", "door");
  AddSpecialDetail(({"tuer", "falltuer"}), "doo");
  AddDetail("ritze", BS(
            "Zwischen zwei Holzdielen gibt es oefters auch mal eine Ritze."));
  AddDetail("teppich", BS(
            "Es ist ein sehr schoener exotischer Teppich mit einem"
           +" wunderhuebschen Motiv."));
  AddDetail("motiv", BS(
            "In der Mitte des Teppichs siehst Du eine Rose."));
  AddDetail(({"mitte", "bluete", "rose"}), BS(
            "Genau inmitten der Bluete siehst Du eine Woelbung."));
  AddDetail("woelbung", BS(
            "Da muss wohl etwas unter dem Teppich liegen."));
  AddSpecialDetail("unter teppich", "carpet");
  AddDetail("decke", BS(
            "Die Decke ist holzvertaefelt und schaut schon reichlich"
           +" renovierbeduerftig aus."));
  AddDetail(({"wand", "waende"}), BS(
            "An den Waenden findet man einige Stellagen mit diversen"
           +" Toepfen."));
  AddDetail("stellagen", BS(
            "Die Stellagen bersten direkt vor lauter Toepfen."));
  AddDetail(({"dosen", "toepfe"}), BS(
            "Die meisten Toepfe sind beschriftet: 'Kampfer', 'Oel', 'Melisse', ..."));
  AddDetail("apotheke", BS(
            "Du stehst in der Apotheke im alten Wehrturm. An den Waenden"
           +" siehst Du Stellagen, auf der Theke steht eine alte"
           +" Registrierkassa."));
  AddDetail("theke", BS(
            "Mitten im Raum steht eine hoelzerne Theke mit einer alten"
           +" Registrierkassa. Daneben siehst Du einen Moerser."));
  AddDetail("buecher", BS(
            "Du siehst lauter uninteressante Buecher ueber Medizin und"
           +" Kraeuter."));
  AddDetail("medizin", BS(
            "Du bist sicher, dass sich in einigen der Dosen auch noch"
           +" etwas Medizin finden wird."));
  AddDetail("kraeuter", BS(
            "Fast alle Kraeuter sind hier irgendwo in Dosen gelagert."
           +" Doch alles scheint uninteressant fuer Dich."));
  AddDetail("melisse", BS(
            "Melisse riecht besonders gut."));
  AddDetail("kampfer", BS(
            "Kampfer benoetigt man um besonderes Oel herzustellen."));
  AddDetail("oel", BS(
            "Das Oel gehoert zu den Grundstoffen im Apothekergeschaeft."));
  AddDetail(({"geschaeft", "apothekergeschaeft"}), BS(
            "Viel Geschaeft wird hier nicht mehr gemacht."));
  AddDetail("verkaeufer", BS(
            "Siehst Du hier irgendwo einen Verkaeufer?"));
  AddDetail(({"turm", "wehrturm"}), BS(
            "Du befindest Dich in einem der westlichsten Raeume im"
           +" noerdlichen Wehrturm."));
  AddDetail(({"raeume", "raum"}), BS(
            "Dieser Raum gehoert zum noerdlichen Wehrturm."));
  AddDetail(({"lagerplatz", "platz"}), BS(
            "Recht viel Platz gibt es nicht mehr hier, auch nicht mehr"
           +" in den Stellagen an den Waenden."));
  AddDetail(({"stoffe", "grundstoffe"}), BS(
            "Grundstoffe benoetigt man, um die richtige Medizin"
           +" zusammenzumischen."));
  AddDetail("leere", BS(
            "Oed, erschreckend, leer."));
  AddDetail("moerser", BS(
            "In dem Moerser kannst Du Zutaten zerstampfen."));

  AddSound(DEFAULT_SOUND, BS(
           "Unheimliche Geraeusche dringen an Dein Ohr."));
  AddSound("geraeusche", BS(
           "Du kannst die Geraeusche nicht naeher einordnen. Jedoch kommt"
          +" Dir vor, dass sie dumpf und weit weg klingen."));

  AddSmell(DEFAULT_SMELL, BS(
           "Kraeuterduft kannst Du hier ueberall erschnuppern. Wenn Du"
          +" Dich ganz stark konzentrierst, riechst Du auch ein wenig"
          +" Moder."));
  AddSmell(({"duft", "kraeuter", "kraeuterduft"}), BS(
           "Kein Wunder, dass Du hier ueberall Kraeuter riechst, ist"
          +" doch die Apotheke vollgestopft damit."));
  AddSmell("moder", BS(
           "Irgendwie riecht es vom Boden her modrig."));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HOUSE]));
  
  AddExit("nordosten", ROOM("f1"));
  key=1;
  AddItem(OBJ("kassa"), REFRESH_REMOVE);
  AddCmd(({"zerstampf", "zerstampfe"}), "crush");
}

reset()
{
  ::reset();
  key=1;
}

ud()
{
  object des;

  des=UMSTR->init_new_player(this_player(), TO);
  this_player()->move(des, M_GO, "nach unten", "klettert durch eine geheime Falltuer", "kommt von oben hereingeklettert");
  RemoveSpecialExit("unten");
  return 1;
}

door()
{
  AddSpecialExit("unten", "ud");
  return BS("Du entdeckst eine Falltuer, die Du sofort oeffnest.");
}

doo()
{
  if (member(QueryProp(P_SPECIAL_EXITS), "unten"))
    return BS(
      "Die Falltuer ist geoeffnet und von unten gaehnt finstere Leere"
     +" herauf.");
  else
    return BS("Sowas siehst Du hier nicht!");
}

carpet()
{
  object o;

  if (key) {
    o=clone_object(OBJ("kassakey"));
    o->move(TP, M_NOCHECK);
    return BS("Du hebst den Teppich leicht an und schaust unter den"
         +" Teppich. Du findest einen winzigen Schluessel, den Du"
         +" sofort einsteckst.");
  }
  else
    return BS("Hm, unter dem Teppich ist nix. Da muss aber einmal"
             +" was daruntergelegen haben.");
}

crush(str)
{
  object i;

  notify_fail("Was willst Du zerstampfen?\n");
  if (!str)
    return 0;
  switch (str) {
    case "drachenschuppe":
    case "schuppe": if (!(i=present("\nschupp", TP))) {
                      write("Sowas hast Du nicht bei Dir!\n");
                      return 1;
                    }
                    i->AddAmount(-1);
                    write("Du zerstampfst die Drachenschuppe zu Pulver.\n");
                    say(TPN+" zerstampft etwas in einem Moerser.\n");
                    i=clone_object(OBJ("b_pulver"));
                    i->MadeFrom("schuppe");
                    i->move(TP, M_NOCHECK);
                    break;
    case "eisherz":
    case "herz": if (!(i=present("\neherz", TP))) {
                   write("Sowas hast Du nicht bei Dir!\n");
                   return 1;
                 }
                 i->remove();
                 write("Du zerstampfst das Eisherz zu Pulver.\n");
                 say(TPN+" zerstampft etwas in einem Moerser.\n");
                 i=clone_object(OBJ("b_pulver"));
                 i->MadeFrom("herz");
                 i->move(TP, M_NOCHECK);
                 break;
    default: if (!(i=present(str, TP))) {
               write("Sowas hast Du nicht bei Dir!\n");
               return 1;
             }
             write(BS("Du willst "+i->name(WER, 2)+" doch nicht zerstampfen!!!"));
             break;
  }
  return 1;
}

