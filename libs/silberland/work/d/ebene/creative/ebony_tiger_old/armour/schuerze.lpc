inherit "std/armour";

#include <combat.h>
#include <properties.h>
#include <language.h>
#include <armour.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, "Eine Friseursschuerze");
  SetProp(P_LONG, BS(
          "Die Friseursschuerze gehoert Birn dem Friseur. Er benoetigt"
         +" Sie um seine Scheren irgendwo unterzubringen."));
  AddDetail(({"schere", "scheren"}), BS(
            "Birn hat keine Schere in der Schuerze gelassen."));
  SetProp(P_VALUE, 700);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Schuerze");
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_SILK:15, MAT_COTTON:65, MAT_FELT:20]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_WEAR_TEXT, ({"Du haengst Dir die Schuerze um.\n",
                         " haengt sich die Schuerze um.\n"}));
  AddId("schuerze");
}

