inherit "std/armour";

#include <combat.h>
#include <properties.h>
#include <language.h>
#include <armour.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, "Ein seidener Umhang");
  SetProp(P_LONG, BS(
          "Der seidene Umhang ist ein sehr leichter Schutz und scheint"
         +" Dir sehr kostbar zu sein."));
  SetProp(P_VALUE, 900);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Umhang");
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_SILK:75, MAT_VELVET:5, MAT_COTTON:15, MAT_CLOTH:5]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_WEAR_TEXT, ({"Du haengst Dir den seidenen Umhang ueber die Schultern.\n",
                         " haengt sich den seidenen Umhang ueber die Schultern.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du nimmst den seidenen Umhang ab.\n",
                           " nimmt den seidenen Umhang ab.\n"}));
  SetProp(P_WORN_TEXT, "umgehaengt");
  AddId("umhang");
  AddAdjective("seidener");
}

