inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <material.h>
#include "../files.h"

create()      
{
  if (!is_clone(this_object()))
    return;
  ::create();

  AddId("kordel");
  SetProp(P_SHORT, "Eine Kordel");
  SetProp(P_LONG, BS(
      "Die Kordel ist gedacht, um Moenchen die Kutte besser um ihren"
     +" dicken Bauch binden zu koennen. Sie ist sehr grob und einfach."));
  SetProp(P_NAME, "Kordel");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_WEIGHT, 180);
  SetProp(P_VALUE, 80+random(30));
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_CLOTH);
}

