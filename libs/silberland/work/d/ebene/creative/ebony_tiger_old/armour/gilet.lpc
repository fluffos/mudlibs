inherit "std/armour";

#include <armour.h>
#include <language.h>
#include <properties.h>
#include <material.h>
#include <combat.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();
  SetProp(P_SHORT, "Ein Gilet");
  SetProp(P_LONG, BS("Das ist ein sehr leichtes Ledergilet, das trotz der"
                    +" Einfachheit des Stoffs sehr robust wirkt. Die Knoepfe"
		    +" sind aus Keramik."));
  AddDetail(({"knoepfe", "muster"}), BS(
            "Die keramischen Knoepfe haben ein schoenes Muster."));
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 25);
  SetProp(P_WEIGHT, 800);
  SetProp(P_MATERIAL, ([MAT_LEATHER:98, MAT_CERAMIC:2]));
  SetProp(P_VALUE, 300);
  SetProp(P_NAME, "Gilet");
  SetProp(P_GENDER, NEUTER);
  AddId("gilet");
}

