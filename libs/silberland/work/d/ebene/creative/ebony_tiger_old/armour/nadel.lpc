inherit "std/armour";

#include <armour.h>
#include <combat.h>
#include <language.h>
#include <properties.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_NAME, "Krawattennadel");
  SetProp(P_SHORT, "Eine Krawattennadel");
  SetProp(P_LONG, BS(
          "Eine Krawattennadel mit einem kleinen Diamant drauf."));
  SetProp(P_INFO, BS(
          "Die Krawattennadel kannst Du nur an stoffene Kleidungsstuecke"
         +" anstecken."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 450+random(300));
  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_MATERIAL, ([MAT_GOLD:97, MAT_DIAMOND:3 ]));
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_WEAR_TEXT, ({ "Du steckst Dir die Krawattennadel an.\n", 
                          " steckt sich eine Krawattennadel an.\n" }));
  SetProp(P_UNWEAR_TEXT, ({ "Du steckst Dir die Krawattennadel ab.\n", 
                          " steckt sich eine Krawattennadel ab.\n" }));
  SetProp(P_WORN_TEXT, "angesteckt");
  AddId("nadel");
  AddId("krawattennadel");
  SetProp(P_WEIGHT, 30+random(30));
}

WearFunc(object r, int s)
{
  object *a;

  a=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_ARMOUR);
  if (sizeof(a) && a[0]->QueryMaterialGroup(MATGROUP_CLOTH) > 10)
    return 1;
  a=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_CLOAK);
  if (sizeof(a) && a[0]->QueryMaterialGroup(MATGROUP_CLOTH) > 10)
    return 1;
  if (!s)
    write(BS("An Deinen Kleidungsstuecken ist zu wenig Stoff, um die" 
            +" Krawattennadel anzustecken!"));
  return 0;
}

