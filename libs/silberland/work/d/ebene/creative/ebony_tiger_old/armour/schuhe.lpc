inherit "std/armour";

#include <armour.h>
#include <language.h>
#include <combat.h>
#include <properties.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, "Ein Paar Schuhe");
  SetProp(P_LONG, BS("Das ist ein Paar hochhackiger Schuhe."));
  SetProp(P_GENDER, NEUTER);
  AddId("paar");
  AddId("schuhe");
  SetProp(P_NAME, "Paar Schuhe");
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_LEATHER:70, MAT_SILK:15, MAT_COTTON:10, MAT_PLASTIC:5]));
  SetProp(P_VALUE, 300);
}

