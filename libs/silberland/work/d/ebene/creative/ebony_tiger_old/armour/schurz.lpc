inherit "std/armour";

#include <combat.h>
#include <properties.h>
#include <language.h>
#include <armour.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, "Ein Lendenschurz");
  SetProp(P_LONG, BS(
          "Ein ganz feiner Lendenschurz, ziemlich gut gearbeitet aus"
         +" fest gegerbten Tierhaeuten. Er ist sehr wasserabweisend,"
         +" um dem Traeger maximalen Komfort zu bieten."));
  SetProp(P_VALUE, 600);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Lendenschurz");
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_LEATHER:90, MAT_COTTON:10]));
  SetProp(P_WEIGHT, 600);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:0]));
  AddId("schurz");
  AddId("lendenschurz");
}

