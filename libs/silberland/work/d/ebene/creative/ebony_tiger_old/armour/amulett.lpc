inherit "std/armour";

#include <armour.h>
#include <combat.h>
#include <language.h>
#include <properties.h>
#include "../files.h"

#define SPEC_MAT ({ MAT_RUBY, MAT_DIAMOND, MAT_SAPPHIRE, MAT_OPAL, \
                    MAT_EMERALD, MAT_AMETHYST })

#define MATMSTR "p/daemon/materialdb"

create()
{
  int r;
  string s;
  
  if (!is_clone(TO))
    return;
  ::create();

  r=random(100)%6;
  s=MATMSTR->MaterialName(SPEC_MAT[r], 0, 100);
  SetProp(P_NAME, s+"amulett");
  SetProp(P_SHORT, "Ein "+s+"amulett");
  SetProp(P_LONG, BS(
          "Das ist ein wertvolles Amulett mit einem schoenen "+MATMSTR->MaterialName(SPEC_MAT[r], WEM, 100)+" eingebettet in einem Goldtaler."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 450+random(r*800));
  SetProp(P_AC, 1+r/2);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_MATERIAL, ([ MAT_GOLD:100-r*3, SPEC_MAT[r]:r*3 ]));
  AddId("amulett");
  AddId(lower_case(s)+"amulett");
  SetProp(P_WEIGHT, 150+random(r*40));
  if (!random(100)%5)
    SetProp(P_CURSED, 1);
}

