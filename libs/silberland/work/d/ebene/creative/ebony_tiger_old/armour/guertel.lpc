inherit "std/container";
inherit "std/armour";
inherit "std/armour/description";


#include <armour.h>
#include <thing.h>
#include <language.h>
#include <properties.h>
#include <container.h>
#include <material.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;
  armour::create();
  container::create();
  description::create();

  SetProp(P_SHORT, "Ein Guertel mit vielen Taschen");
  SetProp(P_NAME, "Guertel");
  SetProp(P_LONG, BS("Das ist ein Guertel mit vielen kleinen Taschen. Darin kannst Du"
                 +" bestimmt einige nuetzliche Dinge unterbringen."));
  SetProp(P_INFO, BS("Du bemerkst die auffaellige Guertelschnalle. Sie scheint nicht"
                    +" aus Metall zu bestehen und magisch von innen zu leuchten."));
  AddDetail(({"guertelschnalle", "schnalle"}), BS(
            "Die Guertelschnalle besteht aus einem wertvollen Edelstein."));
  AddDetail(({"edelstein", "rubin"}), BS("Die Schnalle ist aus Rubin."));
  AddDetail("leuchten", BS("Das Leuchten wehrt sich besonders gegen Blitze."));
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp(P_WEIGHT, 400);
  SetProp(P_WEIGHT_PERCENT, 60);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 90, MAT_RUBY: 10]));
  SetProp(P_AC, 3);
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 800);
  SetProp(P_DAM_PROTECTION, ({ DT_LIGHTNING }));
  SetProp(P_WORN_TEXT, "umgeschnallt");
  SetProp(P_WEAR_TEXT, ({"Du schnallst Dir den Guertel um die Hueften.\n",
                         " schnallt sich einen Guertel um die Hueften.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du schnallst Dir den Guertel ab.\n",
                           " schnallt sich einen Guertel ab.\n"}));
  AddId("guertel");
}

init()
{
  container::init();
  armour::init();
}

varargs string long() {
  string descr, inv_descr;

  descr = process_string(armour::long());
  if(!QueryProp(P_TRANSPARENT)) return descr;

  inv_descr = make_invlist(TP, all_inventory(TO), 0);
  if ( inv_descr != "" )
    descr += capitalize(QueryPronoun()) + " enthaelt:\n" + inv_descr;
  return descr;
}

string short()
{
  string s;
  if (!(s=QueryProp(P_SHORT)) || QueryProp(P_INVIS)) return 0;
  return s+(QueryProp(P_WORN) ?
    " ("+(QueryProp(P_WORN_TEXT) || "getragen")+").\n":".\n");
}

varargs int remove(int silent)
{
  DoUnwear(silent);
  if (!QueryProp(P_WORN))
    return container::remove(silent);
}

varargs move(mixed dest, int method)
{
  DoUnwear(method & M_SILENT);
  if ((method & M_NOCHECK) || (!QueryProp(P_WORN)))
    return ::move(dest, method);
}

