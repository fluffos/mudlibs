inherit "std/armour";

#include <armour.h>
#include <combat.h>
#include <language.h>
#include <properties.h>
#include "../files.h"

#define SPEC_MAT ({ MAT_RUBY, MAT_DIAMOND, MAT_SAPPHIRE, MAT_OPAL, \
                    MAT_EMERALD, MAT_AMETHYST })

#define MATMSTR "p/daemon/materialdb"

create()
{
  int r;
  string s;
  
  if (!is_clone(TO))
    return;
  ::create();

  r=random(100)%6;
  s=MATMSTR->MaterialName(SPEC_MAT[r], 0, 100);
  SetProp(P_NAME, s+"ring");
  SetProp(P_SHORT, "Ein "+s+"ring");
  SetProp(P_LONG, BS(
          "Das ist ein wertvoller Ring mit einem schoenen "+MATMSTR->MaterialName(SPEC_MAT[r], WEM, 100)+"."));
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 650+random(r*100));
  SetProp(P_AC, 1+r/2);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_MATERIAL, ([ MAT_GOLD:100-r, SPEC_MAT[r]:r ]));
  AddId("ring");
  AddId(lower_case(s)+"ring");
  SetProp(P_WEIGHT, 50+random(r*10));
  if (!random(100)%4)
    SetProp(P_CURSED, 1);
}

