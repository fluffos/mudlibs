inherit "std/armour";

#include <combat.h>
#include <properties.h>
#include <language.h>
#include <armour.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(TO))
    return;

  ::create();

  SetProp(P_SHORT, "Eine Moenchskutte");
  SetProp(P_LONG, BS(
          "Eine Moenchskutte aus grober Baumwolle scheint nicht sehr"
         +" Schutz zu bieten."));
  SetProp(P_VALUE, 400);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Moenchskutte");
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_COTTON:95, MAT_CLOTH:5]));
  SetProp(P_WEIGHT, 500);
  AddId("kutte");
  AddId("moenchskutte");
}

