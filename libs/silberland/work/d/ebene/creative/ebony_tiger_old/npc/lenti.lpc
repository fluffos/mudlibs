#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("dieb");

create()
{
  object w;

  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Lenti");
  AddId("lenti");
  SetProp(P_SHORT, "Lenti, der Dieb");
  SetProp(P_ALIGN, -400);
  SetProp(P_LONG, BS(
          "Das ist Lenti der kleine heimtueckische perdruinesische Dieb. Er hat an"
	 +" seinem Guertel einen kleinen Schluesselbund befestigt."));
  SetProp(P_ARTICLE, 0);
  (w=present("Waffe", TO));
  w->DoUnwield(1);
  w->remove();
  clone_object(WEAPON("lmesser"))->move(TO);
  command_me("zuecke messer");
}

