
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../files.h"

create()
{
  object ob;

  ::create();
  AddId("nermal");
  AddId("kaetzchen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_NAME, "Nermal");
  SetProp (P_SHORT, "Nermal, das kleine Kaetzchen");
  SetProp(P_RACE, "Katze");
  SetProp (P_LONG, BS(
           "Das ist Nermal, das nervige kleine Kaetzchen, das einfach immer nur"
          +" suess ist. Es ist winzig klein und hat niedliche Streifen auf seinem"
          +" Ruecken."));
  AddDetail(({"ruecken", "streifen"}), BS(
            "Auf dem Ruecken des Kaetzchens befinden sich niedliche braune"
           +" Streifen."));
  create_default_npc(5);
  seteuid(getuid(TO));
  SetProp(P_DEFAULT_INFO, "miaut sanft und hebt dabei seine Augenbrauen.\n");
  SetProp(P_HANDS, ({" mit winzigen Krallen", 45, DT_RIP}) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Nermal miaut fragend.\n" }) );
  SetProp(P_MNPC_AREA, ROOM(""));
  SetProp(P_MNPC_WAIT, ({ 15, 10, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("l3"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 900);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  while(find_call_out("react")!=-1) ;
  switch (gruppe) {
    case "fies":
      call_out("react", 0, TP, "miaut traurig", "miaut traurig"); break;
    case "frech":
      call_out("react", 0, TP, "schnurrt ganz ganz leise", "schnurrt sehr leise"); break;
    case "traurig":
      call_out("react", 0, TP, "streicht sanft um Deine Beine", "troestet "+TPN); break;
    case "neutral":
      call_out("react", 0, TP, "miaut sanft und schlaegt die Augenbrauen hoch", "miaut sanft und schlaegt die Augenbrauen hoch"); break;
    case "nett":
      call_out("react", 0, TP, "schnurrt Dich zufrieden an", "schnurrt "+TPN+" an"); break;
    case "albern":
      call_out("react", 0, TP, "huepft erfreut umher", "huepft erfreut umher"); break;
    case "aengstlich":
      call_out("react", 0, TP, "fiept leise", "fiept leise"); break;
    case "intim":
      call_out("react", 0, TP, "schmiegt sich kuschlig an Dich an", "schmiegt sich an "+TPN+" an"); break;
    case "froh":
      call_out("react", 0, TP, "legt den Kopf schief und schnurrt", "legt den Kopf schief und schnurrt"); break;
    case "aergerlich":
      call_out("react", 0, TP, "schnurrt sanft", "schnurrt "+TPN+" sanft an"); break;
  }
}

void react(object to, string vic, string oth)
{
  if (present(to, ENV(TO))) {
    tell_object(to, BS(Name(WER, 1)+" "+vic+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+oth+"."), ({to}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

