#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("dieb");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Argax");
  AddId("argax");
  SetProp(P_SHORT, "Argax, der Dieb");
  SetProp(P_ALIGN, -100);
  SetProp(P_LONG, BS(
          "Das ist Argax der kleine heimtueckische Dieb. Er hat an seinem Guertel"
         +" einen kleinen Schluesselbund befestigt."));
  SetProp(P_ARTICLE, 0);
  clone_object(ARMOUR("schuhe"))->move(TO);
  command_me("ziehe schuhe an");
}

