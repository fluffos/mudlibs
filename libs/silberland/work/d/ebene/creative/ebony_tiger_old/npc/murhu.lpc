#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("wache");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Murhu");
  AddId("murhu");
  AddId("waechter");
  SetProp(P_SHORT, "Murhu, der Waechter");
  SetProp(P_ALIGN, 100);
  SetProp(P_LONG, BS(
          "Das ist Murhu, ein Waechter der Diebesgilde. Er hat an seinem Guertel"
         +" einen grossen Schluesselbund befestigt."));
  SetProp(P_ARTICLE, 0);
  AddLibrary(NPC("npc.lib"), 2, 1);
  clone_object(ARMOUR("guertel"))->move(TO);
  command_me("ziehe guertel an");
}

