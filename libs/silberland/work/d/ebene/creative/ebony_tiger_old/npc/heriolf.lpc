#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../files.h"

inherit STD("dieb");

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Heriolf, der geldgierige Trinkhallenbesitzer");
  SetProp(P_LONG, BS(
          "Heriolf der geldgierige Trinkhallenbesitzer ist zwar an sich"
         +" geldgierig, aber er hat trotzdem vernuenftige Preise. An seinem"
         +" Guertel haengt neben dem Handtuch zum Trocknen der Glaeser noch"
         +" ein Schluesselbund."));
  SetProp(P_WEIGHT, 110000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Heriolf");
  SetProp(P_ALIGN, 200);
  SetProp(P_MNPC_FLAGS, 0);
  SetProp(P_MAX_HELPERS, 0);
  SetProp(P_HELPERS, 0);
  SetProp(P_GENDER, MALE);
  AddLibrary(NPC("npc.lib"), 3, 1);
  AddId(({"wirt", "heriolf", "herio\lf"}));
}

