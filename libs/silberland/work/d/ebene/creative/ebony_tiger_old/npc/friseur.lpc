#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

inherit "std/npc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Birn, der Friseur");
  SetProp(P_LONG, BS(
      "Birn ist wahrlich ein Meister seines Fachs. Er kann mit"
     +" der Schere und dem Rasiermesser umgehen wie kein Zweiter."));
  SetProp(P_WEIGHT, 110000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Birn");
  SetProp(P_GENDER, MALE);
  AddId(({"friseur", "birn", "\nfriseur"}));
  create_default_npc(25);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_MAX_SP, 850);
  SetProp(P_SPELLRATE, 60);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 150);
  SetProp(P_DEFAULT_INFO, "klappert uninteressiert mit seiner Schere.\n");
 
  SetProp(P_HANDS, ({" mit der spitzen Schere und einem Rasiermesser", 140, DT_PIERCE}));
  
  AddSpell(2, 450, BS(
           "Birn schuettet Dir sein schaerfstes Rasierwasser ins Gesicht."), BS(
	   "Birn schuettet @WEM sein schaerfstes Rasierwasser ins Gesicht."),
	   DT_ACID, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(5, 600, BS(
           "Birn schnippelt Dir eine kleine Punkerfrisur, ARGH!"), BS(
	   "Birn schnippelt an @WEM herum und schafft eine kleine Punkfrisur."),
	   DT_TERROR, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_COLD:-0.7, DT_WATER:-0.6, DT_FIRE:0.1 ]));
  seteuid(getuid(this_object()));
  AddLibrary(NPC("npc.lib"), 2, 1);

  clone_object(ARMOUR("schuerze"))->move(TO);
  command_me("trage schuerze");
}

