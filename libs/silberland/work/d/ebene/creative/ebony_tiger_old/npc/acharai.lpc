#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("wache");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Acharai");
  AddId("acharai");
  AddId("waechter");
  SetProp(P_SHORT, "Acharai, der Waechter");
  SetProp(P_ALIGN, 300);
  SetProp(P_LONG, BS(
          "Das ist Acharai, ein Waechter der Diebesgilde. Er hat an seinem Guertel"
         +" einen grossen Schluesselbund befestigt."));
  SetProp(P_ARTICLE, 0);
  AddLibrary(NPC("npc.lib"), 1, 1);
  (clone_object(WEAPON("speer")))->move(TO);
  command_me("zuecke speer");
}

