#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

inherit "std/npc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Tarion der Sklave");
  SetProp(P_LONG, BS(
      "Tarion der Sklave hat den ganzen Tag nichts anderes zu"
     +" tun als fuer das Wasser in den Raeumen der Gilde zu sorgen."
     +" Er ist riesengross, und baerenstark. Seine Kraefte braucht"
     +" er auch um die gewaltige Kurbel drehen zu koennen."));
  SetProp(P_WEIGHT, 280000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Tarion");
  SetProp(P_GENDER, MALE);
  AddId(({"sklave", "tarion"}));
  create_default_npc(20);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 270);
  SetAttribute(A_STR, 45);
  SetProp(P_DEFAULT_INFO, "laesst sich beim Drehen der Kurbel nicht stoeren.\n");
  SetProp(P_RESISTANCE, ({ DT_WATER }));

  SetChats(2, ({"Tarion stoehnt laut.\n",
                "Der Sklave dreht unter gewaltiger Anstrengung an der Kurbel.\n",
                "Tarion aechzt.\n",
                "Tarion murmelt: 'Wann bin ich endlich erloest'\n",
                "Die Muskeln von Tarion beeindrucken Dich.\n"}));
  seteuid(getuid(this_object()));

  clone_object(ARMOUR("schurz"))->move(TO);
  command_me("trage schurz");
}

