#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("wache");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Illuan");
  AddId("illuan");
  AddId("waechter");
  SetProp(P_SHORT, "Illuan, der Waechter");
  SetProp(P_ALIGN, 400);
  SetProp(P_LONG, BS(
          "Das ist Illuan, ein Waechter der Diebesgilde. Er hat an seinem Guertel"
         +" einen grossen Schluesselbund befestigt."));
  SetProp(P_ARTICLE, 0);
  AddLibrary(NPC("npc.lib"), 2, 1);
  clone_object(WEAPON("keule"))->move(TO);
  command_me("zuecke keule");
}

