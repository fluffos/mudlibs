#include <language.h>
#include <properties.h>
#include "../files.h"

inherit STD("dieb");

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_NAME, "Streawe");
  AddId("streawe");
  SetProp(P_SHORT, "Streawe, der Dieb");
  SetProp(P_LONG, BS(
          "Das ist Streawe der kleine heimtueckische predruinesische Dieb. Er hat an"
	 +" seinem Guertel einen kleinen Schluesselbund befestigt."));
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HELPERS, 2);
  SetProp(P_HELPERS, QueryProp(P_MAX_HELPERS));
  clone_object(ARMOUR("umhang"))->move(TO);
  command_me("ziehe umhang an");
}

