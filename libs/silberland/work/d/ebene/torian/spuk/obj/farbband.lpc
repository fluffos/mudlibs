inherit "std/thing";

#include <properties.h>
#include "../def.h"

string owner;

create() {
  if (!is_clone(TO)) return;
  ::create();

  owner = 0;

  SetProp( P_SHORT,"Ein Farbband");
  SetProp( P_LONG,
   "Ein Farbband fuer eine Schreibmaschine. Es sieht verblichen aus. Ob man "
   "damit noch schreiben kann?");

  SetProp( P_NAME, "Farbband");
  AddId( ({"farbband", "band", FARBBAND}));
  SetProp( P_INFO, "Dieses Farbband kann man in eine Schreibmaschine "
                   "einbauen.");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_WEIGHT, 0);
  SetProp( P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp( P_NODROP, "Das Farbband kannst Du bestimmt noch irgendwo verwenden.\n"
                    +"Wenn Du sie dennoch loswerden willst tippe: "
                    +"<zerstoere farbband>\n");
  SetProp( P_MATERIAL, ([MAT_MISC_SOLID:100]) );

  AddDetail( ({ "schreibmaschinen", "schreibmaschine" }),
    "Wo koennte bloss eine sein?");

  AddCmd( ({ "zerstoere"}), "cmd_zerstoeren" );

}

int cmd_zerstoeren(string str )
{
  notify_fail( "Was willst Du zerstoeren?\n" );
  if(!str || !id(str)) return 0;

  write(BS("Du zerreist das Farbband."));
  ENV(TP)->Message(BS(TP->Name()+" zerreist ein Farbband."), 
                   MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TO->remove(1);
  return 1;
}

void SetOwner(string player)
{
  owner = player;
  return;
}

void init()
{
  if (!is_clone(TO)) return;
  ::init();

  if(!owner && (ENV(TO)==TP))
  {
    write(BS("Das Farbband kann Dir nicht mehr helfen. Daher wirfst Du den "
    "unnoetigen Ballast einfach weg."));
    TO->remove(1);
  }

  return;
}

string QueryOwner()
{
  return owner;
}

// Item seinen Besitzer wiedergeben koennen
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(dest->id(owner)) method = method | M_NOCHECK;
  }

  return ::move(dest, method);
}
