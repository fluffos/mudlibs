#include "../def.h"

inherit "std/thing";

//--Variablen&Defines------------------------------------------------------
string owner;

//--Prototypen-------------------------------------------------------------
string QueryOwner();
int SequenceMutter(object player);
int SequenceBruder(object player);
int SequenceSchwester(object player);

//--Create-----------------------------------------------------------------

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Initialisierungen------------------------------------------------------

  owner = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein alter loechriger Teddy");
  SetProp(P_LONG, "Ein alter loechriger Teddy. Es tut Dir ein wenig leid, "
  "ihn in solch einem Zustand zu sehen. Er wurde frueher bestimmt "
  "gepflegt und geliebt.");
  SetProp(P_INFO, "Wenn Du den urspruenglichen Besitzer gefunden hast, "
                 +"kannst Du den Teddy ueberreichen, auch "
                 +"wenn Du ihn nicht siehst.\n<ueberreiche teddy an ...>");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Teddy");
  SetProp(P_NAME_ADJ, "alt");
  AddAdjective( ({ "alter", "alten" } ));
  SetProp(P_GENDER, MALE);
  AddId( ({ "teddy", TEDDY }) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 32);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp( P_NODROP, "Den Teddy kannst Du bestimmt noch irgendwo verwenden.\n"
                    +"Wenn Du sie dennoch loswerden willst tippe: "
                    +"<zerstoere teddy>\n");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "pfleg", "pflege" }), "pflegen" );
  AddCmd( ({ "lieb", "liebe" }), "lieben" );
  AddCmd( ({ "knuddel", "knuddl", "knuddle", "knuddele" }), "knuddeln" );
  AddCmd( ({ "drueck", "druecke" }), "druecken" );
  AddCmd( ({ "wein", "weine" }), "weinen" );
  AddCmd( ({ "kuschl", "kuschle", "kuschel", "kuschele" }), "kuscheln" );
  AddCmd( ({ "wuschl", "wuschle", "wuschel", "wuschele" }), "wuscheln" );
  AddCmd( ({ "zerstoere"}), "cmd_zerstoeren" );
  AddCmd( ({ "ueberreiche", "ueberreiche"}), "cmd_ueberreichen" );

//--Create Ende------------------------------------------------------------

}

//--Funktionen----------------------------------------------------------
int cmd_zerstoeren(string str )
{
  notify_fail( "Was willst Du zerstoeren?\n" );
  if(!str || !id(str)) return 0;

  write(BS("Du wirfst den Teddy auf den Boden und springst wie ein wilder auf "
          +"ihm herum bis nichts mehr uebrig ist!"));
  ENV(TP)->Message(BS(TP->Name()+" wirft einen Teddy auf den Boden und "
          +"trampelt auf ihm herum bis nichts mehr uebrig ist!"),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TO->remove(1);
  return 1;
}
//pflegen:
int pflegen(string str)
{
  notify_fail("Wen moechtest Du Pflegen?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(BS("Du buerstest und putzt den kleinen Teddy, viel hilft es leider"
  " nicht."));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" versucht "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" Teddy zu buersten "
  +"und zu putzen."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
//lieben:
int lieben(string str)
{
  notify_fail("Wen hast Du lieb?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(BS("Aeh ... Du koenntest es mit knuddeln/kuscheln/druecken oder "
  +"wuscheln probieren. Du kannst Dich auch bei ihm ausweinen."));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" schaut "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" Teddy liebevoll an."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//knuddeln:
int knuddeln(string str)
{
  notify_fail("Wen moechtest Du knuddeln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(BS("Du knuddelst den kleinen Teddy liebevoll."));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" knuddelt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" Teddy liebevoll."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//druecken:
int druecken(string str)
{
  notify_fail("Wen willst Du an Dich druecken?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du drueckst Deinen Teddy fest an Dich.\n"
  +"Gluecklich schmiegt sich der kleine Teddy an Dich an.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" drueckt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" Teddy fest an sich."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//weinen:
int weinen(string str)
{
  notify_fail("Bei wem willst Du Dich ausweinen?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du weinst Dich bei Deinem Teddy aus.\n"
   +"Troestend kuschelt sich der kleine Teddy an Dich an.\n",
      78, 0, BS_LEAVE_MY_LFS));
  ENV(TP)->Message(BS(TP->Name(WER, 1)+" weint sich bei "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" Teddy aus."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//kuscheln:
int kuscheln(string str)
{
  notify_fail("An wen willst Du Dich ankuscheln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du kuschelst Dich an Deinen Teddy an.\n"
  +"Der kleine Teddy blinzelt Dir erfreut zu.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" kuschelt sich an "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinen": "ihren")+" Teddy an."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

//wuscheln:
int wuscheln(string str)
{
  notify_fail("Wen willst Du denn wuscheln?\n");

  if(!str || str == "") return 0;

  if(!id(str)) return 0;

  write(break_string("Du verwuschelst Deinem kleinen Teddy die "
  +"Haare.\nDer kleine Teddy schaut Dich empoert an.\n",
  78, 0, BS_LEAVE_MY_LFS));

  ENV(TP)->Message(BS(TP->Name(WER, 1)+" verwuschelt "
  +(TP->QueryProp(P_GENDER) == MALE ? "seinem": "ihrem")+" Teddy die Haare."),
  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

int cmd_ueberreichen(string str )
{
  string file, wem, was, roomname;
  int laenge;
  notify_fail( "Was willst Du Wem ueberreichen?\n" );
  if(!str) return 0;
  if(sscanf(str,"%s an %s", was, wem) != 2) return 0;

  if(!TO->id(was)) return (notify_fail("WAS willst Du ueberreichen?\n") ,0);

  if(QueryOwner() != getuid(TP))
  {
    write(BS("Wie kommst Du denn an den Teddy von "+CAP(QueryOwner())
            +"? Du solltest schon Deinen eigenen Teddy ueberreichen!"));
    return -1;
  }

  // Befinden wir uns im richtigen Raum?
  file = file_name(ENV(TP));
  laenge = strlen(ROOM);
  if (file[0..laenge-1]!= ROOM )
  {
    write(BS("Du solltest Dich schon in dem Spukhaus befinden dafuer!"));
    return -1;
  }

  if(wem == "geist")
  {
    write(BS("In diesem Haus gibt es viele Geister, welchen meinst Du genau?"));
    return -1;
  }

  if(wem == "mutter")
  {
    if(file_name(ENV(TP))!="/d/ebene/torian/spuk/room/schlafzimmer")
    {
      write(BS("Diesen Geist findest Du hier nicht!"));
      return -1;
    }

    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:60,
      PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
      PARALYZE_MSG_OTHER:"%s steht wie erstarrt da.\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));

    write(BS("Du haelst den Teddy in die Hoehe und tatsaechlich erscheint "
            +"der Geist der Mutter und nimmt ihn Dir aus der Hand."));
    ENV(TP)->Message(BS(TP->Name()+" haelt einen Teddy in die Hoehe der "
            +"ploetzlich verschwindet."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    SPUKMASTER->Msg(TP->Name()+" uebergibt den Teddy an die Mutter", QUEST);

    SequenceMutter(TP);

    TO->remove(1);

    return 1;
  }

  if(wem == "tochter" || wem == "schwester" || wem == "maedchen")
  {
    if(file_name(ENV(TP))!="/d/ebene/torian/spuk/room/schwesterzi")
    {
      write(BS("Diesen Geist findest Du hier nicht!"));
      return -1;
    }

    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:60,
      PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
      PARALYZE_MSG_OTHER:"%s steht wie erstarrt da.\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));

    write(BS("Du haelst den Teddy in die Hoehe und tatsaechlich erscheint "
            +"der Geist der Schwester und nimmt ihn Dir vor Freude "
            +"strahlend aus der Hand."));
    ENV(TP)->Message(BS(TP->Name()+" haelt einen Teddy in die Hoehe, der "
            +"ploetzlich verschwindet."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    SPUKMASTER->Msg(TP->Name()+" uebergibt den Teddy an die Schwester", QUEST);

    SequenceSchwester(TP);

    TO->remove(1);

    return 1;
  }

  if(wem == "sohn" || wem == "bruder")
  {

    if(file_name(ENV(TP))!="/d/ebene/torian/spuk/room/bruderzi")
    {
      say("ENF(TP): "+file_name(ENV(TP))+"\n");
      write(BS("Diesen Geist findest Du hier nicht!"));
      return -1;
    }

    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:60,
      PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
      PARALYZE_MSG_OTHER:"%s steht wie erstarrt da.\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));

    write(BS("Du haelst den Teddy in die Hoehe und tatsaechlich erscheint "
            +"der Geist des Bruders und nimmt ihn Dir mit boshaftem "
            +"Lachen aus der Hand.!"));
    ENV(TP)->Message(BS(TP->Name()+" haelt einen Teddy in die Hoehe der "
            +"ploetzlich verschwindet."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    SPUKMASTER->Msg(TP->Name()+" uebergibt den Teddy an den Bruder", QUEST);

    SequenceBruder(TP);

    TO->remove(1);

    return 1;
  }

  return 0;
}

//--Sonstige Funktionen-----------------------------------------------------
void SetOwner(string player)
{
  owner = player;
  return;
}

void init()
{
  if (!is_clone(TO)) return;
  ::init();

  if(!owner && (ENV(TO)==TP) )
  {
    write(BS("Ausversehen laesst Du den Teddy fallen. Aus den Augen aus "
    "dem Sinn."));
    TO->remove(1);
  }

  return;
}

string QueryOwner()
{
  return owner;
}

// Item seinen Besitzer wiedergeben koennen
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(dest->id(owner)) method = method | M_NOCHECK;
  }

  return ::move(dest, method);
}


int SequenceMutter(object player)
{
  if (player)
  {
    // Xp Bonus fuer den laengsten Teil
    if(!player->QueryQuest(QUESTNAME))
      player->SetProp(P_XP, player->QueryProp(P_XP)+50000);
    
    SPUKMASTER->sequencer(player, 0, ({
  0, "Alles wird weiss vor Deinen Augen ...",
  4, "#Kaelte ... Dir wird kalt ...",
  0, "*QuestFertig"
    }), find_object(SPUKMASTER));
  }
  return 1;
}

int SequenceBruder(object player)
{
  if (player)
  {
    SPUKMASTER->sequencer(player, 0, ({
  0, "Alles wird weiss vor Deinen Augen ...",
  4, "#Kaelte ... Dir wird kalt ...",
  0, "*QuestFertig"
    }), find_object(SPUKMASTER));
  }
  return 1;
}

int SequenceSchwester(object player)
{
  if (player)
  {
    SPUKMASTER->sequencer(player, 0, ({
  0, "Alles wird weiss vor Deinen Augen ...",
  4, "#Kaelte ... Dir wird kalt ...",
  0, "*QuestFertig"
    }), find_object(SPUKMASTER));
  }
  return 1;
}