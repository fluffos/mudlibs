inherit "std/thing";

#include <properties.h>
#include "../def.h"

string owner;

create() {
  if (!is_clone(TO)) return;
  ::create();

  owner = 0;

  SetProp( P_SHORT,"Ein Holzklotz");
  SetProp( P_LONG,
   "Ein Holzklotz mit einem grossen aufgemalten Buchstaben.");

  SetProp( P_NAME, "Holzklotz");
  AddId( ({"klotz", "holzklotz", KLOTZ, "l"}));
  SetProp( P_INFO, "Was man mit diesem Buchstaben wohl anfangen koennte...");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_WEIGHT, 0);
  SetProp( P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp( P_NODROP, "Den Buchstaben kannst Du bestimmt noch irgendwo verwenden.\n"
                    +"Wenn Du ihn dennoch loswerden willst tippe: "
                    +"<zerstoere buchstabe>\n");
  SetProp( P_MATERIAL, ([MAT_MISC_SOLID:100]) );

  AddDetail( ({ "buchstaben", "buchstabe" }),
    "Du siehst ein grosses aufgemaltes L.");

  AddCmd( ({ "zerstoere"}), "cmd_zerstoeren" );

}

int cmd_zerstoeren(string str )
{
  notify_fail( "Was willst Du zerstoeren?\n" );
  if(!str || !id(str)) return 0;

  write(BS("Du trampelst auf dem Buchstaben herum bis nichts mehr zu sehen ist."));
  ENV(TP)->Message(BS(TP->Name()+" trampelt auf einem Holzklotz herum bis nichts mehr "
         +"zu sehen ist."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TO->remove(1);
  return 1;
}

void SetOwner(string player)
{
  owner = player;
  return;
}

void init()
{
  if (!is_clone(TO)) return;
  ::init();

  if(!owner && (ENV(TO)==TP))
  {
    write(BS("Hoppla, der Holzklotz ist Dir runter und ausser Sicht gefallen."));
    TO->remove(1);
  }

  return;
}

string QueryOwner()
{
  return owner;
}

// Item seinen Besitzer wiedergeben koennen
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(dest->id(owner)) method = method | M_NOCHECK;
  }

  return ::move(dest, method);
}
