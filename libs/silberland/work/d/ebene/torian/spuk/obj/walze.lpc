inherit "std/thing";

#include <properties.h>
#include "../def.h"

string owner;

create() {
  if (!is_clone(TO)) return;
  ::create();

  owner = 0;

  SetProp( P_SHORT,"Eine alte Schreibwalze");
  SetProp( P_LONG,
   "Dies ist eine alte Schreibwalze, wie sie in Schreibmaschinen Verwendung "
   "findet. Obwohl ihr Zustand nicht mehr der beste ist, duerfte sie ihren "
   "Zweck noch erfuellen.");

  SetProp( P_NAME, "Schreibwalze");
  AddId( ({"schreibwalze", "walze", WALZE}));
  SetProp( P_INFO, "Diese Schreibwalze kann man in eine Schreibmaschine "
                   "einbauen.");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 0);
  SetProp( P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp( P_NODROP, "Die Walze kannst Du bestimmt noch irgendwo verwenden.\n"
                    +"Wenn Du sie dennoch loswerden willst tippe: "
                    +"<zerstoere walze>\n");
  SetProp( P_MATERIAL, ([MAT_MISC_SOLID:100]) );

  AddDetail( ({ "schreibmaschinen", "schreibmaschine" }),
    "Wo koennte bloss eine sein?");
  AddDetail( ({ "verwendung" }),
    "Solch eine Schreibwalze findet in Schreibmaschinen Verwendung.");
  AddDetail( ({ "zustand", "zeit" }),
    "Sie ist alt und rissig. Woraus sie besteht, ist nach all der Zeit nicht mehr "
    "zu erkennen.");
  AddDetail( ({ "zweck", "unterlage", "papier" }),
    "Sie dient als Unterlage fuer das Papier, auf dem schlussendlich geschrieben wird.");

  AddCmd( ({ "zerstoere"}), "cmd_zerstoeren" );

}

int cmd_zerstoeren(string str )
{
  notify_fail( "Was willst Du zerstoeren?\n" );
  if(!str || !id(str)) return 0;

  write(BS("Du wirfst die Walze auf den Boden. Sie zerspringt in tausend Stuecke!"));
  ENV(TP)->Message(BS(TP->Name()+" wirft eine Walze auf den Boden. Sie zerspringt in "
                       +"tausend Stuecke!"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TO->remove(1);
  return 1;
}

void SetOwner(string player)
{
  owner = player;
  return;
}

void init()
{
  if (!is_clone(TO)) return;
  ::init();

  if(!owner && (ENV(TO)==TP))
  {
    write(BS("Ausversehen laesst Du die Walze fallen. Sie zerspringt in tausend "
            +"Stuecke!"));
    TO->remove(1);
  }

  return;
}

string QueryOwner()
{
  return owner;
}

// Item seinen Besitzer wiedergeben koennen
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(dest->id(owner)) method = method | M_NOCHECK;
  }

  return ::move(dest, method);
}
