inherit "std/thing";

#include <properties.h>
#include "../def.h"

string owner;

create() {
  if (!is_clone(TO)) return;
  ::create();

  owner = 0;

  SetProp( P_SHORT,"Eine paar Tasten");
  SetProp( P_LONG,
   "Die Tasten fuer einige Buchstaben. Ihr angestammter Platz ist in "
   "einer Schreibmaschine.");

  SetProp( P_NAME, "Tasten");
  AddId( ({"tasten", "buchstaben", TASTEN}));
  SetProp( P_INFO, "Diese Tasten kann man in eine Schreibmaschine "
                   "einbauen.");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 0);
  SetProp( P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp( P_NODROP, "Die Tasten kannst Du bestimmt noch irgendwo verwenden.\n"
                    +"Wenn Du sie dennoch loswerden willst tippe: "
                    +"<zerstoere tasten>\n");
  SetProp( P_MATERIAL, ([MAT_MISC_SOLID:100]) );

  AddDetail( ({ "schreibmaschinen", "schreibmaschine" }),
    "Wo koennte bloss eine sein?");
  AddDetail( ({ "platz"}),
    "Ihr Platz ist in einer Schreibmaschine.");

  AddCmd( ({ "zerstoere"}), "cmd_zerstoeren" );

}

int cmd_zerstoeren(string str )
{
  notify_fail( "Was willst Du zerstoeren?\n" );
  if(!str || !id(str)) return 0;

  write(BS("Du wirfst die Tasten einfach weg."));
  ENV(TP)->Message(BS(TP->Name()+" wirft ein paar Tasten weg."), 
                   MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TO->remove(1);
  return 1;
}

void SetOwner(string player)
{
  owner = player;
  return;
}

void init()
{
  if (!is_clone(TO)) return;
  ::init();

  if(!owner&& (ENV(TO)==TP))
  {
    write(BS("Du wirfst die Tasten weg."));
    TO->remove(1);
  }

  return;
}

string QueryOwner()
{
  return owner;
}

// Item seinen Besitzer wiedergeben koennen
varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(dest->id(owner)) method = method | M_NOCHECK;
  }

  return ::move(dest, method);
}
