/*
Im Zimmer des Bruders ...
- kleines bett, holzspielsachen fuer jungs (holzkloetze, holzschwerter etc.)
- ein Buchstabe zwischen den HolzKloetze
Alte Schreibmaschine, davor setzen und was schreiben wollen
-> kaelte im zimmer (als wenn ein Geist (boese) anwesend waere)
   und den Spieler dazu zwingen was zu schreiben
   (ICH IWLL DEN TEDY und so, mit absicht Fehler einbauen, schreibt
   schliesslich ein kleiner wuetender Junge)
-> Schreibmaschine erst reparieren mit 2 Teilen, im Haus verstreut
   Farbband und Buchstaben

Loch inner Wand (greife in loch)
buch neben dem Bett (drunter holzdingens)
Haufen durchsuchen

*/
#include "../def.h"

inherit "std/room";

int Sequence(object player);
int SequenceSchreibmaschine(object player);
message(int msg);

string tasten, schreibwalze, farbband;
status schwert;
status schreibmaschine;
void create()
{
  ::create();

  schwert = DA;
  tasten = schreibwalze = farbband = WEG;
  schreibmaschine = DA;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Zimmer");
  SetProp(P_INT_LONG,
    "Dies war offensichtlich das Zimmer eines kleinen Jungen. Ueberall "
    "verstreut liegen Holzfiguren auf dem Boden herum. An der Wand steht "
    "ein kleines Bett. Ausserdem siehst Du einen kleinen Tisch mit einer "
    "Schreibmaschine darauf."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, QUEST);
  SetProp(P_INDOORS, QUEST);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "zimmer", "kinderzimmer" }), QueryProp(P_INT_LONG)
  );
  AddDetail( ({ "jungen", "junge" }),
    "Sehen kannst Du ihn nicht. So staubig und verfallen, wie das Zimmer "
    "aussieht, war er auch schon lange nicht mehr hier."
  );
  AddDetail( ({ "holzfiguren", "figuren" }),
    "Die verschiedensten Holzfiguren liegen auf dem Boden verstreut. "
    "Ritter und Drachen kannst Du erkennen, sogar ein Fraggle ist dabei. "
    "In einer der hinteren Ecken befindet sich ein grosser Haufen Holzkloetze."
  );
  AddDetail( ({ "haufen" }),
    "Ein grosser Haufen Holzkloetze. Sie sind sehr ebenmaessig geschnitzt und "
    "sehr glatt. Sich an ihnen einen Splitter einzufangen ist nahezu unmoeglich."
  );
  AddDetail( ({ "splitter", "holzsplitter" }),
    "Es ist nahezu unmoeglich, sich an diesen Kloetzen einen Holzsplitter "
    "einzufangen. Damit sind sie das perfekte Spielzeug fuer kleine Kinder."
  );
  AddDetail( ({ "spielzeug", "kind" }),
    "Fast jedes Kind hatte so etwas."
  );
  AddDetail( ({ "kinder" }),
    "Sehen kannst Du keines."
  );
  AddDetail( ({ "holzkloetze", "kloetze" }),
    "Sie sind sehr ebenmaessig und sehr glatt. Du kannst die typische Maserung, "
    "die fuer den Ogerwald ueblich ist, erkennen."
  );
  AddDetail( ({ "maserung", "ogerwald", "wald", "holz" }),
    "Offensichtlich stammt das Holz aus dem Ogerwald."
  );
  AddDetail( ({ "ecken" }),
    "In einer der hinteren Ecken befindet sich ein grosser Haufen Holzkloetze."
  );
  AddDetail( ({ "ritter" }),
    "Ein paar Ritter mit Schwert und Schild liegen herum."
  );
  AddDetail( ({ "schwert", "schild", "holzstueck" }),
    "Die Figuren wurden aus einem einzigen Holzstueck gefertigt. Schild und "
    "Schwert wurden nicht nachtraeglich angebracht. So etwas verlangt schon "
    "ein gewisses Handwerksgeschick."
  );
  AddDetail( ({ "drachen" }),
    "Ein paar wenige Drachen befinden sich unter den Holzfiguren. Auffaellig ist "
    "nur der eine gelblich schimmernde Drache mit den zerbrochenen Fluegeln."
  );
  AddDetail( ({ "fluegel", "fluegeln" }),
    "Die Fluegel dieses Drachen sind zerbrochen. Warum dem so ist, ist Dir "
    "allerdings nicht klar."
  );
  AddDetail( ({ "drache" }),
    "Mit ein wenig Fantasie koennte das ein goldener Drache sein. Angeblich "
    "lebt ein solcher auf Sturmfels, der Paladinburg."
  );
  AddDetail( ({ "fantasie", "phantasie" }),
    "Der Drache ist sehr stilvoll verarbeitet, es besteht kein Zweifel daran, "
    "was es sein soll. Lediglich die Farbe entspricht nicht mehr dem strahlenden "
    "Gold von einst."
  );
  AddDetail( ({ "farbe", "gold", "gelb" }),
    "Frueher war es sicher ein sattes Gold, jetzt nur noch ein mattes Gelb."
  );
  AddDetail( ({ "zweifel" }),
    "Zweifel hast Du nicht."
  );
  AddDetail( ({ "paladinburg", "burg", "berg", "sturmspitze" }),
    "Die Burg befindet sich im Gebirge, hoch oben auf dem Berg Sturmspitze."
  );
  AddDetail( ({ "namen", "sturmfels", "felsen", "hochebene" }),
    "Die vielen Felsen und das oft sehr zugige Klima gaben der Hochebene "
    "und der Burg ihren Namen: Sturmfels."
  );
  AddDetail( ({ "klima" }),
    "Das Klima im Gebirge ist fuer gewoehnlich sehr rauh."
  );
  AddDetail( ({ "gebirge", "westen" }),
    "Das Gebirge befindet sich weit im Westen von hier."
  );
  AddDetail( ({ "fraggle" }),
    "Er sieht dem Fraggle in Midas erstaunlich aehnlich. Es ueberrascht Dich, "
    "soviel Handwerksgeschick in einem Kinderzimmer zu finden."
  );
  AddDetail( ({ "midas", "menschen", "stadt" }),
    "Midas ist eine Stadt der Menschen, sie befindet sich nicht weit von hier."
  );
  AddDetail( ({ "handwerksgeschick", "geschick" }),
    "Es erfordert viel Geschick, solch eine Holzfigur so lebensnah zu schnitzen."
  );
  AddDetail( ({ "holzfigur", "figur" }),
    "Welche meinst Du denn?"
  );
  AddDetail( ({ "wand", "waende" }),
    "An der Wand steht ein kleines Bett. Die Tuer ins Zimmer wurde eingetreten. "
    "Auch hier bestehen die Waende aus Holzbalken. "
  );
  AddSpecialDetail( ({ "bett" }), "str_bett" );
  AddSpecialDetail( ({ "schwert", "holzschwert" }), "str_schwert" );
  AddSpecialDetail( ({ "tisch" }), "strTisch");
  AddDetail( ({ "stuhl", "stehen" }),
    "Niemand schreibt im Stehen. Fragt sich nur, wo der Stuhl geblieben ist."
  );
  AddSpecialDetail( ({ "schreibmaschine", "maschine" }), "strSchreibmaschine");
  AddDetail( ({ "boden" }),
    "Ueberall auf dem Boden liegen Holzfiguren verstreut. Es gibt dem Zimmer "
    "ein sehr chaotisches Aussehen."
  );
  AddDetail( ({ "aussehen" }),
    "Chaotisch."
  );
  AddDetail( ({ "decke" }),
    "Die Decke besteht ebenso wie die Waende und der Boden aus Holzbalken."
  );
  AddDetail( ({ "staub" }),
    "Staub und Spinnweben gibt es hier ueberall."
  );
  AddDetail( ({ "staubschicht", "unterfangen" }),
    "Hier Staub zu wischen waere ein hoffnungsloses Unterfangen."
  );
  AddDetail( ({ "holzbalken", "holz", "ogerwald" }),
    "Das Holz stammt aus dem Ogerwald."
  );
  AddDetail( ({ "spinnweben", "weben" }),
    "In jeder Ecke findet man sie hier."
  );
  AddDetail( ({ "ecke" }),
    "Wirklich ueberall!"
  );
  AddDetail( ({ "halterung", "halterungen" }),
    "Die Halterungen fuer das Farbband sind ein wenig verbogen. Sie duerften "
    "dennoch ihrer Aufgabe gerecht werden."
  );
  AddDetail( ({ "aufgabe" }),
    "Die Halterungen halten das Farbband."
  );
  AddDetail( ({ "bettdecke", "stueck", "stoffreste" }),
    "Die Bettdecke ist als solche kaum noch zu erkennen. Wuerde sie nicht auf "
    "dem Bett liegen, haettest Du sie nur fuer ein weiteres Stueck Stoffreste gehalten."
  );
  AddSpecialDetail( ({ "farbband", "band" }), "strFarbband");
  AddSpecialDetail( ({ "schreibwalze", "walze" }), "strWalze");
  AddSpecialDetail( ({ "tasten", "buchstaben" }), "strBuchstaben");
  AddDetail( ({ "tuer" }),
    "Die Tuer wurde eingetreten und laesst sich nie wieder schliessen."
  );
  AddDetail( ({ "groesse" }),
    "Die Groesse eines kleinen Kindes."
  );
  AddDetail( ({ "idee" }),
    "Es waere sicher eine gute Idee, einmal unter das Bett zu schauen."
  );
  AddDetail( ({ "unter bett" }),
    "Dort liegt eine kleine Holzfigur. Wie die dort wohl hingekommen ist? "
    "Du haettest keine Probleme, sie mit Deinen Armen zu erreichen und zu nehmen."
  );
  AddDetail( ({ "arme", "armen", "probleme", "problem" }),
    "Deine Arme sind lang genug, um die Holzfigur unter dem Bett zu erreichen."
  );

  AddSound( DEFAULT_SOUND,
    "Du hoerst absolut nichts. Die Stille ist richtig unheimlich."
  );

  AddSound( ({ "stille" }),
    "Sonderlich wohl fuehlst Du Dich nicht dabei.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist erfuellt vom Geruch alter Moebel."
  );

  AddSmell( ({ "luft", "geruch", "waldluft", "moebel" }),
    "Frische Waldluft waere deutlich angenehmer."
  );

  AddRoomMessage(
    ({"Irgendwer ist bei Dir!\n",
      "Jemand ist bei Dir!\n",
      "Du fuehlst Dich beobachtet!\n",
      "Hat sich nicht grade eine der Holzfiguren bewegt??\n",
      "Die Schreibmaschine klappert!\n"}),60,"message");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "wische", "wisch" }), "cmd_wischen" );
  AddCmd( CMD_NEHMEN, "cmd_nehmen" );
  AddCmd( ({ "bau", "baue" }), "cmd_bauen" );
  AddCmd( ({ "lieg", "leg", "liege", "lege" }), "cmd_liegen" );
  AddCmd( ({ "schreib", "schreibe", "tipp", "tippe" }), "cmd_schreiben" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", "in den Flur#" + "./flur" );

}

//--Funktion fuer AddRoomMessage--------------------------------------------

message(int msg)
{
  if (msg > 2)
    if (random(10) < 3)
      Message(BS("Du fuehlst Dich nicht wohl bei der Sache.\n"),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP );
}

//--Funktionen fuer Kommandos----------------------------------------------
int cmd_schreiben(string str)
{
  if(schreibmaschine == WEG)
  {
    write(BS("An der Schreibmaschine schreibt bereits jemand!"));
    return -1;
  }

  if(schreibwalze && farbband && tasten)
  {
    // wenigstens eins der Teile muss vom Spieler stammen
    if(getuid(TP)==schreibwalze || getuid(TP) == farbband ||
       getuid(TP)==tasten)
    {
      if(!SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDER))
      {
        write(BS("Nochmal willst Du Dir das nicht antun ..."));
        return -1;
      }

      write(BS("Du setzt Dich an die Schreibmaschine und beginnst zu tippen."
              +" Ploetzlich verlierst Du die Kontrolle ueber Deinen Koerper "
              +"und jemand anderes tippt an Deiner statt."));
      Message(BS(TP->Name()+" setzt sich vor die Schreibmaschine und beginnt "
                +"zu tippen."),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      schreibmaschine = WEG;
      SPUKMASTER->Msg(TP->Name()+" tippt auf der Schreibmaschine.", QUEST);
      // seq starten, schreibmaschine auseinandernehmen
      TP->SetProp(P_PARALYZED, ([
        PARALYZE_TIME:70,
        PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
        PARALYZE_MSG_OTHER:"%s tippt wild auf der Schreibmaschine.\n",
        PARALYZE_END:"",
        PARALYZE_END_OTHER:""
      ]));

      SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -10]) );
      
      SequenceSchreibmaschine(TP);
      SPUKMASTER->AddPlayerSequence(getuid(TP), BRUDER);
      
      return 1;
    }
    else
    {
      write(BS("Sinnlos tippst Du auf der Schreibmaschine herum. Es "
              +"scheint fast, als wuerde Dich die Schreibmaschine nicht "
              +"akzeptieren."));
      Message(BS(TP->Name()+" tippt sinnlos auf der Schreibmaschine herum."),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      SPUKMASTER->Msg(TP->Name()+" tippt ohne ein Teil eingebaut zu haben", ALL);
      return -1;
    }
  }
  else
  {
    write(BS("So wird das aber nichts, die Schreibmaschine muss schon "
            +"funktionstuechtig sein."));
    SPUKMASTER->Msg(TP->Name()+" tippt auf einer unvollstaendigen "
                   +"Schreibmaschine", ALL);
    return -1;
  }
}

// Auf dem Bett liegen
int cmd_liegen(string str)
{
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf bett" ||
       str == "bett"     ||
       str == "in bett")) return 0;

  write(BS("Du bist viel zu gross und zu schwer fuer das Bett. Alles, was "
          +"Du erreichen wuerdest, waere das es kaputt geht."));
  SPUKMASTER->Msg(TP->Name()+" versucht sich aufs Bett des Bruders zu legen", ALL);
  return 1;
}

cmd_wischen(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staubschicht","staub weg","staubschicht weg"}),str))
  { return 0; }
  write(BS("Deine Versuche, den Staub wegzuwischen, lassen sich nur mit einem Wort "
         +"beschreiben. Hoffnungslos!"));
  Message(BS(TP->Name()+" wirbelt etwas Staub auf, der sich jedoch gleich wieder "
            +"legt."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  SPUKMASTER->Msg(TP->Name()+" wischt Staub im Zimmer des Bruders", ALL);

  return 1;
}

// Schreibmaschine zusammensetzen
cmd_bauen(string str )
{
  string was;
  object ob;

  notify_fail( "Willst Du etwas in die Schreibmaschine einbauen?\n" );

  if(!str)  return 0;
  if(sscanf(str,"%s in schreibmaschine ein", was) != 1) return 0;

  ob = present(was, TP);
  if(!ob)
  {
    write(BS(CAP(was)+" besitzt Du doch gar nicht!"));
    return -1;
  }

  if((was == "walze" || was == "schreibwalze") && ob->id(WALZE))
  {
    if(schreibwalze)
    {
      if(schreibwalze == getuid(TP))
      {
        write(BS("Aber Du hast die Schreibwalze bereits eingebaut!"));
        SPUKMASTER->Msg(TP->Name()+" versucht erneut die Schreibwalze einzubauen", ALL);
        return -1;
      }
      else
      {
        write(BS("Die Schreibwalze wurde bereits von "+CAP(schreibwalze)+" eingebaut!"));
        SPUKMASTER->Msg(TP->Name()+" Schreibwalze belegt von: "+CAP(schreibwalze), ALL);
        return -1;
      }
    }

    write(BS("Vorsichtig setzt Du die alte Schreibwalze in die Schreibmaschine "
            +"ein."));
    Message(BS(TP->Name()+" hantiert an der Schreibmaschine."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    schreibwalze = getuid(TP);
    SPUKMASTER->Msg(TP->Name()+" baut die Schreibwalze ein", QUEST);
    ob->remove();
    return 1;
  }

  if((was == "tasten" || was == "buchstaben") && ob->id(TASTEN))
  {
    if(tasten)
    {
      if(tasten == getuid(TP))
      {
        write(BS("Aber Du hast die Buchstaben bereits eingebaut!"));
        SPUKMASTER->Msg(TP->Name()+" versucht erneut die Buchstaben einzubauen", ALL);
        return -1;
      }
      else
      {
        write(BS("Die Buchstaben wurde bereits von "+CAP(tasten)+" eingebaut!"));
        SPUKMASTER->Msg(TP->Name()+" Buchstaben belegt von: "+CAP(tasten), ALL);
        return -1;
      }
    }

    write(BS("Geschickt platzierst Du die Tasten an den richtigen Stellen."));
    Message(BS(TP->Name()+" hantiert an der Schreibmaschine."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    tasten = getuid(TP);
    SPUKMASTER->Msg(TP->Name()+" baut die Tasten ein", QUEST);
    ob->remove();
    return 1;
  }

  if((was == "band" || was == "farbband") && ob->id(FARBBAND))
  {
    if(farbband)
    {
      if(farbband == getuid(TP))
      {
        write(BS("Aber Du hast das Farbband bereits eingebaut!"));
        SPUKMASTER->Msg(TP->Name()+" versucht erneut das Farbband einzubauen", ALL);
        return -1;
      }
      else
      {
        write(BS("Das Farbband wurde bereits von "+CAP(farbband)+" eingebaut!"));
        SPUKMASTER->Msg(TP->Name()+" Farbband belegt von: "+CAP(farbband), ALL);
        return -1;
      }
    }

    write(BS("Du setzt das Farbband in die Schreibmaschine ein."));
    Message(BS(TP->Name()+" hantiert an der Schreibmaschine."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    farbband = getuid(TP);
    SPUKMASTER->Msg(TP->Name()+" baut das Farbband ein", QUEST);
    ob->remove();
    return 1;
  }

  return (notify_fail( "DAS kannst Du nicht einbauen.\n" ),0);
}

//--Funktionen fuer Details------------------------------------------------

string str_bett(string str)
{
  string s;

  s = "Das Bett hat die Groesse eines kleinen Kindes. ";
  if(schwert == DA)
  {
    s += "Auf der halbzerfallenen Bettdecke liegt ein altes Holzschwert.";
  }
  else
  {
    s += "Eine halbzerfallene Bettdecke liegt darauf.";
  }

  s += " Irgendetwas kommt Dir komisch vor. Vielleicht waere es eine gute "
  "Idee, unters Bett zu schauen.";
  return BS(s);
}

string str_schwert(string str)
{
  string s;

  if(schwert == DA)
  {
    s = "Das Schwert sieht noch sehr brauchbar aus.";
  }
  else
  {
    s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

int cmd_nehmen(string str)
{
  object mysword;
  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;
  if(str == "holzfigur" || str == "figur" )
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)))
    {
      write(BS("Nochmal willst Du Dir das nicht antun ..."));
      return -1;
    }

    write(BS("Du greifst unter das Bett und ziehst die Holzfigur hervor."));

    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:70,
      PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
      PARALYZE_MSG_OTHER:"%s steht wie erstarrt da.\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));

    SPUKMASTER->Msg(TP->Name()+" nimmt die Holzfigur", QUEST);

    Sequence(TP);
    SPUKMASTER->AddPlayerSequence(getuid(TP), BRUDERSEQ);

    return 1;
  }

  if(str == "schwert" || str == "holzschwert" )
  {
    if(schwert == DA)
    {
      mysword=clone_object(WEAPON "holzschwert");

      if(ME_TOO_HEAVY==mysword->move(TP,M_GET|M_SILENT))
      {
        write("Du kannst das Holzschwert nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann das Holzschwert nicht tragen", ALL);
        mysword->remove();
        return -1;
      }
      else
      {
        mysword->TakeFlaw(500+random(500));
        write(BS("Du nimmst das Holzschwert vom Bett."));
        Message(BS(TP->Name()+" nimmt das Holzschwert vom Bett."),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        schwert = WEG;
        SPUKMASTER->Msg(TP->Name()+" nimmt das Holzschwert", ALL);
        return 1;
      }
    }
  }
  return 0;
}

// Waehrend sequenzen RoomMessages ausschalten
void removeRoomMessage()
{
  AddRoomMessage( "",60,"");
}

void resetRoomMessage()
{
  AddRoomMessage(
    ({"Irgendwer ist bei Dir!\n",
      "Jemand ist bei Dir!\n",
      "Du fuehlst Dich beobachtet!\n",
      "Hat sich nicht grade eines der Holzfiguren bewegt??\n",
      "Die Schreibmaschine klappert!\n"}),60,"message");
}

int Sequence(object player)
{
  if (player)
  {
    removeRoomMessage();
    SPUKMASTER->sequencer(player, 0, ({
  0, "#Alles wird weiss vor Deinen Augen ...",
  5, "#Du willst mit Deinem schwarzen Ritter spielen, der als letztes einen "
    +"goldenen Drachen erlegt hat, als Deine Schwester ruft: "
    +"Gib mir meinen Teddy wieder!!!",
  6, "#Du lachst boese.",
  4, "#Ploetzlich kracht es unten. Du hoerst Deinen Vater irgendwas rufen.",
  5, "#Gegen was koennte mein schwarzer Ritter denn heute antreten? Nachdem die "
    +"Paladine schon so jaemmerlich versagt haben.",
  6, "#Du wirfst einen Blick in die Ecke rechts von der Tuer. Dort liegt eine "
    +"weitere zerbrochene Holzfigur.",
  6, "#Deine Mutter ruft: Lauft Kinder, versteckt euch! "
    +"Was ist denn dort los??",
  6, "#Deine Schwester faengt an zu schreien und verstummt ploetzlich. "
     +". o O (Dumme Gans!)",
  6, "#Schnell kriechst Du unter Dein Bett.",
  4, "#*RUMMS* Die Tuer wurde eingetreten!",
  6, "#Mit angstgeweiteten Augen betrachtest Du das Paar Ogerstiefel, das gerade "
    +"Dein Zimmer betreten hat.",
  6, "#Aber den Teddy findet sie nie ... Es wird schwarz vor Deinen Augen.",
  4, "#Etwas benommen stehst Du wieder auf.",
  4, "*resetRoomMessage"
    }), TO);
  }
  return 1;
}

reset()
{
  ::reset();

  tasten = schreibwalze = farbband = WEG;
  schwert = DA;
}

void begruessung(object player)
{
  if(ENV(player) != TO) return;
  tell_object(player, BS("Ein eisiger Schauer laeuft Dir den Ruecken runter!"));
  return;
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  call_out("begruessung", 20+random(20), TP);

}

string strSchreibmaschine(string key)
{
  string s;

  s = "Die Schreibmaschine ist schon sehr alt und vollkommen eingestaubt. ";

  if(!schreibwalze || !farbband || !tasten)
    s += "Funktionstuechtig ist sie nicht, einige Teile fehlen noch. ";

  if(schreibwalze)
    s += "Eine alte Schreibwalze verrichtet ihr Werk in ihr. ";
  else
    s += "Dort, wo einst die Schreibwalze war, sind nur noch Spinnweben "
        +"zu erkennen. ";

  if(farbband)
    s += "Die Halterungen fuer das Farbband sind ein wenig verbogen, dennoch "
        +"halten sie das Farbband an seinem Platz. ";
  else
    s += "Die Halterungen fuer das Farbband sind ein wenig verbogen. Das "
        +"Band selber ist nicht vorhanden. ";

  if(tasten)
    s += "Die Buchstaben sind alle da.";
  else
    s += "Ein paar Buchstaben fehlen.";

  return BS(s);
}

string strBuchstaben(string key)
{
  string s;

  s = "";

  if(tasten)
    s += "Alle Buchstaben sind vorhanden.";
  else
    s += "Ein paar Buchstaben fehlen.";

  return BS(s);
}

string strWalze(string key)
{
  string s;

  s = "";

  if(schreibwalze)
    s += "Die Schreibwalze sieht sehr alt aus.";
  else
    s += "Dort, wo einst die Schreibwalze war, sind nur noch Spinnweben "
        +"zu erkennen. ";

  return BS(s);
}


string strFarbband(string key)
{
  string s;

  s = "";

  if(farbband)
    s += "Die Halterungen sind ein wenig verbogen, halten das Farbband aber "
        +"dennoch an seinem Platz.";
  else
    s += "Die Halterungen fuer das Farbband sind ein wenig verbogen. Das "
    +"Band selber ist nicht vorhanden. ";

  return BS(s);
}

// Evtl. Buchstabendingsel?
string strTisch(string key)
{
  string s;
  s = "Der kleine Tisch besteht - wie nicht anders zu erwarten - aus Holz. "
     +"Auf ihm steht eine alte Schreibmaschine. So sehr Du Dich auch bemuehst, "
     +"einen Stuhl fuer den Tisch kannst Du nicht finden.";

  return BS(s);
}

void resetSchreibmaschine(object player)
{
  // Schreibmaschine muss neu zusammengesetzt werden
  if(player)
  {
    Message(BS(player->Name(WER, 1)+" steht zitternd wieder auf, "
           +"erstaunt stellst Du fest, dass die Schreibmaschine wieder "
           +"unvollstaendig ist."), MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : 
            ({ player }) ]) );
  }
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20]) );
  schreibwalze = farbband = tasten = WEG;
  schreibmaschine = WEG;
  resetRoomMessage();
}

int SequenceSchreibmaschine(object player)
{
  if (player)
  {
    SPUKMASTER->sequencer(player, 0, ({
  0, "#Alles wird weiss vor Deinen Augen ...",
  6, "#Kaelte ... Du spuerst nichts als Kaelte ...",
  4, "#Dein Kopf fuehlt sich an, als wenn eiskalte Finger nach Deinem "
    +"Geist greifen.",
  5, "#Du kaempfst verzweifelt, um die Kontrolle ueber Deinen Koerper "
    +"nicht zu verlieren.",
  6, "#Verwundert starrst Du auf Deine Finger. Sie tippen auf der Schreib"
    +"maschine ohne Deinen Willen!! ",
  4, "#ICH IWLL DEN TEDY",
  4, "Verzweifelt kaempfst Du gegen den Geist an.",
  4, "#BRNG IHN MIIIR",
  4, "#KELLE - mit einer gewaltigen Geistesanstrengung schaffst Du es, Dich "
    +"dem Einfluss des Geistes zu entziehen!",
  4, "#Mit zittrigen Haenden stehst Du wieder auf, dabei faellt Dir auf, "
    +"dass die Schreibmaschine wieder defekt ist.",
  0, "*resetSchreibmaschine"
    }), TO);
  }
  return 1;
}