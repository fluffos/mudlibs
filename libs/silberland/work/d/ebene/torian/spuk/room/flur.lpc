#include "../def.h"

inherit "std/room";

string *auswahl;
string welcherort();
string ort;
string *spieler;

void create()
{
  ::create();

  spieler = ({ });
// Welche Haufen sind moeglich
  auswahl = ({ "bild","kommode","fetzen"});
// Welcher ist der richtige?
  ort = welcherort();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Flur");
  SetProp(P_INT_LONG,
    "Du stehst im oberen Flur des Hauses. Neben der Treppe nach unten "
    "fuehren drei Tueren von ihm ab. Eine alte Kommode mit rausgerissenen "
    "Schubladen nimmt den groessten Teil des Flures ein. Ueber ihr haengt "
    "ein altes, verblichenes Bild an der Wand."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, QUEST);
  SetProp(P_INDOORS, QUEST);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "flur", "flures" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "treppe" }),
    "Die Treppe mit ihren morschen Stufen fuehrt nach unten."
  );
  AddDetail( ({ "stufen", "stufe" }),
    "Die Stufen sind sehr morsch. Jedesmal, wenn jemand auf ihnen "
    "entlang laeuft, knarren und aechzen sie bedrohlich."
  );
  AddDetail( ({ "tueren", "tuer" }),
    "Drei offene Tueren. Eine Tuer nach Osten, eine nach Westen und eine "
    "nach Norden. Jede Tuer ist entweder eingetreten oder haengt schief "
    "in den Angeln. Schliessen kann man keine mehr von ihnen."
  );
  AddDetail( ({ "osten" }),
    "Die Tuer wurde eingetreten. Ein paar verstreute Spielsachen "
    "deuten auf ein Kinderzimmer hin."
  );
  AddDetail( ({ "spielsachen" }),
    "Wenn Du sie genauer betrachten willst, musst Du das Zimmer schon betreten."
  );
  AddDetail( ({ "westen" }),
    "Ein Blick in das Zimmer deutet auf ein Kinderzimmer hin. Die Schwelle "
    "zum Zimmer ist hoeher als bei den anderen. Um mehr zu erkennen, musst Du "
    "das Zimmer schon betreten."
  );
  AddDetail( ({ "blick" }),
    "Scheinbar ist es ein Kinderzimmer."
  );
  AddDetail( ({ "schwelle" }),
    "Ueber solch eine Schwelle kann man leicht stolpern, wenn man nicht aufpasst."
  );
  AddDetail( ({ "norden" }),
    "Ein riesiger Ast ist durch die Decke in das noerdliche Zimmer gestuerzt. "
    "Sehr viel mehr ist von hier aus nicht zu erkennen."
  );
  AddDetail( ({ "zimmer" }),
    "Welches Zimmer meinst Du genau?"
  );
  AddDetail( ({ "nordzimmer", "noerdliches zimmer", "noerdliche zimmer" }),
    "Ein riesiger Ast ist in das Zimmer gestuerzt."
  );
  AddDetail( ({ "ast", "loch" }),
    "Solch ein grosser Ast muss ein beachtliches Loch in die Decke gerissen haben."
  );
  AddDetail( ({ "kinderzimmer" }),
    "Es gibt offensichtlich zwei Kinderzimmer."
  );
  AddDetail( ({ "angeln" }),
    "Normalerweise halten die Angeln die Tueren fest. Zeit oder Gewalt hat "
    "diese Angeln hier beschaedigt."
  );
  AddDetail( ({ "zeit", "gewalt", "ursache" }),
    "Die Zeit als Ursache waere Dir bedeutend lieber, aber es sieht doch eindeutig "
    "nach Gewalt aus. Wer das wohl war? Ob er wiederkommt?"
  );
  AddDetail( ({ "bild" }),
    "Das Bild zeigt ein paar Maenner beim Bau eines Hauses. Alle scheinen froehlich "
    "und munter bei der Arbeit zu sein. Doch irgendetwas irritiert Dich an diesem "
    "Bild. Trotz der froehlichen Maenner hat es eine ungewoehnlich duestere Ausstrahlung."
  );
  AddDetail( ({ "maenner", "bau", "menschen", "arbeit" }),
    "Die Maenner arbeiten froehlich an dem Haus. Nichts scheint sie beeintraechtigen "
    "zu koennen."
  );
  AddDetail( ({ "hauses", "haus" }),
    "Es koennte sich um dieses Haus hier handeln. Doch irgendetwas stimmt nicht. "
    "Das Haus steht auf einer grossen Lichtung. Einige gefaellte Baeume liegen "
    "vor dem Haus und warten darauf, zurechtgesaegt zu werden."
  );
  AddDetail( ({ "lichtung" }),
    "Das Haus auf dem Bild steht auf einer grossen Lichtung. Nur das Haus, in dem "
    "Du Dich befindest, ist von Baeumen umgeben."
  );
  AddDetail( ({ "baeume", "baeumen", "waldrand" }),
    "Der ferne Waldrand ist sehr duester gehalten, fast scheint es, als ob die "
    "Baeume den Menschen grollen wuerden."
  );
  AddDetail( ({ "ausstrahlung" }),
    "Die gesamte Ausstrahlung des Bildes ist ungewoehnlich duester."
  );
  AddDetail( ({ "wand" }),
    "An der Wand haengt ein altes verblichenes Bild. Es scheint sich etwas "
    "hinter dem Bild verklemmt zu haben."
  );
  AddDetail( ({ "kommode", "teil" }),
    "Eine alte Kommode mit herausgerissenen Schubladen nimmt den groessten Teil "
    "des Flures ein. Frueher war sie bestimmt schoen anzusehen. Heute ist sie "
    "besseres Brennholz."
  );
  AddDetail( ({ "brennholz" }),
    "Die Kommode ist zu nichts weiter mehr zu gebrauchen."
  );
  AddDetail( ({ "schubladen" }),
    "Die Schubladen sind herausgerissen und ihr Inhalt, sofern noch vorhanden, "
    "ist ueber den Boden verstreut. Nur eine Schublade ist noch dort, wo sie "
    "hingehoert."
  );
  AddDetail( ({ "schublade" }),
    "Was sich wohl in ihr befindet?"
  );
  AddDetail( ({ "inhalt" }),
    "Nur Fetzen und Stoffreste sind noch uebrig geblieben. Der Rest ist entweder "
    "entwendet worden oder bereits zerfallen."
  );
  AddDetail( ({ "fetzen", "stoffreste", "reste" }),
    "Ob unter ihnen noch etwas nuetzliches ist?"
  );
  AddDetail( ({ "rest" }),
    "Entwendet oder zerfallen."
  );
  AddDetail( ({ "boden" }),
    "Fetzen und Stoffreste sind auf dem Boden verteilt."
  );
  AddDetail( ({ "waende", "decke" }),
    "Decke und Waende bestehen aus Holzbalken."
  );
  AddDetail( ({ "holzbalken", "balken", "haustuer", "holz" }),
    "Das Holz fuer die Balken, aus dem das Haus besteht, stammt aus dem Ogerwald."
  );
  AddDetail( ({ "ogerwald", "wald" }),
    "Der Wald ist vor der Haustuer."
  );
  AddDetail( ({ "haustuer" }),
    "Die befindet sich unten."
  );
  AddDetail( ({ "kleidung" }),
    "Die Fetzen und Stoffreste vor Dir waren bestimmt einmal Kleidung."
  );

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift an Dir vorbei."
  );

  AddSound( ({ "schreien", "kinder" }),
    "Das ist nur der Wind, der hier durchrauscht. Oder doch nicht??");
  AddSound( ({ "wind", "luftzug", "norden" }),
    "Du spuerst einen Luftzug, der vom Norden herkommt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach alter, mottenzerfressener Kleidung."
  );

  AddSmell( ({ "kleidung", "fetzen", "stoffreste", "reste" }),
    "Die Fetzen und Stoffreste riechen alt und mottenzerfressen."
  );

  AddRoomMessage(
    ({"Eine Stufe knarrt.\n",
      "Eine der Stufen aechzt.\n",
      "Du glaubst, das Schreien kleiner Kinder zu hoeren.\n"}),45,"");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "klappe", "klapp", "dreh", "drehe" }), "cmd_drehen" );
  AddCmd( CMD_OEFFNEN, "cmd_oeffnen" );
  AddCmd( ({ "brich", "breche", "brech" }), "cmd_brechen" );
  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuchen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", "in das Schlafzimmer#" + "./schlafzimmer" );
  AddExit( "osten", "nach Osten#" + "./bruderzi" );
  AddExit( "westen", "nach Westen#" + "./schwesterzi" );
  AddExit( "unten", "die Treppe hinunter#" + "./eingang" );

}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_drehen(string str)
{
  object ob;

  notify_fail("Was willst Du zur Seite drehen oder klappen?\n");

  if(!str || str == "") return 0;

  if(!(str == "bild bei seite" ||
       str == "bild zur seite" ||
       str == "bild beiseite"  ||
       str == "bild weg"     )) return 0;

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
      (member(spieler, getuid(TP)) == -1)                      &&
       (ort == "bild"))
    {
      ob = clone_object(OBJ "tasten");
      write(BS("Du drehst das Bild zur Seite und findest ein paar Tasten "
        +"fuer eine Schreibmaschine. Wie die wohl dahin gekommen sind?"));
      Message(BS(TP->Name(WER, 1)+" hantiert am Bild."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt die Tasten vom Bild", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du die Tasten nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann die Tasten nicht tragen", ALL);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" dreht ein Bild zur Seite", ALL);
    write(BS("Du drehst das Bild zur Seite und siehst einen alten Fetzen. "
            +"Entaeuscht haengst Du das Bild wieder gerade."));
    Message(BS(TP->Name(WER, 1)+" hantiert am Bild."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;

}

int cmd_oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "schublade" || str == "lade" ))
    return (notify_fail("DAS kannst Du nicht oeffnen!\n"),0);

  write(BS("Du ruettelst an der Schublade. Mist, sie sitzt zu fest. So wird das "
          +"wohl nichts."));
  Message(BS(TP->Name(WER, 1)+" ruettelt an der Schublade."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  SPUKMASTER->Msg(TP->Name()+" versucht die Schublade zu oeffnen", ALL);
  return 1;
}

int cmd_brechen(string str)
{
  object ob;

  notify_fail("Was willst Du aufbrechen?\n");

  if(!str || str == "") return 0;

  if(!(str == "schublade auf" || str == "lade auf"))
    return (notify_fail("DAS kannst Du nicht aufbrechen!\n"),0);

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
      (member(spieler, getuid(TP)) == -1)                      &&
       (ort == "kommode"))
    {
      ob = clone_object(OBJ "tasten");
      write(BS("Du brichst die Schublade auf und findest ein paar Tasten "
        +"fuer eine Schreibmaschine. Hocherfreut schliesst Du die "
        +"Schublade wieder."));
      Message(BS(TP->Name(WER, 1)+" ruettelt an der Schublade."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt die Tasten von der Schublade", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du die Tasten nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann die Tasten nicht tragen", ALL);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" bricht die Schublade auf", ALL);
    write(BS("Du brichst die Schublade auf und findest leider nichts. "
            +"Enttaeuscht rammst Du die Schublade wieder zu."));
    Message(BS(TP->Name(WER, 1)+" ruettelt an der Schublade."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;

}

//Moegliches Versteck fuer Buchstaben oder Schreibmaschinendingsel
int cmd_durchsuchen(string str)
{
  object ob;

  notify_fail("Was willst Du durchsuchen?\n");

  if(!str || str == "") return 0;

  if(str == "fetzen" || str == "kleidung" || str == "stoffreste" || str == "reste")
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
       (member(spieler, getuid(TP)) == -1)                       &&
       (ort == "fetzen"))
    {
      ob = clone_object(OBJ "tasten");
      write(BS("Du durchsuchst die Stoffreste und findest tatsaechlich "
              +"etwas."));
      Message(BS(TP->Name(WER, 1)+" durchsucht die Stoffreste."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt die Tasten von den Stoffresten", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du es nicht mehr tragen und laesst es fallen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann die Tasten nicht mehr tragen", ALL);
        ob->move(TO,M_PUT);
      }
      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" durchsucht die Stoffreste", ALL);
    write(BS("Nichts interessantes dabei."));
    Message(BS(TP->Name(WER, 1)+" durchsucht die Stoffreste."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
  }

  if(str == "schublade" || str == "lade")
  {
    write(BS("Die Schublade ist verschlossen. So einfach geht das leider nicht."));
    Message(BS(TP->Name(WER, 1)+" ruettelt an der Schublade."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" versucht die Schublade zu durchsuchen", ALL);
    return -1;
  }

  if(str == "schubladen" || str == "laden")
  {
    write(BS("Da der Inhalt der Schubladen bereits ueber dem Boden verstreut ist, "
            +"macht es nicht viel Sinn, sie noch extra zu durchsuchen."));
    SPUKMASTER->Msg(TP->Name()+" versucht die SchubladeN zu durchsuchen", ALL);
    return -1;
  }

  return (notify_fail( "DAS kannst Du nicht durchsuchen!\n" ),0);
}


// Was ist der richtige Ort?
string welcherort()
{
  return auswahl[random(sizeof(auswahl))];
}

// Debugzwecke
string QueryOrt()
{
  return ort;
}
// Debugzwecke
string *QuerySpieler()
{
  return spieler;
}

reset()
{
  ::reset();

// Pro Reset neuer Ort
  ort = welcherort();
  spieler = ({ });
}