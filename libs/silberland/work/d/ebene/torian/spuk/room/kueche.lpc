#include "../def.h"

inherit "std/room";

int Sequence(object player);
string *auswahl;
string welcherort();
string ort;
string *spieler;
status wasser;
void create()
{
  ::create();

  spieler = ({ });
// Welche Haufen sind moeglich
  auswahl = ({ "beutel","saecke","muell"});
// Welcher ist der richtige?
  ort = welcherort();
  wasser = WEG;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer verfallenen Kueche");
  SetProp(P_INT_LONG,
    "Die Kueche hat auch schon bessere Zeiten erlebt. An der noerdlichen "
    "Wand befindet sich eine Spuele mit einer kleinen Handpumpe. Direkt "
    "daneben ist eine Arbeitsplatte befestigt. Ein kleiner Tisch steht "
    "im Raum und im Osten haengt ein Regal an der Wand."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, ALL);
  SetProp(P_INDOORS, ALL);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "kueche" }),
    "Die Kueche hat auch schon bessere Zeiten erlebt. Alles ist verstaubt, ein "
    "Stuhl ist umgeworfen, das Regal ausgeraeumt - sogar das Geschirr in der "
    "Spuele ist dreckig und ungewaschen."
  );
  AddDetail( ({ "zeiten" }),
    "Frueher muss es hier mal sehr schoen gewesen sein. Ein kleines gemuetliches "
    "Haus mitten im Wald."
  );
  AddDetail( ({ "haus" }),
    "Frueher war das Haus sicher sehr schoen. Heute kann man es bestenfalls "
    "noch verfallen nennen."
  );
  AddDetail( ({ "wald" }),
    "Der Wald befindet sich vor dem Haus."
  );
  AddDetail( ({ "wand", "nordwand" }),
    "An der noerdlichen Wand befindet sich eine Spuele mit einer kleinen "
    "Handpumpe."
  );
  AddSpecialDetail( ({ "spuele" }), "strSpuele" );
  AddDetail( ({ "wasser" }),
    "Ob es noch Wasser gibt, wirst Du nur herausfinden, wenn Du die Pumpe "
    "auch betaetigst."
  );
  AddDetail( ({ "geschirr", "geschirrs" }),
    "Dreckiges Geschirr liegt in der Spuele. Du hast den Eindruck, dass "
    "jemand gerade dabei war, es zu spuelen und dann sehr ueberhastet "
    "aufgebrochen ist."
  );
  AddDetail( ({ "jemand" }),
    "Wer das war, kannst Du nicht einmal vermuten."
  );
  AddDetail( ({ "eindruck", "teil" }),
    "Ein kleiner Teil des Geschirrs wurde bereits abgewaschen. Auch "
    "wenn er jetzt mit Staub ueberzogen ist, wie alles hier."
  );
  AddDetail( ({ "staub" }),
    "Alles ist mit Staub ueberzogen."
  );
  AddDetail( ({ "handpumpe", "pumpe", "hilfe" }),
    "Sie sieht alt, aber noch funktionsfaehig aus. Mit ihrer Hilfe "
    "kann man bestimmt noch immer das Geschirr spuelen."
  );
  AddDetail( ({ "arbeitsplatte", "platte" }),
    "Die Arbeitsplatte ist mit einer dicken Staubschicht ueberzogen. "
    "Schon lange hat hier keiner mehr Essen zubereitet."
  );
  AddDetail( ({ "essen" }),
    "Wofuer sonst koennte die Arbeitsplatte gut sein, wenn nicht zum "
    "Essen kochen?"
  );
  AddDetail( ({ "tisch" }),
    "Wie alles hier ist auch der Tisch mit einer dicken Staubschicht "
    "ueberzogen. Etwas besonderes ist nicht zu erkennen."
  );
  AddDetail( ({ "stuhl" }),
    "Ein umgeworfener Stuhl liegt mitten im Raum. Ihn wieder aufzustellen "
    "ist zwecklos, zwei Stuhlbeine fehlen ihm. "
  );
  AddDetail( ({ "stuhlbeine", "beine", "stuhlbein", "bein" }),
    "Zwei Stuhlbeine fehlen dem Stuhl. Erstaunlich, dass es nur einen Stuhl "
    "gibt. Die Kueche bietet genug Platz fuer mehr als nur einen."
  );
  AddDetail( ({ "platz" }),
    "Genug Platz ist vorhanden, es ist anzunehmen, dass nur dieser Stuhl "
    "zurueckgelassen und die restlichen Stuehle weggetragen wurden."
  );
  AddDetail( ({ "stuehle" }),
    "Wer wuerde schon einen defekten Stuhl mitnehmen?"
  );
  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG)
  );
  AddDetail( ({ "regal", "aufbewahren" }),
    "In dem Regal lagerten frueher die Vorraete und Gewuerze. Offensichtlich "
    "wurde es von irgendwem ausgeraeumt. Nur ein Haufen Muell wurde zurueckgelassen."
  );
  AddDetail( ({ "vorraete" }),
    "Die Vorraete wurden allesamt gepluendert. Nur leere Beutel und Saecke liegen "
    "verstreut herum."
  );
  AddDetail( ({ "beutel" }), // detail fuer item
    "Alte zerrissene Beutel liegen herum. Frueher wurden sie zum Aufbewahren von "
    "Lebensmitteln benutzt. Ein Beutel scheint noch ganz brauchbar zu sein. "
    "Ob sich noch etwas in ihm befindet?"
  );
  AddDetail( ({ "lebensmittel" }),
    "Alle wurden gepluendert, wer wuerde sowas nur tun?"
  );
  AddDetail( ({ "saecke", "sack" }), // detail fuer item
    "Ein paar alte loechrige Saecke."
  );
  AddDetail( ({ "gewuerze" }),
    "Sogar die Gewuerze wurden gepluendert. Nichts essbares ist uebriggeblieben."
  );
  AddDetail( ({ "haufen", "muell", "muellhaufen" }), // durchsuche haufen -> item
    "Nur ein Haufen Muell wurde zurueckgelassen. Man koennte ihn durchsuchen, "
    "in der Hoffnung, doch noch etwas interessantes zu finden."
  );
  AddDetail( ({ "hoffnung" }),
    "Viel Hoffnung, dort etwas zu finden, hast Du nicht."
  );
  AddDetail( ({ "waende" }),
    "Welche Wand meinst Du?"
  );
  AddDetail( ({ "westwand", "westen" }),
    "Im Westen befindet sich der Durchgang zum Eingangsbereich des Hauses."
  );
  AddDetail( ({ "durchgang", "gang" }),
    "Der Durchgang ist schlichtweg eine Oeffnung in der Westwand. Nur wenig "
    "ist von dem zerstoerten Eingangsbereich zu erkennen."
  );
  AddDetail( ({ "eingangsbereich", "bereich", "eingang" }),
    "Nur wenig ist von dem zerstoerten Eingangsbereich zu erkennen."
  );
  AddDetail( ({ "suedwand", "sueden" }),
    "An der Suedwand kannst Du nichts weiter erkennen. Nur die Holzbohlen aus "
    "denen das gesamte Haus besteht."
  );
  AddDetail( ({ "ostwand", "osten" }),
    "Im Osten haengt ein Regal an der Wand. Es wurde zum Aufbewahren von "
    "Vorraeten genutzt."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist mit einer dicken Staubschicht ueberzogen."
  );
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus Holzbalken."
  );
  AddDetail( ({ "holz", "holzbohlen", "bohlen", "holzbalken" }),
    "Das Holz fuer die Bohlen stammt aus dem Wald vor der Haustuer."
  );
  AddDetail( ({ "wald" }),
    "Vor der Haustuer befindet sich ein Wald, das sollte Dir allerdings "
    "schon aufgefallen sein."
  );
  AddDetail( ({ "haustuer", "tuer" }),
    "Die Haustuer befindet sich beim Eingang und ist von hier aus nicht "
    "zu sehen."
  );
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
    "Der Staub ist schon fast allgegenwaertig."
  );
  AddDetail( ({ "zustand", "wort", "chaos" }),
    "Der Zustand laesst sich mit einem Wort beschreiben. Chaos."
  );

  AddSound( DEFAULT_SOUND,
    "Du kannst nichts besonderes hoeren. Die Geraeusche des Waldes "
    "dringen nicht bis hierher vor."
  );

  AddSound( ({ "geraeusche", "geraeusch" }),
    "Nichts.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht gar nicht so alt und abgestanden, wie es der Zustand "
    "des Raumes erwarten lassen koennte."
  );

  AddSmell( ({ "luft", "waldluft" }),
    "Die Luft riecht relativ gut. Durch die Tuer muss frische Waldluft "
    "bis zur Kueche hereindringen."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "spuele", "spuel" }), "cmd_spuele" );
  AddCmd( ({ "betaetige", "pumpe", "pump" }), "cmd_betaetigen" );
  AddCmd( ({ "koch", "koche" }), "cmd_kochen" );
  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuchen" );
  AddCmd( CMD_GREIFEN, "cmd_greifen" );
  AddCmd( ({ "heb", "hebe" }), "cmd_heben" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", "zum Eingang#" + "./eingang" );

}

//--Funktionen fuer Kommandos----------------------------------------------


//Moegliches Versteck fuer Buchstaben oder Schreibmaschinendingsel
int cmd_durchsuchen(string str)
{
  object ob;

  notify_fail("Was willst Du durchsuchen?\n");

  if(!str || str == "") return 0;

  if(str == "haufen" || str == "muell" || str == "muellhaufen")
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
       (member(spieler, getuid(TP)) == -1)                          &&
       (ort == "muell"))
    {
      ob = clone_object(OBJ "buchstabe");
      write(BS("Du durchsuchst den Haufen Muell und findest tatsaechlich "
              +"etwas."));
      Message(BS(TP->Name(WER, 1)+" durchsucht den Muellhaufen."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt einen Buchstaben aus dem Muellhaufen", ALL);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen und laesst es fallen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", QUEST);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" durchsucht den Muellhaufen", QUEST);
    write(BS("Muell, nichts als Muell."));
    Message(BS(TP->Name(WER, 1)+" durchsucht den Muellhaufen."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
  }

  if(str == "regal" )
  {
    SPUKMASTER->Msg(TP->Name()+" durchsucht das Regal", QUEST);
    write(BS("Ausser Muell befindet sich nichts mehr im Regal."));
    Message(BS(TP->Name(WER, 1)+" durchsucht das Regal."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return -1;
  }

  if( str == "vorraete" || str == "gewuerze")
  {
    SPUKMASTER->Msg(TP->Name()+" durchsucht die "+CAP(str), QUEST);
    write(BS("Es sind doch gar keine Vorraete oder Gewuerze mehr da zum durchsuchen. " 
            +"Lediglich ein Haufen Muell ist noch vorhanden."));
    Message(BS(TP->Name(WER, 1)+" durchsucht das Regal."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return -1;
  }

  if( str == "beutel")
  {
    SPUKMASTER->Msg(TP->Name()+" durchsucht die Beutel", QUEST);
    write(BS("Wenn Du wissen willst, ob etwas nuetzliches in den Beuteln ist, "
    "waere reingreifen vielleicht erfolgreicher."));
    Message(BS(TP->Name(WER, 1)+" durchsucht die Beutel."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return -1;
  }

  if( str == "sack" || str == "saecke")
  {
    SPUKMASTER->Msg(TP->Name()+" durchsucht die Saecke", QUEST);
    write(BS("Hochheben waere vielleicht sinnvoller."));
    Message(BS(TP->Name(WER, 1)+" durchsucht die Saecke."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return -1;
  }

}

int cmd_betaetigen(string str)
{
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "pumpe" )) return 0;

  if(wasser == WEG)
  {
    SPUKMASTER->Msg(TP->Name()+" betaetigt die Pumpe", ALL);
    write(BS("Du betaetigst ein paarmal kraeftig die Pumpe. Klares Wasser wird "
            +"herausgepumpt, es sollte Dir ein leichtes sein, damit abzuspuelen."));
    Message(BS(TP->Name(WER, 1)+" pumpt Wasser hoch.\n"), 
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    wasser = DA;
    return 1;
  }
  else
  {
    SPUKMASTER->Msg(TP->Name()+" betaetigt die Pumpe, obwohl schon Wasser da ist", QUEST);
    write(BS("Die Spuele ist bereits voll Wasser. Noch mehr brauchst Du nicht."));
    return -1;
  }
}

int cmd_spuele(string str)
{
  notify_fail("Was willst Du tun?\n");

  if(!str || str == "") return 0;

  if(!(str == "ab"          || 
       str == "geschirr ab" )) return 0;

  if(wasser == WEG)
  {
    write(BS("Es ist gar kein Wasser da!"));
    SPUKMASTER->Msg(TP->Name()+" versucht OHNE Wasser abzuspuelen", QUEST);
    return -1;
  }    

  SPUKMASTER->Msg(TP->Name()+" spuelt ab", ALL);

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), KUECHESEQ)))
  {
    write(BS("Nochmal willst Du Dir das nicht antun ..."));
    return -1;
  }

  TP->SetProp(P_PARALYZED, ([
    PARALYZE_TIME:60,
    PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
    PARALYZE_MSG_OTHER:"%s steht wie erstarrt da.\n",
    PARALYZE_END:"",
    PARALYZE_END_OTHER:""
  ]));

  write(BS("Du faengst an, das Geschirr zu spuelen ..."));
  Message(BS(TP->Name(WER, 1)+" spuelt ab und weicht ploetzlich zurueck.\n"),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  Sequence(TP);
  SPUKMASTER->AddPlayerSequence(getuid(TP), KUECHESEQ);

  return 1;
}

int cmd_kochen(string str)
{

  SPUKMASTER->Msg(TP->Name()+" versucht zu kochen", QUEST);

  write(BS("Die Arbeitsplatte ist viel zu dreckig als das Du hier noch kochen "
          +"wollen wuerdest."));
  return 1;
}

int Sequence(object player)
{
  if (player)
  {
    SPUKMASTER->sequencer(player, 0, ({
  0, "#Alles wird weiss vor Deinen Augen ...",
  5, "#Was auch immer es war, es laesst nach. Du kannst Deine Umgebung "
    +"wieder wahrnehmen. Doch irgendwas ist anders ...",
  6, "#Fasziniert schaust Du an Dir runter und erkennst, dass Du ein weisses Kleid "
    +"mit einem Blumenmuster traegst. Du summst leise ein Dir unbekanntes Lied "
    +"vor Dich hin. Von oben hoerst Du lautes Kinderlachen und ueberlegst, ob "
    +"Du nachsehen gehen solltest.",
  12, "#Du zuckst zusammen. Was war das fuer ein Laerm?!?!\n"
     +"Erschrocken stuerzt Du in den Flur.",
  5, "#In dem Flur steht ein Oger mit einem verrosteten Schwert. Die Eingangstuer "
    +"liegt zu seinen Fuessen. Dort, wo einstmals die Wohnzimmertuer war, ist nur noch "
    +"ein Loch, welches von einem grossen Schatten ausgefuellt wird.",
  6, "#Dein Mann ruft laut: Was wollt ihr hier! Verschwindet aus meinem Haus!!",
  6, "#Der Schatten verschwindet aus der Tuer und Du hoerst etwas zusammenbrechen.",
  3, "#Oh Gott, die Kinder! Ich muss sie schuetzen!",
  6, "#Du drehst Dich um und rennst die Treppe hinauf.",
  4, "#Ploetzlich haelt Dich etwas am Knoechel fest.\n"
    +"Du rufst: Lauft Kinder, versteckt euch!",
  4, "#Du drehst Dich um. Der Oger steht mit erhobenem Schwert ueber Dir! "
    +"Alles wird schwarz vor Deinen Augen ...",
  4, "#"
    }), TO);
  }
  return 1;
}

int cmd_greifen(string str)
{
  object ob;

  notify_fail("In was willst Du greifen?\n");

  if(!str || str == "") return 0;

  if(str == "in beutel")
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
        (member(spieler, getuid(TP)) == -1)                         &&
         (ort == "beutel"))
    {
      ob = clone_object(OBJ "buchstabe");
      write(BS("Du greifst in den Beutel. Enttaeuscht wendest Du Dich "
              +"wieder ab. Doch halt! Was war das in der letzten Ecke? "
              +"Erleichtert, doch etwas gefunden zu haben, nimmst Du einen "
              +"kantigen Gegenstand an Dich."));
      Message(BS(TP->Name(WER, 1)+" hantiert an den Beuteln."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt einen Buchstaben aus dem Beutel", ALL);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen und laesst ihn fallen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", QUEST);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" greift in die Beutel", QUEST);
    write(BS("Du greist in den Beutel, findest jedoch nichts."));
    Message(BS(TP->Name(WER, 1)+" hantiert an den Beuteln."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }

  if(str == "in saecke" || str == "in sack")
  {
    write(BS("Du greifst in die Saecke und findest nur Loecher. Hochheben "
            +"waere vielleicht sinnvoller."));
    Message(BS(TP->Name(WER, 1)+" hantiert an den Saecken."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" greift in die Saecke", QUEST);
    return -1;
  }

  return (notify_fail( "DA HINEIN kannst Du nicht greifen!\n" ),0);
}

int cmd_heben(string str)
{
  object ob;

  notify_fail("Was willst Du anheben?\n");

  if(!str || str == "") return 0;

  if(str == "saecke an" || str == "sack an" ||
     str == "saecke hoch" || str == "sack hoch")
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
        (member(spieler, getuid(TP)) == -1)                         &&
         (ort == "saecke"))
    {
      ob = clone_object(OBJ "buchstabe");
      write(BS("Du hebst die loechrigen Saecke an. Dabei faellt aus "
              +"einem Sack ein Holzklotz, schnell greifst Du danach."));
      TO->Message(BS(TP->Name(WER, 1)+" hantiert an den Saecken."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt den Buchstaben von den Saecken", ALL);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen und laesst ihn fallen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", QUEST);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" hebt die Saecke an", QUEST);
    write(BS("Du hebst die Saecke an, findest jedoch nichts interessantes."));
    TO->Message(BS(TP->Name(WER, 1)+" hantiert an den Saecken."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  if(str == "beutel an")
  {
    write(BS("Du hebst die Beutel an und findest ein wenig Rattenkot. "
            +"Angewidert laesst Du sie wieder fallen."));
    Message(BS(TP->Name(WER, 1)+" hantiert an den Beuteln."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" hebt die Beutel an", QUEST);
    return -1;
  }

  return (notify_fail( "DAS kannst Du nicht anheben!\n" ),0);
}
// Was ist der richtige Ort?
string welcherort()
{
  return auswahl[random(sizeof(auswahl))];
}

// Debugzwecke
string QueryOrt()
{
  return ort;
}
// Debugzwecke
string *QuerySpieler()
{
  return spieler;
}

reset()
{
  ::reset();

// Pro Reset neuer Ort
  ort = welcherort();
  spieler = ({ });
  
  if(wasser == DA)
  {
    Message(BS("Das Wasser fliesst ab."), MSGFLAG_VISUAL);
    wasser = WEG;
  }
}

string strSpuele(string str)
{
  string s;
  s = "In der Spuele liegt noch einiges ungewaschenes Geschirr. Eine kleine "
     +"Handpumpe versorgt sie mit Wasser.";
  
  if(wasser == DA)
  {
    s+=" Es ist genuegend Wasser vorhanden, um abspuelen zu koennen.";
  }
  
  return BS(s);
}
