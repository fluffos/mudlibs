/*
Aus den Augenwinkeln nimmst Du einen Schatten im Spiegel war
durchsuche truemmer
schau unter bett
oeffne nachtkaestchen, durchsuche nachtkaestchen
*/
#include "../def.h"
#include <verben.h>

inherit "std/room";

int SequenceSpiegel(object player);
status kaestchen, ast, spiegel, spiegelseq;
string *auswahl;
string welcherort();
string ort;
string *spieler;

message(int msg);

void create()
{
  ::create();

  kaestchen = ZU;
  ast = DA;
  spiegel = DA;
  spiegelseq = DA;
  spieler = ({ });
// Welche Haufen sind moeglich
  auswahl = ({ "truemmer","kaestchen","bett"});
// Welcher ist der richtige?
  ort = welcherort();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Schlafzimmer");
  SetProp(P_INT_LONG,
    "Ein riesiger Ast ist durch die Decke gestuerzt und hat ein grosses "
    "Bett unter sich begraben. Ein Nachtkaestchen steht unbeschaedigt daneben. "
    "Einige Truemmer liegen unter dem Ast."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, QUEST);
  SetProp(P_INDOORS, QUEST);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "ast" }),
    "Ein riesiger Ast ist durch die Decke gestuerzt. Durch das Loch, das er "
    "hinterlassen hat kann man den Himmel und ein paar Baeume sehen. Viel "
    "uebriggelassen hat er nicht von dem Zimmer. Lediglich ein Nachtkaestchen "
    "ist unbeschaedigt geblieben."
  );
  AddDetail( ({ "decke", "loch" }),
    "Die Decke ist zusammen mit den Waenden fast komplett eingestuerzt und bietet "
    "freien Blick durch die Blaetter der Baeume auf den Himmel."
  );
  AddDetail( ({ "blick" }),
    "Die Decke behindert den Blick gen Himmel nicht. Nur die Aeste und Blaetter "
    "der Baeume stoeren."
  );
  AddDetail( ({ "blaetter", "aeste" }),
    "Die Aeste sehen bedrohlich aus. Wie zum Schlag erhobene Arme."
  );
  AddDetail( ({ "schlag", "arme", "sache" }),
    "Ob sie Dich schlagen wollen? Sonderlich wohl ist Dir nicht bei der Sache."
  );
  AddDetail( ({ "bett" }),
    "Das Bett ist unter dem Ast begraben. Ohne die federnde Wirkung waere der "
    "Ast vielleicht sogar weiter durchgebrochen. Alles, was man vom Bett noch "
    "erkennen kann ist, dass es mal ein grosses Doppelbett gewesen ist. "
    "Das Bett an sich ist ganz geblieben, man koennte sogar unters Bett schauen."
  );
  AddDetail( ({ "doppelbett" }),
    "Mehr kann man nicht erkennen."
  );
  AddDetail( ({ "wirkung", "sicherheit", "gewalt" }),
    "Das Bett hat viel von der Gewalt des Astes abgefangen. Andernfalls waere "
    "mit Sicherheit noch schlimmeres passiert."
  );
  AddSpecialDetail( ({ "nachtkaestchen", "kaestchen" }), "strNachtkaestchen" );
  AddSpecialDetail( ({ "inhalt", "plunder", "menge" }), "strInhalt" );
  AddDetail( ({ "sturz" }),
    "Der Ast ist durch die Decke gestuerzt."
  );
  AddDetail( ({ "truemmer" }),
    "Frueher waren sie vermutlich mal ein Kleiderschrank, heute sind sie nichts "
    "weiter als Truemmer, die unter dem Ast begraben liegen. Es koennte schwierig "
    "werden, sie zu durchsuchen."
  );
  AddDetail( ({ "kleiderschrank", "schrank" }),
    "Nur noch Truemmer."
  );
  AddDetail( ({ "waende", "waenden", "ordnung", "grossteil" }),
    "Ein Grossteil der Waende ist eingestuerzt. Nur im Osten und Sueden sind sie "
    "noch in Ordnung."
  );
  AddDetail( ({ "osten", "ostwand", "wand" }),
    "Im Osten steht das Nachtkaestchen. Es ist dem Ast nur knapp entgangen. "
    "An der Wand haengt noch ein alter Spiegel."
  );
  AddDetail( ({ "sueden", "suedwand" }),
    "Der Suedwand erging es besser als der Nord- und Westwand. Dennoch hat auch "
    "dort die Tuer gelitten."
  );
  AddDetail( ({ "nordwand", "westwand" }),
    "Die Nord- und Westwand wurden zusammen mit der Decke von dem Ast zerstoert. "
    "man koennte meinen, dass die Baeume einen regelrechten Hass auf das Haus hatten."
  );
  AddDetail( ({ "hass", "eindruck", "haus" }),
    "Fast draengt sich dieser Eindruck auf."
  );
  AddDetail( ({ "himmel" }),
    "Der Himmel schaut duester zu Dir herab. Die Sonne ist komplett von Aesten, "
    "Blaettern und Wolken verdeckt."
  );
  AddDetail( ({ "sonne" }),
    "Die Sonne ist Dir verborgen."
  );
  AddDetail( ({ "wolken" }),
    "Duestere Wolken haengen am Himmel."
  );
  AddDetail( ({ "baeume" }),
    "Die Baeume sehen irgendwie bedrohlich aus."
  );
  AddDetail( ({ "zimmer", "raum" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holzbalken."
  );
  AddDetail( ({ "holzbalken", "balken" }),
    "Wie alles hier."
  );
  AddDetail( ({ "tuer", "mitleidenschaft" }),
    "Auch die Tuer wurde von dem Ast in Mitleidenschaft gezogen."
  );
  AddSpecialDetail( ({ "spiegel" }),
    "strSpiegel"
  );
  AddDetail( ({ "phantasie", "fantasie", "spiegelbild" }),
    "Phantasie braucht man schon bei diesem alten Spiegel."
  );
  AddDetail( ({ "nase" }),
    "Mit der riecht man."
  );
  AddDetail( ({ "wunder" }),
    "Bei diesem grossen Loch wundert es Dich nicht."
  );
  AddDetail( ({ "augenwinkel", "winkel" }),
    "Als Du genauer hinsiehst, ist der Schatten verschwunden."
  );
  AddDetail( ({ "schatten" }),
    "Du koenntest schwoeren, dass dort ein Schatten war. Aber von wem?"
  );

  AddSpecialDetail( ({ "unter bett", "unter das bett", "unter dem bett" }), "strBett");

  AddSound( DEFAULT_SOUND,
    "Der Wind rauscht durch die Aeste im Wald. Es klingt fast wie ein Klagelied."
  );

  AddSound( ({ "wind" }),
    "Der Wind pfeift und rauscht durch die Aeste und Blaetter im Wald.");
  AddSound( ({ "aeste", "blaetter", "wald" }),
    "Der Wind rauscht hindurch.");
  AddSound( ({ "klagelied", "lied", "rauschen" }),
    "Nur das Rauschen des Windes, oder doch nicht?");

  AddSmell( DEFAULT_SMELL,
    "Frische Waldluft dringt in Deine Nase. Kein Wunder bei diesem grossen Loch, "
    "welches der Ast gerissen hat."
  );
  AddSmell( ({ "waldluft", "luft" }),
    "Die frische Waldluft ist richtig wohltuend."
  );

  AddRoomMessage(
    ({"Irgendwer ist bei Dir!\n",
      "Jemand ist bei Dir!\n",
      "Du fuehlst Dich beobachtet!\n",
      "Der Wind rauscht durch die Aeste im Wald.\n",
      "Aus den Augenwinkeln nimmst du einen Schatten im Spiegel wahr!\n"}),60,
      "message");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_OEFFNEN, "cmd_oeffnen" );
  AddCmd( CMD_SCHLIESSEN, "cmd_schliessen" );
  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuchen" );
  AddCmd( ({"raeum", "raeume" }), "cmd_raeumen" );
  AddCmd( ({"stemm", "stemme" }), "cmd_stemmen" );
  AddCmd( ({"roll", "rolle" }), "cmd_rollen" );
  AddCmd( ({"putz", "putze" }), "cmd_putzen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", "in den Flur#" + "./flur" );

}

//--Funktion fuer AddRoomMessage--------------------------------------------

message(int msg)
{
  if (msg > 2)
    if (random(10) < 3)
      Message(BS("Du fuehlst Dich nicht wohl bei der Sache.\n"),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_putzen(string str)
{
  notify_fail("Was willst Du putzen?\n");

  if(!str || str == "") return 0;

  if(!(str == "spiegel" )) return 0;

  if(spiegel == DA)
  {
    SPUKMASTER->Msg(TP->Name()+" putzt den Spiegel.", ALL);
    write(BS("Mit viel Geduld reinigst Du den Spiegel"));
    Message(TP->Name(WER, 1)+" putzt den Spiegel.\n",
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    spiegel = WEG;
    return 1;
  }
  else
  {
    SPUKMASTER->Msg(TP->Name()+" versucht den SAUBEREN Spiegel zu putzen!", ALL);
    write(BS("Aber der Spiegel ist doch schon sauber!"));
    return -1;
  }
}

int cmd_raeumen(string str)
{
  notify_fail("Was willst Du wegraeumen?\n");

  if(!str || str == "") return 0;

  if(!(str == "ast weg" )) return 0;

  if(ast == DA)
  {
    SPUKMASTER->Msg(TP->Name()+" raeumt den Ast weg.", ALL);
    write(BS("Mit einer grossen Kraftanstrengung schaffst Du es, den "
            +"Ast ein wenig zur Seite zu raeumen."));
    Message(TP->Name(WER, 1)+" raeumt den Ast zur Seite.\n",
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    ast = WEG;
    return 1;
  }
  else
  {
    SPUKMASTER->Msg(TP->Name()+" versucht den NICHT vorhandenen Ast wegzuraeumen", ALL);
    write(BS("Aber der Ast stoert doch schon gar nicht mehr!"));
    return -1;
  }
}

int cmd_stemmen(string str)
{
  notify_fail("Was willst Du wegstemmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "ast weg" )) return 0;

  if(ast == DA)
  {
    SPUKMASTER->Msg(TP->Name()+" stemmt den Ast weg.", ALL);
    write(BS("Mit einer schweisstreibenden Kraftanstrengung schaffst Du es, den "
          +"Ast ein wenig zur Seite zu stemmen."));
    Message(TP->Name(WER, 1)+" stemmt den Ast zur Seite.\n",
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    ast = WEG;
    return 1;
  }
  else
  {
    SPUKMASTER->Msg(TP->Name()+" versucht den NICHT vorhandenen Ast wegzustemmen", ALL);
    write(BS("Aber der Ast stoert doch schon gar nicht mehr!"));
    return -1;
  }
}

int cmd_rollen(string str)
{
  notify_fail("Was willst Du wegrollen?\n");

  if(!str || str == "") return 0;

  if(!(str == "ast weg" )) return 0;

  if(ast == DA)
  {
    SPUKMASTER->Msg(TP->Name()+" rollt den Ast weg.", ALL);
    write(BS("Mit Leichtigkeit rollst Du den Ast zur Seite."));
    Message(TP->Name(WER, 1)+" rollt den Ast zur Seite.\n",
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    ast = WEG;
    return 1;
  }
  else
  {
    SPUKMASTER->Msg(TP->Name()+" versucht den NICHT vorhandenen Ast wegzurollen", ALL);
    write(BS("Aber der Ast stoert doch schon gar nicht mehr!"));
    return -1;
  }
}

int cmd_oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "nachtkaestchen" ) && !(str == "kaestchen")) return 0;

  if(kaestchen == ZU)
  {
    SPUKMASTER->Msg(TP->Name()+" oeffnet das Nachtkaestchen", ALL);
    write(BS("Du oeffnest das Nachtkaestchen."));
    Message(TP->Name(WER, 1)+" oeffnet das Nachtkaestchen.\n",
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    kaestchen = AUF;
    return 1;
  }
  else
  {
    SPUKMASTER->Msg(TP->Name()+" versucht das OFFENE Nachtkaestchen zu oeffnen", ALL);
    write(BS("Aber das Nachtkaestchen ist doch schon offen!"));
    return -1;
  }
}

int cmd_schliessen(string str)
{
  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;

  if(!(str == "nachtkaestchen" )) return 0;

  if(kaestchen == AUF)
  {
    SPUKMASTER->Msg(TP->Name()+" schliesst das Nachtkaestchen", ALL);
    write(BS("Du schliesst das Nachtkaestchen."));
    Message(TP->Name(WER, 1)+" schliesst das Nachtkaestchen.\n",
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    kaestchen = ZU;
    return 1;
  }
  else
  {
    SPUKMASTER->Msg(TP->Name()+" versucht das VERSCHLOSSENE Nachtkaestchen "
                   +"zu schliessen", ALL);
    write(BS("Aber das Nachtkaestchen ist doch schon geschlossen!"));
    return -1;
  }
}

int cmd_durchsuchen(string str)
{
  object ob;

  notify_fail("Was willst Du durchsuchen?\n");

  if(!str || str == "") return 0;


  if(str == "nachtkaestchen" || str == "kaestchen" || str == "plunder" || str == "inhalt")
  {
    if(kaestchen == ZU)
    {
      SPUKMASTER->Msg(TP->Name()+" versucht das VERSCHLOSSENE Kaestchen "
                                +"zu durchsuchen", ALL);
      write(BS("Aber das Nachtkaestchen ist doch geschlossen!"));
      return -1;
    }

    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
       (member(spieler, getuid(TP)) == -1)                          &&
       (ort == "kaestchen"))
    {
      ob = clone_object(OBJ "buchstabe2");

      write(BS("Du durchsuchst den Inhalt des Nachtkaestchens und findest "
      "tatsaechlich einen kleinen Holzklotz."));
      Message(BS(TP->Name(WER, 1)+" durchsucht das Nachtkaestchen."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt einen Buchstaben aus dem Nachtkaestchen", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen und laesst ihn fallen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", ALL);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" durchsucht das Nachtkaestchen", ALL);
    write(BS("Lauter Plunder. Davon hilft Dir nichts weiter."));
    Message(BS(TP->Name(WER, 1)+" durchsucht das Nachtkaestchen."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
  }

  if(str == "truemmer" )
  {
    if(ast == DA)
    {
      SPUKMASTER->Msg(TP->Name()+" versucht TROTZ AST die Truemmer zu "
                     +"durchsuchen", ALL);
      write(BS("Der Ast macht es Dir unmoeglich, die Truemmer zu durchsuchen."));
      return -1;
    }

    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
       (member(spieler, getuid(TP)) == -1)                          &&
       (ort == "truemmer"))
    {
      ob = clone_object(OBJ "buchstabe2");

      write(BS("Du durchsuchst die Truemmer sorgfaeltig und findest "
              +"tatsaechlich einen kleinen Holzklotz."));
      Message(BS(TP->Name(WER, 1)+" durchsucht die Truemmer"),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt einen Buchstaben aus den Truemmern", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen und laesst ihn fallen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", ALL);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" durchsucht die Truemmer", ALL);
    write(BS("Lauter Plunder. Davon hilft Dir nichts weiter."));
    Message(BS(TP->Name(WER, 1)+" durchsucht die Truemmer."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
  }

  return 0;
}

//--Funktionen fuer Details------------------------------------------------
string strBett(string str)
{
  string s;
  object ob;
  s = "";

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
    (member(spieler, getuid(TP)) == -1)                           &&
    (ort == "bett"))
  {
    ob = clone_object(OBJ "buchstabe2");

    s += "Du schaust unter das Bett und findest tatsaechlich ein "
        +"kleinen Holzklotz.";
    ob->SetOwner(getuuid(TP));
    spieler += ({ getuid(TP) });

    // Neuer Ort fuer den naechsten Spieler
    ort = welcherort();

    SPUKMASTER->Msg(TP->Name()+" nimmt einen Buchstaben unter "
                   +"dem Schalfzimmerbett", QUEST);

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      s+="Leider kannst Du ihn nicht mehr tragen und laesst ihn fallen.\n";
      SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", ALL);
      ob->move(TO,M_PUT);
    }
    Message(BS(TP->Name(WER, 1)+" schaut unter das Bett."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return BS(s);
  }

  SPUKMASTER->Msg(TP->Name()+" schaut unter das Schlafzimmerbett", ALL);
  s +="Es ist erstaunlich sauber unter dem Bett.";
  Message(BS(TP->Name(WER, 1)+" schaut unter das Bett."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return BS(s);
}

string strNachtkaestchen(string str)
{
  string s;

  s = "Ein altes, sehr stabil aussehendes Nachtkaestchen. Es hat den Sturz des "
     +"Astes unbeschadet ueberstanden. ";

  if(kaestchen == ZU)
  {
    s += "Es ist geschlossen, daher kannst Du nicht sagen, was sich in ihm "
        +"befindet.";
  }
  else
  {
    s += "Es ist offen, Du koenntest den Inhalt untersuchen.";
  }

  return BS(s);
}

string strInhalt(string str)
{
  string s;

  if(kaestchen == ZU)
  {
    s = "Sowas siehst Du da nicht!";
  }
  else
  {
    s = "Jede Menge Plunder. Vielleicht ist ja noch was nuetzliches dabei?";
  }
  return BS(s);
}

string strSpiegel(string str)
{
  string s;
  s = "Der Spiegel ist schon alt und verblichen. Nur mit viel Phantasie "
     +"kannst Du noch Dein Spiegelbild erkennen.";
  if(spiegel == DA)
  {
    s += " Vielleicht wuerdest Du mehr erkennen, wenn der Spiegel sauberer "
        +"waere.";
  }
  else
  {
    s += " Etwas verwundert stellst Du einen Schatten hinter Deinem "
        +"Spiegelbild fest.";

    // Fuer die Mutter braucht man alle 4 "Einfuehrungssequenzen"
    if(!SPUKMASTER->QueryPlayerSequence(getuid(TP), WOHNSEQ)      &&
       !SPUKMASTER->QueryPlayerSequence(getuid(TP), KUECHESEQ)    &&
       !SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)    &&
       !SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ) &&
       spiegelseq)
    {
      // Nicht 2mal die gleiche Seq
      if(!SPUKMASTER->QueryPlayerSequence(getuid(TP), MUTTER))
      {
        return BS(s);
      }
      write(BS(s));
      write(BS("Ploetzlich wird der Schatten immer klarer und Du kannst "
              +"eine aeltere Frau in einem weissen Kleid mit Blumenmuster "
              "erkennen."));
      Message(BS(TP->Name()+" starrt fasziniert in den Spiegel."),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      spiegelseq = WEG;
      SPUKMASTER->Msg(TP->Name()+" schaut in den Spiegel.", QUEST);
      TP->SetProp(P_PARALYZED, ([
        PARALYZE_TIME:70,
        PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
        PARALYZE_MSG_OTHER:"%s ist einfach fasziniert von dem Spiegel.\n",
        PARALYZE_END:"",
        PARALYZE_END_OTHER:""
      ]));

      SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 0]) );

      SequenceSpiegel(TP);
      SPUKMASTER->AddPlayerSequence(getuid(TP), MUTTER);

      return "";
    }
  }
  return BS(s);
}

// Was ist der richtige Ort?
string welcherort()
{
  return auswahl[random(sizeof(auswahl))];
}

// Debugzwecke
string QueryOrt()
{
  return ort;
}
// Debugzwecke
string *QuerySpieler()
{
  return spieler;
}

reset()
{
  ::reset();

// Pro Reset neuer Ort
  ort = welcherort();
  spieler = ({ });

  if(ast == WEG)
  {
    Message(BS("Der Ast verliert seinen Halt und rollt auf die Truemmer."),
            MSGFLAG_VISUAL);
    ast = DA;
  }
  if(kaestchen == AUF)
  {
    Message(BS("Wie durch Geisterhand wird das Nachtkaestchen wieder geschlossen."),
            MSGFLAG_VISUAL);
    kaestchen = ZU;
  }

  spiegel = DA;
}
// Waehrend sequenzen RoomMessages ausschalten
void removeRoomMessage()
{
  AddRoomMessage( "",60,"");
}

void resetRoomMessage()
{
  AddRoomMessage(
    ({"Irgendwer ist bei Dir!\n",
      "Jemand ist bei Dir!\n",
      "Du fuehlst Dich beobachtet!\n",
      "Der Wind rauscht durch die Aeste im Wald.\n",
      "Aus den Augenwinkeln nimmst du einen Schatten im Spiegel wahr!\n"}),60,
      "message");
}

void resetSpiegel(object player)
{
  // Spiegel wieder zuruecksetzen
  if(player)
  {
    Message(BS(player->Name(WER, 1)+" verschmiert den Spiegel und schaut "
           +"sich verwundert danach um. "),
           MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ player }) ]) );
  }
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20]) );
  spiegelseq = DA;
  spiegel = DA;
  resetRoomMessage();
}

int SequenceSpiegel(object player)
{
  if (player)
  {
    removeRoomMessage();
    SPUKMASTER->sequencer(player, 0, ({
  0, "#Kaelte ... Dir wird kalt ...",
  4, "#Die Frau im Spiegel starrt Dich an... irgendwie unheimlich",
  4, "#\"Ja, Du siehst so aus, als ob Du mir helfen koenntest.\"",
  4, "#\"Meine Kinder, staendig streiten sie und geben keine Ruhe.\"",
  4, "#\"Wenn ich den Teddy meiner Tochter haette, koennte ich sie "
    +"versoehnen.\"",
  4, "#\"Bring ihn mir bitte, dann koennen wir endlich Ruhe finden...\"",
  4, "#Wo ist der Teddy?",
  4, "#Stille.",
  6, "#Du schaust wieder in den Spiegel, jedoch erkennst Du nichts mehr "
    +"aufgrund einer Rauhreifschicht. Wo die wohl herkommt? Deine Versuche, "
    +"sie wegzuwischen, verdrecken den Spiegel nur noch mehr.",
  0, "*resetSpiegel"
    }), TO);
  }
  return 1;
}