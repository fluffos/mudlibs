#include "../def.h"

inherit "std/room";


string *auswahl;
string welcherort();
string ort;
string *spieler;

int tueroffen();
status keule, helm, ratte, regal;
void create()
{
  ::create();

  keule = helm = ratte = regal = DA;

  spieler = ({ });
// Welche Haufen sind moeglich
  auswahl = ({ "regal","loch","werkzeug"});
// Welcher ist der richtige?
  ort = welcherort();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Keller");
  SetProp(P_INT_LONG,
    "Was fuer ein Chaos. Ueberall liegt unidentifizierbares Zeug herum. "
    "Ein grosses Regal mit verfallenen Vorraeten ist noch das beste davon. "
    "Das Gelaender der Treppe, die nach unten fuehrt, liegt auf dem Boden."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "chaos" }),
    "Alles ist unordentlich und durcheinandergewirbelt worden."
  );
  AddDetail( ({ "zeug" }),
    "Erkennen kann man nichts mehr. Entweder es wurde beschaedigt oder ist "
    "verfallen."
  );
  AddDetail( ({ "regal" }),
    "Das Regal mit den verfallenen Vorraeten ist das einzige, was eindeutig "
    "identifizierbar ist."
  );
  AddDetail( ({ "vorraeten", "vorraete", "menge" }),
    "Jede Menge verfallene Vorraete, nicht einmal Ratten wuerden davon etwas "
    "fressen. Erstaunlich, dass sie damals zurueckgelassen wurden."
  );
  AddDetail( ({ "ratten" }),
    "Selbst Ratten wuerden diese Vorraete nicht anruehren."
  );
  AddDetail( ({ "gelaender" }),
    "Das Gelaender liegt auf dem Boden."
  );
  AddDetail( ({ "treppe" }),
    "Die Treppe besteht aus morschen Holzstufen. Das Gelaender, welches frueher "
    "als Halt dienen sollte, ist abgebrochen und liegt auf dem Boden."
  );
  AddDetail( ({ "holzstufen", "stufen" }),
    "Die Stufen sind alt und morsch. Eine Stufe ist bereits rausgebrochen und "
    "hat ein ansehnliches Loch hinterlassen."
  );
  AddDetail( ({ "halt" }),
    "Das Gelaender sollte frueher Halt bieten."
  );
  AddDetail( ({ "stufe" }),
    "Eine Stufe ist rausgebrochen."
  );
  AddDetail( ({ "loch" }),
    "Ein dunkles Loch. Ob sich darin etwas befindet?"
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist mit Geruempel und Muell uebersaeht."
  );
  AddDetail( ({ "geruempel" }),
    "Einige wenige Gegenstaende kannst Du unter dem Geruempel noch identifizieren."
  );
  AddDetail( ({ "muell", "haufen" }),
    "In einer Ecke hat sich ein ansehnlicher Haufen Muell angesammelt. "
    "Was das wohl alles mal war?"
  );
  AddDetail( ({ "ecke" }),
    "An ansehnlicher Haufen Muell hat sich hier angesammelt."
  );
  AddDetail( ({ "gegenstaende" }),
    "Einige Werkzeuge sind darunter. Alle verrostet und vermodert."
  );
  AddDetail( ({ "werkzeuge" }),
    "Davon ist nichts mehr zu gebrauchen."
  );
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus morschen Holzbalken. Ein Skelett, welches Dir vorher "
    "bei all dem Zeug hier nicht aufgefallen ist, lehnt an der Wand."
  );
  AddSpecialDetail( ({ "skelett", "ogerskelett" }),
    "strSkelett"
  );
  AddSpecialDetail( ({"keule", "zahn", "zeit", "arbeit", "zustand", 
                      "griffstueck", "griff", "lederbaender", "baender",
                      "kopfstueck", "stueck", "eisendornen", "dornen", 
                      "eisendorne", "dorne", "rost" }),
    "strKeule"
  );

  AddSpecialDetail( ({ "hand", "haende" }),
    "strHaende"
  );
  AddDetail( ({ "helm", "schutz" }),
    "Der Helm ist alt und verbeult. Effektiven Schutz wuerde er nicht mehr bieten."
  );

  AddDetail( ({ "schaedel" }),
    "Der Schaedel hat eine fliehende Stirn."
  );
  AddDetail( ({ "schultern", "schulter" }),
    "Haengende Schultern sind typisch fuer Oger."
  );
  AddDetail( ({ "stirn" }),
    "Die fliehende Stirn des Skeletts deutet auf einen Oger hin."
  );
  AddDetail( ({ "oger" }),
    "Warum der Oger hier wohl gestorben ist? Gewalteinwirkung kannst Du keine "
    "feststellen."
  );
  AddDetail( ({ "gewalteinwirkung" }),
    "Es sieht eher so aus, als ob der Oger vor Angst bis zur Wand "
    "zurueckgekrochen ist."
  );
  AddDetail( ({ "angst" }), // und warum wird es ploetzlich so kalt ...
    "Wovor sollte ein Oger solche Angst haben?"
  );
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus Holzbalken."
  );
  AddDetail( ({ "holzbalken", "haus" }),
    "Alles ist morsch und faul. Sogar die Holzbalken die das Haus tragen. "
    "Es wuerde Dich nicht wundern, wenn das Haus ueber Deinem Kopf zusammenbricht."
  );
  AddDetail( ({ "kopf" }),
    "Du kratzt Dich am Kopf."
  );
  AddDetail( ({ "kraft" }),
    "Ob Deine Kraft ausreicht, weisst Du nicht."
  );
  AddDetail( ({ "holz", "sicherheit", "ogerwald" }),
    "Das Holz stammt mit Sicherheit aus dem Ogerwald."
  );
  AddDetail( ({ "nase" }),
    "Damit riechst Du."
  );
  AddDetail( ({ "loch" }),
    "Tatsaechlich, dort ist ein Loch in der Wand."
  );

  AddSound( DEFAULT_SOUND,
    "Totenstille."
  );

  AddSound( ({ "totenstille", "toten", "tote" }),
    "Ob die Toten wirklich so still sind ...");

  AddSmell( DEFAULT_SMELL,
    "Der Geruch verfallener Vorraete steigt Dir in die Nase."
  );

  AddSmell( ({ "geruch" }),
    "Unangenehm."
  );
  AddSmell( ({ "vorraete", "muell", "haufen" }),
    "Du weisst gar nicht, was schlimmer stinkt, die Vorraete oder der Haufen "
    "Muell in der Ecke."
  );

  AddRoomMessage(
    ({"Eine Ratte lugt aus einem Loch hervor, verschwindet aber sofort wieder.\n",
      "Hat sich das Skelett bewegt?\n",
      "Du fuehlst Dich beobachtet!\n"}),60,"");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_NEHMEN, "cmdnehmen" );
  AddCmd( ({ "beweg", "bewege" }), "cmdbewegen" );
  AddCmd( CMD_GREIFEN, "cmd_greifen" );
  AddCmd( CMD_UNTERSUCHEN, "cmd_schau" );
  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuchen" );

//--Ausgaenge--------------------------------------------------------------

    NewDoor("oben", ROOM "eingang" , ({"tuer", "holztuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Holztuer.",
      D_LONG, "Die Tuer besteht aus dicken Holzbalken. Sie haengt ein wenig "
      "schief. Um sie zu oeffnen, benoetigt man mehr Kraft als ueblich.",
      D_NAME,  "Holztuer",
      D_GENDER,FEMALE,
      D_MSGS, "nach oben",
      D_TESTFUNC, "exit_test",
      D_RESET_CLOSEMSG, " wird wie von Geisterhand geschlossen!\n"
    })
  );

}

//--Funktionen fuer Details------------------------------------------------

string strSkelett(string key)
{
  string s;
  s = "Die haengenden Schultern und die fliehende Stirn des Schaedels "
     +"deuten auf ein Ogerskelett hin. ";
  
  if(keule == DA)
    s+="Es haelt in seiner rechten Hand eine verrostete Keule. ";
  if(helm == DA)
    s+="Seine linke Hand haelt einen Helm umklammert.";

  return BS(s);
}

string strHaende(string key)
{
  string s;
  s = "";
  if(keule == DA)
    s+="Es haelt in seiner rechten Hand eine verrostete Keule. ";
  if(helm == DA)
    s+="Seine linke Hand haelt einen Helm umklammert.";
  if(keule == WEG && helm == WEG) s = "Seine Haende sind leer.";
  return BS(s);
}

string strKeule(string key)
{
  string s;
  s = "";
  switch(key) {
    case "keule":
      s = "Die Keule ist aus massivem Holz gefertigt. Dennoch hat auch bei "
         +"ihr der Zahn der Zeit seine Arbeit getan. Das Griffstueck ist mit "
         +"Lederbaendern umwickelt, das Kopfstueck ist mit hunderten "
         +"Eisendornen gespickt.";
      break;
    case "zahn":
    case "zeit":
    case "arbeit":
    case "zustand":
      s = "Die Keule ist in keinem guten Zustand.";
      break;
    case "griffstueck":
    case "griff":
      s = "Das Griffstueck ist schlicht gehalten, lediglich ein paar "
         +"Lederbaender sorgen fuer einen besseren Griff.";
      break;
    case "lederbaender":
    case "baender":
      s = "Die Baender sind alt und verfault.";
      break;
    case "kopfstueck":
      s = "Das Kopfstueck ist mit hunderten Eisendornen gespickt.";
      break;
    case "stueck":
      s = "Welches Stueck meinst Du? Kopf- oder Griffstueck?";
      break;
    case "eisendornen":
    case "dornen":
    case "eisendorne":
    case "dorne":
      s = "Nur wenig Rost hat sich an den Eisendornen abgelegt.";
      break;
    case "rost":
      s = "Die Eisendornen sind noch am besten erhalten.";
      break;
    default:
      break;
  }
  
  return BS(s);
}

//--Funktionen fuer Kommandos----------------------------------------------

//Werkzeug durchsuchen
int cmd_durchsuchen(string str)
{
  object ob;

  notify_fail("Was willst Du durchsuchen?\n");

  if(!str || str == "") return 0;

  if(str == "werkzeug" || str == "werkzeuge" || str == "geruempel" ||
     str == "gegenstaende")
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDER)) &&
       (member(spieler, getuid(TP)) == -1)                    &&
       (ort == "werkzeug"))
    {
      ob = clone_object(OBJ "teddy");
      write(BS("Du durchsuchst die Werkzeuge und findest tatsaechlich einen "
              +"Teddy"));
      Message(BS(TP->Name(WER, 1)+" durchsucht die Werkzeuge."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      ob->SetOwner(getuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt den Teddy von den Werkzeugen", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen und laesst es fallen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Teddy nicht mehr tragen", ALL);
        ob->move(TO,M_PUT);
      }
      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" durchsucht die Werkzeuge", ALL);
    write(BS("Nichts interessantes dabei."));
    Message(BS(TP->Name(WER, 1)+" durchsucht die Werkzeuge."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
  }

  if(str == "schublade" || str == "lade")
  {
    write(BS("Die Schublade ist verschlossen. So einfach geht das leider nicht."));
    Message(BS(TP->Name(WER, 1)+" ruettelt an der Schublade."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" versucht die Schublade zu durchsuchen", ALL);
    return -1;
  }

  if(str == "muell" || str == "haufen")
  {
    write(BS("Dir wird schon bei dem Gedanken daran schlecht."));
    SPUKMASTER->Msg(TP->Name()+" will den Muell durchsuchen", ALL);
    return -1;
  }

  if(str == "vorraete")
  {
    write(BS("Du kannst gar nicht glauben, dass das mal etwas Essbares "
            +"darstellte. Vielleicht waere es Sinnvoller,  das gesamte "
            +"Regal zu durchsuchen."));
    SPUKMASTER->Msg(TP->Name()+" will die Vorraete durchsuchen", ALL);
    return -1;
  }

  if(str == "regal")
  {
    string s;
    s = "Du durchsuchst das Regal und findest nichts. Dir faellt "
       +"aber auf, dass es sehr locker ist.";
    if(regal == DA) s += " Du koenntest ohne Muehe das Regal bewegen und "
                        +"dahinter schauen.";
    
    write(BS(s));
    SPUKMASTER->Msg(TP->Name()+" will das Regal durchsuchen", ALL);
    return -1;
  }

  return (notify_fail( "DAS kannst Du nicht durchsuchen!\n" ),0);
}

// in Loch greifen
int cmd_greifen(string str)
{
    object ob;
//  notify_fail("Worunter willst Du schauen?\n");

  if(!str || str == "") return 0;

  if(str == "in loch" || str == "loch")
  {

    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDER)) &&
        (member(spieler, getuid(TP)) == -1)                         &&
        (ort == "loch"))
    {
      ob = clone_object(OBJ "teddy");
      write(BS("Du schaust hinter das Regal und findest tatsaechlich "
              +"den Teddy. Schnell nimmst Du ihn an Dich."));
      Message(BS(TP->Name(WER, 1)+" schaut hinter das Regal."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt den Teddy von hinter dem Regal", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Teddy nicht mehr tragen", ALL);
        ob->move(TO,M_PUT);
      }

      return 1;
    }
    else if(ratte == DA)
    {
      ob = clone_object(NPC "ratte");
      ob->move(TO, M_GO|M_SILENT);
      write(BS("Du greifst in das Loch, scheuchst aber nur eine Ratte auf."));
      Message(BS(TP->Name(WER, 1)+" greift in das Loch."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      SPUKMASTER->Msg(TP->Name()+" greift in das Loch", ALL);
      ratte = WEG;
      return -1;
    }

    write(BS("Du greifst in das Loch, findest jedoch nichts."));
    Message(BS(TP->Name(WER, 1)+" greift in das Loch."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" greift in das Loch", ALL);
    return -1;
  }

  return 0;

}

// hinter Regal schauen
int cmd_schau(string str)
{
  object ob;
//  notify_fail("Worunter willst Du schauen?\n");

  if(!str || str == "") return 0;

  if(str == "hinter regal" )
  {
    if(regal == DA)
    {
      write(BS("So wird das leider nichts, Du musst das Regal schon "
              +"bewegen, um dahinter schauen zu koennen"));
      SPUKMASTER->Msg(TP->Name()+" will hinter das Regal schauen OHNE bewegen", ALL);
      return -1;
    }

    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDER)) &&
        (member(spieler, getuid(TP)) == -1)                         &&
        (ort == "regal"))
    {
      ob = clone_object(OBJ "teddy");
      write(BS("Du schaust hinter das Regal und findest tatsaechlich "
              +"den Teddy. Schnell nimmst Du ihn an Dich."));
      Message(BS(TP->Name(WER, 1)+" schaut hinter das Regal."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt den Teddy von hinter dem Regal", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Teddy nicht mehr tragen", ALL);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    write(BS("Ausser noch mehr Muell findest Du leider nichts."));
    Message(BS(TP->Name(WER, 1)+" schaut hinter das Regal."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" schaut hinter das Regal", ALL);
    return 1;
  }

  return 0;

}

// Regal bewegen
int cmdbewegen(string str)
{
  notify_fail("Was willst Du bewegen?\n");
  
  if (!stringp(str)) { return 0; }  

  if(str == "regal" )
  {
    if(regal == WEG)
    {
      write(BS("Das Regal wurde bereits bewegt."));
      SPUKMASTER->Msg(TP->Name()+" will das Regal ERNEUT bewegen", ALL);
      return -1;
    }
    write(BS("Mit Leichtigkeit ziehst Du das Regal nach vorne. Jetzt "
            +"kannst Du sehr leicht dahinter schauen."));
    Message(BS(TP->Name(WER, 1)+" zieht an dem Regal."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" bewegt das Regal", ALL);
    regal = WEG;
    return 1;
    
  }
}

// Keule oder Helm nehmen
int cmdnehmen(string str)
{
  object ob;

  notify_fail("Was willst Du nehmen?\n");
  
  if (!stringp(str)) { return 0; }  

  switch (str)
  {
  	case "keule":
      if(keule == DA)
      {
        ob=clone_object(WEAPON "keule");

        if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
        {
          write("Du kannst die Keule nicht tragen.\n");
          ob->remove();
          return -1;
        }
        else
        {
          write(BS("Du entwindest dem Skelett die verrostete Keule."));
          Message(BS(TP->Name()+" nimmt eine Keule."), 
                  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          keule = WEG;
          RemoveDetail( ({"keule", "zahn", "zeit", "arbeit", "zustand", 
                          "griffstueck", "griff", "lederbaender", "baender",
                          "kopfstueck", "stueck", "eisendornen", "dornen", 
                          "eisendorne", "dorne", "rost" }) );
          return 1;
        }
      }
      return 0;
  	case "helm":
      if(helm == DA)
      {
        ob=clone_object("/p/armour/helm/eisenhelm");

        if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
        {
          write("Du kannst den Helm nicht mehr tragen.\n");
          ob->remove();
          return -1;
        }
        else
        {
          write(BS("Du nimmst den Helm aus der Hand des Skeletts."));
          Message(BS(TP->Name()+" nimmt einen Helm."), 
                  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          ob->TakeFlaw(500);
          helm = WEG;
          RemoveDetail( ({ "helm", "schutz" }));
          return 1;
        }
      }
      return 0;
    default:
      return 0;
  }
}

void begruessung()
{
  if(tueroffen())
  {
    Message("\n*RUMMS*\n\nDie Tuer wurde von irgendwem zugeschlagen!\n");
    DOOR_MASTER->SetDoorStatus(ROOM "eingang", D_STATUS_CLOSED);
    return;
  }
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  if (find_call_out("begruessung") != -1) return;

  call_out("begruessung", 0);

}

int tueroffen()
{
  return (DOOR_MASTER->QueryDoorStatus(ROOM "eingang")==D_STATUS_OPEN);
}

// Was ist der richtige Ort?
string welcherort()
{
  return auswahl[random(sizeof(auswahl))];
}

// Debugzwecke
string QueryOrt()
{
  return ort;
}
// Debugzwecke
string *QuerySpieler()
{
  return spieler;
}

reset()
{
  ::reset();
  
  if(helm == WEG)
  {
    AddDetail( ({ "helm", "schutz" }),
      "Der Helm ist alt und verbeult. Effektiven Schutz wuerde er nicht mehr bieten."
    );
    helm = DA;
  }
  if(keule == WEG)
  {
    AddSpecialDetail( ({"keule", "zahn", "zeit", "arbeit", "zustand", 
                        "griffstueck", "griff", "lederbaender", "baender",
                        "kopfstueck", "stueck", "eisendornen", "dornen", 
                        "eisendorne", "dorne", "rost" }),
      "strKeule"
    );
    keule = DA;
  }
  
  if(regal == WEG)
  {
    Message(BS("Ploetzlich bewegt sich das Regal an seinen alten Platz - "
              +"unheimlich!"), MSGFLAG_VISUAL);
    regal = DA;
  }          
  ratte = DA;
}

