#include "../def.h"

inherit "std/room";

int Sequence(object player);

string sessel;
string *spieler;
string haufen;
string *auswahl;
string welcherhaufen();

void create()
{
  ::create();

  sessel = WEG;
  spieler = ({ });

// Welche Haufen sind moeglich
  auswahl = ({ "asche","truemmerhaufen","steinhaufen"});
// Welchee ist der richtige?
  haufen = welcherhaufen();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem verfallenen Wohnzimmer");
  SetProp(P_INT_LONG, "Fehler!"
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, QUEST);
  SetProp(P_INDOORS, QUEST);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "bild" }),
    "Auch hier bietet sich Deinem getruebten Auge kein besseres Bild."
  );
  AddDetail( ({ "auge", "augen" }),
    "Du zueckst ein Messer, um Deine Augen zu untersuchen ..."
  );
  AddDetail( ({ "messer" }),
    "Willst Du das wirklich tun?"
  );
  AddSpecialDetail( ({ "mitte" }), "strMitte");
  AddDetail( ({ "polster", "gewalteinwirkung" }),
    "Die Polster des Sessels sind zerrissen. Ein Riss sieht anders aus als "
    "die anderen."
  );
  AddDetail( ({ "riss" }),
    "Dieser breite lange Riss wurde scheinbar von einem Schwert oder "
    "aehnlichem hervorgerufen."
  );
  AddDetail( ({ "schwert" }),
    "Sehen kannst Du keins. Vielleicht war es auch etwas anderes."
  );
  AddDetail( ({ "alter" }),
    "Du kannst das Alter nicht genau bestimmen."
  );
  AddSpecialDetail( ({ "raum", "raumes" }), "strRaum");
  AddSpecialDetail( ({ "sessel" }), "strSessel" ); // aufstellen
  AddDetail( ({ "truemmerhaufen" }), // durchsuchen
    "Du kannst drei Tischbeine und eine zertruemmerte Tischplatte erkennen. "
    "Da hat jemand ganze Arbeit geleistet."
  );
  AddDetail( ({ "tischbeine", "tischbein", "beine", "bein" }),
    "Drei Tischbeine liegen in dem Truemmerhaufen. Wo ist wohl das letzte"
    " geblieben?"
  );
  AddDetail( ({ "tischplatte", "platte" }),
    "Obwohl die Tischplatte frueher mal sehr massiv gewesen sein muss, "
    "wurde sie vollkommen zertruemmert."
  );
  AddDetail( ({ "arbeit" }),
    "Vielleicht solltest Du den Truemmerhaufen genauer untersuchen, um "
    "herauszufinden, wer hier ganze Arbeit geleistet hat."
  );
  AddDetail( ({ "tisch" }),
    "Der Tisch ist nur noch ein einziger Truemmerhaufen."
  );
  AddDetail( ({ "kamin" }),
    "Der Kamin ist voller Asche, es scheint so, als ob der Abzug nicht mehr "
    "funktioniert."
  );
  AddDetail( ({ "abzug" }),
    "Ohne funktionierenden Abzug sollte man den Kamin besser nicht anzuenden."
    " Andernfalls wuerde der ganze Rauch ins Zimmer kommen."
  );
  AddDetail( ({ "rauch" }),
    "Der Rauch haette als einzigen Ausweg nur das Zimmer."
  );
  AddDetail( ({ "zimmer", "ausweg" }),
    "Wohin sollte der Rauch sonst entweichen?"
  );
  AddDetail( ({ "wand", "westwand" }),
    "An der Westwand befindet sich der Kamin. Direkt davor liegt ein Teil des"
    " Kaminsimes, der herausgebrochen ist."
  );
  AddDetail( ({ "asche" }),
    "Die Asche scheint dort schon sehr lange zu liegen. Dir scheint fast, "
    "als wenn sich sogar auf sie Staub gelegt hat."
  );
  AddDetail( ({ "staub" }),
    "Ueberall befindet sich Staub, sogar auf die Asche im Kamin scheint "
    "sich welcher gelegt zu haben."
  );
  AddDetail( ({ "teil" }),
    "Ein Teil des Kaminsimes ist rausgebrochen und liegt direkt vor dem Kamin."
  );
  AddDetail( ({ "kaminsims", "sims" }),
    "Frueher standen sicher Bilder und anderer Kitsch auf dem Kaminsims. "
    "Vielleicht sogar einer dieser unnoetigen Pokale, mit denen man vor der "
    "Verwandtschaft angibt."
  );
  AddDetail( ({ "pokal", "pokale", "siegerpokal", "siegerpokale" }),
    "Zum Beispiel Siegerpokale vom Minigolf in der untersten Kreisklasse."
  );
  AddDetail( ({ "beispiel" }),
    "Dir fallen bestimmt noch andere Beispiele ein."
  );
  AddDetail( ({ "minigolf", "golf", "sportart" }),
    "Oder einer anderen hochangesehenen Sportart."
  );
  AddDetail( ({ "kreisklasse" }),
    "Pokale aus der untersten Kreisklasse."
  );
  AddDetail( ({ "kitsch", "art", "spieluhren", "spieluhr" }),
    "Spieluhren mit Feen oder so etwas in der Art."
  );
  AddDetail( ({ "verwandtschaft" }),
    "Die bucklige Verwandtschaft, die man nie sehen will und viel zu haeufig "
    "sehen muss."
  );
  AddDetail( ({ "feen" }),
    "Die Feen leben in einem Schloss noerdlich von Midas."
  );
  AddDetail( ({ "schloss", "midas" }),
    "Dort sieht es nicht so verfallen aus wie hier."
  );
  AddDetail( ({ "bilder" }),
    "Meistens werden Familienbilder auf Kaminsimsen abgestellt. Hier jedoch "
    "kannst Du keine erkennen. Nicht einmal in dem Steinhaufen vor dem Kamin,"
    " der einstmals ein Teil des Simses war."
  );
  AddDetail( ({ "familienbilder", "familienbild" }),
    "Bilder von Geburtstagen oder Hochzeiten oder sonstigen Ereignissen."
  );
  AddDetail( ({ "ereignissen", "ereignisse" }),
    "Oder Beerdigungen."
  );
  AddSpecialDetail( ({ "geburtstagen", "geburtstag", "geburtstage" }), 
    "strGeburtstag" );
  AddSpecialDetail( ({ "hochzeiten", "hochzeit" }), "strHochzeit"  );
  AddSpecialDetail( ({ "beerdigung", "beerdigungen" }), "strBeerdigung"  );
  AddDetail( ({ "steinhaufen" }),
    "Lustlos durchwuehlst Du den Steinhaufen. Nichts zu finden."
  );
  AddDetail( ({ "haufen" }),
    "Welchen Haufen meinst Du? Den Steinhaufen vor dem Kamin oder den "
    "Truemmerhaufen?"
  );
  AddDetail( ({ "tonscherben", "scherben" }),
    "Die Scherben in dem Truemmerhaufen waren frueher mal ein Krug."
  );
  AddDetail( ({ "krug" }),
    "Der Krug liegt in Scherben. Damit kannst Du nichts mehr anfangen."
  );
  AddDetail( ({ "waende" }),
    "Welche Wand meinst Du genau?"
  );
  AddDetail( ({ "suedwand", "nordwand" }),
    "Die Sued- und Nordwand bestehen wie fast alles hier aus Holzbohlen. "
    "Verzierungen jeglicher Art sind nicht vorhanden."
  );
  AddDetail( ({ "verzierungen", "verzierung", "gemaelde" }),
    "Gemaelde oder sonstiges sucht man hier vergebens."
  );
  AddDetail( ({ "ostwand" }),
    "Im Osten befindet sich der Eingang. Die Truemmer einer Tuer liegen dort."
  );
  AddDetail( ({ "truemmer", "tuer" }),
    "Die Truemmer der Tuer liegen im Eingang."
  );
  AddDetail( ({ "decke", "boden" }),
    "Decke und Boden bestehen aus Holzbalken."
  );
  AddDetail( ({ "holzbalken", "balken", "haustuer", "holz" }),
    "Das Holz fuer die Balken, aus denen das Haus besteht, wurde aus dem Wald"
    " vor der Haustuer geholt."
  );
  AddDetail( ({ "haus" }),
    "Ein altes, verfallenes Haus."
  );
  AddDetail( ({ "wald" }),
    "Der befindet sich draussen."
  );
  AddDetail( ({ "zustand", "wort", "chaos" }),
    "Der Zustand laesst sich mit einem Wort beschreiben. Chaos."
  );

  AddSound( DEFAULT_SOUND,
    "Du kannst nichts besonderes hoeren. Die Geraeusche des Waldes "
    "dringen nicht bis hierher vor."
  );

  AddSound( ({ "geraeusche", "geraeusch" }),
    "Nichts.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht gar nicht so alt und abgestanden, wie es der Zustand "
    "des Raumes erwarten lassen koennte."
  );

  AddSmell( ({ "luft", "waldluft" }),
    "Die Luft riecht relativ gut."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuchen" );
  AddCmd( ({ "stelle", "stell" }), "cmd_aufstellen" );
  AddCmd( ({ "zuende", "zuend" }), "cmd_anzuenden" );
  AddCmd( ({ "wisch", "wische" }), "cmd_wischen" );
  AddCmd( ({ "kapitulier", "kapituliere" }), "cmd_kapitulier" );
  AddCmd( CMD_SETZEN, "cmd_setzen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", "nach Osten#" + "./eingang" );

}

//--Funktionen fuer Kommandos----------------------------------------------

//Versteck fuer einen Buchstaben
int cmd_durchsuchen(string str)
{
  object ob;
  notify_fail("Was willst Du durchsuchen?\n");

  if(!str || str == "") return 0;

  if(str == "haufen")
  {
    write(BS("Welchen Haufen meinst Du genau?"));
    return -1;
  }

  ob = clone_object(OBJ "walze");

  if(str == "truemmerhaufen" )
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
       (member(spieler, getuid(TP)) == -1)                       &&
       (haufen == "truemmerhaufen"))
    {

      write(BS("Du durchsuchst den Truemmerhaufen und findest tatsaechlich "
              +"eine alte Schreibwalze."));
      TO->Message(BS(TP->Name(WER, 1)+" durchsucht den Truemmerhaufen und "
          "grinst triumphierend."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Haufen fuer den naechstn Spieler
      haufen = welcherhaufen();

      SPUKMASTER->Msg(TP->Name()+" nimmt die Schreibwalze aus dem "
                     +"Truemmerhaufen", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du die Schreibwalze nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann die Schreibwalze nicht tragen", ALL);
        ob->move(TO,M_PUT);
        return -1;
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" durchsucht den Truemmerhaufen", ALL);
    write(BS("Du durchsuchst den Truemmerhaufen, findest aber ausser ein "
            +"paar Tonscherben nichts."));
    TO->Message(BS(TP->Name(WER, 1)+" durchsucht den Truemmerhaufen."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
  }

  if(str == "steinhaufen" )
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
       (member(spieler, getuid(TP)) == -1)                       &&
       (haufen == "steinhaufen"))
    {

      write(BS("Du durchwuehlst den Steinhaufen und findest tatsaechlich "
              +"eine alte Schreibwalze."));
      TO->Message(BS(TP->Name(WER, 1)+" durchwuehlt den Steinhaufen und grinst"
          " triumphierend."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Haufen fuer den naechstn Spieler
      haufen = welcherhaufen();

      SPUKMASTER->Msg(TP->Name()+" nimmt die Schreibwalze aus dem "
                     +"Steinhaufen", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du die Schreibwalze nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann die Schreibwalze nicht tragen", ALL);
        ob->move(TO,M_PUT);
        return -1;
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" durchwuehlt den Steinhaufen", ALL);
    write(BS("Du durchwuehlst den Steinhaufen, kannst aber nichts "
            +"interessantes finden."));
    TO->Message(BS(TP->Name(WER, 1)+" durchwuehlt den Steinhaufen."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }

  if(str == "asche" )
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
       (member(spieler, getuid(TP)) == -1)                       &&
       (haufen == "asche"))
    {

      write(BS("Du stocherst in der Asche herum und findest tatsaechlich "
              +"eine alte Schreibwalze."));
      TO->Message(BS(TP->Name(WER, 1)+" stochert in der Asche herum und grinst "
          "triumphierend."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Haufen fuer den naechstn Spieler
      haufen = welcherhaufen();

      SPUKMASTER->Msg(TP->Name()+" nimmt die Schreibwalze aus der Asche", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du die Schreibwalze nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann die Schreibwalze nicht tragen", ALL);
        ob->move(TO,M_PUT);
        return -1;
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" stochert in der Asche", ALL);
    write(BS("Du stocherst in der Asche herum."));
    TO->Message(BS(TP->Name(WER, 1)+" stochert in der Asche herum."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }

  if(str == "staub" )
  {
    write(BS("Wie willst Du Staub durchsuchen??"));
    ob->remove();
    return -1;
  }
  ob->remove();
  return 0;

}

int cmd_aufstellen(string str)
{
  notify_fail("Was willst Du aufstellen?\n");

  if(!str || str == "") return 0;
  if(!(str == "sessel auf")) return 0;

  if(sessel == WEG)
  {
    SPUKMASTER->Msg(TP->Name()+" stellt den Sessel auf", ALL);
    write(BS("Du stellst den Sessel wieder auf."));
    Message(BS(TP->Name(WER, 1)+" stellt den Sessel wieder auf."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    sessel = "";
    return 1;
  }
  else
  {
    write(BS("Aber der Sessel wurde schon aufgestellt!"));
    return -1;
  }
}

int cmd_anzuenden(string str)
{
  notify_fail("Was willst Du anzuenden?\n");

  if(!str || str == "") return 0;
  if(!(str == "kamin an")) return 0;
 
  SPUKMASTER->Msg(TP->Name()+" versucht den Kamin anzuzuenden", ALL);

  write(BS("Der Kamin ist zu sehr beschaedigt und es liegt zuviel Asche in "
          +"ihm, als dass man ihn noch anzuenden koennte."));
  return 1;

}

int cmd_wischen(string str)
{
  notify_fail("Was willst Du weg wischen?\n");

  if(!str || str == "") return 0;
  if(!(str == "staub" ||
       str == "staub weg" )) return 0;
  SPUKMASTER->Msg(TP->Name()+" versucht Staub zu wischen", ALL);

  write(BS("Bei soviel Staub kannst Du nur kapitulieren."));
  return 1;

}

int cmd_kapitulier(string str)
{
  notify_fail("Willst Du vielleicht kapitulieren?\n");

  if(!str || str == "")
  {
    SPUKMASTER->Msg(TP->Name()+" kapituliert", ALL);

    write(BS("Du schuettelst den Kopf und wirfst die Haende in die Luft."));
    Message(BS(TP->Name(WER, 1)+" schuettelt den Kopf und wirft die Haende "
           +"in die Luft."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }

  return 0;
}

int cmd_setzen(string str)
{
  notify_fail("Auf was willst Du Dich setzen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf sessel" ||
       str == "in sessel" )) return 0;

  if(sessel)
  {

    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), WOHNSEQ)))
    {
      write(BS("Nochmal willst Du Dir das nicht antun ..."));
      return -1;
    }

    if(sessel != "")
    {
      write(BS("Aber "+CAP(sessel)+" sitzt schon in dem Sessel!"));
      return -1;
    }

    sessel = getuid(TP);
    write(BS("Du machst es Dir in dem Sessel bequem."));
    Message(BS(TP->Name(WER, 1)+" macht es sich in dem Sessel bequem und "
            +"erstarrt ploetzlich!"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    // sonst rennt er noch weg :)
    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:60,
      PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
      PARALYZE_MSG_OTHER:"%s klammert sich an den Sessel.\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));
    Sequence(TP);
    SPUKMASTER->AddPlayerSequence(getuid(TP), WOHNSEQ);
    return 1;
  }
  else
  {
    write(BS("Du musst den Sessel erst aufstellen!"));
    return -1;
  }

}

//--Funktionen fuer Details------------------------------------------------

string strSessel(string str)
{
  string s;

  if(sessel)
  {
    s = "Der Sessel wurde aufgestellt. Jetzt koennte man es sich wieder auf ihm "
       +"bequem machen. Du fragst Dich allerdings, ob das bei den zerrissenen "
       +"Polstern ueberhaupt jemand will.";
  }
  else
  {
    s = "Der Sessel wurde umgeworfen. Seine Polster sind zerrissen. Man muesste "
       +"ihn schon aufstellen, um es sich darin bequem machen zu koennen.";
  }
  return BS(s);
}

string strMitte(string str)
{
  string s;

  if(sessel == WEG)
  {
    s = "Dort liegt ein umgeworfener Sessel.";
  }
  else
  {
    s = "Dort steht ein Sessel.";
  }

  s += " Seine Polster sind zerrissen. Du kannst nicht genau bestimmen, ob es "
      +"an dem Alter des Sessels liegt oder auf Gewalteinwirkung beruht.";

  return BS(s);
}
string strRaum(string str)
{
  string s;

  if(sessel == WEG)
  {
    s = "In der Mitte des Raumes liegt ein umgeworfener Sessel.";
  }
  else
  {
    s = "In der Mitte des Raumes steht ein alter Sessel.";
  }

  s += " Direkt davor liegt ein Truemmerhaufen, der frueher wohl mal ein "
      +"Tisch gewesen ist.";

  return BS(s);
}
string strHochzeit(string str)
{
  string s;

  if(TP->QueryProp(P_MARRIED))
  {
    s = "Hast Du auch Bilder von Deiner Hochzeit mit "+TP->QueryProp(P_MARRIED)+"?";
  }
  else
  {
    s = "Solltest Du auch mal heiraten, wirst Du sicher auch Bilder von "
       +"Deiner Hochzeit machen, oder?";
  }
  return BS(s);
}

string strBeerdigung(string str)
{
  string s;

  if(!(TP->QueryProp(P_DEADS)))
  {
    s = "Bisher brauchtest Du noch nicht zu Deiner eigenen Beerdigung zu gehen.";
  }
  else
  {
    s = "Schon "+TP->QueryProp(P_DEADS)+" mal durftest Du zu Deiner eigenen "
       +"Beerdigung gehen.";
  }
  return BS(s);
}

// Wie teste ich das ueberhaupt??? ;)
string strGeburtstag(string str)
{
  string s;
  string zeit;

//   if((ctime(call_other("/secure/master", "get_userinfo", getuid(TP))[5])[0..9]) == (ctime(time())[0..9]))
   zeit = ctime("/secure/master"->get_userinfo(getuid(TP))[5])[0..9];
   if(zeit == (ctime(time())[0..9]))
   {
     s = "Herzlichen Glueckwunsch! :)";
   }
   else
   {
     s = "Noch ist Dein Geburtstag nicht gekommen.";
   }

  return BS(s);
}

string _query_int_long()
{
  string s, s2;

  if(!sessel)
  {
    s2 = "liegt ein umgeworfener Sessel.";
  }
  else
  {
    s2 = "steht ein alter Sessel.";
  }

  s = "Auch hier bietet sich Dir kein besseres Bild. In der Mitte des Raumes "
     +s2+" Direkt davor liegt ein Truemmerhaufen, der "
     +"frueher wohl mal ein Tisch gewesen ist. Der Kamin an der Wand ist voller "
     +"Asche, ein Teil des Kaminsimes ist rausgebrochen und liegt direkt davor.";

  return BS(s);
}

int Sequence(object player)
{
  if (player)
  {
    SPUKMASTER->sequencer(player, 0, ({
  0, "#Alles wird weiss vor Deinen Augen ...",
  5, "#Was auch immer es war, es laesst nach. Du kannst Deine Umgebung "
    +"wieder wahrnehmen. Doch irgendwas ist anders ...",
  6, "#Du schaust Dich um. Im Kamin flackert ein Feuer. Der Elchkopf haengt an der "
    +"Wand. Auf dem Tisch vor Dir steht ein Krug mit frischem Met. Von oben hoerst "
    +"Du lautes Kinderlachen.",
  12, "#Hinter Dir kracht es fuerchterlich laut. Du springst aus dem Sessel und "
     +"drehst Dich um.",
  5, "#In der eingeschlagenen Tuer steht ein riesiger Oger. Du glaubst, hinter ihm "
    +"einen zweiten, etwas kleineren Oger zu sehen.",
  6, "#Du rufst: Was wollt ihr hier! Verschwindet aus meinem Haus!!",
  6, "#Der Oger hebt seine Keule und laesst sie auf Dich niedersausen. "
    +"Fasziniert betrachtest Du die Kerben, die auf der Keule "
    +"enthalten sind.",
  10, "#Du wirst zurueckgeschleudert, der Tisch zerbricht unter Deinem Gewicht und es "
    +"wird schwarz vor Deinen Augen ...",
  6, "#Erschrocken springst Du aus dem Sessel auf und wirfst ihn dabei um.",
  4, "#",
  0, "*SetSessel"
    }), TO);
  }
  return 1;
}

// Fuer Testzwecke
void SetSessel(object player)
{
  if(player)
  {
    Message(BS(player->Name(WER, 1)+" springt aus dem Sessel auf und stoesst ihn "
         +"dabei um."), MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ player }) ]) );
  }
  sessel = WEG;
}

// Debugzwecke
string QueryOrt()
{
  return haufen;
}
// Debugzwecke
string *QuerySpieler()
{
  return spieler;
}

// Was ist der richtige Haufen?
string welcherhaufen()
{
  return auswahl[random(sizeof(auswahl))];
}

reset()
{
  ::reset();

// Pro Reset neuer Haufen
  haufen = welcherhaufen();
  spieler = ({ });
}
