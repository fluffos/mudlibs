#include "../def.h"

inherit "std/room";

string *auswahl;
string welcherort();
string ort;
string *spieler;

void create()
{
  ::create();

  spieler = ({ });
// Welche Haufen sind moeglich
  auswahl = ({ "tasche","teppich","treppe"});
// Welcher ist der richtige?
  ort = welcherort();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem verfallenen Haus");
  SetProp(P_INT_LONG,
    "Du stehst im Bereich des Hauses, der frueher einmal der Eingang haette "
    "sein koennen. Die Tuer liegt zertruemmert zu Deinen Fuessen. Ein alter, "
    "beschaedigter Kleiderschrank steht an der Wand. Eine Treppe fuehrt nach "
    "oben, ausserdem kannst Du drei weitere Tueren oder das, was davon "
    "uebrig ist, erkennen. "
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, QUEST);
  SetProp(P_INDOORS, QUEST);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "bereich", "eingangsbereich" }),
    "Frueher war dieser Bereich der Eingangsbereich des Hauses. Er war wohl "
    "damals schon schlicht und einfach. Jetzt sieht es nur noch grau und "
    "eintoenig aus. Als wenn schon lange Zeit niemand mehr hier leben wuerde."
  );
  AddDetail( ({ "zeit" }),
    "Schon lange Zeit ist dieses Haus unbewohnt. Bereits der Eingangsbereich "
    "vermittelt dieses Gefuehl."
  );
  AddDetail( ({ "gefuehl", "elemente" }),
    "Keine Pflanzen oder sonstige belebenden Elemente sind vorhanden. Nur die "
    "zerstoerte Eingangstuer und ein alter, beschaedigter Schrank. Nein, hier "
    "wohnt niemand mehr."
  );
  AddDetail( ({ "pflanzen" }),
    "Wenn Du Pflanzen sehen willst, wirst Du schon wieder raus in den Wald "
    "gehen muessen."
  );
  AddDetail( ({ "wald" }),
    "Der befindet sich draussen. Sei vorsichtig, dass Du keinen Ogern ueber den "
    "Weg laeufst."
  );
  AddDetail( ({ "oger", "ogern" }),
    "Die Oger leben hier ganz in der Naehe."
  );
  AddDetail( ({ "naehe", "ogerlager", "lager", "nordwesten" }),
    "Das Ogerlager befindet sich im Nordwesten von hier. Schon viele sind "
    "ihren gefraessigen Waechtern zum Opfer gefallen."
  );
  AddDetail( ({ "waechtern", "waechter", "opfer" }),
    "Sei vorsichtig, falls Du ihnen nicht auch zum Opfer fallen willst."
  );
  AddDetail( ({ "weg" }),
    "Du hast den Weg hierher gefunden. Mit Sicherheit finden ihn auch andere ..."
  );
  AddDetail( ({ "sicherheit" }),
    "Mit Sicherheit bist Du nicht der einzige, der den Weg hierher findet. Nicht "
    "alle werden Dir wohlgesonnen sein."
  );
  AddDetail( ({ "haus", "hauses" }),
    "Ein altes, verfallenes Haus. Wem es gehoert, sofern es noch einen Besitzer "
    "hat, ist nicht ersichtlich."
  );
  AddDetail( ({ "besitzer" }),
    "Die Antwort auf die Frage, wer der Besitzer ist, wirst Du eventuell im Haus "
    "finden."
  );
  AddDetail( ({ "antwort", "frage" }),
    "Du wirst schon suchen muessen."
  );
  AddDetail( ({ "eingang" }),
    "Du stehst im Eingang."
  );
  AddDetail( ({ "tuer", "eingangstuer" }),
    "Die Tuer liegt zertruemmert vor Dir. Unter ihr scheint noch ein Fetzen "
    "Stoff hervorzuragen."
  );
  AddDetail( ({ "fetzen", "stoff" }),
    "Es scheint sich um einen Teppich zu handeln. Auf ihm erblickst Du einen "
    "Schriftzug. Leider wird der groesste Teil des Teppichs von der Tuer verdeckt."
  );
  AddDetail( ({ "teppich" }),
    "Der Teppich besitzt einen Schriftzug. Du koenntest versuchen, den Teil, der "
    "ersichtlich ist, zu lesen. Etwas scheint unter dem Teppich zu liegen."
  );
  AddDetail( ({ "fuessen", "fuesse" }),
    "Die Tuer liegt zu Deinen Fuessen."
  );
  AddDetail( ({ "kleiderschrank", "schrank", "aufbewahren" }),
    "Ein alter, beschaedigter Kleiderschrank. Frueher diente er sicherlich zum "
    "Aufbewahren von Maenteln und aehnlichen Sachen, die man draussen anzieht. "
    "Eine der Schranktueren haengt schief heraus."
  );
  AddDetail( ({ "schranktueren", "schranktuer" }),
    "Eine der Schranktueren haengt schief heraus. Erst jetzt erkennst Du, "
    "dass auf der Vorderseite ein Spiegel befestigt war."
  );
  AddDetail( ({ "spiegel", "vorderseite" }),
    "Der Spiegel wurde rausgerissen. Nur an den Raendern kann man noch "
    "Spuren entdecken."
  );
  AddDetail( ({ "raender", "spuren", "spur", "rand" }),
    "Nur an den Raendern kann man noch Spuren des Spiegels erkennen."
  );
  AddDetail( ({ "sachen", "maentel" }),
    "In dem Schrank kannst Du sogar noch ein mottenzerfressenes Kleidungsstueck auf "
    "einem Haken ausmachen."
  );
  AddDetail( ({ "haken", "holzhaken" }),
    "Ein Holzhaken, wie sich einige im Schrank befinden. Er dient dazu, "
    "Kleidungsstuecke an ihm zu befestigen. Wirklich trauen tust Du der "
    "Haltbarkeit aber nicht. Dazu sieht der Schrank zu alt und zerbrechlich "
    "aus."
  );
  AddDetail( ({ "haltbarkeit" }),
    "Es waere toericht, dem Haken noch zu vertrauen."
  );
  AddDetail( ({ "kleidungsstueck", "stueck", "stuecke", "kleidungsstuecke", "mantel" }),
    "Es ist anzunehmen, dass es frueher mal ein Mantel war. Eine Tasche sieht "
    "etwas gewoelbt aus."
  );
  AddDetail( ({ "tasche" }),
    "Die Tasche sieht etwas gewoelbt aus."
  );
  AddDetail( ({ "wand" }),
    "An der Wand steht ein alter, beschaedigter Kleiderschrank."
  );
  AddDetail( ({ "treppe", "holztreppe" }),
    "Eine Holztreppe fuehrt nach oben. Die einzelnen Stufen sehen "
    "sehr morsch und instabil aus."
  );
  AddDetail( ({ "stufen" }),
    "Die Stufen sehen sehr morsch und instabil aus. Eine der Stufen hat "
    "einen merkwuerdigen dunklen Fleck."
  );
  AddSpecialDetail( ({ "fleck" }), "strFleck");
  AddDetail( ({ "tueren", "tuer" }),
    "Eine Holztuer fuehrt scheinbar in den Keller. Dort, wo einstmals die Tuer ins "
    "Wohnzimmer war, gaehnt nur noch ein grosses Loch. Ausserdem siehst Du einen "
    "Durchgang, der in die Kueche fuehrt."
  );
  AddDetail( ({ "kueche", "durchgang" }),
    "Der Durchgang fuehrt in die Kueche. Wenn Du wissen willst, was sich "
    "dort befindet, wirst Du wohl oder uebel dorthin gehen muessen."
  );
  AddDetail( ({ "keller" }),
    "Die Holztuer fuehrt scheinbar in den Keller."
  );
  AddDetail( ({ "wohnzimmer", "loch" }),
    "Nur noch ein grosses Loch gaehnt dort, wo einstmals die Tuer zum Wohnzimmer "
    "war."
  );
  AddDetail( ({ "willkommensteppich" }),
    "Ob Du auch willkommen bist?"
  );
  AddDetail( ({ "decke", "boden" }),
    "Decke und Boden bestehen aus Holzbalken."
  );
  AddDetail( ({ "holzbalken", "balken", "haustuer", "holz" }),
    "Das Holz fuer die Balken, aus denen das Haus besteht, wurde aus dem Wald "
    "vor der Haustuer geholt."
  );
  AddDetail( ({ "waende" }),
    "Die Waende bestehen ebenso wie Decke und Boden aus Holzbalken."
  );
  AddDetail( ({ "kraft" }),
    "Ob Deine Kraft ausreicht, weisst Du nicht."
  );

  AddReadDetail( ({ "teil", "schriftzug" }),
    "\"...ommen\". Ein Willkommensteppich."
  );

  AddSound( DEFAULT_SOUND,
    "Die Geraeusche des Waldes dringen von draussen herein."
  );

  AddSound( ({ "geraeusche", "wald", "waldes" }),
    "Vogelgezwitscher, Brummen, Knurren ...");
  AddSound( ({ "vogelgezwitscher", "gezwitscher", "voegel" }),
    "Vogelgezwitscher dringt von draussen herein.");
  AddSound( ({ "brummen", "baeren", "baer", "grizzly", "grizzlybaer" }),
    "Das Brummen koennte von einem Baeren oder einem Grizzly stammen.");
  AddSound( ({ "knurren", "wolf", "woelfe" }),
    "Solch ein Knurren hast Du bisher nur bei Woelfen gehoert.");
  AddSound( ({ "lachen", "kinder" }),
    "Du musst Dich getaeuscht haben, nichts zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht staubig und abgestanden. Nur die Waldluft von draussen "
    "bietet ein wenig Abwechslung."
  );

  AddSmell( ({ "waldluft", "luft", "abwechslung" }),
    "Die Luft des Waldes ist weit angenehmer als die Luft hier drinnen."
  );
  AddSmell( ({ "staub" }),
    "Hier war schon lange niemand mehr."
  );
  AddSmell( ({ "wald" }),
    "Dafuer muesstest Du das Haus schon verlassen."
  );

  AddRoomMessage(
    ({"Deine Nackenhaare richten sich auf!\n",
      "Ein paar Voegel zwitschern vor sich hin.\n",
      "Du glaubst, das Lachen kleiner Kinder zu hoeren.\n"}),45,"");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "stemme", "stemm" }), "cmd_stemmen" );
  AddCmd( ({ "roll", "rolle" }), "cmd_rollen" );
  AddCmd( CMD_GREIFEN, "cmd_greifen" );
  AddCmd( ({ "heb", "hebe" }), "cmd_heben" );
  AddCmd( "schuettel|schuettele|schuettl|schuettle&gedanken&ab", "cmd_schuetteln",
          "Willst Du Deine Gedanken abschuetteln?" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "oben", "die Treppe hinauf#" + "./flur" );
  AddExit( "osten", "in die Kueche#" + "./kueche" );
  AddExit( "westen", "in das Wohnzimmer#" + "./wohnzimmer" );
  AddExit( "raus", ([ EX_DEST: "/d/ebene/lamuerte/wwald/room/16y_29x",
                      EX_TESTFUNC: "exit_test",
                      EX_MSG: "nach draussen" ]) );


    NewDoor("unten", ROOM "keller" , ({"tuer", "holztuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Holztuer.",
      D_LONG, "Die Tuer besteht aus dicken Holzbalken. Sie haengt ein wenig "
      "schief. Um sie zu oeffnen, benoetigt man mehr Kraft als ueblich.",
      D_NAME,  "Holztuer",
      D_GENDER,FEMALE,
      D_OPENTESTFUNC, "tueroeffnen",
      D_MSGS, "in den Keller",
      D_RESET_CLOSEMSG, " wird wie von Geisterhand geschlossen!\n"
    })
  );

}

string strFleck(string key)
{
  string s;
  object ob;
  s = "Der Fleck ist roetlich braun. Wo er herkommt, ist nicht zu erkennen.";

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
      (member(spieler, getuid(TP)) == -1)                      &&
       (ort == "treppe"))
  {
    s+= " Aber was ist das? In einer Ritze scheint sich etwas versteckt zu "
       +"haben. Schnell nimmst Du es an Dich, bevor Dir jemand zuvorkommt.";
    ob = clone_object(OBJ "farbband");

    ob->SetOwner(getuuid(TP));
    spieler += ({ getuid(TP) });

    // Neuer Ort fuer den naechsten Spieler
    ort = welcherort();

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      s+=" Leider kannst Du es nicht mehr tragen und laesst es fallen.\n";
      SPUKMASTER->Msg(TP->Name()+" kann das Farbband nicht tragen", ALL);
      ob->move(TO,M_PUT);
    }

    TO->Message(BS(TP->Name()+" hebt irgendetwas bei der Treppe auf."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
 
    SPUKMASTER->Msg(TP->Name()+" nimmt das Farbband von der Treppe", QUEST);
  }
  return BS(s);
}

// Die Tuer laesst sich mit genug stemmen oeffnen
int tueroeffnen()
{
  write(BS("So leicht bekommt man die Tuer nicht auf. Sie scheint stark "
  +"verklemmt zu sein, aber mit Stemmen koennte es klappen."));
  return 1;
}

int cmd_rollen(string str)
{
  notify_fail("Was willst Du rollen?\n");

  if(!str || str == "") return 0;

  if(!(str == "teppich")) return 0;

  SPUKMASTER->Msg(TP->Name()+" rollt den Teppich", ALL);

  write(BS("Die Tuer blockiert den Teppich. Du kannst lediglich eine Ecke des "
       +"Teppichs anheben."));
  Message(TP->Name(WER, 1)+" hantiert am Teppich.\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

int cmd_stemmen(string str)
{
  notify_fail("Was willst Du aufstemmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "tuer auf" ||
       str == "holztuer auf"     )) return 0;

  if (DOOR_MASTER->QueryDoorStatus(ROOM "keller")==D_STATUS_CLOSED)
  {
    DOOR_MASTER->SetDoorStatus(ROOM "keller", D_STATUS_OPEN);

    write("Du stemmst Dich mit aller Kraft gegen die Holztuer und "
         +"faellst fast in den Keller.\n");
    TO->Message(TP->Name(WER, 1)+" stemmt die Holztuer auf und faellt "
               +"dabei fast in den Keller.\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
  }
  else
  {
    write("Aber die Holztuer ist doch schon offen?\n");
    return -1;
  }
}

int cmd_greifen(string str)
{
  object ob;

  notify_fail("In was willst Du greifen?\n");

  if(!str || str == "") return 0;

  if(!(str == "in tasche" ||
       str == "in manteltasche"     )) return 0;

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
      (member(spieler, getuid(TP)) == -1)                      &&
       (ort == "tasche"))
    {
      ob = clone_object(OBJ "farbband");
      write(BS("Du greifst in die alte Tasche und tatsaechlich, ein altes "
      "Farbband war darin versteckt!"));
      TO->Message(BS(TP->Name(WER, 1)+" hantiert am Mantel."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt das Farbband aus der Tasche", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du das Farbband nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann das Farbband nicht tragen", ALL);
        ob->move(TO,M_PUT);
        return -1;
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" greift in die Tasche", ALL);
    write(BS("Du greifst in die alte Tasche, findest jedoch nichts."));
    TO->Message(BS(TP->Name(WER, 1)+" hantiert am Mantel."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;

}

int cmd_heben(string str)
{
  object ob;

  notify_fail("Was willst Du anheben?\n");

  if(!str || str == "") return 0;

  if(!(str == "teppich an"            ||
       str == "willkommensteppich an" ||
       str == "ecke an"               )) return 0;

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), BRUDERSEQ)) &&
      (member(spieler, getuid(TP)) == -1)                      &&
       (ort == "teppich"))
    {
      ob = clone_object(OBJ "farbband");
      write(BS("Du hebst das Stueck Teppich an und findest "
              +"erstaunlicherweise ein Farbband."));
      TO->Message(BS(TP->Name(WER, 1)+" hantiert am Teppich."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt das Farbband unter dem Teppich", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du das Farbband nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann das Farbband nicht tragen", ALL);
        ob->move(TO,M_PUT);
        return -1;
      }

      return 1;
    }

    SPUKMASTER->Msg(TP->Name()+" hebt den Teppich an", ALL);
    write(BS("Du hebst den Teppich an, findest jedoch nichts."));
    TO->Message(BS(TP->Name(WER, 1)+" hantiert am Teppich."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;

}

int cmd_schuetteln(string str)
{
  write(BS("Du schuettelst alle Gedanken an das Haus ab."));
  SPUKMASTER->DelSequences(getuid(TP)); 
  return 1;
}

// Was ist der richtige Ort?
string welcherort()
{
  return auswahl[random(sizeof(auswahl))];
}

// Debugzwecke
string QueryOrt()
{
  return ort;
}
// Debugzwecke
string *QuerySpieler()
{
  return spieler;
}

reset()
{
  ::reset();

// Pro Reset neuer Ort
  ort = welcherort();
  spieler = ({ });
}

int exit_test(string dir)
{
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    
    if(SPUKMASTER->QueryPlayerSequence(getuid(TP), HINWEIS) )
    {
      write(BS("Wenn Du alles vergessen willst, was Du in diesem Haus "
               "gesehen und gehoert hast, schuettle einfach "
              +"alle Gedanken daran ab. <schuettle gedanken ab>"));
      SPUKMASTER->AddPlayerSequence(getuid(TP), HINWEIS);
      return 0;
    }
    return 1;
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  SPUKMASTER->AddPlayerSequence(getuid(TP), 0);
}
