#include "../def.h"

inherit "std/room";

int Sequence(object player);
int SequenceBuchstaben(object player);
string str_baukloetze(string key);
string buchstaben(string key);

string *auswahl;
string welcherort();
string ort;
string *spieler;

string buchstabe1, buchstabe2, buchstabe3;
status buchstaben;
message(int msg);

void create()
{
  ::create();

  spieler = ({ });
// Welche Haufen sind moeglich
  auswahl = ({ "klappe","bett","tisch"});
// Welcher ist der richtige?
  ort = welcherort();

  buchstabe1=buchstabe2=buchstabe3=WEG;

  buchstaben = DA;
//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem kleinen Zimmer");
  SetProp(P_INT_LONG,
    "Dieses Zimmer ist nicht so verwuestet wie die anderen. Auf dem "
    "Boden verstreut liegen ein paar Spielsachen. Ein kleines Bett "
    "steht an der Wand. In der Ecke daneben befindet sich ein kleiner Tisch. "
    "Den dazu passenden Stuhl sucht man hier vergebens."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, QUEST);
  SetProp(P_INDOORS, QUEST);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "zimmer", "kinderzimmers", "zimmers", "kinderzimmer" }),
    "Das Zimmer ist nicht so verwuestet wie die anderen. Die Unordnung, "
    "die hier herrscht, entspricht eher der eines normalen Kinderzimmers."
  );
  AddDetail( ({ "unordnung", "ordnung" }),
    "Die typische \"Ordnung\" eines Kinderzimmers. Die Spielsachen liegen "
    "verstreut auf dem Boden herum. Du solltest aufpassen, nicht ueber "
    "eine gemeine Stolperfalle zu stuerzen."
  );
  AddDetail( ({ "stolperfalle", "falle" }),
    "Sie liegen ueberall herum."
  );
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holzbalken. Auf ihm verstreut liegen einige "
    "Spielsachen. In der Naehe des Eingangs siehst Du einen merkwuerdigen "
    "dunklen Fleck."
  );
  AddDetail( ({ "holzbalken", "balken", "haustuer", "holz", "tuer" }),
    "Du wuerdest Dein letztes Geld darauf verwetten, dass das Holz aus dem "
    "Wald vor dem Haus stammt."
  );
  AddDetail( ({ "geld", "wette" }),
    "Es gibt nur niemanden, der so toericht waere, diese Wette anzunehmen."
  );
  AddDetail( ({ "wald", "haus" }),
    "Der befindet sich direkt vor dem Haus."
  );
  AddDetail( ({ "eingangs", "eingang", "naehe" }),
    "Der Eingang zu diesem Zimmer befindet sich im Osten."
  );
  AddDetail( ({ "fleck", "stelle" }),
    "Etwas irritiert betrachtest Du die Stelle. Der Boden ist dort dunkler "
    "als im restlichen Raum."
  );
  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG)  );
  AddDetail( ({ "spielsachen", "sachen" }),
    "Ein paar Puppen und Stofftiere liegen verstreut herum. In einer Ecke "
    "liegen ein paar Baukloetze."
  );
  AddDetail( ({ "puppen" }),
    "Ein paar grob gefertigte, unterschiedlich grosse Puppen liegen auf dem "
    "Boden verstreut. Ausserdem liegen diverse Puppenkleider herum. Sogar "
    "ein kleines Puppenhaus aus Holz kannst Du erkennen."
  );
  AddDetail( ({ "puppenkleider", "kleider" }),
    "Kleine, sorgfaeltig genaehte Puppenkleider liegen herum. Leider hat der "
    "Zahn der Zeit bereits an ihnen zu nagen begonnen."
  );
  AddDetail( ({ "puppenhaus" }),
    "Das Puppenhaus ist zu einer Seite hin offen. Zwei Stockwerke hat es."
  );
  AddDetail( ({ "seite", "seitenwand" }),
    "Eine komplette Seitenwand fehlt, so dass man bequem in jedes Zimmer greifen "
    "kann."
  );
  AddDetail( ({ "stockwerke", "stockwerk" }),
    "Unten erkennst Du einen Eingang mit der Treppe nach oben sowie eine Kueche und "
    "ein Wohnzimmer. Oben befinden sich drei weitere Raeume. Du kannst Dich des "
    "Eindrucks nicht erwehren, dass das Haus dem Haus hier nachempfunden ist."
  );
  AddDetail( ({ "treppe", "kueche", "wohnzimmer", "raeume",
                "detailgetreu", "getreu" }),
    "Erstaunlich, wie detailgetreu das Haus nachempfunden ist."
  );
  AddDetail( ({ "eindrucks", "eindruck" }),
    "Lediglich der Keller fehlt."
  );
  AddDetail( ({ "keller", "klappe" }),
    "Du schaust Dir den Eingang noch einmal genau an und findest eine kleine Klappe."
  );
  AddDetail( ({ "zeit", "zahn", "lumpen" }),
    "Die lange Zeit ist nicht spurlos an den Puppenkleidern vorueber gegangen. "
    "Einige sind nur ein wenig eingerissen, andere sind nichts weiter mehr als "
    "mottenzerfressene Lumpen."
  );
  AddDetail( ({ "stofftiere", "stofftier", "tier", "tiere" }),
    "Ein Hund, ein Igel und ein Pferd fallen Dir auf."
  );
  AddDetail( ({ "hund", "stoffhund" }),
    "Ein grauer Hund mit einem braunen Schwanz und ebenso braunen Schlappohren."
  );
  AddDetail( ({ "schwanz", "schlappohren", "ohren" }),
    "Der Schwanz und die Ohren wurden nachtraeglich befestigt. Das erklaert auch "
    "die braune Farbe."
  );
  AddDetail( ({ "farbe" }),
    "Die unterschiedlichen Farben stammen daher, dass fuer den Schwanz und fuer die "
    "Ohren ein anderer Stoff verwendet wurde."
  );
  AddDetail( ({ "stoff" }),
    "Welcher das jedoch ist, weisst Du nicht."
  );
  AddDetail( ({ "igel", "stoffigel" }),
    "Ein brauner Igel mit einer schwarzen Schnauze und kleinen Knopfaugen."
  );
  AddDetail( ({ "schnauze", "knopfaugen", "augen", "aussehen" }),
    "Die schwarze Schnauze mit den kleinen Knopfaugen darueber geben dem Igel "
    "erst das igelaehnliche Aussehen."
  );
  AddDetail( ({ "pferd", "stoffpferd" }),
    "Das Pferd liegt mitten im Raum. Irgendwas stoert Dich an seinem Anblick."
  );
  AddDetail( ({ "anblick" }),
    "Du weisst nicht genau, was. Vielleicht wuerde es Deinem Gefuehl helfen, wenn "
    "Du das Pferd in die Hand nimmst."
  );
  AddDetail( ({ "gefuehl" }),
    "Dein Gefuehl sagt Dir, dass irgendetwas mit dem Pferd nicht stimmt."
  );
  AddDetail( ({ "hand" }),
    "Vielleicht wuerde es helfen, wenn Du das Pferd in die Hand nimmst."
  );
  AddSpecialDetail( ({ "baukloetze", "buchstaben" }), // suchen finden lesen
    "str_baukloetze"
  );
  AddSpecialDetail( ({ "alphabet" }), // suchen finden lesen
    "str_alphabet"
  );
  AddDetail( ({ "bett", "kinderbett" }),
    "Das Bett ist fuer einen Erwachsenen viel zu klein."
  );
  AddDetail( ({ "erwachsenen", "erwachsener" }),
    "Offensichtlich ist es ein Kinderbett."
  );
  AddDetail( ({ "wand" }),
    "Ein kleines Bett steht an der Wand."
  );
  AddDetail( ({ "ecke" }),
    "In der Ecke neben dem Bett steht ein kleiner Tisch."
  );
  AddDetail( ({ "tisch" }),
    "Auf dem Tisch befindet sich absolut gar nichts. Scheinbar wurde alles "
    "vom Tisch auf den Boden gefegt. Einiges ist auch unter dem Tisch gelandet."
  );
  AddDetail( ({ "stuhl" }),
    "Den dazu passenden Stuhl findest Du nicht."
  );
  AddDetail( ({ "waende", "decke" }),
    "Waende und Decke bestehen aus Holzbalken. An einer der Waende sind "
    "einige Zeichnungen, die wohl mit Kreide oder einem weichen Stift gemalt wurden."
  );
  AddDetail( ({ "zeichnungen", "kind", "zeichnung" }),
    "Die Zeichnung ist nicht nur verblasst, sie ist auch sehr ungenau und "
    "krakelig. Offensichtlich wurde dieses \"Meisterwerk\" von einem Kind "
    "erschaffen."
  );
  AddDetail( ({ "meisterwerk" }),
    "Es stellt scheinbar eine Familie dar. Zwei groessere Menschen, die sich an "
    "den Haenden halten, und zwei kleinere, die sich um etwas streiten."
  );
  AddDetail( ({ "familie", "eltern", "menschen" }),
    "Die zwei grossen Menschen koennten die Eltern sein."
  );
  AddDetail( ({ "haenden" }),
    "Sie halten sich vertraut an den Haenden."
  );
  AddDetail( ({ "kleinere menschen", "kleine menschen", "kinder" }),
    "Sie streiten sich um irgendetwas."
  );
  AddDetail( ({ "kreide", "stift" }),
    "Die Zeichnungen sind schon sehr verblasst. Du kannst nicht mehr erkennen, "
    "womit sie genau geschrieben wurden."
  );
  AddDetail( ({ "staub" }),
    "Staub ueberrascht Dich nicht."
  );
  AddDetail( ({ "satz" }),
    "Wie waer es mit lesen?"
  );

  AddSound( DEFAULT_SOUND,
    "Totenstille."
  );

  AddSound( ({ "totenstille", "toten", "tote" }),
    "Ob die Toten wirklich so still sind ...");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist erfuellt vom Geruch alter Moebel."
  );

  AddSmell( ({ "luft", "geruch", "waldluft", "moebel" }),
    "Frische Waldluft waere deutlich angenehmer."
  );

  AddReadDetail( ({ "satz", "baukloetze", "kloetze", 
                    "buchstaben", "buchstabe" }),
    #'buchstaben );
  AddRoomMessage(
    ({"Irgendwer ist bei Dir!\n",
      "Jemand ist bei Dir!\n",
      "Du fuehlst Dich beobachtet!\n",
      "Hat sich nicht gerade eines der Stofftiere bewegt??\n",
      "Einer der Baukloetze hat sich gedreht!\n"}),60,"message");

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "lieg", "liege" }), "cmd_liegen" );
  AddCmd( CMD_NEHMEN, "cmd_nehmen" );
  AddCmd( CMD_UNTERSUCHEN, "cmd_schau" );
  AddCmd( CMD_OEFFNEN, "cmd_oeffnen" );
  AddCmd( ({ "leg", "lege" }), "cmd_legen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", "in den Flur#" + "./flur" );

}

//--Funktion fuer AddRoomMessage--------------------------------------------

message(int msg)
{
  if (msg > 2)
    if (random(10) < 3)
      Message(BS("Du fuehlst Dich nicht wohl bei der Sache.\n"),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP );
}

//--Funktionen fuer Details------------------------------------------------

string str_baukloetze(string key)
{
  string s;

  s = "Ein paar Baukloetze mit aufgemalten Buchstaben liegen auf dem Boden "
     +"herum. Ein paar Buchstaben liegen merkwuerdig geordnet da.";
  //    h               l              m
  if(!buchstabe1 || !buchstabe2 || !buchstabe3)
    s += " Das Alphabet ist nicht vollstaendig, offenbar fehlen noch einige "
        +"Baukloetze, dennoch koenntest Du versuchen, den Satz zu lesen.";

  return BS(s);
}

string str_alphabet(string key)
{
  string s;
  //    h               l              m
  if(!buchstabe1 || !buchstabe2 || !buchstabe3)
    s = "Das Alphabet ist nicht vollstaendig, offenbar fehlen noch einige "
        +"Baukloetze, dennoch koenntest Du versuchen den Satz zu lesen.";
  else
    s = " Das Alphabet ist vollstaendig.";
  return BS(s);
}

//if ir (l,h und m fehlen in der sammlung), Buchstaben finden dazulegen
string buchstaben(string key)
{
  string s;
  s = "Du liest: ";
  s += buchstabe1?"H":"";
  s += "I";
  s += buchstabe2?"L":"";
  s += "F ";
  s += buchstabe3?"M":"";
  s += "IR";

  if(buchstabe1 && buchstabe2 && buchstabe3 && buchstaben)
  {
    if(!SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTER))
    {
      return BS(s);
    }
    write(BS(s));
    write(BS("Ploetzlich fangen die Buchstaben an sich zu bewegen, "
            +"fasziniert starrst Du auf ihr Spiel."));
    Message(BS(TP->Name()+" starrt fasziniert auf die Holzkloetze."),
               MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    buchstaben = WEG;
    SPUKMASTER->Msg(TP->Name()+" starrt die Buchstaben an.", QUEST);
    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:70,
      PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
      PARALYZE_MSG_OTHER:"%s ist einfach fasziniert von den Holzkloetzen.\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 0]) );
    
    SequenceBuchstaben(TP);
    SPUKMASTER->AddPlayerSequence(getuid(TP), SCHWESTER);
    
    return "";
  }  
  return BS(s);
}
//--Funktionen fuer Kommandos----------------------------------------------

// Buchstaben ablegen
cmd_legen(string str )
{
  string was;
  object ob;

  notify_fail( "Was willst Du ablegen?\n" );

  if(!str)  return 0;
  if(sscanf(str,"%s ab", was) != 1) return 0;

  ob = present(was, TP);
  if(!ob)
  {
    write(BS(CAP(was)+" besitzt Du doch gar nicht!"));
    return -1;
  }

  if((was == "buchstabe" || was == "bauklotz"  ||
      was == "klotz"     || was == "holzklotz" ||
      was == "h"         || was == "m"         ||
      was == "l") && ob->id(KLOTZ))
  {

    if(ob->id("h"))
    {
      if(buchstabe1 == getuid(TP))
      {
        write(BS("Aber Du hast das H bereits abgelegt!"));
        SPUKMASTER->Msg(TP->Name()+" versucht erneut, das H abzulegen", ALL);
        return -1;
      }
      else if(buchstabe1)
      {
        write(BS("Der Buchstabe H wurde bereits von "+CAP(buchstabe1)
                +" hinzugefuegt!"));
        SPUKMASTER->Msg(TP->Name()+" H belegt von: "+CAP(buchstabe1), ALL);
        return -1;
      }
      buchstabe1 = getuid(TP);
      SPUKMASTER->Msg(TP->Name()+" legt den Buchstaben H ab", QUEST);
    }

    if(ob->id("l"))
    {
      if(buchstabe2 == getuid(TP))
      {
        write(BS("Aber Du hast das L bereits abgelegt!"));
        SPUKMASTER->Msg(TP->Name()+" versucht erneut, das L abzulegen", ALL);
        return -1;
      }
      else if(buchstabe2)
      {
        write(BS("Der Buchstabe L wurde bereits von "+CAP(buchstabe2)
                +" hinzugefuegt!"));
        SPUKMASTER->Msg(TP->Name()+" L belegt von: "+CAP(buchstabe2), ALL);
        return -1;
      }
      SPUKMASTER->Msg(TP->Name()+" legt den Buchstaben L ab", QUEST);
      buchstabe2 = getuid(TP);
    }

    if(ob->id("m"))
    {
      if(buchstabe3 == getuid(TP))
      {
        write(BS("Aber Du hast das M bereits abgelegt!"));
        SPUKMASTER->Msg(TP->Name()+" versucht erneut, das M abzulegen", ALL);
        return -1;
      }
      else if(buchstabe3)
      {
        write(BS("Der Buchstabe M wurde bereits von "+CAP(buchstabe3)
                +" hinzugefuegt!"));
        SPUKMASTER->Msg(TP->Name()+" M belegt von: "+CAP(buchstabe3), ALL);
        return -1;
      }
      buchstabe3 = getuid(TP);
      SPUKMASTER->Msg(TP->Name()+" legt den Buchstaben M ab", QUEST);
    }
    
    write(BS("Du legst den Holzklotz zu den anderen. Ploetzlich bewegt "
            +"er sich wie von Geisterhand!"));
    Message(BS(TP->Name()+" legt einen Holzklotz ab."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    ob->remove();
    return 1;
  }

}

// Auf dem Bett liegen
int cmd_liegen(string str)
{
  object ob;
  notify_fail("Worauf willst Du Dich legen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf bett" ||
       str == "bett"     ||
       str == "in bett"))
    return (notify_fail("DARAUF kannst Du Dich nicht legen.\n"),0);

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
      (member(spieler, getuid(TP)) == -1)                         &&
       (ort == "bett"))
  {
    ob = clone_object(OBJ "buchstabe1");
    write(BS("Du zwaengst Dich in das viel zu klein geratene Bett. "
            +"Aua, irgendwas piekst Dich durch die Decke hindurch. "
            +"Schnell greifst Du danach."));
    Message(BS(TP->Name(WER, 1)+" zwaengt sich ins Bett, steht aber sofort "
            +"wieder auf."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    ob->SetOwner(getuuid(TP));
    spieler += ({ getuid(TP) });

    // Neuer Ort fuer den naechsten Spieler
    ort = welcherort();

    SPUKMASTER->Msg(TP->Name()+" nimmt den Buchstaben aus dem Bett", QUEST);

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      write("Leider kannst Du ihn nicht mehr tragen.\n");
      SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", ALL);
      ob->move(TO,M_PUT);
    }

    return 1;
  }

  write(BS("Du zwaengst Dich in das viel zu klein geratene Bett. Viel zu "
          +"unbequem! Schnell stehst Du wieder auf."));
  Message(BS(TP->Name(WER, 1)+" zwaengt sich ins Bett. Steht aber sofort "
          +"wieder auf."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  SPUKMASTER->Msg(TP->Name()+" legt sich aufs Bett der Schwester", ALL);
  return 1;
}
// Klappe oeffnen
int cmd_oeffnen(string str)
{
  object ob;

  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "klappe" ))
    return (notify_fail("DAS kannst Du nicht oeffnen!\n"),0);

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
      (member(spieler, getuid(TP)) == -1)                         &&
       (ort == "klappe"))
  {
    ob = clone_object(OBJ "buchstabe1");
    write(BS("Du oeffnest die Klappe und findest einen Holzklotz."));
    Message(BS(TP->Name(WER, 1)+" oeffnet eine kleine Klappe."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    ob->SetOwner(getuuid(TP));
    spieler += ({ getuid(TP) });

    // Neuer Ort fuer den naechsten Spieler
    ort = welcherort();

    SPUKMASTER->Msg(TP->Name()+" nimmt den Buchstaben aus der Klappe", QUEST);

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      write("Leider kannst Du ihn nicht mehr tragen.\n");
      SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", ALL);
      ob->move(TO,M_PUT);
    }

    return 1;
  }

  SPUKMASTER->Msg(TP->Name()+" oeffnet eine Klappe", ALL);
  write(BS("Vollkommen leer. Schade."));
  Message(BS(TP->Name(WER, 1)+" oeffnet eine kleine Klappe."),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;

}
// unter tisch schauen
int cmd_schau(string str)
{
  object ob;
//  notify_fail("Worunter willst Du schauen?\n");

  if(!str || str == "") return 0;

  if(str == "unter tisch" )
  {
    if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)) &&
        (member(spieler, getuid(TP)) == -1)                         &&
         (ort == "tisch"))
    {
      ob = clone_object(OBJ "buchstabe1");
      write(BS("Angestrengt schaust Du unter den Tisch. Tatsaechlich, ein "
              +"Bauklotz ist dorthin gerollt. Schnell nimmst Du ihn an Dich."));
      Message(BS(TP->Name(WER, 1)+" schaut unter den Tisch."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      ob->SetOwner(getuuid(TP));
      spieler += ({ getuid(TP) });

      // Neuer Ort fuer den naechsten Spieler
      ort = welcherort();

      SPUKMASTER->Msg(TP->Name()+" nimmt den Buchstaben unter dem Tisch", QUEST);

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        write("Leider kannst Du ihn nicht mehr tragen.\n");
        SPUKMASTER->Msg(TP->Name()+" kann den Buchstaben nicht mehr tragen", ALL);
        ob->move(TO,M_PUT);
      }

      return 1;
    }

    write(BS("Ausser Staub liegt nichts unter dem Tisch."));
    Message(BS(TP->Name(WER, 1)+" schaut unter den Tisch."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SPUKMASTER->Msg(TP->Name()+" schaut unter den Tisch", ALL);
    return 1;
  }

  if( str == "unter bett" )
  {
    SPUKMASTER->Msg(TP->Name()+" schaut unters Bett", ALL);
    write(BS("Ausser Staub liegt nichts unter dem Bett."));
    Message(BS(TP->Name(WER, 1)+" schaut unters Bett."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return -1;
  }

  return 0;

}

// Stoffpferd nehmen -> Sequence
int cmd_nehmen(string str)
{
  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "pferd" ||
       str == "stoffpferd" )) return 0;

  if(!(SPUKMASTER->QueryPlayerSequence(getuid(TP), SCHWESTERSEQ)))
  {
    write(BS("Nochmal willst Du Dir das nicht antun ..."));
    return -1;
  }

  write(BS("Du nimmst das Stoffpferd in die Hand."));
  TO->Message(BS(TP->Name(WER, 1)+" nimmt das Stoffpferd in die Hand, nur "
             +"um es sofort wieder fallenzulassen."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  TP->SetProp(P_PARALYZED, ([
    PARALYZE_TIME:60,
    PARALYZE_MSG:"Du hast keine Kontrolle ueber Deinen Koerper!\n",
    PARALYZE_MSG_OTHER:"%s steht wie erstarrt da.\n",
    PARALYZE_END:"",
    PARALYZE_END_OTHER:""
  ]));

  Sequence(TP);
  SPUKMASTER->AddPlayerSequence(getuid(TP), SCHWESTERSEQ);

  return 1;

}
// Waehrend sequenzen RoomMessages ausschalten
void removeRoomMessage()
{
  AddRoomMessage( "",60,"");
}

void resetRoomMessage()
{
    AddRoomMessage(
    ({"Irgendwer ist bei Dir!\n",
      "Jemand ist bei Dir!\n",
      "Du fuehlst Dich beobachtet!\n",
      "Hat sich nicht gerade eines der Stofftiere bewegt??\n",
      "Einer der Baukloetze hat sich gedreht!\n"}),60,"message");
}

int Sequence(object player)
{
  if (player)
  {
    removeRoomMessage();
    SPUKMASTER->sequencer(player, 0, ({
  0, "#Alles wird weiss vor Deinen Augen ...",
  5, "#Du weinst leise und drueckst Dein Stoffpferd mit der schoenen neuen Schleife "
    +"an Dich.",
  6, "#Du rufst: Gib mir meinen Teddy wieder!!!",
  4, "#Aus dem Zimmer Deines Bruders hoerst Du lautes, boshaftes Lachen.",
  5, "#Ploetzlich kracht es unten. Du hoerst Deinen Vater irgendwas rufen.",
  6, "#Ein wenig veraengstigt gehst Du auf den Flur, das Pferd fest an Dich drueckend.",
  6, "#Du hoerst Deine Mutter die Treppe rauf eilen und ein Geraeusch, als wenn jemand "
    +"gestuerzt waere.",
  6, "#Du willst schon nachsehen gehen, als Deine Mutter ruft: Lauft Kinder, versteckt "
    +"euch!",
  6, "#Du bleibst wie angewurzelt stehen. Du hoerst jemanden ueber die Treppe kommen ...",
  6, "#Du blickst zu einem riesigen Oger hinauf. In seiner Hand haelt er ein "
    +"verrostetes Schwert, von dem etwas Rotes tropft.",
  6, "#Erschrocken rennst Du in Dein Zimmer und stolperst ueber die Tuerschwelle. "
    +"Du faellst hin, Dein Pferd landet mitten im Raum.",
  6, "#Du kruemmst Dich zusammen, legst schuetzend Deine Arme ueber den Kopf und schreist "
    +"Dir die Seele aus dem Leib!",
  6, "#Es wird schwarz vor Deinen Augen ...",
  4, "#Etwas benommen stehst Du wieder auf.",
  4, "*resetRoomMessage"
    }), TO);
  }
  return 1;
}

void begruessung(object player)
{
  if(ENV(player) != TO) return;
  // Gibts TP noch?
  tell_object(player, BS("Deine Nackenhaare richten sich auf!"));
  return;
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  call_out("begruessung", 20+random(20), TP);

}

// Was ist der richtige Ort?
string welcherort()
{
  return auswahl[random(sizeof(auswahl))];
}

// Debugzwecke
string QueryOrt()
{
  return ort;
}
// Debugzwecke
string *QuerySpieler()
{
  return spieler;
}

reset()
{
  ::reset();

// Pro Reset neuer Ort
  ort = welcherort();
  spieler = ({ });
}


void resetBuchstaben(object player)
{
  // Buchstaben neu zusammensuchen
  if(player)
  {
    Message(BS(player->Name(WER, 1)+" schaut sich verwundert um. "
           +"Irgendwie scheinen ein paar Holzkloetze abhanden gekommen zu sein"),
           MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ player }) ]) );
  }
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20]) );
  buchstabe1 = buchstabe2 = buchstabe3 = WEG;
  buchstaben = WEG;
  resetRoomMessage();
}

int SequenceBuchstaben(object player)
{
  if (player)
  {
    removeRoomMessage();
    SPUKMASTER->sequencer(player, 0, ({
  0, "#Alles wird weiss vor Deinen Augen ...",
  4, "#Kaelte ... Dir wird kalt ...",
  4, "#Verwundert betrachtest Du die Holzkloetze.",
  4, "#Langsam ergeben die Buchstaben einen Sinn ...",
  4, "#MEIN TEDDY",
  4, "#Wessen Teddy? Wer bist Du?",
  4, "#BRING IHN MIR BITTE",
  4, "#Wo ist der Teddy?",
  4, "#MEIN BRUDER HAT IHN",
  4, "#Ploetzlich liegen alle Buchstaben still da. Mehr wirst Du wohl nicht "
    +"erfahren koennen. Ein paar der Buchstaben scheinen abhanden gekommen "
    +"zu sein.",
  0, "*resetBuchstaben"
    }), TO);
  }
  return 1;
}