inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <npc.h>

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Eine eklige Ratte");
  SetProp(P_LONG,
    "Eine Ratte. Du hast ja schon einen Ekel vor diesem Viechzeuch, "
    "aber dieses Exemplar uebertrifft noch alles. Boesartig funkeln "
    "Dich ihre kleinen Augen an, ihr Fell ist struppig, an einigen "
    "Stellen hat sie ueberhaupt kein Fell mehr. Dich schaudert bei "
    "dem Gedanken an das ganze Ungeziefer, dass die Ratte in ihrem "
    "verdreckten Fell beherbergt. Hoffentlich uebertraegt sie keine "
    "Krankheiten."
  );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:50]));
  SetProp (P_NAME, "Ratte");
  SetProp (P_GENDER, FEMALE);
  AddId(({"ratte"}));
  AddClass(CL_ANIMAL);
  SetProp(P_NAME_ADJ, ({"eklig"}) );
  AddAdjective( ({"ekligen","ekliger","ekligem","ekliges","eklige"}) ); 
  create_default_npc( 5 );
  SetProp(P_HANDS, ({" mit ihren kleinen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    ,DT_BLUDGEON
                    })
  );
  SetProp (P_ALIGN, -80-random(100));
  SetProp (P_SIZE, 20+random(5));
  SetProp (P_RACE, "Ratte");

  SetProp (P_MSGIN, "huscht herein");
  SetProp (P_MSGOUT, "huscht");

  AddDetail( ({"fell","ungeziefer","viechzeuch"}) ,
    "Nein, das willst Du bestimmt nicht untersuchen."
  );

  AddDetail( ({"krankheit","krankheiten"}) ,
    "Hoffentlich bekommst Du keine."
  );

  AddDetail( ({"ekel"}) ,
    "Dir ekelt vor dieser Ratte."
  );

  AddDetail( ({"augen","blicke"}) ,
    "Wenn Blicke toeten koennten, waerest Du jetzt tot."
  );

  AddCmd ( CMD_UNTERSUCHEN, "cmd_untersuchen");
}

int cmd_untersuchen(string str)
{
  if (!str) return 0;
  if (random(3)) return 0;
  write ("Die Ratte lenkt Dich ab.\n");
  return 1;
}
