#include "../def.h"

#include <ansi.h>

#define SAVEFILE "/d/" REGION "/" MAGIERNAME "/" GEBIET "/master/master"

void Msg(string s, int level);

// name: timestamp, wohnzimmerseq, kuecheseq, bruderseq, schwesterseq, hinweis,
//       bruder, schwester, mutter
//  ([player: ctime(); 0;0;0;0;0;0;0;0 ])
mapping sequences;

int messagelevel=NONE;

void SaveData()
{
  save_object(SAVEFILE);
}

void LoadData()
{
  restore_object(SAVEFILE);
}

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  
  sequences = ([ ]);

  seteuid(getuid(this_object()));

  LoadData();

  return;
}

// Message Level setzen und abfragen
void SetLevel(int level)
{
  messagelevel = level;
  SaveData();
}
int QueryLevel()
{
  return messagelevel;
}

nosave int lvl_sort(object ob1, object ob2) {
  if (query_wiz_level(ob1)<query_wiz_level(ob2)) return 1;
  if (query_wiz_level(ob1)>query_wiz_level(ob2)) return 0;
  if ((ob1->query_real_name())<(ob2->query_real_name())) return 1;
  return 0;
}

// Wer befindet sich alles im Spukhaus?
int spukwho () {
  string s,fn;
  object *us;
  object ob,env;
  int i,sz;

  s="";

  sz=strlen(ROOM)-1;

  if (!TP || !IS_WIZARD(TP)) return 0;

  us=users();
  us=sort_array(us,"lvl_sort",ME);

  s="-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*"
   +"\n\n                       "
   +ANSI_BOLD+ANSI_YELLOW+"Das Spukhaus *grusel*"+ANSI_NORMAL+"\n\n";

  s+="Wizlvl\tLevel\t\Name\t\tRoom\n\n";
  for (i=0;i<=sizeof(us)-1;i++)
  {
    ob=us[i];
    env=environment(ob);

    if (!env) continue;

    fn=file_name(env);

    if (fn[0..sz]!= ROOM ) continue;
    fn="~"+fn[sz..];
    s+=extract(sprintf("   %d ",query_wiz_level(ob)),-4,-1)+"\t";
    s+=ob->QueryProp(P_LEVEL)+"\t";
    s+=ANSI_YELLOW+(capitalize(ob->query_real_name())+ANSI_NORMAL" ...........")[0..18];
    s+=("\t ["+fn+"]");
    s+="\n";

  }

  s+="\n-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*"
   +ANSI_NORMAL+"\n\n";

  write(s);

  return 1;
}

// Merken welche Sequence welcher Spieler schon gesehen hat
// Returnwerte: keine
void AddPlayerSequence(string player, int seq)
{
  object pl;
  pl = find_player(player);
  if(!player) return;

  if(member(sequences, player) && seq != 0)
  {
    sequences[player, seq] = 1;
  }
  else if(seq == 0 && !member(sequences, player))
  {
    sequences += ([player: ctime(); 0;0;0;0;0;0;0;0 ]);
    Msg(CAP(player)+" beginnt die Quest", QUEST);
    write_file("/log/quests/spuk",
      dtime(time())+": "+CAP(getuid(pl))+" beginnt die Spukquest.\n" );

  }

  SaveData();
  return;
}

// Hat der Spieler diese Sequence schon gesehen?
// Returnwerte: 1 (Spieler hat die Sequenz noch nicht gesehen)
//              0 (Spieler hat die Sequenz bereits gesehen -> nicht nochmal)
int QueryPlayerSequence(string player, int seq)
{
  if(member(sequences, player) && sequences[player, seq] == 0)
    return 1;
  else
    return 0;
}

// Loeschen des Spielers aus dem Mapping (schuettel gedanken ab im eingang)
// Der Spieler kann so die Quest alleine reseten und von vorne beginnen.
// Returnwerte: keine
void DelSequences(string player)
{
  object pl;
  pl = find_player(player);
  if(!player) return;

  sequences=m_delete(sequences, player);
  write_file("/log/quests/spuk",
    dtime(time())+": "+CAP(getuid(pl))+" bricht die Spukquest ab.\n" );

  SaveData();
  return;
}

// Debugzwecke
mixed QuerySequence()
{
  return sequences;
}

// Message bei besonderen Aktionen + logging
void Msg(string s, int level)
{
  object pl;
  int i;
  string str;

  // gelogt wird immer
  write_file(LOG "spuk.log",ctime()+": "+s+".\n");

  pl = find_player("torian");

  // Message gibt es nur wenn der entsprechende Level gesetzt ist
  if(objectp(pl) && interactive(pl) && IS_WIZARD(pl) && (level <= messagelevel))
  {
    str = BSI(s+".","SPUKHAUS: ");
    if(pl->QueryProp(P_TTY)) str = ANSI_BOLD+ANSI_RED+str+ANSI_NORMAL;
    tell_object(pl,str);
  }
  return;
}

// Sequencer fuer die einzelnen Sequencen
// Texte befinden sich in den Raeumen
// # leitet text ein
// * bedeutet das eine funktion aufgerufen werden soll
// object ob, das Object in dem Funktion/en aufgerufen werden soll
// Rueckgabewert: keiner
void sequencer(object spieler, int curpos, mixed *daten, object ob)
{
  // Aufraeumfunktion aufrufen wenn Spieler "verschwindet"
  if (!spieler || !interactive(spieler) || spieler->QueryProp(P_GHOST))
  {
    if (daten[sizeof(daten)-1][0] == 42) // 42 Ascii *
    {
      call_other(ob, daten[curpos+1][1..], spieler);
    }
    return;
  }
  
  if (daten[curpos+1][0] == 35) // 35 Ascii #
  {
    tell_object(spieler, "\n");
    tell_object(spieler, BS(daten[curpos+1][1..]));
  }
  else if (daten[sizeof(daten)-1][0] == 42) // 42 Ascii *
  {
    call_other(ob, daten[curpos+1][1..], spieler);
  }
  if (curpos + 2 < sizeof(daten)) {
    call_out("sequencer", daten[curpos+2], spieler, curpos+2, daten, ob);
  }
  else // Sequence fertig
  {
    spieler->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:0,
      PARALYZE_MSG:"",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));

  }
  return;
}

void QuestFertig(object player)
{
  if (getuid(previous_object()) != getuid())
  {
    raise_error("Illegal call!");
    return;
  }

  if(!player) return;

  switch(player->GiveQuest(QUESTNAME)) {
    case 1:  write_file( "spuk.log", 
               dtime(time())+": "+CAP(getuid(player))+" loest die Quest.\n" );
             write_file("/log/quests/spuk",
               dtime(time())+": "+CAP(getuid(player))+" loest die Quest.\n" );
             break;
    case -1: write_file(QUESTLOG "spuk.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -1 "
                            +"(Bereits geloest!)\n" );
             tell_object(player, BS("Du hast die Quest bereits geloest! Sollte das nicht "
                     +"stimmen, wende Dich SOFORT an einen anwesenden Magier!"));
             break;
    case -2: write_file(QUESTLOG "spuk.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -2 "
                           +"(Quest nicht angemeldet!)\n" );
             tell_object(player, BS("Die Quest ist leider noch nicht angemeldet! Sollte es "
                     +"diese Quest dennoch geben, wende Dich SOFORT an einen "
                     +"anwesenden Magier!"));
             break;
    case -3: write_file(QUESTLOG "spuk.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -3 "
                            +"(Unbefugter Zugriff!)\n" );
             tell_object(player, BS("Unbefugter Zugriff, wende Dich bitte SOFORT an einen "
                     +"anwesenden Magier!"));
             break;
    case -4: write_file(QUESTLOG "spuk.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -4 "
                            +"(Quest deaktiviert)\n" );
             tell_object(player, BS(
               "Die Quest ist deaktiviert!"));
             break;
    default: write_file(QUESTLOG "spuk.log", 
               dtime(time())+": "+CAP(getuid(player))+" UNBEKANNTER FEHLER!!\n" );
             tell_object(player, BS(
               "Unbekannter Fehler!! Bitte wende Dich SOFORT an "
               "einen anwesenden Magier!!!"));
             break;    
  }

  return;
}
