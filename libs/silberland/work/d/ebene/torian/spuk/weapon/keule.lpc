inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine alte Keule");
  SetProp(P_LONG,  
    "Die Keule ist aus massivem Holz gefertigt. Dennoch hat auch bei "
    "ihr der Zahn der Zeit seine Arbeit getan. Das Griffstueck ist mit "
    "Lederbaendern umwickelt, das Kopfstueck ist mit hunderten "
    "Eisendornen gespickt.");
  SetProp(P_NAME, "Keule");
  SetProp(P_NAME_ADJ,({ "alt" }));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"keule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 130);
  SetProp(P_WC_FIX, 25);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD :80, MAT_IRON: 20]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 250);
  SetProp(P_SIZE, 75);
  SetProp(P_QUALITY_DECAY, 70);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) );

  AddDetail( ({ "zahn", "zeit", "arbeit", "zustand" }),
   "Die Keule ist in keinem guten Zustand.");
  AddDetail( ({ "griffstueck", "griff" }),
   "Das Griffstueck ist schlicht gehalten, lediglich ein paar "
   "Lederbaender sorgen fuer einen besseren Griff.");
  AddDetail( ({ "lederbaender", "baender" }),
   "Die Baender sind alt und verfault.");
  AddDetail( ({ "kopfstueck" }),
   "Das Kopfstueck ist mit hunderten Eisendornen gespickt.");
  AddDetail( ({ "stueck" }),
   "Welches Stueck meinst Du? Kopf- oder Griffstueck?");
  AddDetail( ({ "eisendornen", "dornen", "eisendorne", "dorne" }),
   "Nur wenig Rost hat sich an den Eisendornen abgelegt.");
  AddDetail( ({ "rost" }),
   "Die Eisendornen sind noch am besten erhalten.");
  
}