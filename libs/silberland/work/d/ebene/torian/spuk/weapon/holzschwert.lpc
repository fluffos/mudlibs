inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein altes Holzschwert");
  SetProp(P_LONG,  
    "Das Holzschwert wurde fuer Kinder geschnitzt. Es ist daher kuerzer "
    "als normal. Sogar der Griff ist kleiner. Ein Hobbit kommt damit sicher "
    "gut klar. Im Kampf jedoch ist es bestimmt keine Hilfe.");
  SetProp(P_NAME, "Holzschwert");
  SetProp(P_NAME_ADJ,({ "alt" }));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"holzschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 50 + random(10));
  SetProp(P_WC_FIX, 15);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD :100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 5);
  SetProp(P_SIZE, 75);
  SetProp(P_QUALITY_DECAY, 70);

  AddDetail( ({ "griff", "hobbit" }),
   "Ideal fuer Kinderhaende, oder Hobbits.");
  AddDetail( ({ "kampf", "hilfe" }),
   "Wer mit solch einem Schwert in den Kampf zieht hat eine ausgepraegten "
   "Todeswunsch.");
  AddDetail( ({ "wunsch", "todeswunsch" }),
   "Selbstmord ist auch keine Loesung.");
  AddDetail( ({ "selbstmord", "loesung" }),
   "Manchmal vielleicht doch ... <syntax: selbstmord>");
   
  AddCmd( ({ "selbstmord"}), "cmd_selbstmord" );
}

int cmd_selbstmord(string str )
{

  write(BS("Verzweifelt versuchst Du Dich mit dem Holzschwert umzubringen. "
           "Reisst Dir aber lediglich einen Splitter ein, nicht einmal "
           "das funktioniert mit diesem Schwert."));
  TP->AddHp(-10-random(10));
  ENV(TP)->Message(BS(TP->Name()+" rammt sich ein Holzschwert in den Bauch "
         +"und jammert laut wegen eines Splitters."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}
