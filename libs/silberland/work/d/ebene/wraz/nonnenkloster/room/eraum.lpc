inherit "std/room";

#include "../def.h"
#include <bank.h>
#include <combat.h>

int candle, total_amount;
string keazn();
object *players;
mapping diebe, anzuender, spender;

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG, 
  	 "Du stehst hier im Vorraum eines grossen Klosters. Im Norden befindet sich "
  	 "das Buchenholztor, durch welches Du hereingekommen bist. An der westlichen "
  	 "Wand siehst Du ein kleines Tischchen mit Kerzen, an der gegenueberliegenden "
  	 "erkennst Du ein grosses Symbol. Nach Sueden hin kannst Du eine Art Kirche "
  	 "betreten.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_HOUSE]));
  
  AddDetail("marmor",
  	"Die Bloecke im Boden bestehen aus Marmor.");
  
  AddDetail("boden",
  	 "Der Boden besteht aus zusammengesetzten Marmorbloecken.");
  	 
  AddDetail( ({"bloecke", "marmorbloecke"}),
  	 "Sie sind hellgelb und etwa einen Hobbit lang und genauso breit. Wie tief "
  	 "sie in die Erde reichen, weisst Du nicht.");
  	 
  AddDetail( ({"hobbit", "meter"}),
  	 "Ein Hobbit ist knapp einen Meter gross.");
  	 
  AddDetail( ({"erde"}),
  	 "Die siehst Du hier nicht. Sie befindet sich unter den Marmorbloecken.");
  	 
  AddSpecialDetail( ({"kerzen", "kerze"}), "keazn");
 
  AddDetail( ({"schalen", "schale"}),
  	 "Jede Kerze steht in einer roten Schale aus Ton.");
  	 
  AddDetail( ({"ton"}),
  	 "Der Ton ist gebrannt. Daher kommt die rote Farbe.");
  	 
  AddDetail( ({"westwand"}),
  	 "Die Westwand besteht wie alle anderen Waende aus Stein. Viel interessanter "
  	 "als die Wand selbst ist jedoch das Tischchen vor ihr.");
  	 
  AddDetail( ({"stein", "gestein"}),
  	 "Hmm. Du hast keine Ahnung was fuer ein Gestein, das sein koennte.");
  	 
  AddDetail( ({"ahnung"}),
  	 "Du hast keine.");
  	 
  AddDetail( ({"wand"}),
  	 "Welche meinst Du? Nord, Sued, West oder Ost?");
  	 
  AddDetail( ({"tischchen"}),
  	 "Darauf befinden sich die Kerzen in den roten Schalen und ausserdem ein Glas, "
  	 "mit einem Etikett.");
  	 
  AddDetail( ({"glas"}),
  	 "In dem Glas liegen einige Muenzen. Es hat ein Etikett.");
  	 
  AddDetail( ({"muenzen"}),  // stehle muenzen heraus --- CMD
  	 "Die liegen in dem Glas. Wenn Du sehr boese bist, kannst Du Dir welche "
  	 "herausstehlen.");
  	 
  AddDetail( ({"etikett"}), // lies etikett --- CMD --- wirf muenzen in glas, 
  			    //zuende kerze an
  	 "Darauf steht etwas geschrieben. Du kannst es lesen.");
  	 
  AddReadDetail( "etikett",
  	 " _______________________ \n"
  	 "|                       |\n"
  	 "| S P E N D E N G L A S |\n"
  	 "|_______________________|");
  	 
  AddDetail( "spendenglas",
  	 "Wenn Du willst, kannst Du eine oder mehrere Muenzen hineinwerfen!");
  	 
  AddDetail( ({"vorraum"}),
  	 "In dem befindest Du dich.");
  	 
  AddDetail( ({"kloster", "klosters"}),
  	 "Ja, es handelt sich hier eindeutig um ein Kloster. Vielleicht "
  	 "solltest Du Dich weiter umsehen!");
  	 
  AddDetail( ({"norden"}),
  	 "Dort ist das Buchenholztor, durch welches Du hereingekommen bist.");
  	 
  AddDetail( ({"buchenholztor", "tor"}),
  	 "Es sieht von hier aus genauso aus wie von aussen, nur dass hier "
  	 "keine Metallringe sind.");
  	 
  AddDetail( ({"metallringe"}),
  	 "Keine da.");
  	 
  AddDetail( ({"gegenueberliegende wand", "ostwand"}),
  	 "In die Wand wurde ein Symbol eingemeisselt und anschliessend ausgemalt.");
  	 
  AddDetail( ({"symbol"}),
  	 "Das rote Symbol stellt eine Birne dar. Irgendwoher kommt es Dir bekannt "
  	 "vor.");
  	 
  AddDetail( ({"birne"}),
  	 "Sie hat einen Staengel, an welchem sogar ein Blatt erkennbar ist.");
  	 
  AddDetail( ({"blatt", "staengel"}),
  	 "Sehr gut erkennbar eingemeisselt und ausgemalt!");
  	 
  AddDetail( ({"suedwand"}),
  	 "In der Suedwand befindet sich ein Durchgang.");
  	 
  AddDetail( ({"durchgang"}),
  	 "Du kannst nach Sueden gehen.");
  	 
  AddDetail( ({"sueden"}),
  	 "Dort siehst Du eine Art Kirche. Du siehst Holzbaenke und einen Altar mit "
  	 "dem "
  	 "Birnensymbol darauf.");
  	 
  AddDetail( ({"art", "kirche", "holzbaenke", "altar", "birnensymbol"}),
  	 "Das siehst Du im Sueden.");
  	 
  AddDetail( ({"waende"}),
  	 "Du siehst eine Nord-, Sued-, Ost- und Westwand.");
  	 
  AddDetail( ({"nordwand"}),
   	 "Durch diese Wand fuehrt das Buchenholztor.");
   	 
  AddDetail("decke",
  	 "Total uninteressant.");
  	 
  AddDetail("farbe",
  	 "Rot!");
  	 
  AddDetail("gewissen",
  	"Ist Deines rein?");
  	
  AddDetail("zuendholzschachtel",
  	"Oh! Da liegt ja eine auf dem Tischchen!");
  	
  AddSmell(DEFAULT_SMELL,
  	"Es riecht hier nach Feuer.");
  
  AddSmell( ({"feuer"}),
  	 "Nach Feuer und Kerzen!");
  	 
  AddSmell( ({"kerzen"}),
  	 "Hmm! Sie duften nach Russ und Wachs!");
  	 
  AddSmell( ({"russ","wachs"}),
  	 "Riecht wie Weihnachten!");
  	 
  AddSmell( ({"weihnachten"}),
  	 "Daran erinnert sich bestimmt jeder gerne!");
  	 
  AddSound(DEFAULT_SOUND,
  	 "Eine angenehme Stille.");
  	 
  AddSound("stille",
  	 "Herrlich.");
  	 
  
  
  AddCmd( ({"wirf", "werfe", "spende", "spend"}), "werfen");
  AddCmd( ({"stehle", "stiehl", "stehl"}), "stehlen");
  AddCmd( ({"zuende", "zuend"}), "anzuenden");
  
  AddExit("raus", ROOM "w05");
  AddExit("sueden", ROOM "kiachn");
  
  candle=0;
  total_amount=0;
  players=({});
  diebe=([]);
  anzuender=([]);
  spender=([]);
}

int werfen(string str)  // ---- CMD ---- wirf muenze in glas
{
  int cont_a, amount;
  string coins; 
  cont_a=0;

  if(!str) return 0;

  notify_fail("Was willst Du spenden, bzw wie viel davon?\n");

  if((sscanf(str,"%d %s",amount,coins)==2) &&
      (coins=="muenzen"||coins=="muenze"||coins=="geld")) cont_a=1;
  //checken, ob eine anzahl angegeben wurde

  if(!amount&&cont_a) {
    TP->Message("Null Muenzen? So ein Bloedsinn!\n");
    return -1; 
  }

  if( str=="muenzen in spendenglas" || str=="muenzen in glas" ||
      str=="muenzen"||str=="muenzen ins spendenglas"||str=="muenzen ins "
      "glas"||cont_a)
  {
    int goed;
    int blab;
    int rand_amount;
    goed=TP->QueryMoney();

    if(goed==0)
    {
      write(BS("Aber Du hast ja gar kein Geld dabei!"));
      return -1;
    }

    if(total_amount>5555)
    {
      TP->Message(BS("Hui da waren ja fleissige Spender! Das Glas ist so "
            "voll, dass einfach keine einzige Muenze mehr hineinpasst."));
      return -1;
    } 

    if (goed < amount)
    {
      write("Aber soviele Muenzen hast Du gar nicht!\n");
      return -1;
    }

    if(goed>0)
    {
      int align, new_align;
      float falign, famount, faktor;
      faktor=1.0;

      if ((align=TP->QueryProp(P_ALIGN)) < 1000)
      {
        if(member(players,TP)!=-1) faktor=0.1;

        if(!cont_a) {
          rand_amount=random(300);
          new_align=align+random(6);
          TP->AddMoney(-(5+rand_amount));
          total_amount+=rand_amount;
          }

        else {
          famount=to_float(amount);
//        falign=(famount+(80+to_float(random(40)))*(famount/(famount+100)))*faktor;
// gibt zu viel + align, jetzt maximal +500 pro reset
// notiz fuer mich:
// wenn amount + total_amount > 5555 dann 5555 - total_amount, sonst amount
// (if expr1 true -> expr2, else expr 3)
// das ist ein OPERATOR!!!
          falign= (amount + total_amount > 5555 ? 5555 - total_amount : amount) / 11.0;
          new_align= align+to_int(falign);
// hier fehlte das "align+"
// FIXED BY WRAZ!!
          TP->AddMoney(-amount);
          total_amount+=amount;
        }

// maximal bis 1000, besser als heilig soll man nicht werden
// Fixed by Feyaria
        if (new_align > 1000) new_align = 1000;
        TP->SetProp(P_ALIGN, new_align);
        WLOG(LOG "spende", sprintf("erhoeht Align von %d auf %d fuer %d Muenzen",
              align, new_align, amount));
      }
// nochmal fix: zeit auch eintragen wnen man align > 1000 hat (Feyaria)      
      spender[getuid(TP)]=time();
      if(member(players,TP)!=-1)
      {    	    
        write(BS("Du wirfst noch ein paar Muenzen in das Spendenglas und "
              "fuehlst Dich ein bisschen besser."));
        say(TPN+" wirft ein paar Muenzen in das Spendenglas.\n");
        return 1;
      }

      else
      {
        players+=({TP});
        write(BS("Du wirfst einige Muenzen in das Spendenglas und hast das "
              "Gefuehl, etwas Gutes getan zu haben. Ausserdem meinst Du, "
              "nun eine Kerze anzuenden zu duerfen."));

        say(TPN+" wirft ein paar Muenzen in das Spendenglas.\n");
        return 1;
      }

    } // goed
  } // muenzen in spendenglas
} // int ...

int stehlen(string str)  // ---- CMD ---- stehle muenzen aus glas
{
  int blab;
  notify_fail("Was willst Du woraus stehlen?\n");
  if(!str) return 0;

  if(str=="muenzen aus glas" || str=="muenzen aus spendenglas" ||
      str=="geld aus glas" || str=="geld aus spendenglas")
  {
    //blab=TP->QueryProp("behse");

    //if(blab>time()-1000)
    if(diebe[getuid(TP)]>time()-1000)
    {
        TP->Message(BS("Du willst nicht schon wieder stehlen!"));
        return -1;
    }
    
    else
    {
        //TP->SetProp("behse", time());
        TP->Message(BS("Du fummelst in dem Glas herum und holst Dir ein paar Muenzen "
        		"heraus. "
        	       "Ploetzlich fuehlst Du Dich so boese..."));
        say(TPN+" klaut sich Muenzen aus dem Spendenglas!\n");
        
        TP->AddMoney(3+random(30));
      
        blab=TP->QueryProp(P_ALIGN);
        blab=blab-(30+random(30));
        //TP->SetProp(P_ALIGN, blab);
        diebe[getuid(TP)]=time();
        return 1;
    }
  }
  

    if (str=="muenze aus glas" || str=="muenze aus spendenglas")
    {
      TP->Message(BS("Was, nur eine? Das zahlt sich nun wirklich nicht aus!"));
      return -1;
    }
}

int anzuenden(string str)  // ---- CMD ---- zuende kerze an
{
   if(!str) return 0;
   
   if(str=="kerzen an") {
   TP->Message("Was? Eine Kerze reicht Dir nicht?\n");
   return -1; }
   
   if(str=="kerze an")
   {
       //int blab;

       
       //blab=TP->QueryProp("candle10112");
       //if(blab>time()-1000)
       if(anzuender[getuid(TP)]>time()-1000)
       {
	TP->Message(BS("Nein. Du willst nicht schon wieder eine Kerze anzuenden. "
		 "Es gibt ja noch "
		 "andere, und fuer die ist dann vielleicht keine mehr uebrig!"));
        return -1;
       }
       
       
       //blab=TP->QueryProp("liab");
       	
       //if(blab>time()-1000)
       if(spender[getuid(TP)]>time()-1000)
       {
       	   if(candle>20)
       	   {
       	   	TP->Message(BS("Oh! Schade, es brennen schon alle Kerzen."));
       	   	return -1;
       	   }
       	   
       	   else
       	   {
     TP->Message(BS("Da Du dem Kloster etwas gespendet hast, kannst Du "
          "reinen Gewissens "
          "eine Kerze anzuenden. Nur   -  womit? Ahh! Ploetzlich siehst Du eine "
          "kleine Zuendholzschachtel neben einer Kerze liegen. Schnell nimmst Du "
          "Dir eines heraus, reibst es an und entflammst damit eine Kerze."));
           say(TPN+" zuendet eine Kerze an.\n");
           candle++;
           switch (candle)
           {
             case 1 .. 2: ROOM "eraum"->SetProp(P_LIGHT, 2); break;
             case 3 .. 6: ROOM "eraum"->SetProp(P_LIGHT, 3); break;
             case 7 .. 9: ROOM "eraum"->SetProp(P_LIGHT, 4); break;
             case 10 .. 12: ROOM "eraum"->SetProp(P_LIGHT, 5); break;
             case 13 .. 16: ROOM "eraum"->SetProp(P_LIGHT, 6); break;
             case 17 .. 19: ROOM "eraum"->SetProp(P_LIGHT, 7); break;
             case 20: ROOM "eraum"->SetProp(P_LIGHT, 8); break;
             default: write(BS("Hups! Fehler :) bitte einen Magier benachrichtigen."));
             break;
           }
           //TP->SetProp("candle10112", time());
           anzuender[getuid(TP)]=time();
           return 1;
           }
       }
       
       else
       {
       	  // blab=TP->QueryProp("behse");
       	   //if(blab>time()-1000)
       	   if(diebe[getuid(TP)]>time()-1000)
       	   {
       	   	TP->Message(BS("Zuerst Muenzen klauen und dann auch noch Kerze "
       	   	"anzuenden??"));
       	   	return -1;
       	   }
       	   
       	   else
       	   {
       	   TP->Message(BS("Du hast das Gefuehl, dass Du vielleicht zuerst ein paar "
       	   	    "Muenzen spenden solltest."));
       	   return -1;
       	   }
       }
}
}
       	   	
string keazn()
{
    switch (candle)
    {
     case 0:
    return "Auf dem Tischchen an der Westwand stehen einige Kerzen in roten Schalen.\n"
    	   "Keine von ihnen brennt.\n";
     break;
     
     case 1:
    return "Auf dem Tischchen an der Westwand stehen einige Kerzen in roten Schalen. \n"
    	   "Eine Kerze brennt.\n";
     break;
     
    default:
    return "Auf dem Tischchen an der Westwand stehen einige Kerzen in roten Schalen. \n"
            +candle+" davon brennen.\n";
     break;
    }
}

reset()
{
  object nun;
  ::reset();
  candle=0;
  nun=find_living("\nnuns_by_wraz");
  
  if(nun&&!nun->InFight()) {
    if(total_amount) ZENTRALBANK->PayIn(total_amount);
    total_amount=0;
    players=({});
    nun->move(ROOM "eraum", M_TPORT, "davon",
     "saust eilig", "kommt herein und leert das Spendenglas"); }    
    
}
