// Gesellenstück
// Gesangraum in 2. Stock - sing.c
// Vond Wraz / Mendralim
// -> 40 Details, 1 Sound, 3 Smells, 1 Funktion

//note: Tuch (magisch)!
//	AddSound per ::init()
//	IMMER hell!

inherit "std/room";

#include "../def.h"

int tuecher;

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG,
  	"Du bist hier in einem Zimmer, welches die Nonnen benutzen um ihr "
  	"musikalisches Talent zu trainieren. Es stehen hier einige Reihen "
  	"Notenstaender. Der Raum wird von einigen Gruenpflanzen und Bildern "
  	"geschmueckt. Er ist ausserdem oval.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23+random(2), ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail( ({"zimmer","raum"}),
  	"Dieses Zimmer wird von den Nonnen als Singraum genutzt. Es hat eine ovale "
  	"Form. Welchen Sinn das haben mag? Jedenfalls wurde die Wand mit weissem "
  	"Kalk bestrichen und mit einigen Bildern behangen. Auf und neben einem Regal "
  	"stehen Blumen.");
  	
  AddDetail( ({"talent"}),
  	"Wenn Du den Nonnen beim Singen zuhoerst wirst Du schon bemerken, ob sie "
  	"dieses haben oder nicht.");
  	
  AddDetail( ({"boden"}),
  	"Der Boden setzt sich hier aus blauem Marmor zusammen. Halt - blauer Marmor??? "
  	"Gibt es sowas denn ueberhaupt?");
  	
  AddDetail( ({"marmor"}),
  	"Eindeutig Marmor. Und er ist blau.");
  	
  AddDetail( ({"nonnen"}),
  	"Die Nonnen verbringen hier ein Leben im Einklang mit der Natur.");
  	
  AddDetail( ({"nonne"}),
  	"Seltsam, momentan ist keine hier.");
  	
  AddDetail( ({"leben","einklang","natur"}),
  	"Die Natur gibt den Nonnen Kraft in allen Lebenssituationen.");
  	
  AddDetail( ({"lebenssituationen","situationen"}),
  	"In allen, den guten und den schlechten, den leichten und den schweren, den "
  	"friedlichen und auch den kaempferischen.");
  	
  AddDetail( ({"singraum"}),
  	"Er hat eine spezielle Form.");
  	 
  AddDetail( ({"form","sinn"}),
  	"Das Zimmer ist oval. Warum nur? Vielleicht weiss eine der Nonnen mehr "
  	"darueber.");
  	
  AddDetail( ({"waende"}),
  	"Da der Raum oval ist hat er eigentlich nur eine Wand.");
  	
  AddDetail( ({"wand"}),
  	"Sie wurde mit weissem Kalk ausgestrichen und ausserdem mit Bildern "
  	"ausgeschmueckt. Es fuehren drei Tueren hinaus.");
  	
  AddDetail( ({"tueren","tuer","richtung"}),
  	"Nach Sueden, Norden und Westen.");
  	
  AddDetail( ({"norden","westen","sueden"}),
  	"In diese Richtung fuehrt eine Tuer, durch welche Du den Raum hier verlassen "
  	"kannst.");
  	
  AddDetail( ({"kalk","weiss"}),
  	"Dadurch erstrahlt die Wand in wunderschoenem Weiss.");
  	
  AddDetail( ({"bilder"}),
  	"Auf ihnen sind Personen, Landschaften, aber auch Symbole abgebildet.");
  	
  AddDetail( ({"personen"}),
  	"Nonnen und andere, welche Du nicht kennst.");
  	
  AddDetail( ({"landschaften"}),
  	"Huebsche Waelder, Gebirge, Steppen und viele andere.");
  	
  AddDetail( ({"waelder","gebirge","steppen"}),
  	"Einige der Bilder.");
  	
  AddDetail( ({"symbole"}),
  	"Auf einem besonders grossen und verzierten Bild siehst Du ein Dir bekanntes "
  	"Symbol.");
  	
  AddDetail( ({"bild"}),
  	"Es hat einen goldenen Rahmen mit vielen Schnoerkel und ist mit einem roten "
  	"Tuch umwickelt.");
  	
  AddDetail( ({"rahmen"}),
  	"Er ist vergoldet.");
  	
  AddDetail( ({"schnoerkeleien","schnoerkel","rundungen","verzierungen"}),
  	"Viele Rundungen und Verzierungen.");
  	
  AddDetail( ({"tuch"}),
  	"Das Tuch hat eine eigenartige Ausstrahlung.");
  	
  AddDetail( ({"ausstrahlung"}), // TUCH
  	"Du hast das Gefuehl, dass eine magische Kraft von ihm ausgeht.");
  	
  AddDetail( ({"gefuehl"}),
  	"Du willst es haben!!");
  	
  AddDetail( ({"kraft","koerper"}),
  	"Du fuehlst es in Deinem Koerper.");
  	
  AddDetail( ({"symbol"}),
  	"Es ist die Darstellung einer Birne.");
  	
  AddDetail( ({"darstellung"}),
  	"Eine Birne mit Blatt und Staengel.");
  	
  AddDetail( ({"birne","blatt","staengel"}),
  	"Das gehoert zu dem Symbol. Es ist das Erkennungsmerkmal dieses Klosters.");
  	
  AddDetail( ({"erkennungsmerkmal"}),
  	"Das ist die Birne.");
  	
  AddDetail( ({"kloster"}),
  	"Ein huebsches Kloster, findest Du nicht?");
  	
  AddDetail( ({"regal"}),
  	"An der Wand steht ein Regal. Auf und neben ihm wurden Blumen platziert.");
  	
  AddDetail( ({"blumen"}),
  	"Blumen in vielen, kraeftigen bunten Farben. Sie bilden einen huebschen "
  	"Kontrast zu der weissen Wand.");
  	
  AddDetail( ({"farben"}),
  	"Die Blumen haben viele attraktive Farben.");
  	
  AddDetail( ({"kontrast"}),
  	"Durch die Farben sieht sich alles hier viel angenehmer an.");
  	
  AddDetail( ({"reihen","notenstaender"}),
  	"Die Notenstaender wurden in Reihen aufgestellt. So koennen die Nonnen beim "
  	"Singen nebeneinander stehen ohne sich gegenseitig zu stoeren.");
  	
  AddDetail( ({"singen"}),
  	"Du kannst ihnen ja einmal zuhoeren!");
  	
  AddDetail( ({"gruenpflanzen","pflanzen"}),
  	"Bei dem Regal stehen Blumen.");
  	
  AddDetail( ({"decke"}),
  	"Die Decke ist gewoelbt und 'verschmilzt' foermlich mit der Wand. An ihr "
  	"siehst Du ein seltsam leuchtendes Symbol.");
  	
  AddDetail( ({"bluetenstaub"}),
  	"Der Bluetenstaub befindet sich in den Blumen.");
  	
  
  AddSmell(DEFAULT_SMELL,
  	"Es duftet hier nach Bluetenstaub.");
  	
  AddSmell( ({"bluetenstaub","geruch"}),
  	"Der Geruch kommt von den Blumen.");
  	
  AddSmell( ({"blumen", "blume"}),
  	"Hmm! Sie riechen herrlich!");
  	
  AddSound(DEFAULT_SOUND,
  	"Du meinst, einen Gesang zu hoeren.");
  	
  AddSound( ({"singen", "gesang"}),
  	"Wenn Du hier ein Weilchen wartest hoerst Du sicherlich bald eine "
  	"der Nonnen singen! Oder noch besser, Du fragst einfach einmal eine "
  	"danach!");
  	
  
  AddExit("norden",ROOM "oobtreppe");
  AddExit("westen",ROOM "orgelraum");
  AddExit("sueden",ROOM "gang");
  
  AddCmd(({"stehle","stehl","stiehl"}),"cmd_stehlen");
  
  tuecher=1;
}

int _query_total_light() {return 1;}

int cmd_stehlen(string str)
{
  if(!str||str=="") return 0;
  notify_fail("Was willst Du tun?\n");
  
  if(str=="tuch")
  {
      if(tuecher==1) 
      { // ----- +++ if 1++ -----
      
      	if(!find_living("\nnuns_by_wraz")) 
      	{ // ----- +++ if 2+++ -----
      	  object ob;
    	  ob=clone_object(ARMOUR "schal");
    	  if(ob->move(TP, M_GET) == ME_TOO_HEAVY)
    	    {
      	     ob->remove(1);
      	     TP->Message(BS("Das Tuch ist Dir zu schwer."));
      	     return -1;
    	    }
    	  else
    	  {
    
      	    write_file(LOG "tuch.klauen",
      	    dtime()+": "+TPN+" klaut sich ein Tuch.\n");
      		TP->Message(BS("Du klaust Dir das Tuch und grinst boese!"));
      		TP->SetProp(P_ALIGN, QueryProp(P_ALIGN)-random(81));
      		ROOM "sing"->Message(BS(TPN+" grinst haemisch boese."),MSGFLAG_VISUAL|
      		MSGFLAG_NO_TP);
      		tuecher--;
      		return 1; 
      	  }
      	} // ----- +++if 2 end+++ -----
      
        else // ----- ++++else 2++++ -----
        {
            write_file(LOG "tuch.klauen",
            dtime()+": "+TPN+" versucht Tuch zu klauen (Nonnen da).\n");
            if(ENV(find_living("\nnuns_by_wraz"))!=find_object(ROOM "sing"))
          	find_living("\nnuns_by_wraz")->move(ROOM "sing",M_TPORT, 
          	"eilig davon", "saust", "kommt hereingehastet");
          	TP->Message(BS("Noch bevor Du das Tuch an Dich nehmen kannst stellt sich "
          	"Dir eine Nonne in den Weg."));
          	return -1;
        }  // ----- ++++else 2 end++++ -----
      } // ----- ++if 1 end++ -----
      
      else 
      { // ----- +++++else 3+++++ -----
        write_file(LOG "tuch.klauen",
        dtime()+": "+TPN+" versucht Tuch zu klauen (Tuch schon weg).\n");
      	TP->Message(BS("Hmpf. Doch kein Tuch da!"));
      	return -1; 
      } // ----- +++++else 3 end+++++ -----
    
 }
} // BITTE NICHT LACHEN, ICH KENN MICH DA SONST NIMMER AUS :)

void reset()
{
  ::reset();
  tuecher=1;
}
