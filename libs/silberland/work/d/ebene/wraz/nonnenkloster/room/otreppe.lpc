// Gesellenstück
// Westtreppe - otreppe.c
// Von Wraz / Mendralim
// 65 Details
// immer hell

inherit "std/room";

#include "../def.h"
#include <language.h>

create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG, 
  	"Du stehtst hier im oestlichen Teil der Kirche. Hier ist ein kleiner "
  	"Aufgang, welcher vermutlich in das obere Stockwerk des Klosters fuehrt. "
  	"Der Altar befindet sich westlich von hier, genauso wie die Holzbaenke.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail("aufgang",
  	 "Der Aufgang fuehrt um mehrere Ecken vermutlich hinauf in den oberen Stock. "
  	 "Die einzelnen Stufen wurden aus edelstem, weissen Marmor gefertigt.");
  	 
  AddDetail( ({"marmor", "feinsten", "wert"}),
  	 "Weisser, polierter Marmor vom Feinsten! Der Erbauer des Klosters legte anscheinend "
  	 "viel Wert auf schoene Boeden.");
  	 
  AddDetail("erbauer",
  	 "Wer das wohl gewesen sein mag?");
  	 
  AddDetail("boeden",
  	 "Selbst der Boden aus Steinbloecken ist poliert!");
  	 
  AddDetail("ecken",
  	 "Die Stufen fuehren zuerst gerade, dann nach einem 90 Grad Eck weiter hinauf. "
  	 "Mehr siehst Du nicht, da Du von hier aus nicht ums Eck schaun kannst.");
  	 
  AddDetail("grad", "90 Grad.");
  	 
  AddDetail("eck",
  	 "Von hier aus ist nur eines zu sehen, vermutlich folgt aber zumindest noch ein "
  	 "weiteres.");
  	 
  AddDetail("stufen",
  	 "Sie bestehen aus perfektem Marmor.");
  
  AddDetail("teil",
  	 "Im oestlichen.");
  
  AddDetail("kirche",
  	 "So koennte man diesen Raum hier bezeichnen.");
  	
  AddDetail("raum",
   	 "Eine Kirche.");
   	 
  AddDetail("kloster",
   	"Darin befindest Du Dich.");
   	
  AddDetail( ({"holzbaenke", "baenke"}),
  	 "Holzbaenke wie sie in jeder Kirche zu finden sind, damit man waehrend der Messe "
  	 "nicht stehen muss.");
  	 
  AddDetail("messe",
   	"Die Nonnen hier halten regelmaessig eine Messe.");
   	
  AddDetail("nonnen",
   	"Die eilen hier herum.");
   	
  AddDetail("nonne",
   	"Momentan scheint keine hier zu sein.");
   	
  AddDetail("altar",
  	 "Er steht weiter westlich. Von hier aus kannst Du aber sonst nicht viel erkennen.");
  	 
    AddDetail( ({"decke"}),
  	 "An der vergoldeten Decke erkennst Du reichlich Verzierungen und Schnoerkeleien. "
  	 "Ausserdem wurde ein grosses Fresko in die Decke gearbeitet. Sie befindet sich "
  	 "sehr hoch oben.");
  	 
  AddDetail( ({"suedwand"}),
  	 "In die Suedwand ist eine kleine Holztuer hineingebaut.");
  
  AddDetail( ({"holztuer","tuer"}),
   "Sie ist etwas weiter westlich in der Suedwand.");
  	 
  AddDetail( ({"gelaender"}),
  	 "Das Gelaender gehoert wahrscheinlich schon zum naechsten Stockwerk.");
  	 
  AddDetail( ({"stock", "stockwerk", "stockwerke"}),
  	 "Anscheinend hat das Kloster mehrere Stockwerke.");
  	 
  AddDetail("verzierungen",
  	 "Die Verzierungen schmuecken die Decke und machen sie huebsch.");
  	 
  AddDetail("schnoerkeleien",
  	 "Die Schnoerkeleien erstrecken sich ueber die gesamte Decke und geben ihr ein "
  	 "huebsches Aussehen.");
  	 
  AddDetail("aussehen",
  	 "Sehr huebsch!");
  	 
  AddDetail("fresko",
  	 "Es stellt eine Birne samt Staengel und einem Blatt dar und leuchtet seltsam.");
  	 
  AddDetail("licht",
  	 "Erst jetzt faellt Dir auf, dass es hier eigentlich komplett "
  	 "dunkel sein muesste, da "
  	 "nirgendwo Fenster in die Waende eingebaut sind. Das Licht welches, "
  	 "den Raum anscheinend "
  	 "erhellt, geht von dem Fresko an der Decke aus.");
  	 
  AddDetail( ({"fenster"}),
  	 "Du blickst Dich nocheinmal um, findest aber keine.");
  	 
  AddDetail( ({"waende", "wand"}),
  	 "Hier an der Wand haengen einige Bilder. Du meinst auch welche an der weiter "
  	 "entfernten Westwand ausmachen zu koennen.");
  	 
  AddDetail( ({"westwand"}),
  	 "Du glaubst einige Bilder zu sehen, bist Dir aber nicht sicher, "
  	 "da die Wand relativ "
  	 "weit entfernt ist.");
  	 
  AddDetail( ({"bild", "bilder"}),
  	 "Die Bilder stellen Landschaften und Waelder dar.");
  	 
  AddDetail( ({"landschaften"}),
  	 "Sehr schoene Landschaften, mit Feldern, Fluessen und Baeumen. Manche der Bilder "
  	 "sind Abendrot gemalt und vermitteln ein romantisches Gefuehl.\n"
  	 "Ach wie schoen!");
  	 
  AddDetail( ({"gefuehl"}),
  	 "Wahrlich romantisch!");
  	 
  AddDetail( ({"felder", "feld"}),  // seitenspezifisch ab hier
  	 "Gruene Kornfelder.");
  	 
  AddDetail( ({"kornfelder", "kornfeld"}),
  	 "Sie sind meist rechteckig.");
  	 
  AddDetail( ({"fluesse"}),
  	 "Auf einem Bild ist ein reissender Fluss dargestellt.");
  	
  AddDetail( ({"fluss"}),
  	 "Wilde Stroemungen und Stromschnellen sind zu erkennen.");
  	 
  AddDetail( ({"stroemungen", "stromschnellen", "stroemung", "stromschnelle"}),
  	 "Sie sind auf dem Bild gut dargestellt.");
  	 
  AddDetail( ({"baeume"}),
  	 "Teils Laub-, teils Nadelbaeume.");
  	 
  AddDetail( ({"laubbaeume"}),
  	 "Sie bilden Laubwaelder.");
  	 
  AddDetail( ({"nadelbaeume"}),
  	 "Sie bilden Nadelwaelder.");
  	 
  AddDetail( ({"waelder"}),
  	 "Auf den meisten Bildern sind reine Laub- beziehungsweise Nadelwaelder dargestellt. "
  	 "Aber auf einem siehst Du auch einen Mischwald.");
  	 
  AddDetail( ({"nadelwaelder", "nadelwald"}),
  	 "Der Maler hat so gute Arbeit geleistet, dass man sogar einzelne Laerchen erkennen "
  	 "kann.");
  	 
  AddDetail( ({"laerchen", "laerche", "art"}),
  	 "Diese Art verliert im Winter seine Nadeln.");
  	 
  AddDetail( ({"nadeln", "nadel"}),
  	 "Die Laerche verliert sie im Winter.");
  	 
  AddDetail( ({"winter"}),
  	 "Im Winter ist es kalt.");
  	 
  AddDetail( ({"maler", "arbeit"}),
  	 "Der Maler hat hier wirklich gute Arbeit geleistet!");
  	 
  AddDetail( ({"mischwald", "mischwaelder"}),
  	 "Nur auf einem Bild ist ein Mischwald zu sehen. Er sieht bedrohlich und finster aus. "
  	 "Auf der rechten Seite bekommt das Bild mehr gelbe Farbe.");
  	 
  AddDetail( ({"seite", "farbe", "meinung"}),
  	 "Das soll Deiner Meinung nach eine Wueste oder Steppe darstellen.");
  	 
  AddDetail( ({"wueste", "steppe"}),
  	 "Dort ist es sehr heiss, daher vertrocknen die meisten Pflanzen und werden gelb.");
  	 
  AddDetail( ({"pflanzen"}),
  	 "Sie vertrocknen oft in heissen Gegenden, wo es wenig regnet.");
  	 
  AddDetail( ({"gegend", "gegenden", "beispiel"}),
  	 "Steppe oder Wueste zum Beispiel.");
  	 
  AddDetail( ({"laubwald", "laubwaelder"}),
  	 "Auf einem Bild ist links oberhalb des Laubwaldes eine Stadtmauer zu sehen.");
  	 
  AddDetail( ({"stadtmauer", "stadtmauern"}),
  	 "Dahinter liegt wahrscheinlich eine Stadt.");
  	 
  AddDetail( ({"stadt"}),
  	 "Sie ist hinter den Stadtmauern verborgen.\n"
  	 "Mitten im Laubwald ist ein grauer Fleck.");
  	 
  AddDetail( ({"fleck"}),
  	 "Du gehst ein paar Schritte an das Bild heran, um es genauer zu betrachten. Bei "
  	 "dem grauen Fleck duerfte es sich um einen Eingang zu einem Haus handeln.");
  	 
  AddDetail( ({"eingang"}),
  	 "Er wird von dem grauen Fleck, wahrscheinlich Treppen, und etwas "
  	 "Braunem gebildet.");
  	 
  AddDetail( ({"treppen", "treppe"}),
  	 "Es koennte sich um Treppen handeln.");
  	 
  AddDetail( ({"braunem", "braun", "braunes", "etwas braunes"}),
  	 "Moeglicherweise ein Eingangstor.");
  	 
  AddDetail( ({"eingangstor"}),
  	 "Es fuehrt in das Haus.");
  	 
  AddDetail( ({"haus"}),
  	 "Hmm eigentlich siehst Du kein Haus auf dem Bild. Seltsam.");


 // seitenspezifisch ende
  	 
  AddDetail( ({"abendrot"}),
  	 "Dir wird ganz warm ums Herz!");
  	 
  AddDetail( ({"herz"}),
  	 "Haaach. Du grinst gluecklich :)");
  	 
  AddDetail( ({"boden"}),
  	 "Der Boden hier in der Kirche besteht nur aus grauen, polierten "
  	 "Steinbloecken.");
  	 
  AddDetail( ({"steinbloecke", "steinblock", "bloecke", "block", "stein"}),
  	 "Einfache, polierte, graue Steinbloecke. Langweilig.");
  	 
  AddDetail( ({"birne", "staengel", "blatt"}),
  	 "Das Fresko an der Decke besteht aus einer Birne, einem Staengel "
  	 "und einem Blatt.");
  	 
  AddSmell(DEFAULT_SMELL,
   	 "Es riecht hier langweilig.");
   	 
  AddSound(DEFAULT_SOUND,
  	 "Du hoerst einen Gesang.");
  	 
  AddSound("gesang",
  	 "Er kommt von oben!");
  	 
  AddExit("westen",  ROOM "kiachn");
  AddExit("oben",  ROOM "oobtreppe");
  	 
}

int _query_total_light() {return 1;}
