// Gesellenstück
// Raum 5 für Weg - w05.c (letzer Weg-Raum)
// Von Wraz / Mendralim
// 55 Details, 3 Sounds, 3 Smells, 2 Funktionen

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Vor einem Kloster im Wald");
  SetProp(P_INT_LONG, 
  	 "Vor Dir erhebt sich ein riesiger Eingang, der direkt in die Erde hineingebaut "
  	 "ist. Du befindest Dich hier in einer leichten Senke, sodass es im Sueden "
  	 "ein kleines Stueck relativ steil und von Norden bis Osten her leicht bergauf "
  	 "geht. Ansonsten hat sich die Umgebung kaum geaendert.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 31, ENV_TERRAIN: TT_FOREST]));
  
  AddDetail(({"eingang"}),
  	 "Der Eingang besteht aus fuenf Stufen, welche zu einem massiven Holztor mit "
  	 "zwei grossen, metallenen Ringen fuehren. Davor bauen sich zu jeder Seite "
  	 "zwei - also insgesamt vier - maechtige Saeulen auf, welche eine Decke und "
  	 "den darueberliegenden Wald tragen.\n"
  	 "Was sich hinter dem Eingang wohl befinden mag?");
  	 
  AddDetail(({"seite"}),
  	"An beiden Seiten des Einganges tuermen sich dicke Saeulen auf.");
  	 
  //AddDetail(({"ringe","ring"}), // ok, hast gewonnen Woody .)
  //	"Meinst Du die metallenen Ringe?");
  	 
  AddDetail(({"stufen"}),
  	 "Die Stufen wurden relativ grob aus Sandstein gemeisselt. An einer Stufe ist "
  	 "ein grosser Brocken herausgebrochen.");
  	 
  AddDetail(({"stufe", "brocken"}),
  	 "An einer Stufe fehlt ein Brocken. Sandstein ist nunmal nicht sehr fest. Auch "
  	 "der Boden vor dem Tor besteht daraus.");
  	 
  AddDetail(({"sandstein"}),
  	 "Die fuenf Stufen wurden aus dem relativ sproeden Material Sandstein gefertigt.");
  	 
  AddDetail(({"material"}),
  	 "Hier ist es Sandstein.");
  	 
  AddDetail(({"holztor", "tor"}),
  	 "Das halbrunde Holztor hat zwei grosse Fluegel mit jeweils einem Metallring versehen.");
  	 
  AddDetail(({"fluegel", "torfluegel"}), 
  	 "Die Torfluegel bestehen aus massivem Holz. Sie wurden lackiert, vermutlich um der "
  	 "Witterung besser stand zu halten.");
  	 
  AddDetail(({"holz"}),
  	 "Du tippst auf Buche, ein sehr hartes Holz.");
  	 
  AddDetail(({"buche"}),
  	 "Die Torfluegel bestehen daraus. Aber auch noch lebende Baeume dieser Art befinden "
  	 "sich hier im Wald.");
  	 
  AddDetail(({"metallring", "metallringe", "metallener ring", 
  	 "metallene ringe", "ringe", "ring"}),
  	 "Bei genauerer Betrachtung stellst Du fest, dass diese aus Eisen "
  	 "bestehen.");
  	 
  AddDetail(({"betrachtung"}),
  	 "Die kannst Du nicht sehen.");
  	 
  AddDetail(({"eisen","eisenringe","eisenring"}),
  	 "Ja, eindeutig Eisen. Es rostet schon leicht. Aber viel "
  	 "interessanter ist doch, wozu diese Metallringe wohl dienen moegen? "
  	 "Erst jetzt faellt Dir auf, dass "
  	 "sie oben durch ein bewegliches Gelenk befestigt sind.");
  	 
  AddDetail(({"rost"}),
  	 "Du rubbelst mit einem Finger auf dem Rost herum und machst ihn Dir dabei schmutzig. "
  	 "Ploetzlich faellt Dir ein Symbol auf dem Boden vor dem Tor auf.");
  	 
  AddDetail(({"symbol"}),
  	 "Hmm. Du hast absolut keine Ahnung, was es darstellen soll.");
  	 
  AddDetail(({"ahnung"}),
  	 "Hast Du keine.");
  	 
  AddDetail(({"gelenk"}),
  	 "Jeder Metallring ist oben mit einem Gelenk so befestigt, dass man "
  	 "ihn zumindest "
  	 "theoretisch unten nehmen koennen muesste und dann irgendetwas tun....");
  	 
  AddDetail(({"irgendetwas"}),
  	 "Man koennte mit dem Metallring klopfen!");
  	 
  AddDetail(({"boden vor dem tor", "sandsteinboden"}),
  	 "Er besteht aus Sandstein.");
  	 
  AddDetail(({"saeulen"}),
  	 "Die runden Saeulen bestehen aus gelblichem Marmor. Sie tragen "
  	 "eine Decke, auf welcher "
  	 "der Wald unbeirrt dahin vegetiert. Wirklich seltsam.");
  	 
  AddDetail(({"marmor"}),
  	 "Der gelbliche Marmor, aus dem die massiven Saeulen bestehen, ist "
  	 "das edelste "
  	 "Baumaterial, welches Du hier entdecken kannst.");
  	 
  AddDetail(({"baumaterial"}),
  	 "Im Fall der Saeulen ist es Marmor.");
  	 
  AddDetail(({"fall"}),
  	 "Der ist woertlich 'un-begreif-lich'.");
  	 
  AddDetail(({"saeule"}),
  	 "Davon siehst Du vier.");
  	 
  AddDetail(({"decke"}),
  	 "Woraus sie besteht, kannst Du nicht erkennen. Seltsam ist nur, "
  	 "dass sich darauf "
  	 "Wald befindet, und kein Dach.");
  	 
  AddDetail(({"dach"}),
  	 "Der Wald bildet das Dach.");
  	 
  AddDetail(({"erde"}),
  	 "Sie ist ziemlich trocken und sandig und hat daher eine hellgelbe Farbe. Typisch "
  	 "fuer die Steppe.");
  	 
  AddDetail(({"farbe"}),
  	 "Die der Erde ist hellgelb.");
  	 
  AddDetail(({"steppe"}),
  	 "Heiss, recht trocken. Eindeutig Steppe. Nur der gruene Wald verwundert hier ein "
  	 "wenig.");
  	 
  AddDetail(({"senke"}),
  	 "Nur die Senke machte den Bau des Eingangs in dieser Form moeglich.");
  	 
  AddDetail(({"bau"}),
  	 "Das alles hier musste ja schliesslich einmal aufgebaut werden!");
  	 
  AddDetail(({"form"}),
  	 "Nach Sueden geht es einige Zwergenlaengen steil bergauf, gerade so weit, dass der Eingang "
  	 "hineinpasst. Dahinter ist es wieder flach.");
  	 
  AddDetail(({"zwergenlaenge", "zwergenlaengen"}),
  	 "Etwas mehr als ein Meter.");
  	 
  AddDetail(({"meter"}),
  	 "Etwas weniger als ein Zwerg gross ist.");
  	 
  AddDetail(({"zwerg"}),
  	 "Durchschnittlich etwas groesser als ein Meter.");
  	 
  AddDetail(({"stueck"}),
  	 "Einige Zwerge lang.");
  	 
  AddDetail(({"steilstueck"}),
  	 "Es ist einige Zwerge hoch.");
  	 
  AddDetail(({"umgebung"}),
  	 "Die Temperatur ist in etwa gleich geblieben, die Luft ist "
  	 "immer noch recht "
  	 "trocken und auch der Wald hat sich nicht wirklich veraendert.");
  	 
  AddDetail(({"temperatur"}),
  	 "Es ist hier ziemlich heiss. Steppe eben.");
  	 
  AddDetail(({"luft"}),
  	 "Trocken.");
  	 
  AddDetail(({"wald"}),
  	 "Im Wald gibt es kaum eine Veraenderung im Vergleich zum Nordosten. "
  	 "Du erkennst "
  	 "keine neuen Baeume. Auch Straeucher, Buesche und Graeser findest "
  	 "Du hier.");
  	 
  AddDetail(({"veraenderung"}),
  	 "Kaum eine.");
  	 
  AddDetail(({"vergleich"}),
  	 "Nicht zu sehen.");
  	 
  AddDetail(({"nordosten"}),  // --- hirte zurueck CMD ---
  	 "Wenn Du dorthin wieder zurueck willst, solltest Du vielleicht "
  	 "einfach zurueckhirten.");
  	 
  AddDetail(({"baeume"}),
  	 "Die gleichen wie im Nordosten. Wenn Du unbedingt willst, kannst "
  	 "Du sie Dir ja "
  	 "genauer ansehen, aber vermutlich wird Dich das nicht "
  	 "weiterbringen.");
  	 
  AddDetail(({"straeucher","buesche"}),
  	 "Auf dem steilen Stueck im Sueden befinden sich einige vertrocknete Straeucher "
  	 "und Buesche.");
  	 
  AddDetail(({"himmel"}),
  	"Durch die dichten Baeume hier kannst Du den Himmel kaum erkennen. Daher ist es "
  	"hier auch so duester.");
  	 
  AddDetail(({"witterung","beispiel"}),
  	 "Die besteht aus allen moeglichen Wettereinfluessen. Zum Beispiel Regen, Wind, "
  	 "Kaelte, ...");
  	 
  AddDetail(({"regen", "wind", "kaelte", "wettereinfluss", "wettereinfluesse"}),
  	 "Witterung.");
  	 
  AddDetail(({"arten", "art", "laubbaumarten"}),
  	 "Du siehst Dich um und entdeckst folgende Laubbaumarten:\n"
  	 "Kastanien, Birken, Pappeln, Ahorne, Linden, Weiden, Kirschen ....");
  	 
  AddDetail(({"kastanien", "kastanie", "birken", "birke", "pappeln",
  	      "pappel", "ahorne", "ahorn", "linden", "linde", "weiden", "weide", 
  	      "kirsche", "kirschen"}),
  	 "Eine der vielen Arten welche sich hier im Wald befinden.");
  	 
  AddDetail(({"sueden"}),
  	 "Dort siehst Du ein kurzes Steilstueck, in welches ein Eingang "
  	 "gebaut wurde.");
  	 
  AddDetail(({"westen", "suedwesten", "suedosten", "osten", "norden", "nordwesten"}),
  	 "Eine Himmelsrichtung. Unglaublich, dass Wraz wirklich so "
  	 "unwichtige Details "
  	 "einbaut ;)");
  	 
  AddDetail(({"himmelsrichtung", "details"}),
  	 "Wir wollen es aber nicht uebertreiben.");
  	 
  AddDetail(({"wraz"}),
  	 "Fleissig weiterforschen!");
  	 
  AddDetail("graeser",
  	 "Sie wachsen hier auf dem Boden in kleinen Buescheln.");
  	 
  AddDetail(({"boden"}),
  	"Auf dem Boden wachsen Graeser in kleinen Buescheln.");
  	 
  AddDetail(({"buescheln", "bueschel"}),
  	 "Kleine, gelb-gruene Buescheln.");
  	 
  	 
  AddSound(DEFAULT_SOUND,
  	 "Du glaubst, Geraeusche hinter dem Tor zu hoeren.");
  	 
  AddSound("geraeusche",
  	 "Jetzt bist Du Dir nicht mehr sicher. Vielleicht solltest Du "
  	 "versuchen, irgendwie "
  	 "hinter das Tor zu kommen.");
  	 
  AddSound(({"tor", "leute"}),
  	 "Nein! An fremder Leute Tore lauscht man doch nicht!");
  	 
  AddSmell(DEFAULT_SMELL,
  	 "Hier riecht es nach Wald.");
  	 
  AddSmell("wald",
  	 "Nichts Besonderes, einfach nur Wald.");
  	 
  AddSmell("besonderes",
  	 "NICHTS!!!");
  	 
  	 
  AddCmd(({"hirte", "hirt"}), "hirten");
  AddCmd(({"klopfe", "klopf"}), "klopfen");
}

int hirten(string str) // EXIT --- hirten
{
  if(!str||str=="") return 0;
  
  if(str=="zurueck")
  {
    write( BS("Da Du nun Uebung im Hirten hast, kommst Du flink an Dein Ziel. "
    	      "Du kommst "
    	      "sogar wieder an dem schoenen Busch vorbei.") );
    	      
    TP->move(ROOM "w04", M_GO, "zurueck", "hirtet", "hirtet gekonnt herein");
    return 1;
  }
}

int klopfen(string str)  // EXIT --- klopfen --- ins Kloster
{
  notify_fail("Womit willst Du klopfen bzw was fuer ein Ring ist das?\n");
  if(!str||str=="") return 0;
  
  if(str=="mit metallring" || str=="metallring" ||str=="mit eisenring"||
     str=="eisenring" || str=="mit ring")
  {
  call_other(ROOM "bedroom", "???");
  
    if(!find_living("\nnuns_by_wraz"))
    {
    	TP->Message(BS("Du klopfst einige Male mit dem Metallring gegen das "
    		"massive Buchenholztor. Da nach einiger Zeit niemand oeffnet, "
    		"beschliesst Du, einfach selbst das Tor zu oeffnen."));
    	TP->move(ROOM "eraum", M_GO, "den Eingang", "schreitet durch", 
         "kommt herein und staunt");
    return 1;
    }
    
    else
    {		
    write( BS("Du klopfst mit dem Metallring einige Male gegen das massive "
    	      "Buchenholztor. Schon nach kurzer Zeit oeffnet eine Nonne das Tor und bittet "
    	      "Dich hoeflich herein.") );
    
    call_other(ROOM "eraum", "???");   
    if(ENV(find_living("\nnuns_by_wraz"))!=find_object(ROOM "eraum"))
     find_living("\nnuns_by_wraz")->move(ROOM "eraum", M_TPORT, "davon",
     "saust eilig", "fuehrt "+TPN+" herein");
    TP->move(ROOM "eraum", M_GO, "den Eingang", "schreitet durch", 
     "wird von einer Nonne hereingefuehrt und staunt");
    return 1;
    }
  }
  
  if(str=="mit ring" || str=="ring" || str=="mit ringe" || str=="ringe")
  {
    write( BS("Ein bisschen genauer bitte!") );
    return -1;
  }
}