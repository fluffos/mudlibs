// Gesellenstück
// Raum 3 für Weg - w03.c
// von Wraz / Mendralim
// 15 Details, 2 Sounds, 2 Smells, 1 Funktion

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Ein Weg in der Steppe");
  SetProp(P_INT_LONG,
  	 "Wenn nicht bereits hier, dann spaetestens sobald Du weiter nach "
  	 "Suedwesten gehst, kannst Du den Ort als Wald bezeichnen. Noch stehen "
  	 "die Baeume in so grossen Abstaenden, dass viel Sonnenlicht auf "
  	 "den Boden trifft, aber das koennte sich sehr bald aendern.");
  	 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_PLAIN]));
  
  AddDetail(({"straeucher","strauch","buesche","busch"}),
  	 "Einige Buesche und Straeucher wachsen hier zwischen den Baeumen.");
  
  AddDetail(({"abstaende", "abstand"}),
  	"Die Abstaende zwischen den Baeumen sind noch recht gross.");
  	
  AddDetail("himmel",
  	"Der Himmel ist hier leicht getruebt.");
  	
  AddDetail("ort",
  	"Wald.");
  	
  AddDetail("sonnenlicht",
  	"Da hier noch wenig Baeume stehen, trifft viel Sonnenlicht auf die Erde auf.");
  	
  AddDetail("sonne",
  	"Sie strahlt vom Himmel.");
  	
  AddDetail(({"wolken","wolke"}),
  	"Ist hier nicht zu sehen, der Himmel ist lediglich etwas getruebt, "
  	"aber von Wolken kann man hier noch nicht sprechen.");
  	
  AddDetail("erde",
  	"Das Gras, welches aus der Erde waechst, ist hier gar nicht mehr vertrocknet!");
  
  AddDetail(({"suedwesten"}),
  	 "Du wirfst einen kurzen Blick den Pfad entlang und erkennst, "
  	 "dass sich im Suedwesten ein dichter, duesterer Wald befindet. Dir "
  	 "wird beim Gedanken dorthin zu gehen ein wenig mulmig...");
  	 
  AddDetail(({"blick"}),
  	"Einen kurzen.");
  	 
  AddDetail(({"pfad"}),
  	 "Hier kann man noch erkennen, dass der Pfad von Nordosten nach Suedwesten "
  	 "fuehrt, wo er allerdings nicht mehr so gut zu erkennen ist und sich "
  	 "moeglicherweise in dem dort befindlichen Wald verlieren wird. Vielleicht "
  	 "musst Du Dir bald Deinen Weg selbst bahnen.");
  	 
  AddDetail(({"wald"}),
  	 "Der duestere Wald im Suedwesten ist deutlich zu erkennen.");
  	 
  AddDetail(({"gedanke", "gedanken"}),
  	 "Ob es wirklich eine so gute Idee ist weiter zu gehen? Aber wer weiss, was "
  	 "sich alles in dem Wald befindet...");
  	 
  AddDetail(({"idee", "gehirn"}),
   	 "Dein Gehirn fuehlt sich ploetzlich so weich an.");
   	 
  AddDetail(({"nordosten"}),
  	 "In diese Richtung fuehrt der Pfad.");
  	 
  AddDetail(({"richtung"}),
  	 "Der Pfad fuehrt von Nordosten nach Suedwesten.");
  	 
  AddDetail(({"weg"}),
  	 "Ob Du Dir Deinen Weg bald selbst bahnen musst oder nicht, wirst Du erst dann "
  	 "feststellen, wenn Du es tatsaechlich wagst weiter zu gehen.");
  	 
  AddDetail(({"boden"}),
  	 "Erst jetzt faellt Dir auf, dass das Gras hier gar nicht mehr vertrocknet "
  	 "ist, sondern recht saftig aussieht.");
  	 
  AddDetail(({"gras"}),
  	 "Es sieht ziemlich gut bewaessert aus.");
  	 
  AddDetail(({"blatt", "blaetter", "rinde", "stamm", "zweige", "zweig"}),
  	 "Ein Teil eines Baumes.");
  	 
  AddDetail(({"aeste", "ast"}),
  	 "An dem Ast einer Buche waechst ein grosser Baumpilz.");
  	 
  AddDetail(({"baumpilz"}),
  	 "Ein matt-hellbrauner Baumpilz waechst auf einem Ast. Er sieht "
  	 "so richtig zum Reinbeissen aus!");
  	 
  AddDetail(({"pilz"}),
  	"So einfach sicher nicht. Welcher Pilz denn?");
  	 
  AddDetail(({"baeume", "arten", "art"}),
  	 "Hier befinden sich Kastanien, Buchen, Pappeln, Ahorne, Linden "
  	 "und viele andere Arten.");
  	 
  AddDetail(({"pappel", "pappeln", "buche", "buchen", "ahorn", "ahorne", 
  "kastanien", "kastanie", "linden", "linde"}),
  	 "Das waechst hier.");
  	 
  	 
  AddSound(DEFAULT_SOUND,
  	 "Oh! Von irgendwoher hoerst Du ein Scharren.");
  	 
  AddSound("scharren",
  	 "Du lauschst dem Scharren einige Sekunden, doch dann hoert es auf.");
  	 
  AddSmell(DEFAULT_SMELL,
  	 "Es riecht hier nach frischem Gras.");
  	 
  AddSmell("gras",
  	 "Es riecht wirklich gut. Du koenntest es Dir aber auch ansehen!");
  	 
  
  AddExit("nordosten", ROOM "w02");
  AddExit("suedwesten", ROOM "w04");
  
  AddCmd(({"beisse","beiss","iss"}), "beissen");
  
  AddItem(NPC "waran", REFRESH_DESTRUCT);
}

int beissen(string str)
{
  notify_fail("Wo willst Du reinbeissen?\n");
  if(!str||str=="") return 0;
  
  if(str=="in baumpilz"||str=="baumpilz"||str=="in baumpilz rein"||
     str=="in baumpilz hinein"||str=="von baumpilz ab")
  {
    TP->Message(BS("Du schwingst Dich elegant auf den Ast, setzt einen "
      "total geisteskranken Grinser auf und beisst leidenschaftlich in den "
      "Baumpilz hinein. IEH! Ploetzlich besinnst Du Dich wieder, der Baumpilz "
      "schmeckt ja ekelhaft, PFUI! Dumm wie Du halt bist, schluckst Du "
      "trotzdem... das Stueck Baumpilz, du Ferkel!"));
    TP->SetProp(P_POISON, TP->QueryProp(P_POISON)+random(4));
    return 1;
  }
return 0;
}