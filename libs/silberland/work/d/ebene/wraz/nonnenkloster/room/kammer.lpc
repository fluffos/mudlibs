// Gesellenst�ck
// Abstellkammer im Kloster - kammer.c
// Von Wraz / Mendralim
// -> 27 Details, 0 Smells, 0 Sounds, 0 Funktionen

// note: Hier ist es IMMER hell
//	 NewDoor() nach kiachn

#pragma strong_types

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();  // Kutte nehmen, Kiste aufbrechen
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG, 
  	 "Du stehst hier in einer kleinen Abstellkammer hinter dem Altar. Es ist hier "
  	 "sehr hell, und so kannst du die vielen Kutten die an den Waenden haengen "
  	 "gut erkennen.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail( ({"abstellkammer", "kammer", "raum"}),
  	 "In der befindest Du Dich gerade. Als Du Dich umblickst, siehst Du einige gruene, "
  	 "weisse und rote Kutten an den Waenden haengen und ausserdem im hinteren Bereich des "
  	 "relativ kleinen Raumes einige Kisten stehen.");
  	 
  AddDetail( ({"kutten", "kutte"}),
    	 "Die Kutten haben lange Aermel, eine Kapuze und gehen etwa bis knapp unter die Knie.");
    	 
  AddDetail( ({"aermel"}),
  	 "Die Kutten haben lange Aermel.");
  	 
  AddDetail( ({"kapuze", "kapuzen"}),
   	 "Jede Kutte hat eine Kapuze.");
   	 
  AddDetail( ({"knie"}),
  	 "Getragen gehen die Kutten bis knapp unter die Knie... eines Menschen.");
  	 
  AddDetail( ({"mensch", "menschen", "rasse", "rassen"}),
  	 "Anderen Rassen reicht die Kutte sicher weiter beziehungsweise weniger weit nach "
  	 "unten.");
  	 
  AddDetail( ({"rote kutte", "rote kutten","weisse kutten", "weisse kutte"}),
  	 "Diese Kutten haben wie alle anderen auch ein Birnensymbol eingenaeht.");
  	 
  AddDetail( ({"gruene kutten", "gruene kutte"}),
  	 "Auf den gruenen Kutten siehst Du Illustrationen.");
  	 
  AddDetail(({"andersfaerbige kutte","andersfaerbige kuggen"}),
  	"Sie haben alle ein Birnensymbol eingenaeht.");
  	 
  AddDetail( ({"illustrationen", "illustration","laubbaum"}),
  	 "Ein einfach dargestellter Laubbaum. Jede gruene Kutte hat einen solchen auf "
  	 "die Rueckseite aufgemalt.");
  	 
  AddDetail( ({"rueckseite", "rueckseiten"}),
  	 "Nur die gruenen Kutten haben auf ihrer Rueckseite einen Laubbaum aufgemalt.");
  	 
  AddDetail( ({"wand", "waende"}),
  	 "Durch die Holztuer in der Nordwand bist Du hereingekommen. Alle andere "
  	 "Waende sind vollgehangen mit roten, gruenen, weissen und andersfaerbigen "
  	 "Kutten.");
  	 
  AddDetail( ({"nordwand"}),
  	 "Durch die Holztuer in dieser Wand bist Du hereingekommen.");
  	 
  AddDetail( ({"symbol", "birnensymbol"}),
  	 "Es stellt eine Birne mit Staengel und einem Blatt daran dar.");
  	 
  AddDetail( ({"birne", "staengel", "blatt"}),
  	 "Ein Teil des Birnensymbols.");
  	 
  AddDetail( ({"teil"}),
  	 "Das Birnensymbol besteht aus mehreren.");
  	 
  AddDetail( ({"holz", "eichenholz"}),
  	 "Vermutlich Eichenholz.");
  	 
  AddDetail( ({"bereich"}),
  	 "Weiter hinten stehen einige Kisten.");
  	 
  AddDetail( ({"kisten", "holzkisten"}),
  	 "Fest verschlossene Holzkisten. Auf jeder ist das Birnensymbol "
  	 "aufgemalt.");
  	 
  AddDetail( ({"boden"}),
  	 "Der Boden besteht aus glatt polierten Marmorbloecken.");
  	 
  AddDetail( ({"marmor"}),
  	 "Daraus wurde der Boden gefertigt.");
  	 
  AddDetail( ({"marmorbloecke", "marmorblock", "bloecke", "block"}),
  	 "Hellgelbe Marmorbloecke.");
  	 
  AddDetail( ({"decke"}),
  	 "Die Decke ist weiss und hat eine Bogenform.");
  	 
  AddDetail( ({"bogenform", "bogen"}),
  	 "Huch! Jetzt erst bemerkst Du das Symbol an der Decke, welches eine Birne darstellt. "
  	 "Von ihm geht auf seltsame Art ein Leuchten aus.");
  	 
  AddDetail( ({"art", "leuchten"}),
  	 "Anscheinend leuchtet das Symbol an der Decke und erhellt so den Raum.");
  	 
  AddDetail( ({"altar"}),
  	 "Der Altar ist in der Kirche im Norden.");
  	 
  AddDetail( ({"kirche"}),
  	 "Die Kirche ist im Norden.");
  	 
  AddDetail( ({"norden"}),
  	 "Dort befindet sich der Altar.");
  	 
  AddSmell( DEFAULT_SMELL, 
  	 "Es riecht hier ein wenig... muffig."); // was immer sie wuenschen, woody ;)
  	 
  NewDoor( ({"norden"}), ROOM "kiachn", ({"holztuer","tuer"}),
  	({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL,
  	  D_NAME,"Holztuer",
  	  D_GENDER,FEMALE,
  	  D_SHORT,"Eine %se Holztuer.",
  	  D_LONG,"Eine starke Holztuer aus dunklem Holz. In sie wurde ein "
  	         "Symbol eingraviert.\n",
  	  D_RESET_CLOSEMSG, " wird von einer Nonne geschlossen."}));  
  	  
  AddCmd(({"brich", "breche", "oeffne"}), "cmd_brechen");
}

int _query_total_light() {return 1;}

int cmd_brechen(string str)
{
  if(!str||str=="") return 0;
  
  if(str=="kiste auf"||str=="kiste"||str=="kisten auf"||str=="kisten")
  {
    TP->Message(BS("Keine Chance. Die Kisten bekommst Du nie auf."));
    return 1;
  }
  
  else return 0;
}