// Gesellenstück
// Orgelraum im 2. Stock - orgelraum.c
// Von Wraz / Mendralim
// -> 38 Details, 1 Sound, 2 Smells, 1 Funktion
// immer hell

inherit "std/room";

#include "../def.h"

int tonstuecke;

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG,
  	"Eine feine, wuerzige Brise von herbem Holzgeruch steigt Dir hier in die Nase. "
  	"Das scheint wohl von der alten Orgel hier zu kommen, welche sich im Sueden "
  	"befindet. Im Norden hingegen ist ein Gelaender, welches Dich vor einem "
  	"moeglichen, unbeabsichtigten Sturz in die darunter befindliche Kirche bewahrt. "
  	"Die Gaenge in Richtung Nordosten, Nordwesten und Osten sind wie der Raum hier "
  	"mit Pflanzen geschmueckt.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24+random(3), ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail( ({"sturz"}),
  	"Vor einem solchen soll Dich das Gelaender schuetzen.");
  	
  AddDetail( ({"sueden"}),
  	 "Im Sueden steht die alte Orgel.");
  	
  AddDetail( ({"gaenge", "gang"}),
  	"Es fuehren drei Gaenge von hier weg: Nordosten, Osten und Nordwesten.");
  	
  AddDetail( ({"nordosten", "nordwesten"}),
  	"Ein Gang fuehrt in diese Richtung. Dort siehst Du ein Treppenhaus.");
  	
  AddDetail( ({"treppenhaus", "treppenhaeuser"}),
  	"Die Treppenhaeuser im Nordosten und Nordwesten sind sich sehr aehnlich.");
  	
  AddDetail( ({"richtung"}),
  	"Du kannst diesen Raum in drei Richtungen verlassen.");
  
  AddDetail( ({"richtungen", "norden", "osten", "nordwesten"}),
  	"Nordosten, Osten und Nordwesten. Es sind noch immer nur diese drei und es werden auch "
  	"nicht mehr werden, egal wie viel Du noch forscht :)");
  	
  AddDetail( ({"raum"}),
  	"Er dient vermutlich lediglich als Aufbewahrungsort fuer die Orgel.");
  	
  AddDetail( ({"aufbewahrungsort"}),
  	"Hier wird eine Orgel aufbewahrt.");
  	
  AddDetail( ({"orgel"}),
  	"Oh! Die Orgel ist momentan nicht da!");
  	
  AddDetail( ({"pflanzen"}),
  	"An der Suedwand stehen mehrere Tontoepfe mit Bueschen, aber auch vor dem Gelaender "
  	"befinden sich Gruenpflanzen. Ebenso stehen Pflanzen in den Gaengen im Nordosten, "
        "Nordwesten und im Osten.");
  	
  AddDetail( ({"suedwand"}),
  	"Sie wurde aus rotem Marmor gefertigt. Vor ihr stehen einige Buesche in Tontoepfen.");
  	
  AddDetail( ({"marmor"}),
  	"Die Waende bestehen hier aus rotem Marmor.");
  	
  AddDetail( ({"waende", "wand"}),
  	"Die Waende bestehen aus rotem Marmor. An der Suedwand stehen Tontoepfe.");
  	
  AddDetail( ({"tontoepfe", "toepfe"}),
  	"Ein Topf sieht bruechig aus.");
  	
  AddDetail( ({"tontopf", "topf"}),
  	"Ein Stueck Ton ist an einer Ecke herausgebrochen.");
  
  AddDetail( ({"stueck", "ecke"}),  // CMD: BRICH TON AUS TOPF/ECKE
  	 "Das Stueck Ton haengt noch lose in der Ecke.");
  	 
  AddDetail( ({"ton"}),
  	"Die Toepfe bestehen aus gebranntem Ton.");
  	
  AddDetail( ({"buesche", "busch"}),	
  	"Die strahlend gruenen Buesche wachsen prachtvoll aus den Tontoepfen. Die Nonnen hier "
  	"scheinen ein gruenes Haendchen zu haben.");
  	
  AddDetail( ({"nonnen", "nonne"}),	
  	"Momentan ist keine da.");
  	
  AddDetail( ({"haendchen", "hand", "beziehung", "natur"}),
  	"Vielleicht haben sie aber auch eine ganz besondere Beziehung zur Natur...");
  
  AddDetail( ({"brise", "geruch", "holzgeruch", "augen"}), // aus wob bzw oobtreppe
  	 "Das kannst Du nicht sehen.");
  	 
  AddDetail( ({"nase"}),
  	 "Du schielst ein bisschen und siehst Dir Deine Nase an. Toll. Jetzt "
  	 "tun Dir die Augen weh.");
  	 
  AddDetail( ({"boden"}),
  	 "Er wurde aus polierten Granitbloecken zusammengesetzt.");
  	 
  AddDetail( ({"granitbloecke", "bloecke", "granit"}),
  	 "Zusammengesetzt bilden sie den Boden.");
  	 
  AddDetail( ({"granitblock", "block"}),
  	 "Du siehst Dir ein paar Bloecke genauer an, findest aber nichts Besonderes."); // ende
  	 
  AddDetail( ({"decke"}),  // uebernommen (leicht geaendert) aus wobtreppe bzw oobtreppe:
  	 "Die vergoldete Decke befindet hoch oben. An ihr erkennst Du reichlich "
  	 "Verzierungen und Schnoerkeleien. Ausserdem wurde in sie ein grosses Fresko "
  	 "hineingearbeitet.");
  	 
  AddDetail("verzierungen",
  	 "Die Verzierungen schmuecken die Decke und machen sie huebsch.");
  	 
  AddDetail("schnoerkeleien",
  	 "Die Schnoerkeleien erstrecken sich ueber die gesamte Decke und geben ihr ein "
  	 "huebsches Aussehen.");
  	 
  AddDetail("aussehen",
  	 "Wirklich huebsch! Es gefaellt Dir.");
  	 
  AddDetail("fresko",
  	 "Es stellt eine Birne samt Staengel und einem Blatt dar. Es leuchtet ausserdem "
  	 "seltsam.");
  	 
  AddDetail("licht",
  	 "Es muesste hier eigentlich komplett dunkel sein, da nirgendwo "
  	 "Fenster in die Waende "
  	 "gebaut sind. Das Licht, das hier alles erhellt, geht eindeutig "
  	 "von dem Fresko an der Decke aus.");
  	 
  AddDetail( ({"fenster"}),
  	 "Du blickst Dich nocheinmal um, findest aber keine.");  // ende

  AddDetail( ({"gelaender"}), // aus wob bzw oobtreppe
  	 "Du blickst ueber das Gelaender hinunter und siehst die Kirche.");
  	 
  AddDetail( ({"kirche"}),
  	 "In der Mitte steht der Altar, begrenzt von den zwei Pflanzen. Zu ihm fuehrt "
  	 "der Teppich, welcher zwischen den Holzbaenken liegt.");
  	 
  AddDetail( ({"mitte"}),
  	 "Der Altar steht ziemlich in der Mitte der Kirche.");
  	 
  AddDetail( ({"altar", "pflanzen", "teppich", "holzbaenke", "baenke", "bank"}),
  	 "Das kannst Du Dir viel besser ansehen, wenn Du wieder nach "
  	 "unten gehst."); // ende
  	 
  AddDetail( ({"birne", "birnensymbol"}),
   	 "Die auf dem Symbol dargestellte Birne hat einen Staengel mit einem Blatt.");
   	 
  AddDetail( ({"staengel", "blatt"}),
  	 "Das gehoert zu dem Symbol mit der Birne.");
  	 
  AddDetail( ({"symbol"}),
  	 "Das Symbol zeigt eine Birne mit einem Staengel und einem Blatt daran.");
  	  
  	 
  AddSmell(DEFAULT_SMELL,
  	"Es riecht hier herb nach Holz.");
  	
  AddSmell(({"holz", "holzgeruch", "brise"}),
  	"Herb.");
  	
  AddSound(DEFAULT_SOUND,
  	"Stille. Oder?");
  	
  SUID;  
  
  AddItem(OBJ "orgel", REFRESH_REMOVE); // Update Juli 2020: REFRESH_REMOVE statt DESTRUCT (Wraz)
  
  AddSpecialExit("nordosten", "oobtreppe"); //ROOM "oobtreppe");
  AddSpecialExit("nordwesten", "wobtreppe"); //ROOM "wobtreppe");
  AddSpecialExit("osten", "sing"); //ROOM "sing");
  
  AddCmd( "brich|breche|zieh|ziehe|lockere|locker&ton|tonstueck|stueck&eck|ecke|topf|tontopf",
  "cmd_ton", "Was moechtest Du herausbrechen?|Von wo moechtest Du das herausbrechen?");
  // das kommando darf KEIN ({ }) enthalten!
  
  tonstuecke=1;
}

int _query_total_light() {return 1;}

int oobtreppe() // geht sicher auch kuerzer, nur mir faellt grad nicht ein wie :)
{
  if(TP->QueryProp("orgel_heben")==1)
  {
    TP->Message(BS("Du versuchst aber gerade die Orgel zu heben!"));
    return -1;
  }
  return TP->move(ROOM "oobtreppe",M_GO, "nach Nordosten");
}

int wobtreppe()
{
  if(TP->QueryProp("orgel_heben")==1)
  {
    TP->Message(BS("Du versuchst aber gerade die Orgel zu heben!"));
    return -1;
  }
  return TP->move(ROOM "wobtreppe",M_GO, "nach Nordwesten");
}

int sing()
{
  if(TP->QueryProp("orgel_heben")==1)
  {
    TP->Message(BS("Du versuchst aber gerade die Orgel zu heben!"));
    return -1;
  }
  return TP->move(ROOM "sing",M_GO, "nach Osten");
}

int cmd_ton(string bla)
{
  object ton;
  write_file( LOG "tonstueck.log", dtime() +" "+TPN+": "+bla+"\n");
  if(!tonstuecke) { 
    write(BS("Bei genauerer Betrachtung bemerkst Du, dass da doch kein "
             "Tonstueck mehr drinnen steckt.")); 
  return -1; }
  
  ton=clone_object(OBJ "tonstueck");
  
  if(ton->move(TP, M_GET)== ME_TOO_HEAVY)
  {
    ton->remove(1);
    write(BS("Das winzige Tonstueck ist Dir zu schwer. Schwaechling!"));
    return -1;
  }
  
  
  write(BS("Du fummelst mit ein bisschen Muehe das Stueck Ton aus der Ecke heraus."));
  say(TPN+" fummelt an einem der Tontoepfe herum.\n");
  tonstuecke=0;
  return 1;
}

reset()
{
  ::reset();
  tonstuecke=1;
}
