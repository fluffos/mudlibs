#pragma strong_types

inherit "std/room";

#include "../def.h"

int kelch;

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG, 
  	 "Hier stehst Du mitten in einer Kirche im Kloster. Rund um Dich herum stehen "
  	 "dunkelbraune Holzbaenke. Direkt vor Dir befindet sich ein Altar neben dem "
  	 "auf jeder Seite zwei Marmorbloecke stehen. Die Decke ist vergoldet und hat "
  	 "neben den vielen Schnoerkeleien ein beeindruckendes Fresko. Von ihm geht ein "
  	 "seltsames Licht aus.");
  	 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]));
  
  // "magisches" licht
  AddDetail("kirche",
  	 "So koennte man diesen Raum hier bezeichnen.");
  	
  AddDetail("raum",
   	 "Eine Kirche.");
   	 
  AddDetail("kloster",
   	"Darin befindest Du Dich.");
   	
  AddDetail( ({"holzbaenke", "baenke"}),
  	 "Holzbaenke wie sie in jeder Kirche zu finden sind, damit man waehrend der Messe "
  	 "nicht stehen muss.");
  	 
  AddDetail("messe",
   	"Die Nonnen hier halten regelmaessig eine Messe.");
   	
  AddDetail("nonnen",
   	"Die eilen hier herum.");
   	
  AddDetail("nonne",
   	"Momentan scheint keine hier zu sein.");
   	
  AddDetail("altar",
  	 "Auf dem Altar steht ein Kelch. An der Vorderseite des Altars erkennst Du wieder "
  	 "das Birnensymbol mit dem Blatt.");
  	 
  AddDetail("kelch",
  	 "Ein einfacher Kelch aus gebranntem Ton, in den eine Birne eingekratzt ist.\n"
  	 "Er ist leer.");
  	 
  AddDetail("vorderseite",
  	 "Auf der Vorderseite des Altars ist das Birnensymbol aufgemalt.");
  	 
  AddDetail( ({"birnensymbol", "symbol"}),
  	 "Eine einfache Birne, mit einem Staengel und einem Blatt daran. Das Symbol ist Dir "
  	 "bereits im Vorraum aufgefallen.");
  	 
  AddDetail( "vorraum",
  	 "Dieser befindet sich im Norden.");
  	 
  AddDetail( ({"marmorbloecke", "marmorblock", "marmor", "bloecke", "block"}),
  	 "Auf jedem der Marmorbloecke steht ein Topf aus dem eine beeindruckende Pflanze "
  	 "waechst.");
  	 
  AddDetail( ({"topf", "toepfe", "tontoepfe"}),
  	 "Einfache, gebrannte Tontoepfe mit Humuserde darin.");
  	 
  AddDetail( ({"ton"}),
  	 "Daraus werden meistens Toepfe fuer Pflanzen hergestellt. Aber auch "
  	 "der Kelch hier besteht daraus.");
  	 
  AddDetail( ({"erde", "humuserde"}),
  	 "Die Pflanzen brauchen die feuchte Erde, um wachsen zu koennen.");
  	 
  AddDetail( ({"pflanze", "pflanzen"}),
  	 "Die zwei prachtvollen Pflanzen links und rechts neben dem Altar sorgen fuer "
  	 "eine angenehme Atmosphaere.");
  	 
  AddDetail( ({"atmosphaere"}),
  	 "Durch die Pflanzen wird diese hier sehr angenehm und freundlich.");
  	 
  AddDetail( ({"seite", "seiten"}),
  	 "Auf jeder Seite neben dem Altar (links und rechts) steht ein Marmorblock.");
  	 
  AddDetail( ({"decke"}),
  	 "An der vergoldeten Decke erkennst Du reichlich Verzierungen und Schnoerkeleien. "
  	 "Ausserdem wurde ein grosses Fresko in die Decke gearbeitet. Sie befindet sich "
  	 "sehr hoch oben. Oh! Da faellt Dir ploetzlich etwas Besonderes auf!");
  	 
  AddDetail( ({"gold"}),
  	 "Die Decke hier wurde vergoldet! Wahnsinn!");
  	 
  AddDetail( ({"besonderes"}),
  	 "Du blickst die Suedwand hinauf und siehst auf halber Hoehe ein Gelaender! Dein Blick "
  	 "wendet sich nach Osten und Westen, wo Du das selbe erkennst. Anscheinend hat das "
  	 "Kloster einen zweiten Stock, von dem aus man hier herunter blicken kann. Was sich "
  	 "wohl dort noch alles befinden mag...");
  	 
  AddDetail( ({"osten","westen"}),
  	 "In diese Richtung kannst Du hier gehen.");
  	 
  AddDetail( ({"suedwand"}),
  	 "In die Suedwand ist eine kleine Holztuer hineingebaut.");
  	 
  AddDetail( ({"hoehe", "gelaender"}),
  	 "Auf halber Hoehe siehst Du ein Gelaender. Erster und zweiter Stock scheinen hier "
  	 "eine gemeinsame Decke zu haben.");
  	 
  AddDetail( ({"stock", "stockwerk", "stockwerke"}),
  	 "Anscheinend hat das Kloster mehrere Stockwerke.");
  	 
  AddDetail("verzierungen",
  	 "Die Verzierungen schmuecken die Decke und machen sie huebsch. Eine Verzierung hat "
  	 "eine herausstechende Kontur.");
  	 
  AddDetail("verzierung",
   	"Du meinst, dass ihre Kontur etwas darstellt.");
   	
  AddDetail("kontur",
  	 "Als Du die Kontur einer genaueren Betrachtung unterziehst, "
  	 "erkennst Du, dass sie "
  	 "einen Laubbaum symbolisiert.");
  	 
  AddDetail( ({"baum"}),
  	 "Ein Laubbaum.");
  	 
  AddDetail("betrachtung",
   	"Nach einer genaueren Betrachtung ist Dir aufgefallen, was die Kontur darstellen soll.");
  	 
  AddDetail( ({"laubbaum", "blick"}),
   	"Auf den ersten Blick hast Du den Laubbaum nicht erkannt.");
   	
  AddDetail( ({"schnoerkeleien", "schnoerkel"}),
  	 "Die Schnoerkeleien erstrecken sich ueber die gesamte Decke und geben ihr ein "
  	 "huebsches Aussehen.");
  	 
  AddDetail("aussehen",
  	 "Sehr huebsch!");
  	 
  AddDetail("fresko",
  	 "Es stellt eine Birne samt Staengel und einem Blatt dar und leuchtet seltsam.");
  	 
  AddDetail(({"licht","leuchten"}),
 	 "Erst jetzt faellt Dir auf, dass es hier eigentlich komplett dunkel sein muesste, da "
  	 "nirgendwo Fenster in die Waende eingebaut sind. Das Licht, welches den Raum anscheinend "
  	 "erhellt, geht von dem Fresko an der Decke aus.");
  	 
  AddDetail( ({"fenster"}),
  	 "Du blickst Dich nocheinmal um, findest aber keine.");
  	 
  AddDetail( ({"waende", "wand"}),
  	 "An der West- und Ostwand haengen Bilder.");
  	 
  AddDetail( ({"ostwand", "westwand"}),
  	 "Du siehst einige Bilder.");
  	 
  AddDetail( ({"bild", "bilder"}),
  	 "Die Bilder stellen Landschaften und Waelder dar.");
  	 
  AddDetail( ({"landschaften"}),
  	 "Sehr schoene Landschaften, mit Feldern, Fluessen und Baeumen. Manche der Bilder "
  	 "sind Abendrot gemalt und vermitteln ein romantisches Gefuehl.\n"
  	 "Ach wie schoen!");
  	 
  AddDetail( ({"gefuehl"}),
  	 "Wahrlich romantisch!");
  	 
  AddDetail( ({"felder", "fluesse", "baeume", "abendrot"}),
  	 "Das ist auf den Bildern gut zu erkennen.");
  	 
  AddDetail( ({"waelder", "wald"}),
  	 "Hauptsaechlich froehliche, aber auch duestere Waelder, wie der in welchem sich das "
  	 "Kloster hier befindet, sind auf den Bildern dargestellt.");
  	 
  AddDetail( ({"birne", "staengel", "blatt"}),
  	 "Ein Teil des Freskos an der Decke beziehungsweise des Symbols an dem Altar.");
  	 
  AddDetail( ({"teil", "teile"}),
  	 "Das Fresko bzw das Symbol bestehen aus verschiedenen Teilen.");
  	 
  AddDetail( ({"boden"}),
  	 "Der Weg zwischen den Holzbaenken, welcher von dem Vorraum im Norden zu dem Altar "
  	 "im Sueden der Kirche fuehrt, ist mit einem Teppich ausgelegt.");
  	 
  AddDetail( ({"weg"}),
   	"Durch die Anordnung der Holzbaenke entsteht ein Weg, der vom "
   	"Vorraum zum Altar fuehrt.");
   	
  AddDetail( ({"anordnung"}),
  	 "Die Baenke stehen links und rechts von dem Teppich.");
  	 
  AddDetail( ({"teppich"}),
  	 "Der Teppich besteht aus Bast. Sehr naturverbunden.");
  	 
  AddDetail( ({"bast"}),
   	 "Daraus wurde der Teppich gewoben.");
   	 
  AddDetail(({"holz"}),
   	"Die Tuer im Sueden sowie die Baenke wurden aus edelstem Holz gefertigt.");
   	
  
  AddSmell(DEFAULT_SMELL,
  	"Die Pflanzen riechen nach Pflanze.");
  	
  AddSmell( ({"pflanzen","pflanze", "geruch", "besonderes"}),
  	"Typisch nach Pflanze, ein ganz eindeutiger Geruch, nichts Besonderes, "
  	"einfach nur Pflanze.");
  	
  AddSound(DEFAULT_SOUND,
  	"Es ist hier ruhig.");
   	 
   	 
  AddExit("norden", ROOM "eraum");
  AddExit("westen", ROOM "wtreppe");
  AddExit("osten", ROOM "otreppe");
  
  NewDoor( ({"sueden"}), ROOM "kammer", ({"holztuer","tuer"}),
  	({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL,
  	  D_NAME,"Holztuer",
  	  D_GENDER,FEMALE,
  	  D_SHORT,"Eine %se Holztuer im Sueden.",
  	  D_LONG,"Eine starke Holztuer aus dunklem Holz. In sie wurde ein"
  	  " Symbol eingraviert.\n",
  	  D_RESET_CLOSEMSG, " wird von einer Nonne geschlossen."}));  
  	  
  AddCmd(({"trink","trinke"}), "cmd_trinken");
  AddCmd("rolle&teppich&weg", "cmd_rollen");
  
  kelch=0;
}

int _query_total_light() {return 1;}

int cmd_trinken(string str)
{
  int al;
  
  if(!str||str=="") return 0;
  
  notify_fail("Woraus moechtest Du trinken?\n");
  
  if(str=="aus kelch"||str=="kelch")
  {
    if(!kelch) {
     TP->Message(BS(
      "Du kommst Dir etwas seltsam vor, bei dem Gedanken, aus einem leeren "
      "Kelch zu trinken. Aber was solls! Du nimmst den Kelch, setzt an und "
      "nimmst einen kraeftigen Schluck! WOW! WAHNSINN! Du fuehlst Dich toll, "
      "wer haette das gedacht?"));
     say(TPN+ " trinkt aus einem Kelch und oeffnet erstaunt weit die Augen!\n");
     TP->AddHp(350);
     TP->AddSp(350);
     
     // Auf Woodys Anregung aus beichtstuhl in Midas kopiert:
     
     al = TP->QueryProp(P_ALIGN);
      if (al < 0) TP->SetProp(P_ALIGN, al*4/5);
      else if (al<200) TP->SetProp(P_ALIGN, al*5/4);
      else if (al<1000) TP->SetProp(P_ALIGN, al+50);
      
     // bis hier
     kelch=1;
     return 1; }
     
   else {
    TP->Message(BS(
     "Du kommst Dir etwas seltsam vor, bei dem Gedanken, aus einem leeren "
      "Kelch zu trinken. Aber was solls! Du nimmst den Kelch, setzt an und "
      "nimmst einen kraeftigen Schluck! Hmm, nichts. Du bist aber auch dumm!"));
     say(TPN+" versucht aus einem leeren Kelch zu trinken. Dummkopf.\n");
     return 1; }
  }
}

int cmd_rollen(string str)
{
  write(BS("Du rollst den Teppich weg und entdeckst darunter eine Klappe! Du "
    "oeffnest sie, und findest einen dahinter verborgenen Abgang, den Du, "
    "neugierig wie Du bist, sofort nach unten gehst."));
  ENV(TP)->Message(BS(TPN + " rollt den Teppich weg und verschwindet darunter."),
    MSGFLAG_NO_TP);
  TP->move("/d/seher/haus/xiao:00:00", M_GO|M_SILENT);
  ENV(TP)->Message(BS(TPN + " kommt durch die Klappe von oben herein."),
    MSGFLAG_NO_TP);
  return 1;
}

void reset()
{
  ::reset();
  kelch=0;
}