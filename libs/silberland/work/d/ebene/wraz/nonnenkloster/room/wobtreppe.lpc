// Gesellenstück
// Westtreppe im 2. Stock - wobtreppe.c
// Von Wraz / Mendralim
// -> 51 Details, 0 Sounds, 0 Smells, 0 Funktionen
// immer hell

inherit "std/room";

#include "../def.h"
#include <language.h>

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG,
  	 "Das hier ist der obere Stock des Klosters. Du stehst unmittelbar neben dem "
  	 "Treppenabgang, welcher wieder hinunter fuehrt. Ein Gelaender grenzt den Gang "
  	 "hier oben von der Kirche, die sich ein Stockwerk tiefer zwischen diesem und "
  	 "dem Abgang im Osten befindet, ab. Im Suedosten steht eine grosse Orgel.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24+random(3), ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail("kloster",
   	"Darin befindest Du Dich.");
   	
  AddDetail( ({"treppenabgang", "treppenabgaenge", "treppenaufgang",
  "treppenaufgaenge", "aufgang", "abgang", "aufgaenge", "abgaenge", "treppe"}),
  	 "Das Kloster hat zwei Treppenabgaenge, einen im Osten und einen im Westen. "
  	 "Du bist derzeit im westlichen.");
  	 
  AddDetail( ({"osten", "westen", "himmelsrichtung", "suedosten", "nordosten"}),
  	 "Eine schoene Himmelsrichtung.");
  
  AddDetail( ({"stock", "stockwerk", "stockwerke"}),
  	 "Hier im oberen Stock fuehrt ein Gang, welcher einerseits von dem Gelaender, "
  	 "andererseits von einer Wand begrenzt ist, zuerst nach Suedosten und dann weiter "
  	 "nach Nordosten zum anderen Abgang.");
  
  AddDetail( ({"gang"}),
  	 "Er ist nach Norden hin von einem Gelaender, nach Sueden von einer Wand begrenzt.");
  	 
  AddDetail( ({"gelaender"}),
  	 "Du blickst ueber das Gelaender hinunter und siehst die Kirche, von der aus Du hier "
  	 "heraufgekommen bist.");
  	 
  AddDetail( ({"kirche"}),
  	 "In der Mitte steht der Altar mit den zwei Pflanzen zu dem der Teppich zwischen "
  	 "den Holzbaenken fuehrt.");
  	 
  AddDetail( ({"mitte"}),
  	 "Der Altar steht ziemlich in der Mitte der Kirche.");
  	 
  AddDetail( ({"altar", "pflanzen", "teppich", "holzbaenke", "baenke"}),
  	 "Das kannst Du Dir viel besser ansehen, wenn Du wieder nach unten gehst.");
  	 
  AddDetail( ({"norden"}),
  	 "Noerdlich wird der Gang von einem Gelaender begrenzt, damit man nicht hinunterfallen "
  	 "kann.");
  	 
  AddDetail( ({"wand"}),
  	 "Die Wand im Sueden besteht aus hellgelben Marmor. Vor ihr stehen einige kleine "
  	 "Baeume in Toepfen.");
  	 
  AddDetail( ({"waende"}),
  	 "Es ist eigentlich nur eine Wand, und die ist im Sueden.");
  	 
  AddDetail( ({"toepfe", "topf"}),
  	 "Die Baeume wachsen aus Toepfen mit feinster Humuserde.");
  	 
  AddDetail( ({"humuserde", "erde", "humus"}),
  	 "Humus ist die beste Erde.");
  	 
  AddDetail( ({"marmor"}),
  	 "Der Marmor aus dem die Wand besteht, wurde poliert und spiegelt daher.");
  	 
  AddDetail( ({"sueden"}),
  	 "Suedlich wird der Gang von einer Wand begrenzt. Sie wurde mit Malereien verziert.");
  	 
  AddDetail( ({"malereien", "malerei"}),
  	 "Sie stellen Elemente der Flora dar.");
  	 
  AddDetail( ({"flora", "fachwort", "pflanzenwelt"}),
  	 "Flora ist das Fachwort fuer Pflanzenwelt.");
  	 
  AddDetail( ({"elemente"}),
  	 "Die Malereien zeigen Graeser, Buesche, Waelder und viele, viele Details.");
  	 
  AddDetail( ({"graeser", "buesche", "busch", "waelder", "wald"}),
  	 "Sie sind ein Teil der Flora.");
  	 
  AddDetail( ({"teil"}),
  	 "Jeder Teil ist wesentlich fuer das Gleichgewicht der Natur!");
  	 
  AddDetail( ({"natur"}),
  	 "Die Nonnen hier scheinen die Natur ueber alles zu verehren.");
  	 
  AddDetail( ({"gleichgewicht"}),
  	 "Fuer die Natur ist es wichtig, dieses zu behalten.");
  	 
  AddDetail( ({"baeume"}),
  	 "Hier stehen zwei Linden, etwa zwei Meter hoch, und vier andere Baeume, die etwas "
  	 "kleiner sind.");
  	 
  AddDetail( ({"meter"}),
  	 "Zwei Meter.");
  	 
  AddDetail( ({"linden"}),
  	 "Die Linden werden von den Nonnen hier staendig gepflegt und gegossen. Daher gedeihen "
  	 "sie hier praechtig. Ein wahrer Augenschmaus.");
  	 
  AddDetail( ({"nonnen"}),
  	 "Die Nonnen respektieren und verehren die Natur.");
  	 
  AddDetail( ({"augenschmaus", "gruen"}),
  	 "Das viele Gruen macht das gesamte Kloster wunderschoen.");
  	 
  AddDetail( ({"details"}),
  	 "Auf einem Stein siehst Du eine Flechte.");
  	 
  AddDetail( ({"stein"}),
  	 "Er ist auf der Malerei gut zu sehen.");
  	 
  AddDetail( ({"flechte"}),
  	 "Eines der vielen Details der Malereien an der Wand. Ausserdem wurde ein "
  	 "Symbol auf die Wand aufgemalt.");
  	 
  AddDetail( ({"symbol"}),
  	 "Das Symbol zeigt eine Birne mit einem Staengel und einem Blatt daran.");
  	 
  AddDetail( ({"birne", "birnensymbol"}),
   	 "Die auf dem Symbol dargestellte Birne hat einen Staengel mit einem Blatt.");
   	 
  AddDetail( ({"staengel", "blatt"}),
  	 "Das gehoert zu dem Symbol mit der Birne.");
  	 
  AddDetail( ({"orgel"}),
  	 "Die grosse, dunkelbraune Orgel steht im Suedosten. Um sie genauer "
  	 "zu betrachten, "
  	 "solltest Du naeher hingehen.");
  	 
  AddDetail( ({"boden"}),
  	 "Er wurde aus polierten Granitbloecken zusammengesetzt.");
  	 
  AddDetail( ({"granitbloecke", "bloecke", "granit"}),
  	 "An einem Granitblock ist rechtsoben etwas eingeritzt.");
  	 
  AddDetail( ({"granitblock", "block"}),
  	 "In ihn ist eindeutig etwas eingeritzt.");
  	 
  AddDetail( ({"eingeritztes", "ritzerei", "etwas eingeritztes", 
  	"einritzung", "ritzen", "ritzer", "ritereien", "etwas",
  	"geritztes", "geritze"}), // seitenspezifisch!
  	 "Du bueckst Dich um es besser zu erkennen...\n"
  	 "... und siehst, dass es sich wieder um das Birnensymbol handelt. Langsam denkst Du, "
  	 "dass dieses Symbol das Kloster hier kennzeichnet, so wie beispielsweise Paladine "
  	 "einen Wappenrock oder Druiden ein Amulett tragen.");
  	 
  AddDetail( ({"paladine"}),
  	 "Ihr Kennzeichen ist der Wappenrock.");
  	 
  AddDetail( ({"druiden"}),
  	 "Sie tragen alle ein Amulett.");
  	 
  AddDetail( ({"wappenrock"}),
  	 "Jeder Paladin traegt einen.");
  	 
  AddDetail( ({"amulett"}),
  	 "Druiden haben ein spezielles Amulett.");
  	 
  AddDetail( ({"kennzeichen"}),
  	 "Das Kennzeichen dieses Klosters ist anscheinend das Birnensymbol.");
  	 
  AddDetail( ({"decke"}),  // uebernommen (leicht geaendert) aus wtreppe bzw otreppe:
  	 "An der vergoldeten Decke erkennst Du reichlich Verzierungen und Schnoerkeleien. "
  	 "Ausserdem wurde ein grosses Fresko in die Decke gearbeitet. Sie befindet sich "
  	 "sehr hoch oben.");
  	 
  AddDetail("verzierungen",
  	 "Die Verzierungen schmuecken die Decke und machen sie huebsch.");
  	 
  AddDetail("schnoerkeleien",
  	 "Die Schnoerkeleien erstrecken sich ueber die gesamte Decke und geben ihr ein "
  	 "huebsches Aussehen.");
  	 
  AddDetail("aussehen",
  	 "Sehr huebsch!");
  	 
  AddDetail("fresko",
  	 "Es stellt eine Birne samt Staengel und einem Blatt dar und leuchtet seltsam.");
  	 
  AddDetail("licht",
  	 "Es muesste hier eigentlich komplett dunkel sein, da nirgendwo Fenster in die Waende "
  	 "gebaut sind. Das Licht, welches diesen Raum und die Kirche erhellt, geht eindeutig "
  	 "von dem Fresko an der Decke aus.");
  	 
  AddDetail( ({"fenster"}),
  	 "Du blickst Dich nocheinmal um, findest aber keine.");  // ende
  	 
  
  AddSmell(DEFAULT_SMELL,
  	"Es duftet hier erdig.");
  	
  AddSound(DEFAULT_SOUND,
  	"Hier ist es still.");
  	 
  
  AddExit("unten", ROOM "wtreppe");
  AddExit("suedosten", ROOM "orgelraum"); 
  
  AddCmd(({"lies","lese"}), "cmd_lesen");
}

int _query_total_light() {return 1;}

int cmd_lesen(string str)
{
  if(!str||str=="") return 0;
  
  notify_fail("Was willst Du denn lesen?\n");
  
  if(str=="eingeritztes"||str=="ritzerei"||str=="etwas eingeritztes")
  {
    TP->Message(BS("Naja, das ist ein Symbol. Lesen kannst Du das nicht, "
    "aber untersuchen!"));
    return 1;
  }
return 0;
}