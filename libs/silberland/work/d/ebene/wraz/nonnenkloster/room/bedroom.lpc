// Gesellenstück
// Schlafstätte im 2.Stock / bedroom.c
// Von Wraz / Mendralim
//

inherit "std/room";

#include "../def.h"

string macht();
int oioi, p, q;

int do_cloning()
{
  object nun, *ob;
  int nnn; //number_nuns_needed :)
  
  ob=find_livings("\nnuns_by_wraz");
  if(ob==0) ob=({""});
  
  for(nnn=sizeof(ob);nnn<8;nnn++)
  {
    if(nnn>10) break; // ich bau immer megalag wenn ich bei for was falsch
    			  // mach, sicherheitsmassnahme :)
    nun=clone_object(NPC "nun");
    
    if(!nnn) {
      call_other(ROOM "eraum", "???");  
      nun->move(ROOM "eraum", M_TPORT);
      continue; }
    
    switch (random(8))
    {
      case 0:
      call_other(ROOM "gang", "???");  
      nun->move(ROOM "gang", M_TPORT); break;
      
      case 1:
      call_other(ROOM "sing", "???");  
      nun->move(ROOM "sing", M_TPORT); break;
      
      case 2:
      call_other(ROOM "kiachn", "???");  
      nun->move(ROOM "kiachn", M_TPORT); break; // ich hasse mich selbst fuer
      			// diese scheiss kauderwelschnamen !!! wegen denen 
      			// hab ich bugs die ich tagelang suche *GRUMMEL*
      
      case 3:
      call_other(ROOM "wobtreppe", "???");  
      nun->move(ROOM "wobtreppe", M_TPORT); break;
      
      default:
      nun->move(ROOM "bedroom", M_TPORT); break;
    }
  }
  return 1;
}

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG,
   "Dieser Raum dient eindeutig als Schlafraum fuer die Nonnen. Ueberall stehen hier "
   "Betten und Nachtkaestchen verteilt. Es gib wie immer keine Fenster und viele "
   "Pflanzen, die seltsam leuchten.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21+random(3), ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail(({"leuchten"}),
   "Die Pflanzen hier leuchten wirklich eigenartig...");
  
  AddDetail(({"raum","schlafraum"}),
   "In dem stehst Du gerade. Seltsam, wie bist Du nur hier hereingekommen?");
   
  AddDetail(({"nonne"}),
   "Wenn eine da waere, wuerde sie Dich sicherlich rauswerfen!");
   
  AddDetail(({"nonnen"}),
   "Diese Nonnen sind sehr naturverbundene Menschen.");
   
  AddDetail(({"menschen"}),
   "Die Nonnen hier sind alle Menschen.");
   
  AddDetail(({"betten","bett"}),
   "Die Betten haben hellweisse Ueberzuege, ebenfalls weisse Decken und Poelster.");
   
  AddDetail(({"ueberzuege","ueberzug"}),
   "Sie sind anmutig schoen weiss.");
   
  AddDetail(({"decken","bettdecken","bettdecke"}),
   "Die Decken sind ordentlich gefaltet. An einer Decke siehst Du einen farbigen "
   "Fleck.");
   
  AddDetail(({"decke"}),
   "Bettdecke oder Zimmerdecke?");
   
  AddDetail(({"fleck"}),
   "Bei genauerer Betrachtung entdeckst Du, dass der Fleck das Birnensymbol "
   "darstellt.");
   
  AddDetail(({"betrachtung"}),
   "Bei genauerer!");
   
  AddDetail(({"birnensymbol","symbol"}),
   "Du kennst es bereits, denn es ist hier im Kloster ueberall verteilt. Es zeigt "
   "eine Birne mit Staengel und Blatt.");
   
  AddDetail(({"kloster"}),
   "Ja, das hier ist ein Kloster!");
   
  AddDetail(({"birne"}),
   "Eine gelbe Birne.");
   
  AddDetail(({"staengel"}),
   "Er ist braun.");
   
  AddDetail(({"blatt"}),
   "Das Blatt des Symboles auf ... oh, da faellt Dir gerade auf, das Symbol befindet "
   "sich auf jeder Decke und auch auf jedem Polster und Ueberzug! Naja, jedenfalls "
   "ist das Blatt gruen, wie es sich gehoert.");
   
  AddDetail(({"poelster","polster"}),
   "Wunderbar weisse Poelster! Die Betten sehen wirklich sehr verlockend aus... aber, "
   "ob es nett ist sich in ein fremdes Bett zu legen? Wer weiss, vielleicht sind die "
   "Nonnen diesbezueglich sehr unangenehm...");
   
  AddDetail(({"nachtkaestchen"}),
   "Kleine, braune Nachtkaestchen, vermutlich aus Buchenholz. Sie haben Laden.");
   
  AddDetail(({"buchenholz"}),
   "Daraus wurden die Nachtkaestchen hier hergestellt.");
   
  AddDetail(({"holz"}),
   "Die Nachtkaestchen hier wurden aus Buchenholz gefertigt.");
   
  AddDetail(({"laden"}),
   "Die Nachtkaestchen sind mit Laden bestueckt.");
   
  AddDetail(({"lade"}),
   "Viele Laden in den Nachtkaestchen!");
   
  AddDetail(({"fenster"}),
   "Wiedereinmal suchst Du das Gemaeuer nach Fenstern ab, und findest wieder keine.");
   
  AddDetail(({"waende","wand"}),
   "Schau Dich genauer um, dann findest Du das richtige Wort.");
   
  AddDetail(({"wort"}),
   "Du kannst es finden!");
   
  AddDetail(({"gemaeuer"}),
   "Es besteht aus Holzbalken.");
   
  AddDetail(({"holzbalken", "balken"}),
   "Sie sind feinsaeuberlich zusammen gefuegt worden.");
   
  AddDetail(({"boden"}),
   "Der Boden hier wurde mit Filz ausgelegt.");
   
  AddDetail(({"filz"}),
   "Vermutlich dazu gut, dass die Nonnen keine kalten Fuesse bekommen.");
   
  AddDetail(({"fuesse"}),
   "Im Schlafzimmer traegt man selten Schuhe.");
   
  AddDetail(({"schlafzimmer"}),
   "Dort bist Du.");
   
  AddDetail(({"schuhe"}),
   "Hast Du welche an? Wenn ja, dann waere das sehr unhoeflich!");
   
  AddDetail(({"pflanzen"}),
   "Die Pflanzen scheinen den Raum irgendwie zu erhellen. Irgendwie hast Du das "
   "Gefuehl, sie bemerken Deine Anwesenheit, und Du bist nicht erwuenscht!");
   
  AddDetail(({"gefuehl"}), #'macht);
  
  AddDetail(({"anwesenheit"}), 
   "Du willst weg! Du bist hier nicht erwuenscht! Du fuehlst hier eine gewaltige "
   "Macht, "
   "die sich gegen Dich richten koennte.");
   
  AddDetail(({"macht"}),
   "Du erzitterst!");
   
  AddDetail(({"zimmerdecke","raumdecke"}),
   "Sie ist weiss. Vermutlich Kalk.");
   
  AddDetail(({"kalk"}),
   "Damit wurde moeglicherweise die Zimmerdecke bestrichen.");
   
  AddDetail(({"licht"}),
   "Es ist hier ausreichend hell.");
   
  AddSmell(DEFAULT_SMELL,
   "Es riecht hier nach Pflanzen.");
   
  AddSmell(({"pflanzen","pflanze"}),
   "Sie riechen einfach nach Gruenzeug.");
   
  AddSmell("gruenzeug",
   "Ein typischer Geruch.");
   
  AddSound(DEFAULT_SOUND,
   "Absolute Stille. Bis auf Dich!");
  
  AddSpecialExit("osten", "go_osten");
  
  AddCmd("oeffne", "cmd_oeffnen"); // Lade!
  AddCmd("lege|lieg|leg|liege&in|auf&bett", "cmd_liegen", "Wo willst Du liegen?|"
  "Wo willst Du liegen?");
  
  SUID;
  
  oioi=0;
  p=0;
  q=0;
  do_cloning();
}

int cmd_oeffnen(string str)
{
  if(!str||str=="") return 0;
  notify_fail("Was willst Du oeffnen?\n");
  
  if(str=="lade")
  {
    TP->Message(BS("Du versuchst die Lade zu oeffnen... keine Chance. Sie ist "
    "irgendwie verschlossen."));
    return 1;
  }
  
  else return 0;
}


void gogo(object player)
{
  int delay;
  
  if(!interactive(player)) return;
  
  switch (p)
  {
    case 0:
    player->Message("Eine Macht durchfaehrt Dich ploetzlich und Du bist "
    "wie erstarrt!",MSGFLAG_SENSE);
    delay=4;
    p++;
    break;
    
    case 1:
    player->Message("In Deinem Kopf beginnt alles Zu BEBEN unD Drehe n!"
    " !\n\n",MSGFLAG_SENSE);
    delay=4;
    p++;
    break;
    
    case 2:
    player->Message("EiN e Bed rohlichee STIMKME beg2Int Zu "
    "GROOOLLENN!!\n\n\n",MSGFLAG_SENSE);
    delay=2;
    p++;
    break;
    
    case 3:
    player->Message("VERLASSE\n\n",MSGFLAG_SENSE);
    delay=2;
    p++;
    break;
    
    case 4:
    player->Message("DIESEN\n\n",MSGFLAG_SENSE);
    delay=2;
    p++;
    break;
    
    case 5:
    player->Message("ORT!!!\n\n\n",MSGFLAG_SENSE);
    delay=6;
    p++;
    break;
    
    case 6:
    player->Message("DeiN Kof p sCHMeRRZt, >EAHHHRTGG! \n"
    "Du haleLTSt dasss nIcHT mehRAu s!!!!!!\n\n",MSGFLAG_SENSE);
    delay=4;
    p++;
    break;
    
    case 7:
    player->Message("\n\nPloetzlich schwarZ.\n\n",MSGFLAG_SENSE);
    delay=8;
    p++;
    break;
    
    case 8:
    player->Message("\nLangsam erwachst Du wieder...\n",MSGFLAG_SENSE);
    delay=4;
    p++;
    break;
    
    case 9:
    player->Message("\nEIN ploetzlicher Schlag: VERSCHWINDE!!!\n"
    "Du willst nur noch hier weg.\n",MSGFLAG_SENSE);
    p++;
    break;
    
    default: p=0; return; break;
  }
  
  if(p) call_out("gogo",delay,player);
    
  return;
}

string macht()
{
  write_file(LOG "bett.log",dtime()+": "+TPN+" forscht Macht.\n");
  
  TP->SetProp(P_PARALYZED, 
  ([PARALYZE_TIME:18,PARALYZE_MSG:"Aengstlich kauerrrrst Du nur "
  "auf dem BB..Boden. Diese MaCgrrht ist zu starrrrrrgK!\n",
  PARALYZE_MSG_OTHER:"%s stammelt, den "
  "Kopf mit beiden Haenden haltend, unverstaendliche Worte vor sich hin.\n",
  PARALYZE_END:
  "Die Macht verlaesst Dich wieder. Dennoch fuehlst Du Dich hier sehr unwohl!\n",
  PARALYZE_END_OTHER:"%s scheint sich wieder zu fassen.\n"]));
  
  gogo(TP);
  
  return "\n";
}

void reset()
{
  ::reset();
  oioi=0;
  do_cloning();
  //players->move out - geschieht durch clonen der nonnen
}

void text(object player, int dam, int q)
{
  int delay;
  
  switch(q)
  {
  case 0:
    Message("Ploetzlich kommt ein immens starker Wind auf!\n\n");
    delay=2; dam=0; q++;
    break;
  
  case 1:
    Message("Heftig wirst Du gegen eine Wand "
    	 "geschleudert!!\n\n");
    delay=2; dam=1; q++;
    break;
  
  case 2:
    Message("Es wird kurz dunkel, dann wieder hell!\n\n");
    delay=4; dam=0; q++;
    break;
  
  case 3:
    Message("Blitze durchzucken den Raum!!\n\n");
    delay=4; dam=1; q++;
    break;
  
  case 4:
    Message("In dem wilden Getose entsteht eine "
  	  "undefinierbare Gestalt.\n"
  	  "Du bist fasziniert und erschrocken zugleich.\n\n");
    delay=4; dam=0; q++;
    break;
  
  case 5:
    Message("Die Gestalt verkoerpert die Natur!!\n\n");
    delay=4; dam=0; q++;
    break;
  
  case 6:
    Message("               "
    	  +getcolor("red")+"VERSCHWINDE!!!!\n\n"+getcolor("none"));
    delay=4; dam=0; q++;
    SetProp("in_bed", 0);
    call_out("clone_nature",4);
    break;
    
  default: delay=3; SetProp("in_bed", 0); q=0; return; break;  
  }

  if(dam==1)
  {
    if(!interactive(player)) return;
    else player->do_damage(random(20)+10);
  }
  
  if(q) call_out("text",delay,player,dam,q);
  else return;
}

void clone_nature()
{
  object ob;
  ob=clone_object(NPC "natur");
  ob->move(ROOM "bedroom", M_TPORT);
  return;
}

int cmd_liegen()
{
  if(!oioi&&!find_living("\nnuns_by_wraz")) {
  write_file(LOG "bett.log",dtime()+": "+TPN+" holt Natur.\n");
  TP->Message(BS("Du legst Dich in das Bett."));
  SetProp("in_bed", 1);
  
  call_out("text",2,TP);
  
  oioi=1;
  return 1; }
  
  else {
   write_file(LOG "bett.log",dtime()+": "+TPN+" versucht Natur zu holen.\n");
   TP->Message(BS("Du legst Dich in ein Bett. Nichts passiert, Du stehst wieder auf."));
   return -1; }
}

int go_osten()
{
  if(QueryProp("in_bed")) return TP->Message(BS("Du bist viel zu abgelenkt!"));
  
  return TP->move(ROOM "gang", M_GO, "nach Osten",
  "geht", TP->QueryProp(P_MSGIN));
}