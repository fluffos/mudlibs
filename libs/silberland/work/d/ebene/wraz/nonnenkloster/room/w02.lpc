// Gesellenstück
// Raum 2 für Weg - w02.c
// von Wraz / Mendralim
// 28 Details, 2 Sounds, 2 Smells, 1 Funktion

inherit "std/room";

string lpweg();

#include "../def.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Ein Weg in der Steppe");
  SetProp(P_INT_LONG,
  	 "Der Pfad macht an dieser Stelle einen leichten Bogen und fuehrt von "
  	 "Norden weiter nach Suedwesten. Die Anzahl der Pflanzen nimmt weiterhin "
  	 "deutlich zu und Deine Vermutung, auf einen dichten Wald zu stossen, "
  	 "koennte sich bald als richtig herausstellen.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_PLAIN]));
  
  AddDetail(({"pfad", "stelle", "richtung"}),
  	 "Der Pfad macht hier eine Biegung in Richtung Suedwesten.");
  
  AddDetail(({"biegung", "bogen"}),
  	 "In Richtung Suedwesten.");
  
  AddDetail("suedwesten",
  	 "Als Du genauer in diese Richtung blickst, faellt Dir ploetzlich auf, "
  	 "dass sich dort tatsaechlich ein Wald befindet! Du fragst Dich, "
  	 "ob es dort wohl etwas zu entdecken gibt?");
  	 
  AddDetail(({"wald"}),
  	 "Ja, Du kannst eindeutig einen dichten Wald erkennen. Er ist zwar noch relativ "
  	 "weit entfernt, doch Du bist Dir sicher, dass Dich dieser Pfad dort hin fuehren "
  	 "wird.");
  	 
  AddDetail(({"pflanzen", "pflanze"}),
  	 "Du blickst Dich kurz um und entdeckst einige, sehr grosse Straeucher, Disteln, "
  	 "Baeume und viele andere Arten.");
  	 
  AddDetail("straeucher",
  	 "Du wunderst Dich ein wenig, denn diese hier sind wirklich sehr gross. An einem "
  	 "Strauch erkennst du einen ungewoehnlich dicken Ast.");
  	 
  AddDetail("strauch",
  	 "An ihm befindet sich ein Ast mit einem aussergewoehnlich grossen Durchmesser.");
  	 
  AddDetail("durchmesser",
  	 "Was hat denn den Durchmesser?");
  	 
  AddDetail(({"ast","astdurchmesser"}),
  	 "Du gehst naeher an den seltsamen Strauch heran und bemerkst, dass dieser "
  	 "Ast gar nicht zu dem Strauch dazugehoert, sondern von einem Baum abgebrochen "
  	 "und in den Strauch hineingefallen ist. Dabei faellt Dir die Bruchstelle an "
  	 "dem Baum, welcher direkt hinter dem Strauch steht, auf.");
  	 
  AddDetail("baum",
  	"An einem Baum stimmt etwas nicht!");
  
  AddDetail(({"bruchstelle", "bruch"}),  // ertaste bruchstelle
  	 "Hmm. Die Bruchstelle an dem Baum duerfte schon ziemlich alt sein, jedoch sind "
  	 "noch keine Anzeichen von ihrer Verheilung zu sehen. Du ueberlegst Dir, ob es "
  	 "sinnvoll waere, wenn Du die Stelle einmal abtastest.");
  	 
  AddDetail(({"holzsplitter"}),
  	 "Die Holzsplitter an der Bruchstelle sehen seltsam aus. Ein weiterer "
  	 "Grund, die Stelle abzutasten!");
  	 
  AddDetail(({"grund","gedanken"}), #'lpweg);
  	 
  AddDetail("anzeichen",
   	"Du siehst nocheinmal genau hin, aber der Bruch ist wirklich total ausgefranst "
   	"und es sieht nicht nach Verheilung aus.");
   	
  AddDetail("verheilung",
  	 "Keine zu sehen.");
  	 
  AddDetail("anzahl",
  	 "Sie wird sicher steigen, wenn Du weiter in Richtung Suedwesten gehst.");
  	
  AddDetail(({"distel", "disteln"}),
  	 "Davon stehen hier einige. Sie haben ueberall spitze Stacheln!");
  	 
  AddDetail("stacheln",
  	 "Du beschliesst, lieber einen grossen Bogen um die Disteln zu gehen, da Du "
  	 "Dich auf keinen Fall an ihnen stechen willst.");
  	 
  AddDetail("fall",
  	"Auf keinen!");
  	 
  AddDetail(({"baeume", "arten", "art"}),
  	 "Hier befinden sich Pappeln, Ahorne, Kastanien, Linden und viele andere Arten.");
  	 
  AddDetail(({"pappel", "pappeln", "ahorn", "ahorne", "kastanien", "kastanie", "linden", "linde"}),
  	 "Die wachsen hier. Wirklich schoene Pflanzen!");
  	 
  AddDetail(({"blatt", "blaetter", "rinde", "stamm", "aeste", "zweige", "zweig"}),
  	 "Ein Teil eines Baumes.");
  	 
  AddDetail("teil",
  	"Jetzt reichts aber!");
  	 
  AddDetail(({"vermutung"}),
  	 "Diese koennte sich sehr bald bestaetigen.");
  	 
  AddDetail("boden",
  	 "Auf dem Boden ist der Pfad durch zusammengetrampeltes Gras zu erkennen.");
  	 
  AddDetail("gras",
  	 "Es ist hier bereits etwas gruener und saftiger als es im Norden war.");
  	
  AddDetail("norden",
  	 "Aus dieser Richtung kommt der Pfad und fuehrt weiter nach Suedwesten.");
  	 
  AddDetail("himmel",
  	 "Der Himmel erstahlt in schoenstem Blau! Er erinnert Dich an die Felseninsel.");
  	 
  AddDetail("blau",
  	 "Die Farbe des Himmels.");
  	 
  AddDetail("farbe",
  	"Es gibt viele.");
  	 
  AddDetail("felseninsel",
  	 "Dort ist die beste aller Gilden beheimatet!");
  	 
  AddDetail(({"gilde", "gilden"}),
  	 "Die blutruenstigen, tapferen und starken Berserker natuerlich!");
  	 
  AddDetail("berserker",
  	 "Du solltest Dich vor ihnen hueten, denn sie koennen sehr schnell aggressiv "
  	 "werden, wenn man sie beleidigt oder gar ihr Ehrgefuehl verletzt!");
  	 
  AddDetail("ehrgefuehl",
  	"Jeder besitzt ein Ehrgefuehl! Man sollte es nie verletzen.");
  	 
  AddDetail("luft",
  	 "Herrlich frisch!");
  	 
  AddDetail("ohren",
  	"Um die zu sehen muesstest Du sie Dir abschneiden oder etwas anderes "
  	"tun.");
  	
  AddDetail("atemzug",
  	"Sehen auch nicht :)");
  	
  AddDetail("kopf",
  	"Beim Gedanken an den Grund tat er ploetzlich weh.");
  	 
  	
  AddSmell(DEFAULT_SMELL,
  	 "Du saugst die frische Steppenluft genuesslich ein. Schliesslich stoesst "
  	 "Du sie mit einem Seufzer wieder aus.");
  	 
  AddSmell(({"luft", "steppenluft"}),
  	 "Du kannst der Versuchung nicht widerstehen und nimmst noch einen herrlichen, "
  	 "tiefen Atemzug.");
  	 
  AddSmell("atemzug",
  	 "Den kannst Du nicht riechen.");
  	 
  AddSmell("versuchung",
  	"Du konntest ihr nicht widerstehen.");
  	 
  AddSound(DEFAULT_SOUND,
  	 "Das sanfte Rascheln von Blaettern erklingt in Deinen Ohren.");
  	 
  AddSound("ohren",
  	"MIT denen hoert man, aber sie selbst kann man nicht hoeren.");
  	 
  AddSound(({"rascheln", "blaetter", "blaettern"}),
  	 "*raschel* ...... *raschel*");
  	 
  AddSound("atemzug",
  	"Du lauscht Deinem Atemzug.");
  	 
  
  AddCmd(({"ertaste", "taste"}), "tasten");
  AddCmd(({"verletze", "verletz"}), "verletzen");
  
  AddExit("norden",ROOM "w01");
  AddExit("suedwesten",ROOM "w03");
  
  AddItem(NPC "chamaeleon", REFRESH_DESTRUCT);
  
}

int tasten(string str)
{
  notify_fail("Was willst Du denn abtasten?\n");
  if(!str||str=="") return 0;
  
  if(str=="baum ab")
  {
    write(BS("Was? Du willst den ganzen Baum abtasten? Ueberleg Dir das lieber nochmal!"));
    return -1;
  }
  
  if(str=="stelle"  || str=="stelle ab")
  {
    write(BS("Welche Stelle willst Du abtasten?"));
    return -1;
  }
  
  if(str=="bruchstelle ab" || str=="bruchstelle" || str=="bruch" || str=="bruch ab")
  {
    TP->Message(BS("Du tastest an der Bruchstelle herum und bemerkst, dass die Holzsplitter dort "
    	     "total trocken sind. Du blickst den Baum hinauf und erst jetzt faellt "
    	     "Dir auf, dass er schon vor vielen Jahren abgestorben sein muss, da er "
    	     "kein einziges Blatt traegt und nur sehr wenige, dicke Aeste. "
    	     "Eigentlich ist der Baum nicht weiter interessant."));
    say(TPN+" tastet an einem toten Baum herum.\n");
    return 1;
  }
  return 0;
}

int verletzen(string str)
{
  notify_fail("Was willst Du verletzen?\n");
  if(!str||str=="") return 0;
  
  if(str=="ehrgefuehl")
  {
    TP->Message(BS("Du holst weit aus und drischt mit aller Gewalt und Kraft "
      "auf Dein Ehrgefuehl ein. Aus irgendeinem Grund steigerst Du Dich so "
      "richtig hinein und pruegelst weiter wie ein Wilder auf dem Ehrgefuehl "
      "herum.\n"
      "Nach einiger Zeit brichst Du erschoepft zusammen und laesst von Deinem "
      "Ehrgefuehl ab. Mann, hast Du eine lebhafte Fantasie!"));
    return 1;
  }
  return 0;
}

string lpweg()
{
  TP->AddHp(-random(10));
  return "Beim Gedanken an den Grund tut Dir ploetzlich der Kopf "
  "weh!\n";
}