string a001()
{
  TP->Message(BS("Du gehst ein Stueckchen weiter, und ploetzlich schiesst "
  "Dir ein Gedanke durch den Kopf!"));
  TP->AddHp(-4);
  return "Du bist von einem Daemon besessen!\n";
}

int streicheln(string str)  // --- STREICHELN ---
{
  notify_fail("Streichle wen?\n");
  if(!str||str=="") return 0;
  
  if(str== "blatt" || str=="blaetter" || str=="buschblatt")
  {
    write(BS("Du streichelst eines der Blaetter des Busches und fuehlst Dich "
    	     "gut.\n"
    	     "Dabei faellt Dir auf, dass Du an dem Busch vorbeihirten "
    	     "koenntest."));
    say(TP->Name()+" streichelt die Blaetter eines schoenen Busches. Wie "
    "peinlich!!\n");
    return 1;
  }
}

int pfluecken(string str)  // --- PFLUECKEN ---
{
  object cherry;
  
  notify_fail(BS("Was moechtest Du denn pfluecken?"));
  if(!str||str=="") return 0;
  
  if(str=="kirsche")
  {
    if(kirschen)
    {
      cherry=clone_object(OBJ "cherry");
      if(cherry->move(TP, M_GET) == ME_TOO_HEAVY)
      {
      	cherry->remove(1);
      	write(BS("Du koenntest die Kirsche nicht mehr tragen, daher laesst "
      	"Du es sein."));
      	return -1;
      }
      
      else
      {
      	write(BS("Du pflueckst Dir eine knallrote Kirsche."));
        say(TP->Name()+" pflueckt eine Kirsche von einem Kirschbaum.\n");
        kirschen--;
        return 1;
      }
    }
  
    else
    {
       write(BS("Derzeit ist keine der Kirschen in Deiner Reichweite, und "
       		"auf den Baum willst Du auch nicht klettern."));
       return -1;
    }
  }
}
    
int ueberlegen(string str)  // --- UEBERLEGEN ---
{
  if(member(({"ueberleg","ueberlege"}),query_verb())!=-1&&str==0)
  //if(query_verb()=="ueberlege"&&str==0 || query_verb()=="ueberleg"&&str==0)
  {
  write(BS("Du ueberlegst kurz....\n"
  	   "Schliesslich kommst Du zu dem Schluss, dass es voellig sinnlos "
  	   "waere, hier nach dem Grundwasser zu graben."));
  return 1;
  }
  
  else
  {
    write( BS("Ueberleg aber nicht zu viel!"));
    return -1;
  }


}

int aufheben(string str)  //  --- AUFHEBEN ---
{
  
  if(!str||str=="") return 0;
  
  if(str== "farbigen klumpen auf")
  {

  if(lucky==666)
  {
    write(BS("Du hebst einen gruenlichen Stein auf und betrachtest ihn "
    	     "kurz.\n"
    	     "Da er voellig langweilig aussieht wirfst Du ihn wieder weg."));
    return -1;
  }
  
  else
  {
    lucky=random(3);
    if(lucky==0)
    {
      object stone;
      stone="/obj/gemmaster"->DistributeGem(1)[0]; // [0] weil distributegem
      // einen array zurueckgibt!
      if(stone->move(TP, M_GET)== ME_TOO_HEAVY)
      {
      	stone->remove(1);
      	write( BS("Du kannst den Stein nicht mehr tragen, daher laesst Du "
      	"ihn liegen.") );
      	return 1;
      }
      
      else
      {
      	write( BS("Du hebst den Stein auf und bist sehr erstaunt!") );
      	lucky=666;
      	return 1;
      }
    }
    else
    {
      write( BS("Du hebst den Stein auf und stellst fest, das es sich um "
      	        "einen stinknormalen Erdbrocken handelt. Daher wirfst Du "
      	        "ihn wieder weg."));
      return -1;
    }
    } 
  }
  
}

string scr1()  // SCRIPTFALLE
{
  TP->SetProp("xxxdiexxx", time());
  TP->AddHp(-134);
  TP->Message(BS("aaaaaaargh!! ein schmerz im kopf!!! hoer auf!!!!! das "
  "bringt dich noch um!!!"));
  return( "dein kopf schmerzt fuer sekunden!!! Zarw ... argh!!! "
  "denk nicht an ihn!!! ignoriere ihn!!! tu einfach nichts was mit ihm zu "
  "tun hat, das ist die einzige loesung!!\n" );
}

string scr2()
{
  int tot;
  tot=TP->QueryProp("xxxdiexxx");
  if(tot<time()-30) { 
    TP->AddHp(-67);
    return ("Milardnem Zarw kehrt zurueck!! arg!!\n"
    "dabei hattest du ihn schon besiegt!!!!\n"); }
  else
  {
    TP->Message(BS("MILARDNEM ZARW VERNICHTET DEINE GEDANKEN!!!"));
    TP->die();
    write_file(LOG "w04_scr.log", dtime() +" "+TPN+"\n");
    return( BS("MILARDNEM ZARW BRUELLT: MUAHAHAHA"));
  }
}
   
   
int hiatn(string str)  //  EXIT --- hirten
{
  if(!str||str=="") return 0;
  
  if(str=="an busch vorbei" || str=="busch vorbei" || str=="busch" ||
     str=="um busch")
  {
    write( BS("Du hirtest gekonnt an dem Busch vorbei in Richtung Suedwesten. "
    	      "Ploetzlich traust Du Deinen Augen nicht mehr...") );
    	      
    TP->move(ROOM "w05", M_GO, "davon", "hirtet", "hirtet gekonnt herein");
    return 1;
  }
}
      
void reset()
{
  ::reset();
  kirschen=4+random(7);
  lucky=random(3);
}

int graben_()
{
  write(BS("Ey, Du nix Deutsch?"));
  return -1;
}

int graben(string str) // --- GRABEN ---
{
  if(!str||str=="") return 0;
  
  if(str=="boden"||str=="in boden"||str=="in erde")
  {
    if(!present("schaufel",TP))
    {
      TP->Message(BS("Du graebst mit Deinen Haenden im Boden... aeusserst "
      "ineffizient ... und, ... wonach eigentlich??."));
      
      ROOM "w04"->Message(BS(TPN+" graebt mit "+
      TP->QueryPossPronoun(WEM,FEMALE,1)+" Haenden im Boden."),
      MSGFLAG_NO_TP);
      
      return -1;
    }
    TP->Message(BS("Du graebst und graebst... wonach eigentlich?"));
    return -1;
  }
  
  if(str=="nach grundwasser"||str=="grundwasser"||
     str=="in boden nach grundwasser"||str=="in erde nach grundwasser")
  {
    if(!present("schaufel",TP))
    {
      TP->Message(BS("Du graebst mit Deinen Haenden im Boden... aeusserst "
      "ineffizient."));
      
      ROOM "w04"->Message(BS(TPN+" graebt mit "+TP->QueryPossPronoun(
      WEM,FEMALE,1)+" Haenden im Boden."),
      MSGFLAG_NO_TP);
      
      return -1;
    }
    
    else
    {
      TP->do_exhaust(450+random(150),1);
      TP->Message(BS("Du beginnst gemuetlich zu graben, doch nach einiger "
      "Zeit ohne Erfolg wird Dir das zu dumm und Du steigerst Dich immer "
      "mehr hinein! Wie ein Verrueckter graebst Du, total verschwitzt und "
      "erschoepft dennoch weiter!! Als Dir ploetzlich eine Wasserfontaene "
      "ins Gesicht spritzt brichst Du ruckartig durch die Erde..."));
      
      ROOM "w04"->Message(BS(TPN+" graebt wie besessen im Boden herum, "
      "immer tiefer und tiefer, als "+TPN+" ploetzlich verschwindet und das "
      "Loch sich auf seltsame Weise schliesst!"),MSGFLAG_NO_TP);
      
      TP->move(ROOM "drachenloch", M_GO, "in einem Loch", "verschwindet",
       "bricht durch die Decke herein");
       return 1;
    }
  }
}

int klettern(string str) // --- KLETTERN ---
{
  notify_fail("Worauf willst Du klettern?\n");
  if(!str||str=="") return 0;
  
  if(str=="auf baum" || str=="baum" || str=="auf baum hinauf" ||
     str=="auf baum rauf")
  {
    TP->Message("Du kletterst auf irgendeinen Baum hinauf.\n");
    if(TP->QueryProp(P_BLIND))
    {
      TP->Message(BS("Da Du aber blind bist, bringt Dir das ueberhaupt nichts. "
        "Du bist froh, dass Du blindes Huhn nicht hinunter gefallen bist und "
        "kletterst vorsichtig wieder runter."));
      return -1;
    }
    else
    {
      TP->Message(BS("Oben angekommen blickst Du motiviert durch die Gegend, "
        "und meinst im Suedwesten etwas eigenartiges zu sehen, sicher bist "
        "Du Dir aber nicht, da es relativ weit weg ist. Da Du von hier aus "
        "nichts genaueres erkennst, kletterst Du flott wieder runter."),
        MSGFLAG_VISUAL);
      return 1;
    }
  }
return 0;
}