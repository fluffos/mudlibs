// Gesellenstück
// Raum unter Raum 4 - drachenloch.c
// von Wraz / Mendralim
// 

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();


  SetProp(P_INT_SHORT, "In einem Loch");
  SetProp(P_INT_LONG,
    "Im diesem Erdloch ist es stockfinster, sofern Du keine Lichtquelle mit "
    "Dir traegst. Der Boden ist schlammig, ebenso wie die Waende und die "
    "Decke, wenn man das als Decke bezeichnen kann. Es ist Dir raetselhaft, "
    "wie diese riesige Hoehle ueberhaupt entstehen konnte, beziehungsweise "
    "warum sie nicht vollkommen mit Grundwasser gefuellt ist.");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"erdloch", "loch"}),
    "Darin klebst Du gerade.");
    
  AddDetail(({"lichtquelle"}),
   "Wenn Du keine da hast, ist es hier vermutlich stockfinster.");
   
  AddDetail(({"boden","erde"}),
   "Der Boden ist einfach nur Schlamm.");
   
  AddDetail(({"schlamm"}),
   "Erde mit Wasser gemischt. Bei jedem Schritt macht es ein schmatzendes "
   "Geraeusch.");
   
  AddDetail( ({"schritt", "schritte"}),
   "Lausche dem einmal!");
   
  AddDetail(({"wasser"}),
   "Das ist hier ueberall! Vermutlich schon Grundwasser. Seltsam nur, dass "
   "die ganze Hoehle nicht voll davon ist. Aber sei froh, sonst wuerdest Du "
   "ja keine Luft bekommen.");
   
  AddDetail(({"luft"}),
   "Gluecklich ueber die Tatsache, dass hier nicht alles voll Wasser ist, "
   "nimmst Du einen tiefen Atemzug. Herrlich!");
   
  AddDetail(({"tatsache","atemzug"}),
   "Und gleich noch einen! Hach, schoen!");
   
  AddDetail(({"hoehle"}),
   "Wer hier wohl lebt? Oder, ob hier ueberhaut jemand lebt?");
   
  AddDetail(({"waende","wand"}),
   "Sie sehen dem Boden und der Decke sehr aehnlich.");
   
  AddDetail(({"grundwasser"}),
   "Tja. Du kannst zufrieden sein. Trotz Deiner Ueberlegung, es sei "
   "vollkommen sinnlos nach Grundwasser zu graben, hast Du es getan und "
   "Erfolg gehabt!");
   
  AddDetail(({"ueberlegung"}),
   "Hast Du Dir vorher etwa nicht ueberlegt, was Du da tust?");
   
  AddDetail(({"erfolg"}),
   "Du hast Grundwasser gefunden, das ist der Erfolg! Aber hat es Dir sonst "
   "noch etwas gebracht, ausser dass Du hier in einer kalten, nassen Hoehle "
   "stehst, und nichtmal weisst, wie Du hier - oh! - wie kommst Du hier "
   "wieder raus? Denk nach!");
    
  AddDetail(({"decke"}),
   "Die Decke ist waessrig - schlammig. Sie ist eigenartig geformt.");
   
  AddDetail(({"form","forung"}),
   "An einer Stelle besonders auffallend und sehr niedrig!");
   
  AddDetail(({"stelle"}),
   "Du tastest die Stelle ein wenig ab und kommst auf den Gedanken, Du "
   "koenntest versuchen dort zu graben!");
   
  AddDetail(({"gedanken"}),
   "Jetzt erst faellt Dir auf, dass Du noch keinen Gedanken daran verbraucht "
   "hast, wie Du hier eigentlich wieder rauskommen willst!");

  AddSound( DEFAULT_SOUND,
    "Wassertropfen klatschen im Schlamm auf.");

  AddSound(({"wassertropfen","wasser","schlamm", "tropfen"}),
    "*klatsch* .... *klatsch* .. *klatsch*");
    
  AddSound(({"geraeusch"}),
   "Es ertoent bei jedem Deiner Schritte, unvermeidlich!");
   
  AddSound(({"schritte","schritt"}),
   "Testweise machst Du einen Schritt --- *schmatz*. Es stimmt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Erde.");

  AddSmell(({"erde"}),
    "Riecht wie ... Erde!");
    
  SUID;

  AddItem( NPC "t_drache" , REFRESH_DESTRUCT);
  
  AddCmd("grabe|grab&stelle", "cmd_graben", "Du graebst irgendwo herum.");
  AddCmd(({"denk","denke"}), "cmd_denken");
}

int cmd_graben(string str)
{
  if(!str||str=="") return 0;
  
  if(present("schaufel",TP)) {
  TP->do_exhaust(500+random(100),1);
  TP->Message(BS("Du nimmst Deine Schaufel und graebst an der Stelle herum. "
  "Ein ploetzlicher Sog zieht Dich in die matschige Decke!! Du bekommst "
  "keine Luft, aber zum Glueck wirst Du schon nach wenigen Sekunden wieder "
  "ausgespuckt und kannst tief durchatmen. Trotzdem war das sehr "
  "anstrengend!"));
  ROOM "drachenloch"->Message(BS(TPN+" graebt an der Decke herum und wir "
  "voellig unerwartet von einem starken Sog erfasst und in den Schlamm "
  "gesogen."), MSGFLAG_NO_TP);
  
  TP->move(ROOM "w04", M_GO, "im Schlamm", "verschwindet", "kommt total "
  "erschoepft hinter einem Baum hervor"); 
  return 1; }
  
  else {
  TP->Message(BS("Du graebst mit Deinen Haenden im Schlamm herum und "
  "wirst dabei schmutzig."));
  return -1; }
}

int cmd_denken(string str)
{
  if(!str||str=="") return 0;
  
  if(str=="nach")
  {
    if((TP->QueryAttribute(A_INT)+random(5)-random(10))/15>=2)
    {
      TP->Message(BS("Du strengst Dich irrsinnig an und eine ploetzliche "
      "Vision sagt Dir etwas von einer Form!!"));
      TP->AddSp(-random(35));
      return 1;
    }
    
    else
    {
      TP->Message(BS("Du strengst Dich fuerchterlich an ... Du ueberlegst "
      "und denkst ... Jetzt tut Dein Kopf weh."));
      TP->AddHp(-random(15));
      TP->AddSp(-random(5));
      return -1;
    }
  }
}