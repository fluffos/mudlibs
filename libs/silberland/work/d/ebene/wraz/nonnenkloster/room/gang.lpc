#pragma strong_types

inherit "std/room";

#include "../def.h"

string race_stone();
string falle();
int stat, delay, done, plant_killed, fake_tod;

void ReAddDetails(int DetailsCreate)
{
  if(DetailsCreate==1||done==1) {
  	
  RemoveDetail(({"knick"}));
  RemoveDetail(({"korb"}));
  RemoveDetail(({"erde"}));
  
  RemoveDetail("westen");
  RemoveDetail("westende");
  RemoveDetail("tor");
  
  AddDetail( ({"knick","sued-west-knick"}), // plant
  	"Er formt den Korridor von Norden nach Sueden nach Westen. Dort steht ein "
  	"Korb.");
  
  AddDetail( ({"sueden"}), // plant
  	"Dort macht der Korridor einen Knick nach Westen. Es steht dort ein Korb "
  	"mit Pflanzen.");
  	
  AddDetail( ({"korb"}), // plant
  	"Aus dem Korb, er besteht aus hellgelben Bast, waechst eine Pflanze.");
  	
  AddDetail( ({"pflanze","pflanzen"}), // plant
  	"Es handelt sich offensichtlich um eine Schlingpflanze. Sie waechst aus dem "
  	"Korb heraus und windet sich grazioes an der Wand entlang, ueber das Tor, in "
  	"eine Ecke.");
  	
  AddDetail( ({"ecke","eck"}), // plant
  	"In der Ecke endet die Pflanze, beziehungsweise ihre Aeste.");
  	
  AddDetail( ({"aeste"}), // plant
  	"Oho! An den Aesten sind ja auch Blueten!");
  	
  AddDetail( ({"blueten"}), // plant
  	"Prachtvolle rosafarbene Blueten. Besonders schoen sind sie auf einem Ast.");
  	
  AddDetail( ({"ast"}), // plant
  	"Auf einem Ast sind besonders schoene rosa Blueten.");
  	
  AddDetail( ({"bluete"}), // plant
  	"Viele Blueten sind auf den Aesten in der Ecke.");
  	
  AddDetail( ({"schlingpflanze"}), // plant
  	"Sie hat kleine, knallgruene Blaetter mit kleinen Haerchen darauf. Wie sie "
  	"sich an der Wand haelt ist Dir ein Raetsel.");
  	
  AddDetail( ({"blaetter","haerchen"}), // plant
  	"Kleine, gruene, O-foermige Blaetter mit Haerchen.");
  	
  AddDetail( ({"raetsel"}), // plant
  	"Die ganze Pflanze ist Dir ein Raetsel. Sie hat eine aussergewoehnliche "
  	"Aura.");
  	
  AddDetail( ({"aura"}), // plant
  	"Du vermagst sie nicht genau zu definieren.");
  	
  AddDetail( ({"westen"}), // tor offen
  	"Am Westende ist eine geschlossene Tuer.");
  	
  AddDetail( ({"westende"}), // tor offen
  	"Dort siehst Du eine verschlossene Tuere - nein, eher ein Tor - neben dem "
  	"eine Glasvitrine steht.");
  	
  AddDetail( ({"tor"}), // tor offen
  	"Das Tor ist verschlossen.");
  }
  
  if(done==1) {
 
  done=0;
  TO->SetProp("plant_killed", 0);
  TO->RemoveExit("westen");
  AddSpecialExit("westen", "westen_nur_nonne");
  TO->SetProp(P_HIDE_EXITS, ({"westen"})); }
  
  
  return;
}

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG,
  	"Der Korridor fuehrt von Norden nach Sueden, und macht dort einen Knick "
  	"nach Westen. Er ist nur spaerlich dekoriert. Anscheinend dient er lediglich "
  	"als Verbindung zweier Raeume. Es ist hier ausserdem merklich kuehler als "
  	"im Rest des Klosters.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21+random(2), ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail( ({"kloster"}),
  	 "In dessen Innerem befindest Du Dich.");

  AddDetail( ({"innere", "innere des klosters"}),
  	 "Du befindest dich in einem Korridor im Inneren des klosters");
  	 
