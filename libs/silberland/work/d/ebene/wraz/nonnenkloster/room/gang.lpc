  AddDetail( ({"betrachtung"}),
  	"Es kribbelt.");
  	
  AddDetail( ({"gegenstand"}),
  	"Birne.");
  	
  AddDetail( ({"gefuehl"}),
  	"Ein seltsames Gefuehl...");
  	
  AddDetail( ({"staengel","blatt"}),
  	"Es sieht genauso aus wie auf den Symbolen, nur dass das hier kein Symbol "
  	"ist.");
  	
  AddDetail( ({"symbol"}),
  	"Das Symbol stellt eine Birne dar. Hier in der Glasvitrine jedoch ist eine "
  	"moeglicherweise echte Birne.");
  	
  AddDetail( ({"rest"}),
  	"Im Rest des Klosters ist es merklich waermer als hier.");
  	
  AddDetail( ({"klinke"}),
  	"Das Tor im Westen hat eine grosse Klinke.");
  	
  
  AddSound(DEFAULT_SOUND,
  	"Es ist hier ruhig, aber nicht absolut still. Du hoerst aber auch nichts "
  	"Konkretes.");
  	
  AddSound( ({"konkretes"}),
  	"Hier ist es nicht total still, so dass sich Deine Ohren dumpf anfuehlen. "
  	"Aber Du weisst auch nicht, was Du hoerst. Seltsam.");
  	
  AddSound( ({"ohren"}),
  	"Du kannst nichts Besonderes hoeren.");
  	
  	
  AddSmell(DEFAULT_SMELL,
  	"Es riecht hier. Aber wonach?");
  
  ReAddDetails(1);
  	
  AddExit("norden",ROOM "sing");
  AddSpecialExit("westen", "westen_nur_nonne");
  
  SetProp(P_HIDE_EXITS, ({"westen"}));
  
  AddCmd("oeffne","cmd_open");
  AddCmd("brich|breche|reisse|rupfe|reiss|rupf&bluete|blueten&ast|pflanze",
  "cmd_break",
  	 "Was willst Du abbrechen?|Wovon willst Du das abbrechen?");
  	 
  SUID;
  
  done=0;
  plant_killed=0;
  fake_tod=0;
}

int westen_nur_nonne()
{
  if(getuid(TP) != getuid(TO) && TP->QueryProp(P_UID)!="wraz") return 0;
  return TP->move(ROOM "bedroom",M_GO, "das Tor nach Westen und schliesst es hinter sich",
  "oeffnet",
  "kommt herein und schliesst das Tor");
}

string race_stone()
{
  string race;
  race=TP->QueryProp(P_RACE);
  
  switch (race)
  {
    case "Fee":
    case "Hobbit":
    case "Dunkelelf":
    return BS("Du hast mit Steinen nicht viel am Hut und daher auch absolut keine "
    "Ahnung worum es sich hier handelt.");
    break;
    
    case "Mensch":
    return BS("Trotz Deiner erweiterten geologischen Kenntnisse kannst Du nicht sagen, "
    "worum es sich hier handelt.");
    break;
    
    case "Elf":
    return BS("Gesteinskunde ist doch eher was fuer Zwerge...");
    break;
    
    case "Troll":
    return BS("Du als Troll interessierst Dich nicht wirklich fuer Steine.");
    break;
    
    case "Zwerg":
    return BS("Obwohl Geologie eigentlich genau Dein Fach ist, hast Du "
    "keinen Schimmer, "
    "woraus der Korridor hier gefertigt wurde. Es scheint sich um etwas Magisches "
    "zu handeln.");
    break;
    
    case "Oger":
    return BS("Steine interessieren Dich nicht wirklich. Viel mehr jedoch Essen.");
    break;
    
    default:
    return BS("Du weisst nicht, worum es sich hier handelt.");
    break;
}
}

string falle()
{
  TP->Message(
"[Tod:Lars] Eine Scriptfalle hat gerade "+TPN+" umgebracht.\n"
"[Tod:Eine Scriptfalle] Das hast Du nun davon!!\n"
"\n"
"Dein Koerper gehorcht Dir nicht !\n"
"Dein Koerper gehorcht Dir nicht !\n"
"\n"
"Du kannst einen Mann mit dunkler Kapuze neben Deiner Leiche stehen sehen.\n"
"Er wischt die blutige Klinge einer grausigen Sense mit langsamen, gemessenen\n"
"Bewegungen ab. Ploetzlich hoert er auf und scheint Dich direkt anzusehen mit\n"
"seinen leeren Augenhoehlen ...\n"
"\n"
"Der Tod sagt: KOMM MIT MIR, STERBLICHER!\n");
if(!fake_tod) call_out("fake",4,TP);
fake_tod=1;
return "";
}

void fake(object player)
{
  if(!interactive(player)) return;
  player->Message(BS("HAHAHA jetzt hast Dich aber geschreckt!!! *WAELZLACHBRUELL* ;)"));
  fake_tod=0;
  return;
}

int _query_total_light() {return 1;}

int cmd_open(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(!str||str=="") return 0;
  
  if(str=="tor")
  {
    if(!TO->QueryProp("plant_killed")) {
    	write_file(LOG "gang.log", 
    	dtime()+": "+TPN+" versucht Tor zu oeffnen.\n");
    TP->Message(BS("Als Du versuchst, das Tor neben der Pflanze zu oeffnen, glaubst Du, "
    "dass sich diese kurz bewegt und aufleuchtet. Jedenfalls scheint die Klinke "
    "foermlich fixiert zu sein, denn Du konntest sie trotz groesstem Kraftaufwand "
    "keinen Millimeter nach unten druecken."),MSGFLAG_SENSE);
    return -1; }

    else {
     write_file(LOG "gang.log",
     dtime()+": "+TPN+" oeffnet Tor.\n");
     TO->AddExit("westen",ROOM "bedroom");
     TP->Message(BS("Du oeffnest das Tor nach Westen."));
     TO->Message(BS(TPN+" oeffnet das Tor nach Westen."),MSGFLAG_NO_TP);
     TO->SetProp(P_HIDE_EXITS, 0);
     TO->RemoveDetail("westen");
     TO->RemoveDetail("westende");
     TO->RemoveDetail("tor");
     
     TO->AddDetail("westen",
      "Am Westende ist ein - oho! - ein geoeffnetes Tor!");
     TO->AddDetail("westende",
      "Das Tor dort ist geoeffnet! Neben ihm steht eine Glasvitrine.");
     TO->AddDetail("tor",
      "Das Tor ist - geoeffnet!!");
     return 1;
    }

  }
  return 0;
}

int cmd_break(string str)
{
  if(done==1) { TP->Message(BS("Das wuerdest Du nicht wagen!")); return -1; }
  
  stat=0;
  delay=1;
  write_file(LOG "gang.log",
  dtime()+": "+TPN+" holt Clematis.\n");
  TP->Message(BS("Vorsichtig brichst Du eine Bluete von der Pflanze herunter."),MSGFLAG_SENSE);
  TO->Message(BS(TPN+" bricht eine Bluete von der Pflanze ab."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  
  call_out("plant", 2);
  done=1;
  return 1;
}

/*int pflanze()
{
  TP->Message(BS("Gebannt starrst Du auf die Pflanze!"));
  return 1;
}*/

int plant()
{
  object pflanze;
  stat++;
  switch (stat)
  {
  case 1:
  //TO->RemoveExit(0);
  //TO->AddCmd(({"norden","westen"}),"pflanze");
  TO->Message(BS("Ploetzlich beginnt sich die Pflanze zu bewegen! Ein immer lauter werdendes "
  "Grollen kommt auf!"));
  delay=3;
  break;
  
  case 2:
  TO->Message(BS("Die Pflanze zieht ihre Wurzeln aus dem Korb heraus! Der Boden vibriert!"));
  delay=8;
  break;
  
  case 3:
  TO->Message(BS("Langsam verebbt das Grollen und Vibrieren. Die Pflanze scheint zum Leben "
  "erwacht zu sein! Sie steht nun, sich staendig bewegend, vor Dir."));
  //TO->AddExit("norden", ROOM "sing");
  //TO->RemoveCmd(({"norden","westen"}));
  AddSpecialExit("westen", "westen_nur_nonne");
  pflanze=clone_object(NPC "plant");
  pflanze->move(TO, M_GO, " ", "wird lebendig");
  //->Details Removen bzw Adden
  TO->RemoveDetail(({"sueden"}));
  TO->RemoveDetail(({"knick","sued-west-knick"}));
  TO->RemoveDetail(({"korb"}));
  TO->RemoveDetail(({"pflanze","pflanzen"}));
  TO->RemoveDetail(({"ecke","eck"}));
  TO->RemoveDetail(({"aeste"}));
  TO->RemoveDetail(({"blueten"}));
  TO->RemoveDetail(({"ast"}));
  TO->RemoveDetail(({"bluete"}));
  TO->RemoveDetail(({"schlingpflanze"}));
  TO->RemoveDetail(({"blaetter","haerchen"}));
  TO->RemoveDetail(({"raetsel"}));
  TO->RemoveDetail(({"aura"}));
  TO->AddDetail( ({"knick"}), 
  "Er formt den Korridor von Norden nach Sueden nach Westen. Dort steht ein leerer "
  "Korb.");
  TO->AddDetail( ({"korb"}), 
  "In dem Korb befindet sich ein bisschen durcheinander "
  "geratene Erde. Auch neben dem Korb liegt Erde verstreut.");
  TO->AddDetail( ({"erde"}),
  "Neben und in dem Korb liegt Erde verstreut, als haette man gewaltsam eine Pflanze "
  "aus ihr herausgerissen.");
  //->neue Details in der Pflanze (==NPC) selbst
  break;
  
  default: 
  done=1;
  return 1;
  break;
  }

  call_out("plant", delay);
}

void reset()
{
  ::reset();
  // Details wieder "normalisieren":
  ReAddDetails(0);
}
