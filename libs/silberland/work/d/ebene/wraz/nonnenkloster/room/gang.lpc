  AddDetail( ({"singraum"}),
  	"Er ist im Norden.");
  	
  AddDetail( ({"norden"}),
  	"Im Norden ist eine simple Holztuer.");
  	
  AddDetail( ({"tuer", "tuere"}),
  	"Im Norden ist eine einfache Holztuer, im Westen eher ein Tor.");
  	
  AddDetail( ({"holztuer"}),
