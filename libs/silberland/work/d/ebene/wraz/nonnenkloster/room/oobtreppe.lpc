// Gesellenstück
// Osttreppe im 2. Stock - oobtreppe.c
// Von Wraz / Mendralim
// -> 43 Details, 3 Sounds, 0 Smells, 0 Funktionen
// immer hell

inherit "std/room";

#include "../def.h"
#include <language.h>

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Kloster im Wald");
  SetProp(P_INT_LONG,
    "Das hier ist der obere Stock des Klosters. Du stehst unmittelbar neben dem "
    "Treppenabgang, welcher wieder hinunter fuehrt. Ein Gelaender grenzt den Gang "
    "hier oben von der Kirche, die sich ein Stockwerk tiefer zwischen diesem und "
    "dem Treppenabgang im Westen befindet, ab. Im Suedwesten steht eine grosse Orgel.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24+random(3), ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail("kloster",
   	"Darin befindest Du Dich.");
   	
  AddDetail( ({"treppenabgang", "treppenabgaenge", "treppenaufgang",
  "treppenaufgaenge", "aufgang", "abgang", "aufgaenge", "abgaenge", "treppe"}),
  	 "Das Kloster hat zwei Treppenabgaenge, einen im Osten und einen im Westen. "
  	 "Du bist derzeit im oestlichen.");
  	 
  AddDetail( ({"osten", "westen", "himmelsrichtung", "nordwesten"}),
  	 "Eine schoene Himmelsrichtung.");
  
  AddDetail( ({"stock", "stockwerk", "stockwerke"}),
  	 "Hier im oberen Stock fuehrt ein Gang, welcher einerseits von dem Gelaender, "
  	 "andererseits von einer Wand begrenzt ist, zuerst nach Suedwesten und dann weiter "
  	 "nach Nordwesten zum anderen Abgang.");
  
  AddDetail( ({"gang"}),
  	 "Er ist nach Norden hin von einem Gelaender, nach Sueden von einer Wand begrenzt.");
  	 
  AddDetail( ({"gelaender"}),
  	 "Du blickst ueber das Gelaender hinunter und siehst die Kirche, von der aus Du hier "
  	 "heraufgekommen bist.");
  	 
  AddDetail( ({"kirche"}),
  	 "In der Mitte steht der Altar mit den zwei Pflanzen, zu dem der "
  	 "Teppich zwischen "
  	 "den Holzbaenken fuehrt.");
  	 
  AddDetail( ({"mitte"}),
  	 "Der Altar steht ziemlich in der Mitte der Kirche.");
  	 
  AddDetail( ({"altar", "pflanzen", "teppich", "holzbaenke"}),
  	 "Das kannst Du Dir viel besser ansehen, wenn Du wieder nach unten "
  	 "gehst.");
  	 
  AddDetail( ({"norden"}),
  	 "Noerdlich wird der Gang von einem Gelaender begrenzt, damit man "
  	 "nicht hinunterfallen "
  	 "kann.");
  	 
  AddDetail( ({"wand"}), // bei OSTEN: HIER Tuer im Sueden
  	 "Die Wand im Sueden besteht aus hellgelben Marmor, durch welche eine Tuer fuehrt. "
  	 "Links und rechts neben der Tuer stehen einige kleine "
  	 "Baeume in Toepfen.");
  	 
  AddDetail( ({"waende"}),
  	 "Es ist eigentlich nur eine Wand, und die ist im Sueden.");
  	 
  AddDetail( ({"toepfe", "topf"}),
  	 "Die Baeume wachsen aus Toepfen mit feinster Humuserde.");
  	 
  AddDetail( ({"humuserde", "erde", "humus"}),
  	 "Humus ist die beste Erde.");
  	 
  AddDetail( ({"marmor"}),
  	 "Der Marmor, aus dem die Wand besteht, wurde poliert und spiegelt"
  	 " daher.");
  	 
  AddDetail( ({"sueden"}),
  	 "Suedlich wird der Gang von einer Wand begrenzt. Sie wurde mit Malereien und einem "
  	 "Symbol verziert. Ausserdem ist dort eine Tuer.");
  	 
  AddDetail( ({"tuer"}),
  	 "Sie ist im Sueden. Was sich hinter ihr wohl befindet?");
  	 
  AddDetail( ({"malereien", "malerei"}),
  	 "Sie stellen Elemente der Fauna dar.");
  	 
  AddDetail( ({"fauna", "fachwort", "tierwelt"}),
  	 "Fauna ist das Fachwort fuer Tierwelt.");
  	 
  AddDetail( ({"elemente"}),
  	 "Du siehst Hasen, Rehe, Fuechse, aber auch kleine Nager.");
  	 
  AddDetail( ({"hasen", "rehe", "fuechse", "nager"}),
  	 "Sie sind ein Teil der Fauna.");
  	 
  AddDetail( ({"teil"}),
  	 "Jeder Teil ist wesentlich fuer das Gleichgewicht der Natur!");
  	 
  AddDetail( ({"natur"}),
  	 "Die Nonnen hier scheinen die Natur ueber alles zu verehren.");
  	 
  AddDetail( ({"gleichgewicht"}),
  	 "Fuer die Natur ist es wichtig, dieses zu behalten.");
  	 
  AddDetail( ({"baeume", "baum"}),  // eventuell seitenabhaengig aendern
  	 "Hier stehen vier Birken, etwa zwei Meter hoch, und drei andere "
  	 "Baeume, die etwas kleiner sind.");
  	 
  AddDetail( ({"meter"}),
  	 "Zwei Meter.");
  	 
  AddDetail( ({"birken","birke"}),
  	 "Die Birken und anderen Baeume werden von den Nonnen staendig gepflegt "
  	 "und gegossen. Daher gedeihen "
  	 "sie hier praechtig. Ein wahrer Augenschmaus.");
  	 
  AddDetail( ({"nonnen","nonne"}),
  	 "Die Nonnen respektieren und verehren die Natur.");
  	 
  AddDetail( ({"augenschmaus", "gruen"}),
  	 "Das viele Gruen macht das gesamte Kloster wunderschoen.");
  	 
  AddDetail( ({"symbol"}),
  	 "Das Symbol zeigt eine Birne mit einem Staengel und einem Blatt daran.");
  	 
  AddDetail( ({"birne", "birnensymbol"}),
   	 "Die auf dem Symbol dargestellte Birne hat einen Staengel mit einem Blatt.");
   	 
  AddDetail( ({"staengel", "blatt"}),
  	 "Das gehoert zu dem Symbol mit der Birne.");
  	 
  AddDetail( ({"orgel"}),
  	 "Die grosse, dunkelbraune Orgel steht im Suedwesten. Um sie genauer "
  	 "zu betrachten, solltest Du naeher hingehen.");
  	 
  AddDetail( ({"suedwesten"}),
  	 "Dort steht eine grosse Orgel.");
  	 
  AddDetail( ({"boden"}),
  	 "Er wurde aus polierten Granitbloecken zusammengesetzt.");
  	 
  AddDetail( ({"granit"}),
   	"Daraus bestehen die Bloecke im Boden.");
  	 
  AddDetail( ({"granitbloecke", "bloecke"}),
  	 "Zusammengesetzt bilden sie den Boden.");
  	 
  AddDetail( ({"decke"}),  // uebernommen (leicht geaendert) aus wtreppe bzw otreppe:
  	 "An der vergoldeten Decke erkennst Du reichlich Verzierungen und Schnoerkeleien. "
  	 "Ausserdem wurde ein grosses Fresko in die Decke gearbeitet. Sie befindet sich "
  	 "sehr hoch oben.");
  	 
  AddDetail( ({"gold"}),
   	"Die Decke hier wurde wunderschoen vergoldet.");
  	 
  AddDetail("verzierungen",
  	 "Die Verzierungen schmuecken die Decke und machen sie huebsch.");
  	 
  AddDetail(({"schnoerkeleien","schnoerkelei"}),
  	 "Die Schnoerkeleien erstrecken sich ueber die gesamte Decke und geben ihr ein "
  	 "huebsches Aussehen.");
  	 
  AddDetail("aussehen",
  	 "Sehr huebsch!");
  	 
  AddDetail("fresko",
  	 "Es stellt eine Birne samt Staengel und einem Blatt dar und leuchtet seltsam.");
  	 
  AddDetail("licht",
  	 "Es muesste hier eigentlich komplett dunkel sein, da nirgendwo "
  	 "Fenster in die Waende "
  	 "gebaut sind. Das Licht, welches diesen Raum und die Kirche "
  	 "erhellt, geht eindeutig "
  	 "von dem Fresko an der Decke aus.");
  	 
  AddDetail( ({"fenster"}),
  	 "Du blickst Dich nocheinmal um, findest aber keine.");  // ende
  	 
  	 
  AddSound(DEFAULT_SOUND,
  	 "Du hoerst einen Gesang.");
  	 
  AddSound("gesang",
  	 "Er kommt aus dem Sueden. Hmm, jetzt bist Du Dir nicht mehr so sicher.");
  	 
  AddSound("sueden",
  	 "Vielleicht singen die Nonnen dort? Ob Du nachsehen solltest?");
  	 
  AddSmell(DEFAULT_SMELL,
  	"Es duftet hier erdig.");
  
  AddExit("unten", ROOM "otreppe");
  AddExit("suedwesten", ROOM "orgelraum");
  AddExit("sueden", ROOM "sing");
}

int _query_total_light() {return 1;}