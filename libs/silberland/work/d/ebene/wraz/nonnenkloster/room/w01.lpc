// Gesellenstück
// Raum 1 für Weg - w01.c
// von Wraz / Mendralim
// 39 Details, 1 Sound, 2 Smells, 3 Funktionen + reset()

inherit "std/room";

#include "../def.h"

string scroll();
string heaven();
string insekt();

int weather;

void create()
{ 
  ::create();
  SetProp(P_INT_SHORT, "Ein Weg in der Steppe");
  SetProp(P_INT_LONG, 
  	 "Hier befindest Du Dich auf einem Pfad Richtung Sueden, welcher nur "
  	 "an dem zusammengetretenen Gras zu erkennen ist. Die Vegetation nimmt "
  	 "hier bereits deutlich zu, denn es wachsen hier einige Baeume, Straeucher "
  	 "und andere Pflanzen.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_PLAIN]));
  
  
  AddDetail(({"pfad"}),
  	 "Der schmale Pfad fuehrt in Richtung Sueden weiter.");
  	 
  AddDetail(({"richtung", "sueden"}),
  	 "Du blickst Richtung Sueden und bemerkst, dass dort noch mehr Laubbaeume stehen "
  	 "als hier. Moeglicherweise wird die Baumdichte bei Weiterverfolgen des "
  	 "Pfades irgendwann waldartige Masse annehmen.");
  	 
  AddDetail(({"baum"}),
  	 "Hier steht nicht nur einer.");
  	 
  AddDetail(({"baeume"}),
  	 "Es befinden sich hier ('baeume hier'), Richtung Norden ('baeume richtung "
  	 "norden') und Richtung Sueden Baeume ('baeume richtung sueden').");
  	 
  AddDetail(({"baeume richtung sueden", "baeume sueden", "sueden baeume", }),
  	 "Im Sueden faellt Dir auf, dass dort wesentlich mehr Laubbaeume stehen "
  	 "als hier.");
  	 
  AddDetail(({"laubbaeume", "art", "arten", "baumarten", "baumart"}),
  	 "Du erkennst Pappeln, Ahorne, Kastanien und einige andere Arten, welche "
  	 "Dir fremd sind.");
  	 
  AddDetail(({"pappel", "pappeln", "ahorn", "ahorne"}),
  	 "Eine Baumart, welche hier vorkommt.");
  	 
  AddDetail(({"kastanie", "kastanien"}),
  	 "Eine der Kastanien hat eine sehr voluminoese Baumkrone. "
  	 "Sie imponiert Dir wahrhaftig.");
  	 
  AddDetail(({"blatt", "blaetter", "rinde", "stamm", "aeste", "zweige", "zweig"}),
  	 "Ein Teil eines Baumes.");
  	 
  AddDetail(({"baumkrone"}),
  	 "Jeder Baum besitzt eine. Aber eine spezielle faellt Dir durch ihr Volumen "
  	 "besonders auf, die Baumkrone der Kastanie dort.");
  	 
  AddDetail(({"kastanienbaumkrone", "baumkrone der kastanie", "baumkrone kastanie", "eigenschaft"}),
  	 "Eine sehr _voluminoese Baumkrone_.");
  	 
  AddDetail(({"voluminoese baumkrone"}),
  	 "Die Baumkrone dieser Kastanie ist wirklich aussergewoehnlich gross. Die "
  	 "Blaetter der Kastanie tragen einen wesentlichen Teil dazu bei.");
  	 
  AddDetail(({"volumen", "breite", "hoehe", "laenge"}),
  	 "Volumen = Breite * Hoehe * Laenge");
  	 
  AddDetail(({"blaetter der kastanie", "kastanienblaetter"}),
  	 "Bei naeherer Betrachtung erkennst Du braune Flecken an den Blaettern.");
  	 
  AddDetail(({"betrachtung"}),
  	 "Dabei hast Du etwas erkannt!");
  	 
  AddDetail(({"flecken"}),
  	 "Wie sehen denn die Flecken aus?");
  	 
  AddDetail(({"braune flecken"}), // -> Blatt abreissen
  	 "Um das besser zu erkennen, solltest Du Dir vielleicht ein Blatt "
  	 "irgendwie beschaffen.");
  	 
  AddDetail(({"insekt"}), // Danke an Woody, fuer die Idee ;)
  	 #'insekt);
  	 
  AddDetail(({"baeume in richtung norden", "baeume norden", "norden baeume", 
  	"baeume richtung norden"}),
  	 "Sie sind dort nicht sehr zahlreich, aber Du kannst ja dort hingehen und "
  	 "Dir alles genauer ansehen.");
  	 
  AddDetail(({"baeume hier"}),
  	 "Es befinden sich hier bereits wesentlich mehr als im Norden.");
  	 
  AddDetail(({"baumdichte"}),
  	 "Sie nimmt von Norden her nach Sueden deutlich zu.");
  	 
  AddDetail(({"weiterverfolgen"}),
  	 "Na jetzt kannst Du Dich aber freuen, dass es diese sinnlose Detail wirklich gibt! "
  	 "Gebracht hat es Dir nix, aber vielleicht findest Du woanders etwas sinnvolleres...");
  	 
  AddDetail(({"detail"}),
  	 "Das ganze SilberLand ist voll davon! Ein Horror fuer Anti-Forscher, gell Willi?");
  	 
  AddDetail(({"willi", "projekt"}),
  	 "Tipp mal 'finger willi' und schau Dir sein Projekt an.");
  	 
  AddDetail(({"anti-forscher", "antiforscher", "Anti-Forscher"}),
  	 "Aus!");
  	 
  AddDetail(({"horror"}),
  	 "Wenn Du jetzt auch noch das Wort 'Wort' untersuchst, "
  	 "dann scroll ich Dich zu!!");
  	 
  AddDetail(({"wort"}), #'scroll);
  
  AddDetail(({"masse"}),
  	 "Die werden moeglicherweise bald waldartig.");
  	 
  AddDetail(({"norden"}),
  	 "Dort kannst Du hingehen.");
  	 
  AddDetail(({"teil"}),
  	 "Die Blaetter tragen einen wesentlichen bei.");
  	 
  AddDetail(({"silberland"}),
  	 "Was denkst Du denn wo Du Dich befindest?");
  	 
  AddDetail("gras",
  	 "Das zusammengetretene Gras bildet einen Pfad.");
  	 
  AddDetail("vegetation",
  	 "Die Vegetation besteht hier aus Baeumen, Straeuchern und trockenem, gelben Gras.");
  	 
  AddDetail(({"straeucher", "strauch"}),
  	 "Es befinden sich hier nur einige, wenige, welche noch dazu von der Hitze "
  	 "ziemlich mitgenommen aussehen.");
  	 
  AddDetail("hitze",
  	 "Uff, es ist hier ziemlich warm!");
  	 
  AddDetail("pflanzen",
  	 "Du siehst Baeume, Straeucher und Gras auf dem Boden.");
  	 
  AddDetail("boden",
  	 "Auf ihm erkennst Du trockenes Gras, durch das ein Pfad fuehrt.");
  	 
  AddDetail("himmel", #'heaven);
  
  AddDetail("wolken",
  	 "Schau Dir doch den Himmel an, dann siehst Du, ob welche da sind!");
  	 
  AddDetail("wetter",
  	 "Wenn Wolken am Himmel sind, dann koennte es bald regnen.");
  	 
  AddDetail("nase",
  	"Deine Nase ist schoen!");
  	
  AddDetail("sonne",
  	"Sie ist am Himmel. Ob Du sie sehen kannst oder nicht, haengt von den "
  	"Wolken ab.");
  	
  AddDetail("ohren",
  	"Und sehen kannst Du sie auch nicht :)");
  	 
  	 
  AddSmell(DEFAULT_SMELL,
  	 "Es riecht hier nach trockenem Gras.");
  	 
  AddSmell(({"gras", "steppengras", "geruch"}),
  	 "Der wuerzig-trockene Geruch von Steppengras steigt Dir in die Nase.");
  	 
  	 
  AddSound(DEFAULT_SOUND,
  	 "Der Wind weht leise sausend an Deinen Ohren vorbei.");
  	 
  AddSound("ohren",
  	 "Die hoerst Du nicht.");
  	 
  AddSound("wind",
  	"sssssss!");
  	 
  	 
  AddCmd(({"reisse", "reiss", "rupf", "rupfe"}), "rupfen");
  
  AddExit("norden", "/d/ebene/creative/feldlager/room/a3_a6");
  AddExit("sueden",ROOM "w02");
  
  weather=random(3);
}

int rupfen(string str)
{
  string was, wovon;
  notify_fail("WAS willst Du denn wo_von_ ausrupfen?\n");
  if(!str||str=="") return 0;
  
  if(sscanf(str,"%s von %s", was, wovon) == 2 || str=="kastanienblatt ab")
   {
    if(was == "blatt" &&  wovon == "baum") {
    write(BS("Du musst wenigstens sagen, WELCHES Blatt Du abreissen willst oder WOVON "
    	     "Du es abreissen moechtest."));
    return -1; }
    
    if(member( ({ "blatt","kastanienblatt","geflecktes blatt" }),was)!=-1 &&
       member( ({"baum","kastanienbaum","baum ab","kastanienbaum ab"}),
       wovon)!=-1||
       str=="kastanienblatt ab") {
    write(BS("Du reisst Dir ein Blatt von der Kastanie ab und bemerkst, dass die braunen "
    	     "Flecken von einem Insekt, welches sich im Blatt einnistet, entstehen. "
    	     "Danach laesst Du das Blatt fallen, da es Dich nicht weiter interessiert."));
    say(TP->Name()+" reisst ein Blatt von einem Kastanienbaum ab.\n");
    TP->SetProp("kastanienblatt_wraz",time());
    return 1; }
   }
}

string scroll()
{
  int oft;

  write(BS("Du hast es so gewollt:"));
  
  for(oft=0;oft<TP->QueryProp(P_LEVEL)+random(5);oft++)
  {
    if(oft>130) break;
    write(BS("MUAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA"
    "HAHAHAHAHAHAHA!!!!!"));
  }
  
  return "Nochmal? -> unt wort\n";
}

string heaven()
{
  if(weather==0)
  {
    return BS("Der Himmel ist wunderschoen blau, wirklich prachtvolles Wetter!");
  }
  if(weather==1)
  {
    return BS("Oho, es koennte bald zu regnen beginnen!");
  }
  if(weather==2)
  {
    return BS("Der Himmel ist vollkommen von Wolken bedeckt.");
  }
  else return BS("Oije da hats was! Bitte Wraz informieren.");
}

string insekt()
{
  if(TP->QueryProp("kastanienblatt_wraz")>time()-3600)
  {
    return BS("Du hockst Dich hin und begutachtest das abgerissene Blatt "
      "noch einmal. Das fiese Insekt hat sich wohl in das Blatt eingenistet "
      "und schlemmt sich auf Kosten dieses dort voll, was die braunen "
      "Flecken verursacht. Fies.");
  }
  else return "Sowas siehst Du hier nicht.\n";
}

void reset()
{
  ::reset();
  weather=random(3);
}
