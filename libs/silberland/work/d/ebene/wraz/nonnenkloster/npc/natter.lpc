// Gesellenstück
// Peitschennatter in w04 - natter.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Ahaetulla Prasina");
  SetProp(P_LONG,
    "Die Peitschennatter (wissenschaftlicher Name 'ahaetulla prasina') ist etwa so "
    "lang wie ein durchschnittlicher Zwerg gross. Ihre Haut ist gruen, sie bewegt "
    "sich bevorzugt auf Baeumen fort, wo sie ihre Beute jagt."
  );

  SetProp(P_NAME, "Ahaetulla Prasina");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15,T_RANGE_MAX:50]));
  AddId(({"peitschennatter", "natter", "prasina", "ahaetulla prasina", 
    "schlange", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit ihrem Maul",QueryProp(P_HANDS)[1], ({DT_PIERCE})}));

  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_ALIGN, -30);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist ein Tier und kann nichts tragen.\n" }) );

  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt nach");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({ ROOM "w0" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "w04");
  SetProp(P_MNPC_WAIT, ({ 400, 500, 100 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " zischt ein letztes Mal auf.\n");

  AddInfo(DEFAULT_INFO, "ist ein Tier!\n");

  SetProp(P_SPELLRATE,10);

  AddSpell(8,300,
    "Die Natter schlingt sich um Deinen Kopf und beisst Dir in die Nase.\n",
    "Die Peitschennatter beisst @WEM in die Nase.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
     
  AddSpell(2,400,
    "  Die Ahaetulla Prasina *****VERNICHTET***** Dich mit einem gewaltigen Stich!!!\n",
    "  Die Ahaetulla Prasina *****VERNICHTET***** @WEN mit einem gewaltigen Stich!!!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:0]));

  SetChats(3,
  ({Name(WER, 1)+" faengt eine Eidechse.\n",
    Name(WER, 1)+" schlaengelt sich geschmeidig ueber den Boden.\n",
    Name(WER, 1)+" zischt leise.\n",
    Name(WER, 1)+" zischt.\n",
    Name(WER, 1)+" zischt laut.\n",
    Name(WER, 1)+" zuengelt herum.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" zischt!\n"
   ,Name(WER, 1)+" versucht Dich zu attackieren.\n"
   })
  );

  SUID;
}