// Gesellenstück
// Mutter Natur (oda so) - natur.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

object me=TO;

void create()
{
  if(!is_clone(TO)) return;
  if(getuid(previous_object())!=getuid(find_object(ROOM "bedroom"))) {
  	TO->remove(0);
  	return; }

  ::create();

  create_default_npc(44, 2600+random(500));

  SetProp(P_SHORT, "Eine Gestalt");
  SetProp(P_LONG,
    "Diese Gestalt ist absolut nicht zu beschreiben. Du fuehlst nur, dass sich "
    "naturelle Kraefte in ihr konzentrieren.");

  SetProp(P_NAME, "Gestalt");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  AddId(({"gestalt", "natur", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);

  set_living_name("natur");
  
  SetProp(P_MAX_SP,1000);
  SetProp(P_HANDS,({" mit Wetter",700,({DT_FIRE,DT_COLD,DT_WATER,DT_AIR,
    DT_LIGHTNING,DT_SOUND,DT_BLUDGEON})}));
  SetProp(P_BODY,280);


  SetProp(P_RACE, "Macht");
  SetProp(P_SIZE, 1500);
  SetProp(P_WEIGHT, 300000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,15); // von 77 auf 15, dafuer +200+random(200) lp 
                         // zusaetzlich und neuer spell 500+random(400)

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt nichts!\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      -0.5, DT_COLD:      -0.5, DT_WATER:       -0.5
     , DT_AIR:       -0.5, DT_LIGHTNING: -0.5, DT_EXPLOSION:    0.3
     , DT_SOUND:     -0.8, DT_LIGHT:     -0.5, DT_ELECTRIC:    -0.5
     , DT_ACID:       0.3, DT_POISON:     0.3, DT_TERROR:       0.9
     , DT_HOLY:      -0.3, DT_UNHOLY:     0.5, DT_MAGIC:       -0.5
     , DT_MIND:       0.0, DT_SLASH:     -0.4, DT_BLUDGEON:    -0.4
     , DT_PIERCE:    -0.4, DT_SQUEEZE:   -0.4, DT_WHIP:        -0.4
     , DT_RIP:       -0.4
     ]));

  SetProp(P_MSGIN, "grollt laut tosend herein");
  SetProp(P_MSGOUT, "grollt");
  SetProp(P_MMSGIN, "entsteht mit lautem Knall und Blitzen");
  SetProp(P_MMSGOUT, "entschwindet grollend");

  SetProp(P_DIE_MSG,  " verfluechtigt sich.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MURDER_MSG, "ICH BIN DOCH NUR EIN WINZIGER TEIL ALLENS!!!!");
  SetProp(P_KILL_NAME, "Die Natur");
  SetProp(P_KILL_MSG, "DIE NATUR IST UNBESIEGBAR!");

  AddInfo(DEFAULT_INFO, "grollt.\n");

  SetProp(P_SPELLRATE,45);

  AddSpell(8,1000,
    "Blitze schiessen auf Dich herab!\n",
    "@WER wird von Blitzen getroffen!!\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:0]));
     
  AddSpell(1,2500,
    "Ein gewaltiger Knall erschreckt Dich!!\n",
    "Ein gewaltig lauter Knall reisst @WEN fast zu Boden!! Deine Ohren sausen!\n",
     DT_SOUND,"taub",([SP_SHOW_DAMAGE:0]));
     
  AddSpell(3,1300,
    "Schnee schiesst auf Dich herab!\n",
    "@WER wird von Schnee beschossen!!\n",
     DT_COLD,([SP_SHOW_DAMAGE:0]));
     
  AddSpell(5,1000,
    "Du wirst von einem heftigen Windstoss erfasst!\n",
    "@WER wird von einer heftigen Windhose geschleudert!\n",
     DT_AIR,([SP_SHOW_DAMAGE:0]));
     
   AddSpell(2,1,
    "Die Gestalt wird von einer ungeheuren Macht beschleunigt!\n",
    "Die Gestalt wird von einer ungeheuren Macht beschleunigt!\n",
    DT_MAGIC,"get_fast",([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(5, 300, DS_FROG,
    "Du quakst laut!\n",
    "@WER wird ein Frosch!\n");
    
  AddDefaultSpell(4,500+random(500), DS_MASS_DAMAGE,
    "Ploetzlich spritzt heisse Lava durch den Raum!\n",
    "Ploetzlich spritzt heisse Lava durch den Raum und trifft @WEN!\n",
    DT_FIRE,([SP_SHOW_DAMAGE:1]));
    
  AddDefaultSpell(4,500+random(400), DS_MASS_DAMAGE,
    "Auf einmal wuetet ein wilder Schneesturm!\n",
    "Auf einmal wuetet ein wilder Schneesturm!\n",
    DT_COLD,([SP_SHOW_DAMAGE:0]));

  SetChats(3,
  ({"Die Gestalt tost laut!\n",
    "Ein Blitz schlaegt in der Naehe ein!\n",
    "Es donnert!!\n",
    "Huch!?! Hat es gerade geregnet?\n",
    "DU SPUERST EINE UEBERNATUERLICHE EINGABE IN DEINEM GEHIRN: VERSCHWINDE!!!!\n"
   }));

  SetAttackChats(10,
  ({"Lautes Tosen geht von der Gestalt aus!\n",
    "Die Gestalt leuchtet grell auf!\n",
    "Ein starker Wind komm auf!\n"
   }));

  SUID;
}

  void taub(object enemy,int damage,mixed dam_type)
  {
   enemy->SetProp(P_DEAF,1800);
  }
  
void get_fast(object enemy, int damage, mixed dam_type)
{
  me->ModifySkillAttribute(TO,SA_SPEED,175+random(60),3+random(5));
}

void die(int poisondeath)
{
  object ob;
  int counter;
  
  switch(random(2))
  {
    case 0:
     "/obj/gemmaster"->DistributeGem(15, 15, 1, me);
     break;
     
    default:
     for(counter=1+random(6);counter>0;counter--)
     {
       ob=clone_object("/p/std/skills/sewing_tanning/obj/magieseide");
       ob->move(TO,M_GET);
     }
     break;
   }
  
  write_file(LOG "plant+natur.kills",
    dtime()+": "+TP->QueryProp(P_UID)+" ("+TPN+") killt Natur.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "plant&natur.deads",
      dtime()+": Natur killt "+player->QueryProp(P_UID)+". XP:"+lostexp+"\n");
  }
}

void init()
{
  ::init();
  
  if(TP && TP->id("\nangroxistunserheld"))
  {
    ::init();
    ROOM "bedroom"->Message(BS("Die Gestalt loest sich auf."));
    me->remove(1);
  }
}