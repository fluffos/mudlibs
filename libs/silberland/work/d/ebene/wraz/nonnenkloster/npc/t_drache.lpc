// Drache in drachenloch.c - t_drache
// von Wraz / Mendralim

#include "../def.h"

inherit "p/std/dragons/dragon";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  create_default_dragon(4,9,2,29+random(10));
  
  SetProp(P_SHORT, "Hvgftryxc Trfgftr, der rubinrote "
    "Ihmksladtbienfddh Drache");
  SetProp(P_LONG,
    "Hvgftryxc Trfgftr ist ein uralter, erfahrener Drache. Er ist niemandem "
    "boese gesinnt, jedoch wird er sich sicherlich verteidigen, wenn es um "
    "sein Leben geht. Seine rot schimmernde Schuppenhaut ist stellenweise "
    "seltsam weiss mit schwarzen Linien, welche an Runen oder Zahlen "
    "beziehungsweise Buchstaben erinnern. Irgendwas verleiht ihm ein "
    "kubisches Aussehen, Du weisst auch nicht, wie Du darauf kommst.");
    
  AddDetail( ({"leben"}),
   "Solltest Du es wagen, Hvgftryxc Trfgftrs Leben zu bedrohen, wird er "
   "bestimmt hart mit Dir sein, und in seiner Wut auch alle anderen in "
   "seiner Umgebung nicht verschonen.");
   
  AddDetail( ({"wut","umgebung"}),
   "In seiner Wut wird der Drache alles nierdermetzeln, was ihm in den Weg "
   "kommt.");
   
  AddDetail( ({"schuppenhaut","schuppen","haut"}),
   "Die rot schimmernde Schuppenhaut Trfgftrs ist stellenweise seltsam weiss "
   "mit schwarzen Linien. Diese erinnern an Buchstaben oder Zahlen oder "
   "vielleicht Runen?");
   
  AddDetail( ({"buchstaben","runen","zahlen"}),
   "Sehen sehr seltsam aus...");
   
  AddDetail( ({"aussehen","kubisches aussehen"}),
   "Irgendwie sieht der Drache Deiner Meinung nach kubisch aus. Du weisst "
   "nicht, wieso Du das denkst oder wie Du darauf kommst, aber Du denkst "
   "es halt. Komisch.");

  SetProp(P_NAME, "Hvgftryxc Trfgftr");
  SetProp(P_GENDER, MALE);
  AddId(({"hvgftryxc trfgftr", "trfgftr", "drache",
  	"ihmksladtbienfddh drache", "rubindrache"}));
  AddAdjective( ({"rubinrot","rubinroter","rubinrote"}) );
  SetProp(P_ARTICLE, 0);
  set_living_name("trfgftr");
  
  AddDefaultSpell(7,895,DS_MASS_DAMAGE,
   "Hvgftryxc Trfgftr stampft mit einem Fuss auf und schleudert Schlamm "
   "durch den ganzen Raum!\n",
   "Ein riesiger Batzen Schlamm trifft @WEN!\n",
   DT_BLUDGEON);
   
  AddDefaultSpell(3,590,DS_POISON,
   "Hvgftryxc Trfgftr schleudert Matsch durch die Hoehle und ein Klumpen "
   "schiesst genau in Deinen Mund!\n",
   "Hvgftryxc Trfgftr schiesst @WEM Schlamm ins Gesicht!\n",
   1+random(2));
  
  AddDefaultSpell(1,1,DS_FROG,
   "Der Rubindrache funkelt Dich mit seinen Augen bedrohlich an!\n",
   "Der Rubindrache funkelt @WEN mit seinen Augen an!\n");
   
   SUID;
}

void die(int poisondeath)
{
  write_file(LOG "t_drache.deads", dtime()+"; "+TP->QueryProp(P_UID)+
  " killt.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  ::NotifyPlayerDeath();
  if(killer == TO)
  {
    write_file(LOG "t_drache.kills",dtime()+"; "+player->QueryProp(P_UID)+
    " stirbt.\n");
  }
}