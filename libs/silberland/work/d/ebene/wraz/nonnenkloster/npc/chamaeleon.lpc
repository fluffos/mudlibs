// Gesellenstück
// Chamaeleon in w02 - chamaeleon.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/npc";

string color;
string hautfarbe();

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  
  color="gruen";

  SetProp(P_SHORT, "Ein "+color+"es Chamaeleon");
  SetProp(P_LONG,
    "Das Chamaeleon ist ein eigenartiges, etwa einen halben Zwerg langes und einige "
    "handbreit hohes Tier. Es bewegt seine beiden Augen unabhaengig voneinander "
    "und veraendert von Zeit zu Zeit seine Hautfarbe. Momentan ist es "+
    color+". Generell ist es eher traege "
    "und sitzt nur auf einem Ast herum, waehrend es mit seiner langen, klebrigen "
    "Zunge Insekten faengt.");
    
  SetProp(P_NAME_ADJ, ({color}));
  AddAdjective( ({color+"e",color+"es",color+"er",color+"em",color+"en"}) );
  
  AddSpecialDetail(({"hautfarbe","farbe"}),"hautfarbe");
   
  AddDetail(({"augen","glubschaugen"}),
   "Dieses seltsame Tier ist in der Lage, seine zwei Augen vollkommen "
   "unabhaengig voneinander zu bewegen.");

  SetProp(P_NAME, "Chamaeleon");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20,T_RANGE_MAX:50]));
  AddId(({"chamaeleon", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(5);

  SetProp(P_HANDS, ({" mit seiner klebrigen Zunge",QueryProp(P_HANDS)[1], ({DT_BLUDGEON})}));

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann nichts tragen.\n" }) );

  SetProp(P_MSGIN, "bewegt sich langsam herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot vom Ast.\n");

  AddInfo(DEFAULT_INFO, "ist ein Tier und kann Dich nicht verstehen.\n");

  SetChats(4,
  ({"@@farbe@@",
    "@@glubschen@@",
    "@@kriechen@@"}));
   
   SUID;
}

string farbe()
{
  RemoveAdjective( ({color+"e",color+"es",color+"er",color+"em",color+"en"}) );
  
  switch(random(17))
  {
    case 0: color="rot"; break;
    case 1: color="kastanienbraun"; break;
    case 2: color="rubinrot"; break;
    case 3: color="sandweiss"; break;
    case 4: color="meerblau"; break;
    case 5: color="smaragdgruen"; break;
    case 6: color="moosgruen"; break;
    case 7: color="eisgrau"; break;
    case 8: color="feuerrot"; break;
    case 9: color="schneeweiss"; break;
    case 10: color="schweinchenrosa"; break; // ;)
    case 11: color="holzbraun"; break;
    case 12: color="nachtschwarz"; break;
    case 13: color="tiefschwarz"; break;
    case 14: color="schwarzbraun"; break;
    case 15: color="aschgrau"; break;
    default: color="blutrot"; break;
  }
  
  AddAdjective( ({color+"e",color+"es",color+"er",color+"em",color+"en"}) );
  SetProp(P_NAME_ADJ, ({color}));
   
  return "Das Chamaeleon aendert seine Tarnfarbe.\n";
}

string hautfarbe()
{
  return BS("Das Chamaeleon aendert staendig die Farbe seiner Haut. Derzeit "
   "ist es "+color+".");
}

string glubschen()
{
  return Name(WER, 1)+" glubscht durch die Gegend.\n";
}

string kriechen()
{
  return Name(WER, 1)+" kriecht auf seinem Ast herum.\n";
}

string _query_short()
{
  return
    "Ein "+color+"es Chamaeleon";
}

string _query_long()
{
  return 
    BS("Das Chamaeleon ist ein eigenartiges, etwa einen halben Zwerg langes und einige "
    "handbreit hohes Tier. Es bewegt seine beiden Augen unabhaengig voneinander "
    "und veraendert von Zeit zu Zeit seine Hautfarbe. Momentan ist es "+
    color+". Generell ist es eher traege "
    "und sitzt nur auf einem Ast herum, waehrend es mit seiner langen, klebrigen "
    "Zunge Insekten faengt.\n");
}

