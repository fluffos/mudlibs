#include "../def.h"

inherit "std/npc";
//inherit "std/mnpc";
inherit "/std/npc/spells";

int money_amount;
object me=TO;

int sell(string ding)
{
  return command("nimm "+ding+" aus beutel");
}

int money(object player, int mon)
{
  money_amount=mon;
  return player->AddMoney(-money_amount);
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Vasileios Kazantzakis der Suedlaender");
  SetProp(P_LONG,
    "Vasileios Kazantzakis ist ein typischer Suedlaender mittleren Alters. "
    "Sein etwas laengeres Haar ist weissgrau, sein Gesicht, braun gebrannt "
    "von der Strandsonne, durchzogen von einigen Falten und "
    "geschmueckt mit einem netten Grinsemund. Er hat wurstige Finger "
    "an grossen Haenden und kraeftigen Armen, ebenso kraeftige Beine. "
    "Insgesamt macht er einen sehr athletischen Eindruck, trotz seines "
    "fortgeschrittenen Alters. Er spricht einen seltsamen Akzent.");

  SetProp(P_NAME, "Vasileios Kazantzakis");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15,T_RANGE_MAX:50]));
  AddId(({"vasileios", "kazantzakis", "vasileios kazantzakis", "suedlaender"}));
  SetProp(P_ARTICLE, 0);

  set_living_name("kazantzakis");

  create_default_npc(32);

  SetProp(P_HANDS, ({" mit seinen geballten Faeusten"
                    ,450
                    , ({DT_BLUDGEON})}));

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 182);
  SetProp(P_WEIGHT, 82427);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 50);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" bedankt sich bei Dir.\n" }) );

  SetProp(P_LOG_INFO, "kazantzakis");

  SetProp(P_MSGIN, "troedelt froehlich herein");
  SetProp(P_MSGOUT, "schlendert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//SetProp(P_MNPC_AREA, ({  ROOM }) );
//SetProp(P_MNPC_DEFAULTROOM, ROOM "");
//SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
//SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  //SetProp(P_MURDER_MSG, "Ich komme wieder!");
  //SetProp(P_KILL_NAME, "Killer-NPC");
  //SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, ({ "grinst: Jaja! Das denke ich auch jeden Tag..."
  	" in der Frieh, wenn ich aufste-ch-he!\n",
  	"schaut Dich nur verdutzt an.\n",
  	"frag: Was meinst Du?\n",
  	"sagt: Wie bitte?\n",
  	"kratzt sich nachdenklich am Kopf.\n",
  	"sagt: I-ch- nix Deitsch!\n"}));
  	
  AddInfo("wraz", "Der hat ja keine -Ch-ahnung!","sagt: ");

  AddInfo( ({"suedland"}),
    "Von dort komme ich -ch-er! Super -Ch-oliven, beeeste Wein!",
    "schwaermt: ");
    
  AddInfo( ({"wein","rotwein"}),
    "Den -Ch-rotwein musst Du gleich -ch-ier trinken, ich brauche die "
    "Flasche -ch-wieder!");
    
  AddInfo( ({"kugelfisch","fisch"}),
    "-Ch-ugelfisch ist delikat! Aber manchmal giftig, seeeeeehr giftig! "
    "Wenn Pech, dann bringt Dich -ch-um! Aber kommt selten vor! Du -ch-annst "
    "ihn mit-ch-nehmen!");

  SetProp(P_SPELLRATE,34);

  AddSpell(5,500,
    "Vasileios Kazantzakis verpasst Dir einen Kinnhaken.\n",
    "Vasileios Kazantzakis verpasst @WEM einen Kinnhaken.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 650,
    "Vasileios Kazantzakis schlaegt Dir die Nase blutig!\n",
    "Vasileios Kazantzakis schlaegt @WEM die Nase blutig!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
    
  AddSpell(8,470,
    "Vasileios Kazantzakis gibt Dir eine kraeftige Linke!\n",
    "Vasileios Kazantzakis gibt @WEM eine kraeftige Linke!!\n.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(3,
  ({Name(WER, 1)+" SCHREIT: CHELAS!!\n",
    Name(WER, 1)+" sagt: Chelas!\n",
    Name(WER, 1)+" verkostet einen seiner Weine.\n",
    Name(WER, 1)+" verzehrt schmatzend ein paar Oliven.\n"
   }));

  SetAttackChats(10,
  ({"Vasileios Kazantzakis schreit: Lass mi-ch- in Frieden!\n",
    "Vasileios Kazantzakis schreit: WAS -CH-AB ICH DIR -CH-ETAN?.\n"
   }));

  SUID;
  
  CLONEME("/d/gebirge/eros/obj/beutel");
  
  CLONEME(OBJ "kugelfisch");
  CLONEME(OBJ "kugelfisch");
  CLONEME(OBJ "kugelfisch");
  CLONEME(OBJ "kugelfisch");
  
  //CLONEME(ARMOUR "" );
  //command("trage alles");
  
  command("stecke kugelfisch in beutel");
  command("stecke kugelfisch in beutel");
  command("stecke kugelfisch in beutel");
  command("stecke kugelfisch in beutel");
  
  AddCmd( ({"kaufe","kauf"}), "cmd_kaufen");
}

int cmd_kaufen(string str)
{
  if(!str||str=="") return 0;
  
  notify_fail("");
  
  str=lower_case(str);
  
  switch (str)
  {
    case "kugelfisch": // -------- KUGELFISCH -------------------------------
    TP->Message(BS(
      "Vasileios Kazantzakis sagt: 'Aah! Du -ch-wollen Chugelfisch -ch-aben? "
      "Gut, aber pass -ch-auf! Wenn Du Pech -ch-ast ist er giftig, und das "
      "bringt Dich -ch-um!'"));
      
    if(!sell("kugelfisch"))
    {
      TP->Message(BS(
       "Ach! Verdammt! -Ch-abe keine -Ch-ugelfisch mehr, komm spaeter "
       "chwieder!'"));
      return -1;
    }
    
    else if(money(TP,89)==2)
    {
      TP->Message(BS(
       "Vasileios Kazantzakis fragt: 'Und wie ch-willst Du bezahlen?'"));
       command("stecke kugelfisch in beutel");
       return -1;
    }
    
    else {
      TP->Message(BS("Du gibst Vasileios "+money_amount+" Muenzen."));
      TP->Message(BS("Vasileios Kazantzakis sagt: '-Ch-ier chast Du!'"));
      command("gib "+lower_case(TPN)+" kugelfisch");
      return 1; }
      
    break;
    
    case "wein": // ----------- ROTWEIN -------------------------------------
    case "rotwein":
    
    if(money(TP,109)==2)
    {
      TP->Message(BS(
       "Vasileios Kazantzakis fragt: 'Und wie ch-willst Du bezahlen?'"));
       command("stecke kugelfisch in beutel");
       return -1;
    }
    
    else if(!TP->drink_drink(20,10,0)) return -1;
    
    else {
      TP->Message(
       "Du gibst Vasileios "+money_amount+" Muenzen.\n"
       "Vasileios Kazantzakis sagt: 'Chier -ch-ast Du!'\n"
       "Du leerst die Flasche in einem Zug und gibst sie Vasileios "
       "wieder zurueck.\n");
      ENV(me)->Message(BS(
       TPN+" leert eine Flasche Rotwein in einem Zug."),MSGFLAG_NO_TP);
       TP->AddHp(40);
       TP->AddSP(10);
      return 1; }
    
    default: // -------------- DEFAULT --------------------------------------
    TP->Message(BS(
      "Vasileios Kazantzakis meint: Sowas -ch-abe ich nicht!"));
      break;
   }
return 0;
}

void die(int poisondeath) // --- VOID DIE -----------------------------------
{
  write_file(LOG "kazantzakis_deads",
    dtime()+" "+TP->QueryProp(P_UID)+" ("+TPN+") killt Kazantzakis.\n");

  ::die(poisondeath);
}

// --- VOID NOTIFYPLAYERDEATH -----------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
    write_file(LOG "kazantzakis_kills",
      dtime()+": Kazantzakis kills "+player->QueryProp(P_UID)+"\n");
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "kratzt sich nachdenklich am Kopf.",
        "kratzt sich nachdenklich am Kopf.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt Dich an: Was Du -ch-wollen!?!",
        "grummelt "+TPN+" an: Was Du -ch-wollen!?!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "LAAAHAAACHT LAUT!",
        "LAAAHAAACHT LAUT!");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Lass das!",
        "sagt: Lass das!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grummelt: -CH-E!",
        "grummelt: -CH-E!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "sagt: Uff!",
        "sagt: Uff!");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "bruellt: -CH-E! DU DRECK-CH-SAU!!",
        "bruellt: -CH-E! DU DRECK-CH-SAU!!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "kihichert.",
        "kihichert.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "nickt.",
        "nickt.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "schnieft.",
        "schnieft.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, "Vasileios Kazantzakis "+macher+"\n");
  tell_room(ENV(TO), "Vasileios Kazantzakis "+andere+"\n", ({pl}) );
}