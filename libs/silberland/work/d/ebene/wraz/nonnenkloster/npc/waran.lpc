// Gesellenstück
// Komodo-Waran beim Weg - waran.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Komodo-Waran");
  SetProp(P_LONG,
    "Der Komodo-Waran ist die groesste existierende Echse. Trotzdem bewegt er sich "
    "erstaunlich "
    "schnell fort. Die scharfen Klauen an seinen kraeftigen Beinen sind eine nicht "
    "zu unterschaetzende Waffe.");
    
  AddDetail("klaue",
   "Der Komodo-Waran hat maechtige Klauen an seinen Beinen.");
   
  AddDetail("klauen",
   "Die Echse hat an jedem seiner vier Beine eine sehr scharfe Klaue.");
   
  AddDetail("bein",
   "Der Komodo-Waran bewegt sich kriechend auf vier kraeftigen Beinen fort.");
   
  AddDetail("beine",
   "Die vier Beine des Warans fuehren die Klauen im Kampf, und machen ihn so "
   "zu einem gefaehrlichen Gegner.");
   
  AddDetail("waffe",
   "Wenn noetig so verwendet der Komodo-Waran seine Klauen bestimmt als eine "
   "nicht zu unterschaetzende Waffe!");

  SetProp(P_NAME, "Komodo-Waran");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20,T_RANGE_MAX:50]));
  AddId(({"waran", "komodo-waran", "echse"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit scharfen Klauen",QueryProp(P_HANDS)[1], ({DT_RIP}) }));

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 50);
  // 50 cm vom boden hinauf :)
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, -20);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WIMPY, 40);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann nichts tragen.\n" }) );

  SetProp(P_MSGIN, "kriecht flink herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({ ROOM "w0" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "w03");
  SetProp(P_MNPC_WAIT, ({ 200, 300, 100 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " stirbt.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  
  SetProp(P_SPELLRATE,50);

  AddSpell(8,200,
    "  Der Komodo-Waran reisst Dir eine tiefe Wunde in den Bauch.\n",
    "Der Komodo-Waran reisst @WEM eine Wunde in den Bauch.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 350+random(100),
    "Eine schnelle Attacke des Warans ueberrascht Dich!\n",
    "@WER wird von einer blitzschnellen Attacke des Warans hart getroffen!\n",
    DT_SLASH,([SP_SHOW_DAMAGE:0]));

  SetChats(2,
  ({Name(WER, 1)+" kriecht um Dich herum.\n"
   ,Name(WER, 1)+" schaut aufmerksam.\n"
   }));

  SUID;
}