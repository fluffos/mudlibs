    AddInfo(DEFAULT_INFO, "blickt Dich nur grinsend an.\n");
   break;
   default:
    AddInfo(DEFAULT_INFO, "grinst Dir zu.\n");
   break;
  }
  AddInfo(({"natur","mutter"}), "Die Natur ist wunderbar!","sagt: ");
  AddInfo(({"birnensymbol","symbol","birne","markenzeichen"}),
