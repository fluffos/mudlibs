// Gesellenstueck
// Nonne - nun.c
// Von Wraz / Mendralim

inherit "std/mnpc";

#include "../def.h"
#include <mnpc.h>

string *name, *nun_hunter=({""}), player_name="";
object nun=TO, *find_nuns;
int i, arc, si, singing, type;

/* type:
  0: magic : standard
  1: feuer : -0.2 feuer, +0.1 eis, +0.4 wasser (abweichungen von standartwerten)
  2: cold  : -0.2 eis, -0.1 wasser, +0.4 feuer (w.o.)
  3: water : -0.2 wasser, -0.1 eis, +0.4 feuer (w.o.)
  4: sound, lightning, light, electric
           : -0.2 laerm, -0.2 elektro, -0.2 licht, -0.2 blitz, +0.1 wasser,
             -0.1 luft
*/

void aye()
{
  string names;
  string *ar_names;
  int rand, o, nuns;
  
  find_nuns=find_livings("\nnuns_by_wraz");
  names=read_file(NPC "nun_names_small");
  ar_names=explode(names, "\n");

  rand=random(sizeof(ar_names)); // zufallszahl, liegt innerhalb der zahl der
  				 // namen im file
  names=ar_names[rand];		 // string wird zufallsname
  names=capitalize(names);
  name=({ar_names[rand],names});

  nuns=sizeof(find_nuns);
  //write_file(NPC "namen", "jo des geht, nuns: "+nuns+"\n");
  
  for(o=0; o<nuns; o++) // Pruefen, ob eine Nonne schon so heisst!
  {
    //write_file(NPC "namen","name: "+
    //find_nuns[o]->QueryProp(P_NAME)+"\n");
    if(find_nuns[o]->QueryProp(P_NAME)==
    	"Schwester "+name[1])
    {
      names=read_file(NPC "nun_names_small");
      ar_names=explode(names, "\n");
  
      rand=random(sizeof(ar_names)-1); // zufallszahl, liegt innerhalb der
        			       // zahl der namen im file
      names=ar_names[rand];	       // string wird zufallsname
      names=capitalize(names);
      name=({name[0]+" "+ar_names[rand],name[1]+" "+names});
    }
  }
}

void create() 
{
  if(!is_clone(TO)) return;
  if(getuid(previous_object())!=getuid(find_object(ROOM "bedroom"))) {
  	TO->remove(0);
  	return; } // notwendig, weil ../bedroom alle nonnen im spiel zaehlt
  ::create();

  aye();
  
  SetProp(P_SHORT, "Schwester "+name[1]);
  SetProp(P_LONG,
    "Die Nonne geht gemaechlich durch die Gegend, streichelt dabei Blaetter "
    "der hier "
    "stehenden Pflanzen und grinst froehlich. Sie heisst "+name[1]+".");
  SetProp(P_NAME, "Schwester "+name[1]);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15,T_RANGE_MAX:40]));
  AddId(({"nonne", name[0], "schwester", "NOWIMPY", "\nangroxistunserheld"}));
  set_living_name("\nnuns_by_wraz");

  create_default_npc(28+random(6));
  
  SetProp(P_XP, 5 * QueryProp(P_XP) / 4);
  
  switch(random(5))
  {
    case 0:
     SetProp(P_HANDS, ({" mit Naturkraeften",
     (QueryProp(P_LEVEL)-10)*10+random(50),
     DT_MAGIC}));
     type=0;
     break;
    case 1:
     SetProp(P_HANDS, ({" mit feurigen Naturkraeften",
     (QueryProp(P_LEVEL)-10)*10+random(50),
     DT_FIRE}));
     type=1;
     break;
    case 2:
     SetProp(P_HANDS, ({" mit der Gewalt des Winters",
     (QueryProp(P_LEVEL)-10)*10+random(50),
     DT_COLD}));
     type=2;
     break;
    case 3:
     SetProp(P_HANDS, ({" mit der Naturkraft des Meeres",
     (QueryProp(P_LEVEL)-10)*10+random(50),
     DT_WATER}));
     type=3;
     break;
    default:
     SetProp(P_HANDS, ({" mit Blitz und Donner",
     (QueryProp(P_LEVEL)-10)*10+random(50),
     ({DT_SOUND,DT_LIGHTNING,DT_LIGHT,DT_ELECTRIC}) }));
     type=4;
     break;
  }
  // Magie deshalb, weil die Nonnen ja auch mit Naturkraeften angreifen, nicht
  // mit ihren Haenden (ich stell mir eine Nonne mit Haenden herschlagend sehr
  // strange vor ;)
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 140+random(41));
  SetProp(P_WEIGHT, 60000+random(12000));
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  
  switch (type)
  {
    case 0:
     SetProp(P_RESISTANCE_STRENGTHS , 
       ([DT_FIRE:     -0.3, DT_COLD:  -0.3, DT_WATER:  -0.3, DT_AIR:    -0.5, 
         DT_EXPLOSION: 0.4, DT_SOUND:  0.2, DT_LIGHT:  -0.2, DT_ACID:    0.2, 
         DT_POISON:    0.2, DT_TERROR: 0.5, DT_HOLY:   -1.0, DT_UNHOLY:  0.5, 
         DT_MIND:     -0.3, DT_SLASH:  0.2, DT_BLUDGEON:0.1, DT_PIERCE:  0.2,
         DT_RIP:       0.2, DT_WHIP:   0.2, DT_SQUEEZE: 0.1]) );
    break;
    
    case 1:
    SetProp(P_RESISTANCE_STRENGTHS , 
       ([DT_FIRE:     -0.5, DT_COLD:  -0.2, DT_WATER:   0.1, DT_AIR:    -0.5, 
         DT_EXPLOSION: 0.4, DT_SOUND:  0.2, DT_LIGHT:  -0.2, DT_ACID:    0.2, 
         DT_POISON:    0.2, DT_TERROR: 0.5, DT_HOLY:   -1.0, DT_UNHOLY:  0.5, 
         DT_MIND:     -0.3, DT_SLASH:  0.2, DT_BLUDGEON:0.1, DT_PIERCE:  0.2,
         DT_RIP:       0.2, DT_WHIP:   0.2, DT_SQUEEZE: 0.1]) );
    break;
    
    case 2:
      SetProp(P_RESISTANCE_STRENGTHS , 
       ([DT_FIRE:      0.1, DT_COLD:  -0.5, DT_WATER:  -0.4, DT_AIR:    -0.5, 
         DT_EXPLOSION: 0.4, DT_SOUND:  0.2, DT_LIGHT:  -0.2, DT_ACID:    0.2, 
         DT_POISON:    0.2, DT_TERROR: 0.5, DT_HOLY:   -1.0, DT_UNHOLY:  0.5, 
         DT_MIND:     -0.3, DT_SLASH:  0.2, DT_BLUDGEON:0.1, DT_PIERCE:  0.2,
         DT_RIP:       0.2, DT_WHIP:   0.2, DT_SQUEEZE: 0.1]) );
    break;
    
    case 3:
      SetProp(P_RESISTANCE_STRENGTHS , 
       ([DT_FIRE:      0.1, DT_COLD:  -0.4, DT_WATER:  -0.5, DT_AIR:    -0.5, 
         DT_EXPLOSION: 0.4, DT_SOUND:  0.2, DT_LIGHT:  -0.2, DT_ACID:    0.2, 
         DT_POISON:    0.2, DT_TERROR: 0.5, DT_HOLY:   -1.0, DT_UNHOLY:  0.5, 
         DT_MIND:     -0.3, DT_SLASH:  0.2, DT_BLUDGEON:0.1, DT_PIERCE:  0.2,
         DT_RIP:       0.2, DT_WHIP:   0.2, DT_SQUEEZE: 0.1]) );
    break;
    
    case 4:
      SetProp(P_RESISTANCE_STRENGTHS , 
       ([DT_FIRE:     -0.3, DT_COLD:  -0.3, DT_WATER:  -0.3, DT_AIR:    -0.6, 
         DT_EXPLOSION: 0.4, DT_SOUND:  0.0, DT_LIGHT:  -0.4, DT_ACID:    0.2, 
         DT_POISON:    0.2, DT_TERROR: 0.5, DT_HOLY:   -1.0, DT_UNHOLY:  0.5, 
         DT_MIND:     -0.3, DT_SLASH:  0.2, DT_BLUDGEON:0.1, DT_PIERCE:  0.2,
         DT_RIP:       0.2, DT_WHIP:   0.2, DT_SQUEEZE: 0.1, 
         DT_LIGHTNING:-0.2, DT_ELECTRIC:-0.2,]) );
     break;
     
     default:
       SetProp(P_RESISTANCE_STRENGTHS , 
       ([DT_FIRE:     -0.3, DT_COLD:  -0.3, DT_WATER:  -0.2, DT_AIR:    -0.5, 
         DT_EXPLOSION: 0.4, DT_SOUND:  0.2, DT_LIGHT:  -0.2, DT_ACID:    0.2, 
         DT_POISON:    0.2, DT_TERROR: 0.5, DT_HOLY:   -1.0, DT_UNHOLY:  0.5, 
         DT_MIND:     -0.3, DT_SLASH:  0.2, DT_BLUDGEON:0.1, DT_PIERCE:  0.2,
         DT_RIP:       0.2, DT_WHIP:   0.2, DT_SQUEEZE: 0.1]) );
      break;
   }
    
    
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 30-random(10));
  
  switch(random(4))
  {
   case 0:
    SetProp(P_MSGIN, "schreitet herein");
    SetProp(P_MSGOUT, "geht gemaechlich");
   break;
   case 1:
    SetProp(P_MSGIN, "schleicht herein");
    SetProp(P_MSGOUT, "schlendert leise");
   case 2:
    SetProp(P_MSGIN, "kommt an");
    SetProp(P_MSGOUT, "gleitet");
   break;
   default:
    SetProp(P_MSGIN, "tappt herein");
    SetProp(P_MSGOUT, "geht lautlos");
   break;
  }
  
  switch(random(3))
  {
   case 0..1:
    SetProp(P_MMSGIN, "erscheint");
   break;
   default:
    SetProp(P_MMSGIN, "ist ploetzlich da");
   break;
  }
  
  SetProp(P_MMSGOUT, "entschwindet");

  switch(random(7))
  {
   case 0..4:
    SetProp(P_DIE_MSG,  " sackt leblos zusammen.\n");
   break;
   default:
    SetProp(P_DIE_MSG, " stoehnt noch einmal und stirbt.\n");
   break;
  }
  
  SetProp(P_NOCORPSE, 0 );
  switch(random(11))
  {
   case 0..5:
    SetProp(P_MURDER_MSG, "Ich verzeihe Dir!");
   break;
   case 6..7:
    SetProp(P_MURDER_MSG, "Moege das Leben Dir gnaedig sein!");
   break;
   case 8..9:
    SetProp(P_MURDER_MSG, "Meine Zeit ward gekommen.");
   break;
   default:
    if(random(5)==0) SetProp(P_MURDER_MSG, "Das Leben ist wie eine Bluete: "
    "Irgendwann verwelkt es auch!");
   break;
  }
  
  switch(random(14))
  {
   case 0..8:
    SetProp(P_KILL_MSG, "Oh nein! Was habe ich nur getan!");
   break;
