// Gesellenstück
// Darmbruch - bruch.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

int i;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");

  SetProp(P_NAME, "Darmbruch");
  SetProp(P_GENDER, MALE);
  AddId("\nbruch");

  SetProp(P_MATERIAL, MAT_MISC_LIVING );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  
  i=0;
  call_out("pain",4,TO);
}

void pain(object me)
{
  // if(!ENV(me)) me->remove(1);
  // if(!interactive(ENV(me))) me->remove(1);
  if ( (!ENV(me)) || (!interactive(ENV(me))) )
  {
    me->remove(1);
    return;
  }
  // Obiges umgestellt; nach dem remove() ginge es sonst ja weiter...
  // (Bonus: Eigentlich koennte man die Objektuebergabe auch weglassen,
  // this_object() ist auch in der call_out-Schleife gesetzt und der
  // default fuer environment().)
  // Anatol 11.07.2014

  switch (i)
  {
   case 0 .. 25:
    switch(random(5))
    {
     case 0:
     tell_object(ENV(me), BS("Du hast schreckliche Schmerzen im Bauch!"));
     break;

     case 1:
     tell_object(ENV(me), BS("Du windest Dich vor Schmerzen am Boden. So "
     "kann das nicht weitergehen!"));
     break;

     case 2:
     tell_object(ENV(me), BS("Arrrg!"));
     break;
     
     case 3:
     tell_object(ENV(me), BS("!!!ZACK!!! Ploetzlich spuerst Du einen Stich im Bauch."));
     
     ENV(me)->SetProp(P_PARALYZED, 
        ([PARALYZE_TIME: random(10),
  	PARALYZE_MSG: "Du kannst Dich vor Schmerzen kaum bewegen!\n",
  	PARALYZE_MSG_OTHER: "%s windet sich vor Schmerzen.\n",
  	PARALYZE_END: "Du reisst Dich trotz Schmerzen zusammen "
  	"und stehst wieder auf.\n"]));			  
        break;
  
     default:
     tell_object(ENV(me), BS("AAAAAU! Bei der letzen Bewegung stach es Dir "
     "im Bauch!"));
     break;
    }
    break;
  
   default:
     tell_object(ENV(me), BS("Langsam werden die Schmerzen schwaecher."));
     me->remove(1);
     break;
  }
  
  if(me!= 0 && ENV(me)!=0 && interactive(ENV(me))) ENV(me)->AddHp(-random(50));
  
  i++;
  while(remove_call_out("pain")!=-1);
  call_out("pain",20+random(6),me);
}
