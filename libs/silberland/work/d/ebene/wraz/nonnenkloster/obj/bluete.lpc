// Gesellenstueck
// Eine Bluete - bluete.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Bluete");
  SetProp(P_LONG,
    "Eine wirklich bewundernswerte, lila schimmernde Bluete!");

  SetProp(P_NAME, "Bluete");
  SetProp(P_GENDER, FEMALE);
  AddId("bluete");

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 3);
  SetProp(P_SIZE, 8);
  SetProp(P_VALUE, 1);
  SetProp(P_SMELL, "Diese Bluete duftet wunderbar nach Fruchtsaft!\n");
}