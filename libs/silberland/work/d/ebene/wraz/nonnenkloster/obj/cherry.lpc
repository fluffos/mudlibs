// Gesellenstück
// Eine Kirsche - cherry.c
// Von Wraz / Mendralim

inherit "std/food";

#include "../def.h"
#include <food.h>

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  AddId(( {"kirsche"} ));
  SetProp(P_NAME, "Kirsche");
  SetProp(P_NAME_ADJ, ( {"knallrot"} ) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine knallrote Kirsche");
  SetProp(P_LONG, "Diese knallrot leuchtende Kirsche wird sicher sehr suess schmecken.");
  SetProp(P_WEIGHT, 2+random(3));
  SetProp(P_VALUE, 1);
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_INFO, "Die Kirsche ist sicherlich essbar.");
  SetProp(P_SMELL, "Sie riecht suess.");
  SetProp(P_FOOD_INFO, ([ F_HEAL: ({ 2+random(5) , 1 }),
  			  F_SOAK: 1+random(4),
  			  F_DRINK: 0,
  			  F_ALCOHOL: 0,
  			  F_POISON: 0,
  			  F_MSG: "Du isst genuesslich die rote Kirsche und "
  			         "spuckst anschliessend den Kern aus.",
  			  F_MSG_ROOM: "isst eine Kirsche.",
  			  F_VERB: "essen" ]));
}