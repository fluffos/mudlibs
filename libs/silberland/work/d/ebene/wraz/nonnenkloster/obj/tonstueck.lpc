inherit "std/thing";

#include "../def.h"
#include <language.h>

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  AddId(({"tonstueck","ton","stueck"}));
  SetProp(P_NAME, "Tonstueck");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 15+random(10));
  SetProp(P_SHORT, "Ein Stueck Ton");
  SetProp(P_LONG, "Ein kleines, gebranntes Stueck Ton.");
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_MISC_SOLID);
  SetProp(P_INFO, "Das Tonstueck besteht vollstaendig aus Ton!\n");
}