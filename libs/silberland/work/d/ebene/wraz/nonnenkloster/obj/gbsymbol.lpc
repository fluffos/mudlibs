// Gesellenstueck
// Grosses Birnensymbol - gbsymbol.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

int self_remove;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein anmutiges Birnensymbol");
  SetProp(P_LONG,
    "Dieses Birnensymbol besitzt, so scheint Dir, eine magische Aura. Es "
    "stellt eine Birne samt Staengel und Blatt dar.");
    
  AddDetail( ({"aura"}),
    "Die Aura geht kraeftigt Dich auf magische Weise!");
    
  AddDetail( ({"birne","staengel","blatt"}),
    "Daraus setzt sich das Birnensymbol zusammen.");

  SetProp(P_INFO, "Dieses Symbol ist ein maechtiges, magisches Artefakt!");
  SetProp(P_NAME, "Birnensymbol");
  SetProp(P_GENDER, NEUTER);
  AddId(({"birnensymbol", "artefakt"}));
  
  SetProp(P_NAME_ADJ, ({"anmutig"}) );
  AddAdjective( ({"anmutiges","anmutig","anmutige"}) );

  switch(random(3))
  {
   case 0:
    SetProp(P_X_ATTR_MOD,([A_INT:1+random(3)]));
   break;
   case 1:
    SetProp(P_X_ATTR_MOD,([A_DEX:1+random(2)]));
   break;
   default:
    SetProp(P_X_ATTR_MOD,([A_INT:1+random(2),A_DEX:1+random(2)]));
   break;
  }
  
  SetProp(P_MATERIAL, ([MAT_CHALK:5, MAT_JADE:20, MAT_BEECH:65,
   MAT_MISC_HOLY:10]) );
  SetProp(P_WEIGHT, 85);
  SetProp(P_SIZE, 9);
  SetProp(P_VALUE, 3419);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  
  write_file(LOG "gbsymbol.log",dtime()+" "+previous_object()->Name()+" "
   +file_name(TO)+"\n");
  
  self_remove=0;
}

void reset()
{
  object weapon;
  
  ::reset();
  
  if (!is_clone(TO)) return;
  
  if(!interactive(ENV(TO))) return;
  
  self_remove++;
  
  if(self_remove>25+random(5)) 
  {
    if(ENV(TO))
    ENV(TO)->Message(BS("Das anmutige Birnensymbol leuchtet ploetzlich grell "
    "auf und ist anschliessend verschwunden."));
    
    TO->remove(1);
    return;
  }
  
  else if(!random(3))
  {
    if(ENV(TO))
    {
      ENV(TO)->Message(BS("Auf einmal fuehlst Du eine angenehme, wohlige "
        "Waerme, als Du das anmutige Birnensymbol mit Deiner Hand streifst. "
        "Irgendwie ueberkommt Dich ein Gefuehl der Ruhe und des Friedens."),
        MSGFLAG_SENSE);
        
      if(!ENV(TO)->InFight())
       ENV(TO)->ModifySkillAttribute(TO,SA_SPEED, 50, 100+random(200));
      
      switch (random(4) + (ENV(TO)->InFight() ? 0 : 1))
      {
      	case 0:
      	 if(ENV(TO)->InFight())
         ENV(TO)->ModifySkillAttribute(TO,SA_SPEED, 50, 100+random(200));
         break;
      
        case 1:
          if(!ENV(TO)->QueryProp(P_DISABLE_SPELLS)) {
           ENV(TO)->SetProp(P_DISABLE_SPELLS, 8+random(7));
           ENV(TO)->command_me("umarme alle"); }
           
          else if(!ENV(TO)->QueryProp(P_DISABLE_ATTACK))
           ENV(TO)->SetProp(P_DISABLE_ATTACK, 8+random(7));
           
          else
           ENV(TO)->ModifySkillAttribute(TO,SA_SPEED, 50, 100+random(200));
           
          break;
          
        case 2:
          if(!ENV(TO)->QueryProp(P_DISABLE_ATTACK)) {
           ENV(TO)->SetProp(P_DISABLE_ATTACK, 8+random(7));
           ENV(TO)->command_me("knuddel alle"); }
           
          break;
        
        default:
          switch(ENV(TO)->QueryProp(P_RACE))
          {
           case "Mensch":
            ENV(TO)->command_me("rufe ICH LIEBE DAS LEBEN! JUCHUU!");
            break;
           
           case "Elf":
            ENV(TO)->command_me("rufe ZWERGE! MEINE FREUNDE!");
            ENV(ENV(TO))->Message(BS(TPN+" sieht sich nach Baeumen um..."),
             MSGFLAG_VISUAL);
            break;
            
           case "Zwerg":
            ENV(TO)->command_me("rufe Die Berge! Meine geliebte Heimat!");
            ENV(TO)->command_me("sag Hossa! Da drueben glitzert ja was...");
            break;
            
           case "Dunkelelf":
            ENV(TO)->command_me("rufe Warum bin ich nur so boese? Paladine, "
             "es tut mir leid! Nehmt mich bitte zu Euch auf!");
            break;
            
           case "Hobbit":
            ENV(TO)->command_me("rufe Was tue ich eigentlich hier? Das Leben "
             "ist viel zu kurz, um es mit kaempfen zu verschwenden. Ich geh' "
             "mir dann mal den Wamst vollschlagen!");
            break;
            
           case "Troll":
            ENV(TO)->command_me("rufe Bluuuuumen! Wunderschoene Bluuuumen!!");
            break;
            
           case "Oger":
            ENV(TO)->command_me("rufe Mampf! Hunger!");
            ENV(TO)->command_me("sag Hmm Du siehst lecker aus... *sabber*");
            break;
            
           case "Fee":
            ENV(TO)->command_me("rufe FEENPOWER!!!");
            ENV(TO)->command_me("laechel");
            break;
            
           case "Untoter":
            ENV(TO)->command_me("rufe Oh nein! Diese unendliche Schwaeche! "
             "Lasst mich doch sterben!");
            break;
            
           default:
            ENV(TO)->command_me("rufe Alles wird gut! So wunderbar!");
            break;
           }
            
          if(weapon=ENV(TO)->QueryProp(P_WEAPON))
           ENV(TO)->drop_obj(weapon,1);
          
        break;
      }
          
      TO->SetProp(P_NODROP, "Als Du das anmutige Birnensymbol in die Hand "
        "nimmst fuehlst Du ploetzlich wieder diesen wunderschoenen Frieden "
        "in Dir. Jetzt willst Du es gar nicht mehr wegwerfen.\n");
    }
    
    else return;
  }
  
  else TO->SetProp(P_NODROP, 0);
  
  return;
}