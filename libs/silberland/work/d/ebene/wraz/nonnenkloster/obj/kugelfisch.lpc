#include "../def.h"

inherit "std/food";

#include <food.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein gekochter Kugelfisch");
  SetProp(P_LONG,
    "Das ist ein gekochter Kugelfisch - eine Spezialitaet!");

  SetProp(P_INFO, "Ein gewisses Stueck des Kugelfischs ist hochgiftig! Wenn "
  "Du ihn isst und der Koch schlampig war und das Stueck nicht entfernt hat "
  "hast Du bald ein Treffen mit Lars. Zum Glueck kommt das aber nur hoechst "
  "selten vor.");
  SetProp(P_NAME, "Kugelfisch");
  SetProp(P_GENDER, MALE);
  
  SetProp(P_NAME_ADJ, ({"gekocht"}) );
  AddAdjective(({"gekochten","gekochter","gekochtem","gekochtes","gekochte"}));

  AddId(({"kugelfisch", "fisch"}));
  
  SetProp(P_MATERIAL, ([ MAT_FAT:1, MAT_MISC_SPICE:1, MAT_PEPPER:1, MAT_SALT: 1,
  MAT_FLESH:90, MAT_HORN:6 ]) );
  
  SetProp(P_WEIGHT, 300+random(100));
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  
  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 70+random(30),70+random(30) }), // LP, MP
         F_SOAK    : 15+random(5),
         F_DRINK   : 0,          
         F_ALCOHOL : 0,
         F_POISON  : 0,
         F_MSG     : "Du verzehrst genuesslich den exzellenten Kugelfisch.",
         F_MSG_ROOM: "isst mit genuss einen herrlichen Kugelfisch.",
         F_VERB    : "essen"      // Wird fuer Fehlermeldung "Was wills+ Du
      ]) );                       // essen" benoe+ig+

}

void Eating(object pl)
{
  if(random(50)==10) call_out("tot",25,pl);
  return;
}

void tot(object pl)
{
  object test;
  if(!interactive(pl)) return;
  
  else
  {
    pl->Message(BS("EIN LAEHMENDER SCHMERZ!!! DER KUGELFISCH WAR GIFTIG!!!!"));
    SetProp(P_KILL_NAME, "Ein giftiger Kugelfisch");
    pl->die();
    return;
  }
}    