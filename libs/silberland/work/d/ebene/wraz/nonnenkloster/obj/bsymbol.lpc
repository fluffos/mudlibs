// Gesellenstueck
// Ein Birnensymbol - bsymbol.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein kleines Birnensymbol");
  SetProp(P_LONG,
    "Das Symbol stellt eine Birne mit einem Blatt und Staengel daran dar. "
    "Es stammt wohl aus einem Kloster, welches eine Birne als ihr "
    "Markenzeichen auserkoren hat.");
    
  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleines","klein","kleine"}) );

  SetProp(P_INFO, "Das Symbol stammt aus dem Kloster in der Steppe!");
  SetProp(P_NAME, "Birnensymbol");
  SetProp(P_GENDER, NEUTER);
  AddId(({"birnensymbol", "symbol", "markenzeichen"}));

  SetProp(P_MATERIAL, ([MAT_MISC_DECIDUOUS_WOOD:95,MAT_CHALK:5]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 15);
  SetProp(P_VALUE, 10);
}