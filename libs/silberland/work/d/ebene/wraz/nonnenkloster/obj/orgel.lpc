// Gesellenstück
// Orgel - orgel.c
// Von Wraz / Mendralim

inherit "std/thing";

#include "../def.h"
#include <language.h>

int total_STR, counter, no_players, current_player_no, i, edelsteine;
//no_players ist die anzahl der spieler, die die orgel heben (versuchen)
string *players=({""}), player="";
object *msg_players;

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  AddId("orgel");
  SetProp(P_NAME, "Orgel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 1700000);
  SetProp(P_SHORT, "Eine alte Orgel");
  SetProp(P_LONG, "Diese alte Orgel riecht nach Holz.");
  SetProp(P_VALUE, 95000);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_SMELL, "Die Orgel riecht wuerzig nach Holz.\n");
  SetProp(P_SOUND, "Hmm, da summt doch etwas!\n"
  	"Taaa-tadaaa- Tadeedaataaa- Ca-haaa-rry me- Taddaa-taaadadeee- lihii-ft me!\n"
  	"Du schuettelst Dich. Wirst Du jetzt schon verrueckt??\n");
  // Update Wraz, 17.7.2020 (anscheinend schaffen es Spieler, die Orgel wegzutragen):
  SetProp(P_NOGET, "Aber die Orgel ist doch viel zu gross und schwer!\n");
  
  AddDetail("holz",
  	"Die Orgel besteht aus dunklem Holz.");
  	
  AddCmd("carry|lift", "cmd_heben_engl");
  AddCmd(({"hebe","heb"}), "cmd_heben");
  AddCmd(({"spiele","spiel"}), "cmd_spielen");
  
  current_player_no=0; i=1; edelsteine=1;
}

int cmd_spielen(string str)
{
  if(!str||str=="") return 0;
  
  notify_fail("Womit moechtest Du spielen?\n");
  
  if(str=="orgel"||str=="mit orgel"||str=="an orgel")
  {
    TP->Message(BS(
     "Du stellst Dich vor die Orgel mit dem Vorsatz, irgendetwas zu spielen. "
     "Aber als Du so da stehst und sie betrachtest, faellt Dir auf, wie schoen "
     "und wertvoll diese alte Orgel doch ist! Nein, Du wagst es einfach nicht, "
     "an diesem heiligen Ort etwas zu spielen, noch dazu kannst Du das ja "
     "gar nicht!"));
     return 1;
   }
return 0;
}

int cmd_heben_engl()
{
  TP->Message(BS("Probier's doch mal auf Deutsch!"));
  return -1;
}

void message()
{
  object symb;
  if(i==1) {
  while(current_player_no<=no_players-1)
  {
    find_player(players[current_player_no])->Message("Langsam verlassen Dich Deine Riesenkraefte "
    "wieder...\n",MSGFLAG_SENSE);
    
    if(edelsteine && ENV(TO)==find_object(ROOM "orgelraum")) {
      // sonst kann man die Orgel an einem beliebigen Ort heben (Update 16.7.2020, Wraz)
    find_player(players[current_player_no])->Message("Du findest einige Edelsteine "
    "unter der Orgel!\n",MSGFLAG_SENSE);
    "/obj/gemmaster"->DistributeGem(3, 2, 1, find_player(players[current_player_no])); }
    current_player_no++;
  }}
  if(i==2) 
  {
    ROOM "orgelraum"->Message(BS("Die Orgel kracht wieder zu Boden."));
    if(edelsteine && ENV(TO)==find_object(ROOM "orgelraum"))
      // wie oben
    {
      ROOM "orgelraum"->Message(BS("Etwas rollt unter der Orgel hervor!"));
      symb=clone_object(OBJ "gbsymbol");
      symb->move(ROOM "orgelraum", M_NOCHECK);
      edelsteine=0;
    }
  }
  i++;
  if(i<=2) call_out("message",4);
  else {no_players=0; players=({""}); i=1; current_player_no=0; edelsteine=0; return;}
}

void end()
{
  msg_players=map_array(players,#'find_player);
  
  if(total_STR>=315) // 315
  {
    int asdf;
    int for_counter;
    asdf=0;
    
    write_file(LOG "orgel",
    BS(dtime()+": "+implode(players, " ")+" heben erfolgreich die Orgel!"));
    
    while(asdf<sizeof(players)) {
     //interactive...
     if(!find_player(players[asdf]) || 
     !interactive(find_player(players[asdf]))) {
     	find_netdead(players[asdf])->SetProp("orgel_heben",0);
     	asdf++;
     	continue; }
     	
     find_player(players[asdf])->Message("Unglaublich! Du bringst Dir bis jetzt noch "
     "unbekannte Kraefte auf, \nund tatsaechlich schafft ihr es die Orgel ein Stueck "
     "zu heben!!\n",MSGFLAG_VISUAL);
     find_player(players[asdf])->SetProp("orgel_heben",0);
     asdf++; }
    
    ROOM "orgelraum"->Message("Die da drueben heben die Orgel an! Sie muessen total "
      "verrueckt sein!!\n",MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:msg_players]));
    
    for(for_counter=0;for_counter<=sizeof(players)-1;for_counter++)
    {
      if(random(3)==2 && !present("\nbruch",find_player(players[for_counter]))
      //member(deep_inventory(find_player(players[for_counter]),
      //find_object(OBJ "bruch"))==-1)
      ) 
      {
       object ob;
       ob=clone_object(OBJ "bruch");
       ob->move(find_player(players[for_counter]),M_NOCHECK);
       find_player(players[for_counter])->Message(BS("WAAARGH!!! EIN SCHRECKLICHER "
       "SCHMERZ IM BAUCH!!!!")); }
    }
    
    call_out("message",2);
  }
  
  else
  {
    asdf=0;
    
    write_file(LOG "orgel",
    BS(dtime()+": "+implode(players, " ")+" versuchten Orgel zu heben."));
    
    while(asdf<sizeof(players)) {
     if(!find_player(players[asdf]) || 
     !interactive(find_player(players[asdf]))) {
     	find_netdead(players[asdf])->SetProp("orgel_heben",0);
     	asdf++; continue; }
     find_player(players[asdf])->SetProp("orgel_heben",0);
     
     if(sizeof(players)==1) {
     	find_player(players[asdf])->Message("Du schaffst es nicht, die Orgel "
     	"zu heben.\n"); }
     else
     find_player(players[asdf])->Message("Ihr schafft es nicht, die Orgel "
     "zu heben.\n");
     
     asdf++; }
    
    
    if(sizeof(players)==1) {
    ROOM "orgelraum"->Message("Der Wahnsinnige dort hat es nicht geschafft, die "
      "Orgel zu heben. \nEs wundert Dich nicht. Er ist ja auch alleine!\n",
    MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:msg_players])); }
    
    else
    ROOM "orgelraum"->Message("Die Wahnsinnigen dort haben es nicht geschafft, die "
      "Orgel zu heben. \n Es wundert Dich nicht.\n",MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:
    msg_players]));
    
    no_players=0; players=({""});
  }
    player="";
    total_STR=0;
    counter=0;
}



int cmd_heben(string str)
{
  if(!str) return 0;
  if(TP->QueryProp(P_INVIS)) return 0;
  if(players==0) players=({""});
  
  if(str=="orgel"||str=="orgel an")
  {
  
  if(member(players,lower_case(TPN))!=-1)
   {
    TP->Message(BS("Aber Du versuchst doch schon die Orgel zu heben!"));
    return -1;
   }
  
  if(member(players,lower_case(TPN))==-1)
   {
    TP->SetProp("orgel_heben",1);
    total_STR+=TP->QueryAttribute(A_STR);
    player=player+" "+lower_case(TPN);
    players=explode(player," ");
    no_players++;
    TP->Message(BS("Du hockst Dich hin, greifst unter die Orgel und versuchst sie "
    "zu heben..."));
    ROOM "orgelraum"->Message(BS(TPN+" versucht die Orgel zu heben!"),MSGFLAG_VISUAL|
      MSGFLAG_NO_TP);
   }
  
  if(counter==0) 
   {
    counter=1;
    call_out("end",10);
   }
  return 1;
  }

}

void reset()
{
  ::reset();
  edelsteine=1;
}
