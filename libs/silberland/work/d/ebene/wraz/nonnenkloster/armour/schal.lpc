// Gesellenstück
// Roter Schal - shawl.c
// Von Wraz / Mendralim


#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein rotes Tuch");
  SetProp(P_LONG,
    "Dieses rote Tuch strahlt eine seltsame, jedoch kraeftige Staerke aus. Es ist etwa "
    "einen Zwerg lang und zwei Haende breit.");
  
  SetProp(P_NAME, "Tuch");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"tuch"}) );

  AddAdjective( ({"roten","rotem","rotes","rote"}) );

  SetProp(P_MATERIAL, ([MAT_SILK:40,MAT_VELVET:40,MAT_MISC_PLANT:15,MAT_MISC_MAGIC:5]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 4500);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_UNWEAR_TEXT, ({"Du bindest %s ab.\n", " bindet %s los.\n"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 30);

  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:8]) );
  SetProp(P_WORN_TEXT, "irgendwie unnuetz festgebunden");

  SetProp(P_INFO, BS("Dieses Tuch ist sehr vielseitig.") );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_M_ATTR_MOD, ([A_DEX:-1]));
  
  AddCmd(({"trage","trag"}), "cmd_binden");
}

int WearFunc()
{
  if(TO->QueryProp(P_ARMOUR_TYPE)==AT_MISC) {
      write_file(LOG "tuch.klauen",
      dtime()+": "+TPN+" bindet das Tuch unnuetz fest.\n");
    TP->Message(BS("Irgendwie scheint das so nicht sehr nuetzlich zu sein...")); }
  return 1;
}

int RemoveFunc()
{
  TO->SetProp(P_ARMOUR_TYPE, AT_MISC);
  TO->SetProp(P_AC, 0);
  TO->SetProp(P_DAM_PROTECTION, ([]) );
  TO->SetProp(P_WORN_TEXT, "irgendwie unnuetz festgebunden");
  TO->SetProp(P_M_ATTR_MOD, ([A_DEX:-1]));
  return 1;
}

void no_wear(int i, object player)
{
  if(i==1)
  {
    player->Message(BS("Du solltest das Tuch zuerst nehmen!"));
  }
  if(i==2)
  {
    player->Message(BS("Aber Du traegst das Tuch doch schon!"));
  }
  if(i==3)
  {
    player->Message(BS("So eine Ruestung traegst Du schon!"));
  }
return;
}

int cmd_binden(string str)
{
  if(!str) return 0;
  
      if(member(all_inventory(TP),TO)==-1) { // tuch zuerst nehmen
        //no_wear(1,TP);
        return 0; }
      if(QueryWorn(TO)!=0) {  // traegst schon!
        //no_wear(2,TP);
        return 0; }
  
  switch (str)
  {
    case "tuch um kopf":
    case "tuch an kopf":
    case "tuch als helm":
    case "tuch am kopf":
    
    case "rotes tuch um kopf":
    case "rotes tuch an kopf":
    case "rotes tuch als helm":
    case "rotes tuch am kopf":
      if(sizeof(TP->QueryArmours(({AT_HELMET})))) { //funnktion, die hinweis gibt
        no_wear(3,TP);
        return -1;
        break; }
      TO->SetProp(P_ARMOUR_TYPE, AT_HELMET);
      TO->SetProp(P_AC, 7);
      TO->AddProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_MIND:1]) );
      TO->SetProp(P_WORN_TEXT, "um den Kopf gebunden");
      TO->SetProp(P_M_ATTR_MOD, ([]));
      if(!DoWear(1,0)) break;
      write_file(LOG "tuch.klauen",
      dtime()+": "+TPN+" bindet das Tuch um den Kopf!\n");
      TP->Message(BS("Du bindest Dir das rote Tuch um den Kopf!"));
      ENV(TP)->Message(BS(TPN+" bindet sich ein rotes Tuch um den Kopf."), 
       MSGFLAG_VISUAL|
      MSGFLAG_NO_TP);
      return 1;
      break;
      
    case "tuch um bauch":
    case "tuch an bauch":
    case "tuch um taille":
    case "tuch an taille":
    case "tuch als guertel":
    case "tuch am bauch":
    case "tuch an der taille":
    
    case "rotes tuch um bauch":
    case "rotes tuch an bauch":
    case "rotes tuch um taille":
    case "rotes tuch an taille":
    case "rotes tuch als guertel":
    case "rotes tuch am bauch":
    case "rotes tuch an der taille":
      if(sizeof(TP->QueryArmours(({AT_BELT})))) {
        no_wear(3,TP);
        return -1;
        break; }
      TO->SetProp(P_ARMOUR_TYPE, AT_BELT);
      TO->SetProp(P_AC, 2+random(2));
      TO->AddProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_HOLY:1]) );
      TO->SetProp(P_WORN_TEXT, "um die Taille gebunden");
      TO->SetProp(P_M_ATTR_MOD, ([]));
      if(!DoWear(1,0)) break;
      write_file(LOG "tuch.klauen",
      dtime()+": "+TPN+" bindet das Tuch um die Taille!\n");
      TP->Message(BS("Du bindest Dir das rote Tuch um die Taille!"));
      ENV(TP)->Message(BS(TPN+" bindet sich ein rotes Tuch um die Taille."), 
       MSGFLAG_VISUAL|
      MSGFLAG_NO_TP);
      return 1;
      break;
      
    case "tuch um den hals":
    case "tuch an den hals":
    case "tuch als halsband":
    case "tuch als amulett":
    case "tuch am hals":
    case "tuch um hals":
    
    case "rotes tuch um den hals":
    case "rotes tuch an den hals":
    case "rotes tuch als halsband":
    case "rotes tuch als amulett":
    case "rotes tuch am hals":
    case "rotes tuch um hals":
      if(sizeof(TP->QueryArmours(({AT_AMULET})))) {
      	no_wear(3,TP);
      	return -1;
      	break; }
      TO->SetProp(P_ARMOUR_TYPE, AT_AMULET);
      TO->SetProp(P_AC, 2);
      TO->AddProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );
      TO->SetProp(P_WORN_TEXT, "um den Hals gebunden");
      TO->SetProp(P_M_ATTR_MOD, ([]));
      if(!DoWear(1,0)) break;
      write_file(LOG "tuch.klauen",
      dtime()+": "+TPN+" bindet das Tuch um den Hals!\n");
      TP->Message(BS("Du bindest Dir das rote Tuch um den Hals!"));
      ENV(TP)->Message(BS(TPN+" bindet sich ein rotes Tuch um den Hals."), 
       MSGFLAG_VISUAL|
      MSGFLAG_NO_TP);
      return 1;
      break;
    
    default:
      return 0;
      break;
    }
return 0;
}