// Gesellenstück
// Kutte - kutte.c
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/armour";

string farbe;


void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  
  farbe=({ "blau","rot","gruen","weiss","orangen","violett","cyanrot",
  "braun","faerbig" })[(random(8))];  // Danke Papi ;)
  
  SetProp(P_COLOR, farbe);

  SetProp(P_SHORT, "Eine "+farbe+"e Kutte");
  SetProp(P_LONG,
    "Diese Kutte ist "+farbe+". Sie hat eine Kapuze, lange Aermel und reicht bis "
    "knapp unter die Knie. "
    "Auf ihrer Rueckseite ist das Birnensymbol eingenaeht.");

  SetProp(P_NAME, "Kutte");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kutte"}));
  
  if(!farbe) farbe="faerbig";

  SetProp(P_NAME_ADJ, ({farbe}) );
  AddAdjective( ({farbe+"en",farbe+"er",farbe+"em",farbe+"es",farbe+"e"}) );

  SetProp(P_MATERIAL, ([MAT_COTTON:96,MAT_SILK:4]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_SIZE, 111);
  SetProp(P_VALUE, 600);

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 7);
  SetProp(P_QUALITY_DECAY, 90);
  
  if(random(30)==1)
  {
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_MAGIC:1, 
    DT_UNHOLY:1]) );
  SetProp(P_AC, 9);
  SetProp(P_INFO, BS("Diese Kutte ist aussergewoehnlich gut gearbeitet!") );
  write_file(LOG "kutte.log",dtime()+" "+file_name(TO)+"\n");
  }
  
  AddDetail( ({"symbol", "birnensymbol"}),
  	 "Es stellt eine Birne mit Staengel und einem Blatt daran dar.");
  	 
  AddDetail( ({"birne", "staengel", "blatt"}),
  	 "Auf dem Birnensymbol dargestellt.");
  	 
  AddDetail("rueckseite",
  	"An der Rueckseite der Kutte ist das Birnensymbol dargestellt.");
  	
  if(farbe=="gruen")
  {
  SetProp(P_LONG,
    "Diese Kutte ist "+farbe+". Sie hat eine Kapuze, lange Aermel und reicht bis "
    "knapp unter die Knie. "
    "Auf ihrer Rueckseite sind das Birnensymbol und ausserdem ein Laubbaum eingenaeht.");
  AddDetail("laubbaum",
    "Diese gruene Kutte hat zusaetzlich zu dem Birnensymbol einen Laubbaum an ihrer "
    "Rueckseite eingenaeht.");
  AddDetail("rueckseite",
    "An der Rueckseite der gruenen Kutte ist das Birnensymbol und ein Laubbaum "
    "dargestellt.");
  }
}