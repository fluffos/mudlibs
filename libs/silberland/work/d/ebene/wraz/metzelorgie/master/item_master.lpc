// item master, Schlachtfeld
// Wraz / Mendralim

#include "../def.h"

void create()
{
  if(is_clone(TO))
  {
    destruct(TO);
    return;
  }
  seteuid(getuid(TO)); // fuer zugriff auf dateien benoetigt

  return;
}

// Spezielle Items, die beim die() des NPC gecloned werden, und im Raum landen
// (nach dem Tod des NPC)
// 1: Schattenportalrolle (wird in den Raum gemoved)
void DoDrop(object room, int lvl)
{
  object portalrolle;
  
  if(!room || !lvl) return;

  if (!random(3000/lvl))
  {
    room->Message(BS("Fuer einen Lidschlag wird die Umgebung duester und "
      "schattenhaft, und etwas Leichtes trifft auf den Boden."),MSGFLAG_VISUAL);
    portalrolle=clone_object(SCHATTEN "obj/portalrolle");
    portalrolle->move(room,M_NOCHECK);
  }
}

void DropItems(object room, int lvl)
{
  call_out("DoDrop", 0, room, lvl);
}

// ------ remove() -----------------------------------------------------------
int remove()
{
  if(is_clone(TO)) {
    destruct(TO);
    return 1;
  }
  return 0;
}
