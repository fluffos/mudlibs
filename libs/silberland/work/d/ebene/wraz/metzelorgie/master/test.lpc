#include "../def.h"
void create()
{
    if (is_clone(TO))
    {
        destruct(TO);
        return;
    }
    seteuid(getuid(TO)); // fuer zugriff auf dateien benoetigt

    return;
}

string get_finders_and_owners(string str, string which)
{
    string weekday, month, finder, unique_or_rare, weapon_owner, weapon, obj_name;
    int monthday, year, hour, minute, second;
    /*if(find_player("wraz")) find_player("wraz")->Message("\ndrei 3\n\n");
    if(find_player("wraz")) find_player("wraz")->Message(str+"\n");*/

    /*if(find_player("wraz")) 
    {
        find_player("wraz")->Message("\nif-1\n\n");
         find_player("wraz")->Message("\nif-1.1\n\n");
       find_player("wraz")->Message(BS(
        to_string(sscanf(to_string(str),"%s, %d. %s %d, %d:%d:%d: %s finds %s: %s einzigartige %s des Sterbens (%s)",
            weekday, monthday, month, year, hour, minute, second, finder, unique_or_rare, 
                weapon_owner, weapon, obj_name))));

        find_player("wraz")->Message("\nif-2\n\n");
        find_player("wraz")->Message(BS(
        to_string(sscanf(str,"%s, %d. %s %d, %d:%d:%d: %s finds %s: %s %s des Sterbens (%s)",
                weekday, monthday, month, year, hour, minute, second, finder, unique_or_rare, 
                weapon_owner, weapon, obj_name))));
    }*/

    if( sscanf(str,"%s, %d. %s %d, %d:%d:%d: %s finds %s: %s einzigartige %s des Sterbens (%s)",
                weekday, monthday, month, year, hour, minute, second, finder, unique_or_rare, 
                weapon_owner, weapon, obj_name) != 12
                &&
        sscanf(str,"%s, %d. %s %d, %d:%d:%d: %s finds %s: %s %s des Sterbens (%s)",
                weekday, monthday, month, year, hour, minute, second, finder, unique_or_rare, 
                weapon_owner, weapon, obj_name) != 12)
        return "";

    /*if(find_player("wraz")) find_player("wraz")->Message(BS(weekday+ monthday+ month+ year+ 
    hour+ minute+ second+ finder+ unique_or_rare+weapon_owner+ weapon+ obj_name));
    if(find_player("wraz")) find_player("wraz")->Message("\nelse if-4\n\n");*/

    /*if(find_player("wraz")) find_player("wraz")->Message(finder+"\n");
    if(find_player("wraz")) find_player("wraz")->Message(weapon_owner+"\n");

    if(find_player("wraz")) find_player("wraz")->Message(BS("everything: "+weekday+ monthday+ month+ year+ 
        hour+ minute+ second+ finder+ unique_or_rare+weapon_owner+ weapon+ obj_name));*/

    if(which == "get_finders")
    {
        if(!finder) return "";
        else return lower_case(finder);
    }
    else if(which == "get_owners") 
    {
        if(!weapon_owner) return "";
        else return lower_case(weapon_owner[0..<2]);
    }

    return "finder/owner?";
}

string *recent_weapons(int finders_or_owners)
// finders_or_owners == 1 -> finders
// else -> owners
{
    string *log, *finders, *owners;
    int size;

    /*if(find_player("wraz")) find_player("wraz")->Message("eins 1\n\n\n");*/
    
    if(size = file_size(LOG "unique_rare.log") <= 0) 
        return ({"unique_rare.log does not exist or empty"});
    size = size > 1000 ? -1000 : -size+1;
    log = explode(read_bytes(LOG "unique_rare.log",-1000),"\n");

    /*if(find_player("wraz")) find_player("wraz")->Message("zwei 2\n\n");

    if(find_player("wraz")) find_player("wraz")->Message(implode(log,"\n"));*/
    finders = map_array(log,"get_finders_and_owners",TO,"get_finders");
    owners = map_array(log,"get_finders_and_owners",TO,"get_owners");

    if (finders_or_owners == 1) return finders;
    else return owners;
}