void create()
{
  if(is_clone(TO))
  {
    destruct(TO);
    return;
  }
seteuid(getuid(this_object())); // fuer zugriff auf dateien benoetigt
                                // zB read_file()
return;
}

int query_schlaechter()
{
  object dummy;
  if(dummy=find_living("wrazmeisterschlaechter")) schlaechter=0;
  else schlaechter=1;
  return schlaechter;
}

int query_last_wache()
{
  return last_wache;
}

int query_inside()
{
  return inside;
}

int query_golem_tot()
{
  return golem_tot;
}

string query_who_inside()
{
  return who_inside;
}

int set_status(string str, int i, string player)
{
  if(!str) return 0;

  switch (str)
  {
    case "schlaechter":
      schlaechter=i;
      return 1;
      break;
    case "last_wache":
      last_wache=i;
      return 1;
      break;
    case "inside":
      who_inside=player;
      inside=i;
      return 1;
      break;
    case "golem_tot":
      golem_tot=i;
      return 1;
      break;
    default: return 0; break;
  }
return 0;
}

// wird vom Lehmgolem im create() und reset() aufgerufen
int load_npc()
{
  object npc;
  int i;
  int k;
  i=0;

  call_other(ROOM "p03", "reset");
  call_other(ROOM "p04", "reset");
  call_other(ROOM "p05", "reset");
  call_other(ROOM "p06", "reset");
  call_other(ROOM "p07", "reset");
  call_other(ROOM "p08", "reset");
  call_other(ROOM "p09", "reset");
  call_other(ROOM "p10", "???"); // Raeume mal geladen

  // check ob gerade ein Spieler am Pfad ist, dann Abbruch
  for(k=3;k<11;k++)
  {
    if(k==10)
    {
      if (sizeof(filter_array(all_inventory(find_object(ROOM "p10") ) ,
        #'interactive)) ) return -2;
      else break;
    }

    if (sizeof(filter_array(all_inventory(find_object(ROOM "p0" + to_string(k) ) ) ,
      #'interactive)))
     return -2;
  }

  // Reset der "inside" Variablen -> es darf wieder jemand rein
  set_status("inside",0,"");

  // NPC auf Pfad setzen, falls nicht da
  if(!present("\nwache",find_object(ROOM "p03")))
  {
    npc=clone_object(NPC "zyklopen");
    npc->move(ROOM "p03",M_GO);
    i++;
  }

  if(!present("\nwache",find_object(ROOM "p04")))
  {
    npc=clone_object(NPC "troll");
    npc->move(ROOM "p04",M_GO);
    i++;
  }

  if(!present("\nwache",find_object(ROOM "p05")))
  {
    npc=clone_object(NPC "druide");
    npc->move(ROOM "p05",M_GO);
    i++;
  }

  if(!present("\nwache",find_object(ROOM "p06")))
  {
    npc=clone_object(NPC "zechi");
    npc->move(ROOM "p06",M_GO);
    i++;
  }

  if(!present("\nwache",find_object(ROOM "p07")))
  {
    npc=clone_object(NPC "nekromantin");
    npc->move(ROOM "p07",M_GO);
    i++;
  }

  if(!present("\nwache",find_object(ROOM "p08")))
  {
    npc=clone_object(NPC "ghoul");
    npc->move(ROOM "p08",M_GO);
    i++;
  }

  if(!present("\nwache",find_object(ROOM "p09")))
  {
    npc=clone_object(NPC "barghest");
    npc->move(ROOM "p09",M_GO);
    i++;
  }

  if(!present("\nwache",find_object(ROOM "p10")))
  {
    npc=clone_object(NPC "meisterschlaechter");
    npc->move(ROOM "p10",M_GO);
    i++;
  }

return i;
}

int killall(object ob)
{
  if(!interactive(ob)) return 0;
  else if(query_wiz_level(ob) > 10) return 0;

  find_living("wrazlehmgolem")->Kill(ob);
  return 1;
}

int crazy_golem()
{
  object dummy;

  if(dummy=find_living("wrazlehmgolem")) {
    filter_array(all_inventory(ENV(find_living("wrazlehmgolem"))),
     #'killall);
    ENV(find_living("wrazlehmgolem"))->Message(BS(
      "Der Lehmgolem attackiert Dich ploetzlich! Irgendetwas muss passiert "
      "sein!!"));
    find_living("wrazlehmgolem")->SetProp(P_AGGRESSIVE,1);
    return 1; }
  else return 0;
}

int is_hero(string name)
{
  if(member(
    explode(
      read_file(
        ZONE "list/heroes"), "\n"), lower_case(name)
      )!=-1) return 1;

  else return 0;
}

string get_heroes() {
  return read_file("/d/ebene/wraz/metzelorgie/list/heroes");
}

int is_meisterpfadbling(string name)
{
  if(member(
    explode(
      read_file(
        LOG "Meisterpfadbling"), "\n"), lower_case(name)
      )!=-1) return 1;

  else return 0;
}

int bling_prop(object ob, string cl)
{
  if(!ob) return 0;
  if(!cl||cl=="") return 0;

  // 0 short, 1 long, 2 name, 3 gender, 4 material, 5 weight, 6 size, 7 vaule
  // 8 ids

  ob->SetProp(P_SHORT, bling_properties[cl,0]);
  ob->SetProp(P_LONG, bling_properties[cl,1]);

  ob->SetProp(P_NAME, bling_properties[cl,2]);
  ob->SetProp(P_GENDER, bling_properties[cl,3]);
  ob->AddId(({"bling","Bling"}));
  ob->AddId(bling_properties[cl,8]);

  ob->SetProp(P_MATERIAL, bling_properties[cl,4] );
  ob->SetProp(P_WEIGHT, bling_properties[cl,5]);
  ob->SetProp(P_SIZE, bling_properties[cl,6]);
  ob->SetProp(P_VALUE, bling_properties[cl,7]);

  return 1;
}

int query_random_bonus_defend()
{
  return random_bonus_defend;
}

void move_corpse(object player, object this_room)
// wird in den pfadraeumen p03 bis p08 aufgerufen
{
  object corpse;

  if(!this_room) return;

  if(!corpse=present("leiche", this_room) ) return;

  if( corpse->QueryProp(P_ORIG_NAME) == player->Name() )
  {
    call_other(ROOM "p01", "???");
    corpse->move(ROOM "p01", M_NOCHECK);

    tell_room( this_room, BS(
      corpse->QueryProp(P_ORIG_NAME)+"s Leiche steigt ploetzlich empor "
      "und wird davongeweht."));

    tell_room( ROOM "p01", BS(
      "Urploetzlich kommt ein angsteinfloessender Wind auf, welcher eine "
      "LEICHE hereintraegt!!!"));
  }
return;
}

int carries_food(object pl)
{
  // In Pfadraeumen p02 bis p09 (p02 als ex_func, Rest im init)
  // return -2 wenn last_wache da ist
  // return -1 wenn argument gleich 0
  // return 0 wenn kein food dabei
  // return 1 wenn food dabei
  object *inv;
  int i;
  int jo;
  int how_much;

  if( !pl ) return -1;
  if( last_wache ) return -2;

  if( pl->QueryProp(P_GUILD) == "paladine" ) how_much=10;
  else how_much = 4+random(2);

  jo=0;
  inv=deep_inventory(TP);

  for(i=0;i<sizeof(inv);i++)
  {
    if( inv[i]->QueryProp(P_FOOD_INFO) )
    {
      if( !how_much ) {
        inv[i]->move( ROOM "p02" , M_NOCHECK );
        if( !jo ) jo=1; }
      else how_much--;
    }
  }

  if( jo )
  {
    tell_object( pl, BS(
      "Irgendetwas ist mit Deinen Rationen passiert, da muss Magie im Spiel "
      "sein...") );
    return 1;
  }

  return 0;
}

void npc_death_log(string filename, string npc, string tpu, string tpn)
{
  write_file(LOG +filename+".deaths",
     dtime()+" "+npc+": "+tpu+" ("+tpn+")\n");
  return;
}

void npc_kill_log(string npc, string tpu, int lostexp)
{
  write_file(LOG "player.deaths",
    dtime()+" "+npc+" kills "+tpu+", XP:"+lostexp+"\n");
  return;
}

void jadering_log(string tpu, int xpreturn)
{
  write_file(LOG "ring_xp",
    dtime()+" "+tpu+" gets XP: "+xpreturn+"\n");
  return;
}

void axe_manual_log(string playername, int number, string death_or_xp, string success)
{
      write_file(LOG "sterbeaxt_manual_edits",
        dtime()+" "+getuid(TP)+" sets axe "+death_or_xp+" for "+playername+
        " to: "+number+": "+success+"\n");
      return;
}

// OBSOLET! ist jetzt in npc.c definiert, wovon die NPC erben
void jadering_xp(object player, int lvl)
{
  // handling des wiedererlangens verlorener xp, wenn man jadering hat
  object jadering;

  if ( jadering=present("\nwrazjadering",player) &&
  !random( 200/lvl ) )
  {
    jadering=present("\nwrazjadering",player);
    jadering->GivePlayerXP(player);
  }
  return;
}

int muellschlucker(object room)
{
  object npc;

  if(!room) return 0;
  if( file_name(room)[0..30] != "/d/ebene/wraz/metzelorgie/room/" )
    return 0;

  if(sizeof(all_inventory(room)) < 30) return 0;

  if(!present("muellschlucker",room))
  {
    npc=clone_object(NPC "entsorg_sf");
    npc->move(room,M_GO);
    return 1;
  }
  else return 0;
}

// Magier und Testspieler -> 0
// nur "echte" Spieler/Seher -> 1
int is_player(string name)
{
  if(!name || name == "") return 0;
  name=lower_case(name);
  // Existiert der Spielername im save? Findet auch nichtgeladene Spieler
  if(!("/secure/master"->get_userinfo(name))) return 0;
  // Rausfiltern, wenn "Testspieler" in der finger-Info vorkommt
  if(strstr(call_other("/p/daemon/fingerd","finger_single",name),"Testspieler")
     != -1) return 0;
  // Rausfiltern, wenn in shell Magier
  if(("/secure/master"->get_userinfo(name)[4]) == "/std/shells/magier") return 0;

  return 1;
}
