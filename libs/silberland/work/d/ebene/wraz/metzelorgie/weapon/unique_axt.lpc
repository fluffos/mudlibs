// Unique Axt des Sterbens
// von Wraz / Mendralim


#include "../def.h"

inherit "std/weapon";
inherit WEAPON "sterbewaffe";

void create()
{
  if(is_clone(TO)) { TO->remove(); return;} // unique

  ::create();

  gems=0;
  all_colors = mkmapping(({"saphir","diamant","smaragd","rubin","bernstein"}),
    ({"saphirblau","diamantweiss","smaragdgruen","rubinrot",
  "bernsteinbraun"}));
  gem_name = m_indices(all_colors)[random(5)];
  color = all_colors[ gem_name ];
  klinge = "das Axtblatt";
  long_text =
    "Dieses Beil sieht eigentlich sehr schlicht aus, ein doppelseitiges "
    "Axtblatt befestigt an einem Eichenholzstiel. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Die Klinge schimmert ";

  // start_wc, start_wc_fix, max_wc, max_wc_fix
  set_wc(230,20,290,30);

  SetProp(P_SHORT, "Jemands einzigartige Axt des Sterbens");
  SetProp(P_LONG,
    "Dieses Beil sieht eigentlich sehr schlicht aus, ein doppelseitiges "
    "Axtblatt befestigt an einem Eichenholzstiel. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Halt, doch! Eine seltsame "
    "Ausnehmung befindet sich genau an der Stelle, wo der Stiel im "
    "Beil verschwindet.");

  klingendetailkey = ({"axtblatt", "metall", "klinge"});
  AddDetail( klingendetailkey,
    "Das Axtblatt besteht aus Metall.");

  newklingendetailtext = "Das Axtblatt besteht aus Metall und schimmert "
    + color + ".";

  AddDetail( ({"eichenholzstiel","holz","stiel","eichenholz"}),
    "Der Stiel der Axt besteht eindeutig aus Eichenholz.");

  AddDetail( ({"verzierungen","schnoerkeleien","schnoerkel"}),
    "Nichts dergleichen, nur eine Ausnehmung.");

  AddDetail( ({"ausnehmung"}),
    "Sie schimmert "+color+".");

  SetProp(P_NAME, "Axt des Sterbens"); // muss bleiben, weil unique_master P_NAME verwendet, um
    // den "Spielernames einzigartige Waffe des Sterbens" Namen richtig zu erzeugen
  AddAdjective( ({ "einzigartig", "einzigartige", "einzigartigen", "einzigartiges", 
    "einzigartiger", "einzigartigem" }) );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "beil", "sterbeaxt", "axt des sterbens", "\nsterbewaffe", "\nsfunique"}) );

  SetProp(P_MATERIAL, ([MAT_STEEL:30, MAT_OAK:69, MAT_MISC_MAGIC:1]) );

  SetProp(P_ARTICLE, 0);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_SIZE, 120);
  SetProp(P_VALUE, 100000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_QUALITY_DECAY, 600); // default: 140
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, specified_wc);
  SetProp(P_WC_FIX, specified_wc_fix);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp("waffenbalsam", 10);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS,(["Axtkaempfer":60, "Axtexperte":130, "Axtmeister":250,
                       "meisterschlaechter":400]));

  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:25, P_LEVEL:45, P_XP:25000000]) );

  AddCmd( ({"stecke","steck","stopfe","setze"}), "cmd_edelstein");

  add_rip_dmg();
}

string _query_info() { // --- QUERY INFO ---------------------------------------
  return sterbewaffe::_query_info();
}

int WieldFunc(object waffe) { // --- WIELD FUNC -----------------------------
  return sterbewaffe::WieldFunc(waffe);
}

int UnwieldFunc(object waffe) { // --- UNWIELD FUNC -------------------------
  return sterbewaffe::UnwieldFunc(waffe);
}

int HitFunc( object enemy ) { // --- HIT FUNC ! -----------------------------
  return sterbewaffe::HitFunc(enemy);
}

// ------ RESET() ----------------------------------------------
void reset()
{
  ::reset();
  sterbewaffe::deathtime_message();
  sterbewaffe::disappear();
}