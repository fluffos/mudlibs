// Peitsche des Sterbens
// von Wraz / Mendralim



#include "../def.h"

inherit "std/weapon";
inherit WEAPON "sterbewaffe";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  gems=0;
  all_colors = mkmapping(({"saphir","diamant","smaragd","rubin","bernstein"}),
    ({"saphirblau","diamantweiss","smaragdgruen","rubinrot",
  "bernsteinbraun"}));
  gem_name = m_indices(all_colors)[random(5)];
  color = all_colors[ gem_name ];
  klinge = "die Treibschnur";
  long_text =
    "Diese Peitsche sieht eigentlich sehr schlicht aus, eine Lederschnur "
    "befestigt an einem kurzen Peitschenstiel aus Eichenholz. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Die Treibschnur schimmert ";

  start_wc=145;
  start_wc_fix=15;
  max_wc=195;
  max_wc_fix=25;

  specified_wc=start_wc;
  specified_wc_fix=start_wc_fix;

  SetProp(P_SHORT, "Die Peitsche des Sterbens");
  SetProp(P_LONG,
    "Diese Peitsche sieht eigentlich sehr schlicht aus, eine Lederschnur "
    "befestigt an einem kurzen Peitschenstiel aus Eichenholz. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Halt, doch! Eine seltsame "
    "Ausnehmung befindet sich unten am Stiel.");

  klingendetailkey = ({"lederschnur", "schnur", "leder", "treibschnur",
    "peitschenschnur"});
  AddDetail( klingendetailkey,
    "Die Peitschenschnur inklusive Treibschnur bestehen aus Leder.");

  newklingendetailtext = "Peitschenschnur und Treibschnur bestehen aus Leder. "+
    "Die Treibschnur schimmert "
    + color + ".";

  AddDetail( ({"peitschenstiel","holz","stiel","eichenholz"}),
    "Der Stiel der Peitsche besteht eindeutig aus Eichenholz.");

  AddDetail( ({"verzierungen","schnoerkeleien","schnoerkel"}),
    "Nichts dergleichen, nur eine Ausnehmung.");

  AddDetail( ({"ausnehmung"}),
    "Sie schimmert "+color+".");

  SetProp(P_NAME, "Peitsche des Sterbens");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "sterbepeitsche", "peitsche des sterbens",
    "\nsterbewaffe"}) );

  SetProp(P_MATERIAL, ([MAT_LEATHER:60, MAT_OAK:39, MAT_MISC_MAGIC:1]) );

  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_QUALITY_DECAY, 200); // default: 140
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, specified_wc);
  SetProp(P_WC_FIX, specified_wc_fix);
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp("waffenbalsam", 10);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150,
      "Peitschenmeister":275, "meisterschlaechter":450]) );

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:10, P_LEVEL:10,
    P_XP:2500000]) );

  SetProp(P_INFO, BS("Diese Waffe bezieht Kraft aus Deinen TODEN!"));

  AddCmd( ({"stecke","steck","stopfe","setze"}), "cmd_edelstein");

  if(!random(4)) add_rip_dmg();
}

int WieldFunc(object waffe) { // --- WIELD FUNC -----------------------------
  return sterbewaffe::WieldFunc(waffe);
}

int UnwieldFunc(object waffe) { // --- UNWIELD FUNC -------------------------
  return sterbewaffe::UnwieldFunc(waffe);
}

int HitFunc( object enemy ) { // --- HIT FUNC ! -----------------------------
  return sterbewaffe::HitFunc(enemy);
}

// --- NOTIFY PLAYER DEATH --------------------------------------------------
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  sterbewaffe::NotifyPlayerDeath( victim, killer, lost_xp);
}

// ------ RESET() ----------------------------------------------
void reset()
{
  ::reset();
  sterbewaffe::deathtime_message();
  sterbewaffe::disappear();
}
