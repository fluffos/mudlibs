// Kriegsbogen des Sterbens
// von Wraz / Mendralim

#include "../def.h"

inherit "std/weapon";
inherit WEAPON "sterbewaffe";

void create()
{
  if(is_clone(TO)) { TO->remove(); return;} // unique

  ::create();

  gems=0;
  all_colors = mkmapping(({"saphir","diamant","smaragd","rubin","bernstein"}),
    ({"saphirblau","diamantweiss","smaragdgruen","rubinrot",
  "bernsteinbraun"}));
  gem_name = m_indices(all_colors)[random(5)];
  color = all_colors[ gem_name ];
  klinge = "die Bogensehne";
  long_text =
    "Dieser Kriegsbogen sieht eigentlich sehr schlicht aus, eine "
    "Sehne und ein Eichenholzbogen. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Die Sehne allerdings schimmert ";

  set_wc(230,20,290,30);

  SetProp(P_SHORT, "Jemands einzigartiger Kriegsbogen des Sterbens");
  SetProp(P_LONG,
    "Dieser Kriegsbogen sieht eigentlich sehr schlicht aus, eine "
    "Sehne und ein Eichenholzbogen. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Halt, doch! Eine seltsame "
    "Ausnehmung befindet sich am Mittelteil des Bogens.");

  klingendetailkey = ({"sehne", "bogensehne", "kriegsbogensehne", "tiersehne"});
  AddDetail( klingendetailkey,
    "Die Sehne des Kriegsbogens besteht aus einer Tiersehne.");

  newklingendetailtext = "Die Kriegsbogensehne besteht aus einer Tiersehne und schimmert "
    + color + ".";

  AddDetail( ({"mittelteil"}),
    "Das Mittelteil des Kriegsbogens besteht aus Eichenholz.");

  AddDetail( ({"eichenholzbogen","holz","eichenholz"}),
    "Der Kriegsbogen besteht eindeutig aus Eichenholz.");

  AddDetail( ({"verzierungen","schnoerkeleien","schnoerkel"}),
    "Nichts dergleichen, nur eine Ausnehmung.");

  AddDetail( ({"ausnehmung"}),
    "Sie schimmert "+color+".");

  SetProp(P_NAME, "Kriegsbogen des Sterbens");
  AddAdjective( ({ "einzigartig", "einzigartige", "einzigartigen", "einzigartiges", 
    "einzigartiger", "einzigartigem" }) );
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "kriegsbogen", "sterbekriegsbogen", "kriegsbogen des sterbens",
    "\nsterbewaffe", "\nsfunique"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_DEAD:19, MAT_OAK:80, MAT_MISC_MAGIC:1]) );

  SetProp(P_ARTICLE, 0);
  SetProp(P_WEIGHT, 2400);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 100000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_QUALITY_DECAY, 600); // default: 140
  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_WC, specified_wc);
  SetProp(P_WC_FIX, specified_wc_fix);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp("waffenbalsam", 10);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS,(["Bogenkaempfer":50, "Bogenexperte":150, 
    "Bogenmeister":250, "meisterschlaechter":400]));

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:25, P_LEVEL:45, P_XP:25000000]) );

  AddCmd( ({"stecke","steck","stopfe","setze"}), "cmd_edelstein");

  add_rip_dmg();
}

string _query_info() { // --- QUERY INFO ---------------------------------------
  return sterbewaffe::_query_info();
}

int WieldFunc(object waffe) { // --- WIELD FUNC -----------------------------
  return sterbewaffe::WieldFunc(waffe);
}

int UnwieldFunc(object waffe) { // --- UNWIELD FUNC -------------------------
  return sterbewaffe::UnwieldFunc(waffe);
}

int HitFunc( object enemy ) { // --- HIT FUNC ! -----------------------------
  return sterbewaffe::HitFunc(enemy);
}

// ------ RESET() ----------------------------------------------
void reset()
{
  ::reset();
  sterbewaffe::deathtime_message();
  sterbewaffe::disappear();
}