// Dolch der Nekromantenfee
// Pfad bei Schlachtfeld
// von Wraz / Mendralim

#include "../def.h"

inherit "std/weapon";

object me=TO;
int last_align_change;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  last_align_change=0;

  SetProp(P_SHORT, "Der Dolch der Nekromantenfee");
  SetProp(P_LONG,
    "Dieser Dolch ist eine sehr gefinkelte Waffe. Vorne ist er rund und breit, "
    "hinten schmal. Der Griff besteht aus Kork und ist daher sehr leicht. "
    "Der Dolch gehoerte einst der Feenekromantin. Diese "
    "ungewoehnliche, aber dadurch umso diabolischere Kombination hat "
    "unheilige Maechte in dem Dolch vereinigt!");

  AddDetail( ({"griff","kork"}),
    "Der Griff besteht aus Kork und ist somit leicht und robust.");

  AddDetail( ({"feenekromantin"}),
    "Unvorstellbar, dass soetwas existiert.");

  AddDetail( ({"maechte"}),
    "Mit dieser Waffe wirst Du Deinen Feind hinterhaeltig vernichten.");

  SetProp(P_NAME, "Dolch der Nekromantenfee");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "dolch der nekromantenfee"}) );

  SetProp(P_MATERIAL, ([MAT_STEEL:70,MAT_CORK:20,MAT_MISC_UNHOLY:10]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_SIZE, 35); // 30
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 155); // 170
  SetProp(P_WC_FIX, 65); // 80
  SetProp(P_DAM_TYPE, ({DT_PIERCE,DT_RIP}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":120, "Messermeister":220]) );

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:22,P_LEVEL:30]) );

  SetProp(P_INFO, BS(
    "Die Abrundung vorne bewirkt, dass man beim Zustossen "
    "in den Brustkorb am Knochen nicht haengen bleibt. Dadurch, dass der Dolch "
    "hinten schmaeler ist kann man die Waffe im Koerper des Gegners leichter "
    "drehen und richtet so den groesstmoeglichen Schaden an! Eine sehr "
    "gefinkelte Waffe!"));
}

int WieldFunc(object waffe) {
  int align;

  if(last_align_change<(time()-7200)&&TP->QueryProp(P_ALIGN)>-970)
  {
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-30);
    write(BS(
      "Dein Gesicht verzerrt sich zu einer boesen Grimasse!"));
    last_align_change=time();
    return 1;
  }

  else return 1;
}

int HitFunc( object enemy )
{
  if(!random(TP->QueryProp(P_HP)<(TP->QueryProp(P_MAX_HP)/10)?5:12))
  { // weniger als 1/10 der maximalen LP -> wahrscheinlichkeit erhoeht auf 1:5

  if(!random(TP->QueryProp(P_HP)<(TP->QueryProp(P_MAX_HP)/10)?5:40))
  { // siehe oben
    write(BS(
      "Mit GEWALTIGER KRAFT stoesst Du den Dolch bis zum Griff in den Koerper "
      +enemy->name(WESSEN,1)+", drehst ihn wild umher und reisst ihn mit einem "
      "Ruck wieder heraus!"));
    say(BS(
      capitalize(TPN)+" stoesst "
      +TP->QueryPossPronoun(MALE,WEN,SINGULAR)+" Dolch bis zum Anschlag in den Koerper "
      +enemy->name(WESSEN,1)+
      ", dreht ihn um und reisst ihn kraftvoll wieder heraus!!"),
      ({TP,enemy}) );
    tell_object(enemy, BS(
      capitalize(TPN)+" stoesst Dir "+TP->QueryPossPronoun(MALE,WEN,SINGULAR)+
      " Dolch bis zum Anschlag in den Brustkorb, dreht ihn um und reisst ihn "
      "kraftvoll wieder heraus!!! Du schreist von Schmerz gequaelt auf!!"));
    return 1400;
  }

  else {
  write(BS(
    "Du rammst wuetend Deinen Dolch in "+enemy->name(WESSEN,1)+" Koerper!"));
  say(BS(
    capitalize(TPN)+" rammt "+TP->QueryPossPronoun(MALE,WEN,SINGULAR)+
    " Dolch wuetend in "+enemy->name(WESSEN,1)+" Koerper!"),
    ({TP,enemy}) );
  tell_object(enemy,BS(
    capitalize(TPN)+" rammt Dir wuetend "+TP->QueryPossPronoun(MALE,WEN,SINGULAR)+
    " Dolch in den Koerper!"));
  return 150+random(100); }
  }
  else return 0;
}
