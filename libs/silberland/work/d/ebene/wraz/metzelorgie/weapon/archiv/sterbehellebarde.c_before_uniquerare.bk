// Hellebarde des Sterbens
// von Wraz / Mendralim



#include "../def.h"

inherit "std/weapon";
inherit WEAPON "sterbewaffe";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  gems=0;
  all_colors = mkmapping(({"saphir","diamant","smaragd","rubin","bernstein"}),
    ({"saphirblau","diamantweiss","smaragdgruen","rubinrot",
  "bernsteinbraun"}));
  gem_name = m_indices(all_colors)[random(5)];
  color = all_colors[ gem_name ];
  klinge = "das Axtblatt";
  long_text =
    "Diese Hellebarde sieht eigentlich sehr schlicht aus, eine Spitze mit "
    "Axtblatt befestigt an einem langen Eichenholzsschaft. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Die Spitze schimmert ";

  start_wc=225;
  start_wc_fix=25;
  max_wc=285;
  max_wc_fix=35;

  specified_wc=start_wc;
  specified_wc_fix=start_wc_fix;

  SetProp(P_SHORT, "Die Hellebarde des Sterbens");
  SetProp(P_LONG,
    "Diese Hellebarde sieht eigentlich sehr schlicht aus, eine Spitze mit "
    "Axtblatt befestigt an einem langen Eichenholzstiel. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Halt, doch! Eine seltsame "
    "Ausnehmung befindet sich genau an der Stelle, wo der Stiel in der "
    "Spitze verschwindet.");

  klingendetailkey = ({"axtblatt", "metall", "spitze"});
  AddDetail( klingendetailkey,
    "Spitze und Axtblatt bestehen aus Metall.");

  newklingendetailtext = "Spitze und Axtblatt bestehen aus Metall und schimmern "
    + color + ".";

  AddDetail( ({"eichenholzstiel","holz","stiel","eichenholz"}),
    "Der Schaft der Hellebarde besteht eindeutig aus Eichenholz.");

  AddDetail( ({"verzierungen","schnoerkeleien","schnoerkel"}),
    "Nichts dergleichen, nur eine Ausnehmung.");

  AddDetail( ({"ausnehmung"}),
    "Sie schimmert "+color+".");

  SetProp(P_NAME, "Hellebarde des Sterbens");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hellebarde", "speer", "sterbespeer", "hellebarde des sterbens",
    "\nsterbewaffe"}) );

  SetProp(P_MATERIAL, ([MAT_STEEL:30, MAT_OAK:69, MAT_MISC_MAGIC:1]) );

  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 3500);
  SetProp(P_SIZE, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_QUALITY_DECAY, 200); // default: 140
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, specified_wc);
  SetProp(P_WC_FIX, specified_wc_fix);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp("waffenbalsam", 10);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["Speerkaempfer":50, "Speerexperte":150,
    "Speermeister":250, "meisterschlaechter":400]));

  SetProp(P_WIELD_RESTRICTIONS, ([P_SIZE:155, A_STR:12, P_LEVEL:10,
    P_XP:2500000]) );

  SetProp(P_INFO, BS("Diese Waffe bezieht Kraft aus Deinen TODEN!"));

  AddCmd( ({"stecke","steck","stopfe","setze"}), "cmd_edelstein");

  if(!random(6)) add_rip_dmg();
}

int WieldFunc(object waffe) { // --- WIELD FUNC -----------------------------
  return sterbewaffe::WieldFunc(waffe);
}

int UnwieldFunc(object waffe) { // --- UNWIELD FUNC -------------------------
  return sterbewaffe::UnwieldFunc(waffe);
}

int HitFunc( object enemy ) { // --- HIT FUNC ! -----------------------------
  return sterbewaffe::HitFunc(enemy);
}

// --- NOTIFY PLAYER DEATH --------------------------------------------------
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  sterbewaffe::NotifyPlayerDeath( victim, killer, lost_xp);
}

// ------ RESET() ----------------------------------------------
void reset()
{
  ::reset();
  sterbewaffe::deathtime_message();
  sterbewaffe::disappear();
}
