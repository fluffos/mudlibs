// Unique Dolch des Sterbens
// von Wraz / Mendralim


#include "../def.h"

inherit "std/weapon";
inherit WEAPON "sterbewaffe";

void create()
{
  if(is_clone(TO)) { TO->remove(); return;} // unique

  ::create();

  gems=0;
  all_colors = mkmapping(({"saphir","diamant","smaragd","rubin","bernstein"}),
    ({"saphirblau","diamantweiss","smaragdgruen","rubinrot",
  "bernsteinbraun"}));
  gem_name = m_indices(all_colors)[random(5)];
  color = all_colors[ gem_name ];
  klinge = "die Klinge";
  long_text =
    "Dieser Dolch sieht eigentlich sehr schlicht aus, eine zweischneidige "
    "Klinge mit einem Eichenholzgriff. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Die Klinge schimmert ";

  set_wc(80,30,140,55);

  SetProp(P_SHORT, "Jemands einzigartiger Dolch des Sterbens");
  SetProp(P_LONG,
    "Dieser Dolch sieht eigentlich sehr schlicht aus, eine zweischneidige "
    "Klinge mit einem Eichenholzgriff. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Halt, doch! Eine seltsame "
    "Ausnehmung befindet sich oberhalb des Griffs an der Klinge.");

  klingendetailkey = ({"klinge", "zweischneidige klinge", "dolchklinge",
    "metall"});
  AddDetail( klingendetailkey,
    "Die Dolchklinge besteht aus Metall.");

  newklingendetailtext = "Die Dolchklinge besteht aus Metall und schimmert "
    + color + ".";

  AddDetail( ({"eichenholzgriff","holz","griff","eichenholz"}),
    "Das Griff des Dolchs besteht eindeutig aus Eichenholz.");

  AddDetail( ({"verzierungen","schnoerkeleien","schnoerkel"}),
    "Nichts dergleichen, nur eine Ausnehmung.");

  AddDetail( ({"ausnehmung"}),
    "Sie schimmert "+color+".");

  SetProp(P_NAME, "Dolch des Sterbens"); // muss bleiben, weil unique_master P_NAME verwendet, um
    // den "Spielernames einzigartige Waffe des Sterbens" Namen richtig zu erzeugen
  AddAdjective( ({ "einzigartig", "einzigartige", "einzigartigen", "einzigartiges", 
    "einzigartiger", "einzigartigem" }) );
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "sterbedolch", "dolch des sterbens",
    "\nsterbewaffe", "\nsfunique"}) );

  SetProp(P_MATERIAL, ([MAT_STEEL:70, MAT_OAK:29, MAT_MISC_MAGIC:1]) );

  SetProp(P_ARTICLE, 0);
  SetProp(P_WEIGHT, 700);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 100000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_QUALITY_DECAY, 600); // default: 140
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, specified_wc);
  SetProp(P_WC_FIX, specified_wc_fix);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1); SetProp("one_hand_update", 1); // Kompatibilitaet mit alten Waffen in weapon_master
  SetProp("waffenbalsam", 10);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS,(["Messerkaempfer":50, "Messerexperte":150,
                       "Messermeister":250, "meisterschlaechter":400]));

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:25, P_LEVEL:45, P_XP:25000000]) );

  AddCmd( ({"stecke","steck","stopfe","setze"}), "cmd_edelstein");

  add_rip_dmg();
}

string _query_info() { // --- QUERY INFO ---------------------------------------
  return sterbewaffe::_query_info();
}

int WieldFunc(object waffe) { // --- WIELD FUNC -----------------------------
  return sterbewaffe::WieldFunc(waffe);
}

int UnwieldFunc(object waffe) { // --- UNWIELD FUNC -------------------------
  return sterbewaffe::UnwieldFunc(waffe);
}

int HitFunc( object enemy ) { // --- HIT FUNC ! -----------------------------
  return sterbewaffe::HitFunc(enemy);
}

// ------ RESET() ----------------------------------------------
void reset()
{
  ::reset();
  sterbewaffe::deathtime_message();
  sterbewaffe::disappear();
}
