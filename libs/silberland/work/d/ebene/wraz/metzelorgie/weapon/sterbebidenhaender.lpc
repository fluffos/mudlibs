// Bidenhaender des Sterbens
// von Wraz / Mendralim


#include "../def.h"

inherit "std/weapon";
inherit WEAPON "sterbewaffe";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  gems=0;
  all_colors = mkmapping(({"saphir","diamant","smaragd","rubin","bernstein"}),
    ({"saphirblau","diamantweiss","smaragdgruen","rubinrot",
  "bernsteinbraun"}));
  gem_name = m_indices(all_colors)[random(5)];
  color = all_colors[ gem_name ];
  klinge = "die Schwertklinge";
  long_text =
    "Dieser riesige Bidenhaender sieht, abgesehen von seiner Groesse, "
    "eigentlich sehr schlicht aus. Er besitzt eine zweischneidige "
    "Klinge mit einem grossen Eichenholzheft. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Die Klinge schimmert ";

  set_wc(220,40,280,50);

  SetProp(P_SHORT, "Der Bidenhaender des Sterbens");
  SetProp(P_LONG,
    "Dieser riesige Bidenhaender sieht, abgesehen von seiner Groesse, "
    "eigentlich sehr schlicht aus. Er besitzt eine zweischneidige "
    "Klinge mit einem grossen Eichenholzheft. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Halt, doch! Eine seltsame "
    "Ausnehmung befindet sich oberhalb des Hefts an der Klinge.");

  klingendetailkey = ({"klinge", "zweischneidige klinge", "schwertklinge",
    "metall"});
  AddDetail( klingendetailkey,
    "Die Schwertklinge des Bidenhaenders besteht aus Metall.");

  newklingendetailtext = "Die Schwertklinge des Bidenhaenders besteht aus "
    "Metall und schimmert " + color + ".";

  AddDetail( "groesse",
    "Die Groesse des Bidenhaenders ist beeindruckend.");

  AddDetail( ({"eichenholzheft","holz","heft","eichenholz"}),
    "Das Heft des Schwerts besteht eindeutig aus Eichenholz.");

  AddDetail( ({"verzierungen","schnoerkeleien","schnoerkel"}),
    "Nichts dergleichen, nur eine Ausnehmung.");

  AddDetail( ({"ausnehmung"}),
    "Sie schimmert "+color+".");

  SetProp(P_NAME, "Bidenhaender des Sterbens");
  SetProp(P_GENDER, MALE);
  AddId( ({"bidenhaender", "schwert", "sterbebidenhaender",
    "bidenhaender des sterbens", "\nsterbewaffe"}) );

  SetProp(P_MATERIAL, ([MAT_STEEL:70, MAT_OAK:29, MAT_MISC_MAGIC:1]) );

  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_SIZE, 213);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_QUALITY_DECAY, 200); // default: 140
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, specified_wc);
  SetProp(P_WC_FIX, specified_wc_fix);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp("waffenbalsam", 10);
  SetProp("first_query", 1); // wird in _query_info() in sterbewaffe.c beim ersten ident auf 0 gesetzt

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS,(["Schwertkaempfer":40, "Schwertexperte":130,
                       "Schwertmeister":270, "meisterschlaechter":450]));

  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:16, P_LEVEL:10, P_XP:2500000]) );

  AddCmd( ({"stecke","steck","stopfe","setze"}), "cmd_edelstein");

  if(!random(10)) add_rip_dmg();
}

string _query_info() { // --- QUERY INFO ---------------------------------------
  return sterbewaffe::_query_info();
}

int WieldFunc(object waffe) { // --- WIELD FUNC -----------------------------
  return sterbewaffe::WieldFunc(waffe);
}

int UnwieldFunc(object waffe) { // --- UNWIELD FUNC -------------------------
  return sterbewaffe::UnwieldFunc(waffe);
}

int HitFunc( object enemy ) { // --- HIT FUNC ! -----------------------------
  return sterbewaffe::HitFunc(enemy);
}

// --- NOTIFY PLAYER DEATH --------------------------------------------------
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  sterbewaffe::NotifyPlayerDeath( victim, killer, lost_xp);
}

// ------ RESET() ----------------------------------------------
void reset()
{
  ::reset();
  sterbewaffe::deathtime_message();
  sterbewaffe::disappear();
}
