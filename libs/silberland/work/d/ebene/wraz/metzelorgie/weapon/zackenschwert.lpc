/*
** Ein Zackenschwert
** von Wraz / Mendralim
** Vorlage: Mithrilschwert (Woody)
*/

inherit "std/weapon";

#include "../def.h"

int mywc;

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schwert", "zackenschwert"}));
  SetProp (P_SHORT, "Ein orkisches Zackenschwert");
  SetProp (P_LONG,
    "Das orkische Zackenschwert ist eine beliebte Waffe unter Orks. Die "
    "Klinge ist breit und hoch, an der Spitze nochmals extra breit und biegt "
    "sich etwas nach oben. Auffaellig sind vor allem die Zacken, die sich an "
    "beiden Seiten der Klinge befinden.");
  AddDetail("klinge", "Die Klinge ist wenig scharf, aber die Zacken sehen "
                      "furchtbar aus.");
  AddDetail("zacken", "Die Zacken an der Klinge verursachen bestimmt schlimme "
                      "Wunden.");
  SetProp (P_NAME, "Zackenschwert");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 3000);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_RIP);
  SetProp (P_WC, mywc = 130+random(20)+ (!random(350)?50:0) );
  SetProp (P_WC_FIX, 30); // default
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_MISC_METAL); // default
  SetProp(P_INFO, break_string("Orks sind wahrlich keine Meister der "
    "Schmiedekunst, aber" +
    (mywc > 145 ?
      (mywc > 179 ? " dieses Schwert muss das Lebenswerk eines einzigartigen "
       "Orkschmieds gewesen sein!" :
       " bei genauerer Betrachtung bist du der Ansicht, dass du ein "
       "Schwert eines ungewoehnlich begabten Orkschmieds in Haenden haeltst.") :
    " die Zacken an der Klinge sind eine Besonderheit.") ));
  SetProp (P_WC_BONUS, ([ "Ork" : 50 ]) );
  if(mywc > 179)
  {
    SetProp (P_WC_FIX, 40+random(10));
    SetProp (P_VALUE, 4000);
  }
}
