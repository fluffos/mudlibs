// Kriegshammer des Sterbens
// von Wraz / Mendralim



#include "../def.h"

inherit "std/weapon";
inherit WEAPON "sterbewaffe";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  gems=0;
  all_colors = mkmapping(({"saphir","diamant","smaragd","rubin","bernstein"}),
    ({"saphirblau","diamantweiss","smaragdgruen","rubinrot",
  "bernsteinbraun"}));
  gem_name = m_indices(all_colors)[random(5)];
  color = all_colors[ gem_name ];
  klinge = "der Hammerkopf";
  long_text =
    "Dieser Kriegshammer sieht eigentlich sehr schlicht aus, ein auf beiden "
    "Seiten flacher Hammerkopf an einem Eichenholzstiel. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Der Hammerkopf schimmert ";

  start_wc=205;
  start_wc_fix=45;
  max_wc=265;
  max_wc_fix=55;

  specified_wc=start_wc;
  specified_wc_fix=start_wc_fix;

  SetProp(P_SHORT, "Der Kriegshammer des Sterbens");
  SetProp(P_LONG,
    "Dieser Kriegshammer sieht eigentlich sehr schlicht aus, ein auf beiden "
    "Seiten flacher Hammerkopf an einem Eichenholzstiel. Keine besonderen "
    "Verzierungen oder Schnoerkeleien. Halt, doch! Eine seltsame "
    "Ausnehmung befindet sich oberhalb des Stiels am Hammerkopf.");

  klingendetailkey = ({"hammerkopf", "kopf", "metall"});
  AddDetail( klingendetailkey,
    "Der Hammerkopf des Kriegshammers besteht aus Metall.");

  newklingendetailtext = "Der Hammerkopf des Kriegshammers besteht aus "
    "Metall und schimmert " + color + ".";

  AddDetail( ({"seiten", "seite"}),
    "Der Hammerkopf ist auf beiden Seiten flach.");

  AddDetail( ({"eichenholzstiel","holz","stiel","eichenholz"}),
    "Der Stiel des Kriegshammers besteht eindeutig aus Eichenholz.");

  AddDetail( ({"verzierungen","schnoerkeleien","schnoerkel"}),
    "Nichts dergleichen, nur eine Ausnehmung.");

  AddDetail( ({"ausnehmung"}),
    "Sie schimmert "+color+".");

  SetProp(P_NAME, "Kriegshammer des Sterbens");
  SetProp(P_GENDER, MALE);
  AddId( ({"kriegshammer", "hammer", "sterbekriegshammer",
    "kriegshammer des sterbens", "\nsterbewaffe"}) );

  SetProp(P_MATERIAL, ([MAT_STEEL:70, MAT_OAK:29, MAT_MISC_MAGIC:1]) );

  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 5500);
  SetProp(P_SIZE, 110);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_QUALITY_DECAY, 200); // default: 140
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, specified_wc);
  SetProp(P_WC_FIX, specified_wc_fix);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp("waffenbalsam", 10);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS,(["Keulenkaempfer":70, "Keulenexperte":130,
                       "Keulenmeister":230, "meisterschlaechter":400]));

  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:22, P_LEVEL:12, P_XP:2500000]) );

  SetProp(P_INFO, BS("Diese Waffe bezieht Kraft aus Deinen TODEN!"));

  AddCmd( ({"stecke","steck","stopfe","setze"}), "cmd_edelstein");

  if(!random(8)) add_rip_dmg();
}

int WieldFunc(object waffe) { // --- WIELD FUNC -----------------------------
  return sterbewaffe::WieldFunc(waffe);
}

int UnwieldFunc(object waffe) { // --- UNWIELD FUNC -------------------------
  return sterbewaffe::UnwieldFunc(waffe);
}

int HitFunc( object enemy ) { // --- HIT FUNC ! -----------------------------
  return sterbewaffe::HitFunc(enemy);
}

// --- NOTIFY PLAYER DEATH --------------------------------------------------
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  sterbewaffe::NotifyPlayerDeath( victim, killer, lost_xp);
}

// ------ RESET() ----------------------------------------------
void reset()
{
  ::reset();
  sterbewaffe::deathtime_message();
  sterbewaffe::disappear();
}
