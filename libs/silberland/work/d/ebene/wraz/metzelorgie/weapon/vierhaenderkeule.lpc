// Vierhaenderkeule der Zyklopen, ist gleichzeitig ein Bling-Sammelobjekt
// Pfad beim Schlachtfeld
// von Wraz / Mendralim

#include "../def.h"

inherit "std/weapon";

int cvalue;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Vierhaenderkeule");
  SetProp(P_LONG,
    "Die Vierhaenderkeule ist gigantisch gross, sodass ein normales "
    "Lebewesen, nichteinmal ein riesiger Troll, sie fuehren kann. Sonst "
    "unterscheidet sie sich eigentlich nicht von einer normalen Keule.");

  SetProp(P_NAME, "Vierhaenderkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"vierhaenderkeule", "keule"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:100]) );
  SetProp(P_WEIGHT, 20000);
  SetProp(P_SIZE, 210);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 300);
  SetProp(P_WC_FIX, 25);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON,DT_SQUEEZE}) );
  SetProp(P_NR_HANDS, 4);

  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));

  SetProp(P_INFO, BS("Diese maechtige Waffe kann man nur mit vier Armen "
  "fuehren!"));
}

int HitFunc( object enemy )
{
  object pl;
  pl=TO->QueryProp(P_WIELDED);

  if(!pl) return 0;
  if(pl->QueryProp(P_MAX_HANDS)<4)
  {
    DoUnwield();
    if(!TP->QueryProp(P_WIELDED)) pl->Message(BS(
     "Da Du nicht genuegend Haende frei hast, kannst Du die Keule nicht "
     "mehr fuehren."));
    return 0;
  }

  if(!random(4))  return 100+random(300);
  else return random(30);
}

int set_collector_value(int value)
{
  cvalue=value;
  return cvalue;
}

int query_collector_value()
{
  return cvalue;
}
