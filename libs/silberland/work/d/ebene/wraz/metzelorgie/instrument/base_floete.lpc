/* Elfenfloete
** 
** by Andyl@Silberland
**
** 1998-08-01
** Last updated: 1999-05-26
*/

inherit "/p/std/barden/instrument";

#include "../bardengilde.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_INSTRUMENT_TYPE, IT_WIND);
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_INSTRUMENT_MESSAGES, ({
    ({"Du pfeifst ein paar schrille Toene.", "@WER pfeift auf @WESSEN @INSTRUMENT ein paar schiefe Toene."}), // Fehlschlag
    ({"Du spielst mit @INSTRUMENT3 die Tonleiter hoch und runter.", "@WER spielt die Tonleiter auf @INSTRUMENT3."}), // 1000
    ({"Du spielst ein einfaches Lied auf @INSTRUMENT3.", "@WER spielt ein einfaches Lied auf @INSTRUMENT3."}), // 2000
    ({"Du spielst ein kurzes Lied mit einfachen Harmonien.","@WER spielt auf @INSTRUMENT3 ein kurzes Lied mit einfachen Harmonien."}), // 3000
    ({"Du spielst eine rhytmische und harmonische Melodie auf @INSTRUMENT3.","@WER spielt eine rhytmische und harmonische Melodie auf @INSTRUMENT3."}), // 4000
    ({"Du spielst ein schnelles, melodisches Lied auf @INSTRUMENT3, das deine Zuhoerer zum Mitwippen bringt.",
      "@WER spielt ein schnelles, melodisches Lied auf @INSTRUMENT3. DU merkst, dass dein Fuss im Takt mitwippt."}), // 5000
    ({"Du spielst ein Lied mit vielen wechselnden Harmonien, das durchaus anregend wirkt.",
      "@WER spielt ein Lied mit vielen wechselnden Harmonien, das durchaus anregend wirkt."}), // 6000
    ({"Du floetest eine rasche Folge wechselnder Toene, wie ein lustiges Hobbittanzlied.",
      "@WER floetet auf @INSTRUMENT3 eine rasche Folge wechselnder Toene, die wie ein lustiges Hobbittanzlied klingen. Gerne wuerdest du dazu tanzen!"}), // 7000
    ({"Du entlockst deiner Floete ein heiteres Lied, das du im Huegelland aufgeschnappt hast. Dein Publikum tanzt dazu und ist gut gelaunt.",
      "@WER entlockt @INSTRUMENT3 ein heiteres Lied. Es klingt ein wenig nach einem Hirtenlied aus dem Huegelland. Gut gelaunt tanzt du dazu."}), // 8000
    ({"Du spielst ein komplexes althergebrachtes Elfenlied auf @INSTRUMENT3. Dein Publikum lauscht andaechtig.",
      "@WERN spielt ein komplexes althergebrachtes Elfenlied auf @INSTRUMENT3. Du lauschst andaechtig."}), // 9000
    ({"Du entlockst @INSTRUMENT eine Reihe ineinander verwobener Harmonien und Rhythmen. Ueberirdische Klaenge erfuellen den Raum. Dein Publikum tanzt begeistert mit!",
      "@WER entlockt @INSTRUMENT3 eine Reihe komplex ineinander verwobener Harmonien und Rhythemn. Ueberirdische Klaenge erfuellen den Raum. Begeistert schwingst du das Tanzbein!"}), // 10000+
  }));

  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "in der Hand gehalten");
}














