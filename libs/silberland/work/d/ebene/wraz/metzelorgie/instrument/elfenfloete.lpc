inherit "/gilden/bardengilde/instrument/base_floete";

#include "/gilden/bardengilde/bardengilde.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Elfenfloete");
  SetProp(P_LONG, 
	  BS("Die Elfenfloete besteht zur Gaenze aus "
	     +"Holz. Sie ist etwas laenger als die "
	     +"Kristallfloete und hat insgesamt acht "
	     +"Loecher. Davon ist ein Loch an der Unterseite "
	     +"und die restlichen sieben Loecher an der Oberseite. "
	     +"Sie erzeugt angenehme Tiefe Klaenge.\n")); 
  SetProp(P_NAME, "Elfenfloete");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"elfenfloete", "floete"}) );

  SetProp(P_INSTRUMENT_LEVEL, 3);

  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
}














