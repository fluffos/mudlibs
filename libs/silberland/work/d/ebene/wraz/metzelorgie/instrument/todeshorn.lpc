#include "../def.h"

//inherit "/p/std/barden/instrument";
inherit "/d/ebene/wraz/metzelorgie/instrument/sterbeinstrument";

//#include "/gilden/bardengilde/bardengilde.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>

#include "/p/daemon/itemd/itemd.h"

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Todeshorn");
  SetProp(P_LONG,
          BS("Das Todeshorn hat eine duestere Ausstrahlung. Es erinnert an ein "
             "stark gebogenes Horn eines Steinbocks, ist jedoch deutlich dicker."));
  SetProp(P_NAME, "Todeshorn");
  SetProp(P_GENDER, NEUTER);
  AddId(({"todeshorn", "horn"}));

  SetProp(P_HANDS, 1);
  SetProp(P_AC, 1); // "Limit" (kein technisches Limit) fuer Instrumente: 15
  SetProp(P_MATERIAL, ([MAT_HORN:99, MAT_MISC_MAGIC:1]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WORN_TEXT, "in der Hand gehalten");
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);

  SetProp(P_INFO, "Dieses Instrument wird seine ganze Macht erst dann entfalten, "
                  "wenn Du mit ihm bis in den TOD gegangen bist!");

  SetProp(P_ITEMD_TMPMAGIC, ({4480, 4480}) ); // ca. 140 Tage
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  SetProp(P_MAGIC, 1);

  SetProp(P_INSTRUMENT_TYPE, IT_WIND);
  SetProp(P_INSTRUMENT_LEVEL, 4);
  SetProp(P_INSTRUMENT_MESSAGES,
          ({
              ({"Du blaest kraeftig in @INSTRUMENT, doch ausser heisser Luft und ein wenig Spucke kommt nichts heraus.",
                "@WER blaest kraeftig in @WESSEN @INSTRUMENT, doch es kommt kein Ton heraus."}),                     // Fehlschlag
              ({"Du spielst mit @INSTRUMENT3 einen satten Ton.", "@WER spielt einen satten Ton auf @INSTRUMENT3."}), // 1000
              ({"Du spielst eine einfache Abfolge von Toenen auf @INSTRUMENT3.",
                "@WER spielt eine einfache Abfolge von Toenen auf @INSTRUMENT3."}), // 2000
              ({"Du spielst eine sehr simple aber harmonische Tonfolge.",
                "@WER spielt auf @INSTRUMENT3 eine sehr simple aber harmonische Tonfolge."}), // 3000
              ({"Du spielst eine simple und harmonische Tonfolge auf @INSTRUMENT3.",
                "@WER spielt eine simple und harmonische Tonfolge auf @INSTRUMENT3."}), // 4000
              ({"Du spielst eine tiefe, langsame Melodie auf @INSTRUMENT3, die eine leichte Gaensehaut erzeugt.",
                "@WER spielt eine tiefe, langsame Melodie auf @INSTRUMENT3. Du bekommst eine leichte Gaensehaut."}), // 5000
              ({"Du spielst eine tiefe Melodie auf @INSTRUMENT3, die Deine Zuhoerer beeindruckt.",
                "@WER spielt eine tiefe Melodie, die Dich beeindruckt."}), // 6000
              ({"Du entlockst @INSTRUMENT3 schwere, lange Toene. Deine Zuhoerer blicken ernst.",
                "@WER spielt auf @INSTRUMENT3 schwere, lange Toene, die Dich ergreifen."}), // 7000
              ({"Du spielst eine dunkle, ergreifende Melodie auf @INSTRUMENT3 und fuehlst die Ergriffenheit Deines Publikums.",
                "@WER spielt eine dunkle Melodie auf @INSTRUMENT3. Gebannt lauschst Du."}), // 8000
              ({"Du spielst eine theatralische Moll-Melodie auf @INSTRUMENT3. Deine Zuhoerer*innen wirken wie in Trance.",
                "@WER spielt eine theatralische Moll-Melodie auf @INSTRUMENT3. Du fuehlst Dich wie in Trance."}), // 9000
              ({"Du spielst den sagenhaften duesteren Todesmarsch auf @INSTRUMENT3!",
                "@WER spielt den sagenhaften duesteren Todesmarsch auf @INSTRUMENT3!"}), // 10000+
          }));
}


// --- NOTIFY PLAYER DEATH --------------------------------------------------
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  sterbeinstrument::AddDeaths( victim, killer, lost_xp);
}


// --- RemoveFunc ---------------------------------------------
int RemoveFunc(object ruest, int silent)
{
  return sterbeinstrument::RemoveFunc(ruest,silent);
}

// --- WearFunc ----------------------------------------------------------
int WearFunc(object ruest, int silent)
{
  return sterbeinstrument::WearFunc(ruest,silent);
}

// --- reset --------------------------------------------------------------
void reset()
{
  ::reset();
}