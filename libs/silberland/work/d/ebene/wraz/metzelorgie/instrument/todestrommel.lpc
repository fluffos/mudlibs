#include "../def.h"

//inherit "/p/std/barden/instrument";
inherit "/d/ebene/wraz/metzelorgie/instrument/sterbeinstrument";

//#include "/gilden/bardengilde/bardengilde.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>

#include "/p/daemon/itemd/itemd.h"

create()
{
  if (!is_clone(TO))
    return;
  ::create();

  SetProp(P_SHORT, "Eine Todestrommel");
  SetProp(P_LONG,
          BS("Die Todestrommel hat eine duestere Ausstrahlung. Sie besteht aus einem "
            "gebleichten, polierten Trollschaedel, der mit Haeuten bespannt wurde. Der "
            "Schlaegel ist ein kleinerer Knochen."));
  AddDetail(({"trollschaedel","schaedel"}),
    "Bei einem Schaedel von diesem Ausmass muss es sich um einen Troll handeln. Dir schaudert.");

  AddDetail(({"haut","haeute"}),
    "Du willst gar nicht genau wissen, um welche Haut es sich hier handelt. Vermutlich Feen, "
    "oder gar Feenkinder... Das traust Du dem Meisterschlaechter alles zu.");

  AddDetail(({"knochen","hobbitoberschenkel","oberschenkelknochen"}),
    "Der Schlaegel besteht aus einem Knochen, Du vermutest ein Oberschenkelknochen. Von der "
    "Groesse tippst Du auf einen Hobbitoberschenkel.");

  SetProp(P_NAME, "Todestrommel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"todestrommel", "trommel"}));

  SetProp(P_HANDS, 1);
  SetProp(P_AC, 1); // "Limit" (kein technisches Limit) fuer Instrumente: 15
  SetProp(P_MATERIAL, ([MAT_HORN:99, MAT_MISC_MAGIC:1]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WORN_TEXT, "in der Hand gehalten");
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);

  SetProp(P_INFO, "Dieses Instrument wird seine ganze Macht erst dann entfalten, "
                  "wenn Du mit ihm bis in den TOD gegangen bist!");

  SetProp(P_ITEMD_TMPMAGIC, ({4480, 4480}) ); // ca. 140 Tage
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  SetProp(P_MAGIC, 1);

  SetProp(P_INSTRUMENT_TYPE, IT_DRUM);
  SetProp(P_INSTRUMENT_LEVEL, 4);
  SetProp(P_INSTRUMENT_MESSAGES,
          ({
              ({"Du schlaegst kraeftig auf @INSTRUMENT, triffst aber nur den Rand und erzeugst einen unangenehmen, "
                  "krachenden Ton.",
                "@WER schlaegt kraeftig auf @WESSEN @INSTRUMENT, trifft aber nur den Rand und erzeugt einen unangenehmen, "
                  "krachenden Ton."}),                     // Fehlschlag
              ({"Du schlaegst einmal auf @INSTRUMENT3.", "@WER schlaegt einmal auf @INSTRUMENT3."}), // 1000
              ({"Du schlaegst zweimal auf @INSTRUMENT3.",
                "@WER schlaegt zweimal auf @INSTRUMENT3."}), // 2000
              ({"Du schlaegst dreimal in gleichen Zeitabstaenden auf @INSTRUMENT3.",
                "@WER schlaegt dreimal in gleichen Zeitabstaenden auf @INSTRUMENT3."}), // 3000
              ({"Du schlaegst zwei Mal langsam und drei Mal schnell auf @INSTRUMENT3.",
                "@WER schlaegt zwei Mal langsam und drei Mal schnell auf @INSTRUMENT3."}), // 4000
              ({"Du spielst einen kurzen Trommelwirbel auf @INSTRUMENT3. Du siehst Deine Zuhoerer leicht schaudern.",
                "@WER spielt einen kurzen Trommelwirbel auf @INSTRUMENT3. "
                "Eine leichte Gaensehaut kommt in Dir auf."}), // 5000
              ({"Du spielst einen laengeren Trommelwirbel auf @INSTRUMENT3. Du siehst Deine Zuhoerer schaudern.",
                "@WER spielt einen laengeren Trommelwirbel auf @INSTRUMENT3. "
                "Eine Gaensehaut kommt in Dir auf."}), // 6000
              ({"Du spielst einen tiefen, grollenden Trommelwirbel auf @INSTRUMENT3. Du siehst Deine Zuhoerer schaudern.",
                "@WER spielt einen tiefen, grollenden Trommelwirbel auf @INSTRUMENT3. "
                "Dir laeuft es kalt den Ruecken hinab."}), // 7000
              ({"Du nimmst @INSTRUMENT4 und spielst zuerst einige rhytmische Takte, gefolgt von einem maechtigen "
                "Trommelwirbel. Deine Zuhoerer starren beeindruckt!",
                "@WER nimmt @INSTRUMENT4 und spielt zuerst einige rhytmische Takte, gefolgt von einem maechtigen "
                "Trommelwirbel. Du starrst beeindruckt!"}), // 8000
              ({"Du nimmst @INSTRUMENT4 zur Hand und spielst einen sich schnell steigernden, hoch komplexen "
                "Rhythmus, der mit einem tiefen, satten *GONG* endet. "
                "Niemand wagt, die darauffolgende Stille zu brechen.",
                "@WER nimmt @INSTRUMENT4 zur Hand und spielt einen sich schnell steigernden, hoch komplexen "
                "Rhythmus, der mit einem tiefen, satten *GONG* endet. "
                "Niemand wagt, die darauffolgende Stille zu brechen."}), // 9000
              ({"Bedaechtig greifst Du @INSTRUMENT4 und haeltst einen Moment inne, bevor Du urploetzlich mit "
                "scheinbarer Gewalt und doch beherrscht den TODESMARSCH dermassen ergreifend vortraegst, dass "
                "sich die Umgebung eine Weile verduestert! Du hoerst die Herzen Deiner Zuhoerer bis zu deren "
                "Kehlkoepfen wild schlagen!",
                "@WER greift bedaechtig @INSTRUMENT4 und haelt einen Moment inne, bevor @WER urploetzlich mit "
                "scheinbarer Gewalt und doch beherrscht den TODESMARSCH dermassen ergreifend vortraegt, dass "
                "sich die Umgebung eine Weile verduestert! Dein Herz droht zu bersten, waehrend es den Takt "
                "vor Erregung wild in Deiner Brust mittrommelt und auch nach Ende @WESSEN Darbietung kaum "
                "sich zu beruhigen vermag!"}), // 10000+
          }));
  
  DB("Todestrommel: create() done\n");
}


// --- NOTIFY PLAYER DEATH --------------------------------------------------
void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  DB("Todestrommel: NotifyPlayerDeath(), player:"+getuid(victim)+", killer:"
  +killer->Name(RAW)+", lost_xp:"+lost_xp+"\n");
  log_file("d/ebene/metzelorgie/sterbeinstrument.log",
           sprintf("%s: %s toetet %s, lostxp=%d\n",
           dtime(), 
           killer?killer->Name(RAW):"killer=0",
           victim?getuid(victim):"victim=0",  lost_xp));
  log_file("d/ebene/metzelorgie/sterbeinstrument.log",
           sterbeinstrument::AddDeaths( victim, killer, lost_xp));
}


// --- RemoveFunc ---------------------------------------------
int RemoveFunc(object ruest, int silent)
{
  return sterbeinstrument::RemoveFunc(ruest,silent);
}

// --- WearFunc ----------------------------------------------------------
int WearFunc(object ruest, int silent)
{
  return sterbeinstrument::WearFunc(ruest,silent);
}

// --- reset --------------------------------------------------------------
void reset()
{
  ::reset();
}