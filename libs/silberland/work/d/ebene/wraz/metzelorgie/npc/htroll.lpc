#include "../def.h"
#include <properties.h>
#include <combat.h>

inherit "std/npc";

mapping art=([]);
int a;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  switch(random(100))
  {
    case   1 .. 10 : a=1;
    break;
    case  11 .. 15 : a=2;
    break;
    case  16 .. 30 : a=3;
    break;
    case  31 .. 36 : a=4;
    break;
    case  37 .. 50 : a=5;
    break;
    case  51 .. 60 : a=6;
    break;
    case  61 .. 70 : a=7;
    break;
    case  71 .. 80 : a=8;
    break;
    case  81 .. 90 : a=9;
    break;
    case  91 .. 98 : a=10;
    break;
    case  99 .. 100 : a=11;
    break;
    default : a=1;
  }

    //   key, short (name), adj, level, groesse, agr
  art=([ 1  : "kleiner" ;     "klein" ;       19 ; 10 ; 0 ,
         2  : "junger" ;      "jung" ;         9 ; 13 ; 1 ,
         3  : "fauler" ;      "faul" ;        12 ; 20 ; 0,
         4  : "alter" ;       "alt" ;         24 ; 19 ; 0,
         5  : "grosser" ;     "gross" ;       32 ; 40 ; 0,
         6  : "starker" ;     "stark" ;       45 ; 30 ; 1,
         7  : "hungriger" ;   "hungrig" ;     40 ; 35 ; 1,
         8  : "gewaltiger" ;  "gewaltig" ;    55 ; 50;  1,
         9  : "stinkender" ;  "stinkend" ;    30 ; 45 ; 1,
         10 : "riesiger" ;    "riesig" ;      42 ; 60 ; 0,
         11 : "ultimativer" ; "ultimativ" ;   65 ; 50 ; 1
         ]);


  SetProp(P_SHORT, "Ein " + art[a,0] + " Hoehlentroll");

  SetProp(P_LONG,
    Name(WER,1)+" Hoehlentroll. Er hat eine dunklegraue Haut und fast keine "
                "Haare am Kopf. Er sieht sehr hungrig aus!");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  SetProp(P_NAME, "Hoehlentroll");
  SetProp(P_NAME_ADJ, art[a,1]);

  if(art[a,4] == 1) SetProp(P_AGGRESSIVE, 1);

  AddId( ({"troll","hoehlentroll"}) );
  AddClass(CL_TROLL);

  create_default_npc(art[a,2]+random(10));

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 180+art[a,3]);
  SetProp(P_WEIGHT, 65000+random(30000));
  SetProp(P_ALIGN, -500-random(250));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt hungrig.\n");
  SetProp(P_KILL_MSG, "Mahlzeit!!!!\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "will Dich fressen!\n");

  SetChats(4,
  ({Name(WER,1) +" sabbert vor Hunger.\n",
    Name(WER,1) +" will Dich fressen!\n"
   }));

  SetAttackChats(10,
  ({Name(WER,1)+ " macht ein Feuer.\n",
    Name(WER,1)+ " holt Salz und Pfeffer hervor.\n",
    Name(WER,1)+ " schwingt seine Keule.\n"
   }));

  SUID;
  if(a<3) CLONEME( "/p/weapon/club/dornenknueppel" );
  else if(a<5) CLONEME( "/d/gebirge/speedy/trollager/weapon/trollkeule");
  if(a>=5) CLONEME( "/p/weapon/club/streithammer" );
  command("zuecke knueppel");
  command("zuecke streithammer");
  command("zuecke trollkeule");

  if(!random(2)) CLONEME( "/d/gebirge/speedy/trollager/armour/trollruestung" );
  if(!random(3)&&a>4) CLONEME( "/p/armour/ring/ring" );
  command("trage alles");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,20);

  AddSpell(2,400+art[a,2]*5,
    Name(WER,1)+ " wirft Dich zu Boden!\n",
    Name(WER,1)+ " wirft @WEN zu Boden!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  if(art[a,2]>30)
  AddSpell(5,150+art[a,2]*12,
    Name(WER,1)+ " schlaegt Dir mit seiner Keule ins Gesicht!!\n",
    Name(WER,1)+ " schlaegt @WEM mit seiner Keule ins Gesicht!!\n",
    DT_BLUDGEON, "blind",([SP_SHOW_DAMAGE:1]));

  if(art[a,2]>=45)
  AddSpell(1,800+art[a,2]*10,
    Name(WER,1)+ " schlaegt Dich zu einem Haufen Brei!\n",
    Name(WER,1)+ " schlaegt @WEM zu einem Haufen Brei!\n",
    DT_BLUDGEON, "paralyse", ([SP_SHOW_DAMAGE:1]));

  if(art[a,2]>=59)
  AddSpell(1,1000+art[a,2]*5,
    Name(WER,1)+ " rammt Dich ungespitzt in den Boden!\n",
    Name(WER,1)+ " rammt @WEM ungespitzt in den Boden!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

}

void paralyse(object enemy, int damge, mixed dam_type)
    {
      enemy->SetProp(P_PARALYZED, 1+random(4) );
    }

void blind(object enemy, int damage, mixed dam_type)
     {
       enemy->SetProp(P_BLIND, 1+random(4));
     }

//--Reactions--------------------------------------------------------------

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER,1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER,1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: Lass mich!",
        "sagt zu "+TPN+": Lass mich!",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: HOER AUF!",
        "sagt zu "+TPN+": HOER AUF!",
        0);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf...",
        "kratzt sich am Kopf...",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "SCHREIT: DAS WARS FUER DICH!",
        "SCHREIT "+TPN+" AN: DAS WARS FUER DICH!",
        1);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "BRUELLT: STIRB!",
        "BRUELLT "+TPN+" AN: STIRB!",
        1);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "ignoriert "+TPN+".",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt",
        0);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TPN+" nicht.",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TPN+" nicht.",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TPN+" nicht.",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
