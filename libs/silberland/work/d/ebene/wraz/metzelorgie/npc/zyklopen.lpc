// Zwei zusammengewachsene Zyklopen
// Pfad beim Schlachtfeld
// Von Wraz / Mendralim

#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"

#define DEFAULT_HP 2050+random(350) // zuvor 1850+random(250)

inherit "std/npc";
inherit "/std/npc/spells";
inherit NPC "pfadnpc.lpc";
inherit NPC "npc.lpc";

object ob;
int boden;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  boden=0;

  SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen");
  SetProp(P_LONG,
    "Vor Dir steht eine seltsame Gestalt: Zwei Zyklopen, an der Seite "
    "zusammengewachsen. Vier kraeftige Beine, ebenfalls vier starke Arme, "
    "zwei Koepfe mit jeweils einem Auge. Ein fuerchterlicher Anblick...");

  SetProp(P_NAME, "Zyklopengestalt");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"zyklopen", "NOWIMPY", "\nwache", "Keulenmeister", "gestalt",
    "zyklopengestalt", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  AddAdjective( ({"zwei zusammengewachsene","zwei zusammengewachsen",
  "zwei zusammengewachsenen","zwei zusammengewachsenes",
  "zwei zusammengewachsener","zusammengewachsenen","zusammengewachsene",
  "zusammengewachsener","zusammengewachsen"
  }) );

  AddDetail( ({"beine"}),
    "Obwohl die Beine kraeftig sind, scheinen sie wackelig. Vielleicht "
    "kannst Du die Zyklopen irgendwie ablenken, irritieren oder sonstwie "
    "mit ihnen interagieren, um sie zu Fall zu bringen?");

  set_living_name("wrazzyklopen");

  create_default_npc(44,DEFAULT_HP);

  SetProp(P_HANDS, ({" mit vier starken Armen"
                    ,250
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "Zyklop");
  SetProp(P_SIZE, 270);
  SetProp(P_WEIGHT, 230000);
  SetProp(P_ALIGN, -530);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 100);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
   "Die Zyklopen bruellen Dich an!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.15,DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.1, DT_TERROR:     -0.1
     , DT_HOLY:      0.6, DT_UNHOLY:   -0.1, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:    -0.2, DT_BLUDGEON:   -0.1
     , DT_PIERCE:    0.0, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.05
     , DT_RIP:      -0.05
     ])
  );

  SetProp(P_MSGIN, "stampft laut herein");
  SetProp(P_MSGOUT, "stampft laut");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kracht tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_INFO, BS("Die Zyklopen kannst Du mit roher Gewalt niemals "
  "besiegen! Sie stehen sehr wackelig und unkoordiniert auf den Beinen, "
  "vielleicht kannst Du sie irgendwie zu Fall bringen."));

  AddInfo(DEFAULT_INFO, "bruellt Dich wild an! Die Zyklopen scheinen zu "
  "dumm zu sein, um Dich verstehen zu koennen.\n");

  SetProp(P_SPELLRATE,80); // zuvor: 70

  AddSpell(3, 450,
    "Die Zyklopen bruellen Dich laut an!\n",
    "Die Zyklopen bruellen @WEN laut an!\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(5, 550, DS_MASS_DAMAGE,
    "Die Zyklopen pruegeln wild um sich.\n",
    "Die Zyklopen pruegeln wild um sich.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 1200, // zuvor: 1, 1000
    "Die Zyklopen beissen Dich!\n",
    "Die Zyklopen beissen @WEN!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1,
  ({"Die Zyklopen stapfen unkoordiniert herum.\n",
    "Die Zyklopen kippen fast um, als sie versuchen, in verschiedene \n"
    "Richtungen zu gehen.\n",
    "Die Zyklopen knirschen mit den Zaehnen.\n",
    "Einer der Zyklopen knirscht mit seinen Zaehnen.\n",
    "Die Zyklopen pruegeln sich gegenseitig.\n"
   })
  );

  SetAttackChats(10,
  ({"Die Zyklopen bruellen synchron! Wie laut!\n",
    "Die Zyklopen arbeiten gut zusammen.\n"
   }));

  SUID;
  ob=clone_object(WEAPON "vierhaenderkeule");
  special_ob = ob; // fuer pfadnpc.c noetig
  //ob->AddId(({"Bling","Pfadbling"}));
  //ob->set_collector_value(QueryProp(P_LEVEL)+90);
  // Boni fuer Spells, fuer Staerke der Waffe, fuers Schleppen :) der
  // Keule und fuers alleinige Killen
  ob->move(TP,2);
  command("zuecke keule");

  AddCmd( ({"wirf","werfe","bring","bringe","schmeiss","schmeisse"}),
    "cmd_werfen");
}

int cmd_werfen(string str)
{
  if(str==""||!str) return 0;

  if(str=="zyklopen um"||str=="zyklop um"||str=="zyklopen zu fall"||
     str=="zyklop um"||str=="zyklop zu fall"||str=="zyklop zu boden"||
     str=="zyklopen zu boden"||str=="zyklopengestalt um"||
     str=="zyklopengestalt zu fall"||str=="zyklopengestalt zu boden")
  {
    TP->Message(
      "Tritt sie!\n");
    return 1;
  }
}

void init()
{
  //pfadnpc::init();
  if( find_call_out("modify_hp") == -1 ) call_out("modify_hp",1,TP);
  ::init();
}

void die(int poisondeath)
{
  pfadnpc::npc_dies(poisondeath);
  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (verb)
  {
    case "tritt":
    case "trete":
    case "tret":
     if(!boden) {
      TP->Message(BS(
        "Du trittst einmal kraeftig gegen die Zyklopen... sie starren Dich "
        "entgeistert an, und kommen tatsaechlich ins Wanken! Du zitterst. "
        "KRACH! Sie sind tatsaechlich zu Boden gefallen und haben dabei "
        "ihre Keule fallen gelassen!! Ausserdem scheinen sie bei dem "
        "Sturz nicht unverletzt geblieben zu sein. HAU DRAUF!!"));
      ENV(TP)->Message(BS(
        TPN+" tritt die Zyklopen zu Boden!! "+TPN+" TRAUT SICH WAS!"),
        MSGFLAG_NO_TP);
      TO->AddHp(-(750+random(50)));
      ob->move(ENV(TO),M_NOCHECK);
      TO->SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen (sich am "
       "Boden verzweifelt waelzend)");
      SetProp(P_LAST_RAMMEN_TIME, time()+40);
      boden=1; }
      break;

    case "kitzle":
    case "kitzel":
     if(!boden) {
      TP->Message(BS(
        "Du kitzelst die Zyklopen in der Kniekehle... sie lachen zwar nicht, "
        "sind jedoch sichtlich verwirrt und kommen ins Wanken und ... "
        "KRACHEN zu Boden!!! "
        "Dabei haben sie "
        "ihre Keule fallen gelassen!! Ausserdem scheinen sie bei dem "
        "Sturz nicht unverletzt geblieben zu sein. HAU DRAUF!!"));
      ENV(TP)->Message(BS(
        TPN+" kitzelt die Zyklopen und sie stuerzen zu Boden!! "
        +TPN+" TRAUT SICH WAS!"),
        MSGFLAG_NO_TP);
      TO->AddHp(-(750+random(20)));
      ob->move(ENV(TO),M_NOCHECK);
      TO->SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen (sich am "
       "Boden verzweifelt waelzend)");
      SetProp(P_LAST_RAMMEN_TIME, time()+40);
      boden=1; }
      break;

    case "ruettel":
    case "ruettle":
      if(!boden) {
      TP->Message(BS(
        "Du ruettelst wild an den Zyklopen und sie kippen um!"
        "Dabei haben sie "
        "ihre Keule fallen gelassen!! Ausserdem scheinen sie bei dem "
        "Sturz nicht unverletzt geblieben zu sein. HAU DRAUF!!"));
      ENV(TP)->Message(BS(
        TPN+" ruettelt die Zyklopen zu Boden!! "+TPN+" TRAUT SICH WAS!"),
        MSGFLAG_NO_TP);
      TO->AddHp(-(750+random(90)));
      ob->move(ENV(TO),M_NOCHECK);
      TO->SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen (sich am "
       "Boden verzweifelt waelzend)");
      SetProp(P_LAST_RAMMEN_TIME, time()+40);
      boden=1; }
      break;

    case "schuettle":
    case "schuettel":
      if(!boden) {
      TP->Message(BS(
        "Du schuettelst den Zyklopen alle vier Haende! Total verwirrt "
        "kommen sie ins Wanken und fallen schliesslich um! WOW!"
        "Sie haben "
        "ihre Keule fallen gelassen!! Ausserdem scheinen sie bei dem "
        "Sturz nicht unverletzt geblieben zu sein. HAU DRAUF!!"));
      ENV(TP)->Message(BS(
        TPN+" schuettelt den Zyklopen alle Haende und sie kippen verwirrt "
        "um! WOW! "+TPN+" TRAUT SICH WAS!"),
        MSGFLAG_NO_TP);
      TO->AddHp(-(750+random(40)));
      ob->move(ENV(TO),M_NOCHECK);
      TO->SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen (sich am "
       "Boden verzweifelt waelzend)");
      SetProp(P_LAST_RAMMEN_TIME, time()+40);
      boden=1; }
      break;

    case "stosse":
    case "stoss":
      if(!boden) {
      TP->Message(BS(
        "Du nimmst Deinen Mut zusammen und stoesst die Zyklopen so fest "
        "und stark Du kannst .... Du zitterst ... sie blicken Dich boese "
        " an ... jetzt schauen sie verwirrt! Sie kommen ins Wanken .... "
        "uuuuuund .... KIPPEN UM!! "
        "Dabei haben sie "
        "ihre Keule fallen gelassen!! Ausserdem scheinen sie bei dem "
        "Sturz nicht unverletzt geblieben zu sein. HAU DRAUF!!"));
      ENV(TP)->Message(BS(
        TPN+" stoesst die Zyklopen zu Boden!! "+TPN+" TRAUT SICH WAS!"),
        MSGFLAG_NO_TP);
      TO->AddHp(-(840+random(90)));
      ob->move(ENV(TO),M_NOCHECK);
      TO->SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen (sich am "
       "Boden verzweifelt waelzend)");
      SetProp(P_LAST_RAMMEN_TIME, time()+40);
      boden=1; }
      break;

    case "tanze":
    case "tanz":
      if(!boden) {
      TP->Message(BS(
        "Du musst verrueckt sein! Aber egal, Du tanzt mit den Zyklopen "
        "eine Runde, sie werden schwindelig und fallen um. WOW!"
        "Dabei haben sie "
        "ihre Keule fallen gelassen!! Ausserdem scheinen sie bei dem "
        "Sturz nicht unverletzt geblieben zu sein. HAU DRAUF!!"));
      ENV(TP)->Message(BS(
        TPN+" stoesst die Zyklopen zu Boden!! "+TPN+" TRAUT SICH WAS!"),
        MSGFLAG_NO_TP);
      TO->AddHp(-(750+random(20)));
      ob->move(ENV(TO),M_NOCHECK);
      TO->SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen (sich am "
       "Boden verzweifelt waelzend)");
      SetProp(P_LAST_RAMMEN_TIME, time()+40);
      boden=1; }
      break;

    default: break;
  }

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "erkennen Deine Schwaeche und greifen Dich an!",
        "erkennen "+TPN+"s Schwaeche und greifen an!",
        1);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "lassen sich das nicht gefallen!",
        "lassen sich das nicht gefallen!",
        1);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "sind nicht zum Spassen aufgelegt!",
        "sind nicht zum Spassen aufgelegt!",
        1);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bruellen Dich wuetend an!",
        "bruellen "+TPN+" wuetend an!",
        1);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schreien wild umher und attackieren Dich!",
        "schreien wild und attackieren "+TPN+".",
        1);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "lassen sich das nicht gefallen!",
        "lassen sich das nicht gefallen!",
        1);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "treten Dich jeder mit einem Bein.",
        "treten "+TPN+" jeder mit einem Bein.",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "schlagen Dir hart auf den Hinterkopf.",
        "schlagen "+TPN+" hart auf den Hinterkopf.",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "attackieren Dich gelangweilt.",
        "attackieren "+TPN+" gelangweilt.",
        1);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Die Zyklopen "+macher));
  tell_room(ENV(TO), BS("Die Zyklopen "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void reset()
{
  object ob;

  ::reset();

  if(!is_clone(TO)) return;
  if(!ob=ENV(TO)) return;

  if(boden==1)
  {
    boden = 0;
    SetProp(P_SHORT, "Zwei zusammengewachsene Zyklopen");
    SetProp(P_LAST_RAMMEN_TIME, time()-2);

    tell_room(ob, BS(
      "Die Zyklopen stehen muehevoll wieder auf"));

    command_me("nimm keule");
    command_me("zuecke keule");
    return;
  }
}
