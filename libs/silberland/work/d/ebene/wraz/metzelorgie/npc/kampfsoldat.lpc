// Brutaler Kampfsoldat
// Orientiert an Kampfsoldaten in Midas
// Von Wraz / Mendralim

#include "../def.h"

#define RANDOM_BONUS_DEFEND WMASTER->query_random_bonus_defend()

inherit "std/mnpc";
inherit "/std/npc/spells";
inherit NPC "npc.lpc";

string heroes;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  heroes=read_file(ZONE "list/heroes")+"\nwraz";

  SetProp(P_SHORT, "Ein brutaler Kampfsoldat");
  SetProp(P_LONG,
    "Vor Dir steht ein ehemaliger Kampfsoldat. Seine Haare sind zerzaust, "
    "sein Panzer ist verbeult. In seinem Gesicht siehst Du blanke Wut, "
    "kein Wunder, dass er aus Midas verbannt wurde.");

  SetProp(P_NAME, "Kampfsoldat");
  SetProp(P_KILL_NAME, "Ein brutaler Kampfsoldat");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"kampfsoldat", "soldat", "NOWIMPY", "Krieger",
  "Kampfsoldat", "\nschlachtfeld"}));
  set_living_name("\nschlachtfeld_minions_by_wraz");

  SetProp(P_NAME_ADJ, "brutal");
  AddAdjective( ({"brutalen","brutaler","brutales"}) );

  SetProp(P_ARTICLE, 1);

  create_default_npc(32+random(3));

  SetProp (P_HANDS, ({" mit blossen, brutalen Haenden", 100, DT_BLUDGEON}) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_WEIGHT, 80000+random(10000));
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der brutale Kampfsoldat nimmt alles!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_MNPC_AREA, ({ ROOM "m" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "m09");
  SetProp(P_MNPC_WAIT, ({ 80, 100, 100 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp (P_DIE_MSG, " schreit noch einmal laut auf und stirbt.\n");

  AddInfo(DEFAULT_INFO, "blickt Dich tief schnaufend an.\n");

  //AddInfo( ({"",""}),
  //  ".",
  //  "sagt: ");

  SetProp(P_SPELLRATE,40);

  AddSpell(2,380,
    "Der Kampfsoldat trifft Dich mit voller Wucht.\n",
    "Der Kampfsoldat trifft @WEN mit voller Wucht.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,450,
    "Der Kampfsoldat versetzt Dir einen schweren Schlag ins Genick.\n",
    "Der Kampfsoldat versetzt @WEM einen schweren Schlag ins Genick.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2,440,
    "Der Kampfsoldat steigt Dir heftig auf den Fuss. AUA! \n",
    "Der Kampfsoldat steigt @WEM heftig auf den Fuss.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SUID;
  CLONEME("/p/armour/armour/eisenpanzer");
  if( random(100) < 20 ) CLONEME("/p/armour/shield/eisenschild");
  if( random(100) < 7 ) CLONEME("/p/armour/boots/lederstiefel");
  if( random(100) < 3 ) CLONEME("/d/ebene/obj/ruestung/armschienen");
  if( random(100) < 2 ) CLONEME("/d/ebene/obj/ruestung/beinschienen");
  if( random(100) < 3 ) CLONEME("/p/armour/gloves/lederhandschuhe");
  command ("trage alles");
  CLONEME("/d/ebene/obj/waffe/kampfschwert");
  command ("zuecke kampfschwert");

}

void die(int poisondeath)
{
  object ob;

  WMASTER->npc_death_log("standardnpc", TO->Name(RAW), TPU, TPN);

  ob=clone_object(OBJ "bling");
  WMASTER->bling_prop(ob,"kampfsoldat");
  ob->set_collector_value(QueryProp(P_LEVEL)+5);
  // weing Bonus, schwache Spells
  ob->move(TO,M_GET);

  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  call_other(IMASTER, "DropItems", ENV(TO), QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht ueber Dich!",
        "lacht ueber "+TPN+".",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "bruellt Dich an!",
        "bruellt "+TPN+" an!",
        1);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf.",
        "kratzt sich am Kopf.",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "laesst sich das nicht gefallen!",
        "laesst sich das von "+TPN+" nicht gefallen!",
        1);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "schreit: DU PROVOZIERST MICH? NA WARTE!",
        "schreit "+TPN+" an: DU PROVOZIERST MICH? NA WARTE!",
        1);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "gruebelt.",
        "gruebelt.",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "BRUELLT: DAS BRAUCH ICH NICHT!",
        "BRUELLT: DAS BRAUCH ICH NICHT!",
        1);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "hebt eine Augenbraue.",
        "hebt eine Augenbraue.",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich!",
        "lacht "+TPN+" aus!",
        0);
      break;
    default: break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Der brutale Kampfsoldat "+macher));
  tell_room(ENV(TO), BS("Der brutale Kampfsoldat "+andere), ({pl}) );

  if(kill) Kill(pl);
}

int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if ( strstr(heroes,lower_case( getuid(enemy) )) )
    return ::Defend(dam+random(RANDOM_BONUS_DEFEND), dtypelist, spell, enemy);

  else return ::Defend(dam, dtypelist, spell, enemy);
}

int query_random_bonus_defend()
{
  return RANDOM_BONUS_DEFEND;
}

void InformDefend(object enemy)
{
  Kill(enemy);
}