// Lehmgolem
//
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit NPC "npc.lpc";

string traege();
string toppfadliste(string str);

void create()
{
  if( !is_clone(TO) ) return;
  if( getuid(previous_object())!=getuid(find_object(ROOM "p02")) &&
      getuid(previous_object())!="wraz" ) {
  	TO->remove(0);
  	return; }

  ::create();

  WMASTER->set_status("golem_tot",0);
  WMASTER->load_npc();

  LMASTER->write_death_list();

  SetProp(P_SHORT, "Ein Lehmgolem");
  SetProp(P_LONG,
    "Der Lehmgolem ist ein riesiger Koloss aus Lehm. Er versperrt den Weg "
    "nach Nordwesten fast komplett.");

  SetProp(P_NAME, "Lehmgolem");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:70]));
  AddId(({"lehmgolem", "golem", "\nwache", "NOWIMPY", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  set_living_name("wrazlehmgolem");

  create_default_npc(40); // zuvor 35

  SetProp(P_HANDS, ({" mit Lehmarmen"
                    ,QueryProp(P_HANDS)[1]*2
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "Golem");
  SetProp(P_SIZE, 300);
  SetProp(P_WEIGHT, 290000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@WER faellt einfach zu Boden, da der Golem keine Anstalten macht, \n"
    "es zu nehmen.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.6
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:    -0.2, DT_LIGHT:    -0.2, DT_ELECTRIC:   -0.2
     , DT_ACID:      0.0, DT_POISON:   -0.6, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:      -0.6
     , DT_MIND:     -0.2, DT_SLASH:    -0.4, DT_BLUDGEON:    0.1
     , DT_PIERCE:   -0.6, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.4  ]));

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " zerbroeckelt.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_INFO, "Bei Betrachtung des Golems erkennst Du Schrift auf seiner "
    "Brust.");

  AddInfo(DEFAULT_INFO, "ist zu dumm.\n");

  AddDetail( ({"lehm"}),
    "Der Lehmgolem besteht aus hellem, festem Lehm.");

  AddDetail( ({"wer","unterschrift"}),
    "Du siehst ganz genau hin, und erkennst am Ende eine Unterschrift: "
    "'Vom Eisdruiden mit Liebe fuer Hihi.'");

  AddDetail( ({"schrift","brust"}),
    "Ja, eindeutig Schrift auf der Brust des Golems! Auf der linken Brust "
    "steht die Ueberschrift 'Toppfadsterber', auf der rechten "
    "'Toppfadkiller'. Wer das dort wohl eingeritzt hat?");

  AddDetail( ({"toppfadsterber","linke brust"}), #'toppfadliste);
  AddDetail( ({"toppfadkiller","rechte brust"}), #'toppfadliste);

  SetProp(P_SPELLRATE,50);

  AddSpell(6,400,
    "Der Lehmgolem trifft Dich unangenehm hart.\n",
    "Der Lehmgolem trifft @WEN ziemlich hart.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(4, 450, DS_MASS_DAMAGE,
    "Der Lehmgolem drischt um sich!\n",
    "Der Lehmgolem drischt um sich!\n",DT_BLUDGEON);

  SetChats(1,
  ({"Der Lehmgolem ruehrt sich nicht vom Fleck.\n"
   ,"Ein Stueck Lehm broeckelt von dem Golem ab. Es scheint ihn nicht zu "
   "stoeren.\n",
   "Der Lehmgolem verharrt regungslos.\n",
   "Der Lehmgolem ist dumm.\n"
   }));

  SetAttackChats(10,
  ({"@@traege@@"
   }));

  SUID;
}

string toppfadliste(string str)
{
  string text;
  string file;

  if(str == "toppfadsterber" || str == "linke brust") {
    text = "Die Schrift entpuppt sich als Liste der TOP-PFADSTERBER*INNEN:\n\n";
    file = DEATHLIST;
  }
  else if(str == "toppfadkiller" || str == "rechte brust") {
    text = "Die Schrift entpuppt sich als Liste der TOP-PFADKILLER*INNEN:\n\n";
    file = KILLLIST;
  }

  if(!read_file(file) || read_file(file) == "")
    text = "Du erkennst doch nichts.\n";
  else text += read_file(file);
  if(TP) TP->More(text);
  return "";
}

void die(int poisondeath)
{
  object ob;

  WMASTER->npc_death_log("pfadnpc", TO->Name(RAW), TPU, TPN);

  WMASTER->set_status("golem_tot",1);

  ob=clone_object(OBJ "bling");
  WMASTER->bling_prop(ob,"lehmgolem");
  ob->set_collector_value(QueryProp(P_LEVEL)+80);
  ob->move(TO,M_GET);

  npc::jadering_xp(TP, QueryProp(P_LEVEL)*2);
  call_other(IMASTER, "DropItems", ENV(TO), QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);
}

string _query_noattack()
{
  if(WMASTER->query_last_wache()) return 0;
  else return "stoesst Dich einfach um.\n";
}

void reset()
{
  ::reset();

  if(!is_clone(this_object())) return; // dank an feyaria :)

  call_other(ROOM "p03", "");
  if(WMASTER->query_schlaechter() || !present("\nwache",find_object(ROOM "p03")))
  {
    WMASTER->load_npc();
    SetProp(P_AGGRESSIVE,0);
  }

  else return;
}

varargs void destroy_elementals(object ob)
{
  object elemental;

  if(ob) elemental = ob;
  else if(TP) elemental = TP;
  else return;
  
  if(interactive(elemental)) return;
  if(!elemental->QueryProp(P_NPC)) return;

  if(elemental->QueryProp(P_UID)=="GUILD.druidenzirkel"&&
     member(elemental->QueryProp(P_IDS),"elementar")!=-1)
  {
    if(elemental->QueryProp("e_owner") && elemental->QueryProp("e_caster") &&
      elemental->QueryProp("e_owner") == elemental->QueryProp("e_caster"))
    {
      ENV(TO)->Message(BS(
      "Der Lehmgolem hebt sein Bein ueber das Elementar, aber "
      +elemental->QueryProp("e_caster")->Name()+" dirigiert es geschickt in Sicherheit."),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ elemental->QueryProp("e_caster") }) ]));
      elemental->QueryProp("e_caster")->Message(BS(
      "Als der Lehmgolem sein Bein bedrohlich ueber das Elementar hebt, bringst Du es geschickt "
      "in Sicherheit."));
      return;
    }
    ENV(TO)->Message(BS(
      "Der Lehmgolem zerstampft das Elementar."));
    elemental->remove(1);
    return;
  }

  if(elemental->QueryProp(P_UID)=="d.wasser.stahldorn"&&
     elemental->id("daemon"))
  {
    ENV(TO)->Message(BS(
      "Der Lehmgolem zerstampft den Daemon."));
    elemental->remove(1);
    return;
  }

  // Nekromantenmumien und Skelette duerfen auch nicht passieren
  if(elemental->QueryProp(P_UID)=="GUILD.nekromanten"&&
     (elemental->id("Nekromantenmumie")||elemental->id("Nekromantenskelett")))
  {
    ENV(TO)->Message(BS(
      "Der Lehmgolem zerstampft "+elemental->name(WEN,1)+"."));
    elemental->die();
    if(elemental) elemental->remove(1);
    return;
  }
}

// Druiden koennten ein Elementar ausserhalb machen, es mitnehmen, und dann neben dem Lehmgolem 
// an einen anderen Spieler haengen, weil beim "umhaengen" kein init() aufgerufen wird...
void catch_tell(string str)
{
  object ob;

  str = lower_case(str);

  if(TO && ENV(TO) && strstr(str,"elementar gehorche") != -1)
    for(ob=first_inventory(ENV(TO));ob;ob=next_inventory(ob))
    {
      if(!ob->QueryProp(P_NPC)) continue;
      else if(ob->QueryProp(P_UID)=="GUILD.druidenzirkel"&&
        member(ob->QueryProp(P_IDS),"elementar")!=-1) // &&
        //find_call_out("destroy_elementals")==-1)
        call_out("destroy_elementals",1,ob);
    }
}

void init()
{
  ::init();

  call_out("destroy_elementals",1);
}

string traege()
{
  ModifySkillAttribute(SA_SPEED, 50+random(21), 6+random(5));
  return "Der Lehmgolem bewegt sich traege.\n";
}
