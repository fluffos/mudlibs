// Schreckgespenst (Wraith): Minion (summoned)
// Pfad beim Schlachtfeld
// Von Wraz / Mendralim

#include "../def.h"
inherit "/p/std/npc/nekro_npc"; // um von Nekros beherrscht werden zu koennen
inherit "/std/npc/spells";
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schreckgespenst");
  SetProp(P_LONG,
    "Diese duestere Gestalt zeigt vage humanoide Formen, die sich aus schwarzem "
    "Nebel zusammenzusetzen scheinen. Einzig der Kopf, mit seiner "
    "fuerchterlichen Grimasse und den rot gluehenden Augen, ist gut zu "
    "erkennen.");

  SetProp(P_NAME, "Schreckgespenst");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:40]));
  AddId(({"schreckgespenst", "gespenst", "gestalt", "NOWIMPY", "\nwache",
  "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(33,1800+random(300));

  SetProp(P_XP, (QueryProp(P_XP)*7)/4);

  SetProp(P_HANDS, ({" mit seiner immateriellen Beruehrung"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_TERROR})
                    }));

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 94+random(100));
  SetProp(P_WEIGHT, 10+random(10));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:     -0.5, DT_WATER:      -0.5
     , DT_AIR:      -0.5, DT_LIGHTNING:-0.5, DT_EXPLOSION:  -0.5
     , DT_SOUND:    -0.5, DT_LIGHT:     0.2, DT_ELECTRIC:   -0.5
     , DT_ACID:     -0.5, DT_POISON:   -0.5, DT_TERROR:     -1.0
     , DT_HOLY:      0.5, DT_UNHOLY:   -1.0, DT_MAGIC:      -0.5
     , DT_MIND:     -1.0, DT_SLASH:    -1.0, DT_BLUDGEON:   -1.0
     , DT_PIERCE:   -1.0, DT_SQUEEZE:  -1.0, DT_WHIP:       -1.0
     , DT_RIP:      -1.0
     ])
  );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@CAP_WER faellt durch das Schreckgespenst einfach zu Boden.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_MSGIN, "schwebt auf schwarzen Nebelschwaden herbei");
  SetProp(P_MSGOUT, "schwebt auf schwarzen Nebelschwaden");
  SetProp(P_MMSGIN, "erscheint in einer unheimlichen Rauchwolke");
  SetProp(P_MMSGOUT, "schwebt auf schwarzen Nebelschwaden empor und davon");

  SetProp(P_DIE_MSG,  " loest sich in Nichts auf.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "saeuselt in Dein Ohr: Stirb!\n");


  SetProp(P_SPELLRATE,80);

  AddDefaultSpell(7, 450, DS_MASS_DAMAGE,
    "Das Schreckgespenst faehrt durch Dich hindurch.\n",
    "Das Schreckgespenst faehrt durch @WEN hindurch.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
   "Das Schreckgespenst entzieht Dir mit seiner Beruehrung Lebenskraft!\n",
   "Das Schreckgespenst entzieht @WEM mit seiner Beruehrung Lebenskraft!\n",
   DT_TERROR,"drain",([SP_SHOW_DAMAGE:0]));

  SUID;
}

void die(int poisondeath)
{
  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void drain(object enemy, int damage, mixed dam_type)
{
  object dr;

  if(!interactive(enemy)) return;
  dr = clone_object( OBJ "hp_drain" );

  // Verhindert negative MAX_HP beim Spieler
  if( -(dr->QueryProp(P_X_HEALTH_MOD)["hp"]) > (enemy->QueryProp(P_MAX_HP)) )
  {
    dr->remove();
    return;
  }
  else
  {
    dr -> move( enemy , M_NOCHECK );
    enemy->UpdateAttributes();
  }

  return;
}

void reset()
{
 ::reset();
 
 if(!is_clone(TO)) return;

 else if(QueryProp(P_CLONE_TIME) < (time()-(2000+random(2000))))
 {
   TO->move("/room/npcasylraum",M_TPORT);
   TO->remove();
 }
}
