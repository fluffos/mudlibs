// Troll
// Pfad beim Schlachtfeld
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit NPC "pfadnpc.lpc";
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;
  if(getuid(previous_object())!=getuid(find_object(WMASTER))) {
  	TO->remove(0);
  	return; }

  ::create();

  SetProp(P_SHORT, "Ein Troll");
  SetProp(P_LONG,
    "Ein typischer Troll - dumm, gross und sehr stark! Irgendwie ist er aber "
    "aussergewoehnlich... BOESE!");

  SetProp(P_NAME, "Troll");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"troll", "\nwache", "Kettenmeister", "NOWIMPY", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  set_living_name("wraztroll");

  create_default_npc(40+random(3)); // zuvor (37+random(3))

  SetProp(P_XP, (QueryProp(P_XP)*4)/3 );

  SetProp(P_HANDS, ({" mit seinen Trollfaeusten"
                    ,430
                    , ({DT_BLUDGEON})
                }));

  SetProp(P_ATTRIBUTES, ([A_STR:50,A_INT:5,A_DEX:25,A_CON:45]) );

  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 390);
  SetProp(P_WEIGHT, 180000);
  SetProp(P_ALIGN, -450);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Troll frisst @WAS auf.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.4, DT_COLD:      0.0, DT_WATER:      -0.4
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.6, DT_UNHOLY:   -0.2, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:    -0.2, DT_BLUDGEON:    0.0
     , DT_PIERCE:   -0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.1
     ]));

  SetProp(P_MSGIN, "trampelt an");
  SetProp(P_MSGOUT, "trampelt unkoordiniert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schaut Dich nachdenklich an.\n");

  SetProp(P_SPELLRATE,60); // zuvor 40

  AddSpell(7,300,
    "Der Troll drischt mit einer Faust auf Dich ein.\n",
    "Der Troll drischt mit einer Faust auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,600,
    "Der Troll wankt unmotorisch umher und trifft Dich unabsichtlich.\n",
    "Der Troll trifft @WEN sehr unkoodriniert.\n",
    DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,800,
    "Mit ohrenbetaeubendem Gebruell schuechtert Dich der Troll massiv ein!\n",
    "Mit ohrenbetaeubendem Gebruell schuechtert der Troll @WEN ein!\n",
    DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetChats(3,
  ({"Der Troll BRUELLT laut!\n",
    "Der Troll ROARRT!\n",
    "Der Troll starrt dumm in die Luft.\n",
    "Der Troll schreit Dich ploetzlich aggressiv an!!\n",
    "Der Troll setzt sich kurz nieder und steht wieder auf.\n",
    "Der Troll schaut seine Waffe verstaendnislos an, kratzt sich kurz \n"
    "nachdenklich am Kopf und zuckt dann ratlos mit den Schultern.\n",
    "Der Troll starrt Dich an und bohrt in der Nase.\n",
    "Der Troll nimmt einen riesigen Felsklotz und schleudert ihn mit \n"
    "gewaltiger Kraft weit weg!!! Du zitterst vor Angst.\n"
   }));

  SetAttackChats(10,
  ({"Der Troll SCHREIT Dich an!\n",
    "Der Troll ruelpst.\n",
    "Der Troll bruellt: Dich fress' ich zum Nachtisch!!!!\n"
   }));

  SUID;
  CLONEME( "/p/weapon/chain/trippelstern" );
  command("zuecke trippelstern");
}

void init()
{
  if( find_call_out("modify_hp") == -1 ) call_out("modify_hp",1,TP);
  ::init();
}

void die(int poisondeath)
{
  pfadnpc::npc_dies(poisondeath);
  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schreit Dich an!",
        "schreit!");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "BRUELLT WUETEND!",
        "BRUELLT WUETEND UMHER!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "sagt: Oeh.",
        "sagt: Oeh.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "starrt nur gerade aus.",
        "starrt nur gerade aus.");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "starrt.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "kratzt sich am Hintern.",
        "kratzt sich am Hintern.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "runzelt die Stirn un kratzt sich angestrengt am Kopf.",
        "runzelt die Stirn un kratzt sich angestrengt am Kopf.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "blickt verwundert.",
        "blickt verwundert.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "fragt: Ich?",
        "fragt: Ich?");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "richtet sich das Gemaecht.",
        "richtet sich das Gemaecht.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Der Troll "+macher));
  tell_room(ENV(TO), BS("Der Troll "+andere), ({pl}) );
}
