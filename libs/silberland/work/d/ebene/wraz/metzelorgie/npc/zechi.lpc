// Zechpreller
// Pfad beim Schlachtfeld
// Von Wraz / Mendralim

#include "../def.h"

inherit "/p/std/npc/zechpreller_npc";
inherit NPC "pfadnpc.lpc";
inherit NPC "npc.lpc";
inherit "/std/npc/spells";
inherit "std/inpc/select";
inherit "/std/util/pager.lpc";

int beim_saufen;
int counter;
string fackel();

void create()
{
  if(!is_clone(TO)) return;

  beim_saufen=0;
  counter=0;

  ::create();

  SetProp(P_SHORT, "Ein versoffener Zechpreller");
  SetProp(P_LONG,
    "Ein typischer Zechpreller: sturzbetrunken und lallt irgendeinen "
    "Mist durch die Gegend. Ob er wohl ein harter Gegner ist?");

  SetProp(P_NAME, "Zechpreller");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"zechpreller", "zechi", "\nwache", "NOWIMPY", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  set_living_name("wrazzechpreller");

  create_default_zechpreller(40,7,610); // zuvor: (40,6,610)

  SetProp(P_HANDS, ({" mit seinen Haenden und leeren Flaschen"
                    ,(QueryProp(P_HANDS)[1]/2)*5
                    , ({DT_BLUDGEON,DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 172);
  SetProp(P_WEIGHT, 71275);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Zechpreller gafft Dich mit grossen Augen an.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.5, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.1
     ])
  );

  SetProp(P_MSGIN, "wankt herein");
  SetProp(P_MSGOUT, "torkelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " wankt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "<Hicksch> Wasch losch? *boerp*");

  AddInfo(DEFAULT_INFO, "groehlt: Ich sauf Disch unter'n Tisch!\n");

  AddInfo( ({"tisch","saufen","wettsaufen"}),
    "Schag einf<hicksch>ach 'eksch' und esch geht losch!",
    "lallt: ");

  SetProp(P_SPELLRATE,60);

  AddSpell(5,460,
    "Der Zechi pruegelt im Suff wild auf Dich ein.\n",
    "Der Zechi pruegelt im Suff wild auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,540,
    "Der Zechpreller sticht Dir mit einem abgebrochenen Flaschenhals in die "
    "Brust.\n",
    "Der Zechpreller sticht @WEM mit einem abgebrochenen Flaschenhals in die "
    "Brust.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,380,
    "Der Zechpreller tritt groehlend auf Dich ein.\n",
    "Der Zechpreller tritt groehlend auf @WEN ein.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,395,
    "Der Zechpreller schlaegt Dir eine Flasche ueber den Kopf.\n",
    "Der Zechpreller schlaegt @WEM eine Flasche ueber den Kopf.\n",
    DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,853,
    "Der Zechi ruelpst Dir ins Gesicht und schlaegt Dir in Deiner \n"
    "anschliessenden Verwirrung fest gegen die Schlaefe. Er lacht!\n",
    "Der Zechi ruelpst @WEM ins Gesicht und schlaegt @WEM anschliessend \n"
    "fest auf die Schlaefe!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(14,
  ({"Der Zechpreller groehlt: Ich schauf mich <hicksch> kaputt, iiiiich bin \n"
    "sooo tolll!\n",
    "Der Zechpreller beginnt ploetzlich zu weinen!?\n",
    "Der Zechpreller johlt: DAAAAAASCH LEBEN ISCHT SCHOEN, LALA LALA LALA "
    "JUCHEEEE!\n",
    "Der Zechpreller lallt: HU - H<hicksch>A! Isch bring Euch alle um, jaha! "
    "*ruelps*\n",
    "Der Zechpreller macht seltsame Bewegungen mit seinen Haenden. Er denkt \n"
    "wohl, er koenne "
    "Karate - wie laecherlich er aussieht.\n",
    "Der Zechpreller rueplst.\n",
    "Der Zechpreller fragt: Luscht auf ein Wettsaufen?\n",
    "Der Zechpreller hickst.\n"
   })
  );

  SetAttackChats(80,
  ({"Der Zechpreller groehlt: Du hascht <hicksch> keine Schanze! Isch ramm' \n"
  "Dich ungespitzt "
    "in den *ruelps* Alkohol... aeh nein, Boden!\n",
    "Der Zechpreller schreit: Haha isch kann Karateeee, damit hack isch Di' "
    "um!\n",
    "@@fackel@@"
   })
  );

  SUID;
  if(random(100)>70) CLONEME("/obj/fackel");
  if(random(100)>70) CLONEME("/obj/fackel");
}

void init()
{
  if( find_call_out("modify_hp") == -1 ) call_out("modify_hp",1,TP);
  ::init();
}

void die(int poisondeath)
{
  pfadnpc::npc_dies(poisondeath);
  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf und hickst.",
        "kratzt sich am Kopf und hickst.",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: He<hicks>eee!",
        "sagt: He<hicks>eee!",
        0);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "waelzt sich laut lachend am Boden. Du wunderst Dich.",
        "waelzt sich laut lachend am Boden. Du wunderst Dich.",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "grummelt irgendwas.",
        "grummelt irgendwas.",
        0);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Wascholl da<hicks>s? *boerp*",
        "sagt zu "+TPN+": Wascholl da<hicks>s? *boerp*",
        0);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf.",
        "kratzt sich am Kopf.",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "gafft verstaendnislos: Hoeoeoeoe?",
        "gafft verstaendnislos: Hoeoeoeoe?",
        0);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "lallt: DANGESCHOEOEOEOEOEOEOEN!!!!",
        "lallt: DANGESCHOEOEOEOEOEOEOEN!!!!",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "hickst.",
        "hickst.",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "singt ein Lied fuer Dich! Es hoert sich grauenhaft an.",
        "singt ein Lied fuer "+TPN+"! Es hoert sich grauenhaft an.",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Der Zechi "+macher));
  tell_room(ENV(TO), BS("Der Zechi "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void catch_tell(string str)
{
  string who, what;
  object room;

  if(!(room=ENV(TO))) return;
  if(InFight())       return;

  if(sscanf(str,"%s sagt: %s", who, what)==2)
  {
    what = what[0..<2];

    //find_player("wraz")->Message("0\n");
    if(find_call_out("tschechern")==-1&&(what=="eksch"||what=="ex")&&
       !beim_saufen)
      call_out("tschechern",2,lower_case(who));
    beim_saufen=1;
  }

  //::catch_tell(str);
  return;
}

void tschechern(string name)
{
  object player;

  //find_player("wraz")->Message("1\n");
  if(!player=find_player(name)) return; // player nicht da
  //find_player("wraz")->Message("2\n");
  if(ENV(player)!=ENV(TO)) return; // nicht im selben raum
  //find_player("wraz")->Message("3\n");
  if(InFight()) return; // im kampf
  //find_player("wraz")->Message("4\n");

  beim_saufen=1;

  call_out("saufen",0,player);
  return;
}

void saufen(object player)
{
  //find_player("wraz")->Message("5\n");
  if(!interactive(player)) return; // player nicht da
  //find_player("wraz")->Message("6\n");
  if(ENV(player)!=ENV(TO)) return; // nicht im selben raum
  //find_player("wraz")->Message("7\n");
  if(InFight()) return; // im kampf
  //find_player("wraz")->Message("8\n");

  switch (counter)
  {
    case 0:
      player->Message(BS(
        "Der Zechpreller meint: Wie Du willscht! Dann <hicksch> fangen "
        "wir an!"));
      ENV(player)->Message(BS(
        "Der Zechpreller und "+player->Name()+" beginnen um die Wette zu "
        "trinken!"),MSGFLAG_SENSE,([MSGFLAG_EXCLUDE:({player})]) );
      counter++;
      call_out("saufen",2,player);
      break;

    case 1:
      player->Message(BS(
        "Der Zechpreller drueckt Dir eine Flasche Schnaps in die Hand, "
        "schnappt sich selbst auch eine und ihr beginnt das Zeug "
        "runterzuschuetten."));
      ENV(player)->Message(BS(
        "Sie trinken direkt aus einer Flasche Schnaps!"),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
      counter++;
      call_out("saufen",2,player);
      break;

    case 2:
     if(player->drink_drink(2,20+random(30),1)) {
      player->Message(BS(
        "Ihr trinkt..."));
      ENV(player)->Message(BS(
        "Sie trinken..."),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
      counter++;
      call_out("saufen",2,player); }

     else {
      player->Message(BS(
        "Ihr trinkt... Dir wird uebel!"));
      ENV(player)->Message(BS(
        "Sie trinken..."),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
        counter=123;
        call_out("saufen",2,player); }
      break;

    case 3:
     if(player->drink_drink(2,50+random(20),1)) {
      player->Message(BS(
        "Und trinkt... die Flasche wird immer leerer!"));
      ENV(player)->Message(BS(
        "Und trinken!"),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
      counter++;
      call_out("saufen",2,player); }

     else {
      player->Message(BS(
        "Ihr trinkt weiter... Dir wird uebel!"));
      ENV(player)->Message(BS(
        "Und trinken..."),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
        counter=123;
        call_out("saufen",2,player); }
      break;

    case 4:
     if(player->drink_drink(2,20+random(20),1)) {
      player->Message(BS(
        "Und trinkt!!! Nur noch ein Schluck!!"));
      ENV(player)->Message(BS(
        "Und trinken weiter!"),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
      counter++;
      call_out("saufen",2,player); }

     else {
      player->Message(BS(
        "Ihr trinkt weiter... Dir wird uebel!"));
      ENV(player)->Message(BS(
        "Sie trinken..."),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
        counter=123;
        call_out("saufen",2,player); }
      break;

    case 5:
     if(player->drink_drink(2,5,1)) {
      player->Message(BS(
        "Deine Flasche ist leer! Mann bist Du jetzt betrunken! Du fuehlst "
        "Dich unsterblich!"));
      clone_object(OBJ "alkoholbonus")->move(player,M_NOCHECK);
      die(0);
      ENV(player)->Message(BS(
        player->Name()+" gewinnt das Wettsaufen!"),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
      counter=0;
      beim_saufen=0; }

     else {
      player->Message(BS(
        "Beim letzten Schluck wird Dir uebel..."));
      ENV(player)->Message(BS(
        "Sie trinken..."),MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
        counter=123;
        call_out("saufen",2,player); }
      break;

    case 123:
      player->Message(BS(
        "Du uebergibst Dich! Der Zechpreller lacht Dich aus!"));
      ENV(player)->Message(BS(
        player->Name()+" uebergibt sich und verliert somit."),
        MSGFLAG_SENSE,
        ([MSGFLAG_EXCLUDE:({player})]) );
      counter=0;
      beim_saufen=0;
      break;

    default:
      player->Message(BS(
        "Fehler! Bitte Magier Wraz informieren."));
      counter=0;
      beim_saufen=0;
      break;
  }
}

string fackel()
{
  command_me("zuende fackel an");
  return "";
}
