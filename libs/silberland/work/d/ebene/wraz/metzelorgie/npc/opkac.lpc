// Ein Opkac - Schlachtfeld
//
// Von Wraz / Mendralim

#include "../def.h"

#define RANDOM_BONUS_DEFEND WMASTER->query_random_bonus_defend()

//inherit "std/mnpc";
inherit "/std/npc/spells";
inherit "/p/std/npc/nekro_npc"; // um von Nekros beherrscht werden zu koennen
inherit NPC "npc.lpc";

string heroes;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  heroes=read_file(ZONE "list/heroes")+"\nwraz";

  SetProp(P_SHORT, "Ein Opkac");
  SetProp(P_LONG,
    "Das Opkac ist ein elfengrosses, rosanes Etwas. Seine Haut, sofern man "
    "das so nennen kann, wabbelt wie Pudding. Hin und wieder erkennst Du "
    "Leichenteile in dem Opkac herumschwimmen, die vermutlich von hier "
    "gefallenen Kriegern stammen. Arme oder Beine hat es nicht wirklich."
  );

  AddDetail( ({"haut","konsistenz"}),
    "Sie ist rosa. Die Konsistenz ist undefinierbar.");

  SetProp(P_NAME, "Opkac");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"opkac", "etwas", "NOWIMPY", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  set_living_name("opkac");

  create_default_npc(35,4500);

  SetProp(P_XP, QueryProp(P_XP)/2 );

  SetProp(P_HANDS, ({""
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_RACE, "Schleimgestalt");
  SetProp(P_SIZE, 230);
  SetProp(P_WEIGHT, 300000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_INFO, "Das Opkac scheint sich aus den vielen Leichen irgendwie "
  "selbst zu formen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Opkac ist aufgrund seines anatomischen Aufbaues nicht faehig, "
    "etwas zu tragen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      0.5, DT_WATER:       0.1
     , DT_AIR:      -0.5, DT_LIGHTNING: 0.0, DT_EXPLOSION:   1.0
     , DT_SOUND:    -0.5, DT_LIGHT:    -0.5, DT_ELECTRIC:   -0.5
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.5
     , DT_HOLY:      0.2, DT_UNHOLY:    0.1, DT_MAGIC:      -0.5
     , DT_MIND:     -0.5, DT_SLASH:     0.5, DT_BLUDGEON:    0.2
     , DT_PIERCE:    0.5, DT_SQUEEZE:   0.5, DT_WHIP:        0.5
     , DT_RIP:       0.5
     ])
  );

  SetProp(P_MSGIN, "matscht herein");
  SetProp(P_MSGOUT, "matscht");
  SetProp(P_MMSGIN, "matscht herein");
  SetProp(P_MMSGOUT, "matscht davon");

  SetProp(P_MNPC_AREA, ({ ROOM "m" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "m08");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " zerplatzt in winzige Tropfen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp(P_SPELLRATE,70);

  AddDefaultSpell(3,500, DS_MASS_DAMAGE,
    "Das Opkac spritzt Fluessigkeit durch den Raum.\n",
    "Das Opkac spritzt Fluessigkeit durch den Raum.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 1,
    "Das Opkac schlabbert Dich ein.\n",
    "Das Opkac schlabbert @WEN ein!\n",
    DT_WATER,"contract",([SP_SHOW_DAMAGE:1]) );

  SetChats(3,
  ({"Das Opkac schwabbelt herum.\n",
    "Das Opkac blubbert.\n",
    "Die Hand eines Toten taucht kurz an der Oberflaeche des Opkac auf, "
    "ehe \nsie wieder darin versinkt.\n",
    "Das Opkac riecht nach Verwesung.\n",
    "Das Opkac stinkt ekelhaft.\n"
   })
  );

  SUID;
}

void die(int poisondeath)
{
  //string player_uid;

  //if(TP) player_uid = TPU;
  //else if(previous_object()) player_uid = getuid(previous_object());
  //else player_uid = "unknown_uid";

  if(TP)
  {
    WMASTER->npc_death_log("standardnpc", TO->Name(RAW), TPU, TPN);
    npc::jadering_xp(TP, QueryProp(P_LEVEL));
  }
  else if(previous_object())
  {
    WMASTER->npc_death_log("standardnpc", TO->Name(RAW), 
      getuid(previous_object()),
      explode(file_name(previous_object()),"/")[<1]);
  }
  else
  {
    WMASTER->npc_death_log("standardnpc", TO->Name(RAW), "unknown_uid", "unknown_player");
  }

  call_other(IMASTER, "DropItems", ENV(TO), QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);
}

void contract(object enemy, int damage, mixed dam_type)
{
  if(deep_present("\nwaauxri", enemy)) return;
  if( !random(4) ) return; // 25%ige Ansteckungschance

  clone_object(OBJ "waauxri")->move(enemy, M_NOCHECK);

  return;
}

int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if ( strstr(heroes,lower_case( getuid(enemy) )) )
    return ::Defend(dam+random(RANDOM_BONUS_DEFEND), dtypelist, spell, enemy);

  else return ::Defend(dam, dtypelist, spell, enemy);
}

int query_random_bonus_defend()
{
  return RANDOM_BONUS_DEFEND;
}

void InformDefend(object enemy)
{
  Kill(enemy);
}