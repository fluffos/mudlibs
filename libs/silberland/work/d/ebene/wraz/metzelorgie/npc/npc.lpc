// Schlachtfeld
// Wraz / Mendralim
// Schlachtfeld NPC erben von hier

#include "../def.h"

inherit "std/thing/properties";

// Handling des Wiedererlangens verlorener XP, wenn man Jadering hat
void jadering_xp(object player, int lvl)
{
  object jadering;
  jadering=present("\nwrazjadering",player);

  if ( !jadering ) return;

  // XP Rueckgabe
  if ( !random( 200/lvl ) ) jadering->GivePlayerXP(player);

  // Verbesserung der Skillboni im Ring
  jadering->add_levels(lvl);

  return;
}