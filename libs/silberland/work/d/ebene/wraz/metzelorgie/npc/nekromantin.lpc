// Nekromantin
// Pfad beim Schlachtfeld
// Von Wraz / Mendralim

#include "../def.h"

inherit "/p/std/npc/necromancer_npc";
inherit NPC "pfadnpc.lpc";
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;
  if(getuid(previous_object())!=getuid(find_object(WMASTER))) {
  	TO->remove(0);
  	return; }

  ::create();

  SetProp(P_SHORT, "Eine widerliche Feenekromantin");
  SetProp(P_LONG,
    "NIE haettest Du Dir vorstellen koennen, dass Feen ihr gutes Denken und "
    "ihre heilige Mentalitaet aufgeben koennten und zum Boesen wechseln! "
    "Doch diese Fee beweist Dir das Gegenteil. Ihre Fluegel sind komplett "
    "verstuemmelt, sodass sie nicht mehr fliegen kann, ihr Gesicht ist "
    "zerfleischt und ihre Haende sind wund. Sie scheint nichts mehr "
    "mit einer normalen Fee gemeinsam zu haben.");

  SetProp(P_NAME, "Feenekromantin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"nekromantin", "fee", "feenekromantin", "NOWIMPY", "\nwache",
  "Messermeister","feennekromantin", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  SetProp(P_NAME_ADJ, ({"widerlich"}) );
  AddAdjective( ({"widerlich","widerlicher","widerliches","widerliche",
  "widerlichen"}) );

  set_living_name("wrazfeenekromantin");

  create_necromancer_npc(37,7,6,1); // zuvor (37,6,5,1)

  SetProp(P_MAX_HP, 800+random(350)); // zuvor 700+random(250)

  SetProp(P_XP, (QueryProp(P_XP)*4)/3);

  SetProp(P_HANDS, ({" mit ihren wunden Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "Untoter");
  AddClass( ({ "Fee","NOWIMPY" }) );
  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_RESISTANCE_STRENGTHS , QueryProp(P_RESISTANCE_STRENGTHS) +
    ([  DT_HOLY:      0.8]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Feenekromantin faucht Dich wuetend an!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "roechelt.\n");

  SetChats(2,
  ({"Die Feennekromantin roechelt.\n"
   ,"Die Feennekromantin wuetet umher. Nie haettest Du gedacht, dass Dir "
   "eine \nkleine Fee so viel Angst einjagen kann!\n"
   }));


  SUID;
  CLONEME(WEAPON "feendolch" );
  command("zuecke dolch");

  //CLONEME(ARMOUR "" );
  //command("trage alles");
}

void init()
{
  if( TP && interactive(TP) && (find_call_out("modify_hp") == -1) )
    call_out("modify_hp",1,TP);
  ::init();
}

void die(int poisondeath)
{
  pfadnpc::npc_dies(poisondeath);
  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}
