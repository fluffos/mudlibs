// Der Meisterschlaechter
// Mit der Axt des Sterbens
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit NPC "npc.lpc";

object weapon_obj;
int brausch;
string weapon;

void arm_me()
{
  do // selten hat er mehr als 1 Waffe dabei (Update 2.2.24)
  {
    switch(random(22)) // (zuvor 19, Update 2.2.24)
    {
      case 0..3: // 4
        weapon = "axt";
        break;
      case 4..7: // 4
        weapon = "bidenhaender";
        break;
      case 8..10: // 3
        weapon = "schwert";
        break;
      case 11..12: // 2 (zuvor 3, Update 2.2.24)
        weapon = "hellebarde";
        break;
      case 13..15: // 3
        weapon = "kriegshammer";
        break;
      case 16..17: // 2
        weapon = "peitsche";
        break;
      case 18..19: // 2 (added 2.2.24)
        weapon = "dolch";
        break;
      case 20..21: // 2 (added 2.2.24)
        weapon = "kriegsbogen";
        break;

      default:
        weapon = "axt";
        break;
    }
    weapon_obj=clone_object(WEAPON + "sterbe" + weapon);
    weapon_obj->move(TO,2);
  }
  while(!random(25));

  command("zuecke " + weapon);

  if(QueryProp(P_MAX_HANDS) - QueryProp(P_USED_HANDS) > 0)
  {
    switch(random(4))
    {
      case 0:
        CLONEME(ZONE "instrument/todeshorn");
        command("trage todeshorn");
      break;
      case 1:
        CLONEME(ZONE "instrument/todestrommel");
        command("trage todestrommel");
      break;
      default:
        CLONEME("/p/armour/shield/mithrilschild");
        command("trage schild");
      break;

    }
  }

  if(!random(50))
  {
    CLONEME(SCHATTEN "armour/schattenhandschuhe");
    command("trage handschuhe");
  }

  if(dtime()[9..11]=="Dez")
  {
    CLONEME(SCHATTEN "armour/schattenhaube");
    command("trage haube");
  }
}

void create()
{
  if(!is_clone(TO)) return;
  // Aktivieren, damit man NPC nicht haendisch clonen kann:
  /*if(getuid(previous_object())!=getuid(find_object(WMASTER))) {
    TO->remove(0);
    return; }*/

  ::create();

  brausch=0;

  SetProp(P_SHORT, "Der Meisterschlaechter");
  SetProp(P_LONG,
    "Jetzt spaetestens ist Dir klar, wieso sich hier niemand her traut:\n"
    "Der Meisterschlaechter ist ein riesiger Mensch mit gewaltigen Muskeln! "
    "Sein Koerper ist uebersaet mit Narben, welche von harten Kaempfen "
    "zeugen. Tiefe Furchen zieren seine Stirn waehrend er Dich mit einem "
    "staendigen, leichten Zucken beim rechten Auge anblickt. Seine "
    "Ausstrahlung vermittelt eines eindeutig: Er wird keinen Bruchteil "
    "einer Sekunde zoegern, Dich mit seiner unglaublichen Kraft zu "
    "zerschmettern!");

  SetProp(P_NAME, "Meisterschlaechter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:60]));
  AddId(({"meisterschlaechter", "schlaechter", "NOWIMPY",
   "\nwache", "\nschlachtfeld"}));

  SetProp(P_ARTICLE, 1);

  set_living_name("wrazmeisterschlaechter");

  create_default_npc(43,2200+random(400)); // zuvor: (43,2000+random(200))

  SetProp(P_XP, ( QueryProp(P_XP) * 5) / 3 );

  SetProp(P_HANDS, ({" mit seinen eisernen Faeusten"
                    ,800 // zuvor: 600
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 235);
  SetProp(P_WEIGHT, 130000);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,23);
  SetProp(P_AGGRESSIVE, ([P_GUILD: (["berserker":0.9, 0:0.3]) ]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:    -0.3, DT_BLUDGEON:   -0.4
     , DT_PIERCE:   -0.3, DT_SQUEEZE:  -0.3, DT_WHIP:       -0.3
     , DT_RIP:      -0.3
     ]));

  SetProp(P_MSGIN, "stampft an");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kracht lautstark und tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du elende Ratte!");
  SetProp(P_FORCE_MURDER_MSG, 1);
  SetProp(P_KILL_NAME, "Der Meisterschlaechter");
  SetProp(P_KILL_MSG, "Niemand besiegt MICH!!!");

  AddInfo(DEFAULT_INFO, "BRUELLT DICH AN!\n");

  AddInfo(({"mendralim"}),
    "waelzt sich vor Lachen auf dem Boden.");

  AddInfo(({"kronang"}),
    "prustet los: Kronang! Der soll herkommen!\n"
    "Der Meisterschlaechter beugt sich vor Lachen. Dann wird sein Blick "
    "abrupt wieder ernst.");

  //AddInfo( ({"",""}),
  //  ".",
  //  "sagt: ");

  SetProp(P_SPELLRATE,60); // zuvor 50

  AddSpell(3,700,
    "Der Meisterschlaechter zertruemmert Dein Gesicht!\n",
    "Der Meisterschlaechter zertruemmert @WESSEN Gesicht!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1,
    "","",DT_BLUDGEON,"wechsel",([SP_SHOW_DAMAGE:0]));

  AddDefaultSpell(5, 650, DS_MASS_DAMAGE, // zuvor: 5, 450, DS_MASS_DAMAGE
    "Der Meisterschlaechter schlaegt Eure Koepfe zusammen!\n",
    "Der Meisterschlaechter schlaegt Eure Koepfe zusammen!\n",
    DT_BLUDGEON);

  AddDefaultSpell(4, 600, DS_MASS_DAMAGE, // zuvor: 4, 500, DS_MASS_DAMAGE,
    "Der Meisterschlaechter stoesst einen schrecklichen Schlachtruf aus!!\n",
    "Der Meisterschlaechter stoesst einen schrecklichen Schlachtruf aus!!\n",
    DT_SOUND);

  AddDefaultSpell(4, 800, DS_MASS_DAMAGE, // zuvor: 4, 600, DS_MASS_DAMAGE
   "Der Meisterschlaechter drischt um sich!\n",
   "Der Meisterschlaechter drischt um sich!\n",
   DT_BLUDGEON);

  AddSpell(3, 1, // zuvor 2
   "","",DT_SLASH,"rausch",([SP_SHOW_DAMAGE:0]));

  SetChats(3,
  ({"DER MEISTERSCHLAECHTER BRUELLT BLUTGIERIG!\n",
    "DER MEISTERSCHLAECHTER WUETET HERUM!\n",
    "DER MEISTERSCHLAECHTER ZERBIRST EINEN BAUM MIT SEINER FAUST!\n",
    "DER MEISTERSCHLAECHTER STAMPFT MIT DEM FUSS AUF!\n"
   }));

  SetAttackChats(10,
  ({"Der Meisterschlaechter schreit: ICH WERDE DICH VERNICHTEN!!\n",
    "Der Meisterschlaechter lacht: Ich habe schon Drachen zerfetzt die "
    "zehn\nmal so gross waren wie DU!\n",
    "Der Meisterschlaechter verhoehnt Dich.\n",
    "Der Meisterschlaechter waelzt sich vor Lachen auf dem Boden: DU NARR!\n",
    "Der Meisterschlaechter spottet: Denkst Du ernsthaft, Du bist meinen \n"
    "stahlharten Muskeln gewachsen?\n",
    "Der Meisterschlaechter sagt abwertend: Komm wieder, wenn Dir Deine \n"
    "Mami nicht mehr beim Anziehen helfen muss!\n",
    "Der Meisterschlaechter fragt: Wo haben's Dich denn rausgelassen?\n",
    "Der Meisterschlaechter meint: Frueher gab es noch echte Krieger!\n",
    "DER MEISTERSCHLAECHTER GRUNZT WUETEND UND LAUT BRUELLEND HERUM!!\n"
   }));

  SUID;

  arm_me();

  if(!random(20)) CLONEME(SCHATTEN "obj/g_balsam");
  CLONEME("/d/astral/feyaria/frostania/obj/wsalbe");
}

// Ruft das Schreckgespenst herbei
void summon_schreckgespenst()
{
  object pl;
  int i;

  i=0;

  for(pl=first_inventory(ENV(TO));pl;pl=next_inventory(pl))
  {
    if(!query_once_interactive(pl)) continue;
    if(WMASTER->is_hero(getuid(pl))) i++;
  }

  // Zu wenige Helden anwesend
  if( (i < 3) && (i > 0) )
  {
    ENV(TO)->Message(BS("Du fuehlst die Macht des anwesenden Heldentums "
    "aufflammen! Schwarzer Nebel fliesst herbei, stockt kurz, und zieht sich "
    "wieder zurueck. Du fuehlst eine gewisse Enttaeuschung, als waere die "
    "Heldenmacht nicht ausreichend gewesen, um den Nebel ausreichend "
    "zu locken."));
  }

  // Genug Helden anwesend
  else if(i >= 3)
  {
    ENV(TO)->Message(BS("Du fuehlst die Macht des anwesenden Heldentums "
    "aufflammen! Schwarzer Nebel wabert herein, angelockt von der Macht."));
    clone_object( NPC "schreckgespenst_ahtawqas_vater" ) ->
      move( ENV(TO) , M_NOCHECK );
  }

  return;
}

// Setzt die Sterbe-Wartezeit der Sterbewaffe und des Sterbefokus zurueck
void reset_deathtime()
{
  object pl;
  object ob;

  for(pl=first_inventory(ENV(TO));pl;pl=next_inventory(pl))
  {
    if(!query_once_interactive(pl)) continue;
    for(ob=first_inventory(pl);ob;ob=next_inventory(ob))
    {
      if(ob->id("\nsterbewaffe") && ob->QueryProp(P_WIELDED)!=pl) continue;
      if(ob->id("\nsterbefokus") && !ob->id("\ndruiden_focusaktiv")) continue;
      if(ob->QueryProp("deathtime") < time() - 86400) continue;

      pl->Message(BS(ob->Name(WER,2) + " sprueht Funken beim Tod des "
      "Meisterschlaechters! Du bist Dir sicher, dass " + ob->QueryPronoun() +
      " nun wieder bereit ist, durch Deinen Tod maechtiger zu werden!"));
      ob->SetProp("deathtime", 0);
      break;
    }
  }

  return;
}

void die(int poisondeath)
{
  WMASTER->npc_death_log("pfadnpc", TO->Name(RAW), TPU, TPN);

  // erbt nicht von pfadnpc.c, daher hier die Aufrufe:
  weapon_obj->AddId(({"Bling","Meisterpfadbling"}));
  weapon_obj->set_collector_value(QueryProp(P_LEVEL)+200);

  npc::jadering_xp(TP, QueryProp(P_LEVEL)*3);

  reset_deathtime();
  summon_schreckgespenst();

  if(!random(10)) call_other(ROOM "p10","open_shadowrift","meisterschlaechter");

  ::die(poisondeath);
}

void wechsel(object enemy, int damage, mixed dam_type)
{
  if( random(3) || (TO->QueryProp(P_HP) < 400) ) { // zuvor random(2)
    command("zuecke " + weapon);
    switch (random(4))
    {
      case 0:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER BRUELLT BLUTGIERIG!"));
        break;
      case 1:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER SCHREIT: DEINE TAGE SIND ABGELAUFEN!"));
        break;
      case 2:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER STAMPFT WILD AUF!!"));
        break;
      case 3:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER GRINST SIEGESSICHER."));
        break;
     } }

  else {
    command("stecke "+ weapon +" weg");
    if(find_call_out("zuecke_axt") == -1) call_out("zuecke_axt",4+random(8));
    switch (random(4))
    {
      case 0:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER BRUELLT: DICH WURM VERNICHTE ICH MIT DER "
        "BLOSSEN FAUST!!!"));
      break;
      case 1:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER GRUNZT: HAHA! DU WURM!"));
        break;
      case 2:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER STOESST EINEN WILDEN KRIEGSSCHREI AUS!!"));
        break;
      case 3:
      ENV(TO)->Message(BS(
        "DER MEISTERSCHLAECHTER HAELT DIR SEINE FAUST PROVOKANT "
        "VOR DIE AUGEN!"));
        break;
     } }
  return;
}

void rausch(object enemy, int damage, mixed dam_type)
{
  int rausch_runden;

  if(!brausch)
  {
    brausch=1;
    ENV(TO)->Message(BS(
      "DER MEISTERSCHLAECHTER VERFAELLT IN EINEN BLUTRAUSCH!!"));
    TO->ModifySkillAttribute(TO,SA_SPEED,300+random(201),
                             rausch_runden = 3+random(30));
    call_out("reset_rausch",rausch_runden + 10);
    return;
  }

  else return;
}

void reset_rausch()
{
  brausch = 0;
  return;
}

void zuecke_axt()
{
  command("zuecke " + weapon);
  return;
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "BRUELLT DICH AN: LASS MICH!!!!",
        "BRUELLT "+TPN+" AN!!",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "GROART: STIRB!!!",
        "GROOOAAAART "+TPN+" AN: STIRB!!!!",
        1);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "TRITT DICH FEST!",
        "TRITT "+TPN+".",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "SCHREIT: DU WAGST... ICH TOETE DICH!",
        "SCHREIT "+TPN+" AN: DU WAGST... ICH TOETE DICH!",
        1);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "BRUELLT: ES REICHT!!",
        "BRUELLT "+TPN+" AN: ES REICHT!!!",
        1);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "GRUMMELT!",
        "GRUMMELT!",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "SCHREIT: WAAAARRRGHHH!!!",
        "SCHREIT: WAAAARRRGHHH!!!",
        1);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "GRUMMELT LEISE.",
        "GRUMMELT LEISE.",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "GRUMMELT.",
        "GRUMMELT.",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "SCHREIT: HAHA! ICH TOETE DICH JETZT!",
        "SCHREIT "+TPN+" AN: HAHA!! ICH TOETE DICH JETZT!",
        1);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("DER MEISTERSCHLAECHTER "+macher));
  tell_room(ENV(TO), BS("DER MEISTERSCHLAECHTER "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void give_notify(object obj) // GIVE_NOTIFY ----------------------------------
{
  object *inv;
  int i;

  // Damit er nicht sofort das zerstoert, was in arm_me() gecloned wird
  if(obj->QueryProp(P_CLONE_TIME) > time()-4) return;

  // Wenn Sterbewaffe: ganzen Inv zerstoeren & neues holen
  if(obj->id("\nsterbewaffe"))
  {
    if(!this_object()->id("meisterschlaechter")) return; // Nur zur Sicherheit...
    inv=all_inventory(this_object());
    if(inv && sizeof(inv))
      for(i=sizeof(inv)-1;i>=0;i--)
      {
        tell_room(ENV(TO),BS("Der Meisterschlaechter zermerscht "+inv[i]->name(WEN)+" lachend!"));
        catch(inv[i]->remove());
        if (inv[i]) destruct(inv[i]);
      }
    tell_room(ENV(TO),BS("Der Meisterschlaechter stampft hart auf, und aus den Schatten formen "
      "sich feste Gegenstaende! Er grinst Dich ueberlegen an."));
    arm_me();
  }

  else {
    tell_room(ENV(TO),BS("Der Meisterschlaechter zermerscht "+obj->name(WEN)+" wuetend!"));
    catch(obj->remove());
    if (obj) destruct(obj);
  }
}

int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  dmg_debug(dam, dtypelist, spell, enemy);
  return ::Defend(dam, dtypelist, spell, enemy);
}