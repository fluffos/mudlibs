void die(int poisondeath)
{
  object ob;

  WMASTER->npc_death_log("standardnpc", TO->Name(RAW), TPU, TPN);

  ob=clone_object(OBJ "bling");
  WMASTER->bling_prop(ob,"militaer"+i);
  if(QueryProp(P_LEVEL)<40)
    ob->set_collector_value(QueryProp(P_LEVEL)+5); // Bonus fuer Spells
  if(QueryProp(P_LEVEL)>39)
    ob->set_collector_value(QueryProp(P_LEVEL)+30);
  if( !member(({"Punkt","Strich","Ring von einem Rangabzeichen",
    "Ring und ein Strich","Ring und zwei Striche","Ring und drei Striche",
    "Strich und Zwei Punkte","Strich und ein Punkt"}),ob->name()) )
        ob->SetProp(P_ARTICLE, 0);
  ob->move(TO,M_GET);

  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  call_other(IMASTER, "DropItems", ENV(TO), QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: Lass mich!",
        "sagt zu "+TPN+": Lass mich!",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: HOER AUF!",
        "sagt zu "+TPN+": HOER AUF!",
        0);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf...",
        "kratzt sich am Kopf...",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "SCHREIT: DAS WARS FUER DICH!",
        "SCHREIT "+TPN+" AN: DAS WARS FUER DICH!",
        1);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "BRUELLT: STIRB!",
        "BRUELLT "+TPN+" AN: STIRB!",
        1);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "ignoriert "+TPN+".",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt",
        0);
      break;

    case "nett":
    case "neutral":
    case "traurig":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TPN+" nicht.",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Der "+QueryProp(P_NAME)+" "+macher));
  tell_room(ENV(TO), BS("Der "+QueryProp(P_NAME)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void toten(string who)
{
  object ob;
  if(!ob=find_player(who) ) return;
  if(!interactive(ob) ) return;
  if(ENV(ob)!=ENV(TO) ) return;
  if(InFight()) return;

  ob->Message(BS(
    "Der "+TO->QueryProp(P_NAME)+" schreit Dich an: DU SCHIMPFST MICH? NA WARTE!!"));

  ENV(ob)->Message(BS(
    "Der "+TO->QueryProp(P_NAME)+" schreit "+ob->Name()+
    " an: DU SCHIMPFST MICH? "
    "NA WARTE!!"),MSGFLAG_SOUND,([MSGFLAG_EXCLUDE : ({ ob }) ]) );

  Kill( ob );
}

void catch_tell(string str)
{
  string who, what, *arwhat;
  object room;
  int n;

  if(!room=ENV(TO)) return;
  if(InFight())       return;

  if(sscanf(str,"%s sagt: %s", who, what)==2)
  {
    what = what[0..<2];
    who = lower_case(who);
    arwhat=explode(lower_case(what), " ");

    for(n=0;n<sizeof(arwhat);n++)
    {
      if( member(schimpfwoerter, arwhat[n]) != -1 ) {
        if(find_call_out("toten")==-1) call_out("toten",0,who);
        break; }
    }
  }
  return;
}

int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if ( strstr(heroes,lower_case( getuid(enemy) )) )
    return ::Defend(dam+random(RANDOM_BONUS_DEFEND), dtypelist, spell, enemy);

  else return ::Defend(dam, dtypelist, spell, enemy);
}

int query_random_bonus_defend()
{
  return RANDOM_BONUS_DEFEND;
}

void InformDefend(object enemy)
{
  Kill(enemy);
}