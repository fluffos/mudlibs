    "Der "+rang[i,0]+" schlaegt Dir eine tiefe Fleischwunde in den Arm!!\n",
    "Der "+rang[i,0]+" schlaegt @WEM eine tiefe Fleischwunde in den Arm!!\n",
    DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetChats(3,
  ({"Der "+rang[i,0]+" blickt nervoes um sich.\n",
    "Der "+rang[i,0]+" schreit unerwartet laut auf! GRAAAAARGH!!\n"
   }));

  SetAttackChats(10,
  ({"Der "+rang[i,0]+" grinst: HAHA, ENDLICH!\n",
    "Der "+rang[i,0]+" verzieht sein Gesicht ernst.\n",
    "Der "+rang[i,0]+" konzentriert sich auf den Kampf.\n"
   }));

  SUID;
  if(i>32) CLONEME( "/p/weapon/sword/bihaender" );
  if(i<=32) CLONEME( "/p/weapon/sword/langschwert" );
  command("zuecke schwert");
  command("zuecke bihaender");

  if(!random(8)) CLONEME( "/p/armour/armour/kettenhemd" );
  if(!random(4)) CLONEME( "/p/armour/boots/kampfstiefel" );
  if(!random(4)&&i>30) CLONEME( "/p/armour/helm/kampfhelm" );
  if(!random(4)&&i<=30) CLONEME( "/p/armour/helm/titanhelm" );
  if(!random(6)&&i>35) CLONEME( "/p/armour/gloves/titanhandschuhe" );
  if(!random(4)&&i>50) CLONEME( "/p/armour/trousers/kettenhose" );
  command("trage alles");
