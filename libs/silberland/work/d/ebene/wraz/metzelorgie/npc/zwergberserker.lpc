// Zwergenberserker
// Schlachtfeld
// von Wraz / Mendralim

#include "../def.h"

#define RANDOM_BONUS_DEFEND WMASTER->query_random_bonus_defend()

inherit "/p/std/npc/berserker_npc";
inherit NPC "npc.lpc";

string heroes;

int g_level;
string title;
string *schimpfwoerter;

void guild_level()
{
  switch (random(100))
  {
    case 0 .. 5:
      title="Ein kleiner Zwergenberserker";
      SetProp(P_NAME_ADJ, ({"klein"}) );
      AddId("Axtkaempfer");
      AddAdjective( ({"klein","kleiner","kleines","kleine","kleinen"}) );
      g_level=1;
      break;
    case 6 .. 12:
      title="Ein Zwergenberserker des Ranges Axtkaempfer";
      AddId( "axtkaempfer" );
      AddId("Axtkaempfer");
      g_level=2;
      break;
    case 13 .. 20:
      title="Ein erfahrener Zwergenberserker";
      SetProp(P_NAME_ADJ, ({"erfahren"}) );
      AddId("Axtkaempfer");
      AddAdjective( ({"erfahren","erfahrener","erfahrenes","erfahrene",
        "erfahrenen"}) );
      g_level=3;
      break;
    case 21 .. 30:
      title="Ein wuetender Zwergenberserker";
      SetProp(P_NAME_ADJ, ({"wuetend"}) );
      AddId("Axtexperte");
      AddAdjective( ({"wuetend","wuetender","wuetendes","wuetende",
        "wuetenden"}) );
      g_level=4;
      break;
    case 31 .. 43:
      title="Ein Zwergenberserker der Stufe Metzler";
      AddId( "Metzler" );
      AddId("Axtexperte");
      g_level=5;
      break;
    case 44 .. 64: title="Ein Zwergenberserker"; g_level=6; break;
    case 65 .. 78:
      title="Ein grosser Zwergenberserker";
      SetProp(P_NAME_ADJ, ({"gross"}) );
      AddId("Axtexperte");
      AddAdjective( ({"gross","grosser","grosses","grosse","grossen"}) );
      g_level=7;
      break;
    case 79 .. 87:
      title="Ein blutruenstiger Zwergenberserker";
      SetProp(P_NAME_ADJ, ({"blutruenstig"}) );
      AddId("Axtexperte");
      AddAdjective( ({"blutruenstig","blutruenstiger","blutruenstiges",
        "blutruenstige","blutruenstigen"}) );
      g_level=8;
      break;
    case 88 .. 94:
      title="Ein Zwergenberserkermeister";
      AddId("Axtmeister");
      AddId( ({"zwergenberserkermeister", "meister"}) );
      g_level=9;
      break;
    case 95 .. 99:
      title="Ein legendaerer Zwergenberserker";
      SetProp(P_NAME_ADJ, ({"legendaer"}) );
      AddId("Axtmeister");
      AddAdjective( ({"legendaer","legendaerer","legendaeres","legendaere",
        "legendaeren"}) );
      g_level=10;
      break;
    default: title="Ein Programmierfehler.."; break;
  }
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  heroes=read_file(ZONE "list/heroes")+"\nwraz";

  guild_level();
  schimpfwoerter=explode(read_file(OBJ "schimpfwoerter"), "\n");

  SetProp(P_SHORT, title);
  SetProp(P_LONG,
    "Der Zwerg sieht sehr kampferfahren aus. Er hat viele Narben am ganzen "
    "Koerper und schnauft Dich aggressiv an.");

  SetProp(P_NAME, "Zwergenberserker");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"zwergenberserker", "NOWIMPY", "zwerg", "berserker", "Axtexperte",
    "Krieger", "\nschlachtfeld"}));
  set_living_name("\nschlachtfeld_minions_by_wraz");
  SetProp(P_ARTICLE, 1);

  create_default_berserker(20+g_level*2,g_level);

  SetProp(P_HANDS, ({" mit seinen Faeusten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "zwerg");
  SetProp(P_SIZE, 110+random(20));
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, -300+random(600));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  if(QueryProp(P_ALIGN)<-200) SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" NIMMT DAS NICHT!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.3
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:    -0.2, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]));

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht weg");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "geht weg");

  SetProp(P_MNPC_AREA, ({ ROOM "m" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "m10");
  SetProp(P_MNPC_WAIT, ({ 40, 30, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "ARRRR NEEEEIN!");
  SetProp(P_KILL_MSG, "GROOOOAAAAAAARRRRRRRR!!!!!!!!");

  AddInfo(DEFAULT_INFO, ({"arrrrrrt!\n",
  	"grunzt Dich an.\n",
  	"grunzt Dich WUETEND an!\n",
  	"schnauft wild.\n"}) );
  //AddInfo(Magier, MAGIER+" hat mich erschaffen.","sagt: ");

  AddInfo( ({"zwerg","arrr", "ar", "arr", "zwerge", "arrrr"}),
    "Zwerge sind die BESTEN!",
    "schreit: ");

  AddInfo( ({"pfad"}),
   "Sprichst Du vom Pfad des TODES??",
   "schaut Dich ploetzlich scharf an: ");

  AddInfo( ({"pfad des todes"}),
   "Bisher ist noch niemand von dort zurueck gekehrt! Es gibt da Geruechte.."
   ". ach egal.",
   "fluestert Dir zu: ");

  AddInfo( ({"geruechte"}),
   "Man sagt, die Staerksten der Staerksten, Meister der Magie und "
   "Herrscher des Boesen halten sich dort auf, MAGIE! Sie koennen "
   "diesen Ort nicht verlassen! Der TOD herrscht dort! Bewacht von "
   "einer gigantischen Kreatur aus reinster Erde stehen sie entlang "
   "des Pfades... des TODES!",
   "sagt leise mit erregter Stimme: ");

  AddInfo( ({"staerksten der staerksten","meister der magie",
    "herrscher des boesen","magie"}),
     "Niemand weiss etwas genaueres darueber.",
     "sagt: ");

   AddInfo( ({"tod"}),
    "WILLST DU MEINEN? DANN KAEMPFE WIE EIN MANN!!",
    "BRUELLT: ");

  AddInfo( ({"kreatur"}),
    "Sie laesst nie mehr als einen todesmutigen Kaempfer passieren...");

  SetProp(P_SPELLRATE,15);

  AddSpell(1,200,
    "Der Zwergenberserker tritt Dir in den Bauch.\n",
    "Der Zwergenberserker tritt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(3,
  ({Name(WER, 1)+" GROOOOOAAAAAAAARRRRRRRRRTT!!!!!!!\n"
   ,Name(WER, 1)+" sucht nach Edelsteinen.\n"
   }));

  SetAttackChats(10,
  ({Name(WER, 1)+" AAAAAAARRRRGGGHHHTTTTTTT.\n"
   ,Name(WER, 1)+" flucht.\n",
   Name(WER,1)+" freut sich ueber die wilde Schlaegerei!\n"
   }));

  SUID;

  if(g_level==8 && random(100)<10) CLONEME("/p/weapon/axe/streitaxt" );
  else if(g_level==9 && random(100)<20) CLONEME("/p/weapon/axe/streitaxt" );
  else if(g_level==10 && random(100)<60) CLONEME("/p/weapon/axe/streitaxt" );
  else if(random(100)<20) CLONEME("/d/gebirge/angrox/obj/zwergenaxt" );
  else if(random(100)<20) CLONEME("/d/gebirge/dusty/zwerge/obj/zkaxt" );
  else CLONEME("/p/weapon/axe/kriegsbeil" );
  command("zuecke axt");
  command("zuecke beil");

  if(!random(4)) CLONEME("/p/armour/armour/kettenhemd" );
  command("trage alles");

  log_file("d/ebene/metzelorgie/debug_invis_zwergenberserker.log",
    dtime()+" create() in \n "+(TO?file_name(TO)+" ":"error: !TO, ")+(TO?TO->Name():"")+"\n");
}

void die(int poisondeath)
{
  object ob;

  log_file("d/ebene/metzelorgie/debug_invis_zwergenberserker.log",
    dtime()+" die() in \n "+(TO?file_name(TO)+" ":"error: !TO, ")+(TO?TO->Name():"")+"\n");

  WMASTER->npc_death_log("standardnpc", TO->Name(RAW)+g_level, TPU, TPN);

  // Sie suchen Edelsteine, sie haben Edelsteine :)
  "/obj/gemmaster"->DistributeGem(
    g_level/2, // fixe Anzahl Edelsteine
    g_level, // + random Anzahl
    g_level > 7 ? 1 : 2, // Gildenlevel > 7 -> dann auch magische Edelsteine
    1);

  ob=clone_object(OBJ "bling");
  WMASTER->bling_prop(ob,"berserker"+g_level);
  ob->set_collector_value(QueryProp(P_LEVEL)+g_level*3); // Bonus fuer Gilde
  ob->move(TO,M_GET);

  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  call_other(IMASTER, "DropItems", ENV(TO), QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);

  log_file("d/ebene/metzelorgie/debug_invis_zwergenberserker.log",
    dtime()+" NotifyPlayerDeath() in \n "+(TO?file_name(TO)+" ":"error: !TO, ")+(TO?TO->Name():"")+"\n");
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TPN+" nicht.",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt Dich an.",
        "grummelt "+TPN+" an.",
        0);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert kurz wird aber dann sofort wieder ernst.",
        "kichert kurz wird aber dann sofort wieder ernst.",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "bruellt Dich laut an!",
        "bruellt "+TPN+" laut an!",
        0);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "tritt Dich.",
        "tritt "+TPN+".",
        0);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf.",
        "kratzt sich am Kopf.",
        0);
      break;

    case "intim":
      if(TP->QueryProp(P_GENDER)==2&&TP->QueryProp(P_RACE)=="Zwerg")
      call_out("reaction", 0, TP,
        "sagt: Oh, hallo schoene Frau!",
        "sagt zu "+TPN+": Oh, hallo schoene Frau!",
        0);
      else
       call_out("reaction", 0, TP,
        "schreit Dich an!!!",
        "schreit "+TPN+" an!!!",
        1);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "nickt Dir nur zu.",
        "nickt "+TPN+" nur zu.",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TPN+" nicht.",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "schaut weg.",
        "schaut weg.",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void toten(string who)
{
  object ob;
  if(!ob=find_player(who) ) return;
  if(!interactive(ob) ) return;
  if(ENV(ob)!=ENV(TO) ) return;
  if(InFight()) return;

  switch (random(3))
  {
   case 0:
  ob->Message(BS(
    Name(WER,1)+" bruellt: DU SCHIMPFST MICH? "+
    "BIST DEEEEEEEEEPPAT???"));

  ENV(ob)->Message(BS(
    Name(WER,1)+" bruellt "+ob->Name()+
    " an: DU SCHIMPFST MICH? "
    "BIST DEEEEEEEEEPPAT???"),MSGFLAG_SOUND,([MSGFLAG_EXCLUDE : ({ ob }) ]) );
   break;

   case 1:
   ob->Message(BS(
    Name(WER,1)+" bruellt: NET MIT MIR!!"));

   ENV(ob)->Message(BS(
    Name(WER,1)+" bruellt "+ob->Name()+
    " an: NET MIT MIR!!"
    ),MSGFLAG_SOUND,([MSGFLAG_EXCLUDE : ({ ob }) ]) );
   break;

   default:
   ob->Message(BS(
    Name(WER,1)+" bruellt: NA WARTE! "+
    "DAS LASS ICH MIR NICHT GEFALLEN!"));

  ENV(ob)->Message(BS(
    Name(WER,1)+" bruellt "+ob->Name()+
    " NA WARTE! "
    "DAS LASS ICH MIR NICHT GEFALLEN!"),
    MSGFLAG_SOUND,([MSGFLAG_EXCLUDE : ({ ob }) ]) );
   break;
  }

  Kill( ob );
}

void catch_tell(string str)
{
  string who, what, *arwhat;
  object room;
  int n;

  if(!room=ENV(TO)) return;
  if(InFight())       return;

  if(sscanf(str,"%s sagt: %s", who, what)==2)
  {
    what = what[0..<2];
    who = lower_case(who);
    arwhat=explode(lower_case(what), " ");

    for(n=0;n<sizeof(arwhat);n++)
    {
      if( member(schimpfwoerter, arwhat[n]) != -1 ) {
        if(find_call_out("toten")==-1) call_out("toten",0,who);
        break; }
    }
  }
  return;
}

int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if ( strstr(heroes,lower_case( getuid(enemy) )) )
    return ::Defend(dam+random(RANDOM_BONUS_DEFEND), dtypelist, spell, enemy);

  else return ::Defend(dam, dtypelist, spell, enemy);
}

int query_random_bonus_defend()
{
  return RANDOM_BONUS_DEFEND;
}

void InformDefend(object enemy)
{
  Kill(enemy);
}