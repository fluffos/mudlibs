// Entlassener Soeldner
//
// Von Wraz / Mendralim

#include "../def.h"

#define RANDOM_BONUS_DEFEND WMASTER->query_random_bonus_defend()

inherit "std/mnpc";
inherit "/std/npc/spells";
inherit NPC "npc.lpc";

string heroes;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  heroes=read_file(ZONE "list/heroes")+"\nwraz";

  SetProp(P_SHORT, "Ein entlassener Soeldner");
  SetProp(P_LONG,
    "Dieser Mensch diente frueher einmal als Soeldner, doch wurde er "
    "entlassen und metzelt nun hier alles nieder, was sich ihm in den "
    "Weg stellt.");

  SetProp(P_NAME, "Soeldner");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"soeldner","NOWIMPY","Krieger", "\nschlachtfeld"}));
  set_living_name("\nschlachtfeld_minions_by_wraz");
  SetProp(P_NAME_ADJ, "entlassen");

  AddAdjective( ({"entlassen","entlassener","entlassenen","entlassene",
   "entlassenes"}) );
  SetProp(P_ARTICLE, 1);

  create_default_npc(25);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_WEIGHT, 75000+random(5000));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der entlassene Soeldner blickt Dich boese an!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht grummelnd");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet schnell");

  SetProp(P_MNPC_AREA, ({ ROOM "m" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "m08");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " bricht tot zusammen.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");

  //AddInfo( ({"",""}),
  //  ".",
  //  "sagt: ");

  SetProp(P_SPELLRATE,30);

  AddSpell(5,600,
    "Der ehemalige Soeldner tritt Dir in den Bauch.\n",
    "Der ehemalige Soeldner tritt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

   AddSpell(3,550,
    "Der ehemalige Soeldner schlaegt Dir fest in den Ruecken!\n",
    "Der ehemalige Soeldner schlaegt @WEM fest in den Ruecken!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

   AddInfo( ({"midas","offizier"}),
     "Der Offizier kann mich mal!",
     "sagt: ");

   AddInfo( ({"schlachtfeld"}),
     "Willst Du kaempfen? Los doch!",
     "sagt: ");

   AddInfo( ({"blutdurst"}),
     "Den werde ich hier auf dem Schlachtfeld stillen!",
     "sagt zaehneknirschend: ");

   SetChats(1,
   ({"Der entlassene Soeldner grunzt.\n",
     "Der entlassene Soeldner murmelt etwas von 'Schlachtfeld' und 'Blutdurst'.\n",
     "Der entlassene Soeldner flucht ueber Midas.\n",
    "Der entlassene Soeldner grummelt.\n",
    "Der entlassene Soeldner spuckt auf den Boden.\n"
    }));

  SUID;
  CLONEME ("/p/weapon/sword/saebel");
  command ("zuecke saebel");

  //CLONEME(ARMOUR "" );
  //command("trage alles");
}

void die(int poisondeath)
{
  object ob;

  WMASTER->npc_death_log("standardnpc", TO->Name(RAW), TPU, TPN);

  ob=clone_object(OBJ "bling");
  WMASTER->bling_prop(ob,"soeldner");
  ob->set_collector_value(QueryProp(P_LEVEL)); // kein Bonus
  ob->move(TO,M_GET);

  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  call_other(IMASTER, "DropItems", ENV(TO), QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);
}

