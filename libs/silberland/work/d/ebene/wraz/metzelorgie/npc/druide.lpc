// Druide
// Pfad beim Schlachtfeld
// Von Wraz / Mendralim

#include "../def.h"

inherit "/p/std/npc/druid_npc";
inherit NPC "pfadnpc.lpc";
inherit NPC "npc.lpc";

object ob, foc;

void create()
{
  if(!is_clone(TO)) return;
  if(getuid(previous_object())!=getuid(find_object(WMASTER))) {
  	TO->remove(0);
  	return; }

  ::create();

  SetProp(P_SHORT, "Ein Druide");
  SetProp(P_LONG,
    "Dieser Elfendruide macht einen sehr ruhigen Eindruck. Er blickt Dich "
    "so unauffaellig und ruhig aus den Augenwinkeln an, dass Du glaubst, "
    "er weiss jetzt schon wie er Dich im Kampf, der wohl unausweichlich ist, "
    "vernichten kann. Er macht jedoch keine Anstalten, Initiative zu ergreifen.");

  AddDetail( ({"augenwinkel","augenwinkeln"}),
    "Diese truegerische Teilnahmslosigkeit und Gelassenheit, welche der Druide "
    "ausstrahlt, machen Dir Angst!");

  AddDetail( ({"augen"}),
    "Du kannst sie kaum erkennen, der Druide ist in einen Umhang gehuellt.");

  AddDetail( ({"umhang"}),
    "Er kleidet den Druiden ein und gibt ihm gleichzeitig ein anmutiges und "
    "unheimliches Aussehen");

  SetProp(P_NAME, "Druide");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:40]));
  AddId(({"druide", "elfendruilde", "elf", "\nwache", "NOWIMPY", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  set_living_name("wrazeisdruide");

  // zuvor: ("eis",42,9,550+random(300))
  create_default_druid("eis",42,11,650+random(400));

  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 197);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Druide funkelt Dich mit seinen Augen an. Du laesst @WEN fallen.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:     -1.0, DT_WATER:      -0.1
     , DT_AIR:      -0.1, DT_LIGHTNING:-0.1, DT_EXPLOSION:  -0.1
     , DT_SOUND:    -0.1, DT_LIGHT:    -0.1, DT_ELECTRIC:   -0.1
     , DT_ACID:     -0.1, DT_POISON:   -0.1, DT_TERROR:     -0.1
     , DT_HOLY:      0.4, DT_UNHOLY:   -0.1, DT_MAGIC:      -0.1
     , DT_MIND:     -0.1, DT_SLASH:    -0.2, DT_BLUDGEON:   -0.1
     , DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1
     , DT_RIP:      -0.15
     ]));

  SetProp(P_MSGIN, "schreitet andaechtig herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt leicht, aber tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "verengt seine Augenlider zu Schlitzen.\n");

  SetChats(1,
  ({"Der Druide geht sanft einige Schritte herum.\n"
   ,"Der Druide bleibt ploetzlich ganz starr stehen.\n",
    "Der Druide verharrt regungslos.\n",
    "Der Druide neigt seinen Kopf kurz leicht zur Seite.\n"
   })
  );

  SetAttackChats(10,
  ({"Der Druide fuehrt mit seinen Haenden magische Bewegungen aus!\n"
   ,"Der Druide blickt Dich scharf an!\n"
   }));

  SUID;

  ob=clone_object( ARMOUR "umhang" );
  ob->move(TO,2);
  CLONEME( "/p/armour/belt/guertel" );
  CLONEME( ARMOUR "holzring"    );
  command("trage alles");
  if(!random(2)) {
    CLONEME("/obj/gems/saphir");
    foc=clone_object(OBJ "focus_sterbe");
    foc->move(TO,2);
    foc->SetVariables(
      ({"feuer","wasser","eis","luft","erz","humus","holo"})[random(7)],
      1+random(5));
    command("aktiviere fokus mit saphir"); // im die() deaktivieren
  }
}

void init()
{
  if( find_call_out("modify_hp") == -1 ) call_out("modify_hp",1,TP);
  ::init();
}

void die(int poisondeath)
{
  if(objectp(foc)) {
    call_other(foc,"cmd_deaktivieren","fokus");
  }
  pfadnpc::npc_dies(poisondeath);
  npc::jadering_xp(TP, QueryProp(P_LEVEL)*2);
  ::die(poisondeath);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sieht Dir direkt in die Augen!",
        "blickt "+TPN+" an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "starrt Dich an.",
        "starrt "+TPN+" an.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "hebt fragend eine Augenbraue.",
        "hebt fragend eine Augenbraue.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: DU HAST ES ZU WEIT GETRIEBEN!",
        "sagt zu "+TPN+": DU HAST ES ZU WEIT GETRIEBEN!");
        Kill(TP);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "blickt Dich scharf an!",
        "blickt "+TPN+" scharf an!");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "beachtet Dich nicht.",
        "beachtet "+TPN+" nicht.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt scharf: HOER AUF!",
        "sagt scharf: HOER AUF!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "nickt Dir zu.",
        "nickt "+TPN+" zu.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sieht weg.",
        "sieht weg.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Der Druide "+macher));
  tell_room(ENV(TO), BS("Der Druide "+andere), ({pl}) );
}

object query_bling_object()
{
  return ob;
}
