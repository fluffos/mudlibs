// Entlassener Soeldner
// kurz nach Anhaengen von "Schlachtfeld" als Hinweis fuer Spieler, wo das
//  Schlachtfeld zu finden ist
// Soeldner startet in NW Eck von midas (raum /room_a2) und laeuft in SO-Eck
//  von Kyranda Burggraben
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

int i;
int on=1;

string initiate_run();

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  i=-1;

  SetProp(P_NOATTACK, "grummelt duester: Nicht hier.");

  SetProp(P_SHORT, "Ein entlassener Soeldner");
  SetProp(P_LONG,
    "Dieser Mensch diente frueher einmal als Soeldner, doch wurde er "
    "entlassen. Sein Blick ist grimmig und entschlossen. Was er wohl vor "
    "hat?");

  SetProp(P_NAME, "Soeldner");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"soeldner","NOWIMPY","Krieger", "\nschlachtfeld"}));
  SetProp(P_NAME_ADJ, "entlassen");

  AddAdjective( ({"entlassen","entlassener","entlassenen","entlassene",
   "entlassenes"}) );
  SetProp(P_ARTICLE, 1);

  set_living_name("wrazmovingsoeldner");

  create_default_npc(25);

  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    }));

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_WEIGHT, 75000+random(5000));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der entlassene Soeldner blickt Dich boese an!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "laeuft grummelnd");
  SetProp(P_MMSGIN, "steht ploetzlich neben Dir");
  SetProp(P_MMSGOUT, "rennt davon");

  //SetProp(P_MNPC_AREA, ({ ROOM "m" }) );
  //SetProp(P_MNPC_DEFAULTROOM, ROOM "m08");
  //SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  //SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " bricht tot zusammen.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo( ({"pfad"}),
    "Es gibt einen duesteren Pfad auf dem Schlachtfeld.",
    "sagt: ");

  AddInfo( ({"entlassung"}),
    "Der verfluchte Offizier hat mich entlassen!",
    "sagt: ");

  AddInfo( ({"midas"}),
    "Drecksmidas mit seinem Drecksoffizier!",
    "sagt: ");

    AddInfo( ({"drecksmidas"}),
      "Graaargh! Ich mache mich bald auf zum Schlachtfeld!",
      "bruellt: ");

  AddInfo( ({"offizier"}),
    "Der Offizier kann mich mal!",
    "sagt: ");

    AddInfo( ({"drecksoffizier"}),
      "Drecksack!",
      "sagt: ");

  AddInfo( ({"schlachtfeld"}),
    "angriffslustig.",
    "grinst ");

    AddInfo( ({"kyranda","burggraben","sarnaks"}), #'initiate_run, "sagt: ");

    AddInfo( ({"blutdurst"}),
      "Den werde ich auf dem Schlachtfeld stillen!",
      "sagt zaehneknirschend: ");

  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");

  //AddInfo( ({"",""}),
  //  ".",
  //  "sagt: ");

  SetProp(P_SPELLRATE,30);

  AddSpell(5,600,
    "Der entlassene Soeldner tritt Dir in den Bauch.\n",
    "Der entlassene Soeldner tritt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

   AddSpell(3,550,
    "Der entlassene Soeldner schlaegt Dir fest in den Ruecken!\n",
    "Der entlassene Soeldner schlaegt @WEM fest in den Ruecken!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1,
  ({"Der entlassene Soeldner grunzt.\n",
    "Der entlassene Soeldner murmelt etwas von 'Schlachtfeld' und 'Blutdurst'.\n",
    "Der entlassene Soeldner flucht ueber Midas.\n",
   "Der entlassene Soeldner grummelt.\n",
   "Der entlassene Soeldner spuckt auf den Boden.\n",
   "Der entlassene Soeldner grunzt.\n",
     "Der entlassene Soeldner murmelt etwas von 'Schlachtfeld' und 'Blutdurst'.\n",
     "Der entlassene Soeldner flucht ueber Midas.\n",
    "Der entlassene Soeldner grummelt.\n",
    "Der entlassene Soeldner spuckt auf den Boden.\n","Der entlassene Soeldner grunzt.\n",
      "Der entlassene Soeldner murmelt etwas von 'Schlachtfeld' und 'Blutdurst'.\n",
      "Der entlassene Soeldner flucht ueber Midas.\n",
     "Der entlassene Soeldner grummelt.\n",
     "Der entlassene Soeldner spuckt auf den Boden.\n",
     "Der entlassene Soeldner flucht ueber den Burggraben.\n",
     "Der entlassene Soeldner murmelt etwas von 'Sarnaks' und 'Burggraben'.\n"
   }));

  SUID;
  CLONEME ("/p/weapon/sword/saebel");
  command ("zuecke saebel");

  //CLONEME(ARMOUR "" );
  //command("trage alles");
}

void die(int poisondeath)
{
  object ob;

  write_file(LOG "standardnpc.deads",
     dtime()+" Entl. Soeldner: "+TPU+" ("+TPN+")\n");

  ob=clone_object(OBJ "bling");
  WMASTER->bling_prop(ob,"soeldner");
  ob->set_collector_value(QueryProp(P_LEVEL)); // kein Bonus
  ob->move(TO,M_GET);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "schlachtfeld.kills",
      dtime()+" Entl Soeldner killt "+player->QueryProp(P_UID)+" ("+
      player->Name()+") XP:"+lostexp+"\n");
  }
}

string initiate_run()
{
  if(i>=0 || find_call_out("run")!=-1) return "Geduld!";
  on = 1;
  call_out("run",2);
  return("Wie Du willst!");
}

void start(int onoff)
{
  on = onoff;
  if(!on) SetProp(P_CHAT_CHANCE, 1);
  else SetProp(P_CHAT_CHANCE, 20);
}

void run()
{
  if(!on) return;
  switch (i)
  {
    case -1: call_other("/d/ebene/Midas/room/room_a2","???"); // Startraum
     TO->move("/d/ebene/Midas/room/room_a2",M_TPORT);
     SetProp(P_CHAT_CHANCE, 20);
     command_me("sag Los gehts!");
     break;
    case 0 .. 2: command_me("sueden"); break; // 3x s
    case 3 .. 11: command_me("osten"); break; // 9x o
    case 12: command_me("nordosten"); break; // 1x no
    case 13 .. 15: command_me("norden"); break; // 3x n
    case 16 .. 21: command_me("osten"); break; // 6x o
    case 22: command_me("nordosten"); break; // 1x no
    case 23 .. 26: command_me("norden"); break; // 4x n
    case 27 ..  29: command_me("nordosten"); break; // 3x no
    case 30 .. 31: command_me("osten"); break; // 2x o
    case 32: command_me("norden"); break; // 1x n
    case 33: command_me("runter"); break; // 1x runter
    case 34 .. 38: command_me("osten"); break; // 5x o
    case 39 .. 42: command_me("norden"); break; // 4x n
    case 43: call_other("/room/npcasylraum","???"); // ab in den asylraum
     TO->move("/room/npcasylraum",M_TPORT);
     TO->deep_remove(1);
     break;
    default: TO->deep_remove(1); break;
  }

  if(i<43 && find_call_out("run")==-1) call_out("run",2+random(3));
  i++;
}
