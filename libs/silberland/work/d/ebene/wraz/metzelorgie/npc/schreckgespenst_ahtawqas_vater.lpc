int load_sterbeobjekt(object sterbe_obj, object pl)
{
  int fwt; // first_wield_time
  mixed ids;
  int max_fwt;
  string maechtiger;
  int weap;
  int foc;

  ids = sterbe_obj->QueryProp(P_IDS); 

  weap=sterbe_obj->id("\nsterbewaffe");
  foc=sterbe_obj->id("\nsterbefokus");
  if(!weap && !foc) return 0;

  fwt = sterbe_obj->QueryProp("first_wield_time");

  if(weap) // Objekt ist eine Sterbewaffe
  {
    // Tode und LostXP in Waffe laden
    sterbe_obj->add_deaths_lostxp(getuid(pl),1,pl->QueryProp(P_XP) / 200);
    log_file("d/ebene/metzelorgie/metzelorgieschreckgespenst_waffenladungen", 
      dtime()+" "+
      "pl: "+pl->Name()+", uid: "+getuid(pl)+", xp: "+pl->QueryProp(P_XP) / 200+"\n");
  }
  else if(foc) // Objekt ist ein Sterbefokus
  {
    // Tode in Sterbefokus laden
    sterbe_obj->add_deaths(getuid(pl),10);
    log_file("d/ebene/metzelorgie/metzelorgieschreckgespenst_fokusladungen", 
      dtime()+" "+
      "pl: "+pl->Name()+", uid: "+getuid(pl)+"\n");
  }
  // wield_time wurde schon gesetzt (dh die Waffe "laeuft ab")
  if( fwt )
  {
    // Sterbewaffe: Lebensdauer verlaengern (+27 Tage +random(1..6))
    //   Wenn sich die Waffe durch den "im Gehaenge aufheben"-Trick schon 
    //   aufgeloest haette, dann nimm time()-WLT als neue first_wield_time
    if(weap) sterbe_obj->SetProp("first_wield_time",
    ( fwt > (time()-WLT) ? fwt : (time()-WLT) ) + 2332800 + random(518400));

    // Sterbefokus: +18 Tage +random(1..4)
    else if(foc) sterbe_obj->SetProp("first_wield_time",
    ( fwt > (time()-FLT) ? fwt : (time()-FLT) ) + 1555200 + random(345600));

    // Beschraenkung auf max +30 Tage in der Zukunft (in Summe haelt das Sterbeobjekt 
    //   bei 'first_wield_time = time()+30' dann 120 Tage)
    if(sterbe_obj->QueryProp("first_wield_time") > time() + 2592000)
      sterbe_obj->SetProp("first_wield_time", time() + 2592000);

    // Message an Spieler -> "Maechtiger" bzw "Langlebiger"
    maechtiger = " wird maechtiger und langlebiger!";
    // Richtige Meldung fuer rare & unique; werden nur "langlebiger"
    // Update 29.12.23 wegen eines Bugs (hab vergessen die unique/rare beim add_deaths_lostxp() auszunehmen)
    //  wurden die unique/rare ebenfalls maechtiger (und langlebiger sowieso). Im Hackstock kann man das 
    //  allerdings nicht speichern, ist also ein temporaeres Maechtiger-machen. Ich lass es so, und die
    //  Meldung wird aber jetzt auch korrekt mit "maechtiger und langlebiger" angezeigt.
    //if(match_item("\nsfrare",ids) || match_item("\nsfunique",ids))
    //  maechtiger = " wird langlebiger!";
    pl->Message(BS(
      "Schwarze Nebelbande fliessen in " + sterbe_obj->name(WEN,2) + ", und " +
      sterbe_obj->QueryPronoun(WER) + maechtiger));

    // Maximale Lebensdauer Sterbewaffe: 6 Monate -> fwt begrenzt
    if(weap) max_fwt = sterbe_obj->QueryProp(P_CLONE_TIME) + 60*60*24*30*6 - WLT;
    // Sterbefokus: 3 Monate
    else if(foc) max_fwt = sterbe_obj->QueryProp(P_CLONE_TIME) + 60*60*24*30*3 - FLT;

    if(sterbe_obj->QueryProp("first_wield_time") > max_fwt)
    {
      sterbe_obj->SetProp("first_wield_time", max_fwt);
      pl->Message(BS(
        "Einige schwarze Nebelbande stroemen aus " + sterbe_obj->name(WEM,2) + " wieder heraus! " +
        capitalize(sterbe_obj->QueryPronoun(WER)) + " scheint sich " +
        sterbe_obj->QueryPossPronoun(MALE,WEM) + " natuerlichen TOD zu naehern."));
    }
  }
  // wield_time wurde noch nicht gesetzt
  else
  {
    pl->Message(BS(
      "Schwarze Nebelbande fliessen in " + sterbe_obj->name(WEN,2) + ", und " +
      sterbe_obj->QueryPronoun(WER)+ " wird maechtiger!"));
  }

  // Sterbewaffe: HitFunc-Bonus (Zeitlich limitiert) auf die "alten" Werte (vor 
  //   dem Downgrade der Waffen)
  if(weap) call_other(sterbe_obj,"multiply_hitfunc",time()+60*60+random(60*60), 0, 4);

  return 1;
}

// Laedt einen Tod in das Sterbeobjekt, verlaengert Lebensdauer
//   Fuer Waffen zusaetzlich: Laedt einige XP in die Waffe
void sterbeobjekt_increase()
{
  object pl, ob, ob2;
  int weap_in_container_found;

  // Alle Spieler im Raum durchgehen
  for(pl=first_inventory(ENV(TO));pl;pl=next_inventory(pl))
  {
    weap_in_container_found=0;
    //DB("ebene 0 pl: "+pl->name()+"\n");
    if(!query_once_interactive(pl)) continue;

    // Gegenstaende im Spieler durchgehen (1. Ebene)
    for(ob=first_inventory(pl);ob;ob=next_inventory(ob))
    {
      //DB("  ebene 1 ob: "+ob->name()+"\n");
      if(weap_in_container_found || load_sterbeobjekt(ob, pl)) break;

      // Gegenstaende in Behaeltern durchgehen (2. Ebene)
      for(ob2=first_inventory(ob);ob2;ob2=next_inventory(ob2))
      {
        //DB("    ebene 2 ob2: "+ob2->name()+"\n");
        if(weap_in_container_found=load_sterbeobjekt(ob2, pl)) break;
      }

    }
  }

  return;
}

void die(int poisondeath)
{
  WMASTER->npc_death_log("pfadnpc", TO->Name(RAW), TPU, TPN);
  sterbeobjekt_increase();
  npc::jadering_xp(TP, QueryProp(P_LEVEL)*3);
  call_other(ROOM "p10","open_shadowrift","schreckgespenst");

  ::die(poisondeath);
}

void leiche_verwandeln()
{
  object corpse;

  corpse = present("Leiche",ENV(TO));
  if (!corpse) return;
  if (file_name(corpse)[0..10] != "/std/corpse") return;

  // Gesegnete Leiche kann nicht mehr verwandelt werden
  if (strstr(corpse->QueryProp(P_SHORT)," gesegnet)") > 0)
  {
    ENV(TO)->Message(BS(
      "Das duestere Schreckgespenst beruehrt die gesegnete Leiche, doch mit "
      "einem gequaelten, markerschuetternden Schrei zuckt es sofort "
      "von der Leiche zurueck!"),
      MSGFLAG_VISUAL);
    TO->AddHp(-(50+random(100)));
  }
  else
  {
    ENV(TO)->Message(BS(
      "Das duestere Schreckgespenst beruehrt die Leiche, die sich daraufhin "
      "zu schrecklichem, untoten Dasein erhebt!"),MSGFLAG_VISUAL);
    clone_object( NPC "schreckgespenst_minion" ) -> move( ENV(TO) , M_NOCHECK );
    corpse->remove();

    // Falls noch eine Leiche herum liegt
    if(corpse = present("Leiche",ENV(TO)))
      call_out("leiche_verwandeln",1+random(5));
  }

  return;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  call_out("leiche_verwandeln",2+random(5));
}

void drain(object enemy, int damage, mixed dam_type)
{
  object dr;

  if(!interactive(enemy)) return;
  dr = clone_object( OBJ "hp_drain" );

  // Verhindert negative MAX_HP beim Spieler
  if( -(dr->QueryProp(P_X_HEALTH_MOD)["hp"]) > (enemy->QueryProp(P_MAX_HP)) )
  {
    dr->remove();
    return;
  }
  else
  {
    dr -> move( enemy , M_NOCHECK );
    enemy->UpdateAttributes();
  }
  TO->AddHp(150+random(100));

  return;
}

void summon(object enemy, int damage, mixed dam_type)
{
  clone_object( NPC "schreckgespenst_minion" ) -> move( ENV(TO) , M_NOCHECK );

  return;
}

void reset()
{
 ::reset();
 if(!is_clone(TO)) return;
 if(QueryProp(P_CLONE_TIME) < (time()-(2700+random(2700))))
 {
   TO->move("/room/npcasylraum",M_TPORT);
   TO->remove();
 }
}

// catch_tell() zum loggen der Spielerstaerke 
void catch_tell(string str)
{
  if(!TO || !ENV(TO)) return;
  if(first_log)
  {
    log_file("d/ebene/metzelorgie/catchtell_schreckgespenst.log",
      dtime()+"------------------------------------------------\n\n");
    first_log = 0;
  }
  log_file("d/ebene/metzelorgie/catchtell_schreckgespenst.log",str);
}