int first_log = 1;

void create()
{
  if(!is_clone(TO)) return;
  /*if(getuid(previous_object())!=getuid(find_object(WMASTER))) {
  	TO->remove(0);
  	return; }*/

  ::create();

  SetProp(P_SHORT, "Ein duesteres Schreckgespenst");
  SetProp(P_LONG,
    "Diese duestere Gestalt zeigt vage humanoide Formen, die sich aus schwarzem "
    "Nebel zusammenzusetzen scheinen. Einzig der Kopf, mit seiner "
    "fuerchterlichen Grimasse und den rot gluehenden Augen, ist gut zu "
    "erkennen.");

  AddDetail( ({"nebel"}),
    "Das duestere Schreckgespenst ist von schwarzem Nebel umgeben, mit dem es "
    "zu verschmelzen scheint.");

  AddDetail( ({"kopf", "augen"}),
    "Die Augen des duesteren Schreckgespensts leuchten rot. Der ganze Kopf "
    "erinnert Dich vage an jemanden... oh nein, jetzt faellt es Dir erst auf: "
    "Das Schreckgespenst sieht dem Hobbit, Ahtawqa, aehnlich! Dir schaudert, "
    "als Dir klar wird, dass es sich um die arme Seele des gefallenen Vaters "
    "von Ahtawqa handeln muss.");

  SetProp(P_NAME, "Schreckgespenst");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:40]));
  AddId(({"schreckgespenst", "gespenst", "gestalt", "NOWIMPY", "\nwache",
  "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  SetProp(P_NAME_ADJ, ({"duester"}) );
  AddAdjective( ({"duester","duesterer","duesteres","duestere",
  "duesteren"}) );

  set_living_name("wrazschreckgespenst");

  create_default_npc(43,2200+random(400));

  SetProp(P_XP, (QueryProp(P_XP)*7)/4);

  SetProp(P_HANDS, ({" mit seiner immateriellen Beruehrung"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_TERROR})
                    }));

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 94);
  SetProp(P_WEIGHT, 10);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.7, DT_COLD:     -0.7, DT_WATER:      -0.7
     , DT_AIR:      -0.7, DT_LIGHTNING:-0.7, DT_EXPLOSION:  -0.7
     , DT_SOUND:    -0.7, DT_LIGHT:     0.1, DT_ELECTRIC:   -0.7
     , DT_ACID:     -0.7, DT_POISON:   -0.7, DT_TERROR:     -1.0
     , DT_HOLY:      0.1, DT_UNHOLY:   -1.0, DT_MAGIC:      -0.7
     , DT_MIND:     -1.0, DT_SLASH:    -1.0, DT_BLUDGEON:   -1.0
     , DT_PIERCE:   -1.0, DT_SQUEEZE:  -1.0, DT_WHIP:       -1.0
     , DT_RIP:      -1.0
     ])
  );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@CAP_WER faellt durch das Schreckgespenst einfach zu Boden.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_MSGIN, "schwebt auf schwarzen Nebelschwaden herbei");
  SetProp(P_MSGOUT, "schwebt auf schwarzen Nebelschwaden");
  SetProp(P_MMSGIN, "erscheint in einer unheimlichen Rauchwolke");
  SetProp(P_MMSGOUT, "schwebt auf schwarzen Nebelschwaden empor und davon");

  SetProp(P_DIE_MSG,  " zerfaellt in schwarze Nebelschwaden.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "saeuselt in Dein Ohr: Stirb!\n");

  AddInfo( ({"ahtawqa"}),
  "Ahtawqa? Ahtawqa... mein...","saeuselt: ");

  AddInfo( ({"sohn"}),
  "Dieser Wurm! Feigling! ... Nein, ich liebte ... hasse ... mein Sohn...",
  "saeuselt innerlich zerrissen: ");

  AddInfo( ({"frau","mutter"}),
  "HURE! Leiden soll sie, endlose Qualen erleiden im Schatten!",
  "saeuselt zornig: ");

  AddInfo( ({"schatten"}),
  "Wer wagt sich in die Schattenwelt?","saeuselt: ");

  AddInfo( ({"schattenwelt"}),
  "Wagst Du, sie zu betreten? Ha, niemals!","saeuselt haemisch: ");

  SetChats(1,
  ({"Das duestere Schreckgespenst wabert im schwarzen Nebelschleier.\n",
