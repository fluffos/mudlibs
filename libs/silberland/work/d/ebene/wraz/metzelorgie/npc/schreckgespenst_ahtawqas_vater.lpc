    "Die Gegenwart des duesteren Schreckgespensts bereitet Dir starkes "
    "Unbehagen.\n"
   }));


  SetProp(P_SPELLRATE,100);

  AddDefaultSpell(7, 550, DS_MASS_DAMAGE,
    "Das duestere Schreckgespenst faehrt durch Dich hindurch.\n",
    "Das duestere Schreckgespenst faehrt durch @WEN hindurch.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 300,
   "Das duestere Schreckgespenst entzieht Dir mit seiner Beruehrung "
   "Lebenskraft!\n",
   "Das duestere Schreckgespenst entzieht @WEM mit seiner Beruehrung "
   "Lebenskraft!\n",
   DT_TERROR,"drain",([SP_SHOW_DAMAGE:0]));

  AddSpell(2, 1,
   "Das duestere Schreckgespenst beschwoert einen Schergen herbei!\n",
   "Das duestere Schreckgespenst beschwoert einen Schergen herbei!\n",
   DT_TERROR,"summon",([SP_SHOW_DAMAGE:0]));

  SUID;
}

