// Der Ghoul
// Pfad beim Schlachtfeld
// Von Wraz / Mendralim

#include "../def.h"

inherit "/std/npc/spells";
inherit "/p/std/npc/nekro_npc";
inherit NPC "pfadnpc.lpc";
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Ghoul");
  SetProp(P_LONG,
    "Der Ghoul ist ein uebelriechendes Wesen, uebersaet von Wunden mit einer "
    "schleimigen Haut. Es laeuft wie ein Affe staendig gebueckt herum und "
    "ernaehrt sich von Leichen, egal ob frisch oder "
    "schon lange am verwesen...");

  AddDetail( ({"wunden"}),
    "Der Ghoul ist uebersaet von schleimigen Wunden, die aber irgendwie "
    "zu ihm gehoeren zu scheinen.");

  AddDetail( ({"haut"}),
    "Des Ghouls Haut ist von einem brechreizerregendem Schleim ueberzogen. "
    "Er stinkt dermassen, dass Du Dich fast uebergeben musst!");

  AddDetail( ({"affe"}),
    "Die Haltung des Ghouls erinnert Dich an die Affen in Tijara.");

  SetProp(P_NAME, "Ghoul");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"ghoul", "\nwache", "\nschlachtfeld"}));
  AddClass( ({ "Untoter","Ghoul","Wesen","NOWIMPY" }) );
  SetProp(P_ARTICLE, 1);

  set_living_name("wrazghoul");

  create_default_npc(40,1200+random(400)); // zuvor: (37,1100+random(300))

  SetProp(P_HANDS, ({" mit seinen schleimigen Krallen"
                    ,(QueryProp(P_HANDS)[1]*5)/2
                    , ({DT_RIP})
                    }));

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 140);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Ghoul faucht Dich wild an!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.1
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.2
     , DT_SOUND:     0.0, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0
     , DT_ACID:     -0.1, DT_POISON:   -0.5, DT_TERROR:     -0.5
     , DT_HOLY:      0.7, DT_UNHOLY:   -0.7, DT_MAGIC:       0.0
     , DT_MIND:     -0.3, DT_SLASH:    -0.05, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]));

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "faucht Dich boese an.\n");

  SetProp(P_SPELLRATE,50); // zuvor: 40

  AddSpell(5,350,
    "Der Ghoul zerkratzt Dir Dein Gesicht.\n",
    "Der Ghoul zerkratzt @WESSEN Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

   AddSpell(4,400,
    "Der Ghoul spritzt Dich mit einem ekelhaften Schleim an.\n",
    "Der Ghoul spritzt @WEN mit einem ekelhaften Schleim an.\n",
    DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_PARALYZE,
    "Der Gestank des Ghouls faehrt Dir in die Nase, Du bist wie gelaehmt!\n",
    "@WER kann sich vor lauter ekelhaftem Gestank nicht konzentrieren.\n",
    1);

  SetChats(3,
  ({"Der Ghoul kriecht um Dich herum.\n",
    "Der Ghoul riecht an Dir.\n",
    "Ein brechreizerregender, ekelhafter Gestank geht von dem Ghoul aus.\n",
    "Der Ghoul schleicht um Dich herum.\n",
    "Der Ghoul stinkt abartig ekelhaft!\n",
    "Vor Gestank musst Du Dich fast uebergeben.\n",
    "Der Gestank des Ghouls bringt Dich fast um den Verstand!\n"
   }));

  SetAttackChats(10,
  ({"Der Ghoul springt Dich an.\n",
    "Der Ghoul faucht Dich wuetend an!\n"
   }));

  SUID;
}

void init()
{
  if( find_call_out("modify_hp") == -1 ) call_out("modify_hp",1,TP);
  ::init();
}

void die(int poisondeath)
{
  pfadnpc::npc_dies(poisondeath);
  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schleicht um Dich herum.",
        "schleicht um "+TPN+" herum.",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "naehert sich Dir bedrohlich.",
        "naehert sich "+TPN+" bedrohlich.",
        0);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "beobachtet Dich.",
        "beobachtet "+TPN+".",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "springt Dich wuetend an!",
        "springt "+TPN+" wuetend an!",
        1);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "springt Dich wuetend an!",
        "springt "+TPN+" wuetend an!",
        1);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "beobachtet Dich.",
        "beobachtet "+TPN+".",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "attackiert Dich!",
        "attackiert "+TPN+".",
        1);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "faucht Dich an.",
        "faucht "+TPN+" an.",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "beobachtet Dich.",
        "beobachtet "+TPN+".",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "schleicht um Dich herum.",
        "schleicht um "+TPN+" herum.",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Der Ghoul "+macher));
  tell_room(ENV(TO), BS("Der Ghoul "+andere), ({pl}) );

  if(kill) Kill(pl);
}
