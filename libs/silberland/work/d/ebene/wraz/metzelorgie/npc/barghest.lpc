// Ein Barghest
// Pfad beim Schlachtfeld, letzer Gegner vor Meisterschlaechter
// Von Wraz / Mendralim

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit NPC "pfadnpc.lpc";
inherit NPC "npc.lpc";

int shape; // 0=goblin  1=wolf

int change_shape(int new_shape)
{
  if ( (new_shape<0 || new_shape>1) && (shape<0 || shape>1) )
  {
    command_me("trage alles");
    shape=0;
    return -2;
  }

  if (new_shape<0 || new_shape>1)
    return -1;

  shape=new_shape;

  if (shape)
  {
    command_me("ziehe alles aus");

    AddId( ({"wolf","kreatur","wolfgestalt","wolfbarghest"}) );
    RemoveId( ({"goblin","goblingestalt"}) );

    SetProp( P_NAME, "Wolfbarghest");
    set_living_name("wrazbarghest");

    RemoveDetail( ({"mensch"}) );
    RemoveDetail( ({"fratze","wolfsgesicht","wolf","aehnlichkeit"}) );
    RemoveDetail( ({"augen","hass"}) );

    AddDetail( ({"krallen"}),
      "Die Krallen des Barghests sind lange, scharfe, gefaehrliche Waffen, mit "
      "denen er seinen Feinden den Koerper zerkratzt und das Fleisch aufschlitzt.");

    AddDetail( ({"fell"}),
      "Das graue Fell des Wolfbarghest schimmert blaeulich-rot. Es wirkt "
      "bedrohlich auf Dich.");

    AddDetail( ({"augen"}),
      "Des Barghests Augen blicken Dich hasserfuellt an. Manchmal meinst Du, "
      "ein oranenes Feuer in ihnen aufleuchten zu sehen!");

    AddDetail( ({"bosheit","hass","boese"}),
      "Du spuerst den innigen Hass des Barghests! Das Boese ist seine Natur!");

    AddDetail( ({"intelligenz","klugheit"}),
      "So boese der Barghest auch ist, umso erschreckender ist die Klugheit, "
      "die er ausstrahlt! Er ist gewiss ein gefaehrlicher Gegner!");

    SetProp(P_SPELLS, ({}) );

  AddSpell(4,340,
    "Der Barghest verbeisst sich in Deinen Koerper!\n",
    "Der Barghest verbeisst sich in @WESSEN Koerper!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,370,
    "Des Barghests Augen gluehen tieforange auf und er beisst Dir tief ins Fleisch!\n",
    "Des Barghests Augen gluehen tieforange auf und er beisst @WEM tief ins Fleisch!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,950,
    "Unerwartet rammt Dir der Barghest seinen maechtigen Kiefer in die Rippen!\n",
    "Unerwartet rammt der Barghest @WEM seinen maechtigen Kiefer in die Rippen!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));
  }

  if (!shape)
  {
    command_me("trage alles");

    AddId( ({"goblin","goblingestalt"}) );
    RemoveId( ({"wolf","kreatur","wolfgestalt"}) );

    SetProp( P_NAME, "Goblinbarghest");
    set_living_name("wrazbarghest");

    RemoveDetail( ({"krallen"}) );
    RemoveDetail( ({"fell"}) );
    RemoveDetail( ({"augen"}) );
    RemoveDetail( ({"bosheit","hass","boese"}) );
    RemoveDetail( ({"intelligenz","klugheit"}) );

    AddDetail( ({"mensch"}),
      "Ein Goblin, gross wie ein Mensch, und drei mal so stark mindestens! "
      "Seine Fratze aehnelt einem Wolfsgesicht.");

    AddDetail( ({"fratze","wolfsgesicht","wolf","aehnlichkeit"}),
      "Tatsaechlich hat der Barghest in seiner Goblingestalt noch immer "
      "eine Aehnlichkeit mit einem Wolf.");

    AddDetail( ({"augen","hass"}),
      "Ungehemmt blicken Dich die Augen boese an. Ein orangenes Feuer, genaehrt "
      "von Hass scheint in ihnen zu brennen!");

    SetProp(P_SPELLS, ({}) );

  AddSpell(4,390,
    "Der Barghest stoesst Dir seine Krallen in die Beine.\n",
    "Der Barghest stoesst @WEM seine Krallen in die Beine.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,340,
    "Der Barghest kratzt mit seinen scharfen Krallen Deinen Leib wund!\n",
    "Der Barghest kratzt mit seinen scharfen Krallen @WESSEN Leib wund!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,850,
    "Der Goblinbarghest schlitzt Dir mit orangegluehenden Augen das Fleisch auf!\n",
    "Der Goblinbarghest schlitzt @WEM mit orangegluehenden Augen das Fleisch auf!\n",
    DT_SLASH,([SP_SHOW_DAMAGE:1]));
  }

  return shape;
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  WMASTER->set_status("last_wache",0);

  SetProp(P_SHORT, "Ein Barghest");
  SetProp(P_LONG,
    "Der Barghest ist eine graessliche, wolfaehnliche Kreatur. Sie hat lange, scharfe "
    "Krallen und ein blau-rot schimmerndes Fell. Die Augen des Barghest strahlen eine "
    "unglaubliche Bosheit, erschreckenderweise auch Intelligenz aus."
  );

  SetProp(P_NAME, "Barghest");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5,T_RANGE_MAX:40]));
  AddId(({"barghest", "kreatur", "NOWIMPY", "\nwache", "\nschlachtfeld"}));
  SetProp(P_ARTICLE, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" schuechtert Dich mit lautem Gebruell ein!\n" }) );

  set_living_name("wrazbarghest");
  enable_commands();

  create_default_npc(44,1700+random(200)); // zuvor (40,1600+random(200))

  SetProp(P_HANDS, ({" mit seinem scharfen Gebiss"
                    ,(QueryProp(P_HANDS)[1]*7)/4 // zuvor (QueryProp(P_HANDS)[1]*3)/2
                    , ({DT_PIERCE})
                    }));

  SetProp(P_RACE, "Barghest");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.1, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.2
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.1, DT_TERROR:      0.0
     , DT_HOLY:      0.6, DT_UNHOLY:   -0.1, DT_MAGIC:      -0.3
     , DT_MIND:     -0.1, DT_SLASH:    -0.05,DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]));

  SetProp(P_DIE_MSG,  " stoesst noch ein tiefes Bruellen aus und bricht \n"
    "dann tot zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Der Teufel soll Dich holen, %s!!");
  SetProp(P_KILL_MSG, "Ich verschlinge Deine Leiche!");

  AddInfo(DEFAULT_INFO, "bruellt Dich an!\n");

  SetProp(P_SPELLRATE,65);

  SetChats(1,
  ({Name(WER, 1)+" durchbohrt Dich mit seinem gehaessigen Blick.\n",
    Name(WER, 1)+" ist kurzfristig verschwunden! Du bist verwirrt.\n",
    Name(WER, 1)+" schleicht leise umher!\n",
    "@@change@@"
   })
  );

  SetAttackChats(10,
  ({"Des Barghests Augen gluehen orange auf!\n"})
  );

  SUID;
  CLONEME("/p/armour/armour/plattenpanzer" );
  if( random(100)<20 )
    CLONEME("/p/armour/bracers/plattenzeug" );

  //change_shape( random(2) );
  call_out("change_shape",2,random(2));
}

void init()
{
  if( find_call_out("modify_hp") == -1 ) call_out("modify_hp",1,TP);
  ::init();
}

void die(int poisondeath)
{
  pfadnpc::npc_dies(poisondeath);
  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void leiche_essen()
{
  object corpse;

  corpse = present("Leiche",environment(TO));
  if (!corpse) return;
  if (file_name(corpse)[0..10] != "/std/corpse") return;
  //command_me("iss leiche");  // Spielerleichen sind nicht essbar...

  ENV(TO)->Message(BS(
    "Der Barghest macht sich sofort gierig ueber die Leiche her."),MSGFLAG_VISUAL);
  corpse->remove();
  return;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  call_out("leiche_essen",2);
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  if(gruppe=="aergerlich"||gruppe=="fies"||gruppe=="frech"||gruppe=="intim")
  {
    call_out("reaction", 0, TP,
      "attackiert Dich wuetend!",
      "attackiert "+TPN+".",
        1);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Der "+QueryProp(P_NAME)+" "+macher));
  tell_room(ENV(TO), BS("Der "+QueryProp(P_NAME)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

string change()
{
  if( InFight() ) return "";

  if(shape)
  {
    tell_room( ENV(TO), BS(
      "Der Barghest wandelt seine Erscheinungsform in einen riesigen Goblin!\n") );
    change_shape(0);
    return "";
  }

  else 
  {
    tell_room( ENV(TO), BS(
      "Der Barghest verwandelt sich in eine wolfartige Kreatur!\n") );
    change_shape(1);
    return "";
  }
}

string _query_long()
{
  if (shape)
    return BS(
      "Der Barghest ist eine graessliche, wolfaehnliche Kreatur. Sie hat lange, scharfe "
      "Krallen und ein blau-rot schimmerndes Fell. Die Augen des Barghest strahlen eine "
      "unglaubliche Bosheit, erschreckenderweise auch Intelligenz aus.");

  else 
    return BS(
      "Diese fuerchterliche Kreatur sieht aus wie ein riesiger Goblin, so gross "
      "wie ein Mensch! Es handelt sich um einen Barghest. Er sieht einem "
      "Wolf nicht unaehnlich, seine Augen vermitteln Dir tiefsten Hass.");
}

string _query_short()
{
  if (shape)
    return
      "Ein Wolf";

  else 
    return
      "Ein riesiger Goblin";
}

string _query_name()
{
  if (shape)
    return "Wolfbarghest";

  else 
    return "Goblinbarghest";
}

mixed _query_hands()
{
  if (shape)
    return
      ({" mit seinem scharfen Gebiss",
      410,
      ({DT_RIP}) });

  else 
    return
      ({" mit seinen scharfen Klauen",
      440,
      ({DT_RIP,DT_PIERCE}) });
}

int _query_size()
{
  if(shape)
    return 100;

  else
    return 180;
}

int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  dmg_debug(dam, dtypelist, spell, enemy);
  return ::Defend(dam, dtypelist, spell, enemy);
}