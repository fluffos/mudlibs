// Die STUFE-Werte leiten sich von dieser Formel ab:
// =((EXP(((STUFE)/12)*faktor))-1)*330000/(EXP(faktor)-1)
// STUFE: 1 bis 12, faktor: 2.5
// defines liegen in ../def.h

