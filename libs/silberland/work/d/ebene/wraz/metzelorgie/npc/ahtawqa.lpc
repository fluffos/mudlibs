int has_id(object ob, string str) // HAS_ID ----------------------------------------------------------
 {
   if(ob->id(str)) return 1;
   else return 0;
 }

void feint(object enemy, int damage, mixed dam_type) // FEINT ----------------------------------------
{
  object *inv;
  int i;

  if(!InFight()) return; // yriskandur im musentempel -> macht NPC aggro auf Spieler, selbst NOATTACK npc
  if(QueryProp(P_NOATTACK)) return;

  inv = all_inventory(ENV(TO));

  for(i=0;i<sizeof(inv);i++)
  {
    if(inv[i] && inv[i]->id("Krieger") && member(QueryProp(P_DEFENDERS),inv[i]) == -1)
    {
      ENV(TO)->Message(BS(Name(WER)+" provoziert "+inv[i]->name(WEN)+" so hinterhaeltig, dass "
        "dieser stattdessen "+Name(WESSEN)+" Feinde attackiert!"));
      AddDefender(inv[i]);
    }
  }
}

void summon_schlucker(object enemy, int damage, mixed dam_type) // SUMMON_SCHLUCKER -----------------
{
  object npc;
  object room;
  int nr;

  if(!InFight()) return; 
  if(QueryProp(P_NOATTACK)) return;

  room = ENV(TO);

  if(!room) return;
  // Sicherheitsabfrage? Eigentich ueberfluessig
  //if( file_name(room)[0..30] != ROOM ) return;

  // check: ist sie schon da oder hat kein ENV? wurde sie innerhalb der letzten 24h gesummoned?
  if( (
      !find_living("muellschluckermutter") ||
      !ENV(find_living("muellschluckermutter"))
      )
      &&
      QueryProp("last_mutter_summon") < time()-60*60*24)
  {
    // mschlucker_mutter summonen (blueprint!)
    call_other("/d/ebene/wraz/metzelorgie/npc/mschlucker_mutter","???");
    find_living("muellschluckermutter")->move(ENV(TO),M_TPORT);
    SetProp("last_mutter_summon",time());
    //  diese soll Ahtawqa per AddPursuer folgen
    TO->AddPursuer(find_living("muellschluckermutter"));
  }

 //wenn weniger als 10 schlucker da sind -> 3-10 clonen
  nr = 3 + random(8);
  if(sizeof(
      filter_array(
        all_inventory(
          ENV(TO)),
            #'has_id, //'
            "muellschlucker")) < 10)
    while(nr >= 0)
    {
      npc=clone_object(NPC "entsorg_sf");
      npc->move(room,M_GO);
      nr--;
    }
}

void flee(object enemy, int damage, mixed dam_type) // FLEE --------------------------------
{
  string *rooms;
  string room_no;

  if(!InFight()) return; 
  if(QueryProp(P_NOATTACK)) return;
  
  rooms = ({"m02","m02a","m03","m04","m05","m06","m07",
            "m07a","m07b","m08","m09","m10","m10a",
            "m10b","m11","m12","m13","m14","m14a","m14b",
            "m23","m24","m25","m26","m27","m28",
            "m29"});
  room_no = rooms[random(sizeof(rooms))];
  call_other(ROOM + room_no, "???");
  // M_NO_ATTACK -> Ahtawqa bekommt keinen Begruessungsschlag
  TO->move(ROOM + room_no, M_GO + M_NO_ATTACK); 
}

int Defend(int dam, string *dtypelist, int spell, object enemy) // DEFEND -----------------
{
  SetProp("last_defend_call", time()); // --> um im reset() P_NOATTACK wieder zu setzen

  if(!random(3)) TO->ModifySkillAttribute(TO,SA_SPEED,200+random(201),8+random(7));

  if(!random(2))
  {
    dam /= 4;
    enemy->Message(BS(Name()+" weicht Deinem Angriff geschickt aus!"));
  }

  return ::Defend(dam, dtypelist, spell, enemy);
}

void init() // INIT ------------------------------------------------------------------------
{
  ::init();
  
  if(InFight() && TP)
  {
    if (TP->id("Krieger"))
    {
      ENV(TP)->Message(BS(Name(WER)+" provoziert "+TP->name(WEN)+" so hinterhaeltig, dass "
        "dieser stattdessen "+Name(WESSEN)+" Feinde attackiert!"));
        AddDefender(TP);
    }
    else if (TP->id("muellschlucker")) AddDefender(TP);
  }
  if(InFight() || IsEnemy(TP) || i_seq > 0 || QueryProp("last_defend_call") > time() - 600) return;

  if(TP && interactive(TP) && find_call_out("CheckPerson") == -1)
  call_out("CheckPerson", random(3));
}

void InformDefend(object enemy) // INFORMDEFEND ----------------------------------------------
{
  Kill(enemy);
}

int CheckPerson() // CHECKPERSON --------------------------------------------------------------
{
  mapping list;
  int gender;

  if(!TP || !interactive(TP)) return 0;
  if(!present(TP, ENV(TO))) return 0;
  if(random(5)) return 0; // nicht immer eine Meldung

  list=SMASTER->query_save();

  if(!list) return 0;

  if(!member(list,TPU)) command_me("sag "+TPN+", neu hier? Sei vorsichtig!");

  if (TP->QueryProp(P_GENDER)==2) gender = 0; // female
  else gender = 1;

  if(random(3) &&
     (dtime()[5..11]==dtime(TP->QueryProp(P_CREATION_DATE))[5..11])
   ) // Spielercharakter hat Geburtstag
   {
     command_me("sag Oh, "+TPN+"! Alles Gute zum Geburtstag! Heute gibt's "
       "doppelte Punkte fuer das Abliefern von Beweisen fuer Dich!");
     write(BS("Ahtawqa gratuliert Dir herzlich."));
     say("Ahtawqa gratuliert "+TPN+" herzlich.\n", TP);
   }

  else {
    switch (list[TPU])
    {
      case 1 .. STUFE8:
      return 0;
      break;

      case (STUFE8+1) .. STUFE9:
      command_me("sag Hallo "+TPN+", wieder beim Schlachten?");
      write(BS("Ahtawqa grinst Dich an."));
      say("Ahtawqa grinst "+TPN+" an.\n", TP);
      if(!random(10))
      {
        write(BS("Ahtawqa fluestert Dir zu: Du bist schon weit gekommen, "
        "daher verrate ich Dir ein kleines Geheimnis: Die Beweise lassen sich "
        "fast alle als 'Bling' ansprechen!"));
        write(BS("Ahtawqa zwinkert Dir zu."));
        say("Ahtawqa fluestert "+TPN+" etwas zu und zwinkert dann.\n", TP);
      }
      return 1;
      break;

      case (STUFE9+1) .. STUFE10:
      command_me("sag Veteran "+TPN+"!");
      write(BS("Ahtawqa nickt Dir zu."));
      say("Ahtawqa nickt "+TPN+" zu.\n", TP);
      if(!random(10))
      {
        write(BS("Ahtawqa fluestert Dir zu: Unglaublich, Deine Leistung hier! "
        "Ich habe Dir ja schon das 'Bling' Geheimnis verraten. Noch eines "
        "will ich Dir jetzt erzaehlen: Die Ex-Garnisonssoldaten aus Kyranda "
        "reagieren alle auf 'Ex-Garnisonssoldat'."));
        write(BS("Ahtawqa zwinkert Dir zu."));
        say("Ahtawqa fluestert "+TPN+" etwas zu und zwinkert dann.\n", TP);
      }
      return 1;
      break;

      case (STUFE10+1) .. STUFE11:
      command_me("sag Legende "+TPN+"! Weiter so, dann bist Du bald " +
       (gender ? "ein Held!" : "eine Heldin!") );
      return 1;
      break;

      case (STUFE11+1) .. HELDENPUNKTE:
      command_me("sag "+TPN+"! Toete noch mehr dieser widerlichen Kreaturen hier! "
      "Du bist fast " + (gender ? "ein Held!" : "eine Heldin!") );
      return 1;
      break;

      case (HELDENPUNKTE+1) .. (HELDENPUNKTE*2):
      if ( !WMASTER->is_meisterpfadbling(TPU) )
      {
        command_me("sag "+TPN+"! Du waerst schon " +
         (gender ? "ein Held" : "eine Heldin") + ", aber den Meister "
        "des Pfades musst Du noch bezwingen.");
        return 1;
        break;
      }
      else
      command_me("sag Held" +(gender ? " " : "in ") +TPN+
       "! Es freut mich, Dich zu sehen! Wieder am Schlachten?");
      write(BS("Ahtawqa verneigt sich vor Dir."));
      say("Ahtawqa verneigt sich vor "+TPN+".\n", TP);
      if(!random(30))
      {
        write(BS("Ahtawqa fluestert Dir zu: Vergiss nicht, unsere kleinen "
        "Geheimnisse zu nutzen: Beweise sind fast alle 'Bling', und die "
        "Ex-Kyrandasoldaten alle 'Ex-Garnisonssoldat'! Erzaehl's aber nicht "
        "weiter."));
        write(BS("Ahtawqa zwinkert Dir zu."));
        say("Ahtawqa fluestert "+TPN+" etwas zu und zwinkert dann.\n", TP);
      }
      if(!random(10)&&(TPN=="Fenris")&&(TO->QueryProp("fenris")<time()))
      {
        TO->SetProp("fenris",time()+(60*60*24*4));
        write(BS("Ahtawqa blickt sich verschwoererisch um und wispert Dir "
        "dann ins Ohr: Fenris! Fuer Dich habe ich eine ganz besondere "
        "Kleinigkeit, nur fuer Dich! Hier."));
        write(BS("Dann steckt er Dir einen kleinen Gegenstand zu."));
        say("Ahtawqa wispert "+TPN+" konspirativ etwas ins Ohr.\n", TP);
        clone_object(OBJ "schluckersalbe")->move(TP,M_NOCHECK);
      }
      if((TPN=="Mendralim")&&(TO->QueryProp("mendra")<time()))
      {
        TO->SetProp("mendra",time()+(60));
        write(BS("Ahtawqa blickt sich verschwoererisch um und wispert Dir "
        "dann ins Ohr: Mendra! Fuer Dich habe ich eine ganz besondere "
        "Kleinigkeit, nur fuer Dich! Hier."));
        write(BS("Dann steckt er Dir einen kleinen Gegenstand zu."));
        say("Ahtawqa wispert "+TPN+" konspirativ etwas ins Ohr.\n", TP);
        clone_object(OBJ "schluckersalbe")->move(TP,M_NOCHECK);
      }
      return 1;
      break;

      default:
      if ( !WMASTER->is_meisterpfadbling(TPU) )
      {
        command_me("sag "+TPN+"! Du waerst schon ein"+
        (gender ? " " : "e ") +list[TPU]/HELDENPUNKTE+
        "-fache"+(gender ? "r" : "") +" Held, aber den Meister des Pfades "
        "musst Du noch bezwingen.");
        return 1;
        break;

      }
      else
      command_me("sag "+TPN+", "+list[TPU]/HELDENPUNKTE+
      "-fache"+(gender ? "r Held!" : " Heldin!") +" Es ist mir eine Ehre, "
      "Dich zu begruessen!");
      write(BS("Ahtawqa verneigt sich tief vor Dir."));
      say("Ahtawqa verneigt sich tief vor "+TPN+".\n", TP);
      return 1;
      break;
    }
   }

  return 1;
}

int is_player_local(string name) // IS_PLAYER_LOCAL -----------------------------------
{
  // Magier und Testspieler -> 0
  // nur "echte" Spieler/Seher -> 1
  return WMASTER->is_player(name);
}

mixed sort_list() // SORT_LIST -------------------------------------------------------
{
  // das ganze geht vermutlich viel einfacher mit order_alist();
  // davor muesste das mapping in eine alist konvertiert werden, was
  // nicht so einfach ist (siehe doc/LPC/mappings)

  mapping map;
  mixed *mix;
  int i;
  int n;
  string *keys;

  map=SMASTER->query_save();

  // Magier und Testies rausfiltern
  map = filter_mapping(map, "is_player_local");

  if(!map) return ({ ({"\nerrorloadingmap",-1}) });
  if(!m_sizeof(map)) return ({ ({"\nniemand",-1}) });

  keys=m_indices(map);

  // nur ein Eintrag vorhanden:
  if(sizeof(keys)==1) return ({ ({keys[0],map[keys[0]]}) });

  mix=allocate(2);
  mix[0]=allocate(2);
  mix[1]=allocate(2);

  // ersten beiden Eintraege:
  if(map[keys[0]]>map[keys[1]])
  {
    mix[0]=({keys[0],map[keys[0]]});
    mix[1]=({keys[1],map[keys[1]]});
  }

  else
  {
    mix[0]=({keys[1],map[keys[1]]});
    mix[1]=({keys[0],map[keys[0]]});
  }

  // Beginn Schleife --------------------
  for(i=2;i<sizeof(keys);i++)
  {
    // leeren Eintrag erzeugen
    mix+=({"",0});

    // wenn kleiner als der letzte -> am Ende eintragen
    if(map[keys[i]]<mix[sizeof(mix)-2][1])
    {
      mix[<1]=({keys[i],map[keys[i]]});
      continue;
    }
    // wenn groesser als der letzte...
    else
    {
      // Beginn Schleife 2 -------------
      for(n=sizeof(mix);n>2;n--)
      {
        // Eintrag um 1 nach hinten verschieben
        mix[n-1]=mix[n-2];
        // wenn kleiner als der vorletzte -> einfuegen, fertig
        if(map[keys[i]]<mix[n-3][1])
        {
          mix[n-2]=({keys[i],map[keys[i]]});
          break;
        }
        // ... ?
        if(n-4<0)
        {
          mix[n-2]=mix[n-3];
          mix[n-3]=({keys[i],map[keys[i]]});
          break;
        }
      }

    }
  }
  return mix;
}

string heldenstatus() // HELDENSTATUS ----------------------------------------
{
  mapping list;
  int progress; // Prozent bis naechste Stufe
  string answer;
  int gender; // 0: female, 1: male/neuter

  if(QueryProp(Q_TIME)>time()-4)
    return "Ich rede mir noch den Mund fusselig...";
  SetProp(Q_TIME, time());
  // damit das Mud nicht crashed :)

  list=SMASTER->query_save();
  progress = 0;

  if(!list) return "Ich kann mich gerade nicht erinnern...";
  if(!member(list,TPU)) return "Du hast mir noch nie etwas gebracht.";

  if (TP->QueryProp(P_GENDER)==2) gender = 0; // female
  else gender = 1; // male or neuter

  switch (list[TPU])
  {
    case 1 .. STUFE1: answer = "Du hast bis jetzt nur ganz wenige Krieger "
     "getoetet.";
    break;

    case (STUFE1+1) .. STUFE2:
     answer = "Du hast bis jetzt sehr wenige Krieger erschlagen.";
    break;

    case (STUFE2+1) .. STUFE3:
     answer = "Bislang hast Du wenige Krieger auf dem Schlachtfeld getoetet.";
    break;

    case (STUFE3+1) .. STUFE4:
     answer = "Du hast schon einige Erfahrung hier auf dem Schlachtfeld.";
    break;

    case (STUFE4+1) .. STUFE5:
     answer = "Du hast bereits viel Erfahrung auf dem Schlachtfeld.";
    break;

    case (STUFE5+1) .. STUFE6:
     answer = "Mittlerweile hast Du sehr viel Erfahrung hier auf dem "
      "Schlachtfeld.";
     break;

    case (STUFE6+1) .. STUFE7:
     progress = ( 100 * ( list[TPU] - STUFE6 ) / ( STUFE7 - STUFE6 ) );
     answer = "Du hast unglaublich viel Erfahrung im Kampf mit den Kriegern "
      "hier!";
     break;

    case (STUFE7+1) .. STUFE8:
     progress = ( 100 * ( list[TPU] - STUFE7 ) / ( STUFE8 - STUFE7 ) );
     answer = "Die Krieger und ehemaligen Soldaten hier fuerchten Dich!";
     break;

    case (STUFE8+1) .. STUFE9:
    progress = ( 100 * ( list[TPU] - STUFE8 ) / ( STUFE9 - STUFE8 ) );
     if (gender) answer = "Du bist auf dem Schlachtfeld als gnadenloser Krieger "
      "bekannt!";
     else answer = "Du bist auf dem Schlachtfeld als gnadenlose Kriegerin "
      "bekannt!";
     break;

    case (STUFE9+1) .. STUFE10:
    progress = ( 100 * ( list[TPU] - STUFE9 ) / ( STUFE10 - STUFE9 ) );
     if (gender) answer = "Du bist ein Veteran hier auf dem Schlachtfeld!";
     else answer = "Du bist eine Veteranin hier auf dem Schlachtfeld!";
     break;

    case (STUFE10+1) .. STUFE11:
    progress = ( 100 * ( list[TPU] - STUFE10 ) / ( STUFE11 - STUFE10 ) );
     answer = "Es werden bereits Legenden ueber Dich erzaehlt!!";
     break;

    case (STUFE11+1) .. HELDENPUNKTE:
    progress = ( 100 * ( list[TPU] - STUFE11 ) / ( HELDENPUNKTE - STUFE11 ) );
     answer = "Deine Taten hier sind fast heldengleich!!!";
     break;

    case (HELDENPUNKTE+1) .. (HELDENPUNKTE*2):
    if ( !WMASTER->is_meisterpfadbling(TPU) )
    {
      if (gender) answer = "Du bist eigentlich ein Held, aber den Pfad des TODES "
             "hast du noch nicht bezwungen!";
      else answer = "Du bist eigentlich eine Heldin, aber den Pfad des TODES "
             "hast du noch nicht bezwungen!";
      break;
    }
    else
    {
      if (gender) answer = "DU BIST EIN HELD!";
      else answer = "DU BIST EINE HELDIN!";
    }

     break;

     default:
     if ( !WMASTER->is_meisterpfadbling(TPU) )
     {
       if (gender) answer = "Du bist eigentlich ein "+list[TPU]/HELDENPUNKTE+
       "-facher Held, aber den Pfad des TODES hast du noch nicht bezwungen!";
       else answer = "Du bist eigentlich eine "+list[TPU]/HELDENPUNKTE+
       "-fache Heldin, aber den Pfad des TODES hast du noch nicht bezwungen!";
       break;
     }
     else
     {
        if (gender) answer = "DU BIST EIN "+list[TPU]/HELDENPUNKTE+"-FACHER HELD!";
        else answer = "DU BIST EINE "+list[TPU]/HELDENPUNKTE+"-FACHE HELDIN!";
     }
      break;
   }

  progress = ( 100 * ( list[TPU] -
             (HELDENPUNKTE * (list[TPU]/HELDENPUNKTE))
           ) / ( HELDENPUNKTE ) ) % 100;

  switch (progress)
  {
    case 0: break;
    case 1 .. 25: answer += " Bis zur naechsten Stufe musst Du noch"
      " sehr viele Krieger toeten.";
      break;
    case 26 .. 50: answer += " Bis zur naechsten Stufe musst Du noch "
      "viele Krieger toeten.";
      break;
    case 51 .. 75: answer += " Bis zur naechsten Stufe musst Du noch "
      "einige Krieger toeten.";
      break;
    case 76 .. 90: answer += " Bis zur naechsten Stufe musst Du noch "
      "wenige Krieger toeten.";
      break;
    case 91 .. 95: answer += " Bis zur naechsten Stufe musst Du nur noch "
      "sehr wenige Krieger toeten.";
      break;
    case 96 .. 100: answer += " Bis zur naechsten Stufe musst Du nur noch "
      "ganz wenige Krieger toeten!";
      break;
  }

return answer;
}

int GetGenderFromFingerd(string pl) // GETGENDERFROMFINGERD ---------------------------
{
  string *fingerd;
  string pro;
  string rest;
  int gender;

  gender = -1;

  if(!pl) return -1;

  fingerd = explode(call_other("/p/daemon/fingerd","finger_single",pl),"\n");
  if(sizeof(fingerd)<4) return -1; // zu wenige Zeilen im "Finger" --> vermutlich gibt's den Spieler nicht

  if(sscanf(fingerd[3],"| %s ist leider nicht anwesend%s", pro, rest) == 2 ||
     sscanf(fingerd[3],"| %s ist seit %s", pro, rest) == 2 )
    switch (pro)
    {
      case "Er": gender = 1; break;
      case "Sie": gender = 0; break;
      default: gender = -1; break;
    }

  return gender;
}

string get_allheldenlist() // GET_ALLHELDENLIST ----------------------------------------
{
  string mes;
  string hstatus;
  string name;

  mixed *sorted_list;

  int i;
  int gender; // 0: female, 1: male/neuter, -1: unknown (player not loaded)

  object pl;

  if(QueryProp(Q_TIME)>time()-4)
    return "Ahtawqa sagt: Ich rede mir noch den Mund fusselig...";
  SetProp(Q_TIME, time());
  // damit Mud nicht crashed :)

  mes="\n";

  sorted_list=sort_list();

  if(sorted_list[0][0]=="\nerrorloadingmap")
    return "Ahtawqa gruebelt angestrengt... gib ihm ein paar Sekunden!";
  if(sorted_list[0][0]=="\nniemand")
    return "Ahtawqa weint: Noch niemand hat mir jemals einen Beweis fuer "
    "die Rache an einem Krieger hier gebracht...";

  for(i=0;i<sizeof(sorted_list);i++)
  {
    name = to_string(sorted_list[i][0]);
    pl = find_netdead(name) ? find_netdead(name) : find_player(name);
    if (!pl) gender = GetGenderFromFingerd(name);
    else if (pl->QueryProp(P_GENDER)==2) gender = 0;
    else gender = 1;

    switch (sorted_list[i][1])
    {
      case 0:
      hstatus="hat einen Bug gebaut";
      continue;
      break;

      case 1 .. STUFE1:
      hstatus="hat nur ganz wenige Krieger getoetet";
      break;

      case (STUFE1+1) .. STUFE2:
      hstatus="hat nur sehr wenige Krieger getoetet";
      break;

      case (STUFE2+1) .. STUFE3:
      hstatus="hat wenige Krieger getoetet";
      break;

      case (STUFE3+1) .. STUFE4:
      hstatus="hat schon einige Krieger getoetet";
      break;

      case (STUFE4+1) .. STUFE5:
      hstatus="hat schon viel Heldenerfahrung";
      break;

      case (STUFE5+1) .. STUFE6:
      hstatus="hat schon sehr viel Heldenerfahrung";
      break;

      case (STUFE6+1) .. STUFE7:
      hstatus="hat bereits unglaublich viel Heldenerfahrung";
       break;

      case (STUFE7+1) .. STUFE8:
      if (gender==1) hstatus="ist ein gefuerchteter Schlaechter";
      else if (gender==0) hstatus="ist eine gefuerchtete Schlaechterin";
      else hstatus="ist ein*e gefuerchtete*r Schlaechter*in";
       break;

      case (STUFE8+1) .. STUFE9:
      if (gender==1) hstatus="ist ein gnadenloser Schlaechter";
      else if (gender==0) hstatus="ist eine gnadenlose Schlaechterin";
      else hstatus="ist ein*e gnadenlose*r Schlaechter*in";
       break;

      case (STUFE9+1) .. STUFE10:
      if (gender==1) hstatus="ist hier ein Veteran";
      else if (gender==0) hstatus="ist hier eine Veteranin";
      else hstatus="ist hier ein*e Veteran*in";
       break;

      case (STUFE10+1) .. STUFE11:
      hstatus="ist eine Legende";
       break;

      case (STUFE11+1) .. HELDENPUNKTE:
      hstatus="ist fast heldengleich!";
       break;

      case (HELDENPUNKTE+1) .. (HELDENPUNKTE*2):
      if ( !WMASTER->is_meisterpfadbling( name ) )
      {
        if (gender==1) hstatus="ist ein Held, der den Pfad des TODES fuerchtet!";
        else if (gender==0) hstatus="ist eine Heldin, die den Pfad des TODES fuerchtet!";
        else hstatus="ist ein*e, den Pfad des TODES fuerchtende*r, Held*in!";
      }

      else
      {
        if (gender==1) hstatus="ist ein HELD!";
        else if (gender==0) hstatus="ist eine HELDIN!";
        else hstatus="ist ein*e HELD*IN!";
      }

       break;

      default:
      if ( !WMASTER->is_meisterpfadbling( name ) )
      {
        if (gender==1) hstatus="ist ein "+sorted_list[i][1]/HELDENPUNKTE+
        "-facher Held, der den Pfad des TODES fuerchtet!";
        else if (gender==0) hstatus="ist eine "+sorted_list[i][1]/HELDENPUNKTE+
        "-fache Heldin, die den Pfad des TODES fuerchtet!";
        else hstatus="ist ein*e "+sorted_list[i][1]/HELDENPUNKTE+
        "-fache*r, den Pfad des TODES fuerchtende*r, Held*in!";
      }

      else
      {
        if (gender==1) hstatus="ist ein "+sorted_list[i][1]/HELDENPUNKTE+
          "-facher HELD!";
        else if (gender==0) hstatus="ist eine "+sorted_list[i][1]/HELDENPUNKTE+
          "-fache HELDIN!";
        else hstatus="ist ein*e "+sorted_list[i][1]/HELDENPUNKTE+
          "-fache*r HELD*IN!";
      }

       break;
    }
    mes+=sprintf("%3d. %-12s %s\n",i+1,
      capitalize(name),
      hstatus);
  }
  return mes;
}

string allheldenstatus() // ALLHELDENSTATUS ---------------------------------
{
  TP->More(get_allheldenlist()+"\n");
  return "grinst.";
}

string killkrieger() // KILL KRIEGER ----------------------------------------
{
  object ob;
  object *inv;
  int i;

  if(!ob=present("Krieger",ENV(TO))) return "";
  else
  {
    ENV(TO)->Message(BS(
      "Ahtawqa schleicht sich von hinten an einen Krieger heran, rammt "
      "ihm seinen Dolch seitlich in den Hals und schleppt anschliessend "
      "die Leiche zufrieden hinter einen Strauch."));

    inv=deep_inventory(ob);

    for(i=0;i<(sizeof(inv));i++)
    {
      if(inv[i]) inv[i]->remove(1);
    }

    ob->remove(1);
    return "Ahtawqa reibt sich die Haende.\n";
  }
}

string salbeninfo() // SALBENINFO -------------------------------------------
{
  int points;
  points = (SMASTER->query_bling(TPN));

  if( points < (HELDENPUNKTE*2) )
  {
    if(TPN == "Fenris") return
      "Fenris, Freund der Muellschlucker! Die Muellschluckersalbe gefaellt Dir? "
      "Die bekommen aber nur zumindest 2-fache Held*innen von mir!";
    else return "Die Muellschluckersalbe gefaellt Dir auch so gut wie Fenris? "
    "Die bekommen aber nur zumindest 2-fache Held*innen von mir!";
  }
  else if( (TO->QueryProp(TPN+"_nextsalbentime")) < time() )
  {
    clone_object(OBJ "schluckersalbe")->move(TP,M_NOCHECK);
    TO->SetProp(TPN+"_nextsalbentime",
      time()+60*60*24*( 1 + (14/(points/HELDENPUNKTE)) ));

    if(TPN == "Fenris")
      return "Fenris, Du bist ein grosser Tierfreund! Hier hast Du eine "
       "meiner Muellschluckersalben!";
    else return TPN + ", Fenris hat Dich wohl mit seiner Muellschluckerliebe "
     "angesteckt, was? Hier hast Du eine.";
  }
  else return "Aber ich habe Dir doch erst kuerzlich eine Salbe gegeben, " +
   TPN + ". Werde jetzt nicht gierig! Komm spaeter wieder.";
}

string oelinfo() // OELINFO -------------------------------------------
{
  int points;
  points = (SMASTER->query_bling(TPN));

  if( points < (HELDENPUNKTE*10) )
  {
    return "Das Muellschluckeroel ist eine seltene Besonderheit, das gebe ich "
    "nur zumindest 10-fachen Held*innen!";
  }
  else if( (TO->QueryProp(TPN+"_nextoeltime")) < time() )
  {
    clone_object(OBJ "schluckeroel")->move(TP,M_NOCHECK);
    TO->SetProp(TPN+"_nextoeltime",
      time()+60*60*24*( 1 + (300/(points/HELDENPUNKTE)) ));

    if(TPN == "Fenris")
      return "Fenris, Du bist ein grosser Tierfreund und ebenso grosser "
       "Schlachtfeldheld! Hier hast Du eines meiner besonderen "
       "Muellschluckeroele!";
    else return TPN + ", ich schaetze mir Deine Taten auf dem Schlachtfeld! "
     "Hier hast Du eines meiner besonderen Muellschluckeroele. Und richte "
     "Fenris einen schoenen Gruss von mir aus!";
  }
  else return "Das Muellschluckeroel ist eine seltene Besonderheit, " +
   TPN + ", das kann ich Dir nicht so oft geben.";
}

string ringinfo() // RINGINFO -----------------------------------------------
{
  int points;
  points = (SMASTER->query_bling(TPN));

  if( points < HELDENPUNKTE )
    return "Ach nein, wer hat Dir mein Geschenk verraten?";
  else return "Solltest Du den Jadering einmal verlieren, toete "
  "den Meisterschlaechter und bring mir den Beweis!";
}

varargs void head_sequence(object pl) // HEAD_SEQUENCE -----------------------------------------------
{
  string message;
  string text;
  string indent;
  int i;

  i = 4; // default Sekunden zwischen call_out()

  if(InFight())
  {
    if(TO && ENV(TO) && i_seq > 0)
      ENV(TO)->Message(BS(Name()+" bricht die Erzaehlung aufgrund des Kampfes ab."));
    i_seq = 0;
    SetProp(P_MNPC_FLAGS, def_mnpc_flags);
    SetProp(P_CHAT_CHANCE, def_chat_chance);
    return;
  }

  switch (i_seq)
  {
    case 0:
      if(!pl) return; // 1. Aufruf muss mit Argument pl stattfinden
      player_brought_head = pl; // Spieler der den Kopf brachte speichern, um ihn spaeter zu attackieren
      SetProp(P_MNPC_FLAGS, 0); // verhindern, dass sich Ahtawqa bewegt
      remove_call_out ("wandern");
      SetProp(P_CHAT_CHANCE, 0); // Chat-Chance derweil auf 0 setzen
      message = Name(WESSEN)+" Gesichtsausdruck versteinert abrupt.";
    break;

    case 1:
      text = player_brought_head->Name()+", Du hast meine Mutter gefunden.";
      indent = Name()+" fluestert eiskalt: ";
      i = 6;
    break;

    case 2:
      message = Name(WESSEN)+" Kaumuskeln spannen sich dermassen an, dass Du glaubst, seine "
        "Zaehne brechen zu hoeren.";
    break;

    case 3:
      text = player_brought_head->Name()+"!";
      indent = Name()+" sagt finster: ";
    break;
      
    case 4:
      text = "Du brachtest mir den Kopf meiner Mutter. Du stellst die Bosheit Xarfai's in "
        "den Schatten. Du bist das Boese.";
      indent = Name()+" sagt: ";
    break;

    case 5:
      text = "Blut fuer Blut, "+player_brought_head->Name()+". Ich werde Dich aufschlitzen, "
        "und auf Deinen Eingeweiden tanzen.";
      indent = Name()+" fluestert: ";
      message = "Dir wird uebel. Du bist Dir nicht mehr sicher, ob es so eine gute Idee war, "
        +Name()+" den Kopf seiner Mutter zu bringen...";
      i = 6;
      break;

    case 6:
      text = "YAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAARGH!";
      indent = Name()+" kreischt entfesselt: ";
      message = "Von einem Lidschlag auf den anderen laesst "+Name()+" jede Beherrschung "
      "fallen und bruellt furchteinfloessend auf!";
      i = 2;
    break;

    case 7: // Angriff
      if(present(player_brought_head,ENV(TO)))
        message = Name()+" stuerzt sich mit einem wilden Schlachtruf auf "+player_brought_head->Name()+"!";
      SetProp(P_NOATTACK, 0);
      Kill(player_brought_head);
      i = 0;
      i_seq = -1;
      break;

    default:
      i_seq = 0;
      SetProp(P_MNPC_FLAGS, def_mnpc_flags);
      SetProp(P_CHAT_CHANCE, def_chat_chance);
      return;
      break;
  }
  if(text && TO && ENV(TO)) ENV(TO)->Message("\n"+break_string(text,78,indent),MSGFLAG_SOUND);
  if(message && TO && ENV(TO)) ENV(TO)->Message("\n"+BS(message));
  i_seq++;
  if(find_call_out("head_sequence")==-1) call_out("head_sequence",i);
}

void give_notify(object ob) // GIVE_NOTIFY ----------------------------------
{
  int cvalue;
  int oldbling, newbling;
  string dummy; // notwendig?

  // Kaempft? -> nichts annehmen
  if(InFight() || IsEnemy(TP) || i_seq > 0) 
  {
    TP->Message(BS("Ahtawqa nimmt "+ob->name(WEN,1)+" nicht an, und "+
    ob->QueryPronoun(WER)+" faellt einfach auf den Boden."));
    ob->move(ENV(TO),M_NOCHECK);
    return;
  }

  // Poseys Kopf oder Leiche (== Ahtawqas Mutter)
  if(ob->id("\nposey_corpse") || ob->id("\nposey_head"))
  {
    head_sequence(TP);
    return;
  }

  // Pause, wenn man gerade Held wurde oder neue x-fach-Heldenstufe erreicht hat
  if(TP->QueryProp("sf_heldenzeit") > time() - 60)
  {
    TP->Message(break_string(
            "Jetzt beruhige Dich doch kurz und freue Dich eine Minute ueber "
            "Deinen Erfolg!",
            78, "Ahtawqa sagt: "));
    TP->Message(BS("Ahtawqa gibt Dir "+ob->name(WEN,1)+" zurueck."));
    ob->move(TP,M_NOCHECK);
    return;
  }

  // Logfile erzeugen, wenn noch nicht vorhanden
  if(!read_file(LOG "Meisterpfadbling"))
      write_file(LOG "Meisterpfadbling","Antibugzeile\n");
  if(!dummy=read_file(ZONE "list/heroes"))
      write_file(ZONE "list/heroes","Antibugzeile\n");

  // Versucht die beste Ruestung zu tragen, beste Waffe zu zuecken
  if(!ob->id("Bling") && find_call_out("tragen") == -1) call_out("tragen",2);

  if(!interactive(TP)) return; // kein spieler

  // Objekt ist kein Bling und keine Sterbewaffe
  if(!ob->id("Bling") && // kein bling und
     !ob->id("\nsterbewaffe") ) // keine sterbewaffe
  {
    TP->Message(BS(
      "Ahtawqa bedankt sich bei Dir."));
      return;
  }

  // Ab hier: Abhandlung der Bling und Sterbewaffe
  // ---------------------------------------------------------------------------

  // Bling
  cvalue=ob->query_collector_value(); // Sammelwert des Bling
  oldbling=SMASTER->query_bling(TPU); // Vorherige Spielerblingpunkte
  SMASTER->save_bling(TPU,cvalue); // Sammelwert aufaddieren
  newbling=SMASTER->query_bling(TPU); // Neue Spielerblingpunkte
  ob->set_collector_value(-1); // Sammelwert auf -1 setzen
                              // wichtig fuer Sterbewaffe! bringt nur beim
                              // ersten Abliefern Sammelpunkte
  if( ob->id("Bling") && !ob->id("Meisterpfadbling")) ob->remove(1);
  // normale Bling-Objekte werden entfernt
  //   Sterbewaffe (== Meisterpfadbling) wird spaeter zurueckgegeben

  // Sterbewaffe --------------------------------

  if( ob && ob->id("\nsterbewaffe") )
  {
    if(cvalue > 0)
    {
      // Diese Nachricht kommt, wenn die Waffe "neu" ist
      TP->Message(
        "Ahtawqa sagt fasziniert: UNGLAUBLICH!!! DU HAST DEN MEISTER "
        "DES PFADES \nBEZWUNGEN, UND DAMIT DIE MOERDER MEINER ELTERN!\n"
        "Ahtawqa erzittert ehrfuerchtig.\n");

      // Nachricht wenn kein Held und nicht genug Punkte fuer Held
      if( !WMASTER->is_hero(TPU) &&
           newbling <= HELDENPUNKTE )
        TP->Message(
          "Ahtawqa sagt ehrfuerchtig: Doch das allein reicht noch nicht, um \n"
          "ein Held zu sein. Toete mehr Krieger auf dem Feld!!\n");
    }
    // Wenn die Sterbewaffe schon gezeigt wurde, dann andere Nachricht
    if(cvalue == -1)
    TP->Message(BS(
      "Ahtawqa sagt: Beeindruckend! Aber " + ob->name(WER,1) +
      " habe ich schon gesehen. Versuche mich nicht auszutricksen! Dafuer "
      "gibt es einen kleinen Punkteabzug. Sehr klein, aber doch."));

    // *** Sterbewaffe ist "neu" ***
    if( ob->id("Meisterpfadbling") )
    {
      // waffe "alt" machen
      ob->RemoveId( ({"Meisterpfadbling","bling","Bling"}) );

      // Spieler bringt die waffe zum ersten Mal
      if( !WMASTER->is_meisterpfadbling(TPU))
       write_file(LOG "Meisterpfadbling",lower_case(TPU)+"\n");

      // Spieler ist bereits Held
      //   -> bekommt Jadering nochmal (wenn er keinen mehr hat)
      if( WMASTER->is_hero(TPU) )
      {
        object *inv;
        int i;
        int player_has_ring;

        inv=deep_inventory(TP);
        player_has_ring = 0;

        for(i=0;i<sizeof(inv);i++)
        {
          if( inv[i]->id("\nwrazjadering")) player_has_ring = 1;
        }

        if(!player_has_ring)
        {
          TP->Message(BS(
          "Ahtawqa sagt: Als Belohnung gebe ich dir den Ring nochmal, da du ihn "
          "anscheinend verloren hast."));
          clone_object(ARMOUR "ring")->move(TP,M_NOCHECK);
        }
      }

    }

    // waffe zurueckgeben
    ob->move(TP,M_NOCHECK);
    TP->Message(BS(
      "Ahtawqa gibt Dir " + ob->name(WEN,2) + " zurueck."));
  }

  // Bling (oder Sterbewaffe) ----------------------

  switch (WMASTER->is_hero(TPU))
  {
    // *** Kein Held ***
    case 0:
      // * hat genug Punkte fuer Held *
      if( newbling>HELDENPUNKTE )
      {
        // hat Meisterpfadbling noch nicht abgeliefert
        if( !WMASTER->is_meisterpfadbling(TPU) )
        {
          TP->Message(break_string(
            "Du bist ein maechtiger Krieger und hast "
            "schon heldenhaft viele Krieger auf dem Schlachtfeld getoetet! "
            "Aber den Pfad des TODES hast Du noch nicht bezwungen. Vernichte "
            "den Meister des Pfades, dann ernenne ich Dich zum Helden!",
            78, "Ahtawqa sagt begeistert: "));
          break;
        }
        // hat Meisterpfadbling bereits abgeliefert ==> NEUER HELD
        else
        {
          write_file(ZONE "list/heroes", lower_case(getuid(TP))+"\n");
          call_out("neuer_held",2,TP);
          TP->SetProp("sf_heldenzeit",time());
          break;
        }
      }

      // * hat zu wenig Punkte fuer Held *
      else if(random(2)) { // Random Motivationsnachricht
        TP->Message(BS(
        "Ahtawqa sagt: Sehr gut! Toete mehr!!")); }

      else if(!random(10)) { // Random Motivationsnachricht, Belohnungshinweis
        TP->Message(BS(
        "Ahtawqa sagt: Weiter so, und Du wirst ein Held! Dann bekommst Du die "
        "Belohnung!")); }
      break;

    // *** Ist schon Held ***
    case 1:
        // "neuer_held" gerade erst passiert
        if (find_call_out("neuer_held") != -1) break;
        // Neue x-facher Heldenstufe erreicht
        else if( oldbling / HELDENPUNKTE < newbling / HELDENPUNKTE) {
          ENV(TP)->Message(break_string(
            "Herzliche Gratulation, "+TPN+"! Jetzt bist Du ein*e "+
            (newbling / HELDENPUNKTE) +"-fache*r HELD*IN!",
            78,"Ahtawqa sagt euphorisch: "));
          TP->Message(break_string(
            "Hoer gut zu, "+TPN+", das verrate ich Dir nur ein Mal! Diese furchtbare "
            "Waffe des Meisters des Pfades, die manche von euch so gerne haben, die "
            "kannst Du wieder bekommen, solltest Du sie einmal verlieren. Es funktioniert "
            "aehnlich wie magische Gegenstaende, der Zufall spielt mit, und Du musst "
            "Waffen vom Meister identifizieren. Aber, das hat "
            "mir der maechtige Wraz verraten, die Waffe wird dann anders sein, wenn Du "
            "sie nochmal bekommst. Wraz hat irgendwas von 'fix' und 'unverbesserbar' "
            "geschwafelt. Achja, und er meinte, dass der Hackstock wichtig sei, und "
            "dass der Zufall eher mit Dir sein wird, "
            "wenn Du mir viele Blings bringst. Das gefaellt mir natuerlich! Also los, "
            "Du Held*in, geh und toete so viele wie Du kannst, und bring mir weiterhin "
            "die Beweise!",
            78,"Ahtawqa fluestert Dir zu: "
          ));
          ENV(TP)->Message(break_string("Ahtawqa fluestert "+TPN+" etwas zu."),MSGFLAG_NO_TP);
          // shout nur alle 10-fachen Heldenstufen
          if( !((newbling / HELDENPUNKTE) % 10) )
          {
            if (!TP->QueryProp(P_TESTPLAYER)) 
            shout(break_string(
              capitalize(TPU)+" ist schon ein*e "+(newbling / HELDENPUNKTE)+
              "-fache*r Schlachtfeld-HELD*IN!",
              78, "Ahtawqa ruft begeistert: "));
            clone_object(OBJ "schluckeroel")->move(TP,M_NOCHECK);
            ENV(TP)->Message(break_string(
              "Hier, als Belohnung bekommst Du eine Phiole von meinem "
              "weltberuehmten Muellschluckeroel! Du wirst es lieben!",
              78,"Ahtawqa sagt: "
              ));
          }
          TP->SetProp("sf_heldenzeit",time());
        }
        
        // Ansonsten (Spieler ist Held, erreicht aber keine neue x-fach Heldenstufe)
        else if( !random(10))
        TP->Message(break_string(
          "Du bist bereits ein Held! Durch Deinen "
          "unermuedlichen Kampfgeist bist Du allen Kriegern hier im Kampf "
          "ueberlegen!\n"
          "Solltest du die Belohnung einmal verlieren, toete "
          "den Meisterschlaechter und bring mir den Beweis!",
          78,"Ahtawqa sagt stolz: ",BS_LEAVE_MY_LFS));
        else if( !random(50))
        TP->Message(BS(
          Name()+" fluestert Dir immer wieder ein paar Kampftricks zu. Du meinst, dass "
          "Dir das auf dem PFAD DES TODES helfen wird."));
        break;

    default:
      TP->Message(BS("Fehler"));
    break;
  }

}

void neuer_held(object player) // NEUER HELD --------------------------------
{
  int gender;
  string playeruid;

  playeruid = lower_case(getuid(player));

  if (player->QueryProp(P_GENDER)==2) gender = 0; // female
  else gender = 1;

  clone_object(ARMOUR "ring")->move(player,M_NOCHECK);

  player->Message(
    "Ahtawqa sagt begeistert: \n\n"
    "WAHNSINN! Du hast so viele Krieger hier getoetet... UNGLAUBLICH!\n"
    "\n"+
    (gender?
      "Du bist ein echter HELD!\n":
      "Du bist eine echte HELDIN!\n"
    )+
    "\n"
    "Ahtawqa gibt Dir die Belohnung!\n");

  if(!player->QueryProp(P_TESTPLAYER))
  shout(BS(
    "Ahtawqa ruft begeistert: "+capitalize(getuid(player))+" ist ab jetzt "
    "ein"+(gender ?
      " richtiger Schlachtfeldheld!" :
      "e richtige Schlachtfeldheldin!") ));

  // Eintrag in helden.lib (fuer AddLibrard())
  write_file(NPC "helden.lib",
  "info:3:" + playeruid + "\n" +
  capitalize(playeruid) + " ist " + (gender ?
  "ein maechtiger Krieger, der von mir ob seiner Taten auf dem Schlachtfeld "
  "zum Helden ernannt wurde!" :
  "eine maechtige Kriegerin, die von mir ob ihrer Taten auf dem Schlachtfeld "
  "zur Heldin ernannt wurde!") +
  "\n\n" );

  // Update der Library im Master (siehe "AddLib"-Manual)
  "/p/daemon/infolibd"->DiscardLib(NPC "helden.lib");

  return;
}

void tragen() // TRAGEN -----------------------------------------------------
{
  command_me("ziehe alles aus");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe"); // geht nicht, gott weiss wieso...
  command_me("trage alles");
  return;
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: An Deiner Stelle haette ich auch Angst!",
        "sagt: An Deiner Stelle haette ich auch Angst!",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Hoer auf!",
        "sagt zu"+TPN+": Hoer auf!",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Lass das!",
        "sagt "+TPN+": Lass das!",
        0);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Toete lieber Krieger!",
        "sagt zu"+TPN+": Toete lieber Krieger!",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "kratzt sich am Kopf.",
        "kratzt sich am Kopf.",
        0);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.",
        0);
      break;

    default: return; break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS("Ahtawqa "+macher));
  tell_room(ENV(TO), BS("Ahtawqa "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void die(int poisondeath)
{
  WMASTER->npc_death_log("ahtawqa", TO->Name(RAW), TPU, TPN);

  // "last_ahtawqa_deathtime" -> reloads only every 24h
  call_other(ROOM "m09","SetProp","last_ahtawqa_deathtime",time());

  clone_object(OBJ "schluckersalbe")->move(TO,M_GET);
  clone_object(OBJ "schluckeroel")->move(TO,M_GET);

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);
}

void reset()
{
  object *inv;
  int i;
  i=0;

  ::reset();

  if(QueryProp("last_defend_call") < time() - 600) // Letzter Defend() ist laenger als 10 Minuten her
    SetProp(P_NOATTACK, "laeuft blitzschnell hinter Dich. Huch!\n");

  inv=deep_inventory(TO);

  for(i=0;i<sizeof(inv);i++)
  {
    if( !inv[i]->QueryProp(P_WORN) && !inv[i]->QueryProp(P_WIELDED) )
    {
      inv[i]->move( environment(TO) , M_NOCHECK );
      tell_room( environment(TO), BS("Ahtawqa wirft " + inv[i]->name(WEN) +
                                     " weg.") );
    }
  }

  // Liste in w02 updaten (taeglich):
  if( time() > last_heldenliste_update + 86400)
  {
    last_heldenliste_update = time();
    call_other(ROOM "w02", "???");
    TO->move(ROOM "w02",M_NOCHECK);
    tell_room(ENV(TO), BS("Ahtawqa stuermt aufgeregt zur Tafel und kritzelt "
                          "wild darauf herum."));
    ROOM "w02"->write_heldenliste(get_allheldenlist());
  }

}
