// Shegraz, Haendlerin
// Schlachtfeld
// von Wraz / Mendralim

#include "../def.h"
#include "schlachtfeld.h"

//#define RANDOM_BONUS_DEFEND WMASTER->query_random_bonus_defend()

inherit "/std/npc/spells";
inherit "/d/huegelland/feyaria/orks/npc/std_ork";
inherit NPC "npc.lpc";

string *heroes;
int last_lust;
string lust();

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  last_lust = time() - 1800;
  heroes=explode( read_file(ZONE "list/heroes")+"\nwraz" , "\n" );

  SetProp(P_SHORT, "Shegraz die Haendlerin");
  SetProp(P_LONG,
    "Shegraz ist eine riesige Orkfrau. Sie blickt Dich ein wenig argwoehnisch, "
    "aber auch ein wenig freundlich an. Ihre Muskeln sind beeindruckend, aber "
    "Du bist Dir nicht ganz sicher, ob das bei orkischen Frauen normal ist. "
    "Jedenfalls ist sie, selbst fuer einen Ork, wirklich gross." );

  SetProp(P_NAME, "Shegraz");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"shegraz","Ork", "Axtexperte", "NOWIMPY", "Krieger", "\nschlachtfeld"}));
  set_living_name("\nschlachtfeld_minions_by_wraz");
  SetProp(P_ARTICLE, 0);

  create_default_npc(39);

  SetProp(P_HANDS, ({" mit ihren orkischen Faeusten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON}) }));

  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 225);
  SetProp(P_WEIGHT, 78000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt das nicht!!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_metzelorgie");

  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS)+
               ([DT_RIP: -0.3]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "stampft davon");

  SetProp(P_DIE_MSG,  " schreit auf und faellt dann tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "grunzt Dich nur an.\n");

  AddInfo( ({"ork"}),
    "Ich bin ein ORKIN!",
    "grunzt: ");

  AddInfo( ({"orkin"}),
    "Ja, was dachtest Du? Dass Orkkinder wie Zwergenkinder aus Loechern "
    "schluepfen?",
    "grunzt veraergert: ");

  AddInfo( ({"zwergenkinder"}),
    "Das weiss doch jedes Kind, dass Zwerge aus Loechern schluepfen, weil es "
    "nur maennliche Zwerge gibt.",
    "sagt ueberzeugt: ");

  AddInfo( ({"kinder"}),
    "Ich habe schon viele Kinder gezeugt! Das hat Spass gemacht.",
    "sagt grinsend: ");

  AddInfo( ({"spass"}),
    "Hast Du auch Lust auf etwas Spass?",
    "fragt mit vielsagendem Blick: ");

  AddInfo( ({"lust"}),
    #'lust, //'
    "");

  AddInfo( ({"shegraz"}),
    "Ja, das ist mein Name. Gefaellt er Dir?",
    "grunzt: ");

  AddInfo( ({"shagraz"}),
    "Ein Orkname. In Tijara heisst ein Waffenhaendler Shagraz.",
    "sagt gereizt: ");

  AddInfo( ({"tijara","waffenhaendler"}),
    "In Tijara heisst ein Waffenhaendler Shagraz.",
    "sagt gereizt: ");

  AddInfo( ({"hilfe"}),
    "Ich kann Dir etwas verkaufen, oder abkaufen.",
    "sagt: ");

  AddInfo( ({"schlachtfeld"}),
    "Ein wilder Ort. Nachdem hier viele Waffen und Ruestungen anfallen, komme "
    "ich gelegentlich vorbei und kaufe den erfahrenen Schlachtfeldkriegern ihre "
    "Beute ab, soweit ich dafuer Verwendung habe.",
    "sagt: ");

  AddInfo( ({"beute","verwendung","waffen","ruestungen"}),
    "Ich kann nicht immer alles gebrauchen. Manchmal ist der Markt besser "
    "fuer Ruestungen, manchmal besser fuer Waffen.",
    "sagt: ");

  AddInfo( ({"ahtawqa","hobbit"}),
    "Den Hobbit sehe ich hier oefter. Er laesst sich Beweise fuer das "
    "Toeten der Krieger auf dem Schlachtfeld bringen. Frage ihn einfach direkt.",
    "sagt: ");

  AddInfo( ({"beweis","beweise"}),
    "Er hat mir einmal verraten, wie viel ihm welcher Beweis wert ist. Ich kann "
    "Dir sagen, welcher von zwei Beweisen ihm mehr wert ist ('vergleiche x mit y'). "
    "Aber gratis ist das nicht!",
    "sagt: ");

  SetProp(P_SPELLRATE,45);

  AddSpell(1,550,
    "Das Blut spritzt, als Shegraz' Waffe in Dich eindringt!\n",
    "Das Blut spritzt, als Shegraz' Waffe in @WEN eindringt!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,650,
    "Shegraz beisst Dir in die Schulter!\n",
    "Shegraz beisst @WEM in die Schulter!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1,
  ({Name(WER, 1)+" fragt: Was kann ich Dir anbieten?\n"
   ,Name(WER, 1)+" blickt Dich fuer eine Orkin relativ freundlich an.\n"
   }));

  SetAttackChats(10,
  ({Name(WER, 1)+" bruellt Dich wild an!!\n",
   Name(WER, 1)+" grunzt.\n",
   Name(WER, 1)+" schreit wild im Kampf!\n"
   }));

  SUID;

  equip(0,1);
  CLONEME(WEAPON "zackenschwert");
  command("zuecke schwert");

  switch (random(10))
  {
    case 0:
      CLONEME("/d/dschungel/feyaria/tijara/armour/rueckengehaenge_schild");
      break;
    case 1:
      CLONEME("/d/dschungel/feyaria/tijara/armour/rueckengehaenge_plus");
      break;
    default:
      CLONEME("/d/dschungel/feyaria/tijara/armour/rueckengehaenge");
  }
  command("trage gehaenge");  

  AddCmd( "vergleiche|vergleich",
          "cmd_vergleichen" );

  SetProp("no_score", 0);
}

int cmd_vergleichen(string str)
{
  string obj1_name, obj2_name;
  object obj1, obj2;
  int money, obj1_value, obj2_value;

  money=TP->QueryMoney();

  if (money < 1000)
  {
    TP->Message(BS("Shegraz sagt veraergert: 1000 Muenzen "
                        "verlange ich, und keine einzige weniger!"));
    ENV(TP)->Message(BS("Shegraz sagt veraergert zu "+TPN+": 1000 Muenzen "
                        "verlange ich, und keine einzige weniger!"),
                        MSGFLAG_NO_TP);
    return 1;
  }

  if(!str || str == "") return 0;
  if(sscanf(str, "%s mit %s", obj1_name, obj2_name) != 2) return 0;

  if(!obj1 = present(obj1_name,TP))
  {
    TP->Message(BS("Shegraz sagt: Du hast doch gar kein "+obj1_name+"!"));
    return 1;
  }
  if(!obj2 = present(obj2_name,TP))
  {
    TP->Message(BS("Shegraz sagt: Du hast doch gar kein "+obj2_name+"!"));
    return 1;
  }

  if(obj1 == obj2)
  {
    TP->Message(BS("Shegraz kratzt sich am Kopf: Du willst ein Ding mit "
    "sich selbst vergleichen?"));
    return 1;
  }

  TP->Message(BS("Du zeigst Shegraz "+obj1->name()+" und "+obj2->name()+" und "
  "bezahlst grummelnd 1000 Muenzen."));
  ENV(TP)->Message(BS(TPN+" zeigt Shegraz "+obj1->name()+" und "
  +obj2->name()+" und bezahlt grummelnd 1000 Muenzen."),MSGFLAG_NO_TP);
  TP->AddMoney(-1000);

  obj1_value = obj1->query_collector_value();
  obj2_value = obj2->query_collector_value();

  if(!(obj1_value) && !(obj2_value))
  {
    ENV(TP)->Message(BS("Shegraz sagt: Das ist beides wertlos fuer den Hobbit."));
    return 1;
  }

  if(!obj1_value)
    ENV(TP)->Message(BS("Shegraz sagt: "+obj1->Name()+
    " ist fuer den Hobbit wertlos."));
  if(!obj2_value)
    ENV(TP)->Message(BS("Shegraz sagt: "+obj2->Name()+
    " ist fuer den Hobbit wertlos."));

  switch (obj1_value - obj2_value + 1000)
  {
    case 1 .. 990: ENV(TP)->Message(BS("Shegraz sagt: "+obj1->Name()+
    " ist dem Hobbit viel weniger "
    "wert als "+obj2->name()+ "."));
    break;

    case 991 .. 999: ENV(TP)->Message(BS("Shegraz sagt: "+obj1->Name()+
    " ist dem Hobbit weniger wert "
    "als "+obj2->name()+ "."));
    break;

    case 1000: ENV(TP)->Message(BS("Shegraz sagt: "+obj1->Name()+" und "+obj2->name()+
    " sind in den Augen des Hobbits gleichwertig."));
    break;

    case 1001 .. 1009: ENV(TP)->Message(BS("Shegraz sagt: "+obj1->Name()+
    " ist dem Hobbit mehr wert "
    "als "+obj2->name()+ "."));
    break;

    case 1010 .. 2000: ENV(TP)->Message(BS("Shegraz sagt: "+obj1->Name()+
    " ist dem Hobbit viel mehr "
    "wert als "+obj2->name()+ "."));
    break;

    default: ENV(TP)->Message(BS("Shegraz sagt: Diese Beweise haben einen massiven "
    "Wertunterschied in den Augen des Hobbits!"));
    break;
  }

  return 1;
}

string lust()
{
  if(last_lust > time()-1800) return "sagt: Vielleicht spaeter, ich bin noch ganz "
                                     "kratzig vom letzten Mal.";
  TP->Message(BS("Shegraz blickt Dich luestern an. Ploetzlich verengen sich ihre "
              "Lider und sie springt Dich an! Du wirst von der Wucht umgeworfen "
              "und schlaegst Dir den Kopf am Holztisch, es wird dunkel...\n"
              "als Du wieder erwachst schmerzt Dein Intimbereich."), MSGFLAG_SENSE);
  TP->AddHp(-random(30));
  ENV(TP)->Message(BS("Nachdem Shegraz und "+TP->Name()+" offensichtlich geflirtet "
                   "haben springt Shegraz "+TP->Name()+" ploetzlich an. "
                   +capitalize(TP->QueryPronoun())+" schlaegt sich im Fallen den "
                   "Kopf und wird kurz "
                   "bewusstlos. Shegraz tritt "+TP->QueryPronoun(WEM)+" daraufhin "
                   "mehrmals kraeftig in die Weichteile. Als "+TP->QueryPronoun()+
                   " wieder erwacht, blickt Shegraz "+TP->QueryPronoun(WEM)+
                   " verfuehrerisch zu. "+TP->Name()+" grinst. Vermutlich denkt "
                   +TP->QueryPronoun()+", dass " +TP->QueryPossPronoun(WEM)+
                   " Weichteile wegen etwas ganz anderem schmerzen... Du brichst "
                   "vor Lachen zusammen."),
                   MSGFLAG_VISUAL + MSGFLAG_NO_TP);
  last_lust = time();
  return "wirft Dir kurz einen vielsagenden Blick zu.";
}

void die(int poisondeath)
{
  object ob;

  WMASTER->npc_death_log("standardnpc", TO->Name(RAW), TPU, TPN);

  npc::jadering_xp(TP, QueryProp(P_LEVEL));
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) WMASTER->npc_kill_log(TO->Name(RAW), getuid(player), lostexp);
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "lacht "+capitalize(getuid(TP))+" aus.",
        0);
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "stoesst Dich heftig.",
        "stoesst "+capitalize(getuid(TP))+" heftig.",
        0);
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "beachtet Dich kaum.",
        "beachtet "+capitalize(getuid(TP))+" kaum.",
        0);
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "stuerzt sich auf Dich!",
        "stuerzt sich auf "+capitalize(getuid(TP))+"!",
        1);
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "spuckt Dich an und attackiert Dich!",
        "attackiert "+capitalize(getuid(TP))+"!",
        1);
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "ignoriert "+capitalize(getuid(TP))+".",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dir verschmitzt zu!",
        "blickt "+capitalize(getuid(TP))+" verschmitzt an.",
        0);
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "kichert. Verstoerend, eine kichernde Orkin.",
        "kichert. Verstoerend, eine kichernde Orkin.",
        0);
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "ignoriert "+capitalize(getuid(TP))+".",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich!",
        "lacht ueber "+capitalize(getuid(TP))+"!",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if ( member(heroes,lower_case( getuid(enemy) )) != -1 )
    return ::Defend(dam+random(RANDOM_BONUS_DEFEND), dtypelist, spell, enemy);

  else return ::Defend(dam, dtypelist, spell, enemy);
}

int query_random_bonus_defend()
{
  return RANDOM_BONUS_DEFEND;
}
