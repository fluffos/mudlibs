// Jadering
//
// von Wraz / Mendralim

#include "../def.h"

inherit "std/armour";

object me=TO;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Der Jadering");
  SetProp(P_LONG,
    "Der Ring schimmert facettenartig in einem magischen Jadegruen. "
    "Du hast ihn geschenkt bekommen fuer Deine heldenhaften kriegerischen "
    "Taten auf dem blutruenstigen Schlachtfeld! Bewahre ihn gut auf!");

  SetProp(P_NAME, "Jadering");
  SetProp(P_GENDER, MALE);
  AddId( ({"jadering", "ring", "Jadering", "NODESTRUCT"}) );

  SetProp(P_MATERIAL, ([MAT_JADE:99,MAT_MISC_MAGIC:1]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 3);
  SetProp(P_VALUE, 25000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, "Der Jadering ist unverkaeuflich!\n");
  SetProp(P_NODROP, "Du NARR! NEIN!\n");

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_INFO, BS("Der Jadering kann den Tod austricksen!") );
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(!me->QueryProp(P_WORN)) return; // nicht getragen -> hilft nix
  if(player!=me->QueryProp(P_WORN)) return; // traeger nicht gestorbener
  if(!WMASTER->is_hero(player)) return; // kein hero, also ring irgendwie
                                        // anders bekommen
  if(random(5)&&player->Name()!="Caric") return; // Ring hilft nicht immer
  
  player->Message(
    "Du spuerst etwas an Deinem Finger - der Jadering wird aktiv!\n"
    "Du lachst den Tod aus! Er kann Dir keine Erfahrung stehlen!\n");
  player->AddExp(lostexp);
  
  write_file(LOG "ring_xp",
    dtime()+" "+player->Name()+": "+lostexp+"\n");
}
