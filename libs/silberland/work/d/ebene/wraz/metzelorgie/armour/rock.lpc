// Ein Rock aus festem Stoff
// Vorlage: /p/armour/trousers/rock.c
// Diesen Rock duerfen auch Maenner tragen :)
// Wraz / Mendralim

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Rock");
  SetProp(P_LONG,
    "Ein langer Rock aus fest gewobener Baumwolle, mit einfachen, geometrischen "
    "Mustern bestickt.");
  SetProp(P_NAME, "Rock" );
  SetProp(P_GENDER, MALE);
  AddId( ({"rock"}) );
  SetProp(P_INFO, "Natuerlich tragen nicht nur Frauen so einen Rock!\n");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]) );
  SetProp(P_WEIGHT, 650);
  SetProp(P_VALUE, 220);
  
  AddDetail( ({"muster"}),
    "Der Rock ist mit dezenten, geometrischen Mustern bestickt, die nichts "
    "Konkretes darstellen.");
  AddDetail( ({"konkretes"}),
    "Du kannst nichts Konkretes erkennen.");
  AddDetail( ({"baumwolle"}),
    "Der Rock besteht aus dicht gewobener Baumwolle. Dadurch schuetzt er "
    "etwas besser vor mechanischer Einwirkung, als ein normaler Rock. Er ist "
    "aber auch etwas schwerer.");
}

