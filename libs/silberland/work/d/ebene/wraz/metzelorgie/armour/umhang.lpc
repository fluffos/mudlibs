// Umhang
// Billig kopiert aus /p/armour/cloak/umhang und modifiziert
// von Wraz / Mendralim

//inherit "/p/armour/armour_inh";
inherit "std/armour";

#include <properties.h>
#include <combat.h>

int cvalue;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein grauer Umhang");
  SetProp(P_LONG, 
    "Es ist ein langer grauer Umhang aus einem feinen Material.");
  SetProp(P_NAME, "Umhang");
  SetProp(P_NAME_ADJ, "grau" );
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "bling"}) );
  AddAdjective( ({"grau", "grauer", "grauen"}) );
  
  SetProp(P_INFO, "Jemand bestimmter moechte diesen Umhang sicherlich "
  "haben!\n");
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK); 
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 90 );
}

int set_collector_value(int value)
{
  cvalue=value;
  return cvalue;
}

int query_collector_value()
{
  return cvalue;
}
