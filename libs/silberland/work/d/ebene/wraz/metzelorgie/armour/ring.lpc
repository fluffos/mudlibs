// Jadering
// Belohnung auf dem Schlachtfeld (von NPC Ahtawqa verliehen)
// von Wraz / Mendralim

#include "../def.h"

inherit "std/armour";

#include "/p/daemon/itemd/itemd.h"

int add_levels(int level);
int get_bonus();

int death_saves;
int max_death_saves=7+random(2);

int bonuslevels;
int bonusdeaths;
int bonusreset;
int bonusreset_time = 60*60*24*14; // Wie oft werden Bonuslevels reduziert? Def: alle 2 Wochen

int totallostxp=0;
int xpreturn=0;
int deathtime=0;
int playerxpbeforedeath=0;

int xpfac=60000000; // Fuer Testzwecke, sollte spaeter in ein #define
int xpfac2=26000; // Fuer Testzwecke, sollte spaeter in ein #define

int max_reset_xp_use = 100000; // XP Abzug Maximum im reset()

int lichtstatus=0; // -1 verdunkelnd, 0 aus, 1 leuchtend

//int haltbarkeit=60*60*24*(90+random(30)); // Haltbarkeitsdauer (in s), 90-120 Tage // obsolet!

int max_total_speed_def = 700; // Maximum SA_SPEED das der Spieler haben soll
int max_newspeed = 600; // Maximum SA_SPEED vom Ring alleine

int death_odds = 1800; // 1:1800 Wahrscheinlichkeit zu sterben, in DefendFunc() // Update 28.1.24: 1800 (statt 2000)


string playerguild;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  death_saves=0;
  bonusdeaths=0;
  bonusreset=0;
  bonuslevels=0;

  SetProp(P_SHORT, "Der Jadering");

  SetProp(P_NAME, "Jadering");
  SetProp(P_GENDER, MALE);
  AddId( ({"jadering", "ring", "Jadering", "NODESTRUCT", "\nwrazjadering"}) );

  SetProp(P_KILL_NAME, "Die Gier des Jaderings");

  SetProp(P_MATERIAL, ([MAT_JADE:99,MAT_MISC_MAGIC:1]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 3);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_TMPMAGIC, ({3500, 3500}) ); // ca. 110 Tage
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);

  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Du fuehlst Dich an den Ring gebunden, so einfach willst Du \n"
                    "ihn nicht hergeben.\n");

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 0);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );

  SetProp("ringladungen", ({10,20,5}));

  AddCmd(({"jadering"}),"cmd_light");
  AddCmd(({"held*innentitel"}),"cmd_title");
}

// ------ _QUERY_LONG (P_LONG) ----------------------------------------------
string _query_long()
{
  string txt;

  if (lichtstatus <= -1) txt =
  "Der Ring schimmert facettenreich in dunklem Jadegruen. ";

  else if (lichtstatus >= 1) txt =
  "Der Ring leuchtet facettenreich in hellem Jadegruen. ";

  else txt = "Der Ring schimmert facettenreich in magischem Jadegruen. ";

  txt +=
  "Du hast ihn geschenkt bekommen fuer Deine heldenhaften kaempferischen "
  "Leistungen auf dem blutruenstigen Schlachtfeld.";

  return BS(txt);
}

// ------ _QUERY_INFO (P_INFO) ----------------------------------------------
string _query_info()
{
  string ring_hunger;
  int heldenstufe;

  switch (get_bonus())
  {
    case 0..5:
      ring_hunger = "Der Ring ist fuerchterlich hungrig!";
      break;
    case 6..10:
      ring_hunger = "Der Ring ist sehr hungrig!";
      break;
    case 11..15:
      ring_hunger = "Der Ring ist ziemlich hungrig!";
      break;
    case 16..20:
      ring_hunger = "Der Ring ist relativ hungrig!";
      break;
    case 21..25:
      ring_hunger = "Der Ring ist einigermassen hungrig!";
      break;
    case 26..29:
      ring_hunger = "Der Ring ist kaum hungrig!";
      break;
    case 30:
      ring_hunger = "Der Ring ist vollkommen satt!";
      break;
    default:
      ring_hunger = "Der Ring hat einen Fehler, bitte informiere einen Magier!";
      break;
  }

  if (random(3))
  {
   heldenstufe = SMASTER->query_bling(TPU) / HELDENPUNKTE;
   return (
    BS("Du fuehlst eine Verbindung dieses Rings mit Deiner Essenz, "
    "Deiner Erfahrung. Es kommt Dir vor, als habe der Ring eine Aura, die den "
    "TOD von Deiner Essenz abschirmen koennte - mit etwas Glueck. Vermutlich "
    "wuerde der Ring den Verlust der Erfahrung nicht verhindern. Aber wenn der "
    "TOD sie nicht bekommt, muesste sie vielleicht irgendwie wieder zu erlangen "
    "sein?")+
    BS("Die Verbindung des Rings mit deiner Erfahrung fuehlt sich wechselseitig an. "
    "Du vermutest, dass sie nicht ausschliesslich zu Deinem Vorteil besteht, "
    "denn von dem Ring geht ein Gefuehl aus, das Du als Hunger beschreiben wuerdest. "
    "Du fuehlst, dass sich der Hunger nicht nur auf Dich und Deine Erfahrung "
    "bezieht. Die Staerkung Deiner Faehigkeiten durch den Ring wird jedenfalls "
    "durch den Hunger des Rings gehemmt.")+
    BS("Der Ring kann das Umgebungslicht beeinflussen indem Du dem Ring direkt "
    "einen Teil Deiner Erfahrung zufliessen laesst.")+
    BS("Kommandos: jadering licht | dunkel | aus") +
    BS("Ausserdem kannst Du Dir Deinen Schlachtfeldtitel setzen: ")+
    BS("Kommando: held*innentitel farblos" +
      (heldenstufe >= 2 ? " | farbe" : "") +
      (heldenstufe >= 20 ? " | farbe wie stufe <heldenstufe>" : "") +
      (heldenstufe >= 1000 ? " | farbe_ohne_blinken" : "")
    ));
  }
  else return BS(ring_hunger);
}

// ------ GET_BONUS (Kombination von NPC-Level-Bonus und Todeszahl-Bonus) ---
int get_bonus()
{
  int bonus;

  // Bei bonusdeaths == 0 && bonuslevels ==      0 -> bonus =  5
  //                         bonuslevels ==   5000 -> bonus = 18
  //                                         14000 -> bonus = 25
  //                                         27000 -> bonus = 30 (cap)
  bonus = to_int( (bonusdeaths/2) - 47.8 + 7.6 * log( bonuslevels+1050.0 ) );

  // cap auf 30
  bonus = (bonus > 30) ? 30 : bonus;

  return bonus;
}

// ------ ACCELERATE (SA_SPEED Modifikation) ------------------------------
// TP zeigt auf den enemy (von DefendFunc)
int accelerate()
{
  object waffe, player;
  int waffenfaktor, ringbonus;
  int max_total_speed, oldspeed, newspeed, duration;
  int acceleration_odds;
  int pl_xp, xp_costs;
  int mod_sk_attr_result;

  if(QueryProp("last_ring_accelerate") > time()-6) return 0; // min 6 Sekunden Abstand

  player = ENV(TO);

  if(!player) return 0;
  if(!interactive(player)) return 0;

  oldspeed = player->QuerySkillAttribute(SA_SPEED);

  // Spieler hat SA_SPEED bereits erhoeht, dann seltener (1 von 3)
  if( (oldspeed > 100) && random(3)) return 0;

  // Beschraenkung, wenn der Spieler schon SA_SPEED hat
  max_total_speed = max_total_speed_def;
  if(oldspeed >= max_total_speed) return 0;

  // Haeufigere Aktivierung wenn Sterbewaffe gezueckt
  waffe = player->QueryProp(P_WEAPON);
  if(waffe && waffe->id("\nsterbewaffe")) waffenfaktor = 1;
  else waffenfaktor = 3;

  ringbonus = TO->get_bonus(); // 0 bis 30

  // Aktiviert, wenn Ringbonus auf Maximum (30) und Sterbewaffe:
  // bei 1 von 10 Angriffen
  //  Hier ist zwar 1 von 1 (weil random(1800/901) == random(1) == 0 immer!)
  //  aber accelerate() wird bereits mit !random(10) aufgerufen
  //
  // Beispiele, wie oft der SPEED Bonus kommt (bei 1/x Attacken)
  //
  // Ringbonus     mit Sterbewaffe    ohne Sterbewaffe
  //        30                1/10                1/59
  //        29                1/21                1/64
  //        25                1/28                1/86
  //        15                1/79               1/238
  //         5               1/629              1/2076
  acceleration_odds = (1800 * waffenfaktor) / (1+ringbonus*ringbonus);
  if(QueryProp("wdebug")) DB("accelerate() odds: 1:"+acceleration_odds+" ("+player->Name()+")\n");

  if(random(acceleration_odds)) return 0; // Wuerfeln

  // Speedbonus & Dauer wuerfeln und limitieren
  newspeed = oldspeed + 50 + random(1+8*ringbonus); // min: 50
  newspeed = newspeed <= max_newspeed ? newspeed : max_newspeed;      // max: 500
  duration = 4 + random(1+ringbonus/5) ; // min: 4, max: 10 Sekunden

  // Limit auf SA_SPEED in Summe
  // (es koennen mehrere Objekte SA_SPEED modifizieren, wird multipliziert!)
  if((oldspeed * newspeed) / 100 >= max_total_speed)
    newspeed = to_int(max_total_speed*100/oldspeed);
  if(newspeed <= 100) return 0; 

  mod_sk_attr_result = player->ModifySkillAttribute(TO,SA_SPEED,newspeed,duration);

  if(mod_sk_attr_result <= 0) return 0; // hatte keinen Effekt

  // Nachricht an Spieler
  // Geringe Wahrscheinlichkeit zu sterben
  switch (random(death_odds))
  {
    case 0:
    player->Message(BS("Als der Ring gierig Deine Erfahrung frisst, verlierst Du "
      "die Kontrolle ueber den Erfahrungsfluss und bezahlst mit Deinem Leben."));
    ENV(player)->Message(BS("Der Jadering an "+player->Name(WESSEN)+" Finger leuchtet "
      "grell auf, und "+player->Name()+" verdreht leblos die Augen."),
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    player->die();
    return 2;
    break;

    case 1..18: // 1/100 von death_odds
    player->Message(BS("Der Ring frisst Deine Erfahrung mit immenser Gier! Beinahe "
      "haettest Du die Kontrolle verloren."));
    break;

    case 19..909: // 1/2 + 1/200 von death_odds
      player->Message(BS("Der Ring frisst gierig Deine Erfahrung und belohnt Dich!"));
      break;

    default:
      player->Message(BS("Ring und Waffe harmonieren, Erfahrung ist wertlos!"));
      break;
  }

  // Erfahrungspunktekosten
  // zB bei 2 Milliarden XP: max 1.421.000 XP Abzug
  //    bei 500 Mio XP:      max   165.000
  //    bei 50 Millionen XP: max    11.600
  //    bei 10 Millionen:    max     1.200 (aber mit so wenig XP wird man
  //                                      den Jadering kaum haben koennen)
  pl_xp = player->QueryProp(P_XP);
  player->AddExp(xp_costs =
                  -to_int( 1000 + random(to_int(
                 (
                   (pl_xp+(pl_xp/to_float(xpfac2))*(pl_xp/to_float(xpfac2)))/xpfac
                 )
                 * newspeed * duration
               ))
               )
            );
  
  SetProp("last_ring_accelerate",time());
  
  if(QueryProp("wdebug"))
  {
    DB("accelerate(): newspeed "+newspeed+", duration "+duration+
    ", xp_costs "+xp_costs+"\n");
    DB("actual SA_SPEED for "+player->Name()+": "+player->QuerySkillAttribute(SA_SPEED)+"\n");
    DB("mod_sk_attr_result: "+mod_sk_attr_result+"\n");
  }
  return mod_sk_attr_result;
}

// ------ WEARFUNC() ------------------------------------------------------
int WearFunc(object me)
{
  // man kann nur einen Ring haben
  // sollte man irgendwie an einen 2. kommen, verschwindet dieser beim
  // Versuch, ihn zu tragen
  object *inv;
  int i, no_of_rings;

  inv=deep_inventory(TP);
  no_of_rings = 0;

  // Globalvariable playerguild setzen
  playerguild = ENV(TO)->QueryProp(P_GUILD);

  for(i=0;i<sizeof(inv);i++)
  {
    if( inv[i]->id("\nwrazjadering"))
    {
      if(no_of_rings == 0) no_of_rings = 1;
      else
      {
        TP->Message(BS(
          "Als du den Jadering anziehen moechtest, verschwindet er."));
        TO->remove(1);
        return 0;
      }
    }
  }
  return 1;
}

// ------ REMOVEFUNC() ------------------------------------------------------
int RemoveFunc(object me)
{
  if(lichtstatus < 0)
  {
    if(TP) TP->Message(BS("Der Jadering laesst das Umgebungslicht wieder fliessen."),
      MSGFLAG_SENSE);
    if(TP && ENV(TP)) ENV(TP)->Message(BS(TP->Name(WESSEN) +" Jadering laesst das Umgebungslicht wieder fliessen."),
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    set_light(1);
    lichtstatus = 0;
  }

  else if(lichtstatus > 0)
  {
    if(TP) TP->Message(BS("Das Leuchten des Jaderings erlischt."),
      MSGFLAG_SENSE);
    if(TP && ENV(TP)) ENV(TP)->Message(BS("Das Leuchten von "+ TP->Name(WESSEN) +" Jadering erlischt."),
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    set_light(-1);
    lichtstatus = 0;
  }

  return 1;
}

// ------ DEFENDFUNC() ------------------------------------------------------
int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  // Moeglichkeit von SA_SPEED Erhoehung
  if(!random(QueryProp("ringladungen")[0])) accelerate();

  // Kleiner Bonus auch beim Metzeln ausserhalb des Schlachtfeldes
  if(!random(QueryProp("ringladungen")[1]) && !enemy->id("\nschlachtfeld"))
    add_levels(enemy->QueryProp(P_LEVEL)/QueryProp("ringladungen")[2]);

  return 0;
}

