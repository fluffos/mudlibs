// ------ ADD_LEVELS (Bonuswert der NPC-Levels die getoetet wurden) ---------
int add_levels(int level)
{
  int old_bonus;
  int new_bonus;

  old_bonus = get_bonus();
  bonuslevels += level;
  new_bonus = get_bonus();

  if( old_bonus < new_bonus )
    write(BS("Der Jadering verbessert Deine Faehigkeiten nun staerker."));

  return bonuslevels;
}

// ------ ADD_DEATHS (Bonuswert durch Spielertode) -------------------------
int add_deaths(int deaths)
{
  int change;

  change = get_bonus();
  bonusdeaths += deaths;
  change = get_bonus()-change;

  if(change)
    write(BS("Der Jadering verbessert Deine Faehigkeiten nun staerker."));

  return bonusdeaths;
}

// ----- GET_DEATHS_LEVELS (Abfrage der Todeszahl und NPC-Level) ------------
int *get_deaths_levels()
{
  return ({bonusdeaths, bonuslevels});
}

// ------ SET_BONUSRESET (Zeit der letzten Halbierung) ---------------------
int set_bonusreset(int newresettime)
{
  if(!newresettime) return bonusreset;

  else return bonusreset = newresettime;
}

// ------ NOTIFYPLAYERDEATH() ----------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  int old_bonus;
  int new_bonus;

  if(!TO->QueryProp(P_WORN)) return; // nicht getragen -> hilft nix
  if(player!=TO->QueryProp(P_WORN)) return; // traeger nicht gestorbener
  if(!WMASTER->is_hero(getuid(player))) return; // kein hero, also ring irgendwie
                                                // anders bekommen
  if(totallostxp) return; // Mehrfachtod; stacked nicht

  // bonusdeaths verbessert die Gildenfertigkeiten
  old_bonus = get_bonus();
  bonusdeaths++;
  new_bonus = get_bonus();

  if( old_bonus < new_bonus )
    write(BS("Der Jadering verbessert Deine Faehigkeiten nun staerker."));

  if(random(2)) return; // Aktiviert bei 1 von 2 Toden

  if(death_saves >= max_death_saves)
  {
    player->Message(BS(
      "Lars schmunzelt und nimmt Dir den Jadering ab."),
    MSGFLAG_SENSE);
    TO->remove(1);
    return;
  }

  //player->Message(BS("debug deathtime: " + deathtime + "\n"),MSGFLAG_SENSE);

  // letzter tod (mit jadering-aktivitaet) vor weniger als 2h
  if( deathtime > time() - 7200 ) return;

  totallostxp = lostexp;
  xpreturn = lostexp / 10;
  deathtime = time();
  playerxpbeforedeath = player->QueryProp(P_XP) + lostexp;

  player->Message(BS(
      "Im Moment deines TODES fuehlst Du den Jadering an Deinem Finger "
      "mit wohliger Waerme. Gleichzeitig schiessen Dir verwirrende Bilder "
      "durch den Kopf. Ein Teil Deiner Essenz, die sich der Tod schon "
      "genommen hatte, wird diesem wieder entrissen und fliegt ueber das "
      "Silberland. Doch dann strudeln die Essenzfetzen an einen Ort zusammen. "
      "Du erkennst ihn nicht genau, aber er kommt Dir bekannt vor, wirkt "
      "duester und... es riecht nach Blut. Du fuehlst, wie sich Deine "
      "Essenzbruchstuecke in Kreaturen, die Du nicht genau erkennst, verankern. "
      "Ob es wohl moeglich ist, Dir Deine Essenzen wieder zu holen?"),
     MSGFLAG_SENSE);

  death_saves += 1;
}

// ------ QUERY_DEATHTIME ---------------------------------------------------
int query_deathtime()
{
  return deathtime;
}

// ------ GIVEPLAYERXP ------------------------------------------------------
// Wird vom getoeteten NPC via WMASTER aufgerufen:
void GivePlayerXP (object player)
{
  if(totallostxp <= 0) return; // gibt keine XP, oder schon alle zurueckgegeben
  if(!TO->QueryProp(P_WORN)) return; // ring muss getragen werden
  if(player!=TO->QueryProp(P_WORN)) return;
  if( deathtime < time() - 7200 ) // Tod laenger als 2h her
  {
    totallostxp = 0;
    deathtime = 0;
    playerxpbeforedeath = 0;
    player->Message(BS("Die Waerme weicht wieder aus dem Jadering. Teile deiner Essenz "
             "sind wohl fuer immer verloren."), MSGFLAG_SENSE);
    return;
  }
  player->Message(BS("Du spuerst etwas an Deinem Finger - der Jadering wird aktiv! "
           "Du findest einen Teil Deines gestorbenen Selbst wieder."),
         MSGFLAG_SENSE);
  player->AddExp(xpreturn); // XP zurueckgeben
  totallostxp -= xpreturn; // totallostxp reduzieren

  // letzte XP-Rueckgabe, Nachricht an Spieler
  if( (totallostxp <= 0) || (player->QueryProp(P_XP) > playerxpbeforedeath) )
  {
    player->Message(BS("Nach diesem Fund fuehlst Du Deine Essenz wieder vollstaendig, "
             "fast so, als waerest Du nie gestorben."), MSGFLAG_SENSE);
    totallostxp = 0;
    deathtime = 0;
    playerxpbeforedeath = 0;
  }

  WMASTER->jadering_log(getuid(player),xpreturn);

  return;
}

// ------ _QUERY_AUTOLOADOBJ() ----------------------------------------------
mixed _query_autoloadobj()
{
  return ({death_saves, bonusdeaths});
}

// ------ _SET_AUTOLOADOBJ() ------------------------------------------------
_set_autoloadobj(mixed data)
{
  death_saves = data[0];
  bonusdeaths = data[1];
}

// ------ CMD_LIGHT ---------------------------------------------------------
// Licht oder Dunkelheit aktivieren, Kosten: bis zu 10.000 XP
int cmd_light(string str)
{
  if(str==""||!str) return 0;

  notify_fail("Kommandos: jadering licht | dunkel | aus\n");

  if(TP != TO->QueryProp(P_WORN)) {
    write(BS(
      "Du kannst die magische Helligkeit oder Dunkelheit des Jaderings "
      "nur nutzen, wenn Du ihn traegst."));
    return -1; }

  else if(str=="licht")
  {
    if(TO->QueryProp("last_aktivierungszeit") > time()-4)
    {
      write(BS("Du brauchst noch etwas Zeit, bevor Du dich wieder auf Deine "
        "innere Energie und den Jadering fokussieren kannst."));
      return -1;
    }
    if(lichtstatus >= 1)
    {
      write(BS("Der Jadering leuchtet bereits."));
      return -1;
    }
    else if(lichtstatus <= -1)
    {
      write(BS("Der Jadering absorbiert derzeit Licht. Deaktiviere ihn zuerst."));
      return -1;
    }
    write(BS(
      "Du fokussierst Deine innere Energie auf die Helligkeit des Todes. Ein "
      "Teil Deiner Erfahrung fliesst in den Ring. "
      "Der Jadering beginnt in hellem Jadegruen zu leuchten."));
    ENV(TP)->Message(BS(TP->Name(WESSEN) +" Jadering beginnt in hellem Jadegruen zu leuchten."),
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    set_light(1);
    lichtstatus = 1;
    TO->SetProp("last_aktivierungszeit", time());

    // Aktivierungskosten bis zu 10.000 XP
    TP->AddExp( (TP->QueryProp(P_XP) / 10000) > 10000 ?
                     -(10000+random(1000)) :
                     -((TP->QueryProp(P_XP) / 10000)+random(1000)) );
    return 1;
  }

  else if(str=="dunkel")
  {
    if(TO->QueryProp("last_aktivierungszeit") > time()-4)
    {
      write(BS("Du brauchst noch etwas Zeit, bevor Du dich wieder auf Deine "
        "innere Energie und den Jadering fokussieren kannst."));
      return -1;
    }
    if(lichtstatus <= -1)
    {
      write(BS("Der Jadering absorbiert bereits Licht."));
      return -1;
    }
    else if(lichtstatus >= 1)
    {
      write(BS("Der Jadering leuchtet derzeit. Deaktiviere ihn zuerst."));
      return -1;
    }
    write(BS(
      "Du fokussierst Deine innere Energie auf die Dunkelheit des Todes. Ein "
      "Teil Deiner Erfahrung fliesst in den Ring. "
      "Der Jadering schimmert in dunklem Jadegruen und absorbiert das "
      "Umgebungslicht."));
    ENV(TP)->Message(BS(TP->Name(WESSEN) +" Jadering schimmert in dunklem Jadegruen und absorbiert das "
      "Umgebungslicht."),
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    set_light(-1);
    lichtstatus = -1;
    TO->SetProp("last_aktivierungszeit", time());

    // Aktivierungskosten bis zu 10.000 XP
    TP->AddExp( (TP->QueryProp(P_XP) / 10000) > 10000 ?
                     -(10000+random(1000)) :
                     -((TP->QueryProp(P_XP) / 10000)+random(1000)) );
    return 1;
  }

  else if(str=="aus")
  {
    if(lichtstatus == 0)
    {
      write(BS("Der Jadering ist bereits deaktiviert."));
      return -1;
    }
    write(BS(
      "Du fokussierst Deine innere Energie auf den Tod. "
      "Der Jadering schimmert nun schwach in magischem Jadegruen."));
    ENV(TP)->Message(BS(TP->Name(WESSEN) +" Jadering schimmert nun schwach in magischem Jadegruen."),
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    if(lichtstatus >= 1) set_light(-1);
    else if(lichtstatus <= -1) set_light(1);
    lichtstatus = 0;
    return 1;
  }

}

// ------ CMD_TITLE ---------------------------------------------------------
// Farbtitel setzen, Kosten: bis zu 10.000 XP
int cmd_title(string str)
{
  int x_fach_held, gender, chosen_x_fach_held, true_x_fach_held;
  string old_title, new_title, *grammar;
  string textcol, bgcol, extracol, extrablink;

  textcol = "";
  bgcol = "";
  extracol = "";
  extrablink = "";

  if(!TP) return 0;

  x_fach_held = SMASTER->query_bling(TPU) / HELDENPUNKTE;
  true_x_fach_held = x_fach_held; // fuer die Ausgabe
  notify_fail("Kommando: held*innentitel farblos"+
    (x_fach_held >= 2 ? " | farbe" : "") +
    (x_fach_held >= 20 ? " | farbe wie stufe <heldenstufe>" : "") +
    (true_x_fach_held >= 1000 ? " | farbe_ohne_blinken" : "")+
    "\n");

  if(str==""||!str) return 0;

  if(TP != TO->QueryProp(P_WORN)) {
    write(BS(
      "Du musst den Jadering tragen."));
    return -1; }
  
  if(x_fach_held <= 0) {
    write(BS("Du bist doch noch gar kein*e Held*in! (Wie bist Du ueberhaupt "
      "an den Ring gekommen? Jemand sollte das Wraz melden...)"));
    return -1;
  }

  // Ab Heldenstufe 20: Farbe von niedrigeren Heldenstufen frei waehlbar
  if((x_fach_held >= 20) && sscanf(str, "%s wie stufe %d", str, chosen_x_fach_held) == 2)
  {
    if(str != "farbe") return 0;
    if(chosen_x_fach_held < 1)
    {
      write(BS("Die Held*innenstufe muss mindestens 1 sein."));
      return -1;
    }
    else if(chosen_x_fach_held > x_fach_held)
    {
      write(BS("Die gewaehlte Held*innenstufe fuer Deinen Titel kann natuerlich nicht "
        "hoeher sein als Deine aktuelle Held*innenstufe."));
      return -1;
    }
    else x_fach_held = chosen_x_fach_held; // fuer die Ausgabe
  }

  if(str!="farbe" && str!="farblos" && str!="farbe_ohne_blinken") return 0;

  if(str=="farbe" && true_x_fach_held == 1)
  {
    write(BS("Einen farbigen Titel kannst Du erst ab Held*innenstufe 2 setzen."));
    return -1;
  }

  // Grammatik (Geschlecht)
  switch(TP->QueryProp(P_GENDER))
  {
    case 1: grammar = ({"er",""}); break;
    case 2: grammar = ({"e","in"}); break;
    default: grammar = ({"e*r","*in"}); break;
  }

  // Titel Text erzeugen
  new_title = (true_x_fach_held > 1 ? 
    (true_x_fach_held + "-fach" + grammar[0] + " ") : 
    "") + 
    "SF-Held" + grammar[1];
  
  // Farbe ermitteln
  if(str=="farbe" || str=="farbe_ohne_blinken") 
  {  
    switch(x_fach_held/2%7)
    {
      case 0: if(x_fach_held > 1) textcol = "red"; break; // das ist die "hoechste" textfarbe!
      case 1: textcol = "bold"; break; // das ist die "niedrigste"
      case 2: textcol = "green"; break; // zweit-niedrigste ...
      case 3: textcol = "blue"; break;
      case 4: textcol = "cyan"; break;
      case 5: textcol = "purple"; break;
      case 6: textcol = "yellow"; break; // vorletzte
      default: textcol = ""; break;
    }
    if(x_fach_held > 15) switch((x_fach_held-2)/14%7)
    {
      case 0: bgcol = "bred"; break; // das ist die "hoechste" hintergrundfarbe!
      case 1: bgcol = "bwhite"; break; // das ist die "niedrigste" hintergrundfarbe
      case 2: bgcol = "bgreen"; break; // zweit-niedrigste ...
      case 3: bgcol = "bblue"; break;
      case 4: bgcol = "bcyan"; break;
      case 5: bgcol = "bpurple"; break;
      case 6: bgcol = "byellow"; break;
      default: bgcol = ""; break;
    }

    if(textcol != "" && strstr(bgcol,textcol)!=-1) textcol = "black"; // damit schrift- und hintergrund nicht gleich sind
    if(textcol == "bold" && bgcol=="bwhite") textcol = "black"; // bold entspricht white (dann waere weiss auf weiss)
    
    // Ab Stufe 112 wuerden sich die Farben wiederholen, daher:
    if(x_fach_held >= 112) // 112 = 14*8 --> weil oben "/14%7" (8 weil "kein Hintergrund" auch dazu zaehlt)
    {
      // "black" auf "bred" (ergibt sich aus dem switch oben)
      textcol = "black"; // weil rot auf rot nicht funktioniert
      bgcol = "bred";
    }
    // Ab 200 zusaetzlich "bold"
    if(x_fach_held >= 200) extracol = "bold";
    // Ab 1000 zusaetzlich "blink"
    if(x_fach_held >= 1000) extrablink = "blink";

    new_title = getcolor(textcol) + getcolor(bgcol) + getcolor(extracol) + 
      (str=="farbe"?getcolor(extrablink):"") + new_title;
    new_title = "\b, " + new_title + getcolor("none");

  }

  if(str=="farblos") new_title = "\b, " + new_title;

  old_title = TP->QueryProp(P_TITLE);
  TP->SetProp(P_TITLE, new_title);

  if(old_title && old_title != "") write(BS("Alter Titel: " + old_title));
  write(BS("Neuer Titel: " + new_title));
  return 1;
}

// ------ RESET() ----------------------------------------------
void reset()
{
  object player;

  int old_bonus;
  int new_bonus;
  int pxp_t; // Player-XP Tausendstel

  ::reset();

  player = environment(TO);
  if (!player) return;
  if (!interactive(player)) return;

  // in MASTER weapon_master.c
  WPMASTER->update_rings(TO);

  // Ende des XP-Verlust-Wiederfindens (Zeitfenster Ende)
  if (deathtime && deathtime < time() - 7200)
  {
    totallostxp = 0;
    deathtime = 0;
    playerxpbeforedeath = 0;
    player->Message(BS("Die Waerme weicht wieder aus dem Jadering. "
    "Teile deiner Essenz sind wohl fuer immer verloren."), MSGFLAG_SENSE);
  }

  pxp_t = (player->QueryProp(P_XP) / 1000);

  // Ringnutzung kostet XP: 0.1% der Player XP, oder maximal 100.000 (im Schnitt)
  if( player == TO->QueryProp(P_WORN) ) // wenn getragen
  {
    player->AddExp( pxp_t > max_reset_xp_use ?
                     -(max_reset_xp_use+random(max_reset_xp_use/5)) : // im Schnitt: 110.000 XP
                     -(pxp_t-(pxp_t/10)+random(pxp_t/5)) );
    player->Message(BS("Der Jadering labt sich an Deiner Erfahrung."
      ), MSGFLAG_SENSE);
  }

  // bonusdeaths und bonuslevels werden 1x pro 2 Wochen reduziert
  if(!bonusreset) bonusreset = time();
  if( (bonusreset < time() - bonusreset_time) )
  {
    old_bonus = get_bonus();

    bonusreset = time();
    if(bonusdeaths) bonusdeaths--;
    bonuslevels /= 2;

    new_bonus = get_bonus();

    if(old_bonus > new_bonus) player->Message(BS(
      "Der Jadering verbessert Deine Faehigkeiten "
      "nun deutlich weniger."), MSGFLAG_SENSE);
  }
}

// ------ SET_XPFAC() -------------------------------------------------------
string set_xpfac(int newxpfac, int newxpfac2)
{
  if(newxpfac) xpfac=newxpfac;
  if(newxpfac2) xpfac2=newxpfac2;
  return "xpfac = "+xpfac+", xpfac2 = "+xpfac2;
}

// ------ set_defaults() ---------------------------------------------------
varargs void set_defaults(int new_mds, int new_brt, int new_xpfac, int new_xpfac2,
  int new_mrxu, int new_halt, int new_mts, int new_ns, int new_do)
{
  if(new_mds) max_death_saves = new_mds;

  if(new_brt) bonusreset_time = new_brt; // Wie oft werden Bonuslevels reduziert? Def: alle 2 Wochen

  if(new_xpfac) xpfac = new_xpfac;
  if(new_xpfac2) xpfac2 = new_xpfac2;

  if(new_mrxu) max_reset_xp_use = new_mrxu; // XP Abzug Maximum im reset()

  //if(new_halt) haltbarkeit = new_halt; // Haltbarkeitsdauer (in s) // obsolet!

  if(new_mts) max_total_speed_def = new_mts; // Maximum SA_SPEED das der Spieler haben soll
  if(new_ns) max_newspeed = new_ns; // Maximum SA_SPEED vom Ring alleine
  if(death_odds) death_odds = new_do; 
}