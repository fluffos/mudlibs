// Schlachtfeld
// von Wraz / Mendralim
//
// Leiche umdrehen

#include "../def.h"

inherit "std/room";

int i;

void create()
{
  ::create();

  i=1;

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut. Die Erde ist hier sogar "
    "ein bisschen feucht.");

  AddDetail( ({"erde"}),
    "Sie ist hier nicht trocken und staubig, sondern sogar ein wenig "
    "feucht. Woher das Wasser wohl kommen mag?");

  AddDetail( ({"wasser"}),
    "Vermutlich hat es hier vor kurzer Zeit geregnet. Wie auch immer, "
    "hier waechst ein bisschen Gras zwischen den Leichen.");

  AddDetail( ({"zeit","pflanzen"}),
    "Wenn es nicht regnet, dann vertrocknen alle Pflanzen.");

  AddDetail( ({"gras"}),
    "Es ist gruen! Hmm, brauchen Pflanzen eigentlich Licht, um gruen zu sein?");

  AddDetail( ({"licht"}),
    "Du glaubst schon. Ein kleines Experiment wuerde Dich jetzt reizen.");

  AddDetail( ({"experiment"}),
    "Es ist mit ein wenig ekelhafter Arbeit verbunden...");

  AddDetail( ({"arbeit"}),
    "Zwischen den Leichen ist das Gras gruen, da dort Licht hinkommt. Aber "
    "unter ihnen...");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddCmd( ({ "drehe","dreh" }), "cmd_drehen" );

  AddExit( "norden", ROOM "m13" );
  AddExit( "nordosten", ROOM "m14" );
  AddExit( "osten", ROOM "m25" );
  AddExit( "sueden", ROOM "m27" );
  AddExit( "westen", ROOM "m23" );

 AddItem( NPC "soeldner" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ork" , REFRESH_DESTRUCT);
}

int cmd_drehen(string str)
{
  notify_fail("Drehe WAS UM? Oder: Drehe WAS?\n");

  if(!str || str == "") return 0;

  if(str=="leiche"||str=="leiche um"||str=="noch eine leiche um")
  // letzteres ist die woody-syntax
  {
    object ob;

    if(!random(2)) { TP->Message(BS(
      "Du drehst eine Leiche um, aber das Gras unter ihr ist auch gruen. "
      "Bist Du aber auch dumm! Die Leiche ist ja noch frisch, dreh "
      "vielleicht noch eine um."));
      return -1; }
    else { TP->Message(BS(
      "Du drehst eine alte, gammlige Leiche um, *wuerg*, und tatsaechlich, "
      "das Gras unter ihr ist gelb."));
      if(i) {
       TP->Message(BS(
        "WUI! Ein riesen Haufen Muenzen "
        "faellt irgendwo aus der Leiche heraus, Du willst gar nicht wissen, "
        "woraus genau...."));
        ob=clone_object("/obj/money");
        ob->SetProp(P_AMOUNT, 501+random(1000));
        ob->move(TO,M_NOCHECK);
        TP->AddPoison(1+random(2));
        i=0; }
      return 1; }
   }
}

void reset()
{
  ::reset();
  i=1;

  if(TO) WMASTER->muellschlucker(TO);
}
