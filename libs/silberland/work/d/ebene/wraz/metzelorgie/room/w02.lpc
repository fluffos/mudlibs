// Weg zum Schlachtfeld
// von Wraz / Mendralim
//

#include "../def.h"

inherit "std/room";

string schluss();
string kampflaute();
string lies_tafel();
string heldenliste;

int zelt_da;

void create()
{
  ::create();

  heldenliste = "Die Tafel ist unbeschrieben.\n";
  zelt_da = 0;

  SetProp(P_INT_SHORT, "Oestlich des Burggrabens von Kyranda");
  /*SetProp(P_INT_LONG,
    "So. Da Du ja nicht feige bist, hast Du Dich entschlossen, hier "
    "weiter zu gehen. Den Grossteil des Drecks an Dir hast Du schon abgekratzt. "
    "Du stinkst also nicht mehr, und der Burggraben ist auch endlich zu weit "
    "weg, um Deine empfindliche Nase noch belaestigen zu koennen. Eigentlich "
    "jedoch ist es hier genauso langweilig wie vorher, waeren da nicht die "
    "seltsamen Schreie und das Bruellen aus dem Osten. In den Boden ist eine "
    "Tafel eingeschlagen.");*/

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(3),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"himmel","sonne","gefuehl","koerper"}),
    "Die Sonne scheint. Ein angenehm warmes Gefuehl macht sich auf Deinem "
    "Koerper breit.");

  AddDetail( ({"boden"}),
    "Er ist hier wesentlich appetitlicher als im Burggraben von Kyranda. "
    "Ein wenig Gras waechst hier. An einer Stelle ist eine Tafel eingeschlagen.");

  AddDetail( ({"burggraben","graben"}),
    "Der ist weiter im Westen. Wenn Dir nicht zu viel ekelt, kannst Du dort wieder "
    "zurueck gehen und dann hineinklettern.");

  AddDetail( ({"westen"}),
    "Dort ist Kyranda.");

  AddDetail( ({"kyranda"}),
    "Diese Stadt liegt westlich von hier.");

  AddDetail( ({"stadt","beispiel"}),
    "Kyranda zum Beispiel.");

  AddDetail( ({"gras"}),
    "Gras spriesst spaerlich aus dem Boden unter Deinen Fuessen.");

  AddDetail( ({"fuesse","fuss"}),
    "Darunter ist der Boden.");

  AddDetail( ({"dreck"}),
    "Der kommt aus dem Burggraben. Groesstenteils hast Du ihn zum Glueck "
    "schon von Dir abbekommen.");

  AddDetail( ({"grossteil"}),
    "Da Du den Grossteil des Drecks entfernt hast, haengt nur noch ein "
    "Kleinteil davon an Dir. Kleinteil, so ein bloedes Wort!");

  AddDetail( ({"kleinteil","wort"}),
    "Du weisst hoffentlich, wann Schluss ist!");

  AddDetail( "schluss", #'schluss);

  AddDetail( ({"glueck"}),
    "Du stinkst nicht mehr, deswegen.");

  AddDetail( ({"gewand","gewandungen","haut"}),
    "Daran haftet noch ein bisschen Dreck, welcher aus dem Burggraben von "
    "Kyranda westlich von hier stammt.");

  AddDetail( ({"osten"}),
    "Dir wird ein wenig mulmig. Staendig hoerst Du von dort Gebruell und "
    "Geschrei. Wer weiss, was Dich dort erwartet?");

  AddDetail( ({"nase"}),
    "Die wird jetzt endlich verschont!");

  AddDetail( ({"schreie","bruellen","gebruell","geschrei"}),
    "Nicht sichtbar.");

  AddDetail( ({"stelle","tafel"}),
    "An einer Stelle ist eine Tafel eingeschlagen. Du kannst sie lesen.");


  AddSound( DEFAULT_SOUND,
    "Gebruell dringt aus dem Osten zu Dir.");

  AddSound( ({"windhauch","hauch","wind"}),
    "Er wird von Gebruell aus dem Osten uebertoent.");

  AddSound( ({"gebruell","bruellen"}),
    "Es hoert sich fast nach Kampflauten an!");

  AddSound( ({"kampflaute"}), #'kampflaute);

  AddSound( ({"geschrei","schreie","schreien"}),
    "Die Schreie klingen verzweifelt und schmerzerfuellt.");


  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig modrig hier.");

  AddReadDetail( "tafel", #'heldenliste); //'


  AddRoomMessage(
    ({"Du hoerst Gebruell aus dem Osten!\n",
      "Schreie, schmerzende Schreie aus dem Osten!\n",
      "Ein Windhauch.\n",
      "Hier ist es langweilig.\n"}),40+random(23));

  AddExit( "nordosten", ROOM "m01" );
  AddExit( "westen", ROOM "w01" );

}

int query_zelt_da()
{
  return zelt_da;
}

string schluss()
{
  TP->do_damage(30);
  return "Alles klar? :)\n";
}

string kampflaute()
{
  switch(TP->QueryProp(P_LEVEL))
  {
    case 0..20:
      return "Du bekommst Angst! Vertraue lieber Deinen Gefuehlen und "
       "mach kehrt, ehe es zu spaet ist!\n";
      break;

    case 21..45:
      return "Dir wird ein wenig mulmig. Wenn Du Dich traust, geh weiter. "
       "Aber sei auf der Hut!\n";
      break;

    default:

      switch(TP->QueryProp(P_GUILD))
      {
        case "berserker":
          return "HARR! Das wird ein spannendes Gemetzel!! Du freust Dich!\n";
        break;

        case "paladine":
          return "Dusty wird Dir beistehen, hoffst Du.\n";
        break;

        case "druidenzirkel":
          return "Da Du momentan kampflustig bist, beschliesst Du, weiter "
          "zu gehen.\n";
        break;

        default:
          return "Hmm. Geh weiter, aber schau Dich gut um!\n";
        break;
      }
    }
}

string lies_tafel()
{
  TP->More(heldenliste);
  return "\n";
}

void write_heldenliste(string new_heldenliste)
{
  heldenliste =
  "Auf der Tafel steht in wundervoll geschwungener Hobbitschrift:\n\n"
  "Die erfolgreichsten Kriegerinnen und Krieger des Schlachtfeldes!\n"
  + new_heldenliste +
  "\n" + dtime()[5..16] +
  "                                      Gezeichnet: Ahtawqa\n\n";
  return;
}

string _query_int_long()
{
  string txt;

  txt = "So. Da Du ja nicht feige bist, hast Du Dich entschlossen, hier "
  "weiter zu gehen. Den Grossteil des Drecks an Dir hast Du schon abgekratzt. "
  "Du stinkst also nicht mehr, und der Burggraben ist auch endlich zu weit "
  "weg, um Deine empfindliche Nase noch belaestigen zu koennen. Eigentlich "
  "jedoch ist es hier genauso langweilig wie vorher, waeren da nicht die "
  "seltsamen Schreie und das Bruellen aus dem Osten. In den Boden ist eine "
  "Tafel eingeschlagen. ";

  if(zelt_da) txt += "Ein hastig errichtetes Zelt steht hier.";

  return BS(txt);
}

int zelt_aufbauen()
{
  if( zelt_da ) return 0; // Zelt ist bereits da

  zelt_da = 1;

  TO->Message(BS("Eine grosse Orkin laeuft herein, stellt in Windeseile ein "
                 "Zelt auf und verschwindet darin."),MSGFLAG_VISUAL);

  AddDetail( ({"zelt"}),
    "Mit 'zelt' kannst Du es betreten.");

  AddExit( "zelt", ([ EX_DEST : ROOM "laden", EX_MSG: "in das Zelt"]) );

  return 1;
}

int zelt_abbauen()
{
  object *inv;
  int i;

  if( !zelt_da ) return 0; // Zelt ist gar nicht da

  zelt_da = 0;

  TO->Message(BS("Das Zelt wird in Hoechstgeschwindigkeit von einer grossen "
                 "Orkin abgebaut, unter den Arm geklemmt und davon getragen. "
                 ),
                 MSGFLAG_VISUAL);

  tell_room( ROOM "laden", BS(
               "Das Zelt wird von Shegraz in Hoechstgeschwindigkeit "
               "einfach rund um Dich herum abgebaut! Sie klemmt das Zelt und "
               "den Klapptisch unter den Arm, wirft sich Sack und Pack ueber "
               "den Ruecken und ist nach einem kurzen Winken verschwunden.\n"
               "Du stehst etwas verwirrt zwar noch immer am selben Fleck, "
               "aber eben nicht mehr im Zelt."));

  inv=all_inventory( find_object(ROOM "laden") );
  for(i=0;i<sizeof(inv);i++)
  {
    if( inv[i] != present("shegraz",find_object(ROOM "laden")) )
        inv[i]->move( ROOM "w02" , M_NOCHECK + M_NO_SHOW + M_SILENT );
  }

  RemoveDetail( ({"zelt"}) );
  RemoveExit( "zelt" );

  return 1;
}

void reset()
{
  ::reset();

  if( !random(25) && !zelt_da ) zelt_aufbauen();

  else if (zelt_da && !random(2))
  {
    call_other(ROOM "laden", "???");
    if ( present("shegraz",find_object(ROOM "laden")) )
    {
      zelt_abbauen();
    }
  }

  if(TO) WMASTER->muellschlucker(TO);
}
