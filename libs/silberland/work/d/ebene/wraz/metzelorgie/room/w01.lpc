// Weg zum Schlachtfeld
// von Wraz / Mendralim
// Hackstock

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Oestlich des Burggrabens von Kyranda");
  SetProp(P_INT_LONG,
    "Igitt, Dreck hat sich an Deine Gewandungen und Haut geheftet, waehrend "
    "Du aus dem Burggraben gekrochen bist. Naja, hier ist es jedenfalls "
    "wesentlich gemuetlicher. Im Westen kannst Du zurueck in den Graben "
    "klettern, jedoch widerstrebt Dir allein der Gedanke. Nach Osten ist "
    "momentan nichts Besonderes zu erkennen.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(3),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"himmel","sonne","gefuehl","koerper"}),
    "Die Sonne scheint. Ein angenehm warmes Gefuehl macht sich auf Deinem "
    "Koerper breit.");

  AddDetail( ({"boden"}),
    "Er ist hier wesentlich appetitlicher als im Burggraben von Kyranda. "
    "Ein wenig Gras waechst hier.");

  AddDetail( ({"burggraben","graben"}),
    "Der ist im Westen. Wenn Dir nicht zu viel ekelt, kannst Du dort wieder "
    "hineinklettern.");

  AddDetail( ({"westen"}),
    "Dort ist Kyranda.");

  AddDetail( ({"kyranda"}),
    "Diese Stadt liegt westlich von hier. Kletter in den stinkenden Burggraben "
    "zurueck und Du kommst dort hin.");

  AddDetail( ({"stadt","beispiel"}),
    "Kyranda zum Beispiel.");

  AddDetail( ({"gras"}),
    "Gras spriesst spaerlich aus dem Boden unter Deinen Fuessen.");

  AddDetail( ({"fuesse","fuss"}),
    "Darunter ist der Boden.");

  AddDetail( ({"dreck"}),
    "Der kommt aus dem Burggraben.");

  AddDetail( ({"gewand","gewandungen","haut"}),
    "Daran haftet Dreck, welcher aus dem Burggraben von Kyranda westlich von "
    "Dir stammt.");

  AddDetail( ({"gedanke"}),
    "Der Gedanke, wieder nach Westen in den Graben zu klettern laesst Dich "
    "ekeln. Wenn Du mutig bist, geh weiter nach Osten!");

  AddDetail( ({"osten"}),
    "Was haelt Dich noch hier? Geh weiter! Oder bist Du feig?");

  AddDetail( ({"besonderes"}),
    "Derzeit erkennst Du im Osten nichts Besonderes, aber das kann sich ja "
    "noch aendern...");


  AddSound( DEFAULT_SOUND,
    "Du hoerst Schritte aus dem Burggraben gatschen.");

  AddSound( "schritte",
    "Sie erzeugen schmatzende Geraeusche.");


  AddSmell( DEFAULT_SMELL,
    "Der Dreck an Dir stinkt!");

  AddSmell( "dreck",
    "Wuah, grrr!");

  AddSmell( "gestank",
    "Uff, wuah, Du stinkst! Und aus dem Burggraben stinkt es auch, hier "
    "fast noch staerker als wenn man drinnen hockt!");

  AddRoomMessage(
    ({"Aus dem Burggraben steigt ein ekelhafter Gestank auf!\n",
      "Hier ist es langweilig.\n"}),60+random(23));

  AddItem(OBJ "hackstock", REFRESH_DESTRUCT);

  AddExit( "osten", ROOM "w02" );

  AddCmd("kletter|klettere&in&graben|burggraben",
    "cmd_klettern",
    "IN was willst Du klettern?|Willst Du in den BURGGRABEN klettern?");
}

int cmd_klettern()
{
  write(BS(
    "Du haeltst Dir die Nase zu und kletterst angewidert in den stinkenden "
    "Burggraben zurueck."));
  TP->move("/d/ebene/lamuerte/burg/graben/room10x_4y", M_GO,
    "in den Burggraben", "klettert angewidert");

  return 1;
}
