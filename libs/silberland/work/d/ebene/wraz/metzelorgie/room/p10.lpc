// Pfad 06
// Wraz / Mendralim
// Meisterschlaechter
//

#include "../def.h"
#include "/sys/player/base.h"

inherit ROOM "pfad.lpc";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Pfadende beim Schlachtfeld");
  SetProp(P_INT_LONG,
    getcolor("red")+
    "Der Pfad ist hier zu Ende. Eine groessere Flaeche ist hier frei von Gras "
    "und Straeuchern. Die Umwelt hier sieht leblos aus, der Himmel "
    "ist bedrohlich von dunklen Wolken bedeckt, die Sonne ist daher nicht "
    "zu sehen. Ein Gefuehl des TODES bemaechtigt sich Deiner!"+
    getcolor("none"));

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"gras"}), getcolor("red")+
   "Rund um die erdige Flaeche herum waechst mattgruenes Gras."
   +getcolor("none"));

  AddDetail( ({"umwelt"}), getcolor("red")+
    "Alles sieht so matt und leblos aus. STERBEN!"
   +getcolor("none"));

  AddDetail( ({"gefuehl"}), getcolor("red")+
    "ES IST DAS GEFUEHL DES TODES!!"
   +getcolor("none"));

  AddDetail( ({"tod","todes","tode"}), getcolor("red")+
    "Es ist, als ob Du Dir den TOD herbeiwuenscht, als ob Du sterben willst! "
    "Deine Sinne sind wohl getruebt. VERNICHTEN!!"
   +getcolor("none"));

  AddDetail( ({"sinne"}), getcolor("red")+
    "Sie taeuschen Dich hier! MORD!"
   +getcolor("none"));

  AddDetail( ({"mord"}), getcolor("red")+
    "STERBEN!!!"
    +getcolor("none"));

  AddDetail( ({ "boden","flaeche" }), getcolor("red")+
    "Eine etwas groessere Flaeche ist hier grasfrei und nur von staubiger "
    "Erde bedeckt."
   +getcolor("none"));

  AddDetail( ({"erde"}), getcolor("red")+
    "Sie ist total trocken. AUSGEHAUCHT!"
   +getcolor("none"));

  AddDetail( ({"pfad", "ende"}), getcolor("red")+
    "Der Pfad endet hier in einer grossen, erdigen Flaeche."
   +getcolor("none"));

  AddDetail( ({"blut","bluuut","bluut"}), getcolor("red")+
   "Hier ist kein Blut. Aber vielleicht bald Dein eigenes..."
   +getcolor("none"));

  AddDetail( ({"himmel", "sonne", "wolken", "wolke"}), getcolor("red")+
   "Der Himmel ist von dunklen Wolken bedeckt, die Sonne verhuellt. TOD!"
   +getcolor("none"));

  AddDetail( ({"baeume", "straeucher"}), getcolor("red")+
    "Die Baeume und Straeucher wuchern ueppig."
   +getcolor("none"));

  AddDetail( ({"silberland"}), getcolor("red")+
    "blutruenstige Krieger gibt es hier. Sie wollen Dich TOETEN!"
   +getcolor("none"));

  AddDetail( ({"ratte","ratten"}), getcolor("red")+
   "Hmm. Nichtmal die Ratten laufen noch hier herum. Seltsam."
   +getcolor("none"));

  AddDetail( ({"entfernung", "westen","schlachtfeld","feld"}),
   getcolor("red")+
   "Das Schlachtfeld befindet sich in einiger Entfernung weit im Westen."
   +getcolor("none"));

  AddSound( DEFAULT_SOUND, getcolor("red")+
    "Du hoerst Schreie."
   +getcolor("none"));

  AddSound( ({"schreie","schrei"}), getcolor("red")+
   "Sie kommen vom Schlachtfeld."
   +getcolor("none"));

  AddSound( ({"schlachtfeld"}), getcolor("red")+
   "Die Schreie kommen eindeutig von dem Schlachtfeld."
   +getcolor("none"));

  AddSound( ({"todesschreie", "entsetzen"}), getcolor("red")+
   "Man hoert ihnen das Entsetzen an!"
   +getcolor("none"));

  AddSmell( DEFAULT_SMELL, getcolor("red")+
    "Es riecht hier gefaehrlich!!"
   +getcolor("none"));

  AddRoomMessage(
    ({getcolor("red")+"Es ist hier bedrohlich still.\n"
   +getcolor("none"),
     getcolor("red")+"TOD!!!\n"
   +getcolor("none"),
     getcolor("red")+"STERBEN!!!\n"
   +getcolor("none"),
     getcolor("red")+"LEBLOS!!\n"
   +getcolor("none"),
     getcolor("red")+
    "Du hoerst Todesschreie aus einiger Entfernung!\n"
   +getcolor("none")}),50+random(23));

  SUID;

  AddExit( "westen", ROOM "p09" );
}

string GetExits(object viewer)
{
  return getcolor("red")+"Nach Westen geht's raus!\n"+getcolor("none");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  pfad::NotifyPlayerDeath(player, killer, lostexp);
}

void DoOpenShadowrift(string caller_npc)
{
  string anfangstext;

  if(caller_npc=="meisterschlaechter")
    anfangstext = "Ploetzlich und wie aus dem Nichts";
  else if(caller_npc=="schreckgespenst")
    anfangstext = "Aus den schwarzen Nebelresten des vernichteten Schreckgespensts";

  TO->Message(BS(
    anfangstext+" formt sich eine "
    "trollgrosse Saeule, die zu schimmern beginnt. Es sieht aus wie ein "
    "Riss... ein Uebergang zu einer anderen, schattenhaften Welt! Dann erscheint "
    "ein Avatar von Wraz, mustert euch kurz und nickt kaum wahrnehmbar. Er spricht "
    "eine magische Silbe und ist sofort wieder verschwunden."
  ),MSGFLAG_VISUAL);
  CLONEME(OBJ "portal_schatten");
}

void open_shadowrift(string caller_npc)
{
  call_out("DoOpenShadowrift",4,caller_npc);
}

