// Pfad 09
// Wraz / Mendralim
// Barghest
// Baum riechen
// -- Absichtlich kein move_corpse hier --> Barghest frisst Leiche!

#include "../def.h"

inherit ROOM "pfad.lpc";

int i;

int wache();
int rwache();

string baum();

void create()
{
  ::create();

  i=1;

  SetProp(P_INT_SHORT, "Ein Pfad beim Schlachtfeld");
  SetProp(P_INT_LONG,
    "Viele Baeume und Straeucher ueberwuchern den erdigen Pfad, auch das "
    "Gras waechst hier noch hoeher. Der Himmel erstrahlt in einem dunklen "
    "Rot, frei von Wolken strahlt die Sonne schwach auf Dich herab. "
    "Die Stimmung ist hoechst angsteinfloessend!");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"stimmung", "angst"}),
   "Alles hier macht Dir Angst!");

  AddDetail( ({"angst","irgendetwas", "tatsache","sorgen"}),
   "Die Tatsache, dass hier ploetzlich niemand mehr ist, macht Dir Sorgen. "
   "Warum trauen sich selbst die todesmutigen Krieger nicht hierher?");

  AddDetail( ({ "boden", "gras", "zwerg" }),
    "Das Gras ist hier schon so hoch, dass ein kleiner Zwerg wohl fast nicht "
    "mehr darueber hinweg sehen kann.");

  AddDetail( ({"pfad", "osten"}),
    "Der Pfad fuehrt weiter nach Osten. Wer weiss, was Dich dort "
    "erwartet...");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Hier ist kein Blut mehr.");

  AddDetail( ({"himmel", "sonne", "wolken", "wolke", "rot"}),
   "Er ist hier noch immer blutrot gefaerbt. Keine Wolke verdeckt ihn, die "
   "Sonne strahlt trotzdem nur schwach.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es ist weiter im Westen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Die Baeume und Straeucher wuchern hier ueppig ueber den Pfad.");

  AddDetail( ({"silberland", "krieger"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Hmm. Nichtmal die Ratten laufen noch hier herum. Seltsam.");

  AddDetail( ({"baum"}),
   "Er riecht suesslich.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Sie kommen vom Schlachtfeld.");

  AddSound( ({"schlachtfeld"}),
   "Die Schreie kommen eindeutig von dem Schlachtfeld.");

  AddSound( ({"todesschreie", "entsetzen"}),
   "Man hoert ihnen das Entsetzen an!");

  AddSmell( DEFAULT_SMELL,
    "Du riechst einen suesslichen Duft.");

  AddSmell( ({"duft"}),
   "Er kommt von einem Baum.");

  AddSmell( ({"baum"}), #'baum);

  AddRoomMessage(
    ({"Es ist hier bedrohlich still.\n",
    "Warum ist hier niemand mehr?\n",
    "Du hoerst Todesschreie aus einiger Entfernung.\n"}),50+random(23));

  SUID;

  AddExit( "osten", ([EX_DEST: ROOM "p10",
                      EX_TESTFUNC: #'wache,
                      EXG_ID:  "\nwache",
                      EXG_PLMSG: "Der Barghest versperrt Dir den Weg.\n",
                      EXG_RMMSG: "Der Barghest laesst @wen@ nicht "
                      "passieren.\n"]) );

  AddExit( "norden",  ([EX_DEST: ROOM "p08",
                            EX_TESTFUNC: #'rwache,
                            EXG_ID:  "\nwache",
                            EXG_PLMSG: "Der Barghest versperrt Dir den Weg.\n",
                            EXG_RMMSG: "Der Barghest laesst @wen@ nicht "
                            "passieren.\n"]) );

}
int wache()
{
  return 1;
}

void reset()
{
 ::reset();
 i=1;
}

string baum()
{
    if(TP->InFight())
    {
      write(BS(
        "Du bist viel zu abgelenkt!"));
      return "";
    }

  if(i)
  {
    TP->Message(BS(
      "Du schnueffelst an dem Baum, und ploetzlich haut Dich der suesse "
      "Duft um! WUUUUUUUI! Du bist kurz bewusstlos, doch als Du wieder "
      "aufstehst, fuehlst Du Dich erfrischt."));
    ENV(TP)->Message(BS(
      TPN+" faellt um, steht wieder auf und sieht ploetzlich besser drein!"),
       MSGFLAG_NO_TP);
    TP->AddHp(200);
    TP->AddSp(350);
    i=0;
    return "";
  }
  else
  {
    TP->Message(BS(
      "Du schnueffelst an dem Baum, und ploetzlich haut Dich der suesse "
      "Duft um! Du bist kurz bewusstlos, stehst aber schnell wieder auf."));
    ENV(TP)->Message(BS(
      TPN+" faellt um und steht gleich wieder auf. Komisch."),MSGFLAG_NO_TP);
    return "";
  }
}

void init()
{
  ::init();

  WMASTER->carries_food(TP);

  if(query_once_interactive(TP)) return;
  if(!TP->QueryProp(P_NPC)) return;

  if(TP->QueryProp(P_UID)=="d.wasser.stahldorn"&&
     TP->id("daemon"))
  {
    tell_room(TO,BS(
      "Der Daemon verschwindet einfach wieder."));
    TP->remove(1);
    return;
  }
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  pfad::NotifyPlayerDeath(player, killer, lostexp);
}
