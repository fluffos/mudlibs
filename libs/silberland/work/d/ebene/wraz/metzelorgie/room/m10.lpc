// Schlachtfeld
//
// von Wraz / Mendralim
//
// Hier muss man Erde essen um an einen FP zu kommen

#include "../def.h"

inherit "std/room";

mapping map;

void create()
{
  ::create();

  map=([]);

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile, Blut und Erde.");

  AddDetail( ({"erde"}),
    "Du koenntest die Erde essen!");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddCmd( ({ "iss" }), "cmd_essen" );

  AddExit( "osten", ROOM "m10a" );
  AddExit( "sueden", ROOM "m14" );
  AddExit( "nordwesten", ROOM "m06" );
  AddExit( "norden", ROOM "m07" );
  AddExit( "westen", ROOM "m09" );
  AddExit( "nordosten", ROOM "m07a" );


  AddItem( NPC "ork" , REFRESH_DESTRUCT);
  AddItem( NPC "kampfsoldat" , REFRESH_DESTRUCT);
  AddItem( NPC "ork" , REFRESH_DESTRUCT);
  AddItem( NPC "ork" , REFRESH_DESTRUCT);
  AddItem( NPC "ratte" , REFRESH_DESTRUCT);
}

int cmd_essen(string str)
{
  int p; //poison
  notify_fail("Was willst Du essen?\n");

  if(!str || str == "") return 0;

  if(str=="erde")
  {
    if(!map[TPN]) map[TPN]=1;
    p=TP->QueryProp(P_POISON);

    switch(map[TPN])
    {
      case 1:
        TP->Message(BS(
         "Was geht in Deinem Kopf eigentlich vor? Vermutlich nichts. Egal, "
         "Du nimmst eine Hand voll Erde und isst sie auf. BAEH!\n"
         "Aber das wars noch nicht! Iss weiter, der Forscherpunkt "
         "rueckt naeher!"));
       if(p<13) TP->SetProp(P_POISON, p+1);
       map[TPN]++;
       TP->SetProp(P_FOOD, (TP->QueryProp(P_FOOD))+10);
       return -1;
       break;

       case 2:
         TP->Message(BS(
          "Nicht so lahm! Du willst den FP doch heute noch haben, oder? "
          "LOS ISS WEITER!!"));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, (TP->QueryProp(P_FOOD))+10);
          return -1;
          break;

       case 3:
         TP->Message(BS(
          "Selbst Ayla frisst Erde schneller als Du! Jetzt streng Dich an!"));
          if(p<13) TP->SetProp(P_POISON, p+1);
       map[TPN]++;
       TP->SetProp(P_FOOD, (TP->QueryProp(P_FOOD))+10);
       return -1;
       break;

       case 4:
         TP->Message(BS(
          "DAS WAR DOCH NICHT ALLES!?!? LOS, RUNTER AUF DIE KNIE UND REIN "
          "MIT DER ERDE!!"));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

        case 5:
          TP->Message(BS(
           "Ja! Der FP rueckt immer naeher. ISS WEITER!"));
           if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

        case 6:
         TP->Message(BS(
          "Das ist ja erbaermlich! Wegen dem bisschen Erde kann Dir doch "
          "nicht schlecht sein!"));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

        case 7:
         TP->Message(BS(
          "Was? Dir ist schwindlig? Willst Du den FP nun oder nicht?"));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

        case 8:
         TP->Message(BS(
          "Jetzt komm schon, da geht noch was rein! Du musst Dir den FP "
          "schon verdienen!"));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

        case 9:
         TP->Message(BS(
          "Es ist noch genug Erde da fuer alle anderen Spieler. Iss unbesorgt "
          "weiter."));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

        case 10:
         TP->Message(BS(
          "Jetzt kommen wir der Sache schon naeher."));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

        case 11:
         TP->Message(BS(
          "MACHST DU ETWA SCHON SCHLAPP?? VERLIERER WERDEN NICHT GEDULDET, "
          "ISS WEITER, ABER FLOTT!!!"));
          if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

         case 12:
          TP->Message(BS(
           "Einer geht noch!! FRISS WIE DU ERDE NOCH NIE GEFRESSEN HAST!"));
           if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return -1;
          break;

          case 13:
           TP->Message(BS(
            "Unglaublich was Spieler alles fuer einen einzigen Forscherpunkt "
            "tun... Bittesehr, nun hast Du ihn!"));
            if(p<13) TP->SetProp(P_POISON, p+1);
          map[TPN]++;
          map[TPN]=0;
       TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)+10);
          return 1;
          break;

          default:
           TP->Message(BS(
            "Wraz die bloede Sau hat da wieder an Schass programmiert... "
            "Bug bitte melden!"));
            break;
        }
      }

  return 1;
}

void reset()
{
  ::reset();

  map=([]);

  if(TO) WMASTER->muellschlucker(TO);
}
