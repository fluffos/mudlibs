// Schlachtfeld
// von Wraz / Mendralim
// Opkac-Raum
// Erde (Boden)

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut. Die Erde ist staubtrocken "
    "und pechschwarz. Einige Grasbueschel und kleine Pflaenzchen wachsen "
    "hier trotzdem.");

  AddDetail( ({"grasbueschel","bueschel"}),
    "Sie wachsen nicht sehr dicht und sind eher gelb als gruen, was vermutlich "
    "auf den Wassermangel zurueckzufuehren ist.");

  AddDetail( ({"wassermangel","trockenheit"}),
    "Die pechschwarze Erde ist staubtrocken.");

  AddDetail( ({"erde"}),
    "Sie ist pechschwarz. Du hast keine Ahnung wieso.");

  AddDetail( ({"ahnung"}),
    "Schau Dich um!");

  AddDetail( ({"pflaenzchen"}),
    "Loewenzahn, Distel, Efeu zum Beispiel.");

  AddDetail( ({"loewenzahn","loewenzaehne"}),
    "Sie bluehen nicht.");

  AddDetail( ({"distel","disteln"}),
    "Die Disteln sind verdammt stachelig!");

  AddDetail( ({"stacheln"}),
    "Spitz!");

  AddDetail( ({"efeu"}),
    "Eine kleine, trockene Ranke mit genau fuenf Blaettern waechst hier.");

  AddDetail( ({"blaetter"}),
    "Sie sind ziemlich kaputt und trocken.");

  AddDetail( ({"ranke"}),
    "Die Ranke waechst hier, trotz der rauen Bedingungen.");

  AddDetail( ({"bedingungen"}),
    "Trockenheit, Krieger die auf dem Boden herumtrampeln.");

  AddDetail( ({"beispiel"}),
    "Loewenzahn, Distel und Efeu zum Beispiel, aber auch ein kleiner Busch!");

  AddDetail( ({"busch"}),
    "Er sieht merkwuerdig aus, irgendwie bedrohlich, als wuerde er etwas "
    "verbergen...");

  AddDetail( ({"etwas"}),
    "Biege den Busch vielleicht einmal um, dann siehst Du moeglicherweise "
    "mehr.");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddCmd( ({ "biege","bieg" }), "cmd_biegen" );

  AddExit( "nordosten", ROOM "m13" );
  AddExit( "osten", ROOM "m24" );
  AddExit( "suedosten", ROOM "m27" );


 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ork" , REFRESH_DESTRUCT);
 AddItem( NPC "zwergberserker" , REFRESH_DESTRUCT);
 AddItem( NPC "kampfsoldat" , REFRESH_DESTRUCT);
}

int cmd_biegen(string str)
{
  notify_fail("Was willst Du umbiegen?\n");

  if(!str || str == "") return 0;

  if(str=="busch um"||str=="biege busch einmal um")
  {
    TP->Message(BS(
      "Du schluckst einmal, nimmst Deinen ganzen Mut zusammen und gehst "
      "vorsichtig zu dem Busch. Mit zittrigen Haenden biegst Du sachte "
      "die Aeste auseinander und ZACK!!! Was Du siehst, erschreckt Dich "
      "fast zu TODE! DER BUSCH LEBT! Er pulsiert foermlich! Eine "
      "niedrig viskose, schwarze Fluessigkeit laeuft seine Aeste hinab "
      "und traenkt den Boden pechscharz, ausserhalb des Busches ist "
      "er jedoch nicht mehr feucht. Vor Schreck bist Du auf den Ruecken "
      "gefallen, als haette Dich jemand von dem Busch weggetreten. "
      "Du beschliesst, dem Busch nicht mehr zu nahe zu kommen."));
    TP->AddHp(-random(60));
    return 1;
   }
}

void reset()
{
  ::reset();

  if(random(1000) < 50 && sizeof(find_livings("opkac")) < 10)
  {
    call_other(NPC "opkac", "???");
    clone_object(NPC "opkac")->move(TO, M_GO);
  }

  if(TO) WMASTER->muellschlucker(TO);
}
