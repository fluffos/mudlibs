{
  if(!WMASTER->query_last_wache())
  {
    TP->Message(BS(
      "Du hast den Pfad beschritten und kannst nun nicht mehr umkehren! "
      "KAEMPFE oder der TOD holt Dich!"));
    return 0;
  }
  else return 1;
}*/


int cmd_essen(string str)
{
  notify_fail("Was willst Du essen?\n");

  if(!str||str=="") return 0;

  if(str=="beeren"||str=="beere");
  {
    if(TP->InFight())
    {
      write(BS(
        "Du bist viel zu abgelenkt!"));
      return -1;
    }

    if(i)
    {
      TP->Message(BS(
       "Vorsichtig kostest Du zuerst eine Beere. Hmm, schmeckt nicht schlecht. "
       "Du isst noch eine. Lecker! Schliesslich isst Du alle Beeren von dem "
       "Strauch herunter, fuehlst Dich aber nicht satt. Komisch."));
      ENV(TP)->Message(BS(
       TPN+" isst alle gruenen Beeren von einem Strauch herunter!"),
        MSGFLAG_NO_TP);
      TP->AddHp(200);
      TP->AddSp(290);
      i=0;
      return 1;
    }

    else
    {
      TP->Message(BS(
       "Du Idiot hast die Blaetter mit Beeren verwechselt!"));
      return -1;
    }
  }
}

void reset()
{
 ::reset();
 i=1;
}

void init()
{
  ::init();

  WMASTER->carries_food(TP);

  if(query_once_interactive(TP)) return;
  if(!TP->QueryProp(P_NPC)) return;

  if(TP->QueryProp(P_UID)=="d.wasser.stahldorn"&&
     TP->id("daemon"))
  {
    tell_room(TO,BS(
      "Der Daemon verschwindet einfach wieder."));
    TP->remove(1);
    return;
  }
}

void call_move_corpse(object player)
{
  WMASTER->move_corpse(player,TO);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  pfad::NotifyPlayerDeath(player, killer, lostexp);
  call_out("call_move_corpse",0,player);
}
