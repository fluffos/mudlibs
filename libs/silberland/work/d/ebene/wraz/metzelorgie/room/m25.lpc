// Schlachtfeld
// von Wraz / Mendralim
//
// Ein wilder, der einem den Kopf abschlaegt (wenn man will kann man das
// als Scriptfalle bezeichnen, war aber nicht als solche geplant)

#include "../def.h"

inherit "std/room";

string vogel();
int i;
int tot;
int actual;

void create()
{
  ::create();

  i=1;
  tot=1;
  actual=1;

  SetProp(P_KILL_NAME, "Ein hinterhaeltiger Wilder");

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut.");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier voller Blutflecken.");

  AddDetail( ({"blutflecken"}),
    "Manche haben interessante Formen.");

  AddDetail( ({"formen"}),
    "Einer hier sieht aus wie ein Ball, so rund ist er!");

  AddDetail( ({"ball"}),
    "Oh, er ist ja noch frisch und spiegelt etwas. Sieht aus wie ein Vogel.");

  AddDetail( ({"vogel"}), #'vogel); //'

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddCmd( ({ "duck","ducke" }), "cmd_ducken" );

  AddExit( "norden", ROOM "m14" );
  AddExit( "nordosten", ROOM "m14a" );
  AddExit( "osten", ROOM "m26" );
  AddExit( "sueden", ROOM "m28" );
  AddExit( "suedwesten", ROOM "m27" );
  AddExit( "westen", ROOM "m24" );
  AddExit( "nordwesten", ROOM "m13" );

 AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
 AddItem( NPC "ork" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
}

int cmd_ducken(string str)
{
  notify_fail("Duck DICH?\n");

  if(!str || str == "") return 0;

  if(str=="dich")
  {
    object leiche;

    if(!actual) {
    TP->Message(BS(
      "Du duckst Dich, das Schwert des Wilden fetzt haarscharf an "
      "Deinem Kopf vorbei und bleibt hinter Dir im Baum stecken. "
      "Ploetzlich kommt eine immense WUT in Dir auf! Du springst auf, "
      "reisst das Schwert mit GEWALTIGER KRAFT aus dem Baum heraus, "
      "trittst den Wilden erbarmungslos zu Boden. Bevor er auch nur "
      "irgendwie reagieren kann, RAMMST Du ihm die Klinge seines "
      "eigenen Schwertes in den Leib!"));
    TP->Message(BS(
      "Erleichtert bruellst Du: ARRRRRRRRRRRRRRRRR!!!!!!!!!!!!!!"));
    tell_room(TO, BS(
      TPN+" schlachtet einen Wilden ab und bruellt im Siegesrausch: "
      "ARRRRRRRRRRRRRRRRR!!!!!!!!!!!!!!"), ({TP}) );
    TP->AddExp(3000);
    leiche=clone_object("/std/corpse");
     leiche->SetProp(P_NAME, "Leiche eines Wilden");
     leiche->SetProp(P_LONG, "Die Leiche eines Wilden. Er wurde durch ein Schwert "
      "in seiner Brust getoetet");
     leiche->SetProp(P_SHORT, "Die Leiche eines Wilden");
    clone_object("/p/weapon/sword/langschwert")->move(leiche,M_GET);
    leiche->move(TO,M_GO);
    tot=0;
    actual=1;
    return 1;
   }
   else {
     TP->Message(BS(
       "Du duckst Dich. Wozu?"));
     ENV(TP)->Message(BS(
       TPN+" duckt sich."),MSGFLAG_NO_TP);
     return -1; }
  }
}

string vogel()
{
  if(i)
  {
      i=0;
      actual=0;
      call_out("sudden_death",18,TP);
      return "Der Vogel bewegt sich seltsam und funkelt metallisch. Du drehst Dich "
      "um.\n"
      "ARGH!\n"
      "Da steht ein Wilder hinter Dir mit ausgeholtem Schwert! Er ist drauf "
      "und \ndran, Dir den Kopf abzuschlagen!\n\n"
      "DUCK DICH !!!\n\n";
  }

  else return "Du drehst Dich um. Nichts da.\n";
}

void reset()
{
  ::reset();
  i=1;

  if(TO) WMASTER->muellschlucker(TO);
}

void sudden_death(object player)
{
  if(!tot) return;
  if(!interactive(player)) return;
  if(ENV(player)!=TO) return;

  player->Message(BS(
    "Du bleibst wie angewurzelt stehen und siehst zu, wie der Wilde "
    "Dir den Kopf absaebelt."));
  player->die(0);
  actual=1;
  tot=1;
  i=1;
  return;
}
