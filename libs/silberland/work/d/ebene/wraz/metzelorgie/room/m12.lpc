// Schlachtfeld
//
// von Wraz / Mendralim
// Opkac-Raum
// hier is nix

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut.");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  //AddCmd( ({ "tue" }), "cmd_tun" );

  AddExit( "norden", ROOM "m08" );
  AddExit( "nordosten", ROOM "m09" );
  AddExit( "osten", ROOM "m13" );


  AddItem( NPC "kampfsoldat" , REFRESH_DESTRUCT);
  AddItem( NPC "militaer" , REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();

  if(random(1000) < 50 && sizeof(find_livings("opkac")) < 10)
  {
    call_other(NPC "opkac", "???");
    clone_object(NPC "opkac")->move(TO, M_GO);
  }

  if(TO) WMASTER->muellschlucker(TO);
}
