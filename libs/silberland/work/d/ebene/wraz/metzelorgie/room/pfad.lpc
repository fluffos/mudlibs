// Schlachtfeld
// Wraz / Mendralim
// die "Pfad des Todes" Raeume p03 bis p10 erben von hier

#include "../def.h"

inherit "std/room";

int rwache()
{
  call_other(ROOM "p09", "???");
  if (!present("\nwache",find_object(ROOM "p09")))
    WMASTER->set_status("last_wache",1);

  if(!WMASTER->query_last_wache())
  {
    TP->Message(BS(
      "Du hast den Pfad beschritten und kannst nun nicht mehr umkehren! "
      "TOETE ALLES was sich Dir in den Weg stellt, oder STIRB wie "
      "ein HELD!"));
    return 0;
  }
  else return 1;
}

void BecomesNetAlive(object player) // Ausloggen spuet's net!
{ // && !TP->InFight()
  string *rooms;
  string room_no;
  rooms = ({"m01","m02","m03","m04","m05","m06","m07","m08","m09","m10",
            "m11","m12","m13","m14","m23","m24","m25","m26","m27","m28",
            "m29"});
  room_no = rooms[random(sizeof(rooms))];

  if( lower_case( player->Name() ) != WMASTER->query_who_inside() )
  {
    player->Message(BS(
      "Eine gewaltige Kraft bestraft Dich fuer Deine Feigheit und schleudert "
      "Dich weit weg!!"));
    call_other(ROOM + room_no, "???");
    player->move(ROOM + room_no, M_GO, "davongeschleudert! Feigling", "wird",
       "fliegt an und prallt hart auf!");
    player->AddHp(-(65+random(60)));
  }
return;
}

void BecomesNetDead(object player)
{
  player->Message(BS(
    "Das Reich der Netztoten bekommt Dir hier gar nicht gut. "
    "Du fuehlst, wie Gift Deinen Koerper zerfrisst!"));
  if(!(player->QueryProp(P_GHOST))) player->AddPoison(5+random(6));
return;
}

void player_dies(object player)
{
  DMASTER->save_playerdeath(getuid(player));
  player->Message(BS("Dein Tod kraeftigt Dich gegen den Pfad!"));
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  WMASTER->npc_kill_log(killer->Name(RAW), getuid(player), lostexp);
  player_dies(player);
}
