string superausblick()
{
  mixed *location;

  string NWpl;
  string NWnpc;
  string Wpl;
  string Wnpc;
  string Spl;
  string Snpc;
  string naherNWpl;
  string naherNWnpc;
  string naherSWpl;
  string naherSWnpc;

  location=ausblick();

  if(!location[0]) location[0]=0;
  if(!location[1]) location[1]=0;
  if(!location[2]) location[2]=0;
  if(!location[3]) location[3]=0;
  if(!location[4]) location[4]=0;
  if(!location[5]) location[5]=0;
  if(!location[6]) location[6]=0;
  if(!location[7]) location[7]=0;
  if(!location[8]) location[8]=0;
  if(!location[9]) location[9]=0;

  switch (location[0])
  {
    case 0: NWpl=""; break;
    case 1: NWpl="einen Spieler und "; break;
    case 2..4: NWpl="einige Spieler und "; break;
    case 5..10: NWpl="eine grosse Anzahl Spieler und "; break;
    default: NWpl="unglaublich viele Spieler und "; break;
  }

  switch (location[1])
  {
    case 0: NWnpc="keinen einzigen Wilden oder Krieger, nicht einmal eine Ratte";
      break;
    case 1: NWnpc="eine Ratte oder einen Wilden, Du erkennst es nicht genau"; break;
    case 2..4: NWnpc="einige Krieger"; break;
    case 5..8: NWnpc="einen Haufen Wilder und Krieger"; break;
    case 9..14: NWnpc="einen grossen Haufen Orks und Krieger"; break;
    default: NWnpc="eine riesige Anzahl Krieger und Wilder"; break;
  }

  switch (location[2])
  {
    case 0: Wpl=""; break;
    case 1: Wpl="einen Spieler und "; break;
    case 2..4: Wpl="einige Spieler und "; break;
    case 5..10: Wpl="viele Spieler und "; break;
    default: Wpl="sehr viele Spieler und"; break;
  }

  switch (location[3])
  {
    case 0: Wnpc="nicht einmal eine lausige Ratte"; break;
    case 1: Wnpc="vielleicht einen Ork"; break;
    case 2..4: Wnpc="einige Ratten und Krieger"; break;
    case 5..8: Wnpc="einen Haufen Orks oder Krieger"; break;
    case 9..14: Wnpc="einen grossen Haufen Orks oder Krieger"; break;
    default: Wnpc="gigantisch viele Wilde"; break;
  }

  switch (location[4])
  {
    case 0: Spl="keine Spieler und "; break;
    case 1: Spl="einen Spieler und "; break;
    case 2..4: Spl="eine kleine Gruppe Spieler und "; break;
    case 5..10: Spl="eine grosse Gruppe Spieler und "; break;
    default: Spl="eine Armee von Spielern und "; break;
  }

  switch (location[5])
  {
    case 0: Snpc="keine blutruenstigen Krieger"; break;
    case 1: Snpc="etwas, das ein Krieger sein koennte"; break;
    case 2..4: Snpc="ungefaehr zwei oder drei Krieger"; break;
    case 5..8: Snpc="eine groessere Anhaeufung Krieger"; break;
    case 9..14: Snpc="eine extrem grosse Zahl an Wilden und Orks"; break;
    default: Snpc="eine Streitmacht Krieger und Wilder"; break;
  }

  switch (location[6])
  {
    case 0: naherNWpl="keine Spieler und "; break;
    case 1: naherNWpl="ein Spieler allein und "; break;
    case 2..4: naherNWpl="mehrere Spieler und "; break;
    case 5..10: naherNWpl="viele Spieler beisammen und "; break;
    default: naherNWpl="unzaehlbar viele Spieler und "; break;
  }

  switch (location[7])
  {
    case 0: naherNWnpc="keine einziger Krieger!"; break;
    case 1: naherNWnpc="vermutlich eine Ratte."; break;
    case 2..4: naherNWnpc="ein paar Ratten und Krieger."; break;
    case 5..8: naherNWnpc="ein paar Ratten und viele Krieger!"; break;
    case 9..14: naherNWnpc="viele Ratten und sehr viele Krieger!"; break;
    default: naherNWnpc="beaengstigend viele Krieger und Wilde!!"; break;
  }

  switch (location[8])
  {
    case 0: naherSWpl="keine Spieler und "; break;
    case 1: naherSWpl="ein Spieler und "; break;
    case 2..4: naherSWpl="ein paar Spieler und "; break;
    case 5..10: naherSWpl="viele Spieler und "; break;
    default: naherSWpl="extrem viele Spieler und "; break;
  }

  switch (location[9])
  {
    case 0: naherSWnpc="nicht einmal eine einzige Ratte!"; break;
    case 1: naherSWnpc="etwas, das ein Zwergberserker sowie eine Ratte "
      "sein koennte..."; break;
    case 2..4: naherSWnpc="einige Orks."; break;
    case 5..8: naherSWnpc="mehrere Wilde und Krieger."; break;
    case 9..14: naherSWnpc="sehr viele Wilde und Krieger!"; break;
    default: naherSWnpc="gigantisch viele Krieger und Orks!!"; break;
  }

  return

BS("Das Schlachtfeld verlaeuft noch sehr weit nach Nordosten und "
"Suedwesten, noch weit nach Norden, Sueden und Westen. In Richtung "
"Suedosten und Nordosten hingegen endet das Feld bald, das erkennst "
"Du an den Leichen sehr gut. Im Osten sieht es sehr duester und "
"bedrohlich aus. Ein kalter Schauer laeuft Dir ueber den Ruecken. "
"Weit im Nordwesten siehst Du "+NWpl+NWnpc+", im naehreren Nordwesten, "
"Westnordwesten und Norden sind "+naherNWpl+naherNWnpc+" In grosser Entfernung "
"im Westen glaubst Du "+Wpl+Wnpc+" ausmachen zu koennen, und ganz im "
"Sueden erkennst Du "+Spl+Snpc+". Im nahen Westen, Suedwesten und Sueden "
"befinden sich "+naherSWpl+naherSWnpc);
}

void reset()
{
  ::reset();

  if(TO) WMASTER->muellschlucker(TO);
}
