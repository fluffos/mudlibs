// Schlachtfeld
// von Wraz / Mendralim
//
// Ausblick ueber das Schlachtfeld in den Details

#include "../def.h"

#define PLAYERS "players"
#define NPCs "NPCs"

inherit "std/room";

string superausblick();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes auf einer "
    "kleinen Erhebung. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut.");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen. Da Du hier auf "
    "einer kleinen Erhebung stehst, hast Du einen recht guten Ausblick "
    "ueber das gesamte Schlachtfeld.");

  AddDetail( ({"erhebung"}),
    "Sie gibt Dir die Moeglichkeit eines guten Ausblicks ueber das "
    "gesamte Schlachtfeld.");

  AddDetail( ({"moeglichkeit"}),
    "Du hast sie!");

  AddDetail( ({"ausblick", "entfernung"}), #'superausblick);
    /*"Das Schlachtfeld verlaeuft noch sehr weit nach Nordosten und "
    "Suedwesten, noch weit nach Norden, Sueden und Westen. In Richtung "
    "Suedosten und Nordosten hingegen endet das Feld bald, das erkennst "
    "Du an den Leichen sehr gut. Im Osten sieht es sehr duester und "
    "bedrohlich aus. Ein kalter Schauer laeuft Dir ueber den Ruecken.");*/

  AddDetail( ({"richtung","richtungen"}),
    "Welche?");

  AddDetail( ({"schauer","ruecken"}),
    "Du fuerchtest Dich ein wenig...");

  AddDetail( ({"nordosten"}),
    "Von dort kommst Du. Bis dahin ist es noch sehr weit.");

  AddDetail( ({"suedwesten"}),
    "In diese Richtung breitet sich das Schlachtfeld noch sehr weit aus.");

  AddDetail( ({"norden","sueden","westen"}),
    "Dort endet das Schlachtfeld in absehbarer Entfernung.");

  AddDetail( ({"osten"}),
    "Irgendetwas Bedrohliches geht von dort aus. Der Himmel in dieser "
    "Richtung sieht seltsam aus, von hier aus kannst Du aber nichts "
    "Genaueres erkennen.");

  AddDetail( ({"bedrohliches"}),
    "Du kannst es nicht definieren...");

  AddDetail( ({"genauere"}),
    "Um Genaueres zu erkennen musst Du schon weiter nach Osten gehen, wenn "
    "Du Dich traust...");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddExit( "osten", ROOM "m11" );
  AddExit( "sueden", ROOM "m14b" );
  AddExit( "suedwesten", ROOM "m14a" );
  AddExit( "westen", ROOM "m10a" );
  AddExit( "nordwesten", ROOM "m07a" );


 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "soeldner" , REFRESH_DESTRUCT);
 AddItem( NPC "kampfsoldat" , REFRESH_DESTRUCT);
 AddItem( NPC "militaer" , REFRESH_DESTRUCT);
}

int isNPC(object ob)
{
  if(!ob) return 0;
  if(!ob->QueryProp(P_NPC)) return 0;
  if(ob->id("muellschlucker")) return 0;
  if(query_once_interactive(ob)) return 0;
  else return 1;
}

mixed ausblick()
{
  object dummy;

  mapping NW;
  mapping W;
  mapping S;
  mapping naherNW;
  mapping naherSW;

  NW=allocate_mapping(2,1);
