// Schlachtfeld
// von Wraz / Mendralim
//
// Stiefel krallen ;)

#include "../def.h"

inherit "std/room";

int i;

void create()
{
  ::create();

  i=1;

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut.");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","koerperteil","beispiel"}),
   "Viele abgetrennte Koerperteile wie zum Beispiel Haende, ganze Arme und "
   "Beine, Koepfe aber auch Torsos kleben hier auf dem Boden. Dir wird "
   "schlecht...");

  AddDetail( ({"haende","hand","arme","arm","koepfe","kopf","torsos",
    "torso","leichenteil","leichenteile"}),
   "Manche sind frisch, andere bereits am verfaulen. Hier herrscht "
   "ein staendiges Gemetzel.");

  AddDetail( ({"gemetzel","opfer"}),
   "Pass auf, dass Du nicht auch ein Opfer wirst!");

  AddDetail( ({"beine","bein"}),
   "Manche sind noch frisch, andere bereits am verfaulen. Dir faellt ein "
   "abgesaebelter, blutverschmierter Fuss auf.");

  AddDetail( ({"fuss"}),
   "Er wurde knapp unterhalb des Knies abgetrennt, sodass der Stiefel, "
   "in dem er steckt, noch "
   "in Ordnung zu sein scheint.");

  AddDetail( ({"knie","ordnung","hieb"}),
   "Der Fuss wurde offensichtlich mit einem sauberen Hieb, knapp unterhalb "
   "des Knies abgetrennt. Der Stiefel ist daher nur blutverschmiert, "
   "aber nicht beschaedigt.");

  AddDetail( ({"stiefel"}),
   "Da er ekelhaft mit Blut getraenkt ist und Du ausserdem mit einem Stiefel, "
   "da Du ja momentan nicht weisst, wo der Zweite, Zugehoerige sich befindet, "
   "nichts anfaengst, willst Du ihn eigentlich gar nicht haben.");

  AddDetail( ({"zweite","zugehoerige"}),
   "Als ekelhafter Penner, wie Du halt einer bist, suchst Du gierig nach dem "
   "zweiten Stiefel, und findest ihn tatsaechlich nicht weit entfernt "
   "an dem Rest der Leiche!");

  AddDetail( ({"penner","sterblicher"}),
   "Ein normaler Sterblicher wuerde die blutverschmierten Stiefel eines Toten "
   "nicht klauen...");

  AddDetail( ({"rest"}),
   "KRALL Dir endlich die verdammten Stiefel!!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddCmd( ({ "krall","kralle" }), "cmd_krallen" );

  AddExit( "norden", ROOM "m05a" );
  AddExit( "osten", ROOM "m07b" );
  AddExit( "suedosten", ROOM "m10b" );
  AddExit( "sueden", ROOM "m10a" );
  AddExit( "suedwesten", ROOM "m10" );
  AddExit( "westen", ROOM "m07" );


 AddItem( NPC "zwergberserker" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ratte" , REFRESH_DESTRUCT);
 AddItem( NPC "ork" , REFRESH_DESTRUCT);
 AddItem( NPC "militaer" , REFRESH_DESTRUCT);
}

int cmd_krallen(string str)
{
  notify_fail("WAS willst Du Dir krallen??\n");

  if(!str || str == "") return 0;

  if(i) {
  if(str=="stiefel"||str=="dir stiefel"||str=="dir verdammten stiefel"
     ||str=="verdammte stiefel"||str=="dir verdammte stiefel")
   {
     object ob;

     TP->Message(BS(
      "Du aergerst Dich ein paar Sekunden herum, hast dann aber schliesslich "
      "der Leiche bzw. den Leichenteilen die Stiefel abgenommen."));

     i=0;
     ob=clone_object("/p/armour/boots/kampfstiefel");
     ob->SetProp(P_LONG, BS(ob->QueryProp(P_LONG)+"Sie sind ausserdem "
     "ekelhaft blutverschmiert."));

     if(ob->move(TP,M_GET)==ME_TOO_HEAVY)
      {
        TP->Message(BS(
         "Du bist ein schwacher Penner und wirfst die Stiefel daher auf den "
         "Boden."));
        ob->move(ENV(TP),M_NOCHECK);
        return 1;
       }

      else return 1;
    }
   }
   else
   {
     TP->Message(BS(
      "Du fluchst lange herum, aber die Stiefel hat Dir gerade jemand "
      "anders geklaut. Mist!"));
      return -1;
   }
}

void reset()
{
  ::reset();
  i=1;

  if(TO) WMASTER->muellschlucker(TO);
}
