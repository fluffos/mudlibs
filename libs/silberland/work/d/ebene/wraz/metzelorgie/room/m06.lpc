// Schlachtfeld
// von Wraz / Mendralim
//
// Schriftstueck lesen

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut.");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben. Einige kleinere Wolken stehen am Himmel.");

  AddDetail( ({"wolken"}),
   "Sie wehen langsam weiter. Eine Wolke sieht wie ein Schaf aus!");

  AddDetail( ({"wolke"}),
   "Sie sieht tatsaechlich aus wie ein Schaf!");

  AddDetail( ({"schaf"}),
   "Du blickst Dich um: Huch! Nicht nur die Wolke sieht so aus wie ein Schaf, "
   "gleich neben Dir steht auch eines! Ein Lamm!");

  AddDetail( ({"lamm"}),
   "Es ist echt! Vier Beine, Wolle, Kopf, ... alles da!");

  AddDetail( ({"beine"}),
   "Ein Bein sieht irgendwie kuerzer aus als die anderen.");

  AddDetail( ({"wolle"}),
   "Du streichelst kurz darueber. Wie schoen weich!");

  AddDetail( ({"kopf"}),
   "Er sieht ein bisschen dumm aus.");

  AddDetail( ({"bein"}),
   "Nein. Zu kurz ist es nicht. Hmm. Ah! Das Lamm will Dir einen Hinweis auf "
   "irgendetwas geben.");

  AddDetail( ({"hinweis"}),
   "Ein Raetsel.");

  AddDetail( ({"raetsel"}),
   "Nein, kein Raetsel. Du verstehst nur nicht, was das Lamm will. Vielleicht "
   "meint es ja das blutige Schriftstueck da.");

  AddDetail( ({"schriftstueck"}),
   "Du kannst versuchen, es zu lesen!");

  AddReadDetail( ({"schriftstueck"}),
   "Es ist ziemlich blutverschmiert, aber Du versuchst es trotzdem zu lesen:\n"
   "\n..gemu.iger ..ieger!\n"
   "..... um, .ola.ge .s ..c.t ....pa.t i....Wen. Du den ....g.... tr.ffst, "
   "..h. A.F KE.NEN F.LL we.ter! Al.e meine Kameraden, ....ke.....e...r, "
   "kl.ge .ruiden ..d ...b.lische Nekr....ten v..suchte. ..c. .. ..m "
   "P.ad de. TOD.S, ..er .ei.er .st zu.u.ck.e..hrt. Be..r .un .ch als "
   "le.zer gehe, .i.terlasse ... ..... .m a.le an...en .u W.RNEN, d.mit "
   "s.e n..ht da. gl....e S.hicksa. e...lt ..e ...ne K.me.a..., u.d ..ld "
   "a.c. m.ch!\n\n"
   "Das sind ja tolle Aussichten...");

  AddDetail( ({"koerperteile","teile","koerperteil",
    "leichenteile","leichenteil"}),
   "Sie verwesen! Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddExit( "nordwesten", ROOM "m03" );
  AddExit( "norden", ROOM "m04" );
  AddExit( "nordosten", ROOM "m05" );
  AddExit( "osten", ROOM "m07" );
  AddExit( "suedosten", ROOM "m10" );
  AddExit( "sueden", ROOM "m09" );
  AddExit( "suedwesten", ROOM "m08" );

  AddItem( NPC "soeldner" , REFRESH_DESTRUCT);
  AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
  AddItem( NPC "militaer" , REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();

  if(TO) WMASTER->muellschlucker(TO);
}
