// Pfad 05
// Wraz / Mendralim
// Druide
// Schnapsflasche aufheben

#include "../def.h"

inherit ROOM "pfad.lpc";

int wache();
int rwache();
int i;

void create()
{
  ::create();

  i=1;

  SetProp(P_INT_SHORT, "Ein Pfad beim Schlachtfeld");
  SetProp(P_INT_LONG,
    "Viele Baeume und Straeucher ueberwuchern den erdigen Pfad, auch das "
    "Gras waechst hier noch hoeher. Der Himmel erstrahlt in einem dunklen "
    "Rot, frei von Wolken strahlt die Sonne schwach auf Dich herab. "
    "Die Stimmung ist hoechst angsteinfloessend!");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"stimmung", "angst"}),
   "Alles hier macht Dir Angst!");

  AddDetail( ({"angst","irgendetwas", "tatsache","sorgen"}),
   "Die Tatsache, dass hier ploetzlich niemand mehr ist, macht Dir Sorgen. "
   "Warum trauen sich selbst die todesmutigen Krieger nicht hierher?");

  AddDetail( ({ "boden", "gras", "zwerg" }),
    "Das Gras ist hier schon so hoch, dass ein kleiner Zwerg wohl fast nicht "
    "mehr darueber hinweg sehen kann.");

  AddDetail( ({"pfad", "osten"}),
    "Der Pfad fuehrt weiter nach Osten. Wer weiss, was Dich dort "
    "erwartet...");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Hier ist kein Blut mehr.");

  AddDetail( ({"himmel", "sonne", "rot"}),
   "Er ist hier noch immer blutrot gefaerbt. Keine Wolke verdeckt ihn, die "
   "Sonne strahlt trotzdem nur schwach.");

  AddDetail( ({"wolke","wolken"}),
   "Wolke ist hier keine. Aber ein bisschen nebelig ist es.");

  AddDetail( ({"nebel"}),
   "Der Nebel truebt ein bisschen die Sicht.");

  AddDetail( ({"sicht"}),
   "Du zwinkerst kurz und schaust Dich etwas genauer um. Hey! Da liegt eine "
   "Flasche Schnaps!");

  AddDetail( ({"flasche","schnaps"}),
   "Zuerst hast Du sie nicht erkannt. Heb sie auf!");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es ist weiter im Westen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Die Baeume und Straeucher wuchern hier ueppig ueber den Pfad.");

  AddDetail( ({"silberland", "krieger"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Hmm. Nichtmal die Ratten laufen noch hier herum. Seltsam.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Sie kommen vom Schlachtfeld.");

  AddSound( ({"schlachtfeld"}),
   "Die Schreie kommen eindeutig von dem Schlachtfeld.");

  AddSound( ({"todesschreie", "entsetzen"}),
   "Man hoert ihnen das Entsetzen an!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier gefaehrlich!!");

  AddRoomMessage(
    ({"Es ist hier bedrohlich still.\n",
    "Warum ist hier niemand mehr?\n",
    "Du hoerst Todesschreie aus einiger Entfernung.\n"}),50+random(23));

  SUID;

  AddExit( "osten", ([EX_DEST: ROOM "p06",
                      EX_TESTFUNC: #'wache,
                      EXG_ID:  "\nwache",
                      EXG_PLMSG: "Der Druide trifft Dich mit seinem Blick "
                      "wie ein Blitz! Er will also doch kaempfen und wird "
                      "Dich bestimmt nicht passieren lassen!\n",
                      EXG_RMMSG: "Der Druide laesst @wen@ nicht "
                      "passieren.\n"]) );

  AddExit( "suedwesten",  ([EX_DEST: ROOM "p04",
                            EX_TESTFUNC: #'rwache,
                            EXG_ID:  "\nwache",
                            EXG_PLMSG: "Der Druide trifft Dich mit seinem Blick "
                            "wie ein Blitz! Er will also doch kaempfen und wird "
                            "Dich bestimmt nicht passieren lassen!\n",
                            EXG_RMMSG: "Der Druide laesst @wen@ nicht "
                            "passieren.\n"]) );

  AddCmd( ({"heb","hebe"}), "cmd_heben");

}
int wache()
{
  return 1;
}

int cmd_heben(string str)
{
  notify_fail("Was willst Du aufheben?\n");

  if(!str||str=="") return 0;

  if(str=="flasche auf"||str=="schnaps auf"||str=="schnapsflasche auf")
  {
    if(TP->InFight())
    {
      write(BS(
        "Du bist viel zu abgelenkt!"));
      return -1;
    }


  if ( deep_present( "\nwrazschnapsflasche" , TP ) )
    {
      write(BS("Du versuchst die Schnapsflasche aufzuheben, doch die Flasche, welche "
        "Du bereits bei Dir traegst fliegt auf einmal, von unheiliger Kraft gelenkt, "
        "herum, und hindert Dich daran, die andere Flasche von dem Boden aufzuheben. "
        "Diese Flaschen scheinen seltsam verflucht zu sein, sodass Du nur eine mit Dir "
        "tragen kannst."));
      return -1;
    }

    if(i)
    {
      object ob;
      ob=clone_object(OBJ "schnaps");

      if(ob->move(TP,M_GET)==ME_TOO_HEAVY)
      {
        TP->Message(BS(
         "Die Flasche ist Dir zu schwer, Du laesst sie liegen."));
        ob->remove(1);
        return -1;
      }

      else
      {
        TP->Message(BS(
         "Du hebst die Flasche auf und steckst sie ein."));
        ENV(TP)->Messag(BS(
         TPN+" hebt eine Flasche Schnaps auf."),MSGFLAG_NO_TP);
         i=0;
        return 1;
      }
    }

    else
    {
      TP->Message(BS(
       "Die Flasche ist leer, Du laesst sie liegen."));
      return -1;
    }
  }
}

void reset()
{
 ::reset();
 i=1;
}

void init()
{
  ::init();

  WMASTER->carries_food(TP);

  if(query_once_interactive(TP)) return;
  if(!TP->QueryProp(P_NPC)) return;

  if(TP->QueryProp(P_UID)=="d.wasser.stahldorn"&&
     TP->id("daemon"))
  {
    tell_room(TO,BS(
      "Der Daemon verschwindet einfach wieder."));
    TP->remove(1);
    return;
  }
}

void call_move_corpse(object player)
{
  WMASTER->move_corpse(player,TO);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  pfad::NotifyPlayerDeath(player, killer, lostexp);
  call_out("call_move_corpse",0,player);
}
