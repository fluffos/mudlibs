// Pfad 02 Schlachtfeld
// Wraz / Mendralim
// Lehmgolem
// Zugang zur Schattenwelt als Geist moeglich von hier aus

#include "../def.h"

inherit "std/room";

int wache();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Pfad beim Schlachtfeld");
  SetProp(P_INT_LONG,
    "Viele Baeume und Straeucher ueberwuchern den erdigen Pfad, auch das "
    "Gras waechst hier noch hoeher. Der Himmel erstrahlt in einem dunklen "
    "Rot, frei von Wolken strahlt die Sonne schwach auf Dich herab. "
    "Die Stimmung ist hoechst angsteinfloessend!");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"stimmung", "angst"}),
   "Alles hier macht Dir Angst!");

  AddDetail( ({"angst","irgendetwas", "tatsache","sorgen"}),
   "Die Tatsache, dass hier ploetzlich niemand mehr ist, macht Dir Sorgen. "
   "Warum trauen sich selbst die todesmutigen Krieger nicht hierher?");

  AddDetail( ({ "boden", "gras", "zwerg" }),
    "Das Gras ist hier schon so hoch, dass ein kleiner Zwerg wohl fast nicht "
    "mehr darueber hinweg sehen kann.");

  AddDetail( ({"pfad", "kurve"}),
    "Er macht hier eine scharfe Kurve und fuehrt weiter nach Nordwesten. "
    "Du bist Dir aber nicht sicher, ob Du "
    "wirklich weiter gehen willst...");

  AddDetail( ({"nordwesten"}),
    "Ein urploetzliches Gefuehl des TODES ueberwaeltigt Dich! Du bist Dir "
    "sicher, dass Du nicht mehr umkehren kannst, wenn Du erst einmal "
    "weiter gegangen bist! Und Du fuehlst, dass Du ein Held bist, wenn "
    "Du es doch tust ... und als Held wirst Du sterben!");

  AddDetail( ({"held"}),
    "Du kannst es versuchen! Niemand wird Dir im Kampf zur Seite stehen, "
    "und umso ruehmlicher wird Dein TOD!");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Hier ist kein Blut mehr.");

  AddDetail( ({"himmel", "sonne", "wolken", "wolke", "rot"}),
   "Er ist hier noch immer blutrot gefaerbt. Keine Wolke verdeckt ihn, die "
   "Sonne strahlt trotzdem nur schwach.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es ist weiter im Westen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Die Baeume und Straeucher wuchern hier ueppig ueber den Pfad.");

  AddDetail( ({"silberland", "krieger"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Hmm. Nichtmal die Ratten laufen noch hier herum. Seltsam.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Sie kommen vom Schlachtfeld.");

  AddSound( ({"schlachtfeld"}),
   "Die Schreie kommen eindeutig von dem Schlachtfeld.");

  AddSound( ({"todesschreie", "entsetzen"}),
   "Man hoert ihnen das Entsetzen an!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Gefahr!");

  AddSmell( ({"gefahr"}),
    "Du kannst sie riechen! Eine besondere Gefahr geht vom Reich der Netztoten "
    "aus.");

  AddSmell( ({"reich", "netztote", "reich der netztoten",
  "netztotenreichgeruch","hauch"}),
  "Der Geruch aus dem Reich der Netztoten ist Dir wohl bekannt. Vom Pfad aus "
  "Richtung Nordwesten stroemt Dir ein Hauch des Netztotenreichgeruchs "
  "entgegen, gemischt mit einer giftigen Duftnote. Ein Schauer "
  "ueberkommt Dich... ");

  AddSmell( ({"gift","duftnote"}),
  "Du schnupperst der giftigen Duftnote noch einmal nach. Deine Intuition "
  "sagt Dir, dass, solltest Du Dich weiter auf den Pfad wagen, der Weg "
  "ins Reich der Netztoten unangenehme Folgen haben koennte, solltest Du "
  "ihn aus Feigheit antreten, um mit fremder Hilfe dem unausweichlichen "
  "TOD zu entgehen!");

  AddSmell( ({"feigheit","angst","angstschweiss","schweiss"}),
  "Du riechst Deinen eigenen, ekelhaften Angstschweiss scharf in Deiner "
  "Nase. Er riecht wuerzig. Du beschliesst, eher wie eine Frau, ein Mann "
  "oder eines anderen Geschlechtes zu sterben, als feige zu fliehen!");

  AddSmell( ({"frau","mann","geschlecht"}),
  "Der Gedanke an den Geruch laesst lebhafte Erinnerungen und Fantasien "
  "leidenschaftlicher Abenteuer in Dir aufkommen. Entschlossen blickst "
  "Du nach Nordwesten, den TOD erwartend!");

  AddRoomMessage(
    ({"Es ist hier bedrohlich still.\n",
    "Warum ist hier niemand mehr?\n",
    "Du hoerst Todesschreie aus einiger Entfernung.\n"}),100+random(23));

  SUID;

  AddExit( "westen", ROOM "p01" );
  AddExit( "nordwesten",  ([EX_DEST: ROOM "p03",
                            EX_TESTFUNC: #'wache]) ); //'

  AddItem( NPC "lehmgolem" , REFRESH_DESTRUCT);

  SetProp("last_reset_time", time());
  SetProp("next_reset_time", time());
}

int wache()
{
  object dummy;
  object death_mark;
  string room;

  // Eingang zur Schattenwelt als Geist
  if(/*TP->QueryProp(P_GHOST) &&*/ // pruefen ob Geist die schatten deathmark hat
    // temporaer deaktiviert, da manche Spieler ohne zu beten lebendig werden, Grund unbekannt
    sizeof(filter_objects(all_inventory(TP),"id","\nshadow_deathmark")) >= 1) 
  {
    death_mark = filter_objects(all_inventory(TP),"id","\nshadow_deathmark")[0];
    if(death_mark->QueryProp("shadow_death_room_file_name")) 
      room = death_mark->QueryProp("shadow_death_room_file_name");
    else room = SCHATTEN "room/sn000";

    // Raum ggf. erzeugen:
    SCHATTEN "master/room_master"->write_next_room(SCHATTEN + "room/sn" + 
      SCHATTEN "master/room_master"->get_lead_zeros(death_mark->QueryProp("shadow_death_room_no")));

    TP->Message("\n"+BS(
      "Ein schattiges Etwas ueberkommt Dich urploetzlich, saugt Dich auf und "
      "spuckt Dich an einem schattigen Ort wieder aus.")+"\n");
    TP->move(room,M_GO,"aufgesogen und verschwindet",
      "wird von eimem schattigen Etwas","wird von eimem schattigen Etwas ploetzlich ausgespuckt");

    if(!TP->QueryProp(P_GHOST))
    {
      TP->Message("\n"+BS(
        "Waehrend des Uebergangs wird Dein Koerper von Schatten eingehuellt und transformiert. "
        "Du bist nun ein Geist.")+"\n");
      TP->SetProp(P_GHOST,1);
    }
    return 0;
  }

  if(!present("\nwache")) // kein golem da -> duerfen alle
  {
    WMASTER->carries_food(TP);
    WMASTER->set_status("inside",1,lower_case(TPN));
    return 1;
  }

  if(!WMASTER->query_inside() ) // wert 0 -> keiner drin -> darfst
  {
    WMASTER->carries_food(TP);
    WMASTER->set_status("inside",1,lower_case(TPN));
    return 1;
  }

  // player nicht da -> keiner drin -> darfst
  else if(!dummy=find_player(WMASTER->query_who_inside()) )
  {
    WMASTER->carries_food(TP);
    WMASTER->set_status("inside",1,lower_case(TPN));
    return 1;
  }

  // player irgendwie rausgekommen -> der darf
  else if(WMASTER->query_who_inside()==lower_case(TPN))
  {
    WMASTER->carries_food(TP);
    WMASTER->set_status("inside",1,lower_case(TPN));
    return 1;
  }

  else if(strstr(file_name(ENV(dummy)), // player irgendwie rausgekommen und nicht
                 ROOM "p") < 0 ||       // am Pfad (alle files die mit ROOM "p" beginnen)
          strstr(file_name(ENV(dummy)), // ODER player steht ausserhalb vom
                 ROOM "p01") >= 0)      // pfad (naemlich genau in p01) -> darfst
  {
    WMASTER->carries_food(TP);
    WMASTER->set_status("inside",1,lower_case(TPN));
    return 1;
  }

  else if(!WMASTER->query_last_wache())
  {
    TP->Message(BS(
      "Der Lehmgolem laesst Dich nicht passieren."));
    return 0; }

  else { // sonst nicht :)
    TP->Message(BS(
      "Der Lehmgolem laesst Dich nicht passieren."));
    return 0; }
}

void KeepAlive() { return; }

void reset()
{
  int shortened_reset_interval;
  int default_reset_interval;
  int current_reset_interval;

  shortened_reset_interval = 300; // 5 Minuten (weniger hat keinen Sinn wg. Gamedriver reset-Intervall)
  default_reset_interval = 30*60+random(30*60); // "normale" Resetzeit (45 +/- 15 Minuten)
  current_reset_interval = default_reset_interval;
  
  DB(BS(dtime()[19..26]+" Pfad 02: Reset wird ausgefuehrt, dtime()[5..11] = "+dtime()[5..11]));
  // Haeufigerer Pfad-Reset
  switch(dtime()[5..11])
  {
    case "21. Dez": // Wintersonnwende
      if(TO) TO->Message(BS("Die Sonne strahlt heute noch schwaecher als sonst."));
      current_reset_interval = shortened_reset_interval;
      break;
    case "24. Dez": // Weihnachten
    case "25. Dez":
    case "26. Dez":
      if(TO) TO->Message(BS("Ein leuchtendes Engelchen flitzt kurz vorbei!"));
      current_reset_interval = shortened_reset_interval;
      DB(BS("Weihnachten reset time"));
      break;
    case " 1. Jan": // Neujahr
      if(TO) TO->Message(BS("Der Pfad wuenscht Dir ein gutes, neues Jahr."));
      current_reset_interval = shortened_reset_interval;
      DB(BS("Neujahr reset time"));
      break;
    case "16. Feb": // Hihi Geburtstag
      if(TO) TO->Message(BS("Zur Feier des Geburtstags des Pfadmeisters!"));
      current_reset_interval = shortened_reset_interval;
      break;
    case "18. Feb": // Wraz Geburtstag
      if(TO) TO->Message(BS("Der maechtige Wraz spendiert zur Feier seines Geburtstags einen vollen Pfad."));
      current_reset_interval = shortened_reset_interval;
      break;
    case "12. Mar": // Geburtstag!
      if(TO) TO->Message(BS("Zur Feier des Tages!"));
      current_reset_interval = shortened_reset_interval;
      break;
    case "20. Mar": // Fruehlingsbeginn
      if(TO) TO->Message(BS("Ein Voegelchen zwitschert den Fruehlingsbeginn."));
      current_reset_interval = shortened_reset_interval;
      break;
    case " 1. Apr": // SL Feiertag
      if(TO) TO->Message(BS("April, April!"));
      current_reset_interval = shortened_reset_interval;
      break;
    case " 1. Mai": // Feiertag
      if(TO) TO->Message(BS("Der Pfad verrichtet seine Arbeit."));
      current_reset_interval = shortened_reset_interval;
      break;
    case "21. Jun": // Sommersonnwende
      if(TO) TO->Message(BS("Die Sonne strahlt heute etwas heller als sonst hier."));
      current_reset_interval = shortened_reset_interval;
      break;
    case "23. Sep": // Herbstbeginn
      if(TO) TO->Message(BS("Laub faellt von den Baeumen und verfaerbt sich."));
      current_reset_interval = shortened_reset_interval;
      break;
    case "31. Okt": // Halloween
      if(TO) TO->Message(BS("Es spukt am Pfad."));
      current_reset_interval = shortened_reset_interval;
      break;
    default:
      if (QueryProp("pfadresetday") > 0) // Per SetProp
        {
          if(TO) TO->Message(BS("Der maechtige Wraz spendiert einen vollen Pfad!"));
          current_reset_interval = shortened_reset_interval;
          SetProp("pfadresetday", QueryProp("pfadresetday") - 1);
        }
      DB(BS("default reset time"));
      break;
  }
  
  if(current_reset_interval == shortened_reset_interval)
  {
    SetProp("current_reset_interval", "shortened");
    call_out("KeepAlive",0);
  }
  else SetProp("current_reset_interval", "default");
  SetProp("next_reset_time", time()+current_reset_interval);

  set_next_reset(current_reset_interval);
  
  ::reset();
}

void init()
{
  ::init();
  if(QueryProp("current_reset_interval") == "shortened" &&
    time() > QueryProp("next_reset_time") + 2 &&
    find_call_out("reset") == -1)
    {
      DB(BS(dtime()[19..26]+" Pfad 02: Reset wird per call_out ausgefuehrt"));
      call_out("reset", random(15));
    }
}