// Schlachtfeld
//
// von Wraz / Mendralim
//
// Ein Finger unter einem Felsklotz, Schlachtruf

#include "../def.h"

inherit "std/room";

string cmd_schlachtruf();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft. Ein grosser Felsklotz liegt hier am "
    "Boden.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut. Ein grosser "
    "Felsklotz liegt auch da.");

  AddDetail( ({"felsklotz", "klotz"}),
    "Unter dem Felsklotz schaut ein Finger hervor! Wie ist das moeglich, "
    "niemand kann so stark sein, um diesen Klotz zu heben!");

  AddDetail( ({"finger"}),
    "Vielleicht wurde der Finger aber auch abgerissen und liegt so da, "
    "dass es nur so aussieht, als waere der Rest noch dran. "
    "Es gibt nur eine Moeglichkeit das heraus zu finden...");

   AddDetail( ({"rest"}),
    "Zum Finger gehoert ein Koerper.");

  AddDetail( ({"moeglichkeit"}),
    "Du musst an dem Finger ziehen...");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt! Du meochtest "
  "unbedingt einen Schlachtruf ausstossen!");


  AddDetail( ({"schlachtruf"}), #'cmd_schlachtruf); //'

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddDetail( ({"angst"}),
   "Hier lauft irgendjemand, oder besser gesagt irgendetwas herum, dass stark "
   "genug ist, einen Felsklotz zu heben mit dem man eine Stadtmauer "
   "einreissen koennte!");

  AddDetail( ({"stadtmauer"}),
   "Wuah, Du willst gar nicht daran denken, was der mit Dir machen koennte.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ekelhaft!");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddCmd("ziehe|zieh&an&finger",
         "cmd_ziehen",
         "AN was willst Du ziehen?|An WAS willst Du ziehen?");

  AddExit( "westen", ROOM "m12" );
  AddExit( "nordwesten", ROOM "m08" );
  AddExit( "norden", ROOM "m09" );
  AddExit( "osten", ROOM "m14" );
  AddExit( "suedosten", ROOM "m25" );
  AddExit( "sueden", ROOM "m24" );
  AddExit( "suedwesten", ROOM "m23" );

  AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
  AddItem( NPC "militaer" , REFRESH_DESTRUCT);
  AddItem( NPC "militaer" , REFRESH_DESTRUCT);
  AddItem( NPC "ork" , REFRESH_DESTRUCT);

  AddCmd("stoss|stosse&schlachtruf&aus", "cmd_schlachtruf2",
         "Was willst Du ausstossen?|Was willst Du AUSstossen?");
}

string cmd_schlachtruf()
{
  if(TP->QueryProp(P_GUILD)!="berserker")
   return BS("Da Du kein Berserker bist kannst Du das aber leider nicht "
   "machen.");

  else if(TP->QueryProp(P_GUILD_LEVEL)<9)
   return BS("Ueb fleissig weiter und bald kannst Du Dir diesen Wunsch "
   "erfuellen!");

  else return BS("Na los, mach!");
}

int cmd_schlachtruf2()
{
  if(TP->QueryProp(P_GUILD)!="berserker")
  {
   write(BS("Da Du kein Berserker bist kannst Du das leider nicht "
   "machen."));
   return 1;
  }

  else if(TP->QueryProp(P_GUILD_LEVEL)<9)
  {
   write( BS("Ueb fleissig weiter und bald kannst Du Dir diesen Wunsch "
   "erfuellen!"));
   return 1;
  }

  else
  {
   TP->command_me("schlachtruf");
   return 1;
  }
}
int cmd_ziehen(string str)
{
  if(!str || str == "") return 0;

  TP->Message(BS(
   "Mit grosser Ueberwindung und Todesverachtung nimmst Du den Finger in "
   "die Hand und ziehst daran... Widerstand... er haengt. IGITT!! Jetzt "
   "hat er gezuckt, er kann noch nicht so lange tot sein. Das macht Dir "
   "irgendwie Angst..."));

  return 1;
}

void reset()
{
  ::reset();

  if(TO) WMASTER->muellschlucker(TO);
}
