// Pfad 06
// Wraz / Mendralim
// Zechi
// Pflanze fressen

#include "../def.h"

inherit ROOM "pfad.lpc";

int wache();
int rwache();
int i;

void create()
{
  ::create();

  i=1;

  SetProp(P_INT_SHORT, "Ein Pfad beim Schlachtfeld");
  SetProp(P_INT_LONG,
    "Viele Baeume und Straeucher ueberwuchern den erdigen Pfad, auch das "
    "Gras waechst hier noch hoeher. Der Himmel erstrahlt in einem dunklen "
    "Rot, frei von Wolken strahlt die Sonne schwach auf Dich herab. "
    "Die Stimmung ist hoechst angsteinfloessend!");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"stimmung", "angst"}),
   "Alles hier macht Dir Angst!");

  AddDetail( ({"angst","irgendetwas", "tatsache","sorgen"}),
   "Die Tatsache, dass hier ploetzlich niemand mehr ist, macht Dir Sorgen. "
   "Warum trauen sich selbst die todesmutigen Krieger nicht hierher?");

  AddDetail( ({ "boden", "gras", "zwerg" }),
    "Das Gras ist hier schon so hoch, dass ein kleiner Zwerg wohl fast nicht "
    "mehr darueber hinweg sehen kann.");

  AddDetail( ({"pfad", "sueden"}),
    "Der Pfad fuehrt weiter nach Sueden. Wer weiss, was Dich dort "
    "erwartet...");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Hier ist kein Blut mehr.");

  AddDetail( ({"himmel", "sonne", "wolken", "wolke", "rot"}),
   "Er ist hier noch immer blutrot gefaerbt. Keine Wolke verdeckt ihn, die "
   "Sonne strahlt trotzdem nur schwach.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es ist weiter im Westen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Die Baeume und Straeucher wuchern hier ueppig ueber den Pfad.");

  AddDetail( ({"silberland", "krieger"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Hmm. Nichtmal die Ratten laufen noch hier herum. Seltsam.");

  AddDetail( ({"richtung"}),
   "Du hast das Eichhoernchen direkt angestarrt, und da ist es gefluechtet.");

  AddDetail( ({"eichhoernchen"}),
   "Das ist schon lange weg!");

  AddDetail( ({"hecke"}),
   "Vor der Hecke waechst ein Kraut.");

  AddDetail( ({"kraut"}),
   "Du kennst es nicht, aber es sieht so aus, als waere es ein Heilkraut.");

  AddDetail( ({"heilkraut"}),
   "Wunderschoene, blaue Blueten und lange, seidig dunkelgruene Blaetter.");

  AddDetail( ({"blueten"}),
   "Wundervoll blau!");

  AddDetail( ({"blaetter"}),
   "Samtseidig und elegant dunkelgruen! Du willst das Kraut ausrupfen!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Sie kommen vom Schlachtfeld.");

  AddSound( ({"schlachtfeld"}),
   "Die Todesschreie kommen eindeutig von dem Schlachtfeld.");

  AddSound( ({"todesschreie", "entsetzen"}),
   "Man hoert ihnen das Entsetzen an! Hinter Dir hoerst Du ein Knacken.");

  AddSound( ({"knacken"}),
   "Jetzt ist es ein Rascheln.");

  AddSound( ({"rascheln"}),
   "Hey! Da sitzt ja ein Eichhoernchen in einer Hecke! Als es bemerkt, dass "
   "Du in seine Richtung starrst, laeuft es davon. Schade!");

  AddSound( ({"hecke"}),
   "Hoeren kannst Du diese nicht...");

  AddSound( ({"eichhoernchen"}),
   "Das ist schon laengst fort!");

  AddSound( ({"richtung"}),
   "Hoeren kannst Du das nicht.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier gefaehrlich!!");

  AddRoomMessage(
    ({"Es ist hier bedrohlich still.\n",
    "Warum ist hier niemand mehr?\n",
    "Du hoerst Todesschreie aus einiger Entfernung.\n"}),50+random(23));

  SUID;

  AddExit( "sueden", ([EX_DEST: ROOM "p07",
                      EX_TESTFUNC: #'wache,
                      EXG_ID:  "\nwache",
                      EXG_PLMSG: "Der Zechpreller lallt: Nene, <Hicksch> "
                      "Du bleibsch schoen brav da!\n",
                      EXG_RMMSG: "Der Zechpreller laesst @wen@ nicht "
                      "passieren.\n"]) );

  AddExit( "westen",  ([EX_DEST: ROOM "p05",
                            EX_TESTFUNC: #'rwache,
                            EXG_ID:  "\nwache",
                            EXG_PLMSG: "Der Zechpreller lallt: Nene, <Hicksch> "
                            "Du bleibsch schoen brav da!\n",
                            EXG_RMMSG: "Der Zechpreller laesst @wen@ nicht "
                            "passieren.\n"]) );

  AddCmd("rupfe|rupf|reisse|reiss&kraut|heilkraut&aus",
         "cmd_ausrupfen",
         "Was willst Du ausrupfen?|Willst Du das AUS rupfen?");
  AddCmd( "iss", "cmd_essen");
}
int wache()
{
  return 1;
}

int cmd_ausrupfen()
{
    if(TP->InFight())
    {
      write(BS(
        "Du bist viel zu abgelenkt!"));
      return -1;
    }

  TP->Message(BS(
    "Du zerrst verzweifelt an dem Kraut herum, aber es laesst sich nicht "
    "aus dem Erdreich loesen. Iss es halt gleich!"));
  ENV(TP)->Message(BS(
    TPN+" zerrt vergebens an einer Pflanze."),MSGFLAG_NO_TP);
  return 1;
}

int cmd_essen(string str)
{
  notify_fail("Was willst Du essen?\n");

  if(!str||str=="") return 0;

  if(str=="kraut"||str=="heilkraut")
  {
    if(TP->InFight())
    {
      write(BS(
        "Du bist viel zu abgelenkt!"));
      return -1;
    }

    if(i)
    {
      TP->Message(BS(
        "Du kniest Dich vor das Kraut und beginnst es zu fressen, wie eine "
        "Kuh das Gras weidet... Aber es schmeckt - sogar sehr lecker!"));

      ENV(TP)->Message(BS(
        TPN+" frisst eine Pflanze vom Boden, wie ein Tier!"),MSGFLAG_NO_TP);
      if(!WMASTER->query_schlaechter())
        clone_object( OBJ "pfadpflanzebonus" ) -> move( TP, M_NOCHECK );
      TP->UpdateAttributes();
      TP->AddHp(300);
      TP->AddSp(400);
      if(TP->QueryProp(P_GUILD) != "zechpreller") TP->drink_alcohol(-(5+random(30)));
      i=0;
      return 1;
    }

    else
    {
      TP->Message(BS(
        "Du frisst das Kraut vom Boden, aber es schmeckt einfach nur zum "
        "speiben!"));
      return -1;
    }
  }
}

void reset()
{
 ::reset();
 i=1;
}

void init()
{
  ::init();

  WMASTER->carries_food(TP);

  if(query_once_interactive(TP)) return;
  if(!TP->QueryProp(P_NPC)) return;

  if(TP->QueryProp(P_UID)=="d.wasser.stahldorn"&&
     TP->id("daemon"))
  {
    tell_room(TO,BS(
      "Der Daemon verschwindet einfach wieder."));
    TP->remove(1);
    return;
  }
}

void call_move_corpse(object player)
{
  WMASTER->move_corpse(player,TO);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  pfad::NotifyPlayerDeath(player, killer, lostexp);
  call_out("call_move_corpse",0,player);
}
