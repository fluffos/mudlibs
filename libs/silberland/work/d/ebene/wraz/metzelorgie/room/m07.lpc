// Schlachtfeld
//
// von Wraz / Mendralim
//
// Da gibts in einem Strauch irgendeine Waffe

#include "../def.h"

inherit "std/room";

int i;

void create()
{
  ::create();

  i=0;

  SetProp(P_INT_SHORT, "Ein Schlachtfeld");
  SetProp(P_INT_LONG,
    "Du stehst hier inmitten eines grossen Schlachtfeldes. Man sagt, hier "
    "treffen sich die wildesten und blutruenstigsten Krieger des "
    "Silberlandes, nur um ihre Kampfgier und Blutlust zu stillen. "
    "Am Boden liegen viele Leichen, Blut klebt an allen Ecken und "
    "Enden. Einfach ekelhaft.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17,
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Er ist voller Leichen, Koerperteile und Blut.");

  AddDetail(( {"leichen","leiche","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Das Blut ist hier ueberall verteilt!");

  AddDetail( ({"ecken","ecke","enden","ende"}),
   "An allen Ecken und Enden klebt hier BLUUUT!!");

  AddDetail( ({"kampfgier","gier","blutlust","kampflust"}),
  "Du spuerst wie die Kampflust in Dir aufkommt!");

  AddDetail( ({"himmel"}),
   "Er ist blutrot gefaerbt, als wuerde das Blut bis zu ihm spritzen und "
   "kleben bleiben.");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso", "koerperteil", "leichenteile","leichenteil"}),
   "Arme, Beine, Koepfe, Torsos. Waeaeae!");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es sieht genau so aus: ueberall liegen Leichen und Koerperteile, Blut "
    "klebt an ihnen und sogar den wenigen Baeumen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Selbst die wenigen Baeume und Straeucher hier sind blutbefleckt.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger, welche frueher vielleicht als Soldaten "
    "gedient haben und wegen gewissen Vorfaellen entlassen wurden, kommen "
    "hierher um sich abzuschlachten.");

  AddDetail( ({"vorfaelle", "verhalten", "morde"}),
    "Gewalttaetiges Verhalten, Morde, ...");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Sie laufen hier ueberall herum und nagen die Leichenteile an!");

  AddDetail( ({"waffe"}),
   "Hol sie Dir, wenn Du Dich dazu ueberwinden kannst.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Oh nein! Manche hier am Boden leben ja noch!");

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Faeule!");

  AddSmell( ({"faeule","geruch"}),
    "Der Geruch kommt von einem Baum.");

  AddSmell( ({"baum"}),
    "Der Baum riecht nach Faeule. Du weisst nicht warum, er sieht ganz normal "
    "aus, dennoch riecht er ekelhaft. Vielleicht stammt der Geruch aber auch "
    "von dem Strauch davor.");

  AddSmell( ({"strauch"}),
    "WUARGS! Als Du herumschnueffelst, entdeckst Du eine stark verweste "
    "Leiche in ihm. Sie haelt noch eine Waffe in der Hand.");

  AddSmell( ({"waffe"}),
    "Die Waffe stinkt! Schau sie Dir lieber an.");

  AddSmell( ({ "leiche" }),
    "WAEAEAEAEAE!!!");

  AddRoomMessage(
    ({"Ein Koerper zuckt!\n",
    "Jemand stoehnt sterbend.\n",
    "Eine Ratte nagt an einem toten Koerperteil.\n",
    "Es stinkt hier ekelhaft nach Toten.\n"}),30+random(23));

  AddCmd( ({ "hole","hol" }), "cmd_holen" );

  AddExit( "norden", ROOM "m05" );
  AddExit( "westen", ROOM "m06" );
  AddExit( "sueden", ROOM "m10" );
  AddExit( "suedwesten", ROOM "m09" );
  AddExit( "nordwesten", ROOM "m04" );
  AddExit( "osten", ROOM "m07a" );
  AddExit( "suedosten", ROOM "m10a" );


  AddItem( NPC "zwergberserker" , REFRESH_DESTRUCT);
  AddItem( NPC "bogenschuetze" , REFRESH_DESTRUCT);
  AddItem( NPC "militaer" , REFRESH_DESTRUCT);
}

int cmd_holen(string str)
{
  object ob;
  string *arr, dir;
  int wraz_lag_verhinderer;
  wraz_lag_verhinderer=0;

  notify_fail("Was willst Du holen?\n");

  if(!str || str == "") return 0;

  if(str=="waffe"||str=="waffe aus strauch"||str=="waffe aus hand"||
  str=="waffe von leiche"||str=="waffe von leiche in strauch")
  {
    if(!i) { i=1;
    TP->Message(BS(
      "Du haeltst Dir die Nase zu und ziehst mit Todesverachtung die "
      "Waffe aus der Hand des Toten und wirfst sie auf den Boden."));
    ENV(TP)->Message(BS(
      TPN+" holt etwas aus einem Strauch."),MSGFLAG_NO_TP);

      do {
      	wraz_lag_verhinderer++;
      	if(wraz_lag_verhinderer>10) break; // ;)
      switch(random(4))
      {
        case 0:
        arr=get_dir("/p/weapon/club/*");
        dir="/p/weapon/club/";
        break;
        case 1:
        arr=get_dir("/p/weapon/knife/*");
        dir="/p/weapon/knife/";
        break;
        case 2:
        arr=get_dir("/p/weapon/sword/*");
        dir="/p/weapon/sword/";
        break;
        default:
        arr=get_dir("/p/weapon/axe/*");
        dir="/p/weapon/axe/";
        break;
      } }
      while
      (!ob=clone_object(dir+arr[3+random(sizeof(arr)-3)]));

    if( ob->QueryProp(P_WC) > 200 )
    {
      ob->remove(1);
      ob=clone_object("/p/weapon/club/holzstock");
    }

    ob->move(ENV(TP),M_NOCHECK);
    return 1;
   }
   else {
     TP->Message(BS("Da ist doch nichts."));
     return -1; }
  }
}

void reset()
{
  ::reset();
  i=0;

  if(TO) WMASTER->muellschlucker(TO);
}
