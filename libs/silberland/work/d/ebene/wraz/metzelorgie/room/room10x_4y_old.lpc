inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/d/ebene/def.h"

create()
{::create();

seteuid(getuid());
  SetProp(P_INT_SHORT,"Im Wassergraben");
  SetProp(P_INT_LONG,
    "Du befindest Dich im Burggraben. Es ist wirklich sehr "
    "ungemuetlich, nichts was Dir auch im entferntesten wirklich gefallen wuerde. "
    "Manchmal kann man ein leises Zischen hoeren, dann ist es jedoch wieder weg. "
    "Am Besten ist, Du verziehst Dich bald wieder, denn es ist wirklich "
    "ungemuetlich und feucht hier.");

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  AddDetail(({"graben","burggraben"}),
    "Es ist ungemuetlich hier, schnell hau ab. Nein, warte: Im Osten siehst Du "
    "Spuren.");
  AddDetail(({"spuren","osten"}),
    "Spuren, die so aussehen, als haette sie jemand erzeugt, der hier "
    "hinausgeklettert ist.");
  AddDetail(({"boden","wasser"}),
    "Ja, da ist Wasser am Boden, knocheltief. Du watest darin.");
  AddDetail(({"decke","himmel"}),
    "Ueber Dir befindet sich der Himmel und die Burgmauer von Kyranda.");
  AddDetail(({"burgmauer","kyranda"}),
    "Du siehst nur die Burgmauer welche Kyranda einschliesst.");
  AddDetail(({"wand","waende"}),
    "Die Waende interessieren Dich nicht Du willst nur weg von hier.");
  AddItem("/d/ebene/lamuerte/burg/npc/sarnak",REFRESH_DESTRUCT);
  if(random(2)>0)AddItem("/d/ebene/lamuerte/burg/npc/sarnak",REFRESH_DESTRUCT);
  AddItem( ({"/d/ebene/lamuerte/burg/npc/sarnak_kriegsfuerst.lpc",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak",
        "/d/ebene/lamuerte/burg/npc/sarnak" })
        ,REFRESH_DESTRUCT);
  AddSound(DEFAULT_SOUND,
    "Ab und an hoerst Du ein unwichtiges Zischen.");
  AddSound("zischen",
    "*ZISCHHHHH*");
  AddSmell(DEFAULT_SMELL,
    "Es stinkt hier.");
  AddExit("norden","/d/ebene/lamuerte/burg/graben/room10x_5y.lpc");
  AddExit("sueden","/d/ebene/lamuerte/burg/graben/room10x_3y.lpc");
  AddCmd("kletter|klettere&hinaus",
    "cmd_klettern",
    "Wohin willst Du klettern?");
}

int cmd_klettern()
{
  write(break_string(
    "Hier ist es sowieso so ungemuetlich, dass es eigentlich nur besser "
    "werden kann. Du kletterst hoffnungsvoll los."));
  this_player()->move("/d/ebene/wraz/metzelorgie/room/w01", M_GO,
    "aus dem Burggraben", "klettert angewidert");
  
  return 1;
}