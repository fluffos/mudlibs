// Pfad 03
// Wraz / Mendralim
// Zyklopen (urspruenglich Nekromantin)
// Ratte essen -> Heilung

#include "../def.h"

//inherit "std/room";
inherit ROOM "pfad.lpc";

int wache();
int rwache();
int i;

void create()
{
  ::create();

  i=1;

  SetProp(P_INT_SHORT, "Ein Pfad beim Schlachtfeld");
  SetProp(P_INT_LONG,
    "Viele Baeume und Straeucher ueberwuchern den erdigen Pfad, auch das "
    "Gras waechst hier noch hoeher. Der Himmel erstrahlt in einem dunklen "
    "Rot, frei von Wolken strahlt die Sonne schwach auf Dich herab. "
    "Die Stimmung ist hoechst angsteinfloessend!");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"stimmung", "angst"}),
   "Alles hier macht Dir Angst!");

  AddDetail( ({"angst","irgendetwas", "tatsache","sorgen"}),
   "Die Tatsache, dass hier ploetzlich niemand mehr ist, macht Dir Sorgen. "
   "Warum trauen sich die Ratten und sogar die todesmutigen Krieger nicht "
   "hierher?");

  AddDetail( ({ "boden", "gras", "zwerg" }),
    "Das Gras ist hier schon so hoch, dass ein kleiner Zwerg wohl fast nicht "
    "mehr darueber hinweg sehen kann.");

  AddDetail( ({"pfad", "kurve", "richtung", "suedosten", "norden"}),
    "Der Pfad fuehrt weiter nach Norden. In Richtung Suedosten macht er eine "
    "scharfe Kurve.");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Hier ist kein Blut mehr.");

  AddDetail( ({"himmel", "sonne", "wolken", "wolke", "rot"}),
   "Er ist hier noch immer blutrot gefaerbt. Keine Wolke verdeckt ihn, die "
   "Sonne strahlt trotzdem nur schwach.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es ist weiter im Westen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Die Baeume und Straeucher wuchern hier ueppig ueber den Pfad.");

  AddDetail( ({"silberland", "krieger"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratten"}),
   "Hmm. Nichtmal die Ratten laufen noch hier herum. Seltsam. "
   "Eine tote liegt dort halb im Gras.");

  AddDetail( ({"ratte"}),
   "In der Not frisst der Teufel Brot, und Du Ratten?");

  AddDetail( ({"not"}),
   "Bist Du in Not, dann friss die Ratte!");

  AddDetail( ({"brot"}),
   "Das frisst der Teufel nur in Not.");

  AddDetail( ({"teufel"}),
   "Der frisst Brot nur in der Not.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Sie kommen vom Schlachtfeld.");

  AddSound( ({"schlachtfeld"}),
   "Die Schreie kommen eindeutig von dem Schlachtfeld.");

  AddSound( ({"todesschreie", "entsetzen"}),
   "Man hoert ihnen das Entsetzen an!");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier gefaehrlich!!");

  AddRoomMessage(
    ({"Es ist hier bedrohlich still.\n",
    "Warum ist hier niemand mehr?\n",
    "Hier sind keine Ratten. Komisch.\n",
    "Huch! Da liegt eine tote Ratte!\n",
    "Du hoerst Todesschreie aus einiger Entfernung.\n"}),100+random(23));

  SUID;

  AddExit( "norden", ([EX_DEST: ROOM "p04",
                      EXG_ID:  "\nwache",
                      EXG_PLMSG: "Die Zyklopen versperren Dir den Weg.\n",
                      EXG_RMMSG: "Die Zyklopen lassen @wen@ nicht "
                      "passieren.\n"
                      ]) );

  AddExit( "suedosten",  ([EX_DEST: ROOM "p02",
                          EX_TESTFUNC: #'rwache, //'
                          EXG_ID:  "\nwache",
                          EXG_PLMSG: "Die Zyklopen versperren Dir den Weg.\n",
                          EXG_RMMSG: "Die Zyklopen lassen @wen@ nicht "
                          "passieren.\n"]) );

  AddCmd( ({"friss","fresse"}), "cmd_fressen");
}

int cmd_fressen(string str)
{
  notify_fail("Was willst Du fressen?\n");

  if(!str||str=="") return 0;

  if(str=="ratte"||str=="ratten")
  {
    if(TP->InFight())
    {
      write(BS(
        "Du bist viel zu abgelenkt!"));
      return -1;
    }

    if(i)
    {
      TP->Message(BS(
       "Du spannst Deine Muskeln an, ueberwindest Deinen Ekel und frisst "
       "die Ratte auf. Hmm, sie war noch frisch, nicht schlecht!"));
      ENV(TP)->Message(BS(
       TPN+" frisst mit verzerrtem Gesicht eine tote, rohe Ratte auf."),
        MSGFLAG_NO_TP);
      TP->AddHp(250);
      TP->AddSp(250);
      i=0;
      return 1;
    }

    else
    {
      TP->Message(BS(
       "Wae! Das ist nur noch das Fell der Ratte, irgendwer anders hat sie "
       "schon gegessen."));
      return -1;
    }
  }
}

void reset()
{
 ::reset();
 i=1;
}

void init()
{
  ::init();

  //WMASTER->carries_food(TP);

  if (TP -> QueryProp(P_GUILD) == "nekromanten" &&
      !deep_present("\nwraznekrobonus", TP) )
  {
    clone_object(OBJ "nekro_bonus")->move(TP,M_NOCHECK);
    return;
  }

  if(query_once_interactive(TP)) return;
  if(!TP->QueryProp(P_NPC)) return;

  if(TP->QueryProp(P_UID)=="d.wasser.stahldorn"&&
     TP->id("daemon"))
  {
    tell_room(TO,BS(
      "Der Daemon verschwindet einfach wieder."));
    TP->remove(1);
    return;
  }
}

void call_move_corpse(object player)
{
  WMASTER->move_corpse(player,TO);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  pfad::NotifyPlayerDeath(player, killer, lostexp);
  call_out("call_move_corpse",0,player);
}
