// Pfad 01 Schlachtfeld
// Wraz / Mendralim

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Pfad beim Schlachtfeld");
  SetProp(P_INT_LONG,
    "Die Gegend aendert hier ihren Charakter. Keine Leichen und Koerperteile "
    "mehr auf dem Boden, kein Blut. Hier stehen mehr Baeume und Straeucher, "
    "aber auch das Gras waechst hier hoeher. Nur ein kleiner Pfad fuehrt "
    "hier weiter nach Osten, im Westen ist das Schlachtfeld. Irgendetwas "
    "hier macht Dir Angst.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"gegend","charakter"}),
   "Keine Leichen, kein Blut. Irgendetwas macht Dir Angst.");

  AddDetail( ({"osten","westen"}),
   "Nach Osten fuehrt der Pfad, nach Westen kommst Du wieder auf das wilde "
   "Schlachtfeld.");

  AddDetail( ({"angst","irgendetwas", "tatsache","sorgen"}),
   "Die Tatsache, dass hier ploetzlich niemand mehr ist, macht Dir Sorgen. "
   "Warum trauen sich selbst die todesmutigen Krieger nicht hierher?");

  AddDetail( ({ "boden", "gras", "zwerg" }),
    "Keine Leichen, kein Blut. Das Gras ist etwa einen halben Zwerg hoch, "
    "bis auf einen schmalen, erdigen Pfad.");

  AddDetail( ({"pfad"}),
    "Er fuehrt weiter nach Osten. Du bist Dir aber nicht sicher, ob Du "
    "dort hin willst...");

  AddDetail(( {"leichen","koerper","tote","toten"}),
   "Die Koerper derer, die hier heldenhaft ihr Leben liessen. Aber hier "
   "liegen keine mehr!");

  AddDetail( ({"koerperteile","teile","arme","arm","beine","bein","koepfe",
  "kopf","torsos","torso"}),
   "Alles noch an Dir dran!");

  AddDetail( ({"blut","bluuut","bluut"}),
   "Hier ist kein Blut mehr.");

  AddDetail( ({"himmel", "sonne", "wolken", "wolke"}),
   "Er ist hier noch immer blutrot gefaerbt. Keine Wolke verdeckt ihn, die "
   "Sonne strahlt trotzdem nur fahl.");

  AddDetail( ({"leben"}),
   "Viele wilde Krieger liessen hier schon ihr Leben.");

  AddDetail( ({"schlachtfeld","feld"}),
    "Es ist im Westen.");

  AddDetail( ({"baeume", "straeucher"}),
    "Die Baeume und Straeucher wuchern hier ueber den Pfad.");

  AddDetail( ({"krieger", "soldaten"}),
    "Wilde, verwahrloste Krieger kommen "
    "zum Schlachtfeld um dort zu metzeln. Seltsamerweise ist hier "
    "keiner mehr.");

  AddDetail( ({"silberland"}),
    "Blutruenstige Krieger gibt es hier.");

  AddDetail( ({"ratte","ratten"}),
   "Hmm. Nichtmal die Ratten laufen noch hier herum. Seltsam.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie.");

  AddSound( ({"schreie","schrei"}),
   "Sie kommen vom Schlachtfeld.");

  AddSound( ({"schlachtfeld"}),
   "Die Schreie kommen eindeutig von dem Schlachtfeld.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier gefaehrlich!!");

  AddRoomMessage(
    ({"Es ist hier bedrohlich still.\n",
    "Warum ist hier niemand mehr?\n",
    "Schreie toenen aus dem Westen.\n"}),250+random(23));

  SUID;

  AddExit( "westen", ROOM "m11" );
  AddExit( "osten",  ROOM "p02" );
}
