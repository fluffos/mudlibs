// Liste
// von Wraz / Mendralim
// funktioniert nicht, haengt aber auch nicht
// eine Liste der Spieler, die die Nekromantin (Pfad) getoetet haben

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Liste");
  SetProp(P_LONG,
    "Lies die Liste mal!");

  SetProp(P_NAME, "Liste");
  SetProp(P_GENDER, FEMALE);
  AddId("liste");

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 110);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd("lies","cmd_lesen");
}

int cmd_lesen(string str)
{
  string log;
  string *entries;
  string stringdummy;
  string uid;
  string name;
  string *keys;

  mapping who;

  int intdummy;
  int i;

  who=([]);

  if(!str|str=="") return 0;

  if(str=="liste")
  {
    log=read_file(ZONE"/log/nekromantin.deads");
    entries=explode(log,"\n");

    TP->Message(BS("Hier: "));

    for(i=0;i<sizeof(entries);i++) {
     sscanf(entries[i],"%s, %d. %s %d, %d:%d:%d %s (%s)",
      stringdummy,intdummy,stringdummy,intdummy,intdummy,intdummy,intdummy,
      uid,name);
     if(!who[uid]) who[uid]=0;
     who[uid]++; }

    /*for(i=0;i<sizeof(entries);i++) {
     sscanf(entries[i],"%s, %d. %s %d, %d:%d:%d %s",
      stringdummy,intdummy,stringdummy,intdummy,intdummy,intdummy,intdummy,
      uid);
     if(!who[uid]) who[uid]=0;
     who[uid]++; }*/

   keys=m_indices(who);

   for(i=0;i<sizeof(keys);i++) {
     //string a;
     int b;
     //a=keys[i];
     b=i;

     printf(sprintf("%-10d %-10s %d\n",b,keys[i],who[ keys[i] ]));
   //TP->Message(
   // i+": "+keys[i]+" "+who[ keys[i] ]+"\n");
    }

   return 1;
  }
}
