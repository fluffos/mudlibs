// Salbe um Muellschlucker unangreifbar zu machen
// Schlachtfeld
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Muellschluckersalbe");
  SetProp(P_LONG,
    "Die Muellschluckersalbe ist fast durchsichtig und riecht "
    "dinotastisch.");

  SetProp(P_INFO, BS("Muellschlucker lassen sich bestimmt gerne mit dieser "
  "Salbe einschmieren!"));
  SetProp(P_NAME, "Muellschluckersalbe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"muellschluckersalbe","salbe"}) );

  SetProp(P_MATERIAL, ([MAT_FAT:60,MAT_ALCOHOL:1,MAT_WATER:37,
    MAT_MERCURY:2]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 3);
  SetProp(P_VALUE, 1000);


  AddCmd( "schmiere|schmier&muellschlucker|schlucker|schlucki&mit&salbe|"
          "muellschluckersalbe&ein","cmd_einschmieren",
          "WEN moechtest Du einschmieren?|"
          "Schmiere ... MIT ...|"
          "WOMIT moechtest Du einschmieren?|"
          "Schmiere ... EIN");
}

int cmd_einschmieren(string str)
{
  object schlucki;
  string wen;
  string womit;
  string present_string;
  int i;

  if(!interactive(TP)) return 0;
  if(!ENV(TO)) return 0;

  present_string = "muellschlucker";
  if(sscanf(str,"%s %d mit %s ein",wen,i,womit)==3)
    present_string = wen + " " + i;

  if(TP != ENV(TO))
  {
    TP->Message(BS("Du musst die Salbe schon in die Hand "
   "nehmen."));
   return -1;
 }

  if(!schlucki = present(present_string,ENV(TP)))
  {
    TP->Message(BS("Hier ist doch gar kein \""+present_string+"\"!"));
   return -1;
  }

  if( file_name(ENV(TP))[0..30] != "/d/ebene/wraz/metzelorgie/room/" )
  {
    TP->Message(BS("Auf diesen Muellschlucker wuerde die Salbe nicht wirken."));
   return -1;
  }

  if(schlucki->InFight())
  {
    TP->Message(BS("Im Kampf zappelt "+schlucki->name(WER,1)+" zu viel herum!"));
    return -1;
  }

  else
  {
    TP->Message(BS("Du schmierst den gesamten Muellschlucker mit der Salbe ein, "
     "bis nichts mehr uebrig bleibt."));
    ENV(TP)->Message(BS(
     TPN+" schmiert enthusiastisch einen Muellschlucker mit einer Salbe ein."),
     MSGFLAG_NO_TP);

    schlucki->set_noattack(60*60*24*(3+random(4)));

    TO->remove(1);
    return 1;
  }

}
