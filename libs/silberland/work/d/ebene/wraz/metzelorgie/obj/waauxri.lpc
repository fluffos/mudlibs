// Waauxri - Krankheit
// wird von NPC opkac uebertragen
// von Wraz / Mendralim

/* Funktionen:
 +
 + void disable_spells(int) void disable_attack(int)
 + erfordert 1 argument, dauer, wird an pl (global) vermittelt
 +
 + void liegen(int)
 + erfordert 1 argument, dauer, wird an pl (global) vermittelt
 + time() wird automatisch addiert
 +
 + void attr(int: in, str, con, dex)
 + erfordert 4 argumente, in reihenfolge int, str, con, dex
 +
 + void health(int: hp, sp)
 + erfordert 2 argumente, hp und sp, die der spieler pl (global) dauerhaft
 + erhaelt
 +
 + void speed(int: attacken, dauer)
 + erfordert 2 argumente, in % attacken und dauer
 + wird an pl (global) vermittelt
 +
 + void msg(string)
 + erforder 1 argument, string
 + string wird per tell_object und BS() an den spieler pl (global) vermittelt
 +
 + void infection()
 + infektion eines spielers im ENV, 40:60 wahrscheinlichkeit
 + nur in raeumen innerhalb von ZONE /room/ werden andere spieler infiziert
 +
 + void get_speech_bane()
 + gibt dem spieler pl einen sprachfluch
 +
 + void room(string message)
 + gibt eine BS-meldung an ENV(pl) aus
*/

#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"

inherit "std/thing";

int i;
int var_call;

void disable_spells(int value);
void disable_attack(int value);
void liegen(int value);
void attr(int in, int str, int con, int dex);
void health(int hp, int sp);
void speed(int valA, int valB);
void msg(string message);
void infection();
void get_speech_bane();
void room(string message);

string er();
string sein();
string seine();
string hihis();
string hihi();
string Er();
string Sein();
string Seine();
string ihm();
string ihn();
string Ihm();
string Ihn();

#define FILENAME "waauxri"

object pl;
string elook;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  elook="";
  i=1;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");

  SetProp(P_NAME, "Waauxri");
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nwaauxri","Krankheit"}));
// gibt's eine id fuer krankheiten? damit zB regeneration heilen kann

  SetProp(P_MATERIAL, MAT_MISC_INVIS );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

  SetProp(P_X_ATTR_MOD, ([]) );
  SetProp(P_X_HEALTH_MOD, ([]) );

  call_out("symptome",10+random(10));
}

void symptome() // --- SYMPTOME --- Symptombeschreibung ----------------------
{
  int resting;

  resting=0;

  if(!ENV(TO)) return;

  if(!query_once_interactive(ENV(TO)))
  {
    TO->remove(1);
    return;
  }

  if(!interactive(ENV(TO))) return;

  if(deep_present("\nwaauxri 2", ENV(TO)))
  {
    TO->remove(1);
    return;
  }

  pl=ENV(TO);

  // Spieler bis lvl 16 sind immun
  if(pl->QueryProp(P_LEVEL)<16) { remove(1); return; }

  // Untote Spieler sind immun
  if(pl->QueryProp(P_RACE)=="Untoter") { remove(1); return; }

  if(!random(10))
    TO->SetProp(P_X_ATTR_MOD, ([]) );
  if(!random(15))
    TO->SetProp(P_X_HEALTH_MOD, ([]) );

  switch (i)
  {

    case 1:
     msg("*Hust* *Hust* Du musst ploetzlich husten.");
     room(hihi()+" muss ploetzlich husten.");
    var_call=30+random(10);
    i++;
    break;

    case 2:
     msg("Huiiii! Dein Hals kratzt ein wenig, Du hustest leicht.");
    var_call=30+random(10);
    i++;
    break;

    case 3:
     msg("Summ, Summ. Dir geht es gut, aber irgendwie fuehlst Du Dich "
     "ein wenig erschoepft.");
     room(hihi()+" summt vor sich hin.");
     pl->do_exhaust(100+random(200));
    var_call=40+random(30);
    i++;
    break;

    case 4:
     msg("Aua! Dein linker kleiner Zeh tut auf einmal schrecklich weh! GRR!");
     room(hihi()+" schreit kurz leise auf. Warum tut "+er()+" das?");
     pl->AddHp(-random(20));
    var_call=30+random(10);
    i++;
    break;

    case 5:
     msg("Der Schmerz im kleinen Zeh laesst nach, und ploetzlich fuehlst "
     "Du Dich stark wie Kronang! Chuiiii SAUSSS!!");
     room(hihis()+" Pupillen weiten sich stark, "+er()+" ist hyperaktiv!");
     if(!random(5)) attr(0,40,0,0);
     else attr(0,5,0,0);
    var_call=30+random(10);
    i++;
    break;

    case 6:
     msg("Wuah. Uff. Dein Kronanggefuehl schwindet, Deine Muskeln tun weh, "
     "Du wirst sehr zach (ugs: 'traege').");
     room(hihi()+" roechelt und sieht sehr schwach aus.");
     TO->SetProp(P_X_ATTR_MOD, ([A_STR:0]) );
     pl->AddHp(-34);
     attr(0,-(1+random(5)),0,-1);
     speed(80,60);
    var_call=30+random(10);
    i++;
    break;

    case 7:
     msg("Langsam erholst Du Dich und Dich uebermannt das Verlangen, "
     "jemanden zu knuddeln.");
     call_out("infection",10+random(10));
    var_call=30+random(10);
    i++;
    break;

    case 8:
     msg("Dir wird abwechselnd heiss und kalt, ob Du Fieber hast? Deine "
     "Pupillen muessen riesig sein, so hell kommt Dir alles vor.");
     room(hihis()+" Pupillen sind uebermaessig gross. Irgendetwas stimmt "
     "mit "+ihm()+" nicht.");
     elook=Er()+" sieht voellig ueberdreht aus. "+Seine()+
      " Pupillen sind gigantisch gross, um nicht zu sagen, kolossal!\n";
    var_call=30+random(10);
    i++;
    break;

    case 9:
     msg("Uff. WUUUUUUUUU! Alles sieht ploetzlich aus wie ein "
     "riiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiesiger "
     "Frosch!! WOW! Du fuehlst Dich so schmal.");
     room(hihi()+" staunt ploetzlich und starrt in die Luft.");
     health(-24,1);
    var_call=30+random(10);
    i++;
    break;

    case 10:
     msg("Hu, Ha! AU, DER KOPF! Naja, egal. Du bist der Schnellste im "
     "ganzen SilberLand!");
     room(hihi()+" zuckt aufgeregt durch die Gegend.");
     speed(200,40);
     pl->AddHp(-4);
     pl->AddSp(-random(30));
    var_call=30+random(10);
    i++;
    break;

    case 11:
     msg("Arrr. Dein ganzer Koerper schmerzt auf einmal, Du kippst schreiend "
     "um.");
     room(hihi()+" beginnt urploetzlich zu schreien und kippt um.");
     liegen(6);
     pl->AddHp(-random(40));
    var_call=30+random(10);
    i++;
    break;

    case 12:

     switch (random(21))
     {
       case 0:
        msg("AAAAAAAAARGH!! Alles au, alles weh, waeaeaeae! Du weinst weil "
        "Dir jede noch so kleine Zelle Deines Koerpers schmerzt!");
        room(hihi()+" bruellt von Schmerzen gequaelt!");
        pl->AddHp(-random(30));
        pl->AddSp(-random(40));
        speed(40+random(20),30+random(20));
        if(random(2)) get_speech_bane();
       var_call=30+random(10);
       break;

       case 1:
        msg("Huch. Deine Arme und Beine lahmen zwar, aber Du bist fest "
        "ueberzeugt, dass Dein Kopf ploetzlich die Ausmasse eines "
        "Zwergenwanst erreicht hat!");
        room(hihi()+" scheint sich zu ueberschaetzen, "+er()+" sieht irgendwie "
        "klueger aus als noch vor einigen Sekunden.");
        health(0,10+random(40));
        speed(50,120);
        call_out("infection",10+random(10));
       var_call=30+random(10);
       break;

       case 2:
        msg("Aua, aua, aua!!! Du trittst mit dem linken Fuss auf und ein "
        "scharfer Stich zieht sich durch Dein Bein, welcher Dich in die "
        "Knie zwingt. Dein Gesicht verzerrt sich unter den Schmerzen. Es "
        "braucht einige Zeit, bist Du wieder aufstehen kannst.");
        room("Aus irgendeinem Grund scheint "+hihi()+" das Bein weh zu tun. "
        +Er()+" hockt einige Zeit mit schmerzverzerrtem Gesicht, was angesichts "
        +seine()+"r kolossalen Pupillen fast laecherlich aussieht, "
        "auf den Boden.");
        liegen(8);
        pl->AddHp(-(34+random(10)));
       var_call=30+random(10);
       break;

       case 3:
        msg("Hmm. Woher kommt der sechste Finger? "+Er()+" sieht irgendwie "
        "unnatuerlich aus, aber das ist Dir egal. Du bist zu froehlich.");
        room(hihi()+" betrachtet aufmerksam "+seine()+" Haende. Durch "
        "diese riesigen Pupillen duerfte "+ihm()+" das nicht schwer fallen.");
        call_out("infection",10+random(10));
       var_call=30+random(10);
       break;

       case 4:
        msg("Dir ist schwindelig, Dein Bauch tut weh. Diese staendigen "
        "Stimmungswechsel machen Dich fertig.");
        pl->do_exhaust(130);
        health(-12,-1);
       var_call=30+random(10);
       break;

       case 5:
        msg("Dir wird schwarz vor Augen und Du brichst erschoepft zusammen.");
        room(hihi()+" bricht unerwartet zusammen.");
        disable_spells(10);
        liegen(10);
        pl->AddHp(-random(10));
       var_call=30+random(10);
       break;

       case 6:
        msg("Es geht Dir momentan einigermassen normal. Eine seltsame "
        "Krankheit hast Du da. WUMM. Dein Blut scheint sich abrupt "
        "VERMEHRT zu haben!");
        room(hihi()+" sieht auf einmal so vital aus!");
        health(10+random(50),0);
        call_out("infection",10+random(5));
       var_call=30+random(10);
       break;

       case 7:
        msg("Du bekommst Kopfschmerzen, rasant schnell und stark! Es "
        "fuehlt sich so an, als wuerde das Leben aus Dir weichen.");
        room(hihi()+" beginnt zu wanken. "+Er()+" sieht schwach aus.");
        health(-random(30),-random(50));
        pl->AddSp(-34);
       var_call=30+random(10);
       break;

       case 8:
        msg("HGRL!! Die Krankheit scheint Dich dumm zu machen. Aber holla, "
        "Dein Bizeps hat ploetzlich den doppelten Umfang!");
        room(hihis()+" Muskeln schwellen unglaublich an, dafuer schaut "+er()+" "
        "allerdings ploetzlich dumm aus der Waesche. Dicke Pupillen.");
        attr(-5,5,0,0);
        call_out("infection",10+random(10));
       var_call=30+random(10);
       break;

       case 9:
        msg("Wah. Was hast Du Dir da nur eingefangen? Alles dreht sich, "
        "Du wankst und kippst um. Dein Kopf schlaegt auf dem Boden auf, "
        "aber Du spuerst es nicht.");
        room(hihi()+" geraet ins Wanken, kippt um und schlaegt hart mit dem "
        "Kopf auf.");
        liegen(6);
        pl->AddHp(-random(40));
       var_call=30+random(10);
       break;

       case 10:
        msg("Puff. Puff. Puff. Puff. Puff. Du kannst Dich Puff. Puff. Puff. "
        "Puff. nic Puff. Puff. ht konzentrieren. Puff. Puff. Puff. Puff. Puff.");
        disable_spells(30);
        pl->AddSp(-200);
       var_call=30+random(10);
       break;

       case 11:
        msg("Die Krankheit scheint ueberwunden zu sein, juhuu! Doch halt, "
        "woher kommt der dritte Arm?");
        room(hihi()+" blickt mit "+seine()+"n unverhaeltnismaessig dimensionierten "
        "Pupillen verwundert "+seine()+" Arme an.");
        speed(100+random(300),40);
        attr(0,0,0,4);
        call_out("infection",10);
       var_call=30+random(10);
       break;

       case 12:
        msg("Waauxri. Ja, so heisst das, was Du da hast. Der Name ist "
        "genauso verwirrend wie die Krankheit selbst. Du machst drei "
        "Liegestuetze, tust Dir dabei weh, aber fuehlst Dich danach "
        "ausdauernder.");
        room(hihi()+" macht motiviert 3 Liegestuetz!");
        disable_attack(4);
        disable_spells(4);
        attr(0,0,random(10),0);
        pl->AddHp(-random(30));
       var_call=30+random(10);
       break;

       case 13:
        msg("Ugh. Deine Zunge beginnt zu kribbeln, wrffff, wrfffffffph, "
        "YERRRRRRRRRRRRRRRRRRRRGHAUUUUUUUU!!!! Du schreist!!!");
        room(hihi()+" schreit: WRFFFFFFFFFF WRFFFFFFFFFFF!! YERRRRRRRRRRRR"
        "RRRRRRRGHAU!!!!!");
        get_speech_bane();
       var_call=30+random(10);
       break;

       case 14:
        msg("Dein Genick fuehlt sich steif an und bereitet Dir unangenehme "
        "Schmerzen. Dein Kopf tut auch weh, das muss an dieser "
        "Krankheit liegen.");
        health(0,-random(20));
        pl->AddSp(-13);
       var_call=30+random(10);
       break;

       case 15:
        msg("*KAH* *KUUU-H-* *ZGRRRR* Du roechelst und hustest.");
        room(hihi()+" roechelt und hustet seltsam. ");
        get_speech_bane();
        call_out("infection",10+random(10));
       var_call=30+random(10);
       break;

       case 16:
        msg("Du blickst Dich um. Die Farben veraendern sich, rot wird blau, "
        "weiss wird schwarz. Da stimmt etwas nicht.");
        room(hihis()+" Pupillen sind gross wie eine Kirsche und schwarz "
        "wie Pech.");
        health(-random(10),-random(10));
        speed(50,20);
       var_call=30+random(10);
       break;

       case 17:
        msg("Ein ploetzlicher, gigantischer Energieschub durchfaehrt "
        "Deinen Koerper!!! DU STIFTELST DURCH DIE GEGEND WIE EINE "
        "WILDSAU!!");
        room(hihi()+" rennt wie verrueckt durch die Gegend und scheint gar "
        "nicht zu bemerken, dass "+er()+" sich dabei verletzt! "+Seine()+" grossen "
        "Pupillen lassen "+ihn()+" wie ein Hofnarr aussehen!");
        pl->AddHp(-30);
        health(random(30),0);
        attr(0,0,2,-3);
        call_out("infection",10+random(5));
       var_call=30+random(10);
       break;

       case 18:
        msg("BAM! Eine monstroese Faust taucht aus dem Nichts auf und "
        "schlaegt Dir auf den Kiefer. Deine Zunge ist verletzt.");
        room("Wie von einer unsichtbaren Macht getroffen wird "+hihi()+" ploetzlich "
        "umgeworfen und zu Boden geschleudert.");
        liegen(2);
        get_speech_bane();
        pl->AddHp(-random(40));
       var_call=30+random(10);
       break;

       case 19:
        msg("ZACK - ZACK - ZACK - ZACK! Du wirst von heftigen Kraempfen "
        "geschuettelt, wie ein Dolch im Gehirn schmerzt Dein Kopf kurz.");
        room(hihi()+" wird von schweren Kraempfen gemartert.");
        attr(-random(5),-random(5),-random(5),-random(5));
        pl->AddHp(-random(50));
        pl->AddSp(-random(50));
        disable_spells(30);
        disable_attack(30);
        liegen(10);
        if(!random(3)) get_speech_bane();
       var_call=30+random(10);
       break;

       case 20:
        msg("Ui. Etwas ist passiert. Du kannst aber noch nicht sagen, was.");
        room(hihi()+" blickt Dich mit "+seine()+"n riesigen Pupillen verwundert "
        "an.");
        attr(-5+random(10),-5+random(10),-5+random(10),-5+random(10));
        call_out("infection",10);
        get_speech_bane();
       var_call=30+random(10);
       break;
     }

    i=12;
    break;

    case 100:
     msg("Oha! Du fuehlst Dich besser. Dein Kopf tut allerdings noch weh.");
     pl->AddSp(-random(10));
    var_call=20+random(20);
    i++;
    break;

    case 101:
     msg("Hmm. Irgendetwas scheint sich zu aendern, zu verbessern. Arg, "
     "ein ploetzlicher Schwaecheanfall.");
     room(hihi()+" atmet tief durch.");
     pl->do_exhaust(100);
    var_call=20+random(20);
    i++;
    break;

    case 102:
     msg("Huch. Dir geht es richtig gut.");
     health(20,10);
    var_call=20+random(20);
    i++;
    break;

    case 103:
     msg("ZACK! Mit einem stechenden Schmerz in der Lunge scheint sich "
     "die Krankheit, Wauxxri, verabschiedet zu haben! JUHUU!");
     room(hihis()+" Pupillen normalisieren sich wieder, "+er()+" macht einen "
     "Luftsprung vor Freude!");
    pl->AddHp(-random(10));
    elook="";
    attr(0,0,0,0);
    var_call=1000000;
    // Objekt bleibt erhalten um dem Spieler Immunitaet zu verleihen
    i=1000; // Immunitaetswert (wird im Reset genutzt)
    break;

    // Immunitaet
    case 1000:
     break;

    default:
     msg("Ein Bug - Bitte Mail an Wraz!");
    var_call=1000000;
    i=-1;
    TO->remove(1);
    break;
  }

  if(pl->QueryProp(P_RESTING)) resting=1;

  if( i<100 && i>10 &&
    resting*300+ ( (pl->QueryProp(P_MV)*100)/pl->QueryProp(P_MAX_MV) )-
    ( pl->QueryProp(P_POISON)*10 )
   >
   90+random(800) )
   i=100;


  if(find_call_out("symptome") == -1 && var_call != 1000000)
    call_out("symptome", var_call);

}

// SET I ---------------------------------------------------------------------

int set_i(int new_i)
{
  i=new_i;
  return i;
}

// DISABLE SPELLS ------------------------------------------------------------

void disable_spells(int value)
{
  if(!interactive(pl)) return;
  pl->SetProp(P_DISABLE_SPELLS, value);
  return;
}

// DISABLE ATTACK ------------------------------------------------------------

void disable_attack(int value)
{
  if(!interactive(pl)) return;
  pl->SetProp(P_DISABLE_ATTACK, value);
  return;
}

// LIEGEN --------------------------------------------------------------------

void liegen(int value)
{
  if(!interactive(pl)) return;
  pl->SetProp(P_LAST_RAMMEN_TIME, time()+value);
  return;
}

// ATTR ----------------------------------------------------------------------

void attr(int in, int str, int con, int dex)
{
  TO->SetProp(P_X_ATTR_MOD, TO->QueryProp(P_X_ATTR_MOD)+
    ([A_INT: in, A_STR: str, A_CON: con, A_DEX: dex]) );
  return;
}

// HEALTH --------------------------------------------------------------------

void health(int hp, int sp)
{
  TO->SetProp(P_X_HEALTH_MOD, TO->QueryProp(P_X_HEALTH_MOD)+
    ([P_HP: hp, P_SP: sp]) );
  return;
}

// SPEED ---------------------------------------------------------------------

void speed(int valA, int valB)
{
  if(!interactive(pl)) return;
  pl->ModifySkillAttribute(SA_SPEED, valA, valB);
  return;
}

// MSG -----------------------------------------------------------------------

void msg(string message)
{
  if(!interactive(pl)) return;
  tell_object(pl, BS(message) );
  return;
}

// "SUBFUNCTION" NOT TP ------------------------------------------------------

int not_tp(object player)
{
  if(player==ENV(TO)) return 0;
  if(deep_present("\nwaauxri", player)) return 0;
  else return 1;
}

// INFECTION -----------------------------------------------------------------

void infection()
{
  object *players;
  object victim;

  if(!pl || !interactive(pl) || !ENV(pl) ) return;

  if( random(100) > 40 ) return;

  players=filter_array(all_inventory(ENV(pl)), #'interactive); //'
  players=filter_array(players, "not_tp");

  if(!players) return;

  if(!sizeof(players)) return;

  victim=players[random( sizeof(players) )];

  if(deep_present("\nwaauxri 2", victim)) return;


  tell_object(victim, BS(hihis()+" Pupillen weiten sich enorm. Ploetzlich "
    "visiert "+er()+" Dich an, springt Dir in die Arme und knuddelt Dich "
    "wild durch. Wuah! Was ist nur mit "+ihm()+" los?") );
  tell_object(pl, BS("Du kannst Dich nicht mehr beherrschen, als Dir "+
   victim->Name()+" ins Auge sticht. Du springst "+victim->QueryPronoun(WESSEN)+
   "an und knuddelst "+victim->QueryPronoun(WESSEN)+" ganz wild durch!") );
  tell_room( ENV(victim), BS(hihis()+" Pupillen weiten sich enorm. Ploetzlich "
    "visiert "+er()+" "+victim->Name()+" an, springt "+victim->QueryPronoun(WEM)+
    " in die Arme und knuddelt "+victim->QueryPronoun(WESSEN)+
    " wild durch. Wuah! Was ist mit "+hihi()+" nur los?"), ({victim,pl}) );

  // ansteckung nur am schlachtfeld moeglich:
  if( strstr( file_name(ENV(pl)), "/d/ebene/wraz/metzelorgie/room/") == -1 ) return;

  call_other(OBJ FILENAME, "???");

  if(!present(find_object(OBJ FILENAME), victim))
    clone_object(OBJ FILENAME)->move(victim, M_NOCHECK);

  return;
}

// GET SPEECH BANE -----------------------------------------------------------

void get_speech_bane()
{
  string *banes;
  string bane;

  if(!pl || pl != ENV(TO) ) return;

  if(deep_present("\nsprachfluch", pl)) return;

  banes=({"antiscroll","fingers","spaces"});
  bane=banes[ random(sizeof(banes)) ];

  call_other(OBJ + bane, "???");
   if(!present(find_object(OBJ + bane), pl))
    clone_object(OBJ + bane)->move(pl, M_NOCHECK);

  return;
}

// ROOM ----------------------------------------------------------------------

void room(string message)
{
  if(!interactive(pl) || !ENV(pl)) return;

  tell_room(ENV(pl), BS(message), ({pl}) );
  return;
}

// (POSSESIVE) PRONOUNS ------------------------------------------------------

string er()
{
  return pl->QueryPronoun();
}

string sein()
{
  return pl->QueryPossPronoun();
}

string seine()
{
  return pl->QueryPossPronoun(WEM);
}

string hihis()
{
  return pl->Name(WESSEN);
}

string hihi()
{
  return pl->Name();
}

string Er()
{
  return capitalize(pl->QueryPronoun());
}

string Sein()
{
  return capitalize(pl->QueryPossPronoun());
}

string Seine()
{
  return capitalize(pl->QueryPossPronoun(WEM));
}

string ihm()
{
  return pl->QueryPronoun(WEM);
}

string ihn()
{
  return pl->QueryPronoun(WEN);
}


string Ihm()
{
  return capitalize(pl->QueryPronoun(WEM));
}

string Ihn()
{
  return capitalize(pl->QueryPronoun(WEN));
}

// EXTRA LOOK ----------------------------------------------------------------

string extra_look()
{
  return elook;
}

// BECOMES NET ALIVE ---------------------------------------------------------
void BecomesNetAlive(object player)
{
  call_out("symptome",10+random(10));
  return;
}

// RESET ---------------------------------------------------------------------
void reset()
{
  object player;

  ::reset();

  player = environment(TO);
  if (!player) return;
  if (!interactive(player)) return;

  // Objekt bleibt im Spieler und erzeugt dadurch Immunitaet
  // Nach gewisser Zeit verschwindet die Immunitaet

  if (!random((player->QueryAttribute(A_CON))*4) && i == 1000)
    TO->remove(1);
}
