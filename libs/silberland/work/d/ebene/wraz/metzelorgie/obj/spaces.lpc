// Sprachfluch: fuegt zufaellig platzierte Leerzeichen ein
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

object player=0;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId(({"wrazfluch", "\nsprachfluch"})); // /nsprachfluch: palas koennen
					   // heilen.
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

}

void reset() // --- Beispiel an ~/ronja/obj/imho.c - daher aehnlich!
{
  ::reset();

  if(player) player->SetProp(P_PERM_STRING, 0);
  remove(1);
}


void init()
{
  ::init();

  if(player && interactive(player))
  {
    player->SetProp(P_PERM_STRING, 0);
    player=0;
  }

  if(TP && interactive(TP) && environment(TO) == TP)
  {
    player=TP;
    player->SetProp(P_PERM_STRING, TO);
  }
}

string permutate_string(string str)
{
  int len, x, y;
  string har, buf;

  if(!har) har="";

  len=strlen(str);

  if(len<3) return str;

  str=implode(explode(str, " "), "");

  for(x=0; x<len-3; x+=y)
  {
    switch (random(2))
    {
      case 0:
      buf=str[x..x+2];
      y=3;
      break;

      case 1:
      buf=str[x..x+1];
      y=2;
      break;
    }

    har=har+buf+" ";
  }

  return har;
}
