// Log-Objekt
// loggt alle Ausgaben
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

object player=0;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId(({"wrazlog", "\nwrazlog"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

}

void reset() 
{
  ::reset();

  
}


void init()
{
  ::init();

}

// catch_tell() loggt alles
void catch_tell(string str)
{
  string filename;
  if(!ENV(TO)) return;

  filename = explode(file_name(ENV(TO)),"/")[<1];
   log_file("d/ebene/metzelorgie/catchtell_"+filename+".log",
    str+"\n");
}