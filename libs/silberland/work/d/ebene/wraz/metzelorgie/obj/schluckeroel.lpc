// Oel um Muellschlucker zu befehligen
// Schlachtfeld
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Phiole Muellschluckeroel");
  SetProp(P_LONG,
    "Das Muellschluckeroel ist ein truebes, duennfluessiges Oel in einer Glasphiole.");

  SetProp(P_INFO, BS("Muellschlucker lassen sich bestimmt gerne mit diesem "
  "Oel einreiben! Angeblich macht es sie intelligenter, sodass sie auf Kommandos "
  "wie 'bleib', 'komm' oder 'friss' hoeren."));
  SetProp(P_NAME, "Phiole Muellschluckeroel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"muellschluckeroel","oel","phiole"}) );

  SetProp(P_MATERIAL, ([MAT_FAT:40,MAT_ALCOHOL:2,MAT_WATER:37,
    MAT_MERCURY:1, MAT_PHOSPHORUS:1, MAT_GLASS:19]) );
  SetProp(P_WEIGHT, 40);
  SetProp(P_SIZE, 2);
  SetProp(P_VALUE, 2000);


  AddCmd( "reibe|reib&muellschlucker|schlucker|schlucki&mit&oel|"
          "muellschluckeroel&ein","cmd_einreiben",
          "WEN moechtest Du einreiben?|"
          "Reibe ... MIT ...|"
          "WOMIT moechtest Du einreiben?|"
          "Reibe ... EIN");
}

int cmd_einreiben()
{
  object schlucki;

  if(!interactive(TP)) return 0;
  if(!ENV(TO)) return 0;

  if(TP != ENV(TO))
  {
    TP->Message(BS("Du musst das Muellschluckeroel schon in die Hand "
   "nehmen."));
   return -1;
 }

  if(!schlucki = present("muellschlucker",ENV(TP)))
  {
    TP->Message(BS("Hier ist doch gar kein Muellschlucker!"));
   return -1;
  }

  if( file_name(ENV(TP))[0..30] != "/d/ebene/wraz/metzelorgie/room/" )
  {
    TP->Message(BS("Auf "+schlucki->name()+" wuerde das Oel hier nicht wirken."));
   return -1;
  }

  if(schlucki->InFight())
  {
    TP->Message(BS("Im Kampf zappelt "+schlucki->name(WER,1)+" zu viel herum!"));
    return -1;
  }

  else
  {
    TP->Message(BS("Du reibst "+schlucki->name(WEN,1)+" liebevoll mit dem Oel ein, "
     "bis nichts mehr uebrig bleibt und der Schlucki zufrieden fiept."));
    ENV(TP)->Message(BS(
     TPN+" reibt "+schlucki->name(WEN,1)+" zaertlich mit einem Oel ein."),
     MSGFLAG_NO_TP);

    schlucki->set_player(getuid(TP));

    TO->remove(1);
    return 1;
  }

}
