// Nekromantenbonus auf dem Pfad beim Schlachtfeld (Raum p03)
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,0);
  SetProp(P_LONG,"");

  SetProp(P_NAME, "Unheilige Macht");
  SetProp(P_GENDER, FEMALE);
  AddId("\nwraznekrobonus");


  SetProp(P_MATERIAL, MAT_MISC_INVIS );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

  call_out("mpheilung",30+random(20));
}

void mpheilung()
{
  object pl;

  if( !pl=ENV(TO) ||
      !query_once_interactive( pl ) ||
      pl -> QueryProp(P_GUILD) != "nekromanten" )
  {
    TO->remove(1);
    return;
  }

  if(ENV(pl) != find_object(ROOM "p03") &&
     ENV(pl) != find_object(ROOM "p04") &&
     ENV(pl) != find_object(ROOM "p05") &&
     ENV(pl) != find_object(ROOM "p06") &&
     ENV(pl) != find_object(ROOM "p07") &&
     ENV(pl) != find_object(ROOM "p08") &&
     ENV(pl) != find_object(ROOM "p09") &&
     ENV(pl) != find_object(ROOM "p10"))
  {
    TO->remove(1);
    return;
  }

  switch (random(4))
  {
    case 0:
      tell_object( pl, BS(
        "Du fuehlst, wie eine unheilige Kraft Deine astrale Macht auffrischt!"));
      break;

    case 1:
      tell_object( pl, BS(
        "Diese satanische Umgebung tut Dir gut!"));
      break;

    case 2:
      tell_object( pl, BS(
        "Es gefaellt Dir hier, Du spuerst hier Schrecken!"));
      break;

    default:
      tell_object( pl, BS(
        "TOD und VERWESUNG, das sind genau Deine Elemente!"));
      break;
  }

  pl->AddSp(20+random(11));
  call_out("mpheilung",20+random(40));
  return;
}
