// Lebenspunkte Reduktion (HP drain)
// von Wraz / Mendralim
// Spell von schreckgespenst

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,"");

  SetProp(P_NAME, "Lebenskraftentzug");
  SetProp(P_GENDER, MALE);
  AddId("\nwrazlebenskraftentzug");

  SetProp(P_X_HEALTH_MOD, ([P_HP:-(50+random(51)) ]) );

  SetProp(P_MATERIAL, ([MAT_MISC_INVIS:100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  call_out( "ende", 40+random(10) );
}

void ende()
{
  if( ENV(TO) && interactive( ENV(TO) ) )
    tell_object( ENV(TO), BS(
      "Du erholst Dich vom Lebenskraftenzug des Schreckgespensts.") );

  TO->SetProp(P_X_HEALTH_MOD, 0 );

  if( query_once_interactive( ENV(TO) ) )
    ENV(TO)->UpdateAttributes();

  TO->remove(1);
  return;
}

varargs int move(mixed dest, int method, string dir, string textout, string textin) {
  int parentMove;
  parentMove = ::move(dest, method, dir, textout, textin);
  if(parentMove == 1) {

    if( query_once_interactive(ENV(TO))) ENV(TO)->UpdateAttributes();
    if( query_once_interactive(previous_object()))
      previous_object()->UpdateAttributes();
    if( ENV(previous_object()) )
      if( query_once_interactive(ENV(previous_object())))
        ENV(previous_object())->UpdateAttributes();
  }

  return parentMove;
}
