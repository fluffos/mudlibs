// Bling
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

int cvalue;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "");
  SetProp(P_LONG,
    "");

  SetProp(P_INFO, "Jemand auf dem Schlachtfeld waere sicher gluecklich, "
    "wenn Du ihm diesen Gegenstand gibst.");
  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId( ({"bling"}) );

  //SetProp(P_MATERIAL, MAT_ );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
}

int set_collector_value(int value)
{
  int bday;

  if(TP) bday = (dtime()[5..11]==dtime(TP->QueryProp(P_CREATION_DATE))[5..11])
                ? 1 : 0;

  if( (dtime()[5..11]=="12. Mar") || bday ) cvalue=value * 2;
  else cvalue=value;
  
  return cvalue;
}

int query_collector_value()
{
  return cvalue;
}
