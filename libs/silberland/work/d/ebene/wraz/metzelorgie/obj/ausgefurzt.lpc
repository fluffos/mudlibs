// Ausgefurzt-Objekt der Mutter aller Muellschlucker, Schlachtfeld
// Wraz / Mendralim
// Vorlage: /obj/misc/furz.c

#include <properties.h>
#include <language.h>
#include "../def.h"
inherit "std/thing";

int    alter;
string furzer_wessen,furzer_wer,furzer_wem,furzer_wen;

create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Etwas");
  SetProp(P_GENDER, 1);
  SetProp(P_ARTICLE,0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  AddId(({"\nausgefurzt"}));
  alter = 0;
  set_heart_beat(1);
}

heart_beat()
{
  int i;
  object room;

  if (!objectp(environment(environment())))
    return;
  
  room = environment(environment());

  if (!alter)
    tell_room(room, "Ekelerregender Gestank erfuellt den Raum.\n");
  alter++;
  if (!random(10))
  {
    i = random (10);
    if (i==0)
      tell_room(room, capitalize(furzer_wer)+" stinkt wirklich grauenerregend nach Faekalien.\n");
    if (i==1)
      tell_room(room, "Du haeltst Dir angewidert die Nase zu.\n");
    if (i==2)
      tell_room(room, "Abartige Verdauungsgerueche gehen von "+furzer_wem+" aus.\n");
    if (i==3)
      tell_room(room, "Es stinkt hier dermassen, als haette " + furzer_wer +" in Exkrementen gebadet.\n");
    if (i==4)
      tell_room(room, "Der von " + furzer_wem + " ausgehende Gestank ist unbeschreiblich.\n"); 
    if (i==5)
      tell_room(room, "Man werfe "+furzer_wen+" doch endlich in ein Bad!\n");
    if (i==6)
      tell_room(room, "Dir wird schwindlig, so beissend ist der von "+furzer_wem+" ausgehende Geruch!\n");
    if (i==7)
      tell_room(room, BS("Du denkst an Selbstloeschung, so pervers wie "+furzer_wer+
        " riecht willst Du hier nicht laenger mudden!"));
    if (i==8)
      tell_room(room, capitalize(furzer_wessen)+" Geruch ist weit jenseits von Gut und Boese.\n");
    if (i==9)
      tell_room(room, BS("Ein gewoehnlicher Furz waere jetzt eine echte Erleichterung, verglichen mit "
      +furzer_wessen+" derzeitigem Gestank."));
  }
  if (alter>=645) {
      tell_room(room, "Den Goettern sei Dank! "+capitalize(furzer_wessen) + " widerlicher Gestank hat sich endlich verzogen.\n");
      destruct(this_object());
    }
}

set_furzer (object wer)
{
  furzer_wessen = wer->name(WESSEN);
  furzer_wer = wer->name();
  furzer_wem = wer->name(WEM);
  furzer_wen = wer->name(WEN);
}

reset() {
  ::reset();
  call_out("remove",0);
}

