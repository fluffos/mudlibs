// Ein Ast - sauunnoetig :)
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Ast");
  SetProp(P_LONG,
    "Ein abgebrochener Ast eines Strauches. Es haengen noch ein paar "
    "Blaetter an ihm.");
    
  AddDetail( "blaetter",
    "Ein paar haengen noch dran.");

  SetProp(P_INFO, "Der Ast ist so unnoetig wie eine Axt ohne Berserker.");
  SetProp(P_NAME, "Ast");
  SetProp(P_GENDER, MALE);
  AddId("ast");

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 1);
}