// Schnapsflasche am Schlachtfeld (Raum p05)
// von Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Flasche Schnaps");
  SetProp(P_LONG,
    "Eine stinknormale Flasche Schnaps, hochprozentig.");

  SetProp(P_INFO, BS("Du koenntest die Flasche austrinken oder, wenn Du "
  "verletzt bist, ueber Deine Wunden leeren."));
  SetProp(P_NAME, "Flasche Schnaps");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"flasche","schnaps","schnapsflasche","\nwrazschnapsflasche"}) );

  SetProp(P_MATERIAL, ([MAT_GLASS:20,MAT_ALCOHOL:70,MAT_WATER:10]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 100);
  SetProp(P_NODROP, BS("Als Du die Flasche wegwerfen willst, zieht sie eine "
   "Dir unerklaerliche Kraft zu Dir zurueck. Sie scheint auf eine gewisse Weise "
   "verflucht zu sein."));

  AddCmd( ({"trink","trinke"}), "cmd_trinken");
  AddCmd( "leere|leer&flasche|schnaps|schnapsflasche&ueber&wunden|wunde|"
          "meine wunden","cmd_leeren",
          "WAS willst Du WORUEBER leeren?|UEBER was willst Du das leeren?|"
          "Ueber WAS willst Du das leeren?");
}

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");

  if(!str||str=="") return 0;

  if(str=="schnaps"||str=="schnapsflasche"||str=="schnaps aus"||str==
  "schnapsflasche aus"||str=="flasche aus"||str=="flasch")
  {
    if(TP->drink_drink(5,55))
    {
      TP->Message(BS(
        "Du leerst die Flasche in einem Zug und wirfst sie weg."));
      ENV(TP)->Message(BS(
        TPN+" leert eine Flasche Schnaps in einem Zug."),MSGFLAG_NO_TP);
      TO->remove(1);
      return 1;
    }
    else return -1;
  }
}

int cmd_leeren()
{
  TP->Message(
   "Du leerst den Schnaps ueber Deine Wunden.\n"
   "AUAAAAAAAAAAAAAAAAAAAAA DAS BRENNT!!!!\n"
   "Aber es wirkt!\n");
  ENV(TP)->Message(BS(
   TPN+" leert Schnaps ueber seine Wunden und SCHREIT LAUT AUF! Das muss "
   "brennen..."),MSGFLAG_NO_TP);
  TP->AddHp(350);
  TP->AddSp(50);
  TO->remove(1);
  return 1;
}
