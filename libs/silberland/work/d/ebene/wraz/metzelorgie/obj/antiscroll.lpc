// Sprachfluch: Multiple Satzzeichen werden auf eines reduziert
// von Wraz / Mendralim
// Wird durch die Krankheit "Waauxri" ausgeloest

#include "../def.h"

inherit "std/thing";

object player=0;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId(({"wrazfluch", "\nsprachfluch"})); // /nsprachfluch: palas koennen
					   // heilen.
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  //SetProp(P_INVIS, 1);

}

void reset() // --- Beispiel an ~/ronja/obj/imho.c - daher aehnlich!
{
  ::reset();

  if(player) player->SetProp(P_PERM_STRING, 0);
  remove(1);
}


void init()
{
  ::init();

  if(player && interactive(player))
  {
    player->SetProp(P_PERM_STRING, 0);
    player=0;
  }

  if(TP && interactive(TP) && environment(TO) == TP)
  {
    player=TP;
    player->SetProp(P_PERM_STRING, TO);
  }
}

string permutate_string(string str)
{
  int len, x, iamstupit;
  string har, buf;

  iamstupit=0;

  if(!str||str=="") return "";

  if(!har) har="";

  len=strlen(str);

  for(x=0; x<len; x++)
  {
    iamstupit++;
    if(iamstupit>150) return ""; // damit ich nicht wieder megalag baue...
    buf=str[x..x];

    switch(buf)
    {
      case "!":
        if(str[x-1..x-1]=="!") buf="";
        break;

      case "1":
        if(str[x-1..x-1]=="!") buf="";
        break;

      case "?":
        if(str[x-1..x-1]=="?") buf="";
        break;

      default: break;
    }

    har=har+buf;
  }

  return har;
}
