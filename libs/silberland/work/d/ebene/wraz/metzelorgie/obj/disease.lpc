// Disease - Vorlage
// von Wraz / Mendralim
// Geaendert werden muessen die Funktionen symptome, infection, create

/* Funktionen:
 +
 + void disable_spells(int) void disable_attack(int)
 + erfordert 1 argument, dauer, wird an pl (global) vermittelt
 +
 + void liegen(int)
 + erfordert 1 argument, dauer, wird an pl (global) vermittelt
 + time() wird automatisch addiert
 +
 + void attr(int: in, str, con, dex)
 + erfordert 4 argumente, in reihenfolge int, str, con, dex
 +
 + void health(int: hp, sp)
 + erfordert 2 argumente, hp und sp, die der spieler pl (global) dauerhaft
 + erhaelt
 +
 + void speed(int: attacken, dauer)
 + erfordert 2 argumente, in % attacken und dauer
 + wird an pl (global) vermittelt
 +
 + void msg(string)
 + erforder 1 argument, string
 + string wird per tell_object und BS() an den spieler pl (global) vermittelt
 +
 + void infection()
 + infektion eines spielers im ENV, 40:60 wahrscheinlichkeit
 +
 + void get_speech_bane()
 + gibt dem spieler pl einen sprachfluch
 +
 + void room(string message)
 + gibt eine BS-meldung an ENV(pl) aus
*/

#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"

inherit "std/thing";

int i;
int var_call;

void disable_spells(int value);
void disable_attack(int value);
void liegen(int value);
void attr(int in, int str, int con, int dex);
void health(int hp, int sp);
void speed(int valA, int valB);
void msg(string message);
void infection();
void get_speech_bane();
void room(string message);

string er();
string sein();
string seine();
string hihis();
string hihi();
string Er();
string Sein();
string Seine();
string ihm();
string ihn();
string Ihm();
string Ihn();

#define FILENAME "disease"

object pl;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  i=1;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");

  SetProp(P_NAME, "Krankheit");
  SetProp(P_GENDER, FEMALE);
  AddId("\nkrankheit");


  SetProp(P_MATERIAL, MAT_MISC_INVIS );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

  SetProp(P_X_ATTR_MOD, ([]) );
  SetProp(P_X_HEALTH_MOD, ([]) );

  call_out("symptome",10+random(10));
}

void symptome() // --- SYMPTOME --- Symptombeschreibung ----------------------
{
  if(!ENV(TO)) return;

  if(!query_once_interactive(ENV(TO)))
  {
    TO->remove(1);
    return;
  }

  if(!interactive(ENV(TO))) return;

  if(deep_present("\nkrankheit 2", ENV(TO)))
  {
    TO->remove(1);
    return;
  }

  pl=ENV(TO);


  switch (i)
  {

    case 1:
     msg("");
    var_call=10;
    i++;
    break;

    case 2:
     msg("");
    var_call=10;
    i++;
    break;

    case 3:
     msg("");
    var_call=10;
    i++;
    break;

    default:
     msg("");
    var_call=1000000;
    i=-1;
    TO->remove(1);
    break;
  }

  call_out("symptome", var_call);

}

// DISABLE SPELLS ------------------------------------------------------------

void disable_spells(int value)
{
  if(!interactive(pl)) return;
  pl->SetProp(P_DISABLE_SPELLS, value);
  return;
}

// DISABLE ATTACK ------------------------------------------------------------

void disable_attack(int value)
{
  if(!interactive(pl)) return;
  pl->SetProp(P_DISABLE_ATTACK, value);
  return;
}

// LIEGEN --------------------------------------------------------------------

void liegen(int value)
{
  if(!interactive(pl)) return;
  pl->SetProp(P_LAST_RAMMEN_TIME, time()+value);
  return;
}

// ATTR ----------------------------------------------------------------------

void attr(int in, int str, int con, int dex)
{
  TO->SetProp(P_X_ATTR_MOD, TO->QueryProp(P_X_ATTR_MOD)+
    ([A_INT: in, A_STR: str, A_CON: con, A_DEX: dex]) );
  return;
}

// HEALTH --------------------------------------------------------------------

void health(int hp, int sp)
{
  TO->SetProp(P_X_HEALTH_MOD, TO->QueryProp(P_X_HEALTH_MOD)+
    ([P_HP: hp, P_SP: sp]) );
  return;
}

// SPEED ---------------------------------------------------------------------

void speed(int valA, int valB)
{
  if(!interactive(pl)) return;
  pl->ModifySkillAttribute(SA_SPEED, valA, valB);
  return;
}

// MSG -----------------------------------------------------------------------

void msg(string message)
{
  if(!interactive(pl)) return;
  tell_object(pl, BS(message) );
  return;
}

// "SUBFUNCTION" NOT TP ------------------------------------------------------

int not_tp(object player)
{
  if(player==ENV(TO)) return 0;
  else return 1;
}

// INFECTION -----------------------------------------------------------------

void infection()
{
  object *players;
  object victim;

  if(!pl || !interactive(pl) || !ENV(pl) ) return;

  if( random(100) > 40 ) return;

  players=filter_array(all_inventory(ENV(pl)), #'interactive);
  players=filter_array(players, "not_tp");

  if(!players) return;

  victim=players[random( sizeof(players) )];


  tell_object(victim, BS("") );
  tell_object(pl, BS("") );
  tell_room( ENV(victim), BS(""), ({victim,pl}) );


  call_other(OBJ FILENAME, "???");

  if(!present(find_object(OBJ FILENAME), victim))
    clone_object(OBJ FILENAME)->move(victim, M_NOCHECK);

  return;
}

// GET SPEECH BANE -----------------------------------------------------------

void get_speech_bane()
{
  string *banes;
  string bane;

  if(!pl || pl != ENV(TO) ) return;

  banes=({"antiscroll","fingers","spaces"});
  bane=banes[ random(sizeof(banes)) ];

  call_other(OBJ bane, "???");
   if(!present(find_object(OBJ bane), pl))
    clone_object(OBJ bane)->move(pl, M_NOCHECK);

  return;
}

// ROOM ----------------------------------------------------------------------

void room(string message, object *exclude)
{
  if(!interactive(pl) || !ENV(pl)) return;

  tell_room(ENV(pl), BS(message), ({pl}) );
  return;
}

// (POSSESIVE) PRONOUNS ------------------------------------------------------

string er()
{
  return pl->QueryPronoun();
}

string sein()
{
  return pl->QueryPossPronoun();
}

string seine()
{
  return pl->QueryPossPronoun(WEM);
}

string hihis()
{
  return pl->Name(WESSEN);
}

string hihi()
{
  return pl->Name();
}

string Er()
{
  return capitalize(pl->QueryPronoun());
}

string Sein()
{
  return capitalize(pl->QueryPossPronoun());
}

string Seine()
{
  return capitalize(pl->QueryPossPronoun(WEM));
}

string ihm()
{
  return pl->QueryPronoun(WEM);
}

string ihn()
{
  return pl->QueryPronoun(WEN);
}


string Ihm()
{
  return capitalize(pl->QueryPronoun(WEM));
}

string Ihn()
{
  return capitalize(pl->QueryPronoun(WEN));
}
