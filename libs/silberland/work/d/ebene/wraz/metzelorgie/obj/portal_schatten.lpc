// Portal zur Schattenwelt, von Schlachtfeld
// Laedt in ROOM p10 (Meisterschlaechter)
// Von Wraz / Mendralim

#include "../def.h"

inherit "/std/thing";

void create () 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NOGET,1);
  SetProp(P_NAME,"Riss zwischen den Welten");
  SetProp(P_GENDER,MALE);
  AddId (({"riss"}));

  SetProp(P_SHORT,"Ein schattenhafter Riss zwischen den Welten");
  SetProp(P_LONG, BS(
    "Es sieht aus wie ein "
    "Riss... ein Uebergang zu einer anderen, schattenhaften Welt!"
  ));
  SetProp (P_MATERIAL, MAT_MAGIC);
  AddCmd("betritt|betrete&riss|portal","BetreteRiss",
    "Was moechtest Du betreten?");
  AddCmd("betritt|betrete&riss|portal&abermals","BetreteRissAbermals");
  
  call_out("pre_remove_msg",60*4+random(30));
  call_out("remove",60*5+random(60*2));
}

// ------------------------------------------------------------------------------
int BetreteRiss()
{
  TP->Message(BS("Du setzt einen Fuss in Richtung des Risses, als ein Avatar von "
    "Wraz erscheint. Er spricht: 'Bevor Du diesen Riss betrittst, um "
    "womoeglich in eine andere Welt ueberzutreten, sei gewarnt. Grosse Gefahren "
    "lauern dort, wohin Du Dich begeben moechtest. Wie und ob ueberhaupt Du jemals "
    "von dort zurueckkehren kannst, ist ungewiss. Der maechtige Wraz herrscht an "
    "dem Ort hinter dem Riss, und er formt ihn nach seinem Gutduenken - ein zum "
    "gegenwaertigen Zeitpunkt nicht, vielleicht niemals, abgeschlossener Akt. "
    "Nimmst Du nun das unbekannte Wagnis auf Dich, den Gefahren des Ortes und "
    "der Willkuer des Magiers ins Auge blickend, so versuche den Riss ABERMALS "
    "zu betreten, und halte Dich fuer heldenhaft, wenn Du das moechtest.' "
    "Daraufhin verschwindet der Avatar so schnell wie er erschien."));
  return 1;
}

// ------------------------------------------------------------------------------
int BetreteRissAbermals()
{
  object player_shadow;
  // Spieler haben 0, Seher 1 (oder zumindest < 10)
  if(!query_wiz_level(TP))
  {
    TP->Message(BS("Du willst durch den schattenhaften Riss schreiten, wirst aber von den "
      "Schatten zurueckgedraengt."));
    ENV(TP)->Message(BS(TPN+" will durch den schattenhaften Riss schreiten, wird aber von den "
      "Schatten zurueckgedraengt."),MSGFLAG_NO_TP);
    return -1;
  }
  call_other(SCHATTEN "room/sn000","???");
  TP->Message(BS("Du schreitest durch den schattenhaften Riss in eine andere Dimension."));
  TP->move(SCHATTEN "room/sn000",M_GO,"durch den schattenhaften Riss in eine andere Welt",
    "schreitet","betritt wie aus dem Nichts diese Welt");
  player_shadow = clone_object(SCHATTEN "npc/spielerschatten");
  player_shadow->SetOwner(TP);
  player_shadow->move(SCHATTEN "room/sn000",M_NOCHECK);
  call_other(SCHATTEN "master/log_master", "DoEntryExitLog", TP, TO, ENV(TO), 
    find_object(SCHATTEN "room/sn000"));
  return 1;
}

// ------------------------------------------------------------------------------
void pre_remove_msg()
{
  tell_room(ENV(TO),BS("Schatten fliessen aus dem Riss und verschmelzen mit den Schatten der "
    "Umgebung. Es sieht aus, als wuerde der Riss kleiner und schwaecher."));
}

// ------------------------------------------------------------------------------
int remove()
{

  if(TO && ENV(TO)) tell_room(ENV(TO),BS("Die letzten Schatten fliessen aus dem Riss und verschmelzen "
    "mit der Umgebung, bis der Riss gaenzlich verschwindet."));
  ::remove();
  return 1;
}