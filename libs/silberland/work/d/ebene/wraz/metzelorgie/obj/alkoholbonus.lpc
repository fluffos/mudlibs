// Alkoholbonus
// von Wraz / Mendralim
// bekommt man, wenn man das Wetttrinken gegen den Zechpreller am
//  "Pfad des Todes" gewinnt

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,"");

  SetProp(P_NAME, "Alkoholbonus");
  SetProp(P_GENDER, FEMALE);
  AddId("\nwrazalkoholbonus");

  SetProp(P_X_MAX_HEALTH_MOD, ([P_HP:10]) );
  SetProp(P_X_HEALTH_MOD, ([P_HP:40 ]) );

  SetProp(P_MATERIAL, ([MAT_MISC_INVIS:100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  call_out( "ende", 200+random(30) );
}

void ende()
{
  if( ENV(TO) && interactive( ENV(TO) ) )
    tell_object( ENV(TO), BS(
      "Die Trunkenheit laesst nach, Du kommst auf den Boden der Realitaet "
      "zurueck.") );

  TO->SetProp(P_X_MAX_HEALTH_MOD, 0 );
  TO->SetProp(P_X_HEALTH_MOD, 0 );

  if( query_once_interactive( ENV(TO) ) )
    ENV(TO)->UpdateAttributes();

  TO->remove(1);
  return;
}

varargs int move(mixed dest, int method, string dir, string textout, string textin) {
  int parentMove;
  parentMove = ::move(dest, method, dir, textout, textin);
  if(parentMove == 1) {

    if( query_once_interactive(ENV(TO))) ENV(TO)->UpdateAttributes();
    if( query_once_interactive(previous_object()))
      previous_object()->UpdateAttributes();
    if( query_once_interactive(ENV(previous_object())))
      ENV(previous_object())->UpdateAttributes();
  }

  return parentMove;
}
