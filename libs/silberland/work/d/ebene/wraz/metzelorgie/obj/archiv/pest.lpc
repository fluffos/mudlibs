// Pest
// Schlachtfeld
// von Wraz / Mendralim

// idelschutz ab 350 sekunden, levelschutz bis incl lvl 35

#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"

inherit "std/thing";

object me=TO;
int i;                        // Zaehler fuer Meldungen per switch
int wait;                     // Wartezeit zwischen den Meldungen
//int beulen_offen;
int recovery_chance;          // Wahrscheinlichkeit der Selbstheilung
                              // (nur bei Beulen- und abortiver Pest)
string old_presay;            // urspruengliches Presay
string old_title;             // urspruenglicher Titel

mapping informed=([]);        // Liste der Spieler + Zeitpunkt, die vor dem 
                              // Pestkranken gewarnt wurden

int may_die(int hp, object pl);
int cmd_brechen(string str);
void new_title(object player);
void set_old_title(object player);
void may_immediately_die(object pl);
void may_contract_pest(object pl);

void create()
{
  if (!is_clone(TO)) return;
  
  i=0;
  wait=10;
  //beulen_offen=0;
  recovery_chance=0;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");

  SetProp(P_NAME, "Pest");
  SetProp(P_GENDER, FEMALE);
  AddId("\npest");


  SetProp(P_MATERIAL, MAT_MISC_INVIS );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  
  SetProp(P_X_ATTR_MOD, ([]) );
  SetProp(P_X_HEALTH_MOD, ([]) );

  call_out("pest",10+random(10));
}

void pest()
{
  object pl;
  
  if(!ENV(me)) return;
  
  if(!query_once_interactive(ENV(me)))
  { 
    me->remove(1);
    return; 
  }
  
  if(!interactive(ENV(me))) return;
  
  if(deep_present("\npest 2", ENV(me))) 
  {
    me->remove(1); 
    return; 
  }
  
  pl=ENV(me);
  
  if(pl->QueryProp("pest_immunitaet")>time()-(86400*(1+random(4)))) 
  {
    me->remove(1); 
    return;
  }
  
  recovery_chance=(pl->QueryProp(P_MV)*100)/pl->QueryProp(P_MAX_MV);
  
  if(pl->QueryProp(P_RESTING)) recovery_chance+=150;
  if(pl->QueryProp(P_POISON))  recovery_chance-=pl->QueryProp(P_POISON)*10;
  
  //tell_object(pl, "test haut hin!\n");
  
  switch (i)
  {
    case 0:
      switch(random(100))
      {
        case 0..65: i=1; break; // Beulenpest
        case 66..80: i=50; break; // abortive Pest
        case 81..100: i=100; break; // Lungenpest
      }
      
// --------------------------------------------------------------------------
// ----- BEULENPEST ---------------------------------------------------------
// --------------------------------------------------------------------------
      
    case 1: 
      switch(random(3)) {
      case 0:
      tell_object(pl, BS(
        "Du fuehlst Dich irgendwie nicht wohl.")); break;
      case 1:
      tell_object(pl, BS(
        "Dir wird ein wenig schwindelig.")); break;
      case 2:
      tell_object(pl, BS(
        "Dein Kopf wird warm.")); break; }
      i++;
      wait=20;
    break;
    
    case 2:
      switch(random(4)) {
      	
      case 0:
      tell_object(pl, BS(
        "Uah, Du hast schreckliche Kopfschmerzen!"));
      if(!random(3)&&!pl->QueryProp(P_DISABLE_SPELLS))
        pl->SetProp(P_DISABLE_SPELLS,random(9)); break;
        
      case 1:
      tell_object(pl, BS(
        "Deine Arme und Beine schmerzen. Du fuehlst Dich benommen."));
      if(random(2)&&!pl->QueryProp(P_DISABLE_SPELLS)&&
      !pl->QueryProp(P_DISABLE_ATTACK)) {
      	pl->SetProp(P_DISABLE_SPELLS,random(9));
      	pl->SetProp(P_DISABLE_ATTACK,random(7)); } break;
      
      case 2:
      tell_object(pl, BS(
        "Du fuehlst Dich elendiglich krank. Deine Stirn ist heiss.")); break;
      
      case 3:
      tell_object(pl, BS(
        "Grrr, Du taumelst! Du hast hohes Fieber, Deine Glieder tun weh."));
        
      //ENV(pl)->Message(BS(pl->Name()+" taumelt herum."),
      //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      tell_room(ENV(pl),BS(pl->Name()+" taumelt herum."), ({pl}) );
      break;  }
      i++;
      wait=25+random(6);
    break;
    
    case 3:
      switch(random(4)) {
      	
      case 0:
      tell_object(pl, BS(
        "Du hast fast unertraegliche Kopfschmerzen, Dein Gleichgewichtssinn "
        "versagt Dir den Dienst, Du kippst um."));
      pl->SetProp(P_LAST_RAMMEN_TIME, time() ); break;
      
      case 1:
      tell_object(pl, BS(
        "In Deinen Gliedern fuehlst Du abartig starke Schmerzen! Das haeltst "
        "Du nicht aus, Du schreist!"));
        
      //ENV(pl)->Message(BS(
      //  pl->Name()+" schreit laut vor Schmerz!!"),
      //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      tell_room(ENV(pl),BS(pl->Name()+" schreit laut vor Schmerz!!"), ({pl}) );
      if(random(2)) me->SetProp(P_X_ATTR_MOD, 
        me->QueryProp(P_X_ATTR_MOD)+([A_DEX:-1,A_STR:-3]));
      break;
      
      case 2:
      tell_object(pl, BS(
        "Dein ganzer Koerper zittert, er ist schwerkrank. Du taumelst, "
        "Dein Kopf droehnt."));
        
      //ENV(pl)->Message(BS(
      //  pl->Name()+" wankt stoehnend."),
      //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      tell_room(ENV(pl),BS(pl->Name()+" wankt stoehnend."), ({pl}) );
      if(random(3)) me->SetProp(P_X_HEALTH_MOD, 
        me->QueryProp(P_X_HEALTH_MOD)+([P_HP:-24])); break;
      
      case 3:
      tell_object(pl, BS(
        "Du hast extrem hohes Fieber, Dein Wahrnehmungssinn ist stark "
        "beeintraechtigt."));
      me->SetProp(P_X_ATTR_MOD, 
      me->QueryProp(P_X_ATTR_MOD)+([A_INT:-4])); break; }
      
      i++;
      wait=20+random(10);
    break;
    
    case 4:
      switch(random(3)) {
      
      case 0:
      tell_object(pl, BS(
        "An einigen Stellen Deines Koerpers bilden sich Schwellungen. "
        "Du hast unglaubliche Kopfschmerzen.")); break;
      
      case 1:
      tell_object(pl, BS(
        "Beulen bilden sich an Dir. Kopfschmerzen hast Du, Deine Glieder "
        "tun fuerchterlich weh."));
      if(!random(3)&&!pl->QueryProp(P_DISABLE_SPELLS))
        pl->SetProp(P_DISABLE_SPELLS,random(7)); break;
        
      case 2:
      tell_object(pl, BS(
        "Dicke Beulen entstehen an Deinem Leib, alles dreht sich..."));
      if(random(2)) me->SetProp(P_X_HEALTH_MOD, 
        me->QueryProp(P_X_HEALTH_MOD)+([P_HP:-28])); break; }
      
      AddCmd("brich|breche|brech&beulen|beule&auf",
      #'cmd_brechen,
      "Willst Du wirklich Deine BEULEN aufbrechen?|Willst Du wirlich Deine "
      "Beulen AUFbrechen?");
      
      i++;
      wait=25+random(10);
    break;
    
    case 5:
      switch(random(5)) {
      	
      case 0:
      tell_object(pl, BS(
        "Plumpe Beulen wachsen aus Deinem Fleisch, sie schmerzen bei "
        "Beruehrung. Deine Kopfschmerzen sind unertraeglich, Du keuchst."));
        
      //ENV(pl)->Message(BS(
      //  pl->Name()+" keucht. "+capitalize(pl->QueryPronoun())+" sieht sehr "
      //  "krank aus."),
      //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) ); 
      
      tell_room(ENV(pl),
        BS(pl->Name()+" keucht. "+capitalize(pl->QueryPronoun())+" sieht sehr "
        "krank aus."), ({pl}) );
      
      break;
      
      case 1:
      tell_object(pl, BS(
        "Du fuehlst Dich totkrank. Die Schmerzen machen Dich wahnsinnig!"));
      if(!random(3)&&!pl->QueryProp(P_DISABLE_SPELLS))
        pl->SetProp(P_DISABLE_SPELLS,random(7));
      if(random(2)) me->SetProp(P_X_HEALTH_MOD, ([P_HP:-(20+random(20)),
        P_SP:-(20+random(20)) ]) ); break;
      
      case 2:
      tell_object(pl, BS(
        "Dir ist ganz schwindelig, es dreht sich alles! Du wankst umher. "
        "Diese ekelhaften Beulen!"));
        
      //ENV(pl)->Message(BS(
      //  pl->Name()+" wankt umher und rempelt Dich an."),
      //MSGFLAG_SENSE,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      tell_room(ENV(pl),
        BS(pl->Name()+" wankt umher und rempelt Dich an."), ({pl}) );
        
      pl->AddHp(-random(26)); break;
      
      case 3:
      tell_object(pl, BS(
        "Deine Beine schmerzen dermassen, dass Du umstuerzt. Dabei faellst "
        "Du auf eine Beule. Sie platzt auf, Du bruellst auf vor Schmerz!"));
        
      //ENV(pl)->Message(BS(
      //  pl->Name()+" stuerzt um und bruellt vor Schmerz auf!"),
      //  MSGFLAG_SOUND,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      tell_room(ENV(pl),
        BS(pl->Name()+" stuerzt um und bruellt vor Schmerz auf!"),
        ({pl}) );
      
      pl->SetProp(P_LAST_RAMMEN_TIME, time() );
      //beulen_offen=1;
      pl->AddHp(-random(36)); break;
      
      case 4:
      tell_object(pl, BS(
        "Du hast starke Kopfschmerzen, Du fuehlst Dich elend. Die Beulen "
        "eitern.")); break; }
      
      ENV(pl)->Message(BS(
        "Wuah! "+pl->Name()+" scheint die Beulenpest zu haben, pass auf! "
        "Sie ist ansteckend!"),
      MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      i++;
      wait=15+random(10);
    break;
    
    case 6:
    switch(random(4)) {
      
      case 0:
      tell_object(pl, BS(
        "Die riesigen Beulen eitern stark. Dein Kopf pulsiert. Du koenntest "
        "die Beulen aufbrechen, ob das gut ist... Du weisst es nicht."));
      if(!random(3)&&!pl->QueryProp(P_DISABLE_ATTACK))
        pl->SetProp(P_DISABLE_ATTACK,random(9)); break;
        
      case 1:
      tell_object(pl, BS(
        "AAAAAAAAAARGH! Diese Schmerzen!! Dir wird kurz schwarz vor den "
        "Augen... Uff, gerade konntest Du noch stehen bleiben. Du hast "
        "hohes Fieber."));
        
      //ENV(pl)->Message(BS(
      //  pl->Name()+" kippt fast um."),
      //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      tell_room(ENV(pl), BS(pl->Name()+" kippt fast um."),({pl}) );
      
      if(!pl->QueryProp(P_DISABLE_ATTACK)) pl->SetProp(P_DISABLE_ATTACK,2);
      break;
      
      case 2:
      tell_object(pl, BS(
        "Aufgrund der starken Schmerzen kannst Du Dich nur noch langsam "
        "voranschleppen. Du nimmst Deine Umgebung nur noch getruebt wahr."));
        
      //ENV(pl)->Message(BS(
      //  pl->Name(WESSEN)+" Koerper ist von Beulen uebersaeht. Die Beulenpest "
      //  "hat "+pl->QueryPronoun(MALE,WER,SINGULAR)+" voll erwischt. Pass auf"
      //  ", dass "+pl->QueryPronoun()+" Dich nicht ansteckt!"),
      //  MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
      tell_room(ENV(pl), BS(
        pl->Name(WESSEN)+" Koerper ist von Beulen uebersaeht. Die Beulenpest "
        "hat "+pl->QueryPronoun(MALE,WER,SINGULAR)+" voll erwischt. Pass auf"
        ", dass "+pl->QueryPronoun()+" Dich nicht ansteckt!"), ({pl}) );
        
      me->SetProp(P_X_ATTR_MOD, me->QueryProp(P_X_ATTR_MOD)+([A_STR:-3]) );
      pl->do_exhaust(300+random(201)); break;
      
      case 3:
      tell_object(pl, BS(
        "Alles dreht sich. Dein Kopf ist ein riesiger Wal, Deine Beine und "
        "Arme bestueckt mit Nadeln, Dein ganzer Koerper uebersaeht von "
        "Kuerbissen. Du phantasierst..."));
      if(!pl->QueryProp(P_DISABLE_SPELLS)) 
        pl->SetProp(P_DISABLE_SPELLS, 10+random(21));
      if(!pl->QueryProp(P_DISABLE_ATTACK))
        pl->SetProp(P_DISABLE_ATTACK, 8+random(9));
      break;  }
      
      i++;
      wait=20+random(21);
    break;
    
    case 7:
    switch(random(3)) {
    	
      case 0:
      tell_object(pl, BS(
        "Aaaechz... Dein Gehirn, es pocht. Diese Beulen, ekelhaft eitrig. "
        "Ob Du sie aufbrechen solltest? Argh, Deine Arme schmerzen."));
        
      //ENV(pl)->Message(BS(
      //  pl->Name()+" aechzt von Schmerzen geplagt. Dicke Beulen uebersaehen "
      // +pl->QueryPossPronoun(MALE,WEN,SINGULAR)+" Koerper."),
      //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) ); 
      
      tell_room(ENV(pl), BS(
        pl->Name()+" aechzt von Schmerzen geplagt. Dicke Beulen uebersaehen "
        +pl->QueryPossPronoun(MALE,WEN,SINGULAR)+" Koerper."), ({pl}) );
      
      break;
      
      case 1:
      tell_object(pl, BS(
        "Kopfschmerzen! Unbeschreibliche Kopfschmerzen! Du verlierst "
        "die Konzentration... und dann noch diese Beulen."));
      if(!pl->QueryProp(P_DISABLE_SPELLS)) pl->SetProp(P_DISABLE_SPELLS, 4);
      if(!pl->QueryProp(P_DISABLE_ATTACK)) pl->SetProp(P_DISABLE_ATTACK, 6);
      break;
      
      case 2:
      tell_object(pl, BS(
        "Das bringt Dich um, DAS BRINGT DICH UM!!! DIESE SCHMERZEN! Oh, "
        "ploetzlich wird alles taub ... ah ... das Fieber truebt Deine Sinne. "
        "Auch die Schmerzwahrnehmung, Erleichterung, kurzfristig..."));
      me->SetProp(P_X_HEALTH_MOD, me->QueryProp(P_X_HEALTH_MOD)+
        ([P_SP:-40]) ); break; }
      
      i=5;
      wait=20+random(26);
    break;

// --------------------------------------------------------------------------
// ----- ABORTIVE PEST ------------------------------------------------------
// --------------------------------------------------------------------------

    case 50:
      switch(random(3)) {
      	
      	case 0:
        tell_object(pl, BS(
          "Du fuehlst Dich unwohl.")); break;
        case 1:
        tell_object(pl, BS(
          "Dein Kopf tut ein wenig weh.")); break;
        case 2:
        tell_object(pl, BS(
          "Du hast leichte Kopfschmerzen.")); break; }
        
        i++;
        wait=35+random(11);
      break;
      
    case 51:
      switch(random(3)) {
      	
      	case 0:
      	tell_object(pl, BS(
      	  "Du hast staerkere Kopfschmerzen. Leichte Schwellungen bilden "
      	  "sich an Deinem Koerper.")); break;
      	case 1:
      	tell_object(pl, BS(
      	  "Es bilden sich Schwellungen an Deinem Koerper. Deine Glieder "
      	  "schmerzen ein wenig.")); break;
      	case 2:
      	tell_object(pl, BS(
      	  "Deine Arme tun weh. Kleine Beulen wachsen auf Deinem Koerper. "
      	  "Was bedeutet das?")); break; }
      	
      	i++;
      	wait=25+random(9);
      break;
      
      case 52:
      switch(random(4)) {
      	
      	case 0:
      	tell_object(pl, BS(
      	  "Du bekommst starke Kopfschmerzen. Du glaubst, ein wenig Fieber "
      	  "zu haben."));
      	  
      	//ENV(pl)->Message(BS(
      	//  pl->Name()+" scheint Kopfschmerzen zu haben."),
        //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
        
        tell_room(ENV(pl), 
          BS(pl->Name()+" scheint Kopfschmerzen zu haben."), ({pl}) );
        
      	pl->AddHp(-random(30)); break;
      	
      	case 1:
      	tell_object(pl, BS(
      	  "Du hast Fieber. Deine Glieder tun ein wenig weh, Dein Fleisch "
      	  "schwillt stellenweise leicht an."));
      	me->SetProp(P_X_HEALTH_MOD, me->QueryProp(P_X_HEALTH_MOD)+
      	  ([P_HP:-23]) ); 
      	  
      	//ENV(pl)->Message(BS(
      	//  "Auf "+pl->Name(WESSEN)+" Koerper bilden sich leichte "
      	//  "Schwellungen"),
        //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) ); 
        
        tell_room(ENV(pl), BS(
          "Auf "+pl->Name(WESSEN)+" Koerper bilden sich leichte "
      	  "Schwellungen"), ({pl}) );
        
        break;
      	  
      	case 2:
      	tell_object(pl, BS(
      	  "Du hast leichtes Fieber. Dein Kopf schmerzt."));
      	  
      	//ENV(pl)->Message(BS(
      	// pl->Name()+" fuehlt sich nicht wohl."),
        //MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
        
        tell_room(ENV(pl), BS(
          pl->Name()+" fuehlt sich nicht wohl."), ({pl}) );
        
      	break;
      	
      	case 3:
      	tell_object(pl, BS(
      	  "Dir ist ein bisschen schwindelig. Kopfweh hast Du auch."));
      	if(!pl->QueryProp(P_DISABLE_SPELLS))
      	  pl->SetProp(P_DISABLE_SPELLS,4); break; }
      	
      	i++;
      	wait=15+random(21);
      break;
      
      case 53:
      switch(random(3)) {
      	
      	case 0:
      	tell_object(pl, BS(
      	  "Kopfschmerzen! Argh!!"));
      	pl->AddHp(-11); break;
      	
      	case 1:
      	tell_object(pl, BS(
      	  "Kurz wird Dir so schwindelig, dass Du fast umkippst!"));
      	if(pl->QueryProp(P_WEAPON))
      	 {
      	   tell_object(pl, BS(
      	     "Deine Waffe faellt Dir aus der Hand!"));
      	   pl->DoUnwield();
      	 }
      	break;
      	
      	case 2:
      	tell_object(pl, BS(
      	  "Die Schwellungen schmerzen ein wenig. Viel mehr jedoch schmerzt "
      	  "Dein Kopf."));
      	  
      	//ENV(pl)->Message(BS(
      	//  pl->Name()+" ist nicht ganz gesund."),
        //  MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) ); 
          
        tell_room(ENV(pl), BS(
          pl->Name()+" ist nicht ganz gesund."), ({pl}) );
        
        break; }
      	
      	i=75;
      	wait=20+random(21);
     break;
      
// --------------------------------------------------------------------------
// ----- HEILUNG DER BEULENPEST UND ABORTIVEN PEST --------------------------
// --------------------------------------------------------------------------

    case 75:
    switch(random(3)) {
      
      case 0:
      tell_object(pl, BS(
        "Die Beulen schwellen ab, Du fuehlst Dich ein ganz klein wenig "
        "besser.")); break;
      case 1:
      tell_object(pl, BS(
        "Deine Kopfschmerzen werden schwaecher, auch die Schwellungen "
        "scheinen zurueck zu gehen.")); break;
      case 2:
      tell_object(pl, BS(
        "Deine Glieder schmerzen noch, aber die Beulen scheinen zu heilen."));
      break; }
      
    //ENV(pl)->Message(BS(
    //  pl->Name()+" scheint sich zu erholen."),
    //  MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
    tell_room(ENV(pl), BS(
      pl->Name()+" scheint sich zu erholen."), ({pl}) );
      
      i++;
      wait=20+random(30);
    break;
    
    case 76:
    switch(random(3)) {
      
      case 0:
      tell_object(pl, BS(
        "Das Fieber sinkt, des Schwindelgefuehlt verschwindet langsam."));
      break;
      
      case 1:
      tell_object(pl, BS(
        "Die Schmerzen lassen nach. Die Beulen verschwinden allmaehlich. "
        "Dein Kopf tut noch weh."));
      break;
      
      case 2:
      tell_object(pl, BS(
        "Du fuehlst Dich besser, Dein Kopf ist nicht mehr so heiss."));
      break; }
      
      i++;
      wait=40+random(11);
    break;
    
    case 77:
    switch(random(3)) {
      
      case 0:
      tell_object(pl, BS(
        "Du gewinnst Deine Wahrnehmung zurueck, die Beulen sind fast "
        "komplett verheilt."));
      break;
      
      case 1:
      tell_object(pl, BS(
        "Deine Kopfschmerzen sind fast voellig verschwunden, Du "
        "fuehlst Dich wesentlich besser!"));
      break;
      
      case 2:
      tell_object(pl, BS(
        "Deine Glieder schmerzen nicht mehr, die Schwellungen sind beinahe "
        "vollstaendig verheilt."));
      break; }
      
      i++;
      wait=30+random(61);
    break;
    
    case 78:
    pl->SetProp("pest_immunitaet",time());
    tell_object(pl, BS(
      "Du hast die Pest ueberwunden! YIEHA!"));
    pl->command_me("hops");
    pl->command_me("knuddel alle");
    set_old_title(pl);
    me->remove(1);
    i=-1;
    wait=10;
    break;
    
// --------------------------------------------------------------------------
// ----- UEBERGANG BEULENPEST ZU LUNGENPEST ---------------------------------
// --------------------------------------------------------------------------

   case 90:
   switch(random(2)) {
     
     case 0:
     tell_object(pl, BS(
       "Das Fieber und die starken Schmerzen sind wohl nicht genug, "
       "ploetzlich musst Du stark Husten! AAAAARGH! Das brennt in der "
       "Lunge!"));
       
     //ENV(pl)->Message(BS(
     //  pl->Name()+" hustet stark."),
     //  MSGFLAG_SOUND,([MSGFLAG_EXCLUDE:({pl}) ]) ); 
      
     tell_room(ENV(pl), BS(
       pl->Name()+" hustet stark."), ({pl}) );
    
    break;
     
     case 1:
     tell_object(pl, BS(
       "Die Beulen tun weh, Dir ist unglaublich schwindelig, Dein Kopf "
       "Schmerzt. *HUST* *HUST* Das brennt in der Lunge!"));
       
     //ENV(pl)->Message(BS(
     //  pl->Name()+" hustet ploetzlich stark."),
     //  MSGFLAG_SOUND,([MSGFLAG_EXCLUDE:({pl}) ]) ); 
      
     tell_room(ENV(pl), BS(
       pl->Name()+" hustet ploetzlich stark."), ({pl}) );
     
     break; }
     
     i++;
     wait=25+random(11);
   break;
   
   case 91:
   switch(random(3)) {
     
     case 0:
     tell_object(pl, BS(
       "*HUSTHUSTHUST* AAAAAAAAAAAAAAAARRRRRRRRGHHHHH!! Die Schmerzen "
       "sind unertraeglich beim Husten! Die Beulen eitern stark."));
       
     //ENV(pl)->Message(BS(
     //  pl->Name()+" schreit beim Husten vor Schmerz laut auf!"),
     //  MSGFLAG_SOUND,([MSGFLAG_EXCLUDE:({pl}) ]) );
      
