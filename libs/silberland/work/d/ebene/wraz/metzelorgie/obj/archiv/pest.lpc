  // ich mag lange formeln!
    i=75; // man wird geheilt (nur moeglich bei Beulenpest und abortiver Pest)
  
  if(i>4&&i<8&&random(100)<7) i=100; // Uebergang zur Lungenpest
  else if(i>4&&i<8&&random(100)<3) i=200; // Schwarzer Tod
  
  switch(i)
  {
    case 1..6: // beulen
      call_out("warn",0,1, pl); break;
      
    case 90..104: // lungen
      call_out("warn",0,2, pl); break;
      
    case 200..203: // schwarz
      call_out("warn",0,3, pl); break;
      
    default: break;
  }
  
  if(i>-1) call_out("pest",wait);
  return;
}

// BECOMESNETALIVE -----------------------------------------------------------

void BecomesNetAlive(object player)
{
  call_out("pest",0);
  return;
}

// MAY DIE -------------------------------------------------------------------

void may_die(int hp, object pl)
{
  if(!hp||!pl) return;
  if(!interactive(pl)) return;
  
  if(query_idle(pl)>350)
  { 
    pl->AddHp(-hp); 
    if(pl->QueryProp(P_HP)<100) pl->SetProp(P_HP, 100); 
  }
  // idelnde spieler (5 minuten) mindestens 100 lp
  else pl->do_damage(hp,me);
  return;
}

// MAY IMMEDIATELY DIE -------------------------------------------------------

void may_immediately_die(object pl)
{
  if(query_idle(pl)<350) pl->die(1);
  else pl->AddHp(-500);
  set_old_title(pl);
  me->remove(1);
  return;
}

// CMD BRECHEN ---------------------------------------------------------------

int cmd_brechen(string str)
{
  tell_object(TP, BS(
    "Du brichst eine Deiner Beulen auf und schreist laut vor Schmerz! Eiter "
    "gemischt mit Blut sickert aus der Wunde, das haettest Du nicht tun "
    "sollen!"));
  
  tell_room(ENV(TP), BS(
    TPN+" bricht eine Beule auf seinem Koerper auf und schreit wild auf!"),
    ({TP}) );
  
  TP->AddHp(-(30+random(40)) );
  
  return 1;
}

// NEW_TITLE -----------------------------------------------------------------

void new_title(object player)
{
  if(!player) return;
  if(!query_once_interactive(player)) return;
  
  if(player->QueryProp(P_PRESAY)!="Pestkranker "||
     player->QueryProp(P_PRESAY)!="Pestkranke ")
    old_presay=player->QueryProp(P_PRESAY);
       
  if(player->QueryProp(P_TITLE)!=""||
     player->QueryProp(P_TITLE) )
   old_title=player->QueryProp(P_TITLE);
  
  player->SetProp(P_TITLE, "");
  
  if(player->QueryProp(P_GENDER)==FEMALE)
    player->SetProp(P_PRESAY, "Pestkranke");
  
  else player->SetProp(P_PRESAY, "Pestkranker");
  
  return;
}

// SET OLD TITLE -------------------------------------------------------------

void set_old_title(object player)
{
  if(!player) return;
  if(!query_once_interactive(player)) return;
  
  player->SetProp(P_TITLE, old_title);
  player->SetProp(P_PRESAY, old_presay);
  
  return;
}

// SET I ---------------------------------------------------------------------

int set_i(int new_i)
{
  if(new_i<0) return -1;
  
  i=new_i;
  return i;
}

// MAY CONTRACT PEST ---------------------------------------------------------

void may_contract_pest(object pl)
{
  object *players;
  object victim;
  int counter;
  
  if(!ENV(pl)) return;
  if( random(100) > 40 ) return;
  
  players=filter_array(all_inventory(ENV(pl)), #'interactive);
  players=filter_array(players, "not_tp");
  
  victim=players[random( sizeof(players) )];
  
  if( victim->QueryProp(P_LEVEL) <= 35 ) return;
  if( !member(informed, victim->Name()) || 
       informed[victim->Name()]>time()-10 ) return;
       
  tell_object( pl, BS(
    "*KEUCH* *HUST* Du hustest "+victim->Name()+" voll ins Gesicht!"));
  
  tell_object( victim, BS(
    pl->Name()+" hustet Dir ins Gesicht! So ein Ferkel!"));
  
  tell_room( ENV(victim), BS(
    pl->Name()+" hustet "+victim->Name()+" ins Gesicht. So ein Ferkel!"),
    ({victim,pl}) );
    
  call_other(OBJ "pest", "???");
  
  if(!present(find_object(OBJ "pest"), victim))
    clone_object(OBJ "pest")->move(victim, M_NOCHECK);
    
  return;
}

// NOT TP --------------------------------------------------------------------

int not_tp(object player)
{
  if(player==ENV(TO)) return 0;
  else return 1;
}

// WARN ----------------------------------------------------------------------

void warn(int type, object pl)
{
  string *mes;
  object *players;
  int counter;
  
  if(!ENV(pl)) return;
  
  players=filter_array(all_inventory(ENV(pl)), #'interactive);
  players=filter_array(players, "not_tp");
  
  if(!players) return;
  
  mes=({  
    /*0*/ "bug, bitte melden", // buffer
    
    /*1*/ getcolor("bred")+getcolor("bold")+
          "ACHTUNG:\n"+getcolor("none")+
          ENV(TO)->Name()+" ist pestkrank! DIE PEST IST ANSTECKEND! Halte "
          "Dich von "+ENV(TO)->QueryPronoun(WEM)+" fern!\n"
          "Das ist eine ernste Warnung!\n",
          
    /*2*/ getcolor("bred")+getcolor("bold")+
          "!!! ACHTUNG !!!\n"+getcolor("none")+getcolor("bold")+
          ENV(TO)->Name()+" ist SCHWER pestkrank! DIE PEST IST ANSTECKEND! "
          "Sie kann leicht zum TOD fuehren!\n"
          "Das ist eine SEHR ERNSTZUNEHMENDE Warnung!!\n"+getcolor("none"),
          
    /*3*/ getcolor("bred")+getcolor("bold")+getcolor("blink")+
          "-- !!! ACHTUNG !!! --\n"+getcolor("none")+getcolor("bold")+
          ENV(TO)->Name()+" ist SEHR SCHWER pestkrank! DIESE FORM DER PEST "
          "IST TOEDLICH UND ANSTECKEND!\n"
          "VERSCHWINDE SOFORT!\n"
          "Diese WARNUNG ist ernstzunehmen!\n"+getcolor("none")
      });
  
  for(counter=0;counter<sizeof(players);counter++)
  {
    if(!member(informed, players[counter]->Name())) informed[players[counter]]=0;
    
    if( informed[players[counter]->Name()]>=(time()-80) && 
        informed[players[counter]->Name()]!=0)
      continue;

      tell_object( players[counter], mes[type] );
      informed[players[counter]->Name()]=time();
  }
  
  return;
}

// QUERY TIME ----------------------------------------------------------------

int query_time(string asdf)
{
  return informed[asdf];
}