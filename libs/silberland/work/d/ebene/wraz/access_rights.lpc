
int access_rights(string name, string file, int readflag, int def)
{
  name=lower_case(name);

  if(name=="gobblin")
     return 0;
  if(name=="beowulf")
     return 0;

  // unnoetig?
  if (file == "metzelorgie/obj/pest" && readflag) return 1;
	if (file == "metzelorgie/master/master.lpc" && readflag) return 1;
	if (file == "metzelorgie/master/save_master" && readflag) return 1;

return 0;
}
