inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"guertel", "werkzeugguertel", "gnomischer werkzeugguertel"}));
  SetProp (P_SHORT, "Ein gnomischer Werkzeugguertel");
  SetProp (P_LONG,
	   "Ein gnomischer Werkzeugguertel. Er bietet Platz fuer alle "
	   +"moeglichen Werzeuge gnomischer Bauart.\n");
  SetProp (P_NAME, "Werkzeugguertel");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 200);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_BELT);  // siehe sys/combat.h
  SetProp (P_AC, 1);
  SetProp (P_MATERIAL, ([MAT_MISC_METAL:50, MAT_LEATHER:50]));
}
