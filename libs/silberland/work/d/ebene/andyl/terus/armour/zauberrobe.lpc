inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"robe", "zauberrobe"}));
  SetProp (P_SHORT, "Eine Zauberrobe");
  SetProp (P_LONG,
	   "Das ist Terus Zauberrobe. Sie besteht aus dunkelblauem Stoff und ist "
	   +"mit golden und silbernen Runen und auf der Rueckseite  "
	   +"mit einem Bauplan einer gnomischen Flugmaschine bestickt worden. "
	   +"Sie leuchtet permanent in einer violetten Farbe.\n");
  SetProp (P_NAME, "Zauberrobe");
  SetProp (P_INFO, "Diese Robe ist magisch durchwirkt und leuchtet deswegen permanent "
	   +"in einem violettem Licht.\n");
  SetProp (P_MAGIC, 1);
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 1000);
  SetProp (P_NOBUY, 1);
  SetProp (P_LIGHT, 1);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 5);
  SetProp (P_MATERIAL, MAT_CLOTH);
}
