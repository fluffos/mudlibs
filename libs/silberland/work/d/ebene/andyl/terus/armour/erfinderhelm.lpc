inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"helm", "erfinderhelm", "gnomischer Erfinderhelm"}));
  SetProp (P_SHORT, "Ein gnomischer Erfinderhelm");
  SetProp (P_LONG,
	   "Das ist ein Gnomischer Erfinderhelm. An ihm sind Lupen, Zangen, "
	   +"Schraubenzieher, Haemmer und jede Menge anderer Werkzeuge und Hilfsmittel "
	   +"montiert. Die Benutzung der Gegenstaende erscheint Dir jedoch etwas kompliziert, "
	   +"vor allem wenn man bedenkt, dass man den Helm eigentlich auf dem Kopf traegt.\n");
  SetProp (P_NAME, "Erfinderhelm");
  SetProp (P_INFO, "Dieser Erfinderhelm ist magisch verstaerkt worden um offenbar "
	   +"den Erfindungsgeist des Traegers anzuregen. Ob das so eine gute Idee ist?");
  SetProp (P_MAGIC, 1);
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 600);
  SetProp (P_VALUE, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 1);
  SetProp (P_MATERIAL, ([MAT_WOOD:60, MAT_MISC_METAL:30, MAT_LEATHER:10]));
}
