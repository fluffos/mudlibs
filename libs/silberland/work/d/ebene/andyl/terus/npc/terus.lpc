inherit "std/npc";

#include <language.h>
#include <combat.h>
#include "../def.h"

create()
{
  
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Terus der Halbgnom");
  SetProp(P_LONG, "Das ist Terus der Halbgnom. Sein Aussehen wirkt "
	  +"groesstenteils gnomisch. Er hat die bei Gnomen verbreitete graue, "
	  +"fast voellig haarlose Haut, gruene Augen, ein einsames Haarbueschel "
	  +"auf dem Kopf und grosse Ohren, allerdings ist er fast so gross wie "
	  +"ein Mensch. Zudem traegt er neben gnomischen Utensilien eine "
	  +"Zauberrobe, was fuer Gnome sehr ungewoehnlich ist, da sie "
	  +"normalerweise fuer Magie nichts uebrig haben. Er ist mit Sicherheit "
	  +"eine sehr interessante Persoenlichkeit.\n");
  SetProp(P_NAME, "Terus");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"terus", "halbgnom", "halbmensch"})); 
  
  create_default_npc( 30 );
  
  SetProp(P_SIZE, 160);
  SetProp(P_BODY, 4);
  SetProp(P_HANDS, ({" mit seinen Haenden", 20, DT_BLUDGEON}));
  SetProp(P_ALIGN, 400 ); 
  SetProp(P_RACE, "Halbgnom");
  SetProp(P_NOATTACK, "weicht deinem Angriff so beilaeufig aus als haette er ihn gar nicht bemerkt.");

  // ITEMS

  CLONEME((ARMOUR+"werkzeugguertel"));
  CLONEME((ARMOUR+"zauberrobe"));
  CLONEME((ARMOUR+"erfinderhelm"));
  
  command_me("trage alles");
  
  SetChats(3, ({
    "Terus gruebelt eine Weile vor sich hin.\n",
      "Terus wuehlt in seinen Sachen herum.\n"}) );
  
  // INFOS UEBER NPCS / MAGIER

  AddInfo(({"artyrian", "gildenmeister", "freund"}),
	  "Oh, Arytrian ist ein alter Freund von mir. Soll jetzt ne eigene Gilde betreuen. "
	  +"Tolle Sache das.\n", "sagt: ");
  AddInfo(({"gilde", "bardengilde"}),
	  "Also ich kenn nur die Bardengilde. Mein alter Freund Artyrian ist der "
	  +"Gildenmeister davon.\n", "sagt: ");
  AddInfo(({"brabo", "brabo glasfuss", "kinathias"}),
	  "Soweit ich weiss ist das ein Bekannter meines Freundes Artyrian.\n", "sagt: "); 
  AddInfo(({"irinja", "irinja avia"}),
	  "Soweit ich weiss ist das eine Bekannter meines Freundes Artyrian.\n", "sagt: ");
  AddInfo(({"andyl", "soundmagier"}),
	  "Andyl der Soundmagier? Ja den kenn ich. Schaut hin und wieder hier vorbei und "
	  "hilft mir bei diesem und jenem.\n");
  
  // ETWAS WISSEN UEBER SEINE AUSRUESTUNG (STILL TODO)

  
  // ETWAS WISSEN UEBER DIE EBENE (STILL TODO)

  
  // ETWAS WISSEN UEBER DIE GILDENQUEST(STILL TODO)
  

  AddInfo( DEFAULT_INFO,
	   ({ "meint: Erzaehl mir mehr darueber.\n",
		"fragt: Kann man damit Magie hervorrufen?\n",
		"kratzt sich unwissend am Kopf.\n",
		"meint: Hoert sich nach einer Gnomenerfindung an.\n",
		"sagt: Tut mir leid, darueber weiss ich nichts.\n",
		"fragt: Ist das ein Hobby von Dir?.\n"
		}) );
}

// REACTIONS

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
    {
    case "fies":
      call_out("react", 0, "verpasst Dir dafuer eine Kopfnuss und meint: Lass das!",
	       "verpasst "+TP->name(WEN)+" eine Kopfnuss und meint: Lass das!");
      TP->AddHp(-2);
      break;
    case "aergerlich":
      call_out("react", 0, "blaettert geistesabwesend in seinen Notizen herum", 
	       "blaettert geistesabwesend in seinen Notizen herum");
      break;
    case "traurig":
      call_out("react", 0, "meint: Ach das wird schon wieder "+TP->name(WER),
	       "meint: Ach das wird schon wieder "+TP->name(WER));
      break;
    case "albern":
      call_out("react", 0, "grinst Dich an",
	       "grinst "+TP->Name(WEN)+" an.");
      break;
    case "neutral":
      call_out("react", 0, "gruebelt etwas vor sich hin", "gruebelt etwas vor sich hin");
      break;
    case "intim":
      call_out("react", 0, "brummt: Kauf lieber etwas.",
	       "brummt zu "+TP->name(WEN)+": Kauf lieber etwas");
      break;
    case "froh":
      call_out("react", 0, "huepft froehlich um Dich herum",
	       "huepft froehlich um "+TP->name(WEN)+" herum");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Du brauchst wirklich keine Angst zu haben "+TP->name(WER),
	       "meint: Du brauchst wirklich keine Angst zu haben "+TP->name(WER));
      break;
    case "frech":
      call_out("react", 0, "meint: Nana, nur nicht frech werden!", 
	       "meint zu "+TP->name(WEM)+": Nana, nur nicht frech werden!");
      break;
    case "nett":
      call_out("react", 0, "grinst Dich an", "grinst "+TP->name(WEN)+" an");
      break;
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


































