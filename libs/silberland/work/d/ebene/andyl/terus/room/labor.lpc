#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Labor von Terus" );
  SetProp(P_INT_LONG,
	  "Du stehst hier im Labor von Terus dem Halbgnom. "
	  +"Wenn Du Dir das Chaos hier ansiehst kommst Du zu dem Schluss, dass "
	  +"bei Terus wohl hauptsaechlich seine gnomische Seite ueberwiegt. "
	  +"Reagenzglaeser in allen Farben und Formen, seltsamste "
	  +"Geraetschaften und Manuskripte liegen quer ueber den Raum verteilt. "
	  +"Und inmitten dieses ganzen Chaos wieselt Terus emsig hin und her. Vier "
	  +"Tueren kannst Du ausserdem noch entdecken, ebenso eine seltsame "
	  +"Holzkonstruktion an welcher ein Hebel befestigt ist.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  
  
  AddDetail(({"anschein", "seite"}),
	    "Allem Anschein nach duerfte bei Terus die gnomische Seite ueberwiegen.\n");
  AddDetail(("boden"),
	    "Der Boden ist unter den vielen Zeug welches hier herumliegt kaum noch "
	    +"zu sehen. Es duerfte sich aber um einen gnomischen Fliesenboden handeln.\n");
  AddDetail(("zeug"),
	    "Alles moegliche, von Manuskripten bis Reagenzglaeser.\n");
  AddDetail(({"gnomischen fliesenboden", "fliesenboden", "boeden"}),
	    "Aufgrund der hohen Unfallrate bei Gnomen neigen diese dazu ihre Boeden "
	    "extrem wiederstandsfaehig und vor allem feuerfest zu machen.\n");
  AddDetail(("unfallrate"),
	    "Angeblich soll diese bei Gnomen sehr hoch sein. Ob da was dran ist?\n");
  AddDetail(("manuskripte"),
	    "Hauptsaechlich irgendwelche gnomischen Bauanleitungen aber auch "
	    +"Buecher ueber Magie.\n");
  AddDetail(({"bauanleitungen", "index", "fremdwoerter"}),
	    "Gnomische Bauanleitungen zeichnen sich vor allem dadurch aus, dass "
	    +"sie extrem lang und mit Fremdwoertern vollgestopft sind, keinen Index haben "
	    +"und nur von Gnomen verstanden werden.\n");
  AddDetail(({"gnome", "gnom", "volk"}),
	    "Gnome sind ein sehr fleissiges, gutmuetiges aber extremst chaotisches Volk.\n");
  AddDetail(({"magie", "buecher"}),
	    "Magie in Kombination mit gnomischen Bauanleitungen? Du ahnst Schlimmes.\n");
  AddDetail(({"kombination", "erfindungsgeist"}),
	    "Gnomischen Erfindungsgeist mit Magie zu koppeln kann ja eigentlich nur "
	    +"schief gehen.\n");
  AddDetail(("schlimmes"),
	    "Sehr Schlimmes!\n");
  AddDetail(("decke"),
	    "In der steinernen Decke sind einige Ritzen zu erkennen. Ob das was zu "
	    +"bedeuten hat?\n");
  AddDetail(("ritzen"),
	    "Du hast das ungute Gefuehl das Du noch frueh genug herausfinden wirst wozu "
	    +"diese Ritzen da sind.\n");
  AddDetail(("gefuehl"),
	    "Kein gutes Gefuehl.\n");
  AddDetail(({"waende", "wand", "steinwand", "steinwaende"}),
	    "Es sind einfache Steinwaende. Du siehst in ihr nur die "
	    +"Umrisse der Klappe durch die Du hier hereingekracht bist.\n");
  AddDetail(({"umrisse", "klappe"}),
	    "Die Umrisse der jetzt geschlossenen Klappe durch die Du hier "
	    +"hereingekracht bist sind deutlich an der Wand zu erkennen.\n");
  AddDetail(("labor"),
	    "Dies ist das Labor von Terus dem Halbgnomen.  Es ist ein "
	    +"typisch gnomisches Chaos. Alles liegt quer uebereinander und "
	    +"allen das Durchqueren des Raumes bereitet Schwierigkeiten.\n");
  AddDetail(({"durchqueren", "schwierigkeiten"}),
	    "Das Durchqueren des Raumes bereitet Dir echte Schwierigkeiten.\n");
   AddDetail(("chaos"),
	    "Ein typisch gnomisches Chaos. Alles liegt quer durcheinander und "
	    +"man hat Muehe von einem Eck des Raumes zum anderen zu gelangen.\n");
  AddDetail(({"eck", "ecke"}),
	    "Du hast ziemliche Muehe dabei von einer Ecke des Raumes in die "
	    +"andere zu gelangen.\n");
  AddDetail(({"raum"}),
	    "Dieser Raum ist das Labor von Terus dem Halbgnomen.\n");
  AddDetail(("terus"),
	    "Dem gehoert diese Labor.\n");
  AddDetail(("halbgnom"),
	    "Waere sicher interessant zu wissen wie ein Halbgnom zustande kommt.\n"); 
  AddDetail(("muehe"),
	    "Und zwar ziemlich groooosse Muehe. *keuch*\n");
  AddDetail(({"tueren", "tueren"}),
	    "Vier etwas schief haengende Tueren. Eine fuehrt nach Nordwesten, eine "
	    +"nach Nordosten, eine nach Suedwesten und die letzte nach Suedosten.\n");
  AddDetail(({"geraetschaften"}),
	    "Hauptsaechlich gnomische Erungenschaften, bei welchen Du nicht "
	    +"annaehernd erraten kannst wozu diese gut sein sollen.\n");
  AddDetail(({"erungenschaften", "vorsicht"}),
	    "Gnomische Erungenschaften sind immer mit groesster Vorsicht zu geniessen "
	    +"oder besser ueberhaupt zu meiden.\n");
  AddDetail(("holzkonstruktion"),
	    "Eine hoechste seltsame Holzkonstruktion. Eine kleine Plattform ist auf "
	    +"ihr montiert, ebenso ein Hebel.\n");
  AddDetail(("plattform"),
	    "Eine hoelzerne Plattform die auf der Holzkonstruktion befestigt ist. "
	    +"Wozu die wohl gut ist?\n");
  AddDetail(("hebel"),
	    "Der Hebel ist an der seltsamen Holzkonstruktion befestigt. Ob man daran "
	    +"wohl ziehen sollte?\n");
  AddDetail(({"reagenzglaeser", "glaeser", "reagenzglas", "glas"}),
	    "Reagenzglaeser in allen Formen, Farben und Groessen liegen quer verstreut "
	    +"ueber den Raum. Manche davon sind mit Fluessigkeiten gefuellt, andere mit "
	    +"Pulvern und manche sind leer.\n");
  AddDetail(({"groesse", "groessen"}),
	    "Alles da, von ganz klein bis sehr gross.\n");
  AddDetail(("farben"),
	    "Gaaaanz viele verschiedene Farben.\n");
  AddDetail(("formen"),
	    "Echt tolle Formen, von pinguinfoermig bis zu abstrakt eckig ist alles zu finden.\n");
  AddDetail(({"pulver", "fluessigkeiten", "fluessigkeit", "schluss"}),
	    "Obwohl du neugierig bist, kommst Du zu dem Schluss, dass es wohl besser "
	    +"ist nicht so genau zu wissen um was es sich handelt.\n");
  AddDetail(("fall"),
	    "Nein, das wird hier sicher nicht naeher erklaert.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
            "Hier herrscht ein ziemlich seltsamer Geruch. Kein wunder "
	    +"bei dem Mischmasch aus verschiedenen Aromen.\n");
  AddSmell( ({"mischmasch", "aromen", "aroma"}),
	    "Hier herrscht so ein Mischmasch von Aromen, dass Du kaum "
	    +"etwas auch nur annaehernd erkennen koenntest.\n");
  AddSound(({DEFAULT_SOUND, "geraeusche"}),
	   "Du hoerst Blubbern, Haemmern, Rasseln, Quietschen und noch vieles mehr.\n");
  AddSound(({"blubbern", "haemmern", "rasseln", "quietschen"}),
	   "Eines der vielen typischen Geraeusche in dem Labor eines Gnomes oder, wie "
	   +"in diesem Fall, eines Halbgnomes.\n");
  
  // EXITS
  
  AddSpecialExit( "nordosten", "nordosten_geh");
  AddSpecialExit( "nordwesten", "nordwesten_geh");
  AddSpecialExit( "suedosten", "suedosten_geh");
  AddSpecialExit( "suedwesten", "suedwesten_geh");

  // ITEMS

  AddItem(NPC+"terus", REFRESH_DESTRUCT); 
  
  // COMMANDS

  previous_object()->CustomizeObject();
}

nordosten_geh()
{  
  TP->move(ROOM+"lesezimmer:"+getuid(this_player()), M_GO);
  return 1;
}

nordwesten_geh()
{  
  TP->move(ROOM+"lagerraum:"+getuid(this_player()), M_GO);
  return 1;
}

suedosten_geh()
{  
  TP->move(ROOM+"werkstatt:"+getuid(this_player()), M_GO);
  return 1;
}

suedwesten_geh()
{  
  TP->move(ROOM+"kueche:"+getuid(this_player()), M_GO);
  return 1;
}

void reset()
{
  ::reset();  
}
