#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int rahmen=1;


void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Lesezimmer von Terus" );
  SetProp(P_INT_LONG,
	  "Das Lesezimmer von Terus. Wie man von so einem Ort erwartet "
	  +"befinden sich hier haufenweise Buecher und verschiedenste "
	  +"Manuskripte. Diese sind jedoch nach keinem Dir bekannten "
	  +"System geordnet. Sieht eher aus als haette jemand alle diese "
	  +"Buecher wuest ohne Plan auf einen Haufen geworfen. Neben dem "
	  +"Haufen steht ausserdem noch Schaukelstuhl. Ein "
	  +"Greifarm der von der Decke baumelt faellt Dir auf. Durch eine "
	  +"Tuer im Suedwesten kannst Du wieder zurueck in das Labor "
	  +"gelangen.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS


  AddDetail(({"raum", "lesezimmer", "ort"}),
	    "Du befindest Dich hier im Lesezimmer von Terus.\n");
  
  
  AddDetail(({"system", "sicherheit"}),
	    "Mit Sicherheit kein System welches Dir bekannt waere.\n");
  AddDetail(("plan"),
	    "Voellig ohne Plan.\n");

  AddDetail(({"boden", "holzboden"}),
	    "Ein einfacher Holzboden ueber den ueberall Buecher und Manuskripte "
	    +"verteilt sind. Auch einige Ritzen kannst Du im Boden entdecken.\n");
  AddDetail(({"decke", "holzdecke"}),
	    "Von der hoelzernen Decke baumelt ein seltsamer Greifarm herab welcher an einer "
	    +"Kette befestigt ist.\n");
  AddDetail(({"greifarm", "arm"}),
	    "Der Greifarm baumelt an einer Kette welche an der Decke befestigt ist.\n");
  AddDetail(({"waende", "wand", "auffaelliges"}),
	    "Schlichte holzverkleidete Waende. Nichts Auffaelliges an ihnen zu entdecken.\n");
  AddDetail(("ritzen"),
	    "Eine Ritze faellt Dir besonders auf.\n");
  AddDetail(("ritze"),
	    "In der scheint etwas drinnen zu sein. Du koenntest ja mal reingreifen.\n");
  AddDetail(({"buecher", "manuskripte", "haufen"}),
	    "Ein grosser Haufen an Buechern und Manuskripten liegt hier im Raum verteilt. "
	    +"Eine Erhebung in dem Haufen faellt Dir auf.\n");
  AddDetail(("erhebung"),
	    "Als Du die Erhebung naeher untersuchst entdeckst Du einen Schreibtisch der "
	    +"unter den Buechern begraben war.\n");
  AddDetail(({"schreibtisch", "tisch", "holztisch"}),
	    "Ein einfacher Holztisch mit einer kleinen Schublade.\n");
  AddDetail(({"schublade"}),
	    "Ob da wohl etwas drin ist? Du konntest sie oeffnen und nachsehen.\n"); 
  AddDetail(({"schaukelstuhl", "stuhl"}),
	    "Ein bequem aussehender Schaukelstuhl. Ob Du Dich einmal auf ihn setzen "
	    +"solltest?\n");
  AddDetail(({"tuer", "labor"}),
	    "Durch die Tuer im Suedwesten kommst Du wieder zurueck ins Labor.\n");
  AddDetail(("terus"),
	    "Dem gehoert diese Behausung.\n");
  AddDetail(("behausung"),
	    "Du befindest Dich hier in der Behausung von Terus.\n");
  AddDetail(("kette"),
	    "Du beaeugst die Kette naeher und entdeckst, dass sie zu einer Apparatur "
	    +"fuehrt die unter einigen Buechern versteckt war.\n");
  AddDetail(({"apparatur", "kasten"}),
	    "Die Apparatur ist ein kleiner unfoermiger Kasten in welcher die Kette "
	    +"verschwindet. Ein Hebel ist an dem Kasten angebracht.\n");
  AddDetail(("hebel"),
	    "Du koenntest versuchen ihn zu ziehen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
            "Seltsame Gerueche dringen aus dem Labor zu Dir.\n");
  AddSmell( ({"gerueche", "labor"}),
	    "Iehhh, riecht das furchtbar. Mit was experimentiert Terus "
	    +"denn jetzt schon wieder? \n");
  AddSound(({DEFAULT_SOUND, "geraeusche"}),
	   "Du hoerst Terus wie er in seinem Labor umherstreift.\n");
  AddSound(({"terus", "labor", "wortfetzen"}),
	   "Ein paar Wortfetzen die Du auffangen kannst:\n"
	   +"...jajadasmuesstedannschonklappen ...wohabichdenschonwiederdashingelegt... "
	   +"...interessantinteressant... ...achzumandyldamit... ...ohwasistdenndas...\n");
  
  // EXITS
  
  AddExit( "suedwesten", ROOM"labor");
  
  // ITEMS
  
  // COMMANDS
  

  AddCmd(({"greife", "greif"}), "greife_in");
  AddCmd(({"oeffne"}), "oeffne_was");
  AddCmd(({"setz", "setze", "sitz"}), "setz_auf");
  AddCmd(({"zieh", "ziehe"}), "ziehe_was");

  previous_object()->CustomizeObject();
}

setz_auf(str)
{
  notify_fail("Auf was willst Du Dich setzen?\n");
  if (!str) return 0;
  if ((str == "auf schaukelstuhl" || str == "auf stuhl" ))
    {
      // HIER SEQUENZ EINBAUN WO MAN DENKT WENN ES WAERE WENN
      // MAN SEIN ABENTEUERLEBEN AN DEN NAGEL HAENGEN WUERDE
      // -> SCHLUSSFOLGERUNG: NIE IN PENSION GEHN :)
      write(BS("kommt noch.\n"));
      return 1;
    }
  else return 0;
}

ziehe_was(str)
{

  notify_fail("Was willst Du ziehen?\n");
  if (!str) return 0;
  if (( str == "hebel" ))
    {
      // SEQUENZ MIT GREEIFARM EINBAUN
      // Brillenglaeser fallen aus buecher
      write("Noch nicht fertig.\n");
      return 1;
    }
  else return 0;
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if (( str == "schublade" || str == "schreibtischschublade"))
    {
      write(BS("Du oeffnest die Schreibtischschublade findest "
	       +"darin aber nichts. Enttaeuscht schliesst Du die "
	       +"Schublade wieder.\n"));
      return 1;
    }
  else return 0;
}

greife_in(str)
{
  notify_fail("In was willst Du greifen?\n");
  if (!str) return 0;
  if (( str == "ritze" || str == "in ritze" ))
    {
      if (( rahmen==1 ))
	{
	  // WENN SPIELER KEINEN RAHMEN HAT
	  // BRILLENRAHMEN KLONEN
	  write("kriagst an bruellnrahmen");
	  return 1;
	}
      else
	{
	  write(BS("Du greifst in die Ritze findest aber "
		   +"ausser Staub leider nichts.\n"));
	  return 1;
	}
    }
  else return 0;
}



void reset()
{
  ::reset();  
}

