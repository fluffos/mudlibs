#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einer Lichtung im Wald" );
  SetProp(P_INT_LONG,
	  "Du stehtst hier auf einer Lichtung im Wald. Rings "
	  +"um Dich herum stehen verschiedenste Nadelbaeume. Der Boden "
	  +"ist mit Graesern, Moos und Pilzen bedeckt. Ein Weg fuehrt "
	  +"zurueck nach Westen. Vom Himmel scheint die Sonne froehlich auf "
          +"Dich herab. Im Suedosten entdeckst Du ausserdem einen "
	  +"ogermannsgrossen Felsblock in den eine Tuer eingelassen worden "
	  +"ist.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  
  
  AddDetail(("weg"),
	    "Der Weg fuehrt zurueck nach Westen.\n");
  AddDetail(("wald"),
	    "Leicht zu erkennen an den vielen Baeumen.\n");
  AddDetail(("lichtung"),
	    "Du stehst hier auf einer Lichtung im Wald. Markant "
	    +"ist vor allem der ogermannsgrosse Felsblock im "
	    +"Suedosten.\n");
  AddDetail(("himmel"),
            "Am Himmel sind nur ein paar kleine Wolken zu sehen. Ansonsten "
            +"strahlt froehlich die Sonne von ihm herunter.\n");
  AddDetail(("sonne"),
	    "Die Sonne duerfte Dich moegen wenn sie so froehlich "
	    +"auf Dich scheint, ausser Du bist Dunkelelf.\n");
  AddDetail(({"dunkelelf", "dunkelefen"}),
	    "Dunkelelfen werden die Sonne wohl nicht allzusehr moegen.\n");
  AddDetail(("wolken"),
	    "Eine Wolke sieht ja beinahe aus wie Du, und da, da ist eine "
            +"Wolke die genau so aussieht wie eine Drachenruestung.\n");
  AddDetail(("drachenruestung"),
	    "Ein Drachenruestung haette wohl jeder gerne.\n");
  AddDetail(({"nadelbaeume", "baeume", "baum", "nadelbaum"}),
            "Du siehst Fichten, Tannen, und sogar den seltenen Silbernadelbaum.\n");
  AddDetail(({"nadeln", "nadel"}),
	    "Zu einem ordentlichen Nadelbaeum gehoeren natuerlich viele Nadeln\(nein, "
	    +"nicht die aus Omas Naehzeug\).\n");
  AddDetail(({"oma", "naehzeug", "omas naehzeug"}),
	    "Nein, die Nadeln aus Omas NAehzeug sind sicher nicht gemeint!\n");
  AddDetail(({"silbernadelbaum", "gegensatz"}),
	    "Der Silbernadelbaum ist aeusserst selten. Er hat silbern glaenzende Nadeln "
	    +"und im Gegensatz zu vielen anderen Nadelbaeumen keine Zapfen sondern "
	    +"silberne Blueten.\n");
  AddDetail(("blueten"),
	    "Schade, die scheinen noch nicht ganz erblueht zu sein.\n");
  AddDetail(({"boden", "waldboden"}),
	    "Am Boden entdeckst Du Graeser, Moos und Pilze. Ein typischer "
	    +"Waldboden eben.\n");
  AddDetail(("moos"),
	    "Weiches gruenes Moos.\n");
  AddDetail(("graeser"),
	    "Verschiedenartigste Graeser aber keines davon scheint besonders "
	    "interessant zu sein.\n");
  AddDetail(({"pilze"}),
	    "Die Pilze scheinen alle nicht essbar zu sein. Schade eigentlich.\n");
  AddDetail(("fichten"),
	    "An den Fichten siehst Du jede Menge Nadeln und einen Haufen Fichtenzapfen.\n");
  AddDetail(("menge"),
	    "Auf den Fichten wie auch an den anderen Nadelbaeumen entdeckst Du eine "
	    +"riesige Menge an Nadeln.\n");
  AddDetail(({"haufen"}),
	    "Ein netter Haufen an Fichtenzapfen haengt an den Aesten der Fichten.\n");
  AddDetail(({"zapfen"}),
	    "Du findest hier Tannenzapfen und Fichtenzapfen.\n");
  AddDetail(({"tannenzapfen"}),
	    "Die haengen zuhauf an den Aesten der Tannen.\n");
  AddDetail(({"fichtenzapfen"}),
	    "An Fichten haengen keine Faschingskrapfen, "
	    +"sondern leider nur viele Fichtenzapfen.\n");
  AddDetail(({"faschingskrapfen", "krapfen", "hunger"}),
	    "Tja, Magier sollten wohl nicht programmieren wenn sie Hunger haben.\n");
  AddDetail(("magier"),
	    "Mach einfach mal \"kwer\".\n");
  AddDetail(({"tannen", "tanne"}),
	    "Leicht kannst Du die Tannen von den aehnlich aussehenden Fichten unterscheiden. "
            +"Die Aeste der Tanne wirken eher aufgerichtet, waehrend die der Fichte eher "
            +"herabhaengend wirken.\n");
  AddDetail(({"aeste"}),
	    "Die Aeste der Tanne wirken eher aufgerichtet, waehrend die der Fichte eher "
	    +"herabhaengend wirken. Natuerlich sind auf den Aesten der Tannen nur Tannenzapfen "
	    +"und auf den Aesten der Fichten nur Fichtenzapfen zu finden. Waere wohl etwas "
	    +"seltsam wenn es anders waere.\n");  
  AddDetail(({"insekten", "insekt"}),
            "Ueberall surren, krabbeln und fliegen hier Insekten herum.\n");  
  AddSound( ({DEFAULT_SOUND}),
            "Ein paar Insekten surren herum und heiter zwitschern einige Voegel.\n");
  AddSound (("insekten"),
            "Die surren da ueberall herum.\n");
  AddSound(("voegel"),
	   "Du glaubst die Melodie von Schwanensee zu hoeren.\n");
  AddSound(({"schwanensee", "melodie"}),
           "Erinnert Dich irgendwie an eine Stelle im Kristallwald. Warum wohl?\n");
  AddDetail(({"kristallwald", "stelle", "stueck"}),
	    "Der Kristallwald ist doch ein ziemliche Stueck von hier entfernt.\n");
  AddDetail(({"block", "felsblock", "fels", "felsen", "tuer", "tuere"}),
	    "Im Suedosten ist ein in etwa ogermannsgrosser Felsblock in den "
	    +"eine Tuer eingelassen worden ist. Es waere sicher nicht ganz "
	    +"uninteressant dort hinzugehen und sich den Fels aus der "
	    +"Naehe anzusehen.\n");
  AddDetail(("naehe"),
	    "In die kommst Du erst wenn Du dort hingehst.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "waldgeruch"}),
            "Es riecht nach Moos, Pilzen und Harz. Typischer Waldgeruch eben.\n");
  AddSmell(({"moos", "pilz", "pilze", "harz"}),
	   "Ah, riecht angenehm, nicht so ein uebler Geruch wie in den Seitengassen "
	   +"von Midas.\n");
  AddDetail(({"seitengassen", "midas"}),
	    "In den Seitengassen von Midas kann es oft ziemlich uebel riechen.\n");

  // EXITS  

  AddExit( "westen", "/d/ebene/lamuerte/wwald/room/umfahrung1.lpc");
  AddExit( "suedosten", ROOM"eingang");
 
 // ITEMS

 // kleinen Waldschrat einbaun (eventuell versteckt) 
 // "Graulf" beim Felsblock einbaun. (Mischung Wolf/Biber)  Heisst Graulf wegen seinem Hellrauem Fell.  

 // COMMANDS
}


void reset()
{
  ::reset();  
}
