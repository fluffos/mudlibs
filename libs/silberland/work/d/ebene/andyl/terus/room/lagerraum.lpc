#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int korken_drin=1;

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Lagerraum von Terus" );
  SetProp(P_INT_LONG,
	  "Dieser Lagerraum laesst deine Augen immer groesser werden. "
	  +"Erstens ist der Raum um wesentlich groesser als man von aussen "
	  +"vermuten wuerde, zweitens ist er mit unzaehligen Regalen vollgestopft "
	  +"in denen sich verschiedenste Behaeltnisse befinden. Und das Schlimmste "
	  +"dabei: Nicht eines der Regale oder der Behaeltnisse ist beschriftet. Wie "
	  +"soll man hier je was finden wenn man etwas braucht? Durch die Tuer im "
	  +"Suedosten kommst Du wieder zurueck ins Labor.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS

  AddDetail(({"tuere", "tuer"}),
	    "Durch die Tuer kommst Du wieder zurueck ins Labor. An ihr ist ein "
	    +"kleines Schild befestigt.\n");
  AddDetail(("schild"),
	    "Du kannst es lesen.\n");
  AddDetail(({"boden", "steinboden"}),
	    "Etwas staubig aber ansonsten ein voellig uninteressanter Steinboden.\n");
  AddDetail(("decke"),
	    "Die Decke besteht aus Stein.\n");
  AddDetail(({"stein", "rocker"}),
	    "Steinhart wie ein Rocker!\n");
  AddDetail(({"wand", "waende", "steinwand", "steinwaende"}),
	    "Schlichte Steinwaende ohne Fenster.\n");
  AddDetail(("fenster"),
	    "Keines zu sehen, trotzdem ist es hell hier drinnen.\n");
  AddReadDetail(("schild"),
		"+---------+\n"
		"| AUSGANG |\n"
		"+---------+\n");
  AddDetail(("labor"),
	    "Das Labor von Terus befindet sich suedoestlich von hier.\n");
  AddDetail(("augen"),
	    "Deine Augen sind jetzt gaaanz gross.\n");
  AddDetail(({"raum", "lagerraum"}),
	    "Der Lagerraum von Terus ist faszinierend. Riesengross, vollgestopft "
	    +"und so unuebersichtlich, dass man sicher nie das findet was man sucht.\n");
  AddDetail(("schlimmste"),
	    "Du hast so eine Ahnung, dass Dir hier das Schlimmste noch bevorsteht.\n");
  AddDetail(({"ahnung", "ahnungen"}),
	    "Du hast da so einige Ahnungen. Dummerweise keine guten.\n");
  AddDetail(("regale"), 
	    "Du siehst hier etliche Regale in denen eine Unzahl an "
	    +"Behaeltnissen stehen.\n");
  AddDetail(("unzahl"),
	    "Viel zu viele!\n");
  AddDetail(({"behaeltnis", "behaeltnisse"}),
	    "Du siehst hier Flaschen, Kisten, Truhen, Amphoren und noch "
	    +"viele Behaeltnisse mehr. Alle davon sind weder beschriftet noch "
	    +"scheinen sie nach einem Dir begreiflichen System geordnet zu sein.\n");
  AddDetail(({"flaschen", "inhalt"}),
	    "Obwohl die Flaschen nicht beschriftet sind vermutest Du, dass bei "
	    +"einigen der Inhalt nicht nur zu wissenschaftlichen sondern auch zu "
	    +"stimmungsfoerdernden Zwecken genutzt wird.\n");
  AddDetail(({"zweck", "zwecke", "mittel"}),
	    "Der Zweck heiligt die Mittel. So heisst es zumindest.\n");
  AddDetail(({"truhen", "truhe"}),
	    "In den Truhen ist sicher nur Geruempel drinnen.\n");
  AddDetail(("geruempel"),
	    "Neugierig oeffnest Du ein paar Truhen findest jedoch nur "
	    +"unnoetiges Geruempel. Entaeuscht laesst Du von den Truhen ab.\n");
  AddDetail(("amphoren"),
	    "Es gibt hier unzaehlige Amphoren von den Dir jedoch eine "
	    +"Amphore besonders auffaellt.\n");
  AddSpecialDetail(("amphore"), "amphore_schau");
  AddSpecialDetail(("korken"), "korken_schau");
  AddDetail(("kisten"),
	    "Es sind einfach um sie alle zu untersuchen, zudem sieht keine "
	    +"davon sehr interessant aus.\n");
  AddDetail(({"system", "motto"}),
	    "Das ist mit Sicherheit ein gnomisches System frei nach dem Motto:\n"
	    +"Warum langweilig und einfach wenn es auch kompliziert geht?\n");
  AddDetail(({"sicherheit", "wortschatz", "wort"}),
	    "Sicherheit: Ein im gnomischen Wortschatz selten verwendetes Wort.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
            "Riecht seltsam hier. Hoffentlich ist hier nichts Gefaehrliches ausgeronnen.\n");
  AddSmell( ({"gefaehrliches"}),
	    "Du riechst und...\n "
	    +"...das Atemen wird schwer.\n" 
	    +"Du erholst Dich aber sogleich, "
	    +"also scheint hier doch nichts wirklich gefaehrlich zu sein...\n"
	    +"...hoffentlich.\n");
  AddSound(({DEFAULT_SOUND, "geraeusche"}),
	   "Unueberhoerbar ist Terus wie er in seinem Labor herumwerkt.\n");
  AddSound(({"terus", "labor"}),
	   "Folgendes kannst Du erlauschen:\n"
	   "...kabooom... ...zischzusch... ...mistding... "
	   +"...dastecktsicherderandyldrin... ...murmelmurmel... "
	   +"...raschelraschel... ...haemmerhaemmer...\n");
  // EXITS
  
  AddExit( "suedosten", ROOM"labor");
  
  // ITEMS
  
  // COMMANDS

  AddCmd(({"zieh", "ziehe"}), "ziehe_was");

  previous_object()->CustomizeObject();
}

ziehe_was(str)
{
  notify_fail("Was willst Du wo herausziehen?\n");
  if (!str) return 0;
  if (( str == "korken heraus" || str == "korken aus amphore" ||
	str == "korken aus amphore heraus" ))
    {
      if ((korken_drin == 1))
	{
	  write(BS("Den Korken hast Du bereits aus der Amphore gezogen.\n"));
	  return 1;
	}
      else
	{
	  // DSCHINN KOMMT AN, DEN MAN NACH SARANOSTIN FRAGEN KANN
	  // MAN KANN AUCH EIN PAAR ANDERE SACHEN VERLANGEN -> FUEHRT JEDOCH
	  // ZU MEHR ODER WENIGER INTERESSANTEN UEBERRASCHUNGEN :)
	  write("noch nicht fertig.\n");
	  return 1;
	}
    }
  else return 0;
}



amphore_schau()
{
  if (( korken_drin == 1 ))
    {
      return(BS("In der Amphore steckt ein seltsamer Korken. Ob man den wohl "
		+"heraus ziehen kann?\n"));
    }
  else
    {
      return(BS("Eine kleine Amphore neben der ein Korken liegt.\n"));
    }
}

korken_schau()
{
  if (( korken_drin == 1 ))
    {
      return(BS("Der Korken hat etwas seltsames an sich. Ob man ihn wohl "
		+"aus der Amphore ziehen kann?\n"));
    }
  else
    {
      return(BS("Der Korken liegt jetzt neben der kleiner Amphore.\n"));
    }
}


void reset()
{
  ::reset();  
  korken_drin=1;
}

