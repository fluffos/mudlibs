#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int rohrda=1;
int schlauchda=1;

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In der Werkstatt von Terus" );
  SetProp(P_INT_LONG,
	  "Du befindest Dich hier in der Werkstatt von Terus. "
	  +"In der Mitte des Raumes steht eine grosse Werkbank auf "
	  +"welcher jede Menge Werkzeuge herumliegen. Auch die Regale welche an "
	  +"den Waenden stehen sind mit allerlei Zubehoer fuer den "
	  +"Heimwerker ausgestattet. Ordnung scheint nicht wirklich zu Terus "
	  +"Staerken zu gehoeren, aber zumindest macht dieser Raum einen "
	  +"einigermassen normalen Eindruck. Durch eine Tuer im Nordwesten kommst "
	  +"Du wieder zurueck in das Labor.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  
  AddDetail(("tuer"),
	    "Durch die Tuer im Nordwesten kommst Du wieder zurueck in "
	    +"Terus Labor.\n");
  AddDetail(({"boden", "steinboden"}),
	    "Ein einfacher Steinboden. Dreckig aber uninteressant.\n");
  AddDetail(({"waende", "wand", "steinwand", "steinwaende"}),
	    "Einfache Steinwaende.\n");
  AddDetail(({"decke", "steindeck"}),
	    "Wie auch Waende und Boden ist die Decke aus Stein.\n");
  AddDetail(({"stein", "gestein"}),
	    "Vermutlich vulkanisches Gestein, aber Du kannst Dich irren.\n");
  AddDetail(({"mitte", "werkbank"}),
	    "Ein ziemlich grosse Werkbank steht in der Mitte des Raumes. "
	    +"Auf ihr liegen unzaehlige Werkzeuge. An der Tischplatte "
	    +"der Werkbank faellt Dir etwas auf.\n");
  AddDetail(({"platte", "tischplatte"}),
	    "Da scheint eine Druckplatte in die Werkbank eingelassen zu sein.\n");
  AddDetail(({"druckplatte", "platte"}),
	    "Du koenntest ja mal versuchen sie zu druecken.\n");
  AddDetail(("eindruck"),
	    "Der Raum macht zumindest optisch einen einigermassen normalen "
	    +"Eindruck. Ob der Eindruck wohl taeuscht?\n");
  AddDetail(({"raum"}),
	    "Dieser Raum ist die Werkstatt von Terus.\n");
  AddDetail(({"werkstatt"}),
	    "Dies ist die Werkstatt von Terus in welcher er wohl oefters "
	    +"abenteuerlich aussehende Maschinen zusammenbaut. Zumindest "
	    +"lassen dies die vielen herumliegenden Werkzeuge vermuten.\n");
  AddDetail(("maschinen"),
	    "Sicher sehr abenteuerlich aussehende Maschinen.\n");
  AddDetail(("regale"),
	    "Die Regale sind mit allerlei Krimskrams angefuellt.\n");
  AddDetail(({"krimskrams", "schrauben", "bleche", "zubehoer"}),
	    "Alte Schrauben, rostige Bleche und vieles mehr. Krimskrams eben.\n");
  AddDetail(({"staerke", "staerken"}),
	    "Terus wird schon so seine Staerken haben. Ordnung gehoert jedoch nicht dazu.\n");
  AddDetail(("terus"),
	    "Der stellt sicher wieder in seinem Labor irgendetwas an. Hoffentlich nichts was "
	    +"Dir dann am Ende um die Ohren fliegt.\n");
  AddDetail(("ende"),
	    "Gegenteil von Anfang.\n");
  AddDetail(("anfang"),
	    "Gegenteil von Ende.\n");
  AddDetail(("gegenteil"),
	    "Das Gegenteil von z.B. Anfang waere Ende.\n");
  AddDetail(("ohren"),
	    "Ja, du hast Ohren und Du willst die sicher auch behalten. Sonst "
	    +"koenntest Du ja nicht mehr all den tollen geraeuschen lauschen.\n");
  AddDetail(({"geraeusch", "geraeusche"}),
	    "Guter Tip: Geraeuschen kann man lauschen.\n");
  AddDetail(("tip"),
	    "Der Tip war jetzt eh gratis.\n");
  AddDetail(("heimwerker"),
	    "Terus scheint ein toller Heimwerker zu sein. Bei ihm geht auch immer "
	    +"grundsaetzlich was schief.\n");
  AddDetail(({"werkzeuge", "Menge"}),
	    "Da sind Haemmer, Saegen, diverse Schraubenzieher und jede Menge anderer "
	    +"mehr oder weniger hilfreichen Utensilien.\n");
  AddDetail(("haemmer"),
	    "Ein Hammer faellt Dir besonders auf.\n");
  AddDetail(("hammer"),
	    "An dem Hammer ist ein roter Fleck zu entdecken.\n");
  AddDetail(("fleck"),
	    "Du untersuchst den Fleck genauer und bist Dir jetzt ziemlich sicher, dass "
	    +"es sich dabei um getrocknetes Blut handelt.\n");
  AddDetail(({"blut", "vermutung"}),
	    "Das getrocknete Blut laesst in Dir die Vermutung aufkeimen, dass Terus "
	    +"da wohl mit dem Hammer nicht allzu gut gezielt hat. Fragt sich jetzt nur "
	    +"ob dies Terus eigenes Blut ist oder das eines anderen.\n");
  AddDetail(("saegen"),
	    "Hier liegen verschiedenste Saegen herum. Eine davon faellt Dir dabei "
	    +"besonders auf.\n");
  AddDetail(("saege"),
	    "Die Saege hat keine Zaehne und trieft nur so vor Schmieroel. Eine "
	    +"Inschrift ist auf ihr eingraviert.\n");
  AddDetail(("zaehne"),
	    "Ein Saege ohne Zaehne? Fuer was die wohl gut sein soll?\n");
  AddDetail(({"schmieroel", "oel"}),
	    "Einerseits schmierig, andererseits oelig.\n");
  AddDetail(("inschrift"),
	    "Du kannst sie lesen.\n");
  AddReadDetail(("inschrift"),
		"Terus Brotschneidesaege, fuer das schnelle Brotschneideerlebnis.\n"
		+"Gnomisches Patent Nr. 256790\(R\).\n");
  AddDetail(({"schraubenzieher", "weis"}),
	    "Du weisst nicht was Terus mit diesen Schraubenziehern angestellt hat, aber "
	    +"Tatsache ist sie sind alle entweder auf seltsamste Weise verbogen, zerbrochen "
	    +"oder anderwertig auffaellig.\n");
  AddDetail(({"tatsachen", "tatsache"}),
	    "Tja, Tatsachen sind meist schwer zu wiederlegen.\n");
  AddSpecialDetail(({"utensilien"}), "utensilienschau");
  AddDetail(("aufmerksamkeit"),
	    "Du solltest Deine Aufmerksamkeit dem Roehrchen schenken.\n");
  AddSpecialDetail(({"rohr", "roehrchen"}), "roehrchenschau");

  AddSmell( ({DEFAULT_SMELL, "geruch"}),
            "Du riechst interessante Gerueche die aus dem Labor zu kommen scheinen.\n");
  AddSmell( ({"gerueche"}),
	    "Riecht als waere da etwas angebrannt, was fuehrt Terus denn jetzt schon wieder auf?\n");
  AddSound(({DEFAULT_SOUND, "geraeusche", "geraeusch"}),
	   "Terus macht wieder einmal Krach in seinem Labor.\n");
  AddSound(({"terus", "labor", "krach", "tzaziiiiiing"}),
	   "Folgendes ist zu hoeren: *schepperschepper* *raschelknirsch* *zaubermurmel* "
	   +"...jetzteinkleinerkugelblitz... *TZAZIIIIIING* ...juhugleichnochmal!... \n");
  // EXITS
  
  AddExit( "nordwesten", ROOM"labor");
  
  // ITEMS
  
  // COMMANDS
  
  AddCmd(("zieh", "ziehe"), "ziehe_was");
  AddCmd(("drueck", "druecke"), "druecke_was");

  previous_object()->CustomizeObject();
}

ziehe_was(str)
{
  notify_fail(BS("Was willst Du wo herausziehen?\n"));
  if (!str) return 0;
  if (( str == "roehrchen aus utensilienhaufen" || str == "rohr aus utensilienhaufen" ||
	str == "roehrchen aus haufen" || str == "rohr aus haufen" ||
	str == "roehrchen aus utensilienhaufen heraus" || str == "rohr aus utensilienhaufen heraus" ||
	str == "roehrchen aus haufen heraus" || str == "rohr aus haufen heraus" ))
    {
      // BLASEBALG WIRD HIER GEKLONT, HAUFEN BRICHT ZUSAMMEN (MAN RAEUMT NATUERLICH WIEDER ALLES ZURUECK
      // CHECK OB SPIELER VIELLEICHT SCHON EINEN BLASEBALG HAT
      write(BS("NO NIX DA!"));
      rohrda=0;
      return 1;
    }
  else return 0;
}

druecke_was(str)
{
  notify_fail(BS("Was willst Du druecken?"));
  if (!str) return 0;
  if (( str == "platte" || str == "druckplatte" ||
	str == "auf platte" || str == "auf druckplatte" ))
    {
      if ((schlauchda==1))
	{
	  // MAN HOERT EIN RUMPELN, SCHEPPERN, RAUCHEN  ETC. UND IRGENDWANN SAUST DEM SPIELER DANN 
	  // EIN SCHLAUCH UM DIE OHREN DEN ER/SIE DANN EINSTECKT
	  // CHECK OB SPIELER VIELLEICHT SCHON EINEN SCHLAUCH HAT
	  write(BS("NO NIX DA!"));
	  schlauchda=0;
	  return 1; 
	}
      else
	{
	  write(BS("Du drueckst auf die Steinplatte jedoch passiert rein gar nichts.\n"));
	  return 1;
	}


    }
  else return 0;
}

utensilienschau()
{
  write(BS("Bei den meisten Utensilien kannst Dir nicht im entferntesten vorstellen fuer was "
	   +"die gebraucht werden koennten."));
  if ((rohrda == 1))
    {
      return("Ein seltsames Roehrchen erweckt jedoch Deine Aufmerksamkeit.\n");
    }
  else return "";
}

roerchenschau()
{
  if ((rohrda == 1))
    {
      return(BS("Das Roehrchen ragt unter dem Utensilienhaufen heraus. Ob man es da "
		+"vielleicht herausziehen kann?\n"));
    }
  else return("Sowas siehst Du da nicht!");
}

void reset()
{
  ::reset();  
  rohrda=1;
  schlauchda=1;
}





