#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int graulf=1;

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Vor einem grossen Felsblock" );
  SetProp(P_INT_LONG,
	  "Du stehst hier vor einem grossen hellgrauen Felsblock. In ihn "
	  +"ist eine Tuere eingelassen, jedoch kannst Du nirgends ein Tuerschloss "
	  +"oder so etwas wie eine Tuerklinke entdecken. Ein kleines hoelzernes Schild "
	  +"ist an der Tuer angebracht. Dazu entdeckst du rechts neben der Tuer eine "
	  +"Kette. Rechts neben der Tuere ist ein etwa feengrosses Loch im Felsblock ueber "
	  +"dem eine Inschrift in den Fels gemeiselt wurde. Im Nordwesten gehts wieder "
	  +"zurueck zur Lichtung.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  
  AddDetail(("lichtung"),
	    "Die Lichtung ist gleich nordwestlich von hier.\n");
  AddDetail(({"felsblock", "block"}),
	    "Ein grosser hellgrauer Felsblock in den eine Tuer eingelassen wurde. "
	    +"Rechts neben dieser Tuere ist ein etwa feengrosses Loch im Fels und "
	    +"links neben der Tuere baumelt eine Kette.\n");
  AddDetail(("fels"),
	    "Rauher hellgrauer Fels\(hart\).\n");
  AddDetail(("kette"),
	    "Die Kette baumelt links von der Tuere hin und her. Ob man daran vielleicht "
	    +"mal ziehen sollte?\n");
  AddDetail(({"tuerklinke", "tuerschloss", "klinke", "schloss"}),
	    "Nirgends eine Tuerklinke oder ein Tuerschloss zu entdecken. Seltsame "
	    +"Konstruktion diese Tuere.\n");
  AddDetail(("konstruktion"),
	    "Die Tuer ist eine ueberaus seltsame Konstruktion, ja fast gnomisch.\n");
  AddDetail(({"tuer", "tuere"}),
	    "Die Tuere ist in den Felsblock eingelassen und hat weder ein Schloss noch "
	    +"eine Klinke oder dergleichen. Eine kleines Schild ist an ihr befestigt.\n");
  AddReadDetail(({"schild", "hoelzernes schild"}),
		"+---------------------------------------+\n"
		"|    Hier wohnt                         |\n"
		"|                                       |\n"
		"|    Terus, Zauberer und Erfinder.      |\n"
		"|                                       |\n"
                "|    Betreten auf eigene Gefahr!        |\n"
		"|    Spieler haften fuer ihre Zweitis.  |\n"
		"|                                       |\n"
		"|    Zum Anmelden bitte Kette ziehen.   |\n"
		"+---------------------------------------+\n");
  AddReadDetail(("inschrift"),
		"Da steht:\n"
		"+-------------------------+\n"
		"| WARNUNG VOR DEM GRAULF! |\n"
		"+-------------------------+\n");
  AddDetail(("loch"),
	    "Ein etwa feengrosses Loch ist rechts unten neben der Tuere in den "
	    +"Felsblock gehauen worden. Hmmm, da scheint sich irgendetwas darin "
	    +"bewegt zu haben, ob man da wohl mal vorsichtig reingreifen sollte?\n");
  AddDetail(({"inschrift"}),
	    "Du kannst sie lesen.\n");
  AddDetail(({"schild", "hoelzernes schild"}),
	    "Du kannst es lesen.\n");
  AddDetail(({"himmel", "sonne"}),
            "Froehlich scheint die Sonne vom Himmel auf Dich herab welche von "
	    +"ein paar Woelkchen umgeben ist.\n");
  AddDetail(({"woelkchen", "wolken"}),
	    "Ein paar Woelkchen sind am Himmel zu sehen, sieht jedoch nicht so aus "
	    +"als wuerde sich in irgendeiner Weise ein Unwetter ankuendigen.\n");
  AddDetail(("weise"),
	    "Nicht in geringster Weise.\n");
  AddDetail(("unwetter"),
	    "Nein, da scheint heute wohl nichts auf Dich zuzukommen oder doch?\n");
  AddDetail(({"boden", "waldboden"}),
	    "Typischer Waldboden. Moos, Graeser und jede Menge Nadeln von Nadelbaeumen.\n");
  AddDetail(("menge"),
	    "Ein grosse Menge an Nadeln von Nadelbaeumen liegt hier herum.\n");
  AddDetail(({"graeser", "moos", "nadeln"}),
	    "Graeser, Moos und Nadeln von Nadelbaeumen sind hier zuhauf am Boden zu finden.\n");
  AddDetail(({"nadelbaeume", "wald", "baeume"}),
	    "Der Wald um dich herum besteht fast ausschliesslich aus Nadelbaeumen.\n");
  AddDetail(("insekten"),
	    "Davon gibt es im Wald immer mehr als genug.\n");

  AddSmell( ({DEFAULT_SMELL, "geruch", "waldgeruch"}),
            "Es riecht nach Moos, Gras und Harz. Typischer Waldgeruch eben. Jedoch "
	    +"riechst Du auch ein seltsames Aroma welches von der Tuer zu kommen scheint.\n");
  AddSmell(({"moos", "gras", "harz", "wald"}),
	   "Ah, riecht nach Wald hier.\n");
  AddSmell(("aroma"),
	   "Hmmm, riecht seltsam irgendwie so...\n"
	   +"..so kuenstlich. Was das wohl sein mag?\n");
  AddSound( ({DEFAULT_SOUND, "geraeusche", "insekten"}),
	    "Du hoerst die typischen Geraeusche von geschaeftigen Insekten.\n");
 

  // EXITS  

  AddExit( "nordwesten", ROOM+"lichtung");
 
 // ITEMS


 // "Graulf" einbaun. (Mischung Wolf/Biber)  
 // COMMANDS

  AddCmd(({"greife", "greif"}), "greife_in");
  AddCmd(({"ziehe", "zieh"}), "ziehe_an");

}

greife_in(str)
{
  object ob;
  notify_fail(BS("In was willst Du wie greifen?\n"));
  if (!str) return 0;
  if ((str == "in loch"))
    {
      if (!ob=present("graulf"), ENV(TO) && graulf==1)
	{
	  TP->AddHp(-15);
	  write(BS("Irgendetwas beisst Dir in unsanft in die Hand "
		   "und gleich darauf klettert ein seltsames Geschoepf aus "
		   "dem Loch heraus.")); 
	  graulf=0;
	  clone_object(NPC+"graulf")->move(TO, M_NOCHECK);
	  return 1;
	}
      else
	{
	  write(BS("Du greifst in das Loch, findest dort aber nichts."));
	  return 1;
	}
    }
  if ((str == "vorsichtig in loch"))
    {
      if (!ob=present("graulf"), ENV(TO) && graulf==1)
	{
	  write(BS("Vorsicht greifst Du in das Loch, ziehst Deine Hand "
		   "aber sofort zurueck als Du etwas seltsames fuehlst und "
		   "kurz darauf klettert ein seltsames Geschoepf aus dem Loch "
		   "heraus.")); 
	  graulf=0;
	  clone_object(NPC+"graulf")->move(TO, M_NOCHECK);
	  return 1;
	}
      else
	{
	  write(BS("Du greifst in das Loch, findest dort aber nichts."));
	  return 1;
	}
    }
  else return 0;
}


ziehe_an(str)
{
  notify_fail("An was willst Du ziehen?\n");
  if (!str) return 0;
  if ((str=="kette" || str=="an kette"))
    {
      // FALLS BARDE UND RICHTIGE STUFE PASST ALLES (KOMMT REIN) 
      // FALLS BARDE UND FALSCHE STUFE BLEIBT MAN VOR DER TUERE STEHN
      // FALLS NICHT BARDE -> RUECKFLUG AUF LICHTUNG :)
      write 
      return 1;
    }
  else return 0;
}     



void reset()
{
  ::reset();  
  graulf=1;
}
