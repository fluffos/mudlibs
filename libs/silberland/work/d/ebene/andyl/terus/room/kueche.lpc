#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int brot=0;
int schalter1=random(0-1);
int schalter2=random(0-1);
int schalter3=random(0-1);
int schalter4=random(0-1);
int schalter5=random(0-1);
int schalter6=random(0-1);
int schlitz=0;

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In Terus Kueche" );
  SetProp(P_INT_LONG,
	  "Du stehst hier in der Kueche von Terus. Allerdings glaubst "
	  +"Du auf den ersten Blick nicht, dass es sich tatsaechlich um eine "
	  +"Kueche handelt. Statt einem Ofen, Waschbecken oder anderen "
	  +"kuechenueblichen Einrichtungsgegenstaenden sind hier nur seltsame "
	  +"grosse Maschinen zu finden. Hier gibt es sicher das eine oder andere "
	  +"interessante zu entdecken. Durch eine Tuer im Nordosten kommst Du wieder "
	  +"ins Labor.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  
  AddDetail(("tuer"),
	    "Durch die Tuer kommst Du wieder zurueck in das Labor von Terus.\n");
  AddDetail(("fliesen"),
	    "Blaue Fliesen mit viele schwarzen Stellen.\n");
  
  AddDetail(("blick"),
	    "Auf den erste Blick wuerdest Du nie und nimmer vermuten, dass dies "
	    +"eine Kueche darstellen soll.\n");
  AddDetail(({"Waende", "wand"}),
	    "Die Waende sind mit blauen Fliesen ausgelegt. Manche Stellen "
	    +"sind schwarz, wie als haette da etwas gebrannt.\n");
  AddDetail(("decke"),
	    "Die Decke besteht aus blauen Fliesen welche an manchen Stellen "
	    +"stark angeschwaerzt sind.\n");
  AddDetail(("boden"),
	    "Der Boden besteht aus leicht angeschwaerzten blauen Fliesen, "
	    +"auf welche sich hier und dort ein mehrfaerbige Flecken befinden.\n");
  AddDetail(("flecken"),
	    "Du raetselst was das einmal gewesen sein koennte. Du schwankst "
	    +"etwas zwischen Essensresten oder der Entscheidung es lieber nicht "
	    +"so genau wissen zu wollen.\n");
  AddDetail(({"entscheidung", "entscheidungen"}),
	    "Manche Entscheidungen sind echt schwer.\n");
  AddDetail(({"essensreste", "reste"}),
	    "Die Flecken am Boden koennten einmal Essensreste gewesen sein.\n");
  AddDetail(({"stelle", "stellen"}),
	    "Manche Stellen der Fliesen sind stark angeschwaerzt. Da wurde "
	    +"wohl beim Kochen zuviel herumgezuendelt.\n");
  AddDetail(("kochen"),
	    "Sowas macht man ueblicherweise in einer Kueche. Hier auch?\n");
  AddDetail(({"terus", "behausung"}),
	    "Terus gehoert diese Behausung.\n");
  AddDetail(({"labor"}),
	    "Terus Labor liegt nordoestlich von hier.\n");
  AddDetail(("ofen"),
	    "Ofen scheints hier offensichtlich nicht zu geben, zumindest "
	    +"wuerdest Du nichts in diesem Raum fuer einen Ofen halten.\n");
  AddDetail(({"waschbecken", "becken"}),
	    "Auch Waschbecken ist hier keines zu entdecken.\n");
  AddDetail(({"einrichtungsgegenstaende"}),
	    "Also kuechenuebliche Einrichtungsgegenstaende sind hier kaum zu entdecken.\n");
  AddDetail(({"maschinen", "maschine", "unzahl"}),
	   "Hier stehen eine Unzahl von verschiedenen Maschinen. Davon scheinen aber nur "
	   +"drei interessanter zu sein: Ein rote Maschine, eine pyramidenfoermige Maschine "
	   +"und ein grosser Kasten.\n");
  AddDetail(({"pyramidenfoermige maschine", "pyramide"}),
	    "An der Oberseite der etwa feengrossen Pyramide sind einige Loecher zu sehen. Ausserdem scheint "
	    +"man die Spitze der Pyramide drehen zu koennen. Ob Du das einmal versuchen "
	    +"solltest?\n");
  AddDetail(({"loecher", "oberseite"}),
	    "Du fragst Dich zu was die Loecher an der Oberseite der kleinen Pyramide wohl gut sein "
	    +"sollen.\n");
  AddDetail(("konstruktionen"),
	    "Hier gibt es so einige interessante Konstruktionen. Die meisten davon solltest Du aber besser "
	    +"nicht anfassen.\n");
  AddDetail(({"kasten", "kastenfoermige maschine"}),
	    "Die kastenfoermige Maschine ist wohl eine der interessantesten Konstruktionen hier. " 
	    +"Vorne ist ein Schlitz in den man wohl etwas reinschieben kann. Dann sind da noch ein "
	    +"Haufen Schalter an ihr angebracht und eine Kette.\n");
  AddDetail(("kette"),
	    "Die Kette baumelt von der kastenfoermigen Maschine herunter. Ob man da wohl dran ziehen "
	    +"kann?\n");
  AddDetail(({"schalter", "haufen"}),
	    "Insgesamt kannst Du genau sechs Schalter entdecken. Du kannst sie mit "
	    +"<untersuche schalter x> naeher untersuchen.\n");
  AddDetail(({"raum", "kueche"}),
	    "Dieser Raum soll angeblich eine Kueche sein, auch wenn Du das kaum "
	    +"glauben kannst.\n");

  AddSpecialDetail(("schlitz"), "schlitz_schau");
  AddSpecialDetail(({"schalter 1", "schalter1"}), "schalter1_schau");
  AddSpecialDetail(({"schalter 2", "schalter2"}), "schalter2_schau");
  AddSpecialDetail(({"schalter 3", "schalter3"}), "schalter3_schau");
  AddSpecialDetail(({"schalter 4", "schalter4"}), "schalter4_schau");
  AddSpecialDetail(({"schalter 5", "schalter5"}), "schalter5_schau");
  AddSpecialDetail(({"schalter 6", "schalter6"}), "schalter6_schau");

  AddDetail(({"rote maschine", "zylinderfoermige maschine"}),
	    "An der roten zylinderfoermigen Maschine ist ein Hebel.\n");
  AddDetail(({"hebel"}),
	    "Du koenntest versuchen ihn zu ziehen.\n");
  AddSmell( ({DEFAULT_SMELL}),
            "Aus dem Labor dringen interessante Duftnoten auf Dich ein, "
	    +"aber auch der Geruch von diversem Zeug hier in der Kueche "
	    +"hat was fuer sich.\n");
  AddSmell(({"labor", "duftnoten"}),
	   "Puhhh. Ja, riecht definitv sehr interessant.\n"); 
  AddSmell(({"geruch", "zeug"}),
	   "Richt irgendwie...\n"
	   +"...angebrannt.\n");
  AddSound(({DEFAULT_SOUND, "geraeusche"}),
	   "Du hoerst das hektische Herumwirbeln von Terus in seinem Labor.\n");
  AddSound(({"herumwirbeln", "wirbeln", "terus"}),
	   "...raschelfluchstolperknirschknacksklonknochmehrfluch...\n");
  // EXITS
  
  AddExit( "nordosten", ROOM"labor");
  
  // ITEMS
  
  // COMMANDS
  
  AddCmd(({"drehe", "dreh"}), "drehe_was");
  AddCmd(({"zieh", "ziehe"}), "ziehe_was");
  AddCmd(({"leg", "lege"}), "lege_was");

  
  previous_object()->CustomizeObject();
}


lege_was(str)
{
  notify_fail("Was willst Du umlegen?\n");
  if (!str) return 0;
  if ((str == "schalter 1" || str == "schalter 1 um" 
       || str == "schalter1" || str == "schalter1 um"))
    {
      
      write(BS("Du legts Schalter 1 um.\n"));
      {
	if ((schalter1 == 0)) 
	  {
	    schalter1=1;
	    return 1;
	  }
	else 
	  {
	    schalter1=0;
	    return 1;
	  }
      }
    }
  
  if ((str == "schalter 2" || str == "schalter 2 um" 
       || str == "schalter2" || str == "schalter2 um"))
    {
      
      write(BS("Du legts Schalter 2 um.\n"));
      {
	if ((schalter2 == 0)) 
	  {
	    schalter2=1;
	    return 1;
	  }
	else 
	  {
	    schalter2=0;
	    return 1;
	  }
      }
    }
  
  if ((str == "schalter 3" || str == "schalter 3 um" 
       || str == "schalter3" || str == "schalter3 um"))
    {
      
      write(BS("Du legts Schalter 3 um.\n"));
      {
	if ((schalter3 == 0)) 
	  {
	    schalter3=1;
	    return 1;
	  }
	else 
	  {
	    schalter3=0;
	    return 1;
	  }
      }
    }

  if ((str == "schalter 4" || str == "schalter 4 um" 
       || str == "schalter4" || str == "schalter4 um"))
    {
      
      write(BS("Du legts Schalter 4 um.\n"));
      {
	if ((schalter4 == 0)) 
	  {
	    schalter4=1;
	    return 1;
	  }
	else 
	  {
	    schalter4=0;
	    return 1;
	  }
      }
    }
  
  if ((str == "schalter 5" || str == "schalter 5 um" 
       || str == "schalter5" || str == "schalter5 um"))
    {
      
      write(BS("Du legts Schalter 5 um.\n"));
      {
	if ((schalter5 == 0)) 
	  {
	    schalter5=1;
	    return 1;
	  }
	else 
	  {
	    schalter5=0;
	    return 1;
	  }
      }
    }
  
  if ((str == "schalter 6" || str == "schalter 6 um" 
       || str == "schalter6" || str == "schalter6 um"))
    {
      
      write(BS("Du legts Schalter 6 um.\n"));
      {
	if ((schalter6 == 0)) 
	  {
	    schalter6=1;
	    return 1;
	  }
	else 
	  {
	    schalter6=0;
	    return 1;
	  }
      }
    }
  else return 0; 
}
  










schalter1_schau()
{
  write(BS("Auf dem Schalter sind zwei Symbole zu sehen. Ein Schwein " 
	   "und ein Huhn."));
  if (schalter1 == 0)
    {
      write(BS("Derzeit zeigt der Schalter auf das Huhn."));
    }
  if (schalter1 == 1)
    {
      write(BS("Derzeit zeigt der Schalter auf das Schwein."));
    }
  return("Du kannst den Schalter mit <lege schalter 1 um> umlegen.\n");
}

