schlitz_schau()
{

  // DA CHECKEN OBS BROT DRIN IST ODER NICHT
  return ("Derzeit noch nix da.\n");
}

ziehe_was(str)
{
  notitfy_fail("An was willst Du ziehen?\n");
  if (!str) return 0;
  if ((str == "hebel" || str == "an hebel"))
    {
      // SEQUENZ FOLGT: SOFERN DER SPIELER NOCH KEIN BROT HAT, FLIEGT
      // IHM EINS UM DIE OHREN, SPIELER STECKT ES DANN EIN. SOLLTE 
      // ER SCHON EINS HABEN; KOMMT NUR EIN BEDAUERNSWERTES AECHZEN AUS
      // DEM ZYLINDER
      write(BS("nicht fertig.\n"));
      return 1;
    }
  
  if ((str == "an kette", "kette"))
    {
      // WENN DAS BROT EINGELEGT IST UND DIE SCHALTER RICHTIG GESTELLT SIND
      // GIBTS EIN SANDWICH. WENN ETWAS NICHT PASST -> FLIEGT DEM SPIELER WIEDER
      // EINIGES UM DIE OHREN 
      write(BS("nicht fertig.\n"));
      return 1;
      
      if (( schlitz == 1 && schalter1 == 1 && schalter2 == 1 && schalter3 == 1 &&
	    schalter4 == 1 && schalter5 == 1 && schalter6 == 1 ))
	{
	  // SANDWICH KLONEN UND WERTE ZURUECKSETZEN
	  write(BS("Do host a Sendwitsch.\n"));
	  schlitz=0;
	  return 1;
	}
      else
	{
	  // DAS ZEUG FLIEGT DEM SPIELER UM DIE OHREN
	  write(BS("KABOOOOM\n"));
	  return 1;
	}
    }
  else return 0;
}

drehe_was(str)
{
  notitfy_fail("Was willst Du drehen?\n");
  if (!str) return 0;
  if ((str == "pyramide" || str == "spitze der pyramide" || str == "spitze" ||
       str == "pyramidenspitze" || str == "pyramidenfoermige maschine"))
    {
      // ES WIRD GEDREHT UND ES FOLGT NE SEQUENZ IN DER DEM SPIELER EINIGES 
      // ZEUG UM DIE OHREN FLIEGT.
      write(BS("nicht fertig.\n"));
      return 1;
    }
  else return 0;
}


void reset()
{
  ::reset();  
}



