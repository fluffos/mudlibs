/*
** Ein Buendel Liedertexte aus Radenos Scheinbardengilde
**
** by Andyl@Silberland
** 
** 2002-03-27
**
** Last updated: 2002-04-27
**
*/

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({"texte", "buendel", "liedertexte"}));
  SetProp (P_SHORT, "Ein Buendel Liedertexte");
  SetProp (P_LONG,
	   "Das ist ein Buendel mit Liedertexten aus Radenos Bardengilde. " 
	   "Es besteht aus ein paar hellbraunen Papierseiten welche mit einer "
	   "Schnur zusammengebunden wurden. Das Ganze wirkt insgesamt aeusserst "
	   "schleissig. Ein Liederindex ist auf der ersten Seite zu sehen.\n");
  SetProp (P_NAME, "Liedertexte");
  SetProp (P_INFO, "Also sehr gehaltvoll scheinen die Liedertexte nicht zu sein oder anders ausgedrueckt: sie sind grottenschlecht und keine einzige Muenze wert!");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 20);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, (([MAT_PAPER:98, MAT_CLOTH:2])));
  
  AddDetail(({"erste seite", "seite 1"}),
	    "Da ist ein Liederindex. Du kannst ihn lesen.\n");
  AddDetail(({"seite 2", "seite 3", "seite 4", "seite 5", "seite 7", "seite 8", "zweite seite", "dritte seite", "vierte seite", "fuenfte seite", "sechste seite", "siebte seite", "achte seite"}),
	    "Du kannst sie lesen.\n");
	    
  AddDetail(({"index", "liederindex"}),
	    "Du kannst ihn lesen.\n");
  AddReadDetail(({"index", "liederindex", "erste seite", "seite 1", "seite1"}),
		"+-----------------------------------+\n"
		"| LIEDERINDEX                       |\n"
		"|                                   |\n"
		"| Seite 2: Rantan aus Midas         |\n" 
                "| Seite 3: Alpenbluemchen           |\n"
	       	"| Seite 4: Schnaps und Bier         |\n"
		"| Seite 5: Das Haus am See          |\n"
		"| Seite 6: Uga eh eh!               |\n"
		"| Seite 7: Ein kleiner Zwerg        |\n"
		"| Seite 8: Impressum                |\n"
                "+-----------------------------------+\n"
		"  Syntax: <lies seite x>\n");  
  AddReadDetail(({"seite 2", "zweite seite"}),
		"+------------------------------------+\n" 
		"| Rantan aus Midas                   |\n"
		"| ----------------                   |\n"
		"| Ich bin so toll                    |\n"                   
		"| Ich bin so klass                   |\n"                  
		"| Ich bin der Rantan aus Midas       |\n"      
		"| Taeteraetetetete, taeteraetetetete |\n"
		"| Rantan aus Midas!                  |\n"            
		"+------------------------------------+\n");
  AddReadDetail(({"seite 3", "dritte seite"}),
		"+-----------------------------------------+\n"
		"| Alpenbluemchen                          |\n"
		"| --------------                          |\n"
		"| Auf der Alm da steht ein Bluemelein     |\n"
		"| was auf der Welt koennt schoener sein   |\n"
		"| Darum sing ich jetzt das Lied:          |\n"
		"| Ohhh, Alpenblueeeeemchen meeeeein       |\n"
		"| Traurig wuerds ohne dich seeeeein       |\n"
		"| Holadriho, holadrihe, oh Alpenblueeeem! |\n"
		"+-----------------------------------------+\n");
  AddReadDetail(({"seite 4", "vierte seite"}),
		"+----------------------------------------+\n"
		"| Schnaps und Bier                       |\n"
		"| ----------------                       |\n"
		"| Schnaps und Bier                       |\n"
		"| das lob ich mir                        |\n"
		"| in Massen am Besten                    |\n"
		"| bei Feiern und Festen                  |\n"
		"| denn ein Rausch so fein                |\n"
		"| der kommt nicht allein                 |\n"
		"| deswegen Schnaps und Bier              |\n"
		"| das lob ich mir. Ja, Schnaps und Bier! |\n"
		"+----------------------------------------+\n"
		"Du denkst . o O \(scheint wohl eher ein Lied\n"
		"fuer Zechpreller zu sein\)\n");
  AddReadDetail(({"seite 5", "fuenfte seite"}),
		"+-----------------------------------------+\n"
		"| Das Haus am See                         |\n"
		"| ---------------                         |\n"
		"| Am See da steht ein Haus                |\n"
		"| Da geh ich Tagein Tagaus                |\n"
		"| Und singe fidiralala, fidiralala        |\n"
		"| Hussa, hussa, hopsassa                  |\n"
                "| Jaja, beim Haus am See.                 |\n"
		"+-----------------------------------------+\n"
		"Du denkst . o O \(Diese Lieder sind echt "
		"anspruchslos.\)\n");
  AddReadDetail(({"seite 6", "sechste seite"}),
		"+-----------------------------------------+\n"
		"| Uga eh eh!                              |\n"
                "| ----------                              |\n"
		"| Uga eh eh, uga jo jo                    |\n"
		"| tonga, tonga, ju, ju                    |\n"
		"| urga, murga, ra, ra                     |\n"
		"| ufza, ufza, ta, ta                      |\n"
		"| Uga uga eh eh!                          |\n"
		"+-----------------------------------------+\n"
		"Du denkst . o O \(Schlechter kanns ja nicht "
		"mehr werden\)\n");
  AddReadDetail(({"seite 7", "siebte seite"}),
		"+-----------------------------------------+\n"
		"| Ein kleiner Zwerg                       |\n"
		"| -----------------                       |\n"
		"| Ein kleiner starker Zwerg               |\n"
		"| der grub sich durch den Berg            |\n"
		"| und das Glueck das war im hold          |\n"		
		"| und er fand jede Menge Gold.            |\n"
		"| darauf war er froher Sinne              |\n"
		"| und brummte dann mit tiefer Stimme      |\n"
		"| Gold, Gold, Gold, Gold                  |\n"
		"| Gold, Gold, Gold, Gold                  |\n"
		"| Gold, Gold, Gold, Gold                  |\n"
		"| GOOOOOOOLLLLD!!!                        |\n"
		"+-----------------------------------------+\n");
  AddReadDetail(({"seite 8", "achte seite"}),
		"+-----------------------------------------+\n"
		"| Impressum                               |\n"
		"| ---------                               |\n"
		"| Gedruckt von Gildenmeister Radeno       |\n"
		"| Alle Rechte vorbehalten                 |\n"
		"+-----------------------------------------+\n"
		"Du kannst ein durchgestrichenes Gekritzel am\n"
		"unteren Rand der Seite erkennen.\n"); 
  AddDetail(("gekritzel"),
	    "Du kannst versuchen es zu lesen.\n");
  AddReadDetail(("gekritzel"),
		"Folgendes kannst Du entziffern: .anke....\n"
		"...vi.le Geld...billiger M.st...bezahlt ha.t.\n");                 
}

