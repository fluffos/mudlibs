inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

int kaputt=1;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({"bardenfaehnchen", "faehnchen"}));
  SetProp (P_SHORT, "Ein Bardenfaehnchen");
  SetProp (P_LONG,
	   "Das ist ein kleines Faehnchen mit der Aufschrift 'Barden von Radeno'. " 
	   "Es besteht aus einer duennen Holzstange an welcher ein Stueck Stoff "
	   "befestigt wurde. Man kann es schwenken.\n");
  SetProp (P_NAME, "Bardenfaehnchen");
  SetProp (P_INFO, "Die Haltbarkeit des Faehnchens scheint nicht sehr hoch zu sein.");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 50);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, ([MAT_WOOD:30,MAT_CLOTH:70]));
  AddCmd(({"schwenk", "schwenke"}), "schwenke_was");
}

schwenke_was(str)
{
  notify_fail("Was willst Du schwenken?\n");
  if (!str) return 0;
  if ((str=="faehnchen" || str=="bardenfaehnchen"))
    {
      write(BS("Du schwenkst das 'Barden von Radeno'-Faehnchen.\n"));
      say(BS(TP->name(WER,0)+" schwenkt ein 'Barden von Radeno'-Faehnchen.\n"));
      kaputt++;
      if ((kaputt > 5))
	{
	  write(BS("Hoppla, wie Du das Faehnchen schwenken willst zerbricht es einfach.\n"));
	  say(BS(TP->name(WER,0)+" will ein 'Barden von Radeno'-Faehnchen schwenken, aber "
	  +"dieses zerbricht einfach.\n"));
	  TO->remove();
	  return 1;
	}
      return 1;
    }
  else return 0;
}
