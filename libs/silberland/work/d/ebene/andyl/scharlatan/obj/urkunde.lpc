/*
** Mitgliedsurkunde der Bardengilde von Radeno
**
** AnDyL@Silberland
**
** 2000-06-07
**
** Last updated 2002-06-07
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <defines.h>
#include <moredef.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"urkunde", "mitgliedsurkunde", "\nradenourkunde"}));
  SetProp(P_SHORT, "Ein Mitgliedsurkunde");
  SetProp(P_LONG, "Das ist eine Mitgliedsurkunde der Bardengilde von Radeno. "
	  "Du kannst sie lesen.\n");
  SetProp(P_INFO, "Eine schaebige Urkunde ohne reelen Wert. Die kann man echt nur zerreissen.\n");
  SetProp(P_NAME, "Mitgliedsurkunde");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MATERIAL, ([MAT_PAPER:100]));

  AddCmd(({"zerreisse", "zerreiss"}), "zerreis_was");

  AddReadDetail(({"urkunde", "mitgliedsurkunde"}),
		"---------------------------------\n"
		"MITGLIEDSURKUNDE\n"
		"                                   \n"
		"Diese Urkunde bescheinigt\n"
		""+TP->name(WER,0)+" ein\n"
		"Mitglied der Bardengilde zu sein. \n"
		"                                   \n"
		"gezeichnet                     \n"
		"  Radeno, Gildenmeister      \n"
		"---------------------------------\n");
}

zerreis_was(str)
{
  notify_fail("Was willst Du zerreissen?\n");
  if (!str) return 0;
  if ((str == "urkunde" || str == "mitgliedsurkunde"))
    {
      write("Du zerreisst die ohnehin nutzlose Mitgliedsurkunde.\n");
      say(TP->name(WER, 0)+ "zerreisst eine Mitgliedsurkunde.\n");
      TO->remove();
      return 1;
    }
  else return 0;
}
