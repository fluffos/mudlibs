inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"anstecker", "bardenanstecker", "radenoanstecker"}));
  SetProp (P_SHORT, "Ein Anstecker");
  SetProp (P_LONG,
	   "Das ist ein sehr schlecht gefertigter Metallanstecker mit "
	   +"der Aufschrift 'Barden von Radeno'.\n");
  SetProp (P_NAME, "'Barden von Radeno'-Anstecker");
  SetProp (P_INFO, "Dieser schlecht gemachte Anstecker scheint kaum etwas wert zu sein.");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 10);
  SetProp (P_VALUE, 10);
  SetProp (P_ARMOUR_TYPE, AT_MISC);  // siehe sys/combat.h
  SetProp (P_AC, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_WORN_TEXT, "angesteckt");
  SetProp (P_MATERIAL, MAT_IRON);
}

