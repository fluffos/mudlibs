inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({"gluecksbringer"}));
  SetProp (P_SHORT, "Ein Gluecksbringer");
  SetProp (P_LONG,
	   "Das ist ein Gluecksbringer aus Radenos Bardengilde. Es ist eine "
	   "kleine, grob geschnitzte Holzskulptur, welche vermutlich eine Taube "
	   "darstellen soll. Allerdings bist Du Dir da nicht ganz sicher.\n");
  SetProp (P_NAME, "Gluecksbringer");
  SetProp (P_INFO, "Wirklich Glueck scheint dieser Gluecksbringer wohl nicht zu bringen.");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 10);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_WOOD);
}
