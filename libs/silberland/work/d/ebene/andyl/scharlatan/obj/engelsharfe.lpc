/* Eine Engelsharfe aus Radenos Bardengilde
** 
** by Andyl@Silberland
**
** 2002-06-06
** Last updated: 2002-06-06
*/

inherit "/p/std/barden/instrument";
#include "/gilden/bardengilde/bardengilde.h"

#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Engelsharfe");
  SetProp(P_LONG, 
	  "Das ist eine Engelsharfe aus der Bardengilde von Radeno. "
	  "Sie besteht aus gold angestrichenem Holz und vier "
	  "Bronzesaiten. In das Holz ist ein kleiner Engel "
	  "grob hineingeschnitzt worden. Das ist mit Sicherheit "
	  "keine Qualitaetsarbeit.\n"); 
  SetProp(P_NAME, "Engelsharfe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"harfe", "engelsharfe"}));
  SetProp(P_INSTRUMENT_TYPE, "unknown");
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:80, MAT_BRONCE:20]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_HANDS, 2);
  SetProp(P_VALUE, 40);
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "getragen");

  AddDetail(({"saiten", "bronzesaiten"}),
	    "Die Engelsharfe hat insgesamt vier Bronzeseiten.\n");
  AddDetail(({"engel"}),
	    "Das Bild eines kleinen Engels wurde grob in das gold angestrichene "
	    "Holz der Engelsharfe geschnitzt.\n");
}














