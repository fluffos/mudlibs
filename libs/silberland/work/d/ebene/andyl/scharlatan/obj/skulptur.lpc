inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({"\nbqskulptur", "skulptur", "kleine skulptur"}));
  SetProp (P_SHORT, "Eine kleine Skulptur");
  SetProp (P_LONG,
	   "Eine kleine seltsam geformte Skulptur. Sie besteht aus "
	   "dunkelgruener Keramik und Du hast nicht die leiseste "
	   "Ahnung was die Skulptur darstellen soll.\n");
  SetProp (P_NAME, "Skulptur");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_MAGIC, 1);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_CERAMIC);
}
