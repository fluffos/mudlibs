** Last updated: 2002-08-04
**
*/

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({"\nbqstimmgabel", "gabel", "stimmgabel"}));
  SetProp (P_SHORT, "Eine Stimmgabel");
  SetProp (P_LONG,
	   "Eine kleine metallene Stimmgabel. Man kann, wenn man sie "
	   "gegen etwas hartes schlaegt und auf einen festen Untergrund "
	   "stellt, zum Schwingen bringen und es wird so ein "
	   "gleichbleibender Ton erzeugt. Syntax <stimmgabelan>.\n");
  SetProp (P_NAME, "Stimmgabel");
  SetProp (P_INFO, "Das ist mit Sicherheit keine gewoehnliche Stimmgabel. "
	   "In ihr scheint eine maechtige Kraft zu stecken die nur darauf "
	   "wartet an der richtigen Stelle freigesetzt zu werden.\n");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_MAGIC, 1);
  SetProp (P_WEIGHT, 120);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_STEEL);
  
  AddCmd(("stimmgabelan"), "kling_mal");
}

int kling_mal()
{
  write(BS("Du bringst die Stimmgabel zum Klingen und bemerkst, "
	   "dass waehrend sie klingt extrem starke Impulse von ihr "
	   "ausgehen. Das scheint keine normale Stimmgabel zu sein.\n")); 
  say(BS(TP->name(WER,0) +" bringt eine Stimmgabel zum Klingen. "
	 "Hoert sich sehr intensiv an.\n"));
  return 1;
}
