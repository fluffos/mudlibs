/* Ein "Spezialfloete" aus Radenos Bardengilde
** 
** by Andyl@Silberland
**
** 2002-06-06
** Last updated: 2002-07-08
*/

inherit "/p/std/barden/instrument";

#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Spezialfloete");
  SetProp(P_LONG, 
	  "Das ist eine Spezielfloete aus der Bardengilde von "
	  "radeno. Was daran allerdings speziell sein soll ist Dir "
	  "ein Raetsel. Es ist nichts weiter als eine grob geschnitzte "
	  "Holzfloete.\n"); 
  SetProp(P_NAME, "Spezialfloete");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spezialfloete", "floete", "holzfloete"}));
  SetProp(P_INSTRUMENT_TYPE, "unknown");
  SetProp(P_INSTRUMENT_LEVEL, 1);
  SetProp(P_HANDS, 2);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "getragen");
}














