#include <moving.h>
#include "../def.h"

inherit "std/room";

string *gewarnt=({});
#define WARNED (member(gewarnt, getuid(this_player()))!=-1)

int skulpturda=1;
int stimmgabelda=1;
int lochda=0;
int treppeda=0;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Lichtung" );
  SetProp(P_INT_LONG,
	  "Du befindest Dich hier auf einer Lichtung direkt hinter der "
	  +"Blockhuette von Radeno. Dichter Wald ist rings um Dich und "
	  +"eine riesige Saeule ragt vor Dir auf. Radeno muss sich irgendwo "
	  +"auf dieser Saeule verstecken, denn Du hoerst Flueche und "
	  +"Beschimpfungen von oben auf Dich herunterprasseln. Irgendwie "
	  +"wirst Du ihn wohl von da oben herunterrunterholen muessen. Nur dazu wirst "
	  +"Du erst mal eine gute Idee benoetigen.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  AddDetail(("idee"),
           "Eine Idee wie man diesen Radeno von der Saeule herunterholt "
           +"waere sicher sehr hilfreich.\n");
  AddDetail(({"flueche", "beschimpfungen"}),
           "Du kannst ihnen ja lauschen.\n");
  AddDetail(({"radeno", "aerger"}),
           "Mit diesem Radeno hat man nichts als Aerger.\n");
  AddDetail(({"lichtung", "mitte"}),
           "Du stehst hier auf einer idyllischen Lichtung in dessen Mitte eine "
           +"Saeule steht.\n");
  AddDetail(({"boden", "waldboden"}),
           "Etwas Gras, etwas Moos und ein paar Farne, ein typischer "
           +"Waldboden eben.\n");
  AddDetail(("gras"),
           "Ganz gewoehnliches gruenes Gras.\n");
  AddDetail(("moos"),
           "Sieht sehr weich aus. Leider ist darin nichts "
           +"zu finden.\n");
  AddDetail(({"farne", "auffaelliges"}),
           "Die Farne sind sehr gross, aber ansonsten kannst Du nichts "
           +"Auffaelliges an ihnen entdecken.\n");
  AddDetail(("wald"),
           "Dichtgedraengt stehen hier die Baeume um die Lichtung herum.\n");
  AddDetail(("baeume"),
           "Es sind hauptsaechtlich Fichten. Eine Fichte faellt Dir "
           +"besonders auf.\n");
  AddSpecialDetail(("fichte"), "fichte_schau");
  AddDetail(({"fichten"}),
           "Mit Deinem professionellen Blick stellst Du fest, dass es "
           +"ganz sicher Fichten sind und keine Tannen wie man vielleicht "
           +"meinen koennte. Eine Fichte faellt Dir besonders auf.\n");
  AddDetail(("blick"),
           "Sehr professionell, aber das erstaunlichste daran ist, dass "
           +"Du Dich gerade selbst beobachtet hast.\n");  
  AddDetail(("tannen"),
           "Keine zu sehen.\n");
  AddDetail(({"blockhuette", "huette"}),
            "Die Blockhuette von Radeno befindet sich westlich "
            +"von hier. Die Geheimtuer durch die Du gekommen bist scheint "
            +"verschwunden zu sein. Du siehst hier auch keinen weiteren "
            +"Ausgang.\n");
  AddDetail(("ausgang"),
            "Kein Ausgang zu entdecken. Hmmm, hoffentlich ist das keine "
            +"Falle.\n");
  AddDetail(("falle"),
            "Koennte eine Falle sein, vielleicht aber auch nicht.\n");
  AddDetail(("geheimtuer"),
            "Die Geheimtuer ist verschwunden. Dieser Radeno scheint "
            +"wohl etwas mit Magie umgehen zu koennen. Sehr aergerlich.\n");
  AddDetail(("magie"),
            "Du bist auch nicht ganz unbewandert was Magie betrifft, "
            +"oder?\n");
  AddDetail(("himmel"),
            "Der Himmel ist strahlend blau. Die Sonne scheint herab "
            +"und kein Woelkchen ist zu sehen. Wenn Du Dich nicht "
            +"mit diesem Radeno herumschlagen muesstest, waere das "
            +"doch genau das richtige Wetter fuer ein Picknick.\n");
  AddDetail(("woelkchen"),
            "Kein Woelkchen am Himmel zu entdecken.\n");
  AddDetail(("picknick"),
            "Gerade das richtige Wetter fuer ein Picknick. Wenn da "
            +"doch nicht dieser Radeno waere.\n");
  AddDetail(("wetter"),
            "Das Wetter waere gerade richtig fuer ein Picknick.\n");  
  AddDetail(("sonne"),
            "Sanft scheint die Sonne auf dich herunter. Sehr angenehm. "
            +"Naja, fuer Dunkelelfen vielleicht nicht so.\n");
  AddDetail(("dunkelelfen"),
            "Dunkelelfen haben ein etwas eigenes Verhaeltnis "
            +"zur Sonne.\n");
  AddDetail(("verhaeltnis"),
            "Sicher kein gutes Verhaeltnis. Aber immerhin ein besseres "
            +"als Vampire zu der Sonne haben.\n");
  AddDetail(("vampire"),
            "Die broeseln in der Sonne immer ziemlich auseinander.\n");
  AddSpecialDetail(({"saeule", "turm"}), "saeule_schau");
  AddSpecialDetail(({"nische", "abdruck", "skulptur"}), "nische_schau");
  AddSpecialDetail(({"treppe", "wendeltreppe"}), "treppe_schau");
  AddSpecialDetail(({"loch", "kleines loch"}), "loch_schau");

  AddSound( ({DEFAULT_SOUND}),
            "Du hoerst wueste Flueche und Beschimpfungen von oben auf "
            +"Dich herunterprasseln.\n");
  AddSound(({"flueche", "fluechen"}),
            "Ui, den Fluechen zufolge scheint Radeno echt sauer auf "
            +"Dich zu sein.\n");
  AddSound(({"beschimpfungen", "kategorie", "banause", "ignoranten", "worte", "woerter"}),
            "Du schnappst solche Worte wie 'Banausen', 'Ignoranten' "
            +"und noch viele Woerter mehr aus dieser Kategorie auf.\n");  
  AddSmell( ({DEFAULT_SMELL}),
            "Riecht gut hier. Nach Moos und Baeumen, nach Wald eben.\n");
  AddSmell(({"moos", "baeume", "baum", "wald"}),
            "Ahh, das riecht gut.\n");
  // EXITS  

  AddSpecialExit( "westen", "ausgang");

  // ITEMS

 // COMMANDS

 AddCmd(({"kletter", "klettere"}), "kletter_auf");
 AddCmd(({"lege", "leg"}), "lege_was");
 AddCmd(({"steck", "stecke"}), "stecke_was");
 AddCmd(({"steig", "steige"}), "steige_hoch");

 // CHATS fuer den RAUM

 AddRoomMessage( ({ "Radeno spuckt Dir von der Saeule auf deinen Kopf.\n",
		      "Radeno kreischt: Du verflixte Banause!\n",
		      "Radeno meint: Nananananana, Du kriegst mich nicht!\n",
		      "Radeno zeigt Dir eine lange Nase.\n",
		      "Radeno meint: "+TP->name(WER,0)+" ist doof und stinkt!\n",
		      "Radeno meint: HA, du wirst mich nicht kriegen, "+TP->name(WER,0)+"!\n",
		      "Radeno singt \(falsch\): \'Ich bin so guuut ich bin so klass...!\'\n"
		      }), 20);

 // FUER DEN VC

 previous_object()->CustomizeObject(); 

}

int ausgang(string str)
{
  if (WARNED)
    {
      return this_player()->move(ROOM+"fakegilde", M_GO,
				 "zurueck in die Bardengilde von Radeno");
    }
  write (BS("Deine Intuition sagt Dir, dass Radeno entkommen wird, "
	    "wenn Du jetzt die Lichtung verlaesst.\n"));                                         
  gewarnt += ({getuid(this_player())});
  return 1;
}

stecke_was(str)
{
  string stri1, stri2;
  object ob;
  notify_fail(BS("Was willst Du wohin stecken?\n"));
  if ((!str || lochda==0)) return 0;
  sscanf(str, "%s in %s", stri1, stri2);
  if ((stri2=="loch") && (stri1=="stimmgabel" || stri1=="gabel"))
    {
      if (!ob=present(("\nbqstimmgabel"),TP))
	{
	  write(BS("Du hast ja gar keine Stimmgabel.\n"));
	  return 1;
	}
      else
	{
	  write(BS("Du steckst die Stimmgabel in das kleine Loch in der Saeule.\n"));
	  ob->remove();
	  call_out(("kaboom1"), 5);
	  return 1;
	}
    }
  if ((stri2=="loch"))
    {
      if (ob=present((stri1),TP))
	{
	  write(BS("Das scheint nicht zu funktionieren.\n"));
	  return 1;
	    }
      else
	{
	  write(BS("Sowas hast Du ja gar nicht.\n"));
	  return 1;
	}
    }
  return 0;
}

void kaboom1()
{
  (TP->move(ROOM+"dummy"), M_GO|M_SILENT|M_NO_SHOW);
  write("\n");
  write (BS("Ploetzlich faengt die Stimmgabel an zu vibrieren "
	    "und einen gleichbleibenden Ton abzugeben der immer "
	    "lauter wird."));
  write("\n");
  call_out(("kaboom2"), 10);
}

void kaboom2()
{
  write(BS("Die Saeule scheint die Schwingungen der Stimmgabel aufzunehmen "
	   "und faengt bedenklich an zu schwanken.")); 
  write("\n");
  call_out(("kaboom3"), 10);
}

void kaboom3()
{

  write(" _  ______      _    ____ _   _   _ _ _ \n"
	"\| \|\/ \/  _ \\    \/ \\  \/ ___\| \| \| \| \| \| \| \|\n"
	"\| ' \/\| \|_\) \|  \/ _ \\\| \|   \| \|_\| \| \| \| \| \|\n"
	"\| . \\\|  _ \<  \/ ___ \\ \|___\|  _  \| \|_\|_\|_\|\n"
	"\|_\|\\_\\_\| \\_\\\/_\/   \\_\\____\|_\| \|_\| \(_\|_\|_\)\n");
  TP->AddHp(-10); 
  write("\n");
  call_out(("kaboom4"), 5);
}

void kaboom4()
{
  write(BS("Mit einem ohrenbetaeubendem Getoese kracht die Saeule in "
	   "sich zusammen. Du schaffst es gerade noch so beiseite zu "
	   "hechten um nicht groeber verletzt zu werden. Radeno wird "
	   "von der Spitze der Saeule in einen nahen Brunnen geschleudert. "
	   "Jetzt solltest Du ihn schnappen koennen.\n"));
  write("\n");
  call_out(("kaboomende"), 10);
}

void kaboomende()
{  
  //  TP->move(ROOM+("brunnen:"+getuid(this_player())), M_TPORT|M_SILENT);
  TP->move(ROOM+"brunnen:"+getuid(this_player()), M_TPORT|M_SILENT);
}

loch_schau()
{
  if ((lochda==0))
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }
  else
    {
      return(BS("Nachdem die Stufen von der Treppe abgebrochen sind "
		"ist jetzt ein kleines Loch in der Saeule. Ob man da "
		"vielleicht etwas hineinstecken kann?\n"));
    }
}

steige_hoch(str)
{
  object ob;
  notify_fail(BS("Was willst Du hochsteigen?\n"));
  if (!str) return 0;
  if (( str == "treppe hoch" || str == "treppe hinauf" ||
        str == "treppe rauf" || str == "wendeltreppe hoch" || 
        str == "wendeltreppe hinauf" || str == "wendeltreppe rauf" ||
	str == "auf treppe" || str == "auf wendeltreppe" ||
	str == "treppe hoch" || str == "wendeltreppe hoch" ||
	str == "treppe nach oben" || str== "wendeltreppe nach oben"))
    {
       if ((treppeda==0))
        {
          return 0;
        }
       else
        {
	  if ((lochda==1))
	    {
	      write(BS("Du kannst die Treppe nicht mehr hochsteigen "
		       +"da sie kaputt ist.\n"));
	      return 1;
	    }
	  else
	    {
	      write("\n*knirsch* *knarsch* *KRAAAAAACH*\n");
	      write(BS("Du steigst Die Treppe nach oben als ploetzlich "
		       +"ein Gelaechter von oben erschallt, eine paar Stufen "
		       +"unter Dir nachgeben, abbrechen und Du in Richtung "
		       +"Boden faellst und ziemlich unsanft landest.\n"
		       +"In der Saeule ist jetzt ein kleines Loch wo vorher "
		       +"ein Teil der Treppe war.\n"));
	      TP->AddHp(-15);
	      lochda=1;
	      if ((stimmgabelda==1))
		{
		  if (!ob=present(("\nbqstimmgabel"),TP))
		    {
		      write(BS("Als Du Dich wieder erhebst faellt Dir eine "
			     +"Stimmgabel auf die im Moos so gut versteckt war, "
			       +"dass Du sie vorher nicht entdeckt hast.\n"
			       +"Du steckst sie natuerlich sofort ein.\n"));
		      CLONE(OBJ+"stimmgabel",(TP));
		      stimmgabelda=0;
		      return 1;
		    }
		  else return 1;
		} 
	      else return 1; 
	    }
	}
    }   
  else return 0;
}

treppe_schau() 
{
  if ((treppeda==0)) 
    {
      return("Sowas siehst Du da nicht!\n");
    }
  else 
    {
      if ((lochda==1))
	{
	  return(BS("Einige Stufen der Wendeltreppe sind abgebrochen, sodass "
		    "man nicht mehr an ihr hochsteigen kann. Ein kleines Loch "
		    "ist stattdessen jetzt in der Saeule.\n"));
	}
      else
	{
	  return(BS("Die Wendeltreppe fuehrt aussen an der Saeule "
		    +"nach oben. Vielleicht kann man die ja hinaufsteigen.\n"));
    
	}
    }
}

lege_was(str)
{
  object ob;
  notify_fail(("Was willst Du in was legen?\n"));
  if (!str) return 0;
  if ((str=="skulptur in nische" || str=="skulptur in form" ||
       str=="skulptur in nische hinein" || str=="skulptur in form hinein" ||
       str=="kleine skulpur in nische" || str=="kleine skulptur in form" || 
       str=="kleine skulpur in nische hinein" || str=="kleine skulptur in form hinein"))
    if (!ob=present(("\nbqskulptur"),TP))
      {
	write(BS("Sowas hast Du ja gar nicht!\n"));
	return 1;
      }
    else
      {
	if ((treppeda==1))
	  {
	    write(BS("Nichts passiert.\n"));
	    return 1;
	  }
	else
	  {
	    write("\n*KLICK* *KLACK* *WUSCH*\n");
	    write(BS("Du legst die Skulptur in die Nische und Du "
		     +"hoerst ein Rumpeln als aus der Saeule ploetzlich "
		     +"eine Wendeltreppe herausfaehrt.\n"));
	    ob->remove();
	    treppeda=1;
	    return 1;
	  }
      }
  return 0;
}

kletter_auf(str)
{
  notify_fail(BS("Auf was willst Du klettern?\n"));
  if (!str) return 0;
  if ((str == "saeule hoch" || str == "saeule hinauf" ||
       str == "auf saeule" || str == "saeule rauf" ))
    {
      write(BS("Trotz aller Bemuehungen schaffst Du es "
               +"nicht die Saeule hochzuklettern. Du rutscht "
               +"einfach immer sofort ab.\n"));
      return 1;
    }
  else return 0;
}

saeule_schau()
{
   if (treppeda==0)
     {
       return(BS("Die Saeule ist aus einem hellgrauen Gestein und "
                 +"absolut glatt. Raufklettern kann man da sicher nicht. "
                 +"Wie Radeno da wohl raufgelangt ist? Eine kleine Nische "
                 +"faellt Dir an der Saeule auf.\n"));
     }
   else
     {
       if (lochda==1)
	 {
	   return(BS("Die Saeule ist aus einem hellgrauen Gestein und "
		     +"eine kaputte Wendeltreppe fuehr an ihr nach oben. "
		     +"Du kannst ausserdem ein Loch in der Saeule entdecken.\n"));
	 }
       {
	 return(BS("Die Saeule ist aus einem hellgrauen Gestein und "
		   +"eine Wendeltreppe fuehr an ihr nach oben. Vielleicht "
		   +"kannst Du ja an der Treppe hoch steigen? Eine kleine "
		   +"Nische faellt Dir zudem auf.\n"));     
       }
     }
}


nische_schau()
{
   if (treppeda==0)
     {
       return(BS("Die Nische hat eine eigenartige Form. Sie aehnelt "
                 +"entfernt dem Abdruck irgendeiner Skulptur. "
                 +"Ob man da wohl etwas hineinlegen kann?\n"));
     }
   else 
     {
       return(BS("In der Nische steckt eine Skulptur.\n"));
     }
}

fichte_schau()
{ 
  object ob;
  if ((!ob=present(("\nbqskulptur"),TP) && skulpturda==1))
    {
      skulpturda=0;
      CLONE(OBJ+"skulptur",(TP));
      return (BS("Als Du die Fichte naeher untersuchst faellt Dir eine "
		 "kleine Skulptur auf, welche Du nach kurzem Ueberlegen an "
		 "Dich nimmst.\n"));
    }
  else 
    {
      return("Du untersuchst die Fichte naeher, findest aber nichts.\n");
    }
}

void reset()
{
  ::reset();
  treppeda=0;
  lochda=0;
  skulpturda=1;
  stimmgabelda=1;
  gewarnt=({});
}
