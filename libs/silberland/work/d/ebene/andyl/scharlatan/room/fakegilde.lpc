inherit "std/laden";

#include <moving.h>
#include <defines.h>
#include "../def.h"

#define LAGER ROOM+"fgilde_lager"
#define RAS(x) break_string(x, 78, "Radeno sagt: ", 1)

int schatz=random(5);

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In der Bardengilde von Radeno" );
  SetProp(P_INT_LONG,
	  "Du befindest Dich hier in der Bardengilde von Radeno. Das "
	  +"Gildengebaeude ist eine einfache Blockhuette ohne besondere "
	  +"Verzierungen. Ein Regal mit einigen Instrumenten steht an der "
	  +"Nordwand, direkt neben dem Regal haengt zudem eine Tafel. "
	  +"Eine Bank, ein Tisch und eine eiserne Truhe bilden "
	  +"die gesamte uebrige Einrichtung. Durch zwei Fenster im Sueden "
	  +"faellt das Sonnenlicht herein. Durch eine Tuere im Westen kommst "
	  +"Du zurueck in den Silberwald.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  AddDetail(("einrichtung"),
          "Weder ist die Einrichtung hier sehr aufwendig, noch "
          +"ist sie besonders stilvoll.\n");
  AddDetail(({"tuer", "tuere"}),
          "Durch die Tuer geht es zurueck in den Silberwald.\n");
  AddDetail(({"wald", "silberwald"}),
          "Geh durch die Tuere, dann kannst Du den Silberwald "
          +"genau untersuchen.\n");
  AddDetail(({"gebaeude", "gildengebaeude", "huette", "blockhuette"}),
            "Das Gildengebaeude ist eine einfache Blockhuette. Etwas "
            +"schlicht, findest Du nicht?\n");
  AddDetail(("nordwand"),
            "An der Nordwand steht ein Regal und danneben haengt eine "
            +"Tafel.\n");
  AddDetail(("regal"),
            "In dem Regal liegen verschiedenste Instrumente.\n");
  AddDetail(("instrumente"),
            "Die Instrumente sehen ungepflegt aus und sind mit "
            +"Sicherheit auch verstimmt. Einem jeden Musiker wuerde "
            +"einem das Herz deswegen schmerzen.\n");
  AddDetail(("sicherheit"),
            "So wie die Instrumente aussehen sind die sicher verstimmt.\n");
  AddDetail(({"musiker", "herz"}),
            "Einem jeden Musiker wuerde ob so schlecht gepflegter "
            +"Instrumente das Herz weh tun.\n"); 
  AddDetail(({"fenster"}),
            "Als Du durch das Fenster schaust siehst Du einen kleinen "
            "Vogel, der Dich ploetzlich verschlagen anblinzelt,\n");
  AddDetail(("vogel"),
	    "Als Du den Vogel naeher betrachten willst, fliegt er ploetzlich "
	    +"schnell aus deinem Sichtfeld. Aber Du bist Dir sicher, dass "
	    +"dieser Vogel eine Elster war.");
  AddDetail(("sichtfeld"),
	    "Auch Dein Sichtfeld ist nicht unbegrenzt gross.");
  AddDetail(("elster"),
	    "Elstern sollen ja bekanntlich sehr diebisch sein.\n");
  AddDetail(("sonne"),
            "Die Sonne scheint durch die beiden Fenster herein.\n");
  AddDetail(({"sonnenlicht", "licht"}),
            "Das Sonnenlicht faellt durch die Fenster herein.\n");
  AddDetail(("verzierungen"),
            "Verzierungen sind hier keine zu entdecken.\n");
  AddDetail(({"tisch", "holztisch"}),
            "Ein klobiger unschoener Holztisch.\n");
  AddDetail(({"bank", "holzbank"}),
            "Eine wackelig aussehende Holzbank. Auf ihr ist ein "
            +"Spruch eingraviert.\n");
  AddDetail (({"spalte", "rueckwand"}),
	     "Seltsam, Du haettest schwoeren koennen, dass Du an "
	     +"der Rueckwand der Huette eine Spalte entdeckt hast. Aber es ist keine Spur "
	     +"mehr von ihr zu finden.\n");
  AddDetail(("spruch"),
            "Du kannst ihn lesen.\n");
  AddReadDetail(("spruch"),
            "Mit etwas Trug und etwas Schein\n" 
            +"sack ich hier maechtig Kohle ein.\n"
            +"\n"
            +"                            R.\n");
  AddDetail(({"truhe", "eisentruhe"}),
            "Eine schwere Eisentruhe. Was da wohl drinnen ist?\n");
  AddDetail(("tafel"),
            "Du kannst sie lesen.\n");
  AddReadDetail(("tafel"),
		",.-,.-.,-,-.,-,.-,-.,-,-.,-.\n"
		"|                           |\n" 
		";  PREISLISTE               \}\n"
		";                           ;\n"
		"|  Gildenbeitritt      800  |\n"
		"'  Spezialfloete       ?    |\n"
		"|  Engelsharfe         ?    ;\n"
		"\}  Bardenkapuze       1000  |\n"	
		";  Bardenanstecker     200  \}\n"  
		";  Gluecksbringer      100  ;\n"
		"\}  Bardenfaehnchen     100  \{\n"
		"|  Liedertexte         100  |\n"
		";                           ;\n"
		" ',-.,-.,.,--.,-.,.-.,.-.;.' \n");
  AddDetail(("bardengilde"),
            "Du befindest Dich hier in der Bardengilde von Radeno. "
            +"Irgendwie scheint dies aber nicht die echte Bardengilde "
            +"zu sein. Du hast da so ein bestimmtes Jucken im kleinen "
            +"Finger.\n");
  AddDetail(({"jucken", "finger"}),
            "Dein kleiner Finger juckt staendig. Irgendetwas scheint hier "
            +"faul zu sein.\n"); 
  AddDetail(("boden"),
            "Der Boden besteht aus einfachen Holzbrettern und ist nicht "
            +"besonders gut gepflegt worden.\n");
  AddDetail(({"holzbretter", "bretter", "arbeit"}),
            "Die Bretter sind nicht gerade eine sehr saubere Arbeit. "
            +"Irgendwie haette man sich in einer Bardengilde besseres "
            +"erwartet.\n");
  AddDetail(({"wand", "waende", "auffaelliges"}),
             "Die Waende sind aus dicken, grob gearbeiteten Holzbalken. "
             +"An der Nordwand haengt neben einem Regal eine Tafel. "
             +"Ansonsten ist an den Waenden nichts Auffaelliges zu "
             +"entdecken.\n");
  AddDetail(({"balken", "holzbalken", "werk"}),
            "Die Holzbalken sind aeusserst unsauber gearbeitet. Ein "
            +"jeder Tischler muesste sich fuer so eine Werk schaemen.\n");
  AddDetail(("tischler"),
            "Ein Tischler duerfte sich nicht so ein Werk wie diese "
            +"Holzbalken erlauben.\n");
  AddDetail(({"decke", "holzgestell"}),
            "Auch die Decke besteht aus einem Holzgestell, welches "
            +"anschliessend mit Holzschindeln gedeckt wurde.\n"); 
  AddDetail(({"schindeln", "schindel", "holzschindel", "holzschindeln"}),
            "Die sehen etwas lose aus, hoffentlich faellt Dir keine "
            +"von diesen auf den Kopf.\n");
  AddDetail(("kopf"),
            "Argh, da hat sich eine Schindel geloest! Genau ueber Dir! "
            +"Die wird Dich voll am Kopf erwischen!\n"
            +"Puhh, Glueck gehabt. Die Schindel ist doch noch knapp an "
            +"Dir vorbeigesaust.\n");
  AddDetail(("glueck"),
            "Jaja, manchmal kann man Glueck echt brauchen.\n");
  AddDetail(("radeno"),
            "Hmmm, der scheint wohl gerade nicht hier zu sein.\n");

  AddSound( ({DEFAULT_SOUND}),
            "Es ist eigentlich ziemlich ruhig hier. Irgendwie schon seltsam.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
            "Riecht etwas stickig hier.\n");
  // EXITS  

  AddExit( "westen", "/d/ebene/ronja/feenquest/room/weg1.lpc"); 

  // ITEMS
  
  AddItem(NPC+"radeno", REFRESH_DESTRUCT);
  RemoveItem("/obj/entsorg");
  SetStorageRoom(LAGER);
  SetBuyFact(10);

  // COMMANDS
  
  AddCmd(({"sag", "sage"}), "sag_was");
  AddCmd(({"tritt"}), "tritt_bei");
  AddCmd(({"oeffne"}), "oeffne_was");

  // FUER DEN VC
  
  previous_object()->CustomizeObject();   
}

sag_was(str)
{
  object ob;
  if (!str) return 0;
  if (!ob=present("radeno", TO)) return 0; 
  if ((str=="radeno artyrian schickt mich" || str == "artyrian schickt mich" || 
       str == "artyrian schickt mich\!" || str == "artyrian schickt mich."))
    {
      if ( (TP->QueryProp(P_GUILD)=="bardengilde") && (TP->QueryProp(P_GUILD_LEVEL)==2) )
	{
	  if (call_other("/gilden/bardengilde/master/bardenmaster","CheckTask", TP, 2)==1)
	    {
	      write(BS("Radeno meint: \'NEIIIN, nicht schon wieder!\'. Und ganz ploetzlich "
		       "verschwindet er in einer Rauchwolke.\n"));
	      say(BS("Radeno meint: \'NEIIIN, nicht schon wieder!\'. Und ganz ploetzlich "
		     "verschwindet er in einer Rauchwolke.\n"));
	      // Radeno destructen nicht vergessen
	      ob->move("/room/npcasylraum", M_GO|M_SILENT|M_NO_SHOW);
	      call_out(("radenozurueck"), 120);
	      return 1;
	    }
	  else
	    {
	      // wenn nein -> Radeno flieht. Sequenz ab. 
	      ob->move("/room/npcasylraum", M_GO|M_SILENT|M_NO_SHOW);
	      write(BS("Als Du diese Worte sprichst, mustert Radeno Dich, erblickt "
		       +"Deine Bardenbrosche und ergreift ploetzlich "
		       +"blitzschnell die Flucht und hechtet in eine Spalte welche "
		       +"sich in der Rueckwand der Huette aufgetan "
		       +"hat. Kurz entschlossen hechtest Du hinterher.\n"));
	      say(BS("Radeno verschwindet ploetzlich in einer Spalte in der Rueckwand der Huette. "+TP->name(WER,0)
		     +" hechtet folgt ihm durch die Spalte, welche sich sogleich wieder schliesst.\n"));
	      (TP->move(ROOM+"dummy"), M_GO|M_SILENT|M_NO_SHOW);
	      call_out(("verfolgung"), 2);
	      return 1;
	    }
	}
      else
	{ 
	  if ( (TP->QueryProp(P_GUILD)=="bardengilde") && (TP->QueryProp(P_GUILD_LEVEL) > 2) )
	    {
	      write(BS("Radeno meint: \'NEIIIN, nicht schon wieder!\'. Und ganz ploetzlich "
		       +"verschwindet er in einer Rauchwolke.\n"));
	      say(BS("Radeno meint: \'NEIIIN, nicht schon wieder!\'. Und ganz ploetzlich "
		     +"verschwindet er in einer Rauchwolke.\n"));
	      ob->move("/room/npcasylraum", M_GO|M_SILENT|M_NO_SHOW);

	      call_out(("radenozurueck"), 120);
	      return 1;
	    }
	  else
	    {
	      write(BS("Radeno brummt: Das kann ja jeder behaupten.\n"));      
	      say(BS(TP->name(WER,0)+" sagt: Arytrian schickt mich.\nRadeno brummt: Das kann ja jeder behaupten.\n"));
	      return 1; 
	    }
	}
    }
  else return 0;
}

void verfolgung()
{
  write("\n");
  write(BS("Du siehst wie Radeno ueber eine Treppe auf eine Saeule hinter "
	   "seiner Gilde flieht und waehrend er nach oben steigt verschwindet die Treppe in "
	   "der Saeule. Die Spalte durch welche Du gerade gehechtet bist "
	   "ist ebenfalls verschwunden. Jetzt wirst Du Radeno wohl irgendwie von dieser "
	   "Saeule herunterbringen muessen.\n"));
  call_out(("zumbrunnen"), 6);
}

void zumbrunnen()
{
  write("\n");
  TP->move(ROOM+"lichtung:"+getuid(this_player()), M_TPORT|M_SILENT);
}


int radeno_zurueck()
{
  if(present("radeno", TO)) return 1;
  else 
    {
      // GIBTS NO NIX
    }
}


oeffne_was(str)
{
  object ob;
  int geld;
  notify_fail(BS("Was willst Du oeffnen?\n"));
  if (!str) return 0;
  if ((str == "eisentruhe" || "truhe"))
    {
      if(present("radeno", TO)) 
	{
	  write(BS("Radeno klopft dir auf die Finger und meint: Weg von der Truhe!"));
	  return 1;
	}
      else
	{
	  if(ob=present("radeno", "/room/npcasylum"))
	    {
	      write(BS("Radeno erscheint ploetzlich wieder in einer Schwefelwolke, "
		       +"klopft dir auf die Finger und meint: Weg von der Truhe!"));
	      ob->move(TO, M_GO|M_SILENT|M_NO_SHOW);
	      return 1;
	    }
	  else
	    {
	      if (schatz==4)
		{
		  geld=random(500);
		  write(BS("Du oeffnets die Truhe und findest darin "+geld+" Muenzen, welche "
			   "Du sogleich einsteckst.\n"));
		  TP->AddMoney(geld);
		  schatz=0;
		  return 1;
		}
	      else
		{
		  write(BS("Du oeffnest die Truhe aber wie Du feststellen musst ist sie leider leer.\n"));
		  return 1;
		}
	    }
	}
    }
  return 0;
}

tritt_bei(str)
{
  object ob;
  notify_fail(BS("Wem willst Du beitreten?\n"));
  if (!str) return 0;
  if ((str == "gilde bei" || str== "bardengilde bei" || str == "barden von radeno bei" || 
       str == "bardengilde von radeno bei" || str == "barden bei"))
    {
      
      if(!present("radeno", TO)) 
	{
	  write(BS("Ohne Radeno geht das nicht!\n"));
	  return 1;
	}
      if (ob=present(("\nradenourkunde"), TP))
	{
	  write(RAS("Du bist doch schon Mitglied meiner Gilde, such Dir lieber noch ein "
		    "paar Sachen aus meinem reichhaltigem Angebot aus."));
	  return 1;
	}
      
      if((TP->QueryMoney()) < 800)
	{
	  write(RAS("Du hast leider zuwenig Geld. Der Gildenbeitritt "
		    +"kostet dich 800 Muenzen."));
	  return 1;
	}
      else
	{
	  TP->AddMoney(-800);
	  ob=clone_object(OBJ+"urkunde");
	  ob->move(TP, M_NOCHECK);
	  write(BS("Du gibst Radeno 800 Muenzen und bekommst dafuer eine Mitgliedsurkunde.\n"));
	  write(RAS("Du hast eine sehr gute Wahl getroffen, "+TP->name(WER,0)+"."));
	  return 1;
	}
      return 0;
    }
  else return 0;
}

sell(string str, int f)
{
  object ob;
  notify_fail("Was willst Du verkaufen?\n");
  if (!str) return 0;
  if(!present("radeno", TO)) 
    {
      write(BS("Ohne Radeno geht das nicht.\n"));
      return 1;
    }
  if (!ob=present(str, TP))
    {
      write ("Sowas hast ja so etwas gar nicht!\n");
      return 1;
    }
  else
    {
      write(BS("Radeno meint: Tut mir leid, aber ich kaufe nichts an.\n"));
      say(BS("Radeno meint zu "+TP->name(WER,0)+": Tut mir leid, "
	     "aber ich kaufe nichts an.\n"));
      return 1;
    }
  return 0;
}

force_sell() { return sell(); }
evaluate() { return sell(); }

void reset()
{
  ::reset();
  schatz=random(5);
}
