#include <moving.h>
#include "../def.h"

inherit "std/room";

string *gewarnt=({});
#define WARNED (member(gewarnt, getuid(this_player()))!=-1)

int eimerposition=0;
int rohrgefunden=0;
int rohrfrei=0;
int brunnenwasser=0;
int radenoimeimer=0;
int zeit=20;

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einer Lichtung hinter Radenos Haus" );
  SetProp(P_INT_LONG,
	  "Du befindest Dich hier auf einer Lichtung hinter Radenos Haus. "
	  +"In der Mitte der Lichtung steht ein einfacher Steinbrunnen. "
	  +"Ueberall liegen die Bruchstuecke von der Saeule "
	  +"herum, welche Du zum Einsturz gebracht hast. Ein kleiner Bach "
	  +"plaetschert ausserdem oestlich von Dir dahin. Die Lichtung ist von "
	  +"Baeumen dicht umgeben und aus dem Brunnen hoerst Du ein "
	  +"leises Roecheln gefolgt von heftigen Fluechen.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_FOREST]));
  
  // DETAILS
  AddDetail(("radeno"),
            "Dem Fluchen zufolge muss er irgendwo unten im Brunnen sein.\n");
  AddDetail(("baeume"),
            "Die Lichtung ist dicht von Baeumen umgeben. Da sind "
            +"Nadelbaeume und viele Laubbaeume zu sehen. Die Baeume "
            +"sehen allesamt sehr gesund und kraeftig aus.\n");
  AddDetail(("nadelbaeume"),
            "Da sind Tannen, Fichten, Laerchen und ein paar Foehren "
            +"zu sehen. Nadelbaeume eben.\n");  
  AddDetail(("laubbaeume"),
            "Als Du die Laubbaeume untersuchst faellt Dir eine Linde "
            +"besonders auf.\n");
  AddDetail(("linde"),  
            "Da wurde etwas in den Stamm der Linde eingeritzt\n");
  AddDetail(({"stamm", "herz", "initialen"}),
	    "In den Stamm der Linde wurde ein Herz eingeritzt in "
	    "welchem 'R. \+ G.' steht. Fuer wen die Initialen wohl stehen?\n"); 
  AddDetail(({"tannen", "tanne"}),
            "Du kannst an den Tannen nichts besonderes entdecken "
            +"ausser das sie gesund und kraeftig wirken.\n");
  AddDetail(({"foehre", "foehren"}),
            "Dir faellt nichts Besonderes an den Foehren auf.\n");
  AddDetail(({"fichte", "fichten"}),
            "Die Fichten sind zwar schoen anzusehen aber ansonsten "
            +"kannst Du nichts Auffaelliges an ihnen entdecken.\n");
  AddDetail(({"besonderes", "auffaelliges"}),
            "Nichts zu finden.\n");
  AddDetail(("laerchen"),
            "Von Laerchen weisst Du noch, dass diese im Winter im Gegensatz "
            +"zu anderen Nadelbaeumen, ihre Nadeln verlieren. Was Besonderes "
	    +"faellt Dir jedoch nicht an ihnen auf.\n");
  AddDetail( ({"winter", "nadeln", "gegensatz"}),
	     "Im Winter verlieren Laerchen im Gegensatz zu anderen "
	     +"Nadelbaeumen ihre Nadeln.\n"); 
  AddDetail(("haus"),
            "Radenos Haus befindet sich westlich von hier.\n");
  AddDetail(("boden"),
            "Der Boden ist mit Gras, Farnen und Moos bedeckt.\n");
  AddSpecialDetail(({"moos"}), "moos_schau");
  AddDetail(("gras"),
            "Ganz normales gruenes Gras.\n"); 
  AddDetail(("sitzen"),
            "Naja, setzt Dich halt einfach hin.\n");
  AddDetail(("farne"),
            "Kleine und auch groessere Farne wachsen hier "
            +"ueberall am Boden.\n");
  AddDetail(("einsturz"),
            "War ja wohl klar, dass Du immer alles kaputt machen musst "
            +(TP->QueryProp(P_NAME))+".\n");   
  AddDetail(("mitte"),
            "In der Mitte der Lichtung steht ein Brunnen.\n");
  AddDetail(({"lichtung", "ort"}),
            "Du stehst hier auf einer idylischen Lichtung. Ein Brunnen "
            +"steht in der Mitte von ihr.\n");  
  AddDetail(("saeule"),
            "Viel ist von der Saeule jetzt ja nicht mehr ueber.\n");
  AddDetail(("bruchstuecke"),
            "Ueberall liegen hier Bruchstuecke der Saeule die Du zerstoert "
            +"hast herum.\n");
  AddDetail( ("himmel"),
	     "Durch die Kronen der Baeume hindurch kannst Du einen "
	     +"strahlend blauend Himmel sehen von dem die Sonne froehlich "
	     +"auf Dich herabscheint.\n");
  AddDetail(({"baumkronen", "kronen"}),
            "Es sind grosse, praechtige Baumkronen welche die Baeume hier "
	    +"haben. Wirkt fast schon ein wenig kitschig.\n");
  AddDetail(({"sonne", "lebewesen"}),
            "Fröhlich scheint die Sonne auf diesen Ort herab und erfreut "
            +"die alle Lebewesen. Naja, vielleicht nicht alle. Dunkelelfen "
            +"werden da sicher anderer Meinung seien.\n");
  AddDetail(({"dunkelelfen", "volk"}),
            "Dunkelelfen sind ein etwas lichtscheues Volk.\n");
  AddDetail(({"meinung"}),
            "Tja, Meinungen können allzuoft voneinander abweichen.\n"); 
  AddSpecialDetail(({"brunnen", "steinbrunnen", "grund", "wasserstand"}), "brunnen_schau");
  AddDetail(("winde"),
            "Wenn Du an der Winde kurbelst kannst Du den Eimer in den "
            +"Brunnen hinablassen oder wieder herausziehen.\n");
  AddSpecialDetail(("eimer"), "eimer_schau");
  AddDetail(("seil"),
            "An dem Seil haengt der Eimer.\n");
  AddDetail(({"bach", "baechlein"}),
	    "Der Bach ist absolut klar und plaetschert vor sich hin. "
	    +"Einzig der Verlauf des Baches stoert Dich ein wenig, der "
	    +"wirkt viel zu geradlinig, ohne Biegungen, welche Deiner "
	    +"Meinung nach ja viel besser aussehen würde.\n");
  AddDetail(({"biegungen", "schleifen"}),
	    "Der Bach hat untypischerweise keine Biegungen oder Schleifen "
	    +"in seinem Verlauf. Zumindest soweit Du das von hier sehen "
	    +"kannst.\n"); 
  AddDetail(("verlauf"),
	    "Der Verlauf des Baches ist viel zu geradlinig. Ob man wohl "
	    +"daran etwas aendern kann.\n");
  AddSpecialDetail(("wasser"),"wasser_schau");
  AddDetail(({"wassernachschub", "naehe"}),
	    "Hmmm, da ist ja ein Bach gleich in der Naehe.\n");
  AddDetail(({"flueche", "roecheln"}),
            "Lausch mal.\n");
  AddSound( ({"fluch", "flueche"}),
	    "Solche verbalen Entgleisungen moechtest Du doch sicher "
            +"hoeren, oder?\n");
  AddSound( ("roecheln"),
            "Auwehhhhhhhhhhh!\n");
  AddSound( ({"entgleisungen"}),
	    "Du willst sowas echt hoeren? Solche unzivilisierten "
	    +"Aussprueche?\n");
  AddSound( ({"aussprueche", "spieler", "zustand", "gestalten", "silberland"}),
	    "Also gut. Du hast es ja nicht anders gewollt!\n"
	    +"Radeno flucht: Ich hasse diese *beep* Spieler, "
	    +"diese absolut nichtsnutzigen *beep*. Es ist ein "
	    +"*beep* *beep* *beep* Zustand, dass sich solche "
            +"*beep* Gestalten wie "+TP->QueryProp(P_NAME)
	    +" im Silberland herumtreiben duerfen!\n"
	    +"-----------------------------------------------\n"
	    +"Anmerkung: Zur Wahrung der Mudiquette wurden "
	    +"die *beeps* eingesetzt.\n");
  AddDetail(({"anmerkung", "wahrung", "mudiquette", "beep" "beeps"}),
	    "Die *beeps* wurden zur Wahrung der Mudiquette eingesetzt.\n");
  AddDetail(("schlamm"),
	    "Ekliger, schwarzgruenbrauner Schlamm.\n");
  AddSpecialDetail(({"rohr", "metallrohr"}), "rohr_schau");
  AddSound( ({DEFAULT_SOUND}),
            "Du hoerst ein leises Roecheln gefolgt von heftigen "
	    +"Fluechen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "wald"}),
            "Riecht nach gesundem Wald. Sehr angenehm.\n");
  // EXITS  
   
  AddSpecialExit( "westen", "ausgang");
  // ITEMS
  
  // COMMANDS
    
  AddCmd(({"hilf", "helfe", "rette"}), "hilf_wem");
  AddCmd(({"kurbel", "kurble"}), "kurbel_was");
  AddCmd(({"setz", "setze", "sitze", "sitz"}), "setze_auf");
  AddCmd(({"reinige", "saeubere"}), "reinige_was"); 

  // FUER DEN VC

  previous_object()->CustomizeObject();  
}

int ausgang(string str)
{
  int oldalign, newalign;
  oldalign=0;
  newalign=0;
  if (WARNED)
    {
      if (brunnenwasser > 4)
	{
	  oldalign=(TP->QueryProp(P_ALIGN));
	  newalign=oldalign+100;
	  if (newalign < -2666) newalign=-2666;
	  TP->SetProp(P_ALIGN, newalign);
	}
      return this_player()->move(ROOM+"fakegilde", M_GO,
				 "zurueck in die Bardengilde von Radeno");
    }
  if (brunnenwasser > 4)
    {
      write (BS("Du bist Dir ziemlich sicher, dass Radeno "
		"ertrinken wird wenn ihm jetzt niemand hilft."
		"Du haeltst noch einmal kurz inne.\n"));
    }
  else
    {
      write (BS("Deine Intuition sagt Dir, dass Radeno entkommen wird, "
		"wenn Du jetzt die Lichtung verlaesst.\n"));                                         
    }
  gewarnt += ({getuid(this_player())});
  return 1;
}

wasser_schau()
{ 
  if (brunnenwasser==0)
    {
      return(BS("Wasser ist in dem Brunnen fast keines zu entdecken, nur "
		+"ein fluchender Radeno. Ob man vielleicht fuer etwas "
		+"Wassernachschub sorgen koennte?\n"));
    }
  
  else
    {
      return(BS("Permanent fliesst Wasser aus dem Bach durch das metallene Rohr "
		+"in Richtung des Brunnens.\n")); 
    }
}

hilf_wem(str)
{
  notify_fail("Wem willst Du helfen?\n");
  if (!str) return 0;
  if ((str == "radeno" || str == "radeno aus brunnen" || str == "radeno aus steinbrunnen" ||
       str == "radeno heraus"))
    {
      write(BS("Du wuerdest Radeno schon gerne helfen, aber so einfach ist das nicht. Da "
	       "wirst Du Dir was einfallen lassen muessen."));
      return 1;
    }
  else
    {
      return 0;
    }
}

reinige_was(str)
{
  notify_fail("Was willst Du reinigen?\n");
  if (!str) return 0;
  if ((str == "rohr" || str=="metallrohr"))
    {
      if ((rohrgefunden==0))
	{
	  write("Sowas siehst Du da nicht!\n");
	  return 1;
	}
      else
	{
	  if ((rohrfrei==1))
	    {
	      write("Du hast das Rohr doch schon gereinigt!\n");
	      return 1;
	    }
	  else
	    {
	      write(BS("Du raeumst die Erde und das Moos aus dem Rohr "
		       "und ploetzlich rinnt Wasser aus dem benachbartem Bach "
		       "durch das Rohr auf den Brunnen zu und in ihn hinein."));
	      rohrfrei=1;
	      brunnenwasser=1;
	      call_out(("wassermarsch"), 2);      
	      return 1;
	    }
	  
	}
    }
  else return 0;
}

wassermarsch(int i) 
{ 
  int origalign, newalign;
  switch(i) 
    { 
    case 0:
      write("\n");
      write (BS("Radeno kreischt: Argh, wo kommt auf einmal das Wasser her!"));
      zeit=20;
      brunnenwasser=1;
      break; 		
    case 1:
      write("\n");
      write (BS("Radeno jammert: Jetzt hole ich mir sicher auch noch eine Erkaeltung."));
      zeit=20;
      brunnenwasser=2;
      break;
    case 2:
      write("\n");
      write (BS("Radeno jammert: Hoffentlich rinnt nicht noch mehr Wasser in den Brunnen."));
      zeit=20;
      brunnenwasser=3;
      break;
    case 3:
      write ("\n");
      write(BS("Unaufhaltsam steigt das Wasser im Brunnen weiter."));
      write(BS("Radeno jammert: Und ich kann doch gar nicht schwimmen!"));
      zeit=20;
      brunnenwasser=4;
      break;
    case 4:
      write ("\n");
      write (BS("Das Wasser im Brunnen steigt weiter und weiter."));
      write(BS("Radeno fleht Dich an: Bitte, hol mich hier raus!"));
      zeit=20;
      brunnenwasser=5;
      break;
    case 5:
      write("\n");
      write (BS("Und immer mehr Wasser fliesst in den Brunnen."));
      write (BS("Radeno fleht dich verzweifelt an: Bitte, hol mich hier raus, "
		"bald bin ich hier komplett unter Wasser!")); 
      brunnenwasser=6;
      zeit=20;
      break;
    case 6:
      write("\n");
      write (BS("Der Brunnen ist bereits gut mit Wasser gefuehlt und weiterhin "
		"steigt der Wasserspiegel."));
      write(BS("Radeno ruft verzweifelt: HILFE!!! Ich schaff es nicht aus dem Brunnen "
	       "zu klettern. Bitte helft mir! *keuch* *prust*\n"));
      brunnenwasser=7;
      break;
    case 7:
      write("\n");
      write (BS("Eine Unmenge an Wasser ist bereits in den Brunnen geflossen und "
		"weiteres fliesst unaufhaltsam nach."));
      write(BS("Radeno prustet und keucht verzweifelt im Wasser: HILF...*prust*.."
	       "HELFT MI...*schluck* *prust*"));
      write(BS("Du denkst . o O \(Wenn ich Radeno nicht schnell helfe wird er ertrinken.\)"));
      brunnenwasser=8;
      zeit=20;
      break;
    case 8:
      newalign=0;
      origalign=0;
      write("\n");
      write (BS("Du hoerst ein lautes Prusten, ein Roecheln und danach nichts mehr. Der Brunnen "
		"der Brunnen ist mittlerweile voll mit Wasser. Von Radeno ist nichts mehr zu hoeren. "
		"Als Du genauer in den Brunnen blickst, kannst Du Radenos Leiche erkennen die knapp "
		"unter der Wasseroberflaeche treibt. Er ist jaemmerlich ertrunken."));
      
      // ALIGN DES SPIELERS WIRD HERABGESETZT
      
      origalign=TP->QueryProp(P_ALIGN);
      newalign=origalign-200;
      if (newalign < -2666) 
	{
	  newalign=-2666;
	}
      TP->SetProp(P_ALIGN, newalign);
      brunnenwasser=9;
      break;
    case 9:

      if ( (TP->QueryProp(P_GUILD)=="bardengilde") && (TP->QueryProp(P_GUILD_LEVEL)==2) )
	{
	  write(BS("Du bist Dir ziemlich sicher, dass Artyrian sicher nicht so ein Loesung "
		   "gewollt hat. Du haettest Radeno trotz allem helfen sollen."));
	}
      write(BS("Etwas bedrueckt verlaesst Du diesen Ort."));
      TP->move(ROOM+"fakegilde", M_TPORT|M_SILENT);
      remove_call_out("wassermarsch");
      break;
    default:
      write(BS("Hier passt etwas nicht! Bitte Andyl verstaendigen.\n"));
      break;
    }
  i++;
  call_out("wassermarsch", zeit, i);
}

moos_schau()
{
  
  if (rohrgefunden==0)
    {
      return(BS("Gruen und schoen weich. Sofern einigermassen trocken "
		+"ideal zum darauf Sitzen.\n"));
    }
  else
    {
      write(BS("Gruen und schoen weich. Sofern einigermassen trocken "
	       +"ideal zum darauf Sitzen.\n"));
      if ((rohrfrei==0))
	{
	  return(BS("Ein altes verstopftes Metallrohr ist in dem Moos "
		    +"zu sehen.\n"));
	}
      else
	{
	  return(BS("Ein altes rostiges Metallrohr. Durch diese fliesst das "
		    +"Wasser des Baches in Richtung des Brunnens.\n"));
	}
    }
}
  

rohr_schau()
{
  if ((rohrgefunden==0))
    {
      write("Sowas siehst Du da nicht!\n");
      return 1;
    }
  else
    {
      if ((rohrfrei==0))
	{
	  write(BS("Ein altes rostiges Metallrohr welches von Moos und viel "
		   +"Schlamm verstopft ist. Vielleicht koennte man ja mal "
		   "versuchen das Rohr zu reinigen?\n"));
	  return 1;
	}
      else
	{
	  write(BS("Ein altes rostiges Metallrohr. Das Wasser des Baches fliesst "
		   +"durch es in Richtung des Brunnens und weiter in diesen hinein."));
	  return 1;
	}
    }
}


brunnen_schau()
{   
  if ((brunnenwasser==0))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas aelter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf. Noch dazu scheint in dem "
		"Brunnen praktisch kein Wasser zu sein und das obwohl direkt "
		"daneben ein Bach fliesst. Sehr seltsam. Radeno steht am Grund des "
		"Brunnens und wirft mit unzaehligen Fluechen in deine Richtung "
		"und roechelt dazwischen immer ein wenig.\n"));
    }
  
  if (brunnenwasser==1)
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Radeno steht am Grund des Brunnens unten scheint da unten ziemlich "
		"nass zu werden. Radeno flucht wuestest in deine Richtung."));
    }
  
  if (brunnenwasser==2)
    {
      
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Radeno steht am Grund des Brunnens bis zur Huefte im Wasser. Er sieht "
		"nicht besonders gluecklich aus."));
    }
  
  if ((brunnenwasser==3))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Radeno steht am Grund des Brunnens bis zur Huefte im Wasser. Er sieht "
		"nicht besonders gluecklich aus."));
    }
  
  if ((brunnenwasser==4))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Radeno steht am Grund des Brunnens, das Wasser reicht ihm schon bis zur "
		"Brust. Er macht bereits ein verzweifeltes Gesicht."));
    }

  if ((brunnenwasser==5))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Radeno steht am Grund des Brunnens, das Wasser reicht ihm jetzt schon bis zum "
		"Hals. Er fleht Dich an ihm aus den Brunnen zu helfen."));
    }
  
  if ((brunnenwasser==6))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Der Brunnen ist jetzt schon recht ordentlich mit Wasser gefuellt, Radeno "
		"kann darin kaum noch stehen und nur mit Muehe und Not schafft er es Mund "
		"und Nase ueber Wasser zu halten. Verzweifelt fleht er Dich an ihm dort "
		"rauszuhelfen."));
    }
  
  if ((brunnenwasser==7))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Der Wasserstand des Brunnens ist bereits ziemlich hoch. Radeno versucht "
		"die Waende hochzuklettern rutscht aber immer wieder ab. Er findet zwar "
		"etwas Halt aber da wird er sich nicht lange halten koennen. Er ruft verzweifelt "
		"nach Hilfe."));
    }
  
  if ((brunnenwasser==8))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Unaufhaltsam steigt der Wasserstand im Brunnen weiter. Radeno geht immer wieder "
		"unter, schluckt Wasser, prustet heftig und rudert verzweifelt mit den Armen. Seine "
		"Hilferufe sind mittlerweile kaum noch zu verstehen. Wenn Du ihm nicht sehr rasch "
		"hilfst wird er ertrinken."));
    }
  if ((brunnenwasser==9))
    {
      return(BS("Ein recht schlichter Steinbrunnen, an welchem eine Winde, "
		"mit dazugehoerigem Seil und Eimer befestigt ist. Der Brunnen scheint "
		"schon etwas älter zu sein, denn die Steinkonstruktion weisst "
		"schon einige Risse auf durch welche Wasser in den Brunnen fliesst. "
		"Der Brunnen ist bis obenhin mit Wasser gefuellt in welchem "
		"Radenos Leiche treibt, der jaemmerlich in dem Brunnen ertrunken ist."));
    }
  else 
    {
      return(BS("Hoppla, hier scheint irgendetwas nicht richtig zu "
		"funktionieren. Bitte Andyl verstaendigen."));
    }
}

setze_auf(str)
{
  notify_fail("Auf was willst Du dich setzen?\n");
  if (!str) return 0;
  if (( str == "auf moos" || str == "in moos"))
    {
      if ((rohrgefunden==0))
	{
	  write(BS("Autsch, als Du dich in das weiche Moos setzt "
		   +"stoesst Du mit deinem Bein gegen etwas Hartes.\n"
		   +"Du untersuchst das Ganze naeher und stellst fest das "
		   +"es ein altes Rohr ist.\n"));
	  TP->AddHp(-5);
	  rohrgefunden=1;
	  return 1;
	}
      else
	{
	  write(BS("Nein, noch einmal moechtest Du Dich nicht an dem Rohr "
		   +"verletzen.\n"));
	  return 1;
	}
    }
  else return 0;
}

kurbel_was(str)
{
  notify_fail("An was willst Du kurbeln?\n");
  if (!str) return 0;
  if ((str == "winde" || str == "an winde" || str == "mit winde"))
    {
      if (eimerposition==0)
	{
	  write(BS("Du kurbelst an der Winde und laesst den Eimer "
		   +"damit in den Brunnen herab. Ungluecklicherweise "
		   +"rutscht Dir die Winde aus der Hand, der "
		   +"Eimer beschleunigt nach unten und dann hoerst "
		   +"du nur noch ein lautes \'AUTSCH\' gefolgt von "
		   +"heftigen Fluechen Radenos. Naja, immerhin ist der "
		   +"Eimer jetzt unten.\n"));
	  
	  if ((brunnenwasser > 2 || brunnenwasser < 9 ))
	    {
	      write(BS("Rasch klettert Radeno in den Eimer und meint: "
		       +"Zieh mich bitte rasch hoch!\n"));	
	      radenoimeimer=1;
	    }
	  eimerposition=1;
	  return 1;
	}
      else
	{
	  if (rohrfrei==1)
	    {
	      write(BS("Mit ein paar Kurbelbewegungen ziehst Du den Eimer "
		       +"wieder aus dem Brunnen hoch.\n"));
	      eimerposition=0;
	      
	      if ((brunnenwasser > 2 || brunnenwasser < 9 )) 
		{
		  if (radenoimeimer==0)
		    {
		      write(BS("Als Du den Eimer hochkurbelst stellt sich Radeno "
			       +"schnell in ihn, um so dem vielen Wasser zu entkommen. "
			       +"Erleichtert atmet er auf.\n"));
		    }
		  else 
		    {
		      write(BS("Radenos Gesichtausdruck bessert sich sichtlich als er "
			       "aus dem Brunnen gezogen wird und erleichtert atmet er auf.\n"));
		    }
		  // ALLE WASSERSEQUENZEN KILLEN
		  
		  remove_call_out("wassermarsch");
		  
		  // RETTUNGSSEQUENZ STARTEN
		  
		  /*  object spieler, item;
		  //    spieler=ME->QueryProp(P_KILLER) || this_player();
		   
		  if((spieler->QueryProp(P_GUILD))=="bardengilde" &&
		  (spieler->QueryProp(P_GUILD_LEVEL))==2)
		    {
		    call_other("/gilden/druidenzirkel/master/bardenmaster",
		      "SetTask", spieler, 2);
		      call_other("/gilden/bardengilde", "LogTask", spieler, 2);
		      }
		      return 1;
		      
		  */
		  return 1;
		}
	    }
	  return 1;
	}
    }
  else return 0;
}

eimer_schau()
{
  if (eimerposition==0)
    {
      return(BS("Ein einfacher Holzeimer. Du kannst ihn mit der "
		+"Winde in den Brunnen hinablassen wenn Du willst.\n"));
    }
  else
    { 
      return(BS("Ein einfacher Holzeimer der unten im Brunnen an "
		+"einem Seil baumelt. Mit der Winde kannst Du ihn "
		+"wieder hochziehen.\n")); 
    }
}

void reset()
{
  ::reset();
  eimerposition=0;
  brunnenwasser=0;
  radenoimeimer=0;
  rohrgefunden=0;
  rohrfrei=0;
  zeit=20;
  gewarnt=({});
}
