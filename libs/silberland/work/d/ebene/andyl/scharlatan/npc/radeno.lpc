inherit "std/npc";

#include <language.h>
#include <combat.h>
#include "../def.h"

create()
{
  
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Gildenmeister Radeno");
  SetProp(P_LONG, "Das ist Gildenmeister Radeno. Ein duenner, nicht uebermaessig "
	  +"grosser Mensch mit einem listigen Blick, zurueckfrisierten schwarzen "
	  +"Haaren und einem stetigem fiesen Grinsen auf den Lippen. \n");
  SetProp(P_NAME, "Radeno");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"radeno", "mensch", "meister", "gildenmeister", "gildenmeister radeno", "meister radeno"})); 
  
  create_default_npc( 20 );
  
  SetProp(P_SIZE, 165);
  SetProp(P_BODY, 4);
  SetProp(P_HANDS, ({" mit seinen Haenden", 20, DT_BLUDGEON}));
  SetProp(P_ALIGN, -300 ); 
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOATTACK, "weicht einfach deinem Angriff aus und meint: \'Willst Du nicht lieber etwas kaufen?\'");
  CLONEME((ARMOUR+"bardenkapuze"));
  CLONEME((OBJ+"bardenanstecker"));
  CLONEME((OBJ+"gluecksbringer"));
  
  command_me("trage alles");
  
  SetChats(5, ({
    "Radeno meint: Willst Du nicht meiner Bardengilde beitreten?.\n",
      "Radeno meint: Mit einem meiner Gluecksbringer wird man Dich sicher ueberall bewundern.\n",
      "Radeno versucht unauffaellig sein Geld zu zaehlen.\n",
      "Radeno blickt Dich mit einem haemischen Grinsen an.\n"}) );

  AddInfo(({"artyrian", "brabo", "brabo glasfuss", "irinja", "irinja avia", "kinathias", "andyl", "altrane"}),
	  "Wer soll das sein?\n", "sagt: ");
  AddInfo(({"instrument", "musikinstrument", "instrumente", "musikinstrumente"}),
	  "Mit Musikinstrumenten kann man tolle Musik machen. Und ich hab auch ganz "
	  "tolle Musikinstrumente bei mir im Angebot.\n", "sagt: ");
  AddInfo(({"angebot", "angebote", "sachen"}),
	  "Ich hab hier echt tolle Angebote, Du solltest Dir diese nicht entgehen lassen.\n", "sagt: ");
  AddInfo(({"silberwald", "wald"}),
	  "Wir befinden uns hier im Silberwald.", "sagt: ");
  AddInfo(({"midas"}),
	  "Midas ist die aelteste Stadt im Silberland. Sie liegt nicht allzuweit von hier im Suedoesten.\n", "sagt: ");
  AddInfo(({"geld", "gold", "silber", "diamanten", "edelstein", "edelsteine", "reichtum"}),
	  "reichtum ist etwas, dass man immer anstreben sollte.\n", "sagt: ");
  AddInfo(({"fee", "feen", "schloss", "feenschloss"}),
	  "Jaja, die Feen wohnen auch nicht allzuweit von hier entfernt.\n", "sagt: ");
  AddInfo(({"bardenkapuze", "kapuze"}),
	  "So eine Bardenkapuze ist etwas extrem Bequemes. Ich hab auch welche davon im Angebot.\n", "sagt: ");
  AddInfo(({"engelsharfe", "harfe", "spezialfloete", "floete"}),
	  "Das ist ein ganz tolles Musikinstrument, Du kannst es hier kaufen.\n", "sagt: ");
  AddInfo(({"bardengilde", "gilde"}),
	  "Jaja, das hier ist meine Bardengilde. Willst Du ihr nicht beitreten?\n", "sagt: ");
  AddInfo(({"beitreten", "beitritt"}),
	  "Meiner Gilde kannst Du mit etwas Geld ganz einfach beitreten.\n"
	  "Syntax <tritt gilde bei>\n", "sagt: ");
  AddInfo(({"austritt", "austreten"}),
	  "Aus meiner Gilde will ja sowieso niemand austreten, so toll ist die. Wenn doch "
	  "muss man dazu einfach seine Urkunde zerreissen.\n", "sagt: ");
  AddInfo(({"urkunde"}),
	  "Die Urkunde bekommt man wenn man der Gilde beitritt.\n", "sagt: ");
  AddInfo(({"gluecksbringer"}),
	  "Ich habe selbst so einen Gluecksbringer, der zahlt sich echt aus. Du kannst "
	  "hier ganz einfach einen kaufen wenn Du willst.\n", "sagt: ");
  AddInfo(({"bardenfaehnchen"}),
	  "Die Bardenfaehnchen kann man toll herumschwenken. Du kannst sie hier kaufen.\n", "sagt: ");
  AddInfo(({"bardenanstecker", "anstecker"}),
	  "Diese Bardenanstecker sind sehr modisch wie ich finde. Du kannst sie hier "
	  "kaufen wenn Du willst.\n", "sagt: ");   
  AddInfo(({"texte", "liedertexte", "text", "liedertext"}),
	  "Ich hab ganz tolle Liedertexte im Angebot. Die koennen einen in jeder Situation "
	  "aufheitern.\n", "sagt: ");  
  AddInfo( DEFAULT_INFO,
	   ({ "meint: hoert sich nicht sehr spannend an.\n",
		"sagt: Keine Ahnung davon. Willst Du nicht etwas kaufen?\n",
		"schaut dich unwissend an.\n",
		"meint: Frag nicht, schau Dir lieber meine Angebote an.\n"
		}) );
    
  // NICHT KILLBAR, NUR IN DIE FALLE LOCKBAR MIT DEN BARDEN DER ENTSPRECHENDEN STUFE ODER EINEM SPEZIELLEM ITEM (MUSS ERST GEPROGGT WERDEN),
  // VORERST NUR FUER BARDEN MACHBAR
  // BEI DEM SATZ WIRD EIN INVIS OBJECT GECLONED DER ALS SCHLUESSEL FUER DIE HINTERRAEUME FUNGIERT UND
  // IN WELCHEM AUCH DER ABENTEUERSTATUS EINGETRAGEN WIRD
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "meint wuetend: Lass das!",
        "sagt wuetend zu "+TP->name(WEN)+": Lass das!");
      break;
    case "aergerlich":
      call_out("react", 0, "wird ploetzlich ganz klein", "wird ploetzlich ganz klein");
      break;
    case "traurig":
      call_out("react", 0, "meint: Einer meiner Gluecksbringer wird Dich sicher gluecklich machen.",
	     "sagt zu "+TP->name(WEM, 2)+": Einer meiner Gluecksbringer wird Dich sicher gluecklich machen.");
      break;
    case "albern":
      call_out("react", 0, "kichert",
	       "kichert");
      break;
    case "neutral":
      call_out("react", 0, "zaehlt weiter sein Geld", "zaehlt weiter sein Geld");
      break;
    case "intim":
      call_out("react", 0, "brummt: Kauf lieber etwas.",
                   "brummt zu "+TP->name(WEN)+": Kauf lieber etwas");
      break;
    case "froh":
      call_out("react", 0, "grinst",
             "grinst");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Einer meiner Liedertexte wird Dich sicher aufheitern",
             "meint zu "+TP->name(WEM)+": Einer meiner Liedertexte wird Dich sicher aufheitern");
      break;
    case "frech":
      call_out("react", 0, "grummelt: \%\&\/\$\%\/\8\8 !!!", "grummelt "+TP->name(WEN)+" an");
      break;
    case "nett":
      call_out("react", 0, "fragt Dich: Du willst nicht zufaellig auch Geld loswerden?", "fragt "+TP->name(WEN)+": Du willst nicht zufaellig auch Geld loswerden?" );
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


































