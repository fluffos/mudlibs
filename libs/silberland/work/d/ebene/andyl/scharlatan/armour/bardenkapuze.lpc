inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"kapuze", "bardenkapuze", "radenokapuze"}));
  SetProp (P_SHORT, "Eine Bardenkapuze");
  SetProp (P_LONG,
	   "Das ist ein Kapuze der Barden von Radeno. Sie ist grau und offensichtlich "
	   +"sehr schlampig geschneidert worden.\n");
  SetProp (P_NAME, "Bardenkapuze");
  SetProp (P_INFO, "Diese Kapuze ist vermutlich nicht einmal ein guter Schutz gegen Regen.");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 1);
  SetProp (P_MATERIAL, MAT_CLOTH);
}
