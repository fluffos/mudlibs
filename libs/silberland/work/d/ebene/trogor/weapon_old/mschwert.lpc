/* mschwert.c
**  Trogor
**  1996-06-12
*/

inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  
  SetProp(P_SHORT, "Ein blaues Schwert");
  SetProp(P_LONG, BS(
    "Du siehst eine der maechtigsten Waffen im Silberland. Die Klinge dieses "
    "langen zweihaendigen Schwertes ist von blauem Licht umegben. "
    "Beachte diese Waffe ist Macht - und Macht darf nicht missbraucht "
    "werden."));
  SetProp(P_NAME, "Blauschwert");
  SetProp(P_GENDER, NEUTER);
  AddId("schwert");
  AddId("blauschwert");
  AddAdjective( ({"blau", "blaues"}) );
  SetProp(P_VALUE, 5000);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_MAGIC}) );
  SetProp(P_MATERIAL, ([MAT_IRIDIUM:20, MAT_COBALT:10, MAT_STEEL:70,
                        MAT_MISC_MAGIC:50]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIXFACTOR, 0.5);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_INFO, BS(
    "Du siehst eine sehr maechtige Waffe, die aus seltenen magischen "
    "Materialien besteht. Ein magisches Schwert kann magischen "
    "Schaden anrichten und ist daher in der Lage, Geiterwesen zu "
    "verletzen."));	     
  AddDetail("zauberwaffe",
	    "Stark und maechtig leuchtet sie Dich an.\n");
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10, A_INT:10]) );
}

int HitFunc(object enemy)
{
  if( enemy->id("geist") || lower_case(enemy->QueryProp(P_RACE))=="geist" )
    return 50+random(200);
  else
    return 0;
}




