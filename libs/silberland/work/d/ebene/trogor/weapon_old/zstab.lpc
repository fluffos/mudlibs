/*
** Ein Zauberstab
** (w) 1996-05-06 Trogor
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("stab");
  AddId ("zauberstab");
  SetProp (P_SHORT, "Ein Zauberstab");
  SetProp (P_LONG, 
    "Der Zauberstab ist vergoldet und sein Schatten kann "
    "ueber Leben und Tod des Angreifers richten.");
  SetProp (P_NAME, "Zauberstab");
  SetProp (P_GENDER, MALE);
  SetProp (P_INFO,
    "Der Zauberstab liegt ausserordentlich gut in der Hand.\n");
  
  SetProp (P_VALUE, 1500);
  SetProp (P_WEIGHT, 4000);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, DT_BLUDGEON);
  SetProp (P_WC, 110);
  SetProp (P_WC_FIXFACTOR, 0.9);
  SetProp (P_QUALITY_DECAY, 300);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, 
    ([MAT_IRON:75, MAT_SILVER:5, MAT_GOLD:15, MAT_SHADOW:5]));
  AddDetail ("Schatten",
             "Du stehst unter ihm und eisige Kaelte bricht herein\n");

  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:14, SR_BAD:400]) );
}

