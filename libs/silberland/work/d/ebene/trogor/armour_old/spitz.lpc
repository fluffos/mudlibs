/*
** Spitzenhandschuh
** Trogor 06-06-1996
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"handschuhe", "spitzenhandschuhe", "handschuh"}));
  SetProp (P_SHORT, "Ein Paar Spitzenhandschuhe");
  SetProp (P_LONG, "Ein Paar Spitzenhandschuhe aus feinem Stoff und mit "
                  +"Edelsteinen besetzt, die nicht aus diesen Land sind."  );
  SetProp (P_NAME, "Paar Spitzenhandschuhe");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 850);

  SetProp (P_ARMOUR_TYPE, AT_GLOVE);
  SetProp (P_AC, 8);

  SetProp (P_MATERIAL, ([MAT_VELVET: 80, MAT_AQUAMARINE:20 ]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );

  AddDetail( ({"edelstein", "edelsteine", "aquamarine", "aquamarin"}),
    "Bei den Edelsteinen handelt es sich um Aquamarine. Sie funklen "
    "meerblau im Licht. Vielleicht kann man sie aus den Handschuhen "
    "herausloesen, aber dann waeren die Spitzenhandschuhe sicherlich "
    "ruiniert.");

  AddCmd( ({"loese", "loes"}), "loesen");
    
}

int loesen(string str)
{
  int i;
  notify_fail("Was willst Du woraus heraus loesen?\n");
  if( str == "aquamarin aus handschuh heraus" )
  {
    write(BS("Du loest einige Aquamarine aus den Handschuhen heraus, aber "
          "die Handschuhe zerfallen dabei zu Staub."));
    for(i=0;i<random(4)+2;i++)
      CLONE("/obj/gems/aquamarin", TP);
    remove();
    return 1;
  }
  return 0;
}
  
    
