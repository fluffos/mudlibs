
/*
** Brustpanzer
** (w) 1996-06-06 Trogor
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"panzer","brustpanzer"}));
  SetProp (P_SHORT, "Ein Brustpanzer");
  SetProp (P_LONG,
    "Der Brustpanzer ist aus Gold, Spitzen und Metall und kann \n"
    +"aufgrund seiner zierlichen Proportionen nur einer Frau gehoeren\n");
  SetProp (P_NAME, "Brustpanzer");
  SetProp(P_INFO, BS(
    "Der Brustpanzer scheint gegen Luftangriffe zu schuetzen."));
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1450);
  SetProp (P_VALUE, 1200);

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp (P_AC, 33);

  SetProp (P_MATERIAL, ([MAT_SILVER:10, MAT_GOLD:10, MAT_BRASS:70, 
                         MAT_SILK:10]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );  
}

