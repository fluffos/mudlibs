/* Trogor 10-06-1996 */

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Eine schoene Robe");
  SetProp(P_LONG, "Eine schoene Robe, die sehr robust wirkt.\n");
  SetProp(P_NAME, "Robe");
  SetProp(P_GENDER, FEMALE);
  AddId("robe");
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 450);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 6);
}
