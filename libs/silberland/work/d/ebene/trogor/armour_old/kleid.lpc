inherit "std/armour";

#include "../files.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId("kleid");
  AddId("feenkleid");
  SetProp(P_SHORT, "Ein Feenkleid");
  SetProp(P_LONG, BS(
          "Mit dem Feengewand gehoerst Du sicher zu den Schoensten im"
         +"ganzen Land. Ausserdem ist es ein guter Schutz gegen Feinde.\n"));
  SetProp(P_NAME, "Feenkleid");
  SetProp(P_INFO, BS(
    "Diese Kleid schuetzt Dich vor boesen Angreifern, aber nur, wenn Du "
    "selber gut bist.") );  
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2,T_HEAT_PROT:0]) );
}

int DefendFunc(string *dam_type, mixed spell, object enemy)
{
  int r;
  if( QueryProp(P_WORN)->QueryProp(P_ALIGN)<500 ) return 0;
  if(enemy->QueryProp(P_ALIGN)<-500 ) 
    r=10+random(30);
  if( member( dam_type, DT_UNHOLY)!=-1 )
    r+=10+random(10);
  return r;
}


