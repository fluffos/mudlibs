/*
** Schleier
** (w) Trogor
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("schleier");
  SetProp (P_SHORT, "Ein Schleier");
  SetProp (P_LONG,
    "Dieser schoene Schleier ist wohl nur fuer Frauen gedacht.\n");
  SetProp (P_NAME, "Schleier");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 150);

  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 3);

  SetProp (P_MATERIAL, MAT_SILK);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
}

