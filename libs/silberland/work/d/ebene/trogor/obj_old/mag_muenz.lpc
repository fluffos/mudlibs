inherit "std/thing" ;

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <language.h>
#include "files.h"

int clean, comp,crux;

create()
{
  if( !is_clone(this_object())) return;
  ::create();
  clean=0;
  comp=0;
  crux=0;
  SetProp(P_SHORT, "Ein alter Taler");
  SetProp(P_LONG, BS(
     "Du findest einen alten seltsamen Taler, der an einen Eck etwas "
    +"aufgebrochen ausschaut. Scheinbar muss hier schon mal jemand "
    +"versucht haben, den Taler zu halbieren. Ein wenig kannst Du "
    +"noch den Glanz des Goldes daran erkennen, doch fuer mehr ist "
    +"er zu verschmutzt.\n")); 
  SetProp(P_WEIGHT, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NAME, "Taler");
  SetProp(P_NAME_ADJ, "alt");
  SetProp(P_GENDER, MALE);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NOGET, 1);
  AddId( ({"taler", "alter taler"}) );

  AddCmd(({"oeffnen","oeffne"}), "open_sth");
  AddCmd(({"putze", "reinige","saeubere"}),"clean_sth");
  AddCmd("vergleiche", "comp");
  AddCmd(({"kratze", "ritze"}), "cross");
}

clean_sth(str) 
{
  notify_fail("Was willst Du reinigen?\n");
  if(str != "taler") return 0;
  if( present("muenz_npc", MENV) )
  {
    write("Die vielen Muenzen behindern Dich zuviel.\n");
    return 1;
  }
  write(BS(
    "Du beginnst den Taler zu putzen, und entdeckst ein altes Wappen "
   +"auf der Vorderseite, und kryptische Zeichen auf der Hinterseite "
   +"des Talers. Irgendwie erinnern sie Dich an die Zeichen am Brunnen. "
   +"Einen Versuch sie zu vergleichen, waere es auf jeden Fall wert.\n"));
  say(PL->name(WER,2)+ " saeubert einen alten Taler.\n");
  clean=1;
  return 1;
}

comp(str)
{
  notify_fail("Was willst Du vergleichen?\n");
  if(str != "zeichen" || !clean) return 0;
  if(str == "zeichen" && !clean)
    {
      write("Vielleicht solltest Du zuerst den Taler putzen?\n");
      say(TPN+ " liest, was man nicht lesen kann.\n");
      return 0;
    }
  if(str == "zeichen" && clean)
    {
      write(BS(
         "Du legst den Taler neben den Zeichen am Brunnen und versuchst, "
        +"Aehnlichkeiten zu finden. Dein Kopf beginnt zu rattern und vor "
        +"lauter Nervoesitaet faellt Dir der Taler auf den Boden. "
        +"Wie Du ihn aufheben willst, erkennst Du, dass der Taler nur "
        +"verkehrt dagelegen ist. Schnell machst Du Dich ans Werk und "
        +"beginnst, das Raetsel zu loesen. Leider ist die Schrift schon "
        +"alt, und der Taler etwas abegenutzt, doch bei Vergleich ergibt "
	+"sich folgendes: \n"));
      write(
         "\t*********************\n"
        +"\t Wissensdurstiger    \n"
        +"\t lass Dir gesagt     \n"
        +"\t sein: Nimm Dein     \n"
        +"\t Schwert, und kratze \n"
        +"\t in den Taler ein    \n"
        +"\t Kreuz. Dann soll    \n"
        +"\t er Bann gebrochen  \n"
        +"\t ein.               \n"
        +"\t*******************\n");
      say(TPN+ " loest sich in Gedanken auf und kehrt weiser zurueck.\n");
      comp=1;
      return 1;
    }
}
         


cross(str)
  {
    notify_fail("Was willst Du wo hineinritzen?\n");
    if(str=="kreuz in taler" && !comp)
      {
        write("Gut geraten aber falsch gespielt!\n");
        return 1;
      }
    if(str=="kreuz in taler" && comp)
      {
        write(BS(
          "Du beginnst ein Kreuz in den Taler hereinzuritzen und kannst "
         +"ein leises <Plopp> vernehmen. Erstaunt wendest Du Dich dem "
         +"Taler zu, und erkennst, dass sie in der Mitte einen kleinen "
         +"Spalt aufgegangen ist, und nun wohl geoeffnet werden kann.\n"));
	say(TPN+ " ist fuendig geworden.\n");
	crux=1;
	return 1;
      }
  }

open_sth(str)
{
    notify_fail("Was willst Du oeffnen?\n");
    if(str=="taler" && !crux)
      {
	write(BS(
            "Um diesen Taler zu oeffnen, gehen Dir noch ein paar "
           +"Informationen ab.\n"));
      }
    if(str=="taler" && crux)
      {
	write(BS(
	    "Du probierst mit aller Kraft, den Taler zu oeffnen. Das "
	   +"Gelenk knarrt und aechzt, und langsam oeffnet sich der "
           +"Taler. Du wirfst einen Blick hinein und erkennst einen langen, "
           +"dunklen Gang. Dies scheint der langersehnte, versteckte und von "
           +"vielen gesuchte Geheimgang zu sein. Erfreut und erstaunt stapfst "
           +"Du in Richtung Gang und verschwindest in der Dunkelheit.\n"));
	say(TPN+ "strengt sich an, und Plopp ist "+TPN+" weg.\n");
    call_out("reise1",2);
	return 1;
      }
  return 0;
}

reise1()
{
	write(BS(
	    "Schier endlos erscheint Dir der Gang, und langsam aber sicher "
           +"lassen Deine Kraefte nach. Erschoepft vom Fussmarsch, "
           +"beschliesst Du, Dich hier kurz niederzulassen, umd Dich zu "
           +"erholen. Durch die Dunkelheit, kannst Du nicht feststellen, "
           +"wielange Du wohl schon unterwegs bist, und wo Du bist. "
           +"Eigenartigerweise verfaellst Du nicht in Panik, und nach der "
           +"kurzen Rast brichst Du wieder auf.\n"));
  call_out("reise2",2);
}

reise2()
{
	write(BS(
	   "Bergauf, bergab, mal links, mal rechts ... Dazwischen meinst "
          +"Du sogar einmal Wasserrauschen vernehmen zu koennen. Dann hoerst "
          +"Du das Rauschen der Waelder, Pferdehufe schlagen, einen Hahn "
          +"kraehen und doch ist noch kein Ende des Ganges zu sehen.\n"));
  call_out("reise3",2);
}

reise3()
{
	write(BS(
	   "Du fragst Dich, wie es wohl Deinen Freunden gehen mag, und "
          +"ploetzlich wird Dir klar, dass all die Freunde und die "
          +"Landschaft wichtiger sind, als ewig in einen goldenen Sarg zu "
          +"schmorren. Da - genau wie Du diese Idee hast - kannst Du "
          +"ein Lichtlein erkennen, und Du weisst auch sofort wo Du sein "
          +"musst. Du beginnst zu laufen, uebersiehst in der Dunkelheit "
          +"einen Stein und stuerzt in den Raum.\n"));
	  this_player()->move(ROOM("grotte_n1"), M_GO, 
               "in die Grotte", "plumpst", "faellt herein");
}


reset()
{
  ::reset();
  crux=0;
  comp=0;
  clean=0;
}

