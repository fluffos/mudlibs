/* eine Speise   */
/* Trogor 1996-06-10 */

inherit "std/food";

#include <properties.h>
#include <food.h>
#include <language.h>
#include "files.h"


void create()
{
if (!is_clone(this_object())) return;
::create();

SetProp(P_SHORT, "Ein Haufen Heu");
SetProp(P_LONG, BS(
  "Ein Haufen Heu, direkt frisch vom Bauernhof. Aah wie das gut duften tut."
  " Mann, das ist ein Gedicht fuer jedes Pferd, und scheinbar staerkt es "
  "auch noch."));
SetProp(P_NAME, "Heuhaufen");
AddId(({"heu","heuhaufen"}));
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 50);
SetProp(P_GENDER, MALE);
SetProp(P_MATERIAL, ([MAT_STRAW:100]) );
SetProp(P_SMELL, "Aah wie das gut duftet.\n");
SetProp(P_FOOD_INFO, ([F_HEAL : ({25 ,15}), F_SOAK : 5]));
}

void BeimEssen()
{
write("Du verschlingst gierig das Heubueschel.\n");
say(this_player()->name()+" wuergt ein Bueschel Heu hinunter.\n");
}

