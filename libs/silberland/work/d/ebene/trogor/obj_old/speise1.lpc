/* eine Speise   */
/* Trogor 1996-06-10 */

inherit "std/food";

#include <properties.h>
#include <food.h>
#include <language.h>
#include "files.h"


void create()
{
if (!is_clone(this_object())) return;
::create();

SetProp(P_SHORT, "Ein Schleimbaellchen");
SetProp(P_LONG,
	"Ein Schleimbaellchen aus den Rachen eines Drachen, gefuellt mit\n"
	+"Marillenmarmelade nach Oma's Rezept. Dieses Baellchen gibt Dir\n"
	+"Kraft falls Du Dich daruebertraust es zu essen.\n");
SetProp(P_NAME, "Schleimbaellchen");
AddId(({"baellchen","schleimbaellchen"}));
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 50);
SetProp(P_MATERIAL, ([MAT_SLIME:50, MAT_FOOD:50]) );
SetProp(P_FOOD_INFO, ([F_HEAL : ({20 , 20}), F_SOAK : 5]));
}

void BeimEssen()
{
write("Du verschluckst Dich fast am Schleimbaellchen.\n");
say(this_player()->name()+" vergreift sich an einem Schleimbaellchen.\n");
}

