/* eine Speise   */
/* Trogor 1996-06-10 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "files.h"


void create()
{
if (!is_clone(this_object())) return;

::create();

SetProp(P_SHORT, "Ein goldener Schluessel");
SetProp(P_LONG, BS(
	"Ein Schluessel aus Gold. Ihn benoetigst Du zum Oeffnen des Tores.\n"
	+"Leider ist der Tod des Grotters damit verbunden.\n"
       ));
SetProp(P_NAME, "Schluessel");
SetProp(P_NAME_ADJ, "gold");
AddId(({"schluessel", "goldschluessel"}));
AddAdjective( ({"gold", "golden", "goldener", "goldenen"}) );
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 30);
SetProp(P_GENDER, MALE);
SetProp(P_MATERIAL, ([MAT_GOLD:100]) );

}
string QueryDoorKey()
{
  return (ROOM("grotte1"))+":"+ROOM(("hain_o1"));
}
