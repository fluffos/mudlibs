inherit "std/transport";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

    SetProp(P_NAME, "Floss");
    SetProp(P_GENDER, NEUTER);
    SetProp(P_INT_SHORT, "Im Moorfloss");
    SetProp(P_INT_LONG, BS(
      "Du stehst auf einem dunklen Moorfloss, welches Dich zur Grotte und "
      "zurueck bringen kann. Hoffentlich geht kein Moorsturm, denn sonst "
      "koenntest Du kentern."));
    AddId(  ({"floss", "moorfloss"})  );
    SetProp(P_SHORT, "Ein Moorfloss");
    SetProp(P_LONG, BS(
      "Dies ist ein Moorfloss, welches Dich direkt zum Feenhain bringt. "
      "Seit sich in dieser Gegend eine Erdspalte aufgetan hat und daraus "
      "eine riesige Moorgegend wurde, gibt es keine andere Moeglichkeit "
      "mehr, zum Hain zu gelangen. Vielleicht ist es moeglich aufs Floss "
      "zu kommen." ));
    // SetProp(P_LIGHT, 1);
    SetProp(P_TRANSPARENT, 1);
    SetProp(P_DEPARTMSG, ({
      "Das Floss beginnt sanft wegzutreiben.\n",
      "Das Floss stoesst ab und verschwindet.\n"}));

    SetProp(P_ARRIVEMSG, ({
      "Das Floss treibt auf @@QueryArrived@@ zu und bleibt stehen.\n"
      "Du kannst eine Stimme vernehmen, die Dich bittet, auszusteigen.\n",
      "Ein Moorfloss kommt an.\n" }));

    SetProp(P_ENTERMSG, ({
      "betritt das Moorfloss",
      "verschwindet auf dem Moorfloss"}));

    SetProp(P_LEAVEMSG, ({
      "verlaesst das Floss",
      "betritt wieder festen Boden"}));

    SetProp (P_MAX_PASSENGERS, 5);
    SetProp (P_LEAVEFAIL, "Das Floss liegt noch zu tief im Moor");
    SetProp (P_ENTERFAIL, "Leider koennen immer nur 5 Leute mit den Floss fahren");

    AddDetail( ({"sturm", "moorsturm"}),
	      "Wild rauscht der Sturm ueber die Landschaft.\n");
    AddDetail( ({"floss","moorfloss"}),
	      "Ein schoenes altes Floss.\n");
    AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen der Moorwellen.\n");
    AddSound("wellen", "Ruhig schlagen die Wellen gegen den Bug.\n");

    AddCmd(  ({"steig", "steige", "spring", "springe" }), "steige");
    AddCmd(  ({ "betrete", "betritt", "besteig", "besteige" }), "myEnter");
    AddCmd(  ({ "verlass", "verlasse" }), "myLeave");

    AddRoute ("/d/ebene/trogor/room/grotte_s4", 30, 5, "die Anlegestelle",
        ({"anlegestelle","silberwald","festland"}), "zur Anlegestelle");
    AddMsg("Das Floss beginnt, Richtung Grotte zu treiben.\n", 8);
    AddMsg("Das Floss wird langsamer.\n", 2);
    AddRoute("/d/ebene/trogor/room/grotte1", 30, 5, "die Grotte",
        ({"hain","feenhain","schloss","feenschloss","grotte"}),"zur Grotte");
    AddMsg("Das Floss beginnt, Richtung Anlegestelle zu treiben.\n", 8);
    AddMsg("Das Floss wird langsamer.\n", 2);

    Start();
  }


// P_LIGHT uebernehmen wir am besten von der Umgebung :-) - Denn wieso
// sollte es auf dem Floss hell sein, wenn es in ner dunklen Grotte ist?
//
int _query_light()
{
  return environment()->Query(P_LIGHT);
}


steige(str)
{
  string arg, arg2;
  if (environment() != environment(this_player()) &&
      environment(this_player()) != this_object()) return 0;
  notify_fail("Wo willst Du rauf oder runter?\n");
  if (!str) return 0;
  if ((sscanf(str, "%s %s", arg, arg2) != 2) && !id(str)) return 0;
  if (!id(str) && !id(explode(arg2, " ")[0])) return 0;
  if (id(str) || arg=="auf")
    return notify_fail("Aber das Floss ist doch gar nicht hier!\n"), Enter();
  if ( id(str) || arg=="von" || arg=="aus")
    return notify_fail("Aber das Floss ist doch gar nicht hier!\n"), Leave();
  return 0;
}

int myEnter(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Enter();
}

int myLeave(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Leave();
}

