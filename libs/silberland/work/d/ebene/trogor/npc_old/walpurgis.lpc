inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "files.h"
#include <npc.h>
#include <combat.h>
#include <new_skills.h>

create()
{
  ::create();
    
    SetProp(P_SHORT, "Die Wirtin Walpurgis");
    SetProp(P_LONG, BS("Du stehst vor einer Wirtsfrau namens Walpurgis."
    +" Scheinbar ist sie die Chefin der Taverne. Ihr Aeusseres aehnelt mehr"
    +" einem Mann als einer Frau. Trotzdem hat sie ein weiches Herz und ist"
    +" immer fuer ein kleines Plaeuderchen aufgelegt.\n"));
    create_default_npc(22);
    set_living_name("walpurgis");
    SetProp(P_HP, 600+random(50));
    SetProp(P_ALIGN, 200);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HANDS, ({"mit ihrer wilden Maehne", 260, DT_WHIP}));
    SetProp(P_GENDER, FEMALE);
    SetProp(P_NAME, "Walpurgis");
    SetProp(P_RACE, "Mensch");
    SetProp(P_ARTICLE, 0);
    AddInfo("trogor", "erklaert: Mein Chef ist immer in Zeitnot.\n");
    AddInfo("angrox", "ruft: Der sauft wie ein Loch und stinkt aus dem Maul.\n");
    AddInfo("taverne", "teilt Dir mit: Ich bin der gute Geist der Taverne.\n");
    AddInfo("fee", "jammert: Die sind sich zu schoen um hier zu essen.\n");
    AddInfo("diener", "schimpft: Die Penner leben ja nur auf Pump.\n");
    AddId("wirtin");
    AddId("walpurgis");
    CLONEME ("/d/gebirge/angrox/obj/steinkreis");
    AddInfo( ({"kreis", "steinkreis"}), 
    "Hmm, ein seltsames Objekt, das ein alter Zwerg einmal zum Zahlen hergab.",
    "meint: ");
    AddInfo("plaeuderchen",
    "meint: leider habe ich gerade keine Zeit, vielleicht spaeter.\n");
    AddInfo("reisende",
    "grinst: Die blechen sich dumm bei mir.\n");
    AddInfo(DEFAULT_INFO, "fluestert: Ich sag Dir die neuesten Geruechte.\n");
    AddInfo("geruechte", 
      "Die Fee versteckt ihren Liebhaber in einen geheimen Bettkasten.", 
      "fluestert Dir zu: ", "Walpurgis fluestert etwas.\n" );

    SetProp(P_SPELLRATE, 40);
    AddSpell(1,300,
      "Die Wirtin schlaegt Dir einen Kochtopf ins Gesicht.\n",
      "Die Wirtin schlaegt @WEM einen Kochtopf ins Gesicht.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
    
    AddSpell(2,150,
      "Die Wirtin kratzt Dich mit ihren langen Fingernaegeln.\n",
      "Die Wirtin kratzt @WEN mit ihren langen Fingernaegeln.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]) );

//    AddCmd("umarm", "uma_wir", 1);
//    AddCmd("kuess", "kus_wir", 1);
    
}

uma_wir(str)
{
    write(
     "Sofort wird sie sehr, sehr boese, nimmt Dich, legt Dich\n"
     "ueber die Knie und versohlt Dir Deinen Hintern.\n");
    say(TPN+ " macht sich an die Wirtin heran, und erlebt dabei eine\n"
     +"boese Ueberraschung.\n", ({TP}) );
    TP->do_damage(5,0);
    return 1;
}

kus_wir(str)
{
    write("Du hast Dir Deine Lippen verbrannt, vielleicht haettest Du Walpurgis\n"
     +"zuerst ihre Schleimsuppe schlucken lassen?\n");
    say(TPN+" verbrennt sich die Lippen an Walpurgis.\n",
      ({TP}) );
    TP->do_damage(15,0);
    return 1;
}

void StartReaction(string verb, string group, string adverb, int touch)
{
  if(verb=="umarm") call_out("uma_wir",0);
  else if(verb=="kuess") call_out("kus_wir",0);
  else if(group=="intim") call_out("intim",0);
}

void intim()
{
  write("Walpurgis gibt Dir einen schmerzhaften Tritt.\n");
  say("Walpurgis gibt "+TPN+" einen schmerzhaften Tritt.\n", ({TP}) );
  TP->do_damage(15,0);
}
 
