/*
** grotter
** trogor
** ---
** 1996-06-12  1.0  Release
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>


#include "files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("grotter");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Grotter");
  SetProp (P_SHORT, "Ein Grotter");
  SetProp (P_LONG, "Der Grotter ist ein scheues Nachtwesen, dass Licht und Sonne vermeidet.\n" 
         +"Seine Aufgabe ist es die Grotte vor unliebsamen Besuchern zu schuetzen.\n"
	 +"Willst Du zum Schloss so musst Du beim Grotter erst vorbeikommen.\n"  );
  SetProp (P_ALIGN, 100);
  create_default_npc (14);
  SetProp (P_RACE, "Grottenwesen");
  SetProp(P_SIZE, 90+random(20) );
  
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_HANDS, ({" mit Blitz und Donner", 110, ({DT_LIGHT, DT_SOUND}) }) );

  // set_living_name("grotter");
      

  SetProp(P_SPELLRATE, 10);

  AddSpell(1,150, 
    "Der Grotter zerbricht einen Stein auf Deinem Kopf.\n",
    "Der Grotter zerbricht einen Stein auf @WESSEN Kopf.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );


  SetAttackChats(6, ({
    "Der Grotter betet um Hilfe.\n",
    "Der Grotter zuernt und zornt.\n"}) );
  ob = CLONEOB("/d/ebene/trogor/obj/key");
  ob->move(ME);
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 500);
  ob->move(ME);
  SetProp (P_DIE_MSG, " verlaesst die irdische Welt.\n");
  SetProp (P_DEFAULT_INFO, "jammert: \"Warum muss ich das tun...\"\n");
  AddInfo ("grotte", "grinst: Bald wird es hier ne Quest geben.\n");
  AddInfo ("fee", "sagt: \"Die sind anders als alle Frauen!\"\n");
  AddInfo ("quest", "lacht: \Die ist noch nicht fertig\.\n");
  AddInfo ("schluessel", "sagt ernst: \"Den brauchst Du zum Oeffnen des Tores.\"\n");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Grotter nimmt was Du ihm gibst.\n" }) );
  AddDetail("licht",
	    "Er scheut das Licht.\n");
  AddDetail("sonne",
	    "Zum Glueck hat er die noch nie gesehen.\n");
  AddDetail("grotte",
	    "Du kannst ihn danach fragen.\n");
  

}

