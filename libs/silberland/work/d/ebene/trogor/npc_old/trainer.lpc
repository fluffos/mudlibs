/*
** Trainer, Trogor
** 1996-06-10
*/


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "files.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Trainingspartner");
  SetProp(P_LONG, 
    "Ein Trainingspartner schaut Dir in die Augen und lacht Dich an.\n"
    +"Du fuehlst Dich unsicher und weisst nicht ob es ratsam ist, ihn\n"
    +"anzugreifen. Er wirkt sehr gefaehrlich.\n"
    );
  SetProp(P_NAME,"Trainer");  
  AddId( ({"trainer", "trainingspartner", "partner"}) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen klobigen Haenden", 150, DT_BLUDGEON}));
  SetProp(P_ALIGN, 200);
  SetProp(P_SIZE, 200);
  SetProp(P_SPELLRATE,  30);
//  set_living_name("trainer");
  SetChats(10,({
    "Der Trainer warnt Dich vor einem Angriff.\n",
    "Der Trainer stupst Dich.\n",
    "Der Trainer hofft, Dich nicht ermorden zu muessen.\n"}));
  SetProp(P_DEFAULT_INFO, "ruft: Was willst Du Du Knilch?\n");
  AddInfo("trogor",
	  "sagt: Er ist mein weiser Schoepfer.\n");
  AddInfo("urkunde",
	  "sagt: Ja einige sind von mir.\n");
  AddInfo("diener",
	  "jammert: Wenn die nur einmal kapieren wuerden!\n");
  AddInfo("training",
	  "sagt: willst Du wirklich gegen mich kaempfen?\n");
  AddSpell(1,180,
	   "Der Trainer schlaegt Dir in den Magen.\n",
	   "Der Trainer schlaegt @WEM in den Magen.\n",
       DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_DIE_MSG, " laesst sich fallen und stirbt.\n");
  SetProp(P_AGGRESSIVE, 0.1);
}


