/*
** Fee, Trogor
** ---
** 1996-03-04  1.0  Release
*/

inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "files.h"
#include <new_skills.h>

int res=1;

create()
{
  object ob;
  res=1;
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("fee");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Fee");
  SetProp (P_SHORT, "Eine Fee");
  SetProp (P_LONG, "Die Fee versucht den ganzen Tag verzweifelt einen\n"
                   + "richtigen Mann zu finden. Vielleicht will sie nun\n"
                   + "genau dich?\n");
  SetProp (P_ALIGN, 1000);
  create_default_npc(20);
  SetProp (P_RACE, "Mensch");
  SetProp(P_SIZE, 150+random(20) );
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_HANDS, ({" mit zarten Feenhaenden",120, DT_BLUDGEON}) );
  SetProp (P_RESISTANCE, ({ DT_MAGIC }));
  SetProp (P_VULNERABILITY, ({DT_ACID }));
 
  set_living_name("fee");

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;  

  // Ausruestung
  CLONEME (ARMOUR("schleier"));
  command ("trage schleier");
  CLONEME (WEAPON("zstab"));
  command ("zuecke zauberstab");
  CLONEME (ARMOUR("brustp"));
  command ("trage panzer"); 
  CLONEME (ARMOUR("kleid"));
  command ("trage kleid");
  CLONEME (ARMOUR("spitz"));
  command ("trage handschuh");
  SetProp(P_SPELLRATE,60);

  AddDefaultSpell(1, 150, DS_FROG);
  AddSpell(9,300,
     "Die Fee wirft einen Feenzauber auf Dich.\n",
     "Die Fee wirft einen Feenzauber auf @WEN.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );

  SetChats(6, ({
    "Die Fee stammelt und staunt ueber Deine Frechheit.\n",
    "Die Fee haelt um Deine Hand an.\n",
    "Die Fee kuesst Dich.\n"}) );
  SetProp (P_DIE_MSG, " stirbt ohne Mann und einsam.\n");
  SetProp (P_DEFAULT_INFO, "jammert: \Will wer mein Mann werden?...\"\n");
  AddInfo ("fee", "lacht.\n");
  AddInfo ("heirat", "lacht und meint, dass sie noch zu jung dazu ist.\n");
  AddInfo ("trogor", "sagt er ist mein Meister, sein soll ich sein.\n");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Fee freut sich und bedankt sich artig.\n"}) ); 
  AddInfo("mann",
	  "meint: Nur ein Mensch wird mein Mann werden koennen, aber ich bin noch zu jung.\n");
  AddInfo("diener", "sudert: die rennen umher um nicht arbeiten zu muessen.\n");
  AddInfo("magier", "erklaert: ein weiser intelligenter und gefaehrlicher Mann.\n");
  AddInfo("pferd", "hofft bald damit reiten zu koennen.\n");
/*
  SetProp(P_MNPC_AREA, ROOM( ""));
  SetProp(P_MNPC_WAIT, ({30, 60, 120 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("schlaf1"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
*/  
  AddCmd("heirate", "hei_me");

}


reset()
{
  ::reset();
  if(!is_clone(TO)) return;
  res=1;
  move(ROOM("schlaf1"), M_TPORT );
}

hei_me(str)
{
  notify_fail("Wen willst du heiraten?\n");
  if (str=="fee" && res);
  {
  if(TP->QueryProp(P_GENDER)==FEMALE)
    {
      write("Du bist eine Frau und kannst mich daher nicht heiraten.\n"
      +"Aber als kleine Aufmerksamkeit verrate ich dir ein Geheimnis:\n"
      +"Im Schlosskerkerzimmer kannst du unter der Schlafstaette was\n"
      +"finden.\n");
      return 1;
    }
  if(TP->QueryProp(P_GENDER)==MALE)
    {
    if (TP->QueryProp(P_ALIGN)<300)
      {
	write("Du bist nicht lieb genug fuer mich! Werd braver dann nimm\n"
	+"ich Dich zum Mann.\n");
	say(TPN+ " wird von der Fee aufgrund der Gesinnung abgelehnt.\n",this_player());
	return 1;
      }
    if (TP->QueryProp(P_ALIGN)>300 && res)
      {
	write("Willkommen Du Mann meiner Traeume. Heirate mich und liebe\n"
	+"mich, aber wehe Dir du laesst mich stehen.\n");
	say(TPN+ " heiratet unter Glockenschlaegen die Fee.\n",this_player());
	TP->SetProp(P_HP, TP->QueryProp(P_HP)+30);
	TP->SetProp(P_SP, TP->QueryProp(P_SP)+30);
	TP->move("/d/ebene/Midas/room/kirche2", M_TPORT, " geht in die Kirche.\n");
        move("/d/ebene/Midas/room/kirche2", M_TPORT);
	write("Nun ist die Hochzeit vollendet.\n");
	res=0;
      return 1;

      }
    if (!res)
      write("Warte bis ich Dich will, und komm spaeter wieder.\n");
    return 1;
    }
    return 0;
  }
}









