/*
** Trainer, Trogor
** 1996-06-10
*/


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "files.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein koenigliches Pferd");
  SetProp(P_LONG, 
    "Dies ist ein besonderes Pferd. Es ist weiss und sehr schoen. "
    +"Du fuehlst Dich unsicher und weisst nicht ob es ratsam ist, noch "
    +"laenger hierzubleiben."
    );
  CLONEME(OBJ("speise2"));

  SetProp(P_NAME,"Pferd");  
  AddId("pferd");
  
  SetProp(P_GENDER, NEUTER);
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen scharfen Hufen", 150}));
  SetProp(P_ALIGN, 200);
  SetProp(P_SIZE, 200);
  SetProp(P_SPELLRATE,  30);
  SetProp(P_RACE, "Pferd");
  set_living_name("pferd");
  AddSpell(1,180,
	   "Das Pferd schleudert Dich mit voller Wucht gegen die Wand.\n",
	   "Das Pferd schleudert @WEN mit voller Wucht gegen die Wand.\n",
       DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  AddInfo("heu", "wiehert vergnuegt und freut sich schon drauf.\n");
  AddInfo("reiten", "wiehert: werde bald reiten lernen und Du?\n");
  AddInfo(DEFAULT_INFO, "wiehert und wiehert und wiehert.\n");
  
  SetProp(P_SMELL, "Das Pferd riecht gepflegt und nach Heu.\n");
  SetProp(P_DIE_MSG, " baeumt sich ein letztes Mal auf und stirbt.\n");

  AddCmd( ({"reit", "reite", "steige", "steig", "besteige", "besteig"}),
          "reiten");
}

int reiten(string str)
{
  notify_fail("Wen willst Du reiten?\n");
  if( !str ) return 0;
  if (strstr(str,"pferd")!=-1 )
  {
    write("Das Pferd laesst sich nur von der Fee reiten.\n");
    return 1;
  }
  return 0;
}

