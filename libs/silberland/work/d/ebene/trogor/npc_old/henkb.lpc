/* Ein Henker (henker.c)
** Trogor
** 1996-06-14
**
*/


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "files.h"
#include <moving.h>


create()
{
    object ob;
    ::create();
    CLONEME(OBJ("speise1"));
    ob=CLONEOB("/obj/money");
    ob->SetProp(P_AMOUNT, 500);
    ob->move(ME);
    SetProp(P_ALIGN, -200);
    SetProp(P_SHORT, "Ein boeser Henker");
    SetProp(P_LONG, BS(
     "Vor dir steht ein gefuerchteter Mann. Sein Gesicht ist mit haesslichen"
    +" Narben verziert, die ihn unerkenntlich machen. Vielleicht ist es glatt"
    +" die menschliche Huelle seines Erfinders. Sei so gut, und frag ihn nicht"
    +" nach seiner Lieblingsbeschaeftigung, es koennte schlecht fuer Dich"
    +" ausgehen.\n"));
    SetProp(P_NAME, "Henker");
    create_default_npc(14);
    set_living_name("henker");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Henker");
    SetProp(P_HP, 400);
    SetProp(P_SP, 400);
    SetProp(P_XP, 300000);
    SetProp(P_HANDS, ({ " mit seiner Donnerfaust",160, DT_BLUDGEON}));
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_MURDER_MSG, "Trogor hilf mir!\n");
    AddId("henker");
    AddDetail("gesicht",
    "Es ist voll mit Narben.\n");
    AddDetail("narben",
    "Scheinbar musste er schon oefter hart durchgreifen.\n");
    AddDetail("erfinder",
    "Trogor ist mein Erfinder");
    AddInfo( ({"beschaeftigung","lieblingsbeschaeftigung"}),
    "sagt: Morden ist meine Gaudi, und am liebsten toete\n"
    +"ich wehrlose Wesen. Willst du ein Stueck mit mir gehen?\n");
    AddInfo(DEFAULT_INFO, "knurrt: Schweig du Haut einer Wurst!\n");
    AddInfo("exekution",
    "sagt: Hoffentlich ist bald wieder einmal eine.\n");    
    AddInfo("vogel",
    "meint grinsend: die sind so dumm, die wehren sich nicht.\n");
    SetProp(P_SPELLRATE, 40);
    
    AddSpell(1, 180,
    "Der Henker wirft dir ein Seil um den Hals und zieht es Fest.\n",
    "Der Henker schlaegt Dir mit einer Langaxt den Kopf ab.\n");

    SetChats(10,  ({
    "Der Henker bereitet sich genuesslich auf die naechste Exekution vor.\n",
    "Der Henker erkundigt sich nach deinen Lebenswillen.\n",
    "Der Henker strafft das Seil und bittet Dich naeherzutreten.\n",
    "Der Henker grinst und toetet einen vorbeifliegenden Vogel.\n",
    "Der Henker sagt: komm geh mit mit mir!\n"}));
    AddCmd("gehe", "geh_mit");
    AddCmd("haenge", "han_wen");
}
    
geh_mit(str)
{
  object ob;
  notify_fail("Mit wem willst Du gehen?\n");
  ob=(present("schleimbaellchen"));
  if(str=="mit henker")
  if(objectp(ob))
  {
    write("Du beschliesst, den Henker ein Stueck zu begleiten. Der Henker\n"
    +"faengt an mit Dir ueber allerlei zu reden. Du freundest Dich an, und\n"
    +"genau in diesem Moment hoerst du einen Schrei - den Schrei des Henkers.\n"
    +"Er schreit Dich an, dass Dein Leben umsonst sei und beginnt Dich zu\n"
    +"attackieren, sein Blutrausch scheint kein Ende zu nehmen.\n");
    TP->do_damage(50,15);
    say(this_player()->name()+ " geht mit dem Henker fort, da ploetzlich wird \n"
    ""+TPN+" brutal zu Boden geschlagen.\n",this_player());
    Kill(TP);
    ob->move(this_player(), M_NOCHECK);
    return 1;
  }
  else
  {
    write("Du gehst mit, und schon ists passiert.\n");
    say(TPN+  " unterhaelt sich mit dem Henker und wird ueberfallen.\n");
    TP->do_damage(50,15);
    Kill(TP);
    return 1;
  }
  return 0;
}

han_wen(str)
{
  object plr;
  plr=present(P_NAME , environment(this_object()));
  notify_fail("Wen willst du haengen?\n");
  if(str==getuid(TP))
  {
    write(TPN+ " verlangt vom Henker, ihn aufzuhaengen. Der Henker schreitet.\n"
    +"sofort pflichtbewusst zur Tat und erhaengt "+TPN+" am Galgen.\n"
    +"Du hoerst  die Voeglein ein letztes mal zwitschern und wirst bewusstlos.\n"
    +"Als "+TPN+" wieder aufwacht, scheinen Stunden vergangen zu sein.\n");
    TP->do_damage(30,15);
    say(TPN+ " beschliesst, sich am Galgen aufhaengen zu lassen.\n", TP);
    return 1;
    } 
  if(str=="henker")
    {
    write("Der Henker schaut Dich fragend an - glaubst Du denn wirklich, dass er\n"
    +"sich selbst haengen wird. Er wird boese, flucht noch einmal und schlaegt \n"
    +"dann mit unglaublicher Kraft zu.\n");
    say(TPN+ " verlangt vom Henker sich selbst aufzuhaengen und wird attackiert.\n");
    Kill(TP);
    return 1;
    }
  if(plr)
    {
    write("Der Henker vollstreckt Deinen Befehl.\n");
    plr->do_damage(30,15);
    Kill(plr);
    return 1;
    }

  return 0;
}

