/*
** ghost, Trogor
** 1996-06-11
*/


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "files.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Schlossgeist");
  SetProp(P_LONG, BS(
    "Der Geist schaut Dich unglaeubig an. Noch nie wagte es jemand, ihm"
    +" in die Augen zu schauen. Er wirkt aufgebracht und boese - ein"
    +" schlechtes Omen. Hoffentlich sagst du nichts Falsches.\n"
    ));
  SetProp(P_NAME, "Schlossgeist");  
  AddId( ({"geist", "schlossgeist"}) );
  SetProp(P_GENDER, MALE);
  create_default_npc(16);
  SetProp(P_BODY, 300);
  SetProp(P_HANDS, ({" mit eisigen Fingern", 150, DT_COLD}));
  SetProp(P_ALIGN, -500);
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 200);
  set_living_name("schlossgeist");
  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_FIRE:-0.6, DT_COLD:-0.4, DT_HOLY:3, DT_UNHOLY:-1, DT_LIGHT:1.3,
      DT_TERROR:-0.9]));
  SetChats(10,({
    "Der Geist raet Dir umzukehren.\n",
    "Der Geist laesst die Temperatur steigen.\n"}));
  SetProp(P_DEFAULT_INFO, "ruft: Kehr um wenn Dir Dein Leben lieb ist!\n");
  AddInfo("trogor",
	  "sagt: Er ist mein weiser Schoepfer.\n");
  AddInfo("kerker",
	  "sagt: ich wuerd nicht reingehen.\n");
  AddInfo("augen",
	  "jammert: Wenn ich nur wieder sehen koennte\n");
  AddInfo("temperatur",
	  "jault vergnuegt: Schoen warm ist es hier.\n");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:85]) );

  SetProp(P_SPELLRATE,  30);
  AddSpell(1,280,
   "Der Geist will Dich einem Gott mit unaussprechbaren Namen (Ydoow) opfern.\n",
   "Der Geist will @WEN einem Gott mit unaussprechbaren Namen (Ydoow) opfern.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,250,
   "Der Geist trifft Dich mit der Kugel seiner Eisenkette.\n",
   "Der Geist trifft @WEN mit der Kugel seiner Eisenkette.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_DIE_MSG, " loesst sich in einer gespenstischen Wolke auf.\n");
  SetProp(P_NOCORPSE, 1);
  
}








