/*
** diener
** trogor
** ---
** 1996-06-10  1.0  Release
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>


#include "files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("diener");
  AddId ("oberdiener");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Oberdiener");
  SetProp (P_SHORT, "Ein Oberdiener");
  SetProp (P_LONG, BS(
     "Der Oberdiener ist der Herr ueber seine Kammerdiener. Grund seines Daseins ist der Ruf"
    +" nach einer harten Hand im Schloss. Bald wird er eine der wichtigsten Aufgaben im Lande"
    +" erhalten. Sein Aeusseres wirkt gepflegt und er ist der Liebling der Feen.\n"));
  SetProp (P_ALIGN, 500);
  create_default_npc (16);
  SetProp (P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20) );
  
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit eiskalten Gedanken", 130, DT_COLD}) );

  // set_living_name("oberdiener");

  // euid setzen, damit Ausruestung gecloned werden kann
   SUID;

  //Ausruestung
  CLONEME (ARMOUR("dgew"));
 command ("trage robe");

  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 100);
  ob->move(ME);

  SetProp(P_SPELLRATE, 30);

  AddSpell(1,150, 
    "Der Oberdiener drueckt Dir einen Besen in die Hand und sagt: PUTZ.\n",
    "Der Oberdiener teilt @WEM eine Aufgabe zu.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]) );
  
  SetProp (P_DIE_MSG, " jammert: Was soll die Fee ohne mich nur tun und stirbt.\n");
  SetProp (P_DEFAULT_INFO, "jammert: \"Was wuenschen Sie mein Herr...?\"\n");
  AddInfo ("diener", "sempert: Wenn die nur einmal ordentlich waeren.\n");
  AddInfo ("aufgabe", "erklaert stolz: Ich bin der, den Du fragen musst wenn du einen \n"
	  +"Mitspieler einmal umbringen willst. (playerkill)\n");
  AddInfo ("playerkill", "meint: Das geht noch nicht - Kampfwiese in Arbeit.\n");
  AddInfo ("kampfwiese", "sagt: Die ist in Arbeit.\n");
  AddInfo ("fee", " sagt: Die ist mein Vorgesetzter!\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Oberdiener nimmt was du ihm gibst und grinst Dich an.\n" }) );

}

