/*
** Ein Magier 
** Trogor/1996-06-12
*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "files.h"
#include <new_skills.h>
#include <exploration.h>

create()
{
  
   if (!is_clone(this_object())) return; 
  ::create();       

  SetProp(P_SHORT, "Ein Magier");
  SetProp(P_LONG, "Dieser Magier zaubert wie wild und schwingt dabei seinen langen Bart.\n"
	  +"Hoffentlich hast Du keine Boshaftigkeit vor, denn das mag er gar nicht.\n");
  SetProp(P_NAME, "Magier");
  SetProp(P_GENDER, MALE);
  AddId("magier");
  SetProp (P_RACE, "Mensch");
  SetProp(P_SIZE, 160+random(25) );

  create_default_npc(19);
  SetProp(P_ALIGN, -400); 
  SetProp(P_HANDS, ({" mit seinem langen wilden Bart", 85, DT_MAGIC}) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE, ({ DT_MAGIC }));
  SetProp(P_VULNERABILITY, ({ DT_COLD })); 
				       
//  set_living_name("maggi");

  seteuid(getuid(this_object()));

  if( random(100)>50 ) CLONEME("/d/ebene/lamuerte/wwald/obj/magiercap");
  if( random(100)>50 ) CLONEME("/d/ebene/lamuerte/wwald/obj/seidenjacke");
  if( random(100)>50 ) CLONEME("/d/ebene/lamuerte/wwald/obj/shose");
  if( random(100)>50 ) CLONEME("/d/ebene/lamuerte/wwald/obj/sschuhe");

  CLONEME (WEAPON("mschwert"));
  command("zuecke schwert");
  command("trage alles");

  SetProp(P_SPELLRATE,70);
  AddSpell(1,260, 
	   "Der Magier wirft einen riesigen Feuerball nach Dir.\n",
	   "Der Magier wirft einen Todesknall nach @WEM.\n",
           DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,380,
	   "Der Magier beschwoert einen Sturm ueber deinem Kopf hervor.\n",
	   "Der Magier beschwoert einen Sturm ueber @WESSEN Kopf hervor.\n",
           DT_AIR, ([SP_SHOW_DAMAGE:1]) );

  SetChats(5, ({
  "Der Magier laeuft im Kreis herum.\n",
  "Der Magier stolpert ueber seinen Bart.\n",
  "Der Magier sagt: Heh Du! Was machst Du da?\n",
  "Der Magier murmelt ein paar seltsame komisch klingende Worte in seinen Bart.\n",
  "Der Magier bricht in unkontrolliertes lautes Gelaechter aus.\n",
  "Der Magier sagt: Hast du das wirklich vor?\n",
  "Der Magier sagt erzuernt: Wenn ich dieses Kaninchen erwische ...\n",
  "Der Magier zaubert ein Kaninchen aus seinem Hut.\n",
  "Der Magier seufzt: Ich hab meinen Zauberstab verloren.\n",
  "Der Magier sagt: Hast Du vielleicht einen Zauberstab fuer mich?\n",
  "Der Magier sucht verzweifelt nach seinem Zauberstab.\n"
  }) );

  SetAttackChats(20, ({
  "Der Magier macht: Buh!\n",
  "Der Magier wirft mit weissen Maeusen nach Dir.\n",
  "Der Magier sagt: Das war ein grosser Fehler!\n",
  "Der Magier beisst Dich in den Arm.\n",
  "Der Magier zaubert blaue Flecken auf deine Nase.\n",
  "Der Magier verwandelt sich in eine Kroete.\n",
  "Der Magier verschwindet und taucht hinter Dir wieder auf.\n"
  }) );

  SetProp( P_DIE_MSG, " loest sich in Krach und Donner, Blitz und Laerm auf.\n" );  

  SetProp(P_DEFAULT_INFO,"sagt: Keine Ahnung, von was Du redest.\n");

  AddInfo("kaninchen",
  "sagt: Die hol ich immer aus meinem Hut.\n");
  AddInfo("zauberei",
  "sagt: Ich bin ein Meister der Zauberei.\n");
  AddInfo(({"maus", "maeuse"}),
  "sagt: Maeuse sind meine Lieblingstiere.\n");
  AddInfo("magie",
	  "sagt: Das ist mein Lieblingshobby.\n");
  AddInfo( ({"schwert", "blauschwert", "zauberschwert"}),
	  "erklaert: Auf dieses Zauberschwert bin ich besonders stolz.\n");
  AddInfo("hut",
	  "kichert: Den gibts doch gar nicht, ist eine Zauberei.\n");
  AddInfo("fee",
	  "fluestert: Die ist aber lieb.\n");
  AddInfo("sterne",
	  "meint: Die koennt ihr nie und nimmer sehen.\n");
  AddInfo("zauberstab",
          "fragt: Kannst Du mir bitte meinen Zauberstab wiederbringen?.\n");
  
  SetProp( P_REJECT, ({ REJECT_KEEP, "Der Magier sagt: Dankeschoen.\n" }) );

  RegisterGive( "stabbekommen", ({
     ({ "sage Oh, ich liebe Zauberstaebe!!!!", 5 }),
     ({ "emote fuchtelt wie wild mit seinem neuen Zauberstab herum.", 5 }),
     ({ "bohreinnase", 1 })
  }) );
  add_action("nasebohren", "bohreinnase");

}

stabbekommen( obj )
{
  if( obj->id("zauberstab") )
  {
    EPMASTER->GiveExplorationPoint("zauberstab", EP_MISC);
    return 1;
  }
  return 0;
}

nasebohren( str ) // str ist das, was hinter dem verb eingegeben wurde.
{
   say( "Der Magier bohrt mit dem Stab in seiner Nase.\n" );
   return 1; // Verb war erfolgreich.
}

catch_tell(str)
{
  sequencer::catch_tell(str);
  npc::catch_tell(str);
}

give_notify(ob)
{
  sequencer::give_notify(ob);
  npc::give_notify(ob);
}

