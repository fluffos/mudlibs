/*
** Fee, Trogor
** ---
** 1996-03-04  1.0  Release
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "files.h"
#include <new_skills.h>


create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("lieb");
  AddId ("liebhaber");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Liebhaber");
  SetProp (P_SHORT, "Ein Liebhaber");
  SetProp (P_LONG, "Du stehst einen Liebhaber gegenueber der splitternackt\n"
                   + "ist. Eigentlich waere es unfair einen nackten Mann\n"
                   + "anzugreifen\n");
  SetProp (P_ALIGN, 500);
  create_default_npc(14);
  SetProp (P_RACE, "Mensch");
  SetProp (P_SIZE, 185);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit flachen Handruecken",80, DT_BLUDGEON}) );
  SetProp (P_RESISTANCE, ({ DT_MAGIC }));
  SetProp (P_VULNERABILITY, ({DT_ACID }));
 
  set_living_name("liebhaber");

  // euid setzen, damit Ausruestung gecloned werden kann
  
  SetProp(P_SPELLRATE,60);
  AddSpell(1, 150, 
    "Der Liebhaber spuckt Dir ins Gesicht.\n",
    "Der Liebhaber spuckt @WEM ins Gesicht.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]) );

  SetChats(1, ({
    "Der Liebhaber traeumt von seiner Fee.\n",
    "Der Liebhaber sagt: Die Fee ist die Schoenste auf der Welt!\n"}));
  SetAttackChats(6, ({
    "Der Liebhaber bittet um Gnade.\n"}));
  SetProp (P_DIE_MSG, " stirbt jaemmerlich.\n");
  SetProp (P_DEFAULT_INFO, "jammert: \Will mir denn keiner helfen?...\"\n");
  AddInfo ("fee", "sagt: Sie ist die Schoenste auf der Welt.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Mann nimmt @WEN und bedankt sich.\n"}) ); 

  SetProp(P_MNPC_AREA, ROOM( "geheim"));
  SetProp(P_MNPC_WAIT, ({20, 40, 80 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("geheim1"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
       

}

