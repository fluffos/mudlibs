/*
** diener
** trogor
** ---
** 1996-06-10  1.0  Release
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("diener");
  AddId ("kammerdiener");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Diener");
  SetProp (P_SHORT, "Ein Kammerdiener");
  SetProp (P_LONG, "Der Kammerdiener ist stolz darauf, fuer die Frauen \n" 
         +"dieses Schlosses arbeiten zu duerfen.\n");
  SetProp (P_ALIGN, 100);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 165+random(15) );
  create_default_npc (15);
  
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit stahlharten Faeusten", 150, DT_BLUDGEON}) );

  // set_living_name("kammerdiener");

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  //Ausruestung
  CLONEME (ARMOUR("dgew"));
  command ("trage robe");
  CLONEME (OBJ("speise1"));
      
  SetProp(P_SPELLRATE, 50);
  AddSpell(1,120, 
    "Der Kammerdiener versucht Dich zu vertreiben.\n",
    "Der Kammerdiener versucht @WEN zu vertreiben .\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6, ({
    "Der Kammerdiener ruft: STIRB DU RAEUBER!.\n",
    "Der Kammerdiener hofft auf baldigen Frieden.\n"}) );

  SetProp (P_DIE_MSG, " bringt noch ein Glas Sherry und faellt tot um.\n");
  SetProp (P_DEFAULT_INFO, "jammert: \"Hoffentlich wollen Sie nicht baden...\"\n");
  AddInfo ("diener", "nickt.\n");
  AddInfo ("fee", "sagt: \"Die sind anders als alle Frauen!\"\n");
  AddInfo ("trogor", "sagt: \"Der ist mein Erfinder!\"\n");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Diener nimmt was Du ihm gibst und grinst Dich an.\n" }) );

  SetProp (P_MNPC_AREA, ROOM("schloss"));
  SetProp (P_MNPC_WAIT, ({ 30, 60, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("schloss"));
  SetProp (P_MNPC_FLAGS,   MOV_INDOORS + MOV_MOVES);

}

