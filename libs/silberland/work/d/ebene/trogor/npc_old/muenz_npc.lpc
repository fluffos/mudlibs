
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "files.h"

init()
{
  if( TP && TP->id("muenze")) AddDefender(TP);
}

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine goldene Muenze");
  SetProp(P_LONG, BS(
     "Die kleine Muenze ist Dir unbekannt. Scheinbar hatte man frueher "
    +"eine andere Waehrung im Silberland verwendet. Die Herstellung "
    +"duerfte frueher auch schwieriger gewesen sein, denn sie ist nicht "
    +"gerade rund, und fuehlst sich klobig an.\n"));
  SetProp(P_NAME, "Muenze");
  AddId("muenze");
  SetProp(P_KILL_NAME, "Geldgier");
  SetProp(P_GENDER, FEMALE);
  create_default_npc(10);
  SetProp(P_BODY, 100);
  SetProp(P_ALIGN, -50);
  SetProp(P_SIZE, 5);
  SetProp(P_HANDS, ({" mit dem Muenzwappen", 50, DT_UNHOLY}));
  SetProp(P_DEFAULT_INFO, "jammert: Ich arme kleine Muenze!\n");
  AddInfo("mammon",
	  "sagt: Der Gott des Reichtums.\n");
  AddInfo("ausgang", 
	  "raunzt: Ich weiss doch nicht mal wie die Sonne aussieht.\n");
  AddInfo("waehrung",
	  "grinst: Ich war die Waehrung vor Eurer Zeit.\n");
  AddInfo("trogor",
	  "jubelt: Mein Meister und Chef, der Herr der Muenzen.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG, " schmilzt und verrinnt in den Fugen des Bodens.\n");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

