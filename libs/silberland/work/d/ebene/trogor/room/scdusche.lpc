 * Trogor
 * dusche.c
 * 1996-06-11
 */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{

  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Der Duschraum der Fee");
  SetProp( P_INT_LONG, BS(
     "Dies ist der Duschraum der Feen.\n"
     "Viele Tuben und Dosen befinden sich im Raum. Auch eine Dusche steht"
     +" im Eck. Ueber dem Waschbecken kannst Du einen Spiegel erkennen."
     +" Die Badematte am Boden sieht nicht sehr frisch aus, wahrscheinlich"
     +" wurde hier vor kurzem gerade geduscht.\n"
    ));
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));

  AddDetail( ({ "pflege", "koerperpflege", "arbeit" }), 
                "Ein grosser Teil des Tages der Fee dient dieser Arbeit.");
  AddDetail( ({ "fee", "benuetzerin" }), 
                "Sie ist die Benuetzerin des Raumes." );
  AddDetail( ({ "matte", "badematte" }), 
                "Sie verziert den Boden." );
  AddDetail( ({ "becken", "waschbecken" }), 
                "Es dient der kleinen Koerperpflege der Feen." );
  AddDetail( ({ "eck" }), 
                "Vier an ihrer Zahl pro Zimmer." );
  AddDetail( ({"zahl", "vier"}),
    "Die Zahl der Ecken ist vier");
  AddDetail( ({ "sterblichen" }), 
                "Sie leben wie die Goetter" );
  AddDetail( ({ "dosen" }), 
                "Sie sind schwarz und riechen nach Fee.\n" );
  AddDetail( ({ "tuben" }), 
                "Sie sind leer und einsam "+
                "und es schaut so aus, als waeren sie irrsinnig alt." );
  AddDetail( ( "dusche" ), 
    "Die Dusche steht im Eck. Wenn Du schmutzig bist, koenntest Du Dich ja "
    "vielleicht hier duschen.");
  AddDetail( ({ "raum", "duschraum", "zimmer" }),
	     "Du befindest Dich mittendrin.\n" );
  AddDetail( "spiegel",
    "Der wunderschoene Spiegel besteht aus poliertem Silber und hat einen "
    "Rahmen aus Elfenbein. Vielleicht kann man hineinschauen.");
  AddDetail( ({"silber"}),
    "Das Silber des Spiegels wurde so lange poliert, dass man sich darin "
    "spiegeln kann.");
  AddDetail( ({"rahmen"}),
    "Der Rahmen des Spiegels besteht aus Elfenbein.");
  AddDetail( ({"elfenbein"}),
    "Fals Du einmal dringend Elfenbein brauchst, koenntest Du einen Teil "
    "des Rahmens herausbrechen.");
  AddDetail( ({ "boden", "fussboden" }),
	     "Der Fussboden ist nass.\n" );
  AddDetail( ({ "wand", "waende" }),
	     "An den Waenden befindet sich schoene Fliesen.\n" );
  AddDetail( ({ "fliesen" }),
	    "Scheinbar liebt die Fee Fliesen.\n" );
  AddDetail( ({"decke"}),
    "Sogar die Decke ist verfliesst.\n");
  AddCmd(({"schaue", "schau"}), "sch_etw");           
  AddCmd( ({"dusch", "dusche"}), "duschen");
  AddCmd( ({"brich", "brech", "breche"}), "brechen");
  AddExit("sueden", "zum Schlafzimmer#"+ROOM("schlaf1"));
}

sch_etw ( str )
{
  notify_fail("Was willst Du schauen?\n");
  if (str=="spiegel" || str=="in spiegel")
    {
      write("Du siehst in den Spiegel und findest Dich wunderschoen.\n");
      return 1;
    }
  return 0;
}

duschen(string str)
{
  write("Du stellst Dich unter die Dusche und wirst endlich wieder mal ganz "
        "sauber.\n");
  say(CAP_TPN+ " duscht sich.\n");
  return 1;
}

int brechen(string str)
{
  notify_fail("Was willst Du wo herausbrechen?\n");
  if(str=="elfenbein aus rahmen heraus" )
  {
    write("Aber Du brauchst ja gar kein Elfenbein!\n");
    return 1;
  }
  return 0;
}
  
