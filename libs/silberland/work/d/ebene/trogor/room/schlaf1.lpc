
/* Schlaf1.c   */
/* Trogor 1996-06-10  */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
    AddItem("/d/ebene/trogor/npc/feek", REFRESH_DESTRUCT);
    SetProp(P_INT_SHORT, "Ein Schlafzimmer");
    SetProp(P_INT_LONG, BS("Das ist das Schlafzimmer einer Fee."
	    +" Wer wohl schon alles in diesem Bett geschlafen haben"
            +" mag? Das Bett besteht aus einer weiten Seidendecke und "
	    +"drei grossen weichen weissen Polstern. Hier muss man gut"
	    +" schlafen koennen. Die Kleidung am Boden weist darauf hin,"
            +" dass hier sicher eine Frau wohnt.\n"));
    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 1);
    SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
 
    AddSmell(DEFAULT_SMELL, "Es riecht eindeutig nach Frau.\n");
    AddDetail( ({"schlafzimmer", "zimmer", "raum"}),
	   "Du stehst mitten drinnen.\n");
    AddDetail("decke",
	      "Sie sieht sehr kuschelig aus.\n");
    AddDetail("polster",
              "Weich, weiss und angenehm lachen sie Dich an.\n");
    AddDetail("bett",
	   "Die Decke ist aus kostbarer Seide. Am liebsten wuerdest Du "
	   +"Dich hineinlegen, doch der Anstand verbietet es Dir.");
    AddDetail( ({"anstand"}),
      "Du bist doch hoffentlich anstaendig?");
    AddDetail( ({"fee", "feen", "frau"}),
      "Das ist das Schlafzimmer der Fee.");
    AddDetail( ({"seide"}),
      "Sehr wertvolle Seide.");
    AddDetail("boden",
	   "Ein reichlich schoener Boden, wahrscheinlich aufgrund der zahlreichen Teppiche.\n");
    AddDetail(({"teppich", "teppiche"}),
	   "Die Teppiche haben eindeutig elfischen Ursprung.\n");
    AddDetail( ({"ursprung", "elfen"}),
      "Die Teppiche wurden sicher von Elfen geknuepft.");
    AddDetail(({"wand", "waende"}),
	   "Die Waende kann man fast nicht sehen, denn ueberall stehen Kaesten.\n");
    AddDetail(({"kasten", "kaesten"}),
	   "Es sind soviele, dass Du gar nicht zum zaehlen anfangen willst.\n");
    AddDetail("kleidung",
	   "Reichlich verziert und farbenpraechtig kleiden sich die Feen.\n");
    AddDetail(({"seidendecke", "geschmack"}),
	   "Die Feen scheinen einen ausgefallenen Geschmack zu haben.\n");
    AddExit("unten",ROOM("schloss_n1"));
    AddExit("norden", "zur Dusche#"+ROOM("scdusche"));
    AddExit("sueden", "in den Betraum#"+ROOM("kapelle"));
    AddSound(DEFAULT_SOUND, "Du hoerst das Bett knarren, doch niemand ist da.\n");
    AddSmell(DEFAULT_SMELL, "Du riechst ganz leicht den Duft der Feen.\n");
    NewDoor("osten", ROOM("geheim1"),
             ({"kasten", "bettkasten" }), ({
	     D_LONG, "Der Bettkasten verbirgt einen Raum nach Osten.\n",
	     D_GENDER, MALE,
	     D_SHORT, "Ein %ser Bettkasten.",
	     D_NAME, "Kasten",  }) );

}
