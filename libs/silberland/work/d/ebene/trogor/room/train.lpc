/* Trainingsraum      */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein grosser Trainingsraum");
  SetProp(P_INT_LONG, BS(
       "Du stehst mitten in einen Trainingsraum der Fuersten.\n"
    +  " An den Waenden haengen Urkunden der gewonnenen Turniere."
    +  " Am Boden kannst Du Begrenzungslinien fuer den Kampf sehen."
    +  " Sonst scheint hier nichts von Interesse zu sein. Wie oft mag"
    +  " man hier das Klirren der Waffen gehoert haben? Doch heute"
    +  " macht der Raum direkt einen verlassenen Eindruck. Scheinbar"
    +  " sind die Schlossbewohner friedlicher geworden.\n"
			   ));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
    
  AddDetail( ({ "fuerst", "fuersten", "rasse", "ritter" }), 
                break_string( "Eine leider ausgestorbene, interessante, "+
                "adelige Rasse.", 78 ) );
  AddSound(DEFAULT_SOUND, "Hier hoerte man frueher Waffen klirren.\n");
    
  AddDetail( ({"urkunde", "urkunden" }),
    "Sie beweisen welch gute Kaempfer hier geuebt haben.\n");
  AddDetail( ({"kaempfer"}),
    "Die Kaempfer, die hier geuebt haben, waren sehr erfolgreich. Das sieht "
    "man vor allem an den vielen Urkunden.");
  AddDetail( ({"fee", "feen", "diener"}),
    "Heute leben nur die Feen und ihre Diener im Schloss.");
  AddDetail( ({"schloss", "feenschloss"}),
    "Du befindest Dich im Feenschloss.");
  AddDetail("kampf",
    "Hart wurde hier fuer den Ernstfall geuebt.\n");
  AddDetail( ({"raum", "trainingsraum"}),
    "Er ist gross und viereckig mit Begrenzungslinien");
  AddDetail("boden",
    "Du siehst nichts darauf herumliegen.\n");
  AddDetail( ({"linie", "linien", "begrenzungslinien", "begrenzungslinie"}),
    "Die Linien grenzen den Trainingsplatz ab.");
  AddDetail( ({"platz", "trainingsplatz"}),
    "Auf dem Trainingsplatz kann man den Kampf mit den verschiedensten Waffen "
    "ueben.");
  AddDetail( ({"waffe", "waffen"}),
    "Hier kann man mit jeder Waffe ueben.");
  AddDetail( ({"schlossbewohner", "bewohner"}),
    "Wo sie wohl hingekommen sind, die Fuersten und Ritter? Es sind nur mehr "
    "die Feen und ihre Diener uebrig geblieben.");
  AddDetail(({"wand", "waende"}),
    "An den Waenden haengen viele Urkunden.\n");
  AddDetail( ({"turnier", "turniere"}),
    "Die Ritter haben in vielen Turnieren viele Urkunden gewonnen.");
  AddDetail( ({"decke"}),
    "Die Decke ist dunkel ausgemalt.");

  AddExit("westen",ROOM("schloss_s1"));

  AddItem("/d/ebene/trogor/npc/trainer", REFRESH_DESTRUCT);

  AddCmd( ({"trainier", "trainiere"}), "trainieren");

}

int trainieren(string str)
{
  object ob;
  notify_fail("Aber es ist ja gar kein Trainingspartner da!\n");
  if(ob=present("trainingspartner"))
  {
    write("Der Trainingspartner beginnt einen Uebgungskmapf mit Dir\n");
    ob->Kill(TP);
    return 1;
  }
  return 0;
}

