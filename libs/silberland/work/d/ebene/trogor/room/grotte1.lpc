
/* Feenhain Raum1 */
/* Trogor */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "files.h"
#include <room/doors.h>
#include <wizlevels.h>

create()
{
      ::create();
      
      SetProp(P_INT_SHORT, "Eine kleine Grotte");
      SetProp(P_INT_LONG, BS(
         "Du stehst in einer kleinen Grotte."
      +  " Es ist eisig kalt und da wagst es kaum weiterzugehen, denn"
      +  " die Grotte laest Dich erschauern. Wenn Du nach Osten blickst,"
      +  " siehst Du ein eisernes Tor, das den Blick auf den Hain versperrt"
      +  " und Du beginnst Dich zu fragen, was wohl dort sein mag.\n"
      
      ));
  SetProp(P_LIGHT, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:18]));
  SetProp(P_INDOORS,1);
      AddItem("/d/ebene/trogor/npc/grotter", REFRESH_DESTRUCT);
  AddDetail( ({"boden", "decke", "wand", "waende"}),
    "Alles besteht hier aus einem dunklen Gestein.");
  AddDetail( ({"gestein"}),
    "Ein sehr dunkels Gestein.");
  AddDetail("grotte",
		"Sie ist scheinbar schon in Vergessenheit geraten, denn "
		+"selten fand ein Irdischer diesen Weg.");
  AddDetail( ({"weg"}),
    "Der Weg in den Hain fuehrt durch das Tor.");
  AddSpecialDetail( ({"irdischer"}), "det_irdischer");
  AddDetail( ({"vergessenheit"}),
    "Diese Grotte ist in Vergessenheit geraten."); 
  AddDetail( ({"blick"}),
    "Das Tor versperrt den Blick auf den Hain.");
  AddDetail(  ({"hain", "gruen"}),
		  "Sein saftiges Gruen macht Dich neugierig. Wahrlich, ich "
		+ "meine, hier muessen zivilisierte Wesen hausen." );
  AddDetail( ({"wesen"}),
    "Welche Wesen das wohl sein werden?");
  AddDetail(  "wesen",
                  "Das wuesstest Du nur allzugerne wer dort wohnen mag.\n" );
  AddDetail("schloss",
                "Ein schoenen Schloss vielleicht kann man es oeffnen.\n");
  NewDoor("osten", ROOM("hain_o1"),
             ({"tor", "eisentor" }), ({
     D_LONG, "Das Eisentor ist alt, aber das Schloss sieht geoelt aus.\n",
     D_GENDER, NEUTER,
     D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED | DOOR_NEEDKEY,
     D_CMDS, "oeffne",
     D_SHORT, "Ein %ses Eisentor.",
     D_NAME, "Tor", }) );

  AddItem( OBJ("floss"), REFRESH_DESTRUCT, 1);
       
}

string det_irdischer()
{
  if( IS_WIZARD(TP) )
    return "Du bist ein Unsterblicher, kein Irdischer!\n";
  else
    return "Du bist ein Irdischer!\n";
}

