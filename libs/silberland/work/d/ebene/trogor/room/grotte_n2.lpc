inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "files.h"

int komm;
int erw;

create()
{
  ::create();
    SetProp(P_INT_SHORT, "Eine Schatzkammer");
    SetProp(P_INT_LONG, BS("Gold, Silber, Platin, Diamanten ... \n"
      +"Du schaust erstaunt um Dich, und - geblendet vom vielen Gold - stellst"
      +" Du fest, dass Du wohl in einer alten vergessenen Schatzkammer "
      +"gelandet sein musst. An den Waenden stapeln sich bis zur Decke hoch "
      +"lauter Schatzkisten, und in der Mitte des Raumes befindet sich ein "
      +"Brunnen der statt Wasser Silber heraussprudeln laesst. "
      +"Verwirrt vom vielen Gold, erkennst Du nicht die Gefahr, die hier auf "
      +"Dich lauert, denn Tueren sind keine zu sehen. Du drehst Dich einmal "
      +"um Deine eigene Achse, und stellst fest, dass Dich aus diesen Raum "
      +"keiner mehr rausbringen kann. Wie einst die Ritter der Artus-Runde "
      +"den Gral haben und bewachen wollten, wirst Du nun den Schatz in Deine "
      +"Obhut nehmen. Tja, was Gold alles ausmachen kann.\n"));
    SetProp(P_LIGHT, 1);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8, ENV_TERRAIN:TT_CAVE]));
    SetProp(P_INDOORS, 1);
    AddDetail("gold", BS(
      "Ueberall liegt Gold im Raum. Dir wird uebel, wenn Du daran denkst "
      +"wie man das wegtransportieren kann. Du bekommst ploetzlich "
      +"Kreuzweh.\n"));
    AddDetail("silber", BS(
      "Komisch, dass Silber hier gar nicht auffaellt.\n"));
    AddDetail("platin", BS(
      "Uii, soviel Platin. Welch wunderbare Waffen man damit wohl machen "
      +"koennte. Ein Jammer, dass nichts zum Schmieden da ist.\n"));
    AddDetail("waffen", BS(
      "Nirgendswo kannst Du welche erblicken, doch Dein geschultes Auge "
      +"bemerkt natuerlich sofort das viele Platin, welches optimal "
      +"dafuer geeignet waere.\n"));
    AddDetail(({"kammer", "schatzkammer"}), BS(
      "Du stehst mitten in einer vergessenen Schatzkammer und bist geblendet "
      +"von den vielen Edelmetall.\n"));
    AddDetail("waende", BS(
      "Du kannst die Waende kaum sehen, denn ueberall stapeln sich Kisten. "
      +"Dort wo man sie sieht, erkennst Du die rauhen Steine aus denen sie "
      +"gebaut ist.\n"));
    AddDetail("steine", BS(
      "Es schaut so aus, als waeren die Steine aus dem Berg herausgehauen "
      +"worden.\n"));
    AddDetail("decke", BS(
      "Die Decke wurde direkt aus dem Berg herausgehauen.\n"));
    AddDetail("berg", BS(
      "Die Kammer wurde direkt aus dem Berg herausgehaut.\n"));
    AddDetail(({"kisten", "schatzkisten"}), BS(
      "Die Schatzkisten sind so gross wie 3 Menschen. Leider hast Du keine "
      +"Moeglichkeit an sie heranzukommen, doch bei den anderen Reichtum "
      +"der sich hier befindet, willst Du gar nicht wissen, was sich "
      +"dahinter befindet.\n"));
    AddDetail("brunnen", BS(
      "Der Brunnen ist wohl das interessanteste Teil in diesem Raum. "
      +"Wie kann das sein, dass er Silber statt Wasser spuckt? Scheinbar "
      +"muss hier irgendwo einmal eine riesige Silbermine gewesen sein, "
      +"denn wie sollte man sich sonst die Mengen Silber vorstellen. Der "
      +"Brunnen ist geschmueckt mit seltsamen Zeichen. Vielleicht ist "
      +"dieser eine Moeglichkeit den Raum zu verlassen? Wie allles hier in "
      +"diesen Raum ist auch der Brunnen aus Platin und Gold gegossen.\n"));
    AddDetail("gefahr", BS(
      "Irgendwie macht dieser Raum einen gefaehrlichen Eindruck.\n"));
    AddDetail("tuer", BS(
      "Du kannst keine Tuer finden, auch wenn Du noch so oft schaust.\n"));
    AddDetail(({"ritter", "runde", "artus-runde"}), BS(
      "Tapfere Maenner, die auf der Suche nach dem heiligen Gral waren.\n"));
    AddDetail("gral", BS(
      "Der Gral wurde ewig lange gesucht, doch nie gefunden.\n"));
    AddDetail("boden", BS(
      "Du blickst auf den Boden, und bemerkst, dass ueberall Muenzen liegen. "
      +"Soviele Muenzen wirst Du wohl Dein Leben lang nicht verbrauchen "
      +"koennen! Dir schaut die Gier aus den Augen.\n"));
    AddDetail("gier", BS(
      "Gier kann toedlich sein.\n"));
    AddDetail("zeichen" , BS(
      "Die seltsamen Zeichen sind zu lange um sie auf einen Blick "
      +"entziffern zu koennen. Vielleicht kann man sie lesen.\n"));
    AddReadDetail("zeichen",
      "+/$§=&??(/=(&/%//&§&%$§)&?(/?//?&/)(%+\n"
     +"        A C H T U N G                 \n"
     +"    Du wirst mich nicht kennen, doch  \n"
     +"     auch ich bin meiner Gier nach    \n"
     +"    immer mehr Geld einmal erlegen.   \n"
     +"     Sei gewarnt, Ruhm zaehlt mehr    \n"
     +"      als alles Gold auf der Welt.    \n"
     +"     Der einzige Ausweg aus diesem    \n"
     +"     Luxus ist der Kampft mit den     \n"
     +"     Muenzen. Besiegst Du sie, so     \n"
     +"     sei geheilt von der Blendung     \n"
     +"     durch Reichtum. Doch pass auf    \n"
     +"     denn Mammon wacht ueber seine    \n"
     +"         Muenzen sehr genau !!!       \n"
     +"+!$§%/$%(%))(=&/?)=&)%&(§&/§/%&(&%%)/+\n");
     AddItem("/d/ebene/trogor/npc/muenz_npc.lpc", REFRESH_DESTRUCT);
     AddItem("/d/ebene/trogor/npc/muenz_npc.lpc", REFRESH_DESTRUCT);
     AddItem("/d/ebene/trogor/npc/muenz_npc.lpc", REFRESH_DESTRUCT);
     AddItem("/d/ebene/trogor/npc/muenz_npc.lpc", REFRESH_DESTRUCT);
     AddItem("/d/ebene/trogor/obj/mag_muenz.lpc", REFRESH_DESTRUCT);
}












