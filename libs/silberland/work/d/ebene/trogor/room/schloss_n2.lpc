/* Schloss_n1.c   */
/* Trogor   1996-06-10  */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"
create()
{
  ::create();
  AddItem("/d/ebene/trogor/npc/diener", REFRESH_DESTRUCT);

  SetProp (P_INT_SHORT, "Ein langer Gang");
  SetProp (P_INT_LONG,
     "Du stehst auf einen Gang, der nichts Besonderes zu beherbergen "
     +"scheint, ausser einer Kiste die sich ganz am Ende befindet. "
     +"Vielleicht taeuscht es nur, doch die Waende gehen am Ende sehr "
     +"spitz zusammen. Eine grosse Wendeltreppe fuehrt nach oben und "
      "unten.");
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  AddDetail( ({ "besonderes" }), 
                break_string( "Es gibt nichts, was Dein Interesse erwecken "+
                "koennte.", 78 ) );
  AddDetail( ({ "wand", "waende" }), 
                break_string( "Grau in grau.", 78 ) );
  AddDetail( ({"grau"}),
    "Ein sehr uninteressantes Grau.");
  AddDetail( ({ "ende" }), 
                break_string( "Hier ist der Gang wohl aus.", 78 ) );
  AddDetail( ({ "gang" }), 
                break_string( "Ein ganz normaler Gang.", 78 ) );
  AddDetail("kiste",
     "Sie scheint etwas Wertvolles zu verbergen, doch ist sie mit \n"
      +"Nichts auf der Welt zu oeffnen.\n");
  AddDetail( ({"nichts", "welt"}),
    "Die Kiste ist nur mit Nichts auf der Welt zu oeffnen.");
  AddDetail("wertvolles",
      "Man kann nichts genaueres erkennen.\n");
  AddDetail( ({"treppe", "wendeltreppe"}),
    "Die grosse Wendeltreppe fuehrt nach oben in den Turm und nach unten in "
    "den Keller.");
  AddDetail( ({"turm", "oben"}),
    "Zum Turm gehts nach oben.");
  AddDetail( ({"keller", "unten"}),
    "Zum Keller gehts nach unten.");
  AddDetail( ({"decke"}),
    "In der Decke ist ein Loch, durch das die Wendeltreppe nach oben fuehrt.");
  AddDetail( ({"boden"}),
    "Im Boden ist ein Loch, durch das die Wendeltreppe nach unten fuehrt.");
  AddDetail( ({"loch", "loecher"}),
    "Es gibt zwei Loecher, eines in der Decke und eines im Boden.");
   
  AddExit ("sueden", ROOM("schloss_n1"));
  AddExit ("unten", "die Treppe runter#"+ROOM("kerker"));
  AddExit ("oben", "die Treppe rauf#"+ROOM("turm1"));

  AddCmd( ({"oeffne"}), "oeffnen");
}

int oeffnen( string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if(str == "kiste") 
  {
    write("Die Kiste ist mit Nichts auf der Welt zu oeffnen.\n");
    return 1;
  }
  if(str == "kiste mit nichts auf welt" )
  {
    write("Du oeffnest die Kiste mit 'Nichts auf der Welt', aber sie ist "
          "leer.\nEnttaeuscht machst Du sie wieder zu.\n");
    say(CAP_TPN+" oeffnet die Kiste und schliesst sie wieder.\n");
    return 1;
  }
  return 0;
}

