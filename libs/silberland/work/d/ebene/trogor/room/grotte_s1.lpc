/* Zugang zur Grotte */
/* Trogor */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"


create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Weg");
  SetProp(P_INT_LONG, BS(
       "Du befindest Dich auf einen kleinen ausgetrampelten Pfad.\n"
      +"Wo der wohl hinfuehren mag? Nach Norden hin wird es immer"
      +" enger und Du siehst schon einen Berg, Richtung Suedwesten kommst"
      +" Du wieder zur Hauptstrasse.\n"));
  SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
    
  AddDetail("boden",
   "Er ist steinig und steil, vielleicht solltest Du nicht weitergehen.\n");
  AddDetail( ({"himmel"}),
    "Der Himmel ist weit ueber Dir.");
  AddDetail( ({"pfad", "weg"}),
    "Steil fuehrt er Richtung einer Grotte.\n");
  AddDetail("grotte",
    "Sie kannst Du von hier aus noch nicht sehen.\n");
  AddDetail("berg",
    "Was mag wohl dahinter versteckt sein?\n");
  AddDetail( ({"strasse", "hauptstrasse"}),
    "Sie ist im Suedwesten.");
  AddExit("norden",ROOM("grotte_s2"));
  AddExit("suedwesten","/d/ebene/Silberwald/room/room_i10");
}
