/*
** eine kerkerzelle (kerkerz.c)
** trogor
** 1996-06-13
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <room/doors.h>
#include "files.h"

int lade;

string d_inschrift();

create()
{
  ::create();
    
  lade=1;
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
  SetProp(P_INT_SHORT, "Eine Kerkerzelle");
  SetProp(P_INT_LONG, BS(
    "Du stehst inmitten einer kleinen Kerkerzelle. Es ist daemmrig, denn"
   +" durch das kleine Fenster kommt nur wenig Licht. Kein Wunder bei den"
   +" Spinnweben, die rund um das Eisengitter sind. Im ganzen Raum findest"
   +" Du nur einen Nachttopf, eine Zahnbuerste, einen Spiegel und eine"
   +" knarrige Schlafstaette. An den Waenden erkennst Du Zeichnungen"
   +" und Gedichte von ehemaligen Gefangenen.\n"));
  
  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({ "gefangener", "gefangenen" }), 
                break_string( "Viele scheinen es gewesen zu sein.", 78 ) );
  AddDetail( ({ "decke" }), 
                break_string( "Eine einfache Decke, den Gefangenen wird "+
                "nichts vergoennt.", 78 ) );
  AddSmell(DEFAULT_SMELL, "Hier stinkts fuerchterlich.\n");
  AddDetail( ({"zelle", "kerkerzelle"}),
	      "Du stehst darin.\n");
  AddDetail( ({"fenster", "kerkerfenster"}),
     "Klein, und viel zu hoch oben, um hinausschauen zu koennen.\n");
  AddDetail("licht",
     "Spaerlich scheint es durch das Kerkerfenster.\n");
  AddDetail("wunder",
     "Da musste ein Wunder passieren, um lebend herauszukommen.\n");
  AddDetail( ({"staette","schlafstaette","bett"}),
     "Die Schlafstaette sieht nicht einladend ein, aber *darunter* scheint "+
     "etwas zu sein. Vielleicht solltest Du dort einmal suchen was da ist.");
  AddSpecialDetail( ({"unter staette","unter schlafstaette","unter bett"}),
     "d_unterbett");
  AddDetail(({"gitter", "eisengitter"}), BS(
     "Die Gitter sind alt und rostig, und muessen einst schier unueberwindbare "
    +"Hindernisse gewesen sein.\n"));
  AddDetail( ({"eisen", "hindernisse", "hinderniss"}),
    "Altes, rostiges Eisen, aber trotzdem noch sehr stabil.");
  AddDetail(({"weben", "spinnweben"}), BS(
     "Schon beim Betreten des Raumes konntest Du fast nichts erkennen, denn "
    +"durch die Feuchtigkeit des Raumes angelockt, haben sich hier etliche "
    +"Spinnen ihr Zuhause gestrickt.\n")); 
  AddDetail( ({"feuchtigkeit"}),
    "Hier ist es wirklich sehr feucht.");
  AddDetail( ({"spinnen", "spinne"}),
    "Etliche Spinnen haben hier ihre Spinnweben. Scheinbar werden sie selten "
    "gestoert.");
  AddDetail( ({"zuhause"}),
    "Du waerst jetzt auch viel lieber Zuhause.");
  AddSpecialDetail("loch", "d_loch");
  AddDetail( ({"topf", "nachttopf"}),
     "Er ist oval, klein, rosa und mit roten Herzen darauf.\n");
  AddDetail( ({"herz", "herzen", "herze"}),
    "Auf dem Nachttopf sind kleine rosa Herzen drauf.");
  AddDetail( ({"buerste", "zahnbuerste"}),
     "Mit der wuerde ich mich nicht mehr putzen.\n");
  AddDetail( ({"wand","waende"}),
     "Sie sind grau und mit Zeichnungen und Gedichten verziert.\n");
  AddDetail( ({"zeichnung", "zeichnungen"}),
     "Die Zeichnungen sind leider nicht gut zu erkennen.\n");
  AddDetail(({"spiegel"}),
     "Der Spiegel ist alt und man kann sich darin kaum selber erkennen.\n");
  AddDetail( ({"gedicht", "gedichte"}),
     "Leider kann man nur mehr eines lesen.\n");
  AddSpecialDetail("stein", "d_stein");
  AddReadDetail("gedicht",
                   " O Du holde Maid\n"
                  +"wie bist Du nur gescheit\n"
		  +"Du schoene liebe fee\n"
		  +"fuer Dich ich strecken geh\n"
		  +"Du liebes schoenes wesen\n"
		  +"kannst leben ohne lesen.\n"
		  +"Dir waiser holdger frau\n"
		  +"gib als schmuck ich die feder vom pfau\n"
		  +"....\n"
		  +"weiter ist es leider nicht mehr lesbar.\n");
  AddDetail("inschrift", "Lies mal...\n");
  AddReadDetail("inschrift", #'d_inschrift);
  AddDetail( ({"boden"}),
    "Ein harter, ungemuetlicher Boden.");

  AddCmd("suche", "gugg");
  AddCmd("such", "gugg");
  AddCmd("durchsuche","gug");
  AddCmd("iss","beiss");
  AddExit("westen", ROOM("kerker"));
}

string d_stein()
{
  if (lade)
    return "Du erkennst ein kleines Loch im Stein, vielleicht solltest Du "+
           "ihn genauer durchsuchen.\n";
  else
    return "Sowas siehst Du hier nicht!\n";
}

string d_inschrift()
{
  if (lade)
    return
      "O Du intelligenter Sucher!\n"
     +"Dies sind die menschlichen Ueberreste von Angrox, denn jeder, der\n"
     +"Magier wird, muss seine sterbliche Huelle zuruecklassen, welche \n"
     +"dann versteinert wird. Wenn Du den Stein isst wird etwas passieren.\n";
  else
    return "Was fuer eine Inschrift?\n";
}

string d_unterbett()
{
  if (lade) {
    return "Du siehst einen kleinen Stein, der Dir seltsam vorkommt.\n";
    say(capitalize(this_player()->name())+
        " bueckt sich und wuehlt unter dem Bett umher.\n");
  } else
    return "Du suchst, findest aber nichts.\n";
}

string d_loch()
{
  if (lade)
    return
      "Du untersuchst den Stein sehr genau. Das Loch fasziniert Dich.\n"
     +"Du versuchst den Finger ins Loch zu stecken aber nichts passiert.\n"
     +"Enttaeuscht wendest Du Dich ab, aber dann passierts, Du findest eine\n"
     +"kleine Inschrift auf den Stein. Vielleicht kannst Du sie lesen.\n";
  else
    return "Du siehst hier kein Loch!\n";
}

gugg(str)
{
  notify_fail("Wo willst Du suchen?\n");
  if (str=="darunter" || str=="unter bett" ||
      str=="unter staette" || str=="unter schlafstaette")
  {
    write (d_unterbett());
    return 1;
  }
  return 0;
}

gug(str) 
{
  notify_fail("Was willst Du durchsuchen?\n");
  if(lade)
    if (str=="stein" || str=="loch");
    {
      write (d_loch());
      return 1;
    }
  return 0;
}

beiss(str)
{
  notify_fail("Was willst Du essen?\n");
  if (!str) return 0;
  notify_fail("Das kannst Du nicht essen!\n");
  if (str!="stein") return 0;
  if (lade)
  {
    write("Du schluckst den Stein - ein Strahl taucht auf - er umhuellt Dich "+
      "und floesst\nDir magische Kraefte ein. Du siehst gluecklich aus.\n");
    say(capitalize(this_player()->name())+ " wird von einer magischen Aura "+
      "umhuellt und laechelt.\n");
    // this_player()->SetProp(P_HP, this_player()->QueryProp(P_HP)+30);
    this_player()->heal_self(30);
    lade=0;
  }
  else
  {
    // ???
    // Wenn der Spieler den Stein vorhin geschluckt hat, kann ja jetzt
    // gar keiner mehr da sein???
    //
    write("Du schluckst den Stein gierig - aber nichts passiert. Du fuehlst "+
      "Dich auf\neinmal irrsinnig schwer.\n");
    say(this_player()->name()+ " versinkt vor lauter Gewicht fast im Boden.\n");
  }
  return 1;
}

reset()
{
  ::reset();
  lade=1;
}
