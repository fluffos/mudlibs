/* kerker.c     */
/* trogor 1996-06-11      */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"
#include <environment.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein alter Kerker");
  SetProp(P_INT_LONG, BS(
    "Du stehst inmitten eines mittelalterlichen Kerkers. Die Schmiedefeuer"
    +" brennen lichterloh, und die Fackeln an der Wand scheinen nie"
    +" auszugehen. Du siehst einige Kerkertueren, die aber nicht zu oeffnen"
    +" sind. Scheinbar wurden hier frueher viele Leute festgehalten. Ueberall"
    +" riecht es nach Angst, Schweiss und Blut, wie moegen hier die Leute"
    +" gelitten haben? Die seltsamen Geraete an den Waenden jagen Dir Angst"
    +" und Schrecken ein. In diesem Raum ist es furchtbar heiss.\n"));
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:35]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  AddDetail(({"boden", "steinboden"}),
    "Der Steinboden ist voller Blutflecken.");
  AddDetail( ({"blut", "blutfleck", "blutflecken", "fleck", "flecken"}),
    "Das Blut stammt wohl von den Gefolterten.");
  AddDetail( ({"gefolterte"}),
    "Du bedauerst die armen Gefolterten.");
  AddDetail( ({"decke"}),
    "Die Decke ist schwarz.");
  AddDetail( ({"angst", "schrecken"}),
    "Du hast wirklich etwas Angst.");
  AddDetail( ({"fackel", "fackeln"}),
    "Fackeln erhellen den Raum.");
  AddDetail( ({"wahrheit"}),
    "Viele Leute wurden hier gefoltert, bis sie die Wahrheit sagten.");
  AddDetail( ({"kerker", "raum"}),
	      "Du stehst mittendrinnen.\n");
  AddDetail( ({"feuer", "schmiedefeuer"}),
	      "Es brennt stark und lichterloh, Dir wird heiss.\n");
  AddDetail( ({"wand", "waende"}),
   "Sie ist grau in grau gehalten worden. Seltsame Geraete haegen dort.");
  AddDetail( ({"tueren", "kerkertueren", "tuer", "kerkertuer"}),
    "Die Kerkertueren sind verschlossen und koennen nicht geoeffnet werden.\n");
  AddDetail("leute",
	      "Viele sind scheinbar hiergewesen.\n");
  AddDetail("geraete",
	      "Alle moeglichen Geraete um die Wahrheit zu erfahren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Ueberall riecht es nach Angst, Schweiss und Blut.\n");
  AddSmell("angst", 
    "Es riecht tatsaechlich ein wenig nach Angst. Dir froestelt.\n");
  AddSmell("blut", 
    "Der bittere Geruch von Blut steigt in Deine Nase.\n");
  AddSmell( "schweiss", 
    "Es riecht hier ziemlich nach Schweiss. Das wird wohl an der hohen "
    "Temperatur liegen.");

  AddItem("/d/ebene/trogor/npc/ghost", REFRESH_DESTRUCT);
  AddExit("oben","die Treppe rauf#"+ROOM("schloss_n2"));
  AddExit("osten",ROOM("kerkerz"));
}
