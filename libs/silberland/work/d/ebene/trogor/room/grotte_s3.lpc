/* Zugang zur Grotte */
/* Trogor */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"


create()
{
  ::create();

    SetProp(P_INT_SHORT, "Ein kleiner Weg");
    SetProp(P_INT_LONG, BS(
       "Du befindest Dich auf einem kleinen ausgetrampelten Pfad.\n"
      +"Wo der wohl hinfuehren mag? Nach Norden hin wird es immer"
      +" enger und Du siehst schon einen Berg, Richtung Sueden kommst"
      +" Du wieder zur Hauptstrasse. Es wird immer steiler."
      +" Noch waere ein Umkehren moeglich.\n"));
    SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
    
    AddItem("/d/ebene/trogor/npc/pferd", REFRESH_DESTRUCT);
    AddDetail("boden",
	      "Er ist steinig und steil, vielleicht solltest Du nicht \n"
	      +"weitergehen.\n");
    AddDetail(({"pfad", "weg"}),
	      "Steil fuehrt er Richtung einer Grotte.\n");
    AddDetail("grotte",
	      "Sie kannst Du von hier aus noch nicht sehen.\n");
    AddDetail("berg",
	      "Was mag wohl dahinter versteckt sein?\n");
  AddDetail( ({"strasse", "hauptstrasse"}),
    "Nach Sueden gehts zur Hauptstrasse zurueck.");
  AddDetail( ({"himmel"}),
    "Der Himmel ist weit ueber Dir.");
    AddExit("norden",ROOM("grotte_s4"));
    AddExit("sueden",ROOM("grotte_s2"));
}
