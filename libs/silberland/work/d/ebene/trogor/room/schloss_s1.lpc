inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Ein langer Gang");
  SetProp(P_INT_LONG, 
    "Du befindest Dich in einen langen Gang. Aus dem Osten hoert man das "
    "Klirren von Waffen, das wird wohl der Trainingsraum des Schlosses sein. "
    "Aus dem Sueden hoert man gelegentliches Wiehern, also muessten dort die "
    "Stallungen liegen. Im Norden befindet sich die Vorhalle des Schlosses.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));    
    
  AddDetail( ({ "gang" }),
    "Der Gang fuehrt nach Norden."); 
  AddDetail( ({"staelle", "stall", "pferdestall", "stallungen", "sueden"}),
    "Die Staelle sind im Sueden.");
  AddDetail( ({"raum", "trainingsraum", "osten"}),
    "Der Trainingsraum ist im Osten.");
  AddDetail( ({"norden", "halle", "vorhalle"}),
    "Im Norden ist die Vorhalle der Schlosses.");
  AddDetail( ({"schloss", "feenschloss"}),
    "Du bist im Feenschloss.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind grau.");
  AddDetail( ({"decke"}),
    "Die Decke ist uninteressant.");
  AddDetail( ({"boden"}),
    "Der Boden ist unter Dir.");
  AddDetail( ({"pferd", "pferde"}),
    "Die Pferde sind wohl in ihrem Stall im Sueden.");  

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Klirren von Waffen aus Osten und das Wiehern von Pferden "
    "aus dem Sueden.");
  AddSound( ({"waffen", "klirren"}),
    "Das Klirren der Waffen kommt aus dem Trainingsraum im Osten.");
  AddSound( ({"wiehern", "pferde"}),
    "Das Wiehern der Pferde kommt aus den Staellen im Sueden.");

  AddExit("norden", ROOM("schloss"));
  AddExit("sueden", ROOM("stall"));
  AddExit("osten", ROOM("train"));
}

