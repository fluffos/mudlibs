inherit "std/room";
#include <properties.h>
#include <defines.h>
#include <moredef.h>

string tafel();

create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG,
      "Du befindest Dich hier im Betraum der Feen, die hier ihre "
      +"natuerliche Gestalt durch beten wiedererlangen koennen. "
      +"Ein kleiner Altar aus Blumen befindet sich in der Mitte "
      +"des Raumes. An der noerdlichen Wand haengt neben dem Ausgang "
      +"eine Heldinentafel. Im Westen faellt durch ein buntes Fenster "
      +"Licht in den Raum.");
  SetProp (P_INT_SHORT,"Betraum");

  AddDetail (({"raum", "betraum"}), 
      "Du stehst mittendrin.");
  AddDetail("waende",
      "An der noerdlichen Wand ist ein Ausgang, daneben haengt eine "
      +"Tafel. An der westlichen Wand faellt durch ein Fenster Licht in "
      +"den Raum.");
  AddDetail("boden", 
      "Der Boden besteht aus Marmor.");
  AddDetail("marmor", 
      "Der Marmor glaenzt im Licht, der durch das Fenster faellt. "
      +"Ein Blumenaltar steht in der Mitte des Raumes am Boden.");
  AddDetail("decke",
      "Die Decke besteht aus Marmor.");
  AddDetail("fenster", 
      "Durch die bunten Fenster faellt Licht in den Raum.");
  AddDetail("licht", 
      "Das Licht taucht den Raum in ein angenehmes Licht.");
  AddDetail(({"altar", "blumenaltar"}),
      "Vor dem Altar, der vollkommen aus Blumen besteht, kann man "
      +"beten und seine fleischliche Gestalt wiedererlangen.");
  AddDetail("blumen",
      "Unzaehlige verschiedene Blumen bilden den Altar. Die Pracht "
      +"der Blueten blendet Deine Sinn."); 
  AddDetail("tafel",
      "Du kannst sie lesen.");
  AddReadDetail( ({"heldentafel", "tafel"}), #'tafel);
  
  AddCmd ("bete","bete");
//  AddExit ("norden","./schlaf1");
  AddExit("osten","/d/ebene/ronja/feenquest/room/sgang15");
}

bete() {
  write ("Du kniest nieder und haeltst eine kurze Andacht.\n");
  if (this_player()->QueryProp(P_GHOST))
  {
    say ("Der Geist von "+this_player()->name()+
        " kniet nieder und haelt eine kurze Andacht.\n");
    write ("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "+
      "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "+
      "durchstroemt.\n");
    say (this_player()->name()+" erscheint ploetzlich wieder in "+
      "koerperlicher Form.\n");
    this_player()->SetProp(P_GHOST,0);
  }
  else
    say (this_player()->name()+" kniet nieder und haelt eine kurze Andacht.\n");
  return 1;
}

string tafel()
{
  TP->more("/etc/topfeen.read",1);
  return "";
}

