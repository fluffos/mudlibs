/*  Geheim2.c     */
/* Trogor         1996-06-11  */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"


create()
{
  ::create();

    SetProp(P_INT_SHORT, "Ein kleiner Geheimgang");
    SetProp(P_INT_LONG, BS(
    "Du stehst mitten in einen kleinen Geheimgang. Er ist sehr niedrig "
    +"und Du streifst fast die Decke. Dies duerfe der Aufenthaltsraum"
    +" des Liebhabers sein, denn Du findest am Boden verstreute kleine"
    +" Papierstuecke. Scheinbar gehoeren sie zu einer Speise.\n"));
    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 1);
    SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));

    AddDetail( ({"gang", "geheimgang"}),
	      "Er wird nur selten benuetzt.\n");
    AddDetail("decke",
	      "Sie ist sehr niedrig, obwohl der Liebhaber Mensch ist.\n");
    AddDetail( ({"mensch"}),
      "Fuer einen Mensch ist die Decke viel zu niedrig.");
    AddDetail( ({"liebhaber"}),
      "Er ist gerade nicht da.");
    AddDetail( ({"raum", "aufenthaltsraum"}),
	      "Das ist der Aufenthaltsraum eines Liebhabers.\n");
    AddDetail("boden",
	      "Er ist sehr ebenmaessig und schoen.\n");
    AddDetail( ({"wand", "waende"}),
      "Die Waende sind grau.");
    AddDetail( ({"stuecke", "papierstuecke", "papier"}),
      "Die Papierstuecke sind so klein, dass man nichts mehr feststellen "
      "kann.");
    AddDetail("speise",
      "Du hast Pech, gerade liegt keine da.\n");
    AddDetail( ({"pech", "glueck"}),
      "Man hat entweder Glueck oder Pech.");
    AddItem("/d/ebene/trogor/obj/speise1", REFRESH_REMOVE);
    AddExit("westen", ROOM("geheim1"));
}
