/* Hain */
/* Trogor 10-06-1996 */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>

#include "files.h"
create()
{
  ::create();
    
    SetProp ( P_INT_SHORT, "Ein lieblicher Feenhain" );
    SetProp ( P_INT_LONG, BS( 
	     "Du stehst mitten in einen kleinen Hain. Wenn Du nach Westen"
	     +" blickst, siehst Du noch das Eisentor. Nach Osten hin"
	     +" erstreckt sich ein Hain mit vielen Brunnen und Gaerten."
	     +" Niemals in Deinen Leben hast Du Dich so wohl gefuehlt!"
	     +" Hinter einem Wipfel der hohen Baeume kannst Du einen Turm"
	     +" erkennen. Was mag dort wohl sein, fragst Du Dich.\n"));
    SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
    AddSound(({DEFAULT_SOUND, "plaetschern"}),
      "Du hoerst das liebliche Plaetschern des Brunnens.\n");
    AddSound("rauschen", 
      "Du hoerst das Wasser im Brunnen rauschen.\n");
    AddSound("musik", 
      "Sie klingt lieblich und kommt von weit her.\n");
    AddDetail("boden",
	      "Er ist eben und gleichmaessig gebaut.\n");
    AddDetail("hain",
	      "Du stehst mitten drinnen.\n");
    AddDetail("brunnen",
	      "Schoen sind sie allesamt und ihr Rauschen ist wie Musik.\n");
    AddDetail("turm",
	      "Der Turm gehoert wohl zu einen Schloss.\n");
    AddDetail("schloss",
	      "Du kannst es von hier aus nicht sehen.\n");
    AddDetail(({"gaerten","garten"}),
	      "Alles scheint tiptop erhalten zu sein.\n");
    AddDetail(({"grotte", "blick"}),
	      "Du schaust noch ein letzes Mal zum Tor und denkst: 'Dies Tor ist der Weg zurueck!'.\n");
    AddDetail("baeume",
	      "Sie versperren Dir die Sicht auf das Schloss.\n");
  AddDetail( ({"sicht"}),
    "Die Sicht aufs Schloss wird von den Baeumen versperrt. Vielleicht "
    "solltest Du naeher rangehen.");
    AddDetail("wipfel",
	      "Wenn Du bei den Baeumen nach oben blickst kannst Du ihre Wipfel sehen.\n");
  AddDetail( ({"himmel"}),
    "Der Himmel ist weit ueber Dir.");
  AddDetail( ({"weg"}),
    "Der Weg fuehrt nach Westen zu einem Eisentor und nach Osten durch den "
    "Hain.");
    NewDoor("westen", ROOM("grotte1"),
             ({"tor", "eisentor" }), ({
	     D_LONG, "Das Eisentor oeffnet den Blick auf eine Grotte.\n",
	     D_GENDER, NEUTER,
	     D_SHORT, "Ein %ses Eisentor.",
	     D_NAME, "Tor", }) );

    AddExit("osten", ROOM("hain_o2"));
}
