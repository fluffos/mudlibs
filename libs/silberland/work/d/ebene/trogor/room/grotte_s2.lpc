/* Zugang zur Grotte */
/* Trogor */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"


create()
{
  ::create();

    SetProp(P_INT_SHORT, "Ein kleiner Weg");
    SetProp(P_INT_LONG, BS(
       "Du befindest Dich auf einen kleinen ausgetrampelten Pfad.\n"
      +"Wo der wohl hinfuehren mag? Nach Norden hin wird es immer"
      +" enger und Du siehst schon einen Berg, Richtung Sueden kommst"
      +" Du wieder zur Hauptstrasse. Am Rand steht ein Schild.\n"));
    SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
    
  AddDetail( ({ "strasse", "hauptstrasse" }), 
                break_string( "Die Strasse fuehrt nach Midas.", 78 ) );
  AddDetail( ({"midas", "stadt"}),
    "Kennst Du etwa die grosse Stadt Midas nicht?");
    AddDetail("boden",
	      "Er ist steinig und steil, vielleicht solltest Du nicht "
	      +"weitergehen.\n");
    AddDetail( ({"pfad", "weg"}),
	      "Steil fuehrt er Richtung einer Grotte.\n");
    AddDetail("grotte",
	      "Sie kannst Du von hier aus noch nicht sehen.\n");
    AddDetail("berg",
	      "Was mag wohl dahinter versteckt sein?\n");
    AddDetail("schild",
	      "Vielleicht kannst Du etwas lesen?\n");
  AddDetail( ({"rand", "wegrand"}),
    "Am Wegrand seht ein kleines Schild.");
  AddDetail( ({"himmel"}),
    "Der Himmel ist weit ueber Dir.");
    AddReadDetail ("schild",
		   "----------------------------------------------\n"
		  +"|         HALLO EDLER REISENDER              |\n"
		  +"|          Dies ist das Gebiet               |\n"
		  +"|         von Trogor dem Magier              |\n"
		  +"|                                            |\n"
		  +"|              VIEL SPASS                    |\n"
		  +"|                                            |\n"
          +"|    PS: von Feyaria etwas ueberarbeitet     |\n"
		  +"----------------------------------------------\n"
		   );
    AddExit("norden",ROOM("grotte_s3"));
    AddExit("sueden",ROOM("grotte_s1"));
}
