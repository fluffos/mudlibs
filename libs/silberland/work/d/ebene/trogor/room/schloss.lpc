/* schloss.c */
/* Trogor */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>
#include <player.h>
int kaste = 1;

create()
{
  ::create();
    kaste = 1;
    SetProp(P_INT_SHORT, "Die Schlossvorhalle");
    SetProp(P_INT_LONG, BS(
	    "Du stehst in der Vorhalle des Schlosses, vielleicht solltest Du"
	    +" umdrehen? Im Eck steht eine alte Uhr, ihr gegenueber befindet"
	    +" sich ein Waffenschrank. Diebstahl ist nicht erlaubt!!!"
	    +" Du kannst zwei Gaenge sehen, einer fuehrt nach Norden, und der"
	    +" andere nach Sueden. Aus beiden Richtungen kannst Du Stimmen"
	    +" hoeren. Hoffentlich hat das Nichts zu bedeuten!"
	    +" Alles in allem macht der Vorraum den Eindruck, oefter fuer"
	    +" festliche Angelegenheiten verwendet zu werden. Warum laden"
	    +" sie Dich nie dazu ein? Im Osten ist der Eingang zur Schlosstaverne."
	    ));
    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 1);
    SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
    AddItem("/d/ebene/trogor/npc/fee", REFRESH_DESTRUCT);

    AddDetail( ({"eingang", "osten", "taverne", "schlosstaverne"}),
      "Im Osten ist der Eingang zur Schlosstaverne.");
    AddDetail( ({"eck"}),
      "Im Eck steht eine alte Uhr.");
    AddDetail( "uhr",
	      "Sie ist alt und weist schon viele Flecken auf. "
	      +"Wahrscheinlich wird sie bald ausgetauscht werden.");
    AddDetail( ({"schrank","waffenschrank"}),
	      "Er sieht massiv aus und Du kannst hinter dem Glas kostbare, "
	      +"seltene und schoen geschmueckte Waffen erkennen. "
	      +"Vielleicht kann man ihn oeffnen.");
    AddDetail( ({"glas"}),
      "Hinter dem Glas kannst Du seltene und schoen geschmueckte Waffen "
      "erkennen.");
    AddDetail( ({"schloss", "vorraum", "vorhalle", "raum", "halle"}),
      "Du befindest Dich in der Vorhalle des Schlosses.");
    AddDetail(({"gang", "gaenge"}),
	      "Was mag sich wohl dahinter verstecken?\n");
    AddDetail( ({"angelegenheit", "fest", "eindruck", "feste" }),
	      "Rauschende Feste werden hier gefeiert, aber nur die Feen "
	      +"haben Zugang.");
    AddDetail("waffen",
	      "Sie sind sehr kostbar und selten, in Silberland wurden sie "
	      +"noch nie gesehen.");
    AddDetail( ({"silberland"}),
      "Du bist gerade im SilberLand.");
    AddDetail( ({"fee", "feen"}),
      "Den Feen gehoert dieses Schloss.");
    AddDetail("boden",
	      "Einfach ein steinerner alter ausgetretener Boden.\n");
    AddDetail(({"wand", "waende"}),
	      "Die Wand ist tapeziert und erscheint schon ein wenig modrig.\n");
    AddDetail("flecken",
	      "Die Flecken scheinen schon aelteren Datums zu sein.\n");
    AddDetail( ({"datum"}),
      "Sicher vor Deiner Geburt.");
    AddDetail(({"decke", "eichendecke"}),
	      "Ehrfuerchtig schaust Du nach oben, und erblickst eine alte Eichendecke.\n");
    AddSound(({"stimmen", "maennerstimmen"}),
      "Du hoerst aus beiden Richtungen Maennerstimmen.\n");
    AddSound("weise", "Ein schoenes altes leierndes Lied.\n");
    AddSound(DEFAULT_SOUND, "Du hoerst eine Frau eine alte Weise singen.\n");
    AddCmd( "oeffne", "bwg_etw");
    AddExit("westen",ROOM("hain_o2"));
    AddExit("norden",ROOM("schloss_n1"));
    AddExit("sueden",ROOM("schloss_s1"));
    AddExit("osten","in die Taverne#"+ROOM("taverne"));
}

reset()
{
  ::reset();
    kaste=1;
}

bwg_etw( str )
{
  notify_fail ("Was willst Du oeffnen?\n");
  if (str == "schrank" || str == "kasten"|| str == "waffenschrank")
  {
    if (!kaste)
    {
      write("Der Schrank wurde schon geoeffnet und wurde wieder versperrt.\n"
	    +"Vielleicht beim naechsten Mal!\n");
      return 1;
    }
    else
    {
      write("Du sammelst alle Deine Kraefte und zerrst an der Schranktuer. Ploetzlich\n"
	   + "gibt sie nach. Aus dem Wirrwarr im Kasten fliegt ein Schleimbaellchen raus.\n");
      say(this_player()->name()+ BS(" oeffnet Die Kastentuer. Mit einen magischen <PLOPP> erscheint ein"
          +" Schleimbaellchen, das natuerlich sofort eingesteckt wird.\n"));

      CLONEME (OBJ("speise1"));
      kaste = 0;
      return 1;
    }
    return 0;
  }
}


