/* Schloss_n1.c   */
/* Trogor   1996-06-10  */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
    
    SetProp (P_INT_SHORT, "Ein langer Gang");
    SetProp (P_INT_LONG, BS(
	     "Du stehst auf einen Gang, der nichts Besonderes zu beherbergen"
	     +" scheint. Doch dem ist nicht so. Seine Mauern sind mit"
	     +" wertvollen Bildern geschmueckt - hier wird scheinbar oefter"
	     +" geputzt, denn man findet kein einziges Staubkorn. Nach oben "
          " geht eine kleine Treppe in die Privatgemaecher der Fee."
	     ));
    SetProp (P_LIGHT, 1);
    SetProp (P_INDOORS, 1);
    SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));

    AddDetail( ({"gemaecher", "privatgemaecher"}),
      "Das sind die privaten Raeume der Fee. Wahrscheinlich ein Schlafzimmer "
      "und ein Badezimmer.");
    AddDetail( ({"raeume", "zimmer", "schlafzimmer", "badezimmer"}),
      "Die Zimmer der Fee befindet sich oben. Du kannst sie ueber die "
      "Treppe erreichen.");
    AddDetail( ({"treppe"}),
      "Eine kleine Treppe fuehrt nach oben in die Privatgemaecher der Fee.");
    AddDetail( ({"fee"}),
      "Die Fee bewohnt dieses Schloss.");
    AddDetail( ({"schloss", "feenschloss"}),
      "Du befindest Dich im Feenschloss.");
    AddDetail("staub"
	      "Hier ist keiner zu finden.\n");
    AddDetail( ({"bild", "bilder"}),
              "Sie sind von bekannten Kuenstlern des SilberLandes gemalt.\n");
    AddDetail( ({"kuenstler"}),
      "Die Kuenstler haben wirklich schoene Bilder gemalt.");
    AddDetail( ({"silberland"}),
      "Du befindest Dich im SilberLand.");
    AddDetail( ({"gang"}),
      "Der Gang erstreckt sich von Norden nach Sueden.");
    AddDetail("mauer",
	      "Die Mauer ist mit dunklen Tapeten ausgekleidet.\n");
    AddDetail(({"tapete", "tapeten"}),
	      "Dunkel, maechtig und schoen wirken sie auf Dich.\n");
    AddDetail(({"wand", "waende"}),
	      "Die Waende sich mit dunklen Tapeten ausgekleidet.\n");
    AddDetail(({"decke"}),
	      "Auf das Aussehen der Decke wird scheinbar kein Wert gelegt.\n");
    AddDetail( ({"aussehen"}),
      "Die Decke sieht ganz normal aus.");
    AddDetail( ({"wert"}),
      "Die Decke hat sicher keinen Wert.");  
    AddDetail(({"boden"}),
	      "Du stehst darauf und kannst nichts Besonderes daran feststellen.\n");
    AddDetail( ({"staubkorn","staubkoerner"}),
	      "Wo sollte hier eines liegen?\n");
    AddExit ("oben","die Treppe rauf#"+ROOM("schlaf1"));
    AddExit ("norden",ROOM("schloss_n2"));
    AddExit ("sueden",ROOM("schloss"));
}
