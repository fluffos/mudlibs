/* stall.c   */
/* trogor   1996-06-10   */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"
create()
{
  ::create();

    SetProp(P_INT_SHORT, "Ein koeniglicher Reitstall");
    SetProp(P_INT_LONG, BS(
	    "Du befindest Dich im koeniglichen Reitstall."
	    +" Viele Pferde finden hier in der Koppel Platz."
	    +" Keiner wird es je wagen eines dieser maechtigen,"
	    +" schoenen und wertvollen Pferde anzugreifen."
	    +" Der Wand entlang siehst Du die Getreidekaesten."
	    +" Da der Stall so sauber ist, wird er auch von den"
	    +" Kammerdienern versorgt. Trotzdem ist die Anwesenheit von"
	    +" Pferden durch den Geruch nicht zu verbergen."
	    ));
    SetProp(P_NAME, "Reitstall");
    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
    AddItem("/d/ebene/trogor/npc/pferd", REFRESH_DESTRUCT);
    AddItem("/d/ebene/trogor/npc/pferd", REFRESH_DESTRUCT);
    AddItem("/d/ebene/trogor/npc/pferd", REFRESH_DESTRUCT);
    AddDetail("koppel",
	      "Sie ist fuer die koeniglichen Pferde gebaut, und besteht aus "
	      +"Gold und Eisen.");
    AddDetail( ({"kasten", "getreidekasten"}),
	      "Darin befindet sich das Futter fuer die Pferde.\n");
    AddDetail("pferde",
	      "Auch wenn gerade keines da ist, sie sind sehr gefaehrlich.\n");
    AddDetail( ({"diener", "kammerdiener"}),
	      "Sie sind die Bewacher und Versorger des Schlosses.\n");
    AddDetail(({"wand", "waende"}),
	      "An der Wand haengen die Futtertroege fuer die Pferde.\n");
    AddDetail(({"futtertroege", "futtertrog"}),
	      "Diese beinhalten Heu und anderes.\n");
    AddDetail("decke",
	      "Die Decke erweckt keinen sicheren Eindruck, denn sie wirkt morsch.\n");
    AddDetail("gold",
	      "Scheinbar liegt den Feen viel an ihren Pferden, denn die Koppel ist vergoldet.\n");
    AddDetail("eisen",
	      "Eisen und Gold sind die Teile, mit denen die Koppel gebaut wurde.\n");
  AddDetail( ({"boden", "pferdemist", "mist"}),
    "Der Boden ist voller Pferdemist.");
  AddDetail( ({"stall", "reitstall", "schloss"}), 
    "Du befindest Dich im Reitstall des Schlosses.");
  AddDetail( ({"heu", "futter"}),
    "Heu ist das liebste Futter der Pferde.");
  AddDetail( ({"kasten", "kaesten", "getreidekasten", "getreidekaesten"}),
    "Darin wird das Getreide aufbewahrt, dass die Pferde fressen.");
  AddDetail( ({"getreide"}),
    "Die Pferde fressen sehr gerne Getreide.");  
  AddSmell( ({DEFAULT_SMELL, "pferde", "geruch"}),
    "Es riecht hier stark nach Pferden.");
    AddExit("norden",ROOM("schloss_s1"));
  }

