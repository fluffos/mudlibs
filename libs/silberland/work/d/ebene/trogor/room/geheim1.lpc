/* geheim1.c   */
/* Trogor      */


inherit "std/room";

#include <properties.h>
#include <language.h>

#include "files.h"


create()
{
  ::create();
    
     NewDoor("westen", ROOM("schlaf1"),
             ({"kasten", "bettkasten" }), ({
	     D_LONG, "Der Bettkasten scheint etwas zu verbergen.\n",
	     D_GENDER, MALE,
	     D_SHORT, "Ein %ser Bettkasten.",
	     D_NAME, "Kasten",  }) );
    SetProp(P_LIGHT, 0);
    SetProp(P_INDOORS, 1);
    SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));
    SetProp(P_INT_SHORT, "Ein kleiner Geheimraum");
    SetProp(P_INT_LONG, BS(
			   "Du stehst in einen kleinen Geheimraum."
			   +" Wahrscheinlich steht hier oefter wer, "
			   +"denn Du kannst den Geruch von Schweiss"
			   +" wahrnehmen.\n"));
    AddDetail( ({"raum", "geheimraum"}),
	      "Der Raum ist geheimer als man glaubt, und dient als Versteck fuer "
	      +"Liebhaber der Fee.");
    AddDetail( ({"fee", "liebhaber"}),
      "Hier versteckt sich der Liebhaber der Fee.");
    AddDetail("boden",
	      "Der Boden ist wirklich ganz normal aus Stein.\n");
    AddDetail( ({"stein", "grossteil"}),
	      "Ein Grossteil des Schlosses wurde damit gebaut.\n");
    AddDetail( ({"schloss", "feenschloss"}),
      "Du befindest Dich im Feenschloss.");
    AddDetail( ({"wand", "waende"}),
	      "Die Waende sind dreckig und grau.\n");
    AddDetail("decke",
	      "Die Decke ist wie alles in diesen Raum.\n");
    AddDetail("versteck",
	      "Der Raum dient als Versteck fuer die Liebhaber der Fee.\n");

    AddSmell( ({DEFAULT_SMELL, "geruch"}), 
      "Es riecht nach Schweiss.\n");
    AddSmell("schweiss", 
      "Scharf riecht der Schweiss der Liebhaber.\n");
    AddItem("/d/ebene/trogor/npc/lieb", REFRESH_DESTRUCT);
    AddExit("osten", ROOM("geheim2"));
}


