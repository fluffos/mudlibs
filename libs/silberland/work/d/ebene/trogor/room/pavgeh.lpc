/* Der Teleportraum des Pavillons(pavgeh.c)
** Trogor
** 1996-06-28
*/

inherit "std/room";
#include <language.h>
#include <rooms.h>
#include <combat.h>
#include <properties.h>
#include "files.h"
int op;

create()
{
  ::create();
  op=1;
  SetProp(P_INT_SHORT, "Ein kleiner verlassener Raum.");
  SetProp(P_INT_LONG, BS(
  "Du stehst in einem kleinen verlassenen Raum, der schon seit Jahren betreten"
  " wurde. Irgendwie siehst du keinen Ausgang - vielleicht ist das dein Ende?"
  " Am Boden siehst du ein Haeuflein Holz.\n"));
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  AddDetail("holz" , BS(
  "Du siehst am Boden verstreutes Holz liegen, vielleicht versteckt sich was "
  "darunter. Einen Versuch waere es wert.\n"));
  AddDetail("boden", BS(
  "Der Boden ist alt und bruechig, ein paar Holzscheite liegen herum.\n"));
  AddDetail("wand",
  "Du kannst nichts daran erkennen.\n");
  AddCmd("raeume", "raeume_weg");
  AddCmd("oeffne", "open_sth");
}

reset()
{
  ::reset();
    op=1;
}

raeume_weg(str)
{
  notify_fail("Was willst du denn wegraeumen?\n");
  if(str=="holz weg")
  {
    write("Du raeumst das Holz weg, und findest eine alte Falltuer, die sich\n"
    +"vielleicht oeffnen laesst.\n");
    say(TPN+" entdeckt eine alte Falltuere.\n", this_player());
    op=0;
    return 1;
  }
  return 0;
}

open_sth(str)
{
  notify_fail("Was willst du oeffnen?\n");
  if(str=="falltuer" && op==0)
  {
   write("Du oeffnest die Falltuer und entdeckst viele Schleimbaellchen, die\n"
   +"dir viel Kraft geben, wenn du sie isst.\n");
   CLONEME (OBJ("speise1"));
   CLONEME (OBJ("speise1"));
   CLONEME (OBJ("speise1"));
   op=1;
   // AddItem("/d/ebene/trogor/npc/henkb", REFRESH_DESTRUCT);
   CLONEME ("/d/ebene/trogor/npc/henkb");
   return 1;
  }
  return 0;
}

