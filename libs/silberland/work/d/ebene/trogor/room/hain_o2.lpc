/* hain_o2.c */
/* Trogor    */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
    ::create();
  
    SetProp(P_INT_SHORT, "Ein Vorgarten");
    SetProp(P_INT_LONG, BS(
	    "Du stehst im Vorgarten des Schlosses."
	    +" Aus dem Rauchfang steigt Rauch auf, aber das Schloss"
	    +" macht einen friedlichen Eindruck. Nach Norden geht es"
	    +" zu einen Irrgarten. Im Westen kannst Du noch das Tor sehen."
	    +" Du beginnst Dich zu fragen, was es mit diesem Schloss"
	    +" wohl auf sich haben mag. Im Osten siehst Du ein Tor, das"
	    +" scheinbar der Zugang zum Schloss ist. Noch kannst Du"
	    +" umkehren.\n") );
    AddItem("/d/ebene/trogor/npc/obdiener", REFRESH_DESTRUCT);
    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
    AddDetail("vorgarten",
	      "Er besteht aus einer Reihe von Beeten und ist schoener, "
	      +"als man glauben kann.\n");
    AddDetail( ({"rauchfang", "schornstein"}),
	      "Maechtig ragt der Rauchfang in den Himmel.\n");
    AddDetail("schloss",
	      "Es gehoert einer Fee und wird von kraeftigen Kammerdienern "
	      +"bewacht, die den Kampf nicht scheuen.\n");
    AddDetail( ({ "diener", "kammerdiener"}) ,
       	"Du kannst nur froh sein, dass Du sie noch nicht gesehen hast.\n");
    AddDetail( ({ "tor", "zugang" }),
		"Dies scheint der einzige Zugang zum Schloss zu sein, "
		+"aber aufgepasst, die massiven Eichenbohlen beweisen "
		+"dass dieses Schloss stabil und vor Angriffen sicher ist.");
    AddDetail( ({"bohlen", "eichenbohlen" }),
	       "Kein schoeneres Holz koennte dafuer verwendet werden.\n" );
    AddDetail( ({"holz", "wald", "waelder"}),
	      "Das Holz kommt aus den Waeldern des Gebirges.\n");
  AddDetail( ({"gebirge"}),
    "Das Gebirge ist weit weg.");
  AddDetail( ({"eindruck"}),
    "Das Schloss macht wirklich einen friedlichen Eindruck.");
  AddDetail( ({"irrgarten"}),
    "Im Norden ist ein Zugang zu einem Irrgarten. Leider ist er zur Zeit "
    "geschlossen.");
    AddDetail(({"rauch"}),
	      "Langsam steigt der Rauch aus den Schornstein in Richtung Himmel.\n");
  AddDetail( ({"himmel"}),
    "Der schoene Himmel wird durch den Rauch etwas getruebt.");
    AddDetail("schloss",
	      "Nun kannst Du es in seiner vollen Pracht wahrnehmen.\n");
    AddDetail("pracht",
	      "Wenn Du an dieses Wort denkst, faellt Dir sofort das Schloss ein.\n");
    AddDetail(({"beete", "beet", "reihe"}),
      "Die Beete sind zur Zeit nicht intakt, scheinbar gings dem Schloss "
      "schon mal besser.\n");
    AddSmell(DEFAULT_SMELL, "Es riecht nach verbranntem Holz");
    AddExit("westen", ROOM("hain_o1"));
    AddExit("osten", ROOM("schloss"));
    AddExit("norden", ROOM("irr1.lpc"));
}
