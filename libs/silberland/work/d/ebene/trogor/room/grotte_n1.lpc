inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "files.h"

int komm;
int erw;

create()
{
  ::create();
    SetProp(P_INT_SHORT, "Eine kleine Grotte");
    komm=0;
    erw=0;
    SetProp(P_INT_LONG, BS(
      "Du stehst nun inmitten einer kleinen Grotte. Scheinbar ist sie "
      +"vollkommen in Vergessenheit geraten, denn nichts deutet darauf "
      +"hin, dass hier oefter Leute vorbeikommen wuerden. Vielleicht ist "
      +"an dieser Grotte auch nichts Besonderes zu finden. Du schaust "
      +"verzweifelt nach irgendwelchen Anzeichen von Leben, doch Du kannst "
      +"nur ein tiefes Stoehnen aus dem Inneren des Berges vernehmen. "
      +"Veraengstigt suchen Deine Augen die Grotte ab und ploetzlich glaubst "
      +"Du ein Licht ganz hinten, hinter den Steinen, versteckt wahrnehmen "
      +"zu koennen. Neugierig wie Du bist, versuchst Du dem kleinen Lichtlein "
      +"naeherzukommen, doch Irgendetwas scheint Dich daran zu hindern, denn "
      +"das Lichtlein ist immer gleich weit weg.\n"));
    SetProp(P_LIGHT, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN:TT_CAVE]));
    
    AddDetail("boden",BS(
      "Er ist steinig und steil, vielleicht solltest Du nicht "
      +"weitergehen.\n"));
    AddDetail("grotte", BS(
      "Du untersuchst die Grotte und stellst fest, dass Du darin stehst.\n"));
    AddDetail("vergessenheit", BS(
      "Ja die Grotte sieht wirklich sehr verstaubt aus.\n"));
    AddDetail("leute", BS(
      "Scheinbar hat es hier einmal welche gegeben, doch das Einzige, was "
      +"daran erinnert ist ein kleines Licht hinter den Steinen.\n"));
    AddDetail("besonderes", BS(
      "Irgendetwas wird an dieser Grotte schon besonders sein.\n"));
    AddDetail("anzeichen", BS(
      "Das einzige Anzeichen von Leben ist dies kleine Lichtlein.\n"));
    AddDetail("stoehnen", BS(
      "Tief aus dem Inneren des Berges kannst Du ein tiefes Stoehnen "
      +"vernehmen, welches auf ein menschliches Dasein schliessen laesst.\n"));
    AddDetail("inneren", BS(
      "Scheinbar kann man in diesen Berg weiter vordringen, als man auf dem "
      +"ersten Blick glauben moechte.\n"));
    AddDetail("berg", BS(
      "Du schaust Dich in der Grotte um, und stellst fest, dass diese in "
      +"einem Berg ist. Du als erfahrener Geologe weisst, dass dies der Berg "
      +"sein muss, der die Sicht aufs Schloss so lange versperrt.\n"));
    AddDetail( ({"geologe", "gesteinskundiger"}),
      "Ein Geologe ist ein Gesteinskundiger.");
    AddDetail("schloss", BS(
      "Kehre um und Du wirst es finden.\n"));
    AddDetail(({"stein", "fels", "felsblock", "felsbloecke", "block", 
                "bloecke"}), BS(
      "Maechtige Felsbloecke kannst Du ueberall erkennen, und die Schatten "
      +"jagen Dir direkt ein wenig Angst ein.\n"));
    AddDetail( ({"angst"}),
      "Was Du etwa wirklich Angst?");
    AddDetail("schatten", BS(
      "Durch das spaerliche Licht das hereindringt werden die Schatten der "
      +"Steine riesig gross, und Du bekommst es mit der Angst zu tun.\n"));
    AddDetail(({"licht", "lichtlein", "ursprung"}), BS(
      "Du schaust fasziniert das Lichtlein an, und versuchst dem Ursprung "
      +"dessen naeherzukommen, doch Irgendetwas scheint Dich daran zu "
      +"hindern, denn es hat den Anschein, als wuerdest Du immer auf der "
      +"selben Stelle treten.\n"));
    AddDetail( ({"irgendetwas", "anschein"}), BS(
      "Dieses verflixte Irgendetwas geht Dir nicht aus den Kopf, und Du "
      +"fragst Dich, was es wohl damit auf sich hat. Du gruebelst so vor "
      +"Dich hin, und ploetzlich nimmt eine Idee konkrete Formen an. "
      +"Dieses muss daran schuld sein, dass Du nicht naeherkommenkannst. "
      +"Nun da die Idee geboren ist, versuchst Du natuerlich dem "
      +"Irgendetwas auf die Pelle zu ruecken. Vielleicht kann man ja mit "
      +"dem Irgendetwas kommunizieren.\n"));
    AddDetail("sicht", BS(
      "Der Berg versperrt die Sicht auf das Schloss.\n"));
    AddDetail("idee", BS(
      "Waerend Du an das Irgendetwas denkst kommt Dir ploetzlich eine Idee.\n"));

    AddSound(DEFAULT_SOUND, "Du hoerst ein Stoehnen aus dem Berg.\n");
    AddSmell(DEFAULT_SMELL, "Es riecht staubig und nach abgestandener Luft.\n");

    AddCmd(({"kommuniziere","rede"}), "kom_mit");
    AddCmd("erweitere", "erw_gro");

    AddExit("sueden",ROOM("grotte1"));
}

kom_mit(str)
 {
 if(str == "mit irgendetwas")
   {
   write("Du versuchst ernsthaft mit Irgendetwas Kontakt aufzunehmen.\n"
   +"Auf einmal kommst Du dem Lichtlein immer naeher. Das Einzige, das\n"
   +"Dich noch daran hindert, nach dem Lichtlein zu greifen, ist der\n"
   +"schmale Durchgang. Vielleicht kannst Du ja den Durchgang erweitern.\n");
   say(TPN +" versucht mit irgendetwas Kontakt aufzunehmen.\n");
   komm=1;
   return 1;
   }
 else
 notify_fail("Mit wem willst Du denn reden?\n");
 return 0;
 }

erw_gro(str)
 {
 if(str=="durchgang" && komm)
   {
     say(TPN +BS(" beginnt wie wild mit den Haenden zu schuerfen. Auf"
     +" einmal kommt Schwefeldunst aus dem Inneren des Berges und "
     +"" +TPN+" verschindet auf einmal im Inneren des Berges.\n"));
     write(BS("Du beginnst wie wild zu graben."
     +" Langsam aber sicher kommst Du dem Ziel immer naeher. Ja -"
     +" jetzt ist es geschafft. Du drehst Dich um die eigene Achse"
     +" und zwaengst Dich durch den Durchgang. Erstaunt blickst Du"
     +" auf, denn Du landest im absoluten Dunkel. Du fliegst und"
     +" fliegst und verlierst auf einmal die Kontrolle ueber Zeit"
     +" und Raum. Nach schier endloser Dauer beginnst Du langsamer"
     +" zu werden. Du naeherst Dich wieder dem Lichtlein, welches "
     +" Du zuerst aus den Augen verloren hast. Ja, ja, das Ziel"
     +" kann nicht mehr weit weg sein. Ploetzlich ueberkommen Dir"
     +" Zweifel, was ueberhaupt das Ziel sein soll. Doch nun ist es"
     +" schon zu spaet. Eine abrupte Bremsung - ein Plopp - und die"
     +" Hoellenfahrt ist beendet.\n"));
     this_player()->move(ROOM("grotte_n2"), M_GO, "in die Hoehle", "plumpst", 
			      "faellt herein");
     erw=1;
     return 1;
   }
 if(str=="durchgang" && !komm)
   {
     say(TPN +" schuerft und schuerft und schuerft.\n");
     write(BS("Du schuerfst und schuerfst, doch Irgendetwas hindert Dich "
     +"daran Deinem Ziel naeher zu kommen.\n"));
     erw=0;
     return 1;
   }
 else
   {
     notify_fail("Was willst Du denn erweitern?\n");
     return 0;
   }
}

