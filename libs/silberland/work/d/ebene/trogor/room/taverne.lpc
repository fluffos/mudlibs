
/*
** Kneipe 'Schlosstaverne', Schloss  (w) Trogor
**
**  
** --------------------------------------------------------------------
** 
**
**                     
**
**                    
*/

inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"
#include <pub.h>

create()
{
  ::create();
  AddItem("/d/ebene/trogor/npc/walpurgis", REFRESH_DESTRUCT);
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:19]));
  SetProp (P_INT_SHORT, "Schlosstaverne");
  SetProp (P_INT_LONG, BS(
  "Du befindest Dich in den alten Gemaeuern der Schlosstaverne. Die Taverne ist"
  +" ein grosser Raum, mit Baenken, Tischen und einer riesigen Theke. Die"
  +" Kerzen die den Raum erleuchten, befinden sich auf einem Luster aus Glas,"
  +" der direkt in der Mitte des Saales von der Decke haengt. Bunte Kellner"
  +" eilen von Tisch zu Tisch um den wartenden Reisenden ihre Wuensche von"
  +" den Lippen lesen zu koennen. Mit <menue> kannst Du die Speisekarte"
  +" anschauen.\n"));
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "walpurgis");
  SetProp(P_PUBKEEPER_NAME, "Walpurgis");
  SetProp(P_PUBKEEPER_GENDER, FEMALE );
  
  AddDetail( ({"speisekarte", "karte"}),
    "Die Speisekarte kannst Du mit <menue> lesen."); 
  AddDetail ( ({"taverne","kneipe", "schlosstaverne", "raum"}), bs(
    "Du befindest Dich gerade in der Schlosstaverne.\n")); 
  AddDetail ( ({"wand","waende","gemaeuer"}), bs(
    "Die Waende sind aus Stein verkleidet und schwarz vom Kerzenrauch.\n "));
  AddDetail( ({"stein", "gestein"}),
    "Das Gestein der Waende ist ganz schwarz vom Kerzenrauch, so kann man "
    "nciht erkennen, um was fuer eine Gestein es sich handelt.");
  AddDetail ("boden",
    "Der Boden besteht aus alten knarrenden Parkett.\n");
  AddDetail ( ({"parkett"}),
    "Alt und abgetreten knarren sie bei jeden Schritt auf ihnen.\n");
  AddDetail( ({"schritt"}),
    "Du machst einen Schritt un das Parkett knarrt.");
  AddDetail ("decke", BS("Sie befindet sich direkt ueber Dir. In der Mitte"
             +" befindet sich ein grosser Luster.\n"));
  AddDetail ("staub", "Sowas siehst Du hier nicht. Ehrlich!\n");
  AddDetail ("ausgang", "Er befindet sich im Westen.\n");
  AddDetail ( ({"speisesaal","saal"}), bs(
    "So einen schoenen Saal hast Du noch nie gesehen, am liebsten wuerdest"
   +" Du fuer immer hierbleiben.\n"));
  AddDetail ( ({"luster", "glas", "mitte"}),
    "Der Luster ist aus Glas, sieht geputzt aus und traegt viele Kerzen.\n");
  AddDetail ( ({"rauch", "kerzenrauch"}),
    "Ueberall steht Rauch im Raum, den die billigen Kerzen verursachen.\n");
  AddDetail (({"kerzen","kerze"}), BS(
    "Schoene rote Kerzen schmuecken den Luster.\n"));
  AddDetail ("besitzer", "Das ist Trogor.\n");
  AddDetail ( ({"tisch","tische","stuhl","stuehle","sessel",
    "bank","baenke"}), "Davon stehen etliche hier rum.\n");
  AddDetail( ({"kellner"}),
    "Sie eilen von Tisch zu Tisch um den wartenden Reisenden ihre Wuensche von"
    " den Lippen lesen zu koennen.");
  AddDetail( ({"wuensche", "wunsch"}),
    "Wenn Du einen Wunsch hast, dann schau auf der Speisekarte nach, ob er "
    "hier erfuellt werden kann.");
  AddDetail( ({"lippe", "lippen"}),
    "Deine eigenen Lippen kannst Du nicht sehen (ohne Spiegel).");
  AddDetail( ({"spiegel"}),
    "Du hast leider keinen Spiegel dabei."); 
  AddDetail ( ({"reisender", "reisende"}),bs(
    "Er sitzt am Tisch und trinkt genuesslich sein Glas aus.\n"));
  AddDetail ( ({"mahlzeit","mahlzeiten"}), "Mahlzeit!\n");
  AddDetail ("trogor",
    "Er ist Magier und im Moment sehr beschaeftigt.\n");
  AddDetail ("theke",
    "Eigentlich stehst Du davor, doch sie ist alt und dreckig.\n");
  AddDrink("Kloake", "kloake", 7, ({3,1}), 0, 1,
           ({"Trogor bringt Dir eine Kloake. Schmeckt auch danach.",
             "&& verzieht das Gesicht, als &! die Kloake hinunterspuelt."}));

  AddDrink("Gurkensaft", ({"saft", "gurkensaft"}),
           30, 8, 0, 5,
           ({"Trogor bringt Dir Deinen gruenen Gurkensaft.",
             "&& trinkt schnell und durstig den Gurkensaft aus."}));   

  AddDrink("Trogors Donnerbalken",
           ({"balken","donner","donnerbalken"}),
           45, ({20,16}), 8, 1,
           ({"Trogor befoerdert Dich auf den Donnerbalken, pfui.\n"+
             "Er setzt Dir eine Flasche an und sagt: TRINK!",
             "&& trinkt am Donnerbalken genuesslich einen Saft."}));

  AddDrink("Feenzauber", ({"zauber", "fee", "feenzauber"}),
           170, ({10, 40}), 5, 4, 
    ({"Walpurgis bringt Dir ein Glas mit seltsam aussehender Fluessigkeit. "
    "Schnell\nund gierig schluckst Du es und versinkst in magischen "
    "Traeumen. Kurz danach\nstellst Du fest, dass Du noch immer genauso "
    "durstig bist wie davor...",
    "&& bekommt eine seltsam aussehende Fluessigkeit serviert, "
    "die &!\nmit einem schnellen kurzen Schluck "
    "austrinkt und magische Sprueche\nvon sich gibt.." }) );

  AddDrink("Grotterblut", ({"blut","grotter", "grotterblut"}),
           500, 40, 0, 5,
           ({"Ein vorbeieilender Kellner reicht Dir einen Kelch mit Blut\n"+
             "vom Grotter. Du trinkst und faengst zum Fluchen an.\n"+
             "@$*+°!????~~%&/...\n\n\n"+
             "Nachdem Dir die Flueche ausgehen, schaust Du in die Runde ...\n"+
             "... es herscht Ratlosigkeit.",
             "&& trinkt Blut vom Grotter und beginnt zu Fluchen.\n"+
             "Man glaubt gar nicht was es alles fuer Woerter gibt!\n"+
             "Wie schrecklich!\n"}));

  AddFood ("Pfauenei", ({"ei", "pfau", "pfauenei"}),
          130, 37, 14, 
          ({"Du isst ein riesiges Pfauenei.",
            "&& isst ein riesiges Pfauenei."}) ); 

  AddExit ("westen", ROOM("schloss.lpc"));

}

