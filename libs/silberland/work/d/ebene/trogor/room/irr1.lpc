/* irr1.c      */
/* Beginn des Irrgartens */
/* trogor  1996-06-10 */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();
    
    SetProp(P_INT_SHORT, "Ein kleiner Irrgarten");
    SetProp(P_INT_LONG, BS(
       "Du befindest Dich auf der groessten Schlossbaustelle."
       +" Da soviele Arbeiter und Gaertner herumstehen, fragst Du Dich"
       +" was hier wohl kommen mag. Des Raetsels Loesung: Ein Irrgarten"));
    SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));
    AddExit("sueden", ROOM("hain_o2"));
}
