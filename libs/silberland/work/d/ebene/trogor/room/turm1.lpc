inherit "std/room";
#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Treppengang");
  SetProp(P_INT_LONG, BS(
   "Du stehst inmitten eines kleinen Treppenganges. "
   +"Sofort fragst Du Dich wo es wohl hingehen mag, und ob es nicht eventuell"
   +" gefaehrlich ist weiterzugehen. Da Dein Mut riesengross ist beschliesst Du"
   +" nach kurzem Zoegern weiterzugehen. Hoffentlich wird Dein Mut belohnt."
   +" Nach oben wird die Treppe steiler und steiler.\n"));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:19]));

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind aus Stein.");
  AddDetail( ({"decke"}),
    "Die Decke ist aus Stein.");
  AddDetail( ({"boden"}),
    "Der Boden ist aus Stein.");
  AddDetail( ({"stein", "turm"}),
    "Der ganze Turm ist aus Stein.");
  AddDetail( ({"treppe", "gang", "treppengang"}),
    "Sie ist steil und fuehrt nach oben, was wird Dich dort erwarten?\n");
  AddDetail(({"mut", "zoegern"}),
    "Du musst viel Mut aufwenden, um weiterzugehen.\n");
  AddSmell(DEFAULT_SMELL, "Es stinkt nach Pest und Zauberei.\n");
  AddDetail("pest",
    "Hoffentlich hat die keiner.\n");
  AddDetail("zauberei",
    "Uups\n");

  AddExit("unten", ROOM("schloss_n2"));
  AddExit("oben", "die Treppe rauf#"+ROOM("turm2"));
}
