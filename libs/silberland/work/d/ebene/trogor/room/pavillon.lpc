/* 
** Ein Pavillon (pavillon.c)
** Trogor
** 1996-06-27
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <environment.h>
#include "files.h"
#include <moving.h>

create()
{
  ::create();
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Ein kleiner Pavillon");
  SetProp(P_INT_LONG, BS(
  "Du stehst inmitten eines lieblichen kleinen Pavillons, der nur im Sommer"
  +" bewohnt und benuetzt scheint. Die Halle des Pavillons ist geschmueckt"
  +" mit Weinranken, und die maechtige Decke wird von feuerfarbenen Saeulen"
  +" getragen. In der Mitte des Raumes steht ein kleiner Desserttisch, und"
  +" am Ende des Salles kannst du eine Buehne fuer die Musiker ausmachen.\n"
  ));
  AddDetail( ({"pavillon", "saal"}), "Du stehst darin.\n");
  AddDetail("sommer", "Eine schoene Zeit.\n");
  AddDetail( ({"ranken", "weinranken"}),
  "Sie umranken die maechtigen Saeulen, und scheinen schon seit jeher hier\n"
  +"zu wachsen und gedeihen.\n");
  AddDetail("decke",
  "Maechtig baut sich ueber dir die Decke auf, zu der kein irdisch Wesen je\n"
  +"gelangen kann.\n");
  AddDetail( ({"saeule", "saeulen"}),
  "Die Saeulen tragen die Decke und sind aus feuerfarbnen Marmor.\n");
  AddDetail( ({"desserttisch","tisch"}),
  "Auf diesen Tisch scheinen normalerweise Speisen zu liegen.\n");
  AddDetail("speisen",
  "Leider sind keine da.\n");
  AddDetail("buehne",
  "Die Buehne wirkt alt und einsturtgefaehrdet. Sollst du wirklich darauf\n"
  +"steigen. Wer wagt gewinnt, heisst ein Sprichwort.\n");
  AddDetail("musiker",
  "Als dieser Pavillon oefter genutzt wurde, spielten sie regelmaessig.\n");
  AddSmell(DEFAULT_SMELL, "Es riecht nach der guten alten Zeit.\n");
  AddCmd("steige", "stg_auf");
}

stg_auf(str)
{
  notify_fail("Worauf willst du steigen?\n");
  if (str=="auf buehne");
  {
  write("Du steigst auf die Buehne, gehst zum hintersten Ende, hoerst die \n"
  +"Holzplanken krachen, spuerst wie der Boden unter dir nachlaesst, und\n"
  +"verschwindest im Nichts.\n");
  say(TPN+ " steigt auf die Buehne, bricht ein und verschwindet.\n");
  TP->do_damage(30,0);
  TP->move(ROOM("schloss"), M_TPORT, " kracht ein und verschwindet im Nichts.");
  return 1;
  }
  return 0;
}
