/* Zugang zur Grotte */
/* Trogor */


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"


create()
{
  ::create();

    SetProp(P_INT_SHORT, "Ein kleiner Weg");
    SetProp(P_INT_LONG, BS(
       "Du befindest Dich auf einen kleinen ausgetrampelten Pfad.\n"
      +"Wo der wohl hinfuehren mag. Nach Norden hin wird es immer"
      +" enger und Du siehst schon einen Berg, Richtung Sueden kommst"
      +" Du wieder zur Hauptstrasse. Es wird immer steiler."
      +" Du siehst eine Anlegestelle und ein Schild.\n"));
    SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:18]));

  AddDetail( ({"strasse", "hauptstrasse"}),
    "Nach Sueden gehts zur Hauptstrasse zurueck.");
  AddDetail( ({"himmel"}),
    "Der Himmer ist weit ueber Dir.");
    AddDetail("boden",
	      "Er ist steinig und steil, vielleicht solltest Du nicht "
	      +"weitergehen.\n");
    AddDetail(({"pfad", "weg"}),
	      "Steil fuehrt er Richtung einer Grotte.\n");
    AddDetail("grotte",
	      "Sie kannst Du von hier aus noch nicht sehen.\n");
    AddDetail("berg",
	      "Was mag wohl dahinter versteckt sein?\n");
    AddDetail( ({"stelle", "anlegestelle"}),
	      "Von hier faehrt ein Floss zur Grotte.\n");
  AddDetail( ({"anlegestelle", "stelle"}),
    "Hier legt das Floss an, mit dem man zur Grotte fahren kann.");
    AddDetail("schild",
	      "Vielleicht kann man es lesen.\n");
    AddReadDetail("schild", 
        "+--------------------------------------+\n"
       +"|     BootsFahrPlan                    |\n"
       +"|     Hier ist der Anlegeplatz         |\n"
       +"|     vom Moorfloss, das               |\n"
       +"|     die einzige Verbindung zwischen  |\n"
       +"|     hier und der Grotte oder         |\n"
       +"|     dem Schloss ist.                 |\n"
       +"|     Befehle: steige/springe          |\n"
       +"|     von/auf/aus floss                |\n"
       +"+--------------------------------------+\n");
    // AddExit("norden",ROOM("grotte1"));
    AddExit("sueden",ROOM("grotte_s3"));

    AddItem( OBJ("floss"), REFRESH_DESTRUCT, 1);
  }
