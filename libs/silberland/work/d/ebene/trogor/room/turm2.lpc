inherit "std/room";
#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Treppengang");
  SetProp(P_INT_LONG, BS(
    "Du stehst am Ende der Treppe. "
    "Sofort erkennst Du, dass Du auf einen Turm stehst, der scheinbar fuer "
    "wissenschaftliche Zwecke gebaut wurde. Dein Blick schweift ueber das "
    "Land unter Dir. Es ist schoen hier. Hoffentlich kannst Du hier laenger "
    "bleiben."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:17]));

  AddDetail( ({"ende"}),
    "Du siehst das Ende der Treppe.");
  AddDetail( ({"boden", "steinboden"}),
    "Du stehst auf einem Steinboden.");
  AddDetail( ({"stein"}),
    "Der ganze Turm ist aus Stein gebaut.");
  AddDetail( ({"wand", "waende"}),
    ([0: "Die Waende des Turms sind hier nur mehr huefthoch, damit man einen "
         "freien Blick ueber das Land geniessen kann.",
      "zwerg": "Die Waende des Turms sind hier gerade noch so hoch, dass "
               "Du darueber hinweg den Blick ueber das Land geniessen kannst.",
      "hobbit": "Die Waende des Turms sind hier etwas hoeher als Du selbst. "
                "So kannst Du den Blick ueber das Land nicht geniessen."]) );
  AddDetail( ({"blick", "rundblick"}),
    ([0: "Der Rundblick ueber das SilberLand ist herrlich.",
      "hobbit": "Leider kannst Du nicht viel sehen."]) ); 
  AddDetail( ({"treppe", "gang", "treppengang"}),
      "Sie ist steil und fuehrt nach unten.\n");
  AddDetail("turm",
      "Gross und maechtig ragt er ueber das Land.\n");
  AddDetail( ({"zweck", "zwecke"}),
      "Hier werden wohl Sterne untersucht.\n");
  AddDetail( ({"stern", "sterne"}),
      "Es ist Tag, leider siehst Du keine.\n");
  AddDetail( ({"tag"}),
    "Heute ist ein herrlicher Tag.");
  AddDetail("land",
      "Du siehst ganz Silberland unter Dir.\n");
  AddDetail("silberland",
      "Du spielst darin.:)\n");
  AddItem("/d/ebene/trogor/npc/magier", REFRESH_DESTRUCT);
  AddExit("unten", ROOM("turm1"));
  AddSmell(DEFAULT_SMELL, "Es stinkt nach Pest und Zauberei.\n");
  AddDetail("pest",
      "Hoffentlich hat die keiner.\n");
  AddDetail("zauberei",
      "Uups\n");

}
