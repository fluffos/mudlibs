inherit "std/laden";

#include <properties.h>
#include <laden.h>
#include "files.h"

#define LAGER ROOM "kramlager"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich in einem kleinen Kramladen. Sofort erkennst Du, "+
    "dass es hier Dinge gibt, die man woanders wohl vergeblich sucht. "+
    "Der Haendler scheint sich dabei offenbar auf Gegenstaende "+
    "spezialisiert zu haben, die man zum Ueberleben benoetigt, wenn man "+
    "auf sich selbst gestellt ist. An der Wand kannst Du eine Tafel "+
    "haengen sehen, die Du lesen kannst."));
  SetProp (P_INT_SHORT,"In einem kleinen Kramladen");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER); // | SHOP_NEEDSKEEPER);
  // SetProp(P_SHOPKEEPER_ID, "haendler");
  SetProp(P_SHOPKEEPER_NAME, "der Haendler");

  AddDetail ( ({"kramladen", "laden"}), "Du stehst mittendrin.\n");
  AddDetail ( ({"regal", "regale"}),
    "Die Regale sind mit allerlei brauchbaren Utensilien vollgefuellt.\n");
  AddDetail ("tafel", "Eine kleine Tafel, die an der Wand haengt. "+
    "Du kannst sie lesen.\n");
  AddDetail ( ({"boden", "decke"}),
    "Du kannst daran nichts besonderes erkennen.\n");
  AddDetail ( ({"wand", "waende"}),
    "Bis auf eine Wand, an der eine Tafel haengt, kannst Du nichts "+
    "besonderes\nerkennen.\n");
  AddDetail ( ({"gegenstaende", "kram", "utensilien", "dinge"}),
    "Versuchs mal mit 'zeige'\n");
  AddDetail ("haendler",
    "Er steht vor Dir und blickt Dich laechelnd an.\n");

  AddReadDetail ("tafel",
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands "+
    "der Liste aus.\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
    "                  Haendler dafuer bezahlt.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  SetStorageRoom (LAGER);

  AddExit ("sueden","./room_e3");
}
