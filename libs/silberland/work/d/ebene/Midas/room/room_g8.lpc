inherit "/d/ebene/Midas/room/wegmauer_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  AppendProp (P_INT_LONG, bs(
      "Nach Suedosten gelangst Du zu einem hohen Aussichtsturm, den man "
      "ueber eine kleine enge Treppe offenbar sogar besteigen kann. Auf "
      "halber Hoehe siehst Du noch den Wachweg entlang der Mauer, von "
      "dem aus man einen guten Ueberblick ueber die Stadt hat."));
  AddDetail( ({"treppe"}),
      "Die Treppe suedoestlich von Dir fuehrt zum Wachweg sowie dem "
      "hohen Aussichtsturm hinauf.");
  AddDetail( ({"aussichtsturm","turm","aussicht"}),
      "Der hohe Turm bietet bestimmt eine phantastische Aussicht! "
      "Vielleicht solltest Du ja mal da rauf schauen...?");
  AddDetail( ({"hoehe"}),
      "Falls Du die Hoehe des Turms meinst: absolut schwindelerregend!");
  AddDetail( ({"dienst","kampfsoldaten"}),
      "Die Kampfsoldaten versehen ihren Dienst auf dem Wachweg, den "
      "Du ueber Dir erkennen kannst. Sie sorgen fuer Ruhe und Ordnung.");
  AddDetail( ({"ordnung"}),
      "Ordnung muss sein! Besonders dort, wo viele Leute zusammenleben...");
  AddDetail( ({"wachweg"}),
      "Der Wachweg ueber Dir wird von Kampfsoldaten bevoelkert, die "
      "von dort oben den Ueberblick ueber die Stadt bewahren und so "
      "fuer Ruhe und Ordnung sorgen koennen.");
  AddDetail( ({"ueberblick"}),
      "Von dem Wachweg ueber Dir kein Problem!");
  AddDetail( ({"problem"}),
      "Hoffentlich hast Du keines mit den Kampfsoldaten!");

  AddExit("nordosten", "./room_h7");
  AddExit("suedwesten", "./room_f9");
  AddExit("suedosten", "./room_h9");
}
