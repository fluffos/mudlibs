/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL. Preserved as room_b5_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Hauptstrasse in Midas");
  set_long(
    "Die Hauptstrasse in Midas erstreckt sich von Westen nach Osten. "
    "Noerdlich der Strasse laedt die grosse Stadtkneipe 'Zur roten Nase' "
    "vorueberziehende Abenteurer zum Verweilen ein. Im Westen siehst Du "
    "bereits das Westtor von Midas.\n"
  );
  set_exits(([
    "norden": "/d/ebene/Midas/room/kneipe",
    "osten": "/d/ebene/Midas/room/room_c5",
    "westen": "/d/ebene/Midas/room/room_a5",
  ]));
}
