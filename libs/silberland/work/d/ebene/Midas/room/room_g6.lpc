/*
** Kieselweg in Midas  (w) Woody@SL
** ---
** 1996-08-17  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

nosave int beeren;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich auf einem kleinen Kieselweg inmitten der "+
    "grossen Stadt Midas, der von der breiten Hauptstrasse im "+
    "Norden weiter nach Sueden hin verlaeuft. Der Weg ist von "+
    "einigen von Dir nicht naeher identifizierbaren Straeuchern "+
    "gesaeumt und wirkt sehr ordentlich." ));

  SetProp (P_INT_SHORT, "Kieselweg in Midas");

  AddDetail ( ({"kieselweg","weg"}), "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus unzaehligen kleinen Kieselsteinchen.\n");
  AddDetail ( ({"kiesel","kieselsteinchen","steinchen","schritt"}),
    "Die Kieselsteinchen knirschen unter Deinem Schritt.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ( ({"strauch", "straeucher"}),
    bs("Einige Straeucher saeumen den Weg und geben ihm seine irgendwie "+
    "'ordentliche' Erscheinung. Ein kleiner Holunderstrauch faellt Dir "+
    "besonders auf."));
  AddSpecialDetail ("holunderstrauch", "d_strauch");
  AddSpecialDetail ( ({"beeren", "beere"}), "d_beeren");

  AddSound (DEFAULT_SOUND,
      "Die Kieselsteinchen knirschen unter Deinem Schritt.\n");
  AddSound ("knirschen", bs(
      "Ganz gewoehnliches, oedes Knirschen. Weiss gar nicht, warum Du da "
      "auch noch genauer hinhoerst!"));

  AddExit ("norden", "./room_g5");
  AddExit ("sueden", "./room_g7");

  beeren=3;
  AddCmd ( ({"pflueck", "pfluecke"}), "pflueck" );
}

reset()
{
  ::reset();
  beeren=3;
}

string d_strauch()
{
  if (beeren)
    return "Einige Beeren haengen noch an dem Strauch.\n";
    else return bs("Irgendjemand scheint den Strauch leergepflueckt zu "+
      "haben. Jedenfalls kannst Du keinerlei Beeren mehr dran erkennen.");
}

string d_beeren()
{
  if (beeren)
    return "Die Beeren lassen sich sicherlich ganz hervorragend pfluecken.\n";
    else return 0;
}

int pflueck(string str)
{
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  if ((str!="beeren") && (str!="beere")) return 0;
  if (!beeren) return 0;
  beeren--;
  write ("Du pflueckst vorsichtig eine Holunderbeere.\n");
  say (CAP_TPN+" pflueckt eine Holunderbeere.\n");
  CLONE(OBJ("div/beere"), TP);
  return 1;
}
