/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL. Preserved as room_f5_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Hauptstrasse in Midas");
  set_long(
    "Die Hauptstrasse in Midas erstreckt sich von Westen nach Osten. "
    "Im Norden kannst Du die Postzentrale von Midas erkennen. Von dort "
    "kann man jederzeit Post verschicken und auch eigene Briefe abholen.\n"
  );
  set_exits(([
    "norden": "/d/ebene/Midas/room/post",
    "westen": "/d/ebene/Midas/room/room_e5",
    "osten": "/d/ebene/Midas/room/room_g5",
  ]));
  set_items(([
    "post": "Die gelbe Postzentrale liegt noerdlich von Dir.\n",
  ]));
}
