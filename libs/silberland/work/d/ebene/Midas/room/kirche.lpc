/*
** Kirche in Midas  (w) Woody@SL
** ---
** 1996-08-18  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich inmitten der wundervollen, praechtigen Kirche "+
    "von Midas. Weiter nach Westen geht es zwischen den Stuehlen "+
    "hindurch zum Altar, waehrend eine kleine Wendeltreppe nach "+
    "oben zum Kirchturm hinauffuehrt. Der Boden ist mit praechtigen, "+
    "abwechselnd schwarzen und weissen Marmorfliesen ausgelegt, und "+
    "durch die bunten Glasfenster hindurch schillert die Sonne in allen "+
    "Farben des Lichts und laesst das Kircheninnere in seinem vollen "+
    "Glanz erstrahlen. Es herrscht eine andaechtige Stille hier, die "+
    "Du nicht zu stoeren wagst. Auf einer Seite kannst Du zwei "+
    "Beichtstuehle ausmachen, in denen Du Deine Suenden beichten und "+
    "um Vergebung bitten kannst."));

  SetProp (P_INT_SHORT, "In einer Kirche");

  AddDetail ("kirche",
    "Du befindest Dich inmitten der gewaltigen Kirche von Midas.");
  AddDetail ("midas",
    "Midas ist die praechtige Hauptstadt des Silberlands.");
  AddDetail ("hauptstadt",
    "Zumindest die Hauptstadt der Menschen.");
  AddDetail ( ({"menschen"}), ([
         0 : "Die Menschen sind eine der Rassen im Silberland.\n",
         "mensch" : "Du bist ja selber einer!\n",
      ]) );
  AddDetail ("silberland",
    "Da befindest Du Dich gerade.");
  AddDetail ("rassen",
    "Es gibt noch einige andere, denen Du sicher auf Deinen weiteren "
    "Reisen begegnen wirst.");
  AddDetail ("reisen",
    "Je mehr Du herumkommst, desto mehr wirst Du kennenlernen.");
  AddDetail ( ({"glanz", "strahlen"}),
    "Du staunst.");
  AddDetail ("kirchenschiff",
    "Das gewaltige Kirchenschiff erstreckt sich noch weiter nach Westen.");
  AddDetail ( ({"kirchturm", "turm"}),
    "Der Kirchturm ist ueber eine kleine Wendeltreppe erreichbar.");
  AddDetail ( ({"wendeltreppe", "treppe"}),
    "Die kleine, enge Wendeltreppe fuehrt hinauf in den hohen Kirchturm.");
  AddDetail ("boden",
    "Der Boden ist mit praechtigen, abwechselnd schwarzen und "+
    "weissen Marmorfliesen ausgelegt.");
  AddDetail ( ({"wand", "waende"}),
    "Die Waende ragen steil empor und tragen das gewaltige Kirchenschiff.");
  AddDetail ( ({"marmorfliesen","fliesen"}),
    "Die Fliesen sind aus Marmor und aeusserst sauber gefertigt.");
  AddDetail ("marmor",
    "Der Marmor der Fliesen ist ueberraschend schlicht. Zumindest hast "+
    "Du auch schon mal wesentlich teurer wirkenden Marmor gesehen als "+
    "diesen...");
  AddDetail ("stuehle",
    "Im riesigen Kirchenschiff sind jede Menge Stuehle verteilt, "+
    "zwischen denen ein Gang weiter nach Westen vor zum Altar fuehrt.");
  AddDetail ("menge",
    "Ein Synonym fuer 'viele'.");
  AddDetail ("synonym",
    "Ein anderes Wort fuer \"ein anderes Wort\".");
  AddDetail ("wort",
    "Das kannst Du ruhig woertlich nehmen.");
  AddDetail ("gang",
    "Du kannst ihm bis vor zum Altar folgen.");
  AddDetail ("altar",
    "Weiter im Westen kannst Du einen praechtigen, mit Gold "
    "verzierten und wunderschoen ausgeschmueckten Altar erkennen.");
  AddDetail ( ({"gold"}), ([
         0 : "Der Altar ist schon sehr prunkvoll.\n",
         "zwerg" : "Du faengst unwillkuerlich zu sabbern an. Schaem Dich!\n",
      ]) );
  AddDetail ( ({"glasfenster","fenster"}),
    "Die Fenster sind mit buntem Glas in allen Farben durchsetzt und "+
    "zeigen diverse Szenen aus der Kirchengeschichte.");
  AddDetail ( ({"szene","szenen"}),
    "Sie wurden kunstvoll umgesetzt.");
  AddDetail ("glas",
    "Das Glas der Fenster schillert in allen Farben des Lichts.");
  AddDetail ("kirchengeschichte",
    "Du siehst unter anderem eine Taufe und eine Kreuzigung.");
  AddDetail ("taufe",
    "Sie findet offenbar an einem Fluss statt.");
  AddDetail ("fluss",
    "Der ist mit vielen blauen Glasfenstern stilisiert.");
  AddDetail ("kreuzigung",
    "Menschen starben einst wohl sogar fuer ihren Glauben. Das passiert "
    "heute nur noch unvorsichtigen Paladinen.");
  AddDetail ( ({"paladin","paladine"}),
    "Der Glaube dieser Gilde ist stark.");
  AddDetail ("glaube",
    "Hoffentlich verlieren sie ihn nie.");
  AddDetail ("gilde",
    "Die Gilde der Paladine kaempft fuer das Gute. Behauptet sie.");
  AddDetail ("gute",
    "Das Gute im Namen von Dusty.");
  AddDetail ("namen",
    "Ihr Name ist Dusty.");
  AddDetail ("name",
    "Der Name der Goettin.");
  AddDetail ("dusty",
    "Ein seltsamer Personenkult herrscht um diese Goettin.");
  AddDetail ("goettin",
    "Dusty ist eine Goettin, die einzige.");
  AddDetail ("personenkult",
    "Frag doch mal einen Paladin.");
  AddDetail ( ({"farbe","farben"}),
    "Die Sonne schillert durch das bunte Glas der Fenster und erhellt "+
    "die Kirche in Rot, Gruen, Blau und Gelb.");
  AddDetail ("rot",
    "Eine herrliche Farbe, rot wie das Blut.");
  AddDetail ("blut",
    "Hoffentlich musst Du keines vergiessen.");
  AddDetail ("gruen",
    "Eine herrliche Farbe, gruen wie die endlosen Wiesen im Huegelland.");
  AddDetail ( ({"wiese","wiesen","huegelland"}),
    "Die Wiesen im Huegelland sind die saftigsten im ganzen Silberland.");
  AddDetail ("blau",
    "Eine herrliche Farbe, blau wie das weite Meer.");
  AddDetail ("meer",
    "Das Meer ist gar nicht so weit weg von hier.");
  AddDetail ("gelb",
    "Eine herrliche Farbe, gelb wie die Sonne.");
  AddDetail ("licht",
    "Das Licht der Sonne wird durch die bunten Fenster in verschiedene "+
    "Farben geteilt und erhellt die Kirche auf praechtigste Art und Weise.");
  AddDetail ( ({"art","weise"}),
    "Diese ist leider unbeschreiblich.");
  AddDetail ("sonne",
    "Die Sonne mueht ihre Strahlen durch die bunten Glasfenster und "+
    "laesst das Kircheninnere in allen Farben des Lichts schillern.");
  AddDetail ("kircheninneres",
    "In dem befindest Du Dich gerade.");
  AddDetail ( ({"ruhe","stille"}),
    "In dieser Kirche herrschen Ruhe und Stille. Du wagst es nicht, "+
    "zu rufen oder laut etwas zu sagen.");
  AddDetail ("seite",
    "An der Seite des Kirchenschiffes kannst Du zwei Beichtstuehle "+
    "erkennen.");
  AddDetail ("suenden",
    "Hoffentlich hast Du nicht zuviele begangen!");
  AddDetail ("vergebung",
    "Darum kannst Du nur bitten.");
  AddDetail ("freie",
    "Dazu musst Du durch das Tor nach draussen schreiten.");
  AddDetail ("beichtstuehle",
    "Zwei Beichtstuehle stehen an einer Seite des Kirchenschiffes. "+
    "Du kannst versuchen, sie zu betreten.");
  AddDetail ("decke",
    "An der hohen Decke kannst Du wundervolle Malereien erkennen.");
  AddDetail ( ({"deckenmalereien","malereien"}),
    "Die Malereien an der Decke zeigen diverse Szenen aus der "+
    "Kirchengeschichte, wie dies auch die Glasfenster tun.");

  AddItem ( ROOM "beichtstuhl", REFRESH_REMOVE);
  AddItem ( ROOM "beichtstuhl", REFRESH_REMOVE);

  AddExit ("westen", "./kirche2");
  AddExit ("oben", "./kirchturm1");
  NewDoor ("raus", "./room_f8",
    ({"kirchentor", "tor"}),
    ({
      D_LONG, "Das gewaltige Kirchentor fuehrt aus der praechtigen "+
        "Kirche hinaus ins Freie.\n",
      D_GENDER, NEUTER,
      D_SHORT, "Ein %ses Kirchentor.",
      D_NAME, "Kirchentor",
      D_MSGS, "aus der Kirche raus",
    }) );

  AddCmd( ({ "ruf", "rufe" }), "ruf");
  AddCmd( ({ "sag", "sage" }), "sag");
  AddCmd( "'", "sag", 1);
  AddCmd( ({ "bitte" }), "bitte");
}

int ruf(string str)
{
  write("Du wagst es nicht, an dieser Staette der Ruhe etwas zu rufen.\n");
  return 1;
}

int sag(string str)
{
  str = TP->_unparsed_args();

  if (!str) str = "";
  if (query_verb()[0] == '\'')
    str = query_verb()[1..] + " " + str;
  if (str == "" || !sizeof(explode(str, " ")))
    return 0;
  write(break_string(str, 78, "Du fluesterst: "));
  say(break_string(str, 78, TP->Name() + " fluestert: "));
  return 1;
}

int bitte(string str)
{
  if (str != "um vergebung")
    return notify_fail("Worum willst Du bitten?\n"), 0;

  write("Dazu solltest Du schon zuvor den Beichtstuhl betreten.");
  return 1;
}

