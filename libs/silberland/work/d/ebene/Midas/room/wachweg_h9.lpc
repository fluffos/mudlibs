inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:17]));
  SetProp (P_INT_LONG, bs(
    "Du balancierst vorsichtig auf einem schmalen Wachweg auf der "+
    "maechtigen Stadtmauer der Stadt Midas, der rund um die gesamte Stadt "+
    "fuehrt. Hier versehen die Kampfsoldaten ihren Dienst, weil sie einen "+
    "ausgezeichneten Ueberblick ueber saemtliche Wege der Stadt haben und "+
    "Stoerenfriede sofort entdecken koennen.")+bs(
    "Eine kleine Leiter fuehrt noch hoeher auf einen hohen Aussichtsturm "+
    "hinauf und eine kleine enge Treppe fuehrt runter zur Stadt."));

  SetProp (P_INT_SHORT, "Wachweg in Midas");

  AddDetail ("midas",
    "Midas heisst die Stadt, in der Du Dich befindest.");
  AddDetail ( ({"wand", "waende"}),
    "Waende? Das einzige, was Du so nennen wuerdest, ist die Stadtmauer.");
  AddDetail ("boden",
    "Du stehst ziemlich sicher, auf den grossen, massiven Steinbloecken.");
  AddDetail ( ({"stadtmauer","mauer"}),
    "Die maechtige Stadtmauer ist aus grossen Steinen zusammengestellt und "+
    "vermittelt ein Gefuehl von Sicherheit, das den Einwohnern dieser Stadt "+
    "wohl ihre fast schon stoische Ruhe verleiht.");
  AddDetail ( ({"stein", "steine", "steinbloecke", "grundlage"}),
    "Grosse, schwere Steinbloecke bilden die Grundlage fuer die maechtige "+
    "Stadtmauer sowie den Boden des Wachweges, auf dem Du stehst. Nur "+
    "wenige Fugen durchsetzen die Mauer.");
  AddDetail ("fugen", "Sie wurden mit Moertel sorgfaeltig ausgefuellt.");
  AddDetail ("moertel", "Weisser Moertel fuellt die Fugen.");
  AddDetail ("treppe",
    "Eine kleine enge Treppe aus Stein fuehrt hinunter in die Stadt.");
  AddDetail ( ({"wachweg","weg"}),
    "Der Weg ist nicht sonderlich breit, stellt Dich "+
    "aber vor keine groesseren Probleme. Sogar die Stadtwachen mit ihrer "+
    "schweren Ruestung koennen hier problemlos ihren Dienst versehen.");
  AddDetail ( ({"dienst","kampfsoldaten","soldaten","wachen","stadtwachen"}),
    "Vielleicht begegnest Du ja einem von ihnen!");
  AddDetail ("wind",
    "Die Mauer schuetzt Dich hier einigermassen vor dem kuehlen Wind.");
  AddDetail ("ueberblick",
    "Du kannst von hier aus die Stadt gut ueberblicken, hast jedoch keine "+
    "Sicht auf ausserhalb, dazu musst Du noch hoeher rauf.");
  AddDetail ( ({"aussicht", "sicht", "ausblick"}),
    "Weiter oben hat man sicher eine prima Aussicht ueber das weite Land.");
  AddDetail ("leiter",
    "Du kannst versuchen, sie zu erklimmen, indem Du nach oben gehst.");
  AddDetail ( ({"aussichtsturm", "turm"}),
    "Der Turm liegt in schwindelerregender Hoehe, der Ausblick von dort "
    "oben muss einfach fantastisch sein. Du kannst ihn ueber die Leiter "
    "erreichen.");
  AddDetail ("hoehe",
    "Als Du zum Turm hinaufschaust, wird Dir ein wenig schwindlig.");
  AddDetail ("land",
    "Das weite Land unter Dir kann man vom Turm aus sicher viel besser "
    "erkennen und ueberblicken.");

  AddItem (NPC "kampfsoldat", REFRESH_DESTRUCT);

  AddExit ("westen", "./wachweg_g9");
  AddExit ("norden", "./wachweg_h8");
  AddExit ("unten", "./room_h9");
  AddExit ("oben", "./wachturm1_h9");
}
