/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL (1996-2005). Preserved as laden_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("In einem grossen Laden");
  set_long(
    "Du stehst etwas verloren in einem riesigen Laden. In den Regalen "
    "liegen Waren aller Art, jedes Eck ist vollgestopft mit diesem und jenem "
    "nuetzlichen Ausruestungsgegenstand, etwa Schwerter, Ruestungen, aber "
    "auch ganz andere Dinge. Hinter der Kasse haengt eine Tafel an der Wand, "
    "ausserdem siehst Du einen seltsamen Kasten aus Holz.\n"
  );
  set_exits(([
    "sueden": "/d/ebene/Midas/room/room_e5",
  ]));
  set_items(([
    "regale": "Die Regale sind voll mit Schwertern, Ruestungen und Krimskrams.\n",
    "kasse": "Eine grosse, alte Kasse. Sie zeigt gerade 407,00 an.\n",
    "kasten": "Yaras alter Kaugummiautomat aus Holz.\n",
    "tafel": "Hinter der Kasse haengt die Ladenordnung an der Wand.\n",
  ]));
  set_reads(([
    "tafel": "Kauf und Verkauf von Ausruestung bei Ladenbesitzer Landar.\n",
  ]));
}
