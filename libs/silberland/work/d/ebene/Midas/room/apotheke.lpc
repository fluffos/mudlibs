inherit "std/room";

#include <properties.h>
#include <bank.h>
#include "files.h"

#define ENTGIFTPREIS 150        // 200
#define ENTFROSCHPREIS 200      // 250
#define WAEGPREIS 5             // 10

nosave object *shaked;
nosave int zeiger, wgeld, mymoney;

void create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich in der Stadtapotheke von Midas. In den Regalen "+
    "stehen viele kleine Flaeschchen und auch alte Schriftrollen, "+
    "eine kleine Lampe spendet dem fensterlosen Raum ein wenig Licht, "+
    "ueberall liegt der Staub. In der Ecke steht eine schon etwas aelter "+
    "wirkende Personenwaage. Ausserdem kannst Du eine kleine Tafel "+
    "an der Wand erkennen.\n"));
  SetProp (P_INT_SHORT, "Apotheke");
  SetProp (P_KILL_NAME, "Blauaeugigkeit");

  AddDetail ( ({"raum", "apotheke", "stadtapotheke"}),
    "Du stehst mittendrin.\n");
  AddDetail ( ({"regal", "regale"}), "Du siehst kleine Flaeschchen mit "+
    "sonderbaren nicht naeher definierbaren\nInhalten sowie einige alte "+
    "Schriftrollen.\n");
  AddDetail ("flaeschchen", "Eines der Flaeschchen scheint eine magische "+
    "Ausstrahlung zu haben. Vielleicht\nist sein Inhalt ja unter "+
    "bestimmten Umstaenden sogar geniessbar?\n");
  AddDetail ( ({"schriftrollen", "rollen"}), "Die Schriftrollen scheinen "+
    "diverse Rezepte zu beinhalten. Eine der Rollen\nkann man sogar noch "+
    "lesen.\n");
  AddDetail ( ({"schriftrolle","rolle"}),
    "Du koenntest versuchen, sie zu lesen.\n");
  AddReadDetail ( ({"schriftrolle","rolle"}),
    "Du faltest eine Schriftrolle auf und liest:\n"+
    "  ______________________________________\n"+
    " / ----------------------------------- /\n"+
    "| Gar manches erst geniessbar wird,   |\n"+
    "| wenn man es schuettelt oder ruehrt. |\n"+
    " \\_____________________________________\\\n");
  AddDetail ("rezepte", "Ohne die Rezepte waere der Apotheker wohl "+
    "ratlos ob der ueberwaeltigenden\nMenge an Chemikalien.\n");
  AddReadDetail ("rezepte", "Leider kannst Du die alte, vergilbte Schrift "+
    "nicht entziffern.\n");
  AddDetail ("chemikalien", "Die Chemikalien scheinen fuer sich allein "+
    "ziemlich gefaehrlich zu sein, es\nkommt wohl darauf an, sie richtig "+
    "zu kombinieren.\n");
  AddDetail ("apotheker", "Der Apotheker scheint gerade nicht da zu sein.\n");
  AddDetail ( ({"lampe","oellampe"}), "Die kleine Oellampe hat sichtlich "+
    "Muehe, etwas Licht und Waerme in die eher\ndunkle Apotheke zu "+
    "bringen.\n");
  AddDetail ("licht", "Das Licht der Oellampe ist sehr fahl und schwach.\n");
  AddDetail ("waerme", "Waerme kann man doch nicht untersuchen. Schon gar "+
    "nicht, wenn kaum eine\nvorhanden ist.\n");
  AddDetail ("fenster", "Der Raum hat keine Fenster.\n");
  AddDetail ("tuer", "Die Tuer ins Freie liegt im Norden. Du siehst ein "+
    "kleines Schild an ihr haengen.\n");
  AddDetail ("schild", "Du kannst es lesen.\n");
  AddReadDetail ("schild", "Auf dem Schild steht: Bin gleich wieder da!\n");
  AddDetail ( ({"wand", "waende"}),
    "An einer der Waende haengt eine Tafel.\n");
  AddDetail ("tafel", "Du kannst sie lesen.\n");
  AddReadDetail ("tafel", sprintf(
          ".--------------------------------------------------.\n"
          "| Wir behandeln Vergiftungen!                      |\n"
          "| Einfach 'entgifte' eingeben! Preis: %3d Muenzen. |\n"
          "|                                                  |\n"
          "| Und jetzt neu: Wundermittel gegen Froschdasein!  |\n"
          "| Mit 'entfrosche' sind Sie wieder normal!         |\n"
          "| Preis wegen Nachfrage gestiegen, %3d Muenzen.    |\n"
          "`--------------------------------------------------'\n",
          ENTGIFTPREIS, ENTFROSCHPREIS) );
  AddDetail ("decke", "Die Decke ist weiss und von einigen Spinnweben "+
    "bedeckt.\n");
  AddDetail ( ({"weben", "spinnweben"}), "Auch wenn Du weisst, dass Spinnen "+
    "nuetzliche Tierchen sind, bist Du ganz froh,\nhier keine in den Weben "+
    "entdecken zu koennen.\n");
  AddDetail ("boden", "Der Boden ist vor allem eines: staubig.\n");
  AddDetail ("staub", "Haaaappttschiiii !!\n"+
    "Als Du im Staub tappst, musst Du kraeftig niesen.\n");
  AddDetail ("inhalt", "Eine nicht naeher definierbare Fluessigkeit.\n");
  AddDetail ("ausstrahlung", bs("Du bist Dir nicht ganz sicher, hast aber "+
    "das Gefuehl als ob irgendetwas Besonderes von dem Inhalt des "+
    "Flaeschchens ausgehen wuerde."));
  AddDetail( ({ "personenwaage","waage" }),
      "Es ist eine schon etwas aeltere Waage aus Metall, die aber immerhin "
      "schon eine Skala mit einem Zeiger statt antiquierter Gewichte "
      "aufweist. Vielleicht kannst Du Dich ja draufstellen? Und wenn, "
      "dann kannst Du es wohl auch noch mit oder ohne Ausruestung versuchen.");
  AddDetail( ({ "skala" }),
      "Die Skala reicht von 0 bis 500 kg. Du staunst.");
  AddSpecialDetail( ({ "zeiger" }),
      "d_zeiger");
  AddDetail( ({ "schlitz" }),
      "Ein kleiner unscheinbarer Schlitz, er ist gerade gross genug fuer "
      "eine Muenze.");
  AddDetail( ({ "ecke","ecken" }),
      "Du erkennst Ecken, wie man in den meisten anderen Raeumen auch findet.");
  AddDetail( ({ "raeume" }),
      "Konzentrier Dich doch lieber auf diesen einen hier!");
  AddDetail( ({ "metall" }),
      "Du betrachtest das Metall genauer und stellst fest, dass es sich "
      "hierbei NICHT um Gold handelt.");
  AddDetail( ({ "gold" }), ([
      0       : "Muss also wohl irgendein anderes Metall sein...\n",
      "zwerg" : "Jammerschade! Du beschliesst, "
                "die Waage nicht mitzunehmen.\n" ]) );
  AddDetail( ({ "gewichte" }),
      "Hae? Was fuer Gewichte? Hier sind doch gar keine!");
  AddReadDetail( ({ "zeiger", "zeiger ab" }),
      symbol_function("d_zeiger", this_object()));

  AddCmd ( ({"ruehre", "ruehr"}), "ruehr");
  AddCmd ( ({"schuettel", "schuettle"}), "schuettel");
  AddCmd ( ({"trink", "trinke"}), "trink");
  AddCmd ("entgifte", "entgifte");
  AddCmd ("entfrosche", "entfrosche");
  AddCmd ( ({"stell","stelle","steig","steige"}), "stelle");
  AddCmd ( ({"wirf","werfe","steck","stecke"}), "wirf");

  AddExit ("norden", "./room_f1");

  shaked = ({ });
  zeiger = wgeld = mymoney = 0;
}

string d_zeiger()
{
  return "Der Zeiger zeigt gerade auf "+zeiger+".\n";
}

int ruehr(string str)
{
  write ("Du findest leider nichts, womit Du umruehren koenntest.\n");
  return 1;
}

int schuettel(string str)
{
  notify_fail ("WAS willst Du denn schuetteln?\n");
  if (!stringp(str)) return 0;
  if (str!="flaeschchen") return 0;

  if (member_array (TP, shaked) == -1)
  {
    write ("Du schuettelst ein kleines Flaeschchen, woraufhin dessen Inhalt "+
      "seine\nFarbe von dunkelrot auf hellviolett veraendert.\n");
    say (TPN+" schuettelt ein kleines Flaeschchen.\n");
    shaked += ({ TP });
  }
  else
  {
    write ("Du schuettelst ein kleines Flaeschchen, woraufhin dessen Inhalt "+
      "seine\nFarbe wieder auf gefaehrlich wirkendes dunkelrot veraendert.\n");
    say (TPN+" schuettelt ein kleines Flaeschchen.\n");
    shaked -= ({ TP });
  }
  return 1;
}

int trink(string str)
{
  notify_fail ("WAS willst Du denn trinken?\n");
  if (!stringp(str)) return 0;
  if (str!="flaeschchen") return 0;

  if (member_array (TP, shaked) == -1)
  {
    write ("Du nimmst einen kraeftigen Schluck aus einem der Flaeschchen.\n"+
      "Ein furchtbarer Schmerz durchzuckt Dich.\n");
    say (TPN+" nimmt einen Schluck aus einem Flaeschchen und windet "+
      "sich\nploetzlich unter grausamen Schmerzen.\n");
    TP->do_damage (50, 0);
  }
  else
  {
    if (!TP->FindPotion(
    "Du trinkst das Flaeschchen erst ein wenig kritisch, aber dann immer "+
    "zuegiger\naus. Du spuerst, dass die Fluessigkeit eine einzigartige "+
    "Wirkung auf Dich\nhat, wie ein Zauber. Ja, tatsaechlich! "+
    "Ein Zaubertrank!\n\n"))
      write ("Du trinkst das Flaeschchen zuegig leer. Es schmeckt "+
        "erfrischend,\naber weiter passiert nichts.\n");
    say (TPN+" trinkt genuesslich ein Flaeschchen leer.\n");
  }
  shaked -= ({ TP });
  return 1;
}

void reset()
{
  int i;
  object env;

  shaked -= ({ 0 });
  for (i=sizeof(shaked)-1; i>=0; i--)
  {
    if (!catch(env=environment(shaked[i])))
      if (environment(shaked[i]) == ME)
        tell_object (shaked[i], "Die Fluessigkeit im Flaeschchen "+
                     "verfaerbt sich wieder dunkelrot.\n");
  }
  shaked = ({ });
  ZENTRALBANK->PayIn(mymoney);
  mymoney=0;
  ::reset();
}

int entgifte(string str)
{
  if (TP->QueryMoney() < ENTGIFTPREIS)
  {
    write("Das kostet "+ENTGIFTPREIS+
        " Muenzen, und soviel hast Du leider nicht.\n");
    return 1;
  }
  else
  {
    TP->AddPoison(-2-random(2));
    if (TP->QueryProp(P_POISON))
      write(bs("Einen Teil Deiner Vergiftung konnten wir kurieren, leider "
          "jedoch nicht alles."));
    else
      write("Es ist uns gelungen, Deine Vergiftung komplett zu heilen!\n");
    TP->AddMoney(-ENTGIFTPREIS);
    mymoney += ENTGIFTPREIS;
  }
  return 1;
}

int entfrosche(string str)
{
  if (TP->QueryMoney() < ENTFROSCHPREIS)
  {
    write ("Das kostet "+ENTFROSCHPREIS+
        " Muenzen, und soviel hast Du leider nicht.\n");
    return 1;
  }
  else
  {
    if (TP->QueryProp(P_FROG))
      write("Du bezahlst und erlangst deine Gestalt als "+
          TP->QueryProp(P_RACESTRING)[0]+" wieder.\n");
    else
      write(bs("Du bezahlst artig und stellst leider etwas zu spaet "
          "fest, dass Du gar kein Frosch warst! Wie aergerlich..."));
    TP->AddMoney(-ENTFROSCHPREIS);
    mymoney += ENTFROSCHPREIS;
    TP->SetProp(P_FROG, 0);
  }
  return 1;
}

int stelle(string str)
{
  object ob;
  string wie,wohin;
  int total;

  notify_fail("Was, wie, wo, worauf willst Du etwas oder Dich stellen?\n");
  if (!str) return 0;
  if (sscanf(str, "%sauf %s",wie,wohin) != 2) return 0;
  if (wohin != "waage" && wohin!="auf personenwaage") return 0;
  notify_fail(bs("Du kannst Dich nur mit oder ohne Ausruestung "
      "auf die Waage stellen, nicht aber \""+wie+"\"!"));
  if (wie=="mit ausruestung ") total=1;
  else if (wie=="ohne ausruestung ") total=0;
  else if (wie=="") total=1;
  else return 0;

  if (wgeld < WAEGPREIS) {
    write(bs("Du stellst Dich auf die Waage, aber nichts passiert. Ob "
        "das etwas mit dem kleinen Schlitz auf sich hat, der ueber der "
        "Skala der Waage angebracht ist?"));
    say(TP->Name()+" stellt sich auf die Waage, aber nichts passiert.\n");
  }
  else
  {
    // Waegen...
    if (zeiger) {
      write(bs((total ? "Du stellst Dich mitsamt Deiner Ausruestung"
          : "Du legst Deine Ausruestung beiseite und stellst Dich")+" auf "
          "die Waage. Der Zeiger bewegt sich jedoch keinen Millimeter. "
          "Offenbar ist er irgendwie arretiert."));
      say(TP->Name()+" stellt sich auf die Waage, aber nichts passert.\n");
    }
    else {
      write(bs((total ? "Du stellst Dich mitsamt Deiner Ausruestung"
          : "Du legst Deine Ausruestung beiseite und stellst Dich")+" auf "
          "die Waage. Augenblicklich verstellt sich der Zeiger und pendelt "
          "sich schliesslich auf einen Wert ein."));
      say(TP->Name()+" stellt sich auf die Waage.\n"
          "Langsam pendelt sich deren Zeiger auf einen Wert ein.\n");
      zeiger = ((total ? TP->QueryProp(P_TOTAL_WEIGHT)
                       : TP->QueryProp(P_WEIGHT))+500) / 1000;
    }
  }
  return 1;
}

void reset_waage()
{
  zeiger=0;
  wgeld=0;
  tell_room(this_object(),
      bs("Du hoerst ein deutliches KLACK! von der Waage und siehst gerade "
          "noch, wie sich der Zeiger wieder ganz nach links bewegt."));
}

int wirf(string str)
{
  int n;
  string wohin;
  if (!str) return 0;
  if (str=="muenze in schlitz" ||
      (str=="muenze ein" &&
       (query_verb()=="wirf" || query_verb()=="werfe")))
    n=1;
  else {
    if (sscanf(str, "%d muenzen %s", n, wohin) != 2) return 0;
    if (wohin != "ein" && wohin != "in schlitz") return 0;
  }
  if (TP->QueryMoney() < n)
    return write("Aber soviel Geld hast Du ja gar nicht bei Dir!\n"), 1;
  if (!n)
    return write("Findest Du nicht, dass das ein bisschen wenig ist?\n"), 1;
  if (wgeld >= WAEGPREIS)
    return write("Der Schlitz ist im Moment blockiert.\n"), 1;
  TP->AddMoney(-n);
  wgeld += n;
  mymoney += n;
  if (n==1)
    write("Du wirfst eine Muenze in den Schlitz ein.\n");
  else
    write("Du wirfst "+n+" Muenzen in den Schlitz ein.\n");
  say(TP->Name()+" wirft etwas Geld in eine Waage ein.\n");
  if (wgeld >= WAEGPREIS) {
    write("Du hoerst ein leises Klicken.\n");
    call_out("reset_waage", 25);
  }
  else
    write("Nichts passiert.\n");
  return 1;
}

