/*
** Seitengasse in Midas  (w) Woody@SL
** ---
** 1997-09-07  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem kleinen Seitenweg, der hier eine Biegung "
    "von Westen nach Norden macht. Suedlich vor Dir erhebt sich die "
    "praechtige Kirche von Midas in schwindelerregende Hoehen.");

  SetProp (P_INT_SHORT, "Seitenweg in Midas");

  // DETAILS START
  AddDetail ( ({"seitenweg","weg"}), "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ( ({"morgensonne", "sonne"}),
      "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ( ({"hauptstrasse", "strasse"}),
    "Die Hauptstrasse befindet sich weiter im Norden.");
  AddDetail ( ({"biegung"}),
    "Wie gesagt, der Weg weicht hier den Gebaeuden und macht eine Biegung "+
    "von Westen nach Norden.");
  AddDetail ( ({"gebaeude"}),
    "Einerseits die Kirche im Sueden, andererseits Rathaus und Gilde in "+
    "unmittelbarer Naehe.");
  AddDetail ( ({"naehe"}),
    "Gar nicht so fern! Schau Dich einfach um...");
  AddDetail ( ({"kirche"}),
    "Die prachtvolle Kirche erhebt sich vor Dir im Sueden. Du kannst am "+
    "Kirchenschiff huebsche bunte Glasfenster erkennen.");
  AddDetail ( ({"kirchenschiff", "schiff", "innenraum"}),
    "Kirchenschiff nennt man den langgestreckten Innenraum einer Kirche, "+
    "in dem die meisten Leute Platz finden.");
  AddDetail ( ({"leute"}),
    "Ganz normale Leute halt.");
  AddDetail ( ({"platz"}),
    "Wuerdest Du nicht soviel brauchen, waere mehr davon hier!");
  AddDetail ( ({"fenster", "glasfenster"}),
    "Das Glas der Fenster schillert in den buntesten Farben.");
  AddDetail ( ({"glas"}),
    "Normales Glas, aber bunt, in allen Farben des Lichts.");
  AddDetail ( ({"farben"}),
    "Auf Anhieb erkennst Du nur rot, gruen, blau und gelb, aber irgendwie "+
    "scheinen es doch wesentlich mehr Farben zu sein.");
  AddDetail ( ({"licht"}),
    "Licht ist einfach da, weil die Sonne scheint.");
  AddDetail ( ({"rathaus"}),
    "Derzeit etwa nordwestlich von Dir.");
  AddDetail ( ({"gilde"}),
    "Derzeit etwa nordoestlich von Dir.");
  AddDetail ( ({"hoehen"}),
    "Wahrhaft schwindelerregend, aber noch hoeher ist der Kirchturm, der "+
    "sich weiter oestlich befindet, vielleicht kann man ja dort irgendwie "+
    "rauf, um den vermutlich ueberwaeltigenden Ausblick zu geniessen?");
  AddDetail ( ({"kirchturm", "turm"}),
    "Er befindet sich im oestlicheren Teil der Kirche.");
  AddDetail ( ({"ausblick"}),
    "Von hier aus nicht so dolle... vielleicht solltest Du einen hoeheren "+
    "Punkt aufsuchen, wenn es das ist, was Du willst?");
  AddDetail ( ({"punkt"}),
    "Zum Beispiel den Kirchturm?");
  // DETAILS END

  AddExit ("norden", "./room_d6");
  AddExit ("westen", "./room_c7");
}
