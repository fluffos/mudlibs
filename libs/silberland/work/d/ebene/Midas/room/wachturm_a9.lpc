#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Wachturm");
  SetProp (P_INT_LONG,
    "Du erklimmst den Wachturm ueber die kleine Treppe. Sofort offenbart "+
    "sich Dir ein wundervoller Blick ueber das weite Land. Direkt unter "+
    "Dir kannst Du einen kleinen Park erkennen, den sogenannten Anfaenger"+
    "park, in dem sich Anfaenger in ihren ersten Kaempfen erproben "+
    "koennen. Etwas weiter noerdlich siehst Du in der Ferne den "+
    "beruehmten Silberwald, waehrend Du noch ferner im Sueden das weite "+
    "Meer erkennen kannst. Dein Atem stockt bei diesem wundervollen "+
    "Ausblick, und fuer einen Moment vergisst Du, wie eng und unbequem "+
    "es auf diesem Turm doch eigentlich ist...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"turm", "wachturm"}),
    "Du stehst auf selbigem und geniesst den Ausblick.");
  AddDetail ( ({"boden"}),
    "Der Boden wurde mit Steinbloecken ausgelegt.");
  AddDetail ( ({"bloecke", "steinbloecke"}),
    "Wer die wohl hier hochgebracht hat? Und wie sie wohl getragen werden?");
  AddDetail ( ({"ausblick", "blick", "land"}),
    "Dein Blick schweift ueber das weite Land, und Du geniesst diesen "+
    "herrlichen Ausblick ueber den Silberwald, die Ebene und das "+
    "bezaubernde Feenschloss.");
  AddDetail ( ({"silberwald", "wald"}),
    "Der Silberwald ist der wohl bekannteste Wald im ganzen Land. Er "+
    "verkoerpert all das, was man sich von einem Wald erwartet - "+
    "vertrauemte Atmosphaere, ein kleiner, wegsamer Pfad und sogar ein "+
    "kleines Baechlein, das den Pfad Richtung Gebirge leise plaetschernd "+
    "begleitet.");
  AddDetail ( ({"baechlein", "bach"}),
    "Das kleine Baechlein besticht durch seine Vertraeumtheit. Das "+
    "Wasser scheint herrlich klar zu sein, kommt es doch aus den "+
    "Hoehen des Gebirges...");
  AddDetail ( ({"wasser"}),
    "Das Wasser des kleinen Baechleins plaetschert leise vor sich hin.");
  AddDetail ( ({"anfaengerpark", "park"}),
    "Der kleine Park direkt unter Dir ist sehr uebersichtlich angeordnet. "+
    "Du kannst viele kleine Tierchen erkennen, unter anderem Igel, "+
    "Schmetterlinge, Maeuse, emsige Ameisen und sogar einen roten "+
    "Feuersalamander. Ausserdem lungert irgendwo in einer Ecke ein "+
    "Landstreicher herum.");
  AddDetail ( ({"ameisen", "feuersalamander", "igel", 
                "landstreicher", "maeuse", "schmetterlinge", 
                "tierchen"}),
    "Die Einwohner des Anfaengerparkes kannst Du sicher besser "+
    "kennenlernen, wenn Du sie einfach mal besuchst.");
  AddDetail ( ({"meer"}),
    "Das Meer erstreckt sich weit im Sueden bis hinter den Horizont.");
  // DETAILS END

  // EXITS START
  AddExit ("unten", "die kleine Treppe runter#./wachweg_a9");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
