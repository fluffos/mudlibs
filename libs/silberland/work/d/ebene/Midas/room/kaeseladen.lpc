#include "files.h"

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <verben.h>
#include <moving.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"

#include "kaeseladen.h"

string *forscher, *verwarnt;
int    schatz;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Kaeseladen");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem kleinen Kaeseladen. An den Waenden befinden "
    "sich hohe Regale, in welchen maechtige Kaeselaibe lagern. Gegenueber der "
    "Eingangstuer befindet sich eine kleine Theke. Der Raum besitzt nur ein "
    "kleines Fenster, damit der Kaese nicht im hellen Licht reifen muss "
    "und sich durch das Licht verfaerbt. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );


  AddDetail( ({"eingang"}) ,
    "Durch den Eingang hast Du den Kaeseladen betreten."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus einfachen Steinen. Sie glaenzen ein wenig feucht, "
    "wohl wegen der hohen Luftfeuchtigkeit. "
  );

  AddDetail( ({"luftfeuchtigkeit","feuchtigkeit"}) ,
    "Hier herrscht immer eine bestimmte Luftfeuchtigkeit, damit die Kaese "
    "reifen koennen und letztlich eine kleine Koestlichkeit werden. Auf dem "
    "Boden kann man den Glanz der niedergeschlagenen Luftfeuchtigkeit erkennen."
  );

  AddDetail( ({"glanz"}) ,
    "Durch die hohe Luftfeuchtigkeit glaenzt der Boden an einigen Stellen "
    "etwas. "
  );

  AddDetail( ({"stellen"}) ,
    "An vielen Stellen hat sich die Luftfeuchtigkeit am Fussboden "
    "niedergeschlagen."
  );

  AddDetail( ({"fussboden"}) ,
    "Der Fussboden besteht aus Steinen, welche nahtlos aneinander passen."
  );

  AddDetail( ({"naht"}) ,
    "Zwei der Steine scheinen nicht ganz so exakt aneinanderzupassen, so "
    "dass ein winziger Spalt zwischen ihnen herrscht. "
  );

  AddDetail( ({"spalt"}) ,
    "Der Spalt ist so gering, dass man ihn kaum sieht. Trotzdem scheint dort "
    "das niedergeschlagene Wasser zu versickern. "
  );

  AddDetail( ({"wasser"}) ,
    "Das Wasser versickert ganz langsam in dem Spalt. Wenn sich Albin nicht "
    "vorsieht, wird der Spalt schnell groesser und dann muss der Boden "
    "neu verfugt werden. "
  );

  AddDetail( ({"koestlichkeit"}) ,
    "Diese Kaese schmecken alle sicherlich koestlich. "
  );

  AddDetail( ({"decke"}) ,
    "Auch die Decke ist unverkleidet und Du blickst auf blanke Steine. "
  );

  AddDetail( ({"wand","waende","waenden"}) ,
    "An den Waenden stehen Regale ueber Regale, in welchen die koestlichsten "
    "Kaeselaibe lagern. Hinter den Regalen erkennst Du die Steinmauern des "
    "Raumes. "
  );

  AddDetail( ({"kaeseladen","raum","raumes","laden"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"eingangstuer","tuer","tuere"}) ,
    "Durch diese Tuer bist Du hereingekommen, und durch diese Tuer kannst "
    "Du den Laden auch wieder verlassen. "
  );

  AddDetail( ({"fenster"}) ,
    "Das Fenster befindet sich direkt ueber der Tuer. Es ist nur ein kleines "
    "Fenster, das wenig Licht hereinlaesst, so dass es in dem Laden eher "
    "schummerig ist. Anscheinend ist das aber gut fuer die Kaesereifung. "
  );

  AddDetail( ({"kaesereifung","reifung"}) ,
    "Hier auf den Regalen reifen die Kaese, bis sie zu einer wahren "
    "Koestlichkeit geworden sind. "
  );

  AddDetail( ({"licht"}) ,
    "Hier ist es immer recht schummerig, damit die Kaesereifung ungestoert "
    "stattfinden kann und durch das Licht keine Flecken auf den Kaese kommen. "
  );

  AddDetail( ({"fleck","flecken"}) ,
    "Weil es so dunkel ist, haben die Kaese keine Flecken. Auch der Raum "
    "und die Regale sind so sauber, dass Du nirgends Flecken siehst. "
  );

  AddDetail( ({"kaese","kaeselaibe","laib","kaeselaib","laibe"}) ,
    "Auf den Regalen liegen unzaehlige Kaeselaibe, die einen herrlichen Duft "
    "verbreiten. Auf jedem der Kaeselaibe kannst Du ein kleines Schildchen "
    "erkennen. "
  );

  AddDetail( ({"schildchen","schild","schilder"}) ,
    "Auf ihnen stehen lauter Namen. Offensichtlich sind alle diese Kaese "
    "vorbestellt. "
  );

  AddReadDetail( ({"schildchen","schild","schilder"}) ,
    "Auf ihnen stehen lauter Namen. Offensichtlich sind alle diese Kaese "
    "vorbestellt. "
  );

  AddDetail( ({"duft"}) ,
    "Du kannst ihn riechen."
  );

  AddDetail( ({"regal","regale","regalen"}) ,
    "In den Regalen an den Waenden lagern die ganzen Kaeselaibe. Das Regal "
    "besteht aus stabilem Eichenholz, allerdings haben diese Regale keine "
    "Regalboeden, sondern Lattenroste, auf den der Kaese liegt. "
  );

  AddDetail( ({"steine","stein","steinen","steinmauer","steinmauern"}) ,
    "Durch die dicken Waende aus Stein bleibt dieser Raum immer gleichmaessig "
    "kuehl und feucht, so dass der Kaese perfekt reifen kann. "
  );

  AddDetail( ({"eichenholz"}) ,
    "Die Regale muessen aus stabilem Holz sein, damit sie unter der Last "
    "der schweren Kaeselaibe nicht zusammenbrechen. "
  );

  AddDetail( ({"holz"}) ,
    "Eichenholz ist sehr stabil, deswegen wurden auch die Regale aus diesem "
    "Holz gemacht. "
  );

  AddDetail( ({"last"}) ,
    "So ein ganzer Kaeselaib ist ganz schoen schwer."
  );

  AddDetail( ({"lattenroste"}) ,
    "Damit auch von unten Luft an die Kaese gelangen kann, haben die Regale "
    "keine massiven Boeden, sondern Lattenroste. An einem der Lattenroste "
    "faellt Dir ein grosses Astloch auf. "
  );

  AddDetail( ({"luft"}) ,
    "Die brauchst Du zum atmen."
  );

  AddDetail( ({"boeden","regalboeden"}) ,
    "Diese Regale haben keine Regalboeden, auch wenn Du noch solange danach "
    "suchst. "
  );

  AddDetail( ({"theke"}) ,
    "Hier bedient Albin seine Kundschaft. Eigentlich ist es ja nur ein "
    "Tisch. "
  );

  AddDetail( ({"tisch"}) ,
    "Albin hat sich einen einfachen Tisch als Theke in seinen Laden gestellt. "
  );

  AddSpecialDetail( ({"kundschaft"}) , "detail_kundschaft" );

  AddDetail( ({"grosses astloch","astloch"}) ,
    "Naja, ist halt ein grosses Astloch. Kommt selbst bei Eichen ab und zu "
    "mal vor. Neben dem grossen Astloch kannst Du noch ein kleines Astloch "
    "entdecken. "
  );

  AddDetail( ({"eiche","eichen"}) ,
    "Hier sind keine Eichen, nur noch die Regale und der Tisch sind aus "
    "Eichenholz. "
  );

  AddDetail( ({"kleines astloch"}) ,
    "Seltsam, zwei Astloecher direkt nebeneinander, ein grosses und ein "
    "kleines. "
  );

  AddDetail( ({"astloecher"}) ,
    "An einem der Regale erkennst Du zwei Astloecher, ein grosses und ein "
    "kleines. Das ist eher ungewoehnlich, da es sich um Eichenholz handelt. "
  );

  AddDetail( ({"albin"}) ,
    "Albin scheint gerade nicht da zu sein. "
  );

  AddSpecialDetail( ({"namen","name"}), "detail_namen");

  AddDetail( ({"zement","fugen"}) ,
    "Die Fugen sind mit einem ganz feinen Zement ausgefugt, so dass man sie "
    "fast gar nicht erkennen kann. Aber ist da nicht ein feiner Haarriss "
    "um einen der Steine herum? "
  );

  AddSpecialDetail( ({"haarriss"}) , "detail_haarriss" );

  AddSpecialDetail( ({"versteck","geheimversteck"}) , "detail_versteck" );

  AddSmell( ({DEFAULT_SMELL,"duft","geruch"}) ,
    "Hier riecht es nach allen moeglichen Kaesesorten. Einfach herrlich, "
    "dieser wuerzige Geruch. "
  );

  AddSound( ({DEFAULT_SOUND}) ,
    "Hier ist es absolut still."
  );

  AddCmd( ({"heb","hebe"})            , "cmd_heben");
  AddCmd( CMD_NEHMEN                  , "cmd_nehmen");
  AddCmd( ({"verfug","verfuge"})      , "cmd_verfugen");
  AddCmd( ({"kost","koste",
            "test","teste",
            "probier","probiere"})    , "cmd_kosten" );

  AddItem(NPC "albin", REFRESH_DESTRUCT);

  AddExit( "sueden", "./room_g3");

  forscher  = ({ });
  verwarnt  = ({ });

  schatz    = 1;
}

void reset()
{
  ::reset();

  forscher  = ({ }) ;
  verwarnt  = ({ }) ;

  schatz    = 1;
}

int check_if_living(object ob)
{
  if(interactive(ob) && (ob->QueryProp(P_INVIS))) return 0;
  if(interactive(ob)) return 1;
  return 0;
}

string detail_haarriss(string str)
{
  string s;

  s = "Tatsaechlich! Da ist ein ganz feiner Haarriss um einer der Steine. "
      "Ob da wohl ein Geheimversteck von Albin ist?";

  if(member(forscher,getuid(TP)) == -1) forscher += ({ getuid(TP) });

  WRITELOG(TPUID+" findet den Haarriss");
  return BS(s);
}

string detail_versteck(string str)
{
  string s;

  if(member(forscher,getuid(TP)) == -1)
  {
    s = "Du siehst hier kein "+CAP(str)+".";
  }
  else
  {
    s = "Wenn es wirklich ein Geheimversteck ist, was mag dann wohl darin "
        "versteckt sein?";
  }

  return BS(s);
}

string detail_kundschaft(string str)
{
  string s;
  object *players;

  players = filter_array(all_inventory(TO), "check_if_living") - ({TP});

  switch(sizeof(players))
  {
    case 0 :
      s = "Du bist alleine im Laden.";
      break;

    case 1 :
      s = "Ausser Dir ist noch "+players[0]->name()+" da.\n";
      break;

    default :
      s = "Ausser Dir sind noch "+
            LW(map_objects(players,"name"))+" im Laden.\n";

      break;
  }

  return BS(s);
}

string detail_namen(string str)
{
  string s;

  switch(KMASTER->QueryCheese(getuid(TP)))
  {
    case 0 :
    case 3 :
      s = "Du studierst einige der Namen, von denen Du keinen kennst. Dein "
          "Name ist auch nicht dabei. ";
      break;

    case 1 :
      s = "Du hattest doch einen Kaese bestellt. Ist der denn immer noch "
          "nicht fertig? Wie lange dauert das denn noch? ";
      break;

    case 2 :
      s = "Da! Da traegt doch ein Schildchen Deinen Namen. Das ist bestimmt "
          "Dein Kaese. Nimm ihn am besten gleich mit.";
      break;

    default :
      s = "Also da ist wohl in der Produktion was schiefgelaufen. Am besten "
          "beschwerst Du Dich gleich bei der Geschaeftsfuehrerin. Das ist "
          "Ronja. ";
      break;
  }

  return BS(s);
}

int cmd_kosten(string str)
{
  notify_fail("\n");

  if(!str || str == "") return 0;
  if(!(str == "kaese"         ||
       str == "ziegenkaese"   ||
       str == "schafskaese"   )) return 0;

  tell_object(TP,"Frag halt Albin, ob er Dir ein Stueck Kaese gibt.\n");

  WRITELOG(TPUID+" versucht einen Kaese zu kosten");

  return 1;
}

int cmd_heben(string str)
{
  object albin, ob;

  notify_fail("Was moechtest Du anheben?\n");

  if(!str || str == "") return 0;

  if(str == "laib an"         ||
     str == "laib hoch"       ||
     str == "kaese an"        ||
     str == "kaese hoch"      ||
     str == "kaeselaib an"    ||
     str == "kaeselaib hoch"  ||
     str == "kaeselaibe an"   ||
     str == "kaeselaibe hoch"  )
  {
    tell_object(TP,BS("Du hebst einen der Kaeselaibe an. Puuh, sind die "
                      "schwer. Albin muss sehr stark sein."));
    tell_room(TO,BS(TPN+"hebt einen der Kaese an. Ob "+TPN+" Kaesestemmen "
                    "trainiert? Sieht zumindest recht albern aus."),({TP}) );
    if(present("albin",TO))
    {
      tell_room(TO,BSI("He, was soll denn das? Leg gefaelligst den Kaese "
                       "wieder hin.","Albin schimpft: ") );
    }
    return 1;
  }

  if(str == "stein an"         ||
     str == "stein hoch"        )
  {
    if(member(forscher,getuid(TP)) == -1)
    {
      tell_object(TP,"Ja, welchen denn bloss?\n");
      return 1;
    }

    if(albin=present("albin",TO))
    {
      if(member(verwarnt,getuid(TP)) == -1)
      {
        tell_object(TP,
          BSI("He, was machst Du da? Lass das gefaelligst sein, "
              "sonst werde ich ernsthaft boese!","Albin sagt erzuernt: "
        ));
        verwarnt += ({ getuid(TP) });
        WRITELOG(TPUID+" wird von Albin verwarnt");
      }
      else
      {
        tell_object(TP,"Albin hat Dich bemerkt und greift Dich an.\n");
        albin->Kill(TP);
        WRITELOG(TPUID+" wird von Albin angegriffen");
      }

      return 1;
    }

    if(schatz)
    {
      tell_object(TP,
        BS("Du schaust Dich verstohlen um, ob Dich auch keiner "
           "sieht, hebst blitzschnell den Stein hoch und nimmst "
           "alles darunter an dich. "
      ));
      schatz = 0;
      TP->AddMoney(150+random(150));
      "/obj/gemmaster"->DistributeGem(2,2,1,TP);
      WRITELOG(TPUID+" findet Albins Schatz");
    }
    else
    {
      tell_object(TP,
        BS("Du schaust Dich verstohlen um, ob Dich auch keiner sieht "
           "hebst blitzschnell den Stein hoch und schaust enttaeuscht "
           "in eine leere Kuhle."
      ));
      WRITELOG(TPUID+" findet Albins Schatz nicht");
    }

    if(objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, TP))) {
      ob->StashFound();
    }

    return 1;
  }

  return 0;
}

int cmd_verfugen(string str)
{
  notify_fail("Was mochtest Du verfugen?\n");

  if(!str || str == "") return 0;
  if(!(str == "boden"         ||
       str == "fussboden"         )) return 0;

  tell_object(TP,
    BS("Noch muss der Boden nicht neu verfugt werden. Ausserdem hast "
        "Du doch gar keinen solch feinen Zement dabei, wie er dafuer "
        "noetig waere.")
  );

  tell_room(ENV(TP),CAP(TPN)+" gruebelt ueber etwas nach.\n",({TP}) );

  return 1;
}


int cmd_nehmen(string str)
{
  string sp,so;
  object kaese;

  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "kaese"         ||
       str == "kaeselaib"     )) return 0;

  switch(KMASTER->QueryCheese(getuid(TP)))
  {
    case 0 :
    case 3 :
      sp = "Du hattest ja ueberhaupt noch keinen Kaese bestellt. Diese Kaese "
           "hier gehoeren alle anderen Leuten. Lass also die Finger davon. ";
      so = CAP(TPN)+" schaut luestern auf die Kaese. ";
      break;

    case 1 :
      sp = "Du hattest doch einen Kaese bestellt. Ist der denn immer noch "
           "nicht fertig? Wie lange dauert das denn noch? Diese hier "
           "gehoeren alle anderen Leuten, lass besser die Finger davon. ";
      so = CAP(TPN)+" schaut luestern auf die Kaese. ";
      break;

    case 2 :
      kaese = clone_object(CHEESE "kaese");
      if(ME_TOO_HEAVY==kaese->move(TP,M_GET|M_SILENT))
      {
        sp = "So ein Kaeselaib ist doch ganz schoen schwer. Vielleicht "
             "solltest Du erst etwas ablegen? ";
        so = CAP(TPN)+" versucht einen der Kaese anzuheben, schafft es aber "
             "nicht. ";
        kaese->remove();
      }
      else
      {
        sp = "Da! Einer der Kaese ist fuer Dich. Du nimmst ihn sogleich an "
             "Dich.";
        so = CAP(TPN)+" nimmt sich einen der Kaese. ";
        KMASTER->SetCheese(getuid(TP),file_name(kaese));
        kaese->Customize(KMASTER->QueryMilkType(getuid(TP)));
        WRITELOG(TPUID+" nimmt sich einen Kaese : "+file_name(kaese));
      }

      break;

    default :
      sp = "Also da ist wohl in der Produktion was schiefgelaufen. Am besten "
           "beschwerst Du Dich gleich bei der Geschaeftsfuehrerin. Das ist "
           "Ronja. ";
      so = CAP(TPN)+" schaut ziemlich verdutzt drein.";
      WRITELOG("Kaese nehmen ging schief");
      break;
  }

  tell_object(TP,BS(sp));
  tell_room(TO,BS(so),({TP}));
  return 1;
}


public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
