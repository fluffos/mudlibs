#pragma strict_types

#include <v_compiler.h>
#include <wizlevels.h>


public void create() { seteuid(getuid(this_object())); return; }
public string Validate(string file) {return 0; }
public string CustomizeObject() { return 0; }
public mixed compile_object(string file) { return 0; }

public mixed QueryObjects() { 
  string s;
   if ((this_player()) && (this_interactive()) && 
    (this_player()==this_interactive()) && 
    (getuid(this_player())=="woody")) return ({});
   s=sprintf("** Scan %s, %s%s%s%s\n",
       file_name(this_object())[0..<18],
       (query_verb()?"<"+query_verb()+"> ":""),
       (this_player()?file_name(this_player()):"???"),
       ((previous_object()!=this_player())?
	  " PO="+file_name(previous_object()):""),
       ((this_interactive()&&(this_interactive()!=this_player()))?
	" TI="+file_name(this_interactive()):""));
    if (find_player("woody"))
      tell_object(find_player("woody"),s); 
    write_file("/d/ebene/log/scan.log",sprintf("%s: %s",
       (dtime(time())[5..]), s[8..]));
    /*
    if ((this_interactive()) && 
	(((!IS_QUESTWIZ(this_interactive()) ) && 
	 (!member((["berx","joscherl","verdandi","fidget","mond"]),
		  getuid(this_interactive())))) ||
	 (member((["feyaria","lamuerte"]),getuid(this_interactive())))))
                 this_interactive()->disconnect();
	//	 remove_interactive(this_interactive());
    */
    return ({});
}
