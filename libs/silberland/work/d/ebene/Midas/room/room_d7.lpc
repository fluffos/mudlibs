inherit "/catalog/room";

void create() {
  ::create();
  set_short("Seitenweg in Midas");
  set_long(
    "Du befindest Dich auf einem kleinen Seitenweg, der hier eine Biegung "
    "von Westen nach Norden macht. Suedlich vor Dir erhebt sich die "
    "praechtige Kirche von Midas in schwindelerregende Hoehen.\n"
  );
  set_exits(([
    "norden": "/d/ebene/Midas/room/room_d6",
    "westen": "/d/ebene/Midas/room/room_c7",
  ]));
  set_items(([
    "kirche": "Die praechtige Kirche von Midas erhebt sich im Sueden.\n",
  ]));
}
