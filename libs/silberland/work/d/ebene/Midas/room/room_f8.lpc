inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

string d_uhr();

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG, bs(
    "Du stehst auf einem grossen, mit Kieselsteinchen bedeckten Vorplatz "+
    "vor einer praechtigen Kirche riesigen Ausmasses. Der Kirchturm ragt "+
    "weit empor und wird von einer kunstvoll gearbeiteten Uhr mit "+
    "sorgfaeltig aus schwarzem Gusseisen gearbeiteten Ziffern geschmueckt. "+
    "Ein riesiges Tor an einer Seite der Kirche gewaehrt Einlass in das "+
    "wundervolle Gebaeude. Ausserdem kannst Du auf der Mitte des "+
    "Vorplatzes einen Baum erkennen, der offenbar besonders gehegt und "+
    "gepflegt wird. Auf dem kleinen Rasenfleck unter dem Baum ist ein "+
    "Schild im Boden befestigt." ));

  SetProp (P_INT_SHORT, "Vorplatz in Midas");

  AddDetail ( ({"kieselweg","weg"}), "Er fuehrt nach Osten hin.\n");
  AddDetail ( ({"seite","tor","kirchentor"}), bs(
    "Ein riesiges Kirchentor, das sich an einer Seite der Kirche "+
    "befindet, ermoeglicht Dir das Betreten derselbigen."));
  AddDetail ( ({"vorplatz","platz"}), "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus unzaehligen kleinen Kieselsteinchen.\n");
  AddDetail ( ({"kiesel","kieselsteinchen","steinchen","schritt"}),
    "Die Kieselsteinchen knirschen unter Deinem Schritt.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ( ({"ausmass", "kirche", "gebaeude","erscheinung"}),
    bs("Die gewaltige Kirche bietet eine beeindruckende Erscheinung, "+
    "ihr Kirchturm ragt weit empor, und das riesige Kirchenschiff "+
    "ist von prachtvollen Glasfenstern verziert, die in allen "+
    "Farben schillern."));
  AddDetail ( ({"glasfenster","fenster"}), bs(
    "Die Glasfenster schillern in allen Farben des Lichts."));
  AddDetail ( ({"farben","licht"}), bs(
    "Du zaehlst die Farben und stellst fest, dass es etwa 16,7 Millionen "
    "sein muessen."));
  AddDetail ( ({"kirchenschiff","schiff","einwohner"}), bs(
    "Das riesige Kirchenschiff fasst bestimmt saemtliche Einwohner "
    "von Midas."));
  /*
  AddDetail ( ({""}), bs(
    ""));
  AddDetail ( ({""}), bs(
    ""));
  AddDetail ( ({""}), bs(
    ""));
  */
  AddDetail ( ({"kirchturm", "turm", "punkt"}),
    bs("Der Kirchturm ist wohl der hoechste Punkt in ganz Midas und "+
    "muss einen wunderbaren Ueberblick ueber die Stadt bieten. Ausserdem "+
    "ist eine praechtige Uhr in den Turm gearbeitet."));
  AddDetail ( ({"kirchturmuhr", "uhr"}),
    bs("Die Uhr auf dem Kirchturm ist aeusserst kunstvoll gearbeitet. "+
    "Die Zeiger sowie die Ziffern sind sehr sauber aus schwarzem "+
    "Gusseisen gearbeitet. Du kannst die Uhr sogar lesen und so die "+
    "Zeit ablesen..."));
  AddDetail ("zeit", "Die Zeit vergeht... wie, das zeigt Dir die in den "+
    "Turm eingearbeitete Uhr.");
  AddDetail ( ({"zeiger","stundenzeiger","minutenzeiger"}),
    bs("Stunden- und Minutenzeiger der Kirchturmuhr sind etwas "+
    "schnoerkelig und aus schwarzem Gusseisen gearbeitet. Sie zeigen "+
    "zuverlaessig die Zeit an, allerdings sind sie sehr weit oben am "+
    "Turm und daher nicht mehr ganz so leicht abzulesen."));
  AddDetail ( ({"eisen","gusseisen"}),
    "Schwarzes, schoen gearbeitetes Gusseisen, mehr ist es nicht.\n");
  AddDetail ( ({"ziffern", "ziffernblatt"}),
    bs("Die Kirchturmuhr hat eigentlich nur vier Ziffern, naemlich 3, "+
    "6, 9 und 12, aber fuer die anderen Stunden sind kleine Markierungen "+
    "in das Ziffernblatt eingearbeitet."));
  AddDetail ( ({"markierungen"}), bs(
    "Sie sind am Ziffernblatt fuer die nicht restfrei durch drei "
    "teilbaren Stunden eingearbeitet."));
  AddDetail ( ({"stunden","stunde"}),
    "Welche es geschlagen hat, zeigt die Kirchturmuhr.\n");
  AddReadDetail ( ({"uhr", "zeit"}),
    "Eine Uhr ist doch kein Buch! Aber versuchs mal mit AB-lesen!");
  AddReadDetail ( ({"uhr ab", "zeit ab"}), #'d_uhr);
  AddDetail (({"baum", "linde", "mitte"}),
    bs("Der Baum scheint besonders gehegt und gepflegt zu werden, ebenso "+
    "wie der Rasenfleck unter ihm, in dem ein kleines Holzschild gesteckt "+
    "ist. Bei naeherer Betrachtung stellst Du fest, dass es sich bei dem "+
    "Baum um eine Linde handelt, die bestimmt schon an die hundert Jahre "+
    "alt ist."));
  AddDetail (({"jahr","jahre"}),
    "Wie schnell doch so ein Jahr vergeht! Aber hundert...?\n");
  AddDetail (({"rasenfleck", "rasen", "fleck", "gruen"}),
    bs("Der kleine Rasenfleck, auf dem der Baum steht, strahlt in "+
    "sattem, aeusserst gepflegten Gruen. Ein kleines Holzschild ist "+
    "hier in den Boden gesteckt."));
  AddDetail (({"holzschild", "schild"}),
    "Ein kleines Schild aus Holz, auf dem etwas geschrieben steht.\n");
  AddReadDetail (({"holzschild", "schild"}),
    "Auf dem kleinen Schild steht: 'Symbol des Lebens'\n");
  AddDetail (({"holz","brett","holzbrett"}),
    "Eigentlich ein gewoehnliches Holzbrett, nix besonderes.\n");

  AddSound (DEFAULT_SOUND,
    "Die Kieselsteinchen knirschen unter Deinem Schritt.\n");

  AddExit ("nordosten", "./room_g7");
  NewDoor ("kirche", "./kirche",
    ({"kirchentor", "tor"}),
    ({
      D_LONG, "Das gewaltige Kirchentor bietet Einlass in das "+
        "praechtige Gebaeude.\n",
      D_GENDER, NEUTER,
      D_SHORT, "Ein %ses Kirchentor.",
      D_NAME, "Kirchentor",
      D_MSGS, "in die Kirche",
    }) );
}

string d_uhr()
{
  string t;
  int h,m;

  t = ctime()[11..15];
  sscanf( t, "%d:%d", h, m );
  h = h % 12;
  if (!h) h=12;
  return bs("Du liest die Zeit an der Uhr am Kirchturm ab, und erkennst, "+
    "dass es jetzt in etwa "+h+" Uhr"+(m?" "+m:"")+" sein muss, aber da die "+
    "Uhr ziemlich weit oben in den Turm eingearbeitet ist, bist Du Dir beim "+
    "Minutenzeiger nicht so hundertprozentig sicher.");
}
