/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL (1996). Preserved as kapelle_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Kapelle");
  set_long(
    "Du befindest Dich in einer kleinen Kapelle, in der Du beten kannst, "
    "um wieder Deine natuerliche Gestalt zu erhalten. Am noerdlichen Ende "
    "steht ein Altar, auf dem sich ein grosses Kreuz befindet. Neben dem "
    "Altar haengt eine Heldentafel. In den Waenden siehst Du herrliche "
    "Fenster, durch die tagsueber das Licht bunt hereinscheint. Nach Sueden "
    "gelangst Du wieder auf die belebte Hauptstrasse.\n"
  );
  set_exits(([
    "sueden": "/d/ebene/Midas/room/room_d5",
  ]));
  set_items(([
    "altar": "Er ist aus schlichtem Sandstein gehauen.\n",
    "kreuz": "Ein schlichtes Holzkreuz.\n",
    "fenster": "Die Fenster sind wunderschoen und bestehen aus herrlich buntem Glas.\n",
    "heldentafel": "Eine geschnitzte Tafel zu Ehren beruehmter Helden SilberLands.\n",
  ]));
  set_reads(([
    "heldentafel": "Ehre den Recken und Abenteurern des SilberLands!\n",
  ]));
}
