inherit "/catalog/room";

void create() {
  ::create();
  set_short("Seitenweg in Midas");
  set_long(
    "Du befindest Dich auf einem kleinen Seitenweg, der sich durch die "
    "Stadt schlaengelt. Im Norden kannst Du das aus vielen kleinen massiven "
    "Steinbloecken erbaute Rathaus erkennen, waehrend sich suedoestlich "
    "von Dir die prachtvolle Kirche erhebt.\n"
  );
  set_exits(([
    "osten": "/d/ebene/Midas/room/room_d7",
  ]));
  set_items(([
    "rathaus": "Ein Bauwerk aus vielen gleichfoermig gehauenen Steinbloecken im Norden.\n",
  ]));
}
