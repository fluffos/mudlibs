/*
** Westende von Midas  (w) Woody@SL
** ---
** Jan 1996    Woody  Release
** 1996-04-04  Woody  2 Kampfsoldaten werden bei Reset und Abwesenheit geclont
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich nun am westlichen Ende der Hauptstrasse von "+
  "Midas, einer alten und wunderschoenen Stadt. Wenn Du nach Osten "+
  "blickst, siehst Du eine grosse Menschenmenge, die sich durch die "+
  "Hauptstrasse tummelt. Auch der Boden scheint im Osten besser "+
  "ausgebaut zu sein. Nach Westen kannst Du Midas verlassen. Nach "+
  "Norden und Sueden fuehrt ein Weg die Stadtmauer entlang.\n"));

  SetProp (P_INT_SHORT, "Hauptstrasse in Midas, Westende");

  AddDetail ( ({"stadt","midas"}), bs(
    "Nach Osten hin erhebt sich Midas, eine alte, wunderschoene "+
    "Stadt, ihre Haeuser bestehen groesstenteils aus sorgfaeltig "+
    "zusammengefuegten Steinen, die Wege sind gleichmaessig "+
    "gepflastert und trotz der vielen sie durchstroemenden "+
    "Abenteurer sehr sauber."));
  AddDetail ( ({"stadtmauer","mauer"}), bs(
    "Die maechtige Stadtmauer ist aus grossen Steinen zusammengefuegt und "
    "beschuetzt die Stadt erfolgreich gegen aeussere Feinde. Ein gewaltiger "
    "Torbogen wurde hier eingearbeitet, durch ihn kannst Du Midas verlassen."));
  AddDetail ( ({"torbogen", "tor", "bogen"}), bs(
    "Der Torbogen ist kunstvoll in die maechtige Stadtmauer eingearbeitet."));
  AddDetail ("haeuser",
    "Du siehst viele, meist aus Steinen bestehende Haeuser.\n");
  AddDetail ( ({"stein", "steine"}), bs(
    "Die meisten Haeuser der Stadt bestehen wie auch die maechtige Stadt"+
    "mauer aus festen, soliden, sorgfaeltig zussamengefuegten Steinen."));
  AddDetail ("sonne",
    "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ( ({"wand","waende"}),
    "Du tastest die Luft nach Waenden ab, findest aber nichts.\n");
  AddDetail ("ende", "Du befindest Dich am westlichen Ende der Stadt.\n");
  AddDetail ( ({"hauptstrasse", "strasse","weg","boden","steinpflaster",
    "pflastersteine", "pflaster"}), bs(
    "Der Boden besteht hier aus fester Erde und scheint nach Osten hin "+
    "in ein gleichfoermiges Muster aus Pflastersteinen ueberzugehen."));
  AddDetail ("muster", "Die Pflastersteine der Stadt wurden "+
    "offensichtlich sehr sorgfaeltig verlegt.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ("erde",
    "Sie ist fest wie auf einem ausgetrampelten Pfad in einem Dorf.\n");
  AddDetail ("menschenmenge",
    "Sie tummelt sich weiter im Osten durch die Stadt.\n");
  AddDetail ("abenteurer", "Sie stroemen oft und gern durch die Stadt.\n");

  AddItem (NPC "soeldner", REFRESH_DESTRUCT);
  AddItem (NPC "soeldner", REFRESH_DESTRUCT);

  AddExit ("osten", "./room_b5");
  AddExit ("westen", SILBERWALD("room/room_k12"));
  AddExit ("norden", "./room_a4");
  AddExit ("sueden", "./room_a6");
}
