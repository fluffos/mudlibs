inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich nun am westlichen Ende der Hauptstrasse von "+
  "Midas, einer alten und wunderschoenen Stadt. Wenn Du nach Osten "+
  "blickst, siehst Du eine grosse Menschenmenge, die sich durch die "+
  "Hauptstrasse tummelt. Auch der Boden scheint im Osten besser "+
  "ausgebaut zu sein. Nach Westen koenntest Du Midas verlassen... "+
  "wenn, ja wenn da nicht ein unueberwindlicher Graben waere, ueber "+
  "den offensichtlich einmal eine Bruecke gefuehrt hat, deren "+
  "Ueberreste Du am Rande des Abgrunds noch ausmachen kannst.\n"));

  SetProp (P_INT_SHORT, "Hauptstrasse in Midas, Westende");

  AddDetail ("stadt", bs(
    "Nach Osten hin erhebt sich Midas, eine alte, wunderschoene "+
    "Stadt, ihre Haeuser bestehen groesstenteils aus sorgfaeltig "+
    "zusammengefuegten Steinen, die Wege sind gleichmaessig "+
    "gepflastert und trotz der vielen sie durchstroemenden "+
    "Abenteurer sehr sauber.\n"));
  AddDetail ("sonne",
    "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ( ({"wand","waende"}),
    "Du tastest die Luft nach Waenden ab, findest aber nichts.\n");
  AddDetail ( ({"abgrund","graben","rand"}),
    "Der Abgrund ist tief, Du willst einen Abstieg lieber nicht riskieren.\n");
  AddDetail ("ende", "Du befindest Dich am westlichen Ende der Stadt.\n");
  AddDetail ( ({"bruecke","ueberreste"}), bs(
    "Du erblickst die jaemmerlichen Ueberreste einer Bruecke ueber "+
    "einem grossen Abgrund. Offensichtlich ist die Bruecke unter der "+
    "Last der vielen Abenteurer, die aus und nach Midas stroemen, "+
    "kuerzlich zusammengebrochen und befindet sich gerade im "+
    "Wiederaufbau.\n"));
  AddDetail ( ({"strasse","weg","boden","stein","steine","steinpflaster"}), bs(
    "Der Boden besteht hier aus fester Erde und scheint nach Osten hin "+
    "in ein gleichfoermiges Muster aus Pflastersteinen ueberzugehen.\n"));
  AddDetail ("muster",
    "Die Pflastersteine der Stadt wurden offensichtlich sehr sorgfaeltig verlegt.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ("erde",
    "Sie ist fest wie auf einem ausgetrampelten Pfad in einem Dorf.\n");

  AddExit("osten", "./room_b5");
}
