//#define ROOMFILE  "/d/ebene/Midas/room/room_d6"
#define ROOMFILE  "/players/ronja/workroom"

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du befindest Dich jetzt im ersten Stock des Rathauses. Vier Tueren "
    "fuehren in weitere Amtsstuben der Stadtverwaltung, wvon jedoch nur "
    "eine geoeffnet ist. Das Treppenhaus ist kahl und wirkt aufgrund "
    "seiner auesserst geringen Moeblierung recht kuehl und wenig "
    "einladend. Lediglich eine schmale Bank befindet sich hier, wohl damit "
    "man sich beim endlosen Warten nicht die Beine in den Bauch steht. "
  );

  AddDetail( ({"warten"}) ,
    "Warten kann ganz schoen langwelig sein. Du kannst ja solange die "
    "Zeitung lesen. "
  );

  AddDetail( ({"zeitung"}) ,
    "Eine Zeitung kannst Du Dir in der Abenteurergilde holen."
  );

  AddDetail( ({"abenteurergilde","gilde"}) ,
    "Die Abenteurergilde befindet sich gleich hier um die Ecke."
  );

  AddDetail( ({"ecke","ecken"}) ,
    "Das Treppenhaus hat vier Ecken."
  );

  AddDetail( ({"stock","stockwerk"}) ,
    "Du befindest Dich im ersten Stockwerk des Rathauses von Midas."
  );

  AddSpecialDetail( ({"bank"}) , "detail_bank" );

  AddDetail( ({"tueren","tuer"}) ,
    "Welche Tuer meinst Du? Die noerdliche, oestliche, suedliche oder "
    "westliche Tuer? "
  );

  AddSpecialDetail( ({"westliche tuer"
                     ,"noerdliche tuer"
                     ,"suedliche tuer"
                     ,"oestliche tuer"}) ,
    "detail_tuer"
  );

  AddSpecialDetail( ({"bauch"}) , "detail_bauch" );

  AddDetail( ({"beine","bein"}) ,
    "Uff - beide noch da."
  );

  AddDetail( ({"moeblierung","moebel"}) ,
    "Ausser einer Bank siehst Du keinerlei Moebel."
  );

  AddDetail( ({"stadtverwaltung","verwaltung"}) ,
    "Hier im Rathaus befindet sich die Stadtverwaltung von Midas."
  );

  AddDetail( ({"amtsstuben","amtsstube"}) ,
    "Hier gibt es wirklich viele Amtsstuben. Und im oberen Stockwerk noch "
    "mehr."
  );

  AddDetail( ({"boden","steinplatte","steinplatten"}) ,
    "Der Boden besteht aus einfachen Steinplatten. Nicht gerade huebsch, "
    "aber zweckmaessig. Geputzt werden koennte der mal wieder. "
  );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende sind weiss gekalkt. Oder sie waren es wohl einmal, denn "
    "im laufe der Zeit sind sie grau und unansehnlich geworden. An einer "
    "der Waende haengt ein Bild, gegenueber dem Bild befindet sich ein "
    "kleines Fenster."
  );

  AddDetail( ({"zeit"}) ,
    "Du hast nicht ewig Zeit."
  );

  AddDetail( ({"bild"}) ,
    "Als Du Dir das Bild genauer ansiehst, entdeckst Du, dass es gar kein "
    "Bild ist, sondern eine Tafel. "
  );

  AddDetail( ({"tafel"}) ,
    "Auf der Tafel befinden sich Buchstaben, welche zu Woertern gruppiert "
    "wurden, welche wiederrum Saetze bilden."
  );

  AddDetail( ({"buchstabe","buchstaben"}) ,
    "Die Buchstaben sind zu Woertern gruppiert."
  );

  AddDetail( ({"wort","woerter","woertern"}) ,
    "Die Woerter setzen sich aus Buchstaben zusammen und bilden ihrerseits "
    "wieder Saetze. "
  );

  AddDetail( ({"satz","saetze"}) ,
    "Die Saetze bestehen aus Woertern. Vielleicht liest Du sie endlich mal, "
    "anstatt Dich in Einzelheiten zu verzetteln. "
  );

  AddDetail( ({"einzelheit","einzelheiten"}) ,
    "Ja, davon gibt es hier einige. "
  );

  AddReadDetail( ({"satz","saetze","tafel"}) ,
    "Besuchsordnung\n"
    "1 - Ohne Nummer keine Abfertigung\n"
    "2 - Den Anweisungen der Beamten ist Folge zu leisten\n"
    "3 - Die Gebuehrenverordnung bfindet sich in der Zahlstelle\n"
    "4 - Die Beamten haben immer Recht\n"
    "5 - Sollten die Beamten einmal nicht recht haben, \n"
    "    tritt automatisch Paragraf 4 in Kraft.\n"
    "\n"
    "gez. Die Stadtverwaltung von Midas\n"
  );

  AddDetail( ({"decke"}) ,
    "Die Decke ist schmucklos."
  );

  AddDetail( ({"fenster"}) ,
    "Durch das kleine Fenster kommt Licht in den Treppengang. Es befindet "
    "sich viel zu weit oben, als dass Du es oeffnest koenntest. Noetig "
    "waere es allerdings schon mal, hier zu lueften. "
  );

  AddDetail( ({"treppengang","gang","treppenhaus","treppe"}) ,
    "Du befindest Dich im Treppengang des Rathauses im ersten Stock. Die Treppe "
    "fuehrt wieder nach unten und weiter nach oben. "
  );

  AddDetail( ({"licht"}) ,
    "Durch das Fenster kommt etwas Licht herein."
  );

  AddCmd( ({CMD_OEFFNEN})           , "cmd_oeffnen");
  AddCmd( ({"lueft","luefte"})      , "cmd_lueften");
  AddCmd( ({"werf","werfe","wirf"}) , "cmd_werfen");

//AddExit("rauf"   , ROOM "rathaus/2_t" );
  AddExit("runter" , ROOM "rathaus/eg");
//AddExit("norden" , ROOM "rathaus/1_n" );
//AddExit("osten"  , ROOM "rathaus/1_o" );
  AddExit("sueden" , ROOM "rathaus/1_s" );
//AddExit("westen" , ROOM "rathaus/1_w" );
/*
Bank, Midas, Rathaus, Rathauses,
Treppe, Woerten, Woertern,

*/
}

string detail_bank(string str)
{
  string s;

  s = "Wenn man zu lange warten muss, dann kann man sich auf die Bank setzen "
      "und sich etwas ausruhen.";
  return BS(s);
}

string detail_tuer(string key)
{
  string s;

  switch(key)
  {
    case "westliche tuer" :
      s = "Wohin die westliche Tue fuehrt, kannst Du nicht ohne weiteres "
          "erkennen, denn es befindet sich kein Hinweis an der Tuer. Auch ist "
          "der Raum dahinter stockdunkel, im Gegensatz zu allen anderen. ";
      break;

    case "oestliche tuer" :
      s = "ot";
      break;

    case "suedliche tuer" :
      s = "st";
      break;

    case "noerdliche tuer" :
      s = "nt";
      break;

    default :
      s = "Sowas siehst Du hier nicht.";
      break;

  }

  return BS(s);
}

string detail_bauch(string str)
{
  string s;
  int p;

  p = TP->QueryProp(P_FOOD)*100 / TP->QueryProp(P_MAX_FOOD);

  if(p < 30)
  {
    s = "Dein Bauch ist ganz schoen leer.";
  }
  else if(p < 60)
  {
    s = "Du hast vorhin erst etwas gegessen. Im Moment verspuerst Du keinen "
        "Hunger";
  }
  else
  {
    s = "Du hast gerade eben erst etwas gegessen und bist noch immer ziemlich "
        "satt";
  }

  return BS(s);
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "fenster"         ||
       str == "fenster"         )) return 0;

  TELLPLAYER(BS("Das Fenster befindet sich viel zu weit oben, als dass Du es "
                "oeffnen koenntest."));
  TELLOTHERS(BS(CTPN+" reckt und streckt sich, um an das Fenster zu kommen, kann "
                "es aber nicht erreichen."));
  return 1;
}

int cmd_lueften(string str)
{
  notify_fail("Was moechtest Du lueften ?\n");

  TELLPLAYER(BS("Dazu muesstest Du das Fenster oeffnen. Das ist aber zu "
                "weit oben, das kannst Du nicht erreichen. Aber vielleicht "
                "die Scheibe einwerfen?"));

  TELLOTHERS(CTPN+" starrt nach oben auf das Fenster.\n");

  return 1;
}

int cmd_werfen(string str)
{
  int n;
  string was,womit;
  object room,ob;
  string s;

  notify_fail("Was moechtest Du womit einwerfen  ?\n");

  n = sscanf(str,"%s ein",was);

  if(n == 1 && (was == "fenster" || was == "scheibe"))
  {
    TELLPLAYER(BS("Hmmm, bloss mit was moechtest Du das Fenster einwerfen?"));
    return 1;
  }

           n = sscanf(str,"fenster mit %s ein",womit);
  if(n!=1) n = sscanf(str,"scheibe mit %s ein",womit);
  if(n!=1) n = sscanf(str,"mit %s fenster ein",womit);
  if(n!=1) n = sscanf(str,"mit %s scheibe ein",womit);

  if(n == 1)
  {
    if(!ob=present(womit,TP))
    {
      TELLPLAYER("Sowas hast Du doch gar nicht bei Dir!\n");
      return 1;
    }

    if(( ob->QueryProp(P_CURSED))    ||
       ( ob->QueryProp(P_NEVERDROP)) ||
       ( ob->id("QUESTOBJ"))         ||
       ( ob->QueryProp(P_NODROP))    ||
       (!ob->QueryProp(P_SHORT))     ||
       ( ob->QueryProp(P_INVIS))     ||
       (!ob->QueryProp(P_NAME))       )
    {
      TELLPLAYER("Davon willst Du Dich gar nicht trennen.\n");
      return 1;
    }

    call_other(ROOMFILE, "???"); //raum laden
    room = find_object(ROOMFILE);

    s = "Du wirfst "+ob->name(WEN)+" in Richtung Fenster. Oups, "
        "da war ja gar kein Glas drin. Komisch, dann sollte "
        "ja eigentlich auch keine solch schlechte Luft hier drin "
        "sein. Jedenfalls "+(ob->IsPlural()?"fliegen ":"fliegt ")+
        ob->name(WER,1)+" in hohem Bogen nach draussen. ";

    TELLPLAYER(BS(s));

    s = CTPN+" wirft "+ob->name(WEN)+" in Richtung Fenster. Oups, "
        "da war ja gar kein Glas drin. Komisch, dann sollte "
        "ja eigentlich auch keine solch schlechte Luft hier drin "
        "sein. Jedenfalls "+(ob->IsPlural()?"fliegen ":"fliegt ")+
        ob->name(WER,1)+" in hohem Bogen nach draussen. ";

    TELLOTHERS(BS(s));
    tell_room(room,CAP(ob->name(WER,1))+
                      (ob->IsPlural()?" fallen ":" faellt ")+
                      "von oben herab.\n");

    ob->move(room,M_PUT);
    return 1;
  }

  return 0;
}

