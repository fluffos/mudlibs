#include "./files.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int im_rathaus();

create() {
  ::create();

  SetProp(P_INT_SHORT, "Im Rathaus" );
  SetProp(P_INT_LONG, "In einer Amtsstube");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"rathaus","rathauses"}) ,
    "Du befindest Dich im Rathaus der Stadt Midas. Hier wird Midas und das "
    "Umland verwaltet. "
  );

  AddDetail( ({"midas"}) ,
    "Midas heisst die Stadt, in der Du Dich momentan befindest."
  );

  AddDetail( ({"stadt"}) ,
    "Wenn viele Leute in Haeusern zusammen wohnen, nennt man das eine Stadt."
  );

  AddDetail( ({"leute"}) ,
    "Die meisten Leute duerften draussen in der Stadt sein. Hier im Rathaus "
    "eher weniger."
  );

  AddDetail( ({"haeuser","haeusern"}) ,
    "Du befindest Dich in einem von ihnen. Genauer gesagt, im Rathaus."
  );

  AddDetail( ({"umland","einfluss"}) ,
    "Der Einfluss von Midas ist sehr weitreichend."
  );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "exit_aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

int im_rathaus()
{
   return 1;
}
