#include "./files.h"

inherit ROOM "rathaus/inh.lpc" ;

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Im Rathaus" );
  SetProp(P_INT_LONG,
    "Dies hier duerfte das Materiallager des Rathauses sein. An allen "
    "Waenden stehen Regale mit allerlei Sachen drin, die man in einem "
    "Rathaus so braucht. Ansonsten ist der Raum leer. "
  );

  SetProp(P_LIGHT,0);

  AddDetail( ({"sachen"}) ,
    "Du siehst hier jede Menge Pergamente, Bleistifte, Radiergummis, Formulare, "
    "Anspitzer und noch vieles mehr. "
  );

  AddDetail( ({"menge"}) ,
    "Die Stapel mit den Pergamenten sind ganz schoen hoch, so viele sind das. "
  );

  AddDetail( ({"stapel","pergament","pergamente"}) ,
    "Die Pergamente liegen fein saeuberlich gestapelt auf den Regalen. "
  );

  AddDetail( ({"bleistift","bleistifte","stift","stifte"}) ,
    "Die Bleistifte sind noch alle im Rohformat. Bevor man die benutzen kann, "
    "muss man sie anspitzen. "
  );

  AddDetail( ({"radiergummis","gummis","radiergummi","gummi"}) ,
    "Ganz normale Radiergummis. Falls man sich doch mal verschrieben hat. "
  );

  AddDetail( ({"formular","formulare"}) ,
    "Ein Haufen Formulare."
  );

  AddDetail( ({"anspitzer"}) ,
    "Gewoehnliche Anspitzer, um Bleistifte anzuspitzen. "
  );

  AddDetail( ({"wand","waende","waenden"}) ,
    "An den Waenden stehen Regale, die mit allerlei Sachen gefuellt sind. "
    "Wegen den Regalen kannst Du die Waende gar nicht richtig untersuchen. "
    "Aber Du gehst einfach mal davon aus, dass die Waende hier nichts besonderes "
    "zu bieten haben."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden ist hier arg staubig."
  );

  AddDetail( ({"staub"}) ,
    "Im Staub befinden sich regelrechte Trampelpfade zu den Regalen. Manches "
    "hier wird wohl sehr hauefig gebraucht, anderes weniger. "
  );

  AddDetail( ({"trampelpfade","trampelpfad","pfad"}) ,
    "Der Trampelpfad fuehrt zu einer kleinen Kiste, welche auf einem der "
    "Regale steht. "
  );

  AddDetail( ({"decke"}) ,
    "Die Decke befindet sich ueber Dir. Du kannst keinerlei Lampe erkennen. "
    "Anscheinend muss man hier selbst fuer Licht sorgen. "
  );

  AddDetail( ({"lampe"}) ,
    "Du schaust Dich nochmal gruendlich um, kannst aber keine Lampe erkennen. "
  );

  AddDetail( ({"licht"}) ,
    "Hier ist nichts, was fuer Licht sorgen koennte, weder eine Lampe, noch "
    "ein Fenster. "
  );

  AddDetail( ({"fenster"}) ,
    "Dieser Raum hat kein Fenster, weswegen sich hier wohl auch das Lager "
    "des Rathauses befindet. "
  );

  AddDetail( ({"raum"}) ,
    "Dies hier ist wohl das Lager des Rathauses."
  );

  AddDetail( ({"materiallager","lager"}) ,
    "In diesem Raum wird alles auf den Regalen gelagert, die die Beamten "
    "im Rathaus tagtaeglich brauchen. "
  );

  AddDetail( ({"regal","regale","regalen"}) ,
    "Auf den Regalen stapeln sich die unterschiedlichsten Sachen. "
  );

  AddDetail( ({"beamte","beamten"}) ,
    "Die Beamten halten sich hier eigentlich nur auf, wenn ihnen etwas "
    "ausgeht. Dann holen sie es sich hier und gehen gleich wieder. "
  );

  AddExit("raus"   , ROOM "rathaus/1_t" );

}


