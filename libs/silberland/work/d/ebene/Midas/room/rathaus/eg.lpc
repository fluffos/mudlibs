#include <properties.h>
#include <moving.h>
#include "files.h"

#ifdef LOGF
#undef LOGF
#endif

#define LOGF "/d/ebene/log/raetsel"
#define PKMASTER "/obj/pkmaster"

inherit "std/room";

mixed wow;

string rd_schild();

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Rathaus von Midas");
  SetProp (P_INT_LONG, bs(
    "\tDu befindest Dich im Inneren des Rathauses von Midas. Der Boden "
    "unter Dir wurde mit schoenen Marmorfliesen ausgelegt, eine "
    "breite Holztreppe fuehrt in den ersten Stock hinauf. An den "
    "Waenden haengen Gemaelde von unbekannten Kuenstlern, die sich "
    "mit Fackeln abwechseln, welche den fensterlosen Raum erhellen.\n")+
    "@@beamter@@");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Der Boden wurde mit schoenen Marmorfliesen ausgelegt.");
  AddDetail ( ({"fliesen", "marmorfliesen"}),
    "Unregelmaessig, weiss-schwarz gemustert, schoen anzusehen. Und "+
    "bestimmt sehr teuer, dieser Marmor...");
  AddDetail ( ({"marmor", "oberflaeche"}),
    "Ausserdem eine sehr glatte Oberflaeche.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind mit Gemaelden und Fackeln staffiert. An einer "
    "Wand erkennst Du ein Schild, auf dem etwas geschrieben steht.");
  AddDetail ( ({"schild"}),
    "Gib Dir redlich Muehe, dann kannst Du es vielleicht lesen.");
  AddDetail ( ({"muehe"}),
    "Du strengst Dich wirklich aussergewoehnlich an.");
  AddReadDetail ( ({"schild"}), #'rd_schild);
  AddDetail ( ({"decke"}),
    "Du lugst nach oben, aber das Licht dringt nicht bis zur Decke empor. "+
    "Es scheint ein sehr hoher Raum zu sein, in dem Du Dich befindest...");
  AddDetail ( ({"raum"}),
    "Du stehst mittendrin.");
  AddDetail ( ({"inneres"}),
    "Im Gegensatz zum Aeusseren, dass Du am besten von draussen siehst.");
  AddDetail ( ({"rathaus", "haus"}),
    "Du befindest Dich im Rathaus drinnen. Schau Dich nur um!");
  AddDetail ( ({"midas", "stadt"}),
    "Die Stadt, in der das Rathaus, in dem Du Dich befindest, steht, "+
    "heisst Midas.");
  AddDetail ( ({"holztreppe", "treppe"}),
    "Die Treppe fuehrt nach oben zu den verschiedenen Abteilungen. "
    "Leider klafft in der Mitte ein grosses Loch, die Treppe scheint "
    "nach dem letzten Unfall noch nicht renoviert zu sein...");
  AddDetail ( ({"loch"}),
    "Bei dem Anblick des Loches beschliesst Du, erst die Renovierung "
    "der Treppe abzuwarten statt einen Absturz zu riskieren...");
  AddDetail ( ({"abteilung", "abteilungen"}),
    "Hier kannst Du hoechstens vom Portier erfahren, was es fuer welche "+
    "gibt. Oder aber Du bemuehst Dich selber rauf und schaust Dich um.");
  AddDetail ( ({"stock", "stoecke"}),
    "Den ersten Stock erreichst Du ueber die Holztreppe. Ebenso die "+
    "uebrigen...");
  AddDetail ( ({"gemaelde", "bilder"}),
    "Du bestaunst ein paar der Gemaelde, die kleine Seitengassen, "+
    "beruehmte Gebaeude und ein paar offenbar noch beruehmtere Koepfe "+
    "abbilden.");
  AddDetail ( ({"seitengasse", "seitengassen", "gassen", "gasse"}),
    "Auf einem der Gemaelde ist eine Seitengasse zu sehen, in der gerade "+
    "eine schwarze Katze umherstreunt.");
  AddDetail ( ({"katze"}),
    "Heisst es nicht, schwarze Katzen bringen Pech?");
  AddDetail ( ({"pech"}),
    "Gluecklicherweise jedoch glaubst Du an sowas nicht...");
  AddDetail ( ({"gebaeude"}),
    "Du kannst auf den Gemaelden die Gilde, die Kirche und auch das "+
    "Rathaus, in dem Du grade stehst, erkennen.");
  AddDetail ( ({"gilde", "kirche"}),
    "Die befindet sich ausserhalb dieses Gebaeudes.");
  AddDetail ( ({"koepfe"}),
    "Auf manchen Gemaelden erkennst Du Dir unbekannte Koepfe, einmal mit, "+
    "einmal ohne Bart, mal mit grosser Nase, mal mit Brille, dann wieder "+
    "ohne... Sicher stadtbekannte Persoenlichkeiten.");
  AddDetail ( ({"bart", "brille", "nase"}),
    "So genau willst Du das eigentlich gar nicht wissen.");
  AddDetail ( ({"persoenlichkeiten"}),
    "Sie sind auf manchen der Gemaelde abgebildet.");
  AddDetail ( ({"kuenstler"}),
    "Die Kuenstler der Gemaelde sind sicher wieder unterwegs, malen. Aber "+
    "sie haben sich auf ihren Bildern natuerlich mit ihren Namen verewigt.");
  AddDetail ( ({"name", "namen"}),
    "Du versuchst, einige der Namen zu erkennen, scheiterst aber "+
    "klaeglich.");
  AddDetail ( ({"fackel", "fackeln"}),
    "Die Fackeln sind in Wandhalterungen gesteckt und erhellen den "+
    "fensterlosen Raum bis in den hintersten Winkel.");
  AddDetail ( ({"halterungen", "wandhalterungen"}),
    "In den Wandhalterungen befinden sich die Fackeln. Eine von ihnen "+
    "scheint locker zu sein.");
  AddDetail ( ({"halterung", "wandhalterung"}),
    "Als Du die lockere Wandhalterung naeher betrachtest, stellst Du fest, "+
    "dass man sie offenbar drehen kann. In ihr befindet sich auch keine "+
    "Fackel, sodass das Drehen gefahrlos moeglich ist.");
  AddDetail ( ({"winkel"}),
    "Auch dieser Raum hat viele rechte Winkel, wie die meisten Raeume.");
  AddDetail ( ({"rollen", "schriftrollen"}),
    "Als Du die Schriftrollen naeher betrachtest, siehst Du dass sich "+
    "hauptsaechlich Kreuzwortraetsel auf ihnen befinden.");
  AddSpecialDetail ( ({"kreuzwortraetsel", "raetsel"}),
    "d_raetsel");
  AddDetail ( ({"holz"}),
    "Ganz gewoehnliches aber sauber verarbeitetes Holz.");
  AddDetail ( ({"licht"}),
    "Dank des Lichts der Fackeln kannst Du hier etwas sehen, denn Fenster "+
    "gibt es in diesem Raum offenbar keine.");
  // DETAILS END

  // EXITS START
  AddExit( ({"raus","sueden"}), "../room_c7" );
  AddSpecialExit ("oben", "nochnicht");
  SetProp( P_HIDE_EXITS, ({"sueden"}) );
  // EXITS END

  // ITEMS START
  AddItem (NPC "beamter", REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd ( ({"schreib", "schreibe"}), "schreib");
  AddCmd ( ({"drehe", "dreh"}), "drehe");
  AddCmd ( ({"begnadige"}), "begnadige");

  wow=0;
}

int nochnicht()
{
  write(bs("Du musterst die noch in Bau befindliche Treppe und siehst "
      "dann doch davon ab, nach oben zu gehen."));
  return 1;
}

void reset()
{
  ::reset();
  if (wow) {
    tell_room(ME, "Ein leichter Windhauch wirbelt die Schriftrollen "
        "etwas durcheinander.\n");
    wow=0;
  }
}

string beamter()
{
  if (present("beamter"))
    return bs("Unmittelbar vor Dir, ueber ein paar Schriftrollen gebeugt, "
           "sitzt ein Beamter, offenbar eine Art Portier, und blickt "
           "Dich freundlich laechelnd an.");
  else
    return "";
}

int drehe (string str)
{
  notify_fail ("Was willst Du drehen?\n");
  if (!str) return 0;
  if ((str!="halterung") && (str!="wandhalterung")) return 0;
  write("Du drehst an der Wandhalterung.\n"
      "Irgendetwas unter Dir rumpelt, aber sonst tut sich nichts.\n");
  say(TP->Name()+" dreht an einer Wandhalterung.\n");
  call_other(KANAL "kanal_c6", "halterung");
  return 1;
}

string d_raetsel()
{
  if (wow) return bs(
    "Ein offenbar erst nachtraeglich ausgefuelltes Feld mit fuenf "
    "Buchstaben, senkrecht faellt Dir auf. Du liest die Definition: "
    "\"Als Mitbringsel auf die Akropolis sprichwoertlich ungeeignet (Mz)\". "
    "Als Du die Buchstaben genauer betrachtest, erkennst Du die "
    "leider komplett unleserliche Handschrift von "+wow+".");
  else return bs(
    "Du siehst ein unausgefuelltes Feld mit fuenf Buchstaben, senkrecht, "+
    "und liest die Definition: \"Als Mitbringsel auf die Akropolis "+
    "sprichwoertlich ungeeignet (Mz)\". Verwundert schuettelst Du den Kopf.");
}

int schreib (string str)
{
  notify_fail ("Was willst Du schreiben?\n");
  if (!str) return 0;
  if (strlen(str) > 5)
    return write("Hmm, nein, \""+str+"\" ist einfach zu lange.\n"), 1;
  if (strlen(str) < 5)
    return write("Hmm, nein, \""+str+"\" ist nicht lang genug.\n"), 1;
  if (str!="eulen") return write("Hmm, nein, das passt irgendwie nicht "
      "mit den Querbuchstaben zusammen...\n"), 1;
  wow=CAP(getuid(TP));
  write ("Du fuellst das Feld aus und strahlst stolz.\n");
  say (bs(TP->Name()+" krixelt was auf eine Schriftrolle und strahlt Dich "
      "stolz an."));

  write_file (LOGF,
    dtime(time())+": Raetsel geloest von "+CAP(getuid(TP))+"\n");

  return 1;
}


string format_list(string str)
{
  return sprintf("   | %-58s |", str);
}

string rd_schild()
{
  mapping v;
  string s;

  if (sizeof(v=PKMASTER->QueryVictims())) {
    s=implode( map_array( m_indices(v), #'capitalize), ", ");
    s=break_string(s,58);
    s="   +------------------------------------------------------------+\n"
      "   | Derzeit befinden sich folgende Spieler im Raum der         |\n"
      "   | Entscheidung:                                              |\n"+
      implode(map_array(explode(s,"\n"),#'format_list),"\n")+"\n";
  }
  else s="";

  return
    "Auf dem Schild steht geschrieben:\n\n"
    "   .------------------------------------------------------------.\n"
    "   | Du kannst hier Spieler, die Dich versehentlich angegriffen |\n"
    "   | haben, aus ihrer misslichen Lage befreien.  Dies geht ganz |\n"
    "   | einfach mit 'begnadige <spieler>'.                         |\n"+s+
    "   `------------------------------------------------------------'\n\n";

}


int begnadige(string str)
{
  object ob;

  if (!str)
    return notify_fail("Wen willst Du begnadigen?\n"), 0;

  if (!ob=find_player(str))
    return notify_fail("Einen Spieler mit diesem Namen "
        "gibt es derzeit nicht.\n"), 0;

  if (file_name(environment(ob))!="/room/entscheidung")
    return notify_fail("Dieser Spieler benoetigt "
        "Deine Begnadigung nicht.\n"), 0;

  switch (PKMASTER->Release(this_player(), str))
  {
    case 1:
    case -1:
      write("Du begnadigst "+ob->name(WEN)+".\n");
      tell_object(ob, TP->Name(WER)+" begnadigt Dich.\n");
      if (PKMASTER->MoveBack(ob) == -2)
        ob->move(this_object(), M_TPORT | M_NOCHECK);
      break;
    case -2:
      write("Nur die Opfer des Schuldigen koennen diesen begnadigen!\n");
      break;
    case -3:
      write("Du begnadigst "+ob->name(WEN)+".\n");
      tell_object(ob, TP->Name(WER)+" begnadigt Dich.\n");
      break;
    default:
      write("Aus irgendeinem Grund funktioniert das nicht.\n");
      break;
  }
  return 1;
}

