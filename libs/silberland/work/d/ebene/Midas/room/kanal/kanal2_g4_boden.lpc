#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Kanalisation");
  SetProp (P_INT_LONG,
    "Du bist wohl in ein dunkles schwarzes Loch geraten. Aus dem Boden "
    "stehen jede Menge spitze rostige Zacken heraus, an ihnen klebt noch "
    "altes und sogar ein bisschen frisches Blut. Ausserdem liegen wahllos "
    "verstreut noch einige Skelette und Totenschaedel herum, wohl von "
    "Abenteurern, die hier ihr Leben lassen mussten. Hoffentlich kommst Du "
    "hier wieder lebend raus!");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END

}
