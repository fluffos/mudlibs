/*
** Waechterwohnung  (w) Woody@SL
** Midas Kanalisation, Ebene 2
** ---
** 96-08-01  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:8]));
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich in einer kleinen Wohnung, die wohl eine Art "+
  "Zuhause fuer die Waechter hier darstellen soll. Am Boden siehst Du "+
  "ein Schuhregal und an der Wand einige Haken befestigt. Offenbar ist "+
  "dies hier eine Art Vorraum, in der die Waechter ihre Ausruestung "+
  "und Kleidung aufbewahren. Im Sueden scheint sich eine Toilette zu "+
  "befinden, waehrend der Vorraum sich nach Osten hin weiter erstreckt."));

  SetProp (P_INT_SHORT, "Ein Vorraum");

  AddDetail ("kanalisation", "Du befindest Dich in ihr.\n");
  AddDetail ("stadt", "Du befindest Dich weit unter ihr.\n");
  AddDetail ( ({"schuhregal", "regal"}),
    "Das Schuhregal ist leer, nur ein alter Fetzen befindet sich in ihm.\n");
  AddDetail ("fetzen",
    "Ein alter Fetzen, mit dem die Waechter wohl ihre Schuhe putzen.\n");
  AddDetail ("haken", bs(
    "Du kannst einige Haken in der Wand erkennen, an denen die Waechter "+
    "vermutlich fuer gewoehnlich ihre Umhaenge und Maentel aufhaengen.\n"));
  AddDetail ( ({"wand","waende"}),
    "Die Waende sind mit einer geschmacklosen Tapete ueberzogen.\n");
  AddDetail ("tapete", "Die Tapete traegt ein geschmackloses Linienmuster.\n");
  AddDetail ( ({"linienmuster", "muster"}),
    bs("Dein Blick verliert sich in dem Linienmuster der Tapete, als Du "+
    "ploetzlich einen Nagel zu erkennen glaubst."));
  AddDetail ("nagel",
    bs("Der Nagel bewegt sich ploetzlich! Als Du genauer hinsiehst, "+
    "erkennst Du, dass es sich nicht um einen Nagel, sondern um "+
    "eine kleine Spinne handelt."));
  AddDetail ("spinne", "Die Spinne spinnt offenbar an einem Spinnennetz.\n");
  AddDetail ( ({"spinnennetz", "netz"}),
    "In dem Spinnennetz hat sich bereits eine Fliege verfangen.\n");
  AddDetail ("fliege",
    "Die Fliege hat ihren Tod im Spinnennetz gefunden.\n");   // FP ?
  AddDetail ("decke", "Die Decke ueber Dir wurde weiss angemalt.\n");
  AddDetail ("boden", bs(
    "Der Boden ist mit hellbraunen Fliessen ausgelegt. Nicht sonderlich "+
    "sorgfaeltig, aber immerhin doch einigermassen regelmaessig."));
  AddDetail ("fliessen", "Die Fliessen sind hellbraun und erstrecken "+
    "sich ueber den gesamten Boden.\n");

  AddExit ("sueden", "./kanal2_b4");
  AddExit ("osten", "./kanal2_c3");
  NewDoor ("westen", "./kanal2_a3",
    ({"tuere", "tuer", "holztuere", "holztuer"}), ({
    D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
    D_LONG, "Eine kleine Holztuere, die aus der Wohnung heraus fuehrt.\n",
    D_SHORT, "Eine %se Holztuere.",
    D_GENDER, FEMALE,
    D_NAME, "Holztuere" }) );
}
