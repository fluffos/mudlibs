inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  SetProp (P_INT_LONG, bs(QueryProp(P_INT_LONG)+
    "Eine kleine Leiter fuehrt hinauf, wo es ein klein bisschen heller "+
    "zu sein scheint."));
  AddDetail ("leiter",
    "Die Leiter fuehrt weiter hinauf.\n");
  AddExit("sueden", "./kanal2_g8");
  AddExit("oben", "./kanal_g7");
}
