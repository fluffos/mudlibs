/*
** Kanalisation von Midas  (w) Woody@SL
** Ebene 2
** ---
** 96-06-23  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, -1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich in der unteren Kanalisation von Midas. Schwaerzeste "+
  "Nacht herrscht hier, die Waende sind feucht und kuehl, und Dein Atem "+
  "stockt. Was wird Dich wohl erwarten, wenn Du weitergehst?"));

  SetProp (P_INT_SHORT, "Kanalisation");

  AddDetail ("kanalisation", "Du befindest Dich in ihr.");
  AddDetail ("atem",
      "Einatmen, ausatmen, ganz einfach eigentlich. Trotzdem faellt es Dir "
      "hier schwerer als sonst.");
  AddDetail ("nacht", "Es ist zappenduster.");
  AddDetail ( ({"kanal", "kanaele", "abwasserkanaele"}), bs(
    "Die Abwasserkanaele der Stadt Midas fuehren entlang der kleinen "+
    "Seitentrasse, auf der Du entlang gehst, in alle moeglichen "+
    "und unmoeglichen Richtungen."));
  AddDetail ( ({"midas","stadt"}),
    "Du befindest Dich unterhalb der Stadt Midas.");
  AddDetail ( ({"seitentrasse", "trasse"}), bs(
    "Die kleine Seitentrasse fuehrt entlang der Kanaele durch die "+
    "gesamte Kanalisation."));
  AddDetail ("stadt", "Du befindest Dich weit unter ihr.\n");
  AddDetail ( ({"wand","waende"}), bs(
    "Die kahlen Waende sind feucht und ziemlich kuehl, und geben ein "+
    "ziemlich eintoeniges und trostloses Bild ab."));
  AddDetail ( ({"bild","bilder"}),
    "Wie? Was? Du siehst Bilder? HIER?!?!?");
  AddDetail ("decke", "Die Decke ueber Dir ist feucht und grauenhaft.\n");
  AddDetail ("boden", bs(
    "Hin und wieder meinst Du, kleine, eklige Tierchen ueber den Boden "+
    "huschen zu sehen, aber im naechsten Moment wieder kannst Du nichts "+
    "dergleichen erkennen."));
  AddDetail ("tierchen", "Du kannst sie nicht genauer identifizieren.\n");
  AddDetail ("moment", "Und schon ist er vorbei.");
  AddDetail ("gang", "Der Gang ist dunkel und fuehrt ins Ungewisse.\n");
  AddDetail ("gaenge", "Die Gaenge sind dunkel und fuehren ins Ungewisse.\n");
  AddDetail ( ({ "wasser","stelle","stellen" }), bs(
    "An manchen Stellen kannst Du Wasser die Waende runterfliessen sehen. "+
    "Es scheint sich jedoch nicht gerade um Trinkwasser zu handeln..."));
  AddDetail ( ({"gedanke","gedanken","trinkwasser" }),
    "Allein beim Gedanken, dieses Wasser zu trinken, schuettelst Du Dich.\n");
  AddDetail ("ort",
    "Schau Dich doch einfach genauer um!");
  AddDetail ("erkundung", "Die kann Dir keiner abnehmen.");
  AddDetail ("atmosphaere", "Sie ist einfach nur... unheimlich.");

  AddSmell (DEFAULT_SMELL, "Irgendwie riecht es hier ziemlich vermodert...\n");
  AddSound (DEFAULT_SOUND, bs(
    "Eine beunruhigende Stille herrscht hier. Hier und da bildest Du Dir "+
    "ein, Schritte zu hoeren, aber Du musst Dich wohl taeuschen... Ab und "+
    "zu hoerst Du das leise Plaetschern von Wasser."));
  AddSound ("stille", "Keineswegs eine beruhigende Stille...\n");
  AddSound ("schritte", bs("Da waren doch Schritte... oder nicht? Du bist "+
    "Dir wirklich nicht sicher, beschliesst aber, bei der weiteren "+
    "Erkundung etwas vorsichtiger zu sein."));
  AddSound ( ({"plaetschern", "wasser"}), bs(
    "An manchen Stellen in der Wand tritt etwas Wasser aus, dessen "+
    "leises Plaetschern Du vernehmen kannst. Es gibt dem Ort eine "+
    "irgendwie unheimliche Atmosphaere..."));
}
