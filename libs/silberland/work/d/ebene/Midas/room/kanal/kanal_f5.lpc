inherit "/d/ebene/Midas/room/kanal/kanal_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  SetProp(P_INT_LONG, break_string(QueryProp(P_INT_LONG)+
      "An der Nordwand siehst Du ein dickes, oben "
      "offenes Abflussrohr, das nach unten zu fuehren scheint."), 78);

  AddDetail( ({ "wand", "waende" }),
      "Die Waende geben ein ziemlich trostloses Bild ab. Nur ein "
      "dickes Abflussrohr an der Nordwand faellt Dir auf." );
  AddDetail( ({ "abfluss","rohr","abflussrohr","nordwand" }),
      "Das Rohr an der Nordwand fuehrt senkrecht nach unten. Du blickst "
      "durch das dunkle Loch hinein in die Tiefe, kannst jedoch nichts "
      "erkennen, so finster ist es da drinnen... Aber vielleicht kann "
      "man ja reinspringen, eine entsprechende Portion Mut vorausgesetzt. "
      "Breit genug scheint das Loch zu sein. Sogar fuer Dich ;-)." );
  AddDetail( ({ "loch","tiefe" }),
      "Du blickst ins Rohr, kannst jedoch rein gar nichts erkennen, "
      "alles schwarz...");
  AddDetail( ({ "portion","mut" }),
      "Spring doch! Feigling!");
  AddDetail( ({ "feigling" }),
      "Du nickst.");

  SetProp (P_SCHERBEN, 20);
  // voruebergehend abgehaengt
  AddExit("osten", "./kanal_g5");
  AddExit("sueden", "./kanal_f6");
  // bis hierher
  AddExit("westen", "./kanal_e5");
  /*
  AddExit("sueden",
      ([ EX_DEST:     "./kanal_f6",
         EX_TESTFUNC: "darf_durch",
         EX_PLMSG:    "Eine Stimme sagt: Du darfst passieren!\n"
      ]) );
  */

  AddCmd( ({"spring","springe"}), "spring" );
}

int darf_durch()
{
  if (present("kanal\npassierschein", TP))
    return 1;
  write("Du darfst derzeit leider nicht durch.\n");
  return 0;
}

int spring(string str)
{
  object ob;

  if (!strlen(str))
    return write("Wo willst Du hineinspringen?\n"), 1;
  if (!member( (["loch","rohr","abflussrohr","hinab","runter",
                 "in loch","in rohr","in abflussrohr"]), str))
    return write("Wo willst Du hineinspringen?\n"), 1;

  /*
  write(bs("Du willst springen, doch im letzten Moment haeltst Du inne.\n"
      "Das Gebiet ist leider noch nicht freigegeben...\n"
      "Du seufzst.\n"));
  return 1;
  */

  if(this_player()->QueryGuest())
  {
    write(bs(
      "Du traust Dich nicht, in das Loch zu springen!"));
    return 1;
  }

  write(bs("Du nimmst all Deinen Mut zusammen und springst durch das "
      "Abflussrohr nach unten in die Dunkelheit..."));

  if (TP->move("/d/unterwelt/basics/central/room/abfluss", M_GO,
      "in ein Abflussrohr und verschwindet in der Dunkelheit", "springt",
      "kommt durch ein Abflussrohr angerutscht") < 0)
  {
    write("Seltsamerweise bist Du wieder da wo Du vorher warst...\n");
    return 1;
  }
  if (ob=find_object(KANAL "kanal2_f5"))
    tell_room(ob, bs(
        "Du vernimmst ploetzlich ein lautes Rumpeln und schrickst zusammen. "
        "Es scheint aus dem dicken Abflussrohr zu kommen, das an der Nordwand "
        "entlang von der Decke bis zum Boden hin verlaeuft."));

  // Die Unterwelt macht folgendes lt. Ronja jetzt alles automagisch selber:
  // call_other("/d/unterwelt/basics/central/room/abfluss", "godown", TP);

  return 1;

}

