inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"


void create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INT_SHORT, "Piazza des Todes");
  SetProp (P_INT_LONG,
      "Nanu? Inmitten der Kanalisation von Midas ploetzlich eine "
      "kleine Piazza... Sachen gibt's! Die Luft ist kuehl und "
      "feucht, Du fuehlst Dich ein wenig hilflos, verloren und "
      "sehr allein. Seltsame Geraeusche dringen an Dein Ohr, und "
      "irgendwie greift eine beklemmende Angst um sich, die auch "
      "Dich erfasst.");
  AddDetail ( ({ "piazza", "platz" }),
      "Du stehst mittendrauf und wunderst Dich drueber.");
  AddDetail ( ({ "angst" }),
      "Panisch schaust Du um Dich. Dir wird ganz mulmig.");
  AddDetail ( ({ "luft" }),
      "Sie ist kuehl und feucht, gerade richtig gruselig.");
  AddDetail ( ({ "ohr" }),
      "Du zwickst Dich ins Ohr. AUA! Das tut ja weh!");
  AddDetail ( ({ "geraeusch","geraeusche" }),
      "Geraeuschen kann man lauschen.");

  AddSound ( ({ "geraeusch","geraeusche" }),
      "Ein Schaben, Kratzen, Fauchen, ... sehr beaengstigend.");
  AddSound ( ({ "schaben" }),
      "*SCHAB* *SCHAB*");
  AddSound ( ({ "kratzen" }),
      "*KRATZ* *KRATZ*");
  AddSound ( ({ "fauchen" }),
      "*FAUCH* *FAUCH*");
  call_out("clonetanke", 2);
}

nosave void clonetanke()
{
  int x,n;
  object *tanken, ob;

  tanken=filter_objects(all_inventory(ME), "id", "\ntanke");
  n=sizeof(tanken);
  x=random(100);
  switch (x)
  {
    case  0..19:        // zu 20% KEINE
      return;
    case 20..64:        // zu 45% EINE
      if (n) return;
      else n=1;
      break;
    default:            // zu 35% ZWEI
      n=2-n;
      if (n<=0) return;
  }
  for (x=1; x<=n; x++) {
    ob=clone_object(OBJ("div/tanke"));
    ob->move(ME,M_NOCHECK);
    tell_room(ME, ob->Name()+" waechst aus dem Nichts.\n");
  }
}

void reset()
{
  object *tanken;
  tanken=filter_objects(all_inventory(ME), "id", "\ntanke");
  filter_objects(tanken,"verwelke");
  call_out("late_reset", 5+random(4));
  call_out("clonetanke", 10+random(11));
}

void late_reset()
{
  ::reset();
}

