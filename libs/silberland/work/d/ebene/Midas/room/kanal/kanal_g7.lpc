inherit "/d/ebene/Midas/room/kanal/kanal_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  SetProp (P_INT_LONG, bs(QueryProp(P_INT_LONG)+
    "Eine kleine Leiter fuehrt hinunter ins Dunkle."));
  AddDetail ("leiter",
    "Die Leiter fuehrt hinunter in ein sehr dunkles Loch.\n");
  AddDetail ("loch", bs(
    "Du hast keine Ahnung, wohin es Dich fuehrt. Das einzige, was Du "+
    "erkennst, ist, dass es SEHR dunkel da unten ist."));
  AddDetail ("ahnung",
    "Sowas hast Du nicht. ;-)\n");

  SetProp (P_SCHERBEN, 15);
  AddExit("norden", "./kanal_g6");
  AddExit("unten", "./kanal2_g7");
}
