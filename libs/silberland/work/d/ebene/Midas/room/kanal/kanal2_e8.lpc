inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich in der unteren Kanalisation von Midas. Schwaerzeste "+
  "Nacht herrscht hier, die Waende sind feucht und kuehl. Im Norden kannst "+
  "Du hinter einem Gitter aus Stahlrohren so etwas aehnliches wie eine "+
  "Gefaengniszelle erkennen, @@gef@@."));

  AddDetail ( ({ "stahlrohre", "rohre" }), bs(
    "Die Rohre des Gefaengnisgitters bestehen aus haertestem Stahl, "+
    "keine Kraft der Welt kann sie wohl verbiegen."));
  AddDetail ("stahl",
    "Kaum etwas ist so hart wie der Stahl dieser Rohre.\n");
  AddSpecialDetail ( ({"zelle", "gefaengniszelle"}), "d_gef");

  AddExit("osten", "./kanal2_f8");
  AddExit("westen", "./kanal2_d8");
  NewDoor ("norden", "./kanal2_e7",
    ({"gitter", "gefaengnisgitter"}), ({
    D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
    D_LONG, "Ein unverschlossenes Gefaengnisgitter, "+
            "das aus festen Stahlrohren besteht.\n",
    D_SHORT, "Ein %ses Gefaengnisgitter.",
    D_GENDER, NEUTER,
    D_NAME, "Gefaengnisgitter" }) );
}

int leerzelle()
{
  object ob;
  call_other(KANAL "kanal2_e7", "");
  for (ob=first_inventory(find_object(KANAL "kanal2_e7")); ob; ob=next_inventory(ob))
  {
    if (living(ob)) return 0;
  }
  return 1;
}

string d_gef()
{
  if (leerzelle())
    return "Sie scheint im Moment leer zu sein.\n";
  else
    return bs("Irgendjemand scheint sich in ihr zu befinden. Mehr kannst "+
      "Du jedoch nicht erkennen.");
}

string gef()
{
  if (leerzelle())
    return "die jedoch leer zu sein scheint";
  else
    return "in der sich offenbar jemand befindet";
}

