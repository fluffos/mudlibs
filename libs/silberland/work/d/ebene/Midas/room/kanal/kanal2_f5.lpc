inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_LONG, bs(QueryProp(P_INT_LONG)+
      "Ein dickes Abflussrohr fuehrt von der Decke entlang der Nordwand "
      "bis zum Boden hinab, wo es verschwindet. "
      "Eine Oeffnung kannst Du nirgendwo ausmachen."));

  AddDetail ( ({"wand","waende"}),
      "Die kahlen Waende sind feucht und ziemlich kuehl, wie "
      "ueberall hier unten. Nur das dicke Abflussrohr an der Nordwand "
      "faellt Dir auf.");
  AddDetail ( ({"abfluss","rohr","abflussrohr"}),
      "Das Rohr fuehrt an der Nordwand entlang nahtlos von der Decke "
      "bis zum Boden durch. Es ist ungewoehnlich dick, sonst faellt "
      "Dir nichts Besonderes daran auf.");
  AddDetail ( "oeffnung",
      "Keine zu entdecken, so sehr Du Dich auch bemuehst...");
  AddDetail ( "nordwand",
      "Bis auf das Abflussrohr nicht weiter bemerkenswert.");

  AddExit("westen", "./kanal2_e5");
  // AddExit("osten", "./kanal2_g5");
}

