inherit "/d/ebene/Midas/room/kanal/kanal_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  SetProp (P_SCHERBEN, 15);
  AddExit("westen", "./kanal_f5");
  AddExit("sueden",
      ([ EX_DEST: "./kanal_g6",
         EXG_ID:  "wilder",
         EXG_PLMSG: "Der Wilde haelt Dich unsanft zurueck.\n@@wild_attack@@",
         EXG_RMMSG: "Der Wilde haelt @wen@ unsanft zurueck.\n" ]) );

  AddItem (NPC "wilder", REFRESH_DESTRUCT);
}

wild_attack()
{
  object ob;
  if (ob=present("wilder"))
    ob->Kill(this_player());
  return "";
}
