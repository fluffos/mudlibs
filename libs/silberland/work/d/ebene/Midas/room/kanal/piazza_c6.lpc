inherit "/d/ebene/Midas/room/kanal/piazza_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

create()
{
  ::create();

  AddDetail( ({"wand","waende"}),
      "Du stehst in der Mitte der Piazza und kannst daher keinerlei "
      "Waende sehen.");
  AddDetail( "decke",
      "Du siehst ein kleines Loch in der Decke und ein paar Sprossen.");
  AddDetail( "sprossen",
      "Leider kommst Du nicht mehr an die Sprossen ran, "
      "sie sind zu weit oben.");
  AddDetail( "loch",
      "Durch das kleine Loch in der Decke bist Du gekommen. Leider "
      "ist es ausserhalb Deiner Reichweite, sodass Du keine Moeglichkeit "
      "siehst, hier wieder zurueckzukommen.");
  AddDetail( "moeglichkeit",
      "Nicht mal wenn Du springst, gelangst Du wieder zurueck!");
  AddDetail( "reichweite",
      "Du streckst Deine Hand aus, kommst jedoch nicht mal annaehernd "
      "an das Loch ran! Ein Wunder, dass Du unverletzt hier runter "
      "gekommen bist...");
  AddDetail( "hand",
      "Du betrachtest Deine Hand selbstverliebt.");
  AddDetail( "wunder",
      "Du wunderst Dich. (wie doppelboedig!)");
  AddDetail( "mitte",
      "Du siehst, dass sich die Piazza in alle vier Himmelsrichtungen "
      "weiter erstreckt.");
  AddDetail( "himmelsrichtungen",
      "Norden, Osten, Sueden, Westen.");
  AddDetail( ({"norden","osten","sueden","westen"}),
      "Da kann man sogar hingehen.");

  AddExit("westen", "./piazza_b6");
  AddExit("osten",  "./piazza_d6");
  AddExit("norden", "./piazza_c5");
  AddExit("sueden", "./piazza_c7");
  AddCmd( ({"spring","springe"}), "spring");
}

public void init() {
    ::init();
  
  
    if(objectp(present(RANGER_TASK_SCHNITZELJAGD, TP))) {
      call_out("greet_ranger", 0, TP);
    }
  
    return;
}

public void greet_ranger(object pl) {
    object ob;

    if(objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, pl))) {
        ob->PiazzaBetreten();
    }
    return;
}

int spring(string str)
{
  if (!stringp(str) || str[0]=='/') call_out("warwohlnix",0,this_player());
  return 0;
}

void warwohlnix(object pl)
{
  if (!objectp(pl)) return;
  if (environment(pl)!=this_object()) return;
  tell_object(pl,
      "Schoen kannst Du springen ;-)\n"
      "Aber trotzdem schaffst Du es nicht, so wieder rauszukommen.\n");
}

