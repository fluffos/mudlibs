/*
** Kanalisation von Midas  (w) Woody@SL
** ---
** 96-05-30  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <class.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich in der Kanalisation von Midas. Die dunklen, feuchten "+
  "Waende und die Kaelte jagen Dir einen Schauer ueber den Ruecken, Du "+
  "fuehlst Dich ziemlich unbehaglich hier."));

  SetProp (P_INT_SHORT, "Kanalisation");
  SetProp (P_KILL_NAME, "Ein Haufen Scherben");

  AddDetail ("kanalisation", "Du befindest Dich in ihr.\n");
  AddDetail ( ({"kanal", "kanaele", "abwasserkanaele"}), bs(
    "Die Abwasserkanaele der Stadt Midas fuehren entlang der kleinen "+
    "Seitentrasse, auf der du entlang gehst, in alle moeglichen "+
    "und unmoeglichen Richtungen."));
  AddDetail ( ({"midas","stadt"}),
    "Du befindest Dich unterhalb der Stadt Midas.");
  AddDetail ( ({"schauer"}),
    "Dich froestelt ein wenig. Nicht nur wegen der Kaelte.");
  AddDetail ( ({"ruecken"}),
    "Weisst Du, was hinter Deinem Ruecken geschieht? Jetzt gerade?");
  AddDetail ( ({"seitentrasse", "trasse"}), bs(
    "Die kleine Seitentrasse fuehrt entlang der Kanaele durch die "+
    "gesamte Kanalisation."));
  AddDetail ("stadt", "Du befindest Dich unter ihr.\n");
  AddDetail ( ({"wand","waende"}),
    "Die kahlen Waende geben ein ziemlich trostloses Bild ab.\n");
  AddDetail ( ({"bild","bilder"}),
    "Wie? Was? Du siehst Bilder? HIER?!?!?");
  AddDetail ("decke", "Die Decke ueber Dir ist feucht und grauenhaft.\n");
  AddDetail ("boden", bs(
    "Den feuchten und oft mit Scherben bedeckten Boden sollte man wohl "+
    "besser nicht barfuss betreten. Du kannst Dich auf einer kleinen "+
    "Seitentrasse die Kanaele entlang bewegen."));
  AddDetail ("gang", "Der Gang ist dunkel und fuehrt ins Ungewisse.\n");
  AddDetail ("gaenge", "Die Gaenge sind dunkel und fuehren ins Ungewisse.\n");
  AddDetail ("kaelte", "Brrr, hier ist es wirklich kalt... hoffentlich "+
    "hast Du waermende Kleidung!\n");
  AddDetail ("kleidung", "Tipp mal \"ausruestung\"!");
  AddDetail ("erkundung", "Die kann Dir keiner abnehmen.");
  AddDetail ( ({ "wasser","stelle","stellen" }), bs(
    "An manchen Stellen kannst Du Wasser die Waende runterfliessen sehen. "+
    "Es scheint sich jedoch nicht gerade um Trinkwasser zu handeln..."));
  AddDetail ( ({"gedanke","gedanken","trinkwasser" }),
    "Allein beim Gedanken, dieses Wasser zu trinken, schuettelst Du Dich.\n");
  AddDetail ( ({"ort" }),
    "Schau Dich doch einfach ein wenig um! Dann bist Du klueger.");
  AddDetail ("atmosphaere", "Sie ist einfach nur... unheimlich.");

  AddSpecialDetail ("scherben", "scherben");

  AddSmell (DEFAULT_SMELL, "Irgendwie riecht es hier ziemlich vermodert...\n");
  AddSound (DEFAULT_SOUND, bs(
    "Eine beunruhigende Stille herrscht hier. Hier und da bildest Du Dir "+
    "ein, Schritte zu hoeren, aber Du musst Dich wohl taeuschen... Ab und "+
    "zu hoerst Du das leise Plaetschern von Wasser."));
  AddSound ("stille", "Keineswegs eine beruhigende Stille...\n");
  AddSound ("schritte", bs("Da waren doch Schritte... oder nicht? Du bist "+
    "Dir wirklich nicht sicher, beschliesst aber, bei der weiteren "+
    "Erkundung etwas vorsichtiger zu sein."));
  AddSound ( ({"plaetschern", "wasser"}), bs(
    "An manchen Stellen in der Wand tritt etwas Wasser aus, dessen "+
    "leises Plaetschern Du vernehmen kannst. Es gibt dem Ort eine "+
    "irgendwie unheimliche Atmosphaere..."));
}

string scherben()
{
  switch (QueryProp (P_SCHERBEN))
  {
    case 0: return "Du kannst hier keine Scherben entdecken.\n";
    case 1..10: return "Ein paar Scherben liegen am Boden herum.\n";
    case 11..30: return "Etliche Scherben liegen am Boden herum.\n";
    case 31..60: return "Viele Scherben liegen am Boden herum.\n";
    default: return "Du siehst eine gewaltige Menge Scherben rumliegen.\n";
  }
}

init()
{
  object *a;
  ::init();
  if (!interactive(TP)) return;
  if (IS_LEARNING(TP)) return;
  if (TP->is_class_member(CL_FLYING)) return; // Wer fliegt kann nicht auf scherben treten
  if (QueryProp(P_SCHERBEN))
  {
    a = filter_array(TP->QueryProp(P_ARMOURS),
          lambda( ({'x}), ({ #'==,
              ({ #'call_other, 'x, "QueryProp", P_ARMOUR_TYPE }),
              AT_BOOT }) ) );
    if (!sizeof(a)) call_out("aua", 0);
    // if (!sizeof(a)) aua();
  }
  return;
}

aua()
{
  int s;
  write (bs("Aua! Du schneidest Dir Deine Fuesse an ein paar Scherben "
    "auf. Vielleicht solltest Du das naechste Mal Deine Fuesse besser "
    "schuetzen?"));
  say (bs(CAP_TPN+" schreit ploetzlich auf, als " +
        TP->QueryPronoun() + " sich an ein Paar Scherben verletzt."));
  s=QueryProp(P_SCHERBEN);
  TP->do_damage(s-random(s/5), 0);
}
