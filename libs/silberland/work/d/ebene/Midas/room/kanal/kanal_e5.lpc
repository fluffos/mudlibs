** details: 38, read det: 0, special det: 0, sounds: 0, smells: 0, exits: 1.
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Kanalisation");
  SetProp (P_INT_LONG,
    "Du befindest Dich in der Kanalisation von Midas. Dunkle Gaenge "+
    "fuehren nach Osten und Westen hin ins Ungewisse. Irgendetwas unter "+
    "Deinen Fuessen fuehlt sich weich an.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ("kanalisation", "Du befindest Dich in ihr.\n");
  AddDetail ("stadt", bs(
    "Du befindest Dich unter ihr.\n"));
  AddDetail ( ({"wand","waende"}),
    "Die kahlen Waende geben ein trostloses Bild ab.\n");
  AddDetail ("decke", "Die Decke ueber Dir ist feucht und grauenhaft.\n");
  AddDetail ("boden", bs(
    "Den feuchten Boden der Kanalisation von Midas sollte man wohl besser "+
    "nicht barfuss betreten. Zum Glueck hat jedoch hier einmal jemand eine "+
    "Bodenmatte liegenlassen, die verhindert, dass Du Dir an etwaigen "+
    "Scherben oder sonstigem Geruempel die Fuesse aufschneidest."));
  AddDetail ( ({"bodenmatte", "matte"}), bs(
    "Die Bodenmatte erweist sich bei naeherer Untersuchung als ein Stueck "+
    "Teppichrest und schuetzt Dich hier vor dem Boden sowie dem, was auf "+
    "ihm so herumliegt in einer Kanalisation. Allerdings ist er nicht "+
    "sehr gross, wenn Du weitergehst, wirst Du ihn wohl verlassen, was "+
    "dann wohl mit schutzlosen Fuessen passiert...?"));
  AddDetail ( ({"teppichrest", "stoffrest", "rest"}), bs("Der am Boden "+
    "liegende Rest stammt offenbar von einem alten, kostbaren, arabischen "+
    "Teppich. Du wunderst Dich, dass es Leute gibt, die so etwas wegwerfen."));
  AddDetail ("teppich", bs("Alles was von ihm uebrig ist, ist der "+
    "Stoffrest, der am Boden liegt."));
  AddDetail ("scherben", bs(
    "Hier bist Du der Bodenmatte sei Dank noch vor Ihnen sicher, aber "+
    "wer weiss, was Dich in den Tiefen der dunklen Gaenge erwartet...? - "+
    "Es ist sicher keine schlechte Idee, sich gut darauf vorzubereiten."));
  AddDetail ("gang", "Der Gang ist dunkel und fuehrt ins Ungewisse.\n");
  AddDetail ("gaenge", "Die Gaenge sind dunkel und fuehren ins Ungewisse.\n");
  AddDetail ("kaelte", "Brrr, hier ist es wirklich kalt... hoffentlich "+
    "hast Du waermende Kleidung!\n");
  AddSmell (DEFAULT_SMELL, "Irgendwie riecht es hier ziemlich vermodert...\n");
  AddSound (DEFAULT_SOUND, bs(
    "Eine beunruhigende Stille herrscht hier. Hier und da bildest Du Dir "+
    "ein, Schritte zu hoeren, aber Du musst Dich wohl taeuschen... Ab und "+
    "zu hoerst Du das leise Plaetschern von Wasser."));
  AddSound ("stille", "Keineswegs eine beruhigende Stille...\n");
  AddSound ("schritte", bs("Da waren doch Schritte... oder nicht? Du bist "+
    "Dir wirklich nicht sicher, beschliesst aber, bei der weiteren "+
    "Erkundung etwas vorsichtiger zu sein."));
  AddSound ( ({"plaetschern", "wasser"}), bs(
    "An manchen Stellen in der Wand tritt etwas Wasser aus, dessen "+
    "leises Plaetschern Du vernehmen kannst. Es gibt dem Ort eine "+
    "irgendwie unheimliche Atmosphaere..."));
  AddDetail ( ({"untersuchung"}),
    "Du untersuchst alles ganz genau. ;-)");
  AddDetail ( ({"ungewisse", "ungewisses"}),
    "Wenn Du nicht dorthin gehst, wirst Du es nie erfahren...");
  AddDetail ( ({"tiefe", "tiefen"}),
    "Die Gaenge fuehren wohl noch viel tiefer hinab. Wohin wohl?");
  AddDetail ( ({"stueck"}),
    "Du denkst   . o O ( Ein Stueck vom Glueck waer fein! )");
  AddDetail ( ({"glueck"}),
    "Du hast wirklich Glueck, dass Du hier unten bist und noch lebst!");
  AddDetail ( ({"leute"}),
    "Aber die koennen sich das wohl auch leisten.");
  AddDetail ( ({"geruempel"}),
    "Hm, eigentlich kann man sich ausser an Scherben wohl sonst nur an "+
    "Messer oder alten Klingen die Fuesse aufschneiden. Beides siehst Du "+
    "hier nicht.");
  AddDetail ( ({"fuesse", "fuss"}),
    "Du stehst mit beiden Fuessen fest auf der Bodenmatte. Gut so!");
  AddDetail ( ({"dank"}),
    "Du bedankst Dich bei der Bodenmatte.\n"
    "Die Bodenmatte macht einen anmutigen Knicks.\n"
    "HAE?!?!? Du kratzt Dich verwirrt am Kopf.\n");
  AddDetail ( ({"kopf"}),
    "Dein Kopf ist noch da, wo er sein sollte. Du atmest erleichtert auf.");
  AddDetail ( ({"knicks"}),
    "So anmutig es eine Bodenmatte halt hinkriegt... Naja.");
  AddDetail ( ({"idee"}),
    "Eine gute Idee kann einem das Leben retten.");
  AddDetail ( ({"leben"}),
    "Leben ist vergaenglich.");
  AddDetail ( ({"freie"}),
    "Da ist es nicht gar so beengend wie hier.");
  AddDetail ( ({"midas"}),
    "Du befindest Dich in der Kanalisation von Midas.");
  AddDetail ( ({"atmosphaere"}),
    "Sie ist irgendwie... unheimlich. Bedrohlich.");
  AddDetail ( ({"ort"}),
    "Schau Dich doch einfach um!");
  AddDetail ( ({"stelle", "stellen"}),
    "Du untersuchst die Stellen ganz genau, findest aber nichts "+
    "Besonderes.");
  AddDetail ( ({"erkundung"}),
    "Viel Glueck dabei!");
  AddDetail ( ({"bild", "bilder"}),
    "Nein, Bilder sind hier nirgendwo aufgehaengt. ;-)");
  AddDetail ( ({"wasser"}),
    "Ein wenig davon tritt aus einigen Stellen in den Waenden aus.");
  // DETAILS END

  NewDoor ("oben", "./../room_e5",
    ({"gitter", "kanalgitter"}), ({
    D_LONG, "Das Kanalgitter fuehrt nach oben ins Freie.\n",
    D_GENDER, NEUTER,
    D_SHORT, "Ein %ses Kanalgitter.",
    D_NAME, "Kanalgitter",
    D_MSGS, ({"nach oben", "klettert durch ein Kanalgitter", "kommt heraufgeklettert" }) }) );

  // EXITS START
  AddExit ("osten", "./kanal_f5");
  AddExit ("westen", "./kanal_d5");
  // EXITS END

  // ITEMS START
  // ITEMS END
}
