inherit "/d/ebene/Midas/room/kanal/kanal_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  AppendProp(P_INT_LONG, "Eine kleine Leiter fuehrt hinab.\n");

  AddDetail("leiter",
    "Sie fuehrt hinunter ins Ungewisse.\n");
  AddDetail( ({"ungewisse","ungewisses"}),
    "Nichts genaures weiss man nicht.");
  AddDetail( ({"nichts"}),
    "Du kannst nicht einfach nichts untersuchen. Wie soll denn das gehen?");

  SetProp (P_SCHERBEN, 16);
  AddExit("norden", "./kanal_f5");
  AddExit("unten", "./kanal2_f6");
  AddItem(NPC "kanalratte", REFRESH_DESTRUCT);
}
