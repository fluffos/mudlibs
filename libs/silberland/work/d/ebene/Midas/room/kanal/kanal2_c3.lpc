/*
** Waechterwohnung  (w) Woody@SL
** Midas Kanalisation, Ebene 2
** ---
** 96-08-01  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:8]));
  SetProp (P_INT_LONG, bs(
  "Du stehst mitten im Vorraum, der sich nach Westen hin weiter "+
  "erstreckt. Nach Sueden hin scheint ein Schlafraum anzuschliessen, "+
  "nach Norden hin kannst Du in einem Zimmer einige Tische und Stuehle "+
  "erkennen, offenbar der Essraum. Ansonsten findest Du hier nichts, was "+
  "Deine Aufmerksamkeit erregt. Eben ein gewoehnlicher Vorraum."));

  SetProp (P_INT_SHORT, "Ein Vorraum");

  AddDetail ("kanalisation", "Du befindest Dich in ihr.\n");
  AddDetail ("stadt", "Du befindest Dich weit unter ihr.\n");
  AddDetail ("schlafraum", "Weiter im Sueden!\n");
  AddDetail ( ({"essraum", "tische", "stuehle"}), "Weiter im Norden!\n");
  AddDetail ( ({"wand","waende"}),
    "Die Waende sind mit einer geschmacklosen Tapete ueberzogen.\n");
  AddDetail ("tapete", "Die Tapete traegt ein geschmackloses Linienmuster.\n");
  AddDetail ( ({"linienmuster", "muster"}),
    "Dein Blick verliert sich in dem Linienmuster der Tapete.\n");
  AddDetail ("decke", "Die Decke ueber Dir wurde weiss angemalt.\n");
  AddDetail ("boden", bs(
    "Der Boden ist mit hellbraunen Fliessen ausgelegt. Nicht sonderlich "+
    "sorgfaeltig, aber immerhin doch einigermassen regelmaessig."));
  AddDetail ("fliessen", "Die Fliessen sind hellbraun und erstrecken "+
    "sich ueber den gesamten Boden.\n");

  AddExit ("westen", "./kanal2_b3");
  AddExit ("sueden", "./kanal2_c4");
  AddExit ("norden", "./kanal2_c2");
}
