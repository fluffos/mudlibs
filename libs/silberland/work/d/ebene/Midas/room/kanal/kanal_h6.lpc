/*
** Feuerraum in der Kanalisation von Midas  (w) Woody@SL
** ---
** 96-06-22  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:80]));
  SetProp (P_INT_LONG, bs(
  "Huch, wer haette das gedacht? Hier ist offenbar ein unterirdischer "+
  "Heizraum, der die ganze Stadt mit Fernwaerme versorgt! Entsprechend "+
  "heiss ist es hier auch, und Du kommst gewaltig ins Schwitzen ob der "+
  "aus dem in der Ecke stehenden Ofen zuengelnden Feuerspitzen, die den "+
  "Raum hell erleuchten. Nur ein Gang fuehrt hier raus."));

  SetProp (P_INT_SHORT, "Heizraum");
  // SetProp (P_KILL_NAME, "Ein Haufen Scherben");

  AddDetail ("kanalisation", "Du befindest Dich in ihr.\n");
  AddDetail ("stadt", "Du befindest Dich unter ihr.\n");
  AddDetail ( ({"wand","waende"}),
    "An den Waenden tanzen die vom Feuer geworfenen Schatten auf und ab.\n");
  AddDetail ("schatten", "Sie tanzen den Tanz des Todes.\n");
  AddDetail ("tanz", "Die Schatten wollen Dich damit wohl warnen.\n");
  AddDetail ("decke",
    "Auf der Decke tanzen die vom Feuer geworfenen Schatten.\n");
  AddDetail ("boden",
    "Der Boden ist hier ziemlich warm. Vermutlich vom Feuer.\n");
  AddDetail ("gang", "Der Gang ist dunkel und fuehrt ins Ungewisse.\n");

  AddExit("westen", "./kanal_g6");
}
