/*
** Waechterwohnung  (w) Woody@SL
** Midas Kanalisation, Ebene 2
** ---
** 96-08-01  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include "files.h"

string spruch();

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:8]));
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich auf einer Toilette. Neben den ueblichen sanitaeren "+
  "Einrichtungen an solchen Orten kannst Du eine Rolle Klopapier sowie "+
  "eine alte Zeitung erkennen. Ausserdem sind an der Wand diverse "+
  "Sprueche zu lesen."));

  SetProp (P_INT_SHORT, "Eine Toilette");

  AddDetail ("kanalisation", "Du befindest Dich in ihr.\n");
  AddDetail ("toilette", "Ein anderes Wort fuer WC.\n");
  AddDetail ("wc", "Ein anderes Wort fuer Abort.\n");
  AddDetail ("abort", "Englisch fuer \"abbrechen\".\n");
  AddDetail ("stadt", "Du befindest Dich weit unter ihr.\n");
  AddDetail ( ({"sprueche", "spruch"}), "Versuchs mal mit Lesen!\n");
  AddReadDetail ( ({"sprueche", "spruch"}), #'spruch);
  AddDetail ("vorraum", "Weiter im Norden!\n");
  AddDetail ( ({"wand","waende"}),
    "Die Waende sind mit einer geschmacklosen Tapete ueberzogen, ueber "+
    "die diverse sinnvolle und weniger sinnvolle Sprueche verteilt sind.");
  AddDetail ("tapete", "Die Tapete traegt ein geschmackloses Linienmuster.\n");
  AddDetail ( ({"linienmuster", "muster"}),
    "Dein Blick verliert sich in dem Linienmuster der Tapete.\n");
  AddDetail ("decke", "Die Decke ueber Dir wurde weiss angemalt.\n");
  AddDetail ("boden", bs(
    "Der Boden ist mit hellbraunen Fliessen ausgelegt. Nicht sonderlich "+
    "sorgfaeltig, aber immerhin doch einigermassen regelmaessig."));
  AddDetail ("fliessen", "Die Fliessen sind hellbraun und erstrecken "+
    "sich ueber den gesamten Boden.\n");
  AddDetail ("einrichtungen", "Die sanitaeren Einrichtungen hier scheinen "+
    "leider ausser Betrieb zu sein.\n");
  AddDetail ("zeitung",
    "Eine bunt bedruckte Zeitung liegt am Boden rum, nichts wertvolles.\n");
  AddReadDetail ("zeitung",
    "Dies waere zwar der richtige Ort zum Zeitunglesen (zumindest DIESE "+
    "Zeitung), aber Du hast doch noch wichtigeres zu tun...");
  AddDetail ( ({"rolle", "klopapier"}), "Du betrachtest die Rolle Klopapier "+
    "etwas naeher und kannst den Schriftzug\n'Schmirgelweich' erkennen, "+
    "ausserdem faellt Dir auf, dass es sich bei dem\nPapier wohl eigentlich "+
    "um Schmirgelpapier handelt.\n"+
    "Du denkst noch . o O ( Die spinnen, die Waechter... )\n");

  AddExit ("norden", "./kanal2_b3");
}

string spruch()
{
  switch (random(10))
  {
    case 0:
      return "Der alte Bettler im Gaffodorf hat bestimmt den Plan!\n";
    case 1:
      return "Ohne Plan bist Du verloren...\n";
    case 2:
      return "Geben ist seliger denn nehmen!\n";
    case 3:
      return "Betrete diesen Ort in dem Zustand, in dem Du ihn verlassen willst!\n";
    case 4:
      return "Papier ist geduldig. Und manchmal auch reissfest.\n";
    case 5:
      return "Lesen ist seliger denn schreiben.\n";
    case 6:
      return "Eine Million Fliegen koennen nicht irren!\n";
    case 7:
      return "Und vergiss nicht: Die Wahrheit steht geschrieben...\n";
    case 8:
      return "Dein Leben zu leben ist so schwer, dass es vor Dir noch keiner probiert hat...\n";
    case 9:
      return "Es gibt immer zwei Gruende, etwas zu tun: einen guten und einen wahren.\n";
  }
}
