#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

string haken = 0;
int haken_befestigt = 0;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_INT_LONG,
    "Du folgst den Gaengen weiter ins Ungewisse. Du kannst eine Ecke "+
    "ausmachen, offenbar macht der Gang hier einen Knick. Es wird nach "+
    "Norden hin eine Spur kuehler, ein feuchter Luftzug zieht Dir ins "+
    "Gesicht, die Dunkelheit scheint alle Gefahren verbergen zu wollen. "+
    "Ueberlege Dir jeden Deiner Schritte wohl, bevor Du Hals ueber Kopf "+
    "ins Verderben stuerzt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "dunkelheit" }),
      "Gerade mal den Boden vor Deinen Fuessen kannst Du noch erkennen, "
      "alles weitere kannst Du nicht ausmachen." );
  AddDetail( ({ "boden" }),
      "Der Boden unter Deinen Fuessen fuehrt nach Westen weiter und stoesst "
      "im Osten und Sueden an eine Mauer. Nach Norden hin endet er "
      "urploetzlich vor einem Loch, das in die Tiefe fuehrt." );
  AddDetail( ({ "loch", "tiefe" }),
      "Da hilft wohl nichts, Du wirst wohl oder uebel springen muessen. "
      "Hoffentlich bist Du geschickt genug, um den Absprung richtig "
      "zu erwischen!" );
  AddDetail( ({ "mauer", "mauern" }),
      "Die Mauern im Osten und Sueden sind kahl und feucht." );
  AddDetail( ({ "decke" }),
      "An der Decke siehst Du neben einigen Spinnennetzen einen kleinen "
      "Haken aus Metall. Abgesehen davon ist sie nur feucht und kahl." );
  AddDetail ( ({"absprung"}),
    "Spring doch einfach, Du siehst dann schon, ob Du's ueberlebst ;-)");
  AddDetail ( ({"geschick", "geschicklichkeit"}),
    "Also mit Geschicklichkeit 15 brauchst Du wohl keine Angst mehr haben.");
  AddDetail ( ({"angst"}),
    "Hast Du welche? Wenn, dann sicher nicht ohne Grund.");
  AddDetail ( ({"grund"}),
    "Der Grund ist oft unergruendlich.");
  AddDetail ( ({"fuesse", "fuss"}),
    "Deine Fuesse sind von dem ganzen Dreck hier schon ziemlich schmutzig.");
  AddDetail ( ({"dreck"}),
    "Er liegt ueberall hier rum.");
  AddDetail ( ({"netz", "netze", "spinnennetz", 
                "spinnennetze"}),
    "In den Spinnennetzen an der Decke sind wohl viele kleine Tierchen "+
    "gefangen, sehen kannst Du das aber aus der Entfernung bei der "+
    "Dunkelheit hier nicht.");
  AddDetail ( ({"tierchen"}),
    "So genau willst Du das eigentlich gar nicht wissen.");
  AddSpecialDetail ( ({"haken"}),
    "d_haken" );
  AddDetail ( ({"metall"}),
    "Der Haken scheint aus solidem, rostfreien Metall zu sein. "+
    "Vertrauenserweckend.");
  AddDetail ( ({"fisch", "fische"}),
    "Wo siehst Du hier bitte Fische??? Die haetten in dem Abwasser wohl "+
    "keine allzu hohe Lebenserwartung...");
  AddDetail ( ({"abwasser"}),
    "Das fliesst hier ueberall umher. Kein Wunder, Du bist ja auch in "+
    "einer Kanalisation.");
  AddDetail ( ({"wunder"}),
    "Erwarte keine, dann sind sie umso groesser.");
  AddDetail ( ({"lebenserwartung"}),
    "Auch Deine ist wohl nicht mehr die hoechste hier unten.");
  AddDetail ( ({"seil"}),
    "Tja, jetzt sollte man wohl eines dabei haben...");
  AddDetail ( ({"waesche"}),
    "Deine Waesche siehst Du mit dem Befehl 'ausruestung'.");
  AddDetail ( ({"befehl"}),
    "Alles, was Du hier eintippst, ist ein Befehl an Deinen Charakter, den "+
    "Du steuerst. Daher sind die ja auch immer in Befehlsform. Logisch, "+
    "oder?");
  AddDetail ( ({"charakter"}),
    "Na Du!");
  AddDetail ( ({"befehlsform"}),
    "Auch Imperativ genannt.");
  AddDetail ( ({"imperativ"}),
    "Oder Konjunktiv?");
  AddDetail ( ({"konjunktiv"}),
    "Akkusativ, Akkusativ!");
  AddDetail ( ({"akkusativ"}),
    "Romanes eunt domus!");
  AddDetail ( ({"romanes"}),
    "Menschen genannt Roemer gehen das Haus?");
  AddDetail ( ({"haus", "menschen", "roemer"}),
    "Es soll heissen: Roemer, geht nach Hause!");
  AddDetail ( ({"hause"}),
    "Romani ite domum!");
  AddDetail ( ({"romani"}),
    "Die spinnen, die Roemer.");
  AddDetail ( ({"entfernung"}),
    "Zu weit jedenfalls.");
  AddDetail ( ({"ecke"}),
    "Die Ecke ist direkt vor Deiner Nase, da, wo die beiden Waende "+
    "aufeinander treffen. Wie es fuer Ecken halt so ueblich ist.");
  AddDetail ( ({"nase"}),
    "Du fasst Dir an die eigene Nase. Noch dran!");
  AddDetail ( ({"gefahr", "gefahren"}),
    "Du wirst sie noch rechtzeitig kennenlernen!");
  AddDetail ( ({"gesicht"}),
    "Mitten in Deinem Gesicht sitzt Deine Nase.");
  AddDetail ( ({"hals", "kopf"}),
    "Das sagt man doch nur so. Oder ist es doch eher woertlich gemeint?");
  AddDetail ( ({"knick"}),
    "Ein Knick ist ein Knick ist ein Knick. Muss man Dir alles "+
    "beschreiben?");
  AddDetail ( ({"luftzug"}),
    "Wuaeh, der ist irgendwie grauenerregend!");
  AddDetail ( ({"spur"}),
    "Ein bisschen halt. Wobei, eine Spur koennte auch auf dem Boden sein. "+
    "Du schaust genauer - und entdeckst in der Tat einige Spuren, die jaeh "+
    "vor dem Loch im Norden enden!");
  AddDetail ( ({"spuren"}),
    "Sie fuehren wohl in den sicheren Tod.");
  AddDetail ( ({"tod"}),
    "Wer den Tod erwartet, braucht wohl nur den Spuren folgen...");
  AddDetail ( ({"tat"}),
    "Von auf frischer Tat ertappt kann hier aber keine Rede mehr sein.");
  AddDetail ( ({"rede"}),
    "Du haeltst jetzt hoffentlich keine!");
  AddDetail ( ({"ungewisse", "ungewisses", "verderben"}),
    "Wenn das Ungewisse zur Gewissheit wird, ist es oft schon zu spaet.");
  AddDetail ( ({"gewissheit"}),
    "Du hast gerade mal die Gewissheit ueber das Ungewisse.");
  // DETAILS END

  // EXITS START
  AddExit("westen", "./kanal2_f5");     // solange mit seil gesichert - geht das nicht
  AddExit("norden", "./kanal2_g4");     // ...
  AddExit("sueden", "./kanal2_g6");     // ...
  AddExit("test", ([ EX_FUNC : "north" ]) );
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"loese", "loes"}), "loese");
  AddCmd ( ({"sicher", "sichere"}), "sichere");
}


mixed north(string ex)
{
  write("Du machst einen unvorsichtigen Schritt nach Norden...\n");
  if (haken && (getuid(TP) == haken))
  {
    write(
        "...und bist im naechsten Moment sehr froh, dass Du Dich zuvor\n"
        "mit einem Seil abgesichert hast. Allerdings baumelst Du jetzt\n"
        "etwas hilflos in der Luft...\n");
    TP->move(ROOM "kanal/kanal2_g4_baumel", M_GO | M_NO_SHOW,
        "nach Norden", "geht", "baumelt herein");
    return 1;
  }
  write("...und stuerzt in einen Abgrund!\n");
  TP->move(ROOM "kanal/kanal2_g4_boden", M_GO | M_NO_SHOW,
      "nach Norden", "geht", "stuerzt herunter");
  return 1;
}


void set_haken(mixed str) {
  haken = objectp(str) ? getuid(str) : str;
  haken_befestigt = time();
}


string query_haken() {
  return haken;
}


void check_haken()
{
  object ob;

  if (!haken)
    return;

  if (haken && !(ob = find_player(haken)))
    set_haken(0);

  if (environment(ob) != ME)
    // hmmm er koennte aber auch in g7 sein und noch gesichert sein!
    set_haken(0);

  // ...
}


string d_haken()
{
  check_haken();

  return
    break_string(
      "An dem Haken kannst Du Waesche aufhaengen. Oder frische Fische. Oder "
      "Dich vielleicht mit einem Seil absichern. Wer weiss, wozu der noch gut "
      "sein kann." +
      (haken ?
         (haken == getuid(TP) ?
            " Du hast Dich mit einem Seil am Haken gesichert." :
            sprintf(" %s hat sich mit einem Seil am Haken gesichert.",
                    capitalize(haken))) :
         ""),
      78);
}


int sichere (string str)
{
  string womit;
  object ob;

  if (!str)
    return notify_fail("Was genau willst Du machen?\n"), 0;

  // "mich"/"dich" kann man wegkuerzen...
  if (str[0..4] == "dich ")
    str = str[5..];
  else if (str[0..4] == "mich ")
    str = str[5..];
  // " ab" hinten kann man auch wegkuerzen
  if (str[<3..] == " ab")
    str = str[0..<4];

  if (!sscanf(str, "%san haken", womit))
    return notify_fail("Woran willst Du Dich absichern?\n"), 0;
  else
    str = womit[0..<2];

  if (!sscanf(str, "mit %s", womit))
    return notify_fail("Womit willst Du Dich absichern?\n"), 0;

  if (!ob=present(womit,TP))
    return write("Aber das hast Du doch gar nicht bei Dir!\n"), 1;

  if (!ob->id("seil"))
    return write("Du solltest schon besser ein Seil nehmen!\n"), 1;

  check_haken();
  if (haken == getuid(TP))
    return write("Aber das hast Du doch schon gemacht!\n"), 1;

  if (haken)
    return write("Das geht leider nicht, solange " +
        capitalize(haken) + " noch mit einem Seil gesichert ist.\n"), 1;

  write(
      break_string(
        "Gekonnt wirfst Du Dein Seil hoch, bindest das andere Ende um "
        "Deinen Bauch, machst eine Schlaufe und sicherst Dich so ab. "
        "Du kannst das Seil natuerlich jederzeit wieder loesen.", 78));
  say(
      break_string(
        TP->Name() + " wirft ein Seil gekonnt hoch zu einem Haken, bindet "
        "sich das andere Ende um " + TP->QueryPossPronoun(MALE, WEN) +
        " Bauch und sichert sich so ab.", 78));

  // Idee: Seil mit veraenderter P_SHORT in Raum moven und P_NOGET machen.
  // BUG: Finsternis Meldung in living/moving::move() - 5-er array mit random(4) !!!

  set_haken(TP);
  return 1;
}

int loese (string str)
{
  if (!str)
    return notify_fail ("Was willst Du loesen?\n"), 0;

  if (str=="raetsel" || str=="quest")
    return write("So leicht geht das nun auch wieder nicht!\n"), 1;

  if ( (str != "seil") && (str != "seil von haken") )
    return write("Was Du alles loesen willst...\n"), 1;

  check_haken();
  if (!haken)
    return write("Da ist kein Seil, das Du loesen koenntest!\n"), 1;

  if (haken != getuid(TP))
    return write("Du kannst das Seil doch nicht loesen, waehrend " +
        capitalize(haken) + " daran gesichert ist!\n"), 1;

  write("Mit einer geschickten Handbewegung loest Du das Seil wieder "
        "vom Haken.\n");

  say("Mit einer geschickten Handbewegung loest " + TP->name() +
      " das Seil wieder vom Haken.\n");

  set_haken(0);
  return 1;
}
