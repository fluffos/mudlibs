inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:8]));
  SetProp (P_INT_SHORT, "Raum der Nacht");
  SetProp (P_INT_LONG,
      "Ploetzlich findest Du Dich in einem seltsamen Raum wieder. Alles hier "
      "wirkt irgendwie so elegant, ganz anders als alles, was Du bisher hier "
      "unten gesehen hast. Decke und Waende sind schwarz und aus "
      "undefinierbarem Material, ab und zu meinst Du, kleine Sternchen "
      "glitzern zu sehen, aber das ist wohl eher ein Produkt Deiner "
      "Einbildung. Der Boden besteht aus elegantem, kaltem Marmor und "
      "ist sehr glatt, sodass Du Dich hier gut bewegen kannst ohne Gefahr "
      "zu laufen, ueber irgendetwas zu stolpern.");

  AddDetail( ({"raum"}),
    "Du stehst mittendrin, sieh Dich doch einfach um!");
  AddDetail( ({"boden"}),
    "Der Boden wurde mit Marmor ausgelegt und wirkt sehr elegant und kalt.");
  AddDetail( ({"waende","wand"}),
    "Die Waende sind tiefschwarz und aus einem undefinierbaren, aber "
    "samtaehnlichen Material. Ab und zu glitzern kleine Sternchen auf, "
    "bildest Du Dir zumindest ein.");
  AddDetail( ({"decke"}),
    "Die Decke ueber Dir ist tiefschwarz und faellt nur durch ein seltsames "
    "ab und zu sichtbares Funkeln auf.");
  AddDetail( ({"marmor"}),
    "Sehr kalt, sehr elegant, und sehr glatt.");
  AddDetail( ({"material"}),
    "Du befuehlst das Material der Waende und stellst fest, dass es entfernte "
    "Aehnlichkeit mit Samt hat, aber wesentlich kaelter ist.");
  AddDetail( ({"samt"}),
    "Samt ist fuer gewoehnlich sehr weich und elegant.");
  AddDetail( ({"sternchen","sterne","stern"}),
    "Du bist Dir sicher, Ewigkeiten vom freien Himmel entfernt zu sein, "
    "und doch bildest Du Dir ein, das Funkeln der Sterne zu sehen, nein, "
    "vielmehr zu spueren.");
  AddDetail( ({"funkeln","glitzern"}),
    "Eben wieder hast Du ein Funkeln und Glitzern an der Wand bemerkt - "
    "Du greifst sofort danach und tastest die Wand ab, kannst jedoch nichts "
    "als dieses seltsame, undefinierbare Material spueren.");
  AddDetail( ({"produkt","einbildung"}),
    "Du denkst . o O ( Wie real ist real? )");
  AddDetail( ({"gefahr"}),
    "Sie lauert auf Dich, ueberall...");
  AddDetail( ({"aehnlichkeit"}),
    "Aber wirklich nur entfernt. Das Material fuehlt sich einfach fremd an.");
  AddDetail( ({"himmel"}),
    "Irgendwie ist er hier praesent.");
  AddDetail( ({"schwaerze","dunkel"}),
    "Deine Augen gewoehnen sich nicht an das Dunkel. Es bleibt schwarz.");
  AddDetail( ({"augen"}),
    "Deine zwei Augen rollen wild in ihren Augenhoehlen umher.");
  AddDetail( ({"augenhoehle","augenhoehlen"}),
    "Wenn Du sie nicht haettest, was wuerdest Du dann nur mit Deinen "
    "Augen machen?");
  AddDetail( ({"ewigkeit","ewigkeiten"}),
    "Wie lange hast Du Zeit?");
  AddDetail( ({"zeit"}),
    "Die Zeit vergeht. Bald ist es zu spaet!");
  AddDetail( ({"geraeusch","geraeusche"}),
    "Geraeusche sind zum lauschen da.");

  AddSound (DEFAULT_SOUND,
      "Es ist absolut still hier. Die Schwaerze des Raumes "
      "scheint auch Geraeusche zu verschlucken...");
  AddSmell (DEFAULT_SMELL,
      "Es riecht seltsam hier... nach Lavendel.");
  AddSmell ( ({"lavendel","lavendelduft"}),
      "Der Lavendelduft betoert Dich etwas.");

  AddExit("sueden", "./kanal2_e5");

  AddItem (NPC "nachtkaempfer", REFRESH_DESTRUCT);
}
