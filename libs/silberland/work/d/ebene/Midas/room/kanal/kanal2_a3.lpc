inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  SetProp (P_INT_LONG, bs(QueryProp(P_INT_LONG)+
    "In Osten fuehrt eine kleine Holztuere in etwas, das auf den ersten "+
    "Blick wie eine Wohnung aussieht."));
  AddDetail ("wohnung", bs("Du wunderst Dich, wer in so einer trostlosen "+
  "Umgebung wohl eine Wohnung baut. Vermutlich wohl die Waechter, die "+
  "sich hier offenbar schon eingelebt haben..."));
  //AddReadDetail ("schild",
  //  "Auf dem Schild steht: Questbaustelle, bitte warten :-)\n");

  // AddExit("norden", "./kanal2_a2");
  AddExit("sueden", "./kanal2_a4");
  NewDoor ("osten", "./kanal2_b3",
    ({"tuere", "tuer", "holztuere", "holztuer"}), ({
    D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
    D_LONG, "Eine kleine Holztuere, "+
            "die in eine Art Wohnung zu fuehren scheint.\n",
    D_SHORT, "Eine %se Holztuere.",
    D_GENDER, FEMALE,
    D_NAME, "Holztuere" }) );
}
