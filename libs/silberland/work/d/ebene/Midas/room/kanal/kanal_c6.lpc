inherit "/d/ebene/Midas/room/kanal/kanal_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

int mauer;

create()
{
  ::create();

  SetProp(P_INT_LONG, "\t"+
      bs( QueryProp(P_INT_LONG)+
          "Im Boden entdeckst Du ein Loch und ein paar Sprossen, die nach "
          "unten fuehren.") + "@@mauer@@");

  AddSpecialDetail( ({"durchgang", "mauer"}), "d_mauer");
  AddDetail("kasten", "Du hast keine Ahnung, wozu der Kasten da oben gut "
      "sein soll, und an ihn ran kommst Du auch nicht, dazu haengt er zu "
      "weit oben.");
  AddDetail("boden",
    "Im Boden siehst Du ein Loch.");
  AddDetail("loch",
    "Ein paar Sprossen fuehren durch das Loch nach unten.");
  AddDetail("sprossen",
    "Sie fuehren ins Ungewisse nach unten.");
  AddDetail( ({"ungewisse","ungewisses"}),
    "Nichts genaures weiss man nicht.");
  AddDetail( ({"nichts"}),
    "Du kannst nicht einfach nichts untersuchen. Wie soll denn das gehen?");

  AddExit("unten",
      ([ EX_DEST: "./piazza_c6",
         EXG_ID: "lambtonechse",
         EXG_PLMSG: "Die Lambtonechse versperrt Dir den Weg.\n",
         EXG_RMMSG: "@Wer@ versucht, nach unten zu gehen, "
           "kommt aber an der Lambtonechse nicht vorbei.\n" ]) );

  AddItem(NPC "lambtonechse", REFRESH_DESTRUCT);

  mauer=1;
}

string mauer()
{
  if (mauer)
    return "Eine Mauer versperrt den Durchgang im Osten.\n";
  else
    return "";
}

string d_mauer()
{
  if (mauer)
    return bs(
      "Du fragst Dich, ob man die Mauer irgendwie ueberwinden kann. "
      "Dabei wandert Dein Blick ueber die gesamte Flaeche - und bleibt "
      "ganz oben bei einem seltsamen Kasten haengen.");
  else
    return "Die Mauer ist verschwunden, der Weg nach Osten ist frei.\n";
}

void reset()
{
  ::reset();
  if (!mauer) {
    tell_room(ME, "Du vernimmst ein bedrohlich lautes Rumpeln.\n"
        "Vielleicht solltest Du zusehen, dass Du hier wegkommst...?\n");
    call_out("rumpeln", 15);
  }
}

void rumpeln()
{
  if (mauer) return;    // Falls inzwischen wer gedreht hat...
  mauer=1;
  RemoveExit("osten");
  tell_room(ME,
      "Ploetzlich schiebt sich eine Mauer vor den Durchgang im Osten.\n");
  call_other(KANAL "kanal_d6", "mauer", 1);
}

void halterung()
{
  mauer=!mauer;
  call_other(KANAL "kanal_d6", "mauer", mauer);

  if (mauer)
    RemoveExit("osten");
  else
    AddExit("osten", "./kanal_d6");

  tell_room(ME, "Du hoerst urploetzlich ein lautes Rumpeln...\n"+
      bs(
        (mauer ?
         "Aus heiterem Himmel schiebt sich eine Mauer vor den Durchgang "
           "im Osten!" :
         "Auf einmal verschwindet die Mauer und gibt einen Durchgang "
           "nach Osten frei! Dir schaudert ein wenig...")));
}

