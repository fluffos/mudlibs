inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_INT_LONG, bs(
  "Du befindest Dich in der unteren Kanalisation von Midas. Schwaerzeste "+
  "Nacht herrscht hier, die Waende sind feucht und kuehl. Im Norden kannst "+
  "Du hinter einem Gitter aus Stahlrohren so etwas aehnliches wie eine "+
  "Gefaengniszelle erkennen, @@gef@@."));

  AddDetail ( ({ "stahlrohre", "rohre" }), bs(
    "Durch die Stahlrohre des Gefaengnisgitters gibt es kein Entrinnen, "+
    "wer raus will muss das Gitter schon aufbekommen. In die Zelle "+
    "zu gelangen ist da wohl deutlich einfacher."));
  AddSpecialDetail ( ({"zelle", "gefaengniszelle"}), "d_gef");

  AddItem (NPC "waechter", REFRESH_DESTRUCT);

  NewDoor ("norden", "./kanal2_f7",
    ({"gitter", "gefaengnisgitter"}), ({
    D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY,
    D_LONG, "Ein Gefaengnisgitter, das aus festen Stahlrohren besteht.\n"+
            "Ohne Schluessel gibt es da wohl kein Durchkommen.\n",
    D_SHORT, "Ein %ses Gefaengnisgitter.",
    D_GENDER, NEUTER,
    D_NAME, "Gefaengnisgitter" }) );

  AddExit("westen", "./kanal2_e8");
  AddExit("osten", "./kanal2_g8");
}

int leerzelle()
{
  object ob;
  call_other(KANAL "kanal2_f7", "");
  for (ob=first_inventory(find_object(KANAL "kanal2_f7")); ob; ob=next_inventory(ob))
  {
    if (living(ob)) return 0;
  }
  return 1;
}

string d_gef()
{
  if (leerzelle())
    return "Sie scheint im Moment leer zu sein.\n";
  else
    return bs("Irgendjemand scheint in ihr gefangen zu sein. Mehr kannst "+
      "Du jedoch nicht erkennen.");
}

string gef()
{
  if (leerzelle())
    return "die jedoch leer zu sein scheint";
  else
    return "in der sich offenbar jemand befindet";
}

