inherit "/d/ebene/Midas/room/kanal/kanal2_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <wizlevels.h>
#include "files.h"

int rad;    // Positionen: 0 (zu), 1, 2, 3, 4, 5

create()
{
  ::create();

  SetProp(P_INT_LONG,
      "Du bist irgendwie in eine Sackgasse geraten - hier geht es "
      "offenbar nicht mehr weiter. Auch hier herrscht schwaerzeste "
      "Nacht, alles ist feucht und kuehl, so richtig ausladend.");

  AddDetail( ({"nacht"}),
      "Verdammt dunkel hier!\n");
  AddDetail( ({"gasse","sackgasse"}),
      "Du befindest Dich in ihr.\n");
  AddDetail( ({"wand","waende"}),
      "Die kahlen Waende sind feucht und ziemlich kuehl, wie ueberall "
      "hier unten. An der Suedwand faellt Dir irgendetwas auf.");
  AddDetail( ({"suedwand"}),
      "Du bemerkst ein kleines Handrad.\n");
  AddDetail( ({"handrad","rad"}),
      "Bestimmt kann man es drehen.\n");

  AddExit("norden", "./kanal2_g5");
  AddCmd( ({"dreh","drehe"}), "drehe" );

  rad=2;
}

void reset()
{
  ::reset();
  if (rad<2) {
    rad++;
    tell_room(ME, "Das kleine Handrad lockert sich etwas.\n");
    AddDetail( ({"handrad","rad"}),
        "Bestimmt kann man es drehen.\n");
  }
}

int drehe(string str)
{
  string *w;
  string was;
  mixed wie,obs;

  notify_fail("Was willst Du drehen?\n");
  if (!stringp(str)) return 0;
  w=explode(str," ");
  was=w[0]; wie=implode(w[1..]," ");
  if (!member((["rad","handrad"]),was)) return 0;

  notify_fail("In welche Richtung willst Du das Handrad drehen?\n");
  wie = ([ "nach links":1, "nach rechts":-1,
           "in uhrzeigersinn":-1, "in gegenuhrzeigersinn":1,
           "im uhrzeigersinn":-1, "im gegenuhrzeigersinn":1 ])[wie];
  if (!wie) return 0;

  if (rad==0) {
    write(bs("Du versuchst an dem Rad zu drehen, aber es bewegt sich "
        "keinen Millimeter weit. Offenbar hat da schon vor Dir jemand "
        "rumgespielt..."));
    say(TP->Name()+" versucht vergeblich, das kleine Handrad zu drehen.\n");
    obs = filter_array(all_inventory(), #'living) - ({ TP });
    if ((random(10) < 4) && sizeof(obs)) {
      obs=obs[random(sizeof(obs))];
      tell_object(obs,"Du kannst Dich nicht beherrschen und musst kichern.\n");
      tell_room(ME, obs->Name()+" kann sich nicht beherrschen "
          "und gibt ein albernes Kichern von sich.\n", ({obs}));
    }
  } else if (rad==5 && wie==1) {
    write(bs("Du versuchst, das Rad noch ein Stueck im Gegenuhrzeigersinn "
        "zu drehen, scheiterst aber. Offenbar hast Du bereits den Anschlag "
        "erreicht."));
    say(TP->Name()+" versucht vergeblich, das kleine Handrad zu drehen.\n");
  } else {
    rad+=wie;
    if (!rad) {
      write(bs("Du drehst das Rad noch ein Stueck im Uhrzeigersinn, "
          "bis es ploetzlich mit einem vernehmlichen Klicken einrastet."));
      say(TP->Name()+
          " dreht an einem kleinen Handrad, bis dieses einrastet.\n");
      AddDetail( ({"handrad","rad"}),
          "Es wurde bis zum Anschlag zugedreht.\n");
    } else {
      write(bs("Du drehst das kleine Handrad eine Umdrehung nach "+
          ([1:"links", -1:"rechts"])[wie]+".\n" ));
      say(TP->Name()+" dreht an einem kleinen Handrad.\n");
    }
  }
  return 1;
}

int QueryWheel()
{
  return rad;
}

