/*
** Seitengasse in Midas  (w) Woody@SL
** ---
** 1996-04-18  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich in einer kleinen Seitengasse inmitten der grossen "+
    "Stadt Midas. Hier werden wohl demnaechst einige Geschaefte eroeffnen, "+
    "jedenfalls bemerkst Du, dass hier rege Bauarbeiten stattfinden. "+
    "Die Gasse macht hier einen Knick von Norden nach Osten. Im Westen "+
    "kannst Du ein maechtiges Gebaeude erkennen, offenbar eine Bank."));

  SetProp (P_INT_SHORT, "Seitengasse in Midas");

  AddDetail ("weg", "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ("knick", "Der Knick fuehrt von Norden, wo Du weiter hinten "+
    "den Mauernweg erkennen kannst, nach Osten weiter durch die Stadt "+
    "hindurch.");
  AddDetail ( ({"gebaeude", "bank"}), "Davon kannst Du bestimmt mehr "+
    "erkennen, wenn Du einfach hineingehst.");

  AddExit ("norden", "./room_c2");
  AddExit ("westen", "./bank/sbank");
  AddExit ("osten", "./room_d3");
}
