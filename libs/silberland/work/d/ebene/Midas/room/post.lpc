/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL (1996). Preserved as post_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Postzentrale von Midas");
  set_long(
    "Du befindest Dich in der Postzentrale von Midas. Von hier aus kannst "
    "Du Briefe an Deine Mitspieler schicken und Briefe von ihnen lesen. "
    "Ruhe vor anderen Anwesenden und dem typischen Stimmengemurmel in "
    "einer Post hast Du, wenn Du eine der Ein-Personen-Kabinen betrittst. "
    "Nach Sueden gelangst Du auf die Hauptstrasse zurueck.\n"
  );
  set_exits(([
    "sueden": "/d/ebene/Midas/room/room_f5",
  ]));
  set_items(([
    "kabinen": "Sie sind gelb. Wie alles hier.\n",
  ]));
  set_noises(([
    "default": "Stimmengemurmel erfuellt den Raum.\n",
  ]));
}
