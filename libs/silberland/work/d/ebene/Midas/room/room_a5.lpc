/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL (1996). Preserved as room_a5_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Hauptstrasse in Midas, Westende");
  set_long(
    "Du befindest Dich nun am westlichen Ende der Hauptstrasse von Midas, "
    "einer alten und wunderschoenen Stadt. Wenn Du nach Osten blickst, "
    "siehst Du eine grosse Menschenmenge, die sich durch die Hauptstrasse "
    "tummelt. Die maechtige Stadtmauer aus grossen Steinen schuetzt das "
    "Westtor.\n"
  );
  set_exits(([
    "osten": "/d/ebene/Midas/room/room_b5",
  ]));
  set_items(([
    "stadtmauer":
    "Die maechtige Stadtmauer ist aus grossen Steinen zusammengefuegt.\n",
    "torbogen":
    "Der Torbogen ist kunstvoll in die maechtige Stadtmauer eingearbeitet.\n",
  ]));
}
