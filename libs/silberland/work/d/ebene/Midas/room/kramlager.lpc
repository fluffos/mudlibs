inherit "std/store";

#include <properties.h>
#include "files.h"

create()
{
  ::create();
  AddItem ("/obj/fackel", REFRESH_REMOVE);
  AddItem ("/obj/seil", REFRESH_REMOVE);
  AddItem ("/obj/schaufel", REFRESH_REMOVE);
  AddItem (OBJ("div/papierfackel"), REFRESH_REMOVE);
  AddItem (OBJ("div/harzfackel"), REFRESH_REMOVE);
  AddItem (OBJ("div/teerfackel"), REFRESH_REMOVE);
  AddItem (OBJ("div/petroleumlampe"), REFRESH_REMOVE);
  AddItem (OBJ("div/petroleumflasche"), REFRESH_REMOVE);
  AddItem ("/obj/thermometer", REFRESH_REMOVE);
}
