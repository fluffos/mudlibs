inherit "/d/ebene/Midas/room/hauptstrasse_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  AddExit("norden", "./kneipe");
  AddExit("osten", "./room_c5");
  AddExit("westen", "./room_a5");
}

void reset()
{
  ::reset();
  if (dtime()[9..11] == "Dez")
    AddExit("sueden", "/d/ebene/lamuerte/burg/shop/punschstand");
  else
    RemoveExit("sueden");
}
