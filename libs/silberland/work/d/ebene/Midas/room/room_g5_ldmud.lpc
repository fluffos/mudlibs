inherit "/d/ebene/Midas/room/hauptstrasse_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"


create()
{
  ::create();
  SetProp (P_INT_LONG,
    bs(QueryProp(P_INT_LONG)+
    "Nach Sueden hin kannst Du durch einen kleinen Torbogen "+
    "hindurch einen kleinen Kieselweg betreten." ));
  AddDetail ( ({"torbogen", "bogen"}),
    bs("Der Torbogen besteht aus schwarzem, massiven Gusseisen. "+
    "Ein kleines Schild ist an der Seite befestigt."));
  AddDetail ("schild",
    "Ein kleines, rechteckiges Schild aus Blech. Es steht etwas drauf.\n");
  AddDetail ("blech", "Gewoehnliches, billiges Blech. Nichts besonderes.\n");
  AddReadDetail ("schild", "Auf dem Schild steht mit kunstvollen "+
    "Buchstaben gemalt:\n"+
    "  Z u r   K i r c h e\n"+
    "  kirchliche Trauungen, Entfluchungen, Beichte\n");
  AddDetail ( ({"gusseisen", "eisen"}),
    "Es scheint sich um ein sehr solides Material zu handeln.\n");
  AddDetail ("kieselweg",
    bs("Der Kieselweg im Sueden scheint deutlich weniger besucht "+
    "zu sein als die breite Hauptstrasse."));

  AddItem (NPC "fraggle", REFRESH_DESTRUCT);

  AddExit("osten", "./room_h5");
  AddExit("westen", "./room_f5");
  AddExit("sueden", "./room_g6");
}
