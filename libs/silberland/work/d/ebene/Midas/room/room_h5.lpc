inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich nun am oestlichen Ende der Hauptstrasse von "+
    "Midas, einer alten und wunderschoenen Stadt. Wenn Du nach Westen "+
    "blickst, siehst Du eine grosse Menschenmenge, die sich durch die "+
    "Hauptstrasse tummelt. Auch der Boden scheint im Westen besser "+
    "ausgebaut zu sein. Im Osten hingegen erblickst Du ein gewaltiges "+
    "Stadttor, durch das Du die Stadt hinaus ins Ungewisse verlassen "+
    "kannst."));

  SetProp (P_INT_SHORT, "Hauptstrasse in Midas, Ostende");

  AddDetail ("stadt", bs(
    "Nach Westen hin erhebt sich Midas, eine alte, wunderschoene "+
    "Stadt, ihre Haeuser bestehen groesstenteils aus sorgfaeltig "+
    "zusammengefuegten Steinen, die Wege sind gleichmaessig "+
    "gepflastert und trotz der vielen sie durchstroemenden "+
    "Abenteurer sehr sauber."));
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ( ({"wand","mauer","mauerwand"}), bs(
    "Die Mauerwand ist kalt und besteht aus sehr gleichfoermigen, "+
    "glatten Steinen. Ein Ueberklettern der Mauer erscheint Dir "+
    "unmoeglich, Du beschliesst daher, lieber den maechtigen Torbogen "+
    "zu durchschreiten, um die Stadt zu verlassen."));
  AddDetail ( ({"stein","steine"}), "Grosse Bloecke aus Stein bilden "+
    "die Grundlage fuer die maechtige Mauer.\n");
  AddDetail ( ({"stadttor","torbogen","tor","bogen"}), bs(
    "An dem kunstvollen Torbogen wurde offensichtlich lange gearbeitet, "+
    "jedenfalls hast Du selten zuvor ein so praechtiges Stadttor gesehen. "+
    "Ausser vielleicht am Westende von Midas."));
  AddDetail ( ({"ostende"}), bs(
    "Da befindest Du Dich grade. Alles, was weiter oestlich liegt, gehoert "
    "nicht mehr zur Stadt Midas. Dem gemaess ist das hier das Ostende."));
  AddDetail ( ({"westende"}), bs(
    "Das Westende von Midas befindet sich viel weiter im Westen. Wie "
    "nicht anders zu erwarten. Schliesslich bist Du hier ganz im Osten..."));
  AddDetail ( ({"menge", "menschenmenge"}),
    "Die Menschenmenge im Westen scheint kein Ende zu nehmen.\n");
  AddDetail ("ende", "Du befindest Dich am oestlichen Ende der Stadt.\n");
  AddDetail ( ({"strasse","weg","boden","steinpflaster"}), bs(
    "Der Boden besteht hier aus fester Erde und scheint nach Westen hin "+
    "in ein gleichfoermiges Muster aus Pflastersteinen ueberzugehen.\n"));
  AddDetail ("pflastersteine", "Wie gesagt, im Westen.\n");
  AddDetail ("muster",
    "Die Pflastersteine der Stadt wurden offensichtlich sehr sorgfaeltig "+
    "verlegt.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ("erde",
    "Sie ist fest wie auf einem ausgetrampelten Pfad in einem Dorf.\n");

  AddItem (NPC "soeldner", REFRESH_DESTRUCT);
  AddItem (NPC "soeldner", REFRESH_DESTRUCT);

  AddExit ("westen", "./room_g5");
  AddExit ("osten", EBENE("creative/feldlager/room/a1_a3"));
  AddExit ("norden", "./room_h4");
  AddExit ("sueden", "./room_h6");
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
