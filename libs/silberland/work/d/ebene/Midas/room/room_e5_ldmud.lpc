inherit "/d/ebene/Midas/room/hauptstrasse_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  NewDoor ("unten", KANAL "kanal_e5",
    ({"gitter", "kanalgitter"}), ({
    D_LONG, "Das Kanalgitter fuehrt nach unten ins Ungewisse.\n",
    D_GENDER, NEUTER,
    D_SHORT, "Ein %ses Kanalgitter.",
    D_NAME, "Kanalgitter",
    D_TESTFUNC, "darf_durch",
    D_MSGS, ({"nach unten",
      "klettert durch ein Kanalgitter", "kommt heruntergeklettert" }) }) );

  AddExit("osten",  "./room_f5");
  AddExit("westen", "./room_d5");
  AddExit("norden", "./laden");
}

int darf_durch()
{
  return 0;
  if (present("kanal\npassierschein", TP)) return 0;
  write("Du darfst derzeit leider nicht durch.\n");
  return 1;
}
