/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL (1996-2003). Preserved as kneipe_saal_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Speisesaal der Kneipe 'Zur roten Nase'");
  set_long(
    "Du befindest Dich im Speisesaal der grossen Stadtkneipe 'Zur roten "
    "Nase'. Die Einrichtung ist hier deutlich vornehmer als nebenan: "
    "Baenke und Stuehle sind gepolstert, der Boden besteht aus teurem "
    "Parkett, die Waende sind von feinen Tapeten ueberzogen. An einem "
    "der Tische siehst Du eine Speisekarte.\n"
  );
  set_exits(([
    "westen": "/d/ebene/Midas/room/kneipe",
  ]));
  set_items(([
    "speisekarte": "Eine edle Speisekarte fuer wohlhabende Abenteurer.\n",
    "parkett": "Der Boden besteht aus allerfeinstem Parkett.\n",
  ]));
  set_reads(([
    "speisekarte": "Spezialitaeten: Wildschweinbraten, Eowyns Suppe, Druidenomelette.\n",
  ]));
}
