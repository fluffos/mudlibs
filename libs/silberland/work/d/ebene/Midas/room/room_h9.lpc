#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Am Fusse eines Aussichtsturms");
  SetProp (P_INT_LONG,
    "Du stehst hier am Fusse eines hohen Aussichtsturms inmitten der "+
    "Stadt Midas. Eine kleine enge Treppe fuehrt hinauf auf den Turm, "+
    "waehrend Du nach Nordwesten zu einem alten Weg entlang der "+
    "Innenseite der Stadtmauer gelangst, die sich weiter nach Norden und "+
    "Westen hoch hinauf erhebt, um die Stadt vor Eindringlingen und "+
    "anderen Gefahren zu schuetzen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ("innenseite",
    "Das ist die der Stadt zugewandte Seite, und da bist Du grade.");
  AddDetail ("aussenseite",
    "Das ist die der Stadt abgewandte Seite, jenseits der Mauer.");
  AddDetail ("seite",
    "Alles hat mehrere Seiten. Die Mauer immerhin zwei, aussen und innen.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ( ({"stadtmauer","mauer"}), bs(
    "Die maechtige Stadtmauer ist aus grossen Steinen zusammengestellt und "+
    "vermittelt ein Gefuehl von Sicherheit, das den Einwohnern dieser Stadt "+
    "wohl ihre fast schon stoische Ruhe verleiht.\n"));
  AddDetail ( ({"steine","bloecke","steinbloecke"}), bs(
    "Grosse, schwere Steinbloecke bilden die Grundlage fuer die maechtige "+
    "Stadtmauer. Nur wenige Fugen durchsetzen die Mauer.\n"));
  AddDetail ("fugen", "Sie wurden mit Moertel sorgfaeltig ausgefuellt.\n");
  AddDetail ("moertel", "Weisser Moertel fuellt die Fugen.\n");
  AddDetail ("sicherheit", "Ein gutes Gefuehl, findest Du nicht?\n");
  AddDetail ("ruhe", "Hoffentlich behaeltst Du sie!\n");
  AddDetail ("gefuehl",
    "Ein Gefuehl laesst sich nicht so ohne weiteres beschreiben.\n");
  AddDetail ( ({"einwohner","leute"}), bs(
    "Die Leute, die hier leben, nennt man Einwohner. :-)"));
  AddDetail ( ({"orks","orkstaemme","goblins","goblinstaemme"}), bs(
    "Sie leben ausserhalb der Stadt Midas in ihren Lagern und Siedlungen "+
    "und stellten fuer Midas eine grosse Gefahr da, ehe die Einwohner die "+
    "maechtige Stadtmauer zum Schutze errichteten.\n"));
  AddDetail ( ({"gefahr","eindringlinge"}), bs(
    "Die maechtige Stadtmauer schuetzt die Einwohner wirkungsvoll "
    "vor Eindringlingen und anderen Gefahren."));
  AddDetail ("weg", "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas", "rande", "rand"}),
    "Du befindest Dich am Rande der maechtigen Stadt Midas.\n");
  AddDetail ( ({"fuss","fusse"}), bs(
    "Da stehst Du grade, und zwar am Fusse des Aussichtsturms. Und "
    "hoffentlich auch auf Deinen eigenen zwei Fuessen :)"));
  AddDetail ( ({"fuesse"}),
    "Goenn ihnen doch mal wieder etwas Wasser!\n");
  AddDetail ( ({"wasser","waschen"}),
    "Wasser ist zum Waschen da...\n");
  AddDetail ( ({"aussichtsturm", "turm"}),
    "Der hohe Aussichtsturm befindet sich unmittelbar vor Deiner Nase. Du "+
    "kannst ihn ueber eine kleine enge Treppe erklimmen. Auf halber "+
    "Hoehe zum Turm erkennst Du noch den Wachweg, auf dem die "+
    "Kampfsoldaten fuer gewoehnlich ihren Dienst versehen.");
  AddDetail ( ({"hoehe"}), bs(
    "Auch wenn Du das grade nicht meintest: Die Hoehe des Aussichtsturms "+
    "ist wahrlich schwindelerregend!"));
  AddDetail ( ({"treppe"}),
    "Die Treppe wirkt eng und gefaehrlich, dennoch duerfte sie Dich gerade "+
    "noch tragen koennen, wenn Du geschickt genug bist.");
  AddDetail ( ({"nase"}),
    "Die sitzt mitten in Deinem Gesicht...");
  AddDetail( ({"dienst","kampfsoldaten"}),
      "Die Kampfsoldaten versehen ihren Dienst auf dem Wachweg, den "
      "Du ueber Dir erkennen kannst. Sie sorgen fuer Ruhe und Ordnung.");
  AddDetail( ({"ordnung"}),
      "Ordnung muss sein! Besonders dort, wo viele Leute zusammenleben...");
  AddDetail( ({"wachweg"}),
      "Der Wachweg ueber Dir wird von Kampfsoldaten bevoelkert, die "
      "von dort oben den Ueberblick ueber die Stadt bewahren und so "
      "fuer Ruhe und Ordnung sorgen koennen.");
  AddDetail( ({"ueberblick"}),
      "Von dem Wachweg ueber Dir kein Problem!");
  AddDetail( ({"problem"}),
      "Hoffentlich hast Du keines mit den Kampfsoldaten!");
  AddSpecialDetail ( ({"gesicht"}), "d_gesicht");
  // DETAILS END

  // EXITS START
  AddExit ("oben", "./wachweg_h9");
  AddExit ("nordwesten", "./room_g8");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

string d_gesicht()
{
  say(TP->Name(WER)+" hat gerade sein Gesicht verloren.\n");
  return "Du verlierst Dein Gesicht. Wie aergerlich!\n";
}

