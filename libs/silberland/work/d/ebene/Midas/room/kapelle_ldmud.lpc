inherit "std/room";

#include <properties.h>
#include <config.h>
#include "files.h"

string tafel();

create()
{
  ::create();
  SetProp (P_LIGHT,1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "Du befindest Dich in einer kleinen Kapelle, in der Du beten kannst, "+
    "um wieder Deine natuerliche Gestalt zu erhalten. Am noerdlichen Ende "+
    "steht ein Altar, auf dem sich ein grosses Kreuz befindet. Neben dem "+
    "Altar haengt eine Heldentafel. In den Waenden siehst Du herrliche "+
    "Fenster, durch die tagsueber das Licht bunt hereinscheint. Nach Sueden "+
    "gelangst Du wieder auf die belebte Hauptstrasse."));
  SetProp (P_INT_SHORT,"Kapelle");

  AddDetail ("kapelle", "Du stehst mittendrin.\n");
  AddDetail ( ({"ende","altar"}),
    "Er ist aus Stein gehauen und nicht besonders schoen.\n");
  AddDetail ( ({"sandstein", "stein"}), "Schlichter Sandstein, noch nicht "+
    "mal Marmor...\n");
  AddDetail ( "marmor", "Den musst Du wohl woanders suchen!\n");
  AddDetail ( ({"holzkreuz", "kreuz"}), "Ein schlichtes Holzkreuz.\n");
  AddDetail ("holz", "Tatsaechlich, es ist Holz, zwei Stuecke, zu einem "+
    "Kreuz zusammengebunden.\n");
  AddDetail ( ({"stueck", "stuecke"}),
    "Zwei davon wurden zu einem Kreuz zusammengebunden.\n");
  AddDetail ("fenster", "Die Fenster sind wunderschoen und bestehen aus "+
    "herrlich buntem Glas.\n");
  AddDetail ("glas", "Das Glas der Fenster ist herrlich bunt.\n");
  AddDetail ( ({"wand", "waende"}), "An den Waenden siehst Du nichts "+
    "besonderes.\n");
  AddDetail ( ({"kerze", "kerzen"}), "Auja, und ein paar rote Kerzen siehst "+
    "Du auch noch.\n");
  AddDetail ( ({"tageslicht", "licht"}), "Das Tageslicht erscheint durch "+
    "die bunten Fenster in den herrlichsten Farben.\n");
  AddDetail ("farben", "Ein buntes Farbspektrum leuchtet Dir durch die "+
    "Fenster entgegen.\n");
  AddDetail ("farbspektrum", "Jemand teilt Dir mit: Hei, nun uebertreibs "+
    "mal nicht!\n");
  AddDetail ("boden", "Der Boden besteht aus Stein, wie der Altar, "+
    "jedoch dunkler.\n");
  AddDetail ("decke", "An der Decke entdeckst Du schoene Malereien.\n");
  AddDetail ("malereien", "Sie zeigen Himmel, Engel, Figuren...\n");
  AddDetail ("himmel", "Er ist nur gemalt!\n");
  AddDetail ( ({"engel", "figuren"}), "Sie sind nur gemalt!\n");
  AddDetail ( ({"hauptstrasse", "strasse"}), bs(
    "Die Hauptstrasse befindet sich im Sueden. Sie ist wesentlich "
    "belebter und lauter als die besinnliche Ruhe hier herinnen.\n"));
  AddDetail ( "ruhe", "Pssssssssssst!!!\n");
  AddDetail( ({"helden", "tafel", "heldentafel", "menschheit"}),
    "Die Heldentafel haengt neben dem Altar. Auf ihr sind die groessten "
    "Helden der Menschheit eingetragen. Du kannst sie lesen.");
  AddReadDetail( ({"heldentafel", "tafel"}), #'tafel);

  AddSpecialDetail( "gestalt", "d_gestalt" );

  AddCmd ("bete","bete");
  AddExit ("sueden","./room_d5");
}


int bete(string str)
{
  mixed shell;

  write("Du kniest nieder und haeltst eine kurze Andacht.\n");

  if (TP->QueryProp(P_GHOST))
  {
    say("Der Geist von "+TP->name()+
        " kniet nieder und haelt eine kurze Andacht.\n");
    write("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "+
      "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "+
      "durchstroemt.\n");
    say(TP->name()+" erscheint ploetzlich wieder in "+
      "koerperlicher Form.\n");
    TP->SetProp(P_GHOST,0);
  }
  else
  {
    say(TP->Name() + " kniet nieder und haelt eine kurze Andacht.\n");
    if ( (str == "um neuen koerper") ||
         (str == "um einen neuen koerper") )
    {
      // Erneuern nur, wenn 1. shell geladen und 2. neuer als Spielershell
      shell = MASTER->get_userinfo(getuid(TP));
      if (pointerp(shell)) {
        if (stringp(shell = shell[4])) {
          shell = find_object(shell);
          if (objectp(shell) && (program_time(shell) > program_time(TP)))
          {
            MASTER->renew_player_object(TP);
            return 1;
          }
        }
      }
      write("Dein Gebet wird nicht erhoert.\n");
    }
  }
  return 1;
}

string tafel()
{
  TP->more("/etc/topmenschen.read",1);
  return "";
}

string d_gestalt()
{
  return TP->long();
}

