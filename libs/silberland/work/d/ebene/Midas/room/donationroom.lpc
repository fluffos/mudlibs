inherit "std/room";

#include <properties.h>
#include <new_skills.h>
#include <moving.h>
#include "files.h"
#include "donation.h"


void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Im Spendenraum");
  SetProp(P_INT_LONG,
      "Du stehst in einer grossen, geraeumigen Halle. Viele Regale stapeln "
      "sich, meterhoch tuermt sich alter Krimskrams und metallene aber auch "
      "lederne Ruestungen schimmern Dir entgegen. Bla laber fasel.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE ]) );

  AddCmd( "spende", "cmd_spende" );
}


int ItemAccepted(object ob, string err)
{
  mapping r;
  string at;

  if (at = ob->QueryProp(P_NO_DONATE)) {
    err = stringp(at) ? at : ob->Name(WER,1) + " kann nicht gespendet werden.";
    return 0;
  }
  if (!ob->QueryProp(P_ARMOUR_TYPE) && !ob->QueryProp(P_WEAPON_TYPE)) {
    err = ob->Name(WER,1) + " ist weder eine Ruestung noch eine Waffe.";
    return 0;
  }
  if (ob->QueryProp(P_AUTOLOADOBJ)) {
    err = ob->Name(WER,1) +
      " ist rebootfest und kann daher nicht gespendet werden!";
    return 0;
  }
  if (ob->QueryProp(P_VALUE) > 5000) {
    err = ob->Name(WER,1) + " ist zu wertvoll.";
    return 0;
  }
  if (ob->QueryProp(P_NOSELL)) {
    err = ob->Name(WER,1) + " kannst Du hier leider nicht spenden.";
    return 0;
  }
  /*
  // Licht/Schattenitems akzeptieren??
  if (ob->QueryProp(P_LIGHT)) {
    err = ob->Name(WER,1) + " kann leider nicht akzeptiert werden.";
    return 0;
  }
  */
  if (ob->QueryProp(P_HIT_FUNC) || ob->QueryProp(P_DEFEND_FUNC)) {
    err = ob->Name(WER,1) + " ist zu maechtig.";
    return 0;
  }
  if (mappingp(r = ob->QueryProp(P_WEAR_RESTRICTIONS) ||
                   ob->QueryProp(P_WIELD_RESTRICTIONS)))
  {
    // Die folgenden Einschraenkungen sind noch tolerierbar:
    if (sizeof(r - ([ P_GENDER, SR_EXCLUDE_RACE, SR_INCLUDE_RACE, P_FROG ]) ))
    {
      err = ob->Name(WER,1) + " hat zuviele Einschraenkungen.";
      return 0;
    }
  }
  if ( (ob->QueryProp(P_WC) + ob->QueryProp(P_DAMAGED)) > 160) {
    err = ob->Name(WER,1) + " ist zu stark.";
    return 0;
  }
  if (at = ob->QueryProp(P_ARMOUR_TYPE))
    if ( (ob->QueryProp(P_AC) + ob->QueryProp(P_DAMAGED)) >=
         KEEP_ARMOUR_CLASS[at])
    {
      err = ob->Name(WER,1) + " ist zu stark.";
      return 0;
    }
  if (at = ob->QueryProp(P_DONATED)) {
    err = ob->Name(WER,1) + " ist doch schon einmal gespendet worden" +
      (stringp(at) ? ", und zwar von " + capitalize(at) : "") + "!";
    return 0;
  }

  return 1;
}


void ModifyDonatedItem(object ob)
{
  // Wenn nicht eh schon gesetzt: unverkaeuflich machen
  if (!ob->QueryProp(P_NOSELL))
    ob->SetProp(P_NOSELL, 1);

  /*
  // Licht/Schattenitems entwerten?
  if (ob->QueryProp(P_LIGHT))
    ob->SetProp(P_LIGHT, 0);
  */

  // An gespendeten Objekten kann man nichts lernen
  ob->AddId(SID_NOLEARN);

  // Spender im Objekt erfassen
  ob->SetProp(P_DONATED, getuid(TP));

  ob->SetProp(P_LONG, QueryProp(P_LONG) +
      ob->Name(WER,1) + " weist eine kleine Markierung auf.\n");
  ob->AddDetail("markierung", "Sie kennzeichnet " + ob->name(WEN,1) +
      "als gespendetes Objekt.\n");

}


int cmd_spende(string arg)
{
  string err;
  object ob, schrotti;

  if (!arg)
    return notify_fail("WAS moechtest Du spenden?\n"), 0;

  if (!schrotti = present("lagerverwalter"))
    return notify_fail("Du kannst nichts spenden, solange der Lagerverwalter "
        "nicht da ist.\n"), 0;

  ob = present(arg, TP);
  if (!ob)
    return notify_fail("So etwas hast Du nicht dabei.\n"), 0;

  if (ob->QueryProp(P_NODROP))
    return write("So wirst Du " + ob->name(WEN,1) + " nicht los.\n"), 0;

  if (!ItemAccepted(ob, &err))
  {
    write(break_string(err, schrotti->Name(WER,1) + " sagt: ", 78));
    return 1;
  }

  if (ob->move(ROOM "donationlager", M_PUT) != 1)
  {
    write(break_string("Du kannst " + ob->name(WEN,1) + " nicht ablegen!",
          schrotti->Name(WER,1) + " sagt: ", 78));
    return 1;
  }

  ModifyDonatedItem(ob);

  // Phase 3: Lagerung
  // - Gegenstand wandert ins Lager
  // - Spender wird in Liste eingetragen
}

