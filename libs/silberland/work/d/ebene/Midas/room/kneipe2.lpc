inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <pub.h>
#include "files.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Kneipe 'Zur roten Nase'");

  // SetProp (P_INT_LONG, bs(...))  -> _query_long()

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "max");
  SetProp(P_PUBKEEPER_NAME, "der Wirt");
  SetProp(P_PUBMSG_NOKEEPER,
      "Max, der Wirt ist nicht da...\n"
      "Aber vielleicht ist er nebenan, und Du kannst nach ihm rufen?\n");
  SetProp(P_PUBMSG_NOENEMY, bs("Aber Du kaempfst doch gerade mit Max, glaubst "
      "Du im Ernst, dass er Dir dann auch noch etwas servieren wuerde???"));
  SetProp(P_PUBMSG_NOINVITE, bs("Max denkt gar nicht daran, seinen Gegnern "
      "auch noch etwas zu servieren."));
  SetProp(P_PUBMSG_FIGHTING, "Max ist im Moment zu beschaeftigt.\n");

  AddDetail ( ({"stadtkneipe","kneipe"}), bs(
    "Du befindest Dich gerade in ihr und wuerdest Dich am liebsten "+
    "fuer etwas laengere Zeit hier niederlassen, um Dich zu erholen.\n"));
  AddDetail ( ({"wand","waende","holz"}), bs(
    "Die Waende sind innen mit sauber gearbeitetem Holz ausgekleidet "+
    "und verleihen der Kneipe eine sehr eigene, urige Gemuetlichkeit.\n"));
  AddDetail ("gemuetlichkeit", "Eine feine Sache, das.\n");
  AddDetail ("boden",
    "Der Boden besteht aus sorgfaeltig verlegten Holzbohlen.\n");
  AddDetail ( ({"holzbohlen","bohlen"}),
    "In ihnen befindet sich ueberraschend wenig Staub.\n");
  AddDetail ("decke", "Sie befindet sich direkt ueber Dir.\n");
  AddDetail ("staub", "Sowas siehst Du hier nicht. Ehrlich!\n");
  AddDetail ( ({"westwand","tafel"}),
    "Du kannst die Tafel an der Westwand mit dem Befehl <menue> lesen.\n");
  AddDetail ("ausgang", "Er befindet sich im Sueden.\n");
  AddDetail ("sueden", bs(
    "Du koenntest die Kneipe nach Sueden hin verlassen. Andererseits "+
    "gefaellt es Dir hier so gut, dass Du am liebsten noch Stunden "+
    "hier rumhaengen wuerdest...\n"));
  AddDetail ( ({"speisesaal","saal"}), bs(
    "Im Osten erblickst Du einen sehr vornehm wirkenden weiteren "+
    "Saal, der wohl fuer hungrigere Abenteurer gedacht ist. Du "+
    "vernimmst mit Entzuecken den Geruch saftiger Steaks von "+
    "Wildschweinen des benachbarten Waldes.\n"));
  AddDetail ("ausschank",
    "Hinter diesem erkennst Du eine Menge komplizierter Apparaturen, an "
    "denen der Wirt Max fuer gewoehnlich seine Arbeit verrichtet.");
  AddDetail ( ({"menge","apparatur","apparaturen"}),
    "Aus ihnen fliesst wohl das begehrte kuehle Nass, das die Gaeste "
    "hier erfrischt.");
  AddDetail ( "nass",
    "Ob Du den Mut hast, auch was zu bestellen?");
  AddDetail ( "mut",
    "Feigling, Feigling!");
  AddDetail ( "feigling",
    "Du kleiner Feigling! Bestell Dich!");
  AddDetail ( ({"gast","gaeste"}),
    "Bist Du einer von ihnen?");
  AddDetail ("nase",
    "Als Du Max naeher betrachtest, wird Dir ploetzlich klar, wie die "+
    "Kneipe zu ihrem Namen kam.");
  AddDetail ("besitzer", "Das ist Max, der Wirt hinter dem Ausschank.");
  AddDetail ( ({"tisch","tische","stuhl","stuehle","sessel",
    "bank","baenke"}), "Davon stehen etliche hier rum.");
  AddDetail ("mann",
    "Er sitzt an einem der Tische und schluerft ein Glaeschen Wein.");
  AddDetail ("wein",
    "Der Wein hier soll ganz vorzueglich sein.");
  AddDetail ( ({"mahlzeit","mahlzeiten"}), "Versuch's mal nebenan!");
  AddDetail ( ({"getraenke","getraenk","angebot"}),
    "Wenn Dich das hiesige Angebot interessiert, so tippe 'menue'.");

  AddSmell ( ({ DEFAULT_SMELL, "geruch" }), bs(
    "Ein leichter Dunst liegt in der Luft, von nebenan jedoch kannst "+
    "Du den Geruch von duftendem Wildschweinbraten erkennen."));
  AddSound (DEFAULT_SOUND,
    "Die Kneipe wird von leisem Stimmengemurmel erfuellt.\n");
  AddSound ( ({ "stimmen", "stimmengemurmel", "gemurmel", "saetze" }),
    "Du kannst nur zusammenhanglose Saetze erkennen.\n");

  AddDrink("Leitungswasser", ({"leitungswasser", "wasser"}),
           1, 0, 0, 1,
           ({
             "Max bringt Dir ein Glas Leitungswasser. "+
             "Als er wieder geht, hoerst Du ihn\nnoch brummeln: 'Solche "+
             "Gaeste koennen mir gestohlen bleiben'...",
             "&& wuergt ein Glas Leitungswasser runter."}));

  AddDrink("Mineralwasser", ({"mineral", "mineralwasser", "soda"}),
           20, 1, 0, 1,
           ({
             "Max bringt Dir Dein Glaeschen Mineral. "+
             "Schmeckt etwas abgestanden...",
             "&& schuettet gierig ein Glaeschen Mineral runter."}));

  AddDrink("Traubensaft", ({"traubensaft", "saft"}),    // Name, IDs,
           35, 8, 0, 5,                       // Preis, LP, Alk, Saettigung,
           ({"Max bringt Dir ein Glas dunkelroten Traubensaft, das Du sofort "+
             "genuesslich\naustrinkst. Dabei kleckerst Du Dich natuerlich "+
             "an... wie ungeschickt!",
             "&& trinkt genuesslich ein Glas mit dunkelrotem Traubensaft.\n"+
             "Natuerlich kleckert &1 sich dabei an..."}));

  AddDrink("Cola a'la Dusty", ({"cola", "coke", "coca"}),
           45, 10, 0, 4,                       // Preis, LP, Alk, Saettigung,
           ({"Max bringt Dir ein Glas schwarzer, prickelnder Fluessigkeit, "
             "die Du in einem\nSchluck austrinkst. Das erfrischt irgendwie "
             "ungemein...\n"
             "Max sagt: Und vergiss nicht, bei uns heisst es DAS Cola!",
             "&& trinkt genuesslich ein Glas Cola a'la Dusty.\n"
             "Max sagt zu &3: Und vergiss nicht, bei uns heisst es DAS Cola!"}));

  AddDrink("Orangensaft", ({"osaft", "o-saft", "orangensaft"}),
           50, 12, 0, 5,
           ({"Max bringt Dir Deinen eisgekuehlten Orangensaft.",
             "&& trinkt mit Behagen ein Glas eisgekuehlten Orangensaft."}));

  AddDrink("Wein", "wein", 100, 20, 4, 4,
           ({"Max bringt Dir Dein Glaeschen Wein. Die Temperatur... der "+
             "Geschmack...\nalles perfekt! Naja fast... er korkt ein wenig.",
             "&& geniesst ein Glaeschen Wein."}));

  AddDrink("Kleiner Feigling",
      ({"feigling", "kleiner feigling", "kleinen feigling"}),
      150, ({15,25}), 10, 3,
           ({"Max bringt Dir Deinen kleinen Feigling.\n"+
             "Du schaust Dich kurz um und hoffst, dass Dich keiner "
             "beobachtet, schliesslich willst Du nicht, dass man von "
             "Deiner Bestellung auf Dich schliesst. Schnell und gar "
             "nicht feige kippst Du ihn runter. Ploetzlich fuehlst "
             "Du Dich furchtbar mutig.",
             "&& schaut sich verstohlen um und kippt dann irgendwas "
             "runter. Leider kannst Du es nicht genau erkennen, aber "
             "offenbar war es gar nicht so schlecht, && jedenfalls "
             "scheint deutlich gestaerkt zu sein." }));

  AddDrink("Birnenschnaps", ({"birnenschnaps", "schnaps"}), 120, 28, 20, 2,
           ({"Max bringt Dir Deinen Birnenschnaps.\n"+
             "Kurz brennt er in Deinem Rachen... doch schon ist es vorbei "+
             "und Du atmest erleichtert und wie innerlich gereinigt durch.",
             "&& kippt ein Stamperl Birnenschnaps runter, roechelt "+
             "einige Male,\natmet aber kurz darauf erleichtert durch."}));

  AddDrink("Blue Frog",
           ({"frog", "blue frog"}),
           150, 0, 1, -10,
           "trinke_frog");

  AddDrink("Magic Tonic", ({"magic tonic", "magic", "tonic"}),
           300, ({ 0, 20, 25 }), 1, 6,
           ({ "Max bringt Dir ein Glas mit einer stark perlenden, "
              "durchsichtigen Fluessigkeit, die Du rasch austrinkst. "
              "In Deinem ganzen Koerper scheint das magische Getraenk "
              "nun zu kribbeln... Du fuehlst Dich wie aufgeladen.",
              "&& bekommt von Max eine stark perlende Fluessigkeit "
              "serviert, die &1 rasch austrinkt. Ploetzlich beginnt &1 "
              "zu zucken..." }));

  AddDrink("Schwarzer Pirat", ({"schwarzer pirat","pirat"}),
           500, 45, 0, 3, "trinke_pirat");

  AddDrink("Wellenreiter", ({"reiter", "wellenreiter"}),
           250, ({ 50, 60, 20 }), 5, 5,
           ({"Max bringt Dir ein Cocktailglas. Darin befindet sich eine "
             "gruen-blaue Fluessigkeit, die Dich an das Meer im warmen "
             "Sueden erinnert. Deine Gedanken gleiten ab und Du denkst an "
             "die schoenen Stunden, die Du auf Mauritius verbracht hast... "
             "Der Sandstrand, die Feen, die Dir den Ruecken massiert "
             "haben, hach war das schoen!\n"
             "Als Du die Augen wieder aufmachst, merkst Du, dass du den "
             "Cocktail wohl inzwischen ausgeschluerft haben musst. Du "
             "fuehlst Dich so herrlich leicht auf den Fuessen, wunderbar!",
             "&& bekommt einen Cocktail serviert. Vertraeumt setzt &1 "
             "an und schliesst die Augen, dabei schluerft &1 nach und "
             "nach den Cocktail leer."}));

  /*
  AddCmd (({"kauf","kaufe","bestell","bestelle"}),"bestelle");
  AddCmd (({"spendier","spendiere"}),"spendiere");
  AddCmd ("","able",1);
  */
}

string _query_int_long()
{
  if (present("\nmax"))
    return bs(
      "Du befindest Dich in der grossen Stadtkneipe 'Zur roten Nase'. "
      "Hinter dem Ausschank kannst Du Max erkennen, den Besitzer der "
      "Kneipe. Er eilt geschaeftig hin und her und bringt den Gaesten "
      "diverse Getraenke. Er scheint ziemlich kraeftig zu sein und wird "
      "wohl auch mit unerwuenschten Gaesten problemlos fertig. An der "
      "Westwand erblickst Du eine Tafel, die du mit <menue> lesen kannst. "
      "Im Osten scheint ein deutlich vornehmerer Speisesaal zu sein, "
      "in dem man wohl auch groessere Mahlzeiten bekommt. Nach Sueden "
      "kannst Du die Kneipe verlassen.");
  else
    return bs(
      "Du befindest Dich in der grossen Stadtkneipe 'Zur roten Nase'. "
      "Der Ausschank ist zur Zeit nicht besetzt, aber aufgrund der "
      "dutzenden, viel zu komplizierten Apparaturen kommst Du auch nicht "
      "auf die Idee, Dich selbst daran zu versuchen. An der "
      "Westwand erblickst Du eine Tafel, die du mit <menue> lesen kannst. "
      "Im Osten scheint ein deutlich vornehmerer Speisesaal zu sein, "
      "in dem man wohl auch groessere Mahlzeiten bekommt. Nach Sueden "
      "kannst Du die Kneipe verlassen.");
}

int trinke_frog (object z, object e)
{
  tell_object(e,bs(mess(
         "Max grinst Dich an, greift in die Kuehltruhe und bringt "+
         "Dir eine Dose dunkelblauer Fluessigkeit, die Du sofort leerst. "+
         "Dann murmelt er noch: 'Ob &3 jetzt Fluegeln wachsen...?' und "+
         "macht sich grinsend wieder an seine Arbeit.",e)));
  tell_room(ME,bs(e->Name()+" trinkt eine Dose Blue Frog und murmelt: "
         "'Wenn ich nur aufhoeren koennte'... Komisch, "+e->name()+
         " wird doch nicht etwa noch durstiger geworden sein?"), ({e}) );
  if (!e->QueryProp(P_FROG) && !random(5))
  {
    tell_object(e,"\nAuf einmal fuehlst Du Dich so klein und gruen...\n\n"+
           "Max bricht vor Lachen zusammen.\n"+
           "Du streckst ihm die Zunge raus - und kriegst einen gewaltigen "+
           "Schreck.\n");
    tell_room(ME,bs("Auf einmal jedoch schrumpft "+e->name()+
         " zusammen und wird ganz gruen...\n"), ({e}) );
    e->SetProp (P_FROG, 1);
  }
}

int trinke_pirat (object z, object e)  // z=Zahler, e=Empfaenger
{
  object ob;
  tell_object (e, bs(
    "Max streift Gummihandschuhe ueber, giesst vorsichtig eine "+
    "dunkelschwarze Fluessigkeit in ein Glas und bringt es Dir. Kurz "+
    "ueberlegst Du noch... Doch dann ueberwindest Du Dich und schuettest "+
    "das Zeug runter...")+
    "\n\nSchwaerzeste Nacht. Totenstille.\n\n\n");
  tell_room(ME, bs(mess(
    "&& trinkt ein Glas dunkelschwarzer Fluessigkeit und bricht "+
    "zusammen.", e)), ({e}));
  e->SetProp( P_PARALYZED,
       ([
         PARALYZE_TIME : 4+random(3),
         PARALYZE_MSG  : "Aber Du bist doch ohnmaechtig!\n",
         PARALYZE_MSG_OTHER : "%s scheint nervoes zu zucken.\n",
         PARALYZE_END  : bs(
           "Schliesslich kommst Du wieder zu Dir... und langsam erkennst "
           "Du auch Deine Umgebung wieder. Uff... nochmal Glueck gehabt!"),
         PARALYZE_END_OTHER : bs(
           "%s kommt wieder zu sich, sichtlich geschockt, "
           "und dennoch gestaerkt.")
       ])
      );
}
