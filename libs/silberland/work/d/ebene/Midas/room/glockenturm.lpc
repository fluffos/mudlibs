/*
** Glockenturm
** ---
** 12-09-2000 Angrox
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <combat.h>
#include "files.h"
#include "/gilden/nekromanten/nekro_properties.h"
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>

int glocken_zerstoert=0;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Bei den Kirchturmglocken");

  AddDetail ("kirche",
    "Du befindest Dich inmitten der gewaltigen Kirche von Midas.\n");
  AddDetail ( ({"waende","wand","mauer"}), bs(
    "Die Wand um Dich herum wird aus Felsbloecken gebildet. Eine "
    "kleine Oeffnung in selbiger bietet Dir einen atemberaubenden "
    "Blick ueber die Daecher von Midas."));
  AddDetail ( ({"kirchturm", "turm"}),
    "Du befindest Dich hier am hoechsten Punkt der Kirche, im Kirchturm.\n");
  AddDetail ("metall",
    bs("Schweres, solide verarbeitetes Metall, das Dich wohl mit "+
    "Leichtigkeit zu tragen vermag."));
  AddDetail ("boden",
    "Der Boden hier besteht aus relativ glatten Felsbloecken.\n");
  AddDetail ( ({"felsbloecke","bloecke"}),
    "Glatte, aber unbehandelte Felsbloecke bilden den Boden und die Waende "
    "hier.\n");
  AddDetail ("decke", bs(
    "Die Decke kannst Du nicht erkennen, zwei gewaltige Glocken aus "
    "massiver Bronze versperren Dir die Sicht."));
  AddDetail ("punkt", "Hoehenmaessig ist hier gemeint.\n");
  AddDetail ("stadt", "Midas ist hier gemeint.\n");
  AddDetail ("midas", "Der Name der Stadt, auf die Du hier hinabblickst.\n");
  AddDetail ( ({"ausblick", "anblick", "blick"}),
    "Dir stockt der Atem bei diesem wundervollen Ausblick.\n"+
    "Du denkst noch . o O ( Gottseidank bin ich schwindelfrei... )\n");
  AddDetail ("daecher",
    "Die meisten Daecher der Haeuser unter Dir sind zinnoberrot gefaerbt.\n");
  AddDetail ("haeuser",
    bs("Eigentlich siehst Du von den Haeusern nur die Daecher, dennoch "+
    "raubt Dir der Anblick den Atem."));
  AddDetail ("glocken",
    bs("Die beiden gewaltigen Glocken aus massiver Bronze haengen etwa "+
    "zwei Meter ueber Dir. Du kannst eine Inschrift auf ihnen erkennen. "));
    
  AddDetail ("bronze",
    "Massive und auffallend sauber polierte Bronze. Wahrlich prachtvoll.\n");
  AddDetail ("strick",
    bs("Der Strick haengt lose an der Halterung der beiden Glocken "+
    "befestigt. Vermutlich kann man an ihm ziehen, um die Glocken zu "+
    "laeuten..."));
  AddDetail ("halterung",
    bs("Die beiden Glocken sind an einer beweglichen Halterung angebracht, "+
    "ueber die sie zum Laeuten gebracht werden koennen. Ein Strick ist an "+
    "der Halterung befestigt."));
  AddDetail ("inschrift",
    bs("Auf den beiden Glocken kannst Du irgendeine Inschrift erkennen. "+
    "Vielleicht kannst Du sie ja lesen?"));
  AddReadDetail ("inschrift",
    "Du versuchst, die Inschrift zu entziffern, scheiterst aber.\n");
  AddDetail ("hocker",
    "ein kleiner Hocker aus Holz. Nichts besonderes eigentlich.\n");
  AddDetail ("holz",
    "Gewoehnliches Holz, wie gesagt, nichts besonderes.\n");

  AddExit ("unten", ([EX_DEST: "./kirchturm",
                     EX_MSG : "klettert nach unten",
                     EX_PLMSG: "Du kletterst geschickt nach unten.\n"]));

                     
  AddCmd ( ({"zerstoere", "zerstoer"}), "halterung_zerstoeren");
}

int halterung_zerstoeren (string str)
{
  object ob, weap;
  notify_fail ("Was moechtest Du zerstoeren?\n");
  ob=present(NEKRO_TASK_ITEM,TP);
  tell_object(find_player("angrox"), sprintf("OB (glockenturm): %O\n",ob));
  if(!objectp(ob) || (ob->GetNumber()!=1 || !IS_WIZARD(TP)))
  {
    return 0;
  }
  if (!str) return 0;
  if(glocken_zerstoert) { 
    write(BS("Aber die Glockenhalterung ist schon zerstoert!!\n"));
    return 1;
  }
  if ((str!="halterung" && str!="glockenhalterung")) return 0;
  if (!objectp(weap=TP->QueryProp(P_WEAPON))) {
    write(BS("Mit blossen Haenden? Viel Glueck!"));
    return 1;
  }
  if(member(({WT_AXE,WT_CLUB}), weap->QueryProp(P_WEAPON_TYPE))==-1 &&
      weap->QueryProp(P_WC)<150)
  {
    write(BS("Mit dieser laecherlichen Waffe wirst Du nicht viel erreichen!"));
    return 1;
  }
  tell_object(TP, BS("Du schlaegst mit voller Hass gegen die Glockenhalterung, "
      "und mit einem Krachen stuerzen die Glocken herunter!"));
  tell_room(TO, BS(sprintf("%s schlaegt voller Hass gegen die "
          "Glockenhalterung, die meinem Krachen nach unten stuerzt!",TPN)), 
      ({TP}));
  call_other(ob,"SetFlag", 0);
  set_next_reset(1800);
  call_other(ROOM+"kirchturm", "???");
  call_other(ROOM+"kirchturm","set_dingdong_destroyed");
  glocken_zerstoert=1;
  return 1;
}

reset() {
  ::reset();
  glocken_zerstoert=0;
}

string _query_int_long() {
  if(!glocken_zerstoert)
    return BS(
      "Du befindest Dich hier genau neben den zwei Glocken. Sie bestehen "
      "vollkommen aus Bronze und sind mittels einer Halterung am Kirchturm "
      "befestigt. Von hier aus hast Du einen wunderbaren Blick ueber Midas.");
  return BS(
      "Du befindest Dich hier neben einer kaputten Glockenhalterung. Ehemals "
      "haben sie wohl stolze Glocken getragen, doch wurden sie offenbar "
      "ziemlich brutal zerstoert. Von hier aus hast Du aber immerhin einen "
      "wunderbaren Blick ueber Midas.");
}
