inherit "/d/ebene/Midas/room/wegmauer_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  AppendProp (P_INT_LONG, bs(
      "Nach Westen fuehrt eine kleine Treppe zu einem schmalen "
      "Wachweg hinauf, der sich entlang der Stadtmauer rund um "
      "Midas erstreckt. Auf ihm versehen die Kampfsoldaten ihren "
      "Dienst, um fuer Ruhe und Ordnung in der Stadt zu sorgen."));
  AddDetail( ({"treppe"}),
      "Die Treppe westlich von Dir fuehrt zum Wachweg hinauf.");
  AddDetail( ({"dienst","kampfsoldaten"}),
      "Die Kampfsoldaten versehen ihren Dienst auf dem Wachweg, den "
      "Du ueber Dir erkennen kannst. Sie sorgen fuer Ruhe und Ordnung.");
  AddDetail( ({"ordnung"}),
      "Ordnung muss sein! Besonders dort, wo viele Leute zusammenleben...");
  AddDetail( ({"wachweg"}),
      "Der Wachweg ueber Dir wird von Kampfsoldaten bevoelkert, die "
      "von dort oben den Ueberblick ueber die Stadt bewahren und so "
      "fuer Ruhe und Ordnung sorgen koennen.");
  AddDetail( ({"ueberblick"}),
      "Von dem Wachweg ueber Dir kein Problem!");
  AddDetail( ({"problem"}),
      "Hoffentlich hast Du keines mit den Kampfsoldaten!");

  AddExit("suedwesten", "./room_a2");
  AddExit("osten", "./room_c1");
  AddExit("westoben", "die Treppe westwaerts hoch#./wachweg_a1");
}
