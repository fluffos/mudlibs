inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG,
    "Die Hauptstrasse in Midas erstreckt sich von Westen nach Osten. "
    "Hier herrscht reger Betrieb, und Du bist froh, noch einigermassen "
    "den Ueberblick bewahren zu koennen. Zwischen den Menschenmassen "
    "erblickst Du im Sueden einen kleinen Seitenweg, an dem einige "
    "groessere Gebaeude zu liegen scheinen. Weiter hinten erkennst Du "
    "die Kirche, um die Du offenbar auch herumgehen kannst. Im Norden "
    "kannst Du eine kleine aus Stein gehauene Kapelle erkennen.\n");

  SetProp (P_INT_SHORT, "Hauptstrasse in Midas");

  // DETAILS START
  AddDetail ("stadt",
      "Du stehst mittendrin.");
  AddDetail ("midas",
      "Du faengst an, angestrengt nachzudenken. Da war doch was...\n"+
      "Ach ja! Auf einmal faellt es Dir wieder ein!\n"+
      "Midas war doch der Name der Stadt, in der Du dich befindest.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ( ({"wand","waende"}),
    "Du tastest die Luft nach Waenden ab, findest aber nichts.\n");
  AddDetail ("hauptstrasse", "Du befindest Dich auf ihr.\n");
  AddDetail ( ({"strasse","boden",
              "steine","pflaster","steinpflaster"}),
    "Der Boden besteht aus einem sehr gleichfoermigen Steinpflaster.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ("blau", "So blau warst selbst Du noch nie!\n");
  AddDetail ( ({"kapelle","norden"}), bs(
    "Eine kleine, wunderschoene, vertraeumte Kapelle, in der "+
    "es sich sicherlich wunderbar beten laesst, so dies einmal "+
    "notwendig sein sollte...\n"));
  AddDetail ( ({"betrieb","treiben","abenteurer","haendler","menschenmassen"}),
    "Viele Abenteurer und Haendler tummeln sich geschaeftig auf der "
    "Hauptstrasse.\n");
  AddDetail ( ({"gebaeude", "kirche"}),
    "Mehr erkennst Du wohl, wenn Du naeher rangehst.");
  AddDetail ( ({"ueberblick"}),
    "Hast Du ihn denn auch sicher noch? Schau Dich nur genau um!");
  AddDetail ( ({"luft"}),
    "Luft ist foerderlich, wenn man lange leben will.");
  AddSpecialDetail ( ({"name", "namen"}),
    "d_name");
  AddDetail ( ({"seitenweg", "weg"}),
    "Der Seitenweg geht nach Sueden ab und fuehrt auf ein paar Gebaeude "+
    "zu.");
  AddDetail ( ({"stein"}),
    "Seltsam, mitten in der Stadt eine Kapelle aus einem riesigen Stein zu "+
    "hauen. Normalerweise werden da doch viele Steine zusammengefuegt zu "+
    "einem Gebaeude? Du wunderst Dich ein wenig, akzeptierst dann aber "+
    "dieses Faktum, ohne laenger drueber nachzudenken.");
  AddDetail ( ({"faktum"}),
    "Schon akzeptiert! Denk nicht weiter drueber nach!");
  // DETAILS END

  AddRoomMessage ( ({
    "Ein vorbeieilender Haendler stupst Dich unabsichtlich.\n",
    "Im Norden ist es verdaechtig still.\n",
    "Du ueberlegst, ob es hier im Freien Waende gibt.\n" }), 45 );

  AddDetail ("haendler", "Er ist schon wieder weg.\n");
 
  AddSound (DEFAULT_SOUND,
    "Du hoerst ausser den typischen Geraeuschen auf einer Hauptstrasse "
    "(nein, kein Hupen, sondern viele viele Stimmen unterschiedlichster "
    "Auspraegung) nur die Stille aus dem Norden. Seltsam, dass man "
    "Stille jetzt sogar schon hoeren kann...?");
  AddSound (({"hupen"}),
    "Da hier keine Autos fahren, hoerst Du auch keine Hupen.");
  AddSound (({"stimmen"}),
    "Verschiedenste Stimmen, Hauptstrassenlaerm eben.");
  AddSound (({"hauptstrassenlaerm","laerm","geraeusche"}),
    "Es ist einfach nur laut hier.");
  AddSound (({"stille", "kapelle"}),
    "Du hoerst aus der Kapelle im Norden die wunderbarste Stille und "
    "notierst sie als Kanditat fuer 'Best Of Silence'. Wie schoen muss "
    "sie erst in der Kapelle klingen!");
  AddSound (({"best of silence", "kanditat"}),
    "Ein Meisterwerk, es umfasst die schoensten Stillen dieser Welt.");
  AddSound (({"meisterwerk"}),
    "Stille stimmungsvoll einzufangen ist nicht leicht!");
  AddSound (({"silberland","welt"}),
      "Das Silberland ist Deine Welt.");

  AddItem(NPC "klau", REFRESH_DESTRUCT);

  AddExit("norden", "./kapelle");
  AddExit("sueden", "./room_d6");
  AddExit("westen", "./room_c5");
  AddExit("osten", "./room_e5");
}

string d_name()
{
  return "Alles hat einen Namen, auch Du, "+CAP(getuid(TP))+"!\n";
}
