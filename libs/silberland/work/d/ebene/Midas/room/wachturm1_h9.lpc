#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:17]));
  SetProp (P_INT_SHORT, "Auf einer Leiter");
  SetProp (P_INT_LONG,
    "Du stehst auf einer kleinen Leiter, die Dich entweder hinauf auf den "+
    "hohen Aussichtsturm von Midas oder aber hinunter auf den Wachweg "+
    "fuehrt. Du beschliesst, hier nicht lange zu bleiben, der Wind blaest "+
    "Dir kuehl um die Ohren und die Leiter scheint auch nicht mehr die "+
    "neueste zu sein...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"leiter","wind","ohren"}),
      "Du stehst auf der kleinen nicht unbedingt stabilen Leiter und "
      "frierst ein wenig, daher beschliesst Du, Dich hier nicht lang "
      "aufzuhalten sondern weiterzuklettern.");
  AddDetail ( ({"aussichtsturm", "turm"}),
      "Der Aussichtsturm ist ueber Dir. Also oben.");
  AddDetail ( ({"wachweg", "weg", "boden"}),
      "Der Wachweg ist unter Dir. Also unten.");
  AddDetail ( ({"himmel"}),
      "Kurz schaust Du rauf... der Himmel ist blau, wie nicht anders "
      "erwartet. Ein kleiner Schwindelanfall packt Dich - und Du die "
      "Leiter.");
  // DETAILS END

  // EXITS START
  AddExit ("unten", "./wachweg_h9");
  AddExit ("oben", "./wachturm_h9");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
