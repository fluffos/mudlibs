/*
** Seitengasse in Midas  (w) Woody@SL
** ---
** 1996-09-07  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem kleinen Seitenweg inmitten der grossen "
    "Stadt Midas. Im Norden kannst Du die Hauptstrasse erkennen, die "
    "sich quer durch die ganze Stadt zieht, waehrend sich im Osten ein "
    "grosses Gebaeude mit einer hoelzernen Tafel ueber dem Eingang "
    "befindet.");

  SetProp (P_INT_SHORT, "Seitenweg in Midas");

  // DETAILS START
  AddDetail ( ({"seitenweg","weg"}), "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ("tafel",
      "Sie besteht aus kunstvoll geschnitztem Holz. Du kannst sie lesen.\n");
  AddDetail ( ({"eingang", "tuer"}),
      "Du erblickst eine maechtige Tuer aus schwerem Holz.\n");
  AddDetail ("holz",
      bs("Das Holz der Tafel wurde kunstvoll geschnitzt. Das der Tuer "
         "nicht, umso massiver ist es aber."));
  AddReadDetail (({"tafel","lettern","letter"}),
      "Auf ihr steht in grossen Lettern 'Abenteurer-Gilde'.\n");
  AddDetail ( ({"letter","lettern"}),
      bs("Die Lettern sind so gross, dass Du sie sogar mit geschlossenen "
         "Augen lesen kannst. Naja. Das war vielleicht uebertrieben, aber "
         "sie sind schon sehr gross."));
  AddDetail ( ({"gebaeude","haus","gilde",
                "abenteurer-gilde","abenteurergilde","sueden"}), bs(
    "Die Abenteurer-Gilde ist Treffpunkt aller Abenteurer, um "+
    "sich zu treffen, Erfahrungen auszutauschen, und sich in "+
    "verschiedenen Wissenschaften zu verbessern.\n"));
  AddDetail ( ({"wissenschaften"}),
    "Hauptsaechlich die der Magie.\n");
  AddDetail ( ({"magie"}),
    "Am besten erkundest Du das, indem Du Dich dort mal umsiehst!\n");
  AddDetail ( ({"hauptstrasse", "strasse"}),
    "Die Hauptstrasse befindet sich noerdlich von Dir.");
  AddDetail ( ({"abenteurer"}),
    "Bist Du einer?");
  AddDetail ( ({"treffpunkt"}),
    "Geh doch mal rein!");
  AddSpecialDetail ( ({"erfahrung", "erfahrungen"}),
    "d_erfahrung");
  // DETAILS END

  AddRoomMessage ( ({
    "Aus dem Osten hoert man Stimmenwirrwarr.\n",
    "Eine kleine Maus huscht ueber den Boden.\n" }), 60 );

  AddDetail ("maus", "Sie ist schon wieder weg.\n");
  AddDetail ("stimmenwirrwarr", "Es kommt aus dem Osten, wo Du die "+
    "beruehmte Abenteurergilde erkennst.\n");

  AddSound (({DEFAULT_SOUND, "stimmen", "stimmenwirrwarr"}),
    "Du hoerst einige Stimmen aus dem Gebaeude im Osten, die offenbar "
    "eine angeregte Diskussion fuehren.");
  AddSound (({"stimmen"}),
    "Sie scheinen aus dem Osten zu kommen.");
  AddSound (({"diskussion"}),
    "Worum es geht, kannst Du allerdings nicht heraushoeren.");

  AddExit ("norden", "./room_d5");
  AddExit ("sueden", "./room_d7");
  AddExit("osten", "/gilden/abenteurer");
}

string d_erfahrung()
{
  int x;
  x=TP->QueryProp(P_XP);
  if (x<1000) return "Hmm, allzuviel Erfahrung hast Du ja noch nicht...\n";
  if (x<10000)
    return "Ein klein wenig Erfahrung konntest Du ja schon sammeln, aber\n"
           "beruehmt wirst Du damit bestimmt nicht...\n";
  if (x<100000)
    return "Ja, Du hast schon einiges an Erfahrung gesammelt!\n";
  if (x<1000000)
    return "Erfahrung hast Du schon jede Menge.\n";
  if (x<5000000)
    return "Du besitzt bereits enorm viel Erfahrung.\n";
  return "Mit Deiner Erfahrung gehoerst Du eindeutig zu den Topspielern.\n";
}

