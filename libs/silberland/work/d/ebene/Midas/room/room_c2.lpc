/*
** Seitengasse in Midas  (w) Woody@SL
** ---
** 1996-04-18  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG,
    "Du befindest Dich in einer kleinen Seitengasse inmitten der grossen "
    "Stadt Midas. Hier werden wohl demnaechst einige Geschaefte eroeffnen, "
    "jedenfalls bemerkst Du, dass hier rege Bauarbeiten stattfinden. "
    "Nach Norden hin kannst Du die Stadtmauer erkennen, waehrend Du nach "
    "Sueden dem Weg weiter in die Stadt hinein folgen kannst, wo der Weg "
    "einen Knick nach Osten hin zu machen scheint. "
    "Westlich von Dir kannst Du ein kleines Gebaeude erkennen, ueber "
    "dem ein Schild angebracht ist. Offenbar kann man es betreten.");

  SetProp (P_INT_SHORT, "Seitengasse in Midas");

  AddDetail ("weg", "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadtmauer","mauer"}), bs(
    "Die Stadtmauer erhebt sich maechtig nach Osten hin. Sie sichert die "+
    "Stadt gegen Angriffe von aussen ab und traegt ganz erheblich zum "+
    "Wohlbefinden der Einwohner hier bei."));
  AddDetail ("wohlbefinden", "Ein gutes Gefuehl, findest Du nicht?\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ("knick", "Weiter suedlich!");
  AddDetail ("gebaeude", "Das Gebaeude ist zwar nicht sonderlich gross, "
      "aber aehnelt von der Form her dennoch einer kleinen Halle.");
  AddDetail ("halle", "Nicht sonderlich gross, aber wie jede Halle "
      "wirkt auch diese wie eine ueberdimensionale Truhe.");
  AddDetail ("form", "Die kleine Halle hat die Form einer ueberdimensionalen "
      "Truhe.");
  AddDetail ("truhe", "Truhe siehst Du hier keine, nur die kleine Halle.");
  AddDetail ("schild", "Ein einfaches Schild aus Holz, auf dem etwas "
      "geschrieben steht.");
  AddDetail ("holz", "Gaaaaaanz einfaches, schlichtes Holz. Ehrlich.");
  AddReadDetail ("schild", "Auf dem Schild steht geschrieben: "
      "Spielehalle - Spass fuer Gross und Klein");

  AddExit ("norden", "./room_c1");
  AddExit ("sueden", "./room_c3");
  AddExit ("westen", "./spiele/4gwraum");
}
