#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Wachturm");
  SetProp (P_INT_LONG,
    "Du erklimmst den Wachturm ueber die kleine Treppe. Sofort offenbart "+
    "sich Dir ein wundervoller Blick ueber das weite Land. Im Westen "+
    "kannst Du den beruehmten Silberwald erkennen, hinter dem sich das "+
    "Gebirge hoch und maechtig erhebt. Ein kleines Baechlein begleitet "+
    "den Weg durch den Wald mit sanftem Plaetschern. Im Norden hingegen "+
    "kannst Du das wundervolle Feenschloss erkennen. Dein Atem stockt bei "+
    "diesem wundervollen Ausblick, und fuer einen Moment vergisst Du, wie "+
    "eng und unbequem es auf diesem Turm doch eigentlich ist...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"turm", "wachturm"}),
    "Du stehst auf selbigem und geniesst den Ausblick.");
  AddDetail ( ({"ausblick", "blick", "land"}),
    "Dein Blick schweift ueber das weite Land, und Du geniesst diesen "+
    "herrlichen Ausblick ueber den Silberwald, die Ebene und das "+
    "bezaubernde Feenschloss.");
  AddDetail ( ({"silberwald", "wald"}),
    "Der Silberwald ist der wohl bekannteste Wald im ganzen Land. Er "+
    "verkoerpert all das, was man sich von einem Wald erwartet - "+
    "vertrauemte Atmosphaere, ein kleiner, wegsamer Pfad und sogar ein "+
    "kleines Baechlein, das den Pfad Richtung Gebirge leise plaetschernd "+
    "begleitet.");
  AddDetail ( ({"baechlein", "bach"}),
    "Das kleine Baechlein besticht durch seine Vertraeumtheit. Das "+
    "Wasser scheint herrlich klar zu sein, kommt es doch aus den "+
    "Hoehen des Gebirges...");
  AddDetail ( ({"ebene","region"}),
    "Die weite Ebene breitet sich unmittelbar vor dem Silberwald aus. "
    "Eine echte Prachtregion, findest Du nicht?");
  AddDetail ( ({"prachtregion","mund"}),
    "Du kannst Deinen Mund ruhig wieder zumachen!");
  AddDetail ( ({"atem"}),
    "Er stockt Dir.");
  AddDetail ( ({"atmosphaere"}),
    "Sie ist aeusserst vertraeumt! *chrchrchr*");
  AddDetail ( ({"boden"}),
    "In dieser schwindligen Hoehe bist Du Dir nicht mehr sicher, ob "
    "er Dir noch festen Haaaaaaaaaa.... Hoppla! Beinahe waerst Du "
    "gestolpert! Pass das naechste Mal etwas besser auf beim "
    "Details untersuchen ;-).");
  AddDetail ( ({"hoehe","hoehen"}),
    "Urhoch.");
  AddDetail ( ({"hoppla"}),
    "Hae? Wie kommst Du jetzt DARAUF? Sowas doofes...");
  AddDetail ( ({"mal"}),
    "Kuck mal, wer da forscht!");
  AddDetail ( ({"details"}),
    "Diese Details widmen Ihnen Region Ebene.");
  AddDetail ( ({"himmel"}),
    "Ueber Dir der Himmel so blau, blau, blau...");
  AddDetail ( ({"moment"}),
    "Schon vorbei, aber da kommt schon wieder einer...");
  AddDetail ( ({"pfad","weg"}),
    "Er fuehrt direkt durch den Wald bis zum Gebirge und weiter.");
  AddDetail ( ({"treppe"}),
    "Ueber die bist Du doch raufgekommen, schau sie Dir nur gut an, "
    "ob sie Dich auch auf dem Rueckweg noch tragen wird!");
  AddDetail ( ({"rueckweg"}),
    "Naja, warum auch nicht. Ob Du es glaubst oder nicht, hier sind "
    "schon dickere als Du raufgeklettert und wieder heil runtergekommen.");
  AddDetail ( ({"dickere"}),
    "Ja, die gibts wirklich!");
  AddDetail ( ({"vertraeumtheit"}),
    "Du traeumst ein wenig vor Dich hin... hach, ist das schoen!");
  AddDetail ( ({"gebirge", "berge", "berg"}),
    "Hoch ragen die Berge im Norden von Dir auf, gespentisch und "
    "geheimnisvoll... wirst Du eines Tages aufbrechen, um ihre "
    "Geheimnisse zu erkunden?");
  AddDetail ( ({"tag"}),
    "Eines Tages kommt jeder Tag!");
  AddDetail ( ({"geheimnisse","geheimnis"}),
    "Sie gilt es zu lueften - und das bald!");
  AddDetail ( ({"wasser"}),
    "Das Wasser des kleinen Baechleins plaetschert leise vor sich hin.");
  AddDetail ( ({"feenschloss", "schloss"}),
    "Das Schloss, das Du etwas weiter noerdlich erkennen kannst, gehoert "+
    "einer einsamen Fee. Es wirkt bezaubernd und irgendwie geheimnisvoll.");
  AddDetail ( ({"fee"}),
    "Ob sie sehr einsam ist? Besuch sie doch mal!");

  AddSound ( ({"plaetschern"}),
    "Du hoerst es nur in sehr weiter Ferne, aber es plaetschert, eindeutig.");
  AddSound ( DEFAULT_SOUND,
    "In weiter Ferne kannst Du ein Plaetschern aus "
    "westlicher Richtung vernehmen.");
  // DETAILS END

  // EXITS START
  AddExit ("unten", "die kleine Treppe runter#./wachweg_a1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
