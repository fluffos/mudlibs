/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL (1996-09-07). Preserved as room_d6_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Seitenweg in Midas");
  set_long(
    "Du befindest Dich auf einem kleinen Seitenweg inmitten der grossen "
    "Stadt Midas. Im Norden kannst Du die Hauptstrasse erkennen, die sich "
    "quer durch die ganze Stadt zieht, waehrend sich im Osten ein grosses "
    "Gebaeude mit einer hoelzernen Tafel ueber dem Eingang befindet.\n"
  );
  set_exits(([
    "norden": "/d/ebene/Midas/room/room_d5",
    "sueden": "/d/ebene/Midas/room/room_d7",
    "osten": "/gilden/abenteurer",
  ]));
  set_items(([
    "tafel": "Sie besteht aus kunstvoll geschnitztem Holz. Du kannst sie lesen.\n",
    "tuer": "Du erblickst eine maechtige Tuer aus schwerem Holz.\n",
    "gilde": "Die Abenteurer-Gilde im Osten ist Treffpunkt aller Abenteurer.\n",
  ]));
  set_reads(([
    "tafel": "Auf ihr steht in grossen Lettern 'Abenteurer-Gilde'.\n",
  ]));
  set_noises(([
    "default":
    "Du hoerst einige Stimmen aus dem Gebaeude im Osten, die offenbar eine angeregte Diskussion fuehren.\n",
    "stimmen":
    "Sie scheinen aus der Abenteurer-Gilde im Osten zu kommen.\n",
  ]));
}
