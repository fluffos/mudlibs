inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/secure/wizlevels.h"

#include "files.h"

#ifdef LOGF
#undef LOGF
#endif
#define LOGF "/d/ebene/log/friedenskerze.log"
#define SAVEFILE (MIDAS "save/kirche")

string *kerzen = ({ });
mapping kerzendatum = ([ ]);


string gold()
{
  if (IS_WIZARD(TP))
    return bs("Dir als Magier ist der Anblick von soviel Prunk und Gold "+
      "jedoch vollkommen gleichgueltig... Du kannst Dir doch schliesslich "+
      "soviel davon clonen, wie Du willst :)");
  if (TP->QueryProp(P_RACE)=="Zwerg")
    return bs("Wie jeder Zwerg bekommst auch Du beim Anblick von soviel "+
      "Gold feuchte Augen, und Du fragst Dich, wie man wohl an dieses Gold "+
      "herankommen koennte...");
  else
    return bs("Waerest Du ein Zwerg, wuerdest Du bei diesem praechtigen "+
      "Anblick vermutlich gaenzlich vergehen...");
}

void create()
{
  ::create();

  seteuid(getuid());
  if (!restore_object(SAVEFILE))
  {
    kerzen = ({ });
    kerzendatum = ([ ]);
    save_object(SAVEFILE);
  }

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, bs(
    "\tDu stehst nun unmittelbar vor dem prachtvollen Altar inmitten der "
    "maechtigen Kirche von Midas zwischen den vordersten Stuehlen. "
    "Links vom Altar stehen mehrere Reihen von kleinen, weissen Kerzen, "
    "sogenannten Friedenskerzen. "
    "Ausserdem siehst Du hinter dem Altar ein wundervolles, riesiges "
    "Gemaelde mit prachtvollem Goldrahmen, das sich bis weit ueber "
    "Deinen Kopf erhebt.")+"@@gold@@");

  SetProp (P_INT_SHORT, "In einer Kirche");

  AddDetail ("kirche",
    "Du befindest Dich inmitten der gewaltigen Kirche von Midas.");
  AddDetail ("reihen",
    "In Reihen geordnet stehen die Friedenskerzen da.");
  AddDetail ( ({"midas", "stadt"}),
    "Midas ist die groesste und reichste Stadt des Silberlands.");
  AddDetail ("kirchenschiff",
    "Das gewaltige Kirchenschiff erstreckt sich noch weiter nach Osten.");
  AddDetail ("boden",
    "Der Boden ist mit praechtigen, abwechselnd schwarzen und "+
    "weissen Marmorfliesen ausgelegt. Ausserdem ist an einer Stelle "+
    "eine kleine Messingplakette in den Boden eingelassen.");
  AddDetail ("stelle",
    "Der genaue Punkt ist jetzt nicht so wichtig.");
  AddDetail ( ({"messingplakette", "plakette", "widmung"}),
    "Die Messingplakette scheint an einen verstorbenen Wohltaeter "+
    "zu erinnern. Du kannst einige darauf eingeritzte Worte erkennen.");
  AddDetail ("worte",
    "Lies doch einfach die Plakette!");
  AddReadDetail ( ({"messingplakette", "plakette", "widmung"}),
    "Auf der Messingplakette steht sorgfaeltig eingeritzt:\n"+
    "  'Gewidmet Eljaron, dem Wohltaeter, im Jahre 774'\n");
  AddDetail ( ({"marmorfliesen","fliesen"}),
    "Die Fliesen sind aus Marmor und aeusserst sauber gefertigt.");
  AddDetail ("marmor",
    "Der Marmor der Fliesen ist ueberraschend schlicht. Zumindest hast "+
    "Du auch schon mal wesentlich teurer wirkenden Marmor gesehen als "+
    "diesen...");
  AddDetail ("stuehle",
    "Im riesigen Kirchenschiff sind jede Menge Stuehle verteilt, "+
    "zwischen denen ein Gang weiter nach Osten zum Ausgang fuehrt.");
  AddDetail ("menge",
    "Viele halt.");
  AddDetail ( ({"gang", "platz"}),
    "Der freie Platz zwischen den Stuehlen bildet einen Gang.");
  AddDetail ("ausgang",
    "Der ist im Osten.");
  AddDetail ("altar",
    "Der praechtige Altar ist mit funkelndem Blattgold bedeckt und "+
    "bietet einen beeindruckenden Anblick. Du siehst einen Kelch und eine "+
    "goldene Schale darauf liegen. Ausserdem kannst Du ein grosses, "+
    "aus Messing bestehendes Kreuz mit einem Kreis in der Mitte erkennen.");
  AddDetail ("anblick",
    "Mach halt einfach die Augen auf!");
  AddDetail ("augen",
    "Du reibst Dir die Augen und schaust nochmal genauer hin.");
  AddDetail ( ({"blattgold","gold"}),
    "Das Gold schillert und funkelt selbst im von den bunten "+
    "Glasfenster etwas abgeschwaechten Licht der Sonne.");
  AddDetail ("kelch",
    "Ein golden funkelnder Kelch, gefuellt mit Weisswein steht auf "+
    "dem Altar. Weisswein? Du wunderst Dich... sollte es nicht Rotwein "+
    "oder Wasser sein?");
  AddDetail ( ({"weisswein", "wein"}),
    "In dem Kelch befindet sich tatsaechlich Weisswein... Du "+
    "schuettelst verwundert den Kopf.");
  AddDetail ( ({"rotwein", "wasser"}),
    "Manchmal ist es eben anders als man es erwartet.");
  AddDetail ("kopf",
    "Dein Kopf sitzt zum Glueck immer noch da, wo er hingehoert.");
  AddDetail ("glueck",
    "Glueck muss man haben!");
  AddDetail ("schale",
    "In der goldenen Schale am Altar kannst Du etwas Brot erkennen.");
  AddDetail ( ({"brotscheiben","brot"}),
    "Ein paar trockene Brotscheiben liegen in der goldenen Schale "+
    "am Altar.");
  AddDetail ( ({"messingkreuz", "kreuz", "messing"}),
    "Das grosse Messingkreuz steht auf dem praechtigen Altar. Es hat "+
    "ungewoehnlicherweise einen Kreis in der Mitte, dessen Bedeutung Du "+
    "nicht zu ergruenden vermagst.");
  AddDetail ("kreis",
    "Der Kreis in der Mitte des grossen Messingkreuzes schneidet die "+
    "horizontale Achse des Kreuzes links und rechts jeweils genau in der "+
    "Mitte. Die genaue Bedeutung bleibt Dir jedoch verborgen.");
  AddDetail ("mitte",
    "Die Mitte ist der Punkt, wo selbst der entfernteste Punkt am wenigsten "
    "weit entfernt ist.");
  AddDetail ("punkt", ".");
  AddDetail ("bedeutung",
    "Naja, irgendeine wird er schon haben.");
  AddDetail ("achse",
    "Also den waagerechten Messingbalken des Kreuzes.");
  AddDetail ( ({"balken","messingbalken"}),
    "Das Kreuz besteht aus zweien davon.");
  AddDetail ( ({"glasfenster","fenster"}),
    "Die Fenster sind mit buntem Glas in allen Farben durchsetzt und "+
    "zeigen diverse Szenen aus der Kirchengeschichte.");
  AddDetail ("szenen",
    "Meist sieht man aufopfernde Menschen aus laengst vergangenen Tagen.");
  AddDetail ("tage",
    "Als Du noch nicht gelebt hast.");
  AddDetail ("menschen",
    "Sie haben sich vor allem in Midas gegen das Boese gesammelt.");
  AddDetail ("boese",
    "Das Boese ist immer und ueberall.");
  AddDetail ( ({"kirchengeschichte","geschichte", "geschichten"}),
    "Es sind nicht immer die schoensten Geschichten.");
  AddDetail ("glas",
    "Das Glas der Fenster schillert in allen Farben des Lichts.");
  AddDetail ( ({ "farben", "rot", "gruen", "blau", "gelb" }),
    "Die Sonne schillert durch das bunte Glas der Fenster und erhellt "+
    "die Kirche in Rot, Gruen, Blau und Gelb.");
  AddDetail ("licht",
    "Das Licht der Sonne wird durch die bunten Fenster in verschiedene "+
    "Farben geteilt und erhellt die Kirche auf praechtigste Art und Weise.");
  AddDetail ( ({ "art", "weise" }),
    "Einfach nur prachtvoll!");
  AddDetail ("sonne",
    "Die Sonne mueht ihre Strahlen durch die bunten Glasfenster und "+
    "laesst das Kircheninnere in allen Farben des Lichts schillern.");
  AddDetail ("strahlen",
    "Die Strahlen der Sonne waermen Dich auch hier.");
  AddDetail ( ({ "kircheninneres", "inneres" }),
    "Es erstrahlt durch die Glasfenster in allen Farben des Lichts.");
  AddDetail ( ({"ruhe","stille"}),
    "In dieser Kirche herrschen Ruhe und Stille. Du wagst es nicht, "+
    "zu rufen oder laut etwas zu sagen.");
  AddDetail ("decke",
    "An der hohen Decke kannst Du wundervolle Malereien erkennen.");
  AddDetail ( ({"wand", "waende"}),
    "Die Waende ragen steil empor und tragen das gewaltige Kirchenschiff.");
  AddDetail ( ({"deckenmalereien","malereien"}),
    "Die Malereien an der Decke zeigen diverse Szenen aus der "+
    "Kirchengeschichte, wie dies auch die Glasfenster tun.");
  AddDetail ( ({ "gemaelde", "bild" }),
    "Das riesige Gemaelde hinter dem Altar zeigt einen aelteren "+
    "Mann mit Holzstock, der gerade einen steilen Gebirgsweg aufwaerts "+
    "geht. Das Bild ist von einem wundervoll gearbeiteten Goldrahmen "+
    "umgeben.");
  AddDetail ( ({ "gebirgsweg" }),
    "Du kannst natuerlich auch selbst ins Gebirge ziehen.");
  AddDetail ( ({ "gebirge" }),
    "Zieh Dir aber vorher was warmes an!");
  AddDetail ( ({ "stock", "holzstock" }),
    "Der Mann auf dem Gemaelde stuetzt sich an dem Holzstock ab.");
  AddDetail ("mann",
    "Es scheint sich um Eljaron, den Wohltaeter zu handeln.");
  AddDetail ( ({ "eljaron", "wohltaeter" }),
    "Eljaron muss zu seiner Zeit wohl ein bekannter Wohltaeter gewesen "+
    "sein, anders kannst Du Dir die Widmung auf der Plakette nicht "+
    "erklaeren...");
  AddDetail ( ({"goldrahmen", "rahmen"}),
    "Der Goldrahmen besteht aus von Blattgold bedecktem, massiven Holz. "+
    "Ein kleines Schild ist am unteren Rand angebracht. Ausserdem bemerkst "+
    "Du einen kleinen Hebel links vom Rahmen.");
  AddDetail ("zeit",
    "Sie bleibt niemals stehen.");
  AddDetail ("rand",
    "Ganz unten halt.");
  AddDetail ("hebel",
    "Du koenntest versuchen, ihn zu ziehen.");
  AddDetail ("holz",
    "Massives Holz, das von Blattgold bedeckt ist.");
  AddDetail ("schild",
    "Ein kleines Schild aus Messing. Du kannst es lesen.");
  AddReadDetail ("schild",
    "Auf dem Schild am Goldrahmen steht geschrieben: 'Eljaron auf "+
    "seinem Weg nach Montaran, 772'");
  AddSpecialDetail ( ({ "kerzen", "friedenskerzen", "kerze", "friedenskerze" }),
    "d_kerzen");

  AddExit ("osten", "./kirche");

  AddCmd ("iss", "iss");
  AddCmd ( ({"trink","trinke"}), "trink");

  AddCmd ( ({"zieh","ziehe"}), "zieh");
  AddCmd( ({ "zuend", "zuende", "entzuend", "entzuende" }), "zuende");
  AddCmd( ({ "loesch", "loesche" }), "loesche");

  AddCmd( ({ "ruf", "rufe" }), "ruf");
  AddCmd( ({ "schrei", "schreie" }), "schrei");
  AddCmd( ({ "sag", "sage" }), "sag");
  AddCmd ("bete","bete");
  AddCmd( "'", "sag", 1);
}


int bete()
{
  write("Du kniest nieder und haeltst eine kurze Andacht.\n");

  if (TP->QueryProp(P_GHOST))
  {
    say("Der Geist von "+TP->name()+
        " kniet nieder und haelt eine kurze Andacht.\n");
    write("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "+
      "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "+
      "durchstroemt.\n");
    say(TP->name()+" erscheint ploetzlich wieder in "+
      "koerperlicher Form.\n");
    TP->SetProp(P_GHOST,0);
  }
  else
  {
    say(TP->Name() + " kniet nieder und haelt eine kurze Andacht.\n");
  }
  return 1;
}


int zieh(string str)
{
  notify_fail ("WAS moechtest Du ziehen?\n");
  if (!str) return 0;
  if (str!="hebel" && str!="an hebel" && str!="am hebel") return 0;
  write(bs("Du ziehst an einem Hebel, aber nichts passiert. Du beschliesst, "+
    "es spaeter wieder mal zu versuchen... vielleicht morgen?"));
  return 1;
}

int ruf(string str)
{
  str = TP->_unparsed_args();
  if(TP->QueryProp(P_GUILD) == "nekromanten") {
    shout(CAP_TPN + " ruft lauthals: "+str+"\n");
    return 1;
  }
  write ("Du wagst es nicht, an dieser Staette der Ruhe etwas zu rufen.\n");
  return 1;
}

int schrei(string str)
{
  str = TP->_unparsed_args();
  if(TP->QueryProp(P_GUILD) == "nekromanten") return 0;
  write ("Du wagst es nicht, an dieser Staette der Ruhe zu schreien.\n");
  return 1;
}

int sag(string str)
{
  str = TP->_unparsed_args();

  if (!str) str = "";
  if (query_verb()[0] == '\'')
    str = query_verb()[1..] + " " + str;
  if (str == "" || !sizeof(explode(str, " ")))
    return 0;
  if(TP->QueryProp(P_GUILD) == "nekromanten") {
    write(break_string(str, 78, "Du kreischt laut: "));
    say(break_string(str, 78, TP->Name() + " kreischt laut: "));
  } else {
    write(break_string(str, 78, "Du fluesterst: "));
    say(break_string(str, 78, TP->Name() + " fluestert: "));
  }
  return 1;
}

int iss(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if (!str || str!="brot") return 0;
  if (TP->eat_food(2))
  {
    write(bs("Du kostest von dem bereits etwas vertrockneten Brot und "
        "stellst fest, dass es wohl durchaus bessere Speisen gibt."));
    say (TP->Name()+" isst ein wenig von dem Brot.\n");
    if (!random(4)) TP->AddHp(random(5));
  }
  return 1;
}

int trink(string str)
{
  notify_fail("Was moechtest Du trinken?\n");
  if (!str) return 0;
  if ((str!="weisswein") && (str!="wein") && (str!="aus kelch")) return 0;
  if (TP->drink_alcohol(1) && TP->drink_soft(2))
  {
    write("Du kostest ein wenig von dem Wein.\n"
      "Brrrr, ist der trocken! Und bitter. Es gibt zweifelsohne besseren.\n");
    say (TP->Name()+" trinkt ein wenig Wein.\n");
    if (random(2)) TP->AddHp(random(3));
  }
  return 1;
}

varargs string fmtdat(int i, int flag)
{
  string heute;

  heute = (ctime()[0..9] != ctime(i)[0..9]) ? "gestern um " : "heute um ";

  if (i < (time() - 365 * 86400))
    return flag ? ("um " + dtime(i)[5..<4] + " Uhr") : (dtime(i)[5..<4]);
  else if (i < (time() - 86400))
    return (flag ? "am " : "") + dtime(i)[5..11] + dtime(i)[<10..<4];
  else
    return (flag ? heute : "") + dtime(i)[<8..<4] + (flag ? " Uhr" : "");
}

string d_kerzen()
{
  string ret;
  mixed tmp;
  int i, n;

  switch (n = sizeof(kerzen))
  {
    case 0:
      ret = "Im Moment brennt keine Friedenskerze.\n";
      break;
    case 1:
      ret = sprintf("Im Moment brennt eine Friedenskerze.\n" +
        "Sie wurde %s von %s entzuendet.\n",
        fmtdat(kerzendatum[kerzen[0]],1), capitalize(kerzen[0]));
      break;
    default:
      tmp = ({ });
      for (i = 0; i < n; i++)
        tmp += ({ sprintf("%s (%s)",
              capitalize(kerzen[i]), fmtdat(kerzendatum[kerzen[i]], 1) ) });
      tmp = implode(tmp[0..<2], ", ") + " und " + tmp[<1];      // CountUp
      ret =
        break_string(sprintf("Im Moment brennen %d Friedenskerzen. ", n) +
            "Sie wurden von folgenden Traegern der Hoffnung entzuendet: " +
            tmp + ".", 78);
  }
  return ret + "Sie sind ein Symbol der Hoffnung auf Frieden und Harmonie.\n"
    "Du kannst " + (n ? "auch " : "") +
    "eine entzuenden, wenn Du moechtest.\n";
}

int zuende(string str)
{
  if (!stringp(str))
    return notify_fail("Was willst Du an- oder entzuenden?\n"), 0;

  if (str[<3..] == " an")
    str = str[0..<4];

  if (str!="kerze" && str!="friedenskerze")
    return notify_fail("Das kannst Du nicht anzuenden.\n"), 0;

  if (kerzendatum[getuid(TP)])
    return notify_fail("Du hast bereits eine Friedenskerze entzuendet.\n"), 0;

  kerzen += ({ getuid(TP) });
  kerzendatum[getuid(TP)] = time();
  save_object(SAVEFILE);

  Message( TP->Name(WER) + " entzuendet eine Friedenskerze.\n",
      MSGFLAG_VISUAL | MSGFLAG_NO_TP );
  write( "Du entzuendest eine Friedenskerze und haeltst einen Moment "
         "andaechtig inne.\n"
         "Du denkst . o O ( Moegen Friede und Harmonie wieder in diese Welt "
         "einkehren. )\n");

  write_file(LOGF,
      sprintf("%s: %s zuendet eine Kerze an.\n", dtime(),
        capitalize(getuid(TP)) ) );

  return 1;
}

int loesche(string str)
{
  if (!stringp(str))
    return notify_fail("Was willst Du loeschen?\n"), 0;

  if (str[<4..] == " aus")
    str = str[0..<5];

  if (str!="kerze" && str!="friedenskerze")
    return notify_fail("Das kannst Du nicht ausloeschen.\n"), 0;

  if (!kerzendatum[getuid(TP)])
    return notify_fail("Du hast noch keine Friedenskerze entzuendet.\n"), 0;

  kerzen -= ({ getuid(TP) });
  efun::m_delete(kerzendatum, getuid(TP));
  save_object(SAVEFILE);

  Message( TP->Name(WER) + " loescht eine Friedenskerze aus.\n",
      MSGFLAG_VISUAL | MSGFLAG_NO_TP );
  write( "Du loescht Deine Friedenskerze aus.\n"
         "Die Welt um Dich herum wird ein bisschen dunkler und kaelter.\n");

  write_file(LOGF,
      sprintf("%s: %s loescht eine Kerze aus.\n", dtime(),
        capitalize(getuid(TP)) ) );

  return 1;
}
