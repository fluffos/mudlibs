/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL. Preserved as room_g5_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Hauptstrasse in Midas");
  set_long(
    "Die Hauptstrasse in Midas erstreckt sich von Westen nach Osten. "
    "Im Sueden kannst Du durch einen kleinen Torbogen aus schwarzem "
    "Gusseisen hindurch einen ruhigen Kieselweg Richtung Kirche erblicken.\n"
  );
  set_exits(([
    "westen": "/d/ebene/Midas/room/room_f5",
  ]));
  set_items(([
    "torbogen": "Der Torbogen besteht aus schwarzem, massivem Gusseisen.\n",
    "schild": "Ein kleines, rechteckiges Schild aus Blech am Torbogen.\n",
  ]));
  set_reads(([
    "schild": "Z u r   K i r c h e — kirchliche Trauungen, Entfluchungen, Beichte.\n",
  ]));
}
