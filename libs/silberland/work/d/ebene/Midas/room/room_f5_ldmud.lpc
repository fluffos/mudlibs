inherit "/d/ebene/Midas/room/hauptstrasse_inh";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  SetProp(P_INT_LONG, bs(
      QueryProp(P_INT_LONG)+
      "Im Norden kannst Du die Postzentrale von Midas erkennen. Von dort "
      "kann man jederzeit Post verschicken und auch eigene Briefe abholen."));

  AddDetail( ({"post","postzentrale"}),
      "Sie befindet sich noerdlich von Dir.\n");
  AddDetail("briefe", bs(
      "Willst Du welche schreiben oder lesen? Dann geh doch einfach "
      "nach Norden, in die Postzentrale!"));

  AddItem (OBJ("waffe/stockautomat"), REFRESH_REMOVE);
  AddItem("/obj/sehertor", REFRESH_NONE);
  AddItem("/p/service/thor/postcards/obj/postkasten", REFRESH_DESTRUCT);
  
  AddExit("osten", "./room_g5");
  AddExit("westen", "./room_e5");
  AddExit("norden", "./post");
}

int _query_tport_cost_in()
{
  if( TP && TP->QueryProp(P_RACE) == "Mensch" )
    return -2;
  return 0;
}

int _query_tport_cost_out()
{
  if( TP && TP->QueryProp(P_RACE) == "Mensch" )
    return -2;
  return 0;
}

