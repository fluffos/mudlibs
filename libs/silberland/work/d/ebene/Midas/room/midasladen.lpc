inherit "std/laden";

#include <properties.h>
#include <laden.h>
//#include "files.h"
#include "../def.h"

#define LAGER ROOM "lagerraum"
#define KLINGEL_INTERVALL 4

//wie oft darf kein special item kommen
#define MAX_NO_ITEM 100
//mindestabstand fuer special items
#define MIN_NO_ITEM 10
#define TOY_PROBABILITY 40

int klingel = 0;

string *candy = ({"/players/yara/sonstiges/obj/kaugummi.lpc"});
string *toys = ({"/players/yara/sonstiges/armour/sonnenring.lpc",
                 "/players/yara/sonstiges/armour/herzring.lpc",
                 "/players/yara/sonstiges/armour/kleeblattring.lpc",
                 "/players/yara/sonstiges/armour/mondring.lpc",
                 "/players/yara/sonstiges/armour/sternenring.lpc"
                  });
string *specials = ({"/players/yara/sonstiges/weapon/plueschaxt.lpc"});
int coins = 0;
int hebel = 0;
int cnt = 0;
int gum = 0;

void create()
{
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_LONG,
    "Du stehst etwas verloren in einem riesigen Laden. In den Regalen "
    "liegen Waren aller Art, jedes Eck ist vollgestopft mit diesem und jenem "
    "nuetzlichen Ausruestungsgegenstand, etwa Schwerter, Ruestungen, "
    "aber auch ganz andere Dinge. "
    "Hinter der Kasse haengt eine Tafel an der Wand, ausserdem siehst Du einen "
    "seltsamen Kasten aus Holz.");
  SetProp(P_INT_SHORT,"In einem grossen Laden");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "\nlandar");
  SetProp(P_SHOPKEEPER_NAME, "Landar");

  AddDetail ("laden", "Du stehst mittendrin.\n");
  AddDetail ( ({"regal", "regale"}),
    "Die Regale sind voll mit Schwertern, Ruestungen und anderem "
    "Krimskrams.");
  AddSpecialDetail ( ({ "ausruestungsgegenstand", "schwerter", "ruestungen",
                 "krimskrams", "dinge", "art", "waren" }),
    "det_zeugs");
  AddDetail ( ({ "hinweis", "hinweise" }),
    "Lies einfach die Tafel an der Wand!");
  AddDetail ( ({ "eck", "ecke" }),
      "In der Ecke siehst Du auch einige Gegenstaende rumliegen.");
  AddDetail ("gegenstaende",
      "Da waere etwa eine alte Dose, die niemand braucht.");
  AddDetail ( ({ "dose", "blechdose" }),
      "Eine kleine braune Dose aus Blech. Vielleicht ist Kaffee drin?");
  AddDetail ( ({ "kaffee" }),
      "Du traust Dich nicht nachzusehen.");
  AddDetail ( ({ "blech" }),
      "Gewoehnliches Blech, wohl von Zwergen geschmiedet.");
  AddDetail ( ({ "zwerge" }),
      "Ja, die koennen sowas meisterhaft!");
  AddDetail ("kasse",
    "Eine grosse, alte Kasse. Sie zeigt gerade 407,00 an.\n");
  AddDetail ("eingang", "Eine schlichte Tuer bildet den Eingang.\n");
  AddDetail ("tuer", "An der Tuer haengt ein Schild.\n");
  AddDetail ("schild", "Du kannst es lesen.\n");
  AddDetail ("tafel", "Du kannst sie lesen.\n");
  AddDetail ( ({"boden", "decke"}),
    "Du kannst daran nichts Besonderes erkennen.\n");
  AddDetail ( ({"wand", "waende"}),
    "Ganz normale Waende. In einer davon ist eine Tuer, durch die Du wohl "
    "hereingekommen sein musst.\n");

  AddDetail ( ({"kaugummiautomat","automat","kasten","holzkasten"}),
    "An einer Wand ist ein seltsamer Kasten aus Holz befestigt. Die "
    "Oberseite des Kastens haelt eine grosse Glaskugel. Unter einem Muenzschlitz "
    "und einem Hebel siehst Du ein kleines Fach.");  
  AddDetail ( ({"holz"}),
    "Das Holz aus dem der Kasten gemacht ist, ist mit spiralfoermig nach oben "
    "laufenden roten und weissen Streifen bemalt. Offenbar verbirgt sich "
    "darin eine Mechanik.");
  AddDetail ( ({"mechanik"}),
    "Das scheint ein Kaugummiautomat zu sein.");
  AddDetail ( ({"rote","weisse","streifen","spiralen"}),
    "Irgendwie erinnert Dich das an Erdbeeren und Sahne.");
  AddDetail ( ({"oberseite"}),
    "Eine grosse Glaskugel ist fest mit der Oberseite verbunden.");
  AddDetail ( ({"glaskugel"}),
    "Die grosse Glaskugel ist gefuellt mit vielen bunten Kaugummikugeln. "
    "Zwischen den Kaugummikugeln scheinen auch andere Sachen zu sein.");
  AddDetail ( ({"glas"}),
    "Wie schoen, dass Glas durchsichtig ist, so kann man die Kaugummis sehen");
  AddDetail ( ({"erdbeeren","sahne"}),
    "Lecker!");
  AddDetail ( ({"sachen"}),
    "Leider kannst Du die nicht genau erkennen.");
  AddDetail ( ({"kaugummikugeln","kaugummi","kaugummis","kugeln"}),
    "Mjam!");

  AddDetail ( ({"muenzschlitz"}),
    "Da kann man Muenzen rein stecken. Neben dem Muenzschlitz klebt ein kleines "
    "Schildchen.");
  AddDetail ( ({"hebel"}),
    "Sieht so aus, als koennte man den Hebel drehen.");
//TODO
  AddDetail ( ({"fach"}),
    "Das Fach ist leer.");
  AddDetail ( ({"schildchen"}),
    "Das Schildchen kann man lesen.");
  AddReadDetail ("schildchen", "Auf dem kleinen Schildchen steht: 20 Muenzen\n");

  AddCmd ( ({"stecke","steck"}), "cmdPay");
  AddCmd ( ({"drehe","dreh"}), "cmdTurn");
  AddCmd ( ({"ziehe","zieh"}), "cmdPull");
  AddCmd ( ({"druecke","drueck"}), "cmdPush");
  AddCmd ( ({"nimm","nehme","nehm"}), "cmdTake");

  AddReadDetail ("schild", "Auf dem Schild steht: Wir bauen gerade um!\n");
  AddReadDetail ("tafel",
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
    "                  Haendler dafuer bezahlt.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

//  SetStorageRoom (LAGER);

  // AddItem (OBJ("div/teddyautomat"), REFRESH_REMOVE);
  AddExit ("sueden", "./room_e5");

//  AddItem (NPC "landar", REFRESH_DESTRUCT);
}

