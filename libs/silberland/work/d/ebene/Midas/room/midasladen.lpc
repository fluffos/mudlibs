void laeuten(object who)
{
  if (who->QueryProp(P_INVIS)) return;
  while (remove_call_out("klingeling") != -1) /* continue */ ;
  call_out("klingeling", 4, who);
}

void exit()
{
  laeuten(previous_object());
}

void init()
{
  ::init();
  laeuten(TP);
}

void klingeling(object who)
{
  if (!who) return;
  Message(
      "Die Tuer schliesst sich mit einem Klingeln hinter " +
      who->name(WEM) + ".\n", MSGFLAG_SOUND,
      ([ MSGFLAG_EXCLUDE : ({ who }) ]) );
  if (environment(who) == ME)
    who->Message(
        "Die Tuer schliesst sich mit einem Klingeln hinter Dir.\n",
        MSGFLAG_SOUND);
}


int cmdPay(string str) {
  int i;
  string where;
  notify_fail("Wieviele Muenzen willst Du wo rein stecken?\n");
  if(!str) return 0;

  str = regreplace(str, "^muenze ", "1 muenzen ", 1);
  if (2 != sscanf(str, "%d muenzen in %s", i, where) &&
      2 != sscanf(str, "%d in %s", i, where)) return 0;
  if((where!="muenzschlitz" && where!="schlitz") || i<1) return 0;

  printf("Du steckst "+(i>1?"%d Muenzen":"eine Muenze")+" in den Muenzschlitz.\n", i);
  Message(BS(TP->Name()+" steckt etwas in den Muenzschlitz des hoelzernen Kastens."),
          MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE :({TP})]));
  coins += i;
  TP->AddMoney(0-i);
  return 1;
}


void turn() {
  Message("Der Kasten klickt leise.\n", MSGFLAG_SOUND);
  write(BS("Da sonst nichts passiert, muss man wohl noch etwas tun. "
           "Drehen laesst sich der Hebel nicht mehr, aber vielleicht "
           "kann man ihn ziehen?"));
  hebel=1;
}

int cmdTurn(string str) {
  notify_fail("Was willst Du drehen?\n");
  if(str!="hebel") return 0;

  if(coins<20 || hebel!=0 || find_call_out("turn")!=-1) {
    write("Du versuchst den Hebel zu drehen aber der bewegt sich nicht.\n");
    return -1;
  }
  write("Du drehst den Hebel bis er einrastet.\n");
  AddDetail("hebel","Vielleicht kann man den Hebel ziehen.");
  Message(TP->Name()+" dreht einen Hebel.\n",
          MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE :({TP})]));
  Message("Der Kasten beginnt zu rattern.\n", MSGFLAG_SOUND);
  call_out("turn",random(4)+3);
  return 1;
}

void pull1() {
  write(BS("Gespannt wartest Du auf Deinen Kaugummi, doch es tut sich nichts. "
           "Vielleicht muss man noch etwas mit dem Hebel machen?"));
  hebel=2;
}

void pull() {
  Message("Die Kaugummis in der Glaskugel wirbeln ploetzlich durcheinander.\n",
          MSGFLAG_VISUAL);

  call_out("pull1",random(4)+1);
}

int cmdPull(string str) {
  notify_fail("Was willst Du ziehen?\n");
  if(str!="hebel") return 0;

  if(hebel!=1 || find_call_out("pull")!=-1 || find_call_out("pull1")!=-1) {
    write("Du versuchst den Hebel zu ziehen, doch der bewegt sich nicht.\n");
    return -1;
  }

  write("Du ziehst den Hebel bis zum Anschlag heraus und wartest.\n");
  AddDetail("hebel","Der Hebel ist herausgezogen. Was koennte man wohl mit dem tun?");
  Message(TP->Name()+" zieht einen Hebel.\n",
          MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE :({TP})]));
  call_out("pull",random(4)+3);
  return 1;
}

void push1() {
  Message("Der Kasten gibt etwas aus.\n", MSGFLAG_VISUAL);
  Message("Du hoerst das Klimpern von Muenzen.\n", MSGFLAG_SOUND);
  AddDetail("fach","Im Fach liegt etwas.");  
  AddDetail("etwas","Es liegt in dem Fach des Kastens.");
  hebel=0;
  gum++;
  coins=0;
}

void push() {
  Message("Du hoerst ein leises Rollen aus dem Kasten.\n",
          MSGFLAG_SOUND);
  call_out("push1",random(4)+3);
}

int cmdPush(string str) {
  notify_fail(".\n");

  if(hebel!=2 || find_call_out("push")!=-1 || find_call_out("push1")!=-1) {
    write("Du versuchst den Hebel zu druecken, doch der bewegt sich nicht.\n");
    return -1;
  }

  write(BS("Du drueckst den Hebel zurueck in seine Ausgangsposition bis "
           "er einrastet und wartest gespannt.\n"));
  AddDetail ( ({"hebel"}), "Sieht so aus, als koennte man den Hebel drehen.");
  Message(TP->Name()+" drueckt einen Hebel.\n",
          MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE :({TP})]));
  Message("Der Kasten rattert.\n",MSGFLAG_SOUND);
  call_out("push",random(4)+3);
  return 1;
}

object chooseItem() {
  int i;
  i = random(100);

  if(cnt==MAX_NO_ITEM || i<5 && cnt>MIN_NO_ITEM) {
    cnt = 0;
    return clone_object(specials[random(sizeof(specials))]);
  }    
  cnt++;
  if(i<TOY_PROBABILITY)
    return clone_object(toys[random(sizeof(toys))]);
  return clone_object(candy[random(sizeof(candy))]);
}

int cmdTake(string str) {
  object ob;
  notify_fail("Was willst Du aus dem Fach nehmen?\n");
  if(str!="etwas aus fach" && str!="alles aus fach") return 0;
  if(gum<1) {
    write("Das Fach ist leer.\n");
    return 0;
  }
  if(ob=chooseItem()) {
    ob->move(TP,M_GET);
    write("Du nimmst etwas aus dem Fach.\n");
    Message(TP->Name()+" nimmt etwas aus einem Fach.\n",
          MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE :({TP})]));
    AddDetail ( ({"fach"}), "Das Fach ist leer.");
    gum--;
  }
  else write("Du hast Dich geirrt, da ist doch nichts.\n");

  return 1;
}