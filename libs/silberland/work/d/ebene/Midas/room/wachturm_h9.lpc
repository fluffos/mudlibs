#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Auf einem hohen Wachturm");
  SetProp (P_INT_LONG,
    "Du erklimmst den hohen Wachturm mit Mueh und Not, doch was sich Dir "+
    "hier eroeffnet, entlohnt Dich fuer Deine Muehe: ein wundervoller "+
    "Ausblick ueber das ganze Land verschlaegt Dir den Atem, einzig der "+
    "noch etwas hoehere Kirchturm bietet wohl eine noch schoenere "+
    "Aussicht. Unter Dir im Osten siehst Du das Feldlager und dahinter "+
    "die weite Steppe, in der offenbar jemand ein altes Zelt "+
    "zurueckgelassen hat, aber genaueres kannst Du nicht erkennen. Und "+
    "weit im Sueden tut sich das grosse weite Meer auf, mitsamt seinen "+
    "Wundern und Gefahren... Du bist einfach nur noch fasziniert.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"aussichtsturm", "turm", "wachturm"}),
    "Du stehst auf ihm und geniesst den Ausblick.");
  AddDetail ( ({"aussicht", "ausblick", "blick"}),
    "Du geniesst den Ausblick ueber das weite Land und laesst Deinen Blick "+
    "langsam ueber das Feldlager und die Steppe weiter nach Sueden zum "+
    "fernen Meer und hinter den Horizont gleiten...");
  AddDetail ( ({"kirche"}),
    "Unter anderem kannst Du eine maechtige Kirche erkennen, aber das "
    "weitaus imposanteste an ihr ist sicherlich der hohe Kirchturm.");
  AddDetail ( ({"kirchturm"}),
    "Der Kirchturm ist wohl der mit Abstand hoechste Punkt in ganz Midas.");
  AddDetail ( ({"abstand"}),
    "Mit relativ grossem Abstand sogar.");
  AddDetail ( ({"land"}),
    "Das Land erstreckt sich weit nach Osten und Sueden hin, bis zum Meer.");
  AddDetail ( ({"punkt"}),
    "Hoehenmaessig, versteht sich.");
  AddDetail ( ({"midas", "stadt"}),
    "Die maechtige Stadt Midas unter Dir erstreckt sich nach Westen und "+
    "Norden. Du siehst von hier aus den Laden auf der belebten "+
    "Hauptstrasse, eine kleine Kapelle, die Abenteurergilde und nicht "+
    "zuletzt eine maechtige Kirche, deren Kirchturm sich hoch ueber die "+
    "Daecher von Midas erhebt.");
  AddDetail ( ({"daecher","dach"}),
    "Unter den Daechern befinden sich wohl die Haeuser.");
  AddDetail ( ({"haeuser"}),
    "Midas hat viele Haeuser, und von hier oben aus kannst Du sie alle "
    "erkennen. Naja, fast alle.");
  AddDetail ( ({"haus"}),
    "Welches denn, ein bestimmtes?");
  AddDetail ( ({"laden"}),
    "In diesem Laden kann man Dinge nicht nur kaufen sondern auch "+
    "verkaufen.");
  AddDetail ( ({"ding", "dinge"}),
    "Wenn Du wissen willst, was, solltest Du dort mal vorbeischauen.");
  AddDetail ( ({"hauptstrasse", "strasse"}),
    "Die Hauptstrasse in Midas durchzieht die Stadt vom Westende bis nach "+
    "Osten von Tor zu Tor. Viele Abenteurer tummeln sich auf ihr.");
  AddDetail ( ({"tor", "tore", "ende", "westende", "ostende"}),
    "Du kannst von hier aus zwei grosse Tore erkennen, eines unmittelbar "+
    "im Norden von Dir, und eines am anderen Ende der Hauptstrasse weiter "+
    "im Westen. Durch sie kannst Du Midas verlassen und gelangst in die "+
    "weite Welt.");
  AddDetail ( ({"welt"}),
    "Die Welt besteht ja nicht nur aus Midas.");
  AddDetail ( ({"abenteurer"}),
    "Sie eilen geschaeftig durch die Strassen von Midas. Die meisten "+
    "tummeln sich auf der Hauptstrasse herum.");
  AddDetail ( ({"mueh", "muehe", "not"}),
    "Sie war es wert - Du hast es leztendlich doch geschafft, den Wachturm "+
    "zu erklimmen und geniesst nun die Aussicht.");
  AddDetail ( ({"feldlager", "lager"}),
    "Das Feldlager im Osten scheint verlassen zu sein. Irgendwo erkennst "+
    "Du noch ein Zelt, aber das wars auch schon.");
  AddDetail ( ({"zelt"}),
    "Das Zelt scheint wie das Lager auch verlassen zu sein.");
  AddDetail ( ({"steppe"}),
    "Die Steppe erstreckt sich hinter dem Feldlager weit nach Osten hin.");
  AddDetail ( ({"atem"}),
    "Der Ausblick raubt ihn Dir.");
  AddDetail ( ({"strassen"}),
    "Midas ist von etlichen Strassen durchzogen, aber die wichtigste und "+
    "groesste unter ihnen ist die Hauptstrasse, die sich vom West- bis zum "+
    "Ostende der Stadt erstreckt, von Tor zu Tor.");
  AddDetail ( ({"abenteuer", "gefahren", "schoenheit", 
                "wunder"}),
    "Das weite Meer birgt nicht nur unendliche Wunder und Schoenheit, "+
    "sondern auch Gefahren und Abenteuer.");
  AddDetail ( ({"meer"}),
    "Weit im Sueden, kaum mehr zu erkennen, oeffnet sich das weite Meer "+
    "und erstreckt sich bis hinter den Horizont und noch weiter. Blau, "+
    "rauschend, unheimlich... voller Wunder aber auch Gefahren - wirst Du "+
    "sie bestehen koennen?");
  AddDetail ( ({"horizont","ferne"}),
    "Die wundervolle Aussicht laesst den Horizont in unendliche Ferne "+
    "ruecken.");
  AddDetail ( ({"kapelle","ort"}),
    "Die kleine, vertraeumte Kapelle scheint ein Ort der Ruhe und "+
    "Besinnung inmitten der belebten Stadt zu sein.");
  AddDetail ( ({"besinnung", "ruhe"}),
    "Suchst Du sie? Vielleicht findest Du, was Du suchst, in der kleinen "+
    "Kapelle?");
  AddDetail ( ({"abenteurergilde", "gilde"}),
    "Sie ist ein beliebter Treffpunkt von Abenteurern und dient auch dazu, "+
    "deren Faehigkeiten zu verbessern, Zaubersprueche zu lernen und "+
    "aehnliches.");
  AddDetail ( ({"faehigkeiten", "zaubersprueche","magie"}),
    "Abenteurer beherrschen durchaus ein wenig Magie. Nicht viel, aber "
    "doch... sogar von einem Feuerzauber hat man schon gehoert.");
  AddDetail ( ({"feuerzauber"}),
    "Frag mal andere Spieler - vielleicht weiss jemand was davon?");
  AddDetail ( ({"treffpunkt"}),
    "Hmm - das einfachste ist wohl, Du schaust selbst mal dort vorbei!");
  AddDetail ( ({"boden"}),
    "Du stehst auf dem steinigen Boden des hohen Wachturms.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist blau und wolkenlos. Du freust Dich.");
  // DETAILS END

  // EXITS START
  AddExit ("unten", "./wachturm1_h9");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
