inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave mapping schliessfach = ([ ]);  // Die Sachen in den Schliessfaechern

QueryMember (str)
{
  return (member(schliessfach, str));
}

AddMember (str)
{
  schliessfach += ([ str: ({ }) ]);
}

AddItem (str, obj)
{
  schliessfach[str] += ({ obj });
}

RemoveItem (str, obj)
{
  schliessfach[str] -= ({ obj });
  if (sizeof(schliessfach[str]) < 1)
    schliessfach -= ([ str ]);
}

QueryItem (str, oname)
{
  int i;

  i = -1;
  if (member(schliessfach, str))
    for (i=sizeof(schliessfach[str])-1; i>=0; i--)
      if (schliessfach[str][i]->id(oname))
        break;
  if (i<0)
    return (0);
  else
    return (schliessfach[str][i]);
}

QueryAll ()
{
  return schliessfach;
}

QueryCustomer ()
{
  return (m_indices(schliessfach));
}

QueryContent (str)
{
  int i, j;
  string result;
  mixed keys;

  result = "";
  if (str)
  {
    if (member(schliessfach, str))
      for (i=sizeof(schliessfach[str])-1; i>=0; i--)
      {
        result += "    ";
        result += schliessfach[str][i]->QueryProp(P_SHORT);
        result += "\n";
      }
    else
      result += "Kein Schliessfach.\n";
  }
  else
  {
    keys = m_indices(schliessfach);
    sort_array(keys, #'<);
    for (j=sizeof(keys)-1; j>=0; j--)
    {
      result += keys[j];
      result += "\n";
      for (i=sizeof(schliessfach[keys[j]])-1; i>=0; i--)
      {
        result += "    ";
        result += schliessfach[keys[j]][i]->QueryProp(P_SHORT);
        result += "\n";
      }
    }
  }
  return result;
}

CheckWeight (str)
{
  int i, value;

  value = 0;
  for (i=sizeof(schliessfach[str])-1; i>=0; i--)
    value += schliessfach[str][i]->QueryProp(P_WEIGHT);
  return value;
}

CheckValue (str)
{
  int i, value;

  value = 0;
  for (i=sizeof(schliessfach[str])-1; i>=0; i--)
    value += schliessfach[str][i]->QueryProp(P_VALUE);
  return value;
}

EmptyAccount (str, room)
{
  int i;

  if (member(schliessfach, str))
  {
    for (i=sizeof(schliessfach[str])-1; i>=0; i--)
      schliessfach[str][i]->move(room, M_NOCHECK);
    schliessfach -= ([ str ]);
    tell_room(room, "Ein Bankangestellter tritt hervor und wirft den ganzen Inhalt eines Schliessfaches einfach auf den Boden.\n");
  }
}
