inherit "/d/ebene/Midas/room/bank/bank";

#include <properties.h>
#include <rooms.h>
#include <moving.h>

string bankhilfe();

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp( P_INT_SHORT,"In der Silberbank");
  SetProp(P_INT_LONG, "Du befindest Dich in der Silberbank, der aeltesten "+
     "und renommiertesten Bank im ganzen Silberland. Da es aber auch die "+
     "einzige Bank im Silberland ist, scheint das nicht allzuviel zu "+
     "bedeuten. Die Einrichtung ist recht spartanisch, kein Teppich, keine "+
     "Tapeten, kein Vorhang. Nur ein blanker Holzboden und ein paar billige "+
     "Bilder an den Waenden. Am Schalter steht ein grosses Schild.");

  AddDetail ( ({"bank", "silberbank"}), "Du stehst mittendrin!");
  AddDetail ( ({ "boden", "holz" }), "Nur ein ganz einfacher Holzboden. Was "+
    "machen die Banker hier nur mit all dem Geld?");
  AddDetail ( ({ "teppich", "tapeten", "vorhang" }),
    "Wie schon gesagt, nicht da. Warum glaubst Du mir denn nicht?");
  AddDetail ( "einrichtung", "Nur ein kleiner Tisch mit einem Sessel in einer "+
    "Ecke. Abgesehen vom Schalter.");
  AddDetail ( ({ "tisch", "sessel", "ecke" }), "Ein einfacher Holztisch, und "+
    "ein ebenso einfacher Holzsessel stehen in einer Ecke. Vermutlich damit "+
    "man in Ruhe seine Kontoauszuege studieren kann.");
  AddDetail ( ({ "bilder", "wand", "waende" }), "Nur ein paar einfache "+
    "Bilder schmuecken die Wand.");
  AddDetail ( "schalter", "Auch der Schalter ist nicht besser ausgestattet "+
    "als der Rest der Bank. Allerdings wird der Bankbeamte durch massive "+
    "Gitterstaebe, vor dem Zugriff boeswilliger Mitbuerger geschuetzt. Neben "+
    "dem Schalter ist ein grosses Schild.");
  AddDetail ( ({ "gitter", "staebe", "gitterstaebe" }), "Massiver Stahl! "+
    "So leicht kommt da keiner vorbei.");
  AddDetail ( ({ "beamter", "bankbeamter" }), "Hinter dem Schalter steht "+
    "ein unscheinbarer Beamter. Er ist so unauffaellig, das Du ihn glatt "+
    "uebersehen koenntest, wenn Du nicht gerade Geld brauchen wuerdest.");
  AddDetail ( "decke", "Die Decke ist, wie auch der Boden und die Waende, "+
    "ganz aus Holz. Nur ein kleines Loch faellt dir auf.");
  AddDetail ( "loch", "Durch das kleine Loch in der Decke siehst Du "+
    "das Auge eines Zwerges.");
  AddDetail ( ({ "auge", "zwerg" }), "Als du genauer hinsiehst, bemerkst "+
    "du auch einen Stift und einen Zeichenblock in der Hand des Zwerges.");
  AddDetail ( ({ "stift", "zeichenblock" }), "Offensichtlich ist der Zwerg "+
    "angestellt, um im Falle eines Bankueberfalles schnell ein Bild vom "+
    "Taeter zu haben.");
  AddDetail ( "schild", "Du kannst es lesen.");
  AddReadDetail ("schild", #'bankhilfe);

  AddSound ( DEFAULT_SOUND, "Bis auf etwas Gemurmel an einem Schalter ist "+
    "nichts zu hoeren." );
  AddSound ( "gemurmel","Du verstehst nur undeutlich: 'Geld oder Leben !' ?!?");
  AddSound ( "geld oder leben", "Du hast dich nur verhoert, sollte wohl: "+
    "'Ich brauche etwas Geld fuer die Liebe', heissen.");
  AddSound ( "geld fuer die liebe", "Nein, nein. Du hast dich schon wieder "+
    "verhoert, das Spiel hier ist ja schliesslich jugendfrei. Es muss "+
    "natuerlich: 'Ich brauche etwas Geld fuer meine Lieben', heissen.");

  AddSmell ( DEFAULT_SMELL, "Es riecht nach Geld.");
  AddSmell ( ({ "geld", "gold", "muenzen" }), "Geld stinkt nicht." );

  AddExit("osten", "/d/ebene/Midas/room/room_c3");
}


string bankfile()
{
  return ("/d/ebene/Midas/room/bank/sbank");
}


string bankhilfe()
{
  hilfe("bank");
  return "";
}

