inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

#ifdef LOGF
#undef LOGF
#endif

#define LOGF "/d/ebene/log/typo.log"

int typo;

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem kleinen Seitenweg, der sich von Sueden "
    "nach Osten hin durch die Stadt schlaengelt, an verschiedenen "
    "Gebaeuden vorbei. Im Norden kannst Du ein groesseres, aus "
    "vielen kleinen massiven und sehr gleichfoermig gehauenen "
    "Steinbloecken erbautes Bauwerk erkennen, das Du durch ein "
    "grosses Tor betreten kannst, waehrend sich suedoestlich von "
    "Dir die prachtvolle Kirche erhebt.");

  SetProp (P_INT_SHORT, "Seitenweg in Midas");

  // DETAILS START
  AddDetail ( ({"seitenweg","weg"}), "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ( ({"morgensonne", "sonne"}),
      "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ( ({"hauptstrasse", "strasse"}),
    "Die Hauptstrasse befindet sich weiter im Norden.");
  AddDetail ( ({"gebaeude"}),
    "Einerseits die Kirche im Suedosten, andererseits das Rathaus "
    "direkt noerdlich von Dir. Und ein paar Haeuser hier und dort.");
  AddDetail ("haeuser", "Vermutlich wohnen Leute drin.\n");
  AddDetail ( ({"kirche"}),
    "Die prachtvolle Kirche erhebt sich vor Dir im Suedosten. Du kannst am "+
    "Kirchenschiff huebsche bunte Glasfenster erkennen.");
  AddDetail ( ({"kirchenschiff", "schiff", "innenraum"}),
    "Kirchenschiff nennt man den langgestreckten Innenraum einer Kirche, "+
    "in dem die meisten Leute Platz finden.");
  AddDetail ( ({"leute"}),
    "Ganz normale Leute halt.");
  AddDetail ( ({"platz"}),
    "Wuerdest Du nicht soviel brauchen, waere mehr davon hier!");
  AddDetail ( ({"fenster", "glasfenster"}),
    "Das Glas der Fenster schillert in den buntesten Farben.");
  AddDetail ( ({"glas"}),
    "Normales Glas, aber bunt, in allen Farben des Lichts.");
  AddDetail ( ({"farben"}),
    "Auf Anhieb erkennst Du nur rot, gruen, blau und gelb, aber irgendwie "+
    "scheinen es doch wesentlich mehr Farben zu sein.");
  AddDetail ( ({"licht"}),
    "Licht ist einfach da, weil die Sonne scheint.");
  AddDetail ( ({"rathaus"}),
    "Das Rathaus befindet sich direkt noerdlich von Dir.");
  AddDetail ( ({"kirchturm", "turm"}),
    "Er befindet sich im oestlicheren Teil der Kirche.");
  AddDetail ( ({"bloecke", "steinbloecke"}),
    "Die Steinbloecke sind eher klein gehauen, etwa so gross wie sonst "+
    "Ziegel.");
  AddDetail ( ({"ziegel"}),
    "Ja, eigentlich koennte man hier von Ziegel sprechen, allerdings aus "+
    "Stein. Faszinierend.");
  AddDetail ( ({"stein"}),
    "Du betrachtest die Steinbloecke genauer und stellst fest, dass sie "+
    "mit Moertel verbunden wurden, um das Bauwerk zu bilden.");
  AddDetail ( ({"bauwerk", "werk"}),
    "Das Bauwerk ist ziemlich gross, offenbar ist es ziemlich wichtig. Du "+
    "kannst es durch ein offenbar stets offenes Tor nach Norden hin "+
    "betreten.");
  AddDetail ( ({"tor"}),
    "Das Tor ist noch ein gutes Stueck groesser als ein Elf, und die sind "+
    "bekanntlich schon nicht die Kleinsten. Ueber dem Tor kannst Du ein "+
    "grosses Schild erkennen.");
  AddDetail ( ({"stueck"}),
    "Nicht uebermaessig, aber doch deutlich.");
  AddDetail ( ({"elf", "elfen"}),
    ([ 0: "Elfen sind diese langen Wesen, die ueberall rumspazieren "
          "und ihre Liedchen traellern.",
       "elf": "Einer von Deiner Sorte!",
       "zwerg": "Ieks, gibts hier etwa Elfen in der Naehe???"
     ]));
  AddDetail ( ({"wesen"}),
    "Lebewesen.");
  AddDetail ( ({"lebewesen"}),
    "Wird Dir nicht schoen langsam langweilig?");
  AddDetail ( ({"liedchen"}),
    "Ein Liedchen kann man maximal hoeren.");
  AddSound ( ({"liedchen"}),
    "Du lauschst angestrengt, aber kannst zum Glueck keinen singenden Elf "+
    "lokalisieren.");
  AddSound (DEFAULT_SOUND,
    "Nur leises Stimmengemurmel, von ueberall her.");
  AddSound ( ({"gemurmel", "stimmengemurmel"}),
    "Das Gemurmel scheint omnipraesent zu sein.");
  AddDetail ( ({"moertel"}),
    "Gewoehnlicher Moertel, nichts was Dich naeher interessiert.");
  AddDetail ( ({"schild"}),
    "Ein langes Schild aus Stein, in das ein paar Buchstaben gemeisselt "+
    "sind. Du kannst es lesen.");
  AddDetail ( ({"buchstaben"}),
    "Sie sind in das Schild ueber dem Tor gemeisselt.");
  AddReadDetail ( ({"schild"}),
    "Auf dem Schild steht:\n\n@@radhaus@@");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "./room_d7");
  AddExit ("sueden", "./room_c8");
  AddExit ("norden", "./rathaus/eg");
  // EXITS END

  // ITEMS START
  AddItem ("/d/ebene/lamuerte/fernglas/npc/blinder",
      REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd ( ({"fehler","typo"}), "typo");
  typo=1;
}

void reset()
{
  ::reset();
  if (!typo) {
    typo=1;
    tell_room(ME,
        bs("Ein kleines Holzbrett loest sich vom Schild, faellt zu Boden "
            "und zersplittert in tausend kleine Teilchen."));
    RemoveDetail(({"holzbrett","brett"}));
    AddDetail ( ({"teilchen"}),
      "Du faengst an, die Teilchen zu zaehlen......\n"
      "...gibst aber bald auf. ;-)\n" );
    AddDetail ( ({"schild"}),
      "Ein langes Schild aus Stein, in das ein paar Buchstaben gemeisselt "+
      "sind. Du kannst es lesen.");
  }
}

string radhaus()
{
  if (typo)
    return " |\\/|. _| _  _    |~) _  _||_  _     _\n"
           " |  ||(_|(_|_\\ ,  |~\\(_|(_|| |(_||_|_\\\n";
  else
    return " |\\/|. _| _  _    |~) _ _|_|_  _     _\n"
           " |  ||(_|(_|_\\ ,  |~\\(_| | | |(_||_|_\\\n";
}

int typo (string str)
{
  int n;
  string log;

  if (!typo) {
    write(bs("Wenn Du das Schild ueber dem Tor meinst, das wurde doch "
      "schon korrigiert! Hoffentlich aendert sich das nicht..."));
    return 0;
  }

  write(bs("Gerade als Du den "+CAP(query_verb())+" melden willst, wuselt "
    "ein kleiner Hobbithandwerker herbei, befestigt ein kleines Holzbrett "
    "ueber dem falschen Buchstaben und verschwindet genausoschnell wieder.")+
    "\n");
  say(bs("Ein kleiner Hobbithandwerker wuselt herbei, grinst "+
    TP->name(WEN)+" an, befestigt ein kleines Holzbrett an dem "
    "Schild ueber dem Tor, kichert, winkt und verschwindet genauso "
    "schnell wieder, wie er aufgetaucht ist."));
  AddDetail(({"holzbrett","brett"}),
    "Das Holzbrett beinhaltet den Buchstaben 't'.\n");
  AddDetail ( ({"schild"}),
    "Ein langes Schild aus Stein, in das ein paar Buchstaben gemeisselt "+
    "sind. Ein kleines Holzbrett ist daran befestigt. Du kannst es lesen.");
  RemoveDetail(({"teilchen"}));
  typo=0;

  log = dtime(time()) + ": Typo gefunden von " + CAP(getuid(TP));

  if (!TP->FindPotion(bs("Ploetzlich bemerkst Du ein kleines Flaeschchen, "
      "das der Hobbit vergessen zu haben scheint. Du nimmst es an Dich "
      "und trinkst es, durstig wie Du bist, mit einem Schluck leer.")+
      "\nEs scheint zu wirken, und wie...\n\n"))
  {
    write(bs("Ploetzlich bemerkst Du ein kleines Flaeschchen, das der "
        "Hobbit vergessen zu haben scheint. Du nimmst es an Dich und "
        "trinkst es, durstig wie Du bist, mit einem Schluck leer.\n"));
    if (random(100)<80) {
      TP->heal_self(n=50+random(50));
      write("Mmmmh, lecker! Du fuehlst Dich deutlich erfrischt.\n\n");
    } else {
      TP->reduce_hit_point(n=30+random(20)); n = -n;
      write("Ohje, offenbar war der Inhalt schon leicht verdorben...\n\n");
    }
    log += sprintf(" [%+d]", n);
    write(
      "Jemand fluestert Dir zu: Falls Du jetzt noch einen Typo entdeckst,\n"
      "Jemand fluestert Dir zu: bitte melde ihn gleich nochmal...\n");
  }
  else
    log += " [-ZT-]";

  write_file(LOGF, log + "\n");
  return 1;
}

