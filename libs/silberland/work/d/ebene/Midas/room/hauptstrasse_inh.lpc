/*
** Hauptstrasse in Midas  (w) Woody@SL
** ---
** Jan 1996  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_ROAD, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG, bs(
    "Die Hauptstrasse in Midas erstreckt sich von Westen nach Osten. "+
    "Hier herrscht reger Betrieb, und Du bist froh, noch einigermassen "+
    "den Ueberblick bewahren zu koennen."));

  SetProp (P_INT_SHORT, "Hauptstrasse in Midas");

  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ( ({"wand","waende"}),
    "Du tastest die Luft nach Waenden ab, findest aber nichts.\n");
  AddDetail ("hauptstrasse", "Du befindest Dich auf ihr.\n");
  AddDetail ( ({"strasse","weg","boden","stein",
                "steine","pflaster","steinpflaster"}),
    "Der Boden besteht aus einem sehr gleichfoermigen Steinpflaster.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ("haeuser", bs(
      "Ueberall siehst Du Haeuser, kein Wunder, Du befindest Dich ja auch "
      "in einer Stadt."));
  AddDetail ("stadt", "Du befindest Dich mittendrin.\n");
  AddDetail ( ({"betrieb","treiben","abenteurer","haendler"}),
    "Viele Abenteurer und Haendler tummeln sich geschaeftig auf "+
    "der Hauptstrasse.\n");
}
