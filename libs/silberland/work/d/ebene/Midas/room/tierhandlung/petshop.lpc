/*
** Tierhandlung im Midas
**
*/

inherit "/p/service/angel/haustiere/std_petshop";

#include "/p/service/angel/haustiere/std_pet.h"
#include "../../midas.h"
#include <laden.h>
#include <properties.h>

#define PET_NPC "/p/service/angel/haustiere/npc/"
#define PET_OBJ "/d/ebene/obj/div/tierhandlung/"

#define ANSCHLUSS "/d/ebene/Midas/room/room_c3"

#define CLOSURE(x) #'x // #'

string query_pet_sound()
{
  return ({
    "Das Klaeffen eines Hundes.",
      "Das Miauen einer Katze.",
      "Das Laufen eines Hamsters in seinem Laufrad.",
      "Das Kraehen eines Raben.",
      "Das Kreischen eines Wellensittichs." })[random(5)]+"\n";
}

void create()
{
  ::create();

  // Laden-Konstanten:
  SetProp(P_SHOPKEEPER_NAME, "Werner");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOPKEEPER_ID, "werner");
  SetProp(P_SPECIAL_SHOP, 
	  ([1:"In dieser Tierhandlung kannst Du Tiere nur kaufen.\n"]));
  
  catch(call_other(ROOM "tierhandlung/pet_store", "???"));
  SetStorageRoom(ROOM "tierhandlung/pet_store");
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));

  SetProp(P_INT_SHORT, "Werners Tierhandlung");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich hier in Werners Tierhandlung. Der Raum ist "
	     "ueber und ueber mit Kaefigen vollgestopft. Es bleibt gerade "
	     "noch genug Platz fuer einen kleinen Tisch in der Raummitte. "
	     "Werner, der Besitzer dieser Tierhandlung, wuselt staendig "
	     "von einem Kaefig zum naechsten, um sich um die Tiere zu "
	     "kuemmern."));

  SetProp(P_PET_KONFIG_TOOL, "/p/service/angel/haustiere/obj/pfeife");
  
  AddDetail(({"raum","handlung","tierhandlung"}),
	    QueryProp(P_INT_LONG));
  
  AddReadDetail(({"tafel", "preistafel"}), CLOSURE(GetPriceList));
  
  AddDetail(({"tisch","holztisch"}),
	    "Ein kleiner Holztisch, auf dem sich nur eine hoelzerne Tafel "
	    "befindet. Nichteinmal ein Sessel steht daneben. Unter dem Tisch "
	    "scheinen sich ein paar Saecke zu befinden.");
  
  AddDetail(({"sessel","holzsessel"}),
	    "Werner scheint sehr beschaeftigt zu sein, nicht einmal einen "
	    "Sessel besitzt er.");
  
  AddDetail(({"tafel","preistafel","preise"}),
	    "Hier sind scheinbar die Preise der Tiere notiert.");
  
  AddDetail(({"geschaeft","geschaefte"}),
	    "Interessierst Du Dich vielleicht fuer eines der Tiere?");
  
  AddDetail(({"werner","besitzer"}),
	    "Werner scheint nicht da zu sein.");
  
  AddDetail(({"boden","tierhandlungsboden","fussboden","steinboden"}),
	    "Der Fussboden wirkt fuer eine Tierhandlung ziemlich sauber. "
	    "Sonst wuerdest Du Tierkot und verschuettetes Futter ueberall "
	    "ueber den Boden verstreut erwarten.");
  
  AddDetail(({"decke","tierhandlungsdecke","holzdecke"}),
	    "Die Holzdecke sieht recht uninteressant aus.");
  
  AddDetail(({"platz","mitte","raummitte","tierhandlungsmitte"}),
	    "Der Raum ist so voll mit Kaefigen, dass nur noch die Raummitte "
	    "freigeblieben ist. Hier steht ein kleiner, hoelzerner Tisch "
	    "auf dem die Geschaefte abgewickelt werden.");
  
  AddDetail(({"waende","wand"}),
	    "Die Waende hier siehst Du nicht, Du siehst nur die vielen "
	    "Tierkaefige.");
  
  AddDetail(({"kot","tierkot","scheisse","tierscheisse"}),
	    "Davon siehst Du hier trotz der vielen Tiere erstaunlich wenig.");
  
  AddDetail(({"sack","saecke","futtersack","futtersaecke"}),
	    "Die Saecke scheinen Tierfutter zu enthalten.");
  
  AddDetail(({"tierfutter","futter","zubehoer","nahrung"}),
	    "Vielleicht moechtest Du ja davon etwas kaufen?");
  
  AddDetail(({"kaefig","kaefige","tierkaefig","tierkaefige"}),
	    "Hier stehen sehr viele, teilweise uebereinander gestapelte "
	    "Kaefige herum, die von allerlei Tieren bewohnt werden.");
  
  AddDetail(({"tier","tiere"}),
	    "Allerlei Tiere bewohnen die Kaefige. Hauptsaechlich Hunde, "
	    "Katzen, Hamster, Meerschweine und Voegel.");
  
  AddDetail(({"hamster","goldhamster"}),
	    "Werner hat hier vorwiegend Goldhamster.");
  
  AddDetail(({"meerschwein","meerschweine","meerschweinchen"}),
	    "Werner hat hier niedliche kleine Meerschweinchen in den "
	    "schoensten Farben und Groessen");
  
  AddDetail(({"farben","farbe"}),
	    "Werner hat hier Tiere in fast allen Farben.");
  
  AddDetail(({"form","formen","groesse","groessen"}),
	    "Werner hat hier Tiere in vielen verschiedenen Groessen.");
  
  AddDetail(({"rasse","rassen","hunderassen","katzenrassen"}),
	    "Werner hat hier viele verschiedene Hunde- und Katzenrassen.");
  
  AddSmell(DEFAULT_SMELL,
	   "Hier riecht es nach den verschiedensten Tieren.");

  AddSmell("tiere",
	   "Eingesperrte Tiere riechen nicht besonders angenehm.");

  AddSound(DEFAULT_SOUND,
	   "Du hoerst die verschiedensten Tierstimmen.");

  AddSound(({ "stimme", "stimmen", "tierstimme", "tierstimmen" }),
	   CLOSURE(query_pet_sound));
  
  AddItem(NPC "werner", REFRESH_DESTRUCT);
  
  RemoveItem("/obj/entsorg");
  
  RemoveCmd(({"verkauf","verkaufe","versetz","versetze"}));
  
  AddExit("norden", "nach Midas hinaus#" ANSCHLUSS);
  
  AddPet("hamster", PET_NPC "midas_hamster");
}

string GetExits(object viewer)
{
  string ret;

  if(strlen(ret=::GetExits(viewer)))
    return "Nach Norden hin kannst Du die Tierhandlung wieder verlassen.\n";

  return ret;
}

varargs string GetDetail(mixed key, mixed race)
{
  string ret;
  
  if(strlen(ret=::GetDetail(key, race)))
    return ret;
  
  if(strstr(key, "hund")!=-1)
    return "Hunde gibt es hier in allen moeglichen Farben und Rassen.\n";

  if(strstr(key, "katz")!=-1)
    return "Katzen gibt es hier in allen moeglichen Farben und Rassen.\n";
  
  return ret;
}
