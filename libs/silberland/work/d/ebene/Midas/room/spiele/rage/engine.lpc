nosave mapping ANSI_MAP;      // Ansi-Farben
nosave mapping rg_game;       // Spieler-Informationen
nosave mapping rg_int;        // Spiel-Informationen
nosave mapping TRANSLATE;     // Hilfsmapping
nosave string  *rg_player;    // Liste aller Spieler
nosave string  rg_active;     // Der Spieler der dran ist
nosave string  *rg_deck;      // Der Kartenstapel
nosave string  *rg_played;    // Die aufgespielten Karten
nosave string  *rg_off;       // Liste von "Aussteigern"

