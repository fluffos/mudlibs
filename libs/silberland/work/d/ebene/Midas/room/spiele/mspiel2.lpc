inherit "/d/ebene/padreic/std/mtisch";

#include <properties.h>     
#include <moving.h>
#include <language.h>  

#define ENV(x) environment(x)
#define TP     this_player()
#define TO     this_object()
#define SPIEL "/d/ebene/padreic/spiele/mspiel1.lpc"

create()
{
  if (!is_clone(this_object())) return;
  ::create(); 
  SetProp(P_SHORT, "Ein kleiner wackliger Plastikklapptisch");
  SetProp(P_LONG, "Irgendwie sieht der Tisch nicht so sonderlich vertrauenserweckend aus, aber\n"
                 +"bis zum naechsten Reboot/Crash wird er wohl schon halten. Auf ihm liegen ein\n"
                 +"kleines Regelbuch und eine Liste.\n");
  SetProp(P_INFO, "Hmm, wie waere es mit <packe spiel ein>?\n");
  SetProp(P_NOGET, "Der Tisch ist ein wenig zu sperrig um ihn einzustecken.\n");
  AddId("spiel");
  AddId("maexchenspiel");
  AddCmd(({"pack", "packe"}), "einpacken");
}

einpacken(string was)
{
  notify_fail("Was moechtest Du einpacken?\n");
  if (was!="spiel ein") return 0;
  if (sizeof(filter_array(all_inventory(), #'living))) {
    write("Solange noch jemand am Tisch sitzt, kannst Du das Spiel nicht einpacken.\n");
    return 1;
  }
  write("Muehsam packst Du den Klapptisch wieder ein.\n");
  if (ENV(TO)) // sicher ist sicher :)
    tell_room(ENV(TO), TP->name(WER)+" packt muehsam den Klapptisch wieder ein.\n", ({ TP }));
  SetProp(P_NOGET, 0);
  clone_object(SPIEL)->move(TP, M_GET);
  TO->remove(1);
  return 1;
}
  