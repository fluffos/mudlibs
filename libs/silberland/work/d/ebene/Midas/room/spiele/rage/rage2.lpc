/* Paracelsus: Rage-Spielraum (unten) */
/* Woody: Dankend erhaltend von Paracelsus, fuers SL ueberarbeitet */

#include "files.h"
#include "rage.h"
#include <ansi.h>
#include <properties.h>
#include <moving.h>
#include <language.h>
#include <exploration.h>
#include <defines.h>
#include <moredef.h>
#include "/p/daemon/channel.h"

#pragma strict_types

inherit BASE("rage/engine2");


void create()
{
    ::create();

    SetProp(P_INT_SHORT,"Midas Spielewelt, Ragelabor");
    SetProp(P_INT_LONG,BS(
        "Du befindest Dich in einem kleinen, dunklen Raum. Er enthaelt "
        "eigentlich nicht viel mehr als einen runden Tisch und acht "
        "Stuehle. Im Licht der vier Kerzen (es haengt je eine in jeder "
        "Ecke des Raumes) siehst Du, dass auf dem Tisch Karten liegen. "
        "Durch eine der drei Tueren kannst Du den Raum wieder verlassen. "
        "An einer Wand haengt ein Schild."));
    SetProp(P_NAME,"Ragelabor");
    SetProp(P_GENDER,NEUTER);
    SetProp(P_ARTICLE,1);

    AddExit( "sueden", ([
          EX_DEST     : "./rage",
          EX_TESTFUNC : #'TestPlayerExit
        ]) );

    AddExit( "osten", ([
          EX_DEST     : "+ebene/carador/choice/room/choice",
          EX_TESTFUNC : #'TestPlayerExit
        ]) );

    AddExit( "westen", ([
          EX_DEST     : "../arco/room/arco_raum",
          EX_TESTFUNC : #'TestPlayerExit
        ]) );

    catch(CHMASTER->join( "Rage", TO ));

    AddDetail( "kaffeezimmer",
        "Du stehst darin.\n");
    AddDetail( "kaffee",
        "Den siehst Du hier leider nicht.\n");
    AddDetail( "raum",
        "Du stehst in einem halbdunklen Raum.\n");
    AddDetail( "boden",BS(
        "Du stehst darauf. Das gilt uebrigens auch fuer den Tisch "+
        "und die acht Stuehle."));
    AddDetail( "tuer",
        "Durch diese Tuer gehts hinaus.\n");
    AddDetail( "tisch",BS(
        "Du siehst einen grosse, runden Tisch aus Holz. Um den Tisch "+
        "herum stehen acht Stuehle und auf dem Tisch entdeckst Du "+
        "viele blaue Karten."));
    AddDetail( "holz",BS(
        "Das Holz ist dunkelbraun und glaenzt leicht. Die Oberflaeche "+
        "des Tisches fuehlt sich glatt an, wahrscheinlich sollen die "+
        "Karten beim Geben besser rutschen."));
    AddDetail( ({"oberflaeche","tischoberflaeche"}),
        "Die Oberflaeche des Tisches ist glatt.\n");
    AddDetail( "geben",
        "Karten kann man geben.\n");
    AddDetail( ({"karte","karten"}),BS(
        "Auf dem Tisch liegen Karten. Allen ist gemeinsam, dass sie eine "+
        "blaue Rueckseite haben."));
    AddDetail( ({"rueckseite","rueckseiten"}),
        "Die Karten haben eine blaue Rueckseite. Ein Wort steht darauf.\n");
    AddDetail( "wort",
        "Das kannst Du bestimmt lesen.\n");
    AddDetail( "rage",
        "So heisst das Spiel, das man hier spielen kann.\n");
    AddDetail( "spiel",
        "Hier kann man 'Rage' spielen.\n");
    AddDetail( "decke",
        "Die Decke befindet sich ueber Dir.\n");
    AddDetail( ({"wand","waende"}),BS(
        "Du zaehlst vier Waende. In einer Wand haengt ein Schild."));
    AddDetail( "schild",
        "Das kannst Du bestimmt lesen.\n");
    AddDetail( ({"ecke","ecken"}),
        "Dieser Raum hat vier Ecken. In jeder Ecke brennt eine Kerze.\n");
    AddDetail( ({"kerze","kerzen"}),
        "Der Raum wird von vier Kerzen erhellt.\n");
    AddDetail( "licht",
        "Das Licht kommt von den Kerzen.\n");
    AddDetail( "luft",
        "Die Luft ist leicht stickig.\n");
    AddSpecialDetail( ({"stuhl","stuehle"}),"D_stuehle");
    AddDetail( "rcsl",
        "Das musst Du jetzt nicht verstehen.\n");

    AddReadDetail( ({"rueckseite","rueckseiten","wort"}),
        "Du liest: RAGE\n");
    AddReadDetail( "schild",
        "Du liest:\n\n"
        " ,-------------------------------------------------------------.\n"
        " |             Willkommen im Ragelabor des RCSL !              |\n"
        " |                                                             |\n"
        " |                Hier kann man Rage spielen.                  |\n"
        " |                    (Hardcore-Mini-Rage)                     |\n"
        " |                                                             |\n"
        " |                      -> 'ragehilfe'                         |\n"
        " |                                                             |\n"
        " | Warnung: Dieses Spiel befindet sich noch im Teststadium!    |\n"
        " | Dank gebuehrt vor allem dem Autor, Paracelsus@Morgengrauen. |\n"
        " `-------------------------------------------------------------'\n"
        );

    AddSmell( DEFAULT_SMELL,
        "Es riecht ein wenig stickig hier.");

}


// Damit der Raum auch nach Update des channeld auf -Rage lauscht/redet
void init()
{
  catch(CHMASTER->join( "Rage", TO ));
  ::init();
}

// prevent room from discarding
void clean_double() {}

// prevent room from being discarded from memory
int clean_up(int refcount) { return 1; }

