int resourcen_klasse()
{
  int help;
  help=0;
  help+=daten[0][ARCO_STEINE]*2;
  help+=daten[0][ARCO_JUWELEN]*2;
  help+=daten[0][ARCO_MONSTER]*2;
  help-=daten[1][ARCO_STEINE];
  help-=daten[1][ARCO_JUWELEN];
  help-=daten[1][ARCO_MONSTER];
  return help;
}

int resourcen_je_runde_klasse()
{
  int help;
  help=0;
  help+=daten[0][ARCO_STEINBRUCH]*35;
  help+=daten[0][ARCO_MAGIE]*35;
  help+=daten[0][ARCO_ZOO]*35;
  help-=daten[1][ARCO_STEINBRUCH]*35;
  help-=daten[1][ARCO_MAGIE]*35;
  help-=daten[1][ARCO_ZOO]*35;
  return help;
}
