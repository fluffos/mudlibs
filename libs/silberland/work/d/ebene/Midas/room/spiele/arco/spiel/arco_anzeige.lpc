#define NEED_PROTOTYPES

#include "../spiel.h"

#include <ansi.h>
#include <terminal.h>
#include <defines.h>
#include <properties.h>
#include <wizlevels.h>

#pragma strong_types

public void zeige(mixed pl1,mixed pl2,int wer,int zielt,int zielr,int zuganzahl);
public void zeige2(mixed pl1,mixed pl2,int wer,int zielt,int zielr,int zuganzahl,object wem);
public void zeige3(mixed pl1,mixed pl2,int wer,int zielt,int zielr,int zuganzahl,object wem);

private string output_farbe(object pl,string farbe,string text)
{
  return text;
}

private string zug(int wer)
{
  switch(wer)
  {
    case 1: return "Dir";
    default: return "Gegner";
  }
  return "";
}

private string zug2(int wer,mixed pl1,mixed pl2)
{
  switch(wer)
  {
    case 1: if (pl1->QueryProp(P_NPC)) return pl1->name(WER); return CAP(getuid(pl1));
    default: if (pl2->QueryProp(P_NPC)) return pl2->name(WER); return CAP(getuid(pl2));
  }
  return "";
}

private string balken(int anzahl,int anzahlmax,int richtung,object pl)
{
  string ret;
  ret = "";
  anzahl=anzahl*20/anzahlmax;
  if (anzahl<0) anzahl=0;
  if (anzahl>20) anzahl=20;
  for (;anzahl--;)
    ret+="#";
  if (richtung) return output_farbe(pl,INFO_COL3,sprintf("%-20s",ret));
  return output_farbe(pl,INFO_COL1,sprintf("%20s",ret));
}

private string balken2(int anzahl,int anzahlmax,int richtung)
{
  string ret;
  ret = "";
  anzahl=anzahl*20/anzahlmax;
  if (anzahl<0) anzahl=0;
  if (anzahl>20) anzahl=20;
  for (;anzahl--;)
    ret+="#";
  if (richtung) return sprintf("%-20s",ret);
  return sprintf("%20s",ret);
}

public string liefere_anzeige(mixed pl1,mixed pl2,int wer,int zielt,int zielr,int zuganzahl)
{
  string ausgabe;
  ausgabe =
    sprintf("\n+%'-'76s+\n"
      "| %-20s       Zug (%3d) bei %-12s %20s |\n"
      "|                   Turm=%5d Rohstoff=%5d Turm Gegner=0                  |\n"
      "| Steine  %-+3d %-3d|%s++%s|%3d %+3d  Steine |\n"
      "| Juwelen %-+3d %-3d|%s++%s|%3d %+3d Juwelen |\n"
      "| Monster %-+3d %-3d|%s++%s|%3d %+3d Monster |\n"
      "| Turm        %-3d|%s++%s|%3d       Turm |\n"
      "| Mauer       %-3d|%s++%s|%3d      Mauer |\n"
      "+%'-'76s+\n"
      ,
      "",
      CAP(pl1[ARCO_NAME]),
      zuganzahl,
      zug2(wer,pl1[ARCO_PLAYER],pl2[ARCO_PLAYER]),
      CAP(pl2[ARCO_NAME]),
      zielt,zielr,
      pl1[ARCO_STEINBRUCH],
      pl1[ARCO_STEINE],
      balken2(pl1[ARCO_STEINE],zielr,1),
      balken2(pl2[ARCO_STEINE],zielr,0),
      pl2[ARCO_STEINE],
      pl2[ARCO_STEINBRUCH],
      pl1[ARCO_MAGIE],
      pl1[ARCO_JUWELEN],
      balken2(pl1[ARCO_JUWELEN],zielr,1),
      balken2(pl2[ARCO_JUWELEN],zielr,0),
      pl2[ARCO_JUWELEN],
      pl2[ARCO_MAGIE],
      pl1[ARCO_ZOO],
      pl1[ARCO_MONSTER],
      balken2(pl1[ARCO_MONSTER],zielr,1),
      balken2(pl2[ARCO_MONSTER],zielr,0),
      pl2[ARCO_MONSTER],
      pl2[ARCO_ZOO],
      pl1[ARCO_TURM],
      balken2(pl1[ARCO_TURM],zielt,1),
      balken2(pl2[ARCO_TURM],zielt,0),
      pl2[ARCO_TURM],
      pl1[ARCO_MAUER],
      balken2(pl1[ARCO_MAUER],zielt,1),
      balken2(pl2[ARCO_MAUER],zielt,0),
      pl2[ARCO_MAUER],
      ""
      );
  return ausgabe;
}

public void zeige3(mixed pl1,mixed pl2,int wer,int zielt,int zielr,int zuganzahl,object wem)
{
  string ausgabe;
  if (!IS_WIZARD(wem)) return 0;
  if ((getuid(wem)!="archon") && !(pl1[ARCO_PLAYER]->QueryProp(P_NPC))) return 0; //wenn kein npc dann nix 
  ausgabe =
    sprintf("\n+%'-'76s+\n"
      "| %-20s       Zug (%3d) bei %-12s %20s |\n"
      "|                   Turm=%5d Rohstoff=%5d Turm Gegner=0                  |\n"
      "| Steine  %-+3d %-3d|%s++%s|%3d %+3d  Steine |\n"
      "| Juwelen %-+3d %-3d|%s++%s|%3d %+3d Juwelen |\n"
      "| Monster %-+3d %-3d|%s++%s|%3d %+3d Monster |\n"
      "| Turm        %-3d|%s++%s|%3d        Turm |\n"
      "| Mauer       %-3d|%s++%s|%3d       Mauer |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%'-'76s+\n"
      ,
      "",
      output_farbe(wem,INFO_COL3,CAP(pl1[ARCO_NAME])),
      zuganzahl,
      zug2(wer,pl1[ARCO_PLAYER],pl2[ARCO_PLAYER]),
      output_farbe(wem,INFO_COL1,CAP(pl2[ARCO_NAME])),
      zielt,zielr,
      pl1[ARCO_STEINBRUCH],
      pl1[ARCO_STEINE],
      balken(pl1[ARCO_STEINE],zielr,1,wem),
      balken(pl2[ARCO_STEINE],zielr,0,wem),
      pl2[ARCO_STEINE],
      pl2[ARCO_STEINBRUCH],
      pl1[ARCO_MAGIE],
      pl1[ARCO_JUWELEN],
      balken(pl1[ARCO_JUWELEN],zielr,1,wem),
      balken(pl2[ARCO_JUWELEN],zielr,0,wem),
      pl2[ARCO_JUWELEN],
      pl2[ARCO_MAGIE],
      pl1[ARCO_ZOO],
      pl1[ARCO_MONSTER],
      balken(pl1[ARCO_MONSTER],zielr,1,wem),
      balken(pl2[ARCO_MONSTER],zielr,0,wem),
      pl2[ARCO_MONSTER],
      pl2[ARCO_ZOO],
      pl1[ARCO_TURM],
      balken(pl1[ARCO_TURM],zielt,1,wem),
      balken(pl2[ARCO_TURM],zielt,0,wem),
      pl2[ARCO_TURM],
      pl1[ARCO_MAUER],
      balken(pl1[ARCO_MAUER],zielt,1,wem),
      balken(pl2[ARCO_MAUER],zielt,0,wem),
      pl2[ARCO_MAUER],
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE1])[0],
      ARCO_KARTEN->liefere_beschreibung(0, pl1, wem, 1, 74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE2])[0],
      ARCO_KARTEN->liefere_beschreibung(1, pl1, wem, 1, 74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE3])[0],
      ARCO_KARTEN->liefere_beschreibung(2, pl1, wem, 1, 74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE4])[0],
      ARCO_KARTEN->liefere_beschreibung(3, pl1, wem, 1, 74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE5])[0],
      ARCO_KARTEN->liefere_beschreibung(4, pl1, wem, 1, 74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE6])[0],
      ARCO_KARTEN->liefere_beschreibung(5, pl1, wem, 1, 74),
      ""
      );
  tell_object(wem,ausgabe);
}

public void zeige2(mixed pl1,mixed pl2,int wer,int zielt,int zielr,int zuganzahl,object wem)
{
  string ausgabe;
  ausgabe =
    sprintf("\n+%'-'76s+\n"
      "| %s       Zug (%3d) bei %-12s %s |\n"
      "|                   Turm=%5d Rohstoff=%5d Turm Gegner=0                  |\n"
      "| Steine  %-+3d %-3d|%s++%s|%3d %+3d  Steine |\n"
      "| Juwelen %-+3d %-3d|%s++%s|%3d %+3d Juwelen |\n"
      "| Monster %-+3d %-3d|%s++%s|%3d %+3d Monster |\n"
      "| Turm        %-3d|%s++%s|%3d        Turm |\n"
      "| Mauer       %-3d|%s++%s|%3d       Mauer |\n"
      "+%'-'76s+\n"
      ,
      "",
      output_farbe(wem,INFO_COL3, sprintf("%-20s", CAP(pl1[ARCO_NAME]))),
      zuganzahl,
      zug2(wer, pl1[ARCO_PLAYER], pl2[ARCO_PLAYER]),
      output_farbe(wem,INFO_COL1, sprintf("%20s", CAP(pl2[ARCO_NAME]))),
      zielt, zielr,
      pl1[ARCO_STEINBRUCH],
      pl1[ARCO_STEINE],
      balken(pl1[ARCO_STEINE],zielr,1,wem),
      balken(pl2[ARCO_STEINE],zielr,0,wem),
      pl2[ARCO_STEINE],
      pl2[ARCO_STEINBRUCH],
      pl1[ARCO_MAGIE],
      pl1[ARCO_JUWELEN],
      balken(pl1[ARCO_JUWELEN],zielr,1,wem),
      balken(pl2[ARCO_JUWELEN],zielr,0,wem),
      pl2[ARCO_JUWELEN],
      pl2[ARCO_MAGIE],
      pl1[ARCO_ZOO],
      pl1[ARCO_MONSTER],
      balken(pl1[ARCO_MONSTER],zielr,1,wem),
      balken(pl2[ARCO_MONSTER],zielr,0,wem),
      pl2[ARCO_MONSTER],
      pl2[ARCO_ZOO],
      pl1[ARCO_TURM],
      balken(pl1[ARCO_TURM],zielt,1,wem),
      balken(pl2[ARCO_TURM],zielt,0,wem),
      pl2[ARCO_TURM],
      pl1[ARCO_MAUER],
      balken(pl1[ARCO_MAUER],zielt,1,wem),
      balken(pl2[ARCO_MAUER],zielt,0,wem),
      pl2[ARCO_MAUER],
      ""
      );
  tell_object(wem,ausgabe);
}

public void zeige(mixed pl1,mixed pl2,int wer,int zielt,int zielr,int zuganzahl)
{
  string ausgabe;
  ausgabe =
    sprintf("\n+%'-'76s+\n"
      "| %s       Zug (%3d) bei %-12s %s |\n"
      "|                   Turm=%5d Rohstoff=%5d Turm Gegner=0                  |\n"
      "| Steine  %-+3d %-3d|%s++%s|%3d %+3d  Steine |\n"
      "| Juwelen %-+3d %-3d|%s++%s|%3d %+3d Juwelen |\n"
      "| Monster %-+3d %-3d|%s++%s|%3d %+3d Monster |\n"
      "| Turm        %-3d|%s++%s|%3d        Turm |\n"
      "| Mauer       %-3d|%s++%s|%3d       Mauer |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%|'-'76s+\n"
      "| %-74s |\n"
      "+%'-'76s+\n"     
      ,
      "",
      output_farbe(pl1[ARCO_PLAYER],INFO_COL3, sprintf("%-20s", CAP(pl1[ARCO_NAME]))),
      zuganzahl,
      zug(wer),
      output_farbe(pl1[ARCO_PLAYER],INFO_COL1, sprintf("%20s", CAP(pl2[ARCO_NAME]))),
      zielt,zielr,
      pl1[ARCO_STEINBRUCH],
      pl1[ARCO_STEINE],
      balken(pl1[ARCO_STEINE],zielr,1,pl1[ARCO_PLAYER]),
      balken(pl2[ARCO_STEINE],zielr,0,pl1[ARCO_PLAYER]),
      pl2[ARCO_STEINE],
      pl2[ARCO_STEINBRUCH],
      pl1[ARCO_MAGIE],
      pl1[ARCO_JUWELEN],
      balken(pl1[ARCO_JUWELEN],zielr,1,pl1[ARCO_PLAYER]),
      balken(pl2[ARCO_JUWELEN],zielr,0,pl1[ARCO_PLAYER]),
      pl2[ARCO_JUWELEN],
      pl2[ARCO_MAGIE],
      pl1[ARCO_ZOO],
      pl1[ARCO_MONSTER],
      balken(pl1[ARCO_MONSTER],zielr,1,pl1[ARCO_PLAYER]),
      balken(pl2[ARCO_MONSTER],zielr,0,pl1[ARCO_PLAYER]),
      pl2[ARCO_MONSTER],
      pl2[ARCO_ZOO],
      pl1[ARCO_TURM],
      balken(pl1[ARCO_TURM],zielt,1,pl1[ARCO_PLAYER]),
      balken(pl2[ARCO_TURM],zielt,0,pl1[ARCO_PLAYER]),
      pl2[ARCO_TURM],
      pl1[ARCO_MAUER],
      balken(pl1[ARCO_MAUER],zielt,1,pl1[ARCO_PLAYER]),
      balken(pl2[ARCO_MAUER],zielt,0,pl1[ARCO_PLAYER]),
      pl2[ARCO_MAUER],
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE1])[0] + " ",
      ARCO_KARTEN->liefere_beschreibung(0,pl1,pl1[ARCO_PLAYER],1,74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE2])[0] + " ",
      ARCO_KARTEN->liefere_beschreibung(1,pl1,pl1[ARCO_PLAYER],1,74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE3])[0] + " ",
      ARCO_KARTEN->liefere_beschreibung(2,pl1,pl1[ARCO_PLAYER],1,74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE4])[0] + " ",
      ARCO_KARTEN->liefere_beschreibung(3,pl1,pl1[ARCO_PLAYER],1,74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE5])[0] + " ",
      ARCO_KARTEN->liefere_beschreibung(4,pl1,pl1[ARCO_PLAYER],1,74),
      " " + ARCO_KARTEN->liefere_karte(pl1[ARCO_KARTE6])[0] + " ",
      ARCO_KARTEN->liefere_beschreibung(5,pl1,pl1[ARCO_PLAYER],1,74),
      ""
      );
  tell_object(pl1[ARCO_PLAYER],ausgabe);
}

