#include "../spiel.h"
#include <properties.h>
#include <defines.h>

#define SAVETOP  SPIEL "arco_topliste_frei" 

void eintragen(int was,string name1,string name2);
string liste(int welche);
string einzeln(string wer);

mapping spiele;

void create()
{
  if (is_clone(ME)) call_out("remove",1);
  spiele=([]);
  seteuid(getuid());
  if (file_size(SAVETOP+".o")>-1)
  {    
     restore_object(SAVETOP); 
  }
}

void eintragen(int was,string name1,string name2) //0 remis, 1 gewonne 1, 2 gewonnen 2, 3 gewonnen 1 durch aufgabe, 4 gewonnen 2 durch aufgabe
{
  if (!spiele[name1])
  {
    spiele+=([name1: 1; 0; 0; 0; 0; 0 ]);
  }
  if (!spiele[name2])
  {
    spiele+=([name2: 1; 0; 0; 0; 0; 0 ]);
  }
  switch(was)
  {
    case 0: spiele[name1,3]++; spiele[name2,3]++; break;
    case 1: spiele[name1,1]++; spiele[name2,2]++; break;
    case 2: spiele[name1,2]++; spiele[name2,1]++; break;
    case 3: spiele[name1,4]++; spiele[name2,5]++; break;
    case 4: spiele[name1,5]++; spiele[name2,4]++; break;
  }
  save_object(SAVETOP);
}

string einzeln(string wer)
{
  int i;
  string ret;
  string *spiel;
  int anz;
  if (!wer || !spiele[wer])
  {
    return "| Noch kein freies Spiel gespielt                                           |\n";
  }
  anz=spiele[wer,1]+spiele[wer,2]+spiele[wer,3]+spiele[wer,4]+spiele[wer,5];
  ret=sprintf("| %-30s %5d | %5d | %5d | %4d | %4d | %4d |\n",
       "Freies Spiel",anz,
       spiele[wer,1],spiele[wer,2],spiele[wer,3],
       spiele[wer,4],spiele[wer,5]);
  return ret;
}