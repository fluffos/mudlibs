#include <properties.h>
#include <moving.h>
#include "../files.h"

#define BAR_ROOM "/d/ebene/yara/cocktailbar/room/bar"


inherit "/std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Midas Spielewelt, Maexchen-Raum");
  SetProp (P_INT_LONG,
    "Du stehst in einem mittelgrossen Raum in der Spielwelt von Midas. "
    "Auch hier ist alles eher schlicht, aber durchaus elegant gehalten, "
    "Fenster kannst Du hier allerdings keine entdecken, stattdessen erhellt "
    "eine Lampe, die an der Decke haengt, den Raum mit flackerndem Licht.\n"
    "Als Du Deinen Blick weitergleiten laesst, faellt Dir sofort ein "
    "schoener, alter Holztisch mit etlichen, um ihn plazierten Stuehlen "
    "auf. Welcher Spielleidenschaft wohl hier nachgegangen wird?");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"blick","leere"}),
    "Du starrst ins Leere.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind mit eleganten Holzvertaefelungen verkleidet.");
  AddDetail ( ({"fenster"}),
    "Da sich dieser Raum unterhalb ebener Erde befindet, waeren Fenster "
    "irgendwie rausgeschmissenes Geld. Daher gibt es hier auch keine.");
  AddDetail ( ({"erde"}),
    "Erde ist hier *nicht* im woertlichen Sinn gemeint.");
  AddDetail ( ({"sinn"}),
    "Alles hat einen Sinn. Fast alles. Dein sinnloses Untersuchen eher "
    "weniger. :)");
  AddDetail ( ({"untersuchen"}),
    "Ok. Du hast gewonnen. Hier bitte, ein Forscherpunkt.");
  AddDetail ( ({"forscherpunkt"}),
    "Hoppla, der war ja gar nicht genehmigt! "
    "Schwupps, schon ist er wieder weg.");
  AddDetail ( ({"geld"}),
    ([ "zwerg" : "Verliebt betrachtest Du Dein Geld.\n",
             0 : "Geld braucht man wohl zum (Ueber-) Leben...\n" ]) );
  AddDetail ( ({"leben","ueberleben"}),
    "Naja, brauchen ist uebertrieben. Aber es hilft.");
  AddDetail ( ({"holzvertaefelungen", "vertaefelungen"}),
    "Die Holzvertaefelungen weisen kein besonderes Muster auf.");
  AddDetail ( ({"muster"}),
    "Nein, wirklich keins.");
  AddDetail ( ({"decke"}),
    "Hell und freundlich. Und eine Lampe haengt dort.");
  AddDetail ( ({"lampe"}),
    "Eine ganz gewoehnliche Lampe, deren Licht hell flackernd den Raum "+
    "erleuchtet.");
  AddDetail ( ({"licht"}),
    "Es flackert hell und erleuchtet den gesamten Raum.");
  AddDetail ( ({"raum", "maexchen-raum"}),
    "Versuch's mal mit 'schau' !");
  AddDetail ( ({"dielen", "holzdielen"}),
    "Die Holzdielen unter Deinen Fuessen knarren kein bisschen, sie sind "+
    "offenbar sehr sauber und sorgfaeltig verlegt worden.");
  AddDetail ( ({"fuesse"}),
    "Deine Fuesse koenntest Du eigentlich auch mal wieder waschen!");
  AddDetail ( ({"boden"}),
    "Der Boden wurde sauber mit dunkelbraunen Holzdielen verlegt.");
  AddDetail ( ({"mitte", "tisch", "holztisch"}),
    "In der Mitte des Raumes steht ein schoener, alter Holztisch.");
  AddDetail ( ({"spieler"}),
    "bist Du vielleicht einer?");
  AddDetail ( ({"spielwelt"}),
    "Die Spielwelt ist der Treffpunkt aller Spielsuechtigen des "+
    "Silberlandes.");
  AddDetail ( ({"treffpunkt"}),
    "Hier kannst Du andere Spielsuechtige treffen.");
  AddDetail ( ({"spielsuechtige", "spielsuechtiger"}),
    "Bist Du vielleicht eine(r) von ihnen?");
  AddDetail ( ({"midas"}),
    "In dieser Stadt befindest Du Dich gerade.");
  AddDetail ( ({"stadt"}),
    "Diese hier heisst Midas.");
  AddDetail ( ({"silberland"}),
    "In dem befindest Du Dich gerade.");
  AddDetail ( ({"treppe", "wendeltreppe"}),
    "Die Wendeltreppe ist aus sauber verarbeitetem, glatt geschliffenen "+
    "Holz und fuehrt weiter nach oben aus der Spielwelt von Midas raus.");
  AddDetail ( ({"holz"}),
    "Nur das feinste Holz wurde hier verwendet und sauber verarbeitet.");
  AddDetail ( ({"stuehle", "stuhl"}),
    "Die Stuehle scheinen einigermassen bequem zu sein, wenn man schon "+
    "nicht auf ihnen schlafen kann, so reichts zum Spielen wohl allemal.");
  AddDetail ( ({"spiel", "spielen", "spielleidenschaft", "leidenschaft"}),
    "Was hier gespielt wird, solltest Du schon selber rausfinden.");
  // DETAILS END

  // EXITS START
  AddExit ("oben", "./4gwraum");
  AddExit ("osten", "./rage/rage");
  AddExit ("westen", BAR_ROOM);
  // EXITS END

  // ITEMS START
  AddItem ( ROOM "spiele/maexchen", REFRESH_DESTRUCT, 1 );
  // ITEMS END
}


// prevent room from discarding the table :)
void clean_double() {}

// prevent room from being discarded from memory
int clean_up(int refcount) { return 1; }

