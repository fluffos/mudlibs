private string output_farbe(object pl,string farbe,string text)
{
  return text;
}

void create()
{
  if (is_clone(ME)) call_out("remove",1);
  seteuid(getuid(ME));
  karten=({});
  if (file_size(SAVE_DAT+".o")>-1)
  {
    restore_object(SAVE_DAT);
  }
}

public void save()
{
  save_object(SAVE_DAT);
}

public string lesen()
{
  string *data;
  string zeile;
  int znum;
  karten=({});
  tell_object(find_living("archon"),LOAD_DAT);
  if (!read_file(LOAD_DAT,++znum,1)) return "nichts gelesen - Error 1";
  if (!read_file(LOAD_DAT,++znum,1)) return "nichts gelesen - Error 2";
  while(zeile=read_file(LOAD_DAT,++znum,1))
  {
    data=efun::explode(zeile,"|");
    if (sizeof(data)<12) continue;
    karten+=({ ({data[0],to_int(data[1]),to_int(data[2]),
                to_int(data[3]),to_int(data[4]),to_int(data[5]),
                to_int(data[6]),to_int(data[7]),to_int(data[8]),
                to_int(data[9]),to_int(data[10]),to_int(data[11]) }) });
  }
  save();
  return "gelesen";
}

public void AddKarte(string name,int farbe,int kosten,int bedingung,
                     int a1,int aa1,int a2,int aa2,int a3,int aa3,int a4,int aa4)
{
  if (!stringp(name)) return;
  karten+=({ ({name,farbe,kosten,bedingung,a1,aa1,a2,aa2,a3,aa3,a4,aa4}) });
  save();
}

public int liefere_anzahl()
{
  return sizeof(karten);
}

public mixed liefere_karte(int welche)
{
  if (welche<0) return -1;
  if (welche>sizeof(karten)) return -1;
  return karten[welche];  
}

//beschreibung fuer einen selbst - und fuer info-anzeige
public string liefere_beschreibung(int wk,mixed pl1,object pl_sieht,int front,int breite)
{
  string beschreibung;
  int l;
  int welche;
  string help;
  welche=pl1[ARCO_KARTE1+wk];
  if (welche<0 || welche>sizeof(karten)) 
  {
    beschreibung=to_string(wk+1)+": unbekannt";
    l=strlen(beschreibung);
    for (;l<breite;l++)
    {
      beschreibung+=" ";
    }
    return beschreibung;
  }
  l=0;
  beschreibung="";
  if (front)  //front zahl: mit zeigen?
  {
    if (kann_ausspielen(wk,pl1))
    {
      beschreibung=output_farbe(pl_sieht,INFO_COL4,to_string(wk+1))+": ";
    }
    else
    {
      beschreibung=to_string(wk+1)+": ";
    }
    l=3;
  }
  help=to_string(-karten[welche][2])+" "+liefere_farbe(karten[welche][1]);
  l+=strlen(help);
  beschreibung+=output_farbe(pl_sieht,INFO_COL2,help);
  if (karten[welche][3])
  {
    help = liefere_bedingung(karten[welche][3]);
    l += 2 + strlen(help);
    beschreibung+="; "+help;
    if (karten[welche][3]==BEDINGUNG_ABLEGEN1) 
    {
      beschreibung+=";";
      l++;
    }
  }
  else
  {
    beschreibung+=";";
    l++;
  }
  if (karten[welche][5]) //eine aktion definiert
  {
    help=" "+liefere_zahl(karten[welche][4],karten[welche][5])+liefere_aktion(karten[welche][5]);
    l+=strlen(help);
    beschreibung+=help;
  }
  if (karten[welche][3] && karten[welche][7]) //gibt es auch ein else? bei steinbruch=steinbruch gegner zBsp nicht
  {
    beschreibung+=" sonst";
    l+=6;
  }
  else
  if (karten[welche][7]) //kommt denn noch was?
  {
    beschreibung+=";";
    l+=1;
  }
  if (karten[welche][7]) //eine aktion definiert
  {
    help=" "+liefere_zahl(karten[welche][6],karten[welche][7])+liefere_aktion(karten[welche][7]);
    l+=strlen(help);
    beschreibung+=help;
  }
  if (karten[welche][3] && (karten[welche][9] || karten[welche][11]))
  {
    beschreibung+=" immer";
    l+=6;
  }
  if (karten[welche][9]) //eine aktion definiert
  {
    help="; "+liefere_zahl(karten[welche][8],karten[welche][9])+liefere_aktion(karten[welche][9]);
    l+=strlen(help);
    beschreibung+=help;
  }  
  if (karten[welche][11]) //eine aktion definiert
  {
    help="; "+liefere_zahl(karten[welche][10],karten[welche][11])+liefere_aktion(karten[welche][11]);
    l+=strlen(help);
    beschreibung+=help;
  }

/*
  beschreibung+=" ";
  l++;
  if (l+strlen(karten[welche][0])<breite+1)
  {
    l+=strlen(karten[welche][0]);
    for (;l<breite;l++)
    {
      beschreibung+=" ";
    }
    beschreibung+=output_farbe(pl_sieht,INFO_COL5,karten[welche][0]);
  }
  else
  {
    for (;l<breite;l++)
    {
      beschreibung+=" ";
    }
  }
*/

  for (; l < breite; ++l)
    beschreibung += " ";

  return beschreibung;
}

