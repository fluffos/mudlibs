/* Paracelsus: Rage-Spielraum (oben) */
/* Woody: Dankend erhaltend von Paracelsus, fuers SL ueberarbeitet */

#include "files.h"
#include "rage.h"
#include <ansi.h>
#include <properties.h>
#include <moving.h>
#include <language.h>
#include <exploration.h>
#include <defines.h>
#include <moredef.h>
#include "/p/daemon/channel.h"

#pragma strict_types

inherit BASE("rage/engine");


void create()
{
    ::create();

    SetProp(P_INT_SHORT,"Midas Spielewelt, Rage-Raum");
    SetProp(P_INT_LONG,
        "Dieser kleine, halbdunkle Raum enthaelt eigentlich nicht "
        "viel mehr als einen runden Tisch und zehn Stuehle. Im Licht "
        "der vier Kerzen (es haengt je eine in jeder Ecke des Raumes) "
        "siehst Du, dass auf dem Tisch Karten liegen. Durch eine "
        "der beiden Tueren kannst Du den Raum wieder verlassen. "
        "kannst Du den Raum wieder verlassen. An einer der Waende "
        "haengt ein Schild.");
    SetProp(P_NAME,"Kaffeezimmer");
    SetProp(P_GENDER,NEUTER);
    SetProp(P_ARTICLE,1);

    AddExit( "westen", ([
          EX_DEST     : RG_EXIT_PATH,
          EX_TESTFUNC : #'TestPlayerExit
        ]) );

    AddExit( "norden", ([
          EX_DEST     : "./rage2",
          EX_TESTFUNC : #'TestPlayerExit
        ]) );

    catch(CHMASTER->new( "Rage", TO, "Heute schon in Rage geraten?"));
    catch(CHMASTER->join( "Rage", TO ));

    AddDetail( "kaffeezimmer",
        "Du stehst darin.\n");
    AddDetail( "kaffee",
        "Den siehst Du hier leider nicht.\n");
    AddDetail( "raum",
        "Du stehst in einem halbdunklen Raum.\n");
    AddDetail( "boden",BS(
        "Du stehst darauf. Das gilt uebrigens auch fuer den Tisch "
        "und die zehn Stuehle."));
    AddDetail( "tisch",BS(
        "Du siehst einen grosse, runden Tisch aus Holz. Um den Tisch "
        "herum stehen zehn Stuehle und auf dem Tisch entdeckst Du "
        "viele blaue Karten."));
    AddDetail( "holz",BS(
        "Das Holz ist dunkelbraun und glaenzt leicht. Die Oberflaeche "
        "des Tisches fuehlt sich glatt an, wahrscheinlich sollen die "
        "Karten beim Geben besser rutschen."));
    AddDetail( ({"oberflaeche","tischoberflaeche"}),
        "Die Oberflaeche des Tisches ist glatt.\n");
    AddDetail( "geben",
        "Karten kann man geben.\n");
    AddDetail( ({"karte","karten"}),BS(
        "Auf dem Tisch liegen Karten. Allen ist gemeinsam, dass sie eine "+
        "blaue Rueckseite haben."));
    AddDetail( ({"rueckseite","rueckseiten"}),
        "Die Karten haben eine blaue Rueckseite. Ein Wort steht darauf.\n");
    AddDetail( "wort",
        "Das kannst Du bestimmt lesen.\n");
    AddDetail( "rage",
        "So heisst das Spiel, das man hier spielen kann.\n");
    AddDetail( "spiel",
        "Hier kann man 'Rage' spielen.\n");
    AddDetail( "decke",
        "Die Decke befindet sich ueber Dir.\n");
    AddDetail( ({"wand","waende"}),BS(
        "Du zaehlst vier Waende. In zwei Waenden ist eine Tuer und an "
        "einer der beiden anderen Waende (genauer gesagt an der Ostwand) "
        "haengt ein Schild."));
    AddDetail( "ostwand",BS(
        "Bis auf ein an ihr aufgehaengtes Schild handelt es sich hier "
        "um eine aeusserst schlichte Wand. Du bist begeistert."));
    AddDetail( "schild",
        "Das kannst Du bestimmt lesen.\n");
    AddDetail( ({"ecke","ecken"}),
        "Dieser Raum hat vier Ecken. In jeder Ecke brennt eine Kerze.\n");
    AddDetail( ({"kerze","kerzen"}),
        "Der Raum wird von vier Kerzen erhellt.\n");
    AddDetail( "licht",
        "Das Licht kommt von den Kerzen.\n");
    AddDetail( "luft",
        "Die Luft ist leicht stickig.\n");
    AddSpecialDetail( ({"stuhl","stuehle"}),
        "D_stuehle");
    AddDetail( ({"tuer","tueren"}),
        "Durch diese Tueren gehts hinaus.\n");
    AddDetail( "rcsl",
        "Was das wohl bedeutet?\n");

    AddReadDetail( ({"rueckseite","rueckseiten","wort"}),
        "Du liest: <R><A><G><E>\n");
    AddReadDetail( "schild",
        "Du liest:\n\n"
        " ,-------------------------------------------------------------.\n"
        " |           Willkommen im Kaffeezimmer des RCSL !             |\n"
        " |                                                             |\n"
        " |                Hier kann man Rage spielen.                  |\n"
        " |                      (Standard-Rage)                        |\n"
        " |                                                             |\n"
        " |                      -> 'ragehilfe'                         |\n"
        " |                                                             |\n"
        " | Warnung: Dieses Spiel befindet sich noch im Teststadium!    |\n"
        " | Dank gebuehrt vor allem dem Autor, Paracelsus@Morgengrauen. |\n"
        " `-------------------------------------------------------------'\n"
        );

    AddSmell( DEFAULT_SMELL,
        "Es riecht ein wenig stickig hier.");
}

// prevent room from discarding
void clean_double() {}

// prevent room from being discarded from memory
int clean_up(int refcount) { return 1; }

string _set_name(string str)
{
  string ob;
  string *obs;
  int i;

  obs = ({});
  for (i=caller_stack_depth(); i--;) {
    ob = to_string(previous_object(i));
    if (!sizeof(obs) || (ob != obs[<1]))
      obs += ({ ob });
  }
  ob = implode( obs, " -> " );

  if (str && str!="Kaffeezimmer")
    log_file("wiz/woody/rage_name",
        sprintf("[%s] [TI=%O using %O] NAME -> %O\n  %s\n",
          dtime(), this_interactive(),
          query_verb()+(TP ? " "+TP->_unparsed_args() : ""), str, ob));

  return Set(P_NAME, str);
}

varargs mixed Set(string name, mixed str, int Type)
{
  string ob;
  string *obs;
  int i;

  if ( (name != P_NAME) || (Type) )
    return ::Set(name,str,Type);

  obs = ({});
  for (i=caller_stack_depth(); i--;) {
    ob = to_string(previous_object(i));
    if (!sizeof(obs) || (ob != obs[<1]))
      obs += ({ ob });
  }
  ob = implode( obs, " -> " );

  if (str && str!="Kaffeezimmer")
    log_file("wiz/woody/rage_name",
        sprintf("[%s] [TI=%O using %O] NAME -> %O\n  %s\n",
          dtime(), this_interactive(),
          query_verb()+(TP ? " "+TP->_unparsed_args() : ""), str, ob));

  return ::Set(P_NAME, str);
}
