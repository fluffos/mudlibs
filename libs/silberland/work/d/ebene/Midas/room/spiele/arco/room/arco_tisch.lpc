#include "../def.h"
inherit "std/room";

int cmd_ruhe(string str);
int cmd_aufstehen(string str);
int cmd_aufstehen2(string str);
string sessel();
object arco;

void create()
{
  ::create();

  SetProp(P_LIGHT, 2);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Ein Spieltisch");
  
  SetProp(P_INT_LONG,
    "Du bist in einem kleinen gemuetlichen Zimmer. Du hast es Dir in einem "
    "Sessel an einem der Tische im Raum gemuetlich gemacht. Vor Dir auf der "
    "Tischplatte ist ein Arco-Spiel aufgebaut.");
  AddDetail(({"raum"}), QueryProp(P_INT_LONG));
  AddDetail(({"zimmer"}),
    "Das Zimmer ist gemuetlich. Neben einem Kamin stehen mehrere Tische mit einigen Sesseln. "
    "Auf den den Tischen steht jeweils ein Arco-Spiel.");
  AddDetail(({"tische","tisch","eichentisch","tischplatte","tischplatten","eichentische"}),
    "Robuste glatt polierte Eichentische stehen gleich neben dem Kamin. "
    "Auf ihnen ist je ein Arco-Spiel aufgebaut.");
  AddDetail(({"arco-spiel","arcospiel"}),
    "Ein Arco-Spiel liegt auf dem Tisch. Wenn Du mehr darueber erfahren "
    "willst, tippe spielhilfe.");
  AddDetail(({"kamin","feuerstelle","waerme"}),
    "Ein warmes, den Raum erhellendes Feuerchen brennt in dem Kamin. "
    "Ab und zu knistert es, wenn ein neuer Zweig verbrennt.");
  AddDetail(({"feuer","feuerchen","holzfeuer","kaminfeuer"}),
    "Das Feuer strahlt wohlige Waerme aus.");
  AddDetail(({"zweig","zweige","holz"}),
    "Im Kamin brennt ein schoenes Holzfeuer, welches von einer unsichtbaren "
    "Hand immer wieder genaehrt wird.");
  AddDetail(({"nahrung"}),
    "Irgend jemand legt staendig Holz nach, so dass das Feuer bestaendig "
    "weiter brennt.");
  AddDetail(({"boden","schritt","fell","grizzlyfell"}),
    "Ein kuschliges Fell liegt auf dem Boden und daempft jeden Schritt. "
    "Leider ist es im Laufe der Zeit schon stark abgenutzt worden, "
    "doch erkennst Du noch immer, dass es ein Grizzlyfell sein muss.");
  AddDetail(({"sessel"}), #'sessel);
  AddDetail(({"ruhe","gemuetlichkeit"}),
    "Ist es hier nicht einfach erholsam? Ruh Dich aus und spiele eine Runde "
    "Arco.");
  AddDetail(({"runde","arco","spiel"}),
    "Wie waere es mit einer Runde Arco?");
  AddDetail(({"wand","waende","waenden","holzwand"}),
    "Ein Wandteppich schmueckt die ansonsten einfache Holzwand. Durch ein "
    "kleines rundes Fenster dringt etwas Tageslicht. In ein paar Nischen "
    "stehen Kerzen.",
    "Ein Wandteppich schmueckt die ansonsten einfache Holzwand. In ein paar "
    "Nischen brennen Kerzen und lassen durch ihren flackernden Schein die "
    "Schatten lebendig wirken.");
  AddDetail(({"schatten","panik"}),
    "Nur keine Panik, das sind ja nur Schatten.");
  AddDetail(({"nische","kerze","kerzen","platz","nischen"}),
    "Kleine Nischen in den Waenden bieten gerade genug Platz fuer jeweils "
    "eine Kerze.");
  AddDetail(({"tageslicht","schein","licht"}),
    "Etwas Tageslicht und der Schein des Kaminfeuers erhellen den Raum.",
    "Ein paar Kerzen und der Schein des Kaminfeuers erhellen den Raum.");
  AddDetail(({"fenster","glas"}),
    "Ein kleines rundes Fenster mit milchigem Glas ist in einer der Waenden "
    "eingelassen.");
  AddDetail(({"wandteppich","teppich","motiv","motive","motiven"}),
    "Der Teppich ist voll von Motiven der phantastischsten Tiere, die Du Dir "
    "vorstellen kannst.");
  AddDetail(({"tier","tiere"}),
    "Du siehst Drachen, bizarre Voegel, fauchende Katzen und viele andere schoene, wie "
    "auch furchteinfloessende Kreaturen.");
  AddDetail(({"kreatur","kreaturen"}),
    "Viele Kreaturen sind auf dem Wandteppich abgebildet.");
  AddDetail(({"drache","drachen","realitaet","abbildung"}),
    "Ein besonders grosser und schoener Drache ist genau in der "
    "Mitte des Wandteppichs dargestellt. Aber so schoen dieser anzusehen ist, "
    "der Realitaet kommt die Abbildung nicht nahe.");
  AddDetail(({"mitte"}),
    "Dort siehst Du einen Drachen.");
  AddDetail(({"vogel","voegel","katze","katzen","andere"}),
    "All die vielen verschiedenen Tiere siehst Du auf dem Teppich.");
  AddDetail(({"zeit"}),
    "Die Zeit vergeht.");
  AddDetail(({"decke","holzdecke"}),
    "Du erkennst eine einfache Holzdecke.");

  AddSoundDetail(DEFAULT_SOUND,
    "Das Feuer knistert leise.");
  AddSoundDetail(({"feuer", "feuerchen", "knistern", "kamin"}),
    "Das Feuer knistert leise.");

  AddSmellDetail(DEFAULT_SMELL,
    "Es riecht ein wenig nach Rauch aus dem Kamin.");
  AddSmellDetail(({"feuer", "feuerchen", "rauch", "kamin"}),
    "Es riecht angenehm und beruhigend.");

  AddCmd(({"ruhe","ausruhen","erhole","erholen","ruhen"}),"cmd_ruhe");
  AddCmd(({"aufstehen"}),"cmd_aufstehen");
  AddCmd(({"steh","stehe"}),"cmd_aufstehen2");

  reset();
}

int cmd_ruhe(string str)
{
  write("Bei einer Runde Arco erholst Du Dich bestimmt.\n");
  return 1;
}

string sitzen()
{
  object sp1,sp2;
  string vor,nach,wer;
  if (!arco) return "";
  sp1=arco->LiefereSpieler(1);
  sp2=arco->LiefereSpieler(2);
  if (!sp1 && !sp2) return "";
  vor="Gerade hat es sich "; 
  nach=" in einem der Sessel gemuetlich gemacht. ";
  if (sp1 && !sp2) 
  {
    if (sp1->QueryProp(P_NPC)) wer=sp1->Name(WER,NAME_AUTO);
    else wer=CAP(getuid(sp1)); 
  }
  if (sp2 && !sp1) 
  {  
    if (sp2->QueryProp(P_NPC)) wer=sp2->Name(WER,NAME_AUTO);
    else wer=CAP(getuid(sp2)); 
  }
  if (sp2 && sp1)
  {
    if (sp1->QueryProp(P_NPC)) wer=sp1->Name(WER,NAME_AUTO);
    else wer=CAP(getuid(sp1)); 
    wer+=" und ";
    if (sp2->QueryProp(P_NPC)) wer=sp2->Name(WER,NAME_AUTO);
    else wer+=CAP(getuid(sp2));
    vor="Gerade haben es sich "; 
    nach=" in den Sesseln gemuetlich gemacht. ";
  }
  return ("Die Sessel sind schon alt und abgesessenen, aber dafuer sehr "
	  "gemuetlich. "+vor+wer+nach);
}

string sessel()
{
  string s;
  s = sitzen();
  if (s == "") 
    return break_string("Die Sessel sind schon alt und abgesessen, aber dafuer "
	       "sehr gemuetlich.");
  return break_string(s);
}

void reset()
{
  ::reset();
  if (!objectp(arco)) 
  {
    arco=clone_object(SPIEL "arco_spiel");
    arco->move(ME, M_SILENT);
  }
}

int cmd_aufstehen(string str)
{
  PL->move(ROOM "arco_raum", M_GO,
        "",
	"steht vom Tisch auf",
	"steht von einem Tisch auf");
  return 1;
}

int cmd_aufstehen2(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "auf",
       "Willst Du aufstehen?"))
    return 0;
  return cmd_aufstehen(str);
}
