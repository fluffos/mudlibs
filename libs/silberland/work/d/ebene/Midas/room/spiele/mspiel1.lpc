inherit "std/thing";

#include <properties.h>     
#include <moving.h>
#include <language.h>  

#define ENV(x) environment(x)
#define TP     this_player()
#define TO     this_object()
#define TISCH  "/d/ebene/padreic/spiele/mspiel2.lpc"

create()
{
  ::create(); 
  SetProp(P_SHORT, "Ein Maexchenspiel");
  SetProp(P_LONG, "'Maexchen, das ultimative Wuerfelspiel fuer Jung und Alt' kommt direkt aus\n"
                 +"den Padreic'schen Spielewerken und wird mit folgenden exclusiven Komponenten\n"
                 +"ausgeliefert:\n"
                 +"- ein hochwertiger Plastikklapptisch.\n"
                 +"- ein aus echtem Kunstleder gefertigter Wuerfelbecher.\n"
                 +"- zwei marmorierte handgefertigte 6-seitige Wuerfel.\n"
                 +"und natuerlich noch ein hochwertiges umfassendes Regelwerk.\n"
                 +"                                    (Syntax: <baue Spiel auf>)\n");
  SetProp(P_INFO, "Hmm, wie waere es mit <baue Spiel auf>?");
  SetProp(P_NAME, "Maexchenspiel");
  AddId("spiel");
  AddId("maexchenspiel");
  AddCmd(({"bau", "baue"}), "aufbauen");
}

aufbauen(string was)
{
  notify_fail("Was moechtest Du aufbauen?\n");
  if (was!="spiel auf") return 0;
  if (TP->InFight()) {
    write("Wie willst Du denn waerend einem Kampf das Spiel aufbauen?\n");
    return;
  }
  if (environment(TP)->QueryProp(P_NO_TPORT)) {
    // wird schon irgendwie seinen Grund haben...
    write("Du kannst den Tisch hier leider nicht aufbauen.\n");
    return;
  }
  if (TP->QueryProp(P_GHOST)) {
    write("Als Geist bist Du leider nicht stark genug, um den Tisch aufzubauen :(\n");
    return 1;
  }
  write("Muehsam kaempfst Du Dich durch die Bauanleitung durch, bis der Tisch endlich\n"
       +"steht.\n");
  if (living(ENV(TO))) {
    clone_object(TISCH)->move(ENV(ENV(TO)), M_PUT);
    tell_room(ENV(ENV(TO)), TP->name(WER)+" baut einen Klapptisch auf.\n", ({ TP }));
  }
  else {
    clone_object(TISCH)->move(ENV(TO), M_PUT);
    tell_room(ENV(TO), TP->name(WER)+" baut einen Klapptisch auf.\n", ({ TP }));
  }
  TO->remove(1);
  return 1;
}
