inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();

  SetProp (P_INT_SHORT, "Seitengasse in Midas");
  SetProp (P_INT_LONG,
    "Du befindest Dich in einer kleinen Seitengasse inmitten der grossen "
    "Stadt Midas. Hier haben sich einige kleinere Geschaefte angesiedelt. "
    "Nach Osten hin kannst Du die Stadtmauer erkennen, waehrend Du nach "
    "Westen dem Weg weiter in die Stadt hinein folgen kannst."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));


  AddDetail ("weg", "Du befindest Dich auf ihm.\n");
  AddDetail ( ({"seitengasse","gasse"}), "Du befindest Dich in ihr.\n");
  AddDetail ("geschaefte",
    "Einige kleinere Geschaefte haben sich hier angesiedelt.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ("sonne", "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadtmauer","mauer"}),
    "Die Stadtmauer erhebt sich maechtig nach Osten hin. Sie sichert die "
    "Stadt gegen Angriffe von aussen ab und traegt ganz erheblich zum "
    "Wohlbefinden der Einwohner hier bei.");
  AddDetail ("wohlbefinden", "Ein gutes Gefuehl, findest Du nicht?\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");

  AddDetail( ({"haendler"}) ,
    "Die sind wohl in den Geschaeften zu finden."
  );

  AddDetail( ({"kunden"}) ,
    "Kunden sind immer beim entsprechenden Haendler zu finden."
  );

  AddExit("westen",  "./room_f3");
  AddExit("osten",   "./room_h3");
  AddExit("norden",  "./kaeseladen");

  AddSound( DEFAULT_SOUND,
    "Hier herrscht geschaeftiges Treiben."
  );

  AddSound( ({"treiben"}) ,
    "Haendler preisen ihre Waren an und die Kunden feilschen um den Preis."
  );

  AddSound( ({"haendler"}) ,
    "Die Haendler preisen lautstark ihre Waren an."
  );

  AddSound( ({"kunden"}) ,
    "Die Kunden feilschen erbittert um jede Muenze."
  );

  AddSmell( DEFAULT_SMELL,
    "Von Norden kommt ein wuerziger Geruch."
  );

  AddSmell( ({"geruch"}) ,
    "Riecht, als ob es da jede Kaese zu kaufen gaebe."
  );

  AddSmell( ({"kaese"}) ,
    "Hier ist kein Kaese, aber im Norden riecht es nach Kaese."
  );

  AddSmell( ({"norden"}) ,
    "Im Norden riecht es nach Kaese."
  );


  AddItem (NPC "buerger", REFRESH_DESTRUCT);
}
