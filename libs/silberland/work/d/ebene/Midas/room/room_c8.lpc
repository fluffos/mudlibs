/*
** Seitengasse in Midas  (w) Woody@SL
** ---
** 1997-09-07  Woody  Release
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:18]));
  SetProp (P_INT_LONG,
    "Du befindest Dich auf einem kleinen Seitenweg, der sich von Sueden "
    "nach Norden und in weiterer Folge nach Osten hin durch die Stadt "
    "schlaengelt, an verschiedenen Gebaeuden vorbei. Weiter im Norden "
    "kannst Du das Rathaus erkennen, suedlich vor Dir befindet sich die "
    "maechtige Stadtmauer und ein Weg daran entlang, im Osten jedoch, "
    "unmittelbar vor Dir erhebt sich die gewaltige, prachtvolle Kirche "
    "von Midas.");

  SetProp (P_INT_SHORT, "Seitenweg in Midas");

  // DETAILS START
  AddDetail ( ({"seitenweg","weg"}), "Du befindest Dich auf ihm.\n");
  AddDetail ("boden",
    "Der Boden besteht aus ausgetrampeltem Lehm.\n");
  AddDetail ("lehm", "Alter, ausgetrampelter roetlicher Lehm.\n");
  AddDetail ( ({"morgensonne", "sonne"}),
      "Die rote Morgensonne macht Dich ganz melancholisch.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "midas"}), "Du befindest Dich inmitten der "+
    "maechtigen Stadt Midas.\n");
  AddDetail ( ({"hauptstrasse", "strasse"}),
    "Die Hauptstrasse befindet sich weiter im Norden.");
  AddDetail ( ({"gebaeude"}),
    "Einerseits die Kirche im Osten, andererseits das Rathaus etwas "
    "weiter noerdlich von Dir.");
  AddDetail ( ({"kirche"}),
    "Die prachtvolle Kirche erhebt sich direkt vor Dir im Osten. Du kannst "+
    "am Kirchenschiff huebsche bunte Glasfenster erkennen.");
  AddDetail ( ({"kirchenschiff", "schiff", "innenraum"}),
    "Kirchenschiff nennt man den langgestreckten Innenraum einer Kirche, "+
    "in dem die meisten Leute Platz finden.");
  AddDetail ( ({"leute"}),
    "Ganz normale Leute halt.");
  AddDetail ( ({"platz"}),
    "Wuerdest Du nicht soviel brauchen, waere mehr davon hier!");
  AddDetail ( ({"fenster", "glasfenster"}),
    "Das Glas der Fenster schillert in den buntesten Farben.");
  AddDetail ( ({"glas"}),
    "Normales Glas, aber bunt, in allen Farben des Lichts.");
  AddDetail ( ({"farben"}),
    "Auf Anhieb erkennst Du nur rot, gruen, blau und gelb, aber irgendwie "+
    "scheinen es doch wesentlich mehr Farben zu sein.");
  AddDetail ( ({"licht"}),
    "Licht ist einfach da, weil die Sonne scheint.");
  AddDetail ( ({"rathaus"}),
    "Das Rathaus befindet sich etwas weiter noerdlich.");
  AddDetail ( ({"kirchturm", "turm"}),
    "Er befindet sich im oestlicheren Teil der Kirche.");
  AddDetail ( ({"mauer", "stadtmauer"}),
    "Die maechtige Stadtmauer weiter im Sueden beschuetzt die Stadt "+
    "wirkungsvoll vor Feinden.");
  AddDetail ( ({"feinde"}),
    "Meist Gesetzesbrecher.");
  AddDetail ( ({"gesetzesbrecher"}),
    "Pass auf, dass Du keiner von Ihnen wirst!");
  // DETAILS END

  AddExit ("norden", "./room_c7");
  AddExit ("sueden", "./room_c9");
}
