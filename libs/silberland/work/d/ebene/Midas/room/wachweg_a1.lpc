inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:17]));
  SetProp (P_INT_LONG, bs(
    "Du balancierst vorsichtig auf einem schmalen Wachweg auf der "+
    "maechtigen Stadtmauer der Stadt Midas, der rund um die gesamte Stadt "+
    "fuehrt. Hier versehen die Kampfsoldaten ihren Dienst, weil sie einen "+
    "ausgezeichneten Ueberblick ueber saemtliche Wege der Stadt haben und "+
    "Stoerenfriede sofort entdecken koennen.")+bs(
    "Eine kleine Treppe fuehrt noch hoeher auf einen kleinen Aussichtsturm "+
    "hinauf, zwei weitere Treppen nach suedunten und ostunten fuehren "+
    "hinunter zur Stadt auf einen kleinen, ausgetrampelten Weg entlang "+
    "der Mauer."));

  SetProp (P_INT_SHORT, "Wachweg in Midas");

  AddDetail ( ({"wand", "waende"}), "Waende? Das einzige, was Du so nennen "+
    "wuerdest, ist die Stadtmauer.\n");
  AddDetail ("boden",
    "Du stehst ziemlich sicher, auf den grossen, massiven Steinbloecken.\n");
  AddDetail ( ({"stadtmauer","mauer"}), bs(
    "Die maechtige Stadtmauer ist aus grossen Steinen zusammengestellt und "+
    "vermittelt ein Gefuehl von Sicherheit, das den Einwohnern dieser Stadt "+
    "wohl ihre fast schon stoische Ruhe verleiht.\n"));
  AddDetail ( ({"stein", "steine", "steinbloecke"}), bs(
    "Grosse, schwere Steinbloecke bilden die Grundlage fuer die maechtige "+
    "Stadtmauer sowie den Boden des Wachweges, auf dem Du stehst. Nur "+
    "wenige Fugen durchsetzen die Mauer.\n"));
  AddDetail ("fugen", "Sie wurden mit Moertel sorgfaeltig ausgefuellt.\n");
  AddDetail ("moertel", "Weisser Moertel fuellt die Fugen.\n");
  AddDetail ( ({"treppe", "treppen"}), bs(
    "Zwei Treppen fuehren auf einen kleinen ausgetrampelten Weg entlang "+
    "der Stadtmauer hinunter, eine weitere kleinere Treppe fuehrt auf "+
    "die Mauer hinauf.\n"));
  AddDetail ("weg", bs("Der Weg ist nicht sonderlich breit, stellt Dich "+
    "aber vor keine groesseren Probleme. Sogar die Stadtwachen mit ihrer "+
    "schweren Ruestung koennen hier problemlos ihren Dienst versehen.\n"));
  AddDetail ("wind", "Die Mauer schuetzt Dich hier einigermassen vor dem "+
    "kuehlen Wind.\n");
  AddDetail ("ueberblick", "Du kannst von hier aus die Stadt gut ueber"+
    "blicken, hast jedoch keine Sicht\nauf ausserhalb, dazu musst Du "+
    "noch hoeher rauf.\n");
  AddDetail ( ({"aussicht", "sicht"}), "Weiter oben hat man sicher eine "+
    "prima Aussicht ueber das weite Land.\n");

  AddItem (NPC "kampfsoldat", REFRESH_DESTRUCT);

  AddExit("suedunten", "die Treppe suedwaerts runter#./room_a2");
  AddExit("ostunten", "die Treppe ostwaerts runter#./room_b1");
  AddExit ("osten", "./wachweg_b1");
  AddExit ("sueden", "./wachweg_a2");
  AddExit ("oben", "./wachturm_a1");
}
