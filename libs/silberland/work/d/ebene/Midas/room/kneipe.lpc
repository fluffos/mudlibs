/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL. Preserved as kneipe_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Kneipe 'Zur roten Nase'");
  set_long(
    "Du befindest Dich in der grossen Stadtkneipe 'Zur roten Nase'. "
    "Hinter dem Ausschank kannst Du Max erkennen, den Besitzer der Kneipe. "
    "An der Westwand erblickst Du eine Tafel. Im Osten scheint ein "
    "deutlich vornehmerer Speisesaal zu sein, in dem man wohl auch groessere "
    "Mahlzeiten bekommt. Nach Sueden kannst Du die Kneipe verlassen.\n"
  );
  set_exits(([
    "sueden": "/d/ebene/Midas/room/room_b5",
    "osten": "/d/ebene/Midas/room/kneipe_saal",
  ]));
  set_items(([
    "tafel": "Eine Speisen- und Getraenketafel an der Westwand.\n",
    "ausschank": "Hinter dem Ausschank steht Wirt Max mit seiner markanten roten Nase.\n",
  ]));
  set_reads(([
    "tafel": "Zur roten Nase: Bier, Met, Zwergenbier und Suppe.\n",
  ]));
  set_smells(([
    "default": "Es riecht nach frischem Bier und Wildschweinbraten aus dem Speisesaal.\n",
  ]));
}
