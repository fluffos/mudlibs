#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Wachturm");
  SetProp (P_INT_LONG,
    "Du erklimmst den Wachturm ueber die kleine Treppe. Sofort offenbart "+
    "sich Dir ein wundervoller Blick ueber das weite Land. Im Osten "+
    "kannst Du den beruechtigten Ogerwald erkennen, etwas weiter hinten "+
    "auch den Fluss Lamsen, waehrend ein Stueck weiter im Norden das "+
    "wundervolle Feenschloss zu sehen ist. Dein Atem stockt bei diesem "+
    "wundervollen Ausblick, und fuer einen Moment vergisst Du, wie eng "+
    "und unbequem es auf diesem Turm doch eigentlich ist...");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"turm", "wachturm"}),
    "Du stehst auf selbigem und geniesst den Ausblick.");
  AddDetail ( ({"ausblick", "blick", "land"}),
    "Dein Blick schweift ueber das weite Land, und Du geniesst diesen "+
    "herrlichen Ausblick ueber den Ogerwald, die Ebene und das bezaubernde "+
    "Feenschloss.");
  AddDetail ( ({"ogerwald", "wald"}),
    "Im Ogerwald, den Du westlich von Dir erkennen kannst, hausen die "+
    "Oger, ziemlich gefaehrliche Zeitgenossen, denen Du besser aus dem Weg "+
    "gehst.");
  AddDetail ( ({"fluss", "lamsen"}),
    "Der Fluss Lamsen verlaeuft hinter dem Ogerwald von Nord nach Sued. Er "+
    "ist beruehmt fuer sein besonders klares und reines (sowie reinigendes) "+
    "Wasser.");
  AddDetail ( ({"wasser"}),
    "Dem Wasser des Lamsen sagt man unendliche Reinheit nach. Vielleicht "+
    "solltest Du dort ja mal hinpilgern, um das mal zu ueberpruefen?");
  AddDetail ( ({"feenschloss", "schloss"}),
    "Das Schloss, das Du etwas weiter noerdlich erkennen kannst, gehoert "+
    "einer einsamen Fee. Es wirkt bezaubernd und irgendwie geheimnisvoll.");
  // DETAILS END

  // EXITS START
  AddExit ("unten", "die kleine Treppe runter#./wachweg_h1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
