/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original author: Woody@SL. Preserved as room_e5_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Hauptstrasse in Midas");
  set_long(
    "Die Hauptstrasse in Midas erstreckt sich von Westen nach Osten. "
    "Im Norden liegt der grosse Laden von Midas, dessen Auslagen "
    "Abenteurer aller Laender anziehen. Ein schweres eisernes Kanalgitter "
    "ist hier ins Pflaster eingelassen.\n"
  );
  set_exits(([
    "norden": "/d/ebene/Midas/room/laden",
    "westen": "/d/ebene/Midas/room/room_d5",
    "osten": "/d/ebene/Midas/room/room_f5",
  ]));
  set_items(([
    "kanalgitter": "Das Kanalgitter fuehrt hinab in die Kanalisation von Midas.\n",
  ]));
}
