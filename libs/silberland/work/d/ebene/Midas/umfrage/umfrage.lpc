inherit "std/thing";
#include <properties.h>

start();
dname(string arg);
email(string arg);
antwort(string arg);
warum(string arg);
dgender(string arg);
alter(string arg);

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   SetProp(P_SHORT, "Ein UmfrageMaster");
   SetProp(P_LONG,"Hagugu@GueldeLand macht eine Umfrage! Tippe 'umfrage' um mitzumachen.\n");
   SetProp(P_NAME,"UmfrageMaster");
   SetProp(P_GENDER, MALE);
   SetProp(P_NOGET,1);
   AddId( ({"umfrage","master","umfragemaster"}) );
}

void init()
{
::init();
write("---->>>> Hier steht ein UmfrageMaster!\n");
add_action("start","umfrage");
add_action("start","umfrag");
}

start()
{
write("Die Frage: Gehst Du an Fussballspiele?\n");
write("Moegliche Antworten: JA, NEIN, MANCHMAL\n\n");
write("Deine Antwort: ");
input_to("antwort");
return 1;
}

antwort(string arg)
{
arg=lower_case(arg);
if (arg != "ja" && arg != "nein" && arg != "manchmal")
	{
	write("Ungueltige Antwort! (JA,NEIN,MANCHMAL) Nochmals eingeben: ");
	input_to("antwort");
	return 1;
	}
write_file("./umfrage_txt",arg+" ");
write("OK\nBitte Antwort begruenden: ");
input_to("warum");
return 1;
}

warum(string arg)
{
if (!arg || arg == " ")
	{
	write("Ungueltige Antwort! Nochmals eingeben: ");
	input_to("warum");
	return 1;
	}
write_file("./umfrage_txt",arg+" ");
write("OK\nGib bitte dein Alter ein: ");
input_to("alter");
return 1;
}

alter(string arg)
{
write_file("./umfrage_txt",arg+" ");
write("OK\nGib bitte deinen Namen ein: ");
input_to("dname");
return 1;
}

dname(string arg)
{
write_file("./umfrage_txt",arg+" ");
write("OK\nGib bitte dein Geschlecht ein: ");
input_to("dgender");
return 1;
}

dgender(string arg)
{
write_file("./umfrage_txt",arg+" ");
write("OK\nGib bitte deine EMail-Adresse ein: ");
input_to("email");
return 1;
}

email(string arg)
{
write_file("./umfrage_txt",arg+"\n");
write("OK\nHagugu dankt Dir von ganzem Herzen.\n");
return 1;
}
