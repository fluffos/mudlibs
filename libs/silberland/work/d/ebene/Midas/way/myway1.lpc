/* Weg-Finder            Blackmoor        19.11.95  V1.00 */
/*                       Eumel            25.11.95  V2.00 */

// Neuer Suchalgorithmus: Meistens schneller... vorallem:
// Jetzt wird immer der KUERZESTE Weg gesucht

// Suchen eines Weges zwischen zwei Raeumen.

#include <properties.h>

void searcher();
void go_deeper(string room);

string endroom, *front, *newfront, *gates, *known, *way;
string label;
mapping known_rooms;
int distance, maxdist, maxexamrooms, found_it, try;


find_way(string startroom, string i_endroom,
                 int i_maxdist, int i_maxexamrooms)
/* Init-Funktion - Variablen-Setting */
{
mapping ex;
string *ex_1, *ex_2, *choosen_ex;
int i, j;

choosen_ex=({});
//write(to_string(this_object()));
try += 1;
label = "l"+to_string(try);
if (!sizeof(get_dir(startroom+".lpc"))) {
   //write("No such starting room: "+ startroom+"!!!\n");
   return ({"War ein klassicher Flop! :-)"});
   }
if (!sizeof(get_dir(i_endroom +".lpc"))) {
   //write("No such target room: "+i_endroom+"!!!\n");
   return ({"War wohl nix... !"});
   }
  distance = 0;
  endroom = i_endroom;
  maxdist = i_maxdist;
  maxexamrooms = i_maxexamrooms;
  known=({});
  known_rooms=([startroom: "-"]);
  front = ({startroom});
  newfront = ({});
  gates = ({});
  found_it=0;
  searcher();
//write("\nSearched Rooms: "+to_string(sizeof(known_rooms))+"\n");
  if (found_it) 
    {
     //write("Distance = "+to_string(distance)+"\n");
     way = ({});
     for ( i = distance; i > 0; i-- ) 
      {
        way = ({endroom}) + way;
        endroom = known_rooms[endroom];
      }
     way=({startroom})+way;   
     for(i=0;i<=sizeof(way)-1;i++)
       {
        if(i!=sizeof(way)-1)
	  {
            ex=way[i]->QueryProp(P_EXITS);
            ex_1=m_indices(ex);
            ex_2=m_values(ex);
            j=member(ex_2, way[i+1]);
            choosen_ex+=({ex_1[j]});
	  }
       }
     return choosen_ex;
    }
  if (sizeof(known)>=maxexamrooms && maxexamrooms)
    {
    write("Terminating search: exceeding maxexamrooms!!!\n");
    }
  else if (distance && distance >=maxdist)
    write("Terminating search: exceeding maximum distance!\n");
  else write("There is no way connecting those rooms.\n");
}

string *get_exits(string room)
/* Exits eines Raumobjektes liefern */
{
  int flag, i;
  mapping m_exits;
  string *a_exits, *keys, *exit, buffer;
  object ob;
  if(ob=find_object(room))   // Raum schon geladen?
    flag=1;
  else
  {
write("loading");
      flag=0;
write(catch(room->create()));
      if (catch(room->create()));
      if (!ob=find_object(room))
     {
      if (!sizeof(get_dir(room+".lpc")))
         write("No such file: "+room+"!!!\n");
      else
      write("Buggy room: "+room+" cannot be loaded!!!\n");
      //find_player("eumel")->command_me("update "+room);
      return ({});  // Raum lies sich nicht clonen...
    }
  }
  a_exits=({});
m_exits = ([]);
  if(!catch(m_exits=ob->QueryProp(P_EXITS)))
  {
    keys=m_indices(m_exits);
    for (i=0;i<sizeof(keys);i++)
    {
      exit=explode(m_exits[keys[i]], "#");
      buffer=exit[sizeof(exit)-1];
      if (!catch(buffer->dummy()))
         if (buffer->Query("way_name")!=label) {
        a_exits += ({buffer});
        buffer->Set("way_name",label);
        }
    }
  }
  else {
    write(to_string(catch(m_exits=ob->QueryProp(P_EXITS))));
    write(" in "+to_string(ob)+"\n");
    write("\n");
    }
// if (!flag)    fall raum nicht geladen war, destructen...
// dann jetzt destructen ??? 
  return a_exits;
}
searcher() {
   int i, j;
   while (sizeof(known) < maxexamrooms || !maxexamrooms) {
   for ( i=0; (i<sizeof(front))&&(!found_it); i++ )
       {
       gates = ({});
       gates = get_exits(front[i]);
       for (j = 0; j<sizeof(gates); j++)
           {
           known_rooms = known_rooms + ([ gates[j]: front[i] ]);
           newfront += ({ gates[j]});
           if (gates[j]==endroom) found_it=1;
           }
       }
       front = newfront[0..]; newfront = ({});
       distance += 1;
       if (found_it || !sizeof(front) || (maxdist && distance >maxdist)
          || (maxexamrooms && sizeof(known_rooms) > maxexamrooms))
       return;
}
}

