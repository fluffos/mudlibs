inherit "std/mnpc";
// inherit "std/inpc/select";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../midas.h"

init()
{
  ::init();
  if (TP && (TP->id("Kampfsoldat") || TP->id("Offizier"))) AddDefender(TP);
}

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"kampfsoldat","soldat", "Kampfsoldat"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Kampfsoldat");
  SetProp (P_SHORT, "Ein Kampfsoldat");
  SetProp (P_LONG, "Der Kampfsoldat mustert Dich mit unbewegter Miene. Er "+
    "bewacht die Stadt und sorgt fuer Ruhe und Ordnung. Seine kraeftige "+
    "Statur scheint ihn fuer diese Aufgabe geradezu zu praedestinieren.");
  SetProp (P_ALIGN, 50+random(50));
  create_default_npc(20+random(3));
  // SetProp (P_LEVEL, 15);
  // SetProp (P_MAX_HP, 400+random(100));
  // SetProp (P_MAX_SP, 500);
  // SetProp (P_XP, 500000);
  // SetProp (P_BODY, 70+random(10));
  SetProp (P_SIZE, 170+random(15));
  SetProp (P_RACE, "Mensch");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit blossen Haenden", 80, DT_BLUDGEON}) );

  // set_living_name("kampfsoldat");
  // (nur fuer staerkere und v.a. unique Monster sinnvoll)

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  // Ausruestung
  CLONEME("/p/armour/armour/eisenpanzer");
  if( random(100) < 85 ) CLONEME("/p/armour/shield/eisenschild");
  if( random(100) < 45 ) CLONEME("/p/armour/boots/lederstiefel");
  if( random(100) < 10 ) CLONEME(OBJ("ruestung/armschienen"));
  if( random(100) < 10 ) CLONEME(OBJ("ruestung/beinschienen"));
  if( random(100) < 10 ) CLONEME("/p/armour/gloves/lederhandschuhe");
  command ("trage alles");
  CLONEME(OBJ("waffe/kampfschwert"));
  command ("zuecke kampfschwert");

  SetProp(P_SPELLRATE,15);

  AddSpell(2,150, 
    "Der Kampfsoldat trifft Dich mit voller Wucht.\n",
    "Der Kampfsoldat trifft @WEN mit voller Wucht.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,250, 
    "Der Kampfsoldat versetzt Dir einen schweren Schlag ins Genick.\n",
    "Der Kampfsoldat versetzt @WEM einen schweren Schlag ins Genick.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6, ({
    "Der Kampfsoldat ruft: Na warte, das wirst Du bereuen!\n",
    "Der Kampfsoldat tritt Dich.\n"}) );

  SetProp (P_DIE_MSG, " schreit noch einmal laut auf und stirbt.\n");
  SetProp (P_DEFAULT_INFO, "mustert Dich schweigend.\n");

  AddInfo ( ({"wachtuerme","wachturm"}),
      "Von dort oben haben wir einen wunderbaren Ueberblick ueber "
      "die ganze Stadt. Und einen schoenen Ausblick ins weite "
      "Land obendrein!", "sagt: ");
  AddInfo ( ({"kampfsoldat","kampfsoldaten","soldat","soldaten"}),
      "Wir Kampfsoldaten ueberwachen die Stadt von hier aus, also "
      "pass bloss auf, dass Du nichts anstellst, sonst gehts Dir "
      "an den Kragen!", "sagt: ");
  AddInfo ( ({"gefahr","gefahren","tod"}),
      "warnt Dich: Der Tod lauert an jeder Ecke auf Dich!");

  AddLibrary( NPC "midas.lib", 3 );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kampfsoldat brummelt: \"Behalt Dein Zeug.\"\n" }) );

  SetProp (P_MNPC_AREA, ROOM "wachweg");
  SetProp (P_MNPC_WAIT, ({ 10+random(20), 90, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "wachweg_a1");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

// Ich will daemliche Kampfsoldaten... tote Spieler beklauen
// ist etwas, wozu sie einfach nicht faehig sind, Punkt.
