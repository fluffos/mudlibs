int SetNick(string name, string nick)
{
  if (getuid(this_interactive()) != "woody")
    return -1;
  nicks[name] = nick;
  return 1;
}


string GetNick(string who)
{
  string tmp;

  if (member( nicks, who ))
    return nicks[who];

  tmp = regreplace( who,
      "^([^aeiouy]*[aeiouy][^aeiouy]*)[aeiouy].*$", "\\1i", 0 );

  if (who == tmp)
    if (tmp[<1] != 'i' && tmp[<1] != 'y' && tmp[<2..] != "ie")
      tmp += "i";
    else
      tmp += "lein";

  return capitalize(tmp);
}


void WriteKillsFile()
{
  mixed ind;
  int i;

  rm(SAVEFILE);
  ind = sort_array( m_indices(my_kills), #'< );
  for (i=sizeof(ind); i-->0; )
    write_file( SAVEFILE, sprintf("%s|%d\n",ind[i],my_kills[ind[i]]) );
}


void ReadKillsFile()
{
  string wer,n;
  mixed lines;
  int i;

  my_kills=([]);
  lines=explode(read_file(SAVEFILE),"\n");
  for (i=0; i<sizeof(lines); i++)
    if (sscanf(lines[i],"%s|%d",wer,n) == 2)
      my_kills[wer] = n;
}


