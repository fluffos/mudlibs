int richte(string str)
{
  notify_fail("WEM willst Du WAS (von WEM) (aus)richten?\n");
  if (!str) return 0;
  if (str == "gruss aus")
    return notify_fail("Schoen, aber wem?\n"), 0;
  if (str == "max gruss aus")
    return notify_fail("Schoen, aber von wem?\n"), 0;
  if (str == "gruss von landar aus")
    return notify_fail("Schoen, aber wem willst Du den ausrichten?\n"), 0;
  if (str != "max gruss von landar aus")
    return 0;

  write("Du richtest Max einen Gruss von Landar aus.\n");
  environment()->Message(
    TP->Name() + " richtet Max einen Gruss von Landar aus.\n",
    MSGFLAG_SOUND | MSGFLAG_NO_TP );

  write_file (GRUSSLOG,
      dtime(time()) + ": " + CAP(getuid(TP)) +
      " richtet Max einen Gruss aus.\n");

  environment()->Message(
      "Max freut sich.\n" +
      break_string(
        "Danke, " + TP->Name() +
        ", wie geht es dem alten Haudegen denn? Bestimmt gut, na ich "
        "hoffe, er schaut bald mal wieder bei mir vorbei!", 78,
        Name() + " sagt: "),
      MSGFLAG_SOUND );

  return 1;

}


void give_notify(object obj)
{
  if(InFight(ME)) return ::give_notify(obj); 
  if(!obj->id("\ngeld")) {
     return ::give_notify(obj);
  }
  if(obj->QueryProp(P_AMOUNT) == 23) { 
    tell_object(TP, break_string("Wenn am Hinterhof die Hunde bunt werden, "
          "oeffnet der Pfoertner den Eingang zur Rose!", 78, "Max fluestert "
          "Dir zu: ")); 
    tell_room(ENV(ME), sprintf("Max fluestert %s etwas zu.\n", 
          TP->name(WEM)), ({TP}));
    command_me("sag Aehmmmmm Danke vielmals!");
    return ;
  }
  return ::give_notify(obj);
}  

void catch_tell(string str)
{
  string tcode, msg, wer;
  object tmaster;
  int ret, hours;
  hours=3;
  if(sscanf(str, "%s teilt Dir mit: tombolacode %s\n", wer,tcode)==2) {
    ret=call_other(TOMBOLAMASTER, "AddWinner", TP,tcode,(hours*60*60));
    switch (ret) {
      case -1: msg="Du hast bereits einen Code aktiv!"; break;
      case -2: msg="Das ist kein gueltiger Code!"; break;
      default: msg=sprintf("Gratuliere! Du kannst nun %d Stunden "
                   "alles bei mir frei konsumieren!", hours);
    }
    TP->Message(break_string(msg, 78, "Max teilt Dir mit: "), MSGFLAG_TELL);
  }
  return ;
}
