void chkEnv()
{
  if (!environment())
    move(ROOM "kneipe", M_GO);
}

// + 500 LP pro Reset
// --------
void reset()
{
  ::reset();
  if (QueryProp(P_HP) < QueryProp(P_MAX_HP))
  {
    say(
      bs("Max zieht einen Powersnack aus seiner Tasche, verzehrt ihn "+
      "genuesslich und sieht auf einmal deutlich gestaerkt aus.\n"));
    SetProp(P_HP, QueryProp (P_HP)+500);
  }
}

void init()
{
  ::init();
  if (interactive(TP))
    if (getuid(TP) == "woody")
      call_out("hallo", 0, getuid(TP));
    else if (random(3))
      call_out("hallo", 0, getuid(TP));
}

void hallo(string who)
{
  object ob;
  string nm;
  string hallo;

  if (!ob=find_player(who)) return;
  if (environment(ob) != environment()) return;
  if (ob->QueryProp(P_INVIS)) return;

  if (ob->QueryProp(P_FROG)) {
    tell_room( environment(), "Max sagt: Hallo Froschi! :-)\n" );
    return;
  }

  switch (ob->QueryProp(P_RACE))
  {
    case "Elf":
      hallo = "Alae ";
      break;
    case "Zwerg":
    case "Waldzwerg":
      hallo = "Prost ";
      break;
    case "Hobbit":
    case "Oger":
      hallo = "Mahlzeit ";
      break;
    case "Troll":
      hallo = "HALLO ";
      break;
    case "Dunkelelf":
      hallo = "Vendui ";
      break;
    default:
      hallo = "Hallo ";
      break;
  }
  nm = GetNick(who);
  tell_room( environment(), "Max sagt: " + hallo + nm + "!\n" );
}


string biertext()
{
  if ((TP->QueryProp(P_LEVEL) > FREIBIER_LEV) &&
     (TP->QueryProp(P_XP) > FREIBIER_XP))
       return "den ich schwaecheren Spielern als Freibier anbiete.";
  else
    return "den ich gerne mit Dir teile. Frag mich einfach nach Freibier!";
}

string freibiertext()
{
  if ( (TP->QueryProp(P_LEVEL) > FREIBIER_LEV) &&
       (TP->QueryProp(P_XP) > FREIBIER_XP) )
  {
    return "mustert Dich.\n"
      "Max sagt: Nein, Dir gebe ich kein Freibier, kauf Dir lieber was!\n";
  }
  else
  {
    if (TP->drink_alcohol(8) && TP->drink_soft(10))
    {
      TP->heal_self(10+random(3));
      say ("Der Wirt bringt "+TP->name(WEM)+" ein Freibier.\n"+
        CAP(TP->QueryPronoun(WER))+" leert das Glas in einem Zug.\n", TP);
      return "grinst und bringt Dir ein Freibier.\n"
        "Du schuettest es runter und fuehlst Dich etwas gestaerkt.\n";
    }
    else return "troestet Dich.\n";
  }
}

string schnapszahltext()
{
  string xp;
  int n;

  if ( ((n = strlen(xp = to_string(TP->QueryProp(P_XP)))) > 2) &&
       (xp == sprintf("%'"+xp[0..0]+"'*s",strlen(xp),"")) )
  {
    if (TP->drink_soft(10))
    {
      n = 50 + 50 * (n-3);
      TP->heal_self(n);
      TP->AddExp(1);
      write_file (SCHNAPSLOG,
          sprintf( "%s: %s [%s] -> %d\n",
          dtime(time()), CAP(getuid(TP)), xp, n));
      say("Der Wirt gibt " + TP->name(WEM) + " ein paar Drinks aus und "
          "gratuliert " + TP->QueryPronoun(WEM) + ".\n", TP);
      return "gratuliert Dir herzlich und bringt Dir ein paar Drinks.\n"
        "Als Ueberraschung ueberreicht er Dir noch einen Erfahrungspunkt.\n"
        "Du strahlst und fuehlst Dich richtig gut.\n";
    }
    else return "troestet Dich.\n";
  }
  return "erklaert: Eine Schnapszahl ist eine Zahl, die aus lauter gleichen\n"
    "Max erklaert: Ziffern besteht, und zwar mindestens drei. Also zum\n"
    "Max erklaert: Beispiel 333 oder 66666 oder 88888888.\n";
}

