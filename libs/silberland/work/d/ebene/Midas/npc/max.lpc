mixed QueryNewFbands()
{
  return pls;
}

int _query_chat_chance()
{
  if (environment()->id("\nsaal")) return 0;
  return Query(P_CHAT_CHANCE);
}

void CallFor(object dest, object pl)
{
  int nextWalk, delay;

  if (dest==environment()) return;
  if (IsEnemy(pl))
  {
    tell_room(environment(), "Max ruft zurueck: "
        "Komm doch selbst her, wenn Du Dich traust!\n", ({TO}));
    tell_room(dest, "Der Wirt ruft von nebenan: "
        "Komm doch selbst her, wenn Du Dich traust!\n");
    return;
  }
  if ((nextWalk=find_call_out("DoWalk")) < 10 && nextWalk!=-1) {
    tell_room(environment(), "Max ruft zurueck: "
        "Bin ja schon unterwegs, nur die Ruhe!\n", ({TO}));
    tell_room(dest, "Der Wirt ruft von nebenan: "
        "Bin ja schon unterwegs, nur die Ruhe!\n");
    return;
  }
  if (time()-lastWalk<30) delay=14; else delay=4;

  //
  // wer hinter meinem Ruecken bloed/schlecht ueber mich redet, muss damit
  // rechnen, dass ich ihn nicht sonderlich gern hab. Woody.-
  //
  // if (member((["spieler1","spieler2",]),getuid(pl)))
  //   delay+=20;

  //
  // Wenn wer boese war :)
  //
  if (member( mkmapping(FEINDE), getuid(pl) )) {
    tell_room(environment(), "Max ruft zurueck: "
        "Oh, "+capitalize(getuid(pl))+", ihr muesst laenger warten!\n", ({TO}));
    tell_room(dest, "Der Wirt ruft von nebenan: "
        "Oh, "+capitalize(getuid(pl))+", ihr muesst laenger warten!\n");
    delay+=10;
  }
  else
  {
    tell_room(environment(), "Max ruft zurueck: "
        "Einen Moment Geduld bitte!\n", ({TO}));
    tell_room(dest, "Der Wirt ruft von nebenan: "
        "Einen Moment Geduld bitte!\n");
  }
  while (remove_call_out("DoWalk") != -1) /* continue */ ;
  call_out("DoWalk", delay+random(3), dest, pl);
}

void DoWalk(object dest, object pl)
{
  mixed exits;
  string msg,msg2;
  object ob;
  int i;

  if (dest) {
    i=random(5);
    msg=({"schlendert","schaut mal","geht","schlurft","hastet"})[i];
    msg2=({"schlendert herein","schaut sich suchend um","kommt an",
        "schlurft herein","kommt hereingehastet"})[i];
    move(dest, M_GO, "nach nebenan", msg, msg2);
  }
  else if (environment())
  {
    exits = filter_array( m_indices( environment()->QueryProp(P_EXITS) ),
              ([ "osten","westen" ]) );
    if (sizeof(exits))          // na hoffentlich hat er sich ned verirrt ;)
      command_me( exits[0] );
  }

  if (dest)
  {
    command_me("sag Ja, was kann ich fuer Dich tun?");
    /*
    if (!random(3) && pl && (ob=present("xyz",pl)))
    {
      command_me("sag Huch, sowas, ich sammle xyz und Du hast eines!");
      tell_object(pl, "Max klaut Dir Dein xyz.\n");
      ob->move(ME, M_NOCHECK);
    }
    */
  }
  while (remove_call_out("DoWalk") != -1) /* continue */ ;
  call_out("DoWalk", 90+random(30));
  lastWalk = time();
}

varargs void die(int p)
{
  int direkt;
  object item;
  direkt = extern_call() && (previous_object() != this_object());
  write_file (LOGF,
      dtime(time())+": Max wird gekillt von "+CAP(getuid(TP))+
      (direkt ? " (direkt!).\n" : ".\n"));
  my_kills[getuid(TP)]++;
  WriteKillsFile();
  ::die(p);
}

varargs int move(mixed dest, int method,
                 string dir, string textout, string textin)
{
  object ob;
  string fn;

  if ((ob=previous_object())==ME)
    return ::move(dest,method,dir,textout,textin);

  if (file_name(ob)[0..19]=="/d/ebene/Midas/room/")
    return ::move(dest,method,dir,textout,textin);

  if (this_interactive() && getuid(this_interactive())!="woody")
    return tell_object(this_interactive(), "Max gehorcht Dir nicht.\n"), -1;
  else
    return ::move(dest,method,dir,textout,textin);
}

