#include "../midas.h"

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Die Beamtin Margarte Prospyschil");
  SetProp (P_LONG,
    "Margarte Prospyschil"
  );

  AddId ( ({"beamtin","margarte","prospyschil","\nBEAMTIN2"}) );
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Margarte Prospyschil");
  SetProp (P_ALIGN, 80+random(30));
  create_default_npc(10+random(3));
  SetProp (P_SIZE, 160+random(20));
  SetProp (P_RACE, "Mensch");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit blossen Haenden", 50, DT_BLUDGEON}) );

  SUID;

  SetProp (P_DIE_MSG,
    " aechzt: Wer wird jetzt in meinem Schalter sitzen ?\n"
  );

  SetProp (P_DEFAULT_INFO,
      ({ "sagt:Was geht mich das ueberhaupt an ?\n"
       }));

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Margarte sagt: Was soll ich damit ?\n"
  }) );

}


