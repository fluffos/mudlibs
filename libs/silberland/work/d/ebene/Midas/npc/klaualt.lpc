
inherit "std/mnpc";


#include <properties.h>
#include <npc.h>
#include <mnpc.h>
#include <language.h>
#include <combat.h>
#include <wizlevels.h>
#include <moving.h>
#include "/d/gebirge/dusty/zwerge/files.h"

#define FRACTION 200    // klaue ein 200-stel pro Reset

object geld;      // Das eigene Geld-Objekt
mapping
  gestohlen,      // Ein Mapping SPIELER:GELD, das angibt, wieviel Geld
                  // einem Spieler seit dem letzten Reset gestohlen wurde
  gest_total;     // Ein Mapping SPIELER:GELD, das angibt, wieviel Geld
                  // dem Spieler insgesamt bereits gestohlen wurde

create()
{
 if (!is_clone(this_object())) return;
 ::create();
 SetProp(P_SHORT, "Neid-Klau-Sammli");
 SetProp(P_LONG, 
  "Neid-Klau-Sammli heiss ich Koboldwicht,\n"
  +"aufs Klauen, Sammeln bin ich erpicht,\n"
  +"stets jedes Ding zu allen Orten\n"
  +"nur immer sammeln, klauen, horten\n"
  +"und niemals schenken, noch was geben:\n"
  +"ein Neid-Klau-Sammli Koboldleben!\n");  
 SetProp(P_NAME, "Neid-Klau-Sammli");
 AddId(({"neid", "klau", "sammli", "neid-klau", "neid-klau-sammli"}));
 SetProp(P_GENDER, MALE);
 create_default_npc(8);
 SetProp(P_MAX_HP, 600);
 SetProp(P_HP, 600);
 SetProp(P_XP, 400000);
 SetProp(P_ALIGN, -1000);
 SetProp(P_HEAL, -50);
 SetProp(P_HANDS, ({" mit riesengrossen Krallentatzen", 180}));
 SetProp(P_SIZE, 20);
 SetProp(P_BODY, 150);
 SetProp(P_RACE, "kobold");
 SetProp (P_MNPC_AREA, "/");
 SetProp (P_MNPC_WAIT, ({ 5, 20, 30 }));        
 SetProp (P_MNPC_DEFAULTROOM, ("/d/ebene/Silberwald/room_a01"));
 SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES); 

 gestohlen = ([]);
 gest_total = ([]);
 SUID;
 geld = clone_object ("/obj/money");
 geld->move(ME);
}

init()
{
  int x, n, res;
  object tp;

  res = ::init();
  tp = TP;  // viele Referenzen auf TP, drum zwischenspeichern
  if (IS_LEARNER(tp) || tp->QueryProp(P_TESTPLAYER) || !interactive(tp))
    return 1;
  x=tp->QueryMoney() / FRACTION;    // wieviel KOENNTEN wir ihm klauen?
  if (x && !member(gestohlen, tp))  // nur wenn Geld da, nur einmal pro reset
  {
    write (capitalize(name(WER, 1))+" klaut Dir "+x+" Muenze"+
      (x==1 ? "" : "n")+" !\n");
    say (capitalize(name(WER, 1))+" klaut "+tp->QueryName(WEM)+
      " etwas Geld !\n", tp);
      // " "+x+" Muenze"+(x==1 ? "" : "n")+" !\n", tp);
    write (bs(capitalize(name(WER, 1))+" mustert begierig Deine Taschen und "+
      "Beutel, ist aber noch zu ungeschickt, um an das Geld darin heran "+
      "zu kommen. Er entschliesst sich, das spaeter einmal nachzuholen."));
    tp->AddMoney(-x);
    geld->AddAmount(x);
    gestohlen += ([ tp : x ]);
    if (member(gest_total, tp))
      gest_total[tp] += x;
    else
      gest_total += ([ tp : x ]);
  }
  else if (member(gest_total, tp))  // hmm, haben wir schon Geld von ihm?
  {
    write (bs(capitalize(name(WER, 1))+" zeigt Dir "+
      (n=gest_total[tp])+" Muenze"+(n==1 ? "" : "n")+
      ", "+"die einmal Dir gehoert ha" + (n==1 ? "t" : "ben") + " !\n")+
      capitalize(name(WER, 1))+" grinst Dich haemisch an.\n");
    say (capitalize(name(WER, 1))+" grinst "+tp->QueryName(WEN)+
      " haemisch an.\n", tp);
  }
  return res;
}

reset()
{
  gestohlen = ([]);
}
