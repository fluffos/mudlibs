/*
** Die Riesenratte  (w) Woody
** ---
** 26 Jul 1997  1.0  Release
** 2002-12-15  Woody  in kanal-Dir verschoben
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "files.h"

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  create_default_npc(15);
  AddId ( ({"ratte", "riesenratte"}) );
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Riesenratte");
  SetProp (P_SHORT, "Eine furchteinfloessende Riesenratte");
  SetProp (P_LONG, "Uffz! So eine riesige Ratte hast Du noch nie zuvor "
      "gesehen! Ihre Haut ist graurosa und hat tiefe Falten, ihre Augen "
      "starren Dich kampflustig an und ihre grossen Ohren scheinen jede "
      "Deiner Taetigkeiten sofort zu registrieren. Der lange Schwanz "
      "scheint ihr auch als Waffe zu dienen, Du solltest Dich auf jeden "
      "Fall in Acht nehmen!");
  SetProp (P_ALIGN, -100-random(50));
  SetProp (P_INFO,
      "Normalerweise tritt sie in Rudeln auf.\n"
      "Licht und Feuer meidet sie, wo es geht.\n"
      "Ausserdem ist ihr Fleisch nicht gerade das gesuendeste...\n");
  SetProp (P_HEAL, -20);
  SetProp (P_SIZE, 100+random(20));
  SetProp (P_RACE, "Ratte");
  SetProp (P_HANDS, ({" mit ihren grossen Krallen", 200, DT_BLUDGEON}) );

  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_FIRE:0.3,
         DT_LIGHT:0.5,
         DT_POISON:-0.5,
         DT_UNHOLY:-0.2,
         DT_HOLY:0.3,
       ]) );

  SetProp (P_AGGRESSIVE, 0.5);
  SetProp (P_SPELLRATE, 25);

  AddSpell(1, 300,
    "Die Riesenratte reisst Dir mit ihren Krallen fast den Bauch auf.\n",
    "Die Riesenratte reisst @WEM mit ihren Krallen fast den Bauch auf.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 400,
    "Die Riesenratte versetzt Dir einen Peitschenhieb mit ihrem Schwanz.\n",
    "Die Riesenratte versetzt @WEM einen Peitschenhieb mit ihrem Schwanz.\n",
    DT_WHIP, ([SP_SHOW_DAMAGE:1]) );

  SUID;
  CLONEME(OBJ("div/riesenrattenzahn"));
}

