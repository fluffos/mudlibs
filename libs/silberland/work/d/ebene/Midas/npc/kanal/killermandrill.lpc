*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"mandrill", "killermandrill, \nkillermandrill"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Killermandrill");
  SetProp (P_SHORT, "Ein Killermandrill");
  SetProp (P_LONG, "Der Killermandrill sieht aus wie ein zu gross "
      "geratener Affe. Das Haar wuchert ihm vom Kopf bis zum Ende des "
      "Rueckgrats, mit seinen breiten Schultern und ueberlangen "
      "Armen wirkt er auf Dich ziemlich bedrohlich. So richtig mulmig "
      "wird Dir aber erst, als Du seine langen Reisszaehne und die "
      "scharfen, harten Krallen an seinen Fingern bemerkst...");
  SetProp (P_ALIGN, -100-random(100));
  SetProp (P_AGGRESSIVE, 1.0/3);
  // SetProp (P_INFO, "\n");
  create_default_npc(28+random(4));
  SetProp (P_XP, QueryProp(P_XP)+100000);  // Spell-Bonus
  SetProp (P_HEAL, -10);
  SetProp (P_SIZE, 165+random(20));
  SetProp (P_RACE, "Affe");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinen scharfen Krallen", 400, DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:0.3,
      DT_LIGHT:0.3,
       DT_HOLY:0.3,
     DT_POISON:-0.25,
     DT_UNHOLY:-0.25 ]) );

  set_living_name("killermandrill");

  SetProp (P_SPELLRATE, 10);

  AddSpell(1, 600,
    "Der Killermandrill kratzt Dich mit seinen Krallen, bis das Blut rinnt.\n",
    "Der Killermandrill kratzt @WEN mit seinen Krallen blutig.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 750, 
    "Der Killermandrill reisst Dir mit seinen Zaehnen den Bauch auf.\n",
    "Der Killermandrill reisst @WEM mit seinen Zaehnen den Bauch auf.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6, ({
    "Der Killermandrill faucht und bruellt.\n",
    "Der Killermandrill bohrt seinen Blick in Dich.\n"
      "Du fuehlst Dich auf einmal so depressiv.\n",
    "Der Killermandrill uebt sich in Drohgebaerden.\n"}) );

  SetProp (P_DIE_MSG, " haucht sein Leben aus.\n");
  SetProp (P_MURDER_MSG,
      "Warte nur, %s! Das naechste Mal bist Du machtlos.");
  SetProp (P_KILL_MSG,
      "Ist das nicht unheimlich deprimierend?");
  SetProp (P_DEFAULT_INFO, "faucht Dich an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Killermandrill will nur Deinen Tod.\n" }) );
}

