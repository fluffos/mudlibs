inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

#include "files.h"

int autoremove, autolock;

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("waechter");
  AddId ("\nwaechter");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Waechter");
  SetProp (P_SHORT, "Ein Waechter");
  SetProp (P_LONG, bs("Der Waechter schaut Dich ziemlich grimmig an. Man "+
    "merkt ihm an seinem wilden Gesichtsausdruck richtiggehend an, dass er "+
    "wohl lange nicht mehr das Tageslicht gesehen hat."));
  SetProp (P_ALIGN, -100);
  SetProp (P_LEVEL, 9);
  SetProp (P_MAX_HP, 500);
  SetProp (P_HP, 500);
  SetProp (P_MAX_SP, 200);
  SetProp (P_XP, 500000);
  SetProp (P_BODY, 100);
  SetProp (P_SIZE, 180+random(10));
  SetProp (P_HANDS, ({" mit blossen Haenden", 200, DT_BLUDGEON}) );

  SetAttackChats(6, ({
    "Der Waechter bruellt Dich wutentbrannt an.\n",
    "Der Waechter drischt wie wildgeworden auf Dich ein.\n"}) );

  SetProp (P_DIE_MSG, " sackt zusammen.\n");
  SetProp (P_DEFAULT_INFO, "schreit nur wuetend: \"Halts Maul!\"\n");
  AddInfo ("waechter", "bruellt: \"Stell nicht so bloede Fragen!\"\n");
  autolock=1;
  autoremove=0;
}

void noautolock()
{
  autolock=0;
}

void setautoremove()
{
  autoremove=1;
}

void Attack(object enemy)
{
  ::Attack(enemy);
  if (autolock)
  {
    StopHuntFor(enemy, 1);
    enemy->StopHuntFor(ME, 1);
    tell_object (enemy, bs(
      "Der Waechter steckt Dich kurzerhand in eine Gefaengniszelle."));
    enemy->move(KANAL "kanal2_f7", M_TPORT, "",
      "wird vom Waechter kurzerhand in die Gefaengniszelle gesteckt",
      "wird von einem Waechter hereingeworfen");
    return;
  }
  if (!autoremove) return;
  if (enemy->QueryProp(P_HP) < 20)
  {
    StopHuntFor(enemy, 1);
    enemy->StopHuntFor(ME, 1);
    tell_object (enemy, "Der Waechter verschwindet ebenso ueberraschend, "+
      "wie er aufgetaucht ist.\n");
    call_out ("remove", 0);
  }
}
