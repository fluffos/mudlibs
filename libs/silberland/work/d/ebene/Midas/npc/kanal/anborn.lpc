inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

#include "files.h"

void create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("anborn");
  AddId ("\nanborn");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Anborn");
  SetProp (P_ARTICLE, 0);
  SetProp (P_SHORT, "Anborn, der Gefangene");
  SetProp (P_LONG, bs("Der Gefangene macht einen verzweifelten Eindruck. "+
    "Er scheint schon lange hier einzusitzen, seine Beine sind alt und "+
    "schwach, seine Augen grau, und er wirkt sehr muede und erschoepft, "+
    "aber immer noch mit erstaunlichem Lebenswillen."));
  SetProp (P_ALIGN, 100);
  SetProp (P_LEVEL, 9);
  SetProp (P_MAX_HP, 100);
  SetProp (P_MAX_SP, 100);
  SetProp (P_XP, 100000);
  SetProp (P_BODY, 40);
  SetProp (P_SIZE, 165+random(10));
  SetProp (P_HANDS, ({" mit blossen Haenden", 30, DT_BLUDGEON}) );

  SetProp (P_MSGIN, "wird hereingeworfen");
  SetProp (P_MSGOUT, "schleppt sich");

  // Details:
  AddDetail( ({ "eindruck" }),
    "Die Verzweiflung steht ihm foermlich ins Gesicht geschrieben." );
  AddDetail( ({ "bein", "beine" }),
    "Anborn steht auf schwachen Beinen." );
  AddDetail( ({ "auge", "augen" }),
    "Saemtliche Lebensfreude scheint aus seinen Augen verschwunden zu sein." );
  AddDetail( ({ "fuss", "fuesse" }),
    "Anborns Fuesse sind verschmutzt und von alten Schnittwunden "
    "uebersaet. Schuhe duerfte er schon lange keine mehr besessen haben." );
  AddDetail( ({ "arm", "arme" }),
    "Anborns Arme sind nicht sehr stark. Du koenntest ihn bestimmt "
    "leicht bezwingen, wenn Du das wolltest." );
  /*
  AddDetail( ({ "" }),
    "" );
  AddDetail( ({ "" }),
    "" );
  AddDetail( ({ "" }),
    "" );
  */

  // Infos:
  SetProp (P_DEFAULT_INFO, "laechelt weise und geheimnisvoll.\n");
  AddInfo ( ({ "gefaengnis","zelle","gefaengniszelle" }),
    "Ja, ich wurde hier vor vielen Jahren eingesperrt, weil ich einen "+
    "der Waechter einen Verraeter nannte... Ach, die nehmen alles so "+
    "persoenlich.", "erzaehlt: ");
  AddInfo ("waechter",
    "Sie begehen Verrat am eigenen Volk!", "schimpft: ");
  AddInfo ( ({ "verrat","verraeter" }),
    "Die Waechter machen mit einigen der Gaffo-Anfuehrer gemeinsame "+
    "Sache und helfen ihnen bei Ueberfaellen auf die Stadt. Dafuer "+
    "verantwortlich ist meines Erachtens Saruman.", "erzaehlt: ");
  AddInfo ("gaffos",
    "Ja, ein uebles Volk... immer wieder ueberfallen sie die Stadt und "+
    "haeufen so unschaetzbare Besitztuemer an.", "grummelt: ");
  AddInfo ("besitztuemer",
    "Unermesslich sollen sie sein... sogar Zwerge wuerden blass werden "
    "vor Neid! Aber sie sind gut versteckt!", "sagt: ");
  AddInfo ("versteck",
    "Keine Ahnung wo, aber da kommt wohl niemand so schnell ran...",
    "meint: ");
  AddInfo ( ({ "stadt","midas" }),
    "Die Stadt Midas ist genau ueber uns!", "sagt: ");
  AddInfo ("saruman",
    "Saruman ist ein boeser Zauberer. Er war frueher einmal ein guter "+
    "Freund, und wir haben schoene Zeiten erlebt, ich habe ihm auch "+
    "viel beigebracht, aber alles was er im Kopf hatte, war Besitz. "+
    "Und fuer den tat und tut er alles. Er hat einige der Waechter "+
    "bestochen, um mit ihm und einigen Gaffo-Anfuehrern gemeinsame "+
    "Sache zu machen. Man muss ihm Einhalt gebieten! Aber ich bin "+
    "schon zu alt und schwach, um das zu tun... Vielleicht kannst Du "+
    "ja etwas tun?", "erzaehlt: ", 1);
  AddInfo ( ({ "einhalt", "hilfe", "aufgabe" }),
    "Wenn Du mich hier befreien kannst, so will ich Dir ein paar "+
    "Geheimnisse anvertrauen, mittels denen Du Saruman und seinem "+
    "Treiben vielleicht Einhalt gebieten kannst. Ein Mitgefangener "+
    "behauptete einmal, man haette ihm erzaehlt, die Knoepfe an der "+
    "Wand wuerden den Weg nach draussen frei machen, aber als er es "+
    "dann eines Tages versuchte, kam ein Waechter und zerschmetterte "+
    "den armen Burschen. Seit diesem Tag muss ich alleine hier "+
    "mein Dasein fristen... aber vielleicht findest Du ja raus, wie "+
    "die Knoepfe den Weg in die Freiheit oeffnen?", "erzaehlt: ", 1);
  AddInfo ( ({"knoepfen", "knoepfe"}), "Ja, sie bedeuten beides, Freiheit "+
    "und Tod... man muss sie wohl richtig zu bedienen wissen. Ich habe mich "+
    "nie getraut, nachdem mein Mitgefangener den Tod gefunden hatte.",
    "murmelt: ");
  AddInfo ( ({ "freiheit","befreiung" }),
    "Ach, ich wuerde gerne wieder in Freiheit leben koennen...",
    "seufzt: ");
}

void door_opened()
{
  call_out("door_opened2", 2);
}

void door_opened2()
{
  command ("emote jubelt.");
  command ("sag Danke, "+UPPER(TPN)+", dass Du mich befreit hast!");
  // ...
  command ("emote verschwindet in der Dunkelheit.");
  call_out ("remove", 0);
  return;
}

