inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "files.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

#ifdef LOGF
#undef LOGF
#endif
#define LOGF "/d/ebene/log/nkaempfer.kills"

#define UNIQUE
#define PENDEL "/d/seher/woody/obj/pendel"


void create()
{
  object pendel;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId( ({"kaempfer", "nachtkaempfer", "Nachtkaempfer", "NOWIMPY"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Nachtkaempfer");
  SetProp(P_SHORT, "Ein Nachtkaempfer");
  SetProp(P_LONG, "Der Nachtkaempfer ist ein Schattenwesen, dessen "
      "Kampfkraft weithin bekannt ist. Er kann mit einem Mithrilschwert "
      "umgehen wie kein anderer, unter seinen Schwerthieben kann Dein "
      "Leben nur allzuschnell enden. Aus rot gluehenden Augen blickt er "
      "Dich abschaetzend an, sein Koerper behaelt dabei stets eine "
      "erhabene, stolze Haltung.");
  SetProp(P_INFO,
      "Sei auf der Hut, denn der Nachtkaempfer kann wie kein anderer\n"
      "mit dem Schwert umgehen! Manchmal schlaegt er auch oefter\n"
      "damit zu als einem lieb ist.\n");

  AddDetail( ({ "haltung","statur" }),
      "Der Nachtkaempfer behaelt stets seine erhabene Haltung bei." );
  AddDetail( ({ "schattenwesen" }),
      "Schattenwesen bewegen sich meist in der Finsternis." );
  AddDetail( ({ "mithrilschwert", "schwert" }),
      "Das maechtige Mithrilschwert ist die Waffe des Nachtkaempfers, "
      "die er virtuos wie kein anderer zu fuehren vermag." );
  AddDetail( ({ "gesicht" }),
      "Du blickst ins Gesicht des Nachtkaempfers, kannst aber keinerlei "
      "Gesichtszuege erkennen, lediglich die gluehend roten Augen "
      "starren Dich unverwandt an und floessen Dir Angst ein." );
  AddDetail( ({ "auge","augen" }),
      "Seine Augen gluehen rot, vermutlich kann er auch bei Nacht sehen." );
  AddDetail( ({ "koerper" }),
      "Du schaetzt den Nachtkaempfer auf 1,80 Meter, oder etwas mehr. "
      "Sein Koerper wirkt schlank und wendig, aber dennoch sehr "
      "kraeftig." );

  create_default_npc(40+random(3));
  SetProp(P_XP, QueryProp(P_XP)+300000);  // Kaempfer- und Spell-Bonus
  SetProp(P_SIZE, 180+random(11));
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit blossen Haenden", 60, DT_BLUDGEON}) );
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_ALIGN, -400-random(100));
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:0.1,
      DT_LIGHT:0.1,
       DT_HOLY:0.1,
     DT_POISON:-0.25,
     DT_UNHOLY:-0.25 ]) );

  set_living_name("nachtkaempfer");

  SetProp(P_SPELLRATE, 8);

  AddSpell(2, 900,     /* von 1000 runtergesetzt wg. "schnell"-Spell */
    "Der Nachtkaempfer setzt seinen beruehmten Haum-Ichz-Uklump ein!\n",
    "Der Nachtkaempfer attackiert @WEN mit dem beruehmten Haum-Ichz-Uklump!\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(3, 100,
      "Der Nachtkaempfer bewegt sich ploetzlich deutlich schneller.\n",
      "Der Nachtkaempfer bewegt sich ploetzlich deutlich schneller.\n",
      DT_SLASH, "schnell");

  SetAttackChats(6, ({
    "Der Nachtkaempfer pariert Deine Schlaege mit Leichtigkeit.\n",
    "Der Nachtkaempfer taenzelt leichtfuessig um Dich herum.\n",
    "Der Nachtkaempfer wirbelt umher und taucht ploetzlich hinter Dir auf.\n",
    }) );

  // SetProp (P_DIE_MSG, " haucht sein Leben aus.\n");
  SetProp(P_DEFAULT_INFO, "ignoriert Dich oder Deine Frage.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Nachtkaempfer braucht nichts ausser seinem Schwert.\n" }) );

  SUID;
  CLONEME(OBJ("waffe/mithrilschwert"));
  CLONEME(OBJ("ruestung/nachtamulett"));
  // CLONEME(OBJ("ruestung/mithrilring"));
  if( random(100) < 20 ) CLONEME( "/p/armour/armour/mithrilpanzer");
  if( random(100) < 20 ) CLONEME( "/p/armour/helm/mithrilhelm");
  if( random(100) < 20 ) CLONEME( "/p/armour/shield/mithrilschild");
  if( random(100) < 20 ) CLONEME( "/p/armour/bracers/mithrilarmschienen");
  if( random(100) < 20 ) CLONEME( "/p/armour/trousers/mithrilbeinlinge");
  command("zuecke schwert");
  command("trage alles");

#ifdef UNIQUE
  // Unique Pendel
  if ( (sizeof(all_inventory()) <= 4) && (random(47) <= 11) )
  {
    pendel = find_object(ITEMD)->GenerateUnique(PENDEL, 1, 0);
    if (objectp(pendel))
      pendel->move(ME);
  }
#endif
}

varargs void die(int poisondeath)
{
  int direkt;
  object enemy;
  object item;
  object ob;

  enemy = QueryProp(P_KILLER) || TP;
  direkt = extern_call() && (previous_object() != this_object());

  if (enemy) {
    if (item = present("\nzechpreller_quest_11", enemy)) {
      item->Mark(poisondeath);
    }
    if ((item=present("\npaladintaskitem", enemy)) && item->GetTask(12,enemy)) {
      item->SetFlag(0);
    }
  }

  if(objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, TP))) {
    ob->NachtkaempferKilled();
  }

  write_file( LOGF,
      sprintf( "%s: Nachtkaempfer wird gekillt von %s%s.\n",
      dtime(time()), CAP(getuid(enemy)), (direkt ? " (direkt!)" : "") ) );

  ::die(poisondeath);
}

void schnell(object enemy, int damage, mixed dam_type)
{
  if (QuerySkillAttribute(SA_SPEED) <= 100)
    ModifySkillAttribute(ME, SA_SPEED, 150+random(26), 10);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if (!objectp(victim)) return;
  if (killer != ME) return;
}

