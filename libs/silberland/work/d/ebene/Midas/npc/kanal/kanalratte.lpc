*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Eine Kanalratte");
  SetProp (P_LONG, "Eine kleine graue Kanalratte funkelt Dich mit ihren "
      "Augen boese an, als ob Du sie in ihrer Ruhe gestoert haettest. "
      "Offenbar fuehlt sie sich hier unten in den Kanaelen so richtig "
      "zuhause - klar, sonst waere sie ja wohl keine Kanalratte.");
  SetProp (P_INFO, "Eine total normale Kanalratte.\n");
  SetProp (P_NAME, "Kanalratte");
  SetProp (P_GENDER, FEMALE);
  AddId ( ({"ratte", "kanalratte"}) );
  create_default_npc( 5 );
  SetProp (P_HANDS, ({" mit ihren kleinen Pfoten", 10}));
  SetProp (P_ALIGN, random(30)-80);
  SetProp (P_SIZE, 20+random(5));
  SetProp (P_RACE, "Ratte");

  SetProp (P_MSGIN, "huscht herein");
  SetProp (P_MSGOUT, "huscht");

  SetProp (P_MNPC_AREA, KANAL "kanal_");
  SetProp (P_MNPC_WAIT, ({ 10+random(20), 30, 50 }));
  SetProp (P_MNPC_DEFAULTROOM, KANAL "kanal_f5");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

  AddCmd ( ({"unt","untersuch","untersuche","schau","schaue"}), "unt");
}

int unt(string str)
{
  if (!str) return 0;
  if (random(5)) return 0;
  write ("Die Kanalratte lenkt Dich ab.\n");
  return 1;
}

