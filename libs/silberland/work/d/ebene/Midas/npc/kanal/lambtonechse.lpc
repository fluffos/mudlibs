inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"echse","lambtonechse"}) );
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Lambtonechse");
  SetProp (P_SHORT, "Eine gewaltige Lambtonechse");
  SetProp (P_LONG, "Die Lambtonechse ist im Grunde genommen eine Art "
      "zu gross geratener Salamander. Sie ist mit Dermalknochenplatten "
      "bedeckt, die einander ueberlappen und so einen guten Schutz "
      "gegenueber Schlaegen darstellen. Ihr Maul ist von vielen kleinen "
      "Barteln umgeben, aus denen mitunter eine seltsame Fluessigkeit "
      "tropft, vor der Dir etwas ekelt.");
  SetProp (P_ALIGN, -100-random(100));
  SetProp (P_AGGRESSIVE, 1);
  SetProp (P_INFO,"Die Lambtonechse ist imstande, ihre Gegner zu laehmen.\n");
  create_default_npc(26+random(4));
  SetProp (P_XP, QueryProp(P_XP)+100000);  // Spell-Bonus
  SetProp (P_HEAL, -10);
  SetProp (P_SIZE, 150+random(15));
  SetProp (P_RACE, "Echse");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit ihren reissenden Zaehnen", 300, DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:0.3,
      DT_LIGHT:0.3,
       DT_HOLY:0.3,
     DT_POISON:-0.25,
     DT_UNHOLY:-0.25 ]) );

  set_living_name("lambtonechse");

  SetProp (P_SPELLRATE, 20);

  AddSpell(3, 625,
    "Die Lambtonechse trifft Dich hart mit ihrem Schwanz.\n",
    "Die Lambtonechse trifft @WEM hart mit ihrem Schwanz.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  // Paralyse fuer 4-6 Kampfrunden
  AddSpell(2, 250,
    "Die Lambtonechse vergiftet und paralysiert Dich.\n",
    "Die Lambtonechse vergiftet und paralysiert @WEN.\n",
    DT_POISON, "paralyse");

  SetProp (P_DIE_MSG, " verendet qualvoll.\n");
  SetProp (P_MURDER_MSG,
      "Ok, %s, aber sag nicht, ich haette Dich nicht gewarnt!");
  SetProp (P_KILL_MSG,
      "Also wenn Du schon an mir scheiterst...");
  SetProp (P_DEFAULT_INFO, "faucht Dich an.\n");

  SetProp (P_REJECT, ({ REJECT_DROP,
    "Die Lambtonechse ist viel zu ungeschickt, um was zu nehmen!\n" }) );
}

void paralyse(object enemy, int damage, mixed dam_type)
{
  int n;

  n = 4 + random(3);
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, n);        // Paralyse Attacks
  if (!enemy->QueryProp(P_DISABLE_SPELLS))
    enemy->SetProp(P_DISABLE_SPELLS, n);        // Paralyse Spells
  if (random(100) < 25)
    enemy->AddPoison(1);        // zu 25% wirklich vergiften
}

