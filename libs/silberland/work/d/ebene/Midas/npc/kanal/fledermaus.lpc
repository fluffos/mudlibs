/*
** Eine kleine Fledermaus
** ---
** 1997-10-15  Woody
** 2002-12-02  Woody  in kanal-Dir verschoben
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "files.h"

void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("fledermaus");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Fledermaus");
  SetProp (P_SHORT, "Eine kleine Fledermaus");
  SetProp (P_LONG, "Die kleine Fledermaus flattert ganz aufgeregt "
      "um Dich herum und stoesst schrille Laute aus. Irgendwie "
      "verbreitet sie eine gewisse Panik in Dir, staendig fuehlst "
      "Du Dich verfolgt und in Gefahr...");
  SetProp (P_ALIGN, -50-random(50));
  SetProp (P_AGGRESSIVE, 0.5);
  create_default_npc(4+random(3));
  SetProp (P_HEAL, -30);
  SetProp (P_SIZE, 30+random(15));
  // SetProp (P_RACE, "?");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_WIMPY, 30);
  SetProp (P_HANDS, ({" mit ihren spitzen Zaehnen", 120, DT_RIP}) );
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:0.5,
      DT_LIGHT:0.5,
       DT_HOLY:0.5,
     DT_UNHOLY:-0.3 ]) );

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");

  SetProp (P_SPELLRATE, 15);

  AddSpell(1, 222,
    "Die Fledermaus zerkratzt Dir die Hand.\n",
    "Die Fledermaus zerkratzt @WEM die Hand.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 222,
    "Die Fledermaus zerkratzt Dir das Gesicht.\n",
    "Die Fledermaus zerkratzt @WEM das Gesicht.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 160,
    "Die Fledermaus stoesst Dir einen schrillen Schrei entgegen.\n"
    "Du haeltst Dir entsetzt die Ohren zu.\n",
    "Die Fledermaus stoesst @WEM einen schrillen Schrei entgegen.\n",
    DT_SOUND, ([SP_SHOW_DAMAGE:1]) );

  SetProp (P_DIE_MSG, " stuerzt tot zu Boden.\n");
  SetProp (P_KILL_MSG, "Aaaaaaaaaah, frisches Blut!");
  SetProp (P_DEFAULT_INFO, "kann Dich nicht verstehen.\n");

  SetProp (P_MNPC_AREA, KANAL "piazza");
  SetProp (P_MNPC_WAIT, ({ random(5)+5, 10, 5 }));
  SetProp (P_MNPC_DEFAULTROOM, KANAL "piazza_c6");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

  SetProp (P_REJECT, ({ REJECT_DROP,
    "Die Fledermaus kann @WEN nicht halten.\n" }) );

  SUID;
}

