inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#include "../midas.h"


#ifdef LOGF
#undef LOGF
#endif
#define LOGF "/d/ebene/log/landar.kills"


void create()
{

  if (!is_clone(this_object())) return;

  ::create();

  create_default_npc(18);
  // set_living_name("landar");         // nicht noetig -> wg. P_NAME
  AddId ( ({"landar","haendler","\nlandar", "NOWIMPY"}) );
  SetProp (P_LONG, "Vor Dir steht Landar, der Haendler.\n"
    "Er ist gut gebaut, wenngleich nicht so kraeftig wie Max, der Wirt. "
    "Den ganzen Tag ueber ist er beschaeftigt, Waren anzukaufen, "
    "einzusortieren, Kisten mit verschiedenstem Inhalt herumzuschieben "
    "und auch wieder zu verkaufen, natuerlich mit maximalem Profit. "
    "Er hat eine kleine Brille auf der Nase und "
    "laechelt Dich freundlich an.");

  SetProp(P_NAME, "Landar");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Landar, der Haendler");
  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) + 150);        // Kleiner Bonus
  SetProp(P_SIZE, 176);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinen starken Haenden", 120, DT_BLUDGEON}) );

  AddDetail( ({ "gesicht" }),
      "Landar hat ein kraeftiges noch faltenfreies Gesicht." );
  AddDetail( ({ "haar", "haare" }),
      "Landar hat dunkle Haare mit einem leichten grauen Ansatz." );
  AddDetail( ({ "nase" }),
      "Auf Landars Nase, die uebrigens voellig normal gebaut ist, "
      "sitzt seine kleine Brille, die lustig auf- und abhuepft, "
      "wenn er spricht." );
  AddDetail( ({ "brille" }),
      "Frag ihn doch mal danach!" );
  AddDetail( ({ "auge", "augen" }),
      "Landars blaugraue Augen blicken Dich freundlich an." );
  AddDetail( ({ "ohr", "ohren", "mund", "kinn", "hals" }),
      "Hat er auch!" );
  AddDetail( ({ "arm", "arme" }),
      "Landar hat kraeftige Arme, wohl vom vielen Kisten stapeln." );
  AddDetail( ({ "hand", "haende" }),
      "Landars Haende koennen kraeftig zupacken, wenns sein muss." );
  AddDetail( ({ "bein", "beine" }),
      "Landar steht auf kraeftigen Beinen." );
  AddDetail( ({ "fuss", "fuesse" }),
      "Du kannst Landars Fuesse nicht erkennen, "
      "da er hinter der Kassa steht." );
  AddDetail( ({ "bauch" }),
      "Landar hat zwar viel, aber sicher keinen Bauch. Er ist relativ "
      "schlank." );
  AddDetail( ({ "ausruestung" }),
      "Landar hat nur die noetigste Ausruestung, er muss ja hier in der "
      "Regel keine Kaempfe bestehen." );
  /*
  AddDetail( ({ }),
      "" );
  */

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  // Zeug clonen
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/p/armour/trousers/lederhose");
  command ("trage hemd");
  command ("trage hose");

  SetProp(P_SPELLRATE,15);

  AddSpell(1, 220,
       "Landar versetzt Dir einen kraeftigen Faustschlag.\n",
       "Landar versetzt @WEM einen kraeftigen Faustschlag.\n",
    DT_BLUDGEON, ([ SP_SHOW_DAMAGE:1 ]) );
  AddSpell(1, 275,
       "Landar wirft eine kleine Holzkiste nach Dir und trifft Dich hart.\n",
       "Landar trifft @WEN mit einer kleinen Holzkiste hart.\n",
    DT_BLUDGEON, ([ SP_SHOW_DAMAGE:1 ]) );

  SetChats(1, ({
    "Landar fragt: Moechtest Du nicht etwas kaufen?\n",
    "Landar isst einen Schokoriegel.\n",
    "Landar laechelt Dich an.\n",
    "Landar sagt: Mein Sortiment ist unuebertroffen!\n",
    "Landar murmelt: Diese Zwerge, immer wollen sie feilschen...\n",
    "Landar sortiert einige Kisten nach dem Hanoi'schen Prinzip um.\n",
    "Landar fragt: Kennst Du meinen Freund Max?\n",
    "Eine Maus huscht am Boden vorbei.\n",
    "Landar flucht: Ich muss wohl mal Mausefallen aufstellen!\n",
    "Landar rueckt seine Brille zurecht und schaut Dich erwartungsvoll an.\n",
  }) );

  SetAttackChats(6, ({
    "Landar ruft: Soldaten! Hilfe!\n",
    "Landar schlaegt wild um sich.\n",
    "Landar tritt Dich in den Allerwertesten.\n",
    "Landar nimmt den naechstbesten Stock und wirft ihn nach Dir.\n",
  }) );

  SetProp (P_DIE_MSG, " sinkt tot zu Boden.\n");
  SetProp (P_DEFAULT_INFO,
      ({
          "antwortet: Am besten siehst Du einfach in der Liste nach!\n",
          "ist zu sehr mit Einsortieren beschaeftigt, um Dir zuzuhoeren.\n",
          "sagt: Dazu faellt mir leider gerade nichts ein.\n",
          "sagt: Frag mal Max dazu!\n",
          "zuckt mit den Schultern.\n",
          "sagt: Ich hab nur das, was Du in der Liste siehst!\n",
      }) );

  AddInfo ( ({ "ware", "waren", "angebot", "liste", "sortiment" }),
      "Mein Sortiment ist das beste, das es weit und breit gibt! "
      "Du kannst es Dir einfach mit 'zeige' ansehen. Wenn Dir "
      "das zuviel auf einmal ist oder Du gezielt nach etwas suchst, kannst "
      "Du Dir auch explizit "
      "'panzer', 'helme', 'amulette', 'ringe', 'handschuhe', 'umhaenge',"
      "'schuhe', 'schilde', 'hosen', 'armschienen', 'guertel',"
      "'schwerter/rapier', 'aexte', 'stoecke/knueppel', 'speere',"
      "'messer/dolche', 'peitschen', 'morgensterne/ketten(waffen)',"
      "'boegen', 'munition', 'einhaender', 'bi-/zweihaender',"
      "'ruestungen', 'waffen', 'verschiedenes', 'behaelter',"
      "oder 'jede(n/s) <gegenstand>' zeigen lassen. "
      "Puh, ganz schoen anstrengend, das alles aufzuzaehlen!"
      "@@i_waren@@",
      "sagt: " );
  AddInfo ( ({ "laden" }),
      "Ja, Du befindest Dich hier in einem Laden. Naemlich meinem!",
      "sagt stolz: " );
  AddInfo ( ({ "waffen", "ruestungen" }),
      "Ich habe nur die allerbesten Waffen und Ruestungen! Ueberzeuge "
      "Dich doch einfach selbst!",
      "prahlt: " );
  AddInfo ( ({ "geld" }),
      "Geld ist knapp, ich kann Dir leider auch keins schenken!",
      "jammert: " );
  AddInfo ( ({ "kaufen", "verkaufen", "schaetzen" }),
      "Kaufen und verkaufen ist mein Geschaeft! Aber keine Angst, "
      "ich wuerde Dich niemals uebers Ohr hauen wie dieser Gihr "
      "Heuchlox und das andere Pack aus dem Sueden! "
      "Wenn Du etwas kaufen moechtest, so tippe 'kaufe <nummer>' oder "
      "'kaufe <gegenstand>', willst Du etwas verkaufen... genau! "
      "'verkaufe <gegenstand>', erraten! Und wenn Du einfach nur wissen "
      "moechtest, wieviel ich Dir fuer einen Gegenstand geben wuerde, "
      "lass ihn doch von mir 'schaetz'en!",
      "sagt: " );
  AddInfo ( ({ "maeuse", "maus" }),
      "Irgendwo muss sich hier eine Maus eingenistet haben! Ich werde "
      "wohl demnaechst mal eine Mausefalle aufstellen muessen.",
      "flucht: " );
  AddInfo ( ({ "falle", "mausefalle" }),
      "Die besten gibt es in Felonia, kein Wunder, dort plagen sich die "
      "stinkenden Zwerge ja auch mit dem Problem herum.",
      "grinst fies: " );
  AddInfo ( ({ "geschenk" }),
      "Hast Du eins fuer mich?",
      "fragt: " );
  AddInfo ( ({ "hilfe" }),
      "Danke, ich komme ganz gut allein zurecht.",
      "sagt: " );
  AddInfo ( ({ "regal", "regale" }),
      "Die Regale hier habe ich alle selbst gezimmert!",
      "sagt voll Stolz: " );
  AddInfo ( ({ "schild" }),
      "Wenn Du das Schild an der Tuer meinst: einfach lesen! Wenn Du einen "
      "Schild fuer den Kampf suchst: Schau Dir mein Angebot an!",
      "sagt: " );
  AddInfo ( ({ "tafel" }),
      "Habe ich nicht eine schoene Handschrift?",
      "fragt: " );
  AddInfo ( ({ "dose" }),
      "In der Dose ist Kaffee, aber nur fuer den Eigenbedarf!",
      "lacht: " );
  AddInfo ( ({ "zigarette" }),
      "Nein Danke!",
      "sagt: " );
  AddInfo ( ({ "gilde" }),
      "Die findest Du nur ein paar Schritte suedlich von mir!",
      "antwortet: " );
  AddInfo ( ({ "woody" }),
      "Oh Gott! Ist er wieder auf Kontrollgang?",
      "sagt panisch: " );
  AddInfo ( ({ "failin" }),
      "Failin hat mir seinerzeit geholfen, einen schoenen Namen zu finden!",
      "laechelt: " );
  AddInfo ( ({ "kassa", "kasse" }),
      "Eine alte Kasse, ist sie nicht schoen? Ich finde, sowas gehoert "
      "einfach in einen Laden, auch wenn ich persoenlich eh alles im "
      "Kopf rechne - das hab ich sogar Max beigebracht!",
      "sagt: " );
  AddInfo ( ({ "zwergen", "zwerge", "zwerg" }),
      "Wenn sie sich oefter waschen wuerden, waeren sie ja ganz in Ordnung!",
      "grinst: " );
  AddInfo ( ({ "elfen", "elf" }),
      "Bisschen eingebildet, aber sonst ganz nett.",
      "sagt: " );
  AddInfo ( ({ "oger", "troll", "trolle", "trollen" }),
      "Oger und Trolle mag ich persoenlich gar nicht! Aber was solls, "
      "ich bin Geschaeftsmann.",
      "sagt: " );
  AddInfo ( ({ "dunkelelfen", "dunkelelf" }),
      "Die Dunkelelfen sind mir immer ein bisschen suspekt.",
      "sagt: " );
  AddInfo ( ({ "hobbit", "hobbits" }),
      "Ausgesprochen nette Kerle!",
      "sagt: " );
  AddInfo ( ({ "mensch", "menschen" }),
      "A Mensch mecht i sei... ach, bin ich doch! :)",
      "singt: " );
  AddInfo ( ({ "feen", "fee" }),
      "Suesse Dinger, manche zumindest!",
      "sagt verzueckt: " );
  AddInfo ( ({ "geschaeft", "geschaefte" }),
      "Das Geschaeft geht gut, danke der Nachfrage!",
      "sagt: " );
  AddInfo ( ({ "gewinn", "verlust", "gewinne", "verluste" }),
      "Verzeihung, Fremder, doch das ist ein Geschaeftsgeheimnis!",
      "sagt: " );
  AddInfo ( ({ "geschaeftsgeheimnis" }),
      "Auch ich habe sowas!",
      "sagt: " );
  AddInfo ( ({ "hose", "lederhose" }),
      "Sie haelt mich schoen warm.",
      "sagt: " );
  AddInfo ( ({ "arbeitshemd", "hemd" }),
      "Schick, nicht wahr?",
      "sagt: " );
  AddInfo ( ({ "gihr heuchlox", "gihr", "heuchlox" }),
      "Ein kleiner gieriger Zwerg, der zweifelhafte Geschaefte mit "
      "Edelsteinen betreibt! Besser, Du verkaufst sie hier bei mir!",
      "sagt: " );
  AddInfo ( ({ "max" }),
      "Max ist ein alter Kumpel von mir, ab und zu besuche ich ihn auch!",
      "sagt: " );
  AddInfo ( ({ "kneipe" }),
      "Die Kneipe ist ein paar Haeuser weiter westlich! Wenn Du Max "
      "siehst, richte ihm bitte einen schoenen Gruss von mir aus!",
      "sagt: " );
  AddInfo ( ({ "brille" }),
      "Die hab ich mir unlaengst machen lassen muessen, als ich die "
      "Preislisten nicht mehr lesen konnte...",
      "seufzt: " );
  AddInfo ( ({ "kramladen" }),
      "Der taugt nicht viel, nur uraltes Zeug!",
      "sagt veraechtlich: " );
  AddInfo ( ({ "hanoi" }),
      "Ich schlichte Kisten immer streng nach Hanoi: man darf nie eine "
      "groessere Kiste auf eine kleinere stapeln!",
      "zwinkert: " );
  /*
  AddInfo ( ({ "" }),
      "",
      "sagt: " );
  AddInfo ( ({ "" }),
      "",
      "sagt: " );
  AddInfo ( ({ "" }),
      "",
      "sagt: " );
  AddInfo ( ({ "" }),
      "",
      "sagt: " );
  */

  AddLibrary( NPC "midas.lib", 3 );

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Landar freut sich und sagt: Alle anderen wollen immer bloss Geld!\n" }) );

  AddCmd ( ({"feilsch", "feilsche"}), "feilsche");

}


string i_waren()
{
  if (find_call_out("co_erg2") != -1)   // einmal erklaeren reicht :)
    return "";
  while (remove_call_out("co_erg") != -1) /* continue */ ;
  call_out("co_erg", 4);
  return "";
}

public void co_erg()
{
  if (!environment()) return;
  environment()->Message( "Landar holt Luft.\n", MSGFLAG_SOUND );
  call_out("co_erg2", 6);
}

public void co_erg2()
{
  if (!environment()) return;
  environment()->Message(
      break_string(
        "Du kannst Dir ausserdem mit 'unt <gegenstand> in laden' oder "
        "'unt <nummer>' einen bestimmten Gegenstand genauer "
        "anzeigen lassen. Vielleicht kann ich Dir dabei dann "
        "auch sagen, ob eine bestimmte Ruestung auch fuer Dich "
        "bestimmt nicht geeignet ist!", 78, Name() + " ergaenzt: "),
      MSGFLAG_SOUND );
}


int feilsche(string str)
{
  string wem;

  notify_fail("Mit wem willst Du feilschen?\n");
  if (!stringp(str)) return 0;
  if (!sscanf(str, "mit %s", wem)) return 0;
  if (!id(wem))
    return notify_fail("Mit " + capitalize(wem) +
        " kannst Du hier nicht feilschen!\n"), 0;

  write("Du versuchst, mit Landar zu feilschen.\n");
  environment()->Message(
    TP->Name() + " versucht, mit Landar zu feilschen.\n",
    MSGFLAG_SOUND | MSGFLAG_NO_TP );

  environment()->Message(
      "Landar laechelt milde.\n" +
      break_string(
        "Netter Versuch, " + TP->Name() +
        ", aber mit mir kann man nicht feilschen, entweder "
        "Du akzeptierst meinen Preis, oder es wird nichts aus dem "
        "Geschaeft! Tut mir leid, aber es sind harte Zeiten...", 78,
        Name() + " sagt: "),
      MSGFLAG_SOUND );
  return 1;
}


varargs void die(int p)
{
  int direkt;
  object item;

  direkt = extern_call() && (previous_object() != this_object());
  write_file (LOGF,
      dtime(time())+": Landar wird gekillt von "+CAP(getuid(TP))+
      (direkt ? " (direkt!).\n" : ".\n"));
  ::die(p);
}

