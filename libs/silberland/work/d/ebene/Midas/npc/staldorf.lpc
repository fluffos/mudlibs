inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../midas.h"

// *ARGL* in ebene.h ist hinten ein unnoetiger Strichpunkt!!!
// -> Probs beim compile vor if...else...
//
#undef CLONEME
#define CLONEME(x) clone_object(x)->move(this_object())

void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"staldorf"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Staldorf");
  SetProp (P_SHORT, "Staldorf");
  SetProp (P_LONG, "Du siehst Staldorf, einen alten Mann vor Dir, "
      "der den ganzen lieben Tag nichts besseres zu tun hat, als von "
      "oben von einem Balkon das Geschehen zu beobachten und bissige "
      "Kommentare zu machen.\nEr ist Freund von Watler.\n");

  SetProp (P_ALIGN, -50);
  create_default_npc(10);
  SetProp (P_SIZE, 170);
  SetProp (P_RACE, "Mensch");
  SetProp (P_MAX_HANDS, 2);

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  //   alt,heruntergekommen,duenn,klein,gutaussehend,
  //   elegant,jung,sportlich,dick,gross
  //
  // Ausruestung:
  // Hose
  if ( random(100) < 20 ) {
    CLONEME ("/p/armour/trousers/hose");
    if ( random(100) < 50 ) CLONEME ("/p/armour/belt/guertel");
  }
  // Hemd/Weste/Bluse
  if ( random(100) < 20 ) {
    if (random(100) < 50) CLONEME ("/p/armour/armour/hemd");
    else CLONEME ("/p/armour/armour/weste");
  }
  // Hut (passt auch nicht jedem Buerger...)
  if (random(100) < 10)
    CLONEME ("/p/armour/helm/hut");

  command ("trage alles");

  SetAttackChats(6, ({
      ME->Name(WER,1)+" ruft verzweifelt nach Watler.\n",
      ME->Name(WER,1)+" schreit: Keeeeeeeeeeermet!!\n" }) );

  // SetProp (P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp (P_DEFAULT_INFO,
      ({ "lacht nur haemisch.",
         "hoert Dir nicht zu.", }) );
  AddInfo ( ({"buerger","buergerin"}), "nickt.\n");

  AddLibrary( NPC "midas.lib", 3 );

  SetProp( P_REJECT, ({ REJECT_KEEP,
      ME->Name(WER,1)+" bedankt sich artig fuer das Geschenk.\n" }) );
}
