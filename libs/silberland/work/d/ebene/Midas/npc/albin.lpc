public void init() {
  ::init();


  if(objectp(present(RANGER_TASK_SCHNITZELJAGD, TP))) {
    call_out("greet_ranger", 0, TP);
  }

  return;
}

public void greet_ranger(object pl) {
  command_me("sag Verschwinde, "+pl->Name(WER)+"! Mit eurem Pack will ich nix zu tun haben! Ich verrate gar nichts!");
  tell_object(pl, BS("Albin wirft einen Kaese nach dir."));
  tell_room(ENV(TO), BS("Albin wirft einen Kaese nach "+pl->Name(WEM)+"."), ({pl}));
  return;
}

