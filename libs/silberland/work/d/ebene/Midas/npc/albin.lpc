void reset()
{
  string *uids;
  object player;
  int i;

  :: reset();

  if(!is_clone(TO)) return;

  if(geld)
  {
    "p/daemon/zentralbank"->PayIn(geld, 100);
    geld = 0;
    tell_room(ENV(TO),"Albin schreibt etwas in seine Buecher.\n");
  }

  uids = KMASTER->QueryDoneCheese() - gerufen;

  i = sizeof(uids);
  while(i--)
  {
    if(player=find_player(uids[i]))
    {
      player->Message(TO->Name(WER)+" teilt Dir mit: Ich habe Deinen Kaese "
                      "fertig gestellt.\n", MSGFLAG_TELL);
      gerufen += ({ uids[i] });
    }
  }

}

string info_bestellung(string str)
{
  string s;

  switch(KMASTER->QueryCheese(getuid(TP)))
  {
    case 0 :
    case 3 :
      s = "Du hast bei mir noch keinen Kaese bestellt. ";
      break;

    case 1 :
      s = "Deine Kaese ist noch nicht fertig. Der muss noch reifen. ";
      break;

    case 2 :
      s = "Dein Kaese ist fertig. Du kannst ihn gleich mitnehmen.";
      break;

    default :
      s = "Also da ist wohl in der Produktion was schiefgelaufen. Am besten "
          "beschwerst Du Dich gleich bei der Geschaeftsfuehrerin. Das ist "
          "Ronja. ";
      break;
  }

  return BS(s);
}

string info_sex(string str)
{
  string s;

  if(TP->QueryProp(P_GENDER) == FEMALE)
  {
    s = "schaut Dich luestern an.";
  }
  else
  {
    s = "schaut Dich abfaellig an.";
  }

  return s;
}

int Defend(int dam, mixed dam_types, mixed spell, object enemy)
{
  if(!random(3) )
  {
    tell_room(MENV, Name(WER,1)+" weicht dem Angriff geschickt aus.\n");
    ::Defend(dam/5, dam_types, spell, enemy);
  }
  else
    ::Defend(dam, dam_types, spell, enemy);
}

void spell_heilen(object enemy, int damage, mixed dam_type)
{
  int n;

  switch(random(100))
  {
    case  0 .. 45 : n = 10; break;
    case 46 .. 70 : n = 20; break;
    case 71 .. 90 : n = 30; break;
    case 91 .. 97 : n = 40; break;
    case 98 .. 99 : n = 50; break;
    default       : n = 25; break;
  }

  heal_self(n);
}

string missing(object player)
{
  string s;

  switch(KMASTER->QueryMissing(getuid(player)))
  {
    case MISSING_NOTHING :
      s = "Da kann ich ja jetzt gleich mit dem Kaese machen anfangen. Das "
          "wird aber noch ein kleines Weilchen dauern. ";
      gerufen -= ({ getuid(player) });
      break;

    case MISSING_MILK :
      s = "Jetzt fehlt mir nur noch die Milch. Dann kann ich sofort "
          "loslegen. ";
      break;

    case MISSING_LAB :
      s = "Jetzt brauche ich nur noch etwas Lab, dann kann ich mit der "
          "Kaesezubereitung sofort loslegen. ";
      break;

    case MISSING_MONEY :
      s = "Einen Kaese herzustellen kostet "+KAESEKOSTEN+" Muenzen, die Du "
          "mir noch nicht bezahlt hast. ";
      break;

    case MISSING_MILK_LAB :
      s = "Um Kaese zu machen, brauche ich aber noch Milch und etwas Lab. ";
      break;

    case MISSING_MILK_MONEY :
      s = "Um Kaese herzustellen, brauche ich noch Milch. Ausserdem kostet "
          "Dich das "+KAESEKOSTEN+" Muenzen.";
      break;

    case MISSING_LAB_MONEY :
      s = "Zur Kaesezubereitung fehlt mir jetzt noch etwas Lab. Insgesamt "
          "wird Dich ein Kaese von mir dann aber noch "+KAESEKOSTEN+" Muenzen "
          "kosten. ";
      break;

    case MISSING_MILK_LAB_MONEY :
      s = "Zur Kaesezubereitung brauche ich Milch und etwas Lab. Das ganze "
          "kostet dann "+KAESEKOSTEN+" Muenzen, wenn ich einen Kaese "
          "herstellen soll. ";
      break;

    default :
      s = "Da ist irgendwo ein Fehler in der Verwaltung. Am besten beschwerst "
          "Du Dich gleich bei der Geschaeftsfuehrerin. Das ist Ronja. ";
      break;
  }

  return s;
}

void giveback(object ob,object player)
{
  tell_object(player,"Albin gibt Dir "+ob->name(WEN,1)+" zurueck.\n");
  ob->move(player,M_SILENT|M_NOCHECK);
  return;
}

void givebackmoney(int num,object player)
{
  tell_object(player,
    "Albin gibt Dir "+num+(num==1?" Muenze":" Muenzen")+" zurueck.\n"
  );
  player->AddMoney(num);
  return;
}

void handlecan(object ob,object player)
{
  string s;

  tell_room(ENV(TO),"Albin und "+player->Name()+" sind in ein Gespraech "
                    "verwickelt.\n",({player}));

  if(!ob->QueryStat())
  {
    tell_object(player,BSI("Was soll ich denn mit einer leeren Milchkanne?",
                           "Albin fragt verwundert: "));
    giveback(ob,player);
    return;
  }

  if(KMASTER->QueryCheese(getuid(player)))
  {
    tell_object(player,BSI("Tut mir leid, "+player->Name()+", aber ich habe "
                           "im Moment so viel zu tun, dass ich keine Auftraege "
                           "mehr annehmen kann.","Albin sagt bedauernd: "));
    giveback(ob,player);
    return;
  }

  if(KMASTER->QueryMilk(getuid(player)))
  {
    s  = "Du hast mir doch schon Milch gebracht. "+missing(player);
    tell_object(player,BSI(s,"Albin sagt: "));
    giveback(ob,player);
  }
  else
  {
    WRITELOG(TPUID+" gibt Albin die Milchkanne : "+ob->QueryStat());

    KMASTER->SetMilk(getuid(player),ob->QueryStat());
    ob->remove();

    s = "Ah, ja. Aus dieser Milch kann ich ganz bestimmt einen prima Kaese "
        "machen. "+missing(player);

    tell_object(player,BSI(s,"Albin sagt: "));
  }

  return;
}

void handlelab(object ob,object player)
{
  string s;

  tell_room(ENV(TO),"Albin und "+player->Name()+" sind in ein Gespraech "
                    "verwickelt.\n",({player}));

  if(KMASTER->QueryCheese(getuid(player)))
  {
    tell_object(player,BSI("Tut mir leid, "+player->Name()+", aber ich habe "
                           "im Moment so viel zu tun, dass ich keine Auftraege "
                           "mehr annehmen kann.","Albin sagt bedauernd: "));
    giveback(ob,player);
    return;
  }

  if(KMASTER->QueryLab(getuid(player)))
  {
    s  = "Du hast mir doch schon Lab gebracht. "+missing(player);
    tell_object(player,BSI(s,"Albin sagt: "));
    giveback(ob,player);
  }
  else
  {
    WRITELOG(TPUID+" gibt Albin das Lab");
    ob->remove();
    KMASTER->SetLab(getuid(player));

    s = "Ah, ja. Natuerliches Lab, das riecht man schon. Das wird bestimmt "
        "ein exzellenter Kaese. "+missing(player);

    tell_object(player,BSI(s,"Albin sagt: "));
  }

  return;
}

void handlemoney(object ob,object player)
{
  string s;
  int num;

  tell_room(ENV(TO),"Albin und "+player->Name()+" sind in ein Gespraech "
                    "verwickelt.\n",({player}));

  num = ob->QueryProp(P_GIVEN_AMOUNT);
//  DB(sprintf("%O %d %d %d",ob,num,KAESEKOSTEN,ob->QueryProp(P_GIVEN_AMOUNT)));
  ob->remove();

  if(num < KAESEKOSTEN)
  {
    tell_object(player,BSI("Was soll ich mit "+num+
                           (num==1?" Muenze":" Muenzen")+"? Wenn ich Dir "
                           "einen Kaese machen soll, dann kostet das "
                           +KAESEKOSTEN+" Muenzen.","Albin meint: "));
    givebackmoney(num,player);
    return;
  }

  if(KMASTER->QueryCheese(getuid(player)))
  {
    tell_object(player,BSI("Tut mir leid, "+player->Name()+", aber ich habe "
                           "im Moment so viel zu tun, dass ich keine Auftraege "
                           "mehr annehmen kann.","Albin sagt bedauernd: "));
    givebackmoney(num,player);
    return;
  }

  if(KMASTER->QueryMoney(getuid(player)))
  {
    s  = "Du hast mir doch schon "+KAESEKOSTEN+" Muenzen gegeben. "
         +missing(player);
    tell_object(player,BSI(s,"Albin sagt: "));
    givebackmoney(num,player);
  }
  else
  {
    WRITELOG(TPUID+" gibt Albin das Geld");
    geld += KAESEKOSTEN;
    KMASTER->SetMoney(getuid(player));

    if(num == KAESEKOSTEN)
    {
      s = "Ok, ich werde dann einen Kaese fuer Dich machen. "+missing(player);
    }
    else
    {
      num -= KAESEKOSTEN;
      s = "Wenn ich einen Kaese fuer Dich machen soll, dann kostet das "
          +KAESEKOSTEN+" Muenzen. Du bekommst also noch etwas Geld "
          "zurueck. "+missing(player);
      givebackmoney(num,player);
    }
    tell_object(player,BSI(s,"Albin sagt: "));
  }

  return;
}

void give_notify(object ob)
{
  if(ob->id("\nKAESEMILCHKANNE"))
  {
    handlecan(ob,TP);
    return;
  }

  if(ob->id("\nKAESELADENLAB"))
  {
    handlelab(ob,TP);
    return;
  }

  if(ob->id("geld"))
  {
    handlemoney(ob,TP);
    return;
  }

  return ::give_notify(ob);
}

varargs void die(int poisondeath)
{
  object enemy;
  object ob;

  if (enemy = QueryProp(P_KILLER))
  {
    if ( ob = present("\nzechpreller_quest_11", QueryProp(P_KILLER)) )
    {
      WRITELOG(Name(WER,1)+" wurde von "+CAP(getuid(enemy))+" umgebracht (als Zechpreller-Gildenaufgabe 11 erkannt)");
      ob->Mark(poisondeath);
    }
    else
    {
      WRITELOG(Name(WER,1)+" wurde von "+CAP(getuid(enemy))+" umgebracht");
    }
  }

  if(objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, TP))) {
    ob->AlbinKilled();
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)WRITELOG(Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht (XP-Verlust : "+lostexp+")");
  return;
}

