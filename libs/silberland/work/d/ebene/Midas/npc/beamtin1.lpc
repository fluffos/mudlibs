#include "../midas.h"

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Die Beamtin Friedericke von Plapperia");
  SetProp(P_LONG,
    "Friedericke von Plapperia"
  );

  AddId( ({"beamtin","friedericke","friedericke von plapperia","\nBEAMTIN2"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Friedericke von Plapperia");
  SetProp(P_ALIGN, 80+random(30));

  create_default_npc(10+random(3));
  SetProp(P_SIZE, 160+random(20));
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit ihren Haenden", 50, DT_BLUDGEON}) );

  SUID;

  SetProp(P_DIE_MSG,
    " aechzt: Wenn ich doch meinen Lippenstift mitnehmen koennte!\n"
  );

  SetProp (P_DEFAULT_INFO,
      ({"sagt: Dafuer bin ich nicht zustaendig.\n"
       }));

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Friedericke sagt: Dafuer hab ich keinen Platz in meiner Handtasche.\n"
  }) );

}


