/*
** Werner aus der Tierhandlung
**
*/

inherit "std/npc";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../midas.h"

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Werner aus der Tierhandlung");
  SetProp(P_LONG, 
	  BS("Das ist Werner. Ein kleiner, aelterer Mensch, dessen "
	     "Herz einzig und allein den Tieren in seiner Tierhandlung "
	     "gehoert. Er kuemmert sich muehevoll um all seine Hunde, "
	     "Katzen, Hamster etc."));
  SetProp(P_NAME, "Werner");
  SetProp(P_GENDER, MALE);
  AddId(({"werner","besitzer","NOWIMPY","NOCONRTOL","SKILL_NOLEARN","NO_MUMMY"}));
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen alten Haenden", 150}));
  SetProp(P_ALIGN, 100);
  SetProp(P_SIZE, 155);
  SetProp(P_RACE, "Mensch");
  SetProp(P_ARTICLE, 0);
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Werner hat auch so schon genug zu tun...\n"}));
  
  AddInfo(DEFAULT_INFO, "ist grad ziemlich beschaeftigt mit seinen Tieren.\n");
  
  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");
  
  AddLibrary(NPC "midas.lib", 3);
  
  SetChats(2, 
	   ({"Werner wuselt umher, um einen Hund zu fuettern.\n",
	       "Werner krault einen Hund hinterm Ohr.\n",
	       "Werner wuselt umher, um eine Katze zu fuettern.\n",
	       "Werner nimmt eine Katze auf den Arm und streichelt sie.\n",
	       "Werner wuselt umher, um ein Meerschwein zu fuettern.\n",
	       "Werner spielt vergnuegt mit einem Meerschwein herum.\n",
	       "Werner wuselt umher, um einen Vogel zu fuettern.\n",
	       "Werner neckt einen vergnuegt quietschenden Vogel.\n",
	       "Werner wuselt von einem Kaefig zum anderen.\n",
	       "Werner laechelt Dich an.\n",
	       "Werner fragt Dich: Willst Du mir nicht eines meiner "
	       "Tierchen abkaufen?\n"}));
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;
  
  if(touch)
    call_out("reaction", 0, TP,
	     "sagt: Bitte lass mich.",
	     "sagt: Bitte lass mich.");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
