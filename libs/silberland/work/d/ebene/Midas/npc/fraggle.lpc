inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../midas.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein Fraggle");
  SetProp (P_LONG, "Iiiih, ein kleiner, ekliger Fraggle!\n");
  SetProp (P_INFO, "Dieser Fraggle scheint extrem boese zu sein.\n");
  SetProp (P_NAME, ({"Fraggle", "Fraggles", "Fraggle", "Fraggle"}) );
  SetProp (P_GENDER, MALE);
  AddId ("fraggle");
  create_default_npc( 1 );
  SetProp (P_HANDS, ({" mit seinen ekligen Pfoten", 10}));
  SetProp (P_ALIGN, -300);
  SetProp (P_SIZE, 30+random(10));
  SetProp (P_RACE, "Fraggle");
  SetProp (P_FORCE_MURDER_MSG, 1);
  SetProp (P_FOOD, 0);
  SetProp (P_MURDER_MSG,
      "Das naechste Mal bohr ich Dir ein Loch ins Knie, %s!");
  SUID;
  CLONEME(OBJ("div/cookie"));
  CLONEME(OBJ("div/cookie"));
  if (random(2))
    CLONEME(OBJ("div/cookie"));
  if (random(2))
    CLONEME(OBJ("div/cookie"));
}

void heart_beat()
{
  if (InFight()) command("iss cookie");
  ::heart_beat();
}

