// define's
#define SAVEFILE "/d/ebene/Midas/nikolo/save/gaben.sav"
#define LOGFILE "/d/ebene/Midas/nikolo/log/nikolo.log"
#define OBJDIR "/d/ebene/Midas/nikolo/obj/"

// global data
mapping bekommen = ([ ]);

// forward declarations
mixed inf_sackerl(string answer);
mixed inf_bekommen(string answer);
void loadlist();
void savelist();


void init()
{ 
  ::init();

  if ( TP->name() == "Max" && find_call_out("max") == -1)
    call_out("max", 0);
  else if (find_call_out("hallo") == -1)
    call_out("hallo",0);

  if ( TP->name() == "Landar"&& find_call_out("landar") == -1)
    call_out("landar", 0);
  else if (find_call_out("hallo") == -1)
    call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV) && !InFight())
    tell_room(MENV, "Der Nikolo begruesst Dich freundlich.\n");
}
 
  
void create()
{
  if (!is_clone(TO)) return;

  ::create();
  seteuid(getuid());
  loadlist();

  SetProp(P_SHORT, "Der Nikolo");
  SetProp(P_LONG,
      "Der Nikolo ist ein alter, stattlicher Mann mit langen, "
      "schlohweissen Haaren. Seine rehbraunen Augen strahlen eine "
      "enorme Guete aus. Auch sein freundliches Laecheln wirkt "
      "trotz des langen Bartes sehr warmherzig. Er ist in ein edles, "
      "rotgoldenes Gewand gehuellt und traegt einen Nikolohut. "
      "Ein grosser Sack mit Geschenken ruht auf seinen Schultern, "
      "in seiner linken Hand haelt er einen langen Stab.");
  SetProp(P_NAME, "Nikolo");
  SetProp(P_GENDER, MALE); 
  AddId( ({"nikolo","nikolaus","mensch","mann"}) );
  create_default_npc(100);
  SetProp(P_HANDS, ({" mit seinen uralten Haenden",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 188);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_MATERIAL, MAT_MISC_LIVING);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MSGIN, "kommt laechelnd herein");
  SetProp(P_MSGOUT, "geht laechelnd");
  SetProp(P_MMSGIN, "entsteht aus einer Nebelschwade");
  SetProp(P_MMSGOUT, "verschwindet in einer Rauchwolke");
  SetProp(P_NOATTACK, "lacht: Ich bin unsterblich!");
  SetProp(P_MNPC_AREA, ({
          "/d/ebene/Midas/room/room",
          "/d/ebene/Midas/room/kneip",
          "/d/ebene/Midas/room/laden",
          "/d/ebene/Midas/room/post",
        }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "/d/ebene/Midas/room/room_a5" );
  SetProp(P_MNPC_FLAGS,
      MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 30, 40, 50}) );
  SetProp(P_DEFAULT_INFO,
      "sagt: Nicht boese sein, aber ich habe momentan keine Zeit.\n");
  SetProp( P_REJECT,
      ({ REJECT_GIVE,
         "Der Nikolo sagt: Danke, aber ich hab schon genug Geschenke!\n" }) );

  SetChats(1, ({ "Der Nikolo laechelt Dich freundlich an.\n",
		 "Der Nikolo fragt: Hast Du schon ein Geschenk bekommen?\n",
		 "Der Nikolo rueckt seinen grossen Leinensack zurecht.\n",
		 "Der Nikolo zwinkert Dir freundlich zu.\n",
		 "Der Nikolo streicht ueber seinen Bart.\n",
		 "Der Nikolo sagt: Bald ist Weihnachten!\n",
		 "Der Nikolo blickt Dich freundlich an.\n"}));

  AddDetail( ({"augen"}),
   "Der Nikolo hat grosse, rehbraune Augen. Diese strahlen eine enorme "
   "Guete aus.");

  AddDetail( ({"haaren","haare"}),
   "Die schlohweissen Haare reichen ihn bis weit ueber die Schultern. Sie "
   "sind leicht gewellt und sehen gepflegt aus.");

  AddDetail( ({"bart"}),
   "Der Nikolo hat einen wirklich langen Bart. Auch sein Bart ist "
   "schlohweiss, aber das liegt an seinem Alter. Der Bart reicht ihm bis "
   "ueber die Brust. Du hast noch nirgends so einen langen Bart gesehen.");

  AddDetail( ({"brust","schultern","kopf","arme","beine","arm","bein","hand"}),
   "Ja sowas hat der Nikolo natuerlich auch.");

  AddDetail( ({"laecheln","mund","lippen"}),
   "Das Laecheln des Nikolo wirkt offenherzig und guetig. Es ist irgendwie "
   "ansteckend sodass Du auch laecheln musst.");

  AddDetail( ({"gewand","rotgoldenes gewand"}),
   "Der Nikolo ist in ein rotgoldenes Gewand gehuellt. Es besteht aus "
   "weinrotem Samt, welcher mit einem goldenen Muster bestickt ist.");
 
  AddDetail( ({"nikolohut","hut"}),
   "Der Hut vom Nikolo passt farblich sehr gut zur Kleidung. Er besteht "
   "ebenfalls aus weinrotem Samt mit einem goldenen Muster.");

  AddDetail( ({"stab"}),
   "Der hoelzerne Stab ist sehr lang und an dem oberen Ende gebogen.");

  AddDetail( ({"sack"}),
   "Ein grosser Leinensack, der auf den Schultern des Nikolos ruht.");
  
//-------------Infos Anfang----------------------------------------

 
  AddInfo( ({"weihnachten"}), 
    "Weihnachten ist das Fest der Liebe. Es ist bald soweit. Ich freue mich "
    "schon darauf.", "sagt laechelnd: ");
		  
  
  AddInfo( ({"liebe"}), 
    "Die Liebe ist was ganz Tolles! Erstens ist sie selten, zweitens muss man "
    "um sie kaempfen und drittens ist sie gratis.", "erklaert: ");

  
  AddInfo( ({"geschenk"}), 
    "Falls Du von mir noch kein Geschenk bekommen hast, dann frag mich doch "
    "einfach nach Nikolosackerl.", "sagt schmunzelnd: ");

  AddInfo( ({"nikolosackerl","sackerl"}), 
    #'inf_sackerl, "brummt: " );

  AddInfo( ({"bekommen"}), 
    #'inf_bekommen, "brummt: " );


  AddInfo( ({"fest"}), 
    "Es gibt viele Feste. Soll ich Dir alle aufzaehlen? Na Du machst mir "
    "Spass!", "lacht: ");

 
  AddInfo( ({"erdnuss","mandarine","schokonikolo","guerteltasche"
			  "tasche","schokoladenikolo"}), 
    "Das befindet sich in meinem Sack.", "fluestert Dir zu: ");

  
  AddInfo( ({"sack"}), 
    "In meinem Sack befinden sich Geschenke fuer die Silberlandbewohner. "
    "Es sind nur Kleinigkeiten, aber ich denke dass der Gedanke ja zaehlt "
    "und nicht die Groesse des Geschenkes.", "sagt laechelnd: ");



//-------------Infos Ende-------------------------------------------------
  
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "schaut Dich veraergert an.",
	       "schaut "+TP->name(WEN)+ " veraergert an.");
     break;

   case "intim":
     call_out ("react", 0, "sagt: Lass das bitte!",
	"tadelt "+TP->name(WEN)+ ".");

    break;

   case "aergerlich":
     call_out("react", 0, "verpasst Dir eine Ohrfeige.",
	      "verpasst "+TP->name(WEN)+" eine Ohrfeige.");
     break;

   case "frech":
     call_out("react", 0, "sagt: Bitte werd nicht kindisch.",
	      "grummelt "+TP->name(WEN)+" zornig an.");
     break;
   
    default:
      call_out("react", 0, "knuddelt Dich.",
	       "laechelt freundlich.");
     break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

    }
}
  
void max()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Der Nikolo begruesst Dich.\n");
    tell_room(MENV, "Der Nikolo sagt: Hallo Max, bringst Du mir bitte einen "
		    "Orangensaft?\n",
		    ({TP}));
  }
}

void landar()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Der Nikolo begruesst Dich.\n");
    tell_room(MENV, "Der Nikolo klopft Landar auf die Schulter.\n",
		    ({TP}));
  }
} 

string* _query_chats()
{
  
  if (!environment())
    return 0;
  switch(file_name(environment()))              // aendern wenn in ebene
  {
    case "/d/ebene/Midas/room/kneipe":
      return ({ "Der Nikolo stellt sich an die Theke.\n",
                "Der Nikolo sagt: Hab ich einen Durst!\n",
                "Der Nikolo bestellt einen Orangensaft.\n",
                "Der Nikolo sagt: Diese Kneipe gefaellt mir gut!\n",
                "Der Nikolo setzt sich kurz hin und rastet sich aus.\n",
		"Der Nikolo waermt sich kurz an.\n",
		"Der Nikolo trinkt einen Birnenschnaps.\n",
                }) + Query(P_CHATS);
    case "/d/ebene/Midas/room/kneipe_saal":
      return ({ "Der Nikolo liest die Menuekarte.\n",
                "Der Bauch vom Nikolo knurrt.\n",
                "Dem Nikolo laeuft das Wasser im Mund zusammen.\n",
		"Der Nikolo setzt sich hin und laechelt zufrieden.\n",
		"Der Nikolo sagt: Ich habe mir eine Pause verdient.\n",
		"Der Nikolo bestellt sich einen Wildschweinbraten.\n",
		"Der Nikolo sagt: Eigentlich bin ich ja auf Diaet.\n",
		"Der Nikolo verspeist eine Suppe.\n",
		"Der Nikolo sagt: Ich kann das Steak hier sehr empfehlen.\n",
                 }) + Query(P_CHATS);
    case "/d/ebene/Midas/room/laden":
      return ({ "Der Nikolo guckt sich das Angebot in den Regalen an.\n",
                "Der Nikolo sagt: Ich brauche noch ein Geschenk!\n",
                "Der Nikolo blickt skeptisch drein.\n",
                "Der Nikolo laesst ein Schwert durch seine Hand gleiten.\n",
                "Der Nikolo streichelt den Muellschlucker.\n",
                "Der Nikolo plaudert kurz mit Landar.\n",
                "Landar grinst den Nikolo an.\n",
                "Der Nikolo erklaert Landar etwas.\n"
		"Landar nickt dem Nikolo zu.\n",
		"Der Nikolo kauft etwas.\n",
                }) + Query(P_CHATS);
   
    case "/d/ebene/Midas/room/post":
      return ({ "Der Nikolo beschenkt den Postbeamten!\n",
                "Der Nikolo gibt einen Brief auf.\n",
                "Der Nikolo kauft eine Briefmarke.\n",
                 }) + Query(P_CHATS);
   
    case "/d/ebene/Midas/room/room_e5":
      return ({ "Der Nikolo spielt an einem Kanalgitter herum.\n",
                "Der Nikolo sagt: Puah! Da stinkts herauf!\n",
                "Der Nikolo gruebelt.\n"
                "Der Nikolo fragt Dich: Warst Du schon mal dort unten?\n",
		"Der Nikolo fragt Dich: Du hast schon ein Geschenk oder?\n",
                 }) + Query(P_CHATS);
    default: return Query(P_CHATS);
  }
}


// AddInfo-Funktionen

mixed inf_sackerl(string answer)
{
  string wann;
  mixed beutel;
  int nochmal;

  if (!TP) return 0;            // sicher ist sicher...
  if (bekommen[getuid(TP)])     // Hat Spieler schon ein Sackerl gekriegt?
  {
    if (bekommen[getuid(TP)] > (time() - 3600))         // letzte Stunde...
      wann = " gerade eben";
    else if (bekommen[getuid(TP)] > (time() - 3600*6))  // letzten 6 Std...
      wann = " vor kurzem";
    else if (bekommen[getuid(TP)] > (time() - 3600*24)) // letzten 24 Std...
      wann = " unlaengst";
    else
      wann = "";
    if (nochmal = IS_WIZARD(TP))
      environment()->Message(
          Name(WER,1) + " sagt: Du hast zwar" + wann +
          " erst ein Sackerl bekommen, aber gut...\n", MSGFLAG_SOUND);
    else
      return "Aber Du hast doch" + wann + " schon ein Sackerl bekommen!";
  }
  else nochmal = 0;

  // Beutel vorbereiten
  beutel = clone_object(OBJDIR "beutel");
  clone_object(OBJDIR "erdnuss")->move(beutel, M_NOCHECK);
  clone_object(OBJDIR "erdnuss")->move(beutel, M_NOCHECK);
  clone_object(OBJDIR "erdnuss")->move(beutel, M_NOCHECK);
  clone_object(OBJDIR "gtasche")->move(beutel, M_NOCHECK);
  clone_object(OBJDIR "mandarine")->move(beutel, M_NOCHECK);
  clone_object(OBJDIR "snikolo")->move(beutel, M_NOCHECK);

  // Spieler evtl. entfroschen
  if (TP->QueryProp(P_FROG))
  {
    environment()->Message(
        Name(WER,1) + " erschrickt.\n", MSGFLAG_VISUAL);
    environment()->Message(
        Name(WER,1) + " sagt: Oh, ein Frosch!\n", MSGFLAG_SOUND);
    environment()->Message(
        Name(WER,1) + " schnippt mit den Fingern.\n", MSGFLAG_VISUAL);
    TP->SetProp(P_FROG, 0);
    write("Du verwandelst Dich ploetzlich wieder in " +
        (TP->QueryProp(P_GENDER) == FEMALE ? "eine " : "einen ") +
        TP->QueryProp(P_RACESTRING)[WER] + "!\n");
    environment()->Message(
        capitalize(getuid(TP)) + " verwandelt sich wieder in " +
        (TP->QueryProp(P_GENDER) == FEMALE ? "eine " : "einen ") +
        TP->QueryProp(P_RACESTRING)[WER] + ".\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  }

  // Sackerl uebergeben
  beutel->customize(TP);        // Name in Sackerl eintragen
  write(Name(WER,1) + " laechelt und ueberreicht Dir ein Sackerl.\n");
  environment()->Message(
      Name(WER,1) + " laechelt und ueberreicht " +
      TP->name(WEM) + " ein Sackerl.\n",
      MSGFLAG_VISUAL | MSGFLAG_NO_TP);

  // In Liste eintragen und abspeichern
  if (!nochmal) {
    bekommen[getuid(TP)] = time();
    savelist();
  }
  write_file(LOGFILE,
      sprintf("%s: Nikolo beschenkt %s%s\n",
        dtime(), capitalize(getuid(TP)), (nochmal ? " wiederholt" : "")));

  if (beutel->move(TP,M_GET) != 1)      // zu schwer? -> in den Raum
  {
    write(Name(WER,1) + " sagt: Oh, das ist Dir wohl zu schwer.\n");
    environment()->Message(
        TP->Name(WER,1) + " kann das Sackerl offenbar nicht mehr tragen.\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    environment()->Message(
        Name(WER,1) + " legt das Sackerl auf den Boden.\n",
        MSGFLAG_VISUAL);
    beutel->move(environment(), M_NOCHECK);
  }

  return 1;     // keinen String zurueckgeben, dann sagt er auch nichts weiter
}

// zum Sortieren nach Empfangsdatum
int sortfunc(mixed a, mixed b)
{
  return bekommen[a] > bekommen[b];
}

mixed inf_bekommen(string answer)
{
  string ret;
  string *ind;
  int i;

  if (!IS_WIZARD(TP))
    return "Das verrate ich nur Magiern!";

  ind = m_indices(bekommen);
  if (!sizeof(ind))
    return "Bis jetzt wollte noch keiner ein Sackerl haben.";

  ind = sort_array(ind, #'sortfunc);
  ret = Name(WER,1) +
    " erzaehlt: Folgende Spieler haben schon ein Sackerl bekommen:\n";
  for (i = 0; i<sizeof(ind); i++)
    ret += "Am " + dtime(bekommen[ind[i]]) + ": " + capitalize(ind[i]) + "\n";

  TP->More(ret);
  environment()->Message(
      Name(WER,1) + " plaudert mit " + TP->name(WEM) + ".\n",
      MSGFLAG_SOUND | MSGFLAG_NO_TP);

  return 1;
}

void loadlist()
{
  string wer,n;
  mixed lines;
  int i;

  bekommen = ([ ]);
  lines = explode(read_file(SAVEFILE),"\n");
  for (i=0; i<sizeof(lines); i++)
    if (sscanf(lines[i],"%s|%d",wer,n) == 2)
      bekommen[wer] = n;
}

void savelist()
{
  mixed ind;
  int i;

  rm(SAVEFILE);
  ind = sort_array( m_indices(bekommen), #'< );
  for (i=sizeof(ind); i-->0; )
    write_file( SAVEFILE, sprintf("%s|%d\n",ind[i],bekommen[ind[i]]) );
}
