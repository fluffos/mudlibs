// by Aaliyah
// 11.November 2005
// Mandarine


inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Mandarine");
  SetProp (P_LONG, "Eine leuchtend orange Mandarine. Sie stammt aus dem "
		  "Orient.");
     
  SetProp (P_NAME, "Mandarine");
  SetProp (P_GENDER, FEMALE);
  AddId (({"mandarine","frucht","obst"}));
  SetProp (P_INFO, ("Die Mandarine enthaelt viele Vitamine."));
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 30, F_SOAK: 4, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du schaelst die Mandarine und isst das saftige Innenleben.\n",
  F_MSG_ROOM: "isst eine saftige Mandarine.\n"]));
 
}

