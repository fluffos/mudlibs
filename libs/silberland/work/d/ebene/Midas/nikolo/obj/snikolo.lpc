// Nikolo - Creations
// by Aaliyah
// 11.November 2005
// Schokonikolo


inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId( ({"schokoladenikolo","schokonikolo","nikolo"}) );
  SetProp(P_SHORT, "Ein Schokoladenikolo");
  SetProp(P_LONG, "Ein kleiner Nikolo aus Schokolade. Er hat einen langen "
		  "Bart aus weisser Schokolade und sieht sehr lecker aus.");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Schokoladenikolo");
  SetProp(P_INFO, ("Der Schokoladenikolo macht Dich gluecklicher."));
  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 50);
  SetProp(P_NOBUY, 0);
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_FOOD_INFO, ([F_HEAL: 30, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du naschst zufrieden den Schokoladenikolo. Er schmeckt lecker!\n",
  F_MSG_ROOM: "nascht einen Schokoladenikolo.\n"]));
}

