// Eine Guerteltasche


#include "../def.h"
#include <properties.h>
inherit "/std/container";

int gebunden;

nosave void BindOn()
{
   gebunden=1;
   SetProp(P_SHORT, "Eine Guerteltasche (umgebunden)");
   SetProp(P_WEIGHT_PERCENT, 35);
}

nosave void BindOff()
{
   gebunden=0;
   SetProp(P_SHORT, "Eine Guerteltasche");
   SetProp(P_WEIGHT_PERCENT, 60);

}



create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Guerteltasche");
  SetProp(P_LONG, BS("Diese Guerteltasche dient als Behaelter fuer diversen "
		"Kleinkram. Man kann sie um die Taille binden."));
  AddId(({"guerteltasche", "tasche"}));
  SetProp(P_NAME, "Guerteltasche");
  SetProp(P_INFO, "Mit der Syntax 'binde tasche um taille' kannst Du die "
		  "Tasche um die Taille binden. Mit der Syntax 'binde "
		  "tasche los' kannst Du sie wieder losbinden.\n");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp(P_VALUE, 1000);
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddCmd(({ "binde", "bind" }), "cmdBinde");
  BindOff();
  
  
 }


int cmdBinde(string str)
{
   string *tmp;

   tmp=explode(str, " ");
   if( !sizeof(tmp) || ((tmp[0] != "tasche") && (tmp[0] !="guerteltasche"))) 
   {
     notify_fail("Was willst Du wo anbinden?\n");

     return 0;
   }

   if(!MENV || !living(MENV))
   {
     notify_fail("Du musst die Tasche doch erst mal nehmen!\n");
     return 0;
   }

   if((str != "tasche um taille") && (str != "guerteltasche um taille")
       && (str != "tasche an taille") )
   {
     if((str != "tasche los") && str != "guerteltasche los")
     {
       notify_fail("Wo moechtest Du die Guerteltasche festbinden?\n");
       return 0;
     }
     if(!gebunden)
     {
       notify_fail("Du hast Dir die Guerteltasche doch gar nicht umgebunden!\n");
       return 0;
     }

     BindOff();
     write("Du bindest die Tasche von Deiner Taille los.\n");
     say(TP->Name()+" bindet eine Guerteltasche von "+
         TP->QueryPossPronoun(FEMALE, WEM)+ " Taille los.\n");
     return 1;
    }

   if(gebunden)
   {
    notify_fail("Du hast Dir die Guerteltasche doch schon umgebunden.\n");
    return 0;
   }

   BindOn();
   write("Du bindest Dir die Guerteltasche um Deine Taille.\n");
   say(TP->Name()+" bindet eine Guerteltasche um " +
       TP->QueryPossPronoun(FEMALE, WEM)+" Taille fest.\n");
   return 1;
}

   
