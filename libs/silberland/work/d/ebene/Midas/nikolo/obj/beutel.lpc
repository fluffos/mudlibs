// by Aaliyah
// 11.November 2005
// Ein Jutebeutel


#include "../def.h"
#include <properties.h>
inherit "/std/container";


void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein besticktes Jutesackerl");
  SetProp(P_LONG,
      "Ein Sackerl aus Jute, das mit einem schoenem Muster bestickt worden "
      "ist. Man kann diverse Kleinigkeiten darin aufbewahren.");
  AddId(({"jutesackerl", "sackerl"}));
  SetProp(P_NAME, "Jutesackerl");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "bestickt");
  SetProp(P_WEIGHT, 100);
  SetProp(P_MAX_WEIGHT, 1200);
  SetProp(P_VALUE, 400);
  SetProp(P_INFO, BS("Dieses Jutesackerl war ein Geschenk vom Nikolo."));
  SetProp(P_MATERIAL, MAT_COTTON);

  AddDetail(({"muster"}),
   "Verschiedene Schnoerkel, die mit goldenem Garn gestickt wurden.");

  AddDetail(({"schnoerkel"}),
   "Einige bunte Blumen befinden sich auch noch zwischen den Schnoerkeln.");
 }


void customize(object spieler)
{
  if (objectp(spieler))
  {
    SetProp(P_SHORT, spieler->name(WESSEN) + " besticktes Jutesackerl");
    SetProp(P_LONG, QueryProp(P_LONG) +
        "Es gehoert " + capitalize(getuid(spieler)) + ".\n");
  }
}
