// Erdnuss


inherit "std/food";
#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Erdnuss");
  SetProp (P_LONG, "Eine leckere Erdnuss. Sie schmeckt Dir sicherlich "
		  "hervorragend.");
     
  SetProp (P_NAME, "Erdnuss");
  SetProp (P_GENDER, FEMALE);
  AddId (({"erdnuss","nuss"}));
  SetProp (P_INFO, ("Die Erdnuss ist gut fuer Dein Gehirn."));
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 10, F_SOAK: 2, F_ALCOHOL: 0, F_POISON:0,
  F_MSG: "Du knackst die Erdnuss und verspeist ihren leckeren Kern.\n",
  F_MSG_ROOM: "knabbert eine Erdnuss.\n"]));
 
}

