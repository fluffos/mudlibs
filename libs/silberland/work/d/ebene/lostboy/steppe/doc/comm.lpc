//
//  Testfile
//  
//  Minimal-Objekt in welchem AddCmds verankert werden koennen, die in
//  der Umgebung des Spieler gelten und ihm Uberall hin folgen
// 
//  
//

mapping comands;

void create()
{
  comands=([]);
}

void init()
{
  if(comands!=([]))
    walk_mapping(comands,lambda(({'a,'b,'po,'c}),({#'add_action,"execute",'a,'c})));
}

void AddCmd(mixed a, string b, mixed c)
{
  comands+=([a:b;previous_object();c]);
  add_action("execute",a,c);
}

int execute(string str)
{
  string v;
  v=query_verb();
  if(comands[v])
    return call_other(comands[v,1],comands[v,0],str);
  return 0;
}

int move(mixed to,int mode, mixed dummy1, mixed dummy2)
{
  object env;
  if(env=environment())
    env->NotifyLeave();
  to->NotifyInsert();
  move_object(this_object(),to);
  return 1;
}
