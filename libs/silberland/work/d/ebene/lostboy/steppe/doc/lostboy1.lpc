

inherit "std/room";



#include <properties.h>

#include <language.h>

#include "./std.h"

#include "../def.h"



gehe_sueden()

{

  write(

   "Die Steppe ist schon fast fertig und darf ohne meine Erlaubnis nicht\n"

   "mehr betreten werden, da sie bald im Silberland ist.\n");

  return 1;

}





create()







{

  ::create();



  SetProp( P_INT_SHORT, "Lostboy's Gebiet" );





  SetProp( P_INT_LONG,

    "Du betrittst nun die Raeume von Lostboy. "

   +"Entweder gehst du in Lostboys Seherhaus, "

   +"welches aber eigentlich schon fertig im Silberland steht. "

   +"Oder du gehst nach Suedosten in die Steppe. "

   +"ABER ACHTUNG. Die Steppe ist voller BUGS. "

   +"Wenn du sie anschaust, dann lass auch ein paar typos ab."  

);



  SetProp( P_LIGHT, 1 );



  SetProp( P_INDOORS, 1 );



  AddDetail( ({ "Chaos", "Boden" }), 

          "Die Sauerei bringt sich fast zum kotzen.\n" );

  AddDetail( ({ "Kisten" }), 

          "Mindestens 10 riesige Kisten stehen hier rum.\n" 

          "Eine Kiste faellt Dir besonders auf\n" );

  AddDetail( ({ "kiste" }), 

          "Die ist verschlossen. Vielleicht solltest du sie oeffnen?\n" );

  AddDetail( ({ "Tuer" }), 

          "Diese Holztuer sieht total neu aus Sie ist offen.\n" );

AddDetail( ({ "steppe" }), 

          "Das wird mal eine Region im Silberland.\n" );  

AddDetail( ({ "Naegel", "Scherben", "Werkzeug", "Kleinkram" }), 

          "Die Sachen liegen im ganzen Raum verteilt rum.\n" 

        + "Du nimmst aber lieber nix sonst wirds hier ja nie sauber\n" );

 AddCmd( ({ "schliesse", "oeffne" }), "beweg_etwas" );











AddExit( "norden", "/gilden/abenteurer" );



AddExit( "seherhaus", "/d/lostboy/lost.lpc" );





AddSpecialExit("suedosten","gehe_sueden");



 



}





beweg_etwas( str )

{

      notify_fail( "Was willst Du denn oeffnen ?" );

      if( str == "kiste" )

{

               write( "Du oeffnest du Kiste und findest drinn NIX.\n" );

               say(  this_player()->name(WER,2)+" oeffnet eine Kiste.\n"

              );



 return 1;



 }



 return 0;



}



  



