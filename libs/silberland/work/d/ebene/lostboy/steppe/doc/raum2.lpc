inherit "std/room";



#include <properties.h>

#include <language.h>

#include "../def.h"







create()







{

  ::create();



  SetProp( P_INT_SHORT, "Auf nem Hocker" );





  SetProp( P_INT_LONG,

    "Du stehst jetzt auf dem Hocker von Lostboy.\n"

   +"Richtig klein sieht alles von hier oben aus.\n"

   +"Du hoffst, dass der Hocker Dein Gewicht und Deine\n"

   +"Erfahrung tragen kann.\n"

   +"Du stehst direkt vor dem grossen Schrank. Du kannst\n"

   +"gut sehen was drauf steht. Ein bisschen Staub und\n"

   +"natuerlich eine tolle Truhe.\n"

   +"Auf der Truhe siehst Du noch einen kleinen Zettel kleben.\n" 

   +"Die Luft hier oben ist so duenn, dass Dich die Leute unten in der\n"

   +"Huette nicht mehr reden hoeren koennen.\n" );  

SetProp( P_LIGHT, 1 );



  SetProp( P_INDOORS, 1 );



  AddDetail( ({ "hocker", }), 

          "Hoffentlich haelt er.\n" );

  AddDetail( ({ "staub" }), 

          "Hier hat Lostboy aber schon lange nicht\n" 

         +"mehr staubgewischt. Du pustest mal rein, aber\n"

         +"der Staub bleibt kleben. Ihhhhhh.\n " );

  AddDetail( ({ "schrank" }), 

          "Auf dem Schrank siehst Du die tolle Truhe.\n" );

AddDetail( ({ "zettel" }), 

          "LESEN bildet.\n" );  

AddReadDetail( ({ "zettel" }), 

          "Auf dem Zettel steht folgendes geschrieben:\n     " 

         +"In dieser Truhe befindet sich Lostboy Geruempel.\n     "

         +"Wenn die Truhe wiedermal ausgepluendert ist haste Pech\n     "

         +"gehabt. Wenn was drinn ist kannst Du nehmen was Du\n     "

         +"brauchen kannst. Aber natuerlich kannst du auch Sachen\n     "

         +"reinlegen die Du nicht mehr brauchst. Andere freuen sich.\n");

AddDetail( ({ "geruempel" }), 

           "Du bist gespannt was Lostboy unter Geruempel versteht und\n"

          +"schaust lieber gleich in die Truhe.\n" );  

AddDetail( ({ "luft" }), 

          "Du kannst die Luft nicht sehen, egal wie sehr Du Dich konzentrierst.\n" );



  AddExit( "runter", "./lost" );





AddItem("/d/lostboy/truhe.lpc", REFRESH_DESTRUCT);





}







