// ein Standard immaterielles Objekt.     
//fuer den Gebrauch innerhalb von lebenden Objekten.
// z.B. fuer Flueche, Krankheiten, temporaere Zustaende wie nass, kalt,
// reitend, fliegend, brennend...
// ohne den Ballast in thing.c
// Zustaende duerfen immer nur ein einziges mal in einem Objekt
// vorhanden sein (3-fach nass waere doof :-) , daher duerfen sie
// auch immer nur eine id besitzen.

string id, pfad; int neu; object vic; mixed z;
void create() {
// Zustaende duefen immer nur EINE eigene ID haben ! daher kein AddId.
    sscanf(file_name(),"%s#%s",pfad,id);
    id = "zustand"; 
    neu = 1;
// Die Zustandsintensitaetsvariable z ist die einzige automatisch gesavete Variable des Zustands.
// wird sie auf 0 gesetzt, ist der zustand nicht mehr autoloading.
   z = 1;
}

void init() { 
object gibtsschon;
        if (!environment()) {destruct(this_object()); return; }
        if (!living(environment())) { destruct(this_object()); return;}
        vic = environment();
        if (gibtsschon=present(id+" 2")) {
           write("gibts schon!\n");
           gibtsschon->remove();
           }
}
status id(string arg) { return (id==arg||pfad==arg); }

// In welchem Player befinde ich mich ?
object vic() {
    object ob;
    if (ob = environment())
       if (living(ob)) return ob;
    else return 0;
    }
status move(object dest, int method) {
    if (neu) { neu=0; move_object(dest); return 1; }
    if (!(method==4 || method==0)) return 0;
    move_object(dest);
    return 1;
}

status remove() {
    destruct(this_object());
    return 1;
}
int _query_autoloadobj() { return z; }
int _set_autoloadobj(int wert) { return z = wert; }
status Set(string var, mixed val) {
  if (var=="z"||var=="autoloadobj") { return z = val; }
     else return 0;
}
varargs Query(mixed var) {
   if (var=="z"|| var=="autoloadobj") return z;
}
// Dummy QueryProp... leider noch notwendig.
QueryProp(mixed var) { return Query(var); }
SetProp(mixed var, mixed val) { return Set(var,val); }
