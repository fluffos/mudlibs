// 
//
// 
// Eine neue Frisurenmode fuer die Spieler
//
// 
// 


#include <properties.h>


#define TP  this_player()

#define TA_OBJ(x)   ("/d/lostboy/"+x)

#define BS(x)    break_string(x,78)
#define BSI(x,y) break_string(x,78,y)
#define ZUSTAND "/d/lostboy/zustand.lpc"

inherit ZUSTAND;

private object tp;
private string extralook;
private object ec;

void create()
{
  if (!is_clone(this_object())) return;
  
  zustand::create();
  id="Frisur";
  if(z!=1)
    call_out("set_extralook",1,z);
}

init()
{
  ::init();
  add_action("goaway","",1);
}

void set_extralook(string str)
{
  tp=environment();
  ec=clone_object(TA_OBJ("comm"));
  ec->move(environment(tp),0,0,0);
  ec->AddCmd("wuschel","undo");
  ec->AddCmd("wuschele","undo");
  tp->AddPursuer(ec);
  ec->move(environment(tp),0,0,0); // erneutes moven wg. AddCmd
  switch(tp->QueryProp(P_GENDER))
  {
    case MALE:   extralook="Seine gestylten Haare tragt er zu "+str+" gekaemmt.\n"; 
    	         break;
    case FEMALE: extralook="Ihre gestylten Haare traegt sie zu "+str+" gekaemmt.\n"; 
    	         break;
    case NEUTER: extralook="Seine gestylten Haare tragt es zu "+str+" gekaemmt.\n"; 
    	         break;
  };
}


string extra_look()
{
  return extralook;
}

int undo(string str)
{  
  string *words,a;
  object o;
  
  words=explode(str," ");
  if(words==0)
    return 0;
  if(tp->id(words[0]) || words[0]=="mich" || words[0]=="mir")
    {
      a="";
      o=TP;
      if(sizeof(words)>1)
        if(words[1][0]=='/')
           a=implode(words[1..]," ")[1..]+" ";
      if(o==tp)
        {
          write(BS("Du verwuschelst "+a+"Deine Haare.\n"));
          write("Du hast Deine wunderschoene Frisur zerstoert!\n");
          tell_room(environment(tp),BS(tp->name(WER)+" verwuschelt "+tp->QueryPossPronoun(NEUTER,WEN,1)+" Haare.\n"),({tp}));
          call_out("remove",0);
          return 1;
        };
      tell_object(o,BS("Du verwuschelst "+a+tp->name(WESSEN)+" Haare.\n"));
      tell_object(o,BS("Du hast damit "+tp->name(WESSEN)+" wunderschoene Frisur zerstoert!\n"));
      tell_object(tp,BS(o->name(WER)+" verwuschelt Dir "+a+"Deine Haare.\n"));
      tell_object(tp,BS(o->name(WER)+" hat damit Deine wunderschoene Frisur zerstoert!\n"));
      tell_room(environment(o),BS(o->name(WER)+" verwuschelt "+a+tp->name(WESSEN)+" Haare.\n"),({o,tp}));      
      tell_room(environment(o),BS(o->name(WER)+" hat damit "+tp->name(WESSEN)+" wunderschoene Frisur zerstoert.\n"),({o,tp}));      
      call_out("remove",0);
      return 1;
    }
  return 0;
}

int goaway()
{
  if(environment(tp)->QueryProp(P_INDOORS)==0)
    if(random(20)==19)
      call_out("blow",0);
  return 0;
}

void blow()
{
  tell_object(tp,"Ein Windstoss zerstoert Deine schoene Frisur!\n");
  tell_room(environment(tp),BS("Ein Windstoss zerstoert "+tp->name(WESSEN)+" schoene Frisur...\n"),({tp}));
  remove();
}

int remove()
{
  if(objectp(tp) && objectp(ec))
    tp->RemovePursuer(ec);
  if(objectp(ec))
    destruct(ec);
  return ::remove();
}