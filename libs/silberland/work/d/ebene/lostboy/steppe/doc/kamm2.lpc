/// Testkamm 

///

/// 

/// Ein netter kleiner Kamm, mit dem man seine Mitspieler verzieren kann

///

/// losti

/// mod by arth



#pragma strong_types





#include <properties.h>

#include <language.h>

#include <moving.h>

#include "../def.h"

#define TP  this_player()



#define TA_OBJ(x)   ("/d/lostboy/"+x)



#define BS(x)    break_string(x,78)

#define BSI(x,y) break_string(x,78,y)





inherit "/std/thing";



nosave string *frisuren=({"einem braven Mittelscheitel",

			  "einem spiessigen Seitenscheitel",

		 	  "einem lustigen Irokesenkamm",

		 	  "einem Pferdeschwanz",

		 	  "zwei Zoepfen"});

		 	  

nosave mixed *frisuren_ids=({"scheitel",0,

			    "seitenscheitel",1,

			    "mittelscheitel",0,

			    "kamm",2,

			    "irokesen",2,

			    "iro",2,

			    "schwanz",3,

			    "pferdeschwanz",3,

			    "zoepfe",4});





void create()

{

  if (!is_clone(this_object())) return;

  

  ::create();

  SetProp(P_NAME, "Kamm");

  

  SetProp(P_GENDER, MALE);

  SetProp(P_LONG,"Du haelst einen kleinen, wunderschoen verzierten Kamm in "

  		 "den Haenden. Er scheint aus einem sehr leichten, Dir  "

  		 "unbekannten Holz geschnitzt zu sein.\n");

  SetProp(P_VALUE, 20);

  SetProp(P_SHORT,"Ein kleiner Kamm");

  SetProp(P_WEIGHT, 10);

  SetProp(P_IDS, ({"\ntakamm","kamm"}));

  

  AddDetail(({"verzierungen","kunstwerk"}),

  	"Kunstvolle Schnitzereien machen diesen Kamm zu einem kleinen Kunstwerk.\n");



  AddDetail("holz",

  	"Der Kamm scheint aus Holz geschnitzt zu sein. Aus welchem Holz ver"

  	"magst Du jedoch nicht zu sagen, da Dir noch die zuvor ein so festes "

  	"und doch leichtes Holz begegnet ist.\n");

  	

  AddDetail(({"schnitzerein","figuren","muster"}),

  	"Alle moeglichen Figuren und Muster wurden in den Kamm geschnitzt und "

  	"machen ihn zu einem kleinen Kunstwerk.\n");

}



void init()

{

  ::init();

  AddCmd(({"kaemme","kaemm"}),"brush_hair");

}



mixed test()

{

  return present("elaine",environment(environment()));

}



int brush_hair(string str)

{

  string what,*words;

  object whom,o;

  int frisur;

  

  if(TP!=environment())

    return 0;  

  if(str==0)

    {

      notify_fail("Wem willst Du denn die Haare kaemmen?\n");

      return 0;

    };    

  words=explode(str," ");

  if(words==0)

    {

      notify_fail("Wem willst Du denn die Haare kaemmen?\n");

      return 0;

    };

  if(words[0]=="mich" || words[0]=="meine")

    whom=TP;

  else

    whom=present(words[0],environment(environment()));

  if(!whom)

    {

      notify_fail("Aber "+capitalize(words[0])+" ist doch nicht anwesend...\n");

      return 0;

    };

  if(sizeof(words)>1)

    {

      frisur=member_array(words[1],frisuren_ids);

      if(frisur==-1)

        {

          write(break_string("Eine solche Frisur bekommst Du mit diesem Kamm nicht hin...\n") );

          return 1;

        }

     frisur=frisuren_ids[++frisur];

    }

  else

    frisur=random(sizeof(frisuren));

  if(TP==whom)

    {

      write(BS("Du kaemmst Dir Deine Haare zu "+frisuren[frisur]+".\n"));

      tell_room(environment(whom),BS(whom->name(WER)+" kaemmt sich die Haare.\n"),({whom}));

    }

  else

    {

      write(BS("Du kaemmst "+whom->name(WEM)+" die Haare zu "+frisuren[frisur]+".\n"));

      tell_room(environment(whom),BS(TP->name(WER)+" kaemmt "+whom->name(WEM)+" die Haare zu "+frisuren[frisur]+".\n"),({TP,whom}));

      tell_object(whom,TP->name(WER)+" kaemmt Deine Haare.\n");

    };

  o=clone_object(TA_OBJ("gekaemt_"));

  o->move(whom,M_GET|M_SILENT);

  o->set_extralook(frisuren[frisur]);

  return 1;  

}

