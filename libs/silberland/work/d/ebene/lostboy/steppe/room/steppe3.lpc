
//losti
//modified by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include "detail.h"

int door;


create() {
   ::create();

   SetProp( P_INT_SHORT, "Mitten in der Steppe" );
   door = 1;
   SetProp( P_INT_LONG,
     "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
     "ausdehnt. So langsam bekommst Du Panik, dass Du Dich verirrst. "
    +"Die Steppe scheint sehr einsam zu sein. Du fuehlst Dich verlassen. " 
    +"Ein Meer von Gras bewegt sich sanft im ewigen Wind der Steppe. " 
    +"Hier und da entdeckst Du ein paar Baeume, Buesche und Straeucher. " 
    +"Du bemerkst gleich, dass es hier wohl schon lange nicht mehr " 
    +"geregnet hat, denn die Steppe ist voellig ausgetrocknet.");

   SetProp( P_LIGHT, 1 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
   SetProp( P_INDOORS, 0 );

  RECENT1

  AddSpecialDetail( ({"platte","steinplatte"}), "xgitter" );

  AddDetail( ({ "steppe", "gegend" }),
           "Genau so hast Du Dir eine Steppe immer vorgestellt. "
           "Fad, trocken, einsam und heiss." );

  AddDetail( ({ "norden", }), 
          "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras.");

  AddDetail( ({ "pfad", "trampelpfad" }), 
          "Du hast den kleinen Pfad durch die Steppe schon lange verlassen." );

  AddDetail( ({ "wind", }), 
          "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
          "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
          "eines Meeres aus." );

  AddDetail( ({ "halme", "grashalme", "gras" }), 
          "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. Es ist schon richtig " 
          "ausgetrocknet von der stechenden Sonne. "
          "Zwischen den hohen Grashalmen entdeckst Du eine alte "
          "Steinplatte." );

  AddDetail( ({ "wellen", "meer" }), 
          "Das war doch nur eine Metapher." );

  AddDetail( ({ "stein", "gegenstand" }), 
          "Harter natuerlicher Gegenstand." );

  AddDetail( ({ "gesicht", }), 
          "Du bekommst schon einen leichten Sonnenbrand." );

  AddDetail( ({ "baeume", }), 
          "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du siehst, "
          "sind sehr ausgetrocknet und tragen keine Blaetter." );

  AddDetail( ({ "blaetter", }), 
          "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen." );

  AddDetail( ({ "buesche", }), 
          "Hier und da wehen im Wind ein paar dornige Buesche.");

  AddDetail( ({ "straeucher", }), 
          "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
          "Anscheinend erhalten sie zu wenig Wasser.");

  AddDetail( ({ "wasser", }), 
          "Davon hat die Steppe eindeutig zuwenig." );

  AddDetail( ({ "himmel", "sonne" }), 
          "Die Sonne strahlt blendend weiss vom Himmel." );

  AddDetail( ({ "boden", "erde" }), 
          "Hm, eigentlich siehst Du nur Gras." );

  AddDetail( ({ "metapher", }), 
          "Immer diese Fremdwoerter." );

  AddDetail( ({ "panik", "grund"}), 
          "Irgendjemand denkt gerade, dass kein Grund zur Panik besteht." );

  AddDetail( ({ "schriftzeichen", }), 
          "Die Schriftzeichen sind in einer alten Sprache geschrieben, "
          "die Du nicht verstehen kannst. Oder kannst Du was mit "
          "FAS TFO OD oder mit HA TSCH IGES UND HEIT anfangen? "
          "Vielleicht gibt es ja irgendwo Jemanden, der diese Sprache "
          "noch beherrscht." );

  AddDetail( ({ "sprache", }), 
          "Diese Sprache wird im Silberland nirgens mehr gesprochen. "
          "Nur noch sehr alte weise Menschen wissen die Bedeutung "
          "dieser Woerter. ");

  AddDetail( ({ "bedeutung", "woerter" }), 
          "Dir ist die Bedeutung dieser Woerter unbekannt." );

  AddDetail( ({ "verzierungen", }), 
          "Die Steinplatte ist nicht nur eine Platte. Der Erschaffer hat "
          "sie mit vielen Abbildungen, Muster, Farben und solchem Zeugs "
          "verschoenert. Leider bilden sich schon Alterserscheinungen.");

  AddDetail( ({ "muster", "abbildungen", "farben", "zeugs" }), 
          "Verzierungen an der Steinplatte. Sehr interessant.");

  AddDetail( ({ "Erschaffer", }), 
          "Der Erschaffer dieser Steinplatte koennte Dir sicher sagen, was "
          "es mit dieser Platte auf sich hat. ");

  AddDetail( ({ "alterserscheinungen", }), 
          "Die Platte ist bereits mit dem Gras zugewachsen. Der Stein ist "
          "poroes und broeckelt ab. Die Farben der Muster sind blass.");

  AddDetail( ({ "mechanismus", }), 
          "Durch diesen Mechanismus wird die Platte anscheinend zur Seite " 
          "geschoben. Aber Du erkennst gleich, dass hier durch pure "
          "Gewalt nichts zu erreichen ist.");
          
  AddDetail( ({ "gewalt", }), 
          "Sicher kannst Du es trotzdem mal versuchen." );

  AddDetail( ({ "grab", "gedanke"}), 
          "Jetzt erst kommt Dir der Gedanke, dass das ein Grab sein "
          "koennte. Du schaust es Dir nochmal genau an. Die vielen "
          "Bilder auf dem Grab machen Dir zu schaffen." );

  AddDetail( ({ "bilder", }), 
          "Die Bilder zeigen kleine Lebensabschnitte eines Mannes, den "
          "Du nicht kennst. Vielleicht liegt er hier vergraben. Die meisten "
          "sind kaum mehr zu erkennen, da die Bilder schon recht verdreckt "
          "und verwest sind." );

  AddDetail( ({ "lebensabschnitte", "mannes", "mann", }), 
          "Vier Bilder kannst Du noch recht gut erkennen. "
          "Sie zeigen ihn als Kind, als Teenie, als Erwachsener und "
          "als alter Opa." );

  AddDetail( ({ "kind", }), 
          "Er spielt vergnuegt in einem Sandhaufen." );

  AddDetail( ({ "sandhaufen", "eltern" }), 
          "Er muss reiche Eltern gehabt haben. Der Sandhaufen sieht " 
          "bonzig aus." );

  AddDetail( ({ "teenie", }), 
          "Er knutscht ein schoenes Maedchen." );

  AddDetail( ({ "maedchen", }), 
          "Ach, hat die niedliche Zoepfe." );

  AddDetail( ({ "zoepfe", }), 
          "Es sind zwei um genau zu sein." );

  AddDetail( ({ "erwachsener", }), 
          "Eine Hochzeit. Es ist wohl das Maedchen aus seiner Teeniezeit." );

  AddDetail( ({ "hochzeit", }), 
          "Du erkennst den Pier von Midas durch ein Fenster im Standesamt." );

  AddDetail( ({ "midas", "pier", "standesamt", "fenster" }), 
          "Zu alt und zu klein. Du erkennst es nicht mehr." );

  AddDetail( ({ "opa", "bild", "frau", }), 
          "Das Bild zeigt ihn, wie er auf einem Friedhof seiner verstorbenen " 
          "Frau nachweint. Seltsamerweise faellt Dir auf, wie er mit seiner "
          "rechten Hand Etwas druecken will. Bei genauerem Hinsehen bemerkst "
          "Du, dass er genau vor diesem Grab steht, vor dem Du jetzt auch "
          "stehst.");

  AddDetail( ({ "friedhof", }), 
          "Wie unheimlich er wirkt." );

  AddDetail( ({ "hand", }), 
          "Was drueckt die da nur?" );

  
  AddSpecialDetail( ({ "etwas", }), "etwas_fun"); 


  AddSound( DEFAULT_SOUND,
    "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );

  AddSmell( DEFAULT_SMELL,
    "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );


  AddCmd( ({"oeffne", "drueck", "druecke", "breche", "zieh", "ziehe",
        "brich", "schieb", "schiebe", "verschieb", "verschiebe" }), "xoeffne");
  AddCmd( ({"betaetige", "betaetig" }), "xdrueck" );


  AddExit( "sueden", "./steppe6" );
  AddExit( "osten", "./steppe4" );
}


string etwas_fun() {
  AddDetail("hebel", "Was der wohl bewirken wird? Man kann ihn betaetigen.\n");
  return break_string("Auf dem Bild kannst Du es nicht genau erkennen. "+
	"Also schaust Du auf der selben Stelle auf der Steinplatte nach, "+
	"vor der Du stehst. Und siehe da, Du entdeckst einen kleinen, "+
	"unscheinbaren Hebel.\n", 78);
}

reset() {
  ::reset();
  close_grave();
}


/*
tuer() {
  if( !door) return "geschlossenes";
  return "offenes";
}
*/

query_door() {
   return door;
}

set_door(int d) {
  door = d;
}

xdrueck(str) {
   notify_fail( "Was willst Du druecken?\n" );
   if( str=="hebel" )  {
     say(TP->Name()+" betaetigt einen Hebel.\n");
     write("Du betaetigst den Hebel.\n");
     if( !door )  {
       write("Nichts passiert.\n");
       return 1;
     }
     open_grave();
     return 1;
   }
   return 0;
}


xgitter() {
   if( door ) {
     return BS("Die Platte ist ca. 2x1 Meter gross und 10 cm dick. "
          "Sie ist bereits mit den hohen Grashalmen verwachsen, sodass "
          "man sie nicht gleich sehen konnte. Auf ihr sind viele "
          "Verzierungen und Schriftzeichen aufgemalt worden. An einer "
          "Seite der Platte ist ein Mechanismus angebracht." );
   }
   return BS("Die Platte ist geoeffnet, Du kannst durchgehen.");
}


xoeffne(str) {
   notify_fail( "Was willst Du genau machen?\n" );
   if( (str=="platte") || (str=="steinplatte") || (str=="steinplatte auf") ||
       (str=="platte auf") )
   {
     if (!TP->do_exhaust(200)) return 1;         // Erschoepfend
     if( door ) {
       write(BS("Du klammerst Dich an der Platte fest und faengst\n"
         "an zu ziehen. Aber leider kannst Du die Platte\n"
         "nirgens richtig greifen und rutschst immer wieder ab.\n" ) );
       say(this_player()->Name(WER)+" regt sich tierisch auf.\n");
       return 1;
     }
     write(BS("Aber die Platte ist doch schon offen.") );
     return 1;
   }
   return 0;
}


open_grave() {
   tell_room( TO,
       "Ploetzlich oeffnet sich die Steinplatte unter Dir im Gras.\n");
   AddExit( "unten", "./grab");
   door = 0;
   return 1;
}


close_grave() {
  if (!door)
    tell_room( TO, BS("Eine Platte faellt zu.") );
  door=1;
  RemoveDetail("hebel");
  RemoveExit( "unten" );
}

