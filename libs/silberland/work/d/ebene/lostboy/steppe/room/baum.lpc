
//lost
//modified by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

int ei_da;

create() {
  ::create();
  ei_da=1;
  SetProp( P_INT_SHORT, "Mitte von einem Baum" );
  SetProp( P_INT_LONG,
          "Etwa auf halber Hoehe angekommen bist Du schon recht erschoepft. "
          "Der Baumstamm ist hier noch recht dick. Die vielen Aeste "
          "hier oben versperren Dir die Aussicht. Insgesamt schaut "
          "der Baum recht krueppelig und krank aus.\n");
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:22]) );

  SetProp( P_INDOORS, 0 );

  AddDetail( ({"boden"}),
      "Der Boden ist weit unter Dir. Jetzt bloss nicht runtefallen.");
  AddDetail( ({"himmel"}),
      "Die vielen Aeste versperren Dir die Aussicht.");
  AddDetail( ({ "baumstamm", "stamm" }), 
     "Der Stamm ragt immer noch einige Meter weiter in die "
     "Hoehe. Ganz oben erkennst Du eine Astgabel. Ausserdem "
     "befindet sich direkt vor Dir ein Loch im Baumstamm." );

  AddDetail( ({ "loch", "eingang" }), 
     "Das Loch stammt wohl von einem Specht. Der Eingang ist recht " 
     "eng und alles dahinter dunkel." );

  AddDetail( ({ "eingang" }), 
     "Es handelt sich doch eher um eine Oeffnung.\n" );

  AddDetail( ({ "oeffnung" }), 
     "Du rueckst ein paar Forscherpunkten immer naeher.\n" );

  AddDetail( ({ "forscherpunkte" }), 
     "Die musst Du schon selber finden." );  

  AddDetail( ({ "hilfsmittel" }), 
     "Etwas langes duennes waere wohl angepasst." );  

  AddDetail( ({ "aeste" }), 
     "Die Aeste ragen in alle Richtungen empor.");  

  AddDetail( ({ "astgabel" }), 
     "Ganz oben auf dem Baum kannst Du eine grosse Astgabel "+
     "erkennen. Sie sieht wie ein natuerlicher Sitz aus." );  

  AddDetail( ({ "gabel" }), 
     "Suchst Du was zum Essen? Geh doch in eine Kneipe.");  

  AddDetail( ({ "sitz" }), 
     "Er befindet sich etwa fuenf Meter ueber Dir. "+
     "Von dort hat man sicher eine tolle Sicht." );

  AddDetail( ({ "sicht" }), 
     "Aber doch nicht von hier. Von dort oben!!" ); 

  AddDetail( ({ "hoehe" }), 
     "Naja eigentlich bist Du schon im oberen Drittel, aber "
     "wir wollten da nicht so genau sein. Jedenfalls wirds Dir "
     "schon recht schwindelig hier oben." ); 

  AddDetail( ({ "hier" }), 
     "Was ein Scripter? Hier auf meinem Baum? "
     "Na warte, das wirst Du bereuen. Es wurde alles " 
     "mitgeloggt. Deine FPs kannst Du schonmal vergessen.");  

  AddDetail( ({ "baum" }), 
     "Ein Baum eben. Du befindest Dich auf halber Hoehe." );  

  AddDetail( ({ "aussicht" }), 
     "Hier versperren zu viele Aeste die schoene Aussicht. "
     "Weiter oben kannst Du sicher mehr sehen." );  

  AddSound( DEFAULT_SOUND,
     "Totenstille. Alles ist so friedlich hier oben." );

  AddSmell( DEFAULT_SMELL,
     "Wenn man Hitze riechen koennte, dann wuerdest Du Dir die Nase "
     "zuhalten." );

  AddSpecialDetail("etwas", "ei_fun");
  AddSpecialDetail("gegenstand", "ei_fun2");

  AddCmd("nimm","nimm_ei"); 
  AddCmd( ({ "greife", "greif", "fasse", "fass", }), "greife" );
  AddCmd( ({ "kletter", "klettere", }), "kletter" );

  AddExit( "unten", "./steppe7" );
}


string ei_fun() {
  if (ei_da)
    return "Ein Gegenstand, den Du bist jetzt noch nicht hast.\n";
  return "Du scheinst Dich geirrt zu haben.\n";
}

string ei_fun2() {
  if (ei_da)
    return BS("Ein rundes Etwas. Aber was es genau ist kannst "
      "Du nicht sagen. Nur wenn Du es nehmen koenntest, wuesstest Du "
      "genaueres.");
  else
    return 0;   // Sowas siehst Du da nicht. :)
}


reset() {
  ::reset();
  ei_da=1;
}


nimm_ei(string str) {
  object waffe, ei;
  string was, womit;
  int ret;

  if( ((str == "etwas") || (str == "gegenstand")) && (ei_da==1) ) {
    write("Keine Chance, ohne Hilfsmittel kommst Du da nicht richtig ran.\n");
    say(TP->Name()+" greift in ein Loch im Baumstamm.\n");
    return 1;
  }
  if (!str || (sscanf(str, "%s mit %s", was, womit) != 2)) return 0;

  if (!member((["gegenstand","etwas"]),was))
    return write("Was willst Du nehmen?\n"), 1;

  if (!waffe=present(womit,TP))
    return write("'"+womit+"' hast Du nicht dabei!\n"), 1;

  if (waffe->QueryProp(P_WEAPON_TYPE) != WT_CLUB)
    return write("Du solltest es besser mit einem Stock versuchen.\n"), 1;

  if (waffe->QueryProp(P_WIELDED) != TP)
    return write("Du solltest "+waffe->name(WEN,1)+" schon zuecken.\n"), 1;

  if (!ei_da)
    return write("Da ist kein Gegenstand. ;)\n"), 1;

  ei=clone_object( OBJ "ei" );
  ret=ei->move(this_player(), M_GET);

  if (ret<0) {
    ei->move(this_object(), M_NOCHECK);
    write( break_string("Du stocherst in dem Loch herum und siehe da! "
           "Du ziehst ein rundes Ei aus dem Loch heraus! Leider ist "
           "es Dir zu schwer, sodass Du es nicht gleich einstecken "
           "kannst.", 78) );
  }
  else
    write( break_string("Du stocherst in dem Loch herum und siehe da! "
           "Du ziehst ein rundes Ei aus dem Loch heraus, "
           "das Du gleich einsteckst.", 78) );

  ei_da=0;
  WLOG( LOG "ei", "findet das Ei");  
  say(BS(TP->Name()+" holt was mit einem Hilfsmittel aus dem Loch heraus."));

  return 1;
}


greife( str ) {
  notify_fail( "Wo willst Du reingreifen?\n" );
  if( str == "in loch" || str=="loch" || str == "in oeffnung" || str == "oeffnung")	{
    write( break_string("Du greifst in das Loch. Ganz hinten kannst Du "
                        "Etwas erfuehlen. Doch Du kommst nicht ran.", 78) );
    say(BS(CAP_TPN+" greift in ein Loch im Baumstamm.\n"));
    return 1;
  }
  return 0;
}

 
kletter( str ) {
  notify_fail( "Was willst Du erklettern?\n" );
  if( str == "astgabel" || str == "zur astgabel" )
  {
    if (!TP->do_exhaust(200)) return 1;         // Erschoepfend
    write( break_string("Du kletterst also noch weiter hinauf.\n", 78) );
    this_player()->move( ROOM "baum2.lpc", M_GO, 0,
        "klettert noch hoeher" , "setzt sich neben Dich");
    return 1;
  }
  return 0;
}

