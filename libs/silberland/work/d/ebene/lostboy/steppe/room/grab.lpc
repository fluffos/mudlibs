//mod by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include "../def.h"

#define ENTERLOG "/d/ebene/lostboy/steppe/log/grab_enter"

nosave mapping entered = ([]);

create() {
   ::create();
   SetProp( P_INT_SHORT, "Treppe zur Grabkammer" );
   SetProp( P_INT_LONG,"Die Steintreppe fuehrt etwa vier Meter tief in "
                       "den Boden hinab. Sie endet in einer Grabkammer, "
                       "die Du nach unten hin betreten kannst. Nach oben "
                       "kommst Du wieder hinaus in die frische Luft. " 
                       "An der Wand haengt ein kleines Taefelchen.");
   SetProp( P_LIGHT, 1 );
   SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
   SetProp( P_INDOORS, 0 );


  AddDetail( ({"decke"}),
      "Die Decke besteht aus Erde.");
   AddDetail( ({"luft"}),
       "Die Luft ist etwas stickig hier.");
   AddDetail( ({"gruft"}),
       "Du befindest Dich in einer Grabkammer, auch Gruft genannt.");
   AddDetail( ({"meter"}),
       "4 Meter!");
  AddDetail( ({ "steintreppe", "treppe" }), 
          "Die Treppe fuehrt von oben nach unten. Also, entweder in die "
          "Freiheit oder in die Grabkammer. ");  

  AddDetail( ({ "freiheit" }), 
          "Dort unten in der Grabkammer wirst Du diese sicher nicht finden.");  

  AddDetail( ({ "grab", "grabkammer" }), 
          "Es ist zu dunkel, um etwas zu sehen. Du musst schon hinein"
          "gehen.");

  AddDetail( ({ "wand", "waende", "gang", "erdreich" }), 
          "Der Gang in die Gruft wurde in das Erdreich gegraben. In diesem "
          "Teil wurde auf schoene Kuenstlereien verzichtet. An einer Wand "
          "haengt ein Taefelchen.");  

  AddDetail( ({ "kuenstlereien" }), 
          "Gibts hier nicht.");  
/*
  AddDetail( ({ "wasser" }), 
          "Gibts hier auch nicht. Wenn Du Cola untersuchst, werden Dir 50 "
          "Lebenspunkte abgezogen.");  

  AddDetail( ({ "Cola" }), 
          "Wah, der Erschaffer dieses Raums hasst Scripts. Du hast beinahe "
          "50 LE abgezogen bekommen. Anscheinend willst Du in "
          "echte Schwierigkeiten kommen !!!");  

  AddDetail( ({ "schwierigkeiten" }), 
          "Eros, der Sheriff im SL wird von Deinem Vorgehen unterrichtet. "
          "Jedoch nur wenn Du Selbstmord untersuchst !!!! "
          "Noch was, wenn Du es wirklich wagen solltest, Selbstmord zu "
          "untersuchen, dann wird Dir der Zugang in die Steppe "
          "in Zukunft fuer immer verwehrt bleiben. "
          "ACHTUNG nochmal, das ist kein Witz.");

  AddSpecialDetail( ({ "selbstmord" }), "d_selbstmord");
*/
  AddDetail( ({ "taefelchen" }), 
          "Es besteht aus Bronze. Darauf steht etwas geschrieben.");  

  AddDetail( ({ "bronze" }), 
          "Das Taefelchen besteht daraus.");

  AddDetail( ({ "boden" }), 
          "Nebelschwaden, die von unten aus der Gruft kommen "
          "lassen den Boden verschwinden. Unter der Nebeldecke, laesst sich "
          "eine Treppe ertasten.");

  AddDetail( ({ "nebel", "nebelschwaden", "schwaden", "nebeldecke", }), 
          "Unheimlich umschlingen sie Deine Fuesse.");  

  AddReadDetail( ({ "taefelchen" }), 
          "Stoert nicht die Ruhe der Toten. Oder ihr seid des Todes.");


  AddSound( DEFAULT_SOUND,
          "Von unten aus der Grabkammer kommen leise Geraeusche." );

  AddSound( ({ "geraeusche" }),
          "Schluerf...tap tap...kriech...greisch...hack... " );

  AddSmell( DEFAULT_SMELL,
          "Deine Nase sagt Dir: Kehr um!" );

  AddExit( "raus", "./steppe3" );
  AddExit( "unten", "./grab2" );
}

d_selbstmord()
{
  WLOG( LOG "script", "untersucht Selbstmord");
  return "Das war ein Fehler. Du bist notiert.\n";
}

void init() {
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt das Grab.\n",
    dtime(time()), CAP(getuid(TP))));
}
