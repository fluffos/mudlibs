inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include "detail.h"


#define ENTERLOG "/d/ebene/lostboy/steppe/log/steppe1_enter"
#define SCORPIONS 1

nosave mapping entered = ([]);


int number;


create()
{
  ::create();
  number = 2;
  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG, 
    "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
    "ausdehnt. Weitab von dem Trampelpfad, den Du noerdlich verlassen "
    "hast. Die Steppe scheint sehr einsam zu sein. Du fuehlst Dich "
    "verlassen. Ein Meer von Gras bewegt sich sanft im ewigen Wind "
    "der Steppe. Hier und da entdeckst Du ein paar Baeume, Buesche "
    "und Straeucher. Du bemerkst gleich, dass es hier wohl schon "
    "lange nicht mehr geregnet hat, denn die Steppe ist voellig "
    "ausgetrocknet. Ausserdem siehst Du noch ein Schild, das in "
    "den Boden gesteckt wurde.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));

  RECENT1
  
  AddDetail( ({ "steppe", "gegend" }), 
    "Genau so hast Du Dir eine Steppe immer vorgestellt. "
    "Fad, trocken, einsam und heiss. Richtung Sueden wird die "
    "Gegend zunehmend ebener, Huegel sind keine mehr zu sehen.");

  AddDetail( ({ "norden", }), 
    "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras.");

  AddDetail( ({ "pfad", "trampelpfad" }), 
    "Du hast den kleinen Pfad durch die Steppe schon lange verlassen.");

  AddDetail( ({ "wind", }), 
    "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
    "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
    "eines Meeres aus.");

  AddDetail( ({ "halme", "grashalme", "gras" }), 
    "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. Es ist schon "
    "richtig ausgetrocknet von der stechenden Sonne. In dem Gras liegt ein "
    "ein bisschen groesserer Stein.");

  AddDetail( ({ "stein", }), 
    "Der Stein liegt recht lose im Gras. Er laesst sich leicht zur Seite "
    "rollen.");

  AddDetail( ({ "schild", "holzschild" }), 
    "Du siehst ein Holzschild, auf dem was geschrieben steht.");

  AddDetail( ({ "wellen", "meer" }), 
    "Das war doch nur eine Metapher.");

  AddDetail( ({ "gesicht", }), 
    "Du bekommst schon einen leichten Sonnenbrand.");

  AddDetail( ({ "baeume", }), 
    "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du "
    "siehst, sind sehr ausgetrocknet und tragen keine Blaetter.");

  AddDetail( ({ "baum" }),
    "Auf einen kannst Du versuchen zu klettern.");

  AddDetail( ({ "blaetter", }), 
    "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen.");

  AddDetail( ({ "buesche", }), 
    "Hier und da wehen im Wind ein paar dornige Buesche.");

  AddDetail( ({ "straeucher", }), 
    "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
    "Anscheinend erhalten sie zu wenig Wasser.");

  AddDetail( ({ "wasser", }), 
    "Davon hat die Steppe eindeutig zuwenig.");

  AddDetail( ({ "himmel", "sonne" }), 
    "Die Sonne strahlt blendend weiss vom Himmel.");

  AddDetail( ({ "boden", "erde" }), 
    "Hm, eigentlich siehst Du nur Gras. Oh, und ein Loch.");

  AddDetail( ({ "loch" }), 
    "Das Loch kannst Du mit 'unten' betreten.");

  AddDetail( ({ "metapher", }), 
    "Immer diese Fremdwoerter.");

  AddDetail( ({ "huegel", }), 
    "Weiter im Norden kannst Du noch die Spitze eines Huegels sehen, Richtung "
    "Sueden jedoch wird die Steppe eben.");

  AddDetail( ({ "spitze", }), 
    "Eigentlich hat ein Huegel gar keine Spitze. War wohl eine Fatamorgana.");

  AddSound( DEFAULT_SOUND,
            "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );

  AddSmell( DEFAULT_SMELL,
            "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );

  AddReadDetail( ({ "schild", "holzschild" }), 
    "Willkommen in der Steppe. Hier wirst Du hoffentlich finden "
    "was Du suchst. Falls Du Fragen ueber die Steppe hast dann "
    "komm mich mal besuchen. Vielleicht kann ich Dir helfen. "
    "Gez. Gerio ");

  AddCmd( ({ "kletter", "klettere", "erkletter", "erklettere" }), "kletter" );
  AddCmd( ({ "rolle", "roll" }), "rolle" );

  AddItem( NPC "ratte", REFRESH_DESTRUCT);
  AddItem( NPC "ratte", REFRESH_DESTRUCT);
  //AddItem( NPC "ratte", REFRESH_DESTRUCT);
  
// 	AddItem( NPC "ht2", REFRESH_DESTRUCT);

  AddExit( "nordwesten", "/d/ebene/creative/feldlager/room/b4_a9" );
  AddExit( "sueden", "./steppe4" );
  AddExit( "osten", "./steppe2" );

  number = SCORPIONS;  //number set to 1 scorpion per reset

}


kletter( str ) {
  notify_fail( "Was willst Du erklettern?\n" );
  if( str == "auf baum" || str == "baum" )
  {
    if (!TP->do_exhaust(200)) return 1;         // Erschoepfend
    if (TP->QueryProp(P_HP) < 10) {
      write("Du bist doch schon fast tot, "
          "wieso willst Du da noch auf einen Baum klettern?\n");
      return 1;
    }
    write( break_string("Du kletterst auf den Baum. "
          +"Als Du fast oben angekommen bist, loest sich ein Ast unter Deinen "
          +"Fuessen. Aber Du hast Glueck, Dein Hinterteil bremst den freien "
          +"Fall.", 78) );

    this_player()->AddHp(-10);
    say(this_player()->Name(WER)+" klettert und faellt von einem Baum.\n");
    return 1;
  }
  return 0;
}


rolle(string str) {
  notify_fail("Was moechtest Du rollen?\n");
  if (!str) return 0;
  if (str != "stein" && str != "stein zur seite") return 0;

  if (!TP->do_exhaust(20)) return 1;          // Erschoepfend

  if ( (number) && (!present("skorpion")) )
  {
    write(break_string("Du rollst den Stein beiseite. Unter dem Stein "
          "findest Du ein Loch voll mit Skorpionen. Du scheinst ein Nest "
          "entdeckt zu haben! Voller Schreck rollst Du den Stein "
          "wieder zurueck. Doch Du warst nicht schnell genug. "
          "Ein Skorpion konnte durch Deine Hilfe in die Freiheit "
          "gelangen.", 78) );
    say(break_string(this_player()->Name()+" rollt einen Stein zur "
          "Seite und befreit, vielleicht sogar unbeabsichtigt, "
          "einen Skorpion.",78));
    number--;
    clone_object(NPC "skorpion")->move(TO, M_GO);
  }
  else
  {
    write("Du rollst den Stein zur Seite, aber nix passiert.\n");
    say(TP->Name()+" rollt einen Stein zur Seite, "
        "aber nix passiert.\n");
  }
  return 1;
}


reset() { 
  ::reset();
  number = SCORPIONS;  //number set to 1 scorpion per reset
}

void init() {
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG, sprintf ("%s: %s betritt die Steppe.\n",
                                 dtime(time()), CAP(getuid(TP))));
}

