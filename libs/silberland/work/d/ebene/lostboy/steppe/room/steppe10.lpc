
//losti
//modified by arth

inherit "std/room";


#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include "detail.h"

int kraut_da;

create() {
  ::create();

  kraut_da=1;

  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
    "ausdehnt. Grosse Huegel versperren Dir den weiteren Weg nach Sueden. "
    "Nur oestlich entdeckst Du eine Moeglichkeit, Dir den Weg durch die "
    "Huegel zu bahnen. Die Steppe scheint sehr einsam zu sein. Du fuehlst "
    "Dich verlassen. Ein Meer von Gras bewegt sich sanft im ewigen Wind "
    "der Steppe. Hier und da entdeckst Du ein paar Baeume, Buesche und "
    "Straeucher. Du bemerkst gleich, dass es hier wohl schon lange nicht "
    "mehr geregnet hat, denn die Steppe ist voellig ausgetrocknet."  );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  SetProp( P_INDOORS, 0 );

  RECENT1

  AddDetail( ({ "steppe", "gegend" }), 
    "Genau so hast Du Dir eine Steppe immer vorgestellt. "
    "Fad, trocken, einsam und heiss. "
    "Weiter im Sueden versperren Dir ein paar Huegel das weiterkommen." );

  AddDetail( ({ "norden", }), 
   "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras." 
   );


  AddDetail( ({ "pfad", "trampelpfad" }), 
    "Du hast den kleinen Pfad durch die Steppe schon lange verlassen." 
   );

  AddDetail( ({ "wind", }), 
    "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
    "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
    "eines Meeres aus." 
  );

  AddDetail( ({ "halme", "grashalme", "gras" }), 
    "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. "
    "Es ist schon richtig ausgetrocknet von der stechenden Sonne."
   );

  AddDetail( ({ "wellen", "meer" }), 
    "Das war doch nur eine Metapher." 
   );

  AddDetail( ({ "gesicht", }), 
    "Du bekommst schon einen leichten Sonnenbrand." 
   );

  AddDetail( ({ "baeume", }), 
    "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du siehst, "
    "sind sehr ausgetrocknet und tragen keine Blaetter." 
   );

  AddDetail( ({ "blaetter", }), 
    "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen." 
   );

  AddDetail( ({ "buesche", "dornbuesche" }), 
    "Hier und da wehen im Wind ein paar dornige Buesche. " 
    "Nur die Huegel hier im Sueden sind uebersaet mit Massen von ihnen. "
    "Zwischen den Bueschen wachsen ein paar Blumen."          
     );

  AddDetail( ({ "straeucher", "strauch"}), 
    "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
    "Anscheinend erhalten sie zu wenig Wasser."
   );

  AddDetail( ({ "wasser", }), 
    "Davon hat die Steppe eindeutig zuwenig." 
   );


  AddDetail( ({ "himmel", "sonne" }), 
    "Die Sonne strahlt blendend weiss vom Himmel." 
    );

  AddDetail( ({ "boden", "erde" }), 
    "Hm, eigentlich siehst Du nur Gras." 
   );

  AddDetail( ({ "metapher", }), 
    "Immer diese Fremdwoerter." 
   );

  AddDetail( ({ "anwendung", }), 
    "Wenn Du sie kennst, dann wende sie doch an. Wenn nicht, so finde "
    "sie heraus." 
   );

  AddDetail( ({ "exemplar", "heilpflanze", "pflanze" }), 
    "Es ist zwar nur eine, aber auch die kann Dir sehr nuetzlich sein." 
   );

  AddDetail( ({ "huegel", "sueden" }), 
    "Die Huegel im Sueden sind mit dornigen Bueschen uebersaet. "
    "An Freihacken ist gar nicht zu denken."
    );

  AddDetail( ({ "moeglichkeit", "stelle" }), 
    "An einer Stelle wachsen die Dornbuesche nicht so dicht. Dort "
    "kannst Du in oestlicher Richtung weitergehen." 
   );

  AddSpecialDetail(({"blumen"}), "kraut_fun");
  AddSpecialDetail(({"steppenkraut","blume","kraut"}), "d_steppenkraut");

  AddSound( DEFAULT_SOUND,
    "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );

  AddSmell( DEFAULT_SMELL,
    "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );

  AddCmd( ({ "kletter", "klettere" }), "kletter" );
  AddCmd( ({ "nimm", "pfluecke", "pflueck" }), "nimm_kraut" );
  AddCmd( ({ "trenn", "trenne" }), "trenne" );

  AddExit( "norden", "./steppe8" );
  AddExit( "osten", "./steppe11" );
}



string kraut_fun() {
  if (kraut_da)
     return "Du hast ein Exemplar des seltenen Steppenkrauts gefunden!\n";
  return "Leider sind im Moment alle Blumen abgepflueckt.\n";
}

string d_steppenkraut() {
  if (kraut_da)
    return "Beim Steppenkraut handelt es sich um eine kostbare Heilpflanze.\n"
           "Bei richtiger Anwendung kann sie Deine Wunden heilen.\n";
  return "Du suchst den Boden ab, kannst aber nirgendwo Steppenkraut finden.\n";
}


reset() {
  ::reset();
  kraut_da=1;
}


nimm_kraut(string str)
{
  notify_fail("Was willst Du denn nehmen?\n");
  if (!str) return 0;
  if (member((["steppenkraut","kraut","heilpflanze"]),str)) {
    if (kraut_da) {
      write(break_string("Du pflueckst das Steppenkraut ab. Ohh, bist Du "
            "wieder mal ungeschickt. Jetzt hast Du die Blume kaputt gemacht. "
            "Du brauchst wohl eine andere Technik.", 78) );
      kraut_da = 0;
      say(this_player()->Name(WER)+" zerstoert eine Blume beim Pfluecken.\n");
      RemoveDetail("steppenkraut");
    } else {
      write("Es ist ja gar kein Kraut da!\n");
    }
    return 1;
  }
  return 0;
}


kletter( str )
{
  notify_fail( "Was willst Du erklettern?\n" );
  if( str == "auf baum" || str == "baum" ) {
    if (!TP->do_exhaust(200)) return 1;         // Erschoepfend
    write( break_string("Du kletterst auf den Baum. "
          "Als Du fast oben angekommen bist, loest sich ein "
          "Ast unter deinen Fuessen. Aber Du hast Glueck, "
          "Dein Hinterteil bremmst den freien Fall.", 78) );
    say(this_player()->Name(WER)+" klettert und faellt von einem Baum.\n");
    TP->AddHp(-5-random(6));
    return 1;
  }
  return 0;
}


trenne( str )
{
  string was, wie, wovon;

  notify_fail( "Wie genau willst Du das machen?\n" );
  if (!str) return 0;

  if (str[<3..]==" ab") str=str[0..<4];         // '... ab' abschneiden
  if (member((["steppenkraut","kraut","blume","heilpflanze"]),str))
    return notify_fail("Wovon willst Du das Steppenkraut (ab-) trennen?\n"),0;

  if (sscanf(str, "%s %s von %s", was, wie, wovon) != 3)
    if (sscanf(str, "%s von %s", was, wovon) != 2) return 0;
    else wie="";

  notify_fail( "Was willst Du wovon (ab-) trennen?\n" );
  if (!member((["steppenkraut","kraut","blume","heilpflanze"]),was)) return 0;

  notify_fail("Wovon willst Du das Steppenkraut (ab-) trennen?\n");
  if (!member((["stengel"]),wovon)) return 0;

  notify_fail("Wie willst Du das Steppenkraut vom Stengel (ab-) trennen?\n");
  if (!member((["vorsichtig","sorgfaeltig","achtsam"]),wie)) return 0;

  if (kraut_da)
  {
    object ob;
    int ret;

    ob=clone_object( OBJ "kraut");
    ret=ob->move(this_player(), M_GET);
    write( break_string("Du trennst die Blume "+wie+" vom Stengel ab, "
          "so wie es Dir geraten worden ist. "
          "Endlich befindet sie sich in deinem Besitz!", 78));
    say(break_string(this_player()->Name(WER)+
            " trennt eine Blume "+wie+" von ihrem Stengel ab.\n", 78) );
    if (ret<0) {
      write(break_string("Unglaublich, aber die Blume ist Dir doch "
            "tatsaechlich zu schwer! Sie faellt zu Boden, bleibt "
            "jedoch gluecklicherweise ganz.", 78));
      ob->move(this_object(), M_NOCHECK);
    }
    kraut_da = 0;
    WLOG( LOG "krautget", "bekommt das Steppenkraut");  
  }
  else
    write("Es ist ja gar kein Kraut da!\n");

  return 1;
}

