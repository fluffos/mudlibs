
//losti
//mod by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include "../def.h"

void create() {
   ::create();
   SetProp( P_INT_SHORT, "Grabkammer" );
   SetProp( P_INT_LONG,"Die Grabkammer ist etwa drei mal vier Meter gross. "
                       "Eine magische Ausstrahlung erfuellt den Raum. "
                       "Auf niedrigen Podesten stehen zwei Steinsaerge. "
                       "Die Waende und der Boden sind mit Steinplatten "
                       "verlegt worden.");

   SetProp( P_LIGHT, 1 );
   SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
   SetProp( P_INDOORS, 0 );


  AddDetail( ({"decke"}),
      "Die Decke besteht aus Steinplatten.");

  AddDetail( ({ "steinsaerge", "saerge", }), 
          "Die Saerge sind recht schlicht gehalten. Bis "
          "auf eine Inschrift auf jedem Sarg sind keinerlei "
          "Verzierungen an den Saergen angebracht. " 
           );  
  AddDetail( "verzierungen",
      "Keine zu sehen.");

  AddDetail( ({ "grab", "grabkammer", "raum", "kammer" }), 
          "Die Grabkammer ist etwa drei mal vier Meter gross. "
          "Eine magische Ausstrahlung erfuellt den Raum. "
          "Auf niedrigen Podesten stehen zwei Saerge. "    
          "Die Waende und der Boden sind mit Steinplatten " 
          "verlegt worden. "           
          );  

  AddDetail( ({ "steinsarg", "sarg", "sarg von holger jungerle" }), 
          "Von aussen recht uninteressant. Versuch mal, einen zu oeffnen."
           );  

  AddDetail( ({ "inschrift", "inschriften" }), 
          "Du kannst sie lesen.");

  AddReadDetail( ({ "inschrift", "inschriften" }), 
          "Auf einem Sarg steht Holger Jungerle auf dem anderen steht "
          "Miriam Jungerle."
           );  

  AddDetail( ({ "boden", "wand", "waende", "steinplatten", "platten" }), 
          "Die Steinplatten geben dem Raum eine gewisse Art von "
          "Antlitz."
           );  

  AddDetail( ({ "antlitz" }), 
          "Magisch sauber blinken Dir die Steinplatten entgegen. "
           );  

  AddDetail( ({ "skelett", "verstorbene", "holger"}), 
          "Es scheint, als habe Holger noch versucht, sich zu befreien. "
          "Nur noch weisse Knochen sind uebrig. So endet es mit jedem."
           );  
  AddDetail( ({"miriam"}),
      "Sie ist tot.");

  AddDetail( ({ "knochen" }), 
          "Du betrachtest das noch vollstaendige Skelett. Der Unterkiefer "
          "ist heruntergedrueckt."
           );  

  AddDetail( ({ "unterkiefer", "kiefer" }), 
          "Der Unterkiefer ist zugeklappt. Du muesstest ihn aufklappen, "
          "um zu sehen was drinnen ist. "
           );  

  AddDetail( ({ "podest", "podeste" }), 
          "Durch die beiden Podeste in der Grabkammer wirken die beiden "
          "Saerge gigantisch. Sie erfuellen den ganzen Raum mit Schauer."
           );  

  AddDetail( ({ "ausstrahlung", "magie", "luft" }), 
          "Magie liegt in der Luft. Es ist schon soviel, dass Dir das Atmen "
          "immer schwerer faellt."
           );  

  AddDetail( ({ "schauer", "gefuehl" }), 
          "Jetzt wo die beiden Gegner vernichtet sind, ist es nicht mehr "
          "ganz so schlimm. Und doch geben die Saerge ein unheimliches "
          "Gefuehl ab."
           );  

  AddSound( DEFAULT_SOUND,
          "Still wie auf einem Friedhof hier." );

  AddSmell( DEFAULT_SMELL,
          "Hier stinkt es bestialisch. " );

  AddCmd( ({ "oeffne" }), "beweg_etwas" );
  AddCmd( ({ "klappe", "klapp" }), "klapp" );

  AddExit( "oben", "./grab" );

  AddItem( NPC "skelett", REFRESH_DESTRUCT);
  AddItem( NPC "untoter", REFRESH_DESTRUCT);
}

beweg_etwas( str ) {
  notify_fail( "Den Sarg von wem willst Du oeffnen?\n" );
  if( str == "sarg von holger jungerle" || str == "sarg von holger" ) {
    if(present("skelett",ME)) {
      write(BS("Das Skelett hinter Dich am Oeffnen des Sarges!"));
      return 1;
    }
    if(present("untoter",ME)) {
      write(BS("Der Untote hinter Dich am Oeffnen des Sarges!"));
      return 1;
    }
    write( break_string(
          "Du willst schon all Deine Kraft sammeln um die schwere Steinplatte "
          "zur Seite zu schieben, mit der der Sarg verschlossen wurde. "
          "Doch bei Deiner ersten Beruehrung schiebt sie sich wie von "
          "alleine zur Seite. "
          "In dem Sarg liegt ein merkwuerdig verkruemmtes Skelett in einer "
          "Haltung, die darauf schliessen laesst, dass der Verstorbene "
          "lebendig begraben wurde. Vorsichtig schliesst Du den Sarg wieder.",
          78) );
    say(BS(CAP_TPN+" schaut kurz in einen der Saerge.\n"));
    return 1;
  }
  if( str == "sarg von miriam jungerle" || str == "sarg von miriam" ) {
    if(present("skelett",ME)) {
      write(BS("Das Skelett hinter Dich am Oeffnen des Sarges!"));
      return 1;
    }
    if(present("untoter",ME)) {
      write(BS("Der Untote hinter Dich am Oeffnen des Sarges!"));
      return 1;
    }
    write( break_string(
          "Du willst schon all Deine Kraft sammeln um die schwere Steinplatte "
          "zur Seite zu schieben, mit der der Sarg verschlossen wurde. Doch "
          "bei Deiner ersten Beruehrung schiebt sie sich wie von alleine zur "
          "Seite. Mit Entsetzen stellst Du fest, dass in diesem Sarg die "
          "Leiche fehlt. Ein leerer Sarg. Das ist kein gutes Omen. "
          "Vorsichtig schliesst Du den Sarg wieder.", 78) );
    say(BS(CAP_TPN+" schaut kurz in einen der Saerge.\n"));
    return 1;
  }
  if (str == "sarg")
  {
    write("Welchen der beiden Saerge willst Du oeffnen?\n");
    return 1;
  }
  return 0;
}

klapp( str ) {
  notify_fail( "Was willst Du aufklappen?\n" );
  if( str == "unterkiefer auf" || str == "kiefer auf" ) {
    if (!TP->FindPotion(BS("In dem Kiefer findest Du ein kleines unscheinbares "
                          +" Flaeschchen, das Du sofort austrinkst.")))
      write( break_string("In dem Kiefer scheint mal etwas gelegen zu haben. "
            "Aber da scheint Jemand schneller gewesen zu sein als Du.\n", 78) );
    WLOG( LOG "unterkiefer", "klappt den Unterkiefer auf");
    say(break_string(this_player()->Name(WER)+
          " fummelt in einem Sarg herum.\n", 78));
    return 1;
  }
  return 0;
}
