
//losti
//modified by arth

inherit "std/room";


#include <properties.h>
#include <language.h>
#include <moving.h>
#include "detail.h"

string *gewarnt = ({});
#define WARNED (member(gewarnt, getuid(this_player())) != -1)
#define ANSCHLUSS_WUESTE "/d/wueste/arthoas/erg/room/valley/raum33"

void seek_player();

create() {
  ::create();
  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
    "ausdehnt. Weit im Nordosten erkennst Du schon die unueberwindbaren "
    "Berge, hinter denen eine weite grosse Wueste liegen soll. "
    "Ausser dem Pfeifen des Windes, ist kein Ton zu hoeren. Diese Ruhe "
    "macht Dir Angst. Die Steppe scheint sehr einsam zu sein. Du fuehlst "
    "Dich verlassen. Ein Meer von Gras bewegt sich sanft im ewigen Wind "
    "der Steppe. Hier und da entdeckst Du ein paar Baeume, Buesche und "
    "Straeucher. Du bemerkst gleich, dass es hier wohl schon lange nicht "
    "mehr geregnet hat, denn die Steppe ist voellig ausgetrocknet."  );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  SetProp( P_INDOORS, 0 );

  SetProp(P_KILL_NAME, "Treibsand");

  RECENT1

  AddDetail( ({ "steppe", "gegend" }), 
          "Genau so hast Du Dir eine Steppe immer vorgestellt. "
          "Fad, trocken, einsam und heiss." );

  AddDetail( ({ "norden", }), 
          "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras." 
         );

  AddDetail( ({ "pfad", "trampelpfad" }), 
          "Du hast den kleinen Pfad durch die Steppe schon lange verlassen." 
         );

  AddDetail( ({ "wind", }), 
          "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
          "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
          "eines Meeres aus." 
         );

  AddDetail( ({ "halme", "grashalme", "gras" }), 
          "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. Es ist schon richtig " 
          "ausgetrocknet von der stechenden Sonne."
         );

  AddDetail( ({ "wellen", "meer" }), 
          "Das war doch nur eine Metapher." 
         );

  AddDetail( ({ "gesicht", }), 
          "Du bekommst schon einen leichten Sonnenbrand." 
         );

  AddDetail( ({ "berge", "wueste" }), 
          "Das liegt weit im Nordosten, jetzt bist Du erstmal in der "
          "nicht ganz zu heissen Steppe. " 
         );

  AddDetail( ({ "baeume", }), 
          "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du siehst, "
          "sind sehr ausgetrocknet und tragen keine Blaetter." 
         );

  AddDetail( ({ "blaetter", }), 
          "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen." 
         );

  AddDetail( ({ "buesche", }), 
          "Hier und da wehen im Wind ein paar dornige Buesche." 
         );

  AddDetail( ({ "straeucher", "strauch" }), 
          "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
          "Anscheinend erhalten sie zu wenig Wasser."
         );

  AddDetail( ({ "wasser", }), 
          "Davon hat die Steppe eindeutig zuwenig." 
         );


  AddDetail( ({ "himmel", "sonne" }), 
          "Die Sonne strahlt blendend weiss vom Himmel." 
         );


  AddDetail( ({ "boden", "erde" }), 
          "Hm, eigentlich siehst Du nur Gras." 
         );


  AddDetail( ({ "metapher", }), 
          "Immer diese Fremdwoerter." 
         );

  AddDetail( ({ "ton", "ruhe", "angst" }), 
          "Wenn das so weiter geht, faengst Du wohl noch an mit Dir selber zu reden." 
         );

 
  AddDetail( ({ "pfeifen", }), 
          "Du pfeifst ein lustiges Lied. Gleich fuehlst Du Dich besser." 
         );

  AddSound( DEFAULT_SOUND,
    "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt. " );

  
  AddSmell( DEFAULT_SMELL,
    "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );

  AddExit( "sueden", "./steppe8" );
  AddExit( "westen", "./steppe4" );
  AddExit( "norden", "./steppe2" );

  AddExit("osten",
      ([ EX_FUNC : "head_east" ]) );
}

mixed _query_hide_exits()
{
  if ( !this_player() || !interactive(this_player()) ||
      present("\nquicksand", this_player()) )
    return 0;
  else
    return ({"osten"});
}

reset() {
  ::reset();
  gewarnt = ({});
}


void init() {
  ::init();
  if (!this_player() || !interactive(this_player())) return;
  gewarnt -= ({ getuid(this_player()) });
}


head_east(string dir) {
  object obj;
  int ran_num;

  
  
  if (this_player()->QueryGuest() ||
      !present("\nquicksand",this_player()))
    return notify_fail("In diese Richtung kannst Du noch nicht gehen.\n"),0;

  if (obj=present("\nssandschuhe", this_player()))
  {
    if (obj->QueryProp(P_WORN)==this_player())
    {
      write(break_string("Da Du den beschwerlichen und nicht gerade "
          "ungefaehrlichen Weg schon einmal bewaeltigt hast, machst "
          "Du Dich Deiner Sache sicher auf den Weg nach Osten, durch "
          "den Treibsand, um kurz darauf in der Wueste anzukommen.", 78) );

      say(break_string(this_player()->Name()+
            " entschwindet Deinen Blicken nach Osten.", 78));

      return ANSCHLUSS_WUESTE;
    }   // ...P_WORN...
    else
      return notify_fail("Du hast die erforderliche Ausruestung "
          "nicht angezogen.\n"), 0;
  }
  else  // ...present("\nssandschuhe")...
  {
    if (!WARNED)
    {
      write(break_string("Du bist Dir ploetzlich gar nicht mehr so sicher, "
        "ob Du ueberhaupt schon bereit bist nach Osten zu gehen, vielleicht "
        "solltest Du ja sicherheitshalber nochmal Deine Ausruestung "
        "ueberpruefen. So mancher ist im Treibsand einfach spurlos "
        "verschwunden...", 78) );
      say(break_string(this_player()->Name()+" will nach Osten gehen, haelt "
        "dann aber doch noch einmal inne, um diese Entscheidung noch "
        "einmal zu ueberdenken.", 78) );
      gewarnt += ({getuid(this_player())});
      return 1;
    }
    else      // already WARNED...
    {
      write(break_string("Du begibst Dich wagemutig Schritt fuer Schritt "
              "immer tiefer in den Treibsand.", 78) );
      say(break_string(this_player()->Name()+
              " wagt sich immer tiefer in den Treibsand.", 78) );

      switch (random(25+this_player()->QueryAttribute(A_DEX)))
      {
        case 0 .. 8:
          write(break_string("Aber erst jetzt, in der Stunde Deines Todes, "
                  "erkennst Du Deinen Fehler.\n", 78)+"\n" );
          say(break_string(this_player()->Name()+
                " versinkt hilflos im Treibsand.", 78));
          this_player()->die();
          return 1;

        default:
          write(break_string("Ploetzlich bemerkst Du, wie Du immer tiefer "
            "einsinkst, und kannst Dich gerade noch rechtzeitig aus dem "
            "Treibsand retten.", 78));
          say(break_string(this_player()->Name()+" ist dem toedlichen "
            "Treibsand im letzten Augenblick noch einmal entkommen.", 78));
          return 1;
      }  // ...switch()
    }   // ...WARNED
  }   // ...present("\nssandschuhe")
}
