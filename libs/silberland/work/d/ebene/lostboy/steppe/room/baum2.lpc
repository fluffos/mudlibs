
//losti
//modified by arthoas

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"


create() {
  ::create();
  SetProp( P_INT_SHORT, "Astgabel" );
  SetProp( P_INT_LONG,
    "Mit letzter Kraft hast Du es doch noch nach ganz oben geschafft. "
   +"Du setzt Dich auf die bequeme Astgabel, von der aus Du einen "
   +"bombastischen Ausblick hast. ");
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:30]) );
  SetProp( P_INDOORS, 0 );

  AddDetail( ({ "boden", }), 
      "Der Boden unter Dir wird von der Astgabel gebildet.");

  AddDetail( ({"ast", "gabel"}),
      "Der Ast bildet hier eine Gabel, das ist dann eine sogenannte Astgabel.");
  AddDetail( ({ "astgabel", }), 
          "Die Astgabel laedt richtig zum Entspannen ein. "
          "Hier oben ist echt traumhaft schoen und Du hast mal "
          "keine Angst von einem dummen Monster angegriffen zu werden." );

  AddDetail( ({ "entspannen" }), 
          "Du entspannst Dich. Ah, tut das gut!" );

  AddDetail( ({ "gabel" }), 
          "Suchst Du was zum Essen? Geh doch in eine Kneipe.");  

  AddDetail( ({ "kraft","klettertour" }), 
          "Die Klettertour in dieser Hitze hat Dir gar nicht gut "
          "getan. Du solltest Dich erstmal erholen hier oben.");  

  AddDetail( ({ "angst", "monster" }), 
          "Sowas gibts hier nicht." );

  AddDetail( ({ "ausblick" }), 
          "Der Ausblick ist einfach herrlich. In welche Richtung "
          "moechtest Du denn schauen?" );

  AddDetail( ({ "richtung", "richtungen" }), 
          "Da gibt es Norden, Sueden, Westen, Osten, Suedwesten, "
          "Suedosten, Nordwesten, Nordosten, Oben, Unten und die Mitte." );

  AddDetail( ({ "norden" }), 
          "Im Norden erblickst Du die trockene Steppe. Ausserdem "
          "kannst Du einen Huegel sehen." );  

  AddDetail( ({ "sueden" }), 
          "Richtung Sueden erstreckt sich die endlose Steppe. Sie "
          "scheint kein Ende zu nehmen. Weit weit entfernt soll angeblich "
          "eine Sandwueste sein. ");

  AddDetail( ({ "westen" }), 
          "Auch hier nur Steppe. Weit im Westen erkennst Du noch ein "
          "Zeltlager." );  

  AddDetail( ({ "osten","wueste" }), 
          "Weit im Osten kannst Du schon die Wueste erkennen.");  

  AddDetail( ({ "suedwesten" }), 
          "Steppe ohne Ende. Dieser Teil der Steppe schaut recht "
          "trostlos aus. Aber was ist das? Ein alter Mann trottet "
          "dort durch die Gegend." );  

  AddDetail( ({ "suedosten" }), 
          "Im Suedosten wird es etwas huegeliger. Auf einem der Huegel "
          "sind besonders viele und grosse Felsen.");  

  AddDetail( ({ "nordosten", "nordwesten" }), 
          "Ist das eine Steppe oder eine Steppe, was Du dort siehst?");  

  AddDetail( ({ "oben", "rauf" }), 
          "Blauer Himmel und eine Sonne.");

  AddDetail( ({ "himmel", "sonne" }), 
          "Haettest Du doch nur Sonnenmilch mitgenommen." ); 

  AddDetail( ({ "sonnenmilch", "milch" }), 
          "Dann koenntest Du Dich hier schoen braeunen lassen. :)" ); 

  AddDetail( ({ "unten", "runter" }), 
          "Blaetter, Aeste, Stamm, ... "
          "Sie versperren Dir die Sicht.");  
  
  AddDetail( ({ "blaetter", "aeste" }), 
          "Sie versperren Dir immer noch die Sicht." );

  AddDetail( ({ "baumstamm", "stamm", "baum" }), 
          "Der ist natuerlich unter Dir." );

  AddDetail( ({ "mitte" }), 
          "Du schaust Dich an.");  

  AddDetail( ({ "hitze", "schatten" }),
          "Kein Schatten hier oben. Die Sonne brennt gnadenlos "
          "auf Dich herab.");

  AddDetail( ({ "huegel", "mann", "steppe", "wueste", "felsen",
              "sandwueste", "lager", "zeltlager", "huette",
              "holzhuette", "mann", "gegend",  }), 
          "Es sieht von hier oben alles so winzig aus. Du solltest "
          "naeher hingehen.");  

  AddSound( DEFAULT_SOUND,
          "Der Wind blaest hier oben ein wenig und vermittelt Dir ein "
          "angenehmes Gefuehl." );

  AddSmell( DEFAULT_SMELL,
          "Der Baum riecht frisch." );

  AddSmell( ({ "baum" , "frische" }),
          "Frisch, frischer, am frischesten.");

  AddExit( "unten", "./baum" );
}
