inherit "std/room";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include "detail.h"

int strauch = 1;

create() {
  ::create();

  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG,
   "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
   "ausdehnt. Weitab von dem Trampelpfad, den Du noerdlich verlassen hast. "
   "Weit im Osten erkennst Du schon die unueberwindbaren Berge, hinter denen "
   "eine weite grosse Wueste liegen soll. "  
   "Die Steppe scheint sehr einsam zu sein. Du fuehlst Dich verlassen. "
   "Ein Meer von Gras bewegt sich sanft im ewigen Wind der Steppe. "
   "Hier und da entdeckst Du ein paar Baeume, Buesche und Straeucher. "
   "Du bemerkst gleich, dass es hier wohl schon lange nicht mehr geregnet hat, "
   "denn die Steppe ist voellig ausgetrocknet."  );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));

  RECENT1

  AddDetail( ({ "steppe", "gegend" }),
     "Genau so hast Du Dir eine Steppe immer vorgestellt. "
     "Fad, trocken, einsam und heiss. Richtung Sueden wird die "
     "Gegend zunehmend ebener, keine Huegel sind mehr zu sehen.");

  AddDetail( ({ "norden" }),
     "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras.");

  AddDetail( ({ "loesung" }),
     "Hack den Strauch um und besorg Dir vorher eine passende Waffe.");

  AddDetail( ({ "waffe" }),
     "Ein Messer oder ein Schwert waer hier sehr gut geeignet.");

  AddDetail( ({ "messer", "schwert" }),
     "Hast Du sowas dabei?");

  AddDetail( ({ "pfad", "trampelpfad" }),
     "Du hast den kleinen Pfad durch die Steppe schon lange verlassen.");

  AddDetail( ({ "wind" }),
     "Der ewige Wind der Steppe blaest Dir unbarmherzig ins Gesicht. "
     "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
     "eines Meeres aus.");

  AddDetail( ({ "halme", "grashalme", "gras" }),
     "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. Es ist schon "
     "richtig ausgetrocknet von der stechenden Sonne. Das Gras hat einen "
     "seltsamen Wuchs. An einigen Stellen waechst es, dann hoert es "
     "wiedermal abrupt auf zu wachsen.");

  AddDetail( ({ "stellen", "wuchs", "bewuchs", "grasbewuchs" }),
     "Du trittst ein paar Meter zurueck, um einen besseren Ueberblick "
     "zu bekommen. Nun erkennst Du es. Der Grasbewuchs bildet einen "
     "Schriftzug.");

  AddDetail( ({ "ueberblick" }),
     "Jetzt kannst Du alles gut uebersehen. Auch die vielen Straeucher.");

  AddDetail( ({ "zug" }),
     "Du siehst hier keine Lokomotive.");

  AddDetail( ({ "schriftzug", "schrift" }),
    "Im Gras steht etwas geschrieben. Vielleicht kann man es ja "+
    "sogar lesen?\n");

  AddReadDetail( ({ "schriftzug", "schrift" }),
     "--------------------\n"
     "| Sargola war hier |\n"
     "--------------------\n");

  AddDetail( ({ "wellen", "meer" }),
     "Das war doch nur eine Metapher.");

  AddDetail( ({ "gesicht", }),
     "Du bekommst schon einen leichten Sonnenbrand.");

  AddDetail( ({ "baeume", }),
     "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du siehst, "
     "sind sehr ausgetrocknet und tragen keine Blaetter.");

  AddDetail( ({ "blaetter", }),
     "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen.");

  AddDetail( ({ "busch", "buesche", }),
     "Hier und da wehen im Wind ein paar dornige Buesche.");

  AddDetail( ({ "straeucher", }),
     "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. "
     "Doch ein Strauch faellt Dir besonders auf, da er hoeher waechst "
     "als die anderen.");

  AddDetail( ({ "strauch", }),
     "Im dichten Strauch entdeckst Du ein Loch im Boden.");

  AddDetail( ({ "loch", }),
     "In dieses Loch wuerdest Du locker reinpassen. Waere da nicht "
     "der grosse Strauch im Weg, mit dem das Loch zugewachsen ist.");

  AddDetail( ({ "wasser", }),
     "Davon hat die Steppe eindeutig zuwenig.");

  AddDetail( ({ "himmel", "sonne" }),
     "Die Sonne strahlt blendend weiss vom Himmel.");

  AddDetail( ({ "boden", "erde" }),
     "Hm, eigentlich siehst Du nur Gras.");

  AddDetail( ({ "metapher", }),
     "Immer diese Fremdwoerter.");

  AddDetail( ({ "huegel", }),
     "Weiter im Norden kannst Du noch die Spitze eines Huegels sehen, Richtung "
     "Sueden jedoch wird die Steppe eben.");

  AddDetail( ({ "spitze", }), 
          "Eigentlich hat ein Huegel gar keine Spitze, "
          "war wohl ne Fatamorgana.");

  AddDetail( ({ "berge", "wueste" }), 
          "Das liegt weit im Osten, jetzt bist Du erstmal in der "
          "nicht ganz zu heissen Steppe.");

  AddSound( DEFAULT_SOUND,
    "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );

  AddSmell( DEFAULT_SMELL,
    "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );


  // AddCmd( ({ "bekomm", "bekomme" }), "bekomme" );
  AddCmd( ({ "reisse", "reiss" }), "reisse" );
  AddCmd( ({ "kletter", "klettere", "betrete" }), "kletter" );
  AddCmd( ({ "hacke", "hack", "haue" }), "hacke" );

  AddItem( NPC "fuchs", REFRESH_DESTRUCT);

  AddExit( "sueden", "./steppe5" );
  AddExit( "westen", "./steppe1" );
}

/*
bekomme( str )  // auskommentiert --- waere sonst ZU einfach...
{
  if (!str || str!="strauch weg")
    return notify_fail("Was willst Du (weg-) bekommen?\n"), 0;
  write("Naja, umhacken waere ein plausibler Weg.\n");
  return 1;
}
*/

kletter( str ) {
  notify_fail( "In was willst Du klettern?\n" );
  if( str == "in loch" || str == "loch" ) {               
    if (strauch) {
      write(break_string("Der Busch hat sich mit dem Loch verwachsen. "
            +"Die beste Loesung waer, den Strauch irgendwie "
            +"wegzubekommen, aber wie?!?", 78) );
      say(this_player()->Name(WER)+" versucht, wo reinzuklettern.\n");
    } else {
      write("Versuch's doch einfach mit \"loch\"! :)\n");
    }
    return 1;
  }
  return 0;
}

hacke( str ) {
  object waffe;
  string w_class;
  string was, womit;

  notify_fail( "Was willst Du womit hacken?\n" );
  if (!str) return 0;

  if (str == "weg frei")
    return write(BS("Moooooment, SO einfach ist es nun auch wieder nicht, Du "
          "musst schon genau angeben, was Du womit hacken willst.")), 1;

  if (str[<3..]==" um") str=str[0..<4];         // vereinfacht weiteres parsen
  if( str == "strauch" || str == "gebuesch" )
  {
    write("Womit willst Du den Strauch denn umhacken?\n");
    return 1;
  }
  if (sscanf(str, "%s mit %s", was, womit) != 2) return 0;

  // WAS will der Spieler grad hacken? (den Mudrechner? neee... ;) ) -woody-
  if (!member((["strauch","gebuesch"]),was))
    return 0;

  // Waffe ueberhaupt dabei?
  if (!waffe=present(womit,TP))
    return write("Aber \""+womit+"\" hast Du doch gar nicht dabei!\n"), 1;

  // Und auch brav gezueckt?
  if (waffe->QueryProp(P_WIELDED) != TP)
    return write(break_string("Also zuecken solltest Du "+waffe->name(WEN,1)+
          " aber schon vorher.",78)), 1;

  // Ist ueberhaupt noch was hackbares da?
  if (!strauch)
    return write("Der Strauch ist doch schon weg ;).\n"), 1;

  if (!TP->do_exhaust(200)) return 1;         // Erschoepfend

  // Geeignete Waffe?
  if (!member(([WT_SWORD,WT_KNIFE,WT_AXE]),waffe->QueryProp(P_WEAPON_TYPE)))
  {
    waffe->TakeFlaw(3);
    write(break_string("Du hackst mit "+waffe->name(WEM,1)+" ein wenig "
          "auf dem Strauch herum, kommst aber nicht wirklich voran. "
          "Vielleicht solltest Du Dir ein besseres Werkzeug besorgen?", 78));
    say(break_string(TP->Name()+" hackt erfolglos mit "+waffe->name(WEM)+
          " auf einen Strauch ein. Du schmunzelst.", 78));
    return 1;
  }

  strauch=0;
  waffe->TakeFlaw(10);
  write(break_string("Du holst mit "+waffe->name(WEM,1)+" aus und hackst "
        "den Strauch um. Jetzt ist der Weg zum Loch endlich frei!", 78) );
  say(TP->Name()+" zerhackt einen Strauch.\n");
  AddExit("loch", "in das Loch#./tunnel1");
  AddDetail( ({ "loch", }), "In dieses Loch wuerdest Du locker reinpassen.");
  return 1;

}

reisse( str ) {
  notify_fail( "Was willst Du ausreissen?\n" );
  if (!str) return 0;
  if (!member((["strauch","strauch aus","strauch raus"]),str)) return 0;

  TP->AddHp(-3-random(4));      // 3..6 LP Abzug
  write(break_string("Du reisst fest am Strauch, aber raus bekommst Du ihn "
        "nicht, er ist einfach zu fest verwachsen. Stattdessen schuerfst Du "
        "Dir die Haende an ein paar Dornen auf. Versuch lieber, Dir den "
        "Weg freizuhacken!", 78) );
  say(BS(TP->Name()+" versucht einen Strauch rauszureissen, verzerrt aber "
        "ploetzlich schmerzerfuellt sein Gesicht."));
  return 1;
}

reset() {
  ::reset();
  if (strauch) return;
  strauch = 1;
  RemoveExit("loch");
  AddDetail( ({ "loch", }),
     "In dieses Loch wuerdest Du locker reinpassen. Waere da nicht "
     "der grosse Strauch im Weg, mit dem das Loch zugewachsen ist.");
  tell_room(this_object(),
      "Gespenstisch schnell waechst ein Strauch empor.\n");
}

