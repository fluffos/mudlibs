
//losti
//modified by arth

inherit "std/room";


#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include "detail.h"


create() {
  ::create();

  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
    "ausdehnt. Es wird unangenehm heiss, denn die Sonne steht an ihrem "
    "hoechsten Punkt. "
    "Die Steppe scheint sehr einsam zu sein. Du fuehlst Dich verlassen. "
    "Ein Meer von Gras bewegt sich sanft im ewigen Wind der Steppe. "
    "Hier und da entdeckst Du ein paar Baeume, Buesche und Straeucher. "
    "Du bemerkst gleich, dass es hier wohl schon lange nicht mehr "
    "geregnet hat, denn die Steppe ist voellig ausgetrocknet."  );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  SetProp( P_INDOORS, 0 );

  RECENT1

  AddDetail( ({ "steppe", "gegend" }), 
    "Genau so hast Du Dir eine Steppe immer vorgestellt. "
    "Fad, trocken, einsam und heiss." );

  AddDetail( ({ "norden", }), 
    "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras." );

  AddDetail( ({ "pfad", "trampelpfad" }), 
    "Du hast den kleinen Pfad durch die Steppe schon lange verlassen." );

  AddDetail( ({ "wind", }), 
    "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
    "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
    "eines Meeres aus." );

  AddDetail( ({ "halme", "grashalme", "gras" }), 
    "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. Es ist schon "
    "richtig ausgetrocknet von der stechenden Sonne.");

  AddDetail( ({ "wellen", "meer" }), 
    "Das war doch nur eine Metapher." );

  AddDetail( ({ "gesicht", }), 
    "Du bekommst schon einen leichten Sonnenbrand." );

  AddDetail( ({ "baeume", }), 
    "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du siehst, "
    "sind sehr ausgetrocknet und tragen keine Blaetter." );

  AddDetail( ({ "blaetter", }), 
    "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen." );

  AddDetail( ({ "buesche", }), 
    "Hier und da wehen im Wind ein paar dornige Buesche. "
    "Doch an einer Stelle haben sich ein paar Buesche und "
    "Straeucher zu einem Gestruepp gebildet." );

  AddDetail( ({ "straeucher", }), 
    "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
    "Anscheinend erhalten sie zu wenig Wasser. "
    "Doch an einer Stelle haben sich ein paar Buesche und "
    "Straeucher zu einem Gestruepp gebildet.");

  AddDetail( ({ "gestruepp", "stelle" }), 
    "Ein paar Buesche und Straeucher bilden das Gestruepp. "
    "Es ist so dicht, dass man nicht ins Innere blicken kann." );

  AddDetail( ({ "innere", "inneres" }), 
    "Das Gestruepp ist so dicht, dass Du dort nichts siehst. Du koenntest "
    "lediglich hineingreifen.");

  AddDetail( ({ "wasser", }), 
    "Davon hat die Steppe eindeutig zuwenig." );

  AddDetail( ({ "himmel", "sonne" }), 
    "Die Sonne strahlt blendend weiss vom Himmel.");

  AddDetail( ({ "boden", "erde" }), 
    "Hm, eigentlich siehst Du nur Gras. "
    "Doch Du entdeckst auf dem Boden ungewoehnlich viele "
    "Fussspuren. " );

  AddDetail( ({ "fussspuren", "spuren", }), 
    "Sie enden alle direkt vor einem Gestruepp aus Bueschen und "
    "Straeuchern. "  );

  AddDetail( ({ "oeffnung", }), 
    "Die Oeffnung fuehrt in den Boden hinab. Von unten steigt ein "
    "ekelhafter Biergestank herauf. " );

  AddDetail( ({ "metapher", }), 
    "Immer diese Fremdwoerter." );

  AddDetail( ({ "punkt", }), 
    "Fast senkrecht ueber Dir befindet sich sie Sonne jetzt." );

  AddSmell ( DEFAULT_SMELL,
        "Ein ekelhafter Biergestank liegt in der Luft.\n");

  AddSmell( ({ "bier", "gestank", "biergestank" }), 
    "Eindeutig Bier. Wo kommt das nur wieder her?" );

  AddSound( DEFAULT_SOUND,
  "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );
 
  AddCmd( ({ "greif", "greife" }), "greife" );
  AddCmd( ({ "kletter", "klettere" }), "kletter" );
  AddCmd( ({ "betrete" }), "betrete" );

  AddExit( "norden", "./steppe1" );
  AddExit( "westen", "./steppe3" );
  AddExit( "sueden", "./steppe7" );
  AddExit( "osten", "./steppe5" );
}


greife( str ) {
  notify_fail( "Wo willst Du reingreifen?\n" );
  if( str == "gestruepp" || str == "in gestruepp" ) {
    write( break_string("Du schiebst ein paar Aeste des Gebuesches beiseite "
          "und entdeckst im Gestruepp eine Oeffnung im Boden.", 78) );
    say(this_player()->Name(WER)+" wuehlt im Gestruepp herum.\n");
    return 1;
  }
  return 0;
}

int betrete( string str ) {
  notify_fail( "Wohin willst Du gehen?\n" );
  if ( str == "oeffnung" || str == "oeffnung im boden" ) {
    write(break_string("Du betrittst die Oeffnung, der eine Treppe nach unten "
         +"folgt. Unten angekommen musst Du staunen. Denn...", 78) );
    this_player()->move( ROOM "kneipe", M_GO, 0, "klettert ins Gebuesch" );
    return 1;
  }
  return 0;
}


kletter( str ) {
  if (betrete(str)) return 1;   // in Oeffnung klettern sollte auch gehen.
  notify_fail( "Wohin willst Du klettern?\n" );
  if( str == "gestruepp" || str == "in gestruepp" ) {
    write(break_string("Bei Deinen Kletterkuensten entdeckst Du "
                      +"mitten im Gebuesch eine Oeffnung im Boden. "
                      +"Vielleicht kommst Du da ja irgendwie rein?", 78) );
    say(break_string(this_player()->Name(WER)+
          " klettert im Gestruepp herum.\n", 78) );
    return 1;
  }
  if (str == "oeffnung" || str == "oeffnung im boden" || 
      str == "durch oeffnung" || str == "runter") {
    write(break_string("Du kletterst durch die Oeffnung, der eine Treppe nach unten "
         +"folgt. Unten angekommen musst Du staunen. Denn...", 78) );
    this_player()->move( ROOM "kneipe", M_GO, 0, "klettert ins Gebuesch" );
    return 1;
  }
  return 0;
}
