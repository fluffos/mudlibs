
//losti
//mod by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

create() {
  ::create();
  SetProp( P_INT_SHORT, "Tunnel der Riesenwuermer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem unterirdischen, dunklen, natuerlichen "
    "Tunnelsystem. Es riecht recht miefig, aber dafuer ist es schoen kuehl "
    "hier unten. Der Hauptstollen in dem Du stehst, hat viele kleine Loecher "  
    "an den Waenden. Allerdings sind sie alle zu klein, um "
    "dort weiterzukriechen.");

  SetProp( P_LIGHT, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "boden", "decke", "wand", "waende" }), 
          "Es besteht alles hier aus fester Erde. In den Waenden befinden "
          "sich Loecher die alle ins dunkle Ungewisse fuehren. In der Decke "
          "erblickst Du eine Oeffnung, die in die Freiheit fuehrt." );

  AddDetail( ({ "ungewisse" }),
          "Du weisst nicht, was Dich erwartet.");

  AddDetail( ({ "freiheit" }), 
          "Nichts ist wichtiger als Freiheit.");

  AddDetail( ({ "druiden", "abenteurer" }), 
          "Wie auch immer, das sind auch nur Menschen." );

  AddDetail( ({ "menschen" }), 
          "Oder Zwerge." );

  AddDetail( ({ "zwerge" }), 
          "Oder Elfen, Hobbits, Trolle, Oger, Feen, oder Dunkelelfen. Wer "
          "weiss das schon so genau..." );

  AddDetail( ({ "elfen","hobbits","trolle","oger","feen","dunkelelfen" }), 
          "Hmpf. Du gibst Dich auch nie mit was zufrieden.");

  AddDetail( ({ "oeffnung" }),
          "Durch die Oeffnung kommst Du in die Steppe zurueck. Er ist mit "
          "einem Strauch verwachsen, doch von hier unten kannst Du eine "
          "kleine Luecke erkennen, durch die Du Dich hindurchzwaengen kannst."); 

  AddDetail( ({ "luecke" }),
          "Um Dir laestige Syntaxsuchereien zu ersparen: Es reicht, "
          "wenn Du \"oben\" eintippst. :-)");

  AddDetail( ({ "syntaxsuchereien" }),
          "Die rauben einem oft den letzten Nerv.");

  AddDetail( ({ "nerv" }),
          "Du nervst. ;)");

  AddDetail( ({ "steppe" }), 
          "Die befindet sich oberhalb von Dir.\n");

  AddDetail( ({ "erde" }), 
          "Druiden wuerden Humus dazu sagen.\n" );

  AddDetail( ({ "strauch" }), 
          "So einen hast Du wohl mal freihacken muessen, um hier "
          "runter zu kommen. Nach oben hast Du eine Luecke entdeckt, "
          "durch die Du einfach durchkommst, ohne Dir den Weg frei"
          "hacken zu muessen." );

  AddDetail( ({ "weg" }), 
          "Gemeint ist der Weg nach draussen.");

  AddDetail( ({ "loecher", "loch" }), 
          "Die Loecher wurden von den Riesenwuermern, die hier unten leben, "
          "gegraben. Du greifst in ein Loch, aber ausser Schleim konntest "
          "Du nichts fuehlen." );

  AddDetail( ({ "schleim" }), 
          "Den hinterlassen die Riesenwuermer hier ueberall.\n" );

  AddDetail( ({ "hauptstollen", "stollen" }), 
          "Du befindest Dich in ihm.\n" );

  AddDetail( ({ "riesenwuermer", "bestien", "wuermer" }), 
          "Diese schleimigen Bestien kriechen hier unten ueberall rum.\n" );

  AddDetail( ({ "fluss" }), 
          "Jetzt ist jedenfalls keiner mehr da.\n" );

  AddDetail( ({ "humus" }), 
          "Abenteurer sagen aber immer noch Erde.\n" );

  AddDetail( ({ "tunnel", "tunnelsystem" }), 
          "Du hast gleich bemerkt, dass der Tunnel natuerlichen "
          "Ursprungs ist. Sorgenvoll schaust Du Dir alles ganz genau an, "
          "und stellst fest, dass es hier halbwegs einsturzsicher ist.\n" );

  AddDetail( ({ "ursprung" }), 
          "Du weisst nicht, woher der Tunnel stammt. Vielleicht gab "
          "es mal einen unterirdischen Fluss hier. Oder aber die "
          "vielen Riesenwuermer haben das hier ausgebuddelt.\n"  );

  AddSmell( DEFAULT_SMELL, "Es riecht miefig." );

  AddSound( ({ DEFAULT_SOUND, "bohren" }),
          "Ueberall hoerst Du Bohren hinter den Waenden." );

  AddExit( "sueden", "./tunnel2.lpc" );
  AddExit( "oben", "./steppe2.lpc" );

  AddItem( NPC "wurm.lpc", REFRESH_DESTRUCT);
}
