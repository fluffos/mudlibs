
//losti
//mod by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

#define ENTERLOG "/d/ebene/lostboy/steppe/log/tunnel3_enter"

nosave mapping entered = ([]);

create() {
  ::create();
  SetProp( P_INT_SHORT, "Tunnel der Riesenwuermer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem unterirdischen, dunklen, natuerlichen "
    "Tunnelsystem. Es ist recht miefig, aber dafuer ist es schoen kuehl "
    "hier unten. Alles sieht gleich aus, keinerlei Abwechslung.");

  SetProp( P_LIGHT, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "boden", "decke", "wand", "waende" }), 
          "Es besteht alles hier aus fester Erde. In den Waenden befinden "
          "sich Loecher, die alle ins dunkle Ungewiss fuehren. Im Boden "
          "entdeckst Du ein grosseres Loch, durch das Du hindurchklettern "
          "koenntest." );
 
  AddDetail( ({ "ungewiss" }),
          "Du weisst nicht, was Dich erwartet.");

  AddDetail( ({ "erde" }), 
          "Druiden wuerden Humus dazu sagen.\n" );

  AddDetail( ({ "druiden", "abenteurer" }),
          "Wie auch immer, das sind auch nur Menschen." );

  AddDetail( ({ "menschen" }),
          "Oder Zwerge." );

  AddDetail( ({ "zwerge" }),
          "Oder Elfen, Hobbits, Trolle, Oger, Feen, oder Dunkelelfen. Wer "
          "weiss das schon so genau..." );

  AddDetail( ({ "elfen","hobbits","trolle","oger","feen","dunkelelfen" }),
          "Hmpf. Du gibst Dich auch nie mit was zufrieden.");

  AddDetail( ({ "loecher", }),
          "Die Loecher wurden von den Riesenwuermern, die hier unten leben, "
          "gegraben. Du greifst in ein Loch, aber ausser Schleim konntest "
          "Du nichts fuehlen. Doch das groessere Loch im Boden erweckt Deine "
          "Aufmerksamkeit." );

  AddDetail( ({ "aufmerksamkeit", "loch" }), 
          "Da dieses Loch viel haeufiger als die anderen von den "
          "Riesenwuermern genutzt wird, ist es groesser als die anderen. "
          "Hier koenntest Du hindurchklettern." );

  AddDetail( ({ "schleim" }), 
          "Den hinterlassen die Riesenwuermer hier ueberall.\n" );

  AddDetail( ({ "hauptstollen" }), 
          "Du befindest Dich auf ihm.\n" );

  AddDetail( ({ "riesenwuermer", "bestien", "wuermer" }), 
          "Diese schleimigen Bestien kriechen hier unten ueberall rum.\n" );

  AddDetail( ({ "fluss" }), 
          "Jetzt ist jedenfalls keiner mehr da.\n" );
  
  AddDetail( ({ "humus" }), 
          "Abenteurer sagen aber immer noch Erde.\n" );

  AddDetail( ({ "tunnel", "tunnelsystem" }), 
          "Du hast gleich bemerkt, dass der Tunnel natuerlichen "
          "Ursprungs ist. Sorgenvoll schaust Du Dir alles ganz genau an, "
          "und stellst fest, dass es hier halbwegs einsturzsicher ist.\n" );

  AddDetail( ({ "ursprung" }), 
          "Du weisst nicht, woher der Tunnel stammt. Vielleicht gab "
          "es mal einen unterirdischen Fluss hier. Oder aber die "
          "vielen Riesenwuermer haben das hier ausgebuddelt.\n"  );

  AddDetail( ({ "abwechslung" }), 
          "Hier unten sieht alles gleich aus. Das einzige, was Dich hier "
          "haelt, ist die angenehme Kuehle." );

  AddDetail( ({ "kuehle" }),
          "Wie gesagt: Sie ist wirklich angenehm.");

  AddSmell( DEFAULT_SMELL, "Es riecht miefig.");
  AddSound( ({ DEFAULT_SOUND, "bohren" }),
          "Ueberall hoerst Du Bohren hinter den Waenden." );

  AddCmd( ({ "kletter", "klettere" }), "kletter" );

  AddExit( "westen", "./tunnel4" );
  AddExit( "osten", "./tunnel2" );

  AddItem( NPC "wurm", REFRESH_DESTRUCT);
}

int kletter( string str ) {
  notify_fail( "Wohin willst Du klettern?\n" );
  if (!str) return 0;
  if ( str == "loch" || str == "in loch" || str == "durch loch" ) {
    if (!TP->do_exhaust(50)) return 1;          // Erschoepfend
    write("Du betrittst das groessere Loch, das nach unten fuehrt.\n");
    this_player()->move( ROOM "tunnel6", M_GO, 0,
                         "klettert in ein Loch im Boden");
    return 1;
  }
  return 0;
}

void init() {
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt tunnel3.\n",
    dtime(time()), CAP(getuid(TP))));
}

