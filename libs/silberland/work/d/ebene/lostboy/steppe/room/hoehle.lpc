
//losti
//mod by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

#define ENTERLOG "/d/ebene/lostboy/steppe/log/hoehle_enter"

nosave mapping entered = ([]);

create() {
  ::create();
  SetProp( P_INT_SHORT, "Diebeshoehle" );
  SetProp( P_INT_LONG,
    "Jetzt stehst Du mitten in dem Fels. Deine Lichtquelle erhellt den Raum "
   +"nur ein bisschen. Es scheint sich um eine geheime Hoehle zu "
   +"handeln. Im dunklen hinteren Teil "
   +"endeckst Du die zusammengesunkenen Ueberreste eines Abenteurers. "
   +"Die leisen Stimmen, die zu hoeren sind, geben diesem Ort eine "
   +"geheimnisvolle Atmosphaere.");

  SetProp( P_LIGHT, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 11]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "raum", "hoehle", "ort" }), 
    "Du bist richtig stolz auf Dich, diese Hoehle entdeckt zu haben. " 
    "Sie ist recht klein und kreisrund gebaut. Natuerlichen Ursprungs "
    "kann sie also nicht sein." );

  AddDetail( ({ "fels", "felsen" }), 
    "Es besteht aus Stein." 
     );

  AddDetail( ({ "atmosphaere" }), 
    "Dieser Ort macht Dir Angst. Es ist dunkel, Du kannst kaum "
    "etwas sehen. Du hoerst Stimmen, die Du nicht zuordnen kannst. "
    "Dein Schutzengel raet Dir: Kehr um!"
     );

  AddDetail( ({ "kampf" }), 
    "Der Ex-Abenteurer wurde uebel zugerichtet. Er ist wohl "
    "in einen Hinterhalt getrieben worden." );

  AddDetail( ({ "schutzengel" }), 
    "Aber Du glaubst natuerlich nicht an Schutzengel." 
     );

  AddDetail( ({ "abenteurer", "ueberreste" }), 
    "Der Koerper zeigt viele tiefe Wunden, die von einem "
    "Kampf stammen muessen. Eine verrostete Machete liegt bei " 
    "der Leiche. Sie hat dem armen Kerl wohl nicht allzuviel "
    "genuetzt.");

  AddDetail( ({ "stein", "gestein" }), 
    "Das Gestein bildet diesen Fels." );

  AddDetail( ({ "wunden", "blut", "Leiche", "koerper", "kerl" }), 
    "Der Koerper der Leiche ist blutueberstroemt." );

  AddDetail( ({ "machete", "waffe" }), 
    "Die Machete scheint mal eine gute Waffe gewesen zu sein. " 
    "Aber jetzt ist sie so verrostet, dass nichtmal Haegar sie "
    "flicken koennte." );
  AddDetail( ({"rost"}),
      "Der Rost ist auf der Machete, darum ist sie verrostet.");

  AddDetail("haegar",
    "Er ist wohl der beste Schmied im SilberLand, und lebt in "+
    "der Stadt im Norden.");

  AddDetail( ({ "wand", "waende", "boden", "decke" }), 
    "Alles besteht aus rauhem Gestein." );

  AddDetail( ({ "tuer", "geheimtuer" }), 
    "Von hier aus ist die Tuere gar nicht mehr zu sehen." );

  AddDetail( ({ "schall" }), 
    "Durch das Abdriften der Felsen schallt das Murmeln in der ganzen "
    "Hoehle. Du setzt also an einem Punkt an und lauschst Dich voran, "
    "um endlich herauszufinden, woher dieses Murmeln nun eigentlich kommt. "
    "Bei Deiner Suche entdeckst Du einen Felsvorsprung, hinter dem es weiter "
    "tiefer in die Hoehle hineingeht. Du hast ihn vorher wegen der "
    "Dunkelheit nicht sehen koennen.");

  AddDetail( ({ "felsvorsprung", "vorsprung" }), 
    "Hinter dem Felsvorsprung fuehrt ein tiefer Gang "
    "ins dunkle Ungewisse. Zu Deinem Entsetzen hoerst Du von dort "
    "wieder dieses Murmeln. Nur lauter. Und doch koenntest Du ihn betreten. ");

  AddDetail( ({ "gang", "ungewisse" }), 
    "Nur das Betreten des Ganges, bringt Licht ins Dunkel!" );

  AddDetail( ({ "teil" }), 
    "Deine Lichtquelle stoesst nicht bis in den hinteren Teil "
    "der Hoehle vor. Nur die Ueberreste einer Leiche kann "
    "man dort noch erkennen." );

  AddDetail( ({ "lichtquelle", "quelle" }), 
    "Welche Du auch immer hast." );

  AddDetail( ({ "stimmen" }), 
    "Du kannst die Stimmen nicht sehen, nur hoeren koenntest "
    "Du sie." );

  AddDetail( ({ "ursprung" }), 
    "Sicher von Menschenhand gebaut. Oder ein paar Menschen "
    "hatten sich Zwerge als Sklaven gehalten, die das hier "
    "ausgehauen haben." );

  AddDetail( ({"lichtquelle"}),
      "Eine Fackel oder so was....");
  AddDetail( ({ "fackel" }), 
    "Huch, keine Fackel? Auch Magier koennen sich mal irren." );

  AddSound( DEFAULT_SOUND,
      "Du hoerst leise Stimmen. Kannst aber nicht "
      "zuordnen woher sie stammen.\n" );

  AddSound( ({"stimmen" }),
      "Die Stimmen sind so leise, dass man nur "
      "ein leises Murmeln vernehmen kann.\n" );

  AddSound( ({"murmeln" }),
      "Das Murmeln kommt von ueberall. Der Schall "
      "verteilt sie in der ganzen Hoehle." );

  AddSound( ({"schall" }),
      "Du kannst ihn mal genauer untersuchen.");

  AddCmd( ({ "sesam" }), "sesam" );
  AddCmd( ({ "nimm", "nehm", "nehme" }), "nimm" );
  AddCmd( ({ "oeffne", "betrete", "breche", "brich", "schlage", "schlag" }),
      "oeffne" );
  AddCmd( ({ "betret", "betrete" }), "betrete" );
}

oeffne( str ) {
  notify_fail( "Was willst Du genau machen?\n" );
  if (!str) return 0;
  if (str[<4..]==" auf") str=str[0..<5];        // simplify parsing
  if (!member((["tuer","tuere","geheimtuer","geheimtuere"]),str)) return 0;

  write("Du ziehst und zerrst an der Tuer. Aber leider regt sich nichts.\n");
  say(this_player()->Name(WER)+" scheint Probleme mit einem Fels zu haben.\n");
  return 1;
}

int sesam( string str ) {
  notify_fail( "Sprich deutlicher.\n" );
  if ( str == "oeffne dich" )
  {
    if (TP->QueryProp(P_SP) < 10)
      return write("Deine magischen Kraefte reichen nicht aus.\n"), 1;
    TP->AddSp(-10);
    write(break_string("Du murmelst die magischen Worte erneut. "
          "Und auch diesmal schiebt sich die Geheimtuer "
          "beiseite und macht einem Geheimgang Platz. Etwas erleichtert "
          "betrittst Du den Geheimgang. Kaum bist Du wieder im Freien, "
          "kracht die magische Tuere hinter Dir auch schon wieder zu.", 78) );
    say(TP->Name()+
        " murmelt leise ein paar Worte. Du kannst es nicht verstehen.\n");
    TP->move( ROOM "steppe11", M_GO, 0, "wird vom Fels verschlungen",
        "wird vom Fels ausgespuckt");
    return 1;
  }
  return 0;
}

nimm( str ) {
  notify_fail( "Was willst Du nehmen?" );
  if( str == "machete" ) {
    write("Was willst Du mit dieser verrosteten Waffe?\n");
    say(this_player()->Name(WER)+" beugt sich ueber eine Leiche.\n");
    return 1;
  }
  return 0;
}

int betrete( string str ) {
  notify_fail( "Was willst Du betreten?\n" );
  if ( str == "gang" || str == "felsvorsprung" || str == "vorsprung") {
    write(break_string("Mutig durchquerst Du den dunkel Gang und kommst auf "
          "der anderen Seite in einer zweiten Hoehle wieder raus.", 78) );

    this_player()->move( ROOM "hinten", M_GO, 0, 
      "verschwindet hinter einem Fels", 
      "kommt hinter einem Felsen hervorgekrochen");

    return 1;
  }
  return 0;
}

void init() {
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt hoehle.\n",
    dtime(time()), CAP(getuid(TP))));
}

