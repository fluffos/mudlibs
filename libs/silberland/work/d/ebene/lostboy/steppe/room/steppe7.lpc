
//losti
//modified by arth

inherit "std/room";


#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include "detail.h"

int kamm_da;

create() {
  ::create();
  kamm_da=1;
  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
    "ausdehnt. Aber eigentlich bist Du froh, nicht in einer Wueste "
    "rumzuirren. Die Steppe scheint sehr einsam zu sein. Du fuehlst "
    "Dich verlassen. "
    "Ein Meer von Gras bewegt sich sanft im ewigen Wind der Steppe. "
    "Hier und da entdeckst Du ein paar Baeume, Buesche und Straeucher. "
    "Du bemerkst gleich, dass es hier wohl schon lange nicht mehr "
    "geregnet hat, denn die Steppe ist voellig ausgetrocknet."  );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  SetProp( P_INDOORS, 0 );

  RECENT1

  AddDetail( ({ "steppe", "gegend", "landschaft" }), 
    "Genau so hast Du Dir eine Steppe immer vorgestellt. "
    "Fad, hier mal nicht trocken, einsam und heiss." );

  AddDetail( ({ "norden", }), 
    "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras." 
   );

  AddDetail( ({ "pfad", "trampelpfad" }), 
    "Du hast den kleinen Pfad durch die Steppe schon lange verlassen." 
   );

  AddDetail( ({ "wind", }), 
    "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
    "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
    "eines Meeres aus." 
   );

  AddDetail( ({ "halme", "grashalme", "gras" }), 
    "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. Doch das Gras " 
    "ist nicht ausgetrocknet wie sonst, es ist schoen gruen und frisch."
   );

  AddDetail( ({ "wellen", "meer" }), 
    "Das war doch nur eine Metapher." 
   );

  AddDetail( ({ "gesicht", }), 
    "Du bekommst schon einen leichten Sonnenbrand." 
   );

  AddDetail( ({ "baeume", "teil", }),
    "In diesem Teil der Steppe wachsen mehr Baeume als sonst. "
    "Es liegt wohl an der kleinen Quelle die hier entspringt "
    "und dem Boden Feuchtigkeit zufuehrt. Ein Baum ist besonders "
    "dick und hoch." 
   );

  AddDetail( ({ "feuchtigkeit", }), 
    "Du bist richtig gluecklich, mal etwas anderes zu finden als "
    "trockenes Gras."
    );

  AddDetail( ({ "quelle", }), 
    "Sie blubbert vor sich hin. Der Quelle sei Dank, koennen hier "
    "mal ein paar groessere Baeume wachsen. Du geniesst die "
    "Abwechslung der sonst so trostlosen Landschaft." 
   );

  AddDetail( ({ "abwechslung", }), 
    "Die hohen Baeume, die kleine Quelle. Das alles ist gemeint." 
   );

  AddDetail( ({ "buesche", "busch", "dorn", "dornen" }), 
    "Hier und da wehen im Wind ein paar dornige Buesche." 
   );

  AddDetail( ({ "straeucher", }), 
    "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
    "Anscheinend fehlt ihnen etwas zum richtigen wachsen."
   );

  AddDetail( ({ "wasser", }), 
    "Aus der Quelle blubbert braunes Wasser." 
   );

  AddDetail( "spiegelung",
       "Interessant, wie sich die Sonne im Wasser spiegelt." );

  AddDetail( ({ "himmel", "sonne", "hitze", }), 
    "Die Sonne strahlt blendend weiss vom Himmel." 
   );

  AddDetail( ({ "boden", "erde" }), 
    "Hm, eigentlich siehst Du nur Gras." 
   );

  AddDetail( ({ "metapher", }), 
    "Immer diese Fremdwoerter." 
   );

  AddDetail( ({ "wueste", }), 
    "Nur das waere jetzt wohl schlimmer. Dort haettest Du bestimmt noch mehr "
    "Durst, als in der trockenen Steppe. "
    );

  AddDetail( ({ "durst", }), 
    "Deiner wird immer gewaltiger." 
   );

  AddDetail( ({ "baum", }), 
    "Der dicke Baum passt gar nicht in diese Gegend. "
    "Er windet seinen schnoerkeligen Stamm bestimmt zwanzig "
    "Meter in die Hoehe. Gleich ueber dem Boden beginnen die "
    "ersten Aeste und Zweige zu wachsen. "
    );

  AddDetail( ({ "stamm", "baumstamm" }), 
    "Am Stamm laesst sich so alles finden was zu einem Stamm "
    "gehoert. Rinde, Holz, Rillen, Ameisen, usw. "
    );

  AddDetail( ({ "rinde", "rillen", "ameisen" }),
    "Die Zutaten eines Baumstammes."
    );

  AddDetail( ({ "zutaten" }),
    "Bestandteile, sozusagen."
    );

  AddDetail( ({ "bestandteile" }),
    "Du siehst einen Fehler im Baum-Stamm-Gefuege."
    );

  AddDetail( ({ "fehler" }),
    "Bei naeherer Betrachtung scheint es sich lediglich um eine besonders "
    "tiefe Rille zu handeln. Du atmest auf - zum Glueck war keine boese "
    "Magie im Spiel!"
    );

  AddDetail( ({ "rille" }),
    "Du steckst Deinen Finger in die Rille und tastest sie vorsichtig ab. "
    "Nichts Ungewoehnliches zu finden. Schade, und Du hofftest auch schon "
    "auf einen Zaubertrank..."
    );

  AddSpecialDetail( ({ "finger", "zeigefinger" }), "d_finger");

  AddDetail( ({ "hoehe", "meter" }),
    "Als Du hinaufblickst, wird Dir ganz schwindlig."
    );

  AddDetail( ({ "zaubertrank" }),
    "Wenn Du so fleissig weitersuchst, wirst Du woanders sicherlich "
    "irgendwann fuendig!"
    );

  AddDetail( ({ "aeste", "zweige", "ast", "zweig" }), 
    "Die Aeste und Zweige bestehen aus Holz. Recht dick und "
    "nichtmal morsch sind sie. "
    );

  AddDetail( ({ "holz", }), 
    "Du siehst Baeume, Straeucher, Aeste, Zweige, Buesche "
    "und alles besteht aus Holz."
    );

  AddDetail( ({ "farbe", }), 
    "Du erkennst Braun."
    );

  AddDetail( ({ "braun", }), 
    "Komisch, jetzt ist es Gelb."
    );

  AddDetail( ({ "gelb", }), 
    "Du siehst einen kleinen Gegenstand in dem gelben "
    "Wasser schimmern."
    );


  AddSpecialDetail("gegenstand", "kamm_fun");
  AddSpecialDetail("kamm", "kamm2");

  AddSound( DEFAULT_SOUND,
    "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );

  AddSmell( DEFAULT_SMELL,
    "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );

  AddCmd( ({ "kletter", "klettere" }), "kletter" );
  AddCmd( ({ "trinke", "trink" }), "trinke" );
  AddCmd( ({ "fische", "fisch" }), "fish" );

  AddExit( "norden", "./steppe4" );
  AddExit( "westen", "./steppe6" );
  AddExit( "osten", "./steppe8" );
}

string d_finger()
{
  say(TP->Name()+" betrachtet eingehend "+
      TP->QueryPossPronoun(MALE,WEN)+" Zeigefinger.\n"
      "Du schmunzelst.\n");
  return "Du betrachtest eingehend Deinen Zeigefinger. Kommst Du Dir nicht "
    "daemlich vor?\n";
}

string kamm_fun() {
  if (kamm_da)
    return "Du siehst einen Kamm. Wer den wohl vergessen hat?\n";
  return "Es war wohl doch nur eine Spiegelung im Wasser.\n";
}

reset() {
  kamm_da = 1;
  ::reset();
}


kamm2() {
  if (kamm_da)
    return break_string("Ein ganz normaler Kamm. Du kannst ihn aus dem Wasser fischen.\n", 78);
  return "Hier gibt es keinen Kamm.\n";
}

fish(str) {
  notify_fail("Wonach willst Du fischen?\n");
  if (str!="kamm aus wasser" && str!="nach kamm")
    return 0;
  if (!kamm_da) {
    write("Du fischt ein wenig im trueben Wasser herum, findest jedoch nix.\n");
    say(this_player()->Name(WER)+" fischt ein wenig im trueben Wasser.\n");
    return 1;
   }
   clone_object(OBJ "kamm")->move(this_player(), M_NOCHECK);           
   write(break_string("Du fischt Dir den Kamm aus dem Wasser.\n", 78) );
   kamm_da = 0;
   WLOG(LOG "kamm", "findet einen kamm");
   say(break_string(this_player()->Name(WER, 2)+
         " bueckt sich und hebt etwas vom Boden auf.\n", 78) );
   return 1;
}

trinke( str ) {
  notify_fail("Was willst Du trinken?\n");
  if (str=="wasser" || str=="das wasser") {
    if (TP->drink_soft(15)) {
      TP->heal_self(10);
      write(break_string("Das kuehle Wasser schmeckt himmlisch. Aber das kommt "
             "Dir bestimmt nur wegen der Hitze so vor. Denn das "
             "Wasser der Quelle hat eine ekelhaft braune Farbe. ", 78) );
      say(break_string(this_player()->Name(WER)+
            " stillt "+
            TP->QueryPossPronoun(MALE,WEN)+" Durst an der Quelle.\n", 78) );
    }
    return 1;
  }
  return 0;
}

kletter (str) {
  notify_fail("Wohin willst Du klettern?\n");
  if(str != "baum" && str != "auf baum") return 0;
  if (!TP->do_exhaust(200)) return 1;         // Erschoepfend
  write(BS("Du kletterst auf den Baum."));
  TP->move( ROOM "baum", M_GO, 0, "klettert auf einen Baum");
  return 1;
}
