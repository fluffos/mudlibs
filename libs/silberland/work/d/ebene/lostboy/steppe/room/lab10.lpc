
//losti
//mod by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <moving.h>

create() {
  ::create();
  SetProp( P_INT_SHORT, "Maulwurfslabyrinth" );
  SetProp( P_INT_LONG,
    "Was ist das?? Ja, ein Loch nach oben, und dort kannst Du "
    "sogar raushuepfen. Du fragst Dich zum Schluss noch, ob das hier "
    "wenigstens Forscherpunkte gab. Oder Moment, da ist noch ein "
    "kleiner Gang nach Norden. Vielleicht gibts dort noch was.");

  SetProp( P_LIGHT, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "labyrinth", "waende", "wand" }), 
          "Deine Augen sind zu schwach.\n" );

  AddDetail( ({ "moment" }),
      "Schon ist er vorbei.");

  AddDetail( ({ "schluss", "ende" }),
      "Ist ueberhaupt ein Ende absehbar?");

  AddDetail( ({ "augen" }),
      "Du strengst Deine Augen an, kannst aber kaum was erkennen.");

  AddDetail( ({ "forscherpunkt", "forscherpunkte" }),
      "Das ist das, was man bekommt, wenn man forscht. Lauter kleine gruene "
      "Punkte, im ganzen Gesicht verteilt. Eklig.");

  AddDetail( ({ "punkte", "punkt", "gruene punkte" }),
      "Da, schon wieder ein neuer!");

  AddDetail( ({ "gruener punkt", "gruenen punkt", "bits", "raum" }),
      "Dieser Raum wurde aus umweltfreundlichen Bits hergestellt.");

  AddDetail( ({ "gesicht" }),
      "Du tastest besorgt Dein Gesicht ab, findest aber nichts. Hat Dir "
      "da Jemand einen Baeren aufgebunden?");

  AddDetail( ({ "baer" }),
      "Bestimmt nicht. So ein Baer ist ja furchtbar unhandlich, und viel "
      "groesser als Du. Den kann man Dir doch niemals nicht aufbinden.");

  AddDetail( ({ "gang" }),
          "Dieser Gang ist anders als die anderen. Du kannst nicht "
          "sagen warum, aber Du fuehlst es.\n"); 

  AddDetail( ({ "boden" }), 
          "Hier ist der Boden ganz anders als sonst. In ihm "
          "spiegelt sich die Decke schemenhaft wieder.\n");

  AddDetail( ({ "decke" }), 
          "Huch, fast haettest Du das Loch durch die Decke "
          "gar nicht gesehen.\n");

  AddDetail( ({ "loch", "maulwurfsloch" }), 
          "Ein Maulwurfsloch, das in die Freiheit fuehrt.\n");

  AddDetail( ({ "freiheit" }), 
          "Die ist draussen. Hoffst Du.");

  AddSmell( DEFAULT_SMELL, "Es riecht nach Freiheit.\n" );

  AddCmd( ({ "steig","steige","kletter","klettere","huepf","huepfe" }),
      "kletter" );

  //AddItem( NPC "heldent", REFRESH_DESTRUCT);

  AddExit( "norden", "./lab2" );
}

kletter( str )
{
  notify_fail( "In was willst Du klettern?\n" );
  if( str == "durch loch" || str == "loch" || str == "raus" ) {
    write("Und hops, schon hast Du die Freiheit wieder.\n");
    this_player()->move( ROOM "steppe8", M_GO, 0,
        "klettert durch das Loch" , "kommt heraufgeklettert");
    return 1;
  }
  return 0;
}

