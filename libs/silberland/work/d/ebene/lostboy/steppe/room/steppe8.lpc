inherit "std/room";


#include <properties.h>
#include <actions.h>
#include <combat.h>
#include <player.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include "detail.h"

#define MAULWUERFE 3

int loch = 0;
int maulwurf;

create() {
  ::create();

  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG,
    "Du stehst am oestlichen Ende der Steppe. Das Gebirge das sonst noch "
    "im Nordosten zu sehen war, ist verschwunden und macht einer weiten "
    "endlosen Wueste Platz. Suedlich wird die Gegend wieder etwas huegeliger. "
    "Die Steppe scheint sehr einsam zu sein. Du fuehlst Dich verlassen. "
    "Ein Meer von Gras bewegt sich sanft im ewigen Wind der Steppe. "
    "Hier und da entdeckst Du ein paar Baeume, Buesche und Straeucher. "
    "Du bemerkst gleich, dass es hier wohl schon lange nicht mehr "
    "geregnet hat, denn die Steppe ist voellig ausgetrocknet.");

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  SetProp( P_INDOORS, 0 );

  RECENT1

  AddDetail( ({ "steppe", "gegend" }), 
    "Genau so hast Du Dir eine Steppe immer vorgestellt. "
    "Fad, trocken, einsam und heiss. "
    "Weiter im Sueden kannst Du schon ein paar Huegel entdecken." );

  AddDetail( ({ "norden", }), 
    "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras." 
   );

  AddDetail( ({ "gebirge", }), 
    "Das Gebirge hat einer endlosweiten Wueste im Osten Platz gemacht. " 
   );

  AddDetail( ({ "wueste", "landschaft" }), 
    "Die Wueste ist eine raue Landschaft und sollte nur betreten werden, "
    "wenn man fuer diese gut genug ausgeruestet ist. Wer diesen Rat nicht "
    "befolgt, koennte schnell einen Geier ueber sich kreisen sehen."
     );

  AddDetail( ({ "rat", "baldur", "detail", "existenz" }),
    "Dieses Detail verdankt seine Existenz einem gewissen Baldur.");

  AddDetail( ({ "geier" }),
    "Noch siehst Du keinen. Ueberhaupt, ein Detail, das nur hypothetisch "
    "existiert, werde ich in Zukunft nicht mehr beschreiben. *pffft*");

  AddSpecialDetail( ({ "zukunft" }), "d_zukunft");

  AddDetail( ({ "pfad", "trampelpfad" }), 
    "Du hast den kleinen Pfad durch die Steppe schon lange verlassen." 
   );

  AddDetail( ({ "wind", }), 
    "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
    "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
    "eines Meeres aus." 
   );

  AddDetail( ({ "halme", "grashalme", "gras" }), 
    "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. Es ist schon "
    "richtig ausgetrocknet von der stechenden Sonne. Ueberall sind kleine "
    "Erdhuegel zu sehen."
   );

  AddDetail( ({ "wellen", "meer" }), 
    "Das war doch nur eine Metapher." 
   );

  AddDetail( ({ "gesicht", "sonnenbrand" }), 
    "Du bekommst schon einen leichten Sonnenbrand." 
   );

  AddDetail( ({ "baeume", }), 
    "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du siehst, "
    "sind sehr ausgetrocknet und tragen keine Blaetter." 
   );

  AddDetail( ({ "blaetter", }), 
    "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen." 
   );

  AddDetail( ({ "innere", "inneren" }), 
    "Was da wohl ist?" 
   );

  AddDetail( ({ "buesche", }), 
    "Hier und da wehen im Wind ein paar dornige Buesche." 
   );

  AddDetail( ({ "straeucher", }), 
    "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
    "Anscheinend erhalten sie zu wenig Wasser."
   );

  AddDetail( ({ "wasser", }), 
    "Davon hat die Steppe eindeutig zuwenig." 
   );

  AddDetail( ({ "himmel", "sonne" }), 
    "Die Sonne strahlt blendend weiss vom Himmel." 
   );

  AddDetail( ({ "boden", "erde" }), 
    "Hm, eigentlich siehst Du nur Gras. Doch in dem Gras "
    "ist was. Schau mal nach."
   );

  AddDetail( ({ "metapher", }), 
    "Immer diese Fremdwoerter." 
   );

  AddDetail( ({ "huegel", "genaues" }), 
    "Du bist zu weit weg, um genaues bei den grossen Huegeln im "
    "Sueden erkennen zu koennen. Oder meinst Du was anderes?"
    );

  AddDetail( ({ "erdhuegel", "maulwurfshuegel" }), 
    "Die kleinen Erdhuegel sind hier ueberall. Es koennten "
    "Maulwurfshuegel sein. Aber dafuer sind sie ungewoehnlich "
    "gross. Im Inneren eines Erdhuegels scheint sich was zu regen." 
   );


  AddSound( DEFAULT_SOUND,
    "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );

  AddSmell( DEFAULT_SMELL,
    "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );


  AddCmd( ({ "grabe", "wuehle", "wuehl", "grab" }), "grabe" );
  AddCmd( ({ "greife", "greif", "fass", "fasse" }), "greife" );
  AddCmd( ({ "kletter", "klettere", "zwaeng", "zwaenge",
        "huepf", "huepfe", "spring", "springe" }), "kletter" );

  AddExit( "norden", "./steppe5" );
  //AddSpecialExit("osten","gehe_osten");     // -> treibsand g'schichte
  AddExit( "westen", "./steppe7" );
  AddExit( "sueden", "./steppe10" );

  AddItem( NPC "hund", REFRESH_DESTRUCT);
  AddItem( NPC "hund", REFRESH_DESTRUCT);

  maulwurf=MAULWUERFE;

}


grabe( str )
{
  notify_fail( "Worin willst Du graben?\n" );
  if (!str) return 0;
  if (!member((["erdhuegel","in erdhuegel","huegel","in huegel","loch"]),str))
    return 0;

  if (loch) {
    write("Du erblickst ein Loch. Da hat wohl schon Jemand gegraben.\n");
    return 1;
  }
  if (!present("schaufel",TP)) {
    if (!TP->do_exhaust(50)) return 1;          // Erschoepfend
    write(BS("Du graebst mit blossen Haenden ein wenig in einem Erdhuegel, "
          "kommst aber nicht so recht voran. Wie waers mit einem passenden "
          "Werkzeug?"));
    say(TP->Name()+" graebt mit blossen Haenden ein wenig in einem "
        "Erdhuegel rum.\n");
    return 1;
  }

  if (!TP->do_exhaust(200)) return 1;           // Erschoepfend

  write(break_string("Du faengst an, die obere Erdschicht abzutragen. "
        +"Dabei graebst Du ein Loch frei, welches in die Erde fuehrt.", 78 ) );
  say(this_player()->Name(WER)+" graebt ein Loch in einen Erdhuegel.\n");

  AddDetail( ({"loch"}), BS("Ein kleines Loch im Boden."));
  call_out("loch_weg",40+random(21));
  loch = 1;

  return 1;
}

void loch_weg() {
  loch = 0;
  RemoveDetail("loch");
  tell_room(this_object(), "Ein Maulwurf schuettet das Loch wieder zu.\n");
}


kletter( str )
{
  mixed p_race;

  notify_fail( "Wohin willst Du klettern?\n" );
  if(!str) return 0;
  if (str!="loch" && str!="in loch")
    return 0;
  if (!loch) {
    write("Hier ist doch gar kein Loch!\n");
    return 1;
  }

  if (!TP->QueryProp(P_FROG))
  {
    p_race = this_player()->QueryProp(P_RACESTRING);
    if (pointerp(p_race)) p_race=p_race[WER];
    if (!stringp(p_race)) p_race=TP->QueryProp(P_RACE);
    //write( break_string("Du bist viel zu gross fuer das enge Loch. "+
    //           "Hoechstens Deine Hand oder ein Frosch passt da rein.") );
    write(break_string("Du als "+p_race+" passt da niemals durch.", 78) ); 
    say(TP->Name(WER)+" versucht, sich in ein Loch zu quetschen.\n");
    return 1;
  }
  else
  {
    if (!TP->do_exhaust(50)) return 1;          // Erschoepfend
    write("Wagemutig spannst Du Deine Froschschenkel an "
        "und springst in das Loch.\n");
    TP->move( ROOM "lab1", M_GO,
        "in ein Loch", "huepft", "kommt hereingehuepft");
    return 1;
  }
}

greife( str ) {
  object m;

  notify_fail( "Wo willst Du hinein greifen?\n" );

  if (!loch) {
    write(break_string("Grab doch erstmal ein Loch!\n") );
    return 1;
  }
  if (str!="loch" && str!="in loch")
    return 0;
  if (maulwurf>0) {
    write(break_string("Du greifst in das Loch und fuehlst etwas weiches. "
          "Doch schon wirst Du gebissen. Schmerzverzerrt ziehst "
          "Du Deine Hand wieder aus dem Loch. Ein riesiger "
          "Maulwurf haengt festgebissen an deinem Zeigefinger "
          "und greift Dich an.\n", 78) );
    say(TP->Name(WER)+" greift ins Gras und zieht einen Maulwurf raus.\n");
    maulwurf--;
    m=clone_object(NPC "maulw");
    m->move(TO, M_GO|M_SILENT);
    m->Kill(TP);
    return 1;
  } else {
     write("Du greifst in ein Loch, findest aber nichts.\n");
     say(TP->Name()+" greift in ein Loch im Boden.\n");
     return 1;
  }
  return 0;
}


reset() { 
  ::reset();
  maulwurf = MAULWUERFE;
}

d_zukunft() {
  return "[Tod:Lars] Neugier hat gerade "+capitalize(getuid(TP))+
    " umgebracht.\n"
    "SO koennte Deine Zukunft aussehen. ;)\n";
}

