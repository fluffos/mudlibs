
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

create() {
  ::create();
  SetProp( P_INT_SHORT, "Maulwurfslabyrinth" );
  SetProp( P_INT_LONG,
    "Ein richtiges Labyrinth ist das hier unten. Die Maulwuerfe haben "
    "ein fuer Dich ein total unklares Hoehlensystem geschaffen. "
    "Es ist zu dunkel, um etwas zu erkennen. Wo war nochmal Norden?");

  SetProp( P_LIGHT, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "labyrinth", "boden", "decke", "waende", "wand",
        "maulwuerfe", "hoehlensystem" }), 
          "Deine Augen sind zu schwach." );
  AddDetail( ({ "augen" }),
      "Du strengst Deine Augen an, kannst aber kaum was erkennen.");

  AddSmell( DEFAULT_SMELL, "Es riecht nach Langeweile.\n" );

  AddExit( "westen", "./lab8" );
  AddExit( "osten", "./lab9" );
}
