
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"
#define ENTERLOG "/d/ebene/lostboy/steppe/log/lab1_enter"
nosave mapping entered = ([]);

create() {
  ::create();
  SetProp( P_INT_SHORT, "Maulwurfslabyrinth" );
  SetProp( P_INT_LONG,
    "Ein richtiges Labyrinth ist das hier unten. Nach oben kommst Du "
    "nicht mehr, denn Du bist einige Meter tief gefallen. Es ist zu dunkel, "
    "um etwas zu erkennen. Wo war nochmal Norden?");

  SetProp( P_LIGHT, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "labyrinth", "boden", "decke", "waende", "wand" }), 
      "Deine Augen sind zu schwach." );
  AddDetail( ({ "augen" }),
      "Du strengst Deine Augen an, kannst aber kaum was erkennen.");
  AddDetail( ({ "meter" }),
      "Ein paar davon ueber Dir ist das Loch.");
  AddDetail( ({ "loch" }),
      "Da bist Du vermutlich hergekommen, oder?");

  AddSmell( DEFAULT_SMELL, "Es riecht nach Langeweile.\n" );

  AddExit( "norden", "./lab2" );
}

void init() {
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt lab1.\n",
    dtime(time()), CAP(getuid(TP))));
}
