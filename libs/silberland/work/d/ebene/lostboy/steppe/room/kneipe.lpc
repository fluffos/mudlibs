
//losti
//mod by arth

inherit "/std/pub";

#include <rooms.h>
#include <properties.h>
#include "../def.h"
#include <pub.h>

create() {
  ::create();
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "\ninhaber");
  SetProp(P_PUBKEEPER_NAME, "Inhaber");
  SetProp(P_PUBKEEPER_GENDER, MALE);
  SetProp(P_PUBMSG_NOKEEPER,
      "Der Inhaber scheint zur Zeit nichts inne zu haben.\n");
  SetProp(P_PUBMSG_NOENEMY,
      break_string("Du bist ein Traeumer, wenn Du denkst, dass "
        "der Inhaber Dich bedient, waehrend Du mit ihm kaempfst!"));
  SetProp(P_PUBMSG_NOINVITE, "Der Inhaber sieht Dich missbilligend an.\n");
  SetProp(P_PUBMSG_FIGHTING, "Der Inhaber schlaegt noch einmal zu.\n");

  AddDrink("dunkles Bier",({"bier","dunkels bier"}),20,7,4,3,
            ({"Der Besitzer der Taverne schubst Dir ein nasses Bier zu.\n"
              "Leider ist es lauwarm, Du bekommst es kaum runter.",
              "&& trinkt ein lauwarmes Bier."}));

  AddDrink("Gemuesebier", ({"gemuesebier","gemuesbier"}), 90,15,6,5,
            ({"Der Besitzer stellt Dir ein Gemuesebier vor die Nase.\n"
              "Trotz aller Bedenken schmeckt es himmlisch.\n",
              "&& geniest ein Gemuesebier."}));

  AddDrink("Branntwein",({"branntwein","wein"}), 700,50,25,1,
            ({"Du bekommst den total ueberteuerten Branntwein sofort "
              "serviert. "
              "Du spuerst all Deine Glieder auf einmal und musst sofort "
              "ein Glas Wasser nachspuelen.",
              "&& schreit um sich, als &! einen Branntwein saeuft."}));

  AddDrink("Quellwasser",({"quellwasser","wasser"}), 50,15,0,10,
            ({"Du schluckst das Wasser mit einem Mal weg.\n",
              "&& gurgelt ein Glas Wasser weg."}));

  AddDrink("Orangensaft",({"staft","orangensaft"}), 120,20,-1,8,
            ({"Erfrischend gut und gesund war der Saft, musst Du feststellen.",
              "&& trinkt einen Orangensaft."}));

  AddFood ( "Rinderkeule", ({"keule", "rinderkeule","rind"}),  400, 55, 20,
    ({ "Du bestellst eine leckere Rinderkeule. Ein Direktimport aus der "
       "nahegelegenen Steppe. *schmatz*",
    "&& schmatzt eine Rinderkeule."}));   

  AddFood("Rattenschwanzsuppe",({"suppe","rattenschwanzsuppe","rattensuppe"}),
      100, 5, 2,
      ({ "Dir wird eine Schuessel Suppe vor die Nase gestellt. Du loeffelst "
         "einmal aus der Suppe. Ihhhh, Du spuckst die Suppe wieder aus und "
         "schuettest den Rest wieder weg. Nicht alles, was aus dem fernen "
         "Tijara kommt, duerfte gut sein...",
    "&& spuckt die bestellte Suppe wieder aus."}));   

  AddExit("raus","./steppe4");

  SetProp(P_INT_SHORT,"Taverne der Diebe");
  SetProp(P_INT_LONG,"Du stehst in der Taverne der Diebe. "
               "Eine ueble Kaschemme ist das hier. Die Diebe wollen unter "
               "sich sein und halten diese Gaststaette geheim. "
               "Das Lokal ist geschmacklos eingerichtet, umso geschmackloser "
               "sind nur die wenigen Gestalten, die hier rumlungern. "
               "Altes Bier klebt am Boden fest, die Tische sind versuefft. "
               "Der ganze Raum ist miefig. Wenn Du trotzdem noch was " 
               "runterbekommen kannst, so schau Dir das Menue an.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));


  AddDetail( ({ "taverne", "raum", "kaschemme", "gaststaette", "lokal" }), 
     QueryProp(P_INT_LONG));

  AddDetail( ({  "diebe", "gestalten", "taugenichtse"  }), 
     "Hier haengen nur Taugenichtse rum. Einer schlimmer als "
     "der andere. Mit denen willst Du nichts zu tun haben.");

  AddDetail( ({  "bier", "boden"  }), 
     "Das Bier auf dem Boden ist schon schwarzgetrampelt worden. "
     "An der Theke gibt es wohl frisches Bier.");

  AddDetail( ({ "theke" }), 
     "An der Theke steht der Besitzer des Ladens."
     );

  AddDetail( ({ "decke", "waende", "wand" }), 
     "Die Decke und die Waende sind lieblos gestaltet worden. "
     "Das ist auch egal, denn das Einzige, das hier unten zaehlt, "
     "ist das Biersaufen."
     );

  AddDetail( ({  "tische", "tisch"  }), 
     "Die Tische sind total sueffig. Es liegt mehr Bier "
     "auf den Tischen als in den Glaesern. Dort nimmst Du "
     "sicher nicht Platz."
     );

  AddDetail( ({  "besitzer", "streuner", "inhaber"  }), 
     "Ein boesartig aussehender Streuner. Voller Taetowierungen. "
     "Im Moment scheint er jedoch nicht da zu sein.");

  AddDetail( ({  "taetowierungen", "taetowierung"  }), 
     "Die kannst Du nur sehen wenn der Inhaber auch da ist. "
        );

  AddDetail( ({  "glaeser", "glas"  }), 
     "Glaeser, vorwiegend mit Bier gefuellt. In dem Glas "
     "eines Diebes neben Dir schwimmt Dreck."
     );

  AddDetail( ({  "dreck"  }), 
     "Der Dreck scheint den Dieb nicht zu kuemmern. Er "
     "schluerft genuesslich an seinem Glas."
     );

  AddRoomMessage( ({
      "Ein Dieb bruellt: Noch 'ne Runde fuer alle!\n",
      "Zwei Diebe fangen an, sich zu pruegeln.\n",
      "Ein Dieb faellt vor lauter Hitze um.\n",
      "Ein Dieb sagt zu Dir: Geld oder Leben.\n",
      "Der Biergestank ist schrecklich.\n",
      "Die Diebe tuscheln ueber Dich.\n"
    }),60);

  AddSound ( DEFAULT_SOUND,
    "Nur ein paar dunkle Zeitgenossen unterhalten sich miteinander.\n");

  AddSmell ( DEFAULT_SMELL,
    "Es stinkt nach altem Bier.\n");

  AddItem( NPC "inhaber", REFRESH_DESTRUCT);
  AddItem( NPC "kndieb", REFRESH_DESTRUCT);
  AddItem( NPC "kndieb", REFRESH_DESTRUCT);
}

