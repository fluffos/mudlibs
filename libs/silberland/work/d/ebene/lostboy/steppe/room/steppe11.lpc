
//losti
//modified by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include "detail.h"  

create() {
  ::create();

  SetProp( P_INT_SHORT, "Mitten in der Steppe" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten einer oeden Steppe, die sich in alle Richtungen "
    "ausdehnt. Du bist von vielen Huegeln umgeben. Nur westlich entdeckst "
    "Du eine Moeglichkeit, Dir den Weg durch die Huegel zu bahnen. "
    "Die Steppe scheint sehr einsam zu sein. Du fuehlst Dich verlassen. "
    "Ein Meer von Gras bewegt sich sanft im ewigen Wind der Steppe. "
    "Hier und da entdeckst Du ein paar Baeume, Buesche und Straeucher. "
    "Du bemerkst gleich, dass es hier wohl schon lange nicht mehr "
    "geregnet hat, denn die Steppe ist voellig ausgetrocknet. "
    "Am Boden ist ein kleines Loch auszumachen, das nach unten fuehrt."
    );

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_PLAIN]));
  SetProp( P_INDOORS, 0 );

  RECENT1

  AddDetail( ({ "steppe", "gegend" }), 
    "Genau so hast Du Dir eine Steppe immer vorgestellt. "
    "Fad, trocken, einsam und heiss. "
    "Ueberall sind Huegel." );

  AddDetail( ({ "norden", }), 
    "Im Norden siehst Du wie ueberall nur die Steppe mit ihrem Gras." 
   );


  AddDetail( ({ "pfad", "trampelpfad" }), 
    "Du hast den kleinen Pfad durch die Steppe schon lange verlassen." 
   );

  AddDetail( ({ "wind", }), 
    "Der ewige Wind der Steppe blaest unbarmherzig gegen Dein Gesicht. "
    "Die langen Grashalme der Steppe schauen durch den Wind wie die Wellen "
    "eines Meeres aus." 
   );

  AddDetail( ({ "halme", "grashalme", "gras" }), 
    "Die gesamte Steppe ist mit wildwucherndem Gras bedeckt. "
    "Es ist schon richtig ausgetrocknet von der stechenden Sonne."
   );


  AddDetail( ({ "wellen", "meer" }), 
    "Das war doch nur eine Metapher." 
   );

  AddDetail( ({ "gesicht", }), 
    "Du bekommst schon einen leichten Sonnenbrand." 
   );

  AddDetail( ({ "baeume", }), 
    "Nur sehr wenige Baeume lassen sich erblicken. Und die, die Du siehst, "
    "sind sehr ausgetrocknet und tragen keine Blaetter." 
   );

  AddDetail( ({ "blaetter", }), 
    "Der naechste Baum steht zu weit weg, um das genau sehen zu koennen." 
   );

  AddDetail( ({ "buesche", "dornbuesche", "massen" }), 
    "Hier und da wehen im Wind ein paar dornige Buesche. " 
    "Nur die Huegel hier ueberall sind uebersaet mit Massen von ihnen."
    );

  AddDetail( ({ "straeucher", }), 
    "Die wenigen Straeucher der Steppe wachsen nicht sehr hoch. " 
    "Anscheinend erhalten sie zu wenig Wasser."
   );

  AddDetail( ({ "wasser", }), 
   "Davon hat die Steppe eindeutig zuwenig." 
   );

  AddDetail( ({ "himmel", "sonne" }), 
    "Die Sonne strahlt blendend weiss vom Himmel." 
   );

  AddDetail( ({ "boden", "erde" }), 
    "Hm, eigentlich siehst Du nur Gras. "
    "Und ein kleines Loch, das nach unten fuehrt."
   );

  AddDetail( ({ "loch" }), 
    "Du kannst einfach nach unten gehen."
   );

  AddDetail( ({ "metapher", }), 
    "Immer diese Fremdwoerter." 
   );

  AddDetail( ({ "technik", }), 
    "Vielleicht gibt es ja Jemand, der diese Technik beherrscht." 
  );

  AddDetail( ({ "huegel", "sueden" }), 
    "Die Huegel sind ueberall mit dornigen Bueschen uebersaet. "
    "An Freihacken ist gar nicht zu denken. Direkt vor Dir im "
    "Osten steht wohl der groesste aller Huegel. Man koennte auch "
    "grosser Huegel zu ihm sagen."
    );

  AddDetail( ({ "grosser huegel", "grossen huegel" }),
    "Oestlich siehst Du den wohl groessten Huegel der Steppe. "
    "Er verhindert ein Weiterkommen nach Osten, da groessere Felsen "
    "auf ihm stehen."
   );

  AddDetail( ({ "moeglichkeit", "stelle" }), 
    "An einer Stelle wachsen die Dornbuesche nicht so dicht. Dort "
    "kannst Du in westlicher Richtung weitergehen." 
   );

  AddDetail( ({ "weiterkommen", }), 
    "Nach Osten siehst Du schwarz. Nach Westen immerhin eine "
    "Moeglichkeit."
   );

  AddDetail( ({ "stein", }), 
    "Alle Felsen scheinen aus Stein zu bestehen."
      );

  AddDetail( ({ "rand", }), 
    "Der Rand der Geheimtuer sind kuenstliche Rillen im Fels."
     );

  AddDetail( ({ "felsen", "felsbrocken", "brocken" }), 
    "Die Felsen liegen hier wohl schon seit Ewigkeiten rum. Sie schauen "
    "aus wie Findlinge. Der ganze Huegel ist mit ihnen verziert. "
    "Ein Fels scheint anders als die anderen zu sein."
    );


  AddDetail( ({ "findlinge", }), 
    "Das sind riesige Felsbrocken, die einmal ein wuetender Vulkan "
    "ausgespuckt haben muss."
     );

  AddDetail( ({ "vulkan", }), 
    "Du schaust Dich um. Aber entdeckst aber keinen."
    );

  AddDetail( ({ "fels", }), 
    "Du schaust Dir den seltsamen Fels direkt vor Dir genauer an. Er "
    "ist viel groesser als die anderen. Ausserdem fuehlt er sich anders an. "
    "Die anderen Felsen sind recht kalt, doch dieser hier strahlt eine "
    "leichte Waerme ab. Der Fels ist mit vielen Ritzen, Spalten und Rillen "
    "durchzogen.");

  AddDetail( ({ "waerme", }), 
    "Sie ist nur minimal. Aber man spuert sie gleich.");


  AddDetail( ({ "spalten", }), 
    "In den Spalten haben im Laufe der Zeit einige Blumen ihren "
    "Platz gefunden.");

  AddDetail( ({ "blumen", "steppenblumen" }),
    "Kleine vertrocknete, dornige Steppenblumen. Ihren Namen "
    "kennst Du nicht.");

  AddDetail( ({ "ritzen", }), 
    "In den Ritzen des Felsens, entdeckst Du nichts, was Dich "
    "interessieren wuerde.");

  AddDetail( ({ "rillen", "rille"}), 
    "Dein Blick verfolgt die Rillen auf dem Fels. Dir faellt nach einer "
    "Weile auf, dass sie nicht natuerlich sind. Normalerweise sind Rillen " 
    "willkuerlich kreuz und quer auf einem Fels verteilt. Doch diese hier "
    "haben eine bestimmte Form."
   );

  AddDetail( ({ "weile", "blick", "augen", "wunder", }), 
    "Achte lieber auf diese Rillen, sonst verlierst Du sie noch "
    "aus den Augen." 
   );

  AddDetail( ({ "form", }), 
    "Die Rillen bilden die Umrisse einer Geheimtuer."
    );

  AddDetail( ({ "geheimtuer", "tuer", "tuere" }), 
    "Diese Tuere ist eigentlich keine Tuere, denn alles besteht aus Stein. "
    "Aber die Umrisse lassen es so erscheinen, als koennte das eine geheime " 
    "Tuere sein. Ein Wunder, dass Dir das ueberhaupt aufgefallen ist!"
    );

  AddDetail( ({ "zug", }), 
    "Du siehst hier keine Lokomotive."
    );

  AddDetail( ({ "umrisse", }), 
    "Die Umrisse bilden den Rand einer geheimen Tuere. Aber das weisst Du "
    "mittlerweile ja schon. Jedenfalls kommt Dir das so vor. "
    "Links neben den Rillen entdeckst Du nun auch noch einen kleinen, aber "
    "interessanten Vorsprung aus Stein."
   );

  AddDetail( ({ "vorsprung", }), 
    "Auf dem Vorsprung erkennst Du einen kleinen Schriftzug."
     );

  AddDetail( ({ "schriftzug", }), 
    "Lesen bildet."
    );

  AddReadDetail( ({ "schriftzug", }), 
    "Dort steht geschrieben:\n"
    "MASES ENFFEO HCID\n"
    "Etwas verwirrt ueberlegst Du, was das heissen koennte.\n" 
   );

  AddSound( DEFAULT_SOUND,
    "Du lauschst der Wiesenlandschaft, die sich dem Wind straeubt." );

  AddSmell( DEFAULT_SMELL,
    "Du ziehst Dir eine Brise trockene, heisse Steppenluft rein." );

  AddCmd( ({ "sesam", "SESAM" }), "sesam" );
  AddCmd( ({ "oeffne", "betrete", "breche", "brich", "schlage", "schlag" }),
      "oeffne" );

  AddExit( "westen", "./steppe10" );
  SetProp( P_HIDE_EXITS, ({ "unten" }) );
}

oeffne( str ) {
  notify_fail( "Was willst Du genau machen?\n" );
  if (!str) return 0;
  if (str[<4..]==" auf") str=str[0..<5];        // simplify parsing
  if (!member((["tuer","tuere","geheimtuer","geheimtuere"]),str)) return 0;

  write("Du ziehst und zerrst an der Tuer. Aber leider regt sich nichts.\n");
  say(this_player()->Name(WER)+" scheint Probleme mit einem Fels zu haben.\n");
  return 1;
}


int sesam( string str ) {
  notify_fail( "Sprich deutlicher.\n" );
  if ( str == "oeffne dich" || str == "OEFFNE DICH")
  {
    if (TP->QueryProp(P_SP) < 10)
      return write("Deine magischen Kraefte reichen nicht aus.\n"), 1;
    TP->AddSp(-10);
    write(break_string("Du murmelst die magischen Worte, die Du irgendwo "
          "schonmal gehoert haben musst. Tatsaechlich, die Geheimtuere "
          "schiebt sich beiseite und macht einem Geheimgang Platz. Deine "
          "Neugierde ist wieder mal staerker als Du und zwingt Dich, den "
          "Geheimgang zu betreten. Kaum hast Du die Hoehle betreten, "
          "kracht die magische Tuere hinter Dir auch schon wieder zu "
          "und es wird dunkel.", 78) );
    say(TP->Name()+
        " murmelt leise ein paar Worte. Du kannst es nicht verstehen.\n");
    TP->move( ROOM "hoehle", M_GO, 0, "wird vom Fels verschlungen",
        "wird vom Fels ausgespuckt");
    return 1;
  }
  return 0;
}

