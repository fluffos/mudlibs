
//losti
//mod by arth

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

#define ENTERLOG "/d/ebene/lostboy/steppe/log/hinten_enter"

nosave mapping entered = ([]);

create() {
  ::create();
  SetProp( P_INT_SHORT, "Diebeshoehle" );
  SetProp( P_INT_LONG,
    "Endlich weisst Du, woher diese Stimmen kommen. Hier haben "
    "ein paar Diebe ihr geheimes Lager aufgeschlagen. "
    "Ueberall stehen Kisten und Truhen rum, in denen sich wohl ihre "
    "angesammelte Beute befindet. Die Diebe sitzen um einen "
    "eckigen Holztisch und spielen Karten. Einige Fackeln und "
    "Kerzen erhellen den Raum.");

  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));
      
  AddDetail( ({ "decke", "boden", "waende", "wand", "fels" }), 
    "Uninteressanter Fels.\n" );

  AddDetail( ({ "kisten" }), 
    "Mindestens 10 riesige Kisten stehen hier rum.\n" 
    "Eine Kiste faellt Dir besonders auf.\n" );

  AddDetail( ({ "kiste" }), 
    "Die ist verschlossen. Vielleicht solltest Du sie oeffnen?\n" );

  AddDetail( ({ "diebe" }), 
    "Drei Diebe haben sich hier eingenistet. Sie scheinen in letzter " 
   +"Zeit gute Beute gemacht zu haben und haben sich deshalb erstmal "
   +"zurueckgezogen, um ihre Beute zu zaehlen." );

  AddDetail( ({ "lager" }), 
    "Durch die vielen Kisten und Truhen und durch die Anwesenheit "
    "der Diebe laesst sich daraus schliesen, dass es sich um ihr "
    "Lager handeln muss." );  

  AddDetail( ({ "truhen" }), 
    "Die Diebe hindern Dich daran, sich an den Truhen schaffen "
    "machen. Nur eine Truhe direkt vor Dir koenntest Du problemlos "
    "oeffnen." );  

  AddDetail( ({ "truhe" }), 
    "Die Truhe vor Dir ist fest mit einem Zahlenschloss verriegelt "
    "worden." );  

  AddDetail( ({ "schloss", "zahlenschloss" }), 
    "Das Zahlenschloss ist momentan verriegelt.\n"
    "Eine fuenfstellige Zahl ist darauf abzulesen. "
    "Versuch Dein Glueck und stell die richtige Zahl ein." );  

  AddDetail( ({ "zahl" }), 
    "Momentan ist das Schloss auf 99999 gestellt." );  

  AddDetail( ({ "fackeln", "kerzen" }), 
    "Die erhellen den Raum, sodass Du Deine Lichtquelle aus machen kannst." );  

  AddDetail( ({ "tisch", "holztisch", "holz" }), 
    "Ein alter Holztisch mit 4 gleichlangen Beinen. Drumherum "
    "sitzen die drei Diebe. Sie spielen gerade Karten. Da sie "
    "in einer interessanten Phase des Spiels sind, kuemmern "
    "die sich wenig um Dich. Dein Glueck." );  

  AddDetail( ({ "beine" }), 
    "Du hast zwei, der Tisch hat vier.");  

  AddDetail( ({ "beute", "schaetze" }), 
    "Die Schaetze der Diebe koennen nur in den Truhen und Kisten "
    "gelagert sein.");  

  AddDetail( ({ "karten", "phase", "spiel", "skat" }), 
    "Die Diebe spielen gerade Skat. Eine Karte vom "
    "Oberdieb scheint markiert worden zu sein.");  

  AddDetail( ({ "karte" }), 
    "Es handelt sich um die Karte Herz neun. Dabei ist die neun "
    "umkreist worden." );  

  AddSound( DEFAULT_SOUND,
    "Hier tief im Inneren des Felsens ist es recht ruhig, wenn die "
    "Diebe mal nicht da sein sollten." );

  AddSmell( DEFAULT_SMELL,
    "Du riechst verbranntes Fleisch." );

  AddSmell( ({ "fleisch" }),
    "Die Diebe haben hier wohl ein bisschen Fleisch gebraten.");

  AddCmd( ({ "schliess","schliesse", "oeffne" }), "beweg_etwas" );
  AddCmd( ({ "stelle", "stell" }), "stelle" );

  AddExit( "vorne", "./hoehle" );

  AddItem( NPC "dieb", REFRESH_DESTRUCT);
  AddItem( NPC "oberdieb", REFRESH_DESTRUCT); 
  AddItem( NPC "jungdieb", REFRESH_DESTRUCT);
}


beweg_etwas( str ) {
  if (present("dieb"))
    return notify_fail("Das wuerde der Dieb sicher nicht zulassen!\n"), 0;

  notify_fail( "Was willst Du denn oeffnen?\n" );
  if( str == "kiste" ) {
    write( break_string("Du oeffnest die Kiste und findest darin: Nichts. "
                        "Du Glueckspilz scheinst wohl die einzig leere "
                        "Kiste inspiziert zu haben. ", 78) );
    say(this_player()->Name(WER)+" oeffnet eine Kiste.\n");
    return 1;
  }
  if( str == "truhe" ) {
    write( break_string("Du versuchst die Truhe zu oeffnen, aber schaffst "
                        "es nicht. Vielleicht liegt es ja an dem grossen "
                        "Zahlenschloss, das die Truhe verriegelt.", 78) );
    say(this_player()->Name(WER)+" kaempft mit einer Truhe.\n");
    return 1;
  }
  return 0;
}

stelle( str )
{
  int z;
  string dummy;

  if (present("dieb"))
    return notify_fail("Das wuerde der Dieb sicher nicht zulassen!\n"), 0;

  notify_fail("Du kannst nur Zahlen von 0 bis 99999 "
      "auf dem Schloss einstellen.\n");

  if (stringp(str))
  {
    if (str[<4..]==" ein") str=str[0..<5];
    else if (str[<4..]==" auf zahlenschloss ein") str=str[0..<5];
    else if (str[<4..]==" auf schloss ein") str=str[0..<5];
    else if (str[0..7]=="auf zahl") str=str[8..];
    else if (str[0..16]=="schloss auf zahl ") str=str[17..];
    else if (str[0..22]=="zahlenschloss auf zahl ") str=str[23..];
    else if (str[0..3]=="auf ") str=str[4..];
    sscanf(str, "%d%s", z, dummy);
    if(z>=0 && z<=99999)
    {
      write( break_string("Du stellst das Zahlenschloss auf "+z+". Aber "
            "entweder dies war die falsche Kombination, oder aber das "
            "Schloss ist gaenzlich defekt - jedenfalls laesst sich die "
            "Truhe nach wie vor nicht oeffnen. Veraergert stellst Du das "
            "Schloss wieder auf 99999 zurueck.", 78));
      say(this_player()->Name(WER)+" spielt ein wenig an einer Truhe herum.\n");
      return 1;
    }
  }
  return 0;
}

void init() {
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt die Hoehle nach hinten.\n",
    dtime(time()), CAP(getuid(TP))));
}

