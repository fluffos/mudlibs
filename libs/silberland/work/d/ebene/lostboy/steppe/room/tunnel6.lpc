
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

#define ENTERLOG "/d/ebene/lostboy/steppe/log/tunnel6_enter"

nosave mapping entered = ([]);

create() {
  ::create();
  SetProp( P_INT_SHORT, "Tunnel der Riesenwuermer" );
  SetProp( P_INT_LONG,
    "Hier scheint das Zentrum der Riesenwuermer zu sein. Eine grosse "
    "Hoehle breitet sich vor Dir aus. Hier bruetet die Wurmkoenigin wohl "
    "neue Arbeiter aus. Der Schleim nimmt hier Ueberhand. Du musst "
    "aufpassen, dass Du nicht im Schleim versinkst. Von oben kommt "
    "eine etwas weniger miefige Luft in diesen grossen Hoehlenraum.");

  SetProp( P_LIGHT, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 15]) );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "boden","decke","waende","wand","hoehlenraum","raum" }), 
          "Es besteht alles hier aus fester Erde. In der Decke ist eine "
          "Oeffnung, die Dich hier wieder rausbringt." );

  AddDetail( ({ "oeffnung", "loch" }), 
      "Du kannst den Raum durch die Oeffnung nach oben verlassen.");

  AddDetail( ({ "erde" }), 
          "Druiden wuerden Humus dazu sagen.\n" );

  AddDetail( ({ "Druiden" }), 
      "Seltsame Leute... was die so alles sagen...");

  AddDetail( ({ "leute" }), 
      "Die Druiden.");

  AddDetail( ({ "haufen", "fehlgeburt" }),
          "Mehr kann man zu dieser Fehlgeburt nicht sagen.\n" );

  AddDetail( ({ "arbeiter" }), 
          "Schwupp. Schon wieder ist ein neuer Haufen Schleim auf die Welt "
          "gekommen.\n" );

  AddDetail( ({ "wuermer", "riesenwuermer", "bestien", "riesenbestien" }), 
          "Diese zweimeterlangen Riesenbestien sehen gruselig aus. "
          "Jedoch beachten sie Dich gar nicht." );

  AddDetail( ({ "humus" }), 
          "Abenteurer sagen aber immernoch Erde.\n" );

  AddDetail( ({ "ueberhand" }), 
      "Nimm doch nicht immer alles so genau!");

  AddDetail( ({ "zentrum", "hoehle" }), 
          "Der Anblick widert Dich an. Ueberall haengt Schleim "
          "herum. Er zieht lange Faeden. Der Gestank hier unten ist "
          "bestialisch." );

  AddDetail( ({ "gestank","luft" }), 
      "Na riech doch mal!");

  AddDetail( ({ "fuesse", "schritt" }), 
          "Deine Fuessen sind schon von den Faeden befallen. "
          "mit jedem Schritt ziehst Du eine Schleimspur hinter "
          "Dir her." );

  AddDetail( ({ "faeden", "schleimspur" }),
      "Nein, Du willst das gar nicht naeher untersuchen... *wuerg*");

  AddDetail( ({ "anblick", "schleim" }), 
          "Fuer nichts auf der Welt wuerdest Du das anfassen."  );

  AddDetail( ({ "welt" }), 
      "Hoffentlich bricht sie fuer Dich nie zusammen!");

  AddSmell( ({ DEFAULT_SMELL, "gestank" }),
      "Es riecht nicht, es stinkt. Und das furchtbar.\n"
      "Angewidert haeltst Du Dir die Nase zu.\n");

  AddSound( ({ DEFAULT_SOUND, "bohren" }),
      "Ueberall hoerst Du Bohren hinter den Waenden." );

  AddExit( "oben",
      ([ EX_DEST: "./tunnel3",
         EX_PLMSG: "Du kletterst behende nach oben.\n" ]) );

  AddItem( NPC "wurm", REFRESH_DESTRUCT);
  AddItem( NPC "koenigin", REFRESH_DESTRUCT);
  AddItem( NPC "wurm", REFRESH_DESTRUCT); 
}

void init() {
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt tunnel6.\n",
    dtime(time()), CAP(getuid(TP))));
}
