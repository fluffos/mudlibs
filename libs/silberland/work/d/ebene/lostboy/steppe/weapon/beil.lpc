
//losti
//mod by arth
// Beil der Diebe in der Steppe
//

inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <weapon.h>
#include "../def.h"

void create() {
	if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Beil" );
  SetProp( P_LONG,
    "Ein Beil bestehend aus einem Holzstiel und mit einer stumpfen "
    "Stahlklinge. Normalerweise benutzt man es um Baeume oder aehnliches "
    "zu hacken. Doch sicher lassen sich auch Gegner von diesem Werkzeug "
    "beeindrucken. ");
  SetProp( P_NAME, "Beil" );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_WEIGHT, 1300 );
  SetProp( P_WC, 100);
  SetProp( P_WC_FIXFACTOR, 0.0);
  SetProp( P_VALUE, 700 );
  SetProp( P_NR_HANDS, 1 );
  SetProp( P_DAM_TYPE, DT_SLASH );
  SetProp( P_WEAPON_TYPE, WT_AXE );
  SetProp( P_MATERIAL, ([MAT_STEEL:30, MAT_MISC_WOOD:70]) );
  AddId("beil");
}
