
//losti
//mod by arth
// Zerbrochene Bierflasche
//

inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <weapon.h>
#include "../def.h"

void create() {
	if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Eine kaputte Bierflasche" );
  SetProp( P_LONG,
    "Diese Flasche hast Du einmal einem Wirt abgenommen. "
    "Er hat den Boden abgeschlagen, jetzt hat die Flasche "
    "viele spitze Glaskanten, die sehr wehtun koennen.");
  AddDetail( ({ "glaskanten", "kanten" }), 
    "Der untere Teil der Flasche fehlt. Du haeltst nur den "
    "oberen Teil in Deiner Hand fest. Am Ende der Flasche "
    "ragen diese spitze Kanten heraus."  );  
  SetProp( P_NAME, "Bierflasche" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_WEIGHT, 200 );
  SetProp (P_WC_BONUS,(["\ninhaber":200]));    
  SetProp (P_WC, 80);
  SetProp(P_WC_FIXFACTOR, 0.1);
  SetProp( P_VALUE, 10 );
  SetProp( P_NR_HANDS, 1 );
  SetProp (P_NOBUY, 1);
  SetProp( P_WEAPON_TYPE, WT_KNIFE );
  SetProp (P_DAM_TYPE, DT_PIERCE);  
  SetProp (P_MATERIAL, MAT_GLASS);
  SetProp(P_QUALITY_DECAY, 25);
  AddId( ({"flasche", "bierflasche"}) );
}
