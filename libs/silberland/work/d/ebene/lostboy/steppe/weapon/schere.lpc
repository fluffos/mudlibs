
/*
** first release 27.12.1997
** Eine Skorpionschere
** (von Booster)
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(this_object())) return;
  ::create(); 
  SetProp(P_SHORT, "Eine Skorpionschere");
  SetProp(P_LONG, "Diese Schere gehoerte einst Skorpo dem maechtigen Skorpion "
                  "er hat sie sicherlich nicht freiwillig hergegeben. Skorpo "
                  "konnte mit den Scheren sehr gut umgehen, nur ob sie Dir "
                  "gute Dienste leisten koennen, ist zu bezweifeln. ");
  SetProp(P_NAME, "Skorpionschere");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schere","skorpionschere"}) );
  SetProp(P_VALUE, 400);
  SetProp(P_WEIGHT, 500);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp (P_MATERIAL, MAT_CHITIN);
  SetProp (P_WC_BONUS,(["\nskorpion":200]));  
  SetProp(P_WC, 90);
  SetProp(P_NR_HANDS, 1);
}
