//	
//    Der Holzring aus dem runden Ei
//	

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Holzring");
  SetProp(P_LONG, "Ein geschnitzer Holzring ohne alles. Er befand sich mal "
                  "in einem kuenstlichen Ei. Vielleicht hat er magische "
                  "Kraefte? ");
  SetProp(P_NAME, "Holzring");
  SetProp(P_GENDER, MALE);
  AddId(({"ring","holzring","\nksg_ausruestung"}));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 5);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 1);
  SetProp (P_MATERIAL, ([ MAT_MAGIC:5, MAT_EBONY:95 ]) );
  AddDetail("kraefte","Das musst Du selber herausfinden.");
}
