/*
** first release 27.12.1997
** Ein Skorpionpanzer
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Skorpionpanzer");
  SetProp(P_LONG,
      "Ein Panzer aus Chitin, der Dich vor Verletzungen schuetzen "
      "soll. Er gehoerte mal zu einem Riesenskorpion. Das Material "
      "ist besonders hart und kann einige sehr harte Schlaege "
      "abwehren.");

  SetProp(P_NAME, "Skorpionpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer","skorpionpanzer"}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1800);
  SetProp(P_AC, 25);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_MATERIAL, MAT_CHITIN);
}
