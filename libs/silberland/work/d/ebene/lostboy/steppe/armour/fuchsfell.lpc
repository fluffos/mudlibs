// Ein Fuchsfell
// 2002-07-17  Feyaria@SilberLand

#include "../def.h"
inherit "std/armour";

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gelbgraues Fuchsfell");
  SetProp(P_LONG, 
    "Dieses Fuchsfell ist gelbgrau und sehr struppig, und daher nicht sehr "
    "viel wert. Wenn Du nicht zu gross bist, kannst Du es als Umhang benutzen.");
  SetProp(P_NAME, "Fuchsfell");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fell", "fuchsfell", "steppenfuchsfell","\nfell_is_gerb_able"}));
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 50);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE:140]) );
}

