//	
//    Waffenrock der Diebe
//	

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Waffenrock");
  SetProp(P_LONG, "Dieser schlichte Waffenrock ist sehr leicht. "
           "Durch diesen Effekt bleibt man im Kampf sehr "
           "geschickt. Trotzdem bietet der Waffenrock auch "
           "einen ganz brauchbaren Schutz.");

  SetProp(P_NAME, "Waffenrock");
  SetProp(P_GENDER, MALE);
  AddId(({"waffenrock","rock","\nksg_ausruestung"}));
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 600);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_MATERIAL, MAT_LEATHER);
  SetProp(P_AC, 17);
}
