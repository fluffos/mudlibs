//	
//    Kettenhemd der Diebe
//

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Kettenhemd");
  SetProp(P_LONG, "Es handelt sich um ein einfaches Kettenhemd der "
      "billigsten Art. Doch die Diebe tragen es mit Stolz. "
      "Seine Enden sind jeweils schwarz abgesetzt und auf der "
      "Brust ist das Wappen der Diebe aufgemalt.");

  SetProp(P_NAME, "Kettenhemd");
  SetProp(P_GENDER, NEUTER);
  AddId(({"hemd","kettenhemd","\nksg_ausruestung"}));
  SetProp(P_WEIGHT, 1600);
  SetProp(P_VALUE, 750);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 22);
  SetProp (P_MATERIAL, MAT_IRON);

  AddDetail( ({ "wappen", "diebe" }), 
          "Das Wappen zeigt einen toten Helden vor silbernem "
      	 +"Mond in schwarzer Nacht.");

  AddDetail( ({ "helden", "held", "mond", "nacht" }), 
            "In einer dunkeln Ecke, liegt der Held. Blutueberstroemt. "
            "Ein Opfer der Diebe.");

  AddDetail( ({ "ende", "enden" }), 
          "Durch die schwarze Farbe an den Enden des Kettenhemdes wirkt der "
          "Traeger dieser Ruestung unheimlich.");  
}
