
//     Der Oberdieb
//losti
//mod by arth
//     

inherit "std/inpc";

#include <properties.h>
#include <new_skills.h>
#include <language.h>
#include <combat.h>  // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();  
  create_default_npc(18);
  AddId(({"oberdieb", "\ndieb", "dieb"}));
  SetProp(P_SHORT,"Der Oberdieb");
  SetProp(P_LONG,
     "Der boese Oberdieb schaut Dich ganz grimmig an. Er wartet nur auf "
     "eine Geste von Dir, damit er einen guten Grund hat Dich zu killen.");
  SetProp(P_NAME, "Oberdieb");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  SetProp(P_DEFAULT_INFO,"sagt: Belaestige einen anderen.\n");
  SetProp (P_SIZE, 190+random(20));
  SetProp(P_ALIGN, -250); 
  SetChats(1, ({
    "Ein Dieb sagt: Hau ab hier.\n",
    "Der Oberdieb schaut Dich boese an.\n",
    "Ein Dieb meckert: Fass blos nix an.\n",
    "Jemand fragt: Was suchst Du hier ueberhaupt?\n"}) );  
  add_select_commands();

  SUID;
  clone_object( "/p/weapon/sword/kurzschwert")->move(this_object());
  clone_object( ARMOUR "kettenh")->move(this_object());
  command_me("zuecke kurzschwert");
  command_me("trage alles"); 

  SetProp(P_SPELLRATE,30);

  AddSpell(3,300, 
    "Der Oberdieb schlaegt vor lauter Hass in Dein Unterleib.\n",
    "Der Oberdieb schlaegt @WEN in den Unterleib.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2,450, 
    "Der Oberdieb weicht Deinen Schlaegen aus und kontert hart.\n",
    "Der Oberdieb weicht @WEN aus und kontert hart.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
 command("nimm alles aus leiche");
 command("zuecke_beste_waffe");
 command("trage_beste_ruestungen");
}

void init() {
  ::init();
  if (this_player() && this_player()->id("\ndieb"))
  AddDefender(this_player());
}

void InformDefend(object enemy) {
  Kill(enemy);
}
