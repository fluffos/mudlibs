
//*** NPC Weiser Mann*
/// ich nehm mal an der npc is noch nicht fertig oder?
//lost
//mod by arth

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <language.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <moredef.h>
#include <mnpc.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc( 22 );
  AddId(({"gerio", "\ngerio"}));

  SetProp(P_SHORT, "Gerio der Weise");
  SetProp(P_LONG,"Dieser graue alte Mann hat schon ein paar Jaehrchen auf dem "
                 "Buckel. Ja, der Buckel ist schon sehr gut zu sehen. Tag "
                 "ein, Tag aus wandert er durch die Steppe. Immer auf der "
                 "Suche nach noch mehr Wissen und Geheimnissen. Aber momentan "
                 "scheint es ihm nicht so gut zu gehen.");

  AddDetail( ({ "buckel", }), 
    "Dieser Buckel entstellt Gerio. Er sieht richtig haesslich aus. ");

  SetProp(P_LOG_INFO, "lostboy/steppe.log");
  SetProp(P_NAME, "Gerio"); 
  SetProp(P_GENDER, MALE);

  SetProp(P_ARTICLE, 0);
  SetProp(P_HANDS,
      ({" wie wild mit seinen Haenden", 70+random(30), DT_BLUDGEON}) );
  SetProp(P_ALIGN, 700);
  SetProp(P_RACE, "Mensch");
  SetProp(P_BODY, 90+random(11));
  SetProp(P_SIZE, 170+random(11));

  SetProp(P_MNPC_AREA, "/d/ebene/lostboy/steppe/room/steppe" );
  SetProp(P_MNPC_WAIT, ({ 30+random(4), 30, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/ebene/lostboy/steppe/room/steppe9" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetAttackChats(6, ({ 
    "Gerio verzaubert Dich. Du kannst kaum noch was sehen.\n",
    "Gerio sagt: Ich hasse Dich.\n"}) );

  SetProp (P_DIE_MSG, " fliegt zwischen die hohen Grashalme und stirbt.\n");


  SetChats(1, ({
    "Gerio fragt: Hey Du, suchst Du was?\n",
    "Gerio sagt: Bleib doch mal stehen, vielleicht kann ich Dir helfen.\n",
    "Gerio fragt: Hast Du meine Kuscheldecke gesehen?\n",
    "Gerio raet: Geh bloss nicht nach Midas, das Stadtleben ist verdorben.\n"}) 
  );

// Spells von Gerio
  SetProp(P_SPELLRATE, 35);

  SetProp(P_NOMAGIC, 5); 

  AddSpell(3, 600,
    "Gerio feuert aus seinem Stock einen Feuerball auf Dich.\n",
    "Gerio feuert einen Feuerball auf @WEN ab.\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 800,
    "Gerio wird auf einmal ganz stark und haut Dich um.\n",
    "Gerio haut @WEN um.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]));


  SetProp (P_DEFAULT_INFO,
      ({ "fragt: Weisst Du das echt nicht?\n",
         "fragt: Woher soll ich das wissen?\n",
         "sagt: Versteh ich jetzt nicht.\n",
         "sagt: Bring mir lieber meine Kuscheldecke!\n",
         "schuettelt den Kopf.\n",
         "tut so, als ob der die Frage nicht gehoert haette.\n"
      }));

  AddInfo("schriftzeichen",
    "sagt: Erzaehl mir das bitte genauer.\n"); 
  AddInfo("hilfe", 
    "weint: Bitte hilf mir, meine Kuscheldecke wiederzubekommen.\n");
  AddInfo("zordan", "grinst: Ein ehrenwerter Gentleman.\n");
  AddInfo(({"kuscheldecke", "decke"}),
    "Sie wurde mir von ein paar fiesen Dieben gestohlen. Die treiben sich "
    "immer hier in der Steppe herum und klauen alles, was nicht niet- und "
    "nagelfest ist. Meine Kuscheldecke haben sie mir auch weggenommen. Wenn "
    "Du sie mir zurueckbringen kannst, wuerde ich mich erkenntlich zeigen.",
    "flennt: ");
  AddInfo("diebe", 
    "Momentan scheinen sie sich zurueckgezogen zu haben, "
    "aber ich denke, sie werden sich nicht weit von hier versteckt halten.",
    "zittert: ");
  AddInfo("steppe", 
    "Auf den ersten Blick wirkt die Steppe recht langweilig. " 
    "Doch wenn man sie richtig erforscht, gibt es eigentlich ueberall " 
    "etwas zu entdecken.", "erzaehlt: ");
  AddInfo("lostboy", "sagt: Ja, den kenne ich. Er besucht mich hier oft.\n");
  AddInfo("steppenkraut", 
    "Das ist eine Heilpflanze. Wenn man sie auf seine Wunden " 
    "legt, hat sie eine leicht heilende Wirkung. Ich habe noch einen " 
    "Tip fuer Dich. Du darfst sie nicht nur einfach nehmen, sonst " 
    "zerstoerst Du sie! Man muss sie vorsichtig vom Stengel " 
    "abtrennen.", "sagt: ");
  AddInfo("creative", 
    "sagt: Ohne Creative wuerde ich nicht leben.\n");
  AddInfo("dante",
    "sagt: Hmm, Dante hat mir einiges beigebracht.\n");
  AddInfo(({"steinplatte", "platte"}), 
    "Ich kenne die Steinplatte, die ist hier irgendwo in " 
    "der Steppe. Aber die Bedeutung der Platte kenne ich nicht.",
    "gruebelt: ");
  AddInfo("fas tfo od", 
    "Nein, nein, nein. Ich verstehe zwar viele alte Sprachen, " 
    "aber das ist zu schwer. Das verstehe ich nicht.","denkt: ");
  AddInfo("ha tsch iges und heit", 
    "antwortet: Ahh ja, das ist eine sehr alte Sprache. Die gibt es schon\n" 
    "Gerio antwortet: lange nicht mehr. Mal ueberlegen wie die Uebersetzung "
    "lautet.\n"
    "Gerio gruebelt.\n" 
    "Gerio sagt: Es scheint ein Raetsel zu sein:\n" 
    "Kein Fenster laesst die Sonne ein,\n" 
    "tuerlos und freudlos das Zimmer.\n" 
    "Kaelte kriecht Dir in Arm und Bein,\n" 
    "Freund hier schlaefst Du fuer immer!\n" 
    "Gerio fragt: Kannst Du damit was anfangen?\n" );
  AddInfo("grab", 
    "Hmmm, vielleicht ist diese Steinplatte ja ein Grab?","meint: ");
  AddInfo("huegel", 
    "sagt: Einer der Felsen auf dem grossen Huegel ist sonderbar.");
  AddInfo(({"felsen", "fels"}), 
    "Meinst Du den auf dem Huegel? Komisches Teil, geh nicht " 
    "zu nah an ihn ran. Dort verschwinden oft Leute.","meint: ");
  AddInfo(({"woody", "feyaria", "angrox", "thor", "lamuerte" }), 
    "raunt: Ziemlich faehig. Und trotzdem weiss ich nicht mehr.");
  AddInfo("holzring", 
    "Haha, das ist bestimmt nichts magisches. Glaube mir, ich bin weise.",
    "sagt: ");
  AddInfo("ring", 
    "fragt: Der Holzring?\n");
  AddInfo("zeltlager", 
    "Das Zeltlager liegt westlich der Steppe. Gruesse Sedda von mir, " 
    "wenn Du sie dort mal triffst.", "meint: ");
  AddInfo("sedda", 
    "sagt: Sie kommt hin und wieder hier vorbei und sucht nach Kraeutern.");
  AddInfo("heiltrank", 
    "Ich habe einen ganzen Schrank voll davon, Du auch?", "prahlt: ");
  AddInfo("schrank", 
    "Nein, nein. Der gehoert mir.", "zuckt: ");
  AddInfo("stock",
    "fragt: Den Krueckstock meinst Du, oder?\n");
  AddInfo("krueckstock",
    "droht: Mit dem werd ich Dir den Po blau hauen.\n");
  AddInfo(({"loch", "loecher"}), 
    "Pass auf, in der Steppe hat es viele Loecher.","raet: ");
  AddInfo("vinyle", 
    "Es ist mir nicht erlaubt, darueber zu sprechen.","zittert: ");
  AddInfo(({"zaubertrank","zaubertraenke"}), 
    "fragt Dich neugierig: Hast Du schon alle?\n");
  AddInfo("kraut", 
    "Was fuer ein Kraut meinst Du?","fragt: ");
  AddInfo("midas", 
   "Dort war ich noch nie. Ich hasse das Stadtleben. Midas " 
   "ist die groesste Stadt im Silberland. Wenn Du zu ihr willst, musst Du " 
   "weit nach Westen ziehen.","erzaehlt: ");
  AddInfo("gras", 
    "An manchen Stellen waechst das Gras recht sonderbar.","denkt: ");
  AddInfo("zwerge", 
    "Ich hasse die Zwerge. Die sind klein und haesslich. Ich werde " 
    "nie verstehen, warum sie in so dunklen Hoehlen hausen, die Sonne ist " 
    "doch so schoen.", "sagt: ");
  AddInfo("elfen", 
    "Ich habe noch nie eine Elfe gesehen. Hier lassen die sich nie " 
    "blicken. Stimmt es, dass die spitze Ohren haben?","zuckt: ");
  AddInfo("merlin", 
    "Ich glaube, er ist der Einzige, der mehr weiss als ich.","weint: ");
  AddInfo(({"straeucher", "buesche", "baeume"}), 
    "Die Flora der Steppe. Ich bin dabei sie zu erforschen. " 
    "Am liebsten bin ich auf dem hohen Baum. Von dort hat man eine super "
    "Aussicht.", "erzaehlt: ");
  AddInfo("baum", 
    "sagt: Den musst Du schon selber finden!\n");

  SUID;
  clone_object( WEAPON "stock")->move(this_object());
    command_me("zuecke stock");
}

void give_notify(object ob)
{
  if( (ob->id("kuscheldecke"))) {
    write(break_string("Gerio freut sich sehr, dass er endlich "+
      "seine geliebte Kuscheldecke wieder hat, knuddelt Dich wild "+
      "und gibt Dir dafuer eine unscheinbare Tube. Na irgendeinen Sinn "+
      "muss sie ja wohl haben, oder hat er Dich nur verarscht?\n", 78) );
    say(CAP("Gerion knuddelt "+ TPN +"."), ({TP}) );
    WLOG( LOG "decke", "gibt Gerio die Kuscheldecke"); 
    CLONE("/d/dschungel/dante/weg/obj/creme", TP);
    ob->remove();
    return;
  }
  ::give_notify(ob);  
}

void die(int poisondeath) {
  write_file( LOG "gerio.kills" ,
    ctime()+": "+CAP(getuid(PL))+" killt Gerio.\n");
  ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if (killer == ME) {
    write_file( LOG "gerio.deads" ,
      ctime()+": Gerio hat "+CAP(getuid(PL))+" umgebracht.\n");
  }
}
