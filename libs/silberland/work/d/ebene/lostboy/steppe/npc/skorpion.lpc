
/*
** first release 27.12.1997 in Silberland (sl.mud.de:4711)
** Ein verzauberter Riesenscorpion
** (von Booster)
*/
//mod by arth

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "../def.h"
#include <new_skills.h>
#include <wizlevels.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(25);
  AddId( ({"skorpo", "skorpion", "\nskorpion"}) );
  SetProp(P_SHORT, "Skorpo");
  SetProp(P_LONG, "Dies ist Skorpo, ein Riesenskorpion, er ist sicher "
      "verzaubert. Wie das wohl passiert ist? Er beobachtet jede Deiner "
      "Bewegungen. Seinen Panzer aus Chitin und seine riesigen Scheren "
      "machen ihn zu einem sehr starken Gegner. An seinem Hinterteil hat "
      "er einen grossen Giftstachel, der voll aufgeladen und angriffsbereit "
      "ist." );
  SetProp(P_NAME, "Skorpo");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_ALIGN, -400);
  SetProp(P_BODY, 125);
  SetProp(P_HANDS, ({" mit seinen Scheren", 200, DT_POISON}) );
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_RACE, "Skorpion");  
  SetProp(P_SIZE, 100+random(20)); 

  SUID;
  clone_object( WEAPON "schere")->move(this_object());
  command("zuecke schere");
  clone_object( ARMOUR "skpanzer")->move(this_object());
  command("ziehe panzer an");

  SetProp(P_SPELLRATE,20);
  AddSpell(2,400, 
           "Skorpo sticht mit seinem Giftstachel nach Dir.\n",
           "Skorpo sticht mit seinem Giftstachel nach @WEM.\n",
           DT_POISON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(3,500, 
           "Skorpo landet mit seinen Scheren einen harten Treffer.\n",
           "Skorpo trifft @WEN mit seinen Scheren hart.\n",
           DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetChats(2, ({
    "Skorpo prueft Dich mit seinen wuetenden Augen.\n",
    "Der Skorpion kommt Dir gefaehrlich nahe.\n",
    "Skorpo lacht ueber die Magier.\n",
    "Skorpo sagt: Hehe, dieser dumme kleine Magier.\n",
    "Skorpo sagt: Was er sich nur dabei gedacht hat??\n"
  }) );

  SetAttackChats(30, ({
    "Skorpo sagt: Du wirst STERBEN!!!!\n",
    "Skorpo schreit: Endlich bekomm ich wieder was zu ESSEN!!!\n",
    "Skorpo sagt: nicht mal Magier koennen mich toeten!!!!\n",
    "Skorpo lacht nur: Du kleiner Winzling? HaHaHa!\n"
  }) );

  SetProp( P_DIE_MSG,
      " schwingt ein letztes mal seinen Giftstachel und stirbt.\n" );
  SetProp(P_DEFAULT_INFO,"sagt: MAGIER PAH !! Sind alle nur ein Wizz!!\n");

  AddInfo("magier",
    "Hehe er dachte er koennte MICH verzaubern so ein Dummkopf! "
    "Er wollte mich pulverisieren aber sein Zauber ist missglueckt... "
    "Statt dessen hatte er mich vergroessert... "
    "So ein PFUSCHER!! Er hatte Glueck, dass er unsterblich war!!",
    "sagt: ");

  AddInfo(({"zauberei","zauber"}),
    "Durch ihn wurde ich so riesig!\n", "flucht: ");
}

void die(int poisondeath) {
  write_file( LOG "skorpo.kills" ,
    ctime()+": "+CAP(getuid(PL))+" killt den Skorpo.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME) {
    write_file( LOG "skorpo.deads" ,
      ctime()+": Der Skorpo hat "+CAP(getuid(PL))+" umgebracht.\n");
  }
}
