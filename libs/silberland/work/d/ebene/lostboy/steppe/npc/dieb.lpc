
//
//     Der Dieb
//losti
//mod by arth
//

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "../def.h" 

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(12); // Soeldner hat 13
  AddId( ({"dieb","\ndieb"}) );
  SetProp(P_SHORT,"Der Dieb");
  SetProp(P_LONG,
    "Der Dieb schaut Dich ganz grimmig an. Er wartet auf ein Zeichen vom "
    "Oberdieb, um Dich angreifen zu koennen. Bei seinem letztem Beutezug hat "
    "er einem Haendler ein Beil und ein Kettenhemd abgenommen, die ihm so "
    "gut gefielen, dass er diese gleich mal ausprobieren will.");  
  SetProp(P_NAME, "Dieb");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);  //maennlich
  SetProp(P_DEFAULT_INFO,"sagt: Willst Du mich dumm anmachen?\n");
  SetProp (P_MAX_HANDS, 2); //Haende
  SetProp (P_ALIGN, -200+random(30)); //Gut-boese  
  SetProp (P_SIZE, 160+random(20));  //Groesse
  SUID;

  CLONEME( WEAPON "beil");
  command("zuecke beil");
  CLONEME( ARMOUR "kettenh");
  command("ziehe kettenhemd an");
}

void init() {
  ::init();
  if(TP && TP->id("\ndieb"))
  AddDefender(this_player());
}

void InformDefend(object enemy) {
  Kill(enemy);
}

