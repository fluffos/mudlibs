
//losti
//mod by arth
//
//     Der Dieb
//

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(12);
  AddId( ({"dieb", "\ndieb"}) );
  SetProp(P_SHORT,"Der Dieb");
  SetProp(P_LONG, 
    "Die Diebe des Lokals wollen ueberhaupt nix von Dir wissen. "
    "Wenn, dann interessiert sie nur Dein Geld.");  
  SetProp(P_NAME, "Dieb");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  SetProp(P_DEFAULT_INFO,"sagt: Gib mir Deine Silbermuenzen!\n");
  SetProp (P_SIZE, 160+random(30));  
  SetProp(P_ALIGN, -100);

  SUID;
  clone_object( "/p/weapon/knife/dolch")->move(this_object());
  command_me("zuecke dolch");
  
  clone_object( ARMOUR "rock")->move(this_object());
  command_me("ziehe waffenrock an"); 
}

