
/*
losti
mod by arth
** Der Inhaber der Diebesschenke
*/

inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc( 15 );
  AddId( ({"inhaber", "streuner", "besitzer", "\ninhaber"}) );
  SetProp(P_SHORT, "Der Inhaber");
  SetProp(P_LONG, 
    "Ein boesartig aussehender Streuner. Voller Taetowierungen. "
    "Keiner kennt seinen Namen, vielleicht will er anonym bleiben. "
    "Im Stress scheint er hier jedenfalls nicht zu sein. Als Du ihn "
    "das erste mal angesehen hast, ist Dir sofort seine uebermaessig "
    "grosse Statur aufgefallen.");
  AddDetail( ({ "taetowierungen", }), 
          "Auf einer Taetowierung faellt Dir die Zahl fuenf besonders "
          "auf, da sie eine andere Farbe hat als die anderen vier.");
  AddDetail( ({ "zahl", }),
          "34578, dabei hat die fuenf eine andere Farbe.");
  AddDetail( ({ "farbe", }), 
          "Eine rote fuenf.");
  SetProp(P_NAME, "Inhaber");
  SetProp(P_GENDER, MALE);
  SetProp (P_SIZE, 200+random(20));
  SetProp(P_LOG_INFO, "lostboy/steppe.log"); 
  SetProp(P_HANDS, ({" wie besessen mit einer Bierflasche", 85}));
  SetProp (P_MAX_HANDS, 2);
  SetProp(P_ALIGN, -150);
  SetProp(P_RACE, "Mensch");
  SetProp (P_DIE_MSG, " landet hinter der Theke.\n");

  SetAttackChats(6, ({
    "Der Inhaber ruft ein paar Diebe um Hilfe.\n",
    "Der Inhaber sagt: Dich bediene ich nie mehr!\n"}) );

  SetProp(P_DEFAULT_INFO,"sagt: Trink oder verschwinde.\n");

  AddInfo("diebe",
    "Die Zeiten sind schwer. Ich kann es verstehen, dass einige "
    "Menschen auf illegale Art ihr Geld verdienen.","sagt: ");

  AddInfo("steppe",
    "Die Steppe ist fuer die Diebe der ideale Ort, um sich zu "
    "verstecken. Ueberall sind Hoehlen und Loecher.","sagt: ");

  AddInfo("hoehlen",
    "Die sind ueberall, hast Du noch keine entdeckt?","fluestert: ");

  AddInfo("loecher",
    "Golfspieler haetten ihre Freunde an der Steppe.","sagt: ");

  AddInfo("lostboy",
    "Ein schlechter Kunde.","sagt: ");

  AddInfo("muaddib",
    "Ohne ihn waer ich schon pleite. Er liebt mein Gemuesebier.","sagt: ");

  AddInfo(({"kuscheldecke", "decke"}),
    "Ein paar Diebe haben Gerio seine Kuscheldecke geklaut. Das " 
    "fand ich nicht so witzig. Vielleicht kannst Du die ja zurueckklauen.",
    "meint: ");

  AddInfo("gerio",
    "Der alte Mann hat viele Geheimnisse in der Steppe gelueftet.","sagt: ");

  AddInfo(({"taetowierung", "taetowierungen"}),
    "Tut mir leid. Das ist geheim.","sagt: ");

  SUID;
  clone_object( WEAPON "flasche")->move(this_object());
  command_me("zuecke flasche");
}
