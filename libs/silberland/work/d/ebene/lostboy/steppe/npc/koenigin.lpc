
//losti
//mod by arth
//     
//     Wurmkoenigin
//

inherit "std/npc";

#include <new_skills.h>
#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(24);
  AddId(({"wurmkoenigin","koenigin","wurm"}));
  SetProp(P_SHORT,"Die Wurmkoenigin");
  SetProp(P_LONG, 
    "Ein riesengrosser, schleimiger Wurm von gewaltigem Ausmass. "
    "Sie wuerde Dich gerne als Mittagessen vernaschen. Jeden Moment "
    "wird sie wieder einen neuen Wurm auf die Welt bringen. Sie "
    "hat, wie alle anderen Wuermer auch, Silber und sogar Gold ueberall "
    "an sich kleben.");  
  AddDetail( ({ "gold", "silber" }), 
          "Das Gold und das Silber legt sich auf den Wuermern ab, "
          "waehrend sie sich durchs Erdreich graben.\n"
            );
  SetProp(P_ALIGN, 150);
  SetProp(P_NAME, "Wurmkoenigin");
  SetProp(P_RACE, "Wurm");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_HANDS, ({" mit ihrem aetzendem Schleim", 220, ({ DT_ACID }) }));
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_DEFAULT_INFO,"sagt: Schlllppppppp.\n");
  SetProp (P_SIZE, 60+random(5));  

  SUID;
  clone_object( OBJ "gold")->move(this_object());
  clone_object( OBJ "silber")->move(this_object());

  SetProp(P_SPELLRATE,20);

  AddSpell(2,350, 
    "Die Koenigin sabbert Dich mit ihrem Schleim voll.\n",
    "Die Koenigin schleimt @WEN voll.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]) );
}

void die(int poisondeath) {
  write_file( LOG "koenigin.kills" ,
    ctime()+": "+CAP(getuid(PL))+" killt die Wurmkoenigin.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer==ME) {
    write_file( LOG "koenigin.deads" ,
      ctime()+": Die Koenigin hat "+CAP(getuid(PL))+" umgebracht.\n");
  }
}
