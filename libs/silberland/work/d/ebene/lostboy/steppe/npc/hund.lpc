
//losti
//mod by arth

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(13);
  AddId( ({ "hund", "steppenhund" }) );
  SetProp(P_SHORT, "Steppenhund");
  SetProp(P_LONG, 
    "Der Hund scheint nich ganz wohlauf zu sein. Er hechelt und liegt im "
    "Schatten eines Busches. Der Steppenhund ist nicht sehr gross. Sein "
    "Fell ist nachtschwarz.");
  SetProp(P_NAME, "Steppenhund");
  SetProp(P_GENDER, MALE);
  SetProp(P_SIZE, 40+random(10));      // groesse
  SetProp(P_ALIGN, 100);       // gut-boese
  SetProp(P_RACE, "tier");
  SetProp (P_HANDS, ({" mit seinem Gebiss", 130}));
  SetProp( P_REJECT, ({ REJECT_DROP, "Der Hund knurrt Dich an.\n" }) );
  SetProp(P_DEFAULT_INFO, 
    "schaut Dich fragend an.\n");
  SetProp (P_MNPC_AREA, "/d/ebene/lostboy/steppe/room/steppe" );
  SetProp (P_MNPC_WAIT, ({ 120+random(10), 110, 40 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/ebene/lostboy/steppe/room/steppe8" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
}
