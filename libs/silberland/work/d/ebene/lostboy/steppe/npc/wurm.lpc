
//losti
//mod by arth
//
//     Riesenwurm
//

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include "../def.h"

init()
{
  ::init();
  if (TP && TP->id("wurm")) TP->AddDefender(ME);        // (by woody)
}

void InformDefend(object enemy)         // (by woody)
{
  // random: sie sind etwas traege, greifen nicht unbedingt gleich ein :)
  if (!random(3) && !IsEnemy(enemy))
  {
    tell_object(enemy, ME->Name()+" stuerzt sich auf Dich.\n");
    say(ME->Name()+" stuerzt sich auf "+enemy->name(WEN)+".\n", enemy);
    Kill(enemy);
  }
}

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(15);
  AddId(({"wurm","riesenwurm",}));
  SetProp(P_SHORT,"Ein Riesenwurm");
  SetProp(P_LONG, 
    "Der grosse schleimige Wurm schleimt sich hier durch die "
    "schleimigen Tunnel. ");  
  AddDetail( ({ "silber" }), 
          "Das Silber legt sich auf den Wuermern ab, "
          "waehrend sie sich durchs Erdreich graben.");
  SetProp(P_ALIGN, 150);
  SetProp(P_NAME, "Riesenwurm");
  SetProp(P_RACE, "Wurm");
  SetProp(P_GENDER, MALE);
  SetProp(P_DEFAULT_INFO,"sagt: Schlllppppppp.\n");
  SetProp (P_SIZE, 50+random(20));
  SetProp(P_HANDS, ({" mit seinem aetzendem Schleim", 150,
        ({DT_BLUDGEON, DT_ACID}) }) );
  SetProp(P_MAX_HANDS, 0);

  SUID;
  clone_object( OBJ "silber")->move(this_object());
}
