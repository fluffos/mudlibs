
// Lostboy`s Untoter
//mod by arth
//

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"
#include <class.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc( 12 );
  AddId("untoter");
  SetProp(P_SHORT, "Ein Untoter");
  SetProp(P_LONG,BS(
    "Ein nicht mehr lebender Untoter, der Dich auch schon angreift."));
  SetProp(P_NAME, ({"Untoter", ADJECTIVE}));
  SetProp(P_GENDER, MALE);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_RACE, "Untoter");
  SetProp(P_REJECT, REJECT_DROP);
  SetProp (P_HANDS, ({" mit seinen starken Haenden", 80, DT_BLUDGEON}) );
  SetProp (P_SIZE, 150+random(20));
  SetProp(P_ALIGN, -150);
  AddClass(CL_UNDEAD);
}

