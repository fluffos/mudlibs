
//losti
//mod by arth

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc( 8 );
  AddId("maulwurf");
  SetProp(P_SHORT, "Ein Maulwurf");
  SetProp(P_LONG, "Das ist ein besonders grosses Exemplar eines "
      "Maulwurfs mit bedrohlich aussehenden Krallen.");
  SetProp(P_NAME, "Maulwurf");
  SetProp(P_GENDER, MALE);
  SetProp(P_SIZE, 20+random(5));      // groesse
  SetProp(P_ALIGN, -150);       // gut-boese
  SetProp(P_RACE, "Maulwurf");
  SetProp(P_AGGRESSIVE,1);
  SetProp( P_REJECT, 
    ({ REJECT_DESTRUCT, "Der Maulwurf nimmt es und frisst es auf.\n" }) );
  SetProp (P_HANDS, ({" mit seinen scharfen Krallen", 80, DT_BLUDGEON}) );
  SetProp(P_DEFAULT_INFO, "schaut Dich fragend an.\n");
  
  AddDetail("krallen",
  	"Mit ihnen bahnt er sich normalerweise seinen Weg durch das Erdreich, "+
  	"aber sei gewarnt, er kann sie auch als gefaehrliche Waffe einsetzen. ");
  	
  AddDetail( ({"weg", "erdreich", "territorium", "tunnelsystem", "tunnel", "system"}),
  	"Maulwuerfe bauen haeufigst ein regelrechtes Tunnelsystem unter der "+
  	"Erde, das sie dann als ihr Territorium beanspruchen. ");
}

