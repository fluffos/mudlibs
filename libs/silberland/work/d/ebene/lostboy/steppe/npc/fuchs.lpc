
//losti
//mod by arth

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"


void check_happa();

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(11);
  AddId( ({ "fuchs", "steppenfuchs" }) );
  SetProp(P_SHORT, "Ein Steppenfuchs");
  SetProp(P_LONG, 
    "Der Fuchs ist auf der Jagd nach Kleintieren. " 
    "Sein gelbgraues Fell gilt als struppig und wertlos.");
  SetProp(P_NAME, "Steppenfuchs");
  SetProp(P_GENDER, MALE);
  SetProp(P_SIZE, 60+random(10));      // groesse
  SetProp(P_ALIGN, -30);       // gut-boese
  SetProp(P_RACE, "Fuchs");
  SetProp( P_REJECT, 
    ({ REJECT_DESTRUCT, "Der Fuchs nimmt @WEN und frisst es auf.\n" }) );
  SetProp(P_HANDS, ({" mit seinen Krallen", 110, DT_BLUDGEON}) );
  SetProp(P_DEFAULT_INFO, 
    "schaut Dich fragend an.\n");
  SetProp(P_MNPC_AREA, "/d/ebene/lostboy/steppe/room/steppe" );
  SetProp(P_MNPC_WAIT, ({ 10+random(10), 12, 1 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/ebene/lostboy/steppe/room/steppe2" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MSGIN, "sucht hier nach neuer Beute");
  SetProp(P_MSGOUT, "schleicht");

  CLONEME(ARMOUR "fuchsfell");
  command_me("trage fell");
}

//hab den fuchs mal beschleunigt =:>
//weil: er hirscht durch die steppe auf der suche nach was freszbaren
//findet er ne ratte -> so friszt er sie...hoffentlich +:>

init() {
  ::init();
  if(find_call_out("check_happa")==-1){
    call_out("check_happa",0);
  }
}

check_happa()
{
  object ob;
  object room;
  
  if (ob = present("\n_ratte", environment(this_object()))) {
    if (room = environment(this_object())) {
      tell_room(room, break_string("Der Fuchs verharrt regungslos. "
            "Scheinbar hat er gerade potentielle Beute gewittert.\n"
            "Mit einem gewaltigen Satz springt der Fuchs die Ratte an. "
            "Es entbrennt ein erbitterter Kampf um Leben und Tod.", 78) );
      switch (random(3))
      {
        case 0:
        case 1:
          tell_room(room,
              "\nPloetzlich!\n\n"
              "                               -=< KNACK >=- \n\n");
          ob->remove();
          tell_room(room, break_string("Und Du hoerst nur "
                  "noch das Knacken der Knochen einer einst lebensfrohen "
                  "Ratte, die der Fuchs nun genuesslich verspeist.", 78) );
          break;
        case 2:
          tell_room(room,
              "\nPloetzlich!\n\n"
              "                              -=< SCHNAPP >=- \n\n");
          tell_room(room, break_string("Schade fuer den Fuchs, sein Opfer "
                "konnte im letzten Moment seinem toedlichen Biss "
                "ausweichen.", 78 ) );
          break;
      }
    }
  }
}
