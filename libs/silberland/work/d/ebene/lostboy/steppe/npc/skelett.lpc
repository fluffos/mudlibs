
/*** Lostboy`s Skelett*/
//mod by arth

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../std.h"
#include <class.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc( 12 );
  AddId("skelett");
  SetProp(P_SHORT, "Ein Skelett");  
  SetProp(P_LONG,
     "Ein bitterboeses Skelett, mit vielen Knochen an sich, "
    +"das Dich auch schon angreift.");
  SetProp(P_NAME, "Skelett");
  SetProp(P_NAME_ADJ, "bitterboes");
  SetProp(P_RACE, "Untoter");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_REJECT, ({REJECT_DROP,
        "Das Skelett weiss ja gar nicht wo es @WEN "
        "aufbewahren soll, und laesst @WEN daher einfach wieder fallen.\n"}) );
  SetProp (P_HANDS, ({" mit seinen harten Knochen", 80, DT_BLUDGEON}) );
  AddClass(CL_UNDEAD);
  SetProp(P_ALIGN, -150);
  SetProp (P_SIZE, 175+random(10)); 
}
