
//losti
//mod by arth

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc( 15 );
  AddId( ({ "rind", "steppenrind" }) );
  SetProp(P_SHORT, "Ein Steppenrind");
  SetProp(P_LONG,
    "Steppenrinder sind die angriffslustigsten und auch "
    "gefaehrlichsten wilden Rinder. Dieses hier hat ein "
    "hellbraunes, etwa fingerlanges Haarkleid. Steppenrinder "
    "kaempfen sehr geschickt und klug." );
  SetProp(P_NAME, "Steppenrind");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SIZE, 200+random(30));      // groesse
  SetProp(P_ALIGN, -100);       // gut-boese
  SetProp(P_RACE, "Rind");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT, "Das Vieh nimmt, kaut und schluckt "
        "es. Kurz darauf wuergt es das zerkaute wieder "
        "herauf, kaut es abermals sorgfaeltig durch, und "
        "schluckt es schliesslich endgueltig runter.\n" }) );
  SetProp (P_HANDS, ({" mit seinem gesamten Gewicht", 80, DT_BLUDGEON}) );
  SetProp(P_DEFAULT_INFO, "missbilligt Deine Gegenwart.\n");
  SetProp (P_MNPC_AREA, "/d/ebene/lostboy/steppe/room/steppe" );
  SetProp (P_MNPC_WAIT, ({ 25+random(10), 20, 20 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/ebene/lostboy/steppe/room/steppe6" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_SPELLRATE,20);

  AddSpell(4,300,
    "Das Rind rammt seinen Kopf in Deinen Koerper.\n",
    "Das Rind rammt seinen Kopf in @WESSEN Koerper.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddCmd( ({"melk","melke"})      , "cmd_melken");
}

int cmd_melken(string str)
{
  notify_fail("\n");

  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  if(!present("milchkanne",TP))
  {
    tell_object(TP,"Du hast doch gar keine Milchkanne dabei.\n");
    return 1;
  }

  if(!present("melkschemel",TP))
  {
    tell_object(TP,"Du hast doch gar keinen Melkschemel dabei.\n");
    return 1;
  }

  tell_object(TP,"Das Steppenrind traut Dir nicht und laeuft davon.\n");
  tell_room(ENV(TO),"Das Steppenrind weicht vor "+TP->Name(WEM)+" zurueck.\n");
  wandern();

  return 1;
}


