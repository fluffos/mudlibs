
//losti
//mod by arth

inherit "std/mnpc";


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc( 2 );
  AddId( ({ "ratte","\n_ratte" }) );
  SetProp(P_SHORT, "Eine Ratte");
  SetProp(P_LONG, 
    "Zwischen dem hohen Gras siehst Du die Ratte, die gerade nach Nahrung "
    "sucht. Sie hat einen langen spitzen Schwanz und scharfe Zaehne. Sie "
    "traegt ein schwarzbraunes Fell.");
  SetProp(P_NAME, "Ratte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 10+random(5));      // groesse
  SetProp(P_ALIGN, -50);       // gut-boese
  SetProp(P_RACE, "Ratte");
  SetProp( P_REJECT, 
    ({ REJECT_DROP, "Die Ratte kann das doch nicht tragen!\n" }) );
  SetProp(P_HANDS, ({" mit ihren scharfen Zaehnen", 20, DT_BLUDGEON}) );
  SetProp(P_DEFAULT_INFO, "piepst Dich fragend an.\n");
  SetProp(P_MNPC_AREA, "/d/ebene/lostboy/steppe/room/steppe" );
  SetProp(P_MNPC_WAIT, ({ 18+random(4), 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/ebene/lostboy/steppe/room/steppe1" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
}
