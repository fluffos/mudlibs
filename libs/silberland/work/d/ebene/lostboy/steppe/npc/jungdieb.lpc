
//
//     Der Jungdieb
//losti
//mod by arth
//


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(10);
  AddId( ({"jungdieb", "\njdieb", "\ndieb", "dieb"}) );
  SetProp(P_SHORT,"Der Jungdieb");
  SetProp(P_LONG,
    "Der Jungdieb versucht Dich grimmig anzuschauen. Aengstlich blickt er "
    "zu seinen Kumpanen. Er knuddelt eine Kuscheldecke." );
  AddDetail( ({ "kuscheldecke", }), "Die ist bestimmt geklaut.");
  SetProp(P_NAME, "Jungdieb");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  SetProp(P_DEFAULT_INFO,"sagt: Lass mich!\n");
  SetProp (P_ALIGN, -80+random(20));
  SetProp (P_SIZE, 120+random(10));
  SetProp(P_REJECT, ({REJECT_KEEP, "Der Dieb bedankt sich bei Dir dafuer, "
            "dass Du es ihm so leicht machst.\n"}) );
  SetProp (P_HANDS, ({" mit seinen Haenden", 55}));

  SUID;
  clone_object( OBJ "kdecke")->move(this_object());
}

void init() {
  ::init();
  if (this_player() && this_player()->id("\ndieb"))
    AddDefender(this_player());
}

void InformDefend(object enemy) {
  Kill(enemy);
}
