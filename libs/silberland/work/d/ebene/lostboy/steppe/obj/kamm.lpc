
// hier wird bald n besserer kamm eingefuegt, der is noch net fertig
//mod by arth

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Kamm");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Kamm");
  SetProp(P_LONG, "Ein Kamm zum sich schoener machen.\n");
  AddId( ({"kamm","testkamm","kamm zum testen"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 5);
  SetProp(P_MATERIAL, MAT_HORN);
  AddCmd( ({"kaemme","kaemm"}), "kaemme" );
}

kaemme(str)
{
  object wem;

  notify_fail("Was oder wen moechtest Du kaemmen?\n");
  if (!str) return 0;
  if( str=="haare" || str=="haar" || str=="mich" || TP->id(str) ) {
    write( "Du kaemmst Dir die Haare.\n");
    say(BS(TP->Name()+" kaemmt sich die Haare.\n"));
    return 1;
  }
  if ((wem=present(str,environment(TP))) && living(wem)) {
    write("Du kaemmst "+wem->name(WEM)+" die Haare.\n");
    tell_room(environment(TP), TP->Name()+" kaemmt "+wem->name(WEM)+
        " die Haare.\n", ({TP,wem}));
    tell_object(wem, TP->Name()+" kaemmt Dir die Haare.\n");
    return 1;
  }
  return 0;
}

