
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

int cmd_oeffne(string str);

void create()
{
   if (!is_clone(this_object())) return;

   ::create();
   AddId( ({"ei"}) );
   AddAdjective( ({ "rund","rundes" }) );
   SetProp(P_NAME, "Ei");
   SetProp(P_NAME_ADJ, "rund");
   SetProp(P_MATERIAL, MAT_LIME);
   SetProp(P_GENDER, NEUTER);
   SetProp(P_SHORT, "Ein rundes Ei");
   SetProp(P_LONG,
       "Im ersten Moment denkst Du es waer ein Vogelei. aber es sieht "
       "irgendwie so kuenstlich aus. Ausserdem ist es ungewoehnlich schwer.");
   SetProp(P_WEIGHT, 90);
   SetProp(P_VALUE, 10);
   // AddCmd( ({"oeffne","breche", "brich" }), "oeffne" );
   AddCmd("oeffne&ei",
      #'cmd_oeffne,
      "Was willst Du oeffnen?");
   AddCmd("brich|breche&ei&auf",
      #'cmd_oeffne,
      "Was willst Du (auf)brechen?|Willst Du das Ei AUFbrechen?");

   seteuid(getuid(this_object()));
}


int cmd_oeffne(string str)
{
  clone_object( ARMOUR "holzring")->move(TP, M_NOCHECK);            
  write( break_string("Das Ei ist sofort kaputt. Im Inneren war ein "
                      "Holzring verborgen, den Du gleich an Dich nimmst. "
                      "Das kaputte Ei hast Du weggeschmissen.", 78));
  WLOG( LOG "ring", "findet den Holzring");  
  say(BS(CAP_TPN+" bricht ein Ei auf.\n"));
  RemoveCmd();
  RemoveId();
  SetProp(P_SHORT, 0);
  call_out( "remove", 0 );
  return 1;
}


