
// Kraut heilt 50 LE. Da ich moechte das das Kraut soviele LE
// heilt, darf es dafuer nur 3 mal im Besitz eines Spielers sein.

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

#define WIRKDAUER (60*60*24)    // 1 Tag
#define MAXHEAL 50              // 50 LP maximal
#define MINHEAL 5               // 5 LP minimal

private nosave int got;

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Steppenkraut");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  SetProp(P_SHORT, "Ein Bueschel Steppenkraut");
  SetProp(P_LONG, "Eine seltene Pflanzenart, die bei richtiger Anwendung "
                  "Deine Wunden heilen kann. Sie ist grasgruen und wirkt "
                  "total unscheinbar.");
  SetProp(P_INFO, "Das Steppenkraut hat nur eine begrenzte Wirkdauer.\n");
  AddId( ({"kraut", "steppenkraut"}) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:100]));   
  SetProp(P_VALUE, 500);
  AddCmd( ({"leg","lege"}), "leg" );
  got=time();
}

int QueryHeal()
{
  int h;
  if ((h=MAXHEAL-((time()-got)*MAXHEAL)/WIRKDAUER)<MINHEAL) return MINHEAL;
  else if (h>=MAXHEAL) return MAXHEAL;
  else return h;
}

string _query_info()
{
  return sprintf("%sEs kann Dich noch um %d Punkte heilen.\n",
      Query(P_INFO), QueryHeal());
}

leg(str)
{
  string was, worauf;
  int h;

  notify_fail("Was moechtest Du wohin legen?\n");
  if (!str) return 0;
  if (sscanf(str,"%s auf %s",was,worauf)!=2) return 0;
  if (!id(was)) return 0;
  if (!member((["wunde","wunden","verletzung"]),worauf)) return 0;

  h=QueryHeal();
  write(BS("Du legst das Kraut auf eine Wunde und fuehlt sofort, wie "
    "Deine Schmerzen durch die sanften Kraefte der Natur gelindert werden."));
  TP->heal_self(h);
  if (h<=MINHEAL)
    write("Leider ist die Wirkung des Krauts nur noch minimal.\n");
  else if (h>=MAXHEAL)
    write("Du spuerst, wie das Steppenkraut seine volle Wirkung entfaltet.\n");
  WLOG( LOG "krautheilt", "wendet das Kraut richtig an.");
  say(TP->Name()+" heilt "+TP->QueryPossPronoun(FEMALE, WEN, SINGULAR)+
      " Wunden mit einem Kraut.\n");
  remove();
  return 1;
}

