//mod by arth

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Kuscheldecke");
  SetProp (P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine Kuscheldecke");
  SetProp(P_LONG, "Eine bunte weiche Kuscheldecke, die Du ins Herz "
                  "geschlossen hast. Die bunten Farben und die tollen "
                  "Muster auf der Decke machen sie einfach total kuschelig.");
  AddId( ({"decke","kuscheldecke"}) );
  SetProp(P_WEIGHT, 75);
  SetProp(P_VALUE, 10);
  AddCmd( ({"kuschel","kuschle"}), "kuschel" );

  AddDetail( ({"muster"}),
      "Die Muster der Decke sind toll.");
  AddDetail( ({"farben"}),
      "Die Farben der Decke sind bunt.");
}

int kuschel(string str) {
  notify_fail("In was moechtest Du kuscheln?\n");
  if( str == "decke" || str == "kuscheldecke" || 
      str == "in decke" || str == "in kuscheldecke" ) {
    write(BS("Du kuschelst Dich in die weiche Kuscheldecke. "
             "Dir wird ganz warm ums Herz."));
    say(BS(CAP_TPN+" kuschelt sich in eine weiche Kuscheldecke und fuehlt sich "
                   "gleich wohler."));
    return 1;
  }
  return 0;
}
