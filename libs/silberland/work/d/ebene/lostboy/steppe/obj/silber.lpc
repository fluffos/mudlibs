inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Silberklumpen");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Silberklumpen");
  SetProp(P_LONG, "Pures Silber. Schwer aber sicher sehr wertvoll.\n");
  AddId( ({"silber","klumpen", "silberklumpen"}) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1000);
  SetProp (P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_SILVER);
}
