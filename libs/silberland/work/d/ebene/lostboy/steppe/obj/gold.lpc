
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Goldbarren");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Goldbarren");
  SetProp(P_LONG, "Wow, ein Goldbarren. Der laesst sich sicher gut verkaufen.");
  AddId( ({"gold","barren","goldbarren"}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 2000);
  SetProp(P_MATERIAL, MAT_GOLD);   // Material=Gold	 
  SetProp(P_NOBUY, 1);
}
