inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Balancierstange");
  SetProp(P_LONG,
        "Eine lange, aus Holz gefertigte Stange. Man kann sie bestimmt zum "
        "gut zum Balancieren benutzen. Zum Kaempfen taugt sie nicht viel.\n");
  SetProp(P_NAME, "Balancierstange");
  AddId( ({"stange","balancierstange","\nbalancierstange" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WC, 10);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 50); 
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_FIR);
  SetProp(P_QUALITY_DECAY, 10);
}
