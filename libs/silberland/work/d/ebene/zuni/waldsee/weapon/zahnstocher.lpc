
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"zahnstocher", "stocher"}));
  SetProp (P_SHORT, "Ein hoelzerner Zahnstocher");
  SetProp (P_LONG,
    "Der Zahnstocher ist ein kleines geschnitztes Hoelzchen.");
  SetProp (P_NAME, "Zahnstocher");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 1);
  SetProp (P_WEIGHT, 1);
  SetProp (P_WEAPON_TYPE, WT_SPEAR);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 5);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_MISC_WOOD);
  SetProp (P_NOSELL, "Du behaeltst den Zahnstocher lieber. Wer weiss, wozu man ihn noch gebrauchen kann.\n");
  SetProp(P_INFO, break_string("Der Zahnstocher ist eine der schlechtesten Waffen im "
                     "Silberland. Das mag daran liegen, dass er eigentlich "
                     "dafuer gedacht ist, sich Nahrungsreste aus den Zaehnen "
                     "zu prokeln."),78);
  
  AddCmd(({"stocher","stochere","prokel","prokele"}), "cmd_prokeln");
  AddCmd(({"pieks","piekse"}), "cmd_pieks");
}

cmd_prokeln ()
{
	
  if(present("zahnstocher",TP)!=TP->QueryProp(P_WEAPON) &&
     present("zahnstocher",TP) )
       {
         write (BS("Zuecken waer ne Massnahme.\n"));
         
         return 1;
       }
       
  write (BS("Du prokelst Dir wie ein Wilder in den Zaehnen herum und foerderst eklige Reste Deines letzten Mahles zutage. Angewidert schnickst Du die Brocken davon.\n"));
                      
  say (BS(CAP(TPN)+" prokelt sich zwischen den Zaehnen und schnickt die ekligen zutagegebrachten Brocken in der Gegend herum. Du wuergst.\n"));
  
  return 1;
}

cmd_pieks ()
{
   if(present("zahnstocher",TP)!=TP->QueryProp(P_WEAPON) &&
     present("zahnstocher",TP) )
       {
         write (BS("Zuecken waer ne Massnahme.\n"));
         
         return 1;
       }
  write (BS("Du huepfst wie von der wilden Wuz gebissen durch den Raum und piekst alle Anwesenden mit Deinem grindigen Zahnstocher.\n"));
                      
  say (BS(CAP(TPN)+" huepft durch den Raum und piekst Dich mit einem grindigen Zahnstocher.\n"));
 
  return 1;
}
   