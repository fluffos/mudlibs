#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald

  string *geholt;
  string *gestopft;
  
  create()
  {
  ::create();

         
  SetProp( P_INT_SHORT, "Weg durch den Wald" );
  SetProp( P_INT_LONG, 
    "Du befindest Dich auf einem Weg durch den Wald. "
    "Grosse Eichen stehen hier, ihr Blaetterdach verdunkelt "
    "die Umgebung. Du strengst Dich an, um im Daemmerlicht Einzelheiten "
    "erkennen zu koennen. Selbst das Getier des Waldes scheint von "
    "der etwas duesteren Stimmung erfasst zu sein, nur ab und zu raschelt "
    "es im Gebuesch. Im Nordosten plaetschert ein kleines Baechlein.");
     
  grundzustand(); //erstma resetten 
         
//Details beschreiben:        
  // DETAILS START
  
  AddDetail( ({"baechlein"}),
     "Nordoestlich von Dir plaetschert ein Baechlein. Du koenntest Du "
     "hinueberspringen, wenn Du diesen Bereich des Waldes "
     "verlassen moechtest.");
     
  AddDetail( ({"wasser"}),
     "Es scheint sehr klar zu sein und plaetschert munter das Baechlein entlang.");
        
  AddDetail( ({"weg", "boden", "schotterweg", "Waldboden", "nach unten",
     "wegrand", "rand des weges", "schotter"}),
     "Du schaust versonnen auf den Boden. Der Schotterweg ist mit "
     "verrotteten Blaettern bedeckt. Daher stammt wahrscheinlich auch der "
     "komische Geruch. Ein paar vereinzelte Sonnenstrahlen malen ein "
     "Muster auf den Boden.");
	
  AddDetail( ({"blaetterdach", "himmel", "nach oben"}),
     "Du schaust nach oben und entdeckst ein paar Loecher im "
     "Blaetterdach, durch den der blaue Himmel zu sehen ist. Die truebe "
     "Stimmung hier scheint die Welt ausserhalb des Waldes nicht zu "
     "stoeren.");
		
  AddDetail( ({"eiche", "eichen", "baeume", "baum", "wald"}),
     "Die Baeume um Dich herum sehen sehr alt aus. Irgendwie gefaellt "
     "Dir nicht, wie sie die Aeste nach Dir auszustrecken scheinen.");

  AddDetail( ({"ast", "aeste"}),
     "Dir kommt es fast so vor, als ob Dich die Aeste umklammern und "
     "festhalten wollen. Ein Ast beruehrt Dich an der Schulter und "
     "erschreckt springst Du einen Schritt zurueck. Du ueberlegst, welcher "
     "Teufel Dich geritten hat, Dich hier in den Wald hineinzutrauen.");

  AddDetail( ({"schulter"}),
     "Davon hast Du zwei - hoffentlich zumindest.");
       
  AddDetail( ({"schritt"}),
     "Ein Schritt vor und zwei zurueck.");
     
  AddDetail( ({"irgendwas", "irgendjemand"}),
     "*RASCHEL* *RASCHEL*");
       
  AddDetail( ({"teufel"}),
     "Den siehst Du hier gottseidank nicht. Aber wundern wuerde es Dich "
     "nicht, hier ein erzboeses Wesen zu treffen. Du zitterst bei dem "
     "Gedanken.");

  AddDetail( ({"wesen"}),
     "Du reimst munter vor Dich hin:\n"
     "Wesen, Wesen, auf dem Besen,\n"
     "ohne Spesen nix gewesen!");

  AddDetail( ({"spesen"}),
     "Die gibts nicht fuers Rumlungern.");

  AddDetail( ({"rumlungern"}),
     "Das machst Du doch gerade, oder?");
       
  AddDetail( ({"gedanken"}),
     "Na streng mal Dein Gehirn an.");

  AddDetail( ({"gehirn"}),
     "Hast Du keins?");
       
   AddDetail( ({"geruch"}),
     "Versuchs mal mit riechen.");
   
   AddDetail( ({"eichenblaetter", "blaetter"}),
     "Die abgefallenen Blaetter verrotten auf dem Boden. Diejenigen "
     "Blaetter, die noch an den Baeumen haengen, versperren Dir fast "
     "voellig die Sicht auf den Himmel.");
        
   AddDetail( ({"licht", "daemmerlicht", "sonnenstrahlen", "sonnenstrahl",
     "strahl","strahlen", "sonne", "lichtverhaeltnisse", "sicht"}),
     "Viel Licht gibt es hier im dichten Wald nicht. Nur ab und zu "
     "schafft es ein Sonnenstrahl durch das dichte Blaetterdach und malt "
     "Muster auf den Waldboden.");
   
   AddDetail( ({"muster"}),
     "Seltsame Muster malen die Sonnenstrahlen auf den Waldboden. Einen "
     "Sinn kannst Du zwar nicht darin entdecken, aber Du freust Dich ueber "
     "dieses kleine Zeichen von Sonne und Waerme in diesem duesteren "
     "Wald.");

  AddDetail( ({"waerme"}),
     "Wenn es zu warm ist, ist es auch nicht gut. Aber so ist es gerade "
     "recht.");
       
   AddDetail( ({"umgebung", "einzelheiten"}),
     "Viel kannst Du im Daemmerlicht nicht ausmachen.");
   
   AddDetail( ({"getier", "bewohner", "waldbewohner", 
     "bewohner des waldes", "tier", "tiere"}),
     "Du kannst sie nur hoeren, kein Tier laesst sich blicken. Es werden "
     "wohl Eichhoernchen sein, die hier herumhuschen. Du hoffst jedenfalls, "
     "dass es Eichhoernchen sind, und nicht unangenehmere Zeitgenossen.");
   
  AddDetail( ({"zeitgenossen"}),
     "Auf unangenehme Zeitgenossen kannst Du jetzt auch gut und gerne "
     "verzichten, aber das kann man sich nicht immer aussuchen.");
          
   AddDetail( ({"gebuesch", "buschwerk", "gestraeuch", "straeucher"}),
     "Am Wegrand steht nur wenig Gebuesch, tiefer im Wald glaubst Du, mehr "
     "davon erkennen zu koennen. Sicher bist Du Dir bei diesen "
     "Lichtverhaeltnissen aber nicht. Ab und zu raschelt es, als ob "
     "irgendwelche Tiere hindurchschluepfen.");
   
   AddDetail( ({"eichhoernchen"}),
     "Du siehst keine. Aber die Geraeusche werden wohl von ihnen "
     "stammen.");
        
  AddSpecialDetail( ({"loch", "loecher", "socke", "socken"}),      
     "detail_loch");
   
  AddDetail( ({"waffe", "panzer"}),
     "Immer schoen drauf acht geben.");
       
   AddDetail( ({"fuss", "fuesse"}),
     "Es riecht ein bisschen muffig hier. Vielleicht solltest Du ab "
     "und zu mal Deine Fuesse waschen!");
 
  AddDetail( ({"faden"}),
     "Mit Nadel und Faden kann man zum Beispiel Loecher in Socken "
     "stopfen.");

  AddDetail( ({"beispiel"}),
     "Ein Beispiel fuer uebertriebene Detailsuche ist zum Beispiel "
     "'Beispiel' zu untersuchen!");

  AddDetail( ({"detailsuche"}),
     "Immer schoen weitersuchen :-)");
       
  AddDetail( ({"nadel"}),
     "Klein, spitz und meistens aus Metall.");
                 
  AddDetail( ({"metall", "metalle"}),
     "Zwerge sind spezialisiert auf Metalle und kennen sich auf diesem "
     "Gebiet perfekt aus.");

  AddDetail( ({"gebiet"}),
     "Du befindest Dich hier im Alten Wald.");
       
  AddDetail( ({"zwerge", "zwerg"}),
     "Die tummeln sich meist unter der Erde.");

  AddDetail( ({"erde"}),
     "Auf dem Boden kannst Du vielleicht welche finden.");
       
  AddDetail( ({"fischerdorf"}),
     "Das Fischerdorf ist ganz woanders, bestimmt nicht hier.");
                 
   AddDetail( ({"sinn"}),
     "Was ergibt schon Sinn? Du gruebelst ueber Dein Leben nach und bist "
     "ein bisschen deprimiert. Mach doch mal einem Deiner Freunde eine "
     "Freude, das macht Sinn.");

  AddDetail( ({"freunde"}),
     "Hoffentlich hast Du welche. Ohne Freunde ist es fad auf der Welt.");
       
  AddDetail( ({"freude"}),
     "Du freust Dich wie ein Schneekoenig.");

  AddDetail( ({"schneekoenig", "schneekoenige"}),
     "Such so einen lieber da wo Schnee liegt.");

  AddDetail( ({"schnee"}),
     "Da wo es Schnee gibt, gibt es vielleicht auch Schneekoenige.");
       
   AddDetail( ({"zeichen"}),
     "Dies ist ein Zeichen! Untersuche brav alle Details :-) ");
   
   AddDetail( ({"detail", "details", "forscher", "forschen"}),
     "Brav forschen - vielleicht ist hier ja ein Forscherpunkt "
     "versteckt?");
     
   AddSpecialDetail( ({"forscherpunkt"}),      
     "detail_fp");
   
   AddDetail( ({"stimmung"}),
     "Die Stimmung hier ist recht duester hier, anders als "
     "im Silberwald nebenan. Der Wald "
     "scheint keinen guten Einfluss auf Deine Laune zu haben, Du wirst "
     "unruhig und ueberlegst, den Wald nicht doch besser wieder zu "
     "verlassen.");

  AddDetail( ({"laune"}),
     "Nicht so praechtig im Moment.");

  AddDetail( ({"moment"}),
     "Schon vorbei :-)");
       
   AddDetail( ({"welt"}),
     "Du pfeifst ein kleines Lied: 'Money makes the world go around'");
  
  AddDetail( ({"lied"}),
     "Da gibt es ganz viele davon. In Elessar gibt es sogar eine "
     "Musikschule!");
         
  AddDetail( ({"elessar"}),
     "Da wohnen die Elfen.");

  AddDetail( ({"elfen"}),
     "Die wohnen in Elessar. Zumindest einige.");

  AddDetail( ({"musikschule"}),
     "Angeblich gibt es in Elessar so eine.");
       
  AddDetail( ({"alten", "blaettern", "ja", "o", "besen", "raschel",
     "lichtverhaeltnissen", "einfluss"}),
     "Konzentriere Dich doch auf die wichtigen Dinge im Leben.");

  AddDetail( ({"leben"}),
     "Wenn Du das noch erleben koenntest...");

  AddDetail( ({"nase"}),
     "Du schielst und betrachtest Deine Nase.");

  AddDetail( ({"dinge", "ding"}),
     "Du denkst: . o O (Ja, das ist ein Ding!)");
       
  // DETAILS END   
// Sounds beschreiben:   
   
  AddRoomMessage ( ({
     "Irgendetwas oder Irgendjemand raschelt im Gebuesch.\n" }), 240 );
   
  AddSound(DEFAULT_SOUND, 
     "Du hoerst nur ein paar Bewohner des Waldes durch das Gebuesch "
     "huschen.\n");
        
  AddSound( ({"geraeusche", "geraeusch"}),
     "Du hoerst nur die Geraeusche des Waldes.\n");
     
  AddSound( ({"plaetschern"}),
     "Nordoestlich von Dir plaetschert das Baechlein.\n");
     
  AddSound( ({"rascheln", "bewohner"}),
     "Ab und zu raschelt es seltsam im Gebuesch.\n");
   
               
// Gerueche beschreiben:        
        
  AddSmell(DEFAULT_SMELL,
     "Du riechst die verrotteten Eichenblaetter, die den Boden "
     "bedecken.\n");
  
  AddSmell( ({"blaetter", "eichenblaetter"}),
     "Die Blaetter riechen ziemlich vermodert. Nicht sehr angenehm, Du ruempfst die "
     "Nase.");
	
// Commands beschreiben:

  AddCmd( ({ "husche", "husch"}), "cmd_huschen");
  AddCmd( ({ "stopfe", "stopf"}), "cmd_stopfen");
  AddCmd( ({ "trink", "trinke"}), "cmd_trinken");
  AddCmd( ({"spring", "springe"}) ,  "cmd_ueberquere");
// Ausgaenge beschreiben:
	
  AddExit( "westen", "./room_d2" );

}

reset()
{
 
  ::reset();
  grundzustand();
    
  }
  

int grundzustand()
{
 geholt=({});
 gestopft=({});
}




int cmd_huschen(string str)       //Spieler huscht durchs Gehoelz
{
  write(BS("Du huschst durchs Gebuesch. Bist Du etwa ein Eichhoernchen?"));
  
  say(BS(CAP_TPN +" huscht wie von der wilden Wutz gebissen durchs "
     "Gebuesch."));
  
  return 1;
}


int cmd_trinken(string str)
{
  notify_fail("Was moechtest Du trinken?\n");
  if(!str || str == "") return 0;
  if(!(str == "wasser" || str == "wasser aus bach" || str == "aus bach")) return 0;
        
  write(BS("Du beugst Dich hinunter, schoepfst etwas Wasser aus dem Bach und "
           "trinkst es. Du fuehlst Dich erfrischt, aber sonst passiert nichts."));
  
  say(BS(CAP_TPN +" schoepft etwas Wasser aus dem Bach und trinkt es."));
  
  return 1;
}



string detail_loch(string str)
{
  string s;
  object ob;

  if(member(gestopft, TP->name()) == -1)
  {
     
     write(BS("Durch ein Loch im Blaetterdach scheint ein Sonnenstrahl auf "
     "Deinen Fuss. Apropos Loch: Du bewegst Deinen linken Fuss und spuerst "
     "ein Loch in der Socke. Vielleicht solltest Du nicht nur Deinen "
     "Panzer und Deine Waffe regelmaessig reparieren!"));
     
     say(BS(CAP_TPN +" bewegt nachdenklich die Zehen."));
     gestopft += ({TP->name()});
  }
  else
  {
     write(BS("Durch ein Loch im Blaetterdach scheint ein Sonnenstrahl auf "
              "Deinen Fuss. Du bewegst munter die Zehen in Deinen Socken."));
  }     
  return "";
}


int cmd_stopfen(string str)
{
	
  notify_fail("Was moechtest Du stopfen?\n");
  if(!str || str == "") return 0;
  
  if(!(str == "socken" || str == "socke" || str == "einen socken" ||
        str == "eine socke")) return 0;
	
  if(member(gestopft, TP->name()) == -1)
  { 
    if(present("nadel und faden",TP))
    {
      write(BS("Du setzt Dich auf den Boden und stopfst froehlich Deinen Socken. "
               "So ohne Loch im Socken ist es doch viel angenehmer."));
      say(BS(CAP_TPN +" setzt sich auf den Boden und stopft einen Socken."));
      gestopft += ({TP->name()});
      return 1;
    }
  	
  if(deep_present("nadel und faden",TP))
    {
      write(BS("Dafuer musst Du Nadel und Fader erstmal herausholen."));
      return 1;
    }
    write(BS("Dazu brauchst Nadel und Faden. Vielleicht kann Dir jemand "
             "im Fischerdorf weiterhelfen?"));
    return 1;
  }
  

  if(deep_present("nadel und faden",TP))
  {
  	write(BS("Die Socken sind doch heile, Du musst sie nicht stopfen."));	
  	return 1;
  }
  
  write(BS("Dazu braeuchtest Du Nadel und Faden, ausserdem muss dein Socken "
  	"doch gar nicht gestopft werden."));
  return 1;
}



string detail_fp(string str)
{
  string s;
  object ob;

  

  if(member(geholt, TP->name()) == -1)
  {
     ob=clone_object(WEAPON "balancestange.lpc");   //Clone die Stange!  
     ob->move(this_player());
     
     write(BS("Du findest zwar keinen Forscherpunkt, aber dafuer eine "
         "Balancierstange - "
         "wozu die wohl gut ist? Du steckst sie "
         "auf jeden Fall mal ein."));
     say(BS(CAP_TPN +" findet etwas und steckt es ein."));
     geholt += ({TP->name()});
  }
  else
  {
     write(BS("Du findest nichts. Nicht mal einen Forscherpunkt."));
     say(BS(CAP_TPN +" sucht vergeblich herum."));
  }     
  return "";
}


int cmd_ueberquere (string str)

{
  int i;

  notify_fail("Ueber wen oder was moechtest Du springen?\n");

  if(member(({"ueber bach",
              "ueber den bach",
              "ueber baechlein",
              "ueber das baechlein"}),str) > -1)
       
       //noch irgendeine Einschraenkung einbauen zum Ueberqueren?       
       
       {
       	write (BS("Mit einem mutigen Sprung ueberquerst Du das Baechlein. "
       	"Nur gut, dass es nicht so breit ist, sonst haettest Du wohl nasse "
       	"Fuesse bekommen."));
       	
       	this_player()->move("/d/ebene/Silberwald/room/room_e08", M_TPORT, 
        "ueber den Bach im Nordosten", "hopst", "hopst herein");
       	
       	return 1;
       }
}

