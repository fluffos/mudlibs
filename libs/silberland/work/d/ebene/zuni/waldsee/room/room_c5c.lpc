#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald

  int funktion_fallen();
  
  create()
  {
  ::create();

      
  SetProp( P_INT_SHORT, "Auf einem Baum" );
  SetProp( P_INT_LONG, 
     "Du befindest Dich auf einem Ast einer Fichte. Unter Dir siehst Du den "
     "Waldboden, ueber Dir siehst Du einen hellbraunen und einen dunkelbraunen "
     "Ast." );
        
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_HIDE_EXITS, 1);

//Details 
  // DETAILS START
  
  AddDetail( ({"himmel", "nach oben", "oben"}),
     "Ab und zu kannst Du ein groesseres Stueck blauen Himmels durch die "
     "Aeste erkennen.");
     
  AddDetail( ({"stueck"}),
     "Du kannst hier etwas mehr vom Himmel erkennen.");
 
  AddDetail( ({"aeste"}),
     "An diesem Baum, auf dem Du sitzt, wachsen so einige Aeste. Auf einem "
     "davon sitzt Du zum Beispiel gerade. Aber auch ueber Dir wachsen "
     "welche, so kannst Du ueber Dir einen hellbraunen und einen "
     "dunkelbraunen Ast erkennen.");
 
  AddDetail( ({"baum", "fichte"}),
     "Du schaust Dir den Baum genauer an, auf dem Du sitzt. "
     "Eine grossgewachsene Fichte, mit allem was dazugehoert.");
 
  AddDetail( ({"ast"}),
     "Welchen meinst Du? Den dunkelbraunen, oder den hellbraunen?");
 
  AddDetail( ({"dunkelbrauner ast", "dunkelbraunen ast", 
               "dunkelbraunen ast an"}),
     "Der dunkelbraune Ast sieht recht stabil aus. Eigentlich. Zumindest "
     "ein bisschen stabil. Aber wenn man sich das recht ueberlegt...");
 
  AddDetail( ({"hellbrauner ast", "hellbraunen ast",
               "hellbraunen ast an"}),
     "Ob der Dich tragen kann? Naja, kann man ja mal versuchen.");
  
  AddDetail( ({"boden", "nach unten", "unten", "waldboden"}),
     "Der Boden liegt zu tief unter Dir, als dass Du etwas erkennen "
     "koenntest. Ausserdem blockieren einige Aeste Deine Sicht.");
 
  AddDetail( ({"sicht", "aussicht"}),
     "Naja, die Aussicht ist nicht umwerfend von hier. Zuviele Aeste im "
     "Weg.");
 
  AddDetail( ({"weg"}),
     "Der Weg liegt zu tief unter Dir, als dass Du mehr erkennen "
     "koenntest.");
 
  AddDetail( ({"beispiel"}),
     "Schlechtes Beispiel.");
 
  AddDetail( ({"baeume", "nadelbaeume", "nadelwald", "wald", "alter wald"}),
     "Die Baeume rings um Dich herum sind recht hohe Fichten. ");
     
  AddDetail( ({"fichten"}),
     "Nur Fichten zu sehen, keine anderen Baumarten.");
 
  AddDetail( ({"baumarten"}),
     "In diesem Teil des Alten Waldes stehen fast ausschliesslich Fichten. "
     "Andere Baumarten findest Du woanders.");
 
  AddDetail( ({"himmels"}),
     "Frag mich nicht, ich weiss es nicht.");

  // DETAILS END
  
//Sounds:
  AddSound( DEFAULT_SOUND,
     "Du kannst ganz leise den Wind hoeren, wie er seicht durch die Aeste "
     "streicht.\n");
  AddSound( ({"wind", "streichen"}),
     "Es ist ein sehr leises Geraeusch, fast nicht wahrzunehmen.\n");
 
  AddSound( ({"geraeusch"}),
     "Kaum auszumachen.\n");
 

//Smells:

  AddSmell( DEFAULT_SMELL,
     "Du riechst Waldduft.\n");
 
  AddSmell( ({"waldduft"}),
     "Es riecht nach hauptsaechlich nach Harz. Ziemlich typisch fuer einen "
     "Nadelwald.\n");
 
  AddSmell( ({"harz"}),
     "Schwierig zu beschreiben. Irgendwie harzig.\n");

//Commands:
  AddCmd( ({"kletter","klettere"}) ,  "cmd_klettern");


  }

// Funktion klettern:

int cmd_klettern (string str)
{
  int i;
  object room;

  notify_fail("Du siehst einen hellbraunen und einen dunkelbraunen Ast ueber "
       "Dir. Auf welchen willst Du klettern? Oder willst Du lieber wieder "
       "runter klettern?\n");
       
     if(member(({"auf dunkelbraunen ast",    //das ist der richtige Ast
                 "dunkelbrauner ast",
                 "zum dunkelbraunen ast"}),str) > -1)
       {
       	write (BS("Du kletterst auf den dunkelbraunen Ast. Ueber Dir siehst "
       	"Du eine breite Astgabel.\n"));
       	
       	this_player()->move(ROOM "room_c5d", M_TPORT|M_NO_SHOW, 
        "nach oben", "klettert", "klettert zu Dir auf den Ast");
       	
       	return 1;
       }
     if(member(({"auf hellbraunen ast",    //das ist der falsche Ast, absturz
                 "hellbrauner ast",
                 "zum hellbraunen ast"}),str) > -1)
       {
        funktion_fallen();
       	return 1;
       }  
       
     if(member(({"runter",    //wieder runterklettern
                 "herunter",
                 "hinunter",
                 "nach unten"}),str) > -1)
       {
        write (BS("Du kletterst wieder zurueck auf den Boden.\n"));
        
        if(room = find_object(ROOM "room_c5a"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
           
        if(room = find_object(ROOM "room_c5b"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
        
        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "klettert", "klettert zu Dir auf den Boden");
             
        return 1;
       }  
}

  //Funktion fallen, Spieler faellt vom Ast:

  int funktion_fallen ()     
  {
      int i;
      object room;
  
        write (BS("Du kletterst auf den hellbraunen Ast. Doch ploetzlich "
        "biegt sich der Ast, als ob er einen eigenen Willen hat, und "
        "wirft Dich auf den Boden zurueck. Dein Genick knackst ungesund.\n"));
        
        say ( TP->name() +" klettert auf einen Ast. Der Ast scheint jedoch "
        "nicht sonderlich stabil zu sein.\n");
        
        if(room = find_object(ROOM "room_4b"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
        
        if(room = find_object(ROOM "room_c5a"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
       
        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "faellt", "faellt neben Dir auf den Boden "
        "und verzieht das Gesicht vor Schmerzen");
        
        environment(TP)->AddDetail( ({"genick"}),
            "Du bewegst vorsichtig Deinen Hals. Glueck gehabt, scheint noch "
            "alles in Ordnung zu sein.\n");
 
        
        
        //HP's runter, zwischen 15-20
        i=15 + random(6);
        
        SetProp(P_KILL_NAME,"Ein ziemlich tiefer Sturz");
        
        TP->do_damage(i);
        
        return 1;         

  }