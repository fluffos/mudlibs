#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald



  create()
  {
  ::create();

     
  SetProp( P_INT_SHORT, "Weg durch den Wald" );
  SetProp( P_INT_LONG, 
     "Ein Pfad fuehrt hier nach Westen. "
     "Es ist hier sehr unheimlich. Die Aeste der Baeume scheinen fast nach "
     "Dir zu greifen, als ob sie Dich daran hindern wollen, weiter in ihre "
     "Domaene vorzudringen. Oder als ob sie Dich hier nie wieder "
     "hinauslassen wollen. Im Suedosten fliesst ein Bach." );
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

     
//Details beschreiben:
  // DETAILS START
  
  AddDetail( ({"bach"}),
     "Im Suedosten fliesst ein Bach. Er scheint recht seicht zu sein, "
     "sicher kannst Du hier hindurchwaten.");
  
  AddDetail( ({"wasser"}),
     "Das Wasser im Bach ist sehr klar und rein. Du bekommst Lust auf ein "
     "Mineralwasser bei Max.");
  
  AddDetail( ({"max"}),
     "Max ist der Wirt der Kneipe in Midas.");
     
  AddDetail( ({"mineralwasser"}),
     "Ein Mineralwasser bekommst Du zum Beispiel bei Max in Midas.");
     
  AddDetail( ({"midas", "stadt"}),
     "Midas ist die Stadt im Nordwesten.");
     
  AddDetail( ({"kneipe"}),
     "Die Kneipe in Midas wird von Max bewirtschaftet.");
  
  AddDetail( ({"boden"}),
     "Du betrachtest den Boden. Viel kannst Du nicht erkennen: Du stehst "
     "auf einem Pfad, aussenrum viele abgefallene Nadeln der Baeume.");

  AddDetail( ({"fuss", "fuesse"}),
     "Irgendwie bekommst Du so langsam kalte Fuesse.");

  AddDetail( ({"angst"}),
     "Die Angst kriecht Dir langsam in die Knochen. Kommt Dein Zittern von "
     "der Kaelte oder bist Du so aengstlich?");

  AddDetail( ({"kaelte"}),
     "Eigentlich ist es gar nicht so sehr kalt hier.");

  AddDetail( ({"knochen"}),
     "Pass auf, sonst koennten Deine Knochen hier bald liegen.");

  AddDetail( ({"zittern"}),
     "Du zitterst wie Espenlaub.");

  AddDetail( ({"espenlaub"}),
     "*zitter*");

  AddDetail( ({"aeste"}),
     "Die Aeste breiten sich weit aus und ueberspannen den kompletten Pfad.");

  AddDetail( ({"umgebung"}),
  "Hier fuehrt der Pfad nach Suedosten und Westen. "
     "Es ist hier sehr unheimlich. Die Aeste der Baeume scheinen fast nach "
     "Dir zu greifen, als ob sie Dich daran hindern wollen, weiter in ihre "
     "Domaene vorzudringen. Oder als ob sie Dich hier nie wieder "
     "hinauslassen wollen. Du bekommst Angst." );
     
  AddDetail( ({"domaene"}),
     "Diese Domaene ist bestimmt nicht Deine.");

  AddDetail( ({"pfad"}),
     "Der Pfad ist hier sehr schmal geworden. Er ist zwar noch gut zu "
     "begehen. Ab und zu wachsen Baumwurzeln kreuz und quer ueber den Pfad "
     "und zwingen Dich, die Fuesse etwas hoeher zu heben. Die Aeste wachsen "
     "ueber Dir fast zusammen, so dass ein dichtes Nadeldach entsteht.");

  AddDetail( ({"himmel"}),
     "Du schaust nach oben, kannst aber kein einziges Stueck Himmel erkennen. "
     "Die Baeume stehen einfach zu dicht. Nur etwas schummriges Licht macht "
     "es Dir moeglich, ueberhaupt etwas zu erkennen.");

  AddDetail( ({"baumwurzeln", "wurzeln"}),
     "Knorrige Wurzeln wachsen kreuz und quer ueber den Pfad. Ab und zu "
     "scheint eine nach Deinen Fuessen zu angeln, um Dich festzuhalten.");

  AddDetail( ({"baeume", "baum"}),
     "Hier stehen hochgewachsene Nadelhoelzer, hauptsaechlich Fichten. "
     "Kein Sonnenstrahl dringt durch das dichte Nadeldach.");

  AddDetail( ({"sonnenstrahl", "sonne", "strahl"}),
     "Kein einziger Strahl der Sonne schafft es durch das dichte "
     "Nadeldach.");

  AddDetail( ({"nadeldach"}),
     "Es is so dicht, dass Du vom Himmel und der Sonne nichts erkennen "
     "kannst. Du kannst Deine Umgebung in diesem schummrigen Licht "
     "gerade noch erkennen.");

  AddDetail( ({"licht"}),
     "Ziemlich daemmerig. Weder so richtig hell noch richtig dunkel.");

  AddDetail( ({"fichten", "fichte", "nadelhoelzer"}),
     "Genauer gesagt Rotfichten.");

  AddDetail( ({"rotfichte", "rotfichten"}),
     "Stattliche Rotfichten stehen um Dich herum. Brauner Stamm, gruene "
     "Nadeln, alles was dazugehoert. Wenn sie etwas kleiner waeren, "
     "koenntest Du hier bestimmt einen schoenen Weihnachtsbaum schlagen.");

  AddDetail( ({"stamm", "staemme"}),
     "Die Staemme sind von grauen Flechten bedeckt. Sehr gesund sieht das "
     "nicht aus.");

  AddDetail( ({"flechten", "flechte"}),
     "Sie bedeckt grosse Teile der Staemme. Fast sieht es so aus, als ob "
     "die Flechten die Baeume erdruecken wollen.");

  AddDetail( ({"teile"}),
     "Was fuer Teile moechtest Du untersuchen?");

  AddDetail( ({"nadeln"}),
     "Lange gruene Nadeln haengen an den Aesten der Fichten. Sie sind so "
     "dicht, dass Du kein Stueck Himmel erkennen kannst. Unheimlich.\n"
     "Auf dem Boden rings um Dich herum liegen viele abgestorbene Nadeln der "
     "Baeume.");

  AddDetail( ({"stueck"}),
     "Was fuer ein Stueck meinst Du? Ein Stueck Kuchen?");

  AddDetail( ({"kuchen"}),
     "Kuchen hast Du leider keinen. Vielleicht gibt es bei einem Baecker "
     "Kuchen zu kaufen?");

  AddDetail( ({"baecker"}),
     "Hier im Wald wirst Du bestimmt keinen Baecker finden. Vielleicht gibt "
     "es ja woanders einen.");

  AddDetail( ({"wald"}),
     "Du befindest Dich in einem Wald. Gut erkannt!");

  AddDetail( ({"alt"}),
     "Du fuehlst Dich alt.");

  AddDetail( ({"weihnachten", "weihnachtsbaum"}),
     "Dazu haben wir die falsche Jahreszeit.");

  AddDetail( ({"jahreszeit"}),
     "Es ist Sommer. Bis Weihnachten ist es noch ein bisschen hin.");

  AddDetail( ({"sommer"}),
     "Der Sommer ist eigentlich die schoenste Jahreszeit.");

  AddDetail( ({"gegenteil"}),
     "Etwas Entgegengesetztes.");

  AddDetail( ({"windhauch", "wind"}),
     "Du steckst einen Zeigefinger in den Mund und haeltst ihn dann hoch. "
     "Hmm, kein Wind zu spueren.");

  AddDetail( ({"mund"}),
     "Mund zu, es zieht!");

  AddDetail( ({"zeigefinger", "finger"}),
     "Du zaehlst die Finger Deiner Hand. Nach dem dritten Versuch kommst Du "
     "zu einem vorlaeufigen Endergebnis.");

  AddDetail( ({"hand"}),
     "Noch alle Finger dran?");

  AddDetail( ({"wesen", "lebewesen"}),
     "Sei froh, dass keins hier ist. Das koennte sonst schlecht fuer "
     "Dich ausgehen.");

  AddDetail( ({"versuch"}),
     "Versuch mal was anderes.");

  AddDetail( ({"endergebnis", "ergebnis"}),
     "Zehn.");

  AddDetail( ({"winter", "fruehjahr", "herbst"}),
     "Die anderen Jahreszeiten sind auch nicht so uebel.");

  AddDetail( ({"jahren", "jahr", "alten", "waldes", "aesten", "fuessen"}),
     "Nicht interessant.");

  // DETAILS END
  AddItem ( ({ "/d/ebene/Silberwald/npc/biber" }), REFRESH_DESTRUCT);
  
//Sounds beschreiben:

  AddSound(DEFAULT_SOUND, 
     "Es ist sehr still. Kein Lebewesen traut sich wohl hierher. "
     "Ausser Dir natuerlich.\n");

//Smells beschreiben:

  AddSmell(DEFAULT_SMELL,
     "Du schnupperst. Die Luft ist sehr stickig. Es ist nicht sehr warm hier, "
     "im Gegenteil, Du froestelst sogar etwas. Kein Windhauch regt sich, der "
     "die Luft verbessern koennte.\n");

  AddSmell( ({"luft"}),
     "Die Luft riecht sehr stickig. Als ob hier seit Jahren nicht mehr "
     "gelueftet wurde.\n");
     
//Commands:

 AddCmd( ({"wate"}) ,  "cmd_wate");
 AddCmd( ({ "trink", "trinke"}), "cmd_trinken");
      
//Ausgaenge beschreiben:	

    AddExit( "westen", "./room_d6" );
    

  }


int cmd_wate (string str)

{
  int i;

  notify_fail("Durch wen oder was moechtest Du waten?\n");

  if(member(({"durch den bach",
              "durch bach",
              "durch den bach hindurch"}),str) > -1)
       
       //noch irgendeine Einschraenkung einbauen zum Ueberqueren?       
       
       {
       	write (BS("Frohen Mutes watest Du durch den Bach. Das Wasser "
       	"ist so seicht, dass Du Dir kaum die Fuesse benaesst."));
       	
       	this_player()->move("/d/ebene/Silberwald/room/room_e14", M_TPORT, 
        "durch den Bach", "watet", "watet durch den Bach herein");
       	
       	return 1;
       }
}


int cmd_trinken(string str)
{
  int i;

  notify_fail("Was moechtest Du trinken?\n");
  if(!str || str == "") return 0;
  if(!(str == "wasser" || str == "wasser aus bach" || str == "aus bach")) return 0;
        
  write(BS("Du beugst Dich hinunter, schoepfst etwas Wasser aus dem Bach und "
           "trinkst es. Aua! Du hast doch glatt beim Schlucken auf ein kleines "
           "Steinchen gebissen! Dein Zahn schmerzt etwas."));
  
    i=i + random(5);
        
        SetProp(P_KILL_NAME,"Zahnschmerz");
        
        TP->do_damage(i);
  
  say(BS(CAP_TPN +" trinkt etwas Wasser aus dem Bach und verzieht das Gesicht."));
  
  return 1;
}