#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald


      create()
      {
        ::create();

     
     SetProp( P_INT_SHORT, "Weg durch den Wald" );
     SetProp( P_INT_LONG, 
        "Du bist jetzt tief im Wald. Um Dich herum stehen die Eichen "
        "immer noch recht dicht zusammen, obwohl der Wald langsam lichter zu "
        "werden scheint. Die Baeume sehen hier auch etwas gesuender aus. "
        "Abgesehen von den Geraeuschen des Waldes ist es immernoch sehr "
        "ruhig, aber irgendwie kommt es Dir hier nicht so vor, als ob "
        "jeder und alles nach Deinem Leben trachtet.");
        

// Details beschreiben:             
  // DETAILS START
              
   AddDetail( ({"boden", "nach unten", "weg", "waldweg"}),
        "Du befindest Dich immernoch auf dem Weg durch den Alten Wald. "
        "Festgetretene Erde und Schotter bilden einen recht bequemen "
        "Untergrund zum Wandern. Am Wegesrand wachsen ein paar Graeser "
        "und Kraeuter.");

  AddDetail( ({"leben"}),
       "Du lebst - zumindest noch.");
       
   AddDetail( "schotter",
        "Der Schotter ist zusammen mit Erde festgetrampelt, und bildet "
        "einen ungefaehr einen Meter breiten Weg durch den Wald.");

  AddDetail( ({"meter"}),
       "Wenn Du Deine Arme nach beiden Seiten ausstreckst misst Du "
       "ungefaehr einen Meter ab.");

  AddDetail( ({"arme"}),
       "Deine beiden Arme sind noch fest am Koerper verankert. So wie es "
       "sein soll.");

  AddDetail( ({"koerper"}),
       "Alles da und unversehrt.");

  AddDetail( ({"seiten"}),
       "Du schaust Dich nach allen Seiten um, kannst aber nichts "
       "Ungewoehnliches erkennen.");
       
   AddDetail( ({"himmel", "nach oben"}),
        "Du schaust nach oben und entdeckst wirklich einen herrlichen "
        "blauen Himmel. Die Sonne steht recht hoch, und ihre Strahlen "
        "waermen Dich. Du fuehlst Dich gleich viel besser.");
   
   AddDetail( ({"sonne", "sonnenstrahlen", "strahlen"}),
        "Du schliesst die Augen und laesst Dich von der Sonne waermen. "
        "Deine Lebensgeister kehren zurueck, und Du bekommst so langsam "
        "eine gute Laune.");

  AddDetail( ({"augen"}),
       "Du rollst mit Deinen Augen.");
       
  AddDetail( ({"laune", "gute laune"}),
       "Du pfeifst vergnuegt ein Liedchen, einfach weil Du gute Laune "
       "hast.");

  AddDetail( ({"lied", "liedchen"}),
       "Keine Ahnung, woher es stammt, Du wirst es irgendwo aufgeschnappt "
       "haben.");

  AddDetail( ({"ahnung", "vorahnung"}),
       "Eine leise Vorahnung beschleicht Dich, dass Dir noch grosse Gefahren "
       "bevorstehen.");

  AddDetail( ({"gefahr", "gefahren"}),
       "Welche Gefahren Dir noch bevorstehen kannst Du jetzt natuerlich "
       "noch nicht wissen.");
       
   AddDetail( ({"erde", "erdboden", "untergrund"}),
        "Die Erde auf dem Weg ist festgetreten. Wer auch immer diesen "
        "Waldweg angelegt hat, hat gute Arbeit geleistet. Am Wegrand ist "
        "die Erde recht locker, was wohl auch der Grund dafuer ist, dass hier "
        "viele Kraeuter wachsen.");

  AddDetail( ({"grund", "grunde"}),
       "Das ist Dir im Grunde ziemlich egal.");
       
  AddDetail( ({"kraut", "kraeuter"}),
       "Du bist leider kein Experte auf dem Gebiet der Kraeuterkunde, aber "
       "Du erkennst aber Blutwurz, Ehrenpreis, Erdrauch und Schoellkraut. "
       "Mit diesen Kraeutern kann man bestimmt so manche Leiden kurieren.");

  AddDetail( ({"kraeuterkunde"}),
       "Du koenntest Elsurion fragen.");

  AddDetail( ({"elsurion"}),
       "Der lebt in Tijara.");

  AddDetail( ({"tijara"}),
       "Tijara ist eine Stadt im Dschungel.");
       
  AddDetail( ({"dschungel"}),
       "Der Dschungel ist weit suedlich von hier.");
       
  AddDetail( ({"experte"}),
       "So einer bist Du bestimmt nicht. Zumindest nicht, was Kraeuter "
       "angeht.");
       
  AddDetail( ({"leiden"}),
       "So etwas wie eine Krankheit.");

  AddDetail( ({"krankheit", "krankheiten"}),
       "Meist unangenehm. Sei froh, dass Du gesund bist.");

  AddDetail( ({"gesundheit"}),
       "Die ist sehr kostbar.");

  AddDetail( ({"wurzel"}),
       "Eine Wurzel findet man meistens am unteren Ende einer Pflanze.");

  AddDetail( ({"ende"}),
       "Bist Du mit Deiner Weisheit schon am Ende?");

  AddDetail( ({"weisheit"}),
       "Sicher, dass Du welche besitzt?");
       
  AddDetail("blutwurz",
       "Blutwurz ist seit Jahrhunderten das Mittel der Wahl bei "
       "Sommerdurchfall, Dickdarmentzuendungen und Darmkatarrh. "
       "Man setzt 1 Teil feingeschnittene Wurzel mit 10 Teilen "
       "Weingeist an und bewahrt dieses fuer 4 bis 6 Wochen an einem "
       "warmen Ort auf. Taeglich schuettelt man die Mischung, sie faerbt "
       "sich dann "
       "blutrot. Dann filtert man ab. Bei Bedarf trinkt man 2 bis 3 mal "
       "taeglich 10 bis 20 Tropfen davon in Wasser.");

  AddDetail( ({"mittel", "mittelweg"}),
       "Der Mittelweg ist nicht immer der beste.");
       
  AddDetail( ({"weingeist"}),
       "Lecker! *hicks*");
       
  AddDetail( ({"mischung"}),
       "Unterschiedliche Sachen zusammengefuegt ergeben eine Mischung.");

  AddDetail( ({"sachen"}),
       "Muss ich Dir denn wirklich alles erklaeren?");
       
  AddDetail( ({"wahl"}),
       "Eine Wahl ist... ach geh doch nach Derlim, da kannst Du bestimmt "
       "mehr darueber erfahren.");

  AddDetail( ({"derlim"}),
       "Derlim ist eine Stadt im Silberland. Die Hobbits wohnen dort.");

  AddDetail( ({"hobbits"}),
       "Eine Rasse.");

  AddDetail( ({"rasse"}),
       "Frage doch die Goetter danach.");

  AddDetail( ({"goetter"}),
       "Ob die sich mit Dir unterhalten wollen? Wohl kaum :-)");
       
  AddDetail( ({"stadt"}),
       "Du bist hier im Wald, nicht in einer Stadt!");

  AddDetail( ({"silberland", "land"}),
       "Silberland ist der Name des Landes, in dem Du Dich befindest.");

  AddDetail( ({"name"}),
       "Hast Du etwa Deinen Namen vergessen?");
       
  AddDetail( ({"teil", "ganzes", "untermenge"}),
       "Ein Teil ist die Untermenge eines Ganzen.");
       
  AddDetail( ({"ort"}),
       "Du befindest Dich an einem Ort, gut erkannt!");
       
  AddDetail( ({"bedarf"}),
       "Du haettest jetzt lieber ein leckeres Bier.");

  AddDetail( ({"bier"}),
       "Hmm... ein Bier bekommst Du in der Kneipe.");

  AddDetail( ({"kneipe"}),
       "Hier ist leider keine.");
       
  AddDetail( ({"wasser"}),
       "Ist meist fluessig.");

  AddDetail( ({"tropfen", "tropfenform"}),
       "Fluessigkeiten haben manchmal Tropfenform.");

  AddDetail( ({"fluessigkeit", "fluessigkeiten"}),
       "Wasser ist eine Fluessigkeit.");
       
  AddDetail( ({"pflanze", "pflanzen"}),
       "Du weisst schon: diese gruenen Dinger.");

  AddDetail( ({"dinger", "ding", "dingelingeling"}),
       "Du singst: 'So ein Ding, so ein Ding, so ein Dingelingeling...'");
       
  AddDetail( ({"monat", "monate", "jahr", "jahre"}),
       "Zwoelf Monate sind ein Jahr.");
       
  AddDetail( ({"woche", "wochen"}),
       "Sieben Tage sind eine Woche. Ungefaehr 4 Wochen sind ein Monat.");

  AddDetail( ({"tag", "tage"}),
       "Vierundzwanzig Stunden sind ein Tag. Sieben Tage sind eine Woche.");

  AddDetail( ({"stunde", "stunden"}),
       "Sechzig Minuten sind eine Stunde. Vierundzwanzig Stunden sind ein "
       "Tag.");

  AddDetail( ({"minute", "minuten"}),
       "Sechzig Sekunden sind eine Minute. Sechzig Minuten eine Stunde.");

  AddDetail( ({"sekunde", "sekunden"}),
       "Sechzig Sekunden sind eine Minute.");
       
  AddDetail( ({"sommerdurchfall", "dickdarmentzuendung", 
       "dickdarmentzuendungen", "darmkatarrh"}),
       "Sommerdurchfall, Dickdarmentzuendung und Darmkatarrh sind "
       "unangenehme Krankheiten, die mit der Verdauung zu tun haben. "
       "Richtige Ernaehrung hilft da aber auch schon viel.");

  AddDetail( ({"ernaehrung"}),
       "Das was man zu sich nimmt nennt man generell auch "
       "'Ernaehrung'.");

  AddDetail( ({"verdauung"}),
       "Naeher moechtest Du Dich mit diesem Thema nicht beschaeftigen.");

  AddDetail( ({"Thema"}),
       "Welches Thema?");
       
  AddDetail("ehrenpreis",
        "Ehrenpreis waechst bevorzugt auf trockenen, lichten Standorten, auf "
        "Heiden und Waldraendern. Der rauhhaarige Stengel traegt aufrechte "
        "Aeste "
        "und Bluetentrauben. Die Blueten sind weiss bis hellila. "
        "Gesammelt wird das bluehende Kraut. Es enthaelt Gerbstoff, "
        "Bitterstoffe und Saponine. Man verwendet Ehrenpreis aeusserlich als "
        "Wundkraut und innerlich als Magenmittel, Blutreinigungsmittel und "
        "Anregungsmittel fuer den Stoffwechsel. Auch bei Bronchialkatarrh, "
        "Gicht und Rheuma, sowie bei hohem Blutdruck hat es sich bewaehrt. "
        "Die frische Pflanze kann bei chronischen Hautleiden, Ekzemen und "
        "Abszessen Linderung verschaffen.");

  AddDetail( ({"aeste"}),
       "Aeste haengen meist an irgendwelchen Pflanzen. Einer faellt Dir besonders auf.");
       
  AddDetail( ({"ast"}),
        "Du kannst von hier nichts genaues erkennen, Du solltest hochklettern, dann "
        "siehst Du sicher mehr.");
       
  AddDetail( ({"hautleiden", "ekzeme", "abszess", "abszesse"}),
       "Unangenehm.");
       
  AddDetail( ({"blutdruck"}),
       "Ohne ihn haettest Du wirklich Probleme.");

  AddDetail( ({"probleme"}),
       "Die willst Du bestimmt nicht.");
       
  AddDetail( ({"bronchialkatarrh", "husten"}),
       "Du faengst an zu husten. ");

  AddDetail( ({"stoffwechsel"}),
       "Du besitzt sowas. Auch wenn Du davon nichts verstehst.");
       
  AddDetail( ({"anregungsmittel"}),
       "Nimm lieber keins, Du bist schon hibbelig genug.");
       
  AddDetail( ({"blutreinigungsmittel"}),
       "Hilft das Blut zu reinigen.");

  AddDetail( ({"blut"}),
       "Es stroemt durch Deine Adern. Hoffentlich.");
       
  AddDetail( ({"magenmittel", "magen"}),
       "Dein Magen knurrt.");
       
  AddDetail( ({"wundkraut"}),
       "Auf eine Wunde gelegt unterstuetzt Wundkraut die Heilung.");

  AddDetail( ({"wunde"}),
       "Pass lieber auf, dass Du keine bekommst.");
       
  AddDetail( ({"gerbstoff", "gerbstoffe", "bitterstoffe", "bitterstoff",
       "saponin", "saponine"}),
       "Wirksamer Bestandteil einer Arznei.");

  AddDetail( ({"arznei", "wirkstoffe", "wirkstoff"}),
       "Hilft hoffentlich gegen Krankheiten.");
       
  AddDetail( ({"bluetentraube", "bluetentrauben", "blueten"}),
       "Viele Blueten zusammen sind eine Bluetentraube.");
       
  AddDetail( ({"rheuma", "gicht"}),
       "Du kannst Dich noch prima bewegen, anscheinend hast Du weder "
       "Gicht noch Rheuma. Aber was nicht ist, kann noch kommen.");
       
  AddDetail("erdrauch",
       "Gesammelt wird die ganze Pflanze. Sie enthaelt Alkaloide, vor allem "
       "das Fumarin. Erdrauch ist ein beliebtes Mittel gegen Flechte und "
       "andere Hautleiden und ist in vielen Teemischungen zur Blutreinigung, "
       "als Magen-, Gallen- und Lebertonikum enthalten. Auch bei "
       "Appetitlosigkeit und Darmtraegheit kann der Erdrauch hilfreich "
       "sein.");

  AddDetail( ({"darmtraegheit"}),
       "Es rumort in Deinem Magen.");
       
  AddDetail( ({"appetitlosigkeit"}),
       "Du hast ploetzlich keinen Hunger mehr.");

  AddDetail( ({"hunger"}),
       "Keiner mehr da.");
       
  AddDetail( ({"magentonikum", "gallentonikum", "lebertonikum"}),
       "Sollte was helfen.");
       
  AddDetail( ({"blutreinigung"}),
       "Die Blutreinigung uebernimmt die Leber.");

  AddDetail( ({"leber"}),
       "Trink nicht so viel, dann bleibt sie Dir lang erhalten.");
       
  AddDetail( ({"teemischung", "tee", "teemischungen"}),
       "Tee kann ganz lecker sein.");
       
  AddDetail( ({"flechte", "flechten"}),
       "Allein beim Gedanken daran faengt es an zu jucken.");

  AddDetail( ({"gedanken"}),
       "Denkst Du beim Forschen ueberhaupt noch nach?");
       
  AddDetail( ({"alkaloide", "fumarin"}),
       "Alkaloide, wie das Fumarin, koennen Wirkstoffe in einer Arznei "
       "sein.");
       
   AddDetail("schoellkraut",
        "Der Milchsaft des Schoellkrautes enthaelt 10 Alkaloide, die u.a. "
        "leicht narkotisch wirken. Verwendet wird er aeusserlich bei Flechten, "
        "Grind und Warzen (Achtung nicht in die Augen bringen !). Der Tee "
        "wird in der Volksmedizin bei Gelbsucht, Gallen- und Leberleiden, "
        "sowie bei Magengeschwueren und -kraempfen verwendet.");

  AddDetail( ({"achtung"}),
       "Aufpassen!");
       
  AddDetail( ({"gelbsucht", "gallenleiden", "leberleiden", "magengeschwuere",
       "magengeschwuer", "magenkraempfe"}),
       "So langsam wirst Du noch zum Hypochonder.");

  AddDetail( ({"hypochonder"}),
       "Einer, der sich einbildet, jede Krankheit zu haben.");
       
  AddDetail( ({"medizin", "volksmedizin"}),
       "Hilft hoffentlich bei Krankheiten.");
       
  AddDetail( ({"warzen"}),
       "Nein, die willst Du nich. Die verschandeln Dich nur noch mehr :->");
       
  AddDetail( ({"milchsaft"}),
       "Der Saft des Schoellkrautes ist leicht milchig. Deswegen heisst "
       "er auch 'Milchsaft'.");

  AddDetail( ({"saft"}),
       "Jetzt koenntest Du ein auch einen leckeren Saft trinken...");

  AddDetail( ({"milch"}),
       "Gibt es meistens von Kuehen. ");

  AddDetail( ({"kuehe"}),
       "Gibt es meistens auf einem Bauernhof.");

  AddDetail( ({"bauernhof"}),
       "Einen gibt es in der Naehe von Midas.");

  AddDetail( ({"midas"}),
       "Eine Stadt im Silberland.");
       
  AddDetail( ({"grind"}),
       "Wasch Dir mal Deine grindigen Griffel!");

  AddDetail( ({"griffel"}),
       "Damit meine ich Deine Finger!");

  AddDetail( ({"finger"}),
       "Die sind noch alle vollzaehlig.");
       
   AddDetail( ({"wegrand", "rand des weges", "wegesrand"}),
        "Am Wegrand wachsen verschiedene Graeser und Kraeuter zwischen den Eichen.");
        
   AddDetail( ({"gras", "graeser"}),
        "Du kannst Weidelgras, Knaulgras und Wiesenlieschgras erkennen. ");
   
   AddDetail( ({"eichen", "baeume"}),
        "Rechts und links des Weges stehen die maechtigen Eichen des Alten "
        "Waldes. Es sind imposante Baeume, bestimmt schon hunderte von Jahren "
        "alt, gerade und gut gewachsen. Es scheint fast so, als ob sich "
        "jemand gut um die Baeume hier zu kuemmern scheint. Ein Baum faellt "
        "Dir besonders auf.");
        
  AddDetail( ({"geschick"}),
        "Na so geschickt bist Du sicherlich.");
        
  AddDetail( ({"eiche", "baum", "exemplar"}),
        "Ein praechtiges Exemplar einer Eiche steht hier am Wegrand. Dein Blick wandert den Stamm "
        "empor, dort oben scheint etwas zu sein, ein breiter Ast vielleicht?");
        
  AddDetail( ({"blick"}),
        "Du blickst hinauf. Dort scheint ein Ast zu sein.");
        
  AddDetail( ({"stamm", "rinde"}),
        "Der Stamm der Eiche hat eine rauhe Rinde. Sicher kann man hier mit etwas Geschick "
        "hinaufklettern.");
  
  AddDetail( ({"blaetter"}),
       "Die Blaetter, die hier herumliegen, stammen alle von den maechtigen "
       "Eichen. Es haengen natuerlich auch noch welche auf den Baeumen.");
       
   AddDetail( "wald",
        "Der Wald macht hier einen ziemlich friedlichen Eindruck auf Dich.");

  AddDetail( ({"eindruck"}),
       "Friedlich ist es hier, aber das kann taeuschen.");
       
   AddDetail( ({"weidelgras", "knaulgras", "wiesenlieschgras"}),
        "Leider kennst Du Dich mit den Graesern nicht so gut aus, um naehere "
        "Einzelheiten auszumachen.");

  AddDetail( ({"vogel", "voegel"}),
       "Du schaust Dich um, kannst aber keine finden. Sie haben sich wohl "
       "zu gut versteckt.");
       
  AddDetail( ({"alter"}),
       "Dein Alter solltest Du aber selbst wissen.");
       
  AddDetail( ({"heide", "unglaeubiger"}),
       "Ein Heide ist ein Unglaeubiger.");

  AddDetail( ({"jahren", "weges", "aus", "alten", "geraeuschen", "wandern",
       "lebensgeister", "jahrhunderten", "ganzen", "landes", "standorten",
       "heiden", "waldraendern", "stengel", "bestandteil", "heilung", "adern",
       "hoffentlich", "ekzemen", "linderung", "abszessen", "gallen", 
       "forschen", "gebiet", "elfenstadt", "magengeschwueren",
       "jahrhunderte", "standort"}),
       "Nicht alle gross geschriebenen Woerter sind es wert, untersucht zu "
       "werden.");

  AddDetail( ({"einzelheiten"}),
       "Keine zu erkennen.");
       
  AddDetail( ({"woerter"}),
       "Dieses gehoert dazu.");

  AddDetail( ({"dieses"}),
       "Langsam wirds langweilig.");

  AddDetail( ({"langeweile"}),
       "AUS!");
       
  // DETAILS END
       
// Sounds:

  AddSound(DEFAULT_SOUND, 
       "Die Blaetter rascheln leise im sachten Wind. Vereinzelt hoerst Du "
       "einen Vogel rufen.");
  
  AddSound( ({"geraeusche"}),
       "Die Blaetter rascheln leise im sachten Wind. Vereinzelt hoerst Du "
       "einen Vogel rufen.");
  
  AddSound( ({"wind", "rascheln", "blaetter"}),
       "Der Wind laesst leise die Blaetter ueber Dir rascheln.\n");
       
  AddSound( ({"vogel", "vogelstimmen", "rufen"}),
       "Ab und zu ruft ein Vogel, Du kannst aber nicht erkennen, was fuer "
       "ein Vogel das wohl ist.\n");

//smells
  AddSmell( DEFAULT_SMELL,
       "Es riecht hier sehr angenehm.\n");
              
// Kommandos:
   
      AddCmd( ({ "pfluecke", "pflueck"}), "cmd_pfluecken");
      AddCmd( ({"kletter","klettere"}) ,  "cmd_klettern");

// Ausgaenge:
   
   AddExit( "norden", "./room_c2" );
   AddExit( "sueden", "./room_c4" );

      }

cmd_pfluecken()       //Spieler versucht, etwas zu pfluecken
{
  write(BS("Bevor Du Dich nicht besser mit Pflanzenkunde auskennst, laesst "
         "Du das doch besser bleiben."));
  say (BS(CAP_TPN+" ueberlegt offensichtlich, sich ein paar der Kraeuter "
                    "zu pfluecken."));
  return 1;
}

int cmd_klettern (string str)
{

  notify_fail("Wohin moechtest Du klettern?\n");

        
       
     if(member(({"rauf", "nach oben", "auf ast", "auf baum", "hinauf"
                 "hoch"}),str)> -1)
       {
       	write(BS("Du kletterst geschickt auf den Ast."));
       	
        this_player()->move(ROOM "room_c3a", M_TPORT,
        "klettert nach oben", "klettert", "klettert zu Dir auf den Ast");
       	       	
       	return 1;
       }
       
 return 0;
}