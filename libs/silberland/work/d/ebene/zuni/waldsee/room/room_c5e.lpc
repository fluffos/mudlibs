#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald

int funktion_fallen();

  create()
{
  ::create();

     
  SetProp( P_INT_SHORT, "Auf einem Baum" );
  SetProp( P_INT_LONG, 
     "Du befindest Dich auf einer Astgabel hoch oben auf der Fichte. Von hier "
     "reicht ein Ast bis zu der benachbarten Foehre. Es ist ziemlich hoch "
     "hier, und Du ueberlegst, ob Du nicht doch besser wieder runterklettern "
     "solltest." );
        
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_HIDE_EXITS, 1);

//Details 
  // DETAILS START

  AddDetail( ({"himmel", "oben", "nach oben"}),
     "Ueber Dir kannst Du zwischen den Zweigen ein paar Fleckchen blauen "
     "Himmels erkennen. ");

  AddDetail( ({"himmels"}),
     "Da ist ein 's' zuviel!");
     
  AddDetail( ({"s"}),
     "Genau, das war zuviel.");
 
  AddDetail( ({"baum"}),
     "Du sitzt auf einem Baum.");
     
  AddDetail( ({"fleckchen"}),
     "Nicht sehr gross, aber der Himmel ist gut zu erkennen.");

  AddDetail( ({"Nadelwald", "nadelbaeume"}),
     "In diesem Teil vom Alten Wald stehen hautptsaechlich Nadelbaeume. "
     "Deswegen spricht man auch von einem Nadelwald.");

  AddDetail( ({"wald"}),
     "Der Wald ist Dir nicht ganz geheuer.");

  AddDetail( ({"teil"}),
     "Welches Teil meinst Du?");

  AddDetail( ({"astgabel"}),
     "Du sitzt auf einer recht breiten Astgabel.");

  AddDetail( ({"aeste"}),
     "Es gibt hier haufenweise Aeste. Zwei davon bilden die Astgabel, auf "
     "der Du sitzt. Ein grosser Ast reicht bis zur Foehre hinueber.");

  AddDetail( ({"ast"}),
     "Der Ast reicht bis zu der Foehre herueber. Wenn Du vorsichtig bist, "
     "kannst Du bestimmt hinueberbalancieren.");

  AddDetail( ({"foehre"}),
     "Eine grosse stattliche Foehre waechst direkt neben der Fichte, auf der "
     "Du Dich befindest. In der Baumkrone kannst Du ein Glitzern erkennen.");

  AddDetail( ({"baumkrone"}),
     "Die Foehre hat eine maechtige Baumkrone. Irgendetwas glitzert da zwischen "
     "den Zweigen.");

  AddDetail( ({"zweige"}),
     "Die Zweige sind sind sehr dicht. Genaues kannst Du leider nicht "
     "erkennen. Nur ab und zu blitzt ein bisschen Himmel blau durch.");

  AddDetail( ({"boden", "unten", "nach unten"}),
     "Du schaust nach unten, kannst aber den Boden nicht erkennen. Der ist "
     "viel zu weit unter Dir.");

  AddDetail( ({"fichte"}),
     "Du sitzt hoch in der Krone der Fichte.");

  AddDetail( ({"krone"}),
     "Die ist meistens oben dran.");

  AddDetail( ({"glitzern"}),
     "Wenn Du herausbekommen moechtest, was das ist, dann geh rueber und "
     "schau es Dir genauer an.");

  AddDetail( ({"zweigen", "alten", "alte"}),
     "Achnee, lass mal.");

  // DETAILS END
  

//Sounds:
  AddSound( DEFAULT_SOUND,
     "Du kannst ganz leise den Wind hoeren, wie er seicht durch die Aeste "
     "streicht.\n");
  AddSound( ({"wind", "streichen"}),
     "Es ist ein sehr leises Geraeusch, fast nicht wahrzunehmen.\n");
 
  AddSound( ({"geraeusch"}),
     "Kaum auszumachen.\n");
 

//Smells:

  AddSmell( DEFAULT_SMELL,
     "Du riechst Waldduft.\n");
 
  AddSmell( ({"waldduft"}),
     "Es riecht nach hauptsaechlich nach Harz. Ziemlich typisch fuer einen "
     "Nadelwald.\n");
 
  AddSmell( ({"harz"}),
     "Schwierig zu beschreiben. Irgendwie harzig.\n");
     
 
//Commands:
  AddCmd( ({"kletter","klettere"}) ,         "cmd_klettern");
  AddCmd( ({"balancier","balanciere"}) ,     "cmd_balance");
}

// Funktion klettern:

int cmd_klettern (string str)
{
  int i;
  object room;
  
  notify_fail("Du kannst von hier nicht noch hoeher klettern.\n");

       
     if(member(({"runter",    //wieder runterklettern
                 "herunter",
                 "hinunter",
                 "nach unten"}),str) > -1)
       {
        write (BS("Du kletterst wieder zurueck auf den Boden.\n"));
        
        if(room = find_object(ROOM "room_c5d"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);        
        
        if(room = find_object(ROOM "room_c5c"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
           
        if(room = find_object(ROOM "room_c5b"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
           
        if(room = find_object(ROOM "room_c5a"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);        
        
        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "klettert", "klettert zu Dir auf den Boden");
                
        return 1;
       }  
            
   
}

int cmd_balance (string str)
{
  int i;
  int dex;
  
  notify_fail("Wohin willst Du balancieren?\n");
  
  if(member(({"hinueber",    
              "herueber",
              "foehre",
              "rueber",
              "zur foehre"}),str) > -1)
   {
  	
     if (TP->QueryAttribute(A_DEX) < 11)
       {
         write (BS("Du musst erst geschickter werden, sonst faellst Du bestimmt "
                "runter.\n"));
                
         return 1;
       }
  
     if(present("\nbalancierstange",TP)!=TP->QueryProp(P_WEAPON) &&
        present("\nbalancierstange",TP) )
       {
         write (BS("Wenn Du schon eine Balancierstange hast, solltest Du sie "
         "aber auch zuecken.\n"));
         
         return 1;
       }
       
     if(present("\nbalancierstange",TP)==TP->QueryProp(P_WEAPON))
       {
       	// write (BS("nu wird balanciert\n"));
       	 
       	 dex = TP->QueryAttribute(A_DEX) + 20;
       }
       
       	 dex = dex + random(101-dex);
       	 switch(dex)
       	 {
       	   case 0..50:
       	   //runterfallen, hp's verlieren
       	   write (BS("Du balancierst vorsichtig auf dem Ast Richtung Foehre. "
       	   "Uah, Du kommst aus dem Gleichgewicht und faellst!\n"));
       	   write_file(LOG "balance.log", sprintf("%s: %s ist gefallen.\n", ctime(time()),CAP(getuid(TP))));
       	   funktion_fallen();
       	   return 1;
       	   break;
       	   
       	   case 51..90:
       	   //spieler schafft es rueber
       	   
       	   write (BS("Du balancierst vorsichtig auf dem Ast Richtung Foehre.\n"));
       	   
       	   this_player()->move(ROOM "room_c5f", M_TPORT|M_NO_SHOW,
       	   "",
       	   "balanciert ueber den Ast zur Foehre hinueber",
       	   "balanciert herein. Schweissperlen auf der Stirn zeigen, dass "
       	   "das gar\nnicht so einfach war");
           
           write (BS("Endlich hast Du es geschafft, das war ja auch ein "
                     "hartes Stueck Arbeit.\n"));
           write_file(LOG "balance.log", sprintf("%s: %s hat es geschafft.\n", ctime(time()),CAP(getuid(TP))));          
       	   return 1;
       	   
       	   break;
       	   
       	   default:
       	   //spieler balanciert souveraen rueber
       	   write (BS("Du balancierst souveraen auf dem Ast Richtung Foehre.\n"));
       	   
       	   this_player()->move(ROOM "room_c5f", M_TPORT|M_NO_SHOW,
       	   "","balanciert souveraen ueber den Ast zur Foehre hinueber",
       	   "balanciert laechelnd herein");
           write (BS("Endlich hast Du es geschafft, das war ja auch ein "
                     "hartes Stueck Arbeit.\n"));
       	   write_file(LOG "balance.log", sprintf("%s: %s hat es geschafft.\n", ctime(time()),CAP(getuid(TP))));          
       	   return 1;
       	   
       	   break;
       	 }
       	 
       
   }
   return 0;
}

// Spieler faellt vom Ast
int funktion_fallen ()
{
  int pl_hp;	
  object stangerl;
  object player_weapon; 
  object room;
  int stangeda;
        
        
        write (BS("\nHart schlaegst Du auf dem Boden auf. Das tat weh!\n"));
        
        say ( TP->name() +" balanciert vorsichtig auf dem Ast Richtung "
               "Foehre. Ui, er kommt ins Wanken und faellt mit einem "
               "lauten Schrei nach unten.\n");
        
        stangeda=0;
        
        if(present("\nbalancierstange",TP))
           {
       	       stangeda=1;
       	       write (BS("Deine Balancierstange zerbricht mit einem lauten "
       	       "*KNACKS*\n"));
               //Balancierstange entfernen     	       
               stangerl=present("\nbalancierstange", TP);
               stangerl->SetProp(P_CURSED,0);  //erstma entfluchen
               player_weapon = TP->QueryProp(P_WEAPON);
               if(player_weapon)               //wegstecken, damit keine
                  player_weapon->DoUnwield(1); //Meldung kommt
               stangerl->remove();             //und weg damit..
           }
        
        //An den unten liegenden Raeumen vorbeifallen
         if(room = find_object(ROOM "room_c5d"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
        
         if(room = find_object(ROOM "room_c5c"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
        
        if(room = find_object(ROOM "room_c5b"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
        
        if(room = find_object(ROOM "room_c5a"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
           
       //teleportieren zum Fuss des Baumes
       if(stangeda==1)
           this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
           "faellt nach unten", "faellt", "faellt neben Dir auf den Boden "
           "und verzieht das Gesicht vor Schmerzen. Eine Balancierstange "
           "zerbricht mit einem lauten *KNACKS*");
        else
           this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
           "faellt nach unten", "faellt", "faellt neben Dir auf den Boden "
           "und verzieht das Gesicht vor Schmerzen");
       
        //HP's runter, zwischen 20-30
        pl_hp=20 + random(11);
        //Kill-Message
        SetProp(P_KILL_NAME,"Ein verdammt tiefer Sturz");
        //Schaden setzen
        TP->do_damage(pl_hp);
        
        return 1;
}  
