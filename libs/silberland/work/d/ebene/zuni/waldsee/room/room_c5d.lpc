#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald


  create()
  {
  ::create();

     
  SetProp( P_INT_SHORT, "Auf einem Baum" );
  SetProp( P_INT_LONG, 
     "Du befindest Dich auf einem Ast einer Fichte. Unter Dir siehst Du den "
     "Waldboden, ueber Dir siehst Du eine grosse Astgabel." );
        
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_HIDE_EXITS, 1);

//Details 
  // DETAILS START

  AddDetail( ({"boden", "unten", "nach unten", "waldboden"}),
     "Du schaust nach unten, kannst aber nichts vom Boden erkennen. "
     "Dir wird leicht schwindelig.");

  AddDetail( ({"himmel", "nach oben", "oben"}),
     "Du siehst ueber Dir eine grosse Astgabel. Weiter oben, wenn Du durch "
     "die Aeste schaust, siehst Du den blauen Himmel.");

  AddDetail( ({"astgabel"}),
     "Sieht ziemlich bequem aus. Kletter doch hoch und setzt Dich mal "
     "drauf. ");

  AddDetail( ({"ast", "aeste"}),
     "Du sitzt auf einem Ast der grossen Fichte, auf die Du geklettert bist. "
     "Ein bisschen unbequem, vieleicht findest Du ja einen besseren Platz "
     "zum Sitzen.");

  AddDetail( ({"fichte", "baum"}),
     "Du siehst eine ganz normale grossgewachsene Fichte.");

  AddDetail( ({"platz"}),
     "Du rufst: Hasso! Platz! - Doch Hasso scheint nicht zu hoeren.");

  AddDetail( ({"hasso"}),
     "*WUFF*");

  AddDetail( ({"baeume", "nadelbaeume", "nadelwald"}),
     "Die Baeume rings um Dich herum sind recht hohe Fichten. ");

  AddDetail( ({"himmels"}),
     "Frag mich nicht, ich weiss es nicht.");

  AddDetail( ({"doch", "wuff"}),
     "Voellig uninteressant.");

  // DETAILS END
  

//Sounds:
  AddSound( DEFAULT_SOUND,
     "Du kannst ganz leise den Wind hoeren, wie er seicht durch die Aeste "
     "streicht.\n");
  AddSound( ({"wind", "streichen"}),
     "Es ist ein sehr leises Geraeusch, fast nicht wahrzunehmen.\n");
 
  AddSound( ({"geraeusch"}),
     "Kaum auszumachen.\n");
 

//Smells:

  AddSmell( DEFAULT_SMELL,
     "Du riechst Waldduft.\n");
 
  AddSmell( ({"waldduft"}),
     "Es riecht nach hauptsaechlich nach Harz. Ziemlich typisch fuer einen "
     "Nadelwald.\n");
 
  AddSmell( ({"harz"}),
     "Schwierig zu beschreiben. Irgendwie harzig.\n");
//Commands:
  AddCmd( ({"kletter","klettere"}) ,  "cmd_klettern");


  }

// Funktion klettern:

int cmd_klettern (string str)
{
  int i;
  object room;

  notify_fail("Du siehst eine grosse Astgabel ueber Dir. Du kannst ja "
              "versuchen, auf die Astgabel zu klettern. Oder willst Du "
              "doch lieber nach unten klettern?\n");
       
     if(member(({"auf astgabel",    //geht nur rauf oder runter
                 "astgabel",
                 "zur astgabel"}),str) > -1)
       {
       	write (BS("Du kletterst auf die Astgabel.\n"));
       	
       	this_player()->move(ROOM "room_c5e", M_TPORT|M_NO_SHOW, 
        "nach oben auf eine Astgabel", "klettert", 
        "klettert zu Dir auf die Astgabel");
        
       	return 1;
       }
       
     if(member(({"runter",    //wieder runterklettern
                 "herunter",
                 "hinunter",
                 "nach unten"}),str) > -1)
       {
        write (BS("Du kletterst wieder zurueck auf den Boden.\n"));
        
        if(room = find_object(ROOM "room_c5c"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
        
        if(room = find_object(ROOM "room_c5b"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
        
        if(room = find_object(ROOM "room_c5a"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
        
        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "klettert", "klettert zu Dir auf den Boden");
             
        return 1;
       }  
       
     
}