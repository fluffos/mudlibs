#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald

   string *getrunken;
   
      create()
      {
        ::create();

     
     SetProp( P_INT_SHORT, "Weg am See" );
     SetProp( P_INT_LONG, 
        "Du stehst auf dem Weg an einem Waldsee. Die Wasseroberflaeche ist glatt, "
        "nur ab und zu sendet ein nach einer Muecke schnappender Fisch glaenzende "
        "Wasserkringel in alle Richtungen. Zwischen dem Weg und dem See liegt der "
        "knapp zwei Meter breite Uferstreifen, mit Gras und vielen Kraeutern "
        "bewachsen. Dicht am Ufer kannst Du im klaren Wasser ein paar kleine "
        "Fische erkennen. Im Norden ist undurchdringliches Buschwerk, Du kannst "
        "hier nur wieder nach Nordosten zurueckgehen." );
      grundzustand(); //erstma resetten 
     SetProp( P_LIGHT, 1 );
     SetProp( P_INDOORS, 0 );


  // DETAILS START

  AddDetail( ({"wald"}),
     "Die Baeume des Waldes stehen nicht bis zum Ufer des Sees. Sehr viele "
     "Baeume kannst Du nicht erkennen, es ist recht licht.");

  AddDetail( ({"baeume", "baum"}),
     "Nordoestlich von Dir stehen einige Eichen.");

  AddDetail( ({"eichen", "eiche"}),
     "Wenn Du Richtung Nordosten gehst, kannst Du bestimmt noch viel mehr davon "
     "entdecken.");

  AddDetail( ({"boden", "unten", "nach unten", "pfad", "weg"}),
     "Du befindest Dich auf einem Pfad, der hier leider endet.");

  AddDetail( ({"busch", "buschwerk"}),
      "Das Buschwerk ist viel zu dicht um hier weiterzukommen.");
     
  AddDetail( ({"himmel"}),
     "Der Himmel ist strahlend blau, keine Wolke zu sehen. Die Sonne lacht "
     "Dich an.");

  AddDetail( ({"wolke", "wolken"}),
     "Keine zu sehen. Sonst waere die Sonne auch nicht so schoen zu sehen.");

  AddDetail( ({"sonne"}),
     "Die Sonne kann natuerlich nicht lachen. Aber wenn sie es koennte, wuerde "
     "sie es jetzt bestimmt tun.");

  AddDetail ( ({"ufer", "uferstreifen"}),
    "Du stehst am Ufer des Sees im Alten Wald. Graeser und Kraeuter "
    "wachsen hier sehr ueppig, da Licht und sauberes Wasser im Ueberfluss "
    "vorhanden sind.");

  AddDetail( ({"ueberfluss"}),
     "Es gibt ziemlich viel davon.");

  AddDetail( ({"gras"}),
     "Das Gras ist saftig und gruen.");

  AddDetail( ({"graeser"}),
       "Dir kommen keine der hier wachsenden Graeser bekannt vor.");

  AddDetail( ({"kraeuter"}),
       "Du erkennst Bilsenkraut und etwas Loeffelkraut.");

  AddDetail( ({"bilsenkraut"}),
       "Du ueberlegst, was Du so ueber Bilsenkraut weisst. "
       "Hmm... es gehoert zur Familie der Nachtschattengewaechse, soviel ist "
       "schon mal sicher. Es wirkt unter anderem krampfloesend. Aber da Du "
       "keinen Krampf hast, wendest Du Dich lieber interessanteren Dingen "
       "zu.");

  AddDetail( ({"dinge", "dinge"}),
     "Das ist ja ein Ding!");

  AddDetail( ({"krampf"}),
     "Arg!! Du bekommst einen Krampf im Bein. Vielleicht ruhst Du Dich besser "
     "ein bisschen aus?");

  AddDetail( ({"bein", "beine"}),
     "Du hast zwei davon. Waere sonst ja auch schwierig zu gehen.");

  AddDetail( ({"familie"}),
     "Wann hast DU das letzte Mal Deine Familie besucht?");

  AddDetail( ({"nachtschattengewaechs", "nachtschattengewaechse"}),
     "Zu diesen gehoert auch das Bilsenkraut.");

  AddDetail( ({"loeffelkraut"}),
       "Dies ist der richtige Platz, wenn man auf der Suche nach Loeffelkraut "
       "ist. Die kleinen gelben Blueten sind nett anzuschaun. Du hast mal "
       "gehoert, dass Loeffelkraut gegen Skorbut wirkt. Gut zu wissen. Aber "
       "eigentlich moechtest Du gar keine Skorbut bekommen, deswegen "
       "laesst Du Loeffelkraut Loeffelkraut sein.");

  AddDetail( ({"skorbut"}),
     "Skorbut ist ein Vitaminmangel. Frueher gab es das viel auf langen "
     "Seereisen, heutzutage nimmt man auf laengere Reisen Obst mit, damit "
     "das nicht mehr vorkommt.");

  AddDetail( ({"obst"}),
     "Iss mal wieder frisches Obst, das ist gesund! Im Fischerdorf soll es "
     "angeblich einen Garten geben, in dem man Obst finden kann.");
     
  AddDetail( ({"garten"}),
     "Hier ist kein Garten, aber im Fischerdorf ist einer. Das ist gar nicht "
     "so weit entfernt.");

  AddDetail( ({"reise", "seereisen", "seereise", "reisen"}),
     "Geh doch auch mal auf eine Reise.");

  AddDetail( ({"vitaminmangel"}),
     "Den bekommt man bei zuwenig Vitaminen.");

  AddDetail( ({"vitamine"}),
     "Die sind gesund!");

  AddDetail( ({"blueten"}),
     "Die Blueten des Loeffelkrautes sind gelb.");

  AddDetail( ({"loeffel"}),
     "Einen Loeffel hast Du nicht dabei. Vielleicht bekommst Du einen bei "
     "Saruman? In seinem Labyrinth soll es angeblich einen Loeffel geben.");

  AddDetail( ({"labyrinth"}),
     "Bei Saruman gibt es eins. Aber es gibt noch bestimmt viel mehr im "
     "Silberland.");

  AddDetail( ({"saruman"}),
     "Der lebt nicht hier.");

  AddDetail( ({"suche"}),
     "Deine Suche ist bestimmt noch nicht beendet.");

  AddDetail( ({"platz"}),
     "Er ist genau richtig.");

  AddDetail ( ({"wasser", "wasseroberflaeche", "oberflaeche", "see", "waldsee"}),
    "Du schaust ueber den See, und ein Gefuehl der Ruhe ueberkommt Dich. "
    "Nur ein paar funkelnde Wellenkringel sind zu sehen, von nach Muecken "
    "schnappenden Fischen. Das auf dem Wasser gebrochene Sonnenlicht sendet "
    "seine Strahlen in alle Richtungen und traegt zu der schoenen Stimmung "
    "bei.");

  AddDetail( ({"gefuehl", "stimmung", "ruhe"}),
     "Ein angenehmes Gefuehl, hier zu stehen und sich einfach nur die "
     "Landschaft anzuschaun.");

  AddDetail( ({"landschaft"}),
     "Ein Waldsee, Sonne, Ruhe -- einfach herrlich.");

  AddDetail( ({"fisch", "fische"}),
     "Mit Fischen kennst Du Dich ueberhaupt nicht aus. Vielleicht faengst Du "
     "mit etwas leichtem an, und fragst Alrik mal nach dem Silberhai?");

  AddDetail( ({"silberhai"}),
     "Alrik kann Dir bestimmt mehr darueber erzaehlen.");

  AddDetail( ({"alrik"}),
     "Alrik ist ein Fischer.");

  AddDetail( ({"fischer"}),
     "Die meisten leben im Fischerdorf.");

  AddDetail( ({"fischerdorf"}),
     "Es gibt eins in der Naehe von Midas.");

  AddDetail( ({"naehe"}),
     "Komm mir bloss nicht zu nahe!");

  AddDetail( ({"midas"}),
     "Midas liegt woanders. Irgendwo oestlich glaube ich.");

  AddDetail( ({"muecke", "muecken"}),
     "Nun mach mal nicht aus einer Muecke einen Elefanten.");

  AddDetail( ({"elefant", "elefanten"}),
     "Keiner zu sehen. Vielleicht gehst Du doch lieber in einen Zoo, wenn "
     "Du einen sehen willst.");

  AddDetail( ({"zoo"}),
     "Hier ist keiner.");

  AddDetail( ({"wellenkringel", "wellen", "kringel", "sonnenstrahlen",
     "strahlen", "sonnenlicht", "licht", "wasserkringel", "welle"}),
     "Das Sonnenlicht bricht sich in den Wellen auf dem See und sendet "
     "Reflexionen in alle Richtungen.");

  AddDetail( ({"reflexion", "reflexionen"}),
     "Das Sonnenlicht wird gebrochen und in alle Richtungen gestreut.");

  AddDetail( ({"richtungen", "himmelsrichtungen", "haupthimmelsrichtungen"}),
     "Acht Haupthimmelsrichtungen gibt es: Norden, Sueden, Westen, "
     "Osten, Nordwesten, Nordosten, Suedosten und Suedwesten.");

  AddDetail( ({"westen", "sueden", "norden", "osten", "nordosten", 
     "suedosten", "nordwesten", "nordosten", "suedwesten"}),
     "Eine Himmelsrichtung. Was hast Du erwartet?");

  AddDetail( ({"kraeutern", "alten", "meter", "mal", "dingen", "vitaminen"}),
     "Dies ist bestimmt kein interessantes Detail.");

  AddDetail( ({"detail"}),
     "Meinst Du, es lohnt hier zu forschen? Ich glaube nicht.");

  // DETAILS END


// Sounds
	
   AddSound (DEFAULT_SOUND, 
        "Eine ziemliche Ruhe. Entspannend eigentlich.");

  AddSound( ({"ruhe"}),
     "Nix zu hoeren, vom Plaetschern der Wellen mal abgesehen.\n");

  AddSound( ({"plaetschern", "wellen"}),
     "*plaetscher*\n");

   AddRoomMessage ( ({
        "Leise plaetschert eine Welle an das Ufer.\n" }), 300 );


   AddExit( "nordosten", "./room_b5" );
   
   AddCmd( ({ "schwimm", "schwimme"}), "cmd_schwimmen");
   AddCmd( ({ "ruh", "ruhe"}), "cmd_ausruhen");
   AddCmd( ({ "trink", "trinke"}), "cmd_trinken");
}

reset()
{
 
  ::reset();
  grundzustand();
    
  }
  

int grundzustand()
{
 getrunken=({});
}


int cmd_ausruhen(string str)
{
   notify_fail("Wie meinen? Ruh aus oder wie? Da kannst Du auch rasten.\n");
   if (str=="aus")
   {
   TP->command_me("raste");
   return 1;
   }
   return 0;
}




int cmd_trinken (string str)
{
  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser" || str == "wasser aus see" || str == "aus see")) return 0;	

  if(member(getrunken, getuuid(TP)) == -1)
  {
    if(TP->drink_soft(10)) 
    {
      TP->AddHp(15);
      //getrunken += ({TP->name()});
      write(BS("Du trinkst einen Schluck Wasser aus dem See und fuehlst Dich besser. "
               "Sehr gut hat das Wasser aber nicht geschmeckt."));
      say(BS(CAP_TPN + " trinkt einen Schluck Wasser aus dem See."));
     getrunken += ({getuuid(TP)});
    }
    return 1;
  }
  write(BS("Irgendwie schmeckte das Wasser nicht so gut, wie Du erwartet hattest. "
           "Vielleicht schmeckt es an einer anderen Stelle besser?"));
  return 1;
}


int cmd_schwimmen(string str)
{
   notify_fail("Worin willst Du schwimmen?\n");
   if (str=="in see" || str=="im see")
   {
   write (BS("Froehlich huepfst Du in den See. Das Wasser ist herrlich erfrischend "
             "und Du schwimmst gleich ein paar Runden. Nach einem kleinen Weilchen "
             "wird es doch langsam kuehl und zu steigst wieder aus dem See heraus. "
             "Bibbernd schuettelst Du Dich um wieder trocken und warm zu werden."));
             
   tell_room(TO, BS(CAP_TPN+" huepft so wie er ist in den See! "+capitalize(TP->QueryPronoun(WER))+
             " schwimmt "
             "ein paar Runden. Das Wasser scheint jedoch recht kalt zu sein. "
             +CAP_TPN+" steigt bibbernd und mit blauen Lippen aus dem Wasser "
             "und schuettelt sich, dass die Tropfen nur so fliegen."), ({TP}) );
   return 1;
   }
return 0;
}