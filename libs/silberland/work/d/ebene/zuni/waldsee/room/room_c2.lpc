#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald

int gnom_clone;

      create()
      {
        ::create();

          
          
     SetProp( P_INT_SHORT, "Weg durch den Wald" );
     SetProp( P_INT_LONG, 
        "Du befindest Dich auf einem Weg durch den Wald. Kaum ein "
        "Geraeusch ist zu hoeren, selbst die Voegel, die Du ab und zu "
        "durch das Dickicht huepfen und flattern siehst, sind erstaunlich "
        "ruhig. Am Wegrand siehst Du eine kleine, ziemlich verfallen "
        "wirkende Huette. Ab und zu streicht ein Windhauch um die Huette.");

  grundzustand();             
// Details beschreiben:             
  // DETAILS START    
  
  
   AddDetail( ({"weg", "boden", "schotterweg", "waldboden", "nach unten", 
                "wegrand", "rand des weges", "waldweg"}),
	"Unter Dir befindet der Weg, auf dem Du hergekommen bist. Er fuehrt "
	"zu einer verfallenen Huette am Wegrand unter den Baeumen, sowie "
	"in Richtung Osten und Sueden. Weiter im Sueden glaubst Du "
	"ein Glitzern durch die Baeume zu sehen. Wird wohl einte "
	"optische Taeuschung gewesen sein, was soll auch hier in diesem "
	"duesteren Wald glitzern?" );
       
   AddDetail( ({"eichen", "eiche", "baum", "baeume", "wald", 
                "stamm", "staemme"}),
        "Auch hier stehen ringsherum maechtige Eichen. Imposante Staemme "
        "und ausladende Baumkronen. Aber irgendwie machen die Baeume einen "
        "bedrohenden Eindruck. Du kannst aber nicht genau einordnen, warum.");

  AddDetail( ({"eindruck"}),
       "Er ist bedrohlich.");
       
   AddDetail( "bein",
        "Du schaust Dir pruefend Dein Bein an. Etwas krumm ist es ja schon, "
        "aber damit kannst Du wohl leben (wirst es auch wohl muessen :-) )");
   
   AddDetail( "tod",
        "Du bist froh, dass jetzt keiner vor Dir steht und in GROSSBUCHSTABEN "
        "mit Dir redet.");

  AddDetail( ({"grossbuchstaben"}),
       "Du hoerst eine Stimme hinter Dir:\n"
       "Der Tod sagt: HALLO MEIN FREUND. BIST DU BEREIT?");
       
  AddDetail( ({"freund"}),
       "Meinst Du, dass der Tod Dein Freund ist? Ich glaube, da taeuscht "
       "Du Dich.");
              
   AddDetail( ({"rand", "rande"}),
        "Du bist schon am Rande eines Nervenzusammenbruchs. Der Wald schlaegt "
        "Dir gewaltig aufs Gemuet.");

  AddDetail( ({"gemuet"}),
       "Gemuetlich ist es hier bestimmt nicht.");
       
  AddDetail( ({"nervenzusammenbruch", "nerven"}),
       "Dein Augenlid faengt nervoes an zu zucken.");
       
   AddDetail( "forscherdrang",
        "Dein Forscherdrang war schon groesser. Es ist Dir einfach zu "
        "unheimlich hier. Forschen ist doch viel schoener, wenn man gemuetlich "
        "zuhause vor dem offenen Kamin sitzen kann.");
   
  AddDetail( ({"kamin"}),
       "Warm und wohlig vor dem Kamin - das waere fein :-)");
          
   AddDetail( "gedanken",
        "Du denkst an etwas Schoenes. Vielleicht kannst Du so die Gedanken an "
        "Tod und Sterben verdraengen.");

  AddDetail( ({"schoenes"}),
       "Eine Muenze fuer Deine Gedanken ...");

  AddDetail( ({"muenze"}),
       "Vielleicht in Deiner Boerse?");

  AddDetail( ({"boerse"}),
       "Du hast keine? Ts ts ts");
       
  AddDetail( ({"sterben"}),
       "Hoffentlich wirst Du das nicht in naechster Zukunft.");

  AddDetail( ({"zukunft"}),
       "Hast Du eine?");

   AddDetail( ({"gras", "moos"}),
        "Gras und Moos wachsen auf dem Strohdach der Huette.");
     
   AddDetail( ({"scherbe", "scherben", "glasscherbe", "glasscherben"}),
        "Du siehst noch ein paar Scherben der ehemals heilen Fenster "
        "im Rahmen stecken. Ein paar andere liegen auf dem Boden vor "
        "der Huette.");
     
   AddDetail( "stroh",
        "Das Dach der Huette ist mit Stroh gedeckt. Obwohl es mehr im Zustand "
        "des Vergehens ist, und nicht mehr Stroh genannt werden kann. Moos "
        "und Gras wachsen darauf, so dass man das Stroh kaum noch erkennen "
        "kann.");

  AddDetail( ({"zustand"}),
       "Das ist doch kein Zustand! Sowas!");
       
   AddDetail( "glitzern",
        "Im Sueden siehst Du ab und zu ein Glitzern durch die Baeume blitzen. "
        "Was koennte das wohl sein? Oder hast Du Dich doch getaeuscht?");
     
   AddDetail( ({"taeuschung", "optische taeuschung"}),
        "Manchmal spielt einem das Auge einen Streich, und man sieht Dinge, "
        "die eigentlich gar nicht da sind.");

  AddDetail( ({"ding", "dinge"}),
       "Es gibt so viele interessantere Dinge hier zu untersuchen.");
       
   AddDetail( "kopf",
        "Du fasst Dir an den Kopf. Hm, scheint noch alles in Ordnung zu "
        "sein.");

  AddDetail( ({"ordnung"}),
       "Ist mit Dir wirklich alles in Ordnung?");
       
   AddDetail( ({"himmel", "sonne", "nach oben"}),
        "Du schaust nach oben zum Himmel, kannst aber weder ein Fleckchen "
        "Blau noch die Sonne erkennen. Das Blaetterdach ist einfach zu "
        "dicht.");
   
   AddDetail( ({"blaetterdach", "baumkrone", "baumkronen"}),
        "Das Blaetterdach ueber Dir ist zu dicht, um ein Fleckchen Himmel "
        "erkennen zu koennen. Auch die Sonne schafft es nicht, es zu "
        "durchdringen. Du fuehlst Dich beengt und fuehlst Dich gar nicht "
        "wohl.");

  AddDetail( ({"fleckchen"}),
       "Keins zu sehen.");
       
   AddDetail( "streich",
        "Ploetzlich springt ein kleiner Gnom aus dem Gebuesch, klebt Dir "
        "einen Zettel auf den Ruecken und ist sofort wieder verschwunden. "
        "Du reisst veraergert den Zettel herunter und liest ihn:\n"
        "'TRITT MICH'\n"
        "Du denkts: 'So eine Frechheit! Da hat mir einer einen Streich "
        "gespielt!' und isst vor lauter Wut den Zettel.");

  AddDetail( ({"wut"}),
       "Zuviel Wut tut nicht gut.");
       
  AddDetail( ({"zettel"}),
       "Du haettest ihn vielleicht doch nicht essen sollen?");
       
  AddDetail( ({"mich"}),
       "Besser es erwischt Dich als mich.");
       
  AddDetail( ({"frechheit"}),
       "Das ist wirklich frech.");
       
   AddDetail( ({"blau", "blau des himmels", "himmelsblau"}),
        "Keine Spur von blauem Himmel zu sehen.");
   
   AddDetail( ({"vogel", "voegel"}),
        "Du kannst keine Voegel erkennen. Zu hoeren ist auch nichts. "
        "Das kann eigentlich nichts Gutes bedeuten. Du bekommst eine "
        "Gaensehaut.");
   
   AddDetail( ({"wind", "windhauch"}),
        "Ab und zu streicht ein Windhauch um die verlassene Huette und "
        "laesst die Tuer in den Angeln quietschen.");
   
   AddDetail( "gefuehl",
        "Du hast ein ungutes Gefuehl. Du spielst mit dem Gedanken, hier "
        "schleunigst zu verschwinden.");
   
   AddDetail( ({"fensterscheiben", "scheiben", "glas", "glassplitter",
                "fensterglas", "glasscheiben"}),
        "Von den Fensterscheiben der Huette ist nicht viel mehr uebrig. "
        "Nur ab und zu kannst Du eine Scherbe des Fensterglases in Rahmen "
        "und auf dem Boden vor der Huette erkennen.");

  AddDetail( ({"rahmen"}),
       "Sie rahmen die Fenster ein.");
       
   AddDetail( ({"gnom", "kleiner gnom"}),
        "Einen Gnom kannst Du nicht entdecken. Wenn einer da ist, hat er "
        "sich zu gut versteckt.");
      
   AddDetail( ({"unternehmung", "unternehmen"}),
        "Du ueberlegst, warum Du Dich bloss auf dieses wahnwitzige "
        "Unternehmen eingelassen hast. Waerst Du doch lieber zuhause "
        "geblieben, da haettest Du es jetzt viel gemuetlicher.");
     
   AddDetail( "spur",
        "Du bist einem grossen Geheimnis auf der Spur, vergiss das nicht. "
        "Wenn Du es schaffst, das hier zu ueberleben (was Du insgeheim "
        "bezweifelst), koenntest Du ein beruehmter Forscher werden.");
   
   AddDetail( ({"ruecken", "mein ruecken"}),
        "Das wird Dir schwerfallen. Oder bist Du so gelenkig?");
   
   AddDetail( "gaensehaut",
        "Dir laeuft es kalt den Ruecken herunter. Hier ist es aber auch "
        "unheimlich!");
   
   AddDetail( ({"vorhaenge", "vorhang", "fetzen"}),
        "Die Vorhaenge haengen in Fetzen hinter den leeren Fenstern. Dies "
        "macht alles einen sehr trostlosen Eindruck auf Dich.");
     
   AddDetail( ({"forscher", "forschen", "geheimnis"}),
        "Der Forscherdrang packt Dich. Dieses Geheimnis willst Du loesen, "
        "auch wenn es das Letzte ist, was Du tun willst. Moment mal - ist "
        "das wirklich Dein Ernst?");

  AddDetail( ({"ernst"}),
       "Das meine ich wirklich ernst.");
       
   AddDetail( "wunder",
        "Es braucht wohl wirklich ein Wunder, um diese Huette wieder auf "
        "Vordermann zu bringen.");
     
   AddDetail( ({"dickicht", "unterholz", "gebuesch", "gestruepp"}),
        "Am Rand des Weges, unter den maechtigen Eichen, siehst Du eine "
        "Menge Unterholz und Gestruepp. Es versperrt Dir den Blick weiter "
        "in den Wald hinein.");

  AddDetail( ({"blick"}),
       "Er ist Dir versperrt.");
       
  AddDetail( ({"menge"}),
       "Sehr viel :-)");
       
   AddDetail( ({"augen", "auge", "augenhoehlen", "augenhoehle"}),
        "Ich schau Dir in die Augen, Kleines :-)");
     
   AddDetail("huette",
	"Du schaust Dir die Huette genauer an. Sie sieht ziemlich "
	"verfallen aus. Anscheinend war schon lange keiner mehr hier, "
	"um sie instand zu halten. Das Dach biegt sich durch, die Tuer "
	"haengt schief in den Angeln und bewegt sich leicht im Wind. "
	"Die Fenster sind alle zerbrochen, die Vorhaenge haengen in "
	"Fetzen durch die jetzt leeren Fensterhoehlen.\n"
	"Du traust Dich nicht, die Huette zu betreten.");
	
   AddDetail( ({"dach", "strohdach"}),
        "Das Dach der Huette besteht aus Stroh und sieht ziemlich zerrupft "
        "aus. Ein Wunder, dass es noch nicht zusammengefallen ist.");
        
   AddDetail( ({"tuer", "tuere"}),
        "Die Tuer der Huette haengt schief in den Angeln. Sie bewegt sich "
        "ab und zu im Wind und gibt ein schauriges Geraeusch von sich.");
        
   AddDetail( ({"angeln", "tuerangeln", "scharniere", "tuerscharniere",
                "tuerangel", "scharnier", "tuerscharnier"}),
        "Die Angeln der Tuer sind offensichtlich schon lange nicht mehr "
        "geoelt worden. Bei jedem Windhauch, bei dem sich die Tuer bewegt, "
        "quietschen sie zum Gotterbarmen.");

  AddDetail( ({"gotterbarmen", "goetter", "erbarmen"}),
       "Hoffentlich haben die Goetter ein Erbarmen mit Dir.");
       
   AddDetail( ({"fenster", "fensteroeffnungen", "fensterhoehlen"}),
        "Nur noch ein paar Glassplitter lassen erkennen, dass in den "
        "Fenstern einmal Glasscheiben waren. Durch die jetzt unheimlich "
        "leer wirkenden Fensterhoehlen weht der Wind, und ab und zu kannst "
        "Du die in Fetzen gerissenen Vorhaenge durch die Fensteroeffnungen "
        "sehen. Fast hast Du das Gefuehl, als ob Dich die Huette mit grossen "
        "blinzelnden Augen anschaut. Dir wird heiss und kalt und Du "
        "moechtest eigentlich nur noch nach Hause.");


  AddDetail( ({"alten", "augenlid", "kleines", "baeumen", "letzte",
       "nervenzusammenbruchs", "vergehens", "vergehen", "sowas",
       "vordermann", "ts", "fensterglases", "hause", "dies", "gutes", 
       "still", "mark", "mein", "bereit", "richtung"}),
       "Musst Du denn wirklich ALLES wissen?");

  AddDetail( ({"alles"}),
       "Du darfst zwar alles essen, aber nicht alles wissen.");
       
  AddSmell( DEFAULT_SMELL,
       "Es riecht hier irgendwie komisch.\n");
       
	
  // DETAILS END	

// Sounds beschreiben:
   AddRoomMessage ( ({
        "Du hoerst ein schauerliches knirschendes Geraeusch, dass Dir durch "
        "Mark und Bein geht.\n" }), 240 );
	
   AddSound (DEFAULT_SOUND, 
        "Es ist sehr still. Nur ab und zu hoerst Du etwas sehr unheimliches.");
	
   AddSound (({"geraeusch", "knirschen", "knirschendes Geraeusch",
               "unheimliches Geraeusch", "quietschen", "tuer", "quietschen"}),
        "Das unheimliche Geraeusch laesst Dich erschauern. Es klingt fast wie "
        "ein schreiendes Kind. Du fuehlst Dich hier ganz und gar nicht wohl. "
        "Wieder schiesst Dir durch den Kopf, wie leichtsinnig diese "
        "Unternehmung doch eigentlich ist.");

  AddSound( ({"kind"}),
       "Als ob ein Kind schauerlich schreit.\n");
  
  AddSound( ({"schrei", "schreien"}),
       "Dir schaudert! So etwas unheimliches hast Du noch nie gehoert.\n");
  
  AddSound( ({"wind", "windhauch"}),
       "Der Wind streicht leise um die Huette und bringt die Tuer zum Quietschen.\n");
  
  AddSound( ({"stimme"}),
       "HALLO?\n");
       

// Commands beschreiben:
    AddCmd( ({ "denk", "denke"}), "cmd_denken");
    AddCmd( ({"schauder", "schaudre"}), "cmd_schaudern");
    AddCmd( ({ "such", "suche"}), "cmd_suchen");  
	
// Exits beschreiben:	
	
   AddExit( "osten", "./room_d2" );
   AddExit( "sueden", "./room_c3" );
//   AddExit( "huette", "in die Huette#" + "./huette.lpc" );
   

}


reset()
{
 
  ::reset();
  grundzustand();
    
  }

int grundzustand()
{
  object gnom;	
  gnom_clone = 1;              
  if (gnom && gnom->InFight()) 
  gnom_clone = 0;              
}


int cmd_suchen (string str)
{
  object ob;
 
  if(!gnom_clone)       
  {
  write(BS("Du findest keinen Gnom. Er hat sich wohl zu gut versteckt."));
  return 1;
  }

  ob=clone_object(NPC "gnom.lpc");  
  ob->move(TO,M_GO);
  gnom_clone = 0;               
  return 1;
}




 cmd_denken()       //Spieler denkt
{
  write(BS("Du denkst an Deine Familie und Deine Freunde, die jetzt warm und "
         "geborgen zuhause sitzen. Wie konntest Du bloss in diese Lage "
         "geraten?"));
         
  say(BS(CAP_TPN+" denkt wohl wieder nach. Steile Falten bilden sich "
                    "auf der Stirn und das "
                    "Gesicht nimmt einen leicht "
                    "duemmlichen Gesichtsausdruck an."));
  return 1;
}


 cmd_schaudern()      
{
  write(BS("Du schuettelst Dich und alle Deine Haare stehen zu Berge."));
         
  say(BS(CAP_TPN+" schaut sehr seltsam. Irgendwas scheint "+TP->QueryPronoun(WEM)+
                 " ziemlich an die Nieren zu gehen, "+TP->QueryPossPronoun(NEUTER, WER, PLURAL)+
                 " Haare stehen zu Berge!"));
  return 1;
}
