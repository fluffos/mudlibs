#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald

  int funktion_fallen();

  create()
  {
  ::create();

       
  SetProp( P_INT_SHORT, "Auf einem Baum" );
  SetProp( P_INT_LONG, 
     "Du sitzt auf einem Ast einer Fichte. Unter Dir siehst Du den "
     "Waldboden, ueber Dir siehst Du einen abgestorbenen und einen frischen "
     "Ast." );
        
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_HIDE_EXITS, 1);
  
//Details 
  // DETAILS START
  
  AddDetail( ({"boden", "unten", "nach unten", "waldboden"}),
     "Du schaust nach unten. Du siehst den Waldboden unter Dir, bedeckt "
     "mit den abgefallenen abgestorbenen Fichtennadeln.");
     
  AddDetail( ({"fichte", "baum"}),
     "Du sitzt auf einem praechtigen Exemplar einer Rotfichte.");
 
  AddDetail( ({"exemplar", "rotfichte"}),
     "Wirklich praechtig.");
 
  AddDetail( ({"fichten", "wald", "baeume", "nadelwald"}),
     "Du schaust Dich um und siehst wirklich viele Baeume um Dich herum, "
     "alles Fichten.");
 
  AddDetail( ({"abgestorbener ast", "abgestorbenen ast", 
               "abgestorbenen ast an"}),
     "Der sieht nicht sehr vertrauenserweckend aus. Aber wer weiss?");
     
  AddDetail( ({"fichtennadeln"}),
     "Sie duerften Deinen Aufprall, wenn Du stuerzt, etwas daempfen. "
     "Das hoffst Du zumindest.");
  
  AddDetail( ({"aufprall"}),
     "Der duerfte trotzdem ziemlich hart werden.");
 
  AddDetail( ({"frischer ast", "frischen ast", "frischen ast an"}),
     "Sieht stark und kraeftig aus. Der haelt Dich bestimmt aus.");
 
  AddDetail( ({"ast", "aeste"}),
     "Du sitzt auf einem Ast. Ueber Dir kannst Du einen abgestorbenen und "
     "einen frischen Ast sehen. Vielleicht kannst Du ja noch hoeher "
     "klettern?");
 
  AddDetail( ({"himmel", "nach oben", "oben"}),
     "Ab und zu kannst Du ein kleines Stueck blauen Himmels durch die "
     "Aeste erkennen.");

  AddDetail( ({"stueck"}),
     "Du blinzelst nach oben, kannst aber nicht viel vom Himmel erkennen.");
 
  AddDetail( ({"baeume", "nadelbaeume"}),
     "Die Baeume rings um Dich herum sind recht hohe Fichten.");

  AddDetail( ({"himmels", "ahnung"}),
     "Keine Ahnung, was Du meinst.");

  // DETAILS END
  
//Sounds:
  AddSound( DEFAULT_SOUND,
     "Du kannst ganz leise den Wind hoeren, wie er seicht durch die Aeste "
     "streicht.\n");
  AddSound( ({"wind", "streichen"}),
     "Es ist ein sehr leises Geraeusch, fast nicht wahrzunehmen.\n");
 
  AddSound( ({"geraeusch"}),
     "Kaum auszumachen.\n");
 

//Smells:

  AddSmell( DEFAULT_SMELL,
     "Du riechst Waldduft.\n");
 
  AddSmell( ({"waldduft"}),
     "Es riecht nach hauptsaechlich nach Harz. Ziemlich typisch fuer einen "
     "Nadelwald.\n");
 
  AddSmell( ({"harz"}),
     "Schwierig zu beschreiben. Irgendwie harzig.\n");

//Commands:
  AddCmd( ({"kletter","klettere"}) ,  "cmd_klettern");



  }

// Funktion klettern:

int cmd_klettern (string str)
{
  int i;
  object room;
  
  notify_fail("Du siehst einen abgestorbenen und einen frischen Ast ueber "
       "Dir. Auf welchen willst Du klettern? Oder willst Du lieber wieder "
       "runter klettern?\n");
       
     if(member(({"auf abgestorbenen ast",    //das ist der richtige Ast
                 "abgestorbener ast",
                 "zum abgestorbenen ast"}),str) > -1)
       {
       	write (BS("Du kletterst auf den abgestorbenen Ast. Ueber Dir siehst "
       	"Du zwei weitere Aeste, einen dunkelbraunen und einen "
       	"hellbraunen.\n"));
       	
       	this_player()->move(ROOM "room_c5c", M_TPORT|M_NO_SHOW, 
        "nach oben", "klettert", "klettert zu Dir auf den Ast");
       	
       	return 1;
       }
     if(member(({"auf frischen ast",             //das ist der falsche Ast,
                 "frischer ast",                 //funktion_fallen aufrufen
                 "zum frischen ast"}),str) > -1)
       {
        funktion_fallen();
       	return 1;
       }  
       
     if(member(({"runter",    //wieder runterklettern
                 "herunter",
                 "hinunter",
                 "nach unten"}),str) > -1)
       {
        write (BS("Du kletterst wieder zurueck auf den Boden.\n"));
        
        if(room = find_object(ROOM "room_c5a"))
           room->Message(BS(this_player()->Name()+" klettert an Dir vorbei "
           "nach unten."), MSGFLAG_VISUAL);
        
        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "klettert", "klettert zu Dir auf den Boden");
             
        return 1;
       }  
  }
  
  //Funktion fallen, Spieler faellt vom Ast:

  int funktion_fallen ()     
  {
      int i;
      object room;
   
     write (BS("Du kletterst auf den frischen Ast. Doch ploetzlich biegt "
        "sich der Ast, als ob er einen eigenen Willen hat, und wirft Dich auf "
        "den Boden zurueck. Dein Ruecken tut weh.\n"));
        
        say ( TP->name() +" klettert auf einen Ast. Der Ast scheint jedoch "
        "nicht sonderlich stabil zu sein.\n");
        
        if(room = find_object(ROOM "room_c5a"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);

        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "faellt", "faellt neben Dir auf den Boden "
        "und verzieht das Gesicht vor Schmerzen");
        
        environment(TP)->AddDetail( ({"ruecken"}),
            "Dein Ruecken schmerzt etwas, es scheint aber alles soweit "
            "in Ordnung zu sein.\n");
        
        //HP's runter, zwischen 10-15
        i=10 + random(6);
        
        SetProp(P_KILL_NAME,"Ein etwas tieferer Sturz");
        
        TP->do_damage(i);
        
        return 1;
  }
