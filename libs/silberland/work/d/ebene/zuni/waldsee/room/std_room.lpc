inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"



      create()
      {
        ::create();

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:18]) );
     
     SetProp( P_INT_SHORT, "Weg durch den Alten Wald" );
     SetProp( P_INT_LONG, 
        "Du befindest Dich tief im Alten Wald. Die maechtigen Eichen "
        "blockieren die Sicht auf Einzelheiten weiter voraus und verdunkeln "
        "durch ihre maechtigen Baumkronen die Umgebung. Zumindest ein paar "
        "Voegel kannst Du hier hoeren, wenngleich es eher das Kraechzen eines "
        "Haehers als das klare Singen einer Amsel ist. Trotzdem bist Du "
        "froh, ein anderes Geraeusch zu hoeren als nur das Deiner Schritte "
        "durch das raschelnde Laub. Die duestere Stimmung ist immernoch "
        "deutlich zu spueren.\n" );
     
     SetProp( P_LIGHT, 1 );
     SetProp( P_INDOORS, 0 );
     
     SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
     
    AddDetail( ({"silberwald"}),
     "Du befindest Dich in einem sehr duesteren Teil des Silberwaldes. Was sich "
     "hier wohl alles erforschen laesst?");
     
  AddSpecialExit( "aufgabe", "exit_aufgabe" );

   
      }
int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}