#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald

      create()
      {
        ::create();

     
     SetProp( P_INT_SHORT, "Weg durch den Wald" );
     SetProp( P_INT_LONG, 
        "Du befindest Dich tief im Wald. Die maechtigen Eichen blockieren "
        "die Sicht auf Einzelheiten weiter voraus und verdunkeln durch ihre "
        "maechtigen Baumkronen die Umgebung. Zumindest ein paar Voegel kannst "
        "Du hier hoeren, wenngleich es eher das Kraechzen eines Haehers als "
        "das klare Singen einer Amsel ist. Trotzdem bist Du froh, ein anderes "
        "Geraeusch zu hoeren als nur das Deiner Schritte durch das raschelnde "
        "Laub. Die duestere Stimmung ist immer noch deutlich zu spueren." );
     
//Details beschreiben:     
      
      
   AddDetail( ({"weg", "boden", "schotterweg", "waldboden", "nach unten", 
                "wegrand", "rand des weges", "waldweg"}),
	("Du schaust versonnen auf den Boden. Der Weg und Wegrand sind mit "
	"trockenen Blaettern bedeckt. Sie rascheln bei jedem Deiner Schritte. "
	"Du glaubst nicht, dass man sich hier lautlos bewegen kann.") );
	
   AddDetail( ({"blaetter", "eichenblaetter", "laub"}),
        ("Die Blaetter, die nicht noch am Baum haengen, liegen jetzt "
        "vertrocknet auf dem Boden.") );
   
   AddDetail( ({"himmel", "nach oben", "sonne", "baumkronen", 
                "blaetterdach", "blau"}),
        ("Die Baumkronen sind so dicht, dass Du nur selten ein bisschen Blau "
        "durch das Blaetterdach blitzen siehst.") );
   
   AddDetail( ({"eichen", "wald", "baeume", "eiche", "baum"}),
        ("Die Eichen stehen hier sehr dicht. Ohne den Waldweg wuerde hier "
        "kein Durchkommen sein.") );
        
   AddDetail( ({"einzelheiten", "umgebung"}),
        ("In diesem Daemmerlicht kannst Du kaum etwas erkennen.") );
        
   AddDetail( "sicht",
         "Durch das Daemmerlicht kannst Du kaum weiter als ein paar Meter "
         "sehen.");
         
   AddDetail( ({"daemmerlicht", "licht"}),
         "So langsam sollte auch Dir daemmern, dass das Licht hier nicht "
         "so gut ist!");
         
   AddDetail( "stimmung",
         "Die Stimmung ist nicht anders als duester zu bezeichnen. Dir laeuft "
         "ein kalter Schauder ueber den Ruecken." );
         
   AddDetail( "ruecken",
         "Das wird schwierig." );

   AddDetail( "voegel",
         "Lausch mal!" );


  AddDetail( ({"alten", "blaettern", "durchkommen", "eichenblaettern",
        "eichelhaehers", "haehers", "note", "meter", "lust", "schauder"}),
       "Nicht wirklich, oder?");
              
// Sounds beschreiben:        
        
   AddSound( ({DEFAULT_SOUND, "geraeusch", "geraeusche"}),
        "Du hoerst das leise Rascheln der trockenen Blaettern und ab und zu "
        "einen Vogel.\n");

   AddSound( ({"haeher", "eichelhaeher", "kraechzen", "heiseres kraechzen", 
               "laute", "laut"}),
        "Du hoerst das heisere Kraechzen eines Eichelhaehers.");
        
   AddSound( ({"voegel", "vogel", "vogelstimmen"}),
        "Viele Vogelstimmen kannst Du nicht hoeren. Nur ab und zu einen "
        "Eichelhaeher.");

   AddSound( ({"amsel", "gezwitscher"}),
        "Das lustige Gezwitscher einer Amsel kannst Du leider nicht vernehmen. "
        "Aber schoen waere es schon, froehlichere Laute hier zu hoeren.");
        
   AddSound( ({"rascheln", "schritte", "schritt", "blaetter", "laub"}),
        "Du hoerst das Rascheln des Laubes.");
        
   AddSound( ({"singen", "gesang"}),
        "Hier singt nichts und niemand. Aber Dich ueberkommt auf einmal "
        "eine unbaendige Lust, vor Dich hin zu singen.");
        
//Smells beschreiben:        
        
    AddSmell( ({DEFAULT_SMELL, "blaetter", "eichenblaetter"}),
        "Du riechts nicht viel, nur eine leichte Note von verrotteten "
        "Eichenblaettern.\n");
        
        
//Commands beschreiben:   
   
   AddCmd( ({ "raschel", "raschele"}), "cmd_rascheln");
   
   AddCmd( ({ "singe", "sing"}), "cmd_singen");
   
   AddCmd( ({"schauder", "schaudere"}), "cmd_schaudern");
	
//Ausgaenge beschreiben:	
	
   AddExit( "westen", "./room_c2" );
   AddExit( "osten", "./room_e2" );

      }

int cmd_rascheln(string str)       //Spieler raschelt durch die Blaetter
{
  write(BS("Du raschelst durch die Blaetter und fuehlst Dich wieder jung."));
  say(BS(CAP_TPN +" raschelt mit einem breiten Grinsen durch die "
                    "Blaetter. "));
  return 1;
}


cmd_singen()         //Spieler singt ein froehliches Lied
{
  write ("Du singst ein froehliches Lied:\n"
         "Daaaass ich der Roehhhrich bin, tuedelue...\n"
         "Daaaass weiss ein jeeedes Kind, tuedelue...\n");
  say ( TP->name() +" singt lauthals vor sich hin:\n"
         "Daaaass ich der Roehhhrich bin, tuedelue...\n"
         "Daaaass weiss ein jeeedes Kind, tuedelue...\n");
  return 1;
}
         
         
cmd_schaudern()        //Spieler erschaudert ob der Stimmung
{
  write(BS("Ganz kalt laeuft es Dir den Ruecken hinunter. Du schuettelst Dich."));
  say(BS(CAP_TPN +" schaudert es, "+TP->QueryPronoun(WER)+" schuettelt sich."));
  return 1;
}   
