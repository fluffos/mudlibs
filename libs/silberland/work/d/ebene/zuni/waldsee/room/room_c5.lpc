#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald


  create()
  {
  ::create();

     
  SetProp( P_INT_SHORT, "Weg durch den Wald" );
  SetProp( P_INT_LONG, 
     "Du befindest Dich im Wald. Rings um Dich herum stehen "
     "praechtige Nadelbaeume. Richtung See hin wird der Wald spuerbar "
     "lichter, in Richtung Sueden ruecken die Baeume immer naeher zusammen. "
     "Du fragst Dich, ob es eine gute Idee ist, dem Pfad "
     "tiefer in den Wald hinein zu folgen." );
        
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

//Details 
  // DETAILS START

  AddDetail( ({"wald"}),
     "In diesem Teil vom Wald stehen viele Fichten.");

  AddDetail( ({"see"}),
     "Der See liegt im Westen.");

  AddDetail( ({"westen"}),
     "In dieser Richtung liegt der See.");

  AddDetail( ({"idee"}),
     "Du hast eine Idee! Eine Gluehbirne erscheint ueber Deinem Kopf!");

  AddDetail( ({"gluehbirne", "kopf"}),
     "Du fasst Dir an den Kopf. Gerade hattest Du noch so eine tolle Idee, "
     "und nun hast Du sie wieder vergessen. So ein Aerger!");

  AddDetail( ({"aerger"}),
     "Du aergerst Dich.");

  AddDetail( ({"boden", "weg", "pfad"}),
     "Du stehst auf einem schmalen Pfad durch den Wald. Der Boden "
     "ist mit einem Teppich abgestorbener Fichtennadeln bedeckt, so dass "
     "Deine Schritte kaum einen Laut machen.");

  AddDetail( ({"nadelteppich", "teppich"}),
     "Mehrere Zentimeter dick liegen die abgestorbenen Fichtennadeln "
     "auf dem Boden.");

  AddDetail( ({"zentimeter"}),
     "Wieviel Zentimeter es sind, kannst Du so nicht feststellen.");

  AddDetail( ({"finger"}),
     "Du bewegst Deine Finger. Scheint alles normal zu sein.");

  AddDetail( ({"laut"}),
     "Lausch doch mal.");

  AddDetail( ({"fichtennadeln", "nadeln"}),
     "Du hebst ein paar Fichtennadeln vom Boden auf und laesst sie durch "
     "Deine Finger auf den Boden rieseln. Sie pieksen Dich ein bisschen, "
     "aber sonst faellt Dir nichts Auffaelliges auf.");

  AddDetail( ({"himmel", "nach oben", "oben"}),
     "Ab und zu kannst Du ein kleines Stueck blauen Himmels durch das "
     "Nadeldach erkennen.");

  AddDetail( ({"nadeldach"}),
     "Das befindet sich ueber Dir.");

  AddDetail( ({"stueck"}),
     "Es ist wirklich nur ein kleines Stueck vom Himmel, das Du siehst.");

  AddDetail( ({"baeume", "nadelbaeume", "fichten"}),
     "Die Baeume rings um Dich herum sind recht hohe Fichten. Eine der "
     "Fichten faellt "
     "Dir besonders auf, nebendran steht eine grosse Foehre.");

  AddDetail( ({"foehre"}),
     "Seltsam. Ueberall stehen hier Fichten, nur diese eine Foehre "
     "bildet die Ausnahme. Du schaust Dir die Foehre genauer an, und kannst "
     "hoch oben in der Baumkrone ein Glitzern erkennen.");

  AddDetail( ({"ausnahme"}),
     "Die Foehre bildet die Ausnahme. Sonst stehen hier nur Fichten.");

  AddDetail( ({"glitzern", "baumkrone"}),
     "Gerne wuerdest Du in die Baumkrone der Foehre klettern, um das Glitzern "
     "genauer zu "
     "betrachten, leider sind unten am Stamm der Foehre keine Zweige, die Dich "
     "tragen koennten. Aber bestimmt gibt es auch einen anderen Weg, um auf "
     "die Foehre zu gelangen.");

  AddDetail( ({"fichte", "baum"}),
     "Du schaust Dir die Fichte genauer an. Du siehst mehrere Aeste, "
     "weiter oben kannst Du gerade noch eine grosse Astgabel "
     "erkennen.");
 
  AddDetail( ({"zweige"}),
     "Die Zweige an der Foehre koennen Dich leider nicht tragen. Erst weiter "
     "oben sind kraeftigere Zweige zu erkennen, aber die sind viel zu hoch, "
     "um sie von hier erreichen zu koennen.");
 
  AddDetail( ({"aeste","ast"}),
     "Du siehst zwei Aeste unten am Stamm der Fichte, die Du "
     "erreichen koenntest. Einer links und ein anderer rechts ueber Dir.");

  AddDetail( ({"astgabel"}),
     "Die Astgabel ist ziemlich hoch. Direkt kannst Du sie nicht "
     "erreichen.");

  AddDetail( ({"stamm"}),
     "Der Stamm der Fichte hat einen ziemlich grossen Durchmesser. Du "
     "kannst ihn nicht umfassen. Ein paar Aeste fallen Dir auf.");

  AddDetail( ({"durchmesser"}),
     "Der Stamm hat einen Durchmesser von bestimmt drei Metern.");

  AddDetail( ({"himmels", "alten", "auffaelliges", "metern", "richtung",
               "teil"}),
     "Frag mich nicht, ich weiss es nicht.");
     
  AddDetail( ({"linker ast", "linker zweig", "linken ast", "linken zweig"}),
     "Er koennte Dein Gewicht so grad noch tragen.");

  AddDetail( ({"rechter ast", "rechter zweig", "rechten ast", "rechten zweig"}),
     "Es ist zweifelhaft, dass der rechte Ast Dein Gewicht tragen kann.");

  AddDetail( ({"gewicht"}),
     "Geh nach Midas in die Apotheke, da gibt es eine Waage.");

  AddDetail( ({"midas"}),
     "Eine Stadt, nicht weit von hier.");
     
  AddDetail( ({"stadt"}),
     "Na wenn Du das schon nicht weisst...");
 
  AddDetail( ({"apotheke"}),
     "Dort kann man so Einiges kaufen.");

  AddDetail( ({"einiges"}),
     "Geh hin und finde es heraus :-)");

  AddDetail( ({"waage"}),
     "Sei doch nicht so eitel!");

  AddSpecialDetail( ({"nadel"}),       // Nadel aufheben
     "detail_nadel");

  // DETAILS END
  

//Sounds:

  AddSound( DEFAULT_SOUND,
     "Du hoerst nichts besonderes. Es ist so leise, dass Du eine Nadel "
     "fallen hoeren koenntest.\n");

  AddSound( ({"laut"}),
     "Es ist hier sehr ruhig. Kein Laut zu hoeren.\n");

  AddSound( ({"schritte"}),
     "Der dichte Nadelteppich daempft Deine Schritte, so dass kein Laut "
     "zu hoeren ist.\n");

 
//Smells:
  AddSmell( DEFAULT_SMELL,
     "Es riecht wuerzig.\n");
 
//Commands:
  AddCmd( ({"kletter","klettere"}) ,  "cmd_klettern");


//Exits:
  	
  AddExit( "westen", "./room_b5" );
  AddExit( "suedosten", "./room_d6" );

  }

// Funktion klettern:

int cmd_klettern (string str)
{
  int i;

  notify_fail("Wohin moechtest Du klettern?\n");

     if(member(({"rauf"}),str) > -1)
       {
        write ("Wohin genau moechtest Du klettern?\n");
               
        return 1;
       }
       
     if(member(({"auf baum",
                 "auf baum rauf"}),str) > -1)
       {
        write ("Hier stehen viele Baeume. Drueck Dich ein bisschen klarer aus.\n");
               
        return 1;
       }


     if(member(({"auf foehre",
                 "foehre",
                 "auf foehre rauf"}),str) > -1)
       {
        write(BS("Auf die Foehre kannst Du nicht klettern. Die Zweige wuerden Dich "
               "nicht aushalten."));
               
        return 1;
       }
        
     if(member(({"auf fichte",
                 "fichte",
                 "auf fichte rauf"}),str) > -1)
       {
        write(BS("So einfach ist das nicht. Du musst Dich schon entscheiden, ob Du "
               "auf den linken oder den rechten Ast klettern willst."));
               
        return 1;
       }       
       
     if(member(({"nach links",    //das ist der richtige Ast
                 "links",
                 "auf linken ast"}),str)> -1)
       {
       	write(BS("Du kletterst nach links auf den Ast. Ueber Dir siehst Du "
       	"zwei weitere Aeste, einen hellgruenen und einen dunkelgruenen."));
       	
        this_player()->move(ROOM "room_c5a", M_TPORT+M_NO_SHOW, 
        "klettert nach oben", "klettert", "klettert zu Dir auf den Ast");
       	       	
       	return 1;
       }
       
     if(member(({"nach rechts",    //das ist der falsche Ast, absturz
                 "rechts",
                 "auf rechten ast"}),str) > -1)
       {
        write(BS("Du kletterst nach rechts auf den Ast. Doch ploetzlich biegt "
        "sich der Ast, als ob er einen eigenen Willen hat, und wirft Dich auf "
        "den Boden zurueck. Du reibst Dir Deinen schmerzenden Hintern."));
        
        say(BS(CAP_TPN +" klettert auf einen Ast. Der Ast scheint jedoch "
        "nicht sonderlich stabil zu sein, " +TP->name()+ " faellt auf den "
        "Boden und verzieht schmerzhaft das Gesicht."));
        
        //HP's runter, zwischen 4-7
        i=4 + random(4);
        
        SetProp(P_KILL_NAME,"Ein laecherlich kleiner Sturz");
        // SetProp(P_KILL_MSG,"");
        
        TP->do_damage(i);
        
        return 1;
       }
}

string detail_nadel (string str)
{
  SetProp(P_KILL_NAME,"Ein kleiner Nadelstich");
  	
  TP->do_damage(10);
  
 return BS("Du hebst eine Fichtennadel vom Boden auf und stichst Dir prompt "
 "in den Finger. Erschrocken laesst Du sie wieder fallen.");
}

