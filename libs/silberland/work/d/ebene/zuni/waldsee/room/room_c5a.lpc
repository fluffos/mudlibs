#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald

    int funktion_fallen();

  create()
{
  ::create();

     
  SetProp( P_INT_SHORT, "Auf einem Baum" );
  SetProp( P_INT_LONG, 
     "Du befindest Dich auf einem Ast einer Fichte. Unter Dir siehst Du den "
     "Waldboden, ueber Dir siehst Du einen dunkelgruenen und einen hellgruenen "
     "Ast." );
        
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_HIDE_EXITS, 1);
//Details 
  // DETAILS START
  
  AddDetail( ({"wald", "nadelwald"}),
     "Du bist immernoch im Wald, auch wenn Du auf einem seiner "
     "Baeume sitzt.");
 
  AddDetail( ({"boden", "unten", "nach unten", "waldboden"}),
     "Du schaust nach unten. Du siehst den Waldboden unter Dir, bedeckt "
     "mit den abgefallenen abgestorbenen Fichtennadeln.");

  AddDetail( ({"fichtennadeln", "nadeln"}),
     "Genaues kannst Du nicht ausmachen von hier, da musst Du schon "
     "wieder runterklettern.");

  AddDetail( ({"ast"}),
     "Du sitzt auf einem recht stabilen Ast. Eigentlich ganz bequem, findest "
     "Du.");

  AddDetail( ({"zweige"}),
     "Naja, eher Aeste.");

  AddDetail( ({"aeste"}),
     "Du sitzt auf einem, und wenn Du nach oben schaust, kannst Du "
     "bestimmt noch mehr erkennen.");

  AddDetail( ({"dunkelgruener ast", "dunkelgruenen ast an"}),
     "Der dunkelgruene Ast ueber Dir sieht so aus, als koennte er Dich "
     "tragen.");

  AddDetail( ({"hellgruener ast", "hellgruenen ast an"}),
     "Ob der hellgruene Ast ueber Dir Dich tragen wird? Naja, probieren "
     "geht ueber studieren.");

  AddDetail( ({"himmel", "nach oben", "oben"}),
     "Ab und zu kannst Du ein kleines Stueck blauen Himmels durch die "
     "Zweige erkennen. Ausserdem faellt Dir ein dunkelgruener und ein "
     "hellgruener Ast auf.");

  AddDetail( ({"baeume", "nadelbaeume"}),
     "Die Baeume rings um Dich herum sind recht hohe Fichten.");

  AddDetail( ({"fichte"}),
     "Du sitzt auf einer grossen Fichte. Aber bestimmt geht es noch weiter "
     "nach oben.");

  AddDetail( ({"stueck"}),
     "Du siehst nur ein winziges Stueck Himmel ueber Dir.");

  AddDetail( ({"himmels", "alten"}),
     "Frag mich nicht, ich weiss es nicht.");

  // DETAILS END
  

//Sounds:
  AddSound( DEFAULT_SOUND,
     "Du kannst ganz leise den Wind hoeren, wie er seicht durch die Aeste "
     "streicht.\n");
  AddSound( ({"wind", "streichen"}),
     "Es ist ein sehr leises Geraeusch, fast nicht wahrzunehmen.\n");
 
  AddSound( ({"geraeusch"}),
     "Kaum auszumachen.\n");
 

//Smells:

  AddSmell( DEFAULT_SMELL,
     "Du riechst Waldduft.\n");
 
  AddSmell( ({"waldduft"}),
     "Es riecht nach hauptsaechlich nach Harz. Ziemlich typisch fuer einen "
     "Nadelwald.\n");
 
  AddSmell( ({"harz"}),
     "Schwierig zu beschreiben. Irgendwie harzig.\n");
     
 
//Commands:
  AddCmd( ({"kletter","klettere"}) ,  "cmd_klettern");

}

// Funktion klettern:

int cmd_klettern (string str)
{
  int i;

  notify_fail("Du siehst einen hellgruenen und einen dunkelgruenen Ast ueber "
       "Dir. Auf welchen willst Du klettern? Oder willst Du lieber wieder "
       "runter klettern?\n");

     if(member(({"auf dunkelgruenen ast",    //das ist der richtige ast
                 "dunkelgruener ast",
                 "zum dunkelgruenen ast"}),str) > -1)
       {
       	write (BS("Du kletterst auf den dunkelgruenen Ast. Ueber Dir siehst "
       	"Du zwei weitere Aeste, einen abgestorbenen und einen frischen.\n"));
       	
       	say ( TP->name() +" klettert auf einen Ast.\n");
       	
       	this_player()->move(ROOM "room_c5b", M_TPORT|M_NO_SHOW, 
        "nach oben", "klettert", "klettert zu Dir auf den Ast");
       	
       	return 1;
       }
       
     if(member(({"auf hellgruenen ast",    //das ist der falsche Ast, absturz
                 "hellgruener ast",
                 "zum hellgruenen ast"}),str) > -1)
       {
        funktion_fallen();
       	return 1;       
       }  
       
     if(member(({"runter",    //wieder runterklettern
                 "herunter",
                 "hinunter",
                 "nach unten"}),str) > -1)
       {
        write (BS("Du kletterst wieder zurueck auf den Boden.\n"));
        
        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "klettert", "klettert zu Dir auf den Boden");
                
        return 1;
       }  
   
}

  //Funktion fallen, Spieler faellt vom Ast:

int funktion_fallen ()     
{
      int i;
      
      write (BS("Du kletterst auf den hellgruenen Ast. Doch ploetzlich "
        "biegt sich der Ast, als ob er einen eigenen Willen hat, und wirft "
        "Dich auf den Boden zurueck. Du reibst Dir den verknacksten "
        "Knoechel.\n"));
        
        say ( TP->name() +" klettert auf einen Ast. Der Ast scheint jedoch "
        "nicht sonderlich stabil zu sein.\n");
        
        this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
        "nach unten", "faellt", "faellt neben Dir auf den Boden "
        "und verzieht das Gesicht vor Schmerzen");
        
        environment(TP)->AddDetail( ({"knoechel"}),
            "Dein Knoechel ist etwas verknackst, Du kannst ihn jedoch noch "
            "bewegen. Das ist ein gutes Zeichen.\n");
        
        //HP's runter, zwischen 8-12
        i=8 + random(5);
        
        SetProp(P_KILL_NAME,"Ein eigentlich gar nicht so tiefer Sturz");
        
        TP->do_damage(i);
        
        return 1;
}
