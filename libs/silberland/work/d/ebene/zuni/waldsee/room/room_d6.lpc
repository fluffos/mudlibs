#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald


 int kauz_clone;

  create()
  {
  ::create();

  
  SetProp( P_INT_SHORT, "Weg durch den Wald" );
  SetProp( P_INT_LONG, 
     "Rings um Dich herum stehen die Baeume sehr eng zusammen. So dicht, "
     "dass sich ihre Aeste ueber Dir treffen. Fast sieht so aus, als ob Du "
     "durch einen Tunnel gehst. So langsam wird es hier sehr bedrueckend. "
     "Vielleicht solltest Du lieber umkehren, solange Du noch kannst? "
     "Gruenliches Licht laesst die Umgebung unwirklich aussehen." );
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  
  grundzustand();

//Details:
  // DETAILS START

  AddDetail( ({"umgebung"}),
     "Rings um Dich herum stehen die Baeume sehr eng zusammen. So dicht, "
     "dass sich ihre Aeste ueber Dir treffen. Fast sieht so aus, als ob Du "
     "durch einen Tunnel gehst. So langsam wird es hier sehr bedrueckend. "
     "Vielleicht solltest Du lieber umkehren, solange Du noch kannst? "
     "Gruenliches Licht laesst die Umgebung unwirklich aussehen." );

  AddDetail( ({"nerven"}),
     "So langsam liegen Deine Nerven blank. Es ist hier einfach zu unheimlich "
     "um sich wohlzufuehlen. Irgendwie hast Du das Gefuehl, dass gleich "
     "etwas Schlimmes passieren wird.");

  AddDetail( ({"gefuehl"}),
     "Du schauderst.");
     
  AddDetail( ({"stamm", "staemme"}),
     "Viele maechtige Staemme von Fichten sind hier zu sehen.");
 
  AddDetail( ({"licht"}),
     "Alles hier ist in ein gruenliches, mattes Licht getaucht.");

  AddDetail( ({"aeste"}),
     "Die Aeste der Baeume rings um Dich herum wachsen ueber Deinem Kopf "
     "zusammen. Ein grosser Ast faellt Dir besonders auf.");

  AddDetail( ({"kopf"}),
     "Dein Kopf sitzt hoffentlich noch fest auf Deinen Schultern.");

  AddDetail( ({"schultern"}),
     "Du zuckst mit den Schultern.");

  AddDetail( ({"baeume", "baum"}),
     "Um Dich herum stehen die Fichten so dicht zusammen, dass Du Dich rechts "
     "und links vom Pfad nicht zwischen den Baeumen durchzwaengen koenntest. "
     "Du bist also gezwungen, auf dem Weg zu bleiben. Ganz schoen unheimlich, "
     "findest Du.");

  AddDetail( ({"fichten", "rotfichten", "wald"}),
     "Rechts und links vom Pfad stehen die Fichten eng zusammen. Es sind "
     "stattliche Rotfichten, die Dir den Weg in den Wald versperren. Du wirst "
     "wohl auf dem Pfad bleiben muessen. Eine Fichte faellt Dir besonders "
     "auf.");

  AddDetail( ({"fichte", "rotfichte"}),
     "Du betrachtest die Fichte genauer und erkennst in fast zwei Metern Hoehe "
     "einen Schatten auf einem Ast.");

  AddDetail( ({"schatten"}),
     "Du kannst vage einen Umriss im Schatten erkennen.");

  AddDetail( ({"ast"}),
     "Ein stattlicher Ast waechst in zwei Meter Hoehe. Etwas sitzt darauf, "
     "Du kannst jedoch nur einen vagen Umriss erkennen.");

     
  AddDetail( ({"hoehe"}),
     ([0: "Du schaetzt, daß der Ast in ungefaehr zwei Meter Hoehe aus dem "
     "Stamm waechst.",
     "zwerg": "Der Ast ist verdammt hoch!",
     "oger": "Du kannst den Ast bequem erreichen.",
     "troll": "Du koenntest schon fast ueber den Ast hinwegsteigen.",
     "elf": "Du kannst den Ast fast erreichen.",
     "dunkelelf": "Du kannst den Ast fast erreichen.",
     "fee": "Der Ast ist viel zu weit oben fuer Dich.",
     "hobbit": "Du kannst den Ast von hier unten nicht erreichen.",
     "mensch": "Du kannst gerade zum Ast herauflangen."]) );

  AddDetail( ({"himmel", "nach oben"}),
     "Du kannst keinen Himmel entdecken, dazu sind die Aeste ueber Dir zu "
     "dicht.");

  AddDetail( ({"meter"}),
     "Du kannst an einem Meter nichts besonderes erkennen.");

  AddDetail( ({"tunnel"}),
     "Es ist fast so dunkel wie in einem Tunnel. Das wenige Licht hier "
     "hat einen gruenlichen Schimmer.");

  AddDetail( ({"schimmer"}),
     "Er ist gruenlich. Du hast ja wirklich keinen blassen Schimmer!");

  AddSpecialDetail( ({"umriss", "etwas"}),       // Kauz klonen?
     "detail_kauz");

  AddDetail( ({"Boden", "pfad", "waldboden", "weg", "waldweg", 
               "waldpfad", "pfad durch den wald"}),
     "Der Boden ist uebersaet von den abgestorbenen Nadeln der Fichten "
     "rings um Dich herum. Du kannst kaum erkennen, wo der Pfad aufhoert "
     "und wo der Waldboden anfaengt.");

  AddDetail( ({"nadeln"}),
     "Die Nadeln auf dem Boden stammen offensichtlich von den Baeumen rings "
     "um Dich herum.");

  AddDetail( ({"atmen", "metern"}),
     "Nicht wirklich ein interessantes Detail.");

  AddDetail( ({"detail"}),
     "Echt nicht interessant, glaubs mir ruhig.");

  AddDetail( ({"qual"}),
     "Du quaelst Dich durch den Wald. Vielleicht solltest Du ihn lieber "
     "verlassen, und Dich irgendwo verkriechen?");
     
  AddDetail( ({"baeumen"}),
     "Genitiv? Dativ?");
 
  AddDetail( ({"genitiv"}),
     "Der 2. Fall: (wessen?). Bsp: des Tages.");
 
  AddDetail( ({"dativ"}),
     "Der 3. Fall: (wem?). Bsp: dem Tag.");
 
  AddDetail( ({"nominativ"}),
     "Der 1. Fall: (wer oder was?). Bsp: der Tag.");
 
  AddDetail( ({"akkusativ"}),
     "Der 4. Fall: (wen oder was?). Bsp: den Tag.");
 
  AddDetail( ({"fall"}),
     "Knall auf Fall.");
 
  AddDetail( ({"knall"}),
     "Keiner zu hoeren.");
 
  // DETAILS END
  
  
//Sounds

  AddSound(DEFAULT_SOUND, 
     "Die Stille hier zerrt an Deinen Nerven.\n");

  AddSound( ({"stille"}),
     "Es ist so ruhig, dass Du Deinen eigenen Atem hoeren kannst.\n");

  AddSound( ({"atem"}),
     "Einatmen, ausatmen ... einatmen, ausatmen ... \n");


//Smells:
  
  AddSmell(DEFAULT_SMELL,
     "Die stickige Luft macht das Atmen zur Qual. Sie riecht "
     "irgendwie muffig.\n");

  AddSmell( ({"luft"}),
     "Riecht nicht sehr angenehm, irgendwie abgestanden und muffig.\n");


//Exits:
	
  AddExit( "nordwesten", "./room_c5" );
  AddExit( "osten", "./room_e6" );
  
  }

//Commands:
reset()
{
 
  ::reset();
  grundzustand();
    
  }

int grundzustand()
{
  object kauz;	
  
  kauz_clone = 1;              //Kauz darf geklont werden
  
  kauz = present("kauz",TO);
  
  if (kauz && !kauz->InFight()) //wenn beim Reset Kauz da ist,
                                // und sich nicht im Kampf befindet:
  {
  tell_room(TO,"Der Kauz fliegt in die Schatten.\n"); //Ausgabe an Raum
  kauz->remove();                                     //weg mit dem Kauz
  }
  if (kauz && kauz->InFight()) //wenn Kauz da und im Kampf: Kauz bleibt.
  kauz_clone = 0;              //in diesem Fall wird das kauz_clone nicht 
                               //zurueck gesetzt, damit er nicht gleich 
                               //wieder da ist, sondern erst beim naechsten 
                               //reset
}




string detail_kauz(string str)
{
  string s;
  object ob;
 
 
  if(!kauz_clone)        //wenn kauz_clone nicht gesetzt
  {
    return BS("Du betrachtest den Umriss genauer, kannst aber nichts "
    "besonderes erkennen.");
  }
  if(present("\nWALDKAUZ", TO))   //wenn schon ein Kauz vorhanden:
  {
    return "Auf dem Ast sitzt ein Waldkauz und schaut Dich aergerlich an.\n";
  }

  ob=clone_object(NPC "kauz.lpc");   //Clone den Kauz!
  ob->move(TO,M_GO);
  kauz_clone = 0;                  //Kauz kann erstma nichtmehr geklont werden
  return "";
}
