  AddDetail( "muskeln",
       "Du spannst Deine Muskeln an. Woah - hast Du da "
       "etwa wieder einen Hamster eingenaeht??");
       
  AddDetail( "hamster",
       "Du blaest Deine Backen zu Hamsterbackengroesse auf.");

  AddDetail( ({"alten"}),
       "Die grossen Alten findest Du nicht hier.");

  AddDetail( ({"alter"}),
       "An Dein Alter solltest Du Dich aber selbst grade noch so "
