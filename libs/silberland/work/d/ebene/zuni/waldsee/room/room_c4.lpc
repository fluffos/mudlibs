  AddDetail( ({"kopf"}),
       "Du schuettelst Deinen Kopf.");
       
  AddDetail( ({"flanken", "bauch"}),
       "Flanken und Bauch der Blaumeise sind gelblich gefaerbt.");

  AddDetail( ({"sperling", "haussperling"}),
       "Du haelst angestrengt nach einem sperling ausschau, kannst aber "
       "keinen entdecken.");
       
  AddDetail( ({"specht", "buntspecht", "buntspechtmaennchen"}),
       "Du kannst oben in den Baumkronen einen Buntspecht ausmachen. Er hat "
