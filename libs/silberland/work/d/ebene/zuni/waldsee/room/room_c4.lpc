  AddDetail( ({"alzheimer"}),
       "Eine Krankheit, von der Du schon mal gehoert hast. Nur wo?");

  AddDetail( ({"krankheit"}),
       "Krankheiten gibt es viele. Irgendwo hier im Wald wachsen auch "
       "Kraeuter, die gegen so manche Krankheit helfen.");

  AddDetail( ({"kraeuter"}),
       "Hier siehst Du keine. Aber vielleicht gibt es welche in der "
       "Naehe?");

  AddDetail( ({"naehe"}),
       "Das Gegenteil von Ferne.");

  AddDetail( ({"ferne"}),
       "Das Gegenteil von Naehe.");
       
  AddDetail( ({"sonnenlicht", "glitzern"}),
       "Du siehst aus dem Sueden ein Glitzern durch die Baeume und Farne. "
       "Anscheinend befindet sich ein See weiter im Suedwesten.");
       
  AddDetail( ({"staemme", "stamm", "eichenstaemme", "eichenstamm"}),
       "Die Staemme der Eichen sind zwischen 3 und 6 Meter im Durchmesser. "
       "Allein kannst Du wohl keinen davon umfassen.");
       
  AddDetail( ({"durchmesser"}),
       "Pruefend betrachtest Du die dicken Eichenstaemme. Mit einem "
       "Durchmesser von 3 bis 6 Metern sind es wahrlich Prachtexemplare "
