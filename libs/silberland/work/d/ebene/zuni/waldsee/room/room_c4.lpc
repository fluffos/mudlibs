  AddDetail( ({"zeichen"}),
       "Du schaust Dich um, kannst aber kein 'Zeichen' erkennen. Nach "
       "was fuer einem Zeichen hast Du denn gesucht?");
  
  AddDetail ( ({"backen", "hamsterbacken"}),
    "Du pustest Deine Backen auf und laeufst rot an. Besser Du laesst die "
    "Luft wieder raus, bevor Du ohnmaechtig wirst!");

    AddDetail( ({"augen"}),
       "Du faengst an zu schielen.");
              
  AddDetail( ({"durch", "jedes", "hamsterbackengroesse", "jahren", 
       "blaettern", "fuessen", "waschen", "das", "spechtes",
       "gegenteil", "beispiel", "sees", "jemands", "sinne", "kahlschlaegen",
       "massenbestaenden", "nadelwaeldern", "wildschweinen", "mooren",
       "mehrzahl", "schluchtwaeldern", "baeumen", "mauern", "kenntnissen",
       "kopfes", "intensitaeten", "revier", "nahrungssuche", "uebrige",
       "teil", "rueckens"}),
       "Du ueberlegst, ob es wirklich sinnvoll ist, JEDES unsinnige "
       "Detail zu untersuchen. Oder jedes Wort, was grossgeschrieben ist.");

  AddDetail( ({"wort"}),
       "Bist Du etwa ein Script??");

  AddDetail( ({"script", "aufpassen"}),
       "Aufpassen, Aufpassen!");
       
  // DETAILS END
//Sounds beschreiben:

  AddSound(DEFAULT_SOUND, 
       "Es raschelt im Laub, und Du kannst verschiedene Tierstimmen hoeren.");

  AddSound( ({"tierstimmen", "tierstimme"}),
       "Du schliesst Deine Augen und lauschst angestrengt. Du hoerst das "
       "Zwitschern einer Blaumeise und das Klopfen eines Spechtes. Ausserdem "
       "faellt Dir noch ein lautes Rascheln auf.\n");
  
  AddSound( ({"rascheln", "grunzen", "laub"}),
       "Ein lautes Grunzen ertoent auf einmal direkt hinter Dir. Erschreckt "
       "willst Du herumfahren, doch bevor Du Dich versiehst rennt ein "
       "Wildschwein zwischen Deinen Beinen hindurch, wirft Dich fast um, "
       "und verschwindet wieder im Wald.\n");
  
  AddSound( ({"meise", "blaumeise", "zwitschern"}),
       "Hmm... Das hoert sich fast an wie 'tsi-tsi-tsi' - und jetzt ein "
       "'tserretetetet'. Was die Blaumeise aber damit sagen will, bleibt "
       "Dir verschlossen.\n");
       
  AddSound( ({"specht", "buntspecht", "klopfen"}),
       "Du hoerst ein schnelles und lautes Klopfen. Ob der Specht aber auf "
