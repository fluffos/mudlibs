  AddDetail( ({"meter", "zentimeter"}),
       "Das ist eine Masseinheit. 100 Zentimeter sind ein Meter.");

  AddDetail( ({"masseinheit"}),
       "Damit kann man etwas messen.");
       
  AddDetail( ({"prachtexemplar", "prachtexemplare"}),
       "Wahre Prachtexemplare von Eichen stehen rings um Dich herum.");

  AddDetail( ({"abenteuer"}),
       "Du koenntest jetzt eins erleben - oder weiterforschen.");
       
  AddDetail( ({"luft"}),
       "Du atmest tief ein und riechst den Duft von Eichenlaub.");

  AddDetail( ({"duft"}),
       "Probiers mal mit riechen (nur so als Tip).");

  AddDetail( ({"tip", "tips"}),
       "Viele wirst Du aber nicht von mir bekommen.");

  AddDetail( ({"wasseroberflaeche"}),
       "Eine Wasseroberflaeche findet man meistens auf dem Wasser. Ein "
       "See hat zum Beispiel so eine.");

  AddDetail( ({"see", "genaueres", "wasser"}),
