#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald




      create()
      {
        ::create();

     
     SetProp( P_INT_SHORT, "Weg durch den Wald" );
     SetProp( P_INT_LONG, 
        "Du befindest Dich anscheinend in der Naehe eines Sees. Durch die "
        "Staemme der Baeume und die Farne, die hier ueberall "
        "stehen, kannst Du im Suedwesten das Sonnenlicht auf einer "
        "Wasseroberflaeche glitzern sehen. Genaueres erkennst Du von "
        "hier nicht, aber Du koenntest ja naeher rangehen.\n"
        "Du fuehlst Dich recht wohl hier, Das Sonnenlicht scheint Dir auf "
        "den Koerper und waermt Deine Glieder. Auch viel mehr Tiere "
        "scheint es hier zu geben, Du kannst zumindest viele Tierstimmen "
        "hoeren.");
        
     
     SetProp( P_LIGHT, 1 );
     SetProp( P_INDOORS, 0 );
   
//Details beschreiben:   
  // DETAILS START
     
   AddDetail( ({"nach unten", "unten", "boden"}),
	"Du schaust nach unten und siehst den Waldweg. Sieht ziemlich so "
	"aus wie ein gut angelegter Weg, sonst kannst Du aber keine "
	"Besonderheiten erkennen. Um Dich herum ist der Waldboden mit Farnen "
	"aller Arten bedeckt.");
	
   AddDetail( "arten",
        "Was fuer Arten meinst Du?");
	
   AddDetail( ({"farne", "farn", "farnarten", "arten von farnen"}),
        "Du kannst mit Deinen bescheidenen Kenntnissen Dornfarn, "
        "Adlerfarn und Hirschzunge ausmachen, aber bestimmt gibt "
        "es noch viele andere Arten hier.");

  AddDetail( ({"kenntnisse"}),
       "Deine sind viel zu bescheiden.");
       
   AddDetail( "dornfarn",
        "Dieser Farn ist ziemlich anspruchslos und waechst daher verbreitet "
        "in Laub- und Nadelwaeldern sowie in Mooren auf sauren, frischen "
        "und nassen, torfig-humosen Boeden vor allem in der Ebene und im "
        "niederen Gebirge.");

  AddDetail( ({"moor", "moore"}),
       "Du befindest Dich gottseidank nicht im Moor.");

  AddDetail( ({"boeden"}),
       "Das ist die Mehrzahl von 'Boden'.");

  AddDetail( ({"ebene"}),
       "Stimmt, Du bist hier auf einer Ebene.");

  AddDetail( ({"gebirge", "berge"}),
       "Du kannst keine Berge um Dich herum sehen. Das heisst aber nicht, "
       "dass auch keine da sind.");
       
  AddDetail( "wald",
        "Du befindest Dich hier im Wald. Das hohe Alter ist den Baeumen "
        "anzusehen, sie sind sehr hoch und maechtig.");
   
   AddDetail( "tiere",
        "Du schaust Dich um, kannst aber keine Tiere entdecken. Versuch es "
        "doch mal mit einem anderen Deiner Sinne.");

  AddDetail( ({"sinn"}),
       "Irgendjemand hat mal etwas von einem 7. Sinn gesprochen. Was er "
       "damit wohl meinte?");

  AddDetail( ({"irgendjemand"}),
       "Irgendein Jemand.");

  AddDetail( ({"jemand"}),
       "Einer von den Jemands wird es wohl gewesen sein.");
       
  AddDetail( ({"glieder", "arm", "arme", "bein", "beine"}),
       "Arme, Beine ... scheint noch alles da zu sein.");

  AddDetail( ({"grunzen"}),
       "Versuchs mal mit lauschen.");
       
   AddDetail( "adlerfarn",
        "Dieser maechtige und besonders schoene Farn waechst verbreitet in "
        "lichten Laub- und Nadelwaeldern und auf Kahlschlaegen, besonders "
        "auf sauer-humosen, kalkarmen und wechselfeuchten Sand- und "
        "Lehmboeden. Tritt oft in ausgedehnten Massenbestaenden auf. "
        "Ausserdem lockert er den Boden und schuetzt so junge Waldkulturen "
        "vor Frost, Sonne und Wind. Er ist daher sehr nuetzlich, nur bei "
        "allzu reichlichen Vorkommen wirkt er schon etwas verdaemmend. "
        "Die Wurzeln enthalten Staerke und werden von Wildschweinen gern "
        "genommen; sie koennen aber auch dem Menschen im Notfall als "
        "Nahrung dienen.");

  AddDetail( ({"nahrung"}),
       "Dir wuerde schon ein gutes Fruehstueck reichen.");

  AddDetail( ({"sand"}),
       "Kein Sand zu sehen.");

  AddDetail( ({"waldkultur", "waldkulturen"}),
       "Wenn Baeume nach Plan angepflanzt werden, spricht man von "
       "Waldkulturen.");

  AddDetail( ({"plan"}),
       "Da hab ich auch keinen Plan von.");
       
  AddDetail( ({"notfall"}),
       "Hoffentlich passiert Dir kein Notfall.");

  AddDetail( ({"menschen"}),
       "Viele Menschen leben in Midas.");

  AddDetail( ({"midas"}),
       "Midas duerfte so ziemlich die groesste Stadt in der Naehe sein.");

  AddDetail( ({"stadt"}),
       "Was eine Stadt ist, solltest Du aber wissen.");

  AddDetail( ({"staerke"}),
       "Nicht zu verwechseln mit Kraft.");

  AddDetail( ({"wurzeln"}),
       "Wurzeln sind am unteren Ende von Pflanzen.");

  AddDetail( ({"pflanzen"}),
       "Du siehst hier viele Eichen und ein paar Farne.");

  AddDetail( ({"ende"}),
       "Du faengst laut an zu singen: 'Alles hat ein Ende, nur die Wurst "
       "hat zwei....");

  AddDetail( ({"wurst"}),
       "Eine Wurst zum Essen?");

  AddDetail( ({"essen"}),
       "Essen ist Nahrung.");

  AddDetail( ({"vorkommen"}),
       "Das kann schon mal vorkommen.");

  AddDetail( ({"wind"}),
       "Du kannst kaum Wind spueren.");

  AddDetail( ({"frost"}),
       "Fuer Frost ist es zu warm.");

  AddDetail( ({"kahlschlag"}),
       "Die Baeume stehen hier recht dicht zusammen, von einem "
       "Kahlschlag kann kaum die Rede sein.");

  AddDetail( ({"laubwaelder", "laubwald", "nadelwaelder", "Nadelwald"}),
       "Du befindest Dich hier in einem Laubwald. Das ist an den Eichen "
       "eigentlich auch unschwer zu erkennen.");

  AddDetail( ({"sandboeden", "sandboden", "lehmboeden", "lehmboden"}),
       "Um die genaue Zusammensetzung des Bodens zu untersuchen muesstest "
       "Du wohl graben - dazu bist Du aber viel zu faul.");

  AddDetail( ({"zusammensetzung"}),
       "Na das woraus es besteht!");

  AddDetail( ({"massenbestaende"}),
       "Wenn sehr viel von etwas auf einem Haufen waechst, spricht man von "
       "Massenbestaenden.");

  AddDetail( ({"haufen"}),
       "Du willst hier doch wohl keinen Haufen machen, oder?");
       
   AddDetail( "hirschzunge",
        "Dieser kalkliebende Farn waechst in steinigen, feuchten "
        "Schluchtwaeldern auf naehrstoffreichen Boeden, an schattigen Mauern "
        "und auch in hohlen Baeumen.  Die Blaetter wurden frueher als "
        "Wundheilmittel verwendet.");

  AddDetail( ({"schluchtwaelder"}),
       "Du bist hier in einem Eichenwald.");

  AddDetail( ({"eichenwald"}),
       "Ein Wald aus Eichen.");

  AddDetail( ({"wundheilmittel"}),
       "Hilft bei Verletzungen.");

  AddDetail( ({"verletzung", "verletzungen"}),
       "Sei froh, dass Du keine hast.");
       
  AddDetail( ({"wirklichkeit", "einbildung", "phantasie"}),
       "Was ist schon wirklich und was Einbildung oder Phantasie?");

  AddDetail( ({"mauer"}),
       "Hier steht keine Mauer.");
       
   AddDetail( ({"himmel", "nach oben"}),
        "Du blickst nach oben, und siehst ueber Dir den strahlend blauen "
        "Himmel. Die Sonne scheint warm auf Dich herab, und Du fuehlst Dich "
        "fast geborgen hier.");
   
   AddDetail( "sonne",
        "Die Sonne steht mitten am Himmel, und ihre Waerme ist Dir sehr "
        "willkommen.");

  AddDetail( ({"waerme"}),
       "Sehr angenehm.");
       
   AddDetail( ({"weg", "waldweg"}),
        "Du stehst auf einem gut befestigten Waldweg aus festgetrampelter "
        "Erde und Schotter.");
   
   AddDetail( ({"erde", "schotter"}),
        "Erde und Schotter, von vielen Fuessen festgetrampelt, bilden die "
        "Grundlage fuer den Waldweg, auf dem Du Dich befindest.");
   	
   AddDetail( "besonderheiten",
        "Welche Besonderheiten meinst Du?");
   	
   AddDetail( "waldboden",
        "Der Waldboden rechts und links vom Weg ist ueber und ueber bedeckt "
        "mit Farnen unterschiedlicher Arten. Dazwischen und darunter liegt "
        "das abgefallene Laub der Baeume.");
	
   AddDetail( "grundlage",
        "Du wuenschtest, Du haettest ein besseres Fruehstueck zu Dir "
        "genommen - eine gute Grundlage ist immer wichtig, wenn man sich ins "
        "Abenteuer stuerzt.");

  AddDetail( ({"fruehstueck"}),
       "Hmm... Ruehrei mit Speck waere jetzt fein...");

  AddDetail( ({"ruehrei", "speck", "ruehrei mit speck"}),
       "*schmatz*");
       
  AddDetail( "koerper",
        "Nimm am besten einen Spiegel, wenn Du Dich genauer anschaun "
        "moechtest.");

  AddDetail( ({"spiegel"}),
       "Leider ist hier kein Spiegel.");
       
  AddDetail( "fuesse",
        "Wie waere es mal wieder mit Waschen?");
        
  AddDetail( ({"laub", "eichenlaub", "blaetter", "eichenblaetter"}),
	"Das Laub besteht hauptsaechlich aus den abgeworfenen Blaettern der "
	"Eichen, die hier stehen. Es ist noch vom letzten Herbst "
	"uebriggeblieben - das liegt wohl daran, dass Eichenlaub nur "
	"sehr langsam verrottet. Der Duft, der von den Blaettern "
	"herruehrt, ist recht angenehm. Du atmest tief den Waldgeruch ein "
	"und fuehlst Dich wohl.");

  AddDetail( ({"herbst"}),
       "Der Herbst ist eine schoene Jahreszeit.");

  AddDetail( ({"jahreszeit", "jahreszeiten"}),
       "Jede Jahreszeit hat ihre schoenen Seiten.");

  AddDetail( ({"seiten", "seite"}),
       "Welche Seiten meinst Du?");

  AddDetail( ({"baeume", "eichen", "baum", "eiche", "anblick"}),
       "Die Eichen sind gerade gewachsene, wuchtige Exemplare ihrer Gattung. "
       "Sie stehen hier bestimmt schon seit hunderten von Jahren, und sehen "
       "kerngesund aus. Eine Ruhe ueberkommt Dich bei diesem Anblick der "
       "Eichen, die so wie keine andere Baumart fuer Beharrlichkeit und "
       "Ausdauer stehen. Kraft stroemt Durch Deine Muskeln und Du fuehlst "
       "Dich einfach grossartig.");
  
  AddDetail( ({"baumarten", "baumart"}),
       "Hier stehen ausschliesslich Eichen. Aber vielleicht stehen nicht "
       "weit entfernt auch andere Baeume?");
       
  AddDetail( "beharrlichkeit",
       "Zum Erforschen aller Details wirst Du Beharrlichkeit brauchen.");
       
  AddDetail( "ausdauer",
       "Zum Erforschen aller Details wirst Du Ausdauer brauchen.");
  
  AddDetail( ({"detail"}),
       "Ja, stimmt: 'Detail' ist auch ein Detail :-)");
  
  AddDetail( ({"details"}),
       "Ja, stimmt: 'Details' ist auch ein Detail :-)");

  AddDetail( ({"forschen", "erforschen", "forscherpunkt", "forscherpunkte"}),
