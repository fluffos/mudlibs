 //Smells:
 
  AddSmell( DEFAULT_SMELL,
       "Du atmest tief ein und riechst den Duft von Eichenlaub.\n");
       
  AddSmell( ({"eichenlaub", "laub", "duft"}),
       "Es riecht schon etwas verrottet, aber keineswegs unangenehm.\n");
  
  AddSmell( "waldgeruch",
       "Pruefend schnupperst Du. Der Duft vom Eichenlaub ist vorherrschend, "
       "es riecht aber nicht stickig sondern eher klar und frisch.\n");
       
//commands:
  AddCmd( ({ "mach", "mache"}), "cmd_haufen");       
  
//Ausgaenge:
  
  AddExit( "suedwesten", "./room_b5" );
  AddExit( "norden", "./room_c3" );

}

int cmd_haufen (string str)
{
  notify_fail("Was willst Du machen??\n");
  
  if(!str || str == "") return 0;
  if(!(str == "haufen")) return 0;	
  
  write (BS("Du schaust Dich verstohlen um. Da Du das Gefuehl hast, beobachtet "
  "zu werden machst Du doch lieber keinen Haufen hier hin. Waere ja auch eine "
  "ganz schoene Schweinerei!"));
  
  tell_room(TO, BS(CAP_TPN+" schaut sich verstohlen um. Was "+capitalize(TP->QueryPronoun(WER))+
  " wohl wieder vorhat?\n"), ({TP}) );
  
  return 1;
}