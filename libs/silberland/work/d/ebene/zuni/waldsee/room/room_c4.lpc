  AddDetail( ({"exemplare", "exemplar", "gattung"}),
       "Wirklich tolle Exemplare der Gattung 'Eiche' siehst Du hier "
       "um Dich herum.");
  
  AddDetail( "baumkronen",
       "Die Baumkronen sind sehr weit ueber Dir. Ohne Hilfsmittel wirst "
