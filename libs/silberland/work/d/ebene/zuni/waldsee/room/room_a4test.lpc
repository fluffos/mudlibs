#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <moredef.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald

string *getrunken;
int smon_clone;


      create()
      {
        ::create();

     
   SetProp( P_INT_SHORT, "Weg am See" );
   SetProp( P_INT_LONG, 
      "Du stehst auf einem Pfad am See. Es ist ein wirklich "
      "schoener Tag, um hier spazieren zu gehen. Die Sonne scheint Dir "
      "warm aufs Gesicht und Du atmest die reine frische Luft in tiefen "
      "Zuegen ein. Der Pfad endet hier." );

   grundzustand(); //erstma resetten 

     SetProp( P_LIGHT, 1 );
     SetProp( P_INDOORS, 0 );

//Details beschreiben:
  // DETAILS START

  AddDetail( ({"himmel"}),
       "Keine Wolke ist am Himmel zu sehen, und mittendrin die grosse Sonne, "
       "die Dich mit ihren Strahlen waermt.");

  AddDetail( ({"strahlen"}),
     "Die Strahlen der Sonne scheinen Dir warm aufs Gesicht. Fuehlt sich "
     "irgendwie unheimlich angenehm an.");

  AddDetail( ({"wolke", "wolken"}),
     "Du schaust in den Himmel und blinzelst in die Sonne. Wolken kannst Du "
     "keine entdecken.");

  AddDetail( ({"sonne"}),
       "Die Sonne steht mitten am Himmel. Sie waermt Dich und am liebsten "
       "moechtest Du Deine Kleider vom Leib reissen, im See eine Runde "
       "schwimmen gehen und Dich dann in die Sonne legen.");

  AddDetail( ({"tag"}),
     "Heute ist wirklich ein schoener Tag. Du fuehlst Dich hier auch richtig "
     "wohl.");

  AddDetail( ({"leib"}),
     "Damit ist Dein Koerper gemeint.");

  AddDetail( ({"koerper"}),
     "Deinen Koerper solltest Du eigentlich schon kennen.");

  AddDetail( ({"kleider"}),
     "Na das was Du so an hast. Reiss sie Dir doch einfach vom Leib, wenn Dir "
     "danach ist!");
     
  AddDetail( ({"gesicht"}),
       "Wenn Du Dein Gesicht anschauen moechtest, schaust Du besser in einen "
       "Spiegel. So kannst Du nur, wenn Du schielst, Deine Nasenspitze "
       "erkennen.");

  AddDetail( ({"nasenspitze", "nase"}),
       "Du faengst an zu schielen. Pass bloss auf, dass Deine Augen nicht so "
       "stehenbleiben!");

  AddDetail( ({"augen"}),
       "Dazu brauchst Du nun wirklich einen Spiegel.");

  AddDetail( ({"spiegel"}),
       "Leider ist keiner hier.");
       
  AddDetail( ({"pfad", "weg"}),
       "Du kannst nichts besonderes erkennen. Es ist ein einfacher Weg aus "
       "Sand und Erde mit ein paar Kieselsteinen drin. Der Pfad endet "
       "hier, es geht nur im Suedosten weiter.");

  AddDetail( ({"kieselsteine", "steine", "kiesel", "stein"}),
       "Ganz ordinaere Kieselsteine. Du kannst ja versuchen, einen ueber das "
       "Wasser huepfen zu lassen.");

  AddDetail( ({"wasser", "see", "waldsee"}),
       "Du schaust aufs Wasser: eine grosse spiegelnde Flaeche liegt vor "
       "Dir. Auf der anderen Seite des Sees kannst Du nicht viel "
       "erkennen, dazu ist das andere Ufer zu weit entfernt.");
 
  AddDetail( ({"ufer"}),
       "Meinst Du das diesseitige oder das jenseitige Ufer?");

  AddDetail( ({"diesseitiges ufer"}),
     "Das ist das Ufer, wo Du Dich befindest.");

  AddDetail( ({"jenseitiges ufer"}),
     "Du schaetzt die Entfernung zum jenseitigen Ufer ab und kommst zu dem "
     "Schluss, doch besser aussen herum zu laufen anstatt "
     "hindurchzuschwimmen.");

  AddDetail( ({"entfernung"}),
     "Viel zu weit.");

  AddDetail( ({"schluss"}),
     "Jetzt ist Schluss.");

  AddDetail( ({"sand"}),
       "Eigentlich auch nichts anderes als vertrocknete feine Erde.");

  AddDetail( ({"erde"}),
       "Die Erde ist ueberall um Dich herum auf dem Boden.");

  AddDetail( ({"boden"}),
       "Der Boden befindet sich unter Dir. Wenn dem nicht so waere, waere "
       "auch etwas sehr komisches passiert.");

  AddDetail( ({"seite", "flaeche"}),
     "Nichts besonderes zu sehen.");

  AddDetail( ({"zuegen", "kieselsteinen", "sees", "der", "isser", "wieder",
       "runde"}),
       "Du wirst mir unheimlich. Untersuchst Du wirklich jedes unsinnige "
       "Detail?");

  AddDetail( ({"detail"}),
       "Eine Scriptfalle ruft: DA ISSER WIEDER, DER SCHLINGEL!!");

  AddDetail( ({"scriptfalle", "schlingel"}),
     "Magierin Zuni teilt Dir mit: Das solltest Du jetzt wirklich besser "
     "lassen!");

  AddDetail( ({"zuni", "magierin"}),
     "Magierin Zuni wacht hier.");

  // DETAILS END


//Sounds beschreiben:
  AddSound(DEFAULT_SOUND, 
     "Nichts zu hoeren. Eine wahrhaft himmlische Stille.\n");

  AddSound( ({"stille", "himmlische stille"}),
     "Es ist so ruhig, dass Du Deinen Herzschlag hoeren kannst.\n");

  AddSound( ({"herzschlag", "herz"}),
     "Dein Herz schlaegt noch, gottseidank!\n");


//Smells beschreiben:

  AddSmell(DEFAULT_SMELL,
     "Du atmest die frische Luft ein und fuehlst Dich wie neu geboren.\n");

  AddSmell( ({"luft", "frische luft"}),
     "Einfach herrlich!\n");

  AddItem (NPC "mgelse", REFRESH_DESTRUCT);


//Ausgaenge:

   AddExit( "suedosten", "./room_b5" );

//Commands beschreiben:

   AddCmd( ({ "reiss", "reisse"}), "cmd_reissen");
   AddCmd( ({ "schwimm", "schwimme"}), "cmd_schwimmen");
   AddCmd( ({ "lass", "lasse"}), "cmd_huepfen");
   AddCmd( ({ "trink", "trinke"}), "cmd_trinken");
   
}

reset()
{
 
  ::reset();
  grundzustand();
    
  }
  

int grundzustand()
{
 object smonster;
 
 getrunken=({});
 	
  
  smon_clone = 1;             
  
  smonster = present("sumpfmonster",TO);
  
  if (smonster && !smonster->InFight()) 
  {
  tell_room(TO,"Das Sumpfmonster zerfliesst zu Dreck.\n"); 
                                                      
  smonster->remove();                                     
  }

  if (smonster && smonster->InFight())
  {
  smon_clone = 0;              
  }                            
                               
}




int cmd_trinken (string str)
{
  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser" || str == "wasser aus see" || str == "aus see")) return 0;	

  if(member(getrunken, getuuid(TP)) == -1)
  {
    if(TP->drink_soft(10)) 
    {
      TP->AddHp(15);
      //getrunken += ({TP->name()});
      write(BS("Du trinkst einen Schluck Wasser aus dem See und fuehlst Dich besser. "
               "Sehr gut hat das Wasser aber nicht geschmeckt."));
      say(BS(CAP_TPN + " trinkt einen Schluck Wasser aus dem See."));
     getrunken += ({getuuid(TP)});
    }
    return 1;
  }
  write(BS("Irgendwie schmeckte das Wasser nicht so gut, wie Du erwartet hattest. "
           "Vielleicht schmeckt es an einer anderen Stelle besser?"));
  return 1;
}


int cmd_huepfen (string str)
{
  int i;
  string meldung;
  object ob;
  
  notify_fail("Was willst Du worueber huepfen lassen?\n");
  
  if(!str || str == "") return 0;
  if(!(str == "stein ueber wasser huepfen" ||
       str == "steinchen ueber wasser huepfen" ||
       str == "stein uebers wasser huepfen" ||
       str == "kiesel uebers wasser huepfen" ||
       str == "kiesel ueber wasser huepfen" ||
       str == "kieselstein ueber wasser huepfen" ||
       str == "kieselstein uebers wasser huepfen" ||
       str == "steinchen uebers wasser huepfen")) return 0;
  
  i=1 + random(7);
  if(!TP->do_exhaust(75,0))return 1;
  
  switch (i)
  {
     case 0..2:
     meldung = "Das ist ja nicht wirklich weit.";
     break;
     case 3..5:
     meldung = "Das ist ganz ordentlich.";
     break;
     case 6..8:
     meldung = "Wahnsinn! Superwurf!";
     break;
  }
   
  write (BS("Du laesst den Kiesel "+ i +" Meter weit ueber das Wasser huepfen. "+ meldung));
  
  tell_room(TO, BS(CAP_TPN+" laesst einen Kiesel "+i+" Meter weit ueber das Wasser "
             "huepfen. "+meldung), ({TP}) );
  
  i=1 + random(10);
  if (i==3)
  {
  write (BS("Die Wasseroberflaeche kommt in Bewegung. Du fuehlst Dich unwohl. Langsam steigt "
            "etwas aus dem Wasser und kommt auf Dich zu. Es ist ein grauenvolles "
            "Sumpfmonster!"));
  
  tell_room(TO, BS("Die Wasseroberflaeche kommt in Bewegung. Ob das mit dem Steinewerfen "
  	    "wirklich so eine gute Idee war? Vielleicht haette "+CAP_TPN+" das doch lieber "
  	    "sein gelassen, denn nun erscheint ein grauenvolles Sumpfmonster und kommt auf "
  	    +CAP_TPN+"zu!"), ({TP}) );
  	    
  ob=clone_object(NPC "smonster.lpc");
  ob->move(TO,M_GO);
  smon_clone=0;
  
  }
  return 1;
  
}


int cmd_reissen(string str)
  {
int y;
   int i;
   object *player_armour;
   object player_weapon;
   
   notify_fail("Was willst Du wovon reissen?\n");
   if(!str || str == "") return 0;
   if(!(str == "kleider vom leib" || str == "alle kleider vom leib" || 
        str == "dir kleider vom leib" || 
        str == "dir alle kleider vom leib")) return 0;
   tell_object(TP,"Du faengst an, Dir alle Kleider auszuziehen. Doch bei "
        "der Unterhose angekommen faellt Dir ein kleines Schild auf:\n"
        "         _______________________\n"
        "         |                     |\n"
        "         |    FKK verboten!    |\n"
        "         |_____________________|\n"
        "                   ||\n"
        "                   ||\n\n"
        "Du schmollst und packst Deine Sachen wieder zusammen.\n");
   
   tell_room(TO, BS(CAP_TPN+" zieht sich auf einmal splitterfasernackt aus - "
                    "Du kannst Dich nur wundern."), ({TP}) );
 
 
   player_armour = TP->QueryProp(P_ARMOURS) - ({ 0 });
   
   player_weapon = TP->QueryProp(P_WEAPON);
   
   if(player_weapon)
     player_weapon->DoUnwield(1);
     
   y = sizeof(player_armour);
   
   for(i=0;i<y;i++)
    {
      if(player_armour[i]->QueryProp(P_ARMOUR_TYPE)!=AT_MISC) 
        player_armour[i]->DoUnwear(1);
    }
   return 1;
  }

int cmd_schwimmen(string str)
{
   notify_fail("Worin willst Du schwimmen?\n");
   if (str=="in see" || str=="im see")
   {
   write (BS("Froehlich huepfst Du in den See. Das Wasser ist herrlich erfrischend "
             "und Du schwimmst gleich ein paar Runden. Nach einem kleinen Weilchen "
             "wird es doch langsam kuehl und zu steigst wieder aus dem See heraus. "
             "Bibbernd schuettelst Du Dich um wieder trocken und warm zu werden."));
             
   tell_room(TO, BS(CAP_TPN+" huepft so wie er ist in den See! "+capitalize(TP->QueryPronoun(WER))+
             " schwimmt "
             "ein paar Runden. Das Wasser scheint jedoch recht kalt zu sein. "
             +CAP_TPN+" steigt bibbernd und mit blauen Lippen aus dem Wasser "
             "und schuettelt sich, dass die Tropfen nur so fliegen."), ({TP}) );
   return 1;
   }
return 0;
}