#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

  inherit ROOM "std_room.lpc";       //Standard-Raum fuer den Wald

  int funktion_fallen ();
  int specht_clone;
  void specht_message();
  create()
  {
  ::create();

     
  SetProp( P_INT_SHORT, "Auf einem Baum" );
  SetProp( P_INT_LONG, 
     "Du sitzt in der ausladenden Baumkrone der Foehre. Die Aeste rings "
     "um Dich herum sind so dicht, dass Du fast gar nicht herunterfallen "
     "kannst. Ein breiter langer Ast von der Fichte nebenan reicht hier "
     "herueber. Auf ihm kannst Du die Baumkrone wieder verlassen." );
        
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_HIDE_EXITS, 1);
  
//  SetProp(P_FUNC_MSG,({"specht_message"}) );

    grundzustand();
    
//Details 
  // DETAILS START
  
  AddDetail( ({"himmel", "nach oben", "oben"}),
     "Ab und zu kannst Du ein groesseres Stueck blauen Himmels durch die "
     "Aeste erkennen.");
 
  AddDetail( ({"boden"}),
     "Der Boden ist viel zu tief unter Dir, als dass Du etwas Genaueres "
     "erkennen kannst.");
 
  AddDetail( ({"baumkrone", "krone"}),
     "Du sitzt in der Baumkrone der Foehre. Viel hoeher geht es hier "
     "nicht.");
     
  AddDetail( ({"foehre"}),
     "Du sitzt auf der maechtigen Foehre. Sie hat alles, was man sich an "
     "einer Foehre wuenschen kann: Aeste, Stamm, Nadeln, und alles auch am "
     "richtigen Fleck.");
     
  AddDetail( ({"glitzern"}),
     "Komisch - von unten hast Du noch ein Glitzern hier irgendwo gesehen. "
     "Du kannst es aber hier nicht wiederfinden. Vielleicht hat sich das "
     "glitzernde Etwas versteckt?");
    
  AddDetail( ({"versteck"}),
     "Als Versteck wuerde sich hier ein Astloch anbieten.");
     
  AddDetail( ({"etwas"}),
     "Was das wohl sein mag?");
     
  AddDetail( ({"nadeln"}),
     "Das ist so eine Eigenart von Nadelbaeumen, dass sie Nadeln besitzen.");
 
  AddDetail( ({"eigenart"}),
     "Das ist den Nadelbaeumen so eigen.");
 
  AddDetail( ({"nadelbaeume"}),
     "Davon stehen hier eine Menge, schliesslich ist das hier ein "
     "Nadelwald.");
  
  AddDetail( ({"nadelwald"}),
     "Viele viele Nadelbaeume auf einem Haufen nennt man Nadelwald.");
 
  AddDetail( ({"haufen"}),
     "Du willst hier doch wohl keinen Haufen machen?!?");
 
  AddDetail( ({"menge"}),
     "Ganz schoen viele.");
 
  AddDetail( ({"fleck"}),
     "Keiner zum wegputzen, wenn Du das jetzt vorhaben solltest.");
 
  AddDetail( ({"stamm"}),
     "Ein praechtiger Stamm mit rauher Rinde.");
  
  AddDetail( ({"rinde"}),
     "Die Rinde ist rau und mit Astloechern uebersaet.");
 
  AddDetail( ({"astloecher"}),
     "Hier gibt es so einige. Eines faellt Dir aber besonders auf.");
 
  AddDetail( ({"astloch", "loch"}),
     "Du siehst ein recht grosses Astloch. Wahrscheinlich hat ein Specht es "
     "zu seiner Wohnhoehle vergroessert. Irgendetwas scheint darin zu sein.");
  
  AddDetail( ({"irgendetwas"}),
     "Greif doch rein und schau nach.");
 
  AddDetail( ({"wohnhoehle", "hoehle"}),
     "In so einer koennte ein Specht sitzen.");
 
  AddDetail( ({"aeste"}),
     "Ziemlich viele Aeste gibt es um Dich herum. Auf einem sitzt Du gerade, "
     "andere wachsen ueber und unter Dir, und ein Ast reicht von der Fichte "
     "hier herueber. Ueber ihn kannst Du bestimmt auch wieder "
     "zurueckbalancieren.");
 
  AddDetail( ({"fichte"}),
     "Eine grosse Fichte steht hier neben der Foehre, auf der Du sitzt. Du "
     "bist die Fichte heraufgeklettert, deswegen solltest Du sie eigentlich "
     "kennen!");
 
  AddDetail( ({"ast"}),
     "Hier ist alles voller Aeste. Auf einem sitzt Du gerade, ein anderer, "
     "grosser Ast, reicht von der Fichte hier herueber. Auf ihm kannst Du "
     "zur Fichte zurueckbalancieren.");
 
  AddDetail( ({"baum"}),
     "Du sitzt auf einem. Es ist eine praechtige Foehre.");
 
  AddDetail( ({"stueck"}),
     "Du kannst hier etwas mehr vom Himmel erkennen.");
 
  AddDetail( ({"astloechern", "himmels", "nadelbaeumen", "genaueres"}),
     "Uninteressant.");
     

AddRoomMessage( ({""}), 240, "specht_message");

  // DETAILS END
  
//Sounds:
  AddSound( DEFAULT_SOUND,
     "Du kannst ganz leise den Wind hoeren, wie er seicht durch die Aeste "
     "streicht.\n");
     
  AddSound( ({"wind", "streichen"}),
     "Es ist ein sehr leises Geraeusch, fast nicht wahrzunehmen.\n");
 
  AddSound( ({"geraeusch"}),
     "Kaum auszumachen.\n");
 

//Smells:

  AddSmell( DEFAULT_SMELL,
     "Du riechst Waldduft.\n");
 
  AddSmell( ({"waldduft"}),
     "Es riecht nach hauptsaechlich nach Harz. Ziemlich typisch fuer einen "
     "Nadelwald.\n");
     
  AddSmell( ({"nadelwald"}),
     "Es riecht harzig, ganz wie man es von einem Nadelwald erwarten kann.\n");
 
  AddSmell( ({"harz"}),
     "Schwierig zu beschreiben. Irgendwie harzig.\n");

//Commands:
   AddCmd( ({"balancier","balanciere"}) ,     "cmd_balance");
   AddCmd( ({"greif","greife"}),              "cmd_greifen");


}

//Funktionen:

reset()
{
 
  ::reset();
  grundzustand();
    
  }

int grundzustand()
{
  object specht;	
  
  specht_clone = 1;              //Specht darf geklont werden
  
  specht = present("specht",TO);
  
  if (specht && !specht->InFight()) //wenn beim Reset Specht da ist,
                                // und sich nicht im Kampf befindet:
  {
  tell_room(TO,"Der Specht huepft zurueck in seine Hoehle.\n"); 
                                                      //Ausgabe an Raum
  specht->remove();                                     //weg mit dem Specht
  }

  if (specht && specht->InFight()) //wenn Specht da und im Kampf: Specht bleibt.
  {
  specht_clone = 0;              //in diesem Fall wird das specht_clone nicht 
  }                             //zurueck gesetzt, damit er nicht gleich 
                               //wieder da ist, sondern erst beim naechsten 
                               //reset
}


specht_message()
{
object specht_tell;

specht_tell = present ("specht",TO);

   if (specht_tell && !specht_tell -> InFight())
   {
    tell_room(TO,(BS("Der Specht huepft froehlich herum.\n")));
    }
   
   if (!specht_tell && specht_clone)
   {
   tell_room(TO, (BS("Ein Specht lugt aus seiner Wohnhoehle, pickt ein bisschen an einem Ast herum und "
                     "verschwindet wieder.\n")));
    }
   
   return 1;
}

int cmd_greifen (string str)
{
//  object eschluessel;
  object ob;
  object ob2;
  
  notify_fail("Wohin willst Du greifen?\n");
  
  if(present("specht"))
  {
    write (BS("Du versuchst, in das Astloch zu greifen. Der Specht hackt "
              "Dir in die Hand.\n"));
    TP->do_damage(10);
    
    return 1;
  }
  
  if(!specht_clone)        //wenn specht_clone nicht gesetzt
  {
    write (BS("Du greifst in das Astloch, es ist aber nichts zu "
              "ertasten.\n"));
    
    return 1;
  }
  
  if(deep_present("AW_E_SCHLUESSEL",TP))
  {
    write (BS("Du greifst in das Astloch.\n"
    "Der Specht hackt Dir veraergert in den Finger, bleibt aber in seiner "
    "Hoehle hocken.\n"));
    
    TP->do_damage(15);
       
    return 1;
  }
  
  if(member(({"in astloch", "in hoehle", "in wohnhoehle", 
              "in das astloch", "in die hoehle", "in die wohnhoehle"}),str) > -1)
  {
    write (BS("Du greifst in das Astloch. Der Specht pickt Dir in die "
               "Hand.\n"));
     
    TP->do_damage(5);

    ob=clone_object(NPC "specht.lpc");   //Clone den Specht!
    ob->move(TO,M_GO);
       
    ob2=clone_object(WEAPON "zahnstocher.lpc");  //Zahnstocher clonen
    ob2->move(ob,M_NOCHECK);                   //und dem Specht geben
    write_file(LOG "stocher.log", sprintf("%s: %s hat den Stocher.\n", ctime(time()),CAP(getuid(TP))));
    specht_clone = 0;           //Specht kann erstma nichtmehr geklont werden
     
    return 1;
  }
  return 0;
}




int cmd_balance (string str)
{
  int i;
  int dex;
  
  notify_fail("Wohin willst Du balancieren?\n");
  
  if(member(({"hinueber",    
              "herueber",
              "zurueck",
              "rueber",
              "zur fichte",
              "fichte"}),str) > -1)
   {
  	
    
     if(present("\nbalancierstange",TP)!=TP->QueryProp(P_WEAPON) &&
        present("\nbalancierstange",TP) )
       {
         write (BS("Wenn Du schon eine Balancierstange hast, solltest Du sie "
         "aber auch zuecken.\n"));
         
         return 1;
       }
       
     if(present("\nbalancierstange",TP)==TP->QueryProp(P_WEAPON))
       {
       	// write (BS("nu wird balanciert\n"));
       	 
       	 dex = TP->QueryAttribute(A_DEX) + 20;
       }
       
       	 dex = dex + random(101-dex);
       	 switch(dex)
       	 {
       	   case 0..50:
       	   //runterfallen, hp's verlieren
       	   write (BS("Du balancierst vorsichtig auf dem Ast Richtung Fichte. "
       	   "Uah, Du kommst aus dem Gleichgewicht und faellst!"));
       	   funktion_fallen();
       	   return 1;
       	   break;
       	   //write(BS("text"));
       	   case 51..90:
       	   //spieler schafft es rueber, aber fallen -> riesenschreck ->
       	   //spieler verliert ein paar hps und ein paar mps
       	   write (BS("Du balancierst vorsichtig auf dem Ast Richtung "
       	             "Fichte.\n"));
       	   
       	   this_player()->move(ROOM "room_c5e", 
       	   M_TPORT|M_NO_SHOW,"",
       	   "balanciert ueber den Ast zur Fichte hinueber",
       	   "balanciert herein. Schweissperlen auf der Stirn zeigen, dass "
       	   "das gar\nnicht so einfach war");
           
       	   return 1;
       	   
       	   break;
       	   
       	   default:
       	   //spieler balanciert souveraen rueber
       	   write (BS("Du balancierst souveraen auf dem Ast Richtung "
       	             "Fichte.\n"));
       	   
       	   this_player()->move(ROOM "room_c5e", M_TPORT|M_NO_SHOW,
       	   "","balanciert souveraen ueber den Ast zur Fichte hinueber",
       	   "balanciert laechelnd herein");
           
       	   return 1;
       	   
       	   break;
       	 }
       	 
       
   }
   return 0;
}

// Spieler faellt vom Ast
int funktion_fallen ()
{
  int pl_hp;	
  object stangerl;
  object player_weapon; 
  object room;
  int stangeda;
        
        
        write (BS("\nHart schlaegst Du auf dem Boden auf. Das tat weh!\n"));
        
        say ( TP->name() +" balanciert vorsichtig auf dem Ast Richtung "
               "Fichte. Ui, "+ TP->name() +" kommt ins Wanken!\n");
        
        stangeda=0;
        
        if(present("\nbalancierstange",TP))
           {
       	       stangeda=1;
       	       write (BS("Deine Balancierstange zerbricht mit einem lauten "
       	       "*KNACKS*\n"));
               //Balancierstange entfernen     	       
               stangerl=present("\nbalancierstange", TP);
               stangerl->SetProp(P_CURSED,0);  //erstma entfluchen
               player_weapon = TP->QueryProp(P_WEAPON);
               if(player_weapon)               //wegstecken, damit keine
                  player_weapon->DoUnwield(1); //Meldung kommt
               stangerl->remove();             //und weg damit..
           }
        
        //An den unten liegenden Raeumen vorbeifallen
         if(room = find_object(ROOM "room_c5d"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
        
         if(room = find_object(ROOM "room_c5c"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
        
         if(room = find_object(ROOM "room_c5b"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
  
         if(room = find_object(ROOM "room_c5a"))
           room->Message(BS("Mit lautem "
           "Getoese und Krachen faellt ein Koerper an Dir "
           "vorbei und schlaegt hart unten auf."), MSGFLAG_VISUAL);
           
       //teleportieren zum Fuss des Baumes
       if(stangeda==1)
           this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
           "", "faellt nach unten", "faellt neben Dir auf den Boden "
           "und verzieht das Gesicht vor Schmerzen. Eine Balancierstange "
           "zerbricht mit einem lauten *KNACKS*");
        else
           this_player()->move(ROOM "room_c5", M_TPORT|M_NO_SHOW, 
           "", "faellt nach unten", "faellt neben Dir auf den Boden "
           "und verzieht das Gesicht vor Schmerzen");
       
        //HP's runter, zwischen 20-30
        pl_hp=20 + random(11);
        //Kill-Message
        SetProp(P_KILL_NAME,"Ein verdammt tiefer Sturz");
        //Schaden setzen
        TP->do_damage(pl_hp);
        
        return 1;
}  
