#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald


      create()
      {
        ::create();

     
     SetProp( P_INT_SHORT, "Auf einem Baum" );
     SetProp( P_INT_LONG, 
        "Du sitzt auf dem Ast eines Baumes. Um Dich herum siehst Du nur strahlend "
        "gruene Blaetter. Dir gefaellt diese Farbe. Von hier aus ist der blaue "
        "wolkenlose Himmel nur schwer zu erkennen, doch etwas anderes faellt Dir "
        "dort oben auf.");
        

// Details beschreiben:             
  // DETAILS START
              
   AddDetail( ({"boden", "nach unten", "weg", "waldweg"}),
        "Der Boden ist viel zu weit unter Dir, als dass Du etwas erkennen koenntest.");

       
   AddDetail( ({"himmel", "nach oben"}),
        "Du schaust nach oben und entdeckst wirklich einen herrlichen "
        "blauen Himmel. Die Sonne steht recht hoch, und ihre Strahlen "
        "waermen Dich. Du fuehlst Dich gleich viel besser. Ueber Dir "
        "befindet sich ein kleines Baumhaus.");
   
   AddDetail( ({"sonne", "sonnenstrahlen", "strahlen"}),
        "Du schliesst die Augen und laesst Dich von der Sonne waermen. ");

  AddDetail( ({"baumhaus"}),
       "Ueber Dir befindet sich ein kleines Baumhaus. Wem es wohl gehoert? "
       "Das wirst Du wohl nur herausfinden, wenn Du es betrittst.");

  AddDetail( ({"kaefer"}),
       "Oh, es sind Ameisen und keine Kaefer.");
       
  AddDetail( ({"stamm"}),
       "Kleine Kaefer huschen ueber die Rinde des Baumes.");
   
     AddDetail( ({"rinde"}),
       "Die rauhe Rinde umgibt den breiten Stamm der Eiche");
   
     AddDetail( ({"ameise", "ameisen"}),
       "Du hast Dich wohl doch getaeuscht, es sind keine Ameisen sondern kleine Kaefer.");
   
  AddDetail( ({"aeste", "ast"}),
       "Du sitzt auf einem relativ breiten Ast. Auf ihm waechst weiches "
       "dunkelgruenes Moos.");
       
    AddDetail( ({"moos"}),
       "Das Moos ist weich und dunkelgruen.");
   
   AddDetail( ({"eiche", "eichen", "baum", "baeume"}),
        "Du befindest Dich auf einem breiten Ast auf einer Eiche, wie auch "
        " alle anderen Baeume um Dich herum Eichen sind. "
        "Es sind imposante Baeume, bestimmt schon hunderte von Jahren "
        "alt, gerade und gut gewachsen. Es scheint fast so, als ob sich "
        "jemand gut um die Baeume hier zu kuemmern scheint.");
  
    AddDetail( ({"farbe", "farben"}),
       "Die Blaetter sind gruen und der Stamm braun. Der Himmel blau und die Wolken weiss.");
       
      AddDetail( ({"wolken", "wolke"}),
       "Huch, da sind ja gar keine Wolken zu sehen. Aber wenn eine da waere, waere sie "
       "bestimmt ganz weiss.");
  
  AddDetail( ({"blaetter", "eichenblaetter"}),
       "Wunderschoene gruene Eichenblaetter.");
       
   AddDetail( "wald",
        "Der Wald macht hier einen ziemlich friedlichen Eindruck auf Dich.");

  AddDetail( ({"eindruck"}),
       "Friedlich ist es hier, aber das kann taeuschen.");
       
  // DETAILS END
       
// Sounds:

  AddSound(DEFAULT_SOUND, 
       "Die Blaetter rascheln leise im sachten Wind. ");
  
  
  AddSound( ({"wind", "rascheln", "blaetter"}),
       "Der Wind laesst leise die Blaetter rings um Dich herum rascheln.\n");
       

//smells
  AddSmell( DEFAULT_SMELL,
       "Es riecht hier sehr angenehm.\n");
              
// Kommandos:
   

// Ausgaenge:
   
   AddExit( "unten", "./room_c3" );
   //AddExit ( "oben", "blabla" );
   
      }
