#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit ROOM "std_room.lpc";      //Standard-Raum fuer den Wald

   string *getrunken;
  
      create()
      {
        ::create();

     
     SetProp( P_INT_SHORT, "Weg am See" );
     SetProp( P_INT_LONG, 
        "Du stehst auf dem Weg an einem Waldsee. Auf der vom Ufer abgewandten "
        "Seite stehen ein paar Baeume. Auf dem Weg liegen einige Steinchen, "
        "am Wegrand siehst Du einen grossen Felsbrocken." );
     
     grundzustand(); //erstma resetten 
     
     SetProp( P_LIGHT, 1 );
     SetProp( P_INDOORS, 0 );

// Details beschreiben:
  // DETAILS START

  AddDetail( ({"seite"}),
     "Seitlich quasi. Also nicht mittig.");

  AddDetail( ({"felsbrocken", "fels"}),
     "Ein grauer Felsbrocken. Er sieht ziemlich schwer aus. Anheben auf eigene Gefahr!");

  AddDetail( ({"baeume", "baum", "wald"}),
     "Ein paar Baeume stehen oestlich des Pfades. Sie scheinen aber nicht "
     "sehr interessant zu sein.");

  AddDetail( ({"ufer"}),
     "Das Ufer grenzt den See vom Pfad ab.");

  AddDetail( ({"see", "waldsee"}),
     "Der See liegt westlich von Dir. Der Himmel spiegelt sich in seinem "
     "Wasser.");

  AddDetail( ({"himmel", "sonne"}),
     "Die Sonne steht hoch am Himmel.");

  AddDetail( ({"wasser"}),
     "Das Wasser ist glasklar.");

  AddDetail( ({"boden", "nach unten", "unten"}),
     "Du stehst fest mit beiden Beinen auf dem Weg, der um den See fuehrt.");

  AddDetail( ({"weg", "pfad"}),
     "Ein ganz normaler Weg, mit einigen Steinchen drauf.");

  AddDetail( ({"wegrand", "rand des weges"}),
     "Auch hier liegen ein paar Steinchen.");

  AddDetail( ({"beine", "bein"}),
     "Dir kommen Deine Beine viel zu staksig vor. Aber eigentlich sind sie "
     "ganz normal.");

  AddDetail( ({"steinchen"}),
     "Irgendwas ist seltsam an den Steinchen. Ein Stein faellt Dir besonders "
     "auf.");

  AddDetail( ({"stein"}),
     "Sieht eher nach einem Steinpilz aus, als nach einem Stein.");

  AddDetail( ({"steinpilz", "herrenpilz"}),
     "Der Steinpilz wird auch Herrenpilz genannt. Er hat einen meist "
     "keulenfoermigen, weiss bis braeunlichen Stiel mit einem hellen Netz am "
     "Ende. Der Hut ist gewoelbt, hell- bis dunkelbraun und hat einen "
     "Durchmesser von 6 bis 20 Zentimetern. Die Roehren sind gelblich bis "
     "olivfarben, das Fleisch ist fast weiss.");
  
  AddDetail( ({"brocken"}),
     "Der Brocken ist ein Berg. Hast Du zumindest irgendwo gehoert. "
     "Und irgendwas war da doch mit Harz ... ");

  AddDetail( ({"berg", "berge"}),
     "Hier sind keine Berge. Aber im Gebirge findest Du welche.");
     
  AddDetail( ({"gebirge"}),
     "Weiter noerdlich ist ein Gebirge. Hast Du zumindest mal gehoert.");

  AddDetail( ({"harz"}),
     "Harz ist meist sehr klebrig und schmeckt auch nicht besonders.");

  AddDetail( ({"ende"}),
     "Connection closed by foreign Host.");

  AddDetail( ({"fleisch"}),
     "Hmm... jetzt ein saftiges Steak! Oder bist Du Vegetarier?");

  AddDetail( ({"vegetarier"}),
     "Ja, die gibt es!");

  AddDetail( ({"steak"}),
     "Frag den Dschungelwaechter, der hat immer Hunger.");

  AddDetail( ({"hunger", "magen"}),
     "Dein Magen knurrt.");

  AddDetail( ({"dschungelwaechter", "waechter"}),
     "Der ist im Dschungel.");

  AddDetail( ({"dschungel"}),
     "Da ist es sehr heiss. Hier ist es viel angenehmer.");

  AddDetail( ({"roehre"}),
     "Du guckst in die Roehre.");

  AddDetail( ({"durchmesser"}),
     "Was willst Du messen? Hast Du denn ein Massband dabei?");

  AddDetail( ({"massband"}),
     "Im Fischerdorf gibt es sowas.");

  AddDetail( ({"fischerdorf"}),
     "Das Fischerdorf befindet sich nicht hier. Geh doch einfach dorthin.");

  AddDetail( ({"hut"}),
     "Er hat keine drei Ecken.");

  AddDetail( ({"ecken"}),
     "Eckstein, Eckstein, alles muss versteckt sein...");

  AddDetail( ({"eckstein"}),
     "WO? WO? SUCH SUCH!");

  AddDetail( ({"stiel"}),
     "Der Stiel vom Steinpilz ist weiss bis braeunlich. Mehr faellt Dir nicht "
     "auf.");

  AddDetail( ({"netz"}),
     "Wenn Du jetzt ein Netz haettest, koenntest Du fischen gehen. Aber das "
     "kannst Du eigentlich auch woanders machen. Ausserdem ist das Netz vom "
     "Steinpilz kein Netz in diesem Sinne.");

  AddDetail( ({"sinne", "sinn"}),
     "Das macht fuer Dich alles keinen Sinn.");

  AddDetail( ({"jemand"}),
     "Du hoerst eine Stimme: 'Den wirst Du niemals finden! HAR HAR HAR!'");

  AddDetail( ({"stimme"}),
     "Hast Du Deine Stimme verloren?");

  AddDetail( ({"beinen", "roehren", "zentimetern", "pfades", "host", "such"}),
     "Das ist nicht wirklich interessant.");


  // DETAILS END

// Sounds beschreiben
  AddSound(DEFAULT_SOUND, 
       "Es ist sehr ruhig hier.");


// Smells beschreiben
  AddSmell( DEFAULT_SMELL,
       "Es riecht nach frischer Luft.\n");

  AddSmell( ({"luft"}),
     "Sie erfrischt Dich.\n");


// Ausgaenge:

  AddExit( "nordwesten", "./room_a4" );
  AddExit( "nordosten", "./room_c4" );
  AddExit( "suedwesten", "./room_a6" );
  AddExit( "osten", "./room_c5" );


//Commands beschreiben:   
   
   AddCmd( ({ "such", "suche"}), "cmd_suchen");
   AddCmd( ({ "schwimm", "schwimme"}), "cmd_schwimmen");
   AddCmd( ({ "heb", "hebe"}), "cmd_heben");
   AddCmd( ({ "trink", "trinke"}), "cmd_trinken");
}


reset()
{
 
  ::reset();
  grundzustand();
    
  }
  

int grundzustand()
{
 getrunken=({});
}


int cmd_ausruhen(string str)
{
   notify_fail("Wie meinen? Ruh aus oder wie? Da kannst Du auch rasten.\n");
   if (str=="aus")
   {
   TP->command_me("raste");
   return 1;
   }
   return 0;
}




int cmd_trinken (string str)
{
  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser" || str == "wasser aus see" || str == "aus see")) return 0;	

  if(member(getrunken, getuuid(TP)) == -1)
  {
    if(TP->drink_soft(10)) 
    {
      TP->AddHp(15);
      //getrunken += ({TP->name()});
      write(BS("Du trinkst einen Schluck Wasser aus dem See und fuehlst Dich besser. "
               "Sehr gut hat das Wasser aber nicht geschmeckt."));
      say(BS(CAP_TPN + " trinkt einen Schluck Wasser aus dem See."));
     getrunken += ({getuuid(TP)});
    }
    return 1;
  }
  write(BS("Irgendwie schmeckte das Wasser nicht so gut, wie Du erwartet hattest. "
           "Vielleicht schmeckt es an einer anderen Stelle besser?"));
  return 1;
}


int cmd_heben(string str)
  {
   
   string rasse, meldung1, meldung2;
   int schaden;
  
   notify_fail("Was moechtest Du anheben?\n");
   if(!str || str == "") return 0;
   if(!(str == "fels an" || str == "einen fels an" || str == "einen fels an" ||
        str == "felsbrocken an" || str == "einen felsbrocken an" || str == "einen felsbrocken an" ||
        str == "brocken an" || str == "einen brocken an" || str == "einen brocken an")) return 0;
   
   rasse = TP->QueryProp(P_RACE);
   
   //default-meldungen:
   meldung1 = "Du bekommst den Felsbrocken nicht richtig zu fassen und laesst es bleiben.";
   meldung2 = " wundert sich.";
   //schaden erstmal setzen fuer alle faelle:
   schaden = 0;
   
   switch (rasse)
  {
     case "Mensch":
     case "Elf":
     case "Dunkelelf":
     case "Untoter":
     meldung1 = "Du versuchst, den Felsbrocken anzuheben. Ganz schoen schwer! "
                "Du hebst den Felsen 10 cm hoch, laeufst rot an und laesst ihn wieder auf "
                "den Boden plumpsen. Autsch, Du verknackst Dir den Ruecken.";
     meldung2 = " hebt den Felsbrocken ca. 10 cm an, laeuft rot an, laesst ihn wieder fallen "
                "und reibt sich den schmerzenden Ruecken.";
     schaden = 8;
     break;
     case "Oger":
     case "Troll":
     meldung1 = "Du hebst den Felsbrocken spielend einfach hoch. Urgs, ist doch schwerer, "
                "als Du gedacht hast! Du laesst den Brocken wieder fallen, dummerweise auf "
                "Deinen Fuss!";
     meldung2 = " hebt den Felsbrocken spielerisch an und laesst ihn (hoppala) auf den Fuss fallen.";
     schaden = 5;
     break;
     case "Hobbit":
     case "Zwerg":
     meldung1 = "Du versuchst den Felsbrocken anzuheben, setzt ab, setzt neu an, und reisst Dir "
                "bei dem erneuten Versuch fast die Baender aus den Gelenken. Du haeltst Dir die "
                "schmerzenden Arme.";
     meldung2 = " versucht den Felsbrocken anzuheben. Sieht fast so aus, als ob die Arme gleich "
                "aus den Gelenken gerissen werden! Das ist sicher nicht gesund.";
     schaden = 10;
     break;
     case "Fee":
     meldung1 = "Du versuchst Dich an dem Felsbrocken. Urgs, der ist viel zu schwer! Du "
                "verknitterst Deine Fluegelchen!";
     meldung2 = " versucht den Felsbrocken hochzuheben und verknittert sich bei dem Versuch "
                "voellig ihre Feenfluegelchen.";
     schaden = 12;
     break;
  }
   
   write(BS(meldung1));
   tell_room(TO, BS(CAP_TPN + meldung2), ({TP}) );
   
   //Kill-Message
   SetProp(P_KILL_NAME,"Ein viel zu schwerer Felsbrocken");
   //Schaden setzen
   TP->do_damage(schaden);
    return 1;
}




int cmd_suchen(string str)
  {
   if(!str || str == "") return 0;
   if(!(str == "eckstein" || str == "einen eckstein")) return 0;
   tell_object(TP, BS("Du suchst einen Eckstein, aber anscheinend hat ihn "
                  "Jemand gut versteckt."));
   tell_room(TO, BS(CAP_TPN+" sucht irgendwas, gibt aber nach einiger Zeit "
                    "frustiert auf."), ({TP}) );
    return 1;
  }
  
  
int cmd_schwimmen(string str)
{
   notify_fail("Worin willst Du schwimmen?\n");
   if (str=="in see" || str=="im see")
   {
   write (BS("Froehlich huepfst Du in den See. Das Wasser ist herrlich erfrischend "
             "und Du schwimmst gleich ein paar Runden. Nach einem kleinen Weilchen "
             "wird es doch langsam kuehl und zu steigst wieder aus dem See heraus. "
             "Bibbernd schuettelst Du Dich um wieder trocken und warm zu werden."));
             
   tell_room(TO, BS(CAP_TPN+" huepft so wie er ist in den See! "+capitalize(TP->QueryPronoun(WER))+
             " schwimmt "
             "ein paar Runden. Das Wasser scheint jedoch recht kalt zu sein. "
             +CAP_TPN+" steigt bibbernd und mit blauen Lippen aus dem Wasser "
             "und schuettelt sich, dass die Tropfen nur so fliegen."), ({TP}) );
   return 1;
   }
return 0;
}