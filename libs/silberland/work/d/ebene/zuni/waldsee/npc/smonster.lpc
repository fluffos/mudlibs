inherit "std/npc";

#include <config.h>
#include <properties.h>
#include <living.h>
#include <combat.h>
#include <defines.h>
#include <new_skills.h>
#include <language.h>
#include <moving.h>
#include <npc.h>
#include <new_skills.h>
#include "../files.h"

create()
{ if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Sumpfmonster");

  SetProp(P_LONG, 
      "Du siehst eine fuerchterliches Sumpfmonster! Es besteht aus Schlamm, kleinen "
      "Zweigen und Steinchen und sieht extrem schleimig aus. Seine Augen gluehen "
      "in einem unnatuerlichen roten Farbton, das Maul (bzw. das Loch in seinem "
      "Kopf was wohl diesem Zweck dient) ist weit aufgerissen. Seine Pranken "
      "greifen nach Dir!\n");

  create_default_npc(25+random(3));
  
  SetProp(P_RACE, "Monster");
  SetProp(P_NAME, "Sumpfmonster");
  SetProp(P_GENDER, NEUTER);
  
  AddId(({ "monster", "sumpfmonster", "mons\ter" }));
  
  SetProp(P_SIZE, 190+random(40));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_HANDS, ({" mit seinen schleimigen Pranken", 200}));
  SetProp(P_ALIGN, -700);

  SetProp(P_SPELLRATE,10);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Sumpfmonster will nichts von Dir annehmen.\n" }) );
 
  SetAttribute(A_DEX, 20);

  SetProp(P_DIE_MSG, " loest sich in seine Bestandteile auf.\n");
   
  SetChats(8, ({
       "Das Monster blubbert unverstaendliches Zeug.\n", 
       "Das Sumpfmonster sabbert Dich an.\n",
       "Das Sumpfmonster bespritzt Dich mit Dreck.\n" }) );

   
  AddInfo(DEFAULT_INFO, ({"schleimt Dich voll.\n",
                          "fuchtelt mit seinen ekligen Pranken.\n",
                          "sagt: Blbbooooaaargh!\n"})  );
  
    
  AddSpell(1,400,
       "Das Monster schlaegt Dir seine Pranken um die Ohren.\n",
       "Das Monster schlaegt @WEM die Pranken um die Ohren.\n");
       
  AddSpell(3,300,
       "Das Sumpfmonster schleimt Dich voll.\n",
       "Das Sumpfmonster schleimt @WEN voll.\n");
       
  AddSpell(2,550,
       "Das Sumpfmonster faellt ueber Dich her.\n",
       "Das Sumpfmonster faellt ueber @WEN her.\n");

 
  AddInfo( ({ "zuni" }),
    "Groaaargblblbl!", "blubbert: " );

}


void init() 
{
 ::init(); 
 if (find_call_out("cmd_verschwinde")==-1)
   call_out("cmd_verschwinde",360+random(120));
}

void cmd_verschwinde()
{
  
  if (!InFight())
  {
    tell_room(environment(this_object()), "Das Sumpfmonster versinkt im Dreck.\n");
    remove();
  }
 call_out("cmd_verschwinde",360+random(120));
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  
  if (member ( ({"tritt", "trete", "hau", "haue", "aerger", "aergere", "beiss",
                 "beisse", "nerv", "nerve", "stoss", "stosse"}), verb)!= -1)
   {
  	call_out("react", 0, "bruellt: OAAARGHBLLBBLAAARGH!",
                 "bruellt: OAAARGHBLLBBLAAARGH!");
        call_out("angriff",0);
   }
   
   
   
}

void react(string victim, string others)
{
  if (present(this_player(), environment(this_object()))) 
  {
    if( !others ) others = victim;
    tell_object(this_player(), BS(Name(WER, 1) + " "+victim) );
    tell_room(environment(this_object()), BS(Name(WER, 1)+" "+others), ({this_player(),this_object()}) );
  }
}


void angriff()
{
  if (present(this_player(), environment(this_object()))) 
  {
    Kill(this_player());
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
