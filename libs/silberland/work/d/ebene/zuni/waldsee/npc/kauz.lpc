inherit "std/npc";

#include <config.h>
#include <properties.h>
#include <living.h>
#include <combat.h>
#include <defines.h>
#include <new_skills.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
// #include "../def.h"

create()
{ if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Waldkauz");

  SetProp(P_LONG, 
      "Der Waldkauz ist ein typisches Geschoepf des Waldes. Von seinem "
      "Platz auf dem Ast beaeugt er Dich kritisch. Solltest Du ihn reizen, "
      "wird er Dich bestimmt angreifen, denn er hat heute wirklich schlechte "
      "Laune.\n");

 
  SetProp(P_NAME, "Waldkauz");
  SetProp(P_MSGIN, "taucht aus dem Schatten auf");
  SetProp(P_GENDER, MALE);

  AddId("kauz");
  AddId("waldkauz");

  create_default_npc( 10 );

  
  SetProp(P_HANDS, ({" mit seinem harten Schnabel", 60}));
  SetProp(P_ALIGN, -200);
  SetProp(P_RACE, "Eulen");
//  SetProp(P_XP, 100000+random(30000));
  

  SetProp(P_SPELLRATE,10);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kauz schaut Dich veraergert an.\n" }) );
    
  AddInfo(DEFAULT_INFO, "ruft: HUHU\n");
    
  AddSpell(2,120,
       "Der Kauz beisst Dir in die Nase.\n",
       "Der Kauz beisst @WEM in die Nase.\n");
       
  AddSpell(3,90,
       "Der Kauz flattert Dir ins Gesicht.\n",
       "Der Kauz flattert @WEM ins Gesicht.\n");
       
  AddSpell(1,60,
       "Der Kauz reisst Dir fast das Ohr ab.\n",
       "Der Kauz reisst @WEM fast das Ohr ab.\n");


}
