/* Buntspecht
   adaptiert von: Nachteule by Impulz@SL
   adaptiert fuer den Alten Wald: 25.3.2001, Zuni
*/

inherit "std/npc";

#include <config.h>
#include <properties.h>
#include <living.h>
#include <combat.h>
#include <defines.h>
#include <new_skills.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
// #include "../def.h"

create()
{ if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Buntspecht");

  SetProp(P_LONG, 
      "Der Specht ist ein lustiger Geselle. Er zwinkert Dir vergnuegt zu, "
      "klopft ein- zwei mal auf Holz und huepft auf und ab.\n");

 
  SetProp(P_NAME, "Buntspecht");
  SetProp(P_MSGIN, "huepft aus seiner Hoehle");
  SetProp(P_GENDER, MALE);

  AddId("specht");
  AddId("buntspecht");

  create_default_npc( 10 );

  
  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel", 60}));
  SetProp(P_ALIGN, 50);
  SetProp(P_RACE, "Spechte");
  SetProp(P_XP, 10000+random(3000));
  

  SetProp(P_SPELLRATE,10);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Specht klopft auf Holz.\n" }) );
    
  AddInfo(DEFAULT_INFO, "zwinkert Dir zu.\n");
    
  AddSpell(2,120,
       "Der Specht hackt Dir in den Finger.\n",
       "Der Specht hackt @WEM in den Finger.\n");
       
  AddSpell(3,90,
       "Der Specht beisst Dir in die Nase.\n",
       "Der Specht beisst @WEM in die Nase.\n");
       
  AddSpell(1,60,
       "Der Specht hackt nach Deinen Augen.\n",
       "Der Specht hackt nach @WESSEN Augen.\n");


}
