inherit "std/npc";

#include <config.h>
#include <properties.h>
#include <living.h>
#include <combat.h>
#include <defines.h>
#include <new_skills.h>
#include <language.h>
#include <moving.h>
#include <npc.h>
#include <new_skills.h>
#include "../files.h"

create()
{ if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Waldgnom");

  SetProp(P_LONG, 
      "Du siehst einen kleinen Waldgnom. Er schaut Dich vernuegt mit seinen Knopfaugen an. "
      "Im Kampf sollte man ihn jedoch nicht unterschaetzen, er hat sicher den ein oder "
      "anderen Trick auf Lager.\n");

  create_default_npc(15+random(3));
  
  SetProp(P_RACE, "Gnom");
  SetProp(P_NAME, "Waldgnom");
  SetProp(P_GENDER, MALE);
  
  AddId(({ "gnom", "waldgnom" }));
  
  SetProp(P_SIZE, 90+random(40));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_HANDS, ({" mit seinen kleinen Faeusten", 200}));
  SetProp(P_ALIGN, 800);

  SetProp(P_SPELLRATE,10);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Gnom sagt: Von Dir will ich nichts!\n" }) );
 
  SetAttribute(A_DEX, 20);

  SetProp(P_DIE_MSG, " krepiert jaemmerlich.\n");
   
  SetChats(8, ({
       "Der Gnom kratzt sich am Kopf.\n", 
       "Der Gnom rollt mit seinen Knopfaeuglein.\n"
       "Der Gnom laechelt Dich an.\n" }) );

   
  AddInfo(DEFAULT_INFO, ({"rollt mit seinen Knopfaeuglein.\n",
                          "schaut Dich verwirrt an.\n",
                          "sagt: Darueber hab ich mir noch nie Gedanken gemacht.\n",
                          "kratzt sich ratlos am Kopf.\n",
                          "kratzt sich ratlos am Ohr.\n",
                          "legt die Stirn in Falten.\n",
                          "sagt: Frag Zuni, die weiss das.\n",
                          "sagt: Frag Creative, der weiss das.\n",
                          "sagt: Frag Cute, die weiss das.\n",
                          "sagt: Frag Ronja, die weiss das. Hmm. Oder doch besser Protheg fragen?\n",
                          "sagt: Frag Protheg, der weiss das.\n"})  );
  
  AddDetail( ({"augen", "knopfaugen", "aeuglein", "knopfaeuglein"}),
       "Der Gnom schaut Dich mit seinen Knopfaugen vergnuegt an. "
       "Er scheint ein netter Geselle zu sein");
       
  AddDetail( ({"geselle"}),
       "Der Gnom ist sehr nett, aber wehe Du willst ihm Boeses.");
    
  AddSpell(1,350,
       "Der Gnom boxt Dir in den Bauch.\n",
       "Der Gnom boxt @WEM in den Bauch.\n");
       
  AddSpell(3,200,
       "Der Gnom kitzelt Dich. Du bist einen Moment verwirrt.\n",
       "Der Gnom kitzelt @WEN.\n");
       
  AddSpell(2,300,
       "Der Gnom beisst Dir ins Knie.\n",
       "Der Gnom beisst @WEM ins Knie.\n");

  AddInfo( ({ "wald" }),
    "Na klar ist das ein Wald hier! Ich bin ja auch schliesslich ein Waldgnom!", "sagt: " );
  
  AddInfo( ({ "creative" }),
    "Creative gehoert zu der Sippe der meinst unsichtbaren Magier.", "sagt: " );
  
  AddInfo( ({ "magier" }),
    "Davon gibt es einen Haufen. Voellig fertig die Jungs und Maedels, wenn Du "
    "mich fragst.", "sagt: " );
  
  AddInfo( ({ "cute" }),
    "Cute? Hm, ich glaube das ist so eine von den flatterhaften Blumenfeen.", "sagt: " );
    
  AddInfo( ({ "fee", "blumenfee", "feen", "blumenfeen" }),
    "Diese kleinen fisseligen Dinger mit den Fluegelchen. Kann man doch nicht fuer voll "
    "nehmen, oder?", "sagt: " );
  
  AddInfo( ({ "dunkelelf", "dunkelelfe", "dunkelelfen", "dunkelelfin" }),
    "Ach hoer bloss auf mit den ollen Dunkelelfen! Sieht man ja die Hand vor Augen nicht, "
    "wenn die hier rumlungern!", "sagt: " );
  
  AddInfo( ({ "oger", "ogerin" }),
    "Total verfressen die ganze Bande. Kaum zum Aushalten, wenn die mal "
    "Magenknurren bekommen.", "sagt: " );
  
  AddInfo( ({ "troll", "trolle" }),
    "Muahua, die kannst Du ja schon mit einem Streichholz in die Flucht schlagen! "
    "Haben dermassen Angst vorm Feuer, ich koennte mich totlachen!", "sagt: " );
  
  AddInfo( ({ "feuer" }),
    "Spiel hier bloss nicht mit dem Feuer!! Alles knochentrocken "
    "hier im Wald! Oder willst Du uns alle umbrinen??", "bruellt Dich an: " );
  
  AddInfo( ({ "woody" }),
    "Woody? Ja das ist der Gott hier - und, nebenbei bemerkt, auch der beste "
    "Regionsmagier der Welt. Ist doch klar!", "sagt: " );
  
  AddInfo( ({ "protheg", "pro" }),
    "Der Protheg ist Magier hier.", "sagt: " );
    
  AddInfo( ({ "ronja" }),
    "Ronja treibt sich meistens bei den Feen oder in der Unterwelt rum. Du solltest sie "
    "besser nicht aergern, nur so ein persoenlicher Rat.", "sagt: " );
    
  AddInfo( ({ "gnom", "waldgnom" }),
    "So einer bin ich, richtig erkannt!", "sagt: " );
    
  AddInfo( ({ "zuni" }),
    "Die kommt hier ab und zu vorbei. Aber im Vertrauen: ich glaube so richtig tickt die nicht!", "sagt: " );

}


void init() 
{
 ::init(); 
 if (find_call_out("cmd_verschwinde")==-1)
   call_out("cmd_verschwinde",360+random(120));
}

void cmd_verschwinde()
{
  
  if (!InFight())
  {
    tell_room(environment(this_object()), "Der Waldgnom sagt: Ich verschwinde, hier ist mir zu "
                                          "langweilig.\nDer Gnom versteckt sich.\n");
    remove();
  }
 call_out("cmd_verschwinde",360+random(120));
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  
  if (member ( ({"tritt", "trete", "hau", "haue", "aerger", "aergere", "beiss",
                 "beisse", "nerv", "nerve", "stoss", "stosse"}), verb)!= -1)
   {
  	call_out("react", 0, "bruellt: Du Luemmel! Sowas macht man nicht!",
                 "bruellt: "+this_player()->name(WER)+" ist ein Luemmel!");
        call_out("angriff",0);
   }
   
   if (verb == "knuddle" || verb == "knuddel" || verb == "streichel" || verb == "streichle")
  {
  	call_out("react", 0, "brummelt: Lass das, bin doch kein Streichelgnom!",
                 "brummelt: Lass das, bin doch kein Streichelgnom!");
   }
   
   
}

void react(string victim, string others)
{
  if (present(this_player(), environment(this_object()))) 
  {
    if( !others ) others = victim;
    tell_object(this_player(), BS(Name(WER, 1) + " "+victim) );
    tell_room(environment(this_object()), BS(Name(WER, 1)+" "+others), ({this_player(),this_object()}) );
  }
}


void angriff()
{
  if (present(this_player(), environment(this_object()))) 
  {
    Kill(this_player());
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
