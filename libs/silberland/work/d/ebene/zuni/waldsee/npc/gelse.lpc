inherit "std/npc";

#include <config.h>
#include <properties.h>
#include <living.h>
#include <combat.h>
#include <defines.h>
#include <new_skills.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

create()
{ if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine blutgierige Gelse");

  SetProp(P_LONG, 
      "Die Gelse ist ein Insekt (und gehoert zur Gattung  "
      "Nervtoeter).\n");

 
  SetProp(P_NAME, "Gelse");
  SetProp(P_MSGIN, "summt herein");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LEVEL, 2);

  AddId("gelse");
  AddId("muecke");

  create_default_npc( 10 );

  
  SetProp(P_HANDS, ({" mit einem spitzen Stachel", 30}));
  SetProp(P_ALIGN, 200);
  SetProp(P_RACE, "Gelsen");
  SetProp(P_XP, 10000+random(3000));
  

  SetProp(P_SPELLRATE,10);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Gelse summt nervtoetend herum.\n" }) );
    
  SetChats(10, ({
       "Die Gelse summt um Dich herum.\n", 
       "Die Gelse aergert Dich gewaltig.\n",
       "SSSSSSSSSSSSSSSSSSSSSSSSSSSSUMMMMMMM\n",
       "@@stechen@@" }) );

    
  AddInfo(DEFAULT_INFO, "summt in Deine Richtung.\n");
 
  AddSpell(2,120,
       "Die Gelse sticht Dich in die Hand.\n",
       "Die Gelse sticht @WEM in die Hand.\n");
       
  AddSpell(3,90,
       "Die Gelse sticht Dir in den Hals.\n",
       "Die Gelse sticht @WEM in den Hals.\n");
       
  AddSpell(1,60,
       "Die Gelse zapft Dir ein paar Milliliter Blut ab.\n",
       "Die Gelse zapft @WEM ein paar Milliliter Blut ab.\n");


}
//with a little help from my friends (creative/feyaria)
string stechen ()
{
  object *players;
  object victim, stich;

  if (environment(this_object())) 
  {
    // schaun wer im raum steht
    players=filter_array(all_inventory(environment(this_object())), #'interactive);
    if (sizeof(players)) 
    {
      
      // einen spieler davon auswählen
      victim=players[random(sizeof(players))];
      
      // schaun ob er schon einen gelsenstich hat
      if (!present("gelse\nstich", victim)) 
      
      {
        if (!present("fliegen\nklatsche", victim))
        {
        // wenn nicht dann den gelsenstich in sein inv moven
        stich=clone_object(ITEM+"gelsenstich");
        stich->move(victim, M_NOCHECK);
        tell_room(environment(this_object()), "Die Gelse sticht "+victim->Name()+".\n", ({victim}));
        write_file(LOG "gestochen.log", sprintf("%s: %s wurde gestochen.\n", ctime(time()), capitalize(getuid(victim))));
        }
      }
    }
  }
  return "";
}

