 /* /d/ebene/access_rights.c */

      int access_rights(string name, string file, int readflag, int def)
      {
        string *s;
        int n;

        // Lesezugriff regeln.
        if (readflag)
        {
          
          if (name=="protheg")
            return 1;
          return def;
        }
 		name=lower_case(name);
        s=explode(file,"/");


if (name=="protheg")
        {
          
          if (s[0]=="badehaus")
          return 1;
        }
        return 0;
      }
