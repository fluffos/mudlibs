#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <moredef.h>
#include "../files.h"

//Standard-Raum fuers Badehaus
inherit ROOM "std_room.lpc";      

create()
{
  ::create();
			      

  SetProp( P_INT_SHORT, "Eine Duftgrotte" );

  SetProp( P_INT_LONG, 
     "Du befindest Dich hier in einer Duftgrotte. Die Waende bestehen "
     "aus Felsgestein, im Boden ist ein Wasserbecken aus poliertem "
     "Granit eingelassen." );
 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  
 
  AddDetail( ({"duftgrotte"}),
     "Du befindest Dich hier in einer Duftgrotte. Die Waende bestehen "
     "aus Felsgestein, im Boden ist ein Wasserbecken aus poliertem "
     "Granit eingelassen." );

  AddDetail( ({"waende"}),
     "Die Waende bestehen aus Felsgestein. Die XXXwand faellt Dir auf.");
		//welche wand? ost sued nord west?
  
  AddDetail( ({"XXXwand"}),
     "Ein Wasserfall plaetschert die XXXwand herunter.");

  AddDetail( ({"wasser", "wasserfall"}),
     "Das Wasser plaetschert die XXXwand herunter und fliesst in das "
     "Becken. Es ist wohlig warm.");

  AddDetail( ({"waerme", "temperatur"}),
     "Es ist wohlig warm hier drin.");

  AddDetail( ({"felsgestein", "granit"}),
     "Die Waende scheinen aus grobem Granit zu bestehen.");

  AddDetail( ({"decke"}),
     "Die Decke besteht, wie die Waende, aus grobem Granit.");

  AddDetail( ({"boden", "fussboden"}),
     "Der Fussboden ist, genau wie das Becken, anscheinend aus poliertem "
     "Granit. Er strahlt eine Waerme aus, so dass Barfusslaufen hier sehr "
     "angenehm ist");

  AddDetail( ({"becken", "wasserbecken"}),
     "In dem Wasserbecken befindet sich angenehm temperiertes Wasser.");
          		 
                

//Sounds beschreiben:
     
  AddSound(DEFAULT_SOUND, 
     "Du hoerst das Plaetschern des Wasserfalles.\n");

  AddSound( ({"plaetschern"}),
  	"Du lauscht verzueckt dem Plaetschern. Es macht Dich richtig schlaefrig.");

//Smells beschreiben:

  AddSmell(DEFAULT_SMELL,
     "Es riecht hier angenehm nach Salbei.\n");
		//evtl. als command mit unterschiedlichen Duftoelen?

  AddSmell( ({"salbei"}),
  	"Hmmm, riecht lecker!");
  	
//Commands:
   AddCmd( ({"lauf","laufe"}), "cmd_lauf");
}


int cmd_lauf (string str)
  {
int y;
   int i;
   object *player_armour;
   object player_weapon;
   
   notify_fail("Worueber willst Du denn laufen?\n");
   
   if(!str || str == "") return 0;
   
   if(!(str == "ueber boden" || str == "ueber fussboden" || 
        str == "ueber steinboden" || 
        str == "ueber granit")) return 0;
    
   player_armour = TP->QueryProp(P_ARMOURS) - ({ 0 });
    
   y = sizeof(player_armour);
   
   for(i=0;i<y;i++)
    {
      if(player_armour[i]->QueryProp(P_ARMOUR_TYPE)==AT_BOOT) 
      	{  
      	player_armour[i]->DoUnwear(1);
       
        write(BS("Du ziehst Dein Schuhwerk aus und laeufst verzueckt ueber den "
     		"Fussboden. Hach, wie schoen!"));
     	
     	say(BS(CAP_TPN + " zieht das Schuhwerk aus und wandert barfuss durch den Raum."));
    	
     	return 1; 	
		}    
    
    }
    write(BS("Du laeufst verzueckt ueber den "
     		"Fussboden. Hach, wie schoen!"));
     	
    say(BS(CAP_TPN + " wandert barfuss durch den Raum."));
   	
    return 1;
}