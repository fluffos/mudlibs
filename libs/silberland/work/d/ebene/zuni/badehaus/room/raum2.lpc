#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

//Standard-Raum fuers Badehaus
inherit ROOM "std_room.lpc";      
string *geschubbert;

create()
{
  ::create();
   
  SetProp( P_INT_SHORT, "Eine Felsgrotte" );

  SetProp( P_INT_LONG, 
     "Du befindest Dich hier in einer Felsengrotte. Die Waende bestehen "
     "aus poroesem Felsgestein. Scheint so etwas wie Tuffstein zu sein. "
     "Der Boden ist mit einer Schicht von feinem Quarzsand ueberzogen. "
     "In einer Ecke befindet sich eine ovale Wanne.");

//Grundzustand herstellen 
  grundzustand(); 
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

//Details:  
  AddDetail( ({"waende"}),
	"Auch die Waende bestehen aus Tuffstein.");
    
  AddDetail( ({"wand"}),
	"Du erkennst einen Ausgang an der XXXwand.");
  
  AddDetail( ({"grotte","felsengrotte","felsgrotte"}),
     "Du befindest Dich hier in einer Felsengrotte. Die Waende bestehen "
     "aus poroesem Felsgestein. Scheint so etwas wie Tuffstein zu sein. "
     "Der Boden ist mit einer Schicht von feinem Quarzsand ueberzogen."
     "In einer Ecke befindet sich eine ovale Wanne.");
  
  AddDetail( ({"decke"}),
    "Auch die Decke besteht, wie die Waende, aus Tuffstein.");
  
  AddDetail( ({"wanne","badewanne","ecke"}),
	"In der Ecke des Raumes steht eine Wanne aus Tuffstein. Sie ist "
	"oval, ca. 3 Meter lang und 2 Meter breit. In ihr befindet sich "
	"eine milchige Fluessigkeit.");

  AddDetail( ({"fluessigkeit"}),
	"Die Fluessigkeit in der Wanne sieht milchig aus. Mehr kannst Du "
	"durch blosses Schauen nicht erkennen.");
  
  AddDetail( ({"boden"}),
	"Eine Schicht von feinem Quarzsand liegt auf dem Boden. Er ist "
	"ganz trocken und rieselt bestimmt angenehm durch Deine Haende.");
	
  AddDetail( ({"haende"}),
  	"Du schaust Deine Haende an. Schon ganz verschrumpelt.");

  AddDetail( ({"sand","quarzsand"}),
	"Du laesst den Sand durch Deine Finger rieseln. Das fuehlt sich "
	"irgendwie sehr angenehm an. Du koenntest das den ganzen Tag machen.");
		  
  AddDetail( ({"tag"}),
  	"Heute ist ein guter Tag zum Baden.");
	
  AddDetail( ({"baden"}),
  	"Wenn Du baden moechtest, dann steig in die Wanne.");
  	
  AddDetail( ({"Tuff","Tuffstein","fels","felsen","gestein","felsgestein"}),
	"Der Tuffstein fuehlt sich rau an, aber auf eine irgendwie sanfte "
	"Weise, denn die vielen kleinen Poren sind sehr klein. Ausserdem "
	"scheint er abgeschliffen zu sein. Vielleicht koenntest Du Dich an "
	"ihm schubbern?");
  
  AddDetail( ({"poren"}),
	"Poren sind wie kleine Loecher im Gestein.");

  AddDetail( ({"loecher"}),
	"Loecher siehst Du keine, mal abgesehen von den kleinen Poren im "
	"Felsgestein.");


//Sounds beschreiben:

  AddSound(DEFAULT_SOUND,
	"Es ist sehr ruhig hier, Du hoerst nur die von Dir gemachten Geraeusche.\n");

//Smells beschreiben:

  AddSmell(DEFAULT_SMELL,
     	"Es duftet leicht suess-sauer.\n");


   AddCmd( ({"koste"}), "cmd_kosten");
   AddCmd( ({"schubber"}), "cmd_schubbern");
}

reset()
{
 
  ::reset();
  grundzustand();
    
}
  

int grundzustand()
{
 geschubbert=({});
}



int cmd_kosten (string str)
{
  notify_fail("Was moechtest Du kosten?\n");

  if(!str || str == "") return 0;
  
  if(!(str == "fluessigkeit" || str == "fluessigkeit aus wanne" || str == "aus wanne" || 
  	str == "aus badewanne" || str == "fluessigkeit aus badewanne")) return 0;	
    
  	write(BS("Du kostest einen Schluck Fluessigkeit aus der Badewanne. Hm, "
               "scheint Eselsmilch zu sein. Nicht sehr lecker, aber es soll ja gut "
               "fuer die Haut sein."));
    
    say(BS(CAP_TPN + " trinkt einen Schluck Fluessigkeit aus der Badewanne."));
  
    return 1;

}

int cmd_schubbern (string str)
{
	int i;
	
	notify_fail("Woran moechtest Du dich schubbern?\n");
	
	if(!str || str == "") return 0;
	
	if(!(str == "an wand" || str == "dich an wand" || str == "ruecken an wand")) return 0;	
    
  	if(member(geschubbert, getuuid(TP)) == -1)
  		 {
      
         write(BS("Du schubberst mit Deinem Ruecken an der Wand entlang. Das tut gut!"));
  		 say(BS(CAP_TPN + " schubbert mit dem Ruecken an der Wand entlang."));
  		 geschubbert += ({getuuid(TP)});	 
  		 return 1;
  		 
  		 }

     write(BS("Du schubberst noch einmal mit dem Ruecken an der Wand entlang. "
     		  "Autsch, das war zu heftig!"));
      
     say(BS(CAP_TPN + " schubbert mit dem Ruecken an der Wand entlang."));
      
     i=4 + random(4);
        
     SetProp(P_KILL_NAME,"Zuviel Peeling");
        
     TP->do_damage(i);
      
   return 1;
	
}