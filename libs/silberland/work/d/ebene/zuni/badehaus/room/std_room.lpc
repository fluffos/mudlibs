inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"



      create()
      {
        ::create();

     SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
     
     SetProp( P_INT_SHORT, "In einem Badehaus" );
     SetProp( P_INT_LONG, 
        "Du bist irgendwo im Badehaus\n" );
     
     SetProp( P_LIGHT, 1 );
     SetProp( P_INDOORS, 1 );
     
     SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
     
    AddDetail( ({"jodelhue"}),
     "Oh ja, jodelhue, auf jeden Fall.");
     
  AddSpecialExit( "aufgabe", "exit_aufgabe" );

   
      }
int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}