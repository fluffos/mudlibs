#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <moredef.h>
#include "../files.h"

//Standard-Raum fuers Badehaus
inherit ROOM "std_room.lpc";      
int wasser;
  
create()
{
  ::create();
			      

  SetProp( P_INT_SHORT, "Eine finnische Sauna" );

  SetProp( P_INT_LONG, 
     "Du bist in offensichtlich in einer finnischen Sauna. Boden, Waende "
     "und Decke bestehen aus einer Dir unbekannten Holzart. Ringsum sind "
     "Baenke aus Espenholz, die in unterschiedlichen Hoehen angebracht "
     "sind. In der Ecke siehst Du einen Ofen." );
  grundzustand();  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  
 
  AddDetail( ({"sauna"}),
     "Du bist in offensichtlich in einer finnischen Sauna. Boden, Waende "
     "und Decke bestehen aus einer Dir unbekannten Holzart. Ringsum sind "
     "Baenke aus Espenholz, die in unterschiedlichen Hoehen angebracht "
     "sind. In der Ecke siehst Du einen Ofen." );
  
  AddDetail( ({"wand", "waende"}),
     "Die Waende sind mit Kelo verkleidet. Durch die Ritzen kannst Du die "
     "dahinterliegenden Ziegel erahnen." );

  AddDetail( ({"ritzen", "spalten"}),
     "Ueberall dort, wo das Holz nicht direkt nebeneinander liegt, sind "
     "Ritzen und Spalten." );
          
  AddDetail( ({"ziegel", "ziegelwand", "ziegelwaende", "holzverkleidung"}),
     "Hinter der Holzverkleidung scheinen sich Ziegelwaende zu befinden." );
          
  AddDetail( ({"boden","decke"}),
     "Boden und Decke sind mit Kelo ausgekleidet, genau wie die Waende." );
               
  AddDetail( ({"kelo"}),
     "Unter Kelo versteht man das stehend mumifizierte Holz der arktischen "
     "Kiefer. Da es nicht mehr arbeitet, ist es sehr gut zum Bau einer "
     "Sauna geeignet." );
     
  AddDetail( ({"bau"}),
     "Diese Sauna wurde sehr sorgfaeltig gebaut." );
          
  AddDetail( ({"kiefer", "kiefernholz"}),
     "Kiefernholz ist recht verbreitet, auch hier im Silberland." );
          
  AddDetail( ({"silberland"}),
     "Du befindest Dich hier im Silberland." );
          
  AddDetail( ({"holz", "holzart"}),
     "Holz findet sich in diesem Raum fast ueberall. Waende, Decke und "
     "Boden sind aus Kelo, die Baenke aus Espe und im Ofen in der Ecke "
     "scheint auch Holz zu gluehen." );
     
  AddDetail( ({"espe", "espenholz"}),
     "Das Holz der Espe ist leicht und hell. Da es Waerme nicht gut "
     "weiterleitet, ist es gut fuer Sitzgelegenheiten in einer Sauna "
     "geeignet." );
          
  AddDetail( ({"sauna", "raum"}),
     "Du bist in offensichtlich in einer finnischen Sauna. Boden, Waende "
     "und Decke bestehen aus einer Dir unbekannten Holzart. Ringsum sind "
     "Baenke aus Espenholz, die in unterschiedlichen Hoehen angebracht "
     "sind. In der Ecke siehst Du einen Ofen." );
          
  AddDetail( ({"bank", "baenke"}),
     "Die Baenke, die an den Waenden treppenfoermig angebracht sind, "
     "bestehen anscheinend aus Espenholz. Sie sind eigentlich nur "
     "Holzlatten, die mit etwas Abstand auf Winkel genagelt wurden, sehen "
     "aber sehr gemuetlich aus. In einer Ecke liegt noch ein Stoff auf "
     "einer Bank." );
          
  AddDetail( ({"sitzgelegenheit", "sitzgelegenheiten"}),
     "Als Sitzgelegenheit gibt es hier Baenke, auf die man sich jedoch "
     "auch sicher recht bequem legen kann." );
          
  AddDetail( ({"abstand"}),
     "Die Holzlatten sind mit ein paar Zentimeter Abstand auf ein Gestell "
     "genagelt." );
          
  AddDetail( ({"waerme"}),
     "Die Waerme bringt Dich zum Schwitzen. So solls ja auch sein, "
     "schliesslich befindest Du Dich in einer Sauna." );
          
  AddDetail( ({"schwitzen", "schweiss"}),
     "Schwitzen ist sehr gesund. Und frischer Schweiss riecht auch nicht "
     "unangenehm. Hast Du Dich vor der Sauna auch anstaendig gewaschen?" );
          
  AddDetail( ({"zentimeter"}),
     "Ungefaehr soooo lang. Oder breit. Oder so ;-)" );
          
  AddDetail( ({"gestell"}),
     "Das Gestell ist die Basis fuer die Baenke. Es besteht aus Winkeln, "
     "auf die die Holzlatten genagelt sind." );
          
  AddDetail( ({"basis"}),
     "Die Basis fuer die Bank ist das Gestell, auf das die Holzlatten "
     "genagelt sind." );
          
  AddDetail( ({"winkel"}),
     "Die Winkel bilden das treppenfoermige Gestell. Zusammen mit den darauf "
     "genagelten Holzlatten bilden sie die Baenke ringsum." );
          
  AddDetail( ({"holzlatten"}),
     "Die Baenke bestehen aus Holzlatten aus Espenholz." );
          
  AddDetail( ({"stoff"}),
     "Scheint ein Handtuch zu sein." );
          
  AddDetail( ({"handtuch"}),
     "Dieses Handtuch hat wohl ein Gast vor Dir hier vergessen." );
          
  AddDetail( ({"gast"}),
     "Auch Du bist nur ein Gast hier, deswegen solltest Du Dich auch "
     "hier gut benehmen." );
          
  AddDetail( ({"zuber"}),
     "Neben dem Ofen steht ein hoelzerner, mit Wasser gefuellter Zuber. "
     "In ihm siehst Du eine hoelzerne Kelle." );
          
  AddDetail( ({"wasser"}),
     "In dem hoelzernen Zuber befindet sich Wasser. Was man damit wohl "
     "machen kann?" );
          
  AddDetail( ({"kelle"}),
     "Die Kelle dient dazu, Wasser aus dem Zuber auf die heissen Steine auf "
     "dem Ofen zu giessen." );
          
  AddDetail( ({"ofen", "ecke"}),
     "Ein mit Holz befeuerter Ofen, auf dem in einer Schale heisse Steine "
     "liegen, steht in der Ecke. Daneben befindet sich ein hoelzerner "
     "Zuber." );
          
  AddDetail( ({"feuer", "hitze"}),
     "Das Feuer im Ofen glueht nur noch, scheint jedoch ausreichend Hitze "
     "abzugeben, um die Steine heiss zu halten." );
          
  AddDetail( ({"schale"}),
     "In der Schale auf dem Ofen befinden sich heisse Steine." );
          
  AddDetail( ({"steine", "heisse steine"}),
     "Die Steine in der Schale auf dem Ofen scheinen sehr heiss zu sein. "
     "Anfassen moechtest Du sie nicht. Du wunderst Dich, wozu sie da sind." );
          
          
          

//Sounds beschreiben:
     
  AddSound(DEFAULT_SOUND, 
     "Du hoerst nur das Knistern des Feuers im Ofen.\n");

  AddSound( ({"knistern"}),
  	"Es erinnert Dich an Wintertage vor dem Kamin.");

//Smells beschreiben:

  AddSmell(DEFAULT_SMELL,
     "Es riecht leicht nach Holzrauch.\n");

  AddSmell( ({"holzrauch"}),
  	 "Ein angenehmer Geruch.\n");	

  AddSmell( ({"schweiss", "schweissgeruch"}),
  	 "Du schnupperst, es ist jedoch kaum Schweissgeruch zu bemerken.\n");	
//Commands:
  AddCmd( ({"giess", "giesse"}), "cmd_giess");
}

reset()
{
 
  ::reset();
  grundzustand();
    
}
  

int grundzustand()
{
 wasser=0;
 RemoveDetail("dampf");
 AddDetail( ({"dampf"}),
     "Es ist kein Dampf im Raum." );
      
}

int cmd_giess (string str)
{
     
   notify_fail("Was willst Du worauf giessen?\n");
   
   if(!str || str == "") return 0;
   
   if(!(str == "wasser auf steine" || 
        str == "wasser auf heisse steine")) return 0;
   
   if(wasser<5)
   { 
   write(BS("Du giesst etwas Wasser aus dem Zuber auf die heissen Steine. "
   "Sogleich fuellt sich der Raum etwas mit heissem Dampf. Sehr angenehm!"));
     	
   say(BS(CAP_TPN + " giesst etwas Wasser auf die heissen Steine. Sogleich "
   "fuellt sich der Raum mit heissem Dampf. Du faengst an zu Schwitzen."));
   wasser=wasser+1;
   
   switch (wasser)
   {
	   case 1:
	   RemoveDetail("dampf");
	   AddDetail( ({"dampf"}),
     	"Es ist ein wenig Dampf im Raum." );
       break;   
       
   	   case 2:
   	   RemoveDetail("dampf");
	   AddDetail( ({"dampf"}),
     	"Es ist einiger Dampf im Raum." );
       break;   
       
       case 3:
	   RemoveDetail("dampf");
       AddDetail( ({"dampf"}),
     	"Es ist schon einiges an Dampf im Raum. Ganz schoen warm!" );
       break;   
       
   	   case 4:
	   RemoveDetail("dampf");
   	   AddDetail( ({"dampf"}),
     	"Es ist ziemlich viel Dampf im Raum. Du schwitzt ganz schoen." );
       break;   
       
       case 5:
	   RemoveDetail("dampf");
   	   AddDetail( ({"dampf"}),
     	"Es ist sehr viel Dampf im Raum. Du kannst kaum das andere Ende "
     	"des Raumes sehen." );
       break;   
   }
   return 1;
   }
   write(BS("Du ueberlegst, ob Du noch etwas Wasser auf die heissen Steine "
   "giessen solltest, beschliesst jedoch es bleiben zu lassen, da jetzt "
   "bereits recht dichter Dampf den Raum durchzieht."));
     	
   say(BS(CAP_TPN + " nimmt die Schoepfkelle aus dem Zuber, legt sie jedoch "
   "gleich wieder hinein."));
  return 1;
}