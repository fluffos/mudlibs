/*
Dieser NPC soll auf Anfrage einen CSV ausgeben mit diversen Werten des anfragenden 
Spielers, hauptsaechlich fuer den in Entstehung befindlichen Silbertor-Client
Yondala 2.12.2017

*/
inherit "std/mnpc";
//inherit "std/living";
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#include "../def.h"
#include <living.h>


void init()
{::init();


}


void create() {
  
  if (is_clone(this_object()))
    return destruct(this_object());

  if (!this_interactive())
    if (file_name(previous_object())!="/d/ebene/Midas/room/room_f5")
      return destruct(this_object());
  
  
  
  
  ::create();

    SetProp(P_SHORT, "Eine Werbetafel");
  SetProp(P_LONG,"Du siehst eine wandelnde Werbetafel vor Dir.\n"+
  "Die Werbetafel bewirbt den entstehenden neuen Client.\n"+
  "Wenn der Client fertig ist, erfaehrst Du hier mehr darueber.");

  SetProp(P_NAME, "CSV-Ausgabe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"werbetafel", "tafel", ""}));
  SetProp(P_ARTICLE, 1);
  set_living_name("csv");

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit Bits und Bytes",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Byte");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_NOATTACK,1);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG,  " ruft nach Verstaerkung.\n");
  AddInfo(DEFAULT_INFO, "sagt: Mit Dir rede ich nicht!\n");
//  AddInfo("csv", "Teile mir \"csv\" mit und ich sage Dir Deine Werte.","sagt: ");
  
move("/d/ebene/Midas/room/room_f5", M_GO);
}

void catch_tell(string str)
{
  string wer, was;
  object env, spieler;
  int i, scanresult;
  	string daten;
	mapping map;

  // Analyze "teile mit"'s
  // -------------------------------------------------------------------------
  if (sscanf(str, "%s teilt Dir mit: %s\n", wer, was) == 2) 
  {
  	if(!spieler=find_player(lower_case(wer))) return;
 	if(lower_case(was)=="csv")
	{
		CLONE("/players/yondala/obj/csvausgabe", TP);
		//csv_mitteilen(spieler);
	}
		
		else tell_object(spieler, "CSV teilt Dir mit: Teile mir \"csv\" mit.\n");	
  }

}

