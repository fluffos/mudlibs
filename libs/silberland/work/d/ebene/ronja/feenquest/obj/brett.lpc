#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO))return;

  ::create();

  SetProp(P_SHORT, "Ein Brett");
  SetProp(P_LONG,
    "Ein Brett, gerade breit genug, damit man darueber laufen kann."
  );

  SetProp(P_NAME, "Brett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"brett","\nFEENBRETT"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

}


