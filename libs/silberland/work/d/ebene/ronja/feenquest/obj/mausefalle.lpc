#include "../def.h"

inherit "std/thing";

string longtext();

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Mausefalle");
//SetProp(P_LONG, #'longtext );

  SetProp(P_NAME, "Mausefalle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"mausefalle","falle","\nMAUSEFALLE"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:10,MAT_METAL:90]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 10);

  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOSELL,1);

  SetProp(P_MAUSEFALLE, 0);

  AddCmd( ({"steck","stecke","lege","leg"}) ,  "cmd_kaeserein");
  AddCmd( CMD_OEFFNEN,                         "cmd_oeffnen");
  AddCmd( ({"schliesse","schliess"}),          "cmd_schliessen");

}

string _query_long()
{
  string s;

  s = "Eine Mausefalle. Es ist ein Modell, welches aus einem "
      "Drahtkaefig besteht und mit deren Hilfe man Maeuse lebendig "
      "fangen kann. Sie besitzt eine kleine Tuer, die man "
      "oeffnen und schliessen kann. "
  ;

  switch(QueryProp(P_MAUSEFALLE))
  {
    case 1  : s += "Es liegt ein Stueck Kaese darin.";break;
    case 2  : s += "Es ist eine Maus darin gefangen.";break;
  }

  return BS(s);
}

int cmd_kaeserein(string str)
{
  object kaese;

  notify_fail("Was moechtest Du wo hinein legen?\n");

  if(!str || str == "") return 0;

  if(!(str == "kaese in falle"             ||
       str == "kaese in falle hinein"      ||
       str == "kaese in mausefalle"        ||
       str == "kaese in mausefalle hinein" )) return 0;


  if(!(kaese=present("\nFEENKAESE",TP)))
  {
    TELLPLAYER("Du hast doch gar kein geeignetes Stueck Kaese dabei.\n");
    return -1;
  }

  switch(QueryProp(P_MAUSEFALLE))
  {
    case 1 :
      TELLPLAYER("Da ist doch schon ein Stueck Kaese drin!\n");
      break;

    case 2 :
      TELLPLAYER(BS("Dazu muesstest Du die Falle oeffnen und dann wuerde "
                    "Dir die Maus wieder entwischen."
      ));
      break;

    default :
      TELLPLAYER("Du legst das Stueck Kaese in die Mausefalle.\n");
      kaese->remove();
      SetProp(P_MAUSEFALLE,1);
  }

  return 1;
}

int cmd_oeffnen(string str)
{
  object npc;

  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "falle"         ||
       str == "mausefalle"    ||
       str == "mausfalle"     ||
       str == "tuer"          )) return 0;

  switch(QueryProp(P_MAUSEFALLE))
  {
    case 0 : TELLPLAYER("Die Falle ist doch schon offen.\n");break;
    case 1 : TELLPLAYER("Die Falle ist doch schon offen.\n");break;
    case 2 :
      if(!npc=present("\nWILDKATZE",ENV(TP)))
      {
        TELLPLAYER(BS("Du oeffnest die Mausefalle und die Maus springt in "
                      "aller Eile heraus und laeuft weg."
        ));
        SetProp(P_MAUSEFALLE,0);
      }
      else
      {
        ENV(TP)->npcraus();
        SetProp(P_MAUSEFALLE,0);
      }

      break;
  }
  return 1;
}

int cmd_schliessen(string str)
{
  if(!str || str == "") return 0;
  if(!(str == "mausefalle"     ||
       str == "falle"          ||
       str == "tuer"           )) return 0;

  TELLPLAYER("Die Mausefalle schliesst sich ganz von selbst, "
             "wenn eine Maus hineingeht.\n");
  return 1;
}
