#include "../def.h"
#include <food.h>

inherit "/std/food";

void create()
{
  int r,h,f;

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Maiskolben");
  SetProp(P_LONG,
    "Ein leckerer Maiskolben. Prachtvoll gelb leuchten Dich die Maiskoerner "
    "an und warten nur darauf, dass Du sie abknabberst. "
  );

  SetProp(P_NAME, "Maiskolben");
  SetProp(P_GENDER, MALE);
  AddId( ({"gemuese","mais","maiskolben","kolben"}) );

  SetProp(P_SMELL,
    "Als Du an dem Maiskolben riechst, lauft Dir das Wasser im Munde "
    "zusammen."
  );

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 70);

  r = random(10);
  h = 5+r;
  f = 3+r;

  SetProp(P_FOOD_INFO,
    ([ F_HEAL     : ({ h, h }),
       F_SOAK     : f,
       F_MSG      : "Du knabberst genuesslich die Maiskoerner ab.",
       F_MSG_ROOM : "knabbert genuesslich an einem Maiskolben."
     ])
  );

}

