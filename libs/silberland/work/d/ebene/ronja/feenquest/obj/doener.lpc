#include "../def.h"

inherit "std/thing";

int papier;
int nahrung;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein krasser Doener Kebab");
  SetProp(P_LONG,
    "Boah, ein voll krasser Doener Kebab, da guckst Du! Mit voll die coole "
    "scharfe Sauce, wenn man da von essen tut, muss der Arzt kommen! Voll "
    "krass, ey! Mit extra viel Zwiebel!"
  );

  SetProp(P_INFO, "Du denkst nur noch: Schnell wegessen, bevor es ein anderer "
                  "noch sieht!");
  SetProp(P_NAME, "Doener Kebab");
  SetProp(P_GENDER, MALE);
  AddId( ({"doener kebab", "doener", "kebab"}) );

  SetProp(P_NAME_ADJ, ({"krass"}) );
  AddAdjective( ({"krassen","krasser","krassem","krasses","krasse"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:80, MAT_BREAD:10, MAT_MISC_SPICE:10]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"wickel", "wickele", "wickle"}), "cmd_wickeln");
  AddCmd( ({"iss", "esse", "ess"}), "cmd_essen");

  papier  = 1;
  nahrung = 3;
}

int cmd_wickeln(string str)
{
  int n;
  string was;

  notify_fail("Was willst Du auswickeln?\n");

  if(!str || str == "") return 0;

             n = sscanf(str, "%s aus",was);
  if(n != 1) n = sscanf(str, "%s aus papier heraus", was);
  if(n != 1) n = sscanf(str, "%s aus papier", was);

  if(n != 1)   return 0;
  if(!id(was)) return 0;

  if(papier==0)
  {
    TELLPLAYER("Du hast "+name(WEN,1)+" doch schon ausgewickelt.\n");
    return 1;
  }

  TELLPLAYER(BS("Du wickelst "+name(WEN,1)+" hastig aus und kriegst einen "
    "RIESENAPPETIT als Dir der herrliche Duft des Doeners in die Nase "
    "steigt."));
  TELLOTHERS(BS(CTPN+" wickelt einen Doener aus und Dir steigt ein herrlicher "
    "Geruch in die Nase."));
  papier=0;
  return 1;
}

int cmd_essen(string str)
{
  notify_fail("Was willst Du essen?\n");

  if(!str || str == "") return 0;
  if(!id(str))          return 0;

  if(papier==1)
  {
    TELLPLAYER("Du musst "+name(WEN,1)+" erst auswickeln!\n");
    return 1;
  }

  TELLPLAYER(BS("Du beisst herzhaft in "+name(WEN,1)+" hinein. Hmmmmmmmmmmm "
                "saftiges Fleisch, viel Zwiebel, Tomaten und eine "
                "herrliche scharfe Sauce, die Dir den Schweiss auf die "
                "Stirn treibt."
  ));

  TELLOTHERS(BS(CTPN+" beisst herzhaft in "+
          TP->QueryPossPronoun(NEUTER, WEN, SINGULAR)+" "+name(RAW)+
          " und macht dabei einen furchtbar zufriedenen und begeisterten "
          "Eindruck. Du kriegst auch einen RIESENAPPETIT auf Doener Kebab "
          "als Du das siehst."));

  nahrung--;

  if(!nahrung)
  {
    TELLPLAYER(BS("Leider ist der Doener schon alle. Davon koenntest Du "
      "jeden Tag ein ganzes Dutzend essen."
    ));
    call_out("remove",0);
  }

  return 1;
}



