#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein glaeserner Schluessel");
  SetProp(P_LONG,
    "Ein Schluessel aus Glas. Er sieht sehr zerbrechlich aus, daher musst "
    "Du vorsichtig damit umgehen. "
  );

  SetProp(P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, "glaesern");
  AddId(({"schluessel", "glasschluessel","\nGLASSCHLUESSEL"}));
  AddAdjective( ({"glaesern","glaesernen"}) ),
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]) );
}


