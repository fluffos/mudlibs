#include "../def.h"

inherit "std/thing";

string lies_pergament();
string lies_vseite();
string lies_rseite();

string *code;
string nummer;

void create()
{
  string s;
  int i,j,k;

  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Pergament");
  SetProp(P_LONG,
    "Ein altes Pergament, schon etwas vergammelt. Aber noch lesbar. "
  );

  SetProp(P_NAME, "Pergament");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"papier","pergament","\nFEENPERGAMENT"}) );

  SetProp(P_MATERIAL, ([MAT_PAPER:100]) );
  SetProp(P_WEIGHT, 8);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

  SetProp(P_INFO,BS("Das Pergament scheint ein Geheimnis zu haben. Eventuell "
                    "ist es der Schluessel zu etwas."
  ));

  AddDetail( ({"vorderseite"}) ,
    "Auf der Vorderseite befinden sich Schriftzeichen."
  );

  AddDetail( ({"rueckseite"}) ,
    "Auf der Rueckseite befindet sich nur eine Zahlenwueste."
  );

  AddDetail( ({"papier"}) ,
    "Das Pergament ist schon etwas vergilbt und ausgefransst, aber "
    "man kann noch alles darauf erkennen. "
  );

  AddSpecialDetail( ({"schriftzeichen","zeichen"})       , "lies_vorderseite" );

  AddSpecialDetail( ({"zahlenwueste","zahlen","wueste"}) , "lies_rueckseite" );

  AddReadDetail( ({ "pergament" }), #'lies_pergament );

  AddReadDetail( ({"vorderseite"
                  ,"vordere seite"
                  ,"vorderseite von pergament"
                  })              , #'lies_vseite );

  AddReadDetail( ({"rueckseite"
                  ,"hintere seite"
                  ,"rueckseite von pergament"
                  })              , #'lies_rseite );

  code = ({});

  for(i=0;i<7;i++)
  {
    s = "";
    for(j=0;j<24;j++) s += sprintf("%d",random(8)+1);
    code += ({ s });
  }

  if(random(10) > 5)
  {
    k = random(13);
    i = random(3)+2;

    j = k; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";

    j = k + 3;
    code[i-2][j..j] = "0";
    code[i+2][j..j] = "0";

    j++;
    code[i-1][j..j] = "0";
    code[i+1][j..j] = "0";

    nummer = code[i][k+6..k+11];
  }
  else
  {
    k = random(13)+6;
    i = random(3)+2;

    j = k; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";
    j++  ; code[i][j..j] = "0";

    j = k + 2;
    code[i-2][j..j] = "0";
    code[i+2][j..j] = "0";

    j--;
    code[i-1][j..j] = "0";
    code[i+1][j..j] = "0";

    nummer = code[i][k-6..k-1];
  }

  AddCmd( ({"zerreiss","zerreisse"}), "cmd_zerreissen");
}

string QueryNumber()
{
  return nummer;
}

string lies_pergament()
{
  string s;

  s = "Das Pergament hat eine Vorderseite und eine Rueckseite. Welche "
      "Seite moechtest Du denn lesen? ";

  return BS(s);
}

string lies_vseite()
{
  string s;

  s = "                                      .---.   \n"
      "                                     /  .  \\  \n"
      "                                    |\\_/|   | \n"
      "                                    |   |  /| \n"
      "   .--------------------------------------' | \n"
      "  /  Die Frage, sie ist eine Qual          _| \n"
      " <   Wie find ich sie, die Loesungszahl   (   \n"
      "  <  Nichts, Du wirst schon sehen          \\  \n"
      "  <  wird hilfreich Dir zur Seite stehen    | \n"
      "   <                                        | \n"
      "  <  Diese Stellen musst Du finden         /  \n"
      "  <  und geschickt sie dann ergruenden     \\  \n"
      "   < Dann wird fuer's Auge klar von diesen |  \n"
      "   < auf die gesuchte Zahl gewiesen       /   \n"
      "   '-------------------------------------'    \n";

  return s;
}

string lies_rseite()
{
  string s;

  s = "   .----------------------------------.       \n"
      "  /  .-.                               \\      \n"
      " |  /   \\   "+code[0]+"    >\n"
      " | |\\_.  |  "+code[1]+"     >\n"
      " |\\|  | /|  "+code[2]+"     >\n"
      " | `---' |  "+code[3]+"     >\n"
      "  )      |  "+code[4]+"     >\n"
      " |       |  "+code[5]+"     >\n"
      " |       (  "+code[6]+"    >\n"
      "  \\   0  )                             /      \n"
      "   '-----/---.--- ---- ------- ---- --'       \n";

  return s;
}

int cmd_zerreissen(string str)
{
  int i;

  notify_fail("Was moechtest Du zerreissen?\n");

  if(!str || str == "") return 0;
  if(!id(str))          return 0;

  i = random(341)+241;

  TELLPLAYER("Du zerreisst "+name(WEN,1)+" in "+i+" kleine Fetzen!\n");
  TELLOTHERS(BS(CTPN+" zerreisst "+name(WEN,0)+" in "+i+" kleine Fetzen!"));

  remove();
  return 1;
}

