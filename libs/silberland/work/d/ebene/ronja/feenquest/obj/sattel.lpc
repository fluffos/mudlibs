#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein schwarzer Sattel");
  SetProp(P_LONG,
    "Ein schwarzer Ledersattel. Die Sitzflaeche ist schon etwas "
    "abgewetzt. Das Sattelblatt ist lang und gerade, doch wird es "
    "Dir beim Reiten genuegenden Beinfreiheit lassen. Die Steigbuegel "
    "sind hochgezogen. Durch den grossen Sattelkranz wirst Du sicher "
    "reiten koennen, ohne abgeworfen zu werden. "
  );


  AddDetail( ({"sitzflaeche"}) ,
    "Die Sitzflaeche ist schon etwas abgewetzt, so als ob dieser Sattel "
    "schon oft benutzt wurde. "
  );

  AddDetail( ({"sattelblatt","blatt"}) ,
    "Das Sattelblatt schuetzt das Pferd vor Deinen Beinen. Oder doch "
    "andersherum?"
  );

  AddDetail( ({"steigbuegel","buegel"}) ,
    "Die Steigbuegel sind ordentlich hochgezogen und an den Seiten des "
    "Sattels befestigt. "
  );

  AddDetail( ({"sattelkranz","kranz"}) ,
    "Der Sattelkranz verhindert, dass Du beim Reiten vom Sattel rutschst."
  );

  AddId( ({"sattel" , "ledersattel"}) );

  SetProp(P_NAME, "Sattel");

  SetProp(P_NAME_ADJ, ({"schwarz"}) );
  AddAdjective( ({"schwarzen","schwarzer","schwarzem","schwarzes","schwarze"}) );

  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_LEATHER:90,MAT_IRON:10]) );

  SetProp(P_WEIGHT, 8000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,
    BS("Du kannst den Sattel hier nicht ablegen. Wenn Du ihn wieder "
       "loswerden willst, leg ihn schoen wieder dahin zurueck, wo "
       "Du ihn her hast.")
  );
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({"leg","lege","legen"}) , "cmd_legen");
}

int cmd_legen(string str)
{
  int n;
  object ob;
  string wem;

  notify_fail("Wem willst Du den Sattel auf den Ruecken legen?\n");

  if(!(str == "sattel"                    ||
       str == "sattel auf"                ||
       str == "sattel auf pferd"          ||
       str == "sattel auf pferderuecken"  ||
       str == "pferd sattel auf"          )) return 0;

  if(!ENV(TP))
  {
    TELLPLAYER(BS("Du siehst hier kein Pferd, welchem Du das "
                  "Zaumzeug ueberstreifen koenntest."));
    return 1;
  }

  if(!(ob = present("pferd", ENV(TP))))
  {
    TELLPLAYER(BS("Du siehst hier kein Pferd, welchem Du "
                  "den Sattel auflegen koenntest."));
    return 1;
  }

  if(ob->id("wildpferd"))
  {
    TELLPLAYER(BS("Das Wildpferd weicht vor Dir zurueck "
    "und laesst sich keinen Sattel auflegen."));
    return 1;
  }

  return 0;
}


