#include "../def.h"

inherit "std/thing";

string owner;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Ein steinerner Kreis");
  SetProp (P_LONG,
    "Der Steinkreis besteht vollkommen aus Stein, genauer gesagt aus mit "
    "Silberfaeden durchzogenen Marmor."
  );

  AddId (({"kreis", "steinkreis"}));

  SetProp(P_NAME, "Steinkreis");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 20);
  SetProp(P_WEIGHT, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_MARBLE);

  AddDetail( ({"stein"}),
    "Der Kreis besteht aus Marmor.");
  AddDetail( ({"marmor"}),
    "Der Marmor, aus dem der Kreis besteht, ist von schwarzer Farbe und "
    "mit Silberfaeden durchzogen. Irgendwie scheint von dem Kreis eine "
    "eigentuemliche Aura auszugehen.");
  AddDetail( ({"faeden", "silberfaeden"}),
    "Der Marmor ist damit durchzogen.");
  AddDetail( ({"aura"}),
    "Ja, meinst du etwa du kannst sie sehen????");

  owner = 0;
}

void SetOwner(string uuid)
{
  FMASTER->Msg((sprintf("Steinkreis %O => %s", PO, uuid)));
  owner = uuid;
}

string QueryOwner()
{
  return owner;
}

void init()
{
  object pl;

  ::init();

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;
  if(IS_LORD(pl))      return;

  if(owner != getuuid(pl))
  {
     call_out("removeme",0 , pl); 
  }
}

void removeme(object pl)
{
  object room;
  int n;

  n = random(200)+200;

  if(room = ENV(pl))
  {
    tell_room(room, BS("Als "+pl->Name()+" "+TO->name(WEN,1)+" nimmt, "
                       "faellt "+TO->QueryPronoun()+" herunter und "
                       "zerbricht in "+n+" Teile."), ({pl}) );
  }

  if(interactive(pl))
  {
    tell_object(pl, BS("Als Du "+TO->name(WEN,1)+" nimmst, faellt "+
                       TO->QueryPronoun()+" herunter und zerbricht in "+
                       n+" Teile."
                       ));
  }

  remove();
}

