#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(TO))  return;

  ::create();

  SetProp(P_SHORT, "Ein Hutschleier");

  SetProp(P_LONG,
    "Ein Hutschleier. Eigentlich gehoert er an einen dieser langen "
    "Feenhuete. Die Seide flimmert irisierend im Licht, als Du sie durch "
    "Deine Finger gleiten laesst. Auch kannst Du eine gewisse Magie "
    "feststellen, aber diese scheint nicht aus dem Silberland zu kommen."
  );

  SetProp(P_NAME, "Hutschleier");
  SetProp(P_GENDER, MALE);
  AddId( ({"hutschleier","schleier","HUTSCHLEIER"
          ,"\nHUTSCHLEIER","\nFEENQUESTOBJ","QUESTOBJ"}) );

  SetProp(P_MATERIAL, ([MAT_SILK:50, MAT_MISC_MAGIC:50]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 10);

  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOSELL,1);

  AddDetail( ({"seide"}) ,
    "Der Hutschleier besteht aus einer ganz besonders feinen Seide."
  );

  AddDetail( ({"magie"}) ,
    "Die ist nicht von dieser Welt."
  );

  AddDetail( ({"welt"}) ,
    "Du stehst drauf."
  );

  AddDetail( ({"licht"}) ,
    "Das Licht wird von der Seide irisierend zurueckgeworfen."
  );
}


