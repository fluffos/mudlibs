#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Zaumzeug");
  SetProp(P_LONG,
    "Du siehst ein schmuckes Zaumzeug. Der Stirnriemen ist weiss-rot "
    "gestreift. Um es zu benutzen, muss man es einem Pferd ueberstreifen. "
  );

  AddId( ({"zuegel","zaumzeug"}) );

  SetProp(P_NAME, "Zaumzeug");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, ([MAT_LEATHER:90,MAT_MISC_METAL:10]) );

  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 7500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,
    BS("Du wirst doch das Zaumzeug hier nicht einfach hinwerfen wollen. "
       "Wenn Du es wieder loswerden willst, haeng es schoen wieder dahin "
       "zurueck, wo Du es her hast.")
  );
  SetProp(P_NEVERDROP, 1);

  AddDetail( ({"gebissstueck","trense"}),
    "Es besteht aus Stahl und hat auf beiden Seiten grosse Ringe, "
    "durch die es an den Zaumzeugriemen befestigt ist. Die Trense "
    "wird in das Maul des Pferdes geschoben, darueber erhaelt es "
    "die Zuegelhilfen."
  );

  AddDetail( ({"zuegelhilfen"}) ,
    "Wenn man die Zuegel verkuerzt gibt man dem Pferd an, ob man nach "
    "links oder rechts reiten moechte. Dazu muss allerdings die Trense "
    "in das Maul des Pferdes geschoben werden. "
  );

  AddDetail( ({"riemen", "zaumzeugriemen"}),
    "Sie bestehen aus dunklem Leder und sind etwa einen "
    "Fingerbreit dick. An den Raendern ist das Leder "
    "umgeschlagen und zur Verstaerkung der Riemen festgenaeht. "
    "Der etwas breitere Stirnriemen ist mit farbigem Leder verziert, "
    "so dass ein rot-weisses Streifenmuster entsteht. An einigen "
    "der Riemen sind Schnallen befestigt."
  );

  AddDetail( ({"muster", "streifenmuster", "stirnriemen"}),
    "Der Stirnriemen ist breiter als die anderen und auch etwas "
    "dicker. Glaenzendes, rot und weiss gefaerbtes Leder bildet "
    "dort ein rot-weisses Streifenmuster."
  );

  AddDetail( "leder",
    "Alle Riemen des Zaumzeugs bestehen daraus."
  );

  AddDetail( "schnallen",
    "Sie bestehen wie das Gebissstueck aus Stahl und "
    "dienen dazu, das Zaumzeug fuer den Kopf des Pferdes passend "
    "einzustellen."
  );

  AddCmd( ({"streif","streife"}) , "cmd_streifen");
}

int cmd_streifen(string str)
{
  int n;
  object ob;
  string wem;

  if(!ob=present("pferd",ENV(TP)))
  {
    notify_fail("Hier ist doch gar kein Pferd.\n");
    return 0;
  }

  if(ob->id("wildpferd"))
  {
    TELLPLAYER(BS("Das Wildpferd weicht vor Dir zurueck "
    "und laesst sich kein Zaumzeug ueberstreifen."));
    return 1;
  }

  return 0;
}


