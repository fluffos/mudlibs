#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine handvoll Naegel");

  SetProp(P_LONG,
    "Ein paar ganz normale Naegel."
  );

  SetProp(P_PLURAL, 1);
  SetProp(P_NAME, "Naegel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"naegel","\nFEENNAEGEL"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);

}


