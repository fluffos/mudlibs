#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Hutnadel");
  SetProp(P_LONG,
    "Eine Hutnadel. Man benutzt sie, um diverse Dinge an einem Hut zu "
    "befestigen."
  );

  SetProp(P_NAME, "Hutnadel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hutnadel","nadel","\nHUTNADEL"}) );

  SetProp(P_MATERIAL, ([MAT_GOLD:100]) );
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 100);

  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({"befestige","befestig","steck","stecke"}) ,  "cmd_befestigen");
}

int cmd_befestigen(string str)
{
  object hut, schleier;

  notify_fail("Was willst Du woran befestigen?\n");

  if(!(str == "hut an schleier"             ||
       str == "hut an hutschleier"          ||
       str == "feenhut an schleier"         ||
       str == "feenhut an hutschleier"      ||
       str == "schleier an hut"             ||
       str == "hutschleier an hut"          ||
       str == "schleier an feenhut"         ||
       str == "hutschleier an feenhut"      ||
       str == "schleier an hut fest"        ||
       str == "hutschleier an hut fest"     ||
       str == "schleier an feenhut fest"    ||
       str == "hutschleier an feenhut fest" )) return 0;

  if(!(hut=present("\nFEENHUT",TP)))
  {
    TELLPLAYER("Aber Du hast doch gar keinen Feenhut bei Dir!\n");
    return -1;
  }

  if(!(schleier=present("\nHUTSCHLEIER",TP)))
  {
    TELLPLAYER("Du hast doch gar keinen Schleier bei Dir!\n");
    return -1;
  }

  TELLPLAYER("Du befestigst den Schleier mit der Hutnadel an dem Hut.\n");
  TELLOTHERS(TPN+" fummelt an einem Hut herum.\n");
  FMASTER->Msg(TPUID+" befestigt den Schleier am Hut");

  schleier->remove();

  hut->SetProp(P_LONG,
    "Ein Feenhut. Lang und spitz ist er, und an seinem spitzen Ende "
    "ist mit einer goldenen Nadel ein Schleier befestigt."
  );

  hut->AddDetail( ({"nadel","hutnadel","schleier"}) ,
    "Am Ende des Hutes ist mit einer goldenen Nadel ein Schleier befestigt."
  );

  hut->SetProp(P_HUTZUSTAND, 1);

  RemoveCmd( ({"befestige","befestig","steck","stecke"}) );

  call_out("remove",0);
  return 1;
}

