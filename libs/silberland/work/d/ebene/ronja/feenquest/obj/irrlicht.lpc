#include "../def.h"

inherit "std/thing";

#define BURNTIME 240+random(30)

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Irrlicht");
  SetProp(P_LONG,
     "Ein Irrlicht, wie es auch die Feen zum ausleuchten ihres "
     "Schlosses benutzen. Allerdings spendet ein einzelnes Irrlicht "
     "zu wenig Licht, als dass es die Umgebung nennenswert "
     "erhellen koennte."
  );

  SetProp(P_NAME, "Irrlicht");
  SetProp(P_INFO,
    "Ein Irrlicht kann mit dem Befehl <erstrahle> sein ganzes Licht "
    "innerhalb kuerzester Zeit abgeben. Auch in den dunkelsten Raeumen "
    "sollte es damit wieder taghell werden."
  );

  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:20,MAT_MISC_LIVING:5,MAT_LIGHT:75]) );

  AddId( ({"irrlicht"}) );

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 750);
  SetProp(P_NOBUY, 1);
  SetProp(P_LIGHT, 0);

  AddCmd(({"erstrahl","erstrahle"}),"cmd_erstrahlen");
}

int cmd_erstrahlen(string str)
{
  if(QueryProp(P_LIGHT) != 0)
  {
    TELLPLAYER("Das Irrlicht erstrahlt doch schon.\n");
    return 1;
  }

  if(ENV(TO)!=TP)
  {
    TELLPLAYER("Dazu muesstest Du das Irrlicht erst einmal haben.\n");
    return 1;
  }

  SetProp(P_LIGHT,10);
  SetProp(P_SHORT,"Ein strahlendes Irrlicht");
  SetProp(P_VALUE,0);
  TELLPLAYER(BS("Das Irrlicht faengt an sanft zu pulsieren. Auf einmal "
                "gibt es einen grellen Blitz und das Irrlicht erstrahlt."));
  TELLOTHERS(TPN+" laesst ein Irrlicht erstrahlen.\n");

  FMASTER->Msg(TPUID+" laesst ein Irrlicht erstrahlen");
  call_out("verdunkeln",BURNTIME);
  return 1;
}

void verdunkeln()
{
  TELLPLAYER("Das Irrlicht hat sein ganzes Licht fuer Dich verstrahlt "
             "und verschwindet.\n");
  FMASTER->Msg("Das Irrlicht von "+TPUID+" erlischt");
  SetProp(P_LIGHT,0);
  call_out("remove",0);
}


