#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Hammer");

  SetProp(P_LONG,
    "Ein ganz normaler Hammer, wie er zum haemmern benutzt wird."
  );

  SetProp(P_NAME, "Hammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hammer","HAMMER","\nFEENHAMMER"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:80, MAT_IRON:20]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 250);

  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Das ist nur eine Leihgabe vom Oberdiener.\n");
  SetProp(P_NODROP, "Du willst doch nicht eine Leihgabe wegwerfen?\n");
}


