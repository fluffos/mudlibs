#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schleimbaellchen");
  SetProp(P_LONG,
    "Ein Schleimbaellchen aus dem Rachen eines Drachen, gefuellt mit "
    "Marillenmarmelade nach Oma's Rezept. Dieses Baellchen gibt Dir "
    "Kraft falls Du Dich ueberwinden kannst, es zu essen."
  );

  SetProp(P_NAME, "Schleimbaellchen");
  AddId(({"baellchen","schleimbaellchen"}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);
  SetProp(P_MATERIAL, ([MAT_SLIME:50, MAT_FOOD:50]) );
  SetProp(P_FOOD_INFO,
    ([ F_HEAL    : ({ random(15)+10, random(15)+10 }),
       F_SOAK    : random(3)+3,
       F_MSG     : "Du verschluckst Dich fast am Schleimbaellchen.",
       F_MSG_ROOM: "vergreift sich an einem Schleimbaellchen."
     ])
  );


}


