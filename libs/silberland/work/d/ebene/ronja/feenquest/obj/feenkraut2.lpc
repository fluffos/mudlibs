inherit "std/food";
#include <food.h>

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Straeusschen Feenkraut");
  SetProp(P_LONG,
    "Ein Straeusschen Feenkraut. Nur Feen sind in der Lage, Feenkraut zu "
    "finden. Dieses hier hast Du jedoch selbst gepflueckt, ob das wirklich "
    "Feenkraut ist? Vielleicht sieht dieses Kraut einem Feenkraut nur "
    "aehnlich. Du solltest dieses Feenkraut jedenfalls genauer untersuchen. "
  );

  AddId(({"kraut","feenkraut","\nFEENKRAUT"}));

  SetProp(P_NAME, "Feenkraut");
  SetProp(P_GENDER, NEUTER);

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:90,MAT_MISC_POISON:10]) );

  SetProp(P_INFO, BS("Dieses Kraut sieht nur so aus als ob es Feenkraut "
                     "waere. Du bist Dir ganz sicher, dass dieses Kraut "
                     "kein Feenkraut ist. ")
  );

  SetProp(P_FOOD_INFO,
    ([ F_HEAL:     ({ 0, 0 }),
       F_SOAK:     5,
       F_POISON:   1,
       F_MSG:      "Du kaust auf dem Kraut herum und bekommst ein komisches Gefuehl.",
       F_MSG_ROOM: "kaut auf einem Kraut herum und sieht gar nicht gut aus."
     ]));

}


