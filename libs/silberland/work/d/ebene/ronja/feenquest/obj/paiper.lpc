#include "../def.h"

inherit "std/thing";

int deckel;
int anzahl;
int eisda;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Paiper");
  SetProp(P_LONG,
    "Ja, ein echtes Paiper! Genau wie frueher. Du kannst es gar nicht mehr "
    "erwarten, den Pappdeckel zu entfernen, das Eis am Stangerl "
    "herauszuschieben und Dein Paiper aufzuessen. Allein schon der Gedanke "
    "an das fruchtige Zitroneneis mit dem Himbeerstern laesst Dich alles "
    "andere vergessen. Du glaubst sogar, eine leise Stimme zu vernehmen, "
    "die \"Iss mich, Iss mich\" in Dein Ohr fluestert."
  );

  SetProp(P_INFO, "Du denkst nur noch: Schnell wegessen, bevor es Dir "
                  "ein anderer abschwatzt!");

  SetProp(P_NAME, "Paiper");
  SetProp(P_GENDER, NEUTER);

  AddId( ({"paiper", "eis"}) );

  SetProp(P_MATERIAL, ([MAT_CARTON:5, MAT_ICE:95]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 12);
  SetProp(P_NOBUY, 0);

  AddDetail( ({"stangerl"}) ,
    "Unten am Eis ist ein Stangerl angebracht, an dem Du das Eis "
    "herausschieben kannst."
  );

  AddCmd( ({"schiebe", "schieb"})     , "cmd_schieben");
  AddCmd( ({"entfern", "entferne"})   , "cmd_entfernen");
  AddCmd( ({"iss", "esse", "schlecke", "schleck", "lutsch", "lutsche"})
                                      , "cmd_essen");

  anzahl = 4;
  deckel = 1;
  eisda  = 0;
}

cmd_entfernen(string str)
{
  notify_fail("Was willst Du entfernen?\n");

  if(!str || str == "")   return 0;
  if(!(str == "deckel" )) return 0;

  if(deckel)
  {
    TELLPLAYER(BS("Mit einem hastigen Ruck reisst Du Deckel herunter, "
                  "darunter kannst Du schon das leckere Zitroneneis mit "
                  "dem Himbeerstern sehen."));
    TELLOTHERS(BS(TPN+" reisst den Pappdeckel von "+
                  TP->QueryPossPronoun(NEUTER, WEM, SINGULAR)+" Paiper "
                  "herunter."));
  }
  else
  {
    TELLPLAYER("Aber Du hast den Deckel doch schon entfernt!\n");
  }

  deckel = 0;
  return 1;
}

cmd_schieben(string str)
{
  notify_fail("Was willst Du heraus schieben?\n");

  if(!str || str == "") return 0;
  if(!(str == "stangerl"        ||
       str == "stangerl heraus" ||
       str == "eis"             ||
       str == "eis heraus"      ||
       str == "eis hoch"        ||
       str == "stangerl hoch"   )) return 0;

  if(deckel)
  {
    TELLPLAYER(BS("Du solltest zuerst den Deckel entfernen, bevor Du das "
                  "Eis hochschiebst."));

    TELLOTHERS(BS(CTPN+" stellt sich mit "+
                  TP->QueryPossPronoun(NEUTER, WEM, SINGULAR)+" Paiper "
                  "ziemlich ungeschickt an."));
    return 1;
  }

  if(eisda)
  {
    TELLPLAYER(BS("Wenn Du das Eis noch mehr herausschiebst, faellt es Dir "
                  "am Ende heraus!"));
    return 1;
  }

  TELLPLAYER(BS("Du schiebst das Eis etwas heraus. Wie das Zitroneneis mit "
                "dem Himbeerstern Dich anlacht!"));
  TELLOTHERS(BS(CTPN+ " schiebt an dem Stangerl "+
               TP->QueryPossPronoun(NEUTER, WER, SINGULAR)+" Eis etwas "
               "heraus. Dein Verlangen nach einem Paiper wird unbaendig, "
               "als Du das siehst. Du willst auch so ein Paiper haben!"));
  eisda = 1;

  return 1;
}

int cmd_essen(string str)
{
  notify_fail(BS("Woran willst Du schlecken?\n"));

  if(!str || str == "") return 0;
  if(!(str == "paiper"    ||
       str == "an paiper" ||
       str == "eis"       ||
       str == "an eis"    )) return 0;

  if(deckel)
  {
    TELLPLAYER(BS("Da ist doch noch der Deckel drauf! Den solltest Du "
                  "zuerst entfernen."));
    return 1;
  }

  if(!eisda)
  {
    TELLPLAYER(BS("Du musst das Eis schon ein bisschen herausschieben, "
                  "sonst kommst du ja nicht dran."));
    return 1;
  }

  TELLPLAYER(BS("Du schleckst genuesslich an Deinem Paiper. Hmmm... so "
                "richtig schoen lecker-fruchtig nach Zitrone. Eigentlich "
                "willst Du Dir die Eiscreme so richtig langsam auf der "
                "Zunge zergehen lassen, aber Du bist viel zu gierig und "
                "isst eifrig weiter. :)"));

  TELLOTHERS(BS(CTPN+" schleckt an "+
             TP->QueryPossPronoun(NEUTER, WEM, SINGULAR)+" Paiper und "
             "macht dabei einen furchtbar zufriedenen und begeisterten "
             "Eindruck. Buhuu... Du willst auch so ein Paiper haben."));

  anzahl--;
  eisda = 0;
  if(anzahl==0)
  {
    TELLPLAYER(BS("Du schleckst ein letztes Mal an Deinem Paiper... "
                  "schade, es war schon viel zu frueh alle."));
    remove();
  }

  return 1;
}



