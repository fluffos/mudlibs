#include "../def.h"
#include <food.h>

inherit "std/food";

void create()
{
  int n;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Straeusschen Feenkraut");
  SetProp(P_LONG,
    "Ein Straeusschen Feenkraut. Nur Feen sind in der Lage, Feenkraut zu "
    "finden. Es ist sehr selten im Silberland. Ihm wird heilsame Wirkung "
    "nachgesagt."
  );

  AddId(({"kraut","feenkraut","\nFEENKRAUT"}));

  SetProp(P_NAME, "Feenkraut");
  SetProp(P_GENDER, NEUTER);

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:100]) );

  n = random(4); // zufallszahl nur einmal auswuerfeln

  SetProp(P_FOOD_INFO,
    ([ F_HEAL:     ({ 10+n*5, 10+n*5 }),
       F_SOAK:     3+n,
       F_MSG:      "Du isst das Feenkraut und fuehlst Dich sogleich gestaerkt.",
       F_MSG_ROOM: "isst ein Feenkraut und sieht gleich viel kraeftiger aus."
     ]));

}

