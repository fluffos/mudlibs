#include "../def.h"

inherit "std/transport";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleines Boot");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem kleinen Boot. In der Mitte sitzt "
    "Skord, ein Wichtel, der das Boot rudert und Dich gefahrlos "
    "ueber den Silberteich bringen wird. "
  );

  AddId( ({"boot","ruderboot"}) );
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_NAME, "Boot");
  SetProp(P_SHORT, "Ein Boot");
  SetProp(P_LONG, "Ein kleines Ruderboot.");
  SetProp(P_GENDER, NEUTER);

  SetProp(P_LIGHT, 1);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_MAGIC, 0);

  SetProp(P_MATERIAL, ([MAT_OAK:90, MAT_IRON:10]) );

  SetProp(P_DEPARTMSG, ({
    "Skord macht das Boot los, holt die Ruder hervor und stoesst ab.\n",
    "Das Boot stoesst ab.\n"}));

  SetProp(P_ARRIVEMSG, ({
    "Skord verstaut die Ruder und macht das Boot am @@QueryArrived@@ fest.\n",
    "Ein Boot legt an und wird festgemacht.\n"}));

  SetProp(P_ENTERMSG, ({
    "betritt das schwankende Boot",
    "kommt in das Boot"}));

  SetProp(P_LEAVEMSG, ({
    "verlaesst das Boot",
    "betritt den Steg"}));

  SetProp(P_MAX_PASSENGERS, 4);

  SetProp(P_LEAVEFAIL, "Du bist im Moment nicht erpicht auf ein Bad im "
                       "Silberteich");

  SetProp(P_ENTERFAIL, "Leider kann Skord immer nur vier Leute auf einmal "
                       "transportieren");

  AddCmd( ({"steig", "steige", "spring", "springe" }),      "cmd_steigen");
  AddCmd( ({"betrete", "betritt", "besteig", "besteige" }), "cmd_betreten");
  AddCmd( ({"verlass", "verlasse" }),                       "cmd_verlassen");
  AddCmd( ({"wackel","wackele"}),                           "cmd_wackeln");

  AddRoute(ROOM "steg1",   20, 5, "Steg des Silberwaldes",
     ({"steg","silberwald","festland","wald","midas"}),   "zum Silberwald");

  AddMsg("Skord legt die Ruder in die Riemen und rudert los.\n",8);

  AddMsg("Die Riemen aechzen, als Skord sich ins Zeug legt.\n", 10);

  AddMsg("Skord holt die Ruder wieder ein.\n",5);

  AddRoute(ROOM "steg2",   20, 5, "Steg des Feenschlosses",
     ({"hain","feenhain","schloss","feenschloss","park"}),"zum Feenschloss");

  AddMsg("Skord legt die Ruder in die Riemen und rudert los.\n",8);

  AddMsg("Die Riemen aechzen, als Skord sich ins Zeug legt.\n", 5);

  AddMsg("Ein Fisch springt aus dem Wasser und plumpst wieder hinein.\n", 5);

  AddMsg("Skord holt die Ruder wieder ein.\n",5);

  Start();

  AddDetail( ({"boot","ruderboot"}) ,
    "Ein kleines Ruderboot mit fuenf Baenken. In der Mitte sitzt Skord, "
    "der das Boot rudert."
  );

  AddDetail( ({"mitte"}) ,
    "In der Mitte sitzt Skord, der das Boot rudert."
  );

  AddDetail( ({"fisch"}) ,
    "Gerade eben ist ein Fisch aus dem Wasser gesprungen und wieder "
    "hineingeplumpst. Jetzt ist er schon wieder weg. "
  );

  AddDetail( ({"silberteich","teich"}) ,
    "Der befindet sich zum Glueck ausserhalb des Boots. Das Wasser ist "
    "eiskalt, weswegen Du Dich auch lieber rudern laesst anstatt zu "
    "schwimmen."
  );

  AddDetail( ({"bank","baenke"}) ,
    "Auf einer Bank sitzt Du gerade. Wackel nicht so rum, damit das "
    "Boot nicht kentert."
  );

  AddDetail( ({"ruder"}) ,
    "Lange kraeftige Ruder. Skord braucht mit diesen Rudern nur ein paar "
    "Schlaege, damit er am anderen Ufer ankommt."
  );

  AddDetail( ({"glueck"}) ,
    "Ja, es ist grosses Glueck dass Du im Boot sitzt und nicht im Wasser, "
    "sonst waerest Du naemlich pitschnass."
  );

  AddDetail( ({"wasser"}) ,
    "Das Wasser befindet sich gluecklicherweise ausserhalb des Bootes. "
    "Waere es innerhalb des Bootes, so wuerde es vermutlich untergehen."
  );

  AddDetail( ({"riemen"}) ,
    "Stabile Riemen, in denen die Ruder liegen. Sie aechzen leise, wenn "
    "Skord sich ins Zeug legt."
  );

  AddDetail( ({"boden","bootsrumpf"}) ,
    "Unter Dir ist der Bootsrumpf. Du bist froh, dass es der Bootsrumpf "
    "ist und nicht der Teichgrund, denn dann waerest Du ja untergegangen."
  );

  AddDetail( ({"grund","teichgrund"}) ,
    "Der ist weit unter Dir und interessiert Dich im Moment ueberhaupt "
    "nicht."
  );

  AddDetail( ({"sonne","himmel","sonnenlicht"}) ,
    "Die Sonne steht am Himmel und lacht Dich an."
  );

  AddDetail( ({"ufer"}) ,
    "Das kannst Du von hier aus nicht untersuchen."
  );

  AddDetail( ({"eichenholz","holz"}) ,
    "Hart, stabil und solide."
  );

  AddDetail( ({"eisen"}) ,
    "Das werden wohl die Naegel sein."
  );

  AddDetail( ({"naegel"}) ,
    "Die halten das Boot zusammen."
  );

  AddSound(DEFAULT_SOUND, "Leise gleitet das Boot ueber den Teich.");

  AddItem(NPC "skord.lpc", REFRESH_DESTRUCT);

}

int cmd_steigen(string str)
{
  string arg, arg2;
  if (environment() != environment(this_player()) &&
      environment(this_player()) != this_object()) return 0;
  notify_fail("Wo willst Du hinein?\n");
  if (!str) return 0;
  if ((sscanf(str, "%s %s", arg, arg2) != 2) && !id(str)) return 0;
  if (!id(str) && !id(explode(arg2, " ")[0])) return 0;
  if (id(str) || arg=="in")
    return notify_fail("Aber das Boot ist doch gar nicht hier!\n"), Enter();
  if ( id(str) || arg=="von" || arg=="aus")
    return notify_fail("Aber das Boot ist doch gar nicht hier!\n"), Leave();
  return 0;
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Enter();
}

int cmd_verlassen(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Leave();
}

int cmd_wackeln(string str)
{
  if(str == "nicht")
  {
    TELLPLAYER("Ok, Du sitzt ganz ruhig und enspannt auf der Bank.\n");
    FMASTER->Msg(TPUID+" wackelt nicht im Boot");
  }
  else
  {
    TELLPLAYER("DU SOLLST NICHT WACKELN!\n");
    FMASTER->Msg(TPUID+" wackelt im Boot");
  }
  return 1;
}
