#include "../def.h"

inherit "std/thing";

int papier;
int nahrung;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Solero");
  SetProp(P_LONG,
    "Ein super leckeres Eis, das nur noch darauf wartet, von Dir aufgegessen "
    "zu werden!"
  );

  SetProp(P_INFO, "Du denkst nur noch: Schnell wegessen, bevor es ein anderer "
                  "noch sieht!");
  SetProp(P_NAME, "Solero");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"solero", "eis"}) );

  SetProp(P_MATERIAL, ([MAT_CARTON:5, MAT_ICE:95]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

  AddCmd( ({"reiss", "reisse"})    , "cmd_reissen");
  AddCmd( ({"iss", "esse", "schlecke", "schleck", "lutsch", "lutsche"})
                                   , "cmd_essen");

  papier  = 1;
  nahrung = 3;
}

int cmd_reissen(string str)
{
  notify_fail("Was willst Du runterreissen?\n");

  if(!str || str == "") return 0;
  if(!(str == "papier runter"  ||
       str == "papier herunter")) return 0;

  if(papier == 0)
  {
    TELLPLAYER("Du hast das Papier schon total zerfetzt runtergerissen.\n");
    return 1;
  }

  TELLPLAYER(BS("Du reisst mit hastigen Bewegungen das Papier herunter, "
                "dass die Fetzen fliegen."));
  TELLOTHERS(CTPN+" zerfetzt die Verpackung des Soleros.\n");
  papier=0;

  return 1;
}

int cmd_essen(string str)
{
  notify_fail("Woran willst Du schlecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "an solero"    ||
       str == "solero"       ||
       str == "an eis"       ||
       str == "eis"          )) return 0;

  if(papier == 1)
  {
    TELLPLAYER("Du musst das Papier zuerst runterreissen.\n");
    return 1;
  }

  TELLPLAYER(BS("Du schleckst genuesslich an Deinem Solero. Hmmm... so "
                "richtig schoen lecker-fruchtig nach Orange. Eigentlich "
                "willst Du Dir die Eiscreme so richtig langsam auf der "
                "Zunge zergehen lassen, aber Du bist viel zu gierig und "
                "isst eifrig weiter. :)"
  ));

  TELLOTHERS(BS(TPN+" schleckt an "+
          TP->QueryPossPronoun(NEUTER, WEM, SINGULAR)+" Solero und "
          "macht dabei einen "
          "furchtbar zufriedenen und begeisterten Eindruck. Buhuu... Du "
          "willst auch so ein Solero haben."
          ));

  nahrung--;

  if(nahrung < 1)
  {
    TELLPLAYER(BS("Du schleckst ein letztes Mal an Deinem Solero ... schade, "
            "es war schon viel zu frueh alle."));
    call_out("remove",0);
  }

  return 1;
}



