#include "../def.h"

inherit "std/food";

#include <food.h>

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein altes Stueck Kaese");
  SetProp(P_LONG,
    "Ein altes Stueck Kaese, das willst Du bestimmt nicht mehr essen. "
    "Damit kann man allenfalls noch Maeuse fangen."
  );

  SetProp(P_INFO, "Du denkst nur noch: Meine Guete, stinkt der Kaese "
                  "schon!");

  SetProp(P_NAME, ({ "Kaese", "Kaeses", "Kaese", "Kaese" }) );
  SetProp(P_GENDER, MALE);
  AddId( ({"kaese", "stueck","\nFEENKAESE"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SMELL, "Der Kaese stinkt ganz schoen!\n");

  SetProp(P_FOOD_INFO,
    ([ F_HEAL     : ({ 0, 0 }),
       F_SOAK     : 2,
       F_POISON   : 1,
       F_MSG      : "Du isst das Stueck Kaese. Baeeehhh.... war das alt!",
       F_MSG_ROOM : "wuergt ein Stueck Kaese herunter."
     ])
  );
}

void Eating(object pl)
{
  FMASTER->Msg(UID(pl)+" isst das Stueck Kaese");
  return;
}

