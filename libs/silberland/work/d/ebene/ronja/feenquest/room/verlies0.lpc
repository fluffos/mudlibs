#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Verlies" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem dunklen Verlies. Schwer drueckt die "
    "duestere Atmosphaere auf Dein Gemuet. Dieser Teil des Schlosses muss "
    "uralt sein und schon vor Generationen verlassen. Wenn die Waende "
    "doch nur erzaehlen koennten... aber eigentlich willst Du das nicht "
    "wirklich wissen, was sich in frueheren Zeiten hier abgespielt haben "
    "mag. Es ist kuehl und ein wenig feucht hier unten, Dein Atem bildet "
    "in der Luft leichte Wolken. An den Waenden erkennst Du einen gruenen "
    "Schimmer."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"verlies","verlieses"}) , QueryProp(P_INT_LONG));

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus massivem Fels. Vor Jahrhunderten muss dieses "
    "Verlies direkt in den Fels getrieben worden sein. Der Fels ist stark "
    "verwittert, doch sind noch immer einige Bearbeitungsspuren zu erkennen. "
    "Auf dem Boden liegt eine Menge Unrat."
  );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende bestehen wie der Boden und die Decke aus massivem Fels. "
    "Wieviel Arbeit muss es gekostet haben, diese Gaenge in den Fels zu "
    "treiben? Wieviele arme Sklaven mussten ihr Leben lassen, um dieses "
    "Verlies zu erbauen? Wozu wurde es erbaut? Sicherlich waren es die "
    "Kraefte des Boesen, die dieses Verlies entstehen liessen. An den "
    "Waenden erkennst Du einen gruenen Schimmer."
  );

  AddDetail( ({"schimmer","moos","leuchtmoos"}) ,
    "An den Waenden befindet sich etwas Leuchtmoos, das einen gruenlichen "
    "Schimmer abgibt. Gerade soviel, dass Du noch etwas erkennen kannst. "
  );

  AddDetail( ({"decke"}) ,
   "Schwer lastet die Decke ueber Dir. Wenn Du nicht ganz die Orientierung "
   "verloren hast, dann befindest Du Dich irgendwo unter dem Feenschloss. "
   "Die Decke besteht jedoch aus massivem Fels, so dass Du gleich jede "
   "Hoffnung aufgibst, Dich bemerkbar machen zu koennen."
  );

  AddDetail( ({"jahrhundert","jahrhunderten","jahrhunderte"}) ,
    "Eventuell koennte das Verlies auch aus der Altvorderenzeit stammen. "
    "Darueber gibt es jedoch so gut wie keine Aufzeichnungen."
  );

  AddDetail( ({"fels"}) ,
    "Der Fels ist kohlrabenschwarz. Sich hier durchgraben zu wollen, waere "
    "blanker Wahnsinn."
  );

  AddDetail( ({"atmosphaere"}) ,
    "Schwer drueckt die Atmosphaere auf Dein Gemuet. Die alten, feuchten "
    "Mauern tun ihr uebriges, um Dich froesteln zu lassen."
  );

  AddDetail( ({"teil"}) ,
    "Du befindest Dich im aeltesten Teil des Schlosses. Du schaetzt, dass "
    "dieses Verlies bereits in der Altvorderenzeit erbaut wurde und "
    "heutzutage niemand mehr davon weiss-schon gar nicht die jetzigen "
    "Bewohner des Schlosses. Hoffentlich weckst Du keine boesartigen "
    "Kreaturen aus der Unterwelt auf."
  );

  AddDetail( ({"unterwelt"}) ,
    "Du bist Dir sicher, dass es von diesem Verlies aus auch einen Zugang "
    "zur Unterwelt gibt. Da aber die Zeit bis zum naechsten Vollmond knapp "
    "ist, entscheidest Du dich, Deine jetzige Aufgabe zu beenden."
  );

  AddDetail( ({"zugang"}),
    "Da die Zeit draengt, suchst Du lieber nach einem Ausgang statt einem "
    "Zugang zur Unterwelt."
  );

  AddDetail( ({"ausgang"}) ,
    "Hoffentlich findest Du ihn bald."
  );

  AddDetail( ({"kreaturen"}) ,
    "Dir behagt es gar nicht, hier unten in den engen Gaengen des Verlieses "
    "gegen die Kreaturen der Unterwelt zu kaempfen."
  );

  AddDetail( ({"atem","wolken","wolke"}) ,
    "Es ist so kuehl hier, dass Dein Atem als Wolke sichtbar wird."
  );

  AddDetail( ({"wahnsinn"}) ,
    "Es ist besser, wenn Du einen klaren Kopf behaelst."
  );

  AddDetail( ({"kopf"}) ,
    "Er ist noch auf Deinem Hals."
  );

  AddDetail( ({"hals"}) ,
    "Der traegt noch Deinen Kopf."
  );

  AddDetail( ({"vollmond","mond"}) ,
    "Den Mond kannst Du von hier unten natuerlich nicht sehen."
  );

  AddDetail( ({"zeiten","altvorderenzeit","altvorderenzeiten"}) ,
    "Laengst vergangene Zeiten, die nur noch bruchstueckhaft in den "
    "Bibliotheken aufgeschrieben ist."
  );

  AddDetail( ({"bibliothek","bibliotheken"}) ,
    "Hier unten wirst Du keine finden."
  );

  AddDetail( ({"altvorderen"}) ,
    "Grosse Krieger, deren Namen nur noch in der Erinnerung einzelner und "
    "in alten Sagen und Geschichten existieren."
  );

  AddDetail( ({"sagen","geschichten","geschichte"
              ,"aufzeichnungen","aufzeichnung"}) ,
    "Sagen und Geschichten findest Du in Bibliotheken."
  );

  AddDetail( ({"spuren","bearbeitungsspuren"}) ,
    "Trotz des Alters des Verlieses sind noch deutlich die Bearbeitungs"
    "spuren an den Waenden zu erkennen."
  );

  AddDetail( ({"hoffnung"}) ,
    "Du hoffst, bald hier herauszufinden."
  );

  AddDetail( ({"luft"}) ,
    "Die Luft ist muffig und feucht."
  );

  AddDetail( ({"leben"}) ,
    "Du haengst sehr an Deinem Leben."
  );

  AddDetail( ({"feenschloss","schloss","schlosses"}) ,
    "Wenn Du Dich nicht irrst, muesste das genau ueber Dir sein."
  );

  AddDetail( ({"sklave","sklaven"}) ,
    "Jetzt gibt es hier unten keine mehr. Oder doch...?"
  );

  AddDetail( ({"arbeit"}) ,
    "Wozu bloss hat jemand die Arbeit auf sich genommen, dieses Verlies "
    "zu bauen?"
  );

  AddDetail( ({"boese","boesen"}) ,
    "Du hoffst, dass Du keine boesen Kreaturen aufweckst."
  );

  AddDetail( ({"aufgabe"}) ,
    "Du hast andere Aufgaben und solltest Dich einmal darum kuemmern."
  );

  AddDetail( ({"bewohner"}) ,
    "Du hoffst, dass Dir keine \"Bewohner\" des Verlieses ueber den Weg "
    "laufen."
  );

  AddDetail( ({"generationen"}) ,
    "Es scheint schon seit Generationen niemand in diesem Verlies gewesen "
    "zu sein."
  );

  AddDetail( ({"gemuet"}) ,
    "Die Atmosphaere des Verlieses schlaegt Dir aufs Gemuet."
  );

  AddDetail( ({"gaenge","gang"}) ,
    "Du befindest Dich in den Gaengen eines uralten Verlieses."
  );

  AddDetail( ({"kraefte","boese","boesen"}) ,
    "Es muessen die Kraefte des Boesen gewesen sein, die dieses Verlies "
    "erschaffen haben."
  );

  AddDetail( ({"mauer","mauern"}) ,
    "Die Mauern sind direkt aus dem Fels gearbeitet."
  );

  AddDetail( ({"unrat","geroell","menge"}) ,
    "Der liegt ueberall auf dem Boden herum."
  );

  AddDetail( ({"orientierung"}) ,
    "Du hoffst, dass Du die hier unten nicht verlierst."
  );

  AddDetail( ({"zeit"}) ,
    "Die Zeit draengt."
  );

  AddDetail( ({"alter","alters"}) ,
    "Das Verlies muss uralt sein."
  );

  AddDetail( ({"weg"}) ,
    "Der Weg ist uebersaet mit Unrat."
  );

  AddSmell(DEFAULT_SMELL, "Es riecht ziemlich muffig und abgestanden.\n");
  AddSound(DEFAULT_SOUND,
    "*PLOPP* *PLOPP* Irgendwo fallen vermutlich Wassertropfen von der Decke."
  );

  AddSound( ({"wasser","wassertropfen","tropfen"}) ,
    "Du siehst keine, aber Du kannst sie deutlich von Decke fallen hoeren."
  );

  AddCmd( ({"klopf","klopfe"})  , "cmd_klopfen" );
  AddCmd( ({"mache","mach"})    , "cmd_machen"  );
  AddCmd( CMD_DURCHSUCHEN       , "cmd_wuehlen" );
  AddCmd( ({"grabe","grab"})    , "cmd_graben");
  AddCmd( ({"wecke","weck"})    , "cmd_wecken");

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist ... ja was eigentlich?\n");
  return 0;
}

int cmd_machen(string str)
{
  notify_fail("Was willst Du machen?\n");

  if(!str || str == "") return 0;
  if(!(str == "bemerkbar"       ||
       str == "dich bemerkbar"  ||
       str == "mich bemerkbar"  )) return 0;

  TELLPLAYER(BS("Du klopfst an die massive Felsdecke. Natuerlich passiert "
                "nichts. Oder hast Du wirklich geglaubt, dass Dein zartes "
                "Klopfen jemand oben im Schloss hoeren koennte? Aber wer "
                "weiss, welche Kreaturen Du nun hier unten auf Dich "
                "aufmerksam gemacht hast?"
  ));

  return 1;
}

int cmd_klopfen(string str)
{
  notify_fail("Woran willst Du klopfen?\n");

  if(!str || str == "") return 0;
  if(!(str == "wand"         ||
       str == "decke"        ||
       str == "an wand"      ||
       str == "an decke"     )) return 0;


  return cmd_machen("bemerkbar");
}

int cmd_wuehlen(string str)
{
  object ratte;

  notify_fail("Was moechtest Du durchwuehlen?\n");

  if(!str || str == "") return 0;
  if(!(str == "unrat"         ||
       str == "in unrat"      )) return 0;

  if(FMASTER->ratte_erlaubt())
  {
    TELLPLAYER("Du wuehlst im Unrat herum und scheuchst eine Ratte auf.\n");
    TELLOTHERS(TPN+" wuehlt im Unrat herum und scheucht eine Ratte auf.\n");

    ratte=clone_object(NPC "ratte");
    ratte->move(TO, M_GO|M_NOCHECK);
  }
  else
  {
    TELLPLAYER("Du wuehlst im Unrat herum, findest aber nichts.\n");
    TELLOTHERS(TPN+" wuehlt im Unrat herum.\n");
  }

  return 1;
}

int cmd_graben(string str)
{
  notify_fail("Wo willst Du Dich durchgraben?\n");

  if(!str || str == "") return 0;
  if(!(str == "fels"          ||
       str == "durch fels"        ||
       str == "durch felsen"      ||
       str == "felsen"            )) return 0;

  TELLPLAYER(BS("Nein, hier wuerde selbst die Kunst der Zwerge versagen, "
                "sich durch Felsen zu graben.\n"));
  return 1;
}

int cmd_wecken(string str)
{
  TELLPLAYER("Du ueberlegst es Dir anders und weckst doch lieber niemanden "
             "auf.\n");
  return 1;
}
