#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du befindest Dich im Schlosshof des Feenschlosses. Er ist sauber bis "
    "in die letzten Ecken, hier muss gerade frisch gekehrt worden sein. In "
    "der Mitte des Schlosshofes siehst Du einen Brunnen. Der suedoestliche "
    "Turm reckt sich hier in die Hoehe. "
  );

  AddDetail( ({"brunnen"}) ,
    "Der Brunnen liegt im Nordwesten, Du musst schon naeher herangehen. "
  );

  AddDetail( ({"wand"}) ,
    "Vor Dir befindet sich die Wand des suedostliches Turmes. Einige "
    "Steine ragen aus der Wand heraus. "
  );

  AddDetail( ({"hoehe"}) ,
    "Du schaust in die Hoehe und erkennst einen kleinen Erker, der sich "
    "aussen am Turm befindet. "
  );

  AddDetail( ({"erker"}) ,
    "Von hier unten kannst Du zwar den Erker erkennen, doch genaues "
    "siehst Du nicht. "
  );

  AddDetail( ({"turm","turmes","ecke"}) ,
    "Du stehst direkt an der ausseren Ecke des suedostlichen Turmes."
  );

  AddDetail( ({"stein","steine"}) ,
    "Einige Steine ragen aus der Wand heraus. Ob man da wohl nach oben "
    "klettern kann?"
  );

  AddCmd( CMD_KLETTERN, "cmd_klettern");

  AddExit( "norden",     ROOM "bhof6.lpc" );
  AddExit( "westen",     ROOM "bhof8.lpc" );
  AddExit( "nordwesten", ROOM "bhof5.lpc" );
  AddExit( "oben",       ROOM "erker.lpc" );

}

int cmd_klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern\n");

  if(!str || str == "") return 0;
  if(!(str == "oben"      ||
       str == "nach oben" )) return 0;

  TP->command_me("oben");

  return 1;
}




