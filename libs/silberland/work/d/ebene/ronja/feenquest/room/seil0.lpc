#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Seil" );

  SetProp(P_INT_LONG,
    "Du balancierst auf einem Seil."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0) ;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_KILL_NAME,"Ein Sprung aus grosser Hoehe");

  SetProp(P_RAUMUNTEN, ROOM "bhof5.lpc");

  AddDetail( ({"himmel"}) ,
    "Der wolkenlose Himmel erstrahlt in einem sagenhaften Blau. Du blinzelst "
    "mit den Augen."
  );

  AddDetail( ({"wolke","wolken"}) ,
    " Wolkenlos heisst OHNE Wolken !"
  );

  AddDetail( ({"sonne","augen"}) ,
    "Du blinzelst. Schau nicht in die Sonne, dass ist nicht gut fuer Deine "
    "Augen. "
  );

  AddDetail( ({"blau","stahlblau","himmelblau","himmelsblau"}) ,
    "Der Himmel erstrahlt in einem sagenhaften Blau."
  );

  AddDetail( ({"seil"}) ,
    "Du balancierst darauf. Pass bloss auf, dass Du nicht runterfaellst."
  );

  AddCmd( ({"spring","springe","huepf","huepfe"}) , "cmd_springen");
  AddCmd( ({"schau", "schaue", "sieh", "siehe" }) , "cmd_schauen");
}

varargs int PreventInsert(object ob)
{
   if (living(ob)) return ::PreventInsert(ob);

   call_out("runterwerfen", 0, ob);
   return ::PreventInsert(ob);
}

int ende(string str)
{
  write("Nein, der Befehl 'ende' funktioniert hier nicht.\n");
  return 1;
}

void runterwerfen(object ob)
{
  if (!objectp(ob) || ENV(ob)!=TO) return;
  tell_room(TO, ob->Name()+" faellt in die Tiefe.\n");
  tell_room(QueryProp(P_RAUMUNTEN), ob->Name()+" faellt von oben herunter.\n");
  ob->move(QueryProp(P_RAUMUNTEN), M_NOCHECK);
}

int cmd_schauen(string str)
{
  string s, room;
  object *livings, ob;
  int i;

  notify_fail("Wohin moechtest Du schauen?\n");

  if(!str || str == "") return 0;
  if(!(str == "runter"       ||
       str == "nach unten"   ||
       str == "hinunter"     ||
       str == "herunter"     )) return 0;

  for(i=1;i<=9;i++)
  {
    room = ROOM "bhof"+sprintf("%d",i);
    call_other(room, "???"); // raum laden um auch npcs zu laden

    if(ob = find_object(room))
    {
      livings = filter_array(all_inventory(ob), "living");
    }
  }

  s = "Du schaust vorsichtig hinunter auf den Schlosshof. ";

  switch(sizeof(livings))
  {
    case 0 :
      s += "Du siehst aber nichts besonderes.";
      break;

    case 1 :
      s += "Auf dem Schlosshof befindet sich "+livings[0]->name()+".\n";
      break;

    default :
      s += "Auf dem Schlosshof befinden sich "+
            LW(map_objects(livings,"name"))+".\n";

      break;
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(CTPN+" schaut aengstlich hinunter.\n");
  FMASTER->Msg(TPUID+" von dem Seil in den Burghof hinab");
  return 1;
}

int cmd_springen(string str)
{
  TELLPLAYER("Du nimmst allen Mut zusammen und springst von dem Seil.\n");
  TP->move(QueryProp(P_RAUMUNTEN), M_GO,
           "nach unten","faellt","kommt von oben heruntergeplumpst");
  TP->do_damage(-50);
  return 1;
}

