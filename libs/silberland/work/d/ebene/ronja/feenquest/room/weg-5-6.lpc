#include "../def.h"

inherit "std/room";

string ziel;

int exit_test(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein schmaler Pfad");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));

  AddDetail( ({"boden"}) ,
    "Der Boden ist hier ein wenig sandig. Der Pfad auf dem Du laeufst ist "
    "sehr schmal, so dass immer nur eine Person vorbei passt. Links und "
    "rechts des Pfades waechst ein wenig Gras und ein paar Buesche. "
  );

  AddDetail( ({"sand"}) ,
    "Es ist kein Sand wie Du ihn am Meer findest, sondern dieser ist eher "
    "grobkoernig und schmutzig braun. "
  );

  AddDetail( ({"meer"}) ,
    "Das Meer ist weit weg. Ziemlich weit sogar."
  );

  AddDetail( ({"busch","buesche","wegesrand"}) ,
    "Es stehen ein paar Buesche am Wegesrand. Kleine Beeren wachsen an den "
    "Zweigen, die Blaetter sind dick und klein. Irgendwie scheint es, als "
    "ob die Buesche aus einer heisseren Gegend sind und hier gar nicht "
    "hergehoeren. "
  );

  AddDetail( ({"zweige","zweig","zweigen"}) ,
    "An den Zweigen sind dicke, fleischige Blaetter, zwischen denen sich "
    "einige wenige rote Beeren befinden. "
  );

  AddDetail( ({"blatt","blaetter"}) ,
    "Die Blaetter der Buesche sind klein und dick. Das deutet darauf hin "
    "dass sie aus einer heissen Gegend stammen. "
  );

  AddSpecialDetail( ({"gegend"}) , "detail_gegend");

  AddDetail( ({"beere","beeren"}) ,
    "Kleine, rote Beeren. Ob die wohl gesund sind? Du hast ja schon viel "
    "ueber giftige Beeren gehoert. Vielleicht fragst Du jemanden im Schloss "
    "ob man diese Beeren essen kann. "
  );

  AddDetail( ({"gatter","gatters"}) ,
    "Das Gatter trennt den schmalen Weg von einer groesseren Wiese."
  );

  AddDetail( ({"gras"}) ,
    "Diesseits des Gatters ist das Gras eher trocken, so als ob es nicht "
    "richtig wachsen wollte. Jenseits des Gatters jedoch scheint das Gras "
    "lediglich abgefressen, aber deutlich gesuender zu sein. "
  );

  AddDetail( ({"himmel"}) ,
    "Sooft Du auch in den Himmel schaust, ueber dem Feenschloss scheint "
    "immer schoenes Wetter zu herrschen. Ob die Feen das Wetter beeinflussen "
    "koennen?"
  );

  AddSpecialDetail( ({"person"}) , "detail_person" );

  AddDetail( ({"pfad","weg","pfades"}) ,
    "Der Pfad ist recht schmal. Da kann bestimmt immer nur einer "
    "gehen. Wenn sich zwei begegnen, wirds eng. "
  );

  AddDetail( ({"wiese"}) ,
    "Das Gatter hindert Dich daran, die Wiese naeher zu untersuchen. Kletter "
    "halt ueber das Gatter, dann stehst Du mitten auf der Wiese. "
  );

  AddDetail( ({"fee","feen"}) ,
    "Die befinden sich wohl alle im Schloss. Jedenfalls kannst Du hier "
    "draussen keine erkennen."
  );

  AddDetail( ({"feenschloss","schloss","feenschlosses"}) ,
    "Das Feenschloss steht ein paar Schritte Richtung Westen. Geh halt "
    "wieder hinein, wenn Du es erforschen moechtest."
  );

  AddDetail( ({"schritte"}) ,
    "Geh halt ein paar zurueck, dann bist Du wieder im Schloss. "
  );

  AddDetail( ({"wetter"}) ,
    "In der Gegend des Feenschlosses scheint immer schoenes Wetter zu "
    "herrschen. "
  );

  AddDetail( ({"osten"}) ,
    "Im Osten befindet sich eine grosse Wiese."
  );

  AddSpecialExit( "aufgabe", "aufgabe" );
  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );

  AddCmd(CMD_KLETTERN      , "cmd_klettern");
  AddCmd(CMD_UNTERSUCHEN   , "cmd_untersuchen");

  ziel = "koppel3";
}

int exit_test(string str)
{
  return 1;
}

int check_if_living(object ob)
{
  return (living(ob) && !(ob->QueryProp(P_INVIS)));
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

string _query_int_long()
{
  object *ob, room;

  string s;

  ob = ({});

  s = "Du befindest Dich auf einem schmalen Pfad. Im Osten ist eine grosse "
      "Wiese, abgetrennt durch ein Gatter. Der Boden ist leicht sandig, und "
      "es waechst nur spaerlich etwas Gras";

  room = find_object(ROOM+ziel);
  if(room) ob = filter_array(all_inventory(room),"check_if_living");
  switch(sizeof(ob))
  {
     case 0 :
       break;

     case 1 :
       s += ". Jenseits des Gatters befindet sich "+ob[0]->name();
       break;

     default:
       s += ". Jenseits des Gatters befinden sich "+LW(map_objects(ob,"name"));
       break;

  }
  s += ".";
  return BS(s);
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist... ja was eigentlich ?\n");
  return 0;
}

string detail_gegend(string key)
{
  return _query_int_long();
}

string detail_person(string key)
{
  string s;
  object *spieler;

  spieler=filter_array(all_inventory(TO), "check_if_player");

  switch(sizeof(spieler))
  {
     case 0 :
       s = "Du bist invis, gell?";
       break;

     case 1 :
       s = "Du bist allein auf weiter Flur.";
       break;

     default:
       s = "Momentan sind ";
       spieler -= ({TP});
       s += implode(map_objects(spieler,"name"),", ")+
            "und Deine Wenigkeit im Raum.";
       break;
  }
  return BS(s);
}

int cmd_klettern(string str)
{
  notify_fail("Worueber willst Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "gatter"        ||
       str == "ueber gatter"  ||
       str == "ueber brett"   ||
       str == "ueber bretter" ||
       str == "brett"         ||
       str == "bretter"       )) return 0;

  TP->move(ROOM+ziel,M_GO,"ueber das Gatter","klettert",
    "kommt ueber das Gatter geklettert");

  return 1;
}

int cmd_untersuchen(string str)
{
  object room,thing;

  if(!str || str == "") return 0;

  room = find_object(ROOM+ziel);
  if(room && thing=present(str,room) )
  {
    TELLPLAYER(CAP(thing->Name(WER,0))+" steht jenseits vom Gatter.\n");
    return 1;
  }

  return 0;
}


