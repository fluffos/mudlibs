#include "../def.h"

inherit "std/room";

string skriptfalle();

string *bienenstich;
string *bienenstock;

string *vergiftet;
string *geblendet;

int honig;
int apfel;
int feenkraut;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Wiese");
  SetProp(P_INT_LONG,
    "Du stehst auf einer Wiese, die von einzelnen Baeumen umgeben ist. "
    "Tausende von Blumen bluehen im farbigen Sonnenschein. Bunte "
    "Schmetterlinge fliegen von Bluete zu Bluete und sammeln Nektar. "
    "Geschaeftige Bienen fliegen summend umher, sammeln ebenfalls Nektar "
    "und bringen ihn zum Bienenstock. Am Ufer des Silberteiches siehst Du "
    "viele Seerosen. Etwas weiter weg erkennst Du ein Boot. Das wird wohl "
    "Skord sein, der die Besucher des Feenschlosses ueber den Silberteich "
    "rudert. Im Norden befindet sich ein kleines Waeldchen."
    // ", im Sueden steht eine kleine Blockhuette. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_FOREST]) );

  AddSpecialDetail( ({"norden","osten","westen"}) , "detail_richtungen");

  AddDetail( ({"wiese","boden"}) ,
    "Die Wiese ist ganz bunt von den ganzen Blumen, die auf ihr wachsen."
  );

  AddDetail( ({"blumen","blume"}) ,
    "Du findest hier ganz verschiedene Blumen. Dazwischen kannst Du aber "
    "einzelne Kraeuter erkennen. "
  );

  AddDetail( ({"kraeuter"}) ,
    "Ob das beruehmte Feenkraut darunter ist?"
  );

  AddSpecialDetail( ({"feenkraut"}) , "detail_feenkraut");

  AddDetail( ({"sonne"}) ,
    "Leuchtend gelb steht die Sonne am Himmel. Der Sonnenschein laesst "
    "die Blumen auf der Wiese kraeftig aufleuchten und die Bienen und "
    "Schmetterlinge fliegen eifrig umher, um Nektar zu sammeln. "
  );

  AddSpecialDetail( ({"sonnenschein"}) ,  "detail_sonnenschein" );

  AddDetail( ({"himmel"}) ,
    "Wolkenlos und strahleblau. Fast wie im Urlaub."
  );

  AddDetail( ({"urlaub"}) ,
    "Nix da, erst Abenteuer bestehen, dann gibts auch Urlaub."
  );

  AddDetail( ({"abenteuer"}) ,
    "Davon gibt es genug."
  );

  AddDetail( ({"ufer"}) ,
    "Du stehst am Ufer des Silberteiches, und die Sonne spiegelt sich "
    "in seiner Oberflaeche. Silbern schimmert das Wasser dadurch, daher "
    "der Teich wohl auch seinen Namen haben. Nahe dem Ufer wachsen einige "
    "Seerosen. "
  );

  AddDetail( ({"name"}) ,
    "Der Name des Silberteiches ruehrt von der eigenartigen Spiegelung der "
    "Sonne her. Dann und wann sieht der Teich naemlich aus als ob er "
    "aus Silber bestehen wuerde. "
  );

  AddDetail( ({"spiegelung"}) ,
    "Auf der Oberflaeche spiegelt sich die Sonne."
  );

  AddDetail( ({"seerosen","seerose"}) ,
    "Nahe dem Ufer wachsen einige Seerosen, die ihre Blaetter auf dem "
    "Teich ausgebreitet haben. Einige Seerosen haben bereits Knospen "
    "gebildet und es kann nicht mehr lange dauern, bis auch auf dem "
    "Teich ein riesiges Meer an bunten Blueten vorhanden ist. "
  );

  AddDetail( ({"knospen"}) ,
    "Zahllose Knospen haben die Seerosen bereits gebildet, aber noch "
    "bluehen sie nicht. "
  );

  AddDetail( ({"meer"}) ,
    "Nett, nicht? Ein Meer von Blueten auf einem Teich."
  );

  AddDetail( ({"blaetter","blatt"}) ,
    "Meinst Du die Seerosenblaetter oder die Blaetter der Eiche?"
  );

  AddDetail( ({"seerosenblaetter","seerosenblaettern"}) ,
    "Auf einigen Seerosenblaettern sitzen Froesche, welche sich dort "
    "sonnen und auf Fliegen warten. Moment mal... Froesche... und ein "
    "Schloss in der Naehe? War da nicht was mit Prinzen und "
    "Prinzessinnen? "
  );

  AddDetail( ({"fliegen"}) ,
    "Im Moment kannst Du keine sehen. Vermutlich sind die Froesche "
    "sehr hungrig und haben alle schon verpseist. "
  );

  AddDetail( ({"naehe"}) ,
    "Ja, es ist ein Schloss ganz in der Naehe."
  );

  AddSpecialDetail( ({"frosch", "froesche", "prinz", "prinzessin", "prinzen"
                     ,"prinzessinnen"}) ,
    "detail_frosch"
  );

  AddDetail( ({"wasser"}) ,
    "Silbern schimmert das Wasser dort, wo sich die Sonne in ihm spiegelt. "
    "Das Wasser ist klar, dort wo Dich die sich spiegelende Sonne nicht "
    "blendet, kannst Du bis auf den Grund schauen. Das sieht ja richtig "
    "einladend zu einem erfrischenden Bad aus. "
  );

  AddDetail( ({"grund"}) ,
    "Der Grund des Teiches sieht ein wenig schlammig aus. Aber das ist bei "
    "Teichen nunmal so und sollte Dich nicht davon abhalten, ein Bad "
    "im Teich zu nehmen. "
  );

  AddDetail( ({"bad"}) ,
    "Ein Bad im Teich waere jetzt bestimmt erfrischend. "
  );

  AddDetail( ({"teich","silberteich","silberteiches"}) ,
    "Du stehst vor dem Silberteich. Sein Name kommt nicht von ungefaehr, "
    "denn wenn sich die Sonne im richtigen Winkel befindet, sieht der Teich "
    "aus als wenn er aus fluessigem Silber bestehen wuerde. "
  );

  AddDetail( ({"silber"}) ,
    "Wie Silber schaut der Teich aus, wenn die Sonne im richtigen Winkel "
    "darauf scheint. "
  );

  AddDetail( ({"oberflaeche"}) ,
    "Auf der Oberflaeche des Teiches spiegelt sich die Sonne. "
  );

  AddSpecialDetail( ({"winkel"}) , "detail_winkel" );

  AddDetail( ({"skord"}) ,
    "In einiger Entfernung siehst Du Skord, wie er ueber den Silberteich "
    "rudert. "
  );

  AddDetail( ({"boot"}) ,
    "Das Boot das Du auf dem Silberteich erkennen kannst ist wohl das "
    "Boot, mit dem Skord die Besucher des Feenschlosses ueber den "
    "Silberteich rudert. "
  );

  AddDetail( ({"besucher"}) ,
    "Du kannst ganz einfach feststellen, wer im Moment das Feenschloss "
    "besucht: Geh hinein und sieh nach. Von hier aus ist das nur schwer "
    "machbar. "
  );

  AddDetail( ({"moment"}) ,
    "Zack - und schon ist er vorbei."
  );

  AddDetail( ({"entfernung"}) ,
    "Ob nah, ob fern, Du hast alle Wichtel gern."
  );

  AddDetail( ({"wichtel"}) ,
    "Die Wichtel erledigen im Feenschloss einiges, aber niemand weiss, "
    "warum sie das tun, noch warum sie da sind und auch nicht woher "
    "sie kommen. "
  );

  AddDetail( ({"wald","waeldchen"}) ,
    "Selbst Waeldchen ist noch zuviel gesagt, denn es wachsen nur eine "
    "Handvoll Baeume dort. Ein Baum ist allerdings etwas groesser als die "
    "anderen."
  );

  AddDetail( ({"handvoll"}) ,
    "Natuerlich sind es mehr Baeume, als in Deine Hand passen. Das sagt man "
    "halt so."
  );

  AddSpecialDetail( ({"hand"}) , "detail_hand" );

  AddDetail( ({"baum","baeume"}) ,
    "Ein Baum ist etwas groesser, es ist eine noch recht junge Eiche. In "
    "einiger Zeit wird sie wohl gross und maechtig werden. "
  );

  AddDetail( ({"ast","zweig","blaetter"}) ,
    "Die Baeume sind voll davon."
  );

  AddDetail( ({"zeit"}) ,
    "Nein, solange willst Du nun doch nicht warten."
  );

  AddDetail( ({"baeume","baeumen"}) ,
    "Du siehst einige Birken und Weiden, sowie eine junge Eiche und einen "
    "Apfelbaum. "
  );

  AddDetail( ({"birken","weiden"}) ,
    "Die Birken und Weiden wiegen ihre Aeste im Wind. "
  );

  AddDetail( ({"weide"}) ,
    "Du siehst mehrere davon."
  );

  AddDetail( ({"aeste"}) ,
    "Die Aeste wiegen sich etwas im Wind."
  );

  AddDetail( ({"apfelbaum"}) ,
    "Der Apfelbaum ist so schoen, dass Du Dich nicht traust eine seiner "
    "Fruechte zu pfluecken. "
  );

  AddSpecialDetail( ({"frucht","apfel","fruechte","aepfel"}) , "detail_frucht" );

  AddDetail( ({"wind"}) ,
    "Ein angenehm erfrischender Wind weht ueber die Wiese. "
  );

  AddDetail( ({"eiche"}) ,
    "Diese Eiche ist noch recht jung, denn sie ist zwar groesser als "
    "die anderen Baeume, aber bis sie zu einer grossen Eiche "
    "mit einer maechtigen Krone und einem maechtigen Stamm herangewachsen "
    "ist, wird wohl noch einige Zeit vergehen. "
  );

  AddDetail( ({"krone"}) ,
    "Die Krone der Eiche ist schon jetzt imposant. Wie wird es erst sein, "
    "wenn die Eiche ausgewachsen ist? Dicht wachsen die Blaetter, so dass "
    "du von unten nicht erkennen kannst, was sich in der Krone befindet. "
  );

  AddDetail( ({"eichenblatt","eichenblaetter"}) ,
    "Dicht wachsen die Eichenblaetter, so dass Du nicht in das innere "
    "der Krone schauen kannst. "
  );

  AddDetail( ({"stamm"}) ,
    "Der Stamm hat bereits einen betraechtlichen Umfang erreicht. Wie "
    "wird es erst sein, wenn die Eiche zu einem maechtigen Baum "
    "herangewachsen ist?"
  );

  AddDetail( ({"umfang"}) ,
    "Du greifst mit Deinen Armen um den Stamm und kannst ihn noch mit "
    "Leichtigkeit umfassen. "
  );

  AddDetail( ({"arm","arme","armen"}) ,
    "Mit Deinen Armen kannst Du den Umfang der Eiche noch locker abmessen."
  );

  AddDetail( ({"leichtigkeit"}) ,
    "Du hast keine Probleme, den Stamm der Eiche mit Deinen Armen zu "
    "umfassen. "
  );

  AddDetail( ({"problem","probleme"}) ,
    "Du hast doch nicht etwa welche?"
  );

  AddDetail( ({"schmetterlinge","schmetterling"}) ,
    "Einige Schmetterlinge fliegen auf der Wiese hin und her und sammeln "
    "Nektar. Das ist huebsch anzuschauen, denn es sieht aus als ob bunte "
    "Harlekine ueber die Wiese tanzen wuerden. "
  );

  AddDetail( ({"harlekin","harlekine"}) ,
    "Wie bunte Harlekine flattern und torkeln die Schmetterlinge ueber "
    "die Wiese. Das ist lustig anzuschauen. "
  );

  AddDetail( ({"bluete","blueten"}) ,
    "Eine Bluete ist ein Teil einer Blume. "
  );

  AddDetail( ({"teil"}) ,
    "Genaugenommen ist es meist der oberste Teil einer Blume. Der Teil, "
    "der sich der Sonne zuwendet. "
  );

  AddSpecialDetail( ({"biene","bienen"}) , "detail_bienen" );

  AddDetail( ({"nektar"}) ,
    "In einer Bluete befindet sich viel zu wenig Nektar und Du hast viel "
    "zu plumpe Finger, als das Du den Nektar untersuchen koenntest. Aber "
    "Du bist Dir sicher, dass aus diesem Nektar einmal leckerer Honig werden "
    "wird. "
  );

  AddDetail( ({"finger"}) ,
    "Mit solchen Fingern und Deinem Geschick zerdrueckst Du die Bluete "
    "allenfalls."
  );

  AddDetail( ({"geschick"}) ,
    "Das koennte wesentlich besser sein."
  );

  AddDetail( ({"honig"}) ,
    "Honig waechst nicht auf Baeumen und ist auch nicht auf Blumen zu "
    "finden. Bienen sammeln Nektar und bringen ihn dann in ihren "
    "Bienenstock. Dort wird aus dem Nektar dann Honig. "
  );

  AddSpecialDetail( ({"bienenstock"}) , "detail_bienenstock" );

  AddDetail( ({"schloss","feenschloss","feenschlosses"}) ,
    "Das Feenschloss ist ganz in der Naehe."
  );

  AddDetail( ({"nase"}) ,
    "Du bohrst in Deiner Nase und ziehst einen ekligen Popel heraus. "
    "Angewidert schnippst Du ihn weg. "
  );

  AddDetail( ({"popel"}) ,
    "Den hast Du doch gerade weggeschnippt."
  );

  AddDetail( ({"weile"}) ,
    "Pass bloss auf, dass Dir nicht langweilig wird."
  );

  AddDetail( ({"maja"}) ,
    "Ob eine der Bienen wohl Maja heisst?"
  );

  /* AddDetail( ({"huette", "blockhuette"}) ,
    "Du kannst sie nach Sueden hin einfach betreten."
  ); */

  AddSmell(DEFAULT_SMELL,
    "Die Blumen riechen betoerend."
  );

  AddSmell( ({"blumen","duft"}) ,
    "Du riechst an den Blumen und atmest tief ein. Der betoerende Duft "
    "laesst Dich in einen Tagtraum gleiten. Schnell aber schuettelst Du "
    "den Kopf und kommst in die Wirklichkeit zurueck. Du willst Abenteuer "
    "bestehen und nicht tagtraeumen. "
  );

  AddSmell( ({"tagtraum","wirklichkeit","abenteuer"}) ,
    "Meinst Du wirklich, sowas wuerde riechen? Riecht eher nach einem "
    "Skript. "
  );

  AddSmell( ({"skript"}) ,
    "Skripts riechen oft auch an Sachen wie Oxyranopentazol. Das ist "
    "aber stark giftig und fuehrt zum Tode. "
  );

  AddSmell( ({"sachen"}) ,
    "An was genau willst Du riechen?"
  );

  AddSmell( ({"tod"}) ,
    "Der Tod riecht unangenehm. Nach Tod eben. "
  );

  AddSmell( ({"oxyranopentazol"}), #'skriptfalle);

  AddSound(DEFAULT_SOUND,
    "Du hoerst ein paar Bienen ueber die Wiese summen. Am Teich "
    "kannst Du ein paar Froesche quaken hoeren. "
  );

  AddSound( ({"teich"}) ,
    "Am Teich quaken ein paar Froesche. "
  );

  AddSound( ({"wiese"}) ,
    "Auf der Wiese summen ein paar Bienen. "
  );

  AddSound( ({"biene","bienen"}) ,
    "Summmmmmmmmmmmmmm. "
  );

  AddSound( ({"frosch","froesche"}) ,
    "Quaaaaaaaaaak. "
  );

  AddCmd( ({"pflueck","pfluecke"})  , "cmd_pfluecken");
  AddCmd( CMD_BADEN                 , "cmd_baden");
  AddCmd( CMD_GREIFEN               , "cmd_greifen");
  AddCmd( CMD_NEHMEN                , "cmd_nehmen");
  AddCmd( ({"such","suche"})        , "cmd_suchen");
  AddCmd( ({"fang","fange"})        , "cmd_fangen");
  AddCmd( ({"kuess","kuesse"})      , "cmd_kuessen");
  AddCmd( ({"umfass","umfasse"})    , "cmd_umfassen");
  AddCmd( ({"umarm","umarme"})      , "cmd_umfassen");

  AddExit("nordwesten" , ROOM "hain1");

  AddItem("/d/ebene/Silberwald/npc/biber", REFRESH_DESTRUCT);

  bienenstich = ({ }) ;
  bienenstock = ({ }) ;
  vergiftet   = ({ }) ;
  geblendet   = ({ }) ;

  honig     = 1 + random(3);
  apfel     = 4 - honig;
  feenkraut = random(2)+1;

  honig     = 0;
  apfel     = 0;
  feenkraut = 0;
}

void reset()
{
  ::reset();
  bienenstich = ({ }) ;
  bienenstock = ({ }) ;
  vergiftet   = ({ }) ;
  geblendet   = ({ }) ;

  honig     = 1 + random(3);
  apfel     = 4 - honig;
  feenkraut = random(2)+1;

  honig     = 0;
  apfel     = 0;
  feenkraut = 0;

}

void niesen(object pl)
{
  pl->command_me("nies");
}

string skriptfalle()
{
  SetProp(P_KILL_NAME, "Unvorsichtigkeit");
  SetProp(P_KILL_MSG,"Pass demnaechst besser auf!");
  TP->do_damage(1000);
  FMASTER->Msg(TPUID+" stirbt an der Skriptfalle "+file_name(TO));
  return "";
}

string detail_richtungen(string str)
{
  return CAP(str)+" liegt im "+CAP(str)+".\n";
}

string detail_feenkraut(string str)
{
  string s;

  if(feenkraut)
  {
    TELLPLAYER("Hier also waechst das beruehmte Feenkraut.\n");
  }
  else
  {
    TELLPLAYER("Leider kannst Du kein Feenkraut entdecken.\n");
  }
  return BS(s);
}

string detail_frucht(string str)
{
  string s;

  if(apfel)
    s = "Du gehst naeher an den Apfelbaum heran und siehst, dass sich "+
        ({"kein Apfel mehr an ihm befindet. "
         ,"nur noch ein Apfel an ihm befindet. "
         ,"nur noch zwei Aepfel an ihm befinden. "
         ,"drei Aepfel an ihm befinden. "
         ,"vier Aepfel an ihm befinden. "
         })[apfel]

        +"\"Hier muss einer aber "
        "grossen Hunger gehabt haben.\" denkst Du Dir.";
  else
    s = "Du gehst naeher an den Apfelbaum und siehst, dass sich kein "
        "einziger Apfel mehr am Baum befindet. \"Ist schon Erntezeit?"
        "\" fragst Du Dich.";

  TELLOTHERS(CTPN+" geht zum Apfelbaum und schaut ihn sich genau an.\n");
  return BS(s);
}

string detail_frosch(string str)
{
  string s;

  s = "Ob einer der Froesche verzaubert ist? Wenn Du nun einen Frosch "
      "kuessen wuerdest und er sich in ";

  s += (TP->QueryProp(P_GENDER) == FEMALE) ? "einen Prinzen" :
                                             "eine Prinzessin";

  s += " verwandeln wuerde? Wenn Du es nicht versuchst, wirst Du es "
       "nie erfahren.";

  return BS(s);
}

string detail_winkel(string str)
{
  string s;

  if(member(geblendet, getuuid(TP)) == -1)
  {
    s = "Du schaust nochmal auf die Oberflaeche und anschliessend in die "
        "Sonne, um den Winkel festzustellen. Auweh, das war nicht so gut, "
        "denn die Sonne ist recht grell und jetzt siehst Du nur noch grosse "
        "gelbe, rote und orangene Flecken. ";

    TP->SetProp(P_BLIND,([BLIND_TIME:60,BLIND_MSG:BS("Dadurch dass Du mitten "
                "in die Sonne geschaut hast, siehst Du im Moment nur "
                "noch rote Flecken."),BLIND_END_MSG:BS("Langsam verschwinden "
                "die roten Flecken wieder und Du kannst wieder erste Umrisse "
                "erkennen. Du reibst Dir nochmal die Augen und kannst kurze "
                "Zeit spaeter wieder alles erkennen.") ]) );

    geblendet += ({ getuuid(TP) });
    FMASTER->Msg(TPUID+" wird blind weil "+TPP(WER)+" in die Sonne geschaut hat");
  }
  else
  {
    s = "Einmal geblendet zu werden reicht Dir erstmal fuers erste.";
  }

  return BS(s);
}

string detail_hand(string str)
{
  string s;

  if(member(bienenstich, getuuid(TP)) == -1)
  {
    s = "Erschrocken reisst Du Deine Arme hoch und schaust sie Dir an. "
        "Puuuh, beide Haende sind noch dran. Erleichtert atmest Du auf. ";
  }
  else
  {
    s = "Was musstest Du auch in den Bienenstock greifen. Jetzt hast "
        "Du ein paar Bienenstiche abbekommen. Sei halt das naechste "
        "Mal etwas vorsichtiger.";
  }

  return BS(s);
}

string detail_sonnenschein(string str)
{
  string s;

  s = "Die Sonne kitzelt Dich in der Nase ... Ha ... Haaaa ... Haaaaaa ";

  call_out("niesen",0,TP);
  return BS(s);
}

string detail_bienen(string str)
{
  string s;

  s = "Du kniest Dich nieder und beobachtest eine Weile die Bienen, wie sie "
      "so von Bluete zu Bluete fliegen und eifrig Nektar sammeln. Auf einmal "
      "faellt Dir auf, wie Du leise ";

  s += ({"\"Und diese Biene die ich meine nennt sich Maja...\""
        ,"\"Summ, summ, summ, Bienchen summ herum\""
        })[random(2)];

  s += " vor Dich hersummst.";

  FMASTER->Msg(TPUID+" summt ein Kinderlied vor sich hin");
  return BS(s);
}

string detail_bienenstock(string str)
{
  string s;

  if(member(bienenstock,getuuid(TP)) == -1)
  {
    s = "Auf den ersten Blick siehst Du keinen Bienenstock. Such erstmal "
        "einen! ";
  }
  else
  {
    s = "Unzaehlige Bienen schwirren um den Bienenstock herum, doch nun kann "
        "Dich fast nichts mehr davon abhalten in den Bienenstock zu greifen "
        "und Dir ein wenig Honig zu nehmen. ";
  }

  return BS(s);
}

int cmd_pfluecken(string str)
{
  string s;
  object ob;

  notify_fail("Was moechtest Du pfluecken?\n");

  if(!str || str == "") return 0;

  if(str == "blume"         ||
     str == "wiesenblume"   ||
     str == "blumen"        ||
     str == "wiesenblumen"   )
  {

    TELLPLAYER(BS("Du bueckst Dich, um ein paar Blumen zu pfluecken. Im "
                  "letzten Moment jedoch ueberlegst Du es Dir anders, "
                  "denn die Pracht des Bluetenmeeres ist doch zu "
                  "ueberwaeltigend, und wenn jeder anfangen wuerde, hier "
                  "Blumen zu pfluecken, dann wuerde die Wiese doch recht "
                  "schnell ihre Schoenheit verlieren. "
    ));

    TELLOTHERS(BS(CAP(TPN)+" bueckt sich. Ob wohl "+TPPP(MALE,WER,PLURAL)+
                  " Schuhe nicht zugebunden sind? "
    ));
    return 1;
  }

  if(str == "frucht"      ||
     str == "fruechte"    ||
     str == "apfel"       ||
     str == "aepfel"       )
  {
    if(apfel)
    {
      s = "Du gehst zum Apfelbaum und siehst, dass nur noch "
          +(apfel == 1?"ein Apfel daran haengt"
                      :"wenige Aepfel daran haengen")+
          ". Schnellst pflueckst Du Dir einen Apfel ab.";
      ob = clone_object("/d/ebene/rohkopfrex/bauernhof/obj/apfel");
      if(ob->move(TP,M_GET|M_SILENT) == ME_TOO_HEAVY)
      {
        s += "Du traegst jedoch bereits schon so viele Sachen, dass Dir "
             "dieser Apfel zu schwer wird. Daher legst Du ihn erstmal "
             "ab. ";
        ob->move(TO,M_NOCHECK);
      }
      TELLPLAYER(BS(s));
      TELLOTHERS(CTPN+" pflueckt sich einen Apfel.\n");
      FMASTER->Msg(TPUID+" pflueckt sich einen Apfel");
      apfel--;
    }
    else
    {
      TELLPLAYER("Es befinden sich keine Aepfel mehr an dem Baum.\n");
      TELLOTHERS(CTPN+" starrt den Apfelbaum an.\n");
    }
    return 1;
  }

  if(str == "feenkraut"   ||
     str == "kraut"        )
  {
    if(feenkraut)
    {
      s = "Du bueckst Dich und pflueckst Dir schnell eines der seltenen "
          "Feenkraeuter. ";
      ob = clone_object(OBJ "feenkraut");
      if(ob->move(TP,M_GET|M_SILENT) == ME_TOO_HEAVY)
      {
        s += "Du traegst jedoch bereits schon so viele Sachen, dass Dir "
             "selbst dieses kleine Kraeutlein zu schwer wird. "
             "Du Schwaechling! ";
        ob->move(TO,M_NOCHECK);
      }
      TELLPLAYER(BS(s));
      TELLOTHERS(CTPN+" bueckt sich kurz.\n");
      FMASTER->Msg(TPUID+" pflueckt sich ein Feenkraut");
      feenkraut--;
    }
    else
    {
      TELLPLAYER("Es ist leider kein Feenkraut vorhanden.\n");
      TELLOTHERS(CTPN+" starrt auf den Boden.\n");
    }
    return 1;
  }

  return 0;
}

int cmd_suchen(string str)
{
  notify_fail("Wonach moechtest Du suchen?\n");

  if(!str || str == "") return 0;

  if(str == "feenkraut" || str == "kraut")
  {
    if(feenkraut)
    {
      TELLPLAYER(BS("Du suchst sorgfaeltig die ganzen Kraeuter ab und "
                    "tatsaechlich findest Du das aeusserst seltene "
                    "Feenkraut. Du freust Dich."));
      TELLOTHERS(BS(CTPN+" freut sich wie "+
                    (TP->QueryProp(P_GENDER)==FEMALE?"eine Schneekoenigin.":
                                                     "ein Schneekoenig.")));
    }
    else
    {
      TELLPLAYER(BS("Du gibst nicht auf und suchst noch mal alles ganz "
                    "sorgfaeltig ab. Doch so sehr Du auch auch suchst, "
                    "Du findest hier nicht ein einziges Feenkraut. "
      ));
      TELLOTHERS(BS(CTPN+" schaut sich sehr aufmerksam und suchend um. Ob "+
                    TPP(WER)+" etwas verloren hat?"
      ));
    }

    return 1;
  }

  if(!(str == "bienenstock"   ||
       str == "stock"         )) return 0;

  if(member(bienenstock,getuuid(TP)) == -1)
  {
    TELLPLAYER(BS("Du suchst auf der ganzen Wiese umher, kannst aber "
                  "keinen einzigen Bienenstock entdecken. Schliesslich "
                  "faellt Dir auf, dass alle Bienen in Richtung Apfelbaum "
                  "fliegen. Du gehst auf den Apfelbaum zu und entdeckst, "
                  "dass sich hinter dem Apfelbaum ein Bienenstock "
                  "befindet. \"Feen sind aber auch wirklich Naschkatzen\" "
                  "denkst Du Dir noch. "
    ));
    bienenstock += ({ getuuid(TP) }) ;
    FMASTER->Msg(TPUID+" findet den Bienenstock");
  }
  else
  {
    TELLPLAYER(BS("Nachdem Du schon einen Bienenstock gefunden hast, "
                  "suchst Du noch weiter. Ist es Deine Gier nach "
                  "Honig oder nur pure Neugier, die Dich dazu treibt? "
    ));
  }

  TELLOTHERS(CAP(TPN)+" laeuft auf der Wiese ratlos hin und her.\n");
  return 1;
}

int cmd_greifen(string str)
{
  notify_fail("Wo moechtest Du hineingreifen?\n");

  if(!str || str == "") return 0;
  if(!(str == "stock"                  ||
       str == "bienenstock"            ||
       str == "in stock"               ||
       str == "in bienenstock"         ||
       str == "stock hinein"           ||
       str == "bienenstock hinein"     ||
       str == "in stock hinein "       ||
       str == "in bienenstock hinein"  )) return 0;

  if(member(bienenstock, getuuid(TP)) == -1)
  {
    TELLPLAYER(BS("Du siehst hier keinen Bienenstock, wo Du Deine "
                  "Hand hineinstecken koenntest."));
    TELLOTHERS(CAP(TPN)+" fuchtelt wild mit den Haenden in der Luft herum.\n");
    return 1;
  }

  if(honig)
  {
    TELLPLAYER(BS("Du greifst in den Bienenstock und schnappst Dir ein "
                  "wenig Honig, den Du gleich gierig von Deiner Hand "
                  "abschleckst. "
    ));
    TELLOTHERS(CTPN+" schleckt sich die Haende ab.\n");
    TP->AddHp(20);
    TP->AddSp(15);
    honig--;
    FMASTER->Msg(TPUID+" findet Honig im Hain");
    return 1;
  }

  TELLPLAYER(BS("Du greifst in den Bienenstock hinein, aber die Bienen "
                "sind mittlerweile darauf eingestellt und stechen Dich "
                "boese in die Hand. *Autsch* diese Bienenstiche sind aber "
                "auch verdammt unangenehm."
  ));
  TELLOTHERS(BS(CAP(TPN)+" zuckt auf einmal zusammen und glotzt unglaeubig "+
                TPPP(FEMALE,WEN,SINGULAR)+" Hand an."));
  TP->AddHp(-10);
  if(member(bienenstich, getuuid(TP)) == -1) bienenstich += ({ getuuid(TP) }) ;
  FMASTER->Msg(TPUID+" wird von Bienen gestochen");
  return 1;
}

int cmd_kuessen(string str)
{
  notify_fail("Wen moechtest Du kuessen?\n");

  if(!str || str == "") return 0;
  if(!(str == "frosch"         ||
       str == "froesche"       )) return 0;

  if(member(vergiftet,getuuid(TP)) == -1 )
  {
    TELLPLAYER(BS("Du watest etwas in das Wasser hinein, schnappst Dir einen "
                  "Frosch und kuesst ihn. Waeeeh schmeckt der eklig. "
                  "Du schaust Dir den Frosch nochmal genauer an und bemerkst, "
                  "dass Du den beruehmt beruechtigten giftigen Pfeilfrosch "
                  "gekuesst hast. "
    ));
    TP->AddPoison(1);
    vergiftet += ({ getuuid(TP) });
  }
  else
  {
    TELLPLAYER(BS("Du watest etwas ins Wasser und schnappst Dir einen "
                  "Frosch. Du schaust ihn Dir genau an. Uuuuhhh wie "
                  "eklig der aussieht. Du schliesst die Augen, ueber"
                  "windest Deinen Ekel und gibst dem Frosch einen Kuss. "
                  "Stille. Nichts passiert. "
    ));
  }

  TELLOTHERS(BS(CTPN+" watet etwas ins Wasser hinein und kuesst einen der "
                "Froesche. Ob "+TPP(WER)+" noch an Maerchen glaubt? "
  ));
  FMASTER->Msg(TPUID+" kuesst einen Frosch");
  return 1;
}

int cmd_fangen(string str)
{
  notify_fail("Was moechtest Du fangen?\n");

  if(!str || str == "") return 0;

  if(str == "fliege"         ||
     str == "fliegen"        )
  {
    TELLPLAYER(BS("Im Moment kannst Du keine Fliegen entdecken, die Du "
                  "fangen koenntest. "));
    return 1;
  }

  if(str == "frosch"         ||
     str == "froesche"        )
  {
    TELLPLAYER("Die sind Dir viel zu glitschig.\n");
    return 1;
  }

  if(str == "schmetterling"         ||
     str == "schmetterlinge"        )
  {
    TELLPLAYER(BS("Die Schmetterlinge sind viel zu nett anzuschauen."));
    return 1;
  }

  return 0;
}

int cmd_baden(string str)
{
  object *schuhe;
  string s;

  notify_fail("Wo moechtest Du baden?\n");

  if(!str || str == "") return 0;
  if(!(str == "in teich"         ||
       str == "in silberteich"   ||
       str == "im silberteich"   ||
       str == "im teich"         ||
       str == "in see"           ||
       str == "im see"           )) return 0;

  if(TP->QueryProp(P_ARMOURS) )
  {
    schuhe=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_BOOT);
    if (sizeof(schuhe) && objectp(schuhe[0]))
    {
      s = "Du ziehst Dir erstmal Deine Schuhe aus und streckst einen "
          "grossen Zeh in das Wasser. ";
      schuhe[0]->DoUnwear(1);
      schuhe[0]->move(TO,M_NOCHECK);
      FMASTER->Msg(TPUID+" stellt die Schuhe zum baden ab");
    }
    else
    {
      s = "Du streckst ersteinmal einen grossen Zeh in das Wasser. ";
    }
  }

  s += "Brrrrr. Ist das kalt. Da verzichtest Du dann lieber doch auf "
       "ein Bad. ";

  TELLPLAYER(BS(s));

  TELLOTHERS(BS(CTPN+" streckt einen Fuss in das Wasser. Ob "+TPP(WER)+
                " ein Bad im Teich nehmen will?"
  ));
  FMASTER->Msg(TPUID+" prueft das Wasser zum baden");
  return 1;
}

int cmd_nehmen(string str)
{
  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;

  if(str == "honig" ) return cmd_greifen("in bienenstock");

  return 0;
}

int cmd_umfassen(string str)
{
  notify_fail("Was moechtest Du umfassen?\n");

  if(!str || str == "") return 0;
  if(!(str == "stamm"         ||
       str == "baumstamm"         )) return 0;

  TELLPLAYER(BS("Du greifst mit Deinen Armen um den Stamm und kannst ihn "
                "noch mit Leichtigkeit umfassen. "));

  TELLOTHERS(BS(CTPN+"scheint ein wenig verwirrt zu sein, denn "+
                TP->QueryPronoun(WER)+" umarmt einen Baum."));

  return 1;
}


