#include "../def.h"

inherit "/std/room";

#define OK 1
#define KAPUTT 0

int kolben;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Feenschloss" );

  SetProp(P_INT_LONG,
    "Du bist im Feenschloss. Ehrfuerchtig schaust Du Dir die Pracht an. "
    "Du traust Dich fast gar nicht weiterzugehen, denn Du passt in Deinem "
    "Abenteureraufzug so gar nicht in diese Eleganz des Schlosses. Aber da "
    "die Feen als gastfreundlich gelten, hast Du nichts zu befuerchten, "
    "solange Du nichts kaputt machst. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"decke"}) ,
    "An der Decke befinden sich meisterhafte Malereien."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus kostbarem Marmor, der aus fernen Laendern "
    "herbeigeschafft wurde."
  );

  AddDetail( ({"schloss","schlosses","feenschloss"}) ,
    "Du befindest Dich mittendrin."
  );

  AddDetail( ({"pracht","eleganz"}) ,
    "Du bist ueberwaeltigt von der Pracht und Eleganz des Schlosses."
  );

  AddDetail( ({"marmor","sorte"}) ,
    "Der Marmor gehoert zu der edelsten Sorte, die Du bisher gesehen hast. "
    "Schneeweiss und mit einer ganz feinen rosa Maserung."
  );

  AddDetail( ({"maserung"}) ,
    "Du schaust Dir die Maserung an und gruebelst, ob nicht irgendeine "
    "Bedeutung in der Maserung versteckt ist."
  );

  AddDetail( ({"bedeutung"}) ,
    "Du verfolgst die Linien der Maserung, kannst Dir aber noch keinen Reim "
    "draus machen."
  );

  AddDetail( ({"reim","linien"}) ,
    "Aus den Mustern, die die Linien bilden, kannst Du Dir keinen Reim machen."
  );

  AddDetail( ({"muster","mustern"}) ,
    "Die Muster scheinen keinen weiteren Sinn zu ergeben."
  );

  AddDetail( ({"sinn","sinne"}) ,
    "Du schaerfst noch mal Deine Sinne und gruebelst, ob in den Mustern "
    "nicht irgendwelche Dir bekannten Formen vorkommen."
  );

  AddDetail( ({"formen","form"}) ,
    "Du vergleichst die Formen mit allen Dingen die Du so kennst, aber "
    "irgendwie will nichts passen."
  );

  AddDetail( ({"dinge","dingen"}) ,
    "Du hast schon vieles im Silberland gesehen, doch Nichts gleicht diesen "
    "Formen."
  );

  AddDetail( ({"nichts","schluss"}) ,
    "Du kommst zu dem Schluss, dass die Maserung wirklich rein zufaelliger "
    "Natur ist."
  );

  AddDetail( ({"natur"}) ,
    "Die findest Du draussen."
  );

  AddDetail( ({"malerei","malereien","gemaelde"}) ,
    "Die besten Kuenstler aus dem ganzen Silberland muessen hier gewesen "
    "sein. Du staunst mit offenem Mund ueber diese grossartigen Gemaelde."
  );

  AddDetail( ({"laendern","laender"}) ,
    "Auf Deinen weiten Reisen durch ferne Laender ist Dir bisher ein solcher "
    "Marmor noch nicht untergekommen."
  );

  AddDetail( ({"abenteueraufzug","abenteureraufzug","aufzug"}) ,
    "So ganz passt Du in Deinem Aufzug nicht in dieses Schloss."
  );

  AddDetail( ({"kuenstler"}) ,
    "Die muessen aus dem ganzen Silberland angereist sein."
  );

  AddDetail( ({"reisen"}) ,
    "Naja, ein bisschen mehr koenntest Du schon herumgekommen sein, wenn Du "
    "noch nicht mal weisst, wo dieser Marmor herkommt."
  );

  AddDetail( ({"mund"}) ,
    "Mit offenem Mund bestaunst Du die Gemaelde. Mach ihn lieber wieder zu, "
    "sonst fliegt noch eine Fliege hinein."
  );

  AddDetail( ({"fliege"}) ,
    "Zum Glueck ist keine da."
  );

  AddDetail( ({"glueck"}) ,
    "Du hast Glueck, es ist keine Fliege da, die in Deinen Mund fliegen "
    "koennte."
  );

  AddDetail( ({"silberland","silberlandes"}) ,
    "Du befindest Dich im Silberland. Genauer gesagt, im Feenschloss des "
    "Silberlandes."
  );

  AddDetail( ({"bernstein"}) ,
    "Die Waende sind voll damit."
  );

  AddDetail( ({"fee","feen"}) ,
    "Die wohnen hier."
  );

  AddSpecialDetail( ({"wand","waende"})       , "detail_wand");
  AddSpecialDetail( ({"kolben","glaskolben"}) , "detail_kolben");
  AddSpecialDetail( ({"irrlicht","licht","irrlichter"})
                                              , "detail_irrlicht" );

  AddCmd( ({"befreie","befrei"})                    , "cmd_befreien" );
  AddCmd( ({"zerbreche","zerbrich"})                , "cmd_zerbrechen" );
  AddCmd( ({"mach","mache","schliess","schliesse"}) , "cmd_mundzu" );

  kolben = OK;
}

void repariere_kolben(object pl)
{
  if(pl)
  {
    pl->command_me("sage Wieso ist denn hier schon wieder ein Kolben "
                   "kaputt?");
    tell_room(TO,BS("Kurzentschlossen ersetzt der Diener den Kolben und "
                    "steckt wieder einige Irrlichter hinein. "));
  }
  kolben = OK;
  SetProp(P_LIGHT,1);
  FMASTER->Msg("Ein Diener repariert einen Glaskolben");
}

void init()
{
  ::init();

  if(!TP)                        return;
  if(query_once_interactive(TP)) return;

  if(TP->id("kammerdiener") && kolben == KAPUTT)
    call_out("repariere_kolben",0,TP);
}

string detail_wand(string str)
{
  return ((kolben == OK) ? BS("Die Waende bestehen aus Bernstein. Ein "
                              "Glaskolben ist an der Wand befestigt und "
                              "leuchtet in einem eigentuemlichen Licht. ") :
                           BS("Die Waende bestehen aus Bernstein. Ein "
                              "zerbrochener Glaskolben ist an der Wand "
                              "befestigt.")) ;
}

string detail_kolben(string str)
{
  return ((kolben == OK) ? BS("In dem Glaskolben befinden sich einige "
                              "Irrlichter.") :
                           BS("Der Glaskolben ist zerbrochen. Was da wohl "
                              "drinnen war?"));
}

string detail_irrlicht(string str)
{
  return ((kolben == OK) ? BS("In dem Glaskolben befinden sich einige "
                              "Irrlichter, die das Feenschloss beleuchten, "
                              "so dass Du etwas sehen kannst.") :
                           BS("Sowas siehst Du da nicht!")) ;
}

void zerbreche_kolben()
{
  object diener;

  TELLPLAYER(BS("Du zerbrichst den Glaskolben und befreist die Irrlichter. "
                "Jetzt sind zwar die Irrlichter frei, jedoch gibt es in "
                "diesem Teil des Schlosses nun kein Licht mehr, bis sich "
                "ein Diener der Sache annimmt. Benimmt man sich so als Gast?"
  ));
  TELLOTHERS(BS(TPN+" zerbricht den Glaskolben und befreit die Irrlichter. "
                "Dadurch wird es jetzt in diesem Teil des Schlosses dunkel."
  ));
  FMASTER->Msg(TPUID+" zerbricht einen Glaskolben im Schloss");
  SetProp(P_LIGHT,0);
  kolben = KAPUTT;
  if(diener = present("diener",TO))
  {
    diener->command_me("sage Hey! Was soll denn das? Jetzt kann ich wieder "
                       "los und den Kolben ersetzen. Als ob ich nichts "
                       "besseres zu tun haette. ");
    TELLPLAYER("Der Diener tritt Dich.\n");
    TELLOTHERS("Der Diener tritt "+TPN+"\n.");
    diener->wandern();
  }
}

int cmd_zerbrechen(string str)
{
  notify_fail("Was willst Du zerbrechen?\n");

  if(!str || str == "") return 0;

  if(!(str == "kolben" || str == "glaskolben")) return 0;

  if(kolben == KAPUTT)
  {
    TELLPLAYER(BS("Es sind bereits alle Kolben zerbrochen. Jetzt musst "
                  "Du warten, bis sie wieder repariert werden. "));
    return 1;
  }

  zerbreche_kolben();
  return 1;
}

int cmd_befreien(string str)
{
  notify_fail("Was willst Du befreien?\n");

  if(!str || str == "") return 0;

  if(!(str == "irrlicht" || str == "irrlichter")) return 0;

  if(kolben == KAPUTT)
  {
    TELLPLAYER(BS("Alle Kolben sind bereits zerbrochen und alle Irrlichter "
                  "befreit. Jetzt musst Du warten, bis die Kolben wieder "
                  "repariert werden. "));
    return 1;
  }

  zerbreche_kolben();
  return 1;
}

int cmd_mundzu(string str)
{
  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;

  if(!(str == "mund" || str == "mund zu")) return 0;

  TELLPLAYER("Du machst Deinen Mund zu.\n");
  FMASTER->Msg(TPUID+" macht den Mund zu, damit keine Fliege reinkommt");
  return 1;
}

