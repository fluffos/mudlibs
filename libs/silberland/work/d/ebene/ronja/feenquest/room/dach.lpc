#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dach");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf dem Dach des Feenschlosses. Das ist aber ganz "
    "schoen steil hier. Und schluepfrig sind die Schindeln auch. Am besten "
    "kletterst Du wieder nach unten oder nach oben auf den Dachfirst. Da "
    "ist es eventuell sicherer. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"boden","dach"}) ,
    "Du stehst auf den Dachziegeln, mit welchen das Dach des Feenschlosses "
    "gedeckt ist. Zumindest scheinen sie stabil genug zu sein, so dass Du "
    "nicht einbrichst. Allerdings sind sie ein wenig schluepfig, also "
    "sei vorsichtig das Du nicht ausrutscht und zu guter letzt hinunter "
    "faellst. Direkt neben Dir reckt sich der Turm empor. "
  );

  AddDetail( ({"dachfirst","first"}) ,
    "Du koenntest weiter nach oben auf den Dachfirst klettern. Dort oben "
    "scheint es etwas weniger rutschig zu sein als hier auf dem schraegen "
    "Dach. "
  );

  AddDetail( ({"feenschloss","feenschlosses"}) ,
    "Du befindest Dich auf dem Dach des Feenschlosses. "
  );

  AddDetail( ({"himmel"}) ,
    "Der Himmel ist direkt ueber Dir. Dadurch dass Du auf das Dach geklettert "
    "bist, bist Du ihm etwas naeher gekommen. Aber ob das hilfreich ist? "
  );

  AddDetail( ({"schindel","schindeln","ziegel","dachziegel","dachziegeln"}) ,
    "Die Schindeln, mit denen das Dach gedeckt ist, sind etwas schluepfrig. "
    "Ausserdem ist das Dach recht steil. Pass bloss auf, dass Du nicht "
    "herunterfaellst. "
  );

  AddCmd( CMD_KLETTERN      , "cmd_klettern");
}

int cmd_klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern ?\n");

  if(!str || str == "") return 0;

  if(str == "runter"         ||
     str == "nach unten"     )
  {
    TP->move(ROOM "weg4",M_GO,"nach unten","klettert",
      "kommt am Efeu heruntergeklettert");
    return 1;
  }

  if(str == "rauf"         ||
     str == "nach oben"    ||
     str == "auf dachfirst"  )
  {
    TELLPLAYER(BS("Du kletterst weiter nach oben hinauf, um auf den Dachfirst "
                  "zu gelangen. Doch der Schein truegt, auch der Dachfirst "
                  "bietet nicht den Halt den Du erhofft hattest. Du kommst "
                  "ins rutschen und schlidderst die Dachziegel hinunter, "
                  "ueber den Dachrand hinweg ohne eine Chance Dich "
                  "festhalten zu koennen und faellst recht unsanft auf "
                  "den Schlosshof. Schmerzhaft reibst Du Dir dein "
                  "Hinterteil, aber der Sturz vom Dach auf den Schlosshof "
                  "scheint noch mal glimpflich abglaufen zu sein."));

    tell_room(TO,BS(CTPN+" klettert weiter nach oben auf den Dachfirst "
                    "und verschwindet mit einem kurzen Aufschrei auf "
                    "der anderen Seite."),({TP}) );

    tell_room(ROOM "bhof9",BS(CTPN+" faellt von oben auf den Schlosshof "
                           "und reibt sich mit schmerzerfuelltem Gesicht "
                           +TPPP(NEUTER,WEN,SINGULAR)+" Hinterteil. "),({TP}) );
    TP->move(ROOM "bhof9",M_GO|M_SILENT);
    TP->AddHp(-50);
    return 1;
  }

  return 0;
}


