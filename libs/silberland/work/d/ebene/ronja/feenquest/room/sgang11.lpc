#include "../def.h"

inherit ROOM "sgang00.lpc" ;

void create()
{
  ::create();

  AddSound( ({DEFAULT_SOUND}) ,
    "Aus dem Osten kommen Stimmen."
  );

  AddSound( ({"stimmen"}) ,
    "Die kommen aus der Taverne im Osten. Geh doch einfach mal hin."
  );

  AddSound( ({"taverne","osten"}) ,
    "Aus der Taverne im Osten dringen Stimmen."
  );

  AddDetail( ({"taverne"}) ,
    "Die liegt im Osten. Geh doch einfach mal hin."
  );

  AddSmell( ({DEFAULT_SMELL}) ,
    "Typischer Tavernengeruch liegt in der Luft."
  );

  AddSmell( ({"geruch","tavernengeruch"}) ,
    "Die Taverne ist im Osten. Geh doch einfach mal hin."
  );

  AddExit("norden", ROOM "sgang10.lpc");
  AddExit("sueden", ROOM "sgang12.lpc");
  AddExit("westen", ROOM "bhof6.lpc");
  AddExit("osten",  ROOM "taverne.lpc");

  AddItem(NPC "diener.lpc", REFRESH_DESTRUCT);
}

