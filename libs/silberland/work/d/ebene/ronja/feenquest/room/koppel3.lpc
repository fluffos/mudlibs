#include "../def.h"

inherit ROOM "koppel0";

void create()
{
  ::create();

#include "kop_env1_nah.lpc"
#include "kop_env2_weit.lpc"
#include "kop_env3_weit.lpc"
#include "kop_env4_nah.lpc"

  AddExit("osten"      , ROOM "koppel4");
  AddExit("nordosten"  , ROOM "koppel2");
  AddExit("norden"     , ROOM "koppel1");

  AddCmd(CMD_KLETTERN      , "cmd_klettern");
  AddCmd(CMD_SPRINGEN      , "cmd_springen");
  AddCmd(CMD_SCHWIMMEN     , "cmd_schwimmen");

}

void init()
{
  object room;

  ::init();
  if(TP && TP->id("\nFEENPFERD"))
  {
    if(room=find_object(ROOM "weg5"))
    {
      tell_room(room,CAP(TP->Name(WER,0))+" kommt an das Gatter gelaufen.\n");
    }
  }
}

void exit()
{
  object room;

  ::exit();
  if(TP && TP->id("\nFEENPFERD"))
  {
    if(room=find_object(ROOM "weg5"))
    {
      tell_room(room,CAP(TP->Name(WER,0))+" laueft auf die Koppel hinaus.\n");
    }
  }
}

int cmd_klettern(string str)
{
  int stat;
  string s;

  notify_fail("Worueber willst Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "gatter"        ||
       str == "ueber gatter"  ||
       str == "ueber brett"   ||
       str == "ueber bretter" ||
       str == "brett"         ||
       str == "bretter"       )) return 0;

  s = "Hast Du nicht etwas vergessen? ";
  stat = 0;
  stat += (present("sattel",TP)   ? 1 : 0);
  stat += (present("zaumzeug",TP) ? 2 : 0);
  switch(stat)
  {
    case 1 :
      s += "Richtig, den Sattel wolltest Du doch wieder zurueckbringen.";
      break;

    case 2 :
      s += "Richtig, das Zaumzeug. Das wolltest Du doch wieder "
           "zurueckbringen.";
      break;

    case 3 :
      s += "Richtig, Du wolltest doch noch den Sattel und das Zaumzeug "
           "zurueckbringen.";
      break;
  }

  if(stat)
  {
    TELLPLAYER(BS(s));
    TELLOTHERS(CTPN+" scheint ueber etwas nachzudenken.\n");
  }
  else
  {
    TP->move(ROOM "weg5",M_GO,"ueber das Gatter","klettert",
      "kommt ueber das Gatter geklettert.");
  }

  return 1;
}

int cmd_springen(string str)
{
  notify_fail("Worueber willst Du springen?\n");

  if(!str || str == "") return 0;
  if(!(str == "ueber graben"  ||
       str == "graben"        ||
       str == "ueber wasser"  ||
       str == "wasser"        )) return 0;

  TELLPLAYER(BS("Du nimmst etwas Anlauf um ueber den Graben zu springen, "
                "rutschst aber am feuchten Grabenrand aus und legst "
                "laengs hin."));

  TELLOTHERS(BS(CAP(TPN)+" laueft etwas herum und rutscht dann am Graben "
                "aus und legt sich laengs hin."));
  TP->AddHP(-10);
  return 1;
}

int cmd_schwimmen(string str)
{
  object *ob;
  int i,f;
  string s;

  notify_fail("Wo moechtest Du schimmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "hinueber"     ||
       str == "rueber"       ||
       str == "in graben"    ||
       str == "ueber graben" )) return 0;


  ob = TP->QueryProp(P_ARMOURS);
  i = sizeof(ob);
  f = 0;

  while(i--)
  {
    ob[i]->DoUnwear(1);
    if(ob[i]->move(TO,M_PUT|M_SILENT) == 1) f = 1;
  }

  if(f != 0)
  {
    s = "Du ziehst Dir Deine Sachen aus und schaust Dir das Wasser nochmal "
        "an. ";
  }
  else
  {
    s = "Du schaust Dir nochmals das Wasser an. ";
  }

  TELLPLAYER(BS(s + "Eine ziemlich truebe Bruehe. Und die Pferde von "
                "der Koppel werden da wohl auch hinein.... Nein danke, "
                "denkst Du Dir und laesst es dann doch lieber bleiben."));
  TELLOTHERS(CAP(TPN)+" steht nachdenklich am Graben.\n");
  return 1;
}

int IsGrassThere()
{
  return 1;
}


