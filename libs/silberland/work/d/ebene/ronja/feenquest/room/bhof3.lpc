#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  AddDetail( ({"brunnen"}) ,
    "Der Brunnen liegt im Suedwesten, Du musst schon naeher herangehen. "
  );

  AddExit( "westen",      ROOM "bhof2.lpc" );
  AddExit( "sueden",      ROOM "bhof6.lpc" );
  AddExit( "suedwesten",  ROOM "bhof5.lpc" );

}

