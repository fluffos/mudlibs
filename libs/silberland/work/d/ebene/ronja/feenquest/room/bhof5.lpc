#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  SetProp( P_INT_LONG,
    "Du befindest Dich in der Mitte des Schlosshofes. Er ist sauber bis in "
    "die letzten Ecken, hier muss gerade frisch gekehrt worden sein. Ein "
    "alter Brunnen steht hier."
  );

  SetProp(P_KILL_NAME,"Ein Sturz aus grosser Hoehe");

  AddDetail( ({"brunnen"}) ,
    "In der Mitte des Schlosshofes steht ein Brunnen. Er ist von einer "
    "runden Mauer umgeben. Auf der Mauer ist ein starkes Holzgitter "
    "befestigt, wohl damit niemand hinein faellt. Das Holzgitter ist "
    "mit einem starken Vorhaengeschloss gesichert."
  );

  AddDetail( ({"mauer"}) ,
    "Die Mauer besteht aus Natursteinen und ist circa einen halben Meter hoch."
  );

  AddDetail( ({"meter"}) ,
    "Ein Meter hat 100 Zentimeter."
  );

  AddDetail( ({"zentimeter"}),
    "100 Zentimeter ergeben exakt einen Meter."
  );

  AddDetail( ({"naturstein","natursteine","natursteinen"}) ,
    "Die stammen aus der Umgebung des Schlosses."
  );

  AddDetail( ({"umgebung"}) ,
    "Sieh sie Dir doch einfach an !"
  );

  AddDetail( ({"holzgitter","gitter"}),
    "Das Holzgitter sieht sehr stabil aus, das duerftest Du noch nicht mal "
    "mit einer grossen Axt aufbrechen koennen."
  );

  AddDetail( ({"vorhaengeschloss"}),
    "Du brauchst einen Schluessel, um es zu oeffnen."
  );

  AddExit( "norden",      ROOM "bhof2.lpc" );
  AddExit( "osten",       ROOM "bhof6.lpc" );
  AddExit( "sueden",      ROOM "bhof8.lpc" );
  AddExit( "westen",      ROOM "bhof4.lpc" );
  AddExit( "nordosten",   ROOM "bhof3.lpc" );
  AddExit( "suedosten",   ROOM "bhof9.lpc" );
  AddExit( "suedwesten",  ROOM "bhof7.lpc" );
  AddExit( "nordwesten",  ROOM "bhof1.lpc" );

  AddCmd("brech|breche|brich&schloss|gitter|holzgitter|brunnen",
    "cmd_brechen",
    "Was moechtest Du ausbrechen?\n"
  );

  AddItem(NPC "diener", REFRESH_DESTRUCT);
  AddItem(OBJ "papier", REFRESH_DESTRUCT);
}

int cmd_brechen(string str)
{
  tell_object(TP, BS("Du versuchst das Holzgitter aufzubrechen, doch es "
                     "wiedersteht allen Deinen Bemuehungen."));

  tell_room(TO, BS(TP->Name(WER, 1)+" zerrt an dem Holzgitter auf dem "
                   "Brunnen herum, bricht dann aber erfolgrlos ab."),
                ({ TP }) );

  return 1;
}


