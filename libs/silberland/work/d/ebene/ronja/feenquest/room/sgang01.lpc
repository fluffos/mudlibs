#include "../def.h"

inherit "std/room";

#define OFFEN 1
#define ZU 0
#define DA 1
#define WEG 0

int schrank;
int besen;
int quietschen;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Abstellkammer" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer Abstellkammer. Hier deponieren die Diener "
    "ihr Werkzeug und was sie sonst noch so brauchen, um das Schloss in "
    "Ordnung zu halten. Du siehst einen Schrank, ein Regal und an der "
    "Suedwand mehrere Haken. Weiterhin steht eine Kiste im Raum."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"schloss"}) ,
    "Du befindest Dich in ihm."
  );

  AddDetail( ({"kammer","abstellkammer","raum"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"ordnung"}) ,
    "Alles ist ordentlich in Regalen und Schraenken verstaut."
  );

  AddDetail( ({"diener"}) ,
    "Im Schloss gibt es jede Menge Diener, die fuer Ordnung sorgen."
  );

  AddDetail( ({"menge"}) ,
    "Naja, einige halt."
  );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus einfachen Fliesen."
  );

  AddDetail( ({"fliesen"}) ,
    "Einfache, schlichte Fliesen, aber trotzdem irgendwie nett anzuschauen."
  );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende sind mit Regalen und Schraenken zugestellt. An der Suedwand "
    "befinden sich mehrere Haken. "
  );

  AddDetail( ({"suedwand"}) ,
    "An der Suedwand haengen mehrere Haken."
  );

  AddDetail( ({"regal","regale"}) ,
    "Auf den Regalen befindet sich nichts von Interesse."
  );

  AddDetail( ({"interesse"}) ,
    "Du zeigst Interesse fuer die Regale, aber ehrlich: es befindet sich "
    "wirklich nichts wichtiges darauf."
  );

  AddDetail( ({"decke"}) ,
    "Die Decke ist hier lediglich mit Holz verkleidet."
  );

  AddDetail( ({"holz"}) ,
    "Das Holz ist helles Kiefernholz."
  );

  AddDetail( ({"kiefernholz"}) ,
    "Du erkennst es an den vielen Astloechern."
  );

  AddDetail( ({"eichenholz","holz"}) ,
    "Der Schrank ist aus guten alten Eichen gezimmert."
  );

  AddDetail( ({"eichen","eiche"}) ,
    "Die Eiche, deren Holz du hier siehst, wurde schon vor langer Zeit "
    "gefaellt."
  );

  AddDetail( ({"´Zeit"}) ,
    "Vor langer, langer Zeit!"
  );

  AddDetail( ({"lange zeit","langer zeit"}) ,
    "Es ist wirklich schon sehr lange her, dass die Eiche gefaellt wurde, "
    "deren Holz Du hier verarbeitest siehst."
  );

  AddDetail( ({"astloch","astloecher","astloechern"}) ,
    "Kiefernholz ist beruehmt beruechtigt wegen seiner vielen Astloecher."
  );

  AddDetail( ({"tuer","tueren","eiche","schranktuer","schranktueren"}) ,
    "Die Schranktueren sind aus massiver Eiche."
  );

  AddDetail("kiste",
     "Sie scheint etwas Wertvolles zu verbergen, doch ist sie mit "
     "Nichts auf der Welt zu oeffnen."
  );

  AddDetail( ({"nichts", "welt"}),
    "Die Kiste ist mit Nichts auf der Welt zu oeffnen."
  );

  AddDetail( ({"wertvolles"}) ,
      "Man kann nichts genaueres erkennen."
  );

  AddDetail( ({"sachen"}) ,
    "Davon siehst Du eine Menge."
  );

  AddDetail( ({"menge"}) ,
    "Viele Sachen eben."
  );

  AddDetail( ({"handwerker"}) ,
    "Mal wieder typisch, wenn man einen braucht, ist keiner da."
  );

  AddDetail( ({"abenteurer"}) ,
    "Schau Dich an, dann weisst Du doch schon alles."
  );

  AddSpecialDetail( ({"besen"})                  , "detail_besen");
  AddSpecialDetail( ({"haken"})                  , "detail_haken");
  AddSpecialDetail( ({"schrank","schraenke","schraenken"})
                                                 , "detail_schrank");

  AddSpecialDetail(
    ({"werkzeug"
     ,"saege","saegeblatt"
     ,"bohrer"
     ,"spachtel"
     ,"dose","bohnerwachs"
     ,"sack","saeckchen","mottenkugeln"
     ,"flaeschchen","aufkleber","aufschrift"
     ,"schmieroel","oel"
     })                                          , "detail_tools" );

  AddCmd( CMD_NEHMEN                 , "cmd_nehmen");
  AddCmd( ({"oeffne"})               , "cmd_oeffnen");
  AddCmd( ({"schliess","schliesse"}) , "cmd_schliessen" );
  AddCmd( ({"schmier","schmiere"})   , "cmd_schmieren" );

  AddExit("norden", ROOM "sgang02" );

  schrank    = ZU;
  besen      = DA;
  quietschen = 1;
}

void reset()
{
  ::reset();

  if(schrank == OFFEN)
  {
    tell_room(TO, BS("Mit einem leisen Quietschen fallen die Tueren des "
                     "Schrankes zu. Anscheinend hat sich der Schrank im "
                     "Laufe der Jahre verzogen, so dass die Tueren nicht "
                     "von alleine offen bleiben. "));
  }

  schrank    = ZU;
  besen      = DA;
  quietschen = 1;
}

string detail_besen(string str)
{
   return (besen == DA) ? "Wenn Du den Besen untersuchen willst, dann nimm "
                          "ihn doch einfach.\n" :
                          "Sowas siehst Du hier nicht!\n";
}

string detail_haken()
{
  return ((besen == DA) ? "An einem der Haken haengt ein Besen.\n" :
                          "An keinem der Haken haengt etwas.\n");
}

string detail_schrank()
{
  string s;

  s = "Der Schrank ist aus Eichenholz. Die Tueren sind auesserst massiv. ";

  if(schrank == OFFEN)
  {
    s += "Der Schrank ist offen. Es befindet sich eine Dose, ein Sack, "
           "ein kleines Flaeschchen und etwas Werkzeug darin." ;
  }
  else
  {
    s += "Der Schrank ist geschlossen.";
  }
  return BS(s);
}

string detail_tools(string key)
{
  string s;

  if(schrank == ZU) return "Sowas siehst Du hier nicht.\n";

  switch(key)
  {
    case "werkzeug" :
      s = "Du siehst eine Saege, einen Bohrer und einen Spachtel.";
      break;

    case "saege" :
      s = "Blitzblank liegt die Saege im Schrank, in dem Saegeblatt kannst "
          "Du Dich fast spiegeln.";
      break;

    case "saegeblatt" :
      s = "Das Saegeblatt ist so blank, da kannst Du Dich fast drin "
          "spiegeln.";
      break;

    case "bohrer" :
      s = "Mit dem Bohrer kann man Loecher in Holz bohren.";
      break;

    case "spachtel" :
      s = "Mit einem Spachtel kann man Beschaedigungen im Putz ausbessern.";
      break;

    case "dose" :
    case "bohnerwachs" :
      s = "Eine Dose Bohnerwachs. Wofuer die wohl gebraucht wird? Da Du "
          "damit nichts anfangen kannst, laesst Du die Dose stehen.";
      break;

    case "sack" :
    case "saeckchen" :
    case "mottenkugeln" :
      s = "Ein kleines Saeckchen Mottenkugeln. Uninteressant.";
      break;

    case "flaeschchen" :
    case "aufkleber" :
    case "aufschrift" :
      s = "Auf dem Flaeschchen klebt ein Aufkleber mit der Aufschrift: "
          "Schmieroel";
      break;

    case "schmieroel" :
    case "oel" :
      s = "Schmieroel wie man es zum schmieren klemmender Sachen benoetigt.";
      break;

    default :
      s = "Sowas siehst Du hier nicht.\n";
      break;
  }

  return BS(s);
}

int cmd_schmieren(string str)
{
  notify_fail("Was moechtest Du schmieren?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer"         ||
       str == "tuere"        ||
       str == "schranktuer"  ||
       str == "schranktuere" )) return 0;

  if(!quietschen)
  {
    TP->Message(BS("Die Tuer schein vor kurzem erst geschmiert worden zu"
                   "sein."), MSGFLAG_VISUAL);
    return -1;
  }

  TP->Message(BS("Du nimmst das Schmieroel und schmierst Die Schranktuer. "
                 "Danach stellst Du das Schmieroel wieder in den "
                 "Schrank."), MSGFLAG_VISUAL);

  TO->Message(TP->Name(WER)+" macht sich am Schrank zu schaffen.\n"
             , MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  quietschen = 0;

  return 1;
}


int cmd_oeffnen(string str)
{
  string sp, so;

  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(str == "kiste")
  {
    TELLPLAYER("Die Kiste ist mit Nichts auf der Welt zu oeffnen.\n");
    return 1;
  }

  if(str == "kiste mit nichts auf welt" )
  {
    TELLPLAYER(BS("Du oeffnest die Kiste mit 'Nichts auf der Welt', aber sie "
                  "ist leer. Enttaeuscht machst Du sie wieder zu."));
    TELLOTHERS(TPN+" oeffnet eine Kiste und schliesst sie wieder.\n");
    FMASTER->Msg(TPUID+" oeffnet die Kiste mit Nichts auf der Welt");
    return 1;
  }

  if(str == "schrank")
  {
    if(schrank == OFFEN)
    {
      TELLPLAYER("Der Schrank ist doch schon offen!\n");
    }
    else
    {
      sp = "Du oeffnest den Schrank";
      so = TP->Name(WER)+" oeffnet den Schrank";

      if(quietschen)
      {
        sp += ". Die Tueren quietschen leise";
        so += ", die Tueren quietschen leise dabei";
      }

      sp += ".\n";
      so += ".\n";

      TP->Message(sp, MSGFLAG_VISUAL);
      TO->Message(so, MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      if(quietschen)
      {
        TO->Message("Quuuuuuuuiiiiiiiiiiiiiiieeeeeeeeeeeekkkkkkk\n"
                   , MSGFLAG_SOUND);
      }
      schrank = OFFEN;
    }
    return 1;
  }

  return 0;
}

int cmd_nehmen(string str)
{
  object ob;
  string s;

  notify_fail("Sowas siehst Du hier nicht!\n");

  if(!str || str=="") return 0;

  switch(str)
  {
    case "besen" :
      if(besen == WEG) return 0;

      ob = clone_object(WEAPON "besen");

      if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
      {
        s = "Du kannst den Besen nicht mehr tragen.";
        ob->remove();
      }
      else
      {
        s = "Du nimmst den Besen.";
        FMASTER->Msg(TPUID+" nimmt den Besen");
        besen = WEG;
      }
      break;

      case "dose" :
      case "bohnerwachs" :
        if(schrank == ZU) return 0;
        s = "Da sollen sich die Diener drum kuemmern, deswegen "
            "laesst Du die Dose stehen.";
        break;

      case "flaeschchen" :
        if(schrank == ZU) return 0;
        s = "Das Flaeschchen klebt fest! So sehr Du Dich auch bemuehst, Du "
            "bekommst es nicht los.";
        break;

      case "werkzeug" :
      case "saege" :
      case "spachtel" :
      case "bohrer" :
        if(schrank == ZU) return 0;
        s = "Du bist Abenteurer und kein Handwerker, deswegen laesst Du die "
            "Sachen liegen.";
        break;

      case "sack" :
      case "saeckchen" :
      case "mottenkugel" :
      case "mottenkugeln" :
        if(schrank == ZU) return 0;
        s = "Du bist Abenteurer und kein Diener, deswegen laesst Du die "
            "Sachen liegen.";
        break;

      default :
        return 0;
  }

  TELLPLAYER(BS(s));
  return 1;
}

int cmd_schliessen(string str)
{
  string sp, so;

  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;

  if(str == "schrank")
  {
    if(schrank == OFFEN)
    {
      sp = "Du schliesst den Schrank";
      so = TP->Name(WER)+" schliesst den Schrank";

      if(quietschen)
      {
        sp += ". Die Tueren quietschen leise";
        so += ", die Tueren quietschen leise dabei";
      }

      sp += ".\n";
      so += ".\n";

      TP->Message(sp, MSGFLAG_VISUAL);
      TO->Message(so, MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      if(quietschen)
      {
        TO->Message("Quuuuuuuuiiiiiiiiiiiiiiieeeeeeeeeeeekkkkkkk\n"
                   , MSGFLAG_SOUND);
      }

      schrank = ZU;
    }
    else
    {
      TELLPLAYER("Der Schrank ist doch schon geschlossen!\n");
    }
    return 1;
  }

  return 0;
}

