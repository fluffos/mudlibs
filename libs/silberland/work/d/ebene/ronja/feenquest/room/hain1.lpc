#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein lieblicher Feenhain" );
  SetProp(P_INT_LONG,
    "Du stehst mitten in einem kleinen Hain. Wenn Du nach Westen "
    "blickst, kannst Du noch den Teich schimmern sehen. Ein Weg schlaengelt "
    "sich durch den Hain und fuehrt auf das Schloss zu, dessen drei "
    "Tuerme Du bereits ueber den Baumwipfeln ausmachen kannst. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:22]));

  AddDetail( ({"sonne","himmel","sonnenlicht"}) ,
    "Die Sonne steht am Himmel und lacht Dich an."
  );

  AddDetail( ({"westen"}) ,
    "Im Westen ist der Teich."
  );

  AddDetail( ({"weg","boden"}) ,
    "Der Weg besteht aus geharktem Kies, der unter jedem Deiner Schritte "
    "leise knirscht."
  );

  AddDetail( ({"turm","tuerme","wipfel","baumwipfel","wipfeln"}) ,
    "Ueber den Wipfeln erheben sich drei Tuerme. Von dort oben muss man "
    "bestimmt eine tolle Aussicht haben."
  );

  AddDetail( ({"aussicht"}) ,
    "Um die Aussicht zu geniessen, muss Du wohl oder uebel auf die "
    "Tuerme kraxeln."
  );

  AddDetail( ({"teich","silberteich"}) ,
    "Den Teich kannst Du noch im Westen schimmern sehen."
  );

  AddDetail( ({"schloss"}) ,
    "Das Schloss muesste unmittelbar vor Dir liegen. Folge einfach dem Weg."
  );

  AddDetail( ({"hain","park"}) ,
    "Dieser Hain ist einfach wunderschoen. Obwohl man erkennt, dass er "
    "kuenstlich angelegt wurde, spiegelt er doch die Natuerlichkeit eines "
    "kleinen Waeldchens wieder."
  );

  AddDetail( ({"waeldchen","wald"}) ,
    "Alles was man in einem Wald findet, findet sich auch hier. Natuerlich "
    "hat ein Waeldchen nicht die Ausmasse eines Waldes, daher findet man von "
    "allem immer nur ein wenig."
  );

  AddDetail( ({"ausmass","ausmasse"}) ,
    "Das Waeldchen ist viel kleiner als ein Wald."
  );


  AddDetail( ({"blaetter"}) ,
    "Die Blaetter rauschen leise im Wind."
  );

  AddDetail( ({"baum","baeume"}) ,
    "Zahllose Baeume wachsen hier im Hain. Sie alle sind sehr gepflegt, was "
    "aber ihrer Natuerlichkeit keinen Abbruch tut."
  );

  AddDetail( ({"wind"}) ,
    "Der Wind weht leicht durch den Hain und bringt die Blaetter zum "
    "rauschen."
  );

  AddDetail( ({"schritte","kies"}) ,
    "Jeder Deiner Schritte erzeugt ein leises Knirschen auf dem Kies."
  );

  AddDetail( ({"knirschen"}) ,
    "Es knirscht zwar nur sehr leise, aber Du kannst es deutlich hoeren."
  );

  AddDetail( ({"natuerlichkeit"}) ,
    "Trotzdem dieser Hain kuenstlich angelegt wurde, strahlt er doch ein hohe "
    "Natuerlichkeit aus. "
  );

  AddSound( DEFAULT_SOUND,
    "Jeder deiner Schritte erzeugt ein leises Knirschen auf dem Kies."
  );

  AddSound( ({"schritte","knirschen","kies","knirsch"}) ,
    "*knirsch*   ....   *knirsch*"
  );

  AddCmd( ({"kraxel","kraxele","kraxl","kraxle"}) , "cmd_kraxeln");
  AddCmd( ({"zaehle","zaehl"})                    , "cmd_zaehlen");

  AddItem(NPC "vogel.lpc", REFRESH_DESTRUCT);

  AddExit("osten"      , ROOM "hain2.lpc");
  AddExit("westen"     , ROOM "steg2.lpc");
  AddExit("suedosten"  , ROOM "hain3.lpc");

}

int cmd_kraxeln(string str)
{
  notify_fail("Wo willst Du hinauf kraxeln?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf turm"    ||
       str == "auf tuerme"  ))return 0;

  TELLPLAYER("Von hier aus? Da musst Du schon ins Schloss gehen.\n");
  return 1;
}

int cmd_zaehlen(string str)
{
  notify_fail("Was willst Du zaehlen?\n");

  if(!str || str == "") return 0;
  if(!(str == "baum"    ||
       str == "baeume"  ))return 0;

  switch (TP->QueryProp(P_RACE))
  {
    case "Fee" :
      TELLPLAYER("Du erfreust Dich lieber an ihnen anstatt sie zu zaehlen.\n");
      break;

    case "Mensch" :
      TELLPLAYER("1...2...3...4... Dir wird das langweilig und Du hoerst auf.\n");
      break;

    case "Elf" :
      TELLPLAYER("Mit einem kurzen Blick erkennst Du, dass es 83 Baeume sind.\n");
      break;

    case "Zwerg" :
      TELLPLAYER("1...2...4... aehm 1...2...3...5... Du gibst auf.\n");
      break;

    case "Hobbit" :
      TELLPLAYER("1...2...3...4...5...6...7 ...  80...81...82...83. Ja es sind 83 Baeume.\n");
      break;

    case "Troll" :
      TELLPLAYER("Da Du noch nicht mal bis drei zaehlen kannst, faengst Du erst gar nicht an.\n");
      break;

    case "Dunkelelf" :
      TELLPLAYER("Du schaetzt, dass es circa 90 Baeume sind.\n");
      break;

    case "Oger" :
      TELLPLAYER("Du haelst lieber nach Menschenfleisch Ausschau.\n");
      break;

    default :
      TELLPLAYER("Die Zahl der Baeume interessiert Dich nicht wirklich.\n");
      break;

  }
  FMASTER->Msg(TPUID+" zaehlt die Baeume im Hain");
  return 1;
}



