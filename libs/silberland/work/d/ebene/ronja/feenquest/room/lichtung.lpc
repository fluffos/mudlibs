#include "../def.h"

inherit "std/room";

string *barfuss;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Lichtung" );
  SetProp(P_INT_LONG,
    "Eine Lichtung. Erstaunt blickst Du Dich um. Schlagartig ist es Nacht "
    "geworden, doch der zunehmende Mond steht hell leuchtend am Himmel. Die "
    "Lichtung ist umringt von Straeuchern, Bueschen und Baeumen. In den "
    "Straeuchern und Bueschen siehst Du zahllose kleine Lichter tanzen. "
    "Dies muss der geheime Ort der Feen sein, an dem sie jedesmal bei "
    "Vollmond zusammenkommen und ihren Feentanz auffuehren. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({"lichtung","ort"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"wand","waende","decke"}) ,
    "Sowas siehst Du hier nicht."
  );

  AddDetail( ({"boden"}) ,
    "Du stehst auf einer Wiese. Das Gras ist frisch und riecht so "
    "richtig nach Fruehling. Du fuehlst Dich einfach wohl hier. "
  );

  AddDetail( ({"gras","wiese"}) ,
    "Das Gras ist wunderbar frisch, am liebsten wuerdest Du barfuss darueber "
    "laufen."
  );

  AddDetail( ({"fee","feen","feentanz","tanz"}) ,
    "Dies muss der Ort sein, an dem die Feen jedesmal bei Vollmond tanzen, "
    "um ihre Feenmagie zu erneuern. "
  );

  AddDetail( ({"feenmagie","magie"}) ,
    "Nur mit der Feenmagie koennen die Feen weiter existieren."
  );

  AddDetail( ({"strauch","straeucher","straeuchern","busch","buesche"
              ,"bueschen","baeume","baeumen","pflanzen"}) ,
    "Die Lichtung ist von Bueschen, Straeuchern und Baeumen umrandet."
  );

  AddDetail( ({"lichter"}) ,
    "Die Lichter tanzen auf und ab. Sind das etwa Gluehwuermchen? Als Du "
    "sie genauer anschaust, erkennst Du, dass es Irrlichter sind. "
  );

  AddDetail( ({"gluehwurm","gluehwuermchen"}) ,
    "Es sind keine Gluehwuermchen, also sind auch keine da."
  );

  AddDetail( ({"irrlicht","irrlichter"}) ,
    "Die Irrlichter tanzen lustig in den Bueschen und Straeuchern umher."
  );

  AddDetail( ({"himmel","mond"}) ,
    "Am Himmel steht der zunehmende Mond. Bald ist Vollmond!"
  );

  AddDetail( ({"vollmond"}) ,
    "Noch ist nicht Vollmond, aber viel Zeit hast Du nicht mehr."
  );

  AddDetail( ({"zeit"}) ,
    "Viel Zeit bleibt dir nicht mehr."
  );

  AddDetail( ({"nacht"}) ,
    "Es ist Nacht, aber der Mond spendet genuegend Licht."
  );

  AddDetail( ({"licht"}) ,
    "Es ist nicht viel, aber ausreichend zum sehen."
  );

  AddDetail( ({"fruehling","jahreszeit"}) ,
    "Der Fruehling ist eine Jahreszeit, falls Du das noch nicht wusstest."
  );

  AddDetail( ({"ohren","ohr"}) ,
    "Panikartig greifst Du Dir an Deine Ohren. Und es sind beide noch da! "
    "Erleichtert atmest Du auf."
  );

  AddSpecialDetail( ({"spitze","stelle","erde","fuss"}) , "detail_spitze" );

  AddSmell(DEFAULT_SMELL,
    "Es riecht einfach frisch!\n"
  );

  AddSound(DEFAULT_SOUND,
    "Es ist absolut still hier. Nur manchmal dringt vage eine leise Musik "
    "in Deine Ohren, doch sie ist so leise, dass Du ihre Melodie nicht "
    "erkennen kannst."
  );

  AddSound( ({"musik","melodie"}) ,
    "Sie ist so leise, dass Du sie fast gar nicht wahrnimmst."
  );

  AddCmd( ({"lauf","laufe"}) , "cmd_laufen");
  AddCmd( ({"grab","grabe"}) , "cmd_graben");
  AddCmd( ({"tanz","tanze"}) , "cmd_tanzen");

  AddSpecialExit(({"norden","nordosten","osten","suedosten","sueden"
                  ,"suedwesten","westen","nordwesten"}) , "ausgang" );
  SetProp(P_HIDE_EXITS, ({"norden","nordosten","osten","suedosten"
                         ,"sueden","suedwesten","westen","nordwesten"}));

  barfuss = ({});
}

void reset()
{
  ::reset();

  barfuss = ({});
}

int ausgang(string str)
{
  TELLPLAYER(BS("Eine magische Barriere hindert Dich daran, die Lichtung "
                "zu verlassen."));
  TELLOTHERS(BS(CAP(TPN)+" versucht die Lichtung in Richtung "+CAP(str)+
                " zu verlassen, doch irgendetwas hindert "+
                TP->QueryPronoun(WEN)+" daran."));
  FMASTER->Msg(TPUID+" versucht die Lichtung Richtung "+str+" zu verlassen");
  return 1;
}

string detail_spitze(string key)
{
  string s;

  if(member(barfuss,getuid(TP)) > -1)
  {
    switch(key)
    {
      case "spitze" :
        s = "Eine kleine Spitze schaut aus der Grasnarbe heraus. Was das wohl "
            "sein koennte? Letzlich wirst Du es erst erfahren, wenn Du hier "
            "mal graebst.";
        break;

      case "stelle" :
        s = "Eine kleine Spitze schaut aus der Grasnarbe heraus. Was das wohl "
            "sein koennte? Letzlich wirst Du es erst erfahren, wenn Du hier "
            "mal graebst.";
        break;

      case "erde"   :
        s = "Eine kleine Spitze schaut aus der Erde heraus. Was das wohl "
            "sein koennte? Letzlich wirst Du es erst erfahren, wenn Du hier "
            "mal graebst.";
        break;

      case "fuss"   :
        s = "Irgendetwas hat Dich in den Fuss gepiekt.";
        break;
    }
  }
  else
  {
    switch(key)
    {
      case "spitze" :
        s = "sowas siehst Du hier nicht";
        break;

      case "stelle" :
        s = "Du stehst auf einer Lichtung.";
        break;

      case "erde"   :
        s = "Die Erde ist mit Gras bewachsen.";
        break;

      case "fuss"   :
        s = "Ein ganz normaler Fuss.";
        break;
    }

  }

  return BS(s);
}

int cmd_laufen(string str)
{
  object *schuhe;
  int syntax1ok;
  int syntax2ok;
  int spieler_ist_barfuss;

  notify_fail("Wie willst Du laufen?\n");

  syntax1ok = (-1 == member(({"ueber wiese"
                             ,"ueber gras"
                             ,"ueber die wiese"
                             ,"ueber das gras"}),str));

  syntax2ok = (-1 == member(({"barfuss"
                             ,"barfuss ueber wiese"
                             ,"barfuss ueber gras"
                             ,"barfuss ueber die wiese"
                             ,"barfuss ueber das gras"}),str));

  if(!(syntax1ok || syntax2ok))
  {
    return 0;
  }

  spieler_ist_barfuss = 1;

  if(TP->QueryProp(P_ARMOURS) )
  {
     schuhe=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_BOOT);
     if (sizeof(schuhe) && objectp(schuhe[0]))
     {
       spieler_ist_barfuss = 0;
     }
     else
     {
       spieler_ist_barfuss = 1;
     }
  }

  if(spieler_ist_barfuss)
  {
    if(present("\nFEENHUT",TP))
    {
      TELLPLAYER(BS("Du laeufst barfuss ueber die Wiese und fuehlst Dich wie "
                    "ein Blumenkind."));
      return 1;
    }

    if(present("\nHUTSCHLEIER",TP))
    {
      TELLPLAYER(BS("Du laeufst barfuss ueber die Wiese. Das Gras kitzelt "
                    "zwischen Deinen Zehen. Du fuehlst Dich wie ein "
                    "Blumenkind. Hoppla, da hat Dich etwas in Deinen linken "
                    "Fuss gepiekt. Du bueckst Dich und erkennst im Gras eine "
                    "winzige Spitze, die aus der Erde lugt. Vielleicht "
                    "solltest Du an dieser Stelle einmal graben?"
      ));
      barfuss += ({ getuid(TP) });
      FMASTER->Msg(TPUID+" laeuft barfuss ueber die Lichtung");
      return 1;
    }
    else
    {
      TELLPLAYER("Du laeufst ueber die Wiese.\n");
      FMASTER->Msg(TPUID+" laeuft barfuss ueber die Wiese und findet nichts");
      return 1;
    }
  }

  if(syntax1ok && (!spieler_ist_barfuss))
  {
    TELLPLAYER("Du bist doch gar nicht barfuss.\n");
    FMASTER->Msg(TPUID+" versucht barfuss ueber die Lichtung zu laufen, "
                 "hat aber noch Schuhe an");
    return 1;
  }

  TELLPLAYER("Du laeufst ueber die Wiese.\n");
  FMASTER->Msg(TPUID+" laeuft ueber die Lichtung");
  return 1;
}

int cmd_graben(string str)
{
  object hut;

  if(  (present("\nFEENHUT",TP))          ||
       (present("\nFEENHUT",TO))          ||
      !(present("\nHUTSCHLEIER",TP))      ||
       (-1 == member(barfuss,getuid(TP)))    )
  {
    TELLPLAYER(BS("Nein! Du willst diese schoene Wiese nicht durch Dein "
                  "graben verunstalten.\n"));
    FMASTER->Msg(TPUID+" graebt nicht auf der Lichtung");
    return 1;
  }

  TELLPLAYER(BS("Du graebst und graebst und graebst... und findest einen "
                "Feenhut. Wie der wohl da hingekommen ist? Egal. Sorgsam "
                "machst Du das Loch wieder zu und drappierst die Grasnarbe "
                "wieder ordentlich, damit das Gras wieder anwaechst. "
                "Vorsichtig saeuberst Du den Hut, er sieht fast wie neu aus. "
                "Lange kann er jedenfalls nicht hier gelegen haben."
  ));

  hut=clone_object(ARMOUR "feenhut.lpc");

  if(ME_TOO_HEAVY==hut->move(TP,M_GET|M_SILENT))
  {
    hut->move(TO,M_NOCHECK|M_SILENT);
  }
  else
  {
    TELLPLAYER("Du nimmst den Hut an Dich.\n");
  }
  FMASTER->Msg(TPUID+" findet den Feenhut");

  return 1;
}

int cmd_tanzen(string str)
{
  TELLPLAYER(BS("Zoegernd machst Du ein paar nicht sehr elegante Schritte "
                "auf dem Rasen. Schon nach wenigen Schritten erklingt eine "
                "mystische Musik und Du wirst in ein warmes Licht getaucht. "
                "Feenmagie durchdringt Dich, und wie in Trance tanzt Du ueber "
                "die Wiese. Irrlichter umgeben Dich und die Umgebung "
                "verschwimmt vor Deinen Augen. Langsam verklingt die Musik "
                "und Du kommst wieder zu Dir."
  ));
  TELLOTHERS("Um "+TPN+" herum erscheint ein seltsames, weiches Licht...\n");
  TP->move(ROOM "kapelle",M_GO,
           "",
           "verschwindet in einem hellen Leuchten",
           "erscheint aus einem seltsamen Leuchten"
           );

  FMASTER->Msg(TPUID+" verlaesst die Lichtung");
  return 1;
}

