#include "../def.h"

inherit ROOM "sgang00.lpc" ;

string combination;

string *player;

void create()
{
  int i;

  ::create();

  AddDetail( ({"angeln"}) ,
    "Mit maechtigen Angeln ist die Tuer im Mauerwerk befestigt."
  );

  AddDetail( ({"mauerwerk"}) ,
    "Nahtlos fuegt sich die Tuer in das Mauerwerk ein."
  );

  AddDetail( ({"augenhoehe"}) ,
    "Direkt in Augenhoehe befinden sich 6 Raedchen."
  );

  AddDetail( ({"klinke"}) ,
    "Da, wo sich bei normalerweise die Klinke befindet, siehst Du nur "
    "einen grossen Knopf. "
  );

  AddDetail( ({"knopf"}) ,
    "Der Knopf fuegt sich nahezu nahtlos in die Tuer ein. Beinahe haettest "
    "Du ihn uebersehen. Ob man damit wohl die Tuer oeffnen kann? "
  );

  AddDetail( ({"nieten","niete"}) ,
    "Grosse Nieten verstaerken die Tuer, so dass man ihr mit Gewalt nicht "
    "beikommen kann. "
  );

  AddDetail( ({"gewalt"}) ,
    "Die Tuer sieht extrem stabil aus, mit Gewalt ist da sicherlich nichts "
    "zu erreichen. Aber wenn Du unbedingt willst, kannst Du versuchen, "
    "die Tuer mit Deiner Schulter zu rammen oder mit einer Waffe auf die "
    "Tuer einzuschlagen. "
  );

  AddSpecialDetail( ({"rad","raeder","raedchen"}) , "detail_raeder" );

  AddCmd( ({"dreh","drehe","stell","stelle"}) , "cmd_drehen");
  AddCmd( ({"drueck","druecke"})              , "cmd_druecken");
  AddCmd( ({"ramm","ramme"})                  , "cmd_rammen");
  AddCmd( ({"schlag","schlage"})              , "cmd_schlagen");
  AddCmd( ({"brech","breche","brich"})        , "cmd_brechen");

  AddExit("norden", ROOM "sgang12.lpc");
  AddExit("westen", ROOM "sgang14.lpc");
  AddExit("oben",   ROOM "turm31.lpc");

  NewDoor("osten", ROOM "weg4" , ({"tuer","eisentuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Tuer"
     ,D_GENDER,FEMALE
     ,D_LONG, "Eine wuchtige Eisentuer mit massiven starken Angeln und starken "
              "Nieten. Die bricht bestimmt niemand gewaltsam auf. Etwa in "
              "Augenhoehe befinden sich 6 Raedchen, statt einer Klinke "
              "siehst Du nur einen grossen Knopf."
     ,D_MSGS,    ({"hinaus","geht","kommt durch die Tuer nach draussen"})
     ,D_FUNC, "doorwalk"
     ,D_OPENTESTFUNC, "doortest"
     ,D_OPENMSG, ({"Du oeffnest die Tuer.",
                   "%s oeffnet die Tuer.",
                   " schwingt auf, als ob sie von innen geoffnet wuerde."})
     ,D_CLOSEMSG, ({"Du schliesst die Tuer.",
                    "%s schliesst die Tuer.",
                    " wird von innen geschlossen."})
     ,D_RESET_CLOSEMSG, " schliesst sich wie von Geisterhand."
     })
  );

  combination = "";
  for(i=0;i<6;i++) combination += sprintf("%d",random(8)+1);

  player = ({ });
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "weg4",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "weg4",TO);
}

void closedoor(object pl)
{
  int i;

  if(pl)
  pl->command_me("sage Wer hat denn schon wieder die Tuer oeffen gelassen?");
  tell_room(TO,BS("Aergerlich gibt der Diener der Tuer einen Schubs und "
                  "schliesst sie damit. Krachend faellt sie ins Schloss."));
  tell_room(ROOM "weg4",BS("Die Tuer wird heftig zugestossen und faellt "
                           "krachend ins Schloss."));
  SetThisDoor(D_STATUS_CLOSED);

  combination = "";
  for(i=0;i<6;i++) combination += sprintf("%d",random(8)+1);
}

void closedoor2(object pl,string s)
{
  int i;

  tell_object(pl,BS(s));

  tell_room(TO,
    BS("Gerade als "+pl->Name(WER)+" durch die Tuer geht, faellt diese "
       "krachend ins Schloss."),
    ({pl})
  );

  tell_room(ROOM "weg4",
    BS("Gerade als "+pl->Name(WER)+" durch die Tuer geht, faellt diese "
       "krachend ins Schloss."),
    ({pl})
  );

  SetThisDoor(D_STATUS_CLOSED);

  combination = "";
  for(i=0;i<6;i++) combination += sprintf("%d",random(8)+1);
  RINGMASTER->Msg(CAP(getuid(pl))+" geht durch die Tuer");
}

void init()
{
  ::init();
  if(TP &&
     TP->id("kammerdiener") &&
     QueryThisDoor() == D_STATUS_OPEN)
    call_out("closedoor",0,TP);
}

void reset()
{
  ::reset();

  player = ({ });
}

int doortest()
{
  TELLPLAYER(BS("Du versuchst die Tuer zu oeffnen, doch findest Du keine "
                "Klinke oder etwas aehnliches. "));
  return 1;
}

int doorwalk()
{
  object ob;
  string s;

  s = "";

  if(ob=present("\nFEENPERGAMENT",TP))
  {
    s = "Da Du das Pergament nicht mehr brauchst, knuellst Du es "
        "zusammen und wirfst es achtlos weg. ";
    ob->remove();
  }

  s += "Gerade als Du durch die Tuer gegangen bist, faellt diese hinter "
       "Dir ins Schloss.";

  call_out("closedoor2",0,TP,s);
  return 1;
}

string detail_raeder(string str)
{
  string s,l,digit;
  int i,j,k;
  string *line;

  line = ({});
//                       1         2         3         4         5
//             012345678901234567890123456789012345678901234567890123456789
  for(i=0;i<9;i++)
    line += ({"                                                            "});

  k = 0;
  for(i=0;i<6;i++)
  {
    line[0][k+4..k+5] = "__";
    line[1][k+4..k+5] = "\\/";
    line[3][k+2..k+6] = ".-X-.";
    line[4][k+1..k+7] = "/X   X\\";
    line[5][k  ..k+8] = ";X  O  X;";
    line[6][k+1..k+7] = "\\X   X/";
    line[7][k+2..k+6] = "'-X-'";
    k+=10;
  }

  k = 0;
  for(i=0;i<6;i++)
  {
    j = to_int(combination[i..i]);
    line[3][k+4..k+4] = sprintf("%d",j++);if(j > 8) j = 1;
    line[4][k+2..k+2] = sprintf("%d",j++);if(j > 8) j = 1;
    line[5][k+1..k+1] = sprintf("%d",j++);if(j > 8) j = 1;
    line[6][k+2..k+2] = sprintf("%d",j++);if(j > 8) j = 1;
    line[7][k+4..k+4] = sprintf("%d",j++);if(j > 8) j = 1;
    line[6][k+6..k+6] = sprintf("%d",j++);if(j > 8) j = 1;
    line[5][k+7..k+7] = sprintf("%d",j++);if(j > 8) j = 1;
    line[4][k+6..k+6] = sprintf("%d",j++);if(j > 8) j = 1;
    k+=10;
  }

  l = "";
  for(i=0;i<9;i++) l += line[i]+"\n";

  s = "An der Tuer befinden sich 6 Raedchen. Jedes Raedchen traegt "
      "die Ziffern 1 bis 8. Mit <drehe rad x auf y> kannst Du jedes "
      "der Raedchen einstellen. ";

  return l+BS(s);
}

int cmd_brechen(string str)
{
  notify_fail("Was moechtest Du aufbrechen?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer"         ||
       str == "tuer auf"         )) return 0;

  TELLPLAYER(BS("Diese Tuer koenntest Du nie aufbrechen, selbst wenn Du "
                "10 mal so stark waerest. Aber vielleicht wenn Du mit einer "
                "Waffe auf die Tuer einschlaegst?"));

  return 1;
}


int cmd_drehen(string str)
{
  int n,radnr,posnr;
  string was;

  notify_fail("Welches Rad moechtest Du auf welche Ziffer drehen?\n");

  if(!str || str == "") return 0;

  n = sscanf(str, "%s %d auf %d", was, radnr,posnr);
  if(n!=3) return 0;

  notify_fail("Was moechtest Du drehen?\n");

  if(!(was == "rad"         ||
       str == "raedchen"    )) return 0;

  notify_fail("Es gibt doch nur 6 Raedchen!\n");

  if(radnr < 1 || radnr > 6) return 0;

  notify_fail("Jedes Rad kannst Du nur auf die Ziffern 1 bis 8 drehen.\n");

  if(posnr < 1 || posnr > 8) return 0;

  combination[radnr-1..radnr-1] = sprintf("%d",posnr);

  TELLPLAYER(sprintf("Du drehst das Raedchen %d auf %d.\n",radnr,posnr));
  TELLOTHERS(CTPN+" macht sich an der Tuer zu schaffen.\n");
  return 1;
}

int cmd_druecken(string str)
{
  object ob;

  notify_fail("Was moechtest Du druecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "knopf"         ||
       str == "knopf ein"     )) return 0;

  if(!ob=present("\nFEENPERGAMENT",TP))
  {
    TELLPLAYER("Du drueckst auf den Knopf, aber nichts passiert.\n");
    TELLOTHERS(CTPN+" macht sich an der Tuer zu schaffen.\n");
    return 1;
  }

  if(ob->QueryNumber() != combination)
  {
    TELLPLAYER("Du drueckst auf den Knopf, aber nichts passiert.\n");
    TELLOTHERS(CTPN+" macht sich an der Tuer zu schaffen.\n");
    return 1;
  }

  TELLPLAYER(BS("Du drueckst den Knopf, ein leises Klicken ertoent und "
                "die Tuer oeffnet sich. "));

  TELLOTHERS(BS(CTPN+" macht sich an der Tuer zu schaffen und auf einmal "
                "oeffnet sie sich mit einem leisen klicken."));

  tell_room(ROOM "weg4",BS("Ein leises Klicken ertoent von der Tuer und "
            "sie wird von innen geoeffnet."));

  SetThisDoor(D_STATUS_OPEN);

  RINGMASTER->Msg(TP->Name()+" oeffnet die Tuer im Feenschloss");

  return 1;
}

int cmd_rammen(string str)
{
  string s;

  notify_fail("Was moechtest Du rammen?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer"         ||
       str == "eisentuer"         )) return 0;

  if(QueryThisDoor() == D_STATUS_OPEN)
  {
    TELLPLAYER(BS("Du nimmst etwas Anlauf und rammst die Tuer mit Deiner "
                  "Schulter. Da die Tuer aber offen ist, fliegst Du in "
                  "hohem Bogen hinaus. Du siehst die Tuer noch etwas "
                  "hin und her pendeln, bevor sie ins Schloss faellt."));
    TELLOTHERS(BS(CTPN+" nimmt etwas Anlauf und rammt mit "
                  +TPPP(FEMALE,WESSEN)+" Schulter die Tuer. Da diese jedoch "
                  "auf ist, purzelt "+TPN+" in hohem Bogen hinaus. Die"
                  "Ture pendelt noch etwas hin und her und faellt dann "
                  "ins Schloss"));
    tell_room(ROOM "weg4",
      BS(CTPN+" kommt in hohem Bogen aus der Tuer hinausgepurzelt. Die Tuer "
         "schwingt noch etwas hin und her und faellt dann wieder ins Schloss. "),
      ({TP})
    );
    TP->move(ROOM "weg4",M_GO|M_SILENT);
    SetThisDoor(D_STATUS_CLOSED);
    RINGMASTER->Msg(TP->Name()+" rammt die offene Tuer");
    return 1;
  }

  TELLPLAYER("Du nimmst etwas Anlauf und rammst die Tuer mit Deiner "
             "Schulter.\n");
  TELLOTHERS(BS(CTPN+" nimmt etwas Anlauf und rammt die Tuer mit "
             +TPPP(FEMALE,WESSEN)+" Schulter."));
  SetProp(P_KILL_NAME,"Unueberlegtes Handeln");
  RINGMASTER->Msg(TP->Name()+" rammt die geschlossene Tuer");
  TP->do_damage(50);
  if(!TP->QueryProp(P_GHOST))
    TELLPLAYER("Du kannst allerdings nicht den kleinsten Schaden an der "
               "Tuer sehen.\n");

  return 1;
}

int cmd_schlagen(string str)
{
  int n;
  object weapon;
  string womit, was;

  notify_fail("Was moechtest Du womit einschlagen?\n");

  if(!str || str == "") return 0;

  n = sscanf(str, "mit %s auf %s ein", womit, was);
  if(n!=2) n = sscanf(str, "mit %s auf %s", womit, was);
  if(n!=2) n = sscanf(str, "mit %s %s ein", womit, was);
  if(n!=2) n = sscanf(str, "%s mit %s ein", was,womit);

  if(n!=2) return 0;

  if(!(was == "tuer"         ||
       was == "eisentuer"    )) return 0;

  if(!weapon=TP->QueryProp(P_WEAPON))
  {
    TELLPLAYER("Du hast doch gar keine Waffe gezueckt.\n");
    return 1;
  }

  if(!weapon->id(womit))
  {
    TELLPLAYER("So etwas benutzt Du doch gar nicht als Waffe.\n");
    return 1;
  }

  if(QueryThisDoor() == D_STATUS_OPEN)
  {
    TELLPLAYER(BS("Du nimmst Deine Waffe fest in die Hand und holst "
                  "aus, um auf die Tuer einzuschlagen. Da schwingt die "
                  "Tuer etwas auf. Die Tuer war gar nicht geschlossen! "
                  "Was fuer ein Glueck fuer Deine Waffe. "));
    TELLOTHERS(BS(CTPN+" fuchtelt mit "+weapon->Name(WEM)+" wild in der "
                  "Gegend herum. "));
    return 1;
  }

  RINGMASTER->Msg(TP->Name()+" haut mit "+weapon->name(WEM)+" auf die Tuer ein.");

  if(member(player, getuuid(TP)) != -1)
  {
    TELLPLAYER(BS("Du hast bereits einmal auf die mit Deiner Waffe auf die "
                  "Ture eingedroschen und kommst zu der Ansicht, das "
                  "dies nicht der richtige Weg ist, die Tuer zu oeffnen. "
                  "Ausserdem tut dies Deiner Waffe gar nicht gut. "));

    return -1;
  }

  TELLPLAYER(BS("Du haust mit voller Wucht auf die Eisentuer ein. Droehnend "
                "schallt es durch das Schloss. Allerdings ist auf der Tuer "
                "nicht die kleinste Beschaedigung zu sehen. Ob das Deiner "
                "Waffe wirklich so gut tut?"));

  TELLOTHERS(BS(CTPN+" haut mit "+weapon->name(WEM)+" auf die Tuer ein."));

  tell_room(ROOM "weg4", "Irgendetwas haemmert innen vom Turm gegen "
    "die Tuer.\n");

  n = weapon->QueryProp(P_WC)/10*(TP->QueryAttribute(A_STR)/14+1)+random(10);

  weapon->Damage(n);

  player += ({ getuuid(TP) });

  return 1;
}

