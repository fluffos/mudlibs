  AddDetail( ({"huette"}) ,
    "Im Suedosten kannst Du eine kleine Huette erkennen, jedoch "
    "bist Du viel zu weit weg, um Details erkennen zu koennen. Von der Huette "
    "ab fuehrt ein Zaun bis zum Maisfeld, so dass die Koppel auch hier "
    "begrenzt ist. "
  );

  AddDetail( ({"zaun","jaegerzaun"}) ,
    "Damit die Pferde auch nicht nach Osten entkommen koennen, hat man "
    "einen Zaun von der Huette bis an der Maisfeld herangezogen. Es ist "
    "eine Art Jaegerzaun, wo sich angespitzte Latten kreuzen und so "
    "ein ueberklettern oder ueberspringen verhindern. "
  );

  AddDetail( ({"latten"}) ,
    "Die Latten sind kreuzweise uebereinander genagelt und an einem "
    "Ende gespitzt, damit man sie nicht so leicht ueberspringen kann. "
  );

  AddDetail( ({"ende"}) ,
    "Das eine Ende der Latten ist angespitzt, das andere Ende steckt im "
    "Boden. "
  );

  AddDetail( ({"art","jaegerzaun"}) ,
    "Fuer einen Jaegerzaun ist dieser hier etwas zu hoch. Aber ansonsten "
    "sieht er genauso aus. "
  );

  AddDetail( ({"detail","details"}) ,
    "Aus dieser Entfernung kannst Du keine Details von der Huette "
    "erkennen. Aber dieser Raum hier hat doch auch nette Details, "
    "oder?"
  );

  AddDetail( ({"entfernung"}) ,
    "Wenn Dich die Huette so sehr interessiert, dann geh halt hin, "
    "so weit ist die auch nicht weg. "
  );


