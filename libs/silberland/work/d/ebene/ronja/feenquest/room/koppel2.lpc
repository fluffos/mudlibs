#include "../def.h"

inherit ROOM "koppel0";

void create()
{
  ::create();

#include "kop_env1_weit.lpc"
#include "kop_env2_nah.lpc"
#include "kop_env3_nah.lpc"
#include "kop_env4_weit.lpc"

  AddExit("westen"     , ROOM "koppel1");
  AddExit("suedwesten" , ROOM "koppel3");
  AddExit("sueden"     , ROOM "koppel4");

  AddCmd( CMD_SPRINGEN                , "cmd_springen");
  AddCmd( CMD_KLETTERN                , "cmd_klettern");
  AddCmd( ({"betrete","betrete"})     , "cmd_betreten");
  AddCmd( ({"such","suche"})          , "cmd_suchen");

}

int cmd_springen(string str)
{
  notify_fail("Worueber moechtest Du springen?\n");

  if(!str || str == "") return 0;
  if(!(str == "zaun"             ||
       str == "jaegerzaun"       ||
       str == "ueber zaun"       ||
       str == "ueber jaegerzaun" )) return 0;

  TELLPLAYER(BS("Du nimmst etwas Anlauf und versuchst, ueber den Zaun zu "
                "springen, bleibst aber an den spitzen Pfaehlen haengen. "
  ));

  TELLOTHERS(BS(CAP(TPN)+" nimmt etwas Anlauf und versucht ueber den Zaun "
                "zu springen, bleibt aber an den spitzen Pfaehlen haengen. "
  ));
  TP->AddHp(-25);

  return 1;
}

int cmd_klettern(string str)
{
  notify_fail("Worueber moechtest Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "zaun"             ||
       str == "jaegerzaun"       ||
       str == "ueber zaun"       ||
       str == "ueber jaegerzaun" )) return 0;

  TELLPLAYER(BS("Du faengst an, ueber den Zaun zu klettern, aber bleibst dann "
                "doch an den spitzen haengen und gibts es auf. "
  ));

  TELLOTHERS(BS(CAP(TPN)+" faengt an, ueber den Zaun zu klettern, ueberlegt "
                "es sich dann aber anscheinend doch anders. "
  ));

  return 1;
}

int cmd_betreten(string str)
{
  notify_fail("Was moechtest Du betreten?\n");

  if(!str || str == "") return 0;
  if(!(str == "maisfeld" ||
       str == "feld"     )) return 0;

  TP->move(ROOM+"maisfeld:"+getuid(this_player()), M_GO,
                "im Maisfeld","verschwindet","");

  return 1;
}

int cmd_suchen(string str)
{
  notify_fail("Was moechtest Du suchen?\n");

  if(!str || str == "") return 0;
  if(!(str == "kolben"         ||
       str == "maiskolben"     ||
       str == "mais"           )) return 0;

  TELLPLAYER(BS("Hier am Rand des Maisfeldes finden sich keine Maiskolben. "
                "Aber vielleicht kann man im Maisfeld selbst noch welche "
                "finden. Dazu muesstest Du das Maisfeld aber erstmal "
                "betreten."));
  return 1;
}

int IsCornThere()
{
  return 1;
}
