#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "An einer Wand");
  SetProp(P_INT_LONG,
    "Du befindest Dich an der Wand des suedoestlichens Turmes des "
    "Feenschlosses und bist ein paar hervorstehende Steine emporgeklettert. "
    "Unter Dir befindet sich der Burghof, auf den schauen kannst, sofern "
    "Du schwindelfrei bist. Ueber Dir befindet sich ein kleiner Erker, "
    "den Du erklimmen kannst. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"boden"}) ,
    "Von Boden kann man nicht gerade sprechen, denn du stehst auf einem "
    "Ziegelstein, der etwas aus der Wand herausragt. Hoffentlich "
    "trittst Du nicht daneben!"
  );

  AddSpecialDetail( ({"hof","burghof"}), "det_burghof");

  AddDetail( ({"erker"}) ,
    "Der Erker befindet sich ueber Dir, Du koenntest ihn von hier aus "
    "erklimmen."
  );

  AddDetail( ({"feenschloss","feenschlosses"}) ,
    "Du klebst wie eine Fliege an einer Wand des Feenschlosses."
  );

  AddDetail( ({"himmel"}) ,
    "Himmel! Du stehst auf einem klitzkleinen Stein zig Meter ueber dem "
    "Boden!"
  );

  AddDetail( ({"meter"}) ,
    "Es sind wohl mehrere Meter."
  );

  AddDetail( ({"stein","steine","ziegelstein","ziegelsteine"}) ,
    "Aus der Wand ragen einige Steine heraus. Wie geschaffen, um die Wand "
    "emporzuklettern. "
  );

  AddDetail( ({"turm","turmes"}) ,
    "Du befindest Dich an der Aussenwand des suedostlichen Turmes. "
  );

  AddDetail( ({"wand","aussenwand"}) ,
    "Aus der Wand ragen einige Steine heraus, wie geschaffen, um die "
    "Wand hoch zu klettern. "
  );

  AddDetail( ({"fliege"}) ,
    "Hoffentlich kommt jetzt keine Fliege und setzt sich auf Deine "
    "Nasenspitze. "
  );

  AddDetail( ({"spitze","nasenspitze"}) ,
    "Da sitzt keine Fliege drauf im Moment. "
  );

  AddDetail( ({"moment"}) ,
    "Schwupps - und schon ist er vorbei. "
  );

  AddCmd( ({"schau","schaue"})      , "cmd_schauen"   );
  AddCmd( ({"erklimm","erklimme"})  , "cmd_erklimmen" );
  AddCmd( CMD_KLETTERN              , "cmd_klettern"  );

  AddExit("unten", ROOM "bhof9");
}

int check_if_living(object ob)
{
  if(interactive(ob) && (ob->QueryProp(P_INVIS))) return 0;
  if(interactive(ob)) return 1;
  if(living(ob)) return 1;
  return 0;
}

int cmd_schauen(string str)
{
  string s;
  object *players, ob;
  int i;

  notify_fail("Wohin moechtest Du schauen?\n");

  if(!str || str == "") return 0;
  if(!(str == "burghof"           ||
       str == "zum burghof"       ||
       str == "auf burghof"       ||
       str == "auf den burghof"   )) return 0;

  players = ({});

  for(i=1;i<=9;i++)
  {
    if(ob=find_object(ROOM "bhof"+sprintf("%d",i)))
      players+=filter_array(all_inventory(ob), "check_if_living");
  }

  s = "Du schaust nach unten und wirfst einen Blick auf den "
      "Schlosshof. ";

  switch(sizeof(players))
  {
    case 0 :
      s += "Du siehst nichts besonderes auf dem Schlosshof.";
      break;

    case 1 :
      s += "Auf dem Schlosshof befindet sich "+players[0]->name()+".\n";
      break;

    default :
      s += "Auf dem Schlosshof befinden sich "+
            LW(map_objects(players,"name"))+".\n";

      break;
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(CTPN+" schaut nach unten auf den Burghof.\n");
  return 1;
}

int cmd_erklimmen(string str)
{
  notify_fail("Was moechtest Du erklimmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "erker"     ||
       str == "den erker" )) return 0;

  TP->command_me("oben");

  return 1;
}

int cmd_klettern(string str)
{
  TELLPLAYER("Das tust Du doch schon die ganze Zeit.\n");
  return 1;
}


string det_burghof(string str)
{
  cmd_schauen("burghof");
  return "";
}



