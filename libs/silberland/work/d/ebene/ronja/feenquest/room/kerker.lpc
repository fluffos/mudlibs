#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein alter Kerker");
  SetProp(P_INT_LONG,
    "Du stehst inmitten eines mittelalterlichen Kerkers. Die Schmiedefeuer "
    "brennen lichterloh, und die Fackeln an der Wand scheinen nie "
    "auszugehen. Du siehst einige Kerkertueren, die aber nicht zu oeffnen "
    "sind. Scheinbar wurden hier frueher viele Leute festgehalten. Ueberall "
    "riecht es nach Angst, Schweiss und Blut, wie moegen hier die Leute "
    "gelitten haben? Die seltsamen Geraete an den Waenden jagen Dir Angst "
    "und Schrecken ein. In diesem Raum ist es furchtbar heiss."
  );

  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:35]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  AddDetail(({"boden", "steinboden"}),
    "Der Steinboden ist voller Blutflecken."
  );

  AddDetail( ({"blut", "blutfleck", "blutflecken", "fleck", "flecken","flecke"}),
    "Das Blut stammt wohl von den Gefolterten."
  );

  AddDetail( ({"gefolterte"}),
    "Du bedauerst die armen Gefolterten."
  );

  AddDetail( ({"decke"}),
    "Die Decke ist schwarz."
  );

  AddDetail( ({"angst", "schrecken"}),
    "Du hast wirklich etwas Angst."
  );

  AddDetail( ({"schweiss"}) ,
    "Hier ist es so heiss, dass Du schweissnass bist. Du untersuchst "
    "Deinen Schweiss genauer und stellst fest, dass er sehr salzig "
    "schmeckt. Ausserdem ist wohl auch eine Dusche angesagt."
  );

  AddDetail( ({"dusche"}) ,
    "Also hier im Kerker findest Du bestimmt keine."
  );

  AddDetail( ({"fackel", "fackeln"}),
    "Fackeln erhellen den Raum."
  );

  AddDetail( ({"wahrheit"}),
    "Viele Leute wurden hier gefoltert, bis sie die Wahrheit sagten."
  );

  AddDetail( ({"kerker", "raum"}),
    "Du stehst mittendrinnen."
  );

  AddDetail( ({"feuer", "schmiedefeuer"}),
    "Es brennt stark und lichterloh, Dir wird heiss."
  );

  AddDetail( ({"wand", "waende"}),
    "Sie ist grau in grau gehalten worden. Seltsame Geraete haengen dort."
  );

  AddDetail( ({"tueren", "kerkertueren", "tuer", "kerkertuer"}),
    "Die Kerkertueren sind verschlossen und koennen nicht geoeffnet werden."
  );

  AddDetail( ({"leute"}),
    "Viele sind scheinbar hiergewesen."
  );

  AddDetail( ({"geraete"}),
    "Alle moeglichen Geraete, um die Wahrheit zu erfahren."
  );

  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Ueberall riecht es nach Angst, Schweiss und Blut."
  );

  AddSmell( ({"angst"}),
    "Es riecht tatsaechlich ein wenig nach Angst. Dir laeuft es eiskalt den Ruecken herunter."
  );

  AddSmell( ({"blut"}),
    "Der bittere Geruch von Blut steigt in Deine Nase."
  );

  AddSmell( ({"schweiss"}),
    "Es riecht hier ziemlich nach Schweiss. Das wird wohl an der hohen "
    "Temperatur liegen."
  );

  AddCmd(CMD_OEFFNEN , "cmd_oeffnen");

  AddItem(NPC "ghost.lpc", REFRESH_DESTRUCT);

  AddExit("oben", ([ EX_DEST : ROOM "sgang05",
                     EX_MSG  : "geht die Treppe hinauf" ]) );


  AddExit("osten", ROOM "kerkerz");
}

int cmd_oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer"         ||
       str == "tueren"       ||
       str == "kerkertuer"   ||
       str == "kerkertueren" )) return 0;

  TELLPLAYER("Die Kerkertueren sind fest verschlossen und lassen sich "
             "nicht oeffnen.\n");
  TELLOTHERS(TPN+" versucht vergeblich, die Kerkertueren zu oeffnen.\n");
  return 1;
}
