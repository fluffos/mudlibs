#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  AddDetail( ({"brunnen"}) ,
    "Der Brunnen liegt im Norden, Du musst schon naeher herangehen. "
  );

  AddExit( "norden",      ROOM "bhof5.lpc" );
  AddExit( "osten",       ROOM "bhof9.lpc" );
  AddExit( "westen",      ROOM "bhof7.lpc" );
  AddExit( "nordosten",   ROOM "bhof6.lpc" );
  AddExit( "nordwesten",  ROOM "bhof4.lpc" );

}

