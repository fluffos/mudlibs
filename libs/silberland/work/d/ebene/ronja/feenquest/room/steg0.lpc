#include "../def.h"

inherit "std/room";

int exit_test(string str);

string slong;
string sid;
string ziel;
string richtung;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Bootssteg");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:22]));
  SetProp(P_INDOORS,0);

  AddSound(DEFAULT_SOUND,
    "Leise plaetschern die Wellen gegen das Holz."
  );

  AddSound( ({"wellen","wellenplaetschern"}),
    "Leise plaetschern die Wellen gegen das Holz."
  );

  AddDetail( ({"sonne","himmel","sonnenlicht"}) ,
    "Die Sonne steht am Himmel und lacht Dich an."
  );

  AddDetail( ({"boden"}) ,
    "Du stehst auf einem Bootssteg. Die Planken knarren leise, wenn Du "
    "darueberlaufst, aber das ist normal, denn durch das Wasser quillt das "
    "Holz mal mehr oder weniger."
  );

  AddDetail( ({"holz","eichenholz","steg","bootssteg","planken"}) ,
    "Der Bootssteg ist aus starkem Eichenholz gebaut und ist sehr stabil. "
    "Du brauchst keine Angst zu haben, dass er zusammenbrechen koennte."
  );

  AddDetail( ({"angst"}) ,
    "Sowas kennst Du doch gar nicht, oder ?"
  );

  AddDetail( ({"wellen"}) ,
    "Ein paar kleine Wellen, welche durch den lauen Wind hervorgerufen "
    "werden."
  );

  AddDetail( ({"wasser"}) ,
    "Du bueckst Dich und haelst eine Hand ins Wasser. Brrrr, ist das kalt."
  );

  AddDetail( ({"larven","mueckenlarven"}) ,
    "Einige Mueckenlarven schwimmen im Wasser herum."
  );

  AddDetail( ({"jagd"}) ,
    "Die kleinen Fische jagen den Mueckenlarven hinterher."
  );

  AddDetail( ({"insekt","insekten"}) ,
    "Zahlreiche Insekten tummeln sich sowohl im Wasser als auch rund "
    "um den Teich."
  );

  AddDetail( ({"fisch","fische","pfahl","pfaehle","pfaehlen"}) ,
    "Zwischen den Pfaehlen siehst Du viele kleine Fische auf der Jagd "
    "nach Insekten umherschwimmen."
  );

  AddDetail( ({"wind","wasseroberflaeche","oberflaeche"}) ,
    "Der Wind kraeuselt die Wasseroberflaeche, vereinzelt entstehen "
    "auch einige kleine Wellen."
  );

  AddDetail( ({"hand"}) ,
    "Es ist Deine Hand."
  );

  AddDetail( ({"teich"}) ,
    "Der Teich liegt ruhig vor dir."
  );

  AddDetail( ({"ufer"}) ,
    "Um das Ufer besser untersuchen zu koennen, musst Du den Steg "
    "verlassen."
  );

  AddCmd( ({"flatter","flattern","flattere"}) , "cmd_flattern" );

  AddSpecialExit( "aufgabe", "aufgabe" );
  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist ... ja was eigentlich ?\n");
  return 0;
}

void init()
{
  object ticket;

  ::init();
  if(TP && query_once_interactive(TP))
  {
    if(ticket = present("\nTICKET",TP))
    {
      ticket->RemoveId( ({"\nTICKET1","\nTICKET2"}) );
      ticket->AddId(sid);
    }
    else
    {
      ticket = clone_object(OBJ "ticket");
      ticket->AddId(sid);
      ticket->move(TP,M_GET|M_NOCHECK);
    }
  }
}

string _query_int_long()
{
  string s;

  s="Du befindest Dich auf einem kleinen Bootssteg. Leise plaetschern "
    "die Wellen gegen das Holz. Im Wasser siehst Du kleine Fische auf "
    "der Jagd nach Insekten und Larven. ";

  s += slong;
/*
  DB(sprintf("TP      = %O",TP));
  DB(sprintf("TI      = %O",TI));
  DB(sprintf("TO      = %O",TO));
  DB(sprintf("ENV(TP) = %O",ENV(TP)));
*/
  if(TI && TP && query_once_interactive(TP) && (TP->QueryProp(P_RACE)=="Fee"
        || TP->is_class_member(CL_FLYING)))
  {
    s += " Du misst die Entfernung zum anderen Ufer ab und bist der "
         "Meinung, dass Du es durchaus schaffen koenntest, an das "
         "andere Ufer zu flattern.";
  }

  return BS(s);
}

int exit_test(string str)
{
  object ob;

  if(objectp(TP) && query_once_interactive(TP))
  {
    if(ob = present("\nTICKET", TP)) ob->remove();
  }

  return 1;
}

int cmd_flattern(string str)
{
  if((TP->QueryProp(P_RACE) != "Fee") && TP->QueryProp(P_FROG) )
  {
    TELLPLAYER("Als Frosch kannst Du doch gar nicht flattern.\n");
    return 1;
  }

  if(TP->QueryProp(P_RACE) != "Fee" && !TP->is_class_member(CL_FLYING))
  {
    TELLPLAYER("Als "+TP->QueryProp(P_RACE)+" kannst Du doch gar nicht "
               "flattern.\n");
    return 1;
  }

  notify_fail("Worueber willst Du flattern?\n");

  if(!(str == "hinueber"             ||
       str == "herueber"             ||
       str == "rueber"               ||
       str == "ueber teich"          ||
       str == "ueber silberteich"    ||
       str == "an anderes Ufer"      ||
       str == "an andere Uder"       ||
       str == "ans andere Uder"      )) return 0;

  if(TP->QueryProp(P_FROG))
  {
    TELLPLAYER(BS("Du versuchst Deine Fluegel zu bewegen. Aber als Frosch "
                  "hast Du gar keine Fluegel mehr, mit denen Du flattern "
                  "koenntest."));
    TELLOTHERS(CTPN+" huepft hilflos auf dem Steg hin und her.\n");
    return 1;
  }

  TELLPLAYER(BS("Du nimmst etwas Anlauf und flatterst ueber den Teich. "
                "Wohlbehalten kommst Du auf der anderen Seite an."));
  TP->move(ziel, M_GO, richtung ,"flattert","flattert herein");
  return 1;
}

