#include "../def.h"

inherit "/std/room";

#include <wizlevels.h>

#define WEG 0
#define DA 1

int amaring;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Bett");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem riesigen Himmelbett, von dem Du bisher nur "
    "getraeumt hast. Alles ist in weiss gehalten. Die schoene Seidendecke, "
    "die drei grossen Kissen und auch die feinen Tuecher, die man wie "
    "Vorhaenge um das Bett ziehen kann, damit man ungestoert ist. An den "
    "vier Bettecken sind Stangen aus Zedernholz, die oben jeweils mit "
    "einer Querstange mit den anderen Eckstangen verbunden sind. Ueber den "
    "Stangen wurde ein sehr grosses, weisses Samttuch gelegt, sodass es vom "
    "Bett aus so aussieht, als wuerden Wolken ueber einem haengen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:28]));

  AddDetail( ({"boden"}) ,
    "Du liegst in einem Bett auf einer herrlich seidigen Bettdecke, so "
    "richtig zum reinkuscheln. "
  );

  AddDetail( ({"wand","waende"}) ,
    "Seit wann haben Betten Waende? Naja, Kinderbetten vielleicht, aber "
    "dieses hier ist bestimmt kein Kinderbett. "
  );

  AddDetail( ({"kinderbett"}) ,
    "Nein, das ist bestimmt kein Kinderbett."
  );

  AddDetail( ({"bettecken","bettecke"}),
    "An jeder Bettecke ist eine Holzstange, die nicht nur das Bett selbst "
    "traegt, sondern auch die Querstangen, die wiederum das Samttuch tragen."
  );

  AddDetail( ({ "bett","himmelbett" }),
    "Ein Himmelbett wie aus dem Maerchen. Alles ist in weiss gehalten. Die "
    "schoene Seidendecke, die drei grossen Kissen und auch die feinen "
    "Tuecher, die man wie Vorhaenge um das Bett ziehen kann, damit man "
    "ungestoert ist. An den vier Bettecken sind Stangen aus Zedernholz, "
    "die oben jeweils mit einer Querstange mit den anderen Eckstangen "
    "verbunden sind. Ueber den Stangen wurde ein sehr grosses, weisses "
    "Samttuch gelegt, sodass es vom Bett aus so aussieht, als wuerden "
    "Wolken ueber einem haengen."
  );

  AddDetail( ({"seidentuecher","tuecher"}),
    "Die Seidentuecher schillern in allen Farben, da sie einerseits selbst "
    "bunt sind und andererseits durch die Sonnenstrahlen ihre Farben noch "
    "wechseln. Kaum blaest eine kleine Brise bei einem Fenster herein, "
    "bewegen sich alle wie Segeln auf einem Schiff, die nur darauf warten, "
    "dass sie zum Leben erwachen."
  );

  AddDetail( ({"fenster"}) ,
    "Irgendwo muss ein Fenster sein, denn sonst gaebe es keine Brise."
  );

  AddDetail( ({"brise"}),
    "Die spuerst Du hauptsaechlich. Sehen kannst Du sie nur, wenn Du genau "
    "darauf achtest, wann sich die Seidentuecher an der Decke bewegen."
  );

  AddDetail( ({"holzstange","holzstange","stangen","stange","eckstange"
              ,"eckstangen"}),
    "Die Stangen sind aus hochwertigem Zedernholz und ausserdem wurden sie "
    "weiss gefaerbt, damit sie im farblichen Einklang mit dem Rest des Bettes "
    "sind. Sie tragen das Bett und die Querstangen. Ausserdem sind die "
    "Samttuecher mit Kordeln an ihnen befestigt."
  );

  AddDetail( ({"farben"}),
    "Alle Farben, wie kaminrot, azurblau, olivgruen, orangenorange, "
    "eidottergelb, rosenrosa, veilchenlila, erdbraun, ..."
  );

  AddDetail( ({"kissen"}),
    "Du schnappst Dir ein Kissen und knautscht es so richtig zusammen. Ui, "
    "ist das weich! Womit die wohl gefuettert sind?"
  );

  AddDetail( ({"leben"}),
    "Du atmest tief ein. Ja, das Leben ist was Schoenes!"
  );

  AddDetail( ({"maerchen"}),
    "Denk einmal an ein paar Maerchen, dann weisst Du vielleicht, was ich "
    "meine."
  );

  AddDetail( ({"einklang"}),
    "Feen scheinen auf Einklang enorm viel Wert zu legen."
  );

  AddDetail( ({"hand"}) ,
    "Puh, noch dran!"
  );

  AddDetail( ({"kordeln","kordel"}),
    "Mit den Kordeln werden die Samttuecher festgehalten, da sie sonst in "
    "das Bett reinhaengen wuerden. Du loest sie besser nicht, denn das "
    "gefiele der Fee sicher nicht."
  );

  AddDetail( ({"querstangen","querstange"}),
    "Die sind wie die anderen Stangen auch aus Zedernholz. Sie sollen "
    "gewaehrleisten, dass das Bett nicht wackelt, und ausserdem dienen "
    "sie dazu, dass das grosse Samttuch ueber sie gelegt werden konnte."
  );

  AddDetail( ({"rest"}),
    "Der Rest des Bettes sind hier Bettdecke, Kissen und Samttuecher."
  );

  AddDetail( ({"samttuch","tuch"}),
    "Ueber dem Bett wurde ein sehr grosses Samttuch gelegt, sodass man den "
    "Eindruck hat, man wuerde Wolken ueber sich dahin ziehen sehen."
  );

  AddDetail( ({"tuecher","samttuecher"}),
    "Die Tuecher sind weiss und aus kostbarem feinen Samt. Derzeit sind sie "
    "mit Kordeln an den vier Eckstangen befestigt, sodass Du das Bett in all "
    "seiner Pracht sehen kannst."
  );

  AddDetail( ({"segeln","segel","schiff","schiffe"}),
    "Weder Segel noch Schiffe sind hier zu sehen. Da faellt Dir ein, dass "
    "Du schon lange nicht mehr segeln wartst. Wird doch endlich wieder Zeit "
    "fuer einen Ausflug!"
  );

  AddDetail( ({"sonnenstrahlen"}),
    "Muessen wohl vorhanden sein, denn sonst waer es hier sicher finster."
  );

  AddDetail( ({"vorhaenge"}),
    "Mit den Vorhaengen sind die Samttuecher gemeint, die an den vier "
    "Eckstangen befestigt sind."
  );

  AddDetail( ({"zedernholz"}),
    "Dieses Zedernholz wurde sehr genau bearbeitet, denn es sind keinerlei "
    "Ritzen oder Kerben darauf zu sehen. Ausserdem weiss keiner, woher die "
    "Feen dieses Holz haben."
  );

  AddDetail( ({"eindruck"}),
    "Der Eindruck ist sicher am staerksten, wenn man sich aufs Bett legt."
  );

  AddDetail( ({"ritzen","kerben"}),
    "Keinerlei Ritzen oder Kerben auf dem Zedernholz zu sehen."
  );

  AddDetail( ({"pracht"}),
    "Dieses Himmelbett ist eine wahre Pracht. Deine Augen koennen sich gar "
    "nicht satt sehen."
  );

  AddDetail( ({"samt"}),
    "Du hast keine Ahnung, wo dieser Samt herkommt. Du weisst nur eines: es "
    "ist feiner als alles, was Du bisher in Haenden gehabt hast."
  );

  AddDetail( ({"wert"}),
    "Wieviel dieser Einklang Dir wert ist, musst Du selbst beurteilen."
  );

  AddDetail( ({"wolken","wolke"}),
    "Die wirst Du nur sehen, wenn Du beim Fenster raussiehst, aber im Zimmer "
    "sind ganz bestimmt keine."
  );

  AddDetail( ({"augen"}),
    "Die sind aeusserst schwierig zu untersuchen."
  );

  AddDetail( ({"zimmer"}) ,
    "Das Bett muss in einem Zimmer stehen, aber durch die vielen "
    "herunterhaengenden Tuecher ist fast nichts vom Zimmer zu erkennen. "
  );

  AddSpecialDetail( ({"sachen","unmengen"})               , "detail_sachen");
  AddSpecialDetail( ({"ring","rundes"})                   , "detail_ring");
  AddSpecialDetail( ({"seidendecke", "bettdecke","decke"}), "detail_decke");
  AddSpecialDetail( ({"unebenheit"})                      , "detail_unheit");
  AddSpecialDetail( ({"etwas"})                           , "detail_etwas");

  AddCmd( ({"schwaerm","schwaerme"})  , "cmd_schwaermen");
  AddCmd( ({"loese","loes"})          , "cmd_loesen");
  AddCmd( CMD_GREIFEN                 , "cmd_greifen");
  AddCmd( ({"fuehle","fuehl"})        , "cmd_fuehlen");

  AddSpecialExit("raus", "exit_raus");

  amaring = DA;
  previous_object()->CustomizeObject();
}

int exit_raus(string str)
{
  TP->move(ROOM "schlaf.lpc",M_GO,"aus dem Bett","steigt","raekelt sich aus "
           "dem Bett heraus");
  return 1;
}

void reset()
{
  ::reset();

  amaring = DA;
}

int cmd_fuehlen(string str)
{
  notify_fail("Was moechtest Du fuehlen?\n");

  if(!str || str == "") return 0;
  if(!(str == "unebenheit"         ||
       str == "bettdecke"          ||
       str == "seidendecke"        ||
       str == "decke"              )) return 0;

  TELLPLAYER(BS("Du kannst die Unebenheit ganz genau fuehlen. Es ist etwas "
                "kleines Rundes, koennte ein Ring sein."));

  return 1;
}

int cmd_loesen(string str)
{
  notify_fail("Willst Du ein Raetsel loesen oder doch etwas anderes?\n");

  if(!str || str == "") return 0;

  if ( str == "raetsel" )
  {
    TELLPLAYER(BS("Jetzt hast Du aber Glueck gehabt, denn derzeit gibt es "
                  "keine Raetsel fuer Dich zu loesen. Ist wahrscheinlich "
                  "besser so, denn ich wage zu bezweifeln, dass Du eines "
                  "loesen kannst."
    ));
    FMASTER->Msg(TPUID+" versucht ein Raetsel zu loesen");
    return 1;
  }

  if ( -1 != member(({"kordel","samttuecher","samttuch","tuecher",
          "samttuecher von kordel","samttuch von kordel",
          "tuecher von kordel"}),str))
  {
    TELLPLAYER(BS("Voller Elan machst Du Dich an der Kordel zu schaffen, "
                  "doch leider durchschaust Du das System nicht, wie die "
                  "Vorhaenge damit befestigt wurden. Ein wenig enttaeuscht "
                  "laesst Du den Kopf kurz haengen."
    ));
    TELLOTHERS(BS(CAP(TPN)+" laesst den Kopf kurz haengen, weil etwas nicht "
                "gelungen ist."
    ));
    FMASTER->Msg(TPUID+" versucht die Kordel im Schlafzimmer zu loesen");
    return 1;
  }

  return 0;
}

int cmd_schwaermen(string str)
{
  TELLPLAYER(BS("Du faellst kurz in einen Tagtraum. Du denkst daran, wie es "
                "sein koennte, mit Deiner grossen Liebe hier im Bett unter "
                "der Decke zu verschwinden und lauter schoene Sachen zu "
                "machen, doch genau in dem Moment setzt sich ein Vogel auf "
                "den Fenstersims und weckt Dich mit seinem Gezwitscher."
  ));
  FMASTER->Msg(TPUID+" schwaermt im Schlafzimmer");
  return 1;
}

int cmd_greifen(string str)
{
  int ok,ret;
  string s;
  object ring;

  notify_fail("Wohin moechtest Du greifen?\n");

  if(!str || str == "") return 0;

  if(!(str == "unter bettdecke"      ||
       str == "unter seidendecke"    ||
       str == "unter decke"          ||
       str == "unter laken"          ||
       str == "unter bettlaken"      )) return 0;

  ret = -1;
  ok = 1;

  if(ok == 0)
  {
    s = "Du versuchst, unter die Bettdecke zu greifen, doch Du "
        "weisst nicht, wie Du unter das grosse Bettlaken greifen "
        "sollst. ";
  }
  else
  {
    if(present("\nAMARING",TP) || (amaring == WEG))
    {
      s = "Huch, Du hattest geglaubt, dass die Seidendecke aus "
          "nur einem Stueck besteht, doch sind es in Wahrheit "
          "2 Seidendecken. Geschickt greifst Du zwischen der "
          "Ueberlappung hindurch und findest.... nichts. "
          "Enttaeuscht streichst Du die Seidendecken wieder "
          "glatt. ";
    }
    else
    {
      s = "Huch, Du hattest geglaubt, dass die Seidendecke aus "
          "nur einem Stueck besteht, doch sind es in Wahrheit "
          "2 Seidendecken. Geschickt greifst Du zwischen der "
          "Ueberlappung hindurch und ziehst einen kleinen Ring hervor, ";

      ring = clone_object(ARMOUR "amaring");
      if(ring->move(TP,M_GET) == 1)
      {
        s += "den Du sofort einsteckst.";
        amaring = WEG;
        ret = 1;
      }
      else
      {
        s += "der Dir jedoch viel zu schwer ist, da Du schon Unmengen "
             "an Sachen mit Dir herumtraegst. Damit den Ring niemand sonst "
             "findet, versteckst Du ihn wieder unter der Seidendecke und "
             "beschliesst, ihn spaeter zu holen.";
        ring->remove();
      }
    }
  }

  TELLPLAYER(BS(s));
  return ret;
}

string detail_sachen(string str)
{
  string s, *things;

  things = map_objects(all_inventory(TP),"name",WEN);
  if(sizeof(things) == 0)
  {
    s = "Du traegst nichts bei Dir. ";
  }
  else
  {
    s = "Du traegst "+LW(things)+". ";
  }

  return BS(s);
}

string detail_ring(string str)
{
  string s;

  if(present("\nAMARING",TP) || (amaring == WEG))
  {
    s = "Was fuer einen Ring?";
  }
  else
  {
    s = "Vermutlich hat ihn die Feenkoenigin hier verloren. Wenn man blos "
        "irgendwie unter die Bettdecke greifen koennte, um ihn zu "
        "bekommen. ";
  }

  return BS(s);
}

string detail_decke(string str)
{
  string s;


  s = "Die Decke laedt einen foermlich ein, es sich darin bequem zu "
      "machen. Du faehrst mit Deiner Hand kurz darueber und merkst, wie "
      "zart und fein sie ist. ";

  if(!present("\nAMARING",TP) && (amaring == DA))
  {
    s += "Doch halt, was ist das? Eine kleine Unebenheit kannst Du unter "
         "der Bettdecke fuehlen.";
  }

  return BS(s);
}

string detail_unheit(string str)
{
  string s;

  if(!present("\nAMARING",TP) && (amaring == DA))
  {
    s = "Du kannst sie ganz deutlich fuehlen, scheint etwas rundes zu "
        "sein.";
  }
  else
  {
    s = "Du kannst keine Unebenheit entdecken.";
  }

  return BS(s);
}

string detail_etwas(string str)
{
  string s;

  if(!present("\nAMARING",TP) && (amaring == DA))
  {
    s = "Etwas scheint unter der Bettdecke zu liegen.";
  }
  else
  {
    s = "Schoen und gut, nur was? Ein bisschen genauer gehts nicht, hm?";
  }

  return BS(s);
}

