#include "../def.h"

inherit "std/room";

int strohdreck;

nosave string *spieler_zaumzeug;
nosave string *spieler_sattel;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Pferdebox");
  SetProp(P_INT_LONG,
    "Du stehst hier in einer Pferdebox, wo sich die Pferde unterstellen "
    "koennen. Der Boden ist mit Stroh bedeckt, an den Waenden haengen "
    "allerlei Geraete zur Pferdepflege. Die Waende bestehen allesamt aus "
    "Holz, auch das Dach besteht aus Holz. Einige Pfaehle stuetzen das "
    "Dach zusaetzlich ab. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"box","pferdebox","unterstand"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"boden"}) ,
    "Der Boden ist vollstaendig mit Stroh bedeckt, damit man die Pferde"
    "box problemlos reinigen kann."
  );

  AddSpecialDetail( ({"pferde","pferd","pferden","pferdes"
                     ,"tier","tiere"}) , "detail_pferde");

  AddSpecialDetail( ({"stroh","heu"}) ,  "detail_stroh" );

  AddDetail( ({"dach","decke","daches"}) ,
    "Das Dach wird von einigen Pfaehlen gestuetzt und besteht ebenso wie "
    "die Waende aus Brettern. Allerdings scheint noch so etwas wie "
    "Dachpappe auf dem Dach zu sein, denn zwischen den Ritzen der "
    "Bretter siehst Du kein Licht durchschimmern. So regnet es wenigstens "
    "nicht durch und die Box wird nicht nass. "
  );

  AddDetail( ({"ritze","ritzen"}) ,
    "Die Bretter der Waende und der Decke passen nicht ganz korrekt "
    "aneinander und sind auch nur grob vernagelt, so dass zwischen "
    "den Brettern mehr oder weniger grosse Ritzen vorhanden sind. Das "
    "ist aber nicht weiter schlimm, denn es handelt sich lediglich um "
    "einen Unterstand, der nur drei Waende hat. Da ist es egal, ob sich "
    "zwischen den Brettern noch Ritzen befinden. "
  );

  AddDetail( ({"pfaehle","pfaehlen","pfahl"}) ,
    "Mehrere Pfaehle stuetzen das Dach. An einem Pfahl lehnt eine Mistgabel. "
  );

  AddDetail( ({"mistgabel"}) ,
    "Ein ganz normale Mistgabel mit 5 Zinken und einem Holzgriff."
  );

  AddDetail( ({"zinken"}) ,
    "An den Zinken klebt noch etwas Pferdemist. Igitt."
  );

  AddDetail( ({"holzgriff","griff"}) ,
    "An dem Holzgriff sieht man ganz genau, wo die Mistgabel immer "
    "angefasst wurde, denn dort ist das Holz vom Schweiss verfaerbt. "
  );

  AddDetail( ({"schweiss","stirn","stirne"}) ,
    "Von der Stirne heiss, rinnen muss der Schweiss... ach nein, das "
    "war etwas ganz anderes. "
  );

  AddDetail( ({"licht"}) ,
    "Durch die Ritzen in den Brettern schimmert etwas Licht von draussen "
    "hindurch. Noch mehr Licht kommt natuerlich durch die offene Seite. "
  );

  AddDetail( ({"dachpappe","pappe"}) ,
    "Das Dach ist wohl zusaetzlich mit Dachpappe abgedeckt. Zwar sind "
    "zwischen den Brettern des Daches ebenfalls Ritzen wie in den Waenden "
    "vorhanden, aber Du kannst nicht hindurchschauen. Irgendetwas muss sich "
    "also auf dem Dach befinden. Eigentlich logisch, denn wenn es durch "
    "die Ritzen hindurch regnen wuerde waere ja das ganze Stroh nass und der "
    "Unterstand waere voellig nutzlos. "
  );

  AddDetail( ({"bretter","brettern"}) ,
    "Es handelt sich um ganz normale Bretter, die recht grob zusammen"
    "genagelt worden. So kann der Wind durch die Ritzen pfeifen. Es "
    "soll aber nur ein Unterstand gegen extrem schlechtes Wetter sein. "
  );

  AddDetail( ({"wand","waende","waenden"}) ,
    "Die Box besteht nur aus drei Waenden. Nach einer Seite ist die Box "
    "vollstaendig offen, aber als Wetterschutz ist das voellig ausreichend. "
    "An den Waenden haengen diverse Geraete zur Pferdepflege. Die Waende "
    "bestehen aus einfachen Brettern, welche nur grob zusammengenagelt "
    "wurden und in den Ecken lediglich mit Keilen verstaerkt sind. "
    "Zwischen den Brettern befinden sich auch Ritzen. Aber als Unterstand "
    "fuer die Pferde reicht es allemal. "
  );

  AddDetail( ({"keilen","keile"}) ,
    "Die Bretter sind in den Ecken nochmals mit Keilen verstaerkt, "
    "damit der Unterstand nicht gleich wieder in sich zusammenfaellt. "
  );

  AddDetail( ({"ecke","ecken"}) ,
    "Der Unterstand besteht nur aus drei Waenden, weshalb auch nur "
    "zwei Ecken existieren, naemlich eine linke und eine rechte. "
  );

  AddDetail( ({"linke ecke"}) ,
    "In der linken Ecke befindet sich ein groesserer Strohhaufen. Er dient "
    "wohl weniger als Futter, vielmehr wird mit diesem Stroh der Boden "
    "neu ausgelegt, wenn das alte Stroh am Boden zu schmutzig ist. "
  );

  AddDetail( ({"strohhaufen"}) ,
    "In der linken Ecke befindet sich ein Vorrat an Stroh, mit dem man den "
    "Boden neu auslegen kann. "
  );

  AddDetail( ({"rechte ecke"}) ,
    "In der rechten Ecke steht ein groesser Holzbock. Sieht fast so aus "
    "wie ein sehr rudimentaeres Schaukelpferd ohne Kopf. "
  );

  AddDetail( ({"schaukelpferd"}) ,
    "Du denkst zurueck an Deine Kindheit, und wie Du immer mit Deinem "
    "Schaukelpferd gespielt hast. Aber jetzt ist es vorbei damit. "
  );

  AddDetail( ({"kindheit"}) ,
    "Lang, lang ist's her."
  );

  AddDetail( ({"kopf"}) ,
    "Na hoffentlich ist Dein Kopf noch da, wo er hingehoert. "
  );

  AddDetail( ({"holzbock","bock"}) ,
    "Der Holzbock besteht aus 4 Kanthoelzer und einem fuenften quer dazu. "
  );

  AddSpecialDetail( ({"kantholz","kanthoelzer"}) , "detail_kantholz" );

  AddDetail( ({"sattel"}) ,
    "Hier in der Ecke ist es zu dunkel, um den Sattel zu untersuchen. "
    "Zumindest wenn er noch auf dem Holzbock liegt. "
  );

  AddDetail( ({"zaumzeug"}) ,
    "Hier in der Ecke ist es zu dunkel, das Zaumzeug zu untersuchen. "
    "Zumindest wenn es noch am Holzbock haengt. "
  );

  AddDetail( ({"bein","beine"}) ,
    "Der Holzbock hat 4 Beine. Als Du sie Dir genauer anschaust, siehst Du "
    "an einem der Beine ein Zaumzeug haengen. "
  );

  AddDetail( ({"wetterschutz"}) ,
    "Dieser Unterstand soll den Pferden als Wetterschutz dienen. "
  );

  AddDetail( ({"pferdepflege","pflege","reinigung"}) ,
    "Pferde muessen auch gepflegt werden. Fuer die taegliche Reinigung "
    "reicht es, wenn man sie striegelt, dann den Schmutz mit einer "
    "Kardaetsche entfernt und schliesslich noch das Fell buerstet, damit "
    "es schoen glaenzt. Nicht vergessen, die Hufe mit dem Hufkratzer "
    "zu reinigen. "
  );

  AddDetail( ({"seite","seiten"}) ,
    "Der Unterstand besteht aus drei Seiten, so dass die Pferde sich "
    "unterstellen koennen. Jede Seite besteht aus Brettern, welche ueber"
    "einandergenagelt wurden. "
  );

  AddDetail( ({"geraet","geraete"}) ,
    "An einer Wand haengen Geraete zur Pferdepflege, naemlich ein "
    "Striegel, eine Kardaetsche, eine Buerste und ein seltsamer Haken. "
  );

  AddDetail( ({"buerste"}) ,
    "Mit der Buerste buerstet man das Pferd ab, nachdem man es gestriegelt "
    "und mit der Kardaetsche von grobem Schmutz befreit hat. "
  );

  AddDetail( ({"schmutz"}) ,
    "Ja, auch Pferde werden mal schmutzig. "
  );

  AddDetail( ({"haken"}) ,
    "Wird wohl ein Hufkratzer sein, um groben Schmutz von den Pferdehufen "
    "zu entfernen. "
  );

  AddDetail( ({"holz","holzart"}) ,
    "Die Bretter bestehen aus ganz normalen Holz. Nichts besonderes. Durch "
    "die starke Verwitterung kannst Du noch nicht mal sagen, um welche "
    "Holzart es sich hierbei handelt. "
  );

  AddDetail( ({"witterung","wind","wetter"}) ,
    "Wind und Wetter haben den Brettern zwar aeusserlich zugesetzt, "
    "doch anscheinend hat man sie lange genug gelagert, so dass sie immer "
    "noch sehr stabil sind. "
  );

  AddDetail( ({"verwitterung"}) ,
    "Die Bretter sind schon ewig lange der Witterung ausgesetzt, und sehen "
    "auch entsprechend so aus. Trotzdem sind sie immer noch stabil, denn "
    "baufaellig ist der Unterstand nicht. Einer solchen Gefahr wuerde man "
    "die Pferde sicherlich nicht aussetzen. "
  );

  AddDetail( ({"gefahr"}) ,
    "Eine Gefahr, dass der Unterstand zusammenfaellt, besteht nicht."
  );

  AddDetail( ({"hufkratzer"}) ,
    "Mit dem Hufkratzer reinigt man die Hufe von Pferden. "
  );

  AddDetail( ({"kardaetsche"}) ,
    "Die Kardaetsche benutzt man um groben Schmutz aus dem Fell eines "
    "Pferdes zu entfernen. "
  );

  AddDetail( ({"striegel"}) ,
    "Mit dem Striegel kannst Du den groben Schmutz im Fell eines Pferdes "
    "lockern. "
  );

  AddDetail( ({"fell"}) ,
    "Wo kein Pferd, da auch kein Fell."
  );

  AddDetail( ({"huf","hufe","pferdehufe","pferdehufen"}) ,
    "Wo kein Pferd, da auch keine Hufe."
  );

  AddDetail( ({"junge", "stalljunge"}),
    "Der ist im Moment nicht da, wo der sich wohl wieder herumtreibt? "
  );

  AddDetail( ({"pferdeapfel"}),
    "Puuuh, der stinkt!"
  );

  AddDetail( ({"moment"}),
    "Zack - vorbei."
  );

  AddSpecialDetail( ({"mist","pferdemist"}) , "detail_mist");

  AddSound( DEFAULT_SOUND,
    "In der Ferne hoerst Du ein Pferd wiehern."
  );

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es extrem nach Pferdemist."
  );

  AddSmell( ({"pferdemist","mist"}) ,
    "Du ruempfst die Nase."
  );

  AddSmell( ({"nase"}) ,
    "Ja, mit der Nase riecht man fuer gewoehnlich. "
  );

  AddExit( "westen" , ROOM "koppel4");

  AddCmd( ({"mist","miste"})                , "cmd_misten");
  AddCmd( CMD_NEHMEN                        , "cmd_nehmen");
  AddCmd( ({"reinig","reinige","saeubere"}) , "cmd_reinigen" );
  AddCmd( ({"leg","lege"})                  , "cmd_legen");
  AddCmd( ({"haenge","haeng"})              , "cmd_haengen");

  AddItem(NPC "pferd", REFRESH_DESTRUCT);
  AddItem(NPC "pferd", REFRESH_DESTRUCT);
  AddItem(NPC "pferd", REFRESH_DESTRUCT);

  strohdreck = 0;

  restore_object(ROOM "box0");

  spieler_sattel   = ({ });
  spieler_zaumzeug = ({ });
}

void init()
{
  ::init();
  if(TP && TP->id("\nFEENPFERD"))
  {
    strohdreck++;
    if(strohdreck > 9) strohdreck = 0;
  }
}

void reset()
{
  save_object(ROOM "box0");

  spieler_sattel   = ({ });
  spieler_zaumzeug = ({ });

  ::reset();
}

string detail_stroh(string str)
{
  return BS(
    ({"Das Stroh ist noch ganz frisch und wurde wohl erst vor kurzem "
      "ausgewechselt."
     ,"Das Stroh ist bereits ein wenig zertreten, aber ansonsten noch "
      "ganz sauber und braucht nicht ausgewchselt werden."
     ,"Das Stroh ist bereits ziemlich zertreten, aber noch sauber."
     ,"Das Stroh ist bereits zertreten, man sieht deutlich, dass hier "
      "Pferde ein und ausgehen. "
     ,"Das Stroh ist schon ganz schoen zertreten und in einer Ecke "
      "liegt bereits ein Pferdeapfel. Das Stroh sollte bald mal "
      "ausgewechselt werden. "
     ,"Das Stroh ist schon total zertreten und auch einige Pferdeaepfel "
      "liegen bereits in einer Ecke. "
     ,"Das Stroh ist durch das dauernde hinauslaufen der Pferde schon "
      "recht dreckig, auch befindet sich schon Pferdemist darin. Es ist "
      "wirklich Zeit, dass das Stroh mal ausgewechselt wird. "
     ,"Das Stroh ist schon total dreckig, jetzt wird es aber wirklich "
      "Zeit, das Stroh einmal auszuwechseln. "
     ,"Wieso wechselt denn bloss niemand das Stroh aus? Es ist total "
      "dreckig und voller Pferdemist. "
     ,"Das Stroh ist schon recht alt, voellig dreckig und voller Pferdemist. "
      "Es ist allerhoechste Zeit, dass es endlich ausgewechselt wird. "
     })[strohdreck]
  );
}

string detail_mist(string str)
{
  return BS(
    ({"Der Stall wurde vor kurzem erst entmistet."
     ,"Der Stall wurde vor kurzem erst entmistet."
     ,"Die Pferde laufen zwar ein und aus, aber etwas fallen gelassen hat "
      "noch keines."
     ,"Da liegt doch tatsaechlich schon etwas Mist auf dem Stroh herum."
     ,"Wenn das Stroh laengere Zeit nicht entmistet wiurde, findet man "
      "hier und da auch etwas Mist."
     ,"Da liegt unueberseh schon etwas Mist im Stroh."
     ,"Es wird Zeit, dass hier mal ausgemistet wird."
     ,"Man sollte den Stall wirklich mal ausmisten, ist ja ja schon recht "
      "viel Mist drin."
     ,"Das Stroh ist schon voller Pferdemist, das muss dringend "
      "ausgemistet werden."
     ,"Es ist allerhoechste Zeit, dass hier mal entmistet wird."
     })[strohdreck]
  );
}

string detail_pferde(string str)
{
  string s;
  int n;

  n = sizeof(filter_objects(all_inventory(TO),"id","\nFEENPFERD"));

  switch(n)
  {
    case 0 : s = "Momentan befinden sich keine Pferde in der Box. "; break;
    case 1 : s = "Es befindet sich ein Pferd in der Box. ";break;
    case 2 : s = "Du siehst zwei Pferde in der Box. ";break;
    default: s = "Es stehen ein paar Pferde in der Box. ";
  }

  return BS(s);
}

string detail_kantholz(string str)
{
  string s;

  s = "Das Holz ist recht grob bearbeitet. 4 Kanthoelzer bilden die Beine, "
      "waehrend das fuenfte Kantholz quer dazu festgenagelt wurde. ";

  if(member(spieler_sattel, getuuid(TP)) == -1)
    s += "Auf diesem liegt ein Sattel. ";

  return BS(s);
}

string detail_beine(string str)
{
  string s;

  s = "Der Holzbock hat 4 Beine. ";

  if(member(spieler_zaumzeug,getuuid(TP)) == -1)
    s += "Als Du sie Dir genauer anschaust, siehst Du "
         "an einem der Beine ein Zaumzeug haengen. ";

  return BS(s);
}

int cmd_haengen(string str)
{
  int n;
  string was,woran;
  object ob;

  notify_fail("Was moechtest Du woran haengen\n");

  if(!str || str == "") return 0;

  n = sscanf(str,"%s an %s",was,woran);
  if(n!=2) return 0;

  if(!(was == "zaumzeug"  || was == "zuegel")) return 0;
  if(!(woran == "bock"    ||
       woran == "holzbock"||
       woran == "bein"    ||
       woran == "beine"   )) return 0;

  if(!(ob=present("zaumzeug",TP)))
  {
    TELLPLAYER("Da hast doch gar kein Zaumzeug bei Dir.\n");
    return -1;
  }

  TELLPLAYER("Du haengst das Zaumzeug wieder dahin, wo es hingehoert.\n");
  TELLOTHERS(CTPN+" wurschtelt in einer Ecke herum.\n");
  spieler_zaumzeug -= ({ getuuid(TP) });
  ob->remove();
  return 1;
}

int cmd_legen(string str)
{
  object sattel;
//kein notify_fail weil standardkommando
  if(!str || str == "") return 0;

  if(!(str == "sattel ab"           ||
       str == "sattel auf holzbock" ||
       str == "sattel auf kanzholz" ||
       str == "sattel auf bock"     )) return 0;

  if(!(sattel=present("sattel",TP)))
  {
    TELLPLAYER("Du hast doch gar keinen Sattel bei Dir.\n");
    return -1;
  }

  TELLPLAYER("Du legst den Sattel wieder dahin, wo er hingehoert.\n");
  TELLOTHERS(CTPN+" wurschtelt in einer Ecke herum.\n");
  sattel->remove();
  spieler_sattel -= ({ getuuid(TP) });
  RINGMASTER->Msg(TPUID+" legt den Sattel zurueck");

  return 1;
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;

  if(str == "gabel"         ||
     str == "mistgabel"      )
  {
    TELLPLAYER(BS("Die wird der Stalljunge wohl noch brauchen. Lass sie "
                  "lieber mal da stehen. "));
    return -1;
  }

  if(str == "sattel")
  {
    if(present("sattel",TP))
    {
      TELLPLAYER("Du hast den Sattel bereits an Dich genommen.\n");
      return -1;
    }

    if(member(spieler_sattel,getuuid(TP)) > -1)
    {
      notify_fail("Du siehst hier keinen Sattel.\n");
      return 0;
    }

    ob = clone_object(OBJ "sattel");
    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      TELLPLAYER("Der Sattel ist Dir allerdings viel zu schwer.\n");
      ob->remove();
    }
    else
    {
      TELLPLAYER(BS("Du nimmst den Sattel an Dich. Aber ist das nicht "
                    "Diebstahl? Naja, Du denkst Dir, dass Du den Sattel "
                    "nach getaner Arbeit wieder auf den Holzbock legst. "));
      TELLOTHERS(TPN+" nimmt etwas an sich.\n");
      RINGMASTER->Msg(TPUID+" nimmt den Pferdesattel");
      spieler_sattel += ({ getuuid(TP) });
    }

    return 1;
  }

  if(str == "zaumzeug")
  {
    if(present("zaumzeug",TP))
    {
      TELLPLAYER("Du hast das Zaumzeug bereits an Dich genommen.\n");
      return -1;
    }

    if(member(spieler_zaumzeug, getuuid(TP)) > -1)
    {
      TELLPLAYER("Du siehst hier kein Zaumzeug.\n");
      return -1;
    }

    ob = clone_object(OBJ "zaumzeug");
    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      TELLPLAYER("Das Zaumzeug ist Dir allerdings viel zu schwer.\n");
      ob->remove();
    }
    else
    {
      TELLPLAYER(BS("Du nimmst das Zaumzeug an Dich. Wenn Du es nicht mehr "
                    "brauchst, kannst Du es jederzeit wieder an den Holzbock "
                    "haengen."));
      TELLOTHERS(TPN+" nimmt etwas an sich.\n");
      RINGMASTER->Msg(TPUID+" nimmt das Zaumzeug");
      spieler_zaumzeug += ({ getuuid(TP) });
    }
    return 1;
  }

  return 0;
}

int cmd_misten(string str)
{
  notify_fail("Was moechtest Du ausmisten?\n");

  if(!str || str == "") return 0;
  if(!(str == "stall mit gabel aus"    ||
       str == "stall mit heugabel aus" ||
       str == "stall aus"              ||
       str == "box"                    ||
       str == "pferdebox"              ||
       str == "box aus"                ||
       str == "pferdebox aus"          )) return 0;

  if(strohdreck < 4)
  {
    TELLPLAYER(BS("Das Stroh ist noch nicht so dreckig, dass es aus"
                  "gewechselt werden muesste. "));
    TELLOTHERS(BS(TPN+" schaut lange und nachdenklich auf den Boden."));
    return -1;
  }

  TELLPLAYER(BS("Du schnappst Dir die Mistgabel und entmistet mal eben "
                "die Pferdebox. Sah aber auch wirlich zu schlimm aus. "
                "Haben die Feen keinen Pferdewirt?"));

  TELLOTHERS(BS(TPN+" betaetigt sich als Stalljunge und mistet die "
                "Pferdebox aus."));
  strohdreck = 0;
  RINGMASTER->Msg(TPUID+" mistet den Stall aus");

  return 1;
}

int cmd_reinigen(string str)
{
  notify_fail("Was moechstest Du reinigen?\n");

  if(!str || str == "") return 0;
  if(!(str == "stall"               ||
       str == "stall mit mistgabel" ||
       str == "stall mit gabel"     ||
       str == "box"                 ||
       str == "pferdebox"           )) return 0;

  cmd_misten("stall aus");
  return 1;
}

