#include "../def.h"

inherit "std/room";

#include <wizlevels.h>

int exitfunc(string dir);

string ausgang;
string seilort;
string seilein;
string aturm;

mapping werfer;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Turm" );
  SetProp(P_INT_LONG,
    "Hier oben auf dem Turm des Feenschlosses hast Du einen grossartigen "
    "Blick ueber die Ebene. Im Westen siehst Du den beruehmten Silberwald, "
    "hinter dem sich ein gewaltiges Gebirge mit seinen schneebedeckten "
    "Gipfeln erstreckt. Im Sueden erkennst Du die Stadt Midas mit ihrem "
    "geschaeftigen Treiben. Die Leute sehen von hier aus wie Ameisen! Der "
    "Ausblick laesst Dich den beschwerlichen Aufgang ueber die Wendeltreppe "
    "vergessen. Du laesst Dir den Wind durch die Haare fahren und geniesst "
    "einige Minuten diesen Ausblick."
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"ameisen","leute","ameisenhaufen","geschaeftsleute"}) ,
    "Wie Ameisen sehen die Leute in Midas von hier oben aus."
  );

  AddDetail( ({"aufgang"}) ,
    "Der Aufgang war ganz schoen eng und beschwerlich."
  );

  AddDetail( ({"ausblick","aussicht","blick","ebene","silberland"}) ,
    "Du geniesst diesen herrlichen Ausblick und schaust noch einmal ueber "
    "die Ebene."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus massiven Steinen."
  );

  AddDetail( ({"wand","waende"}) ,
    "Waende gibt es hier direkt keine, aber damit niemand herunterfallen "
    "kann, gibt es rundherum Turmzinnen."
  );

  AddDetail( ({"feenschloss","schloss","schlosses","schlosshof"
              ,"feenschlosses"}) ,
    "Unter Dir erkennst Du die ganze Pracht des Schlosses. Im Schlosshof "
    "siehst Du einen Diener, wie er lustlos einen Besen schwingt."
  );

  AddDetail ( ({"gebirge", "berge", "berg"}),
    "Hoch ragen die schneebedeckten Gipfel auf. Du kannst foermlich spueren, "
    "dass sich viele Geheimnisse tief unter ihnen verbergen."
  );

  AddDetail( ({"gipfel","gipfeln"}) ,
    "Die Gipfel sind schneebedeckt und funkeln in der Sonne."
  );

  AddDetail( ({"schnee"}) ,
    "Der ist viel zu weit weg, als dass Du ihn von hier aus untersuchen "
    "koenntest."
  );

  AddDetail( ({"sonne"}) ,
    "Schau nicht direkt in die Sonne, das ist nicht gut fuer die Augen. "
  );

  AddDetail( ({"haare"}) ,
    "Deine Haare wehen im Wind."
  );

  AddDetail( ({"himmel","blau"}) ,
    "Ueber Dir erstrahlt der Himmel in einem satten Blau."
  );

  AddDetail( ({"midas","handelszentrum","stadt"}) ,
    "Midas ist das Handelszentrum der Ebene. Von hier oben sieht das "
    "Treiben der Geschaeftsleute wie ein Ameisenhaufen aus."
  );

  AddDetail( ({"treiben"}) ,
    "Geschaeftig wie die Ameisen laufen die Leute in Midas umher."
  );

  AddDetail( ({"minuten","minute"}) ,
    "Eine Minute hat 60 Sekunden."
  );

  AddDetail( ({"sekunden","sekunde"}) ,
    "60 Sekunden ergeben eine Minute."
  );

  AddDetail( ({"silberwald","wald","silberwaldes"}) ,
    "Maechtig strecken sich die Wipfel der Baeume des Silberwaldes in den "
    "Himmel."
  );

  AddDetail( ({"turm"}) ,
    "Du stehst darauf und geniesst den Ausblick. Turmzinnen verhindern, dass "
    "Du herunterfaellst. "
  );

  AddDetail( ({"turmzinnen","turmzinne","zinnen","zinne"}) ,
    "Die Turmzinnen verhindern, dass jemand herunterfaellt. Man kann sich "
    "auch prima auf die Turmzinnen lehnen und die Aussicht geniessen. "
  );

  AddDetail( ({"kratzer"}) ,
    "Hmmmm, da hat doch jemand eine Zeichnung in den Stein gekratzt. "
  );

  AddDetail( ({"zeichnung"}) ,
    "                              \n"
    "                              \n"
    "      .-\"\"\"-.    .-\"\"\"-.      \n"
    "     /       '..'       \\     \n"
    "    |                    |    \n"
    "    |                    |    \n"
    "     \\                  /     \n"
    "      \\                /      \n"
    "       `\\            /'       \n"
    "         `\\        /'         \n"
    "           `\\    /'           \n"
    "             `\\/'             \n"
    "                              \n"
    "Swindel Frei liebt Walpurgis  \n"
  );

  AddDetail( ({"herz"}) ,
    "Schau an, da war jemand so arg verliebt, dass er ein Herz in den Stein "
    "gekratzt hat."
  );

  AddDetail( ({"swindel","frei","swindel frei","swindelfrei"}) ,
    "Hmmm, vielleicht fragst Du mal Walpurgis."
  );

  AddDetail( ({"walpurgis","wirtin","taverne"}) ,
    "Walpurgis ist die Wirtin der Taverne hier."
  );

  AddDetail( ({"wendeltreppe"}) ,
    "Sie fuehrt wieder nach unten in das Schloss."
  );

  AddDetail( ({"wind","windboe"}) ,
    "Ein leichter Wind geht hier oben und streicht Dir ueber das Gesicht. "
    "Ab und zu frischt auch mal eine Windboe auf."
  );

  AddDetail( ({"wipfel","baum","baeume"}) ,
    "Maechtig erheben sich die Baeume des Silberwaldes, der sich im Westen "
    "erstreckt. "
  );

  AddDetail( ({"stein","steine","steinen"}) ,
    "Der Turm ist ganz aus Steinen gebaut, welche aus dem Gebirge "
    "herangeschafft wurden. "
  );

  AddDetail( ({"geheimnisse"}) ,
    "Du nimmst Dir vor, sie demnaechst zu ergruenden."
  );

  AddDetail( ({"gesicht"}) ,
    "Du schliesst die Augen und geniesst es, wie der Wind ueber Dein Gesicht "
    "streicht. "
  );

  AddDetail( ({"augen"}) ,
    "Zwei davon hast Du, mitten im Gesicht."
  );

  AddDetail( ({"diener"}) ,
    "Die Diener im Schloss kuemmern sich um all die weltlichen Aufgaben, "
    "die es so im Schloss zu erledigen gibt."
  );

  AddDetail( ({"aufgabe","aufgaben"}) ,
    "Die Aufgaben eines Dieners interessieren Dich nicht sonderlich, Du "
    "willst lieber Abenteuer im Silberland erleben. Aber wenn Du es partout "
    "nicht lassen kannst, such Dir einen Besen und hilf mit, das Schloss "
    "fegen. "
  );

  AddDetail( ({"abenteuer"}) ,
    "Geh am besten nach Midas, dort wirst Du viele Abenteurer finden, die Dir "
    "von ihren Abenteuern gerne erzaehlen werden."
  );

  AddDetail( ({"abenteurer"}) ,
    "Geh nach Midas und erkundige Dich nach ihnen."
  );

  AddDetail( ({"pracht"}) ,
    "Prachtvoll erstreckt sich das Schloss unter dir."
  );

  AddDetail( ({"besen"}) ,
    "So ganz genau kannst Du nicht erkennen, was der Diener bei sich hat, "
    "aber von hier oben sieht es aus wie ein Besen."
  );

  AddSpecialDetail( ({"seil"}) , "seildetail");

  AddCmd( ({ "spanne","spann","werf","werfe","wirf" }) , "cmd_spannen" );
  AddCmd( ({ "kletter","klettere","steig","steige"})   , "cmd_klettern");
  AddCmd( ({ "nimm","nehm","nehme"})                   , "cmd_nehmen");
  AddCmd( ({ "lehn","lehne"})                          , "cmd_lehnen");
  AddCmd( ({ "geniess","geniesse"})                    , "cmd_geniessen");
  AddCmd( ({ "pruef","pruefe","kontrollier","kontrolliere"})
                                                       , "cmd_pruefen");

  ausgang = "";
  seilort = "";
  seilein = "";
  aturm   = "";

  werfer = ([]);
}

void reset()
{
  ::reset();
  werfer = ([]);
}

int exitfunc(string dir)
{
  object seil;
  object room;
  string s;

  if((FMASTER->seilda()) && (FMASTER->besitzer()==getuid(TP)))
  {
    FMASTER->seilweg(TP,
      "Du siehst, wie sich "+TPN+" am Seil zu schaffen macht. "
      "Du fluchst lautstark und bereitest Dich schonmal darauf vor, "
      "auf den Schlosshof zu fallen. Da faellt auch schon das Seil "
      "herunter und Du stuerzt auf den Schlosshof. "
    );

    TELLOTHERS(CTPN+" loest das Seil und nimmt es an sich.\n");

    room = find_object(aturm);
    if(room) tell_room(room,
      BS("Das Seil faengt an zu schlackern und auf einmal loest sich "
         "der Knoten. Du schaust in Richtung des anderen Turms und "
         "siehst wie jemand das Seil einholt."),
      ({TP})
    );

    s = "Bevor Du nach unten gehst, loest Du das Seil von der "
        "Turmzinne. Wie durch ein Wunder loest sich auch der "
        "Knoten am gegenueberliegenden Turm. So fest war der wohl "
        "doch nicht. Welch ein Glueck, dass Du nicht ueber das "
        "Seil gelaufen bist. " ;

    seil=clone_object("/obj/seil.lpc");

    if(ME_TOO_HEAVY==seil->move(TP,M_GET|M_SILENT))
    {
      s += "Du kannst das Seil jedoch nicht mehr tragen und legst es "
           "erst einmal ab. ";
      seil->move(TO,M_GET|M_SILENT);
    }

    TELLPLAYER(BS(s));
  }

  return TP->move(ausgang,M_GO,"nach unten");
}

string seildetail()
{
  string s;

  s = "Sowas siehst Du hier nicht.";

  switch(FMASTER->seilda())
  {
    case 1 :
      s = "Das Seil ist zwischen den beiden Tuermen gespannt.";
      break;

    case 2 :
      s = "Das Seil ist zwischen den beiden Tuermen gespannt. Es sieht "
          "so aus, als ob man da gefahrlos draufklettern koennte.";
      break;
  }

  return BS(s);
}

int cmd_nehmen(string str)
{
  object seil;
  object room;
  string s;

  notify_fail("Was moechtest Du nehmen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "seil"     ||
       str == "seil weg" )) return 0;

  if(!FMASTER->seilda()) return 0;

  FMASTER->seilweg(TP,
    "Du siehst, wie sich "+TPN+" am Seil zu schaffen macht. "
    "Du fluchst lautstark und bereitest Dich schonmal darauf vor, "
    "auf den Schlosshof zu fallen. Da faellt auch schon das Seil "
    "herunter und Du stuerzt auf den Schlosshof. "
  );

  s = "Du machst das Seil vom Turm los und nimmst es an Dich. " ;
  seil=clone_object("/obj/seil.lpc");

  if(ME_TOO_HEAVY==seil->move(TP,M_GET|M_SILENT))
  {
    s += "Du kannst das Seil jedoch nicht mehr tragen und legst es wieder "
         "ab. ";
    seil->move(TO,M_GET|M_SILENT);
  }

  TELLPLAYER(BS(s));

  TELLOTHERS(CTPN+" loest das Seil und nimmt es an sich.");

  room = find_object(aturm);
  if(room) tell_room(room,
    BS("Das Seil faengt an zu schlackern und auf einmal loest sich "
       "der Knoten. Du schaust in Richtung des anderen Turms und "
       "siehst wie jemand das Seil einholt."),
    ({TP})
  );

  return 1;
}

int cmd_lehnen(string str)
{
  notify_fail("Worauf willst Du Dich lehnen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf zinne"        ||
       str == "auf turmzinne"    ||
       str == "auf zinnen"       ||
       str == "auf turmzinnen"   )) return 0;

  TELLPLAYER(BS("Du lehnst Dich auf eine der Turmzinnen und geniesst die "
                "Aussicht. Als Dein Blick auf die Turmzinne faellt, erkennst "
                "Du einige Kratzer in den Steinen."));

  TELLOTHERS(CTPN + " lehnt sich auf eine der Turmzinnen und geniesst die "
             "Aussicht.\n");

  FMASTER->Msg(TPUID+" lehnt auf die Turmzinnen");
  return 1;
}

int cmd_geniessen(string str)
{
  notify_fail("Was willst Du geniessen?\n");

  if(!str || str == "") return 0;

  if(!(str != "aussicht")) return 0;

  return cmd_lehnen("auf zinne");
}

int cmd_klettern(string str)
{
  object seil;
  object room;
  string s;

  notify_fail("Worauf willst Du klettern ?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf seil" ||
       str == "seil"     )) return 0;

  notify_fail("Hier ist doch gar kein Seil zum draufklettern.\n");
  if(!FMASTER->seilda()) return 0;

  s = "";
  TP->move(seilein,M_GO,"auf das Seil","klettert","steigt auf das Seil");

  if(sizeof(FMASTER->checkrooms()) > 1)
  {
    FMASTER->seilweg(TP,
      "Du siehst, wie noch jemand auf das Seil klettert. Verzweifelt "
      "versuchst Du ihm noch klar zu machen, dass das Seil euch beide "
      "nicht tragen wird, aber zu spaet. Mit einem lauten Knall zerreist "
      "das Seil und Du faellst auf den Burghof."
    );

    s += "Oh je. Du siehst noch jemand auf dem Seil. Schlagartig ahnst Du "
         "dass das Seil euch beide nicht tragen wird. Da reisst das Seil "
         "auch schon und Du faellst auf den Burghof. ";
    TELLPLAYER(BS(s));

    tell_room(TO,
      BS("Mit einem lauten Peitschenknall zerreisst das Seil, welches "
         "zwischen den beiden Tuermen gespannt war und faellt herunter."),
      ({TP})
    );

    room = find_object(aturm);
    if(room) tell_room(room,
      BS("Mit einem lauten Peitschenknall zerreisst das Seil, welches "
         "zwischen den beiden Tuermen gespannt war und faellt herunter."),
      ({TP})
    );

    TP->move(ENV(TP)->QueryProp(P_RAUMUNTEN),
             M_GO,"von oben herunter","faellt","faellt herunter");

    FMASTER->Msg(TPUID+" klettert auf das Seil und jetzt sind zuviele darauf");
  }
  else
  {
    if(FMASTER->seilda()==1)
    {
      s += " Du haettest aber doch besser die Knoten geprueft, die Du "
           "gemacht hast. So fest waren die naemlich nicht und prompt "
           "loesen sie sich und Du faellst hinunter.";
      TELLPLAYER(BS(s));

      tell_room(TO,
        BS("Mit einem lauten Peitschenknall zerreisst das Seil, welches "
           "zwischen den beiden Tuermen gespannt war und faellt herunter."),
        ({TP})
      );

      room = find_object(aturm);
      if(room) tell_room(room,
        BS("Mit einem lauten Peitschenknall zerreisst das Seil, welches "
           "zwischen den beiden Tuermen gespannt war und faellt herunter."),
        ({TP})
      );

      TP->AddHp(-50);
      FMASTER->seilweg(TP,"Das Seil haelt nicht.");
      seil = clone_object("/obj/seil");
      TP->move(ENV(TP)->QueryProp(P_RAUMUNTEN),
               M_GO,"von oben herunter","faellt","faellt herunter");
      seil->move(ENV(TP), M_NOCHECK|M_SILENT);
      tell_room(ENV(TP),"Ein Seil faellt von oben herunter.\n");
      FMASTER->Msg(TPUID+" klettert auf das Seil ohne es zu pruefen");
    }
    else
    {
      TELLPLAYER(BS(s));
      FMASTER->Msg(TPUID+" klettert auf das Seil");
    }
  }

  return 1;
}

void try1(object seil)
{
  TELLPLAYER(BS("Du machst eine Schlaufe an dem Seil, so dass Du ein Lasso "
                "bekommst. Gekonnt wirbelst Du das Seil ueber Deinem Kopf "
                "und wirfst es zu dem Turm hinueber. Leider triffst Du keine "
                "Turmzinne. Du fluchst und aergerst Dich und zu alledem "
                "laesst Du auch noch ungeschickterweise das Seil fallen. "
                "Du beugst Dich ueber die Turmzinnen und siehst es unten im "
                "Schlosshof liegen. "
  ));
  TELLOTHERS(CAP(TPN)+" wirft ungeschickterweise ein Seil auf den "
             "Schlosshof.\n");
  seil->move(seilort,M_PUT);
  tell_room(ENV(seil),"Ein Seil faellt von oben herunter.\n");
  FMASTER->Msg(TPUID+" spannt erfolglos ein Seil und verliert es");
}

void try2(object seil)
{
  TELLPLAYER(BS("Du machst eine Schlaufe an dem Seil, so dass Du ein Lasso "
                "bekommst. Gekonnt wirbelst Du das Seil ueber Deinem Kopf "
                "und wirfst es zu dem anderen Turm hinueber. Leider triffst "
                "Du keine Turmzinne. Du fluchst und aergerst Dich und ziehst "
                "das Seil wieder ein. "
  ));
  TELLOTHERS(BS(CAP(TPN)+" versucht ein Seil auf den anderen Turm zuwerfen, "
             "trifft aber nicht."));
  FMASTER->Msg(TPUID+" spannt erfolglos ein Seil");
}

void try3(object seil)
{
  object room;

  if(FMASTER->spanne_seil(getuid(TP)))
  {
    TELLPLAYER(BS("Du machst eine Schlaufe an dem Seil, so dass Du ein Lasso "
                  "bekommst. Gekonnt wirbelst Du das Seil ueber Deinem Kopf "
                  "und wirfst es zu dem anderen Turm hinueber. Die Schlaufe "
                  "verfaengt sich an einer der Turmzinnen. Du spannst das "
                  "Seil ganz fest und befestigst es auch hier an einer "
                  "Turmzinne. "
    ));
    TELLOTHERS(CAP(TPN)+" spannt ein Seil zwischen den beiden Tuermen.\n");

    if(room = find_object(aturm))
    {
      tell_room(room, BS("Du siehst auf dem gegenueberliegenden Turm, wie "
                         "jemand ein Seil hinueber wirft. Das Seil verfaengt "
                         "sich in den Turmzinnen und wird auf einmal straff "
                         "gespannt. Ob man da wohl draufklettern kann? "));
    }

    seil->remove();
    FMASTER->Msg(TPUID+" spannt ein Seil zwischen den Tuermen");
  }
  else
  {
    TELLPLAYER("Da ist schon ein Seil zwischen den Tuermen gespannt.\n");
  }
}

int cmd_pruefen(string str)
{
  notify_fail("Was moechtest Du pruefen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "seil"         ||
       str == "knoten"       )) return 0;

  if(FMASTER->pruefe_seil())
  {
    TELLPLAYER(BS("Du pruefst nochmal die Spannung des Seiles und bist "
                  "Dir sicher, dass Du gefahrlos auf das Seil klettern "
                  "koenntest."));
    return 1;
  }

  return 0;
}

int cmd_spannen(string str)
{
  object seil;
  int dex;
  string uid;

  notify_fail("Was willst Du zwischen den Tuermen spannen ?\n");

  if(!str || str == "") return 0;

  if(!(str == "seil"                            ||
       str == "seil zwischen tuerme"            ||
       str == "seil zwischen den tuermen"       ||
       str == "seil an turm"                    ||
       str == "seil an tuerme"                  )) return 0;

  if(!seil=present("seil",TP))
  {
    TELLPLAYER(BS("Du hast ja gar kein Seil bei dir."));
    return 1;
  }

  if(seil->query_tied_to_ob())
  {
    TELLPLAYER("Du hast das Seil festgebunden. So konnst Du es nicht "
               "benutzen.\n");
    return 1;
  }

  if(FMASTER->seilda())
  {
    TELLPLAYER("Da ist schon ein Seil zwischen den Tuermen gespannt.\n");
    return 1;
  }

  dex = 2*TP->QueryAttribute(A_DEX);
  dex = dex + random(101-dex);

  uid = getuid(TP);
  if(werfer[uid] < 1) dex = 0; // beim ersten mal immer pech
  werfer[uid] = werfer[uid] + 1;
  if(werfer[uid] > 3) dex = 100; // nach 4 fehlversuchen wirds nervig

  if(IS_WIZARD(TP)) dex = 100; // magier beim testen triffts nie

  switch(dex)
  {
    case  0..50: try1(seil); break;
    case 51..75: try2(seil); break;
    default    : try3(seil); break;
  }

  return 1;
}

