  AddDetail( ({"maisfeld","feld"}) ,
    "Im Norden befindet sich ein Feld mit meterhohen, gruenen Pflanzen. "
    "Selbst aus dieser Entfernung kannst Du erkennen, dass es sich hierbei "
    "um ein Maisfeld handelt. "
  );

  AddDetail( ({"pflanze","pflanzen"}) ,
