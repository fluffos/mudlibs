#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Musikzimmer" );
  SetProp(P_INT_LONG,
    "Das Musikzimmer des Schlosses. Hier finden regelmaessig die "
    "unterschiedlichsten Konzerte statt und jeder darf hier sein Koennen "
    "zum Besten geben. Momentan befinden sich jedoch nur ein paar Stuehle "
    "und ein grosser Fluegel im Zimmer. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"zimmer","musikzimmer","raum"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende sind mit einer speziellen Tapete beklebt, um die Akustik "
    "zu verbessern."
  );

  AddDetail( ({"tapete"}) ,
    "Diese Tapete hat bestimmt der Soundmagier angefertigt. Am besten fragst "
    "Du ihn mal danach."
  );

  AddDetail( ({"soundmagier"}) ,
    "Der Soundmagier lebt im Sueden von Derlim, der Hauptstadt der Hobbits. "
  );

  AddDetail( ({"hobbits","volk","voelkchen"}) ,
    "Die Hobbits sind ein gar lustig Voelkchen, aber wenns drauf ankommt, "
    "stehen sie durchaus ihren Mann. Unterschaetz sie nur nicht !"
  );

  AddDetail( ({"stuhl","stuehle"}) ,
    "Die Stuehle haben alle kein Sitzkissen, die sind wohl in der Reinigung."
  );

  AddDetail( ({"reinigung"}) ,
    "Glaubst Du wirklich, die Feen machen das selbst ?"
  );

  AddDetail( ({"fee","feen"}) ,
    "Im Moment ist keine da."
  );

  AddDetail( ({"schloss","schlosses","feenschlosses","schloss"}) ,
    "Du befindest Dich in ihm."
  );

  AddDetail( ({"konzert","konzerte"}) ,
    "Momentan findet keines statt, versuch es doch spaeter einmal. "
  );

  AddDetail( ({"koennen"}) ,
    "Beherrschst Du ein Musikinstrument ? Dann koenntest Du ja selbst einmal "
    "ein Konzert geben. Obwohl - ob sich jemand dafuer interessiert ?"
  );

  AddDetail( ({"decke"}) ,
    "Die Decke besteht aus einem speziellen Holz, damit die Akustik "
    "besonders gut ist."
  );

  AddDetail( ({"holz"}) ,
    "Das hat bestimmt auch der Soundmagier ausgesucht."
  );

  AddDetail( ({"akustik"}) ,
    "Die Akustik in diesem Raum ist einfach genial. Selbst wenn Du etwas "
    "fluesterst, kann es jeder ganz deutlich auch in der letzten Ecke hoeren. "
  );

  AddDetail( ({"ecke","ecken"}) ,
    "Dieser Raum hat 4 Ecken. Wie die meisten anderen Raeume auch."
  );

  AddDetail( ({"Boden"}) ,
    "Der Boden ist aus demselben Holz wie die Decke."
  );

  AddDetail( ({"sitzkissen","kissen"}) ,
    "Keines da. Vermutlich alle in der Reinigung."
  );

  AddDetail( ({"raeume"}) ,
    "Jawoll! Immer schoen fleissig forschen!"
  );

  AddDetail( ({"mann"}) ,
    "Musst Du alles was grossgeschrieben ist untersuchen ?"
  );

  AddDetail( ({"hauptstadt","derlim","huegelland"}) ,
    "Derlim ist die Hauptstadt vom Huegelland und ist ziemlich weit entfernt."
  );

  AddDetail( ({"fluegel","musikinstrument"}) ,
    "Ein schoener alter Fluegel. Der Lack ist auf Hochglanz poliert, so dass "
    "Du Dich darin spiegeln kannst. Die Klaviatur ist geoeffnet. Du kannst "
    "ja mal auf eine Taste druecken."
  );

  AddDetail( ({"lack","hochglanz"}) ,
    "Der Lack ist auf Hochglanz poliert."
  );

  AddDetail( ({"patscher"}) ,
    "Keine drauf. Der Lack ist auf Hochglanz poliert."
  );


  AddDetail( ({"taste"}) ,
    "Wenn Du Dich traust, kannst Du ja mal eine druecken."
  );

  AddDetail( ({"klaviatur"}) ,
    "Die ist geoeffnet, Du siehst jede Menge schwarze und weisse Tasten."
  );

  AddDetail( ({"menge"}) ,
    "Es wirklich viele Tasten."
  );

  AddDetail( ({"tasten"}) ,
    "Jeder Fluegel hat eine bestimmte Anzahl von Tasten, welche, wenn man "
    "sie drueckt, dazu fuehren, dass man etwas hoert."
  );

  AddDetail( ({"Anzahl"}) ,
    "Dieser Fluegel hat 84 Tasten."
  );

  AddDetail( ({"glanz"}) ,
    "Du kanns Dich drin spiegeln."
  );

  AddSound(DEFAULT_SOUND,
    "Bei dieser hervorragenden Akustik kannst Du Dich selber atmen hoeren."
  );

  AddCmd( ({"fluester","fluestere"}) , "cmd_fluestern" );
  AddCmd(  CMD_SETZEN                , "cmd_setzen" );
  AddCmd(  CMD_DRUECKEN              , "cmd_druecken" );
  AddCmd( ({"schliess","schliesse"}) , "cmd_schliessen");
  AddCmd( ({"polier","poliere"})     , "cmd_polieren");

  AddExit("norden", ROOM "sgang11.lpc");
  AddExit("sueden", ROOM "sgang13.lpc");

}

int cmd_polieren(string str)
{
  notify_fail("Was moechtest Du polieren?\n");

  if(!str || str == "") return 0;
  if(!(str == "klavier"         ||
       str == "das klavier"     )) return 0;

  TELLPLAYER("Das Klavier ist schon auf Hochglanz poliert.\n");
  return 1;
}

int cmd_fluestern(string str)
{
  string s;

  s = this_player()->_unparsed_args();

  TELLOTHERS(BS(TPN+" fluestert : "+s));
  TELLPLAYER(BS("Du fluesterst so leise, dass Dich normalerweise niemand "
                "verstehen koennte."));
  FMASTER->Msg(TPUID + " fluestert im Musikzimmer: " + s);
  return 1;
}

int cmd_setzen(string str)
{
  notify_fail("Worauf willst Du Dich setzen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf stuhl"       ||
       str == "dich auf stuhl"  ||
       str == "hin"             ||
       str == "dich hin"        )) return 0;

  TELLPLAYER(BS("Du kannst Dich nicht auf die Stuehle setzen, da die "
                "Sitzkissen nicht da sind. Vermutlich in der Reinigung."
  ));
  return 1;
}

int cmd_druecken(string str)
{
  notify_fail("Was willst Du druecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "taste"     ||
       str == "auf taste" )) return 0;

  tell_room(TO,"Pling!\n");
  return 1;
}

int cmd_schliessen(string str)
{
  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;
  if(!(str == "klaviatur"     ||
       str == "klavierdeckel" )) return 0;

  TELLPLAYER(BS("Dann wuerde aber jeder die Patscher Deiner Haende sehen, "
                "also laesst Du es lieber."));
  return 1;
}
