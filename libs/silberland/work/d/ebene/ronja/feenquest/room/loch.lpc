#include "../def.h"

inherit "/std/room";

#include <wizlevels.h>

int graben(string str);
int blubber(object pl);
int blubber2(int count,object pl);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein verschuetterter Gang");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem verschuetteten Gang. Rings um Dich "
    "befindet sich nur Fels und Gestein. Vielleicht war es doch keine "
    "so gute Idee, hier hinein zu kriechen."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_HIDE_EXITS, 1);
  SetProp(P_NO_TPORT, NO_TPORT_IN|NO_TPORT_OUT);

  AddDetail( ({"gang"}) ,
    "Vielleicht kannst Du ja vorwaerts krabbeln?"
  );

  AddDetail( ({"boden"}) ,
    "Vielleicht hilft robben?"
  );

  AddDetail( ({"decke"}) ,
    "Die liegt auf Dir."
  );

  AddDetail( ({"wand","waende"}) ,
    "Alles um Dich herum ist Fels und Gestein."
  );

  AddDetail( ({"fels","gestein"}) ,
    "Fels und Gestein ist rings um dich."
  );

  AddDetail( ({"idee"}) ,
   "Die waere wirklich noetig, um hier herauszukommen."
 );

  AddCmd( ({"robbe","krieche",
            "grabe","krabbele",
            "robb","kriech",
            "grab","krabbel"}), "cmd_graben");

  previous_object()->CustomizeObject();
}

init()
{
  ::init();
  if(TP && interactive(TP) && !IS_WIZARD(TP)) call_out("blubber", 4, TP);
}

int cmd_graben(string str)
{
  TELLPLAYER("Du strengst Dich furchtbar an, kommst aber keinen Zentimeter "
             "weiter.\n");
  FMASTER->Msg(TPUID+" versucht verzweifelt aus dem Loch zu entkommen");
  return 1;
}

void blubber(object pl)
{
  if(!pl)              return;
  if(!interactive(pl)) return;
  if(ENV(pl) != TO)    return;

  if(pl->QueryProp(P_GHOST))
  {
    call_out("blubber3", 2, 1, pl);
    return;
  }

  if(pl->QueryProp(P_HP) < 25)
  {
    call_out("blubber2", 2, 1, pl);
    return;
  }

  switch (random(10))
  {
    case 0 :
      tell_object(pl,
        "Ein Stein faellt Dir auf den Kopf und raubt Dir kurzzeitig die "
        "Besinnung.\n");
      break;

    case 1 :
      tell_object(pl,
        "Die Decke gibt nach und zerquetscht einen Teil Deines Beines.\n");
      break;

    case 2 :
      tell_object(pl,"Du bekommst kaum noch Luft hier.\n");
      break;

    case 3 :
      tell_object(pl,"Etwas - Du willst gar nicht wissen was - "
        "beisst Dir in den Arm.\n");
      break;

    case 4 :
      tell_object(pl,"Panik ueberkommt Dich.\n");
      break;

    case 5 :
      tell_object(pl,"An einem hervorstehenden Stein schlitzt Du Dir "
        "den Bauch auf.\n");
      break;

    default :
      tell_object(pl,BS("Die Felsen druecken Dir den Brustkorb zusammen "
        "und Du kannst kaum noch atmen."));
      break;
  }

  pl->AddHp(-(random(15)+15));
  call_out("blubber", 6, pl);
  return;
}

void blubber2(int step, object pl)
{
  if(!interactive(pl)) return;
  if(ENV(pl) != TO)    return;

  switch(step)
  {
    case 1:
      tell_object(pl, "[Tod:Lars] "+CAP(getuid(pl))+" ist gerade in einem "
                      "Verlies verschuettet worden.\n");
      break;

    case 2:
      tell_object(pl,"Du denkst Dir: Nein, nicht schon wieder!\n\n\n");
      break;

    case 3:
      tell_object(pl,
        BS("Du baeumst Dich gegen Dein Schicksal auf, sammelst alle Deine "
           "verfuegbaren Kraefte und versuchst, aus dem verschuettetem Gang "
           "herauszukommen, und Du schaffst es tatsaechlich! Du siehst noch "
           "wie Tods Haende ins Leere greifen.")
          +"\nLars grinst Dich aus der Ferne an.\n\n\n");
      break;

    case 4:
      pl->AddHp(20);
      pl->move(ROOM "kerker.lpc", M_GO|M_SILENT);
      return;
      break;
  }

  call_out("blubber2",4,++step,pl);
  return;
}

void blubber3(int step, object pl)
{
  if(!interactive(pl)) return;
  if(ENV(pl) != TO)    return;

  tell_object(pl,BS("Als Geist ist es Dir ein leichtes, durch die Felsen "
                    "zu schweben."));

  pl->move(ROOM "kerker.lpc", M_GO|M_SILENT);

  return;
}



