#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm" );
  SetProp( P_INT_LONG,
    "Du befindest Dich im aeltesten Teil des Schlosses, dem Gruenengelturm. "
    "Gegen ihn wirken die beiden anderen Tuerme des Schlosses fast mickrig. "
    "Dieser Turm ist nicht nur alt, sondern uralt. Seine Erbauer leben "
    "nicht mehr, es ist sogar fraglich, ob die Rasse der Erbauer noch "
    "existiert. Vielleicht finden sich Schriftrollen in der Bibliothek von "
    "Elessar, aber ob noch jemand die alten Schriftzeichen entziffern kann?"
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende bestehen aus einem extrem harten Gestein, das wohl tief aus "
    "dem Gebirge gebrochen wurde. So tief graben sicherlich noch nicht "
    "einmal die Zwerge. "
  );

  AddDetail( ({"turm","tuerme","fuss","fusse"}) ,
    "Du befindest Dich im Fusse des Gruenengelturms."
  );

  AddDetail( ({"fuesse"}) ,
    "Zieh Deine Schuhe besser nicht aus, eventuell koennten andere Spieler "
    "erstinken."
  );

  AddDetail( ({"teil"}) ,
    "Ein Teil ist ein Stueck eines Ganzes."
  );

  AddDetail( ({"stueck"}) ,
    "Ein Stueck ist ein Teil des Ganzen."
  );

  AddDetail( ({"ganz","ganzen","ganzes"}) ,
    "Ein Ganzes besteht aus all seinen Teilen."
  );

  AddDetail( ({"schriftzeichen"}) ,
    "Du siehst keine Schriftzeichen hier, weder an der Decke, noch an der "
    "Waenden. Und auf dem Boden auch nicht. "
  );

  AddDetail( ({"schloss","schlosses","feenschloss","feenschlosses"}) ,
    "Der Gruenengelturm ist ein Teil des Feenschlosses."
  );

  AddDetail( ({"rasse","rassen",
               "elf"  ,"mensch"  ,"zwerg" ,"fee" ,"oger","troll" ,"dunkelelf"  ,"hobbit",
               "elfen","menschen","zwerge","feen"       ,"trolle","dunkelelfen","hobbits"}) ,
    "Derzeit gibt es folgende Rassen im Silberland: "
    "Elfen, Menschen, Zwerge, Hobbits, Feen, Oger, Trolle und Dunkelelfen."
  );

  AddDetail( ({"gruenengelturm","turm","engelturm"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"erbauer"}) ,
    "Frag doch mal im Schloss herum, ob noch jemand die Erbauer kennt, wenn "
    "Dich das wirklich interessiert. Oder stoebere in den Bibliotheken des "
    "Silberlandes. "
  );

  AddDetail( ({"bibliothek","bibliotheken"}) ,
    "Die bekannteste und groesste befindet sich in Elessar."
  );

  AddDetail( ({"elessar"}) ,
    "Elessar befindet sich von hier aus im Nordwesten."
  );

  AddDetail( ({"decke"}) ,
    "Auch die Decke besteht aus diesem seltsamen Gestein."
  );

  AddDetail( ({"silberland","silberlandes"}) ,
    "Du befindest Dich mittendrin."
  );

  AddDetail( ({"schriftrollen","schriftrolle"}) ,
    "Dazu solltest Du eine Bibliothek aufsuchen."
  );

  AddDetail( ({"gestein"}) ,
    "Das ist sicherlich kein normales Gestein, denn dieser Turm ist uralt "
    "und zeigt keinerlei Beschaedigungen."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus demselben Gestein wie auch die Decke und die "
    "Waende. "
  );

  AddDetail( ({"gebirge"}) ,
    "Von hier aus kannst Du es nicht sehen. Besteige doch einmal den Turm "
    "im Nordosten des Schlosses, bei guter Fernsicht kann man von dort aus "
    "das Gebirge sehen. "
  );

  AddDetail( ({"Beschaedigungen"}) ,
    "Keine Beschaedigungen bedeutet, dass KEINE Beschaedigungen vorhanden "
    "sind."
  );

  AddDetail( ({"fernsicht"}) ,
    "Wenn man weit blicken kann, nennt man das auch Fernsicht. Hier unten "
    "im Turm hast Du natuerlich keine. "
  );

  AddExit("westen", ROOM "sgang08.lpc");
  AddExit("sueden", ROOM "sgang10.lpc");
  AddExit("oben",   ROOM "turm21.lpc");

  AddItem(NPC "fee.lpc", REFRESH_DESTRUCT);
}


