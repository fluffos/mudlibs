#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Pfad");
  SetProp(P_INT_LONG,
    "Hier endet der Pfad. Vor Dir liegt der Silberteich. Lange Zeit war er "
    "versumpft und eigentlich nicht mehr als ein mooriger Tuempel, doch "
    "nun schwimmen wieder Seerosen auf ihm, seine Ufer sind mit Schilf "
    "gesaeumt, an dessen Rand Libellen Jagd auf andere Insekten machen. Von "
    "irgendwoher quakt leise ein Frosch. Auch ein Bootssteg wurde angelegt."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));

  AddDetail( ({"sonne","himmel","sonnenlicht"}) ,
    "Die Sonne steht am Himmel und lacht Dich an."
  );

  AddDetail( ({"boden"}) ,
    "Du stehst am Ufer eines Sees. Leise plaetschern die Wellen ans Ufer."
  );

  AddDetail( ({"zeit"}) ,
    "Du nimmst Dir etwas Zeit und geniesst den See."
  );

  AddDetail( ({"tuempel"}) ,
    "Das war einmal. Nun ist es wieder ein prachtvoller See."
  );

  AddDetail( ({"ufer","rand","uferrand","stelle","stellen"}) ,
    "An einigen Stellen des Sees waechst dichtes Schilf, in dem wohl einige "
    "Voegel brueten. Der Wind wiegt die Halme leicht hin und her."
  );

  AddDetail( ({"pfad","ende"}) ,
    "Du stehst am Ende des Pfades direkt vor dem Silberteich."
  );

  AddDetail( ({"seerose","seerosen"}) ,
    "Mitten auf dem See schwimmen Seerosen. Auf einigen Blaettern kannst "
    "Du Froesche erkennen, und einige Seerosen strecken auch schon ihre "
    "Blueten aus dem Wasser, aber noch sind sie geschlossen. Wie schoen "
    "muss es hier erst sein, wenn die Seerosen zu bluehen beginnen."
  );

  AddDetail( ({"schilf"}) ,
    "An einigen Stellen des Ufers waechst dichtes Schilf. Da Du "
    "befuerchtest, dort bruetende Voegel zu stoeren, untersuchst Du es "
    "nicht weiter. Die Halme wiegen sanft im Wind."
  );

  AddDetail( ({"libelle","libellen"}) ,
    "Vor dem Schilf schweben einige Libellen auf der Jagd nach anderen "
    "Insekten. Ihre Flugkuenste sind unuebertroffen. Ihre Fluegel "
    "schimmern im Sonnenlicht."
  );

  AddDetail( ({"insekten","insekt"}) ,
    "Zahlreiche Insekten gibt es am See. Teilweise jagen sie andere "
    "Insekten, teilweise sind sie Nahrung fuer andere Tiere."
  );

  AddDetail( ({"frosch","froesche","blaetter","blaettern"}) ,
    "Auf den Blaettern der Seerose entdeckst Du einige Froesche, die traege "
    "in der Sonne liegen und immer wieder einmal nach einem vorbeifliegendem "
    "Insekt schnappen. Aus dem Schilf erklingt leises Quaken, dort verbergen "
    "sich wohl auch noch einige Froesche. "
  );

  AddDetail( ({"bootssteg","steg"}) ,
    "Der Bootssteg sieht aus wie neu. Leise plaetschern die Wellen dagegen."
  );

  AddDetail( ({"wind"}) ,
    "Der Wind streicht sanft ueber das Schilf und die Halme wiegen sich im "
    "Wind. Auf dem Wasser erzeugt der Wind ein paar kleine Wellen, anderswo "
    "kraeuselt sich das Wasser nur."
  );

  AddDetail( ({"wellen"}) ,
    "Der Wind erzeugt einige kleine Wellen, die leise gegen das Ufer "
    "plaetschern. Ansonsten ist der See vollkommen ruhig. "
  );

  AddDetail( ({"wasser","see"}) ,
    "Das Wasser des Sees ist eiskalt und laedt nicht gerade zum Baden ein."
  );

  AddDetail( ({"voegel"}) ,
    "Zahlreiche Voegel bevoelkern den See. Du willst sie allerdings nicht "
    "stoeren, einige brueten sicherlich, und begnuegst Dich mit dem, was "
    "Du siehst. "
  );

  AddDetail( ({"tiere"}) ,
    "Zahlreiche Tiere bevoelkern den See. Schau Dich nur richtig um."
  );

  AddDetail( ({"silberteich","teich","heimat","zier","zierde"}) ,
    "Der Silberteich war lange Zeit nur ein morastiger Tuempel, doch nun "
    "ist er wieder eine Zierde fuer den Silberwald und bietet vielen Tieren "
    "eine neue Heimat."
  );

  AddDetail( ({"nahrung","treiben"}) ,
    "Viele Tiere finden hier am Silberteich Nahrung, und so herrscht ein "
    "emsiges Treiben rund um den See."
  );

  AddDetail( ({"jagd"}) ,
    "Einge Tiere gehen hier auf die Jagd, da es hier ein reichliches "
    "Angebot gibt. "
  );

  AddDetail( ({"angebot"}) ,
    "Es ist ein reichliches Angebot, aber das sagte ich ja schon."
  );

  AddDetail( ({"halme"}) ,
    "Die Halme des Schilfes wiegen sich sanft im Wind."
  );

  AddDetail( ({"flugkunst","flugkuenste","kunststuecke","kunststueckchen"}) ,
    "Die Libellen beherrschen die Flugkunst ausgezeichnet. Auf der Stelle "
    "fliegen, rueckwaerts fliegen und sonstige Kunststueckchen beherrschen "
    "sie aus dem Eff-eff."
  );

  AddDetail( ({"eff-eff"}) ,
    "Wenn jemand etwas aus dem eff-eff beherrscht, so ist damit gemeint, "
    "dass er es perfekt beherrscht."
  );

  AddDetail( ({"fluegel"}) ,
    "Die Fluegel der Libelle sirren in der Luft. Mit ihrer Hilfe kann die "
    "Libelle sogar in der Luft stehen bleiben oder rueckwaerts fliegen."
  );

  AddDetail( ({"bluete","blueten"}) ,
    "Die Seerose ist mitten auf dem See. Daher kannst Du die Blueten nicht "
    "genau untersuchen. Das siehst nur, dass sie noch geschlossen sind."
  );

  AddDetail( ({"silberwald","silberwaldes","wald","waldes"}) ,
    "Der ist hier ganz in der Naehe, Du stehst quasi an seinem Rand."
  );

  AddDetail( ({"naehe"}) ,
    "Na nicht weit weg eben."
  );

  AddDetail( ({"luft"}) ,
    "Die Luft ist frisch und Du atmest ein paar mal tief ein und aus."
  );

  AddDetail( ({"quaken"}) ,
    "Das kann man nur hoeren."
  );

  AddSound( ({DEFAULT_SOUND}) ,  "Irgendwo quakt leise ein Frosch.");
  AddSound( ({"quaken","frosch"}) ,  "Quaaaaak.");
  AddSound( ({"voegel","vogel","tschirp"}), "Tschirp! Tschirp! Tschirp!");

  AddCmd( ({"bade","bad","schwimm","schwimme"}) , "cmd_baden");
  AddCmd( ({"geniess","geniesse"})              , "cmd_geniessen");

  AddExit("osten",   ROOM "steg1.lpc");
  AddExit("sueden",  ROOM "weg2.lpc");

  AddExit("westen",  "/d/ebene/creative/silberwald/room/vorraum_cadrim");
}

int cmd_baden(string str)
{
  notify_fail("Worin willst Du baden?\n");

  if(!str || str == "") return 0;
  if(!(str == "in see"   ||
       str == "see"      ||
       str == "teich"    ||
       str == "in teich" )) return 0;

  TELLPLAYER("In dem eiskalten Wasser???\n");
  TELLOTHERS(BS(TPN+" macht anstalten zu baden, ueberlegt es sich aber doch "
                "noch anders."));
  return 1;
}

int cmd_geniessen(string str)
{
  notify_fail("Was moechtest Du geniessen?\n");

  if(!str || str == "") return 0;
  if(!(str == "den see"   ||
       str == "see"       )) return 0;

  TELLPLAYER("Du rastest etwas und geniesst den See.\n");
  TP->command_me("raste");
  return 1;
}
