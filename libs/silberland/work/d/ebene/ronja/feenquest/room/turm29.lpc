inherit "/std/room";

#include "../def.h"

int antifrosch;

int probieren(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Turmzimmer");
  SetProp(P_INT_LONG,
    "Du stehst am Ende der Treppe. Du bist in einem Turmzimmer gelandet, "
    "das ueber und ueber mit merkwuerdigen Apparaten gefuellt ist. Da "
    "brodelt, funkt und zischt es, dass Dir hoeren und sagen vergeht."
  );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:25]));

  AddDetail( ({"zimmer","raum","turmzimmer"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"ende"}),
    "Du siehst das Ende der Treppe.");

  AddDetail( ({"boden", "steinboden"}),
    "Du stehst auf einem Steinboden.");

  AddDetail( ({"decke"}) ,
    "Auch sie besteht aus Stein. Aber Du erkennst einen kleinen schwarzen "
    "Fleck in der Decke. "
  );

  AddDetail( ({"fleck"}) ,
    "Bei genauerem hinsehen bemerkst du, dass dies "
    "kein Fleck ist, sondern ein kleines Loch."
  );

  AddDetail( ({"loch","kleines loch"}) ,
    "Durch dieses Loch fuehrt der Magier bestimmt seine astronomischen "
    "Beobachtungen durch."
  );

  AddDetail( ({"beobachtung","beobachtungen"}) ,
    "Die macht der Magier nur nachts, wenn es Sterne zu sehen gibt."
  );

  AddDetail( ({"stern","sterne"}) ,
    "Jetzt am Tag kann man die natuerlich nicht sehen !"
  );

  AddDetail( ({"tag"}) ,
    "Wenn Du Dich nicht taeuschst, ist jetzt Tag. Aber zur Sicherheit "
    "kannst Du gerne draussen nachsehen."
  );

  AddDetail( ({"sicherheit","sicher"}) ,
    "Sicher ist sicher."
  );

  AddDetail( ({"magier"}) ,
    "Hmmm, der scheint im Moment nicht da zu sein."
  );

  AddDetail( ({"stein"}),
    "Der ganze Turm ist aus Stein gebaut.");

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind von oben bis unten mit magischen Symbolen "
    "und Zauberspruechen bekritzelt. "
  );

  AddDetail( ({"symbole","symbol"}) ,
    "Du hast keine Ahnung was sie bedeuten sollen."
  );

  AddDetail( ({"zaubersprueche","zauberspruechen","schrift"}) ,
    "Es ist eine dir unbekannte Schrift."
  );

  AddDetail( ({"ahnung","schimmer"}),
    "Nicht den Schimmer einer Ahnung."
  );

  AddDetail( ({"treppe", "gang", "treppengang"}),
      "Sie ist steil und fuehrt nach unten."
  );

  AddDetail( ({"turm"}) ,
      "Gross und maechtig ragt er ueber das Land."
  );

  AddDetail( ({"apparate","apparaten"}) ,
    "Du hast keine Ahnung, wozu die Apparate dienen, die auf dem "
    "Tisch stehen. In manchen brodeln Dir unbekannte Chemikalien."
  );

  AddDetail( ({"tisch"}) ,
    "Auf dem Tisch stehen eine Menge Apparate und Chemikalien. Ein etwas "
    "groesserer Kolben steht am Rande. "
  );

  AddDetail( ({"rand","rande"}) ,
    "Am Rand des Tisches steht ein etwas groesserer Kolben. "
  );

  AddSpecialDetail( ({"kolben"}) , "detail_kolben" );
  AddDetail( ({"tropfen"}) ,
    "Viel zuwenige, um davon zu trinken. "
  );

  AddSmell(DEFAULT_SMELL, "Es stinkt nach allerlei Chemikalien.");

  AddSound( ({DEFAULT_SOUND}) ,
    "Es brodelt und zischt, dass Dir hoeren und sehen vergeht."
  );

  AddSmell( ({"chemie","chemikalien","chemikalie"}) ,
    "Lass das lieber, die koennten giftig sein."
  );

  AddDetail( ({"chemie","chemikalie","chemikalien"}) ,
    "Die sehen giftig aus. Ich wuerde sie lieber nicht probieren."
  );

  AddCmd( ({"probier","probiere"}), "cmd_probieren");
  AddCmd( ({"schau","schaue"})    , "cmd_schauen");

  AddCmd("trink|trinke&kolben|fluessigkeit",
    "cmd_trinken",
    "Was moechtest Du trinken?\n"
  );

  AddItem(NPC "magier.lpc", REFRESH_DESTRUCT);

  AddExit("unten", ROOM "turm22.lpc");

  antifrosch = 3;
}

void reset()
{
  ::reset();

  if(antifrosch != 3)
  {
    tell_room(TO, "Auf dem Tisch brummt etwas.\n");
  }
}

string detail_kolben(string str)
{
  string s;

  s = "Auf dem Tisch steht ein Kolben, der Dein Interesse weckt. ";

  switch(antifrosch)
  {
    case 3:
      s += "Er ist randvoll mit einer roetlichen Fluessigkeit gefuellt. ";
      break;

    case 2:
      s += "Er ist mit einer roetlichen Fluessigkeit gefuellt. ";
      break;

    case 1:
      s += "Es befindet sich noch einwenig einer roetlichen Fluessigkeit "
           "darin, gerade noch ein Schlueckchen koennte man sagen. ";

      break;

    default:
      s += "Es befinden sich noch ein paar Tropfen einer roetlichen "
           "Fluessigkeit darin, aber viel zu wenig als das man davon "
           "trinken koennte. ";

  }

  if(antifrosch > 0)
  {
    s += "Trinken oder nicht trinken, das ist hier die Frage!";
  }

  return BS(s);
}

int cmd_schauen(string str)
{
  notify_fail("Worunter moechtest Du schauen?\n");

  if(!str || str == "") return 0;

  if(!(str == "tisch"         ||
       str == "unter tisch"   )) return 0;

  TELLPLAYER("Du schaust unter den Tisch, findest aber nichts.\n");
  return 1;
}

int cmd_probieren(string str)
{
  notify_fail(BS("Was willst Du probieren ?"));

  if(!str || str == "") return 0;

  if(!(str == "chemikalie"  ||
       str == "chemikalien" )) return 0;

  TELLPLAYER(BS("Du sagst zu Dir selbst \"Probieren geht ueber Studieren\", "
                "steckst einen Finger in einen der Kolben und probierst "
                "vorsichtig. Hmmmmm .... das war aber lecker. Du fuehlst "
                "Dich frisch und gestaerkt. Doch kurz darauf wird Dir "
                "schwarz vor Augen, Deine Ohren droehnen und Dir kommt es "
                "vor, als wuerde jemand ein heisses Brenneisen in Deine "
                "Eingeweide druecken. "
  ));

  TELLOTHERS(TPN+" probiert eine der Chemikalien.\n");
  FMASTER->Msg(TPUID+" probiert eine der Chemikalien");
  TP->AddPoison(4);

  return 1;
}

int cmd_trinken(string str)
{
  if(antifrosch <= 0)
  {
    tell_object(TP, "Der Kolben ist so gut wie leer, da kann man nichts "
                    "mehr daraus trinken.\n");

    return -1;
  }

  if(!TP->QueryProp(P_FROG))
  {
    tell_object(TP, BS("Du setzt an, um einen Schluck aus dem Kolben zu "
                       "nehmen, aber die Fluessigkeit riecht so widerlich, "
                       "das Du es dann doch laesst. "));
    return -1;
  }

  tell_object(TP, BS("Du huepfst auf den Tisch und schaffst es irgendwie, "
                     "aus dem Kolben zu trinken. Die merkwuerdige "
                     "Fluessigkeit wirkt sofort und Du wirst wieder gross "
                     "und fuehlst Dich auch nicht mehr so gruen. Doch "
                     "nun bist Du viel zu gross und purzelst schmerzhaft "
                     "vom Tisch herunter. "));

  TP->SetProp(P_FROG, 0);
  TP->AddHP(-10);

  FMASTER->Msg(TPUID+" entfroscht sich beim Magier");

  antifrosch -= 1;

  return 1;
}


