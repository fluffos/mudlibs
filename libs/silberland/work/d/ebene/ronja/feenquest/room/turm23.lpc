#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Nebengang");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem kleinen Nebengang, der sich leicht nach "
    "oben windet. Am Ende des Ganges erkennst Du einen schwachen Schimmer, "
    "vermutlich von dem Raum, in den dieser Gang fuehrt. Obwohl Du Dich "
    "vermutlich in den Mauern des Gruenengelturmes bewegst, ist es hier "
    "keineswegs kalt oder gar muffig. Ein kleines Fenster spendet etwas "
    "Licht. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus dicken massiven Felsbloecken. Anscheinend "
    "befindest Du Dich mitten in dem Mauern des Gruenengelturmes. Der "
    "Gang geht leicht nach oben allerdings sind keine Treppenstufen "
    "vorhanden. "
  );

  AddDetail( ({"felsbloecke","felsblock","felsbloecken"}) ,
    "Von weit her muss man diese maechtigen Felsbloecke geholt haben."
  );

  AddDetail( ({"treppe","treppen","treppenstufen","Treppenstufe"}) ,
    "Der Gang beitzt keine Treppe, sondern geht leicht bergauf "
    "und windet sich dabei innerhalb der Mauern nach oben. Was Dich "
    "dort am Ende des Ganges wohl erwartet ?"
  );

  AddDetail( ({"decke"}) ,
    "Auch die Decke besteht wie der Boden und die Waende aus massiven "
    "Felsbloecken. Schon beim bauen des Gruenengelturmes muss man diesen "
    "Gang eingeplant haben, denn es sind keinerlei Bearbeitungsspuren "
    "zu erkennen. "
  );

  AddDetail( ({"bearbeitungsspuren"}) ,
    "Es sind keine Bearbeitungsspuren zu erkennen."
  );

  AddDetail( ({"wand","waende","waenden"}) ,
    "Die Waende sind eigentlich nichts anderes als die Mauern des "
    "Turmes, denn dieser Gang laeuft wohl innerhalb der Mauern entlang. "
    "An den Waenden kannst Du ebensowenig Bearbeitungsspuren erkennen "
    "wie am Boden oder an der Decke. Dieser Gang wahr wohl von "
    "vorneherein geplant. An einer der Waende befindet sich ein kleines "
    "Fenster. "
  );

  AddDetail( ({"ende"}) ,
    "Am Ende des Ganges kannst Du einen Schimmer erkennen. Anscheinend "
    "befindest sich dort ein Raum, dessen Licht du siehst. "
  );

  AddDetail( ({"fenster"}) ,
    "Das Fenster is recht klein und mit einer kleinen Butzenscheibe "
    "verschlossen, damit es in diesem Gang nicht so kalt ist. "
  );

  AddDetail( ({"butzenscheibe","scheibe","fensterscheibe"}) ,
    "Diese Art von Fensterscheibe nennt man Butzenscheibe, da sich in "
    "der Mitte eine Verdickung des Glases befindet. "
  );

  AddDetail( ({"art"}) ,
    "Es ist eine Butzenscheibe, zweifelslos. "
  );

  AddDetail( ({"verdickung","mitte"}) ,
    "In der Mitte des der Scheibe ist das Glas etwas dicker als an den "
    "Raendern. "
  );

  AddDetail( ({"glas","glases"}) ,
    "Das Glas ist schon etwas truebe, so als ob es schon ziemlich alt waere. "
    "Aber zum durchschauen reicht es noch. "
  );

  AddDetail( ({"rand","raender","raendern"}) ,
    "Am Rand ist das Glas in Blei gefasst und in die Mauer eingelassen. "
  );

  AddDetail( ({"blei"}) ,
    "Stumpf und grau ist das Blei geworden, aber es haelt die Butzenscheibe "
    "noch immer fest im Mauerwerk. "
  );

  AddDetail( ({"gang","ganges","nebengang"}) ,
    "Der Gang laeuft innerhalb der Mauern des Gruenengelturmes leicht nach "
    "oben. Treppenstufen sind allerdings keine vorhanden. Etwas weiter "
    "vorne kannst Du einen Lichtschimmer erkennen, der wohl von einem Zimmer "
    "am Ende des Ganges herruehrt. "
  );

  AddDetail( ({"zimmer"}) ,
    "Du kannst lediglich einen Lichtschimmer erkennen, und schliesst "
    "daraus, dass nach der Biegung noch ein Zimmer vorhanden sein muss. "
  );

  AddDetail( ({"biegung"}) ,
    "Der Gang windet sich innerhalb der Mauern des Turmes nach oben. "
    "Hinter der naechsten Biegung kannst Du einen Lichtschimmer "
    "erkennen. "
  );

  AddDetail( ({"gruenengelturm","turm","gruenengelturmes","turmes"}) ,
    "Du befindest Dich direkt in den Mauern des Gruenengelturmes in einem "
    "leicht ansteigenden Gang. "
  );

  AddDetail( ({"licht"}) ,
    "Etwas Licht befindet sich am Ende des Ganges, aber das ist nicht "
    "ausreichend, um diesen Gang zu erhellen. Das meiste Licht faellt "
    "durch ein kleines Fenster an der Wand neben Dir. "
  );

  AddDetail( ({"mauer","mauern","mauerwerk"}) ,
    "Du befindest Dich direkt innerhalb der Mauern des Gruenengelturmes "
    "in einem leicht ansteigenden Gang. Wie dick muessen die Mauern sein, "
    "damit dort ein ganzer Gang Platz findet. "
  );

  AddDetail( ({"platz"}) ,
    "Die Mauern sind dick genug, so dass ein ganzer Gang darin Platz "
    "findet. Der Gang ist nicht gerade ueppig, aber man kann einigermassen "
    "bequem darin gehen. "
  );

  AddDetail( ({"raum"}) ,
    "Am Ende des Ganges scheint sich ein kleiner Raum zu befinden, denn "
    "Du kannst einen schwachen Lichtschimmer wahrnehmen, der vermutlich "
    "aus diesem Raum dringt. "
  );

  AddDetail( ({"schimmer","lichtschimmer"}) ,
    "Am Ende des Ganges kannst Du einen Lichtschimmer wahrnehmen. Dieser "
    "ruehrt vermutlich von einem Raum her. "
  );

  AddExit("westen", ROOM "turm22");
}

