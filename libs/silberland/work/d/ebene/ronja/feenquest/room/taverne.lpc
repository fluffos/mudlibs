#include "../def.h"

inherit "/std/pub";

#include <pub.h>

string plakat();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Schlosstaverne");
  SetProp(P_INT_LONG,
    "Du befindest Dich in den alten Gemaeuern der Schlosstaverne. Die "
    "Taverne ist ein grosser Raum, mit Baenken, Tischen und einer riesigen "
    "Theke. Die Kerzen die den Raum erleuchten, befinden sich auf einem "
    "Luester aus Glas, der direkt in der Mitte des Saales von der Decke "
    "haengt. Bunte Kellner eilen von Tisch zu Tisch um den wartenden "
    "Reisenden ihre Wuensche von den Lippen lesen zu koennen. Mit <menue> "
    "kannst Du die Speisekarte anschauen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:19]));
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "walpurgis");
  SetProp(P_PUBKEEPER_NAME, "Walpurgis");
  SetProp(P_PUBKEEPER_GENDER, FEMALE );

  AddSpecialDetail( ({"speisekarte", "karte"}), "detail_karte" );

  AddDetail( ({"taverne","kneipe", "schlosstaverne", "raum"}),
    "Du befindest Dich gerade in der Schlosstaverne.");

  AddDetail( ({"wand","waende","gemaeuer"}),
    "Die Waende sind aus Stein verkleidet und teilweise angeschwaerzt vom "
    "Kerzenrauch. An der Suedwand haengt ein Plakat."
  );

  AddDetail( ({"suedwand"}) ,
    "An der Suedwand haengt ein Plakat."
  );

  AddDetail( ({"plakat"}) ,
    "Wer lesen kann ist im Vorteil!"
  );

  AddDetail( ({"vorteil"}) ,
    "Man ist etwas im Vorteil, wenn man lesen kann."
  );

  AddReadDetail( ({"plakat"}) , "@@plakat@@");

  AddDetail( ({"stein", "gestein"}),
    "Ueber den Halterungen sind die Steine schwarz vom Russ. Du faehrst "
    "pruefend ueber den Stein, kannst aber nicht feststellen, wo dieser "
    "Stein herkommt."
  );

  AddDetail( ({"halterung","halterungen"}) ,
    "Es sind Halterungen fuer Fackeln."
  );

  AddDetail( ({"fackel","fackeln"}) ,
    "Walpurgis steckt wohl nur abends Fackeln in die Halterungen. Jedenfalls "
    "sind im Moment keine da."
  );

  AddDetail( ({"moment"}) ,
    "Nun. Jetzt. Genau  - jetzt."
  );

  AddDetail( ({"russ"}) ,
    "Der Russ stammt wohl von den Fackeln, die Walpurgis abends in die "
    "Halterungen steckt."
  );

  AddDetail( ({"boden"}),
    "Der Boden besteht aus alten knarrenden Parkett."
  );

  AddDetail( ({"parkett"}),
    "Alt und abgetreten knarren sie bei jeden Schritt auf ihnen."
  );

  AddDetail( ({"schritt"}),
    "Du machst einen Schritt und das Parkett knarrt."
  );

  AddDetail( ({"decke"}),
    "Sie befindet sich direkt ueber Dir. In der Mitte "
    "befindet sich ein grosser Luester."
  );

  AddDetail( ({"staub"}),
    "Sowas siehst Du hier nicht. Ehrlich!"
  );

  AddDetail ( ({"ausgang"}),
    "Er befindet sich im Westen.\n");

  AddDetail ( ({"speisesaal","saal"}),
    "So einen schoenen Saal hast Du noch nie gesehen, am liebsten wuerdest "
    "Du fuer immer hierbleiben."
  );

  AddDetail ( ({"luster", "luester", "glas", "mitte"}),
    "Der Luester ist aus Glas, sieht geputzt aus und traegt viele Kerzen."
  );

  AddDetail ( ({"rauch", "kerzenrauch"}),
    "Ueberall steht Rauch im Raum, den die billigen Kerzen verursachen."
  );

  AddDetail (({"kerzen","kerze"}),
    "Schoene rote Kerzen schmuecken den Luester.");

  AddDetail ( ({"besitzer"}),
    "Das ist Ronja.");

  AddDetail ( ({"tisch","tische","stuhl","stuehle","sessel", "bank","baenke"}),
    "Davon stehen etliche hier rum."
  );

  AddDetail( ({"kellner"}),
    "Sie eilen von Tisch zu Tisch um den wartenden Reisenden ihre Wuensche "
    "von den Lippen lesen zu koennen."
  );

  AddDetail( ({"wuensche", "wunsch"}),
    "Wenn Du einen Wunsch hast, dann schau auf der Speisekarte nach, ob er "
    "hier erfuellt werden kann."
  );

  AddDetail( ({"lippe", "lippen"}),
    "Deine eigenen Lippen kannst Du ohne Spiegel nicht sehen."
  );

  AddDetail( ({"spiegel"}),
    "Du hast leider keinen Spiegel dabei."
  );

  AddDetail ( ({"reisender", "reisende"}),
    "Er sitzt am Tisch und trinkt genuesslich sein Glas aus.\n"
  );

  AddDetail ( ({"mahlzeit","mahlzeiten"}),
    "Mahlzeit!"
  );

  AddDetail ("theke",
    "Du stehst direkt davor."
  );

  AddDetail( ({"geschichten","geschichte"}) , "Lausche ihnen einfach." );

  AddDetail( ({"leute","abenteurer","wanderer"}) ,
    "Abenteurer und Wanderer, die sich hier staerken und Geschichten erzaehlen."
  );

  AddDetail( ({"kamellen"}) ,
    "Eigentlich sind das Bonbons, aber gelegentlich werden auch alte "
    "Geschichten so bezeichnet."
  );

  AddDetail( ({"bonbon","bonbons"}) ,
    "Suesskram zum Naschen."
  );

  AddDetail( ({"suesskram"}) ,
    "Iss nicht soviel Suesskram, das ist nicht gut fuer die Figur."
  );

  AddDetail( ({"figur"}) ,
    "Schau Dich doch mal an!"
  );

  AddDetail( ({"flaschen","whiskyflaschen"}) ,
    "Die sind voll mit herrlichstem Whisky."
  );

  AddDetail( ({"whisky"}) ,
    "Der befindet sich wohl in den Flaschen, welche auf den Regalen stehen."
  );

  AddDetail( ({"regal","regale"}) ,
    "Hinter der Theke stehen einige Regale, auf denen die unterschiedlichsten "
    "Flaschen stehen."
  );

  AddSound(DEFAULT_SOUND, "Der Raum ist erfuellt von Stimmen.");

  AddSound( ({"stimme","stimmen"}) ,
    "Die Leute hier erzaehlen sich den die neuesten Geschichten."
  );

  AddSound( ({"geschichten","geschichte"}) ,
    "Du lauschst ein wenig den Geschichten. Aber Du hoerst nur alte Kamellen. "
    "Gelangweiligt wendest Du Dich ab."
  );

  AddSound( ({"kamellen"}) ,
    "Nein, Kamellen koennen Dir normalerweise nichts mitteilen."
  );

  AddSmell( ({DEFAULT_SMELL,"luft"}),
    "Ein wuerziger Geruch liegt in der Luft."
  );

  AddSmell( ({"geruch"}) ,
    "Er scheint aus den Regalen hinter der Theke zu kommen."
  );

  AddSmell( ({"theke"}) ,
    "Die riecht frisch geputzt."
  );

  AddSmell( ({"regal","regale"}) ,
    "Es sind die Whiskyflaschen, die da in den Regalen stehen."
  );

  AddSmell( ({"whisky"}) ,
    "Er riecht so herrlich nach Whisky, dass Du Dir am liebsten sofort "
    "einen bestellen moechtest."
  );

  AddCmd( ({"schau","schaue"}) , "cmd_schauen" );
  AddCmd( ({"trink","trinke"}) , "cmd_trinken" );
  AddCmd( ({"menu"})           , "menue"   );

  AddDrink("Gurkensaft", ({"saft", "gurkensaft"}), 30, ({8,8}), 0, 5,
           ({"Walpurgis bringt Dir einen gruenen Gurkensaft.",
             "&& trinkt schnell und durstig einen Gurkensaft aus."}));

  AddDrink("Guinness", ({"guinness"}), 90, ({20,10}), 5, 1,
           ({"Walpurgis pumpt Dir ein herrliches Guinness.",
             "&& kriegt glaenzende Augen, als &! das Guinness trinkt."}));

  AddDrink("Glen Dronach", ({"glen","dronach","glendronach","glen dronach","whisky","scotch"}),
           150, ({30,16}), 10, 1,
           ({BS("Walpurgis giesst Dir einen 15jaehrigen Glen Dronach ein. "+
             "Langsam trinkst Du ihn und spuerst, wie er die Kehle hinunterrinnt."),
             "&& verdreht entzueckt die Augen, als &! einen Whisky trinkt."}));

  AddDrink("Feenzauber", ({"zauber", "fee", "feenzauber"}),
           170, ({10, 40}), 5, 4,
    ({BS("Walpurgis bringt Dir ein Glas mit seltsam aussehender Fluessigkeit. "
         "Schnell und gierig schluckst Du es und versinkst in magischen "
         "Traeumen. Kurz danach stellst Du fest, dass Du noch immer "
         "genauso durstig bist wie davor..."),
      BS("&& bekommt eine seltsam aussehende Fluessigkeit serviert, "
         "die &! mit einem schnellen kurzen Schluck austrinkt und "
         "magische Sprueche von sich gibt..") }) );

  AddDrink("Grotterblut", ({"blut","grotter", "grotterblut"}),
           500, 40, 0, 5,
    ({BS("Ein vorbeieilender Kellner reicht Dir einen Kelch mit Blut "
         "vom Grotter. Du trinkst und faengst zum Fluchen an. "
         "@$*+°!????~~%&/... Nachdem Dir die Flueche ausgehen, schaust "
         "Du in die Runde ... ...es herrscht Ratlosigkeit."),
      BS("&& trinkt Blut vom Grotter und beginnt zu Fluchen. "
         "Man glaubt gar nicht was es alles fuer Woerter gibt! "
         "Wie schrecklich!") }) );

  AddFood ("Pfauenei", ({"ei", "pfau", "pfauenei"}),
          130, 37, 14,
          ({"Du isst ein riesiges Pfauenei.",
            "&& isst ein riesiges Pfauenei."}) );

  AddExit ("westen", ROOM "sgang11.lpc");

  AddItem(NPC "walpurgis", REFRESH_DESTRUCT);
  AddItem(NPC "diener", REFRESH_DESTRUCT);
}

string detail_karte(string str)
{
  TP->command_me("menue");
  return "";
}

string plakat()
{

//            1         2         3         4         5         6         7         8
//   12345678901234567890123456789012345678901234567890123456789012345678901234567890
  return
    "Es ist ein altes, vergilbtes Plakat. Aber Du kannst noch gut sehen, dass es\n"
    "ein Zirkusplakat ist.\n\n\n"
    "                      C I R C U S     C A R L U C C I \n"
    "\n"
    "Kommen und staunen Sie!\n"
    "Sehen sie die Dame ohne Unterleib!\n"
    "Rocco der Feuerschlucker wird sie begeistern!\n"
    "Staunen Sie ueber Tiere aus entfernten Laendern!\n"
    "Extra fuer Sie : Harpyrien, Graugnome und Wilddruden, Monster der Dunkelheit!\n"
    "Swindel Frei mit seinem atemberaubenden Drahtseilakt ueber den Schlosshof!\n"
    "John Gleur, der Sie mit seinen Baellen und Keulen begeistern wird!\n"
    "Scha Lisch Aplin, der Clown, der auch sie zum Lachen bringen wird!\n"
    "Anol Dschwar Zenegger, der staerkste Mann der Welt!\n"
    "Merlin, der grosse Magier!\n"
    "\n\n\n"
    "Hmmmm, leider ist die Vorstellung schon vorbei....\n"
  ;
}

int cmd_schauen(string str)
{
  notify_fail("Was willst Du Dir anschauen?\n");

  if(!str || str =="") return 0;

  if(!(str == "dich an"           ||
       str == "dich doch mal an"  ||
       str == "dich mal an"       )) return 0;

  TELLPLAYER(BS("Du schaust an Dir herunter. Ein paar Pfund koenntest Du "
                "aber wirklich abnehmen!"));
  TELLOTHERS(TPN+" schaut sich kritisch an.\n");
  return 1;
}

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");

  if(!str || str == "") return 0;

  if(!(str == "whisky"        ||
       str == "einen whisky"  )) return 0;

  TELLPLAYER("Das haettest Du wohl gerne. Hier wird bestellt und "
             "bezahlt!\n");
  return 1;
}
