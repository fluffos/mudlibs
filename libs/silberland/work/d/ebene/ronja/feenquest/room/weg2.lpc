#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein schmaler Pfad");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem kleinen Pfad nahe des Silberwaldes. "
    "Der Fruehnebel hat Tau auf den Blaettern hinterlassen, der im Schatten "
    "einiger Baeume noch nicht verdunstet ist. Der Pfad wird von Bueschen "
    "gesaeumt und macht einen durchaus gepflegten Eindruck. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));

  AddDetail( ({"boden"}) ,
    "Der Pfad, auf welchem Du gerade gehst, fuehrt am Rande des Silberwaldes "
    "vorbei."
  );

  AddDetail( ({"tau","tautropfen","tropfen"}) ,
    "Der Tau des Fruehnebels haengt noch an einigen Farnen und Moosen."
  );

  AddDetail( ({"silberwald","silberwaldes","waldes","wald"}) ,
    "Du befindest Dich an seinem Rand."
  );

  AddDetail( ({"rand"}) ,
    "Du befindest Dich am Rand des Silberwaldes."
  );

  AddDetail( ({"schatten"}) ,
    "Einige Baeume werfen genug Schatten, so dass es fuer Farne und Moose "
    "kuehl genug ist. "
  );

  AddDetail( ({"himmel"}) ,
    "Ueber Dir ist strahlend blauer Himmel."
  );

  AddDetail( ({"pfad"}) ,
    "Du kommst auf dem Pfad leicht voran."
  );

  AddDetail( ({"fruehnebel","nebel"}) ,
    "Der Fruehnebel hat sich schon laengst verzogen, nur noch einzelne "
    "Tautropfen haengen an einigen Farnen und Moosen. "
  );

  AddDetail( ({"baum","baeume"}) ,
    "Nur vereinzelt stehen hier am Rand des Waldes Baeume. In ihrem "
    "Schatten wachsen Farne und Moose. "
  );

  AddDetail( ({"buesche","busch","bueschen"}) ,
    "Buesche, wie sie so am Rand des Waldes wachsen. Neben einem Busch "
    "faellt Dir ein Brennesselstrauch auf. "
  );

  AddSpecialDetail( ({"brennessel","brennesselstrauch","strauch"}) ,
    "detail_brennessel"
  );

  AddDetail( ({"blatt","blaetter","blaettern"}) ,
    "An den Baeumen und Bueschen befinden sich Blaetter. An einigen "
    "Blaettern glitzern Tautropfen in der Sonne. "
  );

  AddDetail( ({"eindruck"}) ,
    "Der Pfad ist gut erhalten und Du kommst leicht voran."
  );

  AddDetail( ({"moos","moose","farn","farne"}) ,
    "Moose und Farne brauchen eine feuchte und kuehle Umgebung. In dem "
    "Schatten einiger Baeume wachsen einige davon."
  );

  AddDetail( ({"sonne"}) ,
    "Die Sonne lacht Dich an."
  );

  AddDetail( ({"umgebung"}) , QueryProp(P_INT_LONG));

  AddDetail( ({"raupe","raupen"}) ,
    "Aus Raupen entwickeln sich einmal wunderschoene Schmetterlinge. Manche "
    "der Raupen brauchen dazu Pflanzen wie Brennesseln, die von einigen "
    "Leuten nicht gerne gesehen werden. Doch hier gibt es noch welche und "
    "bald werden sie sich verpuppen."
  );

  AddDetail( ({"leute","leuten"}) ,
    "Von den Leuten, die keine Brennesseln moegen, sind zum Glueck keine da."
  );

  AddDetail( ({"glueck"}) ,
    "Was fuer ein Glueck fuer die Brennesseln und was fuer ein Glueck fuer "
    "die Raupen."
  );

  AddDetail( ({"pflanzen","pflanze"}) ,
    "Baeume, Buesche, Moose, Farne, und vieles mehr."
  );

  AddDetail( ({"schmetterling","schmetterlinge"}) ,
    "Noch sind die Raupen nicht soweit. Fleissig vertilgen sie die "
    "Brennesseln, um sich bald verpuppen zu koennen. "
  );

  AddExit("norden", ROOM "weg3.lpc");
  AddExit("sueden", ROOM "weg1.lpc");
}

string detail_brennessel(string str)
{
  string s;

  TP->SetProp(P_KILLER, TO);
  SetProp(P_KILL_NAME, "Ein Brennesselstrauch");
  TP->do_damage(10);
  s = "Autsch! Das brennt aber unangenehm. Hast Du nicht mehr "
      "daran gedacht, woher der Name Brennessel kommt? Als Du Deine Hand "
      "zurueckziehst, faellt eine Raupe herab, die sofort wieder in Richtung "
      "Brennessel zu kriechen beginnt.";

  return BS(s);
}
