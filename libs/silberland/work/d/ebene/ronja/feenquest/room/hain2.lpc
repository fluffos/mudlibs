#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Vorgarten");
  SetProp(P_INT_LONG,
    "Grosszuegig erstreckt sich der Vorgarten des Schlosses vor Dir. Ein "
    "breiter Weg fuehrt direkt auf den Schlosseingang zu. Der Weg ist "
    "gesaeumt von einem herrlichen Rasen, in dem zahlreiche Blumenrabatten "
    "angelegt sind. Sie sind so bepflanzt, dass zu jeder Zeit Blumen bluehen "
    "und der Rasen mit bunten Tupfen uebersaeht scheint. Du weisst nicht, wo "
    "Du Dich wohler fuehlst, im Hain oder im Vorgarten. Alles ist so "
    "friedlich hier. Im Norden siehst Du eine hohe Hecke mit einem Durchgang, "
    "vor dem ein Schild steht."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));

  AddDetail( ({"zeit"}) ,
    "Du schaust auf den Sonnenstand und denkst: Schon so spaet?"
  );

  AddDetail( ({"sonnenstand"}) ,
    "Am Sonnenstand kannst Du die Zeit ablesen."
  );

  AddDetail( ({"sonne","himmel","sonnenlicht"}) ,
    "Die Sonne steht am Himmel und lacht Dich an."
  );

  AddDetail( ({"boden","weg"}) ,
    "Du stehst auf einem Weg, der direkt auf den Schlosseingang zulaeuft. "
    "Gesaeumt ist der Weg von einem Rasen, auf dem sich zahllose "
    "Blumenrabatten befinden."
  );

  AddDetail( ({"rasen"}) ,
    "Dichter Rasen, der aussieht, als ob er gerade eben erst gemaeht wurde."
  );

  AddDetail( ({"hecke"}) ,
    "Die Hecke ist zu hoch, um darueber zu klettern. Du koenntest aber den "
    "Durchgang benutzen."
  );

  AddDetail( ({"hain"}) ,
    "Der Hain liegt westlich von Dir."
  );

  AddDetail( ({"durchgang"}) ,
    "Hinter dem Durchgang scheint es, als wuerde sich die Hecke endlos "
    "fortsetzen."
  );

  AddDetail( ({"vorgarten","garten"}) ,
    "Er ist sehr grosszuegig angelegt mit seinem Rasen und den vielen "
    "Blumenrabatten."
  );

  AddDetail( ({"schloss","feenschloss","schlosses"}) ,
    "Des Feenschloss liegt friedlich im Osten. Einladend steht der Eingang "
    "offen, um jeden Wanderer und Abenteurer zu empfangen."
  );

  AddDetail( ({"schlosseingang","eingang"}) ,
    "Der Eingang steht offen. Anscheinend sind die Feen sehr gastfreundlich. "
    "Die Tore sind jedoch aus starken Eichenbohlen gefertigt, so dass das "
    "Schloss auch vor Angriffen sicher ist. Aber wer wuerde schon eine Fee "
    "angreifen?"
  );

  AddDetail( ({"angriff","angriffe"}) ,
    "Das Schloss ist vor Angriffen sicher."
  );

  AddDetail( ({"bohlen","eichenbohlen","eiche"}) ,
    "Die Bohlen des Tores sind aus starker Eiche gefertigt, damit sie im "
    "Fall des Falles ausreichend Widerstand gegen unerwuenschte Eindringlinge "
    "bieten."
  );

  AddDetail( ({"fee","feen"}) ,
    "Geh ruhig ins Schloss, dort wirst Du sicherlich Feen finden."
  );

  AddDetail( ({"widerstand","tor","tore"}) ,
    "Die Tore sind stabil, und Du bist sicher, dass sie allen unerwuenschten "
    "Eindringlingen trotzen."
  );

  AddDetail( ({"eindringlinge"}) ,
    "Die Feen sind sehr gastfreundlich, aber unerwuenschte Eindringlinge "
    "werfen sie auch wieder aus dem Schloss."
  );

  AddDetail( ({"wanderer","abenteurer"}) ,
    "Wanderer und Abenteurer sind immer willkommen. Ihren Geschichten "
    "lauscht man in der Taverne gerne."
  );

  AddDetail( ({"tupfen"}) ,
    "Wie bunte Tupfen sehen die Blumenrabatten auf dem Rasen aus."
  );

  AddDetail( ({"blumen"}) ,
    "Sie sind wunderschoen anzuschauen, doch leider kennst Du keine einzige "
    "davon."
  );

  AddDetail( ({"rabatte","blumenrabatte","rabatten","blumenrabatten"}) ,
    "Wie bunte Tupfen sind die Rabatten auf dem Rasen verteilt."
  );

  AddDetail( ({"taverne"}) ,
    "Die Taverne befindet sich im oestlichen Fluegel des Schlosses."
  );

  AddDetail( ({"fluegel"}) ,
    "Das Schloss hat einen westlichen, noerdlichen, oestlichen und suedlichen "
    "Fluegel."
  );


  AddDetail( ({"geschichten"}) ,
    "In der Taverne werden immer die neuesten Geschichten erzaehlt."
  );

  AddDetail( ({"schild"}) ,
    "Du kannst es lesen."
  );

  AddReadDetail( ({"schild"}) ,
    "\n .------------------------------------.\n"
      " |         A C H T U N G !!!          |\n"
      " |                                    |\n"
      " | Wanderer hab acht, schon viele     |\n"
      " | haben sich in unserem Labyrinth    |\n"
      " | verlaufen. Wenn Du hineingehst,    |\n"
      " | so wisse um die Gefahr, dass Du    |\n"
      " | vielleicht nicht wieder hinaus-    |\n"
      " | findest.                           |\n"
      " |                                    |\n"
      " |                     Kristina       |\n"
      " |                   Feenkoenigin     |\n"
      " '---------------.~~~~,---------------'\n"
      "                 |    |\n"
      "                 |    |\n\n"
  );

  AddSound( DEFAULT_SOUND,
    "Du kannst ein Jammern hoeren."
  );

  AddSound( ({"jammern","diener","oberdiener"}),
    "Der Oberdiener jammert leise vor sich hin."
  );

  AddSmell( DEFAULT_SMELL ,
    "Die Blumen riechen einfach herrlich."
  );

  AddSmell( ({"blumen"}) ,
    "Die Blumen riechen einfach herrlich."
  );

  AddCmd( CMD_LESEN, "cmd_lesen");

  AddExit("westen", ROOM "hain1.lpc");
  AddExit("osten",  ROOM "sgang03.lpc");
  AddExit("norden", LABY "lab43" );

  AddItem(NPC "obdiener.lpc", REFRESH_DESTRUCT);
}

int cmd_lesen(string str)
{
  string zeit,stunde;

  notify_fail("Was moechtest Du ablesen?\n");

  if(!str || str == "") return 0;

  if(!(str == "zeit"                     ||
       str == "zeit ab"                  ||
       str == "zeit von sonnenstand"     ||
       str == "zeit von sonnenstand ab"  )) return 0;

  zeit = "Irgendwie gibt es zur Zeit keine Zeit. Frag halt einen Magier, "
         "wieso es keine Zeit mehr gibt. ";

  switch(dtime(time())[19 .. 20])
  {
    case "22" :
    case "23" :
    case "00" :
    case "01" :
    case "02" :
    case "03" :
    case "04" :
    case "05" :
      zeit = "Komisch, Irgendwie hast Du das Gefuehl, als ob Nacht ist. "
             "Trotzdem kann man die Sonne sehen und die Zeit grob "
             "abschaetzen. Normalerweise ist es ja nachts dunkel. Hier "
             "scheint das nicht so zu sein. ";
      break;

    case "06" :
    case "07" :
      zeit = "Es ist frueh am Morgen. SEHR frueh am morgen. Wieso bist Du "
             "bloss um diese Zeit schon auf?";
      break;

    case "08" :
    case "09" :
    case "10" :
      zeit = "Es ist Morgens. Naja, vielleicht geht es auch schon auf "
             "Mittags zu. Jetzt wird es aber wirklich Zeit, ein paar "
             "Abenteuer zu bestehen. ";
      break;

    case "11" :
    case "12" :
    case "13" :
      zeit = "Mittagszeit. Zeit was zu Essen.";
      break;

    case "14" :
    case "15" :
    case "16" :
    case "17" :
      zeit = "Es ist Nachmittag. Zeit fuer eine kleine Siesta. Oder doch "
             "lieber jemand umhauen? Oder lieber ein Abenteuer bestehen?";
      break;

    case "18" :
    case "19" :
      zeit = "Huch schon, so spaet? Hoechste zeit fuer ein Abendessen, um "
             "gut gestaerkt das naechste Abenteuer anzugehen. ";
      break;

    case "20" :
    case "21" :
      zeit = "Frueh am Abend koennte man doch glatt mal das eine oder andere "
             "Monster zu Lars schicken. Auf in den Kampf!";
      break;
  }
//Menschen, Elfen, Zwerge, Hobbits, Trolle, Feen, Oger und Dunkelelfen

  switch (TP->QueryProp(P_RACE))
  {
    case "Fee" :
      zeit = "Du erfreustn Dich an jeder Zeit. Daher ist die aktuelle Zeit "
             "fuer Dich voellig unwichtig.";
      break;

    case "Troll" :
      zeit = "Ist es nun Vormittags? Oder Nachmittags? Haettest Du in der "
             "Trollschule doch nur besser aufgepasst. Ach was, unwichtig, "
             "jetzt ist Zeit jemanden umzuhauen.";
      break;

    case "Dunkelelf" :
      zeit = "Du schaust in die Sonne und wirst prompt geblendet. Du "
             "Schussel, hast Du das mit dem Licht und der Sonne vergessen?";
      break;

  }
  FMASTER->Msg(TPUID+" liest die Zeit vom Sonnenstand ab");

  TELLPLAYER(BS(zeit));
  TELLOTHERS(CTPN+" schaut in die Sonne.\n");
  if(TP->QueryProp(P_RACE)=="Dunkelelf")
  {
    TP->SetProp(P_BLIND,
      ([BLIND_TIME: 15,
        BLIND_MSG: "Deine Augen sind geblendet!\n",
        BLIND_END_MSG: "Deine Augen haben sich wieder erholt.\n"
       ])
    );
  }

  return 1;
}

