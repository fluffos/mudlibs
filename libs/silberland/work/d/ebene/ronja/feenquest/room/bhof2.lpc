#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  AddDetail( ({"brunnen"}) ,
    "Der Brunnen liegt im Sueden, Du musst schon naeher herangehen. "
  );

  AddExit( "osten",      ROOM "bhof3.lpc" );
  AddExit( "westen",     ROOM "bhof1.lpc" );
  AddExit( "sueden",     ROOM "bhof5.lpc" );
  AddExit( "suedosten",  ROOM "bhof6.lpc" );
  AddExit( "suedwesten", ROOM "bhof4.lpc" );

}

