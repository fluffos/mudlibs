  AddDetail( ({"gatter"}) ,
    "Das Gatter im Westen hindert die Pferde daran, aus der Koppel "
    "auszubrechen. Fuer Dich sollte es jedoch nicht schwer sein, "
    "einfach ueber das Gatter hinwegzuklettern. Das Gatter selbst "
    "besteht aus mehreren Pfaehlen, die durch Bretter miteinander "
    "verbunden sind. "
  );

  AddDetail( ({"pfahl","pfaehle","pfaehlen"}) ,
    "Das Gatter ist recht einfach gebaut, es sind lediglich ein paar "
    "Pfaehle in den Boden gerammt und mit langen Brettern verbunden. "
  );

  AddDetail( ({"brett","bretter"}) ,
    "Die Bretter sind einfach an die Pfaehle genagelt. Als Hindernis "
    "fuer die Pferde reicht es, um sie auf der Koppel zu halten, aber "
    "fuer Dich sollte es keine Schwierigkeit sein, ueber das Gatter zu "
    "klettern."
  );

  AddDetail( ({"hindernis"}) ,
    "Fuer die Pferde ist es ausreichend."
  );

  AddDetail( ({"schwierigkeit"}) ,
    "Also fuer Dich sollte es nun wirlich keine Schwierigkeit sein, "
    "ueber das Gatter zu klettern. "
  );


