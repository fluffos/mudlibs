#include "../def.h"

inherit "std/room";

int kraut;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein schmaler Pfad");
  SetProp(P_INT_LONG,
    "Hinter dem Schloss windet sich ein schmaler Pfad entlang. Er "
    "scheint zu einer eingezaeunten Wiese zu fuehren. Froehlich "
    "pfeifend schaust Du Dich ein wenig um. Am Wegesrand blueht eine "
    "Pflanze mit blauen Blueten. Eine Schnecke versucht, den Weg "
    "zu ueberqueren. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));

  AddDetail( ({"boden"}) ,
    "Du stehst auf einem Pfad, der sich vom Schloss zu einer Wiese "
    "windet. Direkt vor dir ueberquert eine kleine Schnecke den Weg. "
    "Am Rand des Pfades waechst ein wenig Gras. "
  );

  AddDetail( ({"himmel"}) ,
    "Am Himmel steht die Sonne und lacht Dich an."
  );

  AddSpecialDetail( ({"sonne"}) , "detail_sonne" );

  AddDetail( ({"schloss","feenschloss","schlosses","feenschlosses"
              ,"mauer","mauern","mauerwerk"}) ,
    "Das Feenschloss erhebt sich majaestetisch im Westen. Vor Dir "
    "steht der grosse Turm im Suedosten des Schlosses. Dein Blick "
    "schweift vom Turm ueber die Fassade des Schlosses bis zum "
    "Gruenengelturm. "
  );

  AddDetail( ({"gruenengelturm"}) ,
    "Der Gruenengelturm ist wohl der aelteste Teil des ganzen Schlosses. "
    "Maechtig erhebt er sich im Nordwesten und ueberragt die beiden anderen "
    "Tuerme um ein vielfaches. Ob sich um den Gruenengelturm ein "
    "besonderes Geheimnis rankt?"
  );

  AddDetail( ({"tuerme"}) ,
    "Das Feenschloss besitzt drei Tuerme. Noerdlich von Dir steht der "
    "Gruenengelturm, vor einem Turm stehst Du gerade, und den dritten "
    "Turm kannst Du von hier aus nicht sehen. "
  );

  AddDetail( ({"teil","teile"}) ,
    "Der Gruenengelturm ist ein Teil des Feenschlosses. Die Taverne "
    "ist ein anderer Teil. Und es gibt noch viel, viel mehr im Feenschloss. "
  );

  AddDetail( ({"geheimnis"}) ,
    "Von hier aus sieht der Turm maechtig und gewaltig aus. Etwas "
    "bedrohliches ist an ihm, aber auch gleichzeitig etwas beschuetzendes. "
  );

  AddDetail( ({"etwas"}) ,
    "Es ist nichts, was man fassen koennte, eher ein Gefuehl. "
  );

  AddDetail( ({"gefuehl","gefuehle"}) ,
    "Der Gruenengelturm loest mehrere Gefuehle in Dir aus. Da ist dieses "
    "bedrohliche Gefuehl, gleichzeitig strahlt der Turm aber auch Sicherheit "
    "aus. "
  );

  AddDetail( ({"blick"}) ,
    "Du laesst deinen Blick vom Gruenengelturm zum suedoestlichen Turm "
    "schweifen. Die ganze Fassade ist mit Efeu bedeckt, natuerlich bis auf "
    "die Fenster. Es muss Jahre gedauert haben, bis der Efeu die ganze "
    "Fassade hochgeklettert ist. "
  );

  AddDetail( ({"jahr","jahre","krimskrams","krims","krams"}) ,
    "Wenn Du auch solchen Krimskrams untersuchst, wird es noch Jahre "
    "dauern, bis Du hier fertig bist. "
  );

  AddDetail( ({"fenster"}) ,
    "Du siehst einige Fenster in der Fassade, von denen einige sicher "
    "zur Taverne gehoeren. "
  );

  AddDetail( ({"taverne"}) ,
    "Die Taverne befindet sich im Schloss. Von hier aus kannst Du sie "
    "nicht betreten. "
  );

  AddDetail( ({"efeu"}) ,
    "Der Efeu hat ueber die Jahre hinweg die ganze Fassade im Osten "
    "des Schlosses ueberwuchert und ist bis fast unters Dach geklettert. "
  );

  AddDetail( ({"dach"}) ,
    "Du schaust in die Hoehe um das Dach zu untersuchen. Doch von hier "
    "unten kannst Du kaum Einzelheiten entdecken. Es scheint so, als ob "
    "das Dach mit roten Ziegeln gedeckt wurde. Mehr kannst Du von hier "
    "aus nicht entdecken. "
  );

  AddDetail( ({"ziegel","ziegeln"}) ,
    "Das Dach ist mit roten Ziegeln gedeckt. Soviel steht schon mal "
    "fest. "
  );

  AddDetail( ({"einzelheit","einzelheiten"}) ,
    "Das Dach ist zu weit entfernt, als dass Du Einzelheiten von hier unten "
    "erkennen koenntest. "
  );

  AddDetail( ({"turm","turms","turmes"}) ,
    "Durch die Tuer am Fusse des Turms bist Du auf diesen Pfad gekommen. "
    "Du legst deinen Kopf in den Nacken, blickst nach oben und blinzelst "
    "etwas. Ist dort oben nicht eine Statue? "
  );

  AddDetail( ({"statue"}) ,
    "Ganz oben auf dem Turm steht etwas auf den Zinnen. Es sieht wie eine "
    "kleine Statue aus, aber es koennte natuerlich auch ganz etwas "
    "anderes sein. "
  );

  AddDetail( ({"zinnen","zinne","turmzinne","turmzinnen"}) ,
    "Jeder der Tuerme besitzt Turmzinnen. Dadurch ist man etwas geschuetzt, "
    "wenn man das Schloss von dort oben verteidigen muss. "
  );

  AddDetail( ({"fusse","fuss"}) ,
    "Am Fusse des Turmes befindet sich die Tuer, durch die Du diesen Pfad "
    "betreten hast. "
  );

  AddDetail( ({"fassade"}) ,
    "An der ganzen Fassade waechst Efeu in die Hoehe, nur die Fenster "
    "sind natuerlich frei, sonst kaeme ja auch kein Licht hinein. "
    "Die grossen Fenster in der Mitte gehoeren sicher zur Taverne. Du "
    "fragst Dich, wie der Efeu bloss so hoch klettern konnte."
  );

  AddDetail( ({"mitte","fassadenmitte"}) ,
    "Die grossen Fenster in der Fassadenmitte gehoeren sicherlich "
    "zur Taverne. "
  );

  AddDetail( ({"licht"}) ,
    ([0: "Nur wenn Licht durch Fenster faellt, wird es auch hell."
     ,"troll": "Nur wenn Licht durch ein Fenster faellt, wird es "
               "auch hell. Nur wenn Licht durch ein Fenster faellt, "
               "wird es auch hell. Nur wenn Licht durch ein "
               "Fenster faellt, wird es auch hell. Nur wenn "
               "Licht durch ein Fenster faellt, wird es auch hell. "
               "Hast Du das jetzt endlich kapiert? "
     ])
  );

  AddDetail( ({"hoehe"}) ,
    "Du legst den Kopf in den Nacken und blickst nach oben. Du siehst "
    "die Sonne am Himmel lachen. "
  );

  AddDetail( ({"fee","feen"}) ,
    "Die Feen wohnen im Schloss. Sicher bist Du schon einer begegnet. "
  );

  AddDetail( ({"pfad","weg","pfades"}) ,
    "Der Pfad fuehrt vom Schloss zu einer Wiese, die mit einem Gatter "
    "umzaeunt wurde. "
  );

  AddDetail( ({"gatter"}) ,
    "Das Gatter ist zu weit entfernt, als dass Du es von hier aus "
    "untersuchen koenntest. "
  );

  AddDetail( ({"wiese"}) ,
    "Von hier aus sieht es aus wie eine ganz normale Wiese. Du musst "
    "schon naeher herangehen um mehr erkennen zu koennen. "
  );

  AddDetail( ({"wegesrand","wegrand","rand"}) ,
    "Am Wegesrand waechst Gras, dazwischen kannst Du ein paar Kraeuter "
    "erkennen. "
  );

  AddDetail( ({"gras"}) ,
    "Saftig waechst am Wegesrand das Gras. Nur schade, dass Du Gras "
    "nicht magst, sonst wuerdest Du es glatt anknabbern. "
  );

  AddDetail( ({"pflanze"}) ,
    "Du untersuchst die Pflanze genauer und denkst Dir: \"Das ist aber "
    "ein komisches Kraut.\""
  );

  AddDetail( ({"kraut","feenkraut","kraeuter"}) ,
    "Ja, tatsaechlich, es ist Feenkraut ! Oder etwa doch nicht? Heisst es "
    "nicht, dass nur Feen Feenkraut finden koennen? "
  );

  AddDetail( ({"bluete","blueten"}) ,
    "Das Kraut besitzt einige dunkelblaue Blueten."
  );

  AddDetail( ({"schnecke"}) ,
    "Auf dem Weg vor dir kriecht langsam eine Schnecke ueber den Weg."
  );

  AddDetail( ({"kopf","nacken"}) ,
    "Jetzt ist keine Anatomiestunde."
  );

  AddDetail( ({"anatomiestunde"}) ,
    "Jetzt nicht. Vielleicht spaeter."
  );

  AddCmd( ({"pflueck","pfluecke"})      , "cmd_pfluecken");

  AddDetail( ({"angel","angeln"}) ,
    "Die Angeln sehen sehr stabil aus. Sie sind direkt auf die Tuer genietet "
    "und tief im Mauerwerk verankert. "
  );

  AddDetail( ({"nieten"}) ,
    "Dicke Nieten verbinden die Tuer mit den Angeln. Sie geben der Tuer "
    "zusaetzlich den Eindruck extremer Stabilitaet. "
  );

  AddDetail( ({"eindruck"}) ,
    "Diese Tuer sieht wirklich extrem stabil aus. "
  );

  AddDetail( ({"stabilitaet"}) ,
    "Es sieht nicht so aus, als ob man hier mit Gewalt in Schloss eindringen "
    "koennte. "
  );

  AddCmd( ({"dringe","dring"})        , "cmd_dringen");
  AddCmd( CMD_KLETTERN                , "cmd_klettern");
  AddCmd( ({"ramm","ramme"})          , "cmd_rammen");
  AddCmd( ({"schlag","schlage"})      , "cmd_schlagen");

  AddExit("nordosten", ROOM "weg5");

  NewDoor("westen", ROOM "sgang13" , ({"tuer","tor"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_SHORT, "Eine schwere Eisentuer."
     ,D_LONG,  "Eine schwere Eisentuer, welche sehr stabil aussieht. Die "
               "grossen Angeln halten die Tuer fest in den Mauern. Wenn "
               "die Tuer verschlossen wird, kann man hier sicherlich nicht "
               "in das Schloss eindringen. "
     ,D_NAME,  "Tuer"
     ,D_GENDER,FEMALE
     ,D_OPENTESTFUNC, "doortest"
     ,D_MSGS,    ({"durch die Tuer","geht durch die Tuer","kommt durch die Tuer"})
     ,D_OPENMSG, ({"Mit einem leisen Quietschen oeffnest Du die Tuer.",
                   "Mit einem leisen Quietschen oeffnet %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geoeffnet."})
     ,D_CLOSEMSG, ({"Mit einem leisen Quietschen schliesst Du die Tuer.",
                   "Mit einem leisen Quietschen schliesst %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geschlossen."})
     ,D_RESET_CLOSEMSG, " wird von einen kleinen Windstoss geschlossen."
     })
  );

  AddItem(NPC "schnecke" , REFRESH_DESTRUCT );

  kraut = 1;
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "sgang13",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "sgang13",TO);
}

void reset()
{
  ::reset();
  kraut = 1;
}

int doortest()
{
  TELLPLAYER(BS("Du versuchst die Tuer zu oeffnen, doch findest Du keine "
                "Klinke oder etwas aehnliches. Auch jeder Mechanismus "
                "zum Oeffnen der Tuer fehlt. "));
  return 1;
}

void niesen()
{
  TP->command_me("nies");
}

string detail_sonne(string str)
{
  string s;

  s = "Die Sonnenstrahlen kitzeln Dich in der Nase.";
  call_out("niesen",0,TP);
  return BS(s);
}

int cmd_klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf dach"          ||
       str == "aufs dach"         ||
       str == "efeu"              ||
       str == "rauf"              ||
       str == "an efeu auf dach"  ||
       str == "an efeu aufs dach" ||
       str == "hoch"              ||
       str == "efeu hoch"         )) return 0;

  TP->move(ROOM "dach",M_GO,"Efeu empor","am","kommt heraufgeklettert");
  return 1;
}

int cmd_dringen(string str)
{
  notify_fail("Wo moechtest Du eindringen?\n");

  if(!str || str == "") return 0;
  if(!(str == "ins Schloss ein"         ||
       str == "dringe mit Gewalt ins schloss ein"         )) return 0;

  TELLPLAYER("Nein, da ist bestimmt nichts zu machen.\n");
  TELLOTHERS(CTPN+" scheint ueber etwas nachzudenken.\n");
  return 1;
}

int cmd_pfluecken(string str)
{
  string s;
  object ob;

  notify_fail("Was moechtest Du pfluecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "kraut"         ||
       str == "feenkraut"     )) return 0;

  if(!kraut)
  {
    TELLPLAYER(BS("Du bueckst Dich um Dir ein Feenkraut zu pfluecken, siehst "
                  "aber, dass nur noch sehr wenige Pflanzen vorhanden sind. "
                  "\"Was, wenn das Feenkraut nun nicht mehr nach waechst?\" "
                  "denkst Du Dir und laesst die Pflanzen erstmal stehen "
                  "und wartest, bis sie sich wieder vermehrt haben."));
    TELLOTHERS(CTPN+" gruebelt ueber irgendetwas nach.\n");
    return 1;
  }

  s = "Du bueckst Dich, um Dir ein Feenkraut zu pfluecken. ";

  ob = clone_object(OBJ "feenkraut2");

  if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
  {
    s += "Du reisst eine der Pflanzen aus, aber nun wird Dir der "
         "ganze Krempel zu schwer, den Du so mit Dir schleppst und "
         "legst das Feenkraut erstmal ab.";

    ob->move(TO,M_NOCHECK);
  }
  else
  {
    s += "Du reisst eine der Pflanzen aus und steckst sie ein.";
  }

  kraut = 0;
  TELLPLAYER(BS(s));
  TELLOTHERS(CTPN+" bueckt sich und reisst eine Pflanze aus.\n");
  FMASTER->Msg(TPUID+" pflueckt ein giftiges Feenkraut");

  return 1;
}

int cmd_rammen(string str)
{
  string s;

  notify_fail("Was moechtest Du rammen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer"         ||
       str == "eisentuer"         )) return 0;

  if(DOOR_MASTER->QueryDoorStatus(ROOM "weg4",TO) == D_STATUS_OPEN)
  {
    TELLPLAYER(BS("Du nimmst etwas Anlauf und rammst die Tuer mit deiner "
                  "Schulter. Da die Tuer aber offen ist, fliegst Du in "
                  "hohem Bogen hinaus. Du siehst die Tuer noch etwas "
                  "hin und her pendeln, bevor sie ins Schloss faellt."));
    TELLOTHERS(BS(CTPN+" nimmt etwas Anlauf und rammt mit "
                  +TPPP(FEMALE,WESSEN)+" Schulter die Tuer. Da diese jedoch "
                  "auf ist, purzelt "+TPN+" in hohem Bogen hinaus. Die"
                  "Ture pendelt noch etwas hin und her und faellt dann "
                  "ins Schloss"));
    tell_room(ROOM "weg4",
      BS(CTPN+" kommt in hohem Bogen aus der Tuer hinausgepurzelt. Die Tuer "
         "schwingt noch etwas hin und her und faellt dann wieder ins Schloss. "),
      ({TP})
    );
    TP->move(ROOM "weg4",M_GO|M_SILENT);
    SetThisDoor(D_STATUS_CLOSED);
    FMASTER->Msg(TPUID+" rammt die offene Tuer von der Koppel aus");

    return 1;
  }

  TELLPLAYER("Du nimmst etwas Anlauf und rammst die Tuer mit Deiner "
             "Schulter.\n");
  TELLOTHERS(BS(CTPN+" nimmt etwas Anlauf und rammt die Tuer mit "
             +TPPP(FEMALE,WESSEN)+" Schulter."));

  FMASTER->Msg(TPUID+" rammt die geschlossene Tuer von der Koppel aus");

  SetProp(P_KILL_NAME,"Unueberlegtes Handeln");
  TP->do_damage(50);
  if(!TP->QueryProp(P_GHOST))
    TELLPLAYER("Du kannst allerdings nicht den kleinsten Schaden an der "
               "Tuer sehen.\n");

  return 1;
}

int cmd_schlagen(string str)
{
  int n;
  object weapon;
  string womit, was;

  notify_fail("Was moechtest Du womit einschlagen?\n");

  if(!str || str == "") return 0;

           n = sscanf(str, "mit %s auf %s ein", womit, was);
  if(n!=2) n = sscanf(str, "mit %s auf %s", womit, was);
  if(n!=2) return 0;

  if(!(was == "tuer"              ||
       was == "eisentuer"         )) return 0;

  if(!weapon=TP->QueryProp(P_WEAPON))
  {
    TELLPLAYER("Du hast doch gar keine Waffe gezueckt.\n");
    return -1;
  }

  if(!weapon->id(womit))
  {
    TELLPLAYER("So etwas benutzt Du doch gar nicht als Waffe.\n");
    return -1;
  }

  if(DOOR_MASTER->QueryDoorStatus(ROOM "weg4",TO) == D_STATUS_OPEN)
  {
    TELLPLAYER(BS("Du nimmst Deine Waffe fest in die Hand und holst "
                  "aus, um auf die Tuer einzuschlagen. Da schwingt die "
                  "Tuer etwas auf. Die Tuer war gar nicht geschlossen! "
                  "Was fuer ein Glueck fuer Deine Waffe. "));
    TELLOTHERS(BS(CTPN+" fuchtelt mit "+weapon->Name(WEM)+" wild in der "
                  "Gegend herum. "));

    FMASTER->Msg(TPUID+" will auf die geschlossene Tuer von der Koppel "
                 "einschlagen");

    return -1;
  }

  TELLPLAYER(BS("Du haust mit voller Wucht auf die Eisentuer ein. Droehnend "
                "schallt es durch das Schloss. Allerdings ist auf der Tuer "
                "nicht die kleinste Beschaedigung zu sehen. Ob das deiner "
                "Waffe wirklich so gut tut?"));

  TELLOTHERS(BS(CTPN+" haut mit "+weapon->name(WEM)+" auf die Tuer ein."));

  n = weapon->QueryProp(P_WC)/10*(TP->QueryAttribute(A_STR)/14+1)+random(10);

  FMASTER->Msg(TPUID+" haut mit "+weapon->name(WEM)+" ("+n+") auf die "
               "geschlossene Tuer von der Koppel ein");

  tell_room(ROOM "weg4", "Irgendetwas haemmert innen vom Turm gegen "
    "die Tuer.\n");

  weapon->Damage(n);

  return 1;
}

