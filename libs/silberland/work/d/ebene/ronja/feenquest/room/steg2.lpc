#include "../def.h"

inherit ROOM "steg0";

void create()
{
  slong    = "Im Osten kannst Du das Feenschloss erkennen.";
  sid      = "\nTICKET2";
  ziel     = ROOM "steg1.lpc";
  richtung = "nach Westen";

  ::create();

  AddDetail( ({"osten"}) , slong);

  AddDetail( ({"feenschloss","schloss"}) ,
    "Das Feenschloss liegt im Osten, Du musst schon naeher hingehen, "
    "wenn Du es erforschen willst. "
  );

  AddExit("osten" , ([EX_DEST : ROOM "hain1.lpc", EX_TESTFUNC : #'exit_test ]) );

  AddItem(OBJ "boot.lpc", REFRESH_DESTRUCT, 1);
}


