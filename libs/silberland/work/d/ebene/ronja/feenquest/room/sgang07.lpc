#include "../def.h"

inherit "std/room";

#define WEG 0
#define DA 1

int zylinder;
int schal;

int exit_test();

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Garderobe" );
  SetProp( P_INT_LONG,
    "Hier ist die Garderobe, wo Besucher ihre Kleider abgeben koennen, wenn "
    "im Festsaal ein Ball oder ein Festessen stattfindet. An der Suedwand "
    "befinden sich Haken, wo man seine Garderobe abgeben kann, im Norden "
    "geht es zum Festsaal."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"wand","waende","ausstrahlung"}) ,
    "An den Waenden haengt eine edle Tapete, die schon diesem Raum eine "
    "festliche Ausstrahlung gibt. "
  );

  AddSpecialDetail( ({"haken"}) , "detail_haken" );

  AddDetail( ({"suedwand"}) ,
    "An der Suedwand sind einige Haken angebracht, an welchem die Garderobe "
    "der Gaeste aufbewahrt wird."
  );

  AddDetail( ({"garderobe"}) ,
    "In dieser Garderobe werden die Kleidungsstuecke der Gaeste waehrend "
    "eines Balles oder Festessens aufbewahrt."
  );

  AddDetail( ({"festsaal"}) ,
    "Der Festsaal befindet sich im Norden."
  );

  AddDetail( ({"decke"}) ,
    "An der Decke befinden sich feine Stuckarbeiten."
  );

  AddDetail( ({"boden"}) ,
    "Auf dem Boden liegt ein edler, roter Teppich."
  );

  AddDetail( ({"besucher"}) ,
    "Momentan findet kein Ball statt, also gibt es auch keine eingeladenen "
    "Besucher."
  );

  AddDetail( ({"teppich"}) ,
    "Ein schwerer roter Teppich, wie er nur von den Tuaregs in der Wueste "
    "geknuepft werden kann."
  );

  AddDetail( ({"tapete"}) ,
    "Eine Tapete aus feinstem Papier. Du bemerkst ein leichtes Glitzern."
  );

  AddDetail( ({"glitzern"}) ,
    "In die Tapete sind ganz feine Goldfaeden eingearbeitet."
  );

  AddDetail( ({"goldfaeden"}) ,
    "Durch die Goldfaeden glitzert die Tapete im Licht wunderschoen."
  );

  AddDetail( ({"licht"}) ,
    "Ohne Licht waers hier dunkel."
  );

  AddDetail( ({"stuck","stuckarbeiten"}) ,
    "Wunderschoene Stuckarbeiten verzieren die Decke."
  );

  AddDetail( ({"raum"}) ,
    QueryProp(P_INT_LONG)
  );

  AddSpecialDetail( ({"kleidungsstuecke","kleidung","kleider"}) ,  "detail_kleidung");

  AddDetail( ({"gaeste"}) ,
    "Momentan findet kein Fest und auch kein Ball statt, also gibt es "
    "auch keine erlauchten Gaeste."
  );

  AddDetail( ({"feste","fest","ball","festessen","vollmond"}) ,
    "Jeden Monat nach Vollmond findet ein rauschendes Fest im Feenschloss "
    "statt."
  );

  AddDetail( ({"wueste"}) ,
    "Du bist im Feenschloss, nicht in der Wueste. Wenn Du also die Wueste "
    "untersuchen willst, begib Dich dorthin."
  );

  AddDetail( ({"tuareg","tuaregs"}) ,
    "Es ist keiner da."
  );

  AddDetail( ({"papier","qualitaet"}) ,
    "Das Papier ist von hervorragender Qualitaet."
  );

  AddDetail( ({"monat","jahr"}) ,
    "Das Jahr ist in 12 Monate unterteilt."
  );

  AddDetail( ({"schloss","feenschloss"}) ,
    "Du befindest Dich mittendrin."
  );

  AddCmd( ({"nimm","nehm","nehme"}), "cmd_nehmen");

  AddSpecialDetail( ({"zylinder"}) , "detail_zylinder" );
  AddSpecialDetail( ({"schal"}) ,    "deetail_schal" );

  AddExit("norden"  , ROOM "festsaal");
  AddExit("westen"  , ROOM "sgang06");
  AddExit("osten"   , ROOM "sgang08");

  AddItem(NPC "diener.lpc", REFRESH_DESTRUCT);

  zylinder = DA;
  schal    = DA;
}

void reset()
{
  ::reset();

  zylinder = DA;
  schal    = DA;
}

string detail_haken(string str)
{
  string s;

  s = "An den Haken haengt nichts.";

  if((zylinder == DA) && (schal == DA))
  {
    s = "An einem der Haken haengen ein Zylinder und ein Schal, die wohl "
        "jemand vergessen hat.";
  }
  else if((zylinder == DA) && (schal == WEG))
  {
    s = "An einem der Haken haengt ein Zylinder, den wohl jemand vergessen "
        "hat.";
  }
  else if((zylinder == WEG) && (schal == WEG))
  {
    s = "An einem Haken haengt ein Seidenschal, den wohl jemand vergessen "
        "hat.";
  }

  return BS(s);
}

string detail_kleidung(string str)
{
  if((zylinder == DA) || (schal = DA))
  {
    return BS("An den Haken siehst Du ein paar Kleidungsstuecke, die "
              "wohl jemand vergessen hat.");
  }

  return "Sowas siehst Du hier nicht.\n";
}

string detail_zylinder(string str)
{
  if(zylinder == DA)
  {
    return BS("Ein schwarzer Zylinder haengt einsam und verlassen an "
              "einem der Haken.");
  }

  return "Sowas siehst Du da nicht!\n";
}

string detail_schal(string str)
{
  if(schal == DA)
  {
    return BS("Ein weisser Schal haengt einsam und verlassen an "
              "einem der Haken.");
  }

  return "Sowas siehst Du da nicht!\n";
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;

  if(str == "schal"           ||
     str == "schal von haken" ||
     str == "schal vom haken"  )
  {
    notify_fail("Sowas siehst Du hier nicht!\n");

    if(schal == WEG) return 0;

    ob=clone_object(ARMOUR "schal");

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      TELLPLAYER("Du kannst den Schal nicht mehr tragen.\n");
      ob->remove();
    }
    else
    {
      TELLPLAYER("Du nimmst den Schal vom Haken.\n");
      TELLOTHERS(TPN+" nimmt einen Schal vom Haken.\n");
      schal = WEG;
      FMASTER->Msg(TPUID+" nimmt den Schal");
    }
    return 1;
  }

  if(str == "zylinder"||
     str == "zylinder von haken"||
     str == "zylinder vom haken" )
  {
    notify_fail("Sowas siehst Du hier nicht!\n");

    if(zylinder == WEG) return 0;

    ob = clone_object(ARMOUR "zylinder");

    if(ME_TOO_HEAVY == ob->move(TP,M_GET))
    {
      TELLPLAYER("Du kannst den Zylinder nicht mehr tragen.\n");
      ob->remove();
    }
    else
    {
      TELLPLAYER("Du nimmst den Zylinder vom Haken.\n");
      TELLOTHERS(TPN+" nimmt einen Zylinder vom Haken.\n");
      zylinder = WEG;
      FMASTER->Msg(TPUID+" nimmt den Zylinder");
    }
    return 1;
  }

  return 0;
}


