#include "../def.h"

inherit "/std/room";

string tafel();

void create()
{
  ::create();

  SetProp (P_INT_SHORT,"Betraum");
  SetProp (P_INT_LONG,
    "Du befindest Dich hier im Betraum der Feen, die hier ihre natuerliche "
    "Gestalt durch Beten wiedererlangen koennen. Ein kleiner Altar aus "
    "Blumen befindet sich in der Mitte des Raumes. An der noerdlichen "
    "Wand haengt eine Heldinnentafel. Im Sueden faellt durch ein buntes "
    "Fenster Licht in den Raum."
  );

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail (({"raum", "betraum"}),
    "Du stehst mittendrin."
  );

  AddDetail( ({"waende","wand"}),
    "An der noerdlichen Wand haengt eine Tafel, an der suedlichen Wand "
    "faellt durch ein Fenster Licht in den Raum."
  );

  AddDetail( ({"ausgang"}) ,
    "Der Ausgang fuehrt nach Osten."
  );

  AddDetail( ({"osten"}) ,
    "Im Osten befindet sich der Ausgang."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus Marmor."
  );

  AddDetail( ({"marmor"}),
    "Der Marmor glaenzt im Licht, der durch das Fenster faellt. "
    "Ein Blumenaltar steht in der Mitte des Raumes am Boden."
  );

  AddDetail( ({"mitte"}) ,
    "In der Mitte des Raumes steht ein Blumenaltar."
  );

  AddDetail( ({"decke"}),
    "Die Decke besteht aus Marmor."
  );

  AddDetail( ({"fenster"}) ,
    "Durch die bunten Fenster faellt Licht in den Raum."
  );

  AddDetail( ({"licht"}) ,
    "Das Licht taucht den Raum in ein angenehmes Licht."
  );

  AddDetail( ({"altar", "blumenaltar"}),
    "Vor dem Altar, der vollkommen aus Blumen besteht, kann man "
    "beten und seine fleischliche Gestalt wiedererlangen."
  );

  AddSpecialDetail( ({"gestalt"}) , "detail_gestalt" );

  AddDetail( ({"blume","blumen","pracht","blueten","bluete"}),
    "Unzaehlige verschiedene Blumen bilden den Altar. Die Pracht "
    "der Blueten blendet Deine Sinne."
  );

  AddDetail( ({"sinne"}) ,
    "Hoffentlich hast Du Deine sieben Sinne beieinander."
  );

  AddDetail( ({"tafel","heldinnentafel"}) ,
    "Du kannst sie lesen."
  );

  AddReadDetail( ({"heldentafel","heldinnentafel", "tafel"}), #'tafel);

  AddSmell(DEFAULT_SMELL,
    "Die Blumen auf dem Altar riechen herrlich."
  );

  AddSmell( ({"blumen"}),
    "Die Blumen riechen einfach herrlich."
  );

  AddCmd( ({"bete","bet"}), "cmd_beten");

  AddExit("osten",  ROOM "sgang15");
}

int cmd_beten(string str)
{
  string sp, so;

  sp = "Du kniest nieder und haeltst eine kurze Andacht. ";

  if (TP->QueryProp(P_GHOST))
  {
    sp += "Der Raum erstrahlt hell in einem magischen Licht und die "
          "Feenmagie durchstroemt dich. Du spuerst wie das Leben wieder "
          "in Deinen Koerper zurueckkehrt.";

    so  = "Der Geist von "+TPN+" kniet nieder und haelt eine kurze Andacht. "
          "Der Raum ersrahlt in einem hellen Licht und "+TP->QueryPronoun()+
          " erscheint ploetzlich wieder in koerperlicher Form.";

    TP->SetProp(P_GHOST,0);
    if(TP->QueryProp(P_RACE) == "Fee") FMASTER->DeleteEnemy(TP);
  }
  else
  {
    so = CTPN+" kniet nieder und haelt eine kurze Andacht.";
  }

  TELLPLAYER(BS(sp));
  TELLOTHERS(BS(so));

  return 1;
}

string tafel()
{
  TP->more("/etc/topfeen.read",1);
  return "";
}

string detail_gestalt(string str)
{
  string s;

  if(TP->QueryProp(P_GHOST))
  {
    return "Hoppla, Du bist ein Geist!\n";
  }

  if(TP->QueryProp(P_FROG))
  {
    return "Hoppla, Du bist ein Frosch!\n";
  }

  return "Du besitzt Deine normale Gestalt.\n";
}
