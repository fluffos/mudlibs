#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kurzer Gang" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem kurzen Gang, der Dich weiter nach Sueden "
    "fuehrt. Der Glanz des Schlosses ist hier nicht mehr vorhanden, viel "
    "mehr befindet sich am Ende des Ganges eine Kammer. Durch ein Fenster "
    "faellt ausreichend Licht. "
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende sind hier nur weiss getuencht. Das ist aber auch kein Wunder, "
    "denn dies ist nur ein Gang, der zu einer Kammer fuehrt."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus einfachen Steinfliesen. Auf dem Boden zeichnet "
    "sich das Fenster ab, welches den Gang erhellt."
  );

  AddDetail( ({"schloss","schlosses"}) ,
    "Du befindest Dich in ihm. Genauer gesagt: in einem kleinen Gang."
  );

  AddDetail( ({"licht"}) ,
    "Durch das Fenster faellt ausreichend Licht. Auf dem Boden zeichnet sich "
    "das Fenster ab."
  );

  AddDetail( ({"kammer"}) ,
    "Die Kammer befindet sich im Sueden."
  );

  AddDetail( ({"glanz"}) ,
    "Pompoes ist es hier nicht, aber doch sehr ordentlich und sauber."
  );

  AddDetail( ({"gang"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"fenster"}) ,
    "Das Fenster befindet sich weit oben, so dass Du es nicht erreichen "
    "kannst."
  );

  AddDetail( ({"ende"}) ,
    "Alles hat ein Ende, nur die Wurst hat zwei."
  );

  AddDetail( ({"decke"}) ,
    "Die Decke ist weiss getuencht."
  );

  AddDetail( ({"wurst"}) ,
    "Hier liegt bestimmt keine herum, denn die Diener sind sehr ordentlich "
    "und reinlich. Aber vielleicht bekommst Du ja in der Taverne eine?"
  );

  AddDetail( ({"wunder"}) ,
    "Es waere ein Wunder, wenn man einen einfachen Gang zu einer Kammer mit "
    "genauso viel Glanz ausgestattet haette wie das uebrige Schloss."
  );

  AddDetail( ({"steinfliesen","fliesen"}) ,
    "Einfache, rechteckige Steinfliesen bilden den Boden."
  );

  AddDetail( ({"diener"}) ,
    "Die Diener sind dafuer verantwortlich, dass das Schloss stets piko "
    "bello sauber und in Ordnung ist."
  );

  AddDetail( ({"taverne"}) ,
    "Die Taverne befindet sich im Ostfluegel des Schlosses."
  );

  AddDetail( ({"ostfluegel"}) ,
    "Der Ostfluegel befindet sich auf der gegenueberliegenden Seite des "
    "Westfluegels."
  );

  AddDetail( ({"westfluegel","westfluegels"}) ,
    "Du befindest Dich gerade im Westfluegel."
  );

  AddDetail( ({"seite"}) ,
    "Der Westfluegel befindet sich auf dieser Seite des Schlosses, der "
    "Ostfluegel auf der anderen."
  );

  AddDetail( ({"ordnung"}) ,
    "Ordnung muss sein!"
  );

  AddExit("norden", ROOM "sgang03" );
  AddExit("sueden", ROOM "sgang01" );

}

