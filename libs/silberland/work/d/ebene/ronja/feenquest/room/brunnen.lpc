#include "../def.h"

inherit "std/room";

#define HEILUNG 25

int heilung;
mapping springer;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Brunnen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem alten Brunnen. Jetzt wird Dir "
    "auch klar, wieso der Brunnen abgesperrt war - er fuehrt "
    "kein Wasser mehr. Weit oben erkennst Du das Absperrgitter, "
    "dass die Diener anscheinend schon wieder repariert haben. Durch das "
    "Gitter kommt gerade genug Licht herein, dass Du leidlich sehen kannst."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"brunnen"}) ,
    "Du bist im Brunnen."
  );

  AddDetail( ({"absperrgitter","gitter","decke"}) ,
    "Das Gitter, welches den Brunnen absperrt, ist sehr weit ueber dir."
  );

  AddDetail( ({"diener"}) ,
    "Die Diener haben das Absperrgitter schon wieder repariert. "
    "Komischerweise sind sie nicht auf die Idee gekommen, nachzuschauen, "
    "ob jemand in den Brunnen gefallen ist. Oder haben sie sich schlicht "
    "nicht getraut ? Vielleicht rufst Du einfach mal um Hilfe ?"
  );

  AddDetail( ({"idee"}) ,
    "Die ist wirklich noetig, um hier wieder herauszukommen."
  );

  AddDetail( ({"licht"}) ,
    "Durch das Absperrgitter weit oben faellt gerade genug Licht, dass Du "
    "sehen kannst."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht nur noch aus Morast. Hier kann wirklich kein "
    "Trinkwasser mehr gewonnen werden. Bis zu den Knoecheln steht Du darin."
  );

  AddDetail( ({"knoechel","knoecheln"}) ,
    "Bis zu den Knoecheln stehst Du im Morast."
  );

  AddDetail( ({"morast","bewegung"}) ,
    "Die Zusammensetzung des Morastes schaut merkwuerdig aus. Du moechtest "
    "besser gar nicht wissen, was da alles drin ist."
  );

  AddDetail( ({"zusammensetzung"}) ,
    "Du greifst in den stinkigen Morast und findest einige Ueberbleibsel "
    "vom Vortag (Igitt!), Lehm und Matsch."
  );

  AddSpecialDetail( ({"ueberbleibsel","faekalien"}) , "wuergen");

  AddDetail( ({"lehm"}) ,
    "Lehm ist eine Mischung aus Wasser und Erde."
  );

  AddDetail( ({"erde"}) ,
    "Mit Wasser vermischt erhaelt man Lehm."
  );

  AddDetail( ({"matsch"}) ,
    "In dem Matsch siehst Du etwas glitzern."
  );

  AddSpecialDetail( ({"etwas","glitzern"}), "glitzern");

  AddDetail( ({"verdauungsendprodukte"}) ,
    "Auch Faekalien genannt."
  );

  AddDetail( ({"geraeusche"}) ,
    "Du kannst sie hoeren."
  );

  AddDetail( ({"waende","wand"}) ,
    "Die Waende bestehen aus dunklen Steinen, die keinen Halt zum "
    "raufklettern bieten."
  );

  AddDetail( ({"halt"}) ,
    "Du untersuchst die Waende nochmal genauer, aber Du findest immer "
    "noch keinen Halt, um nach oben zu klettern."
  );

  AddDetail( ({"steine","steinen","stein"}) ,
    "Die Steine sind schwarz und kalt. Die Fugen bieten keinerlei "
    "Moeglichkeiten, sich darin festzukrallen und nach oben zu klettern."
  );

  AddDetail( ({"fugen","fuge"}) ,
    "Sorgfaeltig untersuchst Du die Fugen. Trotz der Feuchtigkeit ist der "
    "Moertel noch ganz intakt."
  );

  AddDetail( ({"feuchtigkeit"}) ,
    "Ein wenig Wasser sucht sich seinen Weg die Waende herab."
  );

  AddDetail( ({"moeglichkeit","moeglichkeiten"}) ,
    "Du schaust Dir die Waende ganz genau an und suchst nach einer "
    "Moeglichkeit, aus dem Brunnen wieder herauszukommen. Leider hast Du "
    "keine Idee, wie Du das schaffen koenntest, denn Du siehst nichts, "
    "woran Du Dich beim klettern festhalten koenntest."
  );

  AddDetail( ({"fleck"}) ,
    "Koennte das ein Loch sein ?"
  );

  AddDetail( ({"loch"}) ,
    "Du bist Dir nicht sicher ob sich da oben wirklich ein Loch in der "
    "Wand befindet. Vielleicht siehst Du mehr, wenn Du mal hochspringst."
  );

  AddDetail( ({"wasser","trinkwasser"}) ,
    "Klares Wasser, welches von Irgendwoher die Waende herunterlaeuft."
  );

  AddDetail( ({"moertel"}) ,
    "Du kratzt ein wenig am Moertel herum, aber ausser dass Du Dir Deine "
    "Fingernaegel abbrichst, passiert nichts."
  );

  AddDetail( ({"fingernaegel"}) ,
    "Die gehoeren mal geputzt !"
  );

  AddDetail( ({"irgendwoher","weg"}) ,
    "Du verfolgst den Weg des Wassers und siehst weiter oben einen dunklen "
    "Fleck, wo das Wasser anscheinend herauslaeuft."
  );

  AddDetail( ({"hilfe"}) ,
    "Du koenntest um Hilfe rufen."
  );

  AddSound( ({DEFAULT_SOUND,"geraeusche"}) ,
    "Wenn Du Dich bewegst, gibt der Morast schmatzende Geraeusche von sich."
  );

  AddSmell( ({DEFAULT_SMELL}) , "Hier riecht es aber nicht sehr angenehm." );

  AddCmd( CMD_TRINKEN                             , "cmd_trinken");
  AddCmd( CMD_SPRINGEN + ({"huepf","huepfe"})     , "cmd_springen");
  AddCmd( ({"ruf","rufe"})                        , "cmd_rufen");
  AddCmd( CMD_KLETTERN                            , "cmd_klettern");

  heilung = HEILUNG;
  springer = ([]);
}

void reset()
{
  ::reset();
  heilung = HEILUNG;
  springer = ([]);
}

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser"   ||
       str =="von wasser")) return 0;

  TELLPLAYER(BS("Du leckst an den Steinen und trinkst etwas Wasser. "
                "Erstaunlicherweise schmeckt es sehr gut und Du fuehlst "
                "Dich frisch und gestaerkt."
  ));
  TELLOTHERS(TPN+" leckt an den Waenden.\n");

  if(heilung)
  {
    TP->AddHp(heilung);
    TP->AddSp(heilung);
    heilung = 0;
  }

  FMASTER->Msg(TPUID+" trinkt vom Brunnenwasser");
  return 1;
}

int cmd_springen(string str)
{
  int dex;
  string uid;

  if(!TP->do_exhaust(200,0)) return 1;

  dex = TP->QueryAttribute(A_DEX);
  dex = dex + random(101-dex);

  uid = getuid(TP);
  springer[uid] = springer[uid]+1;
  if(springer[uid] > 5) dex = 100;

  switch(dex)
  {
    case  0..50:
      TELLPLAYER(BS("Du springst hoch, aber aus dem Morast ist das "
                    "natuerlich sehr schwierig. Du schaffst es noch "
                    "nichtmal einen Meter hoch und plumpst wieder in den "
                    "Morast zurueck, ohne herausgefunden zu haben, was sich "
                    "hinter dem Loch verbirgt."
      ));
      TELLOTHERS(TPN+" springt im Brunnen herum und bespritzt Dich mit "
                 "Morast.\n");
      FMASTER->Msg(TPUID+" springt im Brunnen vergeblich herum");
      break;

    case 51..85:
      TELLPLAYER(BS("Trotzdem Deine Fuesse im Morast feststecken springst "
                    "Du hoch und schaffst es gerade so, Dich mit den "
                    "Haenden am Rand des Loches festzuhalten. Doch die "
                    "Steine sind zu glitschig, Du rutscht ab und landest "
                    "wieder im Morast."
      ));
      TELLOTHERS(TPN+" springt im Brunnen herum und bespritzt Dich mit "
                 "Morast.\n");
      FMASTER->Msg(TPUID+" schafft es fast aus dem Brunnen herauszuspringen");
      break;

    default    :
      TELLPLAYER(BS("Trotzdem Deine Fuesse im Morast feststecken springst Du "
                    "hoch und schaffst es gerade so, Dich mit den Haenden am "
                    "Rand des Loches festzuhalten. Muehsam und darauf "
                    "bedacht, nicht wieder abzurutschen ziehst Du Dich in "
                    "das Loch hinein."
      ));
      FMASTER->Msg(TPUID+" springt aus dem Brunnen heraus");
      TP->move(ROOM "verlies4.lpc", M_GO,
               "in der Dunkelheit", "verschwindet", "kommt hereingeklettert");
      break;
  }

  return 1;
}

int cmd_rufen(string str)
{
  notify_fail("Was willst Du rufen?\n");

  if(!str || str == "") return 0;
  if(!(str == "hilfe"    ||
       str == "um hilfe" )) return 0;

  TELLPLAYER("Du rufst: H I L F E !!!!\n");
  shout(TPN+" ruft: H I L F E !!!!\n");
  FMASTER->Msg(TPUID+" ruft um Hilfe");
  return 1;
}

string wuergen()
{
  TELLPLAYER(BS("Verdauungsendprodukte. Igitt!"));
  TP->command_me("wuerg");
  FMASTER->Msg(TPUID+" kotzt fast im Brunnen");
  return "";
}

string glitzern()
{
  object nadel;
  object hut;

  if(!present("\nFEENQUESTOBJ",TP))
  {
    return "War wohl nur eine Taeuschung.\n";
  }

  if(present("\nHUTNADEL",TP))
  {
    return "War wohl nur eine Taeuschung.\n";
  }

  if(hut=present("\nFEENHUT",TP))
  {
    if(hut->QueryProp(P_HUTZUSTAND))
    {
      return "War wohl nur eine Taeuschung.\n";
    }
  }

  TELLPLAYER("Du fischst etwas laengliches, goldfarbenes aus dem Morast.\n");
  TELLOTHERS(TPN+" wuehlt im Morast herum.\n");

  nadel=clone_object(OBJ "hutnadel.lpc");

  if(ME_TOO_HEAVY==nadel->move(TP,M_GET|M_SILENT))
  {
    TELLPLAYER("Leider kannst Du den Gegenstand nicht mehr tragen.\n");
    nadel->remove();
  }

  FMASTER->Msg(TPUID+" findet die Hutnadel");
  return "";
}

int cmd_klettern(string str)
{
  notify_fail("Willst Du nach oben klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "nach oben"      ||
       str == "waende hinauf"  ||
       str == "waende rauf"    ||
       str == "wand hinauf"    ||
       str == "wand rauf"      )) return 0;

  TELLPLAYER("Du findest keinen Halt, um die Waende hinaufzuklettern.\n");
  FMASTER->Msg(TPUID+" versucht aus dem Brunnen zu klettern");
  return 1;
}
