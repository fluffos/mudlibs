#include "../def.h"

inherit "/std/room";

#define WEG 0
#define DA 0

int fackel;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Turm" );

  SetProp( P_INT_LONG,
    "Du befindest Dich in einem Wachturm des Feenschlosses. Eng windet "
    "sich die Wendeltreppe nach oben und unten. Du fragst Dich, wann die "
    "Treppe endlich ein Ende hat."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"wendeltreppe","treppe","treppenaufgang"}) ,
    "Endlos windet sich die Wendeltreppe nach oben und unten."
  );

  AddDetail( ({"ende"}) ,
    "Scheinbar endlos ist diese Treppe."
  );

  AddDetail( ({"wachturm","turm","schloss","feenschloss","feenschlosses"}) ,
    "Du befindest Dich in ihm."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus ausgelaufenen Stufen. Wegen der Aussicht wird "
    "die Treppe wohl haeufig benutzt."
  );

  AddDetail( ({"decke"}) ,
    "Steine. Nichts als Steine."
  );

  AddDetail( ({"stein","steine"}) ,
    "Sie wurden von weit her aus dem Gebirge herangeschafft."
  );

  AddDetail( ({"gebirge"}) ,
    "Das kannst Du von hier aus nicht sehen."
  );

  AddDetail( ({"stufen"}) ,
    "Sie sind stark abgelaufen, sei also vorsichtig, dass Du die Treppe "
    "nicht hinunterfaellst. "
  );

  AddDetail( ({"aussicht","ausblick"}) ,
    "Geh nach oben auf den Turm und schau sie Dir an."
  );

  AddDetail( ({"russ"}) ,
    "Schwarz und fettig bedeckt er die Wand."
  );

  AddSpecialDetail( ({"wand","waende"}) , "detail_wand");
  AddSpecialDetail( ({"halterung"}),      "detail_halterung");
  AddSpecialDetail( ({"fackel"}) ,        "detail_fackel" );

  AddCmd( ({"nimm","nehm","nehme"}) , "cmd_nehmen" );

  fackel = DA;
}

void reset()
{
  ::reset();

  if(fackel == WEG)
  {
    tell_room(TO, BS("Ein Diener kommt herein, steckt eine Fackel in die "
                     "Halterung und entzuendet sie. Danach verschwindet "
                     "er wieder"));
  }

  fackel = DA;
  SetProp(P_LIGHT, 1);
}

int cmd_nehmen(string str)
{
  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "fackel"                   ||
       str == "fackel aus halterung"     ||
       str == "fackel aus der halterung" )) return 0;

  if(fackel == WEG) return 0;

  TELLPLAYER(BS("Du nimmst die Fackel aus der Halterung, doch verbrennst "
                "Du Dich dabei. Polternd faellt die Fackel nach unten und "
                "erlischt."));

  TELLOTHERS(BS(CTPN+" versucht die Fackel zu nehmen und laesst sie "
                "fallen, wobei sie verlischt. So ein Tolpatsch."));

  FMASTER->Msg(TPUID+" nimmt eine Fackel aus der Halterung");
  fackel == WEG;
  SetProp(P_LIGHT, 0);

  return 1;
}

string detail_wand(string str)
{
  if(fackel == DA)
  {
    return BS("Die Waende bestehen aus Stein. Eine Fackel steckt in einer "
              "Halterung und erhellt den Treppenaufgang. Rund um die "
              "Fackel ist die Wand russgeschwaerzt.");
  }

  return BS("Die Waende bestehen aus Stein. Die Halterung fuer die Fackel "
            "ist leer. Rund um die Halterung ist die Wand "
            "russgeschwaerzt.");
}

string detail_halterung(string str)
{
  if(fackel == DA)
  {
    return "Eine Fackel steckt in der Halterung.\n";
  }

  return "Die Halterung ist leer.\n";
}

string detail_fackel(string str)
{
  if(fackel == DA)
  {
    return "Sie erhellt den Treppenaufgang, so dass Du etwas sehen kannst.\n";
  }

  return "Sowas siehst Du da nicht!\n";
}
