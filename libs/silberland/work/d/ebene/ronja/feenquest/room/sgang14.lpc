#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Bibliothek" );
  SetProp(P_INT_LONG,
    "Die Bibliothek des Feenschlosses. An saemtlichen Waenden des Raumes "
    "stehen Regale bis unter die Decke, und alle Regale sind mit Buechern "
    "vollgestopft. Wie die Feen hier bloss finden, wonach sie suchen? Ohne "
    "Bibliothekar erscheint Dir das aussichtslos, aber es ist keiner zu "
    "sehen. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden","teppich" }),
    "Der Boden ist mit einem besonderen schallschluckenden Teppich ausgelegt, "
    "damit kein Geraeusch die Leser stoert."
  );

  AddDetail( ({"leser"}) ,
    "Leser lesen Buecher."
  );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende kannst Du gar nicht erkennen, denn sie sind mit Regalen "
    "zugestellt. "
  );

  AddDetail( ({"decke"}) ,
    "An der Decke haengt eine Lampe, die ausreichend Licht zum Lesen "
    "spendet. "
  );

  AddDetail( ({"schloss","schlosses","feenschloss","feenschlosses"}) ,
    "Du befindest Dich in ihm. "
  );

  AddDetail( ({"fee","feen"}) ,
    "Die wohnen hier."
  );

  AddDetail( ({"bibliotheken"}) ,
    "Wenn Du alle Bibliotheken untersuchen willst, muss Du Dich schon dort "
    "hinbegeben."
  );

  AddDetail( ({"bibliothek"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({ "bibliothekar" }),
       ([    0: "Du fragst Dich, wie die Feen bei diesen Unmengen an "
                "Buechern ueberhaupt den Durchblick behalten.",
         "fee": "Als Fee kennst Du Dich natuerlich bestens in der "
                "Bibliothek aus, daher ist ein Bibliothekar voellig unnoetig."
        ]) );

  AddDetail( ({"umenge","unmengen"}) ,
    "Es sind wirklich sehr, sehr, sehr, sehr viele Buecher."
  );

  AddDetail( ({"durchblick"}) ,
    "Den hast Du bei dieser Unmenge von Buechern schon laengst verloren."
  );

  AddDetail( ({ "buecher","buechern","buch" }),
       ([    0: "Leider beherrschst Du die Feenschrift nicht, aber ein "
                "rotes Buch faellt Dir besonders auf.",
         "fee": "Da Du ja bereits alle Buecher gelesen hast, wirst Du als "
                "Fee nichts neues darin finden. Ist da aber nicht doch ein "
                "neues rotes Buch?"
        ]) );

  AddReadDetail( ({ "buecher","buechern","buch" }),
       ([    0: BS("Leider beherrschst Du die Feenschrift nicht. Aber das "
                   "rote Buch wuerde Dich schon interessieren."),
         "fee": BS("Da Du ja bereits alle Buecher gelesen hast, wirst Du "
                   "als Fee nichts neues darin finden.")
        ]) );

  AddDetail( ({ "rotes buch" }),
       ([    0: "Auch das rote Buch kannst Du nicht lesen, aber es steckt "
                "ein Lesezeichen im Buch.",
         "fee": "Ach ja, doch, das Buch kennst Du. Aber jemand hat ein "
                "Lesezeichen darin vergessen."
        ]) );

  AddReadDetail( ({ "rotes buch" }),
       ([    0: BS("Auch das rote Buch kannst Du nicht lesen, aber es "
                   "steckt ein Lesezeichen im Buch."),
         "fee": BS("Ach ja, doch, das Buch kennst Du. Aber jemand hat "
                   "ein Lesezeichen darin vergessen.")
        ]) );

  AddDetail( ({"lesezeichen"}) ,
    "Du kannst es lesen."
  );

  AddReadDetail( ({"lesezeichen"}) ,
    "Wir sind nicht nur verantwortlich fuer das, was wir tun, \n"
    "sondern auch fuer das, was wir nicht tun.\n\n\n"
    "Du beschliesst, Dir diesen Spruch zu merken."
  );

  AddDetail( ({"spruch"}) ,
    "Der ist auf dem Lesezeichen notiert worden."
  );

  AddDetail( ({"geraeusch"}) ,
    "Du musst schon lauschen."
  );

  AddDetail( ({"regal","regale"}) ,
    "Buecher, Buecher, Buecher, nichts als Buecher."
  );

  AddDetail( ({"licht"}) ,
    "Das Licht kommt von der Lampe ueber dir. Sie haengt zu hoch, als dass "
    "Du sie erreichen koenntest. "
  );

  AddDetail( ({"lampe"}) ,
    "Sie haengt zu hoch, als dass Du sie erreichen koenntest. Es befinden "
    "sich einige Irrlichter darinnen, die Licht spenden. "
  );

  AddDetail( ({"irrlicht","irrlichter"}) ,
    "Die Irrlichter in der Lampe spenden immer genuegend Licht."
  );

  AddSound( DEFAULT_SOUND ,
    "Absolute Stille. Wie es sich fuer eine Bibliothek gehoert."
  );

  AddSound( ({"stille"}),
    "Du hoerst absolut nichts."
  );

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Buechern und etwas nach Staub."
  );

  AddSmell( ({"staub"}) ,
    "Hust! Hust! Hust!"
  );

  AddSmell( ({"buch","buecher"}),
    "Die Buecher riechen leicht nach Staub."
  );

  AddCmd( ({"ruf","rufe"})   , "cmd_rufen");
  AddCmd( ({"merk","merke"}) , "cmd_merken");

  AddExit("osten",  ROOM "sgang13.lpc");
  AddExit("westen", ROOM "sgang15.lpc");
}

int cmd_rufen(string str)
{
  TELLPLAYER(BS("Ein Wichtel kommt herein und fluestert Dir zu: Pssssssst! "
                "Danach verschwindet es wieder lautlos."));
  TELLOTHERS(BS("Ein Wichtel kommt herein, fluestert "+TPN+" etwas zu und "
                "verschwindet wieder."));
  return 1;
}

int cmd_merken(string str)
{
  notify_fail("Was moechtest Du Dir merken?\n");

  if(!str || str == "") return 0;
  if(!(str == "spruch"         ||
       str == "den spruch"     )) return 0;

  TELLPLAYER("Du lernst den Spruch auswendig.\n");
  FMASTER->Msg(TPUID+" merkt sich einen schlauen Spruch");

  return 1;
}

