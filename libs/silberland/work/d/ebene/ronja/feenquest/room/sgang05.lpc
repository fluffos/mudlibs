#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Burgfried");
  SetProp(P_INT_LONG,
    "Die Eleganz des Schlosses laesst hier etwas nach, denn die Fundamente "
    "muessen ja den nordwestlichen Turm tragen. Von dort oben hat man "
    "sicherlich eine grossartige Aussicht ueber das Silberland."
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "turm","fusse","fuss" }),
    "Du befindest Dich am Fusse des nordwestlichen Turmes."
  );

  AddDetail( ({"silberland"}) ,
    "Geh hinaus und erforsche es!"
  );

  AddDetail( ({"schloss","schlosses","feenschloss"}) ,
    "Du befindest Dich im Feenschloss. Hektische Betriebsamkeit ist "
    "ueberall zu spueren, denn bald ist es Vollmond und die Feen werden "
    "ihren magischen Tanz auffuehren."
  );

  AddDetail( ({"fundament","fundamente"}) ,
    "Maechtig muessen die Fundamente sein, die diesen Turm tragen. Die "
    "Mauern sind sehr dick."
  );

  AddDetail( ({"eleganz"}) ,
    "Ganz so elegant ist es hier nicht wie im anderen Schloss, aber dieser "
    "maechtige Turm braucht dicke Waende und starke Fundamente."
  );

  AddDetail( ({"aussicht"}) ,
    "Da musst Du schon bis ganz nach oben gehen, um die Aussicht geniessen "
    "zu koennen."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus maechtigen Steinplatten. Ob sich darunter wohl "
    "was verbirgt?"
  );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende bestehen aus dicken Mauern, in denen die Baumeister der "
    "Zwerge einige Steinreliefs eingearbeitet haben."
  );

  AddDetail( ({"vollmond","tanz","feentanz"}) ,
    "Am besten fragst Du den Oberdiener mal danach, der kennt sich damit aus "
    "und erzaehlt Dir bestimmt auch etwas darueber."
  );

  AddDetail( ({"oberdiener"}) ,
    "Der Oberdiener ist immer unterwegs. Entweder findest Du ihn im Schloss "
    "oder im Hain."
  );

  AddDetail( ({"hain"}) ,
    "Der Hain befindet sich vor dem Schloss."
  );

  AddDetail( ({"zwerge","baumeister"}) ,
    "Zwerge sind grossartige Baumeister."
  );

  AddDetail( ({"betriebsamkeit"}) ,
    "Wegen des bevorstehenden Termines sind alle aufgeregt und es herrscht "
    "rege Betriebsamkeit."
  );

  AddDetail( ({"decke"}) ,
    "Es ist eine Steindecke."
  );

  AddDetail( ({"steindecke"}) ,
    "Eine Steindecke besteht aus Steinen."
  );

  AddDetail( ({"mauern","mauer"}) ,
    "Die Mauern bestehen aus grossen Steinen, die man wohl aus dem Gebirge "
    "herangeschafft hat."
  );

  AddDetail( ({"steinreliefs","relief","reliefs","steinrelief"}) ,
    "Sie zeigen viele Staetten des Silberlandes. Einige kommen Dir bekannt "
    "vor, einige nicht."
  );

  AddDetail( ({"staetten"}) ,
    "Erforsche das Silberland gut, dann wirst auch Du diese Staetten "
    "kennen lernen."
  );

  AddDetail( ({"termines","termin"}) ,
    "Bald ist wieder Vollmond!"
  );

  AddDetail( ({"steinplatten","platten"}) ,
    "Sie bilden den Boden, auf dem Du laeufst. Sie sehen fast aus wie Marmor, "
    "aber der waere nicht stabil genug gewesen um den Turm zu bauen."
  );

  AddDetail( ({"marmor"}) ,
    "Nein, es ist wirklich kein Marmor. Aber die Steinplatten sehen Marmor "
    "verflixt aehnlich."
  );

  AddDetail( ({"steine","stein","steinen"}) ,
    "Die Steine hat man wohl weit aus dem Gebirge geholt."
  );

  AddDetail( ({"gebirge"}) ,
    "Das Gebirge befindet sich noerdlich von hier."
  );

  AddExit("osten",  ROOM "sgang06.lpc");
  AddExit("sueden", ROOM "sgang04.lpc");
  AddExit("oben",   ROOM "turm11.lpc");
  AddExit("unten",  ROOM "kerker.lpc");

  AddItem(NPC "fee.lpc", REFRESH_DESTRUCT);

}



