#include "../def.h"

inherit "std/room";

#define AUF 1
#define ZU 0

int vorhang;
string eintrag;
string schreiberling;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Empfangshalle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in der Empfangshalle des Schlosses. Dicker Teppich "
    "verbreitet eine gemuetliche Atmosphaere, Du fuehlst Dich hier sofort "
    "wohl. An der Suedwand steht ein Sofa, an der Nordwand kannst Du ein "
    "kleines Podest erkennen. An der Decke haengt ein maechtiger "
    "Kristallleuchter, die Decke an sich ist mit Holz ausgekleidet. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende sind mit schwerem Stoff bespannt, so dass jedes laute "
    "Geraeusch sofort gedaempft wird. An der Suedwand steht ein Sofa, "
    "welches Dich zum verweilen einlaedt. An der Nordwand steht ein "
    "kleines Podest, an der Ostwand befindet sich ein grosses Fenster. "
  );

  AddDetail( ({"westwand"}) ,
    "An der Westwand siehst Du nichts aussergewoehnliches. "
  );

  AddDetail( ({"boden"}) ,
    "Der Boden ist mit einem dicken, roten Teppich ausgelegt, der jeden "
    "Deiner Schritte daempft. Mach ihn bloss nicht schmutzig!"
  );

  AddDetail( ({"teppich"}) ,
    "Der Teppich ist dick und rot und sehr dicht gewebt. Da Du Dich mit "
    "Teppichen eh nicht auskennst, nuetzt es auch nichts, wenn Du seine "
    "Herkunft kennst. Eins ist auf alle Faelle sicher: ein fliegender "
    "Teppich ist es nicht."
  );

  AddDetail( ({"sofa"}) ,
    "An der Suedwand befindet sich ein Sofa, welches sehr bequem aussieht. "
    "Wenn Du Dich ein wenig ausruhen moechtest, dann setze Dich doch darauf."
  );

  AddDetail( ({"schloss","schlosses"}) ,
    "Du befindest Dich in ihm."
  );

  AddSpecialDetail( ({"podest"}) , "detail_podest");

  AddDetail( ({"nordwand"}) ,
    "An der Nordwand steht ein Podest."
  );

  AddSpecialDetail( ({"leuchter","kristallleuchter"}) , "detail_leuchter" );

  AddDetail( ({"holz"}) ,
    "Die Decke ist mit sehr edlem Holz aus dem Dschungel getaefelt. Du "
    "glaubst, dass es Tic-Toc Holz sein koennte."
  );

  AddDetail( ({"empfangshalle","halle"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"decke"}) ,
    "Die Decke ist vollstaendig mit Holz vertaefelt. Ein riesiger "
    "Kristallleuchter haengt herab."
  );

  AddDetail( ({"atmosphaere","umgebung"}) ,
    "Du fuehlst Dich wohl in dieser Umgebung."
  );

  AddDetail( ({"toc","tic","tic-toc","tic-toc holz"}) ,
    "Ein sehr seltenes und schoenes Holz. Man findet es weit im Sueden "
    "im Dschungel."
  );

  AddDetail( ({"suedwand"}) ,
    "An der Suedwand steht ein Sofa, welches Dich zum verweilen einlaedt. "
    "Setz Dich doch einfach mal darauf."
  );

  AddDetail( ({"stoff"}) ,
    "Die Waende sind mit sehr feinem und edlem Stoff bespannt, so dass hier "
    "eine wohlige Stimmung herrscht."
  );

  AddSpecialDetail( ({"stift"}) , "detail_stift");

  AddDetail( ({"schritte"}) ,
    "Der Teppich daempft Deine Schritte, so dass man sie kaum hoert."
  );

  AddDetail( ({"platte"}) ,
    "Die Platte ist ebenso wie das Podest aus feinstem Marmor. Auf ihr liegt "
    "das Gaestebuch."
  );

  AddDetail( ({"ostwand"}) ,
    "Die Ostwand wird dominiert durch ein grosses Fenster, welches "
    "ausreichend Licht gibt."
  );

  AddDetail( ({"monent"}) ,
    "Zack - und schon ist er vorbei."
  );

  AddDetail( ({"marmor"}) ,
    "Der Marmor wurde bestimmt von den Zwergen geliefert, denn nur sie "
    "wissen, wo man solch edlen Marmor findet und auch bearbeitet."
  );

  AddDetail( ({"licht"}) ,
    "Ausreichend Licht faellt durch das grosse Fenster an der Ostwand."
  );

  AddDetail( ({"herkunft"}) ,
    "Wenn Du die Herkunft des Marmors wissen willst, musst Du Dich an die "
    "Zwerge wenden, denn nur sie wissen, wo man so schoenen Marmor findet. "
    "Aber ob sie es Dir auch dann verraten, ist eine andere Frage, denn "
    "Zwerge sind sehr verschwiegen."
  );

  AddDetail( ({"geraeusch","geraeusche"}) ,
    "Lausche ihnen einfach."
  );

  AddSpecialDetail( ({"gaestebuch","buch"}) , "detail_buch");

  AddDetail( ({"fenster"}) ,
    "An der Ostwand befindet sich ein riesiges Fenster. Links und rechts "
    "befinden sich schwere Vorhaenge, damit an kalten Winternaechten die "
    "Kaelte draussen bleibt. "
  );

  AddDetail( ({"faelle","wasserfaelle"}) ,
    "Faelle? Meinst Du Wasserfaelle? Sowas gibts hier doch nicht!"
  );

  AddDetail( ({"dschungel"}) ,
    "Der Dschungel befindet sich weit im Sueden von hier."
  );

  AddDetail( ({"moment"}) ,
    "Zack - vorbei ist er."
  );

  AddDetail( ({"stimmung"}) ,
    "Warm und gemuetlich ist es hier."
  );

  AddDetail( ({"winternaechte","winternaechten"}) ,
    "Manchmal koennen die Winternaechte ganz schoen kalt werden. Damit es "
    "dann schoen warm im Schloss ist, werden die Vorhaenge geschlossen. "
  );

  AddDetail( ({"kaelte"}) ,
    "Die kommt aus dem Gebirge."
  );

  AddDetail( ({"frage"}) ,
    "Frag nur, sonst lernst Du ja nichts."
  );

  AddDetail( ({"zwerg","zwerge","zwergen","heimat","gebirge"}) ,
    "Die Heimat der Zwerge ist das Gebirge, dort haben sie auch ihre Hauptstadt."
  );

  AddDetail( ({"hauptstadt","felonia"}) ,
    "Die Hauptstadt der Zwerge heisst Felonia und liegt im Norden im Gebirge."
  );

  AddDetail( ({"kordel"}) ,
    "Der Stift ist mit einer Kordel befestigt, so dass ihn niemand mitnehmen "
    "kann."
  );

  AddDetail( ({"schlosshof"}) ,
    "Von hier aus gibt es keinen Zugang zum Schlosshof."
  );

  AddDetail( ({"zugang"}) ,
    "Du kannst das Schloss nach westen verlassen."
  );

  AddSpecialDetail( ({"vorhang","vorhaenge"}) , "detail_vorhang");

  AddDetail( ({"eintrag"}) ,
    "Du kannst ihn lesen."
  );

  AddDetail( ({"abenteurer"}) ,
    "Du bist doch einer, oder etwa nicht?"
  );

  AddSound( ({DEFAULT_SOUND,"geraeusch","geraeusche"}) ,
    "Die Waende sind mit schwerem Stoff bespannt, so dass jedes laute "
    "Geraeusch sofort gedaempft wird. So hoerst Du fast nichts."
  );

  AddCmd( ({"schliess","schliesse"}), "cmd_schliessen"  );
  AddCmd( CMD_OEFFNEN               , "cmd_oeffnen"     );
  AddCmd( CMD_SCHREIBEN             , "cmd_schreiben"   );
  AddCmd( CMD_LESEN                 , "cmd_lesen"       );
  AddCmd( CMD_SETZEN                , "cmd_setzen"      );
  AddCmd( ({"schau","schaue"})      , "cmd_schauen"     );

  AddExit("norden", ROOM "sgang04.lpc");
  AddExit("sueden", ROOM "sgang02.lpc");
  AddExit("westen", ROOM "hain2.lpc");

  vorhang = AUF;
  eintrag = "";
  restore_object(ROOM "sgang03");
}

void oeffnevorhang(object pl)
{
  if(pl)
  {
    pl->command_me("sage Wer hat denn schon wieder die Vorhaenge geschlossen?");
    tell_room(TO,"Kurzentschlossen oeffnet der Diener die Vorhaenge wieder.\n");
  }
  vorhang = AUF;
  SetProp(P_LIGHT,1);
}

int check_if_npc(object ob)
{
  if(interactive(ob)) return 0;
  if(living(ob)) return 1;
  return 0;
}

int check_if_player(object ob)
{
  if(interactive(ob)) return 1;
  return 0;
}

void init()
{
  ::init();
  if(TP && TP->id("kammerdiener") && vorhang == ZU)
    call_out("oeffnevorhang",0,TP);


}

string syntax()
{
  return "\nSyntax: schreibe ... \nSyntax: lies Gaestebuch\n";
}

string detail_podest(string str)
{
  string s;

  s = "Das Podest besteht aus feinstem weissen Marmor. Auf seiner Platte "
      "liegt ein Gaestebuch, in dem auch Du etwas schreiben kannst. Neben "
      "dem Buch liegt ein Stift. ";

  return BS(s)+syntax();
}

string detail_stift(string str)
{
  string s;

  s = "Mit dem Stift kannst Du etwas in das Gaestebuch schreiben. Er ist "
      "mit einer kurzen Kordel an der Platte befestigt, damit Du ihn nicht "
      "mitnehmen kannst." ;

  return BS(s)+syntax();
}

string detail_buch(string str)
{
  string s;

  s = "Das Gaestebuch befindet sich auf einem kleinen Podest an der "
      "Nordwand. Du kannst etwas in das Gaestebuch schreiben oder den "
      "letzten Eintrag lesen. ";

  return BS(s)+syntax();
}

string detail_vorhang(string str)
{
  string s;

  s = "Dicke schwere Vorhaenge haengen rechts und links vom Fenster. Sie "
      "dienen vornehmlich dazu, die Kaelte in strengen Winternaechten "
      "draussen zu lassen. Momentan sind sie "+
      (vorhang == AUF ? "geoeffnet." : "geschlossen.");
  return BS(s);
}

string detail_leuchter(string str)
{
  string s;

  s = "An der Decke haengt ein riesiger Kristallleuchter. Im Moment "
      "verbreitet er kein Licht, ";

  if(vorhang == AUF)
  {
    s += "da durch das grosse Fenster genug Licht in die "
         "Empfangshalle faellt.";
  }
  else
  {
    s += "obwohl die Vorhaenge geschlossen sind.";
  }

  return BS(s);
}


int cmd_schliessen(string str)
{
  object diener;

  notify_fail("Was moechtest Du schliessen?\n");

  if(!str || str == "") return 0;
  if(!(str == "vorhang"         ||
       str == "vorhaenge"         )) return 0;

  if(vorhang == ZU)
  {
    TELLPLAYER("Aber die Vorhaenge sind doch schon geschlossen!\n");
    TELLOTHERS(CTPN+" fummelt an den Vorhaengen herum.\n");
    FMASTER->Msg(TPUID+" versucht die geschlossenen Vorhaenge zu schliessen");
  }
  else
  {
    TELLPLAYER("Du schliesst die Vorhaenge. Dadurch wird es dunkel.\n");
    TELLOTHERS(TPN+" schliesst die Vorhaenge.\n");
    vorhang = ZU;
    SetProp(P_LIGHT, 0);
    FMASTER->Msg(TPUID+" schliesst die Vorhaenge");
    if(diener=present("diener",TO))
    {
      diener->command_me("sage Was fummelst Du denn an den Vorhaengen "
                         "herum? Lass die gefaelligst offen.");
      tell_room(TO,"Der Diener oeffnet die Vorhaenge wieder.\n");
      vorhang = AUF;
      SetProp(P_LIGHT,1);
      FMASTER->Msg("Der Diener oeffnet die Vorhaenge sofort wieder");
    }
  }

  return 1;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "vorhang"         ||
       str == "vorhaenge"       )) return 0;

  if(vorhang == AUF)
  {
    TELLPLAYER("Aber die Vorhaenge sind doch schon offen.\n");
    TELLOTHERS(CTPN+" fummelt an den Vorhaengen herum.\n");
    FMASTER->Msg(TPUID+" versucht die offenen Vorhaenge zu oeffnen");
  }
  else
  {
    TELLPLAYER("Du oeffnest die Vorhaenge. Dadurch wird es hell.\n");
    TELLOTHERS(TPN+" oeffnet die Vorhaenge.\n");
    vorhang = AUF;
    SetProp(P_LIGHT, 1);
    FMASTER->Msg(TPUID+" oeffnet die Vorhaenge");
  }

  return 1;
}

int cmd_schreiben(string str)
{
  notify_fail("Du schreibst doch nichts in das Gaestebuch.\n");

  eintrag = this_player()->_unparsed_args();
  if(!eintrag || eintrag == "") return 0;

  schreiberling = CTPN;
  TELLPLAYER("Du schreibst etwas ins Gaestebuch.\n");
  TELLOTHERS(CTPN+" schreibt etwas ins Gaestebuch.\n");
  save_object(ROOM "sgang03");
  FMASTER->Msg(TPUID+" notiert : "+eintrag);

  return 1;
}

int cmd_lesen(string str)
{
  notify_fail("Was moechtest Du lesen?\n");

  if(!str || str == "") return 0;

  if(!(str == "gaestebuch" ||
       str == "buch"       ||
       str == "eintrag"    )) return 0;

  TELLPLAYER("Du liest den letzen Eintrag von "+schreiberling+": \n\n"+
             BS(eintrag)+"\n");
  FMASTER->Msg(TPUID+" liest das Gaestebuch");
  return 1;
}

int cmd_setzen(string str)
{
  notify_fail("Worauf willst Du Dich setzen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf sofa"         ||
       str == "dich auf sofa"    )) return 0;

  TELLPLAYER(BS("Du setzt Dich auf das Sofa, aber es ist Dir viel zu weich. "
                "Daher stehst Du wieder auf. Wilde Abenteurer wie Du sind "
                "anderes gewohnt."
  ));
  TELLOTHERS(BS(CAP(TPN)+" setzt sich kurz aufs Sofa, steht aber sofort "
                "wieder auf."));
  FMASTER->Msg(TPUID+" setzt sich aufs Sofa");

  return 1;
}

int cmd_schauen(string str)
{
  string s;
  object *players,*npcs, ob;
  int i;

  notify_fail("Woraus moechtest Du schauen?\n");

  if(!str || str == "") return 0;
  if(!(str == "aus fenster"       ||
       str == "durch fenster"     ||
       str == "fenster"           ||
       str == "aus dem fenster"   )) return 0;

  if(vorhang == ZU)
  {
    TELLPLAYER("Aber der Vorhang ist zugezogen, so kannst Du nicht aus "
               "dem Fenster schauen.\n");
    TELLOTHERS(CTPN+" starrt auf die geschlossenen Vorhaenge.\n");
    FMASTER->Msg(TPUID+" schaut aus dem geschlossenen Fenster im Eingang");
    return -1;
  }

  players = ({ });
  npcs    = ({ });

  for(i=1;i<=9;i++)
  {
    if(ob=find_object(ROOM "bhof"+sprintf("%d",i)))
    {
      players += filter_array(all_inventory(ob), "check_if_player");
      npcs    += filter_array(all_inventory(ob), "check_if_npc");
    }
  }

  players += npcs;

  s = "Du schaust aus dem Fenster und wirfst einen Blick auf den "
      "Schlosshof. ";

  switch(sizeof(players))
  {
    case 0 :
      s += "Du siehst nichts besonderes auf dem Schlosshof.";
      break;

    case 1 :
      s += "Auf dem Schlosshof befindet sich "+players[0]->name()+".\n";
      break;

    default :
      s += "Auf dem Schlosshof befinden sich "+
            LW(map_objects(players,"name"))+".\n";

      break;
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(CTPN+" starrt gedankenverloren aus dem Fenster.\n");
  FMASTER->Msg(TPUID+" schaut aus dem Fenster im Eingang");
  return 1;
}



