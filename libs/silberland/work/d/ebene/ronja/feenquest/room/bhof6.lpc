#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  AddDetail( ({"brunnen"}) ,
    "Der Brunnen liegt im Westen, Du musst schon naeher herangehen. "
  );

  AddExit( "norden",      ROOM "bhof3.lpc"  );
  AddExit( "westen",      ROOM "bhof5.lpc"  );
  AddExit( "sueden",      ROOM "bhof9.lpc"  );
  AddExit( "suedwesten",  ROOM "bhof8.lpc"  );
  AddExit( "nordwesten",  ROOM "bhof2.lpc"  );
  AddExit( "osten",       ROOM "sgang11.lpc");
}

