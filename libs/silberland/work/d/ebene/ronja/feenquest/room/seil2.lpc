#include "../def.h"

inherit ROOM "seil0.lpc" ;


void fallen(object spieler);

void create()
{
  ::create();

  AddExit("suedosten",  ROOM "seil3.lpc" );
  AddExit("nordwesten", ROOM "seil1.lpc" );

  SetProp(P_RAUMUNTEN, ROOM "bhof5");
}

void init()
{
  ::init();

  if(TP && query_once_interactive(TP)) call_out("fallen", 4, TP);
}

void fallen(object spieler)
{
  object room;

  if(ENV(spieler) != TO) return;

  tell_object(spieler,BS(
    "Eine Windboe bringt das Seil zum Schwingen und Du kannst Dich nicht "
    "mehr halten. Du schaffst es grade noch, Dich mit beiden Haenden am "
    "Seil festzuhalen. Erschreckt bemerkst Du, dass die Knoten, die Du "
    "gemacht hast, diesem Ruck nicht standhalten und sich loesen. Du "
    "faellst auf den Schlosshof!"
  ));

  TP->move(ROOM "fallen:"+getuid(this_player()), M_GO|M_SILENT);

  FMASTER->seilweg(spieler,
    "Aus unerfindlichen Gruenden reisst auf einmal das Seil mit einem "
    "lauten Knall und Du stuerzt auf den Schlosshof."
  );

  room = find_object(ROOM "turm19");
  if(room) tell_room(room,
    BS("Mit einem lauten Peitschenknall zerreisst das Seil, welches "
       "zwischen den beiden Tuermen gespannt war und faellt herunter."),
    ({TP})
  );

  room = find_object(ROOM "turm39");
  if(room) tell_room(room,
    BS("Mit einem lauten Peitschenknall zerreisst das Seil, welches "
       "zwischen den beiden Tuermen gespannt war und faellt herunter."),
    ({TP})
  );

  return;
}



