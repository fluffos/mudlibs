#include "../def.h"

inherit ROOM "steg0";

void create()
{
  slong    = "Im Westen kannst Du den Silberwald erkennen.";
  sid      = "\nTICKET1";
  ziel     = ROOM "steg2.lpc";
  richtung = "nach Osten";

  ::create();

  AddDetail( ({"westen"}) , slong );

  AddDetail( ({"silberwald"}) ,
    "Der Silberwald liegt im Westen, Du musst schon naeher hingehen, "
    "wenn Du ihn erforschen willst. "
  );

  AddItem(OBJ "boot.lpc", REFRESH_DESTRUCT, 1);

  AddExit("westen" , ([EX_DEST : ROOM "weg3.lpc", EX_TESTFUNC : #'exit_test ]) );
}

