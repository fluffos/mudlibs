#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  AddDetail( ({"brunnen"}) ,
    "Der Brunnen liegt im Osten, Du musst schon naeher herangehen. "
  );

  AddExit( "norden",     ROOM "bhof1.lpc" );
  AddExit( "osten",      ROOM "bhof5.lpc" );
  AddExit( "sueden",     ROOM "bhof7.lpc" );
  AddExit( "nordosten",  ROOM "bhof2.lpc" );
  AddExit( "suedosten",  ROOM "bhof8.lpc" );

}

