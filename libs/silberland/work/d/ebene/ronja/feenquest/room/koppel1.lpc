#include "../def.h"

inherit ROOM "koppel0";

void create()
{
  ::create();

#include "kop_env1_nah.lpc"
#include "kop_env2_nah.lpc"
#include "kop_env3_weit.lpc"
#include "kop_env4_weit.lpc"

  AddExit("osten"     , ROOM "koppel2");
  AddExit("suedosten" , ROOM "koppel4");
  AddExit("sueden"    , ROOM "koppel3");

  AddCmd( CMD_KLETTERN                , "cmd_klettern");
  AddCmd( ({"betrete","betrete"})     , "cmd_betreten");
  AddCmd( ({"such","suche"})          , "cmd_suchen");

}

void init()
{
  object room;

  ::init();
  if(TP && TP->id("\nFEENPFERD"))
  {
    if(room=find_object(ROOM "weg6"))
    {
      tell_room(room,CAP(TP->Name(WER,0))+" kommt an das Gatter gelaufen.\n");
    }
  }
}

void exit()
{
  object room;

  ::exit();
  if(TP && TP->id("\nFEENPFERD"))
  {
    if(room=find_object(ROOM "weg6"))
    {
      tell_room(room,CAP(TP->Name(WER,0))+" laueft auf die Koppel hinaus.\n");
    }
  }
}

int cmd_klettern(string str)
{
  int stat;
  string s;

  notify_fail("Worueber willst Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "gatter"        ||
       str == "ueber gatter"  ||
       str == "ueber brett"   ||
       str == "ueber bretter" ||
       str == "brett"         ||
       str == "bretter"       )) return 0;

  s = "Hast Du nicht etwas vergessen? ";
  stat = 0;
  stat += (present("sattel",TP)   ? 1 : 0);
  stat += (present("zaumzeug",TP) ? 2 : 0);
  switch(stat)
  {
    case 1 :
      s += "Richtig, den Sattel, den wolltest Du doch wieder zurueckbringen.";
      break;

    case 2 :
      s += "Richtig, das Zaumzeug. Das wolltest Du doch wieder "
           "zurueckbringen.";
      break;

    case 3 :
      s += "Richtig, Du wolltest doch noch den Sattel und das Zaumzeug "
           "zurueckbringen.";
      break;
  }

  if(stat)
  {
    TELLPLAYER(BS(s));
    TELLOTHERS(CTPN+" scheint ueber etwas nachzudenken.\n");
  }
  else
  {
    TP->move(ROOM "weg6",M_GO,"ueber das Gatter","klettert",
      "kommt ueber das Gatter geklettert.");
  }

  return 1;
}

int cmd_betreten(string str)
{
  notify_fail("Was moechtest Du betreten?\n");

  if(!str || str == "") return 0;
  if(!(str == "maisfeld" ||
       str == "feld"     )) return 0;

  TP->move(ROOM+"maisfeld:"+getuid(this_player()), M_GO,
                "im Maisfeld","verschwindet","");

  return 1;
}

int cmd_suchen(string str)
{
  notify_fail("Was moechtest Du suchen?\n");

  if(!str || str == "") return 0;
  if(!(str == "kolben"         ||
       str == "maiskolben"     ||
       str == "mais"           )) return 0;

  TELLPLAYER(BS("Hier am Rand des Maisfeldes finden sich keine Maiskolben. "
                "Aber vielleicht kann man im Maisfeld selbst noch welche "
                "finden. Dazu muesstest Du das Maisfeld aber erstmal "
                "betreten."));
  return 1;
}


int IsCornThere()
{
  return 1;
}
