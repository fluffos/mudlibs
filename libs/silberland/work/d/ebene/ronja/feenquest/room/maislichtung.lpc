#include "../def.h"

inherit "std/room";

int kolben;
int vis;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Lichtung in einem Maisfeld");
  SetProp(P_INT_LONG,
    "Oups, was ist das? Hier sind die Maispflanzen in einem Umkreis von "
    "circa 3 Metern platt getreten, so dass eine kleine Lichtung "
    "entstanden ist. Wer das wohl war? Seit langem streifst Du nun durch "
    "das Maisfeld und hast nichts anderes gesehen als dichte Maispflanzen "
    "und jetzt das. Als Du Dich so umsiehst, stellst Du fest, dass das "
    "Maisfeld in Richtung Sueden lichter zu sein scheint. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_OUT|NO_TPORT_IN);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({"boden"}) ,
    "Auf dem Boden liegen jede Menge bereits zertrampelter Maispflanzen "
    "herum, ein richtiges Gestruepp. "
  );

  AddDetail( ({"menge"}) ,
    "Die ganzen Pflanzen hier wuerden niedergetreten, so dass sie nun alle "
    "auf dem Boden liegen. "
  );

  AddDetail( ({"gestruepp"}) ,
    "Die ganzen Pflanzen hier in diesem Teil des Maisfeldes wurden herunter"
    "getreten, sodass hier so etwas aehnliches wie eine Lichtung entstanden "
    "ist. Der ganze Boden ist ueber und ueber mit zertretenen Maispflanzen "
    "bedeckt. Wenn Du hier etwas verlierst, wirst Du ganz schoen lange "
    "im Gestruepp wuehlen muessen, bis Du es wiederfindest. "
  );

  AddDetail( ({"teil"}) ,
    "Dieser Teil des Maisfeldes gleicht eher einer Lichtung, denn alle "
    "Pflanzen wurden niedergetrampelt. "
  );

  AddDetail( ({"himmel","himmels"}) ,
    "Hier kannst Du ein Stueck des blauen Himmels erkennen, da die Pflanzen "
    "hier nicht so dicht stehen. "
  );

  AddDetail( ({"stueck"}) ,
    "Der Blick nach oben ist frei, so dass Du ein Stueck des blauen Himmels "
    "erkennen kannst. "
  );

  AddDetail( ({"blick"}) ,
    "Wenn Du Deinen Blick nach oben schweifen laesst, dann kannst Du ein "
    "Stueck blauen Himmel erkennen. "
  );

  AddDetail( ({"lichtung"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"maisfeld","feld","maisfeldes"}) ,
    "Um Dich herum ist ein riesiges Maisfeld, was bloss mit diesen Unmengen "
    "an Mais passieren soll, wenn er erst einmal reif ist? "
  );

  AddDetail( ({"unmengen"}) ,
    "Wenn der Mais in diesem Feld ersteinmal reif ist, dann gibt es "
    "Unmengen von Mais. Wer soll das bloss alles essen?"
  );

  AddDetail( ({"mais"}) ,
    "Der Mais ist noch nicht reif."
  );

  AddDetail( ({"maispflanzen","pflanzen"}) ,
    "Langsam kannst Du keine Maispflanzen mehr sehen, hier scheint es "
    "nichts anderes zu geben. Selbst auf dem Boden liegen jede Menge "
    "Pflanzen herum. "
  );

  AddSpecialDetail( ({"maiskolben","kolben"}) , "detail_maiskolben" );

  AddDetail( ({"meter","metern","durchmesser"}) ,
    "Diese Lichtung hat einen Durchmesser von ungefaehr drei Metern. "
    "Allerdings ist nicht erkennbar, wer hier so gewuetet hat. Es sind "
    "noch nicht mal Spuren zu erkennen, die wieder in das in Maisfeld "
    "fuehren. Diese Lichtung ist wirklich raetselhaft."
  );

  AddDetail( ({"spuren"}) ,
    "Komisch, Spuren, welche erkennen lassen koennten, wer diese Lichtung "
    "fabriziert hat, sind keine vorhanden. Zumindest sollten ja welche "
    "zu sehen sein, die wieder in das Maisfeld fuehren. Oder sollte "
    "derjenige, der fuer diese Lichtung verantwortlich ist, fliegen "
    "koennen?"
  );

  AddDetail( ({"umkreis"}) ,
    "In einem Umkreis von zirka drei Metern sind die Maispflanzen hier "
    "niedergetrampelt, als ob jemand etwas gesucht haette. Oder hat sich "
    "etwa jemand einen Schlafplatz gemacht, weil er sich hier verirrt hat "
    "und nicht mehr raus kam? "
  );

  AddDetail( ({"schlafplatz"}) ,
    "Naja, wenn das hier ein Schlafplatz ist, was um Himmels willen "
    "hat dann hier geschlafen? Hier waere ja platz gewesen fuer einen "
    "ausgewachsenen Drachen! "
  );

  AddDetail( ({"drachen","drache"}) ,
    "Zum Glueck ist keiner da. Was aber, wenn er wieder zurueckkommt? "
    "Am Ende sogar der gefuerchtete Pflanzendrache? "
  );

  AddDetail( ({"glueck"}) ,
    "Hoffentlich ist das Glueck Dir auch weiter hold. "
  );

  AddDetail( ({"ende"}) ,
    "Das wird Dein Ende sein, wenn der Pflanzendrache jetzt kommt. "
  );

  AddDetail( ({"pflanzendrache"}) ,
    "Dieser Drache wird allseits stark gefuerchtet."
  );

  AddSpecialDetail( ({"norden","osten","sueden","westen"})
                                    , "detail_richtungen");

  AddCmd( ({"lass","lasse"})        , "cmd_lassen");
  AddCmd( ({"blick","blicke"})      , "cmd_blicken");
  AddCmd( CMD_DURCHSUCHEN           , "cmd_wuehlen");
  AddCmd( CMD_NEHMEN                , "cmd_nehmen");

  AddSpecialExit( ({"norden"
                   ,"nordosten"
                   ,"osten"
                   ,"sueden"
                   ,"suedosten"
                   ,"suedwesten"
                   ,"westen"
                   ,"nordwesten"
                   })               , "exitfunc" );

  vis    = 0;
  kolben = 5 + random(2);
  previous_object()->CustomizeObject();
}

void init()
{
  ::init();
  vis = 0;
}

void reset()
{
  ::reset();

  kolben = 5 + random(2);
}

int noliving(object ob)
{
  return !living(ob);
}

void cleanup()
{
  int i;
  object *ob;

  ob = filter_array(all_inventory(TO), "noliving");
  i = sizeof(ob);
  while(i--){ ob[i]->remove(); }
}

int exitfunc(string dir)
{

  cleanup();

  if(dir != "sueden")
  {
    return TP->move(ROOM+"maisfeld:"+getuid(this_player()), M_GO);
  }
  else
  {
    return TP->move(ROOM "koppel2",M_GO,0,"verschwindet im Maisfeld",
                  "kommt aus dem Maisfeld herausgestapft");
  }

  return 1;
}

string detail_maiskolben(string str)
{
  string s;

  if(vis)
  {
    if(kolben)
    {
      s = "Auf dem Boden hast Du einige niedergetretene Maispflanzen "
          "gefunden, an denen sich bereits einige fruehreife Maiskolben "
          "befinden. ";
    }
    else
    {
      s = "Auf dem Boden hast Du einige niedergetretene Maispflanzen "
          "gefunden. Jedoch befinden sich auch hier keine Maiskolben "
          "daran. ";
    }
  }
  else
  {
    s = "Der Mais ist noch lange nicht reif. Da musst Du noch etwas "
        "warten, bis Du Maiskolben zu Gesicht bekommst. ";
  }

  return BS(s);
}

string detail_richtungen(string str)
{
  return CAP(str)+" liegt im "+CAP(str)+".\n";
}

int cmd_lassen(string str)
{
  notify_fail("Was moechtest Du schweifen lassen?\n");

  if(!str || str == "") return 0;
  if(!(str == "blick schweifen"           ||
       str == "blick nach oben schleifen" )) return 0;

  TELLPLAYER(BS("Du laesst den Blick nach oben schweifen und erkennst "
                "ein Stueck vom blauen Himmel. "));

  return 1;
}

int cmd_blicken(string str)
{
  notify_fail("Wohin moechtest Du blicken?\n");

  if(!str || str == "") return 0;
  if(!(str == "oben"         ||
       str == "nach oben"         )) return 0;

  TELLPLAYER(BS("Du laesst den Blick nach oben schweifen und erkennst "
                "ein Stueck vom blauen Himmel. "));

  return 1;
}

int cmd_wuehlen(string str)
{
  notify_fail("Worin moechtest Du wuehlen?\n");

  if(!str || str == "") return 0;
  if(!(str == "gestruepp"         ||
       str == "in gestruepp"         )) return 0;

  TELLPLAYER(BS("Du wuehlst in dem Gestruepp und findest unter den ganzen "
                "zertretenen Pflanzen ein paar fruehreife Stengel, an denen "
                "sich bereits ein paar Maiskolben befinden. "));
  vis = 1;
  return 1;
}

int cmd_nehmen(string str)
{
  object ob;
  string s;

  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "kolben"         ||
       str == "maiskolben"     )) return 0;

  if(kolben && vis)
  {
    s = "Du bueckst Dich und puhlst einen Maiskolben heraus. ";
    ob = clone_object(OBJ "maiskolben");

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      s += "Du hast jedoch schon soviel Sachen bei Dir, Du kannst selbst "
           "diesen Maiskolben nicht mehr tragen.";
      ob->remove();
    }
    else
    {
      s += "Du steckst den Maiskolben erstmal ein.";
      kolben--;
    }
  }
  else
  {
    s = "Die Maiskolben hier sind alle noch unreif und ungeniessbar. ";
  }

  TELLPLAYER(BS(s));
  return 1;
}



