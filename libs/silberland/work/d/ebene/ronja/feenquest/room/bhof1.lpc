#include "../def.h"

inherit ROOM "bhof0.lpc" ;

void create()
{
  ::create();

  AddDetail( ({"brunnen"}) ,
    "Der Brunnen liegt im Suedosten, Du musst schon naeher herangehen. "
  );

  AddExit( "osten",      ROOM "bhof2.lpc" );
  AddExit( "sueden",     ROOM "bhof4.lpc" );
  AddExit( "suedosten",  ROOM "bhof5.lpc" );

}

