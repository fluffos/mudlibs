#include "../def.h"

inherit "std/room";

int steinda;
string *gefunden;

string detail_inschrift();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Kerkerzelle");
  SetProp(P_INT_LONG,
    "Du stehst inmitten einer kleinen Kerkerzelle. Es ist daemmrig, denn "
    "durch das kleine Fenster kommt nur wenig Licht. Kein Wunder bei den "
    "Spinnweben, die rund um das Eisengitter sind. Im ganzen Raum findest "
    "Du nur einen Nachttopf, eine Zahnbuerste, einen Spiegel und eine "
    "knarrige Schlafstaette. An den Waenden erkennst Du Zeichnungen "
    "und Gedichte von ehemaligen Gefangenen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );

  AddDetail( ({ "gefangener", "gefangenen" }),
    "Viele scheinen es gewesen zu sein."
  );

  AddDetail( ({ "decke" }),
    "Eine einfache Decke, denn Gefangenen wird nichts vergoennt."
  );

  AddDetail( ({"zelle", "kerkerzelle"}),
    "Du stehst darin."
  );

  AddDetail( ({"fenster", "kerkerfenster"}),
     "Klein, und viel zu hoch oben, um hinausschauen zu koennen."
  );

  AddDetail( ({"licht"}) ,
     "Spaerlich scheint es durch das Kerkerfenster."
  );

  AddDetail( ({"wunder"}) ,
     "Da musste ein Wunder passieren, um lebend herauszukommen."
  );

  AddDetail( ({"staette","schlafstaette","bett"}),
    "Die Schlafstaette sieht nicht einladend aus, aber darunter scheint "
    "etwas zu liegen. Vielleicht solltest Du dort einmal suchen was da ist."
  );

  AddSpecialDetail( ({"unter staette","unter schlafstaette","unter bett"}),
     "detail_unterbett"
  );

  AddDetail(({"gitter", "eisengitter"}),
    "Die Gitter sind alt und rostig, und muessen einst schier "
    "unueberwindbare Hindernisse gewesen sein."
  );

  AddDetail( ({"eisen", "hindernisse", "hinderniss"}),
    "Altes, rostiges Eisen, aber trotzdem noch sehr stabil."
  );

  AddDetail(({"weben", "spinnweben"}),
    "Schon beim Betreten des Raumes konntest Du fast nichts erkennen, denn "
    "durch die Feuchtigkeit des Raumes angelockt, haben sich hier etliche "
    "Spinnen ihr Zuhause gestrickt."
  );

  AddDetail( ({"feuchtigkeit"}),
    "Hier ist es wirklich sehr feucht."
  );

  AddDetail( ({"spinnen", "spinne"}),
    "Etliche Spinnen haben hier ihre Spinnweben. Scheinbar werden sie selten "
    "gestoert."
  );

  AddDetail( ({"zuhause"}),
    "Du waerst jetzt auch viel lieber Zuhause."
  );

  AddSpecialDetail( ({"loch"}), "detail_loch");

  AddDetail( ({"topf", "nachttopf"}),
     "Er ist oval, klein, weiss und es sind rosa Herzen darauf."
  );

  AddDetail( ({"herz", "herzen", "rosa herzen"}),
    "Auf dem Nachttopf sind kleine rosa Herzen drauf."
  );

  AddDetail( ({"buerste", "zahnbuerste"}),
     "Mit der wuerde ich mich nicht mehr putzen."
  );

  AddDetail( ({"wand","waende"}),
     "Sie sind grau und mit Zeichnungen und Gedichten verziert."
  );

  AddDetail( ({"zeichnung", "zeichnungen"}),
     "Die Zeichnungen sind leider nicht gut zu erkennen."
  );

  AddDetail(({"spiegel"}),
     "Der Spiegel ist alt und man kann sich darin kaum selber erkennen."
  );

  AddDetail( ({"gedicht", "gedichte"}),
     "Leider kann man nur mehr eines lesen."
  );

  AddDetail( ({"finger"}) ,
    "Uff, noch alle da."
  );

  AddSpecialDetail( ({"stein"}) , "detail_stein");

  AddReadDetail("gedicht",
    "O Du holde Maid\n"
    "wie bist Du nur gescheit\n"
    "Du schoene liebe fee\n"
    "fuer Dich ich strecken geh\n"
    "Du liebes schoenes wesen\n"
    "kannst leben ohne lesen.\n"
    "Dir waiser holdger frau\n"
    "gib als schmuck ich die feder vom pfau\n"
    "....\n"
    "weiter ist es leider nicht mehr lesbar.\n"
  );

  AddDetail( ({"inschrift"}) ,
    "Lies mal..."
  );

  AddReadDetail("inschrift", #'detail_inschrift);

  AddDetail( ({"boden"}),
    "Ein harter, ungemuetlicher Boden."
  );

  AddSmell(DEFAULT_SMELL, "Hier stinkts fuerchterlich.");

  AddCmd( ({"such","suche"})   , "cmd_suchen");
  AddCmd( CMD_ESSEN            , "cmd_essen");
  AddCmd( CMD_NEHMEN           , "cmd_nehmen");

  AddExit("westen", ROOM "kerker");

  steinda  = 1;
  gefunden = ({ });
}

void reset()
{
  ::reset();

  steinda  = 1;
  gefunden = ({ });
}

string detail_stein()
{
  if(member(gefunden, getuuid(TP)) != -1)
  {
    return BS("Du erkennst ein kleines Loch im Stein, das solltest Du "
              "mal genauer untersuchen.");
  }

  return "Sowas siehst Du hier nicht!\n";
}

string detail_inschrift()
{
  if(member(gefunden, getuuid(TP)) != -1)
  {
    return BS("O Du intelligenter Sucher! Dies sind die menschlichen "
              "Ueberreste von Angrox, denn jeder, der Magier wird, muss "
              "seine sterbliche Huelle zuruecklassen, welche dann "
              "versteinert. Der Stein sieht aus wie eine verschrumpelte "
              "Frucht und ganz kurz kommt Dir die komische Idee, den Stein "
              "zu essen.");
  }

  return "Sowas siehst Du hier nicht!\n";
}

string detail_unterbett()
{
  if(steinda)
  {
    TELLOTHERS(CAP(TPN)+" bueckt sich und schaut unter das Bett.\n");
    gefunden += ({ getuuid(TP) });
    return "Du findest einen kleinen Stein, der Dir seltsam vorkommt.\n";
  }

  return "Du suchst, findest aber nichts.\n";
}

string detail_loch()
{
  if(member(gefunden, getuuid(TP)) != -1)
  {
    return BS("Du untersuchst den Stein sehr genau. Das Loch fasziniert "
              "Dich. Du versuchst den Finger ins Loch zu stecken aber "
              "nichts passiert. Enttaeuscht wendest Du Dich ab, aber dann "
              "passierts, Du findest eine kleine Inschrift auf dem Stein. "
              "Vielleicht kannst Du sie lesen.");
  }

  return "Sowas siehst Du hier nicht!\n";
}

int cmd_suchen(string str)
{
  notify_fail("Wo willst Du suchen?\n");

  if(!str || str == "") return 0;
  if(!(str == "darunter"            ||
       str == "unter staette"       ||
       str == "unter bett"          ||
       str == "unter schlafstaette" )) return 0;

  TELLPLAYER(detail_unterbett());
  return 1;
}

int cmd_essen(string str)
{
  notify_fail("Was moechtest Du essen?\n");

  if(!str || str == "") return 0;
  if(!(str == "stein"         ||
       str == "den stein"     )) return 0;

  if(member(gefunden, getuuid(TP)) == -1) return 0;

  TELLPLAYER(BS("Du schluckst den Stein - ein Strahl taucht auf - er umhuellt "
                "Dich und floesst Dir magische Kraefte ein. Du siehst "
                "gluecklich aus."
  ));
  TELLOTHERS(BS(CAP(TPN)+" wird von einer magischen Aura umhuellt und "
                "laechelt."
  ));

  FMASTER->Msg(TPUID+" isst den Stein");

  TP->heal_self(30);
  steinda  = 0;
  gefunden = ({ });

  return 1;
}

int cmd_nehmen(string str)
{
  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "stein"         ||
       str == "den stein"     )) return 0;

  if(member(gefunden, getuuid(TP)) == -1) return 0;

  TELLPLAYER(BS("Du nimmst den Stein, aber er faellt Dir sofort wieder aus "
                "der Hand und kullert wieder unter die Schlafstaette."
  ));

  TELLOTHERS(CAP(TPN)+" bueckt sich, wohl um etwas aufzuheben.\n");

  return 1;
}


