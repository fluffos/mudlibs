  );

  AddDetail( ({"gewand"}),
    "Das Gewand der Feen kannst Du nur sehen, wenn Du in den Schrank "
    "hineinschaust."
  );

  AddDetail( ({"groesse"}),
    "Hier ist die Groesse der Spiegel gemeint, die fast die gleiche ist wie "
    "die Tuer selbst."
  );

  AddDetail( ({"eiche","eichenholz"}),
    "Du klopfst kurz an den Schrank. Ja, das ist definitiv Eichenholz."
  );

  AddDetail( ({"platz"}),
    "In diesem Schrank gibt es soviel Platz, dass sogar ein Troll reinpasst "
    "und das soll schliesslich was heissen."
  );

  AddDetail( ({"vorderseite"}),
    "Auf dieser siehst Du fuenf Tueren, und auf jeder Tuer ist ein Spiegel "
    "eingelassen worden."
  );

  AddDetail( ({"hinterseite","rueckseite"}),
    "Um die zu sehen, muesstest Du den ganzen Schrank verschieben, aber "
