  );

  AddDetail( ({"farben"}),
    "Alle Farben, wie karminrot, azurblau, olivgruen, orangenorange, "
    "eidottergelb, rosenrosa, veilchenlila, erdbraun, ..."
  );

  AddDetail( ({"karminrot","azurblau","olivgruen","orangenorange"
              ,"eidottergelb","rosenrosa","veilchenlila","erdbraun"}) ,
    "Jaja, auch in dieser Farbe schillern die Tuecher."
  );

  AddDetail( ({"brise"}),
    "Die spuerst Du hauptsaechlich. Sehen kannst Du sie nur, wenn Du genau "
    "darauf achtest, wann sich die Seidentuecher an der Decke bewegen."
  );

  AddDetail( ({"sonnenstrahlen"}),
    "Muessen wohl vorhanden sein, denn sonst waer es hier sicher finster."
  );

  AddDetail( ({"leben"}),
    "Du atmest tief ein. Ja, das Leben ist was Schoenes!"
  );

  AddDetail( ({"waende","wand"}),
    "An der Suedwand steht ein Himmelbett, an der Westwand ein langer "
    "Schrank, nach Norden und Osten fuehren Durchgaenge in andere Raeume und "
    "in der Ecke zwischen den Durchgaengen steht eine Kommode."
  );

  AddDetail( ({"durchgaenge","durchgang","durchgaengen"}),
    "Den Nord- oder den Ostdurchgang?"
  );

  AddDetail( ({"norddurchgang"}),
    "Dieser fuehrt auf einen Gang hinaus."
  );

  AddDetail( ({"ostdurchgang"}),
    "Hier geht es wohl zum Bad."
  );

  AddDetail( ({"bad"}),
    "Jetzt sei nicht so faul und geh doch rein, wenn Du es sehen willst. Und: "
    "eine Dusche koennte Dir sicher auch nicht schaden!"
  );

  AddDetail( ({"dusche"}),
    "In diesem Zimmer ist keine zu sehen, aber vielleicht nebenan."
  );

  AddDetail( ({"gang"}),
    "Von hier siehst Du nur, dass er einen Steinfussboden hat, wenn Du mehr "
    "sehen willst, dann geh doch nach Norden."
  );

  AddDetail( ({"steinfussboden"}),
    "Der Gang hat einen Steinfussboden, wie es in einem Schloss wohl ueblich "
    "ist."
  );

  AddDetail( ({"suedwand"}),
    "An der Suedwand steht ein riesiges Himmelbett. Wenn man es genau nimmt, "
    "steht es nicht direkt an der Wand, sondern mitten im Raum, weil es so "
    "gross ist. Daneben ist ein Nachtkaestchen mit einer Kerze und links und "
    "rechts vom Bett sind zwei Fenster."
  );

  AddDetail( ({"westwand"}),
    "Vor dieser Wand steht ein grosser Schrank aus Eiche, sodass Du die Wand "
