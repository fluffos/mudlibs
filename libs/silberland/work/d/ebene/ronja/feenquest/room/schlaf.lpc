  AddDetail( ({"loecher","loch"}),
    "Du blickst durch ein Loch, aber in der Schublade ist es so finster, "
    "dass Du nichts erkennen kannst."
  );

  AddDetail( ({"kommodenspiegel"}),
    "Die Spiegel an dem Schrank scheinen der Fee nicht zu reichen, denn "
    "sonst haette sie diesen nicht noetig. Dich wundert nur, dass vor "
    "diesem Spiegel kein Stuhl steht, damit der Fee das Schminken leichter "
    "faellt. Anscheinend machen die das im Flattern."
  );

  AddDetail( ({"stuhl"}),
    "Du schaust noch einmal vor, neben und hinter die Kommode, aber es ist "
    "eindeutig kein Stuhl da."
  );

  AddDetail( ({"schminkutensilien","utensilien"}),
    "Die sind alle auf der Kommode verteilt. Es gibt unter anderen eine "
    "Puderdose, Lippenbalsam, Wimperntusche, eine Buerste und noch mehr. "
    "Halt das Notwendige, was eine Fee braucht, um huebsch auszusehen."
  );

  AddDetail( ({"puderdose","lippenbalsam","wimperntusche","sachen"}),
    "So viele Sachen zum Schminken koennen aber auch nur die Feen brauchen, "
    "die wohl eingebildeste und eitelste Rasse, die es ueberhaupt gibt."
  );

  AddDetail( ({"buerste"}),
    "Buersten sind zum Buersten da."
  );

  AddDetail( ({"rasse","feenrasse"}),
    "Die eitle Feenrasse ist damit gemeint."
  );

  AddItem(NPC "feek.lpc", REFRESH_DESTRUCT);

  AddCmd( ({"schau","schaue"})        , "cmd_schauen");
  AddCmd( ({"schwaerm","schwaerme"})  , "cmd_schwaermen");
  AddCmd( ({"loese","loes"})          , "cmd_loesen");
  AddCmd( CMD_OEFFNEN                 , "cmd_oeffnen");
  AddCmd( ({"buerst","buerste"})      , "cmd_buersten");
  AddCmd( ({"greif","greife"})        , "cmd_greifen");
  AddCmd( CMD_KLETTERN + ({"krabbel","krabble","krabbele"})
                                      , "cmd_klettern" );

  AddExit("norden", ROOM "sgang15");
  AddExit("osten",  ROOM "dusche.lpc");

  anzahl_bonbons = random(2)+2;
}

int MouseTrap(string loc,string msg)
{
  object falle;
  string s,old;

  if(!IS_WIZARD(TP))
  {
    if(!present("\nFEENQUESTOBJ",TP)) return 0;
    if(present("\nMAUSEFALLE",TP))    return 0;
  }

  if(QueryProp(P_VERSTECK) != loc)  return 0;

  s = msg;

  falle=clone_object(OBJ "mausefalle");

  if(ME_TOO_HEAVY==falle->move(TP,M_GET|M_SILENT))
  {
    s += "Leider kannst Du die Mausefalle nicht mehr tragen. ";
    falle->remove();
  }
  else
  {
    s += "Du beschliesst, sie mitzunehmen. ";
    FMASTER->Msg(TPUID+" findet die Mausefalle in "+loc);

    // Codestueck von unten in diesen else-Zweig verschoben,
    // sodass im zu-schwer-Fall kein neues Versteck ausgewuerfelt wird.
    location = QueryProp(P_VERSTECK);
    old      = location;

    while(old==location) location = verstecke[random(anzahl_verstecke)];

    SetProp(P_VERSTECK, location);
    save_object(ROOM "schlaf");
    // Codestueck-Ende
  }

  TELLPLAYER(BS(s));

  return 1;
}

void reset()
{
  ::reset();

  anzahl_bonbons = random(2) + 2;
}

string detail_fenstersims(string str)
{
  if(!MouseTrap(T_FENSTERSIMS,
    "Du faehrst mit Deinen Fingern den Fenstersims entlang. Selbst hier ist "
    "alles peinlichst sauber. *Autsch* Da stand doch glatt eine Mausefalle "
    "auf dem Fenstersims und ist zugeschnappt, als Du sie beruehrt "
    "hast. "))
  {
    TELLPLAYER(BS("Du faehst mit Deinen Fingern den Fenstersims entlang. "
                  "Selbst hier ist alles peinlichst sauber."));
    FMASTER->Msg(TPUID+" untersucht den Fenstersims");
  }

  return "";
}

int cmd_buersten(string str)
{
  notify_fail("Was willst Du Dir buersten?\n");

  if ( -1 != member(({"haar","haare"}),str))
  {
    TELLPLAYER(BS("Du buerstest Dir die Haare und betrachtest Deine Frisur im "
                  "Spiegel. Sieht gar nicht mal so schlecht aus!"
    ));
    TELLOTHERS(TPN+" buerstet sich die Haare.\n"
               "Du denkst: "+TPN+" ist auch schon so eitel wie die Feen.\n");
    FMASTER->Msg(TPUID+" buerstet sich die Haare");
    return 1;
  }
  if ( str == "zaehne" )
  {
    TELLPLAYER(BS("Du Ferkel! Willst Du Dir mit einer Haarbuerste Deine "
                  "Zaehne buersten? Geh doch ins Bad und schau, ob Du eine "
                  "Zahnbuerste findest."
    ));
    return 1;
  }
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen ?\n");

  if(!str || str == "") return 0;

  if(str == "dose")
  {
    if(anzahl_bonbons)
    {
      TELLPLAYER(BS("Voller Erwartung nimmst Du die Dose in die Hand, hebst "
                    "den Deckel herunter und blickst hinein. "
                    "Ein paar Bonbons lachen Dich an. Die Fee muss "
                    "wohl eine Naschkatze sein. Du ueberlegst, Dir eines "
                    "zu schnappen. Ohne zu zoegern langst Du in die Dose "
                    "und steckst Dir ein Bonbon in den Mund. Erst lutschst Du "
                    "nur darauf herum, aber dann zerbeisst Du es. Hmmmmm, "
                    "schmeckt das lecker!"
      ));
      TELLOTHERS(BS(TPN+" schaut sich eine Dose genauer an und laechelt dabei."
      ));
      TP->AddHp(7);
      TP->AddSp(4);
      anzahl_bonbons--;
      FMASTER->Msg(TPUID+" lutscht ein Bonbon");
    }
    else
    {
      TELLPLAYER(BS("Voller Erwartung nimmst Du die Dose in die Hand, hebst "
                    "den Deckel herunter und blickst hinein. "
                    "Schade, es ist nichts in der Dose drin."
      ));
    }

    return 1;
  }

  if(str == "schrank" || str == "tuer" || str == "schranktuer")
  {
    if(!MouseTrap(T_AUFDEMSCHRANK,
      "Du gehst zur Schranktuer hin, ziehst am Knauf und versuchst "
      "die Tuer zu oeffnen, doch es tut sich nichts. Du ruettelst "
      "ganz kraeftig, aber die Tuer geht einfach nicht auf. Allerdings "
      "klappert oben auf dem Schrank etwas. Als Du nachschaust, siehst "
      "Du dort eine Mausefalle. "))
    {
      TELLPLAYER(BS("Du gehst zur Schranktuer hin, ziehst am Knauf und "
                    "versuchst die Tuer zu oeffnen, doch es tut sich nichts. "
                    "Du ruettelst ganz kraeftig, aber die Tuer geht einfach "
                    "nicht auf. Leicht veraergert laesst Du es dann doch "
                    "bleiben."));
      TELLOTHERS(BS(CTPN+" ruettelt wie "+
                    (TP->QueryProp(P_GENDER)==MALE?"ein Irrer":"eine Irre")+
                    " an der Schranktuer."));
      FMASTER->Msg(TPUID+" versucht den Schrank im Schlafzimmer zu oeffnen");
    }
    return 1;
  }

  if(str == "schublade" || str == "schubladen")
  {
    TELLPLAYER(BS("Welche Schublade moechtest Du denn oeffnen? Die obere, "
                  "untere oder mittlere Schublade?"));
    TELLOTHERS(CTPN+" steht ziemlich ratlos vor der Kommode.\n");
    FMASTER->Msg(TPUID+" versucht alle Schubladen gleichzeitig zu oeffnen");
    return 1;
  }

  if(str == "obere schublade")
  {
    if(!MouseTrap(T_OBERELADE,
      "Du oeffnest die oberste Schublade, in welcher sich eine Mausefalle "
      "befindet. "))
    {
      TELLPLAYER(BS("Du oeffnest die oberste Schublade, aber es ist nichts "
                    "drin. Schade."));
      TELLOTHERS(CTPN+" steht ziemlich ratlos vor der Kommode.\n");
    }
    FMASTER->Msg(TPUID+" oeffnet die obere Schublade im Schlafzimmer");
    return 1;
  }

  if(str == "mittlere schublade")
  {
    if(!MouseTrap(T_MITTLERELADE,
      "Du oeffnest die mittlere Schublade, in welcher sich eine Mausefalle "
      "befindet. "))
    {
      TELLPLAYER(BS("Du oeffnest die mittlere Schublade, aber es ist nichts "
                    "drin. Schade."));
      TELLOTHERS(CTPN+" steht ziemlich ratlos vor der Kommode.\n");
    }
    FMASTER->Msg(TPUID+" oeffnet die mittlere Schublade im Schlafzimmer");
    return 1;
  }

  if(str == "untere schublade")
  {
    if(!MouseTrap(T_UNTERELADE,
      "Du oeffnest die untere Schublade, in welcher sich eine Mausefalle "
      "befindet. "))
    {
      TELLPLAYER(BS("Du oeffnest die untere Schublade, aber es ist nichts "
                    "drin. Schade."));
      TELLOTHERS(CTPN+" steht ziemlich ratlos vor der Kommode.\n");
    }
    FMASTER->Msg(TPUID+" oeffnet die untere Schublade im Schlafzimmer");
    return 1;
  }

  return 0;
}

int cmd_loesen(string str)
{
  notify_fail("Willst Du ein Raetsel loesen oder doch etwas anderes?\n");

  if(!str || str == "") return 0;

  if ( str == "raetsel" )
  {
    TELLPLAYER(BS("Jetzt hast Du aber Glueck gehabt, denn derzeit gibt es "
                  "keine Raetsel fuer Dich zu loesen. Ist wahrscheinlich "
                  "besser so, denn ich wage zu bezweifeln, dass Du eines "
                  "loesen kannst."
    ));
    FMASTER->Msg(TPUID+" versucht ein Raetsel zu loesen");
    return 1;
  }

  if ( -1 != member(({"kordel","samttuecher","samttuch","tuecher",
          "samttuecher von kordel","samttuch von kordel",
          "tuecher von kordel"}),str))
  {
    TELLPLAYER(BS("Voller Elan machst Du Dich an der Kordel zu schaffen, "
                  "doch leider durchschaust Du das System nicht, wie die "
                  "Vorhaenge damit befestigt wurden. Ein wenig enttaeuscht "
                  "laesst Du den Kopf kurz haengen."
    ));
    TELLOTHERS(BS(CAP(TPN)+" laesst den Kopf kurz haengen, weil etwas nicht "
                "gelungen ist."
    ));
    FMASTER->Msg(TPUID+" versucht die Kordel im Schlafzimmer zu loesen");
    return 1;
  }

  return 0;
}

int cmd_schwaermen(string str)
{
  TELLPLAYER(BS("Du faellst kurz in einen Tagtraum. Du denkst daran, wie es "
                "sein koennte, mit Deiner grossen Liebe hier im Bett unter "
                "der Decke zu verschwinden und lauter schoene Sachen zu "
                "machen, doch genau in dem Moment setzt sich ein Vogel auf "
                "den Fenstersims und weckt Dich mit seinem Gezwitscher."
  ));
  FMASTER->Msg(TPUID+" schwaermt im Schlafzimmer");
  return 1;
}

int cmd_greifen(string str)
{
  notify_fail("Wo hinein moechtest Du greifen ?\n");

  if(!str || str == "") return 0;

  if(!(str == "nachtkaestchen"         ||
       str == "kaestchen"              ||
       str == "in nachtkaestchen"      ||
       str == "in kaestchen"           ||
       str == "unter kaestchen"        ||
       str == "unter nachtkaestchen"   )) return 0;

  if(!MouseTrap(T_IMNACHTKAESTCHEN,
    "Du greifst in das Nachtkaestchen hinein und tastest mit Deinen Fingern "
    "darin herum. Schaemst Du Dich denn gar nicht? Doch bevor Du Dich so "
    "richtig schaemen kannst, fuehlst Du etwas und ergreifst es. *Schnapp* "
    "und schon klemmt eine Mausefalle an deinen Fingern, die Du sogleich "
    "wieder abnimmst. "))
  {
    TELLPLAYER(BS("Du greifst in das Nachtkaestchen hinein und tastest mit "
                  "Fingern darin herum. Schaemst Du Dich denn gar nicht? "
                  "Letztendlich findest Du aber nichts."));
    FMASTER->Msg(TPUID+" greift in das Nachtkaestchen");
  }

  return 1;
}

int cmd_schauen(string str)
{
  notify_fail("Wo moechtest Du schauen ?\n");

  if(!str || str == "") return 0;

  if(!(str == "unter bett" ||
       str == "unter bett" )) return 0;

  if(!MouseTrap(T_UNTERBETT,"Du hebst die Decke hoch und schaust unter "
                            "das Bett. Da steht doch tatsaechlich eine "
                            "Mausefalle. "))
  {
    TELLPLAYER("Nichts. Noch nicht einmal Staub.\n");
  }
  FMASTER->Msg(TPUID+" schaut unter das Bett im Schlafzimmer");
  return 1;
}

int cmd_klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "bett"           ||
       str == "in bett"        ||
       str == "bett hinein"    ||
       str == "in bett hinein" )) return 0;

  if(!RINGMASTER->QueryWasinBed(getuuid(TP)))
  {
    TELLPLAYER(BS("Du ueberlegst kurz, laesst es dann aber doch bleiben. Du "
                  "willst Abenteuer erleben und nicht in fremder Leute "
                  "Betten herumlungern."));
    return -1;
  }

  TP->move(ROOM +  "bett:" + getuid(TP) ,M_GO,
           "in das Bett","krabbelt","kommt hereingekrochen");

  return 1;
}


