  );

  AddDetail( ({"bienenwachs","wachs"}),
    "Die Kerze wurde aus Bienenwachs gefertigt."
  );

  AddDetail( ({"keramikteller","teller","zweck"}),
    "Ein schlichter Teller aus Keramik, der nur einen Zweck hat, naemlich zu "
