  );

//Decke
  AddDetail( ({"decke"}),
    "Willst Du Dir die Bettdecke oder die Zimmerdecke ansehen?"
  );

  AddDetail( ({"zimmerdecke"}),
    "Dir stockt der Atem! So eine Decke hast Du noch nie gesehen. Obwohl die "
