  AddSpecialDetail( ({"fenstersims","sims"}), "detail_fenstersims");

  AddDetail( ({"oeffnungen","oeffnung","fensteroeffnung","fensteroeffnungen"}),
    "Die Oeffnungen sind beide schlicht, aber formgenau aus der Wand "
