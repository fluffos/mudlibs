  );

  AddDetail( ({"segeln","segel","schiff","schiffe"}),
    "Weder Segel noch Schiffe sind hier zu sehen. Da faellt Dir ein, dass Du "
    "schon lange nicht mehr segeln warst. Wird doch endlich wieder Zeit fuer "
