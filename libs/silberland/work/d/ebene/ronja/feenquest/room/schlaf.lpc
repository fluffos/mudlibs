#include "../def.h"

inherit "/std/room";

#include <wizlevels.h>

#define P_VERSTECK "versteck"
#define T_UNTERBETT "unterbett"
#define T_OBERELADE "oberelade"
#define T_MITTLERELADE "mittlerelade"
#define T_UNTERELADE "unterelade"
#define T_AUFDEMSCHRANK "aufdemschrank"
#define T_IMNACHTKAESTCHEN "imnachtkaestchen"
#define T_FENSTERSIMS "aufdemfenstersims"

nosave int    anzahl_bonbons;
nosave int    anzahl_verstecke;
nosave string *verstecke;

string location;

void create()
{
  ::create();

  verstecke =
  ({
    T_UNTERBETT
   ,T_OBERELADE
   ,T_MITTLERELADE
   ,T_UNTERELADE
   ,T_AUFDEMSCHRANK
   ,T_IMNACHTKAESTCHEN
   });

  anzahl_verstecke = sizeof(verstecke);

  SetProp(P_INT_SHORT, "Ein Schlafzimmer");
  SetProp(P_INT_LONG,
    "Das ist das Schlafzimmer einer Fee. Eines ist auf den ersten Blick "
    "klar. An Geld scheint es den Feen nicht zu mangeln. An der Suedwand "
    "steht ein riesiges Himmelbett, von dem Du bisher nur getraeumt hast "
    "und daneben ein kleines Nachtkaestchen. Links und rechts vom Bett "
    "sind zwei Fenster, durch die Licht in das Schlafzimmer dringt. An "
    "der Westwand befindet sich ein langer, grosser Schrank und in einem "
    "Eck steht noch eine fast unscheinbare Kommode. Du denkst Dir nur: "
    "In so einem Zimmer koennte ich leben."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16]));

  location = verstecke[random(anzahl_verstecke)];
  restore_object(ROOM "schlaf");
  SetProp(P_VERSTECK, location);
  save_object(ROOM "schlaf");

  AddDetail("blick",
    "Schon ein einziger Blick hier reicht Dir, um Dir zu sagen, dass die "
    "Feen sicher nicht arm sind."
  );

  AddDetail( ({"schloesser","schloss","schloessern"}),
    "Wie Du sicher bemerkt haben wirst, stehst Du in einem Schloss. Wenn Du "
    "es Dir genau ueberlegst, ist es sicher das schoenste im Silberland."
  );

  AddDetail( ({"silberland"}),
    "Das Silberland ist fuer alle da."
  );

  AddDetail( ({"schlafzimmer", "zimmer", "raum"}),
    "Oh ja! Ein prachtvolles Zimmer. Du koenntest direkt ins Schwaermen "
