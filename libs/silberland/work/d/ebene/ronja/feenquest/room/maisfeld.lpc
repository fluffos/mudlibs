#include "../def.h"

inherit "std/room";

#include "/gilden/nekromanten/nekro_properties.h"

#define ELEMENTAL_OWNER "e_owner"
#define DRUIDENELEMENTAR "\nd_elementar"

mapping richtungen;

void initdir();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Maisfeld");
  SetProp(P_INT_LONG,
    "Du befindest Dich mitten in einem Maisfeld. Hoch wachsen die Pflanzen "
    "zu allen Seiten empor. Pflanzen, nichts als Pflanzen. Selbst der "
    "Himmel schimmert nur ab und an durch die Pflanzen durch. Einen Weg "
    "siehst Du natuerlich auch nicht, den musst Du Dir schon bahnen. "
    "Hoffentlich findest Du hier auch wieder raus."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_OUT);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));

  AddDetail( ({"weg"}) ,
    "Einen Weg kannst Du nicht erkennen. Du befindest Dich mitten in einem "
    "Maisfeld, da gibt es keine Wege. "
  );

  AddDetail( ({"seiten"}) ,
    "Rings um Dich sind nur Maispflanzen. So weit das Auge sieht. Was "
    "allerdings nicht sehr weit ist, denn die Maispflanzen stehen dicht "
    "an dicht. "
  );

  AddDetail( ({"maispflanze","maispflanzen","pflanze","pflanzen"}) ,
    "Die Maispflanzen stehen dicht an dicht und Du kannst nicht mehr "
    "erkennen wo Du ueberhaupt bist. Alles um Dich herum ist nur noch "
    "gruen. Man koennte auch sagen, die Farbe gruen beherrscht hier alles. "
  );

  AddDetail( ({"farbe"}) ,
    "Hauptsaechlich wird das Maisfeld von der Farbe gruen beherrscht. "
    "Dazwischen leuchtet immer mal wieder das Gelb der Blueten hindurch. "
  );

  AddDetail( ({"blueten","bluete"}) ,
    "Das Maisfeld steht in voller Bluete, aber es wird wohl noch etwas "
    "dauern, bis der Mais geerntet werden kann. "
  );

  AddDetail( ({"gelb"}) ,
    "Die Blueten der Maispflanzen sind leuchtend gelb."
  );

  AddDetail( ({"maisfeld","feld"}) ,
    "Du stehst mittendrin. Obwohl - ob Du nun mittendrin stehst oder mehr "
    "am Rand kann man eigentlich gar nicht sagen, denn Du hast keine "
    "Ahnung wo genau Du Dich im Maisfeld befindest. Na, hoffentlich "
    "findest Du auch wieder hinaus. "
  );

  AddDetail( ({"ahnung"}) ,
    "Eine Ahnung waere jetzt nuetzlich, wie Du hier wieder herausfindest. "
  );

  AddDetail( ({"rand"}) ,
    "Ob Du nun am Rand des Maisfeldes stehst oder mittendrin kannst Du gar "
    "nicht sagen, denn es gibt nirgends einen Hinweis darauf. "
  );

  AddDetail( ({"hinweis"}) ,
    "Nirgends ist der kleinste Hinweis, wo es hier wieder raus geht."
  );

  AddDetail( ({"himmel"}) ,
    "Den Himmel kannst Du gerade noch so eben erkennen. Die Blaetter der "
    "Maispflanzen nehmen Dir auch nach oben die Sicht. "
  );

  AddDetail( ({"sicht"}) ,
    "Von einer Sicht zu sprechen waere zuviel gesagt, denn direkt vor Dir "
    "(eigentlich rund um Dich) steht ein regelrechter Wald aus "
    "Maispflanzen. Undurchdringlich und dicht an dicht stehen die Pflanzen. "
  );

  AddDetail( ({"wald"}) ,
    "Beinahe kann man hier von einem Wald aus Maispflanzen sprechen. Dicht "
    "an dicht stehen die Pflanzen, so dass man nicht erkennen kann, wo das "
    "Maisfeld aufhoert oder anfaengt. Auch der Himmel gibt Dir keinen "
    "Anhaltspunkt wo exakt Du Dich befindest."
  );

  AddDetail( ({"anhaltspunkt","punkt"}) ,
    "Nichts hilft Dir hier auch nur ansatzweise, wie Du Dich in diesem "
    "Dickicht zurecht finden koenntest. "
  );

  AddDetail( ({"dickicht"}) ,
    "Die Maispflanzen stehen dicht an dicht. Wenn der Mais mal reif ist, "
    "gibt das eine prima Ernte. Aber bis zur Ernte vergeht wohl noch etwas "
    "Zeit, bis dahin wirst Du ja wohl hier herausgefunden haben. "
  );

  AddDetail( ({"mais"}) ,
    "Noch ist der Mais nicht reif. Hochgeschossen und in voller Bluete "
    "stehen die Maispflanzen dichtan ... aehm aber das weisst Du ja schon, "
    "dass die dicht an dicht stehen, oder? "
  );

  AddDetail( ({"zeit"}) ,
    "Bis zur Ernte ist noch etwas Zeit. Spaetestens wenn das Maisfeld "
    "abgeerntet wird, wirst Du wohl hier rausfinden. Aber wer weiss, wie "
    "lange das noch dauert. Warte lieber nicht darauf. "
  );

  AddDetail( ({"ernte"}) ,
    "So weit ist es noch lange nicht. Bis dahin muessen sich aus den "
    "Blueten erst einmal Maiskolben bilden. Das kann noch etwas dauern. "
  );

  AddDetail( ({"maiskolben","kolben"}) ,
    "Du kannst keine Maiskolben entdecken, denn der Mais steht erst in "
    "voller Bluete und die Maiskolben muessen erst noch wachsen. "
    "Vielleicht findest Du ja woanders einen Maiskolben?"
  );

  AddDetail( ({"boden"}) ,
    "Auf dem Boden siehst du eine Menge abgestorbener Pflanzenteile. Den "
    "Boden selbst kannst Du nicht erkennen. Dazu muesstest Du erst die "
    "ganzen Blaetter beiseite raeumen. "
  );

  AddDetail( ({"pflanzenteile","teile"}) ,
    "Alte Blaetter, Stengel, Verbluehtes, vertrocknete Maiskolben. Lauter "
    "unnuetzes Zeug. "
  );

  AddDetail( ({"zeug","stengel"}) ,
    "Das ganze Zeug welches am Boden herumliegt ist ziemlich nutzlos. "
  );

  AddDetail( ({"verbluehtes"}) ,
    "Das wuerdest Du noch nicht mal Deinem aergsten Feind schenken. "
  );

  AddDetail( ({"feind"}) ,
    "Zum Glueck ist keiner da."
  );

  AddDetail( ({"glueck"}) ,
    "In dem ganzen Uebel, hier im Maisfeld herumzutrapsen hast Du "
    "wenigstens das Glueck, dass Deine Feinde nicht da sind. "
  );

  AddDetail( ({"uebel"}) ,
    "Ja das Maisfeld ist ganz schoen uebel, nicht wahr?"
  );

  AddDetail( ({"stengel"}) ,
    "Die abgestorbenen Stengel sind schon voellig morsch, mit denen kann "
    "man noch nicht mal mehr richtig kaempfen. "
  );

  AddDetail( ({"menge"}) ,
    "Es liegen sehr viele Pflanzenteile auf dem Boden. "
  );

  AddDetail( ({"auge"}) ,
    "Zum Glueck sind Deine Augen noch da, sonst koenntest Du doch gar "
    "nichts sehen. "
  );

  AddDetail( ({"blatt","blaetter"}) ,
    "Auf dem Boden liegen viele Blaetter, von aelteren, die schon in Humus "
    "uebergehen bis zu ganz jungen Blaettern, die wohl grade erst vorhin "
    "abgefallen sind, ist alles dabei. Das lohnt wohl kaum, darin zu "
    "wuehlen. "
  );

  AddDetail( ({"humus"}) ,
    "Die unteren Blaetter nahe dem Erdboden sind schon fast zu Humus "
    "zerfallen. "
  );

  AddDetail( ({"erdboden","erde"}) ,
    "Der Erdboden ist vollstaendig mit Blaettern bedeckt, so dass man ihn "
    "gar nicht erkennen kann. "
  );

  AddDetail( ({"glueck"}) ,
    "Vielleicht hast du ja Glueck und der naechste Schritt fuehrt Dich aus "
    "diesem Maisfeld heraus? "
  );

  AddDetail( ({"schritt"}) ,
    "Wieviele Schritte werden es wohl bis zum Ausgang sein ?"
  );

  AddDetail( ({"ausgang"}) ,
    "Statt eines Ausgangs siehst Du nur Maispflanzen, Maispflanzen und "
    "nochmals Maispflanzen. Es ist zum verzweifeln. "
  );

  AddSpecialExit( ({"norden"
                   ,"nordosten"
                   ,"osten"
                   ,"suedosten"
                   ,"sueden"
                   ,"suedwesten"
                   ,"westen"
                   ,"nordwesten"
                   }) , "exitfunc" );

  AddSpecialExit( "raus", "exit_raus" );
  SetProp(P_HIDE_EXITS, ({"raus"}) );

  AddCmd( ({"bahn","bahne"})      , "cmd_bahnen");
  AddCmd( CMD_NEHMEN              , "cmd_nehmen");
  AddCmd( ({"raeum","raeume"})    , "cmd_raeumen");

  previous_object()->CustomizeObject();

  initdir();
}

mapping QueryDir()
{
  return richtungen;
}

void initdir()
{
  richtungen = (["norden":     0
                ,"nordosten":  0
                ,"osten":      0
                ,"suedosten":  0
                ,"sueden":     0
                ,"suedwesten": 0
                ,"westen":     0
                ,"nordwesten": 0
                ,"bahne":      0
                ]);
}

int removeable(object ob)
{
  if(ob->id(NEKRO_EYE_NPC)) return 1;

  if(ob->id(DRUIDENELEMENTAR) && ob->QueryProp(ELEMENTAL_OWNER) == 0)
                            return 1;

  if(living(ob))            return 0;
  if(interactive(ob))       return 0;

  return 1;
}

void cleanup()
{
  int i;
  object *ob;

  ob = filter_array(all_inventory(TO), "removeable");
  i = sizeof(ob);
  while(i--){ ob[i]->remove(); }
}

int exit_raus(string dir)
{
  cleanup();
//initdir();

  if(dir == "raus")
  {
    dir = (random(10) < 5) ? "koppel1" : "koppel2";
  }

  RINGMASTER->Msg(TPUID+" muss das Maisfeld verlassen");
  return TP->move(ROOM+dir,M_GO,0,"verschwindet im Maisfeld",
                  "kommt aus dem Maisfeld herausgestapft");
}

int exitfunc(string dir)
{
  int i,n;
  string *keys;

  cleanup();

  if(member(richtungen, dir)) richtungen[dir] = richtungen[dir]+1;

  keys = m_indices(richtungen);
  i = sizeof(keys);
  n = 0;
  while(i--)
  {
    if(richtungen[keys[i]] > 3) n++;
//    TELLPLAYER(sprintf("%s %d \n",keys[i],richtungen[keys[i]]));
  }
//  TELLPLAYER(sprintf("n = %d \n",n));

  if(n==5)
  {
    initdir();
    TP->move(ROOM+"maislichtung:"+getuid(this_player()), M_GO,
                  "im Maisfeld","verschwindet","");
    RINGMASTER->Msg(TPUID+" findet die Maislichtung");
    return 1;
  }

  switch(random(100))
  {
    case 97..99:
      return exit_raus("koppel1");
      break;

    case 94..96:
      return exit_raus("koppel2");
      break;

    default :
      return TP->move(TO,M_GO);
      break;
  }

  return 1;
}

int cmd_bahnen(string str)
{
  string r;

  notify_fail("Was moechtest Du Dir bahnen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "weg"  )) return 0;

  r = ({"norden","osten","sueden","westen"})[random(4)];

  richtungen["bahne"]++;
  if((richtungen["bahne"] > 20) && ((richtungen["bahne"] % 5) == 0))
  {
    TELLPLAYER(BS("Du bahnst Dir einen Weg nach "+CAP(r)+", aber irgendwie "
                  "hast Du den Eindruck, als wuerdest Du nur im Kreis "
                  "laufen."));
  }
  else
  {
    TELLPLAYER("Du bahnst Dir einen Weg nach "+CAP(r)+".\n");
  }

  exitfunc("null");

  return 1;
}

int cmd_nehmen(string str)
{
  notify_fail("Was moechtest Du nehmen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "blaetter"         ||
       str == "stengel"          ||
       str == "verbluehtes"      ||
       str == "maiskolben"       )) return 0;


  TELLPLAYER(BS("Das ist voellig nutzlos, daher entscheidest Du Dich, es "
             "doch liegen zu lassen."));
  TELLOTHERS(BS(CAP(TPN)+"hebt etwas vom Boden auf, laesst es dann aber"
                "doch wieder fallen."));
  return 1;
}

int cmd_raeumen(string str)
{
  notify_fail("Was moechtest Du beiseite raeumen?\n");

  if(!str || str == "") return 0;
  if(!(str == "blaetter weg"         ||
       str == "blaetter beiseite"         )) return 0;

  TELLPLAYER(BS("Du raeumst ein paar Blaetter beiseite, kannst den Boden "
                "aber noch immer nicht erkennen. Es ist ein aussichtsloses "
                "Unterfangen!"));

  return 1;
}


