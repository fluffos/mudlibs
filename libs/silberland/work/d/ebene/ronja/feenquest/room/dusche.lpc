#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Der Duschraum der Fee");
  SetProp(P_INT_LONG,
     "Dies ist der Duschraum der Feen. "
     "Viele Tuben und Dosen befinden sich im Raum. Auch eine Dusche steht "
     "in einer Ecke. Ueber dem Waschbecken kannst Du einen Spiegel erkennen. "
     "Die Badematte am Boden ist feucht, wahrscheinlich "
     "wurde hier vor kurzem gerade geduscht."
  );

  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:26]));

  AddDetail( ({ "pflege", "koerperpflege", "arbeit" }),
    "Ein grosser Teil des Tages der Feen dient dieser Arbeit."
  );

  AddDetail( ({"teil"}) ,
    "Meistens morgens, mittags und abends."
  );

  AddDetail( ({"tag","nacht"}) ,
    "Nachts schlafen die Feen, da haben sie keine Zeit zur Koerperpflege."
  );

  AddDetail( ({ "fee" }),
    "Es ist gerade keine da."
  );

  AddDetail( ({ "matte", "badematte" }),
    "Sie verziert den Boden."
  );

  AddDetail( ({ "becken", "waschbecken" }),
    "Es dient der kleinen Koerperpflege der Feen."
  );

  AddDetail( ({ "eck","ecke","ecken" }),
    "Vier an ihrer Zahl pro Zimmer."
  );

  AddDetail( ({"zahl", "vier"}),
    "Die Zahl der Ecken ist vier."
  );

  AddDetail( ({ "sterblichen" }),
    "Sie leben wie die Goetter."
  );

  AddDetail( ({ "dosen" }),
    "Sie sind weiss und enthalten eine gutriechende Creme."
  );

  AddDetail( ({"creme"}) ,
    "Die wuerde bei Dir eh nichts mehr nuetzen."
  );

  AddDetail( ({"tuben"}),
    "Vermutlich enthalten sie auch eine Creme."
  );

  AddDetail( ({"dusche"}),
    "Die Dusche steht im Eck. Wenn Du schmutzig bist, koenntest Du Dich ja "
    "vielleicht hier duschen."
  );

  AddDetail( ({ "raum", "duschraum", "zimmer" }),
    "Du befindest Dich mittendrin."
  );

  AddDetail( "spiegel",
    "Der wunderschoene Spiegel besteht aus poliertem Silber und hat einen "
    "Rahmen aus Elfenbein. Vielleicht kann man hineinschauen."
  );

  AddDetail( ({"silber"}),
    "Das Silber des Spiegels wurde so lange poliert, dass man sich darin "
    "spiegeln kann."
  );

  AddDetail( ({"rahmen"}),
    "Der Rahmen des Spiegels besteht aus Elfenbein."
  );

  AddDetail( ({"elfenbein"}),
    "Es stammt wohl von dem Elefantenfriedhof. Sicherlich wurde kein "
    "Elefant extra dafuer getoetet."
  );

  AddDetail( ({"elefantenfriedhof"}) ,
    "Der soll sich angeblich weit im Osten befinden."
  );

  AddDetail( ({"elefanten","elefant"}) ,
    "Grosse, graue Tiere. Schau sie Dir halt mal an."
  );

  AddDetail( ({"tiere","tierchen"}) ,
    "Die Feen sind reinlich, in dem Duschraum gibt es weder Tiere noch "
    "Tierchen."
  );

  AddDetail( ({"osten"}) ,
    "Osten ist gegenueber von Westen."
  );

  AddDetail( ({"westen"}) ,
    "Westen ist gegenueber von Osten."
  );

  AddDetail( ({ "boden", "fussboden" }),
    "Der Fussboden ist nass. Vermutlich hat gerade Jemand geduscht."
  );

  AddDetail( ({"jemand"}),
    "Wer das wohl war?"
  );

  AddDetail( ({ "wand", "waende" }),
    "An den Waenden befindet sich schoene Fliesen."
  );

  AddDetail( ({ "fliesen" }),
    "Sie schuetzen die Waende vor Wasser und Feuchtigkeit."
  );

  AddDetail( ({"wasser","feuchtigkeit"}) ,
    "Davon gibt es in einem Duschraum ausreichend."
  );

  AddDetail( ({"decke"}),
    "An der Decke befindet sich ein Glaskolben, der Licht spendet.");

  AddDetail( ({"licht"}) ,
    "Ohne Licht ist es dunkel."
  );

  AddDetail( ({"glaskolben","kolben"}) ,
    "Er haengt weit ueber Dir. Es duerfte sich um denselben Glaskolben "
    "handeln, wie er auch sonst im Schloss zu finden ist."
  );

  AddDetail( ({"schloss","feenschloss"}) ,
    "Du befindest Dich mittendrin."
  );

  AddCmd( ({"schaue", "schau"}), "cmd_schauen");
  AddCmd( ({"dusch", "dusche"}), "cmd_duschen");

  AddExit("westen", ROOM "schlaf.lpc");

  AddItem(NPC "fee.lpc", REFRESH_DESTRUCT);
}

void entferne_flaffe(object flaffe)
{
  tell_room(TO,BS("Der Flaffe laeuft blau an als ob er keine Luft mehr "
                  "bekommt! Kurz bevor er krepiert haucht er noch \"Dante "
                  "ist ein Arschloch!\" und verpufft dann in einer weissen "
                  "Wolke, aus der ein paar Schmetterlinge in alle Richtungen "
                  "davonfliegen."));

  destruct(flaffe);
}

void init()
{
  ::init();

  if(TP->id("flaffe"))
    call_out("entferne_flaffe",0,TP);

}

int cmd_schauen(string str)
{
  notify_fail("Wo willst Du hineinschauen?\n");

  if(!str || str == "") return 0;
  if(!(str == "spiegel"               ||
       str == "in spiegel"            ||
       str == "in den spiegel"        ||
       str == "in spiegel hinein"     ||
       str == "in den spiegel hinein" )) return 0;

  TELLPLAYER("Du siehst in den Spiegel und findest Dich wunderschoen.\n");
  TELLOTHERS(TPN+" ist ganz schoen eitel.\n");
  FMASTER->Msg(TPUID+" schaut in den Spiegel");
  return 1;
}

int cmd_duschen(string str)
{
  TELLPLAYER(BS("Du stellst Dich unter die Dusche und wirst endlich "
                "wieder mal ganz sauber."));
  TELLOTHERS(TPN+" duscht sich.\n");
  FMASTER->Msg(TPUID+" duscht sich");

  return 1;
}


