#include "../def.h"

inherit "std/room";

int feenkraut;
int oeffnen(string str);
int uhr_lesen(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Festsaal");
  SetProp(P_INT_LONG,
    "Du stehst im Festsaal. Im Norden siehst Du einen riesigen "
    "Spiegel. Mitten im Raum steht eine grosse Festtafel. An "
    "jeder Seite der Tafel stehen 12 Stuehle, an der Stirnseite "
    "je einer, so dass 26 Gaeste an der Tafel Platz nehmen koennen. "
    "An der Westwand steht ein grosser Schrank, an der Ostwand "
    "eine schoene alte Uhr."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:22]));

  AddDetail( ({"festsaal","ballsaal","saal","raum"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"stuhl","stuehle","tisch","tafel","festtafel"}) ,
    "An der Festtafel wuerdest Du zu gerne auch mal sitzen und mitfeiern "
    "und feine Koestlichkeiten serviert bekommen. Leider hast Du noch nie "
    "eine Einladung bekommen. "
  );

  AddDetail( ({"platz"}) ,
    "Die Festtafel bietet Platz fuer 26 Gaeste."
  );

  AddDetail( ({"einladung"}) ,
    "Vergiss es. Du wirst nie eine bekommen. "
  );

  AddDetail( ({"koestlichkeit","koestlichkeiten"}) ,
    "Davon kannst Du nur traeumen. "
  );

  AddDetail( ({"eck","ecke"}),
    "In der Ecke steht eine schoene alte Uhr.");

  AddDetail( "uhr",
    "Sie ist alt und weist schon viele Flecken auf. Aber gerade das macht "
    "ihren Reiz aus. Sie ist ein Meisterwerk der Uhrmacherkunst und zeigt "
    "immer noch die Uhrzeit auf die Minute korrekt an. Du koenntest sie ja "
    "mal ablesen."
  );

  AddDetail( "meisterwerk",
    "Die Uhr ist ein Meisterwerk der Uhrmacherkunst und zeigt immer noch "
    "die Uhrzeit auf die Minute korrekt an. Du koenntest sie ja mal ablesen."
  );

  AddDetail( ({"reiz","sachen","alte sachen"}) ,
    "Auch alte Sachen haben ihren Reiz."
  );

  AddDetail( ({"fleck","flecken"}) ,
    "Mit der Zeit hat die Uhr einige Flecken abbekommen."
  );

  AddDetail( ({"schrank","wandschrank"}),
    "Er sieht massiv aus. Vielleicht kannst Du ihn oeffnen ? "
  );

  AddDetail( ({"fest", "feste" }),
    "Rauschende Feste werden hier gefeiert, aber nur die Feen haben Zugang."
  );

  AddDetail( ({"fee", "feen"}),
    "Den Feen gehoert dieses Schloss."
  );

  AddDetail( ({"boden"}),
    "Ein herrliches Parkett. Hier werden nach dem Fest wohl die "
    "wunderschoenen Taenze aufgefuehrt. Ein solch ungehobelter Klotz wie "
    "Du muesste natuerlich erst mal Tanzstunden nehmen."
  );

  AddDetail( ({"klotz"}) ,
    "Schau doch bloss, wie Du aussiehst !"
  );

  AddDetail( ({"wand","waende","atmosphaere","tapete"}) ,
    "Die Wand ist tapeziert und verleiht dem Raum eine gewissen festliche "
    "Atmosphaere."
  );

  AddDetail( ({"decke", "eichendecke","balken"}),
    "Ehrfuerchtig schaust Du nach oben, und erblickst eine alte Eichendecke. "
    "Diese Balken muessen schon sehr alt sein. "
  );

  AddDetail( ({"ostwand"}) ,
    "An der Ostwand steht eine schoene alte Uhr."
  );

  AddDetail( ({"westwand"}) ,
    "An der Westwand steht ein grosser Schrank."
  );

  AddDetail( ({"uhrzeit","zeit"}) ,
    "Lies doch einfach die Uhr ab."
  );

  AddDetail( ({"uhrmacherkunst"}) ,
    "Du entdeckst keine Anzeichen, wer diese Uhr hergestellt haben koennte."
  );

  AddDetail( ({"anzeichen"}) ,
    "Du erkennst wirklich keine. Aber Du bist ja auch kein Uhrmacher. "
  );

  AddDetail( ({"tanzstunden"}) ,
    "Ob das bei Dir Sinn machen wuerde ?"
  );

  AddDetail( ({"sinn","unsinn"}) ,
    "Untersuch nicht solchen Unsinn."
  );

  AddDetail( ({"tanz","taenze","tanzen"}) ,
    "Da Du ja nichts von Tanzen verstehst, weisst Du auch nicht, wie man "
    "die Taenze nennt."
  );

  AddDetail( ({"tack"}) ,
    "Tack kommt nach Tick, wenn die Uhr Tick Tack macht."
  );

  AddDetail( ({"tick"}) ,
    "Tick kommt vor Tack, wenn die Uhr Tick Tack macht."
  );

  AddDetail( ({"stirnseite","stirnseiten"}) ,
    "An den Stirnseiten des Tisches steht je ein Stuhl."
  );

  AddDetail( ({"seite","seiten"}) ,
    "An den Seiten des Tisches stehen Stuehle."
  );

  AddDetail( ({"spiegel"}) ,
    "Der Spiegel ist riesengross. Du hast den Eindruck, dass der Saal "
    "dadurch doppelt so gross wie in Wirklichkeit ist."
  );

  AddDetail( ({"eindruck"}) ,
    "Du hast den Eindruck, dass der Saal dadurch doppelt "
    "so gross wie in Wirklichkeit ist."
  );

  AddDetail( ({"wirklichkeit"}) ,
    "Ist das hier die Wirklichkeit - oder etwa nicht ? Oder wie ?"
  );


  AddDetail( ({"parkett"}) ,
    "Das Parkett ist aus einem edlen Holz gefertigt. Vermutlich ist es "
    "Tic-Toc Holz."
  );

  AddDetail( ({"tic","toc","tic-toc","tic-toc holz"}) ,
    "Darauf kann man gut tanzen. Natuerlich nur, wenn mann tanzen kann."
  );

  AddDetail( ({"holz","baum","baeume","baeumen"}) ,
    "Holz von Baeumen, was dachtest Du denn ?"
  );

  AddDetail( ({"minute","minuten","sekunde","sekunden"}) ,
    "Eine Minute hat 60 Sekunden."
  );

  AddDetail( ({"gaeste"}) ,
    "Momentan sind keine da."
  );

  AddDetail( ({"porzellan", "tischdecken", "damasttischdecken", "silber",
               "tafelsilber"}) ,
    "Hier siehst Du nichts davon, aber im Schrank befindet sich vielleicht "
    "das eine oder andere."
  );

  AddSound(DEFAULT_SOUND,
    "Du hoerst leise eine Uhr ticken.\n"
  );

  AddSound( ({"uhr"}),
    "Tick Tack."
  );

  AddCmd( ({"traeume","traeum"})   , "cmd_traeumen");
  AddCmd( ({"oeffne"})             , "cmd_oeffnen");
  AddCmd( ({"lies","les","lese"})  , "cmd_uhr_lesen");
  AddCmd( ({"klopf","klopfe"})     , "cmd_klopfen");

  AddExit("sueden", ROOM "sgang07.lpc");

  feenkraut = 0;
}

void reset()
{
  ::reset();

  feenkraut = 0;
}

int cmd_traeumen(string str)
{
  object eis;

  if((random(3)==0) && (!deep_present("solero", TP)))
  {
    TELLPLAYER(BS("Ronja hat Mitleid mit Dir und steckt Dir heimlich "
                  "etwas zu."));

    eis = clone_object(OBJ "solero.lpc");
    eis->move(TP, M_GET|M_SILENT);
    FMASTER->Msg(TPUID+" bekommt ein Solero");
  }
  else
  {
    TELLPLAYER(BS("Du traeumst etwas herum, besinnst Dich dann aber doch "
                  "darauf, dass Du ja eigentlich Abenteuer bestehen willst."
    ));
  }
  return 1;
}

int cmd_oeffnen(string str)
{
  string sp, so, msg;
  int ret;

  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schrank"     ||
      str == "wandschrank"  )) return 0;

  ret = -1;
  so  = TPUID+" oeffnet den Schrank";
  msg = so;
  sp  = "Du oeffnest die Schranktuer und siehst feinstes Porzellan und "
        "edles Tafelsilber. ";

  if(feenkraut)
  {
    sp += "Ein Feenkraut faellt aus dem Schrank heraus. ";
    so += " und ein Feenkraut faellt heraus";
    msg = so;
    ret = 1;
    CLONEME(OBJ "feenkraut.lpc");
  }

  sp += "Im unteren Fach liegen noch einige Damasttischdecken. Es befindet "
        "sich nichts im Schrank, was Du gebrauchen koenntest. Enttaeuscht "
        "schliesst Du den Schrank wieder.";

  so += ". Kurz danach schliesst "+TP->name()+" den Schrank wieder.";

  tell_object(TP, BS(sp));
  tell_room(TO, BS(so), ({TP}) );
  FMASTER->Msg(msg);

  feenkraut = 0;
  return ret;
}

int cmd_uhr_lesen(string str)
{
  string zeit;
  string stunde;
  string minute;

  notify_fail("Was willst Du ablesen?\n");

  if(!str || str == "") return 0;
  if(!(str == "uhr ab" ||
       str == "uhr"    )) return 0;

  zeit = dtime(time());
  stunde = zeit[19 .. 20];
  minute = zeit[22 .. 23];
  TELLPLAYER("Es ist jetzt "+stunde+" Uhr und "+minute+" Minuten.\n");
  TELLOTHERS(TPN+" schaut auf die Uhr.\n");
  FMASTER->Msg(TPUID+" liest die Uhr ab");
  return 1;
}

int cmd_klopfen(string str)
{
  notify_fail("Worauf moechtest Du klopfen ?\n");

  if(!str || str =="") return 0;
  if(!(str == "auf holz"            ||
       str == "auf boden"           ||
       str == "auf parkett"         ||
       str == "auf tic-toc holz"    ||
       str == "an holz"             ||
       str == "an tic-toc holz"     )) return 0;

  TELLPLAYER(BS("Du kniest nieder und klopfst auf das Parkett. Tatsaechlich, "
                "es ist wirklich Tic-Toc Holz!"
  ));
  TELLOTHERS(BS(TPN+" rutscht auf den Knieen auf dem Boden herum. Was sucht "+
                TP->QueryPronoun(WER)+" da bloss ?"
  ));
  FMASTER->Msg(TPUID+" klopft auf Holz");

  return 1;
}
