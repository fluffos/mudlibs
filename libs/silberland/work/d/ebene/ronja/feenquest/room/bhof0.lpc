#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Schlosshof");
  SetProp(P_INT_LONG,
    "Du befindest Dich im Schlosshof des Feenschlosses. Er ist sauber bis "
    "in die letzten Ecken, hier muss gerade frisch gekehrt worden sein. In "
    "der Mitte des Schlosshofes siehst Du einen Brunnen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"wand","waende"}) ,
    "Das Feenschloss ist rund um Dich herum."
  );

  AddDetail( ({"himmel"}) ,
    "Der wolkenlose Himmel erstrahlt in einem sagenhaften Blau. Du blinzelst "
    "mit den Augen."
  );

  AddDetail( ({"wolke","wolken"}) ,
    "Wolkenlos heisst OHNE Wolken !"
  );

  AddDetail( ({"sonne","augen"}) ,
    "Du blinzelst. Schau nicht in die Sonne, dass ist nicht gut fuer Deine "
    "Augen."
  );

  AddDetail( ({"blau","stahlblau","himmelblau","himmelsblau"}) ,
    "Der Himmel erstrahlt in einem sagenhaften Blau."
  );

  AddDetail( ({"feenschloss","feenschlosses","schloss","schlosshof","schlosshofes"}) ,
    "Das Schloss ist rund herum um den Schlosshof."
  );

  AddDetail( ({"ecke","ecken"}) ,
    "Der Schlosshof ist bis in die Ecken picco bello sauber. "
  );

  AddDetail( ({ "boden","pflaster" }),
    "Du laeufst auf sauber verlegtem Pflaster. Kein Pflaenzchen wagt sich "
    "zwischen den Fugen hervor."
  );

  AddDetail( ({ "pflaenzchen"}) ,
   "KEIN Pflaenzchen wagt sich zwischen den Fugen hervor."
  );

  AddDetail( ({ "fuge","fugen"}),
    "Das Pflaster ist sauber mit Sand verfugt worden."
  );

  AddDetail( ({"sand"}) ,
    "Der stammt bestimmt von der Felseninsel."
  );

  AddDetail( ({"felseninsel"}) ,
    "Auf der Felseninsel gibt es einen herrlichen Sandstrand. "
  );

  AddDetail( ({"sandstrand"}) ,
    "Am liebsten waerest Du jetzt da und wuerdest in der Sonne faulenzen. "
  );

  AddDetail( ({"mitte"}) ,
    "In der Mitte befindet sich ein Brunnen. "
  );

  AddSound( DEFAULT_SOUND,
    "Es ist erstaunlich still auf dem Schlosshof. "
  );

  AddSound( ({"stille"}) ,
    "Du haelst etwas inne und geniesst die Stille. "
  );

  AddDetail( ({"stille"}) ,
    "Du haelst etwas inne und geniesst die Stille. "
  );

  AddSmell(DEFAULT_SMELL,
    "Im Osten riechst Du etwas von Walpurgis' Kochkuensten."
  );

  AddDetail( ({"walpurgis","kochkunst","kochkuenste","kochkuensten"}) ,
    "Walpurgis bereitet sicher wieder etwas leckeres vor. "
  );

  AddDetail( ({"walpurgis"}) ,
    "Die ist nicht hier."
  );

  AddDetail( ({"etwas"}) ,
    "Du untersuchst etwas, findest es aber langweilig und widmest Dich "
    "wieder dem Schlosshof. "
  );

  AddCmd( ({"schau","schaue"}) , "cmd_schauen");

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist... ja was eigentlich?\n");
  return 0;
}

int cmd_schauen(string str)
{
  return 0;
}

void entferne_flaffe(object flaffe)
{
  tell_room(TO,BS("Der Flaffe laeuft blau an als ob er keine Luft mehr "
                  "bekommt! Kurz bevor er krepiert haucht er noch \"Dante "
                  "ist ein Arschloch!\" und verpufft dann in einer weissen "
                  "Wolke, aus der ein paar Schmetterlinge in alle Richtungen "
                  "davonfliegen."));

  destruct(flaffe);
}

void init()
{
  ::init();

  if(TP->id("flaffe"))
    call_out("entferne_flaffe",0,TP);
}

