#include "../def.h"

inherit "std/room";

int gras;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Pferdekoppel");
  SetProp(P_INT_LONG,
    "Du stehst auf einer Koppel. Im Norden kannst Du ein Maisfeld "
    "erkennen. Im Westen befindet sich ein Gatter. Im Sueden unterbricht "
    "ein dunkler Strich die Koppel, waehrend im Osten eine Huette "
    "steht. Das Gras ist ein wenig abgetreten, hier und da erkennst Du "
    "einige abgeknabberte Grasbueschel. "
  );

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_PLAIN]));

  AddSpecialDetail( ({"norden","osten"
                     ,"sueden","westen"
                     ,"nordosten","suedosten"
                     ,"nordwesten","suedwesten"
                     })                           , "detail_richtungen");

  AddDetail( ({"raum"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"gras"}),
    "Das Gras ist noch saftig und schmackhaft. Einige Grasbueschel sehen "
    "jedoch arg angeknabbert aus, aber das wird schon wieder nachwachsen. "
  );

  AddDetail( ({"grasbueschel"}) ,
    "Einige der Grasbueschel sind angeknabbert, aber die wachsen schon "
    "wieder nach. "
  );

  AddSpecialDetail( ({"pferde"}), "detail_pferde" );

  AddDetail( ({"boden"}),
    "Auf dem Boden waechst ein wenig abgeknabbertes Gras."
  );

  AddDetail( ({"himmel"}),
    "Am Himmel steht unerbittlich die Sonne."
  );

  AddDetail( ({"sonne"}),
     "Die Sonne ist heute mal wieder heiss."
  );

  AddDetail( ({"koppel", "pferdekoppel"}),
    "Du stehst mitten auf der grossen Pferdekoppel."
  );

  AddSound(DEFAULT_SOUND,
    "Fast ist Dir, als ob Du das Trampeln von Hufen hoertest."
  );

  AddSound( ({"trampeln","hufe","hufen"}),
    "Du hast Dich wahrscheinlich getaeuscht."
  );

  AddSmell(DEFAULT_SMELL,
    "Ein Pferd hat hier sicherlich irgendwo etwas fallen lassen. Es stinkt "
    "naemlich scheusslich.");

  AddSpecialExit( "aufgabe", "aufgabe" );
  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );

  AddCmd( ({"knabber","knabbere"})      , "cmd_knabbern");

}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist... ja was eigentlich?\n");
  return 0;
}

string detail_richtungen(string str)
{
  return CAP(str)+" liegt im "+CAP(str)+".\n";
}

string detail_pferde(string str)
{
  int pferde;
  string s;

  pferde = sizeof(filter_objects(all_inventory(TO), "id", "\nFEENPFERD"));

  if(!pferde) return "Im Moment befinden sich in diesem Teil der "
                     "Koppel keine Pferde.\n";

  s = (pferde == 1) ? "Es befindet sich " : "Es befinden sich ";

  switch(pferde)
  {
    case 1 :
      s += "ein Pferd";
      break;

    case 2 :
      s += "zwei Pferde";
      break;

    default:
      s += "einige Pferde";
      break;
  }

  s += " auf diesem Teil der Koppel.";
  return BS(s);
}

int cmd_knabbern(string str)
{
  string s;

  notify_fail("Woran willst Du knabbern?\n");

  if(!str || str == "") return 0;
  if(!(str == "an gras"         ||
       str == "an grasbueschel" ||
       str == "gras"            ||
       str == "grasbueschel"    )) return 0;

  s = "Du kniest nieder und knabberst etwas an dem Gras. Naja, "
                "schmeckt irgendwie wie Gras. ";

  if(gras)
  {
    s += "Aber Du fuehlst Dich etwas gestaerkt. ";
    TP->heal_self(8+random(8));
    gras = 0;
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(BS(CAP(TPN)+" kniet nieder und frisst Gras wie ein"+
    (TP->QueryProp(P_GENDER) == FEMALE ? "e Kuh" : " Stier")+
    ". Muuuuuuuuuuh."
  ));
  return 1;
}


