#include "../def.h"

inherit "std/armour";

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Feenhut");
  SetProp(P_LONG,
    "Ein Feenhut. Lang und spitz ist er, und an sein spitzes Ende gehoert "
    "sicherlich ein Schleier. Zumindest sieht es so aus, als ob dort etwas "
    "abgerissen wurde."
  );

  SetProp(P_NAME, "Feenhut");
  SetProp(P_GENDER, MALE);
  AddId( ({"feenhut","hut","\nFEENHUT","\nFEENQUESTOBJ","QUESTOBJ","NODESTRUCT"}) );

  SetProp(P_MATERIAL, ([MAT_SILK:50, MAT_MISC_MAGIC:50]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 4000);

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 15);
  SetProp(P_HUTZUSTAND,0);

  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOSELL,1);

  AddDetail( ({"seide"}) ,
    "Der Hut besteht aus einer ganz besonders feinen Seide."
  );

  AddDetail( ({"magie"}) ,
    "Die ist nicht von dieser Welt."
  );

  AddDetail( ({"welt"}) ,
    "Du stehst drauf."
  );

  AddDetail( ({"licht"}) ,
    "Das Licht wird von der Seide irisierend zurueckgeworfen."
  );

}
