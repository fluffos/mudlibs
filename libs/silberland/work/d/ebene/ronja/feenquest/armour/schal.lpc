#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein weisser Schal");
  SetProp(P_LONG,
    "Ein weisser Schal, an dem schon die Motten ein paar Loecher "
    "hineingefressen haben. Schade, denn dies waere ein wirklich sehr "
    "edles Stueck, wenn nur nicht diese Loecher waeren. "
  );

  SetProp(P_NAME, "Schal");
  SetProp(P_GENDER, MALE);
  AddId( ({"schal", "seidenschal","\nSCHAL"}) );

  SetProp(P_NAME_ADJ, ({"weiss"}) );
  AddAdjective( ({"weissen","weisser","weissem","weisses","weisse"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
  SetProp(P_WEIGHT, 90);
  SetProp(P_VALUE, 20);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:-3 ]) );
  SetProp(P_DAM_DESC, ({"ist schon etwas mitgenommen","ist schon etwas mitgenommen"}) );

  AddDetail( ({"loch","loecher"}) ,
    "Den Schal hat wohl schon lange niemand mehr getragen, so dass die "
    "Motten sich daran guetlich tun konnten."
  );

  AddDetail( ({"motte","motten"}) ,
    "Im Moment sind keine da."
  );
}


