#include "../def.h"

inherit "std/armour";

void create()
{
  if (!is_clone(this_object()))
    return;

  ::create();

  SetProp(P_SHORT, "Ein kleine Medaille");
  SetProp(P_LONG,
    "Diese Medaille ist einzigartig im ganzen Silberland. Sie ist ein Preis "
    "fuer die erfogreichste Feenkrautsammlerin im ganzen Silberland. Auf "
    "der Vorderseite ist \"1. Platz\" eingraviert, auf der Rueckseite "
    "steht \"Erfolgreichste Feenkrautsammlerin im ganzen Silberland\"."
  );

  SetProp(P_NAME, "Goldmedaille");
  AddId( ({ "medaille","goldmedaille","\nfeen_sammlerin_medaille" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL," Das willst Du nicht wirklich verkaufen.");
  SetProp(P_NODROP,"Du willst doch wohl deine Medaille nicht wegwerfen?\n");

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

}


