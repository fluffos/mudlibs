#include "../def.h"

inherit "std/armour";

string owner;
int edelstein;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Ein unscheinbarer Ring");
  SetProp (P_LONG,
    "Dieser Ring sieht recht unscheinbar aus, doch der Schein truegt "
    "bestimmt. An einer Stelle ist der ansonsten leicht glaenzende Ring "
    "jedoch matt und stumpf."
  );

  SetProp(P_NAME, "Ring");
  AddId( ({"ring","\nAMARING"}) );

  SetProp(P_NAME_ADJ, ({"unscheinbar"}) );
  AddAdjective( ({"unscheinbaren","unscheinbarer","unscheinbarem","unscheinbares","unscheinbare"}) );

  SetProp(P_INFO, BS("Ob dieser unscheinbare Ring von Amalthea stammt? "
                     "Die Fee Amalthea hat bestimmt einen "
                     "maechtigen Zauber in diesen Ring gegeben, um das "
                     "Boese und seinen Fluch besser besiegen zu koennen. "
  ));

  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 450);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 1);

  SetProp (P_WEAR_RESTRICTIONS, ([P_FROG:1, A_INT:28]));

  SetProp (P_MATERIAL, ([MAT_ADAMANT:100]) );

  AddDetail( ({"stelle"}) ,
    "Eine Stelle an diesem Ring ist matt und stumpf, so als ob dort "
    "etwas fehlen wuerde. "
  );

  AddDetail( ({"etwas"}) ,
    "Bestimmt war an dieser Stelle ein Edelstein befestigt. Bloss welcher?"
  );

  AddCmd( ({"steck","stecke","befestig","befestige"}) , "cmd_stecken");

  owner     = 0;
  edelstein = 0;
}

int QueryGem()
{
  return edelstein;
}

void SetGem()
{
  edelstein = 1;

  SetProp (P_SHORT, "Ein strahlender Ring");
  SetProp (P_LONG,
    "Dieser Ring strahlt schon vom reinen Ansehen her eine maechtige "
    "Macht aus. Er hat etwas reines und gutes an sich. Besser, Du gibst "
    "diesen Ring an jemand, der sich mit einer solchen Macht auskennt. "
  );

  SetProp (P_MATERIAL, ([MAT_ADAMANT:80, MAT_MISC_JEWEL:20]) );

  SetProp(P_NAME_ADJ, 0);
  SetProp(P_ADJECTIVES, 0);

  SetProp(P_NAME_ADJ, ({"strahlend"}) );
  AddAdjective( ({"strahlenden","strahlender","strahlendem","strahlendes","strahlende"}) );

  return;
}

void SetOwner(object pl)
{
  owner = getuuid(pl);
}

string QueryOwner()
{
  return owner;
}

void removeme(object pl, string plname)
{
  if(interactive(pl))
  {
    tell_object(pl,BS("Als Du den Ring nimmst, loest sich dieser in einem "
                      "kleinen Lichtblitz auf. Merkwuerdig."));

    tell_room(ENV(pl),BS("Als "+plname+" den Ring nimmt, loest sich "
                         "dieser in einem kleinen Lichtblitz auf. "
                         "Merkwuerdig. "), ({ pl }) );
  }
  TO->remove();
}

void init()
{
  object pl;

  ::init();

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;

  if(!owner)
  {
    SetOwner(pl);
    return;
  }

  if(owner != getuuid(pl))
  {
    call_out("removeme",0,pl,pl->Name());
  }
}

int cmd_stecken(string str)
{
  object gem;

  notify_fail("Was mochtest Du woran stecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "ring an edelstein"          ||
       str == "edelstein an ring"          ||
       str == "ring in edelstein"          ||
       str == "edelstein in ring"          ||
       str == "edelstein in stelle"        ||
       str == "edelstein an stelle"        ||
       str == "ring an weissen edelstein"  ||
       str == "weissen edelstein an ring"  ||
       str == "ring in weissen edelstein"  ||
       str == "weissen edelstein in ring"  )) return 0;

  gem = present("\namagem",TP);
  if(!gem)
  {
    gem = present("EDELSTEIN",TP);

    if(gem)
    {
      TELLPLAYER(BS("Du versuchst, "+gem->Name(WEN)+" an den Ring zu "
                    "stecken, aber irgendwie will das nicht zusammen"
                    "passen."));
    }
    else
    {
      TELLPLAYER("Du hast doch gar keinen Edelstein bei Dir.\n");
    }
    return -1;
  }

  if(gem->QueryOwner() != TO->QueryOwner())
  {
    TELLPLAYER(BS("Hmmm, irgendwie will das nicht zusammenpassen. Da hast Du "
                  "wohl was fasch gemacht."));
    return -1;
  }

  if(edelstein)
  {
    TELLPLAYER("An diesem Ring wurde schon ein Edelstein befestigt.\n");
    return -1;
  }

  TELLPLAYER(BS("Du steckst den weissen Edelstein an den Ring. Nahtlos "
                "schmiegt sich der Edelstein an der Ring an. Du spuerst "
                "eine maechte Magie in dem Ring, weisst aber nicht, sie "
                "anzuwenden. Es ist wohl besser, Du gibst dem Ring jemanden, "
                "der sich damit besser auskennt als Du."));

  gem->remove();

  SetGem();
  return 1;
}


