#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine schoene Robe");
  SetProp(P_LONG,
    "Eine schoene Robe, die sehr robust wirkt. Dennoch ist sie sehr elegant."
  );

  SetProp(P_NAME, "Robe");
  SetProp(P_GENDER, FEMALE);
  AddId("robe");

  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 450);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 6);
}
