#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein schwarzer Zylinder");
  SetProp(P_LONG,
    "Der Zylinder ist schwarz und hat eine nach oben gebogene Krempe. "
    "Er scheint schon etwas aelter zu sein, denn die Zeit ist nicht "
    "spurlos an ihm voruebergegangen. "
  );

  SetProp(P_NAME, "Zylinder");
  SetProp(P_GENDER, MALE);
  AddId( ({"zylinder", "zylinderhut","\nZYLINDER"}) );

  SetProp(P_NAME_ADJ, ({"schwarz"}) );
  AddAdjective( ({"schwarzen","schwarzer","schwarzem","schwarzes","schwarze"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_CARTON:5,MAT_SILK:60,MAT_VELVET:30,MAT_MISC_METAL:5]) );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 20);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:1 ]) );
}

string extra_look()
{
  if(!ENV(TO)) return "";
  if(QueryProp(P_WORN))
  {
    return CAP(ENV(TO)->QueryPronoun(WER))+" hat einen huebschen Zylinderhut auf.\n";
  }
  return "";
}

