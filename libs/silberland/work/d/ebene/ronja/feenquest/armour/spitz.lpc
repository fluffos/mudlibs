#include "../def.h"

inherit "std/armour";

mapping gems = ([
    0: "aquamarin"; MAT_AQUAMARINE; "wasserblau",
    1: "rubin"; MAT_RUBY; "feuerrot",
    2: "saphir"; MAT_SAPPHIRE; "eisblau",
    3: "smaragd"; MAT_EMERALD; "hellgruen",
    4: "amethyst"; MAT_AMETHYST; "violett",
    5: "topas"; MAT_TOPAZ; "sonnengelb",
    ]);

int nr;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  nr = random(sizeof(gems));

  SetProp(P_SHORT, "Ein Paar weisse Spitzenhandschuhe");
  SetProp(P_LONG,
    "Ein Paar Spitzenhandschuhe aus feinem Stoff. In den Stoff "
    "sind "+gems[nr,2]+"e Edelsteine eingewebt, welche den Handschuhen "
    "ein sehr edles Aussehen verleihen."
  );

  AddId (({"handschuhe", "handschuh", "spitzenhandschuhe", "spitzenhandschuh"}));
  SetProp(P_NAME, "Spitzenhandschuhe");

  SetProp(P_NAME_ADJ, ({"weiss"}) );
  AddAdjective( ({"weissen","weisser","weissem","weisses","weisse"}) );

  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 850);

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 8);

  SetProp(P_MATERIAL, ([MAT_VELVET: 80, gems[nr,1]: 20 ]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

  AddDetail( ({"edelstein", "edelsteine", gems[nr], gems[nr]+"e"}),
    "Bei den Edelsteinen handelt es sich um "+capitalize(gems[nr]+"e")+". "
    "Sie funkeln "+gems[nr,2]+" im Licht. Vielleicht kann man sie aus den "
    "Handschuhen herausloesen, aber dann waeren die Spitzenhandschuhe sicherlich "
    "ruiniert."
  );

  AddCmd( ({"loese", "loes"}), "cmd_loesen");
}

int cmd_loesen(string str)
{
  string was,woraus;
  int n,ok;

  notify_fail("Was willst Du woraus heraus loesen?\n");

  if(!str || str == "") return 0;

  ok = 0;
  n = sscanf(str, "%s aus %s heraus", was,woraus);

  if((n == 2) &&
     (was == gems[nr] || was == gems[nr]+"e") &&
     (woraus == "handschuh"         ||
      woraus == "handschuhe"        ||
      woraus == "spitzenhandschuh"  ||
      woraus == "spitzenhandschuhe"  )                ) ok = 1;

  if(!ok &&
     (str == gems[nr]+" heraus"     ||
      str == gems[nr]+"e heraus"     )                ) ok = 1;

  if(!ok) return 0;

  TELLPLAYER(BS("Du loest einige "+capitalize(gems[nr])+"e aus den Handschuhen "
        "heraus, aber die Handschuhe zerfallen dabei zu Staub."));

  "/obj/gemmaster"->DistributeGem(1, 3, 2, TP, ({gems[nr]}) );
  RemoveCmd( ({"loese", "loes"}));
  call_out("remove",0);
  return 1;
}

