#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Ein Brustpanzer");
  SetProp (P_LONG,
    "Der Brustpanzer ist aus Gold, Spitzen und Metall und kann "
    "aufgrund seiner Proportionen nur von einer Frau getragen werden."
  );

  SetProp (P_NAME, "Brustpanzer");
  AddId (({"panzer","brustpanzer"}));

  SetProp(P_INFO, "Der Brustpanzer scheint gegen Luftangriffe zu schuetzen.\n");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 1450);
  SetProp(P_VALUE, 1200);

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 33);

  SetProp(P_MATERIAL, ([MAT_SILVER:10, MAT_GOLD:10, MAT_BRASS:70, MAT_SILK:10]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );
}

