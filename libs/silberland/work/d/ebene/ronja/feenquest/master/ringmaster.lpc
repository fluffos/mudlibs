#include "../def.h"

#define SAVEFILE "/d/ebene/ronja/feenquest/master/ringmaster"

#include <ansi.h>

mapping ringquest;
// 0: Timestamp Start Quest
// 1: Flag ob der Daemon Ash besucht wurde oder nicht.
// 2: Flag ob der Spieler schon mal im Bett war
// 3: Future use
// 4: Future use
// 5: Future use
// 6: Future use

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  ringquest = ([]);
  restore_object(SAVEFILE);
  return;
}

int IsRingQuester(string uuid)
{
  return member(ringquest, uuid);
}

void DeleteRingQuester(string uuid)
{
  if(!member(ringquest, uuid)) return;
  ringquest = m_delete(ringquest, uuid);
  save_object(SAVEFILE);
}

void StartRingQuest(string uuid)
{
  if(IsRingQuester(uuid)) return;

  ringquest += ([uuid: ctime(time());0;0;0;0;0;0]);
  save_object(SAVEFILE);
}

int QueryAshVisited(string uuid)
{
  if(member(ringquest, uuid)) return ringquest[uuid,1];
  return 0;
}

void SetAshVisited(string uuid)
{
  if(member(ringquest,uuid))
  {
    ringquest[uuid,1] = 1;
  }
  else
  {
    ringquest += ([uuid: ctime(time());1;0;0;0;0;0]);
  }

  save_object(SAVEFILE);
}

int QueryWasinBed(string uuid)
{
  if(member(ringquest, uuid)) return ringquest[uuid,2];
  return 0;
}

void SetWasinBed(string uuid)
{
  if(member(ringquest, uuid))
  {
    ringquest[uuid,2] = 1;
  }
  else
  {
    ringquest += ([uuid: ctime(time());0;1;0;0;0;0]);
  }

  save_object(SAVEFILE);
}

void Msg(string s)
{
  object pl;

  write_file("/d/ebene/ronja/feenquest/log/ring.log",ctime()+": "+s+".\n");

  pl = find_player("ronja");

  if(!pl)              return;
  if(!interactive(pl)) return;

  s = break_string(s,78,"AMAQ: ",1);
  if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
  tell_object(pl,s);
}

