void reset()
{
  int n;
  int fv,fn,sv,sn;
  object pl;
  string s;

  feenfeinde    = ({});
  feekfeinde    = ({});
  anzahl_ratten = 4;

  fv = sizeof(fairies);
  fairies = filter_array(fairies, #'find_object );
  fn = sizeof(fairies);

  sv = sizeof(servants);
  servants = filter_array(servants, #'find_object );
  sn = sizeof(servants);

  save_object(FMASTER);

  pl = find_player("ronja");
  if(pl)
  {
    s = sprintf("MASTER: F: %d -> %d ; S: %d -> %d",fv,fn,sv,sn);
    if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
    s += "\n";
    tell_object(pl,s);
  }

}

object *checkrooms()
{
  string *rooms;
  object *players, ob;
  int i;

  players=({});
  rooms=({ROOM "seil1", ROOM "seil2", ROOM "seil3"});

  i=sizeof(rooms);
  while(i--)
  {
    if(ob=find_object(rooms[i]))
      players += filter_array(all_inventory(ob), #'interactive);
  }

  return players;
}

void CheckHorses(object horse)
{
  string *rooms;
  object *horses,ob;
  int i,j,found;

  found = 0;
  rooms=({"koppel1","koppel2","koppel3","koppel4","box0"});
  i = sizeof(rooms);
  while(i--)
  {
    if(ob=find_object(ROOM+rooms[i]))
    {
      horses=filter_objects(all_inventory(ob), "id", "\nFEENPFERD");
      j = sizeof(horses);
      while(j--) if(horses[j]->QueryProp(P_TEMPERAMENT)==T_BRAV) found = 1;
    }
  }

  if(found)
  {
    if(random(10)==5) horse->SetProp(P_GESCHLECHT,T_FOHLEN);
  }
  else
  {
    horse->SetProp(P_TEMPERAMENT,T_BRAV);
  }

  return;
}

int spanne_seil(string spieler)
{
  if(seil_gespannt > 0) return 0;

  seil_gespannt = 1;
  seil_besitzer = spieler;

  return 1;
}

int pruefe_seil()
{
  if(!seil_gespannt) return 0;
  seil_gespannt = 2;
  return 1;
}

string besitzer()
{
  return seil_besitzer;
}

int seilda()
{
  return seil_gespannt;
}

void seilweg(object ausloeser, string seiltext)
{
  object turm;
  object *spieler;
  int i;

  spieler = checkrooms();
  i = sizeof(spieler);
  while(i--)
  {
    if(spieler[i] != ausloeser)
    {
       tell_object(spieler[i], "\n"+BS(seiltext)+"\n\n");
       spieler[i]->move(ENV(spieler[i])->QueryProp(P_RAUMUNTEN),
                        M_GO,"von oben herunter","faellt","faellt herunter");
       spieler[i]->AddHp(-50);
    }
  }

  seil_gespannt = 0;
  seil_besitzer = "";
}

int ratte_erlaubt()
{
  if(anzahl_ratten > 0)
  {
    anzahl_ratten--;
    return 1;
  }

  return 0;
}

string GetExit(string richtung)
{
  string x;

  if(x = exitmap[explode(file_name(PO),"/")[<1]][richtung])
  {
    x = LABY + "lab" + x;
  }
  else
  {
    x = ROOM "hain2";
  }

  return x;
}

string GetDirection()
{
  return (wegzk[explode(file_name(ENV(PO)),"/")[<1]] || "ende");
}

void AddFairy(string s)
{
  if(member(fairies,s) == -1) fairies += ({ s });
  save_object(FMASTER);
}

void DeleteFairy(string s)
{
  if(member(fairies,s) > -1)
  {
    fairies -= ({ s });
    save_object(FMASTER);
  }
}

void AddServant(string s)
{
  if(member(servants,s) == -1) servants += ({ s });
  save_object(FMASTER);
}

void DeleteServant(string s)
{
  if(member(servants,s) > -1)
  {
    servants -= ({ s });
    save_object(FMASTER);
  }
}

int IsEnemy(object spieler)
{
  return (member(feenfeinde, getuuid(spieler)) > -1);
}

int IsFairy(object pl)
{
  object room;

  if(pl->QueryProp(P_RACE) != "Fee")             return 0;
  if(IS_WIZARD(pl))                              return 0;
  if(!(room=ENV(pl)))                            return 0;
  if(file_name(room)[0..strlen(ROOM)-1] == ROOM) return 0;

  return 1;
}

void CallFairies(object pl)
{
  object *players,ronja;
  int i;
  string s;

  players = filter_array(users(), "IsFairy") - ({pl});
  if(ronja=find_player("ronja")) players += ({ ronja });

  s = "Die Feenkoenigin teilt Dir mit: "+pl->Name(WER)+" greift uns an!\n";

  i = sizeof(players);
  while(i--)
  {
    if(players[i]->QueryProp(P_TTY))
    {
      tell_object(players[i],ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL);
    }
    else
    {
      tell_object(players[i],s);
    }
  }
}

void SetBan(string spieler)
{
  object room;

  call_other(ROOM "taverne", "???");
  room = find_object(ROOM "taverne");

  if(!room->query_ban(spieler))
  {
    room->set_ban(spieler,2);
    Msg(CAP(spieler)+" bekommt Lokalverbot");
  }
}

void AddFairyEnemy(object enemy, object victim)
{
  string uid, s, myname;

  uid = getuuid(enemy);

  if(member(feenfeinde, uid) > -1) return;

  if(victim->id("\nFEENKOENIGIN"))
  {
    myname = victim->Name(WER,1);
  }
  else
  {
    myname = victim->Name(WER, 0);
  }

  feenfeinde += ({uid});
  SetBan(uid);

  s = myname+" ruft: Alarm! Das Feenschloss wird von "
      +enemy->Name()+" angegriffen!";

  if(victim->id("\nFEENKOENIGIN"))
    s += " Feen, eilt eurer Koenigin zu Hilfe!";

  domainshout(LF+BS(s)+LF, ROOM, 1);
  tell_object(enemy, LF+BS(s)+LF);

  call_out("CallFairies", 0, enemy);
}

void AddQueenEnemy(object enemy, object victim)
{
  string uid,s;
  object f;
  int i;

  uid = getuuid(enemy);

  if(member(feekfeinde, uid) == -1)
  {
    feekfeinde += ({uid});
    AddFairyEnemy(enemy, victim);
  }

  i = sizeof(fairies);
  if(!i) Msg("Keine Feen zur Verteidigung der Koenigin vorhanden");
  while(i--)
  {
    if(f = find_object(fairies[i]))
    {
      f->DefendQueen();
      Msg("Fee "+fairies[i]+" zur Koenigin geschickt");
    }
  }
}

int AddEnemy(object enemy, object victim)
{
  if(enemy && query_once_interactive(enemy))
  {
    if(objectp(victim) && victim->id("\nFEENKOENIGIN"))
    {
      AddQueenEnemy(enemy, victim);
    }
    else
    {
      AddFairyEnemy(enemy, victim);
    }
  }
  return 1;
}

int DeleteEnemy(object spieler)
{
  if(objectp(spieler) && query_once_interactive(spieler))
  {
    feenfeinde -= ({ getuuid(spieler) });
  }
  return 1;
}

string *ListEnemies()
{
  return feenfeinde;
}

string *ListFairies()
{
  return fairies;
}

string *ListServants()
{
  return servants;
}


