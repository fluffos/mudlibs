void Msg(string s)
{
  object pl;

  write_file("/d/ebene/ronja/feenquest/log/feen.log",ctime()+": "+s+".\n");

  pl = find_player("ronja");

  if(!pl)              return;
  if(!interactive(pl)) return;

  s = break_string(s,78,"FEEN: ",1);
  if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
  tell_object(pl,s);
}

