#include "../def.h"

inherit "/std/room";

string longtext;
string longtext2;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Labyrinth" );

  longtext = "Du befindest Dich im Labyrinth des Feenschlosses. Wo Du auch "
             "hinsiehst, Du bist von hohen Hecken umringt. In alle vier "
             "Himmelsrichtungen ist ein Torbogen in die Hecke geschnitten. ";

  longtext2 = "";

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_OUT);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_HECKE, HECKE_IST_DA);

  AddDetail( ({"himmel"}) ,
    "Der wolkenlose Himmel erstrahlt in einem sagenhaften Blau. "
    "Die Sonne kannst Du wegen den hohen Hecken allerdings nicht sehen."
  );

  AddDetail( ({"wolke","wolken"}) ,
    " Wolkenlos heisst OHNE Wolken!"
  );

  AddDetail( ({"sonne"}) ,
    "Die kannst Du wegen der hohen Hecken nicht sehen."
  );

  AddDetail( ({"blau","stahlblau","himmelblau","himmelsblau"}) ,
    "Der Himmel erstrahlt in einem sagenhaften Blau."
  );

  AddDetail( ({"feenschloss","feenschlosses","schloss"}) ,
    "Das kannst Du von hier aus nicht sehen."
  );

  AddDetail( ({"labyrinth"}) ,
    "Pass bloss auf, dass Du Dich nicht verlaeufst."
  );

  AddDetail( ({ "boden" }),
    "Du laeufst auf feinem Kies. Er ist sorgsam geharkt. Jeder Deiner "
    "Schritte erzeugt ein leises Knirschen."
  );

  AddDetail( ({ "knirschen"}) ,
    "Es knirscht, als die Steinchen aneinander reiben."
  );

  AddDetail( ({ "kies","steine","steinchen","kieselstein","stein",
                "kieselsteine"}),
    "Der Kies besteht aus vielen kleinen Steinchen in allerlei "
    "Farbschattierungen."
  );

  AddDetail( ({"schritt","schritte"}) ,
    "Wenn man einen Fuss vor den anderen setzt, nennt man das einen Schritt."
  );

  AddDetail( ({"fuss","fuesse"}) ,
    "Du schaust an Dir herunter. Du siehst einen Fuss - und noch einen "
    "Fuss. Es sind tataechlich Deine Fuesse! Und zwar alle beide!"
  );

  AddDetail( ({"farbschattierung","farbschattierungen","schattierung",
               "schattierungen","farbe","farben"}) ,
    "Du siehst graue, aschgraue, mausgraue, silbergraue, hellgraue und "
    "dunkelgraue Steinchen."
  );

  AddDetail( ({"grau","aschgrau","silbergrau","hellgrau","dunkelgrau"}) ,
    "Grau - was fuer eine langweilige Farbe."
  );

  AddDetail( ({"mausgrau"}) ,
    "Grau - was fuer eine langweilige Farbe."
  );

  AddDetail( ({ "hecke","hecken" }),
    "Sie sind sehr gerade und exakt geschnitten."
  );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Voegel zwitschern."
  );

  AddSound( ({"voegel","lied"}),
    "Die Voegel zwitschern froehlich ein Lied."
  );

  AddSound( ({"knirschen","kies"}) ,
    "*Knirsch*"
  );

  AddDetail( ({"voegel","vogel"}) ,
    "In der dichten Hecke brueten bestimmt viele Voegel."
  );

  AddDetail( ({"nest","nester"}) ,
    "Du greifst in die Hecke um ein Nest zu untersuchen. Doch die Voegel "
    "hacken Dir empfindlich in die Hand, die Du schnell wieder "
    "zurueckziehst."
  );

  AddDetail( ({"hand"}) ,
    "Eine Hand mit 5 Fingern."
  );

  AddDetail( ({"finger"}) ,
    "Die befinden sich an Deiner Hand."
  );

  AddDetail( ({"torbogen","bogen"}) ,
    "In die Hecke ist in jede Himmelsrichtung ein Torbogen geschnitten."
  );

  AddDetail( ({"himmelsrichtung","richtung","himmelsrichtungen"}) ,
    "Die vier Himmelsrichtungen sind: Norden, Osten, Sueden, Westen."
  );

  AddDetail( ({"norden","osten","sueden","westen"}) ,
    "Das ist eine Himmelsrichtung."
  );

  AddDetail( ({"silberwald"}) ,
    "Den kannst Du von hier aus nicht sehen."
  );

  AddDetail( ({"bach"}) ,
    "Du siehst hier keinen Bach."
  );

  AddDetail( ({"wasser"}) ,
    "Kein Wasser finden bedeutet, dass Du kein Wasser finden wirst!"
  );

  AddDetail( ({"luft"}) ,
    "Es ist die Luft die Du atmest."
  );

  AddDetail( ({"tag"}) ,
    "Ein Tag hat 24 Stunden."
  );

  AddDetail( ({"stunden","stunde"}) ,
    "Eine Stunde hat 60 Minuten."
  );

  AddDetail( ({"minuten","minute"}) ,
    "Eine Minute hat 60 Sekunden."
  );

  AddDetail( ({"sekunden","sekunde"}) ,
    "Eine genauere Zeiteinteilung brauchst Du nicht."
  );

  AddDetail ( ({"zeiteinteilung","zeit","unterteilungen"}) ,
    "Die Zeit wird in Stunden, Minuten und Sekunden gemessen. Es gibt noch "
    "feinere Unterteilungen, aber das interessiert Dich jetzt nicht."
  );

  AddDetail( ({"aufgabe"}) ,
    "Eine Deiner Aufgaben ist es hier, hier wieder herauszufinden."
  );

  AddDetail( ({"ausgang"}) ,
    "Das Labyrinth ist aber wirklich verzwickt, jetzt weisst Du schon "
    "nicht mehr, wo der Ausgang ist."
  );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, hier heraus zu finden.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  s = "Es ist ein warmer Tag und die Luft ist sehr angenehm. ";

  switch(random(10))
  {
    case 0 : s+="Hoffentlich hast Du Dich nicht verlaufen!"; break;
    case 1 : s+="Es sieht alles so gleich aus im Labyrinth."; break;
    case 2 : s+="In welcher Richtung war nochmal der Ausgang?";break;
    case 3 : s+="Hoffentlich hast Du einen guten Orientierungssinn.";break;
  }

  return BS(longtext+longtext2+s);
}

string ausgang(string richtung)
{
  return FMASTER->GetExit(richtung);
}
