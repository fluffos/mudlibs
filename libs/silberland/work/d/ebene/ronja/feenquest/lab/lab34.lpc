#include "../def.h"

inherit LABY "lab00.lpc" ;

void create()
{
  ::create();

  longtext = "Du befindest Dich im Labyrinth des Feenschlosses. Wo Du auch "
             "hinsiehst, Du bist von hohen Hecken umringt. Nach Norden, "
             "Osten und Sueden ist ein Torbogen in die Hecke geschnitten. "
             "Der Weg nach Westen ist zugewachsen und unpassierbar. ";

  longtext2 = "";

  SetProp(P_HECKE, HECKE_TORBOGEN);

  RemoveDetail( ({"torbogen"}) );
  AddDetail( ({"torbogen"}) ,
    "In die Hecke ist in jede Himmelsrichtung ein Torbogen geschnitten. "
    "Der Weg nach Westen ist jedoch zugewachsen und unpassierbar. Mit "
    "einem geeigneten Werkzeug sollte der Torbogen wieder frei "
    "geschnitten werden koennen."
  );

  AddDetail( ({"weg","westen"}) ,
    "Der Weg nach Westen ist zugewachsen. Die Hecke ist auch schon zu "
    "dicht als dass Du Dich ohne Werkzeug durchzwaengen koenntest."
  );

  AddDetail( ({"werkzeug","gartenwerkzeug"}) ,
    "Du siehst kein Werkzeug hier herumliegen."
  );

  AddCmd( CMD_ZWAENGEN+CMD_KLETTERN, "cmd_durchzwaengen" );

  AddExit( ({"norden","osten","sueden"}), ([EX_FUNC:"ausgang"]) );
}

int cmd_durchzwaengen(string str)
{
  notify_fail("Wo willst Du Dich durchzwaengen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "durch hecke"         ||
       str == "durch torbogen"         ))return 0;

  TELLPLAYER(BS("Die Hecke ist sehr dornig und als Du versuchst, "
                "Dich durch die Hecke zu zwaengen zerkratzt Du "
                "Dir Deine Haende. "
  ));
  TELLOTHERS(BS(TPN+" versucht sich durch den zugewachsenen Torbogen "
                "hindurchzuzwaengen, zerkratzt sich aber nur furchtbar "
                "die Haende."
  ));
  TP->AddHp(-5);

  return 1;
}





