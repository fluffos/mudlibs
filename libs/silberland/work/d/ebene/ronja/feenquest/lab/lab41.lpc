#include "../def.h"

inherit LABY "lab00.lpc" ;

int repariert = 0;

void create()
{
  ::create();

  longtext2 = "Nach Westen fuehrt eine alte Bruecke durch den Torbogen "
              "hindurch. ";

  AddSpecialDetail( ({"bruecke"}) , "detail_bruecke");

  AddDetail( ({"schuss"}) ,
    "Was meinst Du? Einen Schuss Whisky? Oder die Redewendung "
    "\"Etwas in Schuss halten?\" Ich glaube, Du hast einen Schuss, "
    "auch noch jedes popelige Detail untersuchen zu wollen."
  );

  AddDetail( ({"detail"}) ,
    "Ja hier gibt es welche. Erstaunlich, nicht wahr?"
  );

  AddDetail( ({"schuss whisky"}) ,
    "Ach geh, begib Dich halt in die Taverne."
  );

  AddDetail( ({"taverne"}) ,
    "Die Taverne befindet sich im Osten des Schlosses."
  );

  AddDetail( ({"schloss","schlosses"}) ,
    "Du standest erst kuerzlich davor."
  );

  AddDetail( ({"diener"}) ,
    "Die treiben sich vermutlich mal wieder in der Taverne herum."
  );

  AddDetail( ({"bach"}) ,
    "Unter der Bruecke fliesst ein kleiner Bach hindurch."
  );

  AddSpecialExit( "westen", "exit_bruecke" );

  AddExit( ({"norden","osten","sueden"}), ([EX_FUNC:"ausgang"]) );

  AddCmd( ({"repariere","reparier"}), "cmd_repariere");
//AddCmd( ({"wasch","wasche"})      , "cmd_waschen");

  repariert = 0;
}

void reset()
{
  ::reset();

  repariert = 0;
}

int cmd_repariere(string str)
{
  object hammer;
  object naegel;
  object brett;

  notify_fail("Was willst Du reparieren?\n");

  if(!str || str == "")   return 0;
  if(!(str == "bruecke")) return 0;

  if(repariert == 1)
  {
    TELLPLAYER("Die Bruecke wurde doch vor kurzem erst repariert.\n");
    return 1;
  }

  if(!(hammer=present("hammer",TP)))
  {
    TELLPLAYER("Du hast ja gar keinen Hammer bei Dir.\n");
    return 1;
  }

  if(!hammer->QueryProp(P_WIELDED))
  {
    TELLPLAYER("Du musst den Hammer erstmal zuecken.\n");
    TELLOTHERS(TPN+" fuchtelt mit einem Hammer wild in der Gegend herum.\n");
    return 1;
  }

  if(!(naegel=present("\nFEENNAEGEL",TP)))
  {
    TELLPLAYER("Du hast ja gar keine Naegel bei Dir.\n");
    return 1;
  }

  if(!(brett=present("\nFEENBRETT",TP)))
  {
    TELLPLAYER("Du hast ja gar kein geeignetes Brett bei Dir.\n");
    return 1;
  }

  if(hammer->QueryProp(P_WEIGHT) > 1500)
  {
    SetProp(P_KILL_NAME,"Ein Hammer");
    TELLPLAYER(BS("Du versuchst. die Bruecke zu reparieren, aber "
                  "Dein Hammer ist viel zu gross und zu schwer und Du "
                  "haust Dir fuerchterlich auf den Daumen. Schmerzerfuellt "
                  "rufst Du: AUA!"
    ));
    TELLOTHERS(TPN+" haut sich mit einem Hammer voll auf den Daumen.\n");
    domainshout(TPUID+" ruft: AUA!\n", ROOM, 1);
    FMASTER->Msg(TPUID+" haut sich voll auf den Daumen");
    TP->do_damage(15);
    return 1;
  }

  hammer->DoUnwield(1);
  TELLPLAYER(BS("Du besserst das lose Brett aus und verbrauchst dabei alle "
                "Naegel. Gerade als Du fertig bist, gleitet Dir der Hammer "
                "aus den Haenden und versinkt im Bach, der unter der Bruecke "
                "hindurchfuehrt. "
  ));

  TELLOTHERS(TPN+" macht sich an der Bruecke zu schaffen.\n");

  if(brett)  brett->remove();
  if(hammer) hammer->remove();
  if(naegel) naegel->remove();

  FMASTER->Msg(TPUID+" hat die Bruecke repariert");

  repariert = 1;
  return 1;
}

int exit_bruecke(string dir)
{
  if(!(TP && query_once_interactive(TP))) return 0;

  if (repariert == 0)
  {
    TELLPLAYER(BS("Obwohl die Bruecke sehr wackelig aussieht, wagst "
                  "Du es, ueber sie zu gehen. In der Mitte spuerst Du "
                  "allerdings, wie die Bruecke bedenklich anfaengt zu "
                  "krachen. Schnell springst Du wieder zurueck."
    ));

    TELLOTHERS(BS(CAP(TPN)+" geht wagemutig ueber die Bruecke. Als "+
                  TP->QueryPronoun(WER)+" etwa in der Mitte angekommen "
                  "ist, springt "+TP->QueryPronoun(WER)+" ploetzlich zurueck."
    ));

  }
  else
  {

    TELLPLAYER(BS("Nachdem Du die Bruecke repariert hast, gehst Du frohen "
                  "Mutes ueber die Bruecke. In der Mitte jedoch lockert "
                  "sich das Brett und Du stuerzt in den darunterfliessenden "
                  "Bach. Vielleicht haettest Du das Brett doch mit ein paar "
                  "mehr Naegeln befestigen sollen. \"Durch Schaden wird man "
                  "klug\" denkst Du Dir noch. Muehsam ziehst Du Dich wieder "
                  "auf die Bruecke. Du bist pitschnass!"
    ));

    TELLOTHERS(BS(CAP(TPN)+" geht wagemutig ueber die Bruecke. Als "+TPP(WER)+
                  " etwa in der Mitte angekommen ist, lockert sich ein "
                  "Brett und "+TPN+" stuerzt in den darunterfliessenden "
                  "Bach. Muehsam zieht "+TPP(WER)+" sich wieder heraus. "
                  "Puuuuh, "+TPN+" ist pitschnass!"
    ));

  }

  repariert = 0;
  return 1;
}

string detail_bruecke(string str)
{
  if(repariert == 0)
  {
    return BS(
      "Die Bruecke scheint lange Zeit nicht mehr repariert worden sein und "
      "sieht nicht sehr vertrauenserweckend aus. Dass die Diener die nicht "
      "besser in Schuss halten? Aber vielleicht kannst Du sie ja selbst "
      "reparieren?"
    );
  }

  return BS(
    "Die Bruecke ist schon ziemlich alt und sieht nicht sehr "
    "vertrauenserweckend aus. Vor kurzem hat sie jedoch jemand ausgebessert, "
    "denn ein Brett ist nagelneu."
    );

}
