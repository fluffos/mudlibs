#include "../def.h"

inherit LABY "lab00.lpc" ;

void create()
{
  ::create();

  RemoveDetail(({"boden"}));

  AddDetail( ({ "boden" }),
    "Du laeufst auf feinem Kies. Er ist sorgsam geharkt. Jeder Deiner "
    "Schritte erzeugt ein leises Knirschen. Ein grauer Kieselstein faellt "
    "Dir besonders auf."
  );

  RemoveDetail( ({"mausgrau"}) );
  AddSpecialDetail( ({"mausgrau"
                     ,"kies"
                     ,"steine"
                     ,"steinchen"
                     ,"kieselstein"
                     ,"kiesel"
                     ,"stein"
                     }) , "detail_maus");

  AddDetail( ({"nahrung"}) ,
    "Am liebsten haette die Maus wohl Speck oder Kaese, aber das "
    "wird sie hier wohl kaum finden."
  );

  AddRoomMessage(
    ({ "Hat sich da nicht ein Kieselstein bewegt?\n"
     , "Es raschelt zwischen den Kieselsteinen.\n"
     , "Irgendetwas fiept ganz leise zwischen den Kieselsteinen.\n"
     }), 45);

  AddExit( ({"norden","osten","sueden","westen"}), ([EX_FUNC:"ausgang"]) );

  AddCmd( ({"fang","fange"})       , "cmd_fangen");
}

string detail_maus(string str)
{
  object falle;

  if(!falle = present("\nMAUSEFALLE",TP))
  {
    return BS("Du bueckst Dich, um einen der Kieselsteine genauer "
              "zu untersuchen, doch grade als Du danach greifen willst, "
              "wird der Kieselstein lebendig! Eine kleine Maus schaut "
              "Dich mit ihren kleinen Knopfaugen an und verschwindet "
              "rasch wieder zwischen den Kieselsteinen. Da die Maus "
              "so schreckhaft ist, fragst Du Dich, ob es hier Katzen "
              "gibt, die die Maeuse fangen."
             );
  }

  if(falle->QueryProp(P_MAUSEFALLE) == 0)
  {
    return BS("Hmmmm... das sieht aber gar nicht aus wie ein "
              "Kieselstein. Eher wie... ja richtig, es ist eine Maus, "
              "die da zwischen den Kieselsteinen nach Nahrung sucht. "
              "Vorsichtig stellst Du die Mausefalle auf den Boden "
              "und scheuchst dadurch die Maus auf. Rasch verschwindet "
              "sie in der Hecke und Du nimmst die Falle wieder an Dich."
             );
  }

  if(falle->QueryProp(P_MAUSEFALLE) == 1)
  {
    falle->SetProp(P_MAUSEFALLE,2);
    return BS("Hmmmm... das sieht aber gar nicht aus wie ein "
              "Kieselstein. Eher wie... ja richtig, es ist eine "
              "Maus, die da zwischen den Kieselsteinen nach Nahrung "
              "sucht. Vorsichtig stellst Du die Mausefalle auf den "
              "Boden. Langsam steigt der Geruch des Kaeses in die "
              "Nase des Maeusleins. Voller Hunger trippelt die Maus "
              "in die Falle, frisst den Kaese und die Falle schnappt zu."
             );
  }

  if(falle->QueryProp(P_MAUSEFALLE) == 2)
  {
    return BS("Schon wieder eine Maus. Da Du aber schon eine gefangen "
              "hast laesst Du diese hier unbehelligt."
             );
  }
}

int cmd_fangen(string str)
{
  object falle;

  notify_fail("Was moechtest Du fangen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "maus"         ||
       str == "maeuschen"    )) return 0;

  if(!falle = present("\nMAUSEFALLE",TP))
  {
    TELLPLAYER(BS("Du versuchst die kleine Maus zu fangen, aber die ist "
                  "viel zu geschickt und schnell, als dass Du sie mit der "
                  "blossen Hand fangen koenntest. Du denkst Dir: \"Eine "
                  "Mausefalle muss her!\"\n"));
    return -1;
  }

  if(falle->QueryProp(P_MAUSEFALLE) == 0)
  {
    TELLPLAYER(BS("Vorsichtig stellst Du die Mausefalle auf den Boden. Die "
                  "Maus scheint sich jedoch nicht sonderlich dafuer zu "
                  "interessieren. Irgendwie muss man wohl die Maus "
                  "hineinlocken."));
    return -1;

  }

  if(falle->QueryProp(P_MAUSEFALLE) == 1)
  {
    falle->SetProp(P_MAUSEFALLE,2);
    TELLPLAYER(BS("Vorsichtig stellst Du die Mausefalle auf den Boden. "
                  "Langsam steigt der Geruch des Kaeses in die "
                  "Nase des Maeusleins. Voller Hunger trippelt die Maus "
                  "in die Falle, frisst den Kaese und die Falle schnappt "
                  "zu."
                 ));
    return 1;
  }

  if(falle->QueryProp(P_MAUSEFALLE) == 2)
  {
    TELLPLAYER(BS("Du hast aber schon eine Maus gefangen und laesst diese "
                  "hier daher unbehelligt."));
    return -1;
  }

  TELLPLAYER("Jetzt bugt die Mausefalle. Sag Ronja bescheid.\n");
  FMASTER->Msg("Bug in der Mausefalle von "+TPUID);

  return 1;
}


