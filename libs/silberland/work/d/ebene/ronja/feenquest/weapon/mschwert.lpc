#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein blaues Schwert");
  SetProp(P_LONG,
    "Du siehst eine der maechtigsten Waffen im Silberland. Die Klinge "
    "dieses langen zweihaendigen Schwertes ist von blauem Licht umgeben. "
    "Beachte: diese Waffe ist Macht - und Macht darf nicht missbraucht "
    "werden."
  );

  SetProp(P_NAME, "Blauschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert","blauschwert","zauberwaffe"}) );

  SetProp(P_NAME_ADJ, "blau");
  AddAdjective( ({"blauen","blauer","blauem","blaues","blaue"}) );

  SetProp(P_VALUE, 5000);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_MAGIC}) );
  SetProp(P_MATERIAL, ([MAT_IRIDIUM:10, MAT_COBALT:10, MAT_STEEL:30,
                        MAT_MISC_MAGIC:50]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIXFACTOR, 0.5);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_INFO, BS(
    "Du siehst eine sehr maechtige Waffe, die aus seltenen magischen "
    "Materialien besteht. Ein magisches Schwert kann magischen "
    "Schaden anrichten und ist daher in der Lage, Geisterwesen zu "
    "verletzen."));
  AddDetail("zauberwaffe",
      "Stark und maechtig leuchtet sie Dich an.\n");
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10, A_INT:10]) );
}

int HitFunc(object enemy)
{
  int ret;

  if(random(100) < 66) return 0;

  ret = 0;

  if((enemy->id("geist")) ||
     (lower_case(enemy->QueryProp(P_RACE))=="geist")) ret = 50 + random(250);

  return ret;
}




