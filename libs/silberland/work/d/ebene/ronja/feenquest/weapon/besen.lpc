#include "../def.h"

inherit "std/weapon";

int kehren(string str);

void create()
{
  if (!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Besen");

  SetProp(P_LONG,
    "Ein Besen. Damit kann man den Boden fegen oder auch die Spinnweben "
    "von der Decke entfernen. Dieses Exemplar besteht aus einem langen "
    "Holzgriff, an welchem unten Stroh befestigt ist."
  );

  SetProp(P_NAME, "Besen");

  SetProp(P_GENDER, MALE);
  AddId( ({"besen","\nBESEN"}) );

  SetProp(P_MATERIAL, ([MAT_BIRCH_WOOD:80, MAT_STRAW:20]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 10);

  SetProp(P_NOBUY, 1);

  SetProp(P_WEAPON_TYPE,WT_SPEAR);
  SetProp(P_WC, 40);
  SetProp(P_WC_BONUS, (["KAMMERDIENER":140]));
  SetProp(P_WC_FIX, 5);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);

  SUID;

  AddCmd( ({"kehr", "kehre","feg","fege"}), "cmd_kehren");
  AddCmd( ({"entferne","entfern"})        , "cmd_entfernen");

  AddDetail( ({"holzgriff"}) ,
    "Der ist schon ganz abgegriffen, was daran liegt, dass mit diesem Besen "
    "schon oft gekehrt wurde."
  );

}

int check_if_player(object ob)
{
  if(!ob)                    return 0;
  if(!interactive(ob))       return 0;
  if(IS_WIZARD(ob))          return 0;
  if(ob->QueryProp(P_INVIS)) return 0;

  return 1;
}

int cmd_kehren(string str)
{
  object *players, room;
  int i, fegen;
  string strp, stro;

  notify_fail("Womit willst du fegen?\n");

  if(!str || str == "") return 0;
  if(!(str == "besen"         ||
       str == "mit besen"     )) return 0;

  if(!objectp(QueryProp(P_WIELDED)))
  {
    TELLPLAYER("Du musst den Besen schon zuecken.\n");
    TELLOTHERS(CAP(TPN)+" scheint sich nicht besonders gut mit "
               "Besen auszukennen.\n");
    return 1;
  }

  fegen = 0;
  room  = ENV(TP);

  if(room->QueryProp(P_INDOORS))
  {
    strp = "Du schwingst ungeschickt den Besen durch die "
           "Gegend und wirbelst eine Menge Staub auf.";
    stro = CAP(TPN)+" schwingt einen Besen und wirbelt "
           "eine Menge Staub auf.";
    fegen = 1;
  }
  else
  {
    switch(room->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN])
    {
      case TT_CAVE  :
      case TT_HOUSE :
      case TT_ROAD  :
        strp = "Du schwingst ungeschickt den Besen durch die "
               "Gegend und wirbelst eine Menge Staub auf.";
        stro = CAP(TPN)+" schwingt einen Besen und wirbelt "
           "eine Menge Staub auf.";
        fegen = 1;
        break;

      case TT_ARCTIC:
        strp = "Da Du sehr entgegenkommend anderen gegenueber bist, willst "
               "Du den Weg vom Schnee freikehren, doch mit dem Besen "
               "erreichst Du leider nicht viel.";
        stro = CAP(TPN)+" versucht den Schnee vom Weg zu kehren, doch "
               "bleibt "+TP->QueryPronoun(WER)+" wegen der grossen "
               "Schneemenge ziemlich erfolglos.";
        fegen = 0;
        break;

      default :
        strp = "Hier gibt es nichts zu fegen.";
        stro = CAP(TPN)+" schwingt unschluessig einen Besen hin und her.";
        break;
    }
  }

  TELLPLAYER(BS(strp));
  TELLOTHERS(BS(stro));

  if(fegen)
  {
    players = filter_array(all_inventory(room), "check_if_player");
    i = sizeof(players);
    while(i--)players[i]->command_me("huste");
  }

  return 1;
}

int cmd_entfernen(string str)
{
  notify_fail("Was willst Du entfernen ?\n");

  if(!str || str == "") return 0;

  if(!(str == "spinnweben")) return 0;

  TELLPLAYER(BS("Das ist nun aber wirklich keine Arbeit fuer "
                "einen Abenteurer wie Dich!"));
  FMASTER->Msg(TPUID+" versucht Spinnweben zu entfernen");
  return 1;
}


