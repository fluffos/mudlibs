#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Zauberstab");
  SetProp(P_LONG,
    "Der Zauberstab ist vergoldet und sein Schatten kann "
    "ueber Leben und Tod des Angreifers richten."
  );

  SetProp(P_NAME, "Zauberstab");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, "Der Zauberstab liegt ausserordentlich gut in der Hand.\n");
  AddId( ({"stab","zauberstab"}) );

  SetProp(P_VALUE, 1500);
  SetProp(P_WEIGHT, 400);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 110);
  SetProp(P_WC_FIXFACTOR, 0.9);
  SetProp(P_WC_BONUS,(["\nFEENKOENIGIN":140]));
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:75, MAT_SILVER:5, MAT_GOLD:15, MAT_SHADOW:5]));

  AddDetail( ({"schatten"}) ,
    "Du stehst unter ihm und eisige Kaelte bricht herein"
  );

  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:14, SR_BAD:400]) );
}

