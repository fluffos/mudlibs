#include "../def.h"

inherit NPC "stdnpc";

int callouts;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Wildkatze");
  SetProp(P_LONG,
    "Eine Wildkatze. Aufmerksam verfolgt sie jede Deiner "
    "Bewegungen, ihre Ohren nehmen jedes Geraeusch wahr. "
    "Trotzdem sie ihre Augen halb geschlossen hat, entgeht ihr nichts. "
    "Sie scheint zwar entspannt da zu liegen, aber taeusche Dich "
    "nicht. Sie ist jederzeit zu einem Sprung bereit."
  );

  SetProp(P_NAME, "Wildkatze");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"wildkatze","katze","\nWILDKATZE","NOWIMPY"}));
  AddClass(CL_ANIMAL);

  create_default_npc(15);

  SetProp(P_HANDS, ({" mit ihren scharfen Krallen"
                    ,QueryProp(P_HANDS)[1]+300
                    ,DT_RIP
                    })
  );

  SetProp(P_RACE, "Wildkatze");
  SetProp(P_SIZE, 60+random(20));
  SetProp(P_WEIGHT, 25000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:  0.1, DT_COLD:  -0.3,  DT_MAGIC:  -0.9 ]) );
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht nach #");

  SetProp(P_DIE_MSG,  " stirbt mit einem lauten Fauchen.\n");

  AddInfo(DEFAULT_INFO, "schaut Dich nur verstaendnislos an.\n");

  SetChats(5,
    ({"Die Wildkatze putzt ihr Fell.\n"
     ,"Die Wildkatze raekelt sich.\n"
     ,"Die Wildkatze haelt nach Maeusen Ausschau.\n"
     ,"Die Wildkatze schnurrt Dich an.\n"
     })
  );

  SUID;
  CLONEME(OBJ "glasschluessel");

  callouts  = 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(++callouts > 5) return;

  switch (gruppe) {
    case "fies":
      call_out("react", 0, TP, "faucht Dich laut an",
                               "faucht "+TPN+" laut an");
      Kill(TP);
      break;

    case "frech":
      call_out("react", 0, TP, "zeigt Dir hinterhaeltig ihre Krallen",
                               "zeigt "+TPN+" ihre Krallen");
      break;

    case "traurig":
      call_out("react", 0, TP, "kuschelt sich an Dich an und troestet Dich",
                               "troestet "+TPN);
      break;

    case "neutral":
      call_out("react", 0, TP, "blickt Dich mit ihren schoenen Bernsteinaugen unschluessig an",
                               "schaut "+TPN+" unschluessig an");
      break;

    case "nett":
      call_out("react", 0, TP, "schnurrt Dich zufrieden an",
                               "schnurrt "+TPN+" an");
      break;

    case "albern":
      call_out("react", 0, TP, "schaut dich fragend an",
                               "schaut "+TPN+" fragend an");
      break;

    case "aengstlich":
      call_out("react", 0, TP, "reibt ihren Kopf an Deinen Beinen",
                               "reibt ihren Kopf an "+this_player()->name(WESSEN)+" Beinen");
      break;

    case "intim":
      call_out("react", 0, TP, "schmiegt sich unverschaemt kuschlig an Dich an",
                               "schmiegt sich an "+TPN+" an");
      break;

    case "froh":
      call_out("react", 0, TP, "zuckt mit ihrem Schwanz",
                               "zuckt mit ihrem Schwanz");
      break;

    case "aergerlich":
      call_out("react", 0, TP, "faucht Dich bedrohlich an",
                               "faucht "+TPN+" bedrohlich an");
      break;

  }
}

void react(object to, string vic, string oth)
{
  if (present(to, ENV(TO))) {
    tell_object(to, BS(Name(WER, 1)+" "+vic+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+oth+"."), ({to}));
  }
  callouts--;
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

