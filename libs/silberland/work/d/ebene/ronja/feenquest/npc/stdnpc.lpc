#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
}

varargs void die(int poisondeath)
{
  object enemy;

  if((enemy = QueryProp(P_KILLER)) && interactive(enemy))
  {
    FMASTER->Msg(Name(WER,1)+" wurde von "+CAP(getuid(enemy))+" umgebracht");
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    FMASTER->Msg(Name(WER,1)+" hat gerade "+UID(player)+" umgebracht");
  }
}








