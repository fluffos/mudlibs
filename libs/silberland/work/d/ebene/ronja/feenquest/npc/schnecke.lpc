#include "../def.h"

inherit NPC "stdnpc";

int callouts;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Schnecke");
  SetProp(P_LONG,
    "Eine Schnecke mit einem kleinen Haeuschen. Langsam kriecht sie "
    "ueber den Weg und hinterlaesst eine Schleimspur darauf. Aber es "
    "ist sicherlich interessanter, weiter zu forschen, denn wenn Du noch "
    "lange hier herumstehst, waechst Dir am Ende noch Efeu um die Fuesse. "
  );

  SetProp(P_NAME, "Schnecke");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"schnecke", "weinbergschnecke"}));
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit ihren Fuehlern",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Schnecke");
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_NOATTACK, "ist viel zu unbedeutend.\n");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  AddInfo(DEFAULT_INFO, "hat keine Ohren um Dir zuzuhoeren.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das ist viel zu schwer fuer eine Schnecke.\n" }) );

  SetChats(2,
    ({"Die Schnecke schleimt vor sich hin.\n"
     ,"Die Schnecke kriecht ein klein wenig vorwaerts.\n"
     ,"Die Schnecke zieht einen Fuehler ein und gleich wieder aus.\n"
     })
  );

  callouts == 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(callouts > 5) return;

  call_out("reaction", 0, TP,
    "Die Schnecke ist Dir zu schleimig.",
    TPN+" ekelt sich vor der Schnecke."
  );

  callouts++;
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  if(present(ob, ENV(TO)))
  {
    tell_object(ob, macher);
    tell_room(ENV(TO), andere, ({ob}));
  }
  callouts--;
}
