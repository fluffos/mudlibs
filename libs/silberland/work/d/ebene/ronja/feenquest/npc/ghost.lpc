#include "../def.h"

inherit NPC "stdnpc";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Schlossgeist");
  SetProp(P_LONG,
    "Der Geist schaut Dich unglaeubig an. Noch nie wagte es jemand, ihm "
    "in die Augen zu schauen. Er wirkt aufgebracht und boese - ein "
    "schlechtes Omen. Hoffentlich sagst Du nichts Falsches."
  );

  SetProp(P_NAME, "Schlossgeist");
  SetProp(P_RACE, "Geist");
  AddId( ({"geist", "schlossgeist"}) );
  AddClass(CL_UNDEAD);

  set_living_name("schlossgeist");
  SetProp(P_GENDER, MALE);

  create_default_npc(18);

  SetProp(P_BODY, 0);
  SetProp(P_HANDS, ({" mit eisigen Fingern", 150, DT_COLD}));
  SetProp(P_ALIGN, -500);
  SetProp(P_SIZE, 200);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:     -0.7, DT_WATER:      -0.5
     , DT_AIR:      -0.8, DT_LIGHTNING:-0.8, DT_EXPLOSION:   0.1
     , DT_SOUND:    -0.6, DT_LIGHT:     1.3, DT_ELECTRIC:   -0.8
     , DT_ACID:     -0.5, DT_POISON:   -1.0, DT_TERROR:     -1.0
     , DT_HOLY:      0.3, DT_UNHOLY:   -1.0, DT_MAGIC:       1.5
     , DT_MIND:     -1.0, DT_SLASH:    -1.0, DT_BLUDGEON:   -1.0
     , DT_PIERCE:   -1.0, DT_SQUEEZE:  -1.0, DT_WHIP:       -1.0
     , DT_RIP:      -1.0
     ])
  );

  SetChats(10,
    ({BS("Der Geist raet Dir umzukehren.")
     ,BS("Der Geist rasselt mit seiner Eisenkette.")
     ,BS("Der Geist verschwindet in einer Wand und kommt auf der anderen "
         "Seite wieder heraus.")
     ,BS("Der Geist aechzt und stoehnt furchterregend.")
     })
  );

  SetProp(P_DEFAULT_INFO, "ruft: Kehr um wenn Dir Dein Leben lieb ist!\n");


  AddDetail( ({"kette","eisenkette"}) ,
    "Lang und schwer ist sie."
  );

  AddInfo("kerker",
    "sagt: ich wuerd' nicht reingehen.\n");
  AddInfo("augen",
    "jammert: Wenn ich nur wieder sehen koennte\n");
  AddInfo("temperatur",
    "jault vergnuegt: Schoen warm ist es hier.\n");
  AddInfo("walpurgis",
    "Die kitzel ich immer so gerne!");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:85]) );

  SetProp(P_SPELLRATE,  30);

  AddSpell(1,280,
   "Der Geist will Dich einem Gott mit unaussprechbaren Namen opfern.\n",
   "Der Geist will @WEN einem Gott mit unaussprechbaren Namen opfern.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,250,
   "Der Geist trifft Dich mit der Kugel seiner Eisenkette.\n",
   "Der Geist trifft @WEN mit der Kugel seiner Eisenkette.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_DIE_MSG, " loesst sich in einer gespenstischen Wolke auf.\n");
  SetProp(P_NOCORPSE, 1);

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  if(strstr(verb, "kitz")==0)
    {
      call_out("reaction", 0, TP,
	       "blickt Dich erschrocken an!",
	       "blickt "+TPN+" erschrocken an!");
      
      if(!present("\nPROtheG_Racetool", TP))
	catch(find_living("walpurgis")->gekitzelt(getuid(TP)));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
