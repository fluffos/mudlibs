#include "../def.h"

inherit NPC "stdnpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Ein Grotter");
  SetProp (P_LONG,
    "Der Grotter ist ein scheues Nachtwesen, dass Licht und Sonne "
    "vermeidet. Wie lange dieser Grotter wohl schon hier unten haust? "
    "Und wovon ernaehrt er sich bloss? Am besten Du laesst den Grotter "
    "unbehelligt."
  );

  SetProp(P_NAME, "Grotter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:40]));
  AddId(({"grotter"}));
  AddClass(CL_ANIMAL,CL_NIGHTVISION);

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit Blitz und Donner"
                    , 110
                    , ({DT_LIGHTNING, DT_SOUND})
                    })
  );

  SetProp(P_RACE, "Grottenwesen");
  SetProp(P_SIZE, 90);
  SetProp(P_WEIGHT,6500);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "verlies1");
  SetProp(P_MNPC_WAIT, ({ 10, 15, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_AREA, ROOM "verlies");

  SetProp(P_MSGIN, "windet sich herein");
  SetProp(P_MSGOUT, "windet sich#");
  SetProp(P_MMSGIN, "windet sich herein");
  SetProp(P_MMSGOUT, "windet sich fort");

  SetProp(P_SPELLRATE, 10);

  AddSpell(1,150,
    "Der Grotter zerbricht einen Stein auf Deinem Kopf.\n",
    "Der Grotter zerbricht einen Stein auf @WESSEN Kopf.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6,
    ({"Der Grotter betet um Hilfe.\n"
     ,"Der Grotter zuernt und zornt.\n"
     })
  );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_DIE_MSG, " verlaesst die irdische Welt.\n");

  AddInfo(DEFAULT_INFO,
    "schaut Dich nur mit seinen riesigen Glubschaugen an.\n"
  );

  AddInfo( ({"verlies","zuhause"}), "grinst: Das ist mein Zuhause.");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Grotter nimmt was Du ihm gibst.\n" }) );

  AddDetail("licht",
    "Er scheut das Licht.\n");

  AddDetail("sonne",
    "Zum Glueck hat er die noch nie gesehen.\n");

  AddDetail("verlies",
    "Vielleicht weiss der Grotter etwas darueber.");
}

