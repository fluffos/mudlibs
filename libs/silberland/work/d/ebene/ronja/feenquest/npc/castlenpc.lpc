#include "../def.h"

inherit NPC "stdnpc";

#define DMASTER "/gilden/druidenzirkel/master/druidenmaster"
#define CASTLEID "CASTLEINHABITANT"

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  AddId( ({CASTLEID}) );
}

int GuildTask(object pl)
{
  if(pl->QueryProp(P_GUILD) != "druidenzirkel") return 0;
  if(pl->QueryProp(P_GUILD_LEVEL) != 7)         return 0;
  if(DMASTER->CheckTask(pl, 7) != 1)            return 0;

  return 1;
}

void angriff(object pl, int i)
{
  string shouter;

  if(ENV(TO) != ENV(pl)) return;

  switch(i)
  {
    case 0 :
      shouter = pl->CannotSee(1) ? "Jemand droht Dir: "
                                 : Name(WER,1)+" droht Dir: ";

      tell_object(pl,
        "\n"+BSI("Verlasse sofort das Schloss, Stoerenfriede dulden wir hier "
               "nicht!",shouter)+"\n"
      );
      break;

    case 1 :
      shouter = pl->CannotSee(1) ? "Jemand droht Dir: "
                                 : Name(WER,1)+" droht Dir: ";

      tell_object(pl,
        "\n"+BSI("Wenn Du nicht umgehend das Schloss verlaesst, dann setzt es "
                 "was!",shouter)+"\n"
      );
      break;

    case 2 :
      shouter = pl->CannotSee(1) ? "Jemand ruft: "
                                 : Name(WER,1)+" ruft: ";

      tell_room(ENV(TO),
        "\n"+BSI(pl->Name(WER)+" ist uns feindlich "
               "gesinnt, auf "+pl->QueryPronoun(WEN)+" mit Gebruell!!!",
               shouter)+"\n"
      );

      Kill(pl);
      return;
      break;
  }

  call_out("angriff", 2, pl, ++i);
  return;
}

void init()
{
  int delay;

  ::init();

  if(!TP)                    return;

  if(TP->id(CASTLEID)) AddDefender(TP);

  if(!interactive(TP))               return;
  if(TP->QueryProp(P_GHOST))         return;
  if(!FMASTER->IsEnemy(TP))          return;
  if(find_call_out("angriff") != -1) return;

  delay = 2;

  if(GuildTask(TP) && !id("walpurgis"))
  {
    delay = 0;
  }

  call_out("angriff", 0, TP, delay);
}


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  FMASTER->AddEnemy(enemy, TO);
  return ::Defend(dam, dam_type, spell, enemy);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}


