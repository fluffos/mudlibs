#include "../def.h"

inherit NPC "stdnpc";

int fertig1(string str);
int fertig2(string str);
int fertig9();

string *questitems = ({"\nFEENHAMMER"
                      ,"\nFEENNAEGEL"
                      ,"\nHUTNADEL"
                      ,"\nHUTSCHLEIER"
                      ,"\nMAUSEFALLE"
                      ,"\nFEENHUT"
                      });

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Ein Oberdiener");
  SetProp (P_LONG,
    "Der Oberdiener ist der Herr ueber die Kammerdiener im Feenschloss. "
    "Mit ihrer Hilfe erledigt er alle anfallenden Taetigkeiten im Schloss. "
    "Darueber hinaus ist er fuer die Vorbereitungen zum Feentanz "
    "verantwortlich, welcher jeden Monat bei Vollmond auf einer geheimen "
    "Lichtung stattfindet."
  );

  AddId( ({"diener","oberdiener","NOWIMPY","NOCONTROL"}) );
  AddClass(CL_HUMAN);

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Oberdiener");
  SetProp(P_ALIGN, 700);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20) );
  SetProp(P_NOATTACK, "hat besseres zu tun als mit Dir zu kaempfen.\n");
  SetProp(P_SOUND, "Der Oberdiener jammert leise vor sich hin.\n");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY,0);

  SetProp(P_LOG_INFO, "/ronja/obdiener");

  SetProp(P_REJECT, ({ REJECT_KEEP,
    "Der Oberdiener nimmt was Du ihm gibst und grinst Dich an.\n" }) );

  set_living_name("oberdiener");
  create_default_npc(25);

  SUID;

  clone_object(ARMOUR "dgew.lpc")->move(ME);
  command("trage robe");

  SetChats(3,
    ({"Der Oberdiener jammert leise vor sich hin.\n"
     ,"Der Oberdiener brummelt leise: Ojemine, ojemine, was mach ich bloss?\n"
     ,"Der Oberdiener scheint etwas zu suchen.\n"
     ,"Der Oberdiener ist voellig verzweifelt.\n"
     ,"Der Oberdiener seufzt: Bald ist wieder Vollmond!\n"
     })
  );

  AddInfo(DEFAULT_INFO,
    ({"grinst Dich nur verschmitzt an.\n"
     ,"schaut Dich fragend an.\n"
     ,"meint: Vielleicht fragst Du mal Walpurgis danach?\n"
     ,"murmelt: Ich kann auch nicht alles wissen.\n"
     })
  );

  AddInfo( ({"schluessel"}) ,
    "Ich brauche keinen Schluessel, ich komme ueberall hin."
    ,
    "sagt: "
  );

  AddInfo( ({"walpurgis"}) ,
    "Walpurgis ist die Wirtin in der Schlosstaverne. Wenn Du sie siehst, "
    "gruess sie von mir, denn solange ich den Feenhut nicht gefunden habe, "
    "habe ich keine Zeit auf ein Schwaetzchen mit ihr."
    ,
    "sagt verschmitzt: ",1
  );

  AddInfo( ({"schwaetzechen"}) ,
    "Dafuer habe ich heute keine Zeit, erst muss ich diesen Feenhut "
    "wiederfinden. Wie konnte ich den nur verlieren?"
    ,
    "seufzt: "
  );

  AddInfo( ({"taverne","schlosstaverne"}) ,
    "Die Schlosstaverne ist im Osten des Schlosses. Vielleicht treffen "
    "wir uns heute abend auf ein Guinness?"
    ,
    "schwaermt: "
  );

  AddInfo( ({"schloss","feenschloss"}) ,
    "Du Doesel stehst doch genau davor. "
    ,
    "murmelt: "
  );

  AddInfo( ({"hilfe","vollmond","feentanz","problem","aufgabe","mond"}) ,
