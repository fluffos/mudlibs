void donate_medal(object player)
{
  object ob;

  if(!interactive(player)) return;
  if(!ENV(TO))             return;
  if(!ENV(player))         return;

  if(ENV(TO) == ENV(player))
  {
    tell_object(player,
      BSI("Hallo Failin, ich glaube Du hast da etwas im Feenschloss "
          "verloren.","Der Oberdiener sagt: ")+"\n"+BS("Der Oberdiener "
          "drueckt Dir etwas in die Hand.")
    );
    ob = clone_object(ARMOUR "medaille");
    ob->move(player,M_NOCHECK);
  }
  else
  {
    tell_object(player,
      BSI("Hallo Failin, kannst Du bitte nochmal vorbeikommen? Ich glaube, "
          "ich habe im Schloss etwas gefunden, was Dir gehoert.","Der "
          "Oberdiener teilt Dir mit: ")
    );
  }
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  if(getuid(TP) == "failin" &&
     !deep_present("\nfeen_sammlerin_medaille",TP))
  {
    call_out("donate_medal", 2, TP);
  }
}

void gib_hammer_an_spieler()
{
  object hammer, naegel;
  string s;

  if(deep_present("hammer",TP))
  {
    TELLPLAYER("Der Oberdiener grummelt: Du hast doch schon einen Hammer.\n");
    return;
  }

  hammer=clone_object("/p/weapon/club/hammer");

  hammer->SetProp(P_NOBUY, 1);
  hammer->SetProp(P_NOSELL, "Das ist eine Leihgabe vom Oberdiener!\n");
  hammer->SetProp(P_NODROP, "Du willst doch nicht eine Leihgabe wegwerfen?\n");
  hammer->SetProp(P_NEVERDROP, 1);
  hammer->AddId("\nFEENHAMMER");

  if(ME_TOO_HEAVY==hammer->move(TP,M_GET))
  {
    TELLPLAYER(BS("Der Oberdiener versucht Dir einen Hammer zu geben, "
                  "doch Du kannst ihn nicht mehr tragen."
    ));
    TELLOTHERS(TPN+" ist in ein intensives Gespraech mit dem "
               "Oberdiener verwickelt.\n");
    tell_room(ENV(TO),"Der Oberdiener denkt: So ein Schwaechling.\n");
    hammer->remove();
    return;
  }

  FMASTER->Msg(TPUID+" bekommt einen Hammer vom Oberdiener");
  s = "Pass aber auf, dass Du Dir nicht auf den Daumen haust. ";

  if(!present("\nFEENNAEGEL",TP))
  {
    FMASTER->Msg(TPUID+" bekommt auch Naegel vom Oberdiener");
    naegel=clone_object(OBJ "naegel");
    naegel->move(TP,M_GET);
    s += "Und ein paar Naegel habe ich auch noch einstecken, die brauchst "
         "Du doch sicherlich auch. ";
  }

  TELLPLAYER(BSI(s,"Der Obderdiener drueckt Dir etwas in die Hand: "));
  TELLOTHERS(BS(TPN+" hat etwas vom Oberdiener bekommen."));
}

void gib_naegel_an_spieler()
{
  object naegel;

  if(!deep_present("hammer",TP))
  {
    TELLPLAYER(BSI("Was willst Du denn mit Naegeln? Du hast ja noch nicht "
                   "einmal einen Hammer!","Der Obderdiener schaut Dich "
                   "verwundert an: "));
    return;
  }

  if(!present("\nFEENNAEGEL",TP))
  {
    FMASTER->Msg(TPUID+" hat sich Naegel vom Oberdiener geholt");
    naegel=clone_object(OBJ "naegel.lpc");
    naegel->move(TP,M_GET|M_SILENT);
    TELLPLAYER(BSI("Die brauchst Du sicherlich auch.","Der Oberdiener gibt "
                   "Dir ein paar Naegel und meint: "));
  }
  else
  {
    TELLPLAYER(BSI("Aber Du hast doch noch genug Naegel bei Dir?","Der "
                   "Oberdiener schaut Dich fragend an: "));
  }

}

int cmd_helfen(string str)
{
  object schleier;

  notify_fail("Wem moechtest Du helfen?\n");

  if(!str || str == "") return 0;
  if(!(str == "oberdiener" ||
       str == "diener"     )) return 0;

  if(FMASTER->IsEnemy(TP))
  {
    TELLPLAYER(BSI("Du? Ausgerechnet Du willst mir helfen? Du bist den Feen "
                  "doch feindlich gesinnt!","Der Oberdiener schimpft: "));
    TELLOTHERS("Der Oberdiener schubst "+TPN+".\n");
    return 1;
  }

  if(TP->QueryQuest(FEENQUESTNAME))
  {
    TELLPLAYER(BSI("Vielen Dank, aber Du kannst nichts mehr fuer mich tun.",
                   "Der Oberdiener meint: "
    ));
    return 1;
  }

  if(present("\nFEENQUESTOBJ",TP))
  {
    TELLPLAYER(BSI(
      "Aber Du hilfst mir doch schon! Wenn Du den Hut gefunden hast, dann "
      "sag einfach fertig.","Der Oberdiener sagt: "
    ));
    return 1;
  }

  TELLPLAYER(
    BSI("Du willst mir wirklich helfen? Das waere wirklich sehr nett, "
        "denn dann koennte ich im Schloss nach dem Rechten sehen und "
        "dieses faule Pack von Kammerdienern mal wieder auf Trab "
        "bringen.\n"
        "Pass auf: Ich habe auf dem Weg durch das Labyrinth den Feenhut "
        "verloren. Ohne diesen Feenhut koennen die Feen ihren Feentanz "
        "nicht durchfuehren und es wird ein grosses Unglueck ueber die "
        "Feen kommen. Hier, diesen Hutschleier habe ich noch. Er gehoert "
        "zum Hut, eventuell kannst Du ihn ja gebrauchen. Wenn Du den Hut "
        "gefunden hast, dann komm wieder zu mir und sage <fertig>.\n"
        "Und bitte beeil Dich!","Der Oberdiener sagt: "
    )
  );

  schleier=clone_object(OBJ "hutschleier");

  if(ME_TOO_HEAVY==schleier->move(TP,M_GET))
  {
    TELLPLAYER(BS("Der Oberdiener versucht Dir den Hutschleier zu geben, "
                  "doch Du kannst ihn nicht mehr tragen."));
    TELLOTHERS(BS(TPN+" ist in ein intensives Gespraech mit dem Oberdiener "
                  "verwickelt."));
    schleier->remove();
  }
  else
  {
    TELLPLAYER("Der Oberdiener drueckt Dir einen Hutschleier in die Hand.\n");
    TELLOTHERS(TPN+" hat etwas vom Oberdiener bekommen.\n");
    FMASTER->Msg(TPUID+" hat die Feenquest begonnen");
  }

  return 1;
}

int cmd_bieten(string str)
{
  notify_fail("Wem moechtest Du Deine Hilfe anbieten?\n");

  if(!str || str == "") return 0;

  if(!(str == "oberdiener hilfe an"   ||
       str == "diener hilfe an"       )) return 0;

  return cmd_helfen("oberdiener");
}

int cmd_bitten(string str)
{
  int n;
  string wen, was;

  notify_fail("Um was willst Du denn wen bitten?\n");

  if(!str || str == "") return 0;

  n = sscanf(str, "%s um %s", wen, was);
  if(n != 2) return 0;

  if(!(wen = "diener" || wen = "oberdiener")) return 0;

  if(FMASTER->IsEnemy(TP))
  {
    TELLPLAYER(BSI("Du? Ausgerechnet Du willst etwas von mir haben? Du bist "
                   "den Feen doch feindlich gesinnt!","Der Oberdiener "
                   "schimpft: "));
    TELLOTHERS("Der Oberdiener schubst "+TPN+".\n");
    return 1;
  }

  switch(was)
  {
    case "werkzeug" :
    case "werzeuge" :
    case "hammer"   :
      gib_hammer_an_spieler();
      return 1;
      break;

    case "nagel"    :
    case "naegel"   :
      gib_naegel_an_spieler();
      return 1;
  }

  TELLPLAYER(BSI("Tut mir leid, aber sowas habe ich nicht bei mir.",
                 "Der Oberdiener sagt: "));

  TELLOTHERS(BS(CTPN+" ist in ein intensives Gespraech mit dem Obderdiener "
                "verwickelt. "));
  return 1;
}

int fertig1(string str)
{
  notify_fail("Was willst Du sagen?\n");

  if(!str || str == "")  return 0;
  if(!(str == "fertig")) return 0;

  fertig9();
  return 1;
}

int fertig2(string str)
{
  fertig9();
  return 1;
}

int fertig9()
{
  object hut;
  object ob;
  int i;
  int result;

  if(FMASTER->IsEnemy(TP))
  {
    TELLPLAYER(BSI("Du? Ausgerechnet Du willst mir helfen? Du bist den Feen "
                   "doch feindlich gesinnt!","Der Oberdiener schimpft: "));
    TELLOTHERS("Der Oberdiener schubst "+TPN+".\n");
    return 1;
  }

  if(!present("\nFEENQUESTOBJ",TP))
  {
    TELLPLAYER("Der Oberdiener sagt: Fertig? Womit denn?\n");
    return 1;
  }

  if(!(hut=present("\nFEENHUT",TP)))
  {
    TELLPLAYER("Der Oberdiener sagt: Du hast den Hut doch gar nicht.\n");
    return 1;
  }

  if(hut->QueryProp(P_HUTZUSTAND) == 0)
  {
    TELLPLAYER(BSI(
      "Du hast ihn wirklich gefunden! Aber leider kann der "
      "Feenhut seine volle Magie nur entfalten, wenn der "
      "Schleier ordentlich am Hut befestigt ist. Frag "
      "die Feenkoenigin mal, ob sie Dir eine Hutnadel "
      "gibt und befestige damit den Schleier am Hut.",
      "Der Oberdiener freut sich: "
    ));
    return 1;
  }

  TELLPLAYER(BS("Der Oberdiener ist Dir sehr dankbar, dass Du die Feen "
                "gerettet hast. Uebergluecklich strahlt er Dich an und "
                "drueckt Dir eine Belohnung in die Hand. Dann nimmt er "
                "Dir noch alle Sachen ab, die Du nicht mehr brauchst."
  ));

  if((result=TP->GiveQuest(FEENQUESTNAME)) == 1)
  {
    write_file("/log/quests/feentanz",dtime(time())+
               ": "+capitalize(getuid(this_player()))+" loest die Quest.\n" );
    FMASTER->Msg(TPUID+" loest die Quest");
  }
  else
  {
    FMASTER->Msg(sprintf("Questfehler bei %s : %i",TPUID,result));
    TELLPLAYER("\n\n\nFehler bei der Questvergabe. "
               "Bitte Magier verstaendigen.\n\n\n");
  }

  ob=clone_object(OBJ "irrlicht");

  if(ME_TOO_HEAVY==ob->move(TP,M_GET))
  {
    ob->remove();
  }

  i = sizeof(questitems);
  while(i--)
  {
    if(ob=present(questitems[i],TP)) ob->remove();
  }

  if(ob=present("\nHECKENSCHERE",TP))
  {
    ob->DoUnwield(1);
    TELLPLAYER(BS("Blu kommt ganz ausser Atem angerannt und sagt: Ich "
                  "brauche unbedingt die Heckenschere. Du gibst Blu seine "
                  "Heckenschere wieder. Blu bedankt sich bei Dir dass Du "
                  "so sorgsam mit seiner Heckenschere umgegangen bist und "
                  "verschwindet wieder."
    ));
    ob->remove();
  }

}

