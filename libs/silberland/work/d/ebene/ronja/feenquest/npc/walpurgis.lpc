int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  string uuid;

  if(enemy && interactive(enemy))
  {
    uuid = getuuid(enemy);

    if(member(pldam, uuid))
    {
      pldam += ([uuid: dam]);
    }
    else
    {
      pldam[uuid] += dam;
    }
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

void giftspell(object enemy, int damage, mixed dam_type)
{
  enemy->AddPoison(1+random(5));
}

void spell_alc(object enemy, int damage, mixed dam_type)
{
  int alc;

  if(GuildTask(enemy)) return;

  if(enemy->QueryProp(P_GUILD)=="zechpreller")
  {
    alc = 0;
    tell_object(enemy,"Walpurgis floesst Dir eine Kanne Kaffee ein!\n");
    tell_room(ENV(TO),"Walpurgis floesst "+enemy->name(WEM)+" eine Kanne Kaffee ein!\n",
              ({enemy}) );
  }
  else
  {
    alc = enemy->QueryProp(P_MAX_ALCOHOL);
    tell_object(enemy,"Walpurgis floesst Dir eine Flasche Whisky ein!\n");
    tell_room(ENV(TO),"Walpurgis floesst "+enemy->name(WEM)+" eine Flasche Whisky ein!\n",
              ({enemy}) );
  }

  enemy->SetProp(P_ALCOHOL, alc);
}

int cmd_bitten(string str)
{
  int kaesenichtda;
  object falle;
  object kaese;

  notify_fail("Um was moechtest Du Walpurgis bitten?\n");

  if(!str || str == "") return 0;

  if(!(str == "walpurgis um kaese"   ||
       str == "walpurgis um speck"   ||
       str == "wirtin um kaese"      ||
       str == "wirtin um speck"      )) return 0;

  if((str == "walpurgis um speck") || (str == "wirtin um speck") )
  {
    TELLPLAYER("Walpurgis geht in die Kueche und kommt bedauernd zurueck.\n"
               "Walpurgis meint: Leider ist nicht ein Stueck Speck mehr "
               "vorhanden. Tut mir leid.\n"
    );
    return 1;
  }

  kaesenichtda = 0;
  if(!present("\nFEENQUESTOBJ",TP)) {kaesenichtda++;}
  if(deep_present("\nFEENKAESE",TP)) {kaesenichtda++;}
  if((falle=present("\nMAUSFALLE",TP)) && (falle->QueryProp(P_MAUSEFALLE)>0) ){kaesenichtda++;}

  if(kaesenichtda)
  {
    TELLPLAYER("Walpurgis geht in die Kueche und kommt bedauernd zurueck.\n"
               "Walpurgis meint: Leider ist nicht ein Stueckchen Kaese "
               "mehr vorhanden. \nTut mir leid.\n"
    );
    return 1;
  }

  kaese=clone_object( OBJ "kaese.lpc");

  if(ME_TOO_HEAVY==kaese->move(TP,M_GET|M_SILENT))
  {
    TELLPLAYER(BSI("Du hast schon soviel Sachen bei Dir, "
                   "Du kannst selbst dieses kleine Stueck Kaese nicht mehr "
                   "tragen."
                   ,"Walpurgis sagt: "
    ));
    kaese->remove();
  }
  else
  {
    TELLPLAYER(BS("Walpurgis verschwindet rasch in der Kueche "
                  "und bringt Dir ein Stueck Kaese."));
    TELLOTHERS(TPN+" hat etwas von Walpurgis bekommen.\n");
  }

  return 1;
}

void MaxDam(string key, int dam)
{
  FMASTER->Msg(sprintf("USR: %-13s => %5d", explode(key, "_")[0], dam));
  if(dam > maxdam_val)
  {
    maxdam_val = dam;
    maxdam_key = key;
  }
}

string EvalDam()
{
  maxdam_key = "";
  maxdam_val = 0;

  walk_mapping(pldam, "MaxDam", TO);

  FMASTER->Msg(sprintf("MAX: %-13s => %5d", explode(maxdam_key, "_")[0], maxdam_val));

  return maxdam_key;
}

varargs void die(int poisondeath)
{
  object enemy;

  enemy = QueryProp(P_KILLER);

  if(enemy && interactive(enemy))
  {
    kreis->SetOwner(EvalDam());
  }

  ::die(poisondeath);
}

void init()
{
  ::init();

  if(TP && interactive(TP) && TP->QueryProp(P_RACE)=="Fee")
    call_out("check_for_rt", 1);
}

void check_for_rt()
{
  if(!TP) return;
  if(!MENV) return;
  if(!present(TP, MENV)) return;
  if(TP->QueryProp(P_RACE)!="Fee") return;
  
  if(present("\nPROtheG_Racetool", TP)) return;
  
  if(member(gekitzelt, getuid(TP)) > -1)
    {
      command_me("sage Ah! Hihihi! Du, "+TPN+", hast den Geist gekitzelt! "
		 "Endlich hat es ihm mal wer zurueckgezahlt!");
      tell_room(MENV, BS("Walpurgis bedankt sich bei "+TPN+"."), ({TP}));
      write(BS("Walpurgis bedankt sich bei Dir und gibt Dir als Dank "
	       "eine Orchideenbluete."));
      
      CLONE("/p/service/protheg/rt/obj/bluete", TP);
      
      gekitzelt-=({getuid(TP)});

      return;
    }
  
  write(BS("Walpurgis sieht Dich an und laechelt.")+
	BS("Walpurgis sagt: Tu mir doch bitte einen Gefallen und kitzele den")+
	BS("Walpurgis sagt: Geist im Kerker fuer mich.")+
	BS("Walpurgis sagt: Ich gebe Dir auch etwas dafuer!"));
}

void gekitzelt(string pl)
{
  if(!PO) return;
  
  if(strstr(file_name(PO), NPC "ghost") < 0) return;

  if(member(gekitzelt, pl) < 0)
    gekitzelt+=({pl});
}

