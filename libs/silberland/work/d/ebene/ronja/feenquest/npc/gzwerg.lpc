#include "../def.h"

inherit NPC "stdnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Gartenzwerg");
  SetProp(P_LONG,
    "Kitsch scheinen die Feen ja schon zu moegen, denn hier "
    "steht doch tatsaechlich ein Gartenzwerg herum. So richtig "
    "mit gruener Hose, brauner Schuerze, einer roten "
    "Zipfelmuetze, einer Knubbelnase und dicken Pausbacken. "
  );
  SetProp(P_NAME, "Gartenzwerg");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"zwerg", "gartenzwerg"}));
  AddClass(CL_DWARF);

  create_default_npc(10);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinen toenernen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    ,DT_BLUDGEON
                    })
  );

  SetProp(P_RACE, "Gartenzwerg");
  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -1.0, DT_COLD:     -1.0, DT_WATER:       0.0
     , DT_AIR:       0.5, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:   -1.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     1.0, DT_BLUDGEON:    1.0
     , DT_PIERCE:    1.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_MSGIN, "huscht herein und stellt sich ganz brav hin");
  SetProp(P_MSGOUT, "huscht ganz schnell#");
  SetProp(P_MMSGIN, "huscht herein und stellt sich ganz brav hin");
  SetProp(P_MMSGOUT, "huscht ganz schnell davon");

  SetProp(P_MNPC_AREA, ({LABY}) );
  SetProp(P_MNPC_DEFAULTROOM, LABY "lab33.lpc");
  SetProp(P_MNPC_WAIT, ({ 30, 90, 90 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_SPECIAL);

  SetProp(P_DIE_MSG,  " zerspringt in tausend Scherben.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "ist aus Ton und kann Dich gar nicht hoeren.\n");

  AddDetail( ({"kitsch"}) ,
    "Etwas kitschig sieht der Gartenzwerg ja schon aus."
  );

  AddDetail( ({"hose","schuerze"}) ,
    "Der Gartenzwerg traegt eine gruene Hose und eine braune Schuerze."
  );

  AddDetail( ({"muetze","zipfelmuetze"}) ,
    "Wie es sich fuer einen Gartenzwerg gehoert, traegt dieser auch eine "
    "knallrote Zipfelmuetze."
  );

  AddDetail( ({"nase","knubbelnase"}) ,
    "Der Gartenzwerg hat mitten im Gesicht eine richtige Knubbelnase."
  );

  AddDetail( ({"backen","pausbacken"}) ,
    "Der Gartenzwerg lacht Dich mit seinen Pausbacken an."
  );

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Gartenzwerg ist nicht daran interessiert.\n" }) );

  SetChats(4,
    ({"Der Gartenzwerg fuehlt sich unbeobachtet und bohrt in der Nase.\n"
     ,"Der Gartenzwerg streicht sich ueber den Bart.\n"
     ,"Der Gartenzwerg streicht seine Schuerze glatt.\n"
     ,"Der Gartenzwerg lacht Dich an.\n"
     ,"Der Gartenzwerg streckt sich einmal kurz.\n"
     ,"Der Gartenzwerg bueckt sich und hebt etwas auf.\n"
     })
  );

}

init()
{
  ::init();

  call_out("getit", 0);
}

reset()
{
  ::reset();

  call_out("alleswech", 2);
}

getit()
{
  command_me("nimm alles");
}

alleswech()
{
  object *inv;
  int i;

  i = sizeof(inv = all_inventory(TO));
  while(i--) inv[i]->remove();
}

