#include "../def.h"

inherit NPC "stdnpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zwitschhansel");
  SetProp(P_LONG,
    "Ein Zwitschhansel ist ein kleiner lustiger Vogel, der immer zu kleinen "
    "Spaessen aufgelegt ist. Auch sein Zwitschern ist huebsch anzuhoeren."
  );

  SetProp(P_NAME, "Zwitschhansel");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15,T_RANGE_MAX:30]));
  AddId( ({"zwitschhansel","hansel","zwitschhansl","hansl","vogel"}) );
  AddClass( ({CL_ANIMAL,CL_FLYING}) );

  create_default_npc(5);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 20+random(5));
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOATTACK, "weicht Dir geschickt aus.\n");

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MNPC_AREA, ({ ROOM "hain", LABY , ROOM "steg2"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hain1");
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_SPECIAL);

  AddInfo(DEFAULT_INFO, "hoert Dir gar nicht zu.\n");

  SetChats(4,
    ({"Der Zwitschhansel pfeift eine lustige Melodie.\n"
     ,"Der Zwitschhansel fliegt um Deinen Kopf herum.\n"
     ,"Der Zwitschhansel faengt im Fluge eine Muecke.\n"
     ,BS("Der Zwitschhansel setzt sich auf Deine Schulter und pickt Dir "
         "sanft ins Ohrlaeppchen. Dann fliegt er wieder auf und davon.")
     ,"Der Zwitschhansel fliegt einen Looping.\n"
     })
  );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "will Dein Zeug nicht.\n" }) );
}

