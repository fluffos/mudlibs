void cursemsg(object pl)
{
  tell_object(pl,
    BSI("Na "+pl->name(WER)+", mal wieder gegen die Krieger der Dunkelfen "
    "gekaempft? Und wie ich sehe, beherrschen die Dunkelelfen den "
    "Dunkelzauber noch immer sehr gut. ", "Die Feenkoenigin schmunzelt: ")
  );
}

void questhint(object pl, int stat)
{
  string s;

  s = "";

  switch(stat)
  {
    case 1:
      s = "Ah, Du hast den Feenhut gefunden. Aber wieso ist denn da gar "
          "kein Schleier dran?";
      break;

    case 2:
      s = "Oh, der Hutschleier! Aber wo ist denn nur der Feenhut? Bitte "
          "sag dem Oberdiener, er moege sich doch beeilen, denn der "
          "Mitternachtstanz findet bald statt.";
      break;

    case 3:
      s = "Du hast den Feenhut und den Hutschleier gefunden! Nun aber fix "
          "den Schleier mit einer Hutnadel am Feenhut befestigen und zum "
          "Oberdiener bringen, damit er den Mitternachtstanz vorbereiten "
          "kann. ";
      break;

    case 4:
      s = "Du hast ja meine Hutnadel gefunden! Wo hatte ich die blos "
          "verloren? Naja egal, ich schenk sie Dir. ";
      break;

    case 5:
      s = "Du hast den Feenhut und die Hutnadel gefunden, jetzt fix noch "
          "den Schleier suchen und am Hut befestigen. ";
      break;

    case 6:
      s = "Du hast den Hutschleier und eine Hutnadel, aber wo ist denn "
          "nur der Feenhut geblieben?";
      break;

    case 7:
      s = "Oh, Hutschleier, Feenhut und Hutnadel, da kann der Mitternachts"
          "tanz ja bald beginnen. Du musst jetzt nur noch den Schleier "
          "am Hut befestigen und dem Oberdiener bringen, damit er den Tanz "
          "vorbereiten kann. Ich danke Dir schon jetzt dafuer. ";
      break;

    case 8:
      s = "Oh, Du hast den Feenhut dabei! Bring ihn bitte schnell zum "
          "Oberdiener, damit er den Mitternachtstanz vorbereiten kann. ";
      break;

  }

  if(s != "") tell_object(pl,BSI(s,"Die Feenkoenigin freut sich: "));
  return;
}

void init()
{
  object hut;
  int stat;

  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  if(present("DUNKELFLUCH",TP)) call_out("cursemsg",0,TP);

  if((hut = present("\nFEENHUT",TP)) && (hut->QueryProp(P_HUTZUSTAND) == 1))
  {
    stat = 8;
  }
  else
  {
    stat = 0;
    if(present("\nFEENHUT",TP))     stat += 1;
    if(present("\nHUTSCHLEIER",TP)) stat += 2;
    if(present("\nHUTNADEL",TP))    stat += 4;
  }

  if(stat > 0) call_out("questhint", 0, TP, stat);
}

string feeninfo()
{
  if("Fee"==TP->QueryProp(P_RACE))
  {
    return "Du bist doch eine. Weisst Du denn nicht ueber Dich bescheid?";
  }
  else
  {
    return BS("Das Wesen der Feen koenntest Du nur verstehen, wenn Du selbst "
              "eine waerest.");
  }
}

string belohnung()
{
  string s;
  object rolle;
  int tmp;


  if(!TP->QueryQuest(AMAQUEST))
  {
    return "Du hast Dir noch keine Belohnung verdient!\n";
  }

  if(present("\nABENTEUERROLLE",TP))
  {
    return "Aber Du hast doch schon eine Belohnung!\n";
  }

  rolle = clone_object(OBJ "abenteuerrolle");

  tmp = rolle->move(TP,M_GET);

  if(tmp == 1)
  {
    rolle->SetProp(P_NODROP, BS("Wenn Du Deine Schriftrolle nicht mehr "
                                "haben moechtest, dann zerreisse sie doch "
                                "einfach. "));
    rolle->SetProp(P_NEVERDROP, 1);
    rolle->SetProp(P_NOSELL, 1);

    return "Fuer Deine Muehen gebe ich Dir diese Schriftrolle. Sie wird ganz "
           "alleine Deine ganzen Abenteuer aufzeichnen. ";
  }

  rolle->remove();

  return "Ich wuerde Dir ja gerne eine Belohnung geben, aber leider kannst "
         "Du nichts mehr tragen. ";

}

void zeige(object player, object thing)
{
  thing->command_me("zeige "+getuid(player)+" zauberstab");
}

string zauberstab()
{
  if(present("zauberstab",TO))
  {
    call_out("zeige",0,TP,TO);
    return "Meinst Du den hier?\n";
  }
  else
  {
    return "Das moechte ich auch gerne wissen, wo der schon wieder ist. "
           "Wo hab ich den denn bloss hingelegt?";
  }
}

void rauswerfen(object player)
{
  tell_object(player,"Die Feenkoenigin wirft Dich in hohem Bogen aus dem "
                     "Zimmer.\n");

  player->move(ROOM "sgang15",M_GO,"von der Feenkoenigin hinausgeworfen","wird",
               "fliegt in hohem Bogen hinein");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(TP && interactive(TP) && FMASTER->IsEnemy(TP)) return;

  if(callouts > 5) return;

  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin sagt: Du Memme!\n",
        BSI("Was fuer eine Memme "+TP->name(WER)+" doch ist.","Die Feenkoenigin sagt: ")
      );
      break;

    case "aergerlich":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin taetschelt Dir den Kopf.\n",
        "Die Feenkoenigin taetschelt "+TP->name(WEM)+" den Kopf.\n"
      );
      break;

    case "albern":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin laechelt Dich mitleidig an.\n",
        "Die Feenkoenigin laechelt "+TP->name(WEN)+" mitleidig an.\n"
      );
      break;

    case "fies":
      call_out("reaction", 0, TP, 2,
        "Die Feenkoenigin wird ernstlich wuetend.\n",
        "Die Feenkoenigin wird ernstlich wuetend.\n"
      );
      break;

    case "frech":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin sagt: Lass das!\n",
        "Die Feenkoenigin sagt: Lass das, "+TP->name()+"!\n"
      );
      break;

    case "froh":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin sagt: Du bist aber gut drauf heute!\n",
        "Die Feenkoenigin sagt: Du bist aber gut drauf heute, "+TP->name()+"!\n"
      );
      break;

    case "intim":
      call_out("reaction", 0, TP, 1,
        "Die Feenkoenigin gibt Dir eine Ohrfeige, das es nur so schallt.\n",
        "Die Feenkoenigin gibt "+TP->name(WEM)+" eine Ohrfeige, das es nur so "
        "schallt.\n"
      );
      break;

    case "nett":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin scheint noch eitler zu werden.\n",
        "Die Feenkoenigin scheint noch eitler zu werden.\n"
      );
      break;

    case "neutral":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin beachtet Dich gar nicht.\n",
        "Die Feenkoenigin beachtet "+TP->name(WEN)+" gar nicht.\n");
      break;

    case "traurig":
      call_out("reaction", 0, TP, 0,
        "Die Feenkoenigin troestet Dich.\n",
        "Die Feenkoenigin troestet "+TP->name(WEN)+".\n");
      break;
  }
  callouts++;
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object player, int action, string macher, string andere)
{
  if (present(player, ENV(player)))
  {
    tell_object(player, macher );
    tell_room(ENV(player), andere, ({player}));

    switch(action)
    {
      case 0:
        break;

      case 1:
        rauswerfen(player);
        break;

      case 2:
        Kill(player);
        break;
    }
  }
  callouts--;
}

void meckern(object room, object player)
{
  tell_room(room, BSI("He, was soll denn das? Hier drin ist doch alles sauber! "
                      "Mach gefaelligst draussen weiter!"
                     ,"Die Feenkoenigin entruestet sich: "));

  if(player && interactive(player) && present(player,room))
  {
    rauswerfen(player);
  }

  FMASTER->Msg("Die Feenkoenigin meckert, weil gefegt wurde");
  return;
}

void meckern2(object room)
{
  object ob;

  if(!(ob = present("_furz_",room))) return;

  react_on_fart = time()+5;

  ob->remove();
  tell_room(room, BSI("Was fuer ein Gestank!","Die Feenkoenigin entruestet "
                      "sich: ")+
                  BS("Die Feenkoenigin oeffnet das Fenster, laesst den "
                     "Gestank entweichen und schliesst danach das Fenster "
                     "wieder.")
  );

  FMASTER->Msg("Die Feenkoenigin meckert, weil gefurzt wurde");
  return;
}

void catch_tell(string str)
{
  string who;
  object room;

  if(!(room=ENV(TO))) return;
  if(InFight())       return;

  if(sscanf(str,"%s schwingt einen Besen und wirbelt eine Menge Staub auf.",who)==1)
  {
    call_out("meckern",0,room,TI);
  }

  if((time() > react_on_fart) && present("_furz_",room)) // nur wenn nicht
  {                                                      // vor kurzem darauf
    react_on_fart = time()+5;                            // reagiert
    call_out("meckern2",0,room);
  }

  return;
}

void handlegems(object ob,object player)
{
  string s;
  int num;
  object gems, curse;

  tell_room(ENV(TO),BS("Die Feenkoenigin und "+player->Name()+" sind in ein "
                       "Gespraech verwickelt."),({player}));

  num = ob->QueryProp(P_GIVEN_AMOUNT);

  if(num < ZAUBERKOSTEN)
  {
    tell_object(player,BSI("Was soll ich mit "+num+
                           (num==1?" Aquamarin":" Aquamarinen")+"? Wenn ich "
                           "Deinen Dunkelzauber entfernen soll, dann kostet "
                           "das "+ZAUBERKOSTEN+" Aquamarine.",
                           "Die Feenkoenigin meint: "));

    if(gems=present("aquamarin",player))
    {
      gems->SetProp(P_AMOUNT,gems->QueryProp(P_AMOUNT)+num);
      ob->remove();
    }
    else
    {
      ob->SetProp(P_AMOUNT,num);
      ob->move(player,M_NOCHECK|M_GIVE);
    }
    return;
  }

  FMASTER->Msg(TPUID+" gibt der Feenkoenigin die Aquamarine");

  if(num == ZAUBERKOSTEN)
  {
    s = "So lass uns beginnen, den Dunkelzauber zu brechen. ";
  }
  else
  {
    s = "Normalerweise entferne ich den Dunkelzauber schon fuer "+ZAUBERKOSTEN+
        " Aquamarine, aber fuer "+num+" Aquamarine werde ich mir natuerlich "
        "besondere Muehe geben. ";
  }

  tell_object(player,BSI(s,"Die Feenkoenigin sagt: "));

  tell_object(player,BS("Die Feenkoenigin holt aus ihrem Kleid ein Irrlicht "
                       "hervor und murmelt ein paar Dir unverstaendliche "
                       "Worte. Kurz danach erstrahlt das Irrlicht und huellt "
                       "Dich in gleissendes Licht."));

  tell_room(ENV(TO),BS("Die Feenkoenigin holt aus ihrem Kleid ein Irrlicht "
                       "hervor und murmelt ein paar unverstaendliche "
                       "Worte. Kurz danach erstrahlt das Irrlicht und "
                       "huellt "+player->name(WEN) + " in gleissendes "
                       "Licht."), ({player}) );
  ob->remove();

  if(curse = present("DUNKELFLUCH", player)) curse->remove(0);

  return;
}

void QuestLog(string s)
{
  write_file("/log/quests/amaring",dtime(time())+" : "+s+"\n");
}

void handleamagem(object gem, object pl)
{
  tell_object(pl,BSI("Hmmm, ein interessanter Edelstein. Ich kann seine "
                     "Macht spueren. Vielleicht ist es ein Teil von "
                     "Amaltheas Ring. Nur mit dem Edelstein kann ich aber "
                     "nichts anfangen.",
                     Name(WER,1)+" sagt nachdenklich: "));

  tell_object(pl, Name(WER,1)+" gibt Dir den Edelstein zurueck.\n");
  gem->move(pl,M_NOCHECK|M_GIVE|M_SILENT);
}

void handlering(object ring, object pl)
{
  int result;
  string tpuid;
  object room,ob;

  if(!ring->QueryGem())
  {
    tell_object(pl, BSI("Ja, das koennte durchaus Amaltheas Ring sein. "
                        "Allerdings trug Amaltheas Ring einen weissen "
                        "Edelstein. So ist er nutzlos.",
                        Name(WER,1)+" sagt nachdenklich: "));
    tell_object(pl, Name(WER,1)+" gibt Dir den Ring zurueck.\n");
    ring->move(pl, M_NOCHECK|M_GIVE|M_SILENT);
    return;
  }

  tell_object(pl,
    BSI("Ja! Amaltheas Ring! Nun koennen wir das Boese wieder "
        "besser bekaempfen. Ich danke Dir fuer Deine Muehen. Dafuer hast "
        "Du natuerlich eine Belohnung verdient.",
        Name(WER,1)+" ist hocherfreut: ")
  );

  ring->remove();

  result = pl->GiveQuest(AMAQUEST);
  tpuid  = CAP(getuid(pl));
  room   = ENV(TO);

  switch(result)
  {
    case  1:
      RINGMASTER->DeleteRingQuester(getuuid(pl));

      QuestLog(tpuid+" loest die Quest zum ersten Mal." );

      ob = clone_object(OBJ "abenteuerrolle");
      if(ob->move(pl, M_GET) == 1)
      {
        tell_object(pl, "Die Feenkoenigin ueberreicht Dir eine Schriftrolle.\n");
        ob->SetProp(P_NODROP, BS("Wenn Du Deine Schriftrolle nicht mehr "
                                 "haben moechtest, dann zerreisse sie doch "
                                 "einfach. "));
        ob->SetProp(P_NEVERDROP, 1);
      }
      else
      {
        tell_object(pl, BS("Die Feenkoenigin moechte Dir Deine Belohnung "
                           "geben, aber Du kannst nichts mehr tragen. "));
        ob->remove();
      }
      break;

    case -1:
      RINGMASTER->DeleteRingQuester(getuuid(pl));
      QuestLog(tpuid+" loest die Quest zum wiederholten Mal.");
      break;

    case -2:
      RINGMASTER->DeleteRingQuester(getuuid(pl));
      QuestLog(tpuid+" loest die Quest, aber die Quest ist nicht eingetragen.");
      tell_room(room,"Die Quest ist noch nicht eingetragen.\n");
      break;

    case -3:
      RINGMASTER->DeleteRingQuester(getuuid(pl));
      QuestLog(tpuid+" loest die Quest, Fehler unbefugter Zugriff.");
      tell_room(room,"Unbefugter Zugriff.\n");
      break;

    case -4:
      RINGMASTER->DeleteRingQuester(getuuid(pl));
      QuestLog(tpuid+" loest die Quest, aber die Quest ist nicht aktiv.");
      tell_room(room,"Die Quest ist derzeit deaktiviert.\n");
      break;

     default:
      QuestLog(sprintf("%s loest die Quest, aber unbekannter Fehler %d",tpuid,result));
      tell_room(room,sprintf("Unbekannter Fehler bei der Questvergabe: %d\n",result));
      break;
  }

  return;
}

void give_notify(object ob)
{
  if(ob->id("\namagem"))
  {
    handleamagem(ob,TP);
    return;
  }

  if(present("DUNKELFLUCH",TP) && ob->id("EDELSTEIN") && ob->id("aquamarin"))
  {
    handlegems(ob,TP);
    return;
  }

  if(ob->id("\nAMARING"))
  {
    handlering(ob,TP);
    return;
  }

  return ::give_notify(ob);
}

