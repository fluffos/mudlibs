#include "../def.h"

inherit NPC "castlenpc";
inherit "std/npc/spells";

#define ZAUBERKOSTEN 5

string feeninfo();
string zauberstab();
string belohnung();

int callouts;
int react_on_fart;

public string barden_zauber() {
  string answer;

  answer = "Das groesste Zauberlied, das wir Feen kennen hilft uns unsere Magie "
           "regelmaessig zu erneuern und zu verstaerken. Wir tanzen unseren "
           "Mitternachtstanz dazu. Es wurde vor langer langer Zeit von Alestra "
           "komponiert, die die Inspiration dazu von der Goettin Alinja erhalten hat.";

  if(this_player()->QueryProp(P_GUILD) != "bardengilde") return answer; 
  if(this_player()->QuerySkill("lied der zauber") != 0) return answer;

  if(this_player()->QueryQuest("Mitternachtstanz der Feen") == 1) {  
    answer += "Ich habe hier ein kleines Geschenk fuer dich, da du uns bei unserem "
              "Mitternachtstanz geholfen hast!";
    call_out("give_spieluhr", 0);
  } else {
    answer += "Da du selbst zur Bardengilde gehoerst, kann ich dir ein Geschenk geben, "
              "welches dir helfen sollte dieses Zauberlied zu erlernen. Aber zuerst "
              "musst du uns dabei helfen den Mitternachtstanz zu vollfuehren!";
  }

  return answer;
}

public void give_spieluhr() {
  object ob;
  if(!objectp(this_player())) return;
  if(this_player()->QueryProp(P_GUILD) != "bardengilde") return; 
  if(this_player()->QuerySkill("lied der zauber") != 0) return;

  if(objectp(present("\nbard_spieluhr", this_player()))) {
    command_me("sag Aber du hast mein Geschenk doch schon erhalten!");
    return;
  }

  command_me("sag Danke, dass du uns geholfen hast! Dies hier hat uns Alestra hinterlassen.");

  ob = clone_object("/gilden/bardengilde/obj/quest/spieluhr");
  if(ob->move(this_player()) != 1) {
    command_me("sag Ohje! Du kannst das gerade nicht tragen. Komm einfach spaeter wieder!");
    ob->remove(1);
    return;
  }
  
  tell_room(environment(this_object()), BS(Name(WER, 1) + " gibt " + this_player()->name(WEM, 1) + " eine kleine Schatulle."), ({this_player()}));
  tell_object(this_player(), BS(Name(WER, 1) + " gibt dir eine kleine Schatulle."));

  return;
}

