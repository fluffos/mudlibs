#include "../def.h"

inherit NPC "stdnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Der Wichtel Skord");
  SetProp(P_LONG,
    "Das ist Skord, ein kleiner Wichtel. Er rudert die Gaeste des "
    "Feenschlosses ueber den Silberteich. Trotzdem er so klein ist, "
    "ist er sehr kraeftig, so dass es ihm nur wenig Muehe bereitet, "
    "jeden Tag zu rudern. "
  );

  set_living_name("skord");
  AddId( ({"skord","wichtel","NOWIMPY"}) );
  AddClass("wichtel");

  create_default_npc(15);

  SetProp(P_HP, 600+random(50));
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit einem Ruder", 500, DT_BLUDGEON}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Skord");
  SetProp(P_RACE, "Wichtel");
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 125);
  SetProp(P_WEIGHT, 45000);
  SetProp(P_WIMPY, 0);

  AddInfo(DEFAULT_INFO, "schimpft: Lass mich in Ruhe rudern.\n");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object ticket;
  string ziel;

  FMASTER->Msg("Skord wurde gerade von "+UID(enemy)+" angegriffen");

  enemy->StopHuntFor(TO,1);
  StopHuntFor(enemy,1);

  ticket = present("\nTICKET", enemy);

  if(!ticket)
  {
    tell_object(enemy, "Lass mich in Ruhe rudern!\n");
    return 0;
  }

  if(ticket->id("\nTICKET1")) ziel = ROOM "steg1";
  if(ticket->id("\nTICKET2")) ziel = ROOM "steg2";

  tell_object(enemy,BS("Skord weicht Deinem Angriff geschickt aus, steht "
                       "kurz auf und verpasst Dir mit einem Ruder einen "
                       "dermassen heftigen Schlag, dass Du kopfueber ins "
                       "Wasser faellst."));
  tell_room(ENV(TO),BS("Skord weicht "+enemy->Name(WESSEN)+" Angriff "
                       "geschickt aus, steht kurz auf und verpasst "
                       +enemy->Name(WEM)+" einen so starken Schlag mit dem "
                       "Ruder, dass "+enemy->QueryPronoun(WER)+" kopfueber "
                       "ins Wasser faellt. "), ({enemy}) );

  enemy->do_damage(50);

  if(!enemy->QueryProp(P_GHOST))
  {
    tell_object(enemy,BS("Du schwimmst wieder an den Steg zurueck "
                         "und ziehst Dich aus dem kalten Wasser wieder "
                         "hinauf."));

    enemy->move(ziel,M_GO|M_SILENT);
    tell_room(ENV(enemy),BS(enemy->Name(WER)+" kommt triefnass aus dem "
                            "eiskalten Wasser geklettert."), ({enemy}) );
  }

  return 0;
}

