    ,
    "sagt: "
  );

  AddInfo( ({"schal"}) ,
    "So kalt ist es hier nun auch nicht. "
    ,
    "sagt: "
  );

  AddInfo( ({"zylinder"}) ,
    "Damit kann ich klasse Zauberstuecke vorfuehren. "
    ,
    "sagt: "
  );

  AddInfo( ({"vorfuehrung","vorfuehren"}) ,
    "Jetzt nicht. "
    ,
    "sagt: "
  );

  AddInfo( ({"zauberspruch","spruch","zaubersprueche","zauberspruechen"
            ,"schrift"}) ,
    "Es sind meine gescheiterten Versuche, diesen Turm zu verlassen. "
    ,
    "meint: "
  );

  AddInfo( ({"brunnen"}) ,
    "Der hat schon seit ich hier bin kein Wasser mehr. "
    ,
    "sagt: "
  );

  AddInfo( ({"zeit"}) ,
    "Das ist schon lange, lange her. "
    ,
    "sagt: "
  );

  AddInfo( ({"dienst"}) ,
    "Ich habe das Labyrinth verzaubert, so dass sich nur noch die Feen "
    "darin zurechtfinden. "
    ,
    "sagt: "
  );

  AddInfo( ({"labyrinth"}) ,
    "Das ist mir so gut gelungen, da verlaufe selbst ich mich. Das heisst, "
