     ,"Der Magier murmelt etwas in seinen Bart.\n"
     ,"Der Magier sagt erzuernt: Wenn ich dieses Kaninchen erwische ...\n"
     ,"Der Magier zaubert ein Kaninchen aus seinem Hut.\n"
     ,"Der Magier seufzt: Wieso lassen mich die Feen nicht heraus?\n"
     ,"Der Magier sagt: Hast Du vielleicht einen Zauberstab fuer mich?\n"
     ,"Der Magier sucht verzweifelt nach seinem Zauberstab.\n"
     })
  );

  SetAttackChats(20,
    ({"Der Magier macht: Buh!\n"
     ,"Der Magier wirft mit weissen Maeusen nach Dir.\n"
     ,"Der Magier sagt: Das war ein grosser Fehler!\n"
     ,"Der Magier beisst Dich in den Arm.\n"
     ,"Der Magier zaubert blaue Flecken auf deine Nase.\n"
     ,"Der Magier verwandelt sich in eine Kroete.\n"
     ,"Der Magier verschwindet und taucht hinter Dir wieder auf.\n"
     ,"Der Magier versucht Dich in einen Zylinderhut zu stecken.\n"
     })
  );

  SetProp(P_DIE_MSG,
    " loest sich in Krach und Donner, Blitz und Laerm auf.\n"
  );

  SetProp(P_DEFAULT_INFO, "sagt: Frag mir keine Loecher in den Bauch.\n");

  AddInfo( ({"loch","loecher","bauch"}) ,
    "Wenn Du weiter soviel fragst, krieg ich noch Loecher im Bauch."
    ,
    "grummelt Dich an: "
  );

  AddInfo( ({"oel","schmieroel"}) ,
    "Das habe ich letzte Woche schon aufgebraucht."
    ,
    "sagt: "
  );

  AddInfo( ({"feenhut"}) ,
    "Fuer was brauch ich den? Ich hab doch meinen Zylinder."
    ,
    "sagt: "
  );

  AddInfo( ({"diener"}) ,
    "Die koennten ruhig mal hier oben sauber machen."
    ,
    "sagt erzuernt: "
  );

  AddInfo( ({"oberdiener"}) ,
    "Der steht nur den ganzen Tag herum und kommandiert die anderen herum. "
