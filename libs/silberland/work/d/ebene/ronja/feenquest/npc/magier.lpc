    ,
    "sagt: "
  );

  AddInfo( ({"sterne","stern"}) ,
    "Die kannst Du nie und nimmer sehen."
    ,
    "meint: "
  );

  AddInfo( ({"hilfe","problem"}) ,
    "Koenntest Du mir einen Zauberstab bringen? Bitte! Ich will hier wieder "
