     "Der Magier wirft einen riesigen Feuerball nach Dir.\n",
     "Der Magier wirft einen riesigen Feuerball nach @WEM.\n",
           DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,380,
     "Der Magier beschwoert einen Sturm ueber deinem Kopf hervor.\n",
     "Der Magier beschwoert einen Sturm ueber @WESSEN Kopf hervor.\n",
