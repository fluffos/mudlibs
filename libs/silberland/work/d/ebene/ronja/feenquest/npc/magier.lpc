    ,
    "fleht Dich an: "
  );

  AddInfo( ({"magier"}) ,
    "Ich bin doch einer."
    ,
    "schaut Dich verwundert an: "
  );

  AddInfo( ({"schloss","feenschloss"}) ,
    "Ich wuerd so gerne das Schloss wieder verlassen. "
    ,
    "sagt: "
  );

  AddInfo( ({"zauber"}) ,
    "Irgendein Zauber haelt mich hier gefangen. Wenn ich einen Zaubestab "
    "haette, dann koennte ich ihn vielleicht brechen. "
    ,
    "sagt: "
  );

  AddInfo( ({"bart"}) ,
    "Ich kann das Schloss nicht verlassen, und hier kann ich mich nicht "
    "rasieren. "
    ,
    "sagt: "
  );

//**************************************************************************

  AddInfo( ({"amalthea", "ring", "amaltheas", "amaltheas ring"}),
      "Die Feenkoenigin sucht Amaltheas Ring. Auch mich hat sich beauftragt, "
      "etwas ueber den Verbleib des Ringes herauszufinden.", "sagt: ");

  AddInfo( ({"verbleib"}),
      "Der Ring ist in zwei Teile zerborsten, soviel habe ich herausgefunden.", 
      "sagt: ");

  AddInfo( ({"teile", "teil"}),
      "Einen Teil haben wohl die Hexen, der andere koennte sich in einem "
      "weit entfernten Land befinden.", "sagt: ");

  AddInfo( ({"hexen", "hexe"}),
      "In der Naehe von Polaris wohnt eine Hexe in einem Moor, sie nennt sich "
      "Oma Wetterwachs.", "sagt: ");

  AddInfo( ({"polaris", "moor"}),
      "Polaris befindet sich oestlich von Derlim, in einem Moor.", "sagt: ");

  AddInfo( ({"derlim"}),
      "Derlim, die Stadt der Hobbits, befindet sich weit im Westen.", "sagt: ");

  AddInfo( ({"hobbit", "hobbits", "wesen"}),
      "Kleine stark behaarte Wesen.", "sagt: ");

  AddInfo( ({"oma", "oma wetterwachs", "wetterwachs"}),
      "Sie koennte einen Teil von Alamtheas Ring haben, aber sie wird den "
      "sicher nicht freiwillig hergeben. Vielleicht kannst Du einen Trick "
      "anwenden, um ihn zu bekommen.", "sagt: ");

  AddInfo( ({"trick"}),
      "Ich kenne den Trick nicht, aber sieh Dich mal bei Oma Wetterwachs "
      "um, vielleicht findest Du ja etwas.", "sagt: ");

  AddInfo( ({"land", "fernes land", "fernem land"}),
      "Ein Teil von Amaltheas Ring befindet sich geruechterweise in einem "
      "fernen Land. Um dort hinzukommen, musst Du allerdings Reiten, "
      "es ist zu weit weg fuer einen Fussmarsch.", "sagt: ");
      
  AddInfo( ({"reiten", "fussmarsch"}),
      "Wenn Du Reiten lernen willst, im Osten des Schlosses gibt es eine "
      "Pferdekoppel.", "sagt: ");

  AddInfo( ({"koppel", "pferdekoppel", "pferde"}),
      "Die Pferdekoppel liegt im Osten des Schlosses. Du erreichst sie "
      "ueber die Tuer im Suedostturm.", "sagt: ");

  AddInfo( ({"suedosteturm", "tuer"}),
      "Die Tuer im Suedostturm fuehrt zur Pferderkoppel. Sie ist aber sehr "
      "gut gesichert, damit niemand die Pferde stehlen kann.", "sagt: ");
  
  SetProp( P_REJECT,
    ({ REJECT_KEEP, "Der Magier bedankt sich bei Dir.\n" })
  );
}

give_notify(ob)
{
  if(ob->id("zauberstab"))
  {
    EPMASTER->GiveExplorationPoint("zauberstab", EP_MISC);
    call_out("stabbekommen", 0, 1, TP);
    FMASTER->Msg(TPUID+" gibt dem Magier den Zauberstab");
    return 1;
  }
  return ::give_notify(ob);
}

void stabbekommen(int seq, object pl)
{
  object *ob;
  int i;

  switch(seq)
  {
    case 1 :
      command("sage Endlich. Vielen Dank. Nun kann ich endlich das "
              "Schloss verlassen.\n");
     break;

    case 2 :
      tell_room(ENV(TO), BS("Der Magier fuehrt einige merkwuerdige "
                              "Bewegungen mit dem Zauberstab aus. "));

    case 3 :
      command("sage Ja, es ist geglueckt.");

    default :
      TO->move("/room/npcasylraum", M_GO,
               "nach unten", "stuermt", "stuermt nach unten");
      ob = all_inventory(TO);
      i = sizeof(ob);
      while(i--) ob[i]->remove();
      TO->remove();
      return;
  }

  call_out("stabbekommen", 4, ++seq, pl);
}


