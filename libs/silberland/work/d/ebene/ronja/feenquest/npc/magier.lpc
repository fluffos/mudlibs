#include "../def.h"

inherit NPC "castlenpc";

#include <exploration.h>

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Magier");
  SetProp(P_LONG,
    "Dieser Magier zaubert wie wild und schwingt dabei seinen langen Bart. "
    "Hoffentlich hast Du keine Boshaftigkeit vor, denn das mag er gar nicht."
  );

  SetProp(P_NAME, "Magier");
  SetProp(P_GENDER, MALE);
  AddId( ({"magier","zauberer"}) );
  AddClass(CL_HUMAN);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160+random(25) );

  create_default_npc(19);
  SetProp(P_ALIGN, -400);
  SetProp(P_HANDS, ({" mit Magie", QueryProp(P_HANDS)[1], DT_MAGIC}) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE, ({ DT_MAGIC }));
  SetProp(P_VULNERABILITY, ({ DT_COLD }));

  SetProp(P_MMSGIN, "kommt unter dem Tisch hervorgekrochen");
  SetProp(P_MSGIN,  "kommt unter dem Tisch hervorgekrochen");

  SetProp(P_LOG_INFO, "/ronja/magier");

  SUID;

  if( random(100)>50 ) CLONEME("/p/armour/helm/magierkappe");
  if( random(100)>50 ) CLONEME("/p/armour/armour/seidenjacke");
  if( random(100)>50 ) CLONEME("/p/armour/trousers/seidenhose");
  if( random(100)>50 ) CLONEME("/p/armour/boots/seidenschuhe");

  CLONEME(WEAPON "mschwert.lpc");
  command("zuecke schwert");
  command("trage alles");

  SetProp(P_SPELLRATE,70);
