void reset()
{
  ::reset();

  callouts = 0;
}

void init()
{
  ::init();

  call_out("getit", 0);
}

remove(int arg)
{
  FMASTER->DeleteServant(file_name(TO));

  ::remove(arg);
}

int gettest(object ob)
{
  if(living(ob))                 return 0;
  if(interactive(ob))            return 0;
  if(query_once_interactive(ob)) return 0;
  if(ob->id("leiche"))           return 0;
  if(ob->id("papier"))           return 0;

  return 1;
}

void getit()
{
  object *inv,*obs;
  int i,nbesenvorher,nbesennachher,res;

  inv = filter_objects(all_inventory(TO), "id", "\nBESEN");
  nbesenvorher = sizeof(inv);

  obs = filter_array(all_inventory(ENV(TO)),"gettest");
  i = sizeof(obs);
  while(i--)
  {
    if(obs[i]->move(TO,M_GET) == 1)
    {
      tell_room(ENV(TO),TO->Name(WER,0)+" nimmt "+obs[i]->name(WEN,0)+".\n");
    }
  }

  inv = filter_objects(all_inventory(TO), "id", "\nBESEN");
  nbesennachher = sizeof(inv);

  if(nbesenvorher != nbesennachher)
  {
    switch(nbesennachher)
    {
      case 0 :
        break;

      case 1 :
        tell_room(ENV(TO), "Der Diener grummelt: Ich dachte, ich braeuchte "
                           "heute nicht zu fegen.\n");
        command_me("zueck besen");
        command_me("fege mit besen");
        break;

      default :
        tell_room(ENV(TO),
          "Der Diener grummelt: Wer laesst denn hier die ganzen Besen herumliegen.\n");
        break;
    }
  }
}

void give_notify(object obj)
{
  if(obj->id("besen"))
  {
    if(sizeof(filter_objects(all_inventory(TO), "id", "besen")) > 1)
    {
      TELLPLAYER(BSI("Danke, aber ich habe schon einen.",
                     "Der Diener mault dich an: "));
      obj->move(TP, M_GIVE|M_NOCHECK);
      FMASTER->Msg(TPUID+" versucht einem Diener einen Besen zu geben");
      return;
    }
    else
    {
      TELLPLAYER(BSI("Ich dachte, ich braeuchte heute nicht zu fegen.",
                     "Der Diener grummelt Dich an: "));
      command_me("zueck besen");
      command_me("fege mit besen");
      FMASTER->Msg(TPUID+" gibt einem Diener einen Besen");
      return;
    }
  }

  return ::give_notify(obj);
}

string beseninfo()
{
  if(present("besen",TO))
  {
    return "Was glaubst Du denn, womit ich hier sauber mache?\n";
  }
  else
  {
    return "Das moechte ich auch gerne wissen, wer den schon wieder "
           "versteckt hat.\n";
  }
}

string hilfeinfo()
{
  object besen;
  string s;

  s = BS("Schnapp Dir einen Besen und mach hier sauber. Das waere eine "
         "echte Hilfe.");

  if(besen = present("besen",TO))
  {
    besen->DoUnwear(1);

    if(ME_TOO_HEAVY==besen->move(TP,M_GET|M_SILENT))
    {
      besen->move(TO,M_NOCHECK|M_SILENT);
      besen->DoWear(1);
    }
    else
    {
      s = "";
      TELLPLAYER(BSI("Du willst mir helfen? Find ich echt Klasse!",
                     "Der Diener sagt : "));
      TELLPLAYER(BS("Der Diener drueckt Dir einen Besen in die Hand."));
      TELLPLAYER(BSI("Da, Du kannst fuer mich putzen!","Der Diener sagt : "));
      TELLOTHERS(BS("Der Diener drueckt "+TPN+" einen Besen in die Hand "
                    "und grinst verschmitzt."));
    }
  }

  return s;
}

string besenchat()
{
  if(present("besen",TO))
  {
    return "Der Diener grummelt: Fegen macht ja soviel Spass.\n";
  }
  else
  {
    return "Der Diener schreit: Wer hat meinen Besen schon wieder "
           "genommen?\n";
  }
}

string putzen()
{
  if(present("besen",TO))
  {
    command_me("fege mit besen");
    return "Der Diener grummelt: Fegen macht ja soviel Spass.\n";
  }
  else
  {
    return "Der Diener freut sich: Heute bin ich nicht mit fegen dran.\n";
  }

}

void trinken2()
{
  SetProp(P_MMSGOUT, "ist durstig und eilt davon");
  SetProp(P_MSGOUT, "ist durstig und eilt#");
  wandern();
  SetProp(P_MMSGOUT, "hoert eine Fee nach ihm rufen und eilt davon");
  SetProp(P_MSGOUT, "hoert eine Fee nach ihm rufen und eilt#");
}

string trinken()
{
  call_out("trinken2",0);
  return "Der Diener sagt: Ich geh jetzt erstmal was trinken.\n";
}

string trinken3()
{
  string s;

  if(InFight())
  {
    s = "Ich bin momentan zu beschaeftigt.\n";
  }
  else
  {
    call_out("trinken2",0);
    s = "Das ist ein gute Idee.\n";
  }

  return s;
}

void meckern(object room, int i)
{
  switch(1)
  {
    case 0:
      tell_room(room, BSI("He, was soll denn das? Wirbel nicht so viel "
                          "Staub auf, Du machst ja alles wieder dreckig."
                         ,"Der Diener schimpft: "));
    break;

    case 1:
      tell_room(room, BSI("Ja klasse, und wer darf das jetzt wieder alles "
                          "wegmachen? Ich natuerlich!"
                         ,"Der Diener meckert: "));
      wandern(0);
    break;
  }

  return;
}

void catch_tell(string str)
{
  string who;
  int n;

  if(!ENV(TO)) return;
  if(InFight()) return;

  if(sscanf(str,"%s schwingt einen Besen und wirbelt eine Menge Staub auf.",who)==1)
  {
    call_out("meckern",0,ENV(TO),0);
  }

  if(sscanf(str, "%s zerreisst ein Pergament in %d kleine Fetzen!", who, n) == 2)
  {
    call_out("meckern",0,ENV(TO),1);
  }

  return;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(TP && interactive(TP) && FMASTER->IsEnemy(TP)) return;

  if(callouts > 5) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP, 0,
        "Der Diener sagt: Du Memme!",
        "Der Diener sagt: Du bist eine Memme, "+TP->name()+"!\n"
      );
      break;

    case "aergerlich":
      call_out("reaction", 0, TP, 0,
        "Der Diener taetschelt Dir den Kopf.\n",
        "Der Diener taetschelt "+TP->name(WEM)+" den Kopf.\n"
      );
      break;

    case "albern":
      call_out("reaction", 0, TP, 0,
        "Der Diener sagt muerrisch: Alber hier nicht so rum sondern hilf mir "
        "lieber.\n",
        "Der Diener sagt muerrisch: Hilf mir lieber, "+TP->name()+".\n"
      );
      break;

    case "fies":
      if(present("besen",TO))
      {
        call_out("reaction", 0, TP, 1,
          "Der Diener haut Dir mit dem Besen auf den Kopf.\n",
          "Der Diener haut "+TP->name(WEM)+" den Besen auf den Kopf.\n"
        );
      }
      else
      {
        call_out("reaction", 0, TP, 2,
          "Der Diener murmelt: Na sowas aber auch.\n",
          "Der Diener murmelt: Na sowas aber auch.\n"
        );
      }
      break;

    case "frech":
      call_out("reaction", 0, TP, 0,
        "Der Diener sagt: Lass das!\n",
        "Der Diener sagt: Lass das, "+TP->name()+"!\n"
      );
      break;

    case "froh":
      call_out("reaction", 0, TP, 0,
        "Der Diener sagt: Du bist aber gut drauf heute!\n",
        "Der Diener sagt: Du bist aber gut drauf heute, "+TP->name()+"!\n"
      );
      break;

    case "intim":
      if(TP->QueryProp(P_GENDER) == MALE)
      {
        call_out("reaction", 0, TP, 0,
          "Der Diener sagt: Lass das! Ich bin keiner vom anderen Ufer!\n",
          "Der Diener sagt: Lass das! Ich bin keiner vom anderen Ufer!\n"
        );
      }
      else
      {
        call_out("reaction", 0, TP, 0,
          "Der Diener fluestert Dir zu: Komm heute abend in meine Kammer.\n",
          "Der Diener fluestert "+TP->name(WEM)+" etwas zu.\n"
        );
      }
      break;

    case "nett":
      call_out("reaction", 0, TP, 0,
        "Die Diener sagt: Erzaehl Du nur, ich hab zu tun.\n",
        "Der Diener sagt etwas zu "+TP->name(WEM)+".\n"
      );
      break;

    case "neutral":
      call_out("reaction", 0, TP, 0,
        "Der Diener beachtet Dich gar nicht.\n",
        "Der Diener beachtet "+TP->name(WEN)+" gar nicht.\n");
      break;

    case "traurig":
      call_out("reaction", 0, TP, 0,
        "Der Diener troestet Dich.\n",
        "Der Diener troestet "+TP->name(WEN)+".\n");
      break;
  }
  callouts++;
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, int action, string macher, string andere)
{
  if (present(ob, ENV(TO)))
  {
    tell_object(ob, macher );
    tell_room(ENV(TO), andere, ({ob}));

    switch(action)
    {
      case 0:
        break;

      case 1:
        ob->AddHp(-15);
        break;

      case 2:
        wandern();
        break;
    }

  }
  callouts--;
}
