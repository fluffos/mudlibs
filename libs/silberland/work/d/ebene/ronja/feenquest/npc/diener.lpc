    ,
    "grinst verschmitzt: "
  );

  AddInfo( ({"besen"}) ,
    #'beseninfo
    ,
    "murmelt in seinen Bart: "
  );

  AddInfo( ({"hut","feenhut"}) ,
    "Seh ich so aus als ob ich einen auf haette?"
    ,
    "bloekt: "
  );

  AddInfo( ({"schluessel"}) ,
    "Ich komme ueberall ohne Schluessel hin."
    ,
    "sagt: "
  );

  AddInfo( ({"kammer"}) ,
    "Welche meinst Du?"
    ,
    "fragt: "
  );

  AddInfo( ({"unglueck"}) ,
    "Es wird ein grosses Unglueck passieren, wenn ich hier nicht alles "
    "blitzblank sauber kriege."
    ,
    "murmelt: "
  );

  AddInfo( ({"hilfe"}) ,
    #'hilfeinfo
    ,
    "fleht Dich an: "
  );

  AddInfo( ({"tanz","feentanz"}) ,
    "Die Feen tanzen hier immer nur herum, anstatt sich nuetzlich zu machen."
    ,
    "brummelt: "
  );

  AddInfo( ({"schloss","feenschloss"}) ,
    "Den ganzen lieben langen Tag mache ich das Schloss sauber."
    ,
    "sagt: "
  );

  AddInfo( ({"robe"}) ,
    "Das ist meine !"
    ,
    "schaut Dich entruestet an: "
  );

  AddInfo( ({"brunnen"}) ,
    "Der alte Brunnen im Schlosshof? Der fuehrt kein sauberes Wasser mehr. "
    "Was weiss denn ich, warum."
    ,
    "sagt: "
  );

  AddInfo( ({"wasser"}) ,
    "Das Wasser im Brunnen ist nicht mehr sauber. Ich trink sowieso lieber "
