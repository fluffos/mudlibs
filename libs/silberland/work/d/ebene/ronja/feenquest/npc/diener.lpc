  SetProp(P_LOG_INFO, "/ronja/diener");

  SetProp(P_DIE_MSG, " seufzt: Gibt es bei Lars auch Whisky?\n");

  AddInfo(DEFAULT_INFO, "ist zu beschaeftigt um Dir zuzuhoeren.\n");

  AddInfo( ({"fee","feen","feenkoenigin","koenigin"}) ,
