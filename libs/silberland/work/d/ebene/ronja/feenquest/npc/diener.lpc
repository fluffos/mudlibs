    ,
    "meint: "
  );

  AddInfo( ({"fegen"}) ,
    "ICH HASSE FEGEN!"
    ,
    "sagt: "
  );

  AddInfo( ({"pause","pausen"}) ,
    "Wenn ich auch noch Pause machen wuerde, wuerde ich nie fertig."
    ,
    "stoehnt: "
  );

  AddInfo( ({"oberdiener"}) ,
    "Das ist unser Boss. Der steht den ganzen Tag nur herum und kommandiert "
    "uns herum."
    ,
    "schimpft: "
  );

  AddInfo( ({"diener"}) ,
    "Willst Du einer werden?"
    ,
    "fragt Dich: "
  );

  AddInfo( ({"nadel","haarnadel"}) ,
    "Seh ich so aus, als ob ich sowas brauchen wuerde?"
    ,
    "fragt Dich: "
  );

  AddInfo( ({"karte"}) ,
    "Karte? Was fuer eine Karte?"
    ,
    "sagt: "
  );

  AddInfo( ({"schluessel"}) ,
    "Ich komme ueberall hin wo ich hin muss."
    ,
    "sagt: "
  );

  AddInfo( ({"falle","mausefalle"}) ,
    "Soll ich mich jetzt auch noch darum kuemmern? Ich hab schon "
    "genug zu tun. Letzens habe ich eine im suedlichen Teil des "
    "Schlosses gesehen. Such halt da mal. "
    ,
    "schimpft : "
  );

  AddInfo( ({"hammer"}) ,
    "Erst soll ich fegen, und jetzt haemmern? Was denn noch alles?"
    ,
    "murrt : "
  );

  AddInfo( ({"durst"}) ,
    #'trinken3
    ,
    "sagt: "
  );

  AddInfo( ({"bibliothekar"}) ,
    "Sowas haben wir hier nicht."
    ,
    "sagt: "
  );

  AddInfo( ({"feenkraut"}) ,
    "Feenkraut schmeckt zwar etwas bitter, hat aber sehr heilsame Wirkung."
    ,
    "sagt: "
  );

  AddInfo( ({"beruf"}) ,
    "Ich bin Diener von Beruf."
    ,
    "sagt: "
  );

  AddInfo( ({"schleier"}) ,
    "Sowas brauche ich nicht, habe ich nicht, will ich nicht."
    ,
    "sagt: "
