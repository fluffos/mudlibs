** Der steirische Schwammerlsucher                 (w) Woody@SilberLand
**
**    date      Version  comments
** --------------------------------------------------------------------
** 1996-02-29     1.0    Release
** 1996-03-01     1.1    Der Sucher gibt auf Anfrage nen Korb her
** 1996-02-29     1.2    Der Sucher wandert im Silberwald
** 1996-03-06     1.3    AddInfo "silberwald", "frau", Umbruch korrigiert,
**                       Korb nur einmal pro Spieler pro Reset
** 1996-03-31     1.4    Vergiftungsspell (Quest-NPC!)
** 1996-03-31     1.5    inherit mnpc
** 1997-03-31     1.6    man kriegt keinen Korb mehr, wenn man die Quest
**                       schon mal geloest hat
** 1998-05-07     1.7    Er will jetzt fuer sich ein Eierschwammerl
**                       statt eines Steinpilzes :)
** 2000-06-12     1.8    P_MNPC_* statt altem mnpc-Interface
** 2000-11-05     1.9    Belohnung fuer Leute, die die Quest schon hatten
** 2001-02-12     1.10   neues UID System
** 2001-02-23     1.11   P_NO_SCORE -> 1
** 2003-03-24     1.12   Info, dass man nur im Wald suchen soll
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <mnpc.h>
#include <npcmaster.h>

#include "quest.h"
#include "/d/ebene/Silberwald/silberwald.h"

object *hatkorb;
object *gutetat;

create()
{
  // OBLI:
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Schwammerlsucher");
  SetProp (P_LONG, "Du erblickst einen Schwammerlsucher, wie Du ihn nur "
    "in der tiefsten Steiermark vermuten wuerdest. Offenbar haelt er "
    "verzweifelt nach irgendetwas bestimmtem Ausschau. Eventuell koenntest "
    "Du ihm ja helfen? Frag ihn doch mal!");
  SetProp (P_NAME, "Schwammerlsucher");
  SetProp (P_GENDER, MALE);
  AddId ( ({"sucher", "schwammerlsucher"}) );
  create_default_npc (10);
  SetProp (P_BODY, 100);
  SetProp (P_HANDS, ({" mit blossen Haenden", 80}));
  SetProp (P_ALIGN, 200);
  SetProp (P_RACE, "Mensch");
  SetProp (P_XP, 20000);
  SetProp (P_MSGOUT, "findet hier nichts und wandert auf seiner Suche weiter");
  SetProp (P_SPELLRATE, 20);    // hohe Wahrsch.!!! (Sucher ist Quest-NPC!)
  SetProp (P_NO_SCORE, 1);      // gibt keine Erstkiller

  set_living_name ("schwammerlsucher");
  hatkorb = ({ });
  gutetat = ({ });

  SetChats (2, ({
    "Der Schwammerlsucher blickt sich suchend um.\n",
    "Der Schwammerlsucher schaut kurz auf, mustert Dich und sucht dann weiter.\n",
    "Der Schwammerlsucher seufzt: Damals in der Steiermark, da war's noch einfach.\n",
    "Der Schwammerlsucher macht einen verzweifelten Eindruck.\n",
    "Der Schwammerlsucher sagt: Wenn ich nur endlich den Pilz haette!\n"
  }) );

  SetAttackChats(5, ({
    "Der Schwammerlsucher wirft mit ein paar giftigen Pilzen um sich.\n",
    "Der Schwammerlsucher schreit: \"Na warte, wenn Dich meine Frau "+
      "erwischt!\"\n",
    "Der Schwammerlsucher flucht ganz fuerchterlich.\n",
    "Der Schwammerlsucher tritt wie wildgeworden um sich.\n"
  }) );

  AddSpell (1, 20,
    "Der Schwammerlsucher stopft Dir einen Fliegenpilz in den Mund.\n"
    "Du fuehlst Dich auf einmal viel schwaecher und wirst bleich im Gesicht.\n",
    "Der Schwammerlsucher stopft @WEM einen Fliegenpilz in den Mund.\n"
    "@WER wird bleich im Gesicht.\n", DT_POISON, "vergifte");

  AddInfo ("\ndefault info", "beachtet Dich gar nicht.\n");

  AddInfo ("steiermark", "Jaja, die Steiermark, das ist meine alte Heimat, "
    "dort gab's noch Schwammerl in Massen... aber hier, im Silberwald, da "
    "kannst stundenlang rumhatschen, bloss, finden tust nix...", "sagt: ");
  AddInfo ("silberwald", "seufzt: Wunderschoen... Aber leider keine Pilze...\n");
  AddInfo ( ({"schwammerl","schwammerln","pilz","pilze",
    "steinpilz","steinpilze"}), "@@i_pilze@@" );
  AddInfo ( ({"hilfe","aufgabe"}), "Ich suche schon seit Stunden "
    "verzweifelt nach einem bestimmten Pilz, den es nur im Silberwald gibt! "
    "Wenn ich ohne den nach Hause komme, erschlaegt mich vermutlich meine "
    "Frau, weil sie denkt, dass ich wieder in der Stadtkneipe war... Wenn "
    "Du mir hilfst, ihn zu finden, waere ich Dir ueberaus dankbar! Du "
    "braeuchtest aber dann wohl einen Korb zum Suchen...", "sagt: ");
  AddInfo ("frau", "sagt: Frauen... sie sind so furchtbar misstrauisch!\n@@i_frauen@@\n");
  AddInfo ("korb", "@@i_steinpilz@@");
  AddInfo( ({"50 sachen", "palpatine"}),
    "Palpatine hat mich schon nach 50 Sachen gefragt.", "sagt staunend: ");

  SetProp(P_MNPC_AREA, SILBERWALD(""));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("room_e03"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);
  SetProp(P_MNPC_WAIT, ({ 30,45,100 }) );
}

vergifte (object enemy)
{
  int p;
  if ((p=enemy->QueryProp(P_POISON)) < enemy->QueryProp(P_MAX_POISON))
    enemy->SetProp(P_POISON, p+1);
}

string i_frauen()
{
  if (TP->QueryProp(P_GENDER) == FEMALE)
  {
    return ("Der Schwammerlsucher erroetet.\n"
            "Der Schwammerlsucher sagt: Anwesende natuerlich ausgenommen...");
  }
  else
  {
    return ("Der Schwammerlsucher zwinkert.\n"
            "Der Schwammerlsucher sagt: Du kennst das sicher!");
  }
}

string i_pilze()
{
  object ob;

  if ( (TP->QueryQuest(PILZQUEST)) ||
       (member_array (TP, hatkorb) != -1) ||
       ((ob = deep_present(KORBID,TP)) && (ob->query_owner() == getuid(TP))) )
  {
    return break_string(
      "Irgendjemand hat mir einmal den Tip gegeben, dass sich Schwammerl "
      "gerne unter Reisig sowie im Moos verstecken. Mit Verlaub, ich "
      "halte das fuer kompletten Schwachsinn.", 78,
      "Der Schwammerlsucher lacht: ");
  }
  return "seufzt: Ja, nur wo? Kannst Du mir vielleicht helfen?\n";
}

string i_steinpilz()
{
  object ob;
  int ret;

  if ( (TP->QueryQuest(PILZQUEST)) ||
       (member_array (TP, hatkorb) != -1) ||
       ((ob = deep_present(KORBID,TP)) && (ob->query_owner() == getuid(TP))) )
  {
    return "erinnert sich: "
      "Dir hab ich schon mal einen Korb gegeben!\n";
  }

  SUID;
  ob = clone_object (QDIR("korb"));
  ob->move(ME, M_NOCHECK);
  // ob->SetProp(P_ARTICLE, 0);
  // ob->SetProp(P_NAME, TP->name(WESSEN)+" Korb");
  // ob->SetProp(P_SHORT, TP->name(WESSEN)+" Korb");
  ob->SetProp(P_LONG, ob->QueryProp(P_LONG)+"Er gehoert "+TP->name(WEM)+".\n");
  ob->set_owner(getuid(TP));

  say (break_string (
    "Ach, Du willst mir also helfen, den Steinpilz zu finden, "+
    capitalize(getuid(TP)) + "? Oh, ich suche jetzt schon seit "
    "Stunden, aber bisher ohne jeglichen Erfolg! Solltest Du es dennoch "
    "schaffen, ihn aufzustoebern, waere ich Dir ueberaus dankbar! Hier "
    "hast Du einen Korb, damit Du die Pilze besser einsammeln kannst!", 78,
    "Der Schwammerlsucher sagt: "));

  hatkorb += ({ TP });
  ret = ob->move(TP, M_GET);
  if (ret != 1)
  {
    say ("Der Schwammerlsucher seufzt.\n");
    say (break_string (
      "Leider kannst Du den Korb nicht mehr tragen, ich lege ihn also "
      "einstweilen hier ab. Verkauf ein bisschen was von Deinen schweren "
      "Sachen und hol Dir den Korb dann wieder hier ab!", 78,
      "Der Schwammerlsucher sagt: "));
    // command ("lege korb ab");
    say ("Der Schwammerlsucher laesst "+TP->name(WESSEN)+" Korb fallen.\n");
    ob->move(MENV, M_NOCHECK);
  }
  else
  {
    // command ("gib korb an "+TP->name());
    say ("Der Schwammerlsucher gibt "+TP->name(WEM)+" "+
      (TP->QueryProp(P_GENDER)==FEMALE ? "ihr" : "sein")+
      "en Korb.\n", TP);
    write ("Der Schwammerlsucher gibt Dir Deinen Korb.\n");
  }
  return "laechelt zuversichtlich.\n";
}

reset()
{
  hatkorb = ({ });
  gutetat = ({ });
}

give_notify(obj)
{
  int q, i, steinpilze, eierschwammerl;
  string ow;
  object *all;

  if (obj->id(KORBID))
  {
    // EUID ok?
    if (geteuid(obj) != getuid())
    {
      say (bs(
        "Der Schwammerlsucher sagt: Was ist denn das fuer ein "
        "seltsamer Korb? Den habe ich Dir sicher nicht gegeben! "
        "Und weil man ja gerade bei Pilzen nie vorsichtig genug "
        "sein kann, schau ich erst gar nicht rein!\n"));
      give_obj (obj, TP);
      return;
    }
    // evtl. ein geklauter Korb?
    if ((ow=obj->query_owner()) != getuid(TP))
    {
      say (bs("Der Schwammerlsucher sagt: Hey, das ist doch gar "
        "nicht Dein Korb! Diesen Korb hat urspruenglich "+
        capitalize(ow||"irgendwer")+" von mir bekommen!\n"));
      give_obj (obj, TP);
      return;
    }
    // Inhalt ok?
    steinpilze = eierschwammerl = 0;
    all = all_inventory(obj);
    for (i=0; i<sizeof(all); i++) {
      if (all[i]->id(STEINPILZID)) steinpilze++;
      if (all[i]->id(EIERSCHWAMMERLID)) eierschwammerl++;
    }

    if (!steinpilze && !eierschwammerl)
    {
      say (break_string(
        "Du machst es Dir wohl sehr einfach! Wo ist denn bitte der "
        "Steinpilz? Wenn Du ihn gefunden hast, lege ihn in den Korb "
        "und bring ihn mir!", 0, "Der Schwammerlsucher sagt: "));
      give_obj (obj, TP);
      return;
    }
    else if (!steinpilze)
    {
      // versch. write() bzw. say():
      // Zufaellig anwesende andere Spieler muessen ja nich unbedingt
      // mitkriegen, dass der unverschaemte Kerl gleich mehr als
      // einen Pilz haben will... ;)
      write(
        "Der Schwammerlsucher blickt Dich freudig an.\n"+break_string(
        "Wow, Du hast ja Eierschwammerl "+
        "gefunden! Die sind besonders lecker! Nur meine Frau wird "+
        "mich trotzdem erschlagen, sie mag die naemlich ueberhaupt "+
        "nicht. Die mag nur Steinpilze... naja, ziemlich verwoehnt. "+
        "Lass mich bitte nicht im Stich und such weiter!\n", 0,
        "Der Schwammerlsucher sagt: "));
      say("Der Schwammerlsucher scheint noch nicht ganz zufrieden zu "+
        "sein.\n", TP);
      give_obj(obj, TP);
      return;
    }
    else if (!eierschwammerl)
    {
      write(
        "Der Schwammerlsucher blickt Dich freudig an.\n"+break_string(
        "Prima, Du hast ja tatsaechlich einen "
        "Steinpilz gefunden! Meine Frau wird sich freuen! Bloss... Soll "
        "ich hungern? Allerdings mag ich Steinpilze ohnehin nicht so "
        "besonders, ein Eierschwammerl waer mir viel lieber. Wenn Du "
        "mir sowas beschaffen koenntest, werde ich "
        "Dich dafuer belohnen, so sehr ich es mit meinen aermlichen "
        "Mitteln tun kann.\n", 0, "Der Schwammerlsucher sagt: "));
      say("Der Schwammerlsucher scheint noch nicht ganz zufrieden zu sein.\n",
          TP);
      give_obj(obj, TP);
      return;
    }

    say ("Der Schwammerlsucher strahlt.\n"+bs(
      "Der Schwammerlsucher sagt: Danke, "+capitalize(getuid(TP))+
      ", Du hast mir echt geholfen!\n"));

    /*
    if (!present (BELOHNUNGID, TP))
    {
      write ("Der Schwammerlsucher sagt: Zur Belohnung...");
      say ("Der Schwammerlsucher gibt "+capitalize(TP->name(WEM))+
        " die Belohnung.\n", TP);
      SUID;
      clone_object ("belohnung")->move(TP, M_NOCHECK);
    }
    */

    if (!((i = TP->QueryProp (P_CAN_FLAGS)) && CAN_EMOTE))
    {
      write ("Der Schwammerlsucher drueckt Dir einen Zettel in die Hand.\n");
      say ("Der Schwammerlsucher drueckt "+capitalize(TP->name(WEM))+
        " einen Zettel in die Hand.\n", TP);
      SUID;
      clone_object ("/players/woody/obj/emotezettel.lpc")->move(TP, M_NOCHECK);
      TP->SetProp (P_CAN_FLAGS, i | CAN_EMOTE);
    }
    q = TP->GiveQuest(PILZQUEST);
    if (q == 1)
    {
      write ("\nGratulation! Du hast die Aufgabe geloest!\n");
      // dieses shout() wird spaeter mal wieder rausgenommen,
      // wenns schwierigere Quests gibt :)
      domainshout (sprintf ("Lautes Jubeln erklingt aus dem Silberwald.\n%s hat "+
        "sich als Pilzsucher bewaehrt.\n", capitalize(getuid(TP)) ) );
      write_file (PILZQUESTLOG,
        sprintf ("%s  %s hat sich als Pilzsucher bewaehrt.\n",
        dtime(time()), capitalize(getuid(TP)) ) );
    }
    else
    if (q != -1)
      write (sprintf("Unbekannter Fehler, bitte den zustaendigen Magier "+
        "verstaendigen!\nFehlercode: %d\n", q));
    if (eierschwammerl+steinpilze >= 3)
    {
      // zusaetzliche Vollheilung bei Loesung der Fleissaufgabe :)
      write (bs(
        "Der Schwammerlsucher merkt, dass er mehr Pilze hat, als er "+
        "benoetigt. Er gibt Dir einen Pilz, den Du sofort "+
        "verschlingst. Du fuehlst Dich auf einmal deutlich staerker.\n"));
      TP->SetProp (P_HP, TP->QueryProp (P_MAX_HP));
      TP->SetProp (P_SP, TP->QueryProp (P_MAX_SP));
    }
    say ("Der Schwammerlsucher winkt und verschwindet in der "+
      "Dunkelheit des Waldes.\n");
    for (i=0; i<sizeof(all); i++)   // Korb-Inhalt zerstoeren
      all[i]->remove();
    obj->remove();
    ME->remove();
    return;
  }
  else if (obj->id(STEINPILZID) || obj->id(EIERSCHWAMMERLID))
  {
    if (obj->id(STEINPILZID))
      write ("Der Schwammerlsucher sagt: Oh, Prima, ein Steinpilz!\n");
    else
      write ("Der Schwammerlsucher sagt: Oh, Prima, ein Eierschwammerl!\n");

    if (TP->QueryQuest(PILZQUEST))
    {
      int mod, al;

      if ((al = TP->QueryProp(P_ALIGN)) > 1000)
        mod=5;                          // +-5
      else
        mod=((1000-al)/20) || 1;        // max. +-100, min. 1
      // unlogischer Bonus fuer Dunkelelfen, daher auskommentiert :)
      // if (TP->QueryProp(P_RACE)=="Dunkelelf")
      //   mod=-mod;

      if (member(gutetat,getuid(TP)) != -1)
        mod=(mod/10) || 1;
      else
        gutetat += ({ getuid(TP) });

      write_file(GUTETATLOG,
          sprintf("[%s] %s bringt %s -> mod: %d\n",
            dtime(time()), capitalize(getuid(TP)), obj->name(WEN), mod));
      write("Der Schwammerlsucher blickt Dich dankbar an.\n");
      write("Du fuehlst Dich "+(mod<=5 ? "ein wenig " : "")+
          (TP->QueryProp(P_RACE)=="Dunkelelf" ? "un" : "")+
          "wohler durch Deine gute Tat.\n");
      TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)+mod);
      obj->remove();
      return;
    }

    write ("Der Schwammerlsucher gruebelt.\n");
    write (break_string(
      "Hmm, habe ich Dir nicht einen Korb gegeben? Den moechte ich schon ganz "
      "gern wiederhaben! Sammel doch bitte alles, was Du findest, darin!", 78,
      "Der Schwammerlsucher sagt: "));
    give_obj (obj, TP);
  }
  else if (obj->id("pilz") || obj->id("schwammerl"))
  {
    write (break_string(
      "Oh, ein Pilz! Aber... der schaut nicht gut aus. Der ist bestimmt "+
      "giftig.", 78, "Der Schwammerlsucher sagt: "));
    give_obj (obj, TP);
  }
  else
  {
    write ("Der Schwammerlsucher sagt: \"Was soll ich denn damit?\"\n");
    drop_obj (obj);
  }
  return;
}
