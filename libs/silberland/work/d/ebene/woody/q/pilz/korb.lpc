inherit "std/container";

#include <properties.h>
#include "/d/ebene/woody/q/pilz/quest.h"

string owner;

create()
{
  ::create();
  AddId (({"korb", "weidenkorb", KORBID}));
  SetProp (P_SHORT, "Ein Korb");
  SetProp (P_LONG, "Ein einfacher Korb aus Weidenflechten, "+
                   "mit dem man gut Pilze suchen kann.\n");
  SetProp (P_NAME, "Korb");
  SetProp (P_GENDER, MALE);
  SetProp (P_MAX_WEIGHT, 150);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 5);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_STRAW);
}

set_owner(arg)
{
  if (geteuid(previous_object())!=getuid())
  return owner = 0;
  return owner = arg;
}

query_owner()
{
  return owner;
}
