inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "/d/ebene/Midas/midas.h"

void create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("gaffo");
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Gaffo");
  SetProp (P_RACE, "Gaffo");
  SetProp (P_SHORT, "Ein Gaffo");
  SetProp (P_LONG, bs("Der Gaffo funkelt Dich boese an. Er ist ein Gaffo "+
    "mittlerer Groesse, wie sie hier zu Dutzenden herumlaufen. "+
    "Bestimmt hat er einige Freunde, es koennte also sein, dass Du "+
    "bald die ganze Sippschaft am Hals hast, wenn Du Dich mit diesem "+
    "Exemplar anlegst."));
  SetProp (P_ALIGN, -100);
  create_default_npc(12);
  SetProp (P_LEVEL, 12);
  SetProp (P_MAX_HP, 200);
  SetProp (P_MAX_SP, 200);
  SetProp (P_XP, 160000);
  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_HANDS, ({" mit seinem Wuergegriff", 200, DT_BLUDGEON}) );

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  // Ausruestung
  /*
  CLONEME (OBJ("ruestung/kupferschild"));
  command ("ziehe kupferschild an");
  CLONEME (OBJ("waffe/saebel"));
  command ("zuecke saebel");
  */
  CLONEME ("/p/armour/armour/lederpanzer");
  command ("ziehe lederpanzer an");
  CLONEME (OBJ("waffe/keule"));
  command ("zuecke keule");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 100+random(11)*10);
  ob->move(ME);

  SetProp(P_SPELLRATE,15);

  AddSpell(3,250,
    "Der Gaffo versetzt Dir einen maechtigen Schlag.\n",
    "Der Gaffo versetzt @WEM einen maechtigen Schlag.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,350,
    "Der Gaffo schleudert Dich kraftvoll zu Boden.\n",
    "Der Gaffo schleudert @WEN kraftvoll zu Boden.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetAttackChats(6, ({
    "Der Gaffo pruegelt wie wildgeworden auf Dich ein.\n",
    "Der Gaffo schreit wie verrueckt vor Wut.\n",
    "Der Gaffo bekommt einen Tobsuchtsanfall.\n",
    "Der Gaffo schreit und bruellt wie verrueckt.\n",
    "Der Gaffo gafft Dich entgeistert an.\n"}) );

  SetProp (P_DIE_MSG, " wird nie wieder gaffen.\n");
  SetProp (P_DEFAULT_INFO, "zuckt mit den Schultern.\n");
  AddInfo ("gaffo", "schreit Dich an: \"Gut erkannt! Und jetzt hau ab!\"\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Gaffo rafft alles gierig an sich.\n" }) );

  SetProp (P_MNPC_AREA, "/d/ebene/Silberwald/room/");
  SetProp (P_MNPC_WAIT, ({ 30, 50, 90 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "room_i11" );
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
}

/*
reset()
{
  return ::reset();
}
*/
