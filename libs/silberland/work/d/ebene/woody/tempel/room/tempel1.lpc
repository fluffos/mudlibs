#include <properties.h>
#include <moving.h>
#include "../files.h"

#define BACK "/d/ebene/Silberwald/room/erde/gang_i14"
#define ENTERLOG "/d/ebene/woody/log/tempel_enter"

inherit "std/room";

nosave mapping entered = ([]);

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Vor einem unterirdischen Tempel");
  SetProp (P_INT_LONG,
    "Auf einmal findest Du Dich vor einem unterirdischen Tempel "+
    "unerahnten Ausmasses wieder. Er besteht offenbar aus einem sehr "+
    "glatten Stein, dessen schwarze Farbe alles andere zu verschlucken "+
    "scheint. Ein paar Stufen fuehren weiter hinab ins Ungewisse, ein "+
    "kalter Luftzug jagt Dir ueber den Ruecken und Dir schaudert. Was "+
    "Dich wohl da unten erwartet? Du solltest auf alles gefasst sein. "+
    "Und das schliesst wohl den sicheren Tod mit ein.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"tempel","eingang"}),
    "Du stehst unmittelbar vor dem Eingang zu einem dunklen, sehr "+
    "unheimlichen Tempel. Die Stufen, die hinunter ins Innere fuehren, sind "+
    "von seltsamen Runen gesaeumt, deren Bedeutung Dir vollkommen fremd "+
    "ist.");
  AddDetail ( ({"ausmass","ausmasse"}),
    "Von hier kannst Du sie nicht erahnen, aber sie scheinen weit groesser "+
    "zu sein als man es von einem gewoehnlichen Tempel erwarten wuerde.");
  AddDetail ( ({"stein"}),
    "Der Stein ist ungewoehlich glatt, und von einem alles verschlingenden "+
    "Schwarz dominiert, der saemtliches Licht zu absorbieren scheint.");
  AddDetail ( ({"licht"}),
    "Das Licht ist hier kein willkommener Gast.");
  AddDetail ( ({"gast"}),
    "Glaubst Du ernsthaft, Du bist hier erwuenscht?");
  AddDetail ( ({"farbe", "schwarz"}),
    "Das Schwarz des Steins scheint wirklich alles andere zu verschlingen.");
  AddDetail ( ({"stufen"}),
    "Einige Stufen fuehren hinunter ins Innere des Tempels. Sie sind von "+
    "seltsamen Runen gesaeumt, deren Bedeutung Dir vollkommen fremd ist.");
  AddDetail ( ({"inneres"}),
    "Dazu musst Du schon reingehen!");
  AddDetail ( ({"ungewisses"}),
    "Niemand weiss es...");
  AddDetail ( ({"luft", "luftzug"}),
    "Ein kalter Luftzug jagt Dir ueber den Ruecken. Dir schaudert.");
  AddDetail ( ({"ruecken"}),
    "Er steht immer voll hinter Dir.");
  AddDetail ( ({"decke"}),
    "Hier besteht die Decke noch aus Erde.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus Erde. Du erkennst einige Spuren!");
  AddDetail ( ({"erde"}),
    "Boden, Waende, Decke... bis auf den seltsamen Tempel besteht hier "
    "alles aus Erde. Als Du die Erde am Boden genauer betrachtest, "
    "entdeckst Du einige Spuren!");
  AddDetail ( ({"spuren","schuhgroesse"}),
    "Die Spuren am Boden scheinen von Schuhen der Schuhgroesse 20 "
    "zu stammen - jedenfalls sind sie ziemlich klein.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende des Tempels vor Dir bestehen aus einem seltsamen, "+
    "schwarzen, sehr glatten Stein. Die Erdwand hinter Dir birgt "+
    "ein kleines Loch, durch das Du vielleicht wieder zurueck gelangen "+
    "koenntest, in Sicherheit.");
  AddDetail ( ({"sicherheit"}),
    "Die findest Du im Tempel vermutlich nicht!");
  AddDetail ( ({"loch", "erdwand"}),
    "Das kleine Loch in der Erdwand hinter Dir im Westen reicht gerade "+
    "noch aus, dass Du durchschluepfen kannst.");
  AddDetail ( ({"runen"}),
    "Seltsame, raetselhafte Runen links und rechts der Stufen verheissen "+
    "Geheimnisvolles... vermutlich nichts Gutes.");
  AddDetail ( ({"geheimnisvolles"}),
    "Forsche. Suche. Ueberlebe.");
  AddDetail ( ({"gutes"}),
    "Es gibt nichts Gutes, ausser es ist schwarzen Blutes.");
  AddReadDetail ( ({"runen"}),
    "So sehr Du Dich auch bemuehst, Du kannst sie nicht entziffern.");
  AddDetail ( ({"bedeutung"}),
    "So sehr Du Dich auch bemuehst, Du kannst sie nicht ergruenden.");
  AddDetail ( ({"tod"}),
    "Und der Tod ist vielleicht noch das geringste Uebel.");
  AddDetail ( ({"uebel"}),
    "Nicht auszudenken...");
  // AddDetail ( ({"schild"}),
  //   "Das Schild leuchtet Dich gelb an. Du kannst es lesen.");
  // AddReadDetail ( ({"schild"}),
  //   // "Auf dem Schild steht in schwarzen Buchstaben: BAUSTELLE");
  //   "   ___________\n"
  //   "  |            \\\n"
  //   "  |  BAUSTELLE  |\n"
  //   "   \\___________/\n"
  //   "        | |\n"
  //   "        | |\n");
  AddSound ( ({DEFAULT_SOUND, "geraeusche"}),
    "Du hoerst seltsame Geraeusche, die Du nicht deuten kannst, sie "+
    "klingen wie ein leises Jammern...");
  AddSound ( ({"jammern"}),
    "Das Jammern scheint aus dem Inneren des Tempels zu kommen.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht hier etwas muffig, und irgendwie stechend. Du kannst den "+
    "ekelhaften Geruch beim besten Willen nicht zuordnen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", BACK);
  // EXITS END

  // ITEMS START
  AddItem (NPC("dunkeltroll"), REFRESH_DESTRUCT);
  // ITEMS END

}

void init()
{
  ::init();
  if (!this_player()) return;
  if (!interactive(this_player())) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt den Vorraum zum Tempel.\n",
    dtime(time()), CAP(getuid(TP))));
}
