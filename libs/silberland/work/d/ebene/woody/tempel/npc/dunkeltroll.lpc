/*
** Dunkeltroll
** ---
** 1997-02-01  1.0  Release
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"dunkeltroll","troll"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Dunkeltroll");
  SetProp (P_SHORT, "Ein kleiner Dunkeltroll");
  SetProp (P_LONG, "Der kleine aber staemmige Dunkeltroll sieht Dich finster "
      "an. Du bist Dir nicht sicher, ob er Dich oder jemand anderen schuetzen "
      "will, wenn er Dich nicht vorbeilaesst...");
  SetProp (P_ALIGN, -75-random(50));
  SetProp (P_LEVEL, 12);
  SetProp (P_MAX_HP, 300+random(101));
  SetProp (P_MAX_SP, 300);
  SetProp (P_XP, 666 * QueryProp(P_MAX_HP));    // ca. 200k - max. 266k
  SetProp (P_BODY, 50+random(10));
  SetProp (P_SIZE, 130+random(15));
  SetProp (P_RACE, "Troll");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit kraeftigen Trollarmen", 70, DT_BLUDGEON}) );
  SetProp (P_MURDER_MSG, "Es wird ein furchtbares Ende mit Dir nehmen, %s...");

  set_living_name("dunkeltroll");

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  // Ausruestung
  CLONEME(OBJ("ruestung/schw_umhang"));
  command ("trage alles");
  CLONEME(OBJ("waffe/trolldolch"));
  command ("zuecke dolch");

  SetProp(P_SPELLRATE,20);

  AddSpell(5,250,
    "Der Dunkeltroll schleudert kleine Eispfeile auf Dich.\n",
    "Der Dunkeltroll schleudert kleine Eispfeile auf @WEN.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2,350,
    "Der Dunkeltroll hebt die Arme und schiesst einen Blitz nach Dir.\n",
    "Der Dunkeltroll hebt die Arme und schiesst einen Blitz nach @WEM.\n",
    DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6, ({
    "Der Dunkeltroll ruft: Kehr' um!\n",
    "Der Dunkeltroll wirft Dir finstere Blicke zu.\n"}) );

  SetProp (P_DIE_MSG, " roechelt zum letzten Mal: Ich habe Dich gewarnt!\n");

  SetProp (P_DEFAULT_INFO,
    ({ "sagt: Keine Ahnung! Aber kehr lieber um!\n",
       "schaut Dich verwirrt an.\n",
       "zuckt mit den Schultern.\n",
       "deutet auf ein Gerippe und sagt: Das wollte der auch wissen!\n",
       "beachtet Dich gar nicht.\n" }) );

  AddInfo ("tempel",
    "Ja, der Tempel, den ich bewache... er ist sehr gefaehrlich! "
    "Seine schwarze Macht hat schon viele das Leben gekostet...",
    "antwortet: ");
  AddInfo ("macht",
    "Die Macht des Tempels ist ein noch nicht gelueftetes Geheimnis.",
    "fluestert: ");
  AddInfo ("leben",
    "Wenn Dir das Deine lieb ist, kehre um!",
    "raet: ");
  AddInfo ("geheimnis",
    "Wenn Du das Geheimnis des Tempels ergruenden willst, wirst Du "
    "einigen Gefahren ins Auge blicken!",
    "warnt: ");
  AddInfo ("gefahren",
    "Die groesste Gefahr geht wohl von Kesoth aus.",
    "meint: ");
  AddInfo ("kesoth",
    "Kesoth ist ein dunkler Magier, der in diesem Tempel haust. Seine "
    "Macht ist bislang ungebrochen. Er ist angeblich in Besitz eines "
    "wertvollen Gegenstands, naeheres ist mir aber nicht bekannt.",
    "erzaehlt: ");
  AddInfo ("gegenstand",
    "Ich weiss auch nicht genau, worum es sich handelt, es soll aber "
    "sehr wichtig sein, habe ich mir sagen lassen!",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Dunkeltroll begutachtet @WEN, will dann aber doch nichts.\n" }) );

}

