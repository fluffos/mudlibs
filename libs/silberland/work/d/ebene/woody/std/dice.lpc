string dice(int num, int zeile)
// num (1-6), zeile (1-5)
{
   switch(zeile) {
      case 2: switch(num) {
                case 2:
                case 3:   return "|     * |";
                case 4:
                case 5:
                case 6:   return "| *   * |";
                default:  return "|       |";
              }
      case 3: switch(num) {
                case 1:
                case 3:
                case 5:  return "|   *   |";
                case 6:  return "| *   * |";
                default: return "|       |";
              }
      case 4: switch(num) {
                case 2:
                case 3:   return "| *     |";
                case 4:
                case 5:
                case 6:   return "| *   * |";
                default:  return "|       |";
              }
      default: return "+-------+";
   }
}
