

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "/d/ebene/akira/edorf/def.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));  
  SetProp(P_INT_SHORT, "An einem stillen Platz");
  SetProp(P_INT_LONG, 
     "In heilig unberuehrter Stille\n"
     "erstreckt ein Platz sich aus vor Dir.\n"
     "Entgegen all des Lagers Fuelle\n"
     "ein einziger Baum gepflanzt ward hier.\n"
     "\n"
     "In dessen kuehlem Schatten steht\n"
     "ein Schrein von Elfenmarmorstein\n"
     "als ob niemals die Zeit vergeht.\n"
     "Er mag fuer Elfengoetter sein.\n"
     "\n"); 

  AddDetail( "platz",
     "So mancher Platz so manches birgt,\n"
     "wie dieser hier, wo Heil'ges wirkt.\n"
     "Es birgt die Kraft hier dieser Schrein,\n"
     "und sie wird immer mit ihm sein.\n"
     "\n");

  AddDetail( "schatten",
     "Vom Baume kuehl beschattet steht\n" 
     "ein Schrein von Elfenmarmorstein,\n"
     "als ob niemals die Zeit vergeht.\n"
     "Er mag fuer Elfengoetter sein.\n"   
     "\n");

  AddDetail( "baum",
     "Des Baumes Schatten laedt dich ein\n"
     "ein wenig zu verweilen.\n" 
     "Die dichte Krone mag den Schein\n"
     "der Sonne sanft zerteilen.\n"
     "\n"
     "Am Fusse in der Rinde steht\n"
     "in Runen raetselhaft,\n"
     "ein altes Elfendankgebet,\n"
     "es birgt so manche Kraft.\n"
     "\n"); 

  AddDetail( ({"runen", "rinde", "elfendankgebet"}),
     "*Wenn kein Elf*\n"
     "Die Worte sind, O armer Tor,\n"
     "dir gaenzlich unbekannt,\n"
     "denn Elfen hueten stets sich vor\n"
     "fremd Neugier allesamt.\n" 
     "\n"
     "*Wenn Elf:*\n"
     "O Eru, Herrscher aller Macht\n"
     "der uns im zweiten Lied bedacht\n"
     "gleich' Dir die Kraft zu spueren.\n"
     "Akira hat uns prophezeit,\n"
     "Er kommt noch bald in unsrer Zeit\n"
     "den Weg uns anzufuehren.\n"
     "\n"
     "In Deiner Kraft und Weisheit ganz\n"
     "wird Er durch Erus Elfenglanz\n"
     "Vollendung uns darbringen.\n"
     "In Jubel und in Harmonie\n"
     "zeugt alle dieser Melodie,\n"
     "Ihm unser Lob zu singen!\n");

  AddDetail( ({"zeltlager", "lager", "fuelle"}),
     "In muehevoller Handarbeit\n"
     "ward dieses Lager einst bereit'.\n"
     "Von Elfenhand erbaut es stand,\n"
     "und unberuehrt von Menschenhand.\n"
     "\n"
     "*bei nicht elfen zusaetzlich:*\n"
     "Nach schier unendlich langer Zeit\n"
     "scheint hier deine Anwesenheit\n"
     "fast ungehorsam der Natur,\n"
     "guter Freund - was suchst Du nur?\n"
     "\n"); 

  AddDetail( ({ "altar", "schrein", "marmorstein", "elfenmarmorstein" }),
     "Aus vielen kleinen Rissen zart\n"
     "erblicken kleinen Bluemelein\n"
     "das Licht, von wundersamer Art,\n"
     "sie duften gar so fein.\n"
     "\n"); 

  AddDetail( ({ "blume", "blumen", "bluemelein", "risse", "rissen" }),
     "Der Bluemlein zarte Farbenpracht\n"
     "erfreuet Herz und Sinne,\n"
     "obwohl Dein Herz sonst nur bedacht\n"
     "auf Highscore und Gewinne.\n"
     "\n"); 

  AddDetail( ({"gras", "boden"}),
     "Das Gras scheint gaenzlich unberuehrt\n"
     "als ob es Tritte nie vespuert,\n"
     "doch Elfen haben eins gemein:\n"
     "Sie sinken in das Gras nicht ein.\n"
     "\n"); 
  
  AddDetail( "stille",
     "Von Stille bist Du rings umgeben,\n"
     "es scheint, als ob hier alles Leben\n"
     "still und ehrfurchtsvoll verstummt:\n"
     "Dem Schrein tut man hier Ehre kund.\n" 
     "\n");

  AddSound(DEFAULT_SOUND, 
     "Von Stille bist Du rings umgeben,\n"
     "es scheint, als ob hier alles Leben\n"
     "still und ehrfurchtsvoll verstummt:\n"
     "Dem Schrein tut man hier Ehre kund.\n"
     "\n"); 

  AddSmell(DEFAULT_SMELL, 
     "Erfuellt ist rings die Waldesluft\n"
     "von gar betoerend schwerem Duft\n"
     "der Blumen all, der Zweige Laub.\n"
     "dem Gras, und feinem Bluetenstaub.\n"
     "\n"); 

  AddExit("sueden","./versamm0");


}
