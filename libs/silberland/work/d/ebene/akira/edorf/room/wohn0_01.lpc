

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "/d/ebene/akira/edorf/def.h"
#include "/d/ebene/akira/edorf/room/genwohn0.h"
create()
{
  ::create();
  
  wohn0_desc();

  wohn0_details();

  
  AddExit("osten","./wohn0_02");
  AddExit("nordwesten","./indenwaldraumnamennochnichtbekannt");

  AddCmd ( ({"betritt", "betrete", "betret"}), "enter");

}

int enter(string str) 
{
  if( str == "zelt" ) 
  {
    TP->move( ROOM "wohn1_01.lpc", M_GO, "", "betritt das Zelt",
                      "kommt herein.");
      return 1;
  }
  notify_fail("Was willst Du denn betreten?\n");
  return 0;
}

