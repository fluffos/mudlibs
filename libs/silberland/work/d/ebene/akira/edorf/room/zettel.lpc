
inherit "/std/thing";

#include <properties.h>
#include <moving.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Nachricht");
  SetProp(P_LONG, "Eine Nachricht.\n");
  SetProp(P_NAME, "Nachricht");
  AddId(({"nachricht"}));
  SetProp(P_GENDER, MALE);


AddCmd (({"lies", "lese"}),"lies");

}

int lies (string str)
{
 notify_fail ("WAS willst Du lesen?\n");
  if (!str) return 0;
  if (str!="nachricht") return 0;

 write(
   "Das mit dem Kino ist eine wundervolle Idee, das sollte man auf jeden\n"
   "Fall machen IMHO. Wenn ihr die genaue Uhrzeit wisst, und mich wider\n"
   "erwarten NICHT im SL trefft, dann mailt mir bidde.\n");
 return 1;

}
