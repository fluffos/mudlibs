

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "/d/ebene/akira/edorf/def.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT, "Garten vom Kraeuterhaendler");
  SetProp(P_INT_LONG,
     "*Wenn Elf:*\n"
     "Dicht vor dem Kraeutergarten steht\n"
     "ein Gartenzwerg, der Blumen maeht.\n"
     "Aus Holz ist dieser fein geschnitzt\n"
     "und grinst recht hoelzern, doch gewitzt,\n"
     "\n"
     "in stillen Wissen, still zu steh'n\n" 
     "und so zu tun, als Blumen maeh'n.\n"
     "Doch dieser ist auch nicht allein,\n"
     "es finden derer sich noch zweien,\n"
     "\n"
     "die tapfer, unnuetz und adrett\n"
     "Parade stehen im Pflanzenbeet.\n"
     "Vor deinen geist'gen Auge graut,\n"
     "du hast den Zweck des Zwergs erschaut!\n"
     "\n"
     "Wie Eru einst die Elfen schuf,\n"
     "der Elf nur nach den Zwergen ruft,\n"
     "sie sind der Erd' Dekoration,\n"
     "doch wissen diese auch davon?\n"
     "\n"
     "*wenn nicht elf*\n"
     "Der dichte Kraeutergarten schafft\n"
     "in wuchernd bunter Farbenkraft\n"
     "manch fremden wuerzig-starken Duft\n"
     "der ringsumher erfuellt die Luft.\n");

  AddExit("sueden","./haendler");


}

 
