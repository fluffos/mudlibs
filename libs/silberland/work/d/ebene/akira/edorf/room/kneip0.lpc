

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "/d/ebene/akira/edorf/def.h"

create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));  
  SetProp(P_INT_SHORT, "Bei einer Kneipe");
  SetProp(P_INT_LONG,
     "Inmitten aller wohlverstecker\n"
     "fest verborgen und bedeckter\n"
     "Elfenzelte gross und klein\n"
     "traegt dies die Tarnung nur zum Schein!"
     "\n"
     "Dem Pegel drinnen zu vermuten\n"
     "fliesst nektar dort in rauhen Fluten,\n"
     "denn offen ist auch aller Mund,\n"
     "man tut es durch Gelaechter kund.\n");

  AddDetail( ({"hauptplatz", "platz"}),
     "Der Hauptplatz liegt an weiter Lichtung\n"
     "mit Feuerstatt in westlicher Richtung.\n"
     "\n");

  AddDetail( ({"zeltlager", "lager", "fuelle"}),
     "In muehevoller Handarbeit\n"
     "ward dieses Lager einst bereit'.\n"
     "Von Elfenhand erbaut es stand,\n"
     "und unberuehrt von Menschenhand.\n"
     "\n"
     "*bei nicht elfen zusaetzlich:*\n"
     "Nach schier unendlich langer Zeit\n"
     "scheint hier deine Anwesenheit\n"
     "fast ungehorsam der Natur,\n"
     "guter Freund - was suchst Du nur?\n"
     "\n"); 

  AddDetail( ({"vogel", "voegel"}),
     "Sie flattern hin und flattern her\n"
     "und zwitschern, ja sie freuen sich sehr.\n"
     "Sie singen voller Lebenslust,\n"
     "sind keiner Sorgen sich bewusst.\n"
     "\n"); 

  AddDetail( "zelte",
     "Man muss dicht an den Zelten stehn\n"
     "um sie erst richtig zu besehn,\n"
     "aus Stoff und Aesten nur gewebt,\n"
     "doch sieht man, wie sich's gut drin lebt.\n"
     "\n"); 

  AddDetail( "zelt",
     "Was Menschen ihre Kneipe ist,\n"
     "dem Elf das Zelt, wo Nektar fliesst.\n"
     "Vor solchem stehst du nun und siehst\n"
     "wie man der Muss' sich drin ergiesst.\n"
     "\n");

  AddDetail( ({ "blume", "blumen", "bluemelein" }),
     "Der Bluemlein zarte Farbenpracht\n"
     "erfreuet Herz und Sinne,\n"
     "obwohl Dein Herz sonst nur bedacht\n"
     "auf Highscore und Gewinne.\n"
     "\n"); 

  AddDetail( ({"gras", "boden"}),
     "Das Gras scheint gaenzlich unberuehrt\n"
     "als ob es Tritte nie vespuert,\n"
     "doch Elfen haben eins gemein:\n"
     "Sie sinken in das Gras nicht ein.\n"
     "\n"); 
  
  AddDetail( ({"buesche", "busch", "hecke", "hecken"}),
     "Ein Flechtwerk dichter Hecken\n"
     "umgibt an allen Ecken\n"
     "die Zelte fest und fein,\n"
     "so sieht man nicht hinein.\n"
     "\n"); 

  AddSound(DEFAULT_SOUND,
     "Der Voegel stete Frohnatur\n"
     "wird einzig von den Elfen nur\n"
     "durch heit'res Lachen hier gestoert,\n"
     "wie man es aus dem Zelte hoert.\n"
     "\n"); 

  AddSound( ({"lachen", "gelaechter"}),
     "Auch Elfen duerfen froehlich sein,\n"
     "sie trinken Nektar nur, nicht Wein.\n"
     "\n");

  AddSmell(DEFAULT_SMELL, 
     "Erfuellt ist rings die Waldesluft\n"
     "von gar betoerend schwerem Duft\n"
     "der Blumen all, der Zweige Laub.\n"
     "dem Gras, und feinem Bluetenstaub.\n"
     "\n"); 

  AddExit("norden","./wohn0_04");
  AddExit("sueden","./shop0");
  AddExit("westen","./hauptplatz");
  AddExit("osten","./wohn0_07");

  AddCmd ( ({"betritt", "betrete", "betret"}), "enter");

}

int enter(string str) 
{
  if( str == "zelt" ) 
  {
    TP->move( ROOM "kneip1.lpc", M_GO, "", "betritt das Zelt",
                      "kommt herein.");
      return 1;
  }
  notify_fail("Was willst Du denn betreten?\n");
  return 0;
}

