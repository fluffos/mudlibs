

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "/d/ebene/akira/edorf/def.h"

create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT, "Am Hauptplatz des Zeltlagers");
  SetProp(P_INT_LONG,
     "Es scheint der Hauptplatz hier zu sein,\n"
     "nimmt fast die ganze Lichtung ein.\n"
     "Er wird von Feuerschein erhellt,\n"
     "der flackernd auf die Zelte faellt.\n"
     "\n"
     "Das Feuer knackt und prasselt wild\n"
     "und gibt ein gar romantisch Bild.\n"
     "Der Wind traegt Lachen bis herzu\n"
     "aus Osten, doch on Nord ist ruh.\n"
     "\n");

  AddDetail( ({"hauptplatz", "platz"}),
     "Obwohl das Feuer heftig prasselt\n"
     "hast du die Ruhe hier vermasselt,\n"
     "denn keine Elfen sind zu sehen,\n"
     "so magst du hier nicht lange stehen.\n"
     "\n");
  AddDetail( ({"zeltlager", "lager"}),
     "In muehevoller Handarbeit\n"
     "ward dieses Lager einst bereit.\n"
     "Von Elfenhand erbaut es stand,\n"
     "und unberuehrt von Menschenhand.\n"
     "\n"
     "*bei nicht elfen zusaetzlich:*\n"
     "Nach schier unendlich langer Zeit\n"
     "scheint hier deine Anwesenheit\n"
     "fast ungehorsam der Natur,\n"
     "guter Freund - was suchst Du nur?\n"
     "\n");
  AddDetail( ({"lagerfeuer", "feuer"}),
     "Das Feuer leuchter hell und klar,\n"
     "die Aeste darin krachen.\n"
     "Du sinnst, wie mutig man einst war\n"
     "und wagte manche Sachen.\n"
     "Man nahm die Angst und zeigte Mut\n"
     "der Freunde traute Runde,\n"
     "und griff rasch in die heisse Glut,\n"
     "gar schmerzhaft war die Wunde.\n"
     "\n");
  AddDetail( ({"aeste", "ast"}),
     "Die Aeste, ja die krachen fein,\n"
     "jetzt greifst du besser nicht hinein.\n"
     "\n");
  AddDetail( ({"zelte", "zelt"}),
     "Man muss dicht an den Zelten stehn\n"
     "um sie erst richtig zu besehn,\n"
     "aus Stoff und Aesten nur gewebt,\n"
     "doch sieht man, wie sichs gut drin lebt.\n"
     "\n");
  AddDetail( ({"nord", "norden"}),
     "Nordwaerts steht ein grosses Zelt\n"
     "auf das der Schein des Feuers faellt.\n"
     "Es wirkt auf dich erhaben sehr,\n"
     "es reizt die Neugier umso mehr.\n"
     "\n");
  AddDetail( ({"blumen","blume"}),
     "Sie anzusehen in Farbenpracht\n"
     "erfreut Herz und Sinne,\n"
     "obwohl Dein Herz sonst nur bedacht\n"
     "auf Highscore und Gewinne.\n"
     "\n");
  AddDetail( ({"gras", "boden"}),
     "Das Gras scheint gaenzlich unberuehrt\n"
     "als ob es Tritte nie vespuert,\n"
     "doch Elfen haben eins gemein:\n"
     "Sie sinken in das Gras nicht ein\n"
     "\n");
  AddDetail( ({"buesche", "busch"}),
     "Im Flechtwerk dichter Hecken\n"
     "laesst manches sich verstecken.\n"
     "Man muesste sehen ob dort was steckt,\n"
     "im schlimmsten Fall wirst du verdreckt.\n"
     "\n");
  AddSound(DEFAULT_SOUND, 
     "Der Wind traegt Lachn bis herzu\n"
     "aus Osten, doch von Nord ist Ruh.\n"
     "\n");
  AddSmell(DEFAULT_SMELL,
     "Erfuellt ist rings die Waldesluft\n"
     "von gar betoerend schwerem Duft\n"
     "der Blumen all, der Zweige Laub\n"
     "dem Gras, und feinem Blaetterstaub\n"
     "\n");

  AddExit("westen","./wohn0_06");
  AddExit("norden","./versamm0");
  AddExit("osten","./kneip0");
  AddExit("sueden","./wohn0_10");

  AddCmd ( ({"greif", "greife"}), "greife");
  AddCmd ( ({"durchsuch", "durchsuche"}), "durchsuche");

}

int greife (string str)
{
 notify_fail ("WOHIN moechtest Du greifen?\n");
  if (!str) return 0;
  if ((str!="ins feuer") && (str!="in feuer")) return 0;  
  
   
   write(
     "Mit Todesmut greifst du hinein\n"
     "und fuehlst den Schmerz, die Qual und Pein.\n"
     "Was fuer ein Tor, o weh, o Graus,\n"
     "die Hand sieht leicht verkohlt nun aus!\n"
     "\n");
   this_player()->reduce_hit_point(15);
   return 1;

}

int durchsuche (string str)
{
 notify_fail ("WEN oder WAS moechtest Du durchsuchen?\n");
  if (!str) return 0;
  if ((str!="busch") && (str!="buesche")) return 0;

 
   write(
     "Voll Stacheln sind die Buesche nur,\n"
     "ja, grausam ist oft die Natur.\n"
     "Worau der Tor die Lehre zieht:\n"
     "Nicht alles nehme, was man sieht.\n"
     "\n");
   this_player()->reduce_hit_point(15);
   return 1;
  
}

