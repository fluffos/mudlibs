#pragma strong_types
#include "../def.h"

inherit "/std/room";
inherit RD_STDDIR"parser";
inherit RD_STDDIR"message";

void AddDetails(mixed arg)
{
  int i;
  for (i=0; i<sizeof(arg); i+=2) AddDetail(arg[i], arg[i+1]);
}

// uebernommen aus std/room/description, erweitert um funcall
string _query_int_long()
{
  string l1,l2;

  l2=0;
  if (QueryProp(P_DOOR_INFOS))
    l2=((string)call_other(DOOR_MASTER,"look_doors"));
  l1=funcall(Query(P_INT_LONG)); // Reihenfolge wichtig!
  if (!l1 && !l2) return 0;
  if (!l1) l1="";
  if (!l2) l2="";
  return l1+l2;
}

varargs string GetDetail(mixed key, mixed race)
{
  mixed detail;
  
  detail=::GetDetail(key,race);
  if (!detail || !strlen(detail)) return detail;
  if (detail[<1..<1] != "\n" ) detail = my_break_string(detail);
  return detail;
}

void init()
{
  room::init();
  add_actions();
}

mapping item_actions;

status do_action(string verb, mapping args)
{
  mixed res;

  if (!item_actions || !item_actions[verb]) return 0;
  if (args[G_ME] && member_array(args[G_ME,1], item_actions[verb,0]) < 0) 
    return 0;
  res = item_actions[verb,1];
  if (closurep(item_actions[verb,1])) res = funcall(item_actions[verb,1], args);
  if (pointerp(res) || stringp(res)) message(res);
  if (intp(res)) return res;
  return (!!res);
}

void AddDetailAction(mixed detail, mixed rules, string action_id, mixed result)
{
  int i;

  if (!item_actions) item_actions = ([]);
  if (item_actions[action_id]) return;

  if (!pointerp(rules)) rules = ({ rules });
  if (!pointerp(detail)) detail = ({ detail });

  for (i=0; i<sizeof(rules); i++) AddRule(rules[i], action_id);
  item_actions += ([ action_id : detail; result ]);
}
