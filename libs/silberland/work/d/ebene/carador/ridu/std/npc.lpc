#pragma strong_types
#include "../def.h"

inherit "std/npc";
inherit RD_STDDIR"message";
inherit RD_STDDIR"parser";

nosave mapping msginfo;
nosave mixed accept_items;

void give_notify(object ob)
{
  mixed res;
  int i;

  if (accept_items) {
    for (i=sizeof(accept_items); i--;) {
      if ( (strstr(accept_items[i][0], "/") < 0 && ob->id(accept_items[i][0]))||
           RD_TOOLS->program_name(ob) == accept_items[i][0]) break;
    }
    if (i>-1) {  
      res = accept_items[i][1];
      if (closurep(res)) res = funcall(res, ob);
      if (res && !intp(res)) message(res);
      return;
    }
  }
  message(({ ({ M_ME_BEST, "schuettelt den Kopf." }) }));
  give_obj(ob, this_player());
}


varargs void AddAcceptItem(mixed it, mixed res)
{
  if (!accept_items) accept_items = ({ ({ it, res }) });
  else accept_items += ({ ({ it, res }) });
}


private int print_msg_info(string key)
{
  mixed res;
  res = msginfo[key];
  if (closurep(res)) res = funcall(res);
  if (!query_message_busy()) message(res||"");
  return 1;
}

varargs void AddInfo(mixed key, mixed info, string indent, mixed silent)
{
  int i;

  if (!pointerp(info) && !closurep(info)) {
    npc::AddInfo(key,info,indent,silent);
    return;
  }

  if (!pointerp(key)) key = ({ key });
  for (i=sizeof(key); i--;) {
    npc::AddInfo(key[i],#'print_msg_info);
    msginfo[key[i]] = info;
  }
}

void AddInfos(mixed arr)
{
  int i;
  for (i=sizeof(arr); i--;) apply(#'AddInfo, arr[i]);
}

void create()
{
  npc::create();
  msginfo = ([]);
}


void DoChat()
{
  if (!query_message_busy()) npc::DoChat();
}

int do_frage(string question, string text)
{
  if (!query_message_busy()) return npc::do_frage(question, text);
  return 1;
}
