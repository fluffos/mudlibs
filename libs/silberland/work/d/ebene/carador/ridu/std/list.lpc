#pragma strong_types
#include "../def.h"

varargs mixed
make_list (string *items, mixed alternative, string and, string comma)
{
    return 
        (sizeof (items)>1 ? 
         implode (items[0..<2],(comma?comma:", ")) + 
          (and ? and : " und ") + items[<1] : 
         (sizeof (items) ? items[<1] : alternative));
}
