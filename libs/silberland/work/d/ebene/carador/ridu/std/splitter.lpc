#pragma strong_type
#include "../def.h"

inherit RD_THING;

object owner;

void init()
{
  ::init(); 
  if (!is_clone(this_object())) return;
  if (!owner)  {
    owner = this_player();
    return; 
  }
  if (owner == this_player() ||
      this_player() != environment() ) return;

  call_out("my_remove",0);
}

void my_remove()
{
  message(({
    ({ "Ploetzlich entgleitet ", M_PL_DAT, M_ME_BEST, " und schwebt auf "
       "geheimnisvolle Art davon." }) }));
  move(environment(this_player()), M_SILENT|M_NOCHECK);
  remove();
}

status is_magisch()
{
  object env;

  if ( !this_player() ||
       !(env = environment(this_player())) ) return 0;
  if (!present("\nridu#wolke", env) &&
      !env->QueryProp(P_RD_RIDU_AREA)) return 0;
  
  if (!find_object(RD_LIBDIR"mover")) return 0;
  return  1;
}


void create()
{
  RD_THING::create();
  
  SetProp(P_NAME, "Splitter");
  AddId(({ "splitter" }));
//  SetProp(P_NAME_ADJ, "farblos");
  SetProp(P_GENDER, MALE);
//  SetProp(P_SHORT, "ein farbloser Splitter");
  AddRule("reibe <me>", "reibe_splitter");
  AddRule("reibe an <me>", "reibe_splitter");
  AddRule("reibe am <me>", "reibe_splitter");
  SetProp(P_MATERIAL, MAT_CRYSTAL);
  SetProp(P_SIZE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);
}

status do_action(string verb, mapping args)
{
  switch(verb) {
    case "reibe_splitter": 
      if (environment() != this_player()) {
        message("Dazu solltest Du den Splitter erstmal nehmen.");
        return 2;
      }
      if (find_call_out("min_reibe_abstand") > -1) {
        message("Autsch, der Splitter ist noch zu warm.");
        return 2;
      }
      if (owner != this_player()) return 0;
      call_out("min_reibe_abstand", RD_MIN_REIBEABSTAND);
      message(({
        ({ M_PL_BEST, M_PL_VERB, "reib", "an",
           M_PL_DAT_POSS, this_object(), "." }) }));
      if (!is_magisch()) {
        message("\
Aber es passiert nichts weiter. Das Glimmen bleibt wie's ist.");
        return 2;
      }
      if (id("roter splitter")) RD_LIBDIR"mover"->turn(1,1);
      else if (id("lila splitter")) RD_LIBDIR"mover"->turn(-1,1);
      else if (id("gruener splitter")) {
        if (!RD_ROOMDIR"r4"->query_kaputt()) 
          RD_LIBDIR"mover"->go(1);
        else
          message("Seltsam, es passiert gar nichts weiter.");
      }
      else message("Nix passiert.");
      return 1;
  }
}
