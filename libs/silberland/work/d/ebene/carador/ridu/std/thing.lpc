#pragma strong_types
#include "../def.h"

inherit "/std/thing";
inherit RD_STDDIR"parser";
inherit RD_STDDIR"message";


varargs string long()
{
  mixed res;
  res = ::long();
  if (!res ||!strlen(res)) return res;
  if (res[<1..<1] != "\n") res =  my_break_string(res);
  return res;
}

void init()
{
  thing::init();
  add_actions();
}

void create()
{
  seteuid(getuid());
  ::create();
}
