#pragma strong_types
#include "../def.h"

inherit RD_THING;

mapping versuche;

private string my_long()
{
  string desc;
  
  desc = "\
Das ist ja mal eine seltsame Wolke, denkst Du Dir, als Du so nach oben \
schaust. Sie schwebt niedriger als alle Wolken, die Du jemals gesehen hast. \
Auch scheint sie nicht natuerlichen Ursprungs zu sein. Vielleicht kommst Du \
deshalb auch auf die Idee, es wuerde Sinn machen, etwas nach \
oben zu rufen [Syntax: ruf nach oben <text>]. ";
   
  if (present("\nridu#seil_unten", environment())) return desc + "\
Das lose Ende eines Seils haengt aus der Wolke herab.";

  if (this_player() && present("seil", this_player())) return desc + "\
Uebrigens, es waere bestimmt voellig sinnlos, das Seil, das Du dabei \
hast, nach oben in die Wolke zu werfen. Denn von Leuten, die an Seilen \
in Wolken geklettert sind, hat man noch nie etwas gehoert.";

 return desc + "\
 Okay, wo waren wir? Gut, dass Du kein Seil dabei hast. Denn ein Seil in \
die Wolke zu werfen mit dem Hintergedanken, dann hinaufklettern zu \
koennen, ist das Abwegigste, das man je gehoert hat.";
}

void create()
{
  thing::create();

  RD_LIBDIR"fischmaker"->clean_fischowners();

  versuche = ([]);
  if (is_clone(this_object())) {
    call_out("remove", 0);
    return;
  }
  SetProp(P_NOGET, "\
Huahuahua, haben wir gelacht, die Wolke nehmen zu wollen, nette Idee.\n");
  SetProp(P_NAME, "wolke");
  AddId(({ "\nridu#wolke", "wolke", "luft", "hoehe" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine seltsame Wolke");
  SetProp(P_LONG, #'my_long);
  AddId(({ "wolke", "seltsame wolke" }));
  AddRule("ruf nach oben <text>", "ruf_oben", RD_LIBDIR"mover");
  AddRule("rufe nach oben <text>", "ruf_oben", RD_LIBDIR"mover");
  AddRule("glaube an fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaube an das fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaube ans fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaube an's fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaub an fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaub an das fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaub ans fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaub an's fliegen", "glaube_fliegen", RD_LIBDIR"mover");
  AddErrorMessage("glaub","Moechtest Du vielleicht ans Fliegen glauben?");
  AddErrorMessage("glaube","Moechtest Du vielleicht ans Fliegen glauben?");
  AddRule("schleuder <object> in <me>", "werfe_seil");
  AddRule("schleudere <object> in <me>", "werfe_seil");
  AddRule("werfe <object> in <me>", "werfe_seil");
  AddRule("werfe <object> auf <me>", "werfe_seil");
  AddRule("wirf <object> in <me>", "werfe_seil");
  AddRule("wirf <object> auf <me>", "werfe_seil");
  AddRule("wirf <object> nach oben", "werfe_seil");
  AddRule("werfe <object> nach oben", "werfe_seil");
  AddErrorMessage("werfe", "\
Was willst Du werfen? Und wohin? Vielleicht etwas Schoenes in die Wolke?");
  AddErrorMessage("wirf", "\
Was willst Du werfen? Und wohin? Vielleicht etwas Schoenes in die Wolke?");
  move(RD_TOOLS->load_object(RD_WOLKENSTART),M_NOCHECK);
  RD_LOGGER->do_log("info", "Wolke wurde geladen");
  RD_TOOLS->load_object(RD_ROOMDIR"r1");
  RD_TOOLS->load_object(RD_NPCDIR"ridu");  // sollte schon da sein
  RD_TOOLS->load_object(RD_LIBDIR"mover");
}


varargs void set_seil(object s)
{
  object oben, ob;

  oben = RD_TOOLS->load_object(RD_ROOMDIR"r1");
  if (ob = present("\nridu#seil_oben", oben)) {
    ob->remove();
    message(({ ({ M_ROOM, oben, "Das Seil wird ploetzlich schlaff und "
      "faellt nach unten." }) }));
  }
  RD_TOOLS->load_object(RD_OBJDIR"seil_unten")->move(environment(),M_NOCHECK);
  move(environment(),M_NOCHECK);
  if (s) s->remove();
}

status do_action(string verb, mapping args)
{
  object ob;

  switch(verb) {
    case "werfe_seil" :
      if (query_message_busy()) {
        message("\
Wir wollen doch ein Seilwirrwarr vermeiden und warten, bis alle Seile wieder \
ordnungsgemaess gelandet sind, denn: Wenn hinter Seilen Seile fliegen, \
fliegen Seile Seilen nach oder so.");
        return 1;
      }
      if (environment(args[G_OBJECT]) != this_player()) {
        notify_fail("Das hast Du nicht.\n");
        return 0;
      }
      if (args[G_OBJECT]->move(environment(), M_PUT) < 0) {
        message("Das geht leider nicht.");
        return 1;
      }
      if (present("\nridu#seil_unten", environment()) && args[G_OBJECT]->id("seil")) {
        message("\
Gerade als Du ausholst, um das Seil nach oben zu werfen, bemerkst Du, dass \
das Seil bereits in der Wolke haengt. Hast Du schon geworfen, ohne es zu \
merken? Nein, so vergesslich bist Du auch nicht. Du kommst zu dem Schluss, \
dass bereits jemand anders ein Seil in die Wolke geworfen haben muss.");
        return 1;
      }
      versuche[this_player()]++;
//      versuche[this_player()]=4;
      if (!args[G_OBJECT]->id("seil") || versuche[this_player()] == 1) {
        message(
          ({ ({ M_PL_BEST, M_PL_VERB, "nimm", 
                M_PL_AKK_POSS, args[G_OBJECT], "und", M_PL_VERB,
                "schleuder", M_PRONOUN, args[G_OBJECT], "hoch nach oben" +
                " in die Wolke." }),
             4,
             ({ "Nur einen kleinen Moment spaeter", M_PL_VERB,
                ({ "wirst", "wird" }), M_PL_BEST, "von ",
                M_DAT, args[G_OBJECT], " am Kopf getroffen." }),
             2,
             ({ M_WRITE, "Na das war ja nun wirklich nicht anders zu " +
                "erwarten." }) }));
         if (args[G_OBJECT]->id("seil")) {
           message(({ 8, ({ M_WRITE, "Es ist bestimmt ZWECKLOS, " +
             "es noch einmal zu versuchen." }) }));
         }
         return 1;
      }
      if (RD_ROOMDIR"seil_raum"->is_seil_besetzt()) {
        versuche[this_player()]--;
        message(({ ({ "Gerade als", M_PL_BEST, " das Seil in die Luft " +
         "werfen", M_PL_VERB, ({ "moechtest", "moechte" }),
         ",", M_PL_VERB, "verhedder", M_PL_PRONOUN, M_PL_AKK_SICH,
         "im Seil und stuerzt zu Boden." }),
                  4,
                  ({ M_WRITE, "Vielleicht waere es besser, ein paar Minuten "+
                     "zu warten." }) }));
        return 1;
      }
      switch(versuche[this_player()]) {
        case 2:
          message(({ ({ "Ein zweites Mal", M_PL_VERB, "wirf",
                        M_PL_BEST, "das eine Ende des Seils in die Wolke. "
                        "Und ein zweites Mal faellt es wieder herunter." }),
                     4,
                     ({ "Nur diesmal nicht", M_PL_DAT, "auf den Kopf sondern "
                        "auf die Fuesse." }),
                     2,
                     ({ M_WRITE, "Es ist bestimmt VOELLIG ZWECKLOS, " 
                        "es noch einmal zu versuchen." }) }));
 
          return 1;
        case 3:
          message(({ ({ "Unermuedlich", M_PL_VERB, "schleuder",
                       M_PL_BEST, "das eine Ende", M_PL_POSS, "~es Seils in "
                       "luftige Hoehen." }),
                     6,
                     ({ "Nichts weiter passiert." }),
                     4,
                     ({ "Doch dann. Plumps. Das Seil faellt auf den Boden." }),
                     2,
                     ({ M_WRITE, "Die Schwerkraft ist ziemlich stur, denkst "
                        "Du. Es ist bestimmt VOELLIG ABSOLUT ZWECKLOS, "
                        "es noch einmal zu versuchen." }) }));
          return 1;
        default:
          set_seil(args[G_OBJECT]);
          message(({ ({ "Wie ein Hamster im Laufrad nicht aufhoeren kann, "
                        "zu laufen, so", M_PL_VERB, ({ "kannst", "kann" }),
                         M_PL_BEST,
                        "nicht aufhoeren, das lose Ende des Seils in die "
                        "Luft zu werfen." }),
                     4,
                     ({ "Das Seilende fliegt nach oben und sonst passiert "
                        "nichts weiter." }),
                     4,
                     ({ M_WRITE, "Nichts weiter. Das heisst insbesondere, "
                        "dass das Ende nicht wieder heruntergefallen ist. Wie "
                        "Du das nur wieder gemacht hast?" })
          }));
          return 1;
      }
      return 1;
      break;
  }
}
