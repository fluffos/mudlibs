#pragma strong_types
#include "../def.h"

inherit RD_THING;

void create()
{
  ::create();
  
  SetProp(P_NAME, "Bananenschale");
  AddId(({ "bananenschale", "schale" }));
  SetProp(P_SHORT,"eine Bananenschale");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LONG, "\
Eine Bananenschale, nicht weiter gefaehrlich, es sei denn sie liegt rum \
und jemand ist zu schnell unterwegs, weil er vielleicht von etwas oder \
jemand anderes genervt ist.");
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  remove();
}
