#pragma strong_types
#include "../def.h"

inherit RD_THING;

private void mydes()
{
  clone_object("/obj/seil")->move(environment(), M_NOCHECK);
  remove();
}

void create()
{
  thing::create();
  if (is_clone(this_object())) {
    call_out("remove", 0);
    return;
  }
  AddId(({ "seilende", "ende","seil", "\nridu#seil_unten" }));
  SetProp(P_NAME, "Seil");
  SetProp(P_SHORT, "Das lose Ende eines Seils haengt aus der Wolke herab");
  SetProp(P_LONG, "\
Verlockend baumelt das untere Ende des Seils vor Dir in Bauchhoehe herum. \
Okay, je nach Deiner Groesse koennte es auch Stirnhoehe oder Knoechelhoehe \
sein. Aber das ist zum Glueck nicht wichtig. Das obere Seilende kannst Du \
nicht erkennen, da es sich im Inneren der Wolke befindet.");
  SetProp(P_NOGET, "\
Du kannst es nicht einfach nehmen. Wenn Du es haben willst, musst Du dran \
ziehen.\n");
  AddRule("ziehe <me>", "ziehe_seil");
  AddRule("zieh <me>", "ziehe_seil");
  AddRule("zieh an <me>", "ziehe_seil");
  AddRule("ziehe an <me>", "ziehe_seil");
  AddRule("ziehe am <me>", "ziehe_seil");
  AddRule("zieh am <me>", "ziehe_seil");
  AddErrorMessage("zieh", "Du koennest am Seil ziehen.\n");
  AddErrorMessage("ziehe", "Du koennest am Seil ziehen.\n");
  AddErrorMessage("kletter", "Du koennest am Seil hoch klettern.\n");
  AddErrorMessage("klettere", "Du koennest am Seil hoch klettern.\n");
  AddRule("klettere <me>", "kletter_seil");
  AddRule("klettere <me> hoch", "kletter_seil");
  AddRule("klettere hoch", "kletter_seil");
  AddRule("klettere rauf", "kletter_seil");
  AddRule("klettere nach oben", "kletter_seil");
  AddRule("klettere oben", "kletter_seil");
  AddRule("klettere an <me> hoch", "kletter_seil");
  AddRule("klettere an <me> nach oben", "kletter_seil");
  AddRule("klettere am <me> hoch", "kletter_seil");
  AddRule("klettere am <me> nach oben", "kletter_seil");
  AddRule("kletter <me>", "kletter_seil");
  AddRule("kletter <me> hoch", "kletter_seil");
  AddRule("kletter hoch", "kletter_seil");
  AddRule("kletter rauf", "kletter_seil");
  AddRule("kletter nach oben", "kletter_seil");
  AddRule("kletter oben", "kletter_seil");
  AddRule("kletter an <me> hoch", "kletter_seil");
  AddRule("kletter an <me> nach oben", "kletter_seil");
  AddRule("kletter am <me> hoch", "kletter_seil");
  AddRule("kletter am <me> nach oben", "kletter_seil");
}

status do_action(string verb, mapping args) {
  string kl_name;
  switch(verb) {
    case "kletter_seil" :
      message(({ ({ M_PL_BEST, M_PL_VERB, "pack", "das Seil feste an mit "
          "beiden Haenden." }) }));
      if (kl_name = RD_ROOMDIR"seil_raum"->is_seil_besetzt()) {
         message(({
           ({ M_WRITE, "Du kletterst am Seil nach oben. Nachdem Du ein "
             "Stueck geklettert bist, erkennst Du im Nebel der Wolke "
             "den Hintern von " + kl_name + ", der auch am Seil haengt. "
             "Also nicht nur der Hintern, sondern auch der Rest von " +
             kl_name + ". Da dies nicht der Anblick ist, den Du Dir " 
             "fuer den Rest des Tages wuenschst, kehrst Du um." }),
           ({ M_SAY, M_PL_BEST, "klettert am Seil nach oben, kehrt aber " 
             "nach wenigen Augenblicken wieder zurueck." })
         }));
         return 1;
      }
      message("\
Du beginnst, nach oben zu klettern. Du kletterst weiter und weiter. Um Dich \
herum beginnt es nebelig zu werden. Inzwischen bist Du in der Wolke \
angelangt. Du kletterst weiter und weiter. Hoppla! Ploetzlich ist das Seil zu \
Ende. Mitten in der Luft. Mitten in der Wolke."); 

      RD_LOGGER->do_log("info", "Enter ", this_player());
  
      this_player()->move(RD_TOOLS->load_object(RD_ROOMDIR"seil_raum"), M_GO, "oben", "klettert am Seil nach");

      return 1;
    case "ziehe_seil" :
      if (RD_ROOMDIR"seil_raum"->is_seil_besetzt()) {
        message(({
          ({ M_PL_BEST, M_PL_VERB, "zieh", "am Seil." }),
          2,
          ({ M_WRITE, "Nichts weiter passiert. Das Seil fuehlt sich auch "
             "so traege an, als ob jemand am oberen Ende des Seils haengen "
             "wuerde. Also laesst Du's lieber bleiben, weiter am Seil "
             "rumzufummeln." })
        }));
        return 1;
      }
      message(({
        ({ M_PL_BEST, M_PL_VERB, "zieh", "am Seil." }),
        2,
        ({ M_WRITE, "Nichts weiter passiert. Was hast Du auch anderes "
           "erwartet. Es waere ja auch schlecht, wenn das Seil beim "
           "leichtesten Zug runterfallen wuerde. Stell Dir nur mal vor "
           "Du wuerdest am Seil hochklettern wollen und es wuerde gleich "
           "runterfallen." }),

        4,
        ({ M_PL_BEST, "laesst wieder locker am Seil und", M_PL_VERB, "zieh",
           "ein zweites Mal." }),
        2,
        ({ M_WRITE, "Du denkst: Hoffentlich kapiert das Seil jetzt, dass ich "
           "es haben will und nicht etwa daran hochklettern moechte." }),

        4,
        ({ "Ploetzlich loest sich das obere Ende des Seils und faellt auf "
           "den Boden, wo es freudig auf das untere Ende trifft." }),
        ({ #'mydes })
     })); 
     return 1;
  }
}
