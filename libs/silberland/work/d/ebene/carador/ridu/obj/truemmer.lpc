#pragma strong_types
#include "../def.h"
#include <exploration.h>
#include <verben.h>

inherit RD_THING;

void create()
{
  object ob;
  ::create();

  if (is_clone(this_object())) {
    call_out(#'remove, 0);
    return;
  }

  SetProp(P_NAME, "Truemmer");
  SetProp(P_SHORT, "Die Truemmer eines Schiffs");
  SetProp(P_LONG, "\
Herrje, was fuer ein Durcheinander. Da blieb keine Planke auf der anderen. \
Holzsplitter ueber Holzsplitter. Ein gewaltiger Schuttberg.");
  AddDetail( 
    ({ "haufen", "durcheinander", "planke", "splitter",
       "holzsplitter", "truemmerhaufen" }), "\
Huihui, das ist ein ganz schoen viele Truemmer. Vielleicht ist ja doch noch \
etwas Brauchbares dabei. Vielleicht mal durchwuehlen?");

  AddId(({ "schiff", "truemmer" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_NOGET, 1);
  AddCmd(CMD_DURCHSUCHEN, "durchwuehle");
}

status durchwuehle(string arg)
{
  object *inv;

  if (!arg || !id(arg)) { 
    return 0;
  }

  if (!first_inventory(this_object())) {
    message(({ ({ M_PL, M_PL_VERB, "durchwuehl", "die Truemmer, ",
      M_PL_VERB, "finde", "aber nichts Brauchbares." }) }));
    return 1;
  }

  inv = shuffle_array(all_inventory(this_object()));
  if ( inv[0]->move(this_player(), M_GET) < 1 &&
       inv[0]->move(environment(this_player())) < 1 ) {
    inv[0]->remove();
    message(({ ({ M_PL, M_PL_VERB, "durchwuehl", "die Truemmer, ",
      M_PL_VERB, "finde", "aber nichts Brauchbares." }) }));
    return 1;
  }
  message(({ ({ M_PL, M_PL_VERB, "durchwuehl", "die Truemmer." }),
      ({ "Nach kurzer Zeit", M_PL_VERB, "finde", M_PL_PRONOUN,
         "tatsaechlich etwas, das aussieht wie ", inv[0],
         ".", M_PL, M_PL_VERB, "zieh", M_PRONOUN, inv[0],
         "aus dem Truemmerhaufen." }) }));
  return 1;
}




void reset()
{
  ::reset();
  remove();
}


void init()
{
  object mv;

  ::init();

  if ( (mv = find_object(RD_LIBDIR"mover")) &&
       mv->is_abgestuerzt() ) {
    EPMASTER->GiveExplorationPoint("absturz", EP_MISC);
  }
}
