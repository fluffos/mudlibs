#pragma strong_types
#include "../def.h"
#include <food.h>

inherit "std/food";
inherit RD_STDDIR"message";


void create()
{
  ::create();

  if (!is_clone(this_object())) return;

  SetProp(P_NAME, "Apfel");
  AddId(({ "apfel", "roten apfel", "roter apfel" }));
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein roter Apfel");
  SetProp(P_LONG, "Ein roter, lecker aussehender Apfel.");
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 20);
  SetProp(P_FOOD_INFO,
   ([ F_HEAL: 2,
      F_SOAK: 1,
      F_MSG : "Du isst den Apfel. Nicht schlecht!",
      F_MSG_ROOM: "isst einen Apfel." ])
  );
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  
  if (environment() && living(environment()))
    message(({ ({ M_TARGETS, environment(), "Der Apfel sieht inzwischen so "
      "unappetitlich aus, dass Du ihn wegpfefferst." }) }));
  remove();
}
