#pragma strong_types
#include "../def.h"
#include <food.h>

inherit "std/container";


string _query_short()
{
  string cmd;

  if (!this_player() ||
      !(cmd = this_player()->_unparsed_args()) ||
      strstr(lower_case(cmd), "schale") < 0
     ) return 0;
  return "Eine Tonschale";
}


void make_food()
{
  object ob;
  string farbe;

  while (!present("tomate 2", this_object())) {
    ob = clone_object("std/food");
    ob->SetProp(P_NAME, "Tomate");
    ob->AddId(({ "\nridu#gemuese", "tomate", "rote tomate" }));
    ob->SetProp(P_NAME_ADJ, "rot");
    ob->SetProp(P_GENDER, FEMALE);
    ob->SetProp(P_SHORT, "Eine rote Tomate");
    ob->SetProp(P_LONG, "Eine saftige, rote Tomate.");
    ob->SetProp(P_WEIGHT, 50);
    ob->SetProp(P_VALUE, 10);
    ob->SetProp(P_FOOD_INFO,
     ([ F_HEAL: 3,
        F_SOAK: 2,
        F_MSG : "Du isst die Tomate. Schmeckt echt lecker.",
        F_MSG_ROOM: "isst eine Tomate." ])
    );
    ob->move(this_object(), M_NOCHECK);
  }
  while (!present("gurke 2", this_object())) {
    ob = clone_object("std/food");
    ob->SetProp(P_NAME, "Gurke");
    ob->AddId(({ "\nridu#gemuese", "gurke", "gruene gurke" }));
    ob->SetProp(P_NAME_ADJ, "gruen");
    ob->SetProp(P_GENDER, FEMALE);
    ob->SetProp(P_SHORT, "Eine gruene Gurke");
    ob->SetProp(P_LONG, "Eine gruene Salatgurke.");
    ob->SetProp(P_WEIGHT, 100);
    ob->SetProp(P_VALUE, 15);
    ob->SetProp(P_FOOD_INFO,
     ([ F_HEAL: 4,
        F_SOAK: 3,
        F_MSG : "Du isst die Gurke. Schmeckt echt lecker.",
        F_MSG_ROOM: "isst eine Gurke." ])
    );
    ob->move(this_object(), M_NOCHECK);
  }
  while (!present("paprika 3", this_object())) {
    farbe = ({ "rot", "gruen", "gelb", "violett" })[random(4)];
    ob = clone_object("std/food");
    ob->SetProp(P_NAME, "Paprika");
    ob->AddId(({ "\nridu#gemuese", "paprika", farbe + "e paprika" }));
    ob->SetProp(P_NAME_ADJ, farbe);
    ob->SetProp(P_GENDER, FEMALE);
    ob->SetProp(P_SHORT, "Eine " + farbe + "e Paprika");
    ob->SetProp(P_LONG, "Eine knackige, " + farbe + "e Paprika.");
    ob->SetProp(P_WEIGHT, 20);
    ob->SetProp(P_VALUE, 10);
    ob->SetProp(P_FOOD_INFO,
     ([ F_HEAL: 3,
        F_SOAK: 2,
        F_MSG : "Du isst die " + farbe + "e Paprika. Schmeckt echt lecker.",
        F_MSG_ROOM: "isst eine " + farbe + "e Paprika." ])
    );
    ob->move(this_object(), M_NOCHECK);
  }

  if (!present("banane", this_object()))
   clone_object(RD_OBJDIR"banane")->move(this_object(), M_NOCHECK);
}

void create()
{
  ::create();
  SetProp(P_NAME, "Tonschale");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "\nridu#schale", "schale", "tonschale" }));
  SetProp(P_SHORT, "Eine Tonschale");
  SetProp(P_LONG, "\
Eine grosse, schwere Tonschale, wo man z.B. Obst und Gemuese reinlegen \
kann.");
  SetProp(P_NOGET,1);
  SetProp(P_MAX_WEIGHT, 50000);
  if (is_clone(this_object())) make_food();
}

void reset()
{
  ::reset();
  make_food();
}
