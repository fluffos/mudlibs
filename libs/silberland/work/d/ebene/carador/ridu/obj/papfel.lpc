#pragma strong_types
#include "../def.h"

inherit RD_THING;

void create()
{
  ::create();

  SetProp(P_NAME, "Pferdeapfel");
  SetProp(P_GENDER, MALE);
  AddId(({ "apfel", "pferdeapfel" }));
  SetProp(P_SHORT, "Ein Pferdeapfel");
  SetProp(P_LONG, "\
Ein schoener, runder, allerdings uebelriechender Pferdeapfel.");
  SetProp(P_SMELL, "Uaaaaaaaaaaaaaah! Der Pferdeapfel stinkt echt Scheisse!\n");
  SetProp(P_MATERIAL, ([MAT_SHIT:100]) );
  SetProp(P_SIZE, 15);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 300);
}
