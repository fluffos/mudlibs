#pragma strong_types
#include "../def.h"

inherit RD_THING;

void create()
{
  thing::create();
  if (is_clone(this_object())) {
    call_out("remove", 0);
    return;
  }
  AddId(({ "seilende", "ende","seil", "\nridu#seil_oben" }));
  SetProp(P_NAME, "Seil");
  SetProp(P_SHORT, "\
Das lose Ende eines Seils haengt ueber die Reling in die Tiefe hinab");
  SetProp(P_LONG, "\
Das Seil haengt ueber die Reling in die Tiefe hinunter. Du schaust mal \
kurz hinunter. Dir wird schwindelig, als Du das Seil in einer Nebelschwade \
(die gerade vorbeischwebt) verschwinden siehst. Lieber nicht zu genau nach \
unten schauen. Nichtsdestotrotz koenntest Du nach unten klettern.");
  SetProp(P_NOGET, "\
Du kannst es nicht einfach nehmen. Wenn Du es haben willst, musst Du dran \
ziehen.\n");
  AddErrorMessage("zieh", "Du koennest am Seil ziehen.\n");
  AddErrorMessage("ziehe", "Du koennest am Seil ziehen.\n");
  AddErrorMessage("kletter", "Du koennest am Seil runter klettern.\n");
  AddErrorMessage("klettere", "Du koennest am Seil runter klettern.\n");
  AddRule("ziehe <me>", "ziehe_seil");
  AddRule("zieh <me>", "ziehe_seil");
  AddRule("zieh an <me>", "ziehe_seil");
  AddRule("ziehe an <me>", "ziehe_seil");
  AddRule("ziehe am <me>", "ziehe_seil");
  AddRule("zieh am <me>", "ziehe_seil");
  AddRule("klettere <me>", "kletter_seil");
  AddRule("klettere <me> runter", "kletter_seil");
  AddRule("klettere runter", "kletter_seil");
  AddRule("klettere nach unten", "kletter_seil");
  AddRule("klettere unten", "kletter_seil");
  AddRule("klettere an <me> runter", "kletter_seil");
  AddRule("klettere an <me> nach unten", "kletter_seil");
  AddRule("klettere am <me> runter", "kletter_seil");
  AddRule("klettere am <me> nach unten", "kletter_seil");
  AddRule("kletter <me>", "kletter_seil");
  AddRule("kletter runter", "kletter_seil");
  AddRule("kletter <me> runter", "kletter_seil");
  AddRule("kletter nach unten", "kletter_seil");
  AddRule("kletter unten", "kletter_seil");
  AddRule("kletter an <me> runter", "kletter_seil");
  AddRule("kletter an <me> nach unten", "kletter_seil");
  AddRule("kletter am <me> runter", "kletter_seil");
  AddRule("kletter am <me> nach unten", "kletter_seil");
}

status do_action(string verb, mapping args) {
  object ob;
  string kl_name;

  switch(verb) {
    case "kletter_seil" :
      message(({ ({ M_PL_BEST, M_PL_VERB, "schwing", 
          M_PL_AKK_SICH, "am Seil ueber die Reling." }) }));
      if (kl_name = RD_ROOMDIR"seil_raum"->is_seil_besetzt()) {
         message(({
           ({ M_WRITE, "Nach einem kurzen Stueck, erkennst Du im Nebel "
             "der Wolke den Kopf von " + kl_name + ", der auch am Seil "
             "haengt. Also nicht nur der Kopf, sondern auch der Rest von " +
             kl_name + ". Da dies nicht der Anblick ist, den Du Dir " 
             "fuer den Rest des Tages wuenschst, kehrst Du um." }),
           ({ M_SAY, M_PL_BEST, "taucht nach wenigen Augenblicken wieder "
             "auf." })
         }));
         return 1;
      }
      message("\
Du kletterst weiter nach unten und zwar genau so weit, bis Du mitten in der \
Wolke am Endes des Seils angelangt bist.");
      this_player()->move(RD_TOOLS->load_object(RD_ROOMDIR"seil_raum"), M_GO, "unten", "klettert am Seil nach");

      return 1;
    case "ziehe_seil" :
      if (RD_ROOMDIR"seil_raum"->is_seil_besetzt()) {
        message(({
          ({ M_PL_BEST, M_PL_VERB, "zieh", "am Seil." }),
          2,
          ({ M_WRITE, "Urgx, ist das schwer. Da haengt bestimmt jemand dran "
             "am Seil. Und der Jemand ist Dir zu schwer, um ihn nach "
             "oben zu ziehen." }) }));
        return 1;
      }
      message(({
        ({ M_PL_BEST, M_PL_VERB, "zieh", "das Seil nach oben und ",
          M_PL_VERB, "steck", " es ein." }) })); 
      ob = clone_object("/obj/seil");
      if (ob->move(this_player(), M_GET) < 0) ob->move(environment(),M_NOCHECK);
      remove();
     return 1;
  }
}
