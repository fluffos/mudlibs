#pragma strong_types
#include "../def.h"

inherit "obj/container";
inherit RD_STDDIR"parser";
inherit RD_STDDIR"message";

void my_des()
{
  object ob;
  if (environment()) {
    while(ob=first_inventory(this_object())) ob->move(environment(), M_NOCHECK);
  }
  remove();
}

void create()
{
  container::create();
  SetProp(P_NAME, "Paket");
  AddId("paket");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Ein Paket");
  SetProp(P_LONG, "\
Ein Paket mit der Aufschrift: \
'An Ridu Cerrall', 'Absender IFM (Industrial Flight and Magic)'");
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_SIZE, 40);
  SetProp(P_MATERIAL, MAT_CARTON);
  SetProp(P_MAX_WEIGHT, 10000);
  if (is_clone(this_object())) {
    clone_object(RD_OBJDIR"ableiter")->move(this_object(),M_NOCHECK);
    clone_object(RD_OBJDIR"anleitung2")->move(this_object(),M_NOCHECK);
  } 
}

int do_open(string args)
{
  int res;

  res = container::do_open(args);
  if (QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN) call_out("my_des", 0);
  return res;
}
