#pragma strong_types
#include "../def.h"

inherit "std/container";
inherit RD_STDDIR"parser";
inherit RD_STDDIR"message";

void create()
{
  container::create();

  SetProp(P_NAME, "Weidenkorb");
  AddId(({ "korb", "weidenkorb" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Weidenkorb");
  SetProp(P_LONG, "\
Hierbei handelt es sich um einen einfachen, etwas sperrigen Weidenkorb, \
wie er in der Landwirtschaft haeufig verwendet wird.");
  SetProp(P_WEIGHT, 4000);   // ziemlich sperrig
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 60);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_MAX_WEIGHT, 10000);
  if (!is_clone(this_object())) return;
}
