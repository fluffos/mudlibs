#pragma strong_types
#include "../def.h"

inherit "obj/container";
inherit RD_STDDIR"parser";
inherit RD_STDDIR"message";

mapping oeffner;
status schonmal_offen;

void create()
{
  oeffner = ([]);
  container::create();
  SetProp(P_NAME, "Buechse");
  SetProp(P_NAME_ADJ, "seltsam");
  AddId("buechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine seltsame Buechse");
  SetProp(P_LONG, "\
Diese unscheinbare, aber ueberaus interessante Buechse traegt eine \
verhaengnisvoraussagende Aufschrift.");
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 30);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_MAX_WEIGHT, 5000);
  AddReadDetail("aufschrift", "KEINESFALLS OEFFNEN!");
  AddDetail("aufschrift", "Ohne die Aufschrift bewusst zu lesen, springen "
   "Dir die Worte 'KEINESFALLS OEFFNEN' in den Kopf.");
}


int do_open(string args)
{
  if (!args || !id(args) || !this_player() ||
      QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN) 
        return (::do_open(args) ? 2: 0);
  
  oeffner[this_player()]++;
  switch(oeffner[this_player()]) {
    case 1:
      message("\
Meinst Du das wirklich? Hast Du nicht die Aufschrift gesehen? KEINESFALLS \
OEFFNEN! Es ist bestimmt saugefaehrlich, die Buechse zu oeffnen. Bestimmt \
kommst Du dabei ums Leben oder noch schlimmer, verlierst Deine gesamte \
Ausruestung.");
      return 2;
    case 2:
      message("\
Hey, Du bist echt mutig. Den Mutigen gehoert der Tod oder wie heisst das \
Sprichwort nochmal? Gut, wir wollen ja nicht unfair sein und Dich ungewarnt \
in den Tod rennen lassen. Deshalb noch eine allerletzte Erinnerung: Auf der \
Buechse steht: KEINESFALLS OEFFNEN. Also halt Dich doch einfach daran. Aber \
ich merke schon, wie die Neugier schier unbaendig in Dir nagt... Okay, aber \
dass mir hinterher niemand rummeckert. Wenn Du die Buechse GANZ BESTIMMT \
oeffnen willst, so probiers einfach nochmal.");
      return 2;
    default :
      oeffner[this_player()]++;
      if (!schonmal_offen) {
        schonmal_offen = 1;
        message(({ 4, 
          ({ M_WRITE, "Ha, passiert doch gar nix! So ein Gelatsch "
          "von wegen KEINESFALLS OEFFNEN. Hehehe. Na mal sehen, was jetzt in "
          "der Buechse drin ist." }) }));
        clone_object(RD_OBJDIR"staub")->move(environment(this_player()),
                                             M_NOCHECK);
      }
      return ::do_open(args);
  }
}
