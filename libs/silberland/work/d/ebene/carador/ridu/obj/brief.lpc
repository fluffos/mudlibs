#pragma strong_types
#include "../def.h"

inherit RD_THING;
inherit "std/more";

void create()
{
  ::create();
  
  SetProp(P_NAME, "Brief");
  SetProp(P_GENDER, MALE);
  AddId(({ "papier", "pergament", "brief"}));
  SetProp(P_SHORT, "Ein Brief");
  SetProp(P_LONG, "Ein handgeschriebener Brief, den Du lesen koenntest, "
    "d.h Du koenntest es zumindest versuchen.");
  SetProp(P_NOBUY,1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([ MAT_PAPER: 100 ]));
  SetProp(P_SIZE, 20);
  AddRule("lies <me>", "lies_brief");
}

status do_action(string verb, mapping args)
{
  switch(verb) {
    case "lies_brief" :
      message(({ ({ M_PL_BEST, "liest den Brief." }) }));
      More(RD_TEXTDIR"brief.txt",1);
      return 1;
  }
}
