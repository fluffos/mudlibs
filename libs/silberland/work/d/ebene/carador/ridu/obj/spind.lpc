#pragma strong_types
#include "../def.h"

inherit "obj/container";
inherit RD_STDDIR"parser";
inherit RD_STDDIR"message";

string _query_short()
{
  string cmd;

  if (!this_player() ||
      !(cmd = this_player()->_unparsed_args()) ||
      strstr(lower_case(cmd), "spind") < 0
     ) return 0;
  return "Ein Spind";
}


void make_things()
{
  object ob;

  if (!present("arbeitshemd")) {
    ob = clone_object(RD_ARMOUR);
    ob->SetProp(P_GENDER, NEUTER);
    ob->SetProp(P_NAME, "Arbeitshemd");
    ob->AddId(({ "arbeitshemd", "hemd" }));
    ob->SetProp(P_SHORT, "Ein Arbeitshemd");
    ob->SetProp(P_LONG, "Ein altes Arbeitshemd von Xaver.");
    ob->SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
    ob->SetProp(P_AC, 1);
    ob->SetProp(P_MATERIAL, MAT_CLOTH);
    ob->SetProp(P_WEIGHT, 2000);
    ob->SetProp(P_VALUE, 100);
    ob->move(this_object(), M_NOCHECK);
  }
  if (!present("lederstiefel")) {
    ob = clone_object(RD_ARMOUR);
    ob->SetProp(P_GENDER, MALE);
    ob->SetProp(P_PLURAL, 1);
    ob->SetProp(P_NAME, "Lederstiefel");
    ob->AddId(({ "lederstiefel", "stiefel" }));
    ob->SetProp(P_SHORT, "Lederstiefel");
    ob->SetProp(P_LONG, "Alte Lederstiefel von Xaver.");
    ob->SetProp(P_ARMOUR_TYPE, AT_BOOT);
    ob->SetProp(P_AC, 0);
    ob->SetProp(P_WEIGHT, 1000);
    ob->SetProp(P_VALUE, 50);
    ob->move(this_object(), M_NOCHECK);
  }
}

void create()
{
  ::create();
  SetProp(P_NAME, "Spind");
  SetProp(P_NAME_ADJ, "alt");
  SetProp(P_GENDER, MALE);
  AddId(({ "\nridu#spind", "spind", "alten spind", "spindtuer" }));
  SetProp(P_SHORT, "Ein Spind");
  SetProp(P_LONG, "\
Auch der Spind sieht ziemlich alt aus. Vor allem sieht er aus, als \
wuerde er sich schlecht oeffnen und schliessen lassen, weil er bestimmt \
klemmt. (Oh nein, nicht schon wieder!)");
  SetProp(P_NOGET,1);
  SetProp(P_MAX_WEIGHT, 50000);
  AddRule("trete <me>", "trete");
  AddRule("tritt <me>", "trete");
  AddRule("trete an <me>", "trete");
  AddRule("tritt gegen me>", "trete");
  AddRule("trete an <me>", "trete");
  AddRule("tritt gegen <me>", "trete");
  if (is_clone(this_object())) make_things();
}

void reset()
{
  ::reset();
  SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
  make_things();
}

private mixed my_des()
{
  object ob;
  while (ob = first_inventory()) ob->move(environment(), M_NOCHECK);
  remove();
}

status do_action(string verb, mapping args)
{
  switch(verb) {
    case "trete" :
      message(({
        ({ M_PL, M_PL_VERB, ({ "trittst", "tritt" }),
           "gegen den Spind." }),
        ({ "Oh oh, ob das so gut war? Der Spind wackelt..." }),
        4,
        ({ "Der Spind rappelt..."}),
        4,
        ({ "Der Spind knarzt..." }),
        4,
        ({ "Ploetzlich bricht der Spind mit einem lauten Donnerschlag "
           "in sich zusammen und reiht sich damit unauffaellig unter das "
           "schon vorhandene Geruempel." }),
        ({ #'my_des }) }));
      return 1;
  }
}

void init()
{
  ::init();
  add_actions();
}
