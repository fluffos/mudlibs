#pragma strong_type
#include "../def.h"

inherit RD_THING;

private void mydes()
{
  remove();
}

void do_msg()
{
  object e;

  if (!(e = environment())) {
    remove();
    return;
  }
  message(({
    4,
    ({ M_ROOM, e, "Ploetzlich rieselt ein seltsamer, schwarzer Staub "
                  "aus der Buechse." }),
    4,
    ({ M_ROOM, e, "Immer mehr und mehr von dem schwarzen Staub erfuellt den "
       "Raum."}),
    6,
    ({ M_ROOM, e, "Der Staub kriecht in Deine Augen. Sie fangen sofort an "
       "zu traenen. Haettest Du bloss nicht diese bloede Buechse geoeffnet, "
       "oder warst Du's gar nicht?" }),
    6,
    ({ M_ROOM, e, "Au, das tut vielleicht weh. Oha, jetzt merkst Du auch ein "
       "seltsames Kratzen im Hals. Deine Lungen haben auch was von dem "
       "Staub abgekriegt." }),
    6,
    ({ M_ROOM, e, "Du musst fuerchterlich husten, so sehr, dass es anfaengt, "
       "Dich zu wuergen. Du bekommst keine Luft mehr." }),
    6,
    ({ M_ROOM, e, "Du bekommst noch immer keine Luft, drohst zu ersticken. "
       "So ein Scheiss, denkst Du." }),
    6,
    ({ M_ROOM, e, "Du hast nur noch einen Gedanken: SCHNELL RAUS HIER" }),
    6,
    ({ M_ROOM, e, "Doch was ist jetzt? Bist Du schon tot?" }),
    6,
    ({ M_ROOM, e, "So schnell, wie er gekommen war, so schnell ist der "
       "Staub auch wieder verschwunden. Er loest sich einfach auf." }),
    6,
    ({ M_ROOM, e, "Du kannst wieder ganz normal atmen. Auch Die Augen tun "
       "Dir nicht mehr weh." }),
    ({ #'mydes })
  }));
}

void create()
{
  ::create();
  SetProp(P_NAME, "Staub");
  AddId(({ "staub", "schwarzen staub", "schwarzer staub" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_SHORT, "Schwarzer Staub schwebt durch den Raum");
  SetProp(P_LONG, "\
Dieser schwarze Staub sieht total unangenehm und saugefaehrlich aus.");
  SetProp(P_NOGET, 1);
  if (is_clone(this_object())) call_out("do_msg", 0);
}
