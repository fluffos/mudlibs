#pragma strong_type
#include "../def.h"

inherit RD_THING;

status dach;
string klemme;

status id(string str)
{
  return ( (dach && str == "\nridu#ableiter_dach") ||
           (klemme && str == "\nridu#ableiter_klemme") ||
           ::id(str) ); 
}

string query_klemme()
{
  return klemme;
}


void loese_klemme()
{
  klemme = 0;
}


string _query_short()
{
  string desc;

  if (!dach && !klemme) return
    "ein magischer Blitzeableiter mit Kabel";

  desc = "ein Blitzeableiter (auf dem Kabinendach";
  if (klemme) desc += ", Klemme " + klemme;
  return desc + ")";
}

void create()
{
  ::create();

  SetProp(P_NAME, "Blitzeableiter");
  SetProp(P_NAME_ADJ, "magisch");
  AddId(({ "blitzableiter", "ableiter", 
           "blitzeableiter", "kabel", "draht", "klemme", "eisen" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein magischer Blitzeableiter mit Kabel");
  SetProp(P_LONG, "\
Du weisst zwar nicht was ein Blitzeableiter mit Kabel ist, aber dies hier \
ist auf jeden Fall ein langes, duennes Stueck Eisen, wo an einem Ende \
ein langer, dicker, biegsamer Draht wegfuehrt, der am Ende eine Art Klemme \
hat. Es ist wohl besser, Du liest die Bedienungsanleitung, die hoffentlich \
dabei ist.");
  SetProp(P_MATERIAL, ([ MAT_IRON : 100 ]));
  SetProp(P_SIZE, 30);
  SetProp(P_NOBUY,1);
  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT, 3000);
  AddRule("stelle <me> auf <object>", "stelle");
  AddRule("stelle <me> aufs <object>", "stelle");
  AddRule("befestige <me> auf <object>", "stelle");
  AddRule("befestige <me> aufs <object>", "stelle");
  AddRule("klemme <me> an <object>", "klemme");
  AddRule("klemme <me> am <object>", "klemme");
  AddRule("befestige <me> an <object>", "klemme");
  AddRule("befestige <me> am <object>", "klemme");
  AddErrorMessage("stelle", "\
Vielleicht solltest Du die Gebrauchsanweisung besser lesen.");
  AddErrorMessage("klemme", "\
Vielleicht solltest Du die Gebrauchsanweisung besser lesen.");
  AddErrorMessage("befestige", "\
Vielleicht solltest Du die Gebrauchsanweisung besser lesen.");
}

status do_action(string verb, mapping args)
{
  switch(verb) {
    case "klemme" :
      if (member_array(args[G_ME,1], ({ "kabel", "draht", "klemme", 
        "eisen" })) <0) {
         message("\
Also, der Ableiter gehoert auf das Dach, und das Kabel muss irgendwo \
angeklemmt werden.");
         return 1;
      }

      if (!dach) {
        message("\
Zuerst muss der Blitzeableiter auf's Dach und danach kannst Du Dir um \
das andere Ende Gedanken machen.");
        return 1;
      }
 
      if (klemme) {
        message(({ ({ M_PL_BEST, M_PL_VERB, "klemm", " das Kabel " +
          klemme + " los." }) }));
        klemme = 0;
      }

      if (member_array(args[G_OBJECT,1],
          ({ "stein", "gruenem stein", "gruenen stein" })) > -1) {
        klemme = "am gruenen Stein";
        message(({ 
          ({ M_SAY, M_PL_BEST, "klemmt das Kabel des Blitzeableiters am "
             "gruenen Stein fest." }),
          ({ M_WRITE, "Du klemmst das Kabel an einem besonders herausragenden "
             "Buckel des gruenen Steins fest. So, jetzt sollte aber "
             "entgueltig Schluss sein mit unerwuenschten magischen Entladungen."
          })
        }));
        return 1;
      }
      if (member_array(args[G_OBJECT,1],
          ({ "schnitzerei", "schnitzereien",
             "koerper", "drachenkoerper",
             "schwanz", "drachenschwanz",
             "drachen", "drache", "hinterteil", "hintern", 
             "drachenhintern" })) > -1) {
        
        if (!environment(this_player())->query_hintern()) {
          message("\
Holla, gar kein Drachenschwanz da. Vielleicht hast Du da was verpasst?");
          return 1;
        }
        klemme = "am Drachenschwanz";
        message(({
          ({ M_SAY, M_PL_BEST, "klemmt das Kabel des Blitzeableiters am "
             "Schwanz des Drachens fest." }),
          ({ M_WRITE, "Oh nein, was man nicht alles tut. Das sieht bestimmt "
             "total laecherlich aus, wie Du Dich mit der Klemme bewaffnet "
             "ueber die Reling haengst und sie genau am Schwanz des "
             "Drachens festzwickst." }) 
        }));
        return 1;
      }
      message("\
Die Bedienungsanleitung sieht eine Befestigung des Kabels hier nicht \
vor. Das waere bestimmt zu gefaehrlich.");
      return 1;
      
    case "stelle" :
      if (member_array(args[G_ME,1], ({ "kabel", "draht", "klemme", 
        "eisen" })) > -1) {
         message("\
Also, der Ableiter gehoert auf das Dach, und das Kabel anderswohin.");
         return 2;
      }
      if (args[G_OBJECT,1] != "dach" && args[G_OBJECT,1] != "kabinendach") {
        message("\
Dieser magische Blitzeableiter ist nur zur Dachmontage geeignet. \
Hey, das hoerst sich ja an, als ob es woertlich aus der \
Gebrauchsanweisung stammen wuerde.");
        return 2;
      }
      if (!args[G_OBJECT]->is_blitzeableiter_geeignet()) {
        message("\
Irgendwie kommst Du von hier aus nicht an das Dach ran.");
        return 2;
      }
      if (dach) {
        message("Aber da ist der doch schon.");
        return 2;
      }
      if (present("\nridu#ableiter_dach", environment(this_player()))) {
        message("Einer reicht wohl.");
        return 2;
      }
      move(environment(this_player()), M_PUT);
      dach = 1;
      message(({ 
        ({ M_PL_BEST, M_PL_VERB, "kletter", "ein Stueck auf das "
           "Kabinendach hoch und", M_PL_VERB, "befestig", "dort"
           " den Blitzeableiter." })
      }));
      return 1;
  }
}

void init() 
{
  ::init();
  if (environment() == this_player()) {
    dach = 0;
    klemme = 0;
  }
}
