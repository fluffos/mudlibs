#pragma strong_types
#include "../def.h"

inherit RD_THING;

status is_magisch()
{
  object env;

  if ( !this_player() ||
       !(env = environment(this_player())) ) return 0;
  if (!present("\nridu#wolke", env) &&
      !env->QueryProp(P_RD_RIDU_AREA)) return 0;
 
  if (!find_object(RD_LIBDIR"mover")) return 0;
  return  1;
}

string _query_short()
{
  return (is_magisch() ?  "ein magisches Anti-Nebel-Fernrohr" : "ein Fernrohr");
}


private string my_long()
{
  return (is_magisch() ? "\
Gerade jetzt, wo Du's anschaust, ist das Fernrohr in einem tadellosen Zustand. \
Es erstrahlt in hellgoldenem Glanz und Du koenntest einfach mal durchschauen. \
" : "\
Gerade als Du es anschaust, sieht das Fernrohr alt aus und zu nichts mehr zu \
gebrauchen. Die Linsen sind zerbrochen. Wirf's weg, es ist nur unnoetiger \
Ballast. Aber irgendwas ist doch komisch daran, denkst Du. Vielleicht kann \
man's ja doch noch wo brauchen.");
}

void create()
{
  RD_THING::create();
  SetProp(P_NAME, "Fernrohr");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  AddId(({ "magisches rohr", "magisches fernrohr", "fernrohr", "rohr" }));
  SetProp(P_SHORT, "Ein Fernrohr");
  SetProp(P_LONG, #'my_long);
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD : 80, MAT_GLASS : 20 ]));
  SetProp(P_SIZE, 50);
  AddRule("schau durch <me>", "schau_fernrohr");
  AddRule("schaue durch <me>", "schau_fernrohr");
  AddDetail(({ "glanz", "hellgoldenen glanz", "goldenen glanz" }), 
    "Schoen schoen, Glanz hin oder her, nu' schau endlich durch das Fernrohr");
}

void schau_schiff() {
  int i;
  object r, *liv;
  string desc;

  liv = ({});

  for (i=1;i<=6;i++) {
    r = find_object(RD_ROOMDIR"r" + i);
    if (!r) continue;
    liv += filter_array(all_inventory(r), #'living);
  }
  desc = "Du schaust durch Dein Fernrohr nach oben in die Wolke hinein. " + 
     "Wie ein Roentgenstrahl die Haut durchdringt - was bitte ist ein " + 
     "Roentgenstrahl -, so kannst Du ploetzlich durch die Wolke sehen. " +
     "Und was Du siehst, sieht ziemlich gespenstisch aus. Du erkennst " +
     "den hoelzernen Rumpf eines Schiffes. Voellig lautlos schwebt er durch "+
     "die Luft. An drei Stellen auf dem Schiff kannst Du ein helles Leuchten " +
     "wahrnehmen. Der Bug des Schiffs zeigt momentan in Richtung " +
     capitalize(RD_LIBDIR"mover"->query_dir_string()) + ".";
  if (!sizeof(liv))
    message(({({ M_WRITE, desc }) }));
  else
    message(({({ M_WRITE, desc, " Auf der Reling erkennst Du ",M_AKK,
        liv, "." }) }));
}


status do_action(string verb, mapping args)
{
  string desc;
  switch(verb) {
    case "schau_fernrohr" :
      if (environment(this_player())->QueryProp(P_INDOORS)) {
         message("\
So richtig Sinn, durch ein Fernrohr zu schauen, macht es nur im Freien.");
         return 2;
      }
      if (environment(this_player())->is_seil_raum()) {
         message("\
Also momentan hast Du andere Sorgen als dass Du durch's Fernrohr schauen \
muesstest.");
         return 2;
      }
      message(({ ({ M_PL_BEST, M_PL_VERB, "schau", "durch ", 
          M_PL_POSS, "Fernrohr." }) }));
      if (!is_magisch()) {
        message("\
Es ist nichts besonderes zu sehen. Das Ding muss wirklich kaputt sein.");
        return 2;
      }
      if (present("\nridu#wolke", environment(this_player()))) {
        schau_schiff();    
        return 1;
      }
      desc = environment(this_player())->unt_unten(1);     
      if (!desc) desc = "Du siehst nichts besonderes, leider.";
      message(desc);
      return 1;
  }
}
