#pragma strong_types
#include "../def.h"

inherit RD_THING;

string _query_short()
{
  return 0;
}

string extra_look()
{
  if (!environment()) return 0;
  return capitalize(environment()->QueryPronoun()) + 
    " riecht gewaltig nach Pferd.\n";
}

void create()
{
  ::create();

  SetProp(P_NAME, "Mief");
  AddId("mief");
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  if (!is_clone(this_object())) return;
  call_out("do_mief", 20); 
}


void do_mief(int count)
{
  object p, r;

  if (!environment() || !living(p = environment()) ||
     !(r = environment(environment()))) {
    remove();
    return;
  }

  if (count >= 15) {
    message(({ 
      ({ M_TARGETS, ({ p }), "Puh, endlich hat der Duft so weit nachgelassen, "
         "dass Du selber ihn nicht mehr bemerkst und damit hoffentlich auch "
         "andere nicht." }) }));
    remove();
    return;
  }
  call_out("do_mief", 20, count+1);

  switch(random(5)) {
    case 0:
      message(({ ({ M_TARGETS, ({ p }), "Hoffentlich merkt niemand, dass Du "
                "stinkst wie ein ganzer Pferdestall." }),
             ({ M_EXCLUDE, ({ p }), "Aus Richtung von ", M_DAT, p, 
                "weht ploetzlich ein Dueftchen der ganz besonderen Sorte." }) 
         }));
      break;

    case 1:
      message(({ ({ M_TARGETS, ({ p }), "Also als After-Shave moechtest Du "
                "diesen Duft nun wirklich nicht haben." }),
             ({ M_EXCLUDE, ({ p }), "Du glaubst Dich tritt ein Pferd. "
                "Zumindest vom Duft her passt dies sehr gut zu dem "
                "Lueftchen, das von", M_DAT, p, "zu Dir herueber weht." }) }));
      break;
    case 2:
      message(({ ({ p, M_VERB, "stink", p, "ziemlich uebel nach Pferd." }) }));
      break;

    case 3: 
      message(({ ({ p, M_VERB, "riech", p, "so, als ", M_VERB, 
              ({ "haettest", "haette" }), p, M_PRONOUN, p,
                "heute in Pferdeaepfeln gebadet." }) }));
      break;

    case 4:
      message(({ ({ "Ein Miefwoelkchen bildet sich ueber", M_DAT, p, "." }) }));
      break;
  }
}


void init()
{
  ::init();
  if (environment() == this_player()) {
// TODO_FP: Vom Pferdeapfel getroffen zu werden und zu stinken ist
// TODO_FP: schon auch eine Erfahrung
  }
}
