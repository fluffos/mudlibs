#pragma strong_types
#include "../def.h"

inherit RD_THING;

void create()
{
  ::create();
 
  seteuid(getuid());
  
  SetProp(P_NAME, "Bedienungsanleitung");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "papier", "pergament", "anleitung", "bedienungsanleitung" }));
  SetProp(P_SHORT, "Eine Bedienungsanleitung");
  SetProp(P_LONG, "\
Eine Bedienungsanleitung. Man koennte sie bestimmt lesen. Ob man sie versteht \
ist fraglich. Denn wenn sie wie so viele Bedienungsanleitungen von einem \
japanischen Reisbauern aus dem Chinesischen in Oesterreichische uebersetzt \
wurde, dann koennte es schwierig werden.");
  SetProp(P_NOBUY,1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([ MAT_PAPER: 100 ]));
  SetProp(P_SIZE, 20);
  AddRule("lies <me>", "lies_anleitung");
}

status do_action(string verb, mapping args)
{
  switch(verb) {
    case "lies_anleitung" :
      message(({ ({ M_PL_BEST, "liest die Bedienungsanleitung." }) }));
      this_player()->More(read_file(RD_TEXTDIR"anleitung2.txt"));
      return 1;
  }
}
