#pragma strong_types
#include "../def.h"
#include <food.h>

inherit "std/food";
inherit RD_STDDIR"message";

int alter;

void create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, "Banane");
  AddId(({ "\nridu#gemuese", "banane", "gelbe banane" }));
  SetProp(P_NAME_ADJ, "gelb");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine gelbe Banane");
  SetProp(P_LONG, "Eine gelbe Banane.");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 15);
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_SIZE, 12 + random(5));   // :)
  SetProp(P_FOOD_INFO,
    ([ F_HEAL: 4,
        F_SOAK: 3,
        F_MSG : "Du isst die Banane. Uebrig bleibt nur die Bananenschale.",
        F_MSG_ROOM: "isst eine Banane." ]));
}

varargs void BeimEssen(object pl)
{
  object sch;

  sch = clone_object(RD_OBJDIR"bananenschale");
  sch->move(pl, M_NOCHECK);
}

void reset()
{
  ::reset();

  if (!is_clone(this_object())) return;

  alter++;
  if (!environment() || !living(environment())) {
    remove(); 
    return;
  }

  alter++;
  if (alter > 2) {
     message(({ ({ M_TARGETS, environment(), "Die Banane ist inzwischen "
       "total eklig. Du schmeisst Sie weg." }) }));
     remove();
  }
}
