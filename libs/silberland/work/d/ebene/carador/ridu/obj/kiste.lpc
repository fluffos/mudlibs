#pragma strong_types
#include "../def.h"

inherit "obj/container";
inherit RD_STDDIR"parser";
inherit RD_STDDIR"message";

string password;

string _query_short()
{
  string cmd;

  if (!this_player() || 
      !(cmd = this_player()->_unparsed_args()) ||
      strstr(lower_case(cmd), "kiste") < 0
     ) return 0;
  return "Eine schwere Kiste";
}

string query_password()
{
  return password;
}


void create()
{
  string *silben;

  password = implode(shuffle_array(
    ({ "ba", "ka", "da", "bra", "sa", "sim", "bim", "salim", "rim" })), "");

  container::create();
  SetProp(P_NAME, "Kiste");
  SetProp(P_NAME_ADJ, "schwer");
  AddId(({ "\nridu#kiste", "holzkiste", "kiste", "schwere kiste" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine schwere Kiste");
  SetProp(P_NOGET, 1);
  SetProp(P_LONG, "\
Eine wuerfelfoermige Holzkiste mit einer Kantenlaenge von etwa einem \
halben Meter. In das Holz eingebrannt siehst Du die Buchstaben 'IFM'. \
Irgendetwas an dieser Kiste scheint nicht normal zu sein. Hat sie \
sich nicht eben ein kleines Stueck bewegt? Nein, kann sie eigentlich \
nicht. Denn sie ist mit dicken Schrauben fest mit Wand und Fussboden \
verschraubt.");
  SetProp(P_WEIGHT, 1000000);
  SetProp(P_SIZE, 50);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_MAX_WEIGHT, 5000);
  AddCmd(({ "sing", "singe" }), "do_sing");
  if (!is_clone(this_object())) return;
  clone_object(RD_OBJDIR"reserve")->move(this_object(), M_NOCHECK);
  RD_LOGGER->do_log("kiste", "kiste geladen, stein rein");
}

void my_open()
{
  object reserve;

  if ( !this_player() || 
       environment() != environment(this_player()) ||
       QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN ) {
    RD_LOGGER->do_log("kiste", "war schon offen", this_player());
    return;
  }
  
  message(({
    ({ "Ploetzlich, und wie von Geisterhand, schwingt die Kiste auf." }) 
  }));

  if (reserve = present("\nridu#reserve", this_object())) {
    reserve->move(environment(), M_NOCHECK);
    RD_LOGGER->do_log("kiste", "stein aus kiste rausgemoved", this_player());
    if (!reserve || environment(reserve) != environment()) 
      RD_LOGGER->do_log("kiste", "BUG BEIM MOVE BUG BEIM MOVE", this_player());
    message(({
      ({ "Und hastunichtgesehen schiesst ploetzlich ein gruener Stein "
         "aus der Kiste nach oben an die Decke." }) 
    }));
  } else {
    RD_LOGGER->do_log("kiste", "kein stein in kiste", this_player());
  }
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
}


status do_sing(string arg)
{
  if (arg && strstr(lower_case(arg), password) >= 0) {
    RD_LOGGER->do_log("kiste", "richtig gesungen", this_player());
    if (find_call_out("my_open") < 0) call_out("my_open", 0);
    return 0;
  }
  RD_LOGGER->do_log("kiste", "falsch gesungen", this_player());
  return 0;
}

void reset_vars()
{
  SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
  if (!present("\nridu#reserve", this_object())) {
    clone_object(RD_OBJDIR"reserve")->move(this_object(), M_NOCHECK);
    RD_LOGGER->do_log("kiste", "reset_vars, stein rein");
  }
}


int do_open(string args)
{
  if (!args || !this_player() ||
      QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN) 
        return (::do_open(args) ? 2: 0);

  if (strstr(args, "kiste") < 0) return 0;

  message(({ 
    ({ M_PL, M_PL_VERB, "versuch", ", die Kiste zu oeffnen." }),
    ({ M_WRITE, "Nach kurzer Zeit musst Du feststellen, dass Du "
       "so auf keinen Fall weiterkommst. Es gibt hier irgendeinen "
       "Trick und wenn man den nicht weiss, kommt man nicht weiter." }) }));
  return 1;
}
