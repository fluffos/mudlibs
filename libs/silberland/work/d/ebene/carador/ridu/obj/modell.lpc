#pragma strong_types
#include "../def.h"

inherit RD_THING;
inherit RD_STDDIR"list";

private string my_long()
{
  int i;
  object r, *liv;
  string desc;

  liv = ({});

  for (i=1;i<=6;i++) {
    r = find_object(RD_ROOMDIR"r" + i);
    if (!r) continue;
    liv += filter_array(all_inventory(r), #'living);
  }
  desc = "Och wie suess. Das etwa huehnereigrosse Modell des Schiffs sieht "+
   "total originalgetreu aus.";
  if (sizeof(liv))
    desc += " So originalgetreu, dass Du glaubst, an Bord jemanden zu " +
   "erkennen. Momentan siehst Du die Miniaturversion von " +
   make_list(map_objects(liv, "name", WEN)) + " auf der Reling herumturnen.";
  return desc;
}

void create()
{
  RD_THING::create();
  SetProp(P_NAME, "Schiffsmodell");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  AddId(({ "modell", "schiffsmodell", "kleines modell", "kleines schiffsmodell" }));
  SetProp(P_SHORT, "Ein kleines Schiffsmodell");
  SetProp(P_LONG, #'my_long);
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE,8);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_VALUE, 500);
}

