#pragma strong_types
#include "../def.h"

inherit RD_NPC;

object *told;

private status my_env_check(object pl)
{
   return !!(pl && environment(pl) && environment(pl)->QueryProp(P_RD_RIDU_AREA));
}

private mixed problem_chat()
{
  told -= ({ 0 });
  if (sizeof(filter_array(told, #'my_env_check))) {
    return ({ ({ M_SAYS, M_PRESENT,
                 "Ich wuerd Dir meine Geschichte ja erzaehlen, "
                 "aber ich habe sie gerade vorhin schon jemandem erzaehlt." }),
               6,
               ({ M_SAYS, "Und diesen Jemand habe ich daraufhin mit einer "
                  "hoechst geheimnisvollen Aufgabe betraut." }),
               4,
               ({ M_SAYS, "Und momentan habe ich ein gutes Gefuehl, dass "
                  "dieser Jemand diese Aufgabe loesen wird." }),
               4,
               ({ M_SAYS, "Aber schau doch bitte spaeter nochmal vorbei, denn, "
                  "falls dieser Jemand versagt, dann wuerd ich Dir meine "
                  "Geschichte natuerlich gern erzaehlen." }) });
  }
  if (member_array(this_player(), told) > -1) 
    return ({ ({ M_SAYS, "Wenn Du willst, dass ich Dir die Geschichte "
                 "nochmal erzaehl, dann frag mich nach einer "
                 "Wiederholung." }),
              4,
              ({ M_SAYS, "Ansonsten geh einfach und finde mein Schiff." }) });
  

  if (this_player()->QueryProp(P_CLONE_TIME) < 1018994400) {
    return ({ ({ M_WRITE, "\
Technischer Hinweis:\n\
Leider ist Dein Spielerobjekt nicht aktuell genug. Du kannst diese Quest\n\
aus technischen Gruenden erst spielen, wenn Du ein aktuelles Spielerobjekt\n\
hast. Dies bekommst Du, indem Du 'ende' tippst und Dich danach neu im\n\
Silberland einloggst." }), 
      2,
      ({ M_SAYS, "Tut mir echt leid." }) });
  }


  told += ({ this_player() });
  return 
       ({ ({ M_PRESENT, M_SAYS, 
             "Ach, wenn Dir passiert waer, was mir passiert ist, "
             "dann wuerdest Du auch so dasitzen. Lass mich erzaehlen..." }),
          8,
          ({ M_SAYS, "Genau hier ging ich neulich mit meinem kleinen "
             "Schiff nach einer langen, rauhen Seefahrt, vor Anker." }),
          8,
          ({ M_SAYS, "Du musst wissen, ich bin ein grosser Seefahrer und "
             "Abenteurer und habe schon fast jeden Winkel dieser Welt "
             "gesehen." }),
          8,
          ({ M_SAYS, "Ich lege immer hier an, weil ich dann "
             "keine Anlegegebuehren zahlen muss, aber das tut nichts zur "
             "Sache." }),
          8,
          ({ M_SAYS, "Nun, ich war mal wieder wochenlang auf See und "
             "zuletzt ging mir doch "
             "glatt das Silenus Tafelwasser aus. Und das, wo ich doch nur "
             "Silenus vertrage und sonst nix." }),
          8,
          ({ "Du denkst   . o O (Ein bisserl seltsam ist der aber schon)"}),
          4,
          ({ M_SAYS, "Ich also, hier angelegt und nix wie rein in die "
             "Wartehalle am Pier, an die Bar und ein paar Waesserchen "
             "gezwitschert." }),
          10,
          ({ M_SAYS, "Und als ich wieder hierher zurueckkam, Du wirst nicht "
             "glauben, was ich dann mit ansehen musste!" }),
          6,
          ({ M_SAYS, "Mein Schiff flog davon. Einfach so. Mir vor der Nase. "
             "Ich sah nur noch den Drachen, der das Heck verziert." }),
          6,
          ({ "Du denkst   . o O (Seltsam? verrueckt wuerde ich den nennen)"}),
          6,
          ({ M_SAYS, "Und ich hatte ehrlich nur Wasser getrunken. Aber das "
             "Schiff flog, was es zuvor nie getan hatte. Und es flog "
             "Richtung Midas." }),
          10,
          ({ M_SAYS, "Tja, und da sitz ich nun ohne Schiff. Und selber "
             "suchen kann ich es auch nicht, weil ich mich immer so "
             "leicht verlaufe." }),
          8,
          ({ M_SAYS, "Vielleicht kannst Du ja so nett sein und schauen, ob "
             "Du es irgendwo findest und mir dann wiederbringen?" }),
          6,
          ({ "Du denkst   . o O (komplett verrueckt! Ein fliegendes Schiff, "
             "sowas gibt's doch gar nicht)" }) });
}

private mixed wiederholung_chat()
{
  told -= ({ this_player() });
  return problem_chat();
}

void reset()
{
  ::reset();
  told = ({});
}


void create()
{
  if(is_clone(this_object())) {
    call_out("remove", 0);
    return;
  }

  npc::create();

  AddId(({ "NOCONTROL", "NOWIMPY", "\nridu#theo", "theo", "seefahrer" }));
  SetProp(P_NAME, "Theo");
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN,300);
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOATTACK, "\
sitzt doch direkt am Abgrund. Er wuerde bestimmt ins Meer fallen, wenn\n\
Du ihn angreifen wuerdest. Deshalb laesst Du es lieber bleiben.");
  SetProp(P_SHORT, "Theo der Seefahrer");
  SetProp(P_LONG, "\
Theo ist ein alter Mann mit struppeligem Bart, wettergegerbtem Gesicht, \
eben ein typischer Seefahrer. Untypisch ist allerdings, dass er total \
geknickt und traurig am Klippenrand sitzt und die Beine in die Tiefe \
baumeln laesst. Offensichtlich hat er ein Problem. Aber das sind wir ja \
gewoehnt, nicht? Denn genau dafuer bist Du hergekommen, hoffe ich.");
  AddDetail(
    ({ "struppeligen bart", "bart" }), "\
Bei solchen Baerten fragst Du Dich immer, ob das praktisch ist und ob man da \
im Kampf oder bei Abenteuern nicht staendig irgendwo haengen bleibt. Und das \
stellst Du Dir schmerzhaft vor.");
  AddDetail(
    "gesicht", "\
Tiefe Furchen in Theos Gesicht verraten Dir, dass er wohl die meiste Zeit \
seines Lebens im Freien verbracht hat. Oder viel aelter ist als er wirkt. Oder \
einfach nur die falsche Faltencreme verwendet.");
  AddDetail(
     ({ "bein", "beine" }), "\
An Theos Beinen ist nun wirklich nichts Interessantes und wir naehern uns \
zielstrebig der Kategorie 'Sinnlose Details'.");
  AddInfos(({
    ({ "magen", 
       ({ ({ M_SAYS, "Sei froh, wenn Du keine Magenprobleme hast. Das ist "
             "echt unangenehm, sag ich Dir. Vor allem in einer rauhen "
             "Welt wie dieser." }) }) }),
    ({ "natrium",
       ({ ({ M_SAYS, "Ja, auf's Natrium muss man wirklich achten beim "
          "Wasser. Darum trinke ich nur Silenus, denn das ist extrem "
          "natriumarm und damit sogar geeignet zur Herstellung von "
          "Saeuglingsnahrung." }) }) }),
    ({ ({ "hafen", "haefen", "kneipen", "kneipe", "schiffe" }),
       ({ ({ M_SAYS, "Oh ja, oh ja, wenn ich nicht so verzweifelt "
            "waere, dann koennte ich Dir stundenlang davon erzaehlen." }) }) }),
    ({ ({ "seefahrer", "abenteurer", "winkel", "welt" }),
       ({ ({ M_SAYS, "Oh ja, wenn Du wuesstest, wo ich ueberall "
             "schon war." }) }) }),
    ({ ({ "gebuehr", "gebuehren", "anlegegebuehr", "anlegegebuehren" }),
       ({ ({ M_SAYS, "Naja, hoch sind sie nicht, aber ich bin immer ein "
             "bisschen knapp bei Kasse." }) }) }),
    ({ ({ "see", "meer" }), 
       ({ ({ M_SAYS, "Unendliche Weiten..." }) }) }),
    ({ ({ "wasser", "tafelwasser", "silenus", "waesserchen" }),
       ({ ({ M_SAYS, "Ja, Silenus schmeckt mir einfach am besten, es hat "
           "weniger Natrium als die meisten Waesser und das bekommt meinem "
           "Magen eher." }) }) }),
    ({ ({ "bar", "wartehalle", "halle" }),
       ({ ({ M_SAYS, "Ja, in der Wartehalle kann mans gut aushalten und ein, "
             "oder zwei Waesserchen schluerfen." }) }) }),
    ({ ({ "heck", "drache", "drachen", "bug" }),
       ({ ({ M_SAYS, "Du musst wissen, mein Schiff ist ein schoenes Schiff, "
             "es ist an Heck und Bug mit einem Drachen verziert." }) }) }),
    ({ "midas",
       ({ ({ M_SAYS, "Midas ist glaub ich nordoestlich von hier, aber genau "
             "weiss ich es auch nicht." }) }) }),
    ({ ({ "problem", "hilfe", "helfen", "quest", "abenteuer",
          "sorgen", "laune", "grund", "ursache", "schiff"
       }), #'problem_chat }),
   ({ "wiederholung", #'wiederholung_chat }) }));
  create_default_npc(15);
  told = ({});
}
