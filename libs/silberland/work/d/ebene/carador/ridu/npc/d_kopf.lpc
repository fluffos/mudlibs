#pragma strong_types
#include "../def.h"

inherit RD_NPC;

void init()
{
  ::init();
  add_actions();
}

private void mydes()
{
  object ob;

  if (ob = find_object(RD_NPCDIR"d_schwanz")) ob->remove();
  remove();
}

private void aaargl()
{
  RD_LIBDIR"mover"->tell_schiff("\
Lautes Geschrei toent ueber das ganze Schiff: WO SIND MEINE FUESSE? WO IST \
MEIN SCHWANZ? WO IST MEIN GESAMTER VERDAMMTER KOERPER? HILFE, HILFE!!!");
}

void start_laber()
{
  object r;
  r = environment();
  message(({ 
    6,
    ({M_ROOM,r, "Der Drachenkopf schuettelt sich, schaut sich um und sagt: "
        "Hmm, was ist nun los?" }),
    6,
    ({M_ROOM,r, "Der Drachenkopf sagt: Ahh, hab ich lange geschlafen. "
       "Meine Fuesse sind noch ganz taub. Erstmal ein Stueckchen laufen." }),
    6,
    ({M_ROOM,r, "Der Drachenkopf sagt: Sapperlott! Was ist denn jetzt los?" }),
    6,
    ({M_ROOM,r, "Der Drachenkopf schaut an sich nach unten." }),
    6,
    ({ #'aaargl }),
    6,
    ({M_ROOM,r, "Der Drachenkopf faengt bitterlich an zu schluchzen und "
      "zu weinen: Buuuuuh. Es helfe mir doch jemand. Ich will zum "
      "Rest von mir." })
  }));
}

void create()
{
  if(is_clone(this_object())) {
    call_out("remove", 0);
    return;
  }

  npc::create();

  AddId(({ "NOCONTROL", "NOWIMPY", "\nridu#d_kopf", 
           "kopf", "drache", "drachen", "drachenkopf" }));
  SetProp(P_NAME, "Drachenkopf");
  SetProp(P_ARTICLE, 1);
  SetProp(P_ALIGN,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Drachenkopf");
  SetProp(P_LONG, "\
Sieht ziemlich gespenstisch aus, dieser Drachenkopf. Nicht, dass Du nicht \
sauber abgetrennte Drachenkoepfe gesehen haettest, aber normalerweise reden \
die dann nicht mehr. Dieser hier redet nicht nur, er jammert sogar und macht \
einen sehr ungluecklichen Eindruck. Du koenntest ihn ja mal fragen, ob er \
Deine Hilfe braucht.");
  SetProp(P_WEIGHT, 7000);
  create_default_npc(5);
  SetChats(7, ({
    "\
Der Drachenkopf wimmert: Oh nein, ich bin eine Missgeburt.\n",
    "\
Der Drachenkopf schlucht: Oh weh, oh weh, wo ist denn nur mein Koerper?\n",
    "\
Der Drachenkopf weint: Nimmt mich doch bitte jemand und bringt mich zum\n\
Rest von mir.\n",
    "\
Der Drachenkopf schluchzt leise vor sich hin.\n",
    "\
Der Drachenkopf weint: Ich werde nie wieder fliegen koennen.\n",
    "\
Der Drachenkopf seufzt: Ach wenn ich mich doch nur hinterm Ohr\n\
kratzen koennte.\n"
  }));
  AddInfos(({
    ({ ({ "hilfe", "helfen", "problem", "sorgen", "unglueck",
          "koerper", "hinterteil", "hintern", "schwanz", "drachenkoerper" }),
       ({ ({ M_SAYS, "Buhuhuh, ich habe keinen Koerper. Das ist mein "
             "ganzes Unglueck." }),
          4,
          ({ M_SAYS, "Wenn Du mir helfen willst, dann waere ich Dir sehr "
             "dankbar. Aber mir kann eh keiner helfen." }),
          6,
          ({ M_SAYS, "Oder hast Du zufaellig einen Drachenkoerper einstecken, "
             "den Du mir schenken koenntest?" }),
          6,
          ({ M_SAYS, "Aber Du koenntest mich wenigstens mitnehmen und falls "
             "wir jemals an einem Drachenkoerper vorbeikommen, dann koennte "
             "ich ihn vielleicht haben, ja?" }),
          4,
          ({ M_ME_BEST, "schaut", M_PL_AKK, "hoffnungsvoll an." }) }) })
  }));
  AddRule("setz <me> auf <object>", "setz_kopf");
  AddRule("setze <me> auf <object>", "setz_kopf");
  AddRule("leg <me> auf <object>", "setz_kopf");
  AddRule("lege <me> auf <object>", "setz_kopf");
  AddRule("stell <me> auf <object>", "setz_kopf");
  AddRule("stelle <me> auf <object>", "setz_kopf");
}


status do_action(string verb, mapping args)
{
  object denk;
  string my_name;

  switch(verb) {   
    case "setz_kopf" :
      if (!args[G_OBJECT]->id("\nridu#d_schwanz")) {
         message(({ ({ "Als ", M_PL_BEST, M_PL_VERB, "versuch", ", den "
           "Drachenkopf abzusetzen, schreit dieser lauthals: "
           "Nein, nein, da gehe ich nicht rauf, niemals!" }) }));
         return 2;
      }
      if (query_message_busy()) return 2;
      RD_LOGGER->do_log("drachen", "Szenario geloest", this_player());
      if (denk = present("\nridu#denk", this_player())) {
        denk->reset_hp_sp();
      } else {
        denk = clone_object(RD_OBJDIR"denk");
        denk->move(this_player(), M_NOCHECK);
      }
      my_name = denk->query_my_name();
      message(({
        ({ M_PL_BEST, "setzt den Drachenkopf auf den "
           "Drachenkoerper." }),
        2,
        ({ "Wie durch ein Wunder verschmelzen die beiden Koerperteile so, "
           "dass nicht einmal mehr eine Nahtstelle zu sehen ist." }),
        2,
        ({ "Der Drache sagt: Vielen Dank, dass Du mir geholfen hast, "
           "das war total freundlich von Dir." }),
        2,
        ({ "Der Drache schlaegt mit den Fluegeln und trappelt mit den "
           "Fuessen." }),
        2,
        ({ "Der Drache sagt: Du musst aber schon verstehen, jetzt muss ich "
           "einfach gehen, ein bisschen herumfliegen, ueber gruenen Wiesen "
           "nach Kaninchen jagen, jaaaaaaaaaaaa..." }),
        4,
        ({ "Der Drache hebt ab, dreht noch eine letzte Runde ueber dem "
           "Schiff und ruft Dir zu: Weil Du mir geholfen hast, will ich Dir "
           "auch helfen." }),
        4,
        ({ "Der Drache ruft Dir zu: Wenn's Dir mal so richtig schlecht geht "
           "und Du kurz vor'm Sterben bist, denk einfach an mich. Dann will "
           "ich Dir helfen." }),
        4,
        ({ "Danach verschwindet er in den Wolken. Du hoerst ihn nur noch "
           "rufen: Ach ja, mein Name ist " + capitalize(my_name) + ""
           ". Denk einfach an " + capitalize(my_name) + "." }),
        ({ #'mydes })
      }));
      return 1;
  }
}


varargs int move(mixed dest, int methods, string direction, string textout,
                 string textin)
{
  if (!InFight() && (methods == M_GET || methods == M_PUT)) {
    move_object(dest);
    return 1;
  }
  return ::move(dest,methods,direction,textout,textin);
}
