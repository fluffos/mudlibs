#pragma strong_types
#include "../def.h"

inherit RD_NPC;

void geschafft()
{
  message(({ ({ M_ROOM, environment(), "GESCHAFFT" }) }));
}



void create()
{
  if(is_clone(this_object())) {
    call_out("remove", 0);
    return;
  }

  npc::create();

  AddId(({ "\nridu#d_schwanz","koerper", "drachenkoerper",
       "schwanz", "drachenschwanz", "drache", "drachen", "hinterteil",
       "hintern", "drachenhintern", "NOCONTROL", "NOWIMPY"}));
  SetProp(P_NAME, "Drachenkoerper");
  SetProp(P_ARTICLE, 1);
  SetProp(P_ALIGN,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Drachenkoerper");
  SetProp(P_LONG, "\
Huiui, ein Drachenkoerper ohne Kopf sieht ja noch seltsamer aus als ein \
Kopf ohne Koerper. Es schauedert Dich, wie Du den Koerper so dastehen \
siehst und hilflos mit den Fluegeln schlagen. Wie er mit seinen grossen \
Fuessen orientierungslos im Kreis herumlaeuft.");
  create_default_npc(15);
}

void init()
{
  ::init();

  if ( (this_player()->id("\nridu#d_kopf") ||
        present("\nridu#d_kopf", this_player())) &&
        !query_message_busy() ) 
    message(({ 
     2,
     ({ "Der Drachenkopf schreit: JUHUHHHH! JUHUUHHHH! Ein "
        "Drachenkoerper. MEIN Drachenkoerper. Los schnell, setze mich auf "
        "den Koerper." }),
     4,
     ({ "Der Drachenkopf schreit: Na mach schon, setze mich endlich auf "
        "den Drachenkoerper." }) 
    }));
}
