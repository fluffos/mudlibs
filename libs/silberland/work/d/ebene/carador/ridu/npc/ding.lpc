#pragma strong_types
#include "../def.h"

inherit RD_NPC;

object herrchen;

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  create_default_npc(6);
}

private status ding_check(object ob)
{
  return !ob->QueryProp(P_NODROP) &&
         !ob->QueryProp(P_NEVERDROP) &&
         ob->QueryProp(P_WEIGHT) >= 1000 &&
         ob->short() &&
         !ob->id("\ngeld") &&
         !first_inventory(ob);
}


void ding_weg()
{
  message(({ ({ "Ploetzlich weicht alles Leben aus ", M_ME_DAT_BEST, "." }) }));
  remove();
}

varargs void make_ding(object pl)
{
  object *ddd, ob;
  if (!pl) pl = this_player();

  ddd = filter_array(all_inventory(pl), #'ding_check);
  if (!sizeof(ddd)) {
    remove();
    return;
  }
  ob = ddd[random(sizeof(ddd))];
  SetProp(P_NAME, ob->QueryProp(P_NAME));
  SetProp(P_SHORT, ob->QueryProp(P_SHORT));
  SetProp(P_GENDER, ob->QueryProp(P_GENDER));
  SetProp(P_ARTICLE, ob->QueryProp(P_ARTICLE));
  SetProp(P_LONG, "\
Herrje, was ist das denn, Du hast zwar schon oefter " + name(WEN) + " \
gesehen, aber verfolgt und angegriffen bist Du davon noch nie worden.");
  AddId(ob->QueryProp(P_IDS));
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOCORPSE, 1);
  ob->move(environment(this_player()), M_PUT);
  ob->move(this_object(), M_NOCHECK|M_SILENT);
  call_out("ding_weg", 60);
  herrchen = pl;
}

void try_to_follow()
{
  int ind;
  mapping ex;
  string herrdest;
  string *cmd, *dest;
  herrdest = file_name(environment(herrchen));
  ex = environment()->QueryProp(P_EXITS);
  cmd = m_indices(ex);
  dest = m_values(ex);
  ind = member_array(herrdest, dest);
  if (ind > -1) command_me(cmd[ind]);
}

void heart_beat()
{
  ::heart_beat();
  if (!is_clone(this_object()) || !environment()) return;

  if (!herrchen) {
    message(({ ({ "Ploetzlich weicht alles Leben aus ", M_ME_DAT_BEST, "." }) }));
    remove();
    return;
  }

  if (environment() != environment(herrchen) &&
      environment(herrchen)) {
    try_to_follow();
    return;
  }
}
