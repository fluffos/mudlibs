#pragma strong_types
#include "../def.h"

inherit RD_NPC;

int aepfel;
object faenger;

void clear_faenger()
{
  if (faenger && environment(faenger) == environment())
    message(({
       ({ M_TARGETS, ({ faenger }), "Das Korb-unter-Pferdehintern-Halten "
          "wird Dir zu doof. Du senkst den Korb wieder." }),
       ({ M_EXCLUDE, ({ faenger }), faenger, "senkt den Korb wieder." })
    }));
  faenger = 0;
}

private mixed do_kack()
{
  object korb, ob;

  if (!faenger || !present(faenger) ||
      !(korb = present("weidenkorb", faenger))) faenger = 0;
  
  if (!faenger)
    return "Mit einem lauten Plopp plumpst ein Pferdeapfel aus dem "
      "Hinterteil und segelt hinab ins Gras und zerbroeselt dort. "
      "Haette jemand einen Korb unter das Pferd gehalten, so waere das "
      "nicht passiert.";

  ob = clone_object(RD_OBJDIR"papfel");
  if (ob->move(korb, M_PUT) < 1) {
    ob->remove();
    return "Mit einem lauten Plopp plumpst ein Pferdeapfel aus dem "
      "Hinterteil und segelt hinab ins Gras, faellt auf den Korb und "
      "kullert dann, weil der Korb voll ist, ins Gras und zerbroeselt "
      "dort.";
  }
  message(({ ({ "Mit einem lauten Plopp plumpst ploetzlich "
    "ein Pferdeapfel aus dem Hinterteil des Pferds und segelt sanft "
    "in den Weidenkorb, den ", faenger, "geschickt unter das "
    "Pferd", M_VERB, ({ "haeltst", "haelt" }), faenger, "." }) }));
}

mixed friss_apfel(object ob)
{
  if (query_message_busy()) {
    ob->move(environment(), M_NOCHECK);
    message(({ ({ "Das Pferd spuckt den Apfel auf den Boden." }) }));
    return;
  }

  message(({ ({ "Schnurps, schnurps, schnurps, das Pferd frisst den "
   "Apfel sofort auf." }) }));

  aepfel++;
  ob->remove();
  
  switch(aepfel) {
    case 1: 
      message(({ 2, ({ "Wenig spaeter rumort es im Magen des Pferds." }) }));
      return 1;
    case 2: 
      message(({ 2, ({ "Wenig spaeter rumort es im Darm des Pferds." }) }));
      return 1;
    default:
      aepfel=0;
      message(({ 
        2,
        ({ "Ploetzlich hebt das Pferd den Schwanz." }),
        4,
        ({ "Das Pferd bekommt ploetzlich einen ganz versonnenen "
           "Gesichtsausdruck." }),
        4,
        ({ "Das Pferd gibt seltsame Geraeusche (Mhhhhhhhhhhhhhhh) "
           "von sich." }),
        4,
        ({ #'do_kack })
       }));
       return 1;
  }
}

void create()
{
  ::create();

  SetProp(P_NAME, "Pferd");
  AddId(({ "NOCONTROL", "NOWIMPY", "\nridu#pferd", "pferd" }));
  SetProp(P_ARTICLE,1);
  SetProp(P_GENDER, NEUTER);
  create_default_npc(12);
  SetProp(P_SIZE,120);
  SetProp(P_RACE, "Pferd");
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_NOATTACK, "laeuft davon, als es merkt, dass Du ihm etwas Boeses "
    "willst.");
  SetProp(P_SHORT, "Ein Pferd");
  SetProp(P_HANDS, ({ " mit seinen Hufen", 120 }));
  SetProp(P_LONG, "\
Nun, ein Pferd, ob es jetzt eine Stute oder ein Haflinger, ein Schimmel oder \
ein Hengst ist? Offen gestanden kennst Du Dich mit Pferden nicht so gut \
aus. Nur eins weisst Du sicher: Wie der Ablauf von Nahrung im Magen eines \
Pferdes ist: 1. Fressen, 2. Verdauen, 3. Aepfeln. Du weisst nicht, was \
Aepfeln ist? Naja, Aepfeln ist ein vornehmer Ausdruck bei Pferden fuer ... \
A propos Aepfel. Pferde fressen doch auch gern Aepfel, oder? Als Du so \
ueber Pferde und Pferdeaepfel nachdenkst, faellt Dir das alte Raetsel ein: \
anderthalb Pferde erzeugen in anderthalb Stunden anderthalb Pferdeaepfel. \
Wie viele Pferdeaepfel erzeugt ein Pferd in einer Stunde? [loesung <ergebnis>]");
  AddDetail("fressen", "Naja, man fuettert dem Pferd etwas und das frisst es dann.");
  AddDetail("verdauen","Nach einem, zwei oder drei Aepfeln kommt die \
Verdauung dann gewaltig in Schwung.");
  AddDetail("aepfeln", "Und wenn genug verdaut ist, kommt hinten ein \
Pferdeapfel raus. So einfach isses.");
  AddAcceptItem("apfel", #'friss_apfel);
  SetChats(1, ({
    "\
Das Pferd wiehert.\n",
    "\
Das Pferd trabt auf der Koppel auf und ab.\n"
  }));
  AddRule("fuetter <me> mit <object>", "fuetter");
  AddRule("fuettere <me> mit <object>", "fuetter");
  AddRule("fuetter <me>", "fuetter");
  AddRule("fuettere <me>", "fuetter");
  AddRule("halte <object> unter <me>", "halte");
  AddRule("halt <object> unter <me>", "halte");
  AddErrorMessage("halte", "\
Nunja, es hoert sich vielleicht komisch an, aber mit 'halte korb unter pferd'\n\
kaemst Du vielleicht weiter.\n");
  AddErrorMessage("fuetter", "Du koenntest das Pferd mit etwas fuettern.\n");
  AddErrorMessage("fuettere", "Du koenntest das Pferd mit etwas fuettern.\n");
  AddCmd("loesung", "loesung");
}

status loesung(string str)
{
  str = this_player()->_unparsed_args();
  if (!str) return 0;
   
  if (strstr(str, ".6") == 0 ||
      strstr(str, ",6") == 0 ||
      strstr(str, "0.6") > -1 ||
      strstr(str, "0,6") > -1 ||
      strstr(str, "zwei drittel") > -1 ||
      strstr(str, "zweidrittel") > -1 ||
      strstr(str, "2/3") > -1) {
    message("Richtig. Glueckwunsch. Es sind 2/3 Pferdeaepfel.");
    return 1;
  }
  message("Antwort '" + str + "' ist leider falsch.");
  return 2;
}

status do_action(string verb, mapping args)
{
  switch(verb) {
    case "halte" :
      if (!args[G_OBJECT]->id("weidenkorb")) {
        message("\
Zum Auffangen von Pferdeaepfeln sind ausschliesslich Weidenkoerbe geeignet, \
da nur sie weich und gross genug sind.");
        return 1;
      }
      if (faenger && faenger != this_player() &&
          environment(faenger) == environment()) {
        message("Aber da steht schon " + faenger->Name() + ".");
        return 1;
      }
      faenger = this_player();
      message(({ ({ M_PL, M_PL_VERB, ({ "haeltst", "haelt" }),
        M_PL_AKK_POSS, args[G_OBJECT], "genau unter den Hintern des "
        "Pferdes. Wenn jetzt ein Pferdeapfel herauskaeme, so wuerde er "
        "sanft in den Korb plumpsen." }) }));
      remove_call_out("clear_faenger");
      call_out("clear_faenger", 12);
      return 1;
      break;
    case "fuetter" :
      if (!args[G_OBJECT]) {
        message("Du musst schon sagen, mit was Du das Pferd fuettern "
                "moechtest.");
        return 1;
      }
      if (environment(args[G_OBJECT]) != this_player()) {
        notify_fail("Das hast Du nicht.\n");
        return 0;
      }
      if (!args[G_OBJECT]->id("apfel")) {
        message(({ ({ M_PL, M_PL_VERB, "versuch", ", das Pferd mit ",
          M_DAT, args[G_OBJECT], " zu fuettern." }),
         ({ "Das Pferd wiehert laut und schuettelt energisch den Kopf." }) }));
        return 1;
      }
      message(({ ({ M_PL, M_PL_VERB, "fuetter", "das Pferd mit einem "
                    "Apfel." }) }));
      friss_apfel(args[G_OBJECT]);
      return 1;
  }
}

void init()
{
  ::init();
  add_actions();
}
