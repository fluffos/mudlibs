#pragma strong_types
#include "../def.h"
#include <food.h>
#include <verben.h>

inherit RD_ROOM;

int versuche, aepfel;

void make_pferd()
{
  object p;

  aepfel = 12;

  RD_TOOLS->load_object(RD_LIBDIR"loader");
  if (!present("\nridu#pferd", this_object())) {
    p = clone_object(RD_NPCDIR"pferd");
    p->move(this_object(), M_NOCHECK);
  }
}

private mixed durchsuche_wiese()
{
  return ({
    ({ M_PL_BEST, M_PL_VERB, "krabbel", "auf den Knien durch die Wiese." }),
    ({ M_WRITE, "Hmmm, leider kein Pferdeapfel zu finden." }) });
}

private string tuer_long()
{
  if (RD_ROOMDIR"schuppen"->query_offen())
    return "\
Die Tuer steht einladend offen und Du koenntest den Schuppen betreten.";
  
  return "\
Typisch. Sie ist zu. Allerdings siehst Du kein Schloss, Bolzen, Balken \
oder aehnlich gemeines Zeug, was Dich dran hindern koennte, die Tuer \
jetzt und auf der Stelle zu oeffnen.";
}

private mixed my_oeffne()
{
  mixed res;
  if (RD_ROOMDIR"schuppen"->query_offen())
    return "Aber die Tuer ist doch schon offen.";

  versuche++;
  switch(versuche) {
    case 1:
      return ({ ({ M_SAY, M_PL, "versucht, die Tuer zu oeffnen." }),
           ({ M_WRITE, "Du versuchst die Tuer zu oeffnen, doch sie "
              "ruehrt sich keinen Zentimeter. Scheint zu klemmen. "
              "Vielleicht mal dran ruetteln?" }) });
    case 2:
      return ({ ({ M_SAY, M_PL, "versucht, die Tuer zu oeffnen." }),
           ({ M_WRITE, "Du versuchst weiter, die Tuer zu oeffnen, doch sie "
              "ruehrt sich noch immer keinen Zentimeter. Scheint zu klemmen. "
              "Vielleicht mal dran zerren?" }) });
    default :
      return ({ ({ M_SAY, M_PL, "versucht, die Tuer zu oeffnen." }),
           ({ M_WRITE, "Du versuchst weiter, die Tuer zu oeffnen, doch sie "
              "ruehrt sich noch immer keinen Zentimeter. "
              "Scheint ziemlich fest zu klemmen." }),
           ({ M_WRITE, "Langsam wirst Du zorning und denkst: Was der "
              "Tuer fehlt, ist ein kraeftiger Tritt!" }) });
  }
}

private mixed my_trete_tuer()
{
  if (RD_ROOMDIR"schuppen"->query_offen())
    return ({ ({ M_PL, M_PL_VERB, ({ "trittst", "tritt" }),
                 "gegen die offene Tuer." }) });
  
  RD_ROOMDIR"schuppen"->toggle_offen();
  return ({
    ({ M_SAY, M_PL, "tritt gegen die Tuer." }),
    ({ M_WRITE, "So, nimm das! Mit voller Wucht strammst Du gegen "
       "die Tuer." }),
    ({ "Ploetzlich schwingt die Tuer auf." }),
    ({ M_ROOM, RD_TOOLS->load_object(RD_ROOMDIR"schuppen"),
       "Ploetzlich schwingt die Tuer auf." }) });
}

private mixed betrete_schuppen()
{
  if (!RD_ROOMDIR"schuppen"->query_offen())
    return "Aber die Tuer ist doch zu.";

  this_player()->move(RD_ROOMDIR"schuppen",
                      M_GO,
                      "den Schuppen",
                      "betritt");
  return 1;
}

private mixed schliess_tuer()
{
  if (!RD_ROOMDIR"schuppen"->query_offen())
    return "Aber die Tuer ist doch schon zu.";
 
  RD_ROOMDIR"schuppen"->toggle_offen();
  return ({
    ({ M_PL, "schliesst die Tuer." }),
    ({ M_ROOM, RD_TOOLS->load_object(RD_ROOMDIR"schuppen"),
       "Ploetzlich schwingt die Tuer zu." }) 
  });
}

private string baum_long()
{
  if (!aepfel)
    return "\
Nichts weiter als ein Apfelbaum, von dem jemand alle Aepfel gepflueckt hat.";

  if (aepfel == 1)
    return "\
Hey, Du hast Glueck, es haengt noch genau ein Apfel am Baum.";

  return "\
Das Interessanteste an diesem Apfelbaum ist die Tatsache, dass " +
    RD_LIBDIR"grammar"->get_numeral(aepfel) + " knackige, rote Aepfel \
dranhaengen, die nur darauf warten, gepflueckt zu werden.";
}

private string apfel_long()
{
  if (!aepfel) return "Pech gehabt, alle geerntet.";
  if (aepfel == 1) return "Es haengt noch genau ein Apfel am Baum.";
  return "Am Baum haengen noch " +
    RD_LIBDIR"grammar"->get_numeral(aepfel) + " Aepfel.";
}

private mixed pflueck_apfel()
{
  object ob, pf;

  if (!aepfel)
    return "Es ist kein Apfel mehr am Baum.";

  if (aepfel < 11 && !(pf = present("apfelpfluecker", this_player())))
    return ({ ({ M_PL, M_PL_VERB, "versuch", ", einen Apfel zu pfluecken, ",
      "aber egal wie sehr ", M_PL_PRONOUN, M_PL_AKK_SICH, M_PL_VERB,
      "anstreng", ", es gelingt nicht, weil die Aepfel zu weit oben sind." }),
      ({ M_WRITE, "Hmmm, einen Apfelpfluecker muesste man haben." }) });
 
  aepfel--;
  ob = clone_object(RD_OBJDIR"apfel");
  if (ob->move(this_player(), M_GET)<1) ob->move(this_object(), M_NOCHECK);
  if (pf)
    return ({ ({ "Mit ", M_PL_DAT_POSS, pf, M_PL_VERB, "pflueck",
                 M_PL, "einen Apfel aus der Krone des Baums." }) });
  return ({ ({ M_PL, M_PL_VERB, "pflueck", "einen Apfel von den niedrigeren "
               "Aesten." }) });
}

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Auf einer Pferdekoppel");
  SetProp(P_INT_LONG,  "\
Nun bist Du auf einer Pferdekoppel angelangt, an dessen Eingang ein \
Apfelbaum steht. Westlich von hier verlaeuft die Strasse, die zum und \
natuerlich auch weg vom Bauernhof fuehrt. Am Ende der Koppel steht ein \
kleiner Schuppen.");
  AddSmell("graspferdeblumen", "Das wuerde bestimmt ein Flop sein, denn \
Du wuerdest es garantiert nicht kaufen.");
  AddSmell(DEFAULT_SMELL,
    "Der auf dieser Koppel vorherrschende Geruch koennte von Parfumdesignern "
    "als 'Graspferdeblumen' beschrieben werden. Dass diese Designer danach ihren "
    "Job verlieren wuerden, ist uns auch klar, weil Pferde keine Blume haben, "
    "sondern nur Rehe und Graspferde schon gleich gar nicht. "
    "Egal, hier riecht es auf jeden Fall nach einer "
    "mehr oder weniger gelungenen Mischung aus Blumen, Pferden und deren "
    "Verdauungsprodukten und Gras.");
  AddSmell(({ "blumen", "blume" }), 
    "Hmm, toll, super Duft! Zwar voellig unwichtig, riech aber dennoch gut.");
  AddSmell(({ "gras", "wiese" }), 
    "Der Duft der Wiese und des Grases laesst in Dir das voellig falsche "
    "Gefuehl aufkommen, Du haettest die Zeit, hier an Gras oder Wiese "
    "herumzuriechen.");
  AddSmell(({"pferden", "pferd", "pferdeapfel", "verdauungsprodukte", 
      "verdauungsprodukt", "pferdeaepfel" }),
    "Du glaubst schon, dass es hier nach Pferdeaepfeln riecht. Aber die "
    "sind auf jeden Fall schon aelter und irgendwo im tiefen Gras auf "
    "nimmerwiedersehen verschwunden. Und das ist auch gut so.");
  AddDetails(({
    "himmel", "Der Himmel sieht eigentlich aus wie immer.",
    "eingang", "Ein Apfelbaum steht eingangs der Koppel.",
    ({ "baum", "apfelbaum" }), #'baum_long,
    "ende", "Ein Schuppen steht am Ende der Koppel.",
    ({ "pferdeaepfel", "pferdeapfel", "reihenfolge" }), "\
Egal wie gruendlich Du schaust, es ist kein Pferdeapfel zu sehen. Hmmm, \
wie war nochmal die Reihenfolge? 1. Fressen, 2. Verdauen, \
3. Aepfeln?",
    "pferde", "Nana, wollen wir mal nicht gleich uebers Ziel \
hinausschiessen. Ein Pferd sollte doch erstmal genug sein. \
Vielleicht ist sogar eins da.",
    ({ "aepfel", "apfel" }), #'apfel_long,
    ({ "koppel", "pferdekoppel", "wiese", "gras", "boden" }), "\
Was gehoert alles zu einer Pferdekoppel? Eine schoene Wiese: Haben wir! \
Pferde? Na wenn's keiner umgelegt hat, ist eins da. Und Pferdeaepfel? \
Na mal schaun, vielleicht schaffen wir das ja irgendwie.",
    "tatsache", "So isses halt mal. Koennt doch schlechter sein, oder?",
    "interessanteste", "\
Wie schon gesagt, die Aepfel sind das Interessanteste am Baum. Alles \
andere ist eher unwesentlich und wenn ich jetzt darauf eingehen \
wuerde, so wuerde ich mir nur wieder tausende von Detail-Reports \
einhandeln.",
    "strasse", "Die ist westlich von hier.",
    ({  "rand", "kleinen schuppen", "kleiner schuppen", "schuppen" }), "\
Ein kleiner, etwas baufaelliger Schuppen steht am Rand der Koppel. Es ist \
bestimmt eine Menge nutzloses Geruempel drin. Aber all dies wirst Du nicht \
erfahren, wenn Du nicht versuchst, den Schuppen zu betreten, vorausgesetzt \
die Tuer hindert Dich nicht daran.",
    ({ "menge", "geruempel" }), "\
Solltest Du Dich fuer sowas interessieren, dann empfehle ich, einfach mal \
den Schuppen zu betreten.",
    ({ "tuere", "tuer" }), #'tuer_long,
    ({ "ganzes stueck", "stueck" }), "\
Na, das wird schon ein halber Kilometer sein.",
    ({ "halben kilometer", "halber kilometer", "kilometer" }), "\
Jetzt wird's laecherlich!",
    ({ "hof", "bauernhof" }), "\
Der Bauernhof erstreckt sich noerdlich und nordoestlich von hier, ist aber \
noch ein ganzes Stueck entfernt." }));
  AddExit("westen", RD_KOPPEL_EXIT);
  AddDetailAction(
    ({ "baum", "apfelbaum" }),
    map_array(CMD_KLETTERN+CMD_KRAXELN, #'+, " <me>")+
    map_array(CMD_KLETTERN+CMD_KRAXELN, #'+, "auf <me>"),
    "kletter_baum",
    ({ ({ M_PL, M_PL_VERB, "versuch", ", auf den Baum zu klettern,",
          M_PL_VERB, "schaff", "es aber nicht." }),
       ({ M_WRITE, "Die Aeste, an die Du rankommst, sind zu duenn zum "
          "Klettern. Du wirst Dir schon einen anderen Weg suchen muessen, "
          "um an die Aepfel zu kommen." }) })
    );
  AddDetailAction(
    ({ "kleinen schuppen", "kleiner schuppen", "schuppen" }),
    ({ "betritt <me>", "betrete <me>", "gehe in <me>", "geh in <me>" }),
    "betrete_schuppen", 
    #'betrete_schuppen
  );
  AddErrorMessage("betrete", "Vielleicht den Schuppen betreten?\n");

  AddDetailAction(
    "aepfel",
    ({ "pflueck <me>", "pfluecke <me>" }),
    "pflueck_aepfel",
    "Nana, wir wollen doch mal nicht gleich gierig sein und uns bitteschoen "
    "mit einem Apfel begnuegen."
  );

  AddDetailAction(
    "apfel",
    ({ "pflueck <me>", "pfluecke <me>" }),
    "pflueck_apfel",
    #'pflueck_apfel
  );
       
  AddDetailAction(
    ({ "apfel", "pferdeapfel", "koppel", 
       "pferdekoppel", "wiese", "gras", "boden" }),
    map_array((({ "such", "suche" }) + CMD_DURCHSUCHEN), #'+, " <me>"),
    "durchsuche_wiese",
    #'durchsuche_wiese
  );
  AddDetailAction(
    ({ "apfel", "pferdeapfel" }),
    ({ "such nach <me>", "suche nach <me>" }),
    "durchsuche_wiese2",
    #'durchsuche_wiese
  );
  map_array(CMD_DURCHSUCHEN, #'AddErrorMessage, "\
Nunja, Du koenntest das Gras durchsuchen, wenn Du wolltest, aber finden \
wirst Du nix.");

  AddDetailAction(
    ({ "tuer", "tuere" }),
    ({ "oeffne <me>", "schiebe <me>", "drueck <me>",
       "druecke <me>", "schieb <me>", "schiebe <me> auf",
       "schieb <me> auf", "drueck <me> auf", "druecke <me> auf",
       "ruettle <me>", "ruettel <me>", "ruettle an <me>",
       "mach <me> auf", "mache <me> auf",
       "ruettel an <me>", "zerre <me>", "zerr <me>", "zerr an <me>",
       "zerre an <me>", "zieh <me>", "zieh an <me>",
       "ziehe <me>", "ziehe an <me>" }),
    "oeffne_schuppen",
    #'my_oeffne
  );
  AddErrorMessage("oeffne", "Du koenntest die Tuer oeffnen.\n");

  AddDetailAction(
   ({ "tuer", "tuere" }),
   ({ "schliess <me>", "schliesse <me>", "mach <me> zu",
       "mache <me> zu" }),
   "schliess_tuer",
   #'schliess_tuer
  );

  AddDetailAction(
    ({ "tuer", "tuere" }),
    ({ "tritt <me>", "trete <me>", "tritt gegen <me>",
       "trete gegen <me>", "tritt an <me>", "trete an <me>" }),
    "trete_tuer",
    #'my_trete_tuer
  );
  make_pferd();
}

void reset()
{
  object ob;

  ::reset();

  if (ob=present("apfelpfluecker")) ob->remove();
  if (ob=present("apfel")) ob->remove();
  if (ob=present("mistgabel")) ob->remove();
  if (ob=present("weidenkorb")) ob->remove();
  if (ob=present("arbeitshemd")) ob->remove();
  if (ob=present("lederstiefel")) ob->remove();
  if (ob=present("milchkanne")) ob->remove();
  if (ob=present("seil")) ob->remove();
  versuche = 0;
  make_pferd();
}
