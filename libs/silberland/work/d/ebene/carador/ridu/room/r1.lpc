#pragma strong_types
#include "../def.h"

inherit RD_STDDIR"reling";

status kopf_weg;

void reset_vars()
{
  kopf_weg = 0;
}

void make_paeckchen()
{
  clone_object(RD_OBJDIR"paket")->move(this_object(), M_NOCHECK);
  message(({ ({ M_ROOM, this_object(), "Aus dem Nichts materialisiert sich "
    "ploetzlich ein Paket auf dem Boden." }),
   4,
    ({ "Eine unwirkliche Stimme ist zu hoeren: Die Post ist da!" }) }));
}

void make_drache()
{
  call_out("make_paeckchen", 50);
  RD_NPCDIR"d_kopf"->move(this_object(), M_NOCHECK|M_SILENT);
  RD_NPCDIR"d_kopf"->start_laber();
  kopf_weg = 1;
}

void do_entladung()
{
  message(({
    ({ M_ROOM, this_object(), "Der Blitz schlaegt genau in den Drachenkopf der "
       "Galeonsfigur ein." }),
    4, 
    ({ M_ROOM, this_object(), "Ploetzlich schlaegt der Kopf die Augen auf "
       "und gleitet von seiner Befestigung herab und faellt auf die "
       "Reling." }),
    ({ #'make_drache })
  }));
}

void make_ridu()
{
  object ob;

  ob = RD_TOOLS->load_object(RD_NPCDIR"ridu");   
  if (!environment(ob) || !environment(ob)->QueryProp(P_RD_RIDU_AREA)) {
    ob->move(this_object(), M_NOCHECK);
    return;
  }
}

private string kopf_long()
{
  if (kopf_weg) return "\
Die Schnitzereien zeigen nichts weiter als ein paar verschnoerkelte \
Ornamente.";
  return "\
Der Kopf eines gewaltigen Drachen, geschnitzt in Holz, ziert den Bug des \
Schiffes. Von aussen sieht das Schiff damit ganz schoen bedrohlich aus.";
}

private mixed laeut_glocke()
{
  if (find_call_out("glocke_gelaeutet") > -1)  {
    message("Bitte nicht schon wieder. Deine Ohren klingeln noch immer.");
    return 2;
  }
  call_out("glocke_gelaeutet", 20);
  message(({
     ({ M_PL, M_PL_VERB, "laeute", "die Schiffsglocke." }),
     ({ M_ROOM, RD_LIBDIR"mover"->query_unten(),
        "Ding Dong, Ding Dong. Aus luftiger Hoehe hoerst Du eine Glocke "
        "laeuten." }),
     ({ M_ROOM, RD_TOOLS->load_object(RD_ROOMDIR"seil_raum"),
        "Ding Dong, Ding Dong. Aus luftiger Hoehe hoerst Du eine Glocke "
        "laeuten." })
  }));
  RD_LIBDIR"mover"->tell_schiff("Die Schiffsglocke macht 'Ding Dong, Ding Dong'.", 1);
  return 1;
}

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Am Bug");
  SetProp(P_RD_RELING_LONG,  "\
Genau hier ist der Bug des Schiffs, die vorderste Spitze. Naja, eigentlich \
ist die vorderste Spitze noch ein bisschen weiter vorn. Beim Versuch ganz \
nach vorne zu kommen - denn das macht man ja, man haengt sich foermlich ueber \
die Reling - fallen Dir Schnitzereien an der Aussenwand des Bugs auf. Blick \
nach hinten siehst Du in der Schiffsmitte unuebersehbar eine grosse Kabine, \
die wohl den gesamten Schiffsrumpf einnimmt. Eine Schiffsglocke haengt an \
der Kabinenwand. Links und rechts an der Kabine \
vorbei, oh, Entschuldigung, auf einem Schiff heisst es ja Backbord und \
Steuerbord, fuehren kleine Gaesschen, wo man in den hinteren Teil des Schiffs \
gelangen kann.");
  AddDetails(({
    "entschuldigung", "Tut mir echt leid! Verzeihst Du mir noch einmal?",
    "versuch", "Lehn Dich bloss nicht zu weit raus, sonst faellst Du \
runter.",
    ({ "glocke", "schiffsglocke", "massive glocke",
       "massive schiffsglocke", "wand", "kabinenwand" }), "\
Eine grosse, massive Schiffsglocke aus Messing haengt an der Kabinenwand, \
die man bestimmt laeuten koennte, also die Glocke und nicht die Wand.",
    "messing", "\
Hierbei handelt es sich um normales, gelblich glaenzendes, hervorragend \
gearbeitetes Messing.",
    ({ "ornamente", "ornament" }), "Nett anzusehen, mehr aber auch nicht.",
    ({ "rumpf", "schiffsrumpf" }), "\
Ueber den gesamten Schiffsrumpf erstreckt sich die Kabine. Aussen an der \
Kabine vorbei fuehrt eine kleine Gasse.",
    ({ "gasse", "kleine gasse", "gaesschen", "kleine gaesschen", 
       "kleines gaesschen" }), "\
Gerade so breit, dass man bequem entlang laufen kann.",
    "reling", "\
Die Reling fuehrt aussen um das ganze Schiff herum. Ein kleines Gelaender \
hindert einen am Runterfallen aber keineswegs am Sachen-Ueber-Bord-Werfen \
oder Nach-Unten-Schauen. Auch koenntest Du hier versuchen, die gesamte \
Reling zu ueberblicken. \
Was die Sachen anbelangt, so scheint Dir dieser Ort hier am geeignetsten, \
um ein Seil ueber Bord zu werfen.",
    "ort", "Ja, hier koennte man ein Seil am ehesten ueber Bord werfen.",
    ({ "bug", "bugs" }), "Bugs gibt's hier hoffentlich keine. :)",
    ({ "sachen", "dinge" }), "Sachen halt, Du weisst schon, Dinge.", 
    ({ "gegensatz","spitze" }), "\
Jaa, die ist hier, ganz im Gegensatz zu Bugs. Hoffentlich.",
    ({ "schnitzereien", "schnitzerei", "kopf", "drache", "aussenwand",
       "drachenkof" }), #'kopf_long
  }));

  AddDetailAction(
    ({ "glocke", "schiffsglocke", "massive glocke",
       "massive schiffsglocke" }),
    ({ "laeut <me>", "laeute <me>" }),
    "laeut_glocke",
    #'laeut_glocke
  );

  AddDetailAction(
    ({ "wand", "kabinenwand" }),
    ({ "laeut <me>", "laeute <me>" }),
    "laeut_wand",
    "Du probierst auch jeden Schmarrn aus. Die Glocke sollst Du laeuten."
  );

  AddExit("steuerbord", ([ EX_DEST: RD_ROOMDIR"r6",
                         EX_TESTFUNC:#'my_stolper,
                         EX_MSG: "nach Steuerbord" ]));
  AddExit("backbord", ([ EX_DEST: RD_ROOMDIR"r2",
                           EX_TESTFUNC:#'my_stolper,
                           EX_MSG:"nach Backbord" ]));
  make_ridu();
}

varargs void set_seil(object s)
{
  object ob, sr, unten;

  RD_TOOLS->load_object(RD_OBJDIR"seil_oben")->move(this_object(),M_NOCHECK);
  sr = RD_TOOLS->load_object(RD_ROOMDIR"seil_raum");
  unten = sr->query_unten();
  if (ob = present("\nridu#seil_unten", unten)) {
    ob->remove();
    message(({ ({ M_ROOM, unten, "Ein Windstoss erfasst das Seil und es "
      "verschwindet auf Nimmerwiedersehen." }) }));
  }
  if (s) s->remove();
}

status wirf_seil_runter(object s)
{
  if (present("\nridu#seil_oben", this_object())) {
    message(({ ({ "Gerade als", M_PL_BEST, "ein Seil ueber die Reling "
     "werfen ", M_PL_VERB, ({"moechtest", "moechte" }), ", ",
     M_PL_VERB, "stolper", M_PL_PRONOUN, " ueber ein zweites Seil, das "
     "hier ueber die Reling haengt und nach unten fuehrt." }),
     4,
     ({ M_WRITE, "Du denkst Dir: Na gut, eigentlich reicht ja ein Seil." })
  }));
    return 1;
  }
  if (RD_ROOMDIR"seil_raum"->is_seil_besetzt()) {
    message(({
      ({ "Gerade als", M_PL_BEST, " das Seil ueber Bord " +
         "werfen", M_PL_VERB, ({ "moechtest", "moechte" }),
         ",", M_PL_VERB, "verhedder", M_PL_PRONOUN, M_PL_AKK_SICH,
         "im Seil und stuerzt zu Boden." }),
      4,
      ({ M_WRITE, "Vielleicht waere es besser, ein paar Minuten "+
                 "zu warten." }) }));
    return 1;
  }
  set_seil(s);
  message(({ ({ M_PL_BEST, M_PL_VERB, "wirf", "das eine Ende eines "
     "Seiles ueber die Reling." }),
          4,
          ({ M_WRITE, "Das andere Ende haeltst Du fest. Eigentlich haettest "
             "Du erwartet, dass das fallende Ende das festgehaltene Ende "
             "mit in die Tiefe reissen moechte. Aber dem ist nicht so. "
             "Also laesst Du das andere Ende aus. Es bleibt liegen." }),
          ({ M_SAY, M_PL_BEST, "laesst das lose Ende aus. Erstaunlicherweise "
             "bleibt es liegen." }) }));
  return 1;
}


void init()
{
  ::init();
  if (this_player() && query_verb() == "oben") message("\
So, geschafft, endlich. Du kletterst bis ans Ende des Seil und springst \
fix ueber die Reling an Bord.");
}
