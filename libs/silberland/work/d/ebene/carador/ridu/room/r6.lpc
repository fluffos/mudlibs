#pragma strong_types
#include "../def.h"

inherit RD_STDDIR"reling";

private mixed reibe_stein()
{
  if (find_call_out("min_reibeabstand") > -1) {
    message("Autsch! Der Stein ist noch zu heiss zum Anfassen.");
    return 1;
  }
  call_out("min_reibeabstand", RD_MIN_REIBEABSTAND);
  if (interactive(this_player()) && present("\nridu#ridu", this_object())) {
    message(({ ({ "Als ", M_PL_BEST, "die Finger nach dem Stein",
      M_PL_VERB, "ausstreck", "klopft ", M_PL_DAT_IHM, " Ridu auf die "
      "Finger und ruft: Hey, Pratzen weg!" }) }));
    return 1;
  }
  RD_LIBDIR"mover"->turn(1);
  return 1;
}

private mixed kratze_stein()
{
  if (interactive(this_player()) && present("\nridu#ridu", this_object())) {
    message(({ ({ "Als ", M_PL_BEST, "die Finger nach dem Stein",
      M_PL_VERB, "ausstreck", "klopft ", M_PL_DAT_IHM, " Ridu auf die "
      "Finger und ruft: Hey, Pratzen weg!" }) }));
    return 1;
  }
  RD_LIBDIR"mover"->kratze_stein(2); // 2 ist rot
  return 1;
}

void create()
{
  reling::create();
  SetProp(P_INT_SHORT, "Steuerbord, in Bugnaehe");
  SetProp(P_RD_RELING_LONG,  "\
Hier an Steuerbord, in Naehe des Bugs, ist ein besonders schoenes Fleckchen auf \
dem Schiff. Zumindest muessen das die Moewen denken, die sich's hier auf dem \
Kabinendach bequem gemacht haben und dies lauthals kundtun. Ueber der Reling \
haengt ein roter Stein. Die Gasse erstreckt sich weiter bug- und heckwaerts. \
");
  AddExit("vorne", ([ EX_DEST:RD_ROOMDIR"r1",
                      EX_TESTFUNC:#'my_stolper ]));
  AddExit("hinten",([ EX_DEST:RD_ROOMDIR"r5",
                      EX_TESTFUNC:#'my_stolper ]));
  AddDetails(({
    ({ "bug", "bugs" }), "Bugs gibt's hier hoffentlich keine. :)",
    "naehe", "Du kannst den Bug tatsaehlich sehen von hier aus. Kein Wunder, \
er ist ja auch nicht weit.",
    
    "inschrift", "Der Stein leuchtet zu hell, als dass Du etwas erkennen "
                 "koenntest.",
    ({ "schimmer", "inneren", "inneres", "schimmern", }),
         "Ein zartrotes, sanftes Schimmern, das irgendwie nur "
      "darauf wartet, in ein helles, kraeftiges Schimmern ueberzugehen.",
    ({ "stein", "rotem stein", "roten stein", "roter stein" }), "\
Hummja, vielleicht hast Du ja schonmal so einen aehnlichen Stein irgendwo \
gesehen. Koennt ja sein, dass es noch andere gibt. Aber die waren bestimmt \
nicht so schoen rot wie dieser hier. Eigentlich ist der Stein ja eher \
farblos als rot, aber im Inneren des Steins siehst Du ein rotes Schimmern. \
Hoffentlich hast Du einen Schimmer, was Du jetzt weiter tun moechtest.",
    ({ "fleck", "fleckchen" }), "\
Eigentlich waer's hier ja ganz nett, wenn nicht das dauernde Vogelgekreische \
waere.",
    ({ "gekreische", "vogelgekreische" }), "\
Hier ist absolut ueberhaupt kein Vogelgekreische zu SEHEN.",
    "pack", "Du hast die Viecher noch nie gemocht.",
    "viecher", "Ja, Du weisst schon, kreischen nur rum und scheissen \
alles voll.",
    ({ "moewe", "moewen" }), "\
Ein paar sitzen friedlich da, ein paar andere kraehen gerade, die naechsten \
putzen sich, wieder andere schauen Dich grimmig an. Seltsames Pack, denkst \
Du Dir."
  }));
  AddDetailAction(
     ({ "roten stein", "rotem stein", "roter stein", "stein" }),
     ({ "reibe <me>", "reibe an <me>", "reibe am <me>" }), 
     "reibe_stein",
     #'reibe_stein 
  );
  AddDetailAction(
     ({ "roten stein", "rotem stein", "roter stein", "stein" }),
     ({ "kratze <me>", "kratze an <me>", "kratze am <me>" }), 
     "kratze_stein",
     #'kratze_stein 
  );

  AddSound(({ DEFAULT_SOUND, "geraeuschsituation", "gekreische", "vogelgekreische", "moewen" }),
     "Hier ist es besonders leicht, die vorliegenden Geraeuschsituation "
     "zu beschreiben: KREISCH KREISCH KREISCH KREISCH KREISCH ZETER KREISCH "
     "KREISCH ZETER KREISCH ZETER KREISCH KREISCH KREISCH.");
}
