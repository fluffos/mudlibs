#pragma strong_types
#include "../def.h"

inherit RD_STDDIR"reling";

private void fisch_anwesende()
{
  int i;
  object *inv;
  
  inv = all_inventory(this_object());
  for (i=sizeof(inv);i--;)
    if (interactive(inv[i])) 
      RD_LIBDIR"fischmaker"->fill_inv(inv[i]);
}

void ende_fisch_entladung()
{
  message(({
    ({ M_ROOM, this_object(), "So ploetzlich, wie er gekommen war, "
       "ist der Spuk auch wieder vorueber. Der grosse Fisch sieht wieder "
       "voellig normal aus." }) 
  }));
}

private string fisch_long()
{
  if (find_call_out("ende_fisch_entladung") < 0) return "\
Wow, what a fish! Ein regelrechtes Monstrum, was da an der Wand haengt. \
Scheint irgendeine Art von Kugelfisch zu sein, so dick wie der Bauch ist. \
Er sieht ziemlich grimmig aus, Du kannst von Glueck reden, dass er tot ist. \
Okay, Captain Ahab, Dein Bein ist nicht wirklich in Gefahr, aber gut \
Kirschenessen ist mit so einem Fisch sicher nicht.";
  return "\
Die Augen des Fisches sind weit aufgerissen. Noch weiter aufgerissen ist \
jedoch nur noch der Mund und es quellen dauernd neue, Minifische heraus und \
fallen auf den Boden. Du machst Dir den Spass, sie immer gleich wieder zu \
zertrampeln, denn eigentlich hast Du schon genug von diesen Fischen.";
}

void do_entladung()
{
  int i;
  object r;
  
  r = this_object();

  call_out("ende_fisch_entladung", 300);

  message(({
    4,
    ({ M_ROOM, r, "Genaugenommen schlaegt der Blitz hier direkt in die "
       "Wand ein und zwar in den riesengrossen, ausgestopften Fisch, "
       "der dort haengt." }),
    8,
    ({ M_ROOM, r, "Der Fisch reisst ploetzlich die Augen auf und blaest "
       "seine Backen auf, als ob er sich gleich uebergeben muesste." }),
    8,
    ({ M_ROOM, r, "Hey, er muss sich uebergeben, und zwar mitten ueber "
       "...", #'fisch_anwesende }) }));
}

void create()
{
  reling::create();
  SetProp(P_INT_SHORT, "Steuerbord, in Hecknaehe");
  SetProp(P_RD_RELING_LONG,  "\
Das herausragendste Merkmal hier auf der Steuerbordseite des Schiffs ist ein \
grosser, ausgestopfter Fisch, der an der Kabinenwand haengt. \
Ansonsten sieht's hier nicht viel anders aus, als auf der restlichen Reling. \
Noch ein kleines Stueck weiter nach hinten, dann bist Du am Heck angelangt.");
  AddDetails(({ 
    ({ "kirschenessen", "kirschen" }), "Keine Kirschen, kein Kirschenessen. \
Mensch! Das war uebertragen gemeint! Und man muss nicht jeden Furz \
anschauen!",
    "bug", "Den kannst Du von hier aus nicht sehen, der ist zu weit vorne.",
    "furz", "Du hast's schon wieder getan!",
    "gefahr", "Wer sich in Gefahr begibt, kommt darin um!",
    "bauch", "Mein lieber Scholli. Was da wohl drin ist?",
    "art", "Kugelfisch halt. Genauer kannst Du's auch nicht sagen.",
    "stueck", "Wirklich nicht weit.",
    "steuerbordseite", "Stimmt, genau hier bist Du grad.",
    ({ "heck", "hecknaehe" }), "\
Nur noch wenige Schritte, dann bist Du am Ende! Nicht woertlich gemeint, \
natuerlich, denn Du machst das hier ziemlich gut!",
    "ende", "Uebertragen gemeint natuerlich.",
    "schritte", "Ein paar Schritte von hier zum Heck. Genau kannst \
Du's nicht sagen. Dazu muesstest Du die Schritte schon zaehlen.",
    ({ "merkmal", "grossen fisch", "grosser fisch", "fisch",
       "herausragendstes merkmal", "kugelfisch", "monstrum",
       "ausgestopften fisch" }), #'fisch_long,
    ({ "wand", "kabinenwand" }), "\
Das ist ja ein echtes Monstrum von Fisch, das da haengt."
  }));
  AddExit("vorne", ([ EX_DEST:RD_ROOMDIR"r6",
                      EX_TESTFUNC:#'my_stolper ]));
  AddExit("hinten",([ EX_DEST:RD_ROOMDIR"r4",
                      EX_TESTFUNC:#'my_stolper ]));

  AddSmell(DEFAULT_SMELL, "Es riecht irgendwie nach Fisch.");
  AddSmell(({ "fisch", "grossen fisch", "kugelfisch", "wand",
              "grossem fisch", "ausgestopftem fisch" }),
    "Yup. Der grosse Fisch an der Wand, obwohl ausgestopft, riecht doch "
    "noch immer nach Fisch. Und zwar auf eine aeusserst unangenehme Art "
    "und Weise. Du wuerdest Dir so 'nen Fisch nicht ins Seherhaus haengen.");

  AddDetailAction(
    "schritte",
    ({ "zaehl <me>", "zaehle <me>" }),
    "zaehl_schritte",
    ({ ({ M_WRITE, "Du schreitest langsam Richtung Heck. Eins, zwei, "
          "drei ... kehrst um ... vier, fuenf, sechs. Sechs Schritte "
          "von hier zum Heck und zurueck." }),
       ({ M_SAY, M_PL, "schreitet zum Heck und zurueck und sieht "
          "dabei angestrengt aus." }) }));
}

void zertrampel_fische()
{
  int count;
  object ob, ob2;

  ob = first_inventory(this_object());
  while(ob) {
    ob2 = next_inventory(ob);
    if (ob->id("minifisch")) {
      count++;
      ob->remove();
    } 
    ob = ob2;
  }
  if (count) {
    if (count > 1)
      message(({ ({ "Als", M_PL_BEST, M_PL_VERB, "reinkomm",
                    ", ", M_PL_VERB, "zertrampel", M_PL_PRONOUN,
                    "versehentlich all die Minifische." }) }));
    else
      message(({ ({ "Als", M_PL_BEST, M_PL_VERB, "reinkomm",
                    ", ", M_PL_VERB, "zertrampel", M_PL_PRONOUN,
                    "versehentlich den Minifisch." }) }));
  }
}


void init()
{
  ::init();

  call_out("zertrampel_fische", 0);

  if ( interactive(this_player()) &&
       find_call_out("ende_fisch_entladung") > -1 )
    RD_LIBDIR"fischmaker"->fill_inv(this_player());

}
