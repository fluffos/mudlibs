#pragma strong_types
#include "../def.h"
#include <verben.h>

inherit RD_ROOM;

object *throwing = ({});

void make_steine()
{
  object ob;

  ob = clone_object(RD_STDDIR"stein");
  ob->set_farbe("rot");
  ob->move(this_object(), M_NOCHECK);
  ob = clone_object(RD_STDDIR"stein");
  ob->set_farbe("gruen");
  ob->move(this_object(), M_NOCHECK);
  ob = clone_object(RD_STDDIR"stein");
  ob->set_farbe("lila");
  ob->move(this_object(), M_NOCHECK);
}

void check_for_quest(string solver)
{
  int res;
  object pl;

  if (!solver || !(pl = find_player(solver))) {
    message(({ ({  M_ROOM, this_object(), "Und wem hat das jetzt was "
      "gebracht? Leider niemandem. Denn zum Questloesen gehoeren zwei Dinge:"}),
      2,
      ({ "1.) Man muss die Arbeit schon selber machen." }),
      2,
      ({ "2.) Man muss schon da sein, wenn's ans Belohnen geht." })
    }));
    RD_LOGGER->do_log("checkquest", "quest not solved");
    return;
  }
  message(({ ({ M_TARGETS, ({pl}),
    "Damit hast Du die Quest geloest. Glueckwunsch! Gut gemacht! Super!" })
  }));
  res = -99;
#ifdef RD_QUESTNAME
  res = pl->GiveQuest(RD_QUESTNAME);
  log_file("quests/ridu", dtime(time()) + ": " + pl->Name() + " hat die Quest geloest.\n");
#endif
  RD_LOGGER->do_log("quest", "geloest (" + res + ")", pl);
}

void destruct_theo()
{
  object t;

  if (t = find_object(RD_NPCDIR"theo")) t->remove();
}

void schiff_ist_zurueck(string solver)  
{
  object r;

  r = this_object();

  message(({
    2,
    ({ M_ROOM, r, "Kaum hat das Schiff auf dem Wasser aufgesetzt, so "
       "springt Theo schon ueber die Klippen, auf das Deck des Schiffs "
       "hinunter und inspiziert sein Schiff." }),
    2,
    ({ M_ROOM, r, "Theo ruft: Hmmja, ist ja alles eigentlich noch ganz "
       "gut in Schuss." }),
    2,
    ({ M_ROOM, r, "Bei den magischen Steinen jedoch macht er halt und "
       "schreit: Nur was is' denn das fuer ein Scheiss hier?" }),
    2,
    ({ M_ROOM, r, "Mit roher Gewalt reisst er die Gestaenge, mit denen "
       "die Steine befestigt sind, ab und wirft die Steine in hohem "
       "Bogen ueber Bord, an den Strand." }),
    ({ #'make_steine }),
    2,
    ({ M_ROOM, r, "Theo ruft: Jau. So isses prima. Vielen Dank fuer's "
       "Wiederbringen. Ich muss weg." }),
    2,
    ({ M_ROOM, r, "Und hastunichtgesehen hat sich Theo aufs Kabinendach "
       "geschwungen und Segel gesetzt." }),
    ({ #'destruct_theo }),
    2,
    ({ M_ROOM, r, "Kurze Zeit spaeter verschwindet das Schiff am "
       "Horizont und zurueck bleiben nur die drei Steine am Strand." }),
    4,
    ({ M_CALL, #'check_for_quest, ({ solver }) }) 
  }));
}

status is_ridu_theo_home()
{
  return 1;
}

void make_theo()
{
  object theo;
  theo = RD_TOOLS->load_object(RD_NPCDIR"theo");
  if (environment(theo) != this_object()) {  
    theo->move(this_object(), M_NOCHECK);
  }
  RD_TOOLS->load_object(RD_LIBDIR"loader");
}

void kiesel_fliegt(mixed arg)
{
  if (!arg) return;

  if (!this_player() || environment(this_player()) != this_object()) {
    throwing -= ({ 0, this_player() });
    message(({ ({ M_ROOM, this_object(), "Der Kiesel faellt ins Wasser." }) }));
    return;
  }
  
  arg[0] = arg[0]+1;
  if (arg[0] >= arg[1]) {
    switch(arg[0]-1) {
       case 0:
         message(({
           ({ M_WRITE, "Platsch! Dein Kiesel versinkt gleich beim ersten "
              "Mal im Meer." }),
           ({ M_SAY, "Platsch! Der Kiesel von ", M_PL_DAT,
              "versinkt gleich beim ersten Mal im Meer." }) }));
          break;
       case 1:
         message(({
           ({ M_WRITE, "Platsch! Nach nur einem Huepfer versinkt "
              "Dein Kiesel im Meer." }),
           ({ M_SAY, "Nach nur einem Huepfer versinkt der Kiesel von ", 
              M_PL_DAT, " im Meer." }) }));
         break;
       default :
         message(({
           ({ M_WRITE, "Platsch! Nach insgesamt "+
              RD_LIBDIR"grammar"->get_numeral(arg[0]-1) + " Huepfern versinkt "+
              "Dein Kiesel im Meer." }),
           ({ M_SAY, "Nach insgesamt " +
              RD_LIBDIR"grammar"->get_numeral(arg[0]-1) + " Huepfern versinkt "+
              "der Kiesel von ", M_PL_DAT, " im Meer." }) }));
         break;
    }
    throwing -= ({ this_player() });
  } else {
    message(({
      ({ M_WRITE, "Flitsch! Dein Kiesel tatzt zum " + 
         RD_LIBDIR"grammar"->get_raw_ordinal(arg[0]) +
         "en Mal auf dem Wasser auf." }),
      ({ M_SAY, "Flitsch! Der Kiesel von ", M_PL_DAT,
         "tatzt zum " +
         RD_LIBDIR"grammar"->get_raw_ordinal(arg[0]) +
         "en Mal auf dem Wasser auf." }) }));
    call_out("kiesel_fliegt", 0, ({ arg[0], arg[1] }));
  }
}

private mixed wirf_kiesel()
{
  int weite, ges;

  if (member_array(this_player(), throwing) > -1)  {
    message("Wart doch erstmal ab, bis Dein anderer Kiesel gelandet ist.");
    return 2;
  }

  ges = this_player()->QueryAttribute(A_DEX) / 3;
  weite = random(10+ges) - random(7);
  if (weite < 0) weite = 0;

  throwing += ({ this_player() });
  message(({
   ({ M_PL, M_PL_VERB, "wirf", "einen besonders flachen Kiesel auf's Meer "
      "hinaus." }) }));
  call_out("kiesel_fliegt", 0, ({ 0, weite }));
  return 1;
}


private mixed wirf_rund()
{
  message("Zum Werfen eignen sich nur die flachen Kiesel.");
  return 2;
}
 

void create() 
{
  RD_ROOM::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Am Strand");
  SetProp(P_INT_LONG, "\
Vamos a la playa war wohl die Devise, als Du Dich auf den Weg hierher \
aufgemacht hast. Denn jetzt bist Du am Strand. Allerdings wird das \
Badevergnuegen ausbleiben muessen, da der Strand abrupt an den Klippen \
endet.");
  AddDetails(({
    "abgrund", "Da koennte man schon runterfallen. Und wenn man \
nicht schwimmen kann, waer's schlecht. Also, lieber Finger weg \
von Theo.",
   "finger", "Weg!",
    "zeit", "Die Zeit, wie soll man sie beschreiben. Sie ist ewig \
am Fliessen, nicht greifbar, man kann sie nicht anhalten, selbst \
wenn man dies manchmal gern wuerde.",
    "devise", "Ja, wenn nicht unter dieser, unter welcher Devise stand \
Dein Weg hier zum Strand wohl sonst?",
    "drang", "Irgendwas war mit flachen Kieseln...",
    "tiefe", "Naja, wollen wir mal nicht uebertreiben. So tief ist es nun \
auch wieder nicht. Da hast Du schon ganz andere Tiefen gesehen...",
    "weg", "Diesen Weg auf den Hoeh'n bin ich oft gegangen, Voeglein sangen "
           "Lieder...",
    "meer", "So weit das Auge reicht.",
    ({ "flache kiesel", "flachen kiesel" }), "\
Jetzt weisst Du, was Du gerne mit einem dieser flachen Kiesel machen wuerdest! \
Ihn werfen! Und zwar so auf's grosse, weite, schillernde Meer hinaus, dass \
er moeglichst oft sanft wie eine Feder auf der Wasseroberflaeche auftatzt \
und seine fliegende Reise durch die Luefte fortsetzt, bis er irgendwann \
endgueltig in den gruenen, dunklen Tiefen des Meeres.... So ein Gelaber... \
Du willst jetzt sofort einen Kiesel werfen!",
    ({ "runde kiesel", "dicke kiesel",
       "runden kiesel", "dicken kiesel",
       "kiesel", "stein", "steine", "kieselsteine",
       "kleine kiesel",
       "kleinen kiesel" }), "\
Runde Kiesel, dicke Kiesel und vereinzelt auch flache Kiesel. Gerade die \
flachen Kiesel haben es Dir irgendwie angetan. Du fuehlst einen bestimmten \
Drang in Dir, kannst ihn aber noch nicht naeher spezifizieren.",
    ({ "sternenhimmel", "himmel" }), "\
Ich seh den Sternenhimmel, Sternenhimmel, hoho.",
    "boden", "Unter Deinen Fuessen ist der nackte Sandstrand.",
    ({ "fuesse", "fuessen" }), "Dir ist wohl langweilig, weil Du so auf \
Deine Fuesse starrst?",
    "meter", "Na, wie viele werden's wohl sein, drei oder vier vielleicht.",
    ({ "wasser", "gewaesser" }), "\
Das Wasser ist einige Meter unterhalb von Dir.",
    ({ "playa", "sandstrand", "strand" }), "\
Ein echter Sandstrand, waer ja ganz schoen, wenn man Baden koennte, aber so \
isses irgendwie oed hier. Allerdings liegen zwischen dem Sand vereinzelt \
Kiesel, und manchmal auch flache. Vielleicht kann man ja damit was anfangen.",
    "wuestensand", "Hammer nicht!",
    ({ "strandsand", "sand" }), "\
Brennend heisser Wuestensand. So schoen, schoen war die Zeit... Naaa, es ist \
ja gar kein Wuestensand, sondern Strandsand, in dem vereinzelt sogar \
kleine Kiesel zu sehen sind.",
    ({ "vergnuegen", "baden", "badevergnuegen" }), "\
Wie denn, wenn Du nicht ans Wasser rankommst? Und in unbekannte Gewaesser \
soll man bekanntlich nicht springen.",
    ({ "lied", "lieder", "voeglein", "hoehen", "hoehn" }), "\
Au mann, hier gibt es weder Lieder noch Voeglein. Das war nur ne Zeile aus \
einem Lied, dem Rennsteiglied. Und bitte, BITTE, schau jetzt nicht auch noch \
das Rennsteiglied an, denn sonst: Sowas siehst Du da nicht.",
    ({ "zeile", "rennsteiglied" }), "AAAAAAAARGL!",
    "wirklichkeit", "Stimmt, nochmalige Kontrolle ergibt, dass es \
tatsaechlich nur wenige Meter von hier bis zum Wasser sind.",
    "klippen", "\
Die Klippen sind zwar steil, aber doch nicht so tief, wie es eben noch \
aussah. In Wirklichkeit ist das Wasser nur wenige Meter tiefer als der \
Strand." }));
  AddDetailAction(
    ({ "runden kiesel", "dicken kiesel", "kleinen kiesel" }),
    map_array(CMD_WERFEN, #'+, " <me>"),
    "wirf_rund",
    #'wirf_rund
  );
  AddDetailAction( 
    ({ "kiesel", "kieselstein", "stein", "flachen kiesel" }),
    map_array(CMD_WERFEN, #'+, " <me>"),
    "wirf_flach",
    #'wirf_kiesel
  );
  AddErrorMessage(CMD_WERFEN, "Vielleicht moechtest Du einen Kiesel werfen?\n");
  AddExit("nordosten", RD_PIER_EXIT);
  
  AddSmell(({ "fische", "fisch" }), "Zum Glueck ist Verleihnix nicht hier.");
  AddSmell(({ "muscheln", "muschel" }), "Wenn hinter Muscheln Muscheln kuscheln?");
  AddSmell(({ DEFAULT_SMELL, "ort" }),
    "Vielleicht nicht der typische Geruch, den man sich an solchem einem "
    "Ort vorstellt. Zumindest riechst Du keine vergammelnden Fische oder "
    "Muscheln. Das einzige, was wahrzunehmen ist, ist der leichte Salzgeruch, "
    "der vom Meer herueberweht.");
  AddSmell( 
    ({ "geruch", "salzgeruch", "salz", "meer", "wasser", "gewaesser" }),
    "Hmmmja, man kann den Salzgehalt des Meeres sogar ein bisschen riechen."
  );
  AddSmell("salzgehalt", "Salzig halt.");
  AddSound(DEFAULT_SOUND, 
    "Das leise, melodische Klatschen der Wellen gegen die Klippen wird ab "
    "und zu vom hysterischen Kreischen einer Moewe durchbrochen.");
  AddSound(({ "meer", "wasser", "klatschen", "wellen" }),
    "Irgendwie entspannend, wie die Wellen rhythmisch gegen das Ufer "
    "schlagen. Andererseits, hast Du nichts besseres zu tun?"
  );
  AddSound(({ "kreischen", "moewe" }),
    "Irgendwie nervig, wie die bloede Moewe die Idylle stoeren muss. Naja, "
    "Du hast eh bestimmt besseres zu tun, als Deine Lauscher hier in die "
    "Luft zu recken."
  );
  AddSound(({ "klippe", "klippen" }), "Irgendwie schoen, wie sich das \
Wasser mit lautem Klatschen an die Klippen schmettert.");
  AddSound("klatschen", "KLATSCH!");

  AddSound("idylle", "Nett hier, so friedlich.");
    
  make_theo();
}

void reset()
{
  ::reset();
  make_theo();
}
