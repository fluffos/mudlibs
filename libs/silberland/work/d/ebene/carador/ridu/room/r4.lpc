#pragma strong_types
#include "../def.h"

inherit RD_STDDIR"reling";

status hintern_weg;
status kaputt;

int query_kaputt()
{
  return kaputt;
}

void reset_vars()
{
  object ob;

  hintern_weg = 0;
  kaputt = 0;
  if (ob = present("blitzeableiter")) ob->remove();
  if (ob = present("\nridu#d_schwanz")) ob->remove();
}

status query_hintern()
{
  return !hintern_weg;
}

void make_drache()
{
  object ab;
  hintern_weg = 1;
  RD_NPCDIR"d_schwanz"->move(this_object(), M_NOCHECK|M_SILENT);
  RD_NPCDIR"d_schwanz"->start_laber();
  if (ab = present("\nridu#ableiter_klemme", this_object())) ab->loese_klemme();
}

private string kompass_long()
{
  return "\
Ein Blick auf den Schiffskompass sagt Dir, dass das Schiff momentan in \
Richtung " + capitalize(RD_LIBDIR"mover"->query_dir_string()) + " zeigt.";
}

private mixed reibe_stein()
{
  object ridu;

  if (find_call_out("min_reibeabstand") > -1) {
    message("Autsch! Der Stein ist noch zu heiss zum Anfassen.");
    return 1;
  }
  if (kaputt) {
    message(({
      ({ M_PL, M_PL_VERB, "reib", " an dem kalten, kaeumlichstens "
         "schimmernden Stein. Und natuerlich passiert auch nichts. "
         "Sieht ganz so aus als haettest Du einen Platten! Also, "
         "Reserverad raus!" }) }));
    return 1;
  }

  if ( (ridu = find_object(RD_NPCDIR"ridu")) &&
       !present("\nridu#ridu", this_object()) ) ridu->walk_to(4,1);

  if (interactive(this_player()) && present("\nridu#ridu", this_object())) {
    message(({ ({ "Als ", M_PL_BEST, "die Finger nach dem Stein",
      M_PL_VERB, "ausstreck", "klopft ", M_PL_DAT_IHM, " Ridu auf die "
      "Finger und ruft: Hey, Pratzen weg!" }) }));
    return 1;
  }
  call_out("min_reibeabstand", RD_MIN_REIBEABSTAND);
  RD_LIBDIR"mover"->go();
  return 1;
}

private mixed kratze_stein()
{
  if (interactive(this_player()) && present("\nridu#ridu", this_object())) {
    message(({ ({ "Als ", M_PL_BEST, "die Finger nach dem Stein",
      M_PL_VERB, "ausstreck", "klopft ", M_PL_DAT_IHM, " Ridu auf die "
      "Finger und ruft: Hey, Pratzen weg!" }) }));
    return 1;
  }
  if (kaputt) {
    message("Das ist doch zwecklos, der Stein ist eh kaputt.");
    return 1;
  }
  RD_LIBDIR"mover"->kratze_stein(4); // 4 ist gruen
  return 1;
}

status is_blitzeableiter_geeignet()
{
  return 1;
}

private string hintern_long()
{
  string desc;

  if (hintern_weg) return "\
Die Schnitzereien zeigen lediglich ein paar verschlungene Ornamente, \
eine Statue, die noch dazu den Koerper eines Drachen zeigen soll, ist \
hier leider nicht. Hast Du Dich wohl getaeuscht.";

  desc = "\
Am Heck des Schiffs ist die geschnitzte Statue eines Drachenkoerpers befestigt. \
Betrachtet man das Schiff im Ganzen, so sieht es ein bisschen aus \
wie ein riesengrosser Drache. Momentan stehst Du hier beim kopflosen \
Hinterteil, bestehend aus Schwanz, Koerper, Fuessen und Fluegel. Der Koerper \
sieht nicht nur vollkommen leblos aus, er ist es auch. Viel zu leblos, \
wie Du findest. ";
  if ( (this_player() && present("blitzeableiter", this_player())) ||
       present("blitzeableiter", this_object()) ) desc += "\
 Wenn man jetzt den Drachen beleben wollte und wenn man jetzt die Klemme \
des Blitzableiters nicht am gruenen Stein sondern... \
Nein, das kann nicht funktionieren.";
  return desc;
}

private void do_aua(object liv)
{
  if (living(liv)) liv->AddHp(-3);
}

private void aua()
{
  filter_array(all_inventory(this_object()), #'do_aua);
}

void make_kaputt()
{
  kaputt = 1;
}

void do_entladung(object ab)
{
  string klemme;
  
  klemme = ab->query_klemme();
  switch(klemme) {
    case "am gruenen Stein" :
      message(({ ({ M_ROOM, this_object(), "Mit heftigem Protest schlaegt "
       "der Blitz in den Blitzeableiter ein. Du siehst, wie sich ein "
       "magischer Lichtfleck voellig geraeuschlos, aber dennoch missmutig "
       "durch das Kabel quetscht und schliesslich im gruenen Stein "
       "verschwindet." }) }));
      return;
    case "am Drachenschwanz" :
      message(({  
       ({ M_ROOM, this_object(), "Mit heftigem Protest schlaegt "
          "der Blitz in den Blitzeableiter ein. Der magische Lichtfleck "
          "ueberlegt einen Moment, tritt aber dann doch, widerwillig zwar, "
          "seine Reise durch das Kabel an." }),
       6,
       ({ M_ROOM, this_object(), "Um so erfreuter scheint der Blitz, als "
          "er am Ende des Kabels mit einem lauten 'Plopppppp' auf den "
          "hoelzernen Schwanz des Drachens trifft, welcher sogleich anfaengt, "
          "zum Leben zu erwachen." }),
       6,
       ({ M_ROOM, this_object(), "Wie der Lichtbalken in einem Scanner oder "
          "Kopierer (Aeh?) ueberflutet der Lichtblitz den gesamten "
          "Drachenrumpf. Die vom Licht beruehrten Stellen werden sofort "
          "von Leben durchflutet." }),
       6,
       ({ M_ROOM, this_object(), "Mit einem lauten 'Wumppppppp' springt "
          "der Drachenrumpf schliesslich an Bord." }),
       ({ #'make_drache })
      }));
      return;
    default :
      message(({ ({ M_ROOM, this_object(), "Der Blitz protestiert zunaechst "
        "heftig, als er in den Blitzeableiter einschlagen muss, freut sich "
        "danach aber um so mehr, dass das Kabel am anderen Ende lose ist, "
        "was er durch heftiges Kabelwedeln zum Ausdruck bringt." }),
        2,
        ({ "Das umherpeitschende Kabelende trifft Dich mitten im Gesicht." }),
        ({ #'aua })
      }));
      return;
  }
}

private string stein_long()
{
  if (!kaputt) return "\
Wieder ein Stein (oder ist das der erste, den Du entdeckst? Okay, es gibt \
noch weitere), nur diesmal schimmert er gruenlich. Er ist ueber der Reling \
befestigt und haengt hier einfach so untaetig rum.";
  if (present("\nridu#reserve")) return "\
Hey, das ist gut! Der gruene Ersatzstein schwebt direkt neben dem kaputten \
Stein, der an die Reling montiert ist. So sollte es jetzt fuer Dich ein \
leichtes zu sein, einfach den Stein zu WECHSELN.";
  return "\
Hey, der Stein schimmert ja gar nicht mehr gruen. Auch kein Wabern mehr \
im Stein zu sehen. Nix. Ein kalter, halbdurchsichter Stein. Wenn Du mich \
fragst, sieht der kaputt aus und muss gewechselt werden. Um ganz sicher \
zu gehen, dass der Stein auch wirklich kaputt ist, schaust Du ihn Dir ganz \
genau an. Ha! Und ploetzlich erkennst Du eine Inschrift im Stein, die \
vorher, als der Stein noch grell leuchtete, gar nicht zu erkennen war!";
}

private string inschrift_long()
{
  object ob;

  if (!kaputt) return "\
Der Stein leuchtet viel zu hell. Du kannst nichts erkennen.\n";

  ob = present("\nridu#kiste", RD_TOOLS->load_object(RD_ROOMDIR"innen"));
  if (!ob) {
    ob = clone_object(RD_OBJDIR"kiste");
    ob->move(RD_ROOMDIR"innen", M_NOCHECK|M_SILENT);
  }
  return "In den Stein ist folgendes eingraviert: " +
    ob->query_password() + "\n";
}

void create()
{
  reling::create();
  SetProp(P_INT_SHORT, "Am Heck");
  SetProp(P_RD_STOLPER_CHANCE, 10);   // 10 prozent hier, sonst 5
  SetProp(P_RD_RELING_LONG,  "\
Alles hat ein Ende, auch dieses Schiff. Und genau hier bist Du jetzt, am \
Heck. Eine Treppe fuehrt nach unten in die Kabine. Daneben haengt ein \
Kompass an der Wand. Auch hier siehst Du, mit einer komplizierten Vorrichtung \
befestigt, einen Stein, diesmal einen gruenen. An der Aussenbordwand des \
Hecks erkennst Du Schnitzereien.");
  AddDetails(({
    "richtung", "Der Kompass hat Dir die Richtung doch schon verraten.",
    "blick", "Gut erkannt, und das nur, weil Du so einen scharfen \
Blick hast.",
    "inschrift", #'inschrift_long,
    "treppe", "\
Eine schmale hoelzerne Treppe, nicht mehr als fuenf oder sechs Stufen.",
    "kabine", "\
In der Kabine ist bestimmt ein wertvoller Schatz versteckt, den zu finden, \
vor Dir noch niemandem gelungen ist. Und hier ist auch endlich der \
ersehnte Eingang.",
    "schatz", "\
Ich sagte: IN der Kabine.",
    ({ "stufen", "stufe" }), "\
Keine Besonderheiten zu sehen, lose Bretter, doppelte Boeden, verborgene \
Geheimfaecher, usw.",
    "eingang", "Endlich!",
    ({ "vorrichtung", "komplizierte vorrichtung", "stangen", "system" }), "\
Ein seltsames System aus Stangen, das einerseits den Stein umschliesst und \
andererseits mit der Reling verbunden ist.", 
    ({ "ende", "heck", "schiffsheck" }), "\
An der Aussenwand des Hecks scheint eine komplizierte Schnitzerei \
zu sein.",
    ({ "fluegel", "fuesse" }), "Sie sind aeusserst sorgfaeltig geschnitzt.",
    ({ "dach", "kabinendach" }), "\
Falls man jemals etwas auf oder mit dem Dach machen muesste, so waere hier \
die geeignetste Stelle, denn hier kommt man am besten ran.",
    "stelle", "\
Wenn Du schon weisst, was Du auf das Dach stellen moe... Aeh, ... was Du \
mit dem Dach machen moechtest, dann geht das auf jeden Fall hier prima.",
    "kompass", #'kompass_long,
    ({ "stein", "gruenem stein", "gruenen stein", "gruener stein" }), 
      #'stein_long,
    ({ "bordwand", "aussenbordwand", "schnitzereien", "aussenwand",
       "schnitzerei", "koerper", "drachenkoerper",
       "schwanz", "drachenschwanz", "drache", "drachen", "hinterteil", 
       "hintern", "drachenhintern", "statue" }), #'hintern_long
  }));
  AddDetailAction(
    ({ "dach", "kabinendach" }),
    map_array(CMD_KLETTERN, #'+, " auf <me>") +
    map_array(CMD_KLETTERN, #'+, " <me>"), "kletter_dach",
    "Du findest keinen Halt, um auf das Dach hochzuklettern, das stoert "
    "Dich aber auch nicht weiter. Denn falls Du etwas mit bzw. auf dem "
    "Dach machen muesstest, dann geht das bestimmt auch von hier unten.");
  AddDetailAction(
   ({ "stein", "gruenem stein", "gruenen stein", "gruener stein" }),
   ({ "reibe <me>", "reibe an <me>", "reibe am <me>" }), 
   "reibe_stein", 
   #'reibe_stein
  );
  AddDetailAction(
   ({ "stein", "gruenem stein", "gruenen stein", "gruener stein" }),
   ({ "kratze <me>", "kratze an <me>", "kratze am <me>" }), 
   "kratze_stein", 
   #'kratze_stein
  );
  AddDetailAction(
    "inschrift",
    "lies <me>",
    "lies_inschrift",
    #'inschrift_long
  );

  AddExit("steuerbord", ([ EX_DEST: RD_ROOMDIR"r5",
                         EX_TESTFUNC:#'my_stolper,
                         EX_MSG: "nach Steuerbord" ]));
  AddExit("backbord", ([ EX_DEST: RD_ROOMDIR"r3",
                           EX_TESTFUNC:#'my_stolper,
                           EX_MSG: "nach Backbord" ]));
  AddExit("unten", ([ EX_DEST:RD_ROOMDIR"innen",
                      EX_TESTFUNC:#'my_stolper ]));


  AddCmd(({ "wechsel", "wechsle" }), "do_wechsle");
}

status do_wechsle(string str)
{
  object reserve, ob;

  if (!str || strstr(str, "stein") < 0) {
    notify_fail("Vielleicht willst Du den Stein wechseln?\n");
    return 0;
  }

  if (!kaputt) {
    message("Dazu besteht doch gar keine Notwendigkeit.");
    return 1;
  }

  if (!(reserve = present("\nridu#reserve"))) {
    message("Aber Du hast doch noch gar keinen Reservestein. Den brauchst "
      "Du schon, um den Stein zu wechseln.");
    return 1;
  }

  message(({
    ({ M_SAY, M_PL, "wechselt den defekten Stein und setzt den neuen, "
       "gruenen Stein ein. Der ganze Kram, der an dem neuen Stein hing, "
       "faellt dabei zu Boden." }),
    ({ M_WRITE, "Hey, ist da Magie im Spiel? Das geht ja viel leichter "
       "als Du dachtest. Muehelos loest Du den alten Stein aus der "
       "Vorrichtung und schmeisst ihn ueber Bord. Dann bugsierst Du den "
       "neuen Stein zwischen die Stangen und befestigst ihn dort. Dabei "
       "faellt zwar der ganze Kram, den Du rangehaengt hast, auf den "
       "Fussboden. Aber was soll's. Dafuer ist das Schiff jetzt wieder "
       "fahrtuechtig." }) }));
  RD_LIBDIR"mover"->tell_schiff("Die Schlagseite laesst nach, das Schiff fliegt jetzt wieder "
     "voellig gerade.");

  kaputt = 0;
  RD_LOGGER->do_log("info", "Platten repariert", this_player());
  while(ob = first_inventory(reserve))
    ob->move(this_object(), M_SILENT|M_NOCHECK);
  reserve->remove();
  return 1;
}
