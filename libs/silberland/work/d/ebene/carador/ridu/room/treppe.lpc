#pragma strong_type
#include "../def.h"
#include <verben.h>

inherit RD_ROOM;

status buechse_weg;

void reset_vars()
{
  buechse_weg = 0;
}

private mixed durchwuehle_staub()
{
  if (buechse_weg) {
    message(({
    ({ M_PL_BEST, M_PL_VERB, "durchwuehl", " den Staub." }),
    ({ M_WRITE, "Du findest aber nichts ausser Staub und natuerlich "
       "rauhen Holzbohlen." })
   }));
   return 2;
  }
  buechse_weg = 1;
  clone_object(RD_OBJDIR"buechse")->move(this_object(), M_NOCHECK);
  return ({
    ({ M_PL_BEST, M_PL_VERB, "durchwuehl", " den Staub." }),
    ({ M_WRITE, "Hm, rauhe Holzbohlen, nochmehr rauhe Holzbohlen, "
       "doch da ist noch irgendwas anderes, Du kannst es deutlich fuehlen. "
       "Du zerrst es ersteinmal aus dem Staub, dass man es besser "
       "sehen kann." }),
    ({ M_SAY, M_PL_BEST, "hat anscheinend irgendetwas gefunden." })
  });
}

void create()
{
  ::create();
  SetProp(P_RD_RIDU_AREA,1);
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1),
  SetProp(P_INT_SHORT, "Unter der Treppe");
  SetProp(P_INT_LONG, "\
So, nun hast Du Dich erfolgreich in den kleinen Raum unter der Treppe \
gequetscht und nun frage ich Dich: Hat sich's gelohnt? Denn ausser \
einer dicken Staubschicht sieht Du hier nix weiter.");
  AddDetails(({
    "schritte", "Nein, Du kannst keine Schritte sehen.",
    ({ "bohlen", "rauhe bohlen", "holzbohlen", "rauhe holzbohlen" }), "\
Du kannst sie nicht wirklich sehen, aber angefuehlt haben sie sich wie \
rauhe, ganz normale Holzbohlen ohne doppelten Boden, ohne Geheimfach oder \
was Du sonst noch gerne haettest.",
    "geheimfach", "Ehrlich nicht.",
    "boden", "Der Boden ist voller Staub.",
    "decke", "Die Decke ist... AUTSCH! ... ziemlich niedrig hier drin.",
    ({ "wand", "waende" }), "Ziemlich eng hier drin!", 
    "treppe", "\
Du sitzt drunter. Hoffentlich bricht sie jetzt nicht zusammen. Hoertest \
Du da nicht eben Schritte? SCHWERE Schritte? ...",
    "raum", #'_query_int_long,
    ({ "staub", "schicht", "staubschicht" }), "\
Da ist mit reinem Schauen nichts zu machen. Wenn Du hier naeheres erfahren \
moechtest, so musst Du den Staub schon mal durchwuehlen."
  }));
  AddDetailAction(
    ({ "staub", "schicht", "staubschicht" }), 
    map_array(CMD_DURCHSUCHEN, #'+, " <me>"),
    "durchwuehle_staub",
    #'durchwuehle_staub
  );
  AddExit("raus", RD_ROOMDIR"innen");
  AddRule("glaube <text>", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("glaub <text>", "glaube_fliegen", RD_LIBDIR"mover");
  AddRule("meditier", "meditiere", RD_LIBDIR"mover");
  AddRule("meditiere", "meditiere", RD_LIBDIR"mover");
  AddRule("meditier <text>", "meditiere", RD_LIBDIR"mover");
  AddRule("meditiere <text>", "meditiere", RD_LIBDIR"mover");
  AddErrorMessage("glaub","Moechtest Du vielleicht ans Fliegen glauben?");
  AddErrorMessage("glaube","Moechtest Du vielleicht ans Fliegen glauben?");

  AddSound(DEFAULT_SOUND,
    "Nichts weiter zu hoeren. Oder doch, waren da nicht eben Schritte "
    "auf der Treppe?");
  AddSound("schritte", "Nein, doch nicht.");
  AddSmell(DEFAULT_SMELL, "Es riecht total muffig und staubig hier drin.");
  AddSmell("staub",
    "Der Staub riecht wie ganz normaler "
    "In-Muffigen-Raeumen-Unter-Treppen-Staub, der wiederum fast genauso "
    "riecht wie In-Muffigen-Raeumen-In-Schraenken-Staub.");
}
