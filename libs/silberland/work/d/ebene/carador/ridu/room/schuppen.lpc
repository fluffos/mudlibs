#pragma strong_types
#include "../def.h"
#include <verben.h>

inherit RD_ROOM;

status offen;
status mistgabel_weg;
status korb_weg;
status seil_weg;
status kanne_weg;
status pfluecker_weg;


void make_things()
{
  if (!present("\nridu#spind"))
    clone_object(RD_OBJDIR"spind")->move(this_object(), M_NOCHECK);
}


void reset()
{
  object ob;

  RD_ROOM::reset();

  if (ob=present("apfelpfluecker")) ob->remove();
  if (ob=present("mistgabel")) ob->remove();
  if (ob=present("weidenkorb")) ob->remove();
  if (ob=present("arbeitshemd")) ob->remove();
  if (ob=present("lederstiefel")) ob->remove();
  if (ob=present("milchkanne")) ob->remove();
  if (ob=present("seil")) ob->remove();
  make_things();
  mistgabel_weg = 0;
  korb_weg = 0;
  pfluecker_weg = 0;
  seil_weg = 0;
  kanne_weg = 0;
  if (offen) {
    offen = 0;
    message(({ 
      ({ M_ROOM, RD_TOOLS->load_object(RD_ROOMDIR"koppel"), 
         "Ein ploetzlicher Windzug schlaegt die Tuer zu." }),
      ({ M_ROOM, this_object(), "Ploetzlich schlaegt die Tuer zu." })
    }));
  }
}

private mixed my_out()
{
  if (offen) return 1;
  message("Aber die Tuer ist doch zu.");
}

private mixed my_oeffne()
{
  if (offen) return "Aber die Tuer ist doch schon offen.";
  return ({
    ({ M_PL, M_PL_VERB, "versuch", ", die Tuer zu oeffnen, "
       "doch sie bewegt sich keinen Zentimeter." }),
    ({ M_WRITE, "Scheint zu klemmen, das Mistding." })
  });
}

private string tuer_long()
{
  return "Die Tuer ist " + (offen ? "offen" : "zu") + ".";
}

private mixed my_trete_tuer()
{
  if (offen)
    return ({ ({ M_PL, M_PL_VERB, ({ "trittst", "tritt" }),
                 "gegen die offene Tuer." }) });
  offen = 1;
  return ({ ({ "Als", M_PL, "gegen die Tuer",
    M_PL_VERB, ({ "trittst", "tritt" }), " schwingt sie ploetzlich auf."}),
   ({ M_ROOM, RD_TOOLS->load_object(RD_ROOMDIR"koppel"),
      "Ploetzlich schwingt die Tuer auf." }) });
}

private mixed schliess_tuer()
{
  if (!offen) return "Aber die Tuer ist doch schon zu.";

  offen = 0;
  return ({
    ({ M_PL, "schliesst die Tuer." }),
    ({ M_ROOM, RD_TOOLS->load_object(RD_ROOMDIR"koppel"),
       "Ploetzlich schwingt die Tuer zu." })
  });
}

private string werkzeuge_long()
{
  return "\
Du siehst eine Menge alter landwirtschaftlicher Werkzeuge rumliegen, \
die alle groesstenteils alt und ausgemustert aussehen." +
   (!mistgabel_weg ? " Von ihnen koennte allenfalls die Mistgabel noch \
brauchbar sein." : "");
}

private string mistgabel_long()
{
  if (!mistgabel_weg) return "\
Die Mistgabel sieht zwar alt und ausgemustert aus, koennte aber dennoch \
noch zu gebrauchen sein. Du koenntest sie ja mal nehmen.";
}

private string geruempel_long()
{
  return "\
Schonmal gesehen, wie's vor Haeusern aussieht, wo Geruempel zur \
Abholung durch den Sperrmuell bereit liegt? Genau so sieht das Geruempel hier \
auch aus. Verschiedene alte, zerbrochene Moebel, Bretter, hier und dort \
ein metallisches Glitzern,... Geruempel einfach." + (!korb_weg ? "\
 Aber dennoch aufregend. Fast noch interessanter als das Glitzern findest \
Du einen gebogenen, geflochtenen Henkel, der zwischen den Brettern \
herausguckt." : "");
}

private string henkel_long()
{
  if (korb_weg) return 0;
  return "\
Am anderen Ende des Henkels ist bestimmt noch was dran. Das koennte \
zumindest sein. Denn wer hebt schon einfach nur den Henkel eines Korbes \
auf. Naja, als Du das andere Geruempel anschaust, kommst Du schon \
wieder ins Zoegern. Naja, wenn Du hier noch weiter rumsinnierst, wirst \
Du nicht weiterkommen. Nur Taten fuehren zum Ziel!";
}

private mixed nimm_henkel()
{
  object ob;

  if (korb_weg) return 0;
  korb_weg = 1;
  ob = clone_object(RD_OBJDIR"korb");
  if (ob->move(this_player(), M_GET) < 1) ob->move(this_object(), M_NOCHECK);
  return ({
    ({ M_SAY, M_PL, "zieht etwas aus dem Geruempel heraus. Es ist ein Korb."}),
    ({ M_WRITE, "Du ziehst am Henkel. Du nimmst den Henkel. Ha, und Du hast "
       "Glueck, da haengt noch was am Henkel dran, ein geflochtener "
       "Weidenkorb naemlich." }) 
  });
}

private mixed nimm_gabel()
{
  object ob;

  if (mistgabel_weg) return 0;
  ob = clone_object(RD_WEAPON);
  ob->SetProp(P_GENDER, FEMALE);
  ob->SetProp(P_NAME, "Mistgabel");
  ob->AddId(({ "mistgabel", "gabel" }));
  ob->SetProp(P_SHORT, "Eine Mistgabel");
  ob->SetProp(P_LONG, "Eine alte Mistgabel von Xaver.");
  ob->SetProp(P_WEAPON_TYPE, WT_SWORD);
  ob->SetProp(P_WC, 10);
  ob->SetProp(P_VALUE, 10);
  ob->SetProp(P_DAM_TYPE, DT_SLASH);
  mistgabel_weg = 1;
  if (ob->move(this_player(), M_GET) < 1) ob->move(this_object(), M_NOCHECK);
  return ({ ({ M_PL, M_PL_VERB, "nimm", " die Mistgabel." }) });
}

private string spinnweben_long()
{
  if (seil_weg) 
    return "Dicke, fette Spinnweben. Hier war wohl schon laenger niemand.";
  return "\
Da sind ja die dicksten Spinnweben, die Du seit langem gesehen hast. Die \
sind ja teilweise so dick wie ein Seil. Hey, halt, das sind ja nicht nur \
Spinnweben. Da ist ja auch ein richtiges Seil. Na sowas. Brauchst Du \
zufaellig ein Seil?";
}

private string seil_long()
{
  if (!seil_weg)
    return "Das Seil ist zwar voller Spinnweben, aber Du koenntest es \
dennoch nehmen.";
}

private mixed nimm_kanne()
{
  object ob;

  if (kanne_weg) return 0;
  kanne_weg = 1;
  ob = clone_object(RD_THING);
  ob->SetProp(P_NAME, "Milchkanne");
  ob->SetProp(P_GENDER, FEMALE);
  ob->SetProp(P_SHORT, "Eine Milchkanne");
  ob->AddId(({"kanne", "milchkanne" }));
  ob->SetProp(P_LONG, "\
Eine alte, loechrige Milchkanne, die zu nichts weiter zu gebrauchen ist, \
als dass sie wie eine von Xavers Milchkannen aussieht.");
  ob->move(this_object(), M_NOCHECK);
  if (ob->move(this_player(), M_GET) < 1) ob->move(this_object(), M_NOCHECK);
  return ({ ({ M_PL, M_PL_VERB, "nimm", "eine Milchkanne." }) });
}

private mixed nimm_seil()
{
  object ob;

  if (seil_weg) return 0;
  seil_weg = 1;
  ob = clone_object("obj/seil");
  if (ob->move(this_player(), M_GET) < 1) ob->move(this_object(), M_NOCHECK);
  return ({ ({ M_PL, M_PL_VERB, "nimm", "ein Seil." }) });
}

string _query_int_long()
{
  return break_string("\
Herrjeh, ist es hier drin eng. Der Schuppen sah von draussen viel \
groesser aus. Oder liegt das daran, dass hier alles mit Geruempel und \
Werkzeugen vollgestopft ist? " +
   (present("\nridu#spind") ? "In einer Ecke, dick mit Spinnweben \
zugesponnen, steht ein alter Spind." : "In einer Ecke erkennst Du dicke \
Spinnweben."));
}

private string glitzern_long()
{
  if (kanne_weg)
    return "Nichts weiter, nur ein alter Pflug glitzert durch das Geruempel.";
  return "\
Hey, was liegt da zwischen dem Geruempel? Ein alter Eimer oder eine Kanne \
oder so.";
}

private string kanne_long()
{
  if (!kanne_weg) return "\
Eine alte Milchkanne liegt zwischen dem Geruempel. Wie ueblich koenntest \
Du sie mitnehmen.";
}

private string ecke_long()
{
  string desc;

  if (present("\nridu#spind"))
    desc = "Ein Spind steht in der Ecke, in der Ecke steht ein Spind.";
  else
    desc = "In der Ecke liegen einige zersplitterte Holzteile.";

  if (!pfluecker_weg) desc += " Daneben lehnt ein Apfelpfluecker.";
  return desc;
}

private string pfluecker_long()
{
  if (!pfluecker_weg) return "\
Der Apfelpfluecker sieht durchaus noch brauchbar aus.";
}

private mixed nimm_pfluecker()
{
  object ob;

  if (pfluecker_weg) return 0;
  pfluecker_weg = 1;
  ob = clone_object("std/thing");
  ob->SetProp(P_NAME, "Apfelpfluecker");
  ob->SetProp(P_SHORT, "Ein Apfelpfluecker");
  ob->SetProp(P_GENDER, MALE);
  ob->SetProp(P_WEIGHT, 3000);
  ob->SetProp(P_NOBUY, 1);
  ob->SetProp(P_SIZE, 300);
  ob->SetProp(P_VALUE, 100);
  ob->AddId(({ "pfluecker", "apfelpfluecker" }));
  ob->SetProp(P_LONG, "\
Der Apfelpfluecker besteht aus einer langen Stange mit einem kleinen \
Saeckchen, das am Ende an einem Ring befestigt ist. Mit einem \
Pfluecker kann man auch Aepfel ernten, die hoch oben im Baum haengen, \
aber das hast Du Dir bestimmt schon gedacht.");
  if (ob->move(this_player(), M_GET)<1) {
    ob->move(this_object(), M_NOCHECK);
    return ({ ({ M_PL, M_PL_VERB, "nimm", "einen Apfelpfluecker." }),
              ({ M_WRITE, "Da Du ihn aber nicht mehr tragen kannst, "
                 "legst Du ihn einfach auf den Boden." }) });
  }
  return ({ ({ M_PL, M_PL_VERB, "nimm", "einen Apfelpfluecker." }) });
}

void create() 
{
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "In einem Schuppen");
  SetProp(P_INT_LONG,  "In einem Schuppen");
  AddDetails(({
    "mistding", "Das kannst Du laut sagen! Du aergerst Dich.",
    "zentimeter", "Vergiss es. Nicht einen!",
    ({ "abholung", "sperrmuell", "haeuser" }), "Ein grauenvoller Anblick!",
    "decke", "\
Die Schuppendecke ist wunderbar aufgeraeumt. Keinerlei Geruempel liegt \
dort rum.",
    ({ "boden", "waende", "wand" }), "\
Hier liegt so viel Geruempel rum, dass Du da schon ein bisschen genauer \
sein musst.",
    ({ "pfluecker", "apfelpfluecker" }), #'pfluecker_long,
    ({ "milchkanne", "alten eimer", "eimer", "alte kanne", "kanne" }), 
       #'kanne_long,
    ({ "pflug", "alten pflug", "moebel", "bretter", "holz",
       "teile", "holzteile" }), "\
Absolut unbrauchbar.",
    ({ "metallisches glitzern", "glitzern" }), #'glitzern_long,
    ({ "ecken", "ecke" }), #'ecke_long,
    "seil", #'seil_long,
    ({ "weben", "spinnweben" }), #'spinnweben_long,
    ({ "menge", "werkzeug", "werkzeuge" }), #'werkzeuge_long,
    ({ "gabel", "mistgabel" }), #'mistgabel_long,
    "geruempel", #'geruempel_long,
    "schuppen", #'_query_int_long,
    "tuer", #'tuer_long,
    ({ "geflochtenen henkel", "gebogenen henkel", "henkel" }), #'henkel_long
  }));
  AddDetailAction(
    ({ "pfluecker", "apfelpfluecker" }), 
    map_array(CMD_NEHMEN, #'+, " <me>"),
    "nimm_pfluecker",
    #'nimm_pfluecker
  );  
  AddDetailAction(
    ({ "milchkanne", "kanne", "eimer", "alte kanne", "alten eimer" }), 
    map_array(CMD_NEHMEN, #'+, " <me>"),
    "nimm_kanne",
    #'nimm_kanne
  );  
  AddDetailAction(
    ({ "seil" }), 
    map_array(CMD_NEHMEN, #'+, " <me>"),
    "nimm_seil",
    #'nimm_seil
  );  
  AddDetailAction(
    ({ "gabel", "mistgabel" }), 
    map_array(CMD_NEHMEN, #'+, " <me>"),
    "nimm_gabel",
    #'nimm_gabel
  );  
  AddDetailAction(
    ({ "geflochtenen henkel", "gebogenen henkel", "henkel" }), 
    map_array(CMD_NEHMEN, #'+, " <me>") + 
    ({ "zieh <me>", "ziehe <me>", "ziehe an <me>", "zieh an <me>" }),
    "nimm_henkel",
    #'nimm_henkel
  );
  AddDetailAction(
    ({ "tuer", "tuere" }),
    ({ "oeffne <me>", "schiebe <me>", "drueck <me>",
       "druecke <me>", "schieb <me>", "schiebe <me> auf",
       "mach <me> auf", "mache <me> auf",
       "schieb <me> auf", "drueck <me> auf", "druecke <me> auf" }),

    "oeffne_schuppen",
    #'my_oeffne
  );
  AddDetailAction(
    ({ "tuer", "tuere" }),
    ({ "tritt <me>", "trete <me>", "tritt gegen <me>",
       "trete gegen <me>", "tritt an <me>", "trete an <me>" }),
    "trete_tuer",
    #'my_trete_tuer
  );
  AddDetailAction(
   ({ "tuer", "tuere" }),
   ({ "schliess <me>", "schliesse <me>", "mach <me> zu",
       "mache <me> zu" }),
   "schliess_tuer",
   #'schliess_tuer
  );
  AddExit("raus", ([ EX_DEST : RD_ROOMDIR"koppel",
                     EX_TESTFUNC : #'my_out ]));
  make_things();
}

void toggle_offen()
{
  offen = !offen;
}

status query_offen()
{
  return offen;
}


