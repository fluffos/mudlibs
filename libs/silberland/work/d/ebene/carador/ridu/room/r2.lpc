#pragma strong_types
#include "../def.h"
#include <verben.h>

inherit RD_STDDIR"reling";

status seil_weg;

void reset_vars()
{
  object ob;

  seil_weg = 0;
  
  if (ob=present("\nridu#wildes_rau")) ob->remove();
}

void do_entladung()
{
  object r;
  message(({ ({ M_ROOM, this_object(), "Und die siehst auch ganz "
    "genau, wo der Blitz einschlaegt: Er faehrt volles Rohr in die "
    "dicke Taurolle, die hier haengt." }) }));
  if (present("\nridu#wildes_tau")) return;
  message(({ ({ M_ROOM, this_object(), "Daraufhin entrollt sich sofort "
    "das eine Ende des Taus wie von Geisterhand und faengt an, wie wild "
    "nach Dir zu schlagen." }) }));
  r = clone_object("std/npc");
  r->SetProp(P_NAME, "Tauende");
  r->AddId(({ "\nridu#wildes_tau", "wildes tauende", "wildes ende", 
              "ende", "tau", "tauende" }));
  r->SetProp(P_NAME_ADJ, "wildgeworden");
  r->SetProp(P_ARTICLE,1);
  r->SetProp(P_GENDER, NEUTER);
  r->create_default_npc(4); 
  r->SetProp(P_SHORT, "ein wildgewordenes Tauende");
  r->SetProp(P_HANDS, ({ " mit seinem harten Ende", 30 })); 
  r->SetProp(P_NOCORPSE,1);
  r->SetProp(P_SIZE, 70);
  r->SetAttackChats(30,
    ({ "Das Tauende versucht, Dich einzuwickeln.\n",
       "Das Tauende stellt Dir ein Bein.\n",
       "Das Tauende peitscht Dir mitten ins Gesicht.\n",
       "Das Tauende wickelt sich um Dein Bein.\n",
       "Das Tauende streicht Dir durch's Gesicht.\n",
       "Das Tauende will Seilhuepfen mit Dir spielen.\n"
  }));
  r->SetProp(P_LONG, "\
Das Tauende fliegt und peitscht durch die Luft. Wo immer es hinschlaegt, \
hinterlaesst es eine Spur der Verwuestung.");
  r->SetProp(P_AGGRESSIVE, 1);
  r->move(this_object(), M_NOCHECK|M_SILENT);
}

private mixed nimm_seil()
{
  object s;

  if (seil_weg) return 0;

  seil_weg = 1;

  s=clone_object("/obj/seil");
  if (s->move(this_player(), M_GET) < 0) s->move(this_object(), M_NOCHECK);
  return ({ ({ M_PL_BEST, M_PL_VERB, "nimm", 
               "das Seil aus der Taurolle." }) });
}
 

string tau_long()
{
  if (present("\nridu#wildes_tau")) return "\
Das Tau sieht momentan nicht wirklich friedlich aus.";
  return "\
Eine dicke, schwere Rolle Schiffstau. Zu schwer zum Mitnehmen und eigentlich \
auch unbrauchbar." + (!seil_weg ? 
                 " Aber das Seil, das in der Rolle liegt, sieht gut aus.":"")+
                 "";
}

string seil_long()
{
  if (seil_weg) return 0;
  return "\
Fuer den Fall, dass Du keines hast und mal eines brauchst, koenntest Du es \
mitnehmen. Es is ein stinknormales Seil. Standardausruestung Abenteurer.";
}

private mixed reibe_stein()
{
  if (find_call_out("min_reibeabstand") > -1) {
    message("Autsch! Der Stein ist noch zu heiss zum Anfassen.");
    return 1;
  }
  call_out("min_reibeabstand", RD_MIN_REIBEABSTAND);
  if (interactive(this_player()) &&present("\nridu#ridu", this_object())) {
    message(({ ({ "Als ", M_PL_BEST, "die Finger nach dem Stein",
      M_PL_VERB, "ausstreck", "klopft ", M_PL_DAT_IHM, " Ridu auf die "
      "Finger und ruft: Hey, Pratzen weg!" }) }));
    return 1;
  }
  RD_LIBDIR"mover"->turn(-1);
  return 1;
}

private mixed kratze_stein()
{
  if (interactive(this_player()) && present("\nridu#ridu", this_object())) {
    message(({ ({ "Als ", M_PL_BEST, "die Finger nach dem Stein",
      M_PL_VERB, "ausstreck", "klopft ", M_PL_DAT_IHM, " Ridu auf die "
      "Finger und ruft: Hey, Pratzen weg!" }) }));
    return 1;
  }
  RD_LIBDIR"mover"->kratze_stein(1);  // 1 ist lila
  return 1;
}

void create()
{
  reling::create();
  SetProp(P_INT_SHORT, "Backbord, in Bugnaehe");
  SetProp(P_RD_RELING_LONG,  "\
Dies ist die Backbordseite des Schiffs, nur wenige Schritte vom Bug \
entfernt. Waehrend Du hier auf der schmalen Reling stehst und Dir eine steife \
Brise ins Gesicht weht, weckt ein grosser, lila Stein, der mit einer \
komplizierten Konstruktion ueber der Reling befestigt ist, Dein Interesse. \
Ausserdem haengt an der Kabinenwand eine grosse Taurolle.");
  AddDetails(({
    ({ "brise", "wind", "gesicht", "freiheit", "gefuehl" }), "\
Ahhh, das tut gut. Wenn einem der Wind ins Gesicht weht. Da kommt ein Gefuehl \
von Freiheit auf!",
    ({ "tipp", "tipps", "tip", "tips" }), "Keine Tipps! Die Schreibweise war Tipp genug.",
    "schreibweise", "Nu hoer aber auf!",
    ({ "stein", "lila stein" }), "\
Mit einer Stange ist ein etwas fussballgrosser Stein an der Reling befestigt. \
Er glueht in einem lila Schimmer und Du fragst Dich jetzt natuerlich, was man \
mit dem Stein machen kann. Einen Tipp moechte ich Dir jetzt eigentlich nicht \
unter die Nase >_REIBEN_<, denn ein bisschen was muss man selber auch schon noch \
machen.",
    ({ "schimmer", "schimmern" }), "Schoen, geheimnisvoll, gespenstisch.",
    ({ "rolle", "tau", "taurolle" }), #'tau_long,
    "inschrift", "Der Stein leuchtet zu hell, als dass Du etwas erkennen "
                 "koenntest.",
    "seil", #'seil_long,
    ({ "stangen", "stange", "konstruktion" }), "\
Miteinander verbundene Stangen halten den Stein an der Reling fest.",
    ({ "wand", "kabinenwand" }), "\
Die Taurolle an der Kabinenwand ist auch das Einzige, das interessant \
sein koennte. Vielleicht aber auch nicht, auf jeden Fall ist die Taurolle \
der einzige Gegenstand, der sich an der Wand befindet."
  }));
  AddDetailAction(
    "seil", 
    map_array(CMD_NEHMEN, #'+, " <me>"),
    "nimm_seil",
    #'nimm_seil
  );
  AddDetailAction(
    ({"lila stein", "stein"}), 
    ({ "reibe <me>", "reibe an <me>", "reibe am <me>" }), 
    "reibe_stein", 
    #'reibe_stein
  );
  AddErrorMessage("reibe", "\
Du koenntest Dir die Haende reiben oder aber einfach auch mal am lila Stein.");

  AddDetailAction(
    ({"lila stein", "stein"}), 
    ({ "kratze <me>", "kratze an <me>", "kratze am <me>" }), 
    "kratze_stein", 
    #'kratze_stein
  );
  AddErrorMessage("kratze", "\
Am Kopf kratzen kann auch sehr schoen sein, aber am lila Stein zu kratzen \
macht bestimmt auch Spass.");

  AddExit("vorne", ([ EX_DEST:RD_ROOMDIR"r1",
                      EX_TESTFUNC:#'my_stolper ]));
  AddExit("hinten",([ EX_DEST:RD_ROOMDIR"r3",
                      EX_TESTFUNC:#'my_stolper ]));
}
