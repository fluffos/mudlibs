#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Test W");
  SetProp(P_INT_LONG, "\
Midas W. Franz jagt im komplett verwahrlosten Taxi quer durch Bayern. \
Nach Westen kann man Testmidas verlassen.");
  AddExit("norden", RD_TESTROOMDIR"t1");
  AddExit("westen", RD_HOME"testaus/westaus");
  AddExit("sueden", RD_TESTROOMDIR"t7");
  AddItem("obj/seil", REFRESH_REMOVE);
}
