#pragma strong_type
#include "../def.h"

inherit RD_ROOM;


void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Test NW");
  SetProp(P_INT_LONG, "\
Test NW. Wolkenstart. Dies sind die Testraeume fuer die Wolke zum drin \
Rumfliegen. Spaeter soll sich die Wolke in Midas aufhalten. Genau, und da \
wird sie dann wunderbar rumfliegen koennen.");
  AddExit("westoben", RD_TESTROOMDIR"wo");
  AddExit("osten", RD_TESTROOMDIR"t2");
  AddExit("sueden", RD_TESTROOMDIR"t4");
  AddExit("suedosten", RD_TESTROOMDIR"t5");
}
