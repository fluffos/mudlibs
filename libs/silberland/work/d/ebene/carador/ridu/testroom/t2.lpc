#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Test N");
  SetProp(P_INT_LONG, "\
Test N. Auch dieses hier ist ein wunderschoener Testraum, der viel schoener \
ist als die meisten anderen Testraeume, die es gibt. Denn hier liegt \
Xavers Ausruetung normalerweise rum.");
  AddExit("westen", RD_TESTROOMDIR"t1");
  AddExit("osten", RD_TESTROOMDIR"t3");
}
