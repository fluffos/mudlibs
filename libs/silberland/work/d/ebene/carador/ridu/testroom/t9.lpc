#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Test SO");
  SetProp(P_INT_LONG, "Test SO.");
  AddExit("norden", RD_TESTROOMDIR"t6");
  AddExit("nordwesten", RD_TESTROOMDIR"t5");
  AddExit("westen", RD_TESTROOMDIR"t8");
}
