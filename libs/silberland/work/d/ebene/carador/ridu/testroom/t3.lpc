#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Test NO");
  SetProp(P_INT_LONG, "\
Test NO. Ja, also, ein bisschen Text soll hier schon stehen, denn sonst \
siehts doof aus, wenn man vom Schiff von oben aus runterschaut.");
  AddExit("westen", RD_TESTROOMDIR"t2");
  AddExit("sueden", RD_TESTROOMDIR"t6");
  AddExit("suedwesten", RD_TESTROOMDIR"t5");
}
