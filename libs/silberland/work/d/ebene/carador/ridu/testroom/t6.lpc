#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Test O");
  SetProp(P_INT_LONG, "\
Test O. Oestlich gehts raus aus Testmidas.");
  AddExit("norden", RD_TESTROOMDIR"t3");
  AddExit("osten", RD_HOME"testaus/ostaus");
  AddExit("sueden", RD_TESTROOMDIR"t9");
}
