#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Test Mitte");
  SetProp(P_INT_LONG, "\
Test Mitte. Ein Neger mit Gazelle zagt im Regen nie. Das ist ein wunderschoener Palindrom-Satz, der sich von vorne und von hinten gleich liest.");
  AddExit("nordosten", RD_TESTROOMDIR"t3");
  AddExit("suedosten", RD_TESTROOMDIR"t9");
  AddExit("nordwesten", RD_TESTROOMDIR"t1");
  AddExit("suedwesten", RD_TESTROOMDIR"t7");
}
