#pragma strong_types
#include "../def.h"
#include <lpctypes.h>

inherit RD_THING;
inherit "std/util/pager";
inherit RD_STDDIR"list";


int last_check;
status info_status;

varargs string my_break_string(string str, int width, int indent, int first)
{
  str = break_string(str, width, indent);
  if (first) str = str[indent..];
  return str;
}

status query_info_status()
{
  return info_status;
}

void create()
{
  ::create();
  SetProp(P_NAME, "Reporter");
  SetProp(P_SHORT, "ein RIDU-Reporter");
  AddId(({ "\nridu#reporter", "reporter", "rep" }));
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  AddCmd("rdwho", "do_cmd");
  AddCmd("rdwolke", "do_cmd");
  AddCmd("rdlog", "do_cmd");
  AddCmd("rdtim", "do_cmd");
  AddCmd("rdci", "do_cmd");
  AddCmd("rdtoggle", "do_cmd");
  AddCmd("rdinfo", "do_cmd");
  last_check = time() - 86400;
}

void init()
{
  ::init();
  if (!environment() || !IS_LEARNER(environment())) {
    call_out("remove", 0);
    return;
  }
}

int query_last_check()
{
  return last_check;
}

mixed _query_autoloadobj()
{
  return ([ "last_check" : last_check,
            "info_status" : info_status ]);
}

void _set_autoloadobj(mixed arg)
{
  last_check = arg["last_check"];
  info_status = arg["info_status"];
  call_out("update_logger",0);
}


void update_logger()
{
  if (info_status) RD_LOGGER->add_listener(environment());
  else RD_LOGGER->remove_listener(environment());
}


string create_rdlog_output(string file, int last, int lines_given)
{
  string text, tmp;
  int i, c, bytes, when, max_lines, width;
  string *lines, *line;

  max_lines = lines_given || 20;
  width = 78;

  bytes = file_size(file);
  if (bytes > (80 * max_lines)) bytes = 80 * max_lines;
  text = read_bytes(file, -bytes, bytes);

  lines = explode(text, "\n");
  text = "";

  for (i=sizeof(lines); i--;) {
    line = explode(lines[i], "###");
    if (sizeof(line) < 2)
      text = line[0] + "\n" + text;
    else {
      when = (int)line[1];
      tmp = ctime(when);
      text = my_break_string(tmp[8..9]+"-"+tmp[4..6]+"-"+tmp[22..23]+
         " "+tmp[11..15] + ": " + line[0], width, 2, 1) + text;
    }
    c++;

    if ( ( !lines_given &&
           when &&
           last &&
           when < last
         ) ||
         c > max_lines
       ) break;
  }
  return text;
}


mixed ridu_call_outs(mixed arg)
{
  mixed tmp;
  if (!arg[0] || typeof(arg[0]) != T_OBJECT || 
       getuid(arg[0]) != "d.ebene.carador") return 0;
  tmp = implode(explode(file_name(arg[0]), "/")[<2..], "/");
  if (stringp(arg[1])) return ({ tmp + "->"+ arg[1], arg[2] });
  if (closurep(arg[1]))
     return ({ tmp + sprintf("%O", arg[1]), arg[2] });

  return 0;
}

private string mynam(object ob)
{
  return capitalize(ob->query_real_name());
}

varargs string add_who_in(mixed wo, string rnam)
{
  object r, *liv;
 
  if (!wo) return "";
  if (objectp(wo)) r = wo;
  if (!r && !(r = find_object(wo))) liv = ({});
  else liv = filter_array(all_inventory(r), #'query_once_interactive);
  if (!sizeof(liv)) return "";
  
  if (!rnam) rnam = capitalize(explode(wo, "/")[<1]);

  return sprintf("%:-10s: %-s\n", 
                 rnam, implode(map_array(liv, #'mynam), ", "));
}


status do_cmd(string str)
{
  mixed tmp, tmp2;
  string pattern, logdir;
  string *args;
  int i, j;
  int lines, lines_given;
  mixed *dir;
  mapping cop;
  object tp, pl;
  object *us, wol;
  object env;
  string output;

  output = "";

  switch(query_verb()) {
    case "rdwolke":
      if (!find_object(RD_OBJDIR"wolke")) {
        message("Keine Wolke.\n");
        return 1;
      }
      message(break_string(RD_ROOMDIR"r1"->unt_unten(1) + "\n", 78, 0, BS_LEAVE_MY_LFS));
      return 1;
    case "rdwho" :
      output = output + RD_LIBDIR"karte"->query_karte();
      output = output + add_who_in(RD_ROOMDIR"innen");
      output = output + add_who_in(RD_ROOMDIR"treppe");
      output = output + add_who_in(RD_ROOMDIR"seil_raum");
      wol = find_object(RD_OBJDIR"wolke");
      if (wol) wol = environment(wol);
      if (wol)
        output = output + add_who_in(wol, "Unten");
      output = output + add_who_in(RD_ROOMDIR"pier");
      output = output + add_who_in(RD_ROOMDIR"koppel");
      output = output + add_who_in(RD_ROOMDIR"schuppen");
      break;
    case "rdtoggle" :
      info_status = !info_status;
      update_logger();
      message("Meldungen aus Ridu ab sofort " +
        (!info_status ? "NICHT MEHR " : "") + "anzeigen.\n");
      return 1;
    case "rdtim": 
      last_check = time();
      message("Setze letzten Checkzeitpunkt auf " + 
        ctime(time()) + ".\n");
      return 1;
    case "rdlog":
       logdir = RD_LOGDIR;

       if (!str || str == "-all" || str == "-veryall") {
         if (str == "-veryall") pattern = "*" ;
         else pattern = "*.log";
         dir = get_dir(logdir + pattern,5);
         if (str == "-veryall") dir = dir[4..];
         output = "";
         for (i=0;i<sizeof(dir);i+=2) {
           if ( str == "-veryall" ||
                str == "-all" ||
                last_check < dir[i+1]
              ) output += sprintf("%:-'.'22s%:-'.'25s\n",
                                (str == "-veryall" ? dir[i] : dir[i][0..<5]),
                                ctime(dir[i+1]));
         }
         if (output == "") output = "No files found.\n";
         output += "Last 'rdtim' was on "+ctime(last_check)+ ".\n";
         break;
       }
       if (sizeof(args = explode(str," ")) > 1) {
         lines = (int)args[0];
         lines_given = lines;
         if (lines_given < 0) lines_given = -lines_given;
         str = args[1];
       }

       if (str == "*") {
          output = "";
          tmp = 0;
          dir = get_dir(logdir + "*.log", 5);
          for (i=0;i<sizeof(dir);i+=2) {
            if (last_check >= dir[i+1]) continue;

            pattern = create_rdlog_output(logdir + dir[i],
               last_check, lines_given);

            pattern = "\n\
------------------------------------------------------------------------\n" +
logdir + dir[i] + "\n\
------------------------------------------------------------------------\n" +
                   pattern + "\
------------------------------------------------------------------------\n";
            output = output + pattern;
            tmp = 1;
          }
          if (!tmp) output = "\
No files found. Last 'rdtim' was on "+ctime(last_check)+ ".\n";
          break;
       }

       if (!lines) lines = 20;

       if (file_size(logdir+str+".log")>-1)
          output = logdir+str+".log";
       else {
          if (file_size(logdir+str)>-1)
            output = logdir+str;
          else {
            dir = split_array(get_dir(logdir+str+"*.log",5), 2);
            if (!sizeof(dir[0])) {
               notify_fail("No such file ("+str+").\n");
               return 0;
            }

            if (sizeof(dir[0]) > 1) {
               tmp = 0;
               for (i=sizeof(dir[1]); i--;)
                 if (dir[1][i] > tmp) {
                   tmp = dir[1][i];
                   tmp2 = i;
               }

               write(break_string("Warning: Multiple files possible: " +
                  make_list(dir[0]) + ". Now displaying the newest one: " +
                  dir[0][tmp2] + ".\n", 0, 2, 1));

               output = logdir+dir[0][tmp2];
            }
            else output = logdir+dir[0][0];
          }
       }

       if (!output) {
         notify_fail("No such file ("+str+").\n");
         return 0;
       }

       More("---------- "+output+" ----------\n\n"+
             create_rdlog_output(output, last_check, lines_given));
       return 1;
       break;


    case "rdci" :
      tmp = map_array(tmp2 = call_out_info(), #'ridu_call_outs) - ({ 0 });
      lines = sizeof(tmp2);

      output = "";
      for (i=0; i<sizeof(tmp); i++) {
         if (!tmp[i]) continue;
         tmp2 = ({ tmp[i][1] });
         for (j=i+1; j<sizeof(tmp); j++) {
            if (!tmp[j]) continue;
            if (tmp[i][0] == tmp[j][0]) {
               tmp2 += ({ tmp[j][1] });
               tmp[j] = 0;
            }
         }
         output += break_string(sprintf("%:-30s: ", tmp[i][0]) +
            implode(map_array(tmp2, #'to_string), ", ") + "\n", 78, 2, 1);
      }

      output = "\
----------------- Ridus Call-Out Information ------------------\n\
\n\
      SL: " + lines + " call_outs,\n\
    Ridu: " + (i = sizeof(tmp)) + " call_out" + (i == 1 ? "" : "s") +
      (i ? " (" + (i * 100 / lines) + "%)" : "") +".\n"+
         (output != "" ? "\
\n\
Name_of_ob->Which_function()  : When\n\
-----------------------------------------------------------------\n" +
     output : "");
      break;


#if 0
   case "rdinfo" :
      output = "\
----------------------------- Ridu Information -----------------------------\n";
      if (last_check) {
         dir = get_dir(RD_LOGDIR + "*.log",5);
         args = ({ });
         for (i=0;i<sizeof(dir);i+=2)
            if (last_check < dir[i+1] &&
                dir[i][0..5] != "items_") args += ({ dir[i][0..<5] });
         if (sizeof(args)) output +=
            break_string("Logfiles   : "+make_list(args) + "\n", 78, 2, 1);
      }
      break;
#endif
  }
  if (output) More(output);
  else message("Kein Output.\n");
  return 1;
}
