#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Ausserhalb");
  SetProp(P_INT_LONG, "Ausserhalb von Midas. Weg ZWEI zum Pier.");
  AddExit("suedwesten", RD_HOME"testaus/w3");
  AddExit("norden", RD_HOME"testaus/w1");
}
