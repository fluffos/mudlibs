#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Ausserhalb");
  SetProp(P_INT_LONG, "\
Auf dem Weg zum Bauernhof, welcher noerdlich ist. Oestlich ist eine \
Pferdekoppel.");
  AddExit("osten", RD_ROOMDIR"koppel");
  AddExit("sueden", RD_HOME"testaus/b1");
}

