#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Ausserhalb");
  SetProp(P_INT_LONG, "\
Ausserhalb von Midas. Weg DREI zum Pier. Noerdlich gehts zum Bauernhof.");
  AddExit("westen", RD_HOME"testaus/w4");
  AddExit("nordosten", RD_HOME"testaus/w2");
  AddExit("norden", RD_HOME"testaus/b1");
}
