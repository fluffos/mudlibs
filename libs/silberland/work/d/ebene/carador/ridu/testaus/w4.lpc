#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Ausserhalb");
  SetProp(P_INT_LONG, "\
Ausserhalb von Midas. Weg VIER zum Pier.");
  AddExit("osten", RD_HOME"testaus/w3");
  AddExit("suedwesten", RD_HOME"testaus/w5");
}
