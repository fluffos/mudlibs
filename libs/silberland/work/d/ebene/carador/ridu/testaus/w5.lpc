#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Ausserhalb");
  SetProp(P_INT_LONG, "\
Ausserhalb von Midas. Verteilerraum vorm Pier. NO gehts Richtung Midas. \
SO ist normalerweise Alrik, nach Sueden gehts zum Pier und suedwestlich \
von hier geht's an meinen Strand.");
  AddExit("nordosten", RD_HOME"testaus/w4");
  AddExit("suedwesten", RD_ROOMDIR"pier");
}
