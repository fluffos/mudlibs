#pragma strong_type
#include "../def.h"

inherit RD_ROOM;

void create() {
  RD_ROOM::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT, "Ausserhalb");
  SetProp(P_INT_LONG, "Ausserhalb von Midas. Weg EINS zum Pier.");
  AddExit("nordosten", RD_HOME"testaus/westaus");
  AddExit("sueden", RD_HOME"testaus/w2");
}
