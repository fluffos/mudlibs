// Dieses Ding muss immer geladen sein. Es stellt sicher, dass das Schiff
// losfliegt bzw nach einem Absturz/Questloesen wieder geladen wird

#pragma strong_types
#include "../def.h"

void my_load()
{
  RD_TOOLS->load_object(RD_OBJDIR"wolke");
}

void create()
{
  RD_LOGGER->do_log("info", "Loader wurde geladen");
  call_out("my_load", 0);
}

void reset()
{
  call_out("my_load", 0);
}
