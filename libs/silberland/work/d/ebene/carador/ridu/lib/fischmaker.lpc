#pragma strong_type
#include "../def.h"

inherit RD_STDDIR"message";

object *magic = ({});
object *fischowners = ({});

void reset()
{
  fischowners = ({});  // man kann sich eine pro reset holen
}


object *query_fischowners()
{
  return fischowners;
}

void clean_fischowners()
{
  fischowners = ({});
}

void fisch_magic()
{
  magic -= ({ 0 });
  map_objects(magic, "my_action");
  if (sizeof(magic) && find_call_out("fisch_magic") < 0)
    call_out("fisch_magic", RD_FISCHMAGICABSTAND); 
}

void add_magic(object ob)
{
  magic += ({ ob });
  magic -= ({ 0 });
  if (find_call_out("fisch_magic") < 0)
    call_out("fisch_magic", RD_FISCHMAGICABSTAND);
}

object *query_magic()
{
  magic -= ({ 0 });
  return magic;
}

varargs void fill_inv(object pl)
{
  int i;
  object *inv, r;

  if (!pl) pl = this_player();
  if (!pl) return;
  if (member_array(pl, fischowners) > -1) return;

  r = environment(pl);
  message(({
    2,
    ({ M_ROOM, r, "Ploetzlich quellen unzaehlig viele, kleine Fische aus "
       "dem Maul des grossen Fisches direkt auf ", M_AKK, pl, "." }),
    4,
    ({ M_TARGETS, ({ pl }), "Ihh, ist das eklig, Du bist ueber und ueber "
       "voll mit Minifischen, aus all Deinen Taschen quellen Minifische, "
       "Dein gesamtes Gepaeck ist verseucht mit Fischen." })
  }));
  inv = all_inventory(pl);
  for (i=sizeof(inv); i--;) {
    if (!inv[i]->QueryProp(P_CONTAINER) || inv[i]->QueryProp(P_CNT_STATUS)) continue;
    call_out("fill_container", 0, inv[i]);

  }
  call_out("fill_container", 4, pl);
}

void fill_container(object cont)
{
  int res;
  int count;
  object f;

  if (!cont) return;

  while(res >= 0 && count<20) {
     count++;
     if ( interactive(cont) &&
          member_array(cont, fischowners) < 0 &&
          !random(7) ) {
       fischowners += ({ cont });
       f=clone_object(RD_OBJDIR"magicfisch");   // Der ist magisch!
       f->AddId(({ "\nridu#magicfisch" }));
       add_magic(f);
       f->move(cont, M_NOCHECK);
     }
     f=clone_object(RD_OBJDIR"magicfisch");   // Der ist NICHT magisch!
     res = f->move(cont, M_PUT);
   }
   if (f) f->remove();
}

void tmp_magic()
{
  object f;

       f=clone_object(RD_OBJDIR"magicfisch");   // Der ist magisch!
       f->AddId(({ "\nridu#magicfisch" }));
       add_magic(f);
       f->move(this_player(), M_NOCHECK);

}
