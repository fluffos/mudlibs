#pragma strong_types

#define INVENTORY(ob,id) ((ob)->get_inventory(id) || all_inventory(ob))

private string *num_s = ({ 
  "eins","zwei","drei","vier","fuenf","sechs","sieben","acht","neun",
  "zehn","elf","zwoelf","dreizehn","vierzehn","fuenfzehn",
  "sechzehn","siebzehn","achtzehn","neunzehn" 
});
private string *combnum_s = ({ 
  "ein","zwei","drei","vier","fuenf","sechs","sieben","acht","neun",
  "zehn","elf","zwoelf","dreizehn","vierzehn","fuenfzehn",
  "sechzehn","siebzehn","achtzehn","neunzehn" 
});
private string *num_t = ({ 
  "zwanzig","dreissig","vierzig","fuenfzig","sechzig","siebzig",
  "achzig","neunzig" 
});
private string *ord = ({
  "erst", "zweit", "dritt", "viert", "fuenft", "sechst", "siebt",
  "acht", "neunt", "zehnt", "elft", "zwoelft", "dreizehnt",
  "vierzehnt", "fuenfzehnt", "sechzehnt", "siebzehnt", "achtzehnt",
  "neunzehnt", "zwanzigst"
});

string get_raw_ordinal(int n)
{
  if (n <= sizeof(ord)) return ord[n-1];
  return n + "st";
}

int parse_numeral(string str) {
  int s, t;
  string s_s, s_t;
  if (sscanf(str,"%d%s",s,s_t) == 2 && s && s_t == "")
    return s;
  if (s = member_array(lower_case(str),num_s) + 1)
    return s;
  if (t = member_array(str, num_t) + 1)
    return t*10 + 10;
}

string get_numeral(int n) {
  if (n <= 0)
    return "null";
  if (n > 99)
    return "viele";
  else if (n < 20)
    return num_s[n-1];
  else if (!(n % 10))
    return num_t[(n / 10)-2];
  else
    return combnum_s[(n%10)-1] + "und" + num_t[(n / 10)-2];
  return "viele";
}


int
parse_any_living(mixed result, mixed aux,
                 int first,int last,string *words,string *text)
{
  if ((result=find_living(implode(words[first..last]," "))) &&
      (result->short()))
    return 1;
}


int
parse_number(mixed result, mixed aux,
             int first, int last, string *words, string *text)
{
  result = parse_numeral(implode(words[first..last], ""));
  return (result || (first == last &&
                     (words[first] == "0" || words[first] == "null")));
}

int
parse_words(mixed result, mixed aux,
            int first,int last,string *words,string *text)
{
  result = implode((aux = words[first..last]), " ");
  return 1;
}



int
parse_word(mixed result,mixed aux,int first,int last,
           string *words,string *text)
{
  return (first == last && 
          (result = words[first]) && (aux = text[first*2+1]) && 1);
}





private string strip_id(object ob, string str) {
  string tmp, tmp3;
  int tmp2;

  if (sscanf(str, "%s %d%s", tmp, tmp2, tmp3) == 3 && tmp3 == "" &&
      !ob->id(str))
    return tmp;
  return str;
}


mixed 
my_parse_ob(int first, int last, string *words, object env)
{
  int i,j,c;
  mixed h, ob;
  string name, *w;

  if (first == last)
    switch (words[first])
    {
    case "mich":
    case "mir":
      return ({ this_player(), this_player()->QueryName() });
    }
  else if (first > last)
    return 0;
  else 
    switch (words[first])
    {
    case "mein":
    case "meine":
    case "meinen":
    case "meinem":
    case "meiner":
      if (!env)
        env = this_player();
      else if (env != this_player())
        return 0;
      first++;
      break;
    case "ein":
    case "eine":
    case "einen":
      c = 1;
    case "der":
    case "die":
    case "das":
      first++;
      break;
    case "diese":
    case "diesen":
    case "dieses":
      if (!env)
        env = environment(this_player());
      else if (env != environment(this_player()))
        return 0;
      first++;
      break;
    }
  if (first < last && !c)
  {
    if (c = parse_numeral(words[last]))
      last--;
  }
  name = implode(words[first..last]," ");
  if (h = present(name+(c?" "+c:""),env))
    if (c && h->id(name+" "+c))
      return ({ h,name+" "+c });
    else
      return ({ h,name });
  else if (env == environment(this_player()))
  {
    if (c)
    {
      h = filter_objects((INVENTORY(env,0)) - ({ 0 }),"id",name);
      if (c == sizeof(h)+1)
      {
        if (env->id(name+" 1"))
          return ({ env, name+" 1" });
        else if (env->id(name))
          return ({ env,name });
      }
      else if (c > sizeof(h)+1 && env->id(name+" "+(c-sizeof(h))))
        return ({ env,name+" "+(c-sizeof(h)) });
    }
    else if (env->id(name))
      return ({ env,name });
  }
}

mixed *
parse_ob(int first, int last, string *words, object env)
{
  mixed ob;
  ob = my_parse_ob(first,last,words,env);
  if (!ob || !(ob[0] && ob[1]))
    return 0;
  // Ugh Mar-20-1996
  return ob;
}



private int
parse_object_in_env(mixed r, mixed a, int f, int l, string *w, string *t,
                    object env) {
  mixed ob;
  if (ob = parse_ob(f,l,w,env)) {
    a = strip_id((r = ob[0]),ob[1]);
    return 1;
  }
}

int
parse_in_inventory(mixed r, mixed a, int f, int l, string *w, string *t)
{
  return parse_object_in_env(&r,&a,f,l,w,t,this_player());
}

int
parse_in_environment(mixed r, mixed a, int f, int l, string *w, string *t)
{
  return parse_object_in_env(&r,&a,f,l,w,t,environment(this_player()));
}

int
parse_object(mixed r, mixed a, int f, int l, string *w, string *t)
{
  return
    parse_in_inventory(&r,&a,f,l,w,t) ||
    parse_in_environment(&r,&a,f,l,w,t);
}


int
parse_indirect(mixed r, mixed a, int f, int l, string *w, string *t)
{
  return
    parse_in_environment(&r,&a,f,l,w,t) ||
    parse_in_inventory(&r,&a,f,l,w,t);
}


int
parse_text(mixed result, mixed aux,
           int first,int last,string *words,string *text)
{
  result = implode(text[2*first+1..2*last+1],"");
  aux = text[2*first]; // important for indented 'say' and the like.
  return 1;
}

int
parse_living(mixed result, mixed aux,
             int first,int last,string *words,string *text)
{
  mixed ob, h;
  mixed temp;
  if (!parse_indirect(&ob,&temp,first,last,words,text))
  {
    if (first == last) // Ugh Jun-26-1995
    {
      h = filter_array(INVENTORY(environment(this_player()),0)+
                       INVENTORY(this_player(),0),#'living);
      h = filter_objects(h,"short");
      temp = words[first];
      h = filter_array(h,lambda(({'l}),
                                ({#'&&,
                                  ({#'=,'h,({#'call_other,'l,"QueryName"})}),
                                  ({#'!,({#'strstr,'h,temp})})})));
      if (sizeof(h) == 1)
      {
        result = h[0];
        aux = result->QueryName();
      }
      else
        return 0;
    }
    else
      return 0;
  }
  else if (ob && objectp(ob) && living(ob))
  {
    result = ob;
    aux = temp;
  }
  else
    return 0;
  return 1;
}

status
parse_me(mixed result,mixed aux,
         int first,int last,string *words,string *text)
{
  if (((result=previous_object()) &&
       result->id(aux=implode(words[first..last]," "))) ||
      (parse_object(&result,&aux,first,last,words,text) &&
       result == previous_object()))
  {
    return 1;
  }
}

status
parse_this_me(mixed result,mixed aux,
              int first,int last,string *words,string *text)
{
  if (((result=previous_object()) &&
       result->id(aux=implode(words[first..last]," "))) ||
      (parse_indirect(&result,&aux,first,last,words,text) &&
       result == previous_object()))
  {
    return 1;
  }
}
