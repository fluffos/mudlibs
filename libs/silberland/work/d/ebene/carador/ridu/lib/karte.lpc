#pragma strong_types
#include "../def.h"

void create()
{
  seteuid(getuid());
}

private status mypl(object ob)
{
  return living(ob);
}

string query_karte()
{
  object r, *pl;
  int i,j;
  string text, str;
 
  text = read_file(RD_TEXTDIR"schiff.txt");

  for (i=1; i<=6; i++) {
    r = find_object(RD_ROOMDIR"r" + i);
    if (!r) pl = ({});
    else pl = filter_array(all_inventory(r), #'mypl);
    for (j=0; j<=7; j++) {
      if (j<sizeof(pl))
        str = capitalize(pl[j]->query_real_name()) || "                  ";
      else
        str = "               ";
      
      str = sprintf("%:|11'-'s", str);
      text = implode(explode(text, "R" + i + "Name0000" + (j+1)), str);
    }
  }
  return text;
}

