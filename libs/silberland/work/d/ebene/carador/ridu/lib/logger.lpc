#pragma strong_types
#include "../def.h"

#define MAX_LOGFILE_LENGTH 20000

object *listeners = ({});

void create()
{
  seteuid(getuid());
}

void add_listener(object pl)
{
  listeners -= ({ pl, 0 });
  listeners += ({ pl });
}

void remove_listener(object pl)
{
  listeners -= ({ pl, 0 });
}


string *exclude = ({ "move" });

string *quota_exclude = ({ 
});

private void my_msg(object ob, string txt)
{
  tell_object(ob, break_string(txt,78));
}


varargs void do_log(string file, string text, object pl) 
{
  string path;
  object *list;
  string tmp;

  tmp = ctime(time());
  path = RD_LOGDIR;

  text = (pl ? capitalize(pl->query_real_name()) + " (" + 
                             pl->QueryProp(P_LEVEL) + "), " 
                           : ""
                       ) + text;

  if (file) write_file(path + file + ".log", text + "###" + time() + "\n");
  if (member_array(file, quota_exclude) < 0) {
      if (file_size(path + file + ".log") > MAX_LOGFILE_LENGTH)
       rename(path + file + ".log", path + file + ".log.old");
  }
  if (!file || member_array(explode(file, "/")[0], exclude) < 0) {
  listeners -= ({ 0 });
  filter_array(listeners, #'my_msg, "RIDU:" + 
    (file ? " (" + file+ ")" : "") + ": " + text);
  }
}

void destruct_prevent() {}


void reset()
{
  call_out("destruct_prevent", 0);
}
