string get_random_name()
{
  int i, nr;
  string thename;

  for (i=0; i<100; i++) {
    nr = random(sizeof(my_names));
    thename = lower_case(my_names[nr]);
    if (!MASTER->get_userinfo(thename) && !find_living(thename)) return thename;
  }
}
