#pragma strong_types
#include "../def.h"

string *directions;

void create()
{
  directions = ({ "norden", "nordosten", "osten", "suedosten", "oben",
                  "sueden", "suedwesten", "westen", "nordwesten", "unten" });
}


object load_object(string str)
{
  object ob;

  if (ob = find_object(str)) return ob;
  catch(call_other(str, "_???_"));
  if (ob = find_object(str)) return ob;
}

string program_name(object o)
{ 
  string s;
  s = explode(file_name(o), "#")[0];
  if (s[0..0] = "/"); s[0..0] = "";
  return s;
}      

object present_clone(string str, object env)
{
  object obj;

  for (obj=first_inventory(env);obj;obj = next_inventory(obj)) 
    if(program_name(obj) == str) return obj;
}

string query_reverse_dir(string dir)
{
  int pos;
  pos = member_array(lower_case(dir), directions);
  if (pos<0) return 0;
  return directions[(pos+5)%10];
}


string query_long_dir(string str)
{
  switch (str)
  {
    case "n": return "norden";
    case "s": return "sueden";
    case "w": return "westen";
    case "o": return "osten";
    case "nw": return "nordwesten";
    case "sw": return "suedwesten";
    case "so": return "suedosten";
    case "no": return "nordosten";
    case "ob": return "oben";
    case "u": return "unten";
  }
}
