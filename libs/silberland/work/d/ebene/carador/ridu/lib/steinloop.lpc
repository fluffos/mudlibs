#pragma strong_type
#include "../def.h"

object *steine = ({});

object *query_steine()
{
  return steine;
}

void stein_loop()
{
  steine -= ({ 0 });
  filter_objects(steine, "my_action");
  steine -= ({ 0 });
  if (sizeof(steine) && find_call_out("stein_loop") < 0) {
    call_out("stein_loop", RD_STEINMAGICABSTAND); 
  }
}

void add_stein(object ob)
{
  steine += ({ ob });
  steine -= ({ 0 });
  if (find_call_out("stein_loop") < 0)
    call_out("stein_loop", RD_STEINMAGICABSTAND);
}

void remove_stein(object ob)
{
  steine -= ({ ob });
}
