#include "../def.h"

inherit "std/weapon";           // Waffenobjekt


void create()
{
  if (!is_clone(this_object()))
    return;

  ::create();   /* WICHTIG!!! */

  AddId("messer");

  // Name und Geschlecht sind wichtig, jedes Objekt braucht das
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Messer");

  // Kurzbeschreibung fuer die Darstellung im Inventory und in Raeumen
  SetProp(P_SHORT, "Ein Messer");

  // Langbeschreibung des Knueppels (kommt bei "unt knueppel")
  SetProp(P_LONG,
    "An diesem Knueppel kannst Du nichts besonderes erkennen, er ist aus "
    "festem Holz gefertigt und kann als Waffe benutzt werden.");

  // Wert (in Muenzen) und Gewicht (in Gramm)
  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT, 1250);

  // Nun die wirklich Waffenspezifischen Dinge:
  // Waffen- und Schadensarten sind in /sys/combat.h definiert
  SetProp(P_WEAPON_TYPE, WT_KNIFE);      // Stock
  SetProp(P_DAM_TYPE, DT_SLASH);     // stumpfe Schlaege

  /* Die Waffenklasse muss fuer einhaendige Waffen im Bereich
   * zwischen 1 und 200 liegen, fuer zweihaendige muss sie unter
   * 300 sein. Allerding muessen starke Waffen bei der Balance
   * ('finger balance') angemeldet werden. Fuer die Wertewahl
   * laesst man sich am besten von seinem Sponsor oder aber von
   * einem Regionsmagier beraten.
   */
  SetProp(P_WC, 1);

  /* Dieser Wert gibt an, wie gut die Waffe in der Hand liegt. Das
   * wirkt sich im genauen so aus, dass man hier den Prozentsatz
   * angibt, der von P_WC fix auf jeden Angriff kommt. Ein Wert
   * von 30 ist hier Standard, deutlich hoehere Werte muessen bei
   * der Balance angemeldet werden, hoehere Werte als 60 sollten
   * erst gar nicht vorkommen.
   */
  SetProp(P_WC_FIX, 35);

  /* Anzahl der benoetigten Haende, um die Waffe zu zuecken.
   * Waffen mit einer WC groesser 150 sollten auf jeden Fall
   * Zweihaender sein, bei Sonderfaellen bitte direkt an die
   * Balance wenden. Wenn nichts gesetzt wird, ist die Waffe
   * automatisch ein Zweihaender.
   */
  SetProp(P_NR_HANDS, 1);
}

