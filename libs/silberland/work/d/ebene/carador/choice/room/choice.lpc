mixed *dice_symbols = 
   ({ ({ "   ", " * ", "   " }),
      ({ "*  ", "   ", "  *" }),
      ({ "*  ", " * ", "  *" }),
      ({ "* *", "   ", "* *" }),
      ({ "* *", " * ", "* *" }),
      ({ "* *", "* *", "* *" })
   });


