#pragma strong_types
#include "../def.h"

#define SCORES CH_SAVEDIR"scores"
#define MAX_WIN_AND_LOOSE 10

nosave mixed *winners, *loosers;
mixed *scores;
mapping win_and_loose;
int table_money;

private void do_notify_add_money(string name, int amount) {
   int index;

   win_and_loose[name] += amount;
   if (find_call_out("save_me") < 0) call_out("save_me",2);
}


void notify_add_money(string name, int amount) {
   mixed err;

   if (err = catch(do_notify_add_money(name, amount))) {
//      LOGGER->do_log("debug", "choice_scores: " + (string)err);
   }
}


private void do_update_win_and_loose() {
   int si;
   mixed *scores;

   scores = sort_array(transpose_array(
      ({ m_indices(win_and_loose), m_values(win_and_loose) }) ),
      lambda( ({ 'a, 'b }), ({ #'<, ({ #'[, 'a, 1 }), ({ #'[, 'b, 1 }) }) ));

   si = sizeof(scores);
   if (si > MAX_WIN_AND_LOOSE) si = MAX_WIN_AND_LOOSE;

   winners = scores[0..(si-1)];
   loosers = scores[<si..];
}


void update_win_and_loose() {
   mixed err;

   if (err = catch(do_update_win_and_loose())) {
//      LOGGER->do_log("debug", "choice_scores: " + (string)err);
      winners = loosers = 0;
   }
}


void save_me() {
   save_object(SCORES);
}


void create() {
   seteuid(getuid());
   restore_object(SCORES);
   if (!scores) scores = ({ });
   if (!win_and_loose) win_and_loose = ([]);
   call_out("update_win_and_loose", 0);
}


void set_scores(mixed *arg) {
   scores = arg[0..];
   save_me();
}

mixed *query_scores() {
   return scores[0..];
}

void set_table_money(int arg) {
   table_money = arg;
   win_and_loose["Der Tisch"] = arg;
   save_me();
}

int query_table_money() { 
   return table_money;
}


string print_scores() {
   int i;
   string desc, ranking;
   int last_score;

   desc = "\
 +--------------------------------+\n\
 |Die besten QUAL DER WAHL Spieler|\n\
 +------+------------------+------+\n\
 |Platz |Name              |Punkte|\n\
 +------+------------------+------+\n";
   last_score=0;
   for (i=0; i<sizeof(scores); i++) {
      ranking=(last_score!=scores[i][5]?sprintf("%2d.",(i+1)):"   ");
      desc += sprintf(" |%s   |%:-15s   |%6d|\n",
         ranking, scores[i][0], scores[i][5]);
      last_score=scores[i][5];
   }
   return desc + "\
 +------+------------------+------+\n";
}


string print_win_and_loose() {
   int i, max, sl;
   string desc, tmp_str;
   status verbose;


   max = sizeof(winners);
   if ((sl = sizeof(loosers)) > max) max = sl;

   if (!max) return "Leer.\n";

   verbose = this_player() && 
             IS_WIZARD(this_player());

   desc = "\
--------------------------------------------------------------------------\n\
         Die meisten Muenzen gewonnen und verloren haben...\n\
--------------------------------------------------------------------------\n\
\n\
Platz       Name           Gewonnen     Platz       Name           Verloren\n\
---------------------------------------------------------------------------\n";

   for (i=0; i<max; i++) {
      if (i < sizeof(winners) &&
          winners[i][1] > 0
         ) {
         tmp_str = sprintf("%2d. %:'.'-23s.%'.'7d     ",
            (i+1), capitalize(winners[i][0]), 
            winners[i][1]);
      }
      else tmp_str = "                                        ";
      if (i < sizeof(loosers) &&
          loosers[sl-i-1][1] < 0
         ) {
         tmp_str += sprintf("%2d. %:'.'-23s.%'.'7d",
            (i+1), capitalize(loosers[sl-i-1][0]), 
            -loosers[sl-i-1][1]);
      }
      if (tmp_str != "                                        ")
         desc += tmp_str + "\n";
   }
   return desc + "\
---------------------------------------------------------------------------\n";
}
