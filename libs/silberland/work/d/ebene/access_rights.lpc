/*
 * access_rights.c
 * Hier werden die Zugriffsrechte fuer die Region Ebene verwaltet.
 *
 * Letzte Aenderung: Woody, 12.2.2001 [auf neues system vorbereitet]
 *
 */

int access_rights(string name, string file, int readflag, int def, string fun)
{
  string *s;
  int n;

#define DEBUG
#ifdef DEBUG
  if (find_player("woody") && find_player("woody")->QueryProp("debug"))
    tell_object(find_player("woody"),
        sprintf(" * ebene::access_rights: %O - %O - %O - %O - %O\n",
          name,file,readflag,def,fun));
#endif

  // Schreiben und Lesen ?
  if (name=="aaliyah" && file[0..12] == "Midas/nikolo/") return 1;
  if (name=="archon" && file[0..22] == "Midas/room/spiele/arco/") return 1;
  if (name=="yara" && file[0..15] == "Midas/room/laden") return 1;
  if (name=="yara" && file[0..15] == "Midas/room/tierhandlung") return 1;

  // Lesezugriff ?
  if (readflag) {
    if (name=="rage") return 1;
    if (name=="anatol") return 1;
    if (name=="clementine" && file[0..10] == "Silberwald/") return 1;
    if (name=="d.event" && file == "Midas/room/bank/sbank") return 1;
    if (name=="gwenshara" && s[0]=="ronja") return 1;
    if (file[0..5]=="anatol") return 1;
    return def;
  }

  name=lower_case(name);
  s=explode(file,"/");

  // In +ebene (incl. access_rights.c) selbst duerfen nur RMs was tun. Punkt.
  if ((n=sizeof(s)) < 2) return 0;

  // Iwo darf Lamuerte's Burg editieren
  if (name=="iwo" && s[0]=="lamuerte" && s[1]=="burg")
    return 1;

  // Gwenshara hat Rechte auf die Feenquest
  if (name=="gwenshara" && s[0]=="ronja" && s[1]=="feenquest")
    return 1;

  /*
  // Ronja gibt es nicht mehr...
  if (name=="ronja" || name=="debugger")
  {
    // Ronja darf in Midas das Rathaus verwurschteln :)
    if (s[0]=="Midas")
    {
      if (n<3) return def;      // damit s[2] nicht buggt...
      if (s[1]=="npc")
      {
        if (s[2][0..4]=="albin") return 1;
        if (s[2][0..4]=="beamt") return 1;
      }
      if (s[1]=="room")
      {
        if (s[2][0..6]=="rathaus") return 1;
        if (s[2][0..4]=="kaese") return 1;
        if (s[2][0..6]=="room_f3") return 1;
        if (s[2][0..6]=="room_g3") return 1;
      }
      return def;
    }
    // Ausserdem darf sie diverse Objekte in +ebene editieren
    if (s[0]=="obj" && s[1]=="div") return 1;
    // Und um Rohkopfrex kuemmert sie sich auch noch!
    if (s[0]=="rohkopfrex") return 1;     // der kommt wohl eh nie wieder :(
  }
  */

  // Archon darf sein Spiel 'Arco' natuerlich editieren
  if (name == "archon" &&
      s[0] == "Midas" && s[1] == "room" && s[2] == "spiele" && s[3] == "arco")
    return 1;

  return 0;
}

