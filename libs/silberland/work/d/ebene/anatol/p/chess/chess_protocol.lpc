 /* 
  * Unbekanntes Brettspiel, keine Ahnung wer das erfunden hat...
  *
  *                 .         ,       __       oo       _+
  *        |~       /)       (+       II       ()       [] 
  *     -----------------------------------------------------
  *     --     see chess.h for full header information.    --
  *
  * Das Ueberbleibsel einer Schachpartie... das Protokoll
  *
  * Fuer Dual Mode angepasst - sollte im MG (kein std/food, pfffh)
  * und SL tun.
  *
  */

#pragma strict_types

#include <properties.h>
#include <wizlevels.h>

#ifndef P_NOREST
inherit "/std/thing";
#else
#include <food.h>
inherit "/std/food";
#endif

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"partieprotokoll", "protokoll", "formular","partieformular",
        "durchschlag","\a\n\a\tol_protokoll"}));

  SetProp(P_NAME,"Partieprotokoll");
  SetProp(P_LONG,
    SetProp(P_SHORT,"Der Durchschlag eines unbeschriebenen Partieprotokolls")
    +".");
  SetProp(P_VALUE,0);
  SetProp(P_INFO,
      "Du kannst den Durchschlag uebrigens einfach aufessen.\n"
      "Sonderlich nahrhaft ist er allerdings nicht.\n");
  SetProp(P_MATERIAL,([MAT_PERGAMENT:100,MAT_MISC_FOOD:100]));
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER,NEUTER);
#ifndef P_NOREST
  SetProp(P_LOG_FILE,"report/anatol.rep"); // Boings Wunsch :)
  AddCmd(({"iss","esse","verspeis","verspeise"}),"cmdIss");
#else
  SetProp(P_FOOD_STATE,F_RAW);
  SetProp(P_FOOD_INFO,([
     F_SOAK:1,
     F_MSG: "Du fuehrst den Zettel auf elegantem Wege dem Kreislauf "
           "der Natur zu.\n",
     F_MSG_ROOM: "verspeist einen kleinen Zettel. Wohl bekomm's!\n"
   ]));
#endif
}

#ifndef P_NOREST

nosave int cmdIss(string what) {
  if (!this_player()) return 0;
  notify_fail("Was moechtest Du essen?\n");
  if ((!what)  || (!id(what))) return 0;
  notify_fail("*aechz* Nein, das passt einfach nicht mehr in Deinen Magen.\n"); 
  if (((this_player()->QueryProp(P_FOOD)) >=
       (this_player()->QueryProp(P_MAX_FOOD))) 
       && (!IS_LEARNER(this_player())))
    return 0;
  write("Du fuehrst das Partieprotokoll auf elegantem Wege dem ewigen "
          "Kreislauf zu.\nNaja, Du hast schon besseres gegessen...\n");
  say(break_string("*haps* "+this_player()->Name(WER)+
              " verspeist einen kleinen Zettel.",78));
  remove();
  return 1;
}

#endif

public void InitValues(string * protocol) {
  SetProp(P_SHORT,"Ein Schach-Partieprotokoll vom "+dtime(time())[5..16]+
      ", "+protocol[0]+" gegen "+protocol[1]);
  SetProp(P_LONG,break_string(
        sprintf("Das ist ein Durchschlag des Protokolls einer "
      "Schachpartie %s%s gegen %s, die am %s beendet wurde. Du kannst das "
      "Protokoll (natuerlich) lesen.", (protocol[3]?
        sprintf("(gespielt Blitz %d + %d) ",protocol[3][0],protocol[3][1]):""),
      protocol[0],protocol[1], 
      dtime(time())[5..16]),77));
  SetProp(P_READ_MSG, protocol[2]);
}
 

