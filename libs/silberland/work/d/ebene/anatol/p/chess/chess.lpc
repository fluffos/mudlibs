/* Da das Betatesten in anderen Muds stattfindet (ohne dass der Code da
 * herumliegt, natuerlich), muss gegebenenfalls auf MG-Libs angepasst werden.
 * Das "Neue Lichtsystem" machte Aerger, manche Properties gibt es nur im
 * Silberland usw... */

#ifndef P_NOREST
#define MGLIB
#define P_NOQUIT        "nq"
#define P_NOREST        "nr"
#define P_ENVIRONMENT   "env"
#define ENV_TEMPERATURE "e_te"
#define ENV_TERRAIN     "e_tr"
#define TT_OTHER        "tto"
#endif

/**************************************************************************/
/* In aktuelleren MG-Libs macht das enorme Probleme: In Objekten und 
 * Raeumen wird die Lichtlevelgeschichte in gleichen Properties komplett 
 * different gehandhabt. Wer std/thing und std/room gleichzeitig inheritet, 
 * verschafft sich maechtig Aerger. Also *seufz* laufen wir drumherum und 
 * holen nur std/thing/moving hinzu. Reicht ja auch. :)
 */

inherit "/std/thing/moving";
inherit "/std/room";

/**************************************************************************/
/**************************************************************************/

/* Farb- und Figurenschemata werden vom create() aus gesetzt und
 * koennen zur Not von Hand neuinitialisiert werden. Den Variablen-
 * Inhalt holt sich das Schachbrett aus einem anderen Objekt (s.o.). */

private nosave mixed * color_schemes; // Wird im create() belegt.
private nosave mixed * style_schemes; // Wird im create() belegt.

private nosave int last_update_time;

/* In 'board' wird das aktuelle Spielfeld gespeichert. Dies sind 
 * zunaechst 8 Integer fuer die 8 Zeilen, dann noch eine Integer
 * fuer weitere Infos, die das Spielfeld auszeichnen: Noch moegliche
 * Rochaden. Fuer ein Stellungsremis (dreimal dieselbe Stellung 
 * erreicht) sind diese Koenigsmaetzchen naemlich auch von Bedeutung. 
 * *seufz* */

private nosave int * board;

/* Ein paar Infos, die immer doppelt vorhanden sind, der Einfachheit
 * halber jeweils in eigenen Variablen und nicht als Mapping. Fragt
 * sich uebrigens, ob ein Mapping (oder ein Array) ueberhaupt besser
 * waere... sicher bin ich mir da naemlich nicht. :) */

private nosave string * player;         /* Die Namen der Spieler          */
private nosave object * player_ob;      /* Objektverweise auf die Spieler */
private nosave mixed  * player_info;    /* Farb-/Unterbrechungswunsch     */

/* Time is tickin' awaaaahaaaay.... die Variablen fuer das Handhaben
 * der Uhr, den groessten Feind aller Schachspieler. */

private nosave int clock_time;          /* Letztes Schalten               */
private nosave int clock_switch;        /* Schalterposition               */
private nosave int * clock_blitz;       /* Blitzschachinfos, falls vorh.  */
private nosave int * clock_pl;          /* Endlich die Zeiten der Spieler */

/* Spielbezogene globale Variablen wie Spielzustand, Spielzuege, das Array
 * fuer die Positionen (wie will man sonst Stellungsremis erkennen) und 
 * solcher Kram.... */

private nosave int     game_status;     /* Spielzustand, GS() / SET_GS()  */
private nosave int     game_endtype;    /* Art des Spielendes             */
private nosave int *   moves;           /* getane Spiel(halb)zuege        */
private nosave mixed * positions;       /* Positions-Speicher fuer Remis  */
private nosave mixed * game_protocols;  /* Partie-Formulare (normal/alg)  */

private nosave string * listener;       /* Fernzuhoerer....               */

/* Die EINZIGE nicht-nosave-Variable: Nur fuer Save/Restore verwendet...  */

mixed * sg; // "save game" 
 
/**************************************************************************/

/* Keine Shadows auf das Schachspiel... */

public int query_prevent_shadow() { return 1; }

/* Die Blueprint muss bleiben, wo sie ist, da sonst keine Clones 
 * mehr erzeugt werden koennen. */


varargs int move(mixed dest, int method) {
  if (!is_clone(this_object())) {
    write("Nimmst Du wohl die Finger von der blueprint!\n");
    return -1093; 
  }
  else return ::move(dest, method);
}


/* Die Funktion, die man in Raeumen, die nicht ausgelagert werden 
 * sollen, ueberschreibt. Allerdings muss clean_up() auch im Raum, 
 * in dem sich dieser hier spaeter befinden wird, ebenso geartet 
 * sein... 
 * Das Brett ist zwischenzeitlich ein Clone geworden. Macht das hier
 * noch Sinn? Naja, schaden wird es wohl nicht... ]:-) */

public int clean_up(int ref) { return 1; }

/* Sollte der Raum wider Erwarten doch zerstoert werden, hoffen wir, 
 * dass remove() vorher aufgerufen wird - und wir ein moeglicherweise
 * laufendes Spiel sauber beenden (und speichern) koennen. 'here make'
 * ist damit nicht mehr so tragisch :o) */

public int remove() {
  if ((GS(GS_RUNNING))||(GS(GS_CONT))) {
    TRACELOG(sprintf("SUSPEND (remove()) (%O)",this_player()));
    endGame(1);
  }
  return room::remove();
}

/* Da wir die Logfiles ab und an noch brauchen - fuer die Mud-ELO-Erstellung
 * beispielsweise (was waere ich ohne Todo-Liste?) - koennen/wollen wir es
 * uns im Zweifelsfall nicht erlauben, Daten durch Logfilerotation oder 
 * Kasperkram eines Kollegen in /log zu verlieren. Eigentlich waere diese
 * Routine ein Kandidat fuer ein globaleres Modul, aber da das Schachspiel 
 * zunaechst mal in sich abgeschlossen sein soll... 
 * writelog() loggt automatisch nach pfad + <file>.log und haelt alle
 * Backups in <file>.<n>. Das heisst: Aktive Logs enden immer auf .log, 
 * inaktive auf .old oder eine Ziffer (ohne ".log." zu enthalten).
 * Wird als size_to_break 0 angegeben, wird die MAX_CHESSLOG_SIZE angenommen,
 * negativer Wert bedeutet: Nie rotieren (take care, mein persoenlicher 
 * Rekord: Ein 77 MB Logfile). */



private nosave varargs int writelog(string file, string log_txt, 
    int total_backups, int size_to_break) {
  int i;
  mixed st;

  if (total_backups==0) total_backups=1;  // default: 1 backup 
  if (total_backups<0) total_backups=0;   // negativ == 0
  if ( (size_to_break >= 0) && 
      (sizeof(st = efun::get_dir(file+".log",2))) && 
      (st[0] >= (size_to_break?size_to_break:MAX_CHESSLOG_SIZE))) {
    if (!total_backups)
      catch(rm(file));
    else {
      for (i=total_backups;i--;)
        catch(rename(sprintf("%s.%d",file,i),sprintf("%s.%d",file,i+1)));
      catch(rename(file+".log",sprintf("%s.%s",
              file,(total_backups>1?"1":"old") )));
    }
  }
  write_file(file+".log",log_txt); 
}
 
/* Ausgaenge werden keine angezeigt. */

public string GetExits() { return ""; }

#ifndef MGLIB

/* Die Umgebung ist die Umgebung der Umgebung, 
 * wenn es eine umgebende Umgebung gibt. 
 * Problem: Spells, die die Umgebung beeinflussen, wirken nicht. */ 

public mapping _query_environment() {
  if (environment(this_object()))
    return (mapping)(environment(this_object()))->QueryProp(P_ENVIRONMENT);
  else 
    return Query(P_ENVIRONMENT);
}

#endif 

/* Im Heart-Beat, sofern aktiviert, werden auch einige Dinge erledigt. */

public void heart_beat() {
  int i;
   
  /* heart_beat() aus, wenn gar keine Partie laeuft! */

  if (!GS(GS_RUNNING))
    return (void)set_heart_beat(0);

  /* Wenn die Uhr abgelaufen ist, wird das Spiel beendet. */

  if (getTime(PLAYING,0)<=0) {
      doMessage("Die Klappe der Uhr faellt, "+player[PLAYING]+
          " hat die Partie verloren.");
      game_endtype=CET_TIMEOUT;
      player_info[1]=1+PLAYING;
      endGame();
    }
  else 
    checkOnSuspend(-1);
  return;
}

/* Netztote werden bedingungslos rausgeworfen. Ho:ecker, Sie sind RAUS!! */
 
public void BecomesNetDead(object pl) {
  if ((!objectp(pl))||(environment(pl)!=this_object())) return;
  pl->move(environment(this_object()),M_GO,
   "","kippt netztot zur Seite und bleibt neben dem Schachbrett liegen",
   "kippt netztot zur Seite und bleibt neben dem Schachbrett liegen");
  checkOnSuspend(-1);
}

/* Abhaengig vom Kontext werden andere Befehle angezeigt. */

nosave string detailBefehle() {
  string s;

  if (!this_player()) return "";
  s="----------------------------------------------------"
   "-----------------------\n";

   s+="\"spiel\"                              - Anzeige des Schachbretts\n"
      "\"spiel anzeige [<opt> [<x>]]\"        - Anzeige/Aendern der "
      "Einstellungen\n";
   if (environment(this_player())!=this_object()) {
     if ((!GS(GS_RUNNING))&& (!GS(GS_CONT)) && (sizeof(presentLivings())<2))
     s+="\"setze an schachbrett\"               - Auf ans Schachbrett!\n";
   }
   else {
     if ((!GS(GS_RUNNING))&&(!GS(GS_NOTHING))&&(!GS(GS_CONT)))
       s+="\"spiel aufraeumen\"                   - Schachfiguren wegpacken\n";
     if (GS(GS_ENDED) || GS(GS_NOTHING))
       s+="\"spiel aufstellen [blitz <m> + <s>]\" - Schachfiguren aufstellen\n";
     if (GS(GS_PREPARED))
       s+="\"spiel farbe <wahl>\"                 - weiss|schwarz|zufall|"
         "egal\n";
     if (((GS(GS_READY))||(GS(GS_CONT))) && 
         (this_player()==player_ob[NPLAYING]))
       s+="\"spiel freigeben\"                    - *DU* musst die Uhr "
         "starten!\n";
     if ((GS(GS_RUNNING))||(GS(GS_CONT))) {
       s+="\"spiel unterbrechen\"                 - spaeter weiterspielen "
         "wollen\n"
          "\"spiel aufgeben\"                     - Spiel verloren geben\n";
       if (this_player()==player_ob[PLAYING]) {
         if ((sizeof(moves)) && (QMV_WANT_REMIS(moves[<1]))) {
           s+="\"zug remis\"                          - Remis annehmen\n";
           s+="\"zug <spielzug>\"                     - Ziehen\n";
         }
         else 
           s+="\"zug <spielzug> [remis]\"             - Ziehen, ggf. Remis "
           "vorschlagen\n";
       }
     }
   }
   s+= "----------------------------------------------------"
       "-----------------------\n";
  return s;
}

/* Raumaussenkurzbeschreibung */

public string short() {
  object * pls;

  pls=presentLivings();
  if ((!this_player())||(environment(this_player())!=environment()))
    return "Ein altes Schachbrett.\n";

  switch (sizeof(pls)) {
    case 0: return "Ein altes Schachbrett.\n";
            break;
    case 1: return break_string("Ein altes Schachbrett, vor welchem "+
            (string)pls[0]->name(WER)+" sitzt.",77);
            break;
    case 2: return break_string("Ein altes Schachbrett, vor welchem "+
            objectsToString(pls,WER)+" sitzen.",77);
            break;
    default:return break_string("Ein altes Schachbrett, vor welchem "+
            objectsToString(pls,WER)+ "sitzen. DAS SOLLTE EIGENTLICH "
            "___NICHT__ SO SEIN!!",77);
            break;
  }

  return "Ein altes Schachbrett";
}

/* Rauminnenbeschreibung, variiert in Abhaengigkeit vom Zustand des
 * Schachbretts und Position des Betrachters ("finde"-Funktionen). */

public string _query_int_long() {
  string s;
  object * peo;
  
  if (!this_player()) return "";
  if (environment(this_player())!=this_object()) 
    return break_string(
      "Vor langer Zeit wird dieses Schachbrett einmal wirklich edel und "
      "wertvoll ausgesehen haben, denn es ist aus einem schweren Holz "
      "gefertigt, und die sorgfaeltig eingepassten Felder bestehen aus "
      "Obsidian und Perlmutt. Doch das Brett sieht, wie auch die Figuren, "
      "schon stark abgenutzt aus, unzaehlige Meister werden hier schon ihre "
      "Duelle ausgetragen haben. ",77);

  peo=presentLivings()-({this_player()});

  s=sprintf("Du sitzt %s vor einem alten Schachbrett, ",(sizeof(peo)?
        "mit "+objectsToString(peo,WER):"allein"));

  switch (game_status) {
    case GS_NOTHING: s+="und das Brett ward oed und leer. Vielleicht "
      "sollte mal jemand das Spiel aufstellen?";break;
    case GS_PREPARED:s+=sprintf("und jemand hat die Figuren %sauf das Brett "
     "gestellt. %s",clock_blitz?"(wohl in der Absicht, eine "+ 
     getBlitzString(clock_blitz)+" zu spielen) ":"",
     getChosenColors());break;
    case GS_READY:   s+="die Partie kann beginnen und ";
      if (this_player()==player_ob[0])
        s+="Du wirst den ersten Zug haben, da Du 'weiss' "
           "spielst, musst aber noch warten, bis Dein Gegner "
           "die Partie freigibt.";
      else if (this_player()==player_ob[1])
        s+="Du spielst 'schwarz', Dein Gegner wird also den ersten Zug "
           "ausfuehren koennen, sobald Du die Partie freigibst.";
      else 
        s+="... DU SPIELST NICHT MIT? Was tust Du hier?!"; break;
    case GS_CONT:   s+="eine Partie ist aufgestellt, ";
      if (this_player()==player_ob[0])
        s+="Du kannst sie allerdings erst fortfuehren, wenn "
           "Dein Gegner die Partie wieder freigegeben hat.";
      else if (this_player()==player_ob[1])
        s+="Du musst das Spiel wieder freigeben, damit Dein Gegner die "
           "Partie fortsetzen kann.";
      else 
        s+="... DU SPIELST NICHT MIT? Was tust Du hier?!"; break;
    case GS_RUNNING: s+="die Partie ist im Gange und ";
                     if (this_player()==player_ob[PLAYING])
                       s+="Du bist am Zug.";
                     else if (this_player()==player_ob[NPLAYING])
                       s+="Dein Gegner ist am Zug.";
                     else 
                       s+="... DU SPIELST NICHT MIT? Was tust Du hier?!";
                     break; 
    case GS_ENDED:   s+="die aufgestellte Partie ist beendet und wird "
                     "nicht mehr weitergespielt.";
                     break;
    default:         s+="und Anatol sollte sich den Quellcode nochmal "
                     "anschauen... Bug...!";
                     break;
  }
  return break_string(s,75)+detailBefehle();
}

public string long() {
  object *pls;
  string s;

  if (!this_player()) return "";
  s="Vor langer Zeit wird dieses Schachbrett einmal wirklich edel und "
    "wertvoll ausgesehen haben, denn es ist aus einem schweren Holz "
    "gefertigt, und die sorgfaeltig eingepassten Felder bestehen aus "
    "Obsidian und Perlmutt. Doch das Brett sieht, wie auch die Figuren, "
    "sehr stark abgenutzt aus, unzaehlige Meister werden hier "
    "schon ihre Duelle ausgetragen haben. Mit \"spiel befehle\" kannst Du Dir "
    "das Wichtigste anzeigen lassen, mit \"hilfe schach\" wird Dir das "
    "Schachbrett ausfuehrlich erlaeutert, mit \"hilfe schachregeln\" "
    "kannst Du Dir die Regeln fuer das Schachspiel zu Gemuete fuehren.\n";
  pls=presentLivings();

  switch (sizeof(pls)) {
    case 0:  s+="Im Moment sitzt niemand vor dem Schachbrett"; break;
    case 1:  s+="Derzeit sitzt nur "+(string)pls[0]->name(WER)+
                " vor dem Schachbrett"; break;
    default: s+="Derzeit sitzen "+objectsToString(pls,WER)+
            " vor dem Schachbrett"; break;
  }

  if (GS(GS_RUNNING)) 
    s+=" und spielen eine Partie";
  else if (GS(GS_ENDED)) 
    s+=". Auf dem Brett stehen noch die Figuren einer alten Partie";
  s+=".";
  
  return break_string(s,77,0,1);
} 

/* PreventInsert() macht erstmal nix - es kann bei NOCHECK ohnehin
 * keinen wirksamen Einspruch erheben. Aber es sorgt dafuer, dass die
 * Muellabfuhr aktiviert wird. */

public varargs int PreventInsert(object ob) {
  if (find_call_out("cleanUp")==-1)
    call_out("cleanUp",0);
}

/* Details jeder Art, die dieser Raum nicht uebernimmt, werden von der 
 * Umgebung uebernommen. Das geht, der Raum hier hat ja normalerweise
 * einen anderen Raum um sich. Verschiedene Handhabe SL/MG. */

#ifdef MGLIB

public varargs string GetDetail(mixed key, mixed race, int sense) {
  return ((::GetDetail(key, race, sense)) ||
    (environment()?((string)environment()->GetDetail(key, race, sense)):0));
}

#else 

public varargs string GetDetail(mixed key, mixed race) {
  return ((::GetDetail(key, race)) ||
