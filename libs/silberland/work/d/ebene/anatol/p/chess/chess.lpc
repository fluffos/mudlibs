  AddSpecialDetail(({"protokoll","partieprotokoll","zuege","liste",
        "zugliste","partieformular","formular","partieformular"}),
      "detailFormular");
  AddSpecialDetail(({"uhr","uhren","zeit"}),"detailUhr");
  AddSpecialDetail(({"brett","schachbrett","partie","figur",
        "figuren","spiel"}),"detailPartie");
  AddSpecialDetail(({"auf","hoch"}),"detailAuf");
  AddSpecialDetail(({"befehle"}),"detailBefehle");
    
  AddCmd(({"sitz","sitze","setz","setze"}),"cmdSetze"); 
  AddCmd(({"steh","stehe"}),"cmdStehe");
  AddCmd(({"spiel","spiele"}),"cmdSpiel");
  AddCmd("hilfe","cmdHilfe");
  AddCmd("zug","cmdZug");

  last_update_time=0;
  // Vorinitialisierung, falls das andere Objekt gerade nicht ladbar ist.
  color_schemes=({({ ANSI_RED+ANSI_BOLD, ANSI_BLUE+ANSI_BOLD,
       ANSI_BG_WHITE, ANSI_BG_YELLOW, "erprobte Standardeinstellung" })});
  style_schemes=({ ({"        ", "     |' ", " .   /) ", "  ,  (+ ", 
       " __  II ", " oo  () ", " _+  [] ", "Standardschema" })});

  UpdateSchemes();
  listener=({});
  boardInit(1);
  TRACELOG(sprintf("BOARDLOAD %O, %O",this_player(),previous_object()));
          
  
}

/* Ist bei NPCs nicht ganz problemlos, so kann ein NPC fuer den anderen
 * weiterspielen, wenn der vorige verstarb - sobald die Namen uebereinstimmen.
 * Nicht unbedingt sinnig, aber bitte... ;) 
 * Ausserdem werfen wir hier das dritte Rad am Wagen raus. PreventInsert()
 * wird ungluecklicherweise nicht von Lebewesen aufgerufen. Und ZWEI sind
 * fuer ein Schachspiel genug. */

public void init() {
  object * lvs;
  object env;
  int i;
  ::init();

  if ((living(previous_object())) && 
      (environment(previous_object())==this_object())) {

    checkPlayerObjects(this_object());
    
    if (!(env=environment(this_object()))) {
       call_other("/room/void","???");
       env=find_object("/room/void");
    }

    while ((i=sizeof(lvs=presentLivings()))>2) {

       /* Zuerst previous_object() gar nicht erst reinlassen, wenn ueberhaupt
        * keine Partie laeuft oder im den Anfaengen ist.  */

      if (!((GS(GS_RUNNING)) || (GS(GS_READY)) || (GS(GS_CONT)))) {
            tell_object(previous_object(), "Schach spielt man nur zu zweit, "
               "am Brett ist kein Platz mehr fuer dich.\n");
            previous_object()->move(env,M_GO|M_NO_SHOW,0,
                "findet keinen Platz am Brett",
               "moechte sich an das Schachbrett setzen, findet aber keinen "
               "Platz mehr");
            continue; // Und ggf. aus dem while() raus.
      }

        /* Sollte schon eine Partie laufen oder trotz Rauswurfs von 
         * previous_object() noch ein gesellschaftlicher Ueberhang 
         * bestehen, muessen alle Livings durchgegangen werden - und
         * so lange Nicht-Mitspieler rausgeworfen werden, bis nur noch
         * zwei am Tisch sitzen. Das wird explizit KNALLEN, wenn ein
         * Spieler einen Move-Hook gesetzt hat, aber die lieben Kollegen
         * werden damit sicherlich verantwortungsvoll umgehen... ;o) */
        
      for (;i--;) {
        if ((lvs[i]!=player_ob[0]) && (lvs[i] != player_ob[1])) {
          if (lvs[i]==previous_object()) {
            tell_object(previous_object(), "Schach spielt man nur zu zweit, "
               "am Brett ist kein Platz mehr fuer dich.\n");
            lvs[i]->move(env,M_GO|M_NO_SHOW,0,"findet keinen Platz am Brett",
               "moechte sich an das Schachbrett setzen, findet aber keinen "
               "Platz mehr");
          }
          else {
            tell_object(lvs[i],"Ungluecklicherweise ist einer der "
               "Schachspieler ans Brett zurueckgekehrt.\nDa Du mit der "
               "aktuellen Partie eigentlich nichts zu tun hast, gibst Du "
               "Deinen\nPlatz frei und erhebst Dich.\n");
            lvs[i]->move(env,M_GO,0,
                    "gibt "+lvs[i]->QueryPossPronoun(MALE,WEN,SINGULAR)+
                    " Platz auf und erhebt sich",
                    "gibt "+lvs[i]->QueryPossPronoun(MALE,WEN,SINGULAR)+
                    " Platz auf und erhebt sich");
          }
          break;
        }
      }
    }
  }
}

/************************************************************************
 * Raum-Kommandos
 ************************************************************************/


private nosave string getChosenColors() {
  if (!this_player()) return "";
  if (!(player_info[1])) 
    return "Es wurden noch keine Farbwuensche geaeussert.";
  else return 
      (player_info[0]==this_player()
         ?"Du tatst kund, dass "+(player_info[1]=="egal"
             ?"es Dir egal ist, welche Farbe Du spielst"
             :(player_info[1])=="schwarz"||player_info[1]=="weiss"
               ?"Du "+player_info[1]+" spielen moechtest"
               :"Du die Farbenwahl dem Zufall ueberlassen moechtest")
         :(string)player_info[0]->Name(WER)+" verkuendete, dass "+
            (player_info[1]=="egal"
           ?"es "+(string)player_info[0]->QueryPronoun(WEM)+
               " egal sei, welche Farbe "+
               (string)player_info[0]->QueryPronoun(WER)+" spiele"
           :(player_info[1]=="schwarz"||player_info[1]=="weiss"
             ?(string)player_info[0]->QueryPronoun(WER)+" "+player_info[1]+
               " spielen moechte"
             :(string)player_info[0]->QueryPronoun(WER)+
               " die Farbenwahl dem Zufall ueberlassen moechte")))+".";
}

/* Farbwahl daneben ---> Da capo. */

private nosave int colorChooseFail() {
   player_info=({0,0});
   tell_room(this_object(),"Leider schliessen diese Farbwuensche "
       "einander aus. Ihr muesst euch\nauf einen Konsens einigen und "
       "beide noch einmal auswaehlen.\n");
   return 1;
}

/* Farbwahl geglueckt ---> Partie an den Start. */

private nosave int colorChooseSuccess(object * pl) {
  int i;

  player_ob=({pl[0], pl[1]});
  player=({});
  for (i=0;i<2;i++) {
    if (query_once_interactive(pl[i]))
      player+=({capitalize(getuid(pl[i]))});
    else
      player+=({"+"+(string)pl[i]->Name(RAW)});
  }
  if (!clock_blitz)
    clock_pl=({2*60*60, 2*60*60});
  else 
    clock_pl=({clock_blitz[0]*60,clock_blitz[0]*60});
  clock_time=time();
  clock_switch=2;
  player_info=({0,0});

  if (i=restoreGame()) {
    tell_room(this_object(),
     "!! Ihr habt noch eine Partie mit dieser Farbkonstellation offen, !!\n"
     "!!        die ihr sofort wieder aufnehmt und weiterspielt!       !!\n");
    doMessage(sprintf(
            "Partie %s (weiss) gegen %s (schwarz) %svom %s wird wieder "
            "aufgenommen und bei Spielzug %d fortgesetzt.",
        player[0], player[1], (clock_blitz?" - "+getBlitzString(clock_blitz)+
          " - ":""), dtime(i)[5..16],(2+sizeof(moves))/2));
    tell_object(player_ob[NPLAYING],break_string(sprintf(
      "Wenn Du das Spiel wieder freigibst, kann %s die Partie fortfuehren.\n",
      player[PLAYING]),77));
    tell_object(player_ob[PLAYING],break_string(sprintf(
        "Du kannst die Partie fortfuehren, sobald %s die Uhr wieder "
        "in Gang setzt.\n", player[NPLAYING]),77));
    SET_GS(GS_CONT);
  }
  else {
    doMessage(sprintf("Es spielt %s (weiss) gegen %s (schwarz)%s.",
        player[0],player[1],
        (clock_blitz?", "+getBlitzString(clock_blitz) :"")));
    tell_object(player_ob[NPLAYING],sprintf(
      "Wenn Du das Spiel freigibst, kann %s die Partie eroeffnen.\n",
      player[PLAYING]));
    tell_object(player_ob[PLAYING],sprintf(
        "Die Partie beginnt, sobald %s die Uhr in Gang setzt.\n",
      player[NPLAYING]));
    SET_GS(GS_READY);
  }
  return 1;
}

/* ANSI hin, ANSI her, leider unterscheiden sich Farben und Zeichensaetze
 * so massiv, dass man Spielern einfach die Moeglichkeit geben muss, bei
 * einem so ernsthaften Spiel (;)) Farbe und Figuren halbwegs selbst aus-
 * zuwaehlen. 
 * Erschlagen wird hierbei auch der Pulk der verschiedenen Zuganzeige-
 * Mode.
 */

private nosave int doSpielAnzeige(string * args) {
  int i,flags;
  string dummy;

  if (!this_player()) return 0;
  if (!flags=GETPLFLAGS(this_player()))
    SET_PLFLAGS(this_player(),flags=CHESS_DEFAULT_FLAGS);
  if (!sizeof(args)) {
    write(sprintf("Deine Einstellungen sind wie folgt:\n"
      "kurz        - Zugdarstellung Kurzvariante (Protokollnotation)...: %s\n"
      "lang        - Zugdarstellung natuerlichsprachlich...............: %s\n"
      "auto        - Spielfeld nach Spielzug automatisch anzeigen......: %s\n"
      "algebraisch - algebraische Zugdarstellung im Formular/beim Zug..: %s\n"
      "ansi        - Ansi-Farben! (ein, aus oder automatisch)..........: %s\n",
            ((flags&PLF_SHORT_MSG)?"ein":"aus"),
            ((flags&PLF_LONG_MSG)?"ein":"aus"),
            ((flags&PLF_VIEW)?"ein":"aus"),
            ((flags&PLF_NOTATION_TYPE)?"ein":"aus"),
            ((flags&PLF_ANSI_TTY?"auto":(flags&PLF_ANSI_YN?"ein":"aus")))));
    if (flags&PLF_ANSI_YN)
      write(sprintf("farben      - Farbschema:    %s\n"
             "figuren     - Figurenschema: %s\n",
              CSCH(PLCOLOR(flags),CSCH_TEXT),
              SSCH(PLSTYLE(flags),SSCH_TEXT)));
  }
  else if (member(({"kurz","lang","algebraisch","auto","ansi","farben",
          "figuren"}),
        args[0])==-1)
    return fail("Diese Anzeige-Option ('"+args[0]+"') gibt es "
      "nicht. Versuche es mit 'kurz', 'lang', 'auto', 'algebraisch', 'ansi', "
      "'farben' oder 'figuren'",1);
  else if (args[0]=="farben") {
    if (!(flags&PLF_ANSI_YN))
          return fail("Du hast leider kein Terminal, das Ansi-Farben "
              "darstellen kann. Falls doch, solltest Du dies entweder "
              "mit \"stty ansi\" (global) oder zumindest mit "
              "\"spiel anzeige ansi ja\" (betrifft nur das Schachspiel) "
              "bekanntgeben",1);
    else if ((sizeof(args)<2)) {
      write(sprintf("Folgende Farbschemata sind derzeit vorhanden:\n"));
      UpdateSchemes();
      for (i=0;i<sizeof(color_schemes);printSample(i++,PLSTYLE(flags)));
    }
    else if (((sizeof(args)>2))||(sscanf(args[1],"%d%s",i,dummy)!=2)
            ||(dummy!=""))
      return fail("Versuch' es so: spiel anzeige farben [<nr>]",1);
    else if ((i>=sizeof(color_schemes))|| (i<0))
      return fail("So viele Farbschemata gibt es gar nicht",1);
    else if (i==PLCOLOR(flags))
      return fail("Das hast Du bereits so eingestellt",1);
    else {
      write("Ok, neue Farbeinstellung:\n");
      printSample(i,PLSTYLE(flags));
      SET_PLCOLOR(this_player(),i);
    }
  }
  else if (args[0]=="figuren") {
    if (!(flags&PLF_ANSI_YN))
          return fail("Du hast leider kein Terminal, das Ansi-Farben "
              "darstellen kann. Falls doch, solltest Du dies entweder "
              "mit \"stty ansi\" (global) oder zumindest mit "
              "\"spiel anzeige ansi ja\" (betrifft nur das Schachspiel) "
              "bekanntgeben",1);
    else if ((sizeof(args)<2)) {
      write("Folgende Schemata fuer Figuren sind derzeit vorhanden:\n");
      UpdateSchemes();
      for (i=0;i<sizeof(style_schemes);printSample(PLCOLOR(flags),
            i++,1,i%2));
    }
    else if (((sizeof(args)>2))||(sscanf(args[1],"%d%s",i,dummy)!=2)
            ||(dummy!=""))
      return fail("Versuch' es so: spiel anzeige figuren [<nr>]",1);
    else if ((i>=sizeof(style_schemes))|| (i<0))
      return fail("So viele Schemata fuer Figuren gibt es gar nicht",1);
    else if (i==PLSTYLE(flags))
      return fail("Das hast Du bereits so eingestellt",1);
    else {
      write("Ok, neue Figureneinstellung:\n");
      printSample(PLCOLOR(flags),i,1);
      SET_PLSTYLE(this_player(),i);
    }
  }
  else if ((sizeof(args)<2) ||
      ((member(({"an","ein","aus","0","1"}),args[1])==-1) &&
      (args[1]!="auto")&&(args[0]!="ansi")))
    return fail("Syntax: spiel anzeige kurz ein|aus\n"
                "        spiel anzeige lang ein|aus\n"
                "        spiel anzeige auto ein|aus\n"
         "(Mindestens eine dieser drei Darstellungsweisen muss eingeschaltet "
         "sein)\n"
                "        spiel anzeige ansi ein|aus|auto\n"
                "        spiel anzeige algebraisch ein|aus\n"
                "Alles klar? Fein",1);
  else {
    if (member(({"an","ein","1"}),args[1])!=-1) i=1;
    else i=0;
    switch (args[0]) {
      case "kurz":
        if (!i) {
          if (!(flags&PLF_SHORT_MSG)) 
            return fail("Du hast die kurze Zugdarstellung bereits "
                  "ausgeschaltet",1);
          else if (!(flags&(PLF_LONG_MSG|PLF_VIEW)))
            return fail("Du musst mindestens eine der drei Anzeigearten "
              "eingeschaltet lassen",1);
          write("Kurze Zugdarstellung ausgeschaltet.\n");
          UNSET_PLFLAG(this_player(),PLF_SHORT_MSG);
          UNSET_PLFLAG(this_player(),PLF_NOTATION_TYPE);
        }
        else {
          if (flags&PLF_SHORT_MSG)
            return fail("Du hast die kurze Zugdarstellung bereits "
                  "eingeschaltet",1);
          write("Kurze Zugdarstellung eingeschaltet.\n");
          SET_PLFLAG(this_player(),PLF_SHORT_MSG);
          UNSET_PLFLAG(this_player(),PLF_NOTATION_TYPE);
        }
        break;
      case "lang":
        if ((i?1:0)==((flags&PLF_LONG_MSG)?1:0))
          return fail("Du hast die natuerlichsprachliche Zugdarstellung "
            "bereits "+ (i?"ein":"aus")+"geschaltet",1);
        if (i) {
          write("Natuerlichsprachliche Zugdarstellung eingeschaltet.\n");
          SET_PLFLAG(this_player(),PLF_LONG_MSG);
        }
        else {
          if (!(flags&(PLF_SHORT_MSG|PLF_VIEW)))
            return fail("Du musst mindestens eine der drei Anzeigearten "
               "eingeschaltet lassen",1);
          write("Natuerlichsprachliche Zugdarstellung ausgeschaltet.\n");
          UNSET_PLFLAG(this_player(),PLF_LONG_MSG);
        }
        break;
      case "ansi":
        if (((flags&PLF_ANSI_TTY)&&(args[1]=="auto")) ||
            ((!(flags&(PLF_ANSI_TTY|PLF_ANSI_YN)))&&(args[1]=="aus")) ||
            ((!(flags&PLF_ANSI_TTY))&&(flags&PLF_ANSI_YN)&&(i)))
          return fail("Du hast die Ansi-Farben-Darstellung bereits "+
              (args[1]=="auto"?"auf Deine Terminaleinstellung ":
               (i?"ein":"aus"))+"geschaltet",1);
        if (args[1]=="auto") {
          SET_PLFLAG(this_player(),PLF_ANSI_TTY);
          write("Ok, hast Du Farben oder nicht, entscheidet jetzt das "
              "Licht... err...\nnein, Deine Terminaltyp-Einstellung (die Du "
              "jederzeit mit dem Befehl \n\"stty ansi|vt100|dumb\" aendern "
              "kannst).\n");
        }
        else {
          UNSET_PLFLAG(this_player(),PLF_ANSI_TTY);
          if (i) {
            SET_PLFLAG(this_player(),PLF_ANSI_YN);
            write(break_string("Ok, egal was Du fuer einen Terminaltyp "
                  "eingestellt hast, Du wirst jetzt mit Farben bombardiert. "
                  "Solltest Du beim Betrachten des Schachbretts wirre Zeichen "
                  "(also *wirklich* wirr) sehen, schalte die Ansidarstellung "
                  "besser wieder auf Automatik (d.h. auf Deine normale "
                  "Terminaleinstellung) oder aus.",77));
          }
          else {
            UNSET_PLFLAG(this_player(),PLF_ANSI_YN);
            write(break_string("Ok, warum auch immer: Du willst - egal ob "
                  "Dein Terminal es trotzdem koennte - KEINE Farben sehen. "
                  "Bitte denke daran, dass das Schachspiel eigentlich gerade "
                  "wegen der Farben so schoen ist und die Anzeige ohne "
                  "Ansi-Farben ziemlich miserabel aussehen wird.",77));
          }
        }
        break;
      case "algebraisch":
        if ((i?1:0)==((flags&PLF_NOTATION_TYPE)?1:0))
          return fail("Du hast die algebraische Notation fuer die kurze "
              "Zugdarstellung und das Partieformular bereits "
               + (i?"ein":"aus")+"geschaltet",1);
        else if (i) {
          write("Algebraische Notation fuer die kurze Zugdarstellung und fuer "
            "das Partieformular eingeschaltet.\n");
          SET_PLFLAG(this_player(),PLF_NOTATION_TYPE);
        }
        else {
          write("Algebraische Notation fuer die kurze Zugdarstellung und fuer "
            "das Partieformular ausgeschaltet.\n");
          UNSET_PLFLAG(this_player(),PLF_NOTATION_TYPE);
        }
        break;
      default: // auto
        if ((i?1:0)==((flags&PLF_VIEW)?1:0))
          return fail("Du hast die automatische Spielbrettanzeige "
            "bereits "+ (args[1]?"ein":"aus")+"geschaltet",1);
        if (i) {
          write("Automatische Spielbrettanzeige eingeschaltet.\n");
          SET_PLFLAG(this_player(),PLF_VIEW);
        }
        else {
          if (!(flags&(PLF_LONG_MSG|PLF_SHORT_MSG)))
            return fail("Du musst mindestens eine der drei Anzeigearten "
                  "eingeschaltet lassen",1);
          write("Automatische Spielbrettanzeige ausgeschaltet.\n");
          UNSET_PLFLAG(this_player(),PLF_VIEW);
        }
        break;
    } 
  } 
  SAVE_PLFLAG(this_player());
  return 1;
}

/* Jaja, das Brett ist leer. Oder es steht noch eine beendete Partie
 * herum. Also los... */

private nosave int doSpielAufstellen(string str) {
  string dummy;
  int * blitz;
  if ((!this_player()) || (environment(this_player())!=this_object()))
    return 0;
  blitz=0;
  while (str!="") {
    write(str+"\n");
    if (efun::explode(str," ")[0]=="blitz") {
      blitz=({0,0});
      str=implode(efun::explode(str, " "),"");
      if (((sscanf(str,"blitz%d%s",blitz[0],dummy)==2) && (dummy=="")) ||
         ((sscanf(str,"blitz%d+%d%s",blitz[0],blitz[1],dummy)==3) &&
          (dummy==""))) 
        break;
    }
    return 
       fail("Wie aufstellen? Entweder ganz normal (\"spiel aufstellen\")"
          " oder eine Blitzpartie (\"spiel aufstellen blitz <min> + <sec>\", "
          "wobei <min> die Anzahl der Minuten ist, die man zu Beginn der "
          "Partie zur Verfuegung bekommt, <sec> die Anzahl der Sekunden "
          "darstellt, die man nach jedem Zug dazubekommt",1);
  }
  if (blitz) {
    if (blitz[0]<=0)
      return fail("Die anfaengliche Bedenkzeit muss mindestens eine "
          "Minute betragen",1);
    else if (blitz[1]<0)
      return fail("Die zusaetzliche Bedenkzeit, die nach jedem Zug "
          "hinzuaddiert wird, darf natuerlich nicht negativ sein",1);
    else if (blitz[0]>600)
      return fail(sprintf("Leider sind %d Minuten anfaengliche Bedenkzeit "
            "fuer eine Blitzpartie zuviel",blitz[0]),1);
    else if (blitz[1]>240)
      return fail("Der maximale Bonus je Zug betraegt 240 Sekunden",1);
  }
  if (!(GS(GS_NOTHING)||GS(GS_ENDED)))
    return fail("Aeh? Jetzt? Du kannst die Figuren nur neu aufstellen, "
        "wenn das Brett leer ist oder die aufgestellte Partie bereits "
        "zuende gespielt ist",1);
  boardInit(0,blitz);
  write("Du stellst die Figuren auf.\n");
  say((string)this_player()->Name(WER)+" stellt die Figuren auf.\n");
  if (blitz)
    tell_room(this_object(),break_string("Die Uhren sind auf eine "+
          getBlitzString(blitz)+" eingestellt.",77));
  SET_GS(GS_PREPARED);
  return 1;
}

/* Unterbrechen kann man eine Partie auch. Aber man kann das nur, wenn
 * entweder beide Spieler unterbrechen wollen oder der zweite Spieler
 * bereits abwesend ist oder idle ist. */

private nosave int doSpielUnterbrechen() {
  if ((!this_player()) || (environment(this_player())!=this_object()))
    return 0;
  if (((!GS(GS_RUNNING))&&(!GS(GS_CONT))) || 
     ((this_player()!=player_ob[0])&&(this_player()!=player_ob[1])))
    return 0;
  if (this_player()==player_info[0]) {
    write("Du hast schon gesagt, dass Du das Spiel unterbrechen moechtest.\n");
    say(break_string(capitalize(getuid(this_player()))+
       " weist noch einmal darauf hin, dass "+ 
       (string)this_player()->QueryPronoun(WER)+
       " das Spiel gerne unterbrechen wuerde.",76));
  }
  checkOnSuspend(this_player()==player_ob[1]?1:0);
  return 1;
}

/* Wegraeumen kann man nur aufgestellte Figuren und beendete Spiele. 
 * Also quasi den Muell vom Brett wegraeumen. Man kann natuerlich nicht
 * eine laufende Partie einfach wegraeumen. Spielverderber und so. */

private nosave int doSpielAufraeumen() {
  if ((!this_player()) || (environment(this_player())!=this_object()))
    return 0;
  if (GS(GS_NOTHING))
    return fail("Da gibt es gerade nichts wegzuraeumen",1);
  else if ((GS(GS_RUNNING))||(GS(GS_CONT)))
    return fail("Na! Du bist doch kein Spielverderber!? Du kannst doch "
        "jetzt die Figuren nicht einfach aufraeumen",1);
  else {
    if (GS(GS_READY)) 
      doMessage("Die Partie findet wohl doch nicht statt.");
    write("Du raeumst die Figuren auf.\n");
    say((string)this_player()->Name(WER)+" raeumt die Figuren weg.\n");
    SET_GS(GS_NOTHING);
    boardInit(1);
  }
  return 1;
}

/* Ein Spiel freigeben muss man, wenn die Figuren aufgestellt sind,
 * und freigeben (das heisst: Die Uhr in Gang setzen) muss der, der 
 * NICHT den ersten Zug hat. Wie im richtigen Leben eben. :o) */

private nosave int doSpielFreigeben() {
  if ((!this_player()) || (environment(this_player())!=this_object()))
    return 0;
  if ((!GS(GS_READY))&&(!GS(GS_CONT)))
    return 0;
  if (this_player()!=player_ob[NPLAYING])
    return fail("Du hast gleich den ersten Zug - das heisst, dass Dein "
        "Gegner das Spiel freigeben muss, nicht Du",1);
  write("Du drueckst auf die Uhr.\n");
  say(break_string(
          player[NPLAYING]+" drueckt auf die Uhr.",77));
  SET_GS(GS_RUNNING);
  switchClock(PLAYING);
  set_heart_beat(1);
  doMessage(player[NPLAYING]+" gibt die Partie frei.");
  TRACELOG(sprintf("BEGIN %s/%s %s",player[PLAYING],player[NPLAYING], 
        clock_blitz?sprintf("%d+%d",clock_blitz[0],clock_blitz[1]):""));
  return 1; 
}

/* Sieht ein Spieler keine Gewinnmoeglichkeit mehr oder muss er
 * er DRINGEND weg und sein Gegner zeigt kein Mitgefuehl, dann muss
 * er die Partie verloren geben und aufgeben. Er kann dies zu jedem
 * Zeitpunkt tun, auch wenn er nicht am Zug ist. */

private nosave int doSpielAufgeben() {
  if ((!this_player()) || (environment(this_player())!=this_object()))
    return 0;
  if (((!GS(GS_RUNNING))&&(!GS(GS_CONT))) || 
     ((this_player()!=player_ob[0])&&(this_player()!=player_ob[1])))
    return 0;
  game_endtype=CET_GIVINGUP;
  doMessage(player[(this_player()==player_ob[PLAYING]?PLAYING:NPLAYING)]
            +" gibt die Partie auf.");
  player_info[1]=1+(this_player()==player_ob[PLAYING]?PLAYING:NPLAYING);
  endGame();
  return 1;
}

/* Wer spielt welche Farbe? Man MUSS sich hier einigen, anders
 * geht es nicht. Wollen beide Spieler partout weiss spielen, dann
 * sollten sie "Zufall" waehlen, so ist es zwar nicht fuer alle
 * befriedigend, immerhin aber gerecht. Und einen Grund fuer 'ne
 * Revance gibt es auch gleich. */

private nosave int doSpielFarbe(string str) {
  if ((!this_player()) || (environment(this_player())!=this_object()))
    return 0;
  if (!GS(GS_PREPARED)) 
    return 0;
  if ((!str) || (str=="")) {
    write(break_string(getChosenColors(),77));
    return 1;
  }
  if (member(({"schwarz","weiss","zufall","egal"}),str)==-1) 
    return fail("Es gibt nur 'schwarz', 'weiss', 'zufall' oder 'egal'",1);
  if (player_info[0]==this_player()) {
    if (player_info[1]==str)
      return fail("Du hast "+(str=="egal"?
            "Deine Gleichgueltigkeit bezueglich der Spielfarben":
            ("Deinen Wunsch, "+(str=="schwarz"||str=="weiss"?str+
            " zu spielen":"die Farbenwahl dem Zufall zu ueberlassen"))+
            ", ")+"bereits kundgetan",1);
    else {
      write("Du aenderst Deine Meinung.\n");
      say(break_string((string)this_player()->Name(WER)+
         " aendert seine Meinung.",77));
    }
  }
  write(break_string("Du tust kund, dass "
     +(str=="egal"?"es Dir egal ist, welche Farbe Du spielst":
     (str=="schwarz"||str=="weiss"?"Du "+str+
     " spielen moechtest":
     "Du die Farbenwahl dem Zufall ueberlassen moechtest"))+".",77));
  say(break_string((string)this_player()->Name(WER)+
     " verkuendet, dass "+(str=="egal"?"es "+
     (string)this_player()->QueryPronoun(WEM)+" egal ist, welche Farbe "+
     (string)this_player()->QueryPronoun(WER)+" spielt":
     (str=="schwarz"||str=="weiss"?
     (string)this_player()->QueryPronoun(WER)
     +" "+str+" spielen moechte":
     (string)this_player()->QueryPronoun(WER)+
     " die Farbenwahl dem Zufall ueberlassen moechte"))+".",77));
  if ((!objectp(player_info[0]))||((environment(player_info[0])!=this_object()))
      || (player_info[0]==this_player())) {
    player_info=({this_player(), str});
    return 1;
  }
  switch (str) {
    case "weiss":
      if ((player_info[1]=="schwarz") || (player_info[1]=="egal"))
         return colorChooseSuccess(({this_player(),player_info[0]}));
      else return colorChooseFail(); break;
     case "schwarz":
       if ((player_info[1]=="weiss") || (player_info[1]=="egal"))
         return colorChooseSuccess(({player_info[0],this_player()}));
       else return colorChooseFail(); break;
     case "zufall":
       if ((player_info[1]=="zufall") || (player_info[1]=="egal"))
         return (random(2)
             ?colorChooseSuccess(({this_player(),player_info[0]}))
             :colorChooseSuccess(({player_info[0],this_player()})));
       else return colorChooseFail(); break;
     default: /* egal */
       if ((player_info[1]=="zufall") || (player_info[1]=="egal"))
         return (random(2)
             ?colorChooseSuccess(({this_player(),player_info[0]}))
             :colorChooseSuccess(({player_info[0],this_player()})));
       else
         return (player_info[1]=="schwarz"
             ?colorChooseSuccess(({this_player(),player_info[0]}))
             :colorChooseSuccess(({player_info[0],this_player()})));
       break;
  }
  return 1;
}

/* Jojo, der Zug. */

nosave int cmdZug(string str) { 
  if ((!this_player()) || (environment(this_player())!=this_object())) 
      return 0;
  if (!GS(GS_RUNNING)) return 
    fail("Spielzuege kannst Du nur bei einer laufenden Partie taetigen",1);
  if (this_player()==player_ob[NPLAYING]) return
      fail("J'adoube? Dein Gegner ist am Zug, nicht Du",1);
  if (this_player()!=player_ob[PLAYING]) 
      return fail("Das Beruehren der Figueren mit den Pfoten ist verboten. "
        "Naja, zumindest solange bis Du mitspielst und auch wirklich "
        "am Zug bist",1);
  return tryMove((query_once_interactive(this_player())?
        (string)this_player()->_unparsed_args():str));
}

/* Die Hilfeseite zum Schachbrett ausgeben. Naja, und auch gleich die
 * FIDE-Schachregeln. */

nosave int cmdHilfe(string str) {
  if ((!this_player())||(!str)) return 0;
  if (str=="schach") this_player()->More(read_file(HELPFILE));
  else if (str=="schachregeln") this_player()->More(read_file(RULESFILE));
  else return 0;
  return 1;
}

/* Man kann sich nur ans Brett setzen, wenn es da ueberhaupt noch 
 * Platz gibt. */

nosave int cmdSetze(string str) {
  string s; 
  mixed x;

  if ((!this_player()) || (environment(this_player())==this_object()))
    return 0;

  notify_fail("Woran moechtest Du Dich setzen?\n");
  if ((!str)|| ((!sscanf(str,"dich an %s",s)) && (!sscanf(str,"an %s",s))) ||
      (!id(s))) return 0;

  notify_fail("Solange Dich irgendetwas verfolgt, kannst Du Dich leider "
      "nicht dem Schachspiel\nwidmen. Werde erstmal Deinen Verfolger los "
      "und versuche es dann wieder.\n");
  if ((x=(mixed)this_player()->QueryProp(P_PURSUERS)) && (pointerp(x)) &&
      (sizeof(x)>1) && (pointerp(x[1])) && (sizeof(x[1]-({0}))))
    return 0;

  notify_fail("Du laeufst noch hinter jemandem her. Wie waere es, wenn Du "
      "das\nsicherheitshalber erst abstellst, bevor Du Dich dem Schachspiel "
      "widmest?\n");
  if ((pointerp(x)) && (x[0]))
    return 0;

  notify_fail("Steh' erstmal den Kampf durch, ok?\n");
  if (this_player()->InFight()) return 0;

  checkPlayerObjects(this_player());

  notify_fail("Leider findet sich am Schachbrett kein Platz mehr fuer "
      "Dich.\n");
  if ((sizeof(presentLivings())>1) && 
      (!(((GS(GS_RUNNING)) || (GS(GS_READY)) || (GS(GS_CONT))) &&
      ((((object)player_ob[0])==this_player()) || 
          (((object)player_ob[1])==this_player()))))) 
          return 0;

  // Laufende Partien muessen noch abgefragt werden....

  if (!GETPLFLAGS(this_player()))
    SET_PLFLAGS(this_player(),CHESS_DEFAULT_FLAGS);

  write("Du setzt Dich an das Schachbrett.\n");
  if (1!=((int)this_player()->move(this_object(),M_GO,
          "an das Schachbrett","setzt sich",
          "setzt sich zu Dir an das Schachbrett"))) return 0;
  return 1;
} 

/* Geaeusserte Farbwuensche... */
/* Das Aufstehen vom Brett. Kabbelt sich ein wenig mit dem Rasten,
 * aber wenn man kein notify_fail() setzt, passt das ja. */

nosave int cmdStehe(string str) {  
  string s;

  if ((!this_player()) ||(this_object() != environment(this_player())) 
     || (!str) || (str!="auf")) return 0; // Das Rasten greift noch.

  if (GS(GS_CONT)) return 
    fail("Hey, ihr habt da noch eine Partie Schach, die ihr "
      "fortzusetzen gedachtet. Wenn Du hier unbedingt weg willst, "
      "musst Du erneut einen Abbruch erreichen oder die Partie wohl "
      "oder uebel aufgeben",1);
  if (GS(GS_RUNNING)) return 
    fail("Hey, Du kannst doch nicht waehrend einer laufenden "
      "Partie Schach davonlaufen. Wenn Du UNBEDINGT weg musst, wirst "
      "Du entweder eine Unterbrechung erreichen (Dein Mitspieler muss "
      "dem zustimmen) oder die Partie aufgeben muessen..",1);
  if (GS(GS_READY)) return
    fail("Na, ihr wolltet doch gerade erst anfangen. Wenn Du weg willst, "
      "raeume bitte erstmal die Figuren wieder auf",1);
  if (!environment(this_object())) return 
    fail("Mist, das Schachbrett haengt irgendwo im Nirvana herum",1);

  write("Du stehst auf und verlaesst das Schachbrett.\n");
  if (1!=((int)this_player()->move(environment(),M_GO,
          "und verlaesst das Schachbrett","steht wieder auf",
          "erhebt sich und tritt vom Schachbrett zurueck"))) 
    write("ARGH, BUG! Gib bitte Anatol Bescheid! :((\n");
      
  return 1;
}

/* Kontextsensitiv. Wobei hier (technisch bloede) die Anzeige der
 * Befehle getrennt von der Ausfuehrbarkeit gefiltert wird. */

nosave int cmdSpiel(string str) {
  string * args;

  switch (str) {
    case 0:              View(); return 1;
    case "befehle":      write(detailBefehle()); return 1;
    case "aufraeumen":   return doSpielAufraeumen();
    case "unterbrechen": return doSpielUnterbrechen();
    case "aufgeben":     return doSpielAufgeben();
    case "freigeben":    return doSpielFreigeben();
    default:
      args=explode(str," ");
      switch (args[0]) {
        case "aufstellen": return doSpielAufstellen(implode(args[1..]," "));
        case "farbe":      return doSpielFarbe(implode(args[1..],""));
        case "anzeige":    return doSpielAnzeige(args[1..]);
        default:
          notify_fail("Das machte jetzt irgendwie keinen Sinn.\n");
          return 0;
      }
  }
}

/**************************************************************************
 * Vermischte kleine Hilfsfunktionen
 **************************************************************************/

/* fail() - kann man schoen "returnen", also quasi ein notify_fail() und
 * return 0 in einem ;). Nachteil: Passt natuerlich nicht, wenn die 
 * Methode kein 'int' zurueckgibt. */

private nosave varargs int fail(string s, int damneditisnotaboutthegame) {
  if ((this_player()) &&(s)) {
    if (!damneditisnotaboutthegame)
      write(break_string("Das geht nicht, "+s+".",76,0,1));
    else 
      write(break_string(s+".",77,0,1));
  }
  return 1;
}

/* Aus Spielerobjekten wird eine Namensauflistung. Braucht man halt.... */

private nosave string objectsToString(object * arr, int casus) {
  switch (sizeof(arr)) {
    case 0:  return "";
    case 1:  return (string)(arr[0]->name(casus));
    default: return  
       (string)implode((arr=map_objects(arr,"name",casus))[0..<2],", ")
         +" und "+arr[<1];
  }
}

/* Anwesende Lebewesen. Unsichtbare eingeschlossen. */

private nosave object * presentLivings() {
  return filter_array(all_inventory(this_object()),#'living) ;
}

/* Was man natuerlich braucht, wenn man Farben waehlt: Samples. */

private nosave varargs void printSample(int col, int sty, int which, int e) {
  if (col>=sizeof(color_schemes)) return;
  write(sprintf("%2d: %s\n     %s (%s)\n",(which?sty:col),
      NRML+" "+
      CSCH(col,COL_BG((e?1:0)))+CSCH(col,COL_P(0))+SSCH(sty,T)[0..3]+NRML+
      CSCH(col,COL_BG((e?0:1)))+CSCH(col,COL_P(1))+SSCH(sty,D)[0..3]+NRML+
      CSCH(col,COL_BG((e?1:0)))+CSCH(col,COL_P(1))+SSCH(sty,K)[0..3]+NRML+
      CSCH(col,COL_BG((e?0:1)))+CSCH(col,COL_P(0))+SSCH(sty,L)[0..3]+NRML,
      CSCH(col,COL_BG((e?1:0)))+CSCH(col,COL_P(0))+SSCH(sty,T)[4..7]+NRML+
      CSCH(col,COL_BG((e?0:1)))+CSCH(col,COL_P(1))+SSCH(sty,D)[4..7]+NRML+
      CSCH(col,COL_BG((e?1:0)))+CSCH(col,COL_P(1))+SSCH(sty,K)[4..7]+NRML+
      CSCH(col,COL_BG((e?0:1)))+CSCH(col,COL_P(0))+SSCH(sty,L)[4..7]+NRML,
      (which?SSCH(sty,SSCH_TEXT):CSCH(col,CSCH_TEXT))));
}

/* Diese Methode wirft alles nach aussen, was hier nichts verloren hat... */

nosave void cleanUp() {
  int sz, i; 
  object * obs;
  object dest;

  if (environment(this_object())) 
    dest=environment(this_object());
  else {
      call_other("/room/void","????");
      dest=find_object("/room/void");
  }

  obs=all_inventory(this_object());
  sz=sizeof(presentLivings());
  for (i=0;i<sizeof(obs);i++) 
    if (living(obs[i])) {
      if ((GS(GS_RUNNING) && ( (obs[i]!=player_ob[0]) && obs[i]!=player_ob[1])) 
        ||(sz-->2)) 
          obs[i]->move(dest, M_GO|M_SILENT|M_NO_SHOW);
    } 
    else 
      obs[i]->move(dest, M_NOCHECK|M_SILENT|M_NO_SHOW);
}
  


/**************************************************************************
 * Vermischte oeffentliche Methoden
 **************************************************************************/

/* Sollte je noetig sein, die Schemata bei laufender Partie zu
 * veraendern, kann man das. Ist ein wenig Overkill, zugegeben,
 * aber es funktioniert immerhin :) */

public void UpdateSchemes() {     // Wird auch vom Objekt selbst aufgerufen
  if (last_update_time>file_time(SCHEMESOBJ+".lpc")) return;
  if ((find_object(SCHEMESOBJ)) && 
          (program_time(find_object(SCHEMESOBJ))<file_time(SCHEMESOBJ+".lpc")))
    destruct(find_object(SCHEMESOBJ));
  if (catch(call_other(SCHEMESOBJ,"???"))) {
      write("Mist, die Farb- und Figurenschemata koennen "
              "nicht nachgeladen werden! BUG!\n");
      return; 
  }
  color_schemes = ({})+(mixed *)SCHEMESOBJ->GetColorSchemes();
  style_schemes = ({})+(mixed *)SCHEMESOBJ->GetStyleSchemes();
  last_update_time=time();
  return;
}

/* Mehr zu Debugzwecken als zu ernsthaften Nutzen: Sollte es mal noetig
 * sein, der Partie aus der Ferne zuzuschauen, kann man sich in diese
 * Liste eintragen. Sollte man den Spielenden fairerweise aber sagen... */

public int AddListener(object o) {
  TRACELOG(sprintf("ADD_LI %O",o));
  if ((!o)||(!objectp(o))||(!query_once_interactive(o))||
      (member(listener,o)!=-1) || (!IS_WIZARD(o))) return 0;
  else listener+=({getuid(o)});
  return 1;
}

/* Natuerlich kann man sich aus der Liste auch _austragen_. Natuerlich
 * auch andere. Man kann uebrigens auch andere eintragen - sofern diese
 * Magier sind. Aber warum sollte man dies tun? */

public int RemoveListener(object o) {
  TRACELOG(sprintf("REMOVE_LI %O",o));
  if ((!o)||(!objectp(o))||(!living(o))||(member(listener,o)==-1)) return 0;
  else listener-=({getuid(o)});
  return 1;
}

/* Ah, ja. Natuerlich kann man auch abfragen, wer auf dieser ominoesen
 * Liste ueberhaupt steht. Was sein muss, muss sein :o) */

public string * QueryListener() { return listener; }

