 /* 
  * Unbekanntes Brettspiel, keine Ahnung wer das erfunden hat...
  *
  *                 .         ,       __       oo       _+
  *        |~       /)       (+       II       ()       [] 
  *     -----------------------------------------------------
  *     --     see chess.h for full header information.    --
  *
  * Dieses Objekt beherbergt die Schemata zum Schachspiel. Ausgelagert
  * deshalb, damit man es leichter aendern kann. Ich wuerde es ja gern
  * inheriten - aber ohne "extern"-Deklaration ist das Modularisieren
  * groesserer Projekte gar nicht so einfach, wenn man auf "unnoetige"
  * Methodenaufrufe verzichten moechte...
  *
  */

#include <ansi.h>

/* Auswaehlbare Farbschemata, im jeweiligen Array steht:
 * 0 - Spieler weiss, 
 * 1 - Spieler schwarz, 
 * 2 - Hintergrund weiss
 * 3 - Hintergrund dunkel 
 * 4 - Bezeichnung           */

nomask mixed * GetColorSchemes() {
   return ({ ({ 
        ANSI_RED+ANSI_BOLD,
        ANSI_BLUE+ANSI_BOLD,
        ANSI_BG_WHITE,
        ANSI_BG_YELLOW,
        "erprobte Standardeinstellung" 
        }), ({ 
        ANSI_WHITE+ANSI_BOLD,
        ANSI_GREEN+ANSI_BOLD,
        ANSI_BG_BLUE,
        ANSI_BG_PURPLE,
        "Classic Doom" 
        }), ({ 
        ANSI_WHITE+ANSI_BOLD,
        ANSI_CYAN+ANSI_BOLD,
        ANSI_BG_YELLOW,
        ANSI_BG_BLUE,
        "Schwarz/weiss auf Gelb/Blau" 
        }), ({ 
        ANSI_YELLOW+ANSI_BOLD,
        ANSI_BLUE+ANSI_BOLD,
        ANSI_BG_RED,
        ANSI_BG_GREEN,
        " A U G E N F E I N D " 
        }), ({ 
        ANSI_RED+ANSI_BOLD,
        ANSI_BLUE+ANSI_BOLD,
        ANSI_BG_WHITE,
        ANSI_BG_BLACK,
        "Con Sola Grande" 
        }), ({ 
        ANSI_BLACK,
        ANSI_BLACK,
        ANSI_BG_BLACK,
        ANSI_BG_BLACK,
        "Blindes Schach" 
        }),
     });
}

/* Style-Schemata, Argumentreihenfolge: Leerfeld, Bauer, 
 * Springer, Laeufer, Turm, Dame, Koenig, Schemataname */

nomask mixed * GetStyleSchemes() {
  return ({ ({
       "    "      /* Nix :o)  */
       "    ", 

       "    "      /* Bauer    */
       " |' ", 
       
       " .  "      /* Springer */
       " /) ", 
       
       "  , "      /* Laeufer  */
       " (+ ", 

       " __ "      /* Turm     */
       " II ", 
       
       " oo "      /* Dame (und WAS fuer eine Dame!)  */
       " () ", 
       
       " _+ "      /* Koenig   */
       " [] ",
       "Standardschema"
       }),({
       "    "      /* Nix :o)  */
       "    ", 

       "    "      /* Bauer    */
       "  b ", 
       
       "    "      /* Springer */
       "  S ", 
       
       "    "      /* Laeufer  */
       "  L ", 

       "    "      /* Turm     */
       "  T ", 
       
       "    "      /* Dame     */
       "  D ", 
       
       "    "      /* Koenig   */
       "  K ",
       "Spartacus"
       }),({
       "    "      /* Nix :o)  */
       "    ", 

       "    "      /* Bauer    */
       " /. ", 
       
       "    "      /* Springer */
       " /: ", 
       
       "    "      /* Laeufer  */
       " // ", 

       "    "      /* Turm     */
       " || ", 
       
       " .. "      /* Dame     */
       " () ", 
       
       "  + "      /* Koenig   */
       " /| ",
       "'noname'"
       }),({
       "    "      /* Nix :o)  */
       "    ", 

       "    "      /* Bauer    */
       " () ", 
       
       " __ "      /* Springer */
       " >/ ", 
       
       "  / "      /* Laeufer  */
       " /\\ ", 

       " __ "      /* Turm     */
       " || ", 
       
       " () "      /* Dame     */
       " || ", 
       
       " /\\ "      /* Koenig   */
       " || ",
       "Classique"
       })});
}
