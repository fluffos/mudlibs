inherit "/std/npc";
inherit "/std/player/soul";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <living.h>

create() {
  npc::create();
  AddId("kaninchen");
  SetProp(P_NAME, "Kaninchen");
  SetProp(P_SHORT, "Ein suesses, weisses Kaninchen");
  SetProp(P_LONG,
  	"Du siehst ein suesses Kaninchen mit weichem, flauschigem Fell.\n"
  	+"Als Du es genauer betrachtest, siehst du, dass es ein goldenes"
 	+" Schildchen\n"
	+"um seinen Hals traegt.\n");
  SetProp(P_RACE, "kaninchen");
  SetProp(P_GENDER, 3);
  SetProp(P_LEVEL,5);
  SetProp(P_ALIGN, 100); /* ist das nicht ein bisschen viel? */
  SetProp(P_BODY, 10);
  SetProp(P_HANDS, ({ " mit seinen Zaehnen", 1}));
  SetProp(P_MAX_HP, 60);
  SetProp(P_HP, 60);
  SetProp(P_XP, 300);
  SetProp(P_MSGOUT,"hoppelt hinaus");
  SetProp(P_MMSGOUT,"hoppelt hinaus");
  SetProp(P_MSGIN,"hoppelt herein");
  SetProp(P_MMSGIN,"hoppelt herein");
  set_heart_beat(1);
  SetChats( 10, ({
		"Das Kaninchen huepft vergnuegt um Dich herum.\n",
		"Das Kaninchen schnuppert an Deinem Fuss.\n",
		"Das Kaninchen knabbert an einem Grashalm.\n",
		"Das Kaninchen putzt sich seine Ohren.\n",
		"Das Kaninchen schmiegt sich ganz sanft an dich.\n"
		}) );
}

heart_beat()
  {
  ::heart_beat();
  if (present("kermet")) return 0;
  else
  this_object()->move(environment(find_player("kermet")),M_GO);
  }


init()
{
	npc::init();
	add_action ("lies", "lese");
	add_action ("lies", "lies");
	add_action ("knuddel", "knuddel");
	add_action ("knuddel", "knuddle");
	add_action ("streichle", "streichel");
	add_action ("streichle", "streichle");
	add_action ("kuschel", "kuschle");
	add_action ("kuschel", "kuschel");
	add_action ("treten", "trete");
	add_action ("treten", "tritt");
}

Defend(dam, dam_type)
{
   object enemy;
   if (!(enemy = QueryEnemy()))
      enemy = this_player();
   tell_room(environment(), "Das Kaninchen sagt: Hey, was hast Du gegen"
				+" Kaninchen?\n");
   enemy->StopHuntingMode(1);
   this_object()->StopHuntingMode(1);
}

 lies(str)
{
        if (str=="schildchen") 
	{
	write ("Darauf steht: ich bin Zephyr's Kuschel-Kaninchen.\n");
	return 1;
	}
	return 0;
}
streichle(str)
{
  	if (str=="kaninchen") 
	{
  	write("Du streichelst das Kaninchen und spuerst, wie weich sein"
		+" Fell ist.\n");
        say(this_player()->name()+" streichelt das suesse kleine"
					+" Kaninchen.\n", ({ this_player() }));
  	return 1;
	}
	else return 0;
}

knuddel(str)
{
   	if (str=="kaninchen") 
	{
   	write("Du knuddelst das suesse Kaninchen.\n");
   	write("Das Kaninchen wackelt gluecklich mit seinen Schlappohren.\n");
   	say(this_player()->name()+" knuddelt das suesse kleine"
		+" Kaninchen.\n", ({ this_player() }));
   	return 1;
	}
	else return 0;
}

kuschel(str)
{
        if (str=="kaninchen")
        {
	int vergleich;
	vergleich=(this_player()->name());
	if ((vergleich==("Kermet")) || (vergleich==("Zephyr")))
	{
        write("Du kuschelst Dich an das suesse Kaninchen und spuerst"
		+" die Waerme\n");
        write("seines kleinen Koerpers. Das Kaninchen schmiegt sich erfreut"
 		+" an Dich.\n");
	write("Als Du es ganz an Dich drueckst, fuehlst Du, wie sein"
		+" Herz klopft.\n");
        return 1;
	}
	else
	{
	write ("Das Kaninchen laesst sich von Dir nicht kuscheln.\n");
	return 1;
        }
        return 0;
	}
}

treten(str)
{
        if (str=="kaninchen")
        {
        write("Du trittst das suesse Kaninchen, aber das gefaellt ihm"
		+" gar nicht.\n");
        say("Das Kaninchen schreit auf, als es von "
		+this_player()->name()+" getreten wird.\n", 
		({this_player() }));
	write("Das Kaninchen beisst Dich daraufhin tuechtig ins Bein.\n");
        say(this_player()->name()+" wurde gerade von einem suessen, kleinen"
		+" Kaninchen gebissen.\n", ({ this_player() }));
        return 1;
        }
        else return 0;
}
