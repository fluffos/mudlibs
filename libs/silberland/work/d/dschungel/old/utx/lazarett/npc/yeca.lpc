inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Huepfende Yeca");
  SetProp(P_LONG, BS(
    "Das ist die Elfin Yeca. Sie hat lange rote Haare, welche sie zu "
    "Zoepfen geflochten hat. Ihr Gesicht ist voll von kleinen suessen "
    "Sommersprossen und sie blickt Dich mit ihren blaugruengrauen Augen "
    "traurig an. Ihre Haare sind momentan ziemlich zerrupft, aber die "
    "Krankheit scheint sie noch nicht voll erwischt zu haben."));
  SetProp(P_NAME, "Yeca");
  SetProp(P_GENDER, FEMALE);
  AddId(({"yeca"}));
  SetProp(P_ARTICLE, 0);


  create_default_npc(25);
  SetProp(P_HANDS, ({" mit ihren zarten Haenden", 100+random(30)}));
  SetProp(P_RACE, "elf");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 50);
  SetProp(P_NOMAGIC, 5);
	
  SetProp(P_FORCE_MURDER_MSG,1);	
  SetProp(P_MURDER_MSG, " %s ? Ich kuendige Dir hiermit die Freundschaft.");
  SetProp(P_MSGIN, "huepft verrueckt grinsend herein");
  SetProp(P_MSGOUT, "huepft verrueckt grinsend");
  SetProp(P_MMSGIN, "huepft verrueckt grinsend herein");
  SetProp(P_MMSGOUT, "huepft weit weg.");

  SetProp(P_DIE_MSG,  " huepft zum letzten mal.\n");
  
  AddInfo(DEFAULT_INFO, " grinst Dich irr an.\n");
  AddInfo("utx", "UTX ist auch eine ganz eine Liebe.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Yeca bedankt sich herzlich und huepft vernuegt.\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,200,
    "Yeca huepft auf Dir herum.\n",
    "Yeca huepft auf @WEN herum.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(5,200,
    "Yeca lacht irr und streckt Dir die Zunge raus.\n",
    "Yeca lacht irr und streckt @WEN die Zunge raus.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
      AddSpell(1,600,
    "Yeca versucht Dich in einen Gummiball zu verwandeln.\n",
    "Yeca versucht @WEN in einen Gummiball zu verwandeln.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
      
  SetChats(3, ({
  "Yeca huepft grinsend herum.\n",
  "Yeca laechelt Dich an.\n",
  "Yeca bekommt auf einmal feuchte Augen und weint leise vor sich hin.\n",
  "Yeca weint leise.\n",
  "Yeza kichert irr.\n",
  "Yeca fluestert: Weisst Du wo man gut forschen kann?\n",
  "Yeca untersucht alles ganz genau.\n",
  }));

  SetAttackChats(10, ({
  "Yeca versucht zu fliehen.\n",
  "Yeca huepft um Dich herum und faellt Dir in den Ruecken.\n",
  "Yeca will nicht sterben.\n",
  "Yeca schreit: Such doch lieber ein Heilmittel.\n",
  "Yeca bietet Dir ihre Freundschaft an.\n"}) );

}
