inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Dunkekraehe Krowley");
  SetProp(P_LONG, BS(
    "Das ist Krowley. Er ist durch und durch boese und ein Dunkelelf "
    "aus ganzem Herzen. Er hat im Gegensatz zu seinen Artgenossen "
    "wenig Haare und gruenblaue Augen. Er ist auch nicht so schlank "
    "wie seine Kollegen, sondern zeigt erste Bauchansaetze. "));
    
  SetProp(P_NAME, "Krowley");
  SetProp(P_GENDER, MALE);
  AddId(({"krowley", "krow"}));
  SetProp(P_ARTICLE, 0);


  create_default_npc(28);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Haenden", 100+random(30)}));
  SetProp(P_RACE, "dunkelelf");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,([P_RACE:(["Elf":1, "Dunkelelf":0.0, 0:0.5]),P_GUILD:(["Paladine":0.1])]));
  SetProp(P_WIMPY, 30);
  SetProp(P_NOMAGIC, 5);
	
  SetProp(P_FORCE_MURDER_MSG,1);	
  SetProp(P_MURDER_MSG, "%s ? Die Rache LLoths ist Dir sicher.");
  SetProp(P_MSGIN, "schleicht herein.");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "schleicht herein");
  SetProp(P_MMSGOUT, "schleicht davon.");

  SetProp(P_DIE_MSG,  "ruft: Die Rache Lloths wird ueber Dich kommen.\n");
  
  AddInfo(DEFAULT_INFO, "grummelt vor sich hin.\n");
  AddInfo("utx", "UTX ist eine ganz eine Liebe, Pfui!","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Krowley sagt: Oh ein Opfer fuer Lloth.\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,200,
    "Krowley verflucht Dich.\n",
    "Krowley verflucht @WEN.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,200,
    "Krowley trickst Dich hinterhaeltig aus.\n",
    "Krowley trickst @WEN hinterhaeltig aus.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
        
  SetChats(3, ({
  "Krowley blickt Dich hinterhaeltig an.\n",
  "Krowley ruft: DUNKELELFENPOWER!.\n",
  "Krowley sagt: Lloth wird Dich strafen wenn Du nicht bald das Heilmittel findest.\n",
  "Krowley grummelt Dich an.\n",
  "Krowley fluestert: Weisst Du wo man gut forschen kann?\n",
  "Krowley bekommt auf einmal einen irren Blick.\n",
  "Krowley idlet vor sich hin.\n",
  "Krowley sagt: mom. telefon.\n",
  "Krowley untersucht alles ganz genau.\n",
  }));

  SetAttackChats(10, ({
  "Krowley versucht zu fliehen.\n",
  "Krowley will nicht sterben.\n",
  "Krowley schreit: Such doch lieber ein Heilmittel.\n",
  }));
}
