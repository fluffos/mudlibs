inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Baron Sengi");
  SetProp(P_LONG, BS(
    "Das ist Sengi, ein kleiner Zwerg. Er hat kurze schwarze Haare und "
    "strahlend blaue Augen. Aufrecht stolziert er vor Dir auf und ab "
    "und wirkt dadurch sogar um ein paar Millimeter groesser. Er "
    "ist der Meinung er ist unwiderstehlich und alle haben ihn anzuhimmeln."));
    
  SetProp(P_NAME, "Sengi");
  SetProp(P_GENDER, MALE);
  AddId(({"sengi"}));
  SetProp(P_ARTICLE, 0);


  create_default_npc(25);
  SetProp(P_HANDS, ({"mit seinen kraeftigen Haenden", 100+random(30)}));
  SetProp(P_RACE, "zwerg");
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,([P_RACE:(["Elf":1, "Zwerg":0.0, 0:0.5])]));
  SetProp(P_WIMPY, 30);
  SetProp(P_NOMAGIC, 5);
	
  SetProp(P_FORCE_MURDER_MSG,1);	
  SetProp(P_MURDER_MSG, "%s ? Warte nur, auch Du wirst noch vor mir auf dem Boden\n"
  "liegen und um meine Gunst betteln.\n");
  SetProp(P_MSGIN, "stolziert mit erhobenem Haupt herein");
  SetProp(P_MSGOUT, "stolziert mit erhobenem Haupt");
  SetProp(P_MMSGIN, "stolziert mit erhobenen Haupt herein");
  SetProp(P_MMSGOUT, "stolziert mit erhobenem Haupt davon.");

  SetProp(P_DIE_MSG,  "blickt Dich ein letztes Mal mit seinen blauen\n"
  	+"Augen an.");
  
  AddInfo(DEFAULT_INFO, "blickt Dich hochnaesig an.\n");
  AddInfo("utx", "UTX ist eine ganz eine Liebe.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Sengi deutet ein Kopfnicken an und laechelt hoheitsvoll.\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,200,
    "Sengi schaut dich mit seinen blauen Augen durchdringend an.\n",
    "Sengi schaut @WEN mit seinen Blauen Augen durchdringend an.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,200,
    "Sengi rammt Dir seinen Kopf in den Bauch.\n",
    "Sengi rammt @WEN seinen Kopf in den Bauch.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
        
  SetChats(3, ({
  "Sengi stolziert auf und ab.\n",
  "Sengi schaut Dich mit seinen blauen Augen bittend an.\n",
  "Sengi sagt: Es ist Deine Pflicht das Heilmittel fuer mich zu finden.\n",
  "Sengi zupft an seinem Bart.\n",
  "Sengi fluestert: Weisst Du wo man gut forschen kann?\n",
  "Sengi untersucht alles ganz genau.\n",
  "Sengi wackelt mit dem Hintern.\n",
  "Sengi grummelt: Meine Haare sind nicht schwarz, die sind Dunkelbraun.\n",
  }));

  SetAttackChats(10, ({
  "Sengi versucht zu fliehen.\n",
  "Sengi schaut Dich mit seinen blauen Augen traurig an.\n",
  "Sengi will nicht sterben.\n",
  "Sengi schreit: Such doch lieber ein Heilmittel.\n",
  }));
}
