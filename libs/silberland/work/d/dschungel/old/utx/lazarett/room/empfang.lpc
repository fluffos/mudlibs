inherit "std/room";
#include <language.h>
#include "../def.h"
#include <properties.h>

int cmd_lesen(string str)
{
	
  notify_fail("Syntax : lies karteikarte\n");

  if(-1 == member(({"karte", "karteikarte"}),str))
  {
    return 0;}
  write("\t\t\t Der irre Just  \n\n"
  	+"\t Geboren am 23.1.1997 in Midas. \n"
  	+"\t Einlieferungsgrund: 'Quaeropestis'\n"
  	+"\t Behandlung: \n"
  	+"\t   	 'Isolation am Dachboden bis Genaueres ueber \n"
  	+"\t      die Art der Erkrankung ausgeforscht werden konnte. \n"
  	+"\t ACHTUNG !!!! Es herrscht extreme Ansteckungsgefahr !!!! \n");
  say(TPN+" liest sich eine Karteikarte durch.\n");
  return 1;
}

void create()
{
::create();
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_HOUSE]) );

  SetProp( P_INT_SHORT, "Empfangshalle des Lazarettes von Tijara.");
  SetProp( P_INT_LONG, "Du befindest Dich im Empfangsraum des Lazarettes in "
  	+"Tijara. Direkt vor Dir siehst Du einen Schreibtisch. Dahinter "
  	+"haengt ein grosses Bild. Im ganzen Raum sind duftende Pflanzen  "
  	+"verteilt, aber trotzdem kannst Du Dich hier nicht wirklich "
  	+"wohlfuehlen. Ueberall schwirren Moskitos herum und ein beissender "
  	+"Geruch haengt in der Luft.");
  
  SetProp(P_INDOORS,1);
  AddDetail( ({"empfangsraum", "raum"}),
  	"Du befindest Dich im Empfangsraum des Lazarettes in Tijara.");
  AddDetail( ({"lazarett", "lazarettes", "tijara"}),
  	"Du befindest Dich in einem Lazarett in Tijara. Wenn nicht dieser "
  	+"beissende Geruch waere, koennte man sich wohlfuehlen.");
  AddSmell(DEFAULT_SMELL, "Der Geruch erinnert Dich eher an eine Todesstaette "
  	+"als an ein Lazarett.");
  AddSmell( ({"gestank", "geruch"}),
       	"Es stinkt modrig und verfault. Wie wenn im Keller eine Leiche laege.");
  AddDetail( ({"geruch", "gestank"}),
  	"Hast Du keine Nase zum riechen ?");
  AddDetail( ({"todesstaette", "keller", "leiche"}),
  	"Es riecht so, aber Du entdeckst nichts, was darauf hinweisen koennte.");
  AddDetail( ({"schreibtisch", "tisch"}),
  	"Auf dem Schreibtisch liegen viele Karteikarten herum.");
  AddDetail( ({"kartei", "karteikarten"}),
  	"Auf allen Karteikarten wurden rechts oben rote Punkte aufgeklebt. "
  	+" Eine Karte liegt extra.");
  AddDetail( ({"punkt", "punkte"}),
  	"Leider weisst Du nicht warum diese Punkte aufgeklebt wurden.");
  AddDetail( ({"karte", "karteikarte"}),
  	"Es ist die Karteikarte des irren Just. Du kannst sie vielleicht lesen.");
  AddDetail( "just", "Einer der Patienten die sich momentan im Lazarett aufhalten.");
  AddDetail( ({"patient", "patienten"}), "Sie sind hier weil sie krank sind.");
  AddCmd( ({"les", "lies", "lese"}), "cmd_lesen" );
  AddDetail( "bild", "Auf dem Bild siehst du eine paar Insekten, die recht "
    	+"unheimlich wirken, weil sie stark vergroessert sind, du nimmst an, dass "
    	+"sie alle irgendwelche ekelhafte Krankheiten uebertragen.");
  AddDetail( ({"insekt", "insekten"}),
  	"Moskitos, Ameisen, Kaefer, Fliegen, Zecken und ein paar andere, die du "
  	+"nicht kennst.");
  AddDetail( ({"moskito", "moskitos"}),
  	"Moskitos uebertragen Malaria.");
  AddDetail( "malaria", "Halte dich mal ein bisschen laenger im Dschungel auf, dann "
  	+"weisst Du um was es geht.");
  AddDetail( "dschungel", "Du befindest Dich hier im Dschungel.");
  AddDetail( ({"ameise", "ameisen", "kaefer"}),
  	"Man raetselt noch darueber, was die alles uebertragen koennen.");
  AddDetail( ({"fliege", "fliegen", "tsetsefliegen", "schlafkrankheit"}), 
  	"Nun, Tsetsefliegen uebertragen die Schlafkrankheit.");
  AddDetail( ({"zecke", "zecken", "gehirnhautentzuendung"}),
	"Durch Zecken kann man eine gefaehrliche Gehirnhautentzuendung bekommen.");
  AddDetail( ({"krankheit", "krankheiten"}),
  	"Momentan beschaeftigt die Leute hier nur eine Krankheit: Quaeropesti!");
  AddDetail( "leute", "Die Leute dieses Lazarettes.");
  AddDetail( ({"quaeropesti"}), 
  	"Um genaueres ueber diese Krankheit zu erfahren, musst Du Dich schon ein "
  	+"bisschen umhoeren.");
  AddDetail( ({"pflanze", "pflanzen"}),
  	"Es handelt sich hier um wilde Orchideen.");
  AddDetail( ({"orchidee", "orchideen"}),
  	"Nun, die wachsen hier im Dschungel sicherlich.");
  AddDetail( ({"boden", "decke"}), "Der Boden, die Decke und die Waende bestehen "
  	+"aus Holz.");
  AddDetail( ({"wand", "waende"}),
  	"Die Waende bestehen aus Holz. An einer haengt ein Bild.");
  AddDetail( "nase", "Du betastest Deine Nase - Ja, ist noch da.");
  AddDetail( "luft", "Es stinkt.");
  AddDetail( "holz", "Es wurde einfaches Holz aus dem Dschungel verwendet. Nichts "
  	+"besonderes:");
  
  
   AddExit("norden","in eine Huette#/d/dschungel/utx/lazarett/room/huette3.lpc");
   AddExit("nordosten","in eine Huette#/d/dschungel/utx/lazarett/room/huette4.lpc");
   AddExit("osten","in eine Huette#/d/dschungel/utx/lazarett/room/huette5.lpc");	
   AddExit("suedosten","in eine Huette#/d/dschungel/utx/lazarett/room/huette6.lpc");
   AddExit("sueden","in eine Huette#/d/dschungel/utx/lazarett/room/huette7.lpc");
   AddExit("suedwesten","in eine Huette#/d/dschungel/utx/lazarett/room/huette8.lpc");
   AddExit("westen","in eine Huette#/d/dschungel/utx/lazarett/room/huette1.lpc");
   AddExit("nordwesten","in eine Huette#/d/dschungel/utx/lazarett/room/huette2.lpc");
   
}  		