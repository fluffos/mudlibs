inherit "std/room";
#include <language.h>
#include "../def.h"
#include <properties.h>


void create()
{
::create();
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_HOUSE]) );

  SetProp( P_INT_SHORT, "Eine Krankenhuette.");
  SetProp( P_INT_LONG, 
  	"Du befindest Dich in einer der vielen Krankenhuetten des Lazarettes von "+
  	"Tijara. Die Huetten sind mit ueberdachten Stegen miteinander verbunden. "+
  	"Am Boden liegen einige Matratzen, die wohl fuer die Kranken hier liegen. "+
  	"Der ganze Raum wirkt aeusserst ungemuetlich und Du hoffst, dass Du nicht "+
  	"krank wirst.");
  
  SetProp(P_INDOORS,1);
  AddDetail( ({"huette", "raum", "krankenhuette"}),
  	"Du befindest Dich in einer der zahlreichen Krankenhuetten des Lazarettes.");
  AddDetail( ({"huetten", "krankenhuetten"}),
  	"Die Huetten sind mit ueberdachten Stegen miteinander verbunden.");
  AddDetail( ({"steg", "stegen", "stege"}),
  	"Die Stege bestehen aus Holz und verbinden die Huetten miteinander.");
  AddDetail( ({"boden", "holzboden"}),
  	"Der Boden besteht aus Holz. Es liegen hier einige Matratzen. Sie dienen "+
  	"wohl fuer die Kranken des Lazarettes.");
  AddDetail( ({"matratze", "matratzen"}),
  	"Die Matratzen sind sehr alt und schmutzig. Hier sollte mal wieder aufgeraeumt "+
  	"werden. Du kannst Dir nicht vorstellen auf so einer Matratze zu liegen.");
  AddDetail( ({"lazarett", "lazarettes"}),
  	"Du befindest Dich in einem Lazarett in Tijara. Wenn nicht dieser "
  	+"beissende Geruch waere, koennte man sich wohlfuehlen.");
  AddSmell(DEFAULT_SMELL, "Der Geruch erinnert Dich eher an eine Todesstaette "
  	+"als an ein Lazarett.");
  AddSmell( ({"gestank", "geruch", "lazarett", "todesstaette"}),
       	"Es stinkt modrig und verfault. Wie wenn im Keller eine Leiche laege.");
  AddDetail( ({"geruch", "gestank"}),
  	"Hast Du keine Nase zum riechen ?");
  AddSound(DEFAULT_SOUND, "Du hoerst die Moskitos umhersirren.");
  AddDetail( ({"todesstaette", "keller", "leiche"}),
  	"Es riecht so, aber Du entdeckst nichts, was darauf hinweisen koennte.");
  AddDetail( ({"patient", "patienten", "kranke", "kranken"}), "Sie sind hier weil "+
  	"sie krank sind.");
    AddDetail( ({"moskito", "moskitos"}),
  	"Moskitos uebertragen Malaria.");
  AddDetail( "malaria", "Halte dich mal ein bisschen laenger im Dschungel auf, dann "
  	+"weisst Du um was es geht.");
  AddDetail( ({"dschungel", "tijara"}), 
  	"Du befindest Dich hier im Dschungel von Tijara.");
  AddDetail( ({"krankheit", "krankheiten"}),
  	"Momentan beschaeftigt die Leute hier nur eine Krankheit: Quaeropesti!");
  AddDetail( "leute", "Die Leute dieses Lazarettes.");
  AddDetail( ({"quaeropesti"}), 
  	"Um genaueres ueber diese Krankheit zu erfahren, musst Du Dich schon ein "
  	+"bisschen umhoeren.");
  AddDetail( ({"waende", "decke", "wand"}), "Der Boden, die Decke und die Waende bestehen "
  	+"aus Holz.");
  AddDetail( "nase", "Du betastest Deine Nase - Ja, ist noch da.");
  AddDetail( "luft", "Es stinkt.");
  AddDetail( "holz", "Es wurde einfaches Holz aus dem Dschungel verwendet. Nichts "
  	+"besonderes:");
  
  AddExit("westen","in eine Huette#/d/dschungel/utx/lazarett/room/huette2.lpc");  
  AddExit("sueden","in eine Huette#/d/dschungel/utx/lazarett/room/empfang.lpc");
  AddExit("osten","in eine Huette#/d/dschungel/utx/lazarett/room/huette4.lpc");
  
  	  	
}  		