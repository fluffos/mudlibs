inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
friss_ess(object ding);


 create()
{
 
  if (!is_clone(TO)) return;
  ::create();
    SetProp(P_SHORT, "Eine Mutantenkuh");
    SetProp(P_LONG, "Eine schwarz-weisse gecheckte Mutantenkuh.\n");
    SetProp(P_NAME, "Kuh");
    SetProp(P_GENDER, FEMALE);
    AddId( ({"kuh", "mutantenkuh"}) );
    create_default_npc(20);
  
}

int catch_tell(string catched)    
  
  { 
  	
     object droped;
     string pl, was,obid, *was2;
      if (sscanf(catched, "%s wirft %s weg", pl, was)==2)  {
      	//tja nun kann was aber die muenze sein, ein schwert usw
      	//und das funzt so nicht daher--->
       
       //wenn im string " " is d.h 2 worte dann erzeugen wir ein
       //array namens was2
      if(strstr(was, " ")!=-1)  {
             	 was2=explode(was, " ");  }

             	 //nur secureabfrage , eigentlich redundant
             	 //wenn mehr als 1 ele im array dann ....

      if(sizeof(was2) > 1 )  {	
      	//z.b 2 eles:  0 1 wir wollen 1!
      	obid=was2[(sizeof(was2)-1)];
      	 //immer letztes nehmen..sollte gehen

      	}
      	
      droped=present(lower_case(obid), environment(TO));
      
      if(droped)  {
      	
      	//hier call_out sonst kommt
      	//der text vom fressen vor dem wegwerftext! btw eben funktionsauruf!
      	friss_ess(droped);
      //das wegwerfen war also kein fake ..obj is da 	
      
        return 1;
      	}
     
     else
     
     	tell_room(environment(TO), 
      	"Die Kuh muht: Aber sowas wie "+was+" ist gar nicht da, "+pl+"!\n");
           
           return 1;
      }	
    return 1;
    }    	
      
      
      friss_ess(object ding)  {
      	
      	if(ding) { //koennte ja weg sein!
      		tell_room(environment(TO), 
      	"Die Kuh frisst "+ding->name(WEN)+" einfach auf!\n");
       ding->remove();	}
       }