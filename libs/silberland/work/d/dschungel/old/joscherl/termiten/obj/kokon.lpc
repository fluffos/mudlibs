#include <properties.h>
#include "../define.h"
#include <combat.h>
#include <moving.h>
#define arten (["kleiner":100,"mittlerer":150,"grosser":200,"riesiger":300])

inherit "std/thing";

int gefunden;

create (string art) { 
  ::create();
  if (!is_clone(TO)) return;
  gefunden=0;
  art=m_indices(arten)[random(sizeof(m_indices(arten)))];
  SetProp(P_SHORT, "Ein "+art+" Kokon");
  SetProp(P_LONG, "Das laengliche, schwarze Objekt vor Dir ist "
    "ungefaehr " +(arten[art])/100 + " Meter lang und 1 Meter "
    "im Durchmesser. Seine "
    "Oberflaeche besteht aus einer Huelle von Palmblaettern, die irgendwie "
    "gehaertet wurden.");
  SetProp(P_NAME, "Kokon"); 
  SetProp(P_NAME_ADJ, art[0..<3]);
  SetProp(P_NOGET, "Der Kokon ist eindeutig zu schwer fuer Dich.\n");
  AddId("kokon"); 
  SetProp(P_WEIGHT, arten[art]*750);
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:10,MAT_CHITIN:50,MAT_MISC_LIVING:40]));
  SetProp(P_INFO, "Mit einem Schneidwerkzeug koennte es dir gelingen, "
    "das Objekt zu oeffnen. Ob das allerdings eine weise Entscheidung ist ?");
  SetProp(P_GENDER, MALE);

  AddDetail("durchmesser", 
    "Ungefaehr ein Meter, rundum mit Palmblaettern umwickelt.");
  AddDetail("huelle",
    "Das ganze Ding ist rundherum in Palmblaetter eingewickelt. Abgesehen "
    "von der schwarzen Farbe sieht es fast aus wie eine Mumie.");
  AddDetail("mumie",
    "Ist aber keine. Eher eine Art Kokon.");
  AddDetail("schneidwerkzeug",
    "Etwas Scharfes, was sonst.");
  AddDetail("entscheidung",
    "Weise oder nicht weise - es ist deine Entscheidung.");
  AddCmd(({"schneide", "schneid"}), "aufschneiden");

}

aufschneiden(string str) {
  string art;
  art=m_indices(arten)[random(sizeof(m_indices(arten)))];
  if (!str) return;
  if (str ==  "kokon auf"||
       str =="kokon"||
       str == "huelle auf" ||
       str == "palmblaetter auf "||
       str == "palmblaetter")
    {
    if ((TP->QueryProp(P_WEAPON)!=0) && 
        member(({"knife","sword","axe"}),
          ((TP->QueryProp(P_WEAPON))->QueryProp(P_WEAPON_TYPE)))!=-1)
      { 
      write("Du zerschneidest die Palmblaetter und oeffnest "
        "vorsichtig den Kokon.\n");
      say(TPN+" macht sich an dem Kokon zu schaffen. Am liebsten "
        "wuerdest Du ihn davon abhalten.\n");
      SetProp(P_SHORT, "Ein geoeffneter Kokon");
      SetProp(P_LONG, "Das laengliche, schwarze Objekt vor Dir ist "
    "ungefaehr " +(arten[art])/100 + " Meter lang und 1 Meter "
    "im Durchmesser. Seine Oberflaeche bestand aus einer Huelle "
    "von Palmblaettern, die offenbar aufgeschnitten wurde.");
      call_out("aufmachen1", 2);
      return 1;
      }
    else write("Ohne etwas Scharfes in der Hand kannst du auch nichts "
      "schneiden...\n");
    return 1; 
    }
  else write("Keine Ahnung, was Du womit schneiden willst.\n");
  return 1;
}

aufmachen1() {
  write("Rings um Dich verdichtet sich die Dunkelheit. Dir ist nicht "
    "gerade geheuer hier.\n");
  if (!random(5)) call_out("totenwaechter", 4);
  else call_out("aufmachen2",2);
}

aufmachen2() {
  write("Als Du die Huellen der Palmblaetter vorsichtig entfernst, "
    "erkennst Du im Inneren des Kokons Umrisse eines humanoiden "
    "Koerpers. Dir wird bewusst, dass es sich hier um eine Leiche "
    "handelt, die allerdings noch recht gut erhalten ist. In der Finsternis "
    "musst du dich bei weiteren Untersuchungen auf deinen Tastsinn "
    "verlassen.\n");
   AddCmd(({"taste", "ertaste"}),"tasten");
}

tasten(string str, object fundgegenstand) {
  notify_fail("Wo willst Du (unappetitlicherweise) herumtasten? \n");
  if (str == "leiche" ||
       str == "in kokon" ||
       str == "kokon"||
       str == "koerper" )
    {
      write("Du versuchst in der Dunkelheit, durch Tasten den Inhalt des "
        "Kokons naeher zu erkunden.\n");
      write("... Dir scheint, als ob sich im Eingangsbereich ein "
        "bedrohlich grosser Schatten aus der Dunkelheit geloest hat.\n");
      clone_object(NPC("totenw"))->move(ROOM("ko_x3y1"), M_TPORT);   
      if (!gefunden) {
        switch(random(100)) {
          case 0..29:
            fundgegenstand =clone_object("/p/armour/"+
            get_dir("/p/armour/*.lpc")[random(sizeof(get_dir("/p/armour/*.lpc")))]);
            fundgegenstand->move(TP);
            write("Du findest " +fundgegenstand->name(WEN, 0)+ " und tastest "
              "gespannt weiter. Du Grabraeuber!\n");
            gefunden=1; break;
          case 30..49:
            write("Auf einmal haeltst Du einen Leichenteil in der Hand ! "
              "Unappetitlich wie Du bist steckst Du das Ding auch noch ein.\n");
            clone_object(OBJ("leichenfood"))->move (TP);
            gefunden=1; break;
          case 50..59:
            TP->AddMoney(100+random(300));
            write("Du ertastest ein paar Muenzen und steckst sie mit schlechtem "
              "Gewissen ein. Das nennt man wohl Leichenfledderei.\n");
            gefunden=1; break;
          case 60..99:
            write("AU !! Irgendetwas beisst dich in die Hand. Du versuchst, dir nicht "
              "zu ueberlegen, was das gewesen sein koennte.\n");
            TP->reduce_hit_points(random(5)); break;
        }      
     }
      else write("Du findest nichts mehr ... langsam ekelt Dir vor Dir selbst ...\n");
      return 1;
      }
}

totenwaechter(){
  write("Oh...oh.\nAuf einmal kommt Bewegung ins Dunkel. Dir wird klar, "
    "dass das Glitzern an den Waenden lebendiger zu sein scheint "
    "als Dir lieb ist...\n");
  clone_object(NPC("totenw"))->move(ENV(TO), M_TPORT);
}

init(object thana) {
  ::init();
  if (TP==id("thanatodendron")) TP->kokonfressen();
}
