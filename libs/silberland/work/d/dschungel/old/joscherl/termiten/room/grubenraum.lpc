/////////////////////////////////////////////
// Grube/oben
////////////////////////////////////////////

inherit "std/room";


#include "../define.h"
#include <moving.h>
#include <properties.h>
#include <language.h>

int kletterrichtung;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem duesteren Bau" );
  SetProp( P_INT_LONG, 
     "In diesem Teil des Tunnelsystems herrscht eine besonders bedrueckende "
     "Duesternis. Die Aktivitaet der Termiten ist hier fuehlbar staerker, "
     "der Geruch viel intensiver. Gerade noch rechtzeitig erkennst Du, dass "
     "Du am Rand einer tiefen Grube stehst. Termiten stroemen hektisch ein "
     "und aus, fallen in die Grube oder klettern deren steile Waende "
     "hinauf. Die Atmosphaere hier ist wie zum Zerreissen gespannt. ");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));

  AddDetail( "boden",
    "Der Boden bricht vor Dir in eine tiefe Grube ab. An den Seiten woelbt "
    "er sich nach oben und geht fliessend in die Waende ueber. Auch hier "
    "ist ueberall diese steinharte Substanz. ");

  AddDetail( ({"teil", "tunnelsystem"}),
    "Du weisst nicht mehr genau, ob das ein grosser, unterteilter Raum oder "
    "ein grosses Tunnelsystem ist. ");

  AddDetail( ({"tunnel"}),
    "Du befindest dich in einem Tunnel. Am Uebergang zwischen Wand und "
    "Decke fuehrt ein weiterer Tunnel beinahe senkrecht nach oben. ");

  AddDetail( ({"waende", "wand"}),
    "Die runden Waende sind sehr unregelmaessig und weisen zahlreiche "
    "Vorspruenge und Nischen auf. Ueberall ragen verkeilte Baumstaemme "
    "heraus. Wo die Waende in die Decke uebergehen, fuehrt auch hier ein "
    "beinahe senkrechter Tunnel weiter nach oben und ist schwarz vom "
    "Gewimmel der Insekten. ");

  AddDetail( "decke",
    "Wo sich die Waende zur Decke runden, fuehrt auch hier ein dunkler "
    "Tunnel nach oben. ");

  AddDetail( ({"insekten","termiten", "bau"}),
    "Hier in ihrem Bau sind die Termiten so zahlreich, dass du den "
    "Eindruck einer brodelnden schwarzen Masse bekommst, die Dich "
    "unweigerlich in sich hineinzieht. Besonders die Grube vor Dir ist ein "
    "Inferno aus Insektenleibern. ");

  AddDetail( ({"klumpen"}),
    "Manchmal ballen sich 5, 10 Termiten zu einem zuckenden, bebenden "
    "Klumpen zusammen. ");

  AddDetail( ({"grube", "inferno"}),
    "Die Grube ist 7 oder 8 Meter tief, ihre Raender sind glitschig durch "
    "die feuchten Baumstaemme, aus denen der Tunnel besteht. Du musst "
    "hoellisch aufpassen, da nicht hineinzufallen. Unten liegt irgendetwas "
    "Grosses, dass vom Gewuehl der Insekten verdeckt wird.");

  AddDetail( ({"raender", "rand"}),
    "Aufpassen "+TPN+", aufpassen... ");

  AddDetail( "grosses",
    "Du denkst o O (was ist das bloss?) \n"
    "Von hier aus kann man leider nichts erkennen. Du bist voller Neugier, "
    "aber in der Grube siehts ausgesprochen ungemuetlich aus...");

  AddDetail( ({"atmosphaere", "aktivitaet", "aufregung", "zerreissen"}),
    "Irgendetwas hier verursacht eine unglaubliche Aufregung bei den "
    "Termiten ... ");

  AddDetail( ({"substanz","zement"}),
    "Diese Substanz verbindet die verkeilten Baumstaemme wie Zement. "
    "Sie glitzert nachtblau in Schein deiner Lichtquelle. ");

  AddDetail( ({"gewuehl","gewimmel", "insektenleiber"}),
    "Unzaehlige Insekten klettern, fallen,  teilweise zu lebendigen Klumpen "
    "zusammengeballt, in die Grube, aus der Grube, den Tunnel entlang, "
    "Richtung Decke ... grausig. ");

  AddDetail( ({"eindruck"}),
    "Entsetzlich.... und doch...... ");

  AddDetail( ({"masse", "angst", "bahnen", "denken"}),
    "Irgendetwas Unbestimmtes will Dich in diese Masse ziehen und nicht "
    "mehr loslassen. Schweissperlen rinnen ueber deine Stirn, Dein Denken "
    "laeuft in ungeordneten Bahnen ab... ");

  AddDetail( ({"unbestimmtes", "maechtiges", "belastung"}),
    "Etwas sehr maechtiges. Du stoehnst unter dieser Belastung... ");


  AddDetail( ({"baumstaemme", "staemme", "holz"}),
    "Die Baumstaemme ragen windschief aus dem Boden und der Wand. "
    "In der Duesternis musst du aufpassen, nicht dagegen zu stossen. ");

  AddDetail( ({"lichtquelle", "duesternis", "schein"}),
    "Mit zitternder Hand haeltst Du Deine Lichtquelle.");

  AddDetail( ({"hand", "haende"}),
    "                               *zitter-schepper-schwitz-nervoeskratz*");

  AddDetail( ({"uebergang", "seiten"}),
    "Der Uebergang zwischen Boden, Waenden und Decke ist rund und "
    "fliessend. ");

  AddSmell(({DEFAULT_SMELL, "geruch"}),
      "Der beissende Geruch wird immer unertraeglicher. Deine Nase laeuft, "
      "deine Augen traenen. ");

  AddSound(({DEFAULT_SOUND, "Rumpeln"}),
      "Nebem dem zischenden Geraeusch der Insekten hoerst Du ein dumpfes "
      "Rumpeln, als ob sich etwas sehr Grosses in der Grube hin und her "
      "waelzen wuerde.");

  AddSound(({"geraeusch"}),
      "Du wuenschst Dir, es wuerde endlich aufhoeren.");

  AddDetail(({"nase", "augen","schleimhaeute"}),
     "Die Substanz greift deine Schleimhaeute an.");

  AddDetail( ({"vorspruenge", "nischen", "woelbungen"}),
    "Die Waende sind rund, aber unsymmetrisch und weisen zahlreiche "
    "Vorspruenge und Nischen auf, die dem Raum ein wabenartiges Gepraege "
    "geben. ");

  AddDetail( "gepraege",
    "Wabenfoermig.");

  AddDetail( ({"stirn", "schweiss", "schweissperlen"}),
    "Von Deiner Stirn rinnt kalter Schweiss. ");
  
  AddDetail(({"neugierde", "neugier"}), 
    "Deine Neugierde kannst Du nur befriedigen, wenn Du dich in die Grube "
    "wagst. Zum Runterklettern ist es allerdings zu steil. ");

  AddDetail("runterklettern",
    "Geht nicht. Da hilft nur springen.");

  AddCmd( ({"spring","springe"}), "spring");

  AddCmd( ({"kletter","klettere"}), "schacht_klettern");
}

int spring(string str){
  object ob;
  if (!strlen(str))
    return write("Wo willst Du hineinspringen?\n") ,1;
  if (!member( (["grube","inferno", "in grube", "in inferno"]), str))
    return write("Wo willst Du hineinspringen?\n") ,1;
  TP->move(ROOM("grube"), M_NOCHECK | M_NO_SHOW, 
    "in die Grube", "springt", "faellt neben Dir in die Grube");
return 1;
}

int schacht_klettern(string str){
  object ob; 
  if (!strlen(str))
    return write("Klettern - ja, warum nicht. Aber wohin?\n"), 1;
  if (!member( (["schacht", "in den schacht", "in schacht"]), str))
    return write("Wohin willst du hier klettern?\n"), 1;
  TP->move (ROOM("schacht"), M_GO, 
    "muehsam in den Schacht", "klettert", "klettert in den Schacht");
return 1;
}


