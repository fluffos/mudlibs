/////////////////////////////////////////////
// Verbindungsschacht
////////////////////////////////////////////

inherit "std/room";

#include "../define.h"
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <player.h>
int richtung;

create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einem duesteren Bau" );
  SetProp( P_INT_LONG, 
     "Du steckst in einem dunklen, beinahe senkrechten Schacht. "
     "Es kostet Dich grosse Muehe, nicht vom Strom der Termiten mitgerissen "
     "zu werden.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));

  AddDetail( ({"schacht","roehre","verbindungsschacht"}),
    "Der Schacht ist rund wie eine Roehre, beinahe senkrecht und hat einen "
    "Durchmesser von ca 3 Metern. Ein nicht enden wollender Strom von "
    "Termiten macht das Klettern zu einer aeusserst gefaehrlichen Aufgabe. ");

  AddDetail( ({"aufgabe", "problem"}),
    "Was fuer die Termiten kein Problem ist, uebersteigt beinahe deine "
    "Faehigkeiten. ");

  AddDetail( ({"strom", "termitenstrom"}),
    "Da es sich hier offenbar um einen Verbindungsschacht handelt, draengt " 
    "sich ein nicht enden wollender Termitenstrom an dir vorbei. Du fuehlst "
    "Dich wie in der U1 zur Stosszeit. ");

  AddDetail( ({"u1", "stosszeit", "nichtwiener"}),
    "Fuer Nichtwiener: da isses eng und es stinkt. ");

  AddDetail( ({"muehe"}),
    "Du schwitzt und keuchst. Warum ist in diesem Gebiet alles so muehsam? ");

  AddDetail( ({"gebiet"}),
    "Das Gebiet der Termiten. ");

  AddDetail( ({"termiten"}),
    "Sehr sehr viele. Du musst aufpassen, nicht deinen Halt zu verlieren. ");

  AddDetail( ({"halt"}),
    "Du findest in dem Schacht kaum einen Halt. ");

  AddDetail( ({"durchmesser"}),
    "Gerade weit genug damit die Termiten aneinander vorbei koennen, und "
    "nicht eng genug damit du raufspreizen kannst. ");

  AddDetail( ({"klettern", "griffleisten", "wand", "waende"}),
    "Du ziehst Dich extrem instabil an winzigen Griffleisten hinauf. "
    "Leider ist der Schacht zu weit, um dich mit den Beinen zu verspreizen. "
    "Wirklich guten Halt findet man nur hier und da an einem aus der Wand "
    "ragenden Schenkelknochen oder in der Augenhoehle eines Totenschaedels.");

  AddDetail( ({"beine"}),
    "Die zittern genauso wie Deine Haende. ");

 AddDetail( ({"haende"}),
    "Die zittern genauso wie deine Beine. ");

  AddDetail( ({"meter"}),
    "Ungefaehr 3. ");

  AddDetail( ({"augenhoehle", "schenkelknochen", "totenschaedel",
		 "anhalten"}),
    "Perfekt zum Anhalten. ");

  AddDetail( ({"faehigkeiten"}),
    "Die reichen kaum aus.");

  AddDetail( ({"boden", "decke"}),
    "Der Schacht ist beinahe senkrecht, Boden und Decke gibts hier nicht.");
  
}

void kontrolle(){
  write ("Richtung="+richtung+"\n");
}

void rausschmiss(){
  write("\n"+bs(                           *WUUUUPS!!*\n"
    "Du verlierst Deinen Halt und der entgegenkommende "
    "Termitenstrom reisst Dich wieder zurueck zu deinem "
    "Ausgangspunkt. Momentan kommst Du da nicht durch."+"\n"));
  TP->move(TP->QueryProp(P_LAST_COMMAND_ENV),
    M_GO, "verliert den Halt und", "wird zurueckgerissen", 
    "wird von den Termiten hereingerissen");
}

void enter(object pl) {
  if (find_call_out("richtungswechsel") != -1) return;
  richtung = random(2);
  call_out("richtungswechsel",30+random(30));
  kontrolle();
}

init(){
  ::init();
  if (interactive(TP)) enter();
  if ((file_name(TP->QueryProp("last_command_env")) == 
    ROOM("grubenraum")) &&
    richtung == 0) call_out("rausschmiss", 3); 
}


int richtungswechsel(){
  tell_room(TO, "Richtungswechsel\n");
  if (richtung == 0) return ++richtung;
  if (richtung == 1) return --richtung; 
}

