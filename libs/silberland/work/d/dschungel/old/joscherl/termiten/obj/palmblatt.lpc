#include <properties.h>
#include "../define.h"
#include <combat.h>

inherit "std/thing";

create (string art) { 
  ::create();
  if (!is_clone(TO)) return;
 
  SetProp(P_SHORT, "Zerfetzte Palmblaetter");
  SetProp(P_LONG, "Einige voellig zerfetzte Palmblaetter liegen verstreut auf "
     "dem Boden herum. ");
  SetProp(P_NAME, 
    ({"Palmblaetter", "Palmblaetter", "Palmblaettern", "Palmblaetter"})); 
  SetProp(P_WEIGHT,500);
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:10]));
  SetProp(P_GENDER, NEUTER);
  AddId(({"palmblatt", "blatt", "palmblaetter"}));
}
