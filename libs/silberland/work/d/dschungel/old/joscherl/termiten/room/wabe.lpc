////////////////////////////////
//  In einer Brutwabe (leer)  //
////////////////////////////////

inherit "std/room";

#include "../define.h"
#include <properties.h>
#include <language.h>
#include <player.h>


create()
{
  ::create();
  SetProp( P_INT_SHORT, "Eingeklemmt" );
  SetProp( P_INT_LONG, 
    "Du steckst Kopf voran in einer der wabenartigen Aushoehlungen, "
    "eingetaucht in dieses blaue Leuchten, das hier besonders stark ist. "
    "Drin ist allerdings nichts ... die Bewegungen waren offenbar "
    "eine Taeuschung. Die Enge macht Dir schwer zu schaffen, Du kannst "
    "Deine Arme und Beine kaum bewegen. Du fragst Dich, wie Du hier "
    "wieder herauskommst - und ob Du das ueberhaupt willst.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"wabe"}),
    QueryProp(P_INT_LONG));
  AddDetail( ({"kopf"}), 
    "Dein Kopf ist einer der wenigen Koerperteile, die du noch bewegen "
    "kannst.");
  AddDetail( ({"aushoehlungen"}), 
    "Du bist gerade in eine hineingekrochen."); 
  AddDetail( ({"bewegungen"}), "In dieser Wabe bewegt sich nichts. Auch "
    "Du hast damit Probleme.");
  AddDetail( ({"taeuschung"}), 
    "Du musst dich draussen gestaeuscht haben.");
  AddDetail( ({"arme","fuesse", "beine", "gliedmassen"}), 
    "Die Wabe ist sehr eng... du kannst deine "
    "Gliedmassen kaum bewegen.");
  AddDetail( ({"enge", "eng"}), 
    "Eng wie in einem Sarg. Oder wie im "
    "Mutterleib. Du erinnerst Dich an gluecklichere und sorgenlosere "
    "Zeiten. ");
  AddDetail( ({"leuchten"}), 
    "Das Leuchten umfliesst dich hier beinahe greifbar wie Plasma. "
    "Du wirst von einem wohltuenden, irgendwie einschlaefernden Gefuehl "
    "in Besitz genommen.");
  AddDetail( ({"plasma"}), 
    "Das Leuchten umfliesst Deinen Koerper wie Plasma.");
  AddDetail( ({"gefuehl"}), 
    "Sehen kannst du es nicht, aber du fuehlst es ganz stark und "
    "besitzergreifend.");
  AddDetail( ({"besitz"}), 
    "Etwas in Dir baeumt sich auf, wird aber durch das Leuchten besaenftigt "
    "und beschwichtigt... du fuehlst dich endlich Zuhause...");
  AddDetail( ({"probleme"}), 
    "Du hast Probleme Dich zu bewegen. Und auch andere. Aber irgendwie "
    "verlieren die Probleme hier ihre Wichtigkeit. ");
  AddDetail( ({"wichtigkeit","last"}), 
    "Was ist schon wichtig...warum all die Sorgen...was ist ein "
    + capitalize(TP->QueryProp(P_RACE)) + " im Prinzip doch fuer "
    "ein armseliges Lebewesen...so schwach und einsam... " );
  AddDetail( ({"koerperteile"}), 
    "Deine Koerperteile kommen Dir irgendwie unzulaenglich vor... so "
    "dick und plump und doch so schwach...und langsam... ");
  AddDetail( ({"koerper","unzulaenglichkeiten","existenz"}), 
    "Dein Koerper wird hier keinen Schaden leiden...das fuehlst Du genau..."
    "irgendwie war er ohnehin so unzulaenglich...du bist soo gluecklich");
  AddDetail (({"schaden"}),
    "Nichts und niemand wird hier Deinem Koerper Schaden zufuegen, nein, "
    "Du wirst nur von Deinen Unzulaenglichkeiten befreit werden.");
  AddDetail (({"sarg","mutterleib","augenblick"}),
    "Nur einen kurzen Augenblick dachtest Du an einen Sarg.. nein, das "
    "hier ist eher das Gegenteil... die Geburt eines neuen Lebens ");
  AddDetail( ({"geburt", "leben", "gegenteil",
               "gluecksgefuehl","gefuehl","ich"}),
    "Ein Gluecksgefuehl durchflutet Dich ... nur eine ganz leise Stimme "
    "tief in Deinem Unterbewusstsein scheint sich dagegen "
    "aufzubaeumen...");
  AddDetail( ({"unterbewusstsein", "stimme"}),
    "'WAS GEHT HIER AB? HIER IST ETWAS FAUL!'");
  AddDetail( ({"boden","decke","wand", "waende"}),
    "Die Wabe ist sehr eng. Man kann kaum von Boden, Decke oder "
    "Waenden sprechen. Eine Oeffnung gibts, durch die Du reingekrochen "
    "bist, sonst nur bedrueckende Enge.");
  AddDetail( ({"oeffnung"}),
    "Durch die bist du da hinein gerobbt. Sie ist hinten bei Deinen "
    "Fuessen.");
  AddDetail( ({"zeiten"}),
    "Zeiten ohne Verantwortung, beschuetzt, gehuetet von einem "
    "staerkeren Wesen, frei von Sorge...");
  AddDetail( ({"sorge", "verantwortung","glueck","zufriedenheit"}),
    "Nur noch Glueck und Zufriedenheit.");
  AddDetail( ({"wesen"}),
    "Hier gibts es ein staerkeres Wesen, dass Dich fuehren und leiten "
    "wird. Hoer auf Dich zu wehren...entledige Dich der Last deiner "
    "humanoiden Existenz !");
  AddDetail( ({TP->QueryProp(P_RACE)}),
    "Was fuer eine laecherliche Rasse, der Du da angehoerst! Wie "
    "unbedeutet, wie verwundbar, wie verletzlich! Loese Dich von dem "
    "Kaefig Deines armseligen humanoiden Koerpers!");
  AddDetail( ({"kollektiv"}),
    "Das Kollektiv ist G U U U T . . . es wird Dich A U F N E H M E N !"); 
  AddRoomMessage(({
    "Du fuehlst Dich einfach wohl...gluecklich wie im Mutterleib..\n",
    "All Deine Verantwortung scheint von Dir genommen zu werden...\n",
    "Das blaue Leuchten huellt Dich ein... wie troestlich...\n",
    "Etwas in Dir wehrt sich... Dein Ich baeumt sich auf... wozu?\n",
    "Versuche nicht dagegen anzukaempfen... kaempfe doch nicht gegen dein "
    "Glueck!\n",
    "'Loese Dich von deinem unzulaenglichen Koerper! Gehe ein ins "
    "Kollektiv!'\n",
    "Eine tiefe Stimme fluestert: 'Komm zu mir, "
    +UPPER(TP->QueryProp(P_RACE))+ 
    "! Du wirst es nicht bereuen...\n",
    "************ KOMM! KOMM! BLEIB BEI UNS! ***********\n",
      "Du bist gluecklich... sooo gluecklich... wie ein Neugeborenes...\n",}),
    50); 
}

