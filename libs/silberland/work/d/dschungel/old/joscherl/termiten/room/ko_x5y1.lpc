/////////////////////////
// Kokons/Suedostecke
/////////////////////////

#include "../define.h"
#include <properties.h>
#include <language.h>

inherit ROOM("inh_kokons.lpc");


create()
{
     ::create();

  SetProp( P_INT_LONG, 
    "Du befindest Dich in der suedoestlichen Ecke des Gewoelbes, das "
    "hier durch masssives, mit Baumstaemmen verstaerktes Erdreich begrenzt "
    "wird. Im Norden und Westen siehst Du lange Reihen der schwarzen "
    "kokonartigen Objekte, die in voellig praezisen, geradezu geometrischen "
    "Abstaenden angeordnet wurden. Kein Laut ist zu vernehmen, du kannst auch "
    "keine Bewegungen erkennen, die auf Termiten hindeuten wuerden. Du "
    "glaubst jedoch, an der nachtschwarzen Wand das Glitzern von "
    "Facettenaugen sehen zu koennen.  ");

  AddDetail(({"osten","sueden", "ende"}),
    "Das Gewoelbe wird hier durch das massive, mit Baumstaemmen "
    "verstaerkte Erdreich begrenzt. ");

  AddDetail( ({"wand", "waende"}),
    "Im Osten und Sueden beginnt das massive, durch Baumstaemme "
    "verstaerkte Erdreich. Hier wird das Gefuehl beobachtet zu werden, "
    "besonders stark.");

  AddExit("norden", ROOM("ko_x5y2"));
  AddExit("westen", ROOM("ko_x4y1"));


}
