/*
* Dschungelsackgasse
*/


#include "../define.h"
#include <moving.h>
#include <attributes.h>

inherit ROOM("inh_deadend");

int forschstatus;

create()
{
  ::create();
  forschstatus=0;

  AddDetail( ({"kletterpflanzen", "ranken"}),
    "Zahlreiche Kletter- und Schlingpflanzen winden sich hier wieder um "
    "die Dschungelriesen. Du weisst nicht genau was es ist, aber "
    "irgendetwas irritiert dich hier. ");

  AddDetail( ({"etwas", "irgendetwas"}),
    "Bei laengerem Hinsehen denkst Du dir, dass die Kletterpflanzen zu "
    "regelmaessig angeordnet sind, um natuerlich gewachsen zu sein. ");

  AddDetail( ({"regelmaessig", "natuerlich"}),
    "Du bist Dir nun beinahe sicher, dass sie absichtlich so angeordnet "
    "wurden, wie um etwas zu verdecken. Eine Liane faellt dir besonders "
    "auf.");
  
  AddDetail( ({"liane", "ende"}),
    "Ein Ende der Liane baumelt einladend vor deiner Nase.");

  AddDetail( ({"nase"}),
    "Laenger denn je.");
  AddSpecialDetail("wall", "wall");
  AddSpecialDetail(({"baumstaemme", "staemme"}), "baumstaemme");

  AddCmd(({"ziehe", "zieh", "reisse", "reiss"}), "liane");

  AddCmd(({"klettere", "kletter"}), "klettern");

}

int liane (string str) {
  if (member(({"zieh", "ziehe"}), query_verb())!=-1)
    {
     if (!str) write("Woran willst Du ziehen?\n");
     if (member(({"an liane", "liane"}), str)!=-1)
       write ("Da tut sich nix. Vielleicht solltest Du es fester "
         "probieren.\n");
     if (member(({"fester an liane", "fest an liane"}), str)!=-1)
       write ("Hm. etwas hat sich gelockert. Reiss nochmal an mit aller "
         "Gewalt!\n");
       return 1;
    }   
  if (member(({"reisse", "reiss"}), query_verb())!=-1)
    {
    if (!str) write("Woran willst Du reissen?\n");
    if (member(({"an liane", "liane", "fest an liane"}), str)!=-1)
      {
      write("Du reisst mit aller Gewalt an der Liane und springst erschrocken "
        "zur Seite, als Dir eine Lawine von Schlingpflanzen entgegenkommt.\n"
        "Als Du Dich aus dem Wirrwarr befreit hast, erkennst Du, dass sich "
        "hinter dem natuerlichen Pflanzenvorhang ein penibel "
        "aufgeschichteter Wall aus Baumstaemmen befindet.\n");
      forschstatus=1;
      }
      return 1;
    }
}

klettern (string str) {
  if (forschstatus==0) return 0;
  if (forschstatus!=0 &&!str) 
    {
    write("Ja, das ist eine Idee. Aber worueber?\n");
    return 1;
    }
  if (forschstatus!=0 &&
      member(({"ueber wall", "auf wall", "ueber baumstaemme"}), str)!=-1)
    {
     if ((TP->QueryAttribute(A_DEX))>(random(10)+10))
       {
        write("Im Schweisse Deines Angesichtes erkletterst Du den Wall.\n"
          "Oben angelangt, verlierst Du jedoch das Gleichgewicht und "
	  "plumpst wie ein Mehlsack auf der anderen Seite runter.");
        TP->move(ROOM("termstr1"), M_GO);
        forschstatus=0;
       }
     else write("Du rutscht auf den glatten Staemmen aus und faellst auf "
       "deinen weichsten Koerperteil: deine Birne.\n");
     return 1;
    }
}

string wall() {
  if (forschstatus==1) return
    "Eine eigenartige Barriere aus aufeinandergeschichteten Baumstaemmen.\n";
  else return "Sowas siehst Du da nicht!\n";
}

string baumstaemme () {
  if (forschstatus==1) return
    "Hinter den Dschungelriesen versperrt Dir ein Wall aus Baumstaemmen "
    "die Sicht.\n";
  else return "Die Dschungelriesen scheinen hier in einem besserem Zustand zu "
    "sein.\n";
}

    