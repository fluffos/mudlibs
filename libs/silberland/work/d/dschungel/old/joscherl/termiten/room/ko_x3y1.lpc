////////////////////
//    Totenhalle    //
////////////////////

inherit "std/room";

#include "../define.h"
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>



create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einer Totenhalle" );
  SetProp( P_INT_LONG, 
    "Rings um Dich entsteht aus dem Halbdunkel ein gespenstischer Anblick. "
    "Du befindest Dich in einem niedrigen, aber weit ausgedehnten Gewoelbe, "
    "das sicherlich die gesamte Saeule unterminiert. Soweit Du den Boden "
    "des Gewoelbes zu ueberlicken vermagst, erkennst Du schwarze "
    "kokonartige Objekte, die in voellig praezisen, geradezu geometrischen "
    "Abstaenden angeordnet wurden. Kein Laut ist zu vernehmen, du kannst auch "
    "keine Bewegungen erkennen, die auf Termiten hindeuten wuerden. Du "
    "glaubst jedoch, an der nachtschwarzen Wand das Glitzern von "
    "Facettenaugen sehen zu koennen.  ");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"halbdunkel", "dunkelheit", "dunkel"}), 
    "Nur durch deine Lichtquelle vermagst Du hier etwas zu sehen. Die "
    "Dunkelheit und Totenstille lasten zentnerschwer auf "
    "deiner Psyche.");

  AddDetail( ({"psyche", "druck"}), 
    "Deine Psyche ist eindeutig unter Druck.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));

  AddDetail( ({"gewoelbe", "decke"}), 
    "Du kannst nichts Genaues erkennen, aber Du vermutest, das dieses "
    "Gewoelbe wie die gesamte Saeule durch Baumstaemme getragen wird.");

  AddDetail( ({"genaues"}), 
    "Es ist zu dunkel um etwas Genaues zu erkennen.");

  AddDetail( ({"termiten","insekten", "termite"}), 
    "Du vermagst auf den ersten Blick keine zu entdecken. Hier ist es "
    "beaengstigend still. Dennoch fuehlst Du dich irgendwie beobachtet.");

  AddDetail( ({"saeule"}), 
    "Du befindest Dich unter ihr.");

  AddDetail( ({"boden"}),
    "Ueberall stehen in exakten Abstaenden diese schwarzen kokonartigen "
    "Objekte. Du spuerst ferner keine Unebenheiten. Dieses Gewoelbe wurde "
    "offenbar mit groesster Sorgfalt angelegt.");

  AddDetail( ({"sorgfalt", "bedeutung"}), 
    "Scheinbar hat dieses Gewoelbe fuer seine Erbauer eine besondere "
    "Bedeutung. ");

  AddDetail( ({"erbauer"}),
    "Wohl die Termiten."); 

  AddDetail( ({"kokon", "kokons", "kokone", "objekte"}), 
    "Sicher Hundert der laenglichen schwarzen Objekte sind wie in Reih und "
    "Glied am Boden ausgerichtet. Du bist Dir nicht sicher, worum es sich hier "
    "handelt. Deine Neugier jedoch waechst. ");

  AddDetail( ({"hundert"}), 
    "Einfach sehr viele.");

  AddDetail( ({"reih", "reihe"}), 
    "Verstehe, Du warst Zivildiener.");

  AddDetail( ({"zivildiener"}),
    "Offenbar doch nicht. ");

  AddDetail( ({"glied", "kommentar"}),
    "Kein Kommentar. Frag wen anderen, vielleicht Elvira.");

  AddDetail( ({"abstaende"}),
    "Voellig regelmaessig. Das Ganze hat etwas Unheimliches. ");

  AddDetail( ({"ganze","summe"}),
    "Die Summe seiner Teile."); 

  AddDetail( ({"teile"}),
    "Ihre Summe ergibt das Ganze."); 

  AddDetail( ({"anblick"}),
    "Der Anblick ist ebenso gespenstisch wie unerwartet. Hier war offenbar "
    "eine planende Intelligenz am Werk. ");

  AddDetail( ({"werk"}), 
    "Ein erstaunliches Werk, wenn momentan auch nicht ganz verstaendlich.");

  AddDetail( ({"laut"}),
    "Und zu sehen ist er schon gar nicht.");

  AddDetail( ({"bewegungen", "gewuehl"}),
    "Nachdem Dich das Gewuehl der Insekten weiter oben beinahe in Panik "
    "versetzt hat, bist Du gar nicht so ungluecklich, dass hier anscheinend "
    "keine einzige Termite herumkriecht. ");

  AddDetail( ({"panik"}), 
    "Du fuehlst hier keine Panik, aber alles andere als wohl.");

  AddDetail( ({"wand", "waende"}),
    "Irgendetwas ist da an der Wand und beobachtet Dich. ");

  AddDetail( ({"facettenaugen", "facetten", "augen"}),
    "Es ist dieses reflektierende und doch matte Glitzern, dass Dich, solltest "
    "Du hier jemals wieder rauskommen, noch lange in deinen Traeumen "
    "verfolgen wird. ");

  AddDetail( ({"traeume", "traum"}), 
    "Du erinnerst Dich an die Traeume der letzten Nacht und seufzt. "); 

  AddDetail( ({"intelligenz"}),
    "Wusst ichs doch, dass Du mit dem Wort wenig anfangen kannst.");

  AddDetail( ({"wort", "anfang"}),
    "Am Anfang war das Wort. Mit dem Du offenbar wenig anfaengst. \nFalls "
    "Dir dieses einzigartige Wortspiel zusagt, bedanke Dich hoeflich bei "
    "Joscherl mit dem Befehl <idee Joscherl spar Dir solche sinnlosen "
    "Details>. Wenn Du zu den ersten 10 gehoerst, wird Dir Joscherl als "
    "Belohnung ein schoenes magisches Item clonen. ");

  AddDetail( ({"wortspiel", "befehl", "details", "belohnung", "item"}),
    "Schluss jetzt. ");

  AddDetail( ({"staemme", "baumstaemme"}),
    "Du vermutest das nur. Erkennen kannst Du nichts. ");

  AddDetail( ({"blick"}),
    "Ob es ratsam ist, einen zweiten zu riskieren ? ");

  AddDetail( ({"gewuehl"}),
    "Das hat hier voellig aufgehoert.");

  AddSpecialDetail( ({"neugier"}), "nixwimpy");
  
  AddDetail( ({"unebenheit"}),
    "Ganz im Gegenteil zum Rest des Baues finden sich hier keine Unebeheiten."
    "Halt ... stimmt nicht ganz, gerade bist du mit dem Fuss an etwas "
    "gestossen. ");

  AddDetail( ({"fuss", "stueck"}),
    "Du hast einen Gegenstand mit dem Fuss ein Stueck weiter gestossen.");

  AddDetail( ({"gegenstand"}), 
    "Er muss irgendwo am Boden herumliegen. Sehen kann man ihn wohl nicht "
    "in der Dunkelheit. ");

  AddCmd(({"taste", "ertaste"}), "ertasten");

  AddExit("norden", ROOM("ko_x3y2"));
  AddExit("osten", ROOM("ko_x4y1"));
  AddExit("westen", ROOM("ko_x2y1"));
  AddExit("suedoben",([ 
    EX_DEST: "/players/joscherl/workroom.lpc",
    EXG_ID: "megalovore",
    EXG_PLMSG: "@@killhim@@",
    EXG_RMMSG: "Die Megalovoren versperren @wem@ den Ausgang.\n"]) );
    
}

string killhim () {
  catch(present("megalovore", TO)->Kill(TP));
  return "Die Megalovore greift Dich sofort mit aller Brutalitaet an. "
    "Hier kommst Du nur noch schwer durch.\n";
}

nixwimpy() {
  write("Deine Neugier laesst Dich deine _Vorsicht_ manchmal vergessen. " 
    "Wie jetzt zum Beispiel.\n Was sich wohl in diesen Objekten verbirgt ?\n");
  TP->SetProp(P_WIMPY, 0);
}

ertasten (string str) {
  if (!str) write ("Du weisst wohl nicht so recht wo du tasten sollst.\n");
  if (str == "am Boden" || "Boden" || "gegenstand"|| "nach gegenstand"||
    "boden"||"am boden"||"Gegenstand"||"nach Gegenstand") 
    write ("Vor Dir kannst du nichts ertasten. Vielleicht solltest Du es bei "
      "dem Kokon nahe dir probieren.\n");
  if (str=="nach gegenstand bei kokon"||"nach Gegenstand bei Kokon"||
    "bei kokon nach gegenstand"||"bei Kokon nach Gegenstand")
    write ("Tatsaechlich, da ist etwas. Du nimmst den Gegenstand an Dich.\n");
}

    

