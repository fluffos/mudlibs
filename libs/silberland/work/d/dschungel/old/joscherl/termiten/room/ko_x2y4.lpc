#include "../define.h"
#include <properties.h>
#include <language.h>

inherit ROOM("inh_kokons.lpc");

create()
{
     ::create();

  AddDetail(({"westen", "ende"}),
    "Das Gewoelbe wird hier durch das massive, mit Baumstaemmen "
    "verstaerkte Erdreich begrenzt. ");

  AddDetail( ({"wand", "waende"}),
    "Im Westen beginnt das massive, durch Baumstaemme verstaerkte Erdreich. "
    "Hier wird das Gefuehl beobachtet zu werden, besonders stark.");

  AddExit("norden", ROOM("ko_x2y5"));
  AddExit("sueden", ROOM("ko_x2y3"));
  AddExit("osten", ROOM("ko_x3y4"));
  AddExit("westen", ROOM("ko_x1y4"));

}
