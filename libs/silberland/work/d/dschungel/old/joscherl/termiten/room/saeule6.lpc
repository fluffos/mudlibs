

#include "../define.h"
#include <properties.h>
#include <language.h>

inherit ROOM("inh_saeule");

create()
{
  ::create(); 
  SetProp( P_INT_LONG, bs(
     "Du kaempfst Dich im Sueden der Lichtung zwischen den zahllosen "
     "Insekten durch. In ihrer Mitte ragt eine riesige Saeule mit "
     "einem Durchmesser von gut 20 Metern auf. Zahllose Baumstaemme "
     "wurden zu diesem gewaltigen Turm zusammengefuegt, dessen "
     "Unregelmaessigkeit davon zeugt, dass er nicht von menschlichen "
     "Lebewesen erbaut wurde. Durch dunkle Oeffnungen am Fuss der "
     "Saeule stroemen die Insekten ein und aus.Du befindest Dich vor "
     "dem Nest des Termitenstaates."));  
  
  AddExit("westen", ROOM("saeule7"));
  AddExit("nordosten", ROOM("saeule5")); 
   
 }
