/***********************************
*  salomrog der troll-rechtsgelehrte
*  Joscherl@Silberland
************************************/

inherit "std/mnpc";
#include "define.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <wizlevels.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();     

  SetProp(P_SHORT, "salomrog der Troll-Rechtsgelehrte");

  SetProp(P_LONG, 
    "Du schaust von ganz weit unten zu dem riesigen Troll empor, der sich vor "
    "Dir aufbaut. Fett ist er auch, und das nicht schlecht. Ungefaehr auf Hhe "
    "deiner Nase schwabbelt ein gigantischer Bauch, weiter oben ein Brustkorb "
    "gross wie der Vogelkaefig eines Flugsauriers. Unterhalb der Fettmassen "
    "traegt das Ungetuem einen Lendenschurz aus verfaultem Schilf. Diese "
    "ausgesprochen ungepflegte Erscheinung schultert weiters mit der Linken eine "
    "Keule in der Groesse eines stattlichen Baeumchens, die sie dann und wann "
    "zaertlich  zu taetscheln scheint und --- ja seltsam, in der Rechten eine "
    "Waage, mit der wohl normalerweise Weidevieh gewogen "
    "wird. Eines ist allerdings ebenso offensichtlich wie seltsam; Salomrog "
    "ist augenscheinlich blind. Trotz des gut erhaltenen Hobbitfells, mit dem "
    "seine Augen verbunden sind, tappt er dennoch erstaunlich gewandt herum.");

  SetProp(P_NAME, "Salomrog");
  SetProp(P_RACE, "Troll");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SIZE, (400));
  AddId(({"salomrog", "salomon", "salo"}));

  create_default_npc( 60 );

  SetProp(P_BODY, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit der todbringenden Keule", 500}));

  SetProp(P_WIMPY, 0);
  SetProp(P_ALIGN, 0); 
  SetProp( P_RESISTANCE_STRENGTHS,([
    DT_FIRE: 0.7, DT_MAGIC:-0.6, DT_HOLY:-0.8, DT_UNHOLY:-0.8, DT_ACID:0.3,
    DT_TERROR:-1.0
  ]));

  SetProp(P_MSGIN, "tappt mit donnerndem Schritt herein");
  SetProp(P_MSGOUT, "trampelt");
  SetProp(P_MMSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MMSGOUT, "verschwindet um wiederzukehren");
   
 
  SetProp(P_MNPC_FLAGS, 
    MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_MAYLOAD );
  SetProp(P_MNPC_WAIT, ({500+random(50), 30, 20}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM("ko_x3y3"));

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Salomrog ist unbestechlich.\n" }) );

 SetChats(5, ({
  "Salomrog taetschelt seine Keule.\n",
  "Der Troll grunzt etwas unverstaendliches.\n",
  "Das Ungetuem murmelt: \"Semper bis in idem ..... uga ?!\"\n",
  "Der Troll lacht laut auf und bruellt: \"Nulla poena sine Keule harr harr harr\"\n",
  "Das Wesen vor Dir ist ehrfurchtgebietend und laecherlich zugleich.\n",
  "Der Troll stammelt: \"Verehrung, Herr Rat. Beantrage wie im schriftlichen "
  "Um.... aeh.... Vorbringen.\n",
  "Der Schilflendenschurz des Trolls knackt, als er sich ungeniert am Hintern "
  "kratzt.\n",
  "\Gestatten, Dr. Salomrog mein Name, LL.M Trollvard Universitaet.\"",
  "Das Wesen reicht Dir eine Visitenkarte in Gestalt eines wohlmeinenden "
  "Faustschlages auf die Schulter.\n",
  }) );

  AddInfo( DEFAULT_INFO,
    "Ich bin Rechtsgelehrter, kein Wissenschaftler !\n",
    "grunzt barsch: "); 

}







