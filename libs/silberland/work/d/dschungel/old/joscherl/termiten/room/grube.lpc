/////////////////////////////////////////////
// Termitengrube
/////////////////////////////////////////////

inherit "std/room";

#include "../define.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

mapping spieler_in_grube;

string termiten() {
  if (spieler_in_grube[getuid(TP)] == 0)
    return "Im Moment siehst Du nur eine einzige, die ueber Dich hinwegsteigt "
    "wie ueber ein Stueck rohes Fleisch.\n";
  else return "Du erkennst panisch, das die Termiten das Lebewesen am Boden "
    "der Grube bei lebendigen Leibe auffressen! Argh...wie kommst Du nur hier "
    "raus???\n";
}

string termite() {
  if (spieler_in_grube[getuid(TP)] == 0)
    return "Ja, eine ist dir im Moment ganz besonders nahe.\n";
  else return "Davon gibts hier reichlich. Im Moment zum Glueck nicht "
    "auf Dir.\n";
}



string termitenkoerper() {

  if (spieler_in_grube[getuid(TP)] == 0)

    return "Ein Termitenkoerper steigt gerade ueber Dich hinweg. Ihr Koerperbau "

    "verleiht den Wesen wirklich erstaunliche Kletterfaehigkeiten.\n";

  else return "Nein, gerade ist Dir keine Termite nahe genug um sie naeher zu "

    "untersuchen.\n";

}

string wand() {
  if (spieler_in_grube[getuid(TP)] ==  0)
    return "Du siehst nur die Termite ueber Dir, keine Wand.\n";
  else return "Die Waende sind aalglatt und viel zu hoch fuer Dich. Im Moment "
    "waerst du liebend gern eine Termite - die haben damit keine Schwierigkeiten.\n";
}

string grube() {
  if (spieler_in_grube[getuid(TP)] == 0) 
    return "Verflucht, im Moment siehst Du einfach nix.\n";
  else return "Du liegst tief in der Sch.... aeh Grube, mitten in einem "
    "zuckenden, bebenden, beissenden, schneidenden, stinkenden Haufen "
    "hungriger Termiten, die sich ueber das Lebewesen am Grund der Grube "
    "hermachen. Die Waende sind extrem glatt und hoch.\n";
}

string boden() {
  if (spieler_in_grube[getuid(TP)] == 0) 
    return "Nur die Termite. Kein Boden. Du siehst Nullkommanix.\n";
  else return "Der Boden oder besser Grund der Grube wimmelt von "
    "Termiten, die sich ueber ein zuckendes Lebewesen hermachen.\n";
}

string lebewesen() {
 if (spieler_in_grube[getuid(TP)] == 0) 
   return "Im Moment kannst du das Lebewesen nicht sehen, aber du spuerst "
   "seine letzten Zuckungen.\n";
 else return "Am Boden der Grube liegt ein grosses Tier, das es offenbar "
   "nicht mehr geschafft hat zu entkommen. Du erkennst nicht was es ist, "
   "das ist aber auch nebensaechlich. Du musst was unternehmen, sonst "
   "gehts Dir in Kuerze wie ihm.\n";
}

string fluchtsicht() {
  if (spieler_in_grube[getuid(TP)] == 0) 
    return "Tja, gerade kriecht eine Termite ueber Dich. Du kannst nichts "
    "sehen. Aber... hmh ... Dir kommt eine verrueckte Idee.\n";
  else return "Endlich ist die Termite ueber dich hinweggekrochen und du "
    "kannst wieder was sehen.\n";
}

string einfall() {
  if (spieler_in_grube[getuid(TP)] == 0) 
    return "Die Termite ueber Dir bringt dich auf eine verrueckte Idee.\n";
  else return "Vielleicht faellt Dir mehr ein, wenn eine Termite ueber "
    "Dich kriecht.\n";
}

string flucht() {
  if (spieler_in_grube[getuid(TP)] == 0)
    return "Die Termite, die ueber Dich kriecht, ist Dein letzter _Strohhalm_ "
    "der Hoffung. Du solltest etwas mit dieser Termite tun.\n";
  else return "Es scheint so, dass deine Fluchtgedanken nur "
    "dann kommen, wenn gerade eine Termite ueber Dich kriecht.\n";
}

create()
{
  ::create();
  spieler_in_grube = ([]);
  SetProp(P_INT_SHORT, "In einer Grube" );
  SetProp (P_KILL_NAME, "Eine toedliche Neugierde");
  SetProp(P_INT_LONG, bs("@@lang@@"));
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]));
  SetProp(P_NOQUIT, 1);

  AddDetail("luft", 
    "Die schweren Insekten quetschen die Luft aus deinen Lungen.");

  AddDetail("termiten", #'termiten);

  AddDetail("termite", #'termite);

  AddDetail(({"grube", "haufen"}), #'grube);

  AddDetail("schwierigkeiten",
    "Du steckst bis zum Hals in Schwierigkeiten, glaub mir. ");

  AddDetail("hals", 
    "Und dein Hals wird bald aufhoeren, Deinen Kopf mit Deinem "
    "Koerper zu verbinden. Dafuer sorgen die Termiten sicher. ");

  AddDetail("kopf", "Noch ist er dran.");

  AddDetail("koerper", 
    "Meinst du Deinen Koerper oder die Termitenkoerper? Deiner ist "
    "eher schmaechtig. ");

  AddDetail(({"termitenkoerper","koerperbau"}), #'termitenkoerper);

  AddDetail(({"kletterfaehigkeiten", "klettern"}),
    "Die Termiten haben keine Schwierigkeiten beim Klettern. "
    "Das merkst Du vor allem an jenen, die immer wieder "
    "ueber Dich druebersteigen und Dir die Sicht nehmen. Wenn "
    "du nur einen Einfall haettest.");

  AddDetail(({"sicht"}), #'fluchtsicht);

  AddDetail(({"einfall"}),#'einfall);

  AddDetail("joscherl",
    "Hm Du hast Dich wohl getaeuscht. Der ist nicht da. Leider. ");

  AddDetail(({"tier","lebewesen"}), #'lebewesen);

  AddDetail("zangen", 
    "Die siehst du nicht nur, sondern spuerst sie auch mittlerweile. Die "
    "Termiten beissen hier alles, was sich bewegt.");

  AddDetail(({"waende", "wand"}), #'wand);

  AddDetail("idee",
    "Eine wirklich verrueckte Idee einer Fluchtmoeglichkeit.");

  AddDetail("fluchtmoeglichkeit", #'flucht);

  AddDetail(({"inferno", "spass"}), 
    "Nein, das ist kein Spass mehr. Das ist ein Inferno.");

  AddDetail("hilfe", 
    "Allein entkommst du hier nie. Aber wer oder was soll dir hier helfen?");

  AddDetail("decke", 
    "Die ist dermassen hoch oben... du hast im Moment wirklich andere Sorgen!");

  AddDetail("boden", #'boden);

  AddSmell(DEFAULT_SMELL, 
    "Hier stinkt es entsetzlich nach rohem Fleisch und Saeure.");

  AddCmd(({"klammer", "klammere"}), "anklammern");
 
  AddCmd(({"toete"}), "nixtoeten");

}

beissen() {
  if (!TP || (file_name(ENV(TP)) != ROOM("grube"))) return;
  tell_object(TP, 
      "AHHH ... eine der Termiten schneidet Dich mit ihren Zangen tief ins Fleisch.\n");
  TP->do_damage(7+random(6));
}

nichtsicht() {
  if (!TP || (file_name(ENV(TP)) != ROOM("grube"))) return;
  spieler_in_grube[getuid(TP)] = 0; 
  tell_object(TP, bs("Eine der Termiten wirft Dich um und klettert ueber Dich. "
     "Dir wird buchstaeblich schwarz vor den Augen."));
  call_out("warnung", 5);
  call_out("beissen", 10+random(5));
  call_out("sicht", 5+random(15));
}

sicht() {
  if (!TP || (file_name(ENV(TP)) != ROOM("grube"))) return;
  spieler_in_grube[getuid(TP)] = 1; ; 
  tell_object(TP, bs("Das Vieh kriecht von Dir herunter. "
  "Schemenhaft erkennst du die Grube."));
  call_out("nichtsicht", 5+random(10));
}  

init(){
   spieler_in_grube += ([getuid(TP): 1]); 
   tell_object(TP, "\nDu ueberwindest deinen Ekel und springst...\n\n"); 
   call_out("fall", 3);
   ::init();
}

fall() {
  if (!TP || (file_name(ENV(TP)) != ROOM("grube"))) return;
  tell_object(TP, bs("Als du mitten in das tobende Knaeul der Insekten "
      "faellst, wird Dir klar, dass das duemmer als dumm war. "));
  call_out("nichtsicht", 3);
} 

string lang() {
  if (spieler_in_grube[getuid(TP)] == 0) 
    return "Du siehst nur noch den Insektenleib.  ";
    else return 
      "Du stoehnst und schnappst nach Luft, die Termiten trampeln "
      "ueber Dich, schlitzen Dich mit Ihren Zangen beinahe auf. Die Waende "
      "der Grube sind spiegelglatt und an die 10 Meter hoch. Unter Dir waelzt "
      "sich ein grosses Lebewesen, das offenbar der Grund fuer die Raserei der "
      "Termiten ist. Ohne Hilfe wirst Du aus diesem Inferno nicht mehr "
      "rauskommen. Ebensowenig wirst Du das hier lange ueberstehen.";
}

warnung(int zeit, int rand_warn) {
  if (!TP || (file_name(ENV(TP)) != ROOM("grube"))) return; 
  rand_warn = random(3);
  zeit = ((TP->QueryProp(P_HP))/10*23/60); 
  if (((TP->QueryProp(P_HP))>60) && (rand_warn == 0))
    tell_object(TP, "Auf einmal siehst Du Joscherl, der auf eine Sanduhr "
    "blickt. Er fluestert grinsend: Ich geb dir noch circa "
    +  (string) zeit + " Minuten...\n");
  if (((TP->QueryProp(P_HP))<60) && (rand_warn == 0)) {
    tell_object(TP, "Dein Silberlandleben laeuft in Sekundenbruchteilen "
    "wie ein Film vor Deinem geistigen Auge ab.\nGib Gas, sonst hat Lars "
    "in kuerzester Zeit Kundschaft.\n");
    tell_room(ENV(TP), TPN + " wird es nicht mehr lang machen.\n", ({TP}));
  }
}

nixtoeten() {
  tell_object(
    TP, "Das wird dir hier nichts nuetzen. Denk lieber ueber Deinen eigenen "
    "Tod nach!\n"); 
  return 1;
}

int anklammern(string str){
  object ob;
  if (TP->QueryProp(P_WEAPON) != 0)
    return write("Zum Anklammern wirst Du beide Haende brauchen...\n"), 1;
  if ((TP->QueryProp(P_TOTAL_WEIGHT)) - 
     (TP->QueryProp(P_WEIGHT)) > 5000)
    return write("Du bist eindeutig zu schwer. So wirds nicht gehen.\n"), 1;
  if (!strlen(str))
    return write("Woran willst Du dich klammern?\n") ,1;
  if (!member( (["an termite","an baumschneidertermite", "termite",
    "strohhalm", "an strohhalm"]), str))
    return write("Daran kannst du Dich nicht klammern.\n") ,1;
  if (member( (["strohhalm", "an strohhalm"]), str))
    return write("Hier gibts keinen Strohhalm...\n"), 1; 
  write(bs("Zitternd klammerst Du dich an die riesige Termite  ... \n\n"
  "und Du hast Glueck!!! Sie klettert tatsaechlich aus der Grube. Oben "
  "angelangt, laesst Du dich erschoepft fallen.\n "));
  TP->move(ROOM("grubenraum"), M_NOCHECK);
  TP->SetProp(P_MV, 100);
}
