//////////////////////////
// der Zusammenklebespell
// des Thanatodendron
//////////////////////////

inherit "std/thing";

#include "../define.h"
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

string from_dir;
string to_dir;

create () {
  ::create();
  if (!is_clone(TO)) return;
  SetProp(P_SHORT, "Ein enorm dicker Strang gebuendelter Wurzeln");
  SetProp(P_LONG, "Du siehst einen meterdicken Strang gebuendelter "
    "Wurzeln, der aus dem "+from_dir+" zu kommen scheint und nach "
    "+to_dir+" weiterverlaeuft. Beunruhigenderweise bewegt sich das Ding "
    "wie eine Schlange.\n");
  SetProp(P_NAME, "Wurzelstrang");
  SetProp(P_NOGET, 
    "Hehe :) Nein also dafuer bist Du nun wirklich weitaus zu schwach :)\n");
  SetProp(P_WEIGHT, 1000000);
  AddId(({"wurzelstrang", "wurzel", "wurzelbuendel", "wurzeln"}));
}




