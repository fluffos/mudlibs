/*
* Basis der Termitensaeule
*/


#include "../define.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Fuss einer Saeule" );

  SetProp( P_INT_LONG, bs(
     "Hier endlich erkennst du das Ziel und die Quelle der tausenden "
     "Insekten. Die Strasse weitet sich zu einer beinahe unuebersehbar "
     "grossen Lichtung. In ihrer Mitte ragt eine riesige Saeule mit "
     "einem Durchmesser von gut 20 Metern auf. Zahllose Baumstaemme "
     "wurden zu diesem gewaltigen Turm zusammengefuegt, dessen "
     "Unregelmaessigkeit davon zeugt, dass er nicht von menschlichen "
     "Lebewesen erbaut wurde. Durch dunkle Oeffnungen am Fuss der "
     "Saeule stroemen die Insekten ein und aus.Du befindest Dich vor "
     "dem Nest des Termitenstaates."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"ziel", "quelle"}), bs(
    "Der Insektenstrom, der in und aus den Oeffnungen am Fuss der Saeule "
    "fliesst, laesst keinen Zweifel offen, dass es sich hier um das Zentrum "
    "des Termitenstaates handelt. "));

  AddDetail( "zweifel", bs(
    "Nein, kein Zweifel."));

  AddDetail( ({"strasse", "termitenstrasse","ende"}), bs(
    "Die Strasse ist hier zu Ende und muendet in einen riesigen kreisrunden "
    "Platz."));

  AddDetail( ({"lichtung","platz","umkreis"}), bs(
    "Der Urwald wurde hier in einem Umkreis von 50 Metern vllig "
    "vernichet. Keine noch so kleine Pflanze entspringt dem steinharten "
    "festgetretenen Boden. In der Mitte der Lichtung  ragt der riesige "
    "Termitenstock empor."));

  AddDetail( ({"durchmesser","basis"}), bs(
    "Die Saeule hat an ihrer Basis einen Durchmesser von gut 20 Metern."));

  AddDetail( ({"saeule", "turm" }), bs(
    "Die Saeule entspringt der Mitte der Lichtung und ragt weit empor bis zu "
    "den Wipfeln der gigantischen Urwaldriesen. Es ist ein amorphes Gebilde "
    "aus tausenden verkeilten Baumstaemmen, die durch eine steinhart gewordene "
    "Substanz zusammengehalten werden. Sie ist keineswegs gerade, sondern "
    "variiert in ihrem Durchmesser und weist zahlreiche Ausbuchtungen und "
    "Ausbeulungen auf. Das ist eindeutig ein gigantischer Termitenstock."));

  AddDetail( ({"baumstaemme","staemme"}), bs(
    "Das also passiert mit den gefaellten Baumstaemmen..."));

  AddDetail( ({"substanz","druesensekret"}), bs(
    "Koennte sich um ein Druesensekret handeln. Stinkt gewaltig."));

  AddDetail( ({"termitenstock","nest" }), bs(
    "Diese Saeule ist ein gigantischer Termitenstock."));

  AddDetail( ({"unregelmaessigkeit","ausbuchtungen","ausbeulungen","gebilde"}), bs(
    "Die Saeule ist keineswegs gerade, sondern weist zahlreiche "
    "Ausbuchtungen und Ausbeulungen auf, die ihr ein unwirkliches und "
    "instabiles Aussehen geben." ));

  AddDetail( ({"meter", "forscherpunkt", "hausuebung"}),bs(
    "100 cm. 0,001 km. 1000 mm. Als Hausuebung wandle jetzt bitte Meter in inch "
     "um. Mails an Joscherl, und er traegt Dir einen Forscherpunkt ein."));

  AddDetail( "joscherl", bs(
    "Ja, den interessiert das sicher brennend."));

  AddDetail( ({"aussehen","welt"}), bs(
    "Unwirklich...wie aus einer anderen Welt."));

  AddDetail( ({"lebewesen","wesen"}), bs(
    "Mittlerweile hast du mehr als genug dieser Lebewesen gesehen, um zu "
    "wissen dass es sich hier um das Zentrum des Termitenstaates handelt." ));

  AddDetail( ({"oeffnungen", "hoellentore","fuss","oeffnung"}), bs(
    "Am Fuss der Saeule siehst du zahlreiche Oeffnungen in unterschiedlicher"
    "Hoehe, durch die schwarze Stroeme von Termiten fliessen. Trotz allem "
    "Ekel zieht es dich irgendwie zu diesen Hoellentoren." ));

  AddDetail( ({"insekten", "termiten","baumschneidertermiten","koerperfortsaetze"}), bs(
    "Gliedmassen, Extremitaeten, Fuehler, Zangen --- Tausende und "
    "Abertausende der widerlich langen und duennen Koerperfortsaetze "
    "beruehren Dich in einem fort, betasten Deinen Koerper, klettern "
    "ueber Dich hinweg." ));

  AddDetail( "boden", bs(
    "Sowenig du auch vom Boden siehst, er fuehlt sich steinhart an. Hier "
    "waechst lange nichts mehr."));

  AddDetail( "himmel", bs(
    "Obwohl es nur noch wenigen Aesten gelingt, die Breite der Lichtung zu "
    "ueberspannen, verdeckt der Schatten des gewaltigen Termitenstocks die "
    "Tropensonne und huellt diesen Platz in ein unheilvolles Halbdunkel."));

  AddDetail( "aeste", bs(
    "Die wenigen uebriggebliebenen Aeste sind duerr und krank."));

  AddDetail( ({"insektenstrom", "strom","abertausende","reihen","stroeme","tausende"}), bs(
    "Endlose Reihen von schwarzschillernden Termiten, zitternd suchende "
    "Fuehler, bebende Gliedmassen, alte Damen mit Rauhaardackeln..."));

  AddDetail( ({"damen","rauhaardackel","dackel"}), bs(
    "Nein, die wohl doch nicht."));

  AddDetail( ({"fuehler"}), bs(
    "Diese Wesen besitzen Fuehler, mit denen sie unentwegt ihre "
    "Umgebung abtasten. "));

  AddDetail( ({"gliedmassen","ekel","extremitaeten"}), bs(
    "Du schauderst...abstossend! "));

  AddDetail( ({"urwald","dschungel","umgebung"}), bs(
    "Hier wurde in weitem Umkreis der Dschungel vernichtet, um Platz fuer "
    "den Insektenstaat zu schaffen. "));

  AddDetail( ({"pflanzen", "pflanze", "gewaechse", "vegetation",
                     "stuecke", "blaetter"}), bs(
    "Die Pflanzen und Gewaechse des Dschungels knnen hier nicht ueberleben. "
    "Die Termiten sind nahe daran, das Oekosystem aus dem Gleichgewicht "
    "zu bringen."));  

  AddDetail( ({"oekosystem", "gleichgewicht","besitz"}), bs(
    "Diese Insektenart nimmt ihre Umwelt ruecksichtslos in Besitz."));  

  AddDetail( ({"umwelt","geschichte"}), bs(
    "Kommt Dir bekannt vor, die Geschichte."));

  AddDetail( ({"insektenart"}), bs(
    "Moerderische Baumschneidertermiten."));  

  AddDetail( ({"mitte"}), bs(
    "Der Termitenstock befindet sich im Zentrum des Platzes.")); 

  AddDetail( ({"zentrum"}), bs(
    "Die Saeule bildet nicht nur das Zentrum des Platzes, sondern "
    "auch das Zentrum des Termitenstaates."));

  AddDetail( ({"termitenstaat", "staat","insektenstaat","gemeinschaft"}), bs(
    "Diese Insekten sind keine individuellen, sondern kollektive Lebewesen. "
    "Ihr ganzes Streben richtet sich auf das Ueberleben der Gemeinschaft.")); 

  AddDetail( "ueberleben", bs(
    "Genau darum geht es hier."));

  AddDetail( "streben", bs(
    "Irgendwie unsympathisch, denkst Du dir insgeheim."));

  AddDetail( ({"wipfel","baumwipfel"}), bs(
    "Weit oben kannst du ein paar duerre und kranke Baumwipfel erkennen.")); 

  AddDetail( ({"zangen" }), bs(
    "Diesen Zangen haelt kaum etwas stand. Hoffentlich bist Du "
    "gut ausgeruestet."));  

  AddDetail( ({"umkreis","breite" }), bs(
    "Du schaetzt ca 40 Meter."));  

  AddDetail( ({"koerper","leiber"}), bs(
    "Angesichts der insektoiden Leiber kommt Dir dein Koerper eher unzulaenglich "
    "vor."));  

  AddDetail( ({"halbdunkel", "schatten","tropensonne"}),bs(
    "Die freundliche Tropensonne wird durch den Termitenstock verdeckt."));

  AddDetail( "urwaldriesen", bs(
    "Die gibts rings um die Lichtung, nicht auf ihr."));

}
