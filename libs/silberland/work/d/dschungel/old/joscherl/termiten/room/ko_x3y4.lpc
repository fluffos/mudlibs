/////////////////////////
// Kokons/Mitte
/////////////////////////

#include "../define.h"
#include <properties.h>
#include <language.h>

inherit ROOM("inh_kokons.lpc");

create()
{
     ::create();

  SetProp( P_INT_LONG, 
    "Du wandelst in dem dunklen Gewoelbe durch die Reihen der schwarzen "
    "kokonartige Objekte, die in voellig praezisen, geradezu geometrischen "
    "Abstaenden angeordnet wurden. Kein Laut ist zu vernehmen, du kannst auch "
    "keine Bewegungen erkennen, die auf Termiten hindeuten wuerden. Du "
    "glaubst jedoch, an der nachtschwarzen Wand das Glitzern von "
    "Facettenaugen sehen zu koennen. Im Sueden, im Zentrum des "
    "Gewoelbes, vermeinst Du, etwas erhoeht ein riesiges Gewaechs sehen zu "
    "koennen.");

  AddDetail(({"westen", "ende"}),
    "Das Gewoelbe wird hier durch das massive, mit Baumstaemmen "
    "verstaerkte Erdreich begrenzt. ");

  AddDetail( ({"wand", "waende"}),
    "Im Westen beginnt das massive, durch Baumstaemme verstaerkte Erdreich. "
    "Hier wird das Gefuehl beobachtet zu werden, besonders stark.");

  AddExit("norden", ROOM("ko_x3y5"));
  AddExit(({"suedoben","sueden"}), ROOM("ko_x3y3"));
  AddExit("osten", ROOM("ko_x4y4"));
  AddExit("westen", ROOM("ko_x2y4"));
  SetProp(P_HIDE_EXITS, ({"sueden"}));
}
