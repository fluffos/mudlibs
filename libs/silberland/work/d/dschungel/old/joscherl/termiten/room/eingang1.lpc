#include "../define.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{

   ::create();

   SetProp( P_INT_SHORT, "Eine eigenartige Strasse" );

   SetProp( P_INT_LONG, bs(
     "Der Dschungel gibt hier eine breite Schneise frei, die nur durch die gigantischen "
     "Staemme der uralten Baumriesen begrenzt wird. Kaum ein Gewaechs saeumt ihren "
     "Rand, die ueppigen Farne und das gruene Blattwerk sind verschwunden. Nur "
     "ein paar verdorrte pflanzliche Ueberreste zeugen davon, dass es hier nicht immer "
     "so aussah. Hoch ueber Dir verdeckt das Geaest des Regenwaldes den Himmel, "                 
     "jenseits der Dschungelriesen kannst Du nur Schatten erkennen. Die fruchtbare "
     "Erde des Dschungels ist hier wie von zahllosen Fuessen steinhart gepresst.") +
     ("Eine eigenartige Stille umfaengt Dich.\n" ) );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({"dschungel", "regenwald"}), bs(
    "Das Gruen des Dschungels ist auf dieser Schneise einem dunklen Braun gewichen.  "
    "Die zahllosen Dir unbekannten Blueten und Pflanzenformen siehst Du hier nicht "
    "mehr. Irgendwie sieht es hier kahl aus, fast so als ob etwas die jungen Pflanzen "
    "mit Absicht entfernt haette.  Umgefallene, halb vermoderte Baumstammreste "
    "liegen am Rand der Schneise, nicht jedoch in ihrer Mitte.\n"));

  AddDetail( "joscherl", bs(
    "Joscherl kitzelt Dich aus der Entfernung."));

  AddDetail( "dante", bs(
    "Das ist ein Freund von Tarzan."));

  AddDetail( "tarzan", bs(
    "Das ist ein Freund von Dante."));

  AddDetail( "boden", 
    "Die fruchtbare Erde des Dschungels ist hier wie von zahllosen Fuessen steinhart gepresst.");

  AddDetail( "braun", bs(
    "Ein totes Braun - Farben gibts hier fast keine."));

  AddDetail( "gruen", bs(
    "Das liegt hinter Dir. Da wo du stehst, sieht der Dschungel nicht mehr farbenfroh und lebendig aus."));

  AddDetail( "absicht", bs(
    "Den Pflanzen hier war diese Absicht sicher nicht recht. Man koennte vielleicht von boeser Absicht "
    "sprechen? :)"));

  AddDetail( "rand", bs(
    "Die Schneise wird durch den Dschungel sehr genau eingegrenzt, der Rand ist beinahe wie mit dem "
    "Lineal gezogen."));

  AddDetail( "lineal", bs(
    "Nein, kein Lineal. Eine kleine Redewendung. Fragt sich, ob ich das Detail "
    "Redewendung auch einfuegen soll?"));

  AddDetail( ({"redewendung", "monitor", "haemmerchen", "stirn" }), 
    "Aus deinem Monitor faehrt ein kleines Haemmerchen und klopft dir auf die Stirn.");

  AddDetail( "detail", bs(
    "Ja und welches Detail haettest Du denn gerne untersucht, liiiieber " + TPN + " ?"));

  AddDetail( ({"schneise", "platz"}), bs(
    "Die Schneise zieht sich wie eine Narbe in einer leichten Biegung nach Suedosten "
    "in den Dschungel. Kein Gruen, keine Blueten, keine Tiere, nur vermoderte "
    "Baumstaemme und die Dunkelheit der Dschungelriesen. Und dieser seltsame "
    "festgetrampelte Lehm zu deinen Fuessen. Dir ist unheimlich.\n"));

  AddDetail( ({"tiere", "tier"}), bs(
    "Du kannst kein einziges Tier sehen."));

  AddDetail( ({"narbe", "wunde" }), bs(
    "Dem Dschungel wurde hier eine tiefe Wunde zugefuegt. Fragt sich nur von wem."));

  AddDetail( ({ "staemme", "baumstaemme", "baumriesen", "dschungelriesen", 
                         "riesen",  "baeume", "gehoelz" }), bs(
    "Dunkles, uraltes Gehoelz. Junge Triebe findest Du keine. Nur weit oben vermeinst "
    "Du, duenneres Geaest und vereinzelt sogar einen gruenen Schimmer zu erkennen. "
    "Dennoch tuermen sich diese Giganten bis in schwindelnde Hoehen, sodass Du "
    "ihre Wipfel nicht erkennen kannst.\n ") +
    "Am Rand der Schneise liegen zahlreiche Baumleichen am Boden und erwecken "
    "in Dir den Eindruck von gefallenen Kriegern. ");

  AddDetail( ({ "gewaechs", "blueten", "pflanzenformen", 
                         "pflanzen", "farne", "triebe"}), bs(
    "Seltsam...aber sowas gibts hier einfach nicht. Die ueppige Fauna des Dschungels "
    "ist auf ein Minimum reduziert. Hier muss es aber frueher sehr wohl Gruenzeug "
    "gegeben haben, denn hier und da siehst du verdorrte Blaetter und Stengel auf "
    "dem Lehmboden liegen. Auch die modernden Baumleichen deuten darauf "
    "hin. ")); 

    AddDetail( ({"fauna", "minimum"}), bs(
    "Wie gesagt, wenig Gruenzeug. Kahl."));

  AddDetail( ({ "krieger", "eindruck" }), 
    "Ein Baumstamm schleudert einen Feuerball nach Dir.\n" +
    ".....Ach was Unsinn, das sind keine Krieger. Aber Du bist hoffentlich einer.\n" );

  AddDetail( ({ "baumstammreste", "reste", "baumleichen"}), bs(
    "Das waren einmal riesige Pflanzen. Jetzt sind sie nur noch Kohlenstoff. "
    "Dir fallen allerdings an ihren Enden keine Bruchstellen auf, die darauf hindeuten koennten, dass "
    "sie durch Wind, Wetter oder Altersschwaeche umfielen."));

  AddDetail( ({"kohlenstoff", "basis", "wasserstoff", "chemie"}), bs(
    "Kohlen- und Wasserstoff sind die Basiselemente der organischen Chemie. Zumindest bis mir "
    "jemand, der sich da auskennt, was anderes erklaert :)"));

  AddDetail( ({"wind", "wetter", "altersschwaeche", "erklaerung", "alter"}), bs(
    "Das waer eine Erklaerung fuer die herumliegenden Baumleichen. Aber die sind nicht entwurzelt "
    "worden. Dazu fehlt es an den typischen Bruchstellen."));

  AddDetail( "Blattwerk", bs(
    "Bis auf die Ueberreste am Boden siehst du nichts dergleichen. Nur ganz weit oben "
    "im Geaest scheinen noch vereinzelte gruene Tupfen sichtbar zu sein. "));

  AddDetail( ({"oben", "tropenhimmel", "himmel", "wipfel" }), bs(
    "Du schaust angestrengt nach oben ... und weiter nach oben ... *KLONGGGG* ...und "
    "rennst mit dem Kinn gegen einen Baumstamm. Fein."));

  AddDetail( "baumstamm", bs(
    "Ja, der war tatsaechlich im Weg."));

  AddDetail( "kinn", bs(
    "Vorher wars zu spitz, jetzt ist es zu breit."));

  AddDetail( "weg", bs(
    "Ja... eigentlich sieht das hier aus wie ein Weg. Oder besser eine Strasse."));

  AddDetail( "strasse", bs(
    "Wer soll hier in dieser gottverlassenen Gegend eine Strasse bauen?"));

  AddDetail( "gegend", 
    "Die Gegend hier nennt man Dschungel und Dich nennt man " + TPN + ". "
    "Alles klar soweit?");

  AddDetail( ({ "ueberreste", "blaetter", "stengel", "gruenzeug" }), bs(
    "Verdorrte Blaetter, Stengel, Baumleichen. Nichts lebendes. Dafuer umso mehr "
    "totes. Und nicht mal von dem gibts hier viel. Es schaut so aus, als ob dieser Platz "
    "hier von irgendetwas peinlich genau gesaeubert werden wuerde. Als du genauer "
    "suchst, findest du ueberall an den Dschungelriesen eigenartige Schnittstellen. "));

  AddDetail( "geaest", bs(
    "Hoch ueber Dir verdeckt es den Blick auf den Tropenhimmel. Hier unten gibt es "
    "weit weniger davon." ));

  AddDetail( ({"tupfen", "schimmer"}), bs(
    "Vereinzelte gruene Tupfen deuten auf darauf hin, dass der Dschungel hier einst "
    "weitaus lebendiger war." ));

  AddDetail( ({ "schatten", "dunkelheit" }), bs(
    "Der Blick in den Dschungel abseits der Schneise wird Dir durch die Dunkelheit "
    "verwehrt. Auch ein Eindringen ist nicht moeglich, da die Staemme unglaublich dicht "
    "neben-, ja beinahe uebereinanderstehen. " ));

  AddDetail( "erde", bs(
    "Eigentlich ist das dunkelbrauner Lehm. Da er so festgetreten ist, kann er kein "
    "Wasser mehr aufnehmen und ist unfruchtbar."));

  AddDetail( "wasser", bs(
    "Der Boden hier ist zu verdichtet, um Wasser aufzunehmen."));

  AddDetail( ({"lehm", "lehmboden", "stein"}), bs(
    "Hart wie Stein. Hier waechst in der naechsten Zeit nichts mehr. Auch die "
    "zahlreichen Bodenlebewesen, die sonst ueberall im Dschungel zun finden sind, "
    "kannst du nicht finden. "));

  AddDetail( ({"fuesse", "witze"}), bs(
    "Deine Fuesse, obwohl sie offenbar platt sind wie Joscherls Witze, "
    "koennen das nicht gewesen sein. Du warst hier ja noch nie. " ));

  AddDetail( "bodenlebewesen", bs(
    "Wuermer, Spinnen, Silberfische, Wanzen, Ohrschluerfer, Tausendfuessler,  Zehen"
    "beisser, Fusssohlennager, HinternKriecher , Rauhhaardackel ... " ));

  AddDetail( ({ "wuermer", "spinnen", "wanzen", "ohrschluerfer", "tausendfuessler" }),
    "Gibts hier so selten wie Trolle bei der Nobelpreisverleihung. " );

  AddDetail( "trolle", bs(
    "Nein, hier gibts die auch nicht."));

  AddDetail( "nobelpreisverleihung", bs(
    "Aus jetzt. Das is ja laecherlich."));

  AddDetail( ({"zehenbeisser", "fusssohlennager" }),
    "Zum Glueck gibts die hier nicht ... sonst wuerdest bald aussehen wie Reinhold "
    "Messner. Und das willst Du ja nun wirklich nicht. " );

  AddDetail( "silberfische",
    "Im Moment beisst keiner an." );

  AddDetail( ({ "rauhhaardackel", "dackel", "lodenmantel", "steirerhut" }), bs(
    "Seltsam - war da nicht gerade eine alte Dame in einem Lodenmantel und "
    "Steirerhut, die einen Rauhhaardackel spazieren fuehrt? Du faehrst Dir ueber "
    "die verschwitzte Stirn und verfluchst Dantes Malaria. "));

  AddDetail( "stirn", 
    "Nass. Du bist nervoes.");
  
  AddDetail( "hinternkriecher", 
    "Allein bei dem Gedanken faengts an, Dich zu jucken. Du moechtest Dich kratzen. " ); 

  AddDetail( "gedanke", 
    "Kein schoener Gedanke! " ); 

  AddDetail( "stille", 
    "Ja, fast kannst Du sie sehen, so auffaellig ist sie.\n" );

  AddDetail( ({"bruchstellen", "stuempfe"}), bs(
    "Nein, keine Bruchstellen. Diese Baeume sind offenbar nicht wegen "
    "ihres Alters umgefallen. Als du die Stuempfe untersuchst, wird Dir klar, dass sie "
    "offenbar umgeschnitten wurden. "));

  AddDetail( "schnittstellen", bs(
    "Ja, tatsaechlich. Ueberall findest du Anzeichen dafuer, dass frische junge Triebe "
    "und Pflanzen offenbar durch grosse Werkzeuge abgeschnitten wurden. "));

  AddDetail( "werkzeuge", bs(
    "Scharfe, sehr sehr scharfe Werkzeuge."));

  AddDetail( "eindringen", bs(
    "Nein, hier hast du keine Chance. "));

  AddSound( ({"geraeusche", "stille"}), bs(
    "Die Stille ist drueckend. Keine Tierlaute, wie man sie im Dschungel sonst ueberall hoeren "
    "kann. Die wenigen Geraeusche, die Du ab und zu vernimmst, treten dadurch geradezu "
    "plastisch hervor.\n"));  

  AddSound( "pulsschlag", bs(
    "Der ist allerdings gar nicht leise und verdammt schnell.\n "));

  AddSound( "tierlaute", bs(
    "Dein Pulsschlag ist wohl der einzige Tierlaut hier. \n"));

  AddSound( "krachen", bs(
    "Hm scheint aus dem Suedosten zu kommen.\n"));

  AddSound( ({"regenguss", "geraeusch"}), bs(
    "Du horchst genau hin... eigentlich eher wie unzaehlige Fuesse, die sich aeusserst rasch bewegen.\n"));

  AddSound( "fuesse", bs(
    "Klingt eher unheimlich.\n"));

  AddSound(DEFAULT_SOUND, bs(
    "Abgesehen von deinem Pulsschlag hoerst Du beinahe nichts. Ganz selten glaubst Du, "
    "entfernte Geraeusche zu vernehmen.\n"));  

  AddSmell( ({DEFAULT_SMELL, "erde", "moder"}), bs(
    "Es riecht nach feuchter Erde und Moder. Ja und ... irgendetwas hier riecht beissend."));

 AddSmell( ({"irgendetwas", "geruch"}), bs(
    "Seltsam... wie Saeure."));

 AddSmell( "Saeure", bs(
    "Du kannst den Geruch nicht naeher identifizieren."));

  AddRoomMessage( ({
    "\n                              ......Stille.....                                   \n",
    "     ...ein leises Geraeusch ... wie ein ploetzlicher Regenguss...  \n",
    "    ...ein entferntes Krachen...als ob irgendwo ein Baum umgefallen waere...  \n"
  }), 80);


AddExit("suedosten", ROOM("termstr2"));
AddExit("westen", HOME("workroom"));

}
