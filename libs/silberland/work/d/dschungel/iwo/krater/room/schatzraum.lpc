
#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>

#define KRATER "/d/dschungel/feyaria/kueste/room/krater.lpc"

inherit "std/room";

int hbcount = 0;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle");

  SetProp(P_INDOORS, 1);

  SetProp(P_ENVIRONMENT, ([ ENV_FLAGS: EF_INDOORS,
                            ENV_TEMPERATURE: 72,
                            ENV_TERRAIN: TT_CAVE ]));
                            

  SetProp(P_INT_LONG,
    "Du befindest Dich in einer kleinen Hoehle im Schlund des "
    "des Kraters. Die Waende scheinen hier foermlich zu gluehen "
    "und die Luft besteht wohl mehr aus giftigen Gasen denn sonst "
    "etwas. Welcher Grund Dich auch hier her gefuehrt hat, er "
    "sollte Dich nicht daran hindern schnell wieder zu "
    "verschwinden.");

  AddDetail( ({ "hoehle", "dimensionen" }),
    "Die Hoehle ist nicht all zu gross, jedoch reichen die "
    "Dimensionen, um Taguon eine gemuetliche Ruhestaette "
    "zu bieten.");
  AddDetail( ({ "taguon" }),
    "Waere er hier, muesstest Du Dich garantiert nicht nach "
    "ihm umsehen.");
  AddDetail( ({ "schlund" }),
    "Nach Westen gelangst Du wieder hinaus in den Schlund des "
    "Kraters.");
  AddDetail( ({ "krater", "kraters" }),
    "Du bist sozusagen mitten in ihm drinnen.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende leuten regelrecht, so stark gluehen sie.");
  AddDetail( ({ "luft" }),
    "Die heisse, schwefelhaltige Luft brennt in Deinen "
    "Lungen.");
  AddDetail( ({ "lungen" }),
    "Wenn Du noch lange hier verweilst, werden sie wohl von "
    "den Gasen zerfressen.");
  AddDetail( ({ "gase", "gasen" }),
    "Hauptsaechlich Schwefel, und auch etwas Natriumcarbonat.");
  AddDetail( ({ "natriumcarbonat" }),
    "Soda halt.");
  AddDetail( ({ "schwefel" }),
    "Nicht, dass Du welchen sehen koenntest, aber ein zuenftiges "
    "Brennen in Deinen Lungen laesst darauf schliessen, dass "
    "in der Luft mehr als genug davon ist.");
  AddDetail( ({ "grund" }),
    "Es gibt sicher einen besseren Grund um zu verschwinden, als "
    "um hier zu bleiben. Er hat auch einen Namen: Taguon.");
  AddDetail( ({ "name", "namen" }),
    "T A G U O N !");
  AddDetail( ({ "ruhestaette" }),
    "Fuer Dich ist es keine sonderlich bequeme.");
  AddDetail( ({ "boden" }),
    "Der Boden ist blanker Fels. Und er ist fuerchterlich heiss!");

  AddSpecialExit( ({ "westen" }), "swim_out");

}


int swim_out()
{
  tell_room(ME, BS(TP->Name(WER) + " verlaesst die Hoehle."),
    ({ TP }));
  tell_object(TP, BS("Schnell verlaesst Du die Hoehle."));

  call_other(KRATER, "???");

  return TP->move(KRATER, M_SILENT + M_NOCHECK);
}



void init()
{
  ::init();
  set_heart_beat(1);
}

void heart_beat()
{
  if (hbcount++ % 2 == 0)
    {
      object *inv;
      int i, iact;

      i = iact = 0;

      inv = all_inventory(this_object());

      for (i=0; i < sizeof(inv); i++)
        if (interactive(inv[i]))
          {
            inv[i]->AddPoison(1);
            iact++;
          }

       if (iact <= 0)
         set_heart_beat(0); 

    }
}



void reset()
{
  // We are bastards, we are wizards :)
  ::reset(); // TO does the royal flush
}
