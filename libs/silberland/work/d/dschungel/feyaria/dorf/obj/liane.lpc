// liane fuer Pfeilquest
// 12-08-97 Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Eine Liane");
  SetProp( P_LONG, 
    "Diese Liane ist etwa einen Meter lang und sehr biegsam. Sicher eignet "
    "sie sich fuer eine Bogensehne.");
  
  AddId( ({"liane", QUEST_LIANE}) );

  SetProp( P_MATERIAL, MAT_PLANT);
  SetProp( P_NAME, "Liane" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 20 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NEVERDROP, 1);
  

}
