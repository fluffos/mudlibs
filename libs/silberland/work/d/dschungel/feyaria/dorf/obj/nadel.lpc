// Eine Nadel fuer das Praeparationswerkzeug 
// 1998-10-19 Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp( P_SHORT, "Eine dicke Nadel");
  SetProp( P_LONG, 
    "Diese dicke Nadel eignet sich sicher gut zum Naehen.");
  SetProp( P_NAME, "Nadel" );
  SetProp( P_NAME_ADJ, "dick" );
  SetProp( P_GENDER, FEMALE );
  AddId( ({"nadel"}) );
  AddAdjective( ({"dicke", "dick"}) );

  SetProp( P_MATERIAL, MAT_IRON);
  SetProp( P_VALUE, 100 );
  SetProp( P_WEIGHT, 10 );
}
