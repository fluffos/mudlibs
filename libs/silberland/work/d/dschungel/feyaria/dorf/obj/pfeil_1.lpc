//  ***  Objekt
//  ***  Azrael@SilberLand   
//  ***     pfeil_1.c               
//  ***     ----- roher Pfeilschaft, erstes Teil des Pfeiles fuer die Bogenschuetzen-Quest

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Ein selbstgebauter Pfeil");
  SetProp( P_LONG, 
    "Dieser Pfeil besteht aus einem Schaft aus Blutulmenholz, einer "
    "Pfeilspitze aus bestem Zwergenstahl und ist mit einer weissen "
    "Schwanenfeder und einer schwarzen Rabenfeder befiedert. Sicher "
    "wirst Du jedes Ziel damit treffen koennen.");
  
  AddId( ({"pfeil", QUEST_PFEIL}) );

  SetProp( P_MATERIAL, 
    ([MAT_ELM_WOOD:85, MAT_STEEL:10, MAT_FEATHER:5]) );
  SetProp( P_NAME, "Pfeil" );
  SetProp( P_GENDER, MALE );
  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 200 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NEVERDROP, 1);
  

}
