// Zwergenstahl fuer Pfeilquest
// 12-08-97 Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Ein kleines Stueck Zwergenstahl");
  SetProp( P_LONG, 
    "Aus diesem kleinen Stueck Zwergenstahl kann ein Schmied sicher etwas "
    "nuetzliches schmieden.");
  
  AddId( ({"stahl", "zwergenstahl", "stueck", "stueck zwergenstahl", 
           "stueck stahl", QUEST_STAHL}) );

  SetProp( P_MATERIAL, MAT_STEEL);
  SetProp( P_NAME, "Zwergenstahl" );
  SetProp( P_GENDER, MALE );
  SetProp( P_VALUE, 1 );
  SetProp( P_WEIGHT, 50 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NOSELL, 1);
}
