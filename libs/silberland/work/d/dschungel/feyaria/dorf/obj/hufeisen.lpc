// Hufeisen vom Schmied 
// 12-08-97 Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Ein Hufeisen");
  SetProp( P_LONG, 
    "Das ist ein Hufeisen fuer ein grosses Pferd. Angeblich bringt der "
    "Besitz eines solchen Hufeisens auch Glueck.");
  
  AddId( ({"eisen", "hufeisen"}) );

  SetProp( P_MATERIAL, MAT_IRON);
  SetProp( P_NAME, "Hufeisen" );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_VALUE, 30 );
  SetProp( P_WEIGHT, 50 );
}

