// Holzstock fuer Bogenquest
// 12-08-97 Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Ein Holzstock");
  SetProp( P_LONG,
    "Aus diesem biegsamen Holzstock kann man sicher einen schoenen Bogen "
    "bauen.");
  
  AddId( ({"stock", "holzstock", QUEST_STOCK}) );

  SetProp( P_MATERIAL, MAT_TICTOC_WOOD);
  SetProp( P_NAME, "Stock" );
  SetProp( P_GENDER, MALE );
  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 20 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NEVERDROP, 1);
  
  AddCmd( ({"baue", "bau"}), "bauen");

}

int bauen(string str)
{
  object ob, quest;
  notify_fail("Was willst Du bauen?\n");
  if(!str) return 0;
  if( !quest=present(BOGENQUESTID, TP) )
  {
    write("Ohne Turnierzettel hat das keinen Sinn!\n");
    call_out("remove",0);
    return 1;
  }
  if( str == "bogen")
  {
    if( present(QUEST_BOGEN, TP) )
    {
      write("Aber Du hast doch schon einen Bogen.\n");
      return 1;
    }
    if( ob = present(QUEST_LIANE, TP) ) 
    {
      write("Du baust aus dem Stock und der Liane einen Bogen.\n");
      say( CAP_TPN + " baut einen Bogen.\n");
      ob->remove();
      CLONE(WEAPON "questbogen",TP);
      quest->quest_teil(BQ_BOGENBAUEN);
      call_out("remove",0);
    }
    else
      write("Du hast nichts, was Du als Bogensehne verwenden koenntest!\n");
    return 1;
  }
  return 0;
}

