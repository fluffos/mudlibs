inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../def.h"
#include "../quest.h"

int uebung;
int quest_teile;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Ein Teilnahmezettel fuer das Bogenschuetzenturnier" );
  SetProp( P_LONG,
        "Ein Teilnahmezettel fuer das Bogenschuetzenturnier. Er ist auf "
        "der Vorder- und auf der Rueckseite beschrieben. Auf der Vorderseite "
        "befindet sich auch noch eine Zeichnung." );

  SetProp( P_MATERIAL, ([MAT_PAPER:98, MAT_INK:2]) );
  SetProp( P_NAME,"Zettel" );
  AddId( ({ "zettel", "werbung", "werbezettel", "teilnahmezettel",
            BOGENQUESTID }) );
  SetProp( P_GENDER, MALE );
  SetProp( P_WEIGHT, 5 ); 
  SetProp( P_NOBUY, 1 );
  SetProp( P_NODROP, 1 );
  SetProp( P_NEVERDROP, 1 );

  AddCmd( ({ "lies","lese" }), "lies" );


  AddDetail( ({ "vorderseite", "zeichnung" }),
    "Die Zeichnung auf der Vorderseite des Zettels zeigt einen "
    "schoen gezeichneten Bogen, in den ein Pfeil eingespannt ist. " );
  AddDetail( ({ "bogen", "pfeil" }),
    "Der Bogen ist wunderschoen verziert und stilisiert dargestellt und "
    "bei naeherem hinschauen siehst Du das am in den Schaft des Pfeiles, "
    "der in die Sehne gespannt ist, eine schwarze und eine weisse Feder "
    "eingearbeitet sind. Unter der Zeichnung steht etwas in schoener Schrift.");
  AddDetail( "sehne",
    "In der Sehne des Bogens ist ein Pfeil eingespannt. " );
  AddDetail( "schrift",
    "Lesen waere vielleicht angebrachter, meinst Du nicht? " );
  AddDetail( ({ "schaft", "feder" }),
    "In den Schaft des gezeichneten Pfeiles sind eine schwarze und eine "
    "weisse Feder eingearbeitet. Komisch, irgendwo hast Du das schon "
    "einmal gesehen, aber wo? " );
  SUID;
}

lies (str)
{
  notify_fail ( "Was willst Du denn lesen?\n" );
  if(!str) return 0;
  if (str=="zettel" || str=="werbung" || str=="werbezettel" ) 
  {
    write( "Du kannst die Vorderseite und die Rueckseite lesen.\n" );
    return 1;
  }
  if (str=="vorderseite")
     {
       write ( 
           "Hier steht in ornamentreicher, elfischer Schrift: \n\n"
       + "          ************************************************\n"
       + "          ***          Bogenschuetzen-Turnier          ***\n"
       + "          ***                                          ***\n"
       + "          *** Naehere Informationen auf der Rueckseite ***\n"
       + "          ************************************************\n" );
       say (TPN + " liest einen Zettel.\n", TP );
       return 1;
     }
  if (str=="rueckseite" )
     {
       write ( 
          "*** Regeln fuer dir Teilnahme am Bogenturnier. ***\n"
          "\n"
          "1. Jeder ist berechtigt teilzunehmen.\n"
          "2. Jeder Teilnehmer muss seinen eigenen, selbstgebauten Bogen mitbringen.\n"
          "3. Es ist nur ein Schuss mit einem ebenfalls selbstgebauten Pfeil moeglich.\n"
          "4. Beliebig viele Uebungsschuesse sind erlaubt.\n\n"           
                      );
       say ( TPN + " liest die Rueckseite eines Zettels.\n", TP );
       return 1;
     }
  return 0;
}

int uebung()
{
  if( getuid(PO)!="feyaria" && getuid(PO)!="zordan" && getuid(PO) != "angrox" &&
      getuid(PO) != getuid(TO) && getuid(PO) !="d.gebirge.angrox")
  {
    raise_error("getuid(PO) problem! in Quest");
    return 0;
  }
  if( uebung==0 )
  {
    if( MENV->QueryProp(P_RACE)=="Elf" )
      uebung+=2*MENV->QueryProp(P_LEVEL)+4*MENV->QueryAttribute(A_DEX);
    else
      uebung+=MENV->QueryProp(P_LEVEL)+2*MENV->QueryAttribute(A_DEX);
  }
  uebung+=random(MENV->QueryAttribute(A_DEX))+MENV->QueryAttribute(A_DEX);
  if( MENV->QueryProp(P_RACE)=="Elf" )  // Elfen lernen um 50% schneller
    uebung+=random(MENV->QueryAttribute(A_DEX));  
  return uebung;
}
 
int query_uebung()
{
  return uebung;
}

void quest_teil(int teil)
{
  if( getuid(PO)!="feyaria" && getuid(PO)!="zordan" && getuid(PO) != "angrox" &&
          getuid(PO) != getuid(TO) && getuid(PO) !="d.gebirge.angrox")
  {
    raise_error("getuid(PO) problem! in Quest");
    return 0;                                                                                                     
  } 
  if( !(quest_teile&teil) ) 
  {
    quest_teile|=teil;
    DB(sprintf("BOGENQUEST: %s: %s, Gesamt = 0x%4X\n", TPN,
        QUESTSTRING[teil], quest_teile));
    DBM(sprintf("BOGENQUEST: %s: %s, Gesamt = %d\n", TPN,
        QUESTSTRING[teil], quest_teile));
    WLOG( LOG "bogenquest", QUESTSTRING[teil] );
  }
}

int query_quest_teil()
{
  return quest_teile;
}

