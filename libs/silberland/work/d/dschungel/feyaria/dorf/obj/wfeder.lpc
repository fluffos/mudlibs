//  ***  Objekt
//  ***  Azrael@SilberLand   
//  ***     wfeder.c                
//  ***     ----- eine weisse Rabenfeder, fuer die Bogenschuetzen-Quest

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Eine weisse Feder");
  SetProp( P_LONG, 
    "Eine schoene weisse Feder. Sie wuerde einem Pfeil eine ruhige Lage im "
    "Flug geben. Sie gehoerte sicher einmal einem Schwan.");
  SetProp( P_MATERIAL, MAT_FEATHER);
  SetProp( P_NAME, "Feder");
  SetProp( P_NAME_ADJ, "weiss");
  SetProp( P_GENDER, FEMALE );
  SetProp( P_VALUE, 2 );
  SetProp( P_WEIGHT, 2 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NEVERDROP, 1);
  
  AddId( ({"feder", "schwanenfeder", QUEST_WFEDER}) );
  AddAdjective( ({"weiss", "weisse"}) );
}
