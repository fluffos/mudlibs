//  ***  Objekt
//  ***  Azrael@SilberLand   
//  ***     pfeil_0.c               
//  ***     ----- roher Pfeilschaft, erstes Teil des Pfeiles fuer die Bogenschuetzen-Quest

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Ein Holzstueck");
  SetProp( P_LONG, 
    "Ein rohes schmales Stueck Holz einer Blutulme. Daraus koennte man einen "
    "schoenen Pfeil basteln. Du brauchst nur noch eine Pfeilspitze und "
    "zwei Federn.");
  
  AddId( ({"ast", "holz", "stueck", "holzstueck", QUEST_HOLZ}) );

  SetProp( P_MATERIAL, MAT_ELM_WOOD);
  SetProp( P_NAME, "Holzstueck" );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 200 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NEVERDROP, 1);
  
  AddCmd( ({"bastel", "bastle"}), "basteln");
}

int basteln(string str)
{
  object wfeder, spitze, sfeder, quest;
  notify_fail("Was willst Du basteln?\n");
  if(str != "pfeil" ) return 0;
  if( !quest=present(BOGENQUESTID, TP) )
  {
    write("Ohne Turnierzettel hat das keinen Sinn!\n");
    call_out("remove",0);
    return 1;
  } 
  if( present(QUEST_PFEIL, TP) )
  {
    write("Aber Du hast ja schon einen Pfeil!\n\n"
      "Da Du das Holzstueck nicht mehr brauchst, wirfst Du es weg.\n");
    call_out("remove", 0);
    return 1;
  }
  if( spitze=present(QUEST_SPITZE,TP) )
  {
    if( (wfeder=present(QUEST_WFEDER,TP)) && (sfeder=present(QUEST_SFEDER, TP)) ) 
    {
      write("Du bastelst Dir einen schoenen Pfeil.\n");
      say( CAP_TPN+ " bastelt sich einen schoenen Pfeil.\n");
      sfeder->remove();
      spitze->remove();
      wfeder->remove();
      CLONE( OBJ "pfeil_1", TP);
      quest->quest_teil(BQ_PFEILBASTELN); 
      call_out("remove", 0);
      return 1;
    }
    notify_fail("Du hast nicht die passenden Federn!\n");
  }
  else
    notify_fail("Du hast ja keine passende Pfeilspitze!\n");
  return 0;
}

