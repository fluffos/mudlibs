// Pfeilspitze fuer Bogenquest
// 12-08-97 Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Eine Pfeilspitze");
  SetProp( P_LONG, 
    "Diese Pfeilspitze aus bestem Zwergenstahl macht aus jedem Pfeil eine "
    "gefaehrliche Waffe.");
  
  AddId( ({"spitze", "pfeilspitze", QUEST_SPITZE}) );

  SetProp( P_MATERIAL, MAT_STEEL);
  SetProp( P_NAME, "Pfeilspitze" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 20 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NEVERDROP, 1);
  

}
