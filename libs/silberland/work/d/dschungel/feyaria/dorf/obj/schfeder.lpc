//  ***	 Objekt
//  ***	 Azrael@SilberLand   
//  ***     schfeder.c	            
//  ***     ----- eine schwarze Rabenfeder

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Eine schwarze Feder");
  SetProp( P_LONG, 
    "Eine schwarze Rabenfeder, sie macht einen Pfeil treffsicherer!" );

  SetProp( P_MATERIAL, MAT_FEATHER);
  SetProp( P_NAME, "Feder" );
  SetProp( P_NAME_ADJ, "schwarz");
  SetProp( P_GENDER, FEMALE );
  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 2 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NEVERDROP, 1);
  
  AddId( ({"feder" , "rabenfeder", QUEST_SFEDER}) );
  AddAdjective( ({"schwarz", "schwarze"}) );
}
