// Ein Faden fuer das Praeparationswerkzeug 
// 1998-10-19 Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp( P_SHORT, "Eine Rolle Faden");
  SetProp( P_LONG, 
    "Dieser Faden eignet sich sicher gut zum Naehen.");
  SetProp( P_NAME, "Rolle Faden" );
  SetProp( P_GENDER, FEMALE );
  AddId( ({"faden", "rolle", "rolle faden"}) );

  SetProp( P_MATERIAL, MAT_CLOTH);
  SetProp( P_VALUE, 200 );
  SetProp( P_WEIGHT, 10 );
}
