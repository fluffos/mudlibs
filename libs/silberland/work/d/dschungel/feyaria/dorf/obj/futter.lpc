// Futter fuer den Raben fuer Pfeilquest
// 12-08-97 Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp( P_SHORT, "Ein gefangener Wasserlaeufer");
  SetProp( P_LONG, 
    "Du hast diesen kleine Wasserlaeufer gefangen. Sicher kannst Du ihn "
    "verfuettern.");
  
  AddId( ({"wasserlaeufer", QUEST_FUTTER}) );
  AddAdjective( ({"gefangener", "gafangenen"}) );

  SetProp( P_MATERIAL, MAT_ANIMAL);
  SetProp( P_NAME, "Wasserlaeufer" );
  SetProp( P_NAME_ADJ, "gefangen" );
  SetProp( P_GENDER, MALE );
  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 120 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NODROP, 1);

}
