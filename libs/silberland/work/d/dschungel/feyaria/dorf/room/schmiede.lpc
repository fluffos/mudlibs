//  ***     Raum
//  ***     Azrael@SilberLand
//  ***     dorf-1a2.c 
//  ***     ----- Schmiede

inherit "std/laden";

#include <laden.h>

#include "../def.h"

void create()
{
  ::create();
  
  last=wantto=mymoney=30000;

  SetProp(P_INT_SHORT, "In einer Schmiede" );
  SetProp(P_INT_LONG,
    "Du stehst im dunklen Raum der Schmiede. In der Mitte steht ein Amboss, "
    "der allerdings sehr niedrig ist. Ueberhaupt sind alle "
    "Einrichtungsgegenstaende klein, viel zu klein um von Elfen benuetzt zu "
    "werden. Offenbar arbeitet hier ein Zwergenschmied. An der Suedwand "
    "lodert Holz in einer Esse. Daneben steht ein Eimer voll Wasser. Die "
    "Waende sind schwarz vor Russ und verschiedene Werkzeuge liegen herum. "
    "Es ist fast unertraeglich heiss hier.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:39, ENV_TERRAIN: TT_HOUSE]));
  SetStorageRoom (ROOM "schmied_store");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+ SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "schmied");
  SetProp(P_SHOPKEEPER_NAME, "der Schmied");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({"boden"}),
    "Der Boden ist voller Russ. Einige Werkzeuge liegen herum.");
  AddDetail( ({"werkzeuge", "werkzeug", "hammer", "haemmer", "zangen", 
               "zange"}),
    "Werkzeuge, die man fuers Schmieden braucht, vor allem Haemmer und "
    "Zangen.");
  AddDetail( ({"eimer", "wasser"}),
    "Ein Eimer voller Wasser steht neben der Esse. Dort wird das gluehende "
    "Eisen abgeschreckt.");
  AddDetail( ({"eisen", "stahl"}),
    "Der Schmied verarbeitet hier hauptsaechlich Eisen und Stahl.");
  AddDetail( ({"einrichtungsgegenstaende", "einrichtung", "gegenstaende"}),
    "Die Einrichtungsgegenstaende sind zu klein fuer Elfen, sie muessen wohl "
    "einem Zwerg gehoeren.");
  AddDetail( ({"elf", "elfen"}),
    "Obwohl Du in einem Elfendorf bist, wohl hier sich kein Elf sondern eher "
    "ein Zwerg.");
  AddDetail( ({"esse", "feuer", "suedwand"}),
    "In der Esse an der Suedwand lodert ein helles Feuer. Sicher ist es "
    "heiss genug, um Eisen fluessig zu machen. Das ist auch der Grund, warum "
    "es hier noch heisser ist als draussen in der Sonne.");
  AddDetail( ({"holz"}),
    "In der Esse verbrennt Holz.");
  AddDetail( ({"zeit"}),
    "Die Zeit vergeht viel zu schnell."); 
  AddDetail( "raum", 
    "Es ist dunkel hier drinnen, nur eine Oellampe, die von der Decke "
    "haengt, und das Feuer in der Esse geben ein wenig Licht." );
  AddDetail( "decke",
    "Sie ist, wie die Waende, schwarz vom Russ. Eine kleine Oellampe haengt "
    "hier und scheint neben der Esse die einzige Lichtquelle zu sein." );
  AddDetail( ({ "wand", "waende" }),
    "Der Russ hat die Waende mit der Zeit tiefschwarz eingefaerbt. " );
  AddDetail( "russ",
    "Alles hier im Raum ist russig und egal was man beruehrt, es faerbt "
    "schwarz ab." );
  AddDetail( "mitte",
    "In der Mitte der Schmiede steht ein niedriger Amboss." );
  AddDetail( "amboss",
    "Sehr niedrig...Zwergengroesse, aber was macht ein Zwergenschmied in einem "
    "Elfendorf ? - Eigenartig. Zur Zeit wird er gerade nicht benutzt, falls  "
    "Du etwas schmieden oder zusammenbauen willst, kannst Du den Amboss "
    "sicher benutzen." );
  AddDetail( ({ "dorf", "elfendorf" }),
    "Du stehst in der Schmiede des Elfendorfes." );
  AddDetail( "schmiede",
    "Sie wird, wie Du unschwer erkennen kannst von einem Zwerg gefuehrt." );
  AddDetail( ({ "lampe", "oellampe", "licht", "lichtquelle" }),
    "Sie haengt von der Decke und gibt ein wenig Licht." );

  AddSound( ({DEFAULT_SOUND, "haemmern"}),
    "Das Haemmern des Schmiedes ist so laut, dass Du sonst fast nichts "
    "hoerst.");
        
  AddSmell( ({DEFAULT_SMELL, "feuer", "schmiedefeuer"}),
    "Es riecht nach Schmiedefeuer." );

  AddItem( NPC "schmied", REFRESH_DESTRUCT );

  AddExit( "westen", "./dorf-008" );

  AddCmd( ({"schmiede", "schmied"}), "schmieden");
  AddCmd( ({"bau", "baue"}), "bauen");

}

varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if( ob->QueryMaterialGroup(MATGROUP_METAL)>10 )
  {
    return ::do_sell(ob, force, prefix, limit);
  }
  else
  {
    write("Der Schmied sagt: Tut mir leid, ich kaufe nur Metallsachen.\n");
    return 1;
  }
}

int schmieden(string str)
{
  notify_fail("Was willst Du schmieden?\n");
  return 0;
}

int bauen(string str)
{
  object ob,ob1,ob2,ob3;
  notify_fail("Was willst Du zusammenbauen?\n");
  if(str=="drachenlanze" || str=="drachenlanze zusammen" || 
     str=="drachentoerter" || str=="drachentoeter zusammen")
  {
    ob1=present("\ndrachenlanzenspitze", TP);
    ob2=present("\ndrachenlanzenschaft", TP);
    ob3=present("\ndrachenlanzengriff", TP);
    if(ob1 && ob2 && ob3)
    {
      write(BS("Du befestigst den Griff und die Spitze am Schaft und fertigst "
          "Dir eine schoene neue Drachenlanze.")); 
      ob=clone_object("/d/gebirge/feyaria/drachen/weapon/drachenlanze.lpc");
      ob1->modify_dragonlance(ob);
      ob2->modify_dragonlance(ob);
      ob3->modify_dragonlance(ob);
      WLOG( LOG "drachenlanzenbau", 
          sprintf("baut eine Drachenlanze (Magie: %d) uids:%s,%s,%s",
          ob->query_dragon_magic(), ob1->QueryProp(P_CLONER), 
          ob2->QueryProp(P_CLONER), ob3->QueryProp(P_CLONER)));
      ob1->remove();
      ob2->remove();
      ob3->remove();
      ob->fertig();
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    else
    {
      write("Du hast nicht alle Teile um eine Drachenlanze zusammenzubauen.\n");
      return -1;
    }
  }
  write("Was willst Du zusammenbauen?\n");
  return -1;
}
      
