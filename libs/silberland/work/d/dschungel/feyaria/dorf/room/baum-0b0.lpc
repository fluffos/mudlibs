// ***     Raum             
// ***     Azrael@SilberLand
// ***     baum-0b0.c       
// ***     ----- Baum Prototyp fuer Bogenschuetzenturnier-Quest

inherit "std/room";

#include "../def.h"
#include "../quest.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Baum" );
  SetProp(P_INT_LONG,
    "Du bist auf einer gewaltigen Blutulme. Dir ist etwas unheimlich zumute, "
    "denn Dir kommt es vor, als wuerde der Baum Dich beobachten. Ein schoener "
    "gerader Ast ragt hier aus dem Stamm. Das dichte Blaetterdach versperrt "
    "den Blick zum Himmel. Der Boden ist weit unter Dir.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_JUNGLE]));

  AddDetail( ({"baum", "ulme", "blutulme", "name"}),
    "Es ist eine Blutulme. Dir kommt vor, als wuerde sie Dich beobachten." );
  AddDetail( ({"ast", "aeste"}),
    "Ein schoener gerader Ast ragt hier aus dem Stamm. Dieser Ast wuerde "
    "sich sicher fuer einen Pfeil eignen."); 
  AddDetail( ({"pfeil", "pfeile"}),
    "Du hast noch keinen Pfeil. Aber vielleicht koenntest Du aus dem Ast "
    "einen Pfeil machen.");
  AddDetail( ({"stamm", "rinde"}),
    "Der Stamm ist sehr glatt und hat eine blutrote Farbe.");
  AddDetail( ({"farbe", "rot", "blutrot"}),
    "Das Blutrot gibt diesem Baum seinen Namen.");
  AddDetail( ({"blatt", "blaetter", "dach", "blaetterdach"}),
    "Natuerlich hat die Blutulme auch Blaetter. Die sind aber ganz normal "
    "gruen, und nicht rot!");
  AddDetail( ({"boden"}),
    "Der Boden ist weit unter Dir; vielleicht haettest Du nicht so hoch "
    "heraufklettern sollen.");
  AddDetail( ({"blick", "himmel", "sonne"}),
    "Himmel und Sonne sind durch die dichten Blaetter nicht zu sehen.");
  AddSound( ({DEFAULT_SOUND, "rascheln", "blaetter"}),
    "Die Blaetter rascheln leise.");
  AddSmell( ({DEFAULT_SMELL}),
    "Es riecht angenehm hier.");

  AddCmd( "bitte", "bitte");
  AddCmd( "danke", "danke");
  AddCmd( ({"schneid", "schneide"}), "schneiden");
  AddCmd( ({ "brich", "breche"}), "brechen");
                        
  AddExit("unten", "./baum-000");

}

int brechen(string str)
{
  notify_fail("Was willst Du abbrechen?\n");
  if( str == "ast" || str == "ast ab")
  {
    write("Der Ast ist zu hart, den kannst Du nur abschneiden!\n");
    return 1;
  }
  return 0;
}

int schneiden(string str)
{
  object waffe;
  notify_fail("Was willst Du abschneiden?\n");
  if (!str) return 0;
  if( str == "ast" || str == "ast ab")
  {
    if( waffe = TP->QueryProp(P_WEAPON) )
    {
      if( waffe->QueryProp(P_WEAPON_TYPE) == WT_SWORD &&
          waffe->QueryProp(P_WC) > 99 )
      {
        write(BS("Als Du versuchst, den Ast abzuschneiden, schreit die "
           "Blutulme laut auf. Vielleicht solltest Du den Baum vorher um "
           "den Ast bitten."));
        say( CAP_TPN+ " versucht vergeblich, einen Ast abzuschneiden.\n");
        return 1;
      }
      else
        notify_fail(waffe->Name()+ " ist nicht scharf genug zum Abschneiden.\n");
    }
    else
      notify_fail("Du brauchst ein Waffe zum Abschneiden!\n");
  }
  return 0;
}

int  bitte ( string str )
{
  string s1, s2;
  object ob;
  notify_fail ("Worum willst Du bitten?\n" );
  if (!str) return 0;
  if ( sscanf(str, "%s um %s", s1, s2)==2 )
  {
    if( (s1 == "baum" || s1 == "ulme" || s2 == "blutulme") && 
        ( s2 == "ast" || s2 == "holz" ) )
    {
      if( (ob=present(BOGENQUESTID, TP)) && !present(QUEST_HOLZ, TP) &&
        !present(QUEST_PFEIL, TP) )
      { 
        write( BS("Die Blutulme erkennt, dass Du den Ast wirklich dringend "
          "brauchst und ueberlaesst ihn Dir freiwillig. Was eine kleine Bitte "
          "so alles bewerkstelligen kann....") );
        say ( CAP_TPN + " bekommt einen Ast.\n" );
        CLONE(OBJ "pfeil_0", TP);
        ob->quest_teil(BQ_HOLZ);
      }
      else
      {
        write("Der Baum verweigert Dir den Ast.\n");
      }
      return 1;
    }
  }
  notify_fail ("Wen willst Du um was bitten?\n" );
  return 0;
}

int danke(string str)
{
  notify_fail("Wem willst Du danken?\n");
  if( str=="ulme" || str=="blutulme" || str=="baum")
  {
    write("Du bedankst Dich bei der Blutulme.\n"
        "Dir wird ganz warm ums Herz.\n");
    return 1;
  }
  return 0;
}


