//  ***     Raum                        
//  ***     Azrael@Silberland 
//  ***     dorf-015.c                
//  ***     ----- Badesteg im Pfahldorf

inherit "std/room";

#include "../def.h"
#include "../quest.h"

string waschen;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Steg" );
  SetProp(P_INT_LONG,
     "Der Steg verbreitert sich und senkt sich bis auf die Hoehe des "
     "Wasserspiegels. Vermutlich kommen die Bewohner des Dorfes hierher um "
     "zu fischen, oder um zu baden, denn in einem kleinen Umkreis ist das "
     "Wasser frei von Algen und Schlingpflanzen, sodass man gemuetlich "
     "schwimmen koennte. Nach Suedwesten kommst Du zurueck auf den Dorfplatz "
     "und vor die Schmiede.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen. Aber hier "
    "kannst Du Dich ja mit einem Bad abkuehlen.");
  AddDetail( "schmiede",
    "Sie liegt jetzt genau suedlich von Dir, Du musst aber ueber den Steg "
    "nach Suedwesten, um zum Eingang zu kommen. Von hier ist nur die "
    "Nordwand sichtbar.");
  AddDetail( "eingang",
    "Der Eingang der Schmiede liegt am Dorfplatz im Suedwesten." );
  AddDetail( ({ "dorfplatz", "platz" }),
    "Ihn erreichst Du, wenn Du zurueck nach Suedwesten gehst." );
  AddDetail( ({ "nordwand", "wand" }),
    "Von hier aus siehst Du suedlich die Wand der Schmiede." );
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier angenehm breit. Das Wasser schwappt manchmal darueber "
    "und so hat sich hier im Laufe der Zeit eine gruenlich schimmernde "
    "feuchte Schicht gebildet." );
  AddDetail( "umkreis",
    "Rund um den Steg wurde hier das Wasser von Algen und Schlingpflanzen "
    "gereinigt." );
  AddDetail( ({"schlingpflanzen", "pflanzen" }),
    "Die Schlingpflanzen, die Du sonst ueberall im See gesehen hast, "
    "scheinen hier saeuberlich weggeraeumt worden zu sein, damit man hier "
    "schwimmen kann." );
  AddDetail( "schicht",
    "Eine feuchte Schicht ueberzieht den Steg dort, wo das Wasser "
    "darueberschwappt." );
  AddDetail( ({"hoehe", "wasserspiegel", "oberflaeche", "wasseroberflaeche" }),
    "Der Steg senkt sich hier bis zur Wasseroberflaeche. Absichtlich so "
    "gebaut, oder aber im morastigen Grund eingesunken? - Du wirst es nie "
    "erfahren." );
  AddDetail( "grund",
    "Der Grund des Sees ist sicher sehr morastig." );
  AddDetail( "algen",
    "Die Algen, die sonst ueberall im See zu sehen sind, wurden hier "
    "offensichtlich entfernt, um es den Elfen zu ermoeglichen baden zu gehen.");
  AddDetail( "see",
    "Er schliesst sich von allen Seiten rund um den Steg. Weit draussen "
    "schwimmen einige Schwaene herum." );
  AddDetail( ({"schwan", "schwaene"}),
    "Sie schwimmen weit draussen auf dem See herum.");
  AddDetail( "bewohner",
    "Die Bewohner dieses Pfahldorfes koennen diesen Platz zum Fischen oder "
    "Baden nutzen." );
  AddDetail( ({ "dorf", "pfahldorf" }),
    "Erst jetzt wird Dir wieder bewusst, dass das ganze Dorf ja auf "
    "Holzstaemmen steht. Am Dorfplatz hattest Du es schon fast vergessen, "
    "so stabil ist alles konstruiert." );
  AddDetail( ({ "holzstaemme", "staemme" }),
    "Das ganze Dorf steht auf Holzstaemmen." );
  AddDetail( ({ "elfen", "elf" }),
    "Elfen sind - ganz im Gegensatz zu Zwergen - aeusserst reinlich und "
    "waschen und baden sich oft mehrmals am Tag. Hier ist der richtige Platz "
    "dafuer." );
  AddDetail( "gegensatz",
    "Der Gegensatz zwischen Elfen und Zwergen ist doch ziemlich gross. " );
  AddDetail( ({ "tag", "sonnenaufgang", "aufgang", "sonnenuntergang", 
                "untergang" }),
    "Ein Tag dauert vom Sonnenaufgang bis zum Sonnenuntergang." );
  AddDetail( "platz",
    "Dieser Platz wird sicher von den Elfen zum Baden benuetzt." );
  AddDetail( ({"baden"}),
    "Vielleicht solltest Du auch ein Bad nehmen?");

  AddDetail( ({ "zwerge", "zwerg" }), 
    (["zwerg": "Naja, schau Dich doch an, Du koenntest ein frisches "
               "Bad dringend gebrauchen.",
      0:"Gute Schmiede, aber ansonsten...staubige kleine Erzbuddler."]));
  AddDetail( "wasser",
    "Frisches, sauberes Wasser schwappt manchmal ueber den Steg und um "
    "Deine Fuesse." );
  AddDetail( "zeit",
    "Tick...tack...tick...tack. Die Zeit verrinnt, aber an einem solchen Ort "
    "ist das voellig egal." );
  AddDetail( "ort",
    "Dieser Ort hier ist ruhig und angenehm, Du geniesst die Stille und das "
    "ruhige Plaetschern des Wassers." );
  AddDetail( "stille",
    "Wo kann man das in unserer stressigen Zeit noch finden?" );
  AddDetail( "plaetschern",
    "Das Plaetschern des Wassers wirkt beruhigend auf Dich, Du wirst "
    "richtig schlaefrig." );
  AddDetail( "fuesse",
    "Du schaust hinunter. Ab und zu schwappt das Wasser des Sees um Deine "
    "Fuesse." );

  AddSound( DEFAULT_SOUND,
    "Stille - nur manchmal schwappt das Wasser leise plaetschernd ueber den "
    "Steg." );

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist feucht und der Geruch des Ufers dringt schwach herueber." );

  AddExit( "suedwesten", "./dorf-008");

  AddCmd( ({"schwimme", "schwimme", "plantsche", "plantsch", "bad", "bade"}), 
            "baden");

  AddItem( ({NPC "elf_badend", NPC "wlaeufer", NPC "wasserschlange"}), 
        REFRESH_DESTRUCT);
}

int baden(string str)
{
  object ob;
  notify_fail("Wo willst Du baden?\n");
  if( !str ) return 0;
  if( member( ({"wasser", "in wasser", "see", "in see"}), str)!=-1 )
  {
    write("Du nimmst ein kurzes, aber erfrischendes Bad im Wasser.\n");
    say(CAP_TPN + " nimmt ein kurzes Bad im Wasser.\n");
    if( (ob=present(BOGENQUESTID,TP)) && !present(QUEST_WFEDER,TP) &&
            !present(QUEST_PFEIL, TP) )
    {
      write(BS("Du siehst vor Dir eine weisse Feder im Wasser treiben, "
               "die Du erfreut sofort einsteckst."));
      CLONE(OBJ "wfeder", TP);
      ob->quest_teil(BQ_WFEDER);
    }
    return 1;
  }
  return 0;
}


