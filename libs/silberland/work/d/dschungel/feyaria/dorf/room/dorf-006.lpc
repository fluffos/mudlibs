//  ***     Raum                          
//  ***     Azrael@ SilberLand 
//  ***     dorf-006.c                  
//  ***     ----- Steg im Pfahldorf

inherit "std/room";

#include "../def.h"

string li_re;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Steg" );
  SetProp(P_INT_LONG,
    "Du gehst weiter am Steg entlang, der noch breiter wird und nun schon "
    "fast als Strasse bezeichnet werden kann. Das Dorf ist wesentlich "
    "groesser als Du anfangs gedacht hast. Vor Dir eroeffnet sich eine Art "
    "Platz - wohl das Zentrum der Siedlung. Von dort schliessen die Haeuser "
    "direkt an den Steg an. Nach Norden fuehrt der Steg zurueck zum "
    "Wachhaus.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Endlich wieder festerer, sicherer Boden unter den Fuessen. "  );
  AddDetail( "strasse",
    "Die Baumstaemme, aus denen der Steg zusammengesetzt ist, sind in Reihen "
    "nebeneinander in den Grund des Sees gerammt. Sie bilden eine Plattform, "
    "auf der man gemuetlich gehen kann, wie auf einer Strasse. " );
  AddDetail( ({"fuesse", "halt" }),
    "Deine Fuesse finden sicheren Halt auf dem breiten Steg. " );
  AddDetail( "haeusser",
    "In suedlicher Richtung gelangst Du ins Zentrum des Pfahldorfes, dort "
    "stehen einige Haeusser, die direkt an den Steg angebaut sind. " );
  AddDetail( ({ "wachhaus", "haus" }),
    "Im Norden liegt, durch eine Bruecke mit dem Steg verbunden, das "
    "Wachhaus. " );
  AddDetail( "plattform",
    "Die Baumstaemme bilden eine regelrechte Plattform. " );
  AddDetail( ({"baumstaemme", "staemme", "baumstamm", "stamm"  }),
    "Dicke Staemme wurden in den Boden gerammt und bilden das Fundament des "
    "Dorfes. " );
  AddDetail( "fundament",
    "Alle Haeuser des Pfahldorfes sind auf einem Fundament aus Baumstaemmen "
    "errichtet. " );
  AddDetail( ({"reihen", "reihe"}),
    "Die Staemme sind in einer breiten Reihe in den Grund des Sees "
    "getrieben worden, und bilden so Strasse und Fundament des Dorfes. " );
  AddDetail( "see",
    "Unter Dir hoerst und spuerst Du den See gegen die Baumstaemme "
    "schlagen. " );
  AddDetail( "grund",
    "Der truegerische, morastige Grund des Sees wurde mit Baumstaemmen "
    "gespickt, damit das Dorf der Elfen darauf gebaut werden konnte. " );
  AddDetail( ({"dorf", "pfahldorf" }),
    "Eine architektonische Meisterleistung der Elfen...nur sie schaffen so "
    "etwas. " );
  AddDetail( "richtung",
    "Du kannst Richtung Norden zurueck am Wachhaus vorbei zum Ufer, und "
    "suedlich zum Zentrum des Dorfes gehen. " );
  AddDetail( "elfen",
    "Die Elfen vestehen es, den morastigen Grund des Sees zu beherrschen und "
    "bewohnbar zu machen. " );
  AddDetail( "zentrum",
    "Es liegt im Sueden, dort verbreitert sich der Steg zu einem breiten "
    "Platz. " );
  AddDetail( ({ "platz", "art" }),
    "Etwas, das Du in einem normalen Dorf als Platz bezeichnen wuerdest "
    "eroeffnet sich suedwaerts. " );
  AddDetail( ({ "meisterleistung", "leistung" }),
    "Wirklich einzigartig, was die Elfen hier erschaffen haben. " );
  AddDetail( "ufer",
    "Zum Ufer zurueck kannst Du ueber den Steg nach Norden, am Wachhaus "
    "vorbei. " );
  AddDetail( "haeuser",
    "Die Haeuser, die Du von hier aus erkennen kannst, haben eigenartigen "
    "Formen. " );
  AddDetail( ({ "formen", "gebaeude" }),
    "Kugel- und kegelfoermige Gebaeude bilden das Zentrum des Pfahldorfes "
    "im Sueden. " );
  AddDetail( "wachhaus",
    "Das Wachhaus der Elfensiedlung, von dem aus der gesamte Steg kontrolliert "
    "werden kann, liegt noerdlich an den Steg angeschlossen. " );
  AddDetail( ({ "siedlung", "elfensiedlung" }),
    "Die Siedlung ist wesentlich groesser, als Du anfangs gedacht hast. " );
  AddDetail( ({"bruecke", "bruecken" }),
    "Die meisten Haeusser sind durch kleine Bruecken mit dem Steg "
    "verbunden, so zum Beispiel das Wachhaus. " );

  AddSound( ({DEFAULT_SOUND, "quaken", "froesche", "frosch"}),
    "Es ist ruhig, nur entfernt hoerst Du einige Froesche quaken. " );

  AddSmell( DEFAULT_SMELL,
    "Frische Luft weht Dir entgegen. " );
  AddSmell( "luft",
    "Die Luft ist frisch und kuehl, wesentlich besser als das stickige "
    "Klima am Ufer." );

  AddExit( "norden", "./dorf-005" );
  AddExit( "sueden", "./dorf-007" );
  AddItem( NPC "elfwache", REFRESH_DESTRUCT );

}

