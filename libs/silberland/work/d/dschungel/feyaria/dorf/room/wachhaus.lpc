//  ***     Raum             
//  ***     Azrael@SilberLand
//  ***     dorf-1a1.c       
//  ***     ----- Wachhaus

inherit "std/room";

#include <mnpc.h>
#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Wachhaus" );
  SetProp(P_INT_LONG,
    "Du schlaegst den Vorhang zurueck und betrittst einen karg eingerichteten "
    "Raum. Du erkennst sofort, dass hier die Wachen der Dschungelelfen alle "
    "Ankommenden ueberwachen koennen. An der Wand haengen verschiedene "
    "Waffen. Ausserdem siehst Du hier einen Tisch und zwei Stuehle. In der "
    "Wand an der Uferseite sind mehrere Schiesscharten, die Du vorher gar "
    "nicht gesehen hast. Die perfekte Verteidigung, niemand kann ueber den " 
    "schmalen Steg kommen, der den Dschungelelfen feindlich gesinnt ist. ");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN: TT_HOUSE]));

  AddDetail( ({"decke", "schilf"}),
    "Die Decke besteht aus getrocknetem Schilf.");
  AddDetail( ({"vorhang", "eingang" }),
    "Der Vorhang verdeckt den Eingang zum Haus." );
  AddDetail( ({"schiesscharten", "scharten" }),
    "Du hast sie von aussen gar nicht bemerkt. Durch sie koennen die Waechter "
    "problemlos das Dorf gegen Eindringlinge verteidigen." );
  AddDetail( ({"raum", "zimmer" }),
    "Dieses Zimmer ist karg eingerichtet, man merkt, dass es einzig dem "
    "Zweck der Verteidigung dient." );
  AddDetail( "zweck",
    "Der Zweck dieses Hauses ist einzig und allein die Verteidigung des "
    "Dorfes." );
  AddDetail( ({ "wachen", "waechter" }),
    "Die Waechter finden hier allerlei Waffen, um das Dorf vor "
    "Eindringlingen zu schuetzen." );
  AddDetail( ({ "wand", "waende", "oeffnungen", "schiessscharten" }),
    "Drei Oeffnungen an der Wand Richtung Ufer, dienen offensichtlich als "
    "Schiesscharten. An der anderen haengen diverse Waffen, Schilde und " 
    "Boegen." );
  AddDetail( ({ "uferseite", "ufer" }),
    "An der Wand zum Ufer sind drei Oeffnungen in der Wand. Wahrscheinlich "
    "Schiesscharten zu Verteidigungszwecken.");
  AddDetail( ({ "ankommende", "eindringlinge", "fremde" }),
    "Jeder Fremde muss an diesem Wachhaus vorbei, wenn er ins Dorf will.");
  AddDetail( "waffen",
    "An der dem Ufer abgewandten Seite haengen verschiedenste Waffen "
    "griffbereit. Neben Schwertern, Degen und leichten Dolchen finden die "
    "Waechter auch Schilde und Boegen hier." );
  AddDetail( ({ "dolch", "dolche", "nahkampf" }),
    "Dolche sind besonders fuer den Nahkampf geeignet." );
  AddDetail( "schwerter",
    "Schwerter in verschiedenen Groessen sind an Haken waagrecht an der "
    "Wand befestigt. Sie sind schartig, scheinen also oft gebraucht zu "
    "werden." );
  AddDetail( ({"groessen", "groesse" }),
    "Es ist allbekannt, dass Elfen lieber leichtere Waffen verwenden um ihre "
    "Beweglichkeit im Kampf ausspielen zu koennen. Es sind hier also "
    "ausschliesslich Einhaender fuer die Waechter bereitgestellt." );
  AddDetail( "einhaender",
    "Das sind Waffen, die man einhaendig fuehrt und so beweglicher bleibt." );
  AddDetail( ({"degen", "florett" }),
    "Diese leichteren Stichwaffen werden von Elfen am liebsten verwendet. Und "
    "das aus verschiedenen Gruenden." );
  AddDetail( ({"stichwaffen","elfenwaffe" }),
    "Neben dem Degen ist auch das Florett eine typische Elfenwaffe, die die "
    "elfische Beweglichkeit im Kampf besinders zur Geltung kommen laesst." );
  AddDetail( ({ "gruende", "elfenwaffe", "elfenwaffen" }),
    "\tWarum Elfen lieber leichte Waffen tragen hat mehrere Gruende: \n"
    "1. koennen sie so ihre Beweglichkeit voll ausspielen. \n"
    "2. jagen sie meist, indem sie sich vorsichtig anpirschen und dann \n"
    "   blitzschnell zuschlagen, wobei eine schwere Waffe sicher \n"
    "   hinderlich waere.\n"
    "3. waere ihnen ein Zweihaender bei ihrem Fortbewegen in Baeumen \n"
    "   oder - wie hier - in Suempfen ebenfalls mehr Last als Hilfe. \n" );
  AddDetail( ({ "baeume", "waldelfen" }),
    "Elfen und ganz besonders Waldelfen koennen hervorragend klettern und "
    "bewegen sich auf Baeumen genauso schnell, wie am Boden." );
  AddDetail( ({"sumpf", "suempfe" }),
    "Das Dorf befindet sich mitten in den Suempfen." );
  AddDetail( ({ "zweihaender", "last" }),
    "Man wird selten einen Elfen mit einem Zweihaender kaempfen sehen, "
    "da die Last solcher Waffen ihre Beweglichkeit deutlich einschraenkt." );
  AddDetail( "beweglichkeit",
    "Alle Elfen sind von Natur aus mit einen unglaublichen Beweglichkeit "
    "ausgestattet, die sie im Kampf auch voll ausspielen, die aber durch "
    "schwere Waffen, wie Zweihaender es sind, stark eingeschraenkt wuerde, "
    "weshalb leichtere Waffen bevorzugt werden." );
  AddDetail( "kampf",
    "Elfen sind im Kampf besonders gefaehrlich, wenn sie ihre Beweglichkeit "
    "voll ausspielen koennen." );
  AddDetail( ({"elfen", "wesen" }),
    "Diese hochgewachsenen, schlanken Wesen sind fuer jeden ein kaum "
    "loesbares Raetsel. Sie bewegen sich lautlos durch dichtes Gestruepp und "
    "sind Meister im Bogenschiessen und Bogenmachen. Das hervorstechendste "
    "Merkmal dieser Wesen sind ihre spitz zulaufenden Ohren." );
  AddDetail( "gestruepp",
    "Elfen koennten sich lautlos durch Gestruepp bewegen, das hoert man sich "
    "immer wieder erzaehlen." );
  AddDetail( ({"bogenschiessen", "bogenmachen", "bogner" }),
    "Sicherlich findest Du hier im Dorf einen Bogner oder gar einen "
    "Schiessstand, wo einiges ueber diese Kunst erfahren kannst." );
  AddDetail( "schiessstand",
    "Hier gibt es sicher irgendwo einen Schiessstand, an dem die Elfen sich "
    "im Bogenschiessen ueben koennen." );
  AddDetail( ({ "merkmal", "ohren" }),
    "Tja, die Ohren, merke wohl, verspotte niemals die Ohren eines Elfen! Es "
    "koennte Dir schlecht bekommen." );
  AddDetail( "raetsel",
    "Niemand wird jemals die Elfen ganz verstehen koennen. Versuch es erst "
    "gar nicht!" );
  AddDetail( ({"boegen", "bogen", "ecke"}),
    "Bespannte und unbespannte Boegen lehnen saeuberlich gestapelt in der "
    "Ecke hinter dem Eingang. Mit ihnen scheint es leicht das Dorf durch die "
    "Schiessscharten zu verteidigen, wenn man weiss, dass Elfen Meister im "
    "Bogenschiessen sind." );
  AddDetail( ({"meister", "kunst" }),
    "Elfen sind Meister in der Kunst des Bogenschiessens, aber auch des "
    "Bogenmachens." );
  AddDetail( "dorf",
    "Dieses Haus ist strategisch optimal zur Verteidigung des Dorfes gebaut. "
    "Jeder Besucher muss hier vorbei. Obwohl Du gehoert hast, dass jedes "
    "Elfendorf immer auch mehrere geheime, nur den Bewohnern bekannte "
    "Eingaenge hat." );
  AddDetail( "besucher",
    "Jeder Besucher muss hier am Wachhaus vorbei, wenn er ins Dorf will, "
    "obwohl es sicher noch mindestens einen geheimen Zugang geben muss." );
  AddDetail( "zugang",
    "Du hast irgendwo einmal gehoert, dass solche Elfendoerfer meistens mehr "
    "als nur einen Zugang haben. Diese anderen Zugaenge sind aber meistens "
    "geheim und nur wenigen Elfen bekannt." );
  AddDetail( "bewohner",
    "Zweifellos wohnen hier im Dorf Dschungelelfen." ),
  AddDetail( ({"dschungelelfen", "dschungel" }),
    "Dschungelelfen wohnen, schwer zu erraten, im Dschungel." ); 
  AddDetail( ({"eingaenge", "elfendoerfer", "elfendorf" }),
    "Irgendwo hast Du einmal gehoert, dass Elfendoerfer neben den "
    "oeffentlichen Eingaengen auch immer mehrere versteckte haben sollen, "
    "die aber nur den Bewohnern und manchmal nicht einmal allen von ihnen "
    "bekannt sind." );
  AddDetail( "steg",
    "Der schmale Steg, den Du duch die Oeffnungen an der Wand sehen kannst, "
    "kann vom Wachhaus aus kinderleicht kontrolliert und verteidigt werden." );
  AddDetail( ({"verteidigung", "uebermacht" }),
    "Von diesem Wachhaus aus koennen wenige Wachen sich einer gewaltigen "
    "Uebermacht an Feinden erwehren, wenn sie Boegen und genuegend Pfeile "
    "haben." );
  AddDetail( "feinde",
    "Den Waffen nach zu schliessen kommen immer wieder Feinde der Elfen "
    "hier vorbei." );
  AddDetail( ({"haus", "wachhaus" }),
    "Du bist jetzt im Wachhaus. Ein Tisch und zwei Stuehle stehen hier und "
    "an der Wand haengen verschiedenste Waffen griffbereit." );
  AddDetail( "tisch",
    "Gegenueber des Eingangs steht ein hoelzerner Tisch mit zwei Stuehlen, auf "
    "dem mehrere Koecher mit Pfeilen liegen." );
  AddDetail( "stuehle",
    "Auf diesen Stuehlen koennen sich die Waechter ausruhen und trotzdem durch "
    "die Oeffnungen in der Wand den Steg beobachten." );
  AddDetail(  "koecher",
    "Mehrere schoen mit Stickereien verzierte Koecher voll mit Pfeilen "
    "liegen auf dem Tisch, um jederzeit zur Verteidigung verwendet werden "
    "zu koennen." );
  AddDetail( "stickereien",
    "Ornamentreiche Stickereien, wie man es von Elfen gewohnt ist." );
  AddDetail( ({"oramente"}),
    "Ornamente wie sie die Elfen lieben.");
  AddDetail( "pfeile",
    "Du siehst nur die schwarze Fiederung, die aus den Koechern ragt." );
  AddDetail( ({ "fiederung", "federn", "flugbahn" }),
    "Schwarze Federn wurden hier verwendet um die Flugbahn der Pfeile zu "
    "sichern." );
  AddDetail( "boden",
    "Der Boden besteht aus Baumstaemmen, die in den Grund des Sees gerammt "
    "wurden." );
  AddDetail( ({"baumstaemme", "baumstamm", "stamm", "staemme", "stabilitaet"}),
    "Die Baumstaemme geben dem Wachhaus sein Stabilitaet.");
  AddDetail( ({"see"}),
    "Das Wachhaus steht im See. Wenn Du den See genauer sehen willst, musst Du "
    "nach draussen gehen.");
  AddDetail( "haken",
    "Die Schwerter haengen an Haken waagrecht an der Wand."); 
  AddDetail( ({"schilde", "schild"}),
    "An der Wand haengen auch Schilde, die aber kaum verwendet werden "
    "duerften, vielleicht am ehesten noch fuer einen Kampf ausserhalb des "
    "Dorfes. " );

  AddSound( DEFAULT_SOUND,
    "Komisch, Dir kommt vor, als koenntest Du hier jedes kleinste Geraeusch "
    "vom Ufer her hoeren.");
  AddSound( "ufer",
    "Aus einem unerklaerlichen Grund hoert man hier die Geraeusche am Ufer "
    "besonders deutlich." );
  AddSound( ({"geraeusch", "geraeusche" }),
    "Jedes kleinste Rascheln hoert man hier im Raum, warum weisst Du nicht." );

  AddSmell( ({DEFAULT_SMELL, "geruch", "wasser"}),
    "Von draussen her dringt der Geruch des Wassers in Deine Nase." );

  AddItem( NPC "elfwache", REFRESH_DESTRUCT, ([P_MNPC_FLAGS: 0]) );
  AddItem( ({NPC "elfwache", NPC "elfwache", NPC "elfwache", NPC "elfwache", 
             NPC "elfwache", NPC "elfwache", NPC "elfwache", NPC "elfwache", 
             NPC "elfwache", NPC "elfwache", NPC "elfwache", NPC "elfwache", 
             NPC "gilagas" }), REFRESH_DESTRUCT, ([P_MNPC_FLAGS: 0]) );
  AddItem( NPC "elfwache", REFRESH_DESTRUCT );

  AddExit( "westen", "./dorf-005" );

}



