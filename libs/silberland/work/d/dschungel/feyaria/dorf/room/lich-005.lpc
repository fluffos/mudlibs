//  ***     Raum                     
//  ***     Azrael@SilberLand 
//  ***     weid-005.c
//  ***     ----- Weide und Zielscheibe fuer Bogenturnier


inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine sumpfige Wiese" );
  SetProp(P_INT_LONG,
    "Die Wiese stoesst hier direkt an den See. Das Schilf steht zu allen Seiten "
    "undurchdringlich dicht, nur nach Nordosten kann man durchgehen. Hier steht "
    "eine grosse Zielscheibe, auf die offensichtlich irgendjemand vom See aus "
    "schiesst, denn immer wieder prallen Pfeile auf die Scheibe. Ein Elf steht "
    "hier und nimmt immer wieder die Pfeile aus der Scheibe und ruft Zahlen in "
    "Richtung See.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN: TT_JUNGLE]));

  AddDetail( ({"himmel", "sonne"}),
    "Die Sonne scheint warm vom Himmel herunter.");
  AddDetail( "wiese",
    "Die Wiese grenzt hier direkt an den See." );
  AddDetail( ({"boden", "untergrund", "weg" }),
    "Du stehst am morastigen Ufer eines Sees. Deine Fuesse versinken mit einem"
    " blubbernden Geraeusch im Schlamm." );
  AddDetail( "fuesse",
    "Du schaust hinunter zu Deinen Fuessen. Sie sinken fast knoecheltief "
    "in den  morastigen Untergrund." );
  AddDetail( "schlamm",
    "Der Boden hier am Ufer ist ziemlich schlammig." );
  AddDetail( "ufer",
    "Die Wiese stoesst direkt an das Ufer eines Sees. " );
  AddDetail( "see",
    "Hier beginnt der See, den Du schon vorher hinter dem Schilf vermutet hast.");
  AddDetail( ({"wasser"}),
    "Der See ist voller Wasser.");  
  AddDetail( ({"schilf", "seiten" }),
    "Das Schilf steht hier dicht und undurchdringlich, nur nach Nordosten "
    "kannst Du durch und zurueck zur Wiese. " );
  AddDetail( "zielscheibe",
    "Eine sehr grosse Scheibe aus geflochtenem Stroh, auf der konzentrische "
    "Kreise in schwarzer und weisser Farbe aufgemalt sind. " );
  AddDetail( "farbe",
    "Auf die Scheibe sind mit schwarzer und weisser Farbe Kreise gemalt. " );
  AddDetail( "kreise",
    "Sie zeigen die Punkte an, die die Bogenschuetzen getroffen haben; es sind "
    "zehn abwechselnd schwarz und weiss gefaerbte Kreise und ein roter Punkt "
    "in der Mitte der Scheibe. " );
  AddDetail( ({ "bogenschuetzen", "schuetzen" }),
    "Sie muessen irgendwo auf dem See sein, denn von dort her kommen die Pfeile.");
  AddDetail( "punkte",
    "Je weiter in der Mitte der Scheibe, desto mehr Punkte erhaelt man. " );
  AddDetail( "zahlen",
    "Der Elf ruft immer wieder die Zahlen, die wohl die Ergebnisse der Schuesse "
    "sind, in Richtung See. " );
  AddDetail( ({"ergebnisse", "schuesse" }),
    "Der Elf ruft immer wieder die Ergebnisse der Schuesse zum Steg hin. " );
  AddDetail( "elf",
    "Er steht neben der Scheibe, nimmt immer wieder die Pfeile heraus und ruft "
    "Zahlen in Richtung See. " );
  AddDetail( "scheibe",
    "Eine grosse Scheibe aus geflochtenem Stroh, die auf Staendern steht. " );
  AddDetail( "staender",
    "Die Zielscheibe ist auf hoelzerne Staender gestellt und verhindert so, "
    "dass sie durch die Wucht der aufprallenden Pfeile nach hinten ueberkippt.");
  AddDetail( ({ "wucht", "pfeile", "pfeil" }),
    "Immer wieder treffen Pfeile mit enormer Wucht auf die Zielscheibe. " );
  AddDetail( ({ "stroh", "buendel" }),
    "Das Stroh ist in kreisfoermig zusammengedrehten Buendeln geflochten und "
    "abwechselnd schwarz und weiss eingefaerbt. Lediglich die Mitte ist rot "
    "gefaerbt. " );
  AddDetail( ({"mitte", "punkt"}),
    "Der Punkt in der Mitte ist rot gefaerbt, wohl um auf die Entfernung hin "
    "besser sichtbar zu sein. " );
  AddDetail( "entfernung", 
    "In einiger Entfernung von der Scheibe siehst Du mehrere Personen auf einem "
    "Steg stehen. Von dort werden auch immer wieder Pfeile abgeschossen. " );
  AddDetail( ({ "personen", "leute" }),
    "Sie stehen in einiger Entfernung auf dem Steg." );
  AddDetail( ({"entfernung", "einzelheiten"}),
    "Die Entfernung ist zu gross, um naehere Einzelheiten zu erkennen.");
  AddDetail( "steg",
    "Draussen im See siehst Du einen Steg, auf dem mehrere Leute stehen. " );
  AddDetail( ({"froesche", "frosch"}),
    "Sehen kannst Du keinen Frosch, Du kannst nur ihr Quaken hoeren.");

  AddSound( ({DEFAULT_SOUND}),
    "Du hoerst das Quaken der Froesche und das Blubbern unter Deinen "
    "Fuessen.");
  AddSound( ({"froesche", "frosch", "quaken"}),
          "Einige Froesche quaken im seichten Wasser des Sees. " );
  AddSound( ({"geraeusch", "blubbern"}),
          "Bei jedem Schritt blubbert es unter Deinen Fuessen. " );

  AddSmell( ({DEFAULT_SMELL, "sumpf", "algen"}),
          "Es riecht nach Sumpf und Algen." );
 
  AddRoomMessage( ({
          "Ein Pfeil verfehlt die Zielscheibe nur knapp.\n",
          "Ein Pfeil trifft den roten Punkt der Zielscheibe.\n",
          "Ein Pfeil trifft fast das Zentrum der Zielscheibe.\n",
          "Ein Pfeil schlaegt in die Zielscheibe ein.\n",
          "Ein Pfeil trifft den Rand der Zielscheibe.\n",
          "Der Elf neben der Zielscheibe sammelt die Pfeile auf.\n",
          "Irgendwo quaken einige Froesche im Schilf.\n"
                                         }), 15, "treffer" );

// AddId( NPC "????????", REFRESH_DESTRUCT ); ---- ein Elf, der die Pfeile wegraeumt  

  AddExit("nordosten",  "./lich-004" );
  
}

void treffer(int msg)
{
  int i;
  switch(msg)
  {
    case 1:
      call_out("rufen", 2, 100);
      break;
    case 2:
      i=24+random(31);
    case 3:
      i+=12+random(21);
    case 4:
      i+=3+random(11);
      call_out("rufen", 2, i);
      break;
  }
}

void jubeln()
{
  tell_room(TO, "Du hoerst ein Jubeln aus der Ferne.\n");
}

void rufen(int i)
{
  tell_room(TO, "Der Elf ruft: "+i+" Punkte!\n");
  if( i>80 ) call_out("jubeln",2);
}
 
