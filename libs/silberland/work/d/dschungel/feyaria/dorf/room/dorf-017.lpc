//  ***     Raum
//  ***     Azrael@SilberLand
//  ***     dorf-017.c 
//  ***      ----- Bogenschiessplatz

inherit "std/room";

#include "../def.h"
#include "../quest.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Bogenschiessplatz" );
  SetProp(P_INT_LONG,
   "Der Steg fuehrt in den See hinaus. Nach Norden hin verhindert ein "
   "Gelaender, dass die Teilnehmer des Turniers ins Wasser des Sees fallen. "
   "Nach Osten kommst Du ins Haus des Bogners und nach Sueden zur "
   "Turnierleitung. In einiger Entfernung siehst Du noerdlich eine "
   "Zielscheibe am Ufer. Eine genaue Regelbeschreibung haengt an der Wand "
   "des Hauses im Osten.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({"platz", "dorfplatz"}),
    "Der Dorfplatz muesste irgendwo im Osten sein.");
  AddDetail( ({"dorf", "elfen"}),
    "Du befindest Dich im Dorf der Elfen.");
  AddDetail( ({"entfernung"}),
    "Die Entfernung zur Zielscheibe ist wirklich gross. Ob Du sie "
    "ueberhaupt treffen kannst?");
  AddDetail( ({"haus", "bogner"}),
    "Das Haus des Bogners ist gleich im Osten. Ganz praktisch fuer die "
    "Bogenschuetzen.");
  AddDetail( ({"bogenschuetzen", "bogenschuetze", "schuetzen", "schuetze"}),
    "Die Bogenschuetzen schiessen von hier auf die Zielscheibe am Ufer.");
  AddDetail( ({ "steg", "boden" }),
   "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
   "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
   "ueber einem See stehst." );
  AddDetail( ({ "staemme", "holzstaemme" }),
    "Das ganze Dorf ist auf Holzstaemme gebaut." );
  AddDetail( ({"wasser"}),
    "Das Wasser ist hier im See.");
  AddDetail( "see",
    "Der See breitet sich Richtung Sueden vor Dir aus. Ganz entfernt "
    "steht eine grosse runde Scheibe am Ufer." );
  AddDetail( ({"ufer"}),
    "Am Ufer ist ein Zielscheibe aufgebaut.");
  AddDetail( "scheibe",
    "Eine Scheibe mit schwarzen und weissen konzentrischen Kreisen drauf." );
  AddDetail( "kreise",
    "Die Kreise zeigen wohl die Wertigkeit der Pfeiltreffer an. " );
  AddDetail( "gelaender",
    "Hinter diesem Gelaender beginnt der See. Von hier aus muss man eine "
    "Zielscheibe am Ufer treffen." );
  AddDetail( "teilnehmer",
    "Die Teilnehmer des Turniers koennen sich hier und im Sueden auf den "
    "Wettbewerb vorbereiten." ); 
  AddDetail( ({"turnier", "turnierplatz", "wettbewerb"}),
    "Das also ist der Turnierplatz, hier spielt sich alles ab. " );
  AddDetail( ({"zielscheibe"}),
    "Du kannst hier ueben oder Deinen entscheidenden Schuss machen. " );
  AddDetail( ({"schuss", "pfeiltreffer", "treffer"}),
    "Damit Dein Schuss ein guter Treffer wird, musst Du auch viel ueben!");
  AddDetail( ({"wand", "waende"}),
    "An der Wand im Osten haengt ein Zettel mit den genauen Regeln fuer das "
    "Turnier." );
  AddDetail( ({"regeln", "regelbeschreibung"}),
    "Die Regeln kannst Du auf dem Zettel lesen.");
  AddDetail( ({"zettel"}),
    "Er haegt an der Wand und Du kannst ihn lesen.");                        
  AddDetail( ({"turnierleitung"}),
    "Die Turnierleitung ist im Sueden zu finden."); 
 
  AddReadDetail( ({ "zettel", "regeln", "regelbeschreibung", "beschreibung" }),
         "     ************************************************************\n"
       + "     ***                                                      ***\n"
       + "     ***           Regeln fuer das Bogenschuetzenturnier      ***\n"
       + "     ***                                                      ***\n"
       + "     ***    1. Jeder Teilnehmer hat einen selbstgebauten      ***\n"
       + "     ***       Bogen und eigenhaendig angefertigten Pfeil     ***\n"
       + "     ***       mitzubringen.                                  ***\n"
       + "     ***                                                      ***\n"
       + "     ***    2. Zum Ueben sind beliebig viele Schuesse mit     ***\n"
       + "     ***       den Uebungspfeilen erlaubt.                    ***\n"
       + "     ***                                                      ***\n"
       + "     ***    3. Beim Turnier ist nur ein einziger Schuss       ***\n"
       + "     ***       erlaubt.                                       ***\n"
       + "     ***                                                      ***\n"
       + "     ***    4. Gewinner ist, wer seinen Pfeil in die Mitte    ***\n"
       + "     ***       der Zielscheibe plazieren kann.                ***\n"
       + "     ***                                                      ***\n"
       + "     ************************************************************\n"
       + "\n");
                

  AddSound( DEFAULT_SOUND,
   "Nur gelegentlich hoert man einen Pfeil in Richtung Zielscheibe surren, "
   "ansonsten ist es hier ganz still, damit die Bogenschuetzen nicht in ihrer "
   "Konzentration gestoert werden." );

  AddSmell( DEFAULT_SMELL,
    "Ein angenehmer Geruch steigt Dir in die Nase."  );
  AddSmell( "geruch",
    "Du kannst den Geruch nicht naeher zuordnen.");

  AddExit( "osten", "./bogner" );
  AddExit( "sueden", "./dorf-016" );

  AddCmd( ({"uebe", "ueb"}), "ueben");
  AddCmd( ({"schiesse", "schiess"}), "schiessen");
}

int ueben(string str)
{
  write("Ueben kannst Du mit 'schiesse uebungspfeil auf scheibe'.\n");
  return 1;
}
 
int schiessen( string str)
{
  string was, wohin;
  object pfeil, bogen, quest;
  int erfolg;

  notify_fail("Was willst Du wohin schiessen?\n");
  if( !str ) return 0;
  if( str == "auf scheibe" || str == "auf zielscheibe")
  {
    notify_fail("Welchen Pfeil willst Du auf die Zielscheibe schiessen?\n");
    return 0;
  }
  if( sscanf(str, "%s auf %s", was, wohin)!=2 )
    return 0;
  if( wohin=="scheibe" || wohin=="zielscheibe" )
  {
    if( !quest=present(BOGENQUESTID, TP) )
    {
      notify_fail("Du bist doch gar kein Teilnehmer des Bogenturniers!\n");
      return 0; 
    }
    if( !(bogen=present(QUEST_BOGEN, TP)) )
    {
      write("Ohne Bogen geht gar nichts!\n");
      return 1;
    }
    if( !(bogen->QueryProp(P_WIELDED) == TP ) )
    {
      write("Du solltest den Bogen schon zuecken!\n");
      return 1;
    }
    if( was=="pfeil" )
    {
      write("Willst Du einen Uebungspfeil oder den Turnierpfeil schiessen?\n");
      return 1;
    }
    else if( was=="uebungspfeil" )
    {
      if( find_call_out("pfeil")!=-1)
      {
        write("Du hast ja gerade erst geschossen, goenn Dir eine kurze "
              "Pause.\n");
        return 1;
      }
      write("Du schiesst einen Uebungspfeil auf die Zielscheibe.\n");
      call_out("pfeil",6);
      erfolg=quest->uebung();
      quest->quest_teil(BQ_GEUEBT);
      switch(erfolg+random(100)-50)
      {
        case 0..100: 
          write(BS("Der Pfeil ging voll daneben, Du bist wohl Anfaenger?"));
          break;
        case 101..200: 
          write(BS("Der Pfeil verfehlt die Scheibe nur knapp, Du musst noch "
                "viel ueben!"));
          break;
        case 201..300: 
          write(BS("Der Pfeil trifft den Rand der Scheibe, Du brauchst "
                "noch einige Uebung."));
          break;
        case 301..400: 
          write(BS("Der Pfeil trifft die Scheibe, aber trotzdem solltest Du "
                "noch etwas ueben."));
          break;
        case 401..500: 
          write(BS("Der Pfeil trifft ziemlich ins Zentrum der Scheibe, mit ein "
                "wenig Uebung wirst Du bald ein Meisterschuetze sein."));
          break;
        case 501..900: 
          write(BS("Der Pfeil trifft ins Zentrum der Scheibe, Du bist schon "
                "ein sehr guter Schuetze."));
          break;
        default:
          write(BS("Der Pfeil trifft genau ins Schwarze, Du bist ein wahrer "
                "Meisterschuetze!"));
      }
      return 1;
    }
    else if( was=="turnierpfeil")
    {
      if( !(pfeil=present(QUEST_PFEIL, TP)) )
      {
        write("Dazu brauchst Du erst einmal einen handgemachten "
              "Turnierpfeil!\n");
        return 1;
      }
      if( quest->query_uebung()<666 )
      {
        write("Du solltest noch mehr ueben, sonst hast Du ja gar keine Chance "
              "im Turnier!\n");
        return 1;
      }
      write(BS("Du schiesst Deinen Turnierpfeil auf die Zielscheibe und "
               "triffst mitten ins Schwarze."));
      if( quest->query_quest_teil()==BQ_ALLE_TEILE )
      {
        if( TP->GiveQuest(BOGENQUEST) == 1)
        {
          WLOG (BOGENQUESTLOG, "hat das Bogenschuetzenturnier gewonnen");
        }
        write("\nAlle Elfen jubeln Dir zu!\n");
        domainshout("Tenobaal ruft: "+CAP_TPN+" hat das Bogenschuetzenturnier "
            "gewonnen!\n","^/d/dschungel/feyaria/dorf$", 1);
        write(BS("Dein Bogen und Dein Pfeil bekommen einen Ehrenplatz in der "
              "Bogensammlung von Tenobaal."));
      }
      else
      {
        write(BS("Die Turnierleitung hat Deinen Schummelversuch entdeckt und "
                 "Du wirst disqualifiziert. Dein Bogen und Dein Pfeil werden "
                 "als Beweismittel beschlagnahmt."));
      }
      bogen->remove();
      pfeil->remove();
      quest->remove(); 
      return 1;
    } 
    else
      return 0; 
  }
  notify_fail("Darauf kannst Du nicht schiessen.\n");
  return 0;
}

void pfeil()
{
  return;
} 
