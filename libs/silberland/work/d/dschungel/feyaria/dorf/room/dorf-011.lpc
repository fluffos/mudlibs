//  ***     Raum                   
//  ***     Azrae@SilberLand
//  ***     dorf-011.c                
//  ***     ----- Entwurf fuer Dorfplatz

inherit "std/room";

#include "../def.h"

string menue;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz" );
  SetProp(P_INT_LONG,
    "Hier ist offensichtlich der Eingang zu einem Wirtshaus. Ueber der Tuer "
    "des Hauses haengt ein metallenes Schild und in der Tuere lehnt ein "
    "junger Elf, der Bestellungen entgegen nimmt. Gaeste, die lieber die "
    "frische Luft und die Sonne geniessen wollen, koennen sich hier an die "
    "Tische setzen. Betreten kannst Du das Wirtshaus, wenn Du nach Sueden "
    "gehst. Im Norden steht ein Verkaufsstand und im Osten plaetschert ein "
    "Brunnen." );
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( "schild",
    "Auf dem Schild sind ein spitzes Ohr und ein Bogen eingraviert und "
    "darunter steht etwas geschrieben." );
  AddDetail( "bogen",
    "Er ist auf dem Schild ueber der Tuer eingraviert." );
  AddDetail( "sonne",
    "Hier vor dem Wirtshaus kann man gemuetlich die herrliche Sonne "
    "geniessen.");
  AddDetail( "eingang",
    "Die Tuer zum Wirtshaus steht einladend offen. Darueber haengt ein "
    "metallenes Schild mit Gravuren darauf und in der Tuere lehnt ein "
    "junger Elf.");
  AddDetail( "gravuren",
    "Sehr schoen...wirklich...sie zeigen ein Ohr und einen Bogen." );
  AddDetail( "tuer",
    "Sie steht einladend offen und ein junger Elf wartet dort auf "
    "Bestellungen." );
  AddDetail( ({"bestellungen", "bestellung" }),
    "Links neben der Tuer haengt eine Liste der Getraenke, die Du hier bei "
    "dem jungen Elfen bestellen kannst." );
  AddDetail( ({ "wirtshaus", "haus" }),
    "Tja, auch Elfen haben hin und wieder Durst, man moecht es nicht glauben.");
  AddDetail( "durst",
    "Ob Du Dir nicht auch ein kuehles Glaeschen goennen solltest? " );
  AddDetail( "glaeschen",
    "Du bekommst richtig Durst, wenn Du daran denkst." );
  AddDetail( ({ "ohr", "elfenohr" }),
    "Ein langes, spitzes Elfenohr ist in das Schild eingraviert." );
  AddDetail( "luft",
    "Hier vor dem Wirtshaus ist die Luft sicher frischer als drinnen." );
  AddDetail( ({ "elfen", "platz" }),
    "Dieser Platz ist anscheinend der Treffpunkt der Bewohner, um "
    "Neuigkeiten auszutauschen, oder um einfach bei einem kuehlen Getraenk "
    "auszuspannen." );
  AddDetail( "treffpunkt",
    "Offensichtlich ist das hier der Treffpunkt der Bewohner; hier koennen "
    "sie plaudern und Neuigkeiten austauschen." );
  AddDetail( "neuigkeiten",
    "Vielleicht kannst Du von den Gaesten hier erfahren, was hier im Dorf "
    "so los ist." );
  AddDetail( "bewohner",
    "Die Bewohner treffen sich hier, um Neuigkeiten auszutauschen." );
  AddDetail( "gaeste",
    "Einige von ihnen sitzen hier an den Tischen und plaudern miteinander." );
  AddDetail( ({"tische", "tisch"}),
    "Man kann sich hinsetzen und gemuetlich etwas trinken. Neben jedem der "
    "zwei Tische stehen einige Stuehle." );
  AddDetail( ({"stuehle", "stuhl"}),
    "Neben jedem der zwei Tische stehen einige Stuehle. Leider sind schon "
    "alle besetzt, darum kannst Du Dich nicht setzen." );
  AddDetail( "dorf",
    "Na eben, jedes vernuenftige Dorf hat ein Wirtshaus." );
  AddDetail( ({"getreank", "getraenke" }),
    "Du kannst die Getraenke, die Du beim Elfenkellner bestellen kannst, von "
    "einer Liste neben der Tuer aussuchen." );
  AddDetail( ({ "elfenkellner", "kellner", "elf" }),
    "Er lehnt in der Tuere und wartet auf Deine Bestellung." );
  AddDetail( "brunnen",
    "Ein kleiner steinerner Brunnen plaetschert im Osten ruhig vor sich hin." );
  AddDetail( ({ "stand", "verkaufsstand" }),
    "Im Norden steht ein Elf hinter einem Verkaufsstand." );
  AddDetail( ({"boden", "holzstaemme", "holzstamm", "stamm", "staemme"}),
    "Der Boden besteht aus Holzstaemmen, so wie ueberall im Dorf.");

  AddSound( ({DEFAULT_SOUND, "wirtshaus", "haus"}),
    "Du hoerst Stimmengewirr und das Klirren von Glaesern aus dem Wirtshaus.");
  AddSound( ({"stimmen", "stimmengewirr", "gewirr"}),
    "Das Stimmengewirr kommt aus dem Wirtshaus."); 
  AddSound( ({"klirren", "glas", "glaeser"}),
    "Das Klirren der Glaeser kommt aus dem Wirtshaus.");
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach frischem Wasser und dem Getraenken der "
    "Wirtshausbesucher. Von drinnen steigt Dir der Geruch von frischem, "
    "gutem Essen in die Nase." );
  AddSmell( ({"wasser", "getraenke"}),
    "\tEs riecht nach frischem Wasser und Getraenken.\n"
    "Du bekommst Durst.\n");
  AddSmell( ({"geruch", "essen"}),
    "\tAus dem Wirtshaus steigt Dir ein Geruch nach Essen in die Nase.\n"
    "Du bekommst Hunger.\n");

  AddReadDetail( "schild",
    "***    Zum spitzohrigen Bogenschuetzen    ***\n"
    "***                                       ***\n" 
    "*** Kuehle Traenke --- koestliche Speisen ***\n" );
  AddDetail( "liste",
    "Du kannst die Liste lesen.");
  AddReadDetail( "liste", "@@menue@@" );

  AddExit( "norden",   "./dorf-012" );
  AddExit( "westen",   "./dorf-014" );
  AddExit( "osten",    "./dorf-010" );
  AddExit( "nordwesten","./dorf-013" );
  AddExit( "nordosten", "./dorf-007" );
  AddExit( "sueden",    "./kneipe" );

}

string menue()
{
  call_other(ROOM "kneipe", "menue");
  return "";
}

