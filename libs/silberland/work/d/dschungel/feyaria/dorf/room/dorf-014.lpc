//  ***     Raum
//  ***     Azrael@SilberLand
//  ***     dorf-014.c ----- Azrael 
//  *** ----- Auf dem Dorfplatz, zwischen Bogner und Bauschhaendler

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz" );
  SetProp(P_INT_LONG,
    "Der Steg grenzt im Westen direkt an das Wasser des Sees, nach Norden "
    "hin kannst Du ein Haus erreichen und nach Sueden gelangst Du ebenfalls "
    "zu einem Hauseingang, vor dem sich viele eigenartigen Ballen befinden. "
    "Einige Stuehle und Tische laden im Osten ein, sich hinzusetzten und ein "
    "bisschen zu rasten, waehrend ein kleiner Verkaufsstand im Nordosten "
    "aufgebaut steht.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
    "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
    "ueber einem See stehst."  );
  AddDetail( "wasser",
    "Im Westen beginnt der See, der direkt an den Steg stoest." );
  AddDetail( "see",
    "Er beginnt im Westen und dehnt sich scheinbar unbegrenzt aus. " );
  AddDetail ( ({ "verkaufsstand", "stand" }),
    "Er steht im Nordosten." );
  AddDetail( "dorf",
    "Das Elfendorf ist eigentlich ziemlich gross. Soetwas zu errichten "
    "bedeutet sicher viel Arbeit." );
  AddDetail( "ballen",
    "Sie liegen im Sueden vor einem Haus." );
  AddDetail ( ({ "eingang", "hauseingang" }),
    "Im Sueden ist ein Hauseingang vor dem einige merkwuerdige Ballen "
    "liegen." );
  AddDetail( ({ "stuehle", "tische" }),
    "Einige Tische und Stuehle stehen einladend im Osten auf dem Dorfplatz.");
  AddDetail( "elfen",
    "Nur Elfen koennen mit Holz solche Bauwerke errichten." );
  AddDetail( ({ "holzstaemme", "staemme", "holz" }),
    "Alles hier scheint aus Holz gemacht zu sein: Der Boden, die Haeuser,..."
    "und alles sieht aus, als waere es natuerlich, nichts macht einen "
    "kuenstlichen, erzwungenen Eindruck." );
  AddDetail( ({ "dorfplatz", "platz" }),
    "Der Platz grenzt hier westlich an den See, ansonsten kann man nach "
    "allen Richtungen weiter." );
  AddDetail( ({"haus", "haeuser" }), 
    "Nach Norden und nach Sueden hin stehen Haeuser." );

  AddSound( DEFAULT_SOUND,
    "Du hoerst die Geraeusche von geschaeftigen Leuten, die hier ihrer "
    "Arbeit nachgehen." );

  AddSmell( DEFAULT_SMELL,
    "Der frische Geruch des Wassers unter Dir steigt zwischen den "
    "Holzstaemmen zu Dir herauf." );

  AddItem( NPC "elfwache", REFRESH_DESTRUCT );

  AddExit( "norden",    "./dorf-013" );
  AddExit( "osten",     "./dorf-011" );
  AddExit( "nordosten", "./dorf-012" );
  AddExit( "sueden",    "./dorf-018" );
   
}

