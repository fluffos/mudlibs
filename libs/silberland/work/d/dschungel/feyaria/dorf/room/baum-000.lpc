// ***     Raum             
// ***     Azrael@SilberLand
// ***     baum-000.c       
// ***     ----- Baum Prototyp fuer Bogenschuetzenturnier-Quest

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem seltsamen Baum" );
  SetProp(P_INT_LONG,
    "Ein riesiger uralter Baum reckt sich vor Dir in den Himmel. Die Aeste "
    "beginnen erst hoch ueber Dir aus dem Stamm zu wachsen, der "
    "ungewoehnlich glatt ist. Es ist sicher sehr schwer, auf ihn "
    "hinaufzuklettern. Rund um Dich dehnt sich der beinahe undurchdringliche "
    "Dschungel aus. Ueber Dir ist das dichte Blaetterdach der "
    "Dschungelriesen, von denen viele Lianen herunterhaengen. Der Boden ist "
    "hier trocken und mit abgefallenem Laub bedeckt.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_JUNGLE]));
 
  AddDetail( "baum",
    "Es ist eine Blutulme." );
  AddDetail( ({"ulme", "blutulme", "holz"}),
    "Aus dem Holz von Blutulmen kann man angeblich sehr gute Pfeile machen.");
  AddDetail( ({"pfeil", "pfeile"}),
    "Du hast noch keinen Pfeil.");
  AddDetail( ({"ast", "aeste"}),
    "Die Aeste der Blutulme beginnen erst hoch ueber Dir.");
  AddDetail( ({"stamm", "rinde"}),
    "Der Stamm der Blutulme ist ungewoehnlich glatt und hat eine blutrote "
    "Farbe." );
  AddDetail( ({"farbe", "rot", "blutrot"}),
    "Das Blutrot gibt diesem Baum seinen Namen.");
  AddDetail( ({"blatt", "blaetter"}),
    "Natuerlich hat die Blutulme auch Blaetter. Die sind aber ganz normal "
    "gruen, und nicht rot!");
  AddDetail( ({"wurzel", "wurzeln"}),
    "Die Wurzeln der Blutulme sind natuerlich im Boden, Du kannst sie nicht "
    "sehen.");
  AddDetail( ({"dschungel"}),
    "Du stehst mitten im dichten Dschungel.");
  AddDetail( ({"pfad", "weg"}),
    "Es ist kein Pfad oder Weg weit und breit zu sehen. Du musst Dich schon "
    "wild durch den Dschungel durchschlagen.");
  AddDetail( ({"richtungen", "osten"}),
    "Nur im Osten ist das Unterholz etwas lichter, in alle anderen Richtungen "
    "kann man unmoeglich vordringen.");
  AddDetail( ({"unterholz"}),
    "Das Unterholz ist so dicht, dass man sich nur in wenige Richtungen "
    "fortbewegen kann.");
  AddDetail( ({"machete", "fortbewegung"}),
    "Eine Machete ist hier fuer die Fortbewegung ganz nuetzlich.");
  AddDetail( ({"dach", "blaetterdach"}),
    "Das Blaetterdach ueber Dir laesst nur wenige Sonnenstrahlen bis zum "
    "Boden durchdringen.");
  AddDetail( ({"himmel", "sonne"}),
    "Sonne und Himmel sind durch das dichte Blaetterdach nicht zu sehen.");
  AddDetail( ({"strahlen", "sonnenstrahlen", "strahl", "sonnenstrahl"}),
    "Nur wenige Sonnenstrahlen koennen das dichte Blaetterdach durchdringen "
    "und bis zum Boden vorstossen.");
  AddDetail( ({"riesen", "dschungelriesen"}),
    "Mit Dschungelriesen sind natuerlich die riesenhaften Baeume gemeint. "
    "Vor Dir steht ein besonders riesiger Baum mit einer blutroten Rinde.");
  AddDetail( ({"baeume"}),
    "Die Baeume hier sind alle riesengross, das laesst viel Platz am Boden "
    "fuer das Unterholz. Viele Lianen haengen von den Baeumen herunter.");
  AddDetail( ({"boden"}),
    "Der Boden ist hier trocken und mit abgefallenem Laub bedeckt.");
  AddDetail( ({"laub"}),
    "Das Laub stammt wohl von den riesigen Baeumen.");
  AddDetail( ({"lianen"}),
    "Viele Lianen haengen von den Baeumen herunter.");

  AddSound( ({DEFAULT_SOUND, "geraeusche", "dschungelgeraeusche"}),
    "Du hoerst die ueblichen Dschungelgeraeusche: das Zirpen von Grillen, die "
    "Schreie von Affen, Vogelgezwitscher und machmal auch das Bruellen einer "
    "Raubkatze.");
  AddSound( ({"zirpen", "grillen", "grille"}),
    "Die Grillen zirpen.");
  AddSound( ({"schrei", "schreie", "affe", "affen"}),
    "Die Affen schreien laut.");
  AddSound( ({"vogel", "voegel", "zwitschern", "vogelgezwitscher"}),
    "Du hoerst das Zwitschern von vielen Voegeln.");
  AddSound( ({"bruellen", "raubkatze", "katze", "katzen", "raubkatzen"}),
    "Manchmal hoerst Du das Bruellen von Raubkatzen. Hoffentlich ist nicht "
    "gerade eine hungrige Katze hinter Dir her.");
  AddSmell( ({DEFAULT_SMELL, "dschungel"}),
    "Es riecht nach Dschungel.");

  AddCmd ( ({"kletter", "klettere"}), "klettern");
  AddCmd( ({"klopf", "klopfe"}), "klopfen");
                        
  AddExit("osten", "./lich-018" );

}

int klettern ( string str )
{
  notify_fail ("Wohin willst Du klettern?\n" );
  if(!str) return 0;
  if( member( ({"baum", "auf baum", "ulme", "auf ulme", "blutulme", 
                "auf blutulme", "baum rauf", "ulme rauf", "blutulme rauf",
                "auf baum rauf", "auf ulme rauf", "auf blutulme rauf"}),
      str)!= -1 )
  {
    write( "Du kletterst auf die Blutulme.\n" );
    TP->move ( ROOM "baum-0b0", M_GO, "auf einen Baum", "klettert", 
           "kommt von unten heraufgeklettert" );
    return 1;
  }
  return 0;
}

int klopfen(string str)
{ 
  notify_fail("Woran willst Du klopfen?\n");
  if( !str ) return 0; 
  if( str == "an baum" || str == "baum")
  { 
    write(BS("Du klopfst an den Baum, aber es ist kein TicToc Baum."));
    say(CAP_TPN + " klopft an einen Baum.\n");
    return 1;
  }
  return 0;
}

