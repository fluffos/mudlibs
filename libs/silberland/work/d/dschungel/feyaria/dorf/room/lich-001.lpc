// /d/dschungel/feyaria/dorf/room/lich-001.c
// 1997-08-14 Feyaria@SilberLand

inherit "std/room";

#include <mnpc.h>
#include "../def.h"

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad" );
  SetProp( P_INT_LONG,
    "Der Dschungelpfad endet hier auf einer kleinen Lichtung, die sich "
    "nach Westen erstreckt. Nach Sueden hin wird es immer sumpfiger. "
    "Dort ist vermutlich ein See, denn man kann schon den Schilfguertel "
    "erkennen. Obwohl die Sonne erbarmunglos vom Himmel brennt und Dich "
    "zum Schwitzen bringt, ist das kniehohe Gras hier sehr saftig. Das kommt "
    "wohl daher, dass der Boden sehr feucht ist.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:29, ENV_TERRAIN: TT_JUNGLE]));
  
  AddDetail( ({"pfad", "dschungelpfad", "suedwesten", "osten"}),
    "Der Pfad fuehrt nach Nordosten.");
  AddDetail( ({"himmel", "sonne"}),
    "Die Sonne brennt erbarmungslos vom Himmel herunter und bringt Dich zum "
    "Schwitzen, das kniehohe Gras kann sie aber nicht verdoerren, dazu ist "
    "es hier zu feucht.");
  AddDetail( ({"hitze"}),
    "Es ist wirklich sehr warm hier.");
  AddDetail( ({"schwitzen", "schweiss", "poren"}),
    "Der Schweiss rinnt Dir aus allen Poren. Hoffentlicht hast Du keine "
    "warmen Sachen an.");
  AddDetail( ({"boden"}),
    "Der Boden ist hier etwas sumpfig. Das saftige Gras steht kniehoch.");
  AddDetail( ({"gras", "schlange", "schlangen"}),
    "Hoffentlich sind da keine Schlangen im Gras verborgen!");
  AddDetail( ({"dschungel"}),
    "Der Dschungel ist hier sehr dicht und sumpfig. Es wachsen die "
    "verschiedensten Pflanzen hier.");
  AddDetail( ({"pflanzen", "pflanze", "baum", "baeume"}),
    "Die grossen Baeume erstrecken sich hoch in den Himmel und bilden ein "
    "dichtes Blaetterdach.");
  AddDetail( ({"blaetter", "dach", "blaetterdach"}),
    "Das Blaetterdach ueber Dir verdeckt den Himmel im Osten.");
  AddDetail( ({"lichtung"}),
    "Die Lichtung erstreckt sich nach Westen. Im Norden und Osten ist sie von "
    "dichtem Dschungel begrenzt, im Sueden vom Schilf.");
  AddDetail( ({"schilf"}),
    "Das Schilf ist im Sueden.");
  AddDetail( ({"see"}),
    "Den See kann man nur vermuten, er liegt wohl irgendwo im Sueden hinter "
    "dem Schilfguertel.");
  AddDetail( ({"guertel", "schilfguertel"}),
    "Der Schilfguertel heisst so, weil er wie ein Guertel um den See "
    "herum liegt.");

  AddSound( ({DEFAULT_SOUND, "geraeusche", "dschungelgeraeusche"}),
    "Du hoerst die ueblichen Dschungelgeraeusche: das Zirpen von Grillen, die "
    "Schreie von Affen, Vogelgezwitscher und machmal auch das Bruellen einer "
    "Raubkatze.");
  AddSound( ({"zirpen", "grillen", "grille"}),
    "Die Grillen zirpen.");
  AddSound( ({"schrei", "schreie", "affe", "affen"}),
    "Die Affen schreien laut.");
  AddSound( ({"vogel", "voegel", "zwitschern", "vogelgezwitscher"}),
    "Du hoerst das Zwitschern von vielen Voegeln.");
  AddSound( ({"bruellen", "raubkatze", "katze", "katzen", "raubkatzen"}),
    "Manchmal hoerst Du das Bruellen von Raubkatzen. Hoffentlich ist nicht "
    "gerade eine hungrige Katze hinter Dir her.");
  AddSmell( ({DEFAULT_SMELL, "dschungel"}),
    "Es riecht nach Dschungel.");

  AddCmd( ({"klopf", "klopfe"}), "klopfen");

  AddExit( "westen","./lich-002" );
  AddExit( "nordosten","./weg3" );

  AddItem( ({"/d/dschungel/feyaria/kueste/npc/papagei",
             "/d/dschungel/dante/weg/npc/dkakadu", 
             "/d/dschungel/dante/weg/npc/dkoli" }), REFRESH_DESTRUCT,
     ([P_MNPC_AREA: ROOM, P_MNPC_DEFAULTROOM: ROOM "lich-001"]) );
}

int klopfen(string str)
{ 
  notify_fail("Woran willst Du klopfen?\n");
  if( !str ) return 0; 
  if( str == "an baum" || str == "baum")
  { 
    write(BS("Du klopfst an den Baum, aber es ist kein TicToc Baum."));
    say(CAP_TPN + " klopft an einen Baum.\n");
    return 1;
  }
  return 0;
}


