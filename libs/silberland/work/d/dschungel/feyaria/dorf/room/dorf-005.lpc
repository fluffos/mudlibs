//  ***     Raum              
//  ***     Azrael@ SilberLand 
//  ***     dorf-005.c         
//  ***     ----- Steg vor dem Wachhaus

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Steg" );
  SetProp(P_INT_LONG,
    "Der Steg ist hier ein wenig breiter. Oestlich ist eine kleine Bruecke, "
    "ueber die Du ein schilfgedecktes Haus betreten kannst, dessen Eingang mit "
    "einem Strohvorhang verhaengt ist. Ueber dem Eingang haengen mehrere "
    "Waffen. Nach Sueden hin wird der Steg noch breiter und fuehrt wohl ins "
    "Zentrum des Pfahldorfes. Noerdlich verschmaelert sich der Steg wieder "
    "Richtung Ufer hin.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Endlich kannst Du wieder normal gehen, ohne aengstlich einen Fuss vor "
    "den anderen setzen zu muessen. "  );
  AddDetail( "ufer",
    "Du kommst nach Norden ueber den Steg zurueck zum Ufer." );
  AddDetail( ({"see"}),
    "Der See ist unter dem Steg versteckt.");  
  AddDetail( ({ "fuss", "fuesse" }),
    "Puhh, der Steg ist endlich breiter, Du kannst wieder halbwegs "
    "gemuetlich gehen. ");
  AddDetail( "bruecke",
    "Die kleine Bruecke sieht zwar wackelig aus, scheint aber oft benuetzt "
    "zu werden." );
  AddDetail( ({"vorhang", "strohvorhang" }), 
    "Der Vorhang verdeckt den Eingang zum Haus." );
  AddDetail( "stroh",
    "Der Vorhang, der vor dem Eingang haengt, ist aus Stroh." );
  AddDetail( ({ "dorf", "pfahldorf", "elfendorf", "zentrum" }),
    "Im Sueden liegt das Zentrum des Pfahldorfes, dessen Eingang hier von "
    "einem Wachhaus aus beobachtet werden kann." );
  AddDetail( "waffen",
    "Ueber dem Eingang des Hauses haengt ein Schild, und darunter gekreuzt "
    "ein Schwert und ein Pfeil." );
  AddDetail( "tuer",
    "Durch sie kommst Du ins Wachhaus, ueber ihr haengen Waffen." );
  AddDetail( "eingang",
    "Es ist tatsaechlich ein Wachhaus, denn ueber dem Eingang haengt ein "
    "Eisenschild und darunter siehst Du gekreuzt ein leichtes Schwert und "
    "einen Pfeil, in dessen hinteres Ende eine schwarze und eine weisse "
    "Feder eingeflochten sind." );
  AddDetail( ({"eingang", "hauseingang" }),
    "Ueber der Tuer des Hauses haengen ein Schild und ein Schwert, das mit "
    "einem Pfeil gekreuzt ist." );
  AddDetail( ({ "schild", "eisenschild", }),
    "Ein Rundschild, ein Meisterwerk der Schmiedekunst.");
  AddDetail( ({ "rundschild", "meisterwerk", "prunkstueck" }),
    "Dieser Schild muss von einem Meister der Schmiedekunst angefertigt "
    "worden sein. Sicher ein Zwergenschmied. Eine ungefaehr zwanzig "
    "Zentimeter lange Spitze ragt aus der Mitte dieses Prunkstueckes, das "
    "sichtbare Zeichen von Kampf traegt, es muss also frueher wirklich "
    "verwendet worden sein." );
  AddDetail( "zeichen",
    "Der Schild traegt sichtbare Zeichen von Kampf, er scheint oefter "
    "verwendet worden zu sein." );
  AddDetail( "zentimeter",
    "Ein Zentimeter, das sind zehn Millimeter." );
  AddDetail( "millimeter",
    "Zehn Millimeter sind ein Zentimeter." );
  AddDetail( ({ "meister", "zwerg", "zwerge", "schmiedekunst", "schilde" }),
    "Nur Zwerge beherrschen die Kunst, solche massiven Schilde zu schaffen. "
    "Ein Schauer der Bewunderung ueberkommt Dich. " );
  AddDetail( ({ "anblick", "bewunderung", "schauer" }),
    "Beim Anblick dieses Schildes ueberkommt Dich ein Schauer der "
    "Bewunderung." );
  AddDetail( "kunst",
    "Jedermann weiss doch, dass die Zwerge die Schmiedekunst "
    "perfektioniert haben." );
  AddDetail( ({ "spitze", "mitte", "traeger" }),
    "In der Mitte des Schildes ist eine eiserne Spitze aufgesetzt, die es "
    "dem Traeger ermoeglicht, waehrend des Kampfes gefaehrliche Stoesse "
    "auszufuehren." );
  AddDetail( "schwert",
    "Es muss in den Tiefen des Gebirges von Zwergenhand geschmiedet worden "
    "sein. Unzerbrechlich und glaenzend haengt es ueber dem Hauseingang." );
  AddDetail( "tiefen",
    "Zwerge arbeiten in den Tiefen des Gebirges." );
  AddDetail( ({ "gebirge", "zwergenhand", "felsen", "erde" }),
    "Zwerge ueben ihre meisterliche Kunst tief unter der Erde, im Dunkel "
    "des Felsens aus.");
  AddDetail( ({ "kampf", "stoesse", "stoss" }),
    "Schwert und Schild sollten den Besitzer dieser Waffen zu einem "
    "schrecklichen Gegner machen." );
  AddDetail( ({"besitzer", "gegner" }),
    "Diese Waffen machen den Besitzer zu enem uebermaechtigen Gegner." );
  AddDetail( ({ "wachhaus", "haus" }),
    "Dieses Haus gewaehrleistet die Verteidigung des Elfendorfes, hier kann "
    "niemand vorbei, den die Waechter nicht vorbeilassen wollen. Das Dach "
    "des Hauses ist mit Schilf gedeckt." );
  AddDetail( ({"dach", "schilf"}),
    "Das Dach des Hauses ist mit Schilf gedeckt." );
  AddDetail( ({"pfeil", "geschoss" }),
    "Ein Pfeil aus roetlichem Holz ist unter dem Schild mit dem Schwert "
    "gekreuzt. In den Schaft sind eine schwarze und eine weisse Feder "
    "eingearbeitet, um einen gerade Flug und ein sicheres Ziel zu "
    "gewaehrleisten.");
  AddDetail( "ziel",
    "Wenn die Federn am Ende des Pfeiles gut gearbeitet sind, trifft er sein "
    "Ziel fast von allein. " );
  AddDetail( ({ "holz", "schaft", "pfeilschaft" }),
    "Der Schaft des Pfeiles schimmert roetlich, wahrscheinlich ist er aus "
    "dem Holz einer Blutulme gemacht. Eine schwarze und eine weisse Feder "
    "sind am Ende eingearbeitet." );
  AddDetail( ({ "blutulme", "ulme", "gelaende" }),
    "Blutulmen wachsen gewoehnlich in feuchtem, sumpfigem Gelaende." );
  AddDetail( ({"feder", "stabilitaet", "flug" }),
    "Die beiden Federn am Ende des Pfeilschaftes geben dem Flug des "
    "Geschosses die hoechstmoegliche Stabilitaet." );
  AddDetail( ({"weisse feder", "weiss"}),
    "Die weisse Feder schaut wie eine Schwanenfeder aus.");
  AddDetail( ({"schwan", "schwanenfeder"}),
    "Eine Schwanenfeder wuerde sicher gut zu einem Pfeil passen.");
  AddDetail( ({"schwarze feder", "schwarz"}),
    "Die schwarze Feder schaut wie eine Rabenfeder aus.");
  AddDetail( ({"rabe", "rabenfeder"}),
    "Eine Rabenfeder wuerde sicher gut zu einem Pfeil passen.");
  AddDetail( "ende",
    "Am Ende des Pfeiles sind zwei Federn eingearbeitet." );
  AddDetail( "verteidigung",
    "Vom Haus aus koennen die Elfenwaechter problemlos jeden Fremden oder "
    "Eindringling beobachten und ueberpruefen.");
  AddDetail( ({ "waechter", "elfenwaechter" }),
    "Die Waechter sind sicher im Haus.");
  AddDetail( ({ "schmied", "zwergenschmied" }),
    "Also entweder kommt dieser Schild von ganz weit her, oder es gibt "
    "hier im Dorf einen Zwergenschmied. Ist aber sehr unwahrscheinlich." );
  AddDetail( ({ "fremde", "fremder", "eindringling", "eindringlinge" }),
    "Weil der Steg so schmal ist, ist es ein Leichtes, jeden Fremden, der "
    "ins Dorf will, hier zu kontrollieren." );
  AddDetail( "richtung",
    "Du kannst nach Norden, Sueden und Osten weitergehen." );

  AddSound( DEFAULT_SOUND,
    "Es ist ruhig, nur entfernt hoerst Du einige Froesche quaken." );

  AddSmell( DEFAULT_SMELL,
    "Frische Luft weht Dir entgegen und Du atmest tief, erleichtert, wieder "
    "frei atmen zu koennen." );
  AddSmell( "luft",
    "Die Luft ist hier bedeutend frischer als am Ufer." );

  AddExit("norden", "./dorf-004" );
  AddExit("sueden", "./dorf-006" );
  AddExit("osten",  "./wachhaus" );

}
