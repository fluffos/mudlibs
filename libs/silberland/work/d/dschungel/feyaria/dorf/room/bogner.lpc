//  ***     Raum - sollte einmal ein Laden werden (hoffentlich)
//  ***     Azrael@SilberLand
//  ***     dorf-4a1.c 
//  ***     ----- beim Bognermeister --- Tenobaal (Flinkepfeil)

inherit "std/laden";

#include <laden.h>
#include "../def.h"

void create()
{
  ::create();

  last=wantto=mymoney=30000;

  SetProp(P_INT_SHORT, "Beim Bognermeister" );
  SetProp(P_INT_LONG,
    "Du betrittst den Bognerladen. Auf Staendern sind Bogen in allen "
    "Groessen aufgereiht. Unbearbeitete und teilweise bearbeitete "
    "Holzstuecke liegen auf einem Tisch an der Wand, ueber dem auf Regalen "
    "Tiegel mit verschiedenen Fluessigkeiten stehen. Durch die westliche "
    "Wand fuehrt eine Tuer ins Freie und an der oestlichen Zimmerseite "
    "haengen Koecher mit Pfeilen. Eine Leiter fuehrt nach oben.");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_SPECIAL_SHOP, ([P_WEAPON_TYPE: 
      "Tenobaal sagt: Tut mir leid, ich handle nur mit Waffen!\n"]) );
  SetStorageRoom (ROOM "bogner_store");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+ SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "tenobaal");
  SetProp(P_SHOPKEEPER_NAME, "Tenobaal");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({"raum", "zimmer"}), QueryProp(P_INT_LONG) );
    
  AddDetail( "decke",
    "Schwere Holzplanken tragen die Decke und lassen vermuten, dass es noch "
    "einen weiteren Raum oberhalb des Ladens gibt." );
  AddDetail("zimmerseite",
    "An der oestlichen Seite haengen mehrere Koecher mit Pfeilen." );
  AddDetail( ({"planken", "planke", "holzplanke", "holzplanken"}),
    "Ueber Dir stuetzen schwere Holzplanken die Decke." );
  AddDetail( "leiter",
    "Sie fuehrt nach oben. Wahrscheinlich zu den privaten Raeumen des "
    "Bogners.");
  AddDetail( ({ "tuer", "tuere", "steg" }),
    "Nach Westen fuehrt eine Tuere hinaus auf den Steg, sie steht offen. "
    "Natuerlich fuehrt auch im Sueden eine Tuer hinaus, da bist Du ja "
    "hereingekommen." );   
  AddDetail( "holz",
    "Boden und Decke bestehen aus schweren, dicken Baumstaemmen." );
  AddDetail( "dorf",
    "Es war zu erwarten, dass man hier auch einen Bognerladen finden kann." );
  AddDetail( ({ "staemme", "baumstaemme", "stamm", "baumstamm", "holzstamm",
        "holzstaemme"}),
    "Dicke Baumstaemme wurden in den Grund des Sees geschlagen und bilden das "
    "Fundament des Dorfes." );
  AddDetail( ({"grund", "fundament"}),
    "Der morastige Grund des Sees wurde mit hineingerammten Baumstaemmen "
    "bebaubar gemacht. " );
  AddDetail( "see",
    "Es ist ein eigenartiges Gefuehl zu wissen, dass unter den Holzplanken "
    "der See sein soll." );
  AddDetail( "laden",
    "Das ist also der Bognerladen." );
  AddDetail( "bognerladen",
    "Du stehst mitten drin." );
  AddDetail( "freie",
    "Nach Westen kannst Du ins Freie gelangen." );
  AddDetail( "staender",
    "Auf ihnen sind Bogen in jeder Groesse und Ausfuehrung aufgestellt. " );
  AddDetail( ({"bogen", "boegen", "fernwaffe", "fernwaffen" }),
    "Meisterwerke der Bognerkunst, es scheint Dir als koenntest Du mit ihnen "
    "jedes Ziel treffen. " );
  AddDetail( "ziel",
    "Es scheint als koennte man mit diesen Waffen jedes bewegte und erst "
    "recht jedes unbewegte Ziel treffen, so perfekt gearbeitet sehen diese "
    "Bogen aus." );
  AddDetail( ({"waffen", "jagdwaffe"}),
    "Als Jagdwaffe, aber auch im Kampf, ist ein Bogen in den Haenden eines "
    "Meisters ein toedliches Hilfsmittel." ); 
  AddDetail( "kampf",
    "Ein Bogen kann einem auch im Kampf gute Dienste erweisen." );
  AddDetail( "haende",
    "Zwei davon braeuchtest Du schon, wenn Du mit einem Bogen umgehen "
    "willst." );
  AddDetail( ({"meisterwerke", "bognerkunst", "kunst"}),
    "Wunderschoene Fernwaffen, wirklich. Schoene Schnitzereien zieren "
    "die Bogen oberhalb und unterhalb der Griffe." );
  AddDetail( ({"griff", "griffe", "schnitzereien"}),
    "Schoene Schnitzereien zieren die Bogen oberhalb und unterhalb der "
    "Griffe."); 
  AddDetail( "groessen",
    "Jeder kann hier einen Bogen finden, der genau zu seinen Voraussetzungen "
    "passt. " );
  AddDetail( ({"pfeil", "pfeile"}),
    "Ohne Pfeile nuetzt Dir der beste Bogen nichts!");
  AddDetail( ({"koecher"}),
    "In einem Koecher kann man Pfeile gut aufbewahren.");
  AddDetail( "tisch",
    "Er steht an der hinteren Wand des Zimmers. Auf ihm liegen verschiedene "
    "Holzsorten, die auch schon zum Teil bearbeitet sind." );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind aus Holz gemacht. Im Sueden und Westen fuehren Tueren "
    "nach draussen, waehrend an der Ostwand ein Tisch steht, ueber dem ein "
    "Regal angebracht ist." );
  AddDetail("ostwand",
    "Dort steht ein Tisch, ueber dem ein Regal haengt." );
  AddDetail( "boden",
    "Er ist - wie alles hier im Dorf - aus Holzstaemmen." );
  AddDetail( ({"regale", "regal"}),
    "Ueber dem Tisch sind Regale angebracht, auf denen verschiedene "
    "Gefaesse stehen." );
  AddDetail( "gefaesse",
    "Verschiedenste Tinkturen, Leim und Beizmittel sind in diesen Tiegeln." );
  AddDetail( "tinkturen",
    "Du hast keine Ahnung welchen Zweck die Tinkturen haben.");
  AddDetail( "tiegel",
    "Auf dem Regal stehen verschiedenste Gefaesse mit Leim und Beizmitteln." );
  AddDetail( "beizmittel",
    "Um das Holz der Bogen widerstandsfaehig gegen Witterung und Alter zu "
    "machen werden sie mehrmals mit besonderen Tinkturen gebeizt." );
  AddDetail( "fluessigkeiten",
    "Die Gefaesse auf dem Regal enthalten drei verschiedensten "
    "Fluessigkeiten: Tinkturen, Beizmittel und Leim." );
  AddDetail( ({ "widerstandsfaehigkeit", "alter", "witterung" }),
    "Die Beizmittel verleihen den Bogen besondere Widerstandsfaehigkeit." );
  AddDetail( ({"leim", "holzschichten"}),
    "Mit dem Leim werden die verschiedenen Holzschichten verbunden um die "
    "notwendige Spannung zu gewaerleisten." );
  AddDetail( ({"spannung", "spannfaehigkeit"}),
    "Wichtig bei einem Bogen ist die Spannfaehigkeit, deshalb sollte ein "
    "wirklich guter Bogen aus mindestens zwei verschiedenen Holzarten "
    "gemacht werden." );
  AddDetail( ({"holzstuecke", "stuecke"}),
    "Aus den Holzstuecken werden vielleicht einmal Boegen.");
  AddDetail( ({"holzarten", "holzsorten"}),
    "Alle moeglichen Holzarten werden fuer Boegen verwendet. Welche das genau "
    "sind, ist ein Geheimnis der Bogenbauer.");
  AddDetail( ({"geheimnis"}),
    "Du glaubst doch nicht, so leicht ein Geheimnis aufdecken zu koennen?");
  AddDetail( ({"bogner", "bogenbauer", "meister"}),
    "Hier bietet der Bogenbauer Tenobaal seine meisterlichen Boegen an.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst hier nichts besonderes.");
        
  AddSmell( ({DEFAULT_SMELL, "geruch", "luft"}),
    "Der Geruch von Leim, Harz und frischem Holz liegt in der Luft." );
  AddSmell( ({"leim", "harz", "holz"}),
    "Es riecht nach Leim, Harz und Holz.");

  AddItem( NPC"tenobaal", REFRESH_DESTRUCT );

  AddExit( "sueden", "./dorf-013" );
  AddExit( "westen", "./dorf-017" ); 

}
