//  ***     Raum             
//  ***     Azrael@SilberLand 
//  ***     dorf-001.c        
//  ***     ----- Eingang zum Pfahldorf

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eingang des Pfahldorfes" );
  SetProp(P_INT_LONG,
    "Du hast Dich nicht getaeuscht, von aussen kaum sichtbar findest Du hier "
    "den Eingang eines Pfahldorfes, das - unschwer zu erkennen - von Elfen "
    "in das sumpfige Ufer eines Sees gebaut wurde. Suedlich von Dir siehst Du "
    "die ersten Haeuser, die auf in den Boden gestemmten Holzpfaehlen stehen "
    "und durch wackelige Bruecken verbunden sind. Nach Norden hin kannst Du "
    "Dich durch die Schilfwand wieder zurueck auf den Pfad zwaengen. Westlich "
    "kann man am morastigen Ufer weitergehen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( "eingang",
    "Hier am morastigen Ufer des Sees beginnt eine kleine Siedlung, deren " 
    "Wohnhaeuser auf Pfaehlen stehen und durch Bruecken verbunden sind." );
  AddDetail( ({ "pfahldorf", "dorf", "siedlung" }),
    "Ueber einen schmalen Steg kannst Du das Pfahldorf betreten." );
  AddDetail( ({ "elfen", "kunst", "bauten" }),
    "Nur Elfen beherrschen die Kunst so stabile Bauten aus einem solch "
    "truegerischen Boden zu bauen."  );
  AddDetail( ({ "ufer", "see" }),
    "Der sumpfige Boden, auf dem Du stehst laesst Dich vermuten, dass weiter "
    "draussen, hinter dem Dorf ein See liegen muss." );  
  AddDetail( ({ "boden", "untergrund", "erdreich" }),
    "Hier, wo Du stehst, ist der Boden noch ziemlich sicher, Deine Schuhe "
    "versinken nur einige Zentimeter im morastigen Untergrund. Gleich vor "
    "Dir siehst Du einen kleinen Steg, ueber den Du das Pfahldorf betreten "
    "kannst." );
  AddDetail( ({ "schuhe", "halt" }),
    "Deine Schuhe finden hier noch sicheren Halt. Es ist zwar glitschig, aber "
    "Du sinkst nur ein wenig ein, waehrend der Boden weiter oestlich von Dir "
    "weit aus weicher und gefaehrlicher aussieht." );
  AddDetail( ({ "holzpfaehle", "pfaehle", "pfahl", "staemme", "baumstaemme" }),
    "Dicke Baumstaemme wurden hier ins Erdreich gerammt, um als Fundament "
    "fuer diese Siedlung zu dienen." );
  AddDetail( "fundament",
    "Alles hier ist auf Baumstaemmen gebaut." );    
  AddDetail( ({ "steg", "fuesse" }),
    "Gleich vor Deinen Fuessen sind Baumstaemme in den Boden gestemmt worden. "
    "Sie erlauben Dir auf ihnen ins Dorf zu gehen." );
  AddDetail( ({ "schilfwand", "schilf", "wand" }),
    "Wenn Du Dich durchzwaengst, kommst Du wieder zum Pfad." );
  AddDetail( ({ "bruecke", "bruecken" }),
    "Die Bruecken zwischen den Haeusern sehen alles andere als "
    "vertrauenerweckend aus." );
  AddDetail( "pfad",
    "Er liegt hinter der Schilfwand." );
  AddDetail( ({  "haus", "haeuser", "wohnhaeuser" }),
    "Die Haeuser sind fest auf dicken Holzpfaehlen gebaut, sie haben "
    "eigenartige Formen." );
  AddDetail( "formen",
    "Die Haeuser in diesem Dorf sehen aus, als waeren sie, wie Koerbe "
    "geflochten, sie sind kugel- und kegelfoermig." );
  AddDetail( "koerbe",
    "Die Haeuser sind geflochten wie Koerbe, sieht lustig aus." );
  AddDetail( ({ "zentimeter", "millimeter" }),
    "Ein Zentimeter ist genau zehn Millimeter lang." );


  AddSound( DEFAULT_SOUND,
    "Das Schilf knistert im leichten Wind und irgendwo quaken einige "
    "Froesche.  Von Westen her hoerst Du ein gurgelndes Geraeusch." );
  AddSound( ({ "westen", "geraeusch" }),
    "Ein eigenartiges, gurgelndes Geraeusch kommt von Westen her.");
  AddSound( ({ "wind", "schilf" }),
    "Ein kaum spuerbarer Wind bewegt das Schilf, er ist aber zu schwach, um "
    "frische Luft zu bringen." );

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach abgestandenem Wasser und faulenden Algen. Die Luft ist "
    "stickig." );

  AddCmd(({"zwaenge", "zwaeng"}), "durch_schilf");

  AddExit( "westen", "./dorf-002");
  AddExit( "sueden", "./dorf-004");
  AddExit( "norden", "./lich-002" );
}

int durch_schilf ( string str )
{
   notify_fail ("Wodurch willst Du Dich zwaengen?\n" );
   if (!str) return 0;
   if ( str != "durch schilf" && str != "durch schilfwand" ) 
     return 0;
   {
    write ( "Du zwaengst Dich zurueck durchs Schilf.\n" );
    TP->move ( ROOM "lich-002", M_GO, "sich durch das Schilf", "zwaengt");
    return 1;
   }
   return 0;
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
