//  ***     Raum
//  ***     Azrael@SilberLand
//  ***     dorf-3a1.c 
//  ***     ----- Wirtshaus "Zum spitzohrigen Bogenschuetzen"

inherit "std/pub";

#include <pub.h>
#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Zum spitzohrigen Bogenschuetzen" );
  SetProp(P_INT_LONG,
   "Der typische Wirtshausgeruch schlaegt Dir in die Nase. Hier drinnen "
   "stehen zwar ein paar Tische und Stuehle, aber keine Gaeste sind hier, "
   "naja, wenn draussen so schoenes Wetter ist, warum sollte jemand hier "
   "sitzen. Rechts vom Eingang ist eine Theke, hinter der ein grinsender "
   "Elf seine Glaeser saeubert. Im Vergleich zu draussen ist es dunkel und "
   "stickig. An der Theke haengt eine Tafel, auf der die Menueliste steht.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "firidion");
  SetProp(P_PUBKEEPER_GENDER, MALE);
  SetProp(P_PUBKEEPER_NAME, "der Wirt Firidion");
  SetProp(P_PUBMSG_NOKEEPER, 
      "Firidion goennt sich eine Pause. Das Wirtshaus ist geschlossen!\n"); 
  SetProp(P_PUBMSG_NOENEMY, "Firidion verkauft nichts an seine Feinde!\n"); 
  SetProp(P_PUBMSG_NOINVITE, "Firidion verkauft nichts an seine Feinde!\n"); 
  SetProp(P_PUBMSG_FIGHTING, "Zuerst muss Firidion seine Feinde besiegen!\n"); 
  
  AddDrink("Quellwasser", ({"quellwasser", "wasser"}),
    16, 5, 0, 2,
    ({"Das Quellwasser erfrischt Dich wieder richtig.",
      "&& erfrischt sich mit einem Schluck Quellwasser."}));

  AddDrink("Fruechtetraum", ({"fruechtetraum", "traum"}),
    286, 45, 0, 14, "fruechtetraum_trinken");

  AddDrink("Elfenwein", ({"elfenwein", "wein"}),
    300, 50, 11, 7,
    ({"Du trinkst ein Glas Elfenwein mit hoechstem Genuss.",
      "&& trinkt ein Glas Elfenwein mit hoechstem Genuss."}));

  AddFood ( "gebratene Forelle", ({"forelle", "gebratene Forelle"}),
    100, 20, 10,
    ({"Du verspeist hungrig die gebraten Forelle. Zum Glueck waren keine "
      "Graeten in\ndieser Forelle!",
    "&& isst eine gebratene Forelle."}));

  AddFood ( "Gemueserolle a la Pfeil und Bogen", ({"rolle", "gemuese", 
      "gemueserolle", "gemueserolle a la pfeil und bogen"}),
    711, 92, 33,
    ({"Du isst genuesslich Deine Gemueserolle und bewunderst den Geschmack "
      "der\nexotischen Gemuesesorten, die im Dschungel wachsen.",
    "&& isst genuesslich eine Gemueserolle."}));

// - Wirt proggen
// - Essen usw. proggen
// - Obergeschoss des Wirtshauses: Betten, etc. --- dorf-3a2.c

  AddDetail( ({"bogenschuetzen", "bogenschuetze"}),
    "Das Wirtshaus heisst so, weil hier fast nur Bogenschuetzen verkehren.");
  AddDetail( ({"wirtshaus", "haus", "raum", "kneipe", "taverne"}),
    "Du stehst mitten im Wirtshaus.");
  AddDetail( ({"boden"}),
    "Der Boden besteht aus Holzplanken und ist fuer ein Wirtshaus "
    "vergleichweise sehr sauber.");
  AddDetail( ({"planken", "holzplanken"}),
    "Die Holzplanken bedecken den Boden.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind aus Holz gefertigt.");
  AddDetail( ({"holz"}),
    "Boden und Waende bestehen aus Holz.");
  AddDetail( ({"decke", "schilf"}),
    "Die Decke besteht aus Schilf.");
  AddDetail( ({"tisch", "tische", "stuhl", "stuehle"}),
    "Einige leere Tische und Stuehle stehen herum.");
  AddDetail( ({"gaeste", "gast"}),
    "Viele Gaeste sind ja nicht da.");
  AddDetail( ({"wetter"}),
    "Draussen ist es viel schoener, nicht so stickig.");
  AddDetail( ({"elf", "wirt", "glas", "glaeser"}),
    "Der Wirt steht hinter der Theke und saeubert gerade seine Glaeser.");
  AddDetail( ({"theke"}),
    "Die Theke ist rechts vom Eingang und erstreckt sich bis zur hinteren "
    "Wand. An der Theke haengt eine Tafel, auf der die Menueliste steht. "
    "Hinter der Theke steht der Wirt und wartet auf Deine Bestellung.");
  AddDetail( ({"bestellung"}),
    "Auf was wartest Du?");
  AddDetail( ({"eingang", "norden"}),
    "Der Eingang ist im Norden.");
  AddDetail( ({"tafel", "menueliste", "menue", "liste"}),
    "Auf der Tafel steht, was Du hier konsumieren kannst.");
  AddReadDetail( ({"tafel", "menueliste", "menue", "lsite"}),
    "@@menue_liste@@");
  AddDetail( ({"wein", "elfenwein", "wasser", "quellwasser"}),
    "Kauf Dir doch ein Glas!");
  AddDetail( ({"forelle", "rolle", "gemueserolle"}),
    "Iss doch eine!"); 
  AddDetail( ({"vergleich"}),
    "Was man nicht so alles vergleichen kann....");

  AddSound( DEFAULT_SOUND,
    "Du lauschst und hoerst nichts Besonderes.");
        
  AddSmell( ({DEFAULT_SMELL, "geruch", "wirtshaus", "wirtshausgeruch"}),
    "Der typische Wirtshausgeruch schlaegt Dir in die Nase.");

  AddItem( NPC "wirt", REFRESH_DESTRUCT );

  AddExit( "norden", "./dorf-011" );
}

public void fruechtetraum_trinken() {
  object task;

  write(BS("Du bestellst einen Fruechtetraum und bekommst einen Riesenbecher "
           "mit frischausgepresstem Saft von den verschiedensten "
           "Dschungelfruechten. Du versinkst in einen himmlischen Traum von "
           "Ananas, Bananen, Mandastromos, Kokosnuessen und Passionsfruechten."));
  say(BS(TPN+"  trinkt einen Riesenbecher Fruechtetraum und beginnt zu traeumen."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(8);
  }
}


string menue_liste()
{
  menue();
  return "";
}


