//  ***     Raum                         
//  ***     Azrael@SilberLand 
//  ***     dorf-008.c                 
//  ***     ----- Dorfplatz vor der Schmiede


inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz" );
  SetProp(P_INT_LONG,
    "Hier ist das Ostende des Dorfplatzes. Nach Nordosten fuehrt der Steg "
    "ein wenig hinaus aufs Wasser, wohl fuer Fischer. Im Osten hin fuehrt "
    "ein kleine, schmale Bruecke zu einem Haus, aus dessen Schornstein "
    "schwarzer Rauch steigt. Ueber der Tuer des Hauses ist ein Holzschild "
    "angebracht. " );
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"ostende", "ende", "osten", "endes"}),
     "Meinst Du das Ende des Osten oder den Osten des Endes?" );
  AddDetail( ({"osten endes", "ende osten", "kombination"}),
     "Falsch! Probier einmal die andere Kombination!");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
    "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
    "ueber einem See stehst."  );
  AddDetail( "see",
    "Er schliesst von ueberall her an den Steg an. " );
  AddDetail( ({ "staemme", "holzstaemme" }),
    "Das ganze Dorf ist auf Holzstaemme gebaut. " );
  AddDetail( ({"platz", "dorfplatz", "ende" }),
    "Hier ist das oestliche Ende des Dorfplatzes, nur nach Nordosten fuehrt "
    "der Steg noch ein wenig weiter, wohl zu einem Fischersteg. " );
  AddDetail( "wasser",
    "Im Nordosten fuert der Steg weiter hinaus aufs Wasser." );
  AddDetail( ({"fischersteg", "fischer" }),
    "Der Steg fuehrt weiter nach Nordosten - wohl fuer Fischer. " );
  AddDetail( "tuer",
    "Die Tuere zum Haus steht offen, es sieht sehr dunkel im Inneren aus. "
    "Darueber haengt ein Holzschild. " );
  AddDetail( "inneres",
    "Ein duesterer, fensterloser Raum liegt hinter der schweren Tuere des "
    "Hauses. " );
  AddDetail( "raum",
    "Alles scheint schwarz darin zu sein, nur etwas silbrig Glaenzendes "
    "steht in der Mitte. " );
  AddDetail( "glaenzendes",
    "Von hier kannst Du nicht erkennen was es ist, Du musst schon hinein "
    "gehen. " ); 
  AddDetail( "mitte",
    "Da glaenzt etwas silbern mitten im Haus. " );
  AddDetail( ({ "schornstein", "kamin" }),
    "Ein steinerner Kamin, dicker, schwarzer Rauch steigt aus ihm zum "
    "Himmel. " );
  AddDetail( "rauch",
    "Schwarzer Rauch, wahrscheinlich von einer Esse. " );
  AddDetail( "esse", 
    "Im Haus ist wohl eine Esse, an der ein Schmied arbeitet. " );
  AddDetail( "haus",
    "Es handelt sich ganz offensichtlich um ein Schmiede, denn ueber der "
    "Tuere siehst Du das Symbol eines Hammers und einer Hacke, deren Stiele "
    "sich kreuzen. Ausserdem steigt schwarzer Rauch aus dem Kamin in den "
    "Himmel. " );
  AddDetail( "bruecke",
    "Sie verbindet das Haus mit dem Steg. " );
  AddDetail( "schmiede",
    "Ja, das hier ist eindeutig eine Schmiede. Aber in einem Elfendorf, das "
    "hast Du noch nie gehoert. " );
  AddDetail( "himmel",
    "Der Himmel waere eigentlich strahlend blau, wuerden nicht aus dem "
    "Schornstein der Schmiede schwarze Rauchschwaden heraussteigen. " );
  AddDetail( ({ "rauchschwaden", "schwaden", "rauch" }),
    ([0: "Typisch zwergische Luftverschmutzung. ",
      "zwerg": "Herrlicher Rauch, wie er nur aus einer Schmiede kommen kann."
      ]) );
  AddDetail( ({ "verschmutzung", "luftverschmutzung" }),
    "Fuerchterlich! - Dieser Rauch, der da aus dem Schornstein kommt. " );
  AddDetail( "tuere",
    "Ueber der Tuere haengt ein Holzschild, in das die Symbole eines "
    "Hammers, der sich mit einer Hacke kreuzt, eingebrannt sind. " );
  AddDetail( ({ "holzschild", "schild" }),
    "In diesem Schild sind die klassischen Bergbausymbole eingebrannt: "
    "Hammer und Hacke. " );
  AddDetail( ({ "symbol", "symbole", "bergbausymbole" }),
    "Ein Hammer und eine Hacke, die sich ueberkreuzen. " );
  AddDetail( "hammer",
    "Der Hammer ist das wichtigste Werkzeug eines Schmiedes, aber auch ein " 
    "fast magisches Symbol der Schmiedekunst. " );
  AddDetail( "hacke",
    "Die Hacke ist neben dem Hammer unabdingbar fuer den Bergbau und die "
    "Schmiedekunst. " );
  AddDetail( ({ "bergbau", "zwerge" }),
    "Nur Zwerge beherrschen den Bergbau meisterlich. " );
  AddDetail( ({ "stiele", "schmiedekunst", "kunst" }),
    "Die Stiele der beiden Werkzeuge ueberkreuzen sich und bilden so das "
    "typische Symbol fuer die Schmiedekunst. Und das in einem Elfendorf ? "
    "- Eigenartig. " );
  AddDetail( ({ "elfendorf", "dorf" }),
    "Ja, das ist ein Elfendorf, aber was macht eine Schmiede hier? " );
  AddDetail( ({ "werkzeuge", "werkzeug" }),
    "Hammer und Hacke sind die wichtigsten Werkzeuge eines Schmiedes. " );
  AddDetail( "elfen",
    "Eine Schmiede und Elfen, das laesst sich eigentlich nur schwer "
    "vereinbaren. Was das wohl zu bedeuten hat...?" );

  AddSound( DEFAULT_SOUND,
    "Aus dem Haus im Osten hoerst Du das hin und wieder das Schlagen eines "
    "Hammers und das Zischen von dampfendem Wasser. " );
  AddSound( ({"schlagen", "hammer" }),
    "In unregelmaessigen Abstaenden hoerst Du einen Hammer auf Metall "
    "schlagen. " );
  AddSound( "zischen",
    "Es klingt, wie wenn heisses Metall in Wasser abgekuehlt wuerde. " );

  AddSmell( ({DEFAULT_SMELL, "geruch", "russ", "rauch"}),
    "Der stechende Geruch von Russ und Rauch steigt Dir durch die "
    "Nasenfluegel. " );

  AddExit( "sueden",     "./dorf-009" );
  AddExit( "westen",     "./dorf-007" );
  AddExit( "suedwesten", "./dorf-010" );
  AddExit( "osten",      "./schmiede" );
  AddExit( "nordosten",  "./dorf-015" );

}
