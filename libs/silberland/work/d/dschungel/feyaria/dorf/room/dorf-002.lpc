//  ***     Raum      
//  ***     Azrael@SilberLand 
//  ***     dorf-002.c                 
//  ***     ----- Ufer - inkl. fleischfressende Pflanze(n)

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ufer eines Sees" );
  SetProp(P_INT_LONG,
    "Du stapfst durch den Morast, der hier schon deutlich tiefer wird. Das "
    "Schilf zu Deiner Rechten ist hier undurchdringlich dicht. Links wird "
    "der Morast noch tiefer und im seichten Wasser stehen einige Pflanzen. "
    "Froesche quaken und Mueckenschwaerme machen Dir das Leben schwer. Die "
    "Luft ist stickig und der typisch faulige Geruch sticht in der Nase.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));

  AddDetail( ({"ufer", "see"}),
    "Du stehst am Ufer eines Sees im tiefen Morast.");
  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "morast", "sumpf", "boden" }),
    "Der Sumpf beginnt hier erst richtig. Du stehst bereits knoecheltief in "
    "gruenem, schleimigem Schlamm und das Gehen kostet einige Anstrengung." );
  AddDetail( "anstrengung",
    "Es ist sehr anstrengend hier zu gehen, weil der Schlamm an den Fuessen "
    "haengen bleibt. " );
  AddDetail( "nase",
    "Man kann damit riechen und sie schneuzen." );
  AddDetail( "luft",
    "Man kann kaum atmen, so stickig ist es hier." );
  AddDetail( "schlamm",            
    "Klebrig und schwer haftet der Schlamm an Deinen Fuessen und es blubbert "
    "bei jedem Schritt verdaechtig." );
  AddDetail( "fuesse",
    "Sie versinken bei jedem Schritt im Morast." );
  AddDetail( "schritt",
    "Jeder Schritt faellt hier schwer, weil Du immer wieder versinkst." );
  AddDetail( ({ "schilf", "schilfhalme", "halme", "vegetation" }),
    "Die Vegetation ist hier sehr dicht, die Schilfhalme bilden eine " 
    "undurchdringliche Wand." );
  AddDetail( ({"wand", "schilfwand"}),
    "Wie eine Wand steht das Schilf noerdlich von Dir." );
  AddDetail( ({"wasser", "schlieren" }),
    "Oelige Schlieren und Algen treiben hier auf dem Wasser. Es riecht "
    "abgestanden und faulig. Alles scheint hier vor sich hin zu modern."  );
  AddDetail( "algen",
    "Glitschige gruenbraune Algen, die sich hier im sauerstoffarmen Wasser "
    "wohl fuehlen." );
  AddDetail( ({"sumpfpflanzen", "pflanzen", "zierpflanzen" }),
    "Die Sumpfpflanzen tragen fettige Blueten und schimmern in allen Farben. "
    "Hier stehen aber auch Pflanzen, die gefaehrlicher aussehen. Venusfallen "
    "mit Schlick triefenden Maeulern, die leicht einen halben Meter hoch "
    "sind." );
  AddDetail( "maeuler",
    "Sie sehen nicht gerade freundlich aus. Eher hungrig..." );
  AddDetail( ({"schlick", "speichel" }),
    "Wie Speichel tropft gruener Schlick aus den Kiefern dieser "
    "fleischfressenden Pflanzen, die drohend im seichten Wasser stehen." );
  AddDetail( ({ "kiefer", "zaehne" }),
    "Die schlicktriefenden Kiefer dieser Venusfallen starren vor scharfen "
    "Zaehnen." );
  AddDetail( ({"venusfalle", "venusfallen" }),
    "Du kennst diese Pflanzen eigentlich nur als kleine insektenvertilgende " 
    "Zierpflanzen, aber diese Exemplare scheinen wirklich gefaehrlich zu "
    "sein." );
  AddDetail( "exemplare",
    "Diese Pflanzen sind wirklich ausserordentlich gross und sehen "
    "gefaehrlich aus." );
  AddDetail( ({"meter", "zentimeter" }),
    "Ein Meter misst genau hundert Zentimeter, wusstest Du das nicht?" );
  AddDetail(({ "blueten", "farben" }),
    "Die Pflanzen tragen Blueten, die saftig aber auch giftig aussehen und in "
    "allen Farben schillern." );
  AddDetail( ({ "muecken", "schwaerme", "mueckenschwaerme", "insekten" }),
    "Diese nervenden Insekten schwirren Dir um die Ohren. Du hast sicher "
    "schon Dutzende von ihnen verschluckt. Na ja, zusaetzliches Eiweiss "
    "schadet nie.");
  AddDetail( "ohren",
    "Zaehl mal nach, wenn Du mehr als zwei Ohren hast, solltest Du Dich "
    "einmal untersuchen lassen." );
  AddDetail( "dutzende",
    "Dir scheint es, als ob tausende Muecken um Dich herumschwirren." );
  AddDetail( "ballaststoffe",
    "Sind gut fuer die Verdauung." );
  AddDetail( "verdauung",
    "Eine gute Verdauung ist sehr wichtig." );
  AddDetail( ({"froesche", "frosch"}),
    "Sehen kannst Du keinen Frosch, Du kannst nur ihr Quaken hoeren.");
  
  AddSound( DEFAULT_SOUND, 
    "Du hoerst Froesche quaken und Schwaerme von Muecken surren um Deine "
    "Ohren." );
  AddSound( "froesche",
    "Das Quaken der vielen Froesche im Sumpf hat etwas beruhigendes." );
  AddSound( ({ "muecken", "schwaerme", "mueckenschwaerme" }),
    "Ein unertraegliches Surren umgibt Dich." );

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist stickig und bei jedem Atemzug schluckst Du ein paar "
    "Muecken.");
  AddSmell( "geruch",
    "Der typisch faulige Geruch des Sumpfes steigt Dir in die Nase." );

  AddItem (NPC"fpflanze", REFRESH_DESTRUCT);
  AddItem ( ({NPC"fpflanze", MOSKITO, MUECKE}), REFRESH_DESTRUCT);

  AddExit( "osten", "./dorf-001");

}

