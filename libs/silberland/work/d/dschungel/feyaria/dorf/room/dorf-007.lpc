// /  ***     Raum                         
//  ***     Azrael@SilberLand
//  ***     dorf-007.c                 
//  ***     ----- Entwurf fuer Dorfplatz

inherit "std/room";

#include <properties.h>
#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Dorfplatz des Pfahldorfes" );
  SetProp(P_INT_LONG,
    "Vor Dir oeffnet sich ein breiter Platz. Du stehst immer noch auf dem "
    "gleichen Steg, ueber den Du dieses Dorf betreten hast, allerdings ist "
    "er hier so breit, das Du fast vergessen koenntest, dass unter Dir das "
    "Wasser eines Sees plaetschert. Ueberall sind Haeuser direkt an den "
    "Steg angebaut. Im Norden fuehrt der Weg zurueck am Wachhaus vorbei zum "
    "Ufer. Westlich ist ein kleiner Verkaufsstand aufgebaut. Ein "
    "Springbrunnen liegt im Sueden und einige Stuehle stehen suedwestlich "
    "von Dir vor einem Haus. ");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
    "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
    "ueber einem See stehst, und nicht auf dem Steinboden einer Stadt auf "
    "dem Festland. "  );
  AddDetail( "steinboden",
    "Sowas findest Du hier sicher nicht, alles ist aus Holz und Schilf "
    "gemacht. " );
  AddDetail( "festland",
    "Staedte auf dem Festland sehen anders aus, als das Dorf hier. " );
  AddDetail( ({"weg", "ufer" }),
    "Nach Norden fuehr der Weg zurueck am Wachhaus vorbei zum Ufer. " );
  AddDetail( "wachhaus",
    "Es liegt in noerdlicher Richtung. " );
  AddDetail( "richtung",
    "Moegliche Richtungen in die Du gehen kannst:\n" 
    "Norden, Sueden, Westen, Osten, Suedwesten und Suedosten.\n " );
  AddDetail( ({ "dorfplatz", "platz" }),
    "Du stehst am Steg, der so breit ist, dass man ihn ohne weiteres als "
    "Platz bezeichnen kann. Von ihm aus kann man mehrere Haeuser betreten, "
    "die direkt an den Steg angebaut sind. " );
  AddDetail( ({ "holz", "holzstaemme", "baumstaemme", "staemme", 
                "holzplanken", "planken"}),
    "Dicke Baumstaemme wurden fest in den Grund des Sees gerammt, und auf "
    "ihnen steht das ganze Dorf sicher und stabil. " );
  AddDetail( ({ "grund", "fundament" }),
    "Die Staemme muessen sehr tief im schlammigen Grund des Sees stecken, "
    "um ein sicheres Fundament fuer die kleine Stadt zu bilden. " );
  AddDetail( "see",
    "Du hoerst den See unter Dir gegen die Holzstaemme schlagen." );
  AddDetail( ({ "verkaufsstand", "stand" }),
    "Ihn erreichst Du, wenn Du nach Westen gehst." );
  AddDetail( ({ "springbrunnen", "brunnen" }),
    "Im Sueden plaetschert ein kleiner steinerner Brunnen." );
  AddDetail( "stuehle",
    "Einige Stuehle stehen suedwestlich vor einem Haus." );
  AddDetail( "haus",
    "Im Suedwesten siehst Du ein Haus, vor dem mehrere Stuehle stehen." );
  AddDetail( ({ "dorf", "stadt", "staedte" }),
    "Jetzt, da Du die Ausmasse des Dorfes erst richtig erkennst, bist Du "
    "versucht es mehr als Stadt zu bezeichen, zumindest als kleine Stadt." );
  AddDetail( ({ "ausmasse", "pfahldorf" }),
    "Dieses Pfahldorf ist wesentlich groesser, als Du urspruenglich "
    "angenommen hast." );
  AddDetail( "haeuser",
    "Von mehreren Seiten schliessen Haeuser an den Steg an, die alle mit "
    "Stroh gedeckt sind." );
  AddDetail( "seiten",
    "Vor Dir, auf dem Platz, schliessen mehrere Haeuser direkt an den Steg "
    "an." );
  AddDetail( ({"stroh", "schilf", "schilfdaecher", "strohdaecher", "daecher" }),
    "Strohdaecher - halt, nein, sie sind mit Schilf gedeckt, eigentlich "
    "logisch - schuetzen die Bewohner der Haeuser vor Witterungseinfluessen." );
  AddDetail( "bewohner",
    "Zweifellos wohnen hier Elfen. " );
  AddDetail( ({ "witterung", "witterungseinfluesse", "einfluesse" }),
    "Gegen Regen und Wind bieten diese Daecher einen perfekten Schutz." );
  AddDetail( "regen",
    "Es regnet anscheinend oft hier, deshalb haben die Elfen ihre Daecher "
    "auch mit Schilf gedeckt, gegen die Witterung." );
  AddDetail( "wind",
    "Die Schilfdaecher bilden einen guten Schutz gegen den Wind." );
  AddDetail( "schutz",
    "Die Haeuser sind ein guter Schutz gegen Witterungseinfluesse." );
  AddDetail( "elfen",
    "Die Bauart des Dorfes ist typisch fuer Elfen." );
  AddDetail( ({ "bauart", "doerfer"}),
    "Nur Elfen bauen solche Doerfer." );
  AddDetail ("wasser",
    "Das Wasser des Sees schlaegt regelmaessig und sanft an die "
    "Holzstaemme unter Dir." );

  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
    "Du hoerst die Geraeusche von geschaeftigen Leuten, die hier ihrer "
    "Arbeit nachgehen und unter Dir hoerst Du das Plaetschern des Wassers, "
    "das an die Holzplanken schlaegt." );
  AddSound( ({"plaetschern", "see", "wasser"}),
    "Unter Dir hoerst Du das Plaetschern des Wassers, das an die Holzplanken "
    "schlaegt.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "wasser"}),
    "Der frische Geruch des Wassers unter Dir steigt zwischen den "
    "Holzstaemmen zu Dir herauf." );

  AddExit( "norden",   "./dorf-006" );
  AddExit ("sueden",   "./dorf-010" );
  AddExit( "osten",    "./dorf-008" );
  AddExit( "westen",   "./dorf-012" );
  AddExit( "suedwesten", "./dorf-011" );
  AddExit( "suedosten",  "./dorf-009" );

  AddItem( NPC "elfenkind", REFRESH_DESTRUCT);
}

