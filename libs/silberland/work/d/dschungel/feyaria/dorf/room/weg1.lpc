// /d/dschungel/feyaria/dorf/room/weg1.c
// 1997-08-14 Feyaria@SilberLand

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Fluss" );
  SetProp(P_INT_LONG,
    "Du stehst am Ufer eines breiten Flusses, der weit im Norden ins Meer "
    "muendet. Am anderen Ufer kannst Du einen kleinen Steg entdecken, den "
    "Du vielleicht durch Schwimmen erreichen kannst. Nach Westen fuehrt ein "
    "schmaler Pfad in den Dschungel hinein, der hier sehr dicht und sumpfig "
    "ist. Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:33, ENV_TERRAIN: TT_JUNGLE]));

  AddDetail( ({"ufer"}),
    ([0:"Du stehst am westlichen Ufer des Flusses. Am oestlichen Ufer kannst Du "
    "einen kleinen Steg erkennen. Ob Du bist dort hinueber schwimmen kannst?",
    "fee":"Du stehst am westlichen Ufer des Flusses. Am oestlichen Ufer kannst Du "
        "einen kleinen Steg erkennen. Ob Du bist dort hinueber schwimmen kannst? "
        "Oder solltest Du vielleicht doch besser Deine Fluegelchen benutzen "
        "und hinueber flattern?"]));
  AddDetail( ({"steg"}),
    "Der Steg ist am anderen Ufer, zu weit weg, um naehere Einzelheiten "
    "erkennen zu koennen.");
  AddDetail( ({ "meer", "norden" }),
    "Das Meer liegt im Norden.");
  AddDetail( ({ "fluss", "muendung" }),
    "Der Fluss fliesst traege nach Norden und muendet dort ins Meer. Aber "
    "das Meerwasser vermischt sich hier schon mit dem Flusswasser.");
  AddDetail( ({ "krokodil", "krokodile" }),
    "Von hier aus kannst Du kein Krokodil erkennen.");
  AddDetail( ({"wasser", "meerwasser", "flusswasser"}),
    "Hier vermischt sich schon das Meerwasser mit dem Flusswasser.");
  AddDetail( ({"schwimmen"}),
    "Ob das Schwimmen hier sicher ist? Vielleicht gibt es ja Krokodile in "
    "diesem Fluss.");
  AddDetail( ({"pfad", "westen", "dschungelpfad"}),
    "Nach Westen fuehrt ein schmaler Pfad in den dichten Dschungel hinein.");
  AddDetail( ({"himmel", "sonne"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({"schwitzen", "schweiss", "poren"}),
    "Der Schweiss rinnt Dir aus allen Poren. Hoffentlicht hast Du keine "
    "warmen Sachen an.");
  AddDetail( ({"boden"}),
    "Der Boden ist hier etwas sumpfig.");
  AddDetail( ({"dschungel"}),
    "Der Dschungel ist hier sehr dicht und sumpfig. Es wachsen die "
    "verschiedensten Pflanzen hier.");
  AddDetail( ({"pflanzen", "pflanze", "baum", "baeume"}),
    "Die grossen Baeume erstrecken sich hoch in den Himmel und bilden ein "
    "dichtes Blaetterdach.");
  AddDetail( ({"blatt", "blaetter"}),
    "Die grossen Blaetter der Baeume bilden ein dichtes Blaetterdach.");
  AddDetail( ({"dach", "blaetterdach"}),
    "Das Blaetterdach der Baeume ist sehr dicht. Darum liegt der Pfad durch "
    "den Dschungel auch im Schatten. Nur hier am Ufer kannst Du den Himmel "
    "und die Sonne sehen.");
  AddDetail( ({"schatten"}),
    "Vielleicht ist es ja im Schatten des Dschungelpfads etwas kuehler als "
    "hier am Ufer.");

  AddSound( ({DEFAULT_SOUND, "rauschen", "fluss"}),
    "Du hoerst das Rauschen des Flusses.");
  AddSmell( ({DEFAULT_SMELL, "fluss", "meer", "dschungel"}),
    "Es riecht nach Meer und Fluss und Dschungel.");

  AddCmd( ({"klopf", "klopfe"}), "klopfen");
  AddCmd( ({"schwimm", "schwimme"}), "schwimmen");
  AddCmd( ({"flatter", "flattere"}), "flattern");

  AddExit( "westen","./weg2" );

  AddItem( ({MOSKITO, MUECKE}), REFRESH_DESTRUCT);

}

int schwimmen(string str)
{
  notify_fail("Wohin willst Du schwimmen?\n");
  if( str == "fluss" || str == "in fluss" || str == "ueber fluss" || str == "durch fluss" )
  {
    if( random(800)+15 < TP->QueryProp(P_LEVEL) )
    {
      write(BS("Du springst in den Fluss und schwimmst hinaus. Sofort "
        "tauchen neben Dir einige Krokodile auf und kommen beaengstigend "
        "schnell auf Dich zu. Und ploetzlich ist da schon ein Krokodil "
        "neben Dir."));
      TP->move( ROOM "fluss", M_GO,"in den Fluss und wird von Krokodilen "
      "erwischt", "springt", "schwimmt herein");
    }
    else
    {
      write( BS("Du springst in den Fluss und schwimmst hinaus. Sofort "
        "tauchen neben Dir einige Krokodile auf und kommen schnell auf Dich "
        "zu. Gerade rechtzeitig erreichst Du das andere Ufer.\n")+
        "Das war jetzt aber knapp!\n");
      TP->move( DORF_KUESTE, M_GO, "in den Fluss und schwimmt von Krokodilen "
        "verfolgt ans andere Ufer", "springt", "kommt von Krokodilen verfolgt "
        "vom anderen Ufer heruebergeschwommen");
    }
    return 1;
  }
  return 0;
}

int klopfen(string str)
{ 
  notify_fail("Woran willst Du klopfen?\n");
  if( !str ) return 0; 
  if( str == "an baum" || str == "baum")
  { 
    write(BS("Du klopfst an den Baum, aber es ist kein TicToc Baum."));
    say(CAP_TPN + " klopft an einen Baum.\n");
    return 1;
  }
  return 0;
}

int flattern(string str)
{
  if( TP->QueryProp(P_RACE) != "Fee") return 0;
  notify_fail("Wohin willst Du flattern?\n");
  if( str == "fluss" || str == "ueber fluss" || str == "hinueber" )
  {
    write( BS("Du flatterst ueber den Fluss."));
    TP->move( DORF_KUESTE, M_GO, "ueber den Fluss ", "flattert", 
        "kommt vom anderen Ufer heruebergeflattert");
    write( BS("Das war jetzt aber anstrengend......"));
    TP->do_exhaust(100+random(100));
    return 1;
  }
  return 0;
}
