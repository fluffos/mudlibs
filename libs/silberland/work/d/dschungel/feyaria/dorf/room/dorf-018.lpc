//  ***     Raum
//  ***     Azrael@SilberLand
//  ***     dorf-018.c
//  ***	----- vor dem Bauschladen

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz" );
  SetProp(P_INT_LONG,
    "Du stehst vor einem Haus, vor dem sich viele Ballen eines besonderen "
    "Materials stapeln. Ueber dem Eingang im Sueden haengt ein buntes Schild. "
    "Im Osten ist die Wand eines Hauses und im Westen stoesst der Steg an "
    "den See.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "hitze"}),
    "Himmel, Sonne, Hitze.....");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
    "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
    "ueber einem See stehst."  );
  AddDetail( ({ "dorfplatz", "platz" }),
    "Das scheint das westlichste Ende des Dorfplatzes zu sein. " );
  AddDetail( ({"ende"}),
    "Ende."); 
  AddDetail( ({ "holzstaemme", "staemme" }),
    "Sie sind tief in den See gerammt um das Dorf zu stuetzen. " );
  AddDetail ("see",
    "Der Steg stoesst im Westen direkt an den See, auf den das ganze Dorf "
    "gebaut ist." );
  AddDetail( ({"ballen", "stoffballen", "hauseingang", "eingang", "stoff" }),
    "Neben dem Hauseingang und entlang der Wand des angrenzenden Hauses sind "
    "Stoffballen gelagert. " );
  AddDetail ("wand",
    "Sie ist im Osten. Hier sind viele Stoffballen aufgestapelt. " );
  AddDetail( "dorf",
    "Du gehst schon die ganze Zeit darin herum. " );
  AddDetail( "zeit",
    "Ja ja, die gute alte Zeit..." );
  AddDetail( "haus",
    "Du stehst vor einem Haus, das direkt an den Steg anschliesst. Vor dem "
    "Eingang liegen viele Stoffballen gelagert." );
  AddDetail( "material",
    "Wenn Du Dich nicht sehr taeuscht, dann sind das Bauschballen. " );
  AddDetail( "bauschballen",
    "Ja, Du hast Dich nicht getaeuscht, das sind Ballen aus Bausch. " );
  AddDetail( ({"bausch", "dinge" }),
    "Aus Bausch kann man viele hilfreiche Dinge herstellen. Sicherlich "
    "erfaehrst Du im Haus mehr darueber." );
  AddDetail( "schild",
    "In verschiedenen Farben sind auf das Schild eine Spindel und eine "
    "Naehnadel gemalt. Darunter steht etwas zu lesen. " );
  AddDetail( "farben",
    "Die Farben auf dem Schild sehen lustig und besonders einladend aus. " );
  AddDetail( "spindel",
    "Spindeln dieser Art werden zum Spinnen verwendent. " );
  AddDetail( "spinnen",
    "Wuahhh, Spinnen, wo denn ?!?" );
  AddDetail( ({ "nadel", "naehnadel" }),
    "Eine ganz normale Naehnadel. " );

  AddReadDetail( "schild",
    "Bauschweberei und Schneiderei - steht auf dem Schild geschrieben." );

  AddSound( DEFAULT_SOUND,
    "Du hoerst die Geraeusche von geschaeftigen Leuten, die hier ihrer "
    "Arbeit nachgehen." );

  AddSmell( DEFAULT_SMELL,
    "Der typische Bauschgeruch kitzelt Dich in der Nase."  );

  AddExit ("sueden",  "./bauschladen" );
  AddExit( "norden",  "./dorf-014" );

  AddItem( NPC "elfenkind", REFRESH_DESTRUCT);
}

