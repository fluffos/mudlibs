// ***     Raum             
// ***     Azrael@SilberLand
// ***     lich-018.c
// ***     ----- Lichtung im Dschungel, mit den Questbaeumen
// ***     ----- noch ohne Details, weil noch in Planung, aber ich werd mich bemuehen *grins*

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Mitten im Dschungel" );
  SetProp(P_INT_LONG,
    "Du stehst mitten im dichten Dschungel. Hier gibt es keinen Pfad mehr, "
    "aber in einige Richtungen ist das Unterholz etwas lichter, sodass man "
    "sich doch fortbewegen kann. Zur Not muss man sich einfach mit einer "
    "Machete den Weg freischlagen. Ueber Dir ist das dichte Blaetterdach "
    "der Dschungelriesen, von denen viele Lianen herunterhaengen. Im Westen "
    "siehst Du einen riesigen Baum mit einer blutroten Rinde. Der Boden "
    "ist hier trocken und mit abgefallenem Laub bedeckt.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN: TT_JUNGLE]));

  AddDetail( ({"baum"}),
    "Der Baum ist riesengross und hat eine blutrote Rinde. Mehr kannst Du "
    "von hier aus nicht erkennen.");
  AddDetail( ({"rinde"}),
    "Um die Rinde dieses Baumes naeher zu betrachten, muesstest Du schon "
    "weiter nach Westen gehen.");
  AddDetail( ({"dschungel"}),
    "Du stehst mitten im dichten Dschungel.");
  AddDetail( ({"pfad", "weg"}),
    "Es ist kein Pfad oder Weg weit und breit zu sehen. Du musst Dich schon "
    "wild durch den Dschungel durchschlagen.");
  AddDetail( ({"richtungen", "osten", "westen"}),
    "Nach Osten und Westen ist das Unterholz etwas lichter, sodass Du "
    "Dich in diese Richtungen fortbewegen kannst.");
  AddDetail( ({"unterholz"}),
    "Das Unterholz ist so dicht, dass man sich nur in wenige Richtungen "
    "fortbewegen kann.");
  AddDetail( ({"machete", "fortbewegung"}),
    "Eine Machete ist hier fuer die Fortbewegung ganz nuetzlich.");
  AddDetail( ({"dach", "blaetterdach"}),
    "Das Blaetterdach ueber Dir laesst nur wenige Sonnenstrahlen bis zum "
    "Boden durchdringen.");
  AddDetail( ({"himmel", "sonne"}),
    "Sonne und Himmel sind durch das dichte Blaetterdach nicht zu sehen.");
  AddDetail( ({"strahlen", "sonnenstrahlen", "strahl", "sonnenstrahl"}),
    "Nur wenige Sonnenstrahlen koennen das dichte Blaetterdach durchdringen "
    "und bis zum Boden vorstossen.");
  AddDetail( ({"riesen", "dschungelriesen"}),
    "Mit Dschungelriesen sind natuerlich die riesenhaften Baeume gemeint.");
  AddDetail( ({"baeume"}),
    "Die Baeume hier sind alle riesengross, das laesst viel Platz am Boden "
    "fuer das Unterholz. Viele Lianen haengen von den Baeumen herunter.");
  AddDetail( ({"boden"}),
    "Der Boden ist hier trocken und mit abgefallenem Laub bedeckt.");
  AddDetail( ({"laub"}),
    "Das Laub stammt wohl von den riesigen Baeumen.");
  AddDetail( ({"lianen"}),
    "Viele Lianen haengen von den Baeumen herunter.");

  AddSound( ({DEFAULT_SOUND, "geraeusche", "dschungelgeraeusche"}),
    "Du hoerst die ueblichen Dschungelgeraeusche: das Zirpen von Grillen, die "
    "Schreie von Affen, Vogelgezwitscher und machmal auch das Bruellen einer "
    "Raubkatze.");
  AddSound( ({"zirpen", "grillen", "grille"}),
    "Die Grillen zirpen.");
  AddSound( ({"schrei", "schreie", "affe", "affen"}),
    "Die Affen schreien laut.");
  AddSound( ({"vogel", "voegel", "zwitschern", "vogelgezwitscher"}),
    "Du hoerst das Zwitschern von vielen Voegeln.");
  AddSound( ({"bruellen", "raubkatze", "katze", "katzen", "raubkatzen"}),
    "Manchmal hoerst Du das Bruellen von Raubkatzen. Hoffentlich ist nicht "
    "gerade eine hungrige Katze hinter Dir her.");
  AddSmell( ({DEFAULT_SMELL, "dschungel"}),
    "Es riecht nach Dschungel.");

  AddCmd( ({"klopf", "klopfe"}), "klopfen");

  AddExit( "osten", "./lich-017" );
  AddExit( "westen","./baum-000" );

}

int klopfen(string str)
{ 
  notify_fail("Woran willst Du klopfen?\n");
  if( !str ) return 0; 
  if( str == "an baum" || str == "baum")
  { 
    write(BS("Du klopfst an den Baum, aber es ist kein TicToc Baum."));
    say(CAP_TPN + " klopft an einen Baum.\n");
    return 1;
  }
  return 0;
}

