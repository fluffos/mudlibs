//  ***     Raum
//  ***     Azrael@SilberLand
//  ***     dorf-016.c 
//  ***      ----- Turnierleitung fuer Bogenturnier

inherit "std/room";
inherit "std/more";

#include "../def.h"

string bogenlog();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Steg" );
  SetProp(P_INT_LONG,
    "Du stehst in einer Art Zelt aus Strohmatten. Vor Regen und Wind "
    "geschuetzt stehen hier ein Tisch und einige Stuehle. Hinter dem "
    "Tisch haengt ein groesseres Plakat an der Wand und auf dem Tisch liegen "
    "Zettel und Listen. Nach Norden fuhrt der Steg weiter an ein Gelaender, "
    "das direkt an das Wasser anschliesst und ebenfalls mit Strohmatten "
    "ueberdacht ist. Nur im Nordosten ist eine Hausmauer erkennbar und nach "
    "Osten kommst Du durch einen Strohvorhang auf den Dorfplatz.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({ "steg", "boden", "gelaender" }),
    "Der Steg fuehrt nach Norden zu einem Gelaender.");
  AddDetail( ({"vorhang", "strohvorhang"}),
    "Wenn Du den Vorhang zurueckschlaegst, kannst Du nach Osten auf den "
    "Dorfplatz gelangen.");
  AddDetail( ({"plakat", "werbung", "bogenschuetzenturnier", "turnier"}),
    "Das Plakat ist eine Werbung fuer das Bogenschuetzenturnier. Es zeigt "
    "einen laechelnden Elf mit einem Langbogen in der einen Hand und einem "
    "Siegerpokal in der anderen. Darueber steht etwas geschrieben.");
  AddDetail( ({"bogen", "langbogen"}),
    "Ein Langbogen, wie ihn nur die Elfen verwenden.");
  AddDetail( ({"elf", "hand", "haende"}),
    "Der Elf haelt einen Langbogen und einen Siegerpokal in den Haenden.");
  AddDetail( ({"pokal", "siegerpokal"}),
    "So einen Siegerpokal moechtest Du wohl auch gerne gewinnen!");
  AddReadDetail( ({"plakat"}),
    "\n DAS GROESSTE BOGENSCHUETZENTURNIER IM SILBERLAND\n\n");
  AddDetail( ({"tisch", "zettel", "listen", "liste"}),
    "Auf dem Tisch liegen einige Zettel und Listen. Sie haben wohl mit dem "
    "Turnier zu tun.");
  AddReadDetail( ({"zettel", "listen", "liste"}),
    "Ein kurzer Blick auf die Zettel und Listen zeigt, dass es sich um "
    "Teilnehmerlisten und um Ergebnisse frueherer Turniere handelt.");
  AddDetail( ({"ergebniss", "ergebnisse", "gewinner"}),
    "Hier kannst Du alle frueheren Gewinner des Bogenturniers lesen.");
  AddReadDetail( ({"ergebniss", "ergebnisse", "gewinner"}),#'bogenlog);
  AddDetail( ({"stuhl", "stuehle"}),
    "Einige Stuehle stehen hier herum.");
  AddDetail( ({"zelt", "strohzelt"}),
    "Man koennte diesen kleinen Raum als Zelt bezeichnen, denn er wird von allen Seiten "
    "mit Strohmatten begrenzt und ist so regen- und windgeschuetzt. " );
  AddDetail( "art",
    "Eine Art Strohzelt umgibt Dich von allen Seiten und fuehrt nach Norden weiter direkt "
    "an den See. " );
  AddDetail( "regen", 
    "Durch die Strohmatten ueber Deinem Kopf kommt garantiert kein Regen durch. " );
  AddDetail( "wind",
    "Hier ist man auch gegen Wind geschuetzt, warum eigentlich? " );
  AddDetail( "decke",
    "Eine Strohmatte woelbt sich ueber Deinem Kopf als Decke. " );
  AddDetail( ({"himmel"}),
    "Die Strohmatte ueber Dir verdeckt die Sicht zum Himmel.");
  AddDetail( "kopf",
    "Manche benutzen ihn zum Denken...hmmm...Du wohl nicht. " );
  AddDetail( "denken",
    "Du denkst. o O (Uuh, hoffentlich ist das nicht ansteckend) " );
  AddDetail( ({"seiten", "matten", "strohmatten", "strohmatte"}),
    "Du bist von allen Seiten von Strohmatten umgeben. " );
  AddDetail( "raum",
    "In diesem Raum liegt irgendetwas spannendes, kaempferisches in der Luft." );
  AddDetail( ({"luft"}),
    "Ueberall rund um Dich ist Luft, sonst koenntest Du wohl nicht atmen!");
  AddDetail( "haus",
    "Im Nordosten steht ein Haus, das man anschiendend dort betreten kann. " );
  AddDetail( ({ "hausmauer", "mauer", "wand", "waende" }),
    "Naja, als Mauer kann man es nicht gerade bezeichnen. Die Waende des Hauses "
    "sind geflochtene Aeste, die ihm ein rundes, fast birnenfoermiges Aussehen geben. " );
  AddDetail( "aeste",
    "Verschiedenste Aeste sind als Waende ineinander geflochten. " );
  AddDetail( ({"dorfplatz", "platz"}),
    "Der Dorfplatz ist im Osten.");
  AddDetail( ({"see", "wasser"}),
    "Der See ist unter Dir.");

  AddSound( ({DEFAULT_SOUND, "zettel", "rascheln"}),
    "Die Zettel rascheln." );
  AddSmell( DEFAULT_SMELL,
    "Ein angenehmer Geruch steigt Dir in die Nase.");
  AddSmell( "geruch",
    "Du kannst den Geruch nicht naeher zuordnen.");

  AddCmd ( ({ "schlage", "schlag", }), "vorhang" );                                          

  AddExit( "norden",  "./dorf-017" );

 
}

vorhang  (str)

{
   notify_fail ("Aehm...was willst Du tun?\n" );
   if (!str) return 0;
   if ( str != "vorhang zurueck" ) return 0;
   {
    write ( "Du schlaegst den Vorhang zurueck und gehst durch.\n"
          + "Hinter Dir klappt der Vorhang wieder leise zurueck.\n\n" );
    TP->move ( ROOM "dorf-013", M_GO, "den Vorhang zur Seite und geht durch", "schlaegt");
    return 1;
   }
   return 0;
  
}

string bogenlog()
{
  TP->More(read_file("/log/quests/bogen"));
  return "";
}

