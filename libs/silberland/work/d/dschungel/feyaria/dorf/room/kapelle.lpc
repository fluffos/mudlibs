#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:28]) );
  
  SetProp(P_INT_SHORT, "Im heiligen Schrein der Elfen");

  SetProp(P_INT_LONG, 
      "Du stehst im heiligen Schrein der Dschungelelfen.");


  AddCmd("bete","beten_fkt");
//  AddExit("osten", ROOM "dorf-014");
}

nosave int beten_fkt(string str)
{
  write(BS("Du faellst auf die Knie und sprichst innig zu Deinem Gott."));

  if(TP->QueryProp(P_GHOST))
  {
    say(BS("Der Geist von "+TPN+" kniet nieder und betet innig."), ({TP}));

    write(BS("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "
	     "aus.")+
	  BS("Du spuerst langsam wieder, wie Blut Deinen Koerper von neuem "
	     "durchstroemt."));
    
    say(BS(TPN+" erscheint ploetzlich wieder in koerperlicher Form."), ({TP}));
    
    TP->SetProp(P_GHOST, 0);
    
    if(TP->QueryProp(P_RACE)=="Elf")
      TP->heal_self(5+random(5));
  }
  else
    say(BS(TPN+" kniet nieder und betet zu "+TP->QueryPossPronoun(MALE, WEM)+
	   " Gott."));

  return 1;
}

