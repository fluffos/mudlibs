// /d/dschungel/feyaria/dorf/room/weg3.c
// 1997-08-14 Feyaria@SilberLand

inherit "std/room";

#include "../def.h"
#include "../quest.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dschungelpfad" );
  SetProp(P_INT_LONG,
    "Du stehst auf einem schmalen Dschungelpfad, der von Suedwesten nach Osten "
    "fuehrt. Der Dschungel ist hier sehr dicht und etwas sumpfig. Durch das "
    "dichte Blaetterdach dringt nur wenig Sonnenlicht bis zum Boden vor. "
    "Trotzdem hat es hier eine schwuele Hitze, die Dir den Schweiss aus den "
    "Poren treibt.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:29, ENV_TERRAIN: TT_JUNGLE]));
  
  AddDetail( ({"pfad", "dschungelpfad", "suedwesten", "osten"}),
    "Der Pfad fuehrt von Suedwesten nach Osten.");
  AddDetail( ({"himmel", "sonne"}),
    "Den Himmel und die Sonne kann man durch das dichte Blaetterdach nur "
    "erahnen. Nur gelegentlich trifft ein Sonnenstrahl auf den Boden.");
  AddDetail( ({"hitze"}),
    "Es ist wirklich sehr warm hier.");
  AddDetail( ({"schwitzen", "schweiss", "poren"}),
    "Der Schweiss rinnt Dir aus allen Poren. Hoffentlicht hast Du keine "
    "warmen Sachen an.");
  AddDetail( ({"boden"}),
    "Der Boden ist hier etwas sumpfig. Manchmal trifft ein Lichtstrahl auf "
    "den Boden, was ein lustiges Fleckenmuster erzeugt.");
  AddDetail( ({"licht", "lichtstrahl", "strahl", "sonnenstrahl", "strahlen",
               "lichtstrahlen", "sonnenstrahlen", "muster", "fleckenmuster",
               "sonnenlicht"}),
    "Gelegentlich triffen Sonnenstrahlen auf den Boden und erzeugen ein "
    "lustiges Fleckenmuster.");
  AddDetail( ({"dschungel"}),
    "Der Dschungel ist hier sehr dicht und sumpfig. Es wachsen die "
    "verschiedensten Pflanzen hier.");
  AddDetail( ({"pflanzen", "pflanze", "baum", "baeume"}),
    "Die grossen Baeume erstrecken sich hoch in den Himmel und bilden ein "
    "dichtes Blaetterdach.");
  AddDetail( ({"blaetter", "dach", "blaetterdach"}),
    "Das Blaetterdach ueber Dir verdeckt den ganzen Himmel.");

  AddSound( ({DEFAULT_SOUND, "geraeusche", "dschungelgeraeusche"}),
    "Du hoerst die ueblichen Dschungelgeraeusche: das Zirpen von Grillen, die "
    "Schreie von Affen, Vogelgezwitscher und machmal auch das Bruellen einer "
    "Raubkatze.");
  AddSound( ({"zirpen", "grillen", "grille"}),
    "Die Grillen zirpen.");
  AddSound( ({"schrei", "schreie", "affe", "affen"}),
    "Die Affen schreien laut.");
  AddSound( ({"vogel", "voegel", "zwitschern", "vogelgezwitscher"}),
    "Du hoerst das Zwitschern von vielen Voegeln.");
  AddSound( ({"bruellen", "raubkatze", "katze", "katzen", "raubkatzen"}),
    "Manchmal hoerst Du das Bruellen von Raubkatzen. Hoffentlich ist nicht "
    "gerade eine hungrige Katze hinter Dir her.");
  AddSmell( ({DEFAULT_SMELL, "dschungel"}),
    "Es riecht nach Dschungel.");

  AddCmd( ({"klopf", "klopfe"}), "klopfen");

  AddExit( "suedwesten","./lich-001" );
  AddExit( "osten","./weg2" );

}

int klopfen(string str)
{
  object ob;
  notify_fail("Woran willst Du klopfen?\n");
  if( !str ) return 0;
  if( str == "an baum" || str == "baum")
  {
    if( (ob=present(BOGENQUESTID,TP)) && !present(QUEST_STOCK,TP) &&
        !present(QUEST_BOGEN, TP) )
    {
      write("Du klopfst an den Baum, und hoerst ein lautes 'Tic Toc'.\n");
      say(CAP_TPN + " klopft an einen Baum.\n");
      write("Sofort brichst Du voller Freude einen Ast von diesem Baum ab.\n");
      CLONE(OBJ "stock", TP);
      ob->quest_teil(BQ_STOCK);
      return 1;
    }
    else
    {
      write(BS("Du klopfst an den Baum, aber es ist kein TicToc Baum."));
      say(CAP_TPN + " klopft an einen Baum.\n");
      return 1;
    }
  }
  return 0;
}

