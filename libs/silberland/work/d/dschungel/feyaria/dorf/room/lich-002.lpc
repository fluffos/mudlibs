//  ***     Raum           
//  ***     Azrael@SilberLand 
//  ***     lich-002.c        
//  ***     ----- Eingang zum Auelfenpfahldorf

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine sumpfige Wiese" );
  SetProp(P_INT_LONG,
    "Du stehst auf einer sumpfigen Wiese, die Sonne strahlt und ein warmer "
    "Wind weht Dir entgegen. Das Gras ist hier noch gruener und saftiger als "
    "vorher und irgendwie kommt es Dir vor als wuerden Deine Schritte schwerer. "
    "Suedlich von Dir saeumt dichtes Schilf Deinen Weg, oestlich kannst Du "
    "den Dschungel erreichen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN: TT_JUNGLE]));
  
  AddDetail( ({ "dschungel", "pfad" }),
    "Im Osten geht ein schmaler Pfad in den Dschungel hinein." );
  AddDetail( ({"wiese"}),
    "Du stehst auf einer sumpfigen Wiese mit saftigem, gruenen Gras.");
  AddDetail( "sonne",
    "Die Sonne scheint gluehend von Himmel." );
  AddDetail( "himmel",
    "Ein wolkenfreier Himmel woelbt sich ueber Dir." );
  AddDetail( ({"boden", "untergrund", "weg" }),
    "Der Boden wird zusehends feuchter und sumpfiger, es wird immer "
    "schwerer zu gehen, weil Deine Fuesse im weichen Untergrund einsinken.");
  AddDetail( ({"fuesse", "fuss", "schritt", "schritte"}),
    "Deine Fuesse sinken etwas in den weichen Untergrund ein.");
  AddDetail( "wind",
    "Der Wind traegt einen eigenartigen Geruch zu Dir her, er kommt aus Sueden.");
  AddDetail( ({"schilf", "schilfwand", "wand" }),
    "Dicht zusammen stehen hier viele sehr hohe Schilfpflanzen, sie bilden "
    "eine regelrechte Wand. Von dort kommt auch ein sonderbarer Geruch zu Dir "
    "durch." );
  AddDetail( ({ "schilfpflanzen", "pflanzen" }),
    "Beim genaueren Hinschauen bemerkst Du, dass das Schilf hier nicht so dicht"
    " ist. Du koenntest versuchen Dich durchzuzwaengen." );
  AddDetail( "gras",
    "Das Gras ist saftig gruen, hie und da siehst Du eine kleine Pfuetze." );
  AddDetail( ({"pfuetzen", "wasser", "pfuetze" }),
    "Ab und zu hat sich hier Wasser in kleinen Pfuetzen angesammelt. Viele "
    "Wasserlaeufer tummeln sich hier auf dem Wasser." );
  AddDetail( ({"wasserlaeufer", "laeufer", "insekten" }),
    "Du wunderst Dich, wie diese kleinen, zierlichen Insekten es schaffen, auf "
    "dem Wasser zu bleiben ohne unterzugehen." );
  AddDetail( ({"see"}),
    "Sehen kannst Du den See nicht, aber Du vermutest ihn irgendwo im Sueden. "
    "Um dorthinzukommen, musst Du einen Weg durch das dichte Schilf finden.");

  AddSound( DEFAULT_SOUND,
    "Es ist ungewoehnlich still hier, eigentlich zu still fuer eine solche "
    "Umgebung - direkt unheimlich." );

  AddSmell( DEFAULT_SMELL,
    "Der Geruch von feuchter Erde steigt Dir in die Nase." );
  AddSmell( "erde",
    "Irgendwo in der Naehe muss es stehendes Wasser geben, "
    "das riechst Du ganz deutlich." );
  AddSmell( ({"geruch", "sueden", "wasser" }),
    "Von Sueden her dringt der Geruch von stehendem Wasser durch das Schilf. "
    "Sicher ist dort irgendwo ein See im Sueden.");

  AddCmd(({"zwaenge", "zwaeng"}), "durch_schilf");

  AddExit( "osten",    "./lich-001" );
  AddExit( "westen",  "./lich-003" );
  AddExit( "sueden", "./dorf-001" );
}

 durch_schilf ( str )
 {
   notify_fail ("Wodurch willst Du Dich zwaengen?\n" );
   if ( str == "durch schilf" || str == "durch schilfwand" )
   {
    write ( "Du zwaengst Dich muehevoll durch das Schilf.\n" );
    TP->move ( ROOM "dorf-001", M_GO, "sich durch das Schilf.", "zwaengt");
    return 1;
   }
   return 0;
  
}


