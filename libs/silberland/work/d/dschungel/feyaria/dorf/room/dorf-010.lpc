//  ***     Raum                         
//  ***     Azrael@SilberLand 
//  ***     dorf-010.c                 
//  ***     ----- Entwurf fuer Dorfplatz

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Dorfplatz des Pfahldorfes" );
  SetProp(P_INT_LONG,
    "Ein huebscher Springbrunnen plaetschert friedlich vor sich hin. Das "
    "Wasser ist sauber und klar. Dahinter beginnt der See, der schon ziemlich "
    "tief zu sein scheint. Im Norden fuehrt der Steg zurueck zum Ufer. "
    "Westlich siehst Du einige Stuehle stehen. Ein kleiner Verkaufsstand ist "
    "im Nordwesten aufgestellt. Aus dem Schornstein des Hauses im Nordosten "
    "steigt Rauch auf.");
  SetProp(P_LIGHT, 2);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
    "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
    "ueber einem See stehst."  );
  AddDetail( ({ "holzstaemme", "staemme" }),
    "Das ganze Dorf steht auf Holzstaemmen, die in den Boden des Sees gerammt "
    "worden sind. " );
  AddDetail( "dorf",
    "Es ist eigentlich ziemlich gross und macht einen sehr sympatischen und "
    "einladenden Eindruck." );
  AddDetail( ({ "stand", "verkaufsstand", "nordwesten" }),
    "Er steht im Nordwesten." );
  AddDetail( "rauch",
    "Er steigt aus dem Haus im Nordosten auf." );
  AddDetail( ({"nordosten"}),
    "Das Haus im Nordosten hat einen grossen Schornstein, aus dem Rauch "
    "aufsteigt.");
  AddDetail( "schornstein",
    "Aus ihm steigt Rauch auf." );
  AddDetail( "stuehle",
    "Sie stehen westlich und sehen einladend aus." );
  AddDetail( ({ "haus", "haeuser" }),
    "Ueberall hier stossen Haeuser an den Steg." );
  AddDetail( "eindruck",
    "Der erste Eindruck sehr wichtig, und dieses Dorf macht einen sauberen, "
    "guten Eindruck auf Dich."  );
  AddDetail( ({ "platz", "dorfplatz" }),
    "Der Dorfplatz breitet sich nach allen Richtungen aus, nur nach Sueden "
    "schliesst der See an den Steg. Der Brunnen bringt eine nette "
    "Abwechslung hier." );
  AddDetail( "abwechslung",
    "Der Brunnen hier bringt etwas Abwechslung in das hoelzerne Dorf." );
  AddDetail( "mechanismus",
    "Er muss ziemlich kompliziert sein, schade dass Du keine Zeit hast, ihn "
    "genauer zu untersuchen, Du koenntest sicher einiges lernen." );
  AddDetail( "zeit",
    "Tja, die Zeit...wenn man nur mehr davon haette..." );
  AddDetail( "quelle",
    "Dieser Brunnen muss irgendwie mit einer weiter entfernten Quelle "
    "verbunden sein." );
  AddDetail( ({ "brunnen", "springbrunnen" }),
    "Frisches Wasser plaetschert friedlich aus dem steinernen Brunnen.");
  AddDetail( ({ "wasser", "brunnenwasser", "quellwasser" }),
    "Das Brunnenwasser ist klar und frisch, ganz anders als das modrige "
    "Wasser am Ufer. Durch irgendeinen Mechanismus muss es direkt von "
    "der Quelle hierhergeleitet worden sein." );
  AddDetail( "ufer",
    "Nach Norden kommst Du zurueck zum Ufer, am Wachhaus vorbei." );
  AddDetail( "wachhaus",
    "Es liegt im Norden Richtung Ufer hin." );
  AddDetail( "see",
    "Er muss hier schon ziehmlich tief sein, denn obwohl das Wasser sauber "
    "und klar ist, sieht man nicht bis zum Grund." );
  AddDetail( "grund",
    "Du siehst nicht mehr bis zum Grund des Sees, obwohl das Wasser klar ist.");

  AddSound( ({DEFAULT_SOUND, "plaetschern", "brunnen"}),
    "Das Plaetschern des Brunnens hat eine beruhigende Wirkung auf Dich.\n" );

  AddSmell( ({DEFAULT_SMELL, "brunnen", "luft"}),
    "Das Wasser des Brunnens macht die Luft hier angenehm und frisch.\n");
 
  AddRoomMessage( ({
    "Der Springbrunnen sprudelt einen Strahl frisches Quellwasser hervor.\n",
    "Einige Spritzer Wasser benetzen Dein Gewand.\n",
    "Ruhig plaetschernd rinnt das Wasser aus der Oeffnung des Brunnens.\n",
     }), 60 );

  AddDetail( ({"spritzer"}),
    "Die Spritzer des Brunnens benetzen Dein Gewand und Dein Gesicht. Aber "
    "bei der Hitze hier ist das ganz angenehm."); 
 
//  AddCmd( ({"trink", "trinke"}), "trinken" );  
  
  AddExit ("norden",     "./dorf-007" );
  AddExit( "westen",     "./dorf-011" );
  AddExit( "osten",      "./dorf-009" );
  AddExit( "nordwesten", "./dorf-012" );
  AddExit( "nordosten",  "./dorf-008" );

  AddItem( NPC "elfenkind", REFRESH_DESTRUCT);
}

