//  ***     Azrael@SilberLand 
//  ***     dorf-012.c                 
//  ***     ----- Entwurf fuer Dorfplatz

inherit "std/laden";

#include <laden.h>
#include "../def.h"

void create()
{
  ::create();
  
  last=wantto=mymoney=30000;

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz" );
  SetProp(P_INT_LONG,
     "Hier steht ein hoelzerner Verkaufsstand. Der Elf dahinter breitet "
     "gerade verschiedene Artikel aus. Mehrere Stapel mit Werbezetteln "
     "liegen auf dem Tisch. Nach Osten kommst Du zurueck zum Eingang des "
     "Platzes. Suedlich von Dir stehen zwei Tische mit Stuehlen vor einem "
     "Haus.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));
  SetStorageRoom (ROOM "store");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+ SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "haendler");
  SetProp(P_SHOPKEEPER_NAME, "der Haendler");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "verkaufsstand", "stand" }),
    "Ein hoelzernes Gestell, das aus einem Tisch und einer darueber "
    "angebrachten Plane gegen Regen zusammengesetzt ist." );
  AddDetail( ({ "tisch", "gestell" }),
    "Der Stand besteht aus einem einfachen Tisch, ueber den ein weisses Tuch "
    "gelegt wurde. Der Verkaeufer legt gerade verschieden Artikel darauf "
    "aus." );
  AddDetail( "verkaeufer",
    "Er steht hinter dem Verkaufsstand." );
  AddDetail( ({"artikel", "fackeln", "seile"}),
    "So Sachen wie Fackeln und Seile, was man halt im taeglichen Leben "
    "so braucht." );
  AddDetail( ({ "tuch", "tischtuch" }),
    "Ein weisses Tuch, wie es sonst auch als Tischtuch verwendet wird. " );
  AddDetail( "plane",
    "Diese aus Bausch gefertigte Plane sollte alles, was darunter liegt "
    "gegen Regen schuetzen." );
  AddDetail( ({"bausch", "material", "bauschgewebe", "gewebe", "bauschbinse",
               "binse" }),
    "Bausch ist ein watteaehnliches Material, das aus den Samen der "
    "Bauschbinse gewonnen wird. Die Dschungelelfen stellen viele "
    "Gebrauchsartikel, wie Kleidung oder Planen daraus her." );
  AddDetail( ({"samen", "bauschbinsesamen"}),
    "Aus ihnen wird Bausch gewonnen." );
  AddDetail( ({ "gebrauchsartikel", "kleidung", "sachen" }),
    "Die Auelfen sind bekannt dafuer, verschiedenste Sachen aus Bausch weben "
    "zu koennen, vorallem Kleidung, da dieses Material auch wasserdicht ist." );
  AddDetail( ({"dschungelelfen", "elfen" }),
    "Elfen und Dschungelelfen ganz besonders bevorzugen Kleidung aus Bausch." );
  AddDetail( "regen",
    "Die Plane ist ein Bauschgewebe, sie sollte also eingentlich absolut "
    "wasserdicht sein." );
  AddDetail( "stapel",
    "Auf dem weissen Tuch liegen mehrere Stapel Werbezettel." );
  AddDetail( ({ "werbezettel", "zettel" }),
    "Mehrere Stapel liegen davon auf dem Tisch, einer zieht Deinen Blick "
    "besonders an: Auf der Vorderseite siehst Du eine ornamentreiche "
    "Zeichnung eines gespannten Bogens abgebildet." );
  AddDetail( "blick",
    "Ein Stapel Zettel zieht Deinen Blick besonders auf sich." );
  AddDetail( "zettel",
    "Aehm....lesen waere besser, meinst Du nicht?" );
  AddDetail( ({ "vorderseite", "zeichnung" }),
    "Die Zeichnung auf der Vorderseite des Zettels zeigt einen schoen "
    "gezeichneten Bogen, in den ein Pfeil eingespannt ist." );
  AddDetail( ({ "bogen", "pfeil" }),
    "Der Bogen ist wunderschoen verziert und stilisiert dargestellt und bei "
    "naeherem hinschauen siehst Du, das in den Schaft des Pfeiles, der in "
    "die Sehne gespannt ist, eine schwarze und eine weisse Feder "
    "eingearbeitet sind. Unter der Zeichnung steht etwas in schoener Schrift.");
  AddDetail( "sehne",
    "In der Sehne des Bogens ist ein Pfeil eingespannt." );
  AddDetail( "schrift",
    "Lesen waere vielleicht angebrachter, meinst Du nicht?" );
  AddDetail( ({ "schaft", "feder" }),
    "In den Schaft des gezeichneten Pfeiles sind eine schwarze und eine "
    "weisse Feder eingearbeitet. Komisch, irgendwo hast Du das schon einmal "
    "gesehen, aber wo?" );
  AddDetail( ({ "eingang", "platz", "ufer", "dorfplatz", "dorf" }),
    "Zum Eingang des Dorfplatzes und damit zurueck zu Ufer kommst Du Richtung "
    "Osten." );
  AddDetail( ({ "stuehle", "tische", "wirtshaus", "haus" }),
    "Im Sueden stehen einige Tische und Stuehle, dort muss wohl ein "
    "Wirtshaus sein." );
  AddDetail( ({"boden", "holzstaemme", "holzstamm", "stamm", "staemme"}),
    "Der Boden besteht aus Holzstaemmen, so wie ueberall im Dorf.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die Geraeusche von geschaeftigen Leuten, die hier ihrer "
    "Arbeit nachgehen und unter Dir hoerst Du das Plaetschern des Wassers, "
    "das an die Holzplanken schlaegt." );

  AddSmell( DEFAULT_SMELL,
    "Der frische Geruch des Wassers unter Dir steigt zwischen den "
    "Holzstaemmen zu Dir herauf." );
  
  AddReadDetail( ({"zettel", "schrift" }),
    "Hier steht in ornamentreicher, elfischer Schrift: \n\n"
    "          ************************************************\n"
    "          ***          Bogenschuetzen-Turnier          ***\n"
    "          ***                                          ***\n"
    "          *** Naehere Informationen auf der Rueckseite ***\n"
    "          ************************************************\n\n" );
  AddReadDetail( "rueckseite",
         "@@abfrage@@" );


  AddItem( NPC "haendler", REFRESH_DESTRUCT );
  RemoveItem( "/obj/entsorg");

  AddExit( "sueden",     "./dorf-011" );
  AddExit( "westen",     "./dorf-013" );
  AddExit( "osten",      "./dorf-007" );
  AddExit( "suedwesten", "./dorf-014" );
  AddExit( "suedosten",  "./dorf-010" );

}

string abfrage()
{
  if (!present("zettel", TP ))
    return (BS( "Du hast den Zettel nicht, frag einmal den Verkaeufer, "
        "vielleicht gibt er Dir einen, hmm..?") );
  return "";
}

varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if( ob->QueryProp(P_WEAPON_TYPE) || ob->QueryProp(P_ARMOUR_TYPE) )
  {
    write("Der Haendler sagt: Tut mir leid, so etwas kaufen wir hier nicht.\n");
    return 1;
  }
  return ::do_sell(ob, force, prefix, limit);
}
       
