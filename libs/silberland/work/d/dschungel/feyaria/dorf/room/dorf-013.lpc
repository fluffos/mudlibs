//  ***     Raum            
//  ***     Azrael@SilberLand  
//  ***     dorf-013.c
//  ***      ----- Entwurf fuer Dorfplatz

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz"  );
  SetProp(P_INT_LONG,
    "Auch hier ist ein Haus direkt an den Steg angebaut. Eine Holztuere als "
    "Eingang verhindert Blicke hinein. Auf einem Schild neben der Tuere steht "
    "in schoenen Buchstaben : \"Tenobaal, Bognermeister.\" " 
    "Westlich siehst Du einen eigenartigen Strohverschlag durch den Stimmen "
    "zu hoeren sind. Im Osten steht ein Verkaufsstand, suedoestlich stehen "
    "Tische, und im Sueden sind mehrere Ballen uebereinandergestapelt.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));


  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
    "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
    "ueber einem See stehst."  );
  AddDetail( "blicke",
    "Blicke kann man werfen, aber auch senken oder heben. " );
  AddDetail( ({"eingang", "holztuere", "tuere", "holztuer", "tuer" }),
    "Durch eine Holztuere im Norden kann man dieses Haus betreten. " );
  AddDetail( ({"verkaufsstand", "stand" }),
    "Im Osten steht jemand hinter einem Verkaufsstand. " );
  AddDetail( "ballen",
    "Sie liegen im Sueden uebereinandergestapelt. " );         
  AddDetail( "tische",
    "Im Suedosten stehen einige Tische. " );
  AddDetail( ({ "strohverschlag", "verschlag", "vorhang", "strohvorhang" }),
    "Dahinter scheint jemand zu sein, Du koenntest den Strohvorhang "
    "zurueckschlagen. " );
  AddDetail( "haus",
    "Dieses Haus hat eine besonders lustige Form, es sieht aus wie eine "
    "Birne. " );
  AddDetail( "form",
    "Jedes Haus hier im Dorf hat eine andere Form, das im Norden sieht aus "
    "wie eine Birne." );
  AddDetail( "birne",
    "Du bekommst ploetzlich grosse Lust in eine frische, saftige Birne zu "
    "beissen. " );
  AddDetail( "lust",
    "Lust ist etwas hoechst Interessantes...schon Freud sagte:... aber "
    "lassen wir das! " );
  AddDetail( "freud",
    "Keine Zeit fuer einen psychoanalytischen Diskurs jetzt. " );
  AddDetail( "zeit",
    "Waehrend Du darueber nachdenkst verstreicht ein viel kostbare Zeit. "
    "Du solltest sie besser nuetzen, nachdenken war noch nie Deine Staerke." );
  AddDetail( "staerke",
    "Du ueberlegst..., aber Staerken findest Du an Dir keine. " );
  AddDetail( "diskurs",
    "Du denkst . o O (Diskurs...Diskuss...hoffentlich ist das nicht "
    "ansteckend. )" );
  AddDetail( "dorf",
    "Du befindest Dich auf dem Dorfplatz desselben. " );
  AddDetail( ({"dorfplatz", "platz" }),
    "Der breite Steg bildet soetwas wie einen Dorfplatz. " );
  AddDetail( "see",
    "Hast Du schon wieder vergessen, dass das Dorf auf einen See gebaut ist?");
  AddDetail( ({"staemme", "holzstaemme", "holz" }),
    "Der Steg ist aus Holzstaemmen gemacht, die in den Seeboden gerammt "
    "wurden. " );
  AddDetail( ({ "seeboden", "boden" }),
    "Die Staemme stecken fest im Boden des Sees...hoffentlich. " );
  AddDetail( ({"tenobaal", "bognermeister"}),
    ([0: "Du kennst Tenobaal, den beruehmten Bognermeister nicht?",
      "elf": "Seit fruehester Kindheit ist Dir Tenobaal als der beste Bogner "
             "bekannt. Angeblich hat er mit seinem Zauberbogen noch nie ein "
             "Ziel verfehlt."]) );

  AddDetail( ({"schild", "buchstaben"}),
    "Auf dem Schild steht etwas in schoenen Buchstaben geschrieben.");
  AddReadDetail( ({ "schild", "buchstaben" }),
         "Tenobaal, Bognermeister.\n"
         "Das steht da in schoenen Buchstaben.\n" );

  AddSound( DEFAULT_SOUND, 
    "Von Westen her dringen Stimmen durch einen Strohverschlag. " );
  AddSound( ({"stimmen", "stimme", "strohverschlag", "verschlag"}),
    "Hinter dem Strohverschlag plaudern mehrere Personen. " ); 

  AddSmell( ({DEFAULT_SMELL, "holz", "harz"}),
    "Es riecht nach frischem Holz und Harz. " );

  AddCmd ( ({ "schlage", "schlag", }), "vorhang" );                                          
  AddExit( "sueden",    "./dorf-014" );
  AddExit( "osten",     "./dorf-012" );
  AddExit( "suedosten", "./dorf-011" );
  AddExit( "norden",    "./bogner" );

  AddItem( NPC "elfenkind", REFRESH_DESTRUCT);
}

int vorhang (string str)
{
  notify_fail ("Was willst Du zurueckschlagen?\n" );
  if (!str) return 0;
  if ( str != "vorhang zurueck" ) return 0;
  {
    write ( "Du schlaegst den Vorhang zurueck und gehst durch.\n"
          + "Hinter Dir klappt der Vorhang wieder leise zurueck.\n\n" );
    TP->move ( ROOM "dorf-016", M_GO, "den Vorhang zur Seite und geht durch",
        "schlaegt");
    return 1;
  }
  return 0;
}


