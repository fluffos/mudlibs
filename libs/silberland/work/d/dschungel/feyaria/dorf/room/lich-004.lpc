//  ***     Raum                     
//  ***     Azrael@SilberLand 
//  ***     weid-004.c
//  ***     ----- eine Weide

inherit "std/room";

#include "../def.h"
#include "../quest.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine sumpfige Wiese" );
  SetProp(P_INT_LONG,
    "Du stehst auf einer sumpfigen Wiese, die Sonne strahlt und ein warmer "
    "Wind weht Dir entgegen. Das Gras ist gruen und saftig und in einigen "
    "Pfuetzen hat sich Wasser angesammelt. Im Westen siehst Du dichtes "
    "Gestruepp und viele Lianen. Nach Suedwesten hin oeffnet sich das Schilf, "
    "oestlich breitet sich die Wiese aus.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN: TT_JUNGLE]));
  
  AddDetail( ({ "wiese", "umgebung" }),
    "Eine saftig gruene Wiese breitet sich oestlich vor Deinen Augen aus. " );
  AddDetail( "sonne",
    "Die Sonne scheint angenehm von Himmel." );
  AddDetail( "himmel",
    "Ein wolkenfreier Himmel woelbt sich ueber Dir. " );
  AddDetail( "augen",
    "Deine Augen helfen Dir die Umgebung zu sehen." );
  AddDetail( ({"boden", "untergrund", "weg" }),
    "Der Boden wird zusehends feuchter und sumpfiger, es wird immer "
    "schwerer zu gehen, weil Deine Fuesse im weichen Untergrund einsinken." );
  AddDetail( "fuesse",
    "Sie versinken immer tiefer im morastigen Boden der Wiese." ); 
  AddDetail( "wind",
    "Der Wind traegt einen eigenartigen Geruch zu Dir her, er kommt aus Sueden.");
  AddDetail( ({"schilf", "schilfwand", "wand" }),
    "Dicht zusammen stehen hier viele sehr hohe Schilfpflanzen, sie bilden "
    "eine regelrechte Wand. " );
  AddDetail( ({ "schilfpflanzen", "pflanzen" }),
    "Die Schilfwand ist hier undurchdringlich dicht." );
  AddDetail( "gras",
    "Das Gras ist saftig gruen, hie und da siehst Du eine kleine Pfuetze." );
  AddDetail( ({"pfuetzen", "wasser", "pfuetze" }),
    "Ab und zu hat sich hier Wasser in kleinen Pfuetzen angesammelt. Viele "
    "Wasserlaeufer tummeln sich hier auf dem Wasser." );
  AddDetail( ({"wasserlaeufer", "laeufer", "insekten" }),
    "Du wunderst Dich, wie diese kleinen, zierlichen Insekten es schaffen, auf "
    "dem Wasser zu bleiben ohne unterzugehen." );
  AddDetail( "gestruepp",
    "Dichtes Gestruepp. Hier gehts nicht weiter. " );
  AddDetail( ({"lianen", "liane"}),
    "Hier gibt es sehr viele Lianen. Die meisten sind dick und bruechig, aber "
    "wie Du genauer hinsiehst, kannst Du auch einige duenne Seidenlianen "
    "entdecken.");
  AddDetail( ({"seidenlianen", "seidenliane"}),
    "Die Seidenlianen sind sehr duenn und elastisch. Vielleicht kann man sie "
    "ja zu etwas verwenden.");
  AddDetail( ({"froesche", "frosch"}),
    "Sehen kannst Du keinen Frosch, Du kannst nur ihr Quaken hoeren.");

  AddSound( DEFAULT_SOUND,
    "Es ist angenehm ruhig. Einige Voegel zwitschern, und hinter dem Schilf "
    "hoert man einige Froesche quaken. " );
  AddSound( ({"voegel", "vogel", "zwitschern"}),
    "Du hoerst das Zwitschern der Voegel.");
  AddSound( ({"frosch", "froesche", "quaken", "schilf"}),
    "Du hoerst das Quaken der Froesche.");
  AddSmell( DEFAULT_SMELL,
          "Es riecht nach frischem Gras." );

  AddCmd( ({"schneide", "schneid"}), "schneiden");

  AddItem( NPC "wlaeufer", REFRESH_DESTRUCT );

  AddExit( "osten",      "./lich-003" );
  AddExit( "suedwesten", "./lich-005");
}

int schneiden(string str)
{
  object waffe, ob;
  notify_fail("Was willst Du abschneiden?\n");
  if (!str) return 0;
  if( str == "liane" || str == "liane ab")
    notify_fail("Diese Liane ist zu dick zum abschneiden!\n");
  if( str == "seidenliane" || str == "seidenliane ab")
  { 
    if( waffe = TP->QueryProp(P_WEAPON) )
    {
      if( waffe->QueryProp(P_WEAPON_TYPE) == WT_SWORD && 
          waffe->QueryProp(P_WC) > 99 )
      {
        if( (ob=present(BOGENQUESTID,TP)) && !present(QUEST_LIANE,TP) &&
            !present(QUEST_BOGEN, TP) )
        {
          write(BS("Du schneidest ein Stueck Seidenliane ab, das Du sicher "
                   "als Sehne fuer Deinen Bogen verwenden kannst."));
          say(CAP_TPN + " schneidet ein Stueck Liane ab.\n"); 
          CLONE(OBJ "liane", TP);
          ob->quest_teil(BQ_LIANE);
        }
        else
          write("Die Liane vertrocknet sofort in Deiner Hand.\n");
      }
      else
        write(waffe->Name()+ " ist nicht scharf genug zum Abschneiden.\n");
    }
    else
      write("Du brauchst eine Waffe zum Abschneiden!\n");
    return 1;
  }
  return 0;
}

