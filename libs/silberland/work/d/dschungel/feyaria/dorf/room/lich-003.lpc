//  ***     Raum                     
//  ***     Azrael@SilberLand 
//  ***     lich-003.c
//  ***     ----- Pfad im Dschungel = Eingang zur Lichtung

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Weg im Dschungel" );
  SetProp(P_INT_LONG,
    "Du gehst auf dem Pfad entlang durch den Dschungel, die Sonne strahlt "
    "und ein warmer Wind weht Dir entgegen. Das Gras am Weg ist gruen und "
    "saftig und in einigen Pfuetzen hat sich Wasser angesammelt. Suedlich "
    "von Dir saeumt dichtes Schilf Deinen Weg, oestlich und westlich fuehrt "
    "der Pfad weiter. Im Norden behindern Gestruepp und Lianen das tiefere "
    "Eindringen in den Dschungel. Ein besonders schoener Baum faellt Dir auf.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN: TT_JUNGLE]));

  AddDetail( ({"baum"}),
    "Ein wunderschoener Baum steht hier neben dem Pfad. Du kannst "
    "weit oben ein Baumhaus erkennen.");
  AddDetail( ({"baumhaus"}),
    "Wenn Du das Baumhaus naeher betrachen willst, musst Du schon nach "
    "oben gehen.");  
  AddDetail( "sonne",
    "Die Sonne scheint angenehm von Himmel." );
  AddDetail( "himmel",
    "Ein wolkenfreier Himmel woelbt sich ueber Dir. " );
  AddDetail( ({"boden", "untergrund", "weg" }),
    "Der Boden wird zusehends feuchter und sumpfiger, es wird immer "
    "schwerer zu gehen, weil Deine Fuesse im weichen Untergrund einsinken." );
  AddDetail( ({"fuesse", "fuss", "schritt", "schritte"}),
    "Deine Fuesse sinken etwas in den weichen Untergrund ein.");
  AddDetail( "wind",
    "Der Wind traegt einen eigenartigen Geruch zu Dir her, er kommt von "
    "Sueden." );
  AddDetail( ({"schilf", "schilfwand", "wand" }),
    "Dicht zusammen stehen hier viele sehr hohe Schilfpflanzen, sie bilden "
    "eine regelrechte Wand. " );
  AddDetail( ({ "schilfpflanzen", "pflanzen" }),
    "Die Schilfwand ist hier undurchdringlich dicht." );
  AddDetail( "gras",
    "Das Gras ist saftig gruen, hie und da siehst Du eine kleine Pfuetze." );
  AddDetail( ({"pfuetzen", "wasser", "pfuetze" }),
    "Ab und zu hat sich hier Wasser in kleinen Pfuetzen angesammelt. Viele "
    "Wasserlaeufer tummeln sich hier auf dem Wasser." );
  AddDetail( ({"wasserlaeufer", "laeufer", "insekten" }),
    "Du wunderst Dich, wie diese kleinen, zierlichen Insekten es schaffen, auf "
    "dem Wasser zu bleiben ohne unterzugehen." );
  AddDetail( ({"gestruepp", "lianen", "liane"}),
    "Das Gestruepp ist so dicht, dass Du schon ein Machete brauchst, um Dir "
    "hier einen Weg zu bahnen.");
  AddDetail( ({"pfad", "weg"}),
    "Der Pfad fuehrt von West nach Ost, wenn Du in eine andere Richtung "
    "willst, musst Du Dir schon selber einen Weg bahnen.");
  AddDetail(({"machete"}),
    "Eine Machete wirst Du wohl brauchen, um hier weiter nach Norden zu "
    "kommen.");
  AddDetail( ({"dschungel"}),
    "Der Dschungel wird nach Norden fast undurchdringlich dicht, nach Sueden "
    "hingegen geht er in eine feuchte Schilflandschaft ueber.");
  AddDetail( ({"schilflandschaft"}),
    "Dort waechst natuerlich fast nur Schilf, deshalb dieser Name.");
  AddDetail( ({"froesche", "frosch"}),
    "Sehen kannst Du keinen Frosch, Du kannst nur ihr Quaken hoeren.");

  AddSound( DEFAULT_SOUND,
    "Es ist angenehm ruhig. Einige Voegel zwitschern, und hinter dem Schilf "
    "hoert man einige Froesche quaken. " );
  AddSound( ({"voegel", "vogel", "zwitschern"}),
    "Du hoerst das Zwitschern der Voegel.");
  AddSound( ({"frosch", "froesche", "quaken", "schilf"}),
    "Du hoerst das Quaken der Froesche.");
  
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischem Gras." );
  AddSmell( "geruch",
    "Vom Schilf her kommt ein komischer Geruch, was wohl dahinter ist? " );

  AddCmd ( ({"bahne", "bahne"}), "machete" );

  AddExit( "osten",   "./lich-002" );
  AddExit( "westen",  "./lich-004" );

}

int machete (string str)
{
  object ob;
  notify_fail ( "Wen oder was willst Du schlagen?\n" );
  if ( str == "weg" || str == "weg durch gestruepp" ||
        str == "weg durch dschungel" )
  { 
    if( ob = deep_present( "machete", TP) )
    {
      if( ob->QueryProp(P_WIELDED) == TP )
      {       
         write ( "Du bahnst einen Weg nach Norden durch das Gestruepp.\n" );
         TP->move ( ROOM "lich-016", M_GO, "einen Weg durch das Gestruepp", 
             "bahnt" );
         return 1;
      }
      notify_fail("Du solltes die Machete zuecken.\n");
    }
    notify_fail("Du hast ja gar keine Machete!\n");
  }
  return 0; 
}

