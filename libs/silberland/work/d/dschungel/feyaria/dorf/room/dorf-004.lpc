//  ***     Raum                        
//  ***     Azrael@Silberland 
//  ***     dorf-004.c                
//  ***     ----- Steg im Pfahldorf

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem schmalen Steg" );
  SetProp(P_INT_LONG,
     "Der Steg ist nur einen halben Schritt breit und ohne Gelaender ist es "
     "ein Balanceakt, der Deine ganze Konzentration beansprucht. Vor Dir in "
     "suedlicher Richtung wird er etwas breiter, dort siehst Du auch den "
     "Eingang zu einem Haus. Das Wasser neben Dir wird zusehends tiefer; "
     "kleine Luftblasen steigen an die Oberflaeche. Nach Norden kannst Du "
     "zum Ufer zurueck.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist sehr schmal und Du musst aufpassen, nicht ins Wasser zu "
    "fallen."  );
  AddDetail( ({ "wasser", "wasseroberflaeche", "oberflaeche", "sumpfwasser" }),
    "Das Wasser ist sauberer als am Ufer, aber auch tiefer. Luftblasen "
    "steigen darin auf, hier scheint eine warme Quelle zu sein." );
  AddDetail( "ufer", 
    "Das Ufer liegt noerdlich von Dir." );
  AddDetail(({ "luftblasen", "blasen", "quelle" }),
    "Immer wieder steigen Luftblasen an die Wasseroberflaeche, wohl aufgrund "
    "einer warmen Quelle." );
  AddDetail( "gelaender",
    "Oh ja, das wuerdest Du Dir wuenschen, dann waere das Gehen hier um "
    "einiges leichter." );
  AddDetail( ({ "balanceakt", "gehen" }),
    "Der Steg ist so schmal, dass Du hoellisch aufpassen musst, nicht ins "
    "modrige Sumpfwasser zu fallen. Ein Gelaender waere sehr hilfreich." );
  AddDetail( "konzentration",
    "Nur mit hoechster Konzentration schaffst Du es ueber den schmalen Steg "
    "zu gehen. Wenn das der einzige Zugang zum Dorf ist, so ist das die "
    "beste Verteidigung." );
  AddDetail( "verteidigung",
    "Hier kann immer nur einer hinter dem anderen gehen, damit kann man die "
    "Siedlung mit wenigen Waechtern einfach verteidigen." );
  AddDetail( "zugang",
    "Der Steg scheint der einzige Zugang zum Elfendorf zu sein." );
  AddDetail( ({"haus", "eingang" }),
    "Wenn Du Dich nicht total irrst, dann ist das ein Wachhaus, von dem aus "
    "man leicht den Steg und somit den Zugang zum Dorf kontrollieren kann." );
  AddDetail( ({ "dorf", "elfendorf", "siedlung" }),
    "Der Steg fuehrt weiter nach Sueden ins Elfendorf." );
  AddDetail( ({"elf", "elfen", "dschungelelfen"}),
    "In diesem Dorf leben wohl die Dschungelelfen!");
  AddDetail( "schritt",
    "Der Steg ist hier nur einen halben Schritt breit." );
  AddDetail( "wachhaus",
    "Es liegt oestlich des Stegs." ); 
  AddDetail( "waechter",
    "Die Waechter koennen den Steg einfach und problemlos verteidigen." );

  AddSound( DEFAULT_SOUND,
    "Es ist ruhig, nur entfernt hoerst Du einige Froesche quaken." );

  AddSmell( DEFAULT_SMELL,
    "Frische Luft weht Dir entgegen und Du atmest tief, erleichtert, wieder "
    "frei atmen zu koennen." );

  AddExit( "norden",  "./dorf-001");
  AddExit ("sueden", "./dorf-005");

}

