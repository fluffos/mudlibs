//  ***     Raum - sollte ein Laden werden hihihi, nur wann? - noch viel Arbeit
//  ***     Azrael@SilberLand
//  ***     dorf-5a1.c 
//  ***     ----- Bauschhaendler

inherit "std/laden";

#include <laden.h>
#include "../def.h"

void create()
{
  ::create();
  
  last=wantto=mymoney=30000;

  SetProp(P_INT_SHORT, "In einem Bauschladen" );
  SetProp(P_INT_LONG,
    "Berge von Bauschballen liegen hier gestapelt in den Ecken, links vom "
    "Eingang steht ein Ladentisch, dahinter ist ein Regal, in dem "
    "verschiedene Bauschstoffe in allen Farben und in jeder Staerke auf "
    "Rollen aufgewickelt liegen. An der anderen Wand steht etwas, das einem "
    "Kasten aehnelt. Raus kommst Du nach Norden und im Sueden kannst Du die "
    "Tuere zu einem Hinterzimmer erkennen, daneben steht eine Truhe. Im Westen "
    "scheint ein weiterer Verkaufsraum zu sein.");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN: TT_HOUSE]));

  SetStorageRoom (ROOM "bausch_store");
  SetProp(P_SPECIAL_SHOP, ([P_ARMOUR_TYPE: "Die Schneiderin sagt: Tut mir "
      "leid, ich kaufe nur Kleidung!\n"]) );
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+ SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "schneiderin");
  SetProp(P_SHOPKEEPER_NAME, "die Schneiderin");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);

  AddDetail( ({"westen",}),
      "Im Westen scheint ein weiterer Verkaufsraum zu sein.");
  AddDetail( ({"verkaufsraum"}),
      "Was dort wohl verkauft wird? Sicher auch etwas, das man anziehen kann.");
  AddDetail( "berge", 
    "Wahre Berge von Bauschballen liegen in den Ecken des Ladens "
    "aufgestapelt." );
  AddDetail( ({ "bauschballen", "ballen" }),
    "Grosse Ballen aus rohem unbearbeitetem Bausch liegen zusammengebunden " 
    "in den Ecken des Ladens." );
  AddDetail( "bausch",
    "Bausch ist das Material, aus dem Elfen fast alles machen, was sie an "
    "Gebrauchsartikeln brauchen." );
  AddDetail( "material",
    "Aus den watteaehnlichen Samen der Bauschbinse fertigen Elfen allerlei "
    "verschiedene Artikel. Von Kleidungsstuecken ueber Tragetaschen bis hin "
    "zu Tapeten fuer ihre Behausungen." );
  AddDetail( ({ "tragetaschen", "taschen" }),
    "Taschen, die aus Bausch gemacht sind, sind garantiert wasserfest." );
  AddDetail ("behausungen", 
    "Wenn Du Dich hier im Dorf ein bisschen umschaust, dann wirst Du die "
    "Behausungen der Elfen schon noch kennenlernen." );
   AddDetail( "dorf",
     "Das Dorf ist viel groesser, als Du urspruenglich angenommen hast." );
  AddDetail( ({ "gebrauchsartikel", "artikel" }),
    "Aus Bausch kann man die verschiedensten praktischen Artikel fuer den "
    "taeglichen Gebrauch herstellen.");
  AddDetail( "tapeten",
    "Sogar Tapeten fertigen die Elfen aus Bausch."  );
  AddDetail( "eingang",
    "Links vom Eingang bzw. Ausgang steht ein Ladentisch und rechts ein "
    "Kasten, der bis an die Decke reicht." );
  AddDetail( ({ "ladentisch", "tisch" }),
    "Er steht links vom Eingang. Dahinter ist ein Regal, auf dem "
    "verschiedene Stoffrollen gelagert sind." );
  AddDetail( "ausgang",
    "Er ist in Richtung Norden, ebenso wie der Eingang - logisch eigentlich." );
  AddDetail( "ecken",
    "Die Ecken des Ladens sind bis zur Decke vollgestapelt mit Bauschballen." );
  AddDetail( ({ "kleider", "kleidung", "kleidungsstuecke" }),
    "Elfen stellen fast ihre gesamte Kleidung aus Bausch her, weil es leicht "
    "ist, billig und sogar so wasserdicht ist, dass es als Schwimmweste "
    "verwendet werden kann." );
  AddDetail( ({ "schwimmweste", "weste" }),
    "Wenn Du nicht schwimmen kannst ist sowas ganz nuetzlich, nicht?" );
  AddDetail( ({"samen", "bauschsamen" }),
    "Diese watteaehnlichen Samen der Bauschbinse koennen zu einem "
    "widerstandsfaehigen Material gesponnen und verwoben werden." );
  AddDetail( "laden",
    "Du befindest Dich gerade darin. Hier ist kann man alles kaufen, was "
    "einem Bauschliebhaber gefaellt." );
  AddDetail( ({"liebhaber", "bauschliebhaber" }),
    "Besonders Elfen und unter ihnen die Dschungelelfen sind grosse Bauschliebhaber.");
  AddDetail( ({ "elfen", "dschungelelfen" }),
    "Die Bewohner dieses  Dorfes, die Dschungelelfen, tragen am liebsten Kleider "
    "aus Bausch." );
  AddDetail( ({"bauschbinse", "binse" }),
    "Eine unkomplizierte Pflanze, die besonders in feucht-warmem Klima sehr "
    "gut gedeiht." );
  AddDetail( ({"pflanze", "gebiete", "klima" }),
    "Die Bauschbinse waechst besonders bei in feucht-warmem Klima und in "
    "sumpfigen Gebieten." );
  AddDetail( ({"gebiet", "gebiete" }),
    "Man findet die Bauschpflanzen besonders haeufig in sumpfigen, feuchten "
    "Gebieten." );
  AddDetail( ({ "bauschpflanzen", "pflanzen" }),
    "Sie wachsen am besten in sumpfigen, feuchten Gebieten." );
  AddDetail( "regal",
    "Vom Boden bis zur Decke reicht dieses Regal, das kleine, aber tiefe "
    "Faecher hat, in denen verschiedenste Stoffrollen liegen." );
  AddDetail( "faecher",
    "Da liegen Stoffrollen in allen Farben." );
  AddDetail( ({"rollen", "stoffrollen" }),
    "Auf ihnen sind verschiedene Stoffe in allen moeglichen Farben "
    "aufgerollt.");
  AddDetail( ({"stoff", "stoffe", "bauschstoffe" }),
    "Bauschstoffe in allen Staerken und Farben stehen hier zur Auswahl. "
    "Sicher kann man sich hier auch Kleidung und diverse andere Artikel "
    "anfertigen lassen." );
  AddDetail( "auswahl",
    "Die Auswahl an Stoffen ist wirklich gewaltig hier." );
  AddDetail( "farben",
    "Die Stoffe sind bunt und in allen Farben erhaeltlich." );
  AddDetail( ({"staerke", "staerken" }),
    "Stoffe in jeder Staerke liegen im Regal, aus denen ein guter Schneider " 
    "sicher einmalige Kleider und Waffenroecke machen koennte." );
  AddDetail( "boden",
    "Der Boden ist aus Holz. Ueberall liegen flauschige Bauschsamen herum, " 
    "die bei jedem Schritt herumgewirbelt werden und um Deine Fuesse tanzen." );
  AddDetail( "fuesse",
    "Immer der Nase nach, dann kannst Du sie gar nicht verfehlen." );
  AddDetail( ({ "holz", "baumstaemme", "staemme" }),
    "Hoelzerne Baumstaemme bilden den Boden. So ist es im ganzen Dorf." );
  AddDetail( ({ "tuer", "tuere" }),
    "Durch sie gelangt man in ein Hinterzimmer." );
  AddDetail( ({ "hinterzimmer", "zimmer" }),
    "Da scheint eine Schneiderei oder soetwas zu sein." );
  AddDetail( "schneiderei",
    "Die befindet sich wohl in diesem Hinterzimmer." );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind aus geflochtenten Aesten, rechts steht ein Kasten, der "
    "bis zur Decke reicht." );
  AddDetail( "decke",
    "Die Decke besteht, wie die Waende, aus geflochtenen Aesten und schliesst "
    "sich kuppelfoermig ueber Dir." );
  AddDetail( "aeste",
    "Verschiedene Aeste sind zu Waenden und Decke zusammengeflochten." );
  AddDetail( ({"truhe"}),
    "Die Truhe steht einfach nur herum.");
  AddDetail ( "kasten",
    "Im Kasten ist sicher auch Bausch drinnen.");
  
  AddSound( DEFAULT_SOUND,
    "Hier hoert man eigentlich nichts besonderes.");
        
  AddSmell( DEFAULT_SMELL,
    "Es riecht sonderbar. Dauernd steigen Dir juckend Bauschfasern in die "
    "Nase." );

  AddExit( "norden",   "./dorf-018" );
  AddExit( "westen",  "/d/dschungel/aaliyah/unterwaesche/room/laden");

  AddItem( NPC "schneiderin", REFRESH_DESTRUCT );
}


varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if( ob->QueryMaterialGroup(MATGROUP_METAL)>10  )
  {
    write("Die Schneiderin sagt entruestet: Ich kauf doch keine Metallsachen!\n");
    return 1;
  }
  return ::do_sell(ob, force, prefix, limit);
}

