//  Wasserlaeufer

inherit "std/npc";

#include "../def.h"
#include "../quest.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, "Ein Wasserlaeufer laeuft auf dem Wasser herum" );
  SetProp( P_LONG, 
    "Ein kleiner Wasserlaeufer, der sich geschickt mit seinen sechs Beinen " 
    "auf der Wasseroberflaeche einer Pfuetze dahinbewegt. Er ist so klein, "
    "dass man ihn sicher leicht fangen kann.");

  SetProp( P_NAME, "Wasserlaeufer");
  SetProp( P_GENDER, MALE );
  SetProp( P_RACE, "Insekt");

  AddId ( ({ "wasserlaeufer", "laeufer", "insekt" }) );

  create_default_npc (4);

  SetProp( P_HANDS, ({" mit seinen sechs Beinen", 40, DT_BLUDGEON }));
  SetProp( P_ALIGN, 0);
  SetProp( P_SIZE, 10);
  SetProp( P_MAX_HANDS, 6);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wasserlaeufer kann @WEN gar nicht tragen!\n" }) );

  SetProp( P_DIE_MSG, " streckt seine Beine von sich und verreckt.\n");
  SetProp( P_KILL_MSG, 
    "Klein aber fein, hmm...hast mich wohl unterschaetzt, wie?\n" );
  
  SetChats(2, ({
    "Der Wasserlaeufer laeuft auf dem Wasser herum.\n" ,
     }) );
  SetAttackChats(6, ({
    "Der Wasserlaeufer springt wild auf dem Wasser herum.\n" ,
    }) );
  AddCmd( ({"fange", "fang"}), "fangen");
}

int fangen( string str)
{
  object ob;
  notify_fail("Wen willst Du fangen?\n");
  if( !str) return 0;
  if( id(str) )
  {
    if( (ob=present(BOGENQUESTID, TP)) && !present(QUEST_SFEDER, TP) && 
        !present(QUEST_PFEIL, TP) && !present(QUEST_FUTTER, TP) )
    {
      if( !random(5) )
      {
        write("Geschickt faengst Du den Wasserlaeufer und steckst ihn ein.\n");
        tell_room(MENV, CAP_TPN+ " faengt einen Wasserlaeufer.\n", ({TP}) );
        CLONE( OBJ "futter", TP);
        ob->quest_teil(BQ_FUTTER);
        call_out("remove", 0,1);
      }
      else
        write("Im letzen Moment entwischt Dir der Wasserlaeufer!\n");
        tell_room(MENV, CAP_TPN+ " versucht, den Wasserlaeufer zu fangen.\n", ({TP}) );
    }
    else
    {
      write("Du bist zu ungeschickt, den Wasserlaeufer zu fangen!\n");
      tell_room(MENV, CAP_TPN+ " versucht, den Wasserlaeufer zu fangen.\n", ({TP}) );
    }
    return 1;
  }
  return 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch && find_call_out("touch")==-1 )
    call_out("touch",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void touch()
{
  tell_room(MENV, "Der Wasserlaeufer zuckt zusammen.\n");
}


