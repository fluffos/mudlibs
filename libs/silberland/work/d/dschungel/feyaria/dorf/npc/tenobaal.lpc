//  Tenobaal, der Bognermeister

inherit "std/repair";

#include "../def.h"

void init()
{
  ::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  object bogen;
  
  if (!is_clone(this_object())) return;

  ::create();

  SetProp( P_SHORT, "Tenobaal, der Bognermeister");
  SetProp( P_LONG, 
    "Tenobaal ist ein besonders grosser Elf, dessen weisses Haar ihm bis auf "
    "die Schultern faellt. Seine braunen Augen strahlen Dich freundlich an. "
    "Nach allem was Du bisher ueber ihn gehoert hast, ist er der beste "
    "Bogenbauer und versteht sich auch selbst hervorragend im Umgang mit "
    "Pfeil und Bogen. Sicher kann er Dir jede Frage ueber das "
    "Bogenschiessen beantworten.");

  AddId ( ({ "tenobaal","bognermeister","bogner", "elf", "ELF" }) );

  create_default_npc(33);

  SetProp( P_NAME, "Tenobaal"); 
  SetProp( P_GENDER, MALE);
  SetProp( P_ARTICLE, 0);
  SetProp( P_RACE, "Elf");
  SetProp( P_ALIGN, 777);
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({" mit Pfeil und Bogen", 300, DT_PIERCE}) );
  SetProp( P_SIZE, 205);
  SetAttribute( A_DEX, 50);

  SetProp( P_DIE_MSG,
    " stirbt einen elfischen Heldentod.\n");
  SetProp( P_KILL_MSG,
    "Niemand besiegt den besten Bogenschuetzen weit und breit!!!\n" );
  SetProp( P_MURDER_MSG,
    "Jetzt kann ich mich endlich mit Lars und dem Tod im Bogenschiessen "
    "messen, %s!");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Tenobaal sagt: Damit kann ich nichts anfangen.\n" }) );

  SetProp( P_LOG_INFO,"feyaria/tenobaal");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Bogenmachen ist mein Leben.\n",
    "sagt: Aehm...dazu kann ich ueberhaupt nichts sagen.\n",
    "meint: Frag doch die Goetter, sie wissen ja angeblich alles.\n",
    "seufzt: Leider bin ich nicht allwissend.\n",
    "schuettelt nachdenklich den Kopf.\n",
    "wackelt verneinend mit den Ohren.\n",
    "grinst verlegen.\n" }) );
  AddLibrary( NPC "elfendorf.lib",1);

  AddInfo( ({"elfen", "schuetzen", "bogenschuetzen"}),
    "prahlt: Wir Elfen sind die besten Bogenschuetzen im ganzen SilberLand.\n");
  AddInfo( ({"turnier", "teilnahme"}),
    "Fuer das Turnier muss jeder Teilnehmer seinen eigenen Bogen "
    "mitbringen. Und am besten verwendet man auch einen selbstgebauten "
    "Pfeil. Naeheres steht auf dem Teilnahmezettel.", "erklaert: " );
  AddInfo( ({"zettel", "teilnahmezettel"}),
    "Den Teilnahmezettel bekommst Du beim Haendler.", "sagt: ");
  AddInfo( "bogen",
    "Fuer einen Bogen brauchst Du einen biegsamen Holzstock und eine "
    "Seidenliane, die Du als Bogensehne verwenden kannst.", "sagt: " );
  AddInfo( ({"holz", "holzstock", "stock"}),
    "Am besten eignet sich TicToc-Holz fuer einen Bogen.", 
    "vertraut Dir an: ");
  AddInfo( ({"tictoc", "tictoc-holz", "tictocholz"}),
    "Du erkennst es sehr leicht, denn wenn man an den Baum klopft, "
    "hoert man ein deutliches 'Tic-Toc'.", "erzaehlt: ");
  AddInfo( ({"liane", "seidenliane", "sehne", "bogensehne"}),
    "Nur Seidenlianen eigenen sich als Bogensehnen, Du findest sie an "
    "vielen Stellen im Dschungel.", "sagt: ");
  AddInfo( ({"pfeil", "pfeile", "pfeilen"}),
    "Fuer einen Pfeil brauchst Du eigentlich nur einen schoenen, geraden "
    "Ast, eine Pfeilspitze und Federn.", "sagt: ");
  AddInfo( ({"ast", "aeste"}),
    "Am besten eignen sich die Aeste von Blutulmen.", "erklaert: ");
  AddInfo( ({"blutulmen", "blutulme"}),
    "Mit den Blutulmen sollte man vorsichtig umgehen, sie geben nur sehr "
    "ungern Aeste her.", "fluestert Dir zu: ", 1);
  AddInfo( ({"ulme", "ulmen"}),
    "Eine Blutulme muss es sein! Ein Pfeil aus normalen Ulmenholz ist auch "
    "nicht besser als einer aus einem anderen Holz.", "sagt: ");
  AddInfo( ({"spitze", "pfeilspitze"}),
    "Eine Pfeilspitze kannst Du sicher vom Schmied hier im Dorf bekommen.",
    "sagt: ");
  AddInfo( ({"federn", "feder"}),
    "Die richtigen Federn sind besonders wichtig! Hier muss jeder seine "
    "eigene Wahl treffen.", "fluestert Dir zu: ",1);
  AddInfo( ({"dschungel"}),
    "Im Dschungel findet man viele interessante Sachen, aber es ist auch sehr "
    "gefaehrlich dort.", "erzaehlt: ");  
  AddInfo( ({"schmied", "zwergenschmied"}),
    "Der Schmied hat seinen Laden am Ostende des Dorfes. Seine Huette ist "
    "sehr leicht an dem vielen Rauch zu erkennen, der aus dem Kamin kommt.",
    "sagt: ");
  AddInfo( ({"bogner", "bogenmacher"}),
    "Bei aller Bescheidenheit, aber man nennt mich den besten "
    "Bogner weit und breit.", "prahlt: ");
  AddInfo( ({"phoenix"}),
    "Du glaubst mir wohl nicht, das ich schon einen Phoenix erlegt habe?",
    "sagt erstaunt: ");
  AddInfo( ({"tenobaal"}),
     "deutet auf sich und nickt."); 
  
  SetProp(P_NOMAGIC, 50);
  SetProp( P_SPELLRATE,40);
  AddSpell( 5, 550,
    "Tenobaal schiesst einen Pfeil auf Dich.\n",
    "Tenobaal schiesst einen Pfeil auf @WEN.\n", 
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]) );
  AddSpell(1, 900,
    "Tenobaal schleudert einen Feuerball auf Dich.\n",
    "Tenobbal schleudert einen Feuerball auf @WEN.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE: 1]) );
 
  SetChats(5, ({
    "Tenobaal fragt: Brauchst Du einen Bogen?\n",
    "Tenobaal sagt: Na, wer bist Du denn?\n",
    "Tenobaal bespannt einen Bogen und stellt ihn zu den anderen.\n",
    "Tenobaal spannt seinen Bogen, zielt auf Dich. Dann schiesst "
       + "er knapp an\nDir vorbei an die Wand.\n",
    "Tenobaal sagt stolz: Mit dem Bogen da hab ich schon einen Phoenix erlegt.\n",
    "Tenobaal singt ein froehliches, aber Dir leider unverstaendliches Lied.\n",
    "Tenobaal zieht eine Augenbraue hoch und sagt: Faszinierend!\n",
    "Tenobaal zeigt Dir einen besonders schoen verzierten Bogen.\n"
     }) );

  SUID;

  CLONEME( ARMOUR "b_weste");
  if (!random(3) ) CLONEME( ARMOUR "b_hose");
  command("trage alles");
  if( !random(7) && 
      objectp(bogen=find_object(ITEMD)->GenerateUnique(WEAPON "tbogen",1)) )
    bogen->move(TO);
  else 
    CLONEME( WEAPON "kriegsbogen");
  command( "zuecke bogen");
  if( !random(5) )
    CLONEME("/p/magic/msack");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "tenobaal",
    ctime()+": Tenobaal hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

void die(int poisondeath)
{
  write_file(LOG "tenobaal",
    ctime()+": "+CAP(getuid(TP))+" killt Tenobaal.\n");
  ::die(poisondeath);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Warum machst Du so boese Sachen, "+TPN+"?");
}

void intim()
{
  if( TP->QueryProp(P_RACE)!="Zwerg")
  {
    if( TP->QueryProp(P_GENDER) == QueryProp(P_GENDER) )
      command_me("sag Bist Du vielleicht anders rum, "+TPN+"?");
    else
    {
      write(Name(WER,1)+" schmiegt sich an Dir an und fluestert: Du bist "
        "lieb, "+TPN+".\n");
      tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an und "
        "fluestert etwas.\n");
    }
  }
  else
    command_me("sag Lass das, Du Zwerg!");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+".\n", ({TP, TO}) );
}

int rep_auswahl(object ob)
{
  if( ob->QueryProp(P_ARMOUR_TYPE) )
  {
    write("Tenobaal sagt: Ich repariere keine Ruestungen!\n");
    return 0;
  }
  if( ob->QueryProp(P_WEAPON_TYPE) == WT_BOW )
    return 1;
  if( ob->QueryMaterialGroup(MATGROUP_WOOD) > 75 )
    return 1; 
  write("Tenobaal sagt: Ich repariere nur Boegen und andere Holzwaffen.\n");
  return 0;
}


