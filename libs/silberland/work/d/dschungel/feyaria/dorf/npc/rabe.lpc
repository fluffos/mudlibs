//  ein schwarzer Rabe

inherit "std/mnpc";

#include "../def.h"
#include "../quest.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, "Ein schwarzer Rabe");
  SetProp( P_LONG, 
    "Ein schwarzer Rabe sitzt auf dem Boden und starrt Dich mit leblosen " 
    "Augen an. Sein Schnabel sieht sehr scharf und spitz aus. Er scheint "
    "sehr hungrig zu sein." );
  AddDetail( "schnabel",
    "Der Schnabel ist ausgesprochen spitz." );
  AddId ("rabe");

  create_default_npc (10);

  SetProp( P_NAME, "Rabe");
  SetProp( P_GENDER, MALE);
  SetProp( P_RACE, "Vogel" );
  SetProp( P_ALIGN, -200 );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_HANDS, ({" mit seinem spitzen Schnabel", 100, DT_RIP }));
  SetProp( P_SIZE, 30);

  SetProp (P_DIE_MSG,
    " zuckt kurz mit den Fluegeln und wird fortan nie mehr kraechzen.\n" );
  SetProp(P_NOCORPSE, 1);
  SetProp( P_MURDER_MSG,
    "Ich werde in Deinen Traeumen weiterkraechzen, %s!" );

  SetProp( P_MSGIN, "flattert herein");
  SetProp( P_MSGOUT, "flattert");
  SetProp( P_MMSGIN, "flattert herein");
  SetProp( P_MMSGOUT, "flattert weit fort");
  SetProp( P_MNPC_AREA, (ROOM "lich-01") );
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp( P_MNPC_DEFAULTROOM, ROOM "lich-017");
  SetProp( P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Rabe will gefuettert werden!\n" }) );

  AddInfo( DEFAULT_INFO,
    "kraechzt nur und flattert mit den Fluegeln.\n " );

  SetChats(3, ({
    "Der Rabe flattert aufgeregt mit den Fluegeln.\n",
    "Der Rabe funkelt Dich aus seinen schwarzen Augen an.\n",
    "Der Rabe kraechzt markerschuetternd.\n",
    "Der Rabe klappert drohend mit dem Schnabel.\n",
    "Der Rabe huepft ungeduldig von einem Bein aufs andere.\n",
    "Der Rabe zuckt nervoes mit dem Kopf.\n",
    "Der Rabe schaut Dich hungrig an.\n",
    "Der Rabe findet hier nichts zu fressen.\n" }) );

  SetAttackChats(3, ({
    "Der Rabe fliegt auf und hackt nach Deinen Augen.\n",
    "Der Rabe haut seine Krallen in Deine Schulter.\n" }) );

  SUID;

  AddCmd( ({"fuetter", "fuettere"}), "fuettern");
}

int fuettern(string str)
{
  object futter, quest;
  notify_fail("Wen willst Du fuettern?\n");
  if( !str) return 0;
  if( str == "rabe" || str == "rabe mit wasserlaeufer" ||
      str == "raben" || str == "raben mit wasserlaeufer")
  {
    if( futter = present(QUEST_FUTTER, TP) )
    {
      if( (quest=present( BOGENQUESTID, TP)) && !present(QUEST_SFEDER, TP) &&
          !present(QUEST_PFEIL) )
      {
        write("Du fuetterst den Raben und der Rabe fliegt gesaettigt weg.\n"
          "Eine schwarze Rabenfeder segelt vom Himmel direkt in Deine Hand.\n");
        tell_room(MENV, CAP_TPN + " fuettert den Raben, worauf dieser gesaettigt "
                    "wegfliegt.\n", ({TP}) );
        CLONE(OBJ "schfeder", TP);
        quest->quest_teil(BQ_SFEDER);
        call_out("remove",0,1);
      }
      else
        write("Du fuetterst den Raben.\n");
      futter->remove();
    }
    else
      write("Aber Du hast ja gar nichts zum fuettern!\n");
    return 1;
  }
  return 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch && random(2) && find_call_out("touch")==-1 )
    call_out("touch",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void touch()
{
  tell_room(MENV, "Der Rabe flattert kraechzend auf.\n");
}


