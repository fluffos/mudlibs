// Elfenwaechter
// 1997-08-19 Feyaria@SilberLand


inherit "std/mnpc";
inherit "std/inpc/select";

#include <inpc.h>
#include "../def.h"

void init()
{
  mnpc::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  string elf_hands, elf_long;

  if (!is_clone(this_object())) return;
  mnpc::create();

  if( random(100) > 50 )
  {
    SetProp( P_GENDER, MALE);
    SetProp( P_SIZE, 205);
    SetProp( P_NAME, "Elfenwaechter");
    elf_hands = " mit seinen Elfenhaenden";
    AddId ( ({"waechter","elf","elfenwaechter"}) );
    AddInfo( ({"waechter", "elfenwaechter"}), "nickt.\n");
  }
  else
  {
    SetProp( P_GENDER, FEMALE);
    SetProp( P_SIZE, 190);
    SetProp( P_NAME, "Elfenwaechterin");
    elf_hands = " mit ihren Elfenhaenden";
    AddId ( ({"waechterin","elfe","elfenwaechterin", "elfin"}) );
    AddInfo( ({"waechterin", "elfenwaechterin"}), "nickt.\n");
  }

  SetProp( P_SHORT, Name(WER,0)+" bewacht das Elfendorf");
  elf_long= Name(WER,1)+ ". "+ CAP(QueryPronoun(WER)) +" ist gross gewachsen, "
    "hat langes weiss-blondes Haar und traegt nur eine leichte Ruestung. ";  

  AddId ( ({"ELF", "Schwertkaempfer", "Speerkaempfer"}) );
  create_default_npc(20);

  SetProp( P_RACE, "Elf");
  SetProp( P_ALIGN, 500);
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({elf_hands, 150, DT_BLUDGEON}) );

  SetProp( P_MSGIN, "kommt wachsam an");
  SetProp( P_MSGOUT, "geht wachsam");
  SetProp( P_MMSGIN, "beginnt hier "+QPP(MALE,WEN)+" Wachdienst");
  SetProp( P_MMSGOUT, "beendet hier "+QPP(MALE,WEN)+" Wachdienst");
  SetProp( P_MNPC_AREA, (ROOM) );
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp( P_MNPC_DEFAULTROOM, ROOM "dorf-1a1");
  SetProp( P_MNPC_FLAGS, MOV_INDOORS+ MOV_OUTDOORS+ MOV_MOVES+ MOV_BACKWARDS);

  SetProp( P_DIE_MSG,
    " spielt noch ein letztes Lied auf "+QPP(FEMALE,WEM)+
    " Floete und stirbt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" sagt: Ich bin nicht bestechlich!\n" }) );

  SetProp(P_LOG_INFO,"feyaria/elfendorf");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Dazu kann ich Dir ueberhaupt nichts sagen.\n",
    "sagt: Frag doch am Dorfplatz nach, da kann Dir sicher jemand helfen.\n",
    "fragt: Ich versteh nicht ganz was Du meinst. \n",
    "sagt: Ich bin nur ein Waechter, das weiss ich wirklich nicht.\n",
    "murmelt: Ich bewache das Dorf. Ein schwieriger Job.\n" }) );
  AddLibrary( NPC "elfendorf.lib",1);

  AddInfo( ({"waffe", "waffen", "degen", "rapier", "florett", "bogen",
             "jagdbogen", "dolch", "machete"}),
    "Meine Waffen kaufe ich immer bei Tenobaal.", "sagt: ");

  SetProp(P_NOMAGIC, 20);
  SetProp(P_SPELLRATE, 30);
  AddSpell( 9,100,
    Name(WER,1)+" verletzt Dich boes an der Schulter.\n",
    Name(WER,1)+" verletzt @WEN boes an der Schulter.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]) );
  AddSpell(1,500,
    Name(WER,1)+" summt eine Melodie und ein Blitz faehrt auf Dich hernieder.\n",
    Name(WER,1)+" summt eine Melodie und ein Blitz faehrt auf @WEN hernieder.\n",
    DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]) );
 
  SetChats( 2, ({
    Name(WER,1)+" fragt: Wer bist Du, was willst Du und wohin gehst Du?\n",
    Name(WER,1)+" sagt: Sag mir Deinen Namen und Dein Begehr !\n",
    Name(WER,1)+" beobachtet wachsam die Gegend.\n",
    Name(WER,1)+" fragt: Wie hast Du eigentlich hierher gefunden?\n",
    Name(WER,1)+" bohrt gelangweilt in der Nase.\n",
    Name(WER,1)+" geht nervoes auf und ab.\n"                          
    }) );

  SUID;

  switch( random(10) )
  {
    case 0:
      CLONEME( "/p/weapon/sword/machete");
      command( "zuecke machete");
      elf_long+= CAP(QueryPronoun(WER))+" traegt eine Machete in der Hand";
      break;
    case 1:
      CLONEME( "/p/weapon/sword/degen");
      command( "zuecke degen");
      elf_long+=CAP(QueryPronoun(WER))+ " traegt einen Degen in der Hand";
      break;
    case 2:
      CLONEME ( "/p/weapon/sword/florett" );
      command ( "zuecke florett" );
      elf_long+=CAP(QueryPronoun(WER))+ " traegt ein Florett in der Hand";
      break;
    case 3:
      CLONEME( "/p/weapon/sword/rapier");
      command( "zuecke rapier");
      elf_long+=CAP(QueryPronoun(WER))+ " traegt ein Rapier in der Hand";
      break;
    case 4..5:
      CLONEME( "/p/weapon/spear/jagdspeer");
      command( "zuecke speer");
      elf_long+=CAP(QueryPronoun(WER))+ " traegt einen Jagdspeer in der Hand";
      break;
    case 6..7:
      CLONEME( "/p/weapon/spear/jagdspiess");
      command( "zuecke spiess");
      elf_long+=CAP(QueryPronoun(WER))+ " traegt einen Jagdspiess in der Hand";
      break;
    default: 
      CLONEME( "/d/kristallwald/sargola/dorf/weapon/bogen");
      command( "zuecke bogen");
      elf_long+=CAP(QueryPronoun(WER))+ " traegt einen Bogen in der Hand";
  }
  if( !random(3) )
  {
    CLONEME ( WEAPON "dolch");
    elf_long+=" und in "+ QueryPossPronoun(MALE,WEM) + 
        " Guertel steckt ein Dolch.";
  }
  else
    elf_long+= ".";
  SetProp(P_LONG, elf_long);
  if (QueryProp(P_GENDER) == FEMALE ) 
  {
    if( !random(20) )
    {
      CLONEME( ARMOUR "elfenkettenhemd");
    }
    else if( random(2) )
    {
      CLONEME( ARMOUR "b_kleid");
    }
    else
    {
      CLONEME( ARMOUR_ELF "rock");
      CLONEME( ARMOUR "bluse");
    }
    if(!random(2) ) 
      CLONEME(ARMOUR_ELF "ring");
    if(!random(10) ) 
      CLONEME(ARMOUR "seidentuch");
  }
  else
  {
    if( !random(20) )
    {
      CLONEME( ARMOUR "elfenkettenhemd");
    }
    else
      CLONEME ( ARMOUR "b_weste" );
    if(!random(3) )
      switch(random(2))
      {
        case 0: CLONEME(ARMOUR_ELF "leggings"); break;
        case 1: CLONEME(ARMOUR "b_hose"); break;
      }
  }
  if(!random(2) ) CLONEME(ARMOUR_ELF "mokassins" );
  if(!random(3) ) CLONEME(ARMOUR_ELF "handschuhe");
  if(!random(3) ) CLONEME(ARMOUR_ELF "umhang");
  if(!random(4) ) CLONEME(ARMOUR_ELF "armschienen");
  command( "trage alles" );

  add_select_commands();

}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("nimm alles aus leiche");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe");
  command_me("trage alles");
  WLOG(LOG "elfendorf", "von Elfenwaechter umgebracht.");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && random(2) && find_call_out("kill")==-1 )
    call_out("kill",2+random(4));
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Lass das!");
}

void kill()
{
  if( IS_LEARNING(TP) )
    command_me("sag Wenn Du kein Magier waerest, wuerde ich Dich jetzt "
               "toeten, "+TPN+"!");
  else
    Kill(TP);
}

void intim()
{
  if( TP->QueryProp(P_RACE)!="Zwerg")
  {
    if( TP->QueryProp(P_GENDER) == QueryProp(P_GENDER) )
      command_me("sag Bist Du vielleicht anders rum, "+TPN+"?");
    else
    {
      write(Name(WER,1)+" schmiegt sich an Dir an und fluestert: Du bist "
        "lieb, "+TPN+".\n");
      tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an und "
        "fluestert etwas.\n");
    }
  }
  else
    command_me("sag Lass das, Du Zwerg!");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+".\n", ({TP, TO}) );
}

