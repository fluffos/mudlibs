// Ein Krokodil 
// 1997-08-21 Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, "Ein Krokodil" );
  SetProp( P_LONG, 
    "Dieses Krokodil ist sicher fast 4 Meter lang und hat ein riesiges Maul "
    "voller spitzer Zaehne. Es wird Dich in wenigen Augenblicken in kleine "
    "Teile zerfetzt haben, denn es schaut sehr hungrig aus.");

  SetProp( P_NAME, "Krokodil");
  SetProp( P_GENDER, NEUTER );
  SetProp( P_RACE, "Echse");

  AddId ( ({ "krokodil" }) );

  create_default_npc (22);

  SetProp( P_HANDS, ({" mit seinem riesigen Maul", 270, DT_RIP }));
  SetProp( P_ALIGN, -430);
  SetProp( P_SIZE, 300+random(150) );
  SetProp( P_MAX_HANDS, 4);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Das Krokodil verschlingt @WEN sofort!\n" }) );

  SetProp( P_DIE_MSG, " versinkt toedlich getroffen im Wasser.\n");

  SetProp( P_DEFAULT_INFO, 
    "Das Krokodil beisst Dich.\n");
  SetProp( P_AGGRESSIVE, ([P_FROG: ([0:1,1:0]) ]) );

  SetProp( P_SPELLRATE, 20);
  AddSpell( 4, 400,
    "Das Krokodil schlaegt Dich mit seinem langen Schwanz.\n",
    "Das Krokodil schlaegt @WEN seinem langen Schwanz.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  AddSpell( 1, 900,
    "Das Krokodil drueckt Dich unter Wasser.\n",
    "Das Krokodil drueckt @WEN unter Wasser.\n",
    DT_WATER, ([SP_SHOW_DAMAGE:1]) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "krokodil",
    ctime()+": Das Krokodil hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

void die(int poisondeath)
{
  write_file(LOG "krokodil",
    ctime()+": "+CAP(getuid(TP))+" killt das Krokodil.\n");
  ::die(poisondeath);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch)
    call_out("touch",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void touch()
{
  write(Name(WER,1)+ " beisst Dich.\n");
  say(Name(WER,1)+" beisst "+TP->name(WEN)+".\n", ({TP}));
  TP->reduce_hit_point(25+random(30));
}

