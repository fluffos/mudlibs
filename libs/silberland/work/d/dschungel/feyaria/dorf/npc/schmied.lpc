//  der Zwergenschmied in Dorf-2a2.c
inherit "std/repair";

#include "../def.h"
#include "../quest.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

   SetProp( P_SHORT, "Ein Zwergenschmied");
   SetProp( P_LONG, 
     "Ein Zwergenschmied steht vor Dir und Du kannst Deine Verwunderung kaum "
     "verbergen... Was macht ein Zwerg in einem Elfendorf? Die Farbe seines "
     "langen Bartes und seiner Haare sind unter der dicken Russchicht kaum "
     "zu erkennen. Er ist sehr kraeftig gebaut, aber was wundert das bei "
     "einem Schmied."); 

  AddId ( ({ "schmied","zwerg","zwergenschmied"}) );

  create_default_npc(18);

  SetProp( P_NAME, "Schmied"); 
  SetProp( P_GENDER, MALE);
  SetProp( P_RACE, "Zwerg");
  SetProp( P_ALIGN, 500);
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({" mit seinem Schmiedehammer", 200, DT_BLUDGEON}) );
  SetProp( P_SIZE, 140);
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:55]) );
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_FIRE: -0.5, DT_WATER: 0.3, DT_POISON: -0.3, DT_MAGIC: -0.3]) );

  SetProp( P_DIE_MSG,
    " jammert: 'Warum ich?' und stirbt.\n" ); 

  SetProp( P_MURDER_MSG,
    "Wenn das meine Brueder im Gebirge erfahren, %s!\n" );

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Schmied fragt Dich: Was soll ich damit?\n" }) );

  SetProp( P_LOG_INFO,"feyaria/elfendorf");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Das Schmieden liegt mir einfach im Blut.\n",
    "sagt: Was genau willst Du denn wissen, hmm...?\n" }) );

  AddInfo( "elfen",
    "Ich hab mich an ihre eigentuemlich Lebensweise gewoehnt!",
    "erzaehlt: " );
  AddInfo( ({"turnier", "bogenschuetzenturnier"}),
    "Das Bogenschuetzenturnier, ja die Elfen hier sind ganz wild aufs "
    "Bogenschiessen. Ich fertige fuer sie Pfeilspitzen aus bestem "
    "Zwergenstahl.", "erklaert: " );
  AddInfo( ({"pfeilspitze", "pfeilspitzen", "spitze", "spitzen"}),
    "Ich mache die besten Pfeilspitzen, die es gibt. Wenn Du mir ein "
    "Stueck echten Zwergenstahl bringst, mach ich Dir eine schoene "
    "Pfeilspitze daraus.", "sagt: ");
  AddInfo( ({"stahl", "zwergenstahl"}),
    "Das ist das haerteste Metall das ich kenne! Leider findet man es nur "
    "in den Zwergenbergwerken.", "erklaert: ");
  AddInfo( ({"zwergenbergwerken", "zwergenbergwerk", "bergwerk",
             "bergwerken"}),
    "Ein Zwergenbergwerk befindet sich in der Naehe von Felonia.",
    "erzaehlt Dir: ");
  AddInfo( "azrael",
    "sagt: Ein netter Typ, er hat ganz besonders schoene, spitze Ohren.\n" );
  AddInfo( "angrox",
    "Ich glaub, er ist der Ziehvater von Azrael, ein richtiger Zwerg.",
    "erinnert sich: ");
  AddInfo( ({"pfeile", "pfeil" }),
    "Das mit den Pfeilen musst Du Tenobaal fragen, er ist der "
    "Bogenspezialist hier im Dorf. Ich mache nur die Pfeilspitzen.",
    "meint: " );
  AddInfo( ({"felonia", "zwergenstadt", "hitze", "klima", "dschungel"}),
    "Urspruenglich stamme ich aus Felonia, aber dort war mir das Klima zu "
    "kalt. Durch das viele Schmieden bin ich die Hitze so gewohnt, dass es "
    "mir hier im Dschungel viel besser gefaellt.", "erklaert: ");
  AddInfo( ({"zwerg", "zwerge"}),
    "Ja, ich bin ein Zwerg.", "sagt stolz: "); 
  AddInfo( ({"hufeisen"}),
    "Ich schmiede Hufeisen und liefere sie ins ganze SilberLand.", 
    "erzaehlt: ");
  AddInfo( ({"silberland"}),
    "Das SilberLand ist sehr gross.", "sagt: ");
  AddInfo( ({"tijara", "stadt"}),
    "Tijara ist eine grosse Stadt im Osten.");
  AddInfo( ({"schmieden"}),
    "Schmieden ist fuer mich das schoenste auf der Welt!", "sagt begeistert: ");
  AddInfo( ({"schmiede"}),
    "Ja, das ist meine Schmiede.", "nickt und sagt: ");
  AddInfo( ({"schmiedehammer", "hammer", "esse", "feuer", "amboss"}),
    "Das brauche ich zum Schmieden!", "sagt: ");
  AddInfo( ({"russ"}),
    "Mir macht der Russ nichts aus.", "sagt laechelnd: ");
  AddInfo( ({"drache", "drachen"}),
    "Drachen bekaempft man am besten mit einer Drachenlanze.", "sagt: ");
  AddInfo( ({"drachenlanze", "drachentoeter", "lanze"}),
    "Frueher habe ich hier einmal Drachenlanzen zusammengebaut, aber "
    "heutzutage mache ich das nicht mehr. Du kannst aber gerne meinen "
    "Amboss dazu verwenden.", "sagt: ");

  AddInfo( ({"reparatur", "reparieren", "repariere"}),
    "Wenn Du willst, kann ich Deine Waffen und Ruestungen reparieren. Gib "
    "dazu einfach 'repariere <name>' ein. Leider muss ich aber einiges an "
    "Geld dafuer verlangen.", "sagt: ");
  AddLibrary( "/d/dschungel/feyaria/tijara/npc/material.lib",1);

  SetProp( P_SPELLRATE,25);
  AddSpell( 5,350,
    "Der Schmied haut Dir den Hammer auf den Kopf.\n",
    "Der Schmied haut @WEM den Hammer auf den Kopf.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]) );
  AddSpell(1,900,
    "Der Schmied wirft Dich in die gluehende Esse.\n",
    "Der Schmied wirft @WEN in die gluehende Esse.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE: 1]) );
 
  SetChats(2, ({
    "Der Schmied schmiedet ein Hufeisen und schreckt es dann im Wasser ab.\n",
    "Der Schmied fragt barsch: Was willst Du?\n",
    "Der Schmied nimm einen neuen Eisenbarren aus seinem Vorrat.\n",
    "Der Schmied prueft die Qualitaet des Hufeisens.\n",
    "Der Schmied sucht sich einige Stuecke Alteisen und wirft sie in den "
       "Schmelztopf.\n",
    "Der Schmied wirft ein unbrauchbares Hufeisen wieder ins Feuer.\n",
    "Der Schmied stapelt die fertigen Hufeisen und verpackt sie.\n",
    "Der Schmied wischt sich den Schweiss von der Stirn.\n",
    "Der Schmied schlaegt mit seinem Hammer ein Hufeisen in die rechte Form.\n",
    "Der Schmied arbeitet verbissen an einem Hufeisen.\n"
              }) );

  SUID;

  CLONEME( "/p/weapon/club/schmiedehammer" );
  CLONEME( "/p/armour/cloak/lederschuerze" );
  command( "trage alles");
  command( "zuecke schmiedehammer" );

}

void give_notify(object ob)
{
  object quest;
  if( ob->id(QUEST_STAHL) && (quest=present(BOGENQUESTID, TP)) && 
     !present(QUEST_PFEIL, TP) )
  {
    write( BS("Der Schmied nimmt den Zwergenstahl und fertigt Dir geschwind "
              "eine scharfe Pfeilspitze.") );
    CLONE( OBJ "spitze", TP );
    quest->quest_teil(BQ_PFEILSPITZE);
    return;
  }
  if( ob->QueryMaterial(MAT_IRON)>20 || ob->QueryMaterial(MAT_STEEL)>20 )
  {
    tell_room(MENV, "Der Schmied legt "+ ob->name(WEN) +" zu seinem "
                    "Alteisenvorrat.\n");
    ob->remove();
    return ;
  }
  ::give_notify(ob);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "elfendorf", ctime()+": "+Name(WER,1)+
                 " hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

int rep_auswahl(object ob)
{
  if( ob->QueryProp(P_WEAPON_TYPE) )
  {
    write("Der Schmied sagt: Ich repariere keine Waffen!\n");
    return 0;
  }
  if( ob->QueryMaterialGroup(MATGROUP_METAL)<20 )
  {
    write("Der Schmied sagt: Ich repariere nur Metallruestungen!\n");
    return 0;
  }
  return 1;
}

