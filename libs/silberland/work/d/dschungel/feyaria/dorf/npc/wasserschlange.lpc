// Eine Wasserschlange 
// 19-08-97 Feyaria@SilberLand

inherit "std/npc";

#include "../def.h"
#include "../quest.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, 
      "Eine Wasserschlange schlaengelt sich ueber die Wasseroberflaeche" );
  SetProp( P_LONG, 
    "Eine kleine Wasserschlange schlaengelt sich ueber die Oberflaeche des "
    "Sees und jagt Wasserlaeufer und andere kleine Insekten. Sie ist nur "
    "armlang und hat eine hellgruene Farbe. ");

  SetProp( P_NAME, "Wasserschlange");
  SetProp( P_GENDER, FEMALE );
  SetProp( P_RACE, "Schlange");

  AddId ( ({ "schlange", "wasserschlange" }) );

  create_default_npc (7);

  SetProp( P_HANDS, ({" mit ihren Fangzaehnen", 70, DT_PIERCE }));
  SetProp( P_ALIGN, -30);
  SetProp( P_SIZE, 30);
  SetProp( P_MAX_HANDS, 0);
  SetProp( P_TRANSPARENT, 0);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Wasserschlange kann @WEN gar nicht tragen!\n" }) );

  SetProp( P_DIE_MSG, " versinkt im toedlich getroffen im Wasser.\n");
  
  SetChats(3, ({
    "Die Wasserschlange schlaengelt sich im Wasser.\n" ,
    "Die Wasserschlange faengt einen Wasserlaeufer.\n" ,
    "Die Wasserschlange verschwindet kurz zwischen den Wasserpflanzen.\n" ,
    }) );
  SetAttackChats(6, ({
    "Die Wasserschlange zischt wuetend.\n" ,
    }) );
  
  CLONEME("/d/ebene/creative/feldlager/obj/haut");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch)
    call_out("touch",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void touch()
{
  write(Name(WER,1)+ " beisst Dich.\n");
  say(Name(WER,1)+" beisst "+TP->name(WEN)+".\n", ({TP}));
  TP->reduce_hit_point(3+random(5));
}


