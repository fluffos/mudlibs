// Gilagas, der Elfenheld der Legenden
// 1997-04-20  Feyaria@SilberLand

inherit "std/mnpc";
inherit "std/npc/spells";

#include "../def.h"

object ob,ob1,ob2,ob3,ob4,ob5;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gilagas, der Elfenheld der Legende");
  SetProp(P_LONG, 
    "Gilagas, war einer der grossen Helden im grossen Orkkrieg. An der Seite "
    "von Zafira, Khartak und Arcon war er es, der den Sieg ueber die Orks erst "
    "moeglich machte. "
    "Gilagas hat lange, eichenbraune Haare, in die einige kleine Zoepfchen "
    "geflochten sind, und smaragdgruene Augen. Seine Ruestung ist dunkelgruen "
    "gefaerbt, was im Wald sicher eine gute Tarnung ist. An seiner Seite "
    "haengt ein maechtiges Schwert. Er ist mit Aaliyah verheiratet.");
  SetProp(P_NAME, "Gilagas");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"gilagas", "held", "elfenheld", "elf", "NOWIMPY"}));

  create_default_npc(39, 2000);
  SetProp(P_HANDS, ({" mit seinen Elfenhaenden", 330, ({DT_PIERCE, DT_RIP}) }) );
  SetProp(P_RACE, "Elf");
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_SIZE, 199);
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 50);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_FIRE       :-0.2,     DT_COLD       :0.2,      DT_AIR        :-0.3,
    DT_EXPLOSION  :0.1,      DT_POISON     :0.2,      DT_TERROR     :0.1,
    DT_HOLY       :-0.2,     DT_UNHOLY     :-0.1,     DT_MAGIC      :-0.3]) );

  SetProp(P_MSGIN, "kommt mit Heldenschritten an");
  SetProp(P_MSGOUT, "geht mit Heldenschritten");
  SetProp(P_MMSGOUT, "wirbelt sein Schwert durch die Luft und ist verschwunden");
  SetProp(P_MMSGIN, "taucht wie aus dem Nichts hier auf");
  SetProp(P_MNPC_AREA, "/" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }) );
  SetProp(P_MNPC_DEFAULTROOM, "/gilden/abenteurer");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_NAME, "Gilagas, der Elfenheld der Legende");
  SetProp(P_KILL_MSG, "Wir alten Helden sind doch die besten!");
  SetProp(P_DIE_MSG,  " bricht tot zusammen bevor er sein Schwert zerstoeren kann.\n");

  SetProp(P_LOG_INFO, "feyaria/gilagas");
  AddInfo(DEFAULT_INFO, "sagt: Nichts ist wichter als das Leben selbst.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"gilagas", "held"}),
      "Ja, das bin ich!", "sagt stolz: ");
  AddInfo( ({"ork", "orks", "orkkrieg", "krieg"}),
      "Ich habe im grossen Orkkrieg gekaempft!", "sagt stolz: ");
  AddInfo( ({"helden", "freunde", "heldenfreunde"}),
      "Zu den grossen Helden im Orkkrieg gehoerten neben mir auch noch "
      "Arcon, Angara, Grimm, Flammara, Khartak, Mira, Nogi, Rynoxa, Schlain "
      "und meine geliebte Zafira. Leider sind sie alle im Kampf gegen das "
      "BOESE gefallen.", "erzaehlt: ");
  AddInfo( ({"boese", "brunnen"}),
      "Das BOESE wurde durch das Opfer meiner Heldenfreunde in die tiefsten "
      "Tiefen des Brunnens gebannt.", "erzaehlt: ");
  AddInfo( ({"zafira"}),
      "Zafira! Oh Zafira! Auch nach so langer Zeit vermisse ich sie immer "
      "noch. Sie war die herrlichste Frau im ganzen Silberland.", 
      "sagt traurig: ");
  AddInfo( ({"arcon", "grimm", "khartak", "nogi", "schlain"}),
      "Einer der grossen Helden im Orkkrieg und einer meiner besten Freunde!", 
      "sagt stolz: ");
  AddInfo( ({"angara", "flammara", "mira", "rynoxa"}),
      "Eine der grossen Heldinnen, die im Orkkrieg an meiner Seite gekaempft "
      "hat.", "sagt stolz: ");
  AddInfo( ({"aaliyah"}),
      "Aaliyah ist meine wunderbare Ehefrau!", "sagt schwaermend: ");

  AddInfo(({"ruf der helden", "bardenlied", "zauberlied"}), "@@ruf_der_helden@@", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Gilagas sagt: Danke, aber @WEN brauche ich nicht!\n" }) );

  SetProp(P_SPELLRATE, 50 ); 
  AddSpell(2, 700,
      "Gilagas trifft Dich kritisch.\n",
      "Gilagas trifft @WEN kritisch.\n",
      DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(3, 500, DS_MASS_DAMAGE,
      "Gilagas berschwoert einen Wirbelsturm, der Dich beinahe zu Boden wirft.\n",
      "Gilagas berschwoert einen Wirbelsturm, der Dich beinahe zu Boden wirft.\n",
      DT_AIR);
  AddDefaultSpell(1, 400, DS_DISARM,
      "Gilagas entwaffnet Dich mit einer schnellen Schwertdrehung.\n",
      "Gilagas entwaffnet @WEN mit einer schnellen Schwertdrehung.\n");
  AddSpell(1, 1, 
      "Gilagas bewegt sich ploetzlich schneller.\n", 
      "Gilagas bewegt sich ploetzlich schneller.\n", 
      DT_MIND, "speed" );

  SetChats(5, ({
    "Gilagas sagt: Ich bin auf der Jagd nach Orks!\n",
    "Gilagas fragt Dich: Hast Du auch im grossen Orkkrieg gekaempft?\n",
    "Gilagas ruft: Flammara! Khartak! Zafira! Arcon! Wo seit ihr?\n",
    "Gilagas sagt: Mira war die schoenste Frau im ganzen SilberLand!\n",
    "Gilagas sagt: Niemand ist staerker als Grimm, der Riese!\n",
    "Gilagas sagt: Kennst Du die lustigen Witze von Nogi schon?\n",
    "Gilagas sagt: Nur Arcon kann es im Schwertkampf mit mir aufnehmen!\n",
    "Gilagas sagt: Niemand hatte schoeneren Schmuck als Angara!\n",
    "Gilagas sagt: Schlain war ein wunderbarer Jagdgefaehrte!\n",
    "Gilagas sagt: Oh Zafira! Wie ich Dich vermisse!\n",
    "Gilagas sagt: Niemand ausser Flammara konnten einen Feuerphoenix beherrschen!\n",
    "Gilagas sagt: Da hinten ist es so hell! Ob das Rynoxa ist?\n",
    "Gilagas traeumt von vergangenen Heldentaten.\n",
    "Gilagas mustert Dich.\n",
    "Gilagas fragt Dich: Hast Du Flammara oder Angara gesehen?\n",
    "Gilagas fragt Dich: Hast Du Grimm in letzer Zeit mal gesehen?\n",
    "Gilagas fragt Dich: Weisst Du wo Arcon jetzt wohnt?\n",
    "Gilagas fragt Dich: Wo ist Khartak jetzt bloss geblieben?\n",
    "Gilagas schaut Dich mit seinen unergruendlichen Elfenaugen an.\n"}) );

  SUID;
  if( random(100) < 50 ) 
    CLONEME( WEAPON "orkenspalter" ); 
  else
    CLONEME( WEAPON "orkenschlitzer" ); 
  if( random(4) )
  {
    ob3 = clone_object("/std/armour");
    ob3->move(ME);
    ob3->SetProp(P_NAME, "Gilagas' Himmelsstuermer");
    ob3->SetProp(P_SHORT, "Gilagas' Himmelsstuermer");
    ob3->SetProp(P_ARMOUR_TYPE, AT_BOOT);
    ob3->SetProp(P_ARTICLE, 0);
    ob3->DoWear(1);
  }
  if( random(3) )
  {
    ob5 = clone_object("/std/armour");
    ob5->move(ME);
    ob5->SetProp(P_NAME, "Gilagas' Beinschienen");
    ob5->SetProp(P_SHORT, "Gilagas' Beinschienen");
    ob5->SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
    ob5->SetProp(P_ARTICLE, 0);
    ob5->DoWear(1);
  }
  if( random(2) )
  {
    ob2 = clone_object("/std/armour");
    ob2->move(ME);
    ob2->SetProp(P_NAME, "Gilagas' Panzerfaust");
    ob2->SetProp(P_SHORT, "Gilagas' Panzerfaust");
    ob2->SetProp(P_ARMOUR_TYPE, AT_GLOVE);
    ob2->SetProp(P_ARTICLE, 0);
    ob2->DoWear(1);
  }
  if( random(5) )
  {
    ob4 = clone_object("/std/armour");
    ob4->move(ME);
    ob4->SetProp(P_NAME, "Gilagas' Jagdmantel");
    ob4->SetProp(P_SHORT, "Gilagas' Jagdmantel");
    ob4->SetProp(P_ARMOUR_TYPE, AT_CLOAK);
    ob4->SetProp(P_ARTICLE, 0);
    ob4->DoWear(1);
  }
  if( random(3) )
  {
    ob1 = clone_object("/std/armour");
    ob1->move(ME);
    ob1->SetProp(P_NAME, "Gilagas' Efeukranz");
    ob1->SetProp(P_SHORT, "Gilagas' Efeukranz");
    ob1->SetProp(P_ARMOUR_TYPE, AT_HELMET);
    ob1->SetProp(P_ARTICLE, 0);
    ob1->DoWear(1);
  }
  ob = clone_object("/std/armour");
  ob->move(ME);
  ob->SetProp(P_NAME, "Gilagas' Brustharnisch");
  ob->SetProp(P_SHORT, "Gilagas' Brustharnisch");
  ob->SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  ob->SetProp(P_ARTICLE, 0);
  ob->DoWear(1);
  command("trage alles");
  command("zuecke schwert");
}

public string ruf_der_helden() {
  string msg;
  object strauss;

  msg = "Der Ruf der Helden ist ein Bardenlied, das die Kraft der alten Helden herbeirufen kann. ";

  if(TP->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("ruf der helden") == 0) {
    msg += "Hier, nimm diesen Blumenstrauss. Erweise den gefallenen im Kampf gegen alles Boese die letzte "
           "Ehre. Wirf diese Blumen in den Eingang zu dem Brunnen, in dem DAS BOESE auf immer verbannt wurde. "
           "Gedanke damit der letzten grossen Tat dieser Helden!";
    strauss = clone_object("/gilden/bardengilde/obj/quest/gs11_rdh_task");
    strauss->move(TP, M_GET|M_NOCHECK);
    tell_object(TP, BS("Gilagas ueberreicht dir einen Blumenstrauss."));
  }

  return msg;
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  tell_room(MENV, "Gilagas sagt: Du bist meiner Ruestung nicht wert!\n"+
      "Gilagas zerstoert schnell seine gesamte Ausruestung.\n");
  if(ob) ob->remove();
  if(ob1) ob1->remove();
  if(ob2) ob2->remove();
  if(ob3) ob3->remove();
  if(ob4) ob4->remove();
  if(ob5) ob5->remove();
//  if(ob=present("schwert") ) ob->remove();
  WLOG(LOG "gilagas", "killt Gilagas den Elfenheld");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "gilagas",
  sprintf(" %s  %s von Gilagas umgebracht. ( -%d XP ).\n",
      dtime(time()), CAP( player->query_real_name() ), lostexp ));
}

void speed()
{
  ModifySkillAttribute(ME, SA_SPEED, 200, 3 + random(7));
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (getuid(TP) == "aaliyah" && find_call_out("aaliyah")==-1)
    call_out("aaliyah", 0, verb, gruppe, adverb);
  else if( gruppe=="fies" && random(2) && find_call_out("kill")==-1 )
    call_out("kill",2+random(4));
  else if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  else if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  else if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Lass das!");
}

void kill()
{
  if( IS_LEARNING(TP) )
    command_me("sag Wenn Du kein Magier waerest, wuerde ich Dich jetzt "
               "toeten, "+TPN+"!");
  else
    Kill(TP);
}

void intim()
{
  if( TP->QueryProp(P_RACE)!="Zwerg")
  {
    if( TP->QueryProp(P_GENDER) == QueryProp(P_GENDER) )
      command_me("sag Bist Du vielleicht anders rum, "+TPN+"?");
    else
    {
      write(Name(WER,1)+" schmiegt sich an Dir an und fluestert: Du bist "
        "lieb, "+TPN+".\n");
      tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an und "
        "fluestert etwas.\n");
    }
  }
  else
    command_me("sag Lass das, Du Zwerg!");
}

varargs void traurig(string adverb)
{
  tell_object(TP, Name(WER,1)+ " troestet Dich"+(adverb ? adverb : "")+".\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+(adverb ? adverb : "")+".\n", 
      ({TP, TO}) );
}

void aaliyah(string verb, string gruppe, string adverb)
{
  switch (verb)
  {
    case "kuesse":
    case "kuess":
    case "knutsch":
    case "knutsche":
      set_living_name("elfenheld"); // Aaliyah's Gilagas bekommt anderen living_name
      SetProp ("chat_chance", 0);
      SetProp(P_MNPC_FLAGS, 0);
      tell_object(TP, Name(WER,1)+ " erwidert Deinen Kuss leidenschaftlich.\n");
      tell_room(MENV, Name(WER,1)+ " erwidert " + TP->name(WESSEN) + " Kuss leidenschaftlich.\n", 
        ({TP, TO}) );
      break;

    case "umarm":
    case "umarme":
    case "drueck":
    case "druecke":
    case "sabber":
    case "sabbere":
      tell_object(TP, Name(WER,1)+ " nimmt Dich fest in den Arm.\n");
      tell_room(MENV, Name(WER,1)+ " nimmt " + TP->name(WEN) + " fest in seine Arme.\n",
        ({TP, TO}) );
      break;

    default:
      switch (gruppe)
      {
        case "nett": intim(); break;
        case "intim": intim(); break;
        case "traurig": traurig(" liebevoll"); break;
        case "aengstlich": traurig(" aufmunternd"); break;
        case "fies": 
        case "frech":  
          tell_room(MENV, Name(WER,1)+ " sagt: Warum tut ihr das, geliebte Ehefrau?\n", 
              ({TO}) );
          break;
        default:  
           tell_object(TP, Name(WER,1)+ " laechelt Dich liebevoll an.\n");
           tell_room(MENV, Name(WER,1)+ " laechelt "+TPN+" liebevoll an.\n",
                       ({TP, TO}) );

      }
  }
}

void init()
{
  ::init();
  if (TP && interactive(TP) && getuid(TP) == "aaliyah")
    call_out("hallo", 0);
  else if (TP && TP->id("zafira"))
    call_out("zafira", 0);
}

void hallo()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Gilagas begruesst Dich mit einem leidenschaftlichen Kuss.\n");
    tell_room(MENV, "Gilagas begruesst seine geliebte Ehefrau Aaliyah mit einem "
        "Kuss.\n", ({TP}));
  }
}

void zafira()
{
  if (TP && MENV && present(TP, MENV))
  {
    tell_room(MENV, break_string(
          "Oh Zafira, Geliebte! Wie schoen Dich wiederzusehen! Mein Herz "
          "zerspringt fast vor Freude.",
          78,"Gilagas sagt: ")+
        "Gilagas gibt Zafira einen tiefen und hingebungsvollen Kuss.\n"); 
  }
}

int Defend(int dam, mixed *dam_type_list, mixed spell, object enemy)
{
  if (dam > 500) dam = 500;
  return ::Defend( dam, dam_type_list, spell, enemy);
}
