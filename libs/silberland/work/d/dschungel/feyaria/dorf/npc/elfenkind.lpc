// Elfenkind
// 2003-12-08 Feyaria@SilberLand


inherit "std/mnpc";

#include "../def.h"

void init()
{
  mnpc::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  switch( random(2) )
  {
    case 0:
      SetProp( P_NAME, "Elfenkind");
      AddId ( ({"kind", "elfenkind" }) );
      break;
    case 1:
      SetProp( P_NAME, "Elfenmaedchen");
      AddId( ({"elfenmaedchen", "maedchen"}) );
      break;
  }
  SetProp( P_GENDER, NEUTER);
  SetProp( P_SHORT, Name(WER,0)+" laeuft froehlich herum");
  SetProp(P_LONG,
      Name(WER,0)+ ". "+ CAP(QueryPronoun(WER)) +" ist klein und zart, "
    "hat langes weiss-blondes Haar und laechelt Dich an.");
  AddId ( ({"ELF" }) );

  create_default_npc(9+random(3));
  SetProp( P_RACE, "Elf");
  SetProp( P_SIZE, 100+random(50));
  SetProp( P_ALIGN, 400+random(400));
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({" mit zarten Kinderhaenden", 100, DT_BLUDGEON}) );

  SetProp( P_MSGIN, "huepft herein");
  SetProp( P_MSGOUT, "huepft froehlich");
  SetProp( P_MMSGIN, "ist plotzlich da");
  SetProp( P_MMSGOUT, "versteckt sich");
  SetProp( P_MNPC_AREA, (ROOM) );
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp( P_MNPC_DEFAULTROOM, ROOM "dorf-1a1");
  SetProp( P_MNPC_FLAGS, MOV_INDOORS+ MOV_OUTDOORS+ MOV_MOVES+ MOV_BACKWARDS);

  SetProp( P_DIE_MSG,
    " spielt noch ein letztes Lied auf "+QPP(FEMALE,WEM)+
    " Floete und stirbt.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" sagt: Oh ein Geschenk! Danke!\n"+
    Name(WER,1)+" strahlt Dich an.\n"}) );

  SetProp(P_LOG_INFO,"feyaria/elfendorf");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Du kannst aber Fragen stellen!\n",
    "sagt: Frag doch am Dorfplatz nach, da kann Dir sicher jemand helfen.\n",
    "fragt: Ich versteh nicht ganz was Du meinst. \n",
    "sagt: Willst Du nicht mit mir spielen?\n",
    "murmelt: Wenn ich solche Fragen stelle, bekomm ich auch keine Antwort.\n" }) );
  AddLibrary( NPC "elfendorf.lib",1);

  SetProp(P_NOMAGIC, 10);
 
  SetChats( 2, ({
    Name(WER,1)+" huepft um Dich herum.\n",
    Name(WER,1)+" singt eine lustiges Lied.\n",
    Name(WER,1)+" summt eine schoene Melodie.\n",
    Name(WER,1)+" spielt froehlich mit einem Bauschball.\n",
    Name(WER,1)+" bohrt gelangweilt in der Nase.\n",
    Name(WER,1)+" schaut Dich mit neugierigen Augen an.\n"                          
    }) );

  SUID;

  if( QueryProp(P_GENDER) == FEMALE ) 
  {
    if( !random(5) )
    {
      CLONEME( ARMOUR "b_kleid");
    }
    else if( !random(10) )
    {
      CLONEME( ARMOUR_ELF "rock");
      CLONEME( ARMOUR "bluse");
    }
  }
  else
  {
    if( !random(5) )
      CLONEME ( ARMOUR "b_weste" );
    if(!random(10) )
      switch(random(2))
      {
        case 0: CLONEME(ARMOUR_ELF "leggings"); break;
        case 1: CLONEME(ARMOUR "b_hose"); break;
      }
  }
  if(!random(5) ) CLONEME(ARMOUR_ELF "mokassins" );
  command( "trage alles" );

}

void InformDefend(object enemy)
{
  command_me("emote ruft um Hilfe und laeuft davon.");
  Flee();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  WLOG(LOG "elfendorf", "von Elfenkind umgebracht.");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && random(2) && find_call_out("kill")==-1 )
    call_out("kill",2+random(4));
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="nett" && find_call_out("nett")==-1)
    call_out("nett",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Lass das!");
}

void kill()
{
  command_me("emote schreit: MAMI!");
}

void nett()
{
 command_me("sag Du bist lieb, "+TPN+".");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+".\n", ({TP, TO}) );
}

