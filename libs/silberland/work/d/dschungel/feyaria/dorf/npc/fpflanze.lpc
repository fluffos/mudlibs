//  fleischfressende Pflanze



inherit "std/npc";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine fleischfressende Pflanze" );
  SetProp (P_LONG, 
    "Eine ueberdimensionale Ausgabe einer Venusfliegenfalle steht " 
    "hier im seichten Wasser und zuckt wuetend mit den Blaettern. "
    "Sie hat hellweisse Blueten, die nach Aas duften, um Fliegen und "
    "andere Insekten anzulocken.");

  AddDetail( "blaetter",
    "Fettig-gruene Blaetter. Sie scheinen irgendwie in Deine Richtung "
    "zu zeigen - richtig bedrohlich.");

  SetProp (P_NAME, "Pflanze");
  SetProp (P_NAME_ADJ, "fleischfressend" );
  SetProp (P_GENDER, FEMALE);

  AddId ( ({ "pflanze", "venusfliegenfalle", "venusfalle" }) );
  AddAdjective( ({"fleischfressend", "fleischfressende"}) );

  create_default_npc (15);

  SetProp (P_HANDS, 
    ({" mit ihrem schleimigen Gebiss", 180, ({DT_SQUEEZE, DT_ACID}) }));
  SetProp (P_ALIGN, -200);
  SetProp (P_SIZE, 50);
  SetProp (P_MAX_HANDS, 0);
  SetProp (P_RACE, "Pflanze");
  SetProp (P_DEAF, -1);
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Die fleischfressende Pflanze verdaut @WEN.\n" }) );

  SetProp (P_DIE_MSG, " schrumpelt in sich zusammen und versinkt.\n");
  SetProp (P_MURDER_MSG, "Na Warte, %s; das naechste Mal fress ich Dich auf!" );
  SetProp (P_KILL_NAME, "Venusfliegenfalle" );
  SetProp (P_KILL_MSG, 
    "Endlich mal was schmackhafteres als diese bloeden Fliegen!");
  
  SetChats(3, ({
    "Die Venusfliegenfalle wiegt sich sanft hin und her.\n",
    "Die Pflanze schnappt nach einer Fliege und verschlingt sie gierig.\n",
    "Vom Gebiss der Venusfalle tropft ein giftig-gruener Saft ins Wasser.\n",
    "Die Venusfliegenfalle sabbert gurgelnd vor sich hin.\n",
    "Die Pflanze stoesst ploetzlich ins Wasser und zerkaut einen zuckenden "
       "Molch.\n" }) );

  SetAttackChats(6, ({
    "Die Venusfalle spuckt Dir eine stinkende Fluessigkeit ins Gesicht.\n",
    "Die Pflanze beisst Dir in die Nase.\n",
    "Die Pflanze klappert sabbernd mit ihrem Gebiss.\n" }) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch)
    call_out("touch",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void touch()
{
  write(Name(WER,1)+ " beisst Dich.\n");
  say(Name(WER,1)+" beisst "+TP->name(WEN)+".\n", ({TP}));
  TP->reduce_hit_point(5+random(10));
}

