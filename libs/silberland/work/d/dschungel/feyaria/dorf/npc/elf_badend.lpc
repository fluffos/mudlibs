// Ein badender Elf
// 19-08-97 Feyaria@SilberLand


inherit "std/npc";

#include "../def.h"

void init()
{
  ::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  string Elf_Hands;

  if (!is_clone(this_object())) return;
  ::create();

  if( random(100) > 50 ) 
  {
    SetProp( P_GENDER, MALE);
    SetProp( P_NAME, "Elf");
    Elf_Hands = " mit seinen Elfenhaenden";
    SetProp( P_SIZE, 195);
    AddId("elf");
  }
  else
  {
    SetProp( P_GENDER, FEMALE);
    SetProp( P_NAME, "Elfe");
    Elf_Hands = " mit ihren zarten Elfenhaenden";
    SetProp( P_SIZE, 185);
    AddId("elfe");
  }
  SetProp(P_NAME_ADJ, "badend");

  SetProp( P_SHORT, Name(WER,0)+" schwimmt im Wasser herum");
  SetProp( P_LONG,
     Name(WER,1)+ " plantscht gerade genuesslich im Wasser des Sees herum.");

  AddId ( ({"ELF"}) );
  AddAdjective( ({"badender", "badenden", "badende"}) );
  create_default_npc(15);

  SetProp( P_RACE, "Elf");
  SetProp( P_ALIGN, 700+random(100));
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({ Elf_Hands, 100, DT_BLUDGEON}) );

  SetProp( P_MSGIN, "schwimmt herein");
  SetProp( P_MSGOUT, "schwimmt");

  SetProp( P_DIE_MSG, " versinkt sterbend im Wasser.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Beim Schwinnen kann ich @WEN nicht brauchen!\n" }) );

  SetProp( P_LOG_INFO,"feyaria/elfendorf");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Dazu kann ich Dir ueberhaupt nichts sagen.\n",
    "sagt: Frag doch am Dorfplatz nach, da kann Dir sicher jemand helfen.\n",
    "fragt: Ich versteh nicht ganz was Du meinst. \n",
    "sagt: kommt doch auch ins Wasser!\n",
    "fragt Dich: Bist Du etwa wasserscheu?\n" }) );
  AddLibrary( NPC "elfendorf.lib",1);

  AddInfo( ({"wasser", "see", "schwimmen", "bad", "baden"}),
    "Das Baden hier im See macht grossen Spass.", "sagt froehlich: ");
  AddInfo( ({"feder", "federn"}),
    "Manchmal schwimmen hier Schwanenfedern im Wasser.", "sagt: ");
  AddInfo( ({"schwanenfeder", "schwanenfedern"}),
    "Wenn Du eine Schwanenfeder willst, musst Du schon ins Wasser "
    "kommen.", "sagt kichern: ");
  AddInfo( ({"schwan", "schwaene"}),
    "Weit draussen am See schwimmen viele Schwaene herum.", "sagt: ");

  SetProp(P_NOMAGIC, 20);
  SetProp(P_SPELLRATE, 85);
  AddSpell( 3,100,
    Name(WER,1)+" bespritzt Dich mit Wasser.\n",
    Name(WER,1)+" bespritzt @WEN mit Wasser.\n",
    DT_WATER, ([SP_SHOW_DAMAGE: 1]) );
  AddSpell(1,500,
    Name(WER,1)+ " versucht Dich zu ertraenken.\n",
    Name(WER,1)+ " versucht @WEN zu ertraenken.\n",
    DT_WATER, ([SP_SHOW_DAMAGE: 1]) );
 
  SetChats( 5, ({
    Name(WER,1)+ " bespritzt Dich kichernd mit Wasser.\n", 
    Name(WER,1)+ " plantscht im Wasser herum.\n", 
    Name(WER,1)+ " taucht kurz unter.\n", 
    Name(WER,1)+ " waescht sich "+QPP(NEUTER,WEN,PLURAL)+" langen Haare.\n", 
    Name(WER,1)+ " schwimmt ein kleine Runde.\n",
    Name(WER,1)+ " will noch nicht aus dem Wasser.\n", 
    Name(WER,1)+ " geniesst das Baden.\n", 
    Name(WER,1)+ " sagt: Komm doch auch ins Wasser.\n", 
    Name(WER,1)+ " fragt Dich: Bist Du etwa wasserscheu?\n",
    Name(WER,1)+ " laechelt Dich an.\n", 
    Name(WER,1)+ " mustert Dich neugierig.\n",
    Name(WER,1)+ " schwimmt unter dem Steg durch.\n", 
    Name(WER,1)+ " hat scheinbar grossen Spass beim Baden.\n" }) );

  SUID;

}
void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( (gruppe=="fies" || gruppe=="frech") 
     && random(2) && find_call_out("fies")==-1 )
    call_out("fies",0);
  if( (gruppe=="intim" || gruppe=="albern" || gruppe=="nett" || gruppe=="froh")
      && find_call_out("intim")==-1 && !random(3) )
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Warum machst Du so boese Sachen, "+TPN+"?");
}

void intim()
{
  command_me("sag Komm doch ins Wasser, "+TPN+"!");
}
            
void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+".\n", ({TP, TO}) );
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
    write_file(LOG "elfendorf", ctime()+": "+Name(WER,1)+
                " hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

