//   ein Verkaeufer am Dorfplatz --- dorf-012

inherit "std/repair";

#include "../def.h"
#include "../quest.h"

int zettel;

void init()
{
  ::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  if (!is_clone(this_object())) return;

  ::create();
  zettel=6;

   SetProp( P_SHORT, "Ein elfischer Haendler");
   SetProp( P_LONG, 
     "Ein Haendler. Er steht hinter dem Verkaufsstand und schaut Dich "
     "erwartungsvoll mit seinen tiefgruenen Augen an.");
  AddDetail( ({"auge", "augen"}),
    "Die Augen des Haendlers sind wirklich tiefgruen."); 

  AddId ( ({ "haendler","elf","elfenhaendler", "ELF"}) );

  create_default_npc(18);

  SetProp( P_NAME, "Haendler"); 
  SetProp( P_GENDER, MALE);
  SetProp( P_RACE, "Elf");
  SetProp( P_ALIGN, 650);
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({" mit seinem Florett", 150, DT_BLUDGEON}) );
  SetProp( P_SIZE, 190);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Haendler sagt: Danke, das kann ich sicher weiterverkaufen!\n" }) );

  SetProp( P_DIE_MSG,
          " mault sterbend: In der Vertreterschule haben sie davon aber \n"
        + "Der Haendler mault sterbend: nichts gesagt!\n");

  SetProp( P_LOG_INFO,"feyaria/elfendorf");
  AddInfo( DEFAULT_INFO, ({
          "sagt: Ich biete meine Waren an, das ist alles was ich kann.\n",
          "sagt: Ich hab Infos ueber alles, was hier im Dorf so ablaeuft.\n"
        }) );
  AddLibrary( NPC "elfendorf.lib",1);

  AddInfo( ({"haendler"}), "nickt.\n");
  AddInfo( "turnier",
    "Das Bogenschuetzenturnier, ja ja. Da hab ich hier einige "
    "Werbezettel. Brauchst Du welche?", "erklaert: " );
  AddInfo( ({"leder", "lederhandschuhe", "lederstiefel", "lederruestung",
        "lederpanzer" }),
      "Ich kann Ausruestung aus Leder fuer Dich reparieren.", "sagt: ");

  AddInfo(({ "werbezettel", "zettel", "teilnahmezettel"}),
      "@@werbezettel@@", "sagt: " );

  SetProp( P_SPELLRATE,25);
  SetProp(P_NOMAGIC, 10);
  AddSpell( 1,150,
    "Der Haendler sticht Dir ins Knie.\n",
    "Der Haendler sticht @WEM ins Knie.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );

  SetChats(4, ({
    "Der Haendler fragt Dich: Brauchst Du einen Zettel fuers "
       "Turnier der Bogenschuetzen?\n",
    "Der Haendler fragt: Womit kann ich dienen?\n",
    "Der Haendler fragt: Suchst Du was bestimmtes?\n",
    "Der Haendler ordnet die Papierstapel vor sich auf dem Tisch.\n",
    "Der Haendler summt eine elfische Weise.\n",
    "Der Haendler flickt kaputte Lederstiefel zusammen.\n",
    "Der Haendler bessert loechrige Lederhandschuhe aus.\n",
    "Der Haendler bearbeitet eine abgewetzte Lederruestung.\n",
    "Der Haendler bohrt gelangweilt in der Nase.\n" }) );

  SUID;

  CLONEME( "/p/weapon/sword/florett" );
  command( "zuecke florett" );
  CLONEME( ARMOUR "b_weste" );
  if (!random(3) ) CLONEME( ARMOUR "b_hose");
  command( "trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void reset()
{
  zettel=6;
  ::reset();
}

string werbezettel()
{
  object wz;
  if (!present(BOGENQUESTID, TP))
  {
    if(zettel)
    {
      wz=clone_object( OBJ "zettel.lpc");
      wz->move(TP, M_NOCHECK);
      wz->quest_teil(BQ_ZETTEL_BEKOMMEN);
      zettel--;
      return("Da, ich hab noch genug. Auf der Rueckseite steht alles, was Du "
             "wissen musst. Bitte sehr!\n" ); 
    }
    else
      return  ("Ich habe keinen mehr." );
  }
  return "Du hast ja schon eines!";
}        

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Warum machst Du so boese Sachen, "+TPN+"?");
}

void intim()
{
  if( TP->QueryProp(P_RACE)!="Zwerg")
  {
    if( TP->QueryProp(P_GENDER) == QueryProp(P_GENDER) )
      command_me("sag Bist Du vielleicht anders rum, "+TPN+"?");
    else
    {
      write(Name(WER,1)+" schmiegt sich an Dir an und fluestert: Du bist "
        "lieb, "+TPN+".\n");
      tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an und "
        "fluestert etwas.\n");
    }
  }
  else
    command_me("sag Lass das, Du Zwerg!");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " treostet "+TPN+".\n", ({TP, TO}) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "elfendorf", ctime()+": "+Name(WER,1)+
                 " hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

int rep_auswahl(object ob)
{
  if( ob->QueryProp(P_WEAPON_TYPE) )
  {
    write("Der Haendler sagt: Ich repariere keine Waffen!\n");
    return 0;
  }
  if( ob->QueryMaterial(MAT_LEATHER)<30 )
  {
    write("Der Haendler sagt: Ich repariere nur Lederruestungen!\n");
    return 0;
  }
  return 1;
}

