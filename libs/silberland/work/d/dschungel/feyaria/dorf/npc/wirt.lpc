// Der Wirt vom Elfendorf 

inherit "std/mnpc";

#include "../def.h"
#include "../quest.h"

void init()
{
  ::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

   SetProp( P_SHORT, "Firidion, der Wirt");
   SetProp( P_LONG,
     "Firidion ist der Wirt der Kneipe 'Zum spitzohrigen Bogenschuetzen'. "
     "Obwohl er frueher sicher ein guter Bogenschuetze war, beschaeftigt "
     "er sich jetzt mit der Bewirtung der Teilnehmer des grossen "
     "Bogenschuetzenturniers.");

  AddId ( ({ "firidion","elf","wirt", "ELF"}) );

  create_default_npc(18);

  SetProp( P_NAME, "Firidion");
  SetProp( P_ARTICLE, 0);
  SetProp( P_GENDER, MALE);
  SetProp( P_RACE, "Elf");
  SetProp( P_ALIGN, 650);
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({" mit Besteck, Tellern und Kruegen", 150, DT_BLUDGEON}) );
  SetProp( P_SIZE, 195);
  SetProp( P_DIE_MSG, " serviert sich seine letzte Mahlzeit.\n");

  SetProp( P_MSGIN, "kommt an");
  SetProp( P_MSGOUT, "geht");
  SetProp( P_MMSGIN, "eilt zurueck an die Arbeit");
  SetProp( P_MMSGOUT, "kehrt zurueck in seine Kneipe");
  SetProp( P_MNPC_AREA, ROOM "kneipe" );
  SetProp( P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp( P_MNPC_DEFAULTROOM, ROOM "kneipe");
  SetProp( P_MNPC_FLAGS, MOV_INDOORS+ MOV_OUTDOORS+ MOV_MOVES+ MOV_BACKWARDS);
  
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Firidion sagt: Danke, das kann ich sicher brauchen!\n" }) );

  SetProp( P_LOG_INFO,"feyaria/tenobaal");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Ich bin nur der Wirt hier.\n",
    "sagt: Bestell doch lieber was!\n",
    "sagt: Das viele Fragen macht Dich sicher durstig!\n",
    "sagt: Ich weiss vieles, aber das nicht.\n" }) );
  AddLibrary( NPC "elfendorf.lib",1);
  AddInfo( ({"firidion", "wirt"}), "nickt.\n");
  AddInfo( ({"wirtshaus", "kneipe", "taverne", 
             "zum spitzohrigen bogenschuetzen"}),
    "Meine Taverne heist 'Zum spitzohrigen Bogenschuetzen'.", "sagt: ");  
  AddInfo( ({"wasser", "quellwasser"}),
    "Quellwasser ist sehr erfrischend und billig.", "sagt: ");
  AddInfo( ({"fruechtetraum", "traum"}),
    "Der Fruechtetraum ist eine Mischung aus verschiedenen Freuchten des "
    "Dschungels und schmeckt ganz hervorragend.", "sagt: ");
  AddInfo( ({"wein", "elfenwein"}),
    "Elfenwein ist das richtige fuer einen beschaulichen Abend.", "sagt: ");
  AddInfo( ({"bier"}),
    "An Bier hab ich hier nur das Privatfass des Schmiedes. Wir Elfen "
    "trinken lieber Wein.", "sagt: ");
  AddInfo( ({"forelle", "gebratene forelle"}),
    "Die Forellen stammen aus dem See hier und schmecken einfach himmlisch.",
    "sagt: ");
  AddInfo( ({"remueserolle a la pfeil und bogen", "gemuese", "rolle", 
             "gemueserolle", "spezialitaet", "spezialitaet des hauses"}),
    "Gemueserolle a la Pfeil und Bogen ist die Spezialitaet des Hauses.",
    "sagt: ");

  SetProp(P_NOMAGIC, 10);
  SetProp( P_SPELLRATE,25);
  AddSpell( 2,150,
    "Firidion bewirft Dich mit Kruegen.\n",
    "Firidion bewirft @WEN mit Kruegen.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  AddSpell( 1,350,
    "Firidion bewirft Dich mit Tellern.\n",
    "Firidion bewirft @WEN mit Tellern.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetChats(4, ({
    "Firidion fragt Dich: Hast Du Hunger?\n",
    "Firidion fragt Dich: Hast Du Durst?\n",
    "Firidion fragt Dich: Darf ich noch was bringen?\n",
    "Firidion sagt: Probier doch eine Gemueserolle a la Pfeil und Bogen.\n",
    "Firidion mixt eine neue Portion Fruechtetraum.\n",
    "Firidion braet eine Forelle.\n",
    "Firidion macht eine Flasche Elfenwein auf.\n",
    "Firidion bietet Dir ein Glas Quellwasser an.\n",
    "Firidion sagt: Willkommen im spitzohrigen Bogenschuetzen.\n",
    "Firidion bringt den Gaesten etwas zu Trinken.\n"
    }) );

  SUID;

  CLONEME( ARMOUR "b_weste" );
  if (!random(3) ) CLONEME( ARMOUR "b_hose");
  command( "trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Warum machst Du so boese Sachen, "+TPN+"?");
}

void intim()
{
  if( TP->QueryProp(P_RACE)!="Zwerg")
  {
    if( TP->QueryProp(P_GENDER) == QueryProp(P_GENDER) )
      command_me("sag Bist Du vielleicht anders rum, "+TPN+"?");
    else
    {
      write(Name(WER,1)+" schmiegt sich an Dir an und fluestert: Du bist "
        "lieb, "+TPN+".\n");
      tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an und "
        "fluestert etwas.\n");
    }
  }
  else
    command_me("sag Lass das, Du Zwerg!");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " treostet "+TPN+".\n", ({TP, TO}) );
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
    write_file(LOG "elfendorf", ctime()+": "+Name(WER,1)+
                  " hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

varargs void die(int poisondeath)
{
  if( objectp(QueryProp(P_KILLER)) )
    environment(this_object())->set_ban(getuid(QueryProp(P_KILLER)),100);
  ::die(poisondeath);
}

