// Die Schneiderin vom Bauschladen
// 19-08-97 Feyaria@SilberLand

inherit "std/repair";

#include "../def.h"
#include "../quest.h"

void init()
{
  ::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

   SetProp( P_SHORT, "Die Schneiderin");
   SetProp( P_LONG, 
     "Die Schneiderin ist ein huebsche, junge Elfe mit langen, goldblonden "
     "Haaren. Sie verkauft hier ihre selbstgefertigten Bauschkleider. "
     "Mit ihren amethystvioletten Augen prueft sie Deine Kleidung und "
     "irgendwie keimt in Dir der Wunsch nach neuen Kleidern auf." );
  AddId ( ({ "schneiderin","elf","elfe", "elfin", "ELF"}) );

  create_default_npc(16);

  SetProp( P_NAME, "Schneiderin"); 
  SetProp( P_GENDER, FEMALE);
  SetProp( P_RACE, "Elf");
  SetProp( P_ALIGN, 850);
  SetProp( P_MAX_HANDS, 2);
  SetProp( P_HANDS, ({" mit ihren Naehnadeln", 160, DT_PIERCE}) );
  SetProp( P_SIZE, 180);

  SetProp( P_DIE_MSG,
    " schneidert sich noch schnell ein Totengewand und stirbt.\n" ); 
  SetProp( P_MURDER_MSG,
    "Zum Glueck hab ich gerade mein Totengewand fertig, %s!");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Schneiderin sagt: Vielen Dank!\n" }) );

  SetProp( P_LOG_INFO,"feyaria/elfendorf");
  AddInfo( DEFAULT_INFO, ({
    "sagt: Du brauchst dringend neue Kleidung.\n",
    "sagt: Hast Du schon von den Vorzuegen des Bausches gehoert?\n",
    "sagt: Kauf doch etwas!\n" }) );
  AddLibrary( NPC "elfendorf.lib",1);

  AddInfo( ({"tochter", "ayaldriel", "unterwaesche", "dessous"}),
      "Meine Tochter Ayadriel verkauft Unterwaesche, hier gleich nebenan.",
      "sagt: ");
  AddInfo( ({"schneiderin"}), "nickt.\n");
  AddInfo( ({"laden", "bauschladen", "angebot"}),
    "Das ist mein Bauschladen. Wenn Du Dich ueber das Angebot informieren "
    "willst, dann mach einfach 'zeige'.", "sagt: ");
  AddInfo( ({"bausch"}),
    "Bausch ist ein tolles Material. Es ist voellig wasserdicht und trotzdem "
    "sehr leicht und luftig.", "erklaert: ");  
  AddInfo( ({"kleidung", "rock", "bluse", "weste"}),
    "Das kannst Du bei mir kaufen.", "sagt: ");

  SetProp(P_NOMAGIC, 10);
  SetProp( P_SPELLRATE,25);
  AddSpell( 5,350,
    "Die Schneiderin wirft Dir einen Bauschballen auf den Kopf.\n",
    "Die Schneiderin wirft @WEM einen Bauschballen auf den Kopf.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]) );
 
  SetChats(3, ({
    "Die Schneiderin prueft einen Bauschballen.\n",
    "Die Schneiderin zeigt Dir ein huebsches Kleid.\n",
    "Die Schneiderin zeigt Dir eine schoene Weste.\n",
    "Die Schneiderin sagt: Du brauchst dringend neue Kleidung.\n",
    "Die Schneiderin fragt: Willst Du diesen Rock probieren?\n",
    "Die Schneiderin sortiert ihre Kleidungsstuecke.\n" }) );

  SUID;

  if( random(2) )
  {
    CLONEME( ARMOUR "b_kleid" );
  }
  else
  {
    CLONEME( ARMOUR_ELF "rock" );
    CLONEME( ARMOUR "bluse" );
  }
  if( !random(5)  )
    CLONEME( ARMOUR "seidentuch");
  command("trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Warum machst Du so boese Sachen, "+TPN+"?");
}

void intim()
{
  if( TP->QueryProp(P_RACE)!="Zwerg")
  {
    if( TP->QueryProp(P_GENDER) == QueryProp(P_GENDER) )
      command_me("sag Bist Du vielleicht anders rum, "+TPN+"?");
    else
    {
      write(Name(WER,1)+" schmiegt sich an Dir an und fluestert: Du bist "
        "lieb, "+TPN+".\n");
      tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an und "
        "fluestert etwas.\n");
    }
  }
  else
    command_me("sag Lass das, Du Zwerg!");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " treostet "+TPN+".\n", ({TP, TO}) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "elfendorf", ctime()+": "+Name(WER,1)+
                 " hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

int rep_auswahl(object ob)
{
  if( ob->QueryProp(P_WEAPON_TYPE) )
  {
    write("Die Schneiderin sagt: Ich repariere keine Waffen!\n");
    return 0;
  }
  if( ob->QueryMaterialGroup(MATGROUP_CLOTH)<20 )
  {
    write("Der Schneiderin sagt: Ich kann das nicht zusammenflicken!\n");
    return 0;
  }
  return 1;
}

