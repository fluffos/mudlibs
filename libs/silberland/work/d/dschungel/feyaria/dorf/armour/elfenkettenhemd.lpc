// /d/dschungel/feyaria/dorf/armour/elfenkettenhemd.c
// Ein Elfenkettenhemd fuer die Elfenwachen
// 1997-11-23 Feyaria@SilberLand 

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Elfenkettenhemd");
  SetProp(P_LONG, BS( 
    "Ein extrem wertvolles Elfenkettenhemd aus funkelndem Adamant. Frueher "
    "trugen fast alle erfahrenen Elfen solche Kettenhemden, aber mittlerweile "
    "sind sie eine echte Raritaet geworden und der Besitzer einer solchen "
    "Ruestung kann sich gluecklich schaetzen.") );
  SetProp(P_INFO, BS(
    "Diese Ruestung is so ziemlich das Beste, was ein Elf tragen kann. "
    "Allerdings braucht man schon sehr viel Erfahrung, um wuerdig genug zu "
    "sein, solch ein edles Stueck zu tragen.") );
  SetProp(P_NAME, "Elfenkettenhemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"elfenkettenhemd", "kettenhemd", DRUID_ALLOWED_METAL_ITEM}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 37);
  SetProp(P_MATERIAL, ([MAT_ADAMANT:100]) );
  SetProp(P_WEIGHT, 650);
  SetProp(P_VALUE, 6500);
  SetProp(P_MAGIC, 4);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([ SR_INCLUDE_RACE:({"Elf", "Dunkelelf"}), 
    A_DEX:15, A_STR:12, P_LEVEL:15, P_QP:150]) );
  AddProp(P_DAM_PROTECTION, ([DT_ACID:1, DT_UNHOLY:1, DT_LIGHTNING:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: random(3)*random(3), P_SP:random(4)*random(3)]) );
  SetProp(P_QUALITY_DECAY, 600);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-1]) );

}

