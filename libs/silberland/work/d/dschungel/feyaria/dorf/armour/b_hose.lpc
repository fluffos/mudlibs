// Eine Hose aus Bausch
// 19-08-97 Feyaria@SilberLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"elfenhose","hose", "bauschhose"}));
  SetProp( P_SHORT, "Eine Hose aus Bausch");
  SetProp( P_LONG,BS(
     "Diese Hose ist aus Bausch gefertigt und fuer die Proportionen eines "
     "Elfen geschneidert."));
  SetProp( P_NAME, "Bauschhose");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 400);
  SetProp( P_VALUE, 390);

  SetProp( P_ARMOUR_TYPE, AT_TROUSERS);  // siehe sys/combat.h
  SetProp( P_AC, 5);

  SetProp( P_MATERIAL, MAT_BAUSCH);
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Elf"})]));
  AddProp( P_DAM_PROTECTION, ([DT_WATER:1]) );
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:1]) );

  AddDetail(({"bausch"}), 
    "Bausch, wie in nur die Elfen verwenden.");
}
