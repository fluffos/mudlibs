// ***     Objekt --- Ruestung
// ***     Azrael@SilberLand
// ***     b_weste.c
// ***     ----- eine Bauschweste

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"bauschweste","weste"}));
  SetProp( P_SHORT, "Eine Bauschweste");
  SetProp( P_LONG,
          "Diese Bauschweste schuetzt nicht nur im Kampf, sondern sie ist "
          "auch wasserfest.\n");
  SetProp( P_INFO, "Diese Bauschweste schuetzt hervorragend gegen Wasser.\n");
  SetProp( P_NAME, "Bauschweste" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_WEIGHT, 500 );
  SetProp( P_VALUE, 300 );
  SetProp( P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp( P_AC, 12 );
  SetProp( P_MATERIAL, MAT_BAUSCH );
  AddProp( P_DAM_PROTECTION, ([DT_WATER:1]) );
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:1]) );
}

