// Ein Bauschkleid 
// 1997-08-19  Feyaria@SilberLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"bauschkleid","kleid"}));
  SetProp( P_SHORT, "Ein Bauschkleid");
  SetProp( P_LONG,
    "Diese Bauschkleid betont die weibliche Figur und ist auch wasserfest. "
    "Es ist mit kleinen bunten Bluemchen bestickt.");
  SetProp( P_INFO, "Dieses Bauschkleid schuetzt hervorragend gegen Wasser.\n");
  SetProp( P_NAME, "Bauschkleid" );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_WEIGHT, 500 );
  SetProp( P_VALUE, 300 );
  SetProp( P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp( P_AC, 17 );
  SetProp( P_MATERIAL, MAT_BAUSCH );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
  AddProp( P_DAM_PROTECTION, ([DT_WATER:1]) );
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:1]) );
}

