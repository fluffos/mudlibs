// Eine Bluse aus Bausch
// 19-08-97 Feyaria@SilberLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"elfenbluse","bluse", "bauschbluse"}));
  SetProp( P_SHORT, "Eine Bluse aus feinstem Bausch");
  SetProp( P_LONG,BS(
     "Diese Bluse ist aus feinsten Bausch gewebt und fuehlt sich so weich "
     "wie Seide an."));
  SetProp( P_NAME, "Bluse");
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 300);
  SetProp( P_VALUE, 590);

  SetProp( P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp( P_AC, 13);
  AddProp( P_DAM_PROTECTION, ([DT_WATER:1]) );

  SetProp( P_MATERIAL, MAT_BAUSCH);
  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]));
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:1]) );

  AddDetail(({"bausch"}), 
    "Feinster Bausch, fast wie Seide.");
}
