// Eine Seidentuch
// 19-08-97 Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"tuch", "seidentuch"}));
  SetProp( P_SHORT, "Ein Seidentuch");
  SetProp( P_LONG,
     "Dieses Seidentuch Seidentuch wurde aus der besten Seide hergestellt "
     "und schuetzt den Hals einer vornehmen Dame sowohl vor Hitze als auch "
     "vor Kaelte.");
  SetProp( P_NAME, "Seidentuch");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_WEIGHT, 10);
  SetProp( P_VALUE, 999);

  SetProp( P_ARMOUR_TYPE, AT_AMULET);
  SetProp( P_AC, 1);

  SetProp( P_MATERIAL, MAT_SILK);
  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]));
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:2]) );

  AddDetail(({"seide"}), 
    "Die verwendete Seide ist wirklich von hoechster Qualitaet.");
}
