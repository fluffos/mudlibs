#include "../def.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein altes, zweihaendiges Schwert names 'Orkenspalter'");
  SetProp(P_LONG, 
    "In den Griff dieses wunderbaren, zweihaendigen Schwertes ist mit alter "
    "verschnoerkelter Schrift der Name 'Orkenspalter' eingraviert. Die lange, "
    "schmale Klinge funkelt im Licht wie volkommen neu, trotzdem muss das "
    "eine sehr alte Waffe sein, denn sie besteht aus einer Dir unbekannten "
    "Metall-Legierung; scheinbar ist das Wissen um die Herstellung "
    "solcher Waffen schon verloren gegangen. Der Griff ist mit vielen "
    "Verzierungen geschmueckt. Trotz des unbestreitbaren Alters ist dies "
    "noch immer eines der besten Schwerter die Du je in Deinem Leben in "
    "den Haenden gehalten hast.");
  SetProp(P_NAME, "Orkenspalter");
  SetProp(P_GENDER, MALE);
  AddId( ({"orkenspalter", "spalter", "schwert", "zweihaender", 
        "\nberserker_spalten_waffe"}) );  
  SetProp(P_INFO, BS(
    "Diese Waffe stammt aus dem Zeitalter der Helden und wurde von den "
    "alten Elfen erschaffen, um gegen die Orks zu kaempfen."));
  
  AddDetail( ({"verzierungen", "schriftzug", "schnoerkel"}),
    "Sowohl die Verzierungen als auch die Schnoerkel des Schriftzug lassen "
    "auf alte elfische Handwerkskunst schliessen.");
  AddDetail( ({"legierung"}),
    "Diese Legierung verwendet heute niemand mehr, eigentlich schade.");  
  AddDetail( ({"griff", "klinge"}),
    "Sowohl Griff als auch die Klinge bestehen aus dieser seltsamen Legierung.");  

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_QUALITY_DECAY, 280);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 6700);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:28, A_STR:25]) );
  SetProp(P_MATERIAL, ([MAT_STEEL:40, MAT_MITHRIL:40, MAT_IRIDIUM:10, MAT_COBALT:10]) ); 
  call_other("/p/daemon/itemd/functions/hitfuncorc1", "???");
  SetProp(P_HIT_FUNC, find_object("/p/daemon/itemd/functions/hitfuncorc1"));  
  SetProp(P_WC_BONUS, (["gilagas":300]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:4]) );
}


