// /d/dschungel/feyaria/dorf/weapon/tbogen.c
// Der Bogen von Tenobaal 
// 1997-08-12  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  if(file_name(PO)!="/p/daemon/itemd/itemd" && !IS_ARCH(PO)) {
    raise_error("Illegales Clonen des Uniques! ");
    destruct();
    return;
  }
  SetProp( P_SHORT, "Tenobaals Bogen");
  SetProp( P_LONG, BS( 
    "Dies ist der wunderbare Bogen von Tenobaal. Er liegt leicht in der "
    "Hand und man kann wohl jedes Ziel damit treffen.") );
  SetProp( P_INFO, 
    "Nur sehr geschickte Elfen beherrschen den Umgang mit diesem Bogen.\n");
  SetProp( P_NAME, "Tenobaals Bogen");
  SetProp( P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId( ({"tenobaals bogen", "bogen"}) );

  SetProp( P_WEAPON_TYPE, WT_BOW );
  SetProp( P_WC, 270 );
  SetProp( P_WC_FIX, 60);
  SetProp( P_WC_BONUS, (["tenobaal":300]) );
  SetProp( P_DAM_TYPE, DT_PIERCE );
  SetProp( P_NR_HANDS, 2);
  SetProp( P_MATERIAL, ([MAT_ASH_WOOD:95, MAT_PLANT:5]) );
  SetProp( P_WEIGHT, 900);
  SetProp( P_VALUE, 5300);
  SetProp( P_QUALITY_DECAY, 350);
  SetProp( P_WIELD_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Elf"}), SR_SEER:1,
                                   A_DEX:27, A_INT:23, A_STR:17]) );
  SetProp( P_HIT_FUNC, TO); 
}

int HitFunc(object enemy)
{
  if( enemy->QueryProp(P_RACE) == "Elf" )
    return -100;
  else
    return random(50);
}

void reset()
{
  object ob;
  ::reset();
  if  (!is_clone(TO) )  return;
  if ( !random(1000) && ((MENV && interactive(ob=MENV)) || 
      (MENV && ENV(MENV) && interactive(ob=ENV(MENV)))))
  {
    tell_object(ob, "Tenobaals Bogen loest sich in Luft auf.\n");
    remove();
  } 
}
