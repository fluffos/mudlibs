// /d/dschungel/feyaria/dorf/weapon/kriegsbogen.c
// Ein starker Bogen 
// 1999-10-30  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";


void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Ein Kriegsbogen");
  SetProp( P_LONG, BS( 
    "Dieser starke Bogen ist aus einem biegsamen Holz gefertigt.") );
  SetProp( P_NAME, "Kriegsbogen");
  SetProp( P_GENDER, MALE);
  AddId( ({"kriegsbogen", "bogen"}) );

  SetProp( P_WEAPON_TYPE, WT_BOW );
  SetProp( P_WC, 230 );
  SetProp( P_WC_FIX, 40);
  SetProp( P_WC_BONUS, (["tenobaal":300]) );
  SetProp( P_DAM_TYPE, DT_PIERCE );
  SetProp( P_NR_HANDS, 2);
  SetProp( P_MATERIAL, ([MAT_ASH_WOOD:95, MAT_PLANT:5]) );
  SetProp( P_WEIGHT, 1900);
  SetProp( P_VALUE, 1300);
  SetProp( P_QUALITY_DECAY, 150);
  SetProp( P_WIELD_RESTRICTIONS, ([ A_DEX:21, A_INT:13, A_STR:17]) );
}

