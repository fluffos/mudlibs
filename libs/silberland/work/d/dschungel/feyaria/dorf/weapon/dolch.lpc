// /d/dschungel/feyaria/dorf/weapon/dolch.c
// Ein Elfendolch 
// 1997-08-12  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Ein Elfendolch");
  SetProp( P_LONG, BS( 
    "Dieser Elfendolch hat eine sehr scharfe Klinge aus einem glaenzenden "
    "Metall und einen Elfenbeingriff, der mit feinen Verzierungen geschmueckt "
    "ist."));
  SetProp( P_NAME, "Elfendolch");
  SetProp( P_GENDER, MALE);
  AddId( ({"dolch", "elfendolch"}) );

  SetProp( P_WEAPON_TYPE, WT_KNIFE );
  SetProp( P_WC, 70 );
  SetProp( P_WC_FIX, 80);
  SetProp( P_WC_BONUS, (["ELF":80, "Elfenspieler":30]) );
  SetProp( P_DAM_TYPE, DT_PIERCE );
  SetProp( P_NR_HANDS, 1);
  SetProp( P_QUALITY_DECAY, 500);
  SetProp( P_MATERIAL, ([MAT_ADAMANT:60, MAT_IVORY:40]) );
  SetProp( P_WEIGHT, 200);
  SetProp( P_VALUE, 1000);
  SetProp( P_WIELD_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Elf"})]) );
}

