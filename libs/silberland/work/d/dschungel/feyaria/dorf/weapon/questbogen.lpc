// /d/dschungel/azrael/dorf/weapon/questbogen.c
// Der selbstgebaute Bogen fuer die Quest 
// 1997-08-14  Feyaria@SilberLand

#include "../def.h"
#include "../quest.h"
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Dein selbstgebauter Bogen");
  SetProp( P_LONG, BS( 
    "Du bist sehr stolz, dass Du diesen Bogen selbst gebaut hast. Sicher "
    "wirst Du damit den Bogenwettkampf gewinnen.") );
  SetProp( P_NAME, "Bogen");
  SetProp( P_GENDER, MALE);
  AddId( ({"bogen", QUEST_BOGEN}) );

  SetProp( P_WEAPON_TYPE, WT_BOW );
  SetProp( P_WC, 50 );
  SetProp( P_DAM_TYPE, DT_PIERCE );
  SetProp( P_NR_HANDS, 2);
  SetProp( P_MATERIAL, ([MAT_TICTOC_WOOD:95, MAT_PLANT:5]) );
  SetProp( P_WEIGHT, 400);
  SetProp( P_VALUE, 0);
  SetProp( P_NODROP, "Nie wuerdest Du Deinen selbstgebauten Bogen hergeben!\n");
  SetProp( P_NOSELL, "Nie wuerdest Du Deinen selbstgebauten Bogen hergeben!\n");

}

