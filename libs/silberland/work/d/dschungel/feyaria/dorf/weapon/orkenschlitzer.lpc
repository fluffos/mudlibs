#include "../def.h"

inherit "/std/weapon";

int check(string type);

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Kurzschwert names 'Orkenschlitzer'");
  SetProp(P_LONG, 
    "In den Griff dieses wunderbaren Kurzschwertes ist mit alter "
    "verschnoerkelter Schrift der Name 'Orkenschlitzer' eingraviert. Die kurze, "
    "breite Klinge funkelt im Licht wie vollkommen neu, trotzdem muss das "
    "eine sehr alte Waffe sein, denn sie besteht aus einer Dir unbekannten "
    "Metall-Legierung; scheinbar ist das Wissen um die Herstellung "
    "solcher Waffen schon verloren gegangen. Der Griff ist mit vielen "
    "Verzierungen geschmueckt. Trotz des unbestreitbaren Alters ist dies "
    "noch immer eines der besten Schwerter die Du je in Deinem Leben in "
    "den Haenden gehalten hast.");
  SetProp(P_NAME, "Orkenschlitzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"orkenschlitzer", "schlitzer", "schwert", "kurzschwert" }) );  
  SetProp(P_INFO, BS(
    "Diese Waffe stammt aus dem Zeitalter der Helden und wurde von den "
    "alten Elfen erschaffen, um gegen die Orks zu kaempfen. Man kann "
    "Orkenschlitzer sowohl als Schwert als auch als Dolch fuehren."));
  
  AddDetail( ({"verzierungen", "schriftzug", "schnoerkel"}),
    "Sowohl die Verzierungen als auch die Schnoerkel des Schriftzug lassen "
    "auf alte elfische Handwerkskunst schliessen.");
  AddDetail( ({"legierung"}),
    "Diese Legierung verwendet heute niemand mehr, eigentlich schade.");  
  AddDetail( ({"griff", "klinge"}),
    "Sowohl Griff als auch die Klinge bestehen aus dieser seltsamen Legierung.");  

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 75);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_QUALITY_DECAY, 280);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 4700);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:28, A_STR:15]) );
  SetProp(P_MATERIAL, ([MAT_STEEL:40, MAT_MITHRIL:40, MAT_IRIDIUM:10, MAT_COBALT:10]) ); 
  call_other("/p/daemon/itemd/functions/hitfuncorc1", "???");
  SetProp(P_HIT_FUNC, find_object("/p/daemon/itemd/functions/hitfuncorc1"));  
  SetProp(P_WC_BONUS, (["gilagas":300]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:4]) );

  AddCmd( ({"fuehre", "fuehr"}), "cmd_fuehren");
}

int cmd_fuehren(string str)
{
  string was;

  notify_fail("Was willst Du fuehren?\n");
  if(!str || str == "") return 0;

  if( sscanf(str, "%s als dolch", was) == 1 && id(was) )
  {
    if( !check(WT_KNIFE) ) return -1;
    write("Du fuehrst Orkenschlitzer jetzt als Dolch.\n");
    SetProp(P_WEAPON_TYPE, WT_KNIFE);
    AddId("dolch");
    RemoveId("schwert");
    return 1;
  }
  else if( sscanf(str, "%s als schwert", was) == 1 && id(was) )
  {
    if( !check(WT_SWORD) ) return -1;
    write("Du fuehrst Orkenschlitzer jetzt als Schwert.\n");
    SetProp(P_WEAPON_TYPE, WT_SWORD);
    RemoveId("dolch");
    AddId("schwert");
    return 1;
  }
  return 0;
}

int check(string type)
{
  if( QueryProp(P_WEAPON_TYPE) == type)
  {
    write("Aber Du fuehrst Orkenschlitzer doch schon als " +
        (type == WT_KNIFE ? "Dolch" : "Schwert") + "!\n");
    return 0;
  }
  if( QueryProp(P_WIELDED) )
  {
    write("Du musst Orkenschlitzer zuerst wegstecken, um ihn anders "
        "zu fuehren!\n");
    return 0;
  }
  return 1;
}
