// /d/dschungel/feyaria/tijara/weapon/drachentoeter.c
// Ein Drachentoeter, eine wirklich maechtige Waffe zum Kampf gegen Drachen
// 23-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

string oldtitle;

create()
{
  if( !is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Der Drachentoeter");
  SetProp(P_LONG, BS( 
    "Der Drachentoeter ist eine lange Lanze, deren Spitze mit vielen "
    "Widerhaken ausgeruestet ist. Sie ist die einzige Waffe, mit der man "
    "einen grossen Drachen vernuenftig bekaempfen kann. Der Stiel der Lanze "
    "besteht aus hartem Eichenholz, und die widerhakenbestueckte Spitze wurde "
    "aus feinstem Mithril geschmiedet. Nur die begabtesten Schmiede der Zwerge "
    "sind in der Lage, eine solche Waffe herzustellen.") );
  SetProp(P_NAME, "Drachentoeter");
  SetProp(P_INFO, BS(
    "Dies ist eine Drachenlanze aus dem Reich der Legende. Selbst der "
    "staerkste Drache laesst sich mit dieser Lanze toeten. Weil der "
    "Drachentoeter aber so lange ist, ist er gegen kleine Wesen fast "
    "unwirksam.") );
  SetProp(P_GENDER, MALE);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_PIERCE}) );
  SetProp(P_WC, 300);
  SetProp(P_WC_FIX, 40);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:30, MAT_OAK:70]) );
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 33333);
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_UNWIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([P_XP:2222222, 
                                  SR_SEER: 1,
                                  A_STR: 25]) );
  
  AddId( ({"drachentoeter", "toeter", "lanze", "drachenlanze"}) );

  AddDetail( ({"spitze", "widerhaken"}), BS(
    "Die Widerhaken an der Spitze koennen sogar fuer einen Drachen toedlich "
    "sein.") );
}

int WieldFunc(object waffe)
{
  oldtitle=TP->QueryProp(P_TITLE);
  if( TP->QueryProp(P_GENDER)==FEMALE )
    TP->SetProp(P_TITLE, "die Drachenjaegerin");
  else
    TP->SetProp(P_TITLE, "der Drachenjaeger");
  return 1;
}

int UnwieldFunc(object waffe)
{
  TP->SetProp(P_TITLE, oldtitle);
  return 1;
}

int HitFunc(object enemy)
{
  int schaden;
  if( enemy->QueryProp(P_SIZE)<100 )
  {
    write(BS(CAP(enemy->name(WER) )+" ist zu klein um mit dieser Waffe "
      "getroffen zu werden."));
    return -350;
  }
  if( enemy->QueryProp(P_SIZE)<200 && random(2) )
  {
    write( CAP(enemy->name(WER) )+" weicht Deiner Attacke aus.\n");
    return -250;
  }
  if( enemy->QueryProp(P_RACE)=="Drache" )
  {
    schaden=50+random(200);
    if( random(1000)==666 )
    {
      write("Die Magie der Drachenlanze vernichtet "+enemy->name(WEN)+".\n");
      return 800+random(800);
    }
    if( schaden>200)
      write("Die Magie der Drachenlanze wendet sich gegen "+
       enemy->name(WEN)+".\n");
    return 2*enemy->QueryProp(P_LEVEL)+schaden;
  }
  return 0;  
}
