// /d/dschungel/feyaria/tijara/npc/traeger2.c   
// Ein Lastentraeger
// 26-11-1996  Feyaria@SilberLand

#include "../def.h"
#include "../rattenquest.h"

inherit "std/mnpc";

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Lastentraeger");
  SetProp(P_LONG, BS(
    "Dieser kleine Hobbit schleppt schwere Lasten zwischen dem Kontor und "
    "den Lagerhallen hin und her."));
  SetProp(P_NAME, "Lastentraeger");
  SetProp(P_GENDER, MALE);
  AddId(({"lastentraeger", "hobbit", "traeger", "schlepper", "\ntraeger"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen schwielenbedeckten Haenden", 30 ,
      DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 95+random(10));
  SetProp(P_ALIGN, 127+random(30));
  SetAttribute(A_STR, 50); //damit er schwere Lasten schleppen kann.
  SetProp(P_NOATTACK, "sagt: So lass mich doch in Ruhe!");
  
  SetProp(P_DIE_MSG,  " hat sich zu Tode geschleppt.\n");

  AddInfo(DEFAULT_INFO, ({
    "schleppt sich weiter.\n",
    "schaut Dich mit fragendem Blick an.\n",
    "deutet auf seine schwere Last.\n",
    "wischt sich den Schweiss von der Stirn.\n",
    "staunt: Du kannst aber Fragen stellen!\n"}) );
  AddLibrary( NPC "tijara.lib",1);
  AddInfo("feyaria",
    "Feyaria hat mich erschaffen.", "sagt: ");
  AddInfo( ({"lasten", "kisten", "ballen", "last", "kiste"}),
    "Die Lasten sind vielleicht schwer.", "stoehnt: ");
  AddInfo( ({"aufgabe", "beruf", "dienst", "arbeit", "job"}),
    "Ich schleppe Lasten zwischen dem Lagerhaus und dem Kontor hin und her.",
    "seufzt: ");
  AddInfo( ({"lagerhaus", "kontor", "laden", "weg"}),
    "Der Weg zwischen Lagerhaus und Kontor ist soooo weit.\n", "stoehnt: ");
  AddInfo( ({"gardist", "gardisten"}),
    "Die Gardisten lachen immer ueber mich.\n", "beschwert sich: ");
  AddInfo( ({"dschungel", "tiere", "pflanzen"}),
    "Der Dschungel ist voller gefaehrlicher Tiere und Pflanzen.", "sagt: ");
  AddInfo( ({"schweiss"}),
    "Die Arbeit bringt mich richtig zum Schwitzen.", "stoehnt: ");
  AddInfo( ({"pfeife", "pfeifen", "holzpfeifchen", "holzpfeife", "pfeifchen"}),
      "@@pfeife@@", "", 1);
  AddInfo( ({"holz"}),
    "Am besten eignet sich das Holz von Haselstraeuchern fuer das Schnitzen "
    "von Pfeifchen.", "vertraut Dir an: ");
  AddInfo( ({"haselstraeucher", "haselstrauch"," haselstrauchholz"}),
    "Haselstraeucher wachsen nur im Norden in Waldgebieten.", "verraet Dir: ");
  AddInfo( ({"waldgebiete", "waldgebiet", "waldgebieten", "hobbingen"}),
    "Die schoensten Waldgebiete gibt es oestlich von Hobbingen am Fusse der "
    "Berge.", "schwaermt: ");
  AddInfo( ({"schnitzen"}),
    "Ich schnitze sehr gerne. Mit dem richtigen Schnitzmesser geht das ganz "
    "einfach.", "sagt: ");
  AddInfo( ({"messer", "schnitzmesser", "taschenmesser"}),
    "Ich verwende meist ein Taschenmesser. Du kannst hier im Waffenladen "
    "eines kaufen. Zwar ist es nicht so gut wie mein altes Familienerbstueck, "
    "aber, man kann auch schoene Sachen damit schnitzen.", "erzaehlt: ");
  AddInfo( ({"erbstueck", "familienerbstueck"}),
    "Mein Schnitzmesser ist alles was ich von meinem Grossvater geerbt habe.",
    "sagt stolz: ");
  AddInfo( ({"waffenladen"}),
    "Der Waffenladen liegt am Hauptplatz von Tijara.", "gibt Auskunft: ");
  AddInfo( ({"hobbit", "hobbits"}),
    "Ja, ich bin ein Hobbit!", "sagt stolz: ");
  SetProp(P_LOG_INFO, "feyaria/traeger.log");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Lastentraeger sagt: Ich schleppe schon genug mit mir herum.\n"}) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);

  SetChats(1, ({
    "Der Lastentraeger wischt sich den Schweiss von der Stirn.\n",
    "Der Lastentraeger stoehnt: Puh, ist das schwer!\n"}) );
  SetAttackChats(2, ({
    "Der Lastentraeger ruft: So lass mich doch in Ruhe!\n"}) );

  SetProp(P_MSGIN, "schleppt sich herein");
  SetProp(P_MSGOUT, "schleppt seine schwere Last");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft in seine Lagerhalle zuruek");

  SetProp (P_MNPC_AREA, ({ROOM "lagerhalle_b3", ROOM "weg_b2", 
                          ROOM "weg_c2", ROOM "laden_c3"}) );
  SetProp (P_MNPC_WAIT, 10);
  SetProp (P_MNPC_DEFAULTROOM, ROOM "lagerhalle_b3");
  SetProp (P_MNPC_FLAGS, MOV_MOVES+ MOV_INFIGHT+MOV_CMDS+MOV_MAYLOAD);
  SetProp (P_MNPC_CMDS,({"nimm kiste", "norden", "osten", "sueden",
     "lass kiste fallen", "nimm ballen", "norden", "westen", "sueden",
     "lass ballen fallen", "nimm last", "norden", "osten", "sueden",
     "lass last fallen", "nimm kiste", "norden", "westen", "sueden",
     "lass kiste fallen", "nimm ballen", "norden", "osten", "sueden",
     "lass ballen fallen", "nimm last", "norden", "westen", "sueden",
     "lass last fallen"}) );

  CLONEME( "/d/huegelland/feyaria/weg/obj/pfeife");
}

string pfeife()
{
  if( present( RATTENQUESTID, TP) )
  {
    write( break_string ("Ich liebe Holzpfeifchen. Meistens schnitze ich sie "
          "mir selber aus einem ganz bestimmten Holz. Wenn Du eines brauchst, "
          "kannst Du ja meines haben. Ich wuerde es sofort gegen etwas zu "
          "essen tauschen.", 
          78, "Der Lastentraeger sagt: "));
  }
  else
  {
    write( break_string ("Ich liebe Holzpfeifchen. Meistens schnitze ich sie "
          "mir selber aus einem ganz bestimmten Holz.", 78, 
          "Der Lastentraeger sagt: "));
  }
  return "zeigt Dir sein Holzpfeifchen.";
}

void give_notify(object ob)
{
  if( ob->id("Nahrung") )
  {
    call_out("essen",2, ob);
    write("Der Lastentraeger sagt: Danke! ich hatte schon solchen Hunger!\n");
  }
  else
    ::give_notify(ob);
}

void essen(object ob)
{
  command("iss "+LOWER(ob->name(RAW)) );
  if( ob )
    command("trink "+LOWER(ob->name(RAW)) );
  if( present( RATTENQUESTID, TP) && !deep_present("\nrattenpfeife", TP) )
  {
    CLONE( OBJ "pfeife", TP);
    write("Der Lastentraeger gibt Dir seine Pfeife.\n");
  }
}
