// /d/dschungel/feyaria/tijara/npc/gardist2.c   
// Ein Stadtgardist in Tijara (Torwache)
// 31-10-1996  Feyaria@SilberLand

#include "../def.h"
inherit NPC "gardist";

#define GMASTER NPC "garde_master"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_LONG, 
    "Dieser Stadtgardist bewacht das Stadttor von Tijara.  Er traegt "
    "trotz der Hitze eine bronzene Ruestung und ist mit einer Hellebarde "
    "bewaffnet. Mit seinen strengen Augen mustert er Dich, ob Du nicht "
    "illegale Gueter nach Tijara schmuggeln willst.") ;

//  SetProp(P_SHORT_FIGHT, 
//      "Ein Stadtgardist beschuetzt Tijara gegen %s");
  SetProp(P_SHORT, 
      "Ein Stadtgardist bewacht das Stadttor");
  SetProp(P_NAME, "Stadtgardist");
  AddId( ({"wache", "torwache"}) );

  AddInfo( ({"tor", "stadttor"}),
    "Ich beschuetze dieses Tor.","sagt: ");

  SetProp (P_MNPC_AREA, ROOM );
  SetProp (P_MNPC_WAIT, ({ 100, 90, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "platz_d5");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);


  SetChats(3, ({
    "Der Stadtgardist sagt: Personenkontrolle! Zeig mir Deine Papiere.\n",
    "Der Stadtgardist sagt: Durch dieses Tor gehts in die Wildnis.\n",
    "Der Stadtgardist schreitet vor dem Tor auf und ab.\n",
    "Der Stadtgardist wischt sich den Schweiss von der Stirn.\n"}) );

  SetAttackChats(5, ({
    "Der Stadtgardist ruft: Garde zu mir!\n",
    "Der Stadtgardist schreit: Ich beschuetze das Tor mit meinem Leben!\n",
    "Der Stadtgardist bruellt: Ergib Dich, Verraeter.\n"}) );

  if( !present("armschienen") &&!random(10))
    CLONEME( ARMOUR "armschienen");
  if( !present("beinschienen") &&!random(10) )
    CLONEME( ARMOUR "beinschienen");  
  command("trage alles");
}
