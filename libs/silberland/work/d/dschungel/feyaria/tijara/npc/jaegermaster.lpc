#include "../def.h"

mapping killer = ([]);
mapping kerber = ([]);
string day = "";

void create()
{
  if (is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }
}

void set_killer(string player)
{
  killer += ([player: 1]);
}

int query_killer(string player)
{
  return member(killer, player);
}

void set_kerber(string player)
{
  kerber += ([player: 1]);
}

int query_kerber(string player)
{
  return member(kerber, player);
}

void reset()
{
  set_next_reset(60*60*2);
  kerber = ([]);
  if (dtime()[0..2] != day)
  {
    killer = ([]);
    day = dtime()[0..2];
  }
}

string * all_kerber()
{
  return m_indices(kerber);
}

string * all_killer()
{
  return m_indices(killer);
}
