// Der Gouverneur von Tijara
// 1997-03-02  Feyaria@SilberLand


inherit "std/npc";

#include <ansi.h>
#include "../def.h"
#include "../rattenquest.h"
#include <npcmaster.h>

#define GARDEMASTER NPC "garde_master"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Gouverneur von Tijara");
  SetProp(P_LONG, BS(
    "Der Gouverneur von Tijara ist ein grossgewachsener Elf mit silbergrauen "
    "Haaren, aus denen die Spitzen seiner Ohren herausschauen. Mit seinen "
    "stahlblauen Augen schaut er Dich streng an. In seiner schwarzen "
    "Samtrobe macht er einen vornehmen Eindruck. Sicher ist er ein weiser "
    "und gerechter Gouverneur. Zur Zeit macht er aber einen sehr besorgten "
    "Eindruck. Irgendein schweres Problem lastet auf ihm."));
  SetProp(P_NAME, "Gouverneur");
  SetProp(P_GENDER, MALE);
  AddId(({"gouverneur", "elf"}));
  set_living_name("gouverneur");

  AddDetail( ({"haare", "haar"}),
    "Das Haar des Gouverneurs ist silbergrau.");
  AddDetail( ({"spitzen", "spitze", "ohr", "ohren"}),
    "Die Spitzen der Ohren schauen aus den Haaren heraus.");
  AddDetail( ({"augen", "auge"}),
    "Der Gouverneur hat stahlblaue, glaenzende Augen.");
  AddDetail( ({"robe", "samt", "samtrobe"}),
    "Die Samtrobe veleiht dem Gouverneur einen vornehmen Eindruck.");

  create_default_npc(35);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_HANDS, ({" mit seinen Gouverneurshaenden",333,DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 199);
  SetProp(P_ALIGN, 777);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(DEFAULT_INFO, ({
    "sagt: Ich bin leider zu beschaeftigt.\n",
    "sagt: Das geht Dich gar nichts an.\n",
    "sagt: Hab ich schon von meinem Problem mit den Ratten erzaehlt?\n",
    "sagt: Die Beseitigung der Rattenplage ist viel wichtiger!\n",
    "sagt: Das moechte ich auch gerne wissen.\n",
    "gruebelt ueber diese Frage.\n",
    "staunt nur.\n",
    "fragt: Wie hast Du das jetzt gemeint.\n",
    "denkt kurz nach und schuettelt dann den Kopf.\n",
    "sagt: Du kannst aber komische Fragen stellen.\n",
    "seufzt: Tut mir leid, darueber weiss ich nichts.\n",
    "sagt: Keine Ahnung.\n",
    "sagt: Hmm, ich werde darueber nachdenken.\n",
    "antwortet etwas, aber Du verstehst es nicht.\n",
    "sagt: Ach ja, wie war das gleich....\n",
    "sagt: War wirklich nett, mit Dir zu plaudern.\n"}) );
  
  AddLibrary( NPC "tijara.lib",1);
  AddLibrary( NPC "spieler.lib",1);

  AddInfo( ({"feyaria", "ehefrau", "frau"}),
    "Feyaria ist meine geliebte Ehefrau.", "sagt: ");
  AddInfo( ({"tochter", "feylinchen", "maedel"}),
    "Feylinchen ist meine Tochter. Ist sie nicht ein suesses Maedel.",
    "sagt: ");  
  AddInfo( ({"aufgabe", "hilfe", "quest", "abenteuer"}),
    "Ich koennte Hilfe gebrauchen. Mein Keller ist voll mit Ratten.",
    "sagt: ");
  AddInfo( ({"ratten", "keller", "plage", "rattenplage", "kellerratten"}),
    "Die Ratten sind eine echte Plage! Wenn Du mir helfen willst, "
    "waere ich Dir sehr dankbar. Gib einfach 'hilf gouverneur' ein.",
    "sagt verzweifelt: ");
  AddInfo( ({"ratte", "kellerratte"}),
    "Eine Ratte waere ja nicht so schlimm, aber der ganze Keller ist mit "
    "Ratten voll.", "sagt: ");
  AddInfo( ({"wein", "weinfaesser", "faesser", "weinfass", "fass", "flasche", 
               "weinflasche", "weinflaschen", "flaschen"}),
    "Sogar an meinem Wein haben sich die Ratten vergriffen.", "seufzt: ");
  AddInfo( ({"vorrat", "vorraete", "lebensmittel", "lebensmittelvorraete"}),
    "Die Ratten fressen alle Lebensmittelvorraete auf.", "sagt verbittert : ");
  AddInfo( ({"name", "beruf", "job", "gouverneur"}),
    "Ich bin der Gouverneur von Tijara.", "sagt stolz: ");
  AddInfo( ({"tijara", "stadt", "land", "silberland"}),
    "Mein Tijara ist die schoeneste Stadt im SilberLand.", "sagt stolz: ");
  AddInfo( ({"dschungel"}),
    "Der Dschungel ist ausserhalb von Tijara.", "sagt: ");
  AddInfo( ({"pfeife", "pfeifchen", "maerchen", "geschichte", "zauber",
               "schutzzauber"}),
    "Da fragst Du besser Elsurion, der ist sehr weise.", "sagt: ");
  AddInfo( ({"elsurion", "kraeuterhaendler", "zauberer"}),
    "Elsurion ist der Kraeuterhaendler. Er ist ein beruehmter Zauberer und "
    "ist sehr weise. Wenn Du Fragen hast, dann kann er Dir sicher helfen.",
    "sagt: ");
  AddDetail( ({"kellertreppe", "kellerstiege", "treppe", "stiege"}),
    "Da gehts in den Keller hinunter. Dort ist alles voller Ratten.",
    "sagt: ");    
  AddInfo( ({"rattengift", "gift"}),
    "Die Ratten sind leider voellig immun gegen Gift.",
     "arglt vor sich hin: ");
  AddInfo( ({"arbeitszimmer", "hinten"}),
    "Nach hinten gehts in mein Arbeitszimmer.", "sagt: ");
  AddInfo( ({"tor", "sehertor"}),
    "Schau doch mal in mein Arbeitszimmer.", "sagt: ");
  AddInfo( ({"erlaubnis"}),
    "Wenn Du mir bei der Rattenplage hilfst, bekommst Du die Erlaubnis, "
    "das Arbeitszimmer zu betreten.", "sagt streng: ");
  AddInfo( ({"fackel", "laden"}),
    "Eine Fackel kannst Du Dir im Laden kaufen.", "sagt: ");
  AddInfo( ({"sohn", "tod"}),
      "Der Tod meines Sohnes schmerzt mich zu sehr, um darueber zu sprechen.", 
      "sagt traurig: ");
  
  SetProp(P_LOG_INFO, "feyaria/gouverneur.log");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Goeverneur ist unbestechlich.\n" }) );

  SetChats(3, ({
    "Der Gouverneur schimpft: Diese dummen Ratten!\n",
    "Der Gouverneur sagt: Was soll ich nur gegen die Ratten unternehmen?\n",
    "Der Gouverneur fragt Dich: Hast Du schon von der Rattenplage gehoert?\n",
    "Der Gouverneur sagt: Diese Kellerratten fressen meine ganzen Vorraete "
      "auf.\n",
    "Der Gouverneur fragt Dich: Kannst Du mir die Ratten vom Leib schaffen?\n",
    "Der Gouverneur seufzt: Ach, ich hab so viel zu tun...\n",
    "Der Gouverneur stoehnt: Die Ratten machen mich noch arm.\n",
    "Der Gouverneur sagt: Sogar an meinen Weinfaessern haben die Ratten sich "
      "vergriffen.\n",
    "Der Gouverneur sagt: Der ganze Keller ist voll mit Ratten.\n", 
    "Der Gouverneur schaut besorgt zur Kellertreppe.\n",
    "Der Gouverneur gruebelt ueber ein schwieriges Problem.\n"}) );

  AddCmd( "hilf", "helfen");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  tell_room(MENV, "Der Gouverneur schreit: Raus hier, Du Boesewicht!\n");
  GARDEMASTER->ruf_um_hilfe(enemy);
  enemy->move(ROOM "platz_d4", M_GO, "", "wird vom Gouverneur hinausgeworfen",
    "fliegt in hohen Bogen aus der Gouverneursvilla heraus.");
  DB( ANSI_BOLD+ANSI_RED+TPN+ " wollte den Gouverneur angreifen!"+
      ANSI_NORMAL+"\n");
  return 0;
}

int helfen(string str)
{
  notify_fail("Wem willst Du helfen?\n");
  if( str!="gouverneur" ) return 0;
  if( present( "\nrattenfaengerquest", TP) )
  {
    write("Der Gouverneur sagt: Aber Du hilfst mir doch schon!\n");
    write("Der Gouverneur sagt: Sagt es mir einfach, wenn alle Ratten weg "
        "sind.\n");
    return 1;
  }
  if( TP->QueryQuest(RATTENQUEST) )
  {
    write("Der Gouverneur sagt: Aber Du hast mir doch schon geholfen!\n"
          "Der Gouverneur sagt: Meinen herzlichsten Dank nochmals.\n");
    return 1;
  }
  write( break_string("Danke, dass Du mir helfen willst. Du hast jetzt die "
    "Erlaubnis, meinen Keller zu betreten. Wenn Du alle Ratten aus meinem "
    "Keller entfernt hast, dann sag mir einfach, dass alle Ratten weg sind. ",
    78,"Der Gouverneur sagt: ") );
  CLONE( OBJ "rattenfaenger", TP);
  call_other( ROOM "keller/d2:"+getuid(TP), "???");
  call_other( ROOM "keller/d4:"+getuid(TP), "???");
  call_other( ROOM "keller/d5:"+getuid(TP), "???");
  call_other( ROOM "keller/d6:"+getuid(TP), "???");
  call_other( ROOM "keller/e2:"+getuid(TP), "???");
  call_other( ROOM "keller/e3:"+getuid(TP), "???");
  call_other( ROOM "keller/e4:"+getuid(TP), "???");
  call_other( ROOM "keller/e5:"+getuid(TP), "???");
  call_other( ROOM "keller/e6:"+getuid(TP), "???");
  call_other( ROOM "keller/f2:"+getuid(TP), "???");
  call_other( ROOM "keller/f3:"+getuid(TP), "???");
  call_other( ROOM "keller/f4:"+getuid(TP), "???");
  call_other( ROOM "keller/f5:"+getuid(TP), "???");
  call_other( ROOM "keller/f6:"+getuid(TP), "???");
  call_other( ROOM "keller/g2:"+getuid(TP), "???");
  call_other( ROOM "keller/g3:"+getuid(TP), "???");   
  return 1;
}

void catch_tell(string str)
{
  string wer,was;
  object ob;
  if(!query_verb())                                                 return;
  if(!TP)                                                           return;
  if(!TI)                                                           return;
  if(TP != TI)                                                      return;
  if(!(query_verb()[0..2] == "sag" || query_verb()[0..0] == "'"))   return;
  if( sscanf(str, "%s sagt: %s", wer, was)==2 )
  {
    was=was[0..strlen(was)-2];
    if(ob=present( RATTENQUESTID, TP) )
    { 
//       if( file_name(ob)!="/dschungel/feyaria/tijara/obj/rattenfaenger")
//       {
//         TP->move("/room/entscheidung",M_NOCHECK);
//         DB(ANIS_RED+"Illegaler Zugriff in Rattenquest!"+ANSI_NORMAL+"\n");
//         return;
//       }
     if( member( ({"alle ratten sind weg", "keine ratte mehr da"
                  "alle ratten sind tot", "ratten sind weg",
                  "ratten sind tot", "ich habe alle ratten getoetet",
                  "alle ratten weg sind", "alle ratten weg"}),
                  was) !=-1 ||
        strstr(was,"alle")!=-1 && strstr(was, "ratten")!=-1 &&
        (strstr(was, "tod")!=-1 || strstr(was, "weg")!=-1 ) )
      {      
        if( ob->quest_fertig() )
        {
          call_out("fertig",0);
          ob->remove();
          return;
        }
        call_out("nicht_fertig",0);
      }
    }
  }
}

void fertig()
{
  write("Der Gouverneur sagt: Oh! Du hast wirklich alle Ratten vertrieben? "
        "Toll!\n"
        "Der Gouverneur sagt: Ich bin dir zu ewigem Dank verpflichtet.\n"
        "Der Gouverneur sagt: Du darfst nun mein Arbeitszimmer betreten und die\n"
        "Der Gouverneur sagt: Buecher dort lesen.\n");
  if( TP->GiveQuest(RATTENQUEST) == 1)
  {
    write_file (RATTENQUESTLOG,
      sprintf ("%s  %s hat die Rattenplage beseitigt.\n",
      dtime(time()), CAP(TP->query_real_name())));
  }
  domainshout("Der Gouverneur ruft: "+TPN+" hat die Rattenplage beseitigt!\n");
}

void nicht_fertig()
{
  write("Der Gouverneur sagt: Nein! Da laeuft sicher noch eine Ratte im "
        "Keller herum.\n");
}

void init()
{
  ::init();
//  if( GARDEMASTER->IsFeind(TP) )
//    Kill(TP);
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if ( (gruppe=="nett" || gruppe=="intim") && !random(2) ) call_out("gut",0);
  else if ( (gruppe=="fies" || gruppe=="frech") && !random(3) ) call_out("boese",0);
  else if ( (gruppe=="traurig" || gruppe=="aengstlich") && !random(2)  )
    call_out("troesten",0);
  else if ( (gruppe=="froh" || gruppe=="albern"|| gruppe=="aergerlich") && !random(3) ) 
    call_out("lustig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  if( verb=="knuddel" )
    call_out("knuddel_alle",0);
  else StartReaction(verb, gruppe, adverb, touch);
}

void gut()
{
  tell_room(MENV, "Der Gouverneur laechelt.\n"); 
}


void boese()
{
  tell_room(MENV, "Der Gouverneur schaut finster.\n"); 
}

void knuddel_alle()
{
  command_me("knuddel alle");
}

void lustig()
{
  command_me("sag Hilfe mir lieber, die Rattenplage zu beseitigen, "+TPN+"!");
}

void troesten()
{
  command_me("troeste "+getuid(TP) );
}

