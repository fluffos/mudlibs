// Schwarzer Drache unter Tijara
// Feyaria@SilberLand

#include "../def.h"

inherit "/p/std/dragons/dragon.lpc";
inherit "/std/npc/spells";

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();    
  SetProp(P_NAME, "Arcanolescokrewanskilang");
  set_living_name("blackwyrm");
  create_default_dragon(1,11,0,20+random(20));
  AddDefaultSpell(1,500,DS_FEAR);
  SetProp(P_SHORT,"Arcanolescokrewanskilang, ein uralter schwarzer Drache"); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_LONG, 
    "Vor Dir steht Arcanolescokrewanskilang, ein uralter schwarzer Drache. "
    "Sein von dicken, schwarzen Schuppen bedeckter Rumpf ist sicher mehr "
    "als 15 Meter lang. Auf seinem schlangengleichen Hals sitzt ein gewaltiger "
    "Kopf mit einem furcheinfloessenden Maul. Seine Zaehne sind so lange wie "
    "Schwerter. Er schaut Dich boese aus seinen tellergrossen roten Augen an. "
    "Eine furchteinfloessende Aura umgibt diesen riesigen Drachen.");
  AddId(({"arcanolescokrewanskilang"}) );
  SetProp(P_SIZE, 15000);
  
  if( !random(10) ) CLONEME( ARMOUR "armband");
  CLONEME( OBJ "wbalsam");
  CLONEME( OBJ "rbalsam");
}

// Kills mitloggen
void die(int poisondeath)
{
  write_file(LOG "drache",
    ctime()+": "+CAP(getuid(TP))+" killt den schwarzen Drachen.\n");
  if( !IS_LEARNER(TP) )
    domainshout(CAP_TPN+
        " hat den schwarzen Drachen bezwungen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "drache",
    ctime()+": Der schwarzen Drache hat gerade "+CAP(getuid(player))+
    " umgebracht.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}

