// /d/dschungel/feyaria/tijara/npc/sammler.c   
// Der Trophaeensammler
// 1998-02-16  Feyaria@SilberLand


inherit "std/npc";

#include "../def.h"
#include "/d/gebirge/feyaria/drachen/drachen.h"
#include "/d/dschungel/feyaria/sumpf/armour/race_guild_armour.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Trophaeensammler");
  SetProp(P_LONG,
    "Der Trophaeensammler ist ein kleiner Zwerg mit dickem weissen Bart. "
    "Raffgierig wie Zwerge so sind, sammelt er alles, was er an Trophaeen "
    "von wilden Tieren bekommen kann. Seine Augen funkeln habgierig. "
    "Er passt genau auf, dass Du keiner seiner wertvollen Trophaeen zu "
    "nahe kommst.");
  SetProp(P_NAME, "Trophaeensammler");
  SetProp(P_GENDER, MALE);
  AddId(({"sammler", "trophaeensammler", "zwerg"}));
  AddDetail( ({"bart"}),
    "Der Bart des Zwerges ist ganz weiss und sehr lange.");
  AddDetail( ({"auge", "augen"}),
    "Die Augen des Zwerges funkeln habgierig.\n");

  create_default_npc(17);
  SetProp(P_HANDS, ({" mit all seinen Trophaeen", 170, DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 126);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:-0.3, DT_POISON:-0.5, DT_MAGIC:0.1, DT_WATER: 0.3]) );

  AddInfo(DEFAULT_INFO, ({
    "schaut Dich erstaunt an.\n",
    "wendet sich von Dir ab.\n",
    "sagt: Wie bitte?\n",
    "grummelt vor sich hin.\n",
    "brummt etwas in seinen langen Bart.\n",
    "streicht ueber seinen Bart und sagt: Hmmmm.\n",
    "sagt: Hast Du nicht eine Trophaee fuer mich?\n"}) );
  AddLibrary( NPC "tijara.lib",1);
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"trophaeen", "trophaee", "sammeln", "sammler",
             "trophaeensammler"}),
    "Ich sammle Trophaeen von allen Tieren, die es gibt.", "sagt: ");
  AddInfo( ({"jaguarkopf", "krokodilschwanz", "bueffelhoerner",
             "hirschgeweih", "ruabtierkrallen", "elefantenstosszahn", 
             "tigerfell", "grizzlybaerkopf"}),
    "Meine Trophaeen sind schoen, nicht wahr?", "sagt stolz: ");
  AddInfo( ({"jaguar", "krokodil", "bueffel", "hirsch", "raubtier", 
             "elefant", "tiger", "grizzlybaer"}),
    "Von diesem Tier habe ich schon Trophaeen!", "sagt stolz: ");
  AddInfo( ({"hilfe", "quest", "queste", "abenteuer"}),
    "Hmm.. Du koenntest mir helfen, den Schatz des Drachenkoenigs zu "
    "finden. Dort befindet sich naemlich die Krone des Drachenkoenigs, "
    "die sicher ein schoenes Stueck fuer meine Trophaeensammlung waere.", 
    "sagt gruebelnd: ");
  AddInfo( ({"krone", "drachenkrone"}),
    "Wenn Du mir die Drachenkrone bringst, werde ich Dich reich belohnen. "
    "Dafuer musst Du aber den Schatz des Drachenkoenigs finden.", "sagt: ");
  AddInfo( ({"schatz", "schaetze", "schatzraum"}),
    "Der Schatz des Drachenkoenigs ist riesengross.", "sagt: ");
  AddInfo( ({"drachenkoenig", "koenig"}),
    "Der Drachenkoenig ist der maechtigste aller Drachen und ihr Herrscher. "
    "Es ist ein alter goldener Drache und angeblich lebt er schon seit "
    "Entstehung des SilberLandes. In seinem langen Leben hat er gewaltige "
    "Schaetze zusammengetragen. Um seinen Hort zu sichern, hat er seinen " 
    "Schatzraum magisch gesichert, sodass ihn nur der Drachenkoenig selbst "
    "betreten kann. Ich habe aber einen Trick gefunden, das zu umgehen!",
    "erzaehlt: ");
  AddInfo( ({"trick"}),
    "Der Trick, den Schatzraum zu betreten, besteht darin, einen besonderen "
    "Stein mit den Essenzen aller verschiedener Drachen aufzuladen. Dann "
    "kann man die Magie umgehen und den grossen Schatzraum des "
    "Drachenkoenigs zu pluendern.", "sagt aufgeregt: ");
  AddInfo( ({"essenz", "essenzen"}),
    "Wenn Du einen Drachen toetest, wird seine Essenz in den Stein fliessen. "
    "Wenn Du also alle 15 Drachen getoetet hast, wirst Du die Schatzkammer "
    "betreten koennen.", "sagt: ");
  AddInfo( ({"stein"}),
    "Der richtige Stein ist das wichtigste bei dieser Aufgabe. Er muss aus "
    "einem sehr seltenen Gestein sein. Ich glaube, irgendwo in den Bergen " 
    "kann man so einen Stein finden. Der einzige Hinweis, den ich Dir geben "
    "kann, ist, dass grosse Voegel oft in der Naehe solchen Gesteins "
    "nisten. Wenn Du einen Stein gefunden hast, bring ihn mir vorbei und "
    "ich werde ihn fuer Dich vorbereiten. Dann kannst du anfangen, "
    "auf Drachenjagd zu gehen.", "sagt: ");
  AddInfo( ({"drachenjagd", "drachenjaeger"}),
    "Das beste Hilfsmittel bei der Drachenjagd ist ein Drachentoeter.",
    "sagt: ");
  AddInfo( ({"drachentoeter", "drachenlanze"}),
    "Eine Drachenlanze ist eine spezielle magische Waffe, die bei Drachen "
    "ganz besonders viel Schaden anrichtet. Manchmal kann man damit einen "
    "Drachen sogar auf einen Schlag vernichten. Zum Glueck kann man diese "
    "maechtigen Waffen beim Waffenhaendler Shagraz kaufen.", "erklaert: ");
  AddInfo( ({"waffenhaendler", "shagraz"}),
    "Beim Waffenhaendler Shagraz solltest Du Dir eine Drachenlanze kaufen, "
    "wenn Du als Drachenjaeger Erfolg haben willst.",
    "sagt: ");
  AddInfo( ({"ruestung", "ruestungen"}),
      "Ich sammle rassen- und gildenspezifische Ruestungen, bin aber "
      "auch gerne bereit, mit Dir zwei gegen eins zu tauschen.", "sagt: ");
  AddLibrary( "/d/gebirge/feyaria/drachen/drachen.lib",2);
  SetProp(P_LOG_INFO, "feyaria/tijara");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Trophaeensammler bedankt sich fuer diese Trophaee.\n" }) );

  SetProp(P_SPELLRATE,25);
  AddSpell(3,200,
     "Der Trophaeensammler bewirft Dich mit Trophaeen.\n",
     "Der Trophaeensammler bewirft @WEN mit Trophaeen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
     "Der Trophaeensammler begraebt Dich unter Trophaeen.\n",
     "Der Trophaeensammler begraebt @WEN unter Trophaeen.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Zwerg passt genau auf, dass Du keiner seiner Trophaeen zu nahe "
      "kommst.\n",
    "Der Trophaeensammler zeigt Dir einen Jaguarkopf.\n",
    "Der Trophaeensammler zeigt Dir einen Krokodilsschwanz.\n",
    "Der Trophaeensammler zeigt Dir Bueffelhoerner.\n",
    "Der Trophaeensammler zeigt Dir ein Hirschgeweih.\n",
    "Der Trophaeensammler zeigt Dir Raubtierkrallen.\n",
    "Der Trophaeensammler zeigt Dir einen Elefantenstosszahn.\n",
    "Der Trophaeensammler zeigt Dir einen Grizzlybaerkopf.\n",
    "Der Trophaeensammler zeigt Dir ein Tigerfell.\n",
    "Der Trophaeensammler bewundert seine Trophaeen.\n",
    "Der Trophaeensammler entstaubt seine Trophaeen.\n",
    "Der Trophaeensammler zeigt Dir seine Trophaeen.\n",
    "Der Trophaeensammler seufzt: Einzig die Drachenkrone fehlt mir noch!\n",
    "Der Trophaeensammler fragt Dich: Warst Du schon mal auf Drachenjagd?\n",
    "Der Trophaeensammler sagt: Ich weiss sehr viel ueber Drachen.\n",
    "Der Trophaeensammler traeumt von der Krone des Drachenkoenigs.\n",
    "Der Trophaeensammler sagt: Es gibt viele Arten von Drachen.\n",
    "Der Trophaeensammler fragt Dich: Willst Du fuer mich die Drachenkrone "
      "besorgen?\n",
    "Der Trophaeensammler sortiert seine Trophaeen.\n"}) );

  AddCmd( ({"tausche", "tausch"}), "cmd_tauschen");

  SUID;
  if( random(2) ) CLONEME("/p/armour/cloak/wolfsfell");
  else CLONEME("/p/armour/cloak/baerenfell");
  command("trage alles");
}

int cmd_tauschen(string str)
{
  notify_fail(break_string("Gib mir einfach die Ruestungen, die Du "
        "tauschen willst.", 78 , "Der Trophaeensammler sagt: "));
  return 0;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": Der Trophaeensammler hat gerade "+CAP(getuid(player))+
      " umgebracht.( -"+lostexp+" XP)\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  string wie;
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      if( !random(3) );
        call_out("toeten", 2);
      break;
    case "nett":
    case "neutral":  
      if( random(3) ) 
        call_out("react", 0, "laechelt Dich an.",
          "laechelt "+TP->name(WEN)+" an.");
      break;
    case "traurig":
      if( !random(3) )
        call_out("react", 0, "troestet Dich.", "troestet "+TP->name(WEN)+".");
      break;
    case "albern":
    case "frech":
    case "intim":
    case "froh":
    case "aengstlich":
    case "aergerlich":
      if( !random(4) )
        call_out("react", 0, "sagt: Was soll das, "+TPN+"?", 0);
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others=victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void toeten()
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP,
      BS(Name(WER, 1) + " laesst sich Deine Gemeinheit nicht gefallen!" ));
    tell_room(ENV(TO), BS(Name(WER, 1)+" laesst sich "+TP->name(WESSEN)+
      " Gemeinheit nicht gefallen!"), ({TP,TO}));
    Kill(TP);
  }
}

void give_notify(object ob)
{
  object ob2;
  string log_str;

  if( ob->id("\ndrachenstein") && !present(DRACHENQUESTID,TP) )
  {
    tell_room(MENV, break_string("Ah! Das ist ja ein magischer Stein, wie man "
      "ihn fuer einen Drachenstein verwenden kann! Warte, ich werde sofort "
      "einen Drachenstein daraus fertigen.",78,Name(WER,1)+" sagt: "));
    ob->remove();
    tell_room(MENV, Name(WER,1)+" werkt wie wild an einem Stein herum.\n");
    CLONE("/d/gebirge/feyaria/drachen/obj/quest",TP);
    write(Name(WER,1)+" gibt Dir eine Steinscheibe.\n");
    tell_room( MENV, Name(WER,1)+" gibt "+TPN+" eine Steinscheibe.\n",({TP}));
    command_me("gib drachenstein an "+TPN);
    WLOG(LOG "drachenstein","bekommt den Drachenstein");
  }
  else if( file_name(ob)[13..50] == "feyaria/sumpf/armour/race_guild_armour" ||
           file_name(ob)[13..36] == "feyaria/sumpf/armour/rga") 
  {
    ob->AddId("\nrga");
    if( ob2 = present("\nrga 2") )
    {
      log_str = "tauscht " + ob->name(RAW) + " und " + ob2->name(RAW);
      ob->remove();
      ob2->remove();
      if (!random(10))
      {
        ob2 = clone_object("/d/dschungel/feyaria/sumpf/armour/rga");
        ob2->create2(TP->QueryProp(P_RACE),
             RACE_GUILD_ARMOUR_TYPES[random(sizeof(RACE_GUILD_ARMOUR_TYPES))] [0],
            TP->QueryProp(P_GUILD));
      }
      else
        ob2 = clone_object("/d/dschungel/feyaria/sumpf/armour/race_guild_armour");
      ob2->move(TP, M_NOCHECK);
      write(Name(WER,1) + " gibt Dir "+ob2->name(WEN,1)+" im Tausch.\n");
      tell_room(MENV, Name(WER,1) + " gibt " + TP->name(WEM) + " " +
          ob2->name(WEN) + " im Tausch.\n", ({TP}) );
      WLOG(LOG "tausch", log_str + " gegen " + ob2->name(RAW));
    }
    else
      command("sag Bring mir noch so eine Ruestung, dann tausche ich sie "
          "gegen eine aus meiner Sammlung.");
  }
  else
    ::give_notify(ob);
}

void init()
{
  ::init();
  if( TP && present(DRACHENQUESTKRONE, TP) )
    call_out("quest_ende",0);
}

void quest_ende()
{
  object quest, krone;
  int *drachen;
  int i,summe;
  if( !present(TP, MENV) || !krone=present(DRACHENQUESTKRONE, TP) )
    return; 
  write("Voller Freude ueberreichst Du dem Trophaeensammler die "
        "Drachenkrone.\n");
  say("Voller Freude ueberreicht "+TPN+" dem Trophaeensammler die "
      "Drachenkrone.\n", ({TO, TP}) );
  krone->remove();
  if( quest=present(DRACHENQUESTID, TP) ) {
    if( pointerp(drachen=quest->QueryProp(P_AUTOLOADOBJ)) && 
        sizeof(drachen)==16 ) {
      summe=0;
      for( i=0;i<15;i++)
        if( drachen[i] ) summe++;
      if( summe==15) 
      {
        write_file (DRACHENQUESTLOG,
            sprintf ("%s  %s hat die Drachenquest bestanden.\n",
                      dtime(time()), CAP(TP->query_real_name())));
        write(break_string("Vielen herzlichsten Dank! Nun ist meine "
                "Trophaeensammlung vollstaendig! Als Dank bekommst Du "
                "diese Drachenlanze.",
                78, "Der Trophaeensammler sagt: "));
        CLONE(WEAPON "drachentoeter", TP);
        return;
      }
    }
  }
  write(break_string("Du hast ja gar nicht alle Drachen selber getoetet! "
        "Das kann nur bedeuten, dass Du die Krone unrechtmaessig erworben "
        "hast. Darum bekommst  Du auch keine Belohnung.", 78, 
        "Der Trophaeensammler sagt: "));
}

