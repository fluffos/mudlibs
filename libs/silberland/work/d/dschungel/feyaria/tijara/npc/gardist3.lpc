// /d/dschungel/feyaria/tijara/npc/gardist3.c   
// Ein Stadtgardist in Tijara (Wachstube)
// 31-10-1996  Feyaria@SilberLand

#include "../def.h"
inherit NPC "gardist";

#define GMASTER NPC "garde_master"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//  SetProp(P_SHORT_FIGHT, 
//      "Ein Stadtgardist beschuetzt Tijara gegen %s");
  SetProp(P_SHORT, 
      "Ein Stadtgardist kuemmert sich um langweiligen Papierkram");
  SetProp(P_LONG, BS(
    "Dieser Stadtgardist macht Schreibtischdienst in der Wachstube. Er traegt "
    "trotz der Hitze eine bronzene Ruestung und ist mit einer Hellebarde "
    "bewaffnet. Mit seinen strengen Augen mustert er Dich, ob Du nicht "
    "nicht noch zusaetzlichen Papierkram verursachen willst.") );
  SetProp(P_NAME, "Stadtgardist");

  AddInfo( ({"wachstube"}),
    "Ich muss hier in dieser stickigen Wachstube den Papierkram "
    "erledigen.","sagt: ");
  AddInfo( ({"papierkram"}),
    "Ich hasse diesen Papierkram.", "arglt vor sich hin: ");

  SetProp (P_MNPC_AREA, (ROOM "wache_e7") );
  SetProp (P_MNPC_WAIT, ({ 100, 90, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "wache_e7");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);

  AddSpell(1,1,
    "Der Stadtgardist ruft einen Kameraden herbei.\n",
    "Der Stadtgardist ruft einen Kameraden herbei.\n",
     DT_MAGIC,"hilfe");

  SetChats(3, ({
    "Der Stadtgardist sagt: Dieser dumme Papierkram :(.\n",
    "Der Stadtgardist wischt sich den Schweiss von der Stirn.\n"}) );

  SetAttackChats(5, ({
    "Der Stadtgardist ruft: Garde zu mir!\n",
    "Der Stadtgardist schreit: Raus aus meiner Wachstube!\n",
    "Der Stadtgardist bruellt: Ergib Dich, Verraeter.\n"}) );


  if( !present("armschienen") &&!random(2))
    CLONEME( ARMOUR "armschienen");
  if( !present("beinschienen") &&!random(2) )
    CLONEME( ARMOUR "beinschienen");
  command("trage alles");
}

void hilfe(object enemy, int damage, mixed dam_type)
{
  object ob;
  if(!present("stadtgardist 4",MENV))
    (ob=clone_object( NPC "gardist" ))->move(MENV,M_NOCHECK);
}

	
