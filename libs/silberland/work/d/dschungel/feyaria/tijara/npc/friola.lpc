// /d/dschungel/feyaria/tijara/npc/friola.c   
// Shopkeeper fuer Kontor
// 1998-02-16  Feyaria@SilberLand


inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Friola, die Kontorbesitzerin");
  SetProp(P_LONG, 
    "Friola ist eine kleine, staemmige Hobbitfrau. Sie ist die Besitzerin "
    "dieses Handelskontors und sicher sehr reich, denn sie traegt teure "
    "Kleidung und an der Rundung ihres Bauches sieht man auch, dass sie "
    "nie hungern muss. Sicher macht sie mit ihrem Kontor einen riesigen "
    "Gewinn.");
  SetProp(P_NAME, "Friola");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"Friola","friola", "besitzerin", "kontorbesitzerin", "hobbitfrau"}));
  set_living_name("friola");
  AddDetail( ({"bauch", "rundung"}),
    "An der Rundung ihres Bauches sieht man auch, dass Friola nie hungern "
    "muss.");

  create_default_npc(19);
  SetProp(P_HANDS, ({" mit reichen Hobbithaenden", 190, DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 90);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_TERROR    : -0.1, DT_MAGIC     : -0.1, DT_SOUND     :  0.2,
         DT_LIGHTNING :  0.1, DT_POISON    :  0.1 ]) );

  AddLibrary( NPC "tijara.lib",1);
  AddInfo(DEFAULT_INFO,
    ({"sagt: Kauf doch lieber was!\n",
      "frag Dich: Wie meinst Du das?\n",
      "gruebelt.\n",
      "zuckt mit ihren Schultern.\n",
      "hat Dich scheinbar ueberhoert.\n",
      "schuettelt den Kopf.\n",
      "runzelt die Stirn.\n",
      "sagt: So einen Bloedsinn muss Dir Shagraz erzaehlt haben!\n"}) );
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"name", "friola"}),
    "Mein Name ist Friola.", "macht eine kleine Verbeugung und sagt: ");  
  AddInfo( ({"kontor", "besitzerin", "kontorbesitzerin"}),
    "Das ist mein Kontor. Du kannst hier etwas kaufen "
    "oder verkaufen. Nur Waffen kann ich nicht leiden.", "sagt: ");
  AddInfo( ({"waffen", "waffe"}),
    "Waffen kann ich nicht leiden, deshalb handle ich auch nicht damit! "
    "Nur dieser haessliche Orkische Waffenhaendler verkauft hier Waffen! "
    "Am liebsten haette ich den aus Tijara raus, aber er wird vom "
    "Gouverneur unterstuetzt.", "sagt aergerlich: ");
  AddInfo( ({"ork", "waffenhaendler", "shagraz"}),
    "Der Waffenhaendler ist ein haesslicher Ork.", "sagt angewidert: ");
  AddInfo( ({"gewinn"}),
    "Jaja, der Kontor wirft schon einiges an Gewinn ab :).",
    "sagt grinsend: ");
  AddInfo( ({"hobbit", "hobbits", "halbling", "halblinge"}),
    "Hobbits sind die Krone der Schoepfung!", "sagt belehrend: ");
  AddInfo( ({"derlim", "hobbingen"}),
    "Urspruenglich stamme ich aus Derlim, aber hier in Tijara kann ich "
    "viel mehr Gewinn machen.", "sagt: ");
  AddInfo( ({"kontorbuch", "buch"}),
    "In das Kontorbuch schreib ich alle Kaeufe und Verkaeufe hinein.",
    "sagt: ");
  AddInfo( ({"lastentraeger"}),
    "Die Lastentraeger tragen die ganzen Sachen von hier in die Lagerhalle "
    "und zu den Handelsschiffen. Aber wenn ich nicht staendig auf sie "
    "aufpasse, dann faulenzen sie den ganzen langen Tag.", "sagt: ");
  AddInfo( ({"lager", "lagerhaus", "lagerhalle", "lagerhallen"}),
    "Ich besitze auch ein grosses Lagerhaus gleich nebenan. Dort lageren "
    "die Waren, die nicht sofort verkauft werden, oder gerade in grossen "
    "Kisten mit dem Handelsschiff angekommen sind.", "sagt: ");
  AddInfo( ({"schiff", "handelsschiff"}),
    "Das Handelsschiff transportiert Waren nach Norden, vor allem nach "
    "Midas und nach Derlim.", "sagt: ");
  AddInfo( ({"midas"}),
    "ich handle viel mit Midas.", "sagt: ");
  AddInfo( ({"badetuch", "tuch", "baden", "felseninsel"}),
    "Ein Badetuch brauchst Du, wenn Du zum Baden auf die Felseninsel "
    "faehrst. Es ist ein echtes Sonderangebot.", "sagt: ");
  AddInfo( ({"fackel", "seil", "thermometer", "schaufel"}),
    "Das kann man doch immer brauchen. Und so billig wie bei mir, wirst Du "
    "das nirgendwo sonst bekommen!", "sagt: ");
  AddInfo( ({"sonnenschirm", "schirm", "hitze"}),
    "Mit dem Sonnenschirm kannst Du Dich vor der Hitze des Dschungels "
    "schuetzen.", "erklaert: ");
  AddInfo( ({"pfeife", "pfeifen", "holzpfeifchen", "holzpfeife", "pfeifchen"}),
    "Mein fauler Lastentraeger schnitzt sich immer Pfeifchen, frag mal den.",
    "sagt: ");
  SetProp(P_LOG_INFO, "feyaria/tijara");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Friola bedankt sich fuer das Geschenk.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(3,200,
    "Friola bewirft Dich mit Kontorrechnungen.\n",
    "Friola bewirft @WEN mit Kontorrechnungen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,400,
    "Friola ueberhaeuft Dich mit Schulden.\n",
    "Friola ueberhaueft @WEN mit Schulden.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
    "Friola sagt: Du kannst hier kaufen oder verkaufen!\n",
    "Friola sagt: Schau Dir doch mein Angebot mit 'zeige' an!\n",
    "Friola sagt: Schau Dich ruhig um!\n",
    "Friola zaehlt den Gewinn des heutigen Tages.\n",
    "Friola treibt die Lastentraeger an.\n",
    "Friola schreibt etwas in ihr Kontorbuch.\n",
    "Friola preist ihre Waren an.\n",
    "Friola fragt Dich: Warst Du schon mal in Derlim?\n",
    "Friola fragt Dich: Kannst Du mir Neuigkeiten aus Derlim erzaehlen?\n",
    "Friola verflucht das Obstmonopol des Gouverneurs.\n",
    "Friola will Dir unnoetigen Ramsch aufschwatzen.\n",
    "Friola sagt: SONDERANGEBOT! Heute alles zum halben Preis!\n",
    "Friola fragt Dich: Willst Du nicht einkaufen?\n"}) );

  SUID;
  if( random(100) < 70) CLONEME("/p/armour/ring/ring");
  if( random(100) < 70) CLONEME("/p/armour/amulet/amulett");
  CLONEME("/p/armour/trousers/rock" );
  CLONEME("/p/armour/armour/bluse" );
  command("trage alles");
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": Friola hat gerade "+CAP(getuid(player))+" umgebracht."
    "( -"+lostexp+" XP)\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "nett":
    case "intim":
    case "fies":
    case "frech":
      if( random(3) )
        call_out("react", 0, "sagt entruestet: Was soll das, "+TPN+"!",
          "sagt entruestet: Was soll das, "+TPN+"!");
      break;
    case "traurig":
    case "albern":
    case "froh":
    case "aengstlich":
      if( random(3) )
        call_out("react", 0, "sagt: Kauf Dir doch was, "+TPN+"!",
          "sagt: Kauf Dir doch was, "+TPN+"!");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

