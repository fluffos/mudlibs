// /d/dschungel/feyaria/tijara/npc/kellnerin.c   
// Kellnerin fuer Hafenkneipe
// 1998-02-16  Feyaria@SilberLand


inherit "std/mnpc";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 
      "Die Kellnerin der Hafenkneipe bedient ihre Gaeste");
  SetProp(P_NAME, "Kellnerin");
  SetProp(P_GENDER, FEMALE);
  AddId(({"Kellnerin","kellnerin"}));
  AddSpecialDetail( ({"rundungen"}), "det_rundungen");
  AddDetail( ({"haare"}),
    "Die Kellnerin hat sehr lange goldblonde und lockige Haare.");

  create_default_npc(17);
  SetProp(P_HANDS, ({" mit einem Serviertablett", 170, DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 166);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "eilt zurueck an die Arbeit");
  SetProp(P_MMSGOUT, "kehrt in die Hafenkneipe zurueck");
  SetProp(P_MNPC_AREA, ROOM "kneipe_e2" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "kneipe_e2");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS);

  AddInfo(DEFAULT_INFO, ({
    "fragt Dich: Kann ich Dir nicht noch was bringen?\n",
    "sagt: Mit 'menue' kannst Du Dir unser Angebot anschauen.\n",
    "sagt: Na geh!\n",
    "kichert.\n",
    "laechelt Dich nur an.\n",
    "schaut Dich freundlich an.\n",
    "schuettelt ihren Kopf, sodass ihre langen Haare herumfliegen.\n",
    "kuemmert sich wieder um die anderen Gaeste.\n",
    "fragt Dich: Willst Du nicht doch lieber ein Dschungelbier?\n",
    "sagt: Ich verstehe, Du brauchst einen Tequila!\n"}) );
  AddLibrary( NPC "tijara.lib",1);
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( "kellnerin", "nickt zustimmend.\n");
  AddInfo( ({"kneipe"}),
    "Ich bin die Kellnerin hier.", "sagt: ");
  AddInfo( ({"dschungelbier", "bier"}),
    "Das Dschungelbier ist ein besonders herbes Bier, gebraut aus den "
    "Fruechten des Dschungels. Es schmeckt hervorragend! Willst Du nicht "
    "gleich eines probieren?", "sagt: ");
  AddInfo( ({"tequila"}),
    "Der Tequila ist ein hochprozenztiger Schnaps! Aus was er gemacht wird, "
    "darf ich leider nicht sagen, weil es ein Geheimnis ist. Man nimmt ihn "
    "mit einer Prise Salz und einer Scheibe Zitrone zu sich.",
    "sagt geheimnisvoll: ");
  AddInfo( ({"geheimnis"}),
    "Aber das ist doch geheim!", "fluestert Dir ins Ohr: ", 1);
  AddInfo( ({"matrose", "matrosen", "seemann", "seemaenner"}),
    "Die Matrosen und Seemaenner sind gute Kunden, aber leider auch etwas "
    "aufdringlich. Aber ich kann mich immer durchsetzen.",
    "sagt verschmitzt: ");
  AddInfo( ({"schoen", "schoenheit"}),
    "sagt kokett: Du findest mich also auch schoen?\n"
    "Die Kellnerin laechelt verfuehrerisch.\n");
  AddInfo( ({"burger", "dschungelburger"}),
    "Der Dschungelburger ist echt lecker! Soll ich Dir gleich einen bringen?",
    "sagt: ");
  AddInfo( ({"specialmix", "special", "mix", "special-mix"}),
    "Der Special-Mix ist wirklich nur was fuer harte Zecher! Er besteht aus "
    "vielen verschiedenen Alkoholsorten, und wenn Du ihn trinkst, ist Dein "
    "Blut wohl voller Alkohol, und alle Fremd- und Giftstoffe sind aus dem "
    "Blut weg. Auch Deine Atemluft wird kurzfristig so alkoholhaltig, dass "
    "sie entzuendbar wird. Soll ich Dir eins bringen oder hast Du Angst "
    "vor Alkohol?", "sagt grinsend: ");
  AddInfo( ({"saft", "ananassaft", "ananas"}),
    "Ananassaft ist nur was fuer die Kinder. Er ist aber sehr vitaminreich, "
    "weil er frisch ausgepresst wird.", "sagt: ");
  SetProp(P_LOG_INFO, "feyaria/tijara");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Kellnerin bedankt sich fuer das Trinkgeld.\n" }) );

  SetProp(P_SPELLRATE,25);
  AddSpell(3,200,
     "Die Kellnerin bewirft Dich mit leeren Bierkruegen.\n",
     "Die Kellnerin bewirft @WEN mit leeren Bierkruegen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,350,
    "Die Kellnerin haut Dir ihr Serviertablett auf den Kopf.\n",
    "Die Kellnerin haut @WEM ihr Serviertablett auf den Kopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,100,DS_BLIND,
    "Die Kellnerin spritzt Dir Tequila in die Augen.\n",
    "Die Kellnerin spritzt @WEM Tequila in die Augen.\n");

  SetChats(5, ({
    "Die Kellnerin fragt: Noch ein herbes Dschungelbier?\n",
    "Die Kellnerin sammelt die leeren Bierkruege ein.\n",
    "Die Kellnerin serviert einem Matrosen einen Dschungelburger.\n",
    "Ein betrunkener Seemann gibt der Kellnerin eine Klaps auf den "
    "Hintern.\nDie Kellnerin kippt dem Seemann ein Bier ueber seinen Kopf.\n",
    "Die Kellnerin laechelt Dich an.\n",
    "Die Kellnerin moechte gern ein Trinkgeld.\n",
    "Ein Matrose kneift die Kellnerin in den Po.\n"
    "Die Kellnerin gibt dem Matrosen eine schallende Ohrfeige.\n",
    "Die Matrosen singen ein Loblied auf die Schoenheit der Kellnerin.\n",
    "Die Kellnerin zwinkert Dir verfuehrerisch zu.\n",
    "Die Kellnerin streicht sich eine Haarstraehne aus dem Gesicht.\n",
    "Die Kellnerin sagt: Mahlzeit!\n"}) );

  SUID;
  CLONEME("/p/armour/boots/sandalen");
  CLONEME("/p/armour/cloak/schuerze");
  CLONEME("/d/dschungel/aaliyah/unterwaesche/armour/hotpants");
  CLONEME("/d/dschungel/aaliyah/unterwaesche/armour/rosatop");
  present("schuerze")->SetProp(P_SHORT, "Eine rosa Schuerze");
  present("sandalen")->SetProp(P_SHORT, "Rosa Sandalen");
  command("trage alles");
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": Die Kellnerin hat gerade "+CAP(getuid(player))+" umgebracht."
    "( -"+lostexp+" XP)\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  string wie;
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
    case "frech":
    case "intim":
      if (TPN == "Hihi" && gruppe == "intim")
      {
         call_out("react", 0, "kuesst Dich leidenschaftlich.",
           "gibt "+TP->name(WEM)+" einen leidenschaftlichen Kuss.");
         break;
      }
      switch(random(2))
      {
        case 0:
         call_out("react", 0, "gibt Dir eine schallende Ohrfeige.",
           "gibt "+TP->name(WEM)+" eine schallende Ohrfeige.");
         break;
       case 1:
         call_out("react", 0, "schuettet Dir ein Bier ueber Deinen Kopf.",
           "schuettet "+TP->name(WEM)+" ein Bier ueber "+TPPP(MALE,WEN)+
           " Kopf.");
         break;
      }
      break;
    case "nett":
    case "neutral":  
      if( TP->QueryProp(P_GENDER) == MALE ) wie="verfuehrerisch ";
      else wie = "";
      if( random(3) )
        call_out("react", 0, "laechelt Dich "+wie+"an.",
          "laechelt "+TP->name(WEN)+" "+wie+"an.");
      break;
    case "traurig":
      if( !random(3) )
        call_out("react", 0, "troestet Dich.", "troestet "+TP->name(WEN)+".");
      break;
    case "albern":
    case "froh":
    case "aengstlich":
    case "aergerlich":
      if( !random(4) )
        call_out("react", 0, "sagt: Du bekommst trotzdem kein Freibier, "
        +TPN+"!", 0);
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others=victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

string long()
{
  string str;
  str= "Die Kellnerin ist eine junge, sehr huebsche Frau mit wallendem, "
    "blondem Haar. Durch ihr luftiges Gewand kommen ihre prallen weiblichen "
    "Rundungen sehr gut zur Geltung. ";
  if( TP->QueryProp(P_GENDER)==FEMALE )
    str+="Du beneidest die Kellnerin um ihre weibliche Ausstrahlung. ";
  else
  {
    str+="Du spuerst, wie Dir Deine Hose langsam zu klein wird. ";
    if (TPN == "Hihi")
      str += "Du kannst es nicht erwarten, bis Deine geliebte Ehefrau endlich "
        "hier mit der Arbeit fertig ist und Du mit ihr ein paar schoene "
        "Stunden verbringen kannst. ";
    else if(TP->QueryProp(P_MARRIED))
      str+="Du wuerdest Dich ja gerne an die Kellnerin heranmachen, aber "
        "Du bist ja ein treuer Ehemann, oder etwa nicht? ";
    else
      str+="Gerade hat die Kellnerin Dich angelaechelt, vielleicht solltest "
        "Du Dich an sie ranmachen! ";
  }
  str+="Viele Matrosen und Seemaenner besuchen wohl diese Kneipe nur, um "
       "einen Blick auf diese Kellnerin werfen zu koennen.";
  SetProp(P_LONG, str);
  return ::long();
}

string det_rundungen()
{
  if( TP->QueryProp(P_GENDER)==FEMALE)
    return "Du beneidest die Kellnerin um ihre weiblichen Rundungen.\n";
  else
    return BS("Ach was hat die Kellnerin fuer schoene weibliche Rundungen. "
      "Liebend gerne wuerdest Du da einmal hinfassen.");
}

varargs void die(int poisondeath)
{
  object ob;
  if( objectp(QueryProp(P_KILLER)) )
  {
     environment()->set_ban(getuid(QueryProp(P_KILLER)), 100);
     if (ob = find_object(ROOM "hotel_c6"))
       ob->set_ban(getuid(QueryProp(P_KILLER)), 100);
  }
  ::die(poisondeath);
}

