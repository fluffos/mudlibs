// /d/dschungel/feyaria/tijara/npc/shagraz.c   
// Shopkeeper fuer Waffenladen
// 1998-02-16  Feyaria@SilberLand

#include "../def.h"

inherit "std/repair";
inherit "std/npc/spells";
inherit "std/npc/compare";


void create()
{
  if (!is_clone(TO)) return;
  repair::create();
  compare::create();

  SetProp(P_SHORT, "Shagraz, der Waffenhaendler");
  SetProp(P_LONG, 
    "Vor Dir steht Shagraz, der Besitzer dieses Waffenladens. Er ist ein "
    "relativ kleiner, dafuer aber um so kraeftigerer Ork mit einem dichten "
    "schwarzen Pelz. Aus seinem Maul schauen gewaltige Eckzaehne heraus. "
    "Du wunderst Dich, dass ein Ork hier als Waffenhaendler geduldet wird, "
    "aber Orks sind ja als Meister im Gebrauch von Waffen bekannt.");
  SetProp(P_NAME, "Shagraz");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"Shagraz","shagraz","waffenhaendler","ork","haendler","besitzer", 
        "Schwertexperte", "NOWIMPY", "ladenbesitzer"}));
  AddDetail( ({"zaehne", "eckzaehne", "gebiss", "mund", "maul", "hauer"}),
    "Shagraz hat, wie bei Orks ueblich, gewaltige Eckzaehne in seinem "
    "Gebiss. Jedes Wildschwein wuerde ihn um diese Hauer beneiden!");
  AddDetail( ({"pelz", "fell", "behaarung"}),
    "Shagraz hat eine dichte schwarze Behaarung, die ihm einen natuerlichen "
    "Schutz bietet. Du wunderst Dich, warum er bei den Temperaturen hier "
    "nicht zum Schwitzen anfaengt.");

  create_default_npc(28);
  SetAttribute(A_STR, 40);
  SetAttribute(A_INT, 20);
  AddProp(P_BODY, 30);
  SetProp(P_HANDS, ({" mit Orkklauen", 280, DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 158);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_RESISTANCE_STRENGTHS,
    ([DT_MAGIC:-0.5, DT_FIRE:-0.2, DT_COLD:-0.2, DT_TERROR:-0.6,
      DT_UNHOLY:-0.3, DT_WHIP:-0.2, DT_ACID:-0.5, DT_LIGHTNING:0.5]) );

  AddInfo(DEFAULT_INFO,
    ({"grunzt etwas unverstaendliches.\n",
      "schaut Dich finster an.\n",
      "grunzt: hae?\n",
      "bruellt: Was soll das?\n",
      "schreit dich laut an.\nDu fuerchtest Dich.\n",
      "kratzt sich am Kopf.\n",
      "entbloesst sein maechtiges Gebiss.\n"}) );
  AddLibrary( NPC "tijara.lib",1);
  AddLibrary( NPC "material.lib",1);
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","grunzt: ");
  AddInfo( ({"name", "ork", "shagraz"}),
    "Ich bin Shagraz!", "bruellt: ");
  AddInfo( ({"waffen"}),
    "Ich verkaufe Waffen!", "grunzt: ");
  AddInfo( ({"machete"}),
    "Kauf Dir eine Machete, die wirst Du im Dschungel brauchen!", "sagt: ");
  AddInfo( ({"drachenlanze", "drachentoeter", "drache", "drachen"}),
    "Mit meinem Drachentoeter ist der Kampf mit Drachen ein Kinderspiel. "
    "Leider ist er gerade ausverkauft.", "grunzt aufgeregt: ");
  AddInfo( ({"messer", "taschenmesser"}),
    "grunzt: Ein Taschenmesser kann man immer brauchen!\n");
  AddInfo( ({"hellebarde"}),
    "Hellebarden verkaufe ich sehr viele. Die Stadtgardisten hier sind "
    "sehr gute Kunden von mir!", "sagt: ");
  AddInfo( ({"kharokurg"}),
    "Kharokurg ist die Heimat der Orks. Dort sind auch die Schmieden, von "
    "denen ich einige meiner Waffen beziehe.", "sagt: ");
  AddInfo( ({"friola", "kontorbesitzerin", "hobbit", "hobbitkugel"}),
    "FRIOLA!?!?! Diese kleine Hobbitkugel! Ich hasse sie und ihre "
    "Friedfertigkeit!", "bruellt entruestet: ");
  AddInfo( ({"speer", "speere", "lanze", "lanzen"}),
    "Ich kann Speere und Lanzen reparieren.\n", "schnaubt: ");
  SetProp(P_LOG_INFO, "feyaria/tijara");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Shagraz stopft @WEN in den Muellschlucker.\n" }) );

  SetProp(P_SPELLRATE,40);
  AddDefaultSpell(3,200,DS_DISARM,
    "Shagraz beisst Dir in die Hand.\n",
    "Shagraz beisst @WEM in die Hand.\n");
  AddDefaultSpell(2,400,DS_FEAR,
    "Shagraz bruellt Dich an.\nDu fuerchtest Dich ploetzlich.\n",
    "Shagraz bruellt @WEM an.\n");
  AddSpell(1,600,
    "Shagraz schlaegt Dir seine Reisszaehne in den Hals.\n",
    "Shagraz schlaegt @WEM seine Reisszaehne in den Hals.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  SetChats(2, ({
    "Shagraz sortiert seine Waffen.\n",
    "Shagraz montiert eine neue Axtklinge an einer Hellebarde.\n",
    "Shagraz zeigt Dir eine nagelneue Hellebarde.\n",
    "Shagraz sagt: Mit meinem Drachentoeter ist der Kampf gegen Drachen "
      "einfach.\n",
    "Shagraz fragt Dich: Willst Du nicht eine Drachenlanze kaufen?\n",
    "Shagraz sagt: Kauf Dir eine Machete, die wirst Du im Dschungel "
    "brauchen!\n",
    "Shagraz grunzt: Ein Taschenmesser kann man immer brauchen!\n",
    "Shagraz sagt: Ich repariere Speere, Lanzen und Hellebarden.\n",
    "Shagraz deutet auf Deine Waffe und laechelt abfaellig.\n"
    "Shagraz grunzt: Kauf Dir doch bei mir eine neue Waffe!\n",
    "Shagraz poliert eine Drachenlanze.\n",
    "Shagraz befestigt eine neue Speerspitze auf einem Speer.\n",
    "Shagraz gaehnt und dabei wird sein gewaltiges Gebiss sichtbar.\n",
    "Shagraz repariert einen beschaedigten Speer.\n",
    "Shagraz schaut Dich finster an.\n",
    "Shagraz schreit Dich laut an.\nDu fuerchtest Dich.\n",
    "Shagraz kratzt sich unter der Achsel.\n",
    "Shagraz entbloesst sein maechtiges Gebiss.\n"}) );

  SetAttackChats(10, ({
    "Shagraz leckt das Blut von seiner Waffe.\n",
    "Shagraz entbloest sein maechtiges Gebiss.\n",
    "Shagraz versucht vergeblich, Deine Kehle zu zerbeissen.\n",
    "Shagraz' gefaehrliche Hauer erreichen fast Deine Kehle.\n",
    "Das orkische Kampfgebruell von Shagraz zehrt an Deinen Nerven.\n"}) );
   
  SUID;
  if( random(100)<33 )
  {
    CLONEME("/p/weapon/sword/krummsaebel");
    command("zuecke saebel");
  }
  else if( random(66)<33 )
  {
    CLONEME("p/weapon/sword/krummschwert");
    command("zuecke schwert");
  }
  else
  {
    CLONEME("/d/huegelland/feyaria/orks/weapon/kriegsaxt");
    command("zuecke axt");
  }
  CLONEME("/p/armour/armour/ringelpanzer" );
  if( random(100) < 40) CLONEME("/p/armour/helm/eisenhelm");
  if( random(100) < 30) CLONEME("/p/armour/trousers/lederhose");
  if( random(100) < 50) 
  {
    if( random(10) )
      CLONEME(ARMOUR "rueckengehaenge");
    else
    {
      if (random(2))
      {
        CLONEME(ARMOUR "rueckengehaenge_plus");
        SetProp(P_GUILD, "berserker");
        command("trage gehaenge");
        SetProp(P_GUILD, 0);
      }
      else
        CLONEME(ARMOUR "rueckengehaenge_schild");
    }
  }
  command("trage alles");
  if( !random(10) ) CLONEME( OBJ "wbalsam");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": Shagraz hat gerade "+CAP(getuid(player))+" umgebracht."
    "( -"+lostexp+" XP)\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( !adverb ) adverb ="\b";
  if (find_call_out("react")!= -1) return;
  if( !random(5) )
    call_out("react",0, "grunzt Dich "+adverb+" an.", "grunzt "+
      TP->name(WEN)+" an.");
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int rep_auswahl(object ob)
{
  if(ob->QueryProp(P_ARMOUR_TYPE))
  {
    write("Shagraz schnaubt entruestet: Das ist ein Waffenladen!\n");
    return 0;
  }
  if(ob->QueryProp(P_WEAPON_TYPE)!=WT_SPEAR )
  {
    write("Shagraz grunzt aergerlich: Ich repariere nur Speere und Lanzen!\n");
    return 0;
  }
  return 1;
}

varargs void die(int poisondeath)
{
  object spieler, ob;
  spieler=QueryProp(P_KILLER);
  if (spieler && (ob = present("\nzechpreller_quest_11", spieler)))
    ob->Mark();
  if(spieler && (ob = present("\namazonen_aufspiessen_quest", TP)))
    ob->fertig();
  ::die(poisondeath);
}
