// /d/dschungel/feyaria/tijara/npc/garde_master.c   
// Master fuer die Gardisten in Tijara
// 31-10-1996  Feyaria@SilberLand

object *gardisten;
object* feinde;

#include "../def.h"

create()
{
  if (is_clone(this_object())) return 0;
  gardisten = ({});
  feinde= ({});
}

add_gardist()
{
  gardisten += ({ previous_object() });
}

ruf_um_hilfe(object spieler)
{
  int u;
  if( member( feinde, spieler) == -1 )
  {
    feinde+=({spieler});
    domainshout("Ein Stadtgardist ruft: "+spieler->Name()+" greift uns an!\n",
        "dschungel/feyaria/tijara/room",1);
  }
}

remove_gardist()
{
  gardisten -= ({ previous_object() });
}
    

void reset()
{
  feinde=({});
}

int IsFeind(object enemy)
{
  if( enemy->QueryProp(P_NAME)=="Dumpfelf" ) return 1;
  if( member(feinde, enemy)!=-1 )
    return 1;
  else
    return 0;
}

void Sieg(object player)
{
  domainshout("Ein Gardist ruft: Wir haben "+player->Name()+" besiegt!\n");
  write_file(LOG "kills",
    ctime()+": Ein Gardist hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  feinde-=({player});
}
