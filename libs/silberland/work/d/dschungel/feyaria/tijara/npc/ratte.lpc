// /d/dschungel/feyaria/tijara/npc/mratte.c   
// Eine Kellerratte (moving)
// 27-12-1996  Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"

string pfeiferlspieler;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  pfeiferlspieler=0;

  SetProp(P_SHORT, "Eine Kellerratte");
  SetProp(P_LONG, BS(
    "Die Kellerratte hat ihren Namen davon, dass sie meist ihr Leben in "
    "Kellern fristet und dort zu einer echten Plage wird, weil sie sich "
    "sehr schnell vermehrt. Diese Ratte hat kleine spitze Zaehnchen, ein "
    "schwarzgraues Fell und einen langen Schwanz."));
  SetProp(P_NAME, "Kellerratte");
  SetProp(P_GENDER, FEMALE);
  set_living_name("\nquestkellerratte");
  AddId(({"ratte", "kellerratte", "\nkellerratte", "FELL_WUSCHEL"}));
  AddDetail( "schwanz", 
    "Die Kellerratte hat einen langen Schwanz.");
  AddDetail( ({"zaehne", "zahn", "zaehnchen"}),
    "Die Kellerratte hat spitze Zaehne, mit denen sie fast alles annagen "
    "kann.");
  AddDetail( "fell", 
    "Das Fell der Kellerratte ist schwarzgrau und ziemlich verdreckt.");

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren Rattenzaehnen", 50, DT_PIERCE}));
  SetProp(P_RACE, "Ratte");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, -400);
  SetProp(P_HEAL,-20);
  SetProp(P_NOATTACK, "huscht schnell zwischen Deinen Beinen durch.");
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "huscht herein");
  SetProp(P_MMSGOUT, "huscht schnell weg");
  SetProp(P_MNPC_AREA, (ROOM "keller") );
  SetProp(P_MNPC_WAIT, ({ 5, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, "/room/npcasylraum");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, ({
    "quiekt.\n",       "piepst.\n",
    "quiekt laut.\n",  "piepst laut.\n",
    "quiekt leise.\n", "piepst leise.\n"}) );
  AddInfo("feyaria",
    "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Kellerratte kuemmert sich nicht um Deine Sachen.\n" }) );

  SetChats(5, ({
    "Die Kellerratte quiekt.\n",
    "Die Kellerratte piepst.\n",
    "Die Kellerratte quiekt laut.\n",
    "Die Kellerratte piepst laut.\n",
    "Die Kellerratte quiekt leise.\n",
    "Die Kellerratte piepst leise.\n",
    "Die Kellerratte putzt sich ihre Schnurrhaare.\n",
    "Die Kellerratte schleckt ueber ihr dreckiges Fell.\n",
    "Die Kellerratte versucht ihren Schwanz einzufangen.\n",
    "Die Kellerratte schaut Dich misstrauisch an.\n",
    "Die Kellerratte huscht zwischen Deinen Beinen durch.\n",
    "Die Kellerratte knabbert Deine Schuhe an.\n",
    "Die Kellerratte laeuft um Dich herum.\n",
    "Die Kellerratte schnuppert.\n",
    "Die Kellerratte stellt ihre kleinen Oehrchen auf.\n",
    "Die Kellerratte stellt sich auf die Hinterpfoten.\n",
    "Die Kellerratte schleckt ihre Vorderpfoten ab.\n",
    "Die Kellerratte huscht aufgeregt hin und her.\n",
    "Die Kellerratte lauscht aufmerksam.\n",
    "Die Kellerratte zeigt ihre kleinen, spitzen Zaehnchen.\n"}) );

}

void folge(object ob)
{
  tell_room(MENV, "Die Kellerratte stellt ihre Ohren auf, "
     "als sie das Pfeifen hoert.\n");
  ob->AddPursuer(ME);
  RemoveId("\nkellerratte");
  AddId("\nfloetenratte");
  set_living_name("\nquestpfeienratte");
  SetProp(P_MNPC_FLAGS,0);
  SetProp(P_MSGOUT, "laeuft "+ ob->name(WESSEN)+" Pfeifchenspiel hinterher");
  pfeiferlspieler=ob->query_real_name();
}

void reset()
{
  object ob;
  ::reset();
  if( pfeiferlspieler)
  {
    AddId("\nkellerratte");
    RemoveId("\nfloetenratte");
    set_living_name("\nquestkellerratte");
    SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
    if( ob=find_player(pfeiferlspieler) )
    {
      ob->RemovePursuer(ME);
      tell_object(ob, "Eine Kellerratte hat genug von Deiner Musik.\n");
    }
    SetProp(P_MSGOUT, "huscht");
    pfeiferlspieler=0;
  }
}

void BecomesNetDead(object netdead)
{
  if(pfeiferlspieler)
  {
    if( pfeiferlspieler==netdead->query_real_name() )
      remove();
  }
}

