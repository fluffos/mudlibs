// nosave string kerben_orakel(object pl)
string kerben_orakel(object pl)
{
  string given_scores;
  int i;
  string *npcs;
  string npcname;
  mixed *score;
  string answer;
  object npc;
  object ob;
  object next;
  int* exclude;

  // anvar, ayla, xarfai, ebene der zeit
  exclude = ({212,287,648,799,800,801,802,803,804});  // Kerben die nicht angezeigt werden sollen
//  exclude = ({212,287,648,799,800,801,802,803,804}); // Kerben die nicht angezeigt werden sollen
  npcs = ({});
  given_scores = pl->QueryScores();

  for (i = 6 * strlen(given_scores) - 1; i > 0; i--)
  {
    if (!test_bit(given_scores, i) && member(exclude, i) == -1)
    {
      if (pointerp(score = NPCMASTER->QueryNPCbyNumber(i)))
      {
        if (score[1] > 0)
          npcs += ({score[2]});
      }
    }
  }
  if (sizeof(npcs)) {
    npcname = npcs[random(sizeof(npcs))];
    catch(npc = clone_object(npcname));
    if (!objectp(npc))
      return 0;
    answer = "Du koenntest noch " + npc->name(WEN,1) + " jagen. Du findest " +
      npc->QueryPronoun(WEN) + " in der Region " + 
      capitalize(explode(npcname, "/")[1]) + ".";

    npc->move("/room/npcasylraum", M_NOCHECK);
    npc->deep_remove();
    if (objectp(npc)) 
      destruct(npc);

  }
  else {
     answer = "Ja. Also. Hm. Unglaublich, aber Du hast alle nennenswerten "
       "Gegner besiegt. Es gibt keine Gegner mehr, durch deren Toetung "
       "Du noch etwas lernen koenntest.";
  }
  return answer;
}

string info_kerben()
{
  string answer;
  object ob;
  mapping warnings;

  if (!TP->QueryQuest(JAEGERQUEST))
    return "sagt: Hilf mir, dann helfe ich Dir!\n";
  if (JAEGERMASTER->query_killer(getuid(TP)))
    return ({"sagt: Dir helfe ich nicht, Du Moerder!\n",
        "sagt: Du sollst Grosswild jagen, nicht Grosswildjaeger!\n",
        })[random(2)];
  if (JAEGERMASTER->query_kerber(getuid(TP)))
    return "sagt: Aber ich habe Dir doch gerade eine Kerbe verraten!\n";
  if (mappingp(warnings = TP->QueryProp(P_WARNINGS)) && sizeof(warnings))
    return "sagt: Ich helfe keinem Verbrecher!\n";

  if (!present(kerbenitem))
  {
    write(break_string("'Du mir geben " + capitalize(kerbenitem) + " und ich "
          "Dir geben Info!', wie mein orkischer Freund Shagraz sagen wuerde.", 
          78, "Der Grosswildjaeger sagt: "));
    return "grinst Dich an.\n";
  }

  present(kerbenitem)->remove();
  JAEGERMASTER->set_kerber(getuid(TP));
  if (answer = kerben_orakel(TP))
  {
    WLOG(LOG "kerben", ": " + answer);
    write(break_string(answer, 78, "Der Grosswildjaeger sagt: "));
    return "wuenscht Dir viel Glueck bei der Jagd.\n";
  }
  return "sagt: Leider kann ich keine Kerbe fuer Dich finden.\n";
}

void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
  kerbenitem = KERBENITEMS[random(sizeof(KERBENITEMS))];
}

void die(int poisondeath)
{
  JAEGERMASTER->set_killer(getuid(QueryProp(P_KILLER) || TP || PO || TO));
  ::die(poisondeath);
}
