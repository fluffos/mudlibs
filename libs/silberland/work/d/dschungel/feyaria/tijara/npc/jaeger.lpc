void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Grosswildjaeger");
  SetProp(P_LONG,
    "Der Grosswildjaeger ist ein breitgebauter Elf mit langen, dunkelbraunen "
    "Haaren. Er ist voellig in Wildleder gekleidet und hat einen Schlapphut "
    "auf. Um seine Schulter haengt ein maechtiger Jagdbogen. Verschiedene "
    "Jagdtrophaeen wie z.B. Raubtierzaehne, Baerentatzen und Adlerfedern "
    "schmuecken seine Kleidung.");
  SetProp(P_NAME, "Grosswildjaeger");
  SetProp(P_GENDER, MALE);
  AddId(({"grosswildjaeger", "jaeger", "elf", "elfenwaechter"}));
  AddDetail( ({"jagdtrophaeen", "raubtierzaehne", "raubtierzahn", "zaehne",
               "jagdtrophaee", "zahn", "baerentatzen", "baerentatze", 
               "tatzen", "tatze", "adlerfeder", "adlerfedern", "feder", 
               "federn", "trophaeen", "trophaee"}),
    "Wegen der vielen Jagdtrophaeen schliesst Du, dass der Grosswildjaeger "
    "wirklich schon viele Tiere gejagt hat.");

  create_default_npc(28);
  SetProp(P_HANDS, ({" mit Jagdhaenden", 250, DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 196);
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 10);

  AddInfo(DEFAULT_INFO, ({
    "fragt Dich: Kann man das jagen?\n",
    "sagt: Na so was!\n",
    "fragt: Warum?\n",
    "gruebelt.\n",
    "sagt: Hat das was mit Jagen zu tun?\n",
    "sagt: Das hab ich noch nie gejagt!\n"}) );
  AddLibrary( NPC "tijara.lib", 1);
  AddLibrary( NPC "tiere.lib", 1);
  AddLibrary( NPC "tiere2.lib", 1);
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"bogen", "jagdbogen"}),
    "Kein wildes Tier entkommt meinem Jagdbogen!", "sagt stolz: ");
  AddInfo( ({"jaeger", "grosswildjaeger"}), "nickt.\n");
  AddInfo( ({"baerenfalle", "falle"}),
    "Grizzlybaeren fange ich immer mit meiner Baerenfalle.", "sagt: ");
  AddInfo( ({"rudel"}),
    "Woelfe sind nur gefaehrlich, wenn sie im Rudel auftreten.", "sagt: ");
  AddInfo( ({"tiere", "tier", "wild", "kleinwild", "grosswild"}),
    "Ich habe schon alle wilden Tiere erfolgreich gejagt!", "sagt: ");
  AddInfo( ({"jagd", "meister", "jagen"}),
    "Ich bin ein Meister der Jagd.", "sagt: ");
  AddInfo( ({"jagdtrophaeen", "raubtierzaehne", "raubtierzahn", "zaehne",
             "zahn", "baerentatzen", "baerentatze", "tatzen", "tatze", 
             "adlerfeder", "adlerfedern", "trophaeen", 
             "trophaee", "jagdtrophaee"}),
    "Ich habe schone viele Trophaeen errungen. Einige habe ich mir aufgehoben, "
    "aber die meisten verkaufe ich an einen Trophaeensammler.", "sagt: "); 
  AddInfo( ({"trophaensammler", "sammler", "zwerg"}),
    "Der Trophaeensammler ist ein reicher Zwerg und lebt im Sueden von "
    "Tijara. Er ist mein bester Kunde. Leider habe ich gerade wenig Zeit, um "
    "neue Trophaeen fuer ihn zu jagen, aber vielleicht willst mir Du ja "
    "helfen.", "sagt: ");
  AddInfo( ({"fraggle", "ameise", "frosch", "igel", "biene", "strandlaeufer" }),
    "Aber das ist doch Kleinwild....", "sagt veraechtlich: ");
  AddInfo( ({"hilfe"}),
    "Natuerlich kannst Du mir helfen! Du brauchst nur ein "
    "Praeparationswerkzeug, dann sage ich Dir, welche Tiere Du jagen sollst.",
    "sagt: ");  
  AddInfo( ({"praeparationswerkzeug", "werkzeug", "praeparation"}),
    "@@werkzeug@@");
  AddInfo( ({"messer"}),
    "Ein Messer kannst Du in jedem Waffenladen kaufen, versuchs doch mal "
    "bei Shagraz am Hauptplatz.", "sagt: ");
  AddInfo( ({"wolle"}),
    "Wolle bekommt man von Schafen.", "sagt: ");
  AddInfo( ({"schaf", "schafe"}),
    "Schafe werden meist von Hobbits gehalten.", "sagt: ");
  AddInfo( ({"feder", "federn"}),
    "Federn hat fast jeder Vogel.", "sagt: ");
  AddInfo( ({"papageienfedern", "papagei", "papageie"}),
    "Papageie findet man sehr haeufig im Dschungel.", "sagt: "); 
  AddInfo( ({"faden"}),
    "Guten Faden zum Naehen bekommt man von der Schneiderin der "
    "Dschungelelfen.", "sagt: ");
  AddInfo( ({"nadel"}),
    "Ein Schmied kann Dir sicher eine solide Nadel verkaufen.", "sagt: ");
  AddInfo( ({"kerbe", "kerben"}), "@@info_kerben@@");
  AddInfo( ({"sumpf", "wald", "wueste"}),
      "Dort gibt es viele wilde Tiere zum Jagen.", "sagt: ");
  SetProp(P_LOG_INFO, "feyaria/tijara");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Grosswildjaeger sagt: Mich interessieren nur ausgestopfte "
    "Tierkoepfe.\n" }) );

  SetProp(P_SPELLRATE, 40);
  AddDefaultSpell(1, 400, DS_DEAF,
    "Der Grosswildjaeger schreit Dich mit seinem Jagdruf an.\n",
    "Der Grosswildjaeger schreit @WEN mit seinem Jagdruf an.\n");
  AddSpell(4, 500,
    "Der Grosswildjaeger gibt Dir einen gewaltigen Faustschlag.\n",
    "Der Grosswildjaeger gibt @WEM einen gewaltigen Faustschlag.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 650,
    "Der Grosswildjaeger faengt Dich in einer Baerenfalle.\n",
    "Der Grosswildjaeger faengt @WEN in einer Baerenfalle.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    "Der Grosswildjaeger sagt: Mit dieser Baerenfalle hab ich den Grizzly "
      "gefangen.\n",
    "Der Grosswildjaeger sagt: Ich habe keine Angst vor wilden Tieren.\n",
    "Der Grosswildjaeger prahlt: Ich habe schon jedes Tier gejagt.\n",
    "Der Grosswildjaeger sagt: Der wilde Dschungeltiger hat keine Chance "
      "gegen mich!\n",
    "Der Grosswildjaeger sagt: Der Vogel Rok fuerchtet sich vor mir!\n",
    break_string("Die dreikoepfige Gelbschwanzechse ist sehr selten, aber "
      "ich hab sie schon erfolgreich gejagt.",78,"Der Grosswildjaeger sagt: "),
    "Der Grosswildjaeger sagt: Einen Puma erledige ich mit Links!\n",
    "Der Grosswildjaeger zeigt Dir seinen Jagdbogen.\n",
    "Der Grosswildjaeger zeigt Dir seine Baerenfalle.\n",
    "Der Grosswildjaeger sagt: Krokodile sind sehr gefaehrlich.\n",
    "Der Grosswildjaeger sagt: Eisbaeren sind die groessten Baeren.\n",
    "Der Grosswildjaeger sagt: Der Sandloewe ist der Koenig der Wueste.\n",
    "Der Grosswildjaeger sagt: Der Trophaeensammler will so viele Tierkoepfe "
      "von mir. :(\n",
    "Der Grosswildjaeger fragt: Soll ich Dir etwas ueber die Jagd "
     "erzaehlen.\n",
    "Der Grosswildjaeger sagt: Ich bin staerker als ein ganzes Rudel "
     "Woelfe!\n",
    "Der Grosswildjaeger sagt: Ich habe schon einen Jaguar gejagt!\n"}) );


//  AddInfo( ({"kerbholz"}), "@@kerbholz@@");  
  SUID;
  CLONEME( "/d/kristallwald/sargola/dorf/weapon/bogen");
  present("bogen")->SetProp(P_WC_BONUS, (["grosswildjaeger": 150]) );
  command("zuecke bogen");
  if( random(100) < 60 ) CLONEME("/p/armour/helm/hut");
  if( random(100) < 50 ) CLONEME("/p/armour/trousers/lederhose");
  CLONEME("/p/armour/armour/lederpanzer");
  command("trage alles");

  kerbenitem = KERBENITEMS[random(sizeof(KERBENITEMS))];

  AddCmd( ({"liefer", "liefere"}), "abliefern");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": Der Grosswildjaeger hat gerade "+CAP(getuid(player))+
      " umgebracht. ( -"+lostexp+" XP)\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  string wie;
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "intim":
    case "aergerlich":
    case "fies":
    case "frech":
      if( random(2) )
        call_out("react", 0, "gibt Dir einen Tritt.",
          "gibt "+TP->name(WEM)+" einen Tritt.");
      else if( gruppe=="fies" && random(3) )
        call_out("toeten",2);
      break;
    case "froh":
    case "nett":
    case "neutral":  
      if( (TP->QueryProp(P_GENDER) == FEMALE || TP->QueryProp(P_RACE)=="Elf")
           && random(2) )
        call_out("react", 0, "knuddelt Dich.", "knuddelt "+TP->name(WEN)+".");
      break;
    case "traurig":
    case "albern":
    case "aengstlich":
      if( !random(4) )
        call_out("react", 0, "lacht Dich aus.",
          "lacht "+TP->name(WEN)+" aus.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others=victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void toeten()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), 
      Name(WER, 1)+" ruft: Dafuer musst Du sterben, "+TPN+"!\n");
    Kill(TP);
  }
}


int name2int(string str)
{
  int i, ret;
  for(i=0;i<strlen(str);i++)
  {
    switch ( str[i..i] )
    {
      case "z": ret+=i;
      case "y": ret+=i;
      case "x": ret+=i;
      case "w": ret+=i;
      case "v": ret+=i;
      case "u": ret+=i;
      case "t": ret+=i;
      case "s": ret+=i;
      case "r": ret+=i;
      case "q": ret+=i;
      case "p": ret+=i;
      case "o": ret+=i;
      case "n": ret+=i;
      case "m": ret+=i;
      case "l": ret+=i;
      case "k": ret+=i;
      case "j": ret+=i;
      case "i": ret+=i;
      case "h": ret+=i;
      case "g": ret+=i;
      case "f": ret+=i;
      case "e": ret+=i;
      case "d": ret+=i;
      case "c": ret+=i;
      case "b": ret+=i;
      case "a": ret+=i;
    }
  }
  return ret;
}

string* tier_auswahl(string name)
{
  string* tiere;
  int i,wert;
  wert=name2int(name);
  tiere= ({"", "", "", "", "", "", "", ""});
  tiere[0]=TIERE1[wert%(sizeof(TIERE1))];
  tiere[1]=TIERE2[wert%(sizeof(TIERE2))];
  tiere[2]=TIERE3[wert%(sizeof(TIERE3))];
  tiere[3]=TIERE4[wert%(sizeof(TIERE4))];
  tiere[4]=TIERE5[wert%(sizeof(TIERE5))];
  tiere[5]=TIERE6[wert%(sizeof(TIERE6))];
  tiere[6]=TIERE7[wert%(sizeof(TIERE7))];
  tiere[7]=TIERE8[wert%(sizeof(TIERE8))];

  return tiere;
}

string werkzeug()
{
  object messer, faden, nadel, ob;
  int i;
  string* tiere;
  
  if( TP->QueryQuest(JAEGERQUEST) )
    return "sagt: Das Praeparieren war eine lustige Sache, nicht wahr?\n";
// Quest ist noch nicht angeschlossen !!!!!
//  if( !IS_WIZARD(TP) && !TP->QueryProp(P_TESTPLAYER) )
//    return "sagt: Du brauchst kein Praeparationswerkzeug!\n"; 
  write( break_string( 
    "Um tote Tiere laenger zu erhalten, muss man sie ausstopfen. Dazu "
    "verwendet man am besten Praeparationswerkzeug. Ich kann Dir eines "
    "zusammenstellen, wenn Du mir ein paar wichtige Einzelteile bringst. "
    "Du brauchst auf jeden Fall ein scharfes Messer zum abtrennen des "
    "Tierkopfes, Federn und Wolle zum ausstopfen und Nadel und Faden zum "
    "zunaehen.", 78, "Der Grosswildjaeger sagt: ") );
        
  if( present(JAEGERQUESTID, TP) )
    return "sagt: Oh! Du hast ja schon ein Praeparationswerkzeug!\n";
  if( !messer=present("messer", TP) )
    return "sagt: Dir fehlt das Messer!\n";
  if( !faden=present("faden", TP) )
    return "sagt: Dir fehlt noch ein Faden.\n";
  if( !nadel=present("nadel", TP) )
    return "sagt: Dir fehlt noch eine Nadel.\n";
  if( !present("wolle 5", TP) )
    return "sagt: Du hast noch zu wenig Wolle.\n";
  if( !present("feder 5", TP) )
    return "sagt: Du hast noch zu wenig Federn.\n";
  messer->remove();
  nadel->remove();
  if (objectp(faden))
    faden->remove();
  while( ob=present("wolle", TP) )
    ob->remove();
  while( ob=present("feder", TP) )
   ob->remove();
  write( BS("Der Grosswildjaeger nimmt Dir die ganzen Sachen ab und gibt "
      "Dir dafuer ein Praeparationswerkzeug."));
  tell_room( MENV, BS(CAP_TPN+ " gibt dem Grosswildjaeger einige Sachen und "
      "bekommt dafuer ein Praeparationswerkzeug."), ({TP}) );
  ob=clone_object(OBJ "pwerkzeug");
  ob->set_tiere( tiere=tier_auswahl(getuid(TP)) );
  ob->move(TP, M_NOCHECK);
  write( break_string(
    "Von folgenden Tieren brauche ich dringend einen ausgestopften Kopf: "+
    tiere[0]+", "+tiere[1]+", "+tiere[2]+", "+tiere[3]+", "+tiere[4]+", "+
    tiere[5]+", "+tiere[6]+" und "+ tiere[7]+"." ,
    78, "Der Grosswildjaeger sagt: ") );
  DB("JAEGERQUEST: "+TPN+": "+ tiere[0]+", "+tiere[1]+", "+tiere[2]+", "+tiere[3]+", "+tiere[4]+", "+
          tiere[5]+", "+tiere[6]+" und "+ tiere[7]+".\n");
  return "sagt: Jage diese Tiere und bring mir ihre Koepfe.\n";
}

int abliefern(string str)
{
  object ob;
  int i, gq;
  object w;
  object *koepfe;
  string* tiere, kopfname;

  notify_fail("Was willst Du abliefern?\n");
  if (!str)
    return 0;
  if (sscanf(str, "%s ab", kopfname) != 1)
    return 0;
  if (!objectp(ob = present(kopfname, TP)))
    return notify_fail("Du hast ja gar kein "+CAP(str)+"!\n"),0;
  if (!ob->id("\njaegerquest_kopf"))
    return notify_fail("Du kannst nur praeparierte Tierkoepfe abliefern!\n"),0;

  if (!objectp(w = present(JAEGERQUESTID, TP)))
  {  
    write("Der Grosswildjaeger sagt: Wo hast Du Dein Praeparationswerkzeug "
        "gelassen?\nDer Grosswildjaeger gibt Dir "+ob->name(WEN,1)+ 
        " wieder zurueck.\n");
    return 1;
  }
  tiere=w->query_tiere();
  koepfe=({ 0,0,0,0,0,0,0,0});
  for(i=sizeof(tiere)-1;i>=0;i--)
  {  
    if( tiere[i][<1..]=="e" ) kopfname=tiere[i]+"nkopf";
    else kopfname=tiere[i]+"kopf";
    if( !koepfe[i] = present( "\nquest_"+kopfname , TP) )
    {
      write(break_string("Du hast noch nicht alle Koepfe beisammen. Gib "
            "sie mir erst, wenn Du alle hast.",78,"Der Grosswildjaeger sagt: ") );
      return 1;
    }
  }
  if( (gq=TP->GiveQuest(JAEGERQUEST)) == 1)
  {
    write_file (JAEGERQUESTLOG,
        sprintf ("%s  %s hat alle Tierkoepfe beisammen.\n",
          dtime(time()), CAP(TP->query_real_name())));
    WLOG( LOG "jaegerquest", "gibt die Koepfe ab");
    write(break_string("Du hast alle Koepfe beisammen!!! Toll! ich werde "
          "sie gleich nacher dem Trophaeensammler vorbeibringen."
          ,78,"Der Grosswildjaeger sagt: ") );
    write( BS("Der Grosswildjaeger nimmt Dir alle Koepfe und das "
          "Praeparationswerkzeug ab und gibt Dir zwei kleine Flaschen als "
          "Belohnung."));
    write(break_string("Ich werde nun Deine weitere Jaegerkarriere "
          "unterstuetzen. Wenn Du mich nach 'kerben' fragst, sage ich Dir, "
          "wo sich die Jagd fuer Dich noch lohnt.", 
          78, "Der Grosswildjaeger sagt: "));
    say(BS("Der Grosswildjaeger freut sich, weil "+TPN+" ihm einige "
          "praeparierte Tierkoepfe gebracht hat."));
    for(i=sizeof(tiere)-1;i>=0;i--)
      koepfe[i]->remove();
    w->remove();
    CLONE (OBJ "rbalsam", TP);
    if (TP->QueryProp(P_GUILD) == "druidenzirkel")
      CLONE (OBJ "rbalsam", TP);
    else
      CLONE (OBJ "wbalsam", TP);
  }
  else
    write("\nBUG im GiveQuest:"+gq+" !! Erzmagier oder Feyaria "
        "benachrichtigen!!!\n\n\n");
  return 1;
}

give_notify(object ob)
{
  if (ob->id(kerbenitem))
  {
    write("Der Grosswildjaeger sagt: Danke! Jetzt kannst Du mich nach Kerben "
        "fragen!\n");
  }
  else
    ::give_notify(ob);
}
