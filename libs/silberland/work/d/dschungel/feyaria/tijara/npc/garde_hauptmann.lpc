// /d/dschungel/feyaria/tijara/npc/gardist2.c   
// Ein Stadtgardist in Tijara (Torwache)
// 31-10-1996  Feyaria@SilberLand

#include "../def.h"
inherit NPC "gardist";

#define GMASTER NPC "garde_master"

void create()
{
  object ob;
  int i;
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_LONG, 
    "Dieser Stadtgardist bewacht das Stadttor von Tijara.  Er traegt "
    "trotz der Hitze eine bronzene Ruestung und ist mit einer Hellebarde "
    "bewaffnet. Mit seinen strengen Augen mustert er Dich, ob Du nicht "
    "illegale Gueter nach Tijara schmuggeln willst.") ;

//  SetProp(P_SHORT_FIGHT, 
//      "Ein Stadtgardist beschuetzt Tijara gegen %s");
  SetProp(P_SHORT, 
      "Der Hauptmann der Stadtgarde");
  SetProp(P_NAME, "Hauptmann der Stadtgarde");
  AddId( ({"hauptmann", "Speermeister"}) );
  set_living_name("gardehauptmann");

  create_default_npc(40);
  AddInfo( ({"hauptmann"}),
    "Ich bin der Hauptmann der Stadtgarde.","sagt: ");

  SetProp (P_MNPC_AREA, ROOM );
  SetProp (P_MNPC_WAIT, ({ 100, 90, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "platz_d5");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);


  SetChats(3, ({
    "Der Hauptmann sagt: Personenkontrolle! Zeig mir Deine Papiere.\n",
    "Der Hauptmann wischt sich den Schweiss von der Stirn.\n"}) );

  SetAttackChats(5, ({
    "Der Hauptmann ruft: Garde zu mir!\n",
    "Der Hauptmann bruellt: Ergib Dich, Verraeter.\n"}) );

  if( !present("armschienen") )
    CLONEME( ARMOUR "armschienen");
  if( !present("beinschienen") )
    CLONEME( ARMOUR "beinschienen");  
  if( !present("medaille") )
    CLONEME( ARMOUR "medaille");  
  command("trage alles");
  for(i=0;i<5;i++)
  {
    ob = present(({"panzer","helm","armschienen","beinschienen", "hellebarde"})[i]);
    ob->SetProp(P_M_HEALTH_MOD, ([P_HP:1+random(7), P_SP:1+random(7)]) );
    if (ob->QueryProp(P_AC))
      ob->SetProp(P_AC, 10*ob->QueryProp(P_AC)/7);
    else
      ob->SetProp(P_WC, 255);
    ob->SetProp(P_QUALITY_DECAY, ob->QueryProp(P_QUALITY_DECAY)+100+random(100));
    ob->AddAdjective(({"hochqualitativ", "hochqualitative", "hochqualitativen"}));
    if( ob->QueryProp(P_PLURAL) )
      ob->SetProp(P_NAME_ADJ, ({"hochqualitativ", "bronzen"}));
    else
      ob->SetProp(P_NAME_ADJ, "hochqualitativ");
    ob->SetProp(P_SHORT, ob->Name());
  }
}

void die(int poisondeath)
{
  write_file(LOG "hauptmann",
    ctime()+": "+CAP(getuid(TP))+" killt den Garde Hauptmann.\n");
  ::die(poisondeath);
}
