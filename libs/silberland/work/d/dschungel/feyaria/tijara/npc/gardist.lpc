// /d/dschungel/feyaria/tijara/npc/gardist.c   
// Ein Stadtgardist in Tijara
// 31-10-1996  Feyaria@SilberLand


inherit "std/mnpc";
inherit "std/inpc/select";

#include <inpc.h>
#include "../def.h"
#include "../rattenquest.h"

#define GMASTER NPC "garde_master"

int veteran;
 
void create()
{
  if (!is_clone(TO)) return;

  mnpc::create();
  add_select_commands();

  SetProp(P_SHORT, 
      "Ein Stadtgardist sorgt fuer Ruhe und Ordnung in Tijara");
//  SetProp(P_SHORT_FIGHT, 
//      "Ein Stadtgardist beschuetzt Tijara gegen %s");
  SetProp(P_LONG, BS(
    "Dieser Stadtgardist sorgt in Tijara fuer Ruhe und Ordnung. Er traegt "
    "trotz der Hitze eine bronzene Ruestung und ist mit einer Hellebarde "
    "bewaffnet. Mit seinen strengen Augen mustert er Dich, ob Du nicht "
    "etwas gegen die Stadt Tijara im Schilde fuehrst.") );
  SetProp(P_NAME, "Stadtgardist");
  SetProp(P_GENDER, MALE);
  AddId( ({"stadtgardist", "gardist", "\ntijaragardist"}) );

  if(random(10)==1) veteran=1;
  create_default_npc(20+veteran*2);
  SetProp(P_HANDS, ({" mit harten Faeusten", 200, DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 50+random(100)+veteran*80);

  SetProp(P_MSGIN, "patrouilliert herein");
  SetProp(P_MSGOUT, "patrouilliert");
  SetProp(P_MMSGIN, "eilt herein");
  SetProp(P_MMSGOUT, "kehrt an seinen Posten zurueck");

  SetProp(P_DIE_MSG,  " stirbt in Pflichterfuellung.\n");
  SetProp(P_KILL_NAME, "Die Stadtgarde von Tijara");

  AddLibrary(NPC "tijara.lib",1);
  AddInfo(DEFAULT_INFO,({
    "beachtet Dich gar nicht.\n",
    "gruebelt ueber diese Frage.\n",
    "staunt nur.\n",
    "fragt: Wie hast Du das jetzt gemeint.\n",
    "denkt kurz nach und schuettelt dann den Kopf.\n",
    "kratzt sich am Kopf.\n",
    "sagt: Du kannst aber komische Fragen stellen.\n",
    "sagt: Ich bin doch nur ein einfacher Gardist.\n",
    "seufzt: Tut mir leid, darueber weiss ich nichts.\n",
    "sagt: Keine Ahnung.\n",
    "sagt: Hmm, ich werde darueber nachdenken.\n",
    "antwortet etwas, aber Du verstehst es nicht.\n",
    "gratuliert Dir zu Deiner Weisheit.\n",
    "sagt: Ach ja, wie war das gleich....\n",
    "sagt: Sowas kann man als Stadtgardist nicht wissen.\n",
    "sagt: War wirklich nett, mit Dir zu plaudern.\n"}) );
  AddInfo("feyaria",
    "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"aufgabe", "beruf", "dienst"}),
    "Wir Gardisten bewachen die Stadt Tijara.","belehrt Dich: ");
  AddInfo( ({"hellebarde", "waffe"}),
    "Eine schoene Waffe, nicht wahr?","sagt: ");
  AddInfo( ({"machete"}),
    "Eine Machete ist ganz nuetzlich im Dschungel.", "sagt: ");
  AddInfo( ({"helm", "bronzehelm", "panzer", "bronzepanzer", "schienen",
             "armschienen", "beinschienen", "ruestung"}),
    "Das ist wirklich eine gute Ruestung.","sagt: ");
  AddInfo( ({"medaille", "tapferkeitsmedaille"}),
    "Eine Tapferkeitsmedaille tragen nur die Veteranen unter den "
    "Stadtgardisten.", "erzaehlt Dir: ");
  AddInfo( ({"gardist", "stadtgardist", "garde", "stadtgarde"}),
    "Wir beschuetzen die Stadt Tijara mit unserem Leben.","sagt: ");
  AddInfo( ({"name"}),
    "Mein Name geht Dich nichts an.", "schnautzt dich an: ");
  AddInfo( ({"papiere", "ausweis", "personenkontrolle", "kontrolle"}),
    "Zeig mir Deine Papiere!", "sagt: ");
  AddInfo( ({"ketzer"}),
    "Diesen verfluchten Ketzer suchen wir schon lange.", "sagt: ");
  AddInfo( ({"hitze", "schweiss"}),
    "Es ist wirklich schoen heiss hier.", "haechelt: ");
  AddInfo( ({"sonne", "wetter", "himmel"}),
    "Die Sonne brennt hier immer herunter.", "stoehnt: ");
  AddInfo( ({"mauer", "stadtmauer", "pfloecke", "holzpfloecke"}),
    "Die Stadtmauer schuetzt Tijara vor Gefahren.", "sagt: ");
  SetProp(P_LOG_INFO, "feyaria/gardist.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Stadtgardist fragt Dich: Was soll ich damit?\n" }) );

  SetProp (P_MNPC_AREA, (ROOM) );
  SetProp (P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "platz_d5");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_SPELLRATE,15);
  AddSpell(2,333,
    "Der Stadtgardist spiesst Dich mit der Hellebarde auf.\n",
    "Der Stadtgardist spiesst @WEN mit der Hellebarde auf.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,444,
    "Der Stadtgardist schlaegt Dir die Hellebarde auf den Kopf.\n",
    "Der Stadtgardist schlaegt @WEM die Hellebarde auf den Kopf.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Stadtgardist sagt: Personenkontrolle! Zeig mir Deine Papiere.\n",
    "Der Stadtgardist wischt sich den Schweiss von der Stirn.\n"}) );

  SetAttackChats(5, ({
    "Der Stadtgardist ruft: Garde zu mir!\n",
    "Der Stadtgardist bruellt: Ergib Dich, Verraeter.\n"}) );

  SUID;  // Ausruestung muss natuerlich auch sein
  CLONEME( "/p/weapon/spear/hellebarde" );
  command("zuecke hellebarde");

  if(veteran)
    CLONEME( ARMOUR "medaille");
  if( random(20-15*veteran)==1 )
    CLONEME( ARMOUR "armschienen");
  if( random(20-15*veteran)==1 )
    CLONEME( ARMOUR "beinschienen");  
  CLONEME( "/p/armour/armour/bronzepanzer" );
  CLONEME( "/p/armour/helm/bronzehelm" );

  command("trage alles");

  add_select_commands();

  MASTER->add_gardist();

}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  GMASTER->ruf_um_hilfe(enemy);
  ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object *obs;
  string raum;
  string *raum2;
  mapping exits; 
  string *ausgaenge;
  object ob;

  if(sizeof(exits = environment()->QueryProp(P_EXITS)))
  {
    ausgaenge = m_indices(exits);
    for( i = sizeof(ausgaenge)-1; i>=0; i-- )
    {
      if( !objectp(enemy) ) return;
      raum2 = explode(exits[ausgaenge[i]], "#");
      raum = raum2[sizeof(raum2)-1];

      if(objectp(ob = find_object(raum)))
      {
        obs = filter_objects(all_inventory(ob), "id", "\ntijaragardist");
        if(sizeof(obs))
        {
          obs[0]->move(environment(this_player()), M_TPORT, 0, 
              "eilt einem Kameraden zuhilfe",
              "kommt seinem Kameraden zuhilfe");
          if(enemy) ::Attack(enemy);
          return;
        }
      }
    }
  }
  if(enemy) ::Attack(enemy);
}

varargs int remove(int arg)
{
  GMASTER->remove_gardist(this_object());
  ::remove(arg);
}

void init()
{
  ::init();
  if(TP && TP->id("\ntijaragardist"))
    AddDefender(TP);
  if( GMASTER->IsFeind(TP) )
    Kill(TP);
  else
    call_out("fruchttest",0);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void fruchttest()
{
  if(!TP || MENV!=ENV(TP) || InFight())
    return;
  if( !random(5) && present("\nplantangenfrucht",TP) && 
      interactive(TP) && !present("\nquestliste", TP) &&
      !present(RATTENQUESTID, TP) )
  {
    tell_room(MENV, break_string("Du hast die Fruechte des Gouverneurs "
      "gestohlen, "+TPN+"! Dafuer musst Du sterben!",78,
      "Der Stadtgardist schreit: "));
    Kill(TP);
  }
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  MASTER->Sieg(player);
  if( player->QueryProp(P_LEVEL)>random(40) && QueryProp(P_LEVEL)==20)
  {
    veteran=1;
    create_default_npc(20+veteran*2);
    SetProp(P_HANDS, ({" mit harten Faeusten", 200, DT_BLUDGEON}));
    CLONEME( ARMOUR "medaille");
    if( !present("armschienen") &&!random(4))
      CLONEME( ARMOUR "armschienen");
    if( !present("beinschienen") &&!random(4) )
      CLONEME( ARMOUR "beinschienen");
  } 
  if( !random(3) )
  {
    call_out( "command_me", 0, "nimm alles aus leiche");
    call_out("command_me", 2, "trage_beste_ruestungen");
    call_out( "command_me", 4, "trage alles");
  }
}

void reset() 
{
  mnpc::reset();
}

