// /d/dschungel/feyaria/tijara/npc/ketzer.c   
// Ein Ketzer
// 14-11-1996  Feyaria@SilberLand


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Ketzer");
  SetProp(P_LONG, BS(
    "Dieser Ketzer verleugnet die Existenz von Goettern. Mit einem Bein "
    "steht er auf einem Haufen Staub und mit dem anderen Bein auf einem "
    "Stueck Holz. Mit geringschaetzendem Blick sieht er Dich an."));
  SetProp(P_NAME, "Ketzer");
  SetProp(P_GENDER, MALE);
  set_living_name("ketzer");
  AddId(({"ketzer"}));
  AddDetail( ({"staub", "holz"}), BS(
    "Staub und Holz erinnern Dich irgendwie an Goetter, aber warum bloss?"));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen ketzerischen Haenden",180 ,DT_BLUDGEON}));
  SetProp(P_XP,QueryProp(P_XP)+1000*100); // Bonus fuer Spells und Nomagic
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 172);
  SetProp(P_ALIGN, -666);
  SetProp(P_RESISTANCE, MAGICAL_DAMAGE_TYPES ); 
  SetProp(P_NOMAGIC, 95);

  SetProp(P_DIE_MSG,  " wird nun die Macht der Goetter erfahren.\n");
  SetProp( P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Glaub mir, %s, es gibt keine Goetter!");
  SetProp(P_KILL_MSG, "Glaubt mir doch, es gibt keine Goetter!");

  SetProp(P_DEFAULT_INFO,"sagt: Es gibt keine Goetter.\n");
  AddInfo("feyaria",
    "Feyaria hat mich erschaffen.", "sagt: ");
  AddInfo( ({"dusty", "woody", "staub", "holz", "gott", "goetter",
             "staub und holz"}),
    "Das ist bestimmt kein Gott.", "sagt: ");
  AddInfo( ({"kultstaette", "altar"}),
    "Ich werde diese Kultstaette vernichten.", "schreit: ");
  AddInfo( ({"amulett", "tasliman"}),
    "Dieses Amulett schuetzt mich vor Zauberei.", "fluestert Dir zu: ",1);
  AddInfo( ({"beten", "gebet"}),
    "Gebete bringen sicher nichts.", "versichert Dir: ");
  AddInfo( ({"ausgang"}),
    "Nur die Goetter kennen den Ausgang!", "sagt geheimnisvoll: ");
  
  SetProp(P_LOG_INFO, "feyaria/ketzer.log");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Ketzer gibt Dir Deinen Plunder wieder zurueck.\n" }) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_SPELLRATE,5);
  AddSpell(1,600,
    "Der Ketzer treibt Dir Deinen Goetterglauben aus.\n",
    "Der Ketzer treibt @WEM den Goetterglauben aus.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    "Der Ketzer zerstoert einen weiteren Teil des Altars.\n",
    "Der Ketzer will Dich ueberzeugen, dass es keine Goetter gibt.\n",
    "Der Ketzer erzaehlt: Die ganze Welt besteht nur aus Staub und Holz.\n",
    "Der Ketzer sagt: Es gibt keine Goetter.\n"}) );
  SetAttackChats(10, ({
    "Der Ketzer versucht, Dich gottlos zu machen.\n",
    "Der Ketzer verflucht alle Goetterknechte.\n"}) );

  SUID;  // Ausruestung muss natuerlich auch sein
  if( random(3) )
    CLONEME(ARMOUR "amulett");
  command("trage alles");
}

void die(int poisondeath) {
  object item;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(5, TP))
    item->SetFlag(0);
  ::die(poisondeath);
}
          
