  nosave void ivory_questfunc(object obj, object * all_inv, int ivory_questitems) 
  {
    object ob,quest_item;
    int i;
    quest_item=deep_present(IV_QUEST_ITEM, TP);
  if(quest_item && quest_item->check_completed()==1 &&
      quest_item->check_owner(TP)) 
  {
    if(ivory_questitems!=3) {
      command_me("sag Tja, leider stimmt da etwas nicht. Am besten "
	"ueberpruefst Du die Rezeptur nochmal.");
      tell_room(ENV(ME), sprintf("Elsurion gibt %s an %s.\n", obj->name(WEN), 
        TP->name(WER)), ({TP}));
      tell_object(TP, sprintf("Elsurion gibt Dir %s.\n", obj->name(WEN)));
      obj->move(TP, M_NOCHECK|M_SILENT);
      return;
    }
    tell_room(ENV(ME), BS("Ein kleines Stinkewoelkchen steigt mit einem "
	    "kleinen *KAWUFF* aus dem Tiegel auf.\n"));
    if(ENV(ME)!=ENV(TP)) {
      command_me(sprintf("Huch, wo ist %s denn hin. Ich habe doch noch %s "
	  "Tiegel. Naja, dann entsorge ich den mal.", TP->name(WER), 
	  TP->QPP(MALE, WESSEN, PLURAL)));
      quest_item->reset_quest();
    }
    else {
      command_me("sag So, bitte sehr. Der Balsam ist fertig.");
      ob=clone_object(IVORY_QUESTITEM);
      ob->set_may_apply_balm(TP->query_real_name());
      tell_room(ENV(ME), sprintf("Elsurion gibt %s an %s.\n", ob->name(WEN), 
      TP->name(WER)), ({TP}));
      tell_object(TP, sprintf("Elsurion gibt Dir %s.\n", ob->name(WEN)));
      ob->move(TP, M_NOCHECK|M_SILENT);
      tell_object(TP, BS("Du hast Dir genau eingepraegt wie Elsurion den "
	    "Balsam gemischt hat. Du wirst jedoch nie einen so hochmagischen "
	    "Balsam wie Elsurion mischen koennen. Darauf verwettest Du "
	    "Deine Leber."));
      //quest_item->reset_quest();
    }
  }
  else {
     command_me("sag Hier stimmt etwas nicht. Du scheinst nicht alles "
	 "selber gemacht zu haben. Willst Du mich betruegen?");
  }
  for(i=sizeof(all_inv)-1;i>=0;i--)
    all_inv[i]->remove();
  obj->remove();
  return; 
}

int do_frage(string question, string text)
{
  if (ASTRALMASTER->QueryFlag(getuid(this_player()), FLAG_TIME) && 
      member(time, TP) == -1)
  {
    time += ({TP});
    write(break_string("Ich sehe, Du hast die maechtigen Wesen der Ebenen der "
          "Macht besiegt, nun bist Du bereit, Dich dem Herrn der Zeit zu "
          "stellen. Dazu musst Du den Trippelpunkt in der Astralebene finden "
          "und den geheimen Namen der Herrn der Zeit aussprechen." ,
          78, "Elsurion fluestert Dir zu: "));
    say ("Elsurion fluestert " + TP->name(WEM) + " etwas zu.\n", 
        ({TP}));
    return 1;
  }
  return ::do_frage(question, text);
}
