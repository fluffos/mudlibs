int schutz, verkaufen;
object *time= ({});

public string windflasche() {
  if(this_player()->QueryProp(P_GUILD) != "bardengilde") {
    return "Mit einer Windflasche kann man natuerlich Winde einfangen. Aber damit koenntest du "
           "ohnehin nichts anfangen. Die Winde werden nur von guter Musik angelockt.";
  }

  if(this_player()->QuerySkillAbility("Musizieren") < 1000) {
    return "Mit einer Windflasche kann man natuerlich Winde einfangen. Aber damit koenntest du "
           "noch nichts anfangen. Wenn du ein besserer Musikant bist, leihe ich sie dir gerne.";
  }

  if(objectp(present("\nbard_windflasche", this_player()))) return "Ich habe dir meine Flasche doch schon geborgt!";
  if(this_player()->QuerySkill("lied der winde") != 0) {
    return "Du hast die Winde bereits unterworfen. Wozu willst du das nochmal tun?";
  }

  call_out("give_windflasche", 0);
  return "In der Tat habe ich eine Windflasche uebrig. Mit ihr kannst du die Winde einfangen. "
         "Doch bedenke! Dies ist kein leichtes unterfangen. Du kannst die Winde mit deiner Musik "
         "herbeirufen und, wenn du sie ausreichend schwaechst, werden sie in die Flasche gesogen. "
         "Sobald du alle Winde gefangen hast, musst du die Flasche in einem Zug leertrinken!";

}

void create()
{
  if (IS_BLUE(ME)) return;
