public void give_windflasche() {
  object flasche;
  flasche = clone_object("/gilden/bardengilde/obj/quest/windflasche");
  if(flasche->move(this_player(), M_GET) != 1) {
    command("sag Komm wieder, wenn du die Flasche auch tragen kannst!");
    flasche->remove(1);
    return;
  }

  tell_room(environment(this_object()), Name(WER, 1) + " gibt " + this_player()->Name(WER, 1) + " eine Flasche.\n", ({this_player()}));
  tell_object(this_player(), Name(WER, 1) + " gibt Dir eine Flasche.\n");
  return;
}
        
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int i;
  object *ob;
  object owner;

  if( enemy->id("NPC") && !random(3) )
  {
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    owner = enemy->QueryProp(ELEMENTAL_OWNER) ||  // Elementar
            enemy->QueryProp(P_NEKRO_MASTERED_BY) || // Nekro-Pet
            (enemy->QueryMaster() ? find_player(lower_case(enemy->QueryMaster())) : 0); // Daemon
    if(objectp(owner))
    {
      owner->RemovePursuer(enemy);
      owner->RemoveDefender(enemy);
    }
    tell_room(MENV, enemy->Name(WER,2)+" kaempft jetzt fuer Elsurion.\n");
    if( sizeof(ob = PresentEnemies())) 
      for(i=sizeof(ob)-1;i--;i>=0)
        enemy->Kill(ob[i]);
    return 0;
  }
  if( enemy->QueryProp(P_LEVEL)<20)
  {
    if( enemy->QueryProp(P_GENDER)==FEMALE)
      tell_object(enemy,
          "Elsurion sagt: Was willst Du eigentlich, meine Kleine?\n");
    else
    {
      tell_object(enemy,
        "Elsurion sagt: Was willst Du eigentlich, Du Fratz?\n");
      if(random(5)) 
      {
        tell_object(enemy,
          "Elsurion verwandelt Dich in einen Frosch.\n");
        tell_room(ENV(enemy),
          "Elsurion verwandelt "+enemy->name(WEN)+" in einen Frosch.\n");
        enemy->SetProp(P_FROG,1);
      }            
    }
    if(random(2))
    {
      tell_object(enemy,
        "Elsurion sagt: Geh mir aus den Augen!\n"
        "Dir wird schwindlig und ploetzlich bist du ganz woanders.\n");
      tell_room(ENV(enemy),
        "Elsurion laesst "+enemy->name(WEN)+" einfach verschwinden.\n", ({enemy}));
      enemy->move(INSEL,M_TPORT);
    }
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    return 0;
  }
  if(schutz && dam>33)
  {
    if( --schutz==0 ) 
    {
      tell_room(ENV(enemy),
        "Elsurions Schutzhuelle loest sich auf.\n");
    }
    return ::Defend(dam/10, dam_type, spell, enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);
}


void spell_schutz(object enemy, int damage, mixed dam_type)
{
  tell_room(ENV(enemy),
    "Elsurion wird von einer Schutzhuelle eingehuellt.\n");
  if( (schutz+=random(12)+5)>20 ) schutz=20;
  
}

void spell_gift( object enemy, int damage, mixed dam_type)
{
  enemy->AddPoison(1+random(2));
}

void spell_fire(object enemy, int damage, mixed dam_type)
{
  object *enemies;
  int i;
  
  enemies = PresentEnemies(); 
  if( enemies && sizeof(enemies) )
  {
    for( i=sizeof(enemies)-1;i>=0;i--)
    {
      enemies[i]->Defend(100+random(800), DT_FIRE, 
        ([SP_SHOW_DAMAGE:1,SP_NAME:"flammenkugel"]), TO );
    }
  }
}

void spell_death(object enemy, int damage, mixed dam_type)
{
  object ob;
  write_file(LOG "elsurion",
    ctime()+": "+CAP(getuid(enemy))+" bekommt den Todeszauber.\n");
 if (random(100) < enemy->QueryAttribute(A_INT))  // int-prozentige Abwehr
  {
    tell_object(enemy,
      "Du beisst die Zaehne zusammen und wehrst den Zauber ab.\n");
    tell_room(ENV(enemy),
      "Elsurion wird von einem magischen Rueckschlag getroffen.\n");
    TO->reduce_hit_point( random(20) );    
    return;
  }
  if( ob=present("\ntodeszauberschutz", enemy) )
  {
    if( ob->QueryProp(P_WORN) && random(66) < enemy->QueryAttribute(A_INT) )
    {
      tell_object(enemy,
        "Dein Amulett leuchtet auf und wehrt den Zauber ab.\n");
      tell_room(ENV(enemy), "Elsurion wird von einem gewaltigen magischen "
        "Rueckschlag getroffen.\n");
      write_file(LOG "elsurion",
        ctime()+": "+CAP(getuid(enemy))+" : magischer Rueckschlag.\n");
      TO->do_damage( random(100) );
      if( random(2) )
      {
        tell_object(enemy, "Dein Amulett zerfaellt zu Staub.\n");        
        ob->remove();
      }
      return;
    }
    else
    {
      tell_object(enemy,
        "Dein Amulett kann den Todeszauber nur etwas abschwaechen.\n");
      enemy->do_damage( 111+random(222), TO );
      verkaufen=1;
      return;
    }
  }
  tell_object(enemy,
    "\n\nDir wird ploetzlich schwarz vor den Augen .....\n\n\n");
  write_file(LOG "elsurion",
    ctime()+": "+CAP(getuid(enemy))+" stirbt ducht Todszauber.\n");
  enemy->do_damage(1000000, TO);
  verkaufen=1;
}

void spell_hands(object enemy, int damage, mixed dam_type)
{
  SetProp(P_HANDS,({" mit brennenden Haenden", 777, DT_FIRE}) );
  SetProp(P_SPELLRATE, 20);
  call_out("end_hands",random(10)+4);
}

void end_hands()
{
  SetProp(P_HANDS,({" mit seinen alten Haenden", 350, DT_BLUDGEON}) );
  SetProp(P_SPELLRATE, 95);
}

void spell_crazy(object enemy, int damage, mixed dam_type)
{
  int i;
  object *ob;

  if( !interactive(enemy) )
  {
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    tell_room(MENV, enemy->Name(WER,2)+" kaempft jetzt fuer Elsurion.\n");
    if( sizeof(ob = PresentEnemies()))
      for(i=sizeof(ob)-1;i--;i>=0)
        enemy->Kill(ob[i]);
    return;
  }
  enemy->SetProp(P_WIMPY, random(200));
  if( IS_SEER(enemy) ) 
    enemy->SetProp(P_WIMPY_DIRECTION, "rufe Hilfe, ich sterbe gleich!");
}

void spell_alk(object enemy, int damage, mixed dam_type)
{
  int alc;
  int i;
  object *ob;

  if( !interactive(enemy) )
  {
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    tell_room(MENV, enemy->Name(WER,2)+" kaempft jetzt fuer Elsurion.\n");
    if( sizeof(ob = PresentEnemies()))
      for(i=sizeof(ob)-1;i--;i>=0)
        enemy->Kill(ob[i]);
    return;
  }
  if( enemy->QueryProp(P_GUILD)=="zechpreller" ) 
    alc = 0;
  if( enemy->QueryProp(P_GUILD)=="druidenzirkel" ) 
    alc = enemy->QueryProp(P_MAX_ALCOHOL) / 2;
  else 
    alc = enemy->QueryProp(P_MAX_ALCOHOL) ;
  enemy->SetProp(P_ALCOHOL, alc);
}

void spell_zwing(object enemy, int damage, mixed dam_type)
{
  int i;
  object *ob;
  
  if( !interactive(enemy) )
  {
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    tell_room(MENV, enemy->Name(WER,2)+" kaempft jetzt fuer Elsurion.\n");
    if( sizeof(ob = PresentEnemies()))
      for(i=sizeof(ob)-1;i--;i>=0)
        enemy->Kill(ob[i]);
    return;
  }
  switch(random(6))
  {
    case 0: 
      domainshout( CAP(enemy->name())+ " ruft: Ich bin so bloed und greife "
        "Elsurion an!\n");
      break;
    case 1:
      domainshout( CAP(enemy->name())+ " ruft: Elsurion ist echt ein harter "
        "Gegner!\n");
      break;
    case 2:
      tell_object(enemy, "Du wirst alle Deine Sachen weg.\n");
      for(i=sizeof(ob=all_inventory(enemy));i>0;i--)
      {
        ob[i]->move(MENV, M_PUT);
      } 
      enemy->command_me("wirf alles weg");
      break;
    case 3:
      tell_object(enemy, "Du gibts Deine Waffe an Elsurion.\n");
      if( enemy->QueryProp(P_WEAPON) )
      {
        enemy->QueryProp(P_WEAPON)->move(TO, M_GIVE);
      }
      enemy->command_me("gib alle waffen an elsurion");
      verkaufen=1;
      break;
    case 4:
      tell_object(enemy, "Du gibts alle Deine Ruestungen an Elsurion.\n");
      for(i=sizeof(ob=enemy->QueryProp(P_ARMOURS))-1;i>0;i--)
      {
        ob[i]->move(TO, M_GIVE);
      }
      enemy->command_me("gib alle ruestungen an elsurion");
      command("trage alles");
      verkaufen=1;
      break;
    case 5:
      enemy->Kill(present("muellschlucker",MENV));
      break;
  }
}

void give_notify(object ob)
{
  object *all_inv;
  int i, ivory_questitems;
  object kraut;
  object quest_item;
  string adj;
  // Wird fuer die Quest von Crea benoetigt (Ivory Tigers)
  if (ob->id(IV_POT)) 
  {
    if (ob->query_owner()!=getuid(TP)) 
    {
      command_me("emote wirft einen Blick in den Tiegel.");
      command_me("sag He, Du bist doch gar nicht derjenige, der den Tiegel besorgt hat!");
      command_me("emote schimpft und wirft den Tiegel veraechtlich weg.");
      ob->move(ENV(ME));
      return;
    }
    ivory_questitems = 0;
    all_inv = all_inventory(ob);
    for (i = sizeof(all_inv) - 1; i >= 0; i--) 
    {
      if (all_inv[i]->id(IV_HEARTPOWDER) || all_inv[i]->id(IV_FAT) ||
          all_inv[i]->id(IV_MOSSPOWDER))
      {
        ivory_questitems++;
      }
    } 
    if (sizeof(all_inv) > 3) ivory_questitems = 0;
    if(ivory_questitems != 3) {
      command_me("sag Das kann unmoeglich funktionieren!");
      command_me("emote schimpft und wirft den Tiegel veraechtlich weg.");
      ob->move(ENV(ME));
      return;
    }
    command_me("sag Einen Moment, dass muss sehr sorgfaeltig verruehrt werden.");
    tell_room(ENV(ME), BS("Elsurion beginnt sehr schnell in der Mixtur "
	  "zu ruehren!"));
    tell_object(TP, BS("Du beobachtest konzentriert was Elsurion gerade "
	"macht."));
    quest_item=deep_present(IV_QUEST_ITEM, TP);
    if(quest_item && quest_item->check_completed()!=1) {
      command_me("sag Irgendetwas stimmt mit dem Tiegel nicht. Vannor schickt Dich, richtig? "
          "Hast Du den Tiegel auch Vannor gezeigt? Hast Du alles selber geholt und wirklich nichts "
          "ausgelassen? Mir scheint, dass Du irgendwas vergessen hast!");
      command_me("emote wirft den Tiegel weg.");
      ob->move(ENV(ME));
      return ;
    }
    call_out("ivory_questfunc", 12, ob, all_inv, ivory_questitems); 
    return;
  }
  else if ((ob->id("\ngoldschwanz")))
  {
    write("Elsurion bedankt sich bei Dir und gibt Dir ein Wunderkraut als "
            "Belohnung.\n");
    say( "Elsurion bedankt sich bei "+ TP->name(WEM) +".\n", ({TP}) );
    kraut = clone_object( OBJ "wunder");
    kraut->move(ME, M_NOCHECK);
    if (kraut->move(TP, M_GIVE) == ME_TOO_HEAVY)
      {
        command("sag Leider kannst Du es nicht tragen, hier hast Du den "
            "Schwanz wieder zurueck.");
        ob->move(TP, M_NOCHECK);
        kraut->remove();
      }
      else
        ob->remove();
      return;
    }
    else if (ob->id("\nastral_zauberstab"))
    {
      if (TP->QueryMoney() < 10000)
      {
        command("sag Das Zerteilen von Zauberstaeben kostet 9999 Muenzen!\n");
        ob->move(TP, M_NOCHECK);
        say("Elsurion gibt " + ob->name(WEN,1) + " wieder zurueck.\n");
        return;
      }
      if (ob->QueryProp("ladungen") < 2)
      {
        command("sag Dieser Zauberstab hat zu wenige Ladungen!\n");
        ob->move(TP, M_NOCHECK);
        say("Elsurion gibt " + ob->name(WEN,1) + " wieder zurueck.\n");
        return;
      }
      say(BS("Elsurion teilt den Zauberstab in 2 Teile, gib einen zurueck "
            "und wirft den anderen auf den Boden.\n"));
      kraut = clone_object(explode(file_name(ob), "#")[0]);
      kraut->SetProp(P_NAME_ADJ, adj = ob->QueryProp(P_NAME_ADJ)[0]);
      kraut->SetProp(P_ADJECTIVES, 0);
      kraut->AddAdjective( ({adj, adj + "en", adj + "er"}) );
      kraut->SetProp("ladungen", ob->QueryProp("ladungen") / 2);
      ob->SetProp("ladungen", ob->QueryProp("ladungen") / 2);
      ob->move(TP, M_NOCHECK);
      kraut->move(ENV(TP), M_NOCHECK);
      TP->AddMoney(-9999);
    }
    else
      ::give_notify(ob);
    return ::give_notify(ob);
  }

#define  ELEMENT_SECURE "secure_prop"

  // Kills mitloggen
  void die(int poisondeath)
  {
    object spieler, ob;
    spieler=ME->QueryProp(P_KILLER);
    if( spieler &&
       (spieler->QueryProp(P_GUILD))=="druidenzirkel" &&
       (spieler->QueryProp(P_GUILD_LEVEL))==13)
    {
     call_other("/gilden/druidenzirkel/master/druidenmaster",
                "SetTask", spieler, 14);
     call_other("/gilden/druidenzirkel", "LogTask", spieler, 14);
    }
    if (spieler && (ob = present("\nzechpreller_quest_11", spieler)))
      ob->Mark();
    write_file(LOG "elsurion",
      ctime()+": "+CAP(getuid(TP))+" killt Elsurion.\n");
    if( !IS_LEARNER(TP) )
      domainshout(CAP(TP->Name())+ 
          " hat den Meisterzauberer Elsurion bezwungen.\n");
    ::die(poisondeath);
  }

