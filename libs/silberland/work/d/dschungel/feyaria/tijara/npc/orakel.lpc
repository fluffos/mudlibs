inherit "std/mnpc";
inherit "std/orakel";
inherit "std/npc/sequencer";
inherit "std/player/soul";

#include "../def.h"
#include <exploration.h>
#include "./orakel.h"

string *tiere;

void create()
{

  if (!is_clone(TO)) return;
  mnpc::create();
  
  tiere= TIER_NAMEN;

  SetProp(P_SHORT, ORAKEL_NAM);
  SetProp(P_LONG, BS(
    ORAKEL_NAM+" ist ein kleines Maedchen mit zwei roten Zoepfen und einem "
    "rosaroten Kleidchen."));
  SetProp(P_NAME, ORAKEL_NAM);
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({lower_case(ORAKEL_NAM), "maedchen", "orakel"}));
  set_living_name(lower_case(ORAKEL_NAM));
  AddDetail( ({"zopf", "zoepfe"}),
    ORAKEL_NAM+" hat zwei lange, rote Zoepfe.");
  AddDetail( ({"kleid", "kleidchen", "rosarotes kleid",
	       "roasrotes kleidchen"}),
    ORAKEL_NAM+" hat ein huebsches rosarotes Kleidchen an.");

  create_default_npc(7);
  SetProp(P_HANDS, ({" mit ihren zarten Haenden",10,DT_BLUDGEON}));
  SetProp(P_XP, 0);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 142);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 200);
  SetProp(P_NO_GLOBAL_ATTACK, 1);

  SetProp(P_MSGIN, "huepft kichernd herein");
  SetProp(P_MSGOUT, "huepft lustig");
  SetProp(P_MMSGIN, "kommt aus ihrem Versteck heraus");
  SetProp(P_MMSGOUT, "versteckt sich");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "platz_d5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS +MOV_INDOORS+ MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " wird nie wieder lachen.\n");
  SetProp( P_REJECT, ({ REJECT_KEEP, ORAKEL_NAM+" bedankt sich artig.\n" }) );

  CLONEME ( ARMOUR "kleidchen");
  command("trage alles");
  
  SetProp(P_LOG_INFO, "feyaria/orakel");
  AddInfo(DEFAULT_INFO, "@@Default_Infos@@");
  AddLibrary( NPC "tijara.lib",1);
  AddLibrary( NPC "spieler.lib",1);
  AddInfo(({"aufgabe", "aufgaben", "abenteuer", "quests", "quest", "questen"}),
    "@@all_quests@@", "sagt: ");
  AddInfo(ME->QuestIDs(), symbol_function("quest_info",ME), "sagt: "); 
  AddInfo( ({"feyaria", "mama", "mami", "mutter"}),
    "Mami Feyaria hat mich ganz lieb :)", "sagt: ");
  AddInfo("sehertor", "Ich kenne leider kein Sehertor", "sagt: ");
  AddInfo("seherladen",
    "In Tijara gibt es einen Seherladen. Aber leider ist er nicht immer da.",
    "sagt: ");
  AddInfo( ({"zaubertrank", "zt"}),
    "Ich hab selber leider noch keinen Zaubertrank gefunden. Kannst Du mir "
    "vielleicht einen Zaubertrank verraten?", "sagt: ");
  AddInfo( ({"kaefer", "fleckenkaefer"}),
    "Hmm... ich hab mal so einen Fleckenkaefer in der naehe des Brunnens "
    "gesehen. Lieder weiss ich die Farbe nicht mehr.", "sagt: ");
  AddInfo( ({"elsurion", "kraeuterhaendler"}),
    "Elsurion ist der Kraeuterhaendler von Tijara.", "sagt: ");
  AddInfo( ({"tijara"}),
    "Wir sind hier in Tijara.", "sagt grinsend: ");
  AddInfo( ({lower_case(ORAKEL_NAM)}),
    "Das bin ich!", "sagt strahlend: ");
  AddInfo( ({"pfeife"}),
    "Ich hab leider keine Pfeife, aber einer der Lagerarbeiter hat mal eine "
    "gehabt.", "sagt: ");
  AddInfo( ({"kleid", "kleidchen"}),
    "Gefaellt Dir mein schoenes Kleidchen?", "sagt stolz: ");
  AddInfo( ({"zopf", "zoepfe"}),
    "Mein Zoepfe sind mein groesster Stolz!", "sagt: ");
  AddInfo( ({"bonbon", "bonbons"}),
    "Ich liebe Bonbons! Hast Du vielleicht welche fuer mich?",
    "sagt freudestrahlend: ");
  AddInfo( ({"gouverneur", "vater", "papa", "papi"}),
    "Der Gouverneur ist mein Papa.", "sagt stolz: ");
  AddInfo( ({"eltern"}),
    "Feyaria ist meine Mami und der Gouverneur ist mein Papa.", "sagt stolz: ");
  AddInfo( ({"knuddel", "knuddeln"}),
    "Ich liebe Knuddeln!", "knuddelt Dich und sagt: ");
  AddInfo( ({"ratte", "ratten"}),
    "Ich hasse Ratten!", "sagt: ");
  
  SetChats(3, ({
    "@@chata@@",
    "@@chatb@@",
    "@@chatc@@",
    "@@chatd@@",
    "@@chate@@",
    "@@chatf@@",
    "@@chatg@@",
    "@@chath@@",
    "@@chati@@",
    "@@chatj@@",
    "@@chatk@@",
    CHATS}) );

    RegisterGive( "bonbonbekommen", 
    ({
      ({ "sage Oh, ich liebe Bonbons!!!!", 5 }),
      ({ "iss bonbon", 5 }),
      ({ "emote schaut sehr zufrieden aus.", 1 })
    }) );
  
  add_soul_commands();

}

int bonbonbekommen(object ob)
{
  if( ob->id("bonbon") )
  {
    EPMASTER->GiveExplorationPoint("bonbon", EP_MISC);
    if (TP->QueryProp(P_ALIGN) < 1000)
      TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN) + 10);
    return 1;
  }
  return 0;
}

void reset()
{ 
  object ob; 
  ::reset();
  if(!is_clone(this_object())) return ;
  while(ob=present("bonbon"))
    ob->remove();
  // Quest Infos aktualisieren
  // (koennte ja ne neue Quest angeschlossen worden sein ;) )
  AddInfo(ME->QuestIDs(), symbol_function("quest_info",ME), "sagt: ");
}

mixed _query_noattack()
{
//  domainshout(ORAKEL_NAM+" ruft: Hilfe! "+CAP(TPN)+
//      " will mich verhauen!\n");
//  DB(CAP_TPN+ " greift Feylinchen an!\n");
  return "ruft: Hilfe! "+CAP(TPN)+" will mich verhauen!\n";
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  domainshout(ORAKEL_NAM+" ruft: Hilfe! "+CAP(enemy->name())+
      " will mich verhauen!\n");
  tell_object(enemy,
    ORAKEL_NAM+" ruft: Hilfe! "+CAP(enemy->name())+" will mich verhauen!\n");
  enemy->StopHuntFor(ME);
  StopHuntFor(enemy);
  return 0;
}


int do_frage(string question, string text)
{
  mixed answer;
  string indent;

  if( !member(infos,text) )
  {
    if( this_interactive() && QueryProp(P_LOG_INFO) )
      smart_npc_log(text);
    text = DEFAULT_INFO;
  }

  if ( pointerp(answer=infos[text,0]) )
    answer = answer[random(sizeof(answer))];

  if ( closurep(answer) )
  {
    answer = funcall(answer, text);
    if (!stringp(answer))
      return 1;
  }
  if( text != DEFAULT_INFO )
    answer= tiere[random(sizeof(tiere))]+"! "+answer;
  answer = process_string(answer);

  if( indent=infos[text,1] )
    say( break_string( answer, 78,
	 capitalize(this_object()->name(WER,2))+" "+indent, 1) );
  else
    say( capitalize(this_object()->name(WER,2))+" "+answer );

  return 1;
}

