string Default_Infos()
{
  string str;
  string *kurz;
  string *def_infos;
  kurz=({ "", "Das ist lustig!", "Interessant!", "Wirklich?", "Nein!",
	"Wahnsinn!", "Glaub ich Dir nicht!", "Ist mir ganz neu.",
	"Was Du nicht sagst!", "Wenn Das Mami Feyaria wuesste!",
	"Du bist lustig!", "Das gibts ja nicht!", "Das merk ich mir."});
  def_infos= ({
    "sagt: Hihihi ;-)\n",
    "sagt: Das meinst Du doch nicht ernst!\n",
    "sagt: Das hab ich mich auch schon immer gefragt.\n",
    "sagt: Du kannst aber komische Fragen stellen!\n",
    "staunt: Das ist mir aber ganz neu!\n",
    "sagt: Lass uns das Thema wechseln.\n",
    "sagt: Das ist doch alles Bloedsinn!\n",
    "zuckt mit den Schultern.\n",
    "denkt . o O ( So eine bloede Frage! )\n",
    "fragt: Wie bitte?\n",
    "fragt: Wie meinst Du das ?\n",
    "fragt: Kannst Du das nochmal wiederholen?\n",
    "gruebelt und zuckt dann mit den Schultern.\n",
    "schaut Dich mit grossen Augen an.\n",
    "schaut Dich erstaunt an.\n",
    "seufzt.\n",
    "dreht sich uninteressiert weg.\n",
    "kichert.\n",
    "grinst Dich an.\n",
    "gruebelt.\n",
    "knuddelt Dich.\n",
    "bleibt stumm.\n",
    "sagt: Nein, Nein, NEIN!\n"});

  if( !random(3) )
    str = "sagt: " + tiere[ random( sizeof(tiere) ) ] + "! " +
	   kurz[ random( sizeof(kurz) ) ] + "\n";
  else
    str = def_infos[ random( sizeof(def_infos) ) ];
  return str;
}

void init()
{
  ::init();
  call_out("hallo",0);
}

void hallo()
{
  if( TP && present(TP, MENV) )
  {
    if( TP->QueryProp(P_GHOST) )
      tell_room(MENV, ORAKEL_NAM+" schreit entsetzt: Hilfe! Ein Geist!\n");
    else if( TP->QueryProp(P_FROG) )
      tell_room(MENV, ORAKEL_NAM+" schreit entsetzt: Ihhh! Ein Frosch!\n");
    else if( TP->QueryProp(P_KILLS) )
      tell_room(MENV, ORAKEL_NAM+" schreit entsetzt: Hilfe! Ein Meuchelmoerder!\n");
    else
    {
      if( TPN=="Feyaria") 
        command_me("sag Hallo Mami!");
      else if (TPN=="Aaliyah")
        command_me("sag Hallo Schwesterchen!");
      if( present(TP, MENV) && random(3) )
      {
        command_me("knuddel "+getuid(TP) );
      }
    }
  }
}

void give_notify(object ob)
{
  sequencer::give_notify(ob);
  mnpc::give_notify(ob);
}

