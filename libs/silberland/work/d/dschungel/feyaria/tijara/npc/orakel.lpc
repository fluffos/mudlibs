void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (gruppe=="nett" || gruppe=="intim") call_out("gut",0);
  else if (gruppe=="fies" || gruppe=="frech") call_out("boese",0);
  else if (gruppe=="traurig" || gruppe=="aengstlich" || gruppe=="aergerlich")
    call_out("troesten",0);
  else if (gruppe=="froh" || gruppe=="albern") call_out("lustig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  if( verb=="knuddel" )
    call_out("knuddel_alle",0);
  else StartReaction(verb, gruppe, adverb, touch);
}

void gut()
{
  string *guttext;
  string nam;
  guttext= ({ "Du bist lieb, ", "Ich mag Dich, ", "Dich hab ich gern, ",
              "Du bist wirklich nett, ", "Danke, "});
  if( TPN == "Feyaria" ) nam = "Mami";
  else if( TPN == "Aaliyah" ) nam = "Schwesterchen";
  else nam = TPN;
  tell_room(MENV, ORAKEL_NAM+" sagt: " +
    guttext[random(sizeof(guttext))] + nam + "!\n", ({ TO }) );
}


void boese()
{
  string *boestext;
  boestext=({ "Du bist gemein, ", "Dich mag ich nicht, ", "Lass mich in Ruhe, ",
              "Das merk ich mir, ", "Das sag ich alles meiner Mami, "});
  tell_room(MENV, ORAKEL_NAM+ " sagt: " +
    boestext[random(sizeof(boestext))] + TPN + "!\n", ({TO}) );
}

void knuddel_alle()
{
  command_me("knuddel alle");
}

void lustig()
{
  command_me("sag Du bist aber lustig, "+TPN+"!");
}

void troesten()
{
  command_me("troeste "+getuid(TP) );
}

