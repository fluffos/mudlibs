// /d/dschungel/feyaria/tijara/obj/fragen.c
// Fragen, um an das Sehertor zu kommen
// 1997-03-17  Feyaria@SilberLand

#include "../def.h"
#include "./fragen.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <ansi.h>

#define SDMASTER "/obj/sehertormaster"
#define ANZAHL 7

string *fragen;
mixed *antworten;
int nummer, welche;
int name2int(string str);

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  AddId( ({"\nsehertorfragen"}) );
  AddCmd( "antworte", "antworten");

  fragen=({ FRAGEN });
  antworten= ({ ANTWORTEN });
}

void init()
{
  ::init();
  nummer=0;
//  if( IS_LEARNING(TP) )  printf( "%O\n ", fragen );
  call_out("frage",0);
}

int offset, start, anzahl, richtig;

void frage()
{
  if( !nummer )
  {
    write("Das Buch stellt Dir jetzt einige Fragen. Antworte einfach mit "
          "einem Wort.\n");
    anzahl=sizeof(fragen);
    offset=strlen(TP->query_real_name() );
    start=name2int(TP->query_real_name() ) % anzahl ;
    richtig=0;
  }
  welche=(start+offset*nummer) % anzahl  ;
  write(fragen[welche]+"\n Antwort: ");
  input_to("antworten",0);
}

int antworten(string str)
{
  int i,r;
  string *woerter; 
 
  r=0;
  if( IS_LEARNING(TP) )
    write( "str: "+ str +", welche: "+ welche +", nummer: "+ nummer +".\n");
  woerter= explode( lowerstring(str), " ");
  for(i=0;i<sizeof(antworten[welche]);i++)
  {
    if( member( woerter, antworten[welche][i] )!=-1 )
      r++;
  }
  if( r )
  {
    if( IS_ARCH(TP) ) write("Richtig!\n");
    richtig++;
  }
  else
  {
    if( IS_ARCH(TP) )
      write("Falsch!, Richtig waere : "+ antworten[welche][0]+"\n");
    WLOG( LOG "antworten", "\nFrage: "+ fragen[welche] +"\nAntwort: "+str+"\n");
  }
  if( nummer++ < ANZAHL )
    call_out("frage",0);
  else
    call_out("gefunden",4);
}

string to_str(int zahl)
{
  switch(zahl)
  {
    case 1: return "einer Antwort";
    case 2: return "zwei Antworten";
    case 3: return "drei Antworten";
    case 4: return "vier Antworten";
    case 5: return "fuenf Antworten";
    case 6: return "sechs Antworten";
    case 7: return "sieben Antworten";
    default: return "allen Antworten";
  }
}

void gefunden()
{
  if( richtig>ANZAHL )
  {
    if( SDMASTER->DiscoverDoor("/d/dschungel/feyaria/tijara/room/hinten") )
    {
      write("Das magische Buch verraet Dir ein Sehertor.\n");
      WLOG( LOG "sehertor", "entdeckt das Sehertor in Tijara");
      DB( ANSI_RED+ANSI_BOLD+TPN + " findet das Sehertor in Tijara."+
          ANSI_NORMAL+"\n");
    }
    else
    {
      write("Richtig, aber Du kennst das Sehertor ja schon, komisch....\n");
    }
  }
  else
    write("Hmm, irgendwie scheint das nicht zu klappen, komm doch spaeter "
          "wieder.\n");
    richtig=ANZAHL+1-richtig;
    call_out("ende",2);
}

void ende()
{
  if( richtig )
    write("Du denkst . o O ( Naja, bei "+to_str(richtig)+" war ich mir ja auch "
        "nicht sicher)\n");
  call_out("remove",0); 
}

int name2int(string str)
{
  int i, ret;
  for(i=0;i<strlen(str);i++)
  {
    switch ( str[i..i] )
    {
      case "z": ret+=1;
      case "y": ret+=1;
      case "x": ret+=1;
      case "w": ret+=1;
      case "v": ret+=1;
      case "u": ret+=1;
      case "t": ret+=1;
      case "s": ret+=1;
      case "r": ret+=1;
      case "q": ret+=1;
      case "p": ret+=1;
      case "o": ret+=1;
      case "n": ret+=1;
      case "m": ret+=1;
      case "l": ret+=1;
      case "k": ret+=1;
      case "j": ret+=1;
      case "i": ret+=1;
      case "h": ret+=1;
      case "g": ret+=1;
      case "f": ret+=1;
      case "e": ret+=1;
      case "d": ret+=1;
      case "c": ret+=1;
      case "b": ret+=1;
      case "a": ret+=1;
    }
 //   printf("%d.\n",ret);
  }
  return ret;
}
