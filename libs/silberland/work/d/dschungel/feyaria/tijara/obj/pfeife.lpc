// /d/gebirge/feyaria/weg/obj/pfeife.c
// Eine kleine Pfeife
// 23-12-1996  Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"
#include "/d/dschungel/feyaria/tijara/rattenquest.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Eine kleine Pfeife");
  SetProp (P_LONG, 
    "Mit diesem Pfeifchen kann man lustige Melodien pfeifen.\n");
  SetProp (P_NAME, "Pfeifchen");
  SetProp (P_GENDER, NEUTER);
  AddId ( ({"pfeife", "pfeifchen", "\nrattenpfeife", "rattenpfeife"}) );
  AddAdjective( ({"kleine", "kleines"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 150);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 
    "Das Pfeifchen kannst Du doch nicht so einfach wegwerfen!\n");
  SetProp (P_MATERIAL, MAT_MISC_DECIDUOUS_WOOD);

  AddCmd( ({"pfeife", "pfeif"}), "pfeifen");

}

int pfeifen(string str)
{
  object ob;
  write("Du pfeifst eine lustige Melodie auf Deinem Pfeifchen.\n");
  say(CAP(TPN)+" pfeift eine lustige Melodie auf " +
       TPPP(NEUTER,WEM,SINGULAR)+  " Pfeifchen.\n");
  if( ob=present("\nkellerratte",ENV(TP)) )
    ob->folge(TP);
  if( (TP->QueryQuest(RATTENQUEST) && random(3)) || !random(333) )
  {
    write("Leider hast Du zu laut gepiffen und Dein Pfeifchen zerbricht.\n");
    call_out("remove",1);
  }
  return 1;
}
