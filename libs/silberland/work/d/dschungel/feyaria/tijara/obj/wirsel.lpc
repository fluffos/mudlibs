// /d/dschungel/feyaria/tijara/obj/wirsel.c
// Ein Wirselkraut
// 24-11-96   Feyaria@SilberLand

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Straeusschen Wirselkraut");
  SetProp(P_LONG,
    "Das Wirselkraut ist eines der bekanntesten Heilkraeuter. Man findet "
    "dieses blaugruene Kraut an vielen Plaetzen im SilberLand. Meist wird "
    "es zur Herstellung von Heilsalben verwendet, denn die direkte "
    "Behandlung ist oft problematisch.");
  SetProp(P_NAME, "Wirselkraut");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_FOOD_INFO, ([F_HEAL:80,F_POISON:3,F_SOAK:5]));  // heilt, ist aber giftig
  AddId(({"kraut", "wirselkraut", "\nkraut"}));
}

void BeimEssen()
{
  write("Bah! Das schmeckt ja entsetzlich bitter!\n");
  say(BS(CAP(TPN)+" verzieht das Gesicht, als "+ TPP(WER) +" in ein blaugruenes "+
      "Blaettchen beisst."));
}
