// /d/dschungel/feyaria/tijara/obj/zitteraalherz.c
// Zauberzutat fuer Elsurion
// 24-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Zitteraalherz");
  SetProp(P_LONG, BS( 
    "Dieses Zitteraalherz ist noch voll elektrischer Energie.") );
  SetProp(P_INFO, BS(
    "Zauberer benoetigen diese Zutat zum Zaubern. Vielleicht kann man "
    "bei richtiger Anwendung damit Blindheit heilen."));
  SetProp(P_NAME, "Zitteraalherz");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_ANIMAL );
  SetProp(P_WEIGHT, 90);
  SetProp(P_VALUE, 396);

  AddId( ({"herz", "aalherz", "zitteraalherz", "\nzauberzutat"}) );

  AddCmd( ({"heile", "heil"}), "heilen");
}

int heilen(string str)
{
  notify_fail("Was willst Du heilen?\n");
  if( str!="blindheit" ) return 0;
  write("Du heilst Deine Blindheit.\n");
  TP->SetProp(P_BLIND,0);
  call_out("remove",0);
  return 1;
}

