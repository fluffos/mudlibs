// /d/dschungel/feyaria/tijara/obj/da.c
// Trank zum erkennen des Alignments 
// 1999-08-30 Feyaria@SilberLand

inherit "std/food";

#include "../def.h"
#include <food.h>
#include "/players/feyaria/mudlib/my_npc.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create( ({"trink", "trinke"}) );

  SetProp(P_SHORT, "Ein Erleuchtungstrunk");
  SetProp(P_LONG, 
    "Ein kleines Flaeschen mit einer durchsichtigen Fluessigkeit. Angeblich "
    "kann man bis in die Seele von anderen Personen blicken, wenn man "
    "diesen Erleuchtungstrunk trinkt.") ;
  SetProp(P_NAME, "Erleuchtungstrunk");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, ([MAT_GLASS:20, MAT_MISC_FLUID:80]) );
  SetProp(P_FOOD_INFO, ([
      F_HEAL: 0, F_SOAK: 1,
      F_MSG: "Deine Augen leuchten auf und Du kannst nun in die "
             "Seelen aller Lebewesen blicken.",
      F_MSG_ROOM: " trinkt ein Flaeschen Erleuchtungstrunk und blickt Dir "
                  "nun in Deine Seele.",
      F_VERB: "trinken" ]));
  AddId(({"trunk", "erleuchtungstrunk", "\ndetetct_alignment_potion"}));
}

varargs void BeimEssen(object pl) 
{
  pl->SetProp(P_DETECT_ALIGN, 1);
}

