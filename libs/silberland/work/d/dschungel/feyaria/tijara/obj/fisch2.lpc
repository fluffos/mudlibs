#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine gruene Makrele");
  SetProp(P_NAME, "Makrele");
  SetProp(P_NAME_ADJ, "gruen");
  SetProp(P_LONG, 
      "Die Makrele ist meeresgruen. Sie ist wahrscheinlich zu nix nutze.");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"fisch", "makrele"}) );
  AddAdjective( ({"gruen", "gruene", "gruener", "gruenen"}) );

  SetProp(P_MATERIAL, ({ MAT_ANIMAL }) );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 5);
  SetProp(P_SMELL, "Die Makrele riecht stark nach Fisch.\n");

}

