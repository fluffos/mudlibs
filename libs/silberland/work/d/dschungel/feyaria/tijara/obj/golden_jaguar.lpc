// Der goldene Jaguar
// 2004-05-02   Feyaria@SilberLand

#include "../def.h"
#include <ansi.h>

inherit "std/thing";

void create()
{
  if( is_clone(this_object())) 
  {
    destruct(this_object());
    return;
  }
  ::create();

  SetProp(P_NAME, "Jaguar");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_SHORT, "Der goldene Jaguar");
  SetProp(P_LONG, BS(
    "Der goldene Jaguar ist eine begehrte Trophaee, die vom Gouverneur "
    "von Tijara vergeben wird. Der Besitz dieses Jaguars zeigt, dass Du "
    "in der letzten Woche die meisten Fortschritte im SilberLand gemacht "
    "hast.") + 
    "Folgende Personen wurden bisher mit dem goldenen Jaguar ausgezeichnet:\n" 
    + call_other(ROOM "gouverneur_e4", "write_winners")
    );
  SetProp(P_GENDER, MALE);
  AddId( ({"jaguar", "mipotw-award"}) );
  AddAdjective( ({"golden", "goldenen"}) );
  SetProp(P_INFO, "Auf dem Bauch des Jaguars erkennst Du den Schriftzug: 'MIPotW-Award'.");

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 10000);
  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_MAGIC, 11);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_X_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_X_MAX_HEALTH_MOD, ([P_HP:10, P_SP:10]) );
}

void reset()
{
  object wer;

  ::reset();
  if(objectp(wer = environment()) && interactive(wer) && 
    (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP)) ||
    (wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)) )
  {
    tell_object(wer, "Die Macht " + name(WESSEN,1) + " heilt Dich!\n");
    environment()->heal_self(12 + random(123));
  }
}

void init()
{
  ::init();
  if(objectp(environment()))
    environment()->UpdateAttributes();
}

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY) == "ansi")
    return ANSI_YELLOW+ANSI_BOLD+n+ANSI_NORMAL;
  else if( this_player() && this_player()->QueryProp(P_TTY) == "vt100")
    return ANSI_BOLD+n+ANSI_NORMAL;
  return n;
}

string Name(int casus, int daemon)
{
  return capitalize(name(casus,daemon));
}

string short()
{
  if(this_player() && this_player()->QueryProp(P_TTY) == "ansi")
     return ANSI_YELLOW+ANSI_BOLD+QueryProp(P_SHORT)+ANSI_NORMAL+".\n"; 
  else if(this_player() && this_player()->QueryProp(P_TTY) == "vt100")
     return ANSI_BOLD+QueryProp(P_SHORT)+ANSI_NORMAL+".\n"; 
  return QueryProp(P_SHORT)+".\n";
}
