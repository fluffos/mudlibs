inherit "/std/thing";

#include <properties.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_IDS, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NEVERDROP, 0);
  AddCmd("feuerball", "nixda");
  AddCmd("pfeil", "nixda");
  call_out("darf_wieder", 1+random(3)); 
  }

darf_wieder()
{
  remove();
}

nixda()
{
    remove();
  if (!present("elsurion", environment(this_player()))) {
    return 0;
  }
  write("Elsurions magische Kraefte wehren Deinen Zauber ab.\n");
  return 1;
}
