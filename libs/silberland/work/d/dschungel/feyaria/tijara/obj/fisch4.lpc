#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine gelbe Sardine");
  SetProp(P_NAME, "Sardine");
  SetProp(P_NAME_ADJ, "gelb");
  SetProp(P_LONG,
   "Komisch, aber diese Sardine ist wirklich zitronengelb. Was es alles "
   "gibt...");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"fisch", "sardine"}) );
  AddAdjective( ({"gelb", "gelbe", "gelben", "gelber"}) );

  SetProp(P_MATERIAL, ({ MAT_ANIMAL }) );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 5);
  SetProp(P_SMELL, "Die Sardine riecht leicht ranzig.\n");
}

