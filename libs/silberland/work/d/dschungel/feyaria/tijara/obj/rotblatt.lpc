// /d/dschungel/feyaria/tijara/obj/rotblatt.c
// Ein rotes Blatt
// 24-11-96   Feyaria@SilberLand

inherit "std/food";

#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein rotes Blatt");
  SetProp(P_LONG, 
    "Ein ganz unscheinbares rotes Blatt.");
  SetProp(P_NAME, "Rotblatt");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 15);
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"blatt", "rotblatt", "rotes blatt", "\nkraut"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:1, F_SOAK:1,
      F_MSG: "Das Rotblatt hat fast keinen Geschmack.\n",
      F_MSG_ROOM: " isst ein rotes Blatt.\n" ]));
}

