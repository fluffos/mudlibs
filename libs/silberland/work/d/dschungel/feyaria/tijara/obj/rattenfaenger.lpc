// /d/dschungel/feyaria/tijara/obj/rattenfaenger.c
// Questobjekt fuer Rattenfaenger-Quest
// 1997-03-02 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../rattenquest.h"

int ratten;  // Anzahl der Ratten, die man im Meer versenkt hat. 
int *r;      // Array, welche Ratten man gefunden hat.

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  AddId( RATTENQUESTID );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_AUTOLOADOBJ,1);
  
  ratten = 0;
  r= (int*) ({0,0,0,0,0,0,0,0});

  AddCmd( "check", "check");
  SUID;
}

int quest_fertig()
{
  if( ratten >= 17 && r[0]+r[1]+r[2]+r[3]+r[4]+r[5]+r[6]+r[7] == 8 )
     return 1;
  else
    return 0;
}

int versenke_ratte()
{
  if( getuid(PO)==getuid() )    // == "d.dschungel.feyaria"
  {
    DB("RATTENQUEST: "+TPN+" versenkt Ratte Nr. "+(ratten+1)+"\n");
    DBM("RATTENQUEST: "+TPN+" versenkt Ratte Nr. "+(ratten+1)+"\n");
    WLOG( LOG "rattenquest", " versenkt Ratte Nr. "+(ratten+1));
    return ++ratten;
  }
  return 0;
}

int finde_ratte(int i)
{
  if( getuid(PO)==getuid() )    // == "d.dschungel.feyaria"
  {
    DB("RATTENQUEST: "+TPN+" findet Ratte Nr. "+i+"\n");
    DBM("RATTENQUEST: "+TPN+" findet Ratte Nr. "+i+"\n");
    WLOG( LOG "rattenquest", "findet Ratte Nr. "+i);
    return r[i]=1;
  }
  return 0;
}

int check_ratte(int i)
{
  if( getuid(PO)==getuid() )    // == "d.dschungel.feyaria"
    return !r[i];
  return 0;
}


int check()
{
  if( !IS_LEARNING(TP) || !IS_LORD(TP) ) return 0;
  write("Anzahl der versenkten Ratten: "+ratten+".\n");
  printf("Welche Ratten gefunden: %d, %d, %d, %d, %d, %d, %d, %d.\n",
    r[0],r[1],r[2],r[3],r[4],r[5],r[6],r[7] );
  return 1;
}
