// /d/dschungel/feyaria/schiffe/karavelle.c
// Das Schiff zwischen Midas und Dschungel
// 28-10-96  Feyaria@SilberLand
// 82 Details, 3 Sounds, 1 Smell

#include "../def.h"
#include "/d/wasser/feyaria/schiffe.h"

inherit SCHIFFE "ship";
void no_sturm_details();

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Karavelle" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf dem Hauptdeck der Karavelle. Neben Dir ragt der "
    "Hauptmast mit seinen drei grossen Rahsegeln in schwindelerregende "
    "Hoehen. Etwas weiter vorne befindet sich der Fockmast, der nur zwei "
    "Rahsegel hat, dafuer aber ein Stagsegel, das bis zum Bugspriet reicht. "
    "Der Kreuzmast fuehrt neben zwei Rahsegeln ein grosses Besansegel. "
    "Das Heck ist stufenfoermig erhoeht und bildet eine Trutz, in der die "
    "Kabinen fuer die Offiziere und die Passagiere untergebracht sind. "
    "Am Bug ist unter dem Bugspriet eine Gallionsfigur angebracht.") );
  SetProp( P_SHORT, "Eine Karavelle" );
  SetProp( P_LONG, BS(
    "Diese Karavelle wurde dazu gebaut, um lange Strecken ueber das offene "
    "Meer zurueckzulegen. Mit einer Laenge von fast 20 Metern gehoert sie "
    "schon zu den groesseren Schiffen. An jedem ihrer drei Masten befinden "
    "sich zwei grosse Rahsegel, am Hauptmast sogar noch ein Brahmsegel. "
    "Zusaetzlich hat der Kreuzmast noch ein grosses Besansegel gesetzt. "
    "Zwischen Bugspriet und Fockmast befindet sich noch ein kleines "
    "Stagsegel. Das Heck ist als grosse Trutz ausgefuehrt, um Platz fuer "
    "die Kabinen zu schaffen. Am Bug ist unter dem Bugspriet eine "
    "Gallionsfigur angebracht.") );
  SetProp( P_NAME, "Karavelle" );
  AddId( ({ "karavelle", "schiff" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_KILL_MSG, "TOD den Scriptern!" );
  SetProp(P_KILL_NAME, "Eine Scriptfalle" );
  SetProp(P_ENEMY_DEATH_SEQUENCE, ([ 1:"\nFeyaria teilt Dir mit: "
    "Warum benutzt du auch Untersuche-Scripte :(\n\n" ]) );

  no_sturm_details();
  AddDetail( ({"karavelle", "schiff"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"boden", "hauptdeck", "deck", "oberdeck"}), 
    "Das Hauptdeck befindet sich mittschiffs zwischen Bug und Achtertrutz. "
    "Es besteht aus soliden Holzplanken.");
  AddDetail( ({"planken", "holzplanken"}),
    "Die Planken sind aus solidem Steineichenholz gefertigt.");
  AddDetail( ({"holz", "eichenholz", "steineichenholz"}), 
    "Steineichenholz ist sehr hart und widerstandsfaehig und wird darum "
    "sehr gerne fuer den Schiffbau verwendet.") ;
  AddDetail( ({"schiffbau", "meisterleistung"}),
    "Diese Karavelle ist eine Meisterleistung des silberlaendischen "
    "Schiffbaus.");
  AddDetail( ({"steineiche", "steineichen", "eiche", "eichen", 
               "baum", "baeume" }), 
    "Von den Steineichen siehst Du nur das Holz. Oder hast Du schon mal "
    "einen lebenden Baum auf einem Schiff gesehen?") ;
  AddDetail( ({"mast", "masten"}), 
    "Die Karavelle hat drei Masten. Ganz vorne den Fockmast, in der Mitte "
    "den Haupt- oder Grossmast und achtern den Kreuzmast.");
  AddDetail( ({"mitte"}),
    "In der Mitte des Schiffes steht der Grossmast. Warum nennt man ihn dann "
    "nicht Mittenmast?");
  AddDetail( ({"mittenmast", "seemannsbegriffe", "seemansbegriff"}),
    "Du wirst die Seemannsbegriffe nie verstehen.");  
  AddDetail( ({"hoehe", "hoehen"}),
    "Der Hauptmast erstreckt sich in schwindelerregene Hoehen.");
  AddDetail( ({"hauptmast", "grossmast"}) , 
    "Der Grossmast ist mit ca. 12 Metern Hoehe der groesste Mast. Er ist "
    "mit drei Rahsegeln getakelt. Seitlich sind breite Wanten angebracht, "
    "um bis in den Mastkorb zu kommen.") ;
  AddDetail( ({"meter", "laengenmass"}),
    "Meter ist ein Laengenmass.");  
  AddDetail( ({"fockmast", "fock", "naehe"}), 
    "Der Fockmast befindet in der Naehe des Bugs. Er hat zwei Rahsegel und "
    "ein Stagsegel, das bis zum Bugspriet hinunterreicht.") ;
  AddDetail( "kreuzmast", 
    "Der Kreuzmast ist der achterlichste Mast. Er hat zwei Rahsegel und ein "
    "Besansegel.") ;
  AddDetail( ({"segel", "segeln"}), 
    "Die Karavelle fuehrt verschiedene Segel. Alle Masten sind mit "
    "Rahsegeln getakelt, vorne gibt es noch ein Stagsegel und achtern ein "
    "Besansegel.") ;
  AddDetail( "rahsegel", 
    "Rahsegel sind viereckige Segel, die quer zur Schiffsachse angebracht "
    "sind. Sie sind an einer langen Stange, 'Rah' genannt, befestigt. "
    "Davon stammt auch ihr Name. Grosse Schiffe haben meist mehrere "
    "Rahsegel uebereinander. Das unterste Segel wird meist nach den Mast "
    "benannt, darueber kommt dann das Marssegel und dann das Brahmsegel.");
  AddDetail( ({"schiffsachse", "fahrtrichtung"}), 
    "Die Schiffsachse liegt genau in Fahrtrichtung, ist doch logisch!");
  AddDetail( ({"rah", "rahen"}), 
    "An den Rahen sind die Rahsegel befestigt.") ;
  AddDetail( "hauptsegel", 
    "Das Hauptsegel ist das unterste und groesste Segel auf einem Mast und "
    "traegt meist den Namen des Mastes.") ;
  AddSpecialDetail( ({"name", "namen"}), "namen");
  AddDetail( "marssegel", 
    "Alle drei Masten fuehren ueber dem Hauptsegel noch ein Marssegel.") ;
  AddDetail( "brahmsegel",
    "Nur der Grossmast fuehrt ein Brahmsegel ueber dem Marssegel. Die "
    "anderen beiden Masten sind dazu zu klein.") ;
  AddDetail( "focksegel", 
    "Das Focksegel ist das untere Rahsegel des Fockmastes.") ;
  AddDetail( "fockrah", 
    "An der Fockrah ist das Focksegel befestigt.") ;
  AddDetail( "vormarssegel",
    "Das Vormarssegel ist das zweite Segel des Fockmastes. Es befindet "
    "sich hoeher oben am Mast und ist dementsprechend kleiner.") ;
  AddDetail( "vormarsrah", 
    "An der Vormarsrah ist das Vormarssegel befestigt.");
 AddDetail( ({"vorbrahmsegel", "vorbrahmrah"}), 
    "Der Fockmast ist zu klein, um ein Brahmsegel zu fuehren."); 
  AddDetail( ({"fockmarssegel", "fockmarsrah", "fockbrahmsegel", 
               "fockbrahmrah"}), 
    "Die oberen Segel am Fockmast werden als Vor- -segel bezeichnet.");
  AddDetail( ({"stagsegel", "stagfock"}), 
    "Das dreieckige Stagsegel ist am Fockstag befestigt.");
  AddDetail( ({"fockstag", "stag"}),
    "Vom Top des Fockmastes fuehrt ein Tau bis zum Bugspriet, um den Mast "
    "zu stuetzen. Daran ist das Stagsegel befestigt.") ;
  AddDetail( ({"top", "spitze"}), 
    "Als Top bezeichnet man die Spitze eines Mastes.") ;
  AddDetail( "focktop", 
    "Das ist die Spitze des Fockmastes.") ;
  AddDetail( "grosstop", 
    "Das ist die Spitze des Grossmastes. Dort flattert die Schiffsflagge im "
    "Wind.") ;
  AddDetail( "kreuztop", 
    "Das ist die Spitze des Kreuzmastes. Sie ist niedriger als die der "
    "anderen Masten.") ;
  AddDetail( ({"grosssegel", "grossegel"}), 
    "Das Grossegel ist das unterste Segel des Grossmastes und somit das "
    "groesste Segel der Karavelle.") ;
  AddDetail( "grossrah", 
    "An der Grossrah ist das Grosssegel befestigt. Diese Rah ist breiter "
    "als die Karavelle, um die Segelflaeche noch groesser zu machen.") ;
  AddDetail( "grossmarssegel",
    "Das Grossmarssegel ist das mittlere Segel des Grossmastes. Weiter oben "
    "befindet sich nur mehr das Kraehennest, wie der Ausguck genannt wird, "
    "und darueber das Grossbrahmsegel.") ;
  AddDetail( "grossmarsrah", 
    "An der Grossmarsrah ist das Grossmarssegel befestigt.") ;
  AddDetail( "grossbrahmsegel", 
    "Das Grossbrahmsegel befindet sich ganz oben am Grossmast. Von unten "
    "schaut es ganz klein aus. Oberhalb dieses Segels weht die "
    "Schiffsflagge im Wind.");
  AddDetail( "grossbrahmrah",
    "An der Grossbrahmrah ist das Grossbrahmsegel befestigt. Diese Rah ist "
    "so hoch oben, dass Dir schwindlig wird bei dem Gedanken, dass die "
    "Matrosen dort oben herumturnen muessen, wenn sie die Segel hissen oder "
    "reffen muessen. Dir faellt ein, dass Piraten immer an der hoechsten "
    "Rah aufgehaengt werden, auf diesem Schiff waere das dann dort oben.");
  AddDetail( ({"flagge", "schiffsflagge"}), 
    "Auf der Spitze des Grossmastes flattert die Schiffsflagge im Wind. Sie "
    "zeigt einen gruenen Falken auf weissem Grund.") ;
  AddDetail( ({"falke", "wappentier"}), 
    "Der Falke ist scheinbar das Wappentier von dieser Karavelle.") ;
  AddDetail( "kreuzsegel", 
    "Das Kreuzsegel ist das untere Rahsegel des Kreuzmastes. Es ist nicht "
    "so gross, wie das Focksegel oder gar das Grossegel, weil sich ja "
    "unter dem Kreuzmast der Aufbau der Achtertrutz befindet.");
  AddDetail( "kreuzrah", 
    "An der Kreuzrah ist das Kreuzsegel befestigt.");
  AddDetail( ({"kreuzmarssegel", "gegensatz"}),
    "Das Kreuzmarssegel ist das zweite Segel am Kreuzmast. Ganz im "
    "Gegensatz zu den anderen Masten ist es fast groesser als das "
    "Kreuzsegel.") ;
  AddDetail( "kreuzmarsrah", 
    "An der Kreuzmarsrah ist das Kreuzmarssegel befestigt. ");
  AddDetail( ({"kreuzbrahmsegel", "kreuzbrahmrah"}), 
    "Der Kreuzmast ist zu klein, um ein Brahmsegel zu fuehren.");
  AddDetail( ({"besan", "besansegel"}), 
    "Das Besansegel ist ein rechteckiges Segel, welches laengs der "
    "Schiffsachse angebracht ist, um auch bei seitlichem Wind noch Fahrt "
    "zu machen. Es ist mittels der Besangaffel am Kreuzmast befestigt.") ;
  AddDetail( ({"fahrt"}),
    "Die Karavelle mit ihren vielen Segeln macht gute Fahrt. "
    "Du hoffst, dass Du bald Dein Ziel erreichst.");
  AddDetail( ({"ziel"}),
    "Dein Ziel ist entweder Tijara oder die Pier von Midas.");
  AddDetail( ({"tijara", "pier", "midas"}),
    "Dorthin segelt die Karavelle.");   
  AddDetail( ({"besangaffel", "rundholz"}), 
    "Die Besangaffel ist ein langes Rundholz aehnlich einer Rah, die das "
    "Besansegel traegt. Sie ist in Hoehe der Kreuzmarsrah am Kreuzmast "
    "befestigt.") ;
  AddDetail( "segelflaeche", 
    "Die vielen Segel haben zusammen eine grosse Segelflaeche und so bietet "
    "die Karavelle dem Wind eine grosse Angriffsflaeche, was wiederum zu "
    "einer grossen Geschwindigkeit fuehrt.");
  AddDetail( "geschwindigkeit", 
    "Die Geschindigkeit der Karavelle ist schwer abzuschaetzen, aber sie "
    "kann bei gutem Wind schon sehr schnell werden.");
  AddDetail( ({"bugspriet", "befestigung"}),
    "Der Bugspriet ist eine ueber den Bug nach vorne stehende Stange, die "
    "der Befestigung des Fockmastes dient. Ausserdem gibt er einem Schiff "
    "ein schnittiges Aussehen.");
  AddDetail( ({"aussehen"}),
    "Der lange Bugspriet gibt der Karavelle ein schnittiges Aussehen.");
  AddDetail( "wanten", 
    "Die Wanten sind seitliche Stuetztaue, die den Masten zusaetzliche "
    "Stabilitaet geben. Die Matrosen verwenden die Wanten, um auf die "
    "Masten hinaufzukommen. Fuer eine Landratte ist das aber eine "
    "schwere Kletterei.") ;
  AddDetail( ({"stabilitaet"}),
    "Die Wanten geben den Masten zusaetzliche Stabilitaet.");   
  AddDetail( ({"kletterei"}),
    "Auf einem schwankenden Schiff bis zur Spitze eines Mastes zu klettern "
    "ist sicher nicht so einfach.");
  AddDetail( "landratte", 
    "Als Landratte bezeichnen die Matrosen jemanden, der sich mit Schiffen "
    "nicht so gut auskennt, also zum Beispiel Dich.");
  AddSpecialDetail( ({"beispiel"}), "beispiel");  
  AddDetail( ({"tau", "taue", "stuetztaue", "stange","stangen","seile", "seil"}), 
    "Fuer die ganzen Taue, Seile, Stangen und Segel gibt es doch einen "
    "umfassenden Begriff. Wie hiess das noch mal?") ;
  AddDetail( ({"begriff"}),
    "Wenn Du Dich nur an den Begriff fuer die ganzen Taue, Seile, Stangen "
    "und Segel erinnern koenntest....");
  AddDetail( ({"takelage", "takelung"}), 
    "Die Gesamtheit von Segeln, Stangen und Tauen nennt man Takelage.");
  AddDetail( "gesamtheit", 
    "Na alles zusammen.") ;
  AddDetail( ({"kraehennest", "mastkorb", "ausguck"}), 
    "Im Kraehennest sitzt der Ausguck und sucht den Horizont nach fremden "
    "Schiffen und nach Land ab.") ;
  AddDetail( ({"land", "sicht"}),
    "Kein Land in Sicht, oder doch?");  
  AddDetail( "bug", 
    "Der Bug ist der vordere Teil des Schiffes und laeuft spitz zu, damit "
    "der Wasserwiderstand verringert wird. Noch weiter nach vorne steht der "
    "Bugspriet weg. Unterhalb ist knapp ueberhalb der Wasserlinie eine "
    "Gallionsfigur angebracht."); 
  AddDetail( ({"wasserwiderstand"}),
    "Di Karavelle hat nur wenig Wasserwiderstand, daher ist sie sehr schnell.");  
  AddDetail( ({"teil", "teile"}),
    "Ein Teil des Ganzen.");  
  AddDetail( ({"ganzes", "ganze", "ganzen"}),
    "Das Ganze hat mehrere Teile");
  AddDetail( ({"wasserlinie", "linie"}),
    "Das ist die Linie am Rumpf, an der das Wasser endet.");
  AddDetail( ({"rumpf", "koerper", "unterteil"}), 
    "Der Rumpf ist der Koerper des Schiffes (also der Unterteil ohne "
    "Masten).") ;
  AddDetail( "heck", 
    "Das Heck der Karavelle besteht hauptsaechlich aus der Achtertrutz.");
  AddDetail( "reling", 
    "Die Reling laeuft rund um das ganz Schiff (und kommt doch nie an) und "
    "verhindert, dass zufaellig ein Mann ueber Bord geht.");
  AddDetail( "bord",
    "'Bord' bedeutet sowas wie 'auf dem Schiff'.");
  AddDetail( "mann ueber bord",
    "Du willst schon fast 'MANN UEBER BORD' rufen, aber da gar niemand ins "
    "Wasser gefallen ist, laesst Du es bleiben.");
  AddDetail( "anker", 
    "Irgendwo muss dieses Schiff auch einen Anker haben. Sehen tust Du ihn "
    "aber nicht.") ;
  AddDetail( "steuerbord", 
    "Steuerbord ist die rechte Seite eines Schiffes, wenn man in "
    "Fahrtrichtung blickt."); 
  AddDetail( "backbord", 
    "Backbord ist die linke Seite eines Schiffes, wenn man in Fahrtrichtung "
    "blickt.");
  AddDetail( ({"gallionsfigur", "figur"}), 
    "Die Gallionsfigur stellt eine Meerjungfrau dar und ist aus Holz "
    "geschnitzt.") ;
  AddDetail( ({"meerjungfrau", "jungfrau", "frau"}), 
    "Die Meerjungfrau ist eine barbusige Frau mit einem Fischschwanz.");
  AddDetail( "busen", 
    "Die Gallionsfigur hat einen gewaltigen Busen. Sie ist ja auch oft die "
    "einzige Frau, die die Matrosen fuer lange Zeit zu Gesicht bekommen.");
  AddDetail( ({"zeit"}),
    "Ach wie schnell die Zeit vergeht.");
  AddDetail( "fischschwanz", 
    "Wie es sich fuer eine Meerjungfrau gehoert, hat diese einen schoenen, "
    "grossen Fischschwanz.") ;
  AddDetail( ({"kabinen", "kabine", "platz"}),
    "Du ueberlegst kurz, ob Du nicht Deine Kabine aufsuchen solltest, aber da "
    "es hier an Deck noch so viele Sachen zu bewundern gibt, bleibst Du "
    "lieber hier.") ;
  AddDetail( "sachen", 
    "Sachen, Sachen, findest Du nicht, dass Du das nicht etwas genauer "
    "ausdruecken kannst?"); 
  AddDetail( ({"offiziere", "offizier", "aufsicht"}),
    "Die wenigen Offiziere an Deck haben viel Arbeit mit der Navigation "
    "und der Aufsicht ueber die Matrosen."); 
  AddDetail( ({"navigation", "kurs"}), 
    "Es ist ganz schoen schwierig, ein solches Schiff auf lange Zeit auf "
    "dem richtigen Kurs zu halten.") ;
  AddDetail( "mannschaft", 
    "Die Mannschaft der Karavelle besteht aus einige Offizieren und vielen "
    "Matrosen. Leider sind alle zu beschaeftigt, um sich naeher mit Dir zu "
    "beschaeftigen.");
  AddDetail( ({"matrosen", "matrose", "arbeit"}), 
    "Die Matrosen machen die grobe Arbeit an Deck. Sie bringen die Segel in "
    "die richtige Position und sorgen dafuer, dass alles sauber und in gutem "
    "Zustand ist.");
  AddDetail( ({"zustand"}),
    "Die Karavelle ist in sehr gutem Zustand.");  
  AddDetail( ({"position"}),
    "Wenn die Segel alle in der richtigen Position sind, macht die Karavelle "
    "sehr gute Fahrt.");
  AddDetail( ({"passagiere", "passagier"}), 
    "Du bist ein Passagier.");
  AddDetail( ({"trutz", "achtertrutz", "aufbau"}) , 
    "Achtern befindet sich eine grosse Trutz, ein Aufbau auf dem Oberdeck, "
    "um mehr Platz fuer die Kabinen zu schaffen.") ;
  AddDetail( ({"wind", "brise"}), 
    "Es weht eine steife Brise. Mit solch einem Wind wird die Karavelle "
    "sicher schnell vorankommen.");
  AddDetail( "wellen", 
    "Die Wellen schlagen sanft gegen das Schiff.");
  AddDetail( "meer", 
    "Das Meer ist rund um die Karavelle herum.");
  AddDetail( "hafen", 
    "Wenn die Karavelle im Hafen ist, kannst Du sie wieder verlassen.");
  AddDetail( "kueste", 
    "Wenn irgendwo die Kueste zu sehen ist, wird die Karavelle wohl bald "
    "in einem Hafen anlegen.");
  AddDetail( "horizont", 
    "Bis zum Horizont siehst Du das Meer.");
  AddDetail( ({"ufer", "sichtweite"}),
    "Sobald das Ufer in Sichtweite kommt, ist die Fahrt der Karavelle "
    "bald vorbei."); 
  AddDetail( ({"tijara", "pier"}),
    "Die Karavelle faehrt zwischen Tijara und der Pier hinundher.");
  AddDetail( ({"fockmastes", "mastes", "details", "nominativ", "genetiv", 
               "detail", "grossmastes" }),
      "Untersuche lieber Mast und nicht Mastes, Details sind immer im "
      "Nominativ angegeben, und nicht im Genetiv.");
  AddSpecialDetail( ({"neben",  "am", "mit", "an", "zwischen", "ganz", 
           "nur", "seitlich", "oder", "bugs", "der", 
           "die", "vom", "schiffes", "haupt", "kein"}), "warnung");
  AddSpecialDetail( ({"ssgst", "df", "dzfs", "tfdf", "rsds", "fesem", 
         "edew", "fresee", "ofe", "dsd", "mlo", "izz", "qdrer", "fvds", 
         "tdsew","gdswe", "rewewm", "zfwew", "wsewem", "wmewe", "waq"}),
     "scripter");

  AddSound(DEFAULT_SOUND, 
    "Du hoerst das Aechzen der Masten und das Pfeifen des Windes.");
  AddSound("aechzen", 
    "*aechz* Die Masten aechzen. *aechz*");
  AddSound("pfeifen", 
    "*pfeif* Der Wind pfeift. *pfeif*");

  AddSmell(DEFAULT_SMELL, 
    "Es riecht frisch nach Meerluft.");
  AddSmell( ({"luft", "meeresluft", "meerluft"}), 
    "Die Meeresluft riecht angenehm frisch.") ;

  create_default_ship(12);
  
  AddRoute( PIER_SUED, 60, 5, "an der Pier von Midas",
      ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf");
  AddMsg( "Alle Segel der Karavelle werden gehisst.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Die Karavelle segelt mit gutem Wind nach Sueden.\n", 10 );
  AddFun( "SeeEreignis",10 );
  AddMsg( "Die Karavelle segelt in die tropische Zone.\n", 5);
  AddFun( "heiss", 5);
  AddFun( "hurrikan",5);
  AddFun( "SeeEreignisSued",10 );
  AddMsg( "Der Ausguck ruft: Land in Sicht!\n", 1 );
  AddMsg( "Am Horizont taucht ein Streifen Land auf.\n", 5 );
  AddMsg( "Die Karavelle naehert sich der Kueste.\n", 5 );
  AddMsg( "Zwischen der dichten Vegetation am Ufer kommt ein kleiner "
          "Hafen in Sichtweite.\n", 5 );
  AddMsg( "Alle Segel der Karavelle werden gerefft.\n", 5 );
  AddRoute( TIJARA, 60, 5, "am Hafen von Tijara",
         ({"tijara","dschungel"}), "nach Tijara");
  AddMsg( "Alle Segel der Karavelle werden gehisst.\n", 10 );
  AddFun( "SeeEreignisSued",10 );
  AddMsg( "Die Karavelle segelt mit gutem Wind nach Norden.\n",10 );
  AddFun( "SeeEreignisSued",5) ;
  AddFun( "warm", 5 );
  AddMsg( "Die Karavelle segelt in die gemaessigte Zone.\n", 10 );
  AddFun( "SeeEreignis",10 );
  AddMsg( "Der Ausguck ruft: Land in Sicht!\n", 1 );
  AddMsg( "Am Horizont taucht ein Streifen Land auf.\n", 5 );
  AddMsg( "Die Karavelle naehert sich der Kueste.\n", 5 );
  AddMsg( "Am Ufer kommt ein Hafen in Sichtweite.\n", 5 );
  AddMsg( "Alle Segel der Karavelle werden gerefft.\n", 5 );
 	
  Start();
}

string warnung()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" untersucht < "+ TP->_unparsed_args()+
    " > auf der Karavelle.\n");
 return ("Du verwendest scheinbar ein Untersuche-Script und das hat einige\n"
    "boesartige Daemonen herbeigelockt, die Dich vernichten wollen:\n"
    "Ssgst, Df, Dzfs, Tfdf, Rsds, Fesem, Edew, Fresee, Ofe, Dsd, Mlo, Izz\n"
    "Qdrer, Fvds, Tdsew, Gdswe, Rewewm, Zfwew, Wsewem, Wmewe, Waq\n\n"
    "\n!!! WARNUNG !!! - Das untersuchen dieser Daemonen fuehrt zum Tod!\n");
}

string scripter()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" untersucht < "+ TP->_unparsed_args()+
    " > auf der Karavelle.\n");
  if( TP->QueryProp(P_LEVEL)<=3)
    return "Was untersuchst Du fuer gefaehrliche Sachen!\n";
  TP->do_damage(33, TO);
  return "Wenn Du jetzt stirbst, bist Du selber schuld!\n";
}

void hurrikan()
{
  if( random(13)!=1) return;
  tell_room(TO, "Auf dem Meer tobt ein schrecklicher Hurrikan.\n");
  tell_room(TO, "Die Karavelle wird von ihrem Kurs abgetrieben.\n");
  Halt();
  call_out("sturm",5+random(15));
  AddDetail( ({"himmel", "sonne", "wetter"}),
    "Der Himmel ist von schwarzen Wolken verdeckt, die Sonne ist nicht zu "
    "sehen. Du kannst nur hoffen, das dieses schlechte Wetter bald vorbei "
    "ist.");
  AddDetail( ({"hurrikan", "unwetter", "unwettern"}),
    "Der Hurrikan treibt die Karavelle von ihrem Kurs ab. Aber mit solchen "
    "Unwettern muss man rechnen, wenn man in die tropische Zone segelt.");
  AddDetail( ({"wellen", "welle"}),
    "Die Karavelle schaukelt in den hohen Wellen.");
  AddDetail( ({"winddruck"}),
    "Die Masten aechzen unter dem grossen Winddruck.");
  AddDetail( ({"seegang", "schaukeln", "schraeglage"}),
    "Der hohe Seegang bringt die Karavelle zum Schaukeln. Manchmal bekommt "
    "sie eine gefaehrliche Schraeglage.");
  AddDetail( ({"brise"}),
    "Als Brise kann man diesen Sturm wirklich nicht mehr bezeichnen.");
  AddDetail( ({"wind", "sturm", "sturmwind"}),
    "Der Sturmwind pfeift Dir um die Ohren.");
  AddDetail( ({"regen", "regenschauer", "schauer", "gewitter", "blitz",
               "blitze"}),
    "Die Karavelle ist mitten in einem Gewitter. Die Regenschauer "
    "durchnaessen Dich bis auf die Knochen und manchmal schlaegt auch ein "
    "Blitz gefaehrlich nahe der Karavelle ins Wasser ein.");
  AddDetail( ({"meer", "wasser"}),
    "Das Meer ist durch den Sturm sehr aufgewuehlt.");

}

void no_sturm_details()
{
  AddDetail( ({"himmel", "sonne", "wetter"}),
    "Vom Himmel brennt die Sonne herunter, es weht eine steife Brise; "
    "alles in allem also das ideale Wetter fuers Segeln.");
  AddDetail( ({"wind", "brise"}), 
     "Es weht eine steife Brise. Mit solch einem Wind wird die Karavelle "
     "sicher schnell vorankommen.") ;
   AddDetail( ({"wellen", "welle"}), 
     "Die Wellen schlagen sanft gegen das Schiff.");
   AddDetail( ({"meer", "wasser"}), 
     "Das Meer ist rund um die Karavelle herum."); 
   AddDetail( ({"hurrikan", "unwetter", "unwettern"}),
     "Hoffentlich kommt die Karavelle nicht in einen Hurrikan.");
   AddDetail( ({"regen", "regenschauer", "schauer", "gewitter", "blitz",
               "blitze", "sturm", "sturmwind"}),
     "Ein Hurrikan ist ein starker Sturm und ein Gewitter mit Regen und "
     "Blitzen.");
   AddDetail( ({"seegang", "schaukeln", "schraeglage"}),
     "Der Seegang ist nicht sehr stark, sodass die Karavelle keine "
     "Schraeglage bekommt und auch nicht ins Schaukeln geraet.");
   AddDetail( ({"winddruck"}),
     "Der Winddruck reicht aus, um die Segel kraeftig zu blaehen.");
}

void sturm()
{
  string str;
  if( random(10)==1 )
  {
    tell_room(TO, "Der Sturm flaut ab und die Karavelle nimmt ihren alten "
      "Kurs wieder auf.\n");
    no_sturm_details();
    Start(6);
  }
  else
  {
    switch( random(10) )
    {
      case 0: str="Die Karavelle ist von sehr hohen Wellen umgeben.\n";
              break;
      case 1: str="Eine grosse Welle ueberflutet das ganze Deck.\n";
              break;
      case 2: str="Die Masten aechzen unter dem grossen Winddruck.\n";
              break;
      case 3: str="Der hohe Seegang bringt die Karavelle zum Schaukeln.\n";
              break;
      case 4: str="Ein Blitz schlaegt neben der Karavelle ins Meer ein.\n";
              break;
      case 5: str="Der Sturmwind pfeift Dir um die Ohren.\n";
              break;
      case 6: str="Auf einer besonders hohen Welle kentert die Karavelle "
                  "fast.\n";
              break;
      case 7: str="Die Karavelle bekommt eine gefaehrliche Schraeglage.\n";
              break;
      case 8: str="Ein ploetzlicher Regenschauer durchnaesst Dich bis auf "
                  "die Knochen.\n";
              break;
      case 9: str="Das Grossbrahmsegel wird durch den Wind zerfetzt.\n";
              break;
    }
    tell_room(TO, str);
    call_out("sturm",5+random(15));
  }
}

string beispiel()
{
  return "Ohne Namen nennen zu wollen, "+CAP(getuid(TP))+" ist zum Beispiel "
    "eine Landratte.\n";
}

string namen()
{
  return TP->short();
}
