// /d/dschungel/feyaria/tijara/obj/haare.c
// Zauberzutat fuer Elsurion
// 24-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Bueschel roter Haare");
  SetProp(P_LONG, BS( 
    "Mit solchen Haaren kann man Macht ueber andere Menschen erlangen.") );
  SetProp(P_INFO, BS(
    "Zauberer benoetigen diese Zutat zum Zaubern. Vielleicht kann man "
    "bei richtiger Anwendung Taubheit heilen?"));
  SetProp(P_NAME, "Bueschel roter Haare");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_HAIR );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 40);

  AddId( ({"bueschel", "haare", "rote haare", "\nzauberzutat"}) );

  AddCmd( ({"heile", "heil"}), "heilen");
}

int heilen(string str)
{
  notify_fail("Was willst du heilen?\n");
  if( str!="taubheit" ) return 0;
  write("Du heilst Deine Taubheit.\n");
  TP->SetProp(P_DEAF,0);
  call_out("remove", 0);
  return 1;
}

 
