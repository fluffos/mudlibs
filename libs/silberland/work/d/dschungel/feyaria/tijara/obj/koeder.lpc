// d/dschungel/feyaria/tijara/obj/koeder.c
// Koeder zum Koerdern des Krokodils 
// 1998-10-17 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int verderben;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();
  verderben=0;
  SetProp(P_SHORT, "Ein Koeder");
  SetProp(P_LONG,  
    "Mit diesem Koeder kann man wilde Tiere aus ihrem Versteck "
    "herauslocken. Er wurde aus einem toten Vogelkoerper hergestellt."); 
  SetProp(P_NAME, "Koeder");
  SetProp(P_GENDER, MALE);
  AddId( ({"koeder"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);

  AddCmd( ({"koedere", "koeder"}), "koedern");

}

int koedern(string str)
{
  notify_fail("Was willst Du koedern?\n");
  if( !str ) return 0;
  write( "Du koederst "+str+", aber nichts passiert.\n");
  return 1;
}
