// /d/dschungel/feyaria/tijara/obj/goettertrank.c
// Ein Trank, der goettliche Kraft verleiht
// 1998-10-7  Feyaria@SilberLand

#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <food.h>

void create()
{
  if( !is_clone(this_object())) return;
  ::create( ({"trink","trinke"}) );

  SetProp(P_SHORT, "Ein goettlicher Trank");
  SetProp(P_LONG,
    "Dieser goettliche Trank verleiht goettliche Kraefte.");
  SetProp(P_NAME, "Goettertrank");
  SetProp(P_GENDER, MALE);
  AddId( ({"trank", "\ngoettleicher_trank"}) );
  AddAdjective( ({"goettlicher", "goettlichen"}) );
  SetProp(P_INFO, "Dieses goettliche Trank verleiht dir goettliche Kraefte.\n");
  
  SetProp(P_MATERIAL, ([MAT_HEAL:40, MAT_GLASS:30, MAT_MISC_WOOD:10, 
                        MAT_DUST:10, MAT_ALCOHOL:10]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10000);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 
    "Trink den goettlichen Trank doch, statt ihn zu verkaufen.\n");
  SetProp (P_FOOD_INFO, ([
      F_HEAL     : ({10,5}), 
      F_DRINK:2, F_ALCOHOL:1, F_POISON:0,  
      F_MSG      : "Du trinkst den goettlichen Trank aus...\n"
                   "...und bist ploetzlich so stark wie ein Gott.",
      F_MSG_ROOM : "trinkt einen goettlichen Trank aus "
                   "und ist ploetzlich so stark wie ein Gott!",
      F_VERB     : "trinken" ]) );
}

BeimEssen()
{
  TP->ModifySkillAttribute(TP, SA_QUALITY, 200+random(150), 4+random(7));
}

