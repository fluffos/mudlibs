// Zauberzutat fuer Elsurion
// 24-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Ranke Giftefeu");
  SetProp(P_LONG, 
    "An dieser Ranke des Giftefeus kann man sich vergiften.");
  SetProp(P_INFO, 
    "Zauberer benoetigen diese Zutat zum Zaubern. Vielleicht kann man sich "
    "bei richtiger Anwendung damit entgiften.");
  SetProp(P_NAME, "Giftefeu");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 165);

  AddId( ({"ranke", "efeu", "giftefeu", "\nzauberzutat"}) );

  AddCmd( "entgifte", "entgiften");
}

int entgiften()
{
  write("Du entgiftest Dich.\n");
  TP->AddPoison(-5 - random(3));
  call_out("remove", 0);
  return 1;
}
