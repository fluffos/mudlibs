#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein roter Hering");
  SetProp(P_NAME, "Hering");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_LONG, 
      "Der rote Hering ist definitiv tot. Ausserdem macht er einen ungesunden, "
      "weil leicht verfaulten Eindruck.");
  SetProp(P_GENDER, MALE);
  AddId( ({"fisch", "hering", "hering", "hering"}) );
  AddAdjective( ({"rot", "roten", "rotem", "roter"}) );

  SetProp(P_MATERIAL, ({ MAT_ANIMAL }) );
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 5);
  SetProp(P_SMELL, "Der Hering stinkt nach verfaultem Fisch.\n");

}

