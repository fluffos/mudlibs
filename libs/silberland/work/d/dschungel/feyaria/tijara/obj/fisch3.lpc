#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein blauer Schwertfisch");
  SetProp(P_NAME, "Schwertfisch");
  SetProp(P_NAME_ADJ, "blau");
  SetProp(P_LONG, 
   "Der Schwertfisch ist azurblau und wunderschoen. Schade dass er schon "
   "so vergammelt ist, dass man ihn nicht essen kann.");
  SetProp(P_GENDER, MALE);
  AddId( ({"fisch", "schwertfisch"}) );
  AddAdjective( ({"blau", "blauer", "blaue", "blauen"}) );

  SetProp(P_MATERIAL, ({ MAT_ANIMAL }) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 5);
  SetProp(P_SMELL, "Der Schwertfisch stinkt unangenehm vergammelt.\n");
}

