// /d/dschungel/feyaria/tijara/obj/kiste.c
// Eine Kiste, die der Lastentraeger schleppt
// 26-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine schwere Kiste");
  SetProp(P_LONG, BS( 
    "Was in dieser schweren Kiste wohl drinnen sein wird?") );
  SetProp(P_NAME, "Kiste");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 45000);
  SetProp(P_VALUE, 0);

  AddId( ({"kiste"}) );
}

_query_noget()
{
  if(TP && TP->id("lastentraeger") ) return 0;
  return "Die Kiste ist doch viel zu schwer fuer Dich!\n";
}
