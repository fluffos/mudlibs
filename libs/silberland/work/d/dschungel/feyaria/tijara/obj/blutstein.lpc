// /d/dschungel/feyaria/tijara/obj/blutstein.c
// Zauberzutat fuer Elsurion
// 24-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Blutstein");
  SetProp(P_LONG, BS( 
    "Dieser Blutstein ist voll mit feuriger Energie.") );
  SetProp(P_INFO, BS(
    "Zauberer benoetigen diese Zutat zum Zaubern. Ob man mit ihm einen "
    "Feuerzauber beschwoeren kann?"));
  SetProp(P_NAME, "Blutstein");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_STONE );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 250);

  AddId( ({"stein", "blutstein", "\nzauberzutat"}) );

  AddCmd( ({"beschwoere", "beschwoer"}), "beschwoeren");
}

int beschwoeren(string str)
{
  notify_fail("Was willst Du beschwoeren?\n");
  if( str!="feuerzauber" ) return 0;
  write("Du beschwoerst eine riesige Feuerkugel.\n");
  say( CAP(TPN)+ " beschwoert eine riesige Feuerkugel herauf.\n");
  call_out("feuer", 2);
  return 1;
}

void feuer()
{
  tell_room(ENV(TP), "Die Feuerkugel zerplatzt, ohne Schaden anzurichten.\n");
  call_out("remove", 0);
}

