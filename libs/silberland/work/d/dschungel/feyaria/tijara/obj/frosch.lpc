// /d/dschungel/feyaria/tijara/obj/frosch.c
// Zauberzutat fuer Elsurion
// 24-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Froschschenkel");
  SetProp(P_LONG, BS( 
    "Der Schenkel eines kleinen, gruenen Frosches.") );
  SetProp(P_INFO, BS(
    "Zauberer benoetigen diese Zutat zum Zaubern. Vielleicht kann man "
    "sich bei richtiger Anwendung auch entfroschen ?"));
  SetProp(P_NAME, "Froschschenkel");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_ANIMAL );
  SetProp(P_WEIGHT, 90);
  SetProp(P_VALUE, 75);

  AddId( ({"schenkel", "froschschenkel", "\nzauberzutat"}) );

  AddCmd( "entfrosche", "entfroschen");
}

int entfroschen()
{
  write("Du entfroscht Dich.\n");
  TP->SetProp(P_FROG,0);
  call_out("remove",0);
  return 1;
}