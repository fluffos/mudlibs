// /d/dschungel/feyaria/tijara/obj/fischerboot.c
// Ein kleines Fischerboot in Tijara
// 27-11-96  Feyaria@SilberLand
// 

inherit "/d/wasser/feyaria/schiffe/ship";

#include "../def.h"
#include <properties.h>
#include <language.h>

object *beim_angeln;

create()
{
  ::create();

  beim_angeln = ({TO});
  SetProp( P_INT_SHORT, "Auf einem kleinen Fischerboot" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf einem kleinem Fischerboot. Es ist vielleicht vier Meter "
    "lang und hat ein kleines Segel. Am Boden liegen viele Fischernetze "
    "herum. Der Geruch nach Fisch ist kaum auszuhalten.") );
  SetProp( P_SHORT, "Ein kleines Fischerboot" );
  SetProp( P_LONG, BS(
    "Du siehst ein kleines Fischerboot. Es ist etwa vier Meter lang und hat "
    "ein kleines Segel.") );
  SetProp( P_NAME, "Fischerboot" );
  AddId( ({ "fischerboot", "boot" }) );
  SetProp( P_GENDER, NEUTER );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_OTHER]) );
  
  AddDetail( ({"boot", "fischerboot"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"segel"}),
    "Das Fischerboot hat ein kleines Segel. Das genuegt fuer so ein kleines "
    "Boot.");
  AddDetail( ({"boden", "deck"}),
    "Auf dem Deck liegen viele Fischernetze.");
  AddDetail( ({"himmel"}),
    "Der Himmel ist ueber Dir.");  
  AddDetail( ({"netz", "netze", "fischernetz", "fischernetze"}),
    "Die Netze sind sicher zum Fischefangen gedacht.");
  AddDetail( ({"fisch", "fische", "fang"}),
    "Noch hat der Fischer keine Fische gefangen.");
  AddSmell( ({DEFAULT_SMELL, "fisch", "fische", "geruch"}),
    "Es riecht stark nach Fisch, aber das ist auf einem Fischerboot ja auch "
    "nicht verwunderlich.");
  AddDetail( ({"meer", "wasser", "hafen", "kueste"}),
    "Das ist ausserhalb des Fischerbootes.");
  AddDetail( ({"fischer"}),
    "Der Fischer sitzt im Heck des Bootes und beachtet Dich nicht.");
  AddDetail( ({"heck", "bug"}),
    "Der Fischer sitzt im Heck des Bootes und die Mitfahrer im Bug.");

  SetProp( P_DEPARTMSG, ({
    "Das Fischerboot legt ab.\n", 
    "Das Fischerboot segelt davon.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Das Fischerboot legt @@QueryArrived@@ an.\n",
    "Das Fischerboot legt am Hafen an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "geht an Bord des Fischerbootes",
    "kommt auf das Fischerboot"}) );
  SetProp( P_ENTERFAIL, "Ausser dem Fischer haben nur 2 Personen auf dem "
    "Fischerboot Platz." );
  SetProp( P_MAX_PASSENGERS, 2 );

  SetProp( P_LEAVEMSG, ({
    "verlaesst das Fischerboot",
    "klettert aus dem Fischerboot"}) );
  SetProp( P_LEAVEFAIL, ({
    "Das Fischerboot befindet sich doch auf hoher See",
    "wollte das Fischerboot auf hoher See verlassen"}) );

  AddCmd( ({ "angle", "angel" }), "angeln");

  AddRoute( ROOM "steg_d1", 30, 5, "am Hafen von Tijara" );
  AddMsg( "Das Fischerboot segelt aus dem Hafen.\n", 10 );
  AddMsg( "Das Fischerboot segelt ein Stueck die Kueste entlang.\n", 10 );
  AddFun( "SeeEreignisSued", 10);
  AddFun( "SeeEreignis", 10);
  AddFun( "SeeEreignisSued", 10);
  AddMsg( "Das Fischerboot erreicht ein guenstiges Fanggebiet.\n", 10 );
  AddMsg( "Der Fischer wirft seine Netze aus.\n", 0 );
  AddFun( "netzraus", 20);
  AddFun( "SeeEreignis", 20);
  AddFun( "SeeEreignisSued", 20);
  AddMsg( "Der Fischer holt seine Netze ein und begutachtet seinen grossen "
    "Fang.\n", 0 );
  AddFun( "netzrein", 10);
  AddMsg( "Das Fischerboot segelt wieder zurueck.\n", 10 );
  AddFun( "SeeEreignisSued", 10);
  AddFun( "SeeEreignis", 10);
  AddFun( "SeeEreignisSued", 10);
  AddMsg( "Der Hafen von Tijara kommt in Sichtweite.\n", 5 );
  AddFun( "hafen", 0);

  Start();
}

netzraus()
{
  RemoveDetail( ({"netz", "netze", "fischernetz", "fischernetze"}) );
  AddDetail( ({"netz", "netze", "fischernetz", "fischernetze"}),
    "Die Netze sind gerade zum Fischefangen ausgeworfen.");
}

netzrein()
{
  RemoveDetail( ({"netz", "netze", "fischernetz", "fischernetze"}) );
  AddDetail( ({"netz", "netze", "fischernetz", "fischernetze"}),
    "Die Netze sind sicher zum Fischefangen gedacht.");
  RemoveDetail( ({"fisch", "fische", "fang"}) );
  AddDetail( ({"fisch", "fische", "fang"}),
    "Ein ganzer Haufen frisch gefischter Fische liegt im Boot.");
}

hafen()
{
  call_out("fische_verkaufen",10);
}

fische_verkaufen()
{
  tell_room(TO, "Der Fischer packt die gefangen Fische ein und verkauft sie "
    "am Fischmarkt.\n");
  RemoveDetail( ({"fisch", "fische", "fang"}) );
  AddDetail( ({"fisch", "fische", "fang"}),
    "Noch hat der Fischer keine Fische gefangen.");
}

int angeln(string str)
{
  if( ENV(TP)!=TO ) return 0; 
  if(!present("angel", TP))
  {
    notify_fail(BS("Aber Du hast ja gar nix zum Angeln dabei! Besorg Dir erst "
      "einmal eine Angel."));
    return 0;
  }

  if(str != "im meer" && str != "in meer")
  {
    notify_fail("Wo willst Du angeln?\n");
    return 0;
  }

  if( member(beim_angeln, TP) > -1 )
  {
    notify_fail("Aber Du angelst doch schon!\n");
    return 0;
  }  

  write("Du wirfst die Angel in hohem Bogen aus.\n");
  say (TP->Name()+" wirft "+TPPP(FEMALE,WEN)+" Angel in hohem Bogen aus.\n");
  beim_angeln += ({TP});
  call_out("angeln2", 5 + random (5));  
  return 1;
}

void angeln2()
{
  if(!present(TP)) 
  {
    beim_angeln -= ({TP});
    return;
  }
  tell_object(TP, "Geduldig wartest Du, dass endlich ein Fisch anbeisst.\n");
  call_out("fangen", 5+random(10));
}

void fangen()
{
  if(!present(TP)) 
  {
    beim_angeln -= ({TP});
    return;
  }

  if(!random(4)) 
  {
    tell_object(TP, BS(
      "Du hast leider keinen Fisch gefangen und holst die Angel wieder ein."));
    tell_room(TO, TP->Name()+" holt eine leere Angel ein.\n", ({TP}) );
  }
  else
  {
    tell_object(TP, BS(
      "Ploetzlich spuerst Du, wie es an der Angel zuckt. Es hat doch "
      "tatsaechlich ein Fisch angebissen, den Du sofort an Bord wirfst."));
    tell_room(TO, TP->Name()+" faengt einen Fisch.\n", ({TP}) );
    clone_object(OBJ "fisch"+ (string) (random(4)+1))->move(TO);
  }
    beim_angeln -= ({TP});
}


