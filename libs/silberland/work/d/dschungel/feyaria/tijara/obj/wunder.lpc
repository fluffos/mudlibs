// /d/dschungel/feyaria/tijara/obj/wunder.c
// Ein Wunderkraut
// 24-11-96   Feyaria@SilberLand

#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <food.h>

nosave int welk;
nosave object owner;

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  welk=0;
  SetProp(P_NAME, "Wunderkraut");
  SetProp(P_SHORT, "Ein Wunderkraut");
  SetProp(P_LONG,
    "Dieses Wunderkraut hat gewiss heilende Kraefte. Aber es wird sicher "
    "nicht ewig halten. Sicher ist es bald verwelkt, wenn Du es nicht bald "
    "benutzt.");
  SetProp(P_INFO, "Dieses Wunderkraut kann dich vollstaendig heilen.\n");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10000);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Iss das Wunderkraut doch, anstatt es zu verkaufen.\n");
  SetProp(P_FOOD_INFO,
      ([ F_HEAL: 50+random(4)*10,
         F_SOAK: 11,
         F_MSG: "Du isst das Wunderkraut und fuehlst Dich wie neugeboren.\n",
         F_MSG_ROOM: "isst das Wunderkraut und sieht ploetzlich topfit aus.\n"
      ]) );
  AddId( ({"wunderkraut", "kraut", "\nwunderkraut", "\nkraut"}) );
}

void BeimEssen(object pl)
{
  switch(welk)
  {
    case 0:
    case 1:  
    case 2: pl->AddPoison(-10);
    case 3: pl->SetProp(P_BLIND, 0); 
    case 4: pl->SetProp(P_DEAF, 0);
    case 5: pl->SetProp(P_FROG, 0);
    case 6: pl->heal_self(250);
    case 7: pl->SetProp(P_ALCOHOL, pl->QueryProp(P_ALCOHOL)/2 );
    case 8: pl->SetProp(P_DRINK, pl->QueryProp(P_DRINK)/2 );
    case 9: pl->SetProp(P_FOOD, pl->QueryProp(P_FOOD)/2 );
  }
}

void reset()
{
  ::reset();
  if( welk && owner && interactive(owner) )     // Netztote ausnehmen
    if( ++welk > 10 )
    {
      object ob;
      ob=this_object();
      while ((ob=environment(ob)) && !interactive(ob)) ;
      if (ob && interactive(ob))
        tell_object(ob, "Dein Wunderkraut verwelkt.\n");
      else {
        if (environment(this_object()) &&
            (environment(this_object())->id("Raum") ||
             environment(this_object())->id("Transporter")))
          tell_room(environment(this_object()), "Das Wunderkraut verwelkt.\n");
      }
      remove();
    }
}

varargs int move(mixed dest, int method)
{
  if( !welk && objectp(dest) && query_once_interactive(dest) )
  {
    welk = 1;
    owner = dest;
    write_file( LOG "wunderkraut", sprintf(
        "%s %s Wunderkraut von %s.\n",
        dtime(time()),getuid(dest),
        MENV?(MENV->name()?MENV->name(WEM):file_name(MENV)):getuid(PO)));
  }
  return ::move(dest, method);
}

