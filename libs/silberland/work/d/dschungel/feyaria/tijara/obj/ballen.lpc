// /d/dschungel/feyaria/tijara/obj/ballen.c
// Ein Ballen, den der Lastentraeger schleppt
// 26-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein schwerer Ballen");
  SetProp(P_LONG, BS( 
    "Was in diesem schweren Ballen wohl drinnen sein wird?") );
  SetProp(P_NAME, "Ballen");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 45000);
  SetProp(P_VALUE, 0);

  AddId( ({"ballen"}) );
}

_query_noget()
{
  if(TP && TP->id("lastentraeger") ) return 0;
  return "Der Ballen ist doch viel zu schwer fuer Dich!\n";
}
