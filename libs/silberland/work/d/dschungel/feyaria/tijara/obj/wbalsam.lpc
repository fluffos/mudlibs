// /d/dschungel/feyaria/tijara/obj/wbalsam.c
// Waffenbalsam um eine Waffe geringfuegig zu verbessern
// 1998-08-03 Feyaria@SilberLand

#include "../def.h"

inherit "/std/thing";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Flaeschchen mit Waffenbalsam");
  SetProp(P_LONG, BS(
    "In einem kleinen Flaeschchen mit der Aufschrift 'WB' befindet sich eine "
    "dunkelgraue, zaehe Paste. Mit diesem Waffenbalsam kann man seine Waffe "
    "einschmieren. Dann wird sie haerter und macht etwas mehr Schaden.") );
  SetProp(P_NAME, "Waffenbalsam" );
  SetProp(P_GENDER, MALE);
  AddId( ({"balsam", "waffenbalsam", "flaeschchen"}) );
  SetProp(P_INFO, BS(
    "Leider kannst Du nicht erkennen, welche genauen Auswirkungen dieser "
    "Waffenbalsam haben wird. Nur ein Alchemist koennte das vielleicht "
    "genau wissen. Auf jeden Fall bist Du Dir aber sicher, dass er nur von "
    "Vorteil fuer Deine Waffen sein kann.") );

  SetProp(P_MATERIAL, ([MAT_GLASS:40, MAT_MISC_MAGIC:60]) );
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 10);
  AddCmd( ({"balsamiere", "balsamier", "schmiere", "schmier"}), "schmieren");  
}

int schmieren(string str)
{
  string waffe, newdam, s;
  object w;
  int i,maxwc;
  int wc,dam,qd,weight;
  int fix;
  mixed dam_type;

  notify_fail("Welche Waffe willst Du mit dem Waffenbalsam einschmieren?\n");
  if( !str ) return 0;
  if( sscanf( str, "%s mit waffenbalsam ein", waffe)!=1 ) return 0;
  if( !w=present( waffe, TP) )
    return notify_fail("Du hast doch gar kein '"+CAP(str)+"'!\n"),0;
  if( !w->QueryProp(P_WEAPON_TYPE) )
    return notify_fail(w->Name(WER,1)+" ist gar keine Waffe!\n"),0;
  dam=w->QueryProp(P_DAMAGED);
  if( w->QueryProp("waffenbalsam")>=10 && dam < 10)
    return notify_fail("Auf "+ w->name(WEN,1)+" wuerde der Waffenbalsam keine "
        "Wirkung haben!\n"),0;
  write("Du schmierst "+w->name(WEN,1)+" mit dem Waffenbalsam ein.\n");  
  say(CAP_TPN+" behandelt "+w->name(WEN,1)+" mit Waffenbalsam.\n");
  fix=w->QueryProp(P_WC_FIX);
  qd=w->QueryProp(P_QUALITY_DECAY);
  weight=w->QueryProp(P_WEIGHT);

  if( dam ) // repariert
  {
    i=dam*random(100)/100+1;
    w->Damage(-i);
    if( i != 0 )
      write("Einige Scharten von "+w->name(WEM,1)+" verschwinden.\n");
  }
  if( w->QueryProp("waffenbalsam")<10 )
  {
    if( random(100) > 25 && qd>0 && qd<500) // erhoeht QUALITY_DECAY
    {
      w->SetProp(P_QUALITY_DECAY, qd+random(20) );
      write(w->Name(WER,1)+" schaut nun viel stabiler aus.\n");
    }
    if( random(100) > 50 ) // erhoeht WC
    {
      wc=w->QueryProp(P_WC);
      dam=w->QueryProp(P_DAMAGED);
      maxwc=MAX_WEAPON_CLASS-(w->QueryProp(P_NR_HANDS)==1?MAX_WEAPON_CLASS/3:0); 
      w->SetProp(P_WC,wc+(maxwc-wc-dam)/7);
      if( wc!=w->QueryProp(P_WC) )
        write(w->Name(WER,1)+" sieht gleich viel gefaehrlicher aus.\n");
    }
    if( random(100) > 40 ) // reduziert WEIGHT
    {
      w->Set(P_WEIGHT, (90+random(10))*weight/100 );
      if( weight!= w->QueryProp(P_WEIGHT) )
        write(w->Name(WER,1)+ " scheint leichter geworden zu sein.\n");
    }
    if( random(100) > 70 && fix < (90 - w->QueryProp(P_NR_HANDS) * 20)) // erhoeht WC_FIXFACTOR
    {
      w->SetProp(P_WC_FIX, fix+2+random(5) );
      write(w->Name(WER,1)+" liegt nun etwas besser in Deiner Hand.\n");
    }
    if( random(100) > 95) // setzt zusaetzlichen Schadenstyp
    {
      if( stringp(dam_type=w->QueryProp(P_DAM_TYPE)) )
        dam_type=({dam_type});
      dam = 1;
      for( i=sizeof(dam_type)-1; i>=0; i--)
      {
        if( member( m_indices(MAGICAL_DAMAGE_TYPES), dam_type[i]) != -1 )
          dam = 0;
      }
      switch( random(13) )
      {
        case 0: newdam=DT_COLD; s="weissem"; break;
        case 1: newdam=DT_FIRE; s="rotem"; break;
        case 2: newdam=DT_POISON; s="gruenem"; break;
        case 3: newdam=DT_ACID; s="schwarzem"; break;
        case 4: newdam=DT_LIGHTNING; s="orangenem"; break;
        case 5: newdam=DT_LIGHT; s="gelbem"; break;
        case 6: newdam=DT_MAGIC; s="regenbogenfarbenem"; break;
        case 7: newdam=DT_HOLY; s="hellem"; break;
        case 8: newdam=DT_UNHOLY; s="dunklem"; break;
        case 9: newdam=DT_WATER; s="blauem"; break;
        case 10: newdam=DT_AIR; s="braunem"; break;
        case 11: newdam=DT_SOUND; s="violettem"; break;
        case 12: newdam=DT_TERROR; s="grauem"; break;
      }
      if( dam )
      {
        w->SetProp(P_DAM_TYPE, dam_type+({newdam}) );
        write(w->Name(WER,1)+ " leuchtet kurz in "+s+" Licht auf.\n");
      }
    }
    // Lebens und Magiepunkte
    if( random(100) > 85 && !mappingp(w->QueryProp(P_M_HEALTH_MOD)) )     
    {
      w->SetProp(P_M_HEALTH_MOD, ([P_HP:1+random(5), P_SP:1+random(5)]) );
      write(BS( "Lebens- und Magiegeister werden in "+w->name(WEM,1)+ 
            " gefangen."));
      if(objectp(w->QueryProp(P_WIELDED)))
        w->QueryProp(P_WIELDED)->UpdateAttributes();
    }
    w->SetProp(P_VALUE, w->QueryProp(P_VALUE)+50+random(100));
  }
  w->SetProp("waffenbalsam", (intp(w->QueryProp("waffenbalsam"))?
      w->QueryProp("waffenbalsam")+1:1) );
  remove();
  return 1;
}

void reset()
{
  object env;
  ::reset();
  if( !is_clone(this_object()) ) return;
  if (!random(10) && (env = environment()) && !env->Id("NPC") )
  {
    while(!query_once_interactive(env) && environment(env))
      env=environment(env);
    tell_object(env, "Dein Waffenbalsam loest sich in Luft auf.\n");
    remove();
  }
}

