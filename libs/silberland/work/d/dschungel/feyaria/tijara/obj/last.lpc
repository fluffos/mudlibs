// /d/dschungel/feyaria/tijara/obj/last.c
// Eine Last, die der Lastentraeger schleppt
// 26-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine schwere Last");
  SetProp(P_LONG, BS( 
    "Was in dieser schweren Last wohl drinnen sein wird?") );
  SetProp(P_NAME, "Last");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 45000);
  SetProp(P_VALUE, 0);

  AddId( ({"last"}) );
}

query_noget()
{
  if(TP && TP->id("lastentraeger") ) return 0;
  return "Die Last ist doch viel zu schwer fuer Dich!\n";
}
