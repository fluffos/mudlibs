	"steg_d1":5;1,
	"hafen_d2":5;2,
        "gouverneuer_e4":6;4,
        "hotel_c6":4;6,
	"jaeger_b4":3;4,
	"kneipe_e2":6;2,
	"kraeuter_b6":3;6,
	"laden_c3":4;3,
	"lagerhalle_b3":3;3,
	"platz_c5":4;5,
	"platz_d4":5;4,
	"platz_d5":5;5,
	"platz_d6":5;6,
	"platz_e5":6;5,
	"post_e6":6;6,
	"sammler_c7":4;7,
	"tor_a2":2;2,
	"tor_d7":5;7,
	"tor_f2":7;2,
	"wache_e7":6;7,
	"waffen_c4":4;4,
	"weg_a3":2;3,
	"weg_a4":2;4,
	"weg_a5":2;5,
	"weg_b2":3;2,
	"weg_b5":3;5,
	"weg_c2":4;2,
	"weg_d3":5;3,
	"weg_e3":6;3,
	"wohn_f3":7;3,
	"wohn_f4":7;4,
	"wohn_f5":7;5,
	   ]);
}

mapping getcolors() {
  return ([
//	   0x66:ANSI_YELLOW, // Post
//	   0x62:ANSI_CYAN,   // Kneipe
//	   0x46:ANSI_CYAN,   // Hotel 
//	   0x43:ANSI_GREEN,  // Laden
//	   0x36:ANSI_GREEN,  // Kraeuterladen
//         0x44:ANSI_GREEN,  // Waffenladen
	   ]);
}

mapping gethilite() {
  return ([
	   ]);
}

string *getmap() {
  return ({
"                              *** TIJARA ***                         ",
"                                                                     ",
"                                     o                               ",
"                                     |                               ",
"     (Kueste)<--o------o------o------o----Kneipe  o-->(Kueste)       ",
"                |      |      |      |   \\      /                   ",
"                o     LH     Laden   o    --o------o                 ",
"                |                    |             |                 ",
"                o------o      Waffen-o------G      o                 ",
"                |             |   /  |  \\          |                ",
"                o------o------o------o------o------o                 ",
"                       |      |  \\   |  /                           ",
"                      Kraut  Hotel   o----Post                       ",
"                                     |                               ",
"                              o------o------W                        ",
"                                     |                               ",
"                                     v                               ",
"                               (Dschungel)                           ",
"                                                                     ",
"                                                                     ",
""});
}


string long() {
  string *map,fn,term;
  mapping pos,cols;
  int x,x2,y,i,j;
  
  map=getmap()[0..];
  if (!TP) return implode(map,"\n");

  term=TP->QueryProp(P_TTY);
/*  switch(term) {
    case "ansi":  cols=getcolors(); break;
    case "vt100": cols=gethilite(); break;
    default:;
  }
*/
  // Position des Spielers eintragen
  if (environment(TP)) {
    pos=getpos();
    fn=file_name(environment(TP));
    if (fn[0..32]=="/d/dschungel/feyaria/tijara/room/") fn=fn[33..];
    x=pos[fn,0];y=pos[fn,1];
    if (x||y) {
      if (mappingp(cols)) {
	switch(term) {
	  case "ansi":  cols[16*x+y]=ANSI_RED+ANSI_BOLD; break;
	  case "vt100": cols[16*x+y]=ANSI_BOLD; break;
	  default:;
	}
      }
      x*=7;if (x>60) x=70;
      y*=2;if (y>20) y=20;
      if (map[y][x+1]!='-') map[y][x+1]=' ';
      if (map[y][x+7]!='-' && map[y][x+7]!='G') map[y][x+7]=' ';
      map[y]=map[y][0..(x+1)]+"HIER!"+map[y][(x+7)..];
    }
  }

#define IS_LETTER(x) (((x&223)>=65) && ((x&223)<=90))

  // Karte einfaerben:
  if (mappingp(cols)) {
    for (i=10;i>=0;i--) {
      y=2*i;
      for (j=10;j>=0;j--) {
	// x=6*j;
	x=7*j+3;
	while(IS_LETTER(map[y][--x]));
	x2=x; while (IS_LETTER(map[y][++x2]));
	if (fn=cols[16*j+i]) {
	  map[y]=
	    map[y][0..x]+
	    fn+map[y][(x+1)..(x2-1)]+ANSI_NORMAL+
	    map[y][x2..];
	}
      }
    }
  }
  
  return implode(map,"\n");
}

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  SetProp(P_SHORT,"Eine Karte von Tijara");
  SetProp(P_NAME,"Karte");
  SetProp(P_GENDER,FEMALE);
  AddId(({"karte", "tijarakarte", "tijaraplan", "stadtplan", "plan"}));
  AddCmd ("lies", "lies");
  SetProp(P_WEIGHT,20);
  SetProp(P_VALUE,30);
}

int lies(string str)
{
  if (!str || str=="" || !id(str)) return 0;
  write(long());
  return 1;
}

