// d/dschungel/feyaria/tiajara/obj/kopf.c
// ein Tierkopf fuer die Trophaeen-quest
// 1998-10-17 Feyaria@SilberLand


#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_NAME, "Tierkopf");
  SetProp(P_GENDER, MALE);
  AddId( ({"kopf", "\njaegerquest_kopf", "QUESTOBJ"}) );
  
  SetProp(P_MATERIAL, MAT_MISC_DEAD );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NODROP, 
      "Du sollst den Kopf doch beim Grosswildjaeger abliefern!\n");
  SetProp(P_NOSELL, 
      "Du sollst den Kopf doch beim Grosswildjaeger abliefern!\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
}

string long()
{
  return BS("Ein ausgestopfter "+name(RAW)+". Er ist sehr gut "
      "praepariert und schaut erschreckend lebensecht aus.");
}

string short()
{
  return "Ein ausgestopfter "+name(RAW)+".\n";
}

mixed _query_autoloadobj()
{
  return  name(RAW);
}

void _set_autoloadobj( mixed args )
{
  SetProp(P_NAME, args);
  AddId( ({ LOWER(args), "\nquest_"+args}) );
}

