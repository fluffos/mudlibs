// /d/dschungel/feyaria/tijara/room/weg_b5.c
// Weg in Tijara, B5
// 30-10-96  Feyaria@SilberLand
// 16 Details, 1 Readdetail, 1 Sound, 2 Smells

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich auf einem Weg in Tijara. Er fuehrt hier von Westen "
    "nach Osten zum Hauptplatz. Die Haeuser machen hier einen etwas "
    "armseligen Eindruck. Hier leben wohl die aermeren Einwohner. Das Haus "
    "im Sueden ist mit dunkelgruener Farbe bemalt. Ein Schild haengt ueber "
    "der Eingangstuer.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich mitten in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "haeuser", "behausungen"}),
    "Bei diesen armseligen Haeusern handelt es sich um die Behausungen von "
    "armen Handwerkern.");
  AddDetail( ({ "eindruck"}),
    "Wirklich ein armseliger Eindruck.");
  AddDetail( ({ "einwohner", "handwerker"}),
    "Die meisten Einwohner hier sind arme Handwerker.");
  AddDetail( ({"weg", "osten"}),
    "Der Weg fuehrt von Westen nach Osten zum Hauptplatz.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden besteht hier aus festgestampfter Erde.");
  AddDetail( ({ "nordwesten", "norden", "suedwesten", "nordosten", 
                "suedosten"}),
    "In diese Richtung ist eine Hausmauer.");
  AddDetail( ({ "platz", "hauptplatz", "osten"}),
    "Nach Osten geht es zum Hauptplatz von Tijara.");
  AddDetail( ({ "haus", "sueden"}),
    "Das Haus im Sueden ist ganz dunkelgruen bemalt. Ueber der Eingangstuer "
    "haengt ein Schild.");
  AddDetail( ({"farbe", "dunkelgruen"}),
    "Das Haus im Sueden hat eine dunkelgruene Farbe.");
  AddDetail( ({ "tuer", "eingangstuer"}),
    "Durch diese Tuer kann man das Haus betreten. Darueber haengt ein "
    "Schild.");
  AddDetail( ({ "schild"}),
    "Auf dem Schild steht etwas geschrieben. Du kannst es lesen.");
  AddReadDetail( ({ "schild"}),
    "Kraeuterhaendler Elsurion: An- und Verkauf von Kraeutern");
  AddDetail( ({ "kraeuterhandlung"}),
    "Das Haus im Sueden ist sicher eine Kraeuterhandlung.");
  AddDetail( ({ "kraeuterhaendler", "elsurion"}),
    "Der Kraeuterhaendler Elsurion ist sicher im Sueden in seinem Haus.");
  AddDetail( ({"kraut", "kraeuter"}),
    "Um Kraeuter zu sehen, musst Du schon die Kraeuterhandlung betreten. "
    "Hier kannst Du sie nur riechen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es richtig ruhig.");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Aus dem Haus im Sueden dringt ein intensiver Geruch nach Kraeutern an "
    "Deine Nase.");
  AddSmell( ({"kraeuter", "kraut"}),
    "Es riecht nach den verschiedensten Kraeutern. Du kannst kein einzelnes "
    "richtig identifizieren. Scheinbar ist dort im Sueden eine "
    "Kraeuterhandlung.");

  AddExit( "westen", "./weg_a5" );
  AddExit( "sueden", "./kraeuter_b6" );
  AddExit( "osten", "./platz_c5" );
}
