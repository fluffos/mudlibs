// /d/dschungel/feyaria/tijara/room/keller/e5.c
// im Weinkeller
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  WEIN_SHORT
  SetProp( P_INT_LONG, BS(
    "Du stehst am Eingang des Weinkellers. Hier lagert der Gouverneur von "
    "Tijara seinen Wein, denn ueberall stehen Weinfaesser und Regale mit "
    "Weinflaschen herum. Im Norden siehst Du noch einen schwachen "
    "Lichtschimmer, dort ist wohl die Treppe, die wieder in die Villa hinauf "
    "fuehrt.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  WEIN_DETAILS;

  AddDetail( ({"treppe", "stiege", "norden"}),
    "Im Norden ist die Stiege, die wieder in die Villa hinauf fuehrt.");
  AddDetail( ({"licht", "lichtschimmer", "schimmer"}),
    "Im Norden siehst Du einen schwachen Lichtschimmer.");
  AddDetail( ({"eingang"}),
    "Das ist hier der Eingang des Weinkellers, denn nach Norden geht es "
    "wieder zur Stiege zurueck.");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddCmd( ({"oeffne", "trink", "trinke", "nimm"}), "wein");

  AddExit( "osten", "./f5:"+getuid(this_player()) );
  AddExit( "suedosten", "./f6:"+getuid(this_player()) );
  AddExit( "norden", "./e4:"+getuid(this_player()) );
  AddExit( "suedwesten", "./d6:"+getuid(this_player()) );
  AddExit( "westen", "./d5:"+getuid(this_player()) );
  AddExit( "sueden", "./e6:"+getuid(this_player()) );
  
  set_next_reset(2*60*60);
}

WEIN_STEHLEN
