// im Kellers
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  LAGER_SHORT
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einem Lagerraum im Keller unter der Villa des "
    "Gouverneurs, der sich noch weit nach Westen ausdehnt. Hier ist alles "
    "voll mit Kisten und Truhen, in denen der Gouverneur die wertvollen "
    "Gueter lagert, die er als Steuer fuer sich behaelt. Einige der Kisten "
    "haben aber Loecher und sind angenagt. Im Sueden fuehrt ein Gang weiter "
    "in den Keller.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  LAGER_DETAILS;

  AddDetail( ({"raum", "lager", "lagerraum"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"gang", "sueden"}),
    "Der Gang fuehrt weiter nach Sueden in den Keller.");

  AddCmd( ({"oeffne"}), "oeffnen");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "westen", "./f2:"+getuid(this_player()) );
  AddExit( "sueden", "./g3:"+getuid(this_player()) );
  
  set_next_reset(2*60*60);
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if( !str ) return 0;
  if( str == "kiste" ) 
  {
    write("Du oeffnest eine Kiste, aber sie ist leer.\n");
    say( CAP(TPN)+ " oeffnet eine leere Kiste.\n");
    return 1;
  }
  return 0;
}
