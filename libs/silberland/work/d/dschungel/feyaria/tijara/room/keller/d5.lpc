#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  WEIN_SHORT
  SetProp( P_INT_LONG, BS(
    "Du stehst im Nordwesteck des Weinkellers. Hier lagert der Gouverneur "
    "von Tijara seinen Wein, denn ueberall stehen Weinfaesser und Regale mit "
    "Weinflaschen herum. Es ist so duester, dass Du sonst nicht viel erkennen "
    "kannst.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  WEIN_DETAILS;

  AddDetail( ({"eck", "nordwest", "nordwesteck"}),
    "Natuerlich ist das das Nordwesteck, weil Du ja nach Sueden, Osten und "
    "Suedosten gehen kannst.");

  AddCmd( ({"oeffne", "trink", "trinke", "nimm"}), "wein");

  AddExit( "osten", "./e5:"+getuid(this_player()) );
  AddExit( "suedosten", "./e6:"+getuid(this_player()) );
  AddExit( "sueden", "./d6:"+getuid(this_player()) );
}

WEIN_STEHLEN
  
