// /d/dschungel/feyaria/tijara/room/sammler_c7.c
// Der Trophaeensammler von Tijara, C7
// 1998-02-23  Feyaria@SilberLand
// 28 Details, 1 Smell

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Trophaeensammler von Tijara" );
  SetProp( P_INT_LONG,
    "Dieses Haus gehoert einem Trophaeensammler, denn die Waende sind mit "
    "vielen Tierkoepfen und ausgestopften Voegeln geschmueckt. "
    "Auf dem Boden liegt ein riesiges, weisses Fell. In einer Ecke befindet "
    "sich ein grosser Haufen mit Ruestungen. "
    "Der einzige Ausgang fuehrt nach Osten auf die Strasse zurueck.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({"haufen", "ecke", "ruestungen"}), 
      "In einer Ecke befindet sich ein grosser Haufen mit verschiedenen "
      "Ruestungsteilen.");
  AddDetail( ({"ruestungsteile", "ruestungteil"}),
      "Es handelt sich um rassen- und gildenspezifische Ruestungen, die der "
      "Trophaensammler scheinbar sammelt. Vielleicht ist er ja auch bereit, "
      "mit Dir zu tauschen.");
  AddDetail( ({ "boden", "parkett", "parkettboden" }),
    "Der Boden besteht aus Parkett. Es handelt sich also um einen "
    "Parkettboden. Darauf liegt ein riesiges, weisses Fell.");
  AddDetail( ({"fell", "weisses fell", "polarbaerfell", "baerfell",
               "baerenfell", "polarbaerenfell"}),
    "Das weisse Fell ist so riesig, dass es nur vom maechtigen Polarbaer "
    "stammen kann.");
  AddDetail( ({"polarbaer", "baer"}),
    "Der Polarbaer ist der groesste Baer, den es im SilberLand gibt. "
    "Er lebt nur in den kaeltesten Gegenden der Polarregion und ist sehr "
    "selten.");
  AddDetail( ({"polarregion", "polar"}),
    "Du denkst . o O ( Das Fell kommt ja von sehr weit her!)");
  AddDetail( ({"decke"}),
    "Auch die Decke ist voller Trophaeen. Dort haengen vor allem kleine "
    "ausgestopfte Voegel herum.");
  AddDetail( ({"voegel", "ausgestopfte voegel", "vogel" }),
    "Es handelt sich vor allem um Voegel, die im Dschungel heimisch sind, "
    "also Papageien, Kolibris und Kakadus, aber Du siehst auch einige "
    "Voegel, die weiter im Norden heimisch sind.");
  AddDetail( ({ "papageien", "kolibris", "kakadus"}),
    "Sie sind sehr bunt und gut praepariert. Obwohl sie ausgestopft sind, "
    "schauen sie fast lebendig aus.");
  AddDetail( ({"papagei", "kolibiri", "kakadu"}),
    "Unter der Vielzahl der bunten Voegel sticht kein einzelner heraus. "
    "Wegen der guten Praeparation wirken sie alle fast lebendig.");
  AddDetail( ({"praeparation"}),
    "Du wunderst Dich, wie die Voegel und Tierkoepfe praepariert sind, "
    "damit sie so echt und farbenfroh aussehen.");
  AddDetail( ({ "osten", "ausgang", "richtungen" }),
    "Der Ausgang fuehrt nach Osten auf die Strasse zurueck.");
  AddDetail( ({ "strasse" }),
    "Die Strasse ist ausserhalb des Hauses.");
  AddDetail( ({ "nordosten", "norden", "suedosten", "sueden",
                "suedwesten", "westen", "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Wand einrennen.");
  AddDetail( ({ "haus", "raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({ "tierkopf", "kopf"}),
    "Ein Tierkopf ist besonders interessant. Es handelt sich dabei um "
    "den Kopf einer grossen Raubkatze.");
  AddDetail( ({ "raubkatze", "katze"}),
    "Sei froh, dass hier nur der ausgestopfte Kopf der Raubkatze ist und "
    "nicht die gefaehrliche Katze selber.");
  AddDetail( ({ "raubkatzenkopf", "katzenkopf"}),
    "Der Raubkatzenkopf ist wirklich sehr interessant. Besonders die langen "
    "Fangzaehne jagen Dir Angst ein.");
  AddDetail( ({ "fangzaehne", "zaehne", "angst"}),
    "Wenn Du diesen Zaehnen einmal wirklich begegnest, solltest Du "
    "wirklich Angst haben. Sie gehoeren naemlich dem gefleckten "
    "Dschungeltiger, der gefaehrlichsten Raubkatze im ganzen SilberLand.");
  AddDetail( ({ "dschungeltiger"}),
    "Der Dschungeltiger ist wirklich die gefaehrlichste Raubkatze im "
    "ganzen SilberLand.");
  AddDetail( ({ "tiger", "jaguar"}),
    "Du hast schon einmal gehoert, dass es solche Raubkatzen im Dschungel "
    "geben soll.");
  AddDetail( ({"dschungel", "heimat"}),
    "Der Dschungel ist die Heimat von vielen Raubkatzen, wie z.B. Tiger oder "
    "Jaguar.");
  AddDetail( ({ "silberland", "welt"}),
    "Das SilberLand ist diese Welt. Aber das weisst Du doch, oder etwa "
    "nicht?");
  AddDetail( ({"trophaee", "trophaeen"}),
    "Das ganze Haus ist voller Trophaeen, hauptsaechlich ausgestopfte Voegel "
    "und Raubtierkoepfe.");
  AddDetail( ({ "wand", "waende"}),
    "Die Waende sind voll mit Trophaeen. Es handelt sich dabei vor allem um "
    "Tierkoepfe.");
  AddDetail( ({"tierkoepfe", "koepfe"}),
    "Die Tierkoepfe sind ausgestopft und haengen an den Waenden. Es handelt "
    "sich hauptsaechlich um Raubtiere, vor allem um Raubkatzen. Auch einige "
    "Koepfe mit maechtigen Geweihen und Hoernern sind darunter.");
  AddDetail( ({"raubtiere", "raubtier", "raubkatzen", "raubtierkopf", 
               "raubtierkoepfe"}),
    "Bei den ausgestopften Raubtierkoepfen handelt es sich fast "
    "ausschliesslich um Raubkatzen. Ein Kopf ist besonders interessant.");
  AddDetail( ({"geweih", "geweihe", "hoerner", "horn"}),
    "Die Geweihe und Hoerner gehoerten wohl einmal grossen Hirschen und "
    "Bueffeln, wie sie nur mehr sehr selten im SilberLand vorkommen.");
  AddDetail( ({"hirsch", "hirsche", "bueffel" }),
    "Von den Hirschen und Bueffeln stammen die Geweihe und Hoerner. Da es "
    "nur mehr sehr wenige Exemplare dieser Arten im SilberLand gibt, "
    "haengen auch nur wenige Trophaeen davon an den Waenden.");
  AddDetail( ({"arten", "exemplare"}),
    "Die Arten der Bueffel und Hirsche sind fast ausgestorben. Es gibt also "
    "nur noch sehr wenige Exemplare davon, sodass das Sammeln solcher "
    "Trophaeen sicher sehr schwer ist.");
  AddDetail( ({"sammler", "trophaeensammler"}),
    "Der Trophaeensammler ist gerade nicht da. Sicher sucht er gerade "
    "nach neuen Trophaeen.");
  
  AddSmell( DEFAULT_SMELL,
    "Es riecht leicht verfault, aber das ist bei den vielen ausgestopften "
    "Tieren ja kein Wunder.");

  AddExit( "osten", "./tor_d7" );
  AddItem( NPC "sammler", REFRESH_DESTRUCT);

}
