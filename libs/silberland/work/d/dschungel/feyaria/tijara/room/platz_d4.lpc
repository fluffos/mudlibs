// /d/dschungel/feyaria/tijara/room/platz_d4.c
// Hauptplatz von Tijara, D4
// 30-10-96  Feyaria@SilberLand
// 23 Details, 1 ReadDetail, 2 Sounds, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hauptplatz von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf der Nordseite des Hauptplatzes von Tijara. Der Platz ist "
    "rund und in der Mitte steht ein grosser Springbrunnen, von dem eine "
    "Fontaene hoch in den Himmel aufsteigt. Im Osten befindet sich der "
    "Palast des Gouverneurs. Im Westen ist ein grosses Waffengeschaeft, wie "
    "man an der grossen Werbetafel erkennen kann. Nach Norden fuehrt die "
    "Hauptstrasse zum Hafen.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt", "nordende", "nordseite"}),
    "Du befindest Dich auf dem Hauptplatz der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "pflaster", "pflastersteine", "steine"}),
    "Die hellen Pflastersteine machen einen sauberen Eindruck.");
  AddDetail( ({"hauptstrasse"}),
    "Die Hauptstrasse fuehrt nach Norden zum Hafengebiet.");
  AddDetail( ({ "platz", "hauptplatz", "sueden", "suedosten", "suedwesten"}),
    "Du stehst am Nordende des runden Hauptplatzes. In der Mitte steht ein "
    "grosser Springbrunnen. An den anderen Enden des Platzes fuehren "
    "Strassen in alle Richtungen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({ "nordwesten", "nordosten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "norden", "hafen", "hafenviertel", "hafengebiet"}),
    "Nach Norden fuehrt die Hauptstrasse ins Hafenviertel.");
  AddDetail( ({ "eindruck", "sauberkeit"}),
    "Der Eindruck taeuscht nicht, es ist wirklich alles sehr sauber.");
  AddDetail( ({ "rund", "kreis"}),
    "Der Platz ist rund wie ein Kreis.");
  AddDetail( ({ "springbrunnen", "brunnen", "mitte"}),
    "Der Springbrunnen steht in der Mitte des Hauptplatzes. Eine grosse "
    "Wasserfontaene steigt aus dem Springbrunnen mitten in den Himmel auf. "
    "Dann faellt das Wasser wieder in den Brunnen zurueck.");
  AddDetail( ({ "fontaene", "wasserfontaene"}),
    "Eine grosse Fontaene steigt aus dem Springbrunnen mitten in den Himmel "
    "auf.");
  AddDetail( ({ "wasser"}),
    "Im Brunnen ist viel Wasser. Es wird immer wieder von der Fontaene in "
    "die Luft geschleudert und faellt dann wieder in den Brunnen zurueck.");
  AddDetail( ({ "strasse", "strassen"}),
    "Von diesem Platz fuehren Strassen in alle Richtungen weg.");
  AddDetail( ({ "palast", "osten"}),
    "Der Gouverneurspalast ist wirklich praechtig. Die weisse Fassade "
    "ist mit Stuckarbeiten verziert.");
  AddDetail( ({ "fassade", "stuck", "stuckarbeit", "stuckarbeiten"}),
    "Die Stuckarbeit an der Fassade ist wirklich bemerkenswert. Du "
    "moechtest auch sofort Gouverneur sein, nur um so einen schoenen "
    "Palast zu besitzen.");
  AddDetail( ({ "gouverneur"}),
    "Der Gouverneur ist nicht hier. Er wird wohl in seinem Palast sein.");
  AddDetail( ({ "gouverneurspalast", "tipptoppsuperultrasonderangebot"}),
    "Dass Du so ein langes Wort ohne Fehler tippen kannst, ist schon toll. "
    "Versuchs doch mal mit fischersfritzefischtfrischefische.");
  AddDetail( ({ "fischersfritzefischtfrischefische"}),
    "Du kannst zwar gut abtippen, aber sagen kannst Du dieses Wort sicher "
    "nicht.");
  AddDetail( ({ "waffenladen", "waffengeschaeft", "westen", "laden",
                "geschaeft"}),
    "Der Waffenladen ist im Westen. Auf einer grossen Werbetafel kannst Du "
    "die Sonderangebote sehen.");
  AddDetail( ({ "werbetafel", "tafel"}),
    "Die Werbetafel ist wirklich sehr gross und verdeckt fast den ganzen "
    "Laden. Du kannst sie lesen. (wenn Du ein paar Schritte zurueckmachst)");
  AddReadDetail( ({ "werbetafel", "tafel"}),
    "  /---------------------------------------------------------\\\n"
    " |                                                           |\n"
    " |     *           *    *       ****   ****   ****   *   *   |\n"
    " |      *         *    * *      *      *      *      **  *   |\n"
    " |       *   *   *    *****     ****   ****   ****   * * *   |\n"
    " |        * * * *    *     *    *      *      *      *  **   |\n"
    " |         *   *    *       *   *      *      ****   *   *   |\n"
    " |                                                           |\n"
    " |      DAS TIPPTOPPSUPERULTRASONDERANGEBOT DER WOCHE:       |\n"
    " |   eine Machete um beinahe geschenkte 3999 Goldmuenzen     |\n"
    " |                                                           |\n"
    "  \\---------------------------------------------------------/\n");

  AddDetail( ({ "sonderangebote", "sonderangebot", "machete"}),
    "Eine Machete fuer 3999 Goldmuenzen ist wirklich ein Sonderangebot.");

  AddSound( ({DEFAULT_SOUND}),
    "Du hoerst das leise Plaetschern des Springbrunnens.");
  AddSound( ({"plaetschern", "brunnen", "springbrunnen", "fontaene"}),
    "Der Springbrunnen gibt ein leisen Plaetschern von sich. Hauptsaechlich "
    "kommt es von der Fontaene.");
  AddSmell( ({DEFAULT_SMELL, "stadt"}),
    "Hier riecht es nach Stadt.");

  AddCmd( ({"sage", "sag", "'", ","}), "sagen");

  AddExit( "norden", "./weg_d3" );
  AddExit( "westen", "./waffen_c4" );
  AddExit( "osten", "./gouverneur_e4" );
  AddExit( "suedwesten", "./platz_c5" );
  AddExit( "sueden", "./platz_d5" );
  AddExit( "suedosten", "./platz_e5" );
}

int sagen(string str)
{
  int richtig;
  string fffff;
  if( strlen(str)<6 ) return 0;
  if( lower_case(str[0..4])=="fisch" || lower_case(str[0..4])=="fritz" ||
      lower_case(str[0..5])=="frisch" || lower_case(str[0..2])=="fir")
  {
    switch ( richtig=random(10) )
    {
      case 0: fffff="Fischers Fritze fischt frische Fische";
              break;
      case 1: fffff="Fischers Fritze fischt Fische Fritze";
              break;
      case 2: fffff="Fischers Frische fizt frische Fitsche";
              break;
      case 3: fffff="Fritzes Fische fritzen frische Fitze";
              break;
      case 4: fffff="Firsche Fitze frischen fische Fritze";
              break;
      case 5: fffff="Fischer fritzt fisch Fische Fritze";
              break;
      case 6: fffff="Frische Fische fritzt Fischers Fritze";
              break;
      case 7: fffff="Fischer fritzt frisch gefischte Firsche";
              break;
      case 8: fffff="Fritz frichst Fische fritsche firtze";
              break;
      case 9: fffff="Fisch fritscht fische frisch Firtze";
              break;
    }
    write("Du sagst: "+ fffff+".\n");
    if( richtig!=0 )
      write("Du denkst . o O ( Das war jetzt aber nicht ganz richtig )\n");
    else
      TP->Message("Feyaria teilt Dir mit: Du bist ja ein Sprachgenie!\n", 
          MSGFLAG_TELL);
    say( TPN+ " sagt: "+ fffff+".\n");
    return 1;
  }
  return 0;
}
