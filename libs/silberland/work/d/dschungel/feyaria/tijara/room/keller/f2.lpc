#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  LAGER_SHORT
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einem Lagerraum im Keller unter der Villa des "
    "Gouverneurs. Hier ist alles voll mit Kisten und Truhen, in denen der "
    "Gouverneur die wertvollen Gueter lagert, die er als Steuer fuer sich "
    "behaelt. Einige der Kisten haben aber Loecher und sind angenagt. Der "
    "Lagerraum erstreckt sich noch weiter nach Osten, waehrend sich im Westen "
    "eine Kreuzung befindet.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  LAGER_DETAILS;

  AddDetail( ({"raum", "lager", "lagerraum"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"kreuzung", "westen"}),
    "Im Westen befindet sich eine Kreuzung.");

  AddCmd( ({"oeffne"}), "oeffnen");

  AddExit( "westen", "./e2:"+getuid(this_player()) );
  AddExit( "osten", "./g2:"+getuid(this_player()) );
}

int oeffnen(string str)
{
  object ob;
  notify_fail("Was willst Du oeffnen?\n");
  if( !str ) return 0;
  if( str == "kiste" ) 
  {
    if( (ob=present( "\nrattenfaengerquest", TP) ) )
    {
      if( ob->check_ratte(3) )
      {
        write("Du oeffnest eine Kiste und entdeckst eine Ratte.\n");
        say( CAP(TPN)+ "oeffnet eine Kiste.\n");
        tell_room(TO, "Eine Ratte springt aus einer Kiste hervor.\n");
        clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
        ob->finde_ratte(3);
        return 1;
      }
      else
      {
        write("Du oeffnest eine Kiste, aber sie ist leer.\n");
        say( CAP(TPN)+ " oeffnet eine leere Kiste.\n");
        return 1;
      }
    }
  }
  return 0;
}

