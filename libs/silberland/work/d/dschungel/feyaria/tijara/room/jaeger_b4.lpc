// /d/dschungel/feyaria/tijara/room/jaeger_b4.c
// Grosswildjaeger in Tijara, B4
// 1998-02-23  Feyaria@SilberLand
// 29 Details

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Grosswildjaeger von Tijara" );
  SetProp( P_INT_LONG,
    "Du stehst im Haus des Grosswildjaegers von Tijara. "
    "Die Waende bestehen aus Holzbrettern, in die verschiedene Tiersymbole "
    "geschnitzt sind. Ansonsten ist das Haus relativ leer, der Jaeger ist "
    "wohl sehr oft auf Jagd. Nur einige Jagdwaffen lehnen in einer Ecke. "
    "Der einzige Ausgang fuehrt nach Westen auf die Strasse zurueck.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "haus", "raum" }), 
    "Das ist das Haus des Grosswildjaegers von Tijara.");
  AddDetail( ({"jaeger", "grosswildjaeger"}),
    "Der Grosswildjaeger ist scheinbar gerade auf der Jagd.");
  AddDetail( ({"jagd"}),
    "Im Dschungel kannst Du auch auf die Jagd auf Grosswild gehen.");
  AddDetail( ({"wild", "grosswild"}),
    "Im Dschungel gibt es viel Wild zu jagen, aber auch viele Gefahren.");
  AddDetail( ({"gefahren"}),
    "Die Gefahren des Dschungels sind die Tiere, aber auch die Kannibalen.");
  AddDetail( ({"jagdwaffe", "waffe", "jagdwaffen", "eck", "ecke", "waffen"}),
    "In einer Ecke lehnen einge Jagdwaffen, vor allem Boegen und Speere.");
  AddDetail( ({"boegen", "speere", "speer", "bogen"}),
    "Du denkst . o O (Gut geeignet fuer die Jagd.)");
  AddDetail( ({ "westen", "ausgang" }),
    "Der Ausgang fuehrt nach Westen auf die Strasse zurueck.");
  AddDetail( ({ "strasse" }), 
    "Die Strasse ist ausserhalb des Hauses.");
  AddDetail( ({ "nordosten", "osten", "suedosten", "sueden",
                "suedwesten", "norden", "nordwesten"}), 
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hauswand einrennen."); 
  AddDetail( ({ "hauswand", "waende", "wand"}),
    "Die Hauswand besteht aus Holzbrettern, in die verschiedene Tiersymbole "
    "geschnitzt sind.");
  AddDetail( ({ "holzbretter", "bretter"}),
    "Die Holzbretter sind mit vielen geschnitzten Tiersymbolen verziert.");
  AddDetail( ({ "holz"}),
    "Es handelt sich um das seltene Holz des Tic-Toc Baumes, dass sich "
    "sehr gut zum Schnitzen eignet.");
  AddDetail( ({ "tic-toc", "tictoc", "tic", "toc"}),
    "Der Tic-Toc Baum macht 'tic toc' wenn man an ihn klopft. Daher kommt "
    "sein Name. Zusaetzlich laesst sich sein Holz besonders gut bearbeiten "
    "und so ist es bei Schnitzern sehr beliebt.");
  AddDetail( ({ "tictocbaum", "tic-toc-baum", "tic-toc baum"}),
    "Solltest Du einmal einen Tic-Toc Baum im Dschungel finden, kannst Du "
    "ihn ja faellen und einem Schnitzer verkaufen.");
  AddDetail( ({ "baum", "baeume"}),
    "Hier gibt es keine Baeume. wenn Du einen sehen willst, dann verlass "
    "die Stadt und geh in den Dschungel.");
  AddDetail( ({ "schnitzer"}),
    "Ein Schnitzer wuerde sicher viel fuer einen Tic-Toc Baum bezahlen.");
  AddDetail( ({ "dschungel"}),
    "Hier ist der Dschungel gerodet worden, um fuer die Stadt Platz zu "
    "machen, aber ausserhalb von Tijara ist noch viel Dschungel uebrig. "
    "Dort gibt es viel wilde Tiere und gefaehrliche Kannibalen.");
  AddDetail( ({ "tiersymbole", "symbole"}),
    "Viele verschieden Tiere sind als Symbole in die Holzbretter der "
    "Hauswand geschnitzt.");
  AddDetail( ({ "tiere", "tier"}),
    "Es handelt sich um die Tieres des Dschungels. Die meisten sind aber "
    "nur symbolhaft abgebildet, darum kann man sie nicht richtig zuordnen.");
  AddDetail( ({"boden"}),
    "Der Boden besteht aus blankpolierten, tiefschwarzen Steinplatten.");
  AddDetail( ({"platte", "steinplatte", "platten", "steinplatten"}),
    "Die Steinplatten sind tiefschwarz und so stark poliert, dass man sich "
    "darin spiegeln kann.");
  AddDetail( ({"stein", "obsidian"}),
    "Der Stein ist sicher der wertvolle Obsidian, wie er von den Kannibalen "
    "im tiefsten Dschungel verwendet wird.");
  AddDetail( ({"kannibalen"}),
    "Die Kannibalen verwenden Obsidian, weil sie kein Metall kennen.");
  AddDetail( ({"metall"}),
    "Du kennst doch Metall, oder bist Du etwa auch ein Kannibale aus dem "
    "tiefen Dschungel.");
  AddDetail( ({"tijara", "stadt"}),
    "Du bist in der Stadt Tijara.");
  AddDetail( ({"decke"}),
    "Die Decke ist im Gegensatz zum Boden weiss ausgemalt.");
  
  AddExit( "westen", "./weg_a4" );
  AddItem( NPC "jaeger", REFRESH_DESTRUCT);
}
