// /d/dschungel/feyaria/tijara/room/platz_e5.c
// Hauptplatz von Tijara, E5
// 30-10-96  Feyaria@SilberLand
// 26 Details, 2 Sounds, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int kaefer;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hauptplatz von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf der Ostseite des Hauptplatzes von Tijara. Der Platz ist "
    "rund und in der Mitte steht ein grosser Springbrunnen, von dem eine "
    "Fontaene hoch in den Himmel aufsteigt. Im Norden befindet sich der "
    "Palast des Gouverneurs. Im Sueden ist ein grosses, gelbes Gebaeude, "
    "das sicherlich das Postamt darstellt. Nach Osten fuehrt ein Weg in das "
    "Wohngebiet der Stadt.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt", "ostende", "ostseite"}),
    "Du befindest Dich auf dem Hauptplatz der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "pflaster", "pflastersteine", "steine"}),
    "Die hellen Pflastersteine machen einen sauberen Eindruck. Ein "
    "Pflasterstein scheint zu fehlen.");
  AddDetail( ({ "pflasterstein", "stein"}),
    "Ein Pflasterstein fehlt und hinterlaesst eine Luecke im Boden.");
  AddDetail( ({ "luecke"}),
    "In der Luecke hat sich Regenwasser angesammelt.");
  AddDetail( ({ "regenwasser"}),
    "Im Regenwasser schwimmt ein kleines Insekt.");
  AddDetail( ({ "insekt"}),
    "Bei dem Insekt handelt es sich um einen Kaefer.");
  AddDetail( ({ "kaefer", "flecken", "fleckenkaefer"}),
    "Der Kaefer hat violette Flecken. Er zappelt im Wasser herum und kommt "
    "nicht mehr heraus. Von selber wird er sich aus seiner dummen Lage "
    "sicher nicht mehr befreien koennen.");
  AddDetail( ({"lage"}),
    "Der Kaefer befindet sich wirklich in einer dummen Lage, aus der er sich "
    "sicher nicht mehr selber befreien kann.");
  AddDetail( ({ "platz", "hauptplatz", "westen", "suedwesten","nordwesten"}),
    "Du stehst am Ostende des runden Hauptplatzes. In der Mitte steht ein "
    "grosser Springbrunnen. An den anderen Enden des Platzes fuehren "
    "Strassen in alle Richtungen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({ "osten", "weg", "wohngebiet", "wohngebiete"}),
    "Nach Osten fuehrt ein Weg in die Wohngebiete der Stadt.");
  AddDetail( ({ "nordosten", "suedosten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "eindruck", "sauberkeit"}),
    "Der Eindruck taeuscht nicht, es ist wirklich alles sehr sauber.");
  AddDetail( ({ "rund", "kreis"}),
    "Der Platz ist rund wie ein Kreis.");
  AddDetail( ({ "springbrunnen", "brunnen", "mitte"}),
    "Der Springbrunnen steht in der Mitte des Hauptplatzes. Eine grosse "
    "Wasserfontaene steigt aus dem Springbrunnen mitten in den Himmel auf. "
    "Dann faellt das Wasser wieder in den Brunnen zurueck.");
  AddDetail( ({ "fontaene", "wasserfontaene"}),
    "Eine grosse Fontaene steigt aus dem Springbrunnen mitten in den Himmel "
    "auf.");
  AddDetail( ({ "wasser"}),
    "Im Brunnen ist viel Wasser. Es wird immer wieder von der Fontaene in "
    "die Luft geschleudert und faellt dann wieder in den Brunnen zurueck.");
  AddDetail( ({ "strasse", "strassen"}),
    "Von diesem Platz fuehren Strassen in alle Richtungen weg.");
  AddDetail( ({ "eingang"}),
    "Einen Eingang kannst Du hier nirgends erkennen.");
  AddDetail( ({ "sueden", "post", "gebaeude", "postamt"}),
    "Das Gebaeude im Sueden ist sicherlich die Post von Tijara. Die gelbe "
    "Farbe ist wirklich sehr auffallend. Einen Eingang kannst du hier aber "
    "nicht erkennen.");
  AddDetail( ({ "farbe", "gelb"}),
    "Das typische, kraeftige Gelb, an dem man die Postaemter sofort "
    "erkennen kann.");
  AddDetail( ({ "postaemter"}),
    "Hier gibts nur ein Postamt, Du Scripter!");
  AddDetail( ({ "palast", "norden", "gouverneurspalast"}),
    "Der Gouverneurspalast ist wirklich praechtig. Die weisse Fassade "
    "ist mit Stuckarbeiten verziert.");
  AddDetail( ({ "fassade", "stuck", "stuckarbeit", "stuckarbeiten"}),
    "Die Stuckarbeit an der Fassade ist wirklich bemerkenswert. Du "
    "moechtest auch sofort Gouverneur sein, nur um so einen schoenen "
    "Palast zu besitzen.");
  AddDetail( ({ "gouverneur"}),
    "Der Gouverneur ist nicht hier, sondern wahrscheinlich in seinem "
    "herrlichen Palast.");

  AddSound( ({DEFAULT_SOUND}),
    "Du hoerst das leise Plaetschern des Springbrunnens.");
  AddSound( ({"plaetschern", "brunnen", "springbrunnen", "fontaene"}),
    "Der Springbrunnen gibt ein leisen Plaetschern von sich. Hauptsaechlich "
    "kommt es von der Fontaene.");
  AddSmell( ({DEFAULT_SMELL, "stadt"}),
    "Hier riecht es nach Stadt.");

  AddCmd( ({"befrei", "befreie"}), "befreien");

  AddExit( "osten", "./wohn_f5" );
  AddExit( "westen", "./platz_d5" );
  AddExit( "suedwesten", "./platz_d6" );
  AddExit( "nordwesten", "./platz_d4" );

  kaefer=1;
}

reset()
{
  kaefer=1;
  RemoveDetail( ({ "regenwasser"}) );
  AddDetail( ({ "regenwasser"}),
    "Im Regenwasser schwimmt ein kleines Insekt.");
  AddDetail( ({ "insekt"}),
    "Bei dem Insekt handelt es sich um einen Kaefer.");
  AddDetail( ({ "kaefer", "flecken", "fleckenkaefer"}),
    "Der Kaefer hat violette Flecken. Er zappelt im Wasser herum und kommt "
    "nicht mehr heraus. Von selber wird er sich aus seiner dummen Lage "
    "sicher nicht mehr befreien koennen.");
  AddDetail( ({"lage"}),
    "Der Kaefer befindet sich wirklich in einer dummen Lage, aus der er sich "
    "sicher nicht mehr selber befreien kann.");
  ::reset();
}

int befreien(string str)
{
  notify_fail("Wen willst Du befreien?\n");
  if( !str || kaefer==0) return 0;
  if( str=="kaefer" || str=="fleckenkaefer" || str=="insekt")
  {
    write( BS( "Behutsam nimmst Du den Kaefer aus dem Wasser heraus und "
      "setzt ihn auf den Boden. Der Kaefer schuettelt das Wasser ab und "
      "schaut Dich treuherzig an.") );
    say( TPN+ " bueckt sich und hantiert mit etwas am Boden herum.\n");
    call_out("kaefer", 4+random(3));
    kaefer=0;
    RemoveDetail( ({ "insekt"}) );
    RemoveDetail( ({ "kaefer", "flecken", "fleckenkaefer"}) );
    RemoveDetail( ({ "regenwasser"}) );
    RemoveDetail( ({"lage"}) );
    AddDetail( ({ "regenwasser"}),
      "Ganz normales Regenwasser.");
    return 1;
  }
  return 0;
}

void kaefer()
{
  tell_room(TO, BS( "Ein kleiner Kaefer mit violetten Flecken erhebt sich "
    "vom Boden und fliegt weg.") );
  call_out("flecken", 2+random(3));
}

void flecken()
{
  tell_room(TO, "Jemand ruft: Da ist einer dieser extrem giftigen violetten "
    "Fleckenkaefer!\n");
  call_out("flecken2", 2+random(2));
}

void flecken2()
{
  write("Der Fleckenkaefer fliegt dankend nochmal eine Runde um Deinen Kopf.\n");
  tell_room(TO, "Der Fleckenkaefer fliegt eine Runde um "+ TP->name(WESSEN)+
            " Kopf.\n", ({TP}) );
}
