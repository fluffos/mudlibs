// /d/dschungel/feyaria/tijara/room/keller/e3.c
// im Kellers
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  KELLER_SHORT
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich im Keller der Villa des Gouverneurs von Tijara. "
    "Die Waende sind aus rohen Steinbloecken. Der Boden besteht aus "
    "festgestampftem Lehm. In dem duesteren Daemmerlicht kannst Du kaum "
    "mehr erkennen. Der duestere Gang fuehrt von der Stiege im Sueden weiter "
    "nach Norden.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;

  AddDetail( ({"gang", "treppe", "stiege", "sueden", "norden"}),
    "Der duestere Gang fuehrt von der Stiege im Sueden weiter nach Norden.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind aus rohen Steinbloecken gefertigt. Nur die Westwand "
    "hat eigenartige Strukturen.");
  AddDetail( ({"westwand", "strukturen", "struktur"}),
    "Die Strukturen an der Westwand stellen sich bei genauer Betrachtung als "
    "ein Relief heraus.");
  AddDetail( ({"relief", "mann"}),
    "Das Relief stellt einen Mann dar, der auf einer Pfeife spielt und von "
    "vielen Ratten verfolgt wird. Vielleicht ist das ja ein Schutzzauber "
    "gegen die vielen Ratten hier im Keller. Unter dem Relief hat jemand "
    "eine kleine Zeichnung hingekritzelt.");
  AddDetail( ({"zeichnung"}),
    "Auf der Zeichnung schubst ein Strichmaennchen kleine Wesen mit den "
    "Fuessen ins Meer.");
  AddDetail( ({"strichmaennchen", "maennchen", "striche", "strich"}),
    "Das Strichmaennchen ist sehr einfach gezeichnet, nur Kopf, Koerper, "
    "zwei Arme und zwei Beine kann man erkennen.");
  AddDetail( ({"kopf", "koerper", "arme", "beine", "koerperteile", "fuesse"}),
    "Das Strichmaennchen besteht zwar nur aus Strichen, aber Du kannst die "
    "einzelnen Koerperteile richtig zuordnen.");
  AddDetail( ({"wesen"}),
    "Die Wesen sind sehr schlecht gezeichnet. Du kannst nur erkennen, dass "
    "sie sehr klein sind.");
  AddDetail( ({"zauber", "schutz", "schutzzauber", "bedeutung"}),
    "Recht wirkungsvoll kann der Schutzzauber nicht sein, sonst waeren nicht "
    "so viele Ratten hier im Keller. Vielleicht hat das ganze ja auch eine "
    "andere Bedeutung.");
  AddDetail( ({"pfeife", "pfeifchen"}),
    "Vielleicht koennte Dir ja so ein Pfeifchen auch gegen die Ratten "
    "helfen.");
    
  AddExit( "norden", "./e2:"+getuid(this_player()) );
  AddExit( "sueden", "./e4:"+getuid(this_player()) );
}


