// /d/dschungel/feyaria/tijara/room/kraeuter_b6.c
// Kraeuterhaendler in Tijara, B6
// 30-10-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <laden.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Kraeuterhaendler von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst im Haus des Kraeuterhaendlers. Die Luft ist angefuellt mit "
    "dem Duft nach exotischen Kraeutern. Die Waende sind voll mit Regalen, "
    "in denen frische und getrocknete Kraeuter und verschiedene Teile von "
    "Pflanzen und Tieren liegen. Hier kann man sicher interessante "
    "Heilkraeuter finden. Auch der Verkauf von seltenen Dschungelpflanzen "
    "ist hier moeglich. Der einzige Ausgang fuehrt nach Norden auf die "
    "Strasse zurueck.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );
  SetStorageRoom (ROOM "store3");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "elsurion");
  SetProp(P_SHOPKEEPER_NAME, "Elsurion");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  
  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich mitten in der Stadt Tijara.");
  AddDetail( ({ "boden" }), 
    "Der Boden ist voll mit vertrockneten Kraeutern.");
  AddDetail( ({ "decke"}), 
    "Die Decke ist irgendwo ueber Dir.");
  AddDetail( ({ "wand", "waende"}),
    "Die Waende sind mit Regalen vollgestellt.");
  AddDetail( ({"regale", "regal"}),
    "In den Regalen findest Du viele frische und getrocknete Kraeuter und "
    "verschiedene Teile von Pflanzen und Tieren.");
  AddDetail( ({ "haus" }),
    "Das ist das Haus des Kraeuterhaendlers von Tijara.");
  AddDetail( ({ "norden", "ausgang" }),
    "Der Ausgang fuehrt nach Norden auf die Strasse zurueck.");
  AddDetail( ({ "strasse" }), 
    "Die Strasse ist ausserhalb des Hauses.");
  AddDetail( ({ "nordosten", "osten", "suedosten", "sueden",
                "suedwesten", "westen", "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.");
  AddDetail( ({ "kraeuterhandlung"}),
    "Du stehst in der Kraeuterhandlung.");
  AddDetail( ({ "kraeuterhaendler", "elsurion", "haendler"}),
    "Der Kraeuterhaendler Elsurion ist gerade nicht da.");
  AddDetail( ({"kraut", "kraeuter"}),
    "Wenn Du Kraeuter willst, dann frag am besten den Kraeuterhaendler "
    "danach. Riechen kannst Du sie auf jeden Fall schon.");
  AddDetail( ({"tiere", "pflanzen", "teile", "tier", "pflanze"}),
    "Du siehst verschieden Teile von Tieren und Pflanzen in den Regalen "
    "liegen.");
  AddDetail( ({"dschungelpflanzen", "verkauf"}),
    "Du kannst hier die seltenen Pflanzen des Dschungels kaufen oder "
    "verkaufen.");
  AddDetail( ({"heilkraeuter", "heilkraut", "wunderkraut"}),
    "Es heisst, dass das Wunderkraut alle Beschwerden heilen kann. Es ist "
    "das wertvollste aller Heilkraeuter.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({"nase", "riechen"}),
    "Du verwendest Deine Nase zum Riechen.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "luft"}),
    "Ein intensiver Geruch nach Kraeutern steigt in Deine Nase.");
  AddSmell( ({"kraeuter", "kraut"}),
    "Es riecht nach den verschiedensten Kraeutern. Du kannst kein einzelnes "
    "Kraut richtig identifizieren.");

  AddItem( NPC "elsurion", REFRESH_DESTRUCT);

  AddExit( "norden", "./weg_b5" );
}

do_sell(object ob, int force, no_reg)
{
/*  if( !present("elsurion") )
  {
    write("So ein Pech, Elsurion ist gerade nicht da.\n");
    return 1;
  }*/
  if( ob->QueryProp(P_AC) || ob->QueryProp(P_WC) )
  {
    write("Elsurion sagt: Ich handle nicht mit Waffen und Ruestungen.\n");
    return 1;
  }  
  if( ob->id("\nzauberzutat") || ob->id("\nkraut") || 
      ob->QueryMaterialGroup(MATGROUP_HERBAL) || 
      ob->QueryMaterialGroup(MATGROUP_LIVING) || 
      ob->QueryMaterialGroup(MATGROUP_DRUG) ) 
    return ::do_sell(ob, force);
  write("Elsurion sagt: Ich handle nur mit Kraeutern.\n");
  return 1;
}

buy( str)
{
/*  if( !present("elsurion") )
  {
    write("So ein Pech, Elsurion ist gerade nicht da.\n");
    return 1;
  }*/
  return ::buy(str);
}

void reset()
{
  ::reset();
   set_next_reset(10000);  
   // 2 3/4  Stunden... Elsurion soll man nicht so oft killen koennen
}
