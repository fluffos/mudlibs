// /d/dschungel/feyaria/tijara/room/wohn_f4.c
// Wohngebiet in Tijara, F4
// 30-10-96  Feyaria@SilberLand
// 14 Details

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Wohngebiet in Tijara" );
  SetProp( P_INT_LONG, 
    "Du befindest Dich im Wohngebiet von Tijara. Viele Haeuser sind schon "
    "bewohnt, aber einige Bauplaetze sind noch frei. Die gepflasterte "
    "Strasse ist hier schnurgerade und fuehrt von Norden nach Sueden. "
    "Eine Treppe fuehrt in einen Wohnturm nach oben.");
    
    
/*    
   AddDetail("schild", 
   "Lies es!");
   
   AddReadDetail("schild",
   "+------------------------------------------+\n"
   "| Ostoben  -> Schrotthaus von Levitikus    |\n"
   "| Osten    -> Gruft von Carryon R.I.P.     |\n"
   "| Ostunten -> Seicherlhaus von Bombadil    |\n"
   "+------------------------------------------+\n"
   "Darunter siehst Du eine kleine Zeichnung.");
   
   AddSpecialDetail("zeichnung", "show_ascii");
   */ 
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"levitikushaus", "haus von levitikus", "levihaus",
               "seherhaus von levitikus", "levitikus" }),
    "Du kannst das Haus von Levitikus im Osten betreten."); 
  AddDetail( ({ "tijara", "stadt" }), 
    "Du befindest Dich mitten in der Stadt Tijara.") ;
  AddDetail( ({ "sonne", "himmel", "hitze" }), 
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "strasse", "weg" }), 
    "Die Strasse fuehrt hier schnurgerade von Norden nach Sueden. "
    "Sie ist mit grossen Pflastersteinen gepflastert.");
  AddDetail( ({ "schnur", "schnurgerade" }), 
    "Eine Schnur gibts hier nicht! Die Strasse ist nur so gerade wie eine "
    "Schnur.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({ "sueden", "norden"}),
    "In diese Richtungen kannst Du gehen. (Du kannst aber auch hier stehen "
    "bleiben, wenn es Dir hier gefaellt.)");
  AddDetail( ({ "westen", "nordosten", "osten", "suedosten",
                "suedwesten",  "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.");
  AddDetail( ({ "gardist", "gardisten" }),
    "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
    "in der Naehe.");
  AddDetail( ({ "boden", "pflaster", "steine", "pflastersteine" }),
    "Der Boden besteht aus grossen Pflastersteinen. Alle Steine zusammen "
    "bilden wohl eine ganze Strasse.");
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }),
    "Dies hier ist das Wohngebiet von Tijara. Wie der Name schon sagt, "
    "wohnen hier viele Einwohner der Stadt.");
  AddDetail( ({ "haus", "haeuser" }),
    "Einige Haeuser werden schon von Bewohnern von Tijara bewohnt. Es ist "
    "aber noch genug Platz frei, um hier ein Seherhaus zu bauen. Dazu muss "
    "man nur einen Bauplatz erwerben.");
  AddSpecialDetail( ({ "platz", "bauplatz", "plaetze", "bauplaetze",
                       "seherhaus" }), "seherhaus" ); 
  AddDetail( ({ "gouverneur" }), 
    "Zur Zeit hat Tijara keinen Gouverneur sondern eine Gouverneurin.");
  AddDetail( ({ "gouverneur", "gouverneurin", "feyaria" }),
    "Zur Zeit ist Feyaria die Gouverneurin von Tijara."); 
 

  AddExit( "norden", "./wohn_f3" );
  AddExit( "sueden", "./wohn_f5" );
  AddExit( "oben", "/d/dschungel/feyaria/seherturm/room/seherturm1");
}

/*
string show_ascii()  {

  sprintf(""+TP->More(read_file("/d/dschungel/feyaria/tijara/room/latex.txt"))+"");

return "";

//return "\nDu denkst 'Aha, das treibt Levitikus also hier!\n";	

           }
*/      
string seherhaus()
{
  if( IS_SEER(TP) )
  {
     return BS("Einige Bauplaetze sind noch frei. Wenn Du ein Interesse "
      "an einem Seherhaus hast, dann solltest Du Dich mit dem Gouverneur "
      "von Tijara in Verbindung setzen.");
  }
  else
  {
    return BS("Um ein Seherhaus bauen zu koennen, musst Du schon Seher "
      "sein. Also komm spaeter nochmal vorbei.");
  }
}

