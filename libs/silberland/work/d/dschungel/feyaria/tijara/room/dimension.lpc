#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Verloren in einer fremden Dimension" );
  SetProp( P_INT_LONG, 
    "Wabbernder Nebel...... Schlechte Sicht....... Du hast keine Ahnung, wo "
    "Du Dich befindest...... Du bist verloren in einer fremden Dimension.... "
    "Es gibt wohl keine Moeglichkeit zu entkommen.");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_OTHER]) );

  AddDetail( ({"nebel", "sicht"}),
    "Der Nebel wabbert... die Sicht reicht nur 2 Meter.");
  AddDetail( ({"dimension"}),
    "Du bist verloren in einer fremden Dimension.");
  AddDetail( ({"moeglichkeit"}),
    "Es gibt wirklich keine Moeglichkeit zu entkommen.. dumm gelaufen...");
}

void init()
{
  ::init();
  call_out("strudel", 60+random(120) );
}

void strudel()
{
  if( TP && ENV(TP) == TO )
  {
    write("Ein Strudel in der Dimension kommt auf Dich zu....\n");
    call_out("weg", 10 );
  }
}

void weg()
{
  if( TP && ENV(TP) == TO )
  {
    write("Der Strudel erfasst Dich und schleudert Dich wieder in eine andere "
        "Dimension.\n");
    call_out("raus", 2+random(3) );
  }
}

void raus()
{
  if( TP && ENV(TP) == TO )
  {
    write("Der Strudel wirft Dich wieder in die normale Welt.\n");
    if(query_once_interactive(TP))
      TP->move("/gilden/abenteurer", M_TPORT);
    else
      TP->remove();
  }
}

