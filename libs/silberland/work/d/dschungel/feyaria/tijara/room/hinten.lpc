// /d/dschungel/feyaria/tijara/room/stube.c
// Schreibstube des Gouverneurs
// 1997-03-17  Feyaria@SilberLand

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

#define SDMASTER "/obj/sehertormaster"
#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"

string buch();

object *versucht;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Das Amtszimmer des Gouverneurs von Tijara" );
  SetProp(P_INT_LONG, BS(
    "In diesem Zimmer erledigt der Gouverneur seine Amtsgeschaefte. "
    "Alles ist sehr vornehm eingerichtet. Die Waende sind mit edlen "
    "Hoelzern verkleidet, der Boden besteht aus gruengeaedertem Marmor. "
    "Ueber Dir siehst Du eine grosse Deckenmalerei, die Motive aus "
    "dem Dschungel darstellt. Ein gewaltiger Schreibtisch nimmt den "
    "groessten Teil des Raumes ein. Darauf tuermen sich viele "
    "Papiere und Buecher.") );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({"boden"}),
    "Der Boden besteht aus gruengeaedertem Marmor.");
  AddDetail( ({"marmor"}),
    "Gruengeaederter Marmor ist sehr selten und daher auch sehr teuer.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind mit edlen Hoelzern verkleidet.");
  AddDetail( ({"holz", "hoelzer", "verkleidung", "wandverkleidung"}),
    "Fuer die Wandverkleidung wurden nur die edelsten Hoelzer verwendet, "
    "die man im Dschungel findet.");
  AddDetail( ({"dschungel"}),
    "Der Dschungel ist irgendwo da draussen. Geh doch hinaus und erlebe "
    "dort einige Abenteuer!");
  AddDetail( ({"decke"}),
    "Auf der Decke befindet sich eine grosse Deckenmalerei.");
  AddDetail( ({"malerei", "deckenmalerei"}),
    "Die Deckenmalerei stellt Motive aus dem Dschungel dar.");
  AddDetail( ({"motive", "motiv"}),
    "Wenn Du schon mal im Dschungel warst, kennst du diese Motive sicher."); 
  AddDetail( ({"zimmer", "amtszimmer", "arbeitszimmer"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"tisch", "schreibtisch"}),
    "Auf dem Schreibtisch liegen viele Papiere und Buecher.");
  AddDetail( ({"papaier", "papiere"}),
    "Die Papiere interessieren Dich nicht.");
  AddDetail( ({"buecher"}),
    "Ein Buch faellt Dir besonders auf.");
  AddDetail( ({"buch"}),
    "Es scheint sich um ein magisches Buch zu handeln.");
  AddDetail( ({"magisches buch"}),
    "Du kannst das magische Buch zur Zeit leider nicht lesen.");
  AddReadDetail( ({"buch"}), #'buch);

  AddSound( DEFAULT_SOUND,
    "Es ist angehem ruhig, wie es sich fuer ein Amtszimmer gehoert.");   
  AddSmell( DEFAULT_SMELL,
    "Es riecht angenehm, aber einen genauen Duft kannst Du nicht "
    "identifizieren.");

  AddItem("/obj/sehertor", REFRESH_REMOVE, ([P_SEERDOOR_DISCOVER: 0]) );
  SetProp(P_TPORT_COST_IN, 1);
  SetProp(P_TPORT_COST_OUT, 1);

  SetProp(P_EXIT_PREPOSITION, "nach");
  AddExit( "nebenan", "./schlafzimmer");
  AddExit( "vorne", "./gouverneur_e4" );

  versucht= ({ });
}

string buch()
{
  if( !IS_SEER(TP) )
    return "Irgendwie kannst Du mit den Zeichen nichts anfangen.\n";
  if( SDMASTER->DoorIsKnown() )
    return "Da Du das Sehertor schon gefunden hast, interessiert Dich "
           "das Buch nicht mehr.\n";
  if (member_array (TP, versucht) != -1)
    return "Aber Du hast ja grad eben das Buch gelesen, komm spaeter "
           "wieder.\n";
  CLONE( OBJ "fragen", TP);
  versucht+=({TP});
  return "Interessiert beugst Du Dich ueber das Buch....\n";
}

void reset()
{
  ::reset();
  versucht= ({ });
}
