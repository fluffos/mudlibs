// /d/dschungel/feyaria/tijara/room/kneipe_e2.c
// Hafenkneipe von Tijara, E2
// 30-10-96  Feyaria@SilberLand
// 27 Details, 4 Sounds, 3 Smells

#include "../def.h"

inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <pub.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Die Hafenkneipe 'Zur Seeschlange'" );
  SetProp( P_INT_LONG, BS(
    "Du stehst in einer typischen Hafenkneipe. Alles hier drinnen ist etwas "
    "schmuddelig, aber wenn Du erst einmal ein paar Tequilas getrunken "
    "hast, faellt Dir das sicher nicht mehr auf. Fast alle Tische sind "
    "besetzt, und auch an der Theke ist alles mit durstigen Matrosen "
    "angefuellt. In der Luft haengt ein Geruch nach Rauch, Schweiss und "
    "Alkohol. Die Matrosen groehlen und singen wilde Trinklieder. Wenn Dir "
    "das alles hier zuviel wird, kannst Du nach Westen wieder zum Hafen "
    "zurueckkehren.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp( P_PUBKEEPER_ID, "Kellnerin");
  SetProp( P_PUBKEEPER_NAME, "die Kellnerin");
  SetProp( P_PUBKEEPER_GENDER, FEMALE);
  
  AddDetail( ({ "seeschlange"}),
    "Die Seeschlange gibt der Kneipe ihren Namen.");
  AddDetail( ({ "tijara", "stadt"}),
    "Du befindest Dich in der Hafenkneipe der Stadt Tijara.");
  AddDetail( ({ "boden"}),
    "Am Boden liegen viele leergetrunkene Flaschen herum.");
  AddDetail( ({ "flaschen", "flasche"}),
    "Ups! Fast waerst Du schon wieder ueber eine Flasche gestolpert.");
  AddDetail( ({ "decke"}),
    "Die Decke kannst Du durch den Rauch hindurch kaum sehen.");
  AddDetail( ({ "wand", "waende"}),
    "Die Waende sind ziemlich fleckig.");
  AddDetail( ({ "flecken", "fleck"}),
    "Auf den Waenden sind viele Flecken.");
  AddDetail( ({ "matrosen", "matrose", "seeleute"}),
    "Die meisten Matrosen versaufen hier ihre ganze Heuer. Wenn sie "
    "betrunken sind, sind sie schnell zu einer Schlaegerei bereit.");
  AddDetail( ({ "heuer"}),
    "Die Heuer ist das, was die Matrosen auf ihren Schiffen fuer ihre "
    "Arbeit bezahlt bekommen. Hier versaufen sie dann das meiste davon "
    "wieder.");
  AddDetail( ({ "schlaegerei"}),
    "Willst Du wirklich hier eine Schlaegerei mit den Matrosen anfangen?");
  AddDetail( ({ "kneipe", "hafenkneipe", "spelunke"}),
    "Du stehst mitten drinnen. Wenn Du das Getraenkeangebot sehen willst, "
    "tipp einfach 'menue'.");
  AddDetail( ({ "angebot", "getraenkeangebot", "uebersicht"}),
    "Du solltest doch 'menue' tippen! Wenn Du auch dazu zu faul bist, "
    "hier mal eine kleine Uebersicht: Es gibt Ananassaft, Dschungelbier, "
    "Tequila und den Spezial-Mix zum Trinken und den Dschungelburger "
    "zum Essen");
  AddDetail( ({ "essen", "trinken"}),
    "Hier kannst Du Essen und Trinken.");
  AddDetail( ({ "getraenke", "alkohol", "alkoholsorten", "schnaps"}),
    "Hier werden viele alkoholische Getraenke ausgeschenkt.");
  AddDetail( ({ "saft", "ananassaft", "ananas"}),
    "Der frischausgepresste Ananassaft ist sicher lecker und voller "
    "wertvoller Vitamine.");
  AddDetail( ({ "bier", "dschungelbier"}),
    "Das Dschungelbier ist das typische Getraenk in dieser Kneipe.");
  AddDetail( ({ "tequila"}),
    "Tequila ist ein scharfer Schnaps, der zusammen mit Salz und Zitrone "
    "getrunken wird.");
  AddDetail( ({ "spezial", "spezialmix", "spezial-mix", "mix"}),
    "Der Spezial-Mix ist eine Mischung aus verschiedenen Alkoholsorten. "
    "Viele sind nach so einem Getraenk nicht mehr aufgestanden.");
  AddDetail( ({ "burger", "dschungelburger"}),
    "Der Dschungelburger ist ein kleiner Snack mit frischen Zutaten direkt "
    "aus dem Dschungel.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({ "suedwesten", "nordosten",  "nordwesten", "suedosten", 
                "sueden", "norden", "osten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "westen", "ausgang", "hafen"}),
    "Im Westen gibt es einen Ausgang zum Hafen.");
  AddDetail( ({ "luft", "rauch"}),
    "Du siehst viel Rauch in der Luft.");
  AddDetail( ({ "tisch", "tische"}),
    "Alle Tische sind mit saufenden Matrosen voll.");
  AddDetail( ({ "theke"}),
    "An der Theke kannst Du Sachen zum Trinken und Essen bestellen.");
  AddDetail( ({ "sachen"}),
    "Sachen zum Trinken und Essen, das wurde doch schon erwaehnt!");
  AddDetail( ({ "durst", "hunger"}),
    "Das ist der richtige Ort, Deinen Hunger und Durst zu stillen.");

  AddSound( ({DEFAULT_SOUND, "matrosen"}),
    "Die Matrosen groehlen und singen wilde Trinklieder.");
  AddSound( ({ "trinklieder", "lieder"}),
    "Den genauen Text der Trinklieder kannst Du nicht verstehen, aber sie "
    "handeln wohl alle von der Seefahrt und vom Saufen.");
  AddSound( ({ "seefahrt", "saufen"}),
    "Die Matrosen singen wueste Lieder ueber die Seefahrt und das Saufen.");
  AddSound( ({"groehlen"}),
    "Das Groehlen kommt von den stockbesoffenen Matrosen.");
  AddSmell( ({DEFAULT_SMELL, "geruch", "luft"}),
    "Es riecht hier nach Rauch, Schweiss und Alkohol. Etwas anderes kann "
    "man aber von einer solchen Spelunke auch nicht erwarten.");
  AddSmell( "alkohol",
    "Hier wird sicher hochprozentiger Alkohol ausgeschenkt.");
  AddSmell( ({"rauch", "schweiss"}), 
    "Das riecht richtig eklig. Wenn Du eine empfindliche Nase hast, dann "
    "solltest Du schnell von hier verschwinden.");
    
  AddRoomMessage( ({
    "Ein Matrose ruft: Bier her, oder ich komm um!\n",
    "Die Matrosen beginnen eine kleine Schlaegerei.\n",
    "Ein betrunkener Matrose rempelt Dich an.\n",
    "Ein Matrose torkelt besoffen an Dir vorbei.\n",
    "Du stolperst fast ueber eine am Boden liegende Flasche.\n",
    "Die Matrosen stimmen ein neues Trinklied an.\n"
    }),60);

  AddDrink("Ananassaft", ({"saft", "ananassaft", "ananas"}),
    30, 10, 0, 5,
    ({"Du trinkst genuesslich einen frisch ausgepressten Ananassaft.",
      "&& trinkt genuesslich einen frisch ausgepressten Ananassaft."}));

  AddDrink("Dschungelbier", ({"bier", "dschungelbier"}),
    123, 23, 6, 2,
    ({"Du trinkst ein herbes Dschungelbier.",
      "&& trinkt ein herbes Dschungelbier."}));

  AddDrink("Tequila", "tequila",
    777, 77, 17, 1,
    ({"Du streust etwas Salz auf den Daumen, leckst es ab, trinkst den "
      "Tequila in\neinem Zug hinuter und beisst danach in eine Zitronen"
      "scheibe.\nDu fuehlst die Waerme aus dem Magen bis in den Kopf "
      "hochsteigen.",
      "&& streut etwas Salz auf &#n Daumen, leckt es ab, trinkt den\n"
      "Tequila in einem Zug hinunter und beisst danach in eine Zitronen"
      "scheibe.\n&& wird ploetzlich ganz rot im Gesicht."}));

  AddDrink("Spezial-Mix", ({"spezial", "spezialmix", "spezial-mix", "mix"}),
    400, ({180,200}), 60, 40, "spezialmix");

  AddFood ( "Dschungel-Burger", ({"burger", "dschungelburger", 
    "dschungel-burger"}),  300, 35, 15,
    ({"Du bestellst einen Dschungel-Burger, aber das einzige was ihn von "+
    "einem\nnormalen Hamburger unterscheidet, ist die Verpackung aus "+
    "Lianen.\nTrotzdem mampfst Du den Burger genuesslich hinein.",
    "&& mampft einen Dschungelburger."}));

  AddExit( "westen", "./hafen_d2" );
  AddCmd( ({"fang", "fange"}), "schlaegern");

  AddItem( NPC "kellnerin", REFRESH_DESTRUCT);
}

int spezialmix(object z, object e)  // z=Zahler, e=Empfaenger
{
  tell_object(e, BS(
    "Du trinkst den Spezial-Mix aus lauter verschiedenen Alkoholsorten. "
    "Es fuehlt sich an wie gluehendes Eisen, und tatsaechlich kommt ein "
    "kleines Flaemmchen aus Deinem Mund heraus."));
  tell_room(ME, BS(mess(
      "&& trinkt einen Spezial-Mix, worauf ein kleines Flaemmchen aus &#m "
      "Mund herauskommt.")) , ({e}));
  e->AddPoison(-3);
  return 1;
}

int schlaegern(string str)
{
  notify_fail("Du willst doch nicht etwa eine Schlaegerei anfangen?\n");
  if( str=="schlaegerei an" )
  {
    write(BS("Du faengst eine Schlaegerei an, aber die Matrosen sind "
             "in der Ueberzahl und werfen Dich zerschunden vor die Tuer."));
    say(CAP_TPN+ " schlaegert kurz mit den Matrosen und wird rausgeworfen.");
    TP->remove_hitpoints(10+random(20));
    TP->move(ROOM "hafen_d2", M_GO, "aus der Kneipe", "fliegt",
        "wird aus der Kneipe geworfen");
    return 1;
  }
  return 0;
}
