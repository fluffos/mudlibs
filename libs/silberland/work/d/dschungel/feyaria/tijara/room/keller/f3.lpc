#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  KELLER_SHORT
  SetProp( P_INT_LONG, BS(
    "Hier ist eine kleine Nische im Keller, die mit lauter Geruempel "
    "angefuellt ist, sodass man den Boden gar nicht mehr sehen kann. Im Osten "
    "geht der Gang durch den Keller. Die Waende sind aus rohen Steinbloecken. "
    "In dem duesteren Daemmerlicht kannst Du kaum mehr erkennen.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;

  AddDetail( ({"boden"}),
    "Der Boden ist mit lauter Geruempel angefuellt.");
  AddDetail( ({"geruempel", "sachen"}),
    "Hier ist ein grosser Haufen Geruempel, der aus lauter alten, kaputten "
    "und uninteressanten Sachen besteht.");
  AddDetail( ({"haufen"}),
    "Der Haufen ist das ideale Versteck fuer Ratten.");
  AddDetail( ({"versteck"}),
    "Vielleicht kannst Du ja den Haufen durchwuehlen, um das Versteck zu "
    "finden.");
  AddDetail( ({"nische"}),
    "Diese Nische ist mit lauter Geruempel angefuellt.");
  AddDetail( ({"gang", "osten"}),
    "Im Osten geht der Gang durch den Keller.");
  
  AddCmd( ({"wuehle", "wuehl", "durchwuehl", "durchwuehle"}), "wuehlen");
  AddCmd( ({"such", "suchen", "durchsuche", "durchsuch"}), "suchen");

  AddExit( "osten", "./g3:"+getuid(this_player()) );
}

int wuehlen(string str)
{
  object ob;
  if( !(ob=present( "\nrattenfaengerquest", TP)) ) return 0;
  notify_fail("Was willst Du durchwuehlen?\n");
  if( !str ) return 0;
  if( str == "haufen" || str == "in haufen" || str=="haufen durch" ||
      str=="sachen" || str == "in sachen" || str=="sachen durch" ||
      str=="geruempel" || str=="in geruempel" || str == "geruempel durch")
  {
    write("Du durchwuehlst den Haufen und findest ein Rattenversteck.\n");
    say( CAP(TPN)+ " durchwuehlt den Haufen Geruempel.\n");
    if( ob->check_ratte(4) )
    {
      tell_room(TO, "Eine Ratte springt aus dem Haufen heraus.\n");
      clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
      ob->finde_ratte(4);
      return 1;
    }
    write("Leider ist keine Ratte mehr in dem Versteck.\n");
    return 1;
  }
  return 0;
}

int suchen(string str)
{
  notify_fail("Durchsuchen hat keinen Sinn. Da hilft nur durchwuehlen.\n");
  return 0;
}

