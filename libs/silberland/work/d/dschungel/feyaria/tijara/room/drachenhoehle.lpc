#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Drachenhoehle" );
  SetProp( P_INT_LONG, BS(
    "Du stehst in einer gewaltigen Hoehle unter Tijara. Dem extremen Geruch "
    "nach hat sich hier ein Drache eingenistet.") );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_NO_TPORT, NO_TPORT_OUT);

  AddDetail( ({"boden", "decke", "wand", "waende", "hoehle", "felsen"}),
    "Die gesamte Hoehle besteht aus Felsen.");
  AddDetail("tijara", 
    "Tijara ist irgendwo ueber Dir....");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Es riecht nach Drache!!!");
  
  AddItem( NPC "black_wyrm" , REFRESH_DESTRUCT);
  
  AddExit( "sueden", "./kult" );
}

void reset()
{
  ::reset();
  set_next_reset(7200);
  // 2 Stunden... den Drachen soll man nicht so oft killen koennen
}
