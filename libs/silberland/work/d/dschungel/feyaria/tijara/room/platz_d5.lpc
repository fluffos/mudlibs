// /d/dschungel/feyaria/tijara/room/platz_d5.c
// Hauptplatz von Tijara, D5
// 30-10-96  Feyaria@SilberLand
// 34 Details, 1 ReadDetail, 2 Sounds, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define HEAL 10
#define ANZAHL 5
int heilungen;

create()
{
  ::create();

  heilungen = ANZAHL;
  SetProp( P_INT_SHORT, "Hauptplatz von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst in der Mitte des Hauptplatzes von Tijara, sozusagen im "
    "Zentrum der Stadt. Der runde Platz ist von einigen interessanten "
    "Haeusern und Gebaeuden umgeben. Vor Dir steht ein grosser "
    "Springbrunnen, von dem eine Fontaene hoch in den Himmel aufsteigt. "
    "Das Wasser faellt dann wieder in das grosse Becken des Brunnens "
    "zurueck. In alle Richtungen fuehren Strassen durch die Stadt.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt"}),
    "Du befindest Dich auf dem Hauptplatz der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "pflaster", "pflastersteine", "steine"}),
    "Die hellen Pflastersteine machen einen sauberen Eindruck.");
  AddDetail( ({ "platz", "hauptplatz", "sueden", "suedosten", "suedwesten",
                "zentrum"}),
    "Du stehst im Zentrum des runden Hauptplatzes. Vor Dir steht ein "
    "grosser Springbrunnen. An den anderen Enden des Platzes fuehren "
    "Strassen in alle Richtungen. Rund um den Platz gibt es eine Reihe "
    "interessanter Haeuser und Gebaeude.");
  AddDetail( ({ "eindruck", "sauberkeit"}),
    "Der Eindruck taeuscht nicht, es ist wirklich alles sehr sauber.");
  AddDetail( ({ "rund", "kreis"}),
    "Der Platz ist rund wie ein Kreis.");
  AddDetail( ({ "springbrunnen", "brunnen", "mitte"}),
    "Der Springbrunnen steht in der Mitte des Hauptplatzes. Eine grosse "
    "Wasserfontaene steigt aus dem Springbrunnen mitten in den Himmel auf. "
    "Dann faellt das Wasser wieder in das Brunnenbecken zurueck.");
  AddDetail( ({ "fontaene", "wasserfontaene"}),
    "Eine grosse Fontaene steigt aus dem Springbrunnen mitten in den Himmel "
    "auf.");
  AddDetail( ({ "wasser"}),
    "Im Brunnen ist viel Wasser. Es wird immer wieder von der Fontaene in "
    "die Luft geschleudert und faellt dann wieder in das Brunnenbecken "
    "zurueck.");
  AddDetail( ({ "becken", "brunnenbecken"}),
    "Das Brunnenbecken ist voll mit Wasser. Wie tief es ist, kannst Du "
    "nicht feststellen, denn den Grund kannst Du nicht sehen. Falls "
    "jemand da eine Muenze reinwirft, ist sie sicher unwiderruflich weg.");
  AddDetail( ({ "grund"}),
    "Du kannst wirklich nicht den Grund des Brunnenbeckens erkennen. Der "
    "Brunnen scheint sehr tief zu sein. Ob sich da unten etwas verbirgt?");
  AddDetail( ({ "etwas", "tiefe"}),
    "Irgendetwas verbirgt sich in der Tiefe. Wenn Du mutig bist, kannst "
    "Du ja dort hinuntertauchen.");
  AddDetail( ({ "strasse", "strassen"}),
    "Von diesem Platz fuehren Strassen in alle Richtungen weg. In Nord-Sued "
    "Richtung fuehrt die Hauptstrasse quer ueber den Platz. Nach Osten "
    "geht ein Weg in das Wohnviertel und nach Westen ein Weg in das Viertel "
    "der Handwerker und Fischer.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({"hauptstrasse"}),
    "Die Hauptstrasse fuehrt nach Norden zum Hafengebiet und nach Sueden "
    "zum suedlichen Stadttor.");
  AddDetail( ({ "sueden", "stadttor", "suedtor"}),
    "Das Suedtor kann man von hier aus noch nicht sehen.");
  AddDetail( ({ "norden", "hafen", "hafenviertel", "hafengebiet"}),
    "Nach Norden fuehrt die Hauptstrasse ins Hafenviertel.");
  AddDetail( ({ "weg", "wege"}),
    "Wege fuehren nach Westen und Osten.");
  AddDetail( ({ "osten", "wohngebiet", "wohngebiete", "wohnviertel"}),
    "Nach Osten fuehrt ein Weg in die Wohngebiete der Stadt.");
  AddDetail( ({ "westen", "viertel", "handwerker", "fischer"}),
    "Nach Westen gibt es einen Weg in ein etwas aermeres Viertel. Dort "
    "leben die kleinen Handwerker und Fischer der Stadt.");
  AddDetail( ({ "haeuser", "gebaeude"}),
    "Der Platz ist von vielen Gebaeuden und Haeusern umgeben. Darunter sind "
    "der Gouverneurspalast im Nordosten, ein grosser Waffenladen im "
    "Nordwesten, das Grand Hotel im Suedwesten und ein voellig gelbes "
    "Gebaeude im Suedosten, das wohl die Post darstellt.");
  AddDetail( ({ "palast", "nordosten"}),
    "Der Gouverneurspalast ist wirklich praechtig. Die weisse Fassade "
    "ist mit Stuckarbeiten verziert.");
  AddDetail( ({ "fassade", "stuck", "stuckarbeit"}),
    "Die Stuckarbeit an der Fassade ist wirklich bemerkenswert. Du "
    "moechtest auch sofort Gouverneur sein, nur um so einen schoenen "
    "Palast zu besitzen.");
  AddDetail( ({ "gouverneur"}),
    "Der Gouverneur ist sicher in seinem Palast.");
  AddDetail( ({ "gouverneurspalast", "tipptoppsuperultrasonderangebot"}),
    "Dass Du so ein langes Wort ohne Fehler tippen kannst, ist schon toll.");
  AddDetail( ({ "waffenladen", "waffengeschaeft", "nordwesten", "laden",
                "geschaeft"}),
    "Der Waffenladen ist im Nordwesten. Auf einer grossen Werbetafel kannst "
    "Du die Sonderangebote sehen.");
  AddDetail( ({ "werbetafel", "tafel"}),
    "Die Werbetafel ist wirklich sehr gross und verdeckt fast den ganzen "
    "Laden. Du kannst sie lesen. (wenn Du ein paar Schritte zurueckmachst)");
  AddReadDetail( ({ "werbetafel", "tafel"}),
    "  /---------------------------------------------------------\\\n"
    " |                                                           |\n"
    " |     *           *    *       ****   ****   ****   *   *   |\n"
    " |      *         *    * *      *      *      *      **  *   |\n"
    " |       *   *   *    *****     ****   ****   ****   * * *   |\n"
    " |        * * * *    *     *    *      *      *      *  **   |\n"
    " |         *   *    *       *   *      *      ****   *   *   |\n"
    " |                                                           |\n"
    " |      DAS TIPPTOPPSUPERULTRASONDERANGEBOT DER WOCHE:       |\n"
    " |   ein Drachentoeter um laecherliche 99999 Goldmuenzen     |\n"
    " |                                                           |\n"
    "  \\---------------------------------------------------------/\n");
  AddDetail( ({ "sonderangebote", "sonderangebot", "drachentoeter"}),
    "Ein Drachentoeter fuer 99999 Goldmuenzen ist wirklich ein "
    "Sonderangebot.");
  AddDetail( ({ "suedwesten", "hotel", "grandhotel", "grand hotel", "haus"}),
    "Das Grand Hotel im Suedwesten ist ein sehr vornehmes Haus. Einen "
    "Eingang kannst Du von hier aber nicht erkennen.");
  AddDetail( ({ "eingang"}),
    "Von hier aus gibt es keinen Eingang in keines der Haeuser.");
  AddDetail( ({ "suedosten", "post", "postamt"}),
    "Das Gebaeude im Suedosten ist sicherlich die Post von Tijara. Die "
    "gelbe Farbe ist wirklich sehr auffallend.");
  AddDetail( ({ "farbe", "gelb"}),
    "Das typische, kraeftige Gelb, an dem man die Postaemter sofort "
    "erkennen kann.");
  AddDetail( ({ "postaemter"}),
    "Hier gibts nur ein Postamt, Du Scripter!");

  AddSound( ({DEFAULT_SOUND}),
    "Du hoerst das laute Plaetschern des Springbrunnens.");
  AddSound( ({"plaetschern", "brunnen", "springbrunnen", "fontaene",
              "wasser"}),
    "Der Springbrunnen gibt ein lautes Plaetschern von sich. Hauptsaechlich "
    "kommt es von der Fontaene und dem Wasser, das wieder in das Becken "
    "zurueck faellt.");
  AddSmell( ({DEFAULT_SMELL, "stadt"}),
    "Hier riecht es nach Stadt.");

  AddItem( ({NPC "gardist", NPC "gardist",NPC "gardist",NPC "gardist",
        NPC "gardist",NPC "gardist",NPC "gardist",NPC "gardist",
        NPC "gardist", NPC "garde_hauptmann"}) , REFRESH_DESTRUCT);
  AddItem( NPC "orakel" , REFRESH_DESTRUCT);
  
  AddCmd( ({"tauch", "tauche"}), "tauchen");
  AddCmd( ({"wirf", "werfe"}), "werfen");
  AddCmd( ({"trink", "trinke"}), "trinken");

  AddExit( "osten", "./platz_e5" );
  AddExit( "westen", "./platz_c5" );
  AddExit( "sueden", "./platz_d6" );
  AddExit( "norden", "./platz_d4" );
}

int tauchen(string str)
{
  notify_fail("Wohin willst Du tauchen?\n");
  if( !str ) return 0;
  if( member( ({"brunnen", "in brunnen", "springbrunnen", "in springbrunnen"
                "wasser", "in wasser", "tiefe", "in tiefe"}),str) !=-1 )
  {
    write("Du nimmst Deinen ganzen Mut zusammen und tauchst in den "
      "Brunnen.\n");
    TP->move(ROOM "kult", M_GO, "in den Brunnen und taucht hinunter",
      "springt", "kommt von oben hereingefallen");
    TP->reduce_hit_point(5);
    return 1;
  }
  return 0;
}

int werfen(string str)
{
  object ob;
  notify_fail("Was willst Du wegwerfen?\n");
  if( !str) return 0;
  if( str=="muenze in brunnen" )
  {
    if( ob=present("geld",TP) )
    {
      write("Du wirfst eine Muenze in den Brunnen und wuenschst Dir etwas.\n");
      say( CAP(TPN)+ " wirf eine Muenze in den Brunnen.\n");
      ob->SetProp(P_AMOUNT,ob->QueryProp(P_AMOUNT)-1);
      call_out("wunsch", random(10)+10);
    }
    else
      write("Aber Du hast doch gar keine Muenze!\n");
    return 1;
  }
  return 0;
}

void wunsch()
{
  TP->Message("Feyaria teilt Dir mit: Ich hoffe, dass Dein Wunsch in "
    "Erfuellung geht.\n", MSGFLAG_TELL);
}

int trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if( !str ) return 0;
  if( str=="wasser" || str=="brunnenwasser" || str=="aus brunnen" )
  {
    write("Du trinkst einen Schluck Brunnenwasser und fuehlst Dich "
          "erfrischt.\n");
    say( BS(CAP_TPN+" trinkt einen Schluck Brunnenwasser und fuehlt sich "
          "erfrischt."));
    if(heilungen>0)
    {
      heilungen--; 
      TP->heal_self(HEAL);
      TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+HEAL/3);
    }
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  heilungen=ANZAHL;
}
