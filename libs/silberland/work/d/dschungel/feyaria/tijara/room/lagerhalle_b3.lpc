// /d/dschungel/feyaria/tijara/room/lagerhalle_b3.c
// Lagerhalle in Tijara, B3
// 30-10-96  Feyaria@SilberLand
// 15 Details

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Lagerhalle in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Eine Lagerhalle in Tijara. Hier werden die Schaetze des Dschungels "
    "gelagert. Zahlreiche Lastentraeger schleppen grosse Ballen und Kisten, "
    "die hier gestapelt sind, herein und hinaus. Der einzige Ausgang fuehrt "
    "nach Norden zum Hafenweg zurueck.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "wand", "waende"}),
    "Die Waende sind von den Ballen und Kisten verdeckt.");
  AddDetail( ({ "decke"}),
    "Die Decke kannst Du nicht sehen, weil die Ballen und Kisten bis ganz "
    "nach oben gestapelt sind.");
  AddDetail( ({ "boden"}),
    "Der Boden ist voll mit Schleifspuren.");
  AddDetail( ({ "spuren", "schleifspuren"}),
    "Die Schleifspuren sind wohl von ganz schweren Kisten, die zu schwer "
    "sind, um sie zu tragen.");
  AddDetail( ({ "halle", "lagerhalle" }),
    "Das ist die Lagerhalle von Tijara.");
  AddDetail( ({ "norden", "ausgang" }), 
    "Der Ausgang fuehrt nach Norden auf den Hafenweg zurueck.");
  AddDetail( ({ "hafenweg", "weg" }),
    "Der Hafenweg ist ausserhalb der Lagerhalle.");
  AddDetail( ({ "nordosten", "osten", "suedosten", "sueden",
                "suedwesten", "westen", "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.");
  AddDetail( ({ "gueter", "handelswaren", "waren"}),
    "Die Gueter sind hauptsaechlich Handelswaren, die mit den noerdlichen "
    "Gebieten ausgetauscht werden.");
  AddDetail( ({ "kontor", "handleskontor", "kontore", "handleskontore"}),
    "Weiter im Osten liegen die Handelskontore, in denen Waren verkauft "
    "und gekauft werden, die hier gelagert werden.");
  AddDetail( ({ "lastentraeger", "traeger"}),
    "Die Lastentraeger schleppen ihre Lasten zwischen den Lagerhaeusern "
    "und den Handelskontoren hin und her.");
  AddDetail( ({"lasten"}),
    "Die Lastentraeger haben da dran ziemlich zu schleppen.");
  AddDetail( ({"ballen", "kisten"}),
    "Hier ist alles voll mit Ballen und Kisten. Sie sind bis zur Decke hin "
    "gestapelt. Eine besonders grosse Truhe faellt Dir sofort auf.");
  AddDetail( ({ "truhe"}),
    "Die Truhe ist wirklich besonders gross. Was da wohl drinnen sein "
    "wird? Du kannst Deine Neugier fast nicht beherrschen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({"schaetze", "schatz", "frucht", "fruechte", "edelholz",
               "edelhoelzer", "edelsteine", "edelstein"}),
    "Die Schaetze des Dschungels sind vor allem Fruechte, Edelhoelzer "
    "und Edelsteine.");
  
  AddSmell( ({DEFAULT_SMELL, "luft"}),
    "Die Luft riecht abgestanden.");

  AddItem( OBJ "kiste", REFRESH_DESTRUCT);
  AddItem( OBJ "ballen", REFRESH_DESTRUCT);
  AddItem( OBJ "last", REFRESH_DESTRUCT);
  AddItem( NPC "traeger", REFRESH_DESTRUCT);

  AddCmd( ({"oeffne"}), "oeffnen");
  AddCmd( ({"kletter", "klettere"}), "klettern");
  
  AddExit( "norden", "./weg_b2" );
}

int oeffnen(string str)
{
  notify_fail("Was willst Du denn oeffnen?\n");
  if( !str ) return 0;
  if( str=="truhe")
  {
    write(BS("Du oeffnest die Truhe, aber leider ist sie leer. "
             "Aber sie ist so gross, dass Du hineinklettern koenntest."));
    say( TPN+ " oeffnet eine Truhe.\n");
    return 1;
  }
  return 0;
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if( !str ) return 0;
  if( str=="truhe" || str=="in truhe" || str=="in truhe hinein")
  {
    write("Du kletterst in die Truhe, aber nichts passiert.\n");
    say( TPN+ " klettert in eine Truhe.\n");
    return 1;
  }
  return 0;
}
