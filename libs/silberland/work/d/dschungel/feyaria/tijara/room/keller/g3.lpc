// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

string det_loch();

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  KELLER_SHORT
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich im Keller unter der Villa des Gouverneurs. Der Gang "
    "fuehrt hier von Suedwesten nach Norden. Im Westen ist eine kleine "
    "Nische. Die Waende sind aus rohen Steinbloecken. Der Boden besteht aus "
    "festgestampftem Lehm. In dem duesteren Daemmerlicht kannst Du kaum mehr "
    "erkennen.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;

  AddDetail( ({"gang", "norden", "suedwesten"}),
    "Der Gang fuehrt hier von Suedwesten nach Norden.");
  AddDetail( ({"nische", "westen"}),
    "Im Westen kannst Du eine kleine Nische betreten.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind wie ueberall aus rohen Steinbloecken gefertigt. Nur an "
    "der Ostwand entdeckst Du etwas.");
  AddDetail( ({"ostwand"}),
    "In der Ostwand befindet sich knapp ueber dem Boden ein kleines Loch.");
  AddDetail( ({"loch", "funkeln", "paar", "augen"}), #'det_loch);
    
  AddCmd( ({"greif", "greife"}), "greifen");
  AddCmd( ({"stocher", "stochere"}), "stochern");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "westen", "./f3:"+getuid(this_player()) );
  AddExit( "norden", "./g2:"+getuid(this_player()) );
  AddExit( "suedwesten", "./f4:"+getuid(this_player()) );
  
  set_next_reset(2*60*60);
}

int greifen(string str)
{
  notify_fail("Wo willst Du hineingreifen?\n");
  if( !str ) return 0;
  if( str == "loch" || str == "in loch" || str == "in loch hinein")
  {
    say( CAP(TPN)+ " greift an der Wand herum.\n");
    write( BS("Du greifst in das Loch und es ist wirklich eine Ratte "
        "drinnen. Vielleicht kannst Du mit einem Stock im Loch stochern, um "
        "die Ratte herauszulocken.") );
    return 1;
  }
  return 0;
}

int stochern(string str)
{
  object ob, ob2;
  if( !(ob2=present( "\nrattenfaengerquest", TP)) ) return 0;
  notify_fail("Mit was willst Du worin stochern?\n");
  if( !str ) return 0;
  if( str == "loch" || str == "in loch")
  {
    notify_fail("Mit was willst Du in dem Loch stochern?\n");
    return 0;
  }
  if( str == "mit stock in loch" || str == "mit holzstock in loch")
  {
    if( ob=present("holzstock", TP) )
    {
      if( ob->QueryProp(P_WIELDED)==TP )
      {
        write("Du stocherst mit dem Holzstock in dem Loch herum.\n");
        say( CAP(TPN)+ " stochert mit einem Holzstock an der Wand herum.\n");
        if( ob2->check_ratte(7) )
        {
          tell_room(TO, "Eine Ratte springt erbost aus dem Loch heraus.\n");
          clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
          ob2->finde_ratte(7);
          return 1;
        }
        else
        {
          write("Leider war gar keine Ratte in dem Loch.\n");
          return 1;
        }
      }
      else
        notify_fail("Du solltest den Holzstock vorher vielleicht zuecken.\n");
    }
    else
      notify_fail("Du hast doch gar keinen Holzstock!\n");
  }
  return 0;
}    

string det_loch()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) )
  {
    if( ob->check_ratte(7) )
    { 
      return BS(
          "Aus dem Loch funkelt Dir ein Paar Augen entgegen. Ob da eine Ratte "
          "drinnensteckt?");
    }
  }
  return "Das Loch ist leer.\n";
}
