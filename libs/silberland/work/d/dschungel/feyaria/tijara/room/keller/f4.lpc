// im Keller
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  KELLER_SHORT
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich im Keller unter der Villa des Gouverneurs. Der Gang "
    "fuehrt hier von Westen nach Nordosten. Die Waende sind aus rohen "
    "Steinbloecken. Der Boden besteht aus festgestampftem Lehm. In dem "
    "duesteren Daemmerlicht kannst Du kaum mehr erkennen. Nur aus dem Westen "
    "dringt ein schwacher Lichtschein in den Gang.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;

  AddDetail( ({"gang", "nordosten"}),
    "Der Gang fuehrt von Westen nach Nordosten.");
  AddDetail( ({"westen", "treppe", "stiege", "lichtschein", "licht",
               "schein"}),
    "Dem Lichtschein nach muesste im Westen die Stiege sein, die aus diesem "
    "duesteren Kellergewoelbe wieder hinausfuehrt.");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "nordosten", "./g3:"+getuid(this_player()) );
  AddExit( "westen", "./e4:"+getuid(this_player()) );
  
  set_next_reset(2*60*60);
}
