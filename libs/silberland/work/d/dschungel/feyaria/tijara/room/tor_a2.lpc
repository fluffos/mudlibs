// /d/dschungel/feyaria/tijara/room/tor_a2.c
// Westtor von Tijara, A2
// 30-10-96  Feyaria@SilberLand
// 18 Details, 1 Sound, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Westtor von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich hier am westlichen Stadttor von Tijara. Der "
    "Hafenweg macht hier einen Knick und fuehrt von Osten nach Sueden. "
    "Nach Westen kann man durch das Tor die Stadt verlassen. Die Grenze der "
    "Stadt wird hier durch eine kleine Stadtmauer gebildet. Hier ist es "
    "etwas ruhiger als im Hafengebiet.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "westen", "stadttor", "tor", "oeffnung"}),
    "Im Westen steht ein grosses Stadttor, durch das man die Stadt "
    "verlassen kann. Es wird immer von einem Stadtgardisten bewacht. An das "
    "Tor schliesst sich eine kleine Stadtmauer an, die hier bis ins Meer "
    "hinein reicht. Das Tor ist, wie auch die Stadtmauer, aus grossen "
    "hellgrauen Steinbloecken erbaut.");
  AddDetail( ({ "stein", "steinblock", "steinbloecke", "block", "bloecke"}),
    "Die Steinbloecke sind aus hellgrauem, harten Stein, der sich ideal "
    "fuer Befestigungsbauten eignet.");
  AddDetail( ({ "befestigungen", "befestigungsbauten", "befestigung"}),
    "Zu Befestigungen zaehlt die Stadtmauer mit ihren grossen Toren.");
  AddDetail( ({ "knick"}),
    "Der Hafenweg macht hier einen richtigen Knick, man koennte auch sagen, "
    "der Hafenweg fuehrt durch das Tor und ein anderer Weg zweigt hier ab, "
    "aber das kommt auf das gleiche hinaus.");
  AddDetail( ({ "hafenweg", "weg"}),
    "Der Hafenweg geht nach Osten in Richtung Hafen, nach Westen durch das "
    "Stadttor und wird dort zum Kuestenweg und nach Sueden in die Stadt "
    "hinein.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({"kuestenweg"}),
    "Der Kuestenweg fuehrt ausserhalb des Tores nach Westen.");
  AddDetail( ({"kueste"}),
    "Die Kueste kannst Du besser ausserhalb des Tores untersuchen.");
  AddDetail( ({ "mauer", "stadtmauer"}),
    "Die Stadtmauer ist aus grossen hellgrauen Steinbloecken erbaut und ist "
    "ca. 3 Meter hoch. Oben ist sie mit spitzen Holzpfloecken bestueckt, "
    "um ein Ueberklettern zu verhindern. Sie erstreckt sich nach Norden bis "
    "ins Meer hinein und nach Sueden am Weg entlang. Nur das grosse "
    "Stadttor laesst eine Oeffnung frei, um die Stadt zu verlassen.");
  AddDetail( ({ "holz", "pfloecke", "holzpfloecke", "spitzen", "spitze"}),
    "Die Holzpfloecke sind wirklich richtig spitz.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden besteht hier aus festgestampfter Erde.");
  AddDetail( ({ "hafengebiet", "hafen", "gebiet", "osten", "boote", 
                "schiffe"}),
    "Im Osten siehst Du das Hafengebiet. Dort befinden sich die ganzen "
    "Schiffe und Boote, aber auch die Handelskontore mit den Lagerhallen.");
  AddDetail( ({"kontor", "kontore", "handelskontor", "handelskontore",
               "halle", "hallen", "lagerhalle", "lagerhallen"}),
    "Die Handelskontore und Lagerhallen befinden sich weiter im Osten.");
  AddDetail( ({ "gardist", "stadtgardist" }),
    "Es ist wohl gerade keiner da.");
  AddDetail( ({ "gardisten", "stadtgardisten", "stadtgarde"}),
    "Die Stadtgarde bewacht dieses Tor sehr sorgfaeltig.");
  AddDetail( ({ "meer"}),
    "Du kannst das Meer von hier noch sehen, aber der Blick wird durch die "
    "Stadtmauer etwas behindert. Wenn Du mehr sehen willst, musst Du weiter "
    "nach Osten in Richtung Hafen gehen.");
  AddDetail( ({ "nordwesten", "norden", "nordosten", "suedosten", 
                "suedwesten"}),
    "In diese Richtung gehts hier nicht weiter.");
  AddDetail( ({"grenze"}),
    "Die Mauer bildet die Grenze der Stadt.");
  
  AddSound( DEFAULT_SOUND,
    "Hier ist es richtig ruhig.");
  AddSmell( ({DEFAULT_SMELL, "meer" }),
    "Es riecht es nur noch schwach nach Meer.");

  AddItem( NPC "gardist2", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: ROOM "tor_a2", P_MNPC_AREA: ROOM "tor_a2"]) );

  AddExit( "westen", TIJARA_KUESTE );
  AddExit( "sueden", "./weg_a3" );
  AddExit( "osten", "./weg_b2" );
}


