// /d/dschungel/feyaria/tijara/room/weg_d3.c
// Weg in Tijara, D3
// 30-10-96  Feyaria@SilberLand
// 29 Details, 1 Sound, 4 Smells

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Die Hauptstrasse von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst mitten auf der Hauptstrasse von Tijara, die den Hafen im "
    "Norden mit dem Hauptplatz im Sueden verbindet. Auf beiden Seiten "
    "stehen grosse, weissgetuenchte Haeuser. Die Fensterbretter sind voll "
    "mit wunderbar duftenden Blumen. Hier wohnen wohl die vornehmen Buerger "
    "der Stadt.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt"}),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "pflaster", "pflastersteine", "steine"}),
    "Die hellen Pflastersteine machen einen sauberen Eindruck.");
  AddDetail( ({ "haeuser"}),
    "Die meisten Haeuser sind mit weisser Farbe getuencht und haben ein "
    "Flachdach. So soll wohl die drueckende Hitze abgewehrt werden. Die "
    "Fensterbretter der Haeuser sind mit Blumen geschmueckt.");
  AddDetail( ({ "flachdach", "dach", "angriffsflaeche"}), 
    "Ein Flachdach hat den grossen Vorteil, dass es der Sonne nicht soviel "
    "Angriffsflaeche bietet wie ein Spitzdach. Darum ist es in einem Haus "
    "mit Flachdach nicht so heiss.");
  AddDetail( ({ "spitzdach"}), 
    "Kein Haus hier hat ein Spitzdach.");
  AddDetail( ({ "strasse", "hauptstrasse"}),
    "Die Hauptstrasse fuehrt vom Hafengebiet im Norden zum Hauptplatz im "
    "Sueden.");
  AddDetail( ({ "platz", "hauptplatz", "zentrum"}),
    "Im Sueden kommt man zum Hauptplatz, dem Zentrum der Stadt. Naeheres "
    "kann man von hier noch nicht erkennen.");
  AddDetail( ({ "brett", "fensterbrett", "bretter", "fensterbretter"}),
    "Die Fensterbretter der Haeuser sind mit schoenen Blumen geschmueckt.");
  AddDetail( ({ "blume", "blumen"}),
    "Die Blumen werden hier gut gepflegt und haben daher wunderbare Blueten "
    "in allen nur denkbaren Farben.");
  AddDetail( ({ "pflege", "elfen"}),
    "Zu so einer Pflege koennen fast nur Elfen imstande sein.");
  AddDetail( ({ "buerger"}),
    "Solche schoenen Haeuser koennen sich nur wohlhabende Buerger leisten.");
  AddDetail( ({ "blueten" ,"bluete"}),
    "Du siehst Blueten in den verschiedensten Farben. Sie duften wirklich "
    "wunderbar.");
  AddDetail( ({ "farben", "farbe"}),
    "Es gibt hier wirklich Blueten in allen moeglichen Farben.");
  AddDetail( ({ "rot", "rosa", "gelb", "blau", "violett", "orange",
                "weiss", "rosa" }),
    "Es gibt Blueten in dieser Farbe.");
  AddDetail( ({ "schwarz", "braun", "grau", "schwarze blueten",
                "braune blueten", "graue blueten"}),
    "Blueten in dieser Farbe gibt es natuerlich nicht.");
  AddDetail( ({ "gruen", "gruene blueten"}),
    "Ein gruene Bluete waere ja sinnlos, die kann man ja nicht vom Rest "
    "der Pflanzen unterscheiden.");
  AddDetail( ({ "rote blueten", "rosa blueten", "gelbe blueten", 
                "blaue blueten", "violette blueten", "orangene blueten",
                "weisse blueten", "rosarote blueten"}),
    "Du staunst, was fuer verschiedenfaerbige Blueten die Blumen hier "
    "haben.");
  AddDetail( ({ "hellweisse bluete"}),
    "In dieser hellweissen Bluete liegt wohl ein Kadaver, es wird sich "
    "doch nicht etwa um eine fleischfressende Pflanze handeln?");
  AddDetail( ({ "hellweiss"}),
    "Du siehst nur eine einzige hellweisse Bluete. Scheinbar ist sie "
    "sehr selten.");
  AddDetail( ({ "kadaver"}),
    "Bei dem Kadaver handelt es sich um eine tote Ratte.");
  AddDetail( ({ "ratte"}),
    "Eine Ratte ist gerade gross genug, um von dieser Pflanze verdaut zu "
    "werden.");
  AddDetail( ({ "pflanze", "pflanzen"}),
    "Die einzigen Pflanzen, die es hier gibt, sind Blumen. Von denen gibt "
    "es dafuer jede Menge auf den Fensterbrettern.");
  AddSpecialDetail( ({ "fleischfressende pflanze"}), "fpflanze");
  AddDetail( ({ "suedwesten", "westen", "suedosten", "osten", "nordwesten",
                 "nordosten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "norden", "hafen", "hafenviertel", "hafengebiet"}),
    "Nach Norden fuehrt die Hauptstrasse ins Hafenviertel.");
  AddDetail( ({ "eindruck", "sauberkeit"}),
    "Der Eindruck taeuscht nicht, es ist wirklich alles sehr sauber.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");

  AddSound( ({DEFAULT_SOUND}),
    "Hier ist es eigentlich ziemlich ruhig.");
  AddSmell( ({DEFAULT_SMELL, "duft", "geruch"}),
    "Es riecht nach Blumen.");
  AddSmell( ({"blume", "blumen", "bluete", "blueten", "blumenduft"}),
    "Die Blumen riechen einfach wunderbar. Ein feiner Geruch nach Faeulnis "
    "laesst sich aber durch den Blumenduft nicht verdecken.");
  AddSmell( ({"faeulnis", "faeulnisgeruch", "hellweisse bluete"}),
    "Der Faeulnisgeruch kommt von einer grossen Blume mit hellweissen "
    "Blueten.");
  AddSmell( ({"ratte", "kadaver"}),
    "Ihh! Die tote Ratte stinkt wirklich.");

  AddExit( "sueden", "./platz_d4" );
  AddExit( "norden", "./hafen_d2" );
}

string fpflanze()
{
  string str;
  str= "Es handelt sich also wirklich um eine fleischfressende Pflanze. Du "
    "solltest Dir besser die hellweisse Bluete einpraegen, denn eine etwas "
    "groessere Pflanze kann sicher auch "+
    (TP->QueryProp(P_RACE)=="Fee"?"einer Fee":"einem "+TP->QueryProp(P_RACE))+
    " gefaehrlich werden.";
  return BS(str);
}
