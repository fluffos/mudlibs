#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  VORRAETE_SHORT;
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einem kleinen Vorratsraum im Keller unter der "
    "Villa des Gouverneurs, in dem viele Lebensmittel lagern. Hier gibt "
    "es Oel in Tonkruegen, gesalzenen Fisch in grossen Tonnen, getrocknete "
    "Fruechte in Steigen und Mehl in Saecken. Die Ratten haben hier am "
    "wildesten gewuetet, denn fast alles ist angeknabbert. Nach Osten "
    "fuehrt ein Gang tiefer in den Keller.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );


  KELLER_DETAILS;
  KELLER_SENSE;
  VORRAETE_DETAILS;

  AddDetail( ({"vorratsraum", "raum"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"gang", "osten"}),
    "Nach Osten fuehrt ein Gang tiefer in den Keller.");
  AddSmell( ({DEFAULT_SMELL, "luft", "keller", "gestank"}),
    "Hier stinkt es nach verfaulten Fruechten.");
  AddSmell( ({"frucht", "fruechte", "steigen", "steige"}),
    "Die verfaulten Fruechte haben sicher einige Ratten angelockt. "
    "Vielleicht findest Du eine Ratte wenn Du die Steigen umdrehst.");
  AddDetail( ({"fruechte", "frucht", "steige", "steigen"}),
    "Die Steigen haben die Ratten schon fast bis auf die letzte Frucht "
    "leergefressen. Nur noch vereinzelt liegt eine angeknabberte Frucht "
    "einsam in einer Steige. Es riecht irgendwie nach verfaulten Fruechten.");

  
  AddCmd( ({"dreh", "drehe"}), "drehen");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "osten", "./e2:"+getuid(this_player()) );

  set_next_reset(2*60*60);
}

int drehen(string str)
{
  object ob;
  if( !(ob=present( "\nrattenfaengerquest", TP)) ) return 0;
  notify_fail("Was willst Du umdrehen?\n");
  if( !str ) return 0;
  if( str == "steigen um" || str == "steige um")
  {
    say( CAP(TPN)+ " werkt an den Steigen herum.\n");
    if( ob->check_ratte(0) )
    {
      write("Du drehst die Steigen um und findest tatsaechlich eine "
            "Ratte.\n");
      tell_room(TO, "Eine Ratte springt unter einer Steige hervor.\n");
      clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
      ob->finde_ratte(0);
      return 1;
    }
    write("Leider findest Du unter keiner Steige eine Ratte.\n");
    return 1;    
  }
  return 0;
}
   
      
