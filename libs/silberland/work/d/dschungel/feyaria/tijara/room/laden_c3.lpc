// /d/dschungel/feyaria/tijara/room/laden_c3.c
// Handelskontor in Tijara, C3
// 30-10-96  Feyaria@SilberLand
// 14 Details, 1 ReadDetail

#include "../def.h"

inherit "std/laden";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include <language.h>
#include <laden.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Handelskontor von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich im Handelskontor von Tijara, in dem Waren verkauft "
    "und gekauft werden, die in den Lagerhallen gelagert werden. Vielleicht "
    "kannst Du hier auch Sachen kaufen oder verkaufen. Lastentraeger "
    "schleppen staendig Kisten und Ballen herein oder hinaus. An einer Wand "
    "haengt eine Tafel. Ein Ausgang fuehrt nach Norden auf den Hafenweg "
    "zurueck.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_HOUSE]) );
  SetStorageRoom (ROOM "store");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Friola");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SHOPKEEPER_ID, "Friola");
  
  AddDetail( ({"kontor", "handelskontor", "laden"}),
    "Du stehst mitten drin. Hier werden Waren verkauft und gekauft, die in "
    "den Lagerhallen gelagert werden. Vielleicht kannst Du dort auch Sachen "
    "kaufen oder verkaufen.");
  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({"boden", "decke", "waende", "wand"}),
    "Alles ist noch ganz kahl. Nur an einer Wand haengt eine Tafel.");
  AddDetail( ({ "norden", "ausgang" }), BS(
    "Der Ausgang fuehrt nach Norden auf den Hafenweg zurueck.") );
  AddDetail( ({ "weg", "hafenweg" }), BS(
    "Der Hafenweg ist ausserhalb des Handelskontors.") );
  AddDetail( ({ "nordosten", "osten", "suedosten", "sueden",
                "suedwesten", "westen", "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({"waffen"}),
    "Hier werden weder Waffen gekauft noch verkauft.");
  AddDetail( ({"ruestungen", "ruestung", "panzer", "helm", "ring", "amulett",
               "hose", "schuhe", "stiefel", "umhang", "handschuhe", "schild",
               "verschiedenes", "guertel", "halsband"}),
    "So etwas kann man hier kaufen.");
  AddDetail( ({ "lagerhalle", "lagerhallen", "lagerhaus", "lagerhaeuser"}),
    "In den Lagerhallen werden alle Gueter gelagert, die verschifft werden "
    "sollen. Sie befinden sich alle weiter im Westen.");
  AddDetail( ({ "gueter", "handelswaren", "waren"}),
    "Die Gueter sind hauptsaechlich Handelswaren, die mit den noerdlichen "
    "Gebieten ausgetauscht werden.");
  AddDetail( ({ "lastentraeger", "traeger"}),
    "Die Lastentraeger schleppen ihre Lasten zwischen den Lagerhaeusern "
    "und den Handeslkontoren hin und her.");
  AddDetail( ({ "ballen", "kisten", "lasten"}),
    "Die Lastentraeger haben da dran ziemlich zu schleppen.");
  AddDetail( ({"tafel"}),
    "Die Tafel haengt an einer Wand. Du kannst sie lesen.");
  AddReadDetail ( ({"tafel"}),
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<zeige> rue|ver   Uebersicht ueber Ruestungen/Verschiedenes\n"
    "<zeige> panzer|helme|umhaenge|ringe|hosen|schuhe|....  \n"
    "                  Uebersicht ueber die jeweiligen Ruestungsarten.\n"
    "<unt> nummer      Gibt die Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
    "<versetze> etwas  Du verkaufst einen Gegenstand, auch wenn Dir der\n"
    "                  Haendler nicht den vollen Preis dafuer bezahlen will.\n"
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  AddItem( OBJ "ballen", REFRESH_DESTRUCT);
  AddItem( OBJ "kiste", REFRESH_DESTRUCT);
  AddItem( OBJ "last", REFRESH_DESTRUCT);

  AddExit( "norden", "./weg_c2" );

  AddItem( NPC "friola", REFRESH_DESTRUCT);
}

varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if( ob->QueryProp(P_WC) )
  {
    write("Tut mir leid, wir kaufen hier keine Waffen.\n");
    return 1;
  }
  return ::do_sell(ob, force, prefix, limit);
}

