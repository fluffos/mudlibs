// im Kellers
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  KELLER_SHORT
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich auf einer T-Kreuzung im Kellergewoelbe der Villa des "
    "Gouverneurs von Tijara. Der Gang biegt hier von Osten nach Sueden ab. "
    "Im Westen befindet sich eine kleine Vorratskammer. Die Waende sind aus "
    "rohen Steinbloecken. Der Boden besteht aus festgestampftem Lehm. In dem "
    "duesteren Daemmerlicht kannst Du kaum mehr erkennen.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;

  AddDetail( ({"kreuzung", "tkreuzung", "t-kreuzung", "t"}),
    "Diese Kreuzung schaut aus wie ein T.");
  AddDetail( ({"gang", "osten", "sueden"}),
    "Der Gang biegt hier von Osten nach Sueden ab.");
  AddDetail( ({"vorratsraum", "raum", "vorrat", "vorraete", "kammer", 
               "vorratskammer"}),
    "Im Westen befindet sich ein kleiner Vorratsraum.");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "westen", "./d2:"+getuid(this_player()) );
  AddExit( "osten", "./f2:"+getuid(this_player()) );
  AddExit( "sueden", "./e3:"+getuid(this_player()) );
  
  set_next_reset(2*60*60);
}
