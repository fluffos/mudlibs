#include "../def.h"
#include "/d/wasser/feyaria/schiffe.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Steg in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf dem Steg von Tijara. Hier legen sowohl die grossen "
    "Segelschiffe als auch kleine Fischerboote an. Kleine Wellen schlagen an "
    "den Steg an und verursachen ein lustiges Gurgeln. Im Norden erstreckt "
    "sich das tuerkisblaue Meer bis zum Horizont. Die Sonne brennt hier "
    "ganz schoen herunter, und darum ist es hier auch sehr heiss. Matrosen, "
    "Fischer und Reisende eilen zu den Schiffen oder nach Sueden in die "
    "Stadt. Dort stehen grosse Lagerhaeuser und viele kleine, "
    "weissgetuenchte Haeuser.")+
    "Eine Tafel gibt Auskunft ueber den Schiffsverkehr.\n" );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"tafel", "schiffsverkehr", "auskunft"}),
    "Wenn Du Dich ueber den Schiffsverkehr erkundigen moechtest, lies doch "
    "einfach die Tafel.");
  AddReadDetail( "tafel",
    "    /----------------------------------------\\\n"
    "   |                                          |\n"
    "   |    SCHIFFSVERKEHR von und nach TIJARA    |\n"
    "   |    ==================================    |\n"
    "   |                                          |\n"
    "   |    Karavelle : zum Pier von Midas        |\n"
    "   |                                          |\n"
    "   |    Segelyacht : zur Felseninsel          |\n"
    "   |                     Pirateninsel         |\n"
    "   |                                          |\n"
    "   |    Handelsschiff : zum Pier von Midas    |\n"
    "   |                    nach Derlim           |\n"
    "   |                         Felseninsel      |\n"
    "   |                         Smoersky         |\n"
    "   |                                          |\n"
    "   |    Seelenverkaeufer: Zombieinsel         |\n"
    "   |                                          |\n"
    "    \\----------------------------------------/\n");
  AddDetail( ({ "tijara", "stadt" }),
    "Die Stadt Tijara befindet sich im Sueden. Du kannst schon die grossen "
    "Lagerhallen und die weissen Haeuser sehen.");
  AddDetail( ({ "sonne", "himmel", "hitze", "grund" }),
    "Die Sonne brennt erbarmunglos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "lagerhalle", "lagerhallen", "lagerhaus", "lagerhaeuser"}),
    "In den Lagerhallen werden alle Gueter gelagert, die verschifft werden "
    "sollen.");
  AddDetail( ({ "gueter", "handelswaren", "waren"}),
    "Die Gueter sind hauptsaechlich Handelswaren, die mit den noerdlichen "
    "Gebieten ausgetauscht werden.");
  AddDetail( ({ "haeuser", "haus"}), 
    "Die meisten Haeuser sind mit weisser Farbe getuencht und haben ein "
    "Flachdach. So soll wohl die drueckende Hitze abgewehrt werden. Am "
    "Hafen steht ein etwas schmuddeliges Haus, das eine Hafenkneipe sein "
    "koennte.");
  AddDetail( ({ "flachdach", "dach", "angriffsflaeche"}),
    "Ein Flachdach hat den grossen Vorteil, dass es der Sonne nicht soviel "
    "Angriffsflaeche bietet wie ein Spitzdach. Darum ist es in einem Haus "
    "mit Flachdach nicht so heiss.");
  AddDetail( ({ "spitzdach"}),
    "Kein Haus hier hat ein Spitzdach.");
  AddDetail( ({ "kneipe", "hafenkneipe"}), 
    "Obs wirklich eine Hafenkneipe ist, kann man von hier noch nicht sagen. "
    "Jedenfalls wird Dir ploetzlich bewusst, dass Du ganz irren Durst "
    "hast.");
  AddSpecialDetail( ({ "durst" }), "durst" );
  AddDetail( ({ "matrosen", "matrose", "heuer"}),
    "Die Matrosen eilen entweder wieder auf ihre Schiffe zurueck oder "
    "schlendern gemuetlich in die Stadt, um ihre Heuer zu versaufen.");
  AddDetail( ({ "fischer", "fische", "markt", "fang", "korb"}),
    "Einige Fischer machen gerade ihre Fischerboote bereit fuer den "
    "naechsten Fang, andere kommen gerade mit einem Korb voller Fische, um "
    "sie auf dem Markt zu verkaufen.");
  AddDetail( ({ "reisender", "reisende"}),
    "Du bist so ein Reisender, der nach einem Schiff Ausschau haelt. Du "
    "kannst aber auch Tijara besuchen, wenn Du nach Sueden gehst.");
  AddDetail( ({ "meer", "horizont", "blau", "tuerkisblau", "meergruen", 
                "tuerkis", "ufernaehe"}),
    "Das Meer hat in Ufernaehe eine tuerkisblaue Farbe, weiter entfernt "
    "geht sie in helles Meergruen ueber, und am Horizont siehst Du ein "
    "tiefes Blau. Diese Farbkombination ist einfach ein herrlicher "
    "Anblick.");
  AddDetail( ({ "wasser", "wellen"}),
    "Kleine Wellen schlagen an den Steg an und verursachen ein lustiges "
    "Gurgeln.");
  AddDetail( ({ "farben", "farbe"}),
    "Die Farben des Meeres sind einfach wunderbar.");
  AddDetail( ({ "farbkombination", "anblick"}),
    "Diese Farbkombination ist einfach ein herrlicher Anblick.");
  AddDetail( ({ "steg", "boden", "holzsteg"}),
    "Du stehst auf einem hoelzernen Steg, an dem die Schiffe anlegen "
    "koennen.");
  AddDetail( ({ "holz", "holzplanken", "planken"}),
    "Der Steg ist aus Holzplanken gefertigt.");
  AddDetail( ({ "schiffe", "segelschiffe", "schiff", "segelschiff", 
                "personen", "gebiete"}),
    "Die grossen Segelschiffe bringen Waren und Personen von und nach den "
    "noerdlichen Gebieten.");
  AddDetail( ({ "boote", "boot", "fischerboot", "fischerboote", "fischfang"}),
    "Mit den kleinen Fischerbooten fahren die Fischer auf Fischfang.");
  AddDetail( ({ "sueden", "hafen"}),
    "Nach Sueden kommst Du in den Hafen.");
  AddDetail( ({ "norden", "nordosten", "osten", "suedosten",
                "suedwesten", "westen", "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst ins "
    "Wasser fallen.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Gurgeln.");
  AddSound( ({"gurgeln", "wellen"}),
    "Das Gurgeln kommt von den kleinen Wellen, die an den Steg anschlagen.");
  AddSmell( DEFAULT_SMELL,
    "Hier hat es einen typischen Hafengeruch.");
  AddSmell( ({"hafen", "hafengeruch", "geruch"}),
    "Dieser Hafen riecht wie jeder andere Hafen auch.");

  AddCmd( ({"schubse", "schubs"}), "stossen");

  AddExit( "sueden", "./hafen_d2" );

  AddItem( OBJ"fischerboot", REFRESH_DESTRUCT, 1);
  AddItem( YACHT, REFRESH_DESTRUCT, 1);
  AddItem( HANDELSSCHIFF, REFRESH_DESTRUCT, 1);
  AddItem( KARAVELLE, REFRESH_DESTRUCT, 1);
  AddItem("d/wasser/dante/zinsel/room/zschiff", REFRESH_DESTRUCT, 1);


}

int stossen(string str)
{
  object ob, ob2;
  if( !(ob2=present("\nrattenfaengerquest", TP))) return 0;
  notify_fail("Wen willst Du wohin schubsen?\n");
  if( !str ) return 0;
  if( str=="ratte meer" || str == "ratte in meer" )
  {
    if( ob=present("ratte") )
    {
      write("Du stoesst eine Ratte ins Meer.\n");
      say( CAP(TPN)+ " stoesst eine Ratte ins Meer.\n");
      tell_room(TO, "Die Ratte ersaeuft jaemmerlich im Meer.\n");
      TP->RemovePursuer(ob);
      ob->remove();
      call_other(ob2, "versenke_ratte");
      return 1;
    }
  }
  return 0;
}

string durst()
{
  int drink, max_drink;
  string str;
  max_drink = TP->QueryProp(P_MAX_DRINK);
  drink = TP->QueryProp(P_DRINK);
  drink=drink*100/max_drink;
  if (drink < 10)
    str="Deine Kehle ist richtig ausgedoerrt.\n";
  else if (drink < 40) 
    str="Du bist sehr durstig.\n";
  else if (drink < 80) 
    str="Dein Durst haelt sich in Grenzen.\n";
  else  
    str="Du hast zwar nicht viel Durst, aber ein kleiner Tropfen kann nie "
        "schaden.\n";
  return str;
}

