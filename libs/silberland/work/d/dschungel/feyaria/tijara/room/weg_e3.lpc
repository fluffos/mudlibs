// /d/dschungel/feyaria/tijara/room/weg_e3.c
// Gasse in Tijara, E3
// 30-10-96  Feyaria@SilberLand
// 18 Details, 1 Sound, 1 Smell, 2 Commands

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Gasse in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst in einer schmalen Gasse, die das Hafenviertel mit dem "
    "Wohnviertel verbindet. Im Nordosten befindet sich das Stadttor, durch "
    "das man die Stadt verlassen kann. Im Norden steht ein etwas "
    "schmuddeliges Haus, das wohl eine Hafenkneipe sein soll. Die anderen "
    "Haeuser machen aber einen recht ordentlichen Eindruck, denn sie haben "
    "alle eine saubere, weisse Fassade. ") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt"}),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden ist aus festgestampfter Erde.");
  AddDetail( ({ "gasse"}),
    "Die Gasse fuehrt vom Hafenviertel im Nordwesten zum Wohngebiet im "
    "Osten. Nach Nordosten zweigt der Weg zum Stadttor ab.");
  AddDetail( ({ "weg", "stadttor", "nordosten", "abzweigung", "tor"}),
    "Nach Nordosten fuehrt ein Weg zum Stadttor und durch dieses hindurch "
    "zur Kueste.");
  AddDetail( ({ "kueste"}),
    "Um die Kueste genauer zu untersuchen, musst Du schon naeher rangehen.");
  AddDetail( ({ "haeuser"}),
    "Die meisten Haeuser sind mit weisser Farbe getuencht und haben ein "
    "Flachdach. So soll wohl die drueckende Hitze abgewehrt werden. Im "
    "Norden steht ein etwas schmuddeliges Haus, das wie eine Hafenkneipe "
    "aussieht.");
  AddDetail( ({"farbe", "weiss", "fassade", "fassaden"}),
    "Die Fassaden der Haeuser haben eine schoene weisse Farbe.");
  AddDetail( ({ "flachdach", "dach", "angriffsflaeche"}), 
    "Ein Flachdach hat den grossen Vorteil, dass es der Sonne nicht soviel "
    "Angriffsflaeche bietet wie ein Spitzdach. Darum ist es in einem Haus "
    "mit Flachdach nicht so heiss.");
  AddDetail( ({ "spitzdach"}), 
    "Kein Haus hier hat ein Spitzdach.");
  AddDetail( ({ "kneipe", "hafenkneipe", "haus", "norden"}),
    "Die Hafenkneipe ist etwas heruntergekommen. Alle anderen Haeuser haben "
    "eine schoene weisse Farbe, die Kneipe dagegen ist schon mehr grau. "
    "Der Eingang scheint sich aber an einer anderen Stelle zu befinden.");
  AddDetail( ({ "suedwesten", "sueden", "westen", "suedosten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "osten", "wohngebiete", "wohngebiet", "wohnviertel"}),
    "Nach Osten fuehrt die Gasse in die Wohngebiete von Tijara.");
  AddDetail( ({ "nordwesten", "hafen", "hafenviertel"}),
    "Nach Nordwesten fuehrt die Gasse ins Hafenviertel.");
  AddDetail( ({ "eindruck"}),
    "Alles macht hier einen guten Eindruck, es riecht nur etwas komisch.");
  AddDetail( ({ "unrat", "ecke"}),
    "In einer Ecke entdeckst Du wirklich einen Haufen Unrat.");
  AddDetail( ({ "haufen"}),
    "Der Haufen ist relativ hoch. Du wunderst Dich, warum Du ihn vorher "
    "uebersehen hast. Irgendetwas kommt Dir an dem Haufen komisch vor, "
    "Vielleicht solltest Du ihn genauer durchsuchen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");

  AddSound( ({DEFAULT_SOUND, "laerm", "kneipe"}),
    "Du hoerst Laerm aus der Kneipe.");
  AddSmell( ({DEFAULT_SMELL,"unrat"}),
    "Es riecht hier nach Unrat.");

  AddCmd( ({"suche", "durchsuche", "such", "durchsuch"}), "suchen");
  AddCmd( ({"wuehle", "durchwuehle"}), "wuehlen");

  AddExit( "osten", "./wohn_f3" );
  AddExit( "nordwesten", "./hafen_d2" );
  AddExit( "nordosten", "./tor_f2" );
}

int suchen(string str)
{
  notify_fail("Was willst Du durchsuchen?\n");
  if (!str) return 0;
  if (str=="haufen" || str=="unrat" || str=="in haufen" || str=="in unrat"  )
  {
    write( BS("Du suchst und findest viel Unrat auf dem Haufen. Vielleicht "
      "solltest Du Dich tiefer in den Haufen hineinwuehlen.") );
    say( TPN+ " sucht in einer Ecke herum.\n");
    return 1;
  }
  return 0;
}

int wuehlen(string str)
{
  notify_fail ("Worin willst Du wuehlen?\n");
  if (!str) return 0;   
  if (str=="in haufen" || str=="haufen" || str=="in unrat" || str=="unrat" 
      || str=="in haufen hinein" || str=="in unrat hinein" ||
      str == "tiefer in haufen" || str == "tiefer in haufen hinein" )
  {
    write_file(LOG "zt",
      ctime()+": "+ TPN+ " findet den ZT in weg_e3.c\n");
    if (TP->FindPotion( BS(
       "Du durchwuehlst den ganzen Haufen und findest ein Flaeschchen "
       "Zaubertrank im Haufen, das Du sofort austrinkst.")))
    {
      say( TPN+" durchwuehlt einen Haufen Unrat.\n");
      return 1;
    }
    write( "Du durchwuehlst den ganzen Haufen, findest aber nur Unrat.\n");
    say( TPN+" durchwuehlt einen Haufen Unrat.\n");
    return 1;
  }
  return 0;
}
