// /players/feyaria/sleproom.c Feyarias Schlafzimmer
// 08-04-1996 
// 13-08-1996 ueberarbeitet
// 1997-03-20 in Tiajra angeschlossen

inherit "std/room";

#include "../def.h"

void create()
{

  ::create();

  SetProp( P_INT_SHORT, "Das Schlafzimmer von Feyaria");
  SetProp( P_INT_LONG, BS(
    "Das ist das Schlafzimmer von Feyaria. Hier ruht sie sich von ihrer "
    "anstrengenden Arbeit aus. Das Auffallendste in diesem Zimmer ist das "
    "grosse Himmelbett, das fast die Haelfte des Raumes einnimmt. Daneben "
    "steht ein kleines Nachtkaestchen mit einer kleinen Lampe. Am Boden "
    "liegt ein wertvoller Perserteppich. Die Waende sind mit Gemaelden "
    "geschmueckt, die Feyaria bei ihren Heldentaten als Spielerin zeigen.")
   +"Eine Tuer fuehrt zurueck ins Arbeitszimmer.\n");
  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( "boden",
    "Am Boden liegt ein wertvoller Perserteppich. Er hat ein wunderschoenes, "
    "rot-blaues Muster aus verschlungenen Linien, Spiralen und kleinen "
    "Tierdarstellungen. ");
  AddDetail( ({"teppich","perserteppich"}),
    "Du wunderst Dich, wo dieser schoene Teppich herkommt, denn im "
    "SilberLand gibt es ja gar keine Perser! Obwohl die Herkunft also etwas "
    "schleierhaft ist, musst Du den Teppich einfach bewundern.");
  AddDetail( ({"herkunft", "perser", "persien", "teppichland"}),
    "Die Herkunft dieses Teppichs ist nicht leicht zu erklaeren. Ob Feyaria "
    "ihn nun aus Persien oder aus dem Teppichland hat, oder ob sie ihn "
    "mit ihren magischen Kraeften aus einer anderen Dimension herbei "
    "gezaubert hat, laesst sich nicht feststellen. Ganz sicher hingegen ist, "
    "dass Du auch gerne solch einen Teppich bei Dir zuhause haettest, "
    "um seine Schoenheit jeden Tag bewundern zu koennen.");
  AddDetail( "schoenheit",
    "Alles in diesem Raum ist einfach schoen. Schau Dich ruhig etwas "
    "naeher um.");
  AddDetail( "muster",
    "Das Muster des Teppichs ist wirklich herrlich. Der Teppichknuepfer "
    "muss sich wirklich alle Muehe gegeben haben, um so eine Vollkommenheit "
    "zu erreichen. Die Kombination der roten und blauen Farbe mit den "
    "Linien und Spiralen macht einen aesthetischen Eindruck.");
  AddDetail( ({"kombination", "aesthetik", "eindruck", "harmonie",
               "detailtreue"}),
    "Ist der Teppich nicht wunderschoen! Bleib ruhig noch etwas da und "
    "bewundere ihn.");
  AddDetail( ({"farbe", "farben"}),
    "Die Wahl der Farben ist sehr gut gelungen. Das Rot und das Blau "
    "harmonieren wirklich sehr gut miteinander.");
  AddDetail( "rot",
    "Ein Rot so schoen wie die Lippen wie von Feyaria.");
  AddDetail( "blau",
    "Ein Blau so schoen wie die Augen von Feyaria.");
  AddDetail( ({"spiralen", "linien", "figuren"}),
    "Die geometrischen Figuren praegen den groessten Teil des Teppichs. "
    "Durch den Wechsel der Farben kann man aber dazwischen immer wieder "
    "kleine Tierdarstellungen finden.");
  AddDetail( ({"darstellungen", "tierdarstellungen", "tier", "tiere"}),
    "Bei den Tierdarstellungen handelt es sich hauptsaechlich um kleine "
    "Hasen, Rehe und Singvoegel. Aber man kann auch einige maechtige "
    "Raubkatzen darunter erkennen.");
  AddDetail( ({"hasen", "hase"}),
    "Die Hasen scheinen fast auf dem Teppich hinundher zu hoppeln, so "
    "echt sind sie gearbeitet. Hasen findet Feyaria einfach suess. "
    "Einen speziellen Hasen mag sie besonders gern.");
  AddDetail( "osterhase",
    "Richtig! Der Osterhase ist ein guter Freund von Feyaria.");
  AddDetail( ({"reh", "rehe"}),
    "Die Rehe sind naturgetraeu abgebildet. Sie schauen Dich mit ihren "
    "grossen Rehaugen richtiggehend an. Rehe mag Feyaria auch sehr gern. "
    "Sie bewundert vor allem ihre schnellen und grazilen Bewegungen.");
  AddDetail( "rehaugen"
    "Nur die Augen von Feyaria sind noch schoener zu bewundern.");
  AddDetail( ({"singvoegel", "singvogel", "vogel", "voegel"}),
    "Die Singvoegel fallen hauptsaechlich durch ihr buntes Federkleid auf. "
    "Es ist schon fantastisch, welche Detailtreue in diesem Teppich liegt.");
  AddDetail( ({"federkleid", "federn", "feder"}),
    "Obwohl die Voegel schon sehr winzig sind, kannst Du trotzdem die "
    "Federn genau erkennen. Der Teppichknuepfer muss wahrlich ein Meister "
    "seiner Kunst sein.");
  AddDetail( ({"teppichknuepfer", "knuepfer"}),
    "Hier ist der Teppichknuepfer sicher nicht, weil sonst muesste er fuer "
    "jeden Besucher auch solch einen wunderbaren Teppich knuepfen, und das "
    "waere dann sicher zuviel Arbeit.");
  AddDetail( ({"raubkatzen", "katzen", "loewen", "tiger", "leoparden", 
               "raubkatze", "katze", "loewe", "leopard", "jaguar", "jaguare",
               "panther"}),
    "Die Raubkatzen sind auch hervorragend dargestellt. Es handelt sich "
    "dabei um Tiger, Loewen, Leoparden, Panther und Jaguare.");

  AddDetail( ({"wand","waende","gemaelde","bilder", "bild"}),
    "An den Waenden haengen Bilder von Feyaria, die sie bei ihren "
    "Heldentaten als Spielerin zeigen.");
  AddDetail( ({"heldentaten", "taten"}),
    "Eine der Heldentaten von Feyaria war es, als erste den Seherstatus "
    "im SilberLand zu erreichen. Sie war auch lange die Oberseherin des "
    "SilberLandes, bis sie dann doch Magierin wurde.");
  AddDetail( ({"decke", "himmel", "sternenhimmel"}),
    "Die Decke ist schwarz bemalt und mit vielen kleinen Sternen verziert. "
    "Fast koennte man glauben, man sieht den Sternenhimmel.");
  AddDetail( ({"stern", "sterne"}),
    "Die Sterne leuchten in einem schwachen, silbrigen Licht und geben dem "
    "Zimmer ein romantisches Flair.");
  AddDetail( ({"schlafzimmer","zimmer", "raum"}),
    "Du stehst in Feyarias Schlafzimmer.");
  AddDetail( ({"bett","himmelbett"}), 
    "Ein wunderschoenes Himmelbett mit himmelblauen Vorhaengen. Da drinnen "
    "schlaeft Feyaria. Im Bett siehst Du einen Berg von Kissen und Polstern.");
  AddDetail( ({"vorhang", "vorhaenge"}),
    "Die himmelblauen Vorhaenge haengen vor dem Himmelbett.");
  AddDetail( ({"kissen","polster"}),
    "Das sind schoene, weiche Kissen, ideal um darauf seinen Kopf zu betten.");
  AddDetail( "berg",
    "Die Kissen und Polster sind zu einem grossen Berg gestapelt.");
  AddDetail( ({"nachtkaestchen","kaestchen"}),
    "Ein ganz normales Nachtkaestchen, auf dem eine kleine Lampe steht.");
  AddDetail( "kasten",
    "Naja, fuer einen Kasten ist das Nachtkaestchen zu klein!");
  AddDetail( "lampe",
    "Die kleine Lampe verbreitet ein heimeliges, schummriges Licht.");
  AddDetail( "licht",
    "Das Licht ist nicht gerade hell, aber fuer ein Schlafzimmer gerade "
    "richtig. Es kommt zum Teil von der Decke und zum Teil von der Lampe "
    "auf dem Nachtkaestchen.");
  AddDetail( "tuer",
    "Diese Tuer fuehrt nach nebenan ins Arbeitszimmer.");
  AddDetail( "arbeitszimmer",
    "Nach nebenan kannst Du ins Arbeitszimmer gelangen. Wenn Du mehr davon "
    "sehen willst, dann musst Du schon dorthin gehen.");
  AddDetail( ({"arbeit", "augen", "besucher", "bewegungen", "dimension",
        "flair", "haelfte", "kraeften", "kunst", "lippen", "auffallendste",
        "meister", "muehe", "rehaugen", "seherstatus", "silberland", "kopf", 
        "spielerin", "tag", "teil", "vollkommenheit", "wahl", "wechsel"}),
      "Bevor Du hier zu sehr herumschnueffelst, solltest Du lieber Feyarias "
      "Privatsphaere respektieren.\n");
  AddSpecialDetail( ({"privatsphaere"}), "privat");
  AddDetail( ({"magierin", "feyaria", "oberseherin" }),
      "Wenn Feyaria nicht hier ist, wird sie wohl arbeiten....");
  AddDetail( ({"ausbeulung"}),
      "Unter den Teppich ist eine Ausbeulung. Sieht fast so aus, als ob da "
      "eine Falltuer nach unten gehen wuerde.");
  AddDetail( ({"falltuer"}),
      "Ueber die Falltuer, die unter dem Teppich versteckt ist, kann man nach "
      "unten gehn.");

  AddSound( DEFAULT_SOUND,
      "Es ist angenehm ruhig hier.");
  AddSmell(DEFAULT_SMELL,
      "Es riecht angenehm hier. "); 

  AddCmd( ({"bewunder", "bewundere"}),"bewunder");

  AddExit("nebenan","nach nebenan#./hinten");
  SetProp(P_HIDE_EXITS, ({"unten"}) );
}

int bewunder(string str)
{
  if (str == "teppich" || str == "perserteppich")
    write("Du bewunderst den Teppich, dabei faellt Dir eine Ausbeulung im "
        "Teppich auf.\n");
  else
    write("Du bewunderst Feyarias Schlafzimmer.\n");
  say( CAP(TPN)+" bewundert Feyarias Schlazimmer.\n");
  return 1;
}

string privat()
{
  TP->move( ROOM "hinten", M_GO);
  return "Du respektierst Feyarias Privatsphaere.\n";
}
