// /d/dschungel/feyaria/tijara/room/tor_d7.c
// Suedtor von Tijara, D7
// 30-10-96  Feyaria@SilberLand
// 25 Details, 1 Sound, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Suedtor von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich hier am suedlichen Stadttor von Tijara. Die "
    "Hauptstrasse fuehrt hier vom Hauptplatz im Norden durch das Tor im "
    "Sueden in den Dschungel. Neben dem Tor schmiegen sich zwei Haeuser "
    "an die Stadtmauer an. Im Westen ist das Haus eines Trophaeensammlers, "
    "wie man an den vielen Tierkoepfen und ausgestopften Voegeln erkennen "
    "kann, die an der Hauswand angebracht sind. Im Osten ist die "
    "Stadtwache untergebracht, der Stuetzpunkt der Stadtgardisten.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "sueden", "stadttor", "tor", "oeffnung"}),
    "Im Sueden steht ein grosses Stadttor, durch das man die Stadt "
    "verlassen kann. Es wird immer von einem Stadtgardisten bewacht. An das "
    "Tor schliesst sich eine kleine Stadtmauer an, die rund um die Stadt "
    "laeuft. Das Tor ist, wie auch die Stadtmauer, aus grossen hellgrauen "
    "Steinbloecken erbaut.");
  AddDetail( ({ "stein", "steinblock", "steinbloecke", "block", "bloecke"}),
    "Die Steinbloecke sind aus hellgrauem, harten Stein, der sich ideal "
    "fuer Befestigungsbauten eignet.");
  AddDetail( ({ "befestigungen", "befestigungsbauten", "befestigung"}),
    "Zu Befestigungen zaehlt die Stadtmauer mit ihren grossen Toren.");
  AddDetail( ({ "mauer", "stadtmauer"}),
    "Die Stadtmauer ist aus grossen hellgrauen Steinbloecken erbaut und ist "
    "ca. 3 Meter hoch. Oben ist sie mit spitzen Holzpfloecken bestueckt, "
    "um ein Ueberklettern zu verhindern. Sie laeuft rund um die Stadt "
    "herum. Nur das grosse Stadttor laesst eine Oeffnung frei, um die Stadt "
    "zu verlassen.");
  AddDetail( ({ "holz", "pfloecke", "holzpfloecke", "spitzen", "spitze"}),
    "Die Holzpfloecke sind wirklich richtig spitz.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden besteht hier aus festgestampfter Erde.");
  AddDetail( ({ "gardist", "stadtgardist" }),
    "Es ist wohl gerade keiner da.");
  AddDetail( ({ "gardisten", "stadtgardisten", "stadtgarde"}),
    "Die Stadtgarde bewacht dieses Tor sehr sorgfaeltig. Ihr Stuetzpunkt "
    "ist im Osten.");
  AddDetail( ({ "osten", "stuetzpunkt", "stadtwache", "wache", "patroullien"}),
    "Die Stadtwache ist der Stuetzpunkt der Stadtgarde. Dort haben sie ihre "
    "Waffenreserven und erholen sich von den anstrengenden Patroullien. "
    "Im Osten kannst Du sie betreten.");
  AddDetail( ({ "waffen", "waffenreserven"}),
    "Die Waffen sind fuer die Stadtgardisten und nicht fuer Dich!");
  AddDetail( ({"haeuser"}),
    "Es gibt hier zwei Haeuser, welches meinst Du?");
  AddDetail( ({ "westen", "trophaeensammler", "sammler", "haus"}),
    "Das Haus im Westen scheint einem Trophaeensammler zu gehoeren, denn "
    "die Hauswand ist mit vielen Tierkoepfen und ausgestopften Voegeln "
    "geschmueckt.");
  AddDetail( ({ "tierkoepfe", "koepfe", "voegel", "tiere", "vogel"}),
    "Wenn Du sie naeher betrachten willst, ist es wohl besser, ins Haus "
    "des Trophaeensammlers zu gehen. Nur ein Tierkopf faellt Dir besonders "
    "auf.");
  AddDetail( ({ "tierkopf", "kopf"}),
    "Ein Tierkopf ist besonders interessant. Es handelt sich dabei um "
    "den Kopf einer grossen Raubkatze.");
  AddDetail( ({ "raubkatze", "katze"}),
    "Sei froh, dass hier nur der ausgestopfte Kopf der Raubkatze ist und "
    "nicht die gefaehrliche Katze selber.");
  AddDetail( ({ "raubkatzenkopf", "katzenkopf"}),
    "Der Raubkatzenkopf ist wirklich sehr interessant. Besonders die langen "
    "Fangzaehne jagen Dir Angst ein.");
  AddDetail( ({ "fangzaehne", "zaehne", "angst"}),
    "Wenn Du diesen Zaehnen einmal wirklich begegnest, solltest Du "
    "wirklich Angst haben. Sie gehoeren naemlich dem gefleckten "
    "Dschungeltiger, der gefaehrlichsten Raubkatze im ganzen SilberLand.");
  AddDetail( ({ "dschungeltiger"}),
    "Der Dschungeltiger ist wirklich die gefaehrlichste Raubkatze im "
    "ganzen SilberLand.");
  AddDetail( ({ "tiger", "jaguar"}),
    "Du hast schon einmal gehoert, dass es solche Raubkatzen im Dschungel "
    "geben soll.");
  AddDetail( ({ "silberland"}),
    "Das SilberLand ist diese Welt. Aber das weisst Du doch, oder etwa "
    "nicht?");
  AddDetail( ({ "hauswand", "wand", "trophaeen"}),
    "Die Hauswand ist voll mit Trophaeen.");
  AddDetail( ({ "nordwesten", "nordosten", "suedosten", "suedwesten"}),
    "In diese Richtung gehts hier nicht weiter.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({"norden", "hauptplatz", "hauptstrasse"}),
    "Nach Norden fuehrt die Haupstrasse auf den Hauptplatz.");
  AddDetail( ({ "dschungel", "wildnis"}),
    "Der Dschungel ist ausserhalb des Tores. Um ihn naeher zu erforschen "
    "musst Du schon durch das Tor nach Sueden gehen.");


  AddSound( DEFAULT_SOUND,
    "Hier ist es richtig ruhig.");
  AddSmell( ({DEFAULT_SMELL, "dschungel" }),
    "Durch das Tor kann man schon den Dschungel riechen.");

  AddItem( NPC "gardist2", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: ROOM "tor_d7", P_MNPC_AREA: ROOM "tor_d7"]) );

  AddExit( "sueden", TIJARA_WEG);
  AddExit( "norden", "./platz_d6" );
  AddExit( "osten", "./wache_e7" );
  AddExit( "westen", "./sammler_c7" );
}

