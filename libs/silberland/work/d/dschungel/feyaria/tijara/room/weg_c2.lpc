// /d/dschungel/feyaria/tijara/room/weg_c2.c
// Hafenweg von Tijara, C2
// 30-10-96  Feyaria@SilberLand
// 21 Details, 2 Sounds, 1 Smells

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Hafenweg in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Der Hafenweg von Tijara fuehrt, wie der Name vermuten laesst, am "
    "Hafen entlang. Im Norden schuetzt die Kaimauer vor der Brandung des "
    "Meeres. Im Sueden kann man einen grossen Handelskontor betreten. "
    "Der Hafenweg fuehrt vom Hafen im Osten zu den grossen Lagerhaeusern "
    "im Westen. Zahlreiche Lastentraeger schleppen grosse Ballen und "
    "Kisten zwischen dem Kontor und den Lagerhallen hin und her.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "hitze" }),
    "Die bruetende Hitze wird durch ein kuehles Lueftchen vom Meer her "
    "etwas gelindert. Trotzdem schwitzt Du ziemlich.");
  AddDetail( ({ "lueftchen", "wind" }),
    "Das bisschen Wind vom Meer macht die Hitze gerade noch ertraeglich." );
  AddDetail( ({ "boden", "stein", "steinplatten", "platten"}),
    "Der Boden ist aus harten Steinplatten gefertigt.");
  AddDetail( ({ "lagerhalle", "lagerhallen", "lagerhaus", "lagerhaeuser"}),
    "In den Lagerhallen werden alle Gueter gelagert, die verschifft werden "
    "sollen. Sie befinden sich alle weiter im Westen.");
  AddDetail( ({ "gueter", "handelswaren", "waren"}),
    "Die Gueter sind hauptsaechlich Handelswaren, die mit den noerdlichen "
    "Gebieten ausgetauscht werden.");
  AddDetail( ({ "meer", "horizont"}),
    "Das Meer hat in Ufernaehe eine tuerkisblaue Farbe, weiter entfernt "
    "geht sie in helles Meergruen ueber, und am Horizont siehst Du ein "
    "tiefes Blau. Diese Farbkombination ist einfach ein herrlicher "
    "Anblick.");
  AddDetail( ({ "wasser", "wellen"}),
    "Die Wellen schlagen heftig gegen die Kaimauer.");
  AddDetail( ({ "farben", "farbe"}), 
    "Die Farben des Meeres sind einfach wunderbar.");
  AddDetail( ({ "farbkombination", "anblick"}),
    "Diese Farbkombination ist einfach ein herrlicher Anblick.");
  AddDetail( ({ "hafenweg", "weg", "hafen"}),
    "Der Hafenweg fuehrt vom Hafen im Osten zu den Lagerhaeusern im "
    "Westen.");
  AddDetail( ({ "kontor", "handelskontor", "kontore", "handelskontore",
                "sueden", "sachen"}),
    "Im Sueden liegt ein grosser Handelskontor, in dem Waren verkauft "
    "und gekauft werden, die in den Lagerhallen gelagert werden. "
    "Vielleicht kannst Du dort auch Sachen kaufen oder verkaufen.");
  AddDetail( ({ "lastentraeger", "traeger"}),
    "Die Lastentraeger schleppen ihre Lasten zwischen den Lagerhaeusern "
    "und den Handelskontoren hin und her.");
  AddDetail( ({ "ballen", "kisten", "lasten"}),
    "Die Lastentraeger haben da dran ziemlich zu schleppen.");
  AddDetail( ({ "kaimauer", "brandung", "mauer" }),
    "Die Kaimauer bildet einen kuenstlichen Schutz gegen die Brandung "
    "des Meeres.");
  AddDetail( ({ "osten", "hafen"}),
    "Nach Osten fuehrt der Hafenweg zum Hafen.");
  AddDetail( ({ "westen"}),
    "Nach Westen gehts zu den grossen Lagerhallen.");
  AddDetail( ({ "nordosten", "norden", "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst ins "
    "Wasser springen.");
  AddDetail( ({ "suedwesten", "suedosten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein Stimmengewirr.");
  AddSound( ({"stimmen", "stimmengewirr"}), 
    "Du kannst keine einzelne Stimme aus dem Stimmengewirr verstehen.");
  AddSmell( ({DEFAULT_SMELL, "meer" }),
    "Es riecht hier noch ziemlich stark nach Meer.");

  AddExit( "westen", "./weg_b2" );
  AddExit( "sueden", "./laden_c3" );
  AddExit( "osten", "./hafen_d2" );
}
