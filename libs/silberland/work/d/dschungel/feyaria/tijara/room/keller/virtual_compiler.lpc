// Virtual Complier fuer Rattenquest
// Feyaria@SilberLand

inherit "std/virtual/v_compiler";

#include "../def.h"
#include <v_compiler.h>

#define P_VALID_NAME "valid_name"

void create()
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "/keller" );
  SetProp(P_STD_OBJECT, ROOM "/keller/d2");
  SetProp(P_VALID_NAME, ({"d2","d4","d5","d6", "e2", "e3", "e4", "e5", "e6",
        "f2","f3","f4","f5","f6","g2", "g3"}) );
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      (who==lower_case(who)))
  {
    SetProp(P_STD_OBJECT, ROOM+"/keller/"+name );
    return file;
  }
}


int CustomizeObject()
{
  string name,foo, who;

  name = ::CustomizeObject();
  if (!name || (sscanf(name,"%s:%s",foo,who)!=2))
    return 0;
  return 1;
}

