// im Weinkeller
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

string det_in_fass();
string det_schwanz();

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  WEIN_SHORT
  SetProp( P_INT_LONG, BS(
    "Du stehst im Nordosteck des Weinkellers. Hier lagert der Gouverneur "
    "von Tijara seinen Wein, denn ueberall stehen Weinfaesser und Regale mit "
    "Weinflaschen herum. Bei einem Weinfass fehlt der Deckel.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  WEIN_DETAILS;

  AddDetail( ({"deckel"}),
    "Bei einem Weinfass fehlt der Deckel.");
  AddDetail( ({"fass", "weinfass"}),
    "Bei diesem Weinfass fehlt der Deckel. Deshalb kannst Du in das Fass "
    "hinein schauen.");
  AddDetail( ({"fass hinein", "weinfass hinein"}), #'det_in_fass);
  AddDetail( ({"schwanz", "spitze"}), #'det_schwanz);
  AddDetail( ({"eck", "nordost", "nordosteck"}),
    "Natuerlich ist das das Nordosteck, weil Du ja nach Westen, Sueden und "
    "Suedwesten gehen kannst.");

  AddCmd( ({"oeffne", "trink", "trinke", "nimm"}), "wein");
  AddCmd( ({"zieh", "ziehe"}), "ziehen");
  AddCmd( ({"fass", "fasse", "greif", "greife"}), "fassen");

  AddExit( "suedwesten", "./e6:"+getuid(this_player()) );
  AddExit( "westen", "./e5:"+getuid(this_player()) );
  AddExit( "sueden", "./f6:"+getuid(this_player()) );
}

WEIN_STEHLEN

int ziehen(string str)
{
  string s1, s2, dummy;
  object ob;
  if( !(ob=present( "\nrattenfaengerquest", TP)) ) return 0;
  notify_fail("Wen willst Du an was aus was herausziehen?\n");
  if( !str ) return 0;
  if( sscanf( str, "ratte %s aus %s heraus", s1, s2)==2 ||
      sscanf( str, "ratte %s aus %s", s1, s2)==2 )
  {
    if( (s1 == "an schwanz" || s1 == "an schwanzspitze" || s1 == "am schwanz" )
       && ( s2 == "wein" || s2 == "weinfass" || s2 == "fass") )
    {
      say( CAP(TPN)+ " greift in ein Weinfass.\n");
      if( ob->check_ratte(5) )
      {
        write("Du ziehst die Ratte am Schwanz aus dem Weinfass heraus.\n");
        tell_room(TO, "Eine Ratte springt aus dem Fass heraus.\n");
        clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
        ob->finde_ratte(5);
        return 1;
      }
      write("Da ist ja gar keine Ratte im Fass!\n");
      return 1;
    }
    notify_fail("Woraus willst Du die Ratte ziehen?\n");
  }
  if( str[0..4]=="ratte")
    notify_fail("Wie willst Du die Ratte ziehen?\n");
  if( str[0..8]=="ratte aus" )
    notify_fail("An was willst Du die Ratte herausziehen?\n");
  if( str[0..6]=="schwanz" || str[0..9]=="an schwanz" )
    notify_fail("Wen willst Du am Schwanz ziehen?\n");
  if( str[0..15]=="ratte an schwanz")
    notify_fail("Woraus willst Du die Ratte am Schwanz heraus ziehen?\n");
  return 0;
}

int fassen(string str)
{
  notify_fail("Wo willst Du heinfassen?\n");
  if(!str) return 0;
  if( str=="fass" || str=="in fass" || str=="in fass hinein" || 
      str=="fass hinein" )
  {
    say( CAP(TPN) + " fasst in das Fass.\n");
    if( 1 )
      write( BS("Du greifst in das Fass und spuerst den Schwanz einer Ratte. "
        "Vielleicht kannst Du die Ratte ja am Schwanz aus dem Fass heraus "
        "ziehen."));
    else
      write("Du fasst in das Weinfass.\n");
    return 1;
  }
  return 0;
}

string det_in_fass()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) ) 
  {
    if( ob->check_ratte(5) )
    {
      return BS(
          "Im Wein schwimmt scheinbar eine Ratte, denn die Spitze ihres Schwanzes "
          "schaut aus dem Wein heraus.");
    }
  }
  return "Im Fass ist nur Wein.\n";
}

string det_schwanz()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) ) 
  {
    if( ob->check_ratte(5) )
    {
      return BS(
          "Die Spitze des Schwanzes einer Ratte schaut aus dem Wein heraus. "
          "Vielleicht kann man die Ratte daran aus dem Wein herausziehen.");
    }
  }
  return "Kein Schwanz weit und breit.\n";
}
