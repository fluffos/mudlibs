// /d/dschungel/feyaria/tijara/room/hotel_flur.c
// Grand Hotel in Tijara, Flur mit seherhaeusern
// 17.06.2001  Feyaria@SilberLand

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Flur des Grand Hotel von Tijara" );
  SetProp( P_INT_LONG,
    "Du stehst im Flur des Grand Hotel von Tijara, der sich noch weiter "
    "nach hinten erstreckt. Weiter nach vorne kommst Du wieder ins Hotel. "
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "wand", "waende"}),
    "Die Waende sind mit edlen Stoffen tapeziert.");
  AddDetail( ({"tapeten", "tapete", "stoff", "stoffe"}),
    "Die Tapeten bestehen aus edlen Stoffen.");
  AddDetail( ({ "decke"}),
    "An der Decke haengen kleine Lampen, die den Flur erleuchten.");
  AddDetail( ({"lampe", "lampen"}),
    "Die Lampen an der Decke erleuchten den Flur.");
  AddDetail( ({ "boden", "marmor"}),
    "Der Boden ist aus poliertem Marmor.");
  AddDetail( ({"hotel", "grand hotel", "flur"}),
     "Du stehst mitten im Flur des Grand Hotel von Tijara.");

  AddSmell( ({DEFAULT_SMELL,}),
    "Es riecht ein wenig muffig hier.");
  AddSound( ({DEFAULT_SOUND}),
    "Von weiter vorne hoert man noch leise die Hotelgaeste beim Essen und "
    "Trinken.");

  AddExit("vorne", "./hotel_c6");  
}

