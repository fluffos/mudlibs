// /d/dschungel/feyaria/tijara/room/keller/e4.c
// Stiege des Kellers
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  SetProp( P_INT_SHORT, "Bei der Kellerstiege");
  SetProp( P_INT_LONG, BS(
    "Du stehst bei der Kellerstiege, die in die Villa des Gouverneurs "
    "hinauf fuehrt. Von oben scheint noch etwas Licht herunter, aber die "
    "Gaenge, die sich in vier Richtungen erstrecken, sind ziemlich duester, "
    "sodass Du wohl eine Lichtquelle brauchst, um sie zu erforschen.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;

  AddDetail( ({"stiege", "kellerstiege"}),
    "Die Kellerstiege besteht aus hoelzernen Stufen und fuehrt in die "
    "Villa des Gouverneurs hinauf.");
  AddDetail( ({"stufen", "stufe", "holzstufen", "holzstufe"}),
    "Die Stufen sind aus Holz.");
  AddDetail( ({"lichtquelle", "quelle"}),
    "Du wirst wohl eine Lichtquelle brauchen, um die duesternen Gaenge zu "
    "erforschen.");
  AddDetail( ({"gang", "gaenge"}),
    "Die Gaenge erstrecken sich hier in vier Richtungen. Sie sind ziemlich "
    "duester.");

  AddExit( "oben", ROOM "gouverneur_e4" );
  AddExit( "norden", "./e3:"+getuid(this_player()) );
  AddExit( "westen", "./d4:"+getuid(this_player()) );
  AddExit( "osten", "./f4:"+getuid(this_player()) );
  AddExit( "sueden", "./e5:"+getuid(this_player()) );
}
