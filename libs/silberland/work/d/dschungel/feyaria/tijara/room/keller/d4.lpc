// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";
string sound_sack();
string sound_knabbern();

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  VORRAETE_SHORT
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einem kleinen Lagerraum im Keller unter der "
    "Villa des Gouverneurs, in dem viele Lebensmittel lagern. Hier gibt "
    "es Oel in Tonkruegen, gesalzenen Fisch in grossen Tonnen, getrocknete "
    "Fruechte in Steigen und Mehl in Saecken. Die Ratten haben hier am "
    "wildesten gewuetet, denn fast alles ist angeknabbert. Nach Osten "
    "fuehrt ein Gang zur Treppe zurueck.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  VORRAETE_DETAILS;

  AddDetail( ({"raum", "lager", "lagerraum"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"treppe", "gang", "osten"}),
    "Nach Osten fuehrt ein Gang zur Treppe zurueck.");
  AddSound( ({"knabbern"}), #'sound_knabbern );
  AddSound( ({"saecke", "sack", "mehl", "mehlsack", "mehlsaecke"}), #'sound_sack );
  AddDetail( ({"mehlreste", "reste"}),
    "Sie wurden von einer Ratte aufgefressen! Los such dieses boese Tier!");  
  AddDetail( ({"saecke", "mehlsaecke"}),
    "Bei den Mehlsaecken haben die Ratten am allerschlimmsten gewuetet. "
    "Fast alle Saecke sind durchloechert und das Mehl ist voellig "
    "aufgefressen. Nur einige weisse Flecken erinnern noch daran, dass "
    "hier frueher einmal Mehl gelagert wurde. Aus einem der Mehlsaecke "
    "hoerst Du etwas.");
  AddDetail( ({"loch", "loecher"}),
    "Fast alle Saecke haben Loecher. Vielleicht ist ja eine Ratte durch "
    "so ein Loch in einen Mehlsack geschluepft.");
  
  AddCmd( ({"durchwuehle", "durchwuehl", "durchsuch", "durchsuche", "such", 
            "suche"}), "suchen");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "osten", "./e4:"+getuid(this_player()) );
  
  set_next_reset(2*60*60);
}

int suchen(string str)
{
  object ob;
  notify_fail("Du suchst, aber findest nichts.\n");
  if( !str ) return 0;
  if( query_verb()[0..3] == "such" && member( ({"saecke", "sack", "mehl",
      "mehlsack", "mehlsaecke"}), str) !=-1)
  {
    write("Saecke findest Du hier eine ganze Menge.\n");
    say( CAP(TPN)+ " wuehlt in den Saecken herum.\n");
    return 1;
  }
  if( member( ({"in sack", "in mehlsack", "sack", "mehl", "mehlsack", 
                "richtigen sack", "richtigen mehlsack"}),
      str) != -1)
  {
    write("In diesem Mehlsack findest Du nichts.\n");
    say( CAP(TPN)+ " wuehlt in den Saecken herum.\n");
    return 1;
  }
  if( member( ({"in saecken", "in mehlsaecken", "saecke", "mehlsaecke"}),
      str) != -1)
  {
    say( CAP(TPN)+ " wuehlt in den Saecken herum.\n");
    if( (ob=present( "\nrattenfaengerquest", TP)) )
    {
      if( ob->check_ratte(1) )
      {
        write("Du durchsuchst alle Mehlsaecke und findest wirklich eine "
            "Ratte.\n");
        tell_room(TO, "Eine Ratte springt aus einem der Mehlsaecke heraus.\n");
        clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
        ob->finde_ratte(1);
        return 1;
      }
    }
    write("Leider findest Du in keinem der Saecke eine Ratte.\n");
    return 1;    
  }
  return 0;
}

string sound_sack()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) )
  {
    if( ob->check_ratte(1) )
    {
      return BS("Aus einem der Mehlsaecke kommt ein lautes Knabbern. Da scheint eine "
          "Ratte die letzten Mehlreste aufzufressen. Du musst nur noch den richtigen "
          "Sack finden, dann hast Du auch die Ratte gefunden.");
    }
  }
  return "Du hoerst nichts.\n";
}

string sound_knabbern()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) )
  {
    if( ob->check_ratte(1) )
    {
      return BS(
          "Hier ist das Knabbern besonders laut. Es scheint aus einem der "
          "Mehlsaecke zu kommen.");
    }
  }
  return "Du hoerst nichts.\n";
}
