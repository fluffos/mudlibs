// /d/dschungel/feyaria/tijara/room/waffen_c4.c
// Waffenhaendler in Tijara, C4
// 30-10-96  Feyaria@SilberLand
// 24 Details, 1 ReadDetail

#include "../def.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Beim Waffenhaendler von Tijara" );
  SetProp(P_INT_LONG, BS(
    "Du stehst hier im Laden des Waffenhaendlers von Tijara. Hier kann man "
    "Waffen kaufen und verkaufen. An den Waenden stehen Regale, die voll "
    "mit exotischen Kampfinstrumenten und Toetungswerkzeugen sind. Auf der "
    "zerkratzten Verkaufstheke steht ein kleines Schild. In den Kisten "
    "hinter der Theke liegen viele Waffen, die zum Verkauf angeboten "
    "werden. Nach Osten und Sueden fuehren Ausgaenge auf den Hauptplatz.") );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_SPECIAL_SHOP,
    ([P_WC: "Tut mir leid, wir kaufen hier nur Waffen!\n"]) );
  SetStorageRoom (ROOM "store2");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Shagraz");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOPKEEPER_ID, "Shagraz");
  
  AddDetail( ({ "tijara", "stadt"}),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({"laden", "waffenladen"}),
    "Das hier ist ein Waffenladen.");
  AddDetail( ({ "kampfinstrumente", "toetungswerkzeuge"}),
    "Du staunst, welche interessanten Namen man fuer Waffen erfinden kann. "
    "Diese exotischen Waffen sind aber nicht zum Verkauf gedacht, sondern "
    "die private Sammlung des Ladenbesitzers.");
  AddDetail( ({ "sammlung", "waffensammlung"}),
    "So eine Waffensammlung moechtest Du wohl auch gerne haben, gell?");
  AddDetail( ({ "ladenbesitzer", "besitzer", "waffenhaendler"}),
    "Der Ladenbesitzer ist scheinbar grad nicht da.");
  AddDetail( ({ "waffen", "waffe"}),
    "Hier kann man Waffen verkaufen und kaufen.");
  AddDetail( ({ "regal", "regale"}),
    "Die Regale sind voll mit exotischen Kampfinstrumenten und "
    "Toetungswerkzeugen.");
  AddDetail( ({ "wand", "waende"}),
    "An den Waenden stehen Regale, die mit exotischen Waffen angefuellt "
    "sind.");
  AddDetail( ({ "theke", "holztheke", "ladentheke", "verkaufstheke"}),
    "Ueber diese, aus Kiefernholz gezimmerte Ladentheke sind wohl schon "
    "Unsummen an Muenzen geflossen. Aus den vielen Kratzern und Dellen im "
    "Holz laesst sich leicht erkennen, dass hier viel Umsatz gemacht wird. "
    "Ein kleines Schild steht mitten auf der Theke.");
  AddDetail( ({ "kratzer", "riss", "risse"}),
    "Viele tiefe Kratzer und Risse, die sich in die ansonsten blankpolierte "
    "Oberflaeche der Theke eingegraben haben, zeugen von den scharfen "
    "Waffen, die hier ihren Besitzer gewechselt haben.");
  AddDetail( "kiefernholz", 
    "Die Ladentheke ist aus Kiefernholz gefertigt.");
  AddDetail( ({ "dellen", "delle"}),
    "Entweder entstanden die Dellen in der Theke durch schwere "
    "Gegenstaende, oder sie stammen von Abenteurern, die, wuetend ueber die "
    "hohen Preise, auf die Theke eingeschlagen haben.");
  AddDetail( "decke",
    "Die Decke setzt sich aus einfachen Brettern zusammen.");
  AddDetail( "boden",
    "Der Boden setzt sich genau wie die Decke aus voellig normal "
    "ausehenden Brettern zusammen.");
  AddDetail( ({ "brett", "bretter"}), 
    "Ganz normale, dicke Bretter aus Eichenholz, die vielleicht etwas "
    "schief geschnitten wurden.");
  AddDetail( "eichenholz",
    "Die Bretter am Boden und an der Decke sind aus Eichenholz.");
  AddDetail( "holz", 
    "Hier ist alles aus Holz: Boden, Decke, Waende und die Ladentheke.");
  AddDetail( ({ "kisten", "kiste"}),
    "In den Kisten werden die Waffen gelagert, die zum Verkauf bestimmt "
    "sind. Dabei handelt es sich meist um ganz normale Waffen, wie man sie "
    "ueberall billig zu kaufen bekommt.");
  AddDetail( ({ "verkauf"}),
    "Ja, hier werden Waffen verkauft.");
  AddDetail( ({ "nordosten", "norden", "suedosten", "suedwesten", "westen",
                "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({"osten", "sueden", "ausgang", "ausgaenge"}),
    "Nach Osten und Sueden fuehren Ausgaenge auf den Hauptplatz.");
  AddDetail( ({"platz", "hauptplatz"}),
    "Der Hauptplatz ist draussen.");
  AddDetail( ({"schild"}),
    "Das Schild steht auf der Theke. Du kannst es lesen.");
  AddReadDetail ( ({"schild"}),
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<zeige> einhaender|1haender|zweihander|2haender  \n"
    "                  Uebersicht ueber die jeweilige Waffenart.\n"
    "<unt> nummer      Gibt die Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
    "<versetze> etwas  Du verkaufst einen Gegenstand, auch wenn Dir der\n"
    "                  Haendler nicht den vollen Preis dafuer bezahlen will.\n"
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  AddCmd(({"schlag", "schlage"}), "schlag");

  AddExit( "osten", "./platz_d4" );
  AddExit( "sueden", "./platz_c5" );

  AddItem( NPC "shagraz", REFRESH_DESTRUCT);
}

int schlag(string str)
{
  notify_fail("Was willst Du schlagen?\n");
  if (!str) return 0;
  if (member(({"theke", "ladentheke", "auf theke", "auf ladentheke", 
               "verkaufstheke", "auf verkaufstheke"}),str)!=-1)
  {
    write(BS("Du laesst Deiner Wut freien Lauf und schlaegst mit voller "
      "Kraft auf die Ladentheke. Wieder eine Delle mehr..."));
    say(TPN+" schlaegt wutenbrannt mit der Faust auf die Ladentheke.\n");
    return 1;
  }
  return 0;
}

