// /d/dschungel/feyaria/tijara/room/kult.c
// verborgenen Kulstaette
// 14-10-96  Feyaria@SilberLand
// 14 Details, 1 Smell, 1 Sound, 2 Commands

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine verborgene Kultstaette" );
  SetProp( P_INT_LONG, BS(
    "Du stehst in einem merkwuerdigen Raum. Oben an der Decke kannst "
    "Du eine kleine Oeffnung sehen, durch die Du wohl hierhergelangt bist. "
    "Auf dem gleichen Weg wirst Du wohl nicht mehr zurueckgelangen. Hier "
    "ist es sehr duester, sodass Du kaum etwas erkennen kannst. Die Luft "
    "ist muffig und abgestanden, aber erstaunlich kuehl im Vergleich zu "
    "draussen. In der Mitte des Raumes steht ein verfallener Altar, der "
    "mit verschlungenen Reliefs verziert ist. Scheinbar handelt es sich "
    "hier um eine verborgene Kultstaette.") );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_NO_TPORT, NO_TPORT_OUT);

  AddDetail( ({ "boden", "erde"}), 
    "Der Boden ist aus festgepresster Erde. Darauf liegen viele Staubhaufen "
    "und einige kleine Holzstueckchen.");
  AddDetail( ({ "staub", "staubhaufen", "haufen"}),
    "Soviel Staub muss irgendjemand hierhergeschafft haben. Aber zu welchem "
    "Zweck?");
  AddDetail( ({ "holz", "holzstuecke", "holzstueckchen"}),
    "Die Holzstuecke haben sicher irgendeine Bedeutung. Dir faellt nur "
    "jetzt gerade keine ein.");
  AddDetail( ({ "zweck", "bedeutung"}),
    "Lass Dir doch was einfallen.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende verbergen sich im Schatten.");
  AddDetail( ({ "schatten"}),
    "Die Schatten werden von Deiner Lichtquelle erzeugt.");
  AddDetail( ({ "licht", "lichtquelle"}),
    "Ganz bestimmt hast Du eine Lichtquelle, sonst koenntest Du diese "
    "Details gar nicht untersuchen.");
  AddDetail( ({ "decke", "loch", "oeffnung"}),
    "In der Decke weit ueber Dir befindet sich ein kleines Loch, durch das "
    "Du wohl hier hereingekommen bist. Um aber dort wieder rauszukommen, "
    "muesstest Du schon fliegen koennen.");
  AddDetail( ({ "altar", "mitte"}),
    "Der Altar befindet sich in der Mitte des Raumes. Er ist mit "
    "verschlungenen Reliefs verziert und sicher schon sehr alt. Leider "
    "ist er von jemandem ziemlich zerstoert worden, deshalb kann man kaum "
    "mehr genauere Details erkennen.");
  AddDetail( ({ "raum"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({ "relief", "reliefs", "details", "abbilder"}),
    "Viel kann man an den Reliefs nicht mehr erkennen, da sie ziemlich "
    "zerstoert sind. Wahrscheinlich waren sie einmal Abbilder der Goetter, "
    "die hier verehrt worden sind.");
  AddDetail( ({ "goetter", "kultstaette"}),
    "Es handelt sich hier um eine Kultstaette. Aber welche Goetter hier "
    "verehrt wurden, ist ungewiss. Vielleicht findest Du ja hier irgendwo "
    "Hinweise.");
  AddDetail( ({ "woody", "gott"}),
    "Einen Gott wirst Du hier nicht finden, da die Kultstaette ja "
    "zerstoert worden ist.");
  AddDetail( ({ "dusty", "goettin"}),
    "Eine Goettin wirst Du hier nicht finden, da die Kultstaette ja "
    "zerstoert worden ist.");
  AddDetail( ({ "hinweise", "hinweis"}),
    "Wenn Du alles genau untersuchst, findest Du vielleicht einen Hinweis, "
    "wer die hier verehrten Goetter waren. Diese koennen Dir ja vielleicht "
    "helfen, hier wieder rauszukommen.");

  AddSmell( ({DEFAULT_SMELL, "luft"}), 
    "Die Luft riecht muffig und abgestanden.");
  AddSound( DEFAULT_SOUND,
    "Es ist absolut ruhig hier."); 
    
  AddCmd( ({ "fliege", "flieg" }), "fliegen" );
  AddCmd( "bete", "beten" );

  AddItem( NPC "ketzer" , REFRESH_DESTRUCT);
}

int fliegen(string str )
{
  notify_fail( "Du glaubst wirklich, dass Du fliegen kannst?\n" );
  return 0;
}

int beten(string str )
{
  notify_fail( "Zu wem willst Du beten?\n" );
  if(!str) 
  {
    if (TP->QueryProp(P_GHOST))
    {
      write("Du haeltst eine kurze Andacht.\n");
      say ("Der Geist von "+TPN+" haelt eine kurze Andacht.\n");
      write ("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "
        "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "
        "durchstroemt.\n");
      say (TPN+" erscheint ploetzlich wieder in koerperlicher Form.\n");
      TP->SetProp(P_GHOST,0);
      return 1;
    }
    write("Du haeltst eine kurze Andacht, aber nichts passiert.\n");
    say( TPN+" haelt eine kurze Andacht.\n");
    return 1;
  }
  if( str=="zu woody" || str=="zu dusty" )
  {
    write("Du betest inbruenstig und die Goetter erhoeren Deine Bitte.\n");
    say( TPN+" faellt auf die Knie und murmelt etwas vor sich hin.\n");
    TP->move( ROOM "platz_d5", M_GO, "ploetzlich", "verschwindet",
      "kommt pudelnass aus dem Brunnen heraus");
    TP->SetProp(P_SP,0);
    return 1;
  }
  if( str=="zu gott" || str=="zu goetter" || str=="zu den goettern" ||
      str=="zu goettern" )
  {
    write("Du musst schon genau sagen, zu welchem Gott Du beten willst.\n");
    return 1;
  }
  return 0;
}

void open_secret_door()
{
  tell_room( TO, "Eine Geheimtuer oeffnet sich.\n" );
  AddExit("norden", "./drachenhoehle" );
}

void reset()
{
  ::reset();
  RemoveExit("norden");
}

