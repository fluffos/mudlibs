#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  WEIN_SHORT
  SetProp( P_INT_LONG, BS(
    "Du stehst im Sueden des Weinkellers. Hier lagert der Gouverneur "
    "von Tijara seinen Wein, denn ueberall stehen Weinfaesser und Regale mit "
    "Weinflaschen herum. Es ist so duester, dass Du sonst nicht viel erkennen "
    "kannst.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  WEIN_DETAILS;

  AddCmd( ({"oeffne", "trink", "trinke", "nimm"}), "wein");

  AddExit( "osten", "./f6:"+getuid(this_player()) );
  AddExit( "nordosten", "./f5:"+getuid(this_player()) );
  AddExit( "norden", "./e5:"+getuid(this_player()) );
  AddExit( "nordwesten", "./d5:"+getuid(this_player()) );
  AddExit( "westen", "./d6:"+getuid(this_player()) );
}

WEIN_STEHLEN
