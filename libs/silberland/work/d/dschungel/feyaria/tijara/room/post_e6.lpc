// /d/dschungel/feyaria/tijara/room/post_e6.c
// Post von Tijara, E6
// 30-10-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/post";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Im Postamt von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Das ist das Postamt von Tijara. Hier kann man neue Briefe schreiben "
    "oder die eigene Post lesen. Um etwas Ruhe zu haben, kannst Du eine der "
    "Ein-Personen-Kabinen betreten. Nach Westen gelangst Du auf den "
    "Hauptplatz von Tijara zurueck.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "boden" }), BS(
    "Der Boden ist im typischen Postgelb gehalten.") );
  AddDetail( ({ "decke" }), BS(
    "Die Decke ist im typischen Postgelb gehalten.") );
  AddDetail( ({ "wand", "waende" }), BS(
    "Die Waende sind im typischen Postgelb gehalten.") );
  AddDetail( ({ "briefe", "brief", "post" }), BS(
    "Wenn Du Deine Briefe lesen oder neue schreiben willst, dann tipp doch "
    "einfach 'post'.") );
  AddDetail( ({ "hauptplatz", "platz", "westen", "ausgang" }), BS(
    "Nach Westen gelangst Du auf den Hauptplatz von Tijara zurueck.") );
  AddDetail( ({ "gelb", "postgelb", "farbe" }), BS(
    "Diese gelbe Farbe ist das Erkennungszeichen der Post.") );
  AddDetail( ({ "tijara", "stadt", "postamt" }), BS(
    "Du befindest Dich im Postamt der Stadt Tijara.") );
  AddDetail( ({ "norden", "nordosten", "osten", "suedosten", "sueden",
                "suedwesten", "nordwesten"}), BS(
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.") );

  AddExit( "westen", "./platz_d6" );

  AddItem("/p/service/thor/postcards/obj/postkasten", REFRESH_REMOVE);
  AddItem("/std/postschalter", REFRESH_REMOVE);
}
