// /d/dschungel/feyaria/tijara/room/hotel_c6.c
// Grand Hotel in Tijara, C6
// 30-10-96  Feyaria@SilberLand
// 13 Details, 1 Sound, 1 Smell

#include "/d/dschungel/feyaria/tijara/def.h"

inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Grand Hotel von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst im Grand Hotel von Tijara. Hier verkehren nur die vornehmen "
    "und reichen Buerger von Tijara. Darum gibt es hier auch Vorschriften, "
    "die die korrekte Bekleidung betreffen. Ein Rausschmeisser wacht "
    "darueber, dass niemand diese Vorschriften uebertritt. Dafuer kann man "
    "hier aber auch die schmackhaftesten Speisen verzehren und die edelsten "
    "Getraenke trinken. Nach hinten kommt man zum Flur, wo sich die "
    "Gaestezimmer befinden. Eine Treppe fuehrt nach oben.")+
    "Der Magierstammbaum.\n" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_NOMAGIC, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({"flur"}),
    "Der Flur fuehrt nach hinten zu den Gaestezimmern.");  
  AddDetail( ({"zimmer", "gaestezimmer"}),
    "Die Gaestezimmer befinden sich weiter hinten in Flur.");  
  AddDetail( ({"treppe", "teil"}),
    "Im hinteren Teil des Raumes fuehrt eine Treppe nach oben.");
  AddSpecialDetail( ({"baum", "stammbaum", "magierstammbaum"}), "baum");
  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "wand", "waende"}),
    "Die Waende sind mit edlen Stoffen tapeziert.");
  AddDetail( ({"tapeten", "tapete", "stoff", "stoffe"}),
    "Die Tapeten bestehen aus edlen Stoffen.");
  AddDetail( ({ "decke"}),
    "An der Decke haengt ein wertvoller Kristalluster.");
  AddDetail( ({"luster", "kristalluster", "kristall"}),
    "An der Decke haengt ein Luster aus Kristall. Sicher ist er sehr "
    "wertvoll. Du raetselst, ob man Kristalluster nicht doch mit drei "
    "Ls schreiben sollte.");
  AddDetail( ({"kristallluster"}),
    "Kristallluster mit 3 Ls schaut wirklich lustig aus:)");
  AddDetail( ({ "boden", "marmor"}),
    "Der Boden ist aus poliertem Marmor.");
  AddDetail( ({"hotel", "grand hotel"}),
     "Du stehst mitten im Grand Hotel von Tijara.");
  AddDetail( ({"rausschmeisser", "schmeisser"}),
    "Der Rausschmeisser scheint gerade nicht da zu sein.");
  AddDetail( ({"vorschriften", "bekleidungsvorschriften", "kleidung",
               "bekleidung"}),
    "Die Bekleidungsvorschriften besagen, dass niemand ohne "
    "Kleidung das Grand Hotel betreten darf.");
  AddDetail( ({"speisen", "getraenke", "speisekarte"}),
    "Wenn Du etwas essen oder trinken willst, dann kannst Du Dir mittels "
    "'menue' die Speisekarte bringen lassen.");
  AddDetail( ({"buerger", "gaeste", "hotelgaeste"}),
    "Hier verkehren nur die vornehmen Buerger, die einfacheren Leute "
    "besuchen eher die verrufene Hafenkneipe.");
  AddDetail( ({"leute", "kneipe", "hafenkneipe"}),
    "Die einfachen Leute findet man nicht hier, sondern in der "
    "verrufenen Hafenkneipe.");

  AddSmell( ({DEFAULT_SMELL, "speisen"}),
    "Es riecht hier nach leckeren Speisen.");
  AddSound( ({DEFAULT_SOUND}),
    "Die Hotelgaeste verhalten sich alle ganz ruhig.");
   
  AddDrink("Eine Tasse Kaffee", ({"kaffee","tasse","tasse kaffee"}),
    150, ({5,8}), -5, 2,
    ({"Du trinkst eine Tasse roestfrischen, einheimischen Kaffees und fuehlst"
      " Dich\ngleich viel munterer.",
      "&& trinkt eine Tasse roestfrischen, einheimischen Kaffees und fuehlt"
      " sich\ngleich viel munterer."}));

  AddDrink("Champagner", "champagner",
    1000, 150, 30, 30,
    ({"Der Kellner bringt Dir eine Flasche edlen Champagner.\n"
      "Mit einem lauten Knall oeffnet er die Flasche und der groesste "
      "Teil der\nperlenden Fluessigkeit spritzt an die Decke. Schnell "
      "nimmst Du die Flasche\nund trinkst den restlichen Champagner mit "
      "einem Zug aus.",
      "&& verspritzt den Grossteil &#s Champagners beim Oeffnen."}));

  AddFood ( "Bananen-salat", ({"bananen", "bananensalat", "bananen-salat"}),
    100, ({23,17}), 10,
    ({"Du isst einen Salat mit Bananen. Eine merkwuerdige Kombination.",
    "&& isst einen Salat mit Bananen.\n"}));

  AddFood ( "Echsenragout", ({"ragout", "echsenragout" }),
    250, 33, 12,
    ({"Du isst ein Ragout aus Echsenfleisch.",
    "&& isst ein Ragout aus Echsenfleisch."}));

  AddFood ( "Fuenf-Gaenge-Menue", ({"menue", "fuenfgaengemenue", 
     "fuenfgaenge", "fuenf-gaenge-menue" }),
    895, 80, 25,
    ({"Du schlemmst Dich durch ein komplettes Menue mit fuenf Gaengen.",
    "&& schlemmt sich durch ein komplettes Menue mit fuenf Gaengen."}));

  AddItem( NPC "rausschmeisser", REFRESH_DESTRUCT);
  
  AddExit( "norden", "./platz_c5" );
  AddExit( "hinten", "./hotel_flur" );
  ////////////////////////////////////////////////////////
  // Fuer Riffquest
  AddSpecialExit("oben","goto_tabar");
  ////////////////////////////////////////////////////////
}

////////////////////////////////////////////////////////
// Fuer Riffquest
int goto_tabar(string dir)
{
  if(!interactive(TP)) return 0;
  // NPCs sollen da nicht hineingehen können.
  tell_object(TP,BS(
    "Du gehst die Treppe hoch und kommst auf einen breiten Gang. Rechts und "
    "links siehst Du einige Tueren. Du klopfst an die erstbeste, oeffnest "
    "sie und trittst ein."));
  tell_room(TO,BS(
    TP->Name()+" geht die Treppe hoch."),({TP}));
  TP->move("/d/wasser/cirion/riff/room/tabar_vc:"+getuid(TP),M_SILENT|M_NOCHECK);
  tell_room(ENV(TP),BS(
    TP->Name()+" kommt herein."),({TP}));
  return 1;
}
////////////////////////////////////////////////////////

void init()
{
  ::init();
  if( TP->QueryProp(P_ARMOURS)==({}) && !IS_LEARNING(TP) )
    call_out("rauswerfen",0);
}

rauswerfen()
{
  if( !TP ) return;
  if( !present(TP) ) return;
  if( present("\nrausschmeisser") )
  {
    write("Der Tuersteher wirft Dich wieder hinaus!\nDer Tuersteher teilt "
        "Dir mit: Nackte sind in diesem Hotel nicht erlaubt!\n");
    say("Der Tuersteher wirft "+ TPN +" auf die Strasse hinaus.\n");
    TP->move( ROOM "platz_c5", M_GO, "in hohem Bogen hinaus", "fliegt", 
      "kommt in hohem Bogen aus dem Grand Hotel geflogen.");
  }
  else
  {
    write( BS("Die Hotelgaeste zeigen mit den Fingern auf Dich und rufen "
       "ganz laut nach dem Rausschmeisser.") );
  }
}

feind (object ob)
{
  object feindob, *list;
  int i;

  if (feindob = find_living("rausschmeisser")) {
    list = feindob->QueryEnemies();
    if (pointerp(list))
    {
      list = list[0];
      for (i=sizeof(list)-1; i>=0; i--)
        if (objectp(list[i]))
          if (ob == list[i])
            return 1;
     }
     return 0;
   } else
     return 0;
}

bestelle (str)
{
  object ob, *list;
  int i;
  if (ob = find_living("rausschmeisser")) {
    notify_fail( BS("Glaubst Du vielleicht, Du kannst hier etwas bestellen, "
       "waerend Du mit dem Rausschmeisser kaempfst?") );
    if (feind(TP)) return 0; 
  } 
  return ::bestelle(str);
}

spendiere (str)
{
  string *tmp;
  object pl;

  if (present ("rausschmeisser"))
  {
    tmp=explode(str," ");
    if (sizeof(tmp)<2) return ::spendiere(str);
    if ((pl=present(tmp[0])) && living (pl))
    {
      notify_fail( BS("Du kannst "+pl->name()+" nichts spendieren, solange "
       +pl->QueryPronoun(WER)+" gegen den Rausschmeisser kaempft.") );
      if( feind(pl) ) return 0;
    }
  }
  return ::spendiere(str);
}

string baum()
{
//  TP->More(read_file(OBJ "stammbaum"));
  TP->More(read_file("/players/feyaria/tools/stammbaum"));
  return "";
}

