// /d/dschungel/feyaria/tijara/room/hafen_d2.c
// Hafen von Tijara, D2
// 30-10-96  Feyaria@SilberLand
// 49 Details, 2 Sounds, 2 Smells

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Hafen von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst hier am Hafen von Tijara. Angehoerige aller Rassen tummeln "
    "sich hier. Elfische Jaeger, zwergische Handwerker, menschliche "
    "Haendler und Hobbitreisende sind wohl auch gerade mit einem Schiff "
    "hier angekommen um ihr Glueck zu versuchen und von den Schaetzen des "
    "Dschungels reich zu werden. Zahlreiche Matrosen und Fischer eilen "
    "nach Norden auf den Steg zu ihren Schiffen. Nach Westen fuehrt eine "
    "Strasse an der Kaimauer entlang und nach Sueden fuehrt die Hauptstrasse "
    "ins Zentrum der Stadt. Im Osten befindet sich ein etwas schaebiges "
    "Haus mit einer grossen Seeschlange ueber dem Eingang. Scheinbar "
    "handelt es sich hier um eine Hafenkneipe. Nach Suedosten schliesslich "
    "fuehrt eine schmale Gasse ins Wohnviertel von Tijara.") );

  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_TOWN]) );
  SetProp(P_KILL_MSG, "TOD den Scriptern!" );
  SetProp(P_KILL_NAME, "Eine Scriptfalle" );
  SetProp(P_ENEMY_DEATH_SEQUENCE, ([ 1:"\nFeyaria teilt Dir mit: "
    "Warum benutzt du auch Untersuche-Scripte :(\n\n" ]) );

  AddDetail( ({ "tijara", "stadt", "hafen" }),
    "Du befindest Dich im Hafen der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "hitze" }),
    "Die bruetende Hitze wird durch ein kuehles Lueftchen vom Meer her "
    "etwas gelindert. Trotzdem schwitzt Du ziemlich. Vielleicht solltest "
    "Du in der Kneipe schnell etwas Kuehles gegen den Durst trinken.");
  AddSpecialDetail( ({ "durst" }), "durst" );
  AddDetail( ({ "lueftchen", "wind" }),
    "Das bisschen Wind vom Meer macht die Hitze gerade noch ertraeglich." );
  AddDetail( ({ "boden", "stein", "steinplatten", "platten"}),
    "Der Boden ist aus harten Steinplatten gefertigt.");
  AddDetail( ({ "lagerhalle", "lagerhallen"}),
    "In den Lagerhallen werden alle Gueter gelagert, die verschifft werden "
    "sollen.");
  AddDetail( ({ "gueter", "handelswaren", "waren", "gebiete"}),
    "Die Gueter sind hauptsaechlich Handelswaren, die mit den noerdlichen "
    "Gebieten ausgetauscht werden.");
  AddDetail( ({ "haeuser"}),
    "Die meisten Haeuser sind mit weisser Farbe getuencht und haben ein "
    "Flachdach. So soll wohl die drueckende Hitze abgewehrt werden. Im "
    "Osten steht ein etwas schmuddeliges Haus, das wie eine Hafenkneipe "
    "aussieht.");
  AddDetail( ({ "flachdach", "dach", "angriffsflaeche"}), 
    "Ein Flachdach hat den grossen Vorteil, dass es der Sonne nicht soviel "
    "Angriffsflaeche bietet wie ein Spitzdach. Darum ist es in einem Haus "
    "mit Flachdach nicht so heiss.");
  AddDetail( ({ "spitzdach"}), 
    "Kein Haus hier hat ein Spitzdach.");
  AddDetail( ({ "kneipe", "hafenkneipe", "haus"}),
    "Die Hafenkneipe ist etwas heruntergekommen. Alle anderen Haeuser haben "
    "eine schoene weissen Farbe, die Kneipe dagegen ist schon mehr grau. "
    "Ueber der Eingangstuer befindet sich eine geschnitzte Seeschlange, die "
    "der Kneipe wohl ihren Namen gibt. Gerade taumeln einige betrunkene "
    "Seeleute aus der Tuer heraus. Wenn Du keine Angst vor betrunkenen "
    "Matrosen hast, kannst Du ja die Kneipe betreten.");
  AddDetail( ({"name"}),
      "Zur Seeschlange.");
  AddDetail( ({ "angst" }),
    "So lange man die Matrosen nicht beleidigt, braucht man keine Angst "
    "vor ihnen zu haben. Ansonsten sind sie aber schnell zu einer "
    "Schlaegerei bereit.");
  AddDetail( ({ "schlaegerei"}),
    "Willst Du wirklich hier eine Schlaegerei mit den Matrosen anfangen?");
  AddDetail( ({ "seeschlange", "schlange"}),
    "Die Seeschlange ist eine kunstfertige Schnitzerei aus Ebenholz. Sie "
    "haengt ueber der Eingangstuer der Kneipe und soll wohl den Namen der "
    "Hafenkneipe symbolisieren.");
  AddDetail( ({ "schnitzerei", "holz", "ebenholz"}),
    "Bei dieser Schnitzerei wurde die natuerliche Maserung des Ebenholzes "
    "ausgenutzt, sodass die braunen und schwarzen Stellen wie Licht und "
    "Schatten auf dem Koerper der Seeschlange wirken.");
  AddDetail( ({"stellen", "koerper", "licht", "schatten"}),
    "Einfach eine meisterhafte Schnitzerei.");
  AddDetail( ({ "maserung"}),
    "Ebenholz besteht sowohl aus ebenholzschwarzen Teilen als auch aus "
    "ganz normalen braunen Anteilen. Das macht dieses Holz so wertvoll. "
    "Ebenholzbaeume wachsen ausschliesslich in unzugaenglichen Gebieten "
    "des Dschungels.");
  AddDetail( ({ "ebenholzbaeume"}),
    "Der grosse Wert der Ebenholzbaeume war einer der Gruende der "
    "Siedler, sich hier in Tijara anzusiedlen.");
  AddDetail( ({ "tuere", "eingangstuere", "tuer", "eingangstuer", "eingang"}),
    "Durch diese Tuer kann man die Hafenkneipe betreten. Ueber der Tuer "
    "befindet sich eine geschnitzte Seeschlange.");
  AddDetail( ({ "matrosen", "matrose", "seeleute"}),
    "Die meisten Matrosen gehen von ihren Schiffen direkt in die "
    "Hafenkneipe oder taumeln von dort betrunken wieder auf ihre Schiffe "
    "zurueck.");
  AddDetail( ({ "fischer", "korb", "markt" }),
    "Einige Fischer eilen auf den Steg zu ihren Booten, andere kommen "
    "gerade mit einem Korb voller Fische, um sie auf dem Markt zu "
    "verkaufen.");
  AddDetail( ({"personen"}),
    "Es gibt viele Personen hier: Fischer, Matrosen, Seeleute, Haendler, "
    "Schatzsucher und Handwerker.");
  AddDetail( ({ "rassen"}),
    "Alle guten Rassen sind hier vertreten: Menschen, Elfen, Zwerge und "
    "Hobbits. Sie haben gemeinsam diese Stadt gegruendet, um hier ihr "
    "Glueck zu machen.");
  AddDetail( ({ "glueck"}),
    "Fuer jede Rasse bedeutet Glueck natuerlich etwas anderes. Menschen "
    "wollen moeglichst viel Macht und Einfluss gewinnen, Zwerge ihr "
    "handwerkliches Geschick beweisen und moeglichst viel Gold und "
    "Edelsteine anhaeufen, Elfen in Eintracht mit der wilden Natur leben "
    "und vielleicht einige neue Pflanzen und Tiere entdecken, und Hobbits "
    "wollen einfach nur gut essen und trinken und ihren Spass haben.");
  AddDetail( ({ "mensch", "menschen", "haendler"}),
    "Die meisten Menschen hier in Tijara sind Haendler, die mit den "
    "Schaetzen des Dschungels ein Vermoegen verdienen wollen.");
  AddDetail( ({ "schatz", "schaetze", "vermoegen", "gold"}),
    "Im Dschungel soll es viele verborgene Schaetze geben. Wenn Du daran "
    "interessiert bist, solltest Du selber im Dschungel danach suchen.");
  AddDetail( ({ "zwerg", "zwerge", "handwerker", "schatzsucher"}),
    "Die Zwerge hier sind meist Handwerker, die die Bewohner mit den "
    "noetigsten Dingen versorgen, oder sie sind Schatzsucher, die von den "
    "legendaeren Edelsteinvorkommen gehoert haben und diese finden wollen.");
  AddDetail( ({"edelsteine", "edelstein", "edelsteinvorkommen"}),
    "Im Dschungel gibt es angeblich viele Edelsteine. Vor allem Zwerge und "
    "andere Schatzsucher suchen danach.");   
  AddDetail( ({"dinge"}),
    "Was fuer Dinge meinst Du?");  
  AddDetail( ({ "elfen", "elf", "jaeger", "wurzeln", "elvenvolk", "volk"}),
    "Viele Elfen sind hier, um die Tier- und Pflanzenwelt des Dschungels "
    "zu erforschen. Einige versuchen auch, hier die alten Wurzeln des "
    "Elfenvolkes zu entdecken.");
  AddDetail( ({ "tiere", "pflanzen", "tierwelt", "pflanzenwelt", "natur"}),
    "Hier gibt es weder Tiere noch Pflanzen, aber hier ist ja auch die "
    "Stadt. Du musst schon in den Dschungel selber eindringen, um die "
    "seltenen Tiere und Pflanzen zu finden.");
  AddDetail( ({ "hobbit", "hobbits", "reisende", "hobbitreisende"}),
    "Die meisten Reisenden sind Hobbits, und die meisten Hobbits sind "
    "Reisende. Sie wollen nur gut essen, trinken und ihren Spass haben.");
  AddDetail( ({"spass"}),
    "Hier in Tijara kannst Du sicher Deinen Spass haben.");
  AddDetail( ({ "reisender"}),
    "Du bist so ein Reisender. Du kannst nach Norden gehen, um mit einem "
    "Schiff diese Gegend zu verlassen, oder Dich hier in Tijara noch etwas "
    "genauer umsehen.");
  AddDetail( ({ "dschungel", "gegend"}),
    "Die hiesige Gegend wird wegen der ueppigen Vegetation 'Dschungel' "
    "genannt.");
  AddDetail( ({ "vegetation" }),
    "Hier im Hafen kannst Du natuerlich nichts davon sehen, denn die "
    "Siedler haben hier den Dschungel natuerlich gerodet, um diese Stadt "
    "zu erbauen.");
  AddDetail( ({ "siedler", "bewohner", "einwohner"}),
    "Siedler nennt man die Einwohner dieser Stadt, weil sie erst seit "
    "kurzem aus dem fernen Norden hierher gekommen sind, um diese Gegend zu "
    "besiedeln.");
  AddDetail( ({ "meer", "horizont", "blau", "tuerkisblau", "meergruen"}),
    "Das Meer hat in Ufernaehe eine tuerkisblaue Farbe, weiter entfernt "
    "geht sie in helles Meergruen ueber, und am Horizont siehst Du ein "
    "tiefes Blau. Diese Farbkombination ist einfach ein herrlicher "
    "Anblick.");
  AddDetail( ({ "wasser", "wellen"}),
    "Hier im Hafen kannst Du das Wasser nicht mehr so genau sehen. Naehere "
    "Einzelheiten kannst Du nur vom Steg aus erkennen.");
  AddDetail( ({ "farben", "farbe"}), 
    "Die Farben des Meeres sind einfach wunderbar.");
  AddDetail( ({ "farbkombination", "anblick"}),
    "Diese Farbkombination ist einfach ein herrlicher Anblick.");
  AddDetail( ({ "steg", "holzsteg", "norden"}),
    "Am Steg legen die Schiffe an. Er befindet sich im Norden.");
  AddDetail( ({ "schiffe", "segelschiffe", "schiff", "segelschiff"}),
    "Die grossen Segelschiffe bringen Waren und Personen von und nach den "
    "noerdlichen Gebieten.");
  AddDetail( ({ "boote", "boot", "fischerboot", "fischerboote"}),
    "Mit den kleinen Fischerbooten fahren die Fischer auf Fischfang.");
  AddDetail( ({"fische", "fischfang"}),
    "Fischfang ist eine der Haupttaetigkeiten in Tijara, denn die Fische "
    "hier sind sehr nahrhaft.");
  AddDetail( ({ "sueden", "hauptstrasse", "zentrum", "stadtzentrum"}),
    "Nach Sueden fuehrt die Hauptstrasse ins Stadtzentrum.");
  AddDetail( ({ "osten"}),
    "Im Osten kannst Du die Hafenkneipe betreten.");
  AddDetail( ({ "strasse", "strassen"}),
    "Viele Strassen fuehren vom Hafen aus durch die Stadt. Nach Westen "
    "fuehrt der Hafenweg an der Kaimauer entlang, nach Sueden die "
    "Hauptstrasse ins Stadtzentrum und nach Suedosten fuehrt eine "
    "kleine Gasse in das Wohngebiet von Tijara.");
  AddDetail( ({ "westen", "hafenweg", "weg"}),
    "Nach Westen fuehrt der Hafenweg an der Kaimauer entlang. Dort liegen "
    "auch die ganzen Lagerhallen und Handelskontore.");
  AddDetail( ({ "kontor", "handelskontor", "kontore", "handelskontore"}),
    "In den Handelskontoren werden die Waren verkauft und gekauft, die in "
    "den Lagerhallen gelagert werden.");
  AddDetail( ({ "kaimauer", "mauer", "schutz" }),
    "Die Kaimauer bildet einen kuenstlichen Schutz gegen das Meer.");
  AddDetail( ({ "nordosten",  "nordwesten"}),
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst ins "
    "Wasser fallen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({ "suedwesten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "suedosten", "gasse", "wohngebiete", "wohngebiet",
                "wohnviertel"}),
    "Nach Suedosten fuehrt eine Gasse in die Wohngebiete von Tijara.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein Stimmengewirr.");
  AddSound( ({"stimmen", "stimmengewirr"}), 
    "Du kannst keine einzelne Stimme aus dem Stimmengewirr verstehen.");
  AddSmell( DEFAULT_SMELL,
    "Hier hat es einen typischen Hafengeruch.");
  AddSmell( ({"hafen", "hafengeruch", "geruch"}),
    "Dieser Hafen riecht wie jeder andere Hafen auch.");

  AddSpecialDetail( ({"dschungels", "kuehles", "elfenvolkes", "zahlreiche", 
                      "scheinbar", "im", "ueber", "gerade", "ansonsten", 
                      "ebenholzes", "hier", "naehere" }), 
      "scripter");
//  AddSpecialDetail( ({"sfgsdg", "sdgs", "sdgscz", "nfgf", "et", "fhmkf", 
//    "dfhjfg", "jdfjh", "dfh", "dgjrz", "ejhrt", "rzjk", "gjt", "rj", "tj", 
//    "ttj", "gjrtj", "zrhf", "tikfm"}), "scripter");

  AddItem( NPC "gardist" , REFRESH_DESTRUCT);

  AddExit( "norden", "./steg_d1" );
  AddExit( "sueden", "./weg_d3" );
  AddExit( "westen", "./weg_c2" );
  AddExit( "suedosten", "./weg_e3" );
  AddExit( "osten", "./kneipe_e2" );
//  AddExit( "betrete kneipe", "./kneipe_e2" );
}

string durst()
{
  int drink, max_drink;
  string str;
  max_drink = TP->QueryProp(P_MAX_DRINK);
  drink = TP->QueryProp(P_DRINK);
  drink=drink*100/max_drink;
  if (drink < 10)
    str="Deine Kehle ist richtig ausgedoerrt.\n";
  else if (drink < 40) 
    str="Du bist sehr durstig.\n";
  else if (drink < 80) 
    str="Dein Durst haelt sich in Grenzen.\n";
  else  
    str="Du hast zwar nicht viel Durst, aber ein kleiner Tropfen kann nie "
        "schaden.\n";
  return str;
}

string warnung()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" untersucht < "+ TP->_unparsed_args()+
    " > in hafen_d2.\n");
  return ( "Verwendest Du etwa ein Script zum Untersuchen ?\n"
    "Das hat boesartige Wesen herbeigeholt, um Dich zu vernichten:\n"
    "Sfgsdg, Sdgs, Sdgscz, Nfgf, Et, Fhmkf, Dfhjfg, Jdfjh, Dfh, Dgjrz\n"
    "Ejhrt, Rzjk, Gjt, Rj, Tj, Ttj, Gjrtj, Zrhf, Tikfm\n"
    "\n!!! ACHTUNG !!! - Das Untersuchen dieser Wesen fuehrt zum Tod!\n");
}
    
string scripter()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" untersucht < "+ TP->_unparsed_args()+
    " > in hafen_d2.\n");
//  if( TP->QueryProp(P_LEVEL)<=3)
    return "Untersuch bitte nicht solche sinnlosen Details.\n";
//  TP->do_damage(33);
  return "Wenn Du jetzt stirbst, bist Du selber schuld!\n";
}

