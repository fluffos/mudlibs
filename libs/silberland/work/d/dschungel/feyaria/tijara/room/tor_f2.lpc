// /d/dschungel/feyaria/tijara/room/tor_f2.c
// Osttor von Tijara, F2
// 30-10-96  Feyaria@SilberLand
// 19 Details, 1 Sound, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Osttor von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich hier am oestlichen Stadttor von Tijara. Nach Osten "
    "kann man durch das Tor die Stadt verlassen. Die Grenze der Stadt wird "
    "hier durch eine kleine Stadtmauer gebildet, die genau wie das Tor aus "
    "hellgrauem Stein erbaut ist. Nach Suedwesten fuehrt eine schmale Gasse "
    "zurueck in die Stadt.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "osten", "stadttor", "tor", "oeffnung"}),
    "Im Osten steht ein grosses Stadttor, durch das man die Stadt "
    "verlassen kann. Es wird immer von einem Stadtgardisten bewacht. An das "
    "Tor schliesst sich eine kleine Stadtmauer an, welche rund um die ganze "
    "Stadt laeuft. Das Tor ist, wie auch die Stadtmauer, aus grossen "
    "hellgrauen Steinbloecken erbaut.");
  AddDetail( ({ "stein", "steinblock", "steinbloecke", "block", "bloecke"}),
    "Die Steinbloecke sind aus hellgrauem, harten Stein, der sich ideal "
    "fuer Befestigungsbauten eignet.");
  AddDetail( ({ "befestigungen", "befestigungsbauten", "befestigung"}),
    "Zu Befestigungen zaehlt die Stadtmauer mit ihren grossen Toren.");
  AddDetail( ({ "kuestenweg", "weg"}),
    "Der Weg fuehrt durch das Tor zum Kuestenweg, der dann an der Kueste "
    "entlang fuehrt.");
  AddDetail( ({ "kueste", "meer"}),
    "Von der Kueste und dem Meer kannst Du nur einen kleinen Auschnitt "
    "durch das Tor erkennen.");
  AddDetail( ({ "mauer", "stadtmauer"}),
    "Die Stadtmauer ist aus grossen hellgrauen Steinbloecken erbaut und ist "
    "ca. 3 Meter hoch. Oben ist sie mit spitzen Holzpfloecken bestueckt, "
    "um ein Ueberklettern zu verhindern. Sie erstreckt sich rund um die "
    "Stadt. Nur das grosse Stadttor laesst eine Oeffnung frei, um die Stadt "
    "zu verlassen.");
  AddDetail( ({"grenze"}),
    "Die Stadtmauer bildet die Grenze vom Tiajra.");  
  AddDetail( ({ "holz", "pfloecke", "holzpfloecke", "spitzen", "spitze"}),
    "Die Holzpfloecke sind wirklich richtig spitz. Dir faellt auf, dass an "
    "einer Stelle ein Holzpflock fehlt.");
  AddDetail( ({ "holzpflock", "pflock"}),
    "An einer Stelle fehlt ein Holzpflock.");
  AddDetail( ({ "stelle"}),
    "An dieser Stelle fehlt ein Holzpflock. Vielleicht solltest Du diesen "
    "Fehler den zustaendigen Behoerden melden.");
  AddDetail( ({ "behoerde", "behoerden"}),
    "Behoerden reagieren zwar nur sehr langsam auf Meldungen, aber ohne "
    "Meldung passiert wohl nie etwas.");
  AddDetail( ({"meldung", "meldungen"}),
    "Hast du schon die Meldung gemacht?");
  AddDetail( ({ "fehler"}),
    "Bei dem fehlenden Holzpflock handelt es sich sicher um einen Fehler.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden besteht hier aus festgestampfter Erde.");
  AddDetail( ({ "gardist", "stadtgardist" }),
    "Es ist wohl gerade keiner da.");
  AddDetail( ({ "gardisten", "stadtgardisten", "stadtgarde"}),
    "Die Stadtgarde bewacht dieses Tor sehr sorgfaeltig.");
  AddDetail( ({ "suedwesten", "gasse", "wohngebiet"}),
    "Nach Suedwesten fuehrt eine schmale Gasse ins Wohngebiet von Tijara.");
  AddDetail( ({ "westen", "nordwesten", "norden", "nordosten", "suedosten", 
                "sueden"}),
    "In diese Richtung gehts hier nicht weiter.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es richtig ruhig.");
  AddSmell( ({DEFAULT_SMELL, "meer" }),
    "Es riecht es nur noch schwach nach Meer.");

  AddItem( NPC "gardist2", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: ROOM "tor_f2", P_MNPC_AREA: ROOM "tor_f2"]) );

  AddCmd( "melde", "meldung");

//  AddSpecialExit( "osten", "osten" );
  AddExit( "osten", "/d/dschungel/feyaria/kueste/room/ost_a4");
  AddExit( "suedwesten", "./weg_e3" );
}
/*
osten()
{
  write( BS("Weil das Dschungelgebiet noch nicht ganz erforscht ist, ist "
            "der Kuestenweg noch geschlossen.") );
  return 1;
}
*/
int meldung( string str)
{
  notify_fail("Was willst Du wem melden?\n");
  if (!str) return 0;
  if (str=="fehler" || str=="stelle" || str=="holzpflock")
  {
    notify_fail("Wem willst Du den Fehler melden?\n");
    return 0;
  }
  if (str=="behoerde" || str=="behoerden")
  {
    notify_fail("Was willst Du der Behoerde melden?\n");
    return 0;
  }
  if (str=="behoerde fehler" || str=="behoerden fehler" ||
      str=="fehler behoerde" || str=="fehler behoerden")
  {
    write( BS("Du meldest der Behoerde den Fehler und fuehlst Dich "
              "irgendwie erleichtert. Aendern wird sich zwar nichts, aber "
              "Hauptsache, Du hast die Meldung gemacht.") );
    return 1;
  }
  return 0;
}
