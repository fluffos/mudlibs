// /d/dschungel/feyaria/tijara/room/wohn_f3.c
// Wohngebiet in Tijara, F3
// 30-10-96  Feyaria@SilberLand
// 14 Details

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Wohngebiet in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich im Wohngebiet von Tijara. Viele Haeuser sind schon "
    "bewohnt, aber einige Bauplaetze sind noch frei. Die gepflasterte "
    "Strasse macht hier einen Knick und fuehrt von Westen nach Sueden.")+
    "Hier befindet sich das Seherhaus von Madame.\n");
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_TOWN]) );

//  AddDetail( ({"berxhaus", "haus von berx", "seherhaus von berx", "berx"}),
//    "Du kannst das Haus von Berx betreten.");
//  AddDetail( ({"rckhaus", "haus von rck", "seherhaus von rck", "rck"}),
//    "Du kannst das Haus von Rck betreten.");
  AddDetail( ({"madamehaus", "haus von madame", "seherhaus von madame", 
               "madame", "osten"}),
    "Du kannst das Haus von Madame im Osten betreten.");
  AddDetail( ({ "tijara", "stadt" }), BS(
    "Du befindest Dich mitten in der Stadt Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.") );
  AddDetail( ({ "strasse", "weg", "knick" }), BS(
    "Die Strasse macht hier einen Knick und fuehrt von Westen nach "
    "Sueden. Sie ist mit grossen Pflastersteinen gepflastert.") );
  AddDetail( ({ "sueden", "westen"}), BS(
    "In diese Richtungen kannst Du gehen. (Du kannst aber auch hier stehen "
    "bleiben, wenn es Dir hier gefaellt.") );
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({ "norden", "nordosten", "suedosten",
                "suedwesten",  "nordwesten"}), BS(
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
    "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
    "in der Naehe.") );
  AddDetail( ({ "boden", "pflaster", "steine", "pflastersteine" }), BS(
    "Der Boden besteht aus grossen Pflastersteinen. Alle Steine zusammen "
    "bilden wohl eine ganze Strasse.") );
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
    "Dies hier ist das Wohngebiet von Tijara. Wie der Name schon sagt, "
    "wohnen hier viele Einwohner der Stadt.") );
  AddDetail( ({ "einwohner", "bewohner" }), BS(
    "Die Bewohner sind in ihren Haeusern und moechten von Dir nicht "
    "gestoert werden.") );
  AddDetail( ({ "einwohner", "bewohner" }), BS(
    "Die Bewohner sind in ihren Haeusern und moechten von Dir nicht "
    "gestoert werden.") );
  AddDetail( ({ "haus", "haeuser" }), BS(
    "Einige Haeuser werden schon von Bewohnern von Tijara bewohnt. Es ist "
    "aber noch genug Platz frei, um hier ein Seherhaus zu bauen. Dazu muss "
    "man nur einen Bauplatz erwerben.") );
  AddSpecialDetail( ({ "platz", "bauplatz", "plaetze", "bauplaetze",
                       "seherhaus" }), "seherhaus" ); 
  AddDetail( ({ "gouverneur" }), BS(
    "Zur Zeit hat Tijara keinen Gouverneur sondern eine Gouverneurin.") );
  AddDetail( ({ "gouverneurin", "feyaria" }), BS(
    "Zur Zeit ist Feyaria die Gouverneurin von Tijara.") );

//  AddCmd( ({"betrete", "betritt"}), "betreten");

  AddExit( "westen", "./weg_e3" );
  AddExit( "sueden", "./wohn_f4" );
}
