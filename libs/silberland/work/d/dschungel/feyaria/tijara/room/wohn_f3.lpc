{
  notify_fail("Was willst Du betreten?\n");
  if(!str) return 0;
  if( str=="madamehaus" || str=="haus von madame" || str=="seherhaus von madame")
  {
    TP->move( "/d/seher/haus/madame:00:00", M_GO);
    return 1;
  }
  if( str=="haus" || str=="seherhaus")
    notify_fail("Welches Haus willst Du betreten?\n");
  return 0;
