// /d/dschungel/feyaria/tijara/room/platz_d6.c
// Hauptplatz von Tijara, D6
// 30-10-96  Feyaria@SilberLand
// 23 Details, 2 Sounds, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hauptplatz von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf der Suedseite des Hauptplatzes von Tijara. Der Platz ist "
    "rund und in der Mitte steht ein grosser Springbrunnen, von dem eine "
    "Fontaene hoch in den Himmel aufsteigt. Im Westen befindet sich das "
    "Grand Hotel von Tijara. Im Osten ist ein grosses, gelbes Gebaeude, das "
    "sicherlich das Postamt darstellt. Nach Sueden fuehrt die Hauptstrasse "
    "bis an das Stadttor, das Du von hier schon erkennen kannst.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt", "suedseite", "suedende"}),
    "Du befindest Dich auf dem Hauptplatz der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden ist gepflastert.");
  AddDetail( ({ "pflaster", "pflastersteine", "steine"}),
    "Die hellen Pflastersteine machen einen sauberen Eindruck.");
  AddDetail( ({ "platz", "hauptplatz", "norden", "nordosten", "nordwesten"}),
    "Du stehst am Suedende des runden Hauptplatzes. In der Mitte steht ein "
    "grosser Springbrunnen. An den anderen Enden des Platzes fuehren "
    "Strassen in alle Richtungen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");
  AddDetail( ({ "westen", "weg"}),
    "Nach Westen fuehrt ein Weg mitten in die Stadt hinein.");
  AddDetail( ({ "nordwesten", "suedwesten"}),
    "AUA! Eine harte Mauer versperrt den Weg in diese Richtung.");
  AddDetail( ({ "eindruck", "sauberkeit"}),
    "Der Eindruck taeuscht nicht, es ist wirklich alles sehr sauber.");
  AddDetail( ({ "rund", "kreis"}),
    "Der Platz ist rund wie ein Kreis.");
  AddDetail( ({ "springbrunnen", "brunnen", "mitte"}),
    "Der Springbrunnen steht in der Mitte des Hauptplatzes. Eine grosse "
    "Wasserfontaene steigt aus dem Springbrunnen mitten in den Himmel auf. "
    "Dann faellt das Wasser wieder in den Brunnen zurueck.");
  AddDetail( ({ "fontaene", "wasserfontaene"}),
    "Eine grosse Fontaene steigt aus dem Springbrunnen mitten in den Himmel "
    "auf.");
  AddDetail( ({ "wasser"}),
    "Im Brunnen ist viel Wasser. Es wird immer wieder von der Fontaene in "
    "die Luft geschleudert und faellt dann wieder in den Brunnen zurueck.");
  AddDetail( ({ "strasse", "strassen"}),
    "Von diesem Platz fuehren Strassen in alle Richtungen weg.");
  AddDetail( ({ "westen", "hotel", "grandhotel", "grand hotel", "haus"}),
    "Das Grand Hotel im Westen ist ein sehr vornehmes Haus. Einen Eingang "
    "kannst Du von hier aber nicht erkennen.");
  AddDetail( ({ "eingang"}),
    "Einen Eingang ins Hotel gibts hier nicht, Du kannst aber nach Osten "
    "die Post betreten.");
  AddDetail( ({ "osten", "post", "gebaeude", "postamt"}),
    "Das Gebaeude im Osten ist sicherlich die Post von Tijara. Die gelbe "
    "Farbe ist wirklich sehr auffallend.");
  AddDetail( ({ "farbe", "gelb"}),
    "Das typische, kraeftige Gelb, an dem man die Postaemter sofort "
    "erkennen kann.");
  AddDetail( ({ "postaemter"}),
    "Hier gibts nur ein Postamt, Du Scripter!");
  AddDetail( ({ "hauptstrasse"}),
    "Die Hauptstrasse fuehrt nach Norden ueber den Hauptplatz und nach "
    "Sueden zum Stadttor.");
  AddDetail( ({ "stadttor", "sueden"}),
    "Du kannst von hier aus noch keine Einzelheiten vom Stadttor erkennen.");
  AddDetail( ({ "einzelheiten"}),
    "Wenn Du Einzelheiten des Stadttores erkennen willst, musst Du naeher "
    "rangehen.");

  AddSound( ({DEFAULT_SOUND}),
    "Du hoerst das leise Plaetschern des Springbrunnens.");
  AddSound( ({"plaetschern", "brunnen", "springbrunnen", "fontaene"}),
    "Der Springbrunnen gibt ein leisen Plaetschern von sich. Hauptsaechlich "
    "kommt es von der Fontaene.");
  AddSmell( ({DEFAULT_SMELL, "stadt"}),
    "Hier riecht es nach Stadt.");

  AddExit( "norden", "./platz_d5" );
  AddExit( "osten", "./post_e6" );
  AddExit( "sueden", "./tor_d7" );
  AddExit( "nordosten", "./platz_e5" );
  AddExit( "nordwesten", "./platz_c5" );
}
