// /d/dschungel/feyaria/tijara/room/weg_a4.c
// Weg in Tijara, A4
// 30-10-96  Feyaria@SilberLand
// 25 Details, 1 Sound, 1 Smell

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich auf einem Weg in Tijara, der entlang der Stadtmauer "
    "vom Norden nach Sueden fuehrt. Die Haeuser machen hier einen etwas "
    "armseligen Eindruck. Hier leben wohl die aermeren Einwohner. Nur ein "
    "einziges Haus im Osten schaut etwas vornehmer aus. Es ist mit vielen "
    "Tiersymbolen geschmueckt.") );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "haeuser", "behausungen"}),
    "Bei diesen armseligen Haeusern handelt es sich um die Behausungen von "
    "armen Fischern.");
  AddDetail( ({ "eindruck"}),
    "Wirklich ein armseliger Eindruck.");
  AddDetail( ({ "einwohner", "fischer"}),
    "Die meisten Einwohner hier sind arme Fischer.");
  AddDetail( ({ "stein", "steinblock", "steinbloecke", "block", "bloecke"}),
    "Die Steinbloecke sind aus hellgrauem, harten Stein, der sich ideal "
    "fuer Befestigungsbauten eignet.");
  AddDetail( ({ "befestigungen", "befestigungsbauten", "befestigung"}),
    "Zu Befestigungen zaehlt die Stadtmauer mit ihren grossen Toren.");
  AddDetail( ({"weg", "norden", "sueden"}),
    "Der Weg fuehrt von Norden nach Sueden an der Stadtmauer entlang.");
  AddDetail( ({ "mauer", "stadtmauer", "wand", "waende"}),
    "Die Stadtmauer ist aus grossen hellgrauen Steinbloecken erbaut und ist "
    "ca. 3 Meter hoch. Oben ist sie mit spitzen Holzpfloecken bestueckt, "
    "um ein Ueberklettern zu verhindern. Sie erstreckt sich nach Norden bis "
    "zum Stadttor und nach Sueden am Weg entlang.");
  AddDetail( ({"tor", "stadttor"}),
    "Das Stadttor ist im Norden.");
  AddDetail( ({ "holz", "pfloecke", "holzpfloecke", "spitzen", "spitze"}),
    "Die Holzpfloecke sind wirklich richtig spitz.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden besteht hier aus festgestampfter Erde.");
  AddDetail( ({ "nordwesten", "westen", "suedwesten"}),
    "In diese Richtung verhindert die Stadtmauer das Weiterkommen.");
  AddDetail( ({ "nordosten", "suedosten"}),
    "In diese Richtung ist eine Hausmauer.");
  AddDetail( ({ "haus", "osten"}),
    "Im Osten steht ein schoenes Haus, dessen Hauswand mit vielen "
    "Tiersymbolen geschmueckt ist.");
  AddDetail( ({ "hauswand", "waende", "wand"}),
    "Die Hauswand besteht aus Holzbrettern, in die verschiedene Tiersymbole "
    "geschnitzt sind.");
  AddDetail( ({ "holzbretter", "bretter"}),
    "Die Holzbretter sind mit vielen geschnitzten Tiersymbolen verziert.");
  AddDetail( ({ "holz"}),
    "Es handelt sich um das seltene Holz des Tic-Toc Baumes, dass sich "
    "sehr gut zum Schnitzen eignet.");
  AddDetail( ({ "tic-toc", "tictoc", "tic", "toc"}),
    "Der Tic-Toc Baum macht 'tic toc' wenn man an ihn klopft. Daher kommt "
    "sein Name. Zusaetzlich laesst sich sein Holz besonders gut bearbeiten "
    "und so ist es bei Schnitzern sehr beliebt.");
  AddDetail( ({ "tictocbaum", "tic-toc-baum", "tic-toc baum"}),
    "Solltest Du einmal einen Tic-Toc Baum im Dschungel finden, kannst Du "
    "ihn ja faellen und einem Schnitzer verkaufen.");
  AddDetail( ({ "baum", "baeume"}),
    "Hier gibt es keine Baeume. wenn Du einen sehen willst, dann verlass "
    "die Stadt und geh in den Dschungel.");
  AddDetail( ({ "schnitzer"}),
    "Ein Schnitzer wuerde sicher viel fuer einen Tic-Toc Baum bezahlen.");
  AddDetail( ({ "dschungel"}),
    "Hier ist der Dschungel gerodet worden, um fuer die Stadt Platz zu "
    "machen, aber ausserhalb von Tijara ist noch viel Dschungel uebrig.");
  AddDetail( ({ "tiersymbole", "symbole", "schnitzereien"}),
    "Viele verschiedene Tiere sind als Symbole in die Holzbretter der "
    "Hauswand geschnitzt.");
  AddDetail( ({ "tiere", "tier"}),
    "Es handelt sich um die Tiere des Dschungels. Die meisten sind aber "
    "nur symbolhaft abgebildet, darum kann man sie nicht richtig zuordnen.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es richtig ruhig.");
  AddSmell( ({DEFAULT_SMELL, "stadtgeruch", "geruch"}),
    "Es hat hier einen ganz normalen Stadtgeruch.");

  AddExit( "sueden", "./weg_a5" );
  AddExit( "norden", "./weg_a3" );
  AddExit( "osten", "./jaeger_b4" );
}
