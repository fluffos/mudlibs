// im Weinkeller
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  WEIN_SHORT
  SetProp( P_INT_LONG, BS(
    "Du stehst im Suedosteck des Weinkellers. Hier lagert der Gouverneur "
    "von Tijara seinen Wein, denn ueberall stehen Weinfaesser und Regale mit "
    "Weinflaschen herum. Es ist so duester, dass Du sonst nicht viel erkennen "
    "kannst.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  WEIN_DETAILS;

  AddDetail( ({"waende", "wand", "steinbloecke", "bloecke"}),
    "Die Waende sind aus rohen Steinbloecken gefertigt. Ein Steinblock ist "
    "etwas locker.");
  AddDetail( ({"block", "steinblock"}),
    "Vielleicht kann man den lockeren Steinblock ja bewegen?\n");
  AddDetail( ({"eck", "suedost", "suedosteck"}),
    "Natuerlich ist das das Suedosteck, weil Du ja nach Westen, Norden und "
    "Nordwesten gehen kannst.");

  AddCmd( ({"oeffne", "trink", "trinke", "nimm"}), "wein");
  AddCmd( ({"beweg", "bewege"}), "bewegen");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "nordwesten", "./e5:"+getuid(this_player()) );
  AddExit( "westen", "./e6:"+getuid(this_player()) );
  AddExit( "norden", "./f5:"+getuid(this_player()) );
  
  set_next_reset(2*60*60);
}

WEIN_STEHLEN

int bewegen( string str)
{
  object ob;
  if( !(ob=present( "\nrattenfaengerquest", TP)) ) return 0;
  notify_fail("Was willst Du bewegen?\n");
  if( !str ) return 0;
  if( str == "block" || str == "steinblock")
  {
    write("Du bewegst den Steinblock etwas zur Seite.\n");
    say( CAP(TPN)+ " bewegt einen lockeren Steinblock etwas zur Seite.\n");
    if( ob->check_ratte(6) )
    {
      tell_room(TO, "Eine Ratte springt hinter dem Stein hervor.\n");
      clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
      ob->finde_ratte(6);
      return 1;
    }
    write("Leider ist gar nichts hinter dem Steinblock.\n");
    return 1;    
  }
  return 0;
}
