// im Weinkeller
// 27-12-96  Feyaria@SilberLand

#include "../def.h"
#include "./keller.h"

inherit "std/room";

string det_regal();
string det_flasche();
string det_hinter_flasche();

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  PO->CustomizeObject();

  WEIN_SHORT
  SetProp( P_INT_LONG, BS(
    "Du stehst im Suedwesteck des Weinkellers. Hier lagert der Gouverneur "
    "von Tijara seinen Wein, denn ueberall stehen Weinfaesser und Regale mit "
    "Weinflaschen herum. Es ist so duester, dass Du sonst nicht viel erkennen "
    "kannst.") );
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  KELLER_DETAILS;
  KELLER_SENSE;
  WEIN_DETAILS;

  AddDetail( ({"eck", "suedwest", "suedwesteck"}),
    "Natuerlich ist das das Suedwesteck, weil Du ja nach Osten, Norden und "
    "Nordosten gehen kannst.");
  AddDetail( ({"regale", "regal"}), #'det_regal);
  AddDetail( ({"flasche", "weinflasche"}), #'det_flasche);
  AddDetail( ({"hinter flasche", "hinter weinflasche"}), #'det_hinter_flasche);

  AddCmd( ({"schieb", "schiebe"}), "schieben");
  AddCmd( ({"oeffne", "trink", "trinke", "nimm"}), "wein");

  AddItem( NPC "ratte", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]));

  AddExit( "osten", "./e6:"+getuid(this_player()) );
  AddExit( "nordosten", "./e5:"+getuid(this_player()) );
  AddExit( "norden", "./d5:"+getuid(this_player()) );

  set_next_reset(2*60*60);
}

WEIN_STEHLEN


int schieben(string str)
{
  object ob;
  if( !(ob=present( "\nrattenfaengerquest", TP)) ) return 0;
  notify_fail("Was willst Du wegschieben?\n");
  if( !str ) return 0;
  if( str == "flasche" || str == "weinflasche")
  {
    notify_fail("Wohin willst Du die Weinflasche schieben?\n");
    return 0;
  }
  if( str == "flasche weg" || str == "weinflasche weg" )
  {
    write("Du schiebst die Weinflasche weg.\n");
    say( CAP(TPN)+ " schiebt eine Weinflasche weg.\n");
    if( ob->check_ratte(2) )
    {
      tell_room(TO, "Eine Ratte springt aus dem Regal heraus.\n");
      clone_object( NPC "ratte" )->move( TO, M_SILENT|M_NOCHECK);
      ob->finde_ratte(2);
      return 1;
    }
    write(BS("Leider war keine Ratte hinter der Flasche. Du musst Dich "
          "getaeuscht haben."));
    return 1;    
  }
  return 0;
}

string det_regal()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) )
  {
    if( ob->check_ratte(2) )
    {
      return BS(
          "In den Regalen werden die Weinflaschen gelagert. Eine Weinflasche "
          "scheint sich zu bewegen.");
    }
  }
  return "In den Regalen werden die Weinflaschen gelagert.\n";
}

string det_flasche()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) )
  {
    if( ob->check_ratte(2) )
    {
      return BS(
          "Eine Weinflasche scheint sich zu bewegen. Ob sich da etwas hinter der "
          "Weinflasche befindet?");
    }
  }
  return "In den Flaschen werden wohl die teuren Weine gelagert.\n";
}
 
string det_hinter_flasche()
{
  object ob;
  if( (ob=present( "\nrattenfaengerquest", TP)) )
  {
    if( ob->check_ratte(2) )
    {
      return BS(
          "Hinter der Weinflasche ist eine Ratte. Ob sie herauskommt, wenn Du die "
          "Weinflasche wegschiebst?");
    }
  }
  return "Hinter den Weinflaschen ist nichts.\n";
}
