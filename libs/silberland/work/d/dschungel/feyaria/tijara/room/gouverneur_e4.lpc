varargs void most_improved(int flag, int mode, int month)
{
  int *n;
  int i, j, k;
  int flag2;
  int counter;
  string result;
  string *winner;
  string news_text;
  mixed *art;
  object ob;
  object pl;
  string datum;

/*
   if (mode && !PO_IS_CRON)
    return;
  if (!TP || !IS_LORD(TP))
    return;
*/

  top_improved = ([]);
  improved = ([]);
  winner = ({});
  update_toplist();
//  walk_mapping(top_xp, #'xp_check);
//  walk_mapping(top_fp, #'fp_check);
//  walk_mapping(top_ek, #'ek_check);
  if (month)
    walk_mapping(top_all, #'all_check2);
  else
    walk_mapping(top_all, #'all_check);
  if(flag == 2)
    walk_mapping(improved, #'improved_check2);
  else
    walk_mapping(improved, #'improved_check);
//  printf("%O\n", top_improved);
  n = sort_array(m_indices(top_improved), #'<);
  result = sprintf("\n%s\n", dtime());
  result += "*********************************MIPot"+
    (month ? "M" : "W") +"**********************************\n";
  counter = 0;
  for(i = 1, j = sizeof(n); i <= j; i++)
  {
    flag2 = 0;
    if(flag == 1)
      result += sprintf("%2d. %3d (%@s)\n", i, n[i-1], top_improved[n[i-1]]);
    else
    {
      for(k = sizeof(top_improved[n[i-1]]) - 1;k >= 0 ; k--)
      {
        if(!flag2) 
        {
          result += sprintf("%2d. %4d ", i+counter, n[i-1]);
          flag2 = 1;
        }
        else
        {
          result += "         ";
          counter++;
        }
        if (sizeof(winner) < 5)
        {
          pl = find_player(lower_case(top_improved[n[i-1]][k])) || 
               find_netdead(lower_case(top_improved[n[i-1]][k]));
          if (member(EXCLUDED, top_improved[n[i-1]][k]) == -1 && 
              (!pl || 
              !mappingp(pl->QueryProp(P_WARNINGS)) || 
              !sizeof(pl->QueryProp(P_WARNINGS))))
            winner += ({capitalize(top_improved[n[i-1]][k])});
        }
        result += sprintf("%-16s %1d Level %6d kXP %6d kLXP %3d Kerben %3d FPs\n",
            top_improved[n[i-1]][k] + "(" + top_all[top_improved[n[i-1]][k]] + ")", 
            improved[top_improved[n[i-1]][k],0],
            improved[top_improved[n[i-1]][k],1]/1000,
            improved[top_improved[n[i-1]][k],5]/1000,
            improved[top_improved[n[i-1]][k],3],
            improved[top_improved[n[i-1]][k],2]);
      }
    }
  }
  if(!mode)
    write(result);
  else
  {
    if (month)
    {
      write_file(SAVEDIR "mipotm", result);
      datum = dtime(time() - 3600)[9..16];
      mwinners[datum] = winner[0];
      copy_infos(1);
      return;
    }
    write_file(SAVEDIR "mipotw", result);
    news_text = sprintf("Diese Woche geht der goldene Jaguar an:\n\n%s!\n\n"
        "Herzlichen Glueckwunsch!\n\nAuf den Plaetzen: %s, %s, %s und %s.\n\n"
        "Der Gouverneur von Tijara.\n",
        winner[0], winner[1], winner[2], winner[3], winner[4]);
    art = ({ "d.dschungel", "Gouverneur", 0, 0, 
        "Verleihung des goldenen Jaguars an " + winner[0], news_text});
    NEWSSERVER->WriteNote(art,1);
    InformPlayers("d.dschungel", "gouverneuer", 
        "* Extrablatt! Neuer Artikel ueber die Verleihung des goldenen Jaguars!\n");
    datum = dtime()[9..16];
    if (!member(winners, datum))
      winners += ([datum: ({})]);
    winners[datum] += ({winner[0]});
    copy_infos();
    if (ob = find_object(OBJ "golden_jaguar"))
      ob->remove();
    call_other(OBJ "golden_jaguar", "???");
    if (ob = find_object(OBJ "golden_jaguar"))
    {
      if ((pl = find_player(lower_case(winner[0]))) || 
          (pl = find_netdead(lower_case(winner[0]))))
      {
        tell_object(pl,
            "Der Gouverneur von Tijara kommt an.\n"
            "Der Gouverneur von Tijara gratuliert Dir.\n"
            "Der Gouverneur von Tijara ueberreicht Dir den goldenen Jaguar.\n"
            "Der Gouverneur von Tijara winkt.\n"
            "Der Gouverneur von Tijara verschwindet wieder.\n");
        ob->move(pl, M_NOCHECK);
      }
    }
  } 
}

void golden_jaguar()
{
  CRON_ONLY;
  most_improved(0,1);
}

void golden_jaguar_month()
{
  CRON_ONLY;
  most_improved(0,1,1);
}

nosave void InformPlayers(string group,string player,string text)
{
  object *players;
  int i, invis;
  mixed data;
  string ig;

  players = users();
  ig = lower_case(player) + ".news";
  for (i = sizeof(players) - 1; i >= 0; i--) 
  {
    data = players[i]->QueryProp(P_WAITFOR);
    if (pointerp(data) && (member(data,"Zeitung") > -1)) 
    {
      data = players[i]->QueryProp(P_READ_NEWS);
      if (mappingp(data) && (data[group] > 0)) 
      {
	data = players[i]->QueryProp(P_IGNORE);
	if ((!pointerp(data)) || (member(data,ig) == -1))
	  tell_object(players[i], text);
      }
    }
  }
}

string write_winners()
{
  string ret;
  string *dates;
  int i, j, m;

  ret = "";
  dates = ({"Mai 2004", "Jun 2004", "Jul 2004", "Aug 2004", "Sep 2004", 
      "Okt 2004", "Nov 2004", "Dez 2004", "Jan 2005", "Feb 2005", "Mar 2005",
      "Apr 2005", "Mai 2005", "Jun 2005", "Jul 2005", "Aug 2005", "Sep 2005",
      "Okt 2005", "Nov 2005", "Dez 2005", "Jan 2006", "Feb 2006", "Mar 2006",
      "Apr 2006", "Mai 2006", "Jun 2006", "Jul 2006", "Aug 2006", "Sep 2006",
      "Okt 2006", "Nov 2006", "Dez 2006"});
  for (i = 0; i < sizeof(dates); i++)
  {
    if (member(winners, dates[i]))
    {
      ret += dates[i] + ": ";
      m = sizeof(winners[dates[i]]) - 1;
      for (j = 0; j <= m; j++)
      {
        ret += winners[dates[i]][j];
        if (j == m )
          ret += ".\n";
        else if (j == m - 1)
          ret += " und ";
        else
          ret += ", ";
          
      }
    }
  }
  return ret;
}
