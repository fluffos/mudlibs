void all_check(string player, int level, string guild, int xp, int lxp, 
               int fp, int kerben, int age)
{
  if(!member(old, player))
    return;
  if(!member(improved, player))
    improved += ([player: 0; 0; 0; 0; 0; 0]); // level, xp, fp, ek, stufe, lxp
  improved[player, 0] = level - old[player, 0];
  improved[player, 1] = xp - old[player, 2];
  improved[player, 2] = fp - old[player, 4];
  improved[player, 3] = kerben - old[player, 5];
  improved[player, 4] = level;
  improved[player, 5] = lxp - old[player, 3];
}

void all_check2(string player, int level, string guild, int xp, int lxp, 
               int fp, int kerben, int age)
{
  if(!member(month, player))
    return;
  if(!member(improved, player))
    improved += ([player: 0; 0; 0; 0; 0; 0]); // level, xp, fp, ek, stufe, lxp
  improved[player, 0] = level - month[player, 0];
  improved[player, 1] = xp - month[player, 2];
  improved[player, 2] = fp - month[player, 4];
  improved[player, 3] = kerben - month[player, 5];
  improved[player, 4] = level;
  improved[player, 5] = lxp - month[player, 3];
}

void improved_check(string player, int level, int xp, int fp, int ek, int stufe, int lxp)
{
  int rating;

  if( (rating = level * stufe / 4 + xp / 1000000 + lxp / 3000000 + fp + ek) > 0)
  {
    if(member(top_improved, rating))
      top_improved[rating] += ({player});
    else
      top_improved[rating] = ({player});
  }
}

void improved_check2(string player, int level, int xp, int fp, int ek, int stufe, int lxp)
{
  int rating;

  if( (rating = (stufe + 20) * (level * stufe / 3 + xp / 1000000 + lxp / 3000000 + fp + ek)) > 0)
  {
    if(member(top_improved, rating))
      top_improved[rating] += ({player});
    else
      top_improved[rating] = ({player});
  }
}

#define EXCLUDED ({"purpur"})

