int sort_func(string name1, string name2)
{
  if(top_all[name1,2]/10+top_all[name1,3]/10 > top_all[name2,2]/10+top_all[name2,3]/10 )
    return 1;
  return 0;
}

int sort_func_xp(string name1, string name2)
{
  if(top_all[name1,2] > top_all[name2,2] )
    return 1;
  return 0;
}

int sort_func_lost(string name1, string name2)
{
  if(top_all[name1,3] > top_all[name2,3] )
    return 1;
  return 0;
}

int sort_func2(string name1, string name2)
{
  if( (top_all[name1,2]/10+top_all[name1,3]/10)/(top_all[name1,6]*100) >
          (top_all[name2,2]/10+top_all[name2,3]/10)/(top_all[name2,6]*100) )
    return 1;
  return 0;
}

int xpliste(string str)
{
  int i;
  string nam,gild,output;
  string *top;

  if(str == "schnitt")
  {
    top=sort_array(m_indices(top_all), "sort_func2", TO );
    output="\n    Die besten Metzler des ganzen SilberLandes (XP-Schnitt pro Stunde)\n\n"
      "Nr.      Name         Gilde        XP     Lost XP    Total  Online  Schnitt\n"
      "---------------------------------------------------------------------------\n";
    for(i=sizeof(top);i--;i>=0)
    {
      if((sizeof(top)-i) > 100) break;
      nam=top[i];
      gild=top_all[nam,1] || "abenteurer";
      if(top_all[nam,6] < 230000)
        output+=sprintf("%3d. %11|s %13|s  %4dM     %4dM      %4dM   %4dd  %4dk/h\n", 
          sizeof(top)-i, CAP(nam), CAP(gild), 
          top_all[nam,2]/1000000,top_all[nam,3]/1000000, 
          top_all[nam,2]/1000000+top_all[nam,3]/1000000, top_all[nam,6]/24,
          (top_all[nam,2]+top_all[nam,3])/(top_all[nam,6]*1000) );
    }
  }
  else
  {
    if(str == "xp")
      top=sort_array(m_indices(top_all), "sort_func_xp", TO );
    else if(str == "lost")
      top=sort_array(m_indices(top_all), "sort_func_lost", TO );
    else
      top=sort_array(m_indices(top_all), "sort_func", TO );
    output="\n        Die besten Metzler des ganzen SilberLandes\n\n"
      "Nr.      Name         Gilde      Erfahrung    verlorene Erfahrung  Gesamt \n"
      "--------------------------------------------------------------------------\n";
    for(i=sizeof(top);i--;i>=0)
    {
      if((sizeof(top)-i) > 100) break;
      nam=top[i];
      gild=top_all[nam,1] || "abenteurer";
      output+=sprintf("%3d. %11|s %13|s  %10d     %10d      %9d%1d\n", 
          sizeof(top)-i, CAP(nam), CAP(gild), 
          top_all[nam,2],top_all[nam,3], 
          (top_all[nam,2]/10+top_all[nam,3]/10),
          (top_all[nam,2]%10+top_all[nam,3]%10)%10);
    }
  }
  TP->More(output);
  return 1; 
} 

int fpsort_func(string name1, string name2)
{
  if(top_all[name1,4] > top_all[name2,4] )
    return 1;
  return 0;
}

int fpliste(string str)
{
  int i;
  string nam,gild,output;
  string *top;

  if( !IS_ARCH(TP) ) return 0;
  top=sort_array(m_indices(top_all), "fpsort_func", TO );
  output="\n        Die besten Forscher des ganzen SilberLandes\n\n"
 "Nr.     Name         Gilde        Stufe         Forscherpunkte\n"
 "--------------------------------------------------------------\n";
  for(i=sizeof(top);i--;i>=0)
  {
    if((sizeof(top)-i) > 100) break;
    nam=top[i];
    gild=top_all[nam,1] || "abenteurer";
    output+=sprintf("%3d. %11|s %13|s     %3d      %10d\n", 
        sizeof(top)-i, CAP(nam), CAP(gild), top_all[nam,0],top_all[nam,4] );
  }
  TP->More(output);
  return 1; 
} 

int eksort_func(string name1, string name2)
{
  if(top_all[name1,5] > top_all[name2,5] )
    return 1;
  return 0;
}

varargs int ekliste(string str, int nr)
{
  int i;
  string nam,gild,output;
  string *top;

  if( IS_ARCH(TP)  || (!IS_LEARNER(TP) &&  
        "/obj/erzsehermaster"->check("Erzseher", TP, query_verb(), ""))) 
  {
    if (!nr) nr = 100;
    top=sort_array(m_indices(top_all), "eksort_func", TO );
    output="\n        Die besten Kerbenjaeger des ganzen SilberLandes\n\n"
      "Nr.     Name         Gilde        Stufe         Kerben\n"
      "--------------------------------------------------------------\n";
    for(i=sizeof(top);i--;i>=0)
    {
      if((sizeof(top)-i) > nr) break;
      nam=top[i];
      gild=top_all[nam,1] || "abenteurer";
      output+=sprintf("%3d. %11|s %13|s     %3d      %10d\n", 
          sizeof(top)-i, CAP(nam), CAP(gild), top_all[nam,0],top_all[nam,5] );
    }
    TP->More(output);
    return 1; 
  }
  return 0; 
} 

nosave void toplist_update(object pl)
{
  int level, xp, lxp, ep, i, anz, age;
  string guild, kerben; 
  mapping ret;
  
  guild = pl->QueryProp(P_GUILD);
  level = pl->QueryProp(P_LEVEL);
  age = pl->QueryProp(P_AGE)/1800;  // Onlinezeit in Stunden
  xp = pl->QueryProp(P_XP);
  lxp = pl->QueryProp(P_TOTAL_LOST_XP);
/*  
  if( xp + lxp > 50 * 1000000) 
    top_xp += ([getuid(pl): xp; lxp; guild; age]);

  if( (ep = pl->QueryProp(P_EP_NUM)) > 600 )
    top_fp+=([getuid(pl): level; ep; guild]);
*/
  ep = pl->QueryProp(P_EP_NUM);
  kerben = pl->QueryScores();
  anz = 0;
  for (i = 6 * strlen(kerben) - 1; i > 0; i--) 
  {
    if (test_bit(kerben, i) &&
        (ret = NPCMASTER->QueryNPCbyNumber(i)) &&
        ret[NPC_SCORE] > 0) 
      anz++;
  }
//  if(anz > 300)
//    top_ek += ([getuid(pl): level; anz; guild]);

  top_all += ([getuid(pl): level; guild; xp; lxp; ep; anz; age]);
}

void update_toplist()
{
  int i;
  object *u;
  
  u=users();
  for(i = sizeof(u) - 1; i >= 0; i--)
    if( IS_SEER(u[i]) && !IS_LEARNER(u[i]) && !u[i]->QueryProp(P_TESTPLAYER) )
      toplist_update(u[i]);
  save_object(SAVEDIR "xp_top");
}

void reset()
{
  ::reset();
  update_toplist();
  set_next_reset(5*60);
}

nosave varargs void copy_infos(int m)
{
//  old_xp = copy_mapping(top_xp);
//  old_fp = copy_mapping(top_fp);
//  old_ek = copy_mapping(top_ek);
  if (m)
    month = copy_mapping(top_all);
  else
    old = copy_mapping(top_all);
  save_object(SAVEDIR "xp_top");
}

