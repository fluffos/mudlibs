void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Gouverneur von Tijara" );
  SetProp( P_INT_LONG, BS(
    "Der Gouverneur von Tijara hat seine Villa mit den Einnahmen seiner "
    "Obstplantagen zum schoensten Gebaeude in Tijara ausgebaut. Alles "
    "besteht aus den edelsten Materialien. Der Boden ist aus feinstem "
    "Marmor, die Waende sind mit wertvollen Gemaelden geschmueckt und auf "
    "der Decke befindet sich eine wundervolle Stuckarbeit. Der " 
    "Ausgang fuehrt nach Westen auf den Hauptplatz zurueck. Ueber eine "
    "Stiege kann man den Keller betreten. Nach hinten geht es in das "
    "Arbeitszimmer des Gouverneurs.")+
    "An der Wand faellt Dir eine lange Liste auf.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "boden"}),
    "Der Boden besteht aus feinstem Marmor.");
  AddDetail( ({"marmor", "materialien", "material"}),
    "Es handelt sich um den extrem teuren Silbermarmor, der im SilberLand "
    "nur ganz selten vorkommt.");
  AddDetail( ({"silberland", "welt"}),
    "Die ganze Welt um Dich ist das SilberLand.");
  AddDetail( ({"silbermarmor"}),
    "Der Silbermarmor ist so teuer, weil er mit lauter kleinen Silberteilchen "
    "durchsetzt ist. Daher funkelt der Boden auch so.");
  AddDetail( ({"silberteilchen", "teilchen"}),
    "Die Silberteilchen im Marmor funkeln. Bei der Menge an Silber verstehst "
    "Du den Wert dieses Marmors.");
  AddDetail( ({"menge", "silber"}),
    "Diese Menge Silber hat sicher eine grossen Wert.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind mit wertvollen Gemaelden geschmueckt. An einer Wand "
    "haengt die Liste aller Seher, die es im SilberLand je gegeben hat.");
  AddDetail( ({"liste", "seherliste", "seher"}),
    "Du kannst die Seherliste lesen.");
  AddReadDetail( ({"liste", "seherliste"}), #'seherliste);
  AddDetail( ({"gemaelde", "bilder", "bild"}),
    "An den Waenden haengen viele Bilder, die Szenen aus dem Dschungel "
    "zeigen. Einige von ihnen sind echte Kunstwerke. Ein Bild zeigt einen "
    "gigantischen schwarzen Drachen, der in einer Hoehle eingesperrt ist.");
  AddDetail( ({"drachen", "drache", "hoehle"}),
    "Der Drache auf dem Bild schaut erschreckend realistisch aus. Vor allem "
    "sein rechtes Auge flackert im hellen Licht.");
  AddDetail( ({"licht"}),
    "Es ist sehr hell hier.");  
  AddDetail( ({"auge"}),
    "Das rechte Auge des Drachen schaut wie ein Knopf aus.");
  AddDetail( ({"knopf"}),
    "Tja, was kann man wohl mit einem Knopf machen.....");
      
  AddDetail( ({"kunstwerke", "kunstwerk"}),
    "Einige Gemaelde kann man wahrlich als Kunstwerke bezeichnen. Man glaubt "
    "fast, wirklich mitten im Dschungel zu stehen. Sicher muessen diese "
    "Bilder ein Vermoegen wert sein.");
  AddSpecialDetail( ({"szene", "szenen", "dschungel", "erlebnisse"}), "szenen");
  AddDetail( ({"vermoegen", "reichtum", "wert", "besitz", "einnahmen", 
               "steuern"}),
    "Der Gouverneur ist wohl aus seinen Einnahmen von den Plantagen und aus "
    "den Steuern zu solch einem Reichtum gekommen.");
  AddDetail( ({"platage", "plantagen", "obstplantage", "obstplantagen"}),
    "Auf den Obstplantagen werden viele Fruechte gezuechtet. Sie liegen im "
    "Sueden von Tijara und sind alle im Besitz des Gouverneurs.");
  AddDetail( ({"obst", "fruechte", "frucht"}),
    "Die verschiedensten Fruechte werden auf den Plantagen angebaut, unter "
    "anderem Ananas, Bananen, Mangos und Papayas.");
  AddDetail( ({"ananas", "banane", "bananen", "mango", "mangos", "papaya",
               "papayas"}),
    "Diese Fruechte werden auf den Plantagen angebaut.");
  AddDetail( ({"decke"}),
    "Auf der Decke befindet sich eine wundervolle Stuckarbeit.");
  AddDetail( ({"stuck", "stuckarbeit"}),
    "Die Stuckarbeit an der Decke ist wahrlich wundervoll. Leider kannst Du "
    "nicht erkennen, was all diese verschnoerkelten Figuren darstellen "
    "sollen.");
  AddDetail( ({"figuren", "figur", "schnoerkel"}),
    "Du kannst leider nicht erkennen, was die Figuren darstellen sollen.");
  AddDetail( ({"tijara", "stadt"}),
    "Du befindest Dich in der Stadt Tijara.");
  AddDetail( ({ "villa", "gebaeude" }), 
    "Das ist die Villa des Gouverneurs von Tijara.");
  AddDetail( ({ "westen", "ausgang" }), 
    "Der Ausgang fuehrt nach Westen auf den Hauptplatz zurueck.");
  AddDetail( ({ "platz", "hauptplatz" }), 
    "Der Hauptplatz ist ausserhalb der Villa.");
  AddDetail( ({ "norden", "nordosten", "osten", "suedosten", "sueden",
                "suedwesten", "nordwesten"}), 
    "In diese Richtung kannst Du nicht gehen, es sei denn, Du willst mit "
    "Deinem Kopf eine Hausmauer einrennen.");
  AddDetail( ({"stiege", "treppe", "keller"}),
    "Ueber eine Stiege kann man den Keller betreten.");
  AddDetail( ({"hinten", "arbeitszimmer"}),
    "Nach hinten geht es ins Arbeitszimmer des Gouverneurs.");
   
  AddCmd( ({"drueck", "druecke"}), "druecken");
  
  AddExit( "westen", "./platz_d4" );
  AddExit( "unten", #'keller ); 
  AddExit( "hinten", ([
           EX_DEST: "./hinten",
           EX_TESTFUNC: "hinten"]) );

  AddItem( NPC "gouverneur", REFRESH_DESTRUCT);
  
  AddCmd( ({"xpliste"}), "xpliste");
  AddCmd( ({"fpliste"}), "fpliste");
  AddCmd( ({"ekliste", "kerbenliste"}), "ekliste");

  SUID;
  restore_object(SAVEDIR "xp_top");
  if(!sizeof(top_all)) top_all = ([]);
  if(!sizeof(old)) old = ([]);
}

int keller()
{
  if( !present(RATTENQUESTID ,TP) && !IS_ELDER(TP) )
  {
    write("Du hast keine Erlaubnis, den Keller zu betreten.\n");
    return 0;
  } 
  write("Du gehst ueber die Stiege in den Keller hinunter.\n");
  say(TP->Name(WER,1)+" geht ueber die Stiege in den Keller hinunter.\n");
  TP->move(ROOM "keller/e4:"+getuid(TP), M_GO|M_SILENT);
  return 1;
}

int hinten()
{
  mixed *ef;
  if(TP->QueryQuest(RATTENQUEST) && !GARDEMASTER->IsFeind(TP) )
  {
    if( find_living("elsurion") )
    {
      ef= (find_living("elsurion")->QueryEnemies())[0]; 
      if( member(ef, TP ) !=-1 ) 
      {
        write("Eine magische Kraft haelt Dich ab.\n");
        return 0;
      }
    }  
    return 1;
  }
  else
  {
    write("Du hast keine Erlaubnis, das Arbeitszimmer zu betreten.\n");
    return 0;
  }  
}

string szenen()
{
    return BS("Die Szenen auf den Bildern erinnern Dich an Deine eigenen "
      "Erlebnisse im Dschungel. Fast glaubt "+ 
      (TP->QueryProp(P_GENDER)==FEMALE ? "frau, frau" : "man, man" )+ 
      " stuende selbst im Dschungel.");
}

string seherliste()
{
  write("    DIE LISTE ALLER SEHER, DIE JE IM SILBERLAND SPIELTEN\n");
  TP->More("/etc/all_time_seherliste.read",1);
  return "";
}

int druecken(string str)
{
  notify_fail("Was willst Du druecken?\n");
  if(str != "knopf" ) return 0;
  call_other(ROOM "kult", "open_secret_door" );
  write("Du drueckst auf das Drachenauge und ein Rumpeln ertoent unter Deinen "
      "Fuessen.\n");
  say(CAP_TPN+" fummelt an einem Bild herum und es rumpelt unter Deinen "
      "Fuessen.\n");
  return 1;
}

void init()
{
  ::init();
}
