// /d/dschungel/feyaria/tijara/armour/medaille.c
// Die Tapferkeitsmedaille fuer die Stadtgardisten von Tijara
// 25-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Tapferkeitsmedaille von Tijara");
  SetProp(P_LONG, BS( 
    "Das ist die Tapferkeitsmedaille von Tijara. Nur die Veteranen unter "
    "den Gardisten tragen diese Auszeichnung.") );
  SetProp(P_NAME, "Tapferkeitsmedaille");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 1750);
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 2000);

  AddId( ({"medaille", "tapferkeitsmedaille", "\ntapferkeitsmedaille"}) );

}

int WearFunc(object me)
{
  int wimpy;
  write("Du fuehlst Dich auf einmal viel tapferer.\n");
  if( wimpy=TP->QueryProp(P_WIMPY) )
      TP->SetProp(P_WIMPY, wimpy/2);
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if (member(dam_type, DT_TERROR) != -1) {
    TakeFlaw(DT_TERROR);
    return 15+random(20);
  }
  return 0;
}

string extra_look()
{
  if( QueryProp(P_WORN))
  return( CAP(ENV(TO)->QueryPronoun(WER))+" traegt "+
    ENV(TO)->QueryPossPronoun(FEMALE, WEN, SINGULAR)+ " Tapferkeitsmedaille "
    "voller Stolz.\n");
  else
    return "";
}
