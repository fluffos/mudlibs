// /d/dschungel/feyaria/tijara/armour/amulett.c
// Schutzamulett gegen den Todeszauber
// 14-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Schutzamulett");
  SetProp(P_LONG, BS( 
    "Dieses Amulett schaut aus wie ein Talisman, vielleicht kann es Dich "
    "ja vor bestimmten Gefahren schuetzen. Es besteht aus einem langen "
    "Lederband an dem eine winzige Goldkugel haengt. Einige glaenzende "
    "Edelsteine glitzern auf dem Goldkuegelchen.") );
  SetProp(P_INFO, BS(
    "Dieses Amulett kann einen ganz maechtigen Zauberspruch abwehren.") );
  SetProp(P_NAME, "Schutzamulett");
  SetProp(P_GENDER, NEUTER);
  SetProp (P_ARMOUR_TYPE, AT_AMULET );
  SetProp (P_AC, 2);
  SetProp (P_QUALITY_DECAY, 250);
  SetProp(P_MATERIAL, ([MAT_GOLD:9, MAT_LEATHER:79, MAT_RUBY:4, 
                        MAT_EMERALD:4, MAT_SAPPHIRE:4]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);

  AddDetail( ({"edelstein", "edelsteine", "rubin", "smaragd", "saphir"}),
    "Es handelt sich um einen Rubin, einen Smaragd und einen Saphir.");
  AddId( ({"amulett", "schutzamulett", "talisman", "\ntodeszauberschutz"}) );
}
