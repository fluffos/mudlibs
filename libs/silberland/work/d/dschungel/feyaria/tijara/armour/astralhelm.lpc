// /d/dschungel/feyaria/tijara/armour/bronzepanzer.c
// Ein Bronzepanzer fuer die Stadtgardisten von Tijara
// 30-10-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein rubinverstaertker Astralhelm der Kontrolle");
  SetProp(P_LONG, BS( 
    "Dieser Astralhelm hilft Dir, fremde Wesen zu kontrollieren. Er "
    "benutzt die geheimen Kraefte des Rubins.\n"
    "Er wurde von Feyaria beschworen.\n") );
  SetProp(P_NAME, ({"Astralhelm der Kontrolle","Astralhelms der Kontrolle", 
        "Astralhelm der Kontrolle", "Astralhelm der Kontrolle"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, MAT_RUBY );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 700000);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5,T_HEAT_PROT:5]) );  
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:2]) );

  AddId( ({"helm", "astralhelm"}) );

  SetProp (P_WEAR_RESTRICTIONS, ([P_LEVEL: 99]));
}

