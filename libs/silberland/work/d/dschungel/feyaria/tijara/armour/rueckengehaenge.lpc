// Ein Rueckengehaenge fuer zwei Waffen
// 1998-10-24 Feyaria@SilberLand

#include "../def.h"

inherit "std/container";
inherit "std/armour";

object rechts, links;

void create()
{
  if( !is_clone(TO) ) return;
  armour::create();
  container::create();
  
  SetProp(P_SHORT, "Ein Rueckengehaenge");
  SetProp(P_LONG,  
    "Dieses Rueckgehaenge besteht aus zwei Lederriemen, an denen je eine "
    "Scheide fuer eine Waffe befestigt ist. Man kann so ganz bequem zwei "
    "Waffen am Ruecken tragen und diese auch sehr schnell wechseln.");
  SetProp(P_NAME, "Rueckengehaenge");
  SetProp(P_INFO, BS(
    "Mittels 'wechsel links' oder 'wechsel rechts' kann man die gerade "
    "gezueckte Waffe mit der im Rueckengehaenge wechseln."));
  SetProp(P_GENDER, NEUTER);
  AddId( ({"gehaenge", "rueckengehaenge", "\nrueckengehaenge"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 800);
  SetProp(P_MAX_WEIGHT, 30000);
  SetProp(P_WEIGHT_PERCENT, 25);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_TEXT,
      ({ "Du haengst Dir %s um.\n",
       " haengt sich %s um.\n" }) );
  SetProp(P_UNWEAR_TEXT,
      ({ "Du ziehst %s aus.\n",
       " zieht %s aus.\n" }) );

  AddCmd( ({"wechsel", "wechsle" }), "waffenwechsel");
}

int change_weapon(object weapon1, object weapon2)
{
  object wer;

  wer = QueryProp(P_WORN);
  if( weapon1 && (weapon1->QueryProp(P_NODROP) || weapon1->QueryProp(P_CURSED)) ) {
    write("Du kannst "+weapon1->name(WEN,1)+" nicht ins Rueckengehaenge "
        "stecken!\n");
    return -4;
  }
  if( weapon1 ) weapon1->DoUnwield(1);
  if( weapon1 && weapon1->QueryProp(P_WIELDED) ) {
    write("Du kannst "+weapon1->name(WEN,1)+" nicht wegstecken.\n");
    return -1;
  }
  if( (weapon2->move(wer, M_GET)) == ME_TOO_HEAVY ) { 
    write("Du kannst "+weapon2->name(WEN,1)+" nicht mehr tragen.\n");
    if(weapon1) weapon1->wield_me(1);
    return -2;
  }
  if( weapon1 )  
    weapon1->move(TO, M_PUT);
  if( weapon2->wield_me(1) != 1 ) {
    write("Du kannst "+weapon2->name(WEN,1)+" nicht zuecken.\n");
    return -3;
  }
  if( weapon1 ){
    write(BS("Du steckst "+weapon1->name(WEN,1)+" in das Rueckengehaenge und " 
      "zueckst "+weapon2->name(WEN,1)+"."));
    say(BS(wer->Name(WER)+" steckt "+weapon1->name(WEN)+" in "+
      wer->QPP(NEUTER,WEN,SINGULAR)+" Rueckengehaenge und zueckt "+
      weapon2->name(WEN)+"."), ({wer}) );
  }
  else {
    write(BS("Du nimmst "+weapon2->name(WEN,1)+" aus dem Rueckengehaenge und " 
      "zueckst "+weapon2->QueryPronoun(WEN)+"."));
    say(BS(wer->Name(WER)+" nimmt "+weapon2->name(WEN)+" aus "+
      wer->QPP(NEUTER,WEM,SINGULAR)+" Rueckengehaenge und zueckt "+
      weapon2->QueryPronoun(WEN)+"."), ({wer}) );
  }
  return 1;
}

int waffenwechsel(string str)
{
  object weapon1, weapon2;
  
  notify_fail("SYNTAX: wechsel <rechts|links>\n");
  if( !str ) return 0;
  if( !QueryProp(P_WORN) ) return 0;
  weapon1 = QueryProp(P_WORN)->QueryProp(P_WEAPON);
  if( str == "links" )
  {
    if( weapon2 = links )
      change_weapon(weapon1, weapon2);
    else
      write("Du hast keine Waffe in der linken Scheide.\n");
    return 1;
  }
  else if( str == "rechts" )
  {
    if( weapon2 = rechts )
      change_weapon(weapon1, weapon2);
    else
      write("Du hast keine Waffe in der rechten Scheide.\n");
    return 1;
  }
  else
    return 0;
}  

varargs int PreventInsert(object ob) 
{
  if ( !(TO->QueryWorn()) ) {
    write("Du musst das Rueckgehaenge am Ruecken tragen.\n");
    return 1;
  }
  if (file_name(ob)[0..32] == "/p/daemon/itemd/charge_functions/")
    return ::PreventInsert(ob); 
  if ( !ob->QueryProp(P_WEAPON_TYPE) ) {
    write("Du kannst nur Waffen in das Rueckengehaenge stecken.\n");
    return 1;
  }
  if( rechts && links ) {
    write("Mehr als zwei Waffen passen nicht in das Rueckengehaenge.\n");
    return 1;
  }
  if( rechts ) {
    links=ob;
    write(ob->Name(WER,1)+ " findet in der linken Scheide Platz.\n");
  }
  else {
    rechts=ob;
    write(ob->Name(WER,1)+ " findet in der rechten Scheide Platz.\n");
  }
  return ::PreventInsert(ob); 
}

varargs int PreventLeave(object ob, mixed dest)
{
  if( ob==links )
    links=0;
  else if( ob==rechts )
    rechts=0;
  else if (file_name(ob)[0..32] == "/p/daemon/itemd/charge_functions/")
    ;
  else
    write( "BUG!!!!! "+ob->Name()+" darf gar nicht im Rueckengehaenge sein!\n");
  return ::PreventLeave(ob, dest);
}

void init()
{
  container::init();
  armour::init();
}

varargs string long() 
{
  string descr;

  descr = process_string(armour::long());
  descr += "Die rechte Scheide "+
    (rechts?"enthaelt "+rechts->name(WEN):"ist leer")+".\n"+
    "Die linke Scheide "+
    (links?"enthaelt "+links->name(WEN):"ist leer")+".\n";
  return descr;
}

string short()
{
  return QueryProp(P_SHORT) + (QueryProp(P_WORN) ? " (am Ruecken).\n" : ".\n");
}

varargs int remove(int silent)
{
  DoUnwear(silent);
  if (!QueryProp(P_WORN))
    return container::remove(silent);
}

varargs move(mixed dest, int method)
{
  DoUnwear(method & M_SILENT);
  if ((method & M_NOCHECK) || (!QueryProp(P_WORN)))
    return ::move(dest, method);
}

string extra_look()
{
  if( rechts || links )
  return BS(capitalize(environment()->QueryPronoun())+ " traegt "+ 
   ( rechts ? rechts->name(WEN):"" )+
   ( (rechts&&links) ? " und ":"" )+
   ( links ? links->name(WEN):"")+
   " im Rueckengehaenge.");
  else
    return "";
}

