#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein hell schimmerndes magisches Armband");
  SetProp(P_LONG,  
    "Dieses Armband schimmert hell. Sicher ist es magisch..... " );
  SetProp(P_NAME, "Armband");
  SetProp(P_NAME_ADJ, ({"hell schimmernd", "magisch" }) );
  SetProp(P_INFO, BS(
    "Das Armband ist magisch, aber welche Magie darin steckt, musst Du schon "
    "selber herausfinden.") );
  SetProp(P_GENDER, NEUTER);
  AddId( ({"armband", "\nmagic_bracers"}) );
  AddAdjective( ({"hell schimmernd", "magisch", "magisches", 
                  "hell schimmerndes"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  AddProp(P_DAM_PROTECTION, ([DT_MAGIC:3]) );
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:70,MAT_MAGIC:30]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 9000);
  SetProp(P_QUALITY_DECAY, 900 );
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:20, P_LEVEL:30]) );
  SetProp(P_NOBUY,1);
  SetProp(P_MAGIC, 5);
}

void reset()
{
  object who;
  if( !is_clone(TO) ) return set_next_reset(-1);
  ::reset();
  who=QueryProp(P_WORN);
  if( !random(1000) )
  {
    if( who )
      tell_object( who, "Das magische Armband loest sich auf.\n");
    call_out("remove",0);
    return;
  }
  if( who && interactive(who) )
  {
    if( !random(30) )
    {
      tell_object(who,
          "Die Magie des Armbandes versetzt Dich in eine andere Dimension.\n");
          who->move(ROOM "dimension", M_TPORT);
    }
    else
    {
      tell_object(who, "Die Magie des Armbandes heilt Dich.\n");
      who->heal_self(100+random(100));
    }
  }
}


