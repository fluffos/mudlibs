// /d/dschungel/feyaria/tijara/armour/armschienen.c
// Armschienen aus Bronze fuer die Stadtgardisten von Tijara
// 25-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Armschienen aus Bronze");
  SetProp(P_LONG, BS( 
    "Dieser Armschienen aus Bronze schuetzen die Unterarme vor Schlaegen.") );
  SetProp(P_NAME, "Armschienen");
  SetProp(P_NAME_ADJ, "bronzen");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 900);
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE:144, P_FROG:1]) );

  AddId( ({"armschienen", "bronzearmschienen"}) );

  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Ruestungen.\n");

}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if( member(dam_type, ({ DT_RIP, DT_WHIP}) ) != -1)
  {
    return 2+random(3);
  }
  return 0;
}

