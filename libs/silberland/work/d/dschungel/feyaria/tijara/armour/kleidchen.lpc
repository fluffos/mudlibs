// /d/dschungel/feyaria/tijara/armour/kleidchen.c
// ein rosa Kleidchen fuer Feylinchen 
// 1998-09-08  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein rosarotes Kleidchen");
  SetProp(P_LONG, BS( 
    "Ein huebsches rosarotes Kleidchen.") );
  SetProp(P_NAME, "Kleidchen");
  SetProp(P_NAME_ADJ, "rosarot");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 17);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 350);

  AddId( ({"kleid", "kleidchen"}) );
  AddAdjective( ({"rosa", "rosarot", "rosarotes"}) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}

