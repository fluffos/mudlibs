// /d/dschungel/feyaria/tijara/armour/bronzepanzer.c
// Ein Bronzepanzer fuer die Stadtgardisten von Tijara
// 30-10-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Bronzepanzer");
  SetProp(P_LONG, BS( 
    "Dieser Bronzepanzer schuetzt den ganzen Koerper.") );
  SetProp(P_NAME, "Bronzepanzer");
  SetProp(P_INFO, BS(
    "Dieser Panzer haelt nicht nur Schlaege ab, sondern auch die Strahlung "
    "der Sonne. Vielleicht kann er auch Hitze und Feuer abwehren.") );
  SetProp(P_GENDER, MALE);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp (P_AC, 27);
  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1700);
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2,T_HEAT_PROT:0]) );
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:1]) );
  
  AddId( ({"panzer", "bronzepanzer"}) );

  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Ruestungen.\n");
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if (member(dam_type, DT_FIRE) != -1)
  {
    return 17+random(10);
  }
  else
    return 0;
}
