// /d/dschungel/feyaria/tijara/armour/guertel.c
// Guertel des Zauberers Elsurion
// 24-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/container";
inherit "std/armour";
inherit "std/armour/description";

void create()
{
  if( !is_clone(TO) ) return;
  armour::create();
  container::create();
  description::create();
  
  SetProp(P_SHORT, "Der Guertel eines Zauberers");
  SetProp(P_LONG, BS( 
    "Das ist der Guertel eines Zauberers. In seine vielen Taschen kann man "
    "Zauberzutaten und aehnliche kleine Dinge stecken.") );
  SetProp(P_NAME, "Zaubererguertel");
  SetProp(P_INFO, BS(
    "In diesen Guertel kann man kleine Sachen stecken. Aber auch Waffen "
    "und Geld kannst Du da hineinstecken.") );
  SetProp(P_GENDER, MALE);
  AddId( ({"guertel", "zaubererguertel", "\nelsurion_guertel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ({MAT_LEATHER}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 200 );
  SetProp(P_MAX_WEIGHT, 5000);
  Set(P_WEIGHT_PERCENT, 33);
  SetProp(P_NOBUY,1);
  SetProp(P_WEAR_TEXT,
      ({ "Du ziehst %s an.\n",
       " zieht %s an.\n" }) );
  SetProp(P_UNWEAR_TEXT,
      ({ "Du ziehst %s aus.\n",
       " zieht %s aus.\n" }) );

}

string sein(object ob)
{
  return ob->IsPlural() ? " sein " : " ist ";
}

varargs int PreventInsert(object ob) 
{
  if ( !(TO->QueryWorn()) )
  {
    write("Du musst den Guertel anziehen, bevor Du Sachen hineinsteckst.\n");
    return 1;
  }
  if ( ob->QueryProp(P_WC) || (explode(file_name(ob),"#")[0]=="/obj/money") )
    return ::PreventInsert(ob);
  if ( ob->QueryProp(P_AC) && member( ({AT_ARMOUR, AT_HELMET, AT_CLOAK, 
    AT_BOOT, AT_SHIELD, AT_TROUSERS, AT_BRACERS, AT_BELT}),
      ob->QueryProp(P_ARMOUR_TYPE) ) != -1 )
  {
    write(ob->Name(WER,1)+ sein(ob)+ "doch viel zu gross fuer diesen Guertel.\n");
    return 1;
  }
  if ( ob->QueryProp(P_WEIGHT) >= 1000 )
  {
    write(ob->Name(WER,1)+ sein(ob) + "doch viel zu schwer fuer diesen Guertel.\n");
    return 1;
  }
  return ::PreventInsert(ob); 
}

void init()
{
  container::init();
  armour::init();
}

varargs string long() {
  string descr, inv_descr;

  descr = process_string(armour::long());
  if(!QueryProp(P_TRANSPARENT)) return descr;

  inv_descr = make_invlist(TP, all_inventory(TO), 0);
  if ( inv_descr != "" )
    descr += capitalize(QueryPronoun()) + " enthaelt:\n" + inv_descr;
  return descr;
}

string short()
{
  return QueryProp(P_SHORT)+(QueryProp(P_WORN) ?  " (getragen).\n":".\n");
}

varargs int remove(int silent)
{
  DoUnwear(silent);
  if (!QueryProp(P_WORN))
    return container::remove(silent);
}

varargs move(mixed dest, int method)
{
  DoUnwear(method & M_SILENT);
  if ((method & M_NOCHECK) || (!QueryProp(P_WORN)))
    return ::move(dest, method);
}

