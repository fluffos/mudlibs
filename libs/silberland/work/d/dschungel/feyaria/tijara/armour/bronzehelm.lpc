// /d/dschungel/feyaria/tijara/armour/bronzepanzer.c
// Ein Bronzepanzer fuer die Stadtgardisten von Tijara
// 30-10-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Bronzehelm");
  SetProp(P_LONG, BS( 
    "Dieser Bronzehelm schuetzt den Kopf vor Schlaegen und vor der "
    "Strahlung der Sonne.") );
  SetProp(P_NAME, "Bronzehelm");
  SetProp(P_INFO, BS(
    "Dieser Helm haelt nicht nur Schlaege ab, sondern auch die Strahlung "
    "der Sonne. Vielleicht kann er auch Hitze und Feuer abwehren.") );
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 11);
  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 700);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0,T_HEAT_PROT:3]) );  
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:2]) );
  SetProp(P_WORN_TEXT, "aufgesetzt");

  AddId( ({"helm", "bronzehelm"}) );

  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Ruestungen.\n");

}

