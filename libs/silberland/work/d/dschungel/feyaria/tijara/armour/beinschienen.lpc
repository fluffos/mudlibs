// /d/dschungel/feyaria/tijara/armour/beinschienen.c
// Beinschienen aus Bronze fuer die Stadtgardisten von Tijara
// 25-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Beinschienen aus Bronze");
  SetProp(P_LONG, BS( 
    "Diese Beinschienen aus Bronze schuetzen die Oberschenkel vor "
    "Schlaegen.") );
  SetProp(P_NAME, "Beinschienen");
  SetProp(P_NAME_ADJ, "bronzen" );
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 750);
  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE: 144, P_FROG:1]) );

  AddId( ({"beinschienen", "schienen"}) );

  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Ruestungen.\n");

}

