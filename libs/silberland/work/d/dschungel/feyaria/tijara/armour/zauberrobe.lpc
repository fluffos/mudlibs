// Robe des Magiers Elsurion
// 24-11-96   Feyaria@SilberLand
// 05-04-2011 Cleme@SL neue Meldung InFight

#include "../def.h"

inherit "std/armour";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zauberrobe");
  SetProp(P_LONG,  
    "Diese wunderbare Zauberrobe aus himmelblauer Seide ist mit "
    "verschiedenen magischen Symbolen bestickt.");
  SetProp(P_INFO, "Diese Robe hilft bei der Regeneration der Magiepunkte.\n");
  SetProp(P_NAME, "Zauberrobe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"robe", "zauberrobe", "\nelsurion_robe"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  AddProp(P_DAM_PROTECTION, ([DT_MAGIC: 2, DT_LIGHT: 2, DT_POISON: 2]) );
  SetProp(P_QUALITY_DECAY, 150);
  
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT: 23, SR_SEER:1]) );
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_WEAR_TEXT, 
      ({"Du ziehst die Zauberrobe an und sofort stroemt magische Energie in "
       "Deinen\nKoerper. Du fuehlst Dich maechtig wie noch nie!\n",
        " zieht die Zauberrobe an und strahlt eine magische Aura aus.\n"}) );
  
  AddDetail( "seide",
    "Die Seide fuehlt sich ganz weich an.");
  AddDetail( "symbole",
    "Die magischen Symbole haben eine unbekannte Bedeutung.");
}

int WearFunc(object me, int silent)
{
  object ob;
  if (TP->InFight()) 
  {
    if (!silent)
      write("Die Zauberrobe saugt Deine ganze magische Kraft auf.\n"
            "Mitten im Kampf kannst Du sie nicht anziehen!\n");
    TP->SetProp(P_SP, 0);
    return 0;
  }
  while (ob = deep_present("astralring", TP))
  {
    ob->remove();
    write("Ein Astralring zersplittert durch die Macht der Zauberrobe.\n");
  }
 
  if (interactive(MENV)) 
  { 
    while (find_call_out("regeneration")!=-1)
      remove_call_out("regeneration");
    call_out("regeneration",1);
  }
  TP->AddSp(1 + random(7));
  return 1;
}

int RemoveFunc(object me, int silent)
{
  object wer;
  wer = QueryProp(P_WORN);
  while (find_call_out("regeneration") != -1)
    remove_call_out("regeneration");
  if (!silent)
    write("Die Zauberrobe saugt Deine ganze magische Kraft auf.\n");
  if (wer->InFight()) 
    wer->SetProp(P_SP, 0);
  else
    wer->AddSp(-random(200));
  return 1;
}

void regeneration()
{
  int i;
  object wer; 
  wer = QueryProp(P_WORN); 
  while (find_call_out("regeneration") != -1)
    remove_call_out("regeneration");
  if (!TP) return;
  if (!wer) return;
  if (TP != wer) return;
  if (TP->QueryAttribute(A_INT) >= 23)
  {
    TP->AddSp(1);
    i = 18 - (TP->QueryAttribute(A_INT) - 1) / 2;
    call_out("regeneration", i > 2 ? i : 2);
  }
  if (!random(7000)) 
  {
    if (TP->QueryProp(P_SP) == TP->QueryProp(P_MAX_SP))
    {
      write("Ploetzlich saugt die Zauberrobe Deine ganze magische Kraft auf.\n");
      TP->SetProp(P_SP,0);
    }

  }
}

void BecomesNetDead(object wer) 
{
  while (find_call_out("regeneration")!=-1)
    remove_call_out("regeneration");
}

void BecomesNetAlive(object wer) 
{
  if (wer == QueryProp(P_WORN))
    call_out("regeneration", 1);
}

