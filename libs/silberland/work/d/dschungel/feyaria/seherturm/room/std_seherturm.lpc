#include "../def.h"

#define SEERTOWER ROOM "seherturm"

inherit "/std/room";

int nr();

void create()
{
  int n;
  ::create();

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );
  
  AddDetail(({"boden", "decke", "wand", "waende", "stein"}),
      "Boden, Decke und Waende bestehen aus weissem Stein.");
  AddSpecialDetail("treppe", "det_treppe");
  AddSpecialDetail("etage", "det_etage");
  AddDetail(({"turm", "seherturm", "seher"}),
      "In diesem Turm leben viele Seher.");

  SUID;
  n = nr();
  if (n > 1)
    AddExit("unten", "./seherturm" + to_string(n - 1));
  if (file_size(SEERTOWER +  to_string(n + 1) + ".lpc") > 0)
    AddExit("oben", "./seherturm" + to_string(n + 1));
}

int nr()
{
  int x;

  sscanf(file_name(), SEERTOWER + "%d", x);
  return x;
}

string seher()
{
  string *wer;
  int i;
  string *ex;
  mapping x;
  string ret;
  string str;

  wer = ({});
  x = QueryProp(P_EXITS);
  ex = m_indices(x);
  for (i = sizeof(ex) - 1; i >= 0; i--)
    if (ex[i] != "oben" && ex[i] != "unten")
      wer += ({ex[i]});
  if (!sizeof(wer))
    return "Hier wohnt niemand.";
  ret = "";
  for (i = sizeof(wer) - 1; i >= 0; i--)
  {
    sscanf(x[wer[i]], "/d/seher/haus/%s:00:00", str);
    ret += "im " + capitalize(wer[i]) + " wohnt " + capitalize(str);
    if (i >= 1)
      ret += ", ";
    else if (i == 1)
      ret += " und ";
    else
      ret += ".";
  }
  return capitalize(ret);
}

string _query_int_short()
{
  return sprintf("Im Seherturm (%d Etage)", nr());
}

string _query_int_long()
{
  return BS(
      "Du befindest Dich im Seherturm, und zwar auf Etage " + nr() + ". " +
      seher() + " Eine Treppe fuehrt nach unten" +
      (sizeof(m_indices(QueryProp(P_EXITS)) & ({"oben"})) ? " und nach oben" : "") +
      ".");
}

string det_treppe()
{
  return BS(
      "Eine Treppe fuehrt nach unten" +
      (sizeof(m_indices(QueryProp(P_EXITS)) & ({"oben"})) ? " und nach oben" : "") +
      ".");
}

string det_etage()
{
  return "Du befindest Dich auf Etage "+nr()+".\n";
}


