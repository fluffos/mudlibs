// std_froglok.c
// 2002-01-15 Feyaria@SilberLand

inherit "std/mnpc";


#include "../def.h"

void init()
{
  mnpc::init();
  if ( TP && TP->id("FROGLOK")) AddDefender(TP);
}

void create()
{
  if (!is_clone(this_object())) return;
  mnpc::create();

  AddId( ({"FROGLOK", "froglok" }) );
  SetProp(P_RACE, "Froglok");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -150+random(300) );
  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_ACID:-0.3, DT_LIGHTNING:0.3, DT_ELECTRIC:0.2, DT_TERROR:-0.4,
      DT_POISON:-0.5, DT_WATER:-0.9, DT_FIRE:-0.3, DT_COLD:0.2]) );

  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, file_name(interactive(PO) ? ENV(PO) : PO));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS +MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MSGIN, "huepft quakend herein");
  SetProp(P_MSGOUT, "huepft quakend");
  SetProp(P_MMSGIN, "huepft quakend herein");
  SetProp(P_MMSGOUT, "huepft quakend weit weg");
  SetProp(P_DIE_MSG,  " quakt ein letztes mal.\n");

  SetProp(P_LOG_INFO,"feyaria/frogloks");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","quakt: ");
  AddInfo( DEFAULT_INFO, ({
    "quakt etwas.\n",
    "schaut Dich komisch an.\n",
    "quakt laut.\n",
    "kommt sich nicht angesprochen vor.\n",
    "quakt Dich nur veraergert an.\n",
    "quakt etwas unverstaendliches.\n",
    "beachtet Dich nicht.\n",
    "zuckt mit den Schultern.\n"}) );
  
  SUID;
}

void InformDefend(object enemy)
{
  if( !InFight() && random(QueryProp(P_LEVEL))> 10 )
    call_out("kattach",2,enemy);
}

void kattach(object enemy)
{
  if( !InFight() )
  {
    tell_room(MENV, 
        Name(WER,1)+" quakt: Nieder mit den Feinden der Frogloks!\n");
    Kill(enemy);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( (gruppe == "fies" || gruppe == "intim" ) && find_call_out("fies") == -1)
    call_out("fies",0);
  if( (gruppe == "nett" || gruppe == "froehlich") && find_call_out("nett") == -1)
    call_out("nett",0);
  if( (gruppe == "traurig" || gruppe == "aengstlich")
      && find_call_out("traurig") == -1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  if( !present(TP, MENV) ) return;
  tell_room(MENV, Name(WER,1)+ " quakt "+TP->name(WEN)+ " boesartig an.", 
      ({TP, TO}) );
  tell_object(TP, Name(WER,1)+ " quakt Dich boesartig an.\n");
}

void nett()
{
  if( !present(TP, MENV) || random(3) ) return;
  tell_room(MENV, Name(WER,1)+ " quakt "+TP->name(WEN)+ " an.", 
      ({TP, TO}) );
  tell_object(TP, Name(WER,1)+ " quakt Dich an.\n");
}

void traurig()
{
  if( !present(TP, MENV) ) return;
  tell_object(TP, Name(WER,1)+ " lacht Dich aus.\n");
  tell_room(MENV, Name(WER,1)+ " lacht "+TP->name(WEN)+" aus.\n", ({TP, TO}) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "kills",
        dtime(time())+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+
        " umgebracht.( -"+lostexp+" XP )\n");
    if( random(300) < QueryProp(P_LEVEL) )
      call_out("pluendern", 2);
  }
}

void pluendern()
{
  tell_room(MENV, Name(WER,1)+ " pluendert die Leiche.\n");
  command("nimm alles aus leiche");
  command("trage alles");
}

void clone_weapon( string x) 
{ 
  object weapon;

  weapon = clone_object(x);
  weapon->move(this_object(), M_NOCHECK);
  weapon->wield_me();
}

void clone_armour(string x) 
{ 
  object armour;
  string color;

  if (strstr(name(), "Shin")) color = "gruen";
  else if (strstr(name(), "Yan")) color = "gelb";
  else if (strstr(name(), "Jug")) color = "rot";
  else if (strstr(name(), "Qua")) color = "blau";

  armour = clone_object(x);
  armour->SetProp(P_NAME_ADJ, color);
  armour->SetProp(P_SHORT, armour->Name(WER,0));
  armour->AddAdjective( ({color, color+"e", color+"es", color+"en", 
        color+"er", color+"em"}));
  armour->move(this_object(), M_NOCHECK); 
  armour->DoWear();
}

void equip(int w, int a)
{
  object weapon, itemd, ob;
  if( w ) switch(QueryProp(P_LEVEL))
  {
    case 1..8: 
      switch(random(5))
      {
        case 0: clone_weapon("/p/weapon/club/holzstock"); break;     // wc 40
        case 1: clone_weapon("/p/weapon/knife/messer"); break;       // wc 55
        case 2: clone_weapon("/p/weapon/club/knueppel"); break;      // wc 70
        case 3: clone_weapon("/p/weapon/spear/holzspeer"); break;    // wc 65
      }
      break;
    case 9..13: 
      switch( random(5))
      {
        case 0: clone_weapon("/p/weapon/knife/dolch"); break;        // wc 70
        case 1: clone_weapon("/p/weapon/club/keule"); break;         // wc 90
        case 2: clone_weapon("/p/weapon/spear/speer"); break;        // wc 95
        case 3: clone_weapon("/p/weapon/sword/holzschwert"); break;  // wc 90
      }
      break;
    case 14..18: 
      switch(random(3))
      {
         case 0: clone_weapon("/p/weapon/spear/jagdspeer"); break;   // wc 115
         case 1: clone_weapon("/p/weapon/club/dornenkeule"); break;  // wc 115
         case 2: clone_weapon("/p/weapon/whip/peitsche"); break;     // wc 111
       }
       break;
    case 19..23:
       switch(random(3))
       {
         case 0: clone_weapon("/p/weapon/club/stachelkeule"); break;  // wc 137
         case 1: clone_weapon("/p/weapon/spear/angriffsspeer"); break;// wc 135
         case 2: clone_weapon("/p/weapon/whip/neunschwaenzige"); break;//wc 139
       }
       break;
    case 24..28: 
       switch(random(2))
       {
         case 0: clone_weapon("/p/weapon/spear/kampfspiess"); break; // wc 170
         case 1: clone_weapon("/p/weapon/whip/bullenpeitsche"); break;// wc 165
       }
       break;
    case 29..35: 
       switch(random(1)) 
       {
         case 0: clone_weapon("/p/weapon/chain/doppelstern"); break;// wc 222
       }
       break;
    default:
  }
  if( random(35) < QueryProp(P_LEVEL) && QueryProp(P_WEAPON) && 
      QueryProp(P_WEAPON)->QueryProp(P_NR_HANDS) == 1 )
  {
    switch(random(2))
    {
      case 0: clone_armour("/p/armour/shield/lederschild"); break; // lvl 1..14
      case 1: clone_armour("/p/armour/shield/holzschild"); break;     //  1..20
    }
  }
  if( a )
  {
    if( random(10) < QueryProp(P_LEVEL) )
    {
      switch(random(4))
      {
        case 0: clone_armour("/p/armour/armour/lederruestung"); break;  //  1..19
        case 1: clone_armour("/p/armour/armour/lederpanzer"); break;    //  4..23
      }
    }
    if( !random(3) && QueryProp(P_LEVEL) > 15 )
    {
      switch( random(2) ) 
      {
        case 0: clone_armour("/p/armour/helm/lederhelm"); break;
        case 1: clone_armour( "/p/armour/helm/knochenhelm"); break;
      }
    }
    if( !random(4) )
    {
      switch( random(2) )
      {
        case 0: clone_armour("/p/armour/boots/lederschuhe"); break;
        case 1: clone_armour("/p/armour/boots/lederstiefel"); break;
      }
    }
    if( !random(5) && QueryProp(P_LEVEL)>10 )
    {
      switch( random(3) )
      {
        case 0: clone_armour("/p/armour/trousers/hose"); break;
        case 1: clone_armour("/p/armour/trousers/lederhose"); break;
        case 2: clone_armour("/p/armour/trousers/lederbeinschienen"); break;
      }
      if( !random(3) )
         clone_armour("/p/armour/belt/guertel");
    }
    if( !random(3) && QueryProp(P_LEVEL) > 15 )
    {
      switch( random(1) )
      {
        case 0: clone_armour("/p/armour/bracers/lederarmschienen"); break;
      }
    }
    if( !random(4) && QueryProp(P_LEVEL) > 20 )
    {
      switch( random(2) )
      {
        case 0: ob = clone_object("/p/armour/ring/ring"); break;
        case 1: ob = clone_object("/p/armour/amulet/amulett"); break;
      }
      ob->move(this_object(),2);
      if((itemd = find_object("/p/daemon/itemd/itemd")) && !random(5)) 
        itemd->identify(ob, 1, 100, 100, ({40,80,100,102,104}) ); 
    }
  }      
  command_me("trage alles"); 
}

void hq()
{
  int i;
  object ob;

  for(i=sizeof(QueryProp(P_ARMOURS))-1;i>=0;i--)
  {
    ob = QueryProp(P_ARMOURS)[i];
    ob->SetProp(P_M_HEALTH_MOD, ([P_HP:random(7), P_SP:random(7)]) );
    ob->SetProp(P_AC, (ob->QueryProp(P_AC) + 
          VALID_ARMOUR_CLASS[ob->QueryProp(P_ARMOUR_TYPE)] + 1) / 2);
    ob->SetProp(P_QUALITY_DECAY, ob->QueryProp(P_QUALITY_DECAY) + random(100));
    ob->SetProp(P_LONG, ob->QueryProp(P_LONG)+
        ob->Name(WER,1) + (ob->IsPlural() ? " sind" : " ist") + " hochqualitativ.");
    ob->SetProp(P_NAME_ADJ, ob->QueryProp(P_NAME_ADJ) + ({"hochqualitativ"}));
    ob->AddAdjective( ({"hochqaulitativ","hochqaulitative", "hochqaulitativer", 
          "hochqaulitatives", "hochqaulitativen" }) );
    ob->SetProp(P_SHORT, ob->Name());
    ob->SetProp(P_DAM_PROTECTION, ob->QueryProp(P_DAM_PROTECTION) +
        ([m_indices(MAGICAL_DAMAGE_TYPES)[random(sizeof(MAGICAL_DAMAGE_TYPES))]:1]) );
  }
}
