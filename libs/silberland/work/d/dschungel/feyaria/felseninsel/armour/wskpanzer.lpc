// /d/dschungel/feyaria/felseninsel/armour/wskpanzer.c
// Panzer der Wasserschildkroete
// 19-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Wasserschildkroetenpanzer");
  SetProp(P_LONG, BS( 
    "Der Panzer einer Wasserschildkroete besteht aus grossen Hornplatten.") );
  SetProp(P_NAME, "Wasserschildkroetenpanzer");
  SetProp(P_GENDER, MALE);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp (P_AC, 20);
  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 800);
  SetProp(P_DEFEND_FUNC, TO);

  AddId( ({"wasserschildkroetenpanzer", "schildkroetenpanzer", "panzer"}) );
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if (member(dam_type, DT_WATER) != -1)
  {
    return 33+random(55);
  }
  else
    return 0;
}
