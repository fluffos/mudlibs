// /d/dschungel/feyaria/felseninsel/room/strand3.c
// Strand auf der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 15-11-96   Feyaria@SilberLand

#include "../def.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Am Strand");
  SetProp(P_INT_LONG, BS(
    "Du stehst am schoensten Teil des Strands. Die Sonne brennt vom Himmel "
    "herunter und nur ein leichter Wind bringt etwas Kuehlung. Das Meer ist "
    "hier wie geschaffen fuer das Baden. Hier steht sogar eine kleine "
    "Palme, was dem Ort etwas Suedsee-Atmosphaere gibt. Die Klippen mit den "
    "vielen Seevoegeln sind hier ein Stueck weiter weg vom Strand als "
    "anderswo."));

  AddDetail( "boden",
    "Der Boden ist voll mit Sand.");
  AddDetail( "palme",
    "Die kleine Palme ist wirklich entzueckend. Sie ist zwar erst 3 Meter "
    "hoch, aber sie gibt dem Strand eine besondere Atmosphaere.");
  AddDetail( ({ "atmosphaere", }),
    "Wie in der Suedsee ist es hier noch nicht, aber trotzdem gefaellt es "
    "Dir hier ganz gut.");
  AddDetail( ({"suedsee"}),
    "In der Suedsee ist es auch sehr schoen, aber hier gefaellt es Dir "
    "eigentlich auch ganz gut. Schnapp dir ein Badetuch und verbring hier "
    "ein paar angenehme Stunden beim Baden.");
  AddDetail( ({"badetuch"}),
    "So ein Pech! Du hast Dein Badetuch vergessen! Argl!");
  AddDetail( ({"baden"}),
    "Du willst wissen, wie Baden ist? Dann untersuch es nicht, TU ES!!");
  
  AddCmd( ({"kletter", "klettere"}), "klettern");
  AddCmd( ({"grab", "grabe", "buddel", "buddele"}), "graben");
  AddCmd( ({"schwimme", "schwimm", "bade"}), "baden");
  AddCmd( ({"lieg", "liege"}), "liegen");

  AddExit("westen","./strand2");
  AddExit("osten","./strand4");
}

int graben(string str)
{
  write("Du buddelst im Sand herum.\n");
  say(TP->name(WER) + " buddelt im Sand herum.\n");
  return 1;
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str) return 0;
  if( member( ({"klippen","klippe","felsklippen","felsklippe","auf klippen",
     "auf klippe", "auf felsklippen","auf felsklippe"}), str)!=-1 )
  {
    write("Die Klippen sind hier zu steil zum erklettern.\n");
    return 1;
  }
  return 0;
}

int baden(string str)
{
  notify_fail("Wo willst Du baden?\n");
  if(!str) return 0;
  if( member( ({"meer", "wasser", "im wasser", "im meer", "in meer", "in wasser"}), str)!=-1 )
  {
    if( TP->QueryProp(P_ARMOURS)!=({}) )
    {
      write("Vielleicht sollest Du Deine Sachen vorher ausziehen.\n");
      return 1;
    }
    write("Voller Freude springst Du ins Wasser und schwimmst hinaus.\n");
    TP->move( ROOM "meer", M_GO, "ins Wasser und schwimmt hinaus", "geht", 
              "schwimmt herein");
    return 1;
  }
  return 0;
}

int liegen(string str)
{
  notify_fail("Wo willst Du Dich hinlegen?\n");
  if(!str) return 0;
  if( member( ({"sand", "in sand", "auf sand", "boden", "auf boden", 
    "strand", "auf strand", "sandstrand", "auf sandstrand"}),str)!=-1 )
  {
    write("Da wirst Du doch voll Sand! Leg Dich doch auf ein Badetuch.\n");
    return 1;
  }
  if( member( ({"auf badetuch", "badetuch", "auf tuch", "tuch"}),str)!=-1)
  {
    if( present("badetuch", TP) )
    {
      if(present("\nstrand", TP))
      {
        write("Du liegst doch schon auf Deinem Badetuch.\n");
        return 1;
      }
      write("Du breitest Dein Badetuch aus und legst Dich gemuetlich in den "
            "Schatten unter der Palme.\n");
      say( TPN +" breitet ein Badetuch aus und legt sich gemuetlich in den "
            "Schatten unter der Palme.\n");
      CLONE(OBJ "strand",TP);
      return 1;
    }
    write("Aber Du hast doch gar kein Badetuch dabei!\n");
    return 1;
  }
  return 0;
}
