// /d/dschungel/feyaria/felseninsel/room/strand2.c
// Strand der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 15-11-96   Feyaria@SilberLand

#include "../def.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Am Strand der Felseninsel");
  SetProp(P_INT_LONG, BS(
   "Du stehst am Strand der Felseninsel. Im Sueden siehst Du den Steg, an "
   "dem die Segelyacht anlegt. Dahinter erstreckt sich das Meer bis zum "
   "Horizont. Der Sandstrand dieser kleinen Bucht ist von hohen Felsklippen "
   "eingefasst. Die Sonne brennt vom Himmel herunter und nur ein leichter "
   "Wind bringt etwas Kuehlung. Ueber Dir fliegen einige Seevoegel herum. "
   "Auch in den Klippen siehst Du viele Voegel, die dort scheinbar ihre "
   "Nester haben.")); 

  AddDetail( ({"steg", "holzsteg"}),
    "Der Steg schaut sehr stabil aus. Er besteht aus kurzen Holzplanken. "
    "Hier legt die Segelyacht an, die Dich wieder nach Tijara zurueck "
    "bringen kann.");
  AddDetail( ({"adler", "augen", "adleraugen"}),
    "Adler haben sehr scharfe Augen.");
  AddDetail( ({"planken", "holzplanken", "holz"}),
    "Um mehr zu sehen, musst Du schon den Steg betreten.");
  AddDetail( "boden",
    "Der Boden ist voller Sand.");

  AddCmd( ({"kletter", "klettere"}), "klettern");
  AddCmd( ({"grab", "grabe", "buddel", "buddele"}), "graben");
  AddCmd( ({"schwimme", "schwimm", "bade"}), "baden");
  AddCmd( ({"lieg", "liege"}), "liegen");

  AddExit("westen","./strand1");
  AddExit("sueden","./steg");
  AddExit("osten","./strand3");
}

int graben(string str)
{
  write("Du buddelst im Sand herum.\n");
  say(TP->name(WER) + " buddelt im Sand herum.\n");
  return 1;
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str) return 0;
  if( member( ({"klippen","klippe","felsklippen","felsklippe","auf klippen",
     "auf klippe", "auf felsklippen","auf felsklippe"}), str)!=-1 )
  {
    write("Die Klippen sind hier zu steil zum erklettern.\n");
    return 1;
  }
  return 0;
}

int baden(string str)
{
  notify_fail("Wo willst Du baden?\n");
  if(!str) return 0;
  if( member( ({"meer", "wasser", "im wasser", "im meer", "in meer", "in wasser"}), str)!=-1 )
  {
    write("Das ist hier kein richtiger Badeplatz.\n");
    return 1;
  }
  return 0;
}

int liegen(string str)
{
  notify_fail("Wo willst Du Dich hinlegen?\n");
  if(!str) return 0;
  if( member( ({"sand", "in sand", "auf sand", "boden", "auf boden", 
    "strand", "auf strand", "sandstrand", "auf sandstrand",
    "auf badetuch", "badetuch", "auf tuch", "tuch"}),str)!=-1 )
  {
    write( BS("Du wirst Dich doch nicht direkt neben den Steg legen, wo "
      "jeder Neuankoemmling ueber Dich druebersteigen muss.") );
    return 1;
  }
  return 0;
}
