// /d/dschungel/feyaria/felseninsel/room/insel_inh.c    
// Allgemeines der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 14-11-96   Feyaria@SilberLand
// 24 Details, 3 Sounds, 3 Smells

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einer Felseninsel");
  SetProp(P_INT_LONG, BS(
    "Du stehst auf einer Felseninsel. Wenn Du das hier siehst, dann war "
    "Feyaria zu faul, eine eigene Long-Beschreibung fuer diesen Raum zu "
    "machen.")); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( "himmel",
    "Am Himmel ist nicht das kleinste Woelkchen zu sehen. Nur am Horizont "
    "haengt eine kleine Wolkenbank.");
  AddDetail( ({"wolke", "wolken", "woelkchen"}),
    "Bis auf die Wolkenbank am Horizont ist keine Wolke zu sehen.");
  AddDetail( ({"horizont", "wolkenbank"}),
    "Am Horizont haengt eine Wolkenbank, aber ansonsten ist es wolkenlos.");
  AddDetail( "sonne",
    "Die Sonne brennt erbarmungslos vom Himmel herunter. Das ist wohl auch "
    "der Grund, dass es hier so warm ist. Du kannst richtig die Strahlung "
    "auf Deiner Haut spueren.");
  AddDetail( ({"grund"}),
    "Die Sonne ist der Grund, dass es hier so warm ist.");
  AddDetail( "strahlung",
    "Die Strahlung der Sonne ist sehr intensiv hier.");
  AddDetail( "haut",
    "Deine Haut hat noch eine normale Farbe, aber wenn Du zu lange in der "
    "Sonne stehst, koenntest Du einen Sonnenbrand bekommen.");
  AddDetail( "sonnenbrand",
    "Noch hast Du keinen, aber pass lieber auf!");
  AddDetail( "wind",
    "Der frische Wind bringt etwas Kuehlung vom Meer her.");
  AddDetail( "kuehlung",
    "Ein richtige Kuehlung bringt der Wind zwar nicht, aber ohne Wind waere "
    "die Hitze hier sicher unertraeglich.");
  AddDetail( "hitze",
    "Ohne Wind waere die Hitze sicher unertraeglich.");
  AddDetail( "meer",
    "Das Meer hat eine herrliche gruenblaue Farbe. Die grossen Wellen "
    "brechen sich an einem Riff, sodass es hier nur noch kleine Wellen "
    "gibt.");
  AddDetail( ({"farbe", "farben"}),
    "Der Himmel ist hellblau, das Meer ist gruenblau, die Sonne hellgelb, "
    "die Klippen dunkelgrau, der Sand weiss. Deine Haut hat auch noch normale "
    "Farbe, aber vielleicht bekommst Du ja bald einen Sonnenbrand?");
  AddDetail( ({"wellen", "welle"}),
    "Hier am Strand sind die Wellen nur mehr sehr klein, aber ausserhalb "
    "des Riffs sind sie mehr als meterhoch.");
  AddDetail( "riff", 
    "An diesem Riff brechen sich die grossen Wellen. Wegen dem Riff koennen "
    "auch keine groesseren Schiffe diese Insel ansteuern.");
  AddDetail( ({"schiffe", "schiff"}),
    "Nur kleine Schiffe koennen diese Insel ansteuern, da die groesseren "
    "Schiffe das Riff nicht ueberwinden koennen.");
  AddDetail( ({"strand", "sandstrand"}),
    "Der Sandstrand dieser Bucht ist nicht sehr lang. Nach ungefaehr 20 "
    "Metern beginnen schon wieder die Klippen.");
  AddSpecialDetail( ({"meter", "metern"}), "meter");
  AddDetail( "sand",
    "Herrlicher, weisser Sand. Er ist ganz weich, ideal um darauf zu "
    "liegen und um darin herum zu buddeln.");
  AddDetail( "wasser",
    "Das Meerwasser ist sicher angenehm warm und laedt zum schwimmen ein.");
  AddDetail( ({"meerwasser", "salzwasser"}),
    "Natuerlich ist das Meerwasser salzhaltig.");
  AddDetail( "salz",
    "Das Salz ist im Wasser geloest. Sehen kann man es nicht.");
  AddDetail( "bucht",
    "Diese kleine Bucht wird von hohen Felsklippen umgeben. Nur an einer "
    "Stelle treten sie ein Stueck zurueck und lassen ein Stueck Sandstrand "
    "frei.");
  AddDetail( ({"stueck"}),
    "Ein Stueck.");
  AddDetail( ({"stelle", "stellen"}),
    "Irgendeine Stelle.");
  AddDetail( "ufer",
    "Das Ufer bildet hier ein schmaler Sandstrand.");
  AddDetail( ({"klippen", "klippe", "felsklippen", "felsklippe", "felsenklippe"}),
    "Die Klippen ragen steil hinter dem Strand auf. Viele Seevoegel haben "
    "ihre Nistplaetze in den Klippen aufgeschlagen. Ob man die Klippen "
    "irgendwo erklettern kann, ist ungewiss.");
  AddDetail( ({"fels", "felsen"}),
    "Die Felsen der Klippe sind sehr zerklueftet, ideal fuer Seevoegel um "
    "darin ihre Nester zu bauen.");
  AddDetail( ({"insel", "felseninsel"}),
    "Du bist auf einer kleinen Felseninsel. Wie gross sie ist, kannst Du "
    "von hier nicht feststellen.");
  AddDetail( ({"voegel", "vogel", "seevogel", "seevoegel"}),
    "Die Seevoegel nisten in der steilen Felsklippe. Hauptsaechlich handelt "
    "es sich dabei um Moewen.");
  AddDetail( ({"moewen", "moewe", "menge"}),
    "Hier gibt es eine ganze Menge von Moewen, die ihre Nester in den "
    "Felsklippen haben.");
  AddDetail( ({"nistplatz", "nest", "nistplaetze", "nester", "ei", "eier"}),
    "Die Moewen haben ihre Nester an den steilsten Stellen der Klippen "
    "gebaut, damit niemand ihre Eier stehlen kann.");
  AddDetail( ({"baden", "badeplatz"}),
    "Wenn Du baden willst, so wirst Du auf dieser Insel sicher irgendwo einen "
    "schoenen Badeplatz finden.");
  AddDetail( ({"tijara"}),
    "Nich einmal mit den schaerfsten Adleraugen koenntest Du Tijara von hier "
    "aus sehen!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Wellen und das Schreien der Voegel.");
  AddSound( ({"wellen", "welle", "rauschen"}),
    "Das Rauschen der Wellen ist hier noch recht laut.");
  AddSound( ({"schreie", "schreien", "voegel", "moewen", "seevoegel"}),
    "Die Schreie der Voegel klingen schrill in Deinen Ohren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Meer.");
  AddSmell( "meer",
    "Das Meer riecht nach Salz, Seetang und Fisch.");
  AddSmell( ({"salz", "seetang", "tang", "fisch"}),
    "Danach riecht das Meer.");

}

string meter()
{
  return BS("Du bist ca. "+TP->QueryProp(P_SIZE)/100+","+
    TP->QueryProp(P_SIZE)%100+" Meter gross.");
}

