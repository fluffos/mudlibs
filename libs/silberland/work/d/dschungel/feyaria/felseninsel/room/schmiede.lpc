// /d/dschungel/feyaria/felseninsel/room/schmiede.c
// Schmiede auf der Felseninsel
// 1998-11-18  Feyaria@SilberLand

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einer Schmiede" );
  SetProp(P_INT_LONG,
    "Du stehst in einer dunklen Hoehle, die eindeutig als Schmiede "
    "benutzt wird. In der Mitte steht ein maechtiger Amboss und ein "
    "Wasserbecken. An der Wand befindet sich ein grosser Schmelzofen, "
    "daneben liegen viele Werkzeuge. In einem Regal stehen einige "
    "verschiedene Aexte. Alles hier ist ganz schwarz vom "
    "vielen Russ. Eine Leiter fuehrt hinauf.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:33, ENV_TERRAIN: TT_CAVE]));

  AddDetail( ({"boden"}),
    "Der Boden ist voller Russ. Einige Werkzeuge liegen herum.");
  AddDetail( ({"werkzeuge", "werkzeug", "hammer", "haemmer", "zangen", 
               "zange"}),
    "Werkzeuge, die man fuers Schmieden braucht, vor allem Haemmer und "
    "Zangen.");
  AddDetail( ({"becken", "wasser", "wasserbecken"}),
    "Ein Wasserbecken steht neben dem Amboss.");
  AddDetail( ({"ofen", "schmelzofen"}),
    "Im Schmelzofen wird das Eisen auf die richtige Temperatur gebracht.");
  AddDetail( ({"feuer"}),
    "Im Schmelzofen brennt ein heisses Feuer.");
  AddDetail( "decke",
    "Die Decke ist voller Russ." );
  AddDetail( ({ "wand", "waende" }),
    "Der Russ hat die Waende tiefschwarz eingefaerbt. " );
  AddDetail( "russ",
    "Alles hier im Raum ist russig und egal was man beruehrt, es faerbt "
    "schwarz ab." );
  AddDetail( "mitte",
    "In der Mitte der Schmiede steht ein maechtiger Amboss." );
  AddDetail( ({"amboss", "eisenstuecke"}),
    "Der Amboss ist sehr gross, sodass man dort auch grosse Eisenstuecke "
    "schmieden kann." );
  AddDetail( ({"schmiede", "raum", "hoehle"}),
    "Du bist in einer Hoehle, die wie eine Schmiede eingerichtet ist." );
  AddDetail( ({"leiter"}),
    "Die Leiter fuehrt hinauf.");  
  AddDetail( ({"temperatur"}),
    "Es ist sehr warm hier, aber das ist kein Wunder, wenn man sich in einer "
    "Schmiede befindet.");
  AddDetail( ({"eisen"}),
    "Hier wird fast nur Eisen verarbeitet.");  
  AddDetail( ({"regal", "aexte"}),
    "In einem Regal befinden sich eine ganz Reihe verschiedenster Aexte.");  
  
  AddSound( ({DEFAULT_SOUND, "haemmern"}),
    "Das Haemmern des Schmiedes ist so laut, dass Du sonst fast nichts "
    "hoerst.");
        
  AddSmell( ({DEFAULT_SMELL, "feuer", "schmiedefeuer"}),
    "Es riecht nach Schmiedefeuer." );

  AddItem( NPC "tarnang", REFRESH_DESTRUCT );

  AddExit( "oben", "/gilden/berserker" );

}

