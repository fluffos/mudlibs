// /d/dschungel/feyaria/felseninsel/room/hochflaeche.c 
//  Hochflaeche auf der Felseninsel
//  1997-10-29 Feyaria@SilberLand

#include "../def.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einer kahlen Hochflaeche");
  SetProp(P_INT_LONG, BS(
    "Du stehst auf der Hochflaeche oberhalb der Klippen. Der Boden ist sehr "
    "felsig und uneben. Hie und da sieht man ein Nest der Seevoegel. "
    "Ein schmaler und sehr steiler Fusspfad fuehrt durch die Klippen wieder "
    "zum Sandstrand zurueck. Im Osten steht ein kleines Steinhaus. "
    "Man hat einen schoenen Ausblick auf das Meer.")); 
 
  AddDetail( ({"ausblick", "bild"}),
    "Der Ausblick ist wirklich wunderschoen. Das gruenblaue Meer, der "
    "weisse Strand, die dunklen Klippen und der hellblaue, wolkenlose "
    "Himmel geben zusammen ein herrliches Bild.");
  AddDetail( ({"pfad", "fusspfad"}), 
    "Der Fusspfad fuehrt durch die Klippen wieder zum Sandstrand zurueck.");
  AddDetail( ({"klippen", "klippe", "felsklippen", "felsklippe"}),
    "Die Klippe ist hier nicht ganz so steil wie an anderen Stellen, deshalb "
    "fuehrt hier wohl auch der steile Fusspfad nach oben. Hier nisten auch "
    "weit weniger Seevoegel, als an anderen Stellen in der Klippe.");
  AddDetail( ({"hochflaeche", "flaeche"}),
    "Die Hochflaeche ist sehr kahl und von grossen Felsbloecken bedeckt.");
  AddDetail( ({"fels", "felsblock", "felsbloecke", "block", "bloecke"}),
    "Einige Felsbloecke liegen einfach so auf dem Boden herum, aber viele "
    "wurden fuer den Bau des Steinhauses gebraucht.");
  AddDetail( ({"boden"}),
    "Der Boden ist sehr felsig und uneben. An vielen Stellen ist er von "
    "Seevogelmist bedeckt.");
  AddDetail( ({"mist", "vogelmist", "seevogelmist"}),
    "An vielen Stellen liegt Seevogelmist herum.");
  AddDetail( ({"nest", "nester"}),
    "Es gibt hier einige Nester von Seevoegeln.");
  AddDetail( ({"wellen", "welle"}),
    "Die hohen Wellen brechen sich am Riff.");
  AddDetail( ({"strand", "sandstrand", "sand", "bucht", "ufer"}),
    "Den Sandstrand kannst Du von hier aus nicht sehen. Dazu muesstest Du "
    "schon den Fusspfad nach unten gehen.");
  AddDetail( ({"haus", "steinhaus"}),
    "Das Haus wurde komplett aus Felsbloecken gebaut, die mit extremen "
    "Kraftaufwand uebereinander gestapelt worden sind. Auf den Hauswaenden "
    "sind verschiedene Zeichen eingeritzt.");
  AddDetail( ({"kraft", "kraftaufwand", "aufwand", "bau"}),
    "Der Aufwand an Kraft fuer den Bau dieses Haus war wirklich gewaltig. Wer hier "
    "wohl leben mag?");
  AddDetail( ({"wand", "waende", "hauswand", "hauswaende"}),
    "Die Hauswaende bestehen aus groben Felsbloecken, in denen verschiedene "
    "Zeichen eingeritzt sind.");
  AddDetail( ({"zeichen"}),
    "Die Zeichen auf der Hauswand stellen vornehmlich Aexte dar.");
  AddDetail( ({"axt", "aexte"}),
    "Auf der Hauswand sind stilisierte Aexte eingeritzt.");

  SetProp(P_HIDE_EXITS, ({"sueden"}) );
  AddExit("osten", "in das Steinhaus#/gilden/berserker");
  AddExit(({"suedunten", "sueden"}),"Suedunten#./pfad");
}

