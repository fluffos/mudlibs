// /d/dschungel/feyaria/felseninsel/room/pfad.c 
//  Pfad durch die Klippen auf der Felseninsel
//  1997-10-29 Feyaria@SilberLand


#include "../def.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Fusspfad durch die Klippen");
  SetProp(P_INT_LONG, BS(
    "Du bist auf einem schmalen und sehr steilen Fusspfad durch die Klippen. "
    "Unter Dir liegt der Sandstrand, der sich weiter nach Osten ausdehnt. "
    "Knapp ueber Dir endet die Klippe in einer Hochflaeche, die Du von hier "
    "aber noch nicht ueberblicken kannst. Nach unten hat man einen schoenen "
    "Ausblick auf die ganze Bucht mit dem Sandstrand und auf das Meer.")); 
 
  AddDetail( ({"ausblick", "bild"}),
    "Der Ausblick ist wirklich wunderschoen. Das gruenblaue Meer, der "
    "weisse Strand, die dunklen Klippen und der hellblaue, wolkenlose "
    "Himmel geben zusammen ein herrliches Bild.");
  AddSpecialDetail( ({"pfad", "fusspfad", "boden"}), "pfad");
  AddDetail( ({"ursprung", "menschenhand", "hobbithand", "elfenhand", 
               "zwergenhand", "arbeit"}),
    "Wer hat sich wohl die viele Arbeit gemacht, diesen Fusspfad anzulegen?");
  AddDetail( ({"klippen", "klippe", "felsklippen", "felsklippe"}),
    "Die Klippe ist hier nicht ganz so steil wie an anderen Stellen, deshalb "
    "fuehrt hier wohl auch der steile Fusspfad nach oben. Hier nisten auch "
    "weit weniger Seevoegel, als an anderen Stellen in der Klippe.");
  AddDetail( ({"hochflaeche", "flaeche"}),
    "Die Hochflaeche kannst Du von hier noch nicht ueberblicken.");
  AddDetail( ({"fels" }),
    "Der Fels ist hier sehr hart, sicher war es eine muehsame Arbeit, den "
    "Pfad aus dem Fels zu schlagen.");

  SetProp(P_HIDE_EXITS, ({"norden", "suedosten"}) );
  AddExit(({"nordoben", "norden"}), "Nordoben#./hochflaeche");
  AddExit( ({"suedostunten", "suedosten"}),"Suedostunten#./strand1");
}

string pfad()
{
  string hand;
  switch(TP->QueryProp(P_RACE))
  {
    case "Zwerg":  hand="Zwergenhand"; break;
    case "Hobbit": hand="Hobbithand"; break;
    case "Elf":    hand="Elfenhand"; break;
    default:       hand="Menschenhand"; break;
  }
  return BS(
    "Du stehst auf einem schmalen und sehr steilen Fusspfad, der nach oben "
    "auf die Klippe fuehrt. Er ist nicht natuerlichen Ursprungs, sondern "
    "wurde wohl von "+hand+" aus dem Fels geschlagen.");
}

