// /d/dschungel/feyaria/felseninsel/room/steg.c
// Steg auf der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 15-11-96   Feyaria@SilberLand

#include "../def.h"
#include "/d/wasser/feyaria/schiffe.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Steg");
  SetProp(P_INT_LONG, BS(
    "Du stehst auf einem Holzsteg. Von hier kann man mit der Segelyacht "
    "wieder aufs Festland zurueckfahren. Vor Dir liegt eine kleine "
    "Felseninsel, die von hohen Klippen umgeben wird. Nur an dieser Stelle "
    "ist eine kleine Bucht mit einem Sandstrand. Die Sonne brennt vom "
    "Himmel herunter und nur ein leichter Wind bringt etwas Kuehlung. Das "
    "Meer erstreckt sich nach Sueden bis zum Horizont. Ueber Dir fliegen "
    "einige Seevoegel herum. Auch in den Klippen siehst Du viele Voegel, "
    "die dort scheinbar ihre Nester haben.")); 

  AddDetail( "boden",
    "Den Boden bildet hier der Holzsteg, darunter ist dann das Wasser.");
  AddDetail( ({"steg", "holzsteg"}),
    "Der Steg schaut sehr stabil aus. Er besteht aus kurzen Holzplanken. "
    "Hier legt die Segelyacht an, die Dich wieder nach Tijara zurueck "
    "bringen kann.");
  AddDetail( ({"planken", "holzplanken"}),
    "Die Planken sind aus einem sehr hellen Holz gefertigt.");
  AddDetail( "holz",
    "Das Holz ist sehr hell. Ob das immer schon so war, oder ob es die "
    "Sonne ausgebleicht hat, ist schwer zu sagen.");
  AddDetail( "tijara",
    "Tijara ist zuweit weg, man kann es von hier nicht mehr sehen.");
  AddDetail( ({"stelle" }),
    "Nur an dieser Stelle ist eine kleine Bucht mit einem Sandstrand, "
    "ansonsten ist die Insel von einer hohen Felsenklippe umgeben."); 
  
  AddCmd( ({"schwimme", "schwimm", "bade"}), "baden");

  AddExit("norden","./strand2");

  AddItem( YACHT, REFRESH_DESTRUCT, 1);
  AddItem( HANDELSSCHIFF, REFRESH_DESTRUCT, 1);
  AddItem( PIRATENSCHIFF, REFRESH_DESTRUCT, 1);
}

int baden(string str)
{
  notify_fail("Wo willst Du baden?\n");
  if(!str) return 0;
  if( member( ({"meer", "wasser", "im wasser", "im meer", "in meer", "in wasser"}), str)!=-1 )
  {
    write("Das ist hier kein richtiger Badeplatz.\n");
    return 1;
  }
  return 0;
}

