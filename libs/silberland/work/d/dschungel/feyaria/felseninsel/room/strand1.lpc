// /d/dschungel/feyaria/felseninseln/room/strand1.c
// Strand auf der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 15-11-96   Feyaria@SilberLand

#include "../def.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Am Strand der Felseninsel");
  SetProp(P_INT_LONG, BS(
    "Du stehst jetzt direkt vor den Klippen. In dieser Richtung endet der "
    "Sandstrand, denn die Klippen reichen hier bis ins Meer hinein. Die "
    "Sonne brennt vom Himmel herunter und nur ein leichter Wind bringt "
    "etwas Kuehlung. Ueber Dir fliegen einige Seevoegel herum. Auch in den "
    "Klippen siehst Du viele Voegel, die dort scheinbar ihre Nester "
    "haben. In den Klippen fuehrt ein schmaler Fusspfad nach oben.") ); 

  AddDetail( "boden",
    "Der Boden ist voller Sand.");

  AddDetail( ({"fusspfad", "pfad"}),
    "Ein schmaler Fusspfad fuehrt in den Klippen nach oben. Wer da wohl "
    "oben haust?");

  AddDetail( ({"klippen", "klippe", "felsklippen", "felsklippe"}),
    "Die Klippen ragen steil hinter dem Strand auf. Viele Seevoegel haben "
    "ihre Nistplaetze in den Klippen aufgeschlagen. Ein schmaler Fusspfad "
    "fuehrt nach oben.");

  AddCmd( ({"kletter", "klettere"}), "klettern");
  AddCmd( ({"grab", "grabe", "buddel", "buddele"}), "graben");
  AddCmd( ({"schwimme", "schwimm", "bade"}), "baden");
  AddCmd( ({"lieg", "liege"}), "liegen");

  AddItem( NPC "wsk",  REFRESH_DESTRUCT);

  SetProp(P_HIDE_EXITS, ({"nordwesten"}) );
  AddExit( ({"nordwestoben", "nordwesten"}), "Nordwestoben#./pfad");
  AddExit("osten","./strand2");
}

int graben(string str)
{
  if( present("\nquestliste", TP) && !present( "wasserschildkroetenei", TP) )
  {
    write( BS( "Du buddelst im Sand herum und zu Deiner Ueberraschung findest "
      "Du einige Schildkroeteneier, von denen Du eines sofort einsteckst. Die "
      "uebrigen Eier vergraebst Du aber wieder, damit die armen Schildkroeten "
      "nicht aussterben.") );
    CLONE(OBJ "wsk_ei", TP);
  }
  else
  {
    write( BS( "Du buddelst im Sand herum und zu Deiner Ueberraschung findest "
      "Du einige Schildkroeteneier. Du vergraebst die Eier aber wieder, "
      "damit die armen Schildkroeten nicht aussterben.") );
  }
  say(TP->name(WER) + " buddelt im Sand herum.\n");
  return 1;
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str) return 0;
  if( member( ({"klippen","klippe","felsklippen","felsklippe","auf klippen",
     "auf klippe", "auf felsklippen","auf felsklippe"}), str)!=-1 )
  {
    TP->move( ROOM "pfad", M_GO, "nach Nordwestoben");
    return 1;
  }
  return 0;
}

int baden(string str)
{
  notify_fail("Wo willst Du baden?\n");
  if(!str) return 0;
  if( member( ({"meer", "wasser", "in wasser", "in meer","im meer", "im wasser"}), str)!=-1 )
  {
    write("Das ist hier kein richtiger Badeplatz.\n");
    return 1;
  }
  return 0;
}

int liegen(string str)
{
  notify_fail("Wo willst Du Dich hinlegen?\n");
  if(!str) return 0;
  if( member( ({"sand", "in sand", "auf sand", "boden", "auf boden", 
    "strand", "auf strand", "sandstrand", "auf sandstrand"}),str)!=-1 )
  {
    write("Da wirst Du doch voll Sand! Leg Dich doch auf ein Badetuch.\n");
    return 1;
  }
  if( member( ({"auf badetuch", "badetuch", "auf tuch", "tuch"}),str)!=-1)
  {
    if( present("badetuch", TP) )
    {
      if(present("\nstrand", TP))
      {
        write("Du liegst doch schon auf Deinem Badetuch.\n");
        return 1;
      }
      write("Du breitest Dein Badetuch aus und legst Dich gemuetlich in die "
            "Sonne.\n");
      say( TPN +" breitet ein Badetuch aus und legt sich gemuetlich in die "
            "Sonne.\n");
      CLONE(OBJ "strand",TP);
      return 1;
    }
    write("Aber Du hast doch gar kein Badetuch dabei!\n");
    return 1;
  }
  return 0;
}
