// /d/dschungel/feyaria/felseninsel/room/felsen.c 
//  ganz oben in den Klippen auf der Felseninsel
// 30-11-96   Feyaria@SilberLand

#include "../def.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define FEDERN ({"feder", "federn", "vogelfeder", "vogelfedern"})
#define QUESTFEDER ({"gestreifte haubentaucherfeder"})

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ganz oben auf der Klippe");
  SetProp(P_INT_LONG, BS(
    "Du stehst ganz oben auf der Klippe. Hier bist Du wirklich schon weit "
    "in der Hoehe. Wenn Du schwindelfrei bist, kannst Du ueber die Klippe "
    "nach unten blicken. Hier gibt es auch viele Vogelnester, aber keines "
    "ist in Deiner Reichweite. Dagegen siehst Du hier viele Federn, die die "
    "Voegeln beim Mausern verloren haben. Nach unten hat man einen schoenen "
    "Ausblick auf die ganze Bucht mit dem Sandstrand und auf das Meer.")); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  SetProp(P_KILL_NAME, "Ein Sprung von der Klippe");

  AddDetail( ({"hoehe", "schwindel"}),
    "Es ist wirklich hoch hier. Hoffentlich bist Du schwindelfrei.");
  AddDetail( ({"vogelnester"}),
    "Nester von Voegeln, oder hast Du etwas anderes gedacht?.");
  AddDetail( FEDERN,
    "Hier liegen die verschiedensten Vogelfedern herum. Wenn Du eine "
    "bestimmte Feder suchst, kannst Du sie hier vielleicht finden.");
  AddDetail( QUESTFEDER,
    "Auf den ersten Blick siehst Du keine solche Feder, aber wer weiss...");
  AddDetail( ({"ausblick"}),
    "Von hier oben hat man einen wunderbaren Ausblick ueber die ganze "
    "Bucht.");
  AddDetail( ({"mausern", "federwechsel"}),
    "So nennt man den Federwechsel bei den Voegeln.");
  AddDetail( ({"reichweite"}),
    "Deine Reichweite ist durch Deine Armlaenge beschraenkt.");
  AddDetail( ({"armlaenge"}),
    "Deine Arme sind so lange wie Deine Reichweite.");
  AddDetail( ({"arme"}),
    "Eins, zwei.... Ja, Deine Arme sind noch alle da.");
  AddDetail( ({"boden", "felsen"}),
    "Der Boden ist sehr felsig.");  
  
  AddCmd( ({"such", "suche"}), "suchen");
  AddCmd( ({"spring", "springe"}), "springen");

  AddExit("runter", "./klippe");

  AddItem( "/d/gebirge/feyaria/drachen/obj/statue", REFRESH_REMOVE );
}

int suchen(string str)
{
  string was;
  notify_fail("Nach was willst Du suchen?\n");
  if( !str) return 0;
  if( sscanf(str, "nach %s", was)!=1)
  {
    if( member( FEDERN+QUESTFEDER , str)!=-1)
      notify_fail("Du sollst doch NACH etwas suchen!\n");
    return 0;
  } 
  if( member( FEDERN, was)!=-1)
  {
    write( BS("Du suchst und findest eine Unmenge an Federn. Aber keine "
       "gefaellt Dir besonders gut.") );
    return 1;
  }
  if( member( QUESTFEDER , str)!=-1)
  {
    write( "Du findest die Feder, ABER DIE QUEST GIBTS NOCH NICHT !!\n");
    return 1;
  }
  return 0;
}

int springen(string str)
{
  notify_fail("Wohin willst Du springen?\n");
  if(!str) return 0;
  if( member( ({"meer", "ins meer", "in meer", "in wasser", "wasser",
                "ins wasser", "von klippen", "von klippe", "von felsklippen",
                "von felsklippe"}), str)!=-1 )
  {
    write( "Du ueberwindest deine Angst und wagst den mutigen Sprung ins "
      "Meer.\n");
    TP->move( ROOM "meer", M_GO, "von der Klippe ins Meer hinunter",
             "springt", "springt von oben ins Wasser");
    write( "Aua! Der Aufprall hat wegetan!\n");
    TP->do_damage(5+random(10) );
    return 1;
  }
  return 0;
}
