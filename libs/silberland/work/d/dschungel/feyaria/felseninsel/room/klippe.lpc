// /d/dschungel/feyaria/felseninsel/room/klippe.c 
//  Klippen auf der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 14-11-96   Feyaria@SilberLand

#include "../def.h"
#include "/d/huegelland/feyaria/osterhase/oh.h"

inherit ROOM "insel_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In den Klippen");
  SetProp(P_INT_LONG, BS(
    "Du bist in den Klippen. Hoeher kannst Du nicht mehr klettern, denn "
    "die Klippen werden immer steiler. Neben Dir siehst Du ueberall die "
    "Nester der Voegel, in denen sie ihre Eier ausbrueten. Nach unten hat "
    "man einen schoenen Ausblick auf die ganze Bucht mit dem Sandstrand und "
    "auf das Meer.")); 
 
  AddSpecialDetail( ({"ei", "eier", "vogelei", "vogeleier"}),
    "eier");

  AddDetail( "ausblick",
    "Der Ausblick ist wirklich wunderschoen. Das gruenblaue Meer, der "
    "weisse Strand, die dunklen Klippen und der hellblaue, wolkenlose "
    "Himmel geben zusammen ein herrliches Bild.");
  AddDetail( "bild",
    "Das ist ein Bild fuer eine Postkarte.");
  AddDetail( "postkarte",
    "Moechtest Du von hier eine Postkarte schreiben?");
  AddDetail( ({"klippen", "klippe", "felsklippen", "felsklippe", "boden"}),
    "Du bist mitten in den Klippen. Weiter nach oben kommt man nur mit einer "
    "Kletterausruestung. Runter zum Strand hingegen kommt man sehr leicht. "
    "Viele Seevoegel haben ihre Nistplaetze hier aufgeschlagen.");

  AddRoomMessage( ({
    "Eine Moewe flattert knapp an Deinem Kopf vorbei.\n",
    "Ein kleines Steinchen kullert neben Dir die Klippen hinunter.\n",
    "Eine Moewe stoesst sich von der Klippe ab und segelt aufs Meer "
      "hinaus.\n",
    "Eine Moewe spreizt ihre Fluegel und will Dich von ihrem Nest "
      "fernhalten.\n",
    "Die Voegel kreischen wieder einmal besonders laut.\n"}),60 );

  AddCmd( ({"kletter", "klettere"}), "klettern");
  AddCmd( ({"schwimme", "schwimm", "bade"}), "baden");
  AddCmd( ({"spring", "springe"}), "springen");
  AddCmd( ({"stehle", "stiehl"}), "stehlen");
  AddCmd( ({"schreibe", "schreib"}), "schreiben");

  AddSpecialExit("runter","hinunter");
}

string eier()
{
  if( present( OSTERHASENQUEST_ID, TP) )
    return BS(
      "In den Nestern liegen viele Eier. Vielleicht koenntest Du eines "
      "stehlen, denn Moeweneier sind fuer ihre leuchtend gelbe Farbe "
      "beruehmt.");
  else
    return BS(
      "In den Nestern liegen viele Eier. Vielleicht koenntest Du eines "
      "stehlen, aber das werden die Moewen sicher nicht ungestraft "
      "hinnehmen.");
}

hinunter()
{
  if (present("moewe"))
  {
    write("Die Moewe laesst Dich nicht weg.\n");
    return 1;
  }
  else
  {
    TP->move( ROOM "strand4", M_GO, "muehsam die Klippe hinunter", 
             "klettert", "kommt die Klippe heruntergeklettert" );
    return 1;
  }
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str) return 0;
  notify_fail("Dorthin kannst Du nicht klettern!\n");
  if( member( ({"klippen","klippe","felsklippen","felsklippe","auf klippen",
     "auf klippe", "auf felsklippen","auf felsklippe"}), str)!=-1 )
  {
    if( present("seil", TP) )
    {
      if( present("kletterhaken", TP) )
      {
        if( TP->QueryAttribute(A_DEX)<13)
        {
          write("Du bist nicht geschickt genug fuer so eine Kletterei.\n");
          return 1;
        }
        write( BS("Mit Hilfe von Seil und Kletterhaken kannst Du die steile "
          "Felsklippe bezwingen.") );
        TP->move( ROOM "felsen", M_GO, "die steile Felsklippe hinauf",
             "klettert", "kommt heraufgeklettert");
        return 1;
      }
      write( BS("Mit einem Seil alleine kannst Du es nicht schaffen. Du "
        "braeuchtest noch Kletterhaken, denn die Klippe ist hier wirklich "
        "sehr steil.") );
      return 1;
    }
    write( BS("Die Klippen sind hier zu steil, um noch hoeher zu klettern. "
      "Du braeuchtest schon eine spezielle Kletterausruestung dafuer.") );
    return 1;
  }
  return 0;
}

int baden(string str)
{
  notify_fail("Wo willst Du baden?\n");
  if(!str) return 0;
  notify_fail("Dort kannst Du nicht baden!\n");
  if( member( ({"meer", "wasser", "im wasser", "im meer", "in meer", "in wasser"}), str)!=-1 )
  {
    write( BS("Die einzige Moeglichkeit, von hier ins Wasser zu kommen ist,"
      " von der Klippe zu springen, aber das koennte gefaehrlich sein."));
    return 1;
  }
  return 0;
}

int springen(string str)
{
  notify_fail("Wohin willst Du springen?\n");
  if(!str) return 0;
  if( member( ({"meer", "ins meer", "in meer", "in wasser", "wasser",
                "ins wasser","von klippen","von klippe", "von felsklippen",
                "von felsklippe"}), str)!=-1 )
  {
    write( "Du ueberwindest deine Angst und wagst den mutigen Sprung ins "
      "Meer.\n");
    TP->move( ROOM "meer", M_GO, "von der Klippe ins Meer hinunter",
             "springt", "springt von oben ins Wasser");
    return 1;
  }
  return 0;
}

int stehlen(string str)
{
  int i,anzahl_moewen;
  object moewe, ob;

  notify_fail("Was willst Du stehlen?\n");
  if(!str) return 0;
  notify_fail("Sowas kannst Du hier nicht stehlen!\n");
  if( str=="ei" || str=="ei aus nest" || str=="eier" )
  {
    if (present("moewe"))
    {
      write("Die Moewe hindert Dich daran, die Eier zu nehmen.\n");
      return 1;
    }
    if( ob=present( OSTERHASENQUEST_ID, TP) )
    {
      if(  ob->query_color("gelb") )
      {
        write("Warum willst Du ein Ei stehlen? Die gelbe Farbe ist doch "
          "noch voll!\n");
        return 1;
      } 
      write( BS("Ganz vorsichtig stiehlst Du ein Ei, brichst es auf und "
        "fuellst damit die gelbe Farbe an.") );
      ob->set_color("gelb");
      return 1;
    }
    write("Bevor Du auch nur ein Ei stehlen kannst, greifen Dich die Moewen "
      "an.\n");
    anzahl_moewen=random(4)+1;    
    for(i=0;i<anzahl_moewen;i++)
    {
     (moewe = clone_object( NPC "moewe" ))->move( TO, M_NOCHECK);
      if (!IS_WIZARD(TP))
        moewe->Kill(TP);
    }
    return 1;
  }
  return 0;
}

int schreiben(string str)
{
  notify_fail("Was willst Du schreiben?\n");
  if( !str) return 0;
  if( str[0..8]=="postkarte")
  {
    write( BS("Du schreibst eine Postkarte an Feyaria und dankst ihr fuer "
              "diese schoene Insel.") );
    DB( TPN +" schickt Dir eine Postkarte von der Felseninsel.\n" );
    call_out("danke", 10);
    return 1;
  }
  return 0;
}

danke()
{
  write( "Feyaria knuddelt Dich aus der Ferne.\n");
  call_out("danke2", 4);
}

danke2()
{
  TP->Message("Feyaria teilt Dir mit: Schoen, dass Dir meine Insel "
      "gefaellt :)\n", MSGFLAG_TELL);
}

void reset()
{
  object ob;
  ::reset();
  while( ob=present("moewe"))
  {
    ob->remove();
    tell_room(TO,"Eine Moewe fliegt aufs Meer hinaus.\n");
  }
}
