// /d/dschungel/feyaria/felseninsel/room/meer.c
// Klippen auf der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 15-11-96   Feyaria@SilberLand
// 23 Details, 3 Sounds, 3 Smells

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Im Meer");
  SetProp(P_INT_LONG, BS(
    "Du schwimmst im warmen Meer vor der Kueste einer kleinen Felseninsel. "
    "Ueber Dir fliegen viele Seevoegel herum, die wohl hier im Meer auf "
    "Fischfang gehen. Und tatsaechlich kannst Du unter Dir einige kleine "
    "Fische herumschwimmen sehen.") ); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23,ENV_TERRAIN:TT_UNDERWATER,
                          ENV_WATER: 500]) );
  SetProp(P_KILL_NAME, "Ertrinken");
  SetProp(P_NOMAGIC,1);
  
  AddDetail( "himmel",
    "Am Himmel ist nicht das kleinste Woelkchen zu sehen. Nur am Horizont "
    "haengt eine kleine Wolkenbank.");
  AddDetail( ({"wolke", "wolken", "woelkchen"}),
    "Bis auf die Wolkenbank am Horizont ist keine Wolke zu sehen.");
  AddDetail( ({"horizont", "wolkenbank"}),
    "Am Horizont haengt eine Wolkenbank, aber ansonsten ist es wolkenlos.");
  AddDetail( "sonne",
    "Die Sonne brennt erbarmungslos vom Himmel herunter. Das ist wohl auch "
    "der Grund, dass das Wasser so warm ist.");
  AddDetail( "wind",
    "Der frische Wind macht kleine Wellen.");
  AddDetail( "hitze",
    "Hier im Wasser laesst sich die Hitze viel besser ertragen.");
  AddDetail( "meer",
    "Das Meer hat eine herrliche gruenblaue Farbe. Die grossen Wellen "
    "brechen sich an einem Riff, sodass es hier nur noch kleine Wellen "
    "gibt.");
  AddDetail( ({"farbe", "gruenblau"}),
    "Die gruenblaue Farbe des Meeres ist wirklich schoen.");
  AddDetail( ({"wellen", "welle"}),
    "Hier in Strandnaehe sind die Wellen nur mehr sehr klein, aber "
    "ausserhalb des Riffs sind sie mehr als meterhoch.");
  AddDetail( "riff", 
    "An diesem Riff brechen sich die grossen Wellen. Wegen dem Riff koennen "
    "auch keine groesseren Schiffe diese Insel ansteuern.");
  AddDetail( ({"strand", "sandstrand"}),
    "Der Sandstrand dieser Bucht ist nicht sehr lang. Nach ungefaehr 20 "
    "Metern beginnen schon wieder die Klippen.");
  AddDetail( "sand",
    "Hier ist kein Sand.");
  AddDetail( "wasser",
    "Das Meerwasser ist angenehm warm. Du moechtest ewig hier bleiben.");
  AddDetail( ({"meerwasser", "salzwasser"}),
    "Natuerlich ist das Meerwasser salzhaltig.");
  AddDetail( "salz",
    "Das Salz ist im Wasser geloest. Sehen kann man es nicht.");
  AddDetail( "bucht",
    "Diese kleine Bucht wird von hohen Felsklippen umgeben. Nur an einer "
    "Stelle treten sie ein Stueck zurueck und lassen ein Stueck Sandstrand "
    "frei.");
  AddDetail( ({"ufer", "kueste" }),
    "Das Ufer bildet hier ein schmaler Sandstrand.");
  AddDetail( ({"klippen", "klippe", "felsklippen", "felsklippe"}),
    "Die Klippen ragen steil hinter dem Strand auf. Viele Seevoegel haben "
    "ihre Nistplaetze in den Klippen aufgeschlagen. Ob man die Klippen "
    "irgendwo erklettern kann, ist ungewiss.");
  AddDetail( ({"insel", "felseninsel"}),
    "Du schwimmst vor einer kleinen Felseninsel. Wie gross sie ist, kannst "
    "Du von hier nicht feststellen. Sie besteht aus einem schmalen Streifen "
    "Sandstrand, der von hohen Felsklippen eingeramht wird.");
  AddDetail( ({"voegel", "vogel", "seevogel", "seevoegel"}),
    "Die Seevoegel nisten in der steilen Felsklippe und fliegen hier heraus "
    "zum Fischefangen. Hauptsaechlich handelt es sich dabei um Moewen.");
  AddDetail( ({"moewen", "moewe"}),
    "Hier gibt es eine ganze Menge von Moewen.");
  AddDetail( ({"fischfang", "fischefang"}),
    "Hier kann man sicher gut Fische fangen.");
  AddDetail( ({"fisch", "fische"}),
    "Unter Dir schwimmen einige kleine Fische herum.");
  AddDetail( ({"nistplatz", "nest", "nistplaetze", "nester"}),
    "Die Nester sind viel zu weit weg.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen der Wellen und das Schreien der Voegel.");
  AddSound( ({"wellen", "welle", "rauschen"}),
    "Das Rauschen der Wellen ist hier sehr laut.");
  AddSound( ({"schreie", "schreien", "voegel", "moewen", "seevoegel"}),
    "Die Schreie der Voegel klingen schrill in Deinen Ohren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Meer.");
  AddSmell( "meer",
    "Das Meer riecht nach Salz, Seetang und Fisch.");
  AddSmell( ({"salz", "seetang", "tang", "fisch"}),
    "Danach riecht das Meer ganz intensiv.");

  AddRoomMessage( 
    ({
      "Du schluckst etwas Salzwasser.\n",
      "Eine kleine Welle schlaegt ueber Deinem Kopf zusammen.\n",
      "Eine Moewe taucht neben Dir ins Wasser ein.\n",
      "Unter Dir schwimmt ein kleiner Fisch vorbei.\n"
     }), 50, "fisch");

  AddCmd( ({"nimm", "steck", "stecke", "leg", "lege"}), "nehmen");
  AddCmd( ({"zieh", "ziehe", "trage", "trag"}), "an_aus_ziehen");
  AddCmd( ({"schwimme", "schwimm"}), "baden");
  AddCmd( ({"fische", "fisch", "angle", "angel", "fang", "fange"}),"fangen");
  AddCmd( ({"spritze", "spritz"}), "spritzen");
}

fisch(int msg)
{
  if(msg==2)
    call_out("fisch2",5);
}

fisch2()
{
  if (random(2))
    tell_room(TO,"Die Moewe taucht wieder auf und fliegt kreischend "
                 "davon.\n");
  else
    tell_room(TO,"Die Moewe taucht mit einem Fisch im Schnabel auf und fliegt "
                 "davon.\n");
}

int baden(string str)
{
  notify_fail("Wohin willst Du schwimmen?\n");
  if(!str) return 0;
  if( member( ({"norden", "ufer", "strand", "sandstrand", "nach norden",
     "zum ufer", "zum strand", "an den strand", "zurueck", "an strand",
     "ans ufer", "an ufer" }),str)!=-1)
  {
    write("Du schwimmst wieder ans Ufer zureuck.\n");
    TP->move( ROOM "strand3", M_GO, "ans Ufer zurueck", "schwimmt",
             "kommt pudelnass aus dem Meer");
    if( find_call_out("ertrinken") )
      remove_call_out("ertrinken");
    return 1;
  }
  return 0;
}
             
int fangen(string str)
{
  notify_fail("Was willst Du fangen?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du hier nicht fangen!\n");
  if( str=="fisch" || str=="fische")
  {
    if (present("angel", TP))
    {
      write( "Du wirfst Deine Angel mitten im Wasser aus, aber der "
        "Haken bohrt sich in\nDeinem grossen Zeh.\n AUA!!!\n" );
      TP->reduce_hit_point(5);
      return 1;
    }
    write("Willst Du mit blossen Haenden Fische fangen?\n");
    return 1;
  }
  return 0;
}

int an_aus_ziehen()
{
  write("Du strampelst wild im Wasser herum, aber ohne Ergebnis.\n");
  return 1;
}

init()
{
  ::init();
  if( TP->QueryProp(P_ARMOURS)!=({}) )
    call_out("ertrinken",0);   
}

void ertrinken()
{
  int i,gewicht;
  object *armours;
  gewicht=0;
  armours=TP->QueryProp(P_ARMOURS);
  for(i=sizeof(armours)-1;i>-1;i--)
    gewicht+=armours[i]->QueryProp(P_WEIGHT);
//  DB("Gesamtgewicht= "+gewicht+"\n"); 
  if( gewicht > random(1000)+1000 )
  {
    write("Deine schweren Ruestungen ziehen Dich auf den Meeresgrund.\n");
    TP->do_damage( 2+random(5) );
  }
  if( ENV(TP)==TO)
      call_out("ertrinken",1);
}

int nehmen()
{
  write("Du brauchst beide Haende zum Schwimmen, darum kannst Du nichts "
        "nehmen.\n");
  return 1;
}

void reset()
{
  object ob,next;
  ::reset();
  for(ob=first_inventory(TO);ob;)
  {
    next=next_inventory(ob);
    if( !living(ob) )
    {
      if(random(2))
      {
         tell_room(TO, ob->Name(WER,2)+ " wird ans Ufer getrieben.\n");
         ob->move(ROOM "strand3", M_NOCHECK);
      }
      else
      {
        tell_room(TO, ob->Name(WER,2)+ " geht unter.\n");
        ob->remove();
        if( ob ) destruct(ob);
      }
    }
    ob=next;
  }
}

int spritzen(string str)
{
  object wen;
  string wer;
  notify_fail("Wen willst Du anspritzen?\n");
  if( !str ) return 0;
  if( sscanf(str ,"%s an", wer)!=1 ) return 0;
  if( !wen=present(wer) ) return 0;
  write("Du spritzt "+wen->name(WEN,1)+" mit Wasser an.\n");
  say(CAP_TPN+" spritzt "+wen->name(WEN,1)+" mit Wasser an.\n", ({TP, wen}));
  tell_object(wen, CAP_TPN+" spritzt Dich mit Wasser an.\n"+
      "Deine Haare sind jetzt voellig durchnaesst.\n");
  return 1;
}

