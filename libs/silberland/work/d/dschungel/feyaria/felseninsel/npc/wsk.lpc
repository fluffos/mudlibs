// /d/dschungel/feyaria/felseninsel/npc/wsk.c
// Eine Wasserschildkroete
// 22-10-1996  Feyaria@SilberLand
// 15-11-1996  angepasst fuer Felseninsel

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Wasserschildkroete");
  SetProp(P_LONG, BS(
    "Eine kleine Wasserschildkroete, wie man sie ueberall in Kuestennaehe "
    "sehen kann."));
  SetProp(P_NAME, "Wasserschildkroete");
  SetProp(P_GENDER, FEMALE);
  set_living_name("wasserschildkroete");
  AddId( ({"schildkroete", "wasserschildkroete"}) );

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit ihrem Maul", 50, DT_BLUDGEON})); //schwaecher Hands
  SetProp(P_BODY, 90); // dafuer mehr Body
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 30+random(10));
  SetProp(P_ALIGN, 300);
  SetProp(P_DIE_MSG, " wird eine gute Schildkroetensuppe abgeben.\n");

  SetProp(P_DEFAULT_INFO, "kann dich doch gar nicht verstehen.\n");
  AddInfo("feyaria",
    "Feyaria hat mich erschaffen.","teilt Dir mit: ", 1);
  AddInfo("nesaja",
    "Die ist auch eine Schildkroete :)", "sagt erfreut: ");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Wasserschildkroete will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({ DT_WATER, DT_PIERCE, DT_WHIP })); 

  SUID;
  CLONEME( ARMOUR "wskpanzer" ); 
  command("trage alles");

}
