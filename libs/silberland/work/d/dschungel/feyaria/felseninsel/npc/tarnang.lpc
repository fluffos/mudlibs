// /d/dschungel/feyaria/felseninsel/npc/tarnang.c   
// Schmied unter der Berserekrgilde - Bruder von Kronang 
// 1998-11-18 Feyaria@SilberLand

inherit "std/repair";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  repair::create();

  SetProp(P_SHORT, "Tarnang, der einhaendige Schmied");
  SetProp(P_LONG,
    "Das ist Tarnang, der einhaendige Schmied. Er ist fuer einen Menschen "
    "sehr gross und hat verfiltztes, graues Haar. Sein nackter Oberkoerper "
    "ist vom Russ des Schmiedefeuers ganz schwarz. Anstatt seiner rechten "
    "Hand ist ein grosser, silbrig glaenzender Hammerkopf an seinem Arm "
    "befestigt.");
  SetProp(P_NAME, "Tarnang");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"tarnang", "schmied"}));
  AddDetail( ({"hammer", "hammerkopf", "hand"}) ,
    "Tarnang hat nur mehr eine Hand, denn an seinem rechten Arm befindet "
    "sich ein gewaltiger, silbrig schimmernder Hammer, mit dem er wohl "
    "seine Schmiedearbeiten erledigt.");

  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seiner Hammerhand", QueryProp(P_HANDS)[1], 
      DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 195);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 1);
  SetProp( P_RESISTANCE_STRENGTHS,
    ([DT_FIRE:-0.7, DT_TERROR:-0.6, DT_SOUND: -0.2]) );
  SetProp(P_NOATTACK, "sagt: Hoer auf, oder ich hol meinen Bruder Kronang!");
  
  AddInfo(DEFAULT_INFO,
    ({"sagt: Frag doch meinen Bruder Kronang.\n",
      "sagt: Kronang weiss das sicher.\n",
      "sagt: Ich bin nur ein Schmied und weiss das nicht.\n",
      "sagt: Soll ich Dir etwa eine Axt reparieren?\n",
      "schaut Dich erstaunt an.\n"}) );
  AddLibrary( "/d/dschungel/feyaria/tijara/npc/material.lib",1);
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"name", "tarnang", "schmied"}),
    "Ich bin Tarnang, der einhaendige Schmied.", "sagt: ");
  AddInfo( ({"kronang", "bruder"}),
    "Kronang ist mein Bruder!", "sagt stolz: "); 
  AddInfo( ({"axt", "aexte", "beil", "beile"}),
    "Ich kann jede Form von Aexten und Beilen reparieren.", "sagt: ");  
  AddInfo( ({"hand", "hammer", "hammerkopf", "hammerhand"}),
    "Meine Hand habe ich im Kampf gegen die gehoernte Bestie verloren. "
    "Aus Dankbarkeit fuer die Heldentaten meines Bruders haben mir die "
    "Zwerge dann diese gewaltige Hammerhand gefertigt", "erzaehlt: ");
  AddInfo( ({"heldentaten", "held"}),
    "Mein Bruder Kroanang ist ein echter Held!", "sagt stolz: ");
  AddInfo( ({"zwerg", "zwerge"}),
    "Die Zwerge haben fuer mich diese schoene Hammerhand gefertigt.",
    "sagt: ");
  AddInfo( ({"bestie", "gehoernte bestie"}),
    "Die gehoernte Bestie hat mir die Hand abgebissen! Zum Glueck hat "
    "Kronang sie als Rache dafuer getoetet!", "sagt verbittert: ");
  
  SetProp(P_LOG_INFO, "feyaria/tarnang");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Tarnang sagt: @WER brauche ich nicht.\n" }) );

  SetChats(2, ({
    "Tarnang schmiedet etwas.\n",
    "Tarnang stellt eine neue Axt her.\n",
    "Tarnang schmiedet eine Axtklinge.\n",
    "Tarnang werkt an dem Stiel einer Axt herum.\n",
    "Tarnang repariert eine Axt.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( !adverb ) adverb ="\b";
  if (find_call_out("react")!= -1) return;
  call_out("react",0, "schaut veraergert von seiner Arbeit auf.", 
        "schaut veraergert von seiner Arbeit auf.");
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int rep_auswahl(object ob)
{
  if( ob->QueryProp(P_WEAPON_TYPE)==WT_AXE )
    return 1;
  write("Tarnang sagt: Ich kann nur Aexte und Beile reparieren!\n");
  return 0;
}

