// /d/dschungel/feyaria/felseninsel/npc/moewe.c
// Moewe auf der Felseninsel
// 21-10-96   Feyaria@AnderLand
// 15-11-96   Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Moewe");
  SetProp(P_LONG, "Eine Moewe flattert aufgeregt um Deinen Kopf herum.\n");
  SetProp(P_NAME, "Moewe");
  SetProp(P_GENDER, FEMALE);
  AddId("moewe");
  create_default_npc(7);
  SetProp(P_HANDS, ({" mit ihrem spitzen Schnabel", 77, DT_PIERCE}));
  SetProp(P_XP, QueryProp(P_XP)+2000); // Bonus fuer Spells
  SetProp(P_ALIGN, -100);  // frech
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 40+random(10));
  SetProp(P_HEAL, 5+random(5) );
  
  SetAttackChats(10, ({"Die Moewe kreischt ganz laut.\n",
    "Die Moewe schlaegt ganz wild mit ihren Fluegeln.\n"}) );
   
  SetProp(P_SPELLRATE,30);
  AddSpell(4,100,
    "Die Moewe pickt wie wild auf deinen Kopf ein.\n",
    "Die Moewe pickt wie wild auf @WESSEN Kopf ein.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]) );
  AddSpell(3,150,
    "Die Moewe pickt Dir fast ein Auge aus.\n",
    "Die Moewe pickt @WEM fast ein Auge aus.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Moewe will Deine Sachen nicht tragen.\n" }) );

}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "moewen",
    ctime()+": Eine Moewe hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

