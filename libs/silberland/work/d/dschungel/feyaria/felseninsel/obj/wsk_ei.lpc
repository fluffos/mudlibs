// /d/dschungel/feyaria/felseninsel/obj/wsk_ei.c
// Ein Wasserschildkroetenei 
// 1997-09-10 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Wasserschildkroetenei");
  SetProp(P_LONG, BS( 
    "Dieses Ei einer Wasserschildkroete ist faustgross und ist cremefarben.") );
  SetProp(P_INFO, 
    "Irgendwann wird einmal eine Schildkroete aus dem Ei schluepfen.\n");
  SetProp(P_NAME, "Wasserschildkroetenei");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"ei", "schildkroetenei", "wasserschildkroetenei"}) );

  SetProp(P_MATERIAL, MAT_ANIMAL );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

}
