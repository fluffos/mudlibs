// /d/dschungel/feyaria/felseninsel/obj/strand.c
// Objekt, dass der Spieler bekommt, wenn er im strand liegt
// 22-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

object pl;
object env;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  AddId( "\nstrand" );
  SetProp(P_SHORT, "");
  SetProp(P_LONG,  "" );
  SetProp(P_INVIS, 1);

  AddCmd( ({"stehe","steh"}), "aufstehen");
  AddCmd( ({"westen", "osten", "nordwesten", "nordwestoben"}), "gesperrt");
  AddCmd( ({"huepfe", "tanze", "toete", "huepf", "tanz"}), "gesperrt");
  AddCmd( ({"kletter", "klettere"}), "gesperrt");
  AddCmd( ({"schwimme", "schwimm", "bade"}), "gesperrt");
  AddCmd( ({"knickse", "verbeuge"}), "gesperrt");

  pl=TP;  // wird beim move() nochmal richtiger gesetzt
  env=environment(TP);
  call_out("heilung", 2);
}

void BecomesNetDead(object spieler)
{
  tell_object(spieler, "Du erhebst Dich vom Badetuch.\n");
  TO->remove();
}

int gesperrt()
{
  write("Solltest Du nicht erstmal aufstehen?\n");
  return 1;
}

int aufstehen(string str)
{
  notify_fail("Willst Du vielleicht aufstehen?\n");
  if(str=="auf")
  {
    write( BS("Du laesst einen tiefen Seufzer erklingen und stehst auf. "
      "Du rollst Dein Badetuch wieder zusammen und steckst es ein.") );
    say(TPN+" seufzt tief und steht auf.\n");
    remove_call_out("heilung");
    TO->remove();
    return 1;
  }
  return 0;
}

void heilung()
{
  if (!pl || !query_once_interactive(pl) || !environment(pl) ||
      environment(pl) != env)
  {
    TO->remove();
    return;
  }
  if (file_name(environment(pl))[0..32]=="/d/dschungel/feyaria/felseninsel/") {
    if (interactive(pl))
      pl->heal_self(1);
    call_out("heilung",2);
  } else if (file_name(environment(pl))[0..5]=="/room/") {
    // netztot oder so...
    call_out("heilung",2);
  } else {
    TO->remove();
    return;
  }
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==FEMALE)
    return BS ("Sie liegt entspannt auf ihrem Badetuch am Strand.\n");
  else
    return BS ("Er liegt entspannt auf seinem Badetuch am Strand.\n");
}

varargs int move(mixed dest, int method)
{
  int ret;

  if (!query_once_interactive(dest)) {
    call_out("remove",0);
    return ME_CANT_BE_DROPPED;
  }
  ret = ::move(dest,method);
  if (ret>0)
  {
    pl=dest;
    pl->SetProp(P_RESTING, time());
  }
  return ret;
}

void remove()
{
  if(pl && pl->QueryProp(P_RESTING) )
    pl->SetProp(P_RESTING, 0);
  ::remove();
}
