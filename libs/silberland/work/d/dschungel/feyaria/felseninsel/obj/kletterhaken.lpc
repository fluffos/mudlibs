// /d/dschungel/feyaria/felseninsel/obj/kletterhaken.c
// Kletterhaken zum Klettern in den Klippen
// 22-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Kletterhaken");
  SetProp(P_LONG, 
    "Mit diesem Kletterhaken kannst Du steile Felsen erklettern.");
  SetProp(P_NAME, "Kletterhaken");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 79);
  SetProp(P_NOBUY, 1);

  AddId( ({"kletterhaken", "haken"}) );
}
