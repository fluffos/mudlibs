// /d/dschungel/feyaria/felseninsel/obj/badetuch.c
// Badetuch zum Liegen am Strand der Felseninsel
// 22-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Badetuch");
  SetProp(P_LONG, 
    "Dieses Badetuch ist wie geschaffen dafuer, sich damit am Strand in "
    "die Sonne zu legen." );
  SetProp(P_NAME, "Badetuch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_WEIGHT, 231);
  SetProp(P_VALUE, 444);
  SetProp(P_NOBUY, 1);

  AddId( ({"badetuch", "tuch"}) );
  farbe();
}

void farbe()
{
  switch( random(10) )
  {
    case 0: SetProp(P_NAME_ADJ, "gelb");
            AddAdjective("gelbes");
            SetProp(P_SHORT, "Ein gelbes Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es hat eine schoene gelbe Farbe.") );
            break;
    case 1: SetProp(P_NAME_ADJ, "rot");
            AddAdjective("rotes");
            SetProp(P_SHORT, "Ein rotes Badetuch");
            SetProp(P_LONG, BS (QueryProp(P_LONG)+
              "Es hat eine schoene rote Farbe.") );
            break;
    case 2: SetProp(P_NAME_ADJ, "gruen");
            AddAdjective("gruenes");
            SetProp(P_SHORT, "Ein gruenes Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es hat eine schoene gruene Farbe.") );
            break;
    case 3: SetProp(P_NAME_ADJ, "rosarot");
            AddAdjective("rosarotes");
            SetProp(P_SHORT, "Ein rosarotes Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es hat eine schoene rosarote Farbe.") );
            break;
    case 4: SetProp(P_NAME_ADJ, "gestreift");
            AddAdjective("gestreiftes");
            SetProp(P_SHORT, "Ein gestreiftes Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es ist ganz gestreift.") );
            break;
    case 5: SetProp(P_NAME_ADJ, "getupft");
            AddAdjective("getupftes");
            SetProp(P_SHORT, "Ein getupftes Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es hat viele farbige Tupfer.") );
            break;
    case 6: SetProp(P_NAME_ADJ, "blau");
            AddAdjective("blaues");
            SetProp(P_SHORT, "Ein blaues Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es hat eine schoene blaue Farbe.") );
            break;
    case 7: SetProp(P_NAME_ADJ, "kunterbunt");
            AddAdjective("kunterbuntes");
            SetProp(P_SHORT, "Ein kunterbuntes Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es ist ganz kunterbunt und leuchtet in allen moeglichen "
              "Farben.") );
            break;
    case 8: SetProp(P_NAME_ADJ, "geblumt");
            AddAdjective("geblumtes");
            SetProp(P_SHORT, "Ein geblumtes Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es hat viele kleine, bunte Bluemchen drauf.") );
            break;
    case 9: SetProp(P_NAME_ADJ, "weiss");
            AddAdjective("weisses");
            SetProp(P_SHORT, "Ein weisses Badetuch");
            SetProp(P_LONG, BS( QueryProp(P_LONG)+
              "Es hat eine schoene weisse Farbe.") );
            break;
  }
}
