// /d/dschungel/feyaria/riff/room/riff.c
// riff
// 1997-03-06  Feyaria@SilberLand
// 21 Details, 2 Sounds, 2 Smells

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Im Korallenriff");
  SetProp( P_INT_LONG, BS(
"Du schwimmst durch die blauen Weiten des Meeres, da ploetzlich erblickst Du "
"vor Dir das sagenumwobene Riff. Schoener haettest Du es Dir in Deinen "
"Traeumen wohl nicht vorstellen koennen! Dieser Anblick uebertrifft jede "
"Beschreibung, die Du bisher vernommen hast! Rund um das Riff siehst Du "
"ein Farbenmeer und einen herrlichen Regenbogen. Du kannst Dich nicht "
"sattsehen an dieser einzigartigen Schoenheit!"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27]) );


AddDetail( ({"weiten"}),
"Du hast die Muehen auf Dich genommen, durch die Weiten des Meeres zu "
"schwimmen, um endlich zu erfahren, ob die vielen Geschichten wahr sind, "
"oder ob Du wieder mal nur Seemannsgarn entworren hast!");

AddDetail( ({"geschichten"}),
"Verflixt, da war doch etwas wegen dieses Riffs? Kommt Dir denn kein "
"Gedanke in den Sinn?");

AddDetail( ({"gedanke", "sinn"}),
"Irgendetwas war da, zur Teufelin noch mal! Dir faellt es leider nicht mehr "
"ein!");

 AddDetail( ({"teufelin", "teufel"}),
"Wir wollen ja nicht gleich den Teufel ins Spiel bringen, oder gar seine "
"Grossmutter!");
 
 AddDetail( ({"grossmutter"}),
"Das war's! Deine Grossmutter hat Dir da ein paar Geschichten erzaehlt und "
"schoen langsam kommt die Erinnerung zurueck!");

 AddDetail( ({"erinnerung"}),
"Ja, nun weisst Du es wieder! Weit draussen im Meer sollte es dieses Riff "
"geben. Ein himmlischer Ort, der mit Worten nicht zu beschreiben ist. "
"Seine einmalige Schoenheit hat von jeher schon jedermann bezaubert. Aber "
"diese Schoenheit kann Dir auch zum Fluch werden! Triton, der Koenig der "
"Unterwasserwelt liebt den himmlischen Anblick dieses Riffes, aber er ist "
"nicht bereit zu teilen. Ein kurzer Blick auf das Riff sei allen gewaehrt, "
"wer aber die Frechheit besitzen sollte, laenger zu verweilen, dem kann es "
"zum Verhaengnis werden. Oft schon kehrten mutige Abenteuerer nicht von "
"dem Ausflug zum Riff zurueck. Was aus ihnen geworden ist, darauf weiss "
"wohl nur der Koenig Antwort!");

 AddDetail( ({"antwort"}),
"Wenn Du genau hinhoerst, kannst Du der Erzaehlung der Wellen lauschen. "
"Vielleicht wissen sie ja, was Du gerade zu erforschen versuchst!");

 AddDetail( ({"lausche", "erzaehlung"}),
"Da sich die uebermuetigen Abenteurer nicht satt sehen konnten, sollten "
"sie diesen Ort auch nicht mehr verlassen muessen. Sie wurden ein Teil des "
"Riffs.");

 AddDetail( ({"teil"}),
"Ein Teil ist nicht alles.");

 AddDetail( ({"ausflug"}),
"Sie schwammen, wie Du gerade, hierher zum Riff!");

 AddDetail( ({"abenteurer"}),
"Auch Du bist einer, pass gut auf Dich auf!");

 AddDetail( ({"verhaengnis"}),
"Die armen Abenteurer konnten sich am Riff nicht sattsehen, das endete "
"dann wohl tragisch!");

 AddDetail( ({"koenig", "triton", "herrscher"}),
"Auch hier in der Unterwasserwelt muss jemand fuer Recht und Ordnung "
"sorgen. Normalerweise ist Triton ja ein guetiger Herrscher, doch auch er "
"ist nur ein Mann und kann nicht aus seiner Fischhaut, auch er stellt "
"manchmal ueberraschend hohe Besitzansprueche!");

 AddDetail( ({"unterwasserwelt"}),
"Hier unter dem Meer leben die vielen Tierchen friedlich miteinander. Auch "
"hier gilt das Gesetz des Staerkeren. Gegen die goettergegebenen "
"Bedingungen, dass sich groessere Tiere von kleineren ernaehren muessen, "
"koennen sich die Tierchen hier, wie die Bewohner oberhalb des Meeres, "
"nicht wehren. Sie lernen damit zu leben, und tun dies sogar recht gut.");

 AddDetail( ({"recht", "ordnung"}),
"Triton sorgt fuer Recht und Ordnung hier unter dem Meer.");

 AddDetail( ({"tierchen"}),
"Alles, was so unter dem Meer zu leben pflegt.");

 AddDetail( ({"gesetz", "staerkere", "starke", "schwache", "bedingungen"}),
"Der Starke siegt, der Schwache faellt, so ist es nun mal!");

 AddDetail( ({"bewohner", "beweis"}),
"Dass man auch ausserhalb des Meeres existieren kann, dafuer bist Du der "
"lebende Beweis! ");

 AddDetail( ({"mann", "frau"}),
"Nunja, man darf nicht verallgemeineren, auch Frauen stellen manchmal zu "
"hohe Besitzansprueche.");

 AddDetail( ({"fischhaut", "mensch", "tier"}),
"Ein normaler Mensch koennte hier unten kaum ueberleben. Triton ist also "
"eine Mischung zwischen Mensch und Tier.");

 AddDetail( ({"besitzansprueche"}),
"Triton ist im Bezug auf das Riff vielleicht ein wenig uebersensibel, aber "
"dagegen kann wohl keiner was tun!");

 AddDetail( ({"bezug"}),
"Frag doch nicht so dumm!");

 AddDetail( ({"frechheit"}),
"Ich empfinde es zwar nicht als Frechheit, sich ein wenig an dieser "
"Schoenheit zu erfreuen, auch wenn es laenger dauern sollte, der Koenig "
"denkt offensichtlich aber nicht so! Leider :-(");

 AddDetail( ({"fluch"}),
"Unglaublich, aber wahr! Auf diesem schoenen Ort haftet ein boeser Fluch!");

AddDetail( ({"wort", "worte", "woerter"}),
"Du findest keine Worte!");

AddDetail( ({"seemannsgarn", "luegen", "unwahrheit"}),
"Luegen, Unwahrheit! Du wurdest ja wahrscheinlich schon mal von einem "
"Seemann reingelegt.");

AddDetail( ({"seemann", "kilian"}),
"Auf die Schnelle faellt mir nur Kilian ein, der verbreitet meist solches "
"Seemannsgarn. Lange genug hielt er sich ja auf der hohen See aus.");

AddDetail( ({"schnelle"}),
"Nur immer schoen langsam. Wir wollen doch nicht, dass Dir etwas "
"zustoesst, oder?");

 AddDetail( ({"meer", "see"}),
"Du vernimmst ploetzlich ein seltsames Singen!");

 AddSound( ({"singen"}),
"Unter dem Meer (unter dem Meer), unter dem Meer (unter dem Meer)"
"wo waer das Wasser, blauer und nasser als es hier waer?"
"Die oben schuften wie verrueckt, nur wir sind wundersam beglueckt,"
"wo kann's das geben, wo lohnt sich Leben unter dem Meer!");

 AddDetail( ({"wasser"}),
"Wasser findest Du hier wohl zur Genuege!");

 AddDetail( ({"genuege"}),
"Mir reicht es schoen langsam! Man kann sich nicht zu jedem Detail etwas "
"einfallen lassen!");

 AddDetail( ({"detail", "stueck", "ganzes"}),
"Ein Detail ist ein Stueck vom Ganzen.");

 AddDetail( ({"augen", "augenlicht"}),
"Wie wichtig das Augenlicht ist, sollte man nicht erst schaetzen lernen, "
"wenn man es verliert!");

 AddDetail( ({"riff", "korallenriff", "ort"}),
   QueryProp(P_INT_LONG) ); 

 AddDetail( ({"traeume", "traum"}),
"Jeder von uns hat Traeume! Manche lassen sich nur schwer verwirklichen, "
"manche sehr leicht. Doch man sollte nie aufhoeren zu traeumen, dazu sind "
"Traeume einfach zu schoen!");

 AddDetail( ({"anblick", "blick"}),
"Dieser Anblick laesst sich in Worten nicht ausdruecken!");

 AddDetail( ({"beschreibung"}),
"Auch diese Beschreibung hier kann die Schoenheit nur annaehernd streifen. "
"Benuetze Deine Fantasie und mal Dir aus, wie das Riff wohl aussieht!");

 AddDetail( ({"fantasie"}),
"Benuetz doch Deine Fantasie, dann weisst Du, wie schoen es ist!");

 AddDetail( ({"schoenheit"}),
"Diese Schoenheit kann wohl keiner uebertreffen!");

 AddDetail( ({"farbenmeer"}),
"Woher stammen wohl diese vielen Farben?");

 AddDetail( ({"farben"}),
"Nun erkennst Du, dass es sich um die vielen Fische handelt, die sich "
"farbenfroh um das Riff tummeln. Sie sind wundervoll anzusehen.");

 AddDetail( ({"regenbogen", "regenbogenfische"}),
"Den Regenbogen zaubert das Heer von Regenbogenfischen, die auch hier in "
"der Naehe des Riffs zu finden sind.");

 AddDetail( ({"fische", "fisch"}),
"Fische sind logischerweise hier im Meer zu finden.");

 AddDetail( ({"naehe"}),
"Du bist unmittelbar beim Riff!");

  AddExit("raus", "/players/feyaria/workroom");
}

