
#include "../def.h"
#include "./race_guild_armour.h"

inherit ARMOUR "race_guild_armour";

void create()
{
  if( !is_clone(TO) ) return;
  SUID;
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) 
  {
    raise_error("Illegales Clonen!");
    destruct();
    return;
  }
}

void create2(string race, mixed type, string guild)
{
  int r,t;
  if (stringp(type))
    t = ([AT_ARMOUR:0, AT_HELMET:1, AT_BRACERS:2, AT_GLOVE:3, 
          AT_BOOT:4, AT_TROUSERS:5, AT_CLOAK:6])[type];
  else if (intp(type))
    t = type;
  else
    t = random(7);
  switch (lower_case(guild))
  {
    case "berserker":
      r = (["Mensch":0, "Zwerg":1, "Elf":2, "Hobbit":3, "Oger":4, 
          "Troll":5, "Dunkelelf":6])[race];
      break;
    case "druiden":
    case "druidenzirkel":
      r = (["Mensch":7, "Zwerg":8, "Elf":9, "Hobbit":10, "Dunkelelf": 11,
          "Oger":12, "Fee":13])[race];
      break;
    case "paladine":
      r = (["Mensch":14, "Zwerg":15, "Elf":16, "Hobbit":17,
          "Troll":18, "Fee":19])[race];
      break;
    case "abenteurer":
      r = (["Mensch":20, "Zwerg":21, "Elf":22, "Hobbit":23, "Oger": 24,
          "Troll":25, "Fee":26])[race];
      break;
    case "dunkelelfen":
      r = 27;
      break;
    case "zechpreller":
      r = (["Mensch":28, "Zwerg":29, "Elf":30, "Hobbit":31, "Dunkelelf": 32, 
          "Oger": 33, "Troll":34, "Fee":35])[race];
      break;
    case "nekromanten":
      r = (["Mensch":36, "Zwerg":37, "Elf":38, "Hobbit":39, "Dunkelelf": 40, 
          "Oger": 41, "Troll":42, "Untoter":43])[race];
      break;
  }
  ::create2(r,t); 
}
