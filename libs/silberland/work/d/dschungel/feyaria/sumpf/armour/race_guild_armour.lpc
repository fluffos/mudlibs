inherit "std/armour";

#include "../def.h"
#include "./race_guild_armour.h"

int light;
void racial_setup(string race);
varargs void create2(int n, int t);

void create()
{
  if( !is_clone(TO) ) return;
  SUID;
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1 && 
      !IS_LORD(previous_object())) 
  {
    raise_error("Illegales Clonen!");
    destruct();
    return;
  }
  switch(random(4))
  {
    case 0:
      create2( X1[random(sizeof(X1))], 
          random(sizeof(RACE_GUILD_ARMOUR_TYPES)));
      break;
    case 1:
      create2( X2[random(sizeof(X2))], 
          random(sizeof(RACE_GUILD_ARMOUR_TYPES)));
      break;
    default:
      create2( random(sizeof(RACE_GUILD_NAMES)), 
          random(sizeof(RACE_GUILD_ARMOUR_TYPES)));
  }
}

varargs void create2(int n, int t)
{
  ::create();
  ARMOUR "race_guild_master"->setup(this_object(),n, t); 
}

int SetLight(int l)
{
  if( file_name(previous_object()) != ARMOUR "race_guild_master")
    return -1;
  light = l;
  return 1;
}

int WearFunc(object me) {
  if( QueryProp(P_ARMOUR_TYPE)==AT_CLOAK)
  {
    if (light > 0)
      write(Name(WER,1)+" beginnt zu leuchten.\n");
    else if (light < 0)
      write(Name(WER,1)+" verdunkelt die Umgebung.\n");
    SetProp(P_LIGHT, light);
  }
  return 1;
}

int RemoveFunc(object me) {
  if( QueryProp(P_ARMOUR_TYPE)==AT_CLOAK)
  {
    if (light > 0)
      write(Name(WER,1)+" wird wieder dunkel.\n");
    else if (light < 0)
      write(Name(WER,1)+" verliert seine dunkle Aura.\n");
    SetProp(P_LIGHT, 0);
  }
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  return 0;
}

int check_equip_time() 
{
  if(time()-QueryProp(P_EQUIP_TIME)>=10) return 1;
  return 0;
}

void reset()
{
  ::reset();
  if( !is_clone(TO) ) return;
  call_out("heal", 10 + random(200));
}

void heal()
{
  object wer;
  if( (!wer=QueryProp(P_WORN)) )
  {
    SetProp(P_LIGHT, 0);
    return;
  }
  if( !interactive(wer) || query_idle(wer) > 300)
    return;
  tell_object(wer, Name(WER,1)+(QueryProp(P_PLURAL)?" blitzen":" blitzt")+
      " kurz auf.\n" );
  switch (wer->QueryProp(P_GUILD))
  {
    case "paladine":
      if (wer->QueryProp(P_ALIGN) < 1100)
        wer->SetProp(P_ALIGN, wer->QueryProp(P_ALIGN)+random(100) );
      else
        wer->heal_self(10 + random(50));
      break;
    case "nekromanten":
      if (wer->QueryProp(P_ALIGN) > -1100)
        wer->SetProp(P_ALIGN, wer->QueryProp(P_ALIGN)-random(100) );
      else
        wer->heal_self(10 + random(50));
      break;
    case "druidenzirkel":
      if (wer->QueryProp(P_ALIGN) > 250)
        wer->SetProp(P_ALIGN, wer->QueryProp(P_ALIGN)-random(100) );
      else if (wer->QueryProp(P_ALIGN) < -250)
        wer->SetProp(P_ALIGN, wer->QueryProp(P_ALIGN)+random(100) );
      else
        wer->heal_self(10 + random(50));
      break;
    case "zechpreller":
      if (wer->QueryProp(P_ALCOHOL) < 2*wer->QueryProp(P_MAX_ALCOHOL)/3)
        wer->SetProp(P_ALCOHOL,wer->QueryProp(P_ALCOHOL)+random(50) );
      else
        wer->heal_self(10 + random(50));
      break;
    default:
      wer->heal_self(10 + random(50));
  }
}

