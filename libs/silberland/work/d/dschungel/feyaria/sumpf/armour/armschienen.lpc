#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Dunkelgruene Armschienen");
  SetProp(P_LONG,  
    "Diese Armschienen bestehen aus dunkelgruenem Leder. Obwohl sie alt "
    "und abgetragen ausschauen, schuetzen sie sicher noch sehr gut."); 
  SetProp(P_NAME, "Armschienen");
  SetProp(P_NAME_ADJ, "dunkelgruen" );
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 9);
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:2]) );
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 2350);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:30]) );
  SetProp(P_SMELL, "Die Armschienen riechen nach Sumpf.");
  AddDetail( "leder",
      "Das Leder ist dunkelgruen. Von welchen Lebewesen es stammt, "
      "laesst sich leider nicht identifizieren.");

  AddId( ({"armschienen", "schienen"}) );
  AddAdjective( ({"dunkelgruene"}) );


}

