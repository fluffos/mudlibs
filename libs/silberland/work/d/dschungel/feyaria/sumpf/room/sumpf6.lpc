#include "../def.h"
inherit ROOM "std_sumpf";

int ente = 1;

void create()
{
  ::create();
  
  AddExit( "nordosten", "./sumpf3" );
  AddExit ("suedwesten" ,"./sumpf11");
  AddExit ("suedosten" ,"./sumpf13");
  add_random_exits();

  AddDetail(  ({"schilf"}),
      GetDetail("schilf")[0..<2] + " Das Schilf ist hier besonders dicht. "
      "Vielleicht solltest Du es einmal genauer durchsuchen.");

  AddCmd( ({"durchsuch", "durchsuche"}), "cmd_durchsuchen");
}

int cmd_durchsuchen(string str)
{
  notify_fail("Was willst Du durchsuchen?\n");
  if( str != "schilf" ) return 0;

  if( ente && !present("ente") )
  {
    write("Du findest eine Ente im Schilf.\n");
    CLONEME("/d/huegelland/feyaria/weg/npc/ente");
    ente = 0;
  }
  else
    write("Du durchsuchst das Schilf, findest aber nichts.\n");
  return 1;
}

void reset()
{
  ::reset();
  ente = 1;
}
    
