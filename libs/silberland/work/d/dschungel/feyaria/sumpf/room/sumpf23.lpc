#include "../def.h"
inherit ROOM "std_sumpf";

void create()
{
  ::create();
  
  AddExit( "westen", "./sumpf22" );
  add_random_exits();
  AddExit ("norden" ,"./turm");
  SetProp(P_HIDE_EXITS, ({"norden"}) );

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+
      "Im Norden steht ein verfallener Turm.");

  AddDetail( "turm",
      "Der Turm steht im Norden. Du musst schon naeher herangehen um ihn "
      "genauer untersuchen zu koennen.");
}

