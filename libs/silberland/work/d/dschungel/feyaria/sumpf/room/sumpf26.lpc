#include "../def.h"
inherit ROOM "std_sumpf";

int tier = 1;

void create()
{
  ::create();
  
  AddExit ("nordwesten" ,"./sumpf20");
  AddExit ("nordosten", "./sumpf22");
  add_random_exits();

  AddDetail( ({"erde"}),
      GetDetail("erde")[0..<2] + " Du entdeckst ein kleines Loch.");
  AddDetail( ({"loch"}),
      "Was da wohl drinnen ist? Das wirst Du wohl nur herausfinden, "
      "wenn Du hineingreifst.");

  AddCmd( ({"greif", "greife"}), "cmd_greifen");
}

int cmd_greifen(string str)
{
  object ob;
  notify_fail("Wo wie was greifen?\n");
  if( str!= "loch" && str!="in loch" && str!="in loch hinein")
    return 0;
  if( tier )
  {
    write("Du greist in das Loch und findest etwas.\n");
    say(TPN+" greift in ein Loch.\n");
    ob = clone_object("/d/huegelland/orw/pfeifenladen/npc/zufallstier");
    ob->move(this_object(), M_GO);
    ob->SetProp(P_MNPC_AREA, ROOM);
    ob->SetProp(P_MNPC_DEFAULTROOM, ROOM "sumpf13" );
    tier = 0;
  }
  else
    write("Du greifst in das Loch, aber es ist leer.\n");
  return 1;
}

void reset()
{
  ::reset();
  tier = 1;
}
  
