#include "../def.h"
inherit ROOM "std_sumpf";

void create()
{
  ::create();
  
  AddExit( "norden", "./sumpf2" );
  AddExit ("suedosten" ,"./sumpf9");
  AddExit ("suedwesten", "./sumpf7");
  add_random_exits();

  AddDetail( ({"lachen", "gesicht"}),
      "In einer der Wasserlachen siehst Du Dein verzerrtes Gesicht, einfach "
      "zum Lachen!");
  AddDetail( ({"wortspiel"}),
      "Die Lachen sind zum Lachen!");

  AddCmd( ({"lache", "lach"}), "cmd_lachen");
}

int cmd_lachen(string str)
{
  write("Du lachst ueber dieses Wortspiel.\n");
  say(TP->Name()+" lacht.\n");
  return 1;
}
