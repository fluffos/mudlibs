#include "../def.h"
inherit ROOM "std_sumpf";

int nest;

void create()
{
  ::create();
  
  AddExit ("suedwesten" ,"./sumpf26");
  AddExit ("osten", "./sumpf23");
  add_random_exits();

  AddDetail( ({"sumpfgras"}), GetDetail("sumpfgras")[0..<2]+
      " Mitten im Sumpfgras entdeckst Du ein kleines Nest.");
  AddSpecialDetail( ({"nest"}), "det_nest");
  nest = 1;
}

void reset()
{
  ::reset();
  nest = 1;
}

string det_nest()
{
  if( nest )
  {
    nest = 0;
    if( random(2) )
    {
      TP->heal_self(30);
      return "Du findest kleine Vogeleier im Nest, die Du sofort aufisst.\n";
    }
    tell_room(TO, 
        "Ein Frogloksammler kommt an.\n"
        "Der Frogloksammler sammelt einige Eier aus einem Nest auf.\n"
        "Der Frogloksammler sucht sich woanders etwas zum Sammeln.\n");
    return "Nun ist das Nest leer:(\n";
  }
  return "Das Nest ist leer.\n";
}

