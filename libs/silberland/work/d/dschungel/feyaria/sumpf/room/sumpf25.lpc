#include "../def.h"
inherit ROOM "std_sumpf";

void create()
{
  ::create();
  
  AddExit( "westen", "./sumpf24" );
  AddExit ("norden" ,"./sumpf19");
  add_random_exits();

  AddDetail( ({"erde"}),
      GetDetail("erde")[0..<2]+ " Du findest Spuren in der Erde.");
  AddDetail( ({"spuren"}),
      "Froschspuren, aber fast so gross wie menschliche!");
  AddDetail( ({"froschspuren"}),
      "Sie muessen von Froeschen oder froschaehnlichen Lebewesen stammen, "
      "die hier im Sumpf leben.");
  AddDetail( ({"lebewesen", "art" }),
      "Fuer welche Art von Lebewesen interessierst Du Dich?");
  AddDetail( ({"froesche","froschaehnliche lebewesen"}),
      "Es werden wohl Frogloks sein.");

}


