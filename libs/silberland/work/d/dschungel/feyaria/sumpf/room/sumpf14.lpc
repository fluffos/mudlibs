#include "../def.h"
inherit ROOM "std_sumpf";

void create()
{
  ::create();
  
  AddExit( "westen", "./sumpf13" );
  AddExit ("norden" ,"./sumpf8");
  AddExit ("nordosten", "./sumpf9");
  AddExit ("suedwesten", "./sumpf18");
  add_random_exits();

  AddDetail( ({"see"}),
      "Das hier ist beinahe wirklich ein See, fast gross genug, um darin "
      "schwimmen zu koennen.");

  AddCmd( ({"schwimm", "schwimme"}), "cmd_schwimme");

}

int cmd_schwimme(string str)
{
  notify_fail("Wo willst Du schwimmen?\n");
  if(str !="see" && str !="in see") 
    return 0;

  write(BS("Du steigst in den See und schwimmst eine Runde. "
      "Fuer laengeres Schwimmen ist der See aber zu klein, deshalb steigst "
      "Du wieder aus dem Wasser."));
  say(TP->Name()+" schwimmt eine Runde im See.\n");

  return 1;
}

