#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem alten verfallenem Turm" );
  SetProp(P_INT_LONG, 
    "Du stehst vor einem alten, verfallenem Turm. Wer haette gedacht, dass "
    "Du in diesem Sumpf ein solches Gebaeude findest. Die alten Mauern "
    "sind ueber und ueber mit verschiedenen Pflanzen bewachsen, nur durch "
    "seine Hoehe kann man den Turm noch erkennen.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_SWAMP]) );

  AddDetail( "sonne",
      "Die Sonne ist hinter dem Turm.");
  AddDetail( "turm", 
      "Der Turm ist alt und verfallen und so mit Pflanzen ueberwachsen, "
      "dass man ihn nur durch seine Hoehe erst erkennen kann. Du fragst "
      "Dich, wer der Erbauer dieses Turmes sein koennte.");
  AddDetail( ({"erbauer", "zeit"}),
      "Wer immer auch die Erbauer dieses Turmes waren, sie sind sicher "
      "schon lange Zeit nicht mehr da.");
  AddDetail( "sumpf", 
      "Der Sumpf schaut hier aus wie ueberall sonst, nur dass hier ein "
      "alter, verfallener Turm steht.");
  AddDetail( "gebaeude",
      "Du wunderst Dich, warum ein so grosses Gebaeude nicht schon laengst "
      "im Sumpf versunken ist.");
  AddDetail( ({"mauern", "mauer"}),
      "Die Mauern sind alt und verfallen. Du kannst aber trotzdem erkennen, "
      "dass die Mauer aus Granitbloecken gefertigt ist.");
  AddDetail( ({"granitbloecke", "bloecke"}),
      "Die Mauern des Turmes sind aus Granitbloecken gefertigt.");
  AddDetail( ({"granit", "stein"}),
      "Granit ist ein sehr harter Stein.");
  AddDetail( ({"granitblock", "block"}),
      "Alle Bloecke sind gleich verwittert, keiner faellt Dir besonders auf.");
  AddDetail( ({"hoehe"}),
      "Die Hoehe des Turmes verwirrt Dich etwas, solch ein hohes Gebaeude "
      "haettest Du eigentlich schon von weiter Ferne her sehen sollen.");
  AddDetail( ({"ferne"}),
      "Du kannst die Ferne von hier auch nicht sehen, darum konntest Du "
      "wohl den Turm auch nicht aus der Ferne sehen.");
  AddDetail( ({"pflanze", "pflanzen"}),
      "Die Pflanzen ueberwuchern den ganzen Turm und verdecken die Mauern "
      "fast komplett.");
  AddDetail( "boden", 
      "Der Boden ist hier ziemlich sumpfig.");
  AddDetail( "himmel",
      "Der Himmel ist ueber Dir, der ist sogar noch weiter weg als die Spitze "
      "des Turmes.");
  AddDetail( ({"spitze", "turmspitze"}),
      "Die Turmspitze ist sehr weit ober Dir, aber eigentlich muesste sie "
      "Turmstumpfe heissen, weil sie durch die Verwitterung schon mehr "
      "stumpf als spitz ist.");
  AddDetail( "verwitterung",
      "Im Sumpf verwittert alles sehr schnell.");
  AddDetail( "turmstumpfe",
      " :-)");
      
  AddCmd( ({"schiebe", "schieb"}), "schieben");    
  AddExit( "sueden", "./sumpf23");
}

int schieben(string str)
{
  notify_fail("Was willst Du beiseiteschieben?\n");
  if( str=="pflanzen beiseite" )
  {
    write("Du schiebst die Pflanzen beiseite und findest einen Knopf!\n"
          "Aus einfacher Neugier drueckst Du den Knopf.\n\n"
          "Die Welt vor Dir beginnt zu verschwinden und ploetzlich bist Du "
          "ganz wo anders!\n\n");
    TP->move(ROOM "hoehle", M_TPORT);
    return 1;
  }
  return 0;
}

