#include "../def.h"
inherit ROOM "std_sumpf";

int leiche;

void create()
{
  ::create();
  
  AddExit( "westen", "./sumpf17" );
  AddExit ("sueden" ,"./sumpf21");
  AddExit ("nordosten", "./sumpf14");
  add_random_exits();

  AddSmell( ({DEFAULT_SMELL,"sumpf"}),
      "Die typischen Sumpfgerueche werden hier von einem starken "
      "Faeulnisgeruch ueberlagert");
  AddSmell( ({"faeulnisgeruch", "geruch"}),
      "Du riechst genauer und entdeckst eine Wasserleiche im Wasser.");
  AddSpecialDetail( ({"wasserleiche"}), "det_wasserleiche");

  leiche = 1;
}

string det_wasserleiche()
{
  if( leiche && !present("wasserleiche") )
  {
    call_out("clone_leiche",0);
    leiche = 0;
    return "Oh Graus! Die Wasserleiche wird ploetzlich lebendig!\n";
  }
  return "Eine verfaulende Wasserleiche schwimmt hier im Wasser.\n";
}

void reset()
{
  ::reset();
  if( !present("wasserleiche") )
    leiche = 1;
}
 
void clone_leiche()
{
  object ob;

  ob = clone_object("/gilden/nekromanten/npc/wasserleiche");
  ob->SetZombie(15 + random(15), 0, 10000);
  ob->move(TO, M_GO);
}

