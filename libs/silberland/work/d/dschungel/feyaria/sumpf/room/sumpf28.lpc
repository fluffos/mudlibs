#include "../def.h"
inherit ROOM "std_sumpf";

int eingang();

void create()
{
  ::create();
  
  AddExit( "westen", "./sumpf27" );
  AddExit ("nordosten", "./sumpf24");
  add_random_exits();

  AddExit( "sueden", ([EX_FUNC: #'eingang, EX_DEST: "./sumpf28"]) );
  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] + 
      "Im Sueden siehst Du einen niedrigen Eingang.");

  AddDetail( ({"eingang"}),
      "Der Eingang im Sueden ist relativ niedrig, aber gerade richtig fuer "
      "die Frogloks. Er fuehrt wohl nach Guk, der Stadt der Frogloks, "
      "scheint aber momentan nicht benutzbar zu sein.");
  AddDetail( ({"stadt", "froglokstadt", "guk"}),
      "Du hast schon mal gehoert, dass es hier im Sumpf eine Froglokstadt "
      "geben soll. Nun stehst Du tatsaechlich davor, zu schade, dass der "
      "Eingang nicht benutzbar ist.");
}

int eingang()
{
  write("Der Eingang zur Stadt der Frogloks ist momentan leider nicht "
      "benutzbar.\n");
  return 1;
}
