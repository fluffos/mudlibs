#include "../def.h"
inherit ROOM "std_sumpf";

void create()
{
  ::create();
  
  AddExit ("norden" ,"./sumpf18");
  AddExit ("suedosten", "./sumpf27");
  add_random_exits();

  AddSound( ({"geraeusche"}),
      GetSound("geraeusche")[0..<2]+
      " Wirklich auffallend aber ist das Piepsen.");
  AddSound( ({"piepsen"}),
      "Das Piepsen kommt von einem kleinen Vogelnest, das Du erst jetzt "
      "bemerkst.");
  AddDetail( ({"vogelnest"}),
      "Du beschliesst, das kleine Vogelnest nicht naeher zu untersuchen, "
      "um die kleinen Vogelkueken nicht zu stoeren.");
  AddDetail( ({"vogelkueken", "kueken"}),
      "Jetzt hast Du die kleinen Kueken doch noch gestoert! *PIEPS*PIEPS*");
}

