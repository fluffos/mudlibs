#include "../def.h"
inherit ROOM "std_sumpf";

int laeufer;

void create()
{
  ::create();
  
  AddExit( "nordwesten", "./sumpf4" );
  AddExit ("suedwesten" ,"./sumpf14");
  AddExit ("norden", "./sumpf5");
  add_random_exits();

  AddDetail( ({"wasserflaeche"}),
      GetDetail("wasserflaeche") + "Ein kleines Insekt laeuft auf dieser "
      "Wasserflaeche herum.");
  AddDetail( ({"insekt"}),
      "Dabei kann es sich nur um einen Wasserlaeufer handeln.\n");
  AddDetail( ({"wasserlaeufer"}),
      "Er laeuft auf der Wasseroberflaeche herum.");
  AddSpecialDetail( ({"wasseroberflaeche", "oberflaeche"}), "det_oberflaeche" );

  laeufer = 1;
}

string det_oberflaeche()
{
  if( laeufer )
  {
    CLONEME("/d/dschungel/feyaria/dorf/npc/wlaeufer");
    laeufer = 0;
    return "Du scheuchst den Wasserlaeufer auf.\n";
  }
  return "Die Wasseroberflaeche ist leer. (bis auf das Wasser.....)\n";
}

void reset()
{
  ::reset();
  laeufer = 1;
}
