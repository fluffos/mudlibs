#include "../def.h"
inherit ROOM "std_sumpf";

void create()
{
  ::create();
  
  AddExit ("sueden" ,"./sumpf3");
  AddExit ("osten", "./sumpf2");
  add_random_exits();
  AddExit( "nordwesten", SUMPF_OSTKUESTE );
  SetProp(P_HIDE_EXITS, ({"nordwesten"}) );

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2]+
      "Den Kuestenweg kannst Du von hier nur mehr erahnen, "
      "auch bist Du Dir nicht mehr sicher, in welcher Richtung er zu finden "
      "ist.");

  AddDetail( ({"richtung", "orientierung"}),
      "Du bist Dir ueber die Richtungen nicht mehr ganz sicher, Du hast die "
      "Orientierung verloren.");
  AddDetail( ({"kuestenweg", "naehe"}),
      "Der Kuestenweg ist hier irgendwo in der Naehe.");
}

