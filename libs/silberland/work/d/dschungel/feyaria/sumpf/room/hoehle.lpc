#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle" );
  SetProp(P_INT_LONG, 
    "Du stehst in einer grossen Hoehle, die sich scheinbar unter dem Turm "
    "befindet. Alle Anzeichen deuten darauf, dass es hier Bewohner gibt, "
    "und zwar von einer Sorte, die Dir Angst macht: Drachen!");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );

  AddDetail( "turm", 
      "Der Turm ist irgendwo ueber Dir.");
  AddDetail( "sumpf", 
      "Hier unten kommt Dir der Sumpf ganz weit weg vor.");
  AddDetail( ({"hoehle"}),
      "Die Hoehle ist riesengross. Genau gross genug fuer Drachen.");
  AddDetail( ({"anzeichen"}),
      "Die Anzeichen sind unuebersehbar. Hier wohnen Drachen!");
  AddDetail( ({"bewohner"}),
      "Drachen!");
  AddDetail( ({"drachen"}),
      "Unglaublich, aber wahr: hier wohnen Drachen!");
  AddDetail( ({"sorte"}),
      "Drachensorte!");
  AddDetail( ({"drachensorte"}),
      "Eine gefaehrliche Sorte.");
  AddDetail( ({"angst"}),
      "Die Drachen floessen Dir Angst ein.");
  AddDetail( ({"boden"}),
      "Auf dem Boden siehst Du Spuren von Drachen.");
  AddDetail( ({"waende", "wand"}),
      "An den Waenden siehst Du Kratzspuren von Drachen.");
  AddDetail( ({"decke"}),
      "An der Decke siehst Du Spuren vom Feueratem der Drachen.");
  AddDetail( ({"spuren", "spur", "kratzspuren", "kratzspur"}),
      "Eindeutig die Spur eines Drachen.");
  AddDetail( ({"feueratem"}),
      "Nur das Feuer eines Drachen konnte die Steine der Decke derartig "
      "einschmelzen.");
  AddDetail( ({"steine", "stein", "gestein"}),
      "Der Stein der Decke ist durch Feueratem eingeschmolzen.");
  AddDetail( ({"feuer"}),
      "Das Feuer von Drachen ist sehr heiss, heiss genug, um das Gestein "
      "der Decke einzuschmelzen.");
  AddSmell( ({DEFAULT_SMELL, "drachen"}),
      "Es riecht nach Drachen.");

  AddItem( NPC "sumpfdrache", REFRESH_DESTRUCT);
  AddItem( NPC "sumpfdrachi", REFRESH_DESTRUCT);

  AddExit( "raus", "./turm");
}

void reset()
{
  ::reset();
  set_next_reset((1+random(2))*60*60);
}
