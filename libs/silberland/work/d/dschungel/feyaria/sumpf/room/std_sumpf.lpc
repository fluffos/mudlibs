#include "../def.h"
inherit "std/room";

void create()
{
  string *npcs;

  ::create();

  SetProp(P_INT_SHORT, "Im Sumpf");
  SetProp(P_INT_LONG, 
      "Du bist mitten im Sumpf gelandet, der sich scheinbar endlos in "
      "alle Richtungen ausbreitet. Der Boden ist eine truegerische Mischung "
      "aus mit Sumpfgras bewachsener Erde und kleinen Wasserlachen, ab und zu "
      "gibt es sogar grosse Wasserflaechen. Dort waechst dann Schilf statt "
      "Gras. Aber es gibt genug festes Land, dass man ohne grosse Gefahren "
      "einen Weg durch den Sumpf finden kann. "
      "Die schwuele Luft treibt Dir den Schweiss aus den Poren. ");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_SWAMP]) );

  AddDetail( ({"boden"}),
      "Der Boden ist eine truegerische Mischung aus Erde und Wasser.");
  AddDetail( ({"himmel"}),
      "Vom Himmel brennt die Sonne erbarmungslos herunter.");
  AddDetail( ({"sonne"}),
      "Die Sonne erwaermt nicht nur die Luft, sondern laesst auch jede Menge "
      "Wasser verdunsten, dadurch ist es nicht nur sehr heiss sondern auch "
      "sehr feucht.");
  AddDetail( ({"luft"}),
      "Die Luft ist sehr schwuel. Es treibt Dir richtig den Schweiss aus den "
      "Poren.");
  AddDetail( ({"schweiss"}),
      "Du schwitzt ziemlich stark.");
  AddDetail( ({"poren", "pore"}),
      "Aus jeder Deiner Poren rinnt Schweiss.");
  AddDetail( ({"sumpf"}),
      "Der Sumpf ist eine Mischung aus Erde und Wasser.");
  AddDetail( ({"richtung", "richtungen"}),
      "In jeder Richtung nur Sumpf. Alles schaut mehr oder weniger gleich "
      "aus.");
  AddDetail( ({"erde"}),
      "Die Erde ist sehr matschig und feucht hier, aber stabil genug, "
      "dass man darauf gehen kann.");
  AddDetail( ({"wasser"}),
      "Das Wasser ist sehr dreckig hier, man kann nicht unter die "
      "Wasseroberflaeche sehen.");
  AddDetail( ({"wasseroberflaeche"}),
      "Was unter der Wasseroberflaeche lauert, wird wohl immer geheim bleiben.");
  AddDetail( ({"mischung"}),
      "Erde und Wasser gemischt ergibt Sumpf.");
  AddDetail( ({"sumpfgras"}),
      "Es waechst Sumpfgras hier. Es liebt den feuchten Boden und gedeiht "
      "praechtig hier.");
  AddDetail( ({"gras"}),
      "Es ist eindeutig Sumpfgras.");
  AddDetail( ({"tuempel"}),
      "Viele kleine Tuempel wechseln sich mit festem Boden ab. An vielen "
      "Tuempeln waechst Schilf.");
  AddDetail( ({"wasserflaeche", "wasserflaechen"}),
      "Es gibt viele Wasserflaechen hier, von kleinen Lachen bis zu grossen "
      "Tuempeln. Aber keine ist so gross, dass man von einem See sprechen "
      "koennte.");
  AddDetail( ({"lachen"}),
      "Kleine Wasserlachen.");
  AddDetail( ({"wasserlachen"}),
      "Lachen, mit Wasser gefuellt.");
  AddDetail( ({"land"}),
      "Es gibt genug festes Land um hier herumzugehen ohne gleich schwimmen zu "
      "muessen. Es ist ja auch ein Sumpf und kein See.");
  AddDetail( ({"gefahren"}),
      "Es gibt viele Gefahren hier, im Sumpf stecken zu bleiben ist aber wohl "
      "die geringste Gefahr.");
  AddDetail( ({"see"}),
      "See kann man die Wasserflaechen eigentlich nicht nennen, es sind eher Tuempel.");
  AddDetail( ({"gefahr"}),
      "Die gefaehrlichen Bewohner des Sumpfes sind sicher eine Gefahr.");
  AddDetail( ({"bewohner"}),
      "Im Sumpf gibt es viele gefaehrliche Tiere, aber auch noch "
      "gefaehrlichere Wesen.");
  AddDetail( ({"tiere", "tier"}),
      "Moskitos, Schlangen, Echsen, Froesche, Krokodile usw....");
  AddDetail( ({"moskito", "schlange", "frosch", "krokodil"}),
      "So ein Tier ist gerade nicht da.");
  AddDetail( ({"moskitos", "schlangen", "krokodile"}),
      "Gefaehrliche Tiere.");
  AddDetail( ({"froesche"}),
      "Neben normalen Froeschen gibt es hier auch noch Frogloks.");
  AddDetail( ({"wesen"}),
      "Wesen wie das toedliche Sumpfmonster oder den legendaeren "
      "Sumpfdrachen.");
  AddDetail( ({"sumpfmonster"}),
      "Das Sumpfmonster soll toedlich sein. Noch keiner, der es gesehen hat, "
      "kam lebend zurueck.");
  AddDetail( ({"sumpfdrache", "sumpfdrachen"}),
      "Dabei handelt es sich wohl um einen Drachen, der hier im Sumpf haust.");
  AddDetail( ({"drache", "drachen"}),
      "Ein Drache ist eine riesige, magische Echse.");
  AddDetail( ({"echse", "echsen"}),
      "Echsen gibt es viele hier: Schlangen, Krokodile und vielleicht sogar "
      "einen Drachen.");
  AddDetail( ({"schilf"}),
      "Im tieferen Wasser waechst meist Schilf.");
  AddDetail( ({"menge"}),
      "Viel eben.");
  AddDetail( ({"weg"}),
      "Der Weg durch den Sumpf ist truegerisch, man kann sich nur all zu "
      "leicht verirren.");
  AddDetail( ({"froglok", "frogloks", "froschmenschen"}),
      "Die Frogloks sind ca. 1 Meter grosse Froschmenschen, die in diesem "
      "Sumpf ihre Heimat haben.");
  AddSpecialDetail( ({"meter"}), "det_meter");
  AddDetail( ({"heimat"}),
      "Die Heimat der Frogloks ist die Stadt Guk.");
  AddDetail( ({"guk", "stadt"}),
      "Guk, die Stadt der Frogloks, soll irgendwo hier im Sumpf sein.");
  
  AddSound( ({DEFAULT_SOUND, "sumpf"}),
      "Von allen Seiten dringen die Geraeusche des Sumpfes an Deine Ohren.");
  AddSound( ({"seite", "seiten", "gleiche"}),
      "Egal auf welche Seite Du lauscht, Du hoerst das Gleiche.");
  AddSound( ({"geraeusche"}),
      "Du hoerst das Quaken von Froeschen, das Blubbern und Plaetschern des "
      "Wassers und das Kreischen von Voegeln.");
  AddSound( ({"quaken", "quak", "frosch", "froesche"}),
      "*QUAK*");
  AddSound( ({"wasser", "blubbern", "blubber"}),
      "*BLUBBER*");
  AddSound( ({"plaetschern", "plaetscher"}),
      "*PLAETSCHER*");
  AddSound( ({"kreischen", "voegel", "vogel", "kreisch"}),
      "*KREISCH*");

  AddSmell( ({DEFAULT_SMELL,"sumpf"}),
      "Du kannst die typischen Sumpfgerueche riechen.");
  AddSmell( ({"sumpfgerueche", "gerueche"}),
      "Du riechts abgestandenes Wasser, verrottetes Schilf, feuchte Erde "
      "und nasses Leder.");
  AddSmell( ({"wasser"}),
      "Es riecht abgestanden.");
  AddSmell( ({"schilf"}),
      "Es riecht verrottet.");
  AddSmell( ({"erde"}),
      "Sie riecht feucht.");
  AddSmell( ({"leder"}),
      "Es riecht nass. Scheinbar stehst Du mit Deinen Schuhen schon zu "
      "lange im Sumpf.");

  npcs= ({ "/d/dschungel/dante/weg/npc/dmoskito", 
           "/d/dschungel/dante/weg/npc/rmoskito", 
           "/d/dschungel/dante/weg/npc/dstechmuecke", 
           "/d/huegelland/feyaria/wald/npc/schlange", 
           "/d/huegelland/feyaria/wald/npc/frosch",
           "/d/huegelland/feyaria/weg/npc/reiher",
           "/d/dschungel/feyaria/dorf/npc/wasserschlange",
           NPC "sumpfratte",
           NPC "echse",
           NPC "jaeger",
           NPC "sammler",
           NPC "spaeher",
           NPC "kaulquappe" });

  if( !random(2) )
    AddItem( npcs, REFRESH_DESTRUCT, 
        ([P_MNPC_AREA: ROOM, 
          P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_FLAGS:MOV_MOVES+MOV_OUTDOORS  ]));

  if( !random(4) )
    AddItem( npcs+({"/d/dschungel/feyaria/dorf/npc/krokodil"}),
        REFRESH_DESTRUCT, 
        ([P_MNPC_AREA: ROOM, 
          P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_FLAGS:MOV_MOVES+MOV_OUTDOORS  ]));

  if( !random(10) )
    AddItem( npcs + ({"/d/dschungel/feyaria/dorf/npc/krokodil",
                      NPC "sumpfmonster", 
                      NPC "jaegermeister", 
                      NPC "sammelmeister"}) , 
        REFRESH_DESTRUCT, 
        ([P_MNPC_AREA: ROOM, 
          P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_FLAGS:MOV_MOVES+MOV_OUTDOORS  ]));
}
