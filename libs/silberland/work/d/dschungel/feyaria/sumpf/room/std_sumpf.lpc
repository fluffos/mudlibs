void add_random_exits()
{
  string *rooms, *alldirs, *dirs;
  string room, dir;
  int i;

  alldirs=({"norden", "nordosten", "osten", "suedosten", "sueden",
      "suedwesten", "westen", "nordwesten"});
  dirs=alldirs-m_indices(QueryProp(P_EXITS));
  rooms=m_values(QueryProp(P_EXITS)) + ({file_name(this_object())});
  for(i=0;i<random(sizeof(dirs));i++)
  {
    if( sizeof(dirs) && sizeof(rooms) )
    {
      dir=dirs[random(sizeof(dirs))];
      dirs-=({dir});
      room=rooms[random(sizeof(rooms))];
      rooms-=({room});
      AddExit( dir, room );
    }
  }
}

void init()
{
  int i;
  mapping exits;
  string * ex;
  string room;
  ::init();
  exits=QueryProp(P_NEW_EXITS);
  ex=m_indices(exits);
  for(i=sizeof(ex)-1; i>=0; i--)
  {
    room=exits[ex[i]]["ex_dest"];
    if (!find_object(room) )
      call_other(room, "???");
  }
}

string det_meter()
{
  return "Frogloks sind ca 1 Meter gross, und Du ca "+
    sprintf("%1.1f",to_float(TP->QueryProp(P_SIZE)) / 100.0) + " Meter.\n";
}
