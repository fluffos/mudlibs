#include "../def.h"
inherit ROOM "std_sumpf";

int kroko;

void create()
{
  ::create();
  
  AddExit( "westen", "./sumpf11" );
  add_random_exits();

  AddDetail( ({"wasseroberflaeche"}),
      "Ploetzlich siehst Du zwei Augen auf der Wasseroberflaeche, die "
      "Dich beobachten.");
  AddSpecialDetail( ({"augen"}), "det_augen");

  kroko = !random(10);
}

void reset()
{
  ::reset();
  if( !present("krokodil") )
    kroko = !random(10);
}

string det_augen()
{
  if( kroko )
  {
    kroko = 0;
    call_out("clone_kroko",0);
    return "Die Augen gehoeren zu einem Krokodil, das jetzt hungrig aus dem "
      "Wasser kommt.\n";
  }
  return BS("Die Augen gehoeren wohl einem Krokodil, hoffentlich kommt es "
      "nicht aus dem Wasser heraus!");
}

void clone_kroko()
{
  CLONEME("/d/dschungel/feyaria/dorf/npc/krokodil");
}

