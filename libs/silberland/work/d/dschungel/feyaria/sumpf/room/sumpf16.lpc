#include "../def.h"
inherit ROOM "std_sumpf";

int schlange;

void create()
{
  ::create();
  
  AddExit( "nordwesten", "./sumpf10" );
  add_random_exits();

  AddSpecialDetail( ({"schlange"}), "det_schlange");
  schlange = 1;
}

string det_schlange()
{
  if( schlange && !present("schlange") )
  {
    schlange = 0;
    call_out("clone_schlange", 0);
    return "Jetzt hast Du tatsaechlich eine Schlange gefunden!\n";
  }
  return "So ein Tier ist gerade nicht da.\n";
}

void clone_schlange()
{
  object ob;

  ob = clone_object("/d/huegelland/feyaria/wald/npc/schlange");
  ob->SetProp(P_MNPC_AREA, ({ ROOM }));
  ob->SetProp(P_MNPC_DEFAULTROOM, ({ file_name(TO) }));
  ob->move(TO, M_GO);
  if( random(2) && TP && present(TP))
    ob->Kill(TP);
}

void reset()
{
  ::reset();
  if( !present("schlange") )
    schlange = 1;
}
