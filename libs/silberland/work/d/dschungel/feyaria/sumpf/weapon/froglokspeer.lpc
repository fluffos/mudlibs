#include "../def.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Froglokspeer");
  SetProp(P_LONG, 
    "Ein kurzer Speer mit einer gruen schimmernden Klinge.");
  SetProp(P_NAME, "Froglokspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"froglokspeer", "speer" }) );  

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 45);
  SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
  SetProp(P_QUALITY_DECAY, 180);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1700);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:28]) );
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_MISC_POISON:10]) ); 
  call_other("/p/daemon/itemd/functions/hitfuncspeed", "???");
  SetProp(P_HIT_FUNC, find_object("/p/daemon/itemd/functions/hitfuncspeed"));  
  SetProp(P_WC_BONUS, (["jaegermeister":200]) );
}


