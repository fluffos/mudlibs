// /d/huegelland/feyaria/wald/npc/hoernchen.c
// Ein Hoernchen
// 2001-04-08 Feyaria@SilberLand

#include "../def.h"
inherit "std/mnpc";

void rand_farb()
{
  switch( random(6))
  {
    case 0: 
      SetProp (P_NAME_ADJ, "gruen"); 
      AddAdjective( ({"gruene" ,"gruener", "gruene"}) );
      break;
    case 1: 
      SetProp (P_NAME_ADJ, "braun"); 
      AddAdjective( ({"braune", "brauner", "braun"}) );
      break;
    case 2: 
      SetProp (P_NAME_ADJ, "giftgruen"); 
      AddAdjective( ({"giftgruene", "giftgruener", "giftgruen"}) );
      break;
  }
}

void rand_muster()
{
  switch( random(6))
  {
    case 0: 
      SetProp (P_NAME_ADJ, "gestreift"); 
      AddAdjective( ({"gestreifte", "gesteifter", "gestreift"}) );
      break;
    case 1: 
      SetProp (P_NAME_ADJ, "gefleckt"); 
      AddAdjective( ({"gefleckte", "geflecketer", "gefleckt"}) );
      break;
    case 2: 
      SetProp (P_NAME_ADJ, "gepunktet"); 
      AddAdjective( ({"gepunktete", "gepunkteter", "gepunktet"}) );
      break;
  }
}


void create()
{
  string name;
  if (!is_clone(ME)) return;
  ::create();
   
  switch(random(6))
  {
    case 0: name="Wasserechse";  break;
    case 1: name="Schlammechse";  break;      
    case 2: name="Dschungelechse"; break;
    default: name="Sumpfechse";  break;
  }
  if( random(100)%2) rand_muster(); else rand_farb();
  if( !QueryProp(P_NAME_ADJ) )
  {
    switch( random(4))
    {
      case 0: 
        SetProp (P_NAME_ADJ, "klein"); 
        AddAdjective( ({"klein"}) );
        break;
      case 1: 
        SetProp (P_NAME_ADJ, "gross"); 
        AddAdjective( ({"gross"}) );
        break;
    }
  }
  SetProp(P_NAME, name);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, Name(WER,1)+" ist eine kleine Echse, die sich am liebsten "
      "im Sumpf aufhaelt. Sie ist perfekt an ihren Lebensraum angepasst, und "
      "kan sowohl schwimmen als auch sehr schnell auf dem truegerischen "
      "Boden laufen. Ernaehren tut sie sich hauptsaechlich von Insekten, " 
      "die sie mit ihrer langen Zunge faengt.");
  
  AddId( ({"echse", LOWER(name)}));

  create_default_npc (9+random(7));
  SetProp(P_HANDS, ({" mit ihrer langen Zungen", QueryProp(P_HANDS)[1], 
    DT_PIERCE}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_ALIGN, 50+random(200) );
  SetProp(P_DIE_MSG, " versinkt tot im Sumpf.\n");

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "verschwindet im Sumpf");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "beachtet Dich gar nicht.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    Name(WER,1)+" kann das doch gar nicht tragen.\n"}));

  SetChats(2, ({
    Name(WER,1)+" faengt eine Fliege mit ihrer langen Zunge.\n",
    Name(WER,1)+" schwimmt im Wasser herum.\n",
    Name(WER,1)+" laeuft durch Deine Beine hindurch.\n",
    Name(WER,1)+" springt im Sumpfgras umher.\n"}) );

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}
