#include "../def.h"

inherit NPC "std_froglok";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Jaegermeister");
  SetProp(P_SHORT, "Der Jaegermeister der Frogloks");
  SetProp(P_LONG, 
      "Der Jaegermeister ist ein besonders stattlicher Froglok, er ist deutlich "
      "groesser und kraeftiger als alle anderen die Du je gesehen hast. Er "
      "traegt seinen Jagdspeer mit der Sicherheit eines erfahrenen Jaegers. "
      "Er hat eine gruene Haut und ein riesiges Maul, aus "
      "dem ein staendiges Quaken kommt, allerdings scheint er auch die "
      "normale Sprache zu sprechen.");
  AddId( ({"jaegermeister", "Speermeister"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_KILL_NAME, "Der Jaegermeister der Frogloks");
  SetProp(P_SMELL, "Der Jaegermeister riecht nach starkem Alkohol.\n");

  create_default_npc(35);
  SetProp(P_SIZE, QueryProp(P_SIZE)+20);

  SetProp(P_SPELLRATE, 55);
  AddSpell(8, 1000, 
      "Der Jaegermeister rammt Dir seinen Speer in die Eingeweide.\n",
      "Der Jaegermeister rammt @WEM seinen Speer in die Eingeweide.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(8, 700, DS_DEAF,
      "Der Jaegermeister quakt Dich laut an.\n",
      "Der Jaegermeister quakt @WEN laut an.\n");

  AddDefaultSpell(3, 500, DS_MASS_DEAF,
      "Der Jaegermeister quakt schrecklich laut.\n",
      "Der Jaegermeister quakt schrecklich laut.\n");

  AddDefaultSpell(1, 700, DS_FROG,
      "Der Jaegermeister macht Dich zum Frosch!\n",
      "Der Jaegermeister macht @WEN zum Frosch.\n");

  SetChats(3, ({
        "Der Jaegermeister quakt etwas ueber die Jagd.\n",
        "Der Jaegermeister quakt: Ich bin der Jaegermeister.\n",
        "Der Jaegermeister quakt: Ich bin der beste Jaeger!\n",
        "Der Jaegermeister stuetzt sich auf seinen Speer.\n",
        "Der Jaegermeister sucht nach jagbarem Wild.\n",
        "Der Jaegermeister beginnt mit der Jagd.\n",
        "Der Jaegermeister schaerft seinen Speer.\n"}) );

  CLONEME (WEAPON "froglokspeer");
  command("zuecke speer");
  equip(0,1);
  hq();
}

void die(int poisondeath)
{
  write_file(LOG "jaegermeister",
      dtime(time())+": "+CAP(getuid(TP))+" killt den Jaegermeister.\n");
  ::die(poisondeath);
}
