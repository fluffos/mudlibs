#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";

void create()
{
  int i;
  if (!is_clone(this_object())) return;
  if (getuid(previous_object()) != getuid(previous_object()) &&
      !IS_LORD(previous_object())) 
  {
    raise_error("Illegales Clonen!");
    destruct();
    return;
  }
  ::create();

  create_default_dragon(2,9,2,10);
  SetProp(P_SHORT, 
    "Ein gewaltiger Sumpfdrache");
  SetProp(P_LONG, 
    "Vor Dir steht ein gewaltiger Sumpfdrache. Seine Schuppenfarbe kannst Du "
    "nur schwer erkennen, da er ganz mit Algen und Schlamm bedeckt ist. "
    "Mit seinem tellergrossen, smargadenen Augen schaut er Dich mistrauisch "
    "an.");
  SetProp(P_NAME, "Soztrekiuyveremnopuilosxowimm");
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_ARTICLE,0);
  AddId( ({"soztrekiuyveremnopuilosxowimm", "sumpfdrache", "smaragddrache" }) );
  SetProp(P_INFO,
    "Du bist Dir ziemlich sicher, dass es sich hier um einen Smaragddrachen "
    "handelt.");
  set_living_name("sumpfdrache");  
  AddDefaultSpell(1,700, DS_MASS_POISON,
    "Der Sumpfdrache spuckt eine giftgruene Wolke aus.\n",
    "Der Sumpfdrache spuckt eine giftgruene Wolke aus.\n",
    3);

  SUID;
}

void die(int poisondeath)
{
  object ob, pl, *players;
  write_file(LOG "drache", dtime(time())+": "+CAP(TP->query_real_name())+
      " killt den Sumpfdrachendrachen.\n");
//  if (random(10))
    CLONEME( ARMOUR "race_guild_armour");
/*
    else
  { 
    players = filter_array(PresentEnemies(), #'interactive);
    if (sizeof(players))
    {
      pl = players[sizeof(players)];
      ob = clone_object(ARMOUR "rga");
      ob->create2(pl->QueryProp(P_RACE), random(7), pl->QueryProp(P_GUILD));
      ob->move(TO, M_NOCHECK);
      DB(sprintf("*** SUMPFDRACHE: %s\n", ob->name()));
    }
  }
*/ 

  // Fuer Zechprellerquest
  if(QueryProp(P_KILLER))
    ob = present("\nzechpreller_quest_11", QueryProp(P_KILLER));
  if(objectp(ob))
    ob->Mark();

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
    write_file(LOG "drache", dtime(time())+": Der Sumpfdrachedrache hat gerade "+
        CAP(player->query_real_name())+ " umgebracht.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void init()
{
  ::init();
  if ( TP && TP->id("drache")) AddDefender(TP);
}

