#include "../def.h"

inherit NPC "std_froglok";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_NAME, "Frogloksammler");
  SetProp(P_SHORT, "Ein Frogloksammler");
  SetProp(P_LONG, 
      "Der Frogloksammler ist ein ganz gewoenhlicher Froglok, man kann ihn "
      "von den anderen Froschmenschen nur dadurch unterscheiden, dass er "
      "staendig im Sumpf nach Nahrungsmitteln sucht. "
      "Er hat eine gruene Haut und ein riesiges Maul, aus "
      "dem ein staendiges Quaken kommt.");
  AddId( ({"frogloksammler", "sammler"}) );
  SetProp(P_GENDER, MALE);

  create_default_npc(14);

  SetProp(P_SPELLRATE,15);
  AddSpell(1,180,
      "Der Frogloksammler quakt Dich laut an.\n",
      "Der Frogloksammler quakt @WEN laut an.\n",
      DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Frogloksammler sucht nach Nahrungsmitteln.\n",
        "Der Frogloksammler wuehlt im Sumpf herum.\n",
        "Der Frogloksammler zieht eine schmackhafte Wurzel aus dem Sumpf.\n",
        "Der Frogloksammler sammelt Nahrung.\n"}) );

  equip(1,1);
}
