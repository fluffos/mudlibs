inherit "std/mnpc";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  int hand,bein,auge,nase,maul;
 
  if (!is_clone(TO)) return;
  ::create();

  hand=11+random(9);
  bein=6+random(4);
  auge=17+random(10);
  nase=3+random(4);
  maul=10+random(5);

  SetProp(P_SHORT, "Das Sumpfmonster");
  SetProp(P_LONG, 
    "Vor Dir steht eine Kreatur, die man wohl nur mit Sumpfmonster "
    "beschreiben kann. Es besteht quasi aus lebendem Sumpf und sieht aus "
    "wie ein lebender Misthaufen. Es hat "+hand+" Haende, "+bein+" Beine, "+
    auge+" Augen und "+nase+" Nasen. Am schlimmsten sind aber die "+maul+
    " Maeuler, in denen hunderte scharfe Zaehne darauf warten, Dein Fleisch "
    "zu zerfetzen.") ;
  SetProp(P_NAME, "Sumpfmonster");
  SetProp(P_GENDER, NEUTER);
  AddId(({"sumpfmonster", "monster"}));

  AddDetail( ({"haende", "hand"}),
      "Das Sumpfmonster hat genau "+hand+" Haende, genug um Dich zu zerreissen.");
  AddDetail( ({"beine", "bein"}),
      "Das Sumpfmonster hat genau "+bein+" Beine, genug um nie im Sumpf einzusinken.");
  AddDetail( ({"augen", "auge"}),
      "Das Sumpfmonster hat genau "+auge+" Augen, genug um Dich aus jeder Richtung"
      "zu sehen.");
  AddDetail( ({"nasen", "nase"}),
      "Das Sumpfmonster hat genau "+nase+" Nasen, genug um Dich durch Deinen Geruch "
      "zu finden."); 
  AddDetail( ({"maeuler", "maul"}),
      "Das Sumpfmonster hat genau "+maul+" Maeuler, zu viele um sich an Dir satt zu "
      "essen.");
  AddDetail( ({"zaehne"}),
      "Das Sumpfmonster hat hunderte Zaehne in seinen "+maul+" Maeulern. Sicher wird "
      "es Dich auffressen, bevor Du alle genau zaehlen kannst.");

  create_default_npc(5+(hand+bein+auge+nase+maul)/2);
  SetProp(P_HANDS, ({" mit seinen "+hand+" Haenden", hand*25, DT_RIP}));
  SetProp(P_XP, QueryProp(P_XP)+2000*100);
  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, hand);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_WHIP:-0.5, DT_RIP:-0.5, DT_LIGHT:0.3, DT_MAGIC:-0.2, DT_POISON:-1,
        DT_WATER:-0.5, DT_FIRE:-0.2, DT_COLD:0.3, DT_BLUDGEON:-0.2])); 

  SetProp(P_MSGIN, "wabbelt auf "+bein+" Beinen herein");
  SetProp(P_MSGOUT, "wabbelt auf "+bein+" Beinen");
  SetProp(P_MMSGIN, "taucht aus dem Sumpf auf");
  SetProp(P_MMSGOUT, "taucht im Sumpf unter");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 15, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "sumpf25");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

  SetProp(P_DIE_MSG,  " loest sich in seine Einzelbestandteile auf.\n");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "stopft alles in eines seiner "+maul+" Maeuler hinein.\n" }) );
  AddInfo(DEFAULT_INFO, "verseht Dich gar nicht.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE,20);
  AddSpell(1, 100*maul,
    "Das Sumpfmonster beist Dich mit allen "+maul+" Maeulern.\n", 
    "Das Sumpfmonster beist @WEN mit allen "+maul+" Maeulern.\n", 
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_MASS_POISON,
      "Das Sumpfmonster vergiftet Dich.\n",
      "Das Sumpfmonster vergiftet Dich.\n", 2);
      
  SUID;
  if( random(QueryProp(P_LEVEL))>35 )
    CLONEME(ARMOUR "armschienen");

}

void die(int poisondeath)
{
  write_file(LOG "sumpfmonster.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet das Sumpfmonster.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird vom Sumpfmonster getoetet.\n");
}

