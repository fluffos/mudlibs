#include "../def.h"

inherit NPC "std_froglok";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Kaulquappe");
  SetProp(P_SHORT, "Eine Kaulquappe");
  SetProp(P_LONG, 
      "Diese Kaulquappe besteht nur aus einem runden Koerper mit einem "
      "langen Schwanz. Sie schaut Dich treuherzig an und oeffnet dabei "
      "ihren grossen Mund. Aus dieser Kaulquappe wird sicher einmal ein "
      "richtiger Froglok.");
  SetProp(P_MAX_HANDS, 0);
  AddId( ({"kaulquappe"}) );
  SetProp(P_GENDER, FEMALE);
  create_default_npc(7);
  SetProp(P_HANDS, ({" mit Kaul und Quapp", QueryProp(P_HANDS)[1], DT_BLUDGEON}) );

  SetChats(5, ({
        "Die Kaulquappe huepft im Sumpf herum.\n",
        "Die Kaulquappe sprizt Dich mit Sumpfwasser an.\n",
        "Die Kaulquappe spielt im Sumpf.\n",
        "Die Kaulquappe huepft im Sumpf herum.\n",
        "Die Kaulquappe hat Hunger.\n",
        "Die Kaulquappe quappt.\n",
        "Die Kaulquappe kault.\n",
        "Die Kaulquappe quakt.\n"}) );

}
