#include "../def.h"
#include <npcmaster.h>

inherit NPC "std_froglok";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Froglokjaeger");
  SetProp(P_SHORT, "Ein Froglokjaeger");
  SetProp(P_LONG, 
      "Der Froglokjaeger ist ein ganz gewoenhlicher Froglok, man kann ihn "
      "von den anderen Froschmenschen nur durch seinen Jagdspeer "
      "unterscheiden. Er hat eine gruene Haut und ein riesiges Maul, aus "
      "dem ein staendiges Quaken kommt.");
  AddId( ({"froglokjaeger", "jaeger", "Speerkaempfer"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NO_SCORE, 1);
  create_default_npc(20);
  equip(0,1);
  CLONEME ("/p/weapon/spear/jagdspeer");
  command("zuecke speer");

  SetProp(P_MNPC_AREA, "/d/" );
  SetProp(P_MNPC_DEFAULTROOM, "/room/npcasylraum");
}

void init()
{
  ::init();
  call_out("jagen", 0);
}

void jagen()
{
  if(TP && (TP->id("biber") || TP->id("fuchs") ) )
    Kill(TP);
}

void catch_tell(string str)
{
  string s1;
  if (!str)   return;
  if (sscanf(str,"%s faellt tot zu Boden.\n", s1)==1)
     call_out("fressen",0);
}

void fressen()
{
  command("nimm alles aus leiche");
}
