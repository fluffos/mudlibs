// /d/huegelland/feyaria/wald/npc/hoernchen.c
// Ein Hoernchen
// 2001-04-08 Feyaria@SilberLand

#include "../def.h"
inherit "std/mnpc";

void create()
{
  string name;
  if (!is_clone(ME)) return;
  ::create();
   
  SetProp(P_NAME, "Sumpfratte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine Sumpfratte");
  SetProp(P_LONG, 
      "Eine Sumpfratte. Von anderen Ratten unterscheidet sie sich nur "
      "durch die leichte Gruenfarbung ihres Fells und durch die "
      "breiteren Fuesschen, mit denen sie im Sumpf nicht versinken kann.");
  AddId( ({"ratte", "sumpfratte"}) );

  create_default_npc (9+random(7));
  SetProp(P_HANDS, ({" mit ihren Zaehnen", QueryProp(P_HANDS)[1], 
    DT_PIERCE}));
  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_ALIGN, -50-random(200) );
  SetProp(P_DIE_MSG, " versinkt tot im Sumpf.\n");

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "laeuft herein");
  SetProp(P_MMSGOUT, "verschwindet im Sumpf");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 25, 25 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);

  AddInfo(DEFAULT_INFO, "beachtet Dich gar nicht.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    Name(WER,1)+" kann das doch gar nicht tragen.\n"}));

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}
