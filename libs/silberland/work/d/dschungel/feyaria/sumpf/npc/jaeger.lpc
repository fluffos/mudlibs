#include "../def.h"

inherit NPC "std_froglok";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Froglokjaeger");
  SetProp(P_SHORT, "Ein Froglokjaeger");
  SetProp(P_LONG, 
      "Der Froglokjaeger ist ein ganz gewoenhlicher Froglok, man kann ihn "
      "von den anderen Froschmenschen nur durch seinen Jagdspeer "
      "unterscheiden. Er hat eine gruene Haut und ein riesiges Maul, aus "
      "dem ein staendiges Quaken kommt.");
  AddId( ({"froglokjaeger", "jaeger", "Speerkaempfer"}) );
  SetProp(P_GENDER, MALE);

  create_default_npc(20);

  SetProp(P_SPELLRATE,25);
  AddSpell(1,300,
      "Der Froglokjaeger quakt Dich laut an.\n",
      "Der Froglokjaeger quakt @WEN laut an.\n",
      DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Froglokjaeger stuetzt sich auf seinen Speer.\n",
        "Der Froglokjaeger sucht nach jagbarem Wild.\n",
        "Der Froglokjaeger beginnt mit der Jagd.\n",
        "Der Froglokjaeger schaerft seinen Speer.\n"}) );

  CLONEME ("/p/weapon/spear/jagdspeer");
  command("zuecke speer");
  equip(0,1);

}
