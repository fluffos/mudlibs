#include "../def.h"

inherit NPC "std_froglok";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Sammelmeister");
  SetProp(P_SHORT, "Der Sammelmeister der Frogloks");
  SetProp(P_LONG, 
      "Der Sammelmeister ist ein besonders stattlicher Froglok, er ist deutlich "
      "dicker und kraeftiger als alle anderen die Du je gesehen hast. Er "
      "traegt einen wunderschoenen Dolch als Waffe mit sich. "
      "Er hat eine gruene Haut und ein riesiges Maul, aus "
      "dem ein staendiges Quaken kommt, allerdings scheint er auch die "
      "normale Sprache zu sprechen.");
  AddId( ({"sammelmeister", "Dolchmeister"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_KILL_NAME, "Der Sammelmeister der Frogloks");

  create_default_npc(35);

  SetProp(P_SPELLRATE, 55);
  AddSpell(8, 1000, 
      "Der Sammelmeister rammt Dir seinen Dolch in die Eingeweide.\n",
      "Der Sammelmeister rammt @WEM seinen Dolch in die Eingeweide.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(8, 700, DS_DEAF,
      "Der Sammelmeister quakt Dich laut an.\n",
      "Der Sammelmeister quakt @WEN laut an.\n");

  AddDefaultSpell(3, 500, DS_MASS_DEAF,
      "Der Sammelmeister quakt schrecklich laut.\n",
      "Der Sammelmeister quakt schrecklich laut.\n");

  AddDefaultSpell(1, 700, DS_FROG,
      "Der Sammelmeister macht Dich zum Frosch!\n",
      "Der Sammelmeister macht @WEN zum Frosch.\n");

  AddDefaultSpell(1, 400, DS_POISON,
      "Der Sammelmeister steckt Dir einen Giftpilz in den Mund!\n",
      "Der Sammelmeister steckt @WEM einen Giftpilz in den Mund!\n");

  SetChats(3, ({
        "Der Sammelmeister quakt etwas ueber das Sammeln.\n",
        "Der Sammelmeister quakt: Ich bin der Sammelmeister.\n",
        "Der Sammelmeister quakt: Ich bin der beste Sammler!\n",
        "Der Sammelmeister sucht nach Kraeutern.\n",
        "Der Sammelmeister sucht nach Pilzen.\n",
        "Der Sammelmeister sucht nach Wurzeln.\n",
        "Der Sammelmeister sucht nach essbaren Dingen.\n",
        "Der Sammelmeister zeigt Dir seinen Dolch.\n",
        "Der Sammelmeister schaerft seinen Dolch.\n"}) );

  CLONEME ( WEAPON "froglokdolch");
  command("zuecke dolch");
  equip(0,1);
  hq();

}

void die(int poisondeath)
{
  write_file(LOG "sammelmeister",
      dtime(time())+": "+CAP(getuid(TP))+" killt den Sammelmeister.\n");
  ::die(poisondeath);
}
