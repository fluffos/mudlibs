#include "../def.h"

inherit NPC "std_froglok";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Froglokspaeher");
  SetProp(P_SHORT, "Ein Froglokspaeher");
  SetProp(P_LONG, 
      "Der Froglokspaeher ist ein ganz gewoenhlicher Froglok, man kann ihn "
      "von den anderen Froschmenschen nur dadurch unterscheiden, dass er "
      "staendig im Sumpf nach Feinden ausschau haelt. "
      "Er hat eine gruene Haut und ein riesiges Maul, aus "
      "dem ein staendiges Quaken kommt.");
  AddId( ({"froglokspaeher", "spaeher"}) );
  SetProp(P_GENDER, MALE);

  create_default_npc(16);

  SetProp(P_SPELLRATE,15);
  AddSpell(1,200,
      "Der Froglokspaeher quakt Dich laut an.\n",
      "Der Froglokspaeher quakt @WEN laut an.\n",
      DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Froglokspaeher schaut Dich pruefend an.\n",
        "Der Froglokspaeher spaeht in alle Richtungen.\n",
        "Der Froglokspaeher beobachtet aufmerksam die Umgebung.\n",
        "Der Froglokspaeher haelt nach Feinden Auschau.\n"}) );

  equip(1,1);
}
