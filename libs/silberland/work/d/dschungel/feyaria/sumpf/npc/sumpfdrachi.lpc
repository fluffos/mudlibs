// /d/dschungel/feyaria/sumpf/npc/sumpfdrachi.c
// Das Smaragddrachenmaedchen
// 2002-10-03 Feyaria@SilberLand


#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";

void create()
{
  int i;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Smaragddrachenmaedchen");
  create_default_dragon(2,1,2,1);
  SetProp(P_SHORT, 
    "Ein niedliches Smaragddrachenmaedchen");
  SetProp(P_LONG, 
    "Vor Dir steht ein kleines, niedliches Smaragddrachenmaedchen, das wohl "
    "erst vor kurzer Zeit das Stadium eines Babydrachen verlassen hat. "
    "Obwohl es im Vergleich zu anderen Drachen recht klein ist, hat es "
    "doch schon die Faehigkeiten eines erwachsenen Drachen, wenn auch "
    "noch nicht ganz so stark.");
  SetProp(P_NAME_ADJ, "niedlich");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"maedchen", "drachenmaedchen", "smaragddrache", "smaragddrachenmaedchen" }) );
  set_living_name("smaragddrachenmaedchen");  
  AddDefaultSpell(1,100, DS_POISON,
    "Das Smaragddrachenmaedchen spuckt ein giftgruenes Woelkchen auf Dich.\n",
    "Das Smaragddrachenmaedchen spuckt ein giftgruenes Woelkchen auf @WEN.\n",
    1);
  SUID;
}

void die(int poisondeath)
{
  write_file(LOG "drache", dtime(time())+": "+CAP(TP->query_real_name())+
      " killt das Smaragddrachenmaedchen.\n");
  if( !random(4) )
    CLONEME( ARMOUR "race_guild_armour");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
    write_file(LOG "drache", dtime(time())+": Das Smaragddrachenmaedchen hat gerade "+
        CAP(player->query_real_name())+ " umgebracht.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void init()
{
  ::init();
  if ( TP && TP->id("drache")) AddDefender(TP);
}

