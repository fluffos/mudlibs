// /d/dschungel/feyaria/kueste/npc/3kgse.c   
// Die 3-koepfige Gelbschwanzechse
// 14-11-1996  Feyaria@SilberLand


inherit "std/npc";

#include "../def.h"

string write_murder_message();
int koepfe;
string kopf();

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  koepfe=3;
  SetProp(P_SHORT, "Die dreikoepfige Gelbschwanzechse");
  SetProp(P_NAME, "Gelbschwanzechse");
  SetProp(P_NAME_ADJ, "dreikoepfig");
  SetProp(P_GENDER, FEMALE);
  set_living_name("gelbschwanzechse");
  AddId(({"echse", "gelbschwanzechse"}));
  AddSpecialDetail( ({"koepfe", "kopf"}), "kopf");
  AddDetail( ({"schwanz", "gelber schwanz"}), BS(
    "Der gelbe Schwanz ist sehr wertvoll, weil man aus ihm Gold gewinnen "
    "kann. Leider trennt sich diese Echse nur unter hefitgem Widerstand von "
    "ihrem Schwanz."));

  create_default_npc(29);
  SetProp(P_HANDS, ({" mit ihrem mittleren Kopf", 234, DT_BLUDGEON}));
  SetProp(P_XP, QueryProp(P_XP)+1000*100);
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,-10);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([ DT_FIRE:-0.7,     DT_COLD:0.5, DT_ACID:0.2, 
         DT_LIGHTNING:0.2, DT_AIR:-0.3, DT_LIGHT: -0.2, 
         DT_WATER: -0.3, DT_SOUND: -0.2 ])); 
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_MSGIN, "trappelt herein");
  SetProp(P_MSGOUT, "trappelt");
  SetProp(P_MMSGIN, "erscheint aus dem Dickicht");
  SetProp(P_MMSGOUT, "verschwindet im Dickicht");

  SetProp(P_DIE_MSG,  " verliert ihren letzten Kopf und ist nun tot.\n");
  Set(P_MURDER_MSG, #'write_murder_message, F_QUERY_METHOD);
  SetProp(P_KILL_NAME, "Ein Kopf der dreikoepfigen Gelbschwanzechse");
  SetProp(P_KILL_MSG, "Dein Kopf gehoert jetzt mir!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die dreikoepfige Gelbschwanzechse will Deine Sachen nicht tragen.\n"}));

  SetProp(P_SPELLRATE,10);
  AddSpell(1,555,
    "Die dreikoepfige Gelbschwanzechse greift Dich mit ihrem gelben Schwanz "
      "an.\n",
    "Die dreikoepfige Gelbschwanzechse greift @WEN mit ihrem gelben Schwanz "
      "an.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Die dreikoepfige Gelbschwanzechse wackelt mit ihrem Schwanz.\n",
    "Die dreikoepfige Gelbschwanzechse schaut Dich mit sechs Augen an.\n",
    "Die dreikoepfige Gelbschwanzechse beobachtet Dich mit drei Koepfen.\n"
    }) );

  SUID;
  CLONEME( OBJ "schwanz");
  call_out("echse_remove", 60*(15+random(25)) );
}

string long()
{
  string str;
  str= "Die dreikoepfige Gelbschwanzechse hat, wie der Name schon sagt, "
       "drei Koepfe und einen gelben Schwanz. Sie ist fast so gross wie "
       "ein Wolf und sicher viel gefaehrlicher.";
  if( koepfe==2)
    str+= " Ein Kopf haengt tot herunter.";
  if( koepfe==1)
    str+= " Zwei Koepfe haengen tot herunter.";
  SetProp(P_LONG, str); 
  return ::long();
}

string kopf()
{
  string str;
  str= "Die drei Koepfe haben ein Maul voller scharfer Zaehne und schauen "
    "sehr gefaehrlich aus. ";
  if( koepfe==2)
    str+= "Ein Kopf haengt tot herunter.";
  if( koepfe==1)
    str+= "Zwei Koepfe haengen tot herunter.";
  return BS(str);
}

Attack( object enemy)
{
  if( koepfe>=3)
  {
    SetProp(P_HANDS, ({" mit ihrem rechten Kopf", 150+random(70), DT_BLUDGEON}));
    MyAttack(enemy);
  }
  if( koepfe>=2)
  {
    SetProp(P_HANDS, ({" mit ihrem linken Kopf", 150+random(70), DT_BLUDGEON}));
    MyAttack(enemy);
  }
  SetProp(P_HANDS, ({" mit ihrem mittleren Kopf", 234, DT_BLUDGEON}));
  MyAttack(enemy);
}

void MyAttack(object enemy) 
{
  int damage,damage_type;
  object weaponob;
  string damage_msg, damage_msg2, wtype;
  mixed res,spell;
  mapping ainfo;

  weaponob = QueryProp(P_WEAPON);
  spell=0;
  res = QueryProp(P_HANDS);
  damage = random( res[1]+1 );
  damage = (2*damage + 10*QueryAttribute(A_STR))/3;
  damage_type = res[2];
  damage_msg = damage_msg2 = res[0];
  wtype=WT_HANDS;

  ainfo=([SI_ENEMY:enemy,
	  SI_SKILLDAMAGE:damage,
	  SI_SKILLDAMAGE_TYPE:damage_type,
	  P_WEAPON:weaponob,
	  P_WEAPON_TYPE:wtype]);

  if( enemy )
  {
    say( "  "+capitalize(ME->name(WER,2)) + " greift " + enemy->name(WEN,1)
        + damage_msg + " an.\n", enemy );
    tell_object( enemy, "  "+capitalize(ME->name(WER,1)) + " greift Dich"
        + damage_msg2 + " an.\n" );
    enemy->Defend(damage,damage_type,spell,this_object());
  }
}

// Koepfe sterben einzeln.
// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  if( --koepfe!=0 )
  {
    say("Ein Kopf der Gelbschwanzechse faellt blutueberstroemt zu Boden.\n");
    SetProp(P_HP,QueryProp(P_MAX_HP)*koepfe/3);
    Kill(PL);
    return;
  }
  write_file(LOG "gelbschwanz.kills",
    dtime(time())+": "+CAP(getuid(PL))+" toetet die Gelbschwanzechse.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "kills",
    dtime(time())+": "+CAP(getuid(player))+" wird vom der Gelbschwanzechse "
    "getoetet.\n");
}

// Eigene Moerdermeldung
string write_murder_message()
{
  object wer;
  wer = TO->QueryProp(P_KILLER);
  if( wer->QueryProp(P_FROG) )
    return "Frosch "+wer->name(RAW)+" hat meine drei Koepfe abgeschlagen!";
  else
    return wer->name()+" hat meine drei Koepfe abgeschlagen!";
}

void echse_remove()
{
  object schwanz;
  if( InFight() ) {
    call_out("echse_remove", 60 );
    return;
  }
  if( schwanz=present("schwanz") )
      schwanz ->remove(1);
  tell_room(MENV, Name(WER,1)+ " trappelt in den Dschungel zurueck.\n");
  remove();
}

