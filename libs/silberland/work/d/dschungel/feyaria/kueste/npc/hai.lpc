// 1996  Feyaria@SilberLand


inherit "std/npc";

#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gefaehrlicher Katzenhai");
  SetProp(P_LONG, BS(
    "Ein gefaehrlicher Katzenhai.") );
  SetProp(P_NAME, "Katzenhai");
  SetProp(P_GENDER, MALE);
  AddId(({"hai", "katzenhai", "WATERBREATH"}));

  create_default_npc(33);
  SetProp(P_HANDS, ({" mit seinem Gebiss", 330, DT_RIP}));
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_NOATTACK, 1);

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt her");
  SetProp(P_MMSGOUT, "schwimmt weg");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("feyaria",
    "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hai kann Deine Sachen doch gar nicht tragen.\n" }) );

  SUID;
}

