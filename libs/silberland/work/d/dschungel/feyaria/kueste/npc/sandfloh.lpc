// /d/dschungel/feyaria/kueste/npc/sandfloh.c   
// ein Sandfloh
// 1997-01-09  Feyaria@SilberLand


inherit "std/npc";

#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Sandfloh");
  SetProp(P_LONG, BS(
    "Sandfloehe sind winzige Insekten, die im Sand leben und jeden beissen, "
    "der sich in den Sand legt.") );
  SetProp(P_NAME, "Sandfloh");
  SetProp(P_GENDER, MALE);
  AddId(({"sandfloh", "floh"}));

  create_default_npc(1);
  SetProp(P_HANDS, ({" seinem giftigem Biss", 20, DT_POISON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 1);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft");

  SetProp(P_DIE_MSG,  " verschwindet im Sand.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "beisst Dich.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Sandfloh will Dich nur beissen.\n" }) );

  SetChats(1, ({
    "Der Sandfloh versucht, Dich zu beissen.\n",
    "Der Sandfloh beisst Dich.\n"}) );

}
