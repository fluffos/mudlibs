// /d/dschungel/feyaria/kueste/npc/laeufer.c   
// ein Strandlaeufer
// 14-12-1996  Feyaria@SilberLand


inherit "std/mnpc";

#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Strandlaeufer");
  SetProp(P_LONG, BS(
    "Der Strandlaeufer ist ein kleiner Vogel, der am Strand entlang laeuft. "
    "Mit seinem langen Schnabel sucht er nach Insekten im weichen Sand.") );
  SetProp(P_NAME, "Strandlaeufer");
  SetProp(P_GENDER, MALE);
  AddId(({"strandlaeufer", "laeufer"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinem langen Schnabel", 50, DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 333);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 25);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "kommt schnell herbeigelaufen");
  SetProp(P_MMSGOUT, "laeuft ganz schnell weg");

  SetProp (P_MNPC_AREA, ({ ROOM "room_", ROOM "ost_"}) );
  SetProp (P_MNPC_WAIT, ({ 1, 5, 5 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "room_h2");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INFIGHT);

  SetProp(P_DIE_MSG,  " laeuft in den Tod.\n");

  AddInfo(DEFAULT_INFO, "piepst etwas unverstaendliches.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "piepst: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Strandlaeufer kann Deine Sachen gar nicht tragen.\n" }) );

  SetChats(2, ({
    "Der Strandlaeufer pickt einige Insekten vom Boden auf.\n",
    "Der Strandlaeufer faengt sich einen kleinen Kaefer.\n",
    "Der Strandlaeufer flattert mit seinen kurzen Fluegelchen.\n",
    "Der Strandlaeufer scharrt mit seinen Vogelbeinen im Sand herum.\n",
    "Der Strandlaeufer stochert mit seinem Schnabel im Sand herum.\n"}) );

  SetAttackChats(5, ({
    "Der Strandlaeufer flattert wild mit seinen kurzen Fluegelchen.\n",
    "Der Strandlaeufer versucht zu entkommen.\n",
    "Der Strandlaeufer versucht sich zu verstecken.\n"}) );

}

void catch_tell (string str)
{
  string x,y;
  if (sscanf(str, "%s Bruellen %s", x, y)==2)
  {
    tell_room(MENV, "Der Strandlaeufer wird nervoes.\n" );
  }
}

void init()
{
  ::init();
  if( present("jaguar", MENV) )
    call_out("fluechten",0);
}

void fluechten()
{   
  tell_room(MENV, "Der Strandlaeufer fluechtet vor dem Jaguar.\n" );
  Flee();
}
