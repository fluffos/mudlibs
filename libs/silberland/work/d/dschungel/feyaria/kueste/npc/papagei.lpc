// /d/dschungel/feyaria/kueste/npc/papagei.c
// Ein Papagei
// 22-10-1996  Feyaria@SilberLand


inherit "std/mnpc";

#include "../def.h"

create()
{
  int i; 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein bunter Papagei");
  SetProp(P_LONG, BS(
    "Dieser Papagei ist durch sein buntes Gefieder besonders auffaellig."));
  SetProp(P_NAME, "Papagei");
  SetProp(P_NAME_ADJ, "bunt");
  SetProp(P_GENDER, MALE);
  AddId( ({"papagei", "vogel"}) );
  AddAdjective( ({"bunt", "bunter", "bunten"}) );

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinem harten Schnabel", 80, DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 40+random(10));
  SetProp(P_ALIGN, 250);
  SetProp(P_WIMPY, 25);

  SetProp(P_MSGIN, "flattert laut kraechzend herein");
  SetProp(P_MSGOUT, "flattert laut kraechzend");
  SetProp(P_MMSGIN, "flattert laut kraechzend herein");
  SetProp(P_MMSGOUT, "flattert laut kraechzend weit weg");
  SetProp(P_MNPC_AREA, ("/d/dschungel/") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_m5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_DIE_MSG, " flattert in den Tod.\n");
  
  AddInfo(DEFAULT_INFO, "kraechzt etwas unverstaendliches.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "kraechzt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Papagei will Deine Sachen nicht tragen.\n" }) );

  SetChats(5, ({
    "Der bunte Papagei laermt mit seinem Schnabel.\n",
    "Der bunte Papagei kraechzt laut.\n"}) );

  for(i=0;i<random(5)+1;i++)
    CLONEME( OBJ "pfeder" );

}

init()
{
  ::init();
  if( !TP || TP==TO ) return;
  call_out("hallo",0);
}

void hallo()
{
  if( objectp(TP) && objectp(MENV) && present(TP, MENV ) )
    command("emote kraechzt: Hallo "+ TP->name(RAW) +"! Kroah!");
}


void catch_tell (string str)
{
  string x, y;
  int l;
  if (sscanf(str, "%s sagt: %s", x, y)==2)
  {
    if( (l=strlen(y)) >30 ) y = y[0..29];
    else y=y[0..l-2];
    call_out("sagen", 1+random(3), y);
  }
}

void sagen(string str)
{
  command ("emote kraechzt: Krah! .."+ str +".. Krah!");
}
