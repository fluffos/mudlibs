// /d/dschungel/feyaria/kueste/npc/jaguar.c   
// ein Jaguar
// 3-12-1996  Feyaria@SilberLand


inherit "std/mnpc";

#include "../def.h"

int frieden;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Jaguar");
  SetProp(P_LONG, BS(
    "Dieser Jaguar hat ein wunderbares Fell und gefaehrlich aussehende "
    "Zaehne. Auch seine Krallen sind messerscharf. Hoffentlich haelt er "
    "Dich nicht fuer ein Beutetier, denn ein Kampf mit dieser Raubkatze "
    "ist sicher kein Spass.") );
  SetProp(P_NAME, "Jaguar");
  SetProp(P_GENDER, MALE);
  AddId(({"jaguar", "raubkatze", "FELL_WUSCHEL"}));
  set_living_name("jaguar");

  AddDetail( ({"zaehne", "reisszaehne"}),
    "Die Faenge des Jaguars sind wirklich gefaehrlich. Sicher kann er Dir "
    "damit den ganzen Arm abbeissen.");
  AddDetail( ({"kralle", "krallen"}),
    "Die Krallen des Jaguars sind lang und messerscharf. Damit kann er Dir "
    "sicher die Kehle aufreissen.");

  create_default_npc(23);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", 250, DT_RIP}));
  SetProp(P_XP, QueryProp(P_XP)+2000*100);
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 140);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_WHIP, DT_RIP, DT_LIGHT, DT_MAGIC })); 
  SetProp(P_VULNERABILITY, ({ DT_ACID}));

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "springt bruellend herein");
  SetProp(P_MMSGOUT, "springt bruellend weg");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 15, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_e4");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

  SetProp(P_DIE_MSG,  " stuerzt toedlich verletzt zu Boden.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Jaguar will Deine Sachen nicht tragen.\n" }) );
  AddInfo(DEFAULT_INFO, "faucht Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "schnurrt: ");

  SetProp(P_SPELLRATE,50);
  AddSpell(5, 400,
    "Der Jaguar greift Dich mit seinen gefaehrlichen Reisszaehnen an.\n",
    "Der Jaguar greift @WEN mit seinen gefaehrlichen Reisszaehnen an.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 1000,
    "Der Jaguar springt Dich an, reisst Dich zu Boden und graebt seine "
    "Krallen\nin Deine Brust.\n",
    "Der Jaguar springt und reisst @WEN zu Boden.\n",
     ({DT_RIP, DT_SQUEEZE}), "boden", ([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
    "Der Jaguar faucht Dich an.\n",
    "Der Jaguar schaut Dich mit seinen leuchtenden Katzenaugen an.\n",
    "Der Jaguar zeigt seinen gewaltigen Reisszaehne.\n",
    "Der Jaguar bruellt laut.\n",
    "Der Jaguar schnurrt leise.\n",
    "Der Jaguar fletscht seine Zaehne.\n"}) );

  SetAttackChats(5, ({
    "Der Jaguar bruellt laut.\n",
    "Der Jaguar fletscht seine Zaehne.\n"}) );

  SUID;
  CLONEME(ARMOUR "jaguarfell");
  command("trage alles");

  AddCmd( "kraule", "kraulen");
  AddCmd( ({"streichel", "streichle"}), "streicheln");

  call_out("bruellen", 10+random(100) );
  call_out("ende", 60*(random(10)+5) );

  frieden=random(2);
}

void init()
{
  ::init();
  if( !TP || TP==TO || IS_LEARNER(TP) || TP->id("raubkatze")) return;
  if( !random(5) )
    call_out("angriff", random(3));
  else if( !random(3) )
  {
    call_out("hungrig",0);
  }
}

void hungrig()
{
  if( objectp(TP) && objectp(MENV) && present(TP, MENV) )
  { 
    write("Der Jaguar schleicht hungrig um Dich herum.\n");
    say("Der Jaguar schleicht hungrig um "+ TP->name(WEN) +" herum.\n", ({TP}) );
  }
}

void angriff()
{
  if( !TP ) return;
  if( present( TP, MENV ) )
  {
    write("Ploetzlich springt Dich der Jaguar an.\n");
    say("Ploetzlich springt der Jaguar "+ TP->name(WEN) +" an.\n", ({TP}) );
    Kill(TP);
  }
  else if( TP && ENV(TP) && file_name(ENV(TP))[0..27] == "/d/dschungel/feyaria/kueste/" )
  {
    tell_room( MENV, "Der Jaguar verfolgt "+ TP->name(WEN) +".\n");
    move(ENV(TP), M_TPORT|M_NOCHECK );
    if( TP )
    {
      write("Der Jaguar ist hinter Dir her!\n");
      say("Der Jaguar ist hinter "+ TP->name(WEM) +" her.\n", ({TP}) );
      Kill(TP);
    }
  } 
}

void die(int poisondeath)
{
  write_file(LOG "jaguar.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet den Jaguar.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird vom Jaguar getoetet.\n");
}

int kraulen(string str)
{
  notify_fail("Wen willst Du kraulen?\n");
  if( !id(str) ) return 0;
  tell_object(TP, "Du kraulst den Jaguar und er schnurrt zufrieden.\n");
  tell_room(ENV(TO), TPN+" krault den Jaguar und er schnurrt zufrieden.\n",
           ({TP}));
  if( !random(4) && frieden==0)
  {
    StopHuntFor(TP);
    TP->StopHuntFor(ME);
  }
  return 1;
}

int streicheln(string str)
{
  notify_fail("Wen willst Du streicheln?\n");
  if( !id(str) ) return 0;
  tell_object(TP, "Du streichelst den Jaguar und er schmiegt sich an "
                  "Deine Beine.\n");
  tell_room(ENV(TO), TPN+" streichelt den Jaguar und er schmiegt sich "
                   "an "+ TPPP(FEMALE,WEN,PLURAL) +" Beine.\n",
           ({TP}));
  if( !random(3) && frieden==1)
  {
    StopHuntFor(TP);
    TP->StopHuntFor(ME);
  }
  return 1;
}

void ende()
{
  if( InFight() )
    call_out("ende", 60);
  else
  {
    tell_room(MENV, "Der Jaguar verschwindet laut bruellend im dichten "
                    "Dschungel.\n");
    call_out("remove",1);
  }
}

void remove()
{
  object fell;
  while( remove_call_out("ende")!=-1);
  if( fell=present("jaguarfell") )
  {
    fell->DoUnwear(1);
    fell->remove(1);
  }
  ::remove();
}

void bruellen()
{
  int i;
  mapping exits;
  string *ausgaenge;

  tell_room(MENV, "Der Jaguar bruellt sehr laut.\n");
  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    tell_room( exits[ausgaenge[i]],
      "Du hoerst ein lautes Bruellen aus der Ferne.\n");
  }
}

void boden(object enemy, int damage, mixed dam_type)
{ 
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
}

