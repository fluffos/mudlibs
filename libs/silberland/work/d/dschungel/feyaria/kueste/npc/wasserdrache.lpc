// /d/dschungel/feyaria/kueste/npc/drache.c
// Der Wasserdrache
// 1998-10-29 Feyaria@SilberLand


#include "../def.h"

inherit "/p/std/dragons/dragon";

void create()
{
  int i;
  if (!is_clone(this_object())) return;
  ::create();

  create_default_dragon(3,6,1,10+random(20));
  SetProp(P_SHORT, 
    "Ein messingfarbener Wasserdrache schwimmt zwischen den Algen umher");
  SetProp(P_LONG, 
    "Vor Dir schwimmt ein maechtiger Drache im Wasser. Seine messingfarbenen "
    "Schuppen glaenzen im hellen Wasser. Das muss Kuruploxitruzbandfim, der "
    "beruechtigte Wasserdrache sein! Auf seinem schlangengleichen Hals sitzt "
    "ein gewaltiger Kopf mit einem riesigen, zahngespickten Maul. Seine "
    "meerblauen Augen schauen Dich neugierig an. Die Fluegel sind zu grossen "
    "Flossen umgewandelt, da dieser Drache die meiste Zeit im Wasser "
    "verbringt.");
  SetProp(P_NAME, "Kuruploxitruzbandfim");
  AddId( ({"kuruploxitruzbandfim", "wasserdrache", "WATERBREATH" }) );
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_ARTICLE,0);
  set_living_name("wasserdrache");
  if(random(3))
    CLONEME( OBJ "horn");
}

void die(int poisondeath)
{
  write_file(LOG "drache", dtime(time())+": "+CAP(TP->query_real_name())+
      " killt den Wasserdrachen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "drache", dtime(time())+": Der Wasserdrache hat gerade "+
      CAP(player->query_real_name())+ " umgebracht.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}
