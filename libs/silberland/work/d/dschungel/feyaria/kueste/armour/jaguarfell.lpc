// /d/dschungel/feyaria/kueste/armour/jaguarfell.c
// Das Fell eines Jaguars
// 3-12-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Jaguarfell");
  SetProp(P_LONG, BS( 
    "Das Fell des Jaguars hat eine wunderbare Musterung. Es ist hellgelb "
    "mit vielen schwarzen und weissen Kreisen und Punkten. Wenn Du es Dir "
    "um die Schultern haengst, wirst Du sicher zu einer eindrucksvollen "
    "Erscheinung.") );
  SetProp(P_NAME, "Jaguarfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "jaguarfell","\nfell_is_gerb_able"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 530);
  SetProp(P_VALUE, 1900);
  SetProp(P_WORN_TEXT, "umgehaengt");
}

