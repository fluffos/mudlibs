// /d/dschungel/feyaria/kueste/armour/wurmhaut.c
// Die Haut eines Sandwurms
// 3-12-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Wurmhaut");
  SetProp(P_LONG, BS( 
    "Diese Wurmhaut ist so klein, dass nur ein kleiner Sandwurm sie tragen "
    "kann.") );
  SetProp(P_NAME, "Wurmhaut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"haut", "wurmhaut"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, MAT_SKIN );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 400);

  SetProp(P_WEAR_FUNC, TO );
}

int WearFunc(object me)
{
  if( TP->QuerProp(P_FROG) || TP->QueryProp(P_SIZE)<20)
    return 1;
  write("Du bist doch viel zu gross fuer so eine kleine Wurmhaut.\n");
  return 0;
}
