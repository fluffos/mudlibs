// /d/dschungel/feyaria/kueste/obj/schwanz.c
// Der Schwanz der dreikoepfigen Gelbschwanzechse
// 1997-01-09  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Der Schwanz der dreikoepfigen Gelbschwanzechse");
  SetProp(P_LONG, BS( 
    "Der Schwanz der dreikoepfigen Gelbschwanzechse ist sicher sehr "
    "wertvoll.") );
  SetProp(P_INFO, BS(
    "Viele Leute behaupten, aus dem Schwanz der dreikoepfigen "
    "Gelbschwanzechse koennte man Gold machen.") );
  SetProp(P_NAME, "Echsenschwanz");
  SetProp(P_NAME_ADJ, "gelb");
  SetProp(P_GENDER, MALE);
  AddId( ({"schwanz", "echsenschwanz", "gelbschwanzechsenschwanz",
           "\ngoldschwanz"}) );
  AddAdjective( ({"gelb", "gelber"}) );

  SetProp(P_MATERIAL, ([MAT_SKIN:99, MAT_GOLD:1]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, random(100000) );
  SetProp(P_NOBUY, 1);

}
