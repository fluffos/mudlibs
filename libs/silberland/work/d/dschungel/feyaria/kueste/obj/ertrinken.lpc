// so ertrinken man unterwasser 
// 1998-11-12  Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"

#define ERTRINK_MSG ({\
    "Du schluckst Wasser.\n",\
    "Deine Lungen schmerzen!\n",\
    "Dein Luftvorrat ist zu Ende!\n",\
    "Bald wirst Du ertrinken!\n",\
    "Ein Schwall Wasser dringt in Deine Lunge vor!\n",\
    "Du bist nahe am Ertrinken.\n"})

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, 0);
  SetProp(P_KILL_NAME, "Ertrinken");
  SetProp(P_INVIS, 1);
  AddId( ({"\nertrinken"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
}

void init()
{
  ::init();
  if(!MENV || !living(MENV) )
    call_out("remove",0); 
  call_out("ertrinken", 2);
}
        
void ertrinken()
{
  mapping umgebung;
  if( MENV && ENV(MENV) )
  {
    
    if(objectp(present("\nwaterbreath", MENV)) || MENV->id("WATERBREATH")) {
      tell_object(MENV, BS("Gierig atmest du durch, da du jetzt unter Wasser atmen kannst."));
      call_out("remove", 0);
      return;
    }

    if( mappingp(umgebung=ENV(MENV)->QueryProp(P_ENVIRONMENT)) )
    {
      if( umgebung[ENV_TERRAIN] == TT_UNDERWATER )
      {
        tell_object(MENV, ERTRINK_MSG[random(sizeof(ERTRINK_MSG))] );
        MENV->do_damage( 5+random(10), TO );
        call_out("ertrinken", 2+random(5));
      }
      else
      {
        tell_object(MENV, "Gierig laesst Du die frische Luft in Deine "
            "Lungen stroemen!\n");
        call_out("remove", 0);
      }
    }
    else
      tell_object(MENV, "\nBUG!!! Falsche Umgebungsvariable!!! Erzmagier "
        "benachrichtigen!!!\n\n");
  }
  else
    call_out("remove", 0);
}

        
