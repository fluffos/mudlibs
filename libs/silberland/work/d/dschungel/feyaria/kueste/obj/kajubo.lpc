// /d/dschungel/feyaria/kueste/obj/kajubo.c
// Eine Kajuboknospe
// 1997-01-13  Feyaria@SilberLand

inherit "std/unit";
inherit "std/food";

#include "../def.h"
#include <food.h>

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Kajuboknospe");
  SetProp(P_LONG, 
    "Das ist eine Knospe des Kajubostrauches.");
  SetProp(P_NAME, ({"Kajuboknospe", "Kajuboknospen"}) );
  SetProp(P_INFO, BS(
    "Nach dem Essen einer Kajuboknospe kann man angeblich unter Wasser "
    "atmen.") );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\nkajuboknospe"}) );
  AddSingularId( ({"kajubo", "knospe", "kajuboknospe"}) );
  AddPluralId( ({"kajubos", "knospen", "kajuboknospen"}) );

  SetCoinsPerUnits(10, 1);
  SetGramsPerUnits(50, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_FOOD_INFO, ([F_HEAL:1,F_SOAK:1]));
  AddCmd( ({"iss", "esse"}), "eat");
}

void BeimEssen(object esser)
{
  object ob;
  write("Du kaust die Kajuboknospe und verspuerst ein Kribbeln in Deinen "
        "Lungen.\n");
  say( esser->Name(WER,1)+" kaut auf einer Knospe herum.\n");
  ob = clone_object( OBJ "waterbreath");
  ob->move(esser, M_NOCHECK);
  ob->atmen(5*60); // 5 Minuten
}

int second_life(object pl)
{
  AddAmount(-1);
  return QueryProp(P_AMOUNT);
}

