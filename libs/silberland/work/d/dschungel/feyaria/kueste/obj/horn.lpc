// Die Feder eines Papageis
// 1997-01-10  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Das Horn des Wasserdrachens");
  SetProp(P_LONG, BS( 
    "Das ist das Horn des Wasserdrachens. Es schimmert messingfarben und "
    "ist noch ganz nass.") );
  SetProp(P_NAME, "Wasserdrachenhorn");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"horn", "wasserdrachenhorn", "\nwasserdrachenhorn"}) );

  SetProp(P_MATERIAL, MAT_BRASS );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1000 );
  SetProp(P_NOBUY, 1);
}
