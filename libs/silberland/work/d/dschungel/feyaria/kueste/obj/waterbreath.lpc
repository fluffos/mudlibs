//                    gepluendert und zu verkaufen versucht... pfffh.

inherit "std/thing";

#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, 0);
  SetProp(P_INVIS, 1);
  AddId( ({"\nwaterbreath"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

void atmen(int zeit)
{
  if( MENV && living(MENV) )
  {
    tell_object(MENV, "Du kannst jetzt unter Wasser atmen!\n");
    call_out("ende", zeit);
  }
  else call_out("remove",0);
}

void init()
{
  object ob;
  ::init();
  if(!MENV || !living(MENV) )
    call_out("remove",0);
  while(ob=present("\nertrinken", MENV) ) ob->remove();
  while(ob=present("\nwaterbreath 2", MENV) ) ob->remove();
}

void ende()
{
  mapping umgebung;
  if( MENV && ENV(MENV) )
  {
    if( mappingp(umgebung=ENV(MENV)->QueryProp(P_ENVIRONMENT)) )
    {
      if( umgebung[ENV_TERRAIN] == TT_UNDERWATER )
      {
        tell_object(MENV, "Ploeztlich kannst Du kein Wasser mehr Atmen!!!\n");
        call_out("ertrinken", 2);
      }
      else
      {
        tell_object(MENV, "Du spuerst irgendwie, dass Du nun nicht mehr "
            "unter Wasser atmen kannst.\n");
        call_out("remove",0);
      }
    }
    else
      tell_object(MENV, "\nBUG!!! Falsche Umgebungsvariable!!! Erzmagier "
        "benachrichtigen!!!\n\n");
  }
  else
    call_out("remove",0);
}
        
void ertrinken()
{
  mapping umgebung;
  if( MENV && ENV(MENV) )
  {
    if( mappingp(umgebung=ENV(MENV)->QueryProp(P_ENVIRONMENT)) )
    {
      if( umgebung[ENV_TERRAIN] == TT_UNDERWATER )
      {
        tell_object(MENV, "Du beginnst zu ertrinken!!!\n");
        CLONE( OBJ "ertrinken", MENV);
      }
    }
    else
      tell_object(MENV, "\nBUG!!! Falsche Umgebungsvariable!!! Erzmagier "
        "benachrichtigen!!!\n\n");
  }
  remove();
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  while( remove_call_out("ende")!=-1 ) ;
  call_out("ende",0);
}

