// /d/dschungel/feyaria/kueste/obj/papageifeder.c
// Die Feder eines Papageis
// 1997-01-10  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine bunte Papageienfeder");
  SetProp(P_LONG, BS( 
    "Das ist eine bunte Feder eines Papageis.") );
  SetProp(P_NAME, "Papageienfeder");
  SetProp(P_NAME_ADJ, "bunt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"feder", "papageifeder", "papageienfeder"}) );
  AddAdjective( ({"bunte"}) );

  SetProp(P_MATERIAL, MAT_FEATHER );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 70+random(70) );
}

void init()
{
  ::init();
  call_out("check", random(6));
}

void check()
{
  if (!TO || !MENV || (interactive(MENV) && deep_present("papageienfeder 50", MENV)))
    remove(1);
}
