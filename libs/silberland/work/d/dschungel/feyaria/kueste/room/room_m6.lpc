// /d/dschungel/feyaria/kueste/room/room_m6.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "norden"
#define DIR2 "westen"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG,
    "Du stehst hier am Suedostrand einer kleinen Bucht. Das Wasser der "
    "Bucht ist sehr seicht und laedt zum Schwimmen ein. Neben dem "
    "Kuestenweg beginnt sofort wieder der dichte Dschungel. Die Sonne "
    "brennt vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "bucht", "suedostrand" }), 
    "Die Bucht erstreckt sich hier weit nach Nordwesten. Sicher kann man "
    "hier schoen baden.");

  COMMANDS

  AddExit( DIR1, "./room_m5" );
  AddExit( DIR2, "./room_l6" );
}


BADEN_BUCHT
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN
