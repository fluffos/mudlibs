// /d/dschungel/feyaria/kueste/room/ost_f6.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "suedwesten"
#define DIR2 "osten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg. Die Sonne brennt vom Himmel "
    "herunter und bringt Dich zum Schwitzen. Im Norden liegt der weisse "
    "Sandstrand und dann erstreckt sich das Meer bis zum Horizont. Im Sand "
    "bewegt sich etwas. Hier gibt es scheinbar einige Sandfloehe, die hier "
    "ihr Leben fristen. Suedlich von Dir beginnt dann der Dschungel hinter "
    "einer Reihe von Palmen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  COMMANDS;

  AddDetail( ({"sandfloh", "floh"}),
    "Zum Gluck ist kein Sandfloh in Deiner Naehe.");
  AddDetail( ({"sandfloehe", "floehe"}),
    "Dieser Teil des Strandes ist von Sandfloehen verseucht.");
  AddDetail( ({"sand", "bewegung"}),
    "Im Sand gibt es einige Bewegung. Hier gibt es scheinbar einige "
    "Sandfloehe.");

  AddItem( NPC "sandfloh", REFRESH_DESTRUCT);
  AddItem( NPC "sandfloh", REFRESH_DESTRUCT);

  AddExit( DIR1, "./ost_e7" );
  AddExit( DIR2, "./ost_g6" );

  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

