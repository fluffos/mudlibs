// /d/dschungel/feyaria/kueste/room/room_a7.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#include "../def.h"
#include "./kueste.h"

inherit "std/room";

int koeder = 1;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem kleinen Steg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf einem kleinen Steg, der hier neben dem Fluss "
    "gebaut wurde. Nach Norden fuehrt der Kuestenweg ans Meer. "
    "Der Dschungel ist so dicht, dass er Deinen Blicken nur wenige Schritte "
    "Einblick gewaehrt. Die Sonne brennt vom Himmel herunter und bringt Dich "
    "zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  PFLANZEN
  WETTER

  AddDetail( ({"einblick", "schritte", "blick", "blicke"}),
    "Der dichte Dschungel ermoeglicht nur wenige Schritte Einblick.");
  AddDetail( ({ "steg", "holzsteg", "boden" }),
    "Du stehst auf einem kleinen Holzsteg. Hier koennen nur kleine Boote "
    "anlegen.");
  AddDetail( ({ "boot", "boote" }),
    ([0:"Hier ist leider kein Boot. Um ueber den Fluss zu kommen, musst Du "
    "schon schwimmen.",
    "fee":"Hier ist leider kein Boot, um ueber den Fluss zu kommen, aber Du "
        "kannst ja probieren, hinueber zu flattern oder zu schwimmen."]));
  AddDetail( ({ "kuestenweg", "weg" }),
    "Der Kuestenweg fuehrt nach Norden ans Meer.");
  AddDetail( ({ "meer" }),
    "Das Meer liegt im Norden.");
  AddDetail( ({ "fluss", "muendung" }),
    "Der Fluss fliesst traege nach Norden und muendet dort ins Meer. Aber "
    "das Meerwasser vermischt sich hier schon mit dem Flusswasser.");
  AddDetail( ({ "krokodil", "krokodile" }),
    "Von hier aus kannst Du kein Krokodil erkennen.");
  AddDetail( ({"wasser", "meerwasser", "flusswasser"}),
    "Hier vermischt sich schon das Meerwasser mit dem Flusswasser.");

  AddSound( ({DEFAULT_SOUND, "rauschen", "fluss"}),
    "Du hoerst das Rauschen des Flusses.");
  AddSmell( ({DEFAULT_SMELL, "fluss", "meer", "dschungel"}),
    "Es riecht nach Meer und Fluss und Dschungel.");

  AddCmd( ({"schwimm", "schwimme"}), "schwimmen");
  AddCmd( ({"flatter", "flattere"}), "flattern");
  AddCmd( ({"koeder", "koedere"}), "koedern");

  AddExit( "norden", "./room_a6" );
}

int schwimmen(string str)
{
  notify_fail("Wohin willst Du schwimmen?\n");
  if( str == "fluss" || str == "ueber fluss" || str == "durch fluss" )
  {
    if( random(800)+15 < TP->QueryProp(P_LEVEL) )
    {
      write(BS("Du springst in den Fluss und schwimmst hinaus. Sofort "
        "tauchen neben Dir einige Krokodile auf und kommen beaengstigend "
        "schnell auf Dich zu. Und ploetzlich ist da schon ein Krokodil "
        "neben Dir."));
      TP->move( "/d/dschungel/feyaria/dorf/room/fluss", M_GO,
          "in den Fluss und wird von Krokodilen "
          "erwischt", "springt", "schwimmt herein");
    }
    else
    {
      write( BS("Du springst in den Fluss und schwimmst hinaus. Sofort "
        "tauchen neben Dir einige Krokodile auf und kommen schnell auf Dich "
        "zu. Gerade rechtzeitig erreichst Du das andere Ufer.\n")+
        "Das war jetzt aber knapp!\n");
      TP->move( KUESTE_DORF, M_GO, "in den Fluss und schwimmt von Krokodilen "
        "verfolgt ans andere Ufer", "springt", "kommt von Krokodilen verfolgt "
        "vom anderen Ufer heruebergeschwommen");
    }
    return 1;
  }
  return 0;
}

int flattern(string str)
{
  if( TP->QueryProp(P_RACE) != "Fee") return 0;
  notify_fail("Wohin willst Du flattern?\n");
  if( str == "fluss" || str == "ueber fluss" || str == "hinueber" )
  {
    write( BS("Du flatterst ueber den Fluss."));
    TP->move( KUESTE_DORF, M_GO, "ueber den Fluss ", "flattert", 
        "kommt vom anderen Ufer heruebergeflattert");
    write( BS("Das war jetzt aber anstrengend......"));
    TP->do_exhaust(100+random(100));
    return 1;
  }
  return 0;
}

int koedern(string str)
{
  object ob;

  if (!ob = present("koeder", TP))
    return 0;
  if (!str || strstr(str, "krokodil") == -1)
    return 0;
  write("Du wirfst den Koeder ins Wasser und wartest.\n");
  ob->remove();
  if (koeder)
  {
    clone_object(KROKODIL)->move(TO, M_GO);
    koeder = 0;
  }
  return 1;
}

void reset()
{
  ::reset();
  koeder = 1;
}
