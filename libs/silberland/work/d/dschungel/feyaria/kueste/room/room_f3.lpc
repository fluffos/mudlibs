#define DIR1 "nordosten"
#define DIR2 "suedwesten"

#include "../def.h"
#include "./kueste.h"

inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite schweift Dein Blick in die unendlichen "
    "Weiten des Meeres, davor befindet sich ein weisser Sandstrand; auf der "
    "anderen Seite steht eine Reihe von Palmen und dahinter ermoeglicht der "
    "Dschungel nur wenige Schritte Einblick. Ein leises Murmeln dringt an "
    "Dein Ohr. Die Sonne brennt vom Himmel herunter und bringt Dich zum "
    "Schwitzen. ");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "anblick"}),
    "Der Anblick ist einfach malerisch.");
  AddDetail( ({ "weiten", "blick" }),
    "Du laesst Deinen Blick ueber die Weiten des Meeres schweifen.");
  AddDetail( ({"einblick", "schritte"}),
    "Der dichte Dschungel ermoeglicht nur wenige Schritte Einblick.");
  AddSound( ({DEFAULT_SOUND}),
    "Neben dem Rauschen der Brandung hoerst Du noch ein leises Gemurmel.");
  AddSound( ({"gemurmel", "murmeln"}),
    "Hier murmelt jemand, aber Du kannst niemanden sehen. Vielleicht stehen "
    "hier zwei unsichtbare Magier herum und unterhalten sich?");
  AddSound( ({"magier"}),
    "Das Gemurmel koennte tatsaechlich von einem Magier stammen. Vielleicht "
    "kannst Du die Magier ja ertasten?");
  AddDetail( ({"magier", "unsichtbarer"}),
    "Wie willst Du einen Unsichtbaren sehen? Das ist ja gerade das "
    "Besondere an einem Unsichtbaren, dass man ihn nicht sehen kann. Aber "
    "ertasten muesste man ihn schon koennen.");
  AddDetail( ({"ohr", "ohren"}),
    "Du tastest erschreckt an Deinem Kopf herum und .....\n\n\n"
    "Zum Glueck sind Deine Ohren noch da wo sie hingehoeren.\n");

  COMMANDS
  AddCmd( ({"taste", "tast", "ertaste", "ertast"}), "tasten");
  AddCmd( ({"stibitze", "stibitz"}), "stibitzen");

  AddExit( DIR1, "./room_g2" );
  AddExit( DIR2, "./room_e4" );
  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

int tasten( string str)
{
  notify_fail("Nach Wem willst Du tasten?\n");
  if(!str) return 0;
  if( str == "magier" || str == "nach magier" || str == "unsichtbarer" ||
      str == "nach unsichtbarem" || str == "unsichtbarer magier" ||
      str == "nach unsichtbarem magier" )
  {
    write(BS("Du tastest in der Luft herum und kannst tatsaechlich den Stoff "
      "einer Magierrobe erwischen. Aber halt, da ist doch ein kleines "
      "Flaeschchen in einer Tasche der Robe! Da der unsichtbare Magier "
      "abgelenkt ist, koenntest Du das Flaeschchen vielleicht stibitzen.") );
    return 1;
  }
}

int stibitzen(string str)
{
  notify_fail("Was willst Du stibitzen?\n");
  if(!str) return 0;
  if( str == "flaeschchen")
  {
    write_file(LOG "zt",
      ctime()+": "+ CAP(getuid(TP))+ " findet den Zaubertrank in room_f3\n");
 
   if( TP->FindPotion( BS("Du stibizt ganz frech das kleine Flaeschchen "
      "aus der Tasche in der Robe des Magiers und trinkst es schnell aus, "
      "bevor es Dir wieder weggenommen werden kann. Und tatsaechlich "
      "erfuellt Dich eine wohlige Waerme, die nur ein echter Zaubertrank "
      "ausloesen kann. Es lohnt sich als doch, hinundwieder die Taschen "
      "eines Magiers auf interessante Dinge zu untersuchen!") ) )
    {
      call_out("jemand", 30*random(5) );
      TP->heal_self( random(100) );
    }
    else
      write( BS("Du versuchst, das Flaeschchen zu stibitzen, aber der "
        "unsichtbare Magier hat sich gerade bewegt. :-(") );
    return 1;
  }
  return 0;
}

void jemand()
{
  if( TP )
    write("Jemand ruft: Da idelt man herum und "+ TPN +" nutzt das schamlos aus!\n");
  domainshout("Jemand ruft: Da idelt man herum und "+ TPN +" nutzt das schamlos aus!\n");
}


BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}
