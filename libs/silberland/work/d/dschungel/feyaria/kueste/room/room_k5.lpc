// /d/dschungel/feyaria/kueste/room/room_k5.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "suedosten"
#define DIR2 "norden"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp( P_INT_LONG, 
    "Du stehst hier am Westrand einer kleinen Bucht. Das Wasser der "
    "Bucht ist sehr seicht und laedt zum Schwimmen ein. Neben dem "
    "Kuestenweg beginnt sofort wieder der dichte Dschungel. Der Strand "
    "ist hier wirklich herrlich, denn der Sand ist hier weisser als "
    "weiss.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "bucht", "westrand" }), 
    "Die Bucht erstreckt sich hier weit nach Osten. Sicher kann man "
    "hier schoen baden.");
  AddDetail( ({"sand"}),
    "Hier liegt der schoenste Sand den Du in Deinem Leben gesehen hast. "
    "Er ist weisser als weiss und ganz fein. Wenn es nicht so heiss "
    "waere, koennte man den Sand fuer diese komische Substanz halten, die "
    "im Winter in den noerdlichen Gebieten aus dem Himmel faellt.");
  AddDetail( ({"schnee"}),
    "Nein, der Sand hier ist bestimmt kein Schnee. Du bist Dir sogar "
    "fast sicher, dass es hier nie schneit.");
  AddDetail( ({"substanz"}),
    "Wenn Du schon mal ganz im Norden warst, wirst Du sicher wissen, "
    "welche Substanz das ist.");

  COMMANDS

  AddExit( DIR1, "./room_l6" );
  AddExit( DIR2, "./room_k4" );
  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}


BADEN_BUCHT
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}
