// /d/dschungel/feyaria/kueste/room/room_a6.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "nordosten"
#define DIR2 "sueden"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der hier auf einen Fluss trifft, "
    "der im Westen traege ins Meer muendet. Im Sueden endet der Weg an "
    "einem kleinen Steg, der scheinbar einen Uebergang ueber den Fluss "
    "ermoeglicht. Nach Norden schweift Dein Blick in die unendlichen Weiten "
    "des Meeres, davor befindet sich ein weisser Sandstrand. Im Osten "
    "ermoeglicht der Dschungel nur wenige Schritte Einblick. Die Sonne "
    "brennt vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "fluss", "muendung" }),
    "Im Westen fliesst ein breiter Fluss und muendet ins Meer.");
  AddDetail( ({ "steg" }),
    "Ein Stueck im Sueden befindet sich ein Steg.");
  AddDetail( ({ "uebergang" }), 
    "Du fragst Dich, wie Du wohl ueber den Fluss kommen koenntest.");
  AddDetail( ({ "weiten", "blick" }),
    "Du laesst Deinen Blick ueber die Weiten des Meeres schweifen.");
  AddDetail( ({"einblick", "schritte"}),
    "Der dichte Dschungel ermoeglicht nur wenige Schritte Einblick.");

  AddItem( NPC "papagei", REFRESH_DESTRUCT);

  COMMANDS;

  AddExit( DIR1, "./room_b5" );
  AddExit( DIR2, "./room_a7" );
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}
