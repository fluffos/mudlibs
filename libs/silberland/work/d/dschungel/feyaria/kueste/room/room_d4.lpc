// /d/dschungel/feyaria/kueste/room/room_d4.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "osten"
#define DIR2 "suedwesten"

#include "../def.h"
#include "./kueste.h"

inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der an der Kueste entlang nach "
    "Suedwesten und Osten fuehrt und von einer Reihe von Palmen begleitet "
    "wird. Im Norden schweift Dein Blick in die unendlichen Weiten des "
    "Meeres, waehrend im Sueden der Dschungel nur wenige Schritte Einblick "
    "ermoeglicht. Die Sonne brennt vom Himmel herunter und bringt Dich "
    "zum Schwitzen. Im Norden schaukelt ein Hausboot auf den Wellen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({"boot", "hausboot"}),
     "Im Norden schaukelt ein Hausboot auf den Wellen. Du kannst es betreten.");

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "weiten", "blick" }),
    "Du laesst Deinen Blick ueber die Weiten des Meeres schweifen.");
  AddDetail( ({"einblick", "schritte"}),
    "Der dichte Dschungel ermoeglicht nur wenige Schritte Einblick.");

  COMMANDS

  AddExit( DIR1, "./room_e4" );
  AddExit( DIR2, "./room_c5" );
  if( !random(RANDOM_KAJUBO) )
  {
    KOKOS
  }
  if( !random(RANDOM_KOKOS) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}


BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    KOKOS
  }
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KOKOS) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}
