// /d/dschungel/feyaria/kueste/room/room_l6.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "osten"
#define DIR2 "nordwesten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp( P_INT_LONG, 
    "Du stehst hier am Suedrand einer kleinen Bucht. Das Wasser der Bucht "
    "ist sehr seicht und laedt zum Schwimmen ein. Der Sand scheint sich "
    "hier etwas zu bewegen. Neben dem Kuestenweg beginnt sofort wieder der "
    "dichte Dschungel.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"sand", "larven"}),
    "Der Sand scheint sich hier etwas zu bewegen. Vielleicht sind das die "
    "Larven der Sandfloehe.");
  AddDetail( ({"sandfloh", "floh"}),
    "Scheinbar ist grad keiner da.");
  AddDetail( ({"sandfloehe", "floehe"}),
    "Der Strand hier ist voll mit Sandfloehen.");
  AddDetail( ({ "bucht", "ostrand" }), 
    "Die Bucht erstreckt sich hier weit nach Norden. Sicher kann man hier "
    "schoen baden.");

  COMMANDS;

  AddItem( NPC "sandfloh", REFRESH_DESTRUCT);
  AddItem( NPC "sandfloh", REFRESH_DESTRUCT);
  AddItem( NPC "sandfloh", REFRESH_DESTRUCT);

  AddExit( DIR1, "./room_m6" );
  AddExit( DIR2, "./room_k5" );
  AddExit( "suedwesten", WESTKUESTE_TEMPEL);
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}


BADEN_BUCHT
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}
