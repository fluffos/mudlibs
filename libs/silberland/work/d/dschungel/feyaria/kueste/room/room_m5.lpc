// /d/dschungel/feyaria/kueste/room/room_m5.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand


#define DIR1 "nordosten"
#define DIR2 "sueden"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du stehst hier am Ostrand einer kleinen Bucht. Das Wasser der Bucht "
    "ist sehr seicht und laedt zum Schwimmen ein. Neben dem Kuestenweg "
    "beginnt sofort wieder der dichte Dschungel, der nur wenige Schritte "
    "Einblick ermoeglicht.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"einblick", "schritte"}),
    "Der dichte Dschungel ermoeglicht nur wenige Schritte Einblick.");
  AddDetail( ({ "bucht", "ostrand" }), 
    "Die Bucht erstreckt sich hier weit nach Westen. Sicher kann man hier "
    "schoen baden.");

  COMMANDS

  AddItem( NPC "papagei", REFRESH_DESTRUCT);

  AddExit( DIR1, "./room_n4" );
  AddExit( DIR2, "./room_m6" );
}


BADEN_BUCHT
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN
