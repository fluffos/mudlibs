// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "nordwesten"
#define DIR2 "sueden"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Neben dem Kuestenweg steht hier ein schoenes Strandhaus. "
    "Auf der einen Seite breitet sich ein weiter Sandstrand aus, auf der "
    "anderen Seite beginnt der dichte Dschungel. "
    "Die Sonne brennt vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"haus", "strandhaus"}),
    "Ein schoenes Strandhaus mit einer romatischen Lage an diesem herrlichen "
    "Sandstrand. Du kannst es betreten.");

  COMMANDS;
//  AddCmd( ({"betrete", "betritt"}), "betreten");
  
  AddExit( DIR1, "./ost_b4" );
  AddExit( DIR2, "./ost_c6" );

  AddItem( NPC "xanthos", REFRESH_DESTRUCT);
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN
