// /d/dschungel/feyaria/kueste/room/room_b5.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "osten"
#define DIR2 "suedwesten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite liegt das Meer mit dem weissen Sandstrand "
    "und auf der anderen Seite eine Reihe von Palmen und dahinter der "
    "dichte Dschungel. Die Sonne brennt vom Himmel herunter und bringt Dich "
    "zum Schwitzen. Aus den Baeumen hoerst Du ein wildes Gekreische.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"anblick"}),
    "Der Anblick ist einfach malerisch.");
  AddSound( ({DEFAULT_SOUND, "baum", "baeume", "gekreische", "laerm"}),
    "Aus den Baeumen hoerst Du ein wildes Gekreische.");
  AddDetail( ({ "voegel", "papagei", "vogel", "papageie", "papageien"}),
    "In den Baeumen hier hat sich eine ganze Kolonie Papageie eingenistet. "
    "Diese Voegel machen einen unglaublichen Laerm.");
  AddDetail( ({"papageikolonie", "kolonie"}),
    "Die Papageikolonie macht einen wilden Laerm.");
  AddSound( ({"papagei", "papageie", "kolonie", "papageikolonie",
              "kreischen"}),
    "Du hoerst das Kreischen einer ganzen Papageikolonie.");    
  AddDetail( ({"baeume", "baum", "papagei", "papageie"}),
    "In den Baeumen sitzen einen ganze Menge Papageien. Die machen also "
    "diesen ganzen Laerm.");
  AddDetail( ({"weit", "darum", "am", "weisser", "meers", "sehen",
      "vielleicht", "zahlreiche", "danach", "nur", "bis", "noch", "ohne",
      "zwischen","sei", "aber", "hier", "aus", "diese"}),
    "SOLCHE SINNLOSEN DETAILS BRAUCHST DU NICHT ZU UNTERSUCHEN! DAS KOENNTE "
    "ZIEMLICH SCHNELL TOEDLICH ENDEN!");
  AddSpecialDetail( ({"solche", "sinnlosen", "details", "brauchst", "nicht",
      "zu", "untersuchen", "koennte", "ziemlich", "schnell", "toedlich",
      "enden", "bist", "also", "doch", "so", "dummes", "untersuche",
      "script", "oder", "falls", "doch", "dann", "hoer", "sofort", "auf",
      "sonst", "spricht", "gleich", "tod", "mit", "grossbuchstaben"}),
    "scriptfalle");

  COMMANDS

  AddItem( NPC "papagei" , REFRESH_DESTRUCT);

  AddExit( DIR1, "./room_c5" );
  AddExit( DIR2, "./room_a6" );
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

string scriptfalle()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" untersucht < "+ TP->_unparsed_args()+
    " > in room_b5.\n");
  TP->do_damage(10+random(10) );
  return BS("DU BIST ALSO DOCH SO EIN DUMMES UNTERSUCHE SCRIPT, ODER? FALLS "
            "DU ES DOCH NICHT BIST, DANN HOER SOFORT AUF, SONST SPRICHT "
            "GLEICH DER TOD MIT DIR IN GROSSBUCHSTABEN!");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Scriptfalle in b5) "
               " -%d EP\n", lostexp) );
}
