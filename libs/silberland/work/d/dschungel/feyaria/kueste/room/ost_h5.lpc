// /d/dschungel/feyaria/kueste/room/ost_h5.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "suedwesten"
#define DIR2 "nordosten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Der Kuestenweg laeuft hier von Suedwesten nach Nordosten am weissen "
    "Sandstrand entlang. Die Palmenreihe begleitet auch hier den Weg, "
    "allerdings befindet sich hier eine Luecke in der Reihe, in der ein "
    "schmaler Pfad in den Dschungel fuehrt. Nach Norden schweift Dein Blick "
    "in die unendlichen Weiten des Meeres. Die Sonne brennt vom Himmel "
    "herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "weite", "weiten", "blick" }),
    "Nach Norden kann man sehr weit blicken, nur sieht man dort immer nur "
    "Meer.");
  AddDetail( ({"luecke"}),
    "In der Palmenreihe befindet sich eine Luecke, durch die ein schmaler "
    "Pfad in den Dschungel fuehrt.");
  AddDetail( ({"pfad", "dschungelpfad"}),
    "Leider ist der Dschungelpfad so verwachsen, dass man nicht durch kann. "
    "Vielleicht laesst der Gouverneur den Pfad einmal breiter ausschlagen, "
    "dann kann man hier auch in den dichten Dschungel vordringen.");
  AddDetail( ({"gouverneur"}),
    "Der Gouverneur von Tijara ist der Herr ueber diese ganze Gegend.");

  COMMANDS;

  AddItem( NPC "laeufer", REFRESH_DESTRUCT);

  AddExit( DIR1, "./ost_g6" );
  AddExit( DIR2, "./ost_i4" );
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

