// /d/dschungel/feyaria/kueste/room/ost_b4.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "westen"
#define DIR2 "suedosten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

#include <mnpc.h>

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der an der Kueste entlang nach "
    "Osten fuehrt. Im Westen kannst Du gerade noch die Mauern der Stadt "
    "Tijara erkennen. Im Norden schweift Dein Blick in die unendlichen "
    "Weiten des Meeres, waehrend im Sueden der Dschungel nur wenige "
    "Schritte Einblick ermoeglicht. Im Suedwesten befindet sich eine "
    "grosse Sandburg, waehrend im Suedosten der Weg an einem "
    "Strandhaus vorbei fuehrt.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "stadt", "tijara" }),
    "Die Stadt Tijara ist weit im Westen.");
  AddDetail( ({ "stadtmauer", "mauer", "mauern", "stadtmauern"}),
    "Die Mauern der Stadt kann man gerade noch erkennen. Fuer eine "
    "eingehendere Betrachtung musst Du schon naeher ran gehen.");
  AddDetail( ({ "weite", "weiten", "blick" }),
    "Nach Norden kann man sehr weit blicken, nur sieht man dort immer nur "
    "Meer.");
  AddDetail( ({"einblick", "schritte"}),
    "Der dichte Dschungel ermoeglicht nur wenige Schritte Einblick.");
  AddDetail( ({"haus", "strandhaus"}),
    "Im Suedosten fuehrt der Weg an einem Strandhaus vorbei. Es ist noch zu "
    "weit weg, um naehere Details zu erkennen.");
  AddDetail( ({"burg", "sandburg", "suedwesten"}),
    "Im Suedwesten befindet sich eine grosse Sandburg.");
  
  COMMANDS;

  AddItem( NPC "laeufer", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM, ROOM "ost_b4"]) );

  AddExit( DIR1, "./ost_a4" );
  AddExit( DIR2, "./ost_c5" );

  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

