// /d/dschungel/feyaria/kueste/room/ost_i4.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "suedwesten"
#define DIR2 "osten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der, von Palmen gesaeumt, von "
    "Suedwesten nach Osten verlaeuft. Im Norden liegt der weisse Sandstrand "
    "und dahinter das weite Meer. Im Sueden faengt hinter der Palmenreihe der "
    "dichte Dschungel an. Die Sonne brennt vom Himmel herunter und bringt "
    "Dich zum Schwitzen. Im Norden befindet sich ein Strandhaus.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail ( ({"strandhaus", "haus"}),
      "Das Strandhaus befindet sich im Norden.");

  COMMANDS;

  AddExit( DIR1, "./ost_h5" );
  AddExit( DIR2, "./ost_j4" );

  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

