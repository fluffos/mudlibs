// /d/dschungel/feyaria/kueste/room/ost_d7.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "nordwesten"
#define DIR2 "osten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der an der Kueste entlang nach "
    "Nordwesten und Osten fuehrt und von einer Reihe von Palmen begleitet "
    "wird. Im Norden schweift Dein Blick in die unendlichen Weiten des "
    "Meeres, waehrend im Sueden der Dschungel nur wenige Schritte Einblick "
    "ermoeglicht. Die Sonne brennt vom Himmel herunter und bringt Dich "
    "zum Schwitzen. Einige Krabben haben hier ihre Loecher in den Boden "
    "gegraben.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "weite", "weiten", "blick" }),
    "Nach Norden kann man sehr weit blicken, nur sieht man dort immer nur "
    "Meer.");
  AddDetail( ({"krabbe"}),
    "Es ist gerade keine Krabbe da. Sind wohl alle in ihren Loechern "
    "verschwunden.");
  AddDetail( ({"krabben", "loch", "loecher"}),
    "Einige Krabben haben hier ihre Loecher in den Boden gegraben.");
  AddDetail( ({"boden"}),
    "Der Boden besteht aus festgetretenem Sand, in dem sich einige Loecher "
    "befinden.");

  COMMANDS;

  AddExit( DIR1, "./ost_c6" );
  AddExit( DIR2, "./ost_e7" );

  AddItem( KRABBE, REFRESH_DESTRUCT );
  AddItem( KRABBE, REFRESH_DESTRUCT );
  AddItem( KRABBE, REFRESH_DESTRUCT );

}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

