// /d/dschungel/feyaria/kueste/room/bucht.c
// Bucht an der Kueste von Tijara
// 1997-01-13  Feyaria@SilberLand

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

#include <exploration.h>

void tot(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Bucht" );
  SetProp(P_INT_LONG, 
    "Du schwimmst in einer kleinen Bucht, die von fast allen Seiten von "
    "einem herrlichen Sandstrand umgeben ist. Nur nach Norden und Nordosten "
    "weitet sich die Bucht und fuehrt ins weite Meer hinaus. Am Strand "
    "verlaeuft ein schmaler Kuestenweg, der von einer Reihe von Palmen "
    "begleitet wird. Dahinter befindet sich dann der dichte Dschungel. "
    "Die Sonne heizt das Wasser auf und ermoeglicht so einen laengeren "
    "Aufenthalt im Wasser. Unter Dir kannst Du hin und wieder kleine "
    "Fischchen herumschwimmen sehen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_WATER:1000,
                          ENV_TERRAIN:TT_WATER]) );
  SetProp(P_NOMAGIC, 100);
  SetProp(P_KILL_NAME, "Ertrinken");

  AddDetail( ({"bucht"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"sandstrand", "strand"}),
    "Der Strand ersteckt sich fast um die ganze Bucht herum. Er ist von "
    "weissem Sand bedeckt.");
  AddDetail( ({"meer", "wellen", "brandung"}),
    "Das Meer ist hier sehr ruhig und die Wellen sind nur sehr klein, weil "
    "sich weit draussen die grossen Wellen an einem Korallenriff brechen.");
  AddDetail( ({"kuestenweg", "weg", "ufer"}),
    "Der Kuestenweg fuehrt am Ufer den Strand entlang.");
  AddDetail( ({"reihe"}),
    "Die Palmen stehen wie an einer Reihe aufgefaedelt am Strand.");
  AddDetail( ({"palmen", "palme", "kokospalmen", "kokospalme"}),
    "Die Palmen bilden wirklich eine richtige Reihe. Hin und wieder "
    "befindet sich auch eine Kokospalme darunter.");
  AddDetail( ({"dschungel"}),
    "Der dichte Dschungel faengt gleich hinter den Palmen an und schaut "
    "ziemlich undurchdringlich aus.");
  AddDetail( ({"sonne", "himmel"}),
    "Die Sonne brennt erbarmungslos aus dem wolkenlosen Himmel herunter und "
    "waermt das Wasser angenehm auf.");
  AddDetail( ({"wasser"}),
    "Das Meerwasser ist sehr warm und auch sehr klar, denn Du kannst den "
    "Meeresboden ganz deutlich sehen.");
  AddDetail( ({"meerwasser"}),
    "Das Meerwasser ist Salzwasser.");
  AddDetail( ({"salzwasser"}),
    "Das Salzwasser ist Meerwasser.");
  AddDetail( ({"meeresboden", "boden", "grund", "meeresgrund"}),
    "Unter Dir liegt der Meeresboden, den Du wegen des klaren Wassers sehr "
    "deutlich sehen kannst. Du kannst aber nicht abschaetzen, wie tief das "
    "Wasser hier ist.");
  AddDetail( ({"tiefe"}),
    "Die Tiefe kannst Du nur sehr schwer abschaetzen.");
  AddDetail( ({"aufenthalt"}),
    "Weil das Wasser so warm ist, kannst Du sicher sehr lange im Wasser "
    "bleiben.");
  AddDetail( ({"fischchen", "fische", "fisch"}),
    "Unter Dir schwimmt ein kleines Fischchen herum.");
  AddDetail( ({"meer", "wellen", "brandung"}),
    "Weit draussen brechen sich die grossen Wellen an einem Riff.");
  AddDetail( ({"salz"}),
    "Das Salz ist im Meerwasser geloest. Sehen kann man es nicht.");
  AddDetail( ({"sand"}),
    "Der Sand ist weiss und ganz fein, sofern Du das von hier aus "
    "beurteilen kannst.");
  AddDetail( ({"riff", "korallenriff", "korallen", "koralle"}),
    "Das Riff ist irgendwo da draussen im Meer. Vielleicht kannnst Du "
    "ja ins Meer hinausschwimmen und hinuntertauchen, um das "
    "Korallenriff zu besuchen.");

  AddSound( ({DEFAULT_SOUND, "wellen", "glucksen"}),
    "Du hoerst das leise Glucksen der Wellen.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Meer.");
  AddSmell( "meer",
    "Das Meer riecht nach Salz, Seetang und Fisch.");
  AddSmell( ({"salz", "seetang", "tang", "fisch"}),
    "Danach riecht das Meer ganz intensiv.");

  AddCmd( ({"nimm", "steck", "stecke", "leg", "lege"}), "nehmen");
  AddCmd( ({"zieh", "ziehe", "trage", "trag"}), "an_aus_ziehen");
  AddCmd( ({"schwimme", "schwimm"}), "baden");
  AddCmd( ({"tauche", "tauch"}), "tauchen");
  AddCmd( ({"fische", "fisch", "angle", "angel", "fang", "fange"}),"fangen");
  AddCmd( ({"ersaeufe", "ersaeuf", "ertraenk", "ertraenke"}), "stossen");
}

string GetExits()
{
  return "Du kannst in jede Richtung schwimmen.\n";
}

int tauchen(string str)
{
  object ob;
  notify_fail("Du solltest schon unter Wasser atmen koennen, wenn Du hier "
              "tauchen willst.\n");
  if( present("\nwaterbreath", TP) )
  {
    TP->move( ROOM "unterwasser", M_GO, "unter", "taucht", "kommt von oben "
        "heruntergetaucht");
    return 1;
  }
  return 0;
}

int baden(string str)
{
  notify_fail("Wohin willst Du schwimmen?\n");
  if(!str) return 0;
  if( str == "nordwesten" || str == "nach nordwesten" || str == "nw")
  {
    write("Du schwimmst nach Nordwesten ans Ufer zurueck.\n");
    TP->move( ROOM "room_k4", M_GO, "nach Nordenwesten", "schwimmt",
               "kommt pudelnass aus dem Wasser");
    return 1;
  }
  if( str == "westen" || str == "nach westen" ||  str == "suedwesten" ||
      str == "nach suedwesten" || str == "sw" || str == "w")
  {
    write("Du schwimmst nach Westen ans Ufer zurueck.\n");
    TP->move( ROOM "room_k5", M_GO, "nach Westen", "schwimmt",
               "kommt pudelnass aus dem Wasser");
    return 1;
  }
  if( str == "sueden" || str == "nach sueden" || str == "s")
  {
    write("Du schwimmst nach Sueden ans Ufer zurueck.\n");
    TP->move( ROOM "room_l6", M_GO, "nach Sueden", "schwimmt",
               "kommt pudelnass aus dem Wasser");
    return 1;
  }
  if( str == "suedosten" || str == "nach suedosten" || str == "so")
  {
    write("Du schwimmst nach Suedosten ans Ufer zurueck.\n");
    TP->move( ROOM "room_m6", M_GO, "nach Suedosten", "schwimmt",
               "kommt pudelnass aus dem Wasser");
    return 1;
  }
  if( str == "osten" || str == "nach osten" || str == "o")
  {
    write("Du schwimmst nach Osten ans Ufer zurueck.\n");
    TP->move( ROOM "room_m5", M_GO, "nach Osten", "schwimmt",
               "kommt pudelnass aus dem Wasser");
    return 1;
  }
  ////////////////////////////////////////////////////////
  // Fuer Riff
  if( str == "nach norden" || str == "nach n")
  {
    write("Du schwimmst nach Norden.\n");
    TP->move( "/d/wasser/cirion/riff/room/riff01", M_GO, "nach Norden", "schwimmt",
               "schwimmt herein");
    return 1;
  }
  if( str == "nach nordosten" || str == "nach no")
  {
    write("Du schwimmst nach Nordosten.\n");
    TP->move( "/d/wasser/cirion/riff/room/riff02", M_GO, "nach Nordosten", "schwimmt",
               "schwimmt herein");
    return 1;
  }
  ////////////////////////////////////////////////////////
  /* Und das brauchts dann nicht mehr. Bloss bled mit dem EP.
  if( member( ({"nordosten", "nach nordosten", "norden", "nach norden", "n",
         "meer", "ins meer", "aufs meer hinaus", "hinaus", "raus", "no",
         "auf meer hinaus", "riff", "korallenriff"}),str)!=-1 )
  {
    write( BS("Auf das offene Meer solltest Du besser nicht hinausschwimmen."
      " Feyaria hat dort hungrige Haie, gefraessige Meeresungeheuer, "
      "moerderische Riesenkraken, giftige Seeschlangen, allesverschlingende "
      "Strudel und toedlliche Stroemungen geproggt, die Du sicher nicht "
      "alle austesten willst. (sonst wuerde ja auch der [Tod:]-Kanal zu "
      "stark scrollen). Wenn Du wirklich ins Meer schwimmen willst, dann "
      " gib 'schwimm selbstmoerderisch auf das weite meer hinaus' ein. Die "
      "erste SilberLaendische Seher-und-Spieler-Versicherung lehnt aber "
      "jegliche Haftung fuer eine solche Handlung ab.") );
    return 1;
  }
  if( str == "selbstmoerderisch auf weite meer hinaus"  )
  {
    write("Du schwimmst in selbstmoerderischer Absicht aufs hohe Meer "
          "hinaus.\n");
    say(CAP(TPN)+ " schwimmt in selbstmoerderischer Absicht aufs hohe Meer "
          "hinaus.\n");
    tot("Ein hungriger Hai hat gerade "+ TPN+ " umgebracht.\n");
    tot("Ein Meeresungeheuer hat gerade "+ TPN+ " umgebracht.\n");
    tot("Eine Riesenkrake hat gerade "+ TPN+ " umgebracht.\n");
    tot("Eine giftige Seeschlange hat gerade "+ TPN+ " umgebracht.\n");
    tot("Ein Strudel hat gerade "+ TPN+ " umgebracht.\n");
    tot("Eine toedliche Stroemung hat gerade "+ TPN+ " umgebracht.\n");
    if( !IS_LEARNER(TP) )
      TP->command_me( "wirf alles weg");
    EPMASTER->GiveExplorationPoint("strudel", EP_MISC);
    TP->SetProp(P_GHOST, 1);
    TP->move("/room/death/death_room", M_TPORT|M_SILENT|M_NOCHECK);
    return 1;
  }*/
  if( member( ({"ufer", "strand", "sandstrand", "zum ufer", "zum strand",
     "an den strand", "zurueck", "an strand", "ans ufer", "an ufer" }),
      str)!=-1 )
  {
    write(BS( "Da das Ufer hier in vielen Richtungen liegt, solltest Du "
        "schon angeben, in welche Richtung Du schwimmen willst.") );
    return 1;
  }
  return 0;
}

nosave void tot(string msg)
{
  catch(VOICEMASTER->SendToChannel("Tod",this_object(),SAY,msg));
}

int fangen(string str)
{
  notify_fail("Was willst Du fangen?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du hier nicht fangen!\n");
  if( str=="fisch" || str=="fische")
  {
    if (present("angel", TP))
    {
      write( "Du wirfst Deine Angel mitten im Wasser aus, aber der "
        "Haken bohrt sich in\nDeinem grossen Zeh.\n AUA!!!\n" );
      TP->reduce_hit_point(5);
      return 1;
    }
    write("Willst Du mit blossen Haenden Fische fangen?\n");
    return 1;
  }
  return 0;
}

int an_aus_ziehen()
{
  if( present("\nwaterbreath", TP) ) return 0;
  write("Du strampelst wild im Wasser herum, aber ohne Ergebnis.\n");
  return 1;
}

void init()
{
  object ob;
  ::init();
  if( TP->QueryProp(P_ARMOURS)!=({}) && !present("\nwaterbreath", TP) )  
    call_out("ertrinken",0);   
  if( present("ratte") )
    tell_room(TO, "Eine Ratte paddelt hier herum, sicher kannst Du sie ganz "
        "einfach ersaeufen.\n");
  if (ob = present("\nluft",TP))
    ob->remove();
}

void ertrinken()
{
  int i,gewicht;
  object *armours;
  if( !TP || present("\nwaterbreath", TP) ) return;
  if( ENV(TP)!=TO) return;
  gewicht=0;
  armours=TP->QueryProp(P_ARMOURS);
  for(i=sizeof(armours)-1;i>-1;i--)
    gewicht+=armours[i]->QueryProp(P_WEIGHT);
  if( gewicht > random(1000)+1000 )
  {
    write("Deine schweren Ruestungen ziehen Dich auf den Meeresgrund.\n");
    TP->do_damage( 2+random(5) );
  }
  call_out("ertrinken",1);
}

int nehmen()
{
  if( present("\nwaterbreath", TP) ) return 0;
  write("Du brauchst beide Haende zum Schwimmen, darum kannst Du nichts "
        "nehmen.\n");
  return 1;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Ertrinken in Bucht ) "
               " -%d EP\n", lostexp) );
}

int stossen(string str)
{
  object ob, ob2;
  if( !(ob2=present("\nrattenfaengerquest", TP))) return 0;
  notify_fail("Wen willst ersaeufen?\n");
  if( !str ) return 0;
  if( str=="ratte" || str == "ratte im meer" )
  {
    if( ob=present("ratte") )
    {
      write("Du ersaeufst eine Ratte im Meer.\n");
      say( CAP(TPN)+ " ersaeuft eine Ratte im Meer.\n");
      TP->RemovePursuer(ob);
      ob->remove();
      call_other(ob2, "versenke_ratte");
      return 1;
    }
  }
  return 0;
}

void reset()
{
  object ob,next;
  ::reset();
  for(ob=first_inventory(TO);ob;)
  {
    next=next_inventory(ob);
    if( !living(ob) )
    {
      if( ob->QueryMaterialGroup(MATGROUP_SWIMABLE) > 50 )
      {
         tell_room(TO, ob->Name(WER,2)+ 
             (ob->IsPlural() ? "werden":" wird") +" ans Ufer getrieben.\n");
         ob->move(ROOM "room_l6", M_NOCHECK);
      }
      else
      {
        tell_room(TO, ob->Name(WER,2)+ 
             (ob->IsPlural() ? " gehen":" geht")+ " unter.\n");
        ob->remove();
        if( ob ) destruct(ob);
      }
    }
    ob=next;
  }
}

       
