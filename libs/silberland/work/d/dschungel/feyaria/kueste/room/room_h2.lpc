// /d/dschungel/feyaria/kueste/room/room_h2.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "suedosten"
#define DIR2 "westen"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg. Die Sonne brennt vom Himmel "
    "herunter und bringt Dich zum Schwitzen. Im Norden liegt der weisse "
    "Sandstrand und dann erstreckt sich das Meer bis zum Horizont. In "
    "grosser Ferne vermeinst Du eine kleine Insel zu sehen. Suedlich von "
    "Dir beginnt dann der Dschungel hinter einer Reihe von Palmen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "insel" }),
    "Du kneifst Deine Augen zusammen und kannst tatsaechlich eine kleine "
    "Insel erkennen. Sie ist aber zu weit entfernt, um hinzuschwimmen, aber "
    "vielleicht gibt es ja eine Moeglichkeit, mit einem Boot dorthin zu "
    "kommen.");
  AddDetail( ({ "boot", "moeglichkeit"}),
    "Leider ist hier kein Boot.");

  COMMANDS

  AddItem( NPC "laeufer", REFRESH_DESTRUCT);

  AddExit( DIR1, "./room_i3" );
  AddExit( DIR2, "./room_g2" );
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN
