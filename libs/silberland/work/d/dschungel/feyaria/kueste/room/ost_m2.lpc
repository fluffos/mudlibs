// /d/dschungel/feyaria/kueste/room/ost_m2.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "westen"
#define DIR2 "suedosten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG,
    "Der Kuestenweg endet hier an einem Sumpf, den Du im Suedosten betreten "
    "kannst. Der einzige Weg zurueck geht nach Westen. Im Norden befindet "
    "sich das weite Meer, nach Sueden verhindert der dichte Dschungel ein "
    "weiteres Eindringen. Der Sumpf sieht sehr gefaehrlich aus, hin und "
    "wieder sieht man sogar ein Krokodil dort herumschwimmen. Die Sonne "
    "brennt vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"kueste", "kuestenweg", "weg"}), 
    "Der Kuestenweg endet hier an einem Sumpf. Zurueck geht es nach Westen.");
  AddDetail( ({"sumpf"}),
    "Du kannst den Sumpf im Suedosten betreten. Aber Du solltest vorsichtig "
    "sein, denn wer weiss, welche Gefahren dort auf Dich lauern.");
  AddDetail( ({"krokodil", "krokodile", "gefahr", "gefahren"}),
    "Es gibt einige Krokodile in diesem Sumpf. Du solltest Dich also von "
    "dem Sumpf fernhalten!");
  
  COMMANDS;

  AddExit( "westen", "./ost_l2" );
  AddExit( "suedosten", ([EX_DEST: OSTKUESTE_SUMPF,
                          EX_TESTFUNC: "log"]) );
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

int log(string dir)
{
  if( TP->QueryProp(P_LEVEL) < 15 ) 
  {
    write("Du traust Dich nicht in den Sumpf.\n");
    return 0;
  }
  return 1;
}
