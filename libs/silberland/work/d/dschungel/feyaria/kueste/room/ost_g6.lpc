// /d/dschungel/feyaria/kueste/room/ost_g6.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "westen"
#define DIR2 "nordosten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite schweift Dein Blick in die unendlichen "
    "Weiten des Meeres, davor liegt ein weisser Sandstrand; auf der anderen "
    "Seite befindet sich eine Reihe von Palmen und dahinter der dichte "
    "Dschungel. Die Sonne brennt vom Himmel herunter und bringt Dich zum "
    "Schwitzen. Im Sand bewegt sich etwas. Hier gibt es scheinbar einige "
    "Sandfloehe.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  COMMANDS;

  AddDetail( ({"sandfloh", "floh"}),
    "Zum Glueck ist kein Sandfloh in Deiner Naehe.");
  AddDetail( ({"sandfloehe", "floehe"}),
    "Dieser Teil des Strandes ist von Sandfloehen verseucht.");
  AddDetail( ({"sand", "bewegung"}),
    "Im Sand gibt es einige Bewegung. Hier gibt es scheinbar einige "
    "Sandfloehe.");
  AddDetail( ({ "anblick"}),
    "Der Anblick ist einfach malerisch.");
  AddDetail( ({ "weiten", "blick" }),
    "Du laesst Deinen Blick ueber die Weiten des Meeres schweifen.");
    
  AddItem( NPC "sandfloh", REFRESH_DESTRUCT);

  AddExit( DIR1, "./ost_f6" );
  AddExit( DIR2, "./ost_h5" );

  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

