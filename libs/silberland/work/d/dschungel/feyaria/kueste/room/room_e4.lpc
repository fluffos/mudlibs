// /d/dschungel/feyaria/kueste/room/room_e4.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "nordosten"
#define DIR2 "westen"

#include "../def.h"
#include "./kueste.h"

inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite liegt das Meer mit dem weissen Sandstrand "
    "und auf der anderen Seite eine Reihe von Palmen und dahinter der "
    "dichte Dschungel. In den Bueschen sind einige Zweige abgeknickt; da "
    "ist wohl ein grosses Tier aus dem Dschungel an den Strand gekommen. "
    "Die Sonne brennt vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "anblick"}),
    "Der Anblick ist einfach malerisch.");
  AddDetail( ({ "zweig", "zweige" }),
    "In den Bueschen sind einige Zweige abgeknickt; da ist wohl ein grosses "
    "Tier aus dem Dschungel an den Strand gekommen.");
  AddDetail( ({ "tier", "tiere" }),
    "Es muss wohl ein grosses Tier gewesen sein, denn sonst waeren nicht "
    "so viele Zweige abgeknickt. Vielleicht kannst du ja die Spuren des "
    "Tieres finden.");
  AddDetail( ({"spur", "spuren", "tierspur", "tierspuren"}),
    "Du solltest vorher die Spuren finden. Denn wenn Du sie gefunden "
    "haettest, dann wuesstest Du, welche Spuren es sind."); 
  AddDetail( ({"katzenspuren", "katzenspur", "raubkatzenspuren",
               "raubkatzenspur"}),
    "Es koennte sich tatsaechlich um eine Raubbkatzenspur handlen.");
  AddDetail( ({"jaguarspuren", "jaguarspur"}),
    "Hier ist tatsaechlich eine Spur eines Jaguars. Leider kannst Du nicht "
    "feststellen, wie alt sie ist.");
  AddDetail( ({"katze", "katzen", "raubkatze", "raubkatzen"}),
    "Welche Raubkatze wohl diese Spuren hinterlassen hat?");
  AddDetail( ({"jaguar"}),
    "Kein Jaguar weit und breit.");

  COMMANDS
  AddCmd( ({"finde"}), "finden");
  AddCmd( ({"begutachte"}), "begutachten");

//  AddItem( NPC "jaguar", REFRESH_DESTRUCT);
  call_out("jaguar", 60*random(10) );

  AddExit( DIR1, "./room_f3" );
  AddExit( DIR2	, "./room_d4" );
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

int finden(string str)
{
  notify_fail("Was willst Du finden?\n");
  if( !str ) return 0;
  if( str == "jaguarspuren" || str == "jaguarspur")
  {
    write("Du weisst ja schon, welche Spuren das sind, also hast Du sie "
         "schon gefunden.\n");
    return 1;
  }
  if( str == "spuren" || str == "spur" || str == "tierspuren" ||
      str == "tierspur" )
  {
    write( BS("Du findest Spuren einer Raubkatze. Wenn Du sie naeher "
         "begutachtest, kannst Du vielleicht herausfinden, um welches Tier "
         "es sich genau handelt.") );
    return 1;
  }
  if( str == "katzenspuren" || str == "katzenspur" || 
      str == "raubkatzenspuren" || str == "raubkatzenspur" )
  {
    write( BS("Gefunden hast Du sie schon. Wenn Du sie naeher "
         "begutachtest, kannst Du vielleicht herausfinden, um welche "
         "Raubkatze es sich genau handelt.") );
    return 1;
  }
  return 0;
}

int begutachten(string str)
{
  notify_fail("Was willst Du begutachten?\n");
  if( !str) return 0;
  if( str == "jaguarspuren" || str == "jaguarspur")
  {
    notify_fail("Du weisst ja schon, welche Spuren das sind, also hast Du "
       "sie schon begutachtet.\n");
    return 0;
  }
  if( str == "spuren" || str == "spur" || str == "tierspuren" ||
      str == "tierspur" || str == "katzenspuren" || str == "katzenspur" || 
      str == "raubkatzenspuren" || str == "raubkatzenspur" )
  {
    write( BS("Du begutachtest die Spuren der Raubkatze und kommst zu dem "
         "Schluss, dass es sich hier nur um einen Jaguar handeln kann.") );
    return 1;
  }
  return 0;
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  call_out("jaguar", 60*random(10) );
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

void jaguar()
{
  tell_room(TO, "Die Zweige knacken als ein Jaguar bruellend aus den "
                "Bueschen tritt.\n");
  clone_object( NPC "jaguar" )->move( TO, M_NOCHECK | M_SILENT);
  tell_room( ROOM "room_f3", "Du hoerst ein Bruellen im Suedwesten.\n");
  tell_room( ROOM "room_d4", "Du hoerst ein Bruellen im Osten.\n");
}
