// /d/dschungel/feyaria/kueste/room/room_o4.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "nordosten"
#define DIR2 "westen"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

int wuermer;

void create()
{
  ::create();

  wuermer=1;
  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite liegt das Meer mit dem weissen Sandstrand "
    "und auf der anderen Seite eine Reihe von Palmen und dahinter der "
    "dichte Dschungel. Im Sandboden sind viele kleine Loecher. Die Sonne "
    "brennt vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"anblick"}),
    "Der Anblick ist wirklich malerisch.");
  AddDetail( ({ "boden", "sandboden" }),
    "Im Sandboden sind viele kleine Loecher.");
  AddDetail( ({ "loch", "loecher"}),
    "Wer diese Loecher wohl gegraben haben mag?");

  COMMANDS

  AddExit( DIR1, "./room_p3" );
  AddExit( DIR2, "./room_n4" );
  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}


BADEN
LIEGEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  wuermer=random(2)+1;
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

int graben(string str)							
{
  int i,anzahl_wuermer;
  object wurm;

  notify_fail("Wo willst Du graben?\n");
  if( !str ) return 0;
  if( member( ({"sand", "boden", "im boden", "im sand", "loch", "loecher"}),
              str)!=-1 )
  {
    write( BS("Du graebst ein kleines Loch in den weichen Sand und findest "
              "ein Nest von kleinen Sandwuermern.") );
    say( CAP(TPN)+ " graebt ein Loch in den Boden.\n");
    if(wuermer)
    {
      wuermer--;
      anzahl_wuermer=random(4)+3;    
      for(i=0;i<anzahl_wuermer;i++)
      {
       (wurm = clone_object( NPC "wurm" ))->move( TO, M_NOCHECK);
        if (!IS_WIZARD(TP))
          wurm->Kill(TP);
      }
    }
    else
      write("Leider ist das Wuermernest leer.\n");
    return 1;
  }
  return 0;
}
