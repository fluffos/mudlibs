// /d/dschungel/feyaria/kueste/room/ost_e7.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "westen"
#define DIR2 "nordosten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

#include <mnpc.h>

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite liegt das Meer mit dem weissen Sandstrand "
    "und auf der anderen Seite eine Reihe von Palmen und dahinter der "
    "dichte Dschungel. Die Sonne brennt vom Himmel herunter und bringt Dich "
    "zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "anblick"}),
    "Der Anblick ist einfach malerisch.");

  COMMANDS;

  AddItem( ({NPC "papagei",
             "/d/dschungel/dante/weg/npc/dkakadu",
             "/d/dschungel/dante/weg/npc/dkoli" }), REFRESH_DESTRUCT,
     ([P_MNPC_AREA: ROOM, P_MNPC_DEFAULTROOM: ROOM "ost_e7"]) );

  AddExit( DIR1, "./ost_d7" );
  AddExit( DIR2, "./ost_f6" );

  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }

}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

