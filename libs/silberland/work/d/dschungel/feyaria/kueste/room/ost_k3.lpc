// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "suedwesten"
#define DIR2 "nordosten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG,
    "Der Kuestenweg fuehrt hier in gerader Linie von Suedwesten nach "
    "Nordosten. Dicht hinter der Palmenreihe, die den Weg begleitet, faengt "
    "der dichte Dschungel an. Im Norden und Westen liegt der breite "
    "Sandstrand, hinter dem sich das weite Meer ausbreitet. Die Sonne glueht "
    "vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  COMMANDS;

  AddExit( DIR1, "./ost_j4" );
  AddExit( DIR2, "./ost_l2" );
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( random(2) )
    call_out("jaguar", 60*random(10) );
}

void jaguar()
{
  tell_room(TO, "Die Zweige knacken als ein Jaguar bruellend aus den "
                "Bueschen tritt.\n");
  clone_object( NPC "jaguar" )->move( TO, M_NOCHECK | M_SILENT);
  tell_room( ROOM "ost_l2", "Du hoerst ein Bruellen im Suedwesten.\n");
  tell_room( ROOM "ost_j4", "Du hoerst ein Bruellen im nordosten.\n");
}
