// /d/dschungel/feyaria/kueste/room/unterwasser.c
// Unterwasserraum an der Kueste von Tijara
// 1997-01-13  Feyaria@SilberLand

#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Unterwasser" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich ca. 10 Meter unter dem Wasserspiegel. Der Meeresboden "
    "ist dicht mit Algen bewachsen, zwischen denen sich viele kleine bunte "
    "Fischchen tummeln. Von oben dringen noch vereinzelt Sonnenstrahlen "
    "herunter, sodass es auch in dieser Tiefe noch ausreichend hell ist. "
    "Das Wasser ist sehr klar und hat eine hellblaue Farbe. Auf dem "
    "Meeresboden liegt eine gewaltige Riesenmuschel." );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_WATER:1000,
                          ENV_TERRAIN:TT_UNDERWATER]) );
  SetProp(P_KILL_NAME, "Ertrinken");

  AddDetail( ({"muschel", "riesenmuschel"}),
    "Die Muschel ist so riesengross, dass da ein ganzes Haus hineinpassen "
    "koennte. Vielleicht wohnt ja jemand drinnen?");
  AddDetail( ({"wasser"}),
    "Das Meerwasser ist hellblau und sehr klar.");
  AddDetail( ({"meerwasser"}),
    "Das Meerwasser ist Salzwasser.");
  AddDetail( ({"salzwasser"}),
    "Das Salzwasser ist Meerwasser.");
  AddDetail( ({"salz"}),
    "Das Salz ist im Meerwasser geloest. Sehen kann man es nicht.");
  AddDetail( ({"tiefe"}),
    "Du bist ca. 10 Meter unter dem Wasserspiegel.");
  AddDetail( ({"boden", "meeresboden"}),
    "Der Meeresboden besteht aus Sand und ist dicht mit Algen bewachsen. "
    "Dazwischen liegt eine riesige Muschel.");
  AddDetail( ({"sand"}),
    "Der Boden besteht aus Sand.");
  AddDetail( ({"algen", "alge"}),
    "Der Meeresboden ist bis auf eine Stelle dicht mit Algen bewachsen. Sie "
    "wiegen sich in der Stroemung sanft hin und her. Zwischen den Algen "
    "schwimmen viele kleine Fischchen umher.");
  AddDetail( ({"stelle", "norden"}),
      "An einer Stelle kannst Du durch die Algen nach Norden schwimmen.");
  AddDetail( ({"stroemung", "wasserstroemung"}),
    "Die sanfte Wasserstroemung wiegt die Algen hin und her.");
  AddDetail( ({"farbe"}),
    "Die Farbe des Wassers ist hellblau.");
  AddDetail( ({"fischchen", "fisch", "fische"}),
    "Zwischen den Algen schwimmen viele kleine Fischchen herum.");  
  AddDetail( ({"wasserspiegel"}),
    "Der Wasserspiegel ist ca. 10 Meter ueber Dir.");
  AddDetail( ({"sonnenstrahlen", "strahlen"}),
    "Vereinzelt dringen Sonnenstrahlen bis hier herunten vor und erhellen "
    "das Wasser.");
  AddDetail( ({"sonne"}),
    "Die Sonne kannst Du hier unten nicht sehen, nur einige ihrer Strahlen.");

  AddSound( ({DEFAULT_SOUND, "blubb"}),
    "*Blubb Blubb*");

  SetProp(P_HIDE_EXITS, ({"norden"}));
  AddExit("suedwesten", "./unterwasser");

  AddCmd( ({"betrete", "betritt"}), "muschel"); 

  AddItem( NPC "hai", REFRESH_DESTRUCT);
}

int muschel(string str)
{
  notify_fail("Was willst du betreten?\n");
  if(str=="muschel")
  {
    TP->command_me("norden");
    return 1;
  }
  return 0;
}


void init()
{
  ::init();
  if (TP && interactive(TP) && !IS_LEARNER(TP) && 
      !present("\nwaterbreath", TP) && !present("\nertrinken", TP) && 
      !TP->id("WATERBREATH"))
  {
    CLONE(OBJ "ertrinken", TP);
  }
}
