// /d/dschungel/feyaria/kueste/room/ost_c6.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "norden"
#define DIR2 "suedosten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg. Die Sonne brennt vom Himmel "
    "herunter und bringt Dich zum Schwitzen. Im Norden befindet sich ein "
    "Strandhaus mitten am herrlich weissen Sandstrand. Dahinter erstreckt "
    "sich das weite Meer. Suedlich von Dir beginnt dann der Dschungel "
    "hinter einer Reihe von Palmen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"haus", "strandhaus"}),
    "Im Norden steht ein schoenes Strandhaus. Es hat eine romantische Lage "
    "so mitten am weiten Sandstrand. Naehrere Details kannst Du aber von hier "
    "noch nicht erkennen.");
  AddDetail( ({"lage"}),
    "Das Strandhaus hat wirklich eine romatische Lage. Du bist begeistert.");

  COMMANDS;

  AddExit( DIR1, "./ost_c5" );
  AddExit( DIR2, "./ost_d7" );

  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

