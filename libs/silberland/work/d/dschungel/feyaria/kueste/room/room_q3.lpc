// /d/dschungel/feyaria/kueste/room/room_q3.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "osten"
#define DIR2 "westen"

#include "../def.h"
#include "./kueste.h"

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor dem Stadttor von Tijara" );
  SetProp(P_INT_LONG,
    "Du stehst vor dem Stadttor von Tijara. Es ist die einzige Oeffnung in "
    "der Stadtmauer, durch die man hier die Stadt betreten kann. Nach "
    "Westen erstreckt sich der Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite liegt das Meer mit dem weissen Sandstrand "
    "und auf der anderen Seite eine Reihe von Palmen und dahinter der "
    "dichte Dschungel.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({ "tijara", "stadt", "osten" }),
    "Die Stadt Tijara befindet sich im Osten. Durch das Stadttor kannst Du "
    "sie betreten.");
  AddDetail( ({ "westen", "stadttor", "tor", "oeffnung"}),
    "Im Osten steht ein grosses Stadttor, durch das man die Stadt "
    "betreten kann. An das Tor schliesst sich eine kleine Stadtmauer an, "
    "die hier bis ins Meer hinein reicht. Das Tor ist, wie auch die "
    "Stadtmauer, aus grossen hellgrauen Steinbloecken erbaut.");
  AddDetail( ({ "stein", "steinblock", "steinbloecke", "block", "bloecke"}),
    "Die Steinbloecke sind aus hellgrauem, harten Stein, der sich ideal "
    "fuer Befestigungsbauten eignet.");
  AddDetail( ({ "befestigungen", "befestigungsbauten", "befestigung"}),
    "Zu Befestigungen zaehlt die Stadtmauer mit ihren grossen Toren.");
  AddDetail( ({ "mauer", "stadtmauer"}),
    "Die Stadtmauer ist aus grossen hellgrauen Steinbloecken erbaut und ist "
    "ca. 3 Meter hoch. Oben ist sie mit spitzen Holzpfloecken bestueckt, "
    "um ein Ueberklettern zu verhindern. Sie erstreckt sich nach Norden bis "
    "ins Meer hinein und nach Sueden in den Dschungel hinein. Nur das "
    "grosse Stadttor laesst eine Oeffnung frei, um die Stadt zu betreten.");
  AddDetail( ({ "holz", "pfloecke", "holzpfloecke", "spitzen", "spitze"}),
    "Die Holzpfloecke sind wirklich richtig spitz.");
  AddDetail( ({ "anblick" }),
    "Wirklich ein schoener Anblick. Geniesse ihn ruhig, hier gibt es "
    "wirklich viel zu sehen.");

  AddDetail( ({"weit", "darum", "am", "weisser", "meers", "sehen",
      "vielleicht", "zahlreiche", "danach", "nur", "bis", "noch", "ohne",
      "zwischen","sei", "aber", "hier", "aus", "diese", "nach", "auf",
      "durch", "zu", "an", "toren", "oben", "ueberklettern", "wirklich"}),
    "Feyaria teilt Dir mit: Hoer Auf, Sinnlose Details Zu Untersuchen !");
  AddDetail( ({"hoer", "auf", "sinnlose", "details", "zu", "untersuchen"}),
    "Der Tod teilt Dir mit: BALD SEHEN WIRD UNS WIEDER, WENN DU NICHT DAMIT\n"
    "Der Tod teilt Dir mit: AUFHOERST! UNTERSUCHESCRIPTS SIND HIER SCHLECHT\n"
    "Der Tod teilt Dir mit: FUER DEINE GESUNDHEIT!\n");
  AddSpecialDetail( ({"tod", "bald",  "wir", "uns", "wieder", "wenn",
      "nicht", "damit", "aufhoerst", "untersuchescripts", "sind", "schlecht",
      "fuer", "gesundheit", "jetzt", "musst", "fuer", "vergehen", "buessen"
      }),  "scriptfalle");

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  COMMANDS

  AddExit( DIR1, "nach Tijara#" + KUESTE_TIJARA );
  AddExit( DIR2, "./room_p3" );
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

string scriptfalle()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" untersucht < "+ TP->_unparsed_args()+
    " > in room_q3.\n");
  if( IS_SEER(TP) )
  {
    TP->do_damage(20+random(10) );
    return "Jetzt Musst Du Fuer Deine Vergehen Buessen!\n";
  }
  return "Sowas siehst Du nicht.\n";
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Scriptfalle in b5) "
               " -%d EP\n", lostexp) );
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
