// /d/dschungel/feyaria/kueste/room/room_k4.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "sueden"
#define DIR2 "nordwesten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp( P_INT_LONG, 
    "Du stehst hier am Nordwestrand einer kleinen Bucht. Das Wasser der "
    "Bucht ist sehr seicht und laedt zum Schwimmen ein. Neben dem "
    "Kuestenweg beginnt sofort wieder der dichte Dschungel, der nur wenige "
    "Schritte Einblick ermoeglicht.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "bucht", "nordwestrand" }), 
    "Die Bucht erstreckt sich hier weit nach Suedosten. Sicher kann man "
    "hier schoen baden.");
  AddDetail( ({"einblick", "schritte"}),
    "Der dichte Dschungel ermoeglicht nur wenige Schritte Einblick.");

  COMMANDS

  AddExit( DIR1, "./room_k5" );
  AddExit( DIR2, "./room_j3" );
}

BADEN_BUCHT
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN
