// /d/dschungel/feyaria/kueste/room/ost_l2.c
// Kueste im Osten von Tijara
// 1997-11-28 Feyaria@SilberLand

#define DIR1 "suedwesten"
#define DIR2 "osten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der von Suedwesten nach Osten "
    "fuehrt. Einige Krabben leben hier. Hinter einer Reihe von Palmen liegt "
    "der dichte Dschungel. Im Norden befindet sich ein herrlicher Sandstrand "
    "und dahinter die unendliche Weite des Meeres. Die Sonne brennt vom "
    "Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({"weite"}),
    "Das Meer erstreckt sich beinahe unendlich weit, du fragst Dich nur, "
    "wie weit.....");
  
  AddItem( KRABBE, REFRESH_DESTRUCT );

  COMMANDS;

  AddExit( DIR1, "./ost_k3" );
  AddExit( DIR2, "./ost_m2" );

  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

