// /d/dschungel/feyaria/kueste/room/room_i3.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "osten"
#define DIR2 "nordwesten"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite schweift Dein Blick in die unendlichen "
    "Weiten des Meeres, davor liegt ein weisser Sandstrand, an dem sich "
    "besonders viel Treibholz befindet. Auf der anderen Seite siehst Du "
    "eine Reihe von Palmen und dahinter den dichten Dschungel. Die Sonne "
    "brennt vom Himmel herunter und bringt Dich zum Schwitzen.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "anblick"}),
    "Der Anblick ist einfach malerisch.");
  AddDetail( ({ "weiten", "blick" }),
    "Du laesst Deinen Blick ueber die Weiten des Meeres schweifen.");
  
  AddDetail( ({"meer", "wellen", "brandung"}),
      "Weit draussen brechen sich die grossen Wellen an einem Riff. "
      "Darum gibt es hier an der Kueste nur noch kleine Wellen, die "
      "rauschend den schneeweissen Sandstrand hinauf rollen und wieder "
      "zurueck ins Meer fliessen. Am Tidensaum findet sich neben "
      "abgestorbenen Algen und Muschelschalen auch eine Menge Treibholz.");
  AddDetail( ({"algen", "tidensaum", "rand"}),
      "Ein Rand aus halbvermoderten Algen zeigt, wie hoch die "
      "hoechsten Wellen den Strand hinaufrollen. Auch einiges Treibholz "
      "wurde dort angeschwemmt.");
  AddDetail( ({"holz", "treibholz"}),
      "Das Treibholz besteht hauptsaechlich aus Aesten und Holzplanken, "
      "nur ein Besen faellt Dir besonders auf.");
  AddDetail( ({"ast", "aeste", "holzplanken", "planken", "holzplanke", 
        "planke"}),
      "Einfach nur Treibholz.");
  AddDetail( ({"besen"}),
      "Du phantasierst, dass das ein Hexenbesen sein koennte.");
  AddDetail( ({"hexenbesen"}),
      "Wenn das ein Hexenbesen waere, koennte man darauf reiten. "
      "Du verwirfst diese absurde Idee aber sofort wieder.");
  AddCmd( ({"reit", "reite", "flieg", "fliege"}), "cmd_reiten");  

  COMMANDS

  AddExit( DIR1, "./room_j3" );
  AddExit( DIR2, "./room_h2" );
  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

void reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

int cmd_reiten(string str)
{
  notify_fail("Worauf willst Du reiten?\n");
  if (str != "auf besen" && str != "auf hexenbesen")
    return 0;
  if (TP->QueryProp(P_LEVEL) < 45)
  {
    write(BS("Dir zittern die Haende, wenn Du daran denkst, dass die Hexe, "
          "der dieser Besen gehoert, Dich verfluchen koennte. Du beschliesst, "
          "es nochmal zu probieren, wenn Du staerker und mutiger geworden "
          "bist."));
    return 1;
  }
  write(BS("Du nimmst den Besen, setzt Dich darauf und ploetzlich verlierst "
        "Du den Boden unter den Fuessen. Es ist scheinbar wirklich ein "
        "echter Hexenbesen. Er steigt immer hoeher und fliegt mit Dir davon, "
        "hinaus aufs offene Meer."));
  TP->move(BESENRAUM + ":" + getuid(TP), M_TPORT);
  return 1;
}
