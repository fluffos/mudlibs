// /d/dschungel/feyaria/kueste/room/room_c5.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "nordosten"
#define DIR2 "westen"

#include "../def.h"
#include "./kueste.h"

inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite liegt das Meer mit dem weissen Sandstrand "
    "und auf der anderen Seite eine Reihe von Palmen und dahinter der "
    "dichte Dschungel. Die Sonne brennt vom Himmel herunter und bringt Dich "
    "zum Schwitzen. In den Sand sind viele kleine Loecher gegraben.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "anblick"}),
    "Der Anblick ist einfach malerisch.");
  AddDetail( ({ "loch", "loecher" }),
    "Irgendjemand hat hier viele kleine Loecher in den Sand gegraben. "
    "Was da wohl drinnen ist?");
  AddDetail( ({"boden", "sand"}),
    "Auf dem Boden sind viele kleine Loecher im Sand.");
  AddDetail( ({"schaufel"}),
    "Leider hast Du keine Schaufel. :-(\n");
  AddDetail( ({"schildkroete", "wasserschildkroete"}),
    "Sonst liegt hier immer eine Wasserschildkroete am Strand, aber jetzt "
    "ist sie nicht da. Vielleicht kommt sie spaeter wieder.");

  COMMANDS
  AddCmd( ({"greife", "greif"}), "greifen");
  AddCmd( ({"vergroessere", "vergroesser"}), "vergroessern");

  AddItem( WSK , REFRESH_DESTRUCT);

  AddExit( DIR1, "./room_d4" );
  AddExit( DIR2, "./room_b5" );
  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
}

int greifen(string str)
{
  notify_fail("Wohin willst Du greifen?\n");
  if( str == "in loch" )
  {
    write( BS("Du greifst in ein Loch, aber es ist zu eng. Vielleicht "
      "solltest Du es vergroessern.") );
    say( TPN+ " spielt im Sand.\n");
    return 1;
  }
  return 0;
}

int vergroessern(string str)
{
  notify_fail("Was willst Du vergroessern?\n");
  if( str == "loch" || str == "loecher" )
  {
    if( present("schaufel", TP) )
    {
       if( present("\nquestliste",TP) && !present("wasserschildkroetenei",TP) )
      {
        write( BS( "Du vergroesserst ein Loch und schaufelst den Sand "
          "beiseite. Tief im Sand findest Du Schildkroeteneier, von denen Du "
          "eines sofort einsteckst. Die uebrigen Eier vergraebst Du aber "
          "wieder, damit die armen Schildkroeten nicht aussterben.") );
        CLONE( "/d/dschungel/feyaria/felseninsel/obj/wsk_ei", TP);
      }
      else
        write( BS("Du vergroesserst ein Loch und schaufelst den Sand "
          "beiseite. Tief im Sand findest Du Schildkroeteneier, aber da Du "
          "gerade keine brauchst, schuettest Du das Loch wieder zu.") );
      say( CAP(TPN) + " buddelt im Sand herum.\n");
      return 1;
    }
    else
      notify_fail("Dazu brauchst Du schon eine Schaufel.\n");
  }
  return 0;
}
