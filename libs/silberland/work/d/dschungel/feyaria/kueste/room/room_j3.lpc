// /d/dschungel/feyaria/kueste/room/room_j3.c
// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "suedosten"
#define DIR2 "westen"

#include "../def.h"
#include "./kueste.h"
inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;
int lauer;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp( P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg, der einen malerischen Anblick "
    "bietet. Auf der einen Seite liegt das Meer mit dem weissen Sandstrand "
    "und auf der anderen Seite eine Reihe von Palmen und dahinter der "
    "dichte Dschungel. Die Sonne brennt vom Himmel herunter und bringt Dich "
    "zum Schwitzen. Besonders auffaellig sind aber die Spuren, die hier "
    "aus dem Dschungel an den Strand fuehren.");
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "anblick"}),
    "Der Anblick ist einfach malerisch.");
  AddDetail( ({ "spur", "spuren" }), 
    "Bei den Spuren scheint es sich um die Spur einer grossen Echse zu "
    "handeln.");
  AddDetail( ({ "echsenspur", "echsenspuren" }), 
    "Die Spur sieht wirklich wie eine Echsenspur aus. Allerdings handelt "
    "es sich hier um eine ziemlich grosse Echse.");
  AddDetail( ({ "echse" }),
    "Hier scheint eine grosse Echse manchmal an den Strand zu kommen. "
    "Wenn Du Dich auf die Lauer legst, kannst Du sie vielleicht einmal "
    "beobachten.");
  AddDetail( ({"lauer"}),
    "Leg dich doch auf die Lauer, wenn Du die Echse sehen willst.");

  COMMANDS

  AddExit( DIR1, "./room_k4" );
  AddExit( DIR2, "./room_i3" );
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = random(3);
  }

  AddCmd("lege", "lauerlegen");
}

reset()
{
  ::reset();
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = random(3);
  }
  if( lauer && !random(5) )
  {
    echse_kommt();
    lauer=0;
  }
  lauer=1;
}

void echse_remove()
{
  object echse, schwanz;
  if( echse=present("gelbschwanzechse") )
  {
    tell_room( TO, BS( "Die dreikoepfige Gelbschwanzechse trappelt zurueck "
                       "ins Dickicht.") );
    if( schwanz=present("schwanz", echse) )
      schwanz ->remove();
    echse->remove();
  }
}

BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

int lauerlegen(string str)
{
  notify_fail("Lege wie wo was wann warum wieso weshalb bitte?\n");
  if(str!="lauer" && str!="auf lauer")
    return 0;
  write("Du legst Dich auf die Lauer und wartest, dass die Echse kommt.\n");
  if( lauer && !random(5) )
    call_out("echse_kommt",10);
  lauer=0;
  return 1;
}  

void echse_kommt()
{
   clone_object( NPC "3kgse" ) ->move( TO, M_TPORT);
}

