// Kueste im Westen von Tijara
// 29-11-96  Feyaria@SilberLand

#define DIR1 "osten"
#define DIR2 "suedwesten"

#include "../def.h"
#include "./kueste.h"
#include "/d/huegelland/feyaria/osterhase/oh.h"

inherit "std/room";

int kokospalme, kokosnuss;
int kajubo, kajuboknospen, kajubo_gefunden;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Kuestenweg" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf dem Kuestenweg. Im Norden liegt ein weisser "
    "Sandstrand und dahinter das Meer, ueber dessen Weiten Du Deinen Blick "
    "schweifen laesst. Im Sueden steht eine Reihe von Palmen und dahinter "
    "der dichte Dschungel. Der Himmel ueber Dir scheint hier viel niedriger "
    "zu sein als anderswo. Auch die Sonne scheint hier viel naeher zu sein, "
    "denn sie brennt unbarmherzig herab und bringt Dich ganz schoen zum "
    "Schwitzen.");
  SetProp(P_LIGHT, 3 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 39, ENV_TERRAIN:TT_JUNGLE]) );

  KUESTE
  WETTER
  PALMEN
  PFLANZEN

  AddDetail( ({ "weiten", "blick" }),
    "Du laesst Deinen Blick ueber die Weiten des Meeres schweifen.");
  AddDetail( ({"himmel"}), 
    "Der Himmel hat eine herrliche himmelblaue Farbe und ist Dir naeher "
    "als irgendwoanders. Er ist sozusagen zum Greifen nah. Auch die Sonne "
    "strahlt hier intensiver als sonstwo.");
  AddSpecialDetail( ({"sonne", "gelb"}), "blind");
  AddDetail( ({"himmelblau", "himmelblaue farbe"}),
    "Eine schoenere himmelblaue Farbe gibt es nirgends im ganzen SilberLand.");
  AddDetail( ({"farbe", "farben"}),
    "Hier gibt es viele Farben: Der Sand ist weiss, das Meer ist gruenblau, "
    "die Palmen sind gruen, der Himmel hat eine herrliche, himmelblaue Farbe "
    "und die Sonne glueht in einem erschreckend grellem Gelb.");
  AddDetail(({"gruen", "gruenblau"}),
    "Die Palmen sind gruen, das Meer hingegen ist gruenblau.");
  AddDetail( ({"leiter", "hilfsmittel"}),
    "Mit Hilfe einer Leiter koenntest Du vielleicht bis in den Himmel greifen.");  
  COMMANDS
  AddCmd( ({"greif", "greife"}), "greifen");

  AddExit( DIR1, "./room_o4" );
  AddExit( DIR2, "./room_m5" );
  if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}


BADEN
LIEGEN
GRABEN
KLETTERN
SUCHEN
PFLUECKEN

reset()
{
  ::reset();
  if( kokospalme )
  {
    NOKOKOS
  }
  else if( !random(RANDOM_KOKOS) )
  {
    KOKOS
  }
  if( kajubo_gefunden )
  {
    NOKAJUBO
  }
  else if( !random(RANDOM_KAJUBO) )
  {
    kajubo=1;
    kajuboknospen = 1+random(2);
  }
}

int greifen(string str)
{
  object ob;

  notify_fail("Wohin willst Du greifen?\n");
  if(!str) return 0;
  if (str=="in himmel" || str=="himmel" || str=="nach blau" || 
      str=="nach himmelblau" || str=="nach blauer Farbe" ||
      str=="nach himmelblaure farbe")
  {
    if( present("leiter", TP) )
    {
      write("Du stellst die Leiter auf und kletterst in den Himmel.\n");
      say(CAP_TPN+ " stellt eine Leiter ab und klettert in den Himmel.\n");
      if( ob=present( OSTERHASENQUEST_ID, TP) )
      {
        if( ob->query_color("blau") )
        {
          write(BS(
            "Du greifst in den Himmel und willst Dir ein Stueck "
            "himmelblauer Farbe mitnehmen, aber die Farbe hast Du ja schon "
            "in Deinem Farbkasten."));
        }
        else
        {
          write(BS(
            "Du greifst in den Himmel und hast ploetzlich ein Stueck "
            "himmelblauer Farbe in der Hand, die Du sofort in Deinen "
            "Farbkasten steckst."));
          ob->set_color("blau");
        }
      }
      else
      {
        write( BS("Du kletterst mit der Leiter noch naeher zum Himmel, kannst "
          "aber den Himmel trotzdem nicht fassen."));
      }
    }
    else
    {
      write("Du versuchst, den Himmel zu greifen, aber er ist doch zu hoch.\n"+
        "Vielleicht kannst Du es ja mit einem Hilfsmittel schaffen.\n");
      say(CAP_TPN+" versucht in den Himmel zu greifen, ist aber zu klein.\n");
    }
    return 1;
  }
  return 0;
}

string blind(string str)
{
  TP->SetProp(P_BLIND,40);
  call_out("augen",30);
  return BS("Du schaust mitten in die Sonne und wirst von der gleissenden "
            "Helligkeit geblendet.");
}

void augen()
{
  write("Deine Augen schmerzen immer noch.\n");
  call_out("augen2",30);
}

void augen2()
{
  TP->SetProp(P_BLIND,0);
  write( BS("Die Schleier vor Deinen Augen lichten sich wieder. Zum Glueck "
    "hast Du keine dauerhaften Schaeden davongetragen. So schnell wirst Du "
    "nicht mehr direkt in die Sonne schauen.") );
}

