#include <properties.h>
#include "../def.h"
#include <moving.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor der Huette des Einsiedlers Ogiron" );
  SetProp(P_INT_LONG, 
            "Du stehst hier vor der \"Huette\" des Einsiedlers Ogiron. "
            +"Obwohl diese Behausung eher ein Zelt denn ein Huette ist. "
            +"Rings um diesen Ort ist der Dschungel, welcher hier "
            +"absolut undurchdringlich erscheint. Hier kommt man selbst "
            +"mit den schaerfsten Macheten nicht weiter. Von ueberall "
            +"hoert man zudem unheimliche Geraeusche.\n"); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:35, ENV_TERRAIN:TT_JUNGLE]));
  
  // DETAILS
  AddDetail(({"machete", "macheten"}),
            "Selbst mit den schaerfsten Macheten wuerdest Du hier nicht "
            +"durch den Dschungel kommen.\n");
  AddDetail(("himmel"),
            "Die Sonne brennt vom blauen Himmel auf Dich herab. "
            +"Na hoffentlich holst Du Dir hier keinen Sonnenbrand.\n");
  AddDetail(("sonne"),
            "Unbarmherzig brennt die Sonne von oben auf Dich herab. "
            +"Hoffentlich holst Du Dir keinen Sonnenbrand.\n");
  AddDetail(("sonnenbrand"),
            "Oje, zu spaet. Du spuerst ihn jetzt schon. AUA !!!\n");
  AddDetail(("boden"),
            "Der Boden besteht hier nur aus Erde, wie als wuerde "
            +"sich der Dschungel von diesem Ort abgrenzen.\n");
  AddDetail(("erde"),
            "Die Erde ist ausgetrocknet und hellbraun.\n");
  AddDetail(({"ort", "heim"}),
            "Dieser Ort ist das Heim von Ogiron dem Einsiedler.\n");
  AddDetail(("einsiedler"),
            "Hier wohnt der Einsiedler Ogiron.\n");
  AddDetail(("ogiron"),
            "Ogiron ist wahrscheinlich in seiner Huette. Vielleicht "
            +"solltest Du ihm einen Besuch abstatten.\n");
  AddDetail(("dschungel"),
            "Rings um Dich herum ist undurchdringlicher Dschungel. "
            +"Interessanterweise hoert er immer kurz vor der Huette "
            +"komplett auf.\n");
  AddDetail(("besuch"),
            "Allzuoft duerfte Ogiron eh keinen Besuch bekommen.\n");
  AddDetail(({"huette", "zelt", "behausung", "namen", "name"}),
            "Die Huette verdient den Namen \"Huette\" ja eigentlich "
            +"nicht. Es ist mehr ein komplexeres Zelt, aus Stoff und "
            +"einer seltsamen Holzkonstruktion.\n");
  AddDetail(("stoff"),
            "Der weisse Stoff hat teilweise schon Loecher, also bei "
            +"Regen bringt der sicher nicht mehr viel.\n");
  AddDetail(("loecher"),
            "In dem Stoff der Huette sind genug davon.\n");
  AddDetail(({"konstruktion", "holzkonstruktion", "fall"}),
            "Die Holzkonstruktion der Huette sieht etwas wackelig aus "
            +"scheint aber doch einigermassen stabil zu sein. In jedem "
            +"Fall ist diese Konstruktion nicht zur Nachahmung zu "
            +"empfehlen.\n");
  AddDetail(("nachahmung"),
            "Nein, nachahmen sollte man sowas sicher nicht.\n");
  AddDetail(("regen"),
            "Nach Regen sieht es derzeit aber eher nicht aus.\n"); 
  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
            "Du hoerst von ueberall unheimliche Geraeusche, die "
            +"duerften wohl von den Dschungelbewohnern stammen.\n");
  AddSound(({"dschungelbewohner", "bewohner"}),
            "Ein paar davon hoeren sich echt unfreundlich an.\n");
  AddDetail(({"dschungelbewohner", "bewohner"}),
            "Den Geraeuschen nach zu urteilen duerften da einige "
            +"Dschungelbowohner nicht allzu fern sein. Und sie "
            +"hoeren sich teils nicht sehr freundlich an.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "dschungel"}),
            "Der typische Geruch des Dschungels.\n");

  // EXITS  

  AddExit( "norden", ROOM+"einsiedlerhuette"); 

 // ITEMS

 // COMMANDS

}
