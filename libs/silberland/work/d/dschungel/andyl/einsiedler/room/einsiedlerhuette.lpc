#include <properties.h>
#include "../def.h"
#include <moving.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Huette von Ogiron" );
  SetProp(P_INT_LONG,
                    "Du befindest Dich hier in der Huette des "
                    +"Einsiedlers Ogiron. Sie ist nicht viel mehr "
                    +"als ein groesseres Zelt. Die Waende und die Decke "
                    +"sind aus einer wackeligen Holzkonstruktion "
                    +"welche mit Stoff ueberzogen wurde. Am Boden "
                    +"liegt etwas Stroh und in einer der Ecken liegen ein "
                    +"Stofffetzen und ein Strohsack. Ansonsten faellt Dir "
                    +"nur ein grosser Fels an der Nordwand auf, auf "
                    +"welchem Schriftzeichen und eine seltsam geformte "
                    +"Einbuchtung sind.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  
  // DETAILS

  AddDetail(({"ecke", "ecken"}),
         "In einer der Ecken liegt ein Strohsack und ein paar "
         +"Stofffetzen.\n");
  AddDetail(({"strohsack", "stofffetzen", "schlafplatz"}),
          "Der Strohsack und die Stofffetzen duerften wohl der "
          +"Schlafplatz von Ogiron sein.\n"); 
  AddDetail(({"huette", "zelt"}),
          "Die Huette von Ogiron ist nicht viel mehr als ein "
          +"groesseres Zelt.\n");
  AddDetail(("einsiedler"),
          "Ogiron ist ein Einsiedler, sprich: er lebt hier ganz "
          +"allein.\n");
  AddDetail(("ogiron"),
          "Der scheint gerade nicht hier zu sein.\n"); 
  AddDetail(("boden"),
         "Auf dem Boden aus trockener, hellbrauner Erde liegt jede "
         +"Menge Stroh.\n");
  AddDetail(("erde"),
         "Trockene, hellbraune Erde.\n");
  AddDetail(({"stroh", "menge"}),
         "Hier liegt echt eine ganze Menge an Stroh auf dem Boden.\n");
  AddDetail(("decke"),
         "Die Decke ist aus Stoff welcher von der Holzkonstruktion "
         +"gestuetzt wird. Viele Loecher sind in dem Stoff.\n");
  AddDetail(("loecher"),
         "Naja, solange es nicht regnet, sind die Loecher eh egal.\n");
  AddDetail(("stoff"),
         "Der Stoff war urspruenglich mal weiss, aber jetzt ist er schon "
         +"ziemlich dreckig und ist jetzt graubraun.\n");
  AddDetail(({"waende", "wand", "besonderes"}),
         "Die Waende sind aus Stoff gestuetzt von der Holzkonstruktion. "
         +"Einzig an der Nordwand kannst Du was Besonderes erkennen.\n");
  AddDetail(({"nordwand", "felsen", "fels"}),
         "An der Nordwand steht ein grosser grauer Felsen, auf welchem "
         +"allerlei Schriftzeichen stehen und eine seltsam "
         +"geformte Einbuchtung zu finden ist.\n");
  AddDetail(({"schriftzeichen", "zeichen"}),
         "Du koenntest versuchen sie zu lesen.\n");
  AddReadDetail(({"schriftzeichen", "zeichen"}),
         "Du kannst sie leider nicht entziffern, aber vielleicht "
         +"weiss ja Ogiron mehr darueber.\n");
  AddDetail(("einbuchtung"),
         "Die Einbuchtung hat ein seltsame Form. Man koennte da "
         +"ja eventuell was reinlegen.\n");
  AddDetail(("form"),
         "Wirkt leicht deltoidfoermig, its es aber nicht ganz.\n");
  AddDetail(({"holz", "konstruktion", "holzkonstruktion"}),
         "Sehr vertrauenserweckend sieht diese Holzkonstruktion "
         +"ja nicht aus. Da sollte wohl besser keiner daran ruetteln.\n"); 
  AddSound( ({DEFAULT_SOUND}),
            "Du hoerst die Geraeusche der umliegenden Dschungelbewohner.\n");
  AddSound(({"dschungelbewohner", "geraeusche"}),
            "Manche davon hoeren sich nicht gerade sehr freundlich an.\n");
  AddSmell( ({DEFAULT_SMELL, "stroh", "dreck"}),
            "Riecht nach Stroh und Dreck hier.\n");
  // EXITS  

  AddExit( "sueden", ROOM+"voreinsiedler"); 

 // ITEMS

 // COMMANDS

 AddCmd(("ruettel"), "ruettel_an"); 
 AddCmd(({"leg", "lege"}), "lege_in");
}

ruettel_an(str)
{
  notify_fail(BS("Woran willst Du ruetteln?\n"));
  if (!str) return 0;
  if ((str == "an holz" || str == "an konstruktion" || 
       str == "an holzkonstruktion" || str == "holz" ||
       str == "konstruktion" || str == "holzkonstruktion"))
     {
       write(BS("Die Huette bricht zusammen, das hast Du ja toll "
               +"gemacht.\n"));
       // Spieler in anderen Raum moven und dort exit removen
       // Ogiron ordentlich fluchen lassen (sofern vorhanden) 
       // und das zelt wieder aufbaun lassen.... 
       return 1;
     }
  else return 0;
}

lege_in(str)
{
   notify_fail(BS("Was willst Du in was legen?\n"));
   if (!str) return 0;
 
   // Hier Funktion zum drachenschuppenreinlegen einbaun.... 
   
   write(BS("gibts no nix.\n")); 
   return 1;
}
