#include <properties.h>
#include "../def.h"
#include <moving.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Huette der weisen Kaomu" );
  SetProp(P_INT_LONG,
   "Du befindest Dich hier in der Huette der weisen Elfe Kaomu. Sie "
   +"ist aeusserst schlicht eingerichtet. In einer Ecke steht ein Bett, "
   +"in der Mitte des Raumes steht ein Tisch und zwei Sessel, an der "
   +"Ostwand steht ein kleines Buecherregal und ein kleiner Kasten steht "
   +"noch an der Nordwand. Direkt ueber dem Kasten haengt ausserdem ein "
   +"kleines Schild. Durch ein Fenster in der Suedwand strahlt die "
   +"Sonne herein und vermittelt so dem Raum einen sehr freundlichen "
   +"Eindruck. Durch ein Tuer im Westen, welche nur aus einem Vorhang "
   +"besteht, gelangt man wieder zurueck ins Dorf.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_TOWN]));
  
  // DETAILS

  AddDetail(({"waende", "wand", "stangen", "bambusstangen"}),
            "Die Waende bestehen aus Bambusstangen die mit einigen Flechten "
            +"verwoben sind.\n");
  AddDetail(({"elfe", "kaomu"}),
            "Kaomu scheint gerade nicht da zu sein.\n");
  AddDetail(("tuer"),
            "Durch die Tuer kommst Du wieder zurueck ins Dorf.\n");
  AddDetail(({"vorhang", "prinzip"}),
            "Ein hellgruner Vorhang. Vom Prinzip bildet er die "
            +"Tuer.\n");
  AddDetail(("dorf"),
            "Wenn Du durch die Tuer gehst, kannst Du das Dorf ja naeher "
            +"untersuchen.\n");
  AddDetail(("ostwand"), 
            "Da steht ein kleines Buecherregal.\n");
  AddDetail(("nordwand"),
            "An der Nordwand steht ein kleiner Kasten.\n");
  AddDetail(("suedwand"),
            "In die Suedwand ist ein Fenster eingelassen.\n");
  AddDetail(("ecken"),
            "In einer der vier Ecken des Raumes steht ein Bett.\n");
  AddDetail(({"eck", "ecke"}),
            "In der Ecke steht ein Bett.\n");
  AddDetail(({"bett", "meiste"}),
            "Wie das Meiste hier im Raum ist auch das Bett aus Bambus "
            +"gebaut. Es sieht, obwohl sehr schlicht gebaut, sehr gemuetlich "
            +"aus.\n"); 
  AddDetail(({"bambus", "grossteil", "sachen"}),
            "Ein Grossteil der Sachen hier ist aus Bambus gebaut.\n"); 
  AddDetail(({"raum", "huette"}),
            "Du stehst hier in der Huette der weisen Elfe Kaomu. Sie "
            +"ist aeusserst schlicht eingerichtet aber zweckmaessig.\n");  
  AddDetail(("kasten"),
            "Ein kleiner Kasten aus Bambus. Er scheint keine Kastentuer "
            +"oder aehnliches zu besitzen. Wofuer der dann wohl gut ist?\n");
  AddDetail(({"kastentuer", "art"}),
            "Es scheint nichts in der Art an dem Kasten zu sein. Seltsam.\n");
  AddDetail(("schild"),
            "Du kannst es lesen.\n");
  AddReadDetail(("schild"),
            " +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+\n"
           +" |                                     |\n"
           +" | HIER SOLLS MAL TRAENKE ZU KAUFE     |\n"
           +" | GEBEN.                              |\n"
           +" | syntax <kaufe trank>                |\n"
           +" |                                     |\n"
           +" +-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+\n"); 
  AddDetail(("flechten"),
            "Damit sind die Bambusstangen der Waende verwoben.\n");
  AddDetail(("decke"),
            "Das Strohdach der Huette bildet die Decke.\n");
  AddDetail(({"dach", "strohdach"}),
            "Das Dach besteht aus einfachen Strohbuendeln. Einfach "
            +"aber zweckmaessig.\n");
  AddDetail(({"strohbuendeln", "strohbuendel", "buendel", "buendeln"}),
            "Gebuendeltes Stroh. Damit wuerde das Dach der Huette "
            +"gemacht.\n");
  AddDetail(("stroh"),
            "Hellbraunes Stroh welches zu Buendeln zusammengebunden "
            +"wurde.\n");
  AddDetail(({"boden", "holzbretter"}),
            "Der Boden besteht aus einfachen Holzbrettern auf denen "
            +"ein paar Reisstrohmatten liegen.\n");
  AddDetail(({"matten", "reisstrohmatten"}),
            "Die Reisstrohmatten sind einfach gefertigt, aber "
            +"es geht sich sehr angenehm auf ihnen.\n");
  AddDetail(("mitte"), 
            "In der Mitte des Raumes stehen ein Tisch und zwei Sessel.\n");
  AddDetail(({"tisch"}),
            "Der Tisch ist sehr schlicht und aus Bambus gefertigt. "
            +"Zwei Sessel stehen bei ihm.\n");
  AddDetail(("sessel"),
            "Wie auch der Tisch sind auch die Sessel aus Bambus gefertigt "
            +"und sehr schlicht. Sie sehen trotzdem nicht unbequem aus.\n");
  AddDetail(({"regal", "buecherregal"}),
            "In dem Regal sind einige Buecher zu sehen, leider kannst Du "
            +"nicht genau erkennen um was fuer Buecher es sich handelt, "
            +"da sie in einer Sprache geschrieben sind, welche Du nicht "
            +"kennst.\n");
  AddDetail(("buecher"),
            "Da sind einige Buecher im Buecherregal. Leider kannst Du sie "
            +"nicht lesen, da Dir die Sprache in der sie geschrieben sind "
            +"unbekannt ist.\n");
  AddDetail(("sprache"),
            "Die Sprache, in welcher die Buecher geschrieben sind, ist Dir "
            +"voellig unbekannt.\n");
  AddDetail(({"fenster", "oeffnung"}),
            "Das Fenster ist nicht viel mehr als eine quadratische Oeffnung "
            +"in der Suedwand. Durch das Fenster scheint die Sonne herein "
            +"und verleiht der Huette einen sehr freundlichen Eindruck.\n");
  AddDetail(("sonne"),
            "Die Sonne scheint durch das Fenster herein und verleiht dem "
            +"Raum einen sehr freundlichen Eindruck.\n");
  AddDetail(("eindruck"),
            "Die hereinscheinende Sonne verleiht dem Raum einen uebraus "
            +"freundlichen Eindruck.\n");   
  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
            "Du hoerst ein leises Rauschen unter Dir.\n");
  AddSound(("rauschen"),
            "Das Rauschen unter Dir stammt wohl von dem Wasser "
            +"des Sees auf dem die Huette gebaut ist.\n");	
  AddDetail(({"wasser", "see"}),
            "Direkt unter der Huette ist der See.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
            "Es riecht hier vor allem nach Wasser und Bambus.\n");
  AddSmell(({"wasser", "wassergeruch"}),
            "Der Wassergeruch kommt vom See zu Dir herauf.\n");
  AddSmell(("bambus"),
            "Riecht eindeutig nach... Bambus, wie nicht "
            +"anders zu erwarten.\n");

  // EXITS  

  AddExit( "westen", "/d/dschungel/feyaria/dorf/room/dorf-009.lpc"); 

 // ITEMS

 // COMMANDS

 AddCmd(({"kauf", "kaufe"}), "kaufe_was");
 AddCmd(({"verkauf", "verkaufe"}), "verkaufe_was"); 

}

kaufe_was(str)
{
  notify_fail(BS("Was willst Du kaufen?\n"));
  if (!str) return 0;
  else 
    {
      // DA NOCH KAUFFUNKTION EINBAUN
      write(BS("derzeit gibts hier no nix. spaeter mal.\n")); 
      return 1;
    }
  return 0;
}

verkaufe_was(str)
{
  notify_fail(BS("Was willst Du verkaufen?\n"));
  if (!str) return 0;
  else
   {
      // Abfrage ob Kaomu da...
      write(BS("Kaomu meint: Tut mir leid, aber ich kaufe nichts an.\n"));
      return 1;
   }
 return 0;
}
