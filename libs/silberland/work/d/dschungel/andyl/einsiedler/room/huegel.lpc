#include <properties.h>
#include "../def.h"
#include <moving.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

int opossum=1;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem kleinen Huegel im Dschungel" );
  SetProp(P_INT_LONG, 
            "Du stehst hier auf einem kleinen Huegel mittem im Dschungel. "
            +"Auffaellig ist eine Felsformation direkt nördlich von "
            +"hier. Der Boden ist mit verschiedenen Graesern und Farnen "
            +"bedeckt. Am Fusse des Huegels ist ueberall dichtester "
            +"Dschungel. Ein holpriger Weg fuehrt zurueck nach Suedwesten "
            +"in den Dschungel zurueck.\n"); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:35, ENV_TERRAIN:TT_JUNGLE]));
  
  // DETAILS
  AddDetail(("fuss"),
           "Am Fusse des Huegels ist ringsherum dichtester Dschungel.\n");
  AddDetail(("dschungel"),
           "Dichtester Dschungel, in dem Du lieber keine allzulange "
           +"Zeit verbringen willst.\n");
  AddDetail(("zeit"),
           "Viel Zeit willst Du sicher nicht im dichtesten Dschungel "
           +"verbringen.\n");
  AddDetail(("weg"),
           "Der holprige Weg fuehrt zurueck nach Suedwesten.\n");
  AddDetail(("felsformation"), 
           "Die Felsformation erinnert Dich irgendwie an ein "
           +"grosses vogelaehnliches Wesen.\n");
  AddDetail(("wesen"),
           "Uberleg mal welche vogelaehnlichen Wesen "
           +"Dir einfallen!\n");
  AddDetail(("form"),
           "Die Form der Felsformation erinnert Dich an ein "
           +"vogelaehnliches Wesen.\n");
  AddDetail(("sonne"),
           "Die Sonne strahlt vom Himmel auf Dich herab. Puh, "
           +"ganz schoen heiss.\n");
  AddDetail(({"huegel"}),
           "Der Huegel ist nicht sehr gross und ist ueber und ueber mit "
          +"Graesern und Farnen bedeckt. Auf ihm siehst Du auch eine "
           +"auffaellige Felsformation.\n");
  AddDetail(("boden"), 
           "Der Boden ist ueber und ueber mit Graesern und Farnen "
           +"bedeckt. Du hoffst, dass da keine giftigen Tiere drinnen "
           +"versteckt sind.\n");
  AddDetail(("tiere"),
           "Giftigen Tiere wie Schlangen, Spinnen und so.\n");
  AddDetail(({"schlangen", "spinnen", "glueck"}),
           "Zum Glueck keine zu entdecken.\n");
  AddDetail(("graeser"),
           "Verschiedenste Graeser welche jedoch alle gruen sind.\n");
  AddDetail(("farne"),
           "Grosse Farne, kleine Farne, kurz: verschiedenste Farne kannst "
           +"Du hier entdecken. Hinter einem groesseren Farn glaubst Du "
           +"etwas entdeckt zu haben.\n");
  AddSpecialDetail(("farn"), "farn_schau"); 
  AddDetail(("himmel"),
           "Die Sonne strahlt vom Himmel auf Dich herunter und da und "
           +"dort siehst Du ein paar weise Wolken.\n");
  AddDetail(({"wolken", "wolke"}),
           "Als Du die Wolken beobachtest, faellt Dir ein schwarzer "
           +"Punkt auf.\n");
  AddDetail(("punkt"),
           "Jetzt ist er ploetzlich hinter einer Wolke verschwunden. "
           +"Was das wohl gewesen ist?\n");
  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
            "Du hoerst von ueberall die Geraeusche, der "
            +"verschiedensten Dschungelbewohnern. Ein leises "
            +"Piepsen faellt Dir besonders auf.\n");
  AddSound(({"dschungelbewohner", "bewohner"}),
            "Die duerften da ziemlich zahlreich sein.\n");
  AddSound(({"piepsen", "tru-tru", "tru"}),
            "Du lauscht und hoerst ein leises: Tru-Tru !\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "dschungel"}),
            "Der typische Geruch des Dschungels.\n");

  // EXITS  

  AddExit( "suedwesten", "/d/dschungel/dante/weg/room/weg14.lpc"); 

 // ITEMS

 // COMMANDS

}

farn_schau()
{
  if (opossum == 1)
      {
         opossum=0; 
  
         // HIER OPOSSUM CLONEN     
 
         return("Als Du den Farn untersuchst, huepft ploetzlich ein kleines "
               +"ein kleines suesses Opossum hinter ihm hervor und fiept: "
               +"Tru-Tru!\n"); 
      }
   else return("Du untersuchst den Farn, findest aber nichts.\n");
} 


void reset()
{
  ::reset();
  opossum=1;
}
