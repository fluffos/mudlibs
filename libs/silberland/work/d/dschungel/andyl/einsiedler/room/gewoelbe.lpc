#include <properties.h>
#include "../def.h"
#include <moving.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem unterirdischen Gewoelbe" );
  SetProp(P_INT_LONG,
                    "Du befindest Dich hier in einem unterirdischen "
                    +"Gewoelbe. Ein Lichtkegel leuchtet "
                    +"in der Mitte des Raumes und taucht das Gewoelbe "
                    +"in ein geheimnisvolles blaues Licht. Ueberall sind "
                    +"kleine Wasserrinnsale, welche ein leises Plaetschern "
                    +"von sich geben. Die Felswaende sind uneben und mit "
                    +"Moos, Efeu und anderen Kletterpflanzen bedeckt. "
                    +"Alles in allem ein sehr beeindruckender Anblick.\n");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));
  
  // DETAILS
  AddDetail(("fels"),
           "Normaler hellgrauer Fels.\n");
  AddDetail(("mitte"),
           "In der Mitte des Gewoelbes ist ein geheimnisvoller "
           +"Lichtkegel.\n");
  AddDetail(({"boden", "Felsboden"}),
           "Ueberall am Felsboden haben sich zahlreiche Pfuetzen "
           +"gebildet.\n");
  AddDetail(("anblick"),
           "Ein sehr beeindruckender Anblick, fast schon "
           +"ueberwaeltigend.\n");
  AddDetail(({"lichtkegel"}),
           "Der Lichtkegel besteht aus vier blaulich schimmernden Ringen "
           +"welche in der Luft schweben. Ob man den Lichtkegel vielleicht "
           +"betreten kann?\n");
  AddDetail(({"ringe", "luft"}),
           "Die vier Ringe schweben in der Luft und geben ein "
           +"blaeuliches Licht ab.\n");
  AddDetail(("licht"),
           "Ein geheimnisvolles blaues Licht welches das Gewoelbe "
           +"ausleuchtet.\n");
  AddDetail(("raum"),
            "Dieser Raum ist ein grosses Gewoelbe.\n");
  AddDetail(({"gewoelbe", "auge"}),
            "Du stehst hier in einem beeindruckenden Gewoelbe. Vor "
            +"allem der Lichtkegel in der Mitte des Gewoelbes "
            +"sticht Dir ins Auge.\n");
  AddDetail(("decke"),
            "Die Decke ist aus hellgrauem Fels. Wasser tropft von ihr "
            +"herunter.\n");
  AddDetail(({"wasser"}),
            "Wasser ist hier ueberall zu finden. Da tropft es von der "
            +"Decke, dort siehst Du kleine Pfuetzen und ueberall sind "
            +"kleinere Rinnsale.\n");
   AddDetail(("pfuetzen"),
            "Die vielen kleinen Rinnsale sammeln sich in vielen kleinen "
            +"Pfuetzen, sodass man jetzt besser aufpassen sollte wo man "
            +"seinen Fuss als naechstes hinsetzt.\n");
   AddDetail(("fuss"),
            "Zu spaet, jetzt stehst Du mit einem Bein in einer der Pfuetzen "
            +"und bist klitschnass.\n");
   AddDetail(("bein"),
            "Alles voellig durchnaesst.\n");
   AddDetail(({"rinnsale", "wasserrinnsale"}),
            "Ueberall an den Waenden und der Decke siehst Du die kleinen "
            +"Rinnsale, welche vor sich hinplaetscheren.\n");
   AddDetail(({"felswaende", "felswand", "waende", "wand"}),
            "Die Felswaende sind mit Moos, Efeu und anderen Kletterpflanzen "
            +"bedeckt.\n");
   AddDetail(({"moos", "auffaelliges"}),
            "Das Moos ist ueberall an den Waenden zu finden. Aber etwas "
            +"Auffaelliges entdeckst Du daran nicht.\n");
   AddDetail(({"efeu", "verwuchs"}), 
            "Ueberall rankt sich der Efeu die Felswaende hoch und bildet "
            +"so zusammen mit anderen Kletterpflanzen einen dichten "
            +"Verwuchs.\n");   
  AddDetail(({"kletterpflanzen", "pflanzen"}),
            "Die meisten dieser Kletterpflanzen kennst Du nicht. "
            +"Jedoch faszinieren Dich die purpuren Blaetter einer "
            +"der Pflanzen.\n");
  AddDetail(("blaetter"),
            "Fasziniert untersuchst Du die tiefpurpuren Blaetter "
            +"als Dir ploetzlich hinter einem Blatt eine verdeckte "
            +"Nische in der Wand auffaellt.\n"); 
  AddDetail(("blatt"),
            "Hinter dem Blatt ist eine Nische.\n");
  AddSpecialDetail(("nische"), "nische_schau");
  AddSound( ({DEFAULT_SOUND}),
            "Du hoerst ueberall ein sanftes Plaetschern.\n");
  AddSound(("plaetschern"),
            "Das Plaetschern stamm von den vielen Rinnsalen hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
            "Es riecht hier nach Moos und Wasser kombiniert mit dem "
            +" typischen Hoehlengeruch.\n");
  AddSmell(("wasser"),
            "Riecht eindeutig nach Wasser.\n");
  AddSmell(("moos"),
            "Unverkennbar, der Geruch von Moos.\n");
  AddSmell(("hoehlengeruch"),
            "Riecht etwas muffig.\n");            
  // EXITS  

 // ITEMS

 // COMMANDS

 AddCmd(({"betrete", "betritt"}), "betritt_was"); 
}

nische_schau()
{
   // FUER BARDEN ABFRAGE EINBAUN
   // DIE RESTLICHEN SEHEN DORT FOLGENDES:
   return("Enttaeuscht stellst Du fest, dass es "
          +"in der Nische nichts zu finden gibt.\n");
}


betritt_was(str)
{
  notify_fail(BS("Was willst Du betreten?\n"));
  if (!str) return 0;
  if ((str == "kegel" || str == "lichtkegel")) 
     {
       write(BS("Du warpst aus dem Raum heraus.\n"));
       // Spieler in anderen Raum moven (Einsiedler) und noch
       // ne Abfrage fuer Barden einbaun....     
       return 1;
     }
  else return 0;
}

