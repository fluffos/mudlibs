// palme 

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <mordef.h>

int kokos;
create()
{
  ::create();
kokos = 1;
  SetProp( P_INT_SHORT, "Bei einer grossen, schraegen Palme" );
  SetProp( P_INT_LONG, BS(
    "Du stehst hier direkt unter einer grossen, irgendwie doch seltsam "
    "anmutenden Palme. Ringsum Dich sieht man sonst nichts als den "
    "dichtesten Dschungel. Im Sueden rauscht in der Tiefe ein gewaltiger "
    "Fluss und im Norden kann man einen kleinen Tafelberg erkennen. "
    "Der Weg, der am Rande der Schlucht entlangfuehrt, liegt im Nordwesten."));
    AddDetail(("weg"),
    "Der Weg endet hier und fuehrt zurueck an den Rand der Schlucht.");
    AddDetail(("nordwesten"),
    "Im Nordwesten liegt die Schlucht.");
    AddDetail(("dschungel"),
    "Der Dschungel schliesst Dich hier wie ein dichter Umhang ein.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
AddDetail(("himmel"),
"Der Himmel ist heute strahlendblau. Nur vereinzelt kann man kleine Wolken "
"sehen.");
AddDetail(({"wolke","wolken"}),
"Eine der Wolken siegt doch glatt wie Nostromo aus...");
AddDetail(("nostromo"),
"Wircklich, mit etwas Phantasie kann man den Pizzamagier erkennen...");
AddDetail(("phantasie"),
"Hast Du doch hoffentlich...");
AddDetail(("pizzamagier"),
"Du singst 'Oh, Pietro Pizzi...'");
AddDetail(({"palme"}),
"Als Du die Palme genauer betrachtest, faellt Dir auf, dass sie mit einem "
"dicken Seil krummgebunden wurde. Welchen Sinn das wohl hat...");
AddDetail(("sinn"),
"Wer hat das da wohl angebunden ?");
AddDetail(("seil"),
"Das Seil laeuft vom Boden, wo es fest verankert ist, nach oben und verschwindet "
"zwischen den Blaettern.");
AddDetail(({"blatt","blaetter"}),
"Die dicken, grossen Blaetter der Palme bilden fast ein Dach ueber Dir.");
AddDetail(("boden"), 
"Am Boden erkennst Du ein Seil, dass hier befestigt wurde und schraeg nach oben zieht,");
AddDetail(("dach"),
"Der Himmel ist durch die Blaetter kaum noch zu erkennen.");
AddDetail(("sueden"),
"Im Sueden erstreckt sich hinter einer tiefen Schlucht der unendliche Dschungel.");
AddDetail(("schlucht"),
"In der Schlucht rauscht ein gewaltiger Fluss dahin.");
AddDetail(("wasser"),
"Herrlich gruen schimmert es....");
AddDetail(("fluss"),
"Dieser Fluss heisst Rio de la Puseta, aber dass weisst Du ja schon.");
AddDetail(({"rio","puseta","rio de la puseta"}),
"Der Rio de la Puseta ist fuer sein herrlich gruen schimmerndes Wasser bekannt.");
AddDetail(("norden"),
"Im Norden liegt ein grosser Tafelberg.");
AddDetail(({"berg","tafelberg"}),
"Der Tafelberg ist ueber und ueber mit Pflanzen bewachsen, und verwehrt so "
"jeden Einblick.");
AddDetail(("region"),
"Du bist im Dschungel...");
  AddDetail(("stamm"),
  "Der Stamm ist sehr dick. Du glaubst einige Spuren daran zu erkennen.");
  AddDetail(({"spur","spuren"}),
  "Sieht aus als ob jemand auf die Palme geklettert waere...");
  AddDetail( ({"pflanzen","pflanze"}),
  "Du bist von Pflanzen umzingelt.");
  AddDetail(("sonne"),
  "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich\n"
   "herab.\n");
 AddDetail(({"kokosnuss","kokosnuesse"}),
 "Gross und rund lachen sie Dich an. Vielleicht kannst Du eine pfluecken... ");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Singen und Traellern der Voegel. ");
    AddDetail(({"nuesse","nuss"}),
    "Du meinst sicher Kokosnuesse, oder...");
AddDetail(("einblick"),
"Von hier unten kann man nichts erkennen.");    
  AddSmell( DEFAULT_SMELL,
    "AHH! Hier riecht man die pure Natur!");
AddDetail(("westen"),
"Nach Westen fuehrt ein kleiner Pfad zurueck.");
AddDetail(("pfad"),
"Der Pfad fuehrt nach Westen zurueck.");
 
 AddItem( ({NPC"dpavian", NPC"dratte", NPC"dbiene", SCHMETTERLING, PAPAGEI}), 
     REFRESH_DESTRUCT);

AddItem(NPC"dtiger", REFRESH_DESTRUCT);

 
 AddCmd(( {"klettere", "kletter"}), "klettern");
 AddCmd(( {"pflueck", "pfluecke"}), "pfluecken");    

AddExit("suedwesten", "./weg13");  
AddSpecialExit("osten", "go_charons_tempel");


}


int go_charons_tempel()  {
  
  if(!IS_WIZARD(TP))  {
     
     write(BS(
      "Eine unsichtbare Macht haelt Dich noch auf! Warte noch ein wenig!"));
     
      return 1; }
  
    else  {
  
    write(BS(
   "Du betrittst nun ein nicht fertiges Gebiet von Charon!"));
   TP->move("/d/dschungel/charon/tempel/room/room_a3", M_GO,
   "sich durch das Dickicht nach Osten", "kaempft",
   "kommt aus dem Westen herein");
   return 1; }
return 0; }
      


 int klettern(string str )
{
  notify_fail( "Wohin willst Du klettern?\n" );
  if( !str ) return 0; 
  if( member( ({"rauf","nach oben", "auf palme","hoch" }),str) !=-1 )
                      
    
    {
    write("Du kletterst mit grosser Muehe auf die Palme.\n");
    TP->move("/d/dschungel/dante/weg/room/palme", M_GO, "auf die Palme",
      "klettert", "kommt von unten heraufgeklettert.");
      
    return 1;
       }
  return 0;
     }

reset()
{
kokos=1;
::reset();
}
create_kokos()
{
object a;
a = clone_object(OBJ"kokos.lpc");
return a;
}

pfluecken ( str )
{
notify_fail("Was willst Du pfluecken ? Eine Kokosnuss ?\n");
if (str != "kokosnuss")
{
write(""); return 0;
}
if (!kokos)
{
write(" \n"
"Leider haengt im Moment keine Kokosnuss in Deiner Naehe...\n");
return 1;
}
if ( str == "kokosnuss")
write(" \n"
"Du pflueckst eine grosse, runde Kokosnuss die Du sofort einsteckst.\n");
say (""+TPN+" pflueckt eine grosse, runde Kokosnuss.\n");
CLONE(OBJ"kokos", TP);
kokos--;
return 1;
}
