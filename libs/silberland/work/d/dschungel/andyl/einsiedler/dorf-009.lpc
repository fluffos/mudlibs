//  ***     Raum                         
//  ***     Azrael@SilberLand
//  ***     dorf-009.c                 
//  ***     ----- Dorfplatz - suedwestliches Ende, spaeter einmal Zugang zu Privathaeusern

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz" );
  SetProp(P_INT_LONG,
   "Du stehst am suedoestlichen Ende des Dorfplatzes. Hier liegen einige "
   "Werkzeuge und Holzstaemme auf dem Steg. Offensichtlich wird der Steg "
   "hier suedoestlich weitergebaut, aber das dauert sicher noch einige "
   "Zeit... Naja, also westlich plaetschert ein Brunnen, und im Norden "
   "verbindet eine kleine Bruecke den Steg mit einem Haus. Nordwestlich "
   "geht es zurueck zum Eingang des Dorfplatzes und Richtung Ufer. Ansonsten "
   "schlaegt das Wasser des Sees ruhig an die Holzplanken. " );
  SetProp(P_LIGHT, 2 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_TOWN]));

  AddDetail( ({"himmel", "sonne", "schwitzen"}),
    "Die Sonne brennt vom Himmel und bringt Dich zum Schwitzen.");
  AddDetail( ({ "steg", "boden" }),
    "Der Steg ist hier sehr breit und bildet etwas, was Du als Dorfplatz "
    "bezeichnen wuerdest, wenn Du nicht wuesstest, dass Du auf Holzstaemmen "
    "ueber einem See stehst."  );
  AddDetail( ({ "dorfplatz", "platz", "ende" }),
    "Das ist das suedoestliche Ende des Dorfplatzes, wo anscheinend "
    "Erweiterungsarbeiten gemacht werden, um das Dorf zu vergroessern und "
    "den Bewohnern mehr Wohnraum zu schaffen." );
  AddDetail( "wohnraum",
    "Das Dorf wird immer groesser, deshalb wird hier auch neuer Wohnraum "
    "geschaffen." );
  AddDetail( "eingang",
    "Der Eingang zum Dorf und somit auch das Ufer liegen in nordoestlicher "
    "Richtung. ");
  AddDetail( ({ "arbeiten", "erweiterungsarbeiten" }),
    "Hier wird fleissig gearbeitet, um das Dorf zu vergroessern. " );
  AddDetail( "bewohner",
    "Die Bewohner dieses Dorfes werden von hier aus bald zu ihren "
    "Privathaeusern gelangen koennen. " );
  AddDetail( "bruecke",
    "Eine kleine Bruecke verbindet im Norden den Steg mit einem Haus. " );
  AddDetail( "haus",
    "Im Norden schliesst ein Haus an den Steg. ");
  AddDetail( ({"privathaeuser", "haeuser" }),
    "Im Suedosten werden gerade die neuen Privathaeuser angebaut. " );
  AddDetail( ({ "holzplanken", "planken" }),
    "Das ganze Dorf steht auf starken Holzplanken. " );
  AddDetail( "brunnen",
    "Der ist westlich von Dir und plaetschert gemuetlich vor sich hin. " );
  AddDetail( "werkzeuge",
    "Holzwerkzeuge, sie scheinen achtlos liegengelassen worden zu sein. Hier "
    "wurde sicher vor kurzem noch gearbeitet. " );
  AddDetail( "ufer",
    "Nach Norden gehts zurueck zum Ufer. " );
  AddDetail( "holzwerkzeuge",
    "Sie eignen sich besonders gut um Holz zu bearbeiten. " );
  AddDetail( ({ "holzstaemme", "baumstaemme", "staemme" }),
    "Diese Staemme sind wohl dafuer gedacht, sie - wie ueberall hier im Dorf "
    "- in den See zu rammen und so ein Fundament zu bilden. Der Steg ist "
    "auch aus solchen Staemmen gemacht. " );
  AddDetail( "zeit",
    "Tja, es wird schon noch einige Zeit dauern, bis das Dorf hier "
    "erweitert werden kann. " );
  AddDetail( "dorf",
    "Das Dorf wird hier noch erweitert...nur Geduld! ");
  AddDetail( "geduld",
    "Na na na, was soll das? - Geduld! Geduld! " );
  AddDetail( "fundament",
    "Die Holzstaemme, die hier liegen, sollen einmal das Fundament fuer "
    "weitere Haeuser des Dorfes bilden. " );
  AddDetail( ({ "see", "wasser" }),
    "Das Wasser das Sees schlaegt ruhig gegen die Holzplanken. " );
 
  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
    "Du hoerst die Geraeusche von geschaeftigen Leuten, die hier ihrer "
    "Arbeit nachgehen. " );

  AddSmell( ({DEFAULT_SMELL, "geruch", "wasser"}),
    "Der frische Geruch des Wassers unter Dir steigt zwischen den "
    "Holzstaemmen zu Dir herauf. " );

  AddItem( NPC "elfwache", REFRESH_DESTRUCT );

  AddExit( "norden",     "./dorf-008" );
  AddExit( "westen",     "./dorf-010" );
  AddExit( "nordwesten", "./dorf-007" );

//  AddExit( "suedosten",  DORF("dorf-???.lpc" ); ---> Privathaeuser des Dorfes

}



