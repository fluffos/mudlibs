
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Schinkenpizza");
 SetProp(P_LONG, BS("Die Pizza ist ziemlich fettig und schon halb aufgegessen. "
                    "Ausserdem sieht der Belag nicht mehr besonders "
                    "frisch aus."));
 SetProp(P_GENDER, FEMALE);
 SetProp(P_WEIGHT, 50);
 SetProp(P_VALUE, 15);
 AddId(({"pizza","schinkenpizza"}));
 SetProp(P_NAME, "Pizza");
 SetProp(P_MATERIAL, ([MAT_BREAD:100]));

 SetProp(P_SMELL, "Die Pizza riecht schon leicht aelter.\n");

 AD(({"belag"}),
   "Das ist eine Schinkenpizza spezial mit einer halben Sau a la Wernzi.");
      
 AD(({"saeue","sau","halbe saeue","halbe sau"}),
   "Eben eine richtige Jause wenn man Hunger hat.");

 AD(("hunger"),
   "Iss die Pizza, dann vergeht Dir der Hunger.");
   
 AD(({"jause","jause","wernzi"}),
   "Schaemst Du Dich nicht anderen Leuten die Jause weg zu nehmen?");
   
 AD(("leute"),
   "Tu nicht so unschuldig.");  
   
 AD(("schinken"),
   "Der Schinken wird von der halben Sau nahezu vollkommen verdeckt.");
   
 SetProp(P_FOOD_INFO, ([F_HEAL : ({15, 15}), F_SOAK : 3,
	F_MSG:"Du verschlingst die Pizza mit einem Biss.\n",
	F_MSG_ROOM:"verschlingt gierig eine Pizza.\n"]));

}

