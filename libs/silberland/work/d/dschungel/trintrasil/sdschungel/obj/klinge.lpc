
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"klinge","messerklinge","taschenmesserklinge"}));
   SetProp(P_NAME, "Messerklinge");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Taschenmesserklinge" );
   SetProp(P_LONG, BS(
           "Ohne Griff kannst Du mit der Klinge leider nicht viel anfangen. "
           "Wenn Du zumindest ein geeignetes Stueck Holz haettest an dem Du "
           "die Klinge befestigen koenntest wuerde das schon reichen."));
   SP(P_NAME_ADJ, "klein");
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_IRON);
   SetProp(P_VALUE,80);
   SetProp(P_WEIGHT, 50);

   AD(("griff"),
     "Ohne Griff kann man mit dieser Klinge nicht schnitzen.");
     
   AD(({"holz","stueck"}),
     "Ein einfaches, handgrosses Stueck Holz wuerde schon reichen.");

   AddCmd(({"stecke","befestige"}), "func_messer");
        
}

   int func_messer(string str) {
   	
    notify_fail("An was willst Du die Klinge befestigen?\n");
    
    if(str=="klinge an holz"||str=="klinge an holzstueck"||
       str=="klinge an splitter"||str=="klinge am holz"||str=="klinge am splitter"||
       str=="klinge am holzstueck"||str=="klinge an dem holz"||
       str=="klinge an dem splitter"||str=="klinge an dem holzstueck"||
       str=="klinge in holz"||str=="klinge in holzstueck"||str=="klinge in splitter"||
       str=="klinge in das holz"||str=="klinge in das holzstueck"||
       str=="klinge in den splitter") {
       	
      if((present("splitter", TP))&&(present("klinge", TP))) {
      
        object messer, splitter, klinge;
      	klinge=present("klinge", TP);
        splitter=present("holzstueck", TP);
        	
      	Z1
      	write(BS("Du nimmst das Holzstueck, keilst einen Spalt hinein und "
      	         "steckst die Messerklinge fest in den Spalt. Wenn Du das "
      	         "Messer am Holzstueck wie an einem Griff festhaeltst, "
      	         "kannst Du nun damit schnitzen."));
      	S1
      	say(BS(""+TPN+" basteln sich aus einem Holzstueck und einer Klinge ein "
      	       "kleines Messer."));
      	messer=clone_object("/d/dschungel/trintrasil/sdschungel/obj/weapon/messer");
      	messer->move(TP, M_NOCHECK);
      	splitter->remove("holzstueck");    
      	klinge->remove("klinge");
  	  
      	  return 1;}
      	  
     if((!present("splitter", TP))&&(present("klinge", TP))) {
     	
     	Z1
     	write(BS("Um Dir ein Messer zu basteln brauchst Du auch ein passendes "
     	         "ca handgrosses Holzstueck."));
     	  return 1;}
     
     if((present("splitter", TP))&&(!present("klinge", TP))) {
     	
     	Z1
     	write(BS("Du hast doch gar keine Klinge."));
     	  return 1;}
     	return 0;}
     return 0;}

