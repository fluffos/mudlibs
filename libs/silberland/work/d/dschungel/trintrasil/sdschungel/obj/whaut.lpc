inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

string hautfarbe = "rostrot";

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"haut","wurmhaut","sandwurmhaut"}));
   SetProp(P_NAME, "Wurmhaut");
   SetProp( P_GENDER , FEMALE);
   SetProp(P_ARTICLE, 1 );




SetProp(P_NAME_ADJ, ""+hautfarbe+"");





   SetProp(P_SHORT, "Die Haut eines Sandwurmes" );
   SetProp(P_LONG, BS(
   "Sandwurmhaut ist dick, ledirg und schimmert "+hautfarbe+". Angeblich verwenden die "
   "Kannibalen diese feste Haut bei speziellen Helmen."));
   SetProp(P_MATERIAL, MAT_SKIN);
   SetProp(P_VALUE,300+random(200));
   SetProp(P_WEIGHT,1000+random(100) );
   SetProp(P_INFO, BS("Die Kannibalen verwenden Sandwurmhaeute als Nackenschutz bei ihren "
   "Kaimanhelmen."));
 
   AD(("kannibalen"),
   "Die Kannibalen fertigen besondere Helme fuer die sie auch solche Sandwurmhaeute brauchen.");
   
   AD(({"kaimanhelm","helme","kaimanhelm","helm","schaedel"}),
   "Diese Helme fertigen die Kannibalen aus dem Schaedel eines Riesenkaimans. Aber mehr darueber "
   "erfaehrst Du sicher im Kannibalendorf.");
   
   AD(({"dorf","kannibalendorf"}),
   "Im Kannibalendorf lebt ein Kannibale der solche Helme anfertigt.");
   
   AD(({"kannibale","mombassa"}),
   "Angeblich heisst er Mombassa. Aber es wird sicher nicht leicht einen solchen Helm zu "
   "bekommen.");
   
   AD(({"tiere","raubtiere","kaiman","riesenkaiman"}),
   "Riesenkaimane sind gefuerchtete Raubtiere im Flussgebiet.");
   
   AD(({"kannibalendorf","dorf"}),
   "Das Kannibalendorf befindet sich weit suedlich im Gebiet des Rio de la Puseta.");
   
   AD(({"fluss","gebiet","flussgebiet","rio","rio de la puseta"}),
   "Der grosse Fluss im Dschungel.");
   
   AD(({"tijara","dschungel"}),
   "Tijara sollte man als Abenteurer kennen.");

   AddCmd(("farbe"), "query_farbe");
}


_query_long() {
	
	return(BS("Sandwurmhaut ist dick, ledirg und schimmert "+hautfarbe+". Angeblich "
	"verwenden die Kannibalen diese feste Haut bei speziellen Helmen."));
}


farbesetzen(string farbe) {
	
	hautfarbe = farbe;
	SetProp(P_NAME_ADJ, ""+hautfarbe+"");
}

query_farbe(string fclos) {
	
	fclos = TO->QueryProp(P_NAME_ADJ);
	
	tell_room(ENV(TP), ""+fclos+"\n\n");
}
