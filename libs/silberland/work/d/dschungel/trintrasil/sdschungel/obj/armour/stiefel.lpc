
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Paar leichter Infanteriestiefel");
  SetProp (P_LONG,BS(
"Diese Stiefel sind leichter und angenehmer als herkoemmliche Armeestiefel. "
"Sie werden deshalb bevorzugt von den Soldaten im heissen Tijara getragen."));

AD(({"tijara","soldaten"}),
"Diese Stiefel sind leichter und bequemer und eigenen sich daher besonders im "
"heissen Klima.");

AD(({"klima","dschungelklima"}),
"Dschungelklima zum Beispiel.");

AD(("beispiel"),
"Nur so beigespielt.");


  SP(P_NAME_ADJ, "leicht");
  SetProp (P_NAME, "Paar Infanteriestiefel");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"stiefel","infanteriestiefel","armeestiefel","soldatenstiefel"}));
  SetProp (P_WEIGHT, 380);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 1300);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 100]));
  
}
