
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

int splitter=1;

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"pfahl","holzpfahl","pflock","holzpflock"}));
   SetProp(P_NAME, "Holzpfahl");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Eine abgebrochener Holzpfahl" );
   SetProp(P_LONG, BS(
           "Der abgebrochene Holzpfahl ist etwas morsch und mit Moos "
           "bewachsen."));
   SP(P_NAME_ADJ, "abgebrochen");
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_VALUE,50);
   SetProp(P_WEIGHT, 1100);

   AD(("moos"),
     "Das Moos auf dem zersplitterten Holz ist ganz zerfledert. Pass auf das Du "
     "Dir keinen Splitter einziehst.");
     
   ASD(("splitter"),
     "splitter");

   AddCmd(({"brich","loese","reisse","breche","brech"}), "func_splitter");
}

func_splitter(string str) {
	
 object holz;
 	
 notify_fail("Was willst Du abbrechen? Einen Splitter?\n");
 	
 if(str=="splitter"||str=="splitter ab"||str=="splitter vom pfahl ab"||
    str=="splitter vom pfahl"||str=="splitter vom holzpfahl ab"||
    str=="splitter vom holzpfahl"||str=="splitter vom pflock ab"||
    str=="splitter vom pflock"||str=="splitter vom holzpflock ab"||
    str=="splitter vom pfahl ab"||str=="splitter vom holzpfahl ab"||
    str=="splitter vom holzpflock"||str=="stueck"||str=="holz"||
    str=="stueck ab"||str=="holz ab"||str=="holzstueck"||
    str=="holzstueck ab"||str=="stueck vom pfahl"||str=="holz vom pfahl"||
    str=="holzstueck vom pfahl"||str=="stueck vom pfahl ab"||
    str=="holz vom pfahl ab"||str=="holzstueck vom pfahl ab"||str=="splitter "
         "aus pfahl"||str=="splitter aus holzpfahl"||str=="splitter aus "
         "holzpflock"||str=="splitter aus pflock") {
    	 
   if((splitter==1)&&(present("holzpfahl", TP))) {
   	
    Z1	
    write(BS("Du packst einen geeigneten Holzsplitter, brichst ihn vom "
             "Holzpfahl ab und steckst ihn ein."));
    S1
    say(BS(""+TPN+" bricht einen Splitter von einem Holzpfahl ab."));
    holz=clone_object("/d/dschungel/trintrasil/sdschungel/obj/splitter");
    holz->move(TP, M_NOCHECK);
    splitter=0;
      return 1;}
      
   if((splitter==0)&&(present("holzpfahl", TP))) {
   	
    Z1
    write(BS("Du findest leider keinen geeigneten Splitter den Du von diesem "
             "Pfahl brechen koenntest."));
      return 1;}
    
    if(!present("holzpfahl", TP)) {
    	
     Z1
     write(BS("Du hast ja gar keinen Holzpfahl von dem Du einen Splitter "
              "abbrechen koenntest."));
     return 1;}
    return 0;}
  return 0;}          

splitter() {
	
 if(splitter==1) {
  return(BS("Einen etwa handgrossen Splitter koenntest vom Pfahl abbrechen."));
    }

 if(splitter==0) {
  return(BS("Auf dem Pfahl sind viele kleine Splitter die Du Dir einziehen "
            "koenntest."));
    }
   }



