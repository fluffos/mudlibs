
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"splitter","holzstueck","holzsplitter","holz","stueck"}));
   SetProp(P_NAME, "Holzstueck");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Holzstueck" );
   SetProp(P_LONG, BS(
           "Dieses Holzstueck ist ca so gross wie Deine Hand. Vielleicht kannst "
           "Du es zu etwas gebrauchen."));
   SP(P_NAME_ADJ, "handgrosses");
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_VALUE,10);
   SetProp(P_WEIGHT, 50);

   AD(("hand"),
     "Eben ein Handgrosses Holzstueck.");    

   AddCmd(({"befestige","stecke"}), "func_messer");
}

   int func_messer(string str) {
   	
    notify_fail("An was willst Du die Klinge befestigen?\n");
    
    if(str=="klinge an holz"||str=="klinge an holzstueck"||
       str=="klinge an splitter"||str=="klinge am holz"||str=="klinge am splitter"||
       str=="klinge am holzstueck"||str=="klinge an dem holz"||
       str=="klinge an dem splitter"||str=="klinge an dem holzstueck"||
       str=="klinge in holz"||str=="klinge in holzstueck"||str=="klinge in splitter"||
       str=="klinge in das holz"||str=="klinge in das holzstueck"||
       str=="klinge in den splitter") {
       	
      if((!present("klinge", TP))&&(present("holzstueck", TP))) {
      
      	Z1
      	write(BS("Du hast keine Klinge die Du in das Holzstueck stecken "
      	         "kannst."));
      	  return 1;}
      	  
      if((present("klinge", TP))&&(!present("holzstueck", TP))) {
     	
     	Z1
     	write(BS("Du hast doch gar kein Holzstueck."));
     	  return 1;}
     	
      if((present("klinge", TP))&&(present("holzstueck", TP))) {
      	  }	
     	return 0;}
     return 0;}



