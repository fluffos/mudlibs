
inherit "std/weapon";
#include <properties.h>     
#include <combat.h>       
#include <language.h>      
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Infanteriesaebel");
SetProp (P_GENDER, MALE);
SetProp (P_VALUE, 2100+random(105));
SetProp (P_WEIGHT, 950);
SetProp (P_WEAPON_TYPE, WT_SWORD);
SP(P_LONG, BS(
"Dieser Saebel ist wie bei Saebeln ueblich leicht gebogen und einseitig "
"geschliffen. Er ist als typischer Infanteriesaebel zwar kuerzer, aber sehr "
"scharf und besonders leicht zu fuehren."));


AddId(({"saebel","infanteriesaebel"}));

SP(P_SHORT, "Ein kurzer Infanteriesaebel");

SetProp (P_DAM_TYPE, ({ DT_SLASH}));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 150);
SetProp (P_WC_BONUS, (["wachtmeister": 100]) );
SetProp (P_WC_FIX, 50);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_STEEL:100]));
SetProp (P_WIELD_RESTRICTIONS, ([A_DEX: 1]));

}