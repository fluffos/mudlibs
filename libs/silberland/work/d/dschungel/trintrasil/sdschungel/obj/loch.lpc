
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

reset()
 {
 ::reset();

 remove();
}

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"mulde","loch"}));
   SetProp(P_NAME, "Mulde");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Eine Mulde" );
   SetProp(P_LONG, BS(
           "Eine nette Mulde."));
   SetProp(P_NOGET, "Wie willst Du eine Mulde im Boden nehmen?\n");   
   SetProp(P_MATERIAL,MAT_GOLD);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT, 0);
}
