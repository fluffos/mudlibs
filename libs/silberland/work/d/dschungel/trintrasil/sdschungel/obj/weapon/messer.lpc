

inherit "std/weapon";
#include <properties.h>     
#include <combat.h>        
#include <language.h>    
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Messer");
SetProp (P_GENDER, NEUTER);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Dieses selbstgemachte, kleine Messer eigent sich eigentlich nur zum Schnitzen. "
"Fuer alle anderen Taetigkeiten sitzt die Klinge zu locker."));


AddId(({"messer"}));

SP(P_SHORT, "Eine kleines Messer");

SetProp (P_DAM_TYPE, ({ DT_RIP}));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 15);
SetProp (P_WC_FIX, 15);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_IRON:10, MAT_WOOD:90]));
SetProp(P_VALUE, 90);
SetProp(P_WEIGHT, 80);
SetProp ("geoeffnet", 1);//immer geoeffnet weil nicht schliessbar (wichtig)

AD(({"taetigkeit","taetigkeiten"}),
  "Dieses Messer kannst Du eigentlich nur zum Schnitzen verwenden da die Klinge "
  "nur recht locker in das Holzstueck gesteckt wurde.");
  
AD(({"schnitzen","holz"}),
  "Wenn Du geeignetes Holz hast dann Du damit sicher relativ einfach "
  "schnitzen.");
  
}

   
   
