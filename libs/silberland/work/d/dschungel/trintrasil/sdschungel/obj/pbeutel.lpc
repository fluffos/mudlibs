#include <properties.h>
inherit "/std/container";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <wizlevels.h>
#include <food.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Proviantbeutel");
  SetProp(P_LONG, BS("Der Beutel ist aus weichem, festem Leder. Er dient nur "
  "zum Aufbewahren von Proviant. Fuer sonstige Dinge waere er zu klein."));
  AddId(({"beutel", "proviantbeutel"}));
  SetProp(P_NAME, "Proviantbeutel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 1200);
  SetProp(P_VALUE, 250);
  SetProp(P_INFO, BS("Aus diesem Proviantbeutel kannst Du Dich mit ´staerke "
  "dich aus proviantbeutel´ schnell etwas essen."));
  SetProp(P_MATERIAL, MAT_LEATHER);

  AddDetail(({"proviant","leder"}),
   "In diesem festen Leder bleibt Dein Proviant sicher laenger firsch.");
 
  AddDetail(("dinge"),
   "In den Proviantbeutel passen nur kleine essbare Dinge.");
   
  AddDetail(("kleine dinge"),
   "Also maximal eine halbe, gebratene Sau.");

  AddCmd(("staerke"), "proviant");
}

int proviant(string str) {
object essen;

   notify_fail("Aus was willst Du Dich staerken?\n");

   if(str=="dich aus proviantbeutel") {



if( TP && environment(TO) && interactive(environment(TO)) )  {
say(BS(
CAP_TPN+" will sich aus "+TP->QueryPossPronoun(MALE, WEM, SINGULAR)+""
" Beutel staerken."));

write(BS(
"Du willst Dich aus Deinem Proviantbeutel staerken."));	

essen=first_inventory(TO);

if(! essen )  {
	
	write(BS(
		"Dein Beutel ist leider leer."));
		return 1; }
else {

TP->command_me( "nimm "+essen->name()+" aus proviantbeutel");
TP->command_me( "iss "+essen->name()+"");
if(IS_WIZARD(TP))  {
	write(BS(
	"Bei Dir als Magier kann das nicht gehen."));
	}
	
   	return 1;}

return 0;
}
return 0; }
return 0; }


varargs int PreventInsert(object ob) {

if( !ob->id("PB_PERMISSION")&&!ob->QueryProp(P_FOOD_INFO) ) {

write(
""+CAP(ob->name(WER))+" ist doch nicht essbar!\n");
		return 1;
	} 

	else {	
  	return ::PreventInsert(ob);
} }