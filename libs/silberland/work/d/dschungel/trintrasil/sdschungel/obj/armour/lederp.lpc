
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein verstaerkter Lederpanzer");
  SetProp (P_LONG,BS(
"Dieser Lederpanzer besteht aus mehreren Schichten gehaerteten Leder. Um "
"besseren Schutz vor Stichwaffen zu erreichen wurden ausserdem Metallplaettchen "
"eingearbeitet. Obwohl er recht guten Schutz bietet ist er relativ leicht."));

AD(({"schichten"}),
"Der Panzer besteht aus mehreren Schichten Leder.");

AD(({"leder"}),
"Das dicke Leder wurde durch spezielles Erhitzen gehaertet.");

AD(({"waffenschmied","erhitzen"}),
"Frag doch einen Waffenschmied.");

AD(({"metall","schutz","waffen","stichwaffen"}),
"Stichwaffen koennen durch die eingearbeiteten Metallplaettchen den Panzer "
"schwerer durchdringen.");

AD(({"plaettchen","metallplaettchen","platten","handteller","teller","hand"}),
"Die Metallplaettchen sind ca halb so gross wie Dein Handteller.");



  SP(P_NAME_ADJ, "verstaerkt");
  SetProp (P_NAME, "Lederpanzer");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","lederpanzer","verstaerkter panzer","verstaerkter lederpanzer"}));
  SetProp (P_WEIGHT, 1180);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 1300+random(150));
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 28);
  SetProp (P_RESISTANCE, (DT_PIERCE));
  SetProp(P_MATERIAL, ([MAT_LEATHER: 80, MAT_STEEL: 20]));
  
}
