inherit "std/armour";

#include <wizlevels.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein leichter Helm");
  SetProp (P_LONG,BS(
"Dieser Helm ist sehr leicht gehalten damit man ihn auch bei grosser Hitze "
"tragen kann. Er hat kein Visier und auch keinen Nackenschutz und schuetzt nur "
"den oberen Kopfbereich vor Schlaegen. An seinem Rand ist noch ein weisser bis "
"zu den Schultern reichender Stoff befestigt um Deinen Hals vor der sengenden "
"Sonne zu schuetzen."));

AD(("visier"),
"Ein Visier waere bei grosser Hitze unertraeglich.");

AD(({"nackenschutz"}),
"Bei einem Nackenschutz wuerde man bei grosser Hitze sehr schwitzen.");

AD(({"kopf","schlaege","kopfbereich"}),
"Oben ist der Helm aus hartem Stahl und schuetzt sehr gut vor Schlaegen.");

AD(({"schultern","innenseite","rand"}),
"An der Innenseite des Helms ist ein weisser Stoff befestig der bis an Deine "
"Schultern reicht.");

AD(({"gebiete","sonne","hitze","dschungel","tijara"}),
"Soldaten aus Tijara tragen ihn wenn sie sich im heissen Dschungel aufhalten "
"muessen.");

AD(("sonnenbrand"),
"Dieser Helm ist ideal fuer sehr heisse Gebiete.");

AD(("stoff"),
"Der weisse Stoff schuetzt Deinen Hals vor einem Sonnenbrand. Gegen Schlaege "
"ist er aber wirkungslos.");

AD(("stahlt"),
"Der harte Stahl sieht so aus als koennte er einiges vertragen.");

  SP(P_NAME_ADJ, "leicht");
  SetProp (P_NAME, "Helm");
  SetProp (P_GENDER, MALE);
  AddId ("helm");
  SetProp (P_WEIGHT, 350);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 900);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
  SetProp (P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_CLOTH:60, MAT_STEEL:40]));
  
}

