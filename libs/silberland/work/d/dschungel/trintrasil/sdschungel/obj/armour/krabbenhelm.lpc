
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein kleiner Krabbenpanzer");
  SetProp (P_LONG,BS(
"Den sandgelbweisse Krabbenpanzer kann man als Helm verwenden wenn man einen "
"kleinen Kopf hat. Er ist eher eine psychische Stuetze als ein Schutz. Aber er "
"haette den Vorteil das er Dich auf Sand gut tarnen wuerde, "
"wenn Du so gross wie eine Krabbe waerst."));

AD(("helm"),
"Setz ihn doch auf! Oder ist Dein kopf zu gross?");

AD(("stuetze"),
"Kleine Koepfe kann der Panzer vor Regen schuetzen, und wer sehr klein ist "
"fuehlt sich mit diesem Panzer vielleicht sicherer.");

AD(({"regenschutz","regen","aufgaben","aufgabe"}),
"Eine der wichtigsten Aufgaben eines Helmes ist schliesslich der Regenschutz.");

AD(({"kopf","hand","menschenhand"}),
"Dein Kopf darf auf keinen Fall groesser sein als eine Menschenhand.");

AD(("fall"),
"Wirf den Helm lieber weg bevor Du damit zum Tirex gehst.");

AD(("tirex"),
"Ich habe Dich jedenfalls gewarnt.");

AD(({"schutz"}),
"Bei einer Streitaxt wuerde ich mit diesem Helm nicht auf Unverwundbarkeit "
"hoffen.");

AD(({"verwundbarkeit","unverwundbarkeit"}),
"Aber Hoffnung kann sicher viel bewirken.");

AD(("hoffnung"),
"Hoffnung ist ja ganz nett. Aber bleib bei einer Streitaxt mit diesem "
"Helm besser am Boden.");

AD(("boden"),
"Sonst koenntest Du schnell am Boden liegen.");

AD(({"sand","vorteil"}),
"Bist Du klein wie eine Krabbe?");

AD(("krabbe"),
"Naja, zumindest die Krabbe der der Panzer gehoerte vermisst ihn sicher.");


  SP(P_NAME_ADJ, "klein");
  SetProp (P_NAME, "Krabbenpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"helm","panzer","krabbenpanzer"}));
  SetProp (P_WEIGHT, 40);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 10);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
  SetProp (P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_CLOTH:60, MAT_STEEL:40]));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE: 100]));
}           
           	

