                for (u=sizeof(w)-1;u>=0;u--) {
                  if(objectp(w[u]))	
                	  w[u]->turm_reset();
	                }         	
         	       }
        
                  }
        
        
     if(!present("ruediger", turm) && !present("hermann", turm) &&
        !present("meinhart", turm) && present("wernfried", turm)) {

                TELLSD(turm,"Verdammt, hoffentlich ist bald Verstaerkung da.",
                            "Der Brueckenposten brummelt: ");
                anzahl=1;
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->turm_reset();
	                }        	
        	       }
        	       
                   }

//++++++++++++++++++++++++++++ TOR ++++++++++++++++++++++++++++++++++++++++++++++

  if(!present("posten", turm) && present("posten", tor) &&
     !present("posten", bruecke)) {
     	 
     	 
    if(present("ruediger", tor)) {

    	if(p>=3) {
    		
		TELLSD(sdschungel2,"Scheint wieder alles ruhig zu sein. Alle "
		                  "zurueck auf ihre Posten bis die Abloese "
		                  "kommt!",
		                  "Der Wachtmeister sagt: ");     
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))   
                	  w[u]->tor_reset();
	                }
	       	       }
		        
        if(p==2) {
    	
    	        TELLSD(sdschungel2,"Scheint wieder alles ruhig zu sein. Nimm "
    	                           "Deinen Posten wieder ein bis die Abloese "
    	                           "kommt! Verdammt viele Verluste!",
    	                           "Der Wachtmeister sagt: ");     
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->tor_reset();
	                }    	                
    	               }
    	                
        if(p==1) {
              if(objectp(w[u])) 
               w[u]->tor_reset();
               anzahl=1;                             
                }
               }
        
        
    if(!present("ruediger", tor) && present("hermann", tor)) {
    	
    	if(p>=2) { 
    		
    		TELLSD(sdschungel2,"Scheint alles ruhig zu sein. Wir sollten " 
    		                   "auf unseren Posten zurueck bis die Abloese "
    		                   "kommt.","Der Torposten sagt: ");
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->tor_reset();
	                }             
    		       }
    		        
        if(p==1) {
                
                anzahl=1;
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->tor_reset();
	                }        	
        	      }
     
                   }
        
        
    if(!present("ruediger", tor) && !present("hermann", tor) && 
        present("meinhart", tor)) {
        	
        if(p==2) {
        	
                TELLSD(sdschungel2,"Scheint alles ruhig zu sein. Wir sollten "
                                   "wieder unsere Posten einnehmen. Die Abloese "
                                   "wird ohnehin bald kommen.",
                                   "Der Wachposten Meinhart sagt: ");
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->tor_reset();
	                }  
                       }
                        
         if(p==1) {
         	
                TELLSD(sdschungel2,"Hoffentlich war das der letzte Angriff bis "
                                   "die Abloese kommt. Der Tod meiner Kameraden "
                                   "wird nicht ungeraecht bleiben.",
                                   "Der Wachposten Meinhart brummelt: ");                
                anzahl=1;
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->tor_reset();
	                }         	
               	       }
              
                    }
        
        
     if(!present("ruediger", tor) && !present("hermann", tor) &&
        !present("meinhart", tor) && present("wernfried", tor)) {

                TELLSD(sdschungel2,"Verdammt hoffentlich ist bald Verstaerkung "
                                   "da.",
                                   "Der Brueckenposten brummelt: ");
                anzahl=1;
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->tor_reset();
	                }        	
                       }

                  }

//+++++++++++++++++++++++++++++++ BRUECKE +++++++++++++++++++++++++++++++++++++++

  if(!present("posten", turm) && !present("posten", tor) &&
     present("posten", bruecke)) {
     	 
     	 
    if(present("ruediger", bruecke)) {

    	if(p>=3) {
    		
		TELLSD(bruecke2,"Scheint wieder alles ruhig zu sein. Alle "
		                "zurueck auf ihre Posten bis die Abloese kommt!",
		                "Der Wachtmeister sagt: ");     
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                  if(objectp(w[u])) 
                	  w[u]->bruecke_reset();
	                }
	       	       }
		        
        if(p==2) {
    	
    	        TELLSD(bruecke2,"Scheint wieder alles ruhig zu sein. Nimm "
    	                        "Deinen Posten wieder ein bis die Abloese "
    	                        "kommt! Verdammt viele Verluste!",
    	                        "Der Wachtmeister sagt: ");     
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
                	  w[u]->bruecke_reset();
	                }    	                
    	               }
    	                
        if(p==1) {
      
               anzahl=1;                             
                for (u=sizeof(w)-1;u>=0;u--) {
                  if(objectp(w[u])) 
                	  w[u]->bruecke_reset();
                	}
                	
                }
               }
        
        
    if(!present("ruediger", bruecke) && present("hermann", bruecke)) {
    	
    	if(p>=2) { 
    		
    		TELLSD(bruecke2,"Scheint alles ruhig zu sein. Wir sollten auf "
    		              "unseren Posten zurueck bis die Abloese kommt.",
    		              "Der Torposten sagt: ");
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                if(objectp(w[u]))	
