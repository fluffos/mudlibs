  mann_check();
    w=mann;
    obj = find_object("/d/dschungel/trintrasil/sdschungel/room/sdschungel2");
    
 if(present("hermann", obj)) {   	
    tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
              "\nDer Torposten sagt: Potztausend was ist denn da im Wachturm "
              "los?!\n");
             }
             
 if(!present("hermann", obj)) {
    tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
              "\nDu hoerst lauten Kampflaerm aus dem Turm!\n");
              }

    for (u=sizeof(w)-1;u>=0;u--) {

      w[u]->postenmove_rued();      
   }                
}


