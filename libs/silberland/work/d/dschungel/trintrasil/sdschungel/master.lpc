#include <moving.h>
#include <properties.h>

#include "/d/dschungel/trintrasil/myowndefine.h"
#define TIME 600  //zeit nach der der ausgangszustand wieder hergestellt 
//wird (aufrufen der funkt. ausgangszustand

  int durchlauf=0;//gebraucht zB. in hermann3 (zeile 235). Wird von einer 
                  //Funktion im master wieder zurueckgesetzt.
  int anzahl=1;/*definiert ob die npc schon angegriffen wurden, wenn nein dann 
               wird die support welche von der defend des angegriffenen npc 
               aufgerufen wird ausgefuehrt, wenn ja dann wird sie abgebrochen.
               ist notwendig weil defend sonst jede kampfrunde die support 
               ausloest. wird in der Funktion ausgangszustand im master wieder
               zurueckgesetzt*/

string *namen;   
string nam;
object *mann;
  
//zentraler reset notwendig damit sicher ist das alle posten gleichzeitig
//wiederkommen
reset() {

call_other("/d/dschungel/trintrasil/sdschungel/room/turm", "reset");
call_other("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", "reset");
call_other("/d/dschungel/trintrasil/sdschungel/room/bruecke2", "reset");
call_other("/d/dschungel/trintrasil/sdschungel/room/busch-h", "reset");
anzahl=1;
}  

void mann_check()
{
  int i;

  for(i = sizeof(mann) - 1; i >= 0; i--)
    if(!mann[i] || !objectp(mann[i]))
      mann -= ({mann[i]});
}
 
 
  create() {
    
    if (is_clone(this_object())) {
    	 
    	 this_object()->remove();
    	 
    	 return 0;}
    
    mann = ({});
    
  }


     check()  {
	int i;
	object dante;
	dante=find_player("trintrasil");
	
	if(dante)  {
		
      /* if(mann==({}) )  {
     
       	tell_object(dante,
       	"mann = ({})\n");
      } */ 			
		
if(!sizeof(mann))  {
       	tell_object(dante,
       	"mann = NULL\n");
      }  				
      	
if(sizeof(mann))  {
	
		for(i=0; i<sizeof(mann); i++)  {
			tell_object(dante,
			" "+(i+1)+".) Name: "+mann[i]->QueryProp(P_NAME)+"\n");
		}	}	
	
}
}

//ooooooooooooooooooooo EIN UND AUSTRAGEN DER POSTEN oooooooooooooooooooooooooooo
remove_mann() {

  mann_check();
  mann -= ({ previous_object() });
}


add_mann() {

  mann_check();
  mann += ({ previous_object() });
}



//ooooooooooooooooo FUNKTION DIE DAS EINTRAGEN DER ENEMIES STEUERT oooooooooooooo

ruf_um_hilfe(object spieler) {
    
  int u;
  object *w;
  mann_check();
  w=mann;

  for (u=sizeof(w)-1;u>=0;u--) {

    if( objectp(w[u]) )  // sicherheitsabfrage [feyaria]
    {
      w[u]->fightstatus();      
      if (catch(w[u]->InsertEnemy(spieler))) {

        mann -= ({ w[u] }); 
      }
    }
  }
}



 //ooooooooooooo AUSTRAGEN DES SPIELERS ALS ENEMY AUS ALLEN POSTEN oooooooooooooo 

//diese funktion ist notwendig wenn der spieler stirbt wenn nicht alle posten 
//die ihn als enemy gesetzt haben mit ihm im selben raum sind
 
remove_enemy(object spieler)  {

 int i;

  mann_check();
  if(!sizeof(mann))  { //kann nie vorkommen 
  	return;}
 
  for(i=0; i<sizeof(mann); i++)  {
 	
 	if( spieler && mann[i] && mann[i]->IsEnemy(spieler)==1 )  { 
 		
 		mann[i]->StopHuntFor(spieler);
                spieler->StopHuntFor(mann[i]);
        } 
  }
}                        
//ooooooooooooooooooooooooooooo AUSTRAGEN ENDE oooooooooooooooooooooooooooooooooo




//oooooooooooooo SUPPORTFUNKT DIE DIE AKTIONEN DER NPC AUSLOEST ooooooooooooooooo

support() {

  int p;
  mann_check();
  p=sizeof(mann);

  if(p==1) {//wenn nur eine einzige wache vorhanden ist, waere der hilfruf  
    //unnuetz
    call_out("ausgangszustand", TIME);
    return 0;}

    if(p>=2) {//hier stehen wachen als hilfe zur verfuegung

      if(anzahl==0) {   //wurden die posten schon einmal in diesem reset angegriffen	
   	return 0;}   //stehen sie bereits alle in einem raum und muessen nicht 
                     //zusammenlaufen
   if(anzahl==1) {
     	
      if(previous_object()->id("wernfried")) {
      	
      	tell_room(environment(previous_object()),
      	          "\nWernfried bruellt: HEEE, WASN LOS! ICH WERDE "
      	          "ANGEGRIFFEN!\n\n");
      	
      	TELLSD(sdschungel2,"HEEE, WASN LOS! ICH WERDE ANGEGRIFFEN!",
      	              "Im Norden bruellt Jemand: ");
      	TELLSD(turm,"HEEE, WASN LOS! ICH WERDE ANGEGRIFFEN!",
      	            "Im Norden auf der Bruecke bruellt Jemand: ");
        TELLSD(bruecke1,"HEEE, WASN LOS! ICH WERDE ANGEGRIFFEN!",
                      "Der Brueckenposten im Norden bruellt: ");
        TELLSD(sdschungel1,"HEEE, WASN LOS! ICH WERDE ANGEGRIFFEN!",
                      "Im Norden bruellt Jemand: ");      	
      	anzahl=0;
        call_out("wernfried1", 3);
        call_out("ausgangszustand", TIME);//funktion bewegt alle posten auf ihre
        }                                //urspruenglichen plaetze wenn alle
                                         //enemies ausgetragen sind
 
      if(previous_object()->id("hermann")) {
        
        TELLSD(bruecke2,"ALARM! EIN ANGRIFF!!!",
                      "Im Sueden bruellt Jemand: ");                           	
        tell_room(environment(previous_object()),
                  "\nDer Torposten bruellt: ALARM! EIN ANGRIFF!!!\n\n");
        TELLSD(turm,"ALARM! EIN ANGRIFF!!!",
                     "Unten am Tor bruellt Jemand: ");
        TELLSD(bruecke1,"ALARM! EIN ANGRIFF!!!",
                      "Im Sueden bruellt Jemand: ");
        TELLSD(sdschungel1,"ALARM! EIN ANGRIFF!!!",
                      "Der Torposten im Sueden bruellt: ");       
        anzahl=0;        
        call_out("hermann1", 3);
        call_out("ausgangszustand", TIME);
                }
                
                
      if(previous_object()->id("ruediger")) {
             	
      	TELLSD(turm,"ALARM! EIN ANGRIFF AUF DEN TURM!!!",
      	              "Der Wachtmeister bruellt: "); 
      	TELLSD(sdschungel2,"ALARM! EIN ANGRIFF AUF DEN TURM!!!",
      	              "Im Turm bruellt Jemand: ");
      	TELLSD(bruecke2,"ALARM! EIN ANGRIFF AUF DEN TURM!!!",
      	              "Im Sueden bruellt Jemand: ");
      	TELLSD(bruecke1,"ALARM! EIN AUGRIFF AUF DEN TURM!!!",
                      "Im Sueden bruellt Jemand: ");
        TELLSD(sdschungel1,"ALARM! EIN ANGRIFF AUF DEN TURM!!!",
                      "Im Turm im Sueden bruellt Jemand: ");
      	anzahl=0;
      	call_out("ruediger1", 3);
      	call_out("ausgangszustand", TIME);
      	}
        	
     } 
  }
}
//ooooooooooooooooooooooo SUPPORTFUNKT ENDE oooooooooooooooooooooooooooooooooooo



//oooooooooooooooooooooooooo HERMANN ANFANG oooooooooooooooooooooooooooooooooooo

hermann1() {

    int i;
    object *w, obj;
  mann_check();
    w=mann;
    obj = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");
    	
  if(present("ruediger", obj)) {	
    TELLSD(turm,"Kreuzdonner was ist denn da unten los?!","Der Wachtmeister "
                  "bruellt: ");
           }

  if(!present("ruediger", obj)) {
    tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
              "\nDu hoerst lauten Kampflaerm von unten!\n");
        }
        
    for (i=0; i<sizeof(w); i++) {

      w[i]->postenmove_herm();      
   }                
}


hermann2() {//wird aus wachtmeister.c aufgerufen, oder aus posten.c wenn 
         //vorheriger nicht vorhanden. ist notwendig um zeitdifferenz zu schaffen                      
  call_out("hermann3", 2);
    }


hermann3() {
	
	object dante;
	int i;  
	object *w;
	namen=({});
	dante=find_player("dante");
  mann_check();
	w=mann;
	
	for(i=0; i<sizeof(w); i++ ) {
		
		nam=w[i]->QueryProp(P_NAME);
		namen+=({ nam  });
		
		if(dante)  {
			
			tell_object(dante, " namen: "+nam+" \n");
		}
	}
	//wenn -1 dann nicht gefunden , wenn ungleich -1 gefunden!!!
	
	if( member_array("Brueckenposten", namen)!=-1 && 
	member_array("Wachposten", namen)!=-1 )  {
		
		call_out("hermann3b", 1);
	}
	
	if( member_array("Brueckenposten", namen)==-1 &&
        member_array("Wachposten", namen)!=-1 )  {
        	
        	call_out("hermann3a", 1);
        }
        
        if( member_array("Brueckenposten", namen)!=-1 &&
        member_array("Wachposten", namen)==-1 )  {
        	
        	call_out("hermann3c", 1);
        }
        
        if( member_array("Brueckenposten", namen)==-1 &&
        member_array("Wachposten", namen)==-1 )  {
        	
        	//tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", 
        	//"\n!!!KEINE POSTEN!!!\n\n");
        	return 0;
        }
}



