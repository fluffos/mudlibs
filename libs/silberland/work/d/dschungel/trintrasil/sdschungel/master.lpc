//ooooooooooooooooooooooo AUSGANGSZUSTAND ANFANG oooooooooooooooooooooooooooooooo

/*Diese Funktion soll den urspruenglichen Zustand vor dem Angriff wieder 
herstellen (die getoeteten posten bleiben natuerlich tot :)). Sie wird von der 
supportfunkt. das erste mal aufgerufen, und ruft sich dann so lange regelmaessig 
selber auf bis die npc nicht mehr InFight sind (alle 15 min) und sie voll 
ausgefuehrt wird. Sind die posten im Kampf wird sie abgebrochen.*/

int ausgangszustand() {
	
int p, u, i;//p=anzahl der ueberlebenden posten,i und u fuer forschleifen 
object turm, tor, bruecke, *w;//sind alle raeume geladen wenn mann
  mann_check();
w=mann;
p=sizeof(mann);

turm = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");
tor = find_object("/d/dschungel/trintrasil/sdschungel/room/sdschungel2");
bruecke = find_object("/d/dschungel/trintrasil/sdschungel/room/bruecke2");	

//tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", "!!AUSGANG!!\n\n");


if(!mann) {
//tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", "!!NOMANN!!");	
	return 0;}//alle maenner wurden getoetet, funktion sinnlos
	
	
	
if(mann) {

//tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", "!!MANN!!\n\n");

   for( i=0;i<sizeof(w);i=sizeof(w) ) {/*pervertierte forschleife...

es soll nur ermittlet werden ob irgendein posten i, array mann InFight ist.
Ist einer im kampf sind automatisch alle anderen auch im kampf, somit ist nur
ein einmaliges abfragen noetig. weiters soll die forschleife nur einmal durch-
laufen werden da sonst die funkt. ausgangszustand mehrmals gleichzeitig 
ausgefuehrt werden wuerde... zwar unedel aber es funktioniert.. */
//tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", "!!FOR!!\n\n");
     
     if(objectp(mann[i]) && mann[i]->InFight()) {//maenner die gerade kaempfen sollen nicht 
     	                      //zurueckgesetzt werden
//tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", "!!MANN KAEMPFT!!\n\n");     	
call_out("ausgangszustand", TIME);      	
     	return 0; }	      
   	
   	
   	
else {
//tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", 
//          "!!MANN KAEMPFT NICHT!!\n\n");     	
	
  if(present("posten", turm) && !present("posten", tor) &&
     !present("posten", bruecke)) { //normalerweise koennen die posten nach einem
                                    //kampf nur mehr alle in einem der raeume 
                                    //stehen, reine sicherheitsabfrage 
		
//++++++++++++++++++++++++++++++ TURM +++++++++++++++++++++++++++++++++++++++++++
			
    if(present("ruediger", turm)) {//checkt indirekt ab wo der kampf 
                       //stattgefunden hat da die posten den kampfplatz nicht 
                       //verlassen koennen (nomove, nowimpy..)
    	if(p>=3) {
		TELLSD(turm,"Scheint wieder alles ruhig zu sein. Alle zurueck "
		            "auf ihre Posten bis die Abloese kommt!",
		            "Der Wachtmeister sagt: ");     
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                  if(objectp(w[u]))
                	  w[u]->turm_reset();//siehe turm_reset in den einzelnen
	                }                    //posten
		       }
		        
        if(p==2) {
    	
    	        TELLSD(turm,"Scheint wieder alles ruhig zu sein. Nimm Deinen "
    	                    "Posten wieder ein bis die Abloese kommt! Verdammt "
    	                    "viele Verluste!","Der Wachtmeister sagt: ");     
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                   if(objectp(w[u]))
                	  w[u]->turm_reset();
	                }    	                
    	               }
    	                
        if(p==1) {
               
                anzahl=1;                             
            
                for (u=sizeof(w)-1;u>=0;u--) {
                   if(objectp(w[u]))
                	  w[u]->turm_reset();
                	  }
// tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", "!!P=1!!");
                }//es gibt keine maenner die auf ihre posten gehen sollten
           
              }
        
        
    if(!present("ruediger", turm) && present("hermann", turm)) {
    	
    	if(p>=2) { 
    		
    		TELLSD(turm,"Scheint alles wieder ruhig zu sein. Wir sollten "
    		            "auf unseren Posten zurueck bis die Abloese "
    		            "kommt.","Der Torposten sagt: ");
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                   if(objectp(w[u]))
                	  w[u]->turm_reset();
	                }             
    		       }
    		        
        if(p==1) {
                
                anzahl=1;
                for (u=sizeof(w)-1;u>=0;u--) {
                   if(objectp(w[u]))
                	  w[u]->turm_reset();
	                }        	
        	      }
        
                   }
        
        
    if(!present("ruediger", turm) && !present("hermann", turm) && 
        present("meinhart", turm)) {
        	
        if(p==2) {
        	
                TELLSD(turm,"Scheint jetzt alles ruhig zu sein. Wir sollten "
                            "wieder unsere Posten einnehmen. Die Abloese wird "
                            "ohnehin bald kommen.",
                            "Der Wachposten Meinhart sagt: ");
                call_out("anzahl_reset", 6);
                for (u=sizeof(w)-1;u>=0;u--) {
                  if(objectp(w[u]))	
                	  w[u]->turm_reset();
	                }  
                       }
                        
         if(p==1) {
         	
                TELLSD(turm,"Hoffentlich war das der letzte Angriff bis die "
