//oooooooooooooooooooooooooo WERNFRIED ANFANG ooooooooooooooooooooooooooooooooooo

wernfried1() {

    int u;
    object *w, turm, tor, busch;
  mann_check();
    w=mann;
    turm = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");
    tor = find_object("/d/dschungel/trintrasil/sdschungel/room/sdschungel2");
    busch = find_object("/d/dschungel/trintrasil/sdschungel/room/busch-h");
    
  if(present("ruediger", turm) && present("hermann", tor)) {
  	
    TELLSD(turm,"Himmel und Hoelle! Was ist denn da auf der Bruecke los!",
                "Der Wachtmeister flucht: ");	
    TELLSD(sdschungel2,"Donnerluetchen was ist denn da im Norden los?!",
                       "Der Torposten flucht: ");
              }

  if(present("ruediger", turm) && !present("hermann", tor)) {

    TELLSD(turm,"Himmel und Hoelle! Was ist denn da auf der Bruecke los!",
                "Der Wachtmeister flucht: ");
        }
  
  if(!present("ruediger", turm) && present("hermann", tor)) {
  	
    TELLSD(sdschungel2,"Donnerluetchen was ist denn da im Norden los?!",
                       "Der Torposten flucht: ");
        }
        
  if( !present("ruediger", turm) && !present("hermann", tor) && 
       present("meinhart", busch) ) {  	
    tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
              "\nDu hoerst ein Fluchen im Gebuesch!\n");
    }
	
  if( !present("ruediger", turm) && !present("hermann", tor) &&
      !present("meinhart", busch) ){
      	
      	return 0;}//wenn wegen einer unerklaerlich seuche alle posten von der 
      	          //support unerklaerlich tot sein sollten (rein theoretisch
      	          //moeglicher fall.. abgeklaert zur sicherheit..)
      	
    for (u=sizeof(w)-1;u>=0;u--) {

      if( objectp(w[u]) )
        w[u]->postenmove_wern();      
   }                
}


wernfried2() {

  call_out("wernfried3", 2);
}


wernfried3() {

  object dante;
  int i;  
  object *w, obj;
  namen=({});
  obj = find_object("/d/dschungel/trintrasil/sdschungel/room/bruecke2");
  namen=({});
  mann_check();
  w=mann;
  dante=find_player("dante");

  for(i=0; i<sizeof(w); i++ ) {

    if( objectp(w[i]))
    {
      nam=w[i]->QueryProp(P_NAME);

      namen+=({ nam  });

      if(dante)  {
        tell_object(dante,
            " namen: "+nam+" \n");
      }
    }
  }

 if( member_array("Wachposten", namen)==-1) {
 	return 0;}//ist der wachposten meinhart tot kann er nicht gerufen werden 

 if( member_array("Wachposten", namen)!=-1) {  

  if(present("ruediger", obj)) {
 	
  TELLSD(turm,"VERDAMMT GARDIST MEINHART WO BLEIBST DU?!?",
              "Im Norden bruellt Jemand: ");      
  TELLSD(sdschungel2,"VERDAMMT GARDIST MEINHART WO BLEIBST DU?!?",
              "Im Norden bruellt Jemand: ");
  TELLSD(sdschungel1,"VERDAMMT GARDIST MEINHART WO BLEIBST DU?!?",
                     "Im Nordem bruellt Jemand: ");
  TELLSD(bruecke1,"VERDAMMT GARDIST MEINHART WO BLEIBST DU?!?",
                  "Im Norden bruellt Jemand: ");   	  
  TELLSD(bruecke2,"VERDAMMT GARDIST MEINHART WO BLEIBST DU?!?",
                  "Der Wachtmeister bruellt: ");
}
    

  if(!present("ruediger", obj) && present("hermann", obj)) {

  TELLSD(turm,"VERDAMMT MEINHART WO BLEIBST DU?!?",               
              "Im Norden bruellt Jemand: ");
  TELLSD(sdschungel2,"VERDAMMT MEINHART WO BLEIBST DU?!?",
                     "Im Norden bruellt Jemand: "); 
  TELLSD(sdschungel1,"VERDAMMT MEINHART WO BLEIBST DU?!?",
                     "Im Nordem bruellt Jemand: "); 
  TELLSD(bruecke1,"VERDAMMT MEINHART WO BLEIBST DU?!?",
                  "Im Norden bruellt Jemand: ");   	  
  TELLSD(bruecke2,"VERDAMMT MEINHART WO BLEIBST DU?!?",
                  "Der Torposten bruellt: ");   
}

  if(!present("ruediger", obj) && !present("hermann", obj)) {
 	
   return 0;}
  }
}
