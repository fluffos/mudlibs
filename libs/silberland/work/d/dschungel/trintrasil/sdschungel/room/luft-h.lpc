
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create()
{
  ::create();

  SetProp( P_INT_SHORT, "vom Sandwurm verweht" );
  SetProp( P_INT_LONG, BS(
  "Unnoetig!"));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );
  SetProp(P_KILL_NAME, "Ein harter Aufprall");
   AddCmd ("", "no", 1);   
  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
  int no()
  {
    write (
    "Benommen vom Schlag segelst Du durch die Luft!\n");
      return 1;
    }
     
    
  init() {
  ::init();

  if(query_once_interactive(this_player())){
  call_out("sturz1", 3);}
  }
  

   sturz1() {
    
   NIX
   Z1
   write(BS(
   "Benommen und vernebelt vom harten Schlag spuerst Du undeutlich wie Du "
   "durch die Luft gewirbelt wirst."));
   call_out("sturz2", 3);
     }
   
   
    
   sturz2() {
   
   NIX
   Z1
   write(BS(
   "Dumpf merkst Du, dass Du den Zenit Deiner Flugbahn erreicht hast."));
   call_out("sturz3", 2);
     }
 
 
   
   sturz3() {
   
   NIX
   Z1
   write(BS(
   "Der Boden stuerzt wieder rasend schnell auf Dich zu!"));
   call_out("sturz4", 2);  
     }
    
   sturz4() {
   	
   NIX
   Z1
   write(
   "!!!!!!!!!!BBBBBUUUUUMMMMMMMMMM!!!!!!!!!!\n\n"
   "Du schlaegst unglaublich hart auf dem Strand auf!\n");
   TP->do_damage(50+random(10));
   tell_room("/d/dschungel/trintrasil/sdschungel/room/strand1",
             ""+TPN+" stuerzt aus dem Himmel herab.\n\n");
   TP->move("/d/dschungel/trintrasil/sdschungel/room/strand1", M_GO+ M_NO_SHOW+
            M_SILENT);   
}
   
    
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/sdschungel/room/strand1",M_GO+ 
	M_SILENT+ M_NO_SHOW);
	return 1;
	}
   
   
void NotifyPlayerDeath(object player, object killer, int lostexp) {
      	
  object leiche;
  leiche=present("leiche", TO);
      
    if (leiche)  {
      	
      	leiche->move("d/dschungel/trintrasil/sdschungel/room/strand1",
      	M_TPORT+M_SILENT);
      	
        tell_room("d/dschungel/trintrasil/sdschungel/room/strand1",
                  "Die Leiche von "+CAP(getuid(TP))+" faellt vom Himmel! ");
                  }           
                }    
   