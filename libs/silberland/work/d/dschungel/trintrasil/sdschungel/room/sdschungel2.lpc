


inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <ansi.h>


reset()  {
//tell_room(TO,
//"test!\n");
if( previous_object() && 
   file_name(previous_object())=="/d/dschungel/trintrasil/sdschungel/master")  
   { 
  // 	tell_room(TO,
//"test master!\n");
::reset();
return;
}
if( previous_object() && 
   file_name(previous_object())!="/d/dschungel/trintrasil/sdschungel/master")  
   {
//tell_room(TO,"nixmaster!\n");
}
 return; 
}


create() { 

  ::create();
  
//erklaerung siehe bruecke2

//call_other("/d/dschungel/trintrasil/sdschungel/room/bruecke2", "load");
call_other("/d/dschungel/trintrasil/sdschungel/room/turm", "load");
call_other("/d/dschungel/trintrasil/sdschungel/room/busch-h", "load");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
  
  
  "Der verwachsene Pfad endet hier vor einem hohen Palisadentor. Links und "
  "rechts vom Weg wuchert der Dschungel so ueppig das Du nur durch das Tor "
  "weiterkommen koenntest. Neben dem Tor steht ein grosser hoelzener "
  "Wachturm.")); 
   
   
 AD(({"pfad","dschungelpfad","weg","dschungelweg"}),
   "Der Pfad fuehrt nach Sueden in die unerforschte Wildnis. Nach Norden "
   "fuehrt er aus dem Dschungel heraus zu einer Haengebruecke die grosse "
   "Schlucht ueberspannt.");
 
 AD(("sueden"),
   "Der Pfad wird hier nach sueden von einer Palisade versperrt.");

 AD(({"sandsteinschlucht","schlucht"}),
   "Die Sandsteinschlucht wuerdest Du besser ueberblicken koennen wenn Du nach "
   "Norden aus dem Dschungel heraus an den Rand der Schlucht gehen wuerdest. "
   "So siehst Du nicht bis auf den Grund der Schlucht, hoerst aber das Rauschen "
   "eines Wasserfalles aus dem Westen.");
   
 AD(("rauschen"),
   "Das Rauschen wird durch den Dschungel etwas gedaempft, aber der Wasserfall "
   "muss wirklich gewaltig sein.");
        
 AD(({"wasserfall"}),
   "Vielleicht siehst Du ihn vom Rand der Schlucht aus.");

 AD(({"breite"}),
   "Der gewaltige Wasserfall ist hier sicher 60 meter breit.");

 AD(({"rio","rio de la puseta","puseta","fluss"}),
   "Vom Rand der Schlucht aus koenntest Du den gruenen Fluss ueberblicken.");

 AD(({"bruecke","haengebruecke"}),
   "Die Bruecke ueberspannt noerdlich von Dir die gewaltige Schlucht.");

 AD(("wind"),
   "Vom Wind spuerst Du hier zwischen den Baeumen kaum etwas.");
   
 AD(("himmel"),
   "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");
  
 AD(({"wildnis","dschungel"}),
   "Abseits des Pfades bis knapp an den Rand der Schlucht wuchern hier "
   "Straeucher, Baeume, Farne, Blumen und Graeser, die Du alle noch nie zuvor "
   "gesehn hast. Ausser ueber den Pfad ist es so gut wie unmoeglich in diese "
   "verfilzte Wildnis vorzudringen."); 
 
 AD(({"farn","farne"}),
   "Grosse, dunkelgruene Farne draengen sich im Schatten zwischen den Baeumen.");
 
 AD(("schatten"),
   "Um diese verfilzte, schattige Wildnis genauer zu erforschen muesstest Du "
   "tiefer in den Dschungel vordringen. Vielleicht kannst Du das Palisadentor "
   "oeffnen.");
   
 AD(({"blume","blumen","kelche","bluetenkelche","blueten"}),
   "Ihre farbigen Bluetenkelche leuchten aus dem Schatten der Baeume.");
 
 AD(({"wolken","wolke"}),
   "Die Wolken scheinen hier zum Greifen nahe.");
 
 AD(({"gras","graeser"}),
   "Das Gras waechst in der feuchten, heissen Luft ueppig und fett.");
 
 AD(({"baum","baeume","strauch","straeucher"}),
   "Die Baeume und Straeucher schieben sich bis auf wenige Meter an den "
   "Rand der Schlucht heran. Wahrscheinlich ist ihnen am Schluchtrand der "
   "Boden zu steinig.");
 
 AD(("boden"),
   "Der Pfad ist mit Laub bedeckt und beginnt stellenweise zu verwachsen. "
   "Er sieht ziemlich wenig benutzt aus.");

 AD(("laub"),
   "Das Laub vermodert hier schnell und ist teilweise schon ganz schwarz.");
   
 AD(({"rand","schluchtrand"}),
   "Wenn Du nach Norden direkt an den Schluchtrand gehst ueberblickst Du "
   "sicher die gesamte Schlucht.");
   
 AD(("grund"),
   "Tief unter Dir am Grund der Schlucht, eingefasst von diesen gelben "
   "senkrechten Sandsteinwaenden, fliesst der ´Rio de la Puseta ´.");
   
 AD(({"sandsteinwand","sandsteinwaende","uferwand","uferwaende","felswand",
      "wand","suedliche felswand","waende","felswaende"}),
   "Die gewaltigen Sandsteinwaende schimmern gelb im Sonnenlicht. Im Norden "
   "kannst Du die strahlenden, gelben Sandsteinwaende besser bewundern.");
   
 AD(({"sonnenlicht","licht","sonne"}),
   "Obwohl hier die Baeume Schatten spenden, waere es in der Schlucht sicher "
   "kuehler.");
      
 AD(("wasser"),
   "Das funkelnde Wasser kannst Du von hier aus nicht sehen.");

 AD(("palisade"),
   "Hier versperrt den Pfad eine hohe Palisade aus dicken Staemmen. Sie "
   "erstreckt sich nach links und rechts vom Pfad hinein in den "
   "undurchdringlichen, verwachsenen Dschungel. In die Palisade ist ein sehr "
   "massiv aussehendes Tor eingebaut, neben dem ein Wachturm steht.");
   
 AD(({"stamm","staemme","ueberklettern"}),
   "Die Staemme sind sehr dick und oben zugespitzt. Ein Ueberklettern ist "
   "unmoeglich.");
   
 AD(({"hafenstadt","stadt","tijara"}),
   "Die grosse Hafenstadt weiter noerdlich von hier kennt jeder.");
   
 AD(({"palisadentor","tor"}),
   "In der Palisade ist ein Tor eingelassen das mit einem dicken Riegel "
   "versperrt ist. Der Riegel ist mit einer Kette gesichert an der ein grosses "
   "Vorhaengeschloss haengt.");

 AD(("riegel"),
   "Der Riegel ist nicht so leicht zu brechen. Um ihn zu oeffnen muesstest "
   "Du erst das Schloss oeffnen.");
   
 AD(("kette"),
   "Die Kette ist mit einem Vorhaengeschloss gesichert und sieht ziemlich "
   "unzerstoerbar aus.");
   
 AD(({"vorhaengeschloss","schloss"}),
   "Den Schluessel fuer dieses Schloss hast Du leider nicht.");
   
 AD(({"turm","wachturm","hochsitz","sitz"}),
   "Der hoehlzerne Wachturm ist gebaut wie ein ueberdachter Hochsitz. Er ist "
   "gerade hoch genug um die maechtigen Baeume des Dschungels ueberblicken zu "
   "koennen. Man kann ueber eine Leiter in ihn klettern.");
 
 AD(({"poren","schweiss","luft"}),
   "Die feuchte, heisse Luft treibt Dir den Schweiss aus allen Poren.");

 AD(("leiter"),
   "Ueber die Leiter kommst Du in den Wachturm.");
   
      
 ASD(({"strafdienst","dienst"}),
   "strafdienst");
    
 ASD(("schluessel"),
   "schluessel");
   
 ASD(({"wache","waechter"}),
   "wache");

 ASD(("gardist"),
   "gardist");


AddItem("/d/dschungel/trintrasil/sdschungel/npc/posten.lpc",
        REFRESH_DESTRUCT);
   

//AddCmd(("toete"), "func_hilfe");

AddCmd(("oeffne"), "func_open");

AddCmd(({"brich","breche","zerbreche"}), "func_riegel");


AddExit("norden", "/d/dschungel/trintrasil/sdschungel/room/sdschungel1");

AddExit("sueden", ([
        EX_FUNC:"wegsperre"]) );

AddExit("turm", ([
        EX_FUNC:"turm"]) );
        
           
  AddSound( DEFAULT_SOUND,
    "Aus der Schlucht hoerst Du das Rauschen eines Wasserfalles.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist hier drueckend und feucht.");
  
 // AddCmd("test", "test");
}

int test()  {
	call_other("/d/dschungel/trintrasil/sdschungel/master", "reset");
	return 1; }
	

int func_open(string str) {
	
	notify_fail("Was willst Du oeffnen?\n");
	
	if(str=="tor"||str=="palisadentor"||str=="tuer") {
		
		write(BS("Du ruettelst etwas hilflos am Palisadentor, bist Dir "
		         "aber insgeheim bewusst das es dadurch nicht "
		         "aufgeht."));
		         
		 say(BS(""+TPN+" ruettelt hilflos am Palisadentor."));
		
	return 1;}
	
	if(str=="schloss"||str=="riegel"||str=="kette"||
	   str=="vorhaengeschloss") {
	   	
	   	write(BS("Um das schwere Schloss zu oeffnen, das die dicke Kette "
	   	         "haelt, brauchst Du einen Schluessel. Das Schloss "
	   	         "aufzubrechen sieht beinahe unmoeglich aus."));
	   	         
	   return 1;}
	 return 0;}
	 
	 
	 
  int func_riegel(string str) {
  	
  notify_fail("Was willst Du aufbrechen?\n");
  
  if(str=="schloss"||str=="vorhaengeschloss"||str=="schloss auf"||
     str=="vorhaengeschloss auf") {
  	
  	write(BS("Du siehst Dir das Schloss genauer an und erkennst die "
  	         "Laecherlichkeit eines Vorhabens."));
  	return 1;}
  	
  if(str=="riegel auf"||str=="riegel") {
  	
  	write(BS("Du stemmst Dich mit aller Kraft gegen den Riegel, der "
  	         "nichteinmal knarrt, geschweige denn sich bewegt."));
  	return 1;}
  	
  if(str=="tor"||str=="palisadentor"||str=="tor auf"||str=="palisadentor auf") {
  	
  	write("!!WWUUUMMMMM!! \n"
  	      "Du rennst mit voller Wucht gegen das Tor, aber ausser das Du "
  	      "Dir dabei die \nSchulter prellst passiert eigentlich nichts.\n");
  	say(BS(""+TPN+" rennt mit voller Wucht gegen das Tor."));
  	TP->do_damage(2);
  	return 1;}
  
  if(str=="kette"||str=="kette auf") {
  	
  	write(BS("HAHAHA! Was fuer eine lustige Idee ein Kette aufzubrechen "
  	         "die beinahe so dick ist wie Dein Arm! Selbstvertrauen hast Du "
  	         "wenigstens genuegend."));
  	return 1;}
  return 0;}
  
    	 
    	 
  
   
   
wegsperre() {
	
 write(BS("Das Palisadentor ist verschlossen. Du bekommst es leider nicht "
          "auf.\n"));
        return 1;}
        
        
        
turm() {
	
 Z1	
 write(BS("Du kletterst ueber die hohe Leiter auf den Wachturm."));
 Z1
 S1
 say(BS(""+TPN+" klettert auf den Wachturm."));
 SD1(turm)
 tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
        BS(""+TPN+" klettert herauf."));
 TPM("/d/dschungel/trintrasil/sdschungel/room/turm", M_TPORT+ M_SILENT);
         return 1;}


  
  
  
schluessel() {
	
  if(present("posten", TO)) {
    return BS("Du koenntest ja einmal den Posten fragen ob er vielleicht "
              "das Tor oeffnen koennte.");
        }
        
  if(!present("posten", TO)) {
    return BS("Wer den wohl hat?");
        }
}

wache() {
	
  if(present("posten", TO)) {
    return BS("Die Wachposten ist ein Gardist aus Tijara.");
        }
        
  if(!present("posten", TO)) {
    return BS("Eigenartig, das Palisadentor ist vollkommen unbewacht.");
        }
 }
 


gardist() {
	
  if(present("posten", TO)) {
    return BS("Er hat wohl Strafdienst das er hier in der Wildnis Wache "
              "schieben muss. Vielleicht freut er sich wenn er wen zum Reden "
              "hat.");
        }
         	
  if(!present("posten", TO)) {
    return BS("Eigenartig, das Palisadentor ist vollkommen unbewacht.");
        }
}



strafdienst() {
	
  if(present("posten", TO)) {
    return BS("Ich kann mir vorstellen das der Dienst hier eher unbeliebt "
              "ist.");
        }
        
  if(!present("posten", TO)) {
    return BS("Das Palisadentor ist vollkommen unbewacht.");        
        }
}
