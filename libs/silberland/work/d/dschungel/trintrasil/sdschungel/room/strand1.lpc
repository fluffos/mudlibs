


inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>

int wurm=1;
int wurzel=1;


reset() {
   ::reset();
   wurm=1;
   wurzel=1;}
   

create() { 

::create(); 

SetProp( P_LIGHT, 1 ); 
SetProp( P_INDOORS, 0 ); 
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_JUNGLE]) );  
SetProp( P_INT_SHORT, "Strand des 'Rio de la Puseta'" ); 
SetProp( P_INT_LONG, BS(

  "Der schmale Sandstrand schmiegt sich eng an die maechtige Uferwand. "
  "Nach Westen fuehrt der Strand fast bis an den tosenden Wasserfall heran, "
  "gegen Osten wird er immer schmaeler und endet schliesslich bald. Direkt "
  "neben Dir fuehrt eine schwindelerregende Pfahltreppe an der Uferwand hinauf "
  "bis an den Rand der Schlucht." )); 

   
 AD(({"treppe","pfahltreppe"}), 
   "Die Treppe besteht aus dicken runden Holzpfaehlen die in kurzen Abstaenden " 
   "aufsteigend in die senkrechte Felswand gehauen wurden, sodas man an ihnen "
   "empor steigen kann.");

 AD(({"abstand","abstaende"}),
   "Die Abstaende ziwschen den Holzpfaehlen ist gering, trotzdem sieht die "
   "lange Treppe recht abenteuerlich aus.");

 AD(({"pfaehle","holzpfaehle","pfahl","holzpfahl","pfloecke","holzpfloecke"}),
   "Die ogerarmdicken Holzpfaehle sehen so aus als koennten sie Dich "
   "problemlos tragen.");
   
 AD(({"wand","felswand","sandsteinwand","waende","felswaende","sandsteinwaende",
      "schluchtwand","schluchtwaende","suedliche wand","suedliche felswand",
      "suedliche sandsteinwand","sandstein","stein","uferwand","ufer","hoehe"}),
   "Die gelbe, Sandsteinwand der Schlucht erstreckt sich ca 250 Meter nahezu "
   "senkrecht in die Hoehe.");

 AD(({"schlucht","sandsteinschlucht"}),
   "Du befindest Dich nun am Grund der Schlucht am Ufer der 'Rio de la Puseta'. "
   "Der gruen schimmernde Fluss fliesst gemaechlich von Westen nach Osten.");

 AD(("grund"),
   "Der Rand der Schlucht, ueber dem der Dschungel liegt, ist weit ueber Dir.");
    
 AD(({"schluchtrand","rand"}),
   "Weit ueber Dir ueberspannt eine Haengebruecke die Schlucht.");
   
 AD(({"bruecke","haengebruecke"}),
   "Die Bruecke hebt sich nur als schmales dunkles Band vom Himmel ab.");
   
 AD(("band"),
   "Sie ist immerhin ca 250 Meter ueber Dir.");
   
 AD(("dschungel"),
   "Um in den Dschungel zu gelangen musst Du Dich die gesamte Treppe hinauf "
   "quaelen.");

 AD(({"rio","rio de la puseta","puseta","wasser","fluss"}),
   "Das Wasser des Rio de la Puseta schillert gruen. Der Fluss ist hier in "
   "der Schlucht ca 100 Meter breit und fliesst gemaechlich von Westen nach "
   "Osten.");

 AD(("westen"),
   "Im Westen donnert unablaessig der grosse Wasserfall.");

 AD(("osten"),
   "Weiter im Osten scheint der Fluss eine Biegung nach Sueden zu machen, aber "
   "der Sandstrand ist schon weit davor zu ende.");

 AD(("biegung"),
   "Von hier aus kannst Du die Biegung nicht gut erkennen.");

 AD(({"wasserfall","massen","wassermassen"}),
   "Gewaltige Wassermassen donnern ueber den Wasserfall weiss schaeumend in den "
   "Rio de la Puseta. Feine weisse Schleier ziehen vom aufgewirbelten Wasser "
   "von Westen heran.");

 AD(({"sonne","sonnenlicht","himmel"}),
   "Der Himmel ist strahlendblau.");
 
 ASD(("boden"),
   "boden");

 ASD(("wurzel"),
   "wurzel");
   
 AD(({"sandstrand","strand"}),
   "Der Strand ist nur wenige Meter breit. Im Westen fuehrt er nahezu ganz an "
   "den weiter entfernten Wasserfall heran, im Osten wachsen ein paar Pflanzen "
   "in diesem feuchten, feinen Sand.");

 AD(("pflanzen"),
   "Sieh sie Dir doch an.");
   
 AD(("sand"),
   "Der Sand der hier vom Fluss angespuelt wurde ist sehr fein. Du sinkst beim "
   "Gehen tief ein.");

 AD(("gehen"),
   "Du sinkst tief im feuchten, feinen Sand ein.");
   
 AD(({"nieselregen","regen","schleier"}),
   "Vom Wasserfall weht ein leichter Nieselregen her.");
         
 AD(("treibsand"),
   "Ja, im Westen sieht man wirklich etwas Treibsand.");

 AddItem("/d/dschungel/trintrasil/sdschungel/npc/krabbe.lpc",
         REFRESH_DESTRUCT);
         
         
 AddCmd(({"reisse","ziehe","zerre"}), "func_wurm");
 AddCmd(("pfeife"), "no_pfeif_func");
 
          
 //AddExit("osten", "/d/dschungel/trintrasil/fluss/room/strand2");
 AddExit("ostoben", "/d/dschungel/trintrasil/sdschungel/room/treppe5");
AddExit(("osten"),
        ([EX_FUNC:"osten"])); 
AddExit(("westen"),
        ([EX_FUNC:"westen"]));
   
   
  AddSound( DEFAULT_SOUND,
    "Das Tosen des Wasser uebertoent hier fast alles.");
  
  AddSound(({"wasserfall","wasser","tosen"}),
    "!!!WWWUUUSSSCCCHHHHH!!!");
      
  AddSmell( DEFAULT_SMELL,
    "Der Sand riecht etwas modrig.");
  
  
}


int func_wurm(string str) {
	
	notify_fail("An was willst Du ziehen?\n");
  	
        if(str=="wurzel aus"||str=="an wurzel"||str=="wurzel") {
        	
        	if( wurm && wurzel && !present("sandwurm", TO) ) {
        		
        		write(BS("Du zerrst an der knorrigen Wurzel, ein kleiner Sandstrudel "
                        "entsteht."));
                        say(BS(""+TPN+" zerrt an einer knorrigen Wurzel. Der Sand beginnt sich "
                        "seltsam zu bewegen."));
                        wurzel=0;
                        call_out("wurm1", 2);
                        return 1;
                }
                
                if( present("sandwurm", this_object()) ) {
                	
                	write(BS("Der Sandwurm springt ploetzlich fauchend auf Dich zu und "
                	"laesst Dich nicht zur Wurzel!"));
                        say(BS("Der Sandwurm springt ploetzlich fauchend auf "+TPN+" zu!"));
                        return 1;
                }
                
                if( wurm==0 && wurzel && !present("sandwurm", this_object()) ) {
                	
                	write(BS("Du zerrst an der knorrigen Wurzel, aber sie laesst sich "
                	"nicht ausreissen und nichts passiert."));
                        say(BS(""+TPN+" zerrt an einer knorrigen Wurzel."));
                        return 1;
                }
                
                if( (!present("sandwurm", this_object())) && (wurzel==0) ) {
                	
                	write(BS("Die Wurzel ist doch schon ausgerissen!"));
                        return 1;
                }
                return 0;
        }
        return 0;
}

      
      
wurm1() {
	
	tell_room("/d/dschungel/trintrasil/sdschungel/room/strand1", BS("Die Erde beginnt zu "
	"vibrieren."));
        call_out("wurm2", 2);
}	



wurm2() {
	
	object wurm;
        int i;
        object *pls;
        string hier;

        pls=users();

        if(!sizeof(pls))  {
        	
        	return;
        }
        
        for(i=sizeof(pls)-1; i>=0; i--) {
        	
        	if (environment(pls[i])) {
        		
        		hier=file_name(environment(pls[i]));
        		
        		if(hier!= "/d/dschungel/trintrasil/sdschungel/room/strand1"  &&
                        hier[0..12]=="/d/dschungel/")  {
                        	
                        	tell_object(pls[i], BSL("\n\nDu hoerst das unheimliche Geheul "
                        	"eines Sandwurmes!\n"+CAP_TPN+" fuerchtet sich zu Tode!\n\n"));
                        }
                }
        }
        
        tell_room("/d/dschungel/trintrasil/sdschungel/room/strand1", BS("Ein gewaltiger "
        "Sandwurm kriecht vor Dir aus dem Sand!"));
        wurm=0;
        wurm=CLONEOB("/d/dschungel/trintrasil/sdschungel/npc/sandwurm");
        wurm->move("/d/dschungel/trintrasil/sdschungel/room/strand1", M_TPORT+ M_SILENT);              
}



westen() {
	
	write(BSL("\nDu willst nach Westen gehen, doch im letzten Moment erkennst Du, dass "
	"hier Treibsand beginnt!\n\n"));
        return 1;
}


osten() {
       
   if( TP->QueryProp(P_NAME)=="Feyaria"||TP->QueryProp(P_NAME)=="Dante"||TP->QueryProp(P_NAME)=="Trintrasil" ) {

      TP->move("/d/dschungel/trintrasil/fluss/room/strand2", M_GO);
      return 1;
   }

   else {
      
      write(BSL("Du merkst, dass der Osten seltsam formlos ist. Anscheinend sind dort gerade gestaltende, kosmische "
      "Kraefte am Werk. Zur Zeit gehst Du dort besser nicht hin."));
      return 1;
   }
}


boden() {
	
	if(wurzel) {
		
		return BS("Der Sand ist sehr fein und weich, halb vom Sand verborgen "
                "entdeckst Du eine seltsam Wurzel.");
        }
        
        if(!wurzel) {
        	
        	return BS("Der Sand ist sehr fein und weich, am Boden liegt eine "
                "ausgerissenen Wurzel."); 
        }
}

            
            
wurzel() {
	
	if(wurzel) {
		
		return BS("Was soll denn die Wurzel da? Versucht einmal sie auszureissen.");               
        }
        
        if(!wurzel) {
        	
        	return BS("Die Wurzel liegt doch schon ausgerissen am Boden.");
        }
}



no_pfeif_func(string str) {
	
	object pfeife;
	
	pfeife = present("fischpfeife", TP);
	
	notify_fail("Mit was willst Du pfeifen?\n"); 
	
	if(str=="mit pfeife"||str=="mit fischpfeife"||str=="nach fisch mit pfeife"||
        str=="pfeife"||str=="fischpfeife"||str=="fisch"||str=="nach fisch"||
        str=="fisch mit pfeife"||str=="nach fischen mit pfeife"||
        str=="nach fischen"||str=="fische mit pfeife"||str=="nach fischen"||
        str=="fische"||str=="fisch an"||str=="fische an"||
        str=="fisch mit pfeife an"||str=="fische mit pfeife an"||
        str=="mit fischpfeife an"||str=="fisch mit fischpfeife an"||
        str=="fische mit fischpfeife an"||str=="fisch herbei") {
        	
        	if(!pfeife) {
        		
        		write(BS("Du hast ja gar keine Fischpfeife."));
        		return 1;
        	}
        	
        	if(pfeife) {
        		
        		write(BSL("Du haeltst den Kopf ins Wasser und blaest heftig in Deine "
        		"Fischpfeife aber nichts passiert.\nHier ist offenbar nicht der ideale "
        		"Platz um Fische anzulocken."));
        		return 1;
        	}
        }
        
        else {
        	return 0;
        }
}
