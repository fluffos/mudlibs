


inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>


create() {

call_other("/d/dschungel/trintrasil/sdschungel/room/turm", "load");	
call_other("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", "load");
/*obwohl der spieler diesen raum nur ueber sdschungel2 oder bruecke2 
(auch hier wird load nach sdschungel2 aufgerufen) erreichen kann, ist das
zur sicherheit hier damit die abfrage bei den specialDetails funzt*/	
	 
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
  
  
  "Hier ueberspannt eine lange, maechtige Haengebruecke die Schlucht. Nach "
  "Sueden fuehrt ein halb ueberwucherter Dschungelpfad in unbekannte "
  "Wildnis, der aber schon nach wenigen Metern an einem gewaltigen "
  "Palisadentor endet. Du stehst unmittelbar am Rand der gewaltigen Schlucht "
  "in der tief unter Dir ein grosser Fluss rauscht. Im Westen flussaufwaerts "
  "siehst Du einen tosenden Wasserfall.")); 
   
   
 AD(("holz"),
   "Das Holz der Bruecke schaut von hier noch sehr stabil aus.");
 
 AD(("wind"),
   "Der Wind blaest hier schon recht stark.");
   
 AD(({"wassermassen","wassermasse","masse","massen","anblick"}),
   "Ungeheure Massen von Wasser stuerzen den Wasserfall rauschend hinab. Du "
   "bist von diesem Anblick ganz ueberwaeltigt.");

 AD(({"geraeusch","geraeusche","tosen"}),
   "Geraeusche hoert man...");
 
 AD(("wasserfall"),
   "Der Wasserfall, von hier aus im Westen, fuellt die gesamte Breite "
   "der Schlucht aus. Gewaltige Wassermassen donnern weiss schaeumend ueber ihn "
   "hinab.");
  
 AD(({"breite"}),
   "Der gewaltige Wasserfall ist hier sicher 100 Meter breit.");

 AD(({"rio","rio de la puseta","puseta"}),
   "Angeblich ist der Rio de la Puseta einer der groessten, wenn nicht der "
   "groesste Fluss der Welt.");

 AD(("welt"),
   "Dies ist unser aller Welt.");

 AD(({"bruecke","haengebruecke"}),
   "Die Haengebruecke besteht aus Holz und ist sehr lang. Ihre Seile "
   "knarren und schaukelt im Wind, dass Dir schon hier fast schwindlig wird. "
   "Ein grosser Gorilla scheint auf der Bruecke herumzuturnen.");

 AD(({"seile","seil","hanfseil","hanfseile"}),
   "Die Seile sind zwar armdick, aber dass sie auf diese Laenge nicht reissen "
   "ist ein Wunder.");

 AD(({"meter","laenge"}),
   "Die Schlucht ist hier gute 100 Meter breit.");

 AD(("wunder"),
   "Die Hanfseile sind sehr dick. Trotzdem sollten nicht zu viele Menschen "
   "gleichzeitig ueber die Bruecke gehen.");

 AD(({"mensch","menschen"}),
   "Oder bis auf Feen auch alle anderen nicht.");
   
 AD(({"fee","feen"}),
   "Mit Feen wird diese Bruecke kaum zu beeindrucken sein.");
         
 AD(({"gorilla","affe"}),
   "Er ist sicher schwindelfrei.");

 AD(("himmel"),
   "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");
  
 AD(({"wildnis","dschungel"}),
   "Abseits des Pfades bis knapp an den Rand der Schlucht wuchern hier "
   "Straeucher, Baeume, Farne, Blumen und Graeser, die Du alle noch nie zuvor "
   "gesehn hast. Ausser ueber den Pfad ist es so gut wie unmoeglich in diese "
   "verfilzte Wildnis vorzudringen."); 
 
 AD(({"farn","farne"}),
   "Grosse, dunkelgruene Farne draengen sich im Schatten zwischen den Baeumen.");
 
 AD(("schatten"),
   "Um diese verfilzte, schattige Wildnis genauer zu erforschen muesstest Du "
   "tiefer in den Dschungel vordringen. Vielleicht kannst Du das Palisadentor "
   "oeffnen.");
   
 AD(({"blume","blumen","kelche","bluetenkelche","blueten"}),
   "Ihre farbigen Bluetenkelche leuchten aus dem Schatten der Baeume.");
 
 AD(({"wolken","wolke"}),
   "Die Wolken scheinen hier zum Greifen nahe.");
 
 AD(({"gras","graeser"}),
   "Das Gras waechst hier ueppig und fett dahin...");
 
 AD(({"baum","baeume","strauch","straeucher"}),
   "Die Baeume und Straeucher schieben sich hier bis auf wenige Meter an den "
   "Rand der Schlucht heran. Wahrscheinlich ist ihnen hier am Schluchtrand der "
   "Boden zu steinig.");
 
 AD(("boden"),
   "Direkt am Rand der Schlucht werden die Straeucher wegen dem steinigen Boden "
   "niedriger.");

 AD(("luft"),
   "Hier ist die Luft heiss und feucht.");
   
 AD(({"pfad","dschungelpfad","weg","dschungelweg"}),
   "Der Pfad fuehrt von der Bruecke in den Dschungel. Er sieht ziemlich "
   "verwachsen und selten benutzt aus und endet ausserdem bereits nach ca 30 "
   "Metern vor einer maechtigen Palisade.");


 AD(({"sandsteinschlucht","schlucht"}),
   "Die Schlucht liegt direkt vor Dir wie ein grosser geoeffneter Schlund.");

 AD(("schlund"),
   "Du stehst direkt am Schluchtrand und hast einen wunderbaren Ausblick auf "
   "den Fluss.");

 AD(({"rand","schluchtrand"}),
   "Du stehst direkt am Rand der Schlucht. Die Felswaende fallen senkrecht "
   "bis hin zum Grund der Schlucht ab.");
   
 AD(("grund"),
   "Tief unter Dir am Grund der Schlucht fliesst der ´Rio de la Puseta ´. "
   "Du erkennst einen schmalen Sandstrand der sich eng an diese suedliche "
   "Uferwand schmiegt.");
   
 AD(({"sandstrand","strand"}),
   "Erst jetzt wo Du genauer nach unten blickst erkennst Du das in die Uferwand "
   "direkt unter Dir Pfaehle gehauen wurden.");
   
 AD(({"holzpfahl","holzpfaehle","pfahl","pfaehle"}),
   "Die dicken Holzpfaehle wurden so in die Felswand geschlagen das man an "
   "ihnen wie ueber eine Treppe nach unten gehen kann.");
   
 AD(({"pfahltreppe","treppe"}),
   "Die Pfahltreppe fuehrt bis ganz hinunter zum Grund der Schlucht. Sie ist "
   "allerdings sehr schmal und Dir wird schon allein bei dem Gedanken "
   "schwindlig dort hinunter zu gehen.");
   
 AD(("gedanke"),
   "Das sieht nicht gerade vertrauenserweckend aus.");
   
 AD(({"sandsteinwand","sandsteinwaende","uferwand","uferwaende","felswand",
      "wand","suedliche felswand","waende","felswaende"}),
   "Die gewaltigen, von Fluss und Wind polierten Sandsteinwaende schimmern gelb "
   "im Sonnenlicht.");
   
 AD(({"sonnenlicht","licht","sonne"}),
   "In der Schlucht waere es vielleicht schattiger.");
      
 AD(("ausblick"),
   "Weit unter Dir schlaengelt sich der ´Rio de la Puseta´ durch die gelbe "
   "Sandsteinschlucht nach Osten. Im Westen siehst Du den gewaltigen "
   "Wasserfall. Es sieht so aus als wuerde der Fluss weiter im Osten nach "
   "Sueden abbiegen.");

 AD(({"biegung","osten"}),
   "Die Biegung ist von hier aus kaum zu erkennen.");      
 
 AD(("fluss"),
   "Dieser Fluss ist der Rio de la Puseta, der fuer sein smaragdgruenes Wasser "
   "bekannt ist.");

 AD(("wasser"),
   "Das Wasser ist smaragdgruen und funkelt in der Tiefe.");

 AD(("tiefe"),
   "Die Schlucht ist sehr tief, also geh nicht zu knapp an den Rand. Du "
   "koenntest sonst abrutschen und in die Tiefe stuerzen.");
 
 AD(("osten"),
   "Die Schlucht erstreckt sich von Westen nach Osten.");

 AD(("westen"),
   "Im Westen liegt der grosse Wasserfall.");

 AD(("meter"),
   "Im Sueden endet der Dschungelpfad bereits nach wenigen Metern vor einer "
   "hohen Palisade.");
   
 AD(("palisade"),
   "Im Sueden versperrt den Pfad eine hohe Palisade aus dicken Staemmen. Sie "
   "erstreckt sich nach links und rechts vom Pfad hinein in den "
   "undurchdringlichen Dschungel. In die Palisade ist ein sehr massiv "
   "aussehendes Tor eingebaut, neben dem ein hoher, hoelzener Wachturm steht.");
   
 AD(({"stamm","staemme","ueberklettern"}),
   "Die Staemme sind sehr dick und oben zugespitzt. Ein Ueberklettern ist "
   "unmoeglich.");
   
 AD(({"hafenstadt","stadt","tijara"}),
   "Die grosse Hafenstadt weiter noerdlich von hier kennt jeder.");
    
 AD(("leiter"),
   "Wenn Du nach Sueden gehst koenntest Du in den Wachturm klettern.");
    
 AD(({"ast","aeste","astwerk"}),
   "Das Astwerk wird abseits des Weges so dicht, dass man unmoeglich abseits "
   "des ausgehauenen Pfades in den Dschungel vordringen kann.");
   
   
         
 ASD(({"palisadentor","tor"}),
   "palisadentor");

 ASD(({"turm","wachturm","hochsitz","sitz"}),
   "wachturm");

 ASD(({"posten","wachposten","wache","waechter"}),
   "wache");

 ASD(({"dienst","strafdienst"}),
   "strafdienst");
   
 ASD(("gardist"),
   "gardist");
   AddItem("/players/dante/backsau.lpc",
        REFRESH_DESTRUCT);

AddItem("/d/dschungel/trintrasil/sdschungel/npc/pvogel.lpc",
        REFRESH_DESTRUCT);

AddCmd(({"dringe","gehe"}), "func_wildnis");



 SetProp(P_HIDE_EXITS, ({"unten","runter","treppe","pfahltreppe","ostunten",
                         "felswand","schlucht"}) );

 
 AddExit(({"unten","runter","treppe","pfahltreppe","ostunten","felswand",
           "schlucht"}), ([
          EX_FUNC:"treppe"]) );    
          
 AddExit("sueden", "/d/dschungel/trintrasil/sdschungel/room/sdschungel2");

 AddExit("norden", "/d/dschungel/trintrasil/sdschungel/room/bruecke1");   
   
   
  AddSound( DEFAULT_SOUND,
    "Das Tosen des Wasser uebertoent hier fast alles.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist hier sehr feucht und heiss, allerdings weht hier ein "
    "kuehlender Wind.");
  
  
}



treppe() {
	
    Z1	
  write(BS("Zoegernd steigst Du auf den ersten Pfahl und gehst nach unten. "
           "Da gehts ganz schoen tief runter."));
    Z1
    
    S1
    
  TPM("/d/dschungel/trintrasil/sdschungel/room/treppe1", M_GO, "auf der "
      "Pfahltreppe nach unten", "steigt", "steigt herunter");
return 1;}




palisadentor() {

object obj;
obj = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");

 if(present("posten", obj)) {
 		
   return BS("In der hohen Palisade ist ein Tor eingelassen. Direkt neben dem "
             "Tor steht ein hoher, hoelzener Wachturm auf dem Du einen "
             "Waechter erblickst.");
        }
        
  if(!present("posten", obj)) {
    return BS("In der hohen Palisade ist ein Tor eingelassen. Direkt neben dem "
              "Tor steht ein kleiner Wachturm der verlassen zu sein scheint.");
        }
}
  


wachturm() {

object obj;
obj = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");	
 
 if(present("posten", obj)) {
   return BS("Der hoelzerne Wachturm sieht eher aus wie ein Hochsitz. Man "
             "kann ueber eine Leiter auf ihn klettern.");
        }
        
  if(!present("posten", obj)) {
    return BS("Der hoelzerne Wachturm sieht eher aus wie ein Hochsitz. Man "
              "kann an einer Leiter in ihn klettern. Er scheint gerade "
              "verlassen zu sein.");
        }
}



wache() {

object obj1, obj2;
obj1 = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");
obj2 = find_object("/d/dschungel/trintrasil/sdschungel/room/sdschungel2");
	
  if(present("posten", obj1) && present("posten", obj2)) {
    return BS("Die Wache auf dem Turm ist ein Gardist aus Tijara. Ein weiterer "
              "Wachposten steht vor dem Palisadentor.");
         }
        
  if(present("posten", obj1) && !present("posten", obj2)) {
    return BS("Der Wachposten auf dem Turm ist ein Gardist aus Tijara. Er " 
              "scheint hier allein zu sein.");
         }
              
  if(!present("posten", obj1) && present("posten", obj2)) {
    return BS("Der Wachturm ist verlassen, aber vor dem Palisadentor siehst Du "
              "einen Waechter.");
        }
              
  if(!present("posten", obj1) && !present("posten", obj2)) {
    return BS("Seltsam, Die Palisade scheint voellig unbewacht zu sein!");
        }
 }
 

gardist() {

object obj;
obj = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");
	
  if(present("posten", obj)) {
    return BS("Er hat wohl Strafdienst, da er hier in der Wildnis Wache "
              "schieben muss. Vielleicht freut er sich wenn er wen zum Reden "
              "hat.");
        }
         	
  if(!present("posten", obj)) {
    return BS("Der Turm ist seltsamerweise verlassen.");
        }
}



strafdienst() {

object obj;
obj = find_object("/d/dschungel/trintrasil/sdschungel/room/turm");
	
  if(present("posten", obj)) {
    return BS("Ich kann mir vorstellen das der Dienst hier eher unbeliebt "
              "ist.");
        }
        
  if(!present("posten", obj)) {
    return BS("Der Turm ist seltsamerweise verlassen.");        
        }
}



int func_wildnis(string str) {
	
	notify_fail("Wohin willst Du vordringen?\n");
	
	if(str=="in wildnis vor"||str=="in wildnis ein"||str=="in wildnis"||
	   str=="in die wildnis"||str=="in die wildnis vor"||str=="in die "
	   "wildnis ein"||str=="in dschungel vor"||str=="in dschungel ein"||
	   str=="in dschungel"||str=="in den dschungel"||str=="in den dschungel "
	   "vor"||str=="in den dschungel ein") {
	   
	   if( TP->QueryProp(P_GENDER)== MALE) {	
	        write(BS("Du biegst die Aeste der vordersten Straeucher zur "
	                 "Seite und willst unbedingt auf diesem Weg in den "
	                 "Dschungel gelangen, musst aber schon nach wenigen "
	                 "Metern zerkratzt aufgeben."));
	          say(BS(""+TPN+" ist eben ein richtiger Naturbursche!"));
	     return 1;}
	     
	   if( TP->QueryProp(P_GENDER)== FEMALE) {
	   	write(BS("Du biegst die Aeste der vordersten Straeucher zu "
	   	         "Seite und willst unbedingt auf diesem Weg in der "
	   	         "Dschungel gelangen, musst aber schon nach wenigen "
	   	         "Metern zerkratzt aufgeben."));
	   	  say(BS(""+TPN+" ist eben eine gestandene Waldlaeuferin!"));
	   	  return 1;}
	   return 0;}
return 0;}