
#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <mnpc.h>


create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer grossen Haengebruecke" );
  SetProp( P_INT_LONG, BS(
    "Du stehst nun am suedlichen Ende der stark schaukelnden Haengebruecke. "
    "Du siehst die dicken Staemme die am Schluchtrand in den Boden gebohrt "
    "wurden und an denen die Bruecke aufgehaengt ist. Im Sueden beginnt ein "
    "Pfad, der in den dicht wuchernden Dschungel fuehrt. Tief unter Dir rauscht "
    "der gruene 'Rio de la Puseta'."));
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AD(({"bruecke","haengebruecke","konstruktion"}),
  "Die Bruecke spannt sich von hier ueber die ganze Schlucht nach Sueden. "
  "Sie ist eine einfache Konstruktion aus Holzbrettern und Seilen.");

  AD(({"schlucht","grund"}),
  "Tief unter Dir, am Grund der Schlucht fliesst der 'Rio de la Puseta' dahin.");
    
  AD(("holz"),
  "Das Holz schaut schon ziemlich morsch aus. Hoffentlich bricht keines der "
  "Bretter.");

  AD(({"stamm","staemme"}),
  "Mannsdicke Staemme wurden am Schluchtrand  in den Boden  gebohrt. An diesen "
  "Staemmen sind die Seile befestigt die die Bruecke halten.");

  AD(({"schluchtrand","rand"}),
  "Der Schluchtrand  ist schon ganz nahe.");
      
  AD(({"seil","seile"}),
  "Die Seile verbinden die einzelnen Bretter und zwei besonders dicke Seile "
  "sind als Gelaender rechts und links gespannt.");
  
  AD(("gelaender"),
  "Das Gelaender besteht nur aus zwei Seilen. Pass auf, dass Du nicht in die "
  "Tiefe stuerzt.");

  AD(("tiefe"),
  "Tief unter Dir siehst Du den schmalen Sandstrand den der Fluss hier "
  "angeschwemmt hat.");
  
  AD(({"sandstrand","strand"}),
  "Irgendwo hier in der Naehe gibt es einen Abstieg zu diesem Strand.");
  
  AD(("naehe"),
  "Es kann nicht weit sein.");
  
  AD(({"abstieg","seite","suedliche seite"}),
  "Als Du die suedliche Seite der Schlucht genauer betrachtest faellt Dir eine "
  "gezackte Linie an der suedlichen Schluchtwand auf.");

  AD(({"sonnenlicht","licht","sonne"}),
  "In der Schlucht ist es schattiger. Dort ist es sicher kuehler.");
   
  AD(("linie"),
  "Na sowas. Eine Pfahltreppe fuehrt im Sueden die nahezu senkrechte "
  "Schluchtwand hinab!");
  
  AD(({"treppe","pfahltreppe"}),
  "In die senkrechte Sandsteinwand im Sueden wurden absteigend starke "
  "Holzpfaehle gehauen, sodass man dort wie auf einer Treppe hinuntersteigen "
  "kann.");

  AD(({"pfaehle","pfahl","holzpfaehle","holzpfahl"}),
  "Die Holzpfaehle sehen stark genug aus um Dich zu tragen. Dich schaudert "
  "allerdings bei dieser Tiefe.");

  AD(({"wand","sandsteinwand","steinwand","meter","schluchtwand"}),
  "Die gewaltige Schluchtwand schimmert gelb im Sonnenlicht. Sie erhebt sich "
  "nahezu 250 Meter in die Hoehe.");
  
  AD(("hoehe"),
  "Dir wird schwindlig wenn Du zu lange nach unten blickst.");
  
  AD(({"holzbretter","bretter","brett","holzbrett"}),
  "Zwischen den Brettern sind grosse Luecken...");
  
  AD(({"luecken","luecke"}),
  "Sei lieber vorsichtig.");
  
  AD(({"ende","sicht"}),
  "Die Bruecke geht hier zu Ende. Ein Pfad der tiefer in den Dschungel fuehrt "
  "beginnt im Sueden.");
    
  AD(({"pfad","sueden"}),
  "Noch stehst Du auf der schwankenden Bruecke.");
  
  AD(({"seiten","dschungel"}),
  "Der Dschungel wuchert zu beiden Seiten der Schlucht.");

  AD(({"fluss"}),
  "Unter Dir fliesst der Rio de la Puseta dahin.");
  
  AD(("wasser"),
  "Das Wasser des Flusses leuchtet gruen.");
  
  AD(({"rio","puseta","rio puseta","rio de la puseta"}),
  "Der Rio de la Puseta schaut von hier oben noch viel maechtiger und breiter "
  "aus.");
  
  AD(("wind"),
  "Der Wind laesst die Bruecke hin und herschwanken...");
  
  AD(("boden"),
  "Du stehst auf einem morschen Holzbrett der Haengebruecke. Der Fluss fliesst "
  "tief unter Dir dahin.");
  
  AD(("himmel"),
  "Auf der vollkommen schattenlosen Bruecke brennt die Sonne besonders "
  "unangenehm.");

  AD(("sonne"),
  "In der schattigen Schlucht unter Dir waere es vielleicht kuehler.");
    
   
  AddSound( DEFAULT_SOUND,
    "In der Tiefe rauscht das Wasser.");

    
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");

  AddSmell("luft",
    "Die Luft im Dschungel ist sehr feucht.");


  AddRoomMessage(({
  "Die Bruecke schaukelt gewaltig hin und her...\n",
  "Der Wind zerzaust Dein Haar.\n",
  "In der Tiefe rauscht der Fluss.\n",
  "Fast waerst Du gestolpert...\n",
  "Das Holz knarrt verdaechtig laut...\n", 
  "Die Bruecke schwankt im Wind...\n"}),40);


AddExit("norden", "/d/dschungel/trintrasil/sdschungel/room/bruecke2");

AddExit("sueden", "/d/dschungel/trintrasil/sdschungel/room/sdschungel1");


AddCmd(({"springe","spring"}), "tod");

AddCmd(({"steige","gehe","betrete"}), "func_treppe");

}



int func_treppe(string str) {
	
	if(str=="treppe"||str=="pfahltreppe"||str=="pfahl"||str=="hinunter"||
	   str=="auf treppe"||str=="auf pfahltreppe"||str=="auf pfahl"||
	   str=="auf die treppe"||str=="auf die pfahltreppe"||str=="auf den "
	   "pfahl") {
	   	
	   	write(BS("Du bist doch noch auf der Haengebruecke! Die "
	   	         "Pfahltreppe fuehrt die suedliche Schluchtwand "
	   	         "hinab!"));
	   	         return 1;}
	   return 0;}
	   
	   
	   
 tod(string str )
{
  notify_fail( "Wohin willst Du springen ?\n" );
if ( !str ) return 0;
if ( member( ({"nach unten","runter","in wasser","in fluss","in tiefe","ueber seil","von bruecke" }),str) !=-1 )
 {
 if(TP->QueryProp(P_GHOST))
 {
   write("Aber Du bist doch schon tot!!\n");
   return 1;
 }
write(BS("Du willst Dein Leben also beenden? Dann gib 'spring "
     "selbstmoerderisch von der bruecke' ein."));
 return 1;
 }
 
if( member(( {"selbstmoerderisch von der bruecke","selbstmoerderisch von bruecke"}), str) !=-1 )
                                       
{
 say(CAP_TPN+" setzt seinem jaemmerlichen Leben ein Ende und springt in den Tod.\n");
clone_object("/d/dschungel/dante/weg/obj/sprung.lpc")->move(TP, M_NOCHECK);
 TP->move("/d/dschungel/dante/weg/room/tod", M_NO_SHOW + M_SILENT + M_GO);
 write( " \n"
 "Du setzt einen Schlusstrich unter Dein jaemmerliches Leben und springst ueber das Seil in den Tod.\n"
 " \n"
 "      AHHHH.....\n"
 " \n"
 "             HHHHH.....\n"
 " \n"
 "                    HHHHH.....\n"
 " \n"
 "                           HHHHH.....\n"
 " \n");
 call_out("st1",6);

 return 1;
 }
 return 0;
 }
st1()
{
write(" \n"
"Du bereust diesen unueberlegten Schritt noch waerend Du in der Luft nach unten "
"rast, aber nun ist es zu wohl spaet, Du Idiot...\n");
tell_room(TO,"Du siehst wie "+TPN+" in die Tiefe stuerzt.\n");
call_out("st2",6);
}

st2()
{
write(" \n"
"Du prallst auf dem steinharten Wasser auf und wirst zerschmettert!!!\n");
tell_room(TO,"Du erkennst in der Tiefe der Schlucht wie "+TPN+" zerschmettert wird.\n");
TP->do_damage(500);
SetProp(P_KILL_NAME, "Ein selbstmoerderischer Sprung");
}

