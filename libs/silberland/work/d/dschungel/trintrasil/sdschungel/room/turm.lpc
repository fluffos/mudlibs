

inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <ansi.h>



reset()  {
if( previous_object() && 
   file_name(previous_object())=="/d/dschungel/trintrasil/sdschungel/master")  
   { 
::reset();
return;
}
 return; 
}

create(){	 
  ::create();

call_other("/d/dschungel/trintrasil/sdschungel/room/bruecke2", "load");
call_other("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", "load");
call_other("/d/dschungel/trintrasil/sdschungel/room/busch-h", "load");
/*spieler koennen ohnehin nur ueber sdschungel2 in diesen raum gelangen, dann 
  werden diese raeume ohnehin schon geladen sein.*/
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
  
  
  "Du bist nun ganz oben im hoelzernen Hochsitz. Der Turm ist aus starken "
  "Staemmen gezimmert und sieht sehr stabil aus. Eine dicke Bruestung schuetzt "
  "vor Speeren und Pfeilbeschuss. Obwohl Dir trotz der Hoehe noch immer einige "
  "Baumriesen die Sicht versperren hast Du einen weiten Blick ueber den "
  "suedlichen Dschungel.")); 
   
   
 AD(({"sitz","hochsitz","turm","wachturm"}),
   "Der Wachturm ist ca 20 Meter hoch und ueberragt die meisten Baumwipfel.");
 
 AD(({"wipfel","baumwipfel"}),
   "Nur die groessten Baumriesen versperren Dir von hier oben aus die Sicht. "
   "Dennoch hast Du einen weiten Ausblick.");

 AD(({"baumriesen","riesen"}),
   "Einige gewaltige Baumriesen ragen aus dem gruenen Meer des Dschungels.");
   
 AD(({"dschungel","meer"}),
   "Der Dschungel sieht von hier oben aus wie ein dichtes, bewegtes, gruenes "
   "Meer, nur unterbrochen von wenigen freien Stellen und den hoechsten "
   "Wipfeln gewaltiger Baumriesen.");
        
 AD(({"stellen","anderes"}),
   "An diesen baumfreien Stellen im Dschungel befinden sich vielleicht Tuempel, "
   "kleine Seen oder anderes."); 

 AD(({"seen","see","tuempel"}),
   "Leider kannst kannst Du den Dschungel suedlich der Palisade zur Zeit nicht erforschen "
   "da das Palisadentor bis auf weiteres geschlossen ist.");
   
 ASD(({"tor","palisadentor","zeit","posten","palisade","dienst"}),
   "tor");
   
 AD(("himmel"),
   "Der Himmel ist nahezu wolkenlos.");
 
 AD(("sonne"),
 "Schoen, die Sonne scheint hier besonders fuer Justavius.");
 
 AD(({"justavius","just"}),
 "Er wuerde die Sonne sicher vermissen wenn sie nicht so eindeutig scheinen wuerde :).");
 
 AD(("boden"),
   "Der Boden besteht aus fest gezimmerten Staemmen.");
   
 AD(({"stamm","staemme"}),
   "Der Wachturm ist aus starken, teilweise noch recht frischen Staemmen "
   "gezimmert.");
   
 AD(({"bruestung","pfeilbeschuss","beschuss","deckung"}),
   "Die Bruestung ist ca brusthoch und bietet Deckung falls jemand den Turm von "
   "unten mit Pfeilen oder Speeren beschiessen sollte.");

 AD(({"speere","pfeile"}),
   "Jetzt faellt Dir erst ein abgebrochener Pfeilschaft auf der noch in der "
   "Bruestung steckt.");
   
 AD(({"pfeil","pfeilschaft","schaft"}),
   "Der Pfeil hat sich tief in die Bruestung gebohrt. Da er nicht mehr "
   "herausgezogen werden kann wurde er einfach abgebrochen.");
   
 AD(("hoehe"),
   "Der Wachturm ist eher ein ca 20 Meter hoher ueberdachter Hochsitz aus "
   "Holz.");
   
 AD(("holz"),
   "Die Staemme des Hochsitz sind dick und fest zusammengefuegt.");
 
 AD(({"sicht","ausblick","blick","aussicht"}),
   "Nach Sueden hast Du einen weiten Blick ueber den Dschungel. Im Norden "
   "siehst Du die Schlucht und die Haengebruecke.");
   
 AD(({"bruecke","haengebruecke"}),
   "Die Bruecke ueberspannt die Schlucht.");
   
 AD(({"schlucht","norden"}),
   "Du kannst nicht tief in die Schlucht einsehen, aber Du erkennst das sie "
   "weit von Westen nach Osten den Dschungel zerteilt.");
      
 AD(("westen"),
   "Die Schlucht verliert sich im Westen. Das leise Rauschen eines Wasserfalles "
   "weht von dort zu Dir herueber.");
   
 AD(({"wasserfall","rauschen"}),
   "Den Wasserfall kannst Du nicht sehen.");
   
 AD(({"fluss","rio","rio de la puseta","osten"}),
   "Tief unter Dir in der Schlucht, von hier nicht einsehbar fliesst der ' Rio "
   "de la Puseta ' nach Osten."); 

 AD(({"abkuehlung","wind"}),
   "Hier oben auf dem Turm weht ein leichter Wind der wenigstens etwas Abkuehlung "
   "bringt.");

AddItem("/d/dschungel/trintrasil/sdschungel/npc/wachtmeister.lpc" ,
        REFRESH_DESTRUCT);   


AddCmd(("ziehe"), "pfeil_func");


AddExit("unten", ([
        EX_FUNC:"runter"]) );

        
           
  AddSound( DEFAULT_SOUND,
    "Aus der Schlucht im Norden hoerst Du leise das Rauschen eines "
    "Wasserfalles.");
 
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist drueckend heiss und feucht. Aber hier oben weht wenigstens der Wind.");
       
  
}


pfeil_func(string str) {
	
	if(str=="pfeil heraus"||str=="pfeischaft heraus"||str=="abgebrochenen pfeil heraus"||
	str=="pfeil aus bruestung"||str=="pfeischaft aus bruestung"||str=="abgebrochenen pfeil aus "||
	"bruestung"||str=="pfeil aus holz"||str=="pfeilschaft aus holz") {
		
		write(BS("Der Pfeil wurde abgebrochen weil er so fest im Holz steckt, dass er nicht "
		"mehr heraus gezogen werden kann."));
		return 1;
	}
}
 

        
runter() {
	
 Z1	
 write(BS("Du kletterst ueber die Leiter aus dem Wachturm."));
 S1
 TPM("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", M_GO,
     "hinunter", "klettert", "klettert vom Wachturm herunter");   
         return 1;}
 
 

  
call_func() {

 object wache;
 wache=present("wache", TO);
 
  if(wache) {
   
   SD1(turm)
   tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
          BS("Du hoerst von unten lautes Getoese!"));	
   SD1(sdschungel2)
   tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
          BS(""+ANSI_RED+"Der Wachposten ruft seinen Kameraden!!"
               +ANSI_NORMAL+""));   
   call_out("call_func2", 3);
     }            

  if(!wache) {

   SD1(turm)
   tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
          BS("Du hoerst von unten lautes Getoese!"));	  	  	
  	}
}


call_func2() {
	
 object wache;
 wache=(present("posten", TO));
 
    SD1(turm)
    tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
           BS("Der Wachposten eilt fluchend nach unten!"));
    wache->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", M_GO+ 
                M_SILENT);
    SD1(sdschungel2)
    tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
           BS(""+ANSI_RED+"Der  Posten vom Turm eilt herbei!"+ANSI_NORMAL+""));
    wache->Kill(TP);
   }

tor() {

if(present("posten", TO)) {
	return BS("Vielleicht weiss der Posten mehr darueber, warum das Tor geschlossen "
	          "ist.");
	        }
	       
if(!present("posten", TO)) {
	return BS("Eigenartigerweise ist der Turm verlassen. Die Wachposten die hier "
	          "normalerweise Dienst schieben wuessten sicher mehr.");
	        }
	       } 