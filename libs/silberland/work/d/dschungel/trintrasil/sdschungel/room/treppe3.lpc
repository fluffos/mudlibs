


inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>

int adler=1;

reset() {
   ::reset();
   adler=1;}
   
   
create() { 
::create(); 

SetProp( P_LIGHT, 1 ); 
SetProp( P_INDOORS, 0 ); 
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 26, ENV_TERRAIN:TT_JUNGLE]) );  
SetProp( P_INT_SHORT, "Auf der Pfahltreppe" ); 
SetProp( P_INT_LONG, BS(

  
  "Der Wind pfeift Dir kraeftig um die Ohren. Vorsichtig gehst Du ueber die " 
  "dicken Holzpfaehle und versuchst die schwindelerregende Tiefe zu ignorieren. "
  "Du befindest Dich nun ziemlich genau auf halber Hoehe der Pfahltreppe. Die "
  "gegenueberliegende Uferwand wirft ihren maechtigen Schatten auf Dich." )); 

   
 AD(({"treppe","pfahltreppe"}), 
   "Die Treppe besteht aus dicken runden Holzpfaehlen die in kurzen Abstaenden " 
   "absteigend in die senkrechte Felswand gehauen wurden. Hier draussen an " 
   "der Felswand trifft Dich der Wind ungehindert und zerrt an Dir.");

 AD(("wind"),    
   "Wenn das Seil an der Felswand nicht waere an dem Du Dich festhalten kannst " 
   "haette Dich der Wind wahrscheinlich schon von der Treppe geweht.");

 AD(({"ohr","ohren"}),
   "Der Wind zerrt besonders an Deinen Ohren.");
   
 AD(({"tiefe"}),    
   "Du wagst garnicht nach unten zu blicken.");

 AD(({"pfaehle","holzpfaehle","pfahl","holzpfahl"}),
   "Die Holzpfaehle sind sehr dick und stabil. Sie scheinen sehr fest und "
   "stabil in der Felswand verankert zu sein.");

 AD(({"wand","felswand","sandsteinwand","waende","felswaende","sandsteinwaende",
      "schluchtwand","schluchtwaende","uferwand","uferwaende"}),
   "Welche Wand meinst Du? Die gegenueberliegende Schluchtwand, oder die "
   "suedliche Wand in der Du Dich befindest?");
   
 AD(({"suedliche wand","suedliche felswand","suedliche sandsteinwand",
      "suedliche schluchtwand","suedliche uferwand"}),  
   "Die Sandsteinwaende schimmern im Sonnenlicht in allen Gelb- bis "
   "Orangetoenen. Die Uferwaende ragen maechtig ueber dem Fluss auf und werfen "
   "ihren Schatten ueber Dich.");

 AD(({"stein","sandstein"}),
    "Der gelbe weiche Sandstein wurde von Wind und Wasser ganz glatt poliert.");

 AD(({"gegenueberliegende wand","gegenueberliegende felswand",
      "gegenueberliegende sandsteinwand","gegenueberliegende schluchtwand",
      "gegenueberliegende uferwand",
      "noerdliche wand","noerdliche felswand","noerdliche sandsteinwand",
      "noerdliche schluchtwand","noerdliche uferwand",
      "flussseite","seite","gegenueberliegende flussseite",
      "gegenueberliegende seite",
      "noerdliches ufer","noerdliches flussufer",
      "noerdliche flussseite","noerdliche seite"}),
   "Als Du die matt schimmernde Sandsteinwand betrachtest fallen Dir einige "
   "Loecher auf.");
  
 AD(("loecher"),
   "Etwa 50m unter dem gegenueberliegendem Schluchtrand fallen Dir ein paar "
   "Hoehlen auf. Kurz kannst Du auch eine Gestalt erkennen die gerade eine "
   "Hoehle betritt.");
   
 AD(({"hoehle","hoehlen","gestalt","gigant","steingigant"}),
   "Bei der Gestalt handelt es sich um einen Steingigant. Selbst aus der "
   "Entfernung wirkte er sehr gross.");
 
 AD(({"eingaenge","eingang","hoehleneingaenge","hoehleneingang","entfernung",
      "stadt","steingigantenstadt"}),
   "Die Hoehleneingaenge zur Steingigantenstadt sind ueber 100m von Dir "
   "entfernt.");
     
 AD(({"gelbtoene","orangetoene","toene","farbtoene","gelb"}),
   "Der obere Teil der Felswaende, auf den noch Sonnenlicht faellt schimmert "
   "in milden, warmen Gelbtoenen.");
   
 AD(({"sonne","sonnenlicht","licht"}),
   "Im Dschungel ist es drueckend heiss. Am Grund der Schlucht ist es sicher "
   "etwas kuehler.");
   
 AD(("grund"),
   "Tief unter Dir windet sich der gruen schimmernde ´Rio de la Puseta´ durch "
   "die Schlucht.");
   
 AD(("dschungel"),
   "Den Dschungel siehst Du von hier aus nicht mehr. Auch die letzen hoechsten "
   "Baumkronen werden von der gegenueberliegenden Uferwand verdeckt.");    

 AD(({"kronen","baumkronen","baum","baeume"}),
   "Wenn Du die maechtigen Baeume der Dschungels sehen willst musst Du hoeher "
   "steigen.");
   
 AD(({"schluchtrand","rand"}),
   "Der Schluchtrand liegt viele Meter ueber Dir.");
 
 AD(("meter"),
   "Der Schluchtrand liegt weit ueber 100 Meter ueber Dir.");
    
 AD(("teil"),
   "Der untere Teil der Schlucht liegt im Schatten."),
   
 AD(("schatten"),
   "Der Schatten der gegenueberliegenden Felswand faellt auf Dich."); 

 AD(({"rio","fluss","riode la puseta","puseta","blick"}),
   "Der Fluss schillert gruen weit unter Dir. Weiter flussaufwaerts im Westen "
   "tost ein Wasserfall. Eine Haengebruecke ueberspannt ober Dir den Fluss.");

 AD(({"wasserfall"}),
   "Das Wasser donnert weiss donnernd den Wasserfall hinab.");
    
 AD(({"haengebruecke","bruecke"}),
   "Die Bruecke ueberspannt weit ueber Dir die Schlucht."); 
 
 AD(({"sandsteinschlucht","schlucht"}),
   "Die Schlucht fuehrt von Westen nach Osten. Tief unter Dir schmiegt sich ein "
   "schmaler Sandstrand an die suedliche Schluchtwand.");
 
 AD(("westen"),
   "Im Westen rauscht ein grosser Wasserfall.");
   
 AD(("osten"),
   "Weiter im Osten scheint der Fluss eine Biegung nach Sueden zu machen, aber "
   "das kannst Du von hier aus nicht besonders gut erkennen.");

 AD(({"biegung","sueden"}),
   "Von hier aus kannst Du die Biegung nicht gut erkennen. Vielleicht siehst "
   "Du mehr wenn Du ganz hinunter zum Fluss gehst.");
    
 AD(({"wolken","wolke"}),
   "Die Wolken scheinen hier zum Greifen nahe.");
 
 AD(({"sandstrand","strand","suedliche flussseite","suedliche seite",
      "suedliches ufer","suedliches flussufer"}),
   "Tief unter Dir schmiegt sich ein schmaler Sandstrand an die Felswand. "
   "Der Strand befindet sich ueber 100 meter unter Dir. Dir wird leicht "
   "schwindlig als Du zwischen die Holzpfaehle nach unten blickst.");
 
 AD(("boden"),
   "Du stehst auf einem Holzpfahl hoch ueber dem Boden.");

 AD(({"haelfte","hoehe"}),
   "Die Haelfte der Treppe hast Du ueberwunden.");
   
 AD(("seil"),
   "An der Felswand neben Dir ist ein Seil befestigt an dem Du Dich festhalten "
   "kannst.");
   
 AD(("wasser"),
   "Das Wasser des ´Rio de la Puseta´ schillert gruen.");
   
 AD(({"abstand","abstaende"}),
   "In regelmaessigen Abstaenden sind Holzpfaehle in die Felswand gehauen so "
   "das Du ueber sie wie ueber eine Treppe nach unten gehen kannst.");

 ASD(("himmel"),
   "himmel"),

 ASD(("punkt"),
   "punkt"),

 

 AddCmd(({"untersuche","unt"}), "func_fischadler");
 
 
 
 AddExit("westoben", "/d/dschungel/trintrasil/sdschungel/room/treppe2");
 AddExit("westunten", "/d/dschungel/trintrasil/sdschungel/room/treppe4");  
   
   
  AddSound( DEFAULT_SOUND,
    "Das Tosen des Wasser uebertoent hier fast alles.");
  
  AddSound(("tosen"),
    "!!!WWWUUUSSSCCCHHHHH!!!");
      
  AddSmell( DEFAULT_SMELL,
    "Es ist hier sehr windig. Du riechst ueberhaupt nichts.");
  
  
}


himmel() {
	
  if(adler==1) {
  	
    return BS("Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber "
              "Dich hinweg. Ein winziger Punkt kreist am Himmel.");
        }
        
  if(adler==0) {
  	
    return BS("Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber "
              "Dich hinweg.");
        }
}


punkt() {
	
  if(adler==1) {
  	
    return BS("Der Punkt kommt naeher. Jetzt kannst Du ihn erkennen, es ist ein "
              "Fischadler.");
        }
        
  if(adler==0) {
  	
    return BS("Welchen Punkt meinst Du? Der Himmel ist strahlendblau.");        
        } 
}
  

int func_fischadler(string str) {

 if(str=="fischadler"||str=="adler") {
  
  if(adler==1&&!(present("fischadler", TO))) {
  	
    write(BS("Der Fischadler kommt immer naeher. Er scheint sehr aggressiv zu "
              "sein."));              
    say(BS("Du entdeckst einen Fischadler. Er scheint sehr aggressiv zu sein."));
    call_out("fischadler1", 2);
            return 1;}

  if(adler==0&&!(present("fischadler", TO))) {
  	
    write(BS("Welchen Fischadler meinst Du? Der Himmel ist nahezu wolkenlos."));
            return 1;}
  return 0;}
return 0;}

fischadler1() {

 NIX
 
 Z1
 write(BS("Der Adler hat anscheinend wirklich vor Dich anzugreifen!!"));
 Z1
 S1
 say(BS("Der Adler schiesst anscheinend in kaempferischer Absicht herab!!"));
 S1
 call_out("fischadler2", 1);
}


fischadler2() {

 object fischadler;
 	
 NIX
 fischadler=CLONEOB("/d/dschungel/trintrasil/sdschungel/npc/adlerm");
 fischadler->move(environment(TP), M_TPORT);
 fischadler->Kill(TP);
 adler=0;
}


  