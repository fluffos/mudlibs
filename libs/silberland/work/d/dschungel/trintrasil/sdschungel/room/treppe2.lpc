


inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>


create() { 
::create(); 

SetProp( P_LIGHT, 1 ); 
SetProp( P_INDOORS, 0 ); 
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN:TT_JUNGLE]) );  
SetProp( P_INT_SHORT, "Auf der Pfahltreppe" ); 
SetProp( P_INT_LONG, BS(

  
  "Der Wind pfeift Dir kraeftig um die Ohren. Vorsichtig gehst Du ueber die " 
  "dicken Holzpfaehle und versuchst die schwindelerregende Tiefe zu ignorieren. "
  "Du hast hier einen imposanten Blick ueber die gelb leuchtende " 
  "Sandsteinschlucht." )); 

   
 AD(({"treppe","pfahltreppe"}), 
   "Die Treppe besteht aus dicken runden Holzpfaehlen die in kurzen Abstaenden " 
   "absteigend in die senkrechte Felswand gehauen wurden. Hier draussen an " 
   "der Felswand trifft Dich der Wind ungehindert und zerrt an Dir.");

 AD(("wind"),    
   "Wenn das Seil an der Felswand nicht waere an dem Du Dich festhalten kannst " 
   "haette Dich der Wind wahrscheinlich schon von der Treppe geweht.");

 AD(({"ohr","ohren"}),
   "Der Wind zerrt besonders an Deinen Ohren.");
   
 AD(({"tiefe"}),    
   "Du wagst garnicht nach unten zu blicken.");

 AD(({"pfaehle","holzpfaehle","pfahl","holzpfahl"}),
   "Die Holzpfaehle sind sehr dick und stabil. Sie scheinen sehr fest und "
   "stabil in der Felswand verankert zu sein.");

 AD(({"wand","felswand","sandsteinwand","waende","felswaende","sandsteinwaende",
      "schluchtwand","schluchtwaende","suedliche wand","suedliche felswand",
      "suedliche sandsteinwand"}),
   "Die Sandsteinwaende schimmern im Sonnenlicht in allen Gelb- bis "
   "Orangetoenen. Eine kuemmerliche braune Flechte bewaechst hier spaehrlich "
   "die Felswand.");
   
   
 AD(("flechte"),
   "Die Flechte krallt sich hier als duenne Schicht an den gelben Sandstein.");
   
 AD(({"sandstein","stein"}),
   "Der gelbe, sanft schimmernde Sandstein ist von Wind und Wasser ganz glatt "
   "poliert.");
    
 AD(("schicht"),
   "Dem scharfen Wind ausgesetzt duckt sich die Flechte an die glatte "
   "Felswand.");
   
 AD(({"gelbtoene","orangetoene","toene","farbtoene","gelb"}),
   "Der obere Teil der Felswaende, auf den noch Sonnenlicht faellt schimmert "
   "in milden, warmen Gelbtoenen.");
   
 AD(({"sonne","sonnenlicht","licht"}),
   "Im Dschungel ist es drueckend heiss. Am Grund der Schlucht ist es sicher "
   "etwas kuehler.");
   
 AD(("grund"),
   "Tief unter Dir windet sich der gruen schimmernde ´Rio de la Puseta´ durch "
   "die Schlucht.");
   
 AD(("dschungel"),
   "Den Dschungel siehst Du von hier aus nicht mehr. Nur noch ein paar "
   "Baumkronen erkennst Du ueber dem Rand der gegenueberliegenden "
   "Schluchtwand.");    

 AD(({"kronen","baumkronen"}),
   "Nur die hoechsten Kronen ragen teilweise ueber den Schluchtrand.");
   
 AD(({"schluchtrand","rand"}),
   "Der Schluchtrand liegt nun schon einige Meter ueber Dir.");
 
 AD(("meter"),
   "Der Schluchtrand liegt beinahe 100 Meter ueber Dir.");
    
 AD(("teil"),
   "Der untere Teil der Schlucht liegt im Schatten."),
   
 AD(("schatten"),
   "Die Felswaende werfen ihren Schatten auf den Fluss. In der Schlucht ist es "
   "sicher etwas kuehler."); 

 AD(({"rio","fluss","riode la puseta","puseta","blick"}),
   "Der Fluss schillert gruen weit unter Dir. Weiter flussaufwaerts im Westen "
   "tost ein Wasserfall. Eine Haengebruecke ueberspannt ober Dir den Fluss.");

 AD(({"wasserfall"}),
   "Das Wasser donnert weiss donnernd den Wasserfall hinab.");

 AD(("himmel"),
   "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");
  
 AD(({"haengebruecke","bruecke"}),
   "Die Bruecke ueberspannt ueber Dir die Schlucht."); 
 
 AD(({"sandsteinschlucht","schlucht"}),
   "Die Schlucht fuehrt von Westen nach Osten. Tief unter Dir schmiegt sich ein "
   "schmaler Sandstrand an die suedliche Schluchtwand.");
 
 AD(("westen"),
   "Im Westen rauscht ein grosser Wasserfall.");
   
 AD(("osten"),
   "Weiter im Osten scheint der Fluss eine Biegung nach Sueden zu machen, aber "
   "das kannst Du von hier aus nicht besonders gut erkennen.");

 AD(({"biegung","sueden"}),
   "Von hier aus kannst Du die Biegung nicht gut erkennen. Vielleicht siehst "
   "Du mehr wenn Du ganz hinunter zum Fluss gehst.");
    
 AD(({"wolken","wolke"}),
   "Die Wolken ziehen langsam am Himmel dahin.");
 
 AD(({"sandstrand","strand"}),
   "Tief unter Dir schmiegt sich ein schmaler Sandstrand an die Felswand. "
   "Du wagst es nicht zu genau nach unten zu blicken.");
 
 AD(("boden"),
   "Du stehst auf einem Holzpfahl hoch ueber dem Boden.");

 AD(("seil"),
   "An der Felswand neben Dir ist ein Seil befestigt an dem Du Dich festhalten "
   "kannst.");
   
 AD(("wasser"),
   "Das Wasser des ´Rio de la Puseta´ schillert gruen.");
   
 AD(({"abstand","abstaende"}),
   "In regelmaessigen Abstaenden sind Holzpfaehle in die Felswand gehauen so "
   "das Du ueber sie wie ueber eine Treppe nach unten gehen kannst.");



 AddExit("ostoben", "/d/dschungel/trintrasil/sdschungel/room/treppe1");
 AddExit("ostunten", "/d/dschungel/trintrasil/sdschungel/room/treppe3");
   
   
  AddSound( DEFAULT_SOUND,
    "Das Tosen des Wasser uebertoent hier fast alles.");
  
  AddSound(("tosen"),
    "!!!WWWUUUSSSCCCHHHHH!!!");
      
  AddSmell( DEFAULT_SMELL,
    "Es ist hier sehr windig. Du bist froh wenn Dich der Wind nicht von der "
    "Treppe weht.");
  
  
}



  