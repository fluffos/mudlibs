


inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>


create()
{ 
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Auf der Pfahltreppe" );
  SetProp( P_INT_LONG, BS(
  
  
  "Unsicher stehst Du auf einem Holzpfahl am Anfang einer unglaublich langen "
  "Pfahltreppe die sicher 250 Meter in die Tiefe fuehrt. Du wagst nicht "
  "nach unten zu blicken. An der Felswand ist zwar ein Seil angebracht an dem "
  "Du Dich festhalten kannst bei einem Abstieg, aber trotzdem kommt Dir diese "
  "Konstruktion mehr als unsicher vor.")); 
   
   
 AD(({"treppe","pfahltreppe"}),
   "Die Treppe besteht aus dicken runden Holzpfaehlen die in kurzen Abstaenden "
   "absteigend in die senkrechte Felswand gehauen wurden. Hier draussen an "
   "der Felswand trifft Dich der Wind ungehindert und zerrt an Dir.");
 
 AD(("wind"),
   "Der Wind blaest ziemlich stark und verunsichert Dich noch mehr.");
   
 AD(({"tiefe","meter"}),
   "Du wagst gar nicht nach unten zu blicken.");

 AD(("konstruktion"),
   "Der Erbauer dieser Treppe muss wahnsinnig sein so eine unsichere "
   "Konstruktion zu erfinden.");
 
 AD(("erbauer"),
   "Naja die Treppe ist sicher kein Hauptverkehrsweg.");
  
 AD(({"hauptverkehrsweg","verkehrsweg","weg","hauptweg"}),
   "Hoffentlich wird die Treppe trotzdem regelmaessig gewartet.");

 AD(({"pfaehle","holzpfaehle","pfahl","holzpfahl"}),
   "Die Holzpfaehle sind sehr dick und stabil. Sie scheinen sehr fest und "
   "stabil in der Felswand verankert zu sein.");

 AD(({"wand","felswand","sandsteinwand","waende","felswaende","sandsteinwaende",
      "schluchtwand","schluchtwaende"}),
   "Die gelben Sandsteinwaende sind sehr imposant. Gelb leuchtend rahmen die "
   "hohen, senkrechten Schluchtwaende den Rio de la Puseta ein.");

 AD(({"rio","fluss","riode la puseta","puseta"}),
   "Der Fluss schillert gruen weit unter Dir. Weiter flussaufwaerts im Westen "
   "tost ein Wasserfall. Eine Haengebruecke ueberspannt ueber Dir den Fluss.");

 AD(({"wasserfall"}),
   "Der donnernde Wasserfall ist wirklich beeindruckend, aber Du bist etwas "
   "zu nervoes ihn zu bewundern.");

 AD(("himmel"),
   "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");
 
 AD(("sonne"),
   "Die Sonne brennt vom wolkenlosen Himmel.");
   
 AD(({"haengebruecke","bruecke"}),
   "Die Bruecke ueberspannt direkt ueber Dir die Schlucht."); 
 
 AD(({"schlucht"}),
   "Die Schlucht fuehrt von Westen nach Osten.");
 
 AD(("westen"),
   "Im Westen rauscht ein grosser Wasserfall.");
   
 AD(("osten"),
   "Weiter im Osten scheint der Fluss eine Biegung nach Sueden zu machen, aber "
   "das kannst Du von hier aus nicht besonders gut erkennen.");

 AD(({"biegung","sueden"}),
   "Von hier aus kannst Du die Biegung nicht gut erkennen. Vielleicht siehst "
   "Du mehr wenn Du ganz hinunter zum Fluss gehst.");
    
 AD(({"wolken","wolke"}),
   "Die Wolken scheinen hier zum Greifen nahe.");
 
 AD(("abstieg"),
   "Die Pfahltreppe fuehrt ca 250 Meter tief nach unten zu einem Sandstrand.");
 
 AD(({"sandstrand","strand"}),
   "Tief unter Dir schmiegt sich ein schmaler Sandstrand an die Felswand. "
   "Du wagst es nicht zu genau nach unten zu blicken.");
 
 AD(("boden"),
   "Du stehst auf einem Holzpfahl hoch ueber dem Boden.");

 AD(("seil"),
   "An der Felswand neben Dir ist ein Seil befestigt an dem Du Dich festhalten "
   "kannst.");
   
 AD(("anfang"),
   "Du stehst noch ganz oben auf der Treppe.");

 AD(("wasser"),
   "Das Wasser des Rio de la Puseta schillert gruen.");
   
 AD(({"abstand","abstaende"}),
   "In regelmaessigen Abstaenden sind Holzpfaehle in die Felswand gehauen so "
   "das Du ueber sie wie ueber eine Treppe nach unten gehen kannst.");


AddCmd(("halte"), "func_seil");


 AddExit("westoben", "/d/dschungel/trintrasil/sdschungel/room/sdschungel1");
 AddExit("westunten", "/d/dschungel/trintrasil/sdschungel/room/treppe2");  
   
  AddSound( DEFAULT_SOUND,
    "Das Tosen des Wasser uebertoent hier fast alles.");
  
  AddSound(("tosen"),
    "!!!WWWUUUSSSCCCHHHHH!!!");
      
  AddSmell( DEFAULT_SMELL,
    "Es ist hier sehr windig. Du riechst ueberhaupt nichts.");


  AddItem("d/dschungel/trintrasil/sdschungel/npc/sechse", REFRESH_DESTRUCT);
    
}

int func_seil(string str) {
	
	notify_fail("An was willst Du Dich festhalten?\n");
	
	if(str=="seil"||str=="seil fest"||str=="das seil"||str=="das seil fest"||
	   str=="dich fest"||str=="dich an seil"||str=="dich am seil fest") {
	   	
	   	write(BS("Du klammerst Dich mit schweissnassen Haenden an "
	   	         "das Seil, fuehlst Dich aber nur ein wenig "
	   	         "sicherer."));
	   return 1;}
return 0;}


  