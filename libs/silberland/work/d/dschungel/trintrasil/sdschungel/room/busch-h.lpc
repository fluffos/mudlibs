inherit "std/room";

reset()  {
if( previous_object() && 
   file_name(previous_object())=="/d/dschungel/trintrasil/sdschungel/master")  
   { 
::reset();
return;
}
 return; 
}

create()
{
  ::create();

AddItem("/d/dschungel/trintrasil/sdschungel/npc/posten3.lpc",
        REFRESH_DESTRUCT);    
AddCmd("check", "check");
}

 check()  {
 	"/d/dschungel/trintrasil/sdschungel/master"->check();
 	return 1;
 	}
                  
   