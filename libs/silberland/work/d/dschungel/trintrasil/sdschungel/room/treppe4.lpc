


inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>


create() { 
::create(); 

SetProp( P_LIGHT, 1 ); 
SetProp( P_INDOORS, 0 ); 
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );  
SetProp( P_INT_SHORT, "Auf der Pfahltreppe" ); 
SetProp( P_INT_LONG, BS(

  
  "Dem Wind ungeschuetzt ausgeliefert gehst Du unsicher ueber die dicken "
  "Holzpfaehle. Du hast hier einen imposanten Blick ueber die gelb "
  "leuchtende Sandsteinschlucht. Ein ganz leichter Nieselregen weht aus "
  "Westen heran und liegt wie ein feiner Nebel ueber dem gruenen Wasser "
  "des ´Rio de la Puseta´." )); 

   
 AD(({"treppe","pfahltreppe"}), 
   "Die Treppe besteht aus dicken runden Holzpfaehlen die in kurzen Abstaenden " 
   "absteigend in die senkrechte Felswand gehauen wurden. Der feine Nieselregen "
   "der vom Wasserfall herueber weht legt sich leicht ueber die Holzpfloecke.");

 AD(({"wasserschleier","regen","nieselregen","schleier","feuchtigkeit"}),
   "Der feine Regen legt sich ueber die Holzpfloecke und macht diese teilweise "
   "gefaehrlich rutschig.");

 AD(("nebel"),
   "Der brausende Wasserfall ist von einem leichten wabernden Dunst "
   "eingehuellt.");
   
 AD(("dunst"),
   "Die feinen Wasserschleier entstehen wenn der Wasserfall in den Fluss "
   "donnert.");
        
 AD(("wind"),    
   "Ab und zu traegt der Wind feine Schleier vom Wasserfall im Westen zu Dir.");

 AD(({"ohr","ohren"}),
   "Der Wind reisst besonders an Deinen Ohren.");
   
 AD(({"tiefe"}),    
   "Der Grund der Schlucht ist ca 80m unter Dir.");

 AD(({"pfaehle","holzpfaehle","pfahl","holzpfahl","pfloecke","holzpfloecke"}),
   "Die Holzpfaehle sind sehr dick und stabil, auch wenn diese durch die "
   "staendige Feuchtigkeit etwas verwittert wirken. Sie scheinen sehr fest und "
   "sicher in der Felswand verankert zu sein.");

 AD(({"wand","felswand","sandsteinwand","waende","felswaende","sandsteinwaende",
      "schluchtwand","schluchtwaende","suedliche wand","suedliche felswand",
      "suedliche sandsteinwand","sandstein","stein","hoehe","schluchtwand"}),
   "Die Sandsteinwaende schimmern im Sonnenlicht in allen Gelb- bis "
   "Orangetoenen. Sie ragen senkrecht ueber Dir auf und werfen ihren angenehm "
   "kuehlen Schatten auf Dich.");

 AD(({"gelbtoene","orangetoene","toene","farbtoene","gelb"}),
   "Der obere Teil der Felswaende, auf den noch Sonnenlicht faellt schimmert "
   "in milden, warmen Gelbtoenen. Die Sandsteinwaende ragen ueber 250m "
   "senkrecht in die Hoehe und werfen ihren Schatten auf Dich.");
   
 AD(({"sonne","sonnenlicht","licht"}),
   "Der unteren Teil der suedlichen Schluchtwand liegt hier angenehm im "
   "Schatten.");
   
 AD(({"schluchtrand","rand"}),
   "Der Schluchtrand liegt nun schon viele Meter ueber Dir.");
 
 AD(("meter"),
   "Der Schluchtrand liegt ueber 150 Meter ueber Dir.");
    
 AD(("teil"),
   "Der untere Teil der Schlucht liegt im Schatten."),
   
 AD(("schatten"),
   "Die Felswaende werfen ihren Schatten auf den Fluss. In der Schlucht ist es "
   "daher etwas kuehler."); 

 AD(({"ausblick","blick"}),
   "Der Fluss schillert gruen unter Dir. Weiter flussaufwaerts im Westen "
   "tost der Wasserfall. Die Sandsteinwaende ragen ueber 250m beinahe senkrecht "
   "in die Hoehe und begrenzen den Fluss in seinem Bett.");

 AD(("bett"),
   "Diese Schlucht hat der ´Rio de la Puseta´ in den weichen Sandstein "
   "gegraben.");
   
 AD(({"wasserfall","massen","wassermassen"}),
   "Gewaltige Wassermassen donnern ueber den Wasserfall weiss schaeumend in den "
   "´Rio de la Puseta´. Feine weisse Schleier ziehen vom aufgewirbelten Wasser "
   "von Westen heran.");

 AD(("himmel"),
   "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");
  
 AD(({"haengebruecke","bruecke"}),
   "Die schmale Haengebruecke knarrt weit ober Dir im Wind."); 
 
 AD(({"sandsteinschlucht","schlucht"}),
   "Die Schlucht fuehrt von Westen nach Osten. Tief unter Dir schmiegt sich ein "
   "schmaler Sandstrand an die suedliche Schluchtwand.");
 
 AD(("westen"),
   "Im Westen donnert unablaessig der grosse Wasserfall.");
   
 AD(("osten"),
   "Weiter im Osten scheint der Fluss eine Biegung nach Sueden zu machen, aber "
   "das kannst Du von hier aus nicht besonders gut erkennen.");

 AD(({"biegung","sueden"}),
   "Von hier aus kannst Du die Biegung nicht gut erkennen. Vielleicht siehst "
   "Du mehr wenn Du ganz hinunter zum Fluss gehst.");
    
 AD(({"wolken","wolke"}),
   "Der Himmel ist nahezu wolkenlos.");
 
 AD(({"sandstrand","strand"}),
   "Tief unter Dir schmiegt sich ein schmaler, weisser Sandstrand an die "
   "Felswand. Du wagst es nicht zu genau nach unten zu blicken.");
 
 AD(("boden"),
   "Du stehst auf einem Holzpfahl hoch ueber dem Boden.");

 AD(("seil"),
   "An der Felswand neben Dir ist ein Seil befestigt an dem Du Dich festhalten "
   "kannst.");
   
 AD(({"rio","rio de la puseta","puseta","wasser","fluss"}),
   "Das Wasser des ´Rio de la Puseta´ schillert gruen. Im Westen am Fuss des "
   "Wasserfalles brodelt und schaeumt der Fluss.");
 
 AD(("fuss"),
   "Wo das Wasser ueber den Wasserfall in den ´Rio de la Puseta´ donnert ist "
   "der Fluss ganz aufgewuehlt.");
     
 AD(({"abstand","abstaende"}),
   "In regelmaessigen Abstaenden sind Holzpfaehle in die Felswand gehauen so "
   "das Du ueber sie wie ueber eine Treppe nach unten gehen kannst.");



 AddExit("ostoben", "/d/dschungel/trintrasil/sdschungel/room/treppe3");
 AddExit("ostunten", "/d/dschungel/trintrasil/sdschungel/room/treppe5");
   
   
  AddSound( DEFAULT_SOUND,
    "Das Tosen des Wasser uebertoent hier fast alles.");
  
  AddSound(("tosen"),
    "!!!WWWUUUSSSCCCHHHHH!!!");
      
  AddSmell( DEFAULT_SMELL,
    "Es ist hier sehr windig. Du riechst ueberhaupt nichts.");
  
  
}



  