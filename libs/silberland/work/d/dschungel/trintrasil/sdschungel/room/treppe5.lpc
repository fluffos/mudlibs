

inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>

int pfahl=1;

reset() {
::reset();
pfahl=1;}

void create() { 
::create(); 

SetProp( P_LIGHT, 1 ); 
SetProp( P_INDOORS, 0 ); 
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_JUNGLE]) );  
SetProp( P_INT_SHORT, "Auf der Pfahltreppe" ); 
SetProp( P_INT_LONG, BS(

  "Du befindest Dich im unteren Teil einer sehr hohen Pfahltreppe die "
  "halsbrecherisch vom Strand bis zum Rand der Schlucht fuehrt. Der Wind "
  "weht einen leichten Nieselregen vom Wasserfall zu Dir herueber, der sich wie "
  "eine feuchte Decke ueber alles legt. Unter Dir liegt ein schmaler Sandstrand "
  "den der 'Rio de la Puseta' an die suedliche Uferwand gespuelt hat." )); 

   
 AD(({"treppe","pfahltreppe"}), 
   "Die Treppe besteht aus dicken runden Holzpfaehlen die in kurzen Abstaenden " 
   "absteigend in die senkrechte Felswand gehauen wurden. Der feine Nieselregen "
   "der vom Wasserfall herueber weht legt sich leicht ueber die Holzpfloecke.");

 ASD(({"abstand","abstaende"}),
   "abstand");

 AD(({"regen","nieselregen","schleier"}),
   "Der feine Regen legt sich ueber die Holzpfloecke und macht diese teilweise "
   "gefaehrlich rutschig.");

 AD(("decke"),
   "Der feine Nieselregen legt sich feucht ueber Dein Gesicht und Deine "
   "Haare.");
   
 AD(({"hand","haar","haare","gesicht"}),
   "Du wischt Dir mit der Hand ueber dein nasses Gesicht. Wenigstens kuehlt "
   "der feine Regen angenehm.");
   
 ASD(({"pfaehle","holzpfaehle","pfahl","holzpfahl","pfloecke","holzpfloecke"}),
   "pfahl");
   
 AD(("wind"),    
   "Ab und zu traegt der Wind feine Schleier vom Wasserfall im Westen zu Dir.");

 ASD(({"polster","moospolster","moos","pflock","pfahl"}),
   "moos");
   
 ASD(({"stabilitaet"}),    
   "stabilitaet");

 AD(("stueck"),
   "Der Strand liegt noch einige Meter unter Dir.");
    
 AD(({"wand","felswand","sandsteinwand","waende","felswaende","sandsteinwaende",
      "schluchtwand","schluchtwaende","suedliche wand","suedliche felswand",
      "suedliche sandsteinwand","sandstein","stein","uferwand","ufer"}),
   "Die Sandsteinwaende schimmern im Sonnenlicht in allen Gelb- bis "
   "Orangetoenen. Die Schlucht wirkt hier unten noch schoener als vom Dschungel "
   "aus.");

 AD(({"gelbtoene","orangetoene","toene","farbtoene","gelb","hoehe"}),
   "Der obere Teil der Felswaende, auf den noch Sonnenlicht faellt schimmert "
   "in milden, warmen Gelbtoenen. Die Sandsteinwaende ragen ueber 250m "
   "senkrecht in die Hoehe und werfen ihren Schatten auf Dich.");
   
 AD(({"sonne","sonnenlicht","licht"}),
   "Der unteren Teil der suedlichen Schluchtwand liegt hier angenehm im "
   "Schatten.");
   
 AD(({"schlucht","sandsteinschlucht"}),
   "Die Schlucht fuehrt hier von westen nach osten. Es ist hier angenehm kuehl "
   "und der matte Schimmer der gelben Felswaende taucht alles in eine sanfte "
   "Atmosphaere.");

 AD(({"schimmer","atmosphaere"}),
   "Die im Dschungel so stechende Sonne wirkt hier angenehm gedaempft.");
    
 AD(({"sturz","meter"}),
   "Ein Sturz waere zumindest nicht sehr gesund.");
    
 AD(("teil"),
   "Der untere Teil der Schlucht liegt im Schatten."),
   
 AD(("schatten"),
   "Die Felswaende werfen ihren Schatten auf den Fluss. In der Schlucht ist es "
   "daher etwas kuehler."); 

 AD(({"schluchtrand","rand"}),
   "Der Rand der Schlucht liegt weit ober Dir. Darueber befindet sich der "
   "Dschungel den Du von hier unten aus natuerlich nicht sehen kannst.");
   
 AD(("dschungel"),
   "Um in den Dschungel zu gelangen musst Du Dich die gesamte Treppe hinauf "
   "quaelen.");

 AD(({"rio","rio de la puseta","puseta","wasser","fluss"}),
   "Das Wasser des ´Rio de la Puseta´ schillert gruen. Der Fluss ist hier in "
   "der Schlucht ca 100 meter breit und fliesst gemaechlich von Westen nach "
   "Osten.");

 AD(("westen"),
   "Im Westen donnert unablaessig der grosse Wasserfall.");

 AD(("osten"),
   "Weiter im Osten scheint der Fluss eine Biegung nach Sueden zu machen, aber "
   "das kannst Du von hier aus nicht besonders gut erkennen.");
 
 AD(("sueden"),
   "Von hier aus kannst Du nicht viel erkennen.");
   
 AD(("biegung"),
   "Von hier aus kannst Du die Biegung nicht gut erkennen.");

 AD(({"wasserfall","massen","wassermassen"}),
   "Gewaltige Wassermassen donnern ueber den Wasserfall weiss schaeumend in den "
   "´Rio de la Puseta´. Feine weisse Schleier ziehen vom aufgewirbelten Wasser "
   "von Westen heran.");

 AD(("himmel"),
   "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");

 AD(({"wolken","wolke"}),
   "Der Himmel ist nahezu wolkenlos.");
 
 AD(("boden"),
   "Du stehst auf einem Holzpfahl hoch ueber dem Boden.");

 AD(({"sandstrand","strand"}),
   "An der suedlichen Uferwand hat der Fluss einen schmalen, weissen Sandstrand "
   "angeschwemmt. Er fuehrt nach Westen beinahe bis an den Wasserfall heran, "
   "im Osten endet er leider schon.");
    
 AD(("seil"),
   "An der Felswand neben Dir ist ein Seil befestigt an dem Du Dich festhalten "
   "kannst.");
   

 AddExit("westoben", "/d/dschungel/trintrasil/sdschungel/room/treppe4");
 AddExit("westunten", "/d/dschungel/trintrasil/sdschungel/room/strand1");
   

 AddCmd(({"springe","huepfe","belaste","probiere","spring","probier","teste"}), "pfahl_func");
 
    
  AddSound( DEFAULT_SOUND,
    "Das Tosen des Wasser uebertoent hier fast alles.");
  
  AddSound(("tosen"),
    "!!!WWWUUUSSSCCCHHHHH!!!");
      
  AddSmell( DEFAULT_SMELL,
    "Es ist hier recht windig. Du riechst ueberhaupt nichts.");
  
  
}


int pfahl_func(string str) {

  notify_fail("Auf was willst Du springen?\n");
  
  if(str=="pfahl"||str=="auf pfahl"||str=="auf pfahl herum"||str=="holzpfahl"||
     str=="auf holzpfahl"||str=="auf holzpfahl herum"||str=="pflock"||
     str=="auf pflock"||str=="auf pflock herum"||str=="holzpflock"||
     str=="auf holzpflock"||str=="auf holzpflock herum"||str=="stabilitaet") {

   if(pfahl==1) {     	
    Z1
    write(BS("Du willst es anscheinend genau wissen und springst mit Deinem "
             "gesamten Gewicht auf den morschen Holzpfahl."));
    Z
    write(BS("!!!!!!!!KKKKKRRRRRAAAAACCCCCHHHHHHHHHH!!!!!!!!"));

    S1
    say(BS(""+TPN+" springt auf einen morschen Holzpfahl"));
    S
    say(BS("!!!!!!!!KKKKKRRRRRAAAAACCCCCHHHHHHHHHH!!!!!!!!"));
    S1
    say(BS(""+TPN+" stuerzt mit lautem Krachen hinunter."));    
    
    TP->move("/d/dschungel/trintrasil/sdschungel/room/treppe5-h", M_GO+ 
             M_SILENT+ M_NO_SHOW);
    pfahl=0;
      return 1;}


   if(pfahl==0) {
    Z1
    write(BS("Der Pfahl auf den Du da springen willst ist bereits heraus "
             "gebrochen!")); 
      return 1;}
   return 0;}
 return 0;}

abstand() {

 if(pfahl==1) {
  return(BS("In regelmaessigen Abstaenden sind Holzpfaehle in die Felswand "
            "gehauen so das Du ueber sie wie ueber eine Treppe nach unten gehen "
            "kannst."));
              return 1;}
              
  if(pfahl==0) {
   return(BS("In regelmaessigen Abstaenden sind Holzpfaehle in die Felswand "
             "gehauen so das Du ueber sie wie ueber eine Treppe nach unten "
             "gehen kannst. Nur ein Holzpfahl ist hier anscheinend heraus "
             "gebrochen."));
              return 1;}
            return 0;}


pfahl() {
 
  if(pfahl==1) {
   return(BS("Da die Holzpfloecke vom Nieselregen immer feucht sind sehen diese "
             "hier schon etwas verwittert aus. Auf einen der Pfloecke hat sich "
             "ein duenner Moospolster angesiedelt."));
              return 1;}
              
  if(pfahl==0) {
   return(BS("Da die Holzpfloecke vom Nieselregen immer feucht sind sehen diese "
             "hier schon etwas verwittert aus. Tatsaechlich ist ein Holzpflock "
             "bereits herausgebrochen."));
              return 1;}
            return 0;} 
            
            
moos() {
	
  if(pfahl==1) {
   return(BS("Dunkelgruenes Moos waechst auf dem Holzpfahl. Hoffentlich hat das "
             "seiner Stabilitaet nicht geschadet."));
              return 1;}
              
  if(pfahl==0) {
   return(BS("Der Holzpfahl der besonders stark mit Moos bewachsen war ist "
             "schon ausgebrochen."));
              return 1;}
            return 0;} 
            
            
stabilitaet() {
	
  if(pfahl==1) {
   return(BS("Du solltest es nicht ausprobieren und auf ihm herumspringen. Der "
             "Strand liegt doch noch ein schoenes Stueck unter Dir."));
              return 1;}
              
  if(pfahl==0) {
   return(BS("Anscheinend war der Holzpfahl nicht besonders stabil."));
              return 1;}
            return 0;}
            