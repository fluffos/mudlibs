
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create()
{
  ::create();

  SetProp( P_INT_SHORT, "beim Sturz von der Pfahltreppe" );
  SetProp( P_INT_LONG, BS(
  "Unnoetig!"));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
   AddCmd ("", "no", 1);   
  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
  int no()
  {
    write (
    "Du ruderst kreischend mit den Armen!\n");
      return 1;
    }
     
    
  init() {
  ::init();

if(query_once_interactive(this_player())){
	
	call_out("sturz1", 1);
}

}
  

sturz1() {
	
	NIX
	write(BSL("\nSofort bricht der Holzpfahl unter Dir weg."));
	call_out("sturz2", 1);
}

   
sturz2() {
	
	NIX
	write(BSL("\nDu kannst Dich nicht festhalten und stuerzt erschrocken kreischend "
	"hinunter."));
	call_out("sturz3", 1);
}

 
sturz3() {
	
	object mulde;
	object pfahl;
	
	NIX
	tell_room("/d/dschungel/trintrasil/sdschungel/room/strand1", 
        BSL("\n!!!!!BBBBBUUUUUUMMMMMMMMMMM!!!!!\n\n"+TPN+" faellt von oben herab "
        "und schlaegt hart auf dem Strand auf."));
        write(BSL("\n!!!!!BBBBBUUUUUMMMMMMMMMM!!!!!\n\nDu schlaegst hart auf dem "
        "Strand auf."));
        TP->AddHp(-30-random(20));
        TP->move("/d/dschungel/trintrasil/sdschungel/room/strand1", M_GO+ M_SILENT+
        M_NO_SHOW);
        mulde=clone_object("/d/dschungel/trintrasil/sdschungel/obj/loch.lpc");
        mulde->move("/d/dschungel/trintrasil/sdschungel/room/strand1.lpc", M_TPORT);
        mulde->SetProp(P_LONG, BS("Diese Mulde hat "+CAP(getuid(TP))+" bei einem Sturz "
        "in den Boden geschlagen."));
        pfahl=clone_object("/d/dschungel/trintrasil/sdschungel/obj/pfahl.lpc");
        pfahl->move("/d/dschungel/trintrasil/sdschungel/room/strand1", M_TPORT);
        tell_room("/d/dschungel/trintrasil/sdschungel/room/strand1", 
        BSL("\nEin abgebrochener Holzpfahl faellt von oben herab und haette "
        "Dich beinahe getroffen!!"));
}
    
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/hoehle/room/strand1",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
}

  