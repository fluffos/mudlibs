
#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


reset()  {
if( previous_object() && 
   file_name(previous_object())=="/d/dschungel/trintrasil/sdschungel/master")  
   { 
::reset();
return;
}
 return; 
}

create() {

  ::create();

/*  
Somit werden, die bei einem angriff auf den posten hier zu hilfe 
kommenden posten auch geladen, womit sie auch dann im master erfasst sind wenn 
noch niemand bei ihnen war.. und 
2tens treten zu grosse zeitliche schwankungen auf wenn bei einem angriff die 
betreffenden files erst geladen werden muessen (getestet im homemud :) ) 
(wachtmeister und torposten treffen nahezu gleichzeitig ein und das tell_room
von wachtmeister (posten_move_wern1) kommt dann eigenartigerweise nicht*/

call_other("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", "load");
call_other("/d/dschungel/trintrasil/sdschungel/room/turm", "load");
call_other("/d/dschungel/trintrasil/sdschungel/room/busch-h", "load");
	

  SetProp( P_INT_SHORT, "Auf einer grossen Haengebruecke" );
  SetProp( P_INT_LONG, BS(
    "Du gehst ueber die stark schaukelnden Haengebruecke und klammerst Dich an "
    "die Seile. In der Tiefe rauscht ein grosser Fluss dahin, "
    "der Wind pfeift Dir um die Ohren, und Du hast grosse Muehe das "
    "Gleichgewicht zu behalten. Das suedliche Ende der Bruecke ist schon in "
    "Sicht."));
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AD(({"bruecke","haengebruecke","konstruktion"}),
  "Die Bruecke spannt sich von hier ueber die ganze Schlucht nach Sueden. "
  "Sie ist eine einfache Konstruktion aus Holzbrettern und Seilen.");

  AD(({"schlucht","grund"}),
  "Tief unter Dir, am Grund der Schlucht fliesst der 'Rio de la Puseta' dahin.");
    
  AD(("holz"),
  "Das Holz schaut schon ziemlich morsch aus. Hoffentlich bricht keines der "
  "Bretter.");
  
  AD(({"seil","seile"}),
  "Die Seile verbinden die einzelnen Bretter und zwei besonders dicke Seile "
  "sind als Gelaender rechts und links gespannt.");
  
  AD(("gelaender"),
  "Das Gelaender besteht nur aus zwei Seilen. Pass auf, dass Du nicht in die "
  "Tiefe stuerzt.");
  
  AD(({"holzbretter","bretter","brett","holzbrett"}),
  "Zwischen den Brettern sind grosse Luecken...");
  
  AD(({"luecken","luecke"}),
  "Sei lieber vorsichtig.");
  
  AD(({"ende","sicht"}),
  "Du erkennst wie am suedlichen Ende der Bruecke wieder ein Pfad beginnt.");
    
  AD(({"seite","seiten","pfad"}),
  "Der Pfad fuehrt im Norden und im Sueden der Bruecke durch den Dschungel.");
  
  AD(("sueden"),
  "Wohin der Pfad im Sueden fuehrt kannst Du von hier aus nicht erkennen.");
  
  AD(("norden"),
  "Im Norden fuehrt der Pfad steil wieder bergauf...");
  
  AD(("dschungel"),
  "Der Dschungel wuchert zu beiden Seiten der Schlucht.");

  AD(("gleichgewicht"),
  "OOOPS!!! Fast waerst Du in die Tiefe gestuerzt.");
  
  AD(("muehe"),
  "Du haeltst Dich am Gelaender fest um das Gleichgewicht nicht zu verlieren.");
  
  AD(({"fluss"}),
  "Unter Dir fliesst der Rio de la Puseta dahin.");
  
  AD(("wasser"),
  "Das Wasser leuchtet gruen.");
  
  AD(({"rio","puseta","rio puseta","rio de la puseta"}),
  "Der Rio de la Puseta schaut von hier oben noch viel maechtiger und breiter "
  "aus.");
  
  AD(("wind"),
  "Der Wind laesst die Bruecke hin und herschwanken...");
  
  AD(({"ohr","ohren"}),
  "Du hoerst den Fluss rauschen und den Wind pfeifen...");
  
  AD(({"tiefe","uferseite"}),
  "Tief unter Dir fliesst der gruene 'Rio de la Puseta' nach Osten. An der "
  "suedlichen Uferseite hat der Fluss einen schmalen Sandstrand angeschwemmt.");
 
  AD(({"sandstrand","strand"}),
  "Der Strand liegt so tief unter Dir das Du nicht lange nach unten blicken "
  "kannst ohne das Dir mulmig wird.");
  
  AD(({"wand","sandsteinwand","steinwand","meter","schluchtwand"}),
  "Die gewaltige Schluchtwand schimmert gelb im Sonnenlicht. Sie erhebt sich "
  "nahezu 250 Meter in die Hoehe.");
  
  AD(("hoehe"),
  "Dir wird schwindlig wenn Du zu lange nach unten blickst.");

  AD(({"sonnenlicht","licht","sonne"}),
  "In der Schlucht ist es schattiger. Dort ist es sicher kuehler.");
  
  AD(("himmel"),
  "Der Himmel ist nahezu wolkenlos. Die Sonne brennt unbarmherzig auf Dich "
  "herab.");

  AD(("luft"),
  "Wenn Du die Luft sehen koenntest waere das fuer Dich wahrscheinlich "
  "problematisch.");
  
  AD(("boden"),
  "Du stehst auf einem morschen Holzbrett der Haengebruecke. Der Fluss fliesst "
  "tief unter Dir dahin.");
  

AddItem("/d/dschungel/trintrasil/sdschungel/npc/posten2", REFRESH_DESTRUCT);


  AddSound( DEFAULT_SOUND,
    "In der Tiefe rauscht das Wasser.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");


  AddRoomMessage(({
  "Die Bruecke schaukelt gewaltig hin und her...\n",
  "Der Wind zerzaust Dein Haar.\n",
  "In der Tiefe rauscht der Fluss.\n",
  "Fast waerst Du gestolpert...\n",
  "Das Holz knarrt verdaechtig laut...\n", 
  "Die Bruecke schwankt im Wind...\n"}),40);


AddExit("norden", "/d/dschungel/dante/weg/room/bruecke3");

AddExit("sueden", "/d/dschungel/trintrasil/sdschungel/room/bruecke1");


AddCmd(({"springe","spring"}), "tod");

}



 tod(string str )
{
  notify_fail( "Wohin willst Du springen ?\n" );
if ( !str ) return 0;
if ( member( ({"nach unten","runter","in wasser","in fluss","in tiefe","ueber seil","von bruecke" }),str) !=-1 )
 {
 if(TP->QueryProp(P_GHOST))
 {
   write("Aber Du bist doch schon tot!!\n");
   return 1;
 }
write(BS("Du willst Dein Leben also beenden? Dann gib 'spring "
     "selbstmoerderisch von der bruecke' ein."));
 return 1;
 }
 
if( member(( {"selbstmoerderisch von der bruecke","selbstmoerderisch von bruecke"}), str) !=-1 )
                                       
{
 say(CAP_TPN+" setzt seinem jaemmerlichen Leben ein Ende und springt in den Tod.\n");
clone_object("/d/dschungel/dante/weg/obj/sprung.lpc")->move(TP, M_NOCHECK);
 TP->move("/d/dschungel/dante/weg/room/tod", M_NO_SHOW + M_SILENT + M_GO);
 write( " \n"
 "Du setzt einen Schlusstrich unter Dein jaemmerliches Leben und springst ueber das Seil in den Tod.\n"
 " \n"
 "      AHHHH.....\n"
 " \n"
 "             HHHHH.....\n"
 " \n"
 "                    HHHHH.....\n"
 " \n"
 "                           HHHHH.....\n"
 " \n");
 call_out("st1",6);

 return 1;
 }
 return 0;
 }
st1()
{
write(" \n"
"Du bereust diesen unueberlegten Schritt noch waerend Du in der Luft nach unten "
"rast, aber nun ist es zu wohl spaet, Du Idiot...\n");
tell_room(TO,"Du siehst wie "+TPN+" in die Tiefe stuerzt.\n");
call_out("st2",6);
}

st2()
{
write(" \n"
"Du prallst auf dem steinharten Wasser auf und wirst zerschmettert!!!\n");
tell_room(TO,"Du erkennst in der Tiefe der Schlucht wie "+TPN+" zerschmettert wird.\n");
TP->do_damage(500);
SetProp(P_KILL_NAME, "Ein selbstmoerderischer Sprung");
}