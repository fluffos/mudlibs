inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, ""+ANSI_RED+"Ein Paradeisvogel"+ANSI_NORMAL+"");
  SetProp(P_LONG, BS(
    "Der Paradeisvogel hat ein praechtig leuchtendes tomatenrotes Gefieder. "
    "Er gehoert zur Gruppe der suedtijaresischen Paradiesvoegel. Er plustert "
    "seine schillernden Federn und zwitschert froehlich."));
  SetProp(P_NAME, "Paradeisvogel");
  SetProp(P_GENDER, MALE);
  AddId(({"paradeis","paradeisvogel","vogel"}));

  create_default_npc(9);
  
  SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
  
  SetProp(P_HANDS, ({" mit seinem Gefieder",  QueryProp(P_HANDS)[1] ,(DT_BLUDGEON)}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 25);
  SetProp(P_ALIGN, 20);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 30);
  SetProp(P_DIE_MSG, " zwitschert ein letztes Mal.\n");
  SetProp(P_NOCORPSE, 0),
  SetProp( P_REJECT, ({ REJECT_GIVE,
     "Der Vogel kann damit nichts anfangen.\n"}) );

  SetProp (P_MNPC_AREA, "/d/dschungel/");
  SetProp (P_MNPC_WAIT, ({1+random(15), 25, 30}));  
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+ MOV_MOVES+ MOV_BACKWARDS);
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/trintrasil/sdschungel/room/sdschungel1");
  SetProp (P_MMSGIN, "fliegt herein");
  SetProp (P_MMSGOUT, "fliegt davon");
  SetProp (P_MSGIN, "fliegt herein");
  SetProp (P_MSGOUT, "fliegt");
  
  AD(({"federn"}),
    "Der Paradeisvogel hat rot schillernde Federn. Es scheint sich um ein "
    "Maennchen zu handeln, da nur die Maennchen der suedtijaresischen "
    "Paradiesvogelarten so auffaellige Balzkleider tragen.");

  AD(({"maennchen"}),
    "Die Maennchen umwerben in der Balzzeit die Weibchen mit ihren leuchtenden "
    "Gefiedern.");
    
  AD(({"balzzeit","zeit"}),
    "Gut das gerade Balzzeit ist. Sonst waere das Gefieder des Vogels viel "
    "unauffaelliger.");
    
  AD(("weibchen"),
    "Die Gefieder der Weibchen sind unauffaelliger und tarnender.");

  AD(("gruppe"),
    "Zur Gruppe der tijaresischen Paradiesvoegel zaehlen viele hier lebenden "
    "Singvogelarten.");
        
  AD(({"vogelarten","arten","paradiesvogelarten","gattung","art",
       "paradiesvoegel","singvogelarten","singvogelart"}),
    "Es gibt im tijaresischen Dschungelgebiet viele Singvogelarten die durch "
    "ihr besonders praechtiges Gefieder auffallen.");
    
  AD(({"balzkleid","farben","gefieder"}),
    "Die Farben sind besonders leuchtend bunt. Das Gefieder des Paradeisvogels "
    "ist tomatenrot und wird oft fuer Schmuckfedern verwendet.");
    
  AD(({"schmuckfedern","unsinn"}), 
    "Was fuer ein Unsinn den schoenen Vogel fuer seine Federn zu toeten.");
        
  AD(({"dschungelgebiet","gebiet"}),
    "Besonders das Flussgebiet des Rio de la Puseta ist reich bevoelkert.");
    
  AD(({"flussgebiet","fluss","rio","puseta","rio de la puseta"}),
    "Der Fluss ist relativ nahe.");
    
    
  AddInfo(DEFAULT_INFO, "Der Paradeisvogel flattert mit den Fluegeln.\n");

 SetChats(7, ({
 	"Zuuwiiiiitsch, Zuuwiiiiitsch.\n",
 	"Zwitscher, Zwitscher, Zuuwiiiiitsch.\n",
 	"Zwiwitt, Zwiwitt, Zuuwiiiiitsch.\n"}));
}

/*
_query_name() {
	
	if(TP && interactive(TP) && TP->QueryProp(P_TTY)=="ansi") {
		return "Paradeisvogel";
	}
	
	if(TP && interactive(TP) && !TP->QueryProp(P_TTY)=="ansi")  {
		return "Paradeisvogel";
	}


}
*/

_query_short() {
	
	if(TP->QueryProp(P_TTY)=="ansi") {
		return ""+ANSI_RED+"Ein Paradeisvogel"+ANSI_NORMAL+"";
	}
	
	if(TP->QueryProp(P_TTY)!="ansi") {
		return "Ein Paradeisvogel";
	}
}
 
 