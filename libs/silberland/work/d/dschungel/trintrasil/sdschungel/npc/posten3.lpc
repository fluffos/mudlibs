

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#define MASTER "/d/dschungel/trintrasil/sdschungel/master"



void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Meinhart, der Wachposten");
  SetProp(P_LONG, BS(
        "Der dickliche Wachposten ist immer noch wuetend weil er beim Austreten "
        "gestoert wurde, was man an seiner schlecht sitzenden und schnell "
        "zurechtgemachten Uniform erkennt."));   
  SetProp(P_NAME, "Wachposten");
  SetProp(P_GENDER, MALE);
  enable_commands();
  set_living_name("meinhart");

  AddId(({"waechter","wachtposten","wache","wachposten","posten","gardist",
        "meinhart","NOWIMPY"}));//nowimpy sollte er zwar kaum brauchen,
  //schaden kanns aber auch net (sein raum ist
  create_default_npc(20);         //unbetretbar)
  
  SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
  
  SetProp(P_BODY, 50);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 178);
  SetProp(P_ALIGN, 0+random(30));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " sinkt roechelnd zu Boden.\n");

  AddInfo(DEFAULT_INFO, ({
        "zuckt desinteressiert mit den Schultern.\n",
        "sagt: Tut mir leid da kann ich auch nicht helfen.\n",
        "sagt: Vielleicht weiss mein Vorgesetzter im Turm etwas darueber.\n",
        "sagt: Das weiss ich leider nicht.\n",
        "sagt: Vielleicht sagt ihnen in Tijara jemand bescheid.\n"}));


  SUID;
  CLONEME("/p/weapon/spear/hellebarde");
  command("zuecke hellebarde");

  CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/dschungelhelm");
  CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/stiefel");  
  CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/lederp");
  command("trage alles");


  MASTER->add_mann();

} 



void NotifyPlayerDeath(object player, object killer, int lostexp) {

  MASTER->remove_enemy(player);
}



int Defend(int dam, mixed dam_type, mixed spell, object enemy) {

  MASTER->ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
  //ruft keine support im master auf da er nur fuer spieler zugaenglich ist wenn
  //er mit den anderen posten auf einem feld steht
}



remove(int arg) {

  MASTER->remove_mann(this_object());
  ::remove(arg);
}



//ooooooooooooooooooooooooooo POSTENMOVE_HERM oooooooooooooooooooooooooooooooooooo

postenmove_herm() {

  call_out("postenmove_herm1", 9);
}


postenmove_herm1() { 

  object meinh;
  meinh=this_object();

  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nEin Wachposten kommt brummelnd aus den Bueschen "
      "hervor!!!\n\n");
  meinh->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", M_TPORT+ 
      M_SILENT); 
  call_out("postenmove_herm2", 1);
}


postenmove_herm2() {

  TELLSD(sdschungel2,"Nichtmal beim Austreten hat man seine "
      "Ruhe!",
      "Der Wachposten Meinhart flucht: ");
}	
//oooooooooooooooooooooooooo POSTENMOVE_RUED ooooooooooooooooooooooooooooooooooooo

postenmove_rued() {

  call_out("postenmove_rued1", 9);
}


postenmove_rued1() { 

  object meinh;
  meinh = this_object();

  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nEin Wachposten kommt brummelnd aus den Bueschen hervor und "
      "hastet schnell \nauf den Wachturm.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
      "\nDer Wachposten Meinhart klettert herauf!"
      "\n\n");
  meinh->move("/d/dschungel/trintrasil/sdschungel/room/turm", M_TPORT+ 
      M_SILENT);
  call_out("postenmove_rued2", 1);
}


postenmove_rued2() {

  TELLSD(turm,"Nichtmal beim Austreten hat man seine Ruhe!",
      "Meinhart flucht: ");
}     


//ooooooooooooooooooooooooo POSTENMOVE_WERN oooooooooooooooooooooooooooooooooooooo

postenmove_wern() {
  call_out("postenmove_wern1", 9);
}


postenmove_wern1() { 

  object meinh;
  meinh = this_object();

  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nEin Wachposten kommt brummelnd aus den Bueschen hervor und "
      "hastet schnell \nnach Norden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke2",
      "\nDer Wachposten Meinhart eilt herbei!\n\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nEin Wachposten eilt an Dir vorbei nach Norden!\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nEin Wachposten eilt an Dir vorbei nach Norden!\n");
  meinh->move("/d/dschungel/trintrasil/sdschungel/room/bruecke2", M_TPORT+ 
      M_SILENT);
  call_out("postenmove_wern2", 1);
}   


postenmove_wern2() {

  TELLSD(bruecke2,"Nichtmal beim Austreten hat man seine Ruhe!",
      "Meinhart flucht: ");
}        


//oooooooooooooooooooooooooooo RESET_FUNCTIONEN ooooooooooooooooooooooooooooooooo

turm_reset() {

  call_out("turm_reset1", 4);
}


turm_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "\nDer Wachposten Meinhart klettert nach unten.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Wachposten Meinhart klettert vom Turm herab.\n");
  SD1(sdschungel2);	
  TELLSD(sdschungel2,"Ich komme gleich, ich muss nur mal kurz austreten.",
      "Der Wachposten Meinhart sagt: ");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2","\nDer "
      "Wachposten Meinhart schlaegt sich in die Buesche.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/busch-h.lpc", M_GO+
      M_SILENT);
}



bruecke_reset() {

  call_out("bruecke_reset1", 4);
}

bruecke_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "\nDer Wachposten Meinhart geht nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Wachposten Meinhart kommt an.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Wachposten Meinhart geht an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Wachposten Meinhart geht an Dir vorbei nach Sueden.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", M_GO+ 
      M_SILENT);
  call_out("bruecke_reset2", 2);        
}


bruecke_reset2() {

  object posten;
  posten=this_object();

  SD1(sdschungel2)	
    tell_room(environment(TO), (BSA("Ich komme gleich, ich muss nur mal kurz "
            "austreten.","Der Wachposten Meinhart sagt: ")));
  tell_room(environment(TO),"\nDer Wachposten schlaegt sich in die Buesche.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/busch-h.lpc", M_GO+
      M_SILENT);
}  



tor_reset() {
  call_out("tor_reset1", 4);
}


tor_reset1() {

  object posten;
  posten=this_object();

  SD1(sdschungel2)	
    tell_room(environment(TO), (BSA("Ich komme gleich, ich muss nur mal kurz "
            "austreten.","Der Wachposten Meinhart sagt: ")));
  tell_room(environment(TO),"\nDer Wachposten schlaegt sich in die Buesche.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/busch-h.lpc", M_GO+
