inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Sandkrabbe");
  SetProp(P_LONG,
    "Die kleine Sandkrabbe hat einen sandgelben Panzer der sie sehr gut tarnt. "
    "Wenn sie sich nicht bewegt kann man sie leicht aus den Augen verlieren.");
  SetProp(P_NAME, "Sandkrabbe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"krabbe","sandkrabbe"}));

  create_default_npc(3);
  
  SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
  
  SetProp(P_HANDS, ({"mit ihren schillernden Stilaugen", 30+random(20) ,(DT_BLUDGEON)}));
  SetProp(P_BODY, QueryProp(P_BODY),10);
  SetProp(P_RACE, "Krebs");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 15);
  SetProp(P_DIE_MSG, " stuerzt schwer verwundet zu Boden.\n");
  SetProp(P_NOCORPSE, 0),
  SetProp( P_REJECT, ({ REJECT_GIVE,
     "Was soll denn eine Krabbe mit diesem Krempel.\n"}) );

  SetProp (P_MNPC_AREA, "/d/dschungel/trintrasil/sdschungel/strand");
  SetProp (P_MNPC_WAIT, ({random(15), 20, 20}));  
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+ MOV_MOVES+ MOV_BACKWARDS);
   SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/trintrasil/sdschungel/room/strand1");
  SetProp (P_MMSGIN, "krabbelt herein");
  SetProp (P_MMSGOUT, "graebt sich im Sand ein");
  SetProp (P_MSGIN, "krabbelt herein");
  SetProp (P_MSGOUT, "krabbelt");
  
  AD(({"panzer"}),
    "Der Panzer ist sandgelbweissgefleckt und die ideale Tarnung am Sand.");

  AD(("tarnung"), 
    "Wo ist denn die Krabbe ploetzlich hin berschwunden?");
        
  AD(({"stilaugen","augen"}),
    "Die Krabbe dreht ihre Stilaugen um 360 Grad.");
    
  AD(({"grad"}),
    "Wow die Krabbe kann ihre Augen aber rotieren lassen!");
    
    
  AddInfo(DEFAULT_INFO, "Die Krabbe dreht froehlich ihre Augen.\n");

 SetChats(4, ({
 	"Die Krabbe klickt mit ihren Scheren.\n",
 	"Die Krabbe laesst ihre Augen rotieren.\n",
 	"Die Krabbe laeuft seitwaerts ueber den Strand.\n",
 	"Die Krabbe duckt sich ploetzlich in den Sand.\n",
 	"Die Krabbe laeuft um Dich herum.\n",
 	"Die Krabbe zwickt Dir mit ihren Scheren beinahe ein Bein ab.\n"}));
 	
 SUID;
 CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/krabbenhelm.lpc");
 command("trage panzer");


}
