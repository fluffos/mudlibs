

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#define MASTER "/d/dschungel/trintrasil/sdschungel/master"


fightstatus() {//um zu verhindern das die posten in einem Kampf gruessen

  TO->SetProp("infight", 1);//wird deshalb statt InFight bei der Begruessung 
}                        //verwendet da die posten wenn sie einen Enemy haben
//auch dann nicht gruessen sollen wenn er nicht im selben Raum ist
//nach einem Kampf wird infight in den ResetFunc (ende file) 
//zurueckgesetzt

init()  {
  ::init();

  if(interactive(TP))  { 
    call_out("postengruss", 1); 
  }


  if(!interactive(TP)) {
    return 0;}	
}


int postengruss() {

  if( environment(TO) != environment(TP) ) { 
    return 1;  }


  if(TO->QueryProp("infight")) {
    //      tell_room(environment(TO), zu testzwecken
    //             "!!!INFIGHT!!!\n");
    return 1;}


  if(!TO->QueryProp("infight")) {

    if( TP->QueryProp(P_GENDER)!=FEMALE )    {	

      tell_room(environment(TO),
          "\nDer Torposten sagt: Schoenen Tag der Herr!\n");

      return 1;}

      if( TP->QueryProp(P_GENDER)==FEMALE )      {

        switch(random(4)) {

          case 1 : SD1(sdschungel2)

                   tell_room(environment(TO),
                       BS("Der Torposten sagt: Guten Tag Gnae' Frau!"));
                   break;

          case 2 :  SD1(sdschungel2)
                    tell_room(environment(TO),
                        BS("Der Torposten sagt: Na schoene Frau, ganz allein "
                          "unterwegs?"));
                    break;
          case 3 :   SD1(sdschungel2)
                     tell_room(environment(TO),
                         BS("Der Torposten sagt: Na die Dame, ganz allein in dieser "
                           "Wildnis?"));
                     break;
          case 0 :
                     SD1(sdschungel2)
                       tell_room(environment(TO),
                           BS("Der Torposten sagt: Schoenen Tag die Dame!"));
                     break;

          default:	SD1(sdschungel2)
                        tell_room(environment(TO),
                            BS("Der Torposten sagt: Schoenen Tag die Dame!"));

                        return 1;}
                        return 0;}

      else  {
        write(BSA(
              "HE! Ein Transsexueller!",
              "Der Torposten lacht: "));
        return 1;  }

        return 0;}
        return 0;}    




        void create() {


          if (!is_clone(TO)) return;
          ::create();

          SetProp(P_SHORT, "Hermann, der gelangweilte Torposten");
          SetProp(P_LONG, BS(
                "Der Posten scheint von seinem Dienst hier nicht besonders begeistert "
                "zu sein. Er sieht eher gelangweilt und nicht gerade motiviert aus."));   
          SetProp(P_NAME, "Torposten");
          SetProp(P_GENDER, MALE);
          AddId(({"waechter","wachtposten","wache","wachposten","posten","gardist",
                "hermann","torposten","NOWIMPY"}));

          create_default_npc(26);
          
          SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
          
          SetProp(P_BODY, 50);
          SetProp(P_RACE, "Mensch");
          SetProp(P_SIZE, 178);
          SetProp(P_ALIGN, 0+random(30));
          SetProp(P_MAX_HANDS, 2);
          SetProp(P_HEAL,0);
          SetProp(P_AGGRESSIVE,0);
          SetProp(P_WIMPY, 0);
          SetProp(P_DIE_MSG, " sackt blutend zusammen.\n");

          AddInfo(DEFAULT_INFO, ({
                "zuckt desinteressiert mit den Schultern.\n",
                "sagt: Tut mir leid da kann ich auch nicht helfen.\n",
                "sagt: Vielleicht weiss mein Vorgesetzter im Turm etwas darueber.\n",
                "sagt: Das weiss ich leider nicht.\n",
                "sagt: Vielleicht sagt ihnen in Tijara jemand bescheid.\n"}));

          AddInfo(({"schloss","schluessel"}),
              "Den Schluessel fuer das Schloss des Palisadentores hat nur der "
              "Gouverneur. Es bleibt in der naechsten Zeit ohnehin geschlossen.","sagt: ");

          AddInfo(({"geheiss","zeit"}),
              "Aufgrund der Probleme im suedlichen Dschungel werden in naechster Zeit "
              "keine Passierscheine ausgestellt.","sagt: ");

          AddInfo(({"schein","passierschein","scheine","passierscheine"}),
              "Ein Passierschein kann nur im Amt des Gouvernement beantragt werden, und "
              "das stellt zur Zeit keine Passierscheine aus.","sagt: ");

          AddInfo(({"amt","gouvernement","amt des gouvernement"}),
              "Direkt am Hauptplatz, nicht zu verfehlen.","sagt: ");

          AddInfo(({"hauptplatz","platz"}),
              "Sie kennen den Hauptplatz in Tijara nicht? Das ist doch wohl ein "
              "Scherz!","sagt: ");

          AddInfo(("tijara"),
              "Da sind Sie wohl aus dem Himmel gefallen wenn sie Tijara nicht "
              "kennen, was? *HAHAHAHAA*!","lacht: ");

          AddInfo(("himmel"),
              "Nur ein kleiner Scherz.","grinst: ");     

          AddInfo(("scherz"),
              "Moment der ist gut. Was ist der Unterschied zwischen Stadtwachen und "
              "Hafenhuren? Keiner! Beide stehen auf der Strasse und die Eltern schaemen "
              "sich dafuer! *HAHAHAHAHAHA*","sagt: ");

          AddInfo(({"hafenhuren","huren","hafenhure","hure"}),
              "Wenn sie das interessiert sind Sie hier in der Wildniss falsch. Da wuerde "
              "Ich eher mal nach Tijara schaun.","sagt: ");

          AddInfo(({"tor","palisadentor"}),
              "Das Tor bleibt bis auf weiteres wegen anhaltender Probleme "
              "geschlossen.","sagt: ");

          AddInfo(({"probleme","problem"}),
              "Irgendetwas tut sich mal wieder bei den Staemmen im Sueden."
              ,"sagt: ");

          AddInfo(({"sueden","suedlichem dschungel","dschungel"}),
              "Suedlich von hier ist das Land noch so gut wie unerschlossen. Die "
              "Erkundungsexpeditionen die das Gouvernement letztens losgeschickt hat "
              "sind ganz schoen zugerichtet worden.","sagt: ");

          AddInfo(({"irgendetwas","etwas","was","irgendwas","kampf"}),
              "Es war bis jetzt ruhig hier im Sueden. Aber von den letzen Expeditionen sind "
              "nicht einmal die Haelfte der Soldaten zurueck gekommen.","sagt: ");

          AddInfo(({"kameraden","haelfte","soldaten"}),
              "Waren alles gute Kameraden.","seufzt: ");

          AddInfo(({"expedition","expeditionen","wilde","erkundungsexpeditionen",
                "erkundungsexpedition","erkundung"}),
              "Hol sie der Teufel! Die haben bei einem Ueberfall fast alle nieder "
              "gemacht!","flucht: ");

          AddInfo(("teufel"),
              "Von dem werden wohl immer wieder mal die Eingeborenen geritten!",
              "flucht: ");

          AddInfo(({"ueberfall","ueberfaelle"}),
              "Dieser Vorposten soll verhindern das diese Wilden bis nach Tijara "
              "vordringen.","sagt: ");

          AddInfo(({"posten","vorposten"}),
              "Ein hartes und gefaehrliches Brot hier draussen, das kann ich ihnen "
              "sag.","sagt: ");

          AddInfo(("brot"),
              "Tja, komm zur Armee, da erlebst Du was, hat es im Anwerbebureau "
              "geheissen.","sagt: ");

          AddInfo(("armee"),
              "Wollen sie sich etwa anwerben lassen?","sagt: ");

          AddInfo(({"anwerbebureau","bureau"}),
              "Tja, jung und dumm, und jetzt steh ich hier.","sagt: ");

          AddInfo(({"eingeborene","staemme"}),
              "Am unruhigsten ist der Stamm der Kannibalen.","sagt: ");

          AddInfo(({"kannibalen","kannibale","stamm","kannibalenstamm",
                "stamm der kannibalen"}),
              "Die Kannibalen haben ihr Dorf irgendwo suedoestlich von hier.","sagt: ");

          AddInfo(({"dorf","kannibalendorf"}),
              "Mich zieht es nicht unbedingt dort hin.","sagt: ");

          AddInfo(({"dienst","strafdienst","lieblingsgetraenk","getraenk"}),
              "Haette ich nur nicht so viel Dschungelbier getrunken!", "kreischt: ");

          AddInfo(({"bier","dschungelbier"}),
              "Mein Lieblingsgetraenk in der Tijara Hafenkneipe", "sagt: ");

          AddInfo(({"hafenkneipe","kneipe"}),
              "Wenn ich einmal dienstfrei habe sehen wir uns vielleicht dort.", "sagt: ");

          AddInfo(({"garde","gardist"}),
              "Bald kommt mich jemand abloesen.","sagt: ");

          AddInfo(("gouverneur"),
              "Auf Geheiss des Gouverneur bleibt das Tor bis auf weiteres geschlossen.",
              "sagt: ");

          SUID;
          CLONEME("/p/weapon/spear/hellebarde");
          command("zuecke hellebarde");

          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/dschungelhelm");
          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/stiefel");  
          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/lederp");
          command("trage alles");


          MASTER->add_mann();

        } 



//oooooooooooooooooooooo POSTENMOVE HERM oooooooooooooooooooooooooooooooooooooooo
/*ist der wachtmeister nicht vorhanden, muss der torposten selber seine langsamen
  kameraden rufen. ist er hier ist diese funkt nutzlos und der wachtmeister
  uebernimmt als ranghoeherer die aufgabe im master die hermann 2 auszuloesen*/

postenmove_herm() {

  call_out("postenmove_herm1", 3);
}

postenmove_herm1() {

  if(present("ruediger", environment(TO))) { //wenn es den wachtmeister gibt 
    return 0;}                          //wird er in 3 sec in env(TO) gemoved
  //ist er von vorherigen kaempfen tot, uebernimmt dieser
  //posten das hilferufen
  if(!present("ruediger", environment(TO))) {
    call_other("/d/dschungel/trintrasil/sdschungel/master",
        "hermann2");
  }
}



//oooooooooooooooooooooo POSTENMOVE RUED oooooooooooooooooooooooooooooooooooooooo

postenmove_rued() {

  if(!TO->InFight()) {

    call_out("postenmove_rued1", 1);
  }

  if(TO->InFight()) {  


    TELLENV("Klettere mir nach auf den Wachturm! Dort hacken wir Dich klein!",
        "Der Torposten sagt: ");

    call_out("postenmove_rued1", 1);
  }               
}               


postenmove_rued1() {

  object posten;
  posten=this_object();

  tell_room("/d/dschungel/trintrasil/sdschungel/room/turm", 
      "\nDer Torposten klettert herauf!\n\n");
  tell_room(environment(TO),
      "\nDer Torposten klettert fluchend auf den Wachturm!\n");      
  posten->move("/d/dschungel/trintrasil/sdschungel/room/turm", M_GO+ M_SILENT);
  call_out("postenmove_rued2", 1);
}


postenmove_rued3() {

  if(present("ruediger", environment(TO))) {  	
    return 0;}

  if(!present("ruediger", environment(TO))) {       

    call_other("/d/dschungel/trintrasil/sdschungel/master",
        "ruediger2");//der posten ist nun ruediger schon zu hilfe geeilt
  }//ist der wachtmeister tatsaechlich schon tot 8) *hahaha* ruft dieser posten
}    //die restlichen wachen zur hilfe (ruediger2 im master)

//oooooooooooooooooooooo POSTENMOVE WERN oooooooooooooooooooooooooooooooooooooooo

postenmove_wern() {

  if(TO->InFight()) {
    TELLENV("Verfolge mich doch zur Bruecke! Dort hacken wir Dich klein!",
        "Der Torposten sagt: ");		
    call_out("postenmove_wern1", 1);
  }

  if(!TO->InFight()) {
    call_out("postenmove_wern1", 1);
  }
}


postenmove_wern1() {

  object posten;
  posten=this_object();

  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke2", 
      "\nDer Torposten eilt herbei!\n\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Torposten eilt an Dir vorbei nach Norden!\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Torposten eilt an Dir vorbei nach Norden!\n");
  tell_room(environment(TO),
      "\nDer Torposten eilt fluchend nach Norden!\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/bruecke2", M_GO+
      M_SILENT);      
  call_out("postenmove_wern2", 3);
}


postenmove_wern2() {

  if(present("ruediger", environment(TO))) {  	
    return 0;}

  if(!present("ruediger", environment(TO))) {//sollte ruediger tatsaechlich schon         

    call_other("/d/dschungel/trintrasil/sdschungel/master",
        "wernfried2");
  }
}


//ooooooooooooooooooooooooooo RESET_FUNC oooooooooooooooooooooooooooooooooooooooo
//diese funktionen bringen die posten nach einem kampf wieder auf ihre 
//ausgangsplaetze

tor_reset() {

  TO->SetProp("infight", 0);
}


turm_reset() {

  if(present("wachtmeister", environment(TO))) {
    TELLENV("Jawohl Herr Wachtmeister!","Der Torposten sagt: ");
    call_out("turm_reset1", 1);
  }

  if(!present("wachtmeister", environment(TO))) {
    TELLENV("Na los!","Der Torposten sagt: ");
    call_out("turm_reset1", 1);
  }
}


turm_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "\nDer Torposten klettert nach unten.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "Der Torposten klettert vom Turm herab.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", M_GO+ 
      M_SILENT);
  this_object()->SetProp("infight", 0);
}


bruecke_reset() {

  if(present("wachtmeister", environment(TO))) {
    TELLENV("Jawohl Herr Wachtmeister!","Der Torposten sagt: ");
    call_out("bruecke_reset1", 1);
  }
  if(!present("wachtmeister", environment(TO))) {
    TELLENV("Na los!","Der Torposten sagt: ");
    call_out("bruecke_reset1", 1);
  }
}


bruecke_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "Der Torposten geht nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Torposten geht an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Torposten geht an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Torposten kommt an und nimmt seinen Posten wieder ein.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", M_GO+ 
      M_SILENT);
  this_object()->SetProp("infight", 0);
}                         



void NotifyPlayerDeath(object player, object killer, int lostexp) {

  MASTER->remove_enemy(player);
}



int Defend(int dam, mixed dam_type, mixed spell, object enemy) {

  MASTER->ruf_um_hilfe(enemy);

  MASTER->support();
  return ::Defend(dam, dam_type, spell, enemy);
}



remove(int arg) {

  MASTER->remove_mann(this_object());
  ::remove(arg);
}

