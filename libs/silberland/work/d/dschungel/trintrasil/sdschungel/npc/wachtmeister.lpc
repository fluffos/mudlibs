
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#define MASTER "/d/dschungel/trintrasil/sdschungel/master"


fightstatus() {

  TO->SetProp("infight", 1);
}



init()  {
  ::init();
  if(interactive(TP)) { call_out("sers", 1); 
  }
}


int sers()  {

  if(environment(TO)!=environment(TP))  {
    return 1;
  }


  if(TO->QueryProp("infight")) {

    if( IsEnemy(this_player()) ) {

      if( TP->QueryProp(P_GENDER)!=FEMALE ) {

        switch(random(3)) {

          case 1: TELLENV("HA! DA IST JA DIESER HALUNKE!!!",
                      "Der Wachtmeister bruellt: ");
                  break;
          case 2: TELLENV("LASS DIE WAFFEN FALLEN DU REBELL!!!",
                      "Der Wachtmeister bruellt: ");
                  break;
          case 0: TELLENV("ERGIB DICH DU LANDESVERRAETER!!",
                      "Der Wachtmeister bruellt: ");
                  break;
        }
      }

      if( TP->QueryProp(P_GENDER)==FEMALE ) {

        switch(random(3)) {

          case 1: TELLENV("HA! DA IST JA DIESE FURIE!!!",
                      "Der Wachtmeister bruellt: ");
                  break;
          case 2: TELLENV("WAFFEN FALLEN LASSEN DU ANARCHISTIN!!!",
                      "Der Wachtmeister bruellt: ");
                  break;
          case 0: TELLENV("ERGIB DICH DU VERRAETERIN!!!",
                      "Der Wachtmeister bruellt: ");
                  break;
        }
      }        
    }
    return 0;
  }


  if( !IsEnemy(this_player()) ) {

    if(!TO->QueryProp("infigth")) {

      if(environment(TO)==environment(TP)) { 		

        switch(random(4)) {

          case 1 :  SD1(turm)

                    tell_room(environment(TO),
                        (BSA(
                             "Runter da "+TPN+"! Der Turm dient militaerischen "
                             "Zwecken!","Der Wachtmeister bruellt: ")));
                    break;	

          case 2 : SD1(turm)

                   tell_room(environment(TO),
                       (BSA(
                            "HALT "+TPN+"! Das ist ein militaerischer Posten! "
                            "Sie  haben hier nichts verloren!",
                            "Der Wachtmeister bruellt: ")));
                   break;

          case 3 : SD1(turm)

                   tell_room(environment(TO),
                       (BSA(
                            "HALT "+TPN+"! Zivilisten haben hier keinen "
                            "Zutritt!","Der Wachtmeister bruellt: ")));
                   break;

          case 0 : SD1(turm)

                   tell_room(environment(TO),
                       (BSA(
                            "HALT "+TPN+"! Sie betreten militaerisches "
                            "Sperrgebiet!","Der Wachtmeister bruellt: ")));
                   break;  
                   return 1;
        }
        return 1;
      }
      return 1;
    }
    return 1;
  }
  return 0;
}



void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ruediger, der Wachtmeister");
  SetProp(P_LONG, BS(
        "Der Wachtmeister haelt nach Gefahren jenseits der Palisade Ausschau. "
        "Er beaeugt Dich misstrauisch und scheint ueber Deinen Aufenthalt in "
        "seinem Turm nicht besonders erfreut."));
  SetProp(P_NAME, "Wachtmeister");
  SetProp(P_GENDER, MALE);

  AddId(({"waechter", "gardist", "wachtmeister", "wache", "wachposten", 
        "posten", "ruediger", "NOWIMPY"}));

  create_default_npc(34);
  
  SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
  
  SetProp(P_BODY, 120);
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HP, 1400);
  SetProp(P_SIZE, 178+random(13));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " sinkt toedlich getroffen zu Boden.\n");

  AddInfo(DEFAULT_INFO, ({
        "sagt: Ich bin nicht befugt Sie ueber militaerische Belange zu informieren.\n",
        "sagt: Ich bin nicht dazu da ihre Fragen zu beantworten.\n",
        "sagt: Ich habe hier andere Pflichten.\n",
        "sagt: Ich muss sie bitten den Turm zu verlassen.\n",
        "sagt: Wenn sie Fragen haben wenden sie sich doch an meinen Kollegen am Tor.\n",
        "sagt: Vielleicht gibt ihnen da das Gouvernement Auskunft.\n",
        "sagt: Gehen sie besser zurueck nach Tijara.\n",
        "sagt: Tut mir leid aber ich bin hier beschaeftigt.\n",
        "sagt: Fragen sie doch in Tijara nach. Sie sind hier in einem militaerischen "
        "Posten!\n",
        "sagt: Sehe ich aus wie ein Auskunftsbureau?\n"}));

  AddInfo(({"pfeilschaft","schaft","abgebrochener pfeil","pfeil"}),
      "Der Pfeil steckt hier noch von einem Scharmuetzel das wir hier kuerzlich "
      "mit Kannibalen hatten.","sagt: ");

  AddInfo(({"scharmuetzel","kannibalen"}),
      "Wir konnten sie hier an der Palisade, Dusty sei gepriesen, "
      "aufhalten.","sagt: ");

  AddInfo(("dusty"),
      "Sie versehen sicher das ich hier jetzt wichtigere Dinge zu tun "
      "habe.","sagt: ");

  AddInfo(({"palisaden","palisade"}),
      "Sehen Sie hier noch mehr Palisaden als diese eine hier?");

  AddInfo(({"schloss","schluessel"}),
      "Das Palisadentor bleibt bis auf weiteres geschlossen.","sagt: ");

  AddInfo(({"tor","palisadentor"}),
      "Tut mir leid, aber ich habe Befehl das Tor unter allen Umstaenden "
      "geschlossen zu halten.","sagt: ");

  AddInfo(({"umstand","umstaende","faelle"}),
      "Es gibt keine Umstaende unter denen ich das Tor oeffnen wuerde!", "sagt: ");

  AddInfo(("befehl"),
      "Strenger Befehl vom Gouverneur!", "sagt: ");

  AddInfo(("gouverneur"),
      "Was soll die Frage? Der oberste Verwalter natuerlich!", "sagt: ");

  AddInfo(({"frage","fragen","verwalter"}),
      "Ich habe das dumme Zivilistengequatsche jetzt satt! Stoeren Sie mich nicht "
      "laenger!", "sagt: ");

  AddInfo(({"gequatsche","zivilistengeqautsche"}),
      "Husch, Husch! Runter da bevor ich bestimmter werden muss!", "knurrt: ");

  AddInfo(({"turm","wachturm","hochsitz","aussichtsturm"}),
      "Der Turm dient militaerischen Zwecken. Sie haben hier oben nichts "
      "verloren!", "sagt: ");

  AddInfo(({"zweck","zwecke","militaerischer zweck","militaerische zwecke"}),
      "Der Turm dient natuerlich der Ueberwachung!", "sagt: ");

  AddInfo(({"ueberwachung"}),
      "Ich bin nicht befungt Sie in militaerische Geheimnisse einzuweihen. Aber "
      "Sie sollten in naechster Zeit lieber in Tijara bleiben. Das ist fuer "
      "Zivilisten einfach sicherer.","sagt: ");

  AddInfo(({"geheimnis","militaerische geheimnisse","geheimnisse",
        "militaerisches geheimnis"}),
      "Die Definition eines Geheimnisses impliziert, dass es nicht verraten "
      "werden soll.","sagt: ");

  AddInfo(({"begriffsbestimmung","definition"}),
      "Eine Definition ist eine Begriffsbestimmung. Erste Klasse Philosophie "
      "auf der Gardeakademie.","sagt: ");

  AddInfo(({"klasse","akademie","gardeakademie"}),
      "Tja, mancher ist gebildet, mancher weniger.","sagt: ");

  AddInfo(("philosophie"),
      "Philosophie ist das Hauptfach auf der Gardeakademie.","sagt: ");

  AddInfo(({"zeit","zivilisten"}),
      "Wenn es schlimm kommt werden hier bald Soldaten gebraucht. Da sind "
      "verweichlichte Zivilisten am besten in der Stadt aufgehoben.","sagt: ");

  AddInfo(("soldaten"),
      "Tut mir leid, aber wenn sie dringende Fragen haben wenden Sie sich "
      "bitte an das Gouvernement.","sagt: ");

  AddInfo(("gouvernement"),
      "Gleich am Hauptplatz links.","sagt: ");

  AddInfo(({"platz","hauptplatz","tijara","stadt"}),
      "Ich hoffe doch sehr das Sie wissen wo Tijara ist.","sagt: ");



  SetProp(P_SPELLRATE, 50);

  AddSpell(10, 170+random(80),
      "\nDer Wachtmeister durchbricht Deine Deckung.\n\n",
      "\nDer Wachtmeister durchbricht @WESSEN Deckung.\n\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(10, 180+random(80),
      "\nDer Wachtmeister rammt Dir den Saebel in den Bauch.\n\n",
      "\nDer Wachtmeister rammt @WEM den Saebel in den Bauch.\n\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(10,190+random(80),
      "\nDer Wachtmeister schlaegt eine Serie von Hieben.\n\n",
      "\nDer Wachtmeister schlaegt eine Serie von Hieben.\n\n",
      DT_SLASH, ([SP_SHOW_DAMAGE:1]));

  AddSpell(10, 200+random(80),
      "\nDer Wachtmeister schlaegt Dir mit dem Saebel auf den Kopf.\n\n",
      "\nDer Wachtmeister schlaegt @WEM mit dem Saebel auf den Kopf.\n\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(6, 400+random(100),
      "\nDer Wachtmeister schlaegt Dir eine klaffende Wunde.\n\n",
      "\nDer Wachtmeister schlaegt @WEM eine klaffende Wunde.\n\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 600+random(200),
      "\nDer Wachtmeister schlaegt Dir mit der Klinge tief in den Hals.\n\n",
      "\nDer Wachtmeister schlaegt @WEM mit der Klinge tief in den Hals.\n\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]));


  SUID;
  CLONEME("/d/dschungel/trintrasil/sdschungel/obj/weapon/dsaebel");
  command("zuecke saebel");

  CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/dschungelhelm");
  CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/stiefel");  
  CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/lederp");
  command("trage alles");

  MASTER->add_mann();
} 


//oooooooooooooooooooooooooo POSTENMOVE RUED oooooooooooooooooooooooooooooooooooo

postenmove_rued() {

  call_out("postenmove_rued1", 1);
}

postenmove_rued1() {

  call_other("/d/dschungel/trintrasil/sdschungel/master", "ruediger2");
}



//oooooooooooooooooooooooooo POSTENMOVE HERM oooooooooooooooooooooooooooooooooooo

postenmove_herm() {

  if(TO->InFight()) {
    TELLENV("Na warte komm mir nach zu meinen Kameraden! Dann hacken wir Dich in "
        "Stuecke!","Der Wachtmeister sagt: ");
    call_out("postenmove_herm1", 1);
  }

  if(!TO->InFight()) {	//Falls die posten an mehreren Stellen "gleichzeitig" 
    call_out("postenmove_herm1", 1);//angegriffen werden kommen alle dem ersten
  }                              //angegriffenen zu hilfe
}


postenmove_herm1() {

  object posten;
  posten=this_object();

  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", 
      "\nDer Wachtmeister klettert fluchend vom Turm "
      "herunter!!!\n\n");
  tell_room(environment(TO),
      "\nDer Wachtmeister klettert fluchend nach unten!\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", M_GO+ M_NO_SHOW+ 
      M_SILENT);      
  call_other("/d/dschungel/trintrasil/sdschungel/master",
      "hermann2");
}


//oooooooooooooooooooooo POSTENMOVE WERN oooooooooooooooooooooooooooooooooooooooo

postenmove_wern() {

  if(TO->InFight()) {
    TELLENV("Na warte, komm mir nach zu meinen Kameraden! Dann hacken wir Dich "
        "in Stuecke!","Der Wachtmeister sagt: ");
    call_out("postenmove_wern1", 3);
  }

  if(!TO->InFight()) {	
    call_out("postenmove_wern1", 3);
  }                              
}


postenmove_wern1() {

  object posten;
  posten=this_object();

  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke2", 
      "\nDer Wachtmeister eilt herbei!\n\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Wachtmeister klettert aus dem Wachturm und eilt an "
      "Dir vorbei Norden!\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Wachtmeister eilt an Dir vorbei nach Norden!\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Wachtmeister eilt an Dir vorbei nach Norden!\n");
  tell_room(environment(TO),
      "\nDer Wachtmeister klettert fluchend nach unten!\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/bruecke2", M_GO+ 
      M_SILENT);      
  call_other("/d/dschungel/trintrasil/sdschungel/master",
      "wernfried2");
}


//oooooooooooooooooooooooo RESET_FUNKTIONEN ooooooooooooooooooooooooooooooooooooo

turm_reset() {
  TO->SetProp("infight", 0);
}


tor_reset() {
  call_out("tor_reset1", 2);
}


tor_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "\nDer Wachtmeister klettert auf den Turm.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
      "\nDer Wachtmeister klettert herauf.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/turm", M_GO+ 
      M_SILENT);
  TO->SetProp("infight", 0);
}          


bruecke_reset() {
  call_out("bruecke_reset1", 6);
}

bruecke_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "\nDer Wachtmeister geht nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Wachtmeister geht an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Wachtmeister geht an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Wachtmeister kommt an und klettert auf den Turm.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
      "\nDer Wachtmeister klettert herauf.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/turm", M_GO+ 
      M_SILENT);
  TO->SetProp("infight", 0);
}           



int Defend(int dam, mixed dam_type, mixed spell, object enemy) {

  MASTER->ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);

  MASTER->support();
}



remove(int arg) {

  MASTER->remove_mann(this_object());
  ::remove(arg);
}


