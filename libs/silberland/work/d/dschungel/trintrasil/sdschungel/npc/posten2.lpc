inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#define MASTER "/d/dschungel/trintrasil/sdschungel/master"


fightstatus() {

  TO->SetProp("infight", 1);
}



init()  {
  ::init();
  if(interactive(TP)) { 
    call_out("postengruss", 1); }  	
}


int postengruss() {


  if(TO->QueryProp("infight")) {
    return 1;}


  if( environment(TO) != environment(TP) )
  { return 1;  }


  if(!TO->QueryProp("infigth")) {

    if( TP->QueryProp(P_GENDER)!=FEMALE )    {	

      tell_room(environment(TO),
          "\nDer Brueckenposten lallt: Begruesse der Herr!\n");

      return 1;}

      if( TP->QueryProp(P_GENDER)==FEMALE )      {

        switch(random(5)) {

          case 1 : SD1(bruecke2)

                   tell_room(environment(TO),
                       BS("Der Brueckenposten lallt: Hallo Gnae' Frau!"));
                   break;

          case 2 :  SD1(bruecke2)
                    tell_room(environment(TO),
                        BS("Der Brueckenposten lallt: Na schoene Frau, trinkens nen "
                          "Schluckerl mit?"));
                    break;
          case 3 :   SD1(bruecke2)
                     tell_room(environment(TO),
                         BS("Der Brueckenposten lallt: Na die Dame, keine Angst vorn nem "
                           "Monster oder so?"));
                     break;
          case 4 :   SD1(bruecke2)
                     tell_room(environment(TO),
                         BS("Der Brueckenposten lallt: Holla! Schoener Vorbau!"));
                     break;
          case 0 :
                     SD1(bruecke2)
                       tell_room(environment(TO),
                           BS("Der Brueckenposten lallt: Holla! Sind se die Abloesung?"));
                     break;

          default:	SD1(bruecke2)
                        tell_room(environment(TO),
                            BS("Der Brueckenposten lallt: Schoenen Tag die Dame!"));

                        return 1;}
                        return 0;}

      else  {
        write(BSA(
              "HE! Du Transsexueller!",
              "Der Brueckenposten lallt: "));
        return 1;  }

        return 0;}
        return 0;}



        void create() {


          if (!is_clone(TO)) return;
          ::create();

          SetProp(P_SHORT, "Wernfried, der besoffene Brueckenposten");
          SetProp(P_LONG, BS(
                "Wernfried ist sicher hierher zum Grenzdienst strafversetzt worden. "
                "Er sieht total heruntergekommen aus und sieht Dich aus geschwollenen, "
                "roten Augen an. Sein dicker Bierbauch haengt ihm aus der dreckigen "
                "Uniform. Bei der Tijara Stadttruppe muss ja eine schoene Disziplin "
                "herrschen."));   

          SetProp(P_NAME, "Brueckenposten");
          SetProp(P_GENDER, MALE);
          AddId(({"waechter","wachtposten","wache","wachposten","posten","gardist",
                "wernfried","wernzi","brueckenposten","NOWIMPY"}));

          enable_commands();
          set_living_name("wernfried");
          create_default_npc(19);
          
          SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
          
          SetProp(P_BODY, 50);
          SetProp(P_RACE, "Mensch");
          SetProp(P_SIZE, 178);
          SetProp(P_ALIGN, 0+random(30));
          SetProp(P_MAX_HANDS, 2);
          SetProp(P_HEAL,0);
          SetProp(P_AGGRESSIVE,0);
          SetProp(P_WIMPY, 0);
          SetProp(P_DIE_MSG, " sinkt lallend und ruelpsend zu Boden.\n");

          AD(({"bauch","bierbauch"}),
              "Mein Gott, der Bauch ist ziemlich aufgequollen. Mitten im Wald der "
              "Bauchhaare siehst Du eine Taetowierung.");

          AD(("taetowierung"),
              "       __      __       \n"
              "     /   \\   /   \\    \n"
              "    |     \\_/    |    \n"
              "    \\            /    \n"
              "     \\  MARIA   /      \n"
              "      \\        /        \n"
              "        \\    /         \n"
              "         \\  /          \n"
              "                         \n"
            );

          AD(({"wald","haare","bauchhaare"}),
              "Wenn der Brueckenposten die Natur liebt ist er hier im Dschungel genau "
              "richtig.");

          AD(({"kinder","gott"}),
              "Gott liebt alle seine Kinder, auch den Brueckenposten Wernzi.");

          AD(("uniform"),
              "Wenn das ein Vorgesetzter sehen wuerde, wuerde der Brueckenposten "
              "wahrscheinlich zum Latrinendienst abkommandiert werden.");

          AD(({"dienst","strafdienst"}),
              "Welchen Dienst meinst Du, Latrinendienst oder Grenzdienst.");

          AD(({"latrinendienst"}),
              "Der Latrinendienst ist noch unbeliebter als der Grenzdienst hier.");

          AD(({"disziplin","grenzdienst","vorgesetzter"}),
              "Kein Wunder das der Posten hier quasi staendig Strafdienst hat.");

          AD(("augen"),
              "Anscheinend ist der Arme wegen Dante wieder mal nicht ins Bett gekommen.");


          AddInfo(DEFAULT_INFO, ({
                "zuckt desinteressiert mit den Schultern.\n",
                "lallt: Jo eh.\n",
                "lallt: Ich hab sicher gleich Schichtende.\n",
                "lallt: Keine Ahnung.\n",
                "lallt: Vielleicht lallt ihnen in Tijara jemand bescheid.\n",
                "lallt: Natuerlich haett ich auch gern was anstaendiges gelernt!\n",
                "ruelpst: BOEARPS!! Tschuldigung.\n"}));


          AddInfo(({"pissnelke","dante"}),
              "Ich schwoere bei seiner Mutter, mit seinem Waffenhandel habe ich nichts zu "
              "tun!","kreischt: ");

          AddInfo(({"gogogirl","maria"}),
              "Ich hasse zwar ihre Kinderkassetten, aber ich kann froh sein das mir "
              "ueberhaupt jemand meine Uniform buegelt.","knirscht: ");

          AddInfo(({"paradegrazer","groulx"}),
              "Pah, der Donaupisseschwimmer ist doch einfach nur peinlich.","sagt: ");

          AddInfo(({"trintrasil","trint"}),
              "Der Sack haette mich unlaengst mit seinem Puch-Maxi Streitwagen beinahe "
              "ueberfahren!","sagt: ");

          AddInfo(("polen"),
              "Angeblich existiert das gelobte Land auf einer schoenen, anderen "
              "Welt","schwaermt: ");

          AddInfo(({"chemie","alchemie","alchemist","chemiker"}),
              "Methylen- und Methylgruppen, die einer Carbonylgruppe benachbart sind, "
              "lassen sich mit Selendioxid selektiv in Carbonylgruppen ueberfuehren. "
              "Wahrscheinlich wird dabei das Enol von der selenigen Saeure oxidiert. "
              "Dabei scheidet sich elementares Selen ab. Symmetrische 1,2-Diole werden "
              "durch reduktive Dimerisierung von Ketonen und Aldehyden gebildet. Dabei "
              "wird ein Keton/Aldehyd mit einem elektropositivem Metall (Natrium, "
              "Magnesium) in einem aprotischen Loesungsmittel behandelt...", "brabbelt: ");


          SetChats(4, ({
                "Der Brueckenposten lallt: Was sagst Du zu meiner modularen Hellebarde?\n",
                "Der Brueckenposten bietet Dir eine Strasse Pfeffer an.\n",
                "Der Brueckenposten sinniert: Ein gutes Gulasch MUSS mindestens 18\n"
                " Stunden kochen.\n",
                "Der Brueckenposten fluestert: Ich rate Dir, schuette ja nie etwas in "
                "Dantes \nBier.\n",
                "Der Brueckenposten bruellt: AUF ALLE MEINE FREUNDEE!!\n",
                "Der Brueckenposten lallt: Knie nieder und ... um Verzeihung!\n",
                "Der Brueckenposten jammert: Ich waer so gern Alchemist geworden!\n",
                "Der Brueckenposten lallt: Nen kalter Ramazotti waer mal was.\n",
                "Der Brueckenposten singt erbaermlich.\n",
                "Der Brueckenposten versucht seinen Helm wie eine Rappermuetze aufzusetzen.\n",
                "Der Brueckenposten lallt: Ich sags Dir. Mit Kernels kenn ich mich aus!\n",
                "Der Brueckenposten zappelt beaengstigend. Achso, er versucht zu tanzen!\n",
                "Der Brueckenposten lallt: Ich dachte ich waer bei der Feuerwehr als ich "
                "zur \nStadtwache ging.\n"}));


          SUID;
          CLONEME("/d/ebene/lamuerte/burg/obj/bier");
          CLONEME("/p/weapon/spear/hellebarde");
          command("zuecke hellebarde");

          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/dschungelhelm");
          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/stiefel");  
          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/armour/lederp");   
          command("trage alles");

          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/pizza");
          CLONEME("/d/dschungel/trintrasil/sdschungel/obj/pbeutel");

          command("lege pizza in beutel");

          MASTER->add_mann();

        } 


//oooooooooooooooooooooo POSTENMOVE RUED oooooooooooooooooooooooooooooooooooooo

postenmove_rued() {

  call_out("postenmove_rued1", 13);
} 


postenmove_rued1() {

  if(!TO->InFight()) {
    TELLENV("Verdammt, da muss ich wohl mal schaun.",
        "Der Brueckenposten sagt: ");
    call_out("postenmove_rued2", 1);
  }

  if(TO->InFight()) {
    TELLENV("Verfolge mich doch zu meinen Kameraden! Die hacken Dich in kleine "
        "Stuecke!","Der Brueckenposten sagt: ");
    call_out("postenmove_rued2a", 1);
  }
}


postenmove_rued2() {

  object wernf;
  wernf=this_object();	

  tell_room(environment(this_object()),
      "\nDer Brueckenposten schlurft wiederwillig nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
      "\nDer Brueckenposten klettert herauf!\n\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Brueckenposten schlurft an Dir vorbei und klettert "
      "auf den Wachturm.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Brueckenposten schlurft an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Brueckenposten schlurft an Dir vorbei nach Sueden.\n");
  wernf->move("/d/dschungel/trintrasil/sdschungel/room/turm",
      M_TPORT+ M_SILENT);
}


postenmove_rued2a() {

  object wernf;
  wernf=this_object();

  tell_room(environment(this_object()),
      "\nDer Brueckenposten rennt eilig nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/turm",
      "\nDer Brueckenposten klettert herauf!\n\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Brueckenposten rennt an Dir vorbei und klettert "
      "auf den Wachturm.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Brueckenposten rennt an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Brueckenposten rennt an Dir vorbei nach Sueden.\n");
  wernf->move("/d/dschungel/trintrasil/sdschungel/room/turm",
      M_TPORT+ M_SILENT);
}	


//oooooooooooooooooooo POSTENMOVE HERM ooooooooooooooooooooooooooooooooooooooooo

postenmove_herm() {

  call_out("postenmove_herm1", 16);
} 


postenmove_herm1() {

  if(!TO->InFight()) {

    call_out("postenmove_herm2", 2);
  }

  if(TO->InFight()) {

    TELLENV("Verfolge mich doch zu meinen Kameraden! Die hacken Dich in kleine "
        "Stuecke!","Der Brueckenposten sagt: ");	
    call_out("postenmove_herm2a", 2);
  }
}


postenmove_herm2() {

  object wernf;
  wernf=this_object();

  tell_room(environment(this_object()),
      "\nDer Brueckenposten sagt: Verdammt wasn schon wieder los.\n"
      "\nDer Brueckenposten schlurft wiederwillig nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Brueckenposten kommt an!!!\n\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Brueckenposten schlurft an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Brueckenposten schlurft an Dir vorbei nach Sueden.\n");
  wernf->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      M_TPORT+ M_SILENT);	
}

postenmove_herm2a() {

  object wernf;
  wernf=this_object();

  tell_room(environment(this_object()),
      "\nDer Brueckenposten rennt eilig nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Brueckenposten kommt an!!!\n\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Brueckenposten rennt an Dir vorbei nach Sueden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Brueckenposten rennt an Dir vorbei nach Sueden.\n");
  wernf->move("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      M_TPORT+ M_SILENT);
}


//oooooooooooooooooooooooo RESET_FUNCTIONEN ooooooooooooooooooooooooooooooooooooo

bruecke_reset() {
  TO->SetProp("infight", 0);
}


turm_reset() {
  call_out("turm_reset1", 5);
}

turm_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "\nDer Brueckenposten klettert nach unten.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel2",
      "\nDer Brueckenposten klettert vom Turm herab und geht nach Norden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Brueckenposten geht an Dir vorbei nach Norden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Brueckenposten geht an Dir vorbei nach Norden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke2",
      "\nDer Brueckenposten kommt an und nimmt seinen Posten wieder ein.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/bruecke2", M_GO+ 
      M_SILENT);
  TO->SetProp("infight", 0);
}


tor_reset() {
  call_out("tor_reset1", 5);
}

tor_reset1() {

  object posten;
  posten=this_object();

  tell_room(environment(TO), "\nDer Brueckenposten geht nach Norden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke1",
      "\nDer Brueckenposten geht an Dir vorbei nach Norden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/sdschungel1",
      "\nDer Brueckenposten geht an Dir vorbei nach Norden.\n");
  tell_room("/d/dschungel/trintrasil/sdschungel/room/bruecke2",
      "\nDer Brueckenposten kommt an und nimmt seinen Posten wieder ein.\n");
  posten->move("/d/dschungel/trintrasil/sdschungel/room/bruecke2", M_GO+           
      M_SILENT);
  TO->SetProp("infight", 0);
}    



void NotifyPlayerDeath(object player, object killer, int lostexp) {

  MASTER->remove_enemy(player);
}



int Defend(int dam, mixed dam_type, mixed spell, object enemy) {

  MASTER->ruf_um_hilfe(enemy);
  MASTER->support();
  return ::Defend(dam, dam_type, spell, enemy);
}



remove(int arg) {

  MASTER->remove_mann(this_object());
  ::remove(arg);
}


