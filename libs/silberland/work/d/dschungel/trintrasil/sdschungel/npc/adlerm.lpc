
inherit "std/npc";
//nomagic 5 erklaeren
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#include "/d/dschungel/trintrasil/myowndefine.h"


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();



  SetProp(P_SHORT, "Ein Fischadlermaennchen");
  SetProp(P_LONG, BS(
    "Das Fischadlermaennchen ist besonders praechtig. Die Fluegelspannweite "
    "ist gewaltig und der scharfe gekruemmte Schnabel sieht aus als koennte er "
    "gefaehrliche Wunden reissen."));
  SetProp(P_NAME, "Fischadlermaennchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fischadler","adler","maennchen"}));

  create_default_npc(22);
  
  SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
  
  SetProp(P_HANDS, ({" mit seinem scharfen Schnabel", QueryProp(P_HANDS)[1] ,({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_HP, 400);
  SetProp(P_MAX_HP, 400);
  SetProp(P_SIZE, 80);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "schiesst vom Himmel herab");
  SetProp(P_MMSGOUT, "verschwindet in einem Schwarzen Loch");

  SetProp(P_DIE_MSG,  " kreischt zornig auf und fliegt davon.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "KRAAAAAAAAARRKKK!!!!.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Glaubst Du der Fischadler kann irgendetwas damit anfangen ?\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(20,150,
    "Der Fischadler hackt auf Dich ein.\n",
    "Der Fischadler hackt auf @WEN ein.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,500,
    "Der Fischadler peckt Dir beinahe das Auge aus.\n",
    "Der Fischadler peckt @WEM beinahe das Auge aus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(25,130,
     "Der Fischadler kratzt nach Deinem Gesicht.\n",
     "Der Fischadler kratzt nach @WEM Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
   

}

