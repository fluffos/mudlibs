inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Steinechse");
  SetProp(P_LONG,
    "Die kleine gelbe Steinechse blickt dich ausdrucklos und traege mit ihren "
    "schwarz glaenzenden Augen an. Sie geniesst ungeruehrt und traege die "
    "heisse Sonne auf ihrer schuppigen Haut und scheint sich nicht im mindesten "
    "fuer Dich zu interessieren.");
  SetProp(P_NAME, "Steinechse");
  SetProp(P_GENDER, FEMALE);
  AddId(({"steinechse","echse"}));

  create_default_npc(10);
  
  SetProp("flussnpc", 1);//dadurch bekommt npc keinen schatten sollte /trintrasil/fluss/room/strand2 betreten..
  
  SetProp(P_HANDS, ({" mit ihren winzigen Krallen",  QueryProp(P_HANDS)[1] ,(DT_BLUDGEON)}));
  SetProp(P_BODY, QueryProp(P_BODY),10);
  SetProp(P_RACE, "Reptil");
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 15);
  SetProp(P_DIE_MSG, " kruemmt sich sterbend.\n");
  SetProp(P_NOCORPSE, 0),
  SetProp( P_REJECT, ({ REJECT_GIVE,
     "Die Steinechse interessiert sich nicht fuer Dich.\n"}) );

  SetProp (P_MNPC_AREA, "/d/dschungel/trintrasil/sdschungel/room/treppe");
  SetProp (P_MNPC_WAIT, ({random(15), 20, 20}));  
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+ MOV_MOVES+ MOV_BACKWARDS);
   SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/trintrasil/sdschungel/room/treppe1");
  SetProp (P_MMSGIN, "krabbelt herein");
  SetProp (P_MMSGOUT, "krabbelt ueber den Fels davon");
  SetProp (P_MSGIN, "krabbelt herein");
  SetProp (P_MSGOUT, "krabbelt");
  
  AD(({"augen"}),
    "Du kannst nicht erkennen wohin die pupillenlosen Augen blicken. "
    "Sie scheinen nur ausdruckslos schwarz in der Sonne zu glaenzen.");

  AD(({"sonnenlicht","licht","sonne"}), 
    "Die Augen der Echse reflektieren das Sonnenlicht?");
        
  AD(("haut"),
    "Die mattgelbe Haut der Echse ist trocken und schuppig. Sie tarnt die "
    "Echse gut auf steinigem Untergrund.");
    
  AD(({"name","untergrund"}),
    "Daher der Name Steinechse.");
    
    
  AddInfo(DEFAULT_INFO, "Die Steinechse blickt Dich nur stumm an.\n");

 SetChats(4, ({
 	"Die Echse zuengelt schnell mit ihrer Zunge.\n",
 	"Die Echse hebt traege den Kopf.\n",
 	"Die Echse raekelt sich langsam in der Sonne.\n",
 	"Die Echse krabbelt ueber den Fels.\n",
 	"Die Echse frisst blitzschnell einen kleinen Kaefer.\n"}));
}
