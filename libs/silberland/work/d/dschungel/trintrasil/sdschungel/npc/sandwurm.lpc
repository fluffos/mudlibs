inherit "/std/npc";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include <npc.h>
#include <new_skills.h>
#include <ansi.h>


reset() {
  if (!is_clone(this_object())) return;

  if( environment(this_object()) )
    tell_room(environment(this_object()), BS("Mit lautem Knirschen bohrt "
          "sich der Sandwurm wieder in den Sand!"));
  TO->move("d/dschungel/trintrasil/hoehle/room/kontrollraum-h", M_GO+ M_SILENT);
  TO->remove();
}

int s,laenge;
string farbe;
string *rand;
int x;
object w;


create() {


object whaut;


  if (!is_clone(this_object())) return;
  ::create();    


/**rand=({ "armour/sandhose","armour/sandpanzer","armour/sandstiefel","armour/sandhose" });

x=random(sizeof(rand));
SUID;              
w=clone_object("d/wueste/arthoas/erg/"+rand[x]+"");
w->move(TO, M_NOCHECK);
*/

switch(random(4))  {
	
	case 0:
	s=0;
	farbe="sandgelb";
	break;
	
	case 1:
	s=1;
	farbe="steinweiss";
	break;
	
	case 2:
	s=2;
	farbe="staubgrau";
	break;
	
	case 3:
	s=3;
	farbe="rostrot";
	break;
	
	default:
	s=0;
	farbe="sandgelb";
}


laenge=2+s*2;

create_default_npc(35+s*4);

SetProp(P_MURDER_MSG, "!!!!!!!GROOOAAAAAARRRRRR!!!!!!!\n"
      "!!!!!!!GROOOAAAAAARRRRRR!!!!!!!\n");
SetProp(P_KILL_MSG, "!!!!!RUELPS ELENDER VERLIERER!!!!!\n");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

SetProp(P_LONG,BS(
        "Der Sandwurm windet und raekelt sich wuetend im Sand. Er raschelt zornig "
        "mit seinen "+farbe+" schimmernden Schuppen. Gierig starrt er Dich mit seinen "
        "schwarzen Knopfaugen, die knapp ober seinem zaehnestarrenden, geifernden Maul "
        "liegen, an. Dieses Exemplar ist ungefaehr "+laenge+" Meter lang."));

SetProp(P_NAME, "Sandwurm");
SetProp(P_GENDER, MALE);
SetProp(P_SHORT, "Ein "+farbe+"er Sandwurm");
SetProp(P_NAME_ADJ, ""+farbe+"" );
SetProp(P_ARTICLE, 1);
SetProp(P_SIZE, laenge*100);
SetProp(P_WEIGHT, laenge*30000);

AddId(({"wurm","sandwurm",""+farbe+"er sandwurm",""+farbe+"er wurm","NOWIMPY"}));

SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_BLUDGEON: 0.2,DT_FIRE: -0.5, DT_WATER: 0.3, DT_PIERCE:-0.3]));

SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen",350+s*15,({DT_RIP})}));

SetProp(P_MAX_HANDS, 0);

SetProp(P_AGGRESSIVE, 0.1);

SetProp(P_TRANSPARENT, 0);

AD(({"schuppen","schuppe"}),
"Die Schuppen des Sandwurmes sehen stahlhart aus und glaenzen "+farbe+" im "
"Sonnenlicht.");

AD(({"augen","auge"}),
"Die kohlschwarzen Augen sind fuer so einen grossen Wurm laecherlich winzig.");

AD(({"zahn","zaehne",}),
"Sein riesiges Maul ist gespickt mit einem Wald von Zaehnen.");

AD(("wald"),
"Der Wurm besitzt mehrere Reihen ca 20 cm langer Zaehne.");

AD(("reihen"),
"Diese Zaehne haben nur einen Zweck. Komm ihnen besser nicht zu nahe.");

AD(("zweck"),
"Der Wurm wittert angespannt in Deine Richtung. Er hat anscheinend vor Dich "
"zu verschlingen.");

AD(("maul"),
"Das Maul des Wurmes ist eher eine riesige Oeffnung die die gesamte breite des "
"Vorderteiles einnimmt.");

AD(({"vorderseite","oeffnung","teil","vorderteil","kopf"}),
"Der Kopf grenzt sich bei einem Wurm nicht vom Koerper ab. Du weisst nur "
"durch die Augen und das Maul das hier die Vorderseite des Wurmes ist.");

AD(({"exemplar","koerper"}),
"Dieser gewaltige Wurm misst "+laenge+" Meter!");

AD(({"saeure","geifer"}),
"Gelb, und zaeh tropft stinkender Geifer aus dem Maul des Wurmes.");

AD(("atem"),
"Der Atem des Wurmes stinkt beissend nach Saeure.");


SP(P_SPELLRATE, 40+s*4);

  AddSpell(7, 450+s*20,
      "\nDer Sandwurm bekommt Dich zu fassen und schuettelt Dich wie \n"
