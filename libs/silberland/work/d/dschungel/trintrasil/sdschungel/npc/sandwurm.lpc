      "\nDer Sandwurm bekommt @WEN zu fassen und schuettelt @WEN wie \n"
      "eine Ratte.\n\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(7, 350+s*20,
      "\nDer Sandwurm trifft Dich hart mit seinem Schwanz.\n\n",
      "\nDer Sandwurm trifft @WEN hart mit seinem Schwanz.\n\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(7, 400+s*20,
      "\nDer Sandwurm fegt Dich von den Fuessen.\n\n",
      "\nDer Sandwurm fegt @WEN von den Fuessen.\n\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(7, 400+s*20,
      "\nDer Sandwurm schleudert Dich zu Boden.\n\n",
      "\nDer Sandwurm schleudert @WEN zu Boden.\n\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(6, 500+s*20,
      "\nDer Sandwurm reisst Dir beinahe einen Arm aus.\n\n",
      "\nDer Sandwurm reisst @WEM beinahe einen Arm aus.\n\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 1000+s*100,
      "\nDer Sandwurm bekomt Dich zu fassen und beisst Dich beinahe \n"
      "mittendurch!\n\n",
      "\nDer Sandwurm bekommt @WEN zu fassen und beisst @WEN beinahe \n"
      "mittendurch!\n\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(5, 200, 
      "\nDer Sandwurm spritzt Dir Geifer in die Augen!\n\n",
      "\nDer Sandwurm spritzt @WEM Geifer in die Augen!\n\n",
      DT_POISON, "spell_blind");

  AddSpell(10, 1,
      "\nDer Sandwurm peitscht mit seinem langen Schwanz ueber den Strand!\n\n",
      "\nDer Sandwurm peitscht mit seinem langen Schwanz ueber den Strand!\n\n",
      DT_BLUDGEON, "spell_overkill");

  AddSpell(5, 400,  
      "\nDer Sandwurm schleudert Dich hoch in die Luft!\n\n",
      "\nDer Sandwurm schleudert @WEN hoch in die Luft!\n\n",
      DT_BLUDGEON, "spell_journey");

  AddSpell(5, 500,
      "\nDer Sandwurm knallt Dich mit voller Wucht gegen die Felswand!\n\n",
      "\nDer Sandwurm knallt @WEN mit voller Wucht gegen die Felswand!\n\n",
      DT_BLUDGEON, "spell_para");

  AddSpell(4, 300,
      "\nDer Sandwurm beisst Dir in den Arm.\n\n",
      "\nDer Sandwurm beisst @WEM in den Arm.\n\n",
      DT_POISON, "spell_poison");

"obj/pearlmaster"->DistributePearl(1+s*2, 2 ,1, 1);
"obj/gemmaster"->DistributeGem(1+s, 1,1, 1);

/*  whaut=clone_object("/d/dschungel/trintrasil/sdschungel/obj/whaut.lpc")->move(TO);
call_other(present("wurmhaut", TO), "farbesetzen", farbe);
*/
  
  SetChats(15, ({
        "Der Wurm richtet sich bedrohlich auf!\n\n",
        "!!!!!GGGGGGGGSSSSSSSSSSSSSSS!!!!!  Der Wurm faucht Dich an!\n\n",
        "Der Wurm wiegt den Kopf und beaeugt Dich gierig.\n\n",
        "Der Sandwurm oeffnet sein Maul und blaest Dir seinen heissen \n"
        "Atem ins Gesicht.\n\n",
        "Der Wurm schlaengelt sich schnarrend in Deine Richtung.\n\n",
        "Die kleinen Knopfaugen des Wurmes schillern heimtueckisch.\n\n",
        "Der Wurm hebt schnuppernd sein Vorderteil.\n\n",
        "Der Wurm saugt schnaufend Luft ein.\n\n",
        "Fauliger Verwesungsgeruch umgibt den Wurm.\n\n",
        "Du kannst direkt in den zuckenden feuchten Schlund des Wurmes \n"
        "sehen.\n\n",
        "Du solltest verschwinden solange Du noch kannst!\n\n",
        "Dem Sandwurm tropft gelber Geifer aus dem Maul.\n\n",
        "Der Sandwurm oeffnet und schliesst ungeduldig sein Maul.\n\n",
        "Der Wurm entringelt sich zu seiner vollen Groesse.\n\n",
        "Der Sandwurm naehert sich Dir als wollte er Dich verschlingen.\n\n"}));

}	



void spell_blind(object enemy, int damage, mixed dam_type) {

  tell_object(enemy,
      "\nDEINE AUGEN BRENNEN WIE FEUER!\n\n");
  enemy->SetProp(P_BLIND, enemy->QueryProp(P_LEVEL)/2 );
}


void spell_poison(object enemy, int damage, mixed dam_type) {

  tell_object(enemy,
      "\nDEIN GEBISSENER ARM WIRD SELTSAM TAUB!\n\n");
  enemy->AddPoison(1+s);
}


void spell_para(object enemy, int damage, mixed dam_type) {

  tell_object(enemy,
      "\nDu knallst mit dem Kopf gegen den Fels!\n"
      "Dir wird schwarz vor den Augen!\n\n");
  enemy->SetProp(P_PARALYZED, 
      ([PARALYZE_TIME: 3+s,
        PARALYZE_MSG: "Du bist bewusstlos!\n",
        PARALYZE_MSG_OTHER: "",
        PARALYZE_END: "\nStoehnend wachst Du wieder auf.\n",
        PARALYZE_END_OTHER: "\n%s richtet sich benommen wieder auf.\n"]));
}


void spell_overkill(object enemy, int damage, mixed dam_type) {

  int i;
  object *inv;
  inv=filter_array(all_inventory(environment(TO)),#'living) ;  

  tell_room(ENV(this_object()), BS("Der Schwanz des Sandwurmes trifft Dich und "
        "fegt Dich von den Beinen."));

  for(i=sizeof(inv)-1;i>=0;i--) {
    inv[i]->Defend(50+s*10, DT_BLUDGEON, 0, this_object());
  }
}


void spell_journey(object enemy, int damage, mixed dam_type) {

  enemy->move("/d/dschungel/trintrasil/sdschungel/room/luft-h", M_GO+ 
      M_NO_SHOW+ M_SILENT);
}





Defend(int dam, string dtype, mixed spell, object enemy) {

  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (sizeof(dtype & ({ DT_AIR }) )) {

    tell_object(enemy,
        "Der Sandwurm staerkt sich durch Deinen Angriff.\n"
        "Geifer spritzt aus dem Wurm direkt auf Dich zu!!!\n");
    enemy->Defend(50+s*10, DT_AIR, ([SP_SHOW_DAMAGE: 1]));
    tell_room(environment(TO),
        ""+enemy->name()+" wird von Geifer getroffen!\n", ({enemy}));

    heal_self(100);

    return ::Defend(0, dtype, spell, enemy); 
  }
  return ::Defend(dam, dtype, spell, enemy); 
}



_query_wimpy() { return 0;}


void die(int poisondeath) {

write_file("/d/dschungel/trintrasil/log/sandwurm",
ctime()+": "+CAP(getuid(TP))+" killt den Sandwurm.\n");

  domainshout(CAP(TP->query_real_name())+
      " hat den Sandwurm bezwungen!\n");

  ::die(poisondeath);
}




void NotifyPlayerDeath(object player, object killer, int lostexp) {     

write_file("/d/dschungel/trintrasil/log/sandwurm",
ctime()+": Der Sandwurm hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  call_out("get_leiche", 0);
  heal_self(400);
}


get_leiche()  {

  object leiche;
  leiche=present("leiche", environment(TO));

  if(present("leiche", environment(TO))) {

    SD1(strand1)
      tell_room(environment(TO),
          BS(""+ANSI_RED+"Der Sandwurm verschlingt knackend und schmatzend die "
            "Leiche von "+CAP(getuid(TP))+"!"+ANSI_NORMAL+""));  
    leiche->remove("leiche");

  }
}
