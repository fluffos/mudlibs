inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>
//#include "../fluss.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "eine Fledermaus");
  SetProp(P_LONG,
    "Die kleine pelzige Fledermaus flattert verstoert umher. Fuer den "
    "nachtaktiven Insektenjaeger ist es noch viel zu frueh.");
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  
  SetProp("flussnpc", 1);
  
  AddId(({"fledermaus"}));

  create_default_npc(6);
  SetProp(P_HANDS, ({" mit Ultraschall", 60+random(60) ,({DT_SOUND})}));
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Mausus Fliegus");
  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 15);
  SetProp(P_DIE_MSG, " stuerzt flatternd ab.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Die Fledermaus ist an Deinem Konsumkapitalistenzeugs nicht interessiert."}) );
     
  SetProp (P_MNPC_AREA "hoehle");
  SetProp (P_MNPC_WAIT, ({ 5+random(10), 10+random(20),
                           15+random(20) }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/hoehle3.lpc");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
  SetProp (P_MSGIN, "flattert herein");
  SetProp (P_MSGOUT, "flattert");
  SetProp (P_MMSGIN, "flattert verstoert auf");
  SetProp (P_MMSGOUT, "flattert");
  
  AD(({"insekt","insekten","insektenjaeger","jaeger"}),
    "Du kannst zwar auch laestig wie ein Insekt sein, musst Dich aber vor der "
    "Fledermaus nicht fuerchten.");
    
  AD(("nacht"),
    "Tja gibt es sicher, wenn auch sehr selten.");
         
  AddInfo(DEFAULT_INFO, "Die Fledermaus flattert verstoert.\n");
}
