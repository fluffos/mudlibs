
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine braune Teichmuschel");
  SetProp(P_LONG, BS(
    "Die braune Teichmuschel ist sehr gross und hat eine scharfe Schale."));
  SetProp(P_NAME, "Teichmuschel");
  SetProp(P_GENDER,FEMALE);
  
  SetProp("flussnpc", 1);
  
  AddId(({"muschel","teichmuschel","braune teichmuschel"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren scharfen Schalen", 5+random(20) ,({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Arschloch");
  SetProp(P_HP, 10);
  SetProp(P_MAX_HP, 10);
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,25);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "laesst den Stock los");
  SetProp(P_MSGOUT, "gackert");
  SetProp(P_MMSGIN, "laesst den Stock los");
  SetProp(P_MMSGOUT, "verschwindet in einem Schwarzen Loch");

  SetProp(P_DIE_MSG,  " oeffnet sich sterbend.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "Die Muschel klappert mit ihren Schalen.\n");
  AddInfo("dante", "Dante handelt mit Waffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Die Teichmuschel schluckt Deinen Gegenstand und ruelpst "
    "unanstaendig.\n" }) );

}

