inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

int infight = 0;
int attacks = 1;

die() {
  call_other("/d/dschungel/trintrasil/hoehle/room/hoehle4", "behemots_die_func");
  ::die();
}


void create()
{
 //bs bei rejectmessage... 
 //Ziegenkeulenfreude... 
 //sound umsetzen in hoehle4
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Behemots");
  SetProp(P_LONG,
    "Der Behemots ist ca 2,5 Meter gross und scharrt mit seinen riesigen Klauen. Er fletscht "
    "Dir seine dreifachen spitzen Zahnreihen entgegen. Seine Eckzaehne sind beinahe so "
    "lang wie Dein Unterarm. Seine kleinen Knopfaugen brennen rot und sind von einer "
    "bestialischen Wut erfuellt. Sein gedrungener, muskuloeser Koerper ist ganz mit einem "
    "weissen Fell bedeckt und scheint vor Zorn zu beben.");
    
  SetProp(P_NAME, "Behemots");
  SetProp(P_GENDER, MALE);
  
  SetProp("flussnpc", 1);
  
  AddId(({"behemots","bestie","NOWIMPY"}));

  create_default_npc(40);
  
  SetProp(P_ATTRIBUTES, ([A_STR: 70]));

  SetProp(P_MAX_HP, 3000);
  
  SetProp(P_HANDS, ({" zornig bruellend an", 
                     400 ,({DT_RIP,DT_PIERCE})}));
                       
  SetProp(P_RACE, "motherfucker");//hahaha was war ich doch vor ein paar jahren fuer ein scherzbold :)
  SetProp(P_SIZE, 2000);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -5);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " bruellt noch einmal zornig auf.\n");
  SetProp(P_NOCORPSE, 0),
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
     "Der Behemots reisst Dir deinen Gegenstand aus der Hand und zerfetzt ihn."}));
  
  SetProp (P_MMSGIN, "stapft bruellend");
  SetProp (P_MMSGOUT, "stapft bruellend");
  SetProp (P_MSGIN, "stapft bruellend");
  SetProp (P_MSGOUT, "stapft bruellend");
  
  AD(({"klauen"}),
    "Die Klauen sind grotesk riesig und der Behemots scharrt mit ihnen ungeduldig im Boden.");
  
  AD(("meter"),
    "Obwohl der Behemots geduckt ind sprungbereiter Haltung kauert ist er ca 2,5 Meter gross.");
    
  AD(("haltung"),
    "Der Behemots kauert in angriffsbereiter Haltung und stiert Dich an.");
     
  AD(({"unterarm","arm"}),
    "Der Behemots bruellt und zeigt Dir seine furchterregenden Eckzaehne.");
    
  AD(("atem"),
    "Der dampfende Atem des Behemots stinkt nach verfaultem Fleisch.");
    
  AD(("fleisch"),
    "Dass der Behemots ein Raubtier ist hast Du Dir auch so schon gedacht.");
    
  AD(({"zahnreihen","zaehne","zahnreihe","reihe","reihen","zahn"}),
    "Die Zaehne sehen aus wie lange spitze Nadeln. Der Behemots fletscht sie knurrend und "
    "Du siehst von Ihnen dampfenden Geifer tropfen.");
  
  AD(("geifer"),
    "Durchsichtiger, heisser Geifer tropft dem Behemots aus dem Maul.");
    
  AD(({"eckzaehne","eckzahn"}),
    "Die Eckzaehne des Behemots sind lang und dicker als die restlichen Zaehne. Ein Eckzahn "
    "hat eine Scharte.");
    
  AD(("scharte"),
    "Da hat der Behemots wohl eine besonders harte Ruestung geknackt.");
    
  AD(({"nadel","nadeln"}),
    "Die Zaehne sind verhaeltnissmaessig duenn, aber sehr lang und spitz. Sie sehen trotzdem "
    "hart genug aus um muehelos durch eine Ruestung zu beissen.");
    
  AD(("ruestung"),
    "Wenn Du noch lange hier herumstehst wirst Du es ohnehin heraus finden, denn der "
    "Behemots greift Dich sicher an.");
      
  AD(({"wasser","geifer"}),
    "Dem Behemots rinnt wohl schon das Wasser im Maul zusammen.");
    
  AD(({"schlund","maul"}),
    "Der Schlund leuchtet blutrot hinter den drei Zahnreihen.");
    
  AD(({"knopfaugen","augen","auge","knopfauge"}),
    "Mit den kleinen Augen sieht der Behemots vielleicht nicht so gut, aber er riecht dafuer "
    "umso besser. Die Augen scheinen von einer unnatuerlichen Wut erfuellt.");
  
  AD(("wut"),
    "Der Behemots scheint vor Zorn zu beben und alles um ihn herum zerstoeren zu wollen.");
    
  AD(("zorn"),
    "Dieser Zorn ist auch fuer wilde Raubtiere sehr ungewoehnlich. Der Behemots knurrt Dich "
    "tief und hasserfuellt an.");
      
  AD(({"raubtier","raubtiere","tier","tiere"}),
    "Das hassverzerrte Fellgesicht des Behemots hat auf bizarre Weise beinahe etwas "
    "menschliches.");
    
  AD(("weise"),
    "Oder bildest Du Dir das nur ein. Der Behemots stiert Dich nur mordlustig an.");
  
  AD(({"gesicht","fellgesicht"}),
    "Wie auch der restliche Koerper ist das Gesicht des Behemots mit weissen Haaren bedeckt.");
    
  AD(({"fell","haare"}),
    "Das reinweisse Fell hat einen silbrigen Schimmer.");
    
  AD(("schimmer"),
    "Der Behemots schuettelt zornig sein langes Fell.");
    
  AD(("koerper"),
    "Der Koerper des Behemots ist sehr muskuloes und gedrungen. Er scheint immer in einer "
    "sprungbereiten Haltung zu kauern.");
      
  AddInfo(DEFAULT_INFO, "Der Behemots schuettelt sich knurrend.\n");

SetChats(15, ({
        BS("Der Behemots stoesst ein spitzes, hohes Heulen aus."),
        BS("Der Behemots richtet sich schnaubend auf."),
        BSS("! ! GRRRRAAAAAAAAAAAAAAAAARRRRRRRRR ! !","Der Behemots bruellt: "),
        BS("Der Behemots schnuppert gierig in Deine Richtung."),
        BS("Der Behemots blaest schnaubend heissen Atem aus."),
        BS("Der Behemots schlaegt knurrend nach Dir!"),
        BS("Der Behemots wuehlt zornig im Boden."),
        BS("Der Behemots stiert Dich hasserfuellt an"),
        BS("Der Behemots richtet sich knurrend auf."),
        BS("Der Behemots knirscht ungeduldig mit den Zaehnen."),
        BSL("! ! ! HUUUUHUUUUUUU WWUUUHHH ! ! !\nDer Behemots heult unheimlich."),
        BS("Die roten Augen des Behemots gluehen vor Wut."),
        BS("Der Behemots bewegt ungeduldig seine Klauen.") }));

SetAttackChats(15, ({
	BSL("\nDer Behemots bruellt in rasender Wut.\n\n"),
	BSL("\nDer Behemots fletscht kreischend seine Zaehne.\n\n"),
	BSL("\nDer Behemots verzerrt hasserfuellt heulend sein Gesicht.\n\n"),
	BSS("! ! ! GRAAAAAAAAARRRRRRRR ! ! !","Der Behemots bruellt zornig: "),
	BSL("\nDer Behemots schnappt wie rasend mit seinen Zaehnen.\n\n") }));
}

Attack(object enemy) {
	
	int damage,damage_type;
	string damage_msg, damage_msg2, wtype;
	mixed res,spell;
	
	res = QueryProp(P_HANDS);
	damage = random( res[1]+1 );
	damage = (2*damage + 10*QueryAttribute(A_STR))/3;
	damage_type = res[2];
	damage_msg = damage_msg2 = res[0];
	wtype=WT_HANDS;
	
	if(!TO->QueryProp("Blutrausch") && infight==1 ) {//behemots kann nur spellen wenn nicht im blutrausch
		
		switch(random(18)) {
			
			case 1..13://es wird mit einer normalen attacke fortgefahren..
			break;
			
			case 14..15://alle living im raum werden verletzt
			
			tell_room(ENV(TO), BSL("\nDer Behemots schlaegt in wilder Raserei um "
			"sich!\n\n"));
			HurtAll();
			return 1;
			break;
			
			case 16://enemy wird aus raum geschleudert
			tell_object(enemy, BSL("\nDer Behemots trifft Dich mit voller Wucht "
			"und Du wirst nach Westen geschleudert!\n\n"));
			say(BSL("\nDer Behemots trifft "+CAP(enemy->name())+" mit voller Wucht "
			"und schleudert Ihn nach Westen!\n\n"), enemy);
			enemy->Defend(600+random(50), DT_BLUDGEON, 0, this_object());
			enemy->move("/d/dschungel/trintrasil/hoehle/room/hoehle4", M_GO + 
			M_SILENT + M_NO_SHOW);
			return 1;
			break;
			
			case 17://behemots bekommt 3 attacken pro kampfrunde
			tell_room(ENV(TO), BSL("\nDer Behemots versetzt sich in einen rasenden "
			"Blutrausch!\n\n"));
			TO->SetProp("Blutrausch", 1);
			attacks=3;
			call_out("attacks_reset", 14+random(5));
			break;
			
			default:
			return 0;
		}
	}
	
	if( infight==0 ) {
			
		tell_object(enemy, BS("Der Behemots springt Dich wuetend bruellend an!"));
		say(BS("Der Behemots springt "+CAP(enemy->name())+" wuetend "
		"bruellend an!"), enemy);
		infight=1;
	}
	
	if(attacks==1) {
		
		enemy->Defend(damage,damage_type,spell,this_object());
	}
	
	if(attacks>1) {
		
		enemy->Defend(damage,damage_type,spell,this_object());
		enemy->Defend(damage,damage_type,spell,this_object());
		enemy->Defend(damage,damage_type,spell,this_object());
	}
}


attacks_reset() {
	
	tell_room(ENV(TO), BSL("\nDer Behemots kommt wieder aus dem Blutrausch!\n\n"));
	TO->SetProp("Blutrausch", 0);
	attacks=1;
}


HurtAll() {
	
	int i;
	object *inv;
	inv=filter_array(all_inventory(environment(TO)),#'living) ;
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i])) {
			
			inv[i]->Defend(360+random(30), DT_BLUDGEON, 0, this_object());
		}
	}
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	//write_file("/d/dschungel/trintrasil/log/monsterkills",
	//ctime()+": Der Behemots hat gerade "+CAP(getuid(player))+" umgebracht.\n");
	say(BSL("\nDer Behemots bruellt begeister waehrend er "
	""+CAP(getuid(player))+" umbringt!\n\n"), player);
	call_out("get_leiche", 1, player);
	heal_self(500);
}


get_leiche(object player)  {
	
	object leiche;
	leiche=present("leiche", environment(TO));
	
	if(present("leiche", environment(TO))) {
		
		tell_room(environment(TO), BSL("\nDer Behemots verschlingt knackend und "
		"schmatzend die Leiche von "+CAP(getuid(player))+"!\n\n"));
		leiche->move(TO, M_NOCHECK);
	}
}