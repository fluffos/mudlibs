inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"fell"}));
   SetProp(P_NAME, "Fell");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT,"Ein Fell");
   SetProp(P_LONG, BS("Das ist ein recht grobes Sitzfell. Das Fell scheint "
                      "von einer Ziege zu stammen."));
   
   AD(({"sitzfell","fell"}),
     "Man breitet dieses Fell auf den Boden und kann darauf sitzen. Es ist "
     "schon etwas abgewetzt.");
   AD(("ziege"),
     "Die Ziege hast Du nicht gekannt und das Abhaeuten hat sie sicher nicht "
     "ueberlebt.");
   AD(({"abhaeuten","abhaeutung"}),
     "Stellst Du Dir im allgemeinen relativ dezent unok vor, Mann.");
   AD(({"mann","alte","belieben"}),
     "Oder Alte, ganz nach Belieben.");

   SetProp(P_MATERIAL,MAT_SKIN);
   SetProp(P_VALUE,80);
   SetProp(P_WEIGHT,20);
}

