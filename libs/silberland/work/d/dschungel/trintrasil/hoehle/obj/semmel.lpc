
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Flussgrundel");
 SetProp(P_LONG, "Die Flussgrundel ist nur ein kleiner Speisefisch und "
 "ausserdem ist der Fisch roh. Aber sie ist besser als nichts wenn Du "
 "Hunger hast.\n");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_VALUE, 50+random(30));
 AddId(({"grundel","flussgrundel","fisch"}));
 SetProp(P_NAME, "Flussgrundel");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);

 SetProp(P_SMELL, "Die Flussgrundel riecht nach Fisch. Du solltest sie essen "
 "bevor sie verdirbt.\n");

 AD(({"speisefisch","speise"}),
   "Die Flussgrundel ist ein kleiner Speisefisch der nicht besonders viel "
   "ausgibt. Dennoch ist sie gut wenn Du Hunger hast.");
   
 AD(("hunger"),
   "Wenn Du sie jetzt nicht essen willst dann heb sie eben auf. Sie wird wohl "
   "noch laenger halten.");
}

