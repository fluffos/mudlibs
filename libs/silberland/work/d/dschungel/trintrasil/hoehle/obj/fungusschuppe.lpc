inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
	
	
create()
{
   if (!is_clone(this_object())) return;
   ::create();
   
   call_out("func_burn", 5+random(10));
   
   AddId(({"fungusschuppe_trint"}));
   SetProp(P_NAME, "Fungusschuppe");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_SHORT, 0);
   SetProp(P_LONG, 0);
   SetProp(P_NOSELL, 1);
   SetProp(P_NODROP, 1);
   SetProp(P_WEIGHT,0);
   
   SetProp(P_MATERIAL,MAT_SKIN);
   
}

AD(("hand"),
"Deine Hand brennt wie Feuer. Halte sie schnell ins Wasser.");

AD(("feuer"),
"Die Fungushaut ist anscheinend giftig! Deine Hand schwillt schon an und ist schon ganz rot! "
"Halte sie schnell ins Wasser!");

ASD(("wasser"),
"wasser");

AD(({"haut","fungushaut"}),
"Du siehst auf Deiner Hand die feinen goldenen Fungusschuppen. Schnell hinunter damit! "
"Die Hand ins Wasser zu halten muesste reichen!");

AD(("feuer"),
"Es wird immer aerger! Wenn Du noch lange herumtroedelst stirbst Du wahrscheinlich an einer "
"Vergiftung.");

AD(("vergiftung"),
"Du hast eine kleine weisse Schaumblase auf den Lippen! Wo kommt die denn her??!);

AD(({"teich","fungusteich","fungustuempel","tuempel"}),
"Du kennst doch den Teich in dem die Fungi aurei wachsen?");

AD(({"hoehle","fungi","fungi aurei","fungus","fungus aureus","pilze"}),
"Die Hoehle mit den leuchtenden Pilzen.");

ASD(({"lippen","blase","schaumblase"}),
"blase");

func_burn() {
	
	object player;
	player=ENV(TO);
	
	if( interactive(ENV(TO)) ) {
		
		write(BSL("\nDu spuerst ein stechendes Brennen auf Deiner mit Fungushaut "
		"bedeckten Hand! Du musst die Hand schleunigst ins Wasser halten!"));
                TP->do_damage(3+random(3));
                call_out("func_burn", 10+random(15));
        }
        if( !interactive(ENV(TO)) ) {
        	TO->remove();
        }
}

wasser() {
	
	object player;
	player=ENV(TO);

	if( ENV(player) && ENV(player)->QueryProp("waschraum") ) {
		
		tell_object(player, BS("Du haeltst Deine brennende Hand in das kuehle Wasser. "
		"Du spuerst die erloesende Kaelte des Teiches und der Schmerz laesst sofort "
		"nach."));
		tell_room(ENV(player), BS(""+CAP(player->name())+" haelt eine Hand mit "
		"schmerzverzerrtem Gesicht in den Teich und atmet erleichtert auf."));
		TO->remove();
	}
	
	if( !ENV(player) ) {
		
		TO->remove();
	}
	
	if( !ENV(player)->QueryProp("waschraum") ) {
		
		tell_object(player, BS("Hier ist nicht der richtige Ort dafuer. Versuche die "
		"Hand im Fungusteich zu waschen."));
	}
}


blase() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Welche Lippen eigentlich? Du spuerst Deine Lippen nicht mehr! "
	"Dir kommt Dein ganzes Gesicht taub vor!"));
	player->AddPoison(1);
	call_out("vergiftung", 2+random(4));
}


vergiftung() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Du hebst verwirrt deine schwer wirkenden Haende und "
	"betastest Dein Gesicht. Aber Du siehst Deine Haende nicht, oder nicht mehr "
	"deutlich!"));
	tell_room(ENV(player, BS(""+CAP(player->name())+" torkelt benommen und betastet "
	"verwirrt sein Gesicht."));
	player->AddPoison(1);
	call_out("vergiftung1", 3+random(3));
}


vergiftung1() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Du siehst eigentlich ueberhaupt nichts mehr. Farben schwimmen "
	"vor Deinen brennenden Augen!"));
	player->AddPoison(2);
	call_out("vergiftung2", 3+random(3));
}


vergiftung2() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Du stoesst an etwas. Oder bist Du etwa hingefallen? Etwas "
	"Nasses, zaehes rinnt Dir aus dem Mund. Es wird wohl Dein blasiger Speichel sein."));
	tell_room(ENV(player), ""+CAP(player->name())+" faellt haltlos um und rappelt sich "
	"nur muehsam wieder auf. Zaeher, schaumiger Speichel rinnt aus dem Mund."));
	player->AddPoison(2);
	call_out("vergiftung3", 3+random(3));
}


vergiftung3() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Du kannst kaum noch atmen. Dein Brustkorb zuckt nur noch "
	"krampfhaft. Aber es scheint Dich garnicht zu stoeren."));
	tell_room(ENV(player), ""+CAP(player->name())+"s Atmung geht stossweise und "
	"krampfhaft."));
	player->AddPoison(2);
	call_out("vergiftung4", 3+random(3));
}


vergiftung4() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Dein Stoehnen klingt hohl und ganz weit weg. Warst das wirklich "
	"Du? Warum stoehnst Du eigentlich? Es ist doch alles still und gut!"));
	tell_room(ENV(player), ""+CAP(player->name())+" stoehnt keuchend."));
	player->AddPoison(2);
	call_out("vergiftung5", 3+random(3));
}

vergiftung5() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Etwas warmes klebriges rinnt von Deinem Kopf. Anscheinend bist "
	"Du wieder gestuerzt und hast Dir den Kopf aufgeschlagen. Du erinnerst Dich muede "
	"das die Haut eines Pilzes Dich anscheinend vergiftet hat."));
	tell_room(ENV(player), ""+CAP(player->name())+" stuerzt und schlaegt schwer mit dem Kopf "
	"auf."));
	player->AddPoison(2);
	call_out("vergiftung6", 3+random(3));
}


vergiftung6() {
	
	object player;
	player=ENV(TO);

	tell_object(player, BS("Wo bist Du eigentlich? Vielleicht sollltest Du doch noch "
	"versuchen Deine Hand ins Wasser zu halten? Aber andererseits ist Deine Hand so "
	"weit weg. Und ausserdem ist es nicht egal? Welche Hand eigentlich?"));
	player->AddPoison(2);
}
