
inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Spitzhacke");
SetProp (P_GENDER, FEMALE);
SetProp (P_VALUE, 50+random(50));
SetProp (P_WEIGHT, 800);
SetProp (P_MAGIC, 0);
SetProp (P_WEAPON_TYPE, WT_CLUB);
SP(P_LONG, BS(
"Diese Art von Spitzhacke wird im Bergbau verwendet. Sie ist an die "
"Koerpergroesse von Zwergen oder Boghanik angepasst, aber trotzdem sehr "
"vorderlastig und recht schwer. Sie ist fuer eine Waffe eigentlich zu "
"unhandlich."));

AD("bergbau",
"Diese Art von Spitzhacke verwenden Zwerge in ihren Bergwerken.");

AD(({"waffe"}),
"Natuerlich schmerzt auch ein Loch das von einer Spitzhacke gehauen wurde.");

AD(({"loch"}),
"Schon mal daran gedacht eine Familie zu gruenden und Bauer zu werden?");

AD(({"korn","jahr","fruechte","bauer"}),
"Korn aussaeen und pflegen, und am Ende des Jahres die ehrlichen Fruechte "
"Deiner Arbeit einbringen.");

AD(("ende"),
"Setz doch dem unsicheren Abenteuertum ein Ende.");

AD(({"abenteuer","abenteuertum"}),
"Dieses rastlose Herumziehen."); 

AD(({"arbeit","soeldnertum","soeldner"}),
"Ehrliche schaffende Arbeit, kein so rauhes Soeldnertum.");

AD(("familie"),
"Die Kinderchen grossziehen.");

AD(("kinderchen"),
"Mach einen Anfang und erobere mit dieser Hacke den Bauernhof!");

AD(({"bauernhof","xaver","anfang"}),
"Noch gehoert er ja Xaver, aber das liese sich ja aendern, wenn auch nur schwer "
"mit dieser Hacke.");

AddId(({"hacke","spitzhacke"}));

SP(P_SHORT, "Eine kleine Spitzhacke");

SetProp (P_DAM_TYPE, ({ DT_PIERCE, DT_BLUDGEON}));
SetProp (P_WC, 80);
SetProp (P_WC_FIX, 40);
SetProp (P_NR_HANDS, 2);
SetProp (P_MATERIAL, ([MAT_STEEL:10, MAT_OAK:90]));
SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 8]));

}