//fertig und getestet
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create()
{
  ::create();
  AddItem("/d/dschungel/trintrasil/hoehle/npc/amoebe.lpc",
  REFRESH_DESTRUCT);
}


amoebepresent() {
	
	if(present("riesenamoebe", TO)) {
		
		return 1;
	}
	
	if(!present("riesenamoebe", TO)) {
		
		return 0;
	}
}


amoebemove_fels() {
	
	object amoebe;
	
	amoebe=present("riesenamoebe", TO);
	
	if(amoebe) {
		
		amoebe->move("/d/dschungel/trintrasil/hoehle/room/fels.lpc",
		M_TPORT);
	}
	
	if(!amoebe) {
		
		return 0;
	}
}


amoebemove_spalt() {
	
	object amoebe;
	
	amoebe=present("riesenamoebe", TO);
	
	if(amoebe) {
		
		amoebe->move("/d/dschungel/trintrasil/hoehle/room/spalt",
		M_TPORT);
	}
	
	else {
		return 0;
	}
}


amoebemove_amoebe() {
	
	object amoebe;
	
	amoebe=present("riesenamoebe", TO);
	
	if(amoebe) {
		
		amoebe->move("/d/dschungel/trintrasil/hoehle/room/amoebe.lpc",
		M_TPORT);
	}
	
	if(!amoebe) {
		
		return 0;
	}
}


flut() {
	
	object amoebe;
	amoebe=present("riesenamoebe", TO);
	
	if(amoebe) {
		
		amoebe->die();
		call_out("flut1", random(3));
	}
	
	else {
		return 0;
	}
}


flut1() {
	
	object leiche;
	leiche=present("leiche", TO);
	
	if(leiche) {
		
		leiche->move("/d/dschungel/trintrasil/hoehle/room/fels", M_TPORT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDie Leiche "
		"einer Riesenamoebe wird aus der Hoehle gespuelt."));
	}
}