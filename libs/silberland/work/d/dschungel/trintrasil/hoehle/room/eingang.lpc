#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";

 
void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Du befindest Dich in einer sich nach Osten stark verjuengenden Hoehle "
"die im Westen hinter einem tosenden Wasserfall endet. Das donnernde "
"Tosen des Wasserfalles wird von den nass glaenzenden Waenden dumpf "
"zurueckgeworfen. Durch den leuchtenden Wasserfall faellt schummriges Licht "
"in die Hoehle. Der Wasserspiegel wird nach Osten hin niedriger."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"fisch"}),
    "Hier kannst Du keinen Fisch rufen.");
 
  AD(("hoehle"),
    "Dieser Sandsteinspalt scheint viel tiefer in den Fels hinein zu fuehren. "
    "Ufer siehst Du allerdings noch keines. Der hintere Teil der Hoehle "
    "verliert sich sehr schnell im Dunkeln.");
  
  AD(({"sandsteinspalt","spalt"}),
    "Die vorne breite Hoehle verengt sich nach osten sehr stark zu einem "
    "dunklen Spalt.");
    
  AD(({"fluss","rio de la puseta","rio","puseta","blick"}),
    "Der Blick auf den Fluss ist Dir durch den Wasserfall versperrt.");
  
  AD(("licht"),
    "Durch den breiten Wasserfall dringt schummriges Licht in die Hoehle. "
    "Der Wasserfall ist so gross das Du durch ihn unmoeglich ins Freie gelangen "
    "kannst."),
    
  AD(("freie"),
    "Hinter dem Wasserfall fliesst der Rio de la Puseta.");
      
  AD( ("ufer"),
    "Der Wasserspiegel wird immer niedriger, also wirst Du weiter hinten "
    "in der Hoehle sicher an ein Ufer kommen.");
    
  AD(({"dunkel","dunkeln"}) ,  
    "Nur der vordere breite Bereich wird vom milden Schimmer "
    "der durch den Wasserfall dringt erleuchtet.");
  
  AD(({"bereich"}),
    "Nach osten laufen die Waende weiter zusammen.");
    
  AD(("fels"),
    "Der nasse Sandstein glaenzt nass im schwachen Schimmer des Wasserfalles.");
    
  AD(({"sandstein","stein"}),
    "Der nasse Sandstein laeuft unfoermig und unregelmaessig nach osten hin "
    "zu einem Spalt zusammen.");
     
  AD(({"schimmer","reflexionen"}),
    "Das matte, bewegte Schimmern erzeugt Reflexionen die wie Schlangen ueber "
    "die Felswand huschen.");
    
  AD(({"schlangen"}),
    "Wie hecktische kleine Schlangen schimmern die Reflexionen auf den Waenden. "
    "Als Du so die Waende betrachtest faellt Dir eine seltsame Form auf.");
  
  AD(({"form"}),
    "Als Du naeher heranschwimmst erkennst Du, dass Jemand etwas in den Fels "
    "geritzt hat.");
    
  AD(("jemand"),
    "Die Schrift ist schon verwittert und scheint sehr alt zu sein.");
    
  AD(({"etwas","schrift"}),
     "Du koenntest die Schrift gerade noch lesen."); 
     
  AD(({"wand","waende","felswand","felswaende"}),
    "Die Waende bilden einen breiten schraegen Trichter der nach osten "
    "zusammenlaeuft.");
   
  AD(({"trichter"}),
    "Nach hinten hin laufen die Waende immer schmaler zusammen.");

  AD(({"hinten","rueckwand","teil"}),
    "Der hintere Teil liegt im Dunkeln, aber die Hoehle scheint noch tief in "
    "den Fels zu fuehren.");
    
  AD(({"wasserspiegel","spiegel"}),
    "Der Grund steigt hier stark an. Weiter hinten in der Hoehle wirst Du "
    "stehen koennen.");
    
  AD(({"boden","grund","wasser"}),
    "Durch den tosenden Wasserfall ist die Wasseroberflaeche so unruhig das Du "
    "den Grund nicht klar erkennen kannst.");
    
  AD(({"oberflaeche","wasseroberflaeche"}),
    "Kleine hektische Wellen laufen ueber die aufgewuehlte Wasseroberflaeche.");
    
  AD(({"wellen","wellen"}),
    "Die vom Wasserfall aufgewuehlten Wellen klatschen dumpf gegen die "
    "Felswaende.");
    
  AD(({"wasserfall"}),
    "Der Wasserfall verdeckt den Eingang vollkommen.");

  AD(({"eingang","hoehleneingang"}),
    "Du fragst Dich schon ob eigentlich hinter jedem Wasserfall ein "
    "Hoehleneingang liegt.");
    
  AD(("tosen"),
    "Das Tosen des Wasserfalles hallt dumpf in den Hoehle wieder.");
  
  AD(("decke"),
    "Die unregelmaessige Decke wird nach osten hin niedriger.");
      
      
  AddCmd(({"entziffere","lies"}), "inschrift");
  AddCmd(("pfeife"), "func_fischruf");

  AddExit("osten", ([
          EX_FUNC:"wasser"]));


  AddSound( DEFAULT_SOUND,
   "Du hoerst nur das ohrenbetaeubende Rauschen des Wasserfalles.");
 
  AddSound(("rauschen"),
  "!!WUUUUUUSCHHHHHHHHHHHHHHHHHHHH!!"); 
}


inschrift(string str) {

        notify_fail("Was willst Du lesen?\n");
	
	if(str=="schrift"||str=="inschrift"||str=="buchstaben"||str=="zeichen") {
		
		write("\n  ZUM GEDENKEN AN ROBERT DE BRUCE UND CHARLES LE SABRE\n"
		      "    MOEGE EUCH DAS HOELLENFEUER NICHT ZU HEISS SEIN\n\n");
		say(BS(""+TPN+" hat anscheinend an der Hoehlenwand etwas "
		       "entdeckt."));
		return 1;
	}
	return 0;
}


int func_fischruf(string str) {
	
	object pfeife;
	pfeife=present("fischpfeife", TP);
	
	notify_fail("Mit was willst Du pfeifen?\n");
	
	if(str=="mit pfeife"||str=="mit fischpfeife"||str=="nach fisch mit pfeife"||
	str=="pfeife"||str=="fischpfeife"||str=="fisch"||str=="nach fisch") {
		
		if( KONTROLL->flut_aktiv()==2 ) {
			
			write(BS("Bei den Wassermassen die aus der Hoehle schiessen, kommt "
			"sicher kein Fisch."));
			return 1;
		}
		
		else {
			
			if(!pfeife) {
				
				write(BS("Um mit einer Fischpfeife einen Fisch zu rufen braucht "
				"man zu allererst einmal eine FISCHPFEIFE! Aber das ist "
				"jetzt nicht wichtig, weil hier hinter dem Wasserfall kannst "
				"Du sowieso keine Fische herbei pfeifen."));
				return 1;
			}
			
			if(pfeife) {
				
				write(BS("Du kannst hier hinter dem Wasserfall keine "
				"Fische herbei pfeifen."));
				return 1;
			}
		}
	}
}

	
int wasser() {
	
	if( KONTROLL->flut_aktiv()==1 ) {
		
		write(BS("Irgendetwas Seltsames geht in der Hoehle vor. Warte lieber "
		"ab."));
		say(BS(""+TPN+" zoegert die Hoehle zu betreten."));
		return 1;
	}
	
	if( KONTROLL->flut_aktiv()==2) {
		
		write(BS("Bei den Wassermassen die aus der Hoehle schiessen kannst "
		"Du nicht nach Osten gehen!"));
		say(BS(""+TPN+" will bei den Wassermassen die aus der Hoehle schiessen "
		"nach Osten gehen!"));
		return 1;
	}
	
	else {
		
		TP->move("/d/dschungel/trintrasil/hoehle/room/hoehle1", M_GO);
		return 1;
	}
}


flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	if(present("STDFISCH", TO)) {
		
		tell_room(TO, BS("Die Fische tauchen ploetzlich unter und schwimmen "
		"schnell aus der Hoehle."));
	}
	
	for(i=sizeof(inv)-1;i>=0;i--) if(living(inv[i])) {
		
		if( living(inv[i]) && inv[i]->id("STDFISCH") ) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
			inv[i]->remove();
		}
		
		if( living(inv[i]) && interactive(inv[i]) ) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/eingang1-h",
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
		
		if( living(inv[i]) && !interactive(inv[i]) && !inv[i]->id("STDFISCH") ) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/npcflut-h",
			M_GO+ M_SILENT);
			inv[i]->SetProp("herkunftsraum", "eingang");//wird in npcflut-h abgefragt um
		}                                                   //herkunft des npc fest zu stellen
	}
}