
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";


int tuer=1;

reset() {
::reset();
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"Du stehst in einem Gang der nach suedwesten durch eine gewaltige Eisentuer "
"in eine grosse, helle Hoehle fuehrt. Die nordoestliche Wand schimmert blass "
"und ist leicht durchscheinend. Die Felswaende sind hier geglaettet und "
"begradigt."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_JUNGLE]) );  
 
  AD(({"hoehle","wohnhoehle"}),
    "Aus der grossen, hellen Hoehle im westen hoerst Du lautes Gelaechter und "
    "Stimmengewirr.");
  
  AD(({"felswaende","waende","sandsteinwaende","wand"}),
    "Die gelben Sandsteinwaende sind geglaettet. Die feinen Linien und "
    "schimmernden Farben des Sandsteines wurden von den Boghanik sorffaeltig "
    "herauspoliert."),
    
  AD(({"farben","linien"}),
    "Der Sandstein wurde mit viel Zuneigung poliert bis seine Farben "
    "so sanft schimmerten.");
    
  AD(({"sandstein","stein"}),
    "Die Waende dieser Hoehle bestehen aus gelbem Sandstein.");
     
  AD(("innenseite"),
    "Der Hebel ist auf der Innenseite angebracht damit man die Tuer nur von der "
    "Hoehle aus versperren kann.");
    
  AD(({"hebel"}),
    "Damit kann man die Tuer wahrscheinlich verschliessen.");
  
  AD(("druck"),
    "Welchem Druck die Tuer standhalten soll kannst Du Dir nicht vorstellen "
    "vielleicht sagt es Dir einer der Boghanik.");
        
  AD(({"nordoestliche wand"}),
    "Die nordoestliche Wand ist eher ein durchschreitbarer Illusionszauber "
    "der die Wohnhoehle im suedwesten vor ungebetenen Gaesten schuetzen soll.");
    
  AD(({"illusionszauber","zauber","illusion"}),
    "Der Illusionszauber schirmt anscheinend auch Geraeusche und Gerueche ab.");
    
  AD(("geraeusche"),
    "Zumindest ist von dem regen Treiben draussen nichts zu hoeren.");
    
  AD(("gerueche"),
    "Ansonsten waere der Zauber zumindest gegen Raubtiere wirkungslos.");
    
  AD(({"raubtiere","tiere","gast","gaeste"}),
    "Gefaehrliche Tiere leben in diesen Hoehlen genug.");
    
  AD(("eingang"),
    "Der Eingang zu den Wohnhoehlen der Boghanik ist gemeint.");
    
  AD(({"wohnhoehlen","hoehlen","treiben","stimmengewirr","gewirr"}),
    "Schau Dir die Wohnhoehlen doch an.");
      
  AD(("gelaechter"),
    "Du siehst viele, kleine, geschaeftige Gestalten in der Hoehle.");
    
  AD(("gestalten"),
    "Es handelt sich um Boghanik.");
    
  AD(("boghanik"),
    "Boghanik sind noch kleiner als Zwerge. Die meisten Buckenstaemme siedeln "
    "im Inselinneren, aber manchmal kann man einen ihrer Jaeger auch in Tijara "
    " antreffen.");
 
  AD(({"boghanikstaemme","staemme","stamm","boghanikstamm"}),
    "Die meisten Boghanik bewohnen das schwer erreichbare Innere der Insel.");
    
  AD(({"inselinnere","innere","insel"}),
    "Der groesste Teil der Insel und ihrer ganzen Ausmasze sind unerforscht.");
    
  AD(({"teil","ausmasze"}),
    "Das Innere der grossen Insel ist nur sehr schwer zugaenglich.");
    
  AD(({"tijara","jaeger","siedlungen"}),
    "Die Boghanik leben zurueckgezogen und meiden groessere Siedlungen, aber "
    "manchmal schicken sie einen ihrer Jaeger aus um einen fuer den Stamm "
    "wichtigen Auftrag auszufuehren.");
    
  AD(("auftrag"),
    "Manchmal tauschen sie Felle oder Edelsteine.");
    
  AD(({"felle","fell","edelsteine","edelstein"}),
    "Die Boghanik leben meistens in Hoehlen und verstehen sich auf Bergbau. Aber "
    "auch mit Fellen handeln sie oft.");
    
  AD(({"bergbau","zuneigung"}),
    "Anscheinend eine angeborene Neigung der Boghanik.");
    
  AD(("neigung"),
    "Aehnlich wie bei Zwergen, aber ansonsten haben sie nichts gemeinsam.");
  
  AD(({"zwerge"}),
    "Boghanik haben keinen Haarwuchs und haben pupillenlose Augen.");
     
  AD(("augen"),
    "Die grossen Augen der Boghanik sind vollkommen schwarz.");
    
  AD(({"haare","haarwuchs","wuchs"}),
    "Boghanik sind vollkommen kahl.");
     
  AD(("gang"),
    "Dieser Gang fuehrt in eine grosse, helle Hoehle.");

  AD(("decke"),
    "Die Decke ist gewoelbt um der Last der Felsmassen ueber ihr auszuhalten.");
   
  AD(("last"),
    "Die Last muss gewaltig sein.");
     
  AD(({"felsmassen","massen"}),
    "Das Du Dich in einer Hoehle befindest ist Dir klar?");
   
  AD(({"boden","sand","schwemmsand"}),
    "Der Boden ist mit dem gleichen feinen Schwemmsand wie in der uebrigen "
    "Hoehle bedeckt.");     
  
  ASD(({"tuer","eisentuer"}),
    "eisentuer");
 
   
   
  AddCmd(({"schliesse","verschliesse"}), "func_tuerdlerei");
  AddCmd(("klopfe"), "func_klopfen");
  AddCmd(("oeffne"), "func_oeffnen");
  
  
 
  SetProp (P_HIDE_EXITS, ({"nordosten"}));
    
  AddExit("nordosten", ([
          EX_FUNC:"illusion",
          EX_PLMSG:"Du spuerst ein kuehles Prickeln und Ziehen als Du durch "
                   "den Illusionszauber trittst.\n\n"]));

  AddExit("suedwesten", ([
          EX_FUNC:"verschlossen"]));


  AddSound( DEFAULT_SOUND,
    "Aus dem osten hoerst Du Stimmen.");
 
  AddSound(("stimmen"),
    "Geh doch hin wenn es Dich interessiert."); 
 
}



  int illusion() {
  	
    TPM("/d/dschungel/trintrasil/hoehle/room/hoehle5", M_GO, "mit einem "
        "leisen Zischen durch die nordoestliche Wand", "verschwindet",
        "tritt mit einem leisen Zischen aus der suedwestlichen Wand");
       return 1;}
       
  
  
  int func_oeffnen(string str) {
  	
    if(str=="tuer"||str=="eisentuer"||str=="schutztuer"||str=="die tuer"||
       str=="die eisentuer"||str=="die schutztuer") {
       	
      if(tuer==1) {
      	
      	write(BS("Die Tuer ist ja offen! Geh einfach nach suedwesten wenn "
      	         "Du willst."));
      	        return 1;}
      	        
      if(tuer==0) {
      	
      	write(BS("Du kannst die schwere Eisentuer von aussen nicht oeffnen. "
      	         "Du koenntest aber anklopfen, vielleicht hoert Dich jemand."));
      	         
      	        return 1;}
      	       }
      	     }
      	       
      	       
      	             
//!!!!!!!!!!!!!!!!!!!!!!KLOPFEN!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  
  int func_klopfen(string str) {
  	
    notify_fail("An was willst du klopfen?\n");
  
  if(str=="tuer"||str=="eisentuer"||str=="schutztuer"||str=="an tuer"||
     str=="an eisentuer"||str=="an schutztuer"||str=="an die tuer"||
     str=="an die eisentuer"||str=="an die schutztuer"||str=="an") {
    	 
  if(tuer) {
    write(BS("Die Tuer ist doch offen. Warum willst Du dann anklopfen?"));
         return 1;}
  
  if(!tuer) {
    
    write(BS("Du haemmerst mit der Faust an die Eisentuer. Durch die dicke Tuer "
             "kannst Du aber nicht hoeren ob Dich jemand gehoert hat!"));
      say(BS(""+TPN+" klopft mit der Faust an die Eisentuer."));
      
    tell_room("/d/dschungel/trintrasil/hoehle/room/perfor2", 
              BS("!!KLOPF!!    "
                 "!!KLOPF!!    "
                 "!!KLOPF!!    "
              "Da haemmert jemand verzweifelt an die geschlossene Eisentuer! "
              "Du wuerdest ihn toeten wenn Du die Hoehle jetzt fluten "
              "wuerdest!"));
          return 1;}
      }
      }



  int func_tuerdlerei(string str) {
  	
    notify_fail("Was willst Du schliessen? Die Augen??\n"); 
    	
    if(str=="tuer"||str=="eisentuer"||str=="schutztuer") {
    	
    if(tuer) {
      write(BS("Der Hebel zum verschliessen der Tuer ist auf der Innenseite "
               "der Tuer. Die Tuer kannst Du nur von der Boghanikhoehle aus "
               "verschliessen."));
        say(BS(""+TPN+" hat die Funktionsweise der Tuer noch nicht ganz "
               "heraus."));
            return 1;}
     
     if(!tuer) {
       write(BS("Die Tuer wurde schon verschlossen. Da der Hebel aber auf der "
                "Innenseite der Tuer ist kannst Du sie auch nicht oeffnen. "
                "Aber Du koenntest ja mal klopfen."));
         say(BS(""+TPN+" stellt besorgt fest das die Tuer verschlossen ist."));
             return 1;}
        }
        
     if(str=="augen"||str=="auge") {
       write(BS("Schoen.Nun musst Du die Welt fuer einen Augenblick nicht "
                "sehen."));
           return 1;}
        }
      	

//!!!!!!!!!!!!!!!!!!!VESCHLIESSEN!!!!!!!!!!!!!!!!!!!!!!!

  int verschlossen() {
  
  if(tuer==0) {
   
   write(BS("Schau doch. Die schwere Eisentuer ist doch "
            "verschlossen!!"));
     say(BS(""+TPN+" stellt erstaunt fest das die schwere Eisentuer "
            "verschlossen ist."));
        return 1;}
    
  if(tuer) {
   Z1
   write(BS("Du betrittst durch die schwere Eisentuer die Hoehle der "
            "Boghaniks."));
   Z1
   TP->move("/d/dschungel/trintrasil/hoehle/room/perfor2", M_GO);
        return 1;}
    }
    
 
//oooooooooooooooooooCALL_OTHER PERFOR2(func oeffnen) oooooooooooooooooooooooooo

  set_door_open() {

  tuer=1;}   
    

//ooooooooooooooooooo CALL_OTHER PERFOR2(func sichern) oooooooooooooooooooooooo
  
  set_door_closed() {
  
  tuer=0;}



//!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!SPECIAL ONES!!!!!!!!!!!!!!!!!!!
eisentuer()
{
if(tuer) {
  
  return BS("Die Eisentuer ist ca 2 meter hoch und sehr dick. Auf der "
            "Innenseite ist ein Hebel angebracht. Sie sieht aus als sollte "
            "sie grossem Druck von aussen standhalten koennen.");
  }

if(!tuer) {
  
  return BS("Die gewaltige Eisentuer ist verschlossen und versperrt. "
            "Versuch doch einmal zu klopfen, vielleicht macht Dir wer auf!");
  }
}

   
//ooooooooooooooooooooooo CALL_OTHER AUS PERFOR2 oooooooooooooooooooooooooooooo   
   
  flut() {
  	
    int i;
    object *inv;
    inv=all_inventory(this_object());
    
    for(i=sizeof(inv)-1;i>=0;i--) { 
    
    if(interactive(inv[i]))  {  
    	
      inv[i]->move("/d/dschungel/trintrasil/hoehle/room/perflut-h", M_GO+ 
                   M_SILENT+  M_NO_SHOW);  }
              }
      call_out("npcflut", 10);
      call_out("flut1", 45);
      }

 
  npcflut() {
  	
    int i;
    object *inv;
    inv=all_inventory(this_object());
    
    for(i=sizeof(inv)-1;i>=0;i--) {
    
     if((!interactive(inv[i])) && (living(inv[i]))) {
     	
     	inv[i]->die();   
       return 1;}
     return 0;}
   return 0;}
       
   flut1() {
   	
     int i, x;
     object *inv;
     x=0;
     inv=all_inventory(TO);
     
     for(i=sizeof(inv)-1;i>=0;i--) {    
     
     if(x<10) {
       
       inv[i]->move("/d/dschungel/trintrasil/hoehle/room/eingang", 
                   M_GO+ M_SILENT);
       tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
            BS(""+inv[i]->name()+" wird von den gewaltigen Wassermassen hierher "
               "gespuelt."));
       H(eingang)
         }
       }
     }
      
    
 //ooooooooooooooooooooooooo RESETFUNC ooooooooooooooooooooooooooooooooooooooooo
 
     resetfunc() {
     	
     	tuer=1;
     	
     	}