
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";


create() {
	
	::create();

SetProp( P_INT_SHORT, "kurz vor dem Ertrinken" );
SetProp( P_INT_LONG, BS(
  "!jetzt hab ich aber vom formatieren die schnauze gestrichen voll!"));
  
SetProp( P_LIGHT, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
AddCmd ("", "no", 1);   
SetProp(P_KILL_NAME, "eine Ueberflutung");
SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}


int no() {
	
	write ("\nOh mein Gott! WAS GEHT HIER VOR?\n");
	return 1;
}


int njet() {
	
	write("!!DU WIRST ERTRINKEN!!\n");
	return 1;
}


init() {
	
	::init();
	
	if(query_once_interactive(this_player())) {
		
		call_out("flut", 3);
	}
}


flut() {
	
	NIX
	write(BSL("\nPloetzlich beginnen die Hoehlenwaende zu vibrieren!"));
	AddCmd("","no", 1);
	call_out("flut1", 3);
}


flut1() {
	
	NIX
	write(BSL("\nEin gewaltiges Rumpeln droehnt durch die Hoehle."));
	call_out("flut2", 3);
}


flut2() {
	
	NIX
	write(BSL("\nDie Waende wackeln wie bei einem Erdbeben. Das Brausen klingt als wuerden "
	"Unmengen von Wasser durch die Hoehle donnern!"));
	call_out("flut3", 3);
}


flut3() {
	
	NIX
	write(BSL("\nDir kommt langsam die Idee das der enge Spalt hier bald durchaus "
	"ungemuetlich werden koennte!"));
	call_out("flut4", 2);
}


flut4() {
	
	NIX
	write(BSL("\nMit einem unglaublichen Krachen schiesst ploetzlich Wasser von "
	"Suedosten in den Spalt!!!"));
	RemoveCmd("", "no");
	AddCmd("", "njet", 1);
	call_out("flut5", 2);
}


flut5() {
	
	NIX
	write(BSL("\n"
	"  !!!!!!!!WWWWWWWWWWWWWWWWWWWWWWWWWWWW!!!!!!!!\n"
	"  !!!!!!!!UUUUUUUUUUUUUUUUUUUUUUUUUUUU!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"));
	call_out("flut6", 2);
}


flut6() {
	
	NIX
	write(BSL("\nDu reisst noch entsetzt die Arme hoch, dann triff Dich der gewaltige "
	"Wasserstrahl mit voller Wucht!!!"));
	TP->do_damage(30+random(45));
	call_out("flut7", 2);
}


flut7() {
	
	NIX
	write(BSL("\nDu willst schreien, doch Wasser schiesst Dir in Mund und Nase!!!"));
	TP->do_damage(30+random(15));
	call_out("flut8", 2);
}


flut8() {
	
	NIX
	write(BSL("\nErschrocken willst Du nach Luft japsen, als Dir Wasser in den Hals "
	"schiesst!!!"));
	call_out("flut9", 2);
}


flut9() {
	
	NIX
	write(BSL("\nDu versuchst Dich irgendwo festzuhalten, aber das Wasser reisst "
	"Dich hoch und knallt Dich in dem engen Spalt hart gegen die Wand."));
	TP->do_damage(20+random(20));
	call_out("flut9a", 1);
}


flut9a() {
	
	int i;
	object *inv;
	inv=all_inventory(TO);
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(!living(inv[i])) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/fels", M_GO+ 
			M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("flut10", 1);
}


flut10() {
	
	NIX
	write(BSL("\nWie einen Korken schiesst Dich der Wasserstrahl nach Westen aus der "
	"Spalte, fuer einen Augenblick fliegst Du durch die Luft."));
	call_out("flut11", 2);
}


flut11() {
	
	NIX
	write(BSL("\nDu knallst auf einem Felsen auf und kannst Dich gerade noch an dem "
	"Stein festkrallen bevor Dich die Wassermassen in den Rio de la Puseta spuelen, "
	"wo Du sicher ersoffen waerst."));
	call_out("flut12", 1+random(3));
}


flut12() {
	
	NIX
	write(BSL("\nTotal durchnaesst und halb ertrunken ziehst Du Dich an eine halbwegs "
	"sichere Stelle und versuchst wieder zu Atem zu kommen."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BS(""+TPN+" wird von den "
	"Wassermassen hereingespuelt."));
	TP->move("/d/dschungel/trintrasil/hoehle/room/fels", M_GO+ M_NO_SHOW+ 
	M_SILENT);
	RemoveCmd("", "njet");
	AddCmd("", "no", 1);
}


BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/hoehle/room/fels",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	
	leiche=present("leiche", TO);
	
	if (leiche)  {
		
		leiche->move("d/dschungel/trintrasil/hoehle/room/fels", M_TPORT+
		M_SILENT);
		tell_room("d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDie Leiche "
		"von "+CAP(getuid(TP))+" wird angespuelt! Schrecklich!"));
	}
	
	write_file("/d/dschungel/trintrasil/log/flut",
	ctime()+": Flut hat "+CAP(getuid(TP))+" umgebracht.\n");
}