//fertig und getestet
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fischdef.h"

inherit "/std/room";

#define SPALT "/d/dschungel/trintrasil/hoehle/room/amoebe-h"
#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"


int fackel_present=1;


reset() {
   ::reset();
   fackel_present=1;
}


init() {
	
	object schatten;
	schatten=clone_object("/d/dschungel/trintrasil/fluss/npc/schatten.lpc");
	
	::init();
	
	if( living(this_player()) && !interactive(this_player()) && !TP->QueryProp("flussnpc") &&
	!TP->QueryProp("shadow(trint)") ) {
		
		schatten;
		schatten->setze_besitzer();
		TP->SetProp("shadow(trint)", 1);
	}
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Du befindest Dich auf einem grossen, flachen, dunkelroten Felsblock. Nach "
"Westen wird die Hoehle breiter und hoeher bis sie nach ca 25 m im Rio de la "
"Puseta muendet. Der ca 3 m hohe Fels liegt zur Haelfte unter  tuerkisem "
"Flusswasser. Die gelben Hoehlenwaende schimmern feucht in den sanften "
"Reflexionen des Wassers."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"fisch"}),
    "Du stehst auf einem Felsblock und siehst hier keinen Fisch, aber wenn Du "
    "eine geeignete Pfeife bei Dir hast kannst Du einen Fisch rufen.");

  AD(({"fischpfeife","fischpfeifen","pfeife","pfeifen"}),
    "Hier im Flussgebiet des Rio de la Puseta wachsen Graetenbuesche aus deren "
    "Holz man diese besonderen Pfeifen schnitzen kann.");
    
  AD(("holz"),
    "Die Technik des Fischpfeifenschnitzens wird bei den hier lebenden "
    "Einheimischen schon lange ausgeuebt. Man kann mit einer solchen Pfeife "
    "grosse Fische anlocken wenn man unter Wasser damit pfeift.");
  
  AD(({"eingeborene","einheimische"}),
    "Die Technik des Schnitzens kommt von Eingeborenen des Flussgebiets.");
       
  AD(({"gebiet","flussgebiet"}),
    "Du siehst den Fluss draussen vor der Hoehle vorbei fliessen.");
    
  AD(({"technik","schnitzen","fischpfeifenschnitzen","messer"}),
    "Alles was Du dazu brauchst ist ein Messer und einen "
    "Graetenbuschzweig.");
    
  AD(({"buesche","busch","graetenbusch","graetenbuesche","graetenbuschzweig","zweig"}),
    "Hier in der Hoehle wirst Du eher kaum einen Graetenbusch finden.");
    
  AD(({"hoehle"}),
    "Die gelben Sandsteinwaende der Hoehle schimmern nass. Das reflektierte "
    "Licht malt auf ihnen bewegte Muster. Wenige Meter hinter dem Felsblock "
    "laufen die Waende spitz zusammen und beenden die Hoehle.");
  
  AD(("meter"),
    "Nach ca 4 Metern endet die Hoehle im osten. Nach westen verbreitert sie "
    "sich, bis sie in den Rio de la Puseta hinaus fuehrt.");
      
  AD(({"sandsteinwaende","waende","wand","sandsteinwand","hoehlenwand",
       "hoehlenwaende","felswaende","felswand"}),
    "Die Waende sind der Laenge nach mit gelb-orangen Streifen durchzogen. "
    "Nach Osten laufen sie aufeinander zu und beenden die Hoehle bereits nach "
    "einigen Metern.");
  
  AD(({"fels","felsblock","block"}),
    "Der dunkelrote grosse Felsblock fuegt sich nahezu ohne Luecken zwischen "
    "die spitz zulaufenden Sandsteinwaende.");
    
  AD(({"luecken"}),
    "Als waere der maechtige Fels genau eingepasst worden, schliesst er nahezu "
    "lueckenlos mit den unfoermigen Waenden ab. Kaum handbreite Ritzen sind "
    "zu sehen.");
    
  AD(("ritzen"),
    "War da nicht ein schwacher Schimmer in einer der Ritzen?");
    
  AD(({"ritze","schimmer","luecke"}),
    "Diese Ritze zwischen Wand und Felsblock ist gerade breit genug um mit der "
    "Hand hinein zu greifen.");
    
  AD(("hand"),
    "Greife in die Ritze.");
  
  AD(("osten"),
    "Naja das Ende der Hoehle ist schon etwas duester da das Licht vom Eingang "
    "her kaum mehr so weit reicht.");
  
  AD(("ende"),
    "Als Du die Waende genauer untersuchst faellt Dir ein schmaler Spalt auf.");
    
  AD(({"spalte","felsspalte","felsspalt","spalt"}),
    "Zwischen den Waenden bleibt ein schmaler Spalt frei durch den Du kriechen "
    "koenntest. Allerdings ist er sehr eng, und Du kannst ueberhaupt nicht "
    "sehen ob sich etwas in dieser Dunkelheit befindet.");
    
  AD(("dunkelheit"),
    "Sicherer waere es erst mit einer Fackel in das Loch zu leuchten.");
    
  AD(({"loch","fackel"}),
    "Leuchte mit Fackel in das Loch.");
        
  AD(({"streifen","linie","linien","laenge"}),
    "Gelbliche Linien unterschiedlich gefaebten Gesteins ziehen sich durch "
    "die Hoehlenwand.");
    
  AD(("decke"),
    "Die Waende laufen spitz zusammen.");
    
  AD(("gestein"),
    "Das Gestein um Dich herum ist ausschließlich Sandstein.");
    
  AD(({"boden"}),
    "Den Boden bildet hier der dunkelrote Felsblock. Er passt beinahe genau "
    "zwischen die zulaufenden Waende.");
  
  AD(({"sand"}) ,  
    "Der Sand scheint hier aus dem Fels geschuerft worden zu sein.");
    
  AD(({"sandstein","stein"}),
    "Der Sandstein schimmert in deinem Licht in den unterschiedlichsten "
    "Gelbtoenen.");
    
  AD(({"wasser","flusswasser"}),
    "Das Wasser des Rio de la Puseta am Fuss des Felsblockes ist vollkommen "
    "klar und schimmert tuerkis. Es waere tief genug einen Fisch zu rufen.");
   
  AD(({"ruecken","fuss"}),
    "Das Wasser vor dem Felsblock waere gerade tief genug fuer einen Fisch. "
    "Wenn Du willst koenntest Du mit einer Fischpfeife einen rufen.");
     
  AD(({"rio","puseta","rio de la puseta","fluss","schlucht"}),
    "Wenn Du eine Fisch rufst, auf seinen Ruecken kletterst und dann westen schwimmst, "
    "kommst Du auf den Fluss hinaus.");
             
  AD(({"gelbtoene","toene","faerbung"}),
    "Erstaunlich warum der Sandstein keine einheitlich Faerbung hat. ");

  AD(({"reflexionen","reflexionen","muster"}),
    "Das Licht das von der Schlucht her hereinfaellt huscht sanft schimmernd "
    "ueber die Sandsteinwaende.");
  
  AD(("haelfte"),
    "ca 1,5 meter unter Dir schwappt der Rio de la Puseta gegen den Felsblock.");
          
  AD(({"licht"}),
    "Das Licht wird mild vom Wasser reflektiert und laesst die Waende sanft "
    "schimmern.");
  
  AD(("tropfen"),
    "Du kannst das Tropfen nur hoeren und nicht sehen.");
    
  AD(({"gegenstand","gegenstaende","versteck"}),
    "Ein Versteck fuer einen kleinen Gegenstand der hier einmal hinein kommt.");
    
  
  
  AddCmd(({"klettere","kletter"}), "func_reiten");
  AddCmd(("pfeife"), "func_fischruf");
    
  AddCmd(({"leuchte","beleuchte"}), "func_amoebe");
  AddCmd(({"unt","untersuche"}), "func_buttersaeure");
  AddCmd(("krieche"), "func_spalt");     
  AddCmd(("greife"), "func_ritze");
  
  
  
  AddSmell( DEFAULT_SMELL,
    "Eigenartig. Ein seltsam sauerer Geruch liegt in der Luft.");
    
  AddSmell(({"sauer","saeure","geruch","luft","saeuregeruch"}),
    "Der Geruch scheint am spitzen Ende der Hoehle am staerksten zu sein.");
    
  AddSmell(({"ende"}),
    "Da ist ja ein Spalt zwischen den zusammenlaufenden Waenden. Vorsicht der Geruch "
    "ist nicht ganz geheuer.");
    
  AddSmell(({"spalt"}),
    "Eindeutig, der Saeuregeruch kommt aus der Spalte. Du solltest sie genauer "
    "untersuchen.");
    
  AddSound( DEFAULT_SOUND,
    "Das Wasser schlaegt ganz leise gegen die Felswaende. Ausserdem hoerst Du ein "
    "eigenartiges Tropfen.");
  
  AddSound(("tropfen"),
    "Jetzt faellt Dir erst der saure Geruch hier auf. Ob er etwas mit dem Tropfen zu "
    "tun hat?"); 
 
  AddSound(("wasser"),
    "plitsch, plitsch, platsch"); 
  
  }



int func_amoebe(string str) {
	
	object fackel;
	fackel=present("fackel", TP);
	
	notify_fail("Was willst Du ausleuchten?\n");
	
	if(str=="loch"||str=="in loch"||str=="loch aus"||str=="loch mit fackel aus"||
	str=="loch mit fackel"||str=="in loch mit fackel"||str=="mit fackel in loch"||
	str=="mit fackel loch aus"||str=="mit fackel loch"||str=="spalt"||
	str=="in spalt"||str=="spalt aus"||str=="spalt mit fackel aus"||
	str=="spalt mit fackel"||str=="in spalt mit fackel"||str=="mit fackel in spalt"||
	str=="mit fackel spalt aus"||str=="mit fackel spalt"||str=="spalte"||
	str=="in spalte"||str=="spalte aus"||str=="spalte mit fackel aus"||
	str=="spalte mit fackel"||str=="in spalte mit fackel"||str=="mit fackel in spalte"||
	str=="mit fackel spalte aus"||str=="mit fackel spalte") {
		
		if( KONTROLL->flut_aktiv()==2 ) {
			
			write(BS("Aus der Hoehle schiesst Wasser. Du hast wirklich andere "
			"Probleme."));
			return 1;
		}
		
		if( KONTROLL->flut_aktiv()==1 ) {
			
			write(BS("Das eigenartige Rumpeln in der Hoehle ist Dir nicht "
			"geheuer. Warte lieber ab was passiert."));
			return 1;
		}
		
		else {
			
			if(!fackel) {
				
				write(BS("Du hast doch gar keine Fackel."));
				return 1;
			}
			
			if( fackel && !fackel->QueryProp(P_LIGHTED) ) {
				
				write(BS("Unangezuendet bringt Dir die Fackel wenig."));
				return 1;
			}
			
			if( SPALT->amoebepresent() && fackel && fackel->QueryProp(P_LIGHTED) ) {
				
				write(BS("Vorsichtig haeltst Du die Fackel in das duestere "
				"Loch und spaehst hinein. Tief im Loch kannst Du ein "
				"eigenartiges bewegtes Glitzern erkennen."));
				say(BS(""+TPN+" leuchtet in ein duesteres Loch."));
				return 1;
			}
			
			if( !SPALT->amoebepresent() && fackel && fackel->QueryProp(P_LIGHTED) ) {
				
				write(BS("Vorsichtig haeltst Du die Fackel in das duestere "
				"Loch, aber Du kannst nichts Verdaechtiges erkennen."));
				say(BS(""+TPN+" leuchtet in ein duesteres Loch."));
				return 1;
			}
			return 1;
		}
	}
}



int func_buttersaeure(string str) {
	
	if(str=="glitzern"||str=="bewegtes glitzern") {
		
		if( SPALT->amoebepresent() ) {
			
			write(BS("Als Du das Glitzern genauer ansiehst erkennst Du "
			"deutlich eine schleimige Masse die sich bewegt."));
			say(BS(""+TPN+" schaut ganz gebannt in ein duesteres Loch."));
			call_out("schleim1", 3);
			return 1;
		}
		
		else {
			write(BS("Die Spalte scheint leer zu sein. Du kannst nichts "
			"Auffaelliges entdecken."));
			say(BS(""+TPN+" schaut ganz gebannt in ein duesteres Loch."));
			return 1;
		}
		return 0;
	}
	return 0;
}



int func_ritze(string str) {
	
	object fackel;
	
	notify_fail("Wohin willst Du greifen?\n");
	
	if(str=="in ritze"||str=="in spalte"||str=="in luecke"||str=="in ritze hinein"||
	str=="in spalte hinein"||str=="in luecke hinein"||str=="mit hand in ritze "||
	str=="mit hand in spalte"||str=="mit hand in luecke"||str=="mit hand in ritze hinein"||
	str=="mit hand in spalte hinein"||str=="mit hand in luecke hinein")  {
		
		if( KONTROLL->flut_aktiv()==2 ) {
			
			write(BS("Bei den Wassermassen die da aus der Hoehle schiessen "
			"kommst Du nicht an die Ritze heran."));
			return 1;
		}
		
		else {
			
			if( fackel_present==1 ) {
				
				write(BS("Du tastest mit der Hand auf gut Glueck in die "
				"Ritze und findest tatsaechlich eine Fackel! Seltsam, wer "
				"versteckt denn hier eine Fackel?"));
				say(BS(""+TPN+" tastet in eine Ritze und findet eine "
				"Fackel."));
				fackel=CLONEOB("/obj/fackel");
				
				if(fackel->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
					write(BS("Du Schwaeschling laesst sie aber fallen weil "
					"sie Dir zu schwer ist."));
					fackel->move(ENV(TP));
					fackel_present=0;
					say(BS(""+TPN+" ist zu schwach fuer die Fackel."));
					return 1;
				}
				
				else {
					write(BS("Du steckst die Fackel ein."));
					say(BS(""+TPN+" steckt die Fackel ein."));
					fackel_present=0;
					return 1;
				}
			}
			
			else {
				write(BS("Schade Du hast Dich wohl getaeuscht. Die Luecke "
				"waere ein ideales Versteck fuer kleine Gegenstaende."));
				say(BS(""+TPN+" greift mit der Hand in eine kleine Ritze "
				"zwischen Felsblock und Wand, scheint aber nichts zu "
				"finden."));
				return 1;
			}
		}
	}
}


schleim1() {
	
	if(SPALT->amoebepresent()) {
		
		NIX
		write(BSL("\nDurch den Schleim laeuft ploetzlich ein Zucken.\n"
		"  !!!! ER BEWEGT SICH NUN AUF DICH ZU !!!!\n\n"));
		say(BSL(""+TPN+" zuckt erschrocken zurueck."));
		call_out("schleim2", 2);
	}
	
	else {
		write(BS("Eigenartig. Du nimmst eine fliessende Bewegung wahr, und "
		"ploetzlich ist der Schleim weg!"));
	}
}



schleim2() {
	
	if(SPALT->amoebepresent()) {
		
		NIX
		SPALT->amoebemove_fels();
	}
	
	else {
		write(BS("Eigenartig! Ploetzlich zieht sich der Schleim ruckartig "
		"zurueck und ist verschwunden."));
	}
}




int func_spalt(string str) {
	
	notify_fail("In was willst Du kriechen?\n");
	
	if(str=="in loch"||str=="in spalt"||str=="in dunkelheit"||str=="durch loch"||
	str=="durch spalt"||str=="durch dunkelheit"||str=="in spalte"||
	str=="durch spalte") {
		
		if(KONTROLL->flut_aktiv()==0) {
			
			write(BSL("Du ziehst den Kopf ein und zwaengst Dich mit einem "
			"unguten Gefuehl in den erdrueckend engen Spalt.\n"));
			TPM("/d/dschungel/trintrasil/hoehle/room/spalt.lpc", M_GO,
			"sich muehsam in einen engen Spalt", "zwaengt", 
			"kriecht keuchend herein");
			return 1;
		}
		
		if(KONTROLL->flut_aktiv()==2) {
			
			write(BS("Bei den Wassermassen die aus dem Spalt schiessen "
			"waere es Selbstmord zu versuchen in den Spalt zu kriechen."));
			return 1;
		}
		
		if(KONTROLL->flut_aktiv()==1) {
			
			write(BS("Das eigenartige Rumpeln in der Hoehle ist Dir nicht "
			"ganz geheuer. Warte lieber ab."));
			return 1;
		}
		return 1;
	}
}



//ßßßßßßßßßßßßßßß FUNKTIONEN DIE DAS VERLASSEN DES FELSEN MITTELS FISCHEN REGELN ßßßßßßßßßßßßßßßßßßßßßßßßß
  
  
int func_fischruf(string str) {
	
	object pfeife;
	pfeife=present("fischpfeife", TP);
	
	notify_fail("Mit was willst Du pfeifen?\n");
	
	if(str=="mit pfeife"||str=="mit fischpfeife"||str=="nach fisch mit pfeife"||
	str=="pfeife"||str=="fischpfeife"||str=="fisch"||str=="nach fisch") {
		
		if( KONTROLL->flut_aktiv()==2 ) {
			
			write(BS("Bei den Wassermassen die aus der Hoehle schiessen, kommt "
			"sicher kein Fisch."));
			return 1;
		}
		
		else {
			
			if(!pfeife) {
				
				write(BS("Um mit einer Fischpfeife einen Fisch zu rufen braucht "
				"man zu allererst einmal eine FISCHPFEIFE!"));
				return 1;
			}
			
			if((pfeife) && (!present("stdfisch", TO))) {
				
				write(BS("Du haeltst Deinen Kopf unter Wasser und blaest "
				"mit aller Kraft in die Pfeife. Du hoerst zwar absolut "
				"nichts, glaubst aber ein unangenehmes Vibrieren zu "
				"spueren."));
				say(BS(""+TPN+" steckt seinen Kopf ins Wasser. Kurz "
				"darauf spuerst Du ein leichtes, unangenehmes Vibrieren."));
				call_out("fisch", 3);
				return 1;
			}
			
			if((pfeife) && (present("stdfisch", TO))) {
				
				write(BS("Warum willst Du schon wieder Fische herbeipfeifen wo "
				"doch noch einer hier ist."));
				return 1;
			}
		}
	}
}


  
int func_reiten(string str) {
	
	object fisch;
	fisch=present("fisch", TO);
	
	notify_fail("Auf was willst Du klettern?\n");
	
	if(str=="auf fisch"||str=="fisch"||str=="auf ruecken fisch"||
	str=="auf ruecken fisches"||str=="auf fischruecken"||str=="auf ruecken")  {
		
		if(present("STDFISCH", TO)) {
			
			write(BSL("\nVorsichtig kletterst Du vom Felsen auf den Ruecken "
			"eines Fisches. Der Fisch scheint Dich ohne Probleme zu "
			"tragen.\n\n"));
			TPM("/d/dschungel/trintrasil/fluss/room/hoehle", M_GO,
			"auf den Ruecken eines Fisches", "kletter",
			"klettert vom Fels auf den Ruecken eines Fisches");
			fisch->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
			fisch->remove();
			return 1;
		}
		
		if(!present("STDFISCH", TO)) {
			
			write(BS("Da ist kein Fisch auf den Du klettern koenntest, "
			"den muesstest Du erst mit einer Fischpfeife pfeifen."));
			return 1;
		}
		return 0;
	}
	return 0;
}

    
//&&&&&&&&&&&  DIESE FUNKTIONEN WERDEN VON DER FISCHPFEIFE AUFGERUFEN  &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
//&&&&&&&&&&&          WENN DER SPIELER MIT IHR FISCHE HOLT            &&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&    

fisch() {
	
	if(KONTROLL->flut_aktiv()!=2) {
		
		tell_room("/d/dschungel/trintrasil/hoehle/room/fels",
		BSL("\n\nDas Wasser am Hoehleneingang geraet seltsam in Bewegung."));
		call_out("fisch1", 3);
		return 1;
	}
	
	else {
		tell_room("/d/dschungel/trintrasil/hoehle/room/fels",
		BSL("\n\nDu nimmst am Hoehleneingang Bewegungen im Wasser wahr. Sie "
		"verschwinden aber gleich wieder."));
		return 1;
	}
}


fisch1() {
	
	object fisch;
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels",
        BSL("\n\nSprudelnd und spritzend tauchen ploetzlich einige sehr grosse "
        "Fische auf."));
        fisch=CLONEOB("/d/dschungel/trintrasil/fluss/npc/stdfisch");
        fisch->move(TO, M_TPORT);
        fisch=CLONEOB("/d/dschungel/trintrasil/fluss/npc/stdfisch");
        fisch->move(TO, M_TPORT);
        fisch=CLONEOB("/d/dschungel/trintrasil/fluss/npc/stdfisch");
        fisch->move(TO, M_TPORT);
        call_out("fisch2", 2);  
}



fisch2() {
	
	if(present("STDFISCH", TO)) {
		
		tell_room("/d/dschungel/trintrasil/hoehle/room/fels",
		BSL("\n\nDu koenntest auf den Ruecken eines der Fische klettern."));
	}
	
	else {
	}
}


//$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ FISCHPFEIFE ENDE $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$    

//ßßßßßßßßßßßßßßßßßßßßß FUNKTIONEN DIE DAS VERLASSEN MITTELS FISCHEN REGELN ENDE ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß   



flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	if(present("STDFISCH", TO)) {
		
		tell_room(TO, BS("Die Fische tauchen ploetzlich unter und schwimmen "
		"schnell aus der Hoehle."));
	}
	
	for(i=sizeof(inv)-1;i>=0;i--) if(living(inv[i])) {
		
		if( living(inv[i]) && inv[i]->id("STDFISCH") ) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
			inv[i]->remove();
		}
		
		if( living(inv[i]) && interactive(inv[i]) ) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/fels-h",
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
		
		if( living(inv[i]) && !interactive(inv[i]) && !inv[i]->id("STDFISCH") ) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/npcflut-h",
			M_GO+ M_SILENT);
			inv[i]->SetProp("herkunftsraum", "fels");//wird in npcflut-h abgefragt um
		}                                                //herkunft des npc fest zu stellen
	}
}