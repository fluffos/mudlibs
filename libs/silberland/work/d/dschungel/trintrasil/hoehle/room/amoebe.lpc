//fertig und getestet
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";

#define SPALT "/d/dschungel/trintrasil/hoehle/room/amoebe-h"
#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"


init() {
	
	object schatten;
	schatten=clone_object("/d/dschungel/trintrasil/fluss/npc/schatten.lpc");
	
	::init();
	
	if( living(this_player()) && !interactive(this_player()) && !TP->QueryProp("flussnpc") &&
	!TP->QueryProp("shadow(trint)") ) {
		
		schatten;
		schatten->setze_besitzer();
		TP->SetProp("shadow(trint)", 1);
	}
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Gang scheint nur ein kurzer und enger Spalt zu sein. Im Nordwesten laufen "
"die unfoermigen, schraegen Waende aufeinander zu und verschliessen die Hoehle, "
"im Suedosten muendet der Gang in einen grossen Hohlraum. Am Boden liegt, halb "
"vom Sand verdeckt, ein verkruemmtes menschliches Skelett."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"fisch"}),
    "Schau lieber ob das Tier das den Menschen hier getoetet hat noch hier ist.");

  AD(({"hoehle"}),
    "Die engen, gelben Sandsteinwaende der Hoehle schimmern feucht. Leise "
    "rieselt Wasser von der Decke herab.");
    
  AD(({"sandsteinwaende","waende","wand","sandsteinwand","hoehlenwand"}),
    "Die schraegen Waende ruecken immer enger zusammen, aber als Du die Hoehle "
    "genauer ausleuchtest entdeckst Du noch ein kleines Loch in das Du "
    "kriechen koenntest.");
    
  AD(({"loch"}),
    "Das schmale Loch ist von den schraegen Waenden halb verdeckt. Du kannst "
    "nicht erkennen wohin es fuehrt. Ob Du einfach so vertrauensselig in die "
    "Dunkelheit kriechen solltest?");
    
  AD(("dunkelheit"),
    "Sicherer waere es erst mit einer Fackel in das Loch zu leuchten.");
  
  AD(("fackel"),
    "Leuchte mit Fackel in das Loch.");
      
  AD(("decke"),
    "Die Waende laufen spitz zusammen.");
    
  AD(({"boden"}),
    "Der Boden ist hier mit grobem, feuchtem Sand bedeckt. Halb vergraben "
    "modert ein altes Skelett vor sich hin.");
  
  AD(({"sand"}) ,  
    "Groebkoerniger Sand bedeckt den Boden. Halb vergraben siehst Du ein "
    "altes, verkruemmtes menschliches Skelett. Als Du den Boden genauer "
    "untersuchst findest Du noch einige andere Knochenteile.");
    
  AD(({"sandstein","stein"}),
    "Der Sandstein schimmert in den unterschiedlichsten Gelbtoenen.");
    
  AD(({"wasser"}),
    "Durch den poroesen Sandstein sickert Wasser von der Decke.");
  
  AD(({"gelbtoene","toene","faerbung"}),
    "Erstaunlich warum der Sandstein keine einheitlich Faerbung hat.");
  
  AD(("skelett"),
    "Obwohl das Skelett in die einzelnen Knochen zerfallen ist kannst Du "
    "erkennen das es ein menschliches Skelett ist.");
  
  AD(({"gang","spalt"}),
    "Der Gang verengt sich zu einem schmalen Spalt und scheint schon zu "
    "enden.");
    
  AD(({"hohlraum","raum"}),
    "Der kurze Gang muendet im suedosten in einen grossen Hohlraum aus dem Du "
    "lautes Plaetschern hoerst.");
    
  AD(("plaetschern"),
    "Wenn Du nach suedosten gehst siehst Du mehr.");
      
  AD(("knochen"),
    "Du kannst keine Brueche oder andere Beschaedigungen erkennen. Aber alle "
    "Knochen sehen von Saeure zerfressen und halb aufgeloest aus.");
    
  AD(({"saeure","magensaeure"}),
    "Vielleicht so etwas wie Magensaeure.");
    
  AD(({"brueche","bruch","beschaedigungen"}),
    "Was immer auch diesen Menschen umgebracht hat, es hat keinen Knochen "
    "gebrochen.");
  
  AD(({"teile","knochenteile"}),
    "Du findest immer mehr verschieden alte Knochen.");
  AD(({"alte knochen","verschiedene knochen"}),
    "Hier sind anscheinend schon einige Lebewesen gestorben. Sei bloss vorsichtig!");
          
  AD(({"lebewesen","mensch"}),
    "Pass auf das Dir nicht das gleiche passiert.");
  
  
  AddCmd(({"leuchte","beleuchte"}), "func_amoebe");
  AddCmd(({"unt","untersuche"}), "func_buttersaeure");
  AddCmd(("krieche"), "func_spalt");
  
      
  AddExit( "suedosten", "./hoehle3" );


  AddSound( DEFAULT_SOUND,
    "Leise rieselt Wasser von der Decke. Aus suedosten hoerst Du lautes "
    "Plaetschern.");
 
  AddSound(("wasser"),
    "plitsch, plitsch, platsch"); 
 
  AddSound(("plaetschern"),
    "!!platsch, platsch, plitsch!!");
  
  AddSmell( DEFAULT_SMELL,
    "Du kannst einen schwachen sauren Geruch wahrnehmen.");
    
  AddSmell(({"geruch","erbrochenes"}),
    "Der Geruch erinnert Dich irgendwie an Erbrochenes.");
}

int func_amoebe(string str) {
	
	object fackel;
	fackel=present("fackel", TP);
	
	notify_fail("Was willst Du ausleuchten?\n");
	
	if(str=="loch"||str=="in loch"||str=="loch aus"||str=="loch mit fackel aus"||
	str=="loch mit fackel"||str=="in loch mit fackel"||str=="mit fackel in loch"||
	str=="mit fackel loch aus"||str=="mit fackel loch"||str=="spalt"||
	str=="in spalt"||str=="spalt aus"||str=="spalt mit fackel aus"||
	str=="spalt mit fackel"||str=="in spalt mit fackel"||str=="mit fackel in spalt"||
	str=="mit fackel spalt aus"||str=="mit fackel spalt"||str=="spalte"||
	str=="in spalte"||str=="spalte aus"||str=="spalte mit fackel aus"||
	str=="spalte mit fackel"||str=="in spalte mit fackel"||str=="mit fackel in spalte"||
	str=="mit fackel spalte aus"||str=="mit fackel spalte") {
		
		if(!fackel) {
			
			write(BS("Du hast doch gar keine Fackel."));
			return 1;
		}
		
		if( fackel && !fackel->QueryProp(P_LIGHTED) ) {
			
			write(BS("Unangezuendet bringt Dir die Fackel wenig."));
			return 1;
		}
		
		if( fackel && fackel->QueryProp(P_LIGHTED) && SPALT->amoebepresent() ) {
			
			write(BS("Vorsichtig haeltst Du die Fackel in das duestere Loch "
			"und spaehst hinein. Tief im Loch kannst Du ein eigenartiges "
			"bewegtes Glitzern erkennen."));
			say(BS(""+TPN+" leuchtet in ein duesteres Loch."));
			return 1;
		}
		
		if( fackel && fackel->QueryProp(P_LIGHTED) && !SPALT->amoebepresent() ) {
			
			write(BS("Vorsichtig haeltst Du die Fackel in das duestere "
			"Loch, aber Du kannst nichts Verdaechtiges erkennen."));
			say(BS(""+TPN+" leuchtet in ein duesteres Loch."));
			return 1;
		}
		return 1;
	}
	return 0;
}


int func_buttersaeure(string str) {
	
	if(str=="glitzern"||str=="bewegtes glitzern"||str=="schimmern") {
		
		if(SPALT->amoebepresent()) {
			
			write(BS("Als Du das Glitzern genauer ansiehst erkennst Du "
			"deutlich eine schleimige Masse die sich bewegt."));
			say(BS(""+TPN+" schaut ganz gebannt in ein duesteres Loch."));
			call_out("schleim1", 3);
			return 1;
		}
		
		if(!SPALT->amoebepresent()) {
			
			write(BS("Die Spalte scheint leer zu sein. Du kannst nichts "
			"Auffaelliges entdecken."));
			say(BS(""+TPN+" schaut ganz gebannt in ein duesteres Loch."));
			return 1;
		}
		return 0;
	}
	return 0;
}


    
schleim1() {
	
	if(SPALT->amoebepresent()) {
		
		NIX
		write(BSL("\nDurch den Schleim laeuft ploetzlich ein Zucken.\n"
		"  !!!! ER BEWEGT SICH NUN AUF DICH ZU !!!!\n\n"));
		say(BSL(""+TPN+" zuckt erschrocken zurueck."));
		call_out("schleim2", 2);
	}
	
	else {
		write(BS("Eigenartig. Du nimmst eine fliessende Bewegung wahr, und "
		"ploetzlich ist der Schleim weg!"));
	}
}



schleim2() {
	
	if(SPALT->amoebepresent()) {
		
		NIX
		SPALT->amoebemove_amoebe();
	}
	
	else {
		write(BS("Eigenartig! Ploetzlich zieht sich der Schleim ruckartig "
		"zurueck und ist verschwunden."));
	}
}    


int func_spalt(string str) {
	
	notify_fail("In was willst Du kriechen?\n");
	
	if( str=="in loch"||str=="in spalt"||str=="in dunkelheit"||str=="durch loch"||
	str=="durch spalt"||str=="durch dunkelheit"||str=="in spalte"||
	str=="durch spalte") {
		
		write(BSL("\nDu ziehst den Kopf ein und zwaengst Dich mit einem "
		"unguten Gefuehl in den erdrueckend engen Spalt."));
		TPM("/d/dschungel/trintrasil/hoehle/room/spalt.lpc", M_GO,
		"sich muehsam in einen engen Spalt", "zwaengt", "kriecht keuchend herein");
		return 1;
	}
	return 0;
}


flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
			return 1;
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}