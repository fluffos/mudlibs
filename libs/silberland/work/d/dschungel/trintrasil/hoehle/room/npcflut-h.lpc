
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "std/room";


create()
{
  ::create();

}


flut() {
	
	int i;
	object *inv;
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()==1 ) {//da die flut hier vom kontrollraum aus ausgeloest
		                                //wird wenn noah auf 2 gesetzt ist sollte flut_aktiv nicht
		return 1;                       //1 returnen koennen
	}
	
	if( ob && living(ob) && KONTROLL->flut_aktiv()==2 ) {
		
		if(ob->QueryProp("herkunftsraum")=="fels") {
			
			tell_room("/d/dschungel/trintrasil/hoehle/room/fels-h",
			BSL("\n"+CAP(ob->name())+" schreit auf und wird vom Wasser davon "
			"gespuelt."));
		}
		
		if(ob->QueryProp("herkunftsraum")=="eingang") {
			
			tell_room("/d/dschungel/trintrasil/hoehle/room/eingang1-h",
			BSL("\n"+CAP(ob->name())+" schreit auf und wird vom Wasser davon "
			"gespuelt."));
		}
		
		if( !ob->QueryProp(P_NOCORPSE) ) {
			
			call_out("leiche_move", 2);
		}
		ob->die();
		
		call_out("flut", random(3));
	}
	
	if( ob && living(ob) && KONTROLL->flut_aktiv()==0 ) {//flut vorbei
	
		inv=all_invetory(TO);
		
		for(i=sizeof(inv)-1;i>=0;i--) {
			
			if( living(inv[i]) ) {
				
				inv[i]->die();
			}
		}
		call_out("entleerung", 1);
		return 1;
	}
	
	if( ob && !living(ob) ) {
		
		ob->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_TPORT+ 
		M_SILENT);
		tell_room(ENV(ob), BSL("\n"+capitalize(ob->name(WER, 0))+" wird "
		"auf den Felsblock gespuelt."));
		call_out("flut", 1);
	}
}


leiche_move() {
	
	object leiche;
	leiche=present("leiche", TO);
	
	if(leiche) {
				
		leiche->move("/d/dschungel/trintrasil/fluss/room/dfluss4",
		M_TPORT+ M_SILENT);
		tell_room( ENV(leiche), BSL("\n"+capitalize(leiche->name(WER, 0))+" "
		"wird auf den Felsblock gespuelt."));
	}
}


entleerung() {
	
	object ob;
	ob=first_inventory(TO);
	
	if( ob ) {
		
		ob->move("/d/dschungel/trintrasil/fluss/room/dfluss4",
		M_TPORT+ M_SILENT);
		tell_room(ENV(ob), BSL("\n"+CAP(ob->name(WER, 0))+" wird auf den Felsblock "
		"gespuelt."));
		call_out("entleerung", random(3));
	}
	
	if(!ob) {
		
		return 1;
	}
}