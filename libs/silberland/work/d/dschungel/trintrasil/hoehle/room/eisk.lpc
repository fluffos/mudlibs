//fertig und getestet

inherit "std/food";
#include <properties.h>
#include <food.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

int n=1;

create()
{
	
 if (!is_clone(this_object())) return; 

::create();


 SetProp(P_SHORT, "Eisknoedel");
 SetProp(P_LONG, BS("Auf Deinem Teller liegt ein kalter, grosser Eisknoedel. Er scheint "
 "aus Vanilleeis zu bestehen, was er innen enthaelt siehst Du wenn Du ihn ist. Aussen ist "
 "er mit kleinen Haselnussstuecken bestreut."));
 SetProp(P_GENDER, MALE);
 SetProp(P_WEIGHT, 70);
 SetProp(P_VALUE, 350);
 AddId(({"eisknoedel","knoedel","eis","PB_PERMISSION"}));
 SetProp(P_NAME, "Eisknoedel");
 SetProp(P_MATERIAL, MAT_ICE);

 AddCmd(("iss"), "func_eis");
 
}

int func_eis(string str) {
	
	object teller;
	string subj;
	
	subj=TP->QueryProp(P_NAME);
	
	if(str=="eisknoedel","knoedel","eis") {
		
		if(n==1) {
			write(BS("Du stichst mit dem Loeffel ein Stueck aus dem kalten, "
			"chremigen Vanilleknoedel und laesst es geniesserisch auf der Zunge "
			"schmelzen."));
			say(BS(""+TPN+" isst geniesserisch einen Eisknoedel."));
			this_player()->heal_self(5);
			n++;
		return 1;}
		
		if(n==2) {
			write(BSL("Mh, Du laesst Dir ein weiteres Eisstueck auf der Zunge "
			"zergehen und kaust die knackigen Nusssplitter."));
			say(BS(""+TPN+" isst einen Eisknoedel und schmatzt dabei etwas "
			"unanstaendig!"));
			this_player()->heal_self(3);
			n++;
		return 1;}
		
		if(n==3) {
			write(BSL("Du stichst ein Stueck aus der Mitte des Knoedels und "
			"dringst zur orangen Marilleneismarmelade vor. Die fruchtige, suesse "
			"Marmelade schmeckt gut zum chremigen Vanilleeis."));
			say(BS(""+TPN+" isst einen Eisknoedel und kleckert sich mit Marmelade "
			"voll."));
			this_player()->heal_self(3);
			n++;
		return 1;}
		
		if(n==4) {
			write(BSL("Du nimmst das letzte Stueck Eis auf den Loeffel und laesst "
			"es in Deinem Mund langsam schmelzen. Du schaust ob gerade niemand her "
			"sieht und leckst dann schnell das restliche Eis, Nusssplitter und "
			"Marmelade vom Teller."));
			say(BS(""+TPN+" leckt seinen Teller ab! Auch wenn "+TPN+" es "
			"verheimlichen wollte, Du hasts gesehen!"));
			this_player()->heal_self(3);
			teller=clone_object("/d/dschungel/trintrasil/fluss/obj/teller");
			teller->move(this_player(), M_NOCHECK);
			teller->set_eater(subj);
			TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_SILENT);
			TO->remove();
		return 1;}
	return 1;}
	
	if(!str) { return 0;}
return 0;}

		
			 
