    TP->do_damage(60+random(40));    
   
   call_out("flut8", 2);
     }
    
   
      
   flut8() {
   NIX
   Z
   write(BS(
    "In rasender Geschwindigkeit reissen Dich die Wassermassen durch die Hoehle!!"));
   call_out("flut9", 2);
     }
 
    
   flut9() {
   
     NIX
     Z
     
     write(BS(
     "Du schlaegst mit dem Schaedel gegen den Fels!!"));
     TP->do_damage(30+random(20));  
      
   call_out("flut9a", 1);
     }
 
 
 
   flut9a() {
   	
   int i;
   object *inv;
   inv=all_inventory(TO);
   
   for(i=sizeof(inv)-1;i>=0;i--) {
   	
   if(!living(inv[i])) {
   	
     inv[i]->move("/d/dschungel/trintrasil/hoehle/room/eingang", M_GO+ 
                 M_SILENT+ M_NO_SHOW);  }
       }
       
   call_out("flut10", 1);
     }
      
   
   
   flut10() {
   NIX
   Z
   write(BS("Du wirst von der reissenden Flut brutal durch die Hoehle "
            "gewirbelt."));
   call_out("flut11", 2);
     }
   
   

   flut11() {
   NIX
   Z
   write(BS("Du wirst gegen die Waende geschleudert. Wasser schiesst in Deinen "
            "sich erschrocken japsend oeffnenden Mund."));
   call_out("flut12", 2);
     }
   
   	 
      
   flut12() {
   NIX
   Z
   write(BS(
   "Das Wasser spuelt Dich aus der Hoehle. Zerschlagen schnappst Du nach Luft."));
   call_out("flut13", 1+random(3));
     }
   
   
   
   flut13() {
   
     NIX
     Z
     write(BS(
     "Du kannst gerade noch verhindern das Dich die Wassermassen ganz aus der "
     "Hoehle durch einen Wasserfall in den ´Rio de la Puseta´ spuelen, in dem "
     "Du wie eine Ratte ersoffen waerst."));   
     
     tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
               ""+TPN+" wird hereingespuelt.\n\n");
     
     TP->move("/d/dschungel/trintrasil/hoehle/room/eingang", M_GO+ M_NO_SHOW+
                  M_SILENT); 
     H(eingang)
     RemoveCmd("", "njet");
     AddCmd("", "no", 1); 
  } 
    
  
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/hoehle/room/eingang",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  