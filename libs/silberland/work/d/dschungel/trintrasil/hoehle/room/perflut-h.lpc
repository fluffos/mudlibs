
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";


create()
{
  ::create();

  SetProp( P_INT_SHORT, "kurz vor dem Ertrinken" );
  SetProp( P_INT_LONG, BS(
  "Ex oder nie mehr Sex!"));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  SetProp(P_KILL_NAME, "gewaltige Wassermassen", PLURAL);  
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no()
 {
   write (
   "Oh mein Gott!! WAS GEHT HIER VOR???\n");
     return 1;
   }
     
  int njet()
  {
    write("!!DU WIRST ERTRINKEN!!\n");
      return 1;
    }
    
    
  init()
  {::init();

  if(query_once_interactive(this_player())){
  call_out("flut1", 2);}
  }
  

   flut1() {
    
   NIX
   Z
   write(BS(
   "Du hoerst ein eigenartiges Rumpeln."));
   call_out("flut2", 3);
     }
   
   
    
   flut2() {
   
   NIX
   Z
   write(BS(
   "Du hoerst ein Krachen und ein gewaltiges Rauschen das schnell anschwillt!!"));
   call_out("flut3", 3);
     }
 
 
    
   flut3() {
   
   NIX
   Z
   write(BS(
   "Die gesamte Hoehle vibriert wie bei einem Erdbeben."));
   call_out("flut4", 3);
     }
 
    
   
   flut4() {
   
   NIX
   Z
   RemoveCmd("", "no");
   AddCmd("", "njet", 1);
   
   write(BS(
   "Ploetzlich bricht eine gewaltige Wasserwand durch den Illusionszauber "
   "im nordosten!!!"));
   call_out("flut5", 3);
     }
   
   
        
   flut5() {
   
   NIX
   Z
   write(BS(
   ""+ANSI_BLUE+"!!!WWWWWWWWWWUUUUUUUUUUUUUUUMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"
                "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!"+ANSI_NORMAL+""));
   call_out("flut6", 3);
     }
    
   flut6() {
   
   NIX
   Z
   write(BS(
    "Die Wassermassen knallen Dich gegen die verschlossene Metalltuer und reissen "
    "Dich mit!!!"));
   TP->do_damage(20+random(15));
   
   call_out("flut7", 2);
     }
 
 
    
   flut7() {
   
     NIX
     Z      
     write(BS(
    "Du willst in dem gewaltigen Tosen schreien, aber das Wasser zerquetscht "
