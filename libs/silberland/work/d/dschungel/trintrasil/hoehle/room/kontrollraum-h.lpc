
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define NPCFLUT "/d/dschungel/trintrasil/hoehle/room/npcflut-h"

inherit "/std/room";



int noah=0; //int die aus anderen raeumen abgefragt wird um fest zu stellen ob die flut laeuft



reset()  {
	::reset();
	clean_room();
}



clean_room() {//in diesen raum werden teilweise npc gemove die removed gehoeren. hat das aus 
              //irgendeinem grund nicht funktioniert, sollen sie beim reset removed werden.

        object *all;	
	int i;
	all=all_inventory(TO);	

	if(!sizeof(all)) return;

	for(i=0; i<sizeof(all); i++ )  {
		
		if(!interactive(all[i]) ) {
			
			tell_room(TO, ""+all[i]->Name()+" wurde massakriert!\n");
			all[i]->remove();
		}
	}
}


	 
void create()
{
  ::create();

SetProp( P_SHORT, "Im galaktischen Kontrollraum" );
SetProp( P_LONG, break_string(
"Dieser Raum erfuellt die Funktion des Flutmasters. gleichzeitig wird er als "
"npc-Entsorgungsstelle verwendet. Weder eine Long noch Details sind hier "
"ABSOLUT unverzichtbar."));
SetProp("kontrollraum", 1);
SetProp( P_LIGHT, 1 );

}


flut(object verursacher) {
	
	noah=1;
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14",
	BSL("\nEin eigenartiges Rumpeln hallt durch das Becken."));
	tell_room("/d/dschungel/trintrasil/fluss/room/hoehle",
	BSL("\nEin eigenartiges Rumpeln ertoent aus dem hinteren Teil der "
        "Hoehle."));
        tell_room("/d/dschungel/trintrasil/fluss/room/fluss10",
        BSL("\nEin eigenartiges Rumpeln hallt durch die Schlucht."));
        
        call_out("flut1", 2);
}


flut1() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nEin unheilvolles "
	"Stoehnen laeuft durch die gesamte Hoehle."));
	call_out("flut2", 3);
}


flut2() {
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nEin gewaltiges "
	"Donnern ertoent vom Wasserfall her."));
	tell_room("/d/dschungel/trintrasil/fluss/room/hoehle", BSL("\nPloetzlichen "
	"schiessen gewaltige Wassermassen aus dem hinteren Teil der Hoehle."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10",
	BSL("\nVon den Felstuermen am oestlichen Uferrand kommt ein gewaltiges Rauschen."));
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\n!!!Aus der "
	"Hoehle jenseits der Stahltuer hoerst Du ein gewaltiges Rumpeln!!!"));
	call_out("flut3", 3);
}


flut3() {
	
	noah=2;
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nDir kommt vor als "
	"wuerde ploetzlich weniger Wasser ueber den Wasserfall herabrinnen."));
	tell_room("/d/dschungel/trintrasil/fluss/room/hoehle",
	BSL("\nDein Fisch baeumt sich entsetzt auf!!!!!!"));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10", BSL("\nVon den oestlichen "
	"Felstuermen her scheint ploetzlich eine eigenartige Stroemung zu kommen!!"));
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", 
	BSL("\n"
	"  !!!!!!!!WWWWWWWWWWWWWWWWWWWWWWWWWWWW!!!!!!!!\n"
	"  !!!!!!!!UUUUUUUUUUUUUUUUUUUUUUUUUUUU!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"
        "\nEIN GEWALTIGER SCHLAG ERSCHUETTERT DIE STAHLTUER!"));
        call_out("flut4", 2);
}


flut4() {
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nWas dieses "
	"unheimliche Getoese wohl ausgeloest hat. Hier scheinst Du jedenfalls "
	"sicher zu sein."));
	tell_room("/d/dschungel/trintrasil/fluss/room/hoehle",
	BSL("\nDein Fisch laesst sich bei diesem Getoese und der Stroemung "
	"der hereinschiessenden Wassermassen nicht mehr baendigen und flieht "
	"hinaus auf den Rio de la Puseta!!"));
	call_other("/d/dschungel/trintrasil/fluss/room/hoehle", "flucht");
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10", BSL("\nDu erkennst nun, "
	"dass mit einem hektischen Rauschen weiss schaeumende Wassermassen hinter den "
	"oestlichen Felstuermen in den Rio de la Puseta fliessen."));
        
        tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDu zuckst "
        "erschrocken zusammen, in der Befuerchtung dieser gewaltige "
        "Schlag koennte sogar diese massive Stahltuer eindruecken!!!"));
        call_out("flut5", 3);
}


flut5() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDie Tuer stoehnt "
	"und aechzt. Die gesamte Hoehle ist von einem gewaltigen Rauschen und Brausen "
	"erfuellt!!"));
	call_out("flut6", 3);
}


flut6() {
	
	NPCFLUT->flut();
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDie ganze Hoehle "
	"kracht und vibriert wie bei einem Erdbeben!!"));
	call_out("flut7", 3);
}
flut7() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nStaub und kleine "
	"Steinchen rieseln von der Decke!!"));
	call_out("flut8", 3);
}


flut8() {
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nDas unheimliche "
	"Rumpeln dauert an, nervoese Nektarzuengler flattern hektisch umher."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10", BSL("\nHinter den oestlichen "
	"Felstuermen scheint eine Hoehle zu sein aus der ploetzlich gewaltige "
	"Wassermassen schiessen."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDu glaubst in dem "
	"krachenden Getoese ein Splittern und irres Kreischen zu hoeren."));
	call_out("flut9", 3);
}


flut9() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDie gesamte Hoehle "
	"jenseits der Sicherheitstuer ist unter Wasser gesetzt, und mit ziemlicher "
	"Sicherheit wurde alles getoetet, was sich in ihr befand!"));
	call_out("flut10", 3);
}


flut10() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nWer soll die Schleuse "
	"eigentlich wieder schliessen?"));
	call_out("flut11", 3);
}


flut11() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nVielleicht bist Du "
	"jetzt in der Hoehle eingesperrt. Du hast keine Ahnung wie man die Schleuse "
	"verschliesst."));
	call_out("flut12", 3);
}


flut12() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nSolange solche "
	"Wassermassen aus der Hoehle stuerzen kommst Du hier nicht weg."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", //soll in pilzhoehle tellen
	BSL("\nDas gewaltige Tosen und Brausen in der Hoehle dauert an."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nSolange solche "
	"Wassermassen aus der Hoehle stuerzen kommst Du hier nicht weg."));
	call_other("/d/dschungel/trintrasil/hoehle/room/amoebe-h", "flut");
	call_out("flut13", 4);
}


flut13() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDie krachende, "
	"donnernde Flut dauert ungemindert an."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9",
	BSL("\nHoffentlich ist jemand da, der die Schleuse verschliesst."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDie krachende, "
	"donnernde Flut dauert ungemindert an."));

	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nDas Becken vibriert "
	"wie bei einem Erdbeben."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10",
	BSL("\nDie Schlucht vibriert wie bei einem Erdbeben."));
	call_out("flut14", 3);
}


flut14() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nEin Schwall "
	"Wasser schwappt ueber Dich hinweg."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nErschrocken "
	"siehst Du wie Wasser unter der Tuer hervorsickert."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nEin Schwall "
	"Wasser schwappt ueber Dich hinweg."));
	call_out("flut15", 3);
}


flut15() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDu wagst Dich "
	"kaum zu bewegen aus Angst Du koenntest in die reissenden Fluten stuerzen."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDie Hoehle "
	"summt von den gewaltigen Wassermassen wie ein Bienenstock."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDu wagst Dich kaum "
	"zu bewegen aus Angst Du koenntest in den Fluss gespuelt werden."));
	call_out("flut16", 3);
}


flut16() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDu klammerst Dich "
	"an Deinen nassen Fels und blickst in die unter Dir stroemenden Fluten."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nHoffentlich haelt "
	"die schwere Eisentuer dem Wasserdruck stand."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDu klammerst Dich an "
	"Deinen nassen Fels und schliesst die Augen, die Dir vom aus der Spalte "
	"schiessendem Wasser brennen."));
	call_out("flut17", 3);
}


flut17() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDie Wassermassen "
	"reissen Truemmer und Splitter der Ueberschwemmung mit sich."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nWelche Zerstoerung "
	"die Ueberschwemmung wohl vor der Sicherheitstuer angerichtet hat."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDie Wassermassen "
	"reissen Truemmer und Splitter der Ueberschwemmung mit sich."));
	call_out("flut18", 3);
}


flut18() {
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nVORSICHT! Du waerst "
	"beinahe abgerutscht und in die Fluten gefallen.\nDa waerst Du sicher jaemmerlich "
	"ersoffen."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDie Wassermassen "
	"poltern und krachen weiterhin gegen die schwere Eisentuer."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nVORSICHT! Du waerst "
	"beinahe abgerutscht und in die Fluten gefallen.\nDort waerst Du sicher jaemmerlich "
	"ersoffen."));
	call_out("flut19", 3);
}


flut19() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDas Rumoren in der "
	"Hoehle aendert sich.\nIrgendetwas scheint sich zu tun."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDas Rumoren jenseits "
	"der Hoehle veraendert sich. Irgendetwas scheint sich zu tun."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDas Rumoren jenseits "
	"der Hoehle veraendert sich.\nIrgendetwas scheint sich zu tun."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nDas Getoese vom "
	"Wasserfall her scheint abzunehmen."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10", BSL("\nDie rauschende "
	"Stroemung von den Felstuermen her scheint abzunehmen."));
	call_out("flut20", 3);
}


flut20() {
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDu hoffst nur, dass "
	"nicht noch eine Katastrophe passiert."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDas Rumpeln "
	"geht zurueck. Anscheinend schliesst irgendjemand die Schleuse."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDu hoffst nur, dass nicht "
	"noch eine Katastrophe passiert."));
	call_out("flut21", 3);
}


flut21() {
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDer Wasserstrom nimmt "
	"ploetzlich schnell ab."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDas Tosen und Brausen "
	"nimmt schnell ab."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDer Wasserstrom nimmt "
	"ploetzlich schnell ab."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nEs kommt Dir so vor, "
	"als wuerde ploetzlich wieder viel mehr Wasser ueber den Wasserfall in das Becken "
	"fliessen."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10", BSL("\nDas Rauschen ebbt ab "
	"und verstummt schliesslich ganz."));
	call_out("flut22", 3);
}


flut22() {

	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDer Wasserstrom aus "
	"der Hoehle geht nun ganz zurueck. Du muesstest sie nun wieder gefahrlos "
	"betreten koennen."));
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\nDer Wasserstrom aus der "
	"Hoehle geht nun ganz zurueck. Du muesstest nun wieder gefahrlos in den Spalt "
	"kriechen koennen."));
	
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("\nDas Rauschen in der "
	"Hoehle verstummt nun ganz. Du koenntest die Stahltuer wieder gefahrlos "
	"oeffnen."));
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nEs scheint nun wieder "
	"alles normal zu sein."));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss10", BSL("\nEs scheint nun wieder "
	"alles normal zu sein."));
	
	noah=0;
	
	call_other("/d/dschungel/trintrasil/hoehle/room/hoehle7", "resetfunc");//richtet stamm 
	                                                                       //wieder auf
}



flut_aktiv() {
	
	return noah;
}