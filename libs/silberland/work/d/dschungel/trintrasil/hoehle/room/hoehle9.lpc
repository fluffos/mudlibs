
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";

#define HOEHLE8 "/d/dschungel/trintrasil/hoehle/room/hoehle8.lpc"
#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"
#define HOEHLE7 "/d/dschungel/trintrasil/hoehle/room/hoehle7.lpc"
#define PILZRAUM "/d/dschungel/trintrasil/hoehle/room/hoehle10.lpc"


reset() {
  ::reset();
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer grossen Hoehle" );
  SetProp( P_INT_LONG, break_string(
"Du befindes Dich in einer grossen, gewoelbeartigen Hoehle. Im Westen siehst Du einen "
"kleinen Teich, um den grosse, langstielige Pilze wachsen, die ein goldgelbes, "
"dumpfes Licht ausstrahlen. In der nordoestlichen Sandsteinwand befindet sich eine "
"massive Stahltuer. Direkt daneben ist ein eisernes Handrad in die Wand eingelassen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 

AD(({"hoehle"}),
"Die Hoehle ist unfoermig und schlaengelt sich weit nach Westen. Sie ist aber viel "
"breiter als der Gang nach Nordosten und erinnert an ein Gewoelbe.");

AD(("gewoelbe"),
"Die sanft gewellte Decke ist ca 3 bis 4 Meter ueber Dir, wie in einem hohen "
"Kellergewoelbe.");

AD(("kellergewoelbe"),
"Von hier aus siehst Du nicht wie weit sich die breite Hoehle nach Westen windet.");

AD(("decke"),
"Die Decke besteht aus gelben Sandstein und ist wellig poliert. Gleich wie in der "
"uebrigen Hoehle wurde auch hier das Gestein vom Wasser ausgeschwemmt.");

AD(("wasser"),
"Die Waende schimmern feucht. Viele feine, kleine Rinnsale rinnen die Waende hinab. "
"Im Westen siehst Du sogar einen kleinen Teich.");

AD(("rinnsale"),
"Die feinen Rinnsale sind oft nur fingerbreit.");

AD(("teich"),
"Wenn Du nach Westen gehen wuerdest koenntest Du den Teich und die Pilze aus der Naehe "
"bewundern.");

AD(("naehe"),
"Im Westen wuerdest Du direkt am Teich stehen.");

AD(({"leuchtpilze","leuchtpilz","pilze","pilz","meter"}),
"Das eigentuemliche Licht kommt von den langstieligen Pilzen. Sie sind ca "
""+PILZRAUM->return_height()+" Meter gross und fluoreszieren goldgelb.");

AD(({"stiel","stiele"}),
"Die Stiele sind nur armdick, biegen sich aber ca 2 Meter in die Hoehe.");

AD(("hoehe"),
"Die Stiele wirken zerbrechlich. Aber im Westen koenntest Du die Pilze genauer "
"betrachten.");

AD(("licht"),
"Das Licht ist ziemlich schwach, aber es genuegt die ganze Hoehle in einen gelben Schimmer "
"zu tauchen.");

AD(("schimmer"),
"Die weiten Schirme der Pilze strahlen den gelben Schein aus.");

AD(({"schirm","schirme","schein"}),
"Die Pilze befinden sich im Westen. Geh hin wenn Du sie genau untersuchen willst.");

AD(("westen"),
"Du kannst jederzeit nach Westen zum Teich gehen.");

AD(({"gestein","sandstein","stein"}),
"Die Waende dieser Hoehle bestehen aus gelbem, nass schimmernden Sandstein.");

AD(({"sandsteinwaende","steinwaende","hoehlenwaende","waende","sandsteinwand","steinwand",
"hoehlenwand","wand"}),
"Die Hoehlenwaende sind vom Wasser glatt poliert und schlaengeln sich weich und "
"rund nach Westen.");
  
AD(({"boden","sand","schwemmsand"}),
"Der Boden ist mit dem gleichen feinen Schwemmsand wie in der uebrigen "
"Hoehle bedeckt.");     

AD(("plaetschern"),
"Das Plaetschern kommt aus Westen.");

AD(("druck"),
"Was kann so einen Druck erzeugen, damit so eine massive Tuer notwendig ist?");

//special
ASD(({"faust","rote faust","bild"}),
"faustbild");

ASD(({"schieber","tuerschieber","kopfhoehe"}),
"schieber");

ASD(("gang"),
"gang");

AD(({"rad","handrad"}),
"Du kannst ja versuchen am Rad zu drehen. Es ist nicht erkennbar wozu es dient.");

ASD(("hebel"),
"hebel");
//ende


  AddCmd(({"schau","spaehe"}), "func_tuerschieber");
  AddCmd(({"drehe","dreh"}), "func_wasser");//loesst flut aus
  AddCmd(("test"), "test_schieber");

  
  AddExit("westen", "./hoehle10");


  AddSound( DEFAULT_SOUND,
    "Im Westen hoerst Du ein bestaendiges Plaetschern.");
  
  AddSound(("plaetschern"),
  BSL("  ! PLITSCH !\nplatschplatsch\n     PLITSCH\n PLITSCH\nIm Westen rinnt Wasser "
  "von der Decke in einen Teich."));
  
  AddSound(("stimmen"),
    "Geh doch hin wenn es Dich interessiert."); 
 

NewDoor("nordosten","./hoehle8",({"tuer","metalltuer","eisentuer","stahltuer","panzertuer","tuere"}),
({D_FLAGS, DOOR_OPEN | DOOR_RESET_OP,
  D_LONG, BS("Innenseite ist ein Hebel angebracht. Sie sieht aus als sollte "
  "sie grossem Druck von aussen standhalten koennen. Mitten auf der Tuer "
  "prangt eine rote Faust. Auf Kopfhoehe ist ausserdem ein Tuerschieber "
  "eingebaut."),
  D_SHORT,"Eine %se Stahltuer\n",
  D_NAME,"Stahltuer",
  D_GENDER, FEMALE,
  D_OPENTESTFUNC, "func_oeffnen",
  D_CLOSETESTFUNC, "func_schliessen",
  D_MSGS, ({"durch die Stahltuer","geht","kommt durch die Tuer herein"}) 
  }) );
}
  

mixed test_schieber(/*string namenarray*/) {
	string *fucker;
	
	fucker=HOEHLE8->schieber_func();
	
	
	
	tell_room(ENV(TP), fucker);
	return 1;
}

func_oeffnen() {
	
	if( KONTROLL->flut_aktiv()>0 ) {
		
		write(BS("Bist Du wahnsinnig? Wenn Du jetzt die Tuer oeffnest "
		"ueberflutest Du die gesamte Hoehle!"));
		say(BS("Du solltest Dir sorgen machen. "+TPN+" ruettelt an der "
		"Tuer herum. Wenn er sie jetzt oeffnet, flutet er die Hoehle und "
		"bringt euch um!"));
		return 1;
	}
	
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
		
		write(BS("Die Tuer ist ja garnicht verschlossen!"));
		say(BS(""+TPN+" ist anscheinend schwer verwirrt und ruettelt an der "
		"offenen Stahltuer."));
		return 0;
	}
	
	else {
		write(BSL("Du legst den Hebel um und ziehst mit aller Kraft an der schweren "
		"Stahltuer.\n ! QUIIIEEETSCHH !"));
      	        say(BSL(""+TPN+" legt den Tuerhebel um und zieht mit aller Kraft an der "
      	        "schweren Stahltuer.\n ! QUIIIEEETSCHH !"));
      	        tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle8",
      	        BS(" ! QUIIIEEETSCHH !"));
      	        return 0;
      	}
}

func_schliessen() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		write(BSL("Du stemmst Dich gegen die schwere Stahltuer.\n"
		" ! RUUMMMS !\nDie Tuer schliesst sich. "
		"Mit einem Umlegen des Hebels verriegelst Du die Tuer."));
		say(BSL(""+TPN+" stemmt sich gegen die schwere Stahltuer.\n"
		" ! RUUMMMS !\nDie Tuer schliesst sich. "
		""+TPN+" legt den Hebel um und verriegel so die Tuer."));
		tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle8",
		BSL(" ! RUUMMMS !\nEine Stahltuer wird von der anderen Seite "
		"geschlossen."));
		DOOR_MASTER->SetDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8", -1);
		return 1;
	}
	
	else {
		write(BS("Schau doch die Tuer ist ja schon verschlossen."));
		say(BS(""+TPN+" ruettelt eigenartigerweise an der Tuer."));
		return 1;
	}
} 


int func_tuerschieber(string str) {
	
	if(str=="durch tuerschieber"||str=="durch schieber"||str=="durch guckloch"||
	str=="tuerschieber"||str=="schieber"||str=="guckloch") {
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
			
			write(BS("Wozu willst Du durch den Tuerschieber schauen? Die "
			"Stahltuer ist offen. Du siehst auch so in den Gang."));
			return 1;
		}
		
		else {
			
			if(HOEHLE8->objekte_im_gang()==0) {
				
				write(BSL("Du spaehst durch den Tuerschieber. Siehst aber "
				"auf der anderen Seite nur den leeren Gang."));
				return 1;
			}
			
			if(HOEHLE8->objekte_im_gang()==1) {
				write(BSL("Du spaehst durch den Tuerschieber und siehst "
				"den Gang, in dem sich "+HOEHLE8->schieber_func()+" "
				"befindet."));
				return 1;
			}
			
			else {
				write(BSL("Du spaehst durch den Tuerschieber. Im Gang auf der "
				"anderen Seite befinden sich: \n"));
				HOEHLE8->schieber_func();
				return 1;
			}
		}
	}
	
	else {
		return 0;
	}
}

//§§§§§§§§§§§§§§§§§§§§§§§§§§§§§ SPECIAL DETAILS ANFANG §§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§

hebel() {
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BS("Der Hebel auf der Stahltuer dient dazu die Tuer fest zu "
		"verschliessen."));
	}
	
	else {
		return(BS("Die Tuere ist geschlossen und der Hebel nach unten gedrueckt."));
	}
}

	
schieber() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BS("Durch den Tuerschieber kannst Du schauen, ob sich wer im "
		"Gang befindet, wenn die Tuer geschlossen ist."));
	}
	
	else {
		return(BS("Wenn Du durch den Tuerschieber schaust, erkennst Du, ob "
		"sich wer im Gang hinter der Tuer befindet."));
	}
}


faustbild() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BSL("\n\n"
		"        _______\n"
		"       | | | | |_\n"
		"       |_| | | | |\n"
		"        ||_|_|_| |\n"
		"        |        /\n"
		"         \\   ___/\n"
		"          | || |\n"
		"          | || |\n\n\n"));
	}
	
	else {
		return(BS("Die Stahltuer ist jetzt geschlossen. Das Bild der Faust befindet "
		"sich auf der anderen Seite."));
	}
}


gang() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BS("Hinter der Stahltuer liegt ein Gang, der nach Nordosten "
		"fuehrt."));
	}
	
	else {
		return(BS("Die Tuer ist geschlossen. Wenn Du durch den Tuerschieber spaehst, "
		"koenntest Du in den Gang sehen."));
	}
}
	
//§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§ SPECIAL DETAILS ENDE §§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§



//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~ Die FLUT ANFANG ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

int func_wasser(string str) {
	
	object verursacher;
	
	notify_fail("Was willst Du drehen?\n");
	
	if(str=="rad"||str=="handrad"||str=="an rad"||str=="an handrad"||
	str=="am rad"||str=="am handrad") {
		
		if( KONTROLL->flut_aktiv()!=0 ) {
			
			write(BS("Die Hoehle ist immer noch unter Wasser. Du kannst doch "
			"nicht schon wieder am Handrad herumdrehen."));
			return 1;
		}
		
		if( KONTROLL->flut_aktiv()==0 && 
		DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1 ) {
			
			write(BSL("Du hoerst nur ein Klicken in der Wand, aber das Rad laesst "
			"sich nicht drehen.\nAnscheinend ist es irgendwie gesichert. Du musst "
			"vorher noch etwas machen."));
			say(BSL(""+TPN+" versucht am Handrad zu drehen, anscheinend ist es "
			"aber irgendwie gesichert."));
			return 1;
		}
		
		if( KONTROLL->flut_aktiv()==0 &&
		DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")!=1 &&
		HOEHLE7->baum_status()==1 ) {
			
			write(BS("Du drehst muehsam das Rad und hoerst ein leises Rasseln. "
			"Irgendetwas scheint den Mechanismus aber zu verklemmen. Du musst "
			"vorher noch etwas machen bevor Du ihn ganz betaetigen kannst."));
			say(BS(""+TPN+" dreht am Handrad aber es scheint nichts zu "
			"passieren."));
			tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle7",
			BSL("\n  !KNIRRSSCCHHH!\nDie Metallplatte ober Dir schien sich "
			"zu bewegen. Gottseidank wird sie vom Baumstamm gestuetzt."));
			return 1;
		}
		
		else {
			verursacher=TP;
			
			write(BSL("\nDu drehst am Handrad und hoerst wie sich der Mechanismus "
			"in Gang setzt."));
			say(BSL("\n"+TPN+" dreht am Handrad und Du hoerst wie sich ein "
			"Mechanismus in Gang setzt."));
			
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle7", "fluttod");
			
			call_other("/d/dschungel/trintrasil/hoehle/room/eingang", "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/spalt", "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/fels", "flut");
			
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle1", "flut");//func flut in ges hoehle
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle2", "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle3", "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle4", "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle5", "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle6", "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/amoebe",  "flut");
			call_other("/d/dschungel/trintrasil/hoehle/room/hoehle8", "flut");
			
			call_other("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", "flut", verursacher);
			return 1;
		}
	}
}	   