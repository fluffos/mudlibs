
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";


reset() {
::reset();
}


void create() {
	
::create();

SetProp( P_INT_SHORT, "In einer Hoehle" );

SetProp( P_INT_LONG, break_string(
"Du stehst in einem Gang, der nach Suedwesten durch eine massive Stahltuer "
"in eine grosse, helle Hoehle fuehrt. Die nordoestliche Wand schimmert blass "
"und ist leicht durchscheinend. Die Felswaende sind hier geglaettet und "
"begradigt."));

SetProp( P_LIGHT, 1 );
SetProp( P_INDOORS, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"hoehle"}),
    "Du kannst die Ausmasse der Hoehle von hier aus nicht einsehen. Sie ist von einem "
    "seltsam schummrigen Licht erfuellt.");
  
  AD(({"masse","ausmasse","ende"}),
    "Du kannst von hier aus kein Ende der Hoehle im Suedwesten erkennen. Du kannst sie "
    "aber durch die Tuere betreten. Dann siehst Du mehr.");
    
  AD(({"licht"}),
    "Das Licht ist sehr schwach, mehr ein schummriges Schimmern. Du kannst die "
    "Lichtquelle von hier aus nicht sehen, es ist aber sicher kein Feuer.");
    
  AD(({"schimmern","feuer"}),
    "Das Licht eines Feuers wuerde flackern. Das Licht ist aber gleichmaessig und "
    "ruhig.");
     
  AD(({"quelle","lichtquelle"}),
    "Um die Lichtquelle zu erkennen musst Du die Hoehle betreten. Hoffentlich ist "
    "es nicht gefaehrlich.");
    
  AD(({"felswaende","waende","sandsteinwaende","wand"}),
    "Die gelben Sandsteinwaende sind geglaettet. Dieser Teil der Hoehlen wird "
    "anscheinend oefter von jemanden benutzt. Sonst waere hier wohl auch kaum eine "
    "Stahltuer."),
    
  AD(({"teil","jemand"}),
    "Sehr seltsam. Was dieser oder diese Unbekannte wohl in dieser Hoehle suchen?");
  
  AD(("gang"),
    "Der Gang in dem Du stehst ist nur wenige Meter lang. Nach Nordosten fuehrt er "
    "durch einen Illusionszauber weiter und nach Suedwesten fuehrt er durch eine "
    "Tuer in eine grosse Hoehle.");
    
  AD(({"unbekannter","unbekannte"}),
    "Wahrscheinlich sind es mehrere Personen. Sie haben einen ziemlichen Aufwand "
    "betrieben diese Stahltuer hier einzubauen und den Zugang zu verbergen.");
    
  AD(({"person","personen","er","sie"}),
    "Wer auch immer diese Stahltuer eingesetzt hat. Er oder Sie wollen anscheinend "
    "moeglichst unentdeckt bleiben.");
    
  AD(("aufwand"),
    "Eine so schwere, dicke Stahltuer in einer weit abgelegenen Hoehle ist sehr "
    "verdaechtig.");
    
  AD(("stahl"),
    "Die Tuer ist aus massivem, harten Stahl. Du erkennst ein paar Rostflecken, "
    "was bei der hohen Feuchtigkeit in der Hoehle aber nicht verwunderlich ist."
    "Auf der Aussenseite der Tuer prangt eine grosse rote Faust. Auf Kopfhoehe "
    "befindet sich ein Tuerschieber.");
  
  AD(({"kopfhoehe","hoehe","schieber","tuerschieber"}),
    "Wenn die Tuere verschlossen ist, kann von Innen durch den Tuerschieber sehen, "
    "ob jemand davor steht.");
    
  AD(("innen"),
    "Du befindest Dich Aussen.");
      
  AD(({"fleck","rostfleck","flecken","rostflecken","rost"}),
    "Wenn man bedenkt wie feucht es in der Hoehle ist, befindet sich sehr wenig Rost "
    "auf der Tuer.");
  
  AD(({"feuchtigkeit","feuchte"}),
    "Nahezu ueberall in der Hoehle plaetschert irgendwo Wasser die Waende herunter.");

  AD(("wasser"),
    "Der kurze Gang hier ist recht trocken. Aber aus der Hoehle im Suedwesten "
    "hoerst Du ein Plaetschern.");


  ASD(("knauf"),
  "knauf");
  
  ASD(("aussen"),
  "aussen");

  ASD(("aussenseite"),
  "aussenseite");

  ASD(("innenseite"),
  "innenseite");
  
  ASD(({"hebel"}),
  "hebel");
    
          
  AD(({"faust","rote faust"}),
    BSL("\n"
    "\n"
    "        _______\n"
    "       | | | | |_\n"
    "       |_| | | | |\n"
    "        ||_|_|_| |\n"
    "        |        /\n"
    "         \\   ___/\n"
    "          | || |\n"
    "          | || |\n"
    "\n"
    "\n"));
    
  AD(("zugang"),
    "Die Wand im Nordosten ist ein durchscheinender, blasser Illusionszauber. Von der "
    "anderen Seite wirkt sie aber massiv und sehr echt.");
    
  AD(("seite"),
    "Du kannst einfach nach Nordosten durch den Zauber gehen.");
    
  AD(({"sandstein","stein"}),
    "Die Waende dieser Hoehle bestehen aus gelbem Sandstein.");     
  
  AD(("druck"),
    "Welchem Druck die Tuer standhalten soll, ist nicht auf den ersten Blick erkennbar.");
        
  AD(({"nordoestliche wand","nordoestliche felswand","nordoestliche sandsteinwand"}),
    "Die nordoestliche Wand ist ein durchschreitbarer Illusionszauber "
    "der die Hoehle im Suedwesten vor ungebetenen Gaesten schuetzen soll.");
    
  AD(({"illusionszauber","zauber","illusion"}),
    "Der Illusionszauber schirmt anscheinend auch Geraeusche und Gerueche ab.");
    
  AD(("geraeusche"),
    "Du hoerst lediglich ein leises Plaetschern aus der Hoehle dringen. Sie scheint "
    "auf den ersten Blick verlassen zu sein.");
  
  AD(("plaetschern"),
    "Du kannst das Plaetschern nur hoeren, aber nicht sehen.");
    
  AD(("blick"),
    "Die Tuere ist aus Stahl und sehr dick. Trotz der hohen Feuchtigkeit in der Hoehle "
    "ist sie kaum rostig. Sie scheint fuer grossen Druck gebaut zu sein.");
    
  AD(("gerueche"),
    "Dir faellt ein leichter Rauchgeruch auf. Den kann man von der anderen Seite "
    "des Illusionszaubers nicht wahrnehmen.");
  
  AD(({"geruch","rauchgeruch","rauch"}),
    "Du kannst den Rauch nicht sehen, sondern nur riechen.");
          
  AD(("decke"),
    "Die Decke ist gewoelbt und wurde ebenfalls eindeutig bearbeitet.");
   
   
  AD(({"boden","sand","schwemmsand"}),
    "Der Boden ist mit dem gleichen feinen Schwemmsand wie in der uebrigen "
    "Hoehle bedeckt.");     
  
 
   
   
  AddCmd(({"schliesse","verschliesse"}), "func_tuerdlerei");
  AddCmd(("klopfe"), "func_klopfen");
  AddCmd(("oeffne"), "func_oeffnen");
  
  
 
  SetProp (P_HIDE_EXITS, ({"nordosten"}));
    
  AddExit("nordosten", ([
          EX_FUNC:"illusion",
          EX_PLMSG:"Du spuerst ein kuehles Prickeln und Ziehen als Du durch "
                   "den Illusionszauber trittst.\n\n"]));


  AddSound( DEFAULT_SOUND,
    "Du hoerst ein staendiges Plaetschern aus der Hoehle im Suedwesten.");
 
  AddSound(("plaetschern"),
    "Irgendwo im Suedwesten rinnt anscheinend Wasser von der Decke. Von hier aus "
    "kannst Du nichts weiter erkennen."); 
  
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist hier feucht und kuehl.");
    
  AddSmell(("luft"),
    "Die Luft riecht hier kuehl und erfrischend.");
    
    
NewDoor("suedwesten","./hoehle9",({"tuer","metalltuer","eisentuer","stahltuer","panzertuer","tuere"}),
({D_FLAGS, DOOR_OPEN | DOOR_RESET_OP,
  D_LONG, BS("Die Stahltuer ist ca 2 Meter hoch und sehr dick. Auf der "
  "Innenseite ist ein Hebel angebracht. Sie sieht aus als sollte "
  "sie grossem Druck von aussen standhalten koennen. Mitten auf der Tuer "
  "prangt eine rote Faust. Auf Kopfhoehe ist ausserdem ein Tuerschieber "
  "eingebaut."),
  D_SHORT,"Eine %se Stahltuer\n",
  D_NAME,"Stahltuer",
  D_GENDER, FEMALE,
  D_OPENTESTFUNC, "func_oeffnen",
  D_CLOSETESTFUNC, "func_schliessen",
  D_MSGS, ({"durch die Stahltuer","geht","kommt durch die Tuere herein"}) 
  }) );
 
}


int illusion() {
	
	TPM("/d/dschungel/trintrasil/hoehle/room/hoehle5", M_GO, "mit einem "
        "leisen Zischen durch die nordoestliche Wand", "verschwindet",
        "tritt mit einem leisen Zischen aus der suedlichen Wand");
        return 1;
}


func_oeffnen() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
			
		write(BS("Die Tuer ist ja offen! Geh einfach nach Suedwesten wenn "
		"Du willst."));
		return 1;
	}
	
	else {
		write(BS("Die Metalltuer kann man von aussen nicht oeffnen. Du "
      	        "koenntest aber anklopfen, vielleicht hoert Dich jemand."));
      	        say(BS(""+TPN+" versucht vergeblich die Tuer zu oeffnen."));
      	        return 1;
      	}
}


func_schliessen() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
		
		write(BS("Die Stahltuer besitzt auf der Aussenseite weder einen Hebel "
		"noch einen Knauf. Du kannst die Tuer von hier aus nicht schliessen."));
		return 1;
	}
	
	else {
		write(BS("Die Tuer ist schon geschlossen."));
		return 1;
	}
}

      	             
//!!!!!!!!!!!!!!!!!!!!!!KLOPFEN!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  
int func_klopfen(string str) {
	
	notify_fail("An was willst du klopfen?\n");
	
	if(str=="tuer"||str=="eisentuer"||str=="schutztuer"||str=="metalltuer"||
	str=="stahltuer"||str=="an tuer"||str=="an eisentuer"||str=="an schutztuer"||
	str=="an metalltuer"||str=="an stahltuer"||str=="an") {
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
			
			write(BS("Die Tuer ist doch offen. Warum willst Du dann anklopfen?"));
			return 1;
		}
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==-1) {
			
			write(BS("Du haemmerst mit der Faust an die Stahltuer. Die Tuer "
			"ist allerdings sehr dick. Du weisst nicht ob Dich jemand "
			"gehoert hat!"));
			say(BS(""+TPN+" klopft mit der Faust an die Stahltuer."));
			tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", 
			BSL("\n   !!KLOPF!!   \n"
			"   !!KLOPF!!   \n"
			"   !!KLOPF!!   \n"
			"Da haemmert jemand verzweifelt an die geschlossene Stahltuer "
			"Du koenntest ja durch den Tuerschieber schauen, wer da herein "
			"will."));
			return 1;
		}
	}
}


//ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß SPECIAL DETAILS ANFANG ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß

knauf() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
		
		return(BS("Die Tuere bestitzt keinen Knauf. Innen hat sie einen Hebel. "
		"So kann man sie anscheinend nur von Innen oeffnen oder verschliessen."));
	}
	
	else {
		return(BS("Die Tuer besitzt keinen Knauf. Du kannst sie von hier aus "
		"nicht oeffnen."));
	}
}


aussen() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
		
		return(BS("Du kannst durch die Tuere in die Hoehle gehen."));
	}
	
	else {
		return(BS("Die Tuere ist verschlossen. Die Aussenseite ist glatt, ohne "
		"Knauf oder Hebel. Man kann sie anscheinend nur von Innen oeffnen."));
	}
}


aussenseite() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
		
		return(BS("Du befindest Dich auf der Aussenseite der Tuer. Innen siehst "
		"Du einen Hebel."));
	}
	
	else {
		return(BS("Die Stahltuer ist verschlossen. Aussen hat sie keinen Hebel. "
		"Du koenntest an die Tuer klopfen, vielleicht kann Dich von Innen wer "
		"hoeren."));
	}
}


innenseite() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
		
		return(BS("Der Hebel ist auf der Innenseite angebracht, damit man "
		"die Tuer nur von der Hoehle aus versperren kann."));
	}
	
	else {
		return(BS("Auf der Aussenseite ist kein Hebel. Man kann die Tuer nur "
		"von innen wieder oeffnen oder versperren."));
	}
}


hebel() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle9")==1) {
		
		return(BS("Damit kann man die Tuer versperren. Sie sieht sehr massiv aus. "
		"Sie wurde anscheinend gebaut um grossen Druck stand zu halten."));
	}
	
	else {
		return(BS("Die Tuere ist verschlossen. Du siehst hier aussen keinen "
		"Hebel."));
	}
}

//ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß SPECIAL DETAILS ENDE ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß

int objekte_im_gang() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	i=sizeof(inv);
	
	return i;
}
	
	
mixed schieber_func() {

	int i;
	object *inv;
	inv=all_inventory(this_object());
		
	i=sizeof(inv);
	
	if(i==1) {
		
		return first_inventory(TO)->name();
	}
	
	else {
		
		for(i=0;i<sizeof(inv);i++) {
		
			tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9.lpc", 
			" "+(i+1)+".) "+capitalize(inv[i]->name())+"\n");;
			
		}
	}
}

 
//oooooooooooooooooooooooooo CALL_OTHER FLUT AUS hoehle9 oooooooooooooooooooooooooooooooooooooooooooooo   

flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/h8flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}