//fertig und getestet
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";


int  fleds=1;


object *trinker;


reset() {
	
	::reset();
	fleds=1;
	trinker = ({});
}


void create()
{
  ::create();

trinker = ({});

  SetProp( P_INT_SHORT, "Sandsteinhoehle" );
  SetProp( P_INT_LONG, break_string(
"Der Gang muendet hier in einen hohen, kegelfoermigen Hohlraum. Ein kleiner "
"Bach plaetschert von der spitz zusammenlaufenden Decke in einen kleinen, "
"kreisrunden Teich. Drei Gaenge fuehren aus dem Raum, wobei der breiteste "
"nach Suedosten fuehrt."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"bach"}),
    "Ein armdicker Wasserstrahl plaetschert von der Decke herab "
    "in das Becken.");

  AD(({"wand","waende","sandsteinwand","sandsteinwaende","hoehlenwaende","hoehlenwand"}),
    "Die gelben, orange gestreiften Waende laufen nach oben spitz zusammen.");
     
  AD(({"strahl","wasserstrahl"}),
    "Das Gestein hier ist wirlich voller Wasser. Ein "
    "Wunder das die ganze Hoehle nicht unter Wasser steht.");
    
  AD(("wunder"),
    "Man soll es nicht verschreien. Immerhin ist diese "
    "Hoehle sicher einmal ein Wasserlauf gewesen.");
    
  AD(({"hoehle"}),
    "Zumindest scheint es als waeren die Waende von einem "
    "Wasserlauf glattpoliert worden.");
    
  AD(({"wasserlauf","lauf"}),
    "Bis auf den Wasserstrahl der von der Decke rinnt ist "
    "nichts von einem solchen zu sehen."); 
  
  AD(({"becken","teich"}),
    "In der Mitte des Raumes hat sich das Wasser in einem "
    "beinahe kreisrundem Becken gesammelt.");
    
  AD(("mitte"),
    "Als waere der Hohlraum mit einem Zirkel vermessen worden, "
    "so einen gleigmaessigen Kegel bildet er.");
    
  AD(("zirkel"),
    "Interessiert Dich Geometrie?");
    
  AD(("geometrie"),
    "Du denkst dabei sicher an Formen auf Papier, aber die "
    "Silbe geo- deuted doch darauf hin das eher Erdvermessung "
    "gemeint ist.");
    
  AD(({"silbe","formen","erdvermessung","vermessung","beispiel"}),
    "Interessant, nicht?");
    
  AD(("papier"),
    "Papier ist geduldig, das Leben nicht.");
  
  AD(("leben"),
    "Du haengst doch daran, oder?");
      
  AD(({"wasser"}),
    "Das Wasser des Teiches ist vollkommen klar. Das kuehle, "
    "frische Nass wuerde Dir jetzt sicher gut tun.");
    
  AD(("nass"),
    "Koste doch einmal.");
    
  AD(("decke"),
    "Die Decke lauft ca. 6 meter ueber Dir spitz zusammen.");
    
  AD( ("gestein"),
    "Da das Hoehlensystem unter ´Zehn Ochsen´ "
    "liegt, sickert hier sehr viel Wasser durch den Fels.");
    
  AD(("fels"),
    "Der Fels ist hier recht poroes und wasserdurchlaessig.");
    
  AD(({"boden"}),
    "Der Boden besteht hier aus glattem Sandstein.");
  
  AD(({"sandstein","stein"}) ,  
    "Das Aussehen des Gesteins ist im gesamten Hoehlensystem "
    "so ziemlich das gleiche.");
  
  AD(("aussehen"),
    "Die Waende schimmern in einem sanften gelb.");
      
  AD(({"system","hoehlensystem"}),
    "Hast Du schon alle Gaenge erforscht?");
    
  AD(({"zehn ochsen","zehn","ochse"}),
    "`Zehn Ochsen` muesste beinahe direkt ueber Dir sein.");
    
  AD(({"hohlraum","raum"}),
     "Die Hoehle bildet hier einen ca. 6 meter hohen und 5 meter "
     "durchmessenden Kegel."); 
     
  AD(({"kegel"}),
    "Aus der Spitze des Kegels plaetschert ein armdicker "
    "Wasserstrahl und bildet einen kleinen Teich. ");
   
  AD(("gang"),
    "Das Gestein ist von einem Labyrinth aus Gaengen durchzogen.");
    
  AD(("labyrinth"),
    "Die Gaenge fuehren noch tief in das Gestein.");
       
  AD(({"gaenge"}),
    "Drei Gaenge zweigen aus dem Raum ab, wobei der breiteste "
    "nach suedosten fuehrt.");
  
  ASD(("spitze"),
    "spitz");
    
  ASD(("punkte"),
    "punkt");
    
  ASD(({"fledermaeuse","maeuse","fledermaus","fledermaeuse"}),
    "maeuse");
    
  ASD(("quiecken"),
    "schwein");
    
  ASD(("fluegel"),
    "fluegel");
     
     
  AddCmd(({"trinke","koste"}), "func_erfrischung");
  AddCmd(({"quietsche","quiecke"}), "func_fledermaeuse");
   
   
  AddExit("suedwestunten", "./hoehle2");
  AddExit("suedosten", "./hoehle4");
  AddExit("nordwesten", "./amoebe");
  
  AddRoomMessage(({
    "\n plitsch \n",
    "\n plitsch, plitsch \n",
    "\n platsch, plitsch \n",
    "\n plitsch, plitsch, platsch \n",
    "\n plitsch, platsch, platsch \n",
    "\n platsch, plitsch, platsch \n",
    "\n plitsch, platsch\n",
    "\n      pitsch,       pitsch \n"}),4);


 AddSound( DEFAULT_SOUND,
   "Leise rieselt Wasser von der Decke. Aus dem suedosten kommen seltsame Geraeusche.");
 
  AddSound(("wasser"),
  "plitsch, plitsch, platsch"); 
 
  AddSound(({"geraeusch","geraeusche"}),
  "Du glaubst ein Schnaufen zu hoeren. Vielleicht taeuscht Du Dich aber da die "
  "Hoehlenwaende das Geraeusch verzerren.");
  
  AddSound(({"schnaufen"}),
  "Du beschliesst vorsichtig zu sein.");  

}

int func_erfrischung(string str) {
	
	string plname;
	plname = TP->name();
	
	notify_fail ("Was willst Du trinken?\n" );
	
	if(str=="wasser"||str == "nass"||str == " aus becken"||str == "aus teich") {
		
		if( member_array(plname, trinker)==-1 ) {
			
			write(BS("Du laesst Dir das angenehm kuehle Wasser ueber das "
			"Gesicht rinnen und trinkst gierig ein paar Schlucke."));
			say(BS(""+TPN+" trinkt Wasser aus dem Teich."));
			this_player()->heal_self(20+random(15));
			trinker += ({ this_player()->name() });
			return 1;
		}
		
		else {
			
			write(BS("Du trinkst zwar etwas Wasser, hast aber eigentlich "
			"keinen Durst mehr. Komm spaeter wieder."));
			return 1;
		}
	}
}


int func_fledermaeuse(string str) {
	
	object fmaus;
	
	notify_fail("Du musst lauter quiecken\n");
	
	if(str=="laut"||str=="lauter"||str=="detonativ") {
		
		if(fleds) {
			
			write(BS("!!QUIIIIIIEEECK!!... verstoert schrecken die "
			"Fledermaeuse aus ihrem Schlaf auf und flattern verwirrt "
			"hoch."));
			say(BS(""+TPN+" macht:´!!QUIIIIIIEEECK!!´, und stoerrt damit einige "
			"Fledermaeuse auf."));
			fmaus=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/fmaus.lpc");
			fmaus->move(environment(TP), M_TPORT);
			fmaus=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/fmaus.lpc");
			fmaus->move(environment(TP), M_TPORT);
			fmaus=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/fmaus.lpc");
			fmaus->move(environment(TP), M_TPORT);
			fmaus=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/fmaus.lpc");
			fmaus->move(environment(TP), M_TPORT);       
			fmaus=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/fmaus.lpc");
			fmaus->move(environment(TP), M_TPORT);
			fmaus=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/fmaus.lpc");
			fmaus->move(environment(TP), M_TPORT);
			fleds--;
			return 1;
		}
		
		if(fleds<1) {
			
			write(BS("!!!QUIIIIIIEEECK!!!... da sind aber keine Fledermaeuse "
			"die Du mit Deinem Gequiecke sekieren koenntest."));
			say(BS("!!!QUIIIIIIEEECK!!!... "+TPN+" quieckt wie ein "
			"hysterisches Ferkel.\n"));
			return 1;
		}
	}
}



spitz() {
	
	if(fleds) {
		
		return BS("Du entdeckst einige eigenartige schwarze Punkte direkt unter der "
		"Spitze der Decke.");
	}
	
	else {
		return BS("Aus der Spitze des Kegels plaetschert ein armdicker Wasserstrahl "
		"und bildet einen kleinen Teich.");
	}
}


punkt() {
	
	if(fleds) {
		
		return BS("Einige kleine Fledermaeuse haengen von der Decke.");
	}
	
	else {
		return BS("Du kannst an der Decke keine Punkte entdecken.");
	}
}


maeuse() {
	
	if(fleds) {
		
		return BS("Die kleinen Fledermaeuse haengen friedlich in ihre Fluegel "
		"gehuellt von der Decke und scheinen zu schlafen. Mit einem lauten "
		"Quiecken kannst Du sie vielleicht aufwecken.");
	}
	
	else {
		
		return BS("Du kannst keine Fledermaeuse entdecken, vielleicht sind sie alle "
		"ausgeflogen.");
	}
}


schwein() {
	
	if(fleds) {
		
		return BS("Quiecke laut.");
	}
	
	else {
		return BS("Quieckst Du oefters so einfach vor Dich hin?");
	}
}


fluegel() {
	
	if(fleds) {
		
		return BS("Die Fledermaeuse schlafen friedlich und unbewegt.");
	}
	
	if(!fleds) {
		
		return BS("Du findest an der Decke keine Fledermaeuse, vielleicht sind "
		"ausgeflogen.");
	}
}



flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}