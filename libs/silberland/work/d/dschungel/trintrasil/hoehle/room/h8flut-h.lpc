//fertig
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";


create() {
	
	::create();

SetProp( P_INT_SHORT, "kurz vor dem Ertrinken" );
SetProp( P_INT_LONG, BS(
"nolong"));
  
SetProp( P_LIGHT, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
SetProp(P_KILL_NAME, "eine Ueberflutung");
AddCmd ("", "no", 1);

SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}


int no() {
	
	write(BS("Oh mein Gott! WAS GEHT HIER VOR?"));
	return 1;
}


int njet() {
	
	write("\n!!DU WIRST ERTRINKEN!!\n");
	return 1;
}


init() {
	
	::init();
	
	if(query_once_interactive(this_player())) {
		
		call_out("flut1", 2);
	}
}


flut1() {
	
	NIX
	write(BSL("\nDu hoerst ein eigenartiges Rumpeln."));
	call_out("flut2", 3);
}


flut2() {
	
	NIX
	write(BSL("\nDu hoerst ein Krachen und ein gewaltiges Rauschen das schnell "
	"anschwillt!!"));
	call_out("flut3", 3);
}


flut3() {
	
	NIX
	write(BSL("\nDie gesamte Hoehle vibriert wie bei einem Erdbeben."));
	call_out("flut4", 3);
}


flut4() {
	
	NIX
	RemoveCmd("", "no");
	AddCmd("", "njet", 1);
	write(BSL("\nPloetzlich bricht eine gewaltige Wasserwand durch den Illusionszauber "
	"im Nordosten!!!"));
	call_out("flut5", 2);
}


flut5() {
	
	NIX
	write(BSL("\n"
	"  !!!!!!!!WWWWWWWWWWWWWWWWWWWWWWWWWWWW!!!!!!!!\n"
	"  !!!!!!!!UUUUUUUUUUUUUUUUUUUUUUUUUUUU!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"));
	call_out("flut6", 3);
}


flut6() {
	
	NIX
	write(BSL("\nDie Wassermassen knallen Dich gegen die verschlossene Metalltuer "
	"und reissen Dich mit!!!"));
	TP->do_damage(30+random(15));
	call_out("flut7", 2);
}


flut7() {
	
	NIX
	write(BSL("\nDu willst in dem gewaltigen Tosen schreien, aber das Wasser zerquetscht "
	"Deinen Brustkorb!!"));
	TP->do_damage(50+random(40));
	call_out("flut8", 2);
}


flut8() {
	
	NIX
	write(BSL("\nDie Wassermassen reissen Dich in rasender Geschwindigkeit durch "
	"die Hoehle!!"));
	call_out("flut9", 2);
}


flut9() {
	
	NIX
	write(BSL("\nDu schlaegst mit dem Schaedel gegen den Fels!!"));
	TP->do_damage(10+random(20));
	call_out("flut9a", 1);
}


flut9a() {
	
	int i;
	object *inv;
	inv=all_inventory(TO);
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(!living(inv[i])) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/eingang", M_GO+ 
			M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("flut10", 1);
}


flut10() {
	
	NIX
	write(BSL("\nDu wirst von der reissenden Flut brutal durch die Hoehle "
	"gewirbelt."));
	call_out("flut11", 2);
}


flut11() {
	
	NIX
	write(BSL("\nDu wirst gegen die Waende geschleudert. Wasser schiesst in Deinen "
	"Mund."));
	TP->do_damage(10+random(15));
	call_out("flut12", 2);
}


flut12() {
	
	NIX
	write(BSL("\nDas Wasser spuelt Dich aus der Hoehle. Zerschlagen schnappst Du "
	"nach Luft."));
	call_out("flut13", 1+random(3));
}


flut13() {
	
	NIX
	write(BSL("\nDu kannst Dich gerade noch am Fels festkrallen und verhindern, dass "
	"Dich die Wassermassen aus der Hoehle durch einen Wasserfall in den Rio de la "
	"Puseta spuelen, in dem Du wie eine Ratte ersoffen waerst."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", "\n"+TPN+" wird "
	"hereingespuelt.");
	TP->move("/d/dschungel/trintrasil/hoehle/room/eingang", M_GO+ M_NO_SHOW+
	M_SILENT);
	RemoveCmd("", "njet");
	AddCmd("", "no", 1); 
}


BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/hoehle/room/eingang",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	
	leiche=present("leiche", TO);
	
	if (leiche)  {
		
		leiche->move("d/dschungel/trintrasil/hoehle/room/eingang", M_TPORT+
		M_SILENT);
		tell_room("d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDie Leiche "
		"von "+CAP(getuid(TP))+" wird hereingeschwemmt! Schrecklich!"));
	}
	
	write_file("/d/dschungel/trintrasil/log/flut",
	ctime()+": Flut hat "+CAP(getuid(TP))+" umgebracht.\n");
}