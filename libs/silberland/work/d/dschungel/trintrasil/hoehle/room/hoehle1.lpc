//fertig
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";


int anzahl=1;

 
reset()  {
  ::reset();
  anzahl=1;  }
  
void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Du stehst bis zu den Knien im kalten Wasser. Im Osten fuehrt der Spalt auf "
"trockenem Boden weiter in den Fels, waehrend nach Westen der Grund stark "
"absinkt und der Gang sich zu einer breiten Hoehle verbreitert aus der "
"ein ohrenbetaeubendes Tosen herueberdringt."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"fisch"}),
    "Hier im Dunklen siehst Du keine Fische.");

  AD(({"gang","spalt"}),
    "Die Waende ruecken im Osten noch enger zusammen. Im Westen verbreitert sich "
    "der Gang schlagartig zu einer geraeumigen Hoehle aus der feine "
    "Wasserschleier und das Donnern eines Wasserfalles herein dringen.");
  
  AD(({"schleier","wasserschleier"}),
    "Die feinen Tropfen werden vom Wasserfall aufgewirbelt.");
    
  AD(("tropfen"),
    "Der feine Wasserschleier laesst die Waende feucht glaenzen.");
    
  AD(("tosen"),
    "Das Tosen eines Wasserfalles hallt unheimlich zwischen den Waenden.");
    
  AD(({"hoehle","sandsteinwaende","sandsteinwand"}),
    "Die gelben Sandsteinwaende der Hoehle schimmern feucht. Feine Rinnsale "
    "laufen an ihnen hinunter. Die Unfoermigkeit der Waende zeigt einen "
    "eindeutig natuerlichen Ursprung.");
    
  AD(({"foermigkeit","unfoermigkeit"}),
    "Die Waende weisen weiche Woelbungen und nur schraege Winkel auf.");
   
  AD(("knie"),
    "Kaltes Wasser umspuelt Deine Knie.");
     
  AD(("winkel"),
    "Du siehst nirgends harte Kanten. Nur die Waende laufen oben "
    "spitz aufeinander zu wodurch die Hoehle quasi keine Decke hat.");
    
  AD(("kanten"),
    "Die Kanten wurden vom Wasser abgerundet.");
    
  AD(("decke"),
    "Die Waende laufen spitz zusammen.");
    
  AD(("ursprung"),
    "Welche Naturkraft diese Hoehle hervorgebracht hat ist Dir schleierhaft.");
    
  AD(({"natur","naturkraft","kraft"}),
    "Die Waende der Hoehle sehen ausgespuelt aus, aber Du siehst keinen Wasserlauf "
    "der sowas berwirkt haben koennte. ");
  
  AD(({"wasserlauf","lauf"}) ,  
    "Vielleicht hat das Wasser einen anderen Weg gegraben.");
    
  AD(({"weg"}),
    "Wohin der Wasserlauf versickert ist, wirst Du vielleicht herausfinden wenn "
    "Du die Hoehle weiter erkundest.");
    
  AD(({"wasser"}),
    "Das Wasser ist hier voellig klar und ruhig. Du kannst den sandigen "
    "Grund unter Dir erkennen.");
  
  AD(({"grund"}),
    "Der Grund ist mit grobem Sand und runden Steinen bedeckt.");
    
  AD(("steine"),
     "Die kleinen Steine sind ganz rundgeschliffen. Nur ein groesserer "
     "Stein faellt Dir auf."); 
     
  AD(("stein"),
    "Der Stein ist dunkler und groesser als seine Gefaehrten. Er hebt sich "
    "seltsam vom Grund ab. Sieht aus als wuerde etwas unter ihm liegen.");
    
  AD(({"gefaehrte"}),
    "So Gefaehrte wie ein Stein einem Stein nur sein kann.");
    
  AD(({"etwas"}),
    "Drehe den Stein doch um wenn es Dich interessiert.");
   
  AD(({"sand"}),
    "Der Sand ist etwas grob. Er wurde wohl von einem ehemaligen Wasserlauf "
    "von den Waenden gerieben.");

  AD(({"wand","waende"}),
    "Die Waende sind glatt und laufen mit sanften Woelbungen aufeinander zu. "
    "Du hast zwar noch genug Platz, aber tiefer in der Hoehle wird es sicher "
    "enger.");
    
  AD(({"woelbung","woelbungen"}),
    "Haertere Stellen im Gestein haben wohl Ausbuchtungen hinterlassen.");
  
  AD(({"stellen","stelle","ausbuchtung","ausbuchtungen"}),
    "Haertere Stellen im Gestein wurden langsamer ausgespuelt und haben so "
    "Ausbuchtungen hinterlassen.");
      
  AD(({"gestein"}),
    "Das Gestein ist natuerlich nicht ueberall gleich beschaffen.");

  AD(({"platz"}),
    "Weiter vor Dir ist alles dunkel.");
    
  AD(("dunkel"),
    "Ausserhalb Deines Lichts ist alles dunkel.");
    
  AD(({"licht","schein"}),
    "Der Schein wird roetlich von den feuchten Waenden zurueckgeworfen.");
    
  AD(({"rinnsale","rinnsal"}),
    "Hier sickert wohl `Zehn Ochsen` durch den Fels.");
    
  AD(("fels"),
    "Der gesamte Fels besteht hier aus gelbem Sandstein.");
    
  AD(({"sandstein"}),
    "Der gelb-orange gestreifte Sandstein schimmert feucht und eng wie das "
    "Gedaerm eines monstroesen Wurmes.");
    
  AD(("gedaerm"),
    "Nach osten wird die Hoehle noch enger.");
    
  AD(({"wurm","wuermer"}),
    "Schaudernd erinnerst Du Dich an Geschichten die Du ueber Raketenwuermer "
    "gehoert hast.");
    
  AD(({"raketenwurm","raketenwuermer"}),
    "Du hast Geschichten gehoert, dasz tief im Gestein unter dem Dschungel "
    "angeblich riesige, gefraessige Wuermer hausen wuerden.");
    
  AD(({"geschichten","dschungel"}),
    "Geschichten ueber den Dschungel hoert man viele.");
    
  AD(({"ochse","zehn ochsen","zehn"}),
    "Irgendwo ober Dir muss der Lauf des Baches liegen.");
    
  AD(({"bachlauf","lauf","bach"}),
    "Von hier unten siehst Du natuerlich nur Fels.");
    
  AD(("osten"),
    "Weiter im osten siehst Du den Boden ganz trocken werden.");
  
  AD(("wasserfall"),
    "Aus dem westen hoerst Du das unablaessige Donnern eines Wasserfall.");
    
  AD(("boden"),
    "Durch das seichte Wasser siehst Du den sandigen Boden.");
    
  AddCmd( ({"drehe","hebe","wende"}), "func_krak");
    
  
  AddExit("westen", "./eingang" );

  AddExit("osten", "./hoehle2" );

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das Donnern des Wasserfall.");
 
  AddSound(({"rauschen","wasserfall","donnern"}),
    "!!WUUUUUUSCHHHHHHHHHHHHHHHHHHHH!!"); 
}

int func_krak(string str) {
	
	object krake;
	
	notify_fail("Was willst Du umdrehen?\n");
	
	if( str=="stein"||str=="stein um"||str=="stein auf") {
		
		if(anzahl) {
			
			write(BS("Vorsichtig drehst Du den Stein um und laesst ihn "
			"erschrocken wieder fallen als ein ziemlich grosser "
			"Tintenfisch darunter hervor schiesst."));
			say(BS(""+TPN+" dreht einen Stein um und scheucht einen "
			"Tintenfisch auf."));
			krake=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/krake.lpc");
			krake->move(environment(TP), M_TPORT);
			anzahl--;
			return 1;
		}
		
		if(!anzahl) {
			
			write(BS("Der Stein wurde schon einmal umgedreht!"));
			return 1;
		}
		return 1;
	}
	return 0;
}



flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}