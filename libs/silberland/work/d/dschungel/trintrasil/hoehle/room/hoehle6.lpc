//fertig
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";

int licht=1;


reset() {
   ::reset();
   licht=1;
}

   
void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Gang ist hier beinahe kreisrund und so hoch das Du die Decke nicht "
"mehr beruehren kannst. Er endet  abrupt unter einem senkrechtem nach oben "
"fuehrenden Schacht, aus dem ein schwacher Lichtschimmer dringt. In einer Ecke "
"siehst Du einen Haufen aus altem Stroh und Kleidungsfetzen. Auf dem "
"aufgewuehlten, sandigen Boden liegen einige Knochen und ein zerfetztes "
"Skelett."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"gang"}),
    "Der Gang ist roehrenfoermig. Sieht beinahe aus als waere er ausgebohrt "
    "worden, aber wahrscheinlich wurden die Waende eben so glatt ausgespuelt. "
    "Er endet direkt unter einem recht engem senkrechten Schacht.");

  AD(({"wand","waende"}),
    "Die glatten Waende wurden anscheinend von einem Wasserlauf so "
    "ausgespuelt.");
    
  AD(({"wasserlauf","lauf"}),
    "Es rieselt zwar noch immer Wasser die Waende herab aber ein Bach ist nicht "
    "zu sehen.");
    
  AD(({"wasser"}),
    "Leise rieselt Wasser die Waende herab und laesst diese feucht schimmern.");
    
  AD(({"sandsteinwaende","waende","wand"}),
    "Die Sandsteinwaende schimmern hier in einem kraeftigen gelb. Durch "
    "das Wasser das an ihnen herunterlaeuft sieht es aus als wuerden "
    "kleine Wellen ueber die Wand laufen.");
  
  AD(("knochen"),
    "Du entdeckst erstaunt das die meisten der herumliegenden Knochen "
    "Tierknochen sind.");
    
  AD(("tierknochen"),
    "Es koennten Oberschenkelknochen einer Ziege sein.");
    
  AD(("ziege"),
    "Jemand scheint den Behemots zu fuettern. Wer das nur sein koennte.");
    
  AD(({"oberschenkelknochen","oberschenkel"}),
    "Der Behemots scheint eine Vorliebe fuer saftige Ziegenkeulen zu haben.");
    
  AD(({"ziegenkeule","keule","vorliebe"}),
    "Vielleicht laesst er Dich ja vorbei wenn Du ihm eine bringst.");
     
  AD(({"gelb","eitergelb"}),
    "So richtig schoenes kraeftiges eitergelb.");
    
  AD(("wellen"),
    "Du trittst naeher an eine Wand heran und bewunderst die stillen "
    "Rinnsale die den Anschein erwecken als wuerden sich die Waende kraeuseln.");
    
  AD(({"anschein","rinnen"}),
    "Unablaessig rieselt Wasser ueber die Waende.");
    
  AD(({"rinnsal","rinnsale"}) ,  
    "Die feinen Rinnsale versickern schnell im sandigen Boden.");
    
  AD(({"hoehle"}),
    "Der kreisrunde Gang endet im osten unter einem Schacht. Nach westen fuehrt "
    "er weiter durch das Gestein.");
  
  AD(({"lichtschimmer","schimmer","licht"}),
    "Der Schacht scheint an die Oberflaeche zu fuehren.");
    
  ASD(({"schacht","oberflaeche","ende"}),
    "schacht");
    
  AD(({"boden"}),
    "Der Boden ist hier mit feinem, weiss schimmernden Sand bedeckt.");
    
  AD(({"sand"}),
    "Der Sand sieht aus als waere er von grossen Krallen aufgewuehlt worden."); 
  
  AD(("krallen"),
    "Gewaltige Krallen haben den Sand hier umgewuehlt.");
    
  AD(("ecke"),
    "In einer Ecke direkt neben dem Schacht liegen Stroh und "
    "Kleidungsfetzen die zu einem Schlaflager zusammengetragen wurden.");
   
  AD(({"kleidungsfetzen","fetzen","stuecke","kleidungsstuecke"}),
    "Die Kleidungsfetzen verwendet ein Behemots anscheinend fuer sein "
    "Schlaflager.");
     
  AD(({"schlaflager","lager"}),
    "Du wuerdest Dich nie in diesen Dreckhaufen legen.");
    
  AD(({"haufen","dreckhaufen","dreck","stroh"}),
    "Der Haufen stinkt bestialisch nach Raubtier und Blut. Er scheint das "
    "Schlaflager eines Behemots zu sein.");
    
  AD(("blut"),
    "Auf den zerfetzten Kleidungsstuecken kannst Du teilweise noch das Blut "
    "ihrer ehemaligen Besitzer erkennen.");
    
  AD(("besitzer"),
    "Die Besitzer waren wahrscheinlich grossspurige Abenteurer die glaubten "
    "dem Behemots auf wichtig kommen zu muessen.");
    
  AD(("abenteurer"),
    "´Begruesse alter Schwede Behemots, willst Du mein Tuetueschwertchen "
    "fressen?´... !!KLATSCH!! und den Rest kannst Du dir denken wenn Du das "
    "zerissene Skelett am Boden betrachtest.");
  
  AD(({"rest","skelett"}),
    "Der arme Abenteurer wurde sehr uebel mitgenommen. Uebler gehts eigentlich "
    "kaum.");
      
  AD(({"pimmelersatz","tuetueschwertchen","schwertchen","schwert"}),
    "Bleib immer relativ realistisch.");
    
  AD(("schwede"),
    "So Schweden wie Dante.");
    
  AD(("dante"),
    "Den wuerde der Behemots ganz schnell verdruecken.");
    
  AD(({"behemots","raubtier"}),
    "Behemotse sind Einzelgaenger und leben eigentlich tief im Dschungel. Nur sehr selten "
    "bekommt sie jemand zu Gesicht und kann davon erzaehlen.");
    
  AD(("dschungel"),
    "Behemotse leben normalerweise so tief im Dschungel dass man ihnen zum Glueck kaum "
    "begegnet.");
    
  AD(({"bestien","gesicht"}),
    "Behemotse scheinen immer in rasender Wut zu sein und greifen normalerweise alles an was "
    "ihnen zu nahe kommt.");
    
  AD(({"einzelgaenger"}),
    "Diese wilden Bestien zum Glueck nie Gruppen auf.");
  
  AD(("glueck"),
    "Auch wenn man einem einzelnen wuetenden Behemots begegnet braucht man meistens Glueck.");
    
  AD(({"gruppe","gruppen"}),
    "Die Behemots wuerden sich in einer Gruppe im Kampf um eine Beute sicher gegenseitig "
    "zerfleischen.");
    
  ASD(({"beute","kampf"}),
    "kampf");
       
  ASD(("wut"),
    "wut");
    
  AD(("insel"),//kontinent insel....
    "Was glaubst Du wo Du hier bist?");
     
  AD(("decke"),
    "Der Gang ist beinahe kreisrund. Vielleicht sind die Waende bearbeitet "
    "worden. Am Ende des Ganges klafft ein Schacht in der Decke.");
  
  AD(({"sprosse","sprossen"}),
    "Die Sprossen sind ziemlich rostig. Du solltest noch nicht nach oben klettern.");
    
    
  AddItem("/d/dschungel/trintrasil/hoehle/npc/behemots.lpc" ,REFRESH_DESTRUCT);

  AddCmd(({"klettere","kletter","steige"}), "noway");
  AddCmd(("lege"), "func_lager");
  AddCmd(({"unt","untersuche"}), "func_fackel");
    
    
  AddExit("westen", "./hoehle4");

  AddExit("oben", ([
        EX_FUNC: "oben"]) );
}
 
 
int func_lager(string str)  {
	
	notify_fail("In was willst Du Dich legen?\n");
	
	if(str=="dich in schlaflager"||str=="dich in lager"||str=="dich in haufen"||
	str=="dich in dreckhaufen"||str=="dich in strohhaufen"||str=="dich in stroh"||
	str=="dich in fetzen"||str=="dich in behemotslager"||str=="dich in kleidungsfetzen"||
	str=="dich auf schlaflager"||str=="dich auf lager"||str=="dich auf haufen"||
	str=="dich auf dreckhaufen"||str=="dich auf strohhaufen"||str=="dich auf stroh"||
	str=="dich auf fetzen"||str=="dich auf behemotslager"||
	str=="dich auf kleidungsfetzen"||str=="dich in dreck"||str=="in dreck") {
		
		if(present("behemots", TO)) {
			
			write(BS("Als Du dem Behemots zu nahe kommst schlaegt er mit "
			"seinen Pranken nach Dir!"));
			say(BS(""+TPN+" versucht sich am Behemots vorbei zu seinem "
			"Schlaflager zu schleichen."));
			return 1;
		}
		
		if( !present("behemots", TO) && !licht ) {
			
			write(BS("Du laesst Dich in den stinkenden Haufen aus uralten "
			"Kleiderfetzen und Stroh fallen, stehst aber gleich wieder "
			"auf."));
			say(BS(""+TPN+" laesst sich frisch vergnuegt in das stinkende "
			"Behemotslager fallen."));
			return 1;
		}
		
		if( !present("behemots", TO) && licht ) {
			
			write(BS("Du laesst Dich in den stinkenden Haufen aus uralten "
			"Kleiderfetzen und Stroh fallen und spuerst etwas Hartes unter "
			"Dir."));
			say(BS(""+TPN+" laesst sich frisch vergnuegt in das stinkende "
			"Behemotslager fallen."));
			return 1;
		}
	}
}

  
  
int func_fackel(string str)  {
	
	object fackel;
	
	if(str=="etwas hartes"||str=="etwas"||str=="hartes") {
		
		if(licht) {
			
			fackel=CLONEOB("/obj/fackel.lpc");
			
			if(fackel->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
				write(BS("Du durchsuchst das Behemotslager und findest "
				"eine Fackel. Leider ist sie Dir zu schwer."));
				say(BS(""+TPN+" findet etwas im Haufen, das aber anscheinend "
				"zu schwer ist."));
				fackel->remove();
				return 1;
			}
			
			else {
				write(BS("Du durchsuchst das Behemotslager und findest eine "
				"Fackel, die Du sofort einsteckst."));
				say(BS(""+TPN+" findet eine Fackel im Behemotslager."));
				licht=0;
				fackel->move(TP, M_NOCHECK);
				return 1;
			}
		}
		
		if(!licht) {
			
			write(BS("Du duchstuchst das Behemotslager, findest aber nichts."));
			say(BS(""+TPN+" durchstuchst das Behemotslager, findest aber nichts."));
			return 1;
		}
	}
}



noway(string str) {
	
	if(str=="nach oben"||str=="hinauf"||str=="sprossen nach oben"||
	str=="sprossen hinauf"||str=="an oberflaeche") {
		
		write(BS("Schau einmal genau. Es gibt ganz normal einen "
		"Ausgang `oben`."));
		return 1;
	}
}

	
oben() {
	
	if(present("behemots", TO)) {
		
		write(BSL("  ! ! ! GROAAAARRR ! ! !\nDer Behemots schlaegt "
		"nach Dir und laesst Dich nicht vorbei."));
		say(BSL("   ! ! ! GROAAARRR ! ! !\n"+TPN+" versucht zum Schacht "
		"zu gelangen, kommt aber nicht am Behemots vorbei."));
		return 1;
	}
	
	else {
		write(BS("Die Sprossen sind schon so rostig, dass Du entschliesst lieber "
		"nicht hinauf zu klettern."));
		say(BS(""+TPN+" versucht den Schacht hinauf zu klettern, laesst es "
		"aber doch bleiben."));
		return 1;
	}
}


wut() {
	
	if(present("behemots", TO)) {
		
		return(BS("Der Behemots knurrt Dich aus kleinen brennenden Knopfaugen an und "
		"fletscht seine gewaltigen Zaehne."));
	}
	
	else {
		return(BS("Leider oder zum Glueck ist der Behemots nicht da."));
	}
}


kampf() {
	
	if(present("behemots", TO)) {
		
		return(BS("Der Behemots scheint Dich schon abzuschaetzen ob Du eine lohnende "
		"Beute bist und schnaubt Dich wuetend an."));
	}
	
	else {
		return(BS("Es ist gerade kein Behemots da."));
	}
}

 
schacht() {
	
	if(present("behemots", TO)) {
		
		return(BS("Wenn Du zum Schacht gelangen willst musst Du aber an dem "
		"Behemots vorbei. Du siehst Sprossen die in die Wand eingelassen sind."));
	}
	
	if(!present("behemots", TO)) {
		
		return(BS("Du entdeckst Sprossen die in die Wand eingelassen sind auf denen "
		"man den Schacht hochklettern koennte."));
	}
}



behemots_present() {
	
	if(present("behemots", TO)) {
		
		return 1;
	}
	
	else {
		return 0;
	}
}
      
   
  
flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}