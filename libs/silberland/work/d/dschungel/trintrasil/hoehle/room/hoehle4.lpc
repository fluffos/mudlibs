//AddSound
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "room.h"
#include "/d/dschungel/trintrasil/myowndefine.h"

#define HOEHLE6 "/d/dschungel/trintrasil/hoehle/room/hoehle6.lpc"
#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

void sound_behem();

void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Gang ist hier beinahe kreisrund und so hoch das Du die Decke nicht "
"mehr beruehren kannst. Zwei schmalere Gaenge zweigen nach Nordosten und "
"Sueden von ihm ab, nach Nordwesten fuehrt er in einen grossen Hohlraum. Der "
"Boden ist hier mit feinem Sand bedeckt in dem das Wasser, das von den Waenden "
"rieselt schnell versickert."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"gang"}),
    "Der Gang ist roehrenfoermig. Sieht beinahe aus als waere er ausgebohrt "
    "worden, aber wahrscheinlich wurden die Waende eben so glatt ausgespuelt.");

  AD(({"wand","waende"}),
    "Die glatten Waende wurden anscheinend von einem Wasserlauf so "
    "ausgespuelt.");
    
  AD(({"wasserlauf","lauf"}),
    "Es rieselt zwar noch immer Wasser die Waende herab aber ein Bach ist nicht "
    "zu sehen.");
    
  AD(({"wasser"}),
    "Leise rieselt Wasser die Waende herab und laesst diese feucht schimmern.");
    
  AD(({"sandsteinwaende","waende","wand"}),
    "Die Sandsteinwaende schimmern hier in einem kraeftigen gelb. Durch "
    "das Wasser das an ihnen herunterlaeuft sieht es aus als wuerden "
    "kleine Wellen ueber die Wand laufen.");
    
  AD(({"gelb","eitergelb"}),
    "So richtig schoenes kraeftiges eitergelb.");
    
  AD( ("wellen"),
    "Du trittst naeher an eine Wand heran und bewunderst die stillen "
    "Rinnsale die den Anschein erwecken als wuerden sich die Waende kraeuseln.");
    
  AD(({"anschein","rinnen"}),
    "Unablaessig laufen die Bewegungen des Wasser ueber die Waende.");
    
  AD(({"bewegung","bewegungen"}),
    "War da nicht eine Bewegung hinter Dir?");
  
  AD(({"rinnsal","rinnsale"}) ,  
    "Es waere doch lustig ihr Rinnen zu stoeren indem Du die Hand an die "
    "Wand drueckst.");
    
  AD(({"gaenge","hoehle"}),
    "Der kreisrunde Gang fuehrt weiter nach osten. Im nordwesten muendet er "
    "in einen hohen Hohlraum. Ausserdem zweigen zwei schmale Gaenge nach "
    "Sueden und Nordosten von hier ab.");
    
  AD(({"suedlicher gang","gang","sueden"}),
    "Dieser Gang ist niedriger und schmaler als der Gang in dem Du Dich gerade "
    "befindest."),
    
  AD(({"nordosten","nordoestlicher gang"}),
    "Dieser Gang ist schmaler als der Gang in dem Du Dich befindest. Du kannst "
    "lautest Plaetschern hoeren.");
    
  AD(("plaetschern"),
    "Lautes Plaetschern schallt aus dem nordoestlichen Gang.");
    
  AD(({"boden"}),
    "Der Boden ist hier mit feinem, weiss schimmernden Sand bedeckt.");
    
  AD(({"sand"}),
     "Dir fallen seltsame Abdruecke im Sand auf."); 
     
  AD(({"abdruecke","abdruck"}),
    "Du kannst Spuren von Stiefeln erkennen. ");
    
  AD(({"spuren"}),
    "Die Spuren stammen sicher nicht von Dir. Bei genauerem Hinsehen erkennst "
    "Du das sie in alle Richtungen verlaufen.");
    
  AD(({"stiefel","stiefeln"}),
    "Die Abdruecke koennten von Militaerstiefel stammen. Die Traeger waren circa "
    "menschengross.");
  
  AD(({"militaer","militaerstiefel"}),
    "Wo die wohl herkommen?");
    
  AD(("traeger"),
    "Die Abdruecke sind unterschiedlich alt. Manche Spuren scheinen sogar ganz frisch "
    "zu sein.");
    
  AD(({"richtung","richtungen","hinsehen"}),
    "Die Spuren verlaufen in keine bestimmte Richtung, es sieht aber aus als "
    "wuerden die meisten aus dem suedlichen Gang kommen.");

  AD(("plaetschern"),
    "Das Plaetschern hallt in der Hoehle wieder.");
    
  AD(("loch"),
    "Von hier aus ist nicht viel zu erkennen.");
    
  AD(({"hohlraum","raum"}),
    "Im Nordosten muendet der Gang in einen kegelfoermigen Hohlraum.");
  
  AD(("aerger"),
    "Den kannst Du haben.");
      
  AD(({"pfeil","vergifteter pfeil","vergifteten pfeil"}),
    "Man hoert oefters von solchen Unfaellen.");
  
  AD(({"hand","haende"}),
    "Alles noch dran.");
   
  AD(("decke"),
    "Der Gang ist beinahe kreisrund. Vielleicht sind die Waende bearbeitet "
    "worden.");
    
       
  AddCmd(({"druecke","presse","lege"}), "func_peppers");

  
//  AddSound(DEFAULT_SOUND, #'sound_func);
 //AddSound( ("schnaufen"), #
  AddSound( ({"knurren","behemots"}), #'sound_behem );
   
      
  AddExit("nordwesten", "./hoehle3");
  AddExit("sueden", "./hoehle5"); 
  AddExit("osten", "./hoehle6");
  AddExit("nordosten", "./hoehle7");
}

int func_peppers(string str) {
	
	notify_fail("Was willst Du an was druecken?\n" );
	
	if(str=="aug"||str=="hand gegen wand"||str=="hand auf wand"||
	str=="hand an wand") {
		
		write(BSL("Du drueckst die Hand an die Wand und beobachtest belustigt "
		"wie sich das Wasser einen neuen Weg ueber Deine Finger sucht.\nLeider "
		"hast Du nicht zufaellig einen geheimen Schalter gefunden, aber "
		"vielleicht trifft Dich das naechste mal ein vergifteter Pfeil oder"
		"sowas in der Art.\n"));
		say(BS(""+TPN+" spielt mit dem Wasser das ueber die Waende rinnt."));
		return 1;
	}
}


sound_func(string sound) {
	
	if( HOEHLE6->behemots_present() ) {
		
		sound=BS("Aus dem Osten hoerst Du ein tierisches, wuetendes Schnaufen.");
		return sound;
	}
	
        else {
        	sound=BS("Du lauscht, hoerst aber nichts.");
        	return sound;
        }
}


sound_behem() {
	
	if( HOEHLE6->behemots_present() ) {
		
		return BS("Unheimlich! Aus dem Osten hoerst Du eindeutig ein ziemlich "
		"bedrohlich klingendes Knurren. So wie sich das anhoert solltest "
		"Du vorsichtig sein wenn Du nach Osten gehst.");
	}
	
	else {
		return BS("Du lauscht, hoerst aber nichts.");
	}
}


flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 7);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}
