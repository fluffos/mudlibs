
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "std/room";


create() {
	
	::create();

SetProp( P_INT_SHORT, "wird nie zu sehen sein" );
SetProp( P_INT_LONG, BS(
  "endlich der letze zum ueberholen!"));
  
SetProp( P_LIGHT, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
SetProp(P_KILL_NAME, "eine Ueberflutung");

AddCmd ("", "no", 1);   

}


int no() {
	write("\nOh mein Gott!! DU WIRST STERBEN!!.\n");
	return 1;
}


init() {
	
	::init();
	if(query_once_interactive(this_player())) {
		
		call_out("flut1", 2);
	}
}


flut1() {
	
	NIX
	write(BSL("\nOber Dir hoerst Du ploetzlich ein Quietschen und Rasseln."));
	call_out("flut2", 2);
}


flut2() {
	
	NIX
	write(BSL("\nAls Du erschrocken nach oben blickst siehst Du wie sich die "
	"Metallplatte langsam zu bewegen beginnt."));
	call_out("flut3", 2);
}


flut3() {
	
	NIX
	write(BSL("\nPloetzlich schiesst immer mehr Wasser von der Decke."));
	call_out("flut4", 2);
}


flut4() {
	
	NIX
	write(BSL("\n!!Dir schwant fuerchterliches!!"));
	call_out("flut5", 2);
}


flut5() {
	
	NIX
	write(BSL("\n"+ANSI_RED+"            !!!!!HHAAUU AABB!!!!!"+ANSI_NORMAL+""));
	call_out("flut6", 2);
}


flut6() {
	
	NIX
	write(BSL("\n"
	"  !!!!!!!!WWWWWWWWWWWWWWWWWWWWWWWWWWWW!!!!!!!!\n"
	"  !!!!!!!!UUUUUUUUUUUUUUUUUUUUUUUUUUUU!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"
	"  !!!!!!!!MMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!!!!!!\n"));
	call_out("flut7", 2);
}


flut7() {
	
	NIX
	write(BSL("\nUnglaubliche Wassermassen brechen auf Dich nieder."));
	call_out("flut8", 2);
}


flut8() {
	
	NIX
	write(BSL("\nAls Dein Koerper wie ein Muecke zerquetscht wirst bist Du "
	"schon tot."));
	TP->die();
	call_out("flut8a", 1);
}


flut8a() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob ) {
		
		return 1;
	}
	
	if( KONTROLL->flut_aktiv()!=2 ) {//1== flut aktiv noch kein wasser;2==flut aktiv und wasser rinnt; 0==keine flut
		
		if(!living(ob)) {
			
			ob->move("/d/dschungel/trintrasil/hoehle/room/hoehle7", 
			M_GO+ M_SILENT+ M_NO_SHOW);
			call_out("flut8a", 1);
		}
	}
	
	else {
		
		if(!living(ob)) {
			
			ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
			M_GO+ M_SILENT);
			tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
			BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
			"Hoehle gespuelt."));
			call_out("flut8a", random(4));
		}
	}
}


BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/hoehle/room/hoehle7",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
}