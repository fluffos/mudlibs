//fertig und getestet
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";


create() {
	
	::create();

SetProp( P_INT_SHORT, "wird nie zu sehen sein" );
SetProp( P_INT_LONG, BS(
"deto"));
  
SetProp( P_LIGHT, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
SetProp(P_KILL_NAME, "eine Ueberflutung");
AddCmd ("", "no", 1);   

SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
int no() {
	
	write (BSL("\nDu bist von den Vorgaengen in der Hoehle zu gebannt."));
	return 1;
}


int njet() {
	
	write(BSL("\n!!!Du bist voll und ganz damit beschaeftigt nicht zu ersaufen!!!"));
	return 1;
}


init() {
	
	::init();
	if(query_once_interactive(this_player())) {
		
		call_out("flut1", 2);}
}
  

flut1() {
	
	NIX
	write(BSL("\nAus der Hoehle im Osten dringt ein eigenartiges Rumpeln."));
	call_out("flut2", 2);
}


flut2() {
	
	NIX
	write(BSL("\nDu hoerst ein Krachen und ein dann ein gewaltiges Rauschen, das "
	"schnell anschwillt!!"));
	call_out("flut3", 3);
}


flut3() {
	
	NIX
	write(BSL("\nDie gesamte Hoehle vibriert wie bei einem Erdbeben!"));
	call_out("flut4", 2);
}


flut4() {
	
	NIX
	write(BSL("\nDas Rauschen und Brausen laesst Dir beinahe das Trommelfell "
	"platzen. Du glaubst ein irres Kreischen zu hoeren."));
	call_out("flut5", 3);
}


flut5() {
	
	NIX
	write(BSL("\n"
	"   !!!!!WWWWWWWWWWWWWWWWWWWW!!!!!\n"
	"   !!!!!UUUUUUUUUUUUUUUUUUUU!!!!!\n"
	"   !!!!!SSSSSSSSSSSSSSSSSSSS!!!!!\n"
	"   !!!!!CCCCCCCCCCCCCCCCCCCC!!!!!\n"
	"   !!!!!HHHHHHHHHHHHHHHHHHHH!!!!!\n"));
	RemoveCmd("", "no");
	AddCmd("", "njet", 1);
	call_out("flut6", 2);
}


flut6() {
	
	NIX
	write(BSL("\nMit lautem Rauschen stuerzen gewaltige Wassermassen aus "
	"der Hoehle!"));
	call_out("flut7", 2);
}


flut7() {
	
	NIX
	write(BSL("\nDie Wasserflut reisst Dir die Beine weg und knallt Dich gegen "
	"den Fels!!"));
	TP->do_damage(10+random(10));
	call_out("flut7a", 1);
}


flut7a() {
	
	int i;
	object *inv;
	inv=all_inventory(TO);
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(!living(inv[i])) {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/eingang", M_GO+ 
			M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("flut8", 1);
}


flut8() {
	
	NIX
	write(BSL("\nIn dem wirbeldem Chaos schlaegst Du erschrocken mit Deinen Armen "
	"um Dich und bekommst gerade noch einen Felsvorsprung zu fassen!"));
	call_out("flut9", 2);
}


flut9() {
	
	NIX
	write(BSL("\nDu kannst nur mit Muehe verhindern, dass Du durch den Wasserfall "
	"in den Rio de la Puseta gespuelt wirst, in dem Du jaemmerlich ersaufen "
	"wuerdest."));
	call_out("flut10", 3);
}


flut10() {
	
	NIX
	write(BSL("\nTotal durchnaesst ziehst Du Dich auf eine hoeher gelegene, sichere "
	"Stelle."));
	call_out("flut11", 3);
}


flut11() {
	
	NIX
	write(BSL("\nZitternd wuergst Du das brennende Wasser aus, das in Deine Lungen "
	"geschossen ist."));
	call_out("flut12", 3);
}


flut12() {
	
	NIX
	write(BSL("\nDie gewaltigen Wassermassen donnern in den Rio de la Puseta. Was diese "
	"Ueberflutung wohl ausgeloest hat?"));
	TP->move("/d/dschungel/trintrasil/hoehle/room/eingang", M_GO+ M_NO_SHOW+
	M_SILENT);
	RemoveCmd("","njet");
	AddCmd("", "no", 1);
}


BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/hoehle/room/eingang",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	
	leiche=present("leiche", TO);
	
	if (leiche)  {
		
		leiche->move("d/dschungel/trintrasil/hoehle/room/eingang", M_TPORT+
		M_SILENT);
	}
	
	write_file("/d/dschungel/trintrasil/log/flut",
	ctime()+": Flut hat "+CAP(getuid(TP))+" umgebracht.\n");
}