//falle mit hebel
//felsen auf die man steigen kann
//schacht ausbauen

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";

#define HOEHLE8 "/d/dschungel/trintrasil/hoehle/room/hoehle8.lpc"
#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"
#define HOEHLE7 "/d/dschungel/trintrasil/hoehle/room/hoehle7.lpc"


reset() {
  ::reset();
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer grossen Hoehle" );
  SetProp( P_INT_LONG, break_string(
"Die gewoelbeartige Hoehle bildet hier eine Ausbuchtung nach Sueden. Die gelben Sandsteinwaende "
"sind glatt geschliffen und glaenzen nass im gelben Licht der Pilze. An der suedlichen Wand "
"liegen einige runde Felsen. Im Nordosten siehst Du den kleinen Teich mit den Leuchtpilzen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
AD(({"woelbung","ausbuchtung"}),
"Du befindest Dich hier in einer rund ausgewaschenen Ausbuchtung. Die Hoehle fuehrt nach "
"Norden und Nordosten weiter.");

AD(({"hoehle"}),
"Im Nordosten liegt ein kleiner Teich in den staendig Wasser von der Decke herab plaetschert. "
"Wenn Du aus der Ausbuchtung nach Norden gehst kannst Du ihr auch noch weiter nach Westen "
"folgen.");

AD(("norden"),
"Nach Norden gehst Du aus der Ausbuchtung heraus.");

AD(("nordosten"),
"Wenn Dich der Teich interessiert, dann geh nach Nordosten.");

AD(("westen"),
"Wenn Dich Deine Orientierung nicht taeuscht, muesste die Hoehle im Westen aber bald enden.");

AD(("orientierung"),
"Westlich von hier muesste der Fluss liegen. Also wird die Hoehle im Westen entweder bald enden "
"oder vielleicht sogar unter dem Fluss durch fuehren.");

AD(({"fluss","rio","rio de la puseta"}),
"Die Hoehle in der Du Dich befindest windet sich durch die oestliche Uferwand des Rio de la "
"Puseta.");

AD(({"uferwaende","uferwand","schluchtwaende","schluchtwand"}),
"Du kennst die hohen, gewaltigen Sandsteinwaende der Schlucht sicher, durch die der Rio de la "
"Puseta fliesst.");

AD(("schlucht"),
"Der Rio de la Puseta fliesst hier von hohen Uferwaenden eingefasst tief in einer Schlucht. Er "
"muesste westlich liegen.");

AD(("decke"),
"Als Du an die Decke blickst faellt Dir ein Loch auf.");

AD(({"etwas","loch"}),
"In der suedlichen Wand knapp unterhalb der Decke befindet sich ein waagrechter Schacht.");

AD(("schacht"),
"Der Schacht ist eindeutig kuenstlich angelegt worden und breit genug, dass ein Mensch "
"hineinkriechen koennte.");

AD(("mensch"),
"Du koenntest den Schacht erreichen, wenn Du auf die Felsen steigst.");

AD(("murmeln"),
"Du glaubst leise Stimmen zu hoeren.");
  
AD(({"stimme","stimmen"}),
"Die Stimmen klingen weit entfernt und sind kaum noch zu hoeren. Sie scheinen von der "
"Decke zu kommen.");

AD(({"wand","suedliche wand"}),
"Die suedliche Wand ist stark gewoelbt. Ein paar grosse Felsen liegen davor. Als Du die "
"Wand entlang blickst faellt Dir knapp unter der Decke etwas auf.");

AD(({"boden","sand","schwemmsand"}),
"Der Boden ist mit dem gleichen feinen Schwemmsand wie in der uebrigen "
"Hoehle bedeckt.");     

AD(("licht"),
"Das Licht ist ziemlich schwach, aber es genuegt, um die ganze Hoehle in einen gelben Schimmer "
"zu tauchen.");

AD(("schimmer"),
"Das Licht kommt von den seltsamen Pilzen im Nordosten.");

AD(({"pilz","pilze","leuchtpilz","leuchtpilze"}),
"Die Pilze wachsen im Nordosten um den kleinen Teich.");

AD(({"naehe","teich"}),
"Wenn Du nach Nordosten gehen wuerdest koenntest Du den Teich und die Pilze aus der Naehe "
"bewundern.");

AD(("wasser"),
"An den glatten Waenden rieselt Wasser herab.");

/*

AD(({"gestein","sandstein","stein"}),
"Die Waende dieser Hoehle bestehen aus gelbem, nass schimmernden Sandstein.");

AD(({"sandsteinwaende","steinwaende","hoehlenwaende","waende","sandsteinwand","steinwand",
"hoehlenwand","wand"}),
"Die Hoehlenwaende sind vom Wasser glatt poliert und schlaengeln sich weich und "
"rund nach Westen.");
  

AD(("plaetschern"),
"Das Plaetschern kommt aus Westen.");
*/

 
  AddExit("nordosten", ("/d/dschungel/trintrasil/hoehle/room/hoehle10"));
  AddExit("norden", ("/d/dschungel/trintrasil/hoehle/room/hoehle12"));



  AddSound( DEFAULT_SOUND,
    "Im Nordosten hoerst Du ein bestaendiges Plaetschern. Ausserdem faellst Dir ein leises "
    "Murmeln auf.");
  
  AddSound(("murmeln"),
  "Du glaubst leise Stimmen zu hoeren.");
  
  AddSound(({"stimme","stimmen"}),
  "Die Stimmen klingen weit entfernt und sind kaum noch zu hoeren. Sie scheinen von der "
  "Decke zu kommen.");
  
  AddSound(({"plaetschern","geplaetscher","plitsch","platsch"}),
  BSL("  ! PLITSCH !\nplatschplatsch\n     PLITSCH\n PLITSCH\nIm Nordosten rinnt Wasser "
  "von der Decke in einen Teich."));

}
  


//§§§§§§§§§§§§§§§§§§§§§§§§§§§§§ SPECIAL DETAILS ANFANG §§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§

hebel() {
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BS("Der Hebel auf der Stahltuer dient dazu die Tuer fest zu "
		"verschliessen."));
	}
	
	else {
		return(BS("Die Tuere ist geschlossen und der Hebel nach unten gedrueckt."));
	}
}

	
schieber() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BS("Durch den Tuerschieber kannst Du schauen, ob sich wer im "
		"Gang befindet, wenn die Tuer geschlossen ist."));
	}
	
	else {
		return(BS("Wenn Du durch den Tuerschieber schaust, erkennst Du, ob "
		"sich wer im Gang hinter der Tuer befindet."));
	}
}


faustbild() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BSL("\n\n"
		"        _______\n"
		"       | | | | |_\n"
		"       |_| | | | |\n"
		"        ||_|_|_| |\n"
		"        |        /\n"
		"         \\   ___/\n"
		"          | || |\n"
		"          | || |\n\n\n"));
	}
	
	else {
		return(BS("Die Stahltuer ist jetzt geschlossen. Das Bild der Faust befindet "
		"sich auf der anderen Seite."));
	}
}


gang() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/hoehle/room/hoehle8")==1) {
		
		return(BS("Hinter der Stahltuer liegt ein Gang, der nach Nordosten "
		"fuehrt."));
	}
	
	else {
		return(BS("Die Tuer ist geschlossen. Wenn Du durch den Tuerschieber spaehst, "
		"koenntest Du in den Gang sehen."));
	}
}
	
