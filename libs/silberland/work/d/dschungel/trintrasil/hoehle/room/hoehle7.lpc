//fertig
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";

int muschel=1;
int stamm=1;

  
reset() {
::reset();
muschel=1;}

void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  
  SetProp( P_INT_LONG, break_string(
"Du stehst in einem ca 4 Meter langen ovalen Raum. Nach Suedwesten kommst "
"Du zurueck in die Sandsteinhoehle. In der Decke des Raumes ist eine "
"sehr massiv aussehende Eisenplatte eingelassen aus deren Ritzen in "
"harten Strahlen Wasser herab schiesst. Die Eisenplatte wird von einem "
"dicken Stamm gestuetzt den jemand senkrecht unter sie gekeilt hat. Das "
"Wasser schiesst anscheinend unter hohem Druck aus der Ritze zwischen "
"Steindecke und Eisenplatte und darunter einen kleinen "
"Teich."));

  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );
  SetProp( P_INDOORS, 1 );
  SetProp( P_LIGHT, 1 );
  
 
  AD(({"platte","eisenplatte","metallplatte"}),
    "Welchen Zweck diese Eisenplatte wohl hat? Sie steht anscheinend unter "
    "hohem Druck.");

  AD(("raum"),
    "Der ovale Raum ist ca 4 meter lang und genauso hoch. In der Mitte befindet "
    "sich ein kleiner Teich.");
    
  AD(("mitte"),
    "In der Mitte des Raumes hat sich ein kleiner Teich gebildet.");
    
  AD(({"druck","zweck","wasserdruck"}),
    "Wasser schiesst in harten Strahlen aus der Ritze zwischen Platte und "
    "Gestein. Vielleicht ist die Platte so etwas wie eine Schleuse.");
  
  AD(("schleuse"),
    "Die Eisenplatte haelt vielleicht das Wasser des ´Rio de la Puseta´ davon "
    "ab die Hoehle zu ueberfluten.");
    
  AD(({"rio","puseta","rio de la puseta"}),
    "Jetzt weisst Du auch warum die Hoehle nicht ueberflutet ist obwohl sie "
    "direkt unter dem ´Rio de la Puseta liegt.");
    
  AD(({"hoehle","sandsteinhoehle"}),
    "Die Hoehle in der Du gerade stehst. Vielleicht kann man die Schleuse ja "
    "auch oeffnen. Dann solltest Du aber besser nicht mehr hier sein.");
       
  AD(({"wand","waende"}),
    "Die Waende in diesem Raum sind vollkommen glatt. Anscheinend wurden sie "
    "vom Wasser so glatt gespuelt.");
    
  AD(({"wasser"}),
    "Wasser schiesst mit einem zornigen Zischen zwischen den Ritzen der "
    "Eisenplatte hervor und bildet einen kleinen Teich.");
    
  AD(({"teich"}),
    "Der Teich ist nicht einmal ganz 2 meter breit. Dort scheint das Wasser "
    "dann im sandigen Boden zu versickern. Obwohl der Teich sicher nicht tief "
    "ist kannst Du den Grund nicht sehen.");
  
  AD(("grund"),
    "Der Teich schimmert schwarz und undurchsichtig. Die Oberflaeche kraeuselt "
    "sich unruhig durch das herabschiessende Wasser.");
    
  AD(("oberflaeche"),
    "Es reizt Dich die Hand in den dunklen Teich zu halten.");
  
  AD(("hand"),
    "Halte die hand in den Teich.");
        
  AD(({"boden"}),
    "Der Boden ist hier mit feinem, weiss schimmernden Sand bedeckt.");
    
  AD(({"sand","schwemmsand"}),
     "Der Sand ist ziemlich fein. Er sieht aus wie der typische Schwemmsand "
     "den Wasserlaeufe mit sich fuehren."); 
     
  AD(({"lauf","wasserlauf","wasserlaeufe","laeufe"}),
    "Der Wasserlauf der anscheinend frueher durch diese Hoehle floss wird nun "
    "durch die Schleuse abgehalten.");
    
  AD(({"decke","steindecke"}),
    "Inmitten der Decke ist eine sehr massiv aussehende Eisenplatte "
    "eingelassen.");
  
  AD(({"ritze","ritzen"}),
    "Die Eisenplatte ist beinahe 4 Meter ober Dir. Da Wasser aus den Ritzen "
    "zwischen der Decke und der Platte hervor schiesst denkst Du Dir das die "
    "Eisenplatte anscheinend unt ziemlich hoehem Wasserdruck steht.");
  
  AD(({"strahl","strahlen","zischen"}),
    "Mit einem zornigen Zischen schiesst das Wasser von der Decke in den "
    "Teich.");
  
  AD(("gestein"),
    "Der gleiche Sandstein wie in der uebrigen Sandsteinhoehle.");
  
  AD(({"sandstein","stein"}),
    "Das Aussehen des Gesteins ist in der ganzen Hoehle so ziemlich das "
    "gleiche.");
    
  AD(({"gelb","aussehen"}),
    "Die Waende schimmern in einem sanften Gelb.");  
 
  ASD(({"muschel","teichmuschel"}),
    "muschel"); 
  
  ASD(({"stamm","baumstamm","baum"}), 
    "baumstamm");
  
  AD(("stock"),
    "Ein ganz normaler Stock wuerde reichen. Wenn sich die Muschel in diesen "
    "verbeisst kannst Du sie herausziehen.");


  AddSound(DEFAULT_SOUND, BSL("  ! ! ! PPPSSSSSSCCCCCHHHHHHHHHHHHHHH ! ! !\nWasser schiesst "
  "mit hohem Druck aus den Ritzen der Metallplatte hervor."));
   
 
  AddCmd(({"stosse"}), "func_stamm");
  AddCmd(({"halte"}), "func_muschel");
  
       
  AddExit("suedwesten", "./hoehle4"); 

}


_query_int_long()  {
       
   if(stamm==1)  {
   
  return (BS(
  "Du stehst in einem ca 4 Meter langen ovalen Raum. Nach Suedwesten kommst "
  "Du zurueck in die Sandsteinhoehle. In der Decke des Raumes ist eine "
  "sehr massiv aussehende Eisenplatte eingelassen aus deren Ritzen in "
  "harten Strahlen Wasser herab schiesst. Die Eisenplatte wird von einem "
  "dicken Stamm gestuetzt, den jemand senkrecht unter sie gekeilt hat. Das "
  "Wasser schiesst anscheinend unter hohem Druck aus der Ritze zwischen "
  "Steindecke und Eisenplatte und bildet darunter einen kleinen Teich."));
       }

  else  {   
	
  return (BS(
  "Du stehst in einem ca 4 meter langen ovalen Raum. Nach suedwesten kommst "
  "Du zurueck in die Sandsteinhoehle. In der Decke des Raumes ist eine "
  "sehr massiv aussehende Eisenplatte eingelassen aus deren Ritzen in "
  "harten Strahlen Wasser herab schiesst. Direkt unter der Eisenplatte liegt "
  "ein umgestuerzter Baumstamm. Das Wasser schiesst anscheinend unter hohem "
  "Druck aus der Ritze zwischen Steindecke und Eisenplatte und bildet darunter "
  "einen kleinen Teich."));
       }

}



int func_muschel(string str) {
	
	object stock;
	stock=present("stock", TP);
	
	notify_fail("Was willst Du in den Teich halten?\n");
	
	if(str=="hand in wasser"||str=="hand ins wasser"||str=="hand in teich"||
	str=="hand teich"||str=="hand wasser")  {
		
		if(muschel) {
			
			write(BS("Du haeltst Deine Hand in den Teich und beobachtest "
			"belustigt die kleinen Wellen die Du verursachst und wie Dir "
			"das Wasser durch die Finger rinnt."));
			say(BS(""+TPN+" haelt seine Hand in den kleinen Teich und zuckt "
			"fluchend zurueck."));
			call_out("muschel1", 3);
			return 1;
		}
		
		if(!muschel) {
				
			write(BS("Du haeltst Deine Hand in den Teich und beobachtest "
			"belustigt die kleinen Wellen die Du verursachst und wie Dir "
			"das Wasser durch die Finger rinnt."));
			say(BS(""+TPN+" haelt seine Hand in den kleinen Teich und "
			"spielt mit dem Wasser."));
			return 1;
		}
	}
	
	if(str=="stock in wasser"||str=="stock ins wasser"||str=="stock in teich"||
	str=="stock teich"||str=="stock wasser") {
		
		if(!stock) {
			
			write(BS("Du hast ja gar keinen Stock!\n"));
			return 1;
		}
		
		if(stock && !stock->QueryWielded()) {
			
			write(BS("Du musst den Stock schon zuecken.\n"));
			return 1;
		}
		
		if(stock && stock->QueryWielded() && muschel) {
			
			write(BSL("\nVorsichtig haeltst Du den Stock in den Teich.\n "
			"   ! ! ! ! ! ZACK ! ! ! ! !\n"
			"Tatsaechlich, wie erwartet schnappt die Muschel in den "
			"Stock."));
			say(BSL("\n"+TPN+" haelt vorsichtig einen Stock in den Teich.\n "
			"   ! ! ! ! ! ZACK ! ! ! ! !\n"
			"Eine Teichmuschel schnappt in den Stock.\n"));
			call_out("muschelheraus", 3);
			return 1;
		}
		
		if(stock && stock->QueryWielded()&&!muschel) {
			
			write(BS("Du stocherst mit dem Stock im Teich herum, er ist "
			"aber leer."));
			say(BS(""+TPN+" stochert mit einem Stock im Teich herum, findet "
			"aber nichts."));
			return 1;
		}
	}
}

muschel1() {
	
	write(BSL("\nPloetzlich siehst Du eine hektische Bewegung im Wasser.\n"
	"   ! ! ! ! ! ZAAACK ! ! ! ! !\n"
	"Du hast zufaellig in eine Teichmuschel gegriffen die sofort "
	"zuschnappt."));
        TP->do_damage(5+random(7));  
}

    
     
muschelheraus() {
	
	object teichmuschel; {
		
		write(BS("Du ziehst die Muschel am Stock aus dem Wasser."));
		say(BS(""+TPN+" zieht eine Muschel am Stock aus dem Wasser."));
		teichmuschel=CLONEOB("/d/dschungel/trintrasil/hoehle/npc/teichmuschel.lpc");
		teichmuschel->move(environment(TP), M_TPORT);
		teichmuschel->Kill(TP);
		muschel--;
	}
}

    
  
int func_stamm(string str) {
	
	notify_fail("Was willst Du umstossen?\n"); 
	
	if(str=="stamm um"||str=="stamm weg"||str=="stamm beiseite"||str=="baum weg"||
	str=="baum um"||str=="baum beiseite"||str=="baumstamm um"||
	str=="baumstamm beiseite"||str=="baumstamm weg")   {
		
		if(stamm==1)  {
			
			stamm=0;
			write(BSL("Du stemmst Dich mit aller Kraft gegen den Stamm. "
			"Er ist sehr fest unter die Eisenplatte gekeilt, aber langsam "
			"neigt er sich zur Seite und faellt krachend um.\nHoffentlich "
			"bricht nun die Eisenplatte nicht durch."));
			say(BSL(""+TPN+" stemmt sich mit aller Kraft gegen den Stamm. "
			"Der Stamm ist anscheinend sehr fest unter die Eisenplatte "
			"gekeilt, aber langsam neigt er sich zur Seite und faellt "
			"krachend um.\nHoffentlich bricht nun die Eisenplatte nicht "
			"durch.\n"));
			return 1;
		}
		
		if (stamm==0)  {
			
			write(BS("Der Stamm liegt doch schon am Boden! Wie willst Du ihn "
			"da umstossen?"));
			say(BS(""+TPN+" ruettelt geistig verwirrt an dem am Boden "
			"liegendem Stamm herum."));
			return 1;
		}
	}
}


//$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§  SPECIAL DETAILS  $§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§

baumstamm()  {
	
	if(stamm==1) {
		
		return BS("Der Stamm ist sehr massiv und soll anscheinend die Eisenplatte "
		"stuetzen. Wenn Du irgend etwas mit der Platte vor hast musst Du "
		"den Stamm wahrscheinlich erst umstossen.");
	}
	
	if(stamm==0) {
		
		return BS("Der Stamm wurde von "+CAP(getuid(TP))+" umgestossen.");
	}
}

	    
muschel() {
	
	if(muschel) {
		
		return BS("Im Teich lebt eine Teichmuschel. Mit der Hand kannst Du sie "
		"nicht herausholen. Du koenntest aber einen Stock in den Teich "
		"halten.");
	}
	
	if(!muschel) {
		
		return BS("Du greifst in den Teich, aber er ist leider leer.");
	}
}

//$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§  ENDE  $§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§$§

//"""""""""""""""""""""""""""""" ABFRAGEFUNKTIONEN """""""""""""""""""""""""""""""""""""""""""""""""""""

baum_status() {
	
	return stamm;
}


resetfunc() {
    
    stamm=1;
}

    
//;;;;;;;;;;;;;;;;;;;;;;;;;;;; WIRD BEI FLUT AUFGERUFEN ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;     

fluttod() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/tod-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 5);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}         