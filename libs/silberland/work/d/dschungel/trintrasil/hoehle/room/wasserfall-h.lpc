
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";



create() {
	
	::create();

SetProp( P_INT_SHORT, "kurz vor dem Ertrinken" );
SetProp( P_INT_LONG, BS(
"Sollte niemand sehen."));
  
SetProp( P_LIGHT, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
AddCmd ("", "no", 1);   

SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}


int no() {
	
	write("Du bist ganz fasziniert vom Wasserfall.\n");
	return 1;
}


int njet() {
	
	write(BS("!!!Du ruderst panisch mit den Armen um nicht zu ertrinken!!!"));
	return 1;
}


init() {
	::init();
	
	if(query_once_interactive(this_player())) {
		
		call_out("wfall1", 2);
	}
}


wfall1() {
	
	NIX
	write(BSL("\nMit einem leichten Schenkeldruck steuerst Du den Fisch auf den "
	"Wasserfall zu."));
	call_out("wfall2", 3);
}


wfall2() {
	
	NIX
	write(BSL("\nWiderwillig folgt der Fisch Deiner Richtung."));
	call_out("wfall3", 3);
}


wfall3() {
	
	NIX
	write(BSL("\nDie Stroemung und die Wellen werden immer staerker. Du klammerst "
	"Dich fest an den Ruecken des Fisches."));
	call_out("wfall4", 4);
}


wfall4() {
	
	NIX
	write(BSL("\nFasziniert betrachtest Du den tosenden Wasserfall vor Dir als der "
	"Fisch, aufgescheucht durch die Stroemung ploetzlich einen unerwarteten "
	"Satz macht, und Dich abwirft."));
	RemoveCmd("", "no");
	AddCmd("", "njet", 1);
	call_out("wfall5", 2);
}


wfall5() {
	
	NIX
	write(BSL("\nDie Wucht des Wasserfalles reisst Dich augenblicklich nach "
	"unten!!"));
	call_out("wfall6", 3);
}


wfall6() {
	
	NIX
	write(BSL("\nIn dem schaeumendem Wirbel wirst Du nach unten gedrueckt, bis Du Grund "
	"unter Dir fuehlst."));
	call_out("wfall7", 2);
}


wfall7() {
	
	NIX
	write(BSL("\nDeine Ohren singen vom Wasserdruck"));
	call_out("wfall8", 2);
}


wfall8() {
	
	NIX
	write(BSL("\nDu stoesst Dich ab und strampelst auf die ueber Dir schimmernde "
	"Oberflaeche zu."));
	call_out("wfall9", 3);
}


wfall9() {
	
	NIX
	write(BSL("\nEndlich tauchst Du auf und fuellst Dein Lungen gierig mit Luft."));
	call_out("wfall10", 2);
}


wfall10() {
	
	write(BSL("\nDu bist zufaellig in einer Hoehle hinter dem Wasserfall aufgetaucht.\n\n"));
	tell_room("/d/dschungel/trintrasil/hoehle/room/eingang", BS(""+TPN+" taucht "
	"prustend und keuchend auf."));
	TP->move("/d/dschungel/trintrasil/hoehle/room/eingang", M_GO+ M_SILENT);
	RemoveCmd("","njet");
	AddCmd("","no", 1);
}

BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/hoehle/room/eingang",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
}



void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	
	leiche=present("leiche", TO);
	
	if (leiche)  {
		
		leiche->move("d/dschungel/trintrasil/hoehle/room/eingang", M_TPORT+
		M_SILENT);
		tell_room("d/dschungel/trintrasil/hoehle/room/eingang", BSL("\nDie Leiche "
		"von "+CAP(getuid(TP))+" wird angespuelt! Schrecklich!"));
	}
	
	write_file("/d/dschungel/trintrasil/log/flut",
	ctime()+": "+CAP(getuid(TP))+" ist im Wasserfall gestorben.\n");
}