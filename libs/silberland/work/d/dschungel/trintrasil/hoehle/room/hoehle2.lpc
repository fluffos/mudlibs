//fertig
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Im Westen steht die Hoehle unter Wasser, nach Nordosten fuehrt sie auf "
"trockenem Boden tiefer in den Fels. In der engen spaltfoermigen Hoehle "
"musst Du Dich ducken um Dir nicht den Kopf an der Decke zu stossen. "
"Die Waende sind so eng aneinander gerueckt, dass Du sie stellenweise beinahe "
"mit Deinen Schultern streifst."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"fisch"}),
    "Finde Dich damit ab, er hat Dich verlassen.");

  AD(({"hoehle"}),
    "Die engen, gelben Sandsteinwaende der Hoehle schimmern nass. Leise rieselt "
    "Wasser von der Decke herab.");
    
  AD(({"sandsteinwaende","waende","wand","sandsteinwand","hoehlenwand"}),
    "Die Waende sind der Laenge nach mit gelb-orangen Streifen durchzogen.");
    
  AD(({"streifen","linie","linien"}),
    "Gelbliche Linien unterschiedlich gefaebten Gesteins ziehen sich durch "
    "die Hoehlenwand.");
    
  AD(("laenge"),
    "Die Hoehle scheint noch weit in das Gestein zu fuehren.");
    
  AD(("decke"),
    "Die Waende laufen spitz zusammen.");
    
  AD(("gestein"),
    "Das Gestein um Dich herum ist ausschließlich Sandstein.");
    
  AD(({"boden"}),
    "Der Boden ist hier mit grobem, feuchtem Sand bedeckt. Da im westen der "
    "Boden absinkt steht die Hoehle dort unter Wasser.");
  
  AD(({"sand"}) ,  
    "Der Sand scheint hier aus dem Fels geschuerft worden zu sein.");
    
  AD(({"sandstein","stein"}),
    "Der Sandstein schimmert in deinem Licht in den unterschiedlichsten "
    "Gelbtoenen.");
    
  AD(({"wasser"}),
    "Wenn man bedenkt das der Sandstein doch recht poroes ist und die "
    "Hoehle beinahe direkt unter einem Bachlauf liegt, rieselt hier recht "
    "wenig Wasser von der Decke.");
  
  AD(({"bachlauf","bach"}),
    "`Zehn Ochsen` muesste beinahe direkt ueber Dir sein.");
    
  AD(({"zehn ochsen","zehn","ochse"}),
     "Den Bach kennst Du doch schon."); 
     
  AD(({"gelbtoene","toene","faerbung"}),
    "Erstaunlich warum der Sandstein keine einheitlich Faerbung hat. ");
    
  AD(({"schultern"}),
    "Stellenweise kannst Du Dich nur noch schwer vorwaerts schieben, die Hoehle "
    "scheint gegen nordostoben aber breiter zu werden.");
    
  AD(({"kopf"}),
    "!!AU!! \n Na bitte schon hast Du eine Beule.");
   
  AD(({"beule"}),
     "Die schwillt sicher auf.");

  AD(({"platz"}),
    "Durch die Windungen der Hoehle kannst Du sie nicht weit einsehen.");

  AD(({"windungen"}),
    "Die Hoehle schlaengelt sich unfoermig durch den Fels.");
    
  AD(({"licht","schein"}),
    "Der Schein wird roetlich von den feuchten Waenden zurueckgeworfen.");
    
  AD(("fels"),
    "Von einem versiegten Wasserlauf geformt, schlaengelt sich die Hoehle "
    "unfoermig durch den gelb-orangen Sandstein.");
    
  AD(("wasserlauf"),
    "Die plank gescheuerten Waende sehen aus als waeren sie vom Wasser "
    "auspoliert worden.");
       
  AddExit( "westen", "./hoehle1" );

  AddExit( "nordostoben", "./hoehle3" );


  AddSound( DEFAULT_SOUND,
   "Leise rieselt Wasser von der Decke.");
 
  AddSound(("wasser"),
  "plitsch, plitsch, platsch");
}


flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}