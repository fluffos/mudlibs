//fertig und getestet
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Sandsteinhoehle" );
  SetProp( P_INT_LONG, break_string(
"Der Gang ist nur knapp 1 Meter breit und 2 Meter hoch. Nach Norden fuehrt "
"er in einen breiteren Gang, im Sueden endet er bereits nach einem kurzen Stueck. "
"Die in der restliche Hoehle schraegen und welligen Waende sind "
"hier so glatt und gerade als waeren sie bearbeitet worden."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  

 
  AD(({"hoehle","felshoehle"}),
    "Die Hoehle windet sich sonst ungezaehmt und unregelmaessig in den Fels. "
    "Nur dieser Gang ist unnatuerlich geordnet und begradigt, eine seltsame "
    "Laune der Natur.");
  
  AD(("stueck"),
    "Der Gang endet nach Sueden recht abrupt. Wer hat die Waende dieses kurzen, "
    "anscheinend sinnlosen Ganges ueberhaupt behauen?");
    
  AD(({"wer","jemand","felshauer","behauer"}),
    "Anscheinend ist diese abgelegene Hoehle doch nicht so verlassen.");
    
  AD(("natur"),
    "Nein die Natur schert sich sicher nicht um menschliche Ordnung.");
    
  AD(("ordnung"),
    "Warum sollte sie?");
    
  AD(("laune"),
    "Nein, dieser Gang wurde sicher geformt.");
 
  AD(("gang"),
    "Dieser auffaellig regelmaessige Gang endet schon nach wenigen Metern.");
    
  AD(({"fels"}),
    "Da ein Wasserlauf diese Hoehle ausgewaschen hat, wurde weiches Gestein "
    "abgetragen und hartes umspuelt. Dadurch schlingt sich die Hoehle "
    "normalerweise den Schichten aus weichem Gestein folgend unregelmaessig "
    "in den Fels. Nur hier scheint das anders zu sein.");
    
  AD(("schichten"),
    "Dunkle, dichte und hellere weichere Schichten wechseln einander ab und "
    "geben den Hoehlenwaenden ihre sanften gelborangen Faerbungen.");
    
  AD(({"wasserlauf","wasser"}),
    "Der Gang hier ist trocken. Wohin der Wasserlauf verschwunden ist kannst Du "
    "Dir nicht erklaeren.");
    
  AD(({"waende","wand","hoehlenwaende","hoehlenwand"}),
    "Die senkrechten Waende schimmern glatt und gehen ueber Dir perfekt in eine "
    "gewoelbte Decke wieder.");
    
  AD(("decke"),
    "Der Fels wurde hier so poliert das die sanften Faerbungen des Gesteins "
    "deutlich sichtbar sind.");
    
  AD(({"faerbungen","farbtoene","toene","gelbtoene"}),
    "Milde, gelborange Farbtoene des Sandsteins.");
    
  AD(({"gestein"}),
    "Der Sandstein schimmert in sanften Gelbtoenen.");
    
  AD(({"stein","sandstein"}),
    "Der gesamte Fels hier besteht aus gelbem Sandstein.");
    
  AD(("boden"),
    "Der Boden ist hier mit feinem, gelbem Sand bedeckt. Als Du ihn genauer "
    "untersuchst fallen Dir viele seltsame Abdruecke auf.");
  
  AD(("abdruecke"),
    "Die Abdruecke sind Fussspuren die direkt auf die suedwestliche Felswand "
    "zulaufen. Taste die Wand doch einmal ab.");
      
  AD(({"fussspuren","spuren"}),
    "Du kannst Spuren von Stiefeln erkennen. Der Groesse nach waren die Personen "
    "ca menschengross.");
    
  AD(({"stiefel","stiefeln"}),
    "Du kannst unterschiedliche Spuren entdecken. Alle scheinen Stiefel getragen zu "
    "haben.");
    
  AD(("groesse"),
    "Jemand versuchte sehr schlampg die Spuren zu verwischen. Daher kannst Du es nicht "
    "genau erkennen.");
    
  AD(("personen"),
    "Seltsam, Du erkennst, dass jemand schlampig die Spuren verwischen wollte. "
    "Die Stiefeltraeger wollten anscheinend nicht entdeckt werden.");
    
  AD(({"traeger","stiefeltraeger"}),
    "Vielleicht solltest Du vorsichtig sein. Bei Personen die Gruende haben sich zu "
    "verstecken kann man nie wissen.");

  AD(("gruende"),
    "Wer weiss in was Du da hinein geraetst.");
        
  AD(({"suedwestliche wand","felswand","suedwestliche felswand"}),
    "Alle Spuren enden abrupt vor der Felswand als waeren ihre Verursacher "
    "geradewegs durch die Wand gegangen.");
    
  AD(({"verursacher"}),
    "Die Wand sieht sehr massiv aus, aber Du koenntest sie ja einmal abtasten.");
  
  AD(({"sand"}) ,  
    "Der Sand wurde wahrscheinlich von einem Wasserlauf von den Waenden "
    "geschuerft.");
   
  AD(({"zauber","illusionszauber","illusion"}),
    "Der Illusionszauber tarnt einen Gang der nach Suedwesten fuehrt. Du "
    "koenntest also einfach nach Suedwesten gehen.");
  
  AD(("kribbeln"),
    "Als Du die Hand zurueckziehst hoert das Kribbeln auf. Der Zauber tarnt "
    "einen Gang der nach Suedwesten fuehrt. Du koenntest also einfach nach "
    "Suedwesten gehen.");
       
  AD(("widerstand"),
    "Hinter dem Illusionszauber fuehrt der Gang weiter nach Suedwesten. Du "
    "koenntest also einfach nach Suedwesten gehen.");
    
  AddCmd(({"taste","betaste","beruehre"}), "func_illusion");
      
  AddExit( "norden", "./hoehle4" );

  SetProp (P_HIDE_EXITS, ({"suedwesten"}));
  
  AddExit("suedwesten", ([
          EX_FUNC:"cypresshill",
          EX_PLMSG:"Du spuert ein kuehles Prickeln und Ziehen als Du durch "
                   "den Illusionszauber trittst.\n\n"]));
                   
   AddSound(DEFAULT_SOUND, "Dir faellt, fast ueberdeckt vom Plaetschern in der "
   "Hoehle, ein leises Zischen auf.");
   
   AddSound(("zischen"), "Das Zischen ist gleichmaessig und fast unhoerbar. Du kannst "
   "leider nicht sagen wo es her kommt.");
   
   AddSound(({"wasser","plaetschern"}), "Aus dem Norden hoerst Du das Plaetschern von Wasser, "
   "das von der Decke tropf.");

}

cypresshill() {
	
	TPM("/d/dschungel/trintrasil/hoehle/room/hoehle8", M_GO, "mit einem "
	"leisen Zischen durch die suedwestliche Wand", "verschwindet", 
       "tritt mit einem leisen Zischen aus der nordoestlichen Wand");
       return 1;
}


func_illusion(string str) {
	
	notify_fail("Was willst Du abtasten?\n");
	
	if(str=="wand ab"||str=="wand"||str=="suedwestliche wand ab"||
	str=="suedwestliche wand"||str=="suedwestwand ab"||str=="suedwestwand"||
	str=="felswand"||str=="suedwestliche felswand") {
		
		write(BS("Du erwartest auf festen Widerstand zu stossen, aber Du greifst "
		"mit der Hand durch die Wand. Ausser einem kuehlen Kribbeln fuehlst Du "
		"nichts. hier hat jemand einen permanenten Illusionszauber errichtet!"));
		say(BS(""+TPN+" faehrt zoegernd mit der Hand durch die suedwestliche "
		"Wand."));
		return 1;
	}
}



flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/flut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/eingang",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/eingang",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}