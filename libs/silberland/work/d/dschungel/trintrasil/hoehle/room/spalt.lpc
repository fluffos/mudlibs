
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define AMOEBE "/d/dschungel/trintrasil/hoehle/room/amoebe-h"
#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

inherit "/std/room";


init() {
	::init();
	
	if( query_once_interactive(this_player()) && AMOEBE->amoebepresent()==1 ) {
		
		call_out("am1", 4);
	}
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Du befindest Dich nun in einem sehr engen Spalt in dem Du kaum Luft bekommst. "
"Du kannst kaum Deinen Kopf drehen und kriechst keuchend durch den glitschigen "
"Fels."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
  SetProp(P_KILL_NAME, "gewaltige Wassermassen");
 
  AD(({"spalt"}), 
    "Der Spalt ist so eng das Du beinahe stecken bleibst. Als Du aber nach oben "
    "blickst siehst Du wie sich die Waende im Dunklen verlaufen.");

  AD(("kopf"),
    "Du kannst Deinen Kopf kaum bewegen.");
    
  AD(({"dunkel","dunklen"}),
    "Die Waende erdruecken Dich beinahe, aber trotzdem scheint der Spalt "
    "sehr hoch zu sein. Du kannst ober Dir keine Decke erkennen.");
  
  ASD(("decke"),
    "decke");  
  
  AD(({"sandsteinwaende","waende","wand","sandsteinwand","hoehlenwand"}),
    "Die Waende sind der Laenge nach mit gelb-orangen Streifen durchzogen.");
    
  AD(({"streifen","linie","linien","farben"}),
    "Gelbliche Linien unterschiedlich gefaebten Gesteins ziehen sich durch "
    "die Hoehlenwand.");
    
  AD(("unebenheit"),
    "Wenn Du Dich an dieser Mulde im Gestein fest haeltst, koenntest Du Dich "
    "daran hoch ziehen.");
    
  AD(("mulde"),
    "Ziehe Dich an Mulde hoch.");
    
  AD(("gestein"),
    "Das Gestein um Dich herum ist ausschließlich Sandstein.");
  
  AD(({"stein","sandstein","kaelte","fels"}),
    "Der gelbe Sandstein ist nass und kalt. Du moechtest diesen engen Spalt "
    "so schnell wie moeglich verlassen.");
    
  AD(("laenge"),
    "Die Enge und nasse Kaelte hier hindert Dich daran die schoenen Farben des "
    "Sandsteins zu bewundern.");  
  
  AD(({"luft","atem"}),
    "Dein keuchender Atem bildet kleine Dampfwoelkchen vor Dir, schnell raus "
    "aus diesem unangenehmen Spalt.");
    
  AD(({"enge","dampf","woelkchen","dampfwoelkchen"}),// VERLASSENSGESCHICHTE (beast9)
    "Du kannst Dich kaum umdrehen, leichte Panik kommt in Dir hoch."); 
  
  AD(("panik"),
    "DIE WAENDE DRUECKEN DICH ZUSAMMEN!");
    
  AD(({"boden"}),
    "Die Waende laufen so spitz zusammen das der Spalt eigentlich gar keinen "
    "Boden hat.");



  
  AddCmd(({"richte","stehe","steh"}), "func_aufrichten");
  
  AddCmd(({"ziehe","zieh"}), "func_mulde");
  
  AddCmd(({"lege","leg"}), "func_hinlegen");

   
    
  AddExit("suedosten", ([
          EX_FUNC:"suedo"]));
  AddExit("westen", ([
          EX_FUNC:"westen"]));
  
  
  AddSound( DEFAULT_SOUND,
    "Leise rieselt Wasser von der Decke.");
 
  AddSound(("wasser"),
    "plitsch, plitsch, platsch"); 
 

  }



int suedo() {
	
	if(!TP->QueryProp("staender")) {
		
		write(BSL("\nDu kriechst nach suedosten aus dem Spalt.\n\n"));
		TPM("/d/dschungel/trintrasil/hoehle/room/amoebe", M_GO,
		"nach suedosten", "kriecht", "kriecht keuchend aus einem Spalt herein");
		return 1;
	}
	
	if(TP->QueryProp("staender")) {
		
		write(BS("Du musst Dich erst wieder auf den Bauch legen um aus der Spalte "
		"kriechen zu koennen."));
		say(BS(""+TPN+" klemmt im Spalt fest."));
		return 1;
	}
} 


int westen() {
	
	if(!TP->QueryProp("staender")) {
		
		write(BS("\nDu kriechst nach westen aus dem Spalt.\n\n"));
		TPM("/d/dschungel/trintrasil/hoehle/room/fels.lpc", M_GO,
		"nach westen", "kriecht", "kriecht keuchend aus einem Spalt herein");
		return 1;
	}
	
	if(TP->QueryProp("staender")) {
		
		write(BS("Du musst Dich erst wieder auf den Bauch legen um aus der Spalte "
		"kriechen zu koennen."));
		say(BS(""+TPN+" klemmt im Spalt fest."));
		return 1;
	}
}
     
//ooooooooooo WENN AMOEBE, DANN GREIFT SIE BETRETENDE SPIELER AN (aufgerufen von init) oooooooooooooooooo    

am1() {
	
	NIX
	write(BSL("\nVon oben tropft Dir eine warme Fluessigkeit auf den Hals."));
	call_out("am2", 3);
}


am2() {
	
	NIX
	write(BSL("\nAU!! Die Fluessigkeit brennt ja hoellisch!!"));
	call_out("am3", 2);
}


am3() {
	
	NIX
	write(BSL("\nAls Du erschrocken nach oben blickst siehst Du eine feucht schimmernde "
	"Riesenamoebe die auf Dich herabrinnen will!!!"));
	call_out("am4", 2);
}


am4() {
	
	NIX
	write(BSL("\n  !!!!!FLAAAAAAAATSCHHHH!!!!!"));
	AMOEBE->amoebemove_spalt();
}


int func_aufrichten(string str) {
	
	notify_fail("Willst Du Dich aufrichten?\n");
	
	if(str=="dich auf"||str=="auf"||str=="dich hoch") {
		
		if(!TP->QueryProp("staender")) {
			
			write(BS("Muehevoll, und langsam drehst Du Dich auf die Seite und "
			"stehst in der engen Spalte auf."));
			say(BS(""+TPN+" steht muehevoll und langsam in der engen Spalte auf."));
			TP->SetProp("staender", 1);
			return 1;
		}
		
		if(TP->QueryProp("staender")) {
			
			write(BS("Du stehst doch schon. Verwirrt?"));
			return 1;
		}
	}
}
 
 
int func_hinlegen(string str) {
	
	notify_fail("Willst Du Dich hinlegen?\n");
	
	if(str=="dich auf bauch"||str=="dich hin"||str=="auf boden") {
		
		if(TP->QueryProp("staender")) {
			
			write(BS("Muehevoll rutscht Du die Felswand entlang nach unten "
			"und legst Dich auf den Bauch."));
			say(BS(""+TPN+" legt sich auf den Bauch um wieder aus der Spalte "
			"kriechen zu koennen."));
			TP->SetProp("staender", 0);
			return 1;
		}
		
		if(!TP->QueryProp("staender")) {
			
			write(BS("Du liegst doch schon auf dem Bauch. Du kannst nun wieder "
			"aus der Spalte kriechen."));
			return 1;
		}
	}
}

      
int func_mulde(string str) {
	
	notify_fail("An was willst Du Dich hoch ziehen?\n");
	
	if(str=="dich an mulde hoch"||str=="dich hoch"||str=="an mulde hoch"||
        str=="dich an ausbuchtung hoch"||str=="an ausbuchtung hoch"||
        str=="an unebenheit hoch"||str=="ziehe dich an unebenheit hoch") {
        	
        	if(TP->QueryProp("staender")==1) {
        		
        		write(BS("Du tastest nach der Mulde, klammerst Dich fest und ziehst "
        		"Dich hoch, laesst Dich aber gleich wieder hinunter, da "
        		"es dort oben anscheinend nicht weiter geht."));
        		say(BS(""+TPN+" zieht sich an einer kleinen Mulde in der Felswand "
        		"hoch, laesst sich aber gleich wieder hinunter."));
        		return 1;
        	}
        	
        	if(TP->QueryProp("staender")==0) {
        		
        		write(BS("Du musst erst aufstehen um die Mulde erreichen zu "
        		"koennen."));
        		return 1;
        	}
        }
}

    
//oooooooooooooooooooooooooooooooo FLUTFUNKTIONEN oooooooooooooooooooooooooooooooooooooooooooooooooooo

flut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i]))  {
			
			inv[i]->move("/d/dschungel/trintrasil/hoehle/room/spaltflut-h", 
			M_GO+ M_SILENT+ M_NO_SHOW);
		}
	}
	call_out("npcflut", 10);
	call_out("flut1", 45);
}


npcflut() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( !interactive(inv[i]) && living(inv[i]) ) {
			
			inv[i]->die();
			return 1;
		}
	}
}


flut1() {
	
	object ob;
	ob=first_inventory(TO);

	if( !ob || KONTROLL->flut_aktiv()!=2 ) {//soll verhindern, dass noch obs angespuelt werden, wenn die flut schon zu ende ist
		
		return 1;
	}
	
	else {
		
		ob->move("/d/dschungel/trintrasil/hoehle/room/fels",
		M_GO+ M_SILENT);
		tell_room("/d/dschungel/trintrasil/hoehle/room/fels",
		BS(""+capitalize(ob->name())+" wird von den Wassermassen aus der "
		"Hoehle gespuelt."));
		call_out("flut1", random(4));//die objecte in diesem raum sollen somit
		                             //zeitversetzt angespuelt werden
	}
}

//ooooooooooooooooooooooooooooooooo SPECIAL Details ooooooooooooooooooooooooooooooooooooooooooooooooooo

decke() {
	
	if(AMOEBE->amoebepresent()==1) {
		
		return BS("Als Du so angestrengt in die Dunkelheit starrst bemerkst Du "
		"ploetzlich ein eigenartiges, sich bewegendes Glitzern.");
	}
	
	else {
		return BS("Als Du so angestrengt in die Dunkelheit starrst faellt Dir "
		"ploetzlich eine kleine Unebenheit im Fels auf.");
	}
}