}


_query_int_long() {
	
	if(pilzstat<1000) {
		
		return(BS("Die gewoelbeartige Hoehle verbreitert sich hier. In der Mitte "
		"liegt ein kleiner, schwarzer Teich, um den einige kleine, langstielige Pilze "
		"herum wachsen, die ein dumpfes, gelbes Licht ausstrahlen. Wasser plaetschert "
		"bestaendig von der Decke und verursacht hektische, kleine Wellen im Tuempel. "
		"Im Osten erkennst Du eine Stahltuer in der Wand."));
	}
	
	if(pilzstat>=1000 && pilzstat<4000) {
		
		return(BS("Die gewoelbeartige Hoehle verbreitert sich hier. In der Mitte "
		"liegt ein kleiner, schwarzer Teich, um den langstielige Pilze "
		"herum wachsen, die ein dumpfes, gelbes Licht ausstrahlen. Wasser plaetschert "
		"bestaendig von der Decke und verursacht hektische, kleine Wellen im Tuempel. "
		"Im Osten erkennst Du eine Stahltuer in der Wand."));
	}
	
	if(pilzstat>=4000 && pilzstat<7000) {
		
		return(BS("Die gewoelbeartige Hoehle verbreitert sich hier. In der Mitte "
		"liegt ein kleiner, schwarzer Teich, um den grosse, langstielige Pilze "
		"herum wachsen, die ein dumpfes, gelbes Licht ausstrahlen. Wasser plaetschert "
		"bestaendig von der Decke und verursacht hektische, kleine Wellen im Tuempel. "
		"Im Osten erkennst Du eine Stahltuer in der Wand."));
	}
	
	if(pilzstat>=7000) {
		
		return(BS("Die gewoelbeartige Hoehle verbreitert sich hier. In der Mitte "
		"liegt ein kleiner, schwarzer Teich, um den riesige, langstielige Pilze "
		"herum wachsen, die ein dumpfes, gelbes Licht ausstrahlen. Wasser plaetschert "
		"bestaendig von der Decke und verursacht hektische, kleine Wellen im Tuempel. "
		"Im Osten erkennst Du eine Stahltuer in der Wand."));
	}
}


func_pain(string str) {
	
	object fungushaut;
	fungushaut = clone_object("/d/dschungel/trintrasil/hoehle/obj/fungushaut.lpc");

	notify_fail(BS("Was willst Du abkratzen?"));
	
	if(str=="schicht"||str=="schuppen"||str=="pilz"||str=="fungus"||str=="pilzkappe"||
	str=="schirm"||str=="kappe"||str=="pilzschirm"||str=="pilzkopf"||str=="schicht ab"||
	str=="schuppen ab"||str=="pilz ab"||str=="fungus ab"||str=="pilzkappe ab"||
	str=="schirm ab"||str=="kappe ab"||str=="pilzschirm ab"||str=="pilzkopf ab"||
	str=="haut"||str=="haut ab"||str=="ueber schicht"||str=="ueber schuppen"||
	str=="ueber pilzkappe"||str=="ueber schirm"||str=="ueber pilzschirm"||
	str=="ueber pilzkopf"||str=="ueber haut") {
		
		write(BS("Du reibst ueber die schuppige Haut eine Pilzes und tatsaechlich "
		"plaettern die gelben Schuppen leicht ab."));
		say(BS(""+TPN+" reibt ueber die schuppige Haut eines Pilzes."));
		fungushaut->move(TP, M_NOCHECK); 
		return 1;
	}
}

		
func_heal(string str) {
	
	int wieviel, max_sp, sp_aktuell, max_hp, hp;
	string wohin;
	
	max_sp=TP->QueryProp(P_MAX_SP);
	sp_aktuell=TP->QueryProp(P_SP);
	max_hp=TP->QueryProp(P_MAX_HP);
	hp=TP->QueryProp(P_HP);
	
	if(!str) {
		
		return 0;
	}
	
	if( sscanf(str, "%d muenzen in %s" , wieviel, wohin ) ) {
		
		if(wohin=="teich"||wohin=="wasser"||wohin=="tuempel"||wohin=="becken") {
			
			if(pilzstat+wieviel>=10000) {
				
				write(BSL("   ! PLITSCH PLATSCH !\nDu wirfst "
				""+wieviel+" Muenzen ins Wasser. Die Muenzen loesen "
				"sich funkelnd auf.\n"
				"Die ohnehin schon riesigen Pilze blaehen sich auf und "
				"beginnen bedrohlich zu knarren."));
				say(BSL("   ! PLITSCH PLATSCH !\n"+TPN+" wirft "
				""+wieviel+" Muenzen ins Wasser. Die Muenzen loesen "
				"sich funkelnd auf.\n"
				"Die ohnehin schon riesigen Pilze blaehen sich auf und "
				"beginnen bedrohlich zu knarren."));
				call_out("pilzexplosion", 3);
				return 1;
			}
			
			else {
				
				if(hp==max_hp && sp_aktuell==max_sp) {
				
					write(BSL("   ! PLITSCH PLATSCH !\nDu wirfst "
					""+wieviel+" Muenzen ins Wasser. Die Muenzen loesen "
					"sich funkelnd auf. Die Pilze leuchten kuerz heller "
					"und werden etwas groesser. Eine warme, angenehme "
					"Kraft durchfliesst Dich, auch wenn Du gar keine "
					"Heilung brauchst."));
					say(BSL("   ! PLITSCH PLATSCH !\n"+TPN+" wirft "
					""+wieviel+" Muenzen ins Wasser. Die Muenzen loesen "
					"sich funkelnd auf. Die Pilze leuchten kurz heller "
					"und werden etwas groesser."));
					pilzstat=pilzstat+wieviel;
					return 1;
				}
				
				else {
					write(BSL("   ! PLITSCH PLATSCH !\nDu wirfst "
					""+wieviel+" Muenzen ins Wasser. Die Muenzen loesen "
					"sich funkelnd auf. Die Pilze leuchten kurz heller "
					"und werden etwas groesser. Eine warme, angenehme "
					"Kraft durchfliesst Dich."));
					say(BSL("   ! PLITSCH PLATSCH !\n"+TPN+" wirft "
					""+wieviel+" Muenzen ins Wasser. Die Muenzen loesen "
					"sich funkelnd auf. Die Pilze leuchten kurz heller "
					"und werden etwas groesser."));
					pilzstat=pilzstat+wieviel;
					TP->AddHp(wieviel/10);
					
					if(sp_aktuell == max_sp) {
						
						return 1;
					}
					
					if( sp_aktuell+wieviel/10 >= max_sp) {
						
						TP->SetProp(P_SP, max_sp);
						return 1;
					}
					
					if( sp_aktuell+wieviel/10 < max_sp) {
						
						TP->SetProp(P_SP, sp_aktuell+ wieviel/10 );
						return 1;
					}
				}
			}
			write(BS("Wieviel Muenzen willst Du in was werfen?"));
			return 1;
		}
	}
}


pilzexplosion() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	pilzstat=0;
	tell_room(TO, BSL(" !  PENG PENG !\nDie riesigen Pilze explodieren mit einem lauten "
	"Knall und setzen Wolken goldener Sporen frei. Nur ein paar kleine Leuchtpilze sind "
	"nicht zerplatzt und wachsen noch zwischen den zerfetzen Ueberresten."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("Du hoerst im Westen "
	"einen lauten Knall.\nEine goldene Sporenwolke weht von Westen herein."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle12", BSL("Du hoerst im Osten "
	"einen lauten Knall.\nEine goldene Sporenwolke weht von Osten herein."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle11", BSL("Du hoerst im Nordosten "
	"einen lauten Knall.\nEine goldene Sporenwolke weht von Nordosten herein."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle14", BSL("Du hoerst einen "
	"dumpfen Knall aus der Hoehle im Sueden."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle13", BSL("Du hoerst im Osten "
	"einen lauten Knall."));
	tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle9", BSL("Du hoerst einen "
	"dumpfen Knall aus der Hoehle im Suedwesten."));
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( living(inv[i]) ) {
			
			inv[i]->AddHp(-5-random(5));
		}
	}
}


return_height() {
	
	string hoehe;
	
	if(pilzstat<1000) {
		
		hoehe="0,3";
	}
	
	if(pilzstat>=1000 && pilzstat<3000) {
		
		hoehe="0,5";
	}
	
	if(pilzstat>=3000 && pilzstat<4000) {
		
		hoehe="0,8";
	}
	
	if(pilzstat>=4000 && pilzstat<6000) {
		
		hoehe="1,2";
	}
	
	if(pilzstat>=6000 && pilzstat<7000) {
		
		hoehe="1,5";
	}
	
	if(pilzstat>=7000 && pilzstat<8500) {
		
		hoehe="1,8";
	}
	
	if(pilzstat>=8500) {
		
		hoehe="2";
	}
	return hoehe;
}

//§§§§§§§§§§§§§§§§§§§§§§§§§§§§§ SPECIAL DETAILS ANFANG §§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§

pilzdet() {
	
	if(pilzstat<1000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 30 cm gross. Ihre schuppigen, "
		"goldgelb leuchtenden Schirme sitzen auf duennen Stielen und verbreiten ein "
		"warmes, daemmriges Licht in der Hoehle."));
	}
	
	if(pilzstat>=1000 && pilzstat<3000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 50 cm gross. Ihre schuppigen, "
		"goldgelb leuchtenden Schirme sitzen auf duennen Stielen und verbreiten ein "
		"warmes, daemmriges Licht in der Hoehle."));
	}
	
	if(pilzstat>=3000 && pilzstat<4000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 80 cm gross. Ihre schuppigen, "
		"goldgelb leuchtenden Schirme sitzen auf duennen Stielen und verbreiten ein "
		"warmes, daemmriges Licht in der Hoehle."));
	}
	
	if(pilzstat>=4000 && pilzstat<6000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 1,2 m gross. Ihre schuppigen, "
		"goldgelb leuchtenden Schirme sitzen auf relativ duennen Stielen und "
		"verbreiten ein warmes, daemmriges Licht in der Hoehle."));
	}
	
	if(pilzstat>=6000 && pilzstat<7000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 1,5 m gross. Ihre schuppigen, "
		"goldgelb leuchtenden Schirme sitzen auf relativ duennen Stielen und "
		"verbreiten ein warmes, daemmriges Licht in der Hoehle."));
	}
	
	if(pilzstat>=7000 && pilzstat<8500) {
		
		return(BS("Die riesigen Pilze sind durchschnittlich ca 1,8 m gross. Ihre "
		"dicken Schirme sitzen auf relativ duennen Stielen und leuchten  goldgelb. "
		"Die Lamellen auf den Schirmunterseiten sind voller glitzender Sporen."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Die riesigen Pilze sind ueber 2 m gross. Ihre dicken Schirme sitzen "
		"auf relativ duennen Stielen und leuchten goldgelb. Die Lamellen auf den "
		"Schirmunterseiten sind prall gefuellt mit glitzernden Sporen."));
	}
}


stieldet() {
	
	if(pilzstat<3000) {
		
		return(BS("Die weissen, bleichen Stiele sind duenn und wirken sehr filigran."));
	}
	
	if(pilzstat>=3000 && pilzstat<7000) {
		
		return(BS("Die weissen, bleichen Stiele sind relativ duenn und wirken sehr "
		"filigran. Sie muessen sehr zaeh sein um den schweren Schirm zu tragen."));
	}
	
	if(pilzstat>=7000) {
		
		return(BS("Die weissen, bleichen Stiele sind verglichen mit dem schweren "
		"Schirm sehr duenn. Unglaublich wie zaeh sie sich in die Hoehe winden und "
		"den prallen Pilzkopf tragen."));
	}
}


hoehdet() {
	
	if(pilzstat<1000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 30 cm gross."));
	}
	
	if(pilzstat>=1000 && pilzstat<3000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 50 cm gross."));
	}
	
	if(pilzstat>=3000 && pilzstat<4000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 80 cm gross."));
	}
	
	if(pilzstat>=4000 && pilzstat<6000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 1,2 m gross."));
	}
	
	if(pilzstat>=6000 && pilzstat<7000) {
		
		return(BS("Die Pilze sind durchschnittlich ca 1,5 m gross."));
	}
	
	if(pilzstat>=7000 && pilzstat<8500) {
		
		return(BS("Die riesigen Pilze sind durchschnittlich ca 1,8 m gross."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Die riesigen Pilze sind ueber 2 m gross."));
	}
}


unterseite() {
	
	if(pilzstat<1000) {
		
		return(BS("Die Schirme sind noch nicht geoffnet. Du kannst die Unterseite nicht "
		"sehen."));
	}
	
	if(pilzstat>=1000 && pilzstat<6000) {
		
		return(BS("Auf der Unterseite der Schirme siehst Du eine dichte Reihe "
		"Lamellen."));
	}
	
	
	if(pilzstat>=6000 && pilzstat<7000) {
		
		return(BS("Auf der Unterseite der Schirme siehst Du eine dichte Reihe Lamellen. "
		"Du erkennst in ihnen gelblich schimmernde Sporen."));
	}
	
	if(pilzstat>=7000 &&pilzstat<8500) {
		
		return(BS("Auf der Unterseite der Schirme siehst Du eine dichte Reihe Lamellen. "
		"Sie sind prall gefuellt mit gelblich schimmernden Sporen."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Auf der Unterseite der Schirme siehst Du eine dichte Reihe Lamellen. "
		"Sie sind uebervoll mit gelblichen Sporen und es sieht so aus, als koennten "
		"die Pilze jeden Augenblick zerplatzen."));
	}
}


zeit() {
	
	if(pilzstat<6000) {
		
		return(BS("Die Pilze brauchen noch viel Gold um ihre Sporen frei zu setzen."));
	}
	
	if(pilzstat>=6000 && pilzstat<8500) {
		
		return(BS("Die Pilze bruechen noch etwas Gold um ihre Sporen frei zu setzen."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Die Pilze brauchen nur noch wenig Gold um ihre Sporen frei zu "
		"setzen."));
	}
}


augenblick() {
	
	if(pilzstat<6000) {
		
		return(BS("Die Fungi aurei sind noch nicht ausgereift und haben noch zu "
		"wenige Sporen gebildet."));
	}
	
	if(pilzstat>=6000 && pilzstat<8500) {
		
		return(BS("In den Lamellen siehst Du bereits viele Sporen. Aber die "
		"Pilze scheinen noch etwas wachsen zu koennen."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Sei vorsichtig! Die Lamellen sind prall gefuellt mit Sporen. Die "
		"Pilze koennen jeder Zeit explodieren."));
	}
}


sporen() {
	
	if(pilzstat<6000) {
		
		return(BS("Du kannst keine Sporen erkennen. Die Pilze sind noch nicht "
		"ausgewachsen genug."));
	}
	
	if(pilzstat>=6000 && pilzstat<8500) {
		
		return(BS("In den Lamellen reifen die Sporen. Noch scheinen aber nicht genug "
		"fuer den Sporenflug vorhanden zu sein."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Sei vorsichtig! Die Lamellen sind prall gefuellt mit Sporen. Die "
		"Pilze koennen jeder Zeit explodieren."));
	}
}


lamellen() {
	
	if(pilzstat<1000) {
		
		return(BS("Die Schirme sind noch nicht geoffnet. Du kannst keine Lamellen "
		"sehen."));
	}
	
	if(pilzstat>=1000 && pilzstat<6000) {
		
		return(BS("Die Lamellen sind wie die Speichen eines Rades auf der "
		"Schirmunterseite angeordnet, nur viel dichter. Sie scheinen noch "
		"leer zu sein."));
	}
	
	
	if(pilzstat>=6000 && pilzstat<7000) {
		
		return(BS("Die Lamellen sind wie die Speichen eines Rades auf der "
		"Schirmunterseite angeordnet, nur viel dichter. Du erkennst in ihnen "
		"gelblich schimmernde Sporen."));
	}
	
	if(pilzstat>=7000 &&pilzstat<8500) {
		
		return(BS("Auf der Unterseite der Schirme siehst Du eine dichte Reihe Lamellen. "
		"Sie sind prall gefuellt mit gelblich schimmernden Sporen."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Auf der Unterseite der Schirme siehst Du eine dichte Reihe Lamellen. "
		"Sie sind uebervoll mit gelblichen Sporen und es sieht so aus, als koennten "
		"die Pilze jeden Augenblick zerplatzen."));
	}
}


schirmdet() {
	
	if(pilzstat<1000) {
		
		return(BS("Die Pilzkappen sind noch klein und rundlich. Sie werden sich erst "
		"zu weiten Schirmen oeffnen wenn die Pilze groesser sind. Sie sind mit einer "
		"schuppigen Schicht ueberzogen."));
	}
	
	if(pilzstat>=1000 && pilzstat<3000) {
		
		return(BS("Die Pilzkappen sind geoffnet. Sie sind mit einer schuppigen Schicht "
		"ueberzogen und schimmern goldgelb. Auf der Schirmunterseite sitzen viele "
		"Lamellen."));
	}
	
	if(pilzstat>=3000 && pilzstat<4000) {
		
		return(BS("Die Schirme sind weit geoeffnet und sehen grotesk aus auf ihren "
		"duenne Stilen. Sie sind mit einer schuppigen Schicht ueberzogen. Auf "
		"der Unterseite sitzen viele Lamellen."));
	}
	
	if(pilzstat>=4000 && pilzstat<6000) {
		
		return(BS("Die grossen Schirme sind mit einer schuppigen Schicht ueberzogen. "
		" Auf der Unterseite sitzen viele Lamellen."));
	}
	
	if(pilzstat>=6000 && pilzstat<7000) {
		
		return(BS("Die Schirme sind so gross, dass man auf ihnen bequem sitzen koennte, "
		"wenn die Stiele nicht so duenn waeren. Ausserdem sind sie mit einer schuppigen "
		"Schicht ueberzogen. Auf der Unterseite sitzen viele "
		"Lamellen."));
	}
	
	if(pilzstat>=7000 && pilzstat<8500) {
		
		return(BS("Die riesigen Schirme sind mit einer schuppigen, gelben Schicht "
		"ueberzogen. Auf der Unterseite der Pilze sitzen viele Lamellen, "
		"die prall gefuellt mit Sporen sind."));
	}
	
	if(pilzstat>=8500) {
		
		return(BS("Auf der Unterseite der riesigen Schirme sitzen viele Lamellen, die "
		"prall gefuellt mit Sporen sind. Die Schirme scheinen jeden Augenblick platzen "
		"zu koennen!"));
	}
}


