reset() {
  ::reset();
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Teich mit den Leuchtpilzen" );
  SetProp( P_INT_LONG, break_string(
"Die gewoelbeartige Hoehle verbreitert sich hier. In der Mitte liegt ein kleiner, schwarzer "
"Teich, um den einige kleine, langstielige Pilze herum wachsen, die ein dumpfes, gelbes Licht "
"ausstrahlen. Wasser plaetschert bestaendig von der Decke und verursacht hektische, kleine "
"Wellen im Tuempel. Im Osten erkennst Du eine Stahltuer in der Wand."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp("waschraum", 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 

