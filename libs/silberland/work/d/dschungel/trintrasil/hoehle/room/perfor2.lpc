   NIX
   H(perfor2)
   write(BS(
        "Du hast die gesamte Hoehle jenseits der Sicherheitstuer unter "
        "Wasser gesetzt und mit ziemlicher Sicherheit alles getoetet was "
        "sich in ihr befand!"));
     say(BS(
        ""+TPN+" hat die gesamte Hoehle jenseits der Sicherheitstuer "
        "unter Wasser gesetzt und mit ziemlicher Sicherheit alles getoetet "
        "was sich in ihr befand!"));
   call_out("flut11", 2);
     }
   
   
   
   flut11() {	
   
   int i;
   object *inv;
   NIX
   H(perfor2)
   
   inv=all_inventory(TO);
   
   for(i=sizeof(inv)-1;i>=0;i--) {
   
     if( inv[i]->id("boghanikar")) {
     	
     	inv[i]->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+
     	             M_SILENT+ M_NO_SHOW);
     	inv[i]->remove();
     	}
       }
                 
   write(BS(    
           "Einige Boghanik raffen hektisch verschieden Werkzeuge zusammen "
           "und machen sich daran die Schleuse wieder zu schliessen."));
     say(BS(     
           "Einige Boghanik raffen hektisch verschiedene Werkzeuge zusammen "
           "und machen sich daran die Schleuse wieder zu schliessen."));
     H(perfor2)    
         }
       



         
