
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";



int tuer=1;      // ob tuer offen
int baum=1;      // ob baumstamm entfernt
int erlaubnis=1; // ob inerhalb dieses resets flut bereits lief
int zeit=1;      // ob flut gerade laeuft


reset() {
  ::reset();
  erlaubnis=1;
    }


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"Du befindest Dich in der grossen Wohnhoehle der Boghanik. Vor Dir erstreckt sich "
"eine 15 meter durchmessende, sehr hohe Halle in deren Mitte ein kleines "
"Lagerfeuer brennt und aus der viele Seitengaenge abzweigen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
  AD(({"hoehle"}),//beschreibung fucks
    "Aus der grossen, hellen Hoehle im westen hoerst Du lautes Gelaechter und "
    "Stimmengewirr.");
  
  AD(({"felswaende","waende","sandsteinwaende","wand"}),
    "Die gelben Sandsteinwaende sind geglaettet. Die feinen Linien und "
    "schimmernden Farben des Sandsteines wurden von den Boghanik sorgfaeltig "
    "herauspoliert."),
    
  AD(({"farben","linien"}),
    "Der Sandstein wurde mit viel Zuneigung poliert bis seine Farben "
    "so sanft schimmerten.");
    
  AD(({"sandstein","stein"}),
    "Die Waende dieser Hoehle bestehen aus gelbem Sandstein.");
  
  AD(("innenseite"),
    "Das Handrad ist auf der Innenseite angebracht damit man die Tuer von der "
    "Hoehle aus versperren kann.");
    
  AD(({"rad","handrad"}),
    "Damit kann man die Tuer wahrscheinlich verschliessen.");
  
  AD(("druck"),
    "Welchem Druck die Tuer standhalten soll kannst Du Dir nicht vorstellen "
    "vielleicht sagt es Dir einer der Boghanik.");
        
  AD(("blick"),
    "Der Illusionszauber soll wohl vor ungebetenen Gaesten schuetzen.");
    
  AD(({"illusionszauber","zauber","illusion"}),
    "Der Illusionszauber schirmt anscheinend auch Geraeusche und Gerueche ab.");
    
  AD(("geraeusche"),
    "Zumindest ist von dem regen Treiben draussen nichts zu hoeren.");
    
  AD(("gerueche"),
    "Ansonsten waere der Zauber zumindest gegen Raubtiere wirkungslos.");
    
  AD(({"raubtiere","tiere","gast","gaeste"}),
    "Gefaehrliche Tiere leben in diesen Hoehlen genug.");
    
  AD(("eingang"),
    "Der Eingang zu den Wohnhoehlen der Bucken ist gemeint.");
    
  AD(({"wohnhoehlen","hoehlen","treiben","stimmengewirr","gewirr"}),
    "Schau Dir die Wohnhoehlen doch an.");
      
  AD(("gelaechter"),
    "Du siehst viele, kleine, geschaeftige Gestalten in der Hoehle.");
    
  AD(("gestalten"),
    "Es handelt sich um Boghanik.");
    
  AD(("boghanik"),
    "Boghanik sind noch kleiner als Zwerge. Die meisten Boghanikstaemme siedeln "
    "im Inselinneren, aber manchmal kann man einen ihrer Jaeger auch in Tijara "
    " antreffen.");
 
  AD(({"boghanikstaemme","staemme","stamm","boghanikstamm"}),
    "Die meisten Boghanik bewohnen das schwer erreichbare Innere der Insel.");
    
  AD(({"inselinnere","innere","insel"}),
    "Der groesste Teil der Insel und ihrer ganzen Ausmasze sind unerforscht.");
    
  AD(({"teil","ausmasze"}),
    "Das Innere der grossen Insel ist nur sehr schwer zugaenglich.");
    
  AD(({"tijara","jaeger","siedlungen"}),
    "Die Boghanik leben zurueckgezogen und meiden groessere Siedlungen, aber "
    "manchmal schicken sie einen ihrer Jaeger aus um einen fuer den Stamm "
    "wichtigen Auftrag auszufuehren.");
    
  AD(("auftrag"),
    "Manchmal tauschen sie Felle oder Edelsteine.");
    
  AD(({"felle","fell","edelsteine","edelstein"}),
    "Die Boghanik leben meistens in Hoehlen und verstehen sich auf Bergbau. Aber "
    "auch mit Fellen handeln sie oft.");
    
  AD(({"bergbau","zuneigung"}),
    "Anscheinend eine angeborene Neigung der Boghanik.");
    
  AD(("neigung"),
    "Ahnlich wie bei Zwergen, aber sonst haben sie nichts gemeinsam.");
  
  AD(({"zwerge"}),
    "Boghanik haben keinen Haarwuchs und haben pupillenlose Augen.");
     
  AD(("augen"),
    "Die grossen Augen der Boghanik sind vollkommen schwarz.");
    
  AD(({"haare","haarwuchs","wuchs"}),
    "Boghanik sind vollkommen kahl.");
     
  AD(("gang"),
    "Dieser Gang fuehrt in eine grosse, helle Hoehle.");

  AD(("decke"),
    "Die Decke ist gewoelbt um der Last der Felsmassen ueber ihr auszuhalten.");
   
  AD(("last"),
    "Die Last muss gewaltig sein.");
     
  AD(({"felsmassen","massen"}),
    "Das Du Dich in einer Hoehle befindest ist Dir klar?");
   
  AD(({"boden","sand","schwemmsand"}),
    "Der Boden ist mit dem gleichen feinen Schwemmsand wie in der uebrigen "
    "Hoehle bedeckt.");     
  
  ASD(({"tuer","eisentuer"}),
    "eisentuer");
    
    
      
  AddCmd(({"drehe","dreh"}), "func_wasser");//loesst flut aus
  
  AddCmd(({"schliesse"}), "func_sichern");//schliesst die eisentuer 
  
  AddCmd(({"oeffne"}), "func_oeffnen");//oeffnet die eisentuer
  
  
  AddItem("/d/dschungel/trintrasil/bogh/npc/bogh.lpc" ,REFRESH_DESTRUCT);
  
  AddItem("/d/dschungel/trintrasil/bogh/npc/bogh1.lpc" ,REFRESH_DESTRUCT);
  
  AddItem("/d/dschungel/trintrasil/bogh/npc/xabbu.lpc" ,REFRESH_DESTRUCT);

   
  AddExit("nordosten", ([
          EX_FUNC:"verschlossen",]));

  AddExit("westen", ("/d/dschungel/trintrasil/bogh/room/bogpub"));

  AddExit("nordwesten", ("/d/dschungel/trintrasil/bogh/room/bog1"));

  AddExit("suedwesten", ("/d/dschungel/trintrasil/bogh/room/bog3"));


  AddSound( DEFAULT_SOUND,
    "Aus dem osten hoerst Du Stimmen.");
 
  AddSound(("stimmen"),
    "Geh doch hin wenn es Dich interessiert."); 
 
}
  
  

//!!!!!!!!!!!!!!!!!!!!!!!!!!!VERSCHLOSSEN!!!!!!!!!!!!!!!!!!!!!!  
  
  int verschlossen() {
  	
    if(!tuer) {
    	
      write(BS("Schau doch. Die Tuer ist ja verschlossen!!!"));
        say(BS(""+TPN+" stellt erstaunt fest das die Tuer verschlossen ist."));
           return 1;}
    if(tuer) {
    	
      TP->move("/d/dschungel/trintrasil/hoehle/room/perfor1", M_GO);
           return 1;}
         return 0;}


//!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!OEFFNEN!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  int func_oeffnen(string str) {
  	
     notify_fail("Was willst Du oeffnen?\n");
   
   if(str=="tuer"||str=="schutztuer"||str=="eisentuer") {
   
   if((tuer==1)&&(zeit==1)) {
   write(BS("Die Tuer ist ja garnicht verschlossen!"));
     say(BS(""+TPN+" ist anscheinend schwer verwirrt."));
           return 1;}
   
   if((tuer==0)&&(zeit==1)) {
   write (BS("Du legst den Hebel um und ziehst mit aller Kraft an der schweren "
             "Eisentuer.\n"
             "Aechzend setzt sie sich in Bewegung und laesst sich oeffnen.\n"));
      say(BS(""+TPN+" legt den Tuerhebel um und zieht mit aller Kraft an der "
             "schweren Eisentuer.\n"
             "Aechzend setzt sie sich in Bewegung und laesst sich oeffnen.\n"));
             
     tuer=1;
 	
     tell_room("/d/dschungel/trintrasil/hoehle/room/perfor1.lpc",
               BS("Du hoerst an der Eisentuer ein Klicken und die Tuer oeffnet "
               "sich quietschend."));
     call_other("/d/dschungel/trintrasil/hoehle/room/perfor1", "set_door_open");
            return 1;}
   
   if(zeit==0) {
   write (BS("Die ganze aeussere Hoehle ist doch geflutet. Wenn Du die Tuer "
             "oeffnest setzt Du doch die gesamte Boghanikhoehle unter Wasser!!!\n"));
            return 1;}
            
            
   return 0;}
   return 0;}
   

  //!!!!!!!!!!!!!!!!!!!!!!!!!!!!SICHERN!!!!!!!!!!!!!!!!!!!!!!!!!!!
  
  int func_sichern(string str) {
  
     notify_fail("Was willst Du schliessen?\n");
 
   if(str=="tuer"||str=="eisentuer"||str=="schutztuer") {
   	
   if(!tuer) {
   
   write(BS("Schau doch die Tuer ist ja schon verschlossen."));
     say(BS(""+TPN+" ruettelt eigenartigerweise an der Tuer."));
    return 1;}

    
   if(tuer) {
   	
   write(BS("Du stemmst Dich gegen die schwere Eisentuer. "
            "Mit einem aechzenden Stoehnen faellt die schwere Eisentuer "
            "ins Schloss. Mit einem Umlegen des Hebels verriegelst Du die "
            "Tuer."));
     say(BS(""+TPN+" stemmt sich gegen die schwere Eisentuer. Mit einem "
            "aechzenden Stoehnen faellt die schwere Eisentuer ins Schloss. "
            ""+TPN+" legt den Hebel an der Tuer um und verriegelt sie."));
         tuer--;
         tell_room("/d/dschungel/trintrasil/hoehle/room/perfor1.lpc",
                   BS("Ploetzlich setzt sich die schwere Eisentuer mit einem "
                   "aechzenden Stoehnen in Bewegung und faellt donnernd zu!!"));
                   
     call_other("/d/dschungel/trintrasil/hoehle/room/perfor1", "set_door_closed"); 
     
       return 1;}
    return 0;}  
  return 0;}      
          


//!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!WASSER!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

  int func_wasser(string str) {
     
     notify_fail("Was willst Du drehen?\n");
     
   if(str=="rad"||str=="handrad"||str=="an rad"||str=="an handrad"||
      str=="das rad"||str=="das handrad"||str=="am rad"||str=="am handrad")
      
    {
    
    
    if(!zeit) {       //wenn die Hoehle gerade geflutet ist (siehe zeile 701)
    
    write(BS("Die Hoehle ist immer noch unter Wasser. Du kannst doch nicht "
             "schon wieder am Handrad herumdrehen."));
          return 1;}
          
          
    
    if((zeit)&&(!erlaubnis)&&(present("xabbu", TO))) {
    	
    write(BS("Erst vor kurzem hat jemand unvorsichtig an dem Handrad gedreht. "
             "Xabbu laesst Dich deshalb nicht zum Rad."));
      say(BS(""+TPN+" will an dem Handrad drehen aber Xabbu laesst ihn "
             "nicht."));
       return 1;} 
    
    
    if((zeit)&&(erlaubnis)&&(present("xabbu", TO))&&(tuer)) {
    
    write(BS("Das Rad laesst sich nicht drehen, anscheinend ist es gesichert.\n "
             "Xabbu sagt unruhig:´ Nicht Flusz laufen wenn Schutztuer offen. "
             "Boghanicks laeszt Flusz Gefahrt toeten wenn szie ist vor Heimhoehle. "
             "!!VORSZICHT FLUSZ TOETET!!´\n"));
      say(BS(""+TPN+" versucht am Handrad zu drehen.\n"
             "Xabbu sagt unruhig:´ Nicht Flusz laufen wenn Schutztuer offen. "
             "Boghanicks laeszt Flusz Gefahr toeten wenn szie iszt vor Heimhoehle. "
             "!!VORSZICHT FLUSZ TOETET!!´\n"));
       return 1;}
    
     
     if((zeit)&&(erlaubnis)&&(tuer)&&(!present("xabbu", TO))) {
     	
     write(BS("Das Rad laesst sich nicht drehen, anscheinend ist es irgendwie "
              "gesichter.\n"));
       say(BS(""+TPN+" versucht am Handrad zu drehen, scheint es aber nicht "
              "bewegen zu koennen.\n"));
        return 1;}
        
      
      if((zeit)&&(erlaubnis)&&(present("xabbu", TO))&&(!tuer)&&(baum)) {
      	
      write(BS("Du drehst das Rad und hoerst ein leises Rasseln. Irgendwie "
               "scheint der Mechanismus aber nicht zu greifen.\n "
               "Xabbu sagt unruhig:´ Handrad laeszt Flusz laufen und alles "
               "toeten was vor Heimhoehle. Guterweisze hat Baum Flusz "
               "gehalten sonszt GEFAHR!!´\n "
               "Xabbu dreht das Handrad wieder zurueck.\n"));
         say(BS(""+TPN+" dreht am Handrad aber nichts scheint zupassiert.\n "
                "Xabbu sagt unruhig:´ Handrad laeszt Flusz laufen und alles "
                "toeten was vor Heimhoehle. Guterweisze hat Baum Flusz "
                "gehalten sonszt GEFAHR!!´\n "
                "Xabbu dreht das Handrad wieder zurueck.\n"));
          return 1;}
          
        
        if((zeit)&&(erlaubnis)&&(!tuer)&&(baum)&&(!present("xabbu", TO))) {
        
        write(BS("Du drehst das Rad und hoerst ein leises Rasseln. Irgendwie "
                 "scheint der Mechanismus aber nicht zu greifen.\n "));
          say(BS(""+TPN+" dreht am Handrad aber nichts scheint zu passieren.\n "));
          
            return 1;}
            
        
        if((zeit)&&(erlaubnis)&&(present("xabbu", TO))&&(!tuer)&&(!baum)) {
        
 //ooooooooooooooooooooooo FLUT AM FLUSS ooooooooooooooooooooooooooooooooooooooo
 
            call_other("/d/dschungel/trintrasil/fluss/room/arena", "flut");
            call_other("/d/dschungel/trintrasil/fluss/room/schluchtein", "flut");
            call_other("/d/dschungel/trintrasil/fluss/room/riese", "flut");
 
 //ooooooooooooooooooooooo FLUT-PERFOR2 oooooooooooooooooooooooooooooooooooo
        
             call_other("/d/dschungel/trintrasil/hoehle/room/perfor2", "flut");
             erlaubnis--;
             zeit--;
          
  //oooooooooooooooooooooooo TOETE ALLE IN HOEHLE7 ooooooooooooooooooooooooo
        
        call_other("/d/dschungel/trintrasil/hoehle/room/hoehle7", "fluttod");
         
   //oooooooooooooooooooooooooo NACH EINGANG ooooooooooooooooooooooooooooooooo
   
       call_other("/d/dschungel/trintrasil/hoehle/room/eingang", "flutein");
   
   //ooooooooooooooooooooooooo  IN ALLE UEBRIGEN HOEHLENRAEUME oooooooooooooooo
    
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle1", "flut");//func flut in ges hoehle
                  
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle2", "flut");
          
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle3", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle4", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle5", "flut");   
          
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle6", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/amoebe",  "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/perfor1", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/spalt", "flut");  
                
       call_other("/d/dschungel/trintrasil/hoehle/room/fels", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", "resetfunc");

 //kontrollraum einfach deshalb weil das ein raum ist der noch weniger zugecoded 
 //und daher uebersichtlicher ist :)
            return 1;}
       
       
        if((zeit)&&(!present("xabbu", TO))&&(!tuer)&&(!baum)&&(erlaubnis))  {
        
 //ooooooooooooooooooooooo FLUT AM FLUSS ooooooooooooooooooooooooooooooooooooooo
 
            call_other("/d/dschungel/trintrasil/fluss/room/arena", "flut");
            call_other("/d/dschungel/trintrasil/fluss/room/schluchtein", "flut");
            call_other("/d/dschungel/trintrasil/fluss/room/riese", "flut");
      
  //oooooooooooooooooooooooooo XABBU-PERFOR2 ooooooooooooooooooooooooooooooo
      
       call_other("/d/dschungel/trintrasil/hoehle/room/perfor2", "xabbu");//flut ohne boghanik  	            
       zeit--;
         
  //ooooooooooooooooooooooooooooo NACH HOEHLE7 oooooooooooooooooooooooooooooo
        
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle7", "fluttod");//2te func, toetet	
         
    //ooooooooooooooooooooooo NACH EINGANG oooooooooooooooooooooooooooooooooo
   
       call_other("/d/dschungel/trintrasil/hoehle/room/eingang", "flutein");//remove zugang zur hoehle
      
  //ooooooooooooooooooooooo IN ALLE UEBRIGEN HOEHLENRAEUME ooooooooooooooooo
    
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle1", "flut");//func flut in ges hoehle
       
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle2", "flut");
           
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle3", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle4", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle5", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/hoehle6", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/amoebe", "flut");//amoebe wird auch 0 gesetzt(siehe spalt, fels)
       
       call_other("/d/dschungel/trintrasil/hoehle/room/perfor1", "flut");       

       call_other("/d/dschungel/trintrasil/hoehle/room/spalt", "flut");

       call_other("/d/dschungel/trintrasil/hoehle/room/fels", "flut");
       
       call_other("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", "resetfunc");
       
             return 1;}
         
        if((zeit)&&(!present("xabbu", TO))&&(!tuer)&&(!baum)&&(!erlaubnis))  {
        
       write(BS("Erst vor kurzem hat jemand eine verheerende Flut in der Hoehle "
                "ausgeloest und damit furchtbaren Schaden angerichtet. Darum "
                "laesst Du das Handrad lieber in Ruhe.\n"));
       say(BS("Fingert an dem Handrad an der Wand herum, laesst das "
              "gefaehrliche Rad dann aber lieber sein.\n"));
           return 1;}	         
         return 0;}
         return 0;}



//!!!!!!!!!!!!!!!!!!!!!!!!STAMM call_other HOEHLE7!!!!!!!!!!!!!!!!!!!

  stamm()
{
  baum=0;
 }
 
 

//!!!!!!!!!!!!!!!!!!!!SPEZAIL ONES!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 
eisentuer()
{
if(tuer==1) {
  
  return BS("Die Eisentuer ist ca 2 meter hoch und sehr dick. Auf der "
            "Innenseite ist ein Handrad angebracht. Sie sieht aus als sollte "
            "sie grossem Druck von aussen standhalten koennen. Sie ist "
            "geoffnet.");
  }

if(tuer==0) {
  
  return BS("Die gewaltige Eisentuer ist verschlossen und versperrt. "
            "Du kannst sie aber mit dem Hebel der an ihr angebracht ist "
            "jederzeit oeffnen.");
  }
}



