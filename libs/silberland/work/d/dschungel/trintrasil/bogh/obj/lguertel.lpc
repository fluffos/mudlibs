
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine Lederguertel");
  SetProp (P_LONG,BS(
    "Der Guertel besteht aus braunem ungefaerbtem Rotheleder. Die Schnalle "
    "ist aus grob bearbeitetem Eisen."));
    
  SetProp (P_NAME, "Lederguertel");
  SetProp (P_GENDER, MALE);
  AddId (({"guertel","lederguertel"}));
  SetProp (P_WEIGHT, 165);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 109);
  SetProp (P_ARMOUR_TYPE, AT_BELT);
  SetProp (P_AC, 1);
  SetProp(P_MATERIAL, (MAT_LEATHER));

  AD(({"leder","rotheleder"}),
    "Das Leder sieht recht robust aus.");
    
  AD(({"schnalle","guertelschnalle","eisen"}),
    "Die Schnalle ist schmucklos und zweckmaessig geformt.");
}

