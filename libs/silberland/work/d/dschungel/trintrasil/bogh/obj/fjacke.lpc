
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine Felljacke");
  SetProp (P_LONG,BS(
    "Die Felljacke wurde aus dem Fell einer gescheckten Ziege genaeht. "
    "Sie ist aermellos und sehr einfach gearbeitet."));
    
  SetProp (P_NAME, "Felljacke");
  SetProp (P_GENDER, FEMALE);
  AddId (({"jacke","felljacke"}));
  SetProp (P_WEIGHT, 265);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 209);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 3);
  SetProp(P_MATERIAL, (MAT_PELT));

  AD(({"fell","felle","ziege"}),
    "Die Ziege war braunweissschwarz gescheckt.");
    
}

