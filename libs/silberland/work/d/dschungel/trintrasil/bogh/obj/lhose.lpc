
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine Lederhose");
  SetProp (P_LONG,BS(
"Die Lederhose ist aus etwas groben Rotheleder. Mit Brandeisen wurden schwarze "
"Muster eingebrannt. Die Hose scheint fuer sehr kleine Wesen gemacht zu sein."));

  AD(({"rotheleder","leder"}), 
    "Das Leder einer Rothe ist zwar etwas grob aber zumindest sehr fest.");
    
  AD(({"brandeisen","eisen"}),
    "Jemand hat mit heissen Eisen schwarze Muster in das braune Leder gebrannt.");
        
  AD(({"muster","kreise","kreuze","striche"}),
    "Das Muster ist sehr einfach gehalten und besteht aus Kreisen, Kreuzen "
    "und Strichen.");
      
  AD(({"zwerge","zwergengroesse","wesen"}),
    "Naja, ca Zwergengroesse, oder kleiner.");
    
  SetProp (P_NAME, "Lederhose");
  SetProp (P_GENDER, FEMALE);
  AddId (({"lederhose","rothelederhose","hose"}));
  SetProp (P_WEIGHT, 350);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 320);
  SetProp (P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp (P_AC, 4);
  SetProp(P_MATERIAL, (MAT_LEATHER));
  
}

