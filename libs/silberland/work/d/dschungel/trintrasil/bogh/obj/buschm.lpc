
inherit "std/weapon";
#include <properties.h>     
#include <combat.h>       
#include <language.h>      
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

//SetProp (P_NAME_ADJ, "kurz");
SetProp (P_NAME, "Buschmesser");
SetProp (P_GENDER, MALE);
SetProp (P_VALUE, 500+random(105));
SetProp (P_WEIGHT, 350);
SetProp (P_MAGIC, 0);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Dieses leicht gebogene Buschmesser ist ca so lange wie ein menschlicher "
"Unterarm und blitzt sehr scharf."));

AD(({"unterarm","arm"}),
  "Fuer ein Messer ist es sehr lang.");
  
AddId(({"messer","buschmesser"}));

SP(P_SHORT, "Ein Buschmesser");

SetProp (P_DAM_TYPE, ({ DT_RIP}));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 130);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_STEEL:90, MAT_WOOD:10]));

}