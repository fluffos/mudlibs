
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Paar Lederstiefel");
  SetProp (P_LONG,BS(
"Die Lederstiefel sind aus dickem Rotheleder. Sie sind aber gut gefettet und "
"daher recht biegsam. Sie sehen sehr widerstandsfaehig aus."));

AD(({"leder","rotheleder"}),
  "Rotheleder ist zwar sicher nicht das angenehmste fuer Stiefel, aber es ist "
  "sehr widerstandsfaehig.");

   
  SetProp (P_NAME, "Paar Lederstiefel");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"lederstiefel","stiefel"}));
  SetProp (P_WEIGHT, 310);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 312);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 3);
  SetProp(P_MATERIAL, (MAT_LEATHER));
  
}
