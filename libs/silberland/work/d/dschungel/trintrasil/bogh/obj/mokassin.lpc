
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Paar Mokassin");
  SetProp (P_LONG,BS(
"Die Mokassin bestehen aus Ziegenleder. Die Ziege muss noch recht jung gewesen "
"sein, denn das Leder ist weich und die Mokassin sind recht angenehm zu tragen."));

AD(({"leder","ziegenleder","ziege"}),
  "Das Leder ist angenehm weich und begsam.");

  SetProp (P_NAME, "Paar Mokassin");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"mokassin","ledermokassin"}));
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 423);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 2);
  SetProp(P_MATERIAL, (MAT_LEATHER));
  
}
