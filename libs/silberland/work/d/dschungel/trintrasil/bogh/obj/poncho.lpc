
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein bunter Poncho");
  SetProp (P_LONG,BS(
    "Der bunte Poncho besteht aus einer dicken Wolldecke in die ein Halsschlitz "
    "geschnitten wurde. Er leuchtet in vielen bunten Farben, fuer Dich ist "
    "er aber zu klein und daher sehr unbequem."));
  SP(P_NAME_ADJ, "bunt");
  SetProp (P_NAME, "Poncho");
  SetProp (P_GENDER, MALE);
  AddId (({"poncho"}));
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 510);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 4);
  SetProp(P_MATERIAL, (MAT_CLOTH));

  AD(({"decke","wolldecke"}),
    "Die Wolle ist zwar etwas rauh, aber sie haelt schoen warm und bietet auch "
    "guten Schutz vor Regen.");
    
  AD(({"schutz","regen"}),
    "Das ist in den Tropen sicher praktisch.");
    
  AD(("tropen"),
    "Das ist sicher nicht in Midas.");
    
  AD(({"midas","weltbild"}),
    "Ist jetzt Dein Weltbild zerstoert?");
    
  AD(("farben"),
    "Der Poncho leuchtet in vielen verschiedenen froehlichen Farben.");  
}

