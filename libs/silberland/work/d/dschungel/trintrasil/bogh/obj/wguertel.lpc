
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Wollguertel");
  SetProp (P_LONG,BS(
    "Der Wollguertel ist eigentlich eher ein roter Riemen aus Wollschweinwolle "
    "die vor dem Bauch geschnuert wird."));
    
  SetProp (P_NAME, "Wollguertel");
  SetProp (P_GENDER, MALE);
  AddId (({"guertel","riemen","wollguertel","wollriemen"}));
  SetProp (P_WEIGHT, 135);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 89);
  SetProp (P_ARMOUR_TYPE, AT_BELT);
  SetProp (P_AC, 1);
  SetProp(P_MATERIAL, (MAT_COTTON));

  AD(({"wolle","wollschweinwolle"}),
    "Der rote Wollriemen sieht zwar recht grob aus, ist aber sicher sehr "
    "reissfest.");
    
  AD(({"bauch"}),
    "Sei froh das Du einen hast, auch wenn er haesslich aufgequollen ist.");
}

