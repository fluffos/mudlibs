
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine Vogelschaedelkette");
  SetProp (P_LONG,BS(
"Die Kette besteht aus bunt bemalten, aufgefaedelten winzigen "
"Vogelschaedelchen."));

 AD(({"schaedel","vogelschaedelchen","schaedelchen","vogelschaedel","vogel"}),
   "Die kleinen Schaedel wurden in den verschiedensten Farben bemalt. In "
   "manche Schaedel sind auch feine Muster geritzt.");
   
 AD(("farben"),
   "Alle moeglichen Farben.");
   
 AD(({"kreise","kreuze","striche","muster"}),
   "Feine sorgfaeltig eingeritzte Kreise, Kreuze und Striche.");
   
  SetProp (P_NAME, "Schaedelkette");
  SetProp (P_GENDER, FEMALE);
  AddId (({"kette","schaedelkette","vogelschaedelkette","schaedelchenkette",
           "vogelschaedelchenkette","vogelkette"}));
  SetProp (P_WEIGHT, 30);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 60);
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 1);
  SetProp(P_RESISTANCE, ({DT_TERROR, DT_UNHOLY}));
  SetProp(P_MATERIAL, (MAT_BONE));
  
}

