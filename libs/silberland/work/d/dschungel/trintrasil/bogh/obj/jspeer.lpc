
inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


create()
{

if (!is_clone(this_object()))
return;
::create();


SetProp (P_NAME, "Jagdspeer");
SetProp (P_GENDER, FEMALE);
SP(P_NAME_ADJ, "kurz");
SetProp (P_VALUE, 500+random(101));
SetProp (P_WEIGHT, 700);
SetProp (P_MAGIC, 0);
SetProp (P_WEAPON_TYPE, WT_SPEAR);
SP(P_LONG, BS(
"Der kurze, massive Jagdspeer kann entweder als Stosswaffe, oder auch als "
"Wurfwaffe verwendet werden. Das Schwergewicht des Speeres liegt zu einem "
"grossen Teil in der Spitze, um ihm bessere Wurfeigenschaften zu geben. "
"In einem normalen Kampf ist dieser Speer eher unhandlich."));

AD(("spitze"),
"Die Spitze ist breit und schwer.");

AD(({"stosswaffe"}),
"In einem normalen Kampf wird der Speer hauptsaechlich als Stosswaffe "
"eingesetzt.");

AD(("wurfwaffe"),
"Bei der Jagd wird der Speer oft als Wurfwaffe verwendet.");

AD(({"teil","eigenschaften","wurfeigenschaften","schwergewicht","gewicht"}),
"Somit senkt sich die Spitze bei einem Wurf besser und der Speer kann nicht "
"mit dem Schaft auftreffen.");

AD(({"holz","eichenholz","schaft"}),
"Der Schaft ist aus starkem Eichenholz.");

AddId(({"speer","jagdspeer"}));

SP(P_SHORT, "Ein kurzer Jagdspeer");

SetProp (P_DAM_TYPE, (DT_RIP));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 120);
SetProp (P_NR_HANDS, 2);
SetProp (P_MATERIAL, ([MAT_STEEL:10, MAT_OAK:90]));

}