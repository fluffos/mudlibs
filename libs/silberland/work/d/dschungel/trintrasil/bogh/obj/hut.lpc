
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Filzhut");
  SetProp (P_LONG,BS(
    "Dieser Filzhut aus rotem Filz ist anscheinend fuer einen sehr kleinen "
    "Kopf gemacht. Er hat eine sehr breite Krempe, und im Hutband steckt eine "
    "lange Feder."));
  SetProp (P_NAME, "Filzhut");
  SetProp (P_GENDER, MALE);
  AddId (({"hut","filzhut"}));
  SetProp (P_WEIGHT, 40);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 300);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
  SetProp (P_AC, 2);
  SetProp(P_MATERIAL, (MAT_FELT));

  AD(({"filz"}),
    "Der Filz ist sehr dick und knallrot.");
    
  AD(({"krempe"}),
    "Die Krempe ist sehr breit und ist ein guter Schutz gegen Regen und spendet "
    "auch gut Schatten.");
    
  AD(({"schutz","regen","schatten","dschungel"}),
    "Der Hut waere fuer den Dschungel recht geeignet.");

  AD(({"band","hutband"}),
    "Das duenne Hutband besteht aus schwarzem Leder.");
    
  AD(({"leder","rotheleder"}),
    "Das Leder ist von einer Rothe. Es ist gut gefettet und glaenzt schwarz.");
    
  AD(({"rothe","haustier","nutztier"}),
    "Die Rothe ist ein recht seltenes, kuhartiges Nutztier, das dazu geeignet "
    "ist auch in Hoehlen gehalten zu werden.");
    
  AD(({"schwingenfeder","feder"}),
    "Die Feder ist sehr lang. Es scheint eine Schwingenfeder eines Fischadlers "
    "zu sein.");    

  AD(({"fischadler","adler","vogel"}),
    "Ein wahrlich praechtiger und majestaetischer Vogel!");

  AD(({"idiot","kopf"}),
    "Dein Kopf ist fuer diesen Hut eigentlich zu gross. Darum siehst Du damit "
    "sicher aus wie ein Idiot.");
}

