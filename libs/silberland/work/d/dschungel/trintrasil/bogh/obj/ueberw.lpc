
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Wollueberwurf");
  SetProp (P_LONG,BS(
    "Der Ueberwurf ist aus Wollschweinwolle gewebt. Er mit feinen, braunen "
    "Mustern bestickt, sieht aber ansonsten recht grob aus."));
  SetProp (P_NAME, "wollueberwurf");
  SetProp (P_GENDER, MALE);
  AddId (({"ueberwurf","wollueberwurf"}));
  SetProp (P_WEIGHT, 180);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 310);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 4);
  SetProp(P_MATERIAL, (MAT_COTTON));

  AD(({"wolle","schweinewolle","wollschweinwolle"}),
    "Wollschweinwolle ist kratzig und unangenehm zu tragen.");
    
  AD(({"muster"}),
    "Die Muster wurden mit rotbraun gefaerbten Wollfaeden gestickt. Sie sind "
    "zwar recht einfach, aber huebsch.");
    
  AD(({"wollfaeden","faeden"}),
    "Rotbraun gefaerbte Wollschweinwolle.");
    
}

