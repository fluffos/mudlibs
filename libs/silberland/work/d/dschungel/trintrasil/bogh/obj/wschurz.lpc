
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Wollschurz");
  SetProp (P_LONG,BS(
"Der Lendenschurz ist aus rauher Wollschweinwolle gewebt und kratzt ein wenig. "
"Ausserdem ist er selbst fuer einen Zwerg recht klein. Ein Troll koennte "
"ihn eventuell als Kragen um den Hals tragen."));

  AD(({"wolle","kleidung","schweinwolle","wollschweinwolle"}), 
    "Diese Wolle ist ziemlich rauh und wird daher nur selten fuer Kleidunge "
    "verwendet.");
    
  AD(("zwerg"),
    "Wenn einem Stinkzwerg einmal etwas zu klein ist dann heisst das was!");
    
  AD(({"kragen","troll"}),
    "Ein Troll mit einem Lendenschurz als Kragen kann auch nicht duemmer "
    "aussehen als normal.");
      
  AD(("hals"),
    "Manche Trolle haben sowas.");
    
  SetProp (P_NAME, "Wollschurz");
  SetProp (P_GENDER, MALE);
  AddId (({"schurz","lendenschurz","wollschurz"}));
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 200);
  SetProp (P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp (P_AC, 3);
  SetProp(P_MATERIAL, (MAT_COTTON));
  
}

