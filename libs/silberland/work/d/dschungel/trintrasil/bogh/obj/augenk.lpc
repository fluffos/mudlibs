inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/players/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"klappe","augenklappe"}));
   SetProp(P_NAME, "Augenklappe");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT,"Eine Augenklappe");
   SetProp(P_LONG, BS("Die kleine, schmucklose Augenklappe ist aus Ziegenleder. "
                      "Fuer Dich ist sie eigentlich unbrauchbar und."));
   
   AD(({"leder","ziegenleder"}),
     "Die Klappe ist aus einfachem rauhem Ziegenleder gefertigt. Wenn Du sie "
     "verkaufst wird sie Dir wohl nicht viel einbringen.");

   SetProp(P_MATERIAL,MAT_LEATHER);
   SetProp(P_VALUE,15);
   SetProp(P_WEIGHT,10);
}

