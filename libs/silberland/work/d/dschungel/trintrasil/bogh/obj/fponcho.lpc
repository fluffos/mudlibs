
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Fellponcho");
  SetProp (P_LONG,BS(
    "Der Fellponcho wurde aus den verschiedensten Fellen genaeht und sieht "
    "so sehr gefleckt aus."));
  SetProp (P_NAME, "Fellponcho");
  SetProp (P_GENDER, MALE);
  AddId (({"poncho","fellponcho"}));
  SetProp (P_WEIGHT, 380);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 409);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 4);
  SetProp(P_MATERIAL, (MAT_PELT));

  AD(({"fell","felle"}),
    "Felle in unterschiedlichen Faerbungen wurden verwendet, so das der Poncho "
    "recht bunt aussieht.");
    
  AD(({"farbe","faerbung","faerbungen"}),
    "Der Poncho ist rattengrauhaselmausgelbrothebraunmaultierschwarz.");
    
    
}

