
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine Wollhose");
  SetProp (P_LONG,BS(
"Die Wollhose ist aus kratziger Wollschweinwolle. Sie ist mit feinen duennen "
"Lederschnueren genaeht und sieht recht grob aus."));

  AD(({"wollschweinwolle","wolle","schweinewolle","schweinwoll"}), 
    "Wollschweinwolle ist zwar fest und widerstandsfaehig, aber sie ist "
    "kratzig und nicht sehr bequem.");
    
  AD(({"lederschnuere","leder","schnuere"}),
    "Die Hose wurde mit duennen aber starken Lederschnueren genaeht.");
        
    
  SetProp (P_NAME, "Wollhose");
  SetProp (P_GENDER, FEMALE);
  AddId (({"wollhose","wollschweinwollhose","hose"}));
  SetProp (P_WEIGHT, 260);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 275);
  SetProp (P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp (P_AC, 3);
  SetProp(P_MATERIAL, (MAT_COTTON));
  
}

