
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Paar Fellstiefel");
  SetProp (P_LONG,BS(
"Die Fellstiefel sind aus festem Rothefell und sehen recht widerstandsfaehig "
"aus. Als Verzierung sind ein paar einfache Muster eingebrannt."));

AD(({"fell","rothefell"}),
  "Rothefell ist ganz kurz und borstig.");

AD(({"verzierung","muster"}),
  "Mit einem heissen Eisen wurden in das  braune Fell verschlungene Kreise "
  "eingebrannt.");
  
AD(({"eisen","kreise"}),
  "Das ist zwar ein einfaches Muster, aber recht huebsch.");
   
  SetProp (P_NAME, "Paar Fellstiefel");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"fellstiefel","stiefel"}));
  SetProp (P_WEIGHT, 270);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 393);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 3);
  SetProp(P_MATERIAL, (MAT_PELT));
  
}
