
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine Fellhose");
  SetProp (P_LONG,BS(
"Die Fellhose besteht aus Rothefell und ist sehr grob gearbeitet. Ausserdem "
"ist sie fuer Dich eigentlich zu klein und daher ziemlich unangenehm."));

  AD(({"fell","rothefell"}), 
    "Das Fell einer Rothe ist kurzhaarig und recht borstig.");
    
  SetProp (P_NAME, "Fellhose");
  SetProp (P_GENDER, FEMALE);
  AddId (({"hose","fellhose","rothehose"}));
  SetProp (P_WEIGHT, 400);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 600);
  SetProp (P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp (P_AC, 4);
  SetProp(P_MATERIAL, (MAT_PELT));
  
}

