
#include <properties.h>
#include <language.h>
#include "/players/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

inherit "/std/room";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"Hier zweigt eine kleine Hoehle nach norden von der grossen Haupthoehle ab. "
"Der Eingang ist mit einem Vorhang aus Holzperlenschnueren verhaengt, es "
"scheint sich um einen kleinen Laden zu handeln. Im Osten, in der Mitte "
"der grossen Hoehle brennt ein kleines Feuer um das sich einige Boghanik "
"tummeln. Aus dem Westen schimmert Tageslicht."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 

  AddItem("/d/dschungel/trintrasil/bogh/npc/bogh5", REFRESH_DESTRUCT);
   
  AddExit("osten", ("/d/dschungel/trintrasil/bogh/room/bogpub")); 
 
  AddExit("nordosten", ("/d/dschungel/trintrasil/bogh/room/bog1"));
 
  AddExit("suedosten", ("/d/dschungel/trintrasil/bogh/room/bog3"));

  AddExit("sueden", ("/d/dschungel/trintrasil/bogh/room/bog4"));

  AddExit("westen", ("/d/dschungel/trintrasil/bogh/room/bog5"));

  AddExit("norden", ([
          EX_FUNC:"laden",
          EX_PLMSG:"\n Der Perlenvorhang raschelt leise als Du den Laden "
                   "betrittst.\n\n"]));
 
  
  AddSound(("stimmen"),
    "Ausgelassenes Stimmengewirr hallt durch die Hoehle."); 
 

}

laden() {
	
 TPM("/d/dschungel/trintrasil/bogh/room/bogshop", M_GO, "leise raschelnd "
     "durch den Perlenvorhang nach Norden", "tritt",
     "kommt leise raschelnd durch den Perlenvorhang herein");
return 1;}

