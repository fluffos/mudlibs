
#include <properties.h>
#include <language.h>
#include "/players/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

inherit "/std/pub";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"In der Mitte der Halle flackert ein kleines Lagerfeuer ueber dem auf einem "
"Spiess ein grosser Flusshecht bruzzelt. Auf den Felsen und Staemmen die um "
"das Feuer gereiht sind hocken einige Boghanik und essen vergnuegt. Die alte "
"Boghanik die bedaechtig den Fischspiess dreht schenkt auch Getraenke aus. Du "
"koenntest Dir hier sicher etwas kaufen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  


  AddItem("/d/dschungel/trintrasil/bogh/npc/bogh7", REFRESH_DESTRUCT);

  AddItem("/d/dschungel/trintrasil/bogh/npc/bogh2", REFRESH_DESTRUCT);
  
     
  AddExit("osten", ("/d/dschungel/trintrasil/hoehle/room/perfor2")); 

  AddExit("norden", ("/d/dschungel/trintrasil/bogh/room/bog1"));

  AddExit("sueden", ("/d/dschungel/trintrasil/bogh/room/bog3"));
  
  AddExit("suedwesten", ("/d/dschungel/trintrasil/bogh/room/bog4"));
  
  AddExit("westen", ("/d/dschungel/trintrasil/bogh/room/bog2"));
 
  
  AddSound(("stimmen"),
    "Ausgelassenes Stimmengewirr hallt durch die Hoehle."); 
 

  AddDrink("Rothemilch", ({"milch", "rothemilch"}), 40, 17, 0, 6, ({ "Die Alte "
           "reicht Dir eine Schale kraeftige, gelbliche Rothemilch die Du "
           "in einem Zug austrinkst.",
           "&& trinkt eine Schale Rothemilch."}) );
  
  AddDrink("Pilzbier", ({"bier", "pilzbier"}), 53, 29, 4, 7, ({ "Die Alte "
           "Boghanik schenkt Dir freundlich laechelnd einen ordentlichen Becher "
           "Pilzbier ein.\n"
           "Obwohl es etwas ungewohnt schmeckt, findest Du das dunkle, wuerzige "
           "Bier nicht schlecht.",
           "&& trinkt ein kuehles Pilzen."}) );

/*  AddDrink("Wurzelsaft", ({"saft", "wurzelsaft"}), 62, ({(34 [1]),(17 [0])}), 
                                                   0, 8, ({ "Neugierieg beaugst "
           "Du den Becher mit dem wuerzig riechenden Saft den Dir die Alte "
           "reich.\n"
           "Der Saft schmeckt irgendwie nach Suppenkraut.",
           "&& trinkt einen Becher Wurzelsaft."}) ); 
*/

  AddFood("Hecht", ({"hecht", "fisch"}), 128, 57, 16, ({ "Die Alte "
          "Boghanik schneidet Dir ein schoenes Stueck vom Fisch ab und gibt Dir "
          "auf einem Holzteller dampfende Bonkoknollen dazu.\n"
          "Begeistert verspeisst Du alles bis zum letzen Kruemel.",
          "&& isst eine grosse Portion Flusshecht."}) );  
}
