
#include <properties.h>
#include <language.h>
#include "/players/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

inherit "/std/room";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"Du stehst vor einem besonders bearbeiteten Eingang zu einer Hoehle im Sueden. "
"Im Nordosten tummeln sich einige Boghanik um das Feuer in der Mitte der "
"Wohnhoehle. Aus dem Nordwesten schimmert Tageslicht."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 

AddItem("/d/dschungel/trintrasil/bogh/npc/bogh4", REFRESH_DESTRUCT);
 
  AddExit("norden", ("/d/dschungel/trintrasil/bogh/room/bog2")); 
 
  AddExit("nordosten", ("/d/dschungel/trintrasil/bogh/room/bogpub"));

  AddExit("nordwesten", ("/d/dschungel/trintrasil/bogh/room/bog5"));
  
  AddExit("osten", ("/d/dschungel/trintrasil/bogh/room/bog3"));
 
  
  AddSound(("stimmen"),
    "Ausgelassenes Stimmengewirr hallt durch die Hoehle."); 
 

}
