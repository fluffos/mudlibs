
#include <properties.h>
#include <language.h>
#include "/players/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

inherit "/std/room";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"Du stehst am westlichen Ende der grossen Haupthoehle. Ein ca 1m breiter Spalt, "
"durch den Tageslicht schimmert, fuehrt hier noch weiter nach Westen hinaus auf "
"den Fluss. Das Wasser des 'Rio de la Puseta', das durch den Spalt kommt, "
"reicht hier bis knapp vor Deine Fuesse. Am Ufer liegt ein kleines Kanu."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 
 
  AddExit("osten", ("/d/dschungel/trintrasil/bogh/room/bog2")); 

  AddExit("suedosten", ("/d/dschungel/trintrasil/bogh/room/bog4"));
   
  
  AddSound(("stimmen"),
    "Ausgelassenes Stimmengewirr hallt durch die Hoehle."); 
 
}

fackel_func() {

 call_out("fackel_func1", 1);
}


fackel_func1() {
 
 tell_room("/d/dschungel/trintrasil/bogh/room/bog5", "\n");
 tell_room("/d/dschungel/trintrasil/bogh/room/bog5", BS("Eine Fackel fliegt von "
           "draussen durch den Spalt und faellt zischend knapp vor Deinen "
           "Fuessen ins Wasser!"));
        }
        