
#include <properties.h>
#include <language.h>
#include "/players/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

inherit "/std/room";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"Du stehst hier in der noerdlichen Ecke der grossen Haupthoehle. Im Sueden "
"siehst Du ein kleines Feuer um das sich einige Boghanik versammelt haben. "
"Eine Holzleiter fuehrt hier in die oberen Wohnhoehlen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  

  AddItem("/d/dschungel/trintrasil/bogh/npc/bogh3", REFRESH_DESTRUCT); 
 
  AddExit("sueden", ("/d/dschungel/trintrasil/bogh/room/bogpub")); 
 
  AddExit("suedosten", ("/d/dschungel/trintrasil/hoehle/room/perfor2"));

  AddExit("suedwesten", ("/d/dschungel/trintrasil/bogh/room/bog2"));
 
  
  AddSound(("stimmen"),
    "Ausgelassenes Stimmengewirr hallt durch die Hoehle."); 
 

}
