
#include <properties.h>
#include <language.h>
#include "/players/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

inherit "/std/laden.lpc";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Tauschladen" );
  SetProp( P_INT_LONG, break_string(
"In dieser kleinen Hoehle tauschen die Boghanik seltene Waren. Du wirst hier "
"wohl mit Geld bezahlen muessen. Auf Tischen aus Holz liegen verschieden Waren. "
"Kleine Pilzlampen haengen von der Decke und verbreiten ein mildes, gruenes "
"Licht. Die gelben Sandsteinwaende sind geglaettet und mit vielfaeltigen "
"Mustern verziert."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  

  SetBuyFact( 1);
  
  SetStorageRoom("/d/dschungel/trintrasil/bogh/room/bogstore"); 

  AD(({"durchmesser","hoehle"}),
    "Die Hoehle hat nur einen Durchmesser von ca 5m. Auf einfachen, kleinen "
    "Holztischchen liegen Waren die Boghanik untereinander tauschen.");
    
  AD(("waren"),
    "Viele Waren haben die Boghanik selbst hergestellt, manche stammen aber "
    "anscheinend auch aus Tijara.");

  AD(("boghanik"),
    "Na wer ist damit wohl gemeint??");
 
  AD(({"tisch","tischchen","holztische","holztischchen","tische","holz"}), 
    "Die Holztische sind sehr einfach und zweckmaessig gearbeitet.");
    
  AD(({"wand","waende","sandsteinwand","sandsteinwaende"}),
    "Die gelben Sandsteinwaende wurden hier geglaettet und poliert. Sie "
    "sind ueber und ueber mit Muster verziert.");
    
  AD(("muster"),
    "Als Du die Muster genauer betrachtest erkennst Du eingemeisselte Bilder.");
    
  AD(("bilder"),
    "Die meissten Bilder wurden eingemeisselt, manche auch mit Farbe gemalt. "
    "Sie stellen fast alle Pflanzen oder Tiere da.");
    
  AD(({"erdfarben","farbe","farben","erdfarben"}),
    "Manche Bilder wurden mit roten, orangen, braunen oder gelben Erdfarben "
    "gemalt.");
   
  AD(({"pflanze","pflanzen"}),
    "Du erkennst viele Pflanzen aus dem Dschungel.");
    
  AD(("tiere"),
    "Du erkennst viele Tiere aus dem Dschungel. Nur ein gemaltes, besonders "
    "grosses Tier kommt Dir unbekannt vor.");
    
  AD(("tier"),
    "Das Tier sieht sehr furchterregend aus. Es besitzt drei Koepfe mit weit "
    "aufgerissenen blutroten Maeulern. Es sieht aus wie eine Hydra.");            
  
  AD(("maeuler"),
    "Die Maeuler sehen furchterregend aus.");
    
  AD(("koepfe"),
    "Wo dieses Tier wohl lebt?");
    
  AD(("hydra"),
    "Vielleicht kann Dir einer der Boghanik mehr ueber die Hydra sagen.");
      
  AD(({"fell","felle","tijara"}),
    "Manchmal schickt der Stamm einen Jaeger aus um Felle oder kostbare Steine "
    "in Tijara gegen andere Waren zu tauschen.");
    
  AD(({"stamm","jaeger"}),
    "Der Stamm bei dem Du Dich gerade befindest schickt manchmal Jaeger.");
    
  AD(("dschungel"),
    "Den Dschungel kennst Du wohl!");

  AD(("geld"),
    "Wenn Du hier einkaufst, erstehen die Boghanik mit Deinem Geld Waren in "
    "Tijara.");
            
  AD(({"edelsteine","steine"}),
    "Die Boghanik graben im Fels nach Edelsteinen.");
    
  AD(({"stollen","fels"}),
    "Der Sandstein hier ist nicht sehr mineralienreich. Die Stollen der Boghanik "
    "sind weiter weg.");
    
  AD(({"stein","sandstein"}),
    "Der glatte, poliert Sandstein schimmert gelb im sanften Licht.");
    
  AD(({"licht","lampen","pilzlampen","holzlaempchen","laempchen","pilzlaempchen"}),
    "Die kleinen Pilzlaempchen spenden sanftes, gruenes Licht.");
    
  AD(({"pilze","pilz"}),
    "In den Glaesern der kleinen Holzlaempchen wachsen phsopherzierende Pilze.");
    
  AD(("glaeser"),
    "Kleine runde Glaeser befinden sich in den Laempchen."); 

  AD(("boden"),
    "Der Boden besteht genauso aus Sandstein.");
    
  AD(("decke"),
    "Von der Decke haengen gruen leuchtende Pilzlaempchen.");    


  AddItem("/d/dschungel/trintrasil/bogh/npc/haendler", REFRESH_DESTRUCT);    
  
  AddItem("/d/dschungel/trintrasil/bogh/npc/jaeger", REFRESH_DESTRUCT);
  
  
  AddExit("sueden", ([
          EX_FUNC:"laden",
          EX_PLMSG:"\n Der Perlenvorhang raschelt leise als Du den Laden "
                   "verlaesst.\n\n"])); 
 
  
  AddSound(("stimmen"),
    "Ausgelassenes Stimmengewirr hallt durch die Hoehle."); 
 

}

laden() {
	
 TPM("/d/dschungel/trintrasil/bogh/room/bog2", M_GO, "den Laden "
     "durch den Perlenvorhang", "verlaesst",
     "kommt leise raschelnd durch den Perlenvorhang aus dem Laden");
return 1;}