
#include <properties.h>
#include <language.h>
#include "/players/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

inherit "/std/room";


void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Boghanikhoehle" );
  SetProp( P_INT_LONG, break_string(
"Du befindest Dich im suedlichen Teil der grossen Haupthoehle. Aus einer "
"Hoehle im Osten weht Dir ein eigenartiger Geruch entgegen. Im Norden siehst "
"Du das kleine Feuer das die Hoehle erhellt. An den Waenden wachsen hier "
"seltsame Pilze in leuchtenden Mustern."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_CAVE]) );  
 

  AddItem("/d/dschungel/trintrasil/bogh/npc/bogh6", REFRESH_DESTRUCT);
   
  AddExit("norden", ("/d/dschungel/trintrasil/bogh/room/bogpub")); 
 
  AddExit("nordosten", ("/d/dschungel/trintrasil/hoehle/room/perfor2"));

  AddExit("nordwesten", ("/d/dschungel/trintrasil/bogh/room/bog2"));

  AddExit("westen", ("/d/dschungel/trintrasil/bogh/room/bog4"));
 
  
  AddSound(("stimmen"),
    "Ausgelassenes Stimmengewirr hallt durch die Hoehle."); 
 

}
