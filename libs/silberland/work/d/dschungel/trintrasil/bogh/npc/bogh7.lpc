

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"
#include <mnpc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein dicker Boghanik");
  SetProp(P_LONG, BS(
    "Die isst anscheinend viel."));
  SetProp(P_NAME, "Boghanik");
  SetProp(P_GENDER, MALE);
  AddId(({"boghanik","dicker boghanik"}));

  create_default_npc(18);
  
  SP(P_NAME_ADJ, "dick");
  SetProp(P_RACE, "Unterirdischer");
  SetProp(P_SIZE, 118);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 20);

  SetProp (P_MNPC_AREA "bogh");
  SetProp (P_MNPC_WAIT, ({ random(10), 30, 50 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/trintrasil/bogh/room/bogpub.lpc");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_SPECIAL );
                           
  SetProp(P_MSGIN,  "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht");

  SetProp(P_DIE_MSG,  " stirbt dick.\n");

  AddInfo(DEFAULT_INFO, "schnattert in seiner klickenden Boghaniksprache, kann "
                        "Dich aber anscheinend nicht verstehen.\n");

  SUID;
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/lederst" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/fponcho" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/lguertel" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/fellho" );
  command("trage alles");
  
}