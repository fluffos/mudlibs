

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Xabbu der Jaeger");
  SetProp(P_LONG, BS(
    "Er hat bei diesem Boghanikvolk wohl die Stellung des ersten Jaegers inne. "
    "Sein glattes haarloses Gesicht ist von einer roten Narbe zerteilt. "
    "Trotzdem blicken Dich seine schwarzen pupillenlosen Augen recht freundlich "
    "an. Du koenntest ja versuchen ihn anzureden, er kennt als erfahrener "
    "Jaeger vielleicht Deine Sprache."));
  SetProp(P_NAME, "Xabbu der Jaeger");
  SetProp(P_GENDER, MALE);
  AddId(({"xabbu","boghanik","jaeger","erster jaeger"}));

  create_default_npc(15);
  
  SetProp(P_RACE, "unterirdischer");
  SetProp(P_SIZE, 127);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN,  "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht");

  SetProp(P_DIE_MSG,  " stirbt roechelnd.\n");

  AddInfo(DEFAULT_INFO, "Tut leid. Hab ik nie gesehen auf Wandern.\n");

  SUID;
  CLONEME( "/d/dschungel/trintrasil/hoehle/obj/bhacke" );
  command("zuecke spitzhacke");
  
}