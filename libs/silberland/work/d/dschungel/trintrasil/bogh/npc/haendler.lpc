

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Haendler");
  SetProp(P_LONG, BS(
    "Der Boghanik sieht weit herumgekommen aus, duerfte nun aber schon zu alt "
    "fuer Kundschafterreisen sein. Einige Narben und eine Augenklappe ueber dem "
    "linke Auge zeugen von einem gefaehrlichem und bewegtem Leben. Vielleicht "
    "war der alte Haendler ja sogar einmal erster Jaeger?"));
  SetProp(P_NAME, "Boghanik");
  SetProp(P_GENDER, MALE);
  AddId(({"boghanik","haendler"}));

  AD(({"reisen","kundschafterreisen"}),
    "Als Haendler hat er frueher sicher viele Reisen auf den Markt von Tijara "
    "unternommen. Er spricht sicher Deine Sprache.");
    
  AD(({"kampf","sprache"}),
    "Du kannst ja einmal mit ihm sprechen.");
    
  AD(({"markt","tijara"}),
    "Dort tauschen die Boghanik Waren.");
    
  AD(("waren"),
    "Sieh Dich doch um.");
    
  AD(({"narben","leben"}),
    "Fuer weite Reisen ist der Boghanik schon zu alt. Nun fuehrt er hier den "
    "kleinen Tauschladen.");
    
  AD(({"laden","tauschladen"}),
    "Schon mal geschaut wo Du Dich befindest?");
    
  AD(({"auge","augenklappe","klappe"}),
    "Das Auge hat er sicher in einem Kampf verloren.");
    
    
  create_default_npc(10);
  
  SP(P_NAME_ADJ, "alter");
  SetProp(P_RACE, "Unterirdischer");
  SetProp(P_SIZE, 104);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN,  "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht");

  SetProp(P_DIE_MSG,  " stuerzt zu Boden.\n");

  AddInfo(DEFAULT_INFO, "schnattert in seiner klickenden Boghaniksprache, kann "
                        "Dich aber anscheinend nicht verstehen.\n");

  SetChats(6, ({
  	"Der Haendler fuellt vorsichtig Naehrloesung in einer Pilzlampe nach.\n",
  	"Der Haendler zeigt einem Kunden seine Warenauswahl.\n",
  	"Der Haendler zupft seine Augenklappe zurecht.\n",
  	"Der Haendler klimpert mit seiner Vogelschaedelkette.\n",
  	"Der Haendler scherzt mit einem anderen Boghanik.\n",
  	"Der Haendler nimmt einen Schluck Rothemilch aus einer Kuerbisflasche.\n",
  	"Der Haendler schwingt pruefend einen neuen Saebel.\n",
  	"Der Haendler schleift gedankenverloren sein Buschmeser.\n",
  	"Der Haendler sieht Dich erwartungsvoll an.\n",
  	"Der Haendler bietet dem Jaeger einen Schluck aus seiner Flasche an.\n",
  	"Der Haendler kramt suchend unter einem Tisch.\n",
  	"Der Haendler bietet Dir einen Saebel zum Kauf an.\n",
  	"Der Haendler unterhaelt sich in klickenden Lauten mit einem Boghanik.\n", 
  	"Der Haendler begutachtet ein Loch in einem Fellumhang.\n"}));
  	
  	
  SUID;
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/augenk" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/poncho" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/hut" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/vkette" );
  command("trage alles");
  
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/buschm" );
  command("zuecke messer");  
}