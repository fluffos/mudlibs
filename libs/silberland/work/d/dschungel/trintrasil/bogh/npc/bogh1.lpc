

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Boghanik");
  SetProp(P_LONG, BS(
    "Der Boghanik scheint Dich gar nicht zu bemerken. Er sitzt auf einem "
    "Fell und schnitzt konzentriert an einem Holzstueck."));
  SetProp(P_NAME, "Boghanik");
  SetProp(P_GENDER, MALE);
  AddId(({"boghanikar"}));

  create_default_npc(17);
  
  SP(P_NAME_ADJ, "klein");
  SetProp(P_RACE, "unterirdischer");
  SetProp(P_SIZE, 114);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN,  "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "eilt zur Schleuse");

  SetProp(P_DIE_MSG,  " stirbt roechelnd.\n");

  AddInfo(DEFAULT_INFO, "konzentriert sich ganz aufs Schnitzen.\n");

  SUID;
  CLONEME("/d/dschungel/trintrasil/hoehle/obj/messer");
  command("zuecke messer");
  CLONEME( "/d/dschungel/trintrasil/hoehle/obj/fell" );
  
}