

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"
#include <mnpc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine reiche Boghanik");
  SetProp(P_LONG, BS(
    "Midas ist eine reiche Stadt! Da muss es einfach reiche Buergerinnen geben!"));
  SetProp(P_NAME, "Boghanik");
  SetProp(P_GENDER, FEMALE);
  AddId(({"boghanik","reicher boghanik"}));

  create_default_npc(14);
  
  SP(P_NAME_ADJ, "reich");
  SetProp(P_RACE, "Unterirdischer");
  SetProp(P_SIZE, 124);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 35);

  SetProp (P_MNPC_AREA "bogh");
  SetProp (P_MNPC_WAIT, ({ random(10), 30, 50 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/trintrasil/bogh/room/bog3.lpc");
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_SPECIAL );
                         
  SetProp(P_MSGIN,  "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht");

  SetProp(P_DIE_MSG,  " stirbt reich.\n");

  AddInfo(DEFAULT_INFO, "schnattert in ihrer klickenden Boghaniksprache, kann "
                        "Dich aber anscheinend nicht verstehen.\n");

  SUID;
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/fjacke" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/wschurz" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/mokassin" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/wguertel" );
  command("trage alles");
  
}