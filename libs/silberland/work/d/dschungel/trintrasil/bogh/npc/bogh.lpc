

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein bulliger Boghanik");
  SetProp(P_LONG, BS(
    "Der Boghanik ist im Vergleich mit den anderen Boghanik recht gross und bullig. "
    "Er mustert Dich neugierig mit seinen grossen, schwarzen, pupillenlosen "
    "Augen, wendet sich dann aber wieder uninteressiert ab. Er ist voller "
    "Gesteinstaub."));
  SetProp(P_NAME, "Boghanik");
  SetProp(P_GENDER, MALE);
  AddId(({"boghanik","boghanikar"}));

  create_default_npc(19);
  
  SP(P_NAME_ADJ, "bullig");
  SetProp(P_RACE, "Unterirdischer");
  SetProp(P_SIZE, 134);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN,  "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "eilt zur Schleuse");

  SetProp(P_DIE_MSG,  " stirbt roechelnd.\n");

  AddInfo(DEFAULT_INFO, "schnattert in seiner klickenden Boghaniksprache, kann "
                        "Dich aber anscheinend nicht verstehen.\n");

  SUID;
  CLONEME( "/d/dschungel/trintrasil/hoehle/obj/bhacke" );
  command("zuecke spitzhacke");
  
}