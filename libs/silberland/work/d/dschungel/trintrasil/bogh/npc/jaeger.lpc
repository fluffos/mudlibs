

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Jaeger");
  SetProp(P_LONG, BS(
    "Der Boghanik oeffnet gerade ein Buendel mit Fellen die er anscheinend "
    "eintauschen moechte. Er sieht sich interessiert um. Seinen kurzen "
    "Jagdspeer hat er locker auf seinen Ruecken gebunden."));
  
  SetProp(P_NAME, "Jaeger");
  SetProp(P_GENDER, MALE);
  AddId(({"boghanik","jaeger"}));

  AD(({"buendel","felle"}),
    "Der Jaeger breitet Stolz seine schoenen Felle auf. Ermoechte sie "
    "anscheinend gegen andere Gegenstaende tauschen.");
    
  AD(({"gegenstaende"}),
    "Gegenstaende die er selbst nicht herstellt.");
    
  AD(({"ruecken"}),
    "Fuer einen Boghanik wirkt dieser Jaeger sehr muskuloes. Man merkt das "
    "er sich oft auf Jagd befindet.");
    
  AD(("jagd"),
    "Die Jagd ist fuer den ganzen Stamm ueberlebenswichtig.");
    
  AD(({"speer"}),
    "Den kurzen, handlichen Speer hat der Jaeger in einem Tragegurt an seinem "
    "Ruecken befestigt.");

  AD(({"tragegurt","gurt"}),
    "Bei langen Jagden ist so ein Gurt sicher sehr praktisch.");    
    
  create_default_npc(16);
  
  SetProp(P_RACE, "Unterirdischer");
  SetProp(P_SIZE, 123);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN,  "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht");

  SetProp(P_DIE_MSG,  " stuerzt zu Boden.\n");

  AddInfo(DEFAULT_INFO, "schnattert in seiner klickenden Boghaniksprache, kann "
                        "Dich aber anscheinend nicht verstehen.\n");

  SetChats(6, ({
  	"Der Jaeger rueckt seinen Speer zurecht.\n",
  	"Der Jaeger streicht stolz ueber sein Leopardenfell.\n",
  	"Der Jaeger unterhaelt sich schnatternd mit dem Haendler.\n",
  	"Der Jaeger erzaehlt dem Haendler von seinem letzen Streifzug.\n",
  	"Der Jaeger begutachtet pruefend ein Paar Stiefel.\n",
  	"Der Jaeger tauscht ein Fell ein.\n",
  	"Der Jaeger beobachtet Dich interessiert.\n",
  	"Der Jaeger stellt eine klickende Frage.\n",
     BS("Der Jaeger macht eine klickende Bemerkung die den Haendler zu Lachen "
        "bringt.\n") }));
  	
  	
  SUID;
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/leoumh" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/lederst" );
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/fellho" );
  command("trage alles");
  
  CLONEME( "/d/dschungel/trintrasil/bogh/obj/jspeer" );
  command("zuecke speer");  
}