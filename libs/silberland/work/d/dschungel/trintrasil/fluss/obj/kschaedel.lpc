
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"schaedel","kaimanschaedel","riesenkaimanschaedel","riesenschaedel"}));
   SetProp(P_NAME, "Kaimanschaedel");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );

   SetProp(P_SHORT, "Der Schaedel eines Riesenkaimans" );
   SetProp(P_LONG, BS(
   "Der Schaedel des Riesenkaimans ist beinahe einen Meter lang und sehr schwer. Die Stirnplatte "
   "des Schaedels ist dick und hart. Angeblich fertigen die Kannibalen aus den Schaedeln der "
   "Riesenkaimane Helme an. Da sie aber nur selten, und dann meistens sehr blutig Riesenkaimane "
   "erlegen koennen, sind solche Helme sehr wertvoll."));
   SetProp(P_MATERIAL,MAT_BONE);
   SetProp(P_VALUE,1+random(100));
   SetProp(P_WEIGHT,5000+random(1000) );
   SetProp(P_INFO, BS("Aus diesem Schaedelknochen kannst Du einen wertvollen Helm fertigen "
   "lassen."));
   
   AD(("meter"), 
   "Das Tier dem dieser Schaedel gehoerte muss wirklich riesig gewesen sein.");
   
   AD(({"kaiman","riesenkaiman","tier"}),
   "Riesenkaimane leben im Rio de la Puseta. Ein hungriger Riesenkaiman ist ein "
   "Schrecken seiner Nachbarschaft.");
   
   AD(("nachbarschaft"),
   "Wenn Du Spass willst dann suche doch die Nachbarschaft eines hungrigen Riesenkaimans.");
   
   AD(({"spass","schrecken"}),
   "Ein hungriger Riesenkaiman toetet alles, was langsamer ist als er, oder zu dumm zum "
   "Fliehen.");
   
   AD(("fliehen"),
   "Riesenkaiman vs. "+TPN+". Probieren geht ueber studieren.");
   
   AD(({"kannibalen","helme","helm"}),
   "Bei den Kannibalen gibt es Handwerker die solche Schaedel zu Helmen verarbeiten.");
   
   AD(("handwerker"),
   "Den findest Du sicher im Kannibalendorf.");
   
   AD(({"kannibalendorf","dorf"}),
   "Das Kannibalendorf liegt im Flussgebiet des Rio de la Puseta.");
   
   AD(({"fluss","flussgebiet","rio","rio de la puseta","puseta","dschungel"}),
   "Du bist wohl noch nicht im Dschungel gewesen?");
}
