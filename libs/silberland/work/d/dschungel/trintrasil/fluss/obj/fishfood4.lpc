
inherit "std/food";

#include <moving.h>
#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 

call_out("destruct_func", 15000+random(1000));

::create();

 SetProp(P_SHORT, "Sumpfploetze");
 SetProp(P_LONG, "Die Sumpfploetze ist ein fettiger Fisch und das rohe Fleisch "
 "reizt Dich nicht besonders, aber sie ist sicher sehr saettigend. Du solltest "
 "sie essen bevor sie verdirbt.");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_VALUE, 50+random(30));
 AddId(({"ploetze","sumpfploetze","fisch"}));
 SetProp(P_NAME, "Sumpfploetze");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);

 SetProp(P_FOOD_INFO, ([F_HEAL : ({1,1}), 
 F_SOAK : 1,
 F_MSG:"Melde bitte Trintrasil, dass mit der Sumpfploetze etwas nicht stimmt",
 F_MSG_ROOM:"isst eine rohe Sumpfploetze."]));
 SetProp(P_SMELL, "Du solltest die Sumpfploetze essen bevor sie zu stinken "
 "beginnt.\n");

 AD(({"fleisch"}),
   "So ein rohes Fleisch hat irgendwie etwas bodenstaendiges.");
}


destruct_func() {
	
object graete;
        
        graete=CLONEOB("/d/dschungel/trintrasil/fluss/obj/graete");
        graete->SetProp(P_LONG,"Die Graeten einer Sumpfploetze");
        graete->move(ENV(TO), M_GO+ M_SILENT);
        TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
	M_SILENT);
        TO->remove();
}
