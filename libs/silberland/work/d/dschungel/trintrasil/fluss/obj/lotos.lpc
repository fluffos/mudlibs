
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"staubgefaess","gefaess","lotos"}));
   SetProp(P_NAME, "Lotos");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein schwarzer Lotos" );
   SetProp(P_LONG, BS(
   "Das Staubgefaess des schwarzen Lotos ist voll mit dem gefaehrlichen "
   "Bluetenstaub."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_WOOD);//bloedsinn
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,2);

AD(({"bluetenstaub","staubgefaess","gefaess"}),
"Der Bluetenstaub des Schwarzen Lotos starke haluzinogene Wirkung. Von "
"eingeborenen Staemmen hier wird er angeblich manchmal vor Kaempfen benutzt.");

AD(("kaempfe"),
"Der Kaempfer verspuert dann kaum Schmerzen und ist nahezu bis zur "
"Selbstzerstoerung extrem leistungsfaehig.");

AD(("schmerzen"),
"Die Ausdauer, Koerperkraft und Geschicklich steigern sich fuer die Dauer der "
"Wirkung.");

AD(({"zerstoerung","wirkung","selbstzertoerung","dauer"}),
"Die Wirkung des Lotos dauert ca 30 min an. Dannach kommt es zu einer Phase "
"grosser Erschoepfung. Ausserdem wird man vom Schwarzen Lotos suechtig.");

AD(({"erschoepfung","phase"}),
"Die Erschoepfung dauert ca 60 min an. In dieser Zeit fuehlt man sich sehr "
"geschwaecht und schlecht. Ausserdem treten Entzugserscheinungen auf wenn "
"man dannach nicht regelmaessig Schwarzen Lotos nimmt.");

AD(({"erscheinungen","entzugserscheinungen"}),
"Je oefter man Schwarzen Lotos nimmt umso schlimmer werden die "
"Entzugserscheinungen. Wenn man diese allerdings ueberstanden hat, hat man "
"seine Sucht auch meistens ueberwunden.");

AD(("sucht"),
"Wenn Dir die Folgen gleichgueltig sind, kannst Du den Schwarzen Lotos einfach "
"einnehmen.");

AD(("folgen"),
"Die Folgen solltest Du ungefaehr kennen, sonst koenntest Du unangenehm "
"ueberrascht werden."); 
}