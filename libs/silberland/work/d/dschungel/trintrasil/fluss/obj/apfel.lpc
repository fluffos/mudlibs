
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "ein Flussapfel");
 SetProp(P_LONG, BS("Der Flussapfel ist zwar klein, aber knackig und ganz reif. "
                    "Auch wenn Flussaepfel etwas saeurlich schmecken sind sie "
                    "sehr erfrischend."));
 SetProp(P_GENDER, MALE);
 SetProp(P_WEIGHT, 20);
 SetProp(P_VALUE, 50);
 AddId(({"apfel","flussapfel"}));
 SetProp(P_NAME, "Flussapfel");
 SetProp(P_MATERIAL, MAT_FRUIT);
   
 SetProp(P_FOOD_INFO, ([F_HEAL : ({9 +random(8), 9}), F_SOAK : 2,
	F_MSG:"Hmmm, der saftige Apfel knackt beim Hineinbeissen.\n"
	      "Frisch, Saftig Dschungelig!\n",
	F_MSG_ROOM:"isst einen saftigen Flussapfel.\n"]));

}

