
inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
////////////////schere immer scharfee 
create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Krebsenschere");
SetProp (P_GENDER, FEMALE);
SP(P_NAME_ADJ, "scharf");
SetProp (P_VALUE, 300+random(50));
SetProp (P_WEIGHT, 50);
SetProp (P_MAGIC, 1);
SetProp (P_WEAPON_TYPE, WT_CLUB);
SP(P_LONG, BS(
"Mit dieser braun schimmernden Krebsenschere kann man sicher "
"schmerzhaft zwicken."));

AD(("krebs"),
  "Der Krebs vermisst seine Schere nicht mehr.");

AddId(({"schere","krebsenschere"}));

SP(P_SHORT, "Eine Krebsenschere");

SetProp (P_DAM_TYPE, ({ DT_RIP, DT_PIERCE}));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 150);
SetProp (P_WC_FIX, 50);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_HORN:100]));

}