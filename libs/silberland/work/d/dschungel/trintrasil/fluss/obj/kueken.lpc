inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <ansi.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


int nahrung=0;
int resetanzahl=0;
object secenv, firstenv;


reset() {
	if(nahrung==0 || resetanzahl==1) {
		write(BS("Das Kueken hoert ploetzlich auf zu piepsen und "
		"stirbt. Es ist wohl verhungert."));
		::reset();
		TO->remove();
	}
	if(nahrung==1 && resetanzahl==0) {
		write(BS("Gut, dass das Kueken schon gefuettert wurde, sonst "
		"waere es sicher schon verhungert. Trotzdem kann es nur seine "
		"Mutter richtig fuettern."));
		resetanzahl=1;
		::reset();
	}
}


	
create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"junge","moewenjunge","klippenmoewenjunge","kueken",
           "klippenmoewenkueken","moewenkueken","vogel"}));
   SetProp(P_NAME, ""+ANSI_RED+"Moewenkueken"+ANSI_NORMAL+"");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, ""+ANSI_RED+"Ein Moewenkueken"+ANSI_NORMAL+"" );
   SetProp(P_LONG, BS(
   "Das kleine Moewenkueken ist wohl gerade erst geschluepft und piepst "
   "herzzerreissend. Es flattert hilflos mit den kleinen flaumigen Fluegelchen "
   "und ruft nach seiner Mutter. Du solltest es unbedingt zurueck in das "
   "Moewennest setzen bevor es verhungert!!"));
   SetProp(P_MATERIAL, MAT_MISC_LIVING);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,1);
   SetProp(P_INFO, BS("Das Moewenkueken wird verhungern wenn Du es nicht "
   "zurueck in sein Nest setzt."));

 AD(({"flaum","federn"}),
   "Der Flaum des Kuekens ist ganz weich. Noch ist die Moewe grau. Wenn das "
   "Junge den Flaum abwirft wird es ein schoenes weisses Gefieder bekommen.");
   
 AD(("gefieder"),
   "Das Gefieder bekommt es natuerlich nur wenn Du es zu seiner Mutter zurueck "
   "bringst.");

 AD(("schnabel"),
   "Das Kueken sperrt den Schnabel weit auf und bettelt um Futter.");
      
 AD(({"fluegel","fluegelchen","stummel"}),
   "Die Fluegel sind noch kleine, flaumige Stummel, mit denen das Kueken "
   "hilflos flattert.");
   
 AD(({"vogelmutter","moewenmutter","klippenmoewenmutter","mutter"}),
   "Die Moewenmutter wuerde dem Kueken Futter geben. Du musst es moeglichst "
   "bald zu ihr zurueck bringen.");
   
 AD(({"nest","moewennest"}),
   "Das Kueken ist ein Klippenmoewenjunges. Die Klippenmoewen nisten an "
   "steilen Felswaenden und kommen hauptsaechlich im Canyon der Rio de la "
   "Puseta vor.");
   
 AD(({"canyon","schlucht","rio","rio de la puseta","fluss","dschungel"}),
   "Der Rio de la Puseta fliesst durch den Dschungel.");
   
 AD(("futter"),
   "Die Klippenmoewen ernaehren ihre Jungen hauptsaechlich von Fisch. Aber "
   "ein kleiner Wurm wuerde auch schon helfen. Aber trotzdem musst Du das "
   "Junge unbedingt zurueck bringen.");
   
 AD(("fisch"),
   "Einen Fisch kannst Du dem Jungen nicht fuettern, da Du ihn nicht so "
   "vorkauen koenntest wie seine Mutter.");
   
 AD(("wurm"),
   "Dem Kueken waere jeder Wurm recht, den Du ihm fuetterst, wenn er nicht zu gross ist.");
   
   
 AddCmd(({"fuettere","fuetter","ernaehre"}), "func_futter");
 
 
call_out("chat_func", 3+random(3));	     

}


chat_func() {

     if(environment(TO) && interactive(environment(TO)) ) {//chats wenn in einem spieler
  	
  	switch(random(5)) {
	     
	      	case 1 : tell_object(environment(TO),"\n!!PIIIIEEPP! !PIIIIEEPP!\n\n");
	      	         call_out("chat_func", 10+random(8));	      	
                break;
               
      	        case 2 : tell_object(environment(TO),"\nDas Kueken sucht seine "
      	                 "Mutter.\n\n");
      	                 call_out("chat_func", 10+random(8));
                break;
      	
      	        case 3 : tell_object(environment(TO),"\nDas Kueken flattert "
      	                 "hilflos mit den Fluegelchen.\n\n");
      	                 call_out("chat_func", 10+random(8));
                break;

      	        case 4 : tell_object(environment(TO),"\nDas Kueken braucht "
      	                 "dringend Futter.\n\n");
      	                 call_out("chat_func", 10+random(8));
                break;
                      	
      	        case 0 : tell_object(environment(TO),"\n!PIEPS! !PIEPS! !PIEPS! "
      	                 "!PIEPS!\n\n");
      	                 call_out("chat_func", 10+random(8));
      	        break;

      	        default: tell_object(environment(TO),"\n!!PIIIIEEPP! !PIIIIEEPP!\n\n");
      	                 call_out("chat_func", 10+random(8));
      	}  
     }
      
     if(environment(TO) && !interactive(environment(TO)) &&
        environment(TO)->QueryProp(P_ENVIRONMENT) ) {//chats in einem raum
     			
	switch(random(5)) {
	     
	      	case 1 : tell_room(ENV(TO),"\n!PIIIIEEPP! !PIIIIEEPP!\n\n");
	      	         call_out("chat_func", 10+random(8));	      	
                break;
               
      	        case 2 : tell_room(ENV(TO),"\nDas Kueken sucht seine "
      	                 "Mutter.\n\n");
      	                 call_out("chat_func", 10+random(8));
                break;
      	
      	        case 3 : tell_room(ENV(TO),"\nDas Kueken flattert hilflos mit "
      	                 "den Fluegelchen.\n\n");
      	                 call_out("chat_func", 10+random(8));
                break;

      	        case 4 : tell_room(ENV(TO),"\nDas Kueken braucht dringend "
      	                 "Futter.\n\n");
      	                 call_out("chat_func", 10+random(8));
                break;
                      	
      	        case 0 : tell_room(ENV(TO),"\n!PIEPS! !PIEPS! !PIEPS! "
      	                 "!PIEPS!\n\n");
      	                 call_out("chat_func", 10+random(8));
      	        break;

      	        default: tell_room(ENV(TO),"\n!PIEPS! !PIEPS! !PIEPS! "
      	                 "!PIEPS!\n\n");
      	                 call_out("chat_func", 10+random(8));
      	        }
      	}
      	
      	
        if(environment(TO) && !interactive(environment(TO)) &&
        environment(TO)->QueryProp(P_MAX_WEIGHT) )  {
    		
      		firstenv=environment(TO);
      		secenv=environment(firstenv);
      		
      		if(secenv) {
      			  switch(random(5)) {
      			  		
      			  	case 1 : tell_object(secenv,
      			  		 "\nDas Kueken bewegt sich im "
      			  		 "Beutel.\n\n");
	      	                         call_out("chat_func", 10+random(8));	      	
                                break;
               
      	                        case 2 : tell_object(secenv,"\nDas "
      	                                 "Kueken will aus dem Beutel!\n\n");
      	                                 call_out("chat_func", 10+random(8));
                                break;
      	
      	                        case 3 : tell_object(secenv,"\nHol doch das "
      	                                 "arme Kueken aus dem Beutel "
      	                                 "bevor es erstickt!\n\n");
      	                                 call_out("chat_func", 10+random(8));
                                break;

      	                        case 4 : tell_object(secenv,"\nDu hoerst das "
      	                                 "Kueken im Beutel piepsen.\n\n");
      	                                 call_out("chat_func", 10+random(8));
                                break;
                      	
      	                        case 0 : tell_object(secenv,"\n!PIEPS! !PIEPS! "
      	                                 "!PIEPS! !PIEPS!\n\n");
      	                                 call_out("chat_func", 10+random(8));
      	                        break;

      	                        default: tell_object(secenv,"\nDu "
      	                                "hoerst das Kueken im Beutel leise "
      	                                "piepsen.\n\n");
      	                        call_out("chat_func", 10+random(8));
      	                }
      	        }
      	}  
}  	      	



func_futter(string str) {

object wurm, kueken;
wurm=present("wurm", TP);
kueken=present("moewenkueken", TP);
	
	notify_fail("Was willst Du mit was fuettern?\n");
	
	if(str=="kueken"||str=="moewenkueken"||str=="klippenmoewenkueken"||
	str=="junges"||str=="moewenjunges"||str=="klippenmoewenjunges"||
	str=="vogel"||str=="moewe"||str=="klippenmoewe"||str=="kueken mit wurm"||
	str=="moewenkueken mit wurm"||str=="klippenmoewenkueken mit wurm"||
	str=="junges mit wurm"||str=="moewenjunges mit wurm"||
	str=="klippenmoewenjunges mit wurm"||str=="vogel mit wurm"||str=="moewe "
	"mit wurm"||str=="klippenmoewe mit wurm"||str=="kueken mit  wurm") {
		
		if(wurm && kueken && (wurm->QueryProp(P_WEIGHT)<=40) ){
			write(BS("Das Kueken sperrt seinen Schnabel weit auf "
			"und verschlingt gierig den Wurm. Nachdem es ihn "
			"geschluckt hat, beginnt es aber gleich wieder "
			"zu piepsen. Du solltest es trotzdem seiner Mutter "
			"zurueck bringen."));
			say(BS(""+TPN+" fuettert ein kleines Moewenkueken."));
			nahrung=1;
			wurm->remove();		
		return 1;}
		
		if(wurm && kueken && (!wurm->QueryProp(P_WEIGHT)<=40) ) {
			write(BS("Der Wurm ist fuer dieses Kueken leider "
			"zu gross. Vielleicht findest Du einen kleineren. "
			"Wenn Du es zu seiner Mutter zurueck bringst erledigt "
			"sie das Fuettern selber."));
		return 1;}
		
		
		if(!kueken) {
			write(BS("Du hast doch gar kein Kueken."));
		return 1;}
		
		if(!wurm && kueken) {
			write(BS("Du hast doch gar keinen Wurm."));
		return 1;}
	return 1;}
return 0;}

	
		
		
		