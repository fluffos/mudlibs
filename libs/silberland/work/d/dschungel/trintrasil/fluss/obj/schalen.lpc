
inherit "std/food";
#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{

string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Schalen");
 SetProp(P_LONG, BS("Die alten Eierschalen sehen zwar nicht gerade einladend "
                    "aus, aber ungesund sind sie sicher nicht.\n"));
 SetProp(P_GENDER, FEMALE);
 SetProp(P_WEIGHT, 30);
 SetProp(P_VALUE, 15);
 AddId(({"schalen", "eierschalen"}));
 SetProp(P_NAME, "Eierschalen");
 SetProp(P_MATERIAL, MAT_CHALK);

 SetProp(P_SMELL, "Die Eierschalen stinken irgendwie nach alter Eihaut.\n");

 AD(({"eihaut","haut"}),
   "Hunger ist der beste Koch.");
   
 SetProp(P_FOOD_INFO, ([F_HEAL : ({5, 5}), F_SOAK : 2,
	F_MSG:"Du zerkaust knackend die trockenen Eierschalen.\n",
	F_MSG_ROOM:"schiebt sich unappetitlich aussehende Eierschalen "
	           "in den Mund.\n"]));

}

