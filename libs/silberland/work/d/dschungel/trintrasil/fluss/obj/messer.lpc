

inherit "std/weapon";
#include <properties.h>     
#include <combat.h>        
#include <language.h>    
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Taschenmesser");
SetProp (P_GENDER, NEUTER);
SetProp (P_VALUE, 80);
SetProp (P_WEIGHT, 25);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Dieses kleine Taschenmesser sieht nicht einmal fuer Saeuglinge gefaehrlich "
"aus. Es eignet sich aber sicher zum Schnitzen. Dazu muesstest Du es aber erst "
"oeffnen."));


AddId(({"messer","taschenmesser"}));

SP(P_SHORT, "Ein kleines Taschenmesser");

SetProp (P_DAM_TYPE, ({ DT_RIP}));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 10);
SetProp (P_WC_FIX, 10);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_STEEL:10, MAT_OAK:90]));

AD(({"saeuglinge","saeugling"}),
  "Also ist es genau richtig fuer Dich.");
  
AD(({"schnitzen","holz"}),
  "Wenn Du geeignetes Holz hast dann kannst Du damit sicher relativ einfach "
  "schnitzen.");

AD(("holz"),
  "Graetenbuesche haben gutes Holz zum Schnitzen.");
  
AD(({"graetenbusch","graetenbuesche","busch","buesche"}),
  "Aus dem Holz von Graetenbueschen kann man besondere Pfeifen schnitzen.");
  
AD(({"fischpfeife","fischpfeifen","pfeife","pfeifen"}),
  "Mit den Pfeifen aus Graetenbuschholz kann man Fischpfeifen schnitzen mit den "
  "man am Rio de la Puseta riesige Fische anlocken kann.");
  
AD(({"fisch","fische"}),
  "Diese Fisch sind so riesig, dass man auf ihnen reiten kann wenn man sie "
  "einmal angelockt hat. Du musst nur an der richtigen Stelle am Rio de la "
  "Puseta pfeifen.");
  
AD(({"fluss","rio","rio de la puseta","puseta","stelle"}),
  "Wenn man an den richtigen Stellen am Rio de la Puseta mit der Fischpfeife "
  "pfeift lockt man riesige Fische an.");
  
      
AddCmd(("oeffne"), "func_oeffnen");
AddCmd(("klappe"), "func_klappen");

}

 _query_long() {
 
  if(!TO->QueryProp("geoeffnet")) {
    return BS("Dieses kleine Taschenmesser sieht nicht einmal fuer Saeuglinge "
              "gefaehrlich aus. Es eignet sich aber sicher zum Schnitzen. Dazu "
              "muesstest Du es aber erst oeffnen.");
              }
              		
  if(TO->QueryProp("geoeffnet")) {
    return BS("Dieses kleine Taschenmesser sieht nicht einmal fuer Saeuglinge "
              "gefaehrlich aus, eignet sich aber sicher zum Schnitzen. Es ist "
              "auch schon geoeffnet. Du kannst es aber auch wieder "
              "zusammenklappen.");
              } 
          }

int func_klappen(string str) {
	
  if(str=="messer zusammen"||str=="taschenmesser zusammen"||str=="messer"||
     str=="taschenmesser"||str=="messer ein"||str=="taschenmesser ein") {
     	
     if(TO->QueryProp("geoeffnet")) {
     
     write(BS("Du klappst das Taschenmesser wieder zusammen."));
     say(BS(""+TPN+" klappt ein Taschenmessen zusammen."));
     TO->SetProp("geoeffnet", 0);
     return 1;}
   
     if(!TO->QueryProp("geoeffnet")) {

     write(BS("Das Taschenmesser ist doch schon zusammengeklappt,"));
     return 1;}
   return 0;}
 return 0;}
   
             
             
int func_oeffnen(string str) {
	
  if(str=="messer"||str=="taschenmesser") {
  
   if(!TO->QueryProp("geoeffnet")) {   		
    
    write(BS("Du klappst das kleine Taschenmesser auf."));
    say(BS(""+TPN+" klappt ein kleines Taschenmesser auf."));
    TO->SetProp("geoeffnet", 1);
    return 1;}   
   
   if(TO->QueryProp("geoeffnet")) {
    
    write(BS("Das Taschenmesser ist schon geoeffnet."));
    return 1;}
  return 0;}
return 0;}
   
