
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"zaehne","anakondazaehne","zahnanakondazaehne","eckzaehne","zahn","anakondazahn",
   "zahnanakondazahn","eckzahn"}));
   SetProp(P_NAME, "Anakondazaehne");
   SetProp (P_PLURAL, 1);
   SetProp( P_GENDER , MALE);
   SetProp(P_ARTICLE, 1 );

   SetProp(P_SHORT, "Die Eckzaehne einer Zahnanakonda" );
   SetProp(P_LONG, BS(
   "Die Eckzaehne der Zahnanakonda sind nahezu 25 cm lang. Die Zahnanakonda ist die einzige "
   "Wuergeschlange die so lange Zaehne besitzt. Auch ohne Gift sind diese schaerfen Eckzaehne "
   "eine wirksame Waffe. Die Kannibalen nennen die Zahnanakonda auch schneller Tod."));
   SetProp(P_MATERIAL,MAT_BONE);
   SetProp(P_VALUE,200+random(100));
   SetProp(P_WEIGHT,400+random(100) );
   SetProp(P_INFO, BS("Die Kannibalen befestigen Anakondazaehne an ihre Kaimanhelme."));
 
   AD(({"wuergeschlange","anakonda","schlange","zahnanakonda"}),
   "Die Zahnanakonda ist eine Anakondaart, die im Flussgebiet des Rio de la Puseta vorkommt. "
   "Sie wird bis zu 9 meter lang und jagt nahezu alles unter Elefantengroesse.");
   
   AD(({"elefant","elefantengroesse","elefanten","groesse"}),
   "Elefanten sind doch etwas zu gross.");
   
   AD(("gift"),
   "Die zahnanakonda besitzt kein Gift. Aber mit ihrem Wuergegriff und solchen Zaehnen braucht "
   "sie das auch nicht.");
   
   AD(({"griff","wuergegriff"}),
   "Die Anakonda umschlingt ihre Beute und erdrueckt sie.");
   
   AD(({"groesse","beute"}),
   "Bei Deiner Groesse waerst Du als Beute recht ideal.");
        
   AD(({"gruende","waffe","bisse"}),
   "Wenn die Anakonda ihre Beute umschlungen hat ist sie sehr schnell erdrueckt oder durch Bisse "
   "getoetet.");
   
   AD(("kannibalen"),
   "Die Kannibalen leben im selben Gebiet wie die Zahnanakonda und nennen sie schneller Tod.");
   
   AD(("tod"),
   "Die Kannibalen haben anscheinend Gruende die Zahnanakonda so zu nennen.");
   
   AD(({"fluss","flussgebiet","rio","rio de la puseta","puseta","dschungel"}),
   "Du bist wohl noch nicht im Dschungel gewesen?");
}
