inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

int schrift=1;

reset() {
	
	::reset();
	tell_object(environment(TO), BS("Der Schaedel von Charles le Sabre "
	"zerbricht in kleine Stuecke."));
	remove();
}

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId(({"kopf","schaedel","totenschaedel","schaedesabre"}));
   SetProp(P_NAME, "Schaedel");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein bleicher Schaedel" );
   SetProp(P_LONG, BS(
   "Der Schaedel ist vollkommen plank und sieht abgescheuert aus, als waere er "
   "lange im Wasser gelegen. Du siehst dass er ueber den leeren, dunklen "
   "Augenhoehlen gesprungen ist."));   
   SetProp(P_MATERIAL,MAT_BONE);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,10);
   
   AD(("wasser"),
     "Der Schaedel wirkt verwittert. Ausserdem zieht sich ueber den halben "
     "Schaedel ein tiefer Sprung.");
     
   AD(("sprung"),
     "Der scheint von einer Verletzung zu stammen.");
     
   AD(("verletzung"),
     "Die Verletzung muss furchtbar gewesen sein und war sicher toetlich.");
     
   AD(({"augen","hoehlen","augenhoehlen"}),
     "Durch die leeren Augenhoehlen siehst Du in das Innere des Schaedels.");
     
   ASD(("Innere"),
     "innere");
     
   ASD(("rolle"),
     "lederrolle");
     
AddCmd(("greife"), "rolle");
}

innere() {
	
	if(schrift) {
	return(BS("Da ist doch eine kleine Rolle im Schaedel!"));
          }

        if(!schrift) {
        return(BS("Du starrst in das Innere des unheimlichen Schaedels, aber "
                  "er scheint leer zu sein."));
                }
        }
        
lederrolle() {
	
	if(schrift) {
	return(BS("Greife in den Schaedel. So koenntest Du sie heraus hohlen."));
	  }
	
	if(!schrift) {
		return(BS("Der Schaedel ist leer."));
	}
}

int rolle(string str) {
	
	object rolle;

        notify_fail("Wo willst Du hineingreifen?\n");
        
        if(str=="in schaedel"||str=="in den schaedel"||
           str=="in den schaedel hineine"||str=="in schaedel hinein"||
           str=="nach rolle") {
        
        if(schrift) {
        	   	
        write(BS("Du greifst in den Schaedel und holst vorsichtig mit den "
        "Fingerspitzen eine kleine, lederne Rolle heraus und steckst sie ein."));
                	
	rolle=CLONEOB("/d/dschungel/trintrasil/fluss/obj/rolle.lpc");
	rolle->move(TP, M_NOCHECK);
	
	schrift=0;
	return 1;}
        
        if(!schrift) {
        	
        write(BS("Du stocherst im Schaedel herum er ist aber anscheinend leer."));
        return 1;}
return 0;}
}

