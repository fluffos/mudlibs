
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

int zweige=5;

reset() {
::reset();
zweige=5;
}

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"busch","graetenbusch"}));
   SetProp(P_SHORT,""+ANSI_GREEN+"Ein kleiner Graetenbusch"+ANSI_NORMAL+"");
   SetProp(P_LONG, BS("Da er im sandigen Boden zu wenige Naehrstoffe findet "
                      "ist dieser Graetenbusch eher klein. Trotzdem "
                      "hat er die fuer Graetenbuesche typischen schnurgeraden "
                      "Zweige."));
   SetProp(P_NAME, "Graetenbusch");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_NOGET, "Du kannst den Graetenbusch nicht einfach ausreissen!\n");   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_VALUE,400);
   SetProp(P_WEIGHT,150000);

   
   ASD(({"zweig","zweige"}),
   "pfeifenzweige");
   
   ASD(("fisch"),
   "pininv");
   
   AD(({"fischpfeife","pfeifen","pfeife"}),
   "Aus dem knochenweissen zaehen Holz der Graetenbuesche kann man Pfeifen "
   "schnitzen die man zum Anlocken von Fischen verwenden kann.");
     
   AD(("anlocken"),
   "Wenn Du eine Fischpfeife hast pfeife einfach mit der Pfeife.");
   
   AD(("fische"),
   "Der Ton dieser Pfeifen erreicht die Frequenz der Brunftlaute von manchen "
   "sehr grossen Fischarten.");
     
   AD(({"fischarten","arten"}),
   "Man lockt damit sehr grosse Fisch des ´Rio de la Puseta´ damit an um "
   "auf ihnen ueber den Fluss zu reiten.");
      
   AD(({"ton","frequenz"}),
   "Der Ton ist so tief das Du ihn nicht hoeren kannst.");
   
   AD(({"brunftlaute","laute"}),
   "So aehnlich wie:´ Hallo willst Du mit mir gehen?´ oder:´ Entschuldigung "
   "wie spaet ist es bitte?´");
   
   ASD(("holz"),
   "holz");
   
   
   AddCmd(({"schneide"}), "func_zweig");
   

}


int func_zweig(string str) {
	
	object messer, tmesser, zweig;
	tmesser=present("boghmesser", TP);
	messer=present("messer", TP);

        notify_fail("Was willst Du abschneiden? Einen Zweig?\n");
        
        if(str=="zweig"||str=="zweig ab"||str=="einen zweig"||str=="einen zweig ab"||
        str=="zweig mit taschenmesser"||str=="zweig mit taschenmesser ab"||
        str=="einen zweig mit taschenmesser ab") {
        	
        	if(!zweige) {
        		
        		write(BSL("\n\nJemand hat von diesem Busch schon alle brauchbaren "
        		"Zweige abgeschnitten. Du musst leider warten bis sie wieder "
                        "nachwachsen."));
                        return 1;
                }
                
                if( (zweige)&&(messer)&&(messer->QueryWielded()) || (tmesser)&&
                (tmesser->QueryWielded()) ) {
                	
                	write(BSL("\n\nDu suchst einen besonders regelmaessigen Zweig aus "
                	"und setzt Dein Messer an. Das feine, weisse, von Pflanzensaft "
                	"tropfende Holz ist zaeh zu schneiden, Aber schon bald hast Du einen "
                	"brauchbaren Zweig aus dem Du eine Fischpfeife schnitzen kannst."));	
                	say(BSL("\n"+TPN+" schneidet einen Zweig vom Graetenbusch ab."));
                        zweig=CLONEOB("/d/dschungel/trintrasil/fluss/obj/zweig");
                        zweig->move(TP, M_NOCHECK);       
                        zweige--;
                        return 1;
                }
                
                if( (zweige)&&(messer)&&(!messer->QueryWielded()) ) {
                	
                	write(BSL("\n\nDu muesst Dein Messer schon zuecken. Mit einem Messer "
                	"in der Tasche kann man schwer einen Zweig abschneiden."));
                	return 1;
                }
                
                if( zweige && !messer ) {
                	
                	write(BSL("\n\nDu brauchst ein Messer um den Zweig abzuschneiden."));
                	return 1;
                }
                return 0;
        }
        return 0;
}

    
pininv() {
	
	if(!present("fischpfeife", TP)) {
		
		return(BS("Wenn Du eine Fischpfeife haettest koenntest Du hier grosse Fische "
		"anlocken, auf die Du dann klettern und auf den Fluss hinaus schwimmen "
		"koenntest."));
	}
	
	if(present("fischpfeife", TP)) {
		
		return(BS("Mit Deiner Fischpfeife koenntest Du hier grosse Fische anlocken, "
		"auf die Du dann klettern und auf den Fluss hinaus schwimmen koenntest."));
	}
}

    
pfeifenzweige() {
	
	if(zweige>1) {
		
		return BS("Die fingerduennen, aber sehr zaehen, schnurgeraden Zweige der "
                "Graetenbuesche werden zum Schnitzen von ganz besonderen Pfeifen "
                "verwendet. Du siehst noch "+zweige+" brauchbare Zweige die Du "
                "abschneiden koenntest.");
        }
        
        if(zweige==1) {
        	
        	return BS("Die fingerduennen, aber sehr zaehen, schnurgeraden Zweige der "
                "Graetenbuesche werden zum Schnitzen von ganz besonderen Pfeifen "
                "verwendet. Du siehst noch einen brauchbaren Zweig den Du "
                "abschneiden koenntest.");
        }
        
        if(zweige<1) {
        	
        	return BS("Die fingerduennen, aber sehr zaehen, schnurgeraden Zweige der "
                "Graetenbuesche werden zum Schnitzen von ganz besonderen Pfeifen "
                "verwendet. Leider hat hier bereits jemand alle brauchbaren Zweige "
                "abgeschnitten.");
        }
}


holz() {
	
	if(zweige>1) {
		
		return(BS("Das Holz ist knochenweiss und sehr zaeh. Du erkennst noch "
		""+zweige+" brauchbare Zweige."));
	}
	
	if(zweige==1) {
		
		return(BS("Das Holz ist knochenweiss und sehr zaeh. Du erkennst aber nur noch "
		"einen brauchbaren Zweig."));
	}
	
	if(zweige<1) {
		
		return(BS("Das Holz ist knochenweiss und sehr zaeh. Leider sind aber schon alle "
		"Zweige abgeschnitten."));
	}
}	