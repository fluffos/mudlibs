
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId(({"buch","traktat","traktatus","traktatus tijarae"}));
   SetProp(P_NAME, "Traktatus Tijarae");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Traktatus Tijarae" );
   SetProp(P_LONG, BS(
   "Der Traktatus Tijarae wurde erst vor kurzem hier im Stift verfasst und gilt bereits "
   "als das bedeutenste geschichtliche Werk ueber die Stadt Tijara, auch wenn ihn viele "
   "am liebsten verbrennen und verbieten wuerden. Das grosse, schwere Buch ist in Kalbsleder "
   "gebunden und strahlt trotz seiner Schlichtheit eine gewisse Wuerde aus."));   

   SetProp(P_MATERIAL,MAT_LEATHER);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,500);
   
   AD(("leder"),
   "Das schmucklose Kalbsleder ist einfach und zweckmaessig.");
     
   AD(("schlichtheit"),
   "Auesserlich ist das Buch schlicht gehalten. Allerdings soll sein Inhalt brisant sein "
   "und fuer hitzige Diskussionen gesorgt haben.");
   
   AD(({"inhalt","diskussionen","besonderes","diskussion"}),
   "Du kannst das Buch ja selber lesen. Aber anscheinend wuerden einige einflussreiche "
   "Menschen das Buch wegen seiner Offenheit gerne verbieten. Und auch Volksverhetzung "
   "wurde dem Autor vorgeworfen. Bis jetzt konnte der Stift die Verbrennung aber verhindern.");
     
   AD(("offenheit"),
   "Viele stellen die Offenheit des Buches als falsch hin und verweisen auf die "
   "Besiedelungslegende als einzige geschichtliche Quelle.");
     
   AD(({"quelle","legende","besiedelungslegende"}),
   "Historiker meinen dagegen die erste Besiedelungsgeschichte sei eben eine Legende weil "
   "sie nur durch Erzaehlungen ueber das Ereignis ohne tiefere Nachforschungen entstanden "
   "sein.");
     
   AD(({"nachforschungen","nachforschung"}),
   "Jedes wissenschaftliche Werk muss auf gruendliche Nachforschungen beruhen.");
   
   AD(({"erzaehlungen","erzaehlung","geschichte","besiedelungsgeschichte"}),
   "Sie kannst Du ebenfalls in der Stiftsbibliothek nachlesen.");
   
   AD(({"werk","wuerde"}),
   "Ein so bekanntes Buch in Haenden zu halten ist schon etwas Besonderes.");
     
   AD(({"bibliothek","stiftsbibliothek"}),
   "Die Stiftsbibliothek zum heiligen Severin ist die bedeutenste Bibliothek der Welt.");
   
   AD(({"verhetzung","autor","volksverhetzung"}),
   "Der Autor ist niemand geringerer als der oberste Skriptor des Stiftes. Er bestreitet "
   "natuerlich diese Anschuldigungen.");
   
   AD(({"anschuldigung","anschuldigungen"}),
   "Du kannst das Buch ja lesen und ueberpruefen ob die Anschuldigungen stimmen.");

   AD(({"rat","stadtrat","menschen"}),
   "Besonders der Stadtrat von Midas ist mit dem Buch unzufrieden.");
      
   AD(("verbrennung"),
   "Da der Stift recht einflussreich ist konnte er eine Verbrennung bis jetzt verhindern.");
   
   
AddCmd(("lies"), "buch");
}

        
buch(string str) {
	
        notify_fail("Was willst Du lesen?\n");
        
        if(str=="traktat"||str=="traktatus tijarae"||str=="buch") {
        	
        	TP->More(break_string("\n\n"
        	"Prolog\n\n"
        	"Sehr geehrter Leser!\n\n"
        	
        	"oooo  S gibt viele Geschichten und Erzaehlungen ueber\n"
        	"0     geschichtliche Ereignisse, aber nahezu allen ist\n"
        	"oooo  gemein, dass sie vor ihrer Niederschrift ueber lange\n"
        	"0     Zeit lediglich muendlich weiter gegeben wurden, und\n"
        	"oooo  zum Grauen eines jeden Geschichtsgelehrten in jeder \n"
        	"      Erzaehlergeneration mit zusaetzlichen Dichtungen "
        	"geschmueckt und verfaelscht wurden.\n\n"
        	
        	"Der Traktatus Tijarae beruht auf ueberliefertem Briefverkehr, geschichtlichen "
        	"Dokumenten und oft durch Zufall gefundenen, aufschlussreichen Einzelstuecken, "
        	"untermauert von vertrauenswuerdigen Personen.\n"
        	"So sehr die Erzaehlungen zu schaetzen sind, und so aufschlussreich das auch "
        	"immer zu findende Koernchen Wahrheit in jeder Legende ist, so versucht doch "
        	"dieser Traktat die Geschichte Tijaras in ein anderes Licht zu ruecken.\n\n"
        	"Hochachtungsvoll, Benedictus oberster Skriptor zu Severin.\n\n"
        	"Inhalt:\n"
        	"~~~~~~~\n\n"
        	"1. Kapitel Das Land in dem Milch und Honig fliessen\n\n"
        	"2. Kapitel Ein neuer Versuch und der Siedlerbund\n\n"
        	"3. Kapitel Die ersten Jahre der Gruendung\n\n"
        	"4. Kapitel Die Machtverteilung und die Piraterie\n\n"
        	"5. Kapitel Der Siedlerbund zerbricht, das neue \n"
        	"           Gouvernement\n\n"
        	"6. Kapitel Epilog\n\n\n"
        	
        	"(Um die einzelnen Kapitel zu lesen tippe einfach \"lies kapitel [Nr]\" )"
        	"\n\n\n", 70, 8, 1));         
        return 1;}
        
        if(str=="kapitel 1") {
        	
        	TP->More(break_string("\n\n"	   	
        	"         1. Das Land in dem Milch und Honig fliessen\n"
        	"         ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n\n"
                " @@@  chon lange existierten Geruechte wonach ein gesegnetes\n" 
                "@   @ Land, reich an Bodenschaetzen und an, bei der neuen \n"
                " @    Oberschicht von Midas sehr belieben, Gewuerzen mittem im\n"
                "  @   weiten Suedozean liegt. Schon oft haben glaubwuerdige\n"
                "   @  Kapitaene der erfolgreichen Ratsflotte der Stadt Midas\n"
                "    @ von diesem Land berichtet, und so beschloss schliesslich\n"
                "@  @  der Stadtrat eine genauere Erkundung dieses Suedlandes\n"
                " @@   und das Abklaeren der wirtschaftlichen Moeglichkeiten.\n"             
                "      So wurde nach langen Querelen ueber die Finazierung des\n"
                "teuren Unternehmens  schliesslich eine Expedition unter der Leitung des "
                "hoch dekorierten Kapitaens Anderbaker der Ratsflotte zusammengestellt.\n\n"
                "Im Jahre xxxx der Gruendung stach die Expedition mit hohen Erwartungen in See. "
                "Allerdings stellte sich bald heraus das die weite Reise und unbekannten "
                "Bedingungen im neuen Land weit unterschaetzt wurden.\n"
                "Nachdem ein gutes Drittel der Schiffe im unberechenbaren Suedozean versunken "
                "war, landete schliesslich eine zerschlagene und muede Truppe auf dem neuen "
                "Kontinent, weder mit den Gefahren des ueppigen Dschungels, noch mit dem "
                "ungewohnten Klima vertraut. Gleich nach der Landung wurde zwar nach Plan ein "
                "improvisiertes Fort gebaut und ein notduerftiger Hafen errichtet, doch hatte "
                "man weder mit den grossteils feindlichen Einwohnern, noch mit den "
                "erbarmungslosen unbekannten Krankheiten des neuen Kontinentes gerechnet. So "
                "erwies sich der Expeditionsplan der Schreibstuben des Rates von Midas im "
                "heissen Dschungel als vollkommen unbrauchbar.\n"
                "Obwohl Kapitaen Anderbaker noch versuchte die Expedition so geordnet als "
                "moeglich abzuwickeln, grassierte bald die unbekannte Malaria unter den "
                "Flottenmitgliedern, Lebenmittel verdarben mit unglaublicher Geschwindigkeit im "
                "heissen, feuchten Klima, und weder das Land noch das vorgefundene Holz erwiesen "
                "sich als tauglich fuer das im gemaessigtem Klima geplante Fort. So erreichte "
                "eine schlechte Nachricht nach der anderen das Heimatland, und mit Schrecken "
                "sahen die Ratsmitglieder und Handelsfamilien ihre Investition versanden. Nachdem "
                "schliesslich auch noch Kaempfe mit Eingeborenen ausbrachen, nachdem man diese "
                "kurzerhand aus ihren angestammten Fischgruenden vertrieben hatte, erhielt "
                "schliesslich Kapitaen Anderbaker den Befehl das ohnehin beschaemende Fort "
                "aufzugeben und die Reste der Expedition nach Hause zu fuehren.\n"
                "Die nachfolgenden Schuldzuweisungen und Streitereien um das Scheitern der "
                "Expedition endeten schliesslich mit einem heldenhaften Unfall zur See des "
                "einst so geachteten Kapitaens der Ratsflotte.\n\n\n", 70, 8, 1));         
        return 1;}
        
        if(str=="kapitel 2") {
        	
        	TP->More(break_string("\n\n"
        	"        2. Ein neuer Versuch und der Siedlerbund\n"
        	"        ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n\n"
                " @@@  elbst nach der gescheiterten Expedition gaben viele der\n"
                "@   @ reichen Handelsfamilien das neue Land noch nicht\n"
                " @    verloren und wollten einen neuen, besser geplanten\n"
                "  @   Versucht  starten. Nun wollte man allerdings die Kosten\n"
                "   @  und Risiken nicht mehr alleine tragen, sondern beschloss\n"
                "    @ den anderen Voelkern eine gemeinsame Erschliessung und\n"
                "@  @  Nutzung vorzuschlagen, wobei natuerlich das Scheitern\n"
                " @@   der ersten Expedition laechelnd heruntergespielt wurde.\n"
                "      Da vor langer Zeit einst ein Elfenstamm bereits einmal\n"
                "eine Besiedelung gewagt hatte, wobei allerdings der Kontakt zu diesem schnell "
                "verebbte, beschlossen die Elfen schnell an diesem Unternehmen teilzunehmen, "
                "erwartete man doch auch, dass sie sich am besten an die ungewohnte Umgebung "
                "anpassen konnten. Da die Zwerge den Gewinnversprechungen der Menschen schnell "
                "nachgaben, war auch ihre Teilnahme bald beschlossen, erzaehlte man Ihnen doch "
                "begeistert, dass der Fluss in der Naehe des Forts in der Nacht von Goldnuggets "
                "leuchten wuerde. Am meisten verunsichert waren die Hobbits, da man nicht zu "
                "Unrecht vermutete, dass das heisse Klima doch viel mehr Tuecken barg, als die "
                "Menschen zugaben, aber um im Falle eines Erfolges der Expedition nicht mit "
                "leeren Haenden dazustehen, wurde auch die Teilnahme der Hobbits im Rat von "
                "Derlim beschlossen.\n\n"
                "Die neue Expedition war nun erheblich groesser und auch besser mit Nachschub "
                "versorgt als die erste, wobei man die Reste des ersten Forts nutzen konnte. "
                "Ueber die Leitung der Expedition wurde man sich so einige, indem man eine alle "
                "vier Jahre unter den Rassen wechselnde Leitung beschloss, wobei jedes Volk ein "
                "Ratsmitglied bestimmte, dass die Expeditionsleitung unterstuezte.\n"
                "Den ersten Vorsitz uebernahmen die Elfen, da man erwartete, dass sie am besten "
                "mit dem Dschungel umgehen wuerden und ausserdem wuerden sie im Falle eines "
                "neuerlichen Misserfolges den groessten Teil der Schuld tragen muessen. So wurde "
                "die neue Siedlung auch mit dem elfischen Wort Tijara fuer Gemeinsamkeit "
                "getauft.\n\n"
                "Die ersten Jahre der Erschlissung verliefen recht gut, konnte man sich doch "
                "zumindest mit den noch immer verstimmten Eingeborenen versoehnen und ersten "
                "Boden um das gebaute Fort urbar machen. Da sich die mitgebrachten Pflanzen als "
                "vollkommen unbrauchbar erwiesen, erschlossen die pflanzenkundigen Elfen neue "
                "Nutzpflanzen, deren Fruechte auf den Maerkten der Heimat bald ein "
                "Verkaufsschlager wurden. Den Menschen gelang es einen sturmsicheren Hafen zu "
                "errichten, der den Nachschub sicherte.\n"
                "Nur die Zwerge waren mehr als verstimmt, erwies sich doch der Fluss viel aermer "
                "an Gold als von den Menschen behauptet, und die Berge im Inneren des Dschungels "
                "als viel zu unzugaenglich um in ihnen Bergau betreiben zu koennen.\n"
                "So zeichnete sich am Ende der elfischen Expeditionsleitung bereits ein Bruch "
                "zwischen den Menschen und den sich betrogen fuehlenden Zwergen "
                "ab.\n\n\n", 70, 8, 1));         
        return 1;}
        
        if(str=="kapitel 3") {
        	
        	TP->More(break_string("\n\n"
        	"            3. Die ersten Jahre der Gruendung\n"
        	"            ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n\n"
                " GGG  egen Ende ihres Vorsitzes entdeckten die Elfen auch\n"
                "G   G ihren abgespaltenen Stamm wieder, an den eigentlich\n"
                "G  __ niemand so recht geglaubt hatte. In den folgenden Jahren\n"
                "G   G zogen sich die Elfen, vor allem wegen den zunehmenden\n"
                " GGG  Intrigen der Voelker untereinander immer weiter aus der\n"
                "      Leitung Tijaras zurueck. Ihr Interesse konzentrierte sich zunehmend "
                "auf die Siedlung der Dschungelelfen, zu denen sie einen engen Kontakt "
                "pflegten.\n"
                "Den naechsten Vorsitz sollten die Hobbits uebernehmen, um einen offenen "
                "Konflikt zwischen den immer staerker rivalisierenden Menschen und Zwergen zu "
                "vermeiden. Menschen wie Zwerge jedoch unterstuetzen den neuen Vorsitz nur "
                "murrend, und die geheimen Stimmen die eine Katastrophe der neuen "
                "Expeditionsleitung herbeiwuenschten wurden unueberhoerbar.\n"
                "Die ersten Gefahren des Dschungels waren gebannt und die Besiedelung schien "
                "gesichert. Bald nachdem der Druck von aussen schwaecher wurde begann der "
                "Siedlerbund zu broeckeln. Streitereien um die Gewinnbeteiligungen der "
                "Plantagennutzung kamen auf, Scharfmacher forderten ein Ende der gemeinsamen "
                "Nutzung der Fischgruende, und ausserdem kam wieder Unruhe unter den Eingeborenen "
                "auf, nachdem die Siedler nach der militaerischen Absicherung Tijaras mit neuer "
                "Arroganz den Staemmen begegneten.\n"
                "Nachdem ruecksichtlos neues Land von den Eingeborenen genommen wurde, und diese "
                "entgueltig aus ihren angestammten Fischgruenden vertrieben wurden, war ein "
                "bewaffneter Konflikt mit diesen abzusehen.\n"
                "Dieser war auch entgueltig entscheidend fuer die Ruecklegung des Ratssitzes der "
                "Elfen, deren Vermittlungsversuche von allen anderen sapotiert wurden. "
                "Es wurde eine gemeinsame bewaffnete Truppe zusammengestellt, mit dem Ziel die "
                "Eingeborenen entgueltig in das Gebiet jenseits des Rio de la Puseta zu treiben.\n"
                "Diese Truppe wurde dem schwaechelnden Vorsitz der Hobbits unterstellt. Nach "
                "anfaenglichen Erfolgen gegen die bekannten groesseren Doerfer der Staemme "
                "verbuendeten sich die Eingeborenen allerdings unter den Kannibalen, und "
                "verlegten sich zunehmend auf Guerillataktik.Die Verluste des Siedlerbundes "
                "wurden immer groesser und Stimmen des Ruecktrittes des Hobbitvorsitzes wurden "
                "immer lauter. Endlich hatten Quertreiber der Menschen und Zwerge ihren Vorwand "
                "um auch die Hobbits ins Abseits zu draengen, und so traten die Hobbits ihre "
                "Leitung vorzeitig an die Zwerge ab.\n"
                "Insgeheim wurde der Zwergenvorsitz von den Menschen nun nicht mehr abgelehnt, "
                "da die Verantwortung fuer die Probleme der Siedlertruppe nun bei Ihnen lag. "
                "Unter grossen Verlusten gelang es dennoch die Kannibalen hinter den Rio de la "
                "Puseta zurueck zu draengen, und einen Grenzposten an der einzigen Bruecke "
                "einzurichten. Zwar sollte diese Grenze nie ganz sicher sein, und der "
                "Grenzposten mehrmals brennen, aber die Plantagen und die Gebiete suedlich von "
                "Tijara waren somit zumindest halbwegs vor Hinterhalten sicher.\n\n\n", 70, 8, 1));         
        return 1;}
        
        if(str=="kapitel 4") {
        	
        	TP->More(break_string("\n\n"
        	"        4. Die Machtverteilung und die Piraterie\n"
        	"        ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n\n"
                "N  N ach den Stammeskaempfen wurde die junge Siedlung wieder\n"
                "NN N etwas ruhiger und es kamen neuerlich Jahre des Zuzuges\n"
                "N NN von Siedler aus dem alten Kontinent. Die Zwerge gaben\n"
                "N  N nach mehrmaligen Versuchen in grossem Ausmass Bergbau zu\n"
                "     betreiben die Hoffnung auf nennswerte Mengen Gold aus der Kolonie "
                "entgueltig auf. Zwar fand man durchaus Silber und auch Gold, aber der Transport "
                "der Geraete und des Metalles war zu aufwendig, um grosse Mengen abzubauen. "
                "Ausserdem war der Dschungel weiterhin ungezaehmt und beherbergte neben einer "
                "Unzahl von giftigen Schlangen auch andere eigenartige Bewohner wie die "
                "Steingiganten, die einem Bergbau im Wege standen. Von den wenigen "
                "Goldsucherexpeditionen kehrten viele garnicht oder schwer dezimiert zurueck, "
                "wodurch sich die Nutzung des Gebietes bald hauptsaechlich auf das umliegende "
                "Land und die Plantagen konzentrierte. Dadurch wurde natuerlich das Murren der "
                "Zwerge immer lauter, hatten sie doch in der Fischerei und Landwirtschaft das "
                "Nachsehen hinter den anderen Voelkern.\n"
                "Der nachfolgende Ratsvorsitz der Menschen war daher schon zu Beginn von "
                "Unzufriedenheut der Zwerge ueberschattet. Weiters hatten die reichen "
                "Handelsfamilien von Midas rechtzeitig in die Sicherung der Handelsrouten "
                "investiert, und die wirtschaftliche Vorherrschaft in der neuen Kolonie trat "
                "immer deutlicher zu Tage, was auch von Gruppierungen der Menschen, die eine "
                "alleinige Nutzung von Tijara fuer die Menschen wollten staerkte. Noch brauchte "
                "allerdings die junge Kolonie alle Mitglieder des Siedlerbundes, und so wurde er "
                "auch im eigenem Interesse von allen gewahrt.\n"
                "In der neuen Ratsperiode verzichteten die Elfen fuer immer auf ihr "
                "Vorsitzrecht, fuer die Zusage freier Siedlungsmoeglichkeit und Steuerbefreiung "
                "gegenueber des jeweiligen Rates, was von den anderen Voelkern begruesst wurde. "
                "Also fiel der Vorsitz abermals an die Hobbits.\n"
                "Die Hobbits waren in ihren Ratsvorsitzen stets auf Ausgleich zwischen den "
                "Voelkern bedacht, da ihnen die gemeinsame Nutzung am wichtigsten schien. Doch "
                "Zwerge und Menschen machten ihnen ihren Vorsitz stets schwer. Dazu kam, dass das "
                "heisse und feuchte Klima nicht gerade angenehm fuer die stark behaarten Hobbits "
                "war, wodurch hauptsaechlich aermere Hobbits, die in der neuen Welt ihr Glueck "
                "versuchen wollten sich in Tijara ansiedelten, die wohlhabenderen, "
                "Familien Derlims allerdings ausblieben, was die Position der Hobbits zusaetzlich "
                "schwaechte.\n"
                "Weiters begann in der zweiten Ratsperiode der Hobbits die Piraterie ueberhand zu "
                "nehmen.\n"
                "Immer oefter wurden Handelsschiffe, die die kostbaren Gueter in die alte Heimat "
                "lieferten aufgebracht und gepluendert. Ihren Hoehepunkt erreichte die Piraterie "
                "im dritten Jahr der zweiten Ratsperiode der Hobbits, wo sich die Gesetzlosen um "
                "einen Piraten namens Robert de Bruce scharten.\n"
                "Robert de Bruce war ein ehemaliger Flottenoffizier der Ratsflotte von Midas der "
                "unehrenhaft aus dem Dienst entlassen wurde und der seine Chance in Tijara, weit "
                "weg vom starken Arm des Gesetzes kommen sah. Gezielt zog er dunkle Elemente und "
                "Gluecksritter, welche im Hafenviertel von Tijara landeten auf seine Seite und "
                "stellte bald eine gefaehrliche Piratenorganisation auf die Beine, die auch "
                "durch Bestechung und Erpressung von Ratsbeamten an Einfluss in Tijara zu "
                "gewinnen drohte.\n"
       /*         "Die Zustaende wurden immer unhaltbarer und der Druck vor allem der reichen "
                "Handelsfamilien aus Midas nahm zu. Die Hobbits, als nicht gerade besonders "
                "seetuechtiges Volk, wurden der Situation immer weniger Herr, und so traten sie "
                "abermals vorzeitig ihren Ratsvorsitz ab, diesmal aber nicht an die Zwerge, "
                "sondern an die Menschen, denen man die Bezwingung der Piraten noch am ehesten "
                "zutraute.\n"*/
                "Unerklaerlicherweise verschwand Robert de Bruce schlagartig von der Bildflaeche "
                "kurz nachdem die Menschen den Vorsitz uebernommen hatten, was zu vielen "
                "Geruechten ueber eine heimliche Unterstuetzung der Piraten zur Schwaechung der "
                "Hobbits fuehrte, was die Menschen allerdings immer vehement bestritten. "
                "Trotzdem wurden die Piraten kurz nachdem ihr Anfuehrer verschwand aufgebracht "
                "und ihr Flaggschiff die Seeschlange versenkt.\n\n\n", 70, 8, 1));         
        return 1;}
        
        if(str=="kapitel 5") {
        	
        	TP->More(break_string("\n\n"
                "     5. Der Siedlerbund zerbricht, das neue Gouvernement\n"
                "     ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n\n"
                "DDDD  er neuerliche, unruehmliche, vorzeitige Ruecktritt der\n"
                " D  D Hobbits blieb nicht ohne Folgen in Derlim. Eine heftige\n"
                " D  D Debatte ueber gemachte Fehler entstand. Weiters brach\n"
                "DDDD  noch in den Jahren des zweiten menschlichen Vorsitzes\n"
                "      die verheerende Zwergenpest in Tijara aus, die den Siedlerbund "
                "entgueltig zerbrechen sollte.\n"
                "Im dritten Jahr des menschlichen Vorsitzes brach im Handwerkerviertel in Tijara "
                "eine schreckliche Seuche aus, die nahezu ausschliesslich Zwerge dahinraffte. Mit "
                "rasender Geschwindigkeit ging der schwarze Tod von Schmiede zu Schmiede und "
                "forderte seine Opfer. Kaum ein erkrankter Zwerg kam lebend davon, und vor der "
                "Stadt stapelten sich die Scheiterhaufen mit den brennenden Leichen. Viele Zwerge "
                "gingen daraufhin wieder zurueck in ihre kalte, bergige Heimat. Die "
                "Krankenversorgung funktionierte nicht und durch die Strassen wehte der "
                "Leichengestank.\n\n"
                "Unter diesen Umstaenden war der Siedlerbund entgueltig ausgelaufen.\n\n"
                "Nachdem die Elfen ohnehin schon laenger aus dem Bund ausgetreten waren, wollten "
                "nun auch Hobbits und Zwerge Verhandlungen ueber eine neue Regelung. "
                "Nach dem Fiasko der zweiten Ratsperiode der Hobbits verloren diese bei den "
                "anderen Voelkern zu sehr an Glaubwuerdigkeit, waehrend die Zwerge die "
                "Enttaeuschung des Bergbaues und die Zwergenpest nicht ueberwanden.\n\n"
                "So einigte man sich nach oft laut gefuehrten Verhandlungen auf folgende "
                "Punkte:\n\n"
                "1. Die Ratsleitung geht permanent auf die Menschen ueber, welche die neue "
                "Siedlung als Gouvernement fuehren, mit einem Gouverneur mit allen Vollmachten "
                "der Stadt Midas.\n\n"
                "2. Das Gouvernement respektiert die Rechte der anderen Voelker auf:\n"
                "   Steuerbefreiung von Steuern die nicht der Stadt Tijara zu\n" 
                "   gute kommen.\n\n"     
                "   Freien Zuzug und Ansiedelungsmoeglichkeit zur Stadt Tijara.\n\n"
                "   Freie wirtschaftliche Nutzung der eigenen Unternehmen und\n"
                "   Handelswege.\n\n"
                "   Der Rat bleibt mit beratender Funktion bestehen\n"
                "   und hat bei Gerichtsurteilen und wichtigen Entscheidungen \n"
                "   die alle Voelker betreffen ein Vetorecht.\n\n"
                "3. Beim Abtritt des Gouverneurs wird dieser allein vom Rat in Midas "
                "nachbesetzt.\n\n\n"
                "Nachdem entgueltig die Streitereien um die Vorherrschaft in Tijara geregelt "
                "waren, kehrte eine schon ungewohnte Ruhe zwischen den vielen Voelkern ein, die "
                "sich in Tijara ansiedelten. Das Gouvernement verfolgte eine ausgeglichene "
                "Politik und versuchte die Interessen der Voelker zu wahren, in dem Wissen das "
                "innere Ruhe das Wichtigste fuer das Gouvernement ist, und das Tijara durch das "
                "enge Zusammenleben der Rassen eine immer wichtigere Rolle im Verhaeltnis der "
                "Voelker untereinander zu spielen beginnt.\n"
                "So findet man in der bunten Stadt Tijara noch immer Vertreter aller Voelker in "
                "den Hafenvierteln und Stadtkneipen, und nicht nur Zwerge, Hobbits, Elfen und "
                "Menschen fuellen die Strassen, sondern auch wenige Orks wurden in "
                "Tijara sesshaft.\n"
                "Bald wurde die alte Stadtgrenze gesprengt, und eine ueppig wuchernde Vorstadt "
                "waechst heran, in der sich Gluecksritter und Abenteuerer, aber auch Handwerker "
                "und reiche Unternehmer nieder lassen.\n\n\n", 70, 8, 1));         
        return 1;}
        
