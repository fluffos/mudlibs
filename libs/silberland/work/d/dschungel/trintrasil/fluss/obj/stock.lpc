
inherit "std/weapon";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"stock"}));
   SetProp(P_NAME, "Stock");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Stock" );
   SetProp(P_LONG, BS(
   "Der leicht gebogene Ast ist ca 1 meter lang. Vielleicht kannst Du ihn "
   "einmal brauchen."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,5 );
}

