inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <ansi.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


string ort, adj;

   
create()
{
   
   if (!is_clone(this_object())) return;
   
   ::create();
   
   
   call_out("eier_func", 5+random(10));
   
   
   switch (random(10)) {
   	
     case 0 : ort= "Gesicht"; break;
     case 1 : ort= "Mittelohr"; break;
     case 2 : ort= "Schienbein"; break;
     case 3 : ort= "Nasenbein"; break;
     case 4 : ort= "Kniegelenk"; break;
     case 5 : ort= "Schulterblatt"; break;
     case 6 : ort= "Augenlied"; break;
     case 7 : ort= "Ohrlaeppchen"; break;
     case 8 : ort= "Rediculum"; break;
     case 9 : ort= "Nagelbett"; break;
     default: ort= "Nagelbett"; 
}

   switch (random(5)) {
   	
   	case 0 : adj= "linke"; break;
   	case 1 : adj= "rechte"; break;
   	case 2 : adj= "mittlere"; break;
   	case 3 : adj= "obere"; break;
   	case 4 : adj= "liebste"; break;
      	default: adj= "mittlere";
}
   	
      
      
   AddId(({"eier","gelege"}));
   SetProp(P_NAME, "Gelege");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT,""+ANSI_GREEN+"Ein Moskitogelege"+ANSI_NORMAL+"");
   SetProp(P_LONG, BS("Ein Moskito hat Dir seine Eier in Dein "+adj+"s "+ort+" "
                      "gelegt. Du solltest sie schnellstens entfernen bevor "
                      "sich das Fleisch entzuendet!!!"));
   
       
   SetProp(P_NODROP, BS("So einfach wirst Du das Gelege nicht los! Versuche es einmal mit einem "
   "Messer aufzustechen."));   
   SetProp(P_NOSELL, BS("Sehr witzig, aber so einfach wirst Du das Gelege nicht los! Versuche "
   "es mit einem Messer aufzustechen."));
   SetProp(P_MATERIAL,MAT_FLESH);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,0);

   AD(("fleisch"),
     "Der Einstich ist bereist zu einer grossen, gruenen Beule "
     "aufgeschwollen.");
    
   AD(({"einstich","stich","beule"}),
     "Du musst die Beule mit einem Messer aufstechen und das Gelege "
     "ausdruecken. Sonst schluepfen die Maden und ernaehren sich von Deinem "
     "Fleisch."); 
   
   AD(({"eier","maden"}),
     "Hat sich in der Beule bereits etwas bewegt?!?");
     
   AD(("etwas"),
     "Du musst das Gelege entfernen bevor die Maden schluepfen.");
     
   AD(("brennen"),
     "Dir wirst die Beule leider mit einem Messer aufstechen muessen, auch wenn "
     "es schmerzhaft sein wird.");
     
   AD(("messer"),
     "Steche Beule mit Messer auf.");
     
   AD(({""+adj+"s "+ort+"",""+ort+""}),
     "Es ist total verschwollen. Hat sich da nicht gerade etwas in Deinem "
     ""+adj+"n "+ort+" bewegt??");
     
   AddCmd(({"stich","oeffne","steche"}), "remove_func");
   AddCmd(("entferne"), "sonicht");
   AddCmd(({"druecke","drueck"}), "auchfalsch");
}


sonicht(string str) {
	
	if(str=="beule"||str=="einstich"||str=="gelege"||str=="moskitogelege"||str=="eier") {
		
		write(BSL("\nSo einfach geht das nicht. Du musst die Beule mit einem "
		"Messer aufstechen."));
		return 1;
	}
}


auchfalsch(string str) {
	
	if(str=="beule"||str=="beule auf"||str=="beule aus"||str=="einstich"||
	str=="einstich auf"||str=="einstich aus"||str=="gelege"||str=="gelege auf"||
	str=="gelege aus"||str=="moskitogelege"||str=="moskitogelege auf"||
	str=="moskitogelege aus"||str=="eier"||str=="eier auf"||str=="eier aus") {
		
		write(BSL("\nSo geht das nicht. Du musst das Gelege mit einem "
		"Messer aufstechen."));
		return 1;
	}
}


eier_func() {
	
	if( interactive(ENV(TO)) ) {
 		
 		write(BSL("\nDu spuerst ein Brennen in Deinem "+adj+"n "+ort+". "
 		"Ein Moskito hat darin seine Eier abgelegt. Du solltest das "
 		"Gelege schnellstens entfernen!!"));
                TP->do_damage(3+random(8));
                call_out("eier_func", 15+random(25));
        }
        if( !interactive(ENV(TO)) ) {
        	TO->remove();
        }
}

        
remove_func(string str) {
	
	object gelege;
	gelege=(present("gelege", TP));
	
	notify_fail("Was willst Du aufstechen?\n");
	
	if(str=="beule"||str=="beule aus"||str=="beule auf"||
	str=="beule mit messer auf"||str=="gelege"||str=="gelege aus"||
	str=="gelege auf"||str=="gelege mit messer auf"||str=="einstich"||
	str=="einstich aus"||str=="einstich auf"||str=="einstich mit messer auf") {
		
		if(present("messer", TP)) {
			
			write(BSL("\nVorsichtig stichst Du mit dem Messer den prall "
			"verschwollenen Einstich auf. Angeekelt drueckst Du das "
			"Gelege aus."));
			TP->do_damage(3+random(5));
			TO->remove();
			return 1;
		}
		
		if(!present("messer", TP)) {
			
			write(BSL("\nDu hast kein Messer mit dem Du das Gelege entfernen "
			"koenntest!"));
			return 1;
		}
		return 0;
	}
	return 0;
}