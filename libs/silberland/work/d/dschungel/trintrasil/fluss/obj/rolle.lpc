inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId(({"rolle","lederrolle"}));
   SetProp(P_NAME, "Rolle");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein kleine Lederrolle" );
   SetProp(P_LONG, BS(
   "Das Leder ist ganz klein zusammengerollt und sieht verwittert und "
   "verfallen aus. Es ist mit eigenartigen Buchstaben beschrieben die Du gerade "
   "noch lesen koenntest."));   

   SetProp(P_MATERIAL,MAT_LEATHER);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,4);
   
   AD(("leder"),
     "Das Leder ist verwittert und verwaschen als ob es lange im Wasser "
     "gelaegen haette.");
     
   AD(("buchstaben"),
     "Die Buchstaben sind zittrig und kaum zu lesen. Ausserdem sehen sie eher "
     "in das Leder geaetzt als geschrieben aus.");

     
AddCmd(("lies"), "rolle");
}

        
rolle(string str) {
	
        notify_fail("Was willst Du lesen?\n");
        
        if(str=="schriftrolle"||str=="rolle"||str=="buchstaben"||
           str=="lederrolle"||str=="schrift") {

        TP->More(break_string("\n\n"	   	
        "Meine Verwundungen sind schwer, darum beschreibe ich die Lage "
        "des vergrabenen Goldes, sollten meine treuen Kameraden diesen "
        "ungluecklichen Schaedel finden.\n"
        "Mit meinem guten Freund und langjaehrgen Begleiter Charles le Sabre "
        "machte ich mich auf, das Gold das wir den gottverfluchten neuen "
        "Siedlern beim Ueberfall auf Ihre Schiffe abgenommen hatten, zu "
        "verstecken.\n\n"
        "Kein Ort schien uns geeigneter als die weitlaeufigen Hoehlen "
        "tief im Gestein dieser Schlucht. Wir fanden eine Hoehle mit sandigem "
        "Boden und vergruben die schwere Kiste. Nachdem wir die Arbeit beendet "
        "hatten, und guten Mutes den Rueckweg antreten wollten, fiel ploetzlich "
        "eine fuerchterliche Hydra ueber uns her.\n\n"        
        "Entsetzlich heulend fetzte das gewaltige Vieh meinem unersetzlichen "
        "Freund, Gott erbarme sich seiner treuen Seele, den Schaedel ab noch "
        "bevor wir vollends gewahr wurden was ueberhaupt geschah. Durch Glueck "
        "konnte ich dieser Satansbrut entkommen, doch auch meine Verletzungen "
        "sind schwer und ich merke wie es mit mir zu Ende geht.\n\n"
        "Moegen die uebrigen Piraten diese Rolle finden und unseren Tod raechen "
        "und die schwarze Seele dieser Kreatur zur Hoelle jagen.\n\n"
        "Alles Gute weiterhin meiner zur See gefuerchteten Besatzung der "
        "Seeschlange. Auf das die elenden Schiffe des Gouvernement "
        "brennen.\n\n\n"        
        "Euer ehemaliger Kapitaen    ROBERT de BRUCE\n\n\n", 68, 10, 1));         
        return 1;}
return 0;}
