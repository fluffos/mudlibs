inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"anker"}));
   SetProp(P_SHORT,"Ein rostiger Anker");
   SetProp(P_LONG, BS("Der kleine Anker ist schon etwas rostig. An seinem "
                      "Schaft befindet sich ein Ring an dem Du noch ein "
                      "Seil festbinden musst, dann koenntest Du den Anker "
                      "auswerfen."));
   SetProp(P_NAME, "Anker");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_IRON);
   SetProp(P_VALUE,400);
   SetProp(P_WEIGHT,50);

   
   AD(({"schaft","ankerschaft"}),
     "Landratten wuerden zum Ankerschaft auch Stiel sagen.");
   AD(({"stiel","ankerstiel"}),
     "Da der Anker klein ist, ist der Schaft nur 30 cm lang.");
   ASD(("seil"),
     "seil");

   ASD(({"ankerring","ring"}),
     "ring");

   AddCmd(({"befestige","binde"}), "func_befestigen");
   AddCmd(("loese"), "func_losbinden");
   

}


 _query_long() {
 	
  if(!TO->QueryProp("ankerseil")) {
    return(BS("Der kleine Anker ist schon etwas rostig. An seinem Schaft "
              "befindet sich ein Ring an dem Du noch ein Seil festbinden musst, "
              "dann koenntest Du den Anker verwenden."));
              }
  
  if((TO->QueryProp("ankerseil"))&&(!TO->QueryProp("kletterhaken"))) {
    return(BS("Der kleine Anker ist schon etwas rostig. An seinem Schaft "
              "befindet sich ein Ring an dem ein Seil festgebunden ist. Du kannst "
              "den Anker schon verwenden."));	
              }
            
  if((TO->QueryProp("kletterhaken"))&&(TO->QueryProp("ankerseil"))) {
    return(BS("Der kleine Anker ist zwischen den Steinen verhakt. An ihm ist "
              "ein Seil festgebunden, dass vom Felsturm haengt an dem Du wieder "
              "hinunterklettern kannst."));
              }  
            }
          

int func_befestigen(string str) {
	
	object seil;
	seil=present("seil", TP);
	
	if(str=="seil am anker"||str=="seil an anker"||str=="seil an anker fest"||
	str=="seil am anker fest"||str=="seil am anker an"||str=="seil an anker an") {
		
		if((present("seil", TP))&&(!TO->QueryProp("ankerseil"))) {
			
			write(BS("Du bindest das Seil am Ankerring fest. Du kannst den "
			"Anker nun verwenden."));
			TO->SetProp("ankerseil", 1);
			seil->remove("seil");
			say(BS(""+TPN+" bindet ein Seil an einem Anker fest."));  
			return 1;
		}
		
		if((present("seil", TP))&&(TO->QueryProp("ankerseil"))) {
			
			write(BS("An diesem Anker ist schon ein Seil angebunden."));
			return 1;
		}
		
		if(!present("seil", TP)) {
			
			write(BS("Du hast doch gar kein Seil."));
			return 1;
		}
		return 0;
	}
	return 0;
}
   

int func_losbinden(string str) {
 
  object seil;
  object anker;
  anker=present("anker", TP);
  
   notify_fail("Was willst Du loesen?\n");
   
   if(str=="seil vom anker"||str=="seil von anker"||str=="seil von anker los"||
      str=="seil vom anker los"||str=="seil") {
    
     if((anker)&&(TO->QueryProp("ankerseil"))) {
       write(BS("Du loest das Seil vom Ankerring und steckst es wieder ein."));   
       seil=CLONEOB("/obj/seil");
       seil->move(TP, M_NOCHECK);
       TO->SetProp("ankerseil", 0);
       say(BS(""+TPN+" loest ein Seil von seinem Anker und steckt es ein.")); 
        return 1;}
        
     if((anker)&&(!TO->QueryProp("ankerseil"))) {
       write(BS("An diesem Anker ist doch gar kein Seil befestigt."));
        return 1;}
        
     if(!anker) {
       write(BS("Du hast ueberhaupt keinen Anker."));
        return 1;}
       
       return 0;}
     return 0;}
     
     

seil() {
  if(TO->QueryProp("ankerseil")) {
    return BS("Ein ganz normales Seil ist am Anker festgebunden. Du kannst "
              "es auch wieder losbinden [loese Seil vom Anker]");
            }
  if(!TO->QueryProp("ankerseil")) {
    return BS("Der Anker ist ohne Seil unbrauchbar. Willst Du ihn fuer "
              "irgendetwas verwenden, binde ein Seil am Anker fest.");
            }
         }


ring() {
	if(!TO->QueryProp("ankerseil")) {
		return BS("Um den Anker verwenden zu koennen musst Du erst "
		"ein Seil am Anker befestigen.");
	}
	
	if(TO->QueryProp("ankerseil")) {
		return BS("Am ankerring ist ein Seil befestigt, Du koenntest "
		"den Anker schon verwenden, fuer was auch immer Du willst. Oder "
		"Du loest das Seil wieder.");
	}
}
    