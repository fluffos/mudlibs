inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <ansi.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


   string ort;
   
 
create()
{

   
   if (!is_clone(this_object())) return;
   
   ::create();
   
   
   call_out("egel_func", 3+random(5));
   
   
   switch (random(9)) {
   	
     case 0 : ort= "Gesicht"; break;
     case 1 : ort= "Ohr"; break;
     case 2 : ort= "linken Auge"; break;
     case 3 : ort= "linken Bein"; break;
     case 4 : ort= "rechten Bein"; break;
     case 5 : ort= "linken Knie"; break;
     case 6 : ort= "rechten Knie"; break;
     case 7 : ort= "linken Fuss"; break;
     case 8 : ort= "rechten Fuss"; break; 
     default: ort= "linken Bein";
    }

      
      
   AddId(({"egel","blutegel"}));
   SetProp(P_NAME, "Blutegel");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT,""+ANSI_RED+"Eine Blutegel"+ANSI_NORMAL+"");
   SetProp(P_LONG, BS("Der daumengrosse, glitschige Blutegel hat sich am "
                      ""+ort+" festgesaugt. Du solltest ihn vorsichtig "
                      "abloesen bevor er sich noch fester verbeisst."));
   
       
   SetProp(P_NODROP, "Du musst den Blutegel abloesen um ihn los zu werden.\n");   
   SetProp(P_MATERIAL,MAT_FLESH);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,0);

   AddCmd(({"suche","suche","schaue","sehe"}), 
            "egel1_func");
   AddCmd(({"loese","reisse","entferne"}), "remove_func");
}


 egel_func() {
 	
 	if( interactive(ENV(TO)) ) {
 		Z1	
 		write(BS("Du spuerst einen kleinen Biss! Du solltest nachsehen. "
 		"Es scheint sich wo ein Blutegel an Dir festgesaugt zu haben."));
 		TP->do_damage(2+random(3));
 		call_out("egel_func", 5+random(8));
 	}
 	if( !interactive(ENV(TO)) ) {
 		TO->remove();
 	}
}


int  remove_func(string str) {

  object egel;
  egel=(present("egel", TP));

  notify_fail("Was willst Du entfernen?\n");
    
    if(str=="egel"||str=="blutegel"||str=="egel ab"||str=="blutegel ab") {
    	  
    Z1	
    write(BS("Du packst den Blutegel fest und drehst ihn vorsichtig heraus. "
             "Angewiedert wirfst Du den glitschigen Egel weg."));
    egel->remove();	
  return 1;}
return 0;}
 
 
  int egel1_func(string str) {
  	
  if(str=="egel"||str=="blutegel"||str=="nach egel"||str=="nach blutegel") {
    
    Z1	
    write(BS("Tatsaechlich hat sich an Deinem "+ort+" ein daumengrosser "
             "Blutegel festgesaugt. Du solltest ihn gleich vorsichtig "
             "abloesen."));
           return 1;}
        return 0;}
        
        