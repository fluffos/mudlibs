
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"kristall","stein","elementkristall"}));
   SetProp(P_NAME, "Elementarkristall");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Elementarkristall" );
   SetProp(P_LONG, BS(
   "Dieser Stein hat einen Spieler erschlagen, der wohl zu unvorsichtig war."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_STONE);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,10);

AddCmd("test", "test");
  AddCmd("eis", "eis");
  AddCmd("feuer", "feuer");
  AddCmd("erz", "erz");
  AddCmd("dri","dri");
  AddCmd("was","was");
AddCmd("humus", "humus");
AddCmd("untot", "untot");
AddCmd("vogel", "vogel");
}


was() {
	object elementar;
	elementar=clone_object("/d/dschungel/trintrasil/fluss/npc/testwasser.lpc");
		
	elementar;
	this_player()->AddPursuer(elementar);
	elementar->move(ENV(TP), M_GO);
	
	tell_room(TO, "\nCLONED WASI\n\n");
	return 1;
}


