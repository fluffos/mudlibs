
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"nugget","goldnugget"}));
   SetProp(P_NAME, "Goldnugget");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Goldnugget" );
   SetProp(P_LONG, BS(
   "Das Nugget ist aus Gold reinster Qualitaet. Wenn Du mehr davon finden "
   "wuerdest waerst Du reich und haettest ausgesorgt."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_GOLD);
   SetProp(P_VALUE,300+random(700));
   SetProp(P_WEIGHT,5+random(10) );
}
