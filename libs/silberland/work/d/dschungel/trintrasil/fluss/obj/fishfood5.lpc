inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 

::create();

 SetProp(P_SHORT, "Smaragdzaehre");
 SetProp(P_LONG, "Die kleine Smaradzaehre leuchtet auch tot noch sehr hell. Die Zaehre ist "
 "ein gruener, zierlicher Fisch. Man sagt ihr magische Kraefte nach. Sie scheint etwas "
 "besonderes zu sein.");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_VALUE, 1000+random(200));
 AddId(({"zaehre","smaragdzaehre","fisch"}));
 SetProp(P_NAME, "Smaragdzaehre");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);

 SetProp(P_FOOD_INFO, ([F_HEAL : ({1,1}), 
 F_SOAK : 1,
 F_MSG:"Melde bitte Trintrasil, dass mit der Smaragdzaehre etwas nicht stimmt.\n",
 F_MSG_ROOM:"isst eine rohe Flussgrundel."]));
 SetProp(P_SMELL, "Die Smaragdzaehre riecht ueberhaupt nicht typisch nach "
 "Fisch. Sie scheint auch nicht zu verderben.\n");
 
 AD(({"kraft","kraefte"}),
 "Seltsamerweise scheint der Fisch nicht zu verderben. Er riecht fuer einen Fisch "
 "eigenartig saeuerlich. Vielleicht sind die Kraefte aber auch nur Aberglaube der vom "
 "Leuchten der Fisches her kommt.");
 
 AD(({"glaube","aberglaube"}),
 "Vielleicht haben die Fischhaendler diesen Aberglaube erfunden um den Fisch teurer verkaufen "
 "zu koennen.");
 
 AD(({"haendler","fischhaendler"}),
 "Dieser Fisch ist bei den Haendlern verbrecherisch teuer.");
 
 AD(({"leuchten","licht","schuppen"}),
 "Die Schuppen leuchten auffaellig hell, angeblich sogar im Dunklen.");

 AD(({"dunkel","dunklen"}),
 "Naja, es kann auch sein das die Schuppen das Licht einfach nur stark reflektieren.");
}