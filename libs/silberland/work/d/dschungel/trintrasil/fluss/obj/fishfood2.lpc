inherit "std/food";

#include <moving.h>
#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 

call_out("destruct_func", 15000+random(1000));

::create();

 SetProp(P_SHORT, "Petermaennchen");
 SetProp(P_LONG, "Das rohe Fleisch des Petermaennchen sieht nicht sehr "
 "appetitlich aus, aber vielleicht schmeckt es ja garnicht schlecht.");
 SetProp(P_GENDER, MALE);
 AddId(({"petermaennchen","fisch"}));
 SetProp(P_NAME, "Petermaennchen");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);
 SetProp(P_INFO, BS("Du solltest das Petermaennchen lieber nicht essen. Es ist angeblich "
 "giftig."));

 SetProp(P_FOOD_INFO, ([F_HEAL : ({1,1}), 
 F_SOAK : 1,
 F_MSG:"Melde bitte Trintrasil, dass mit dem Petermaennchen etwas nicht stimmt", 
 F_MSG_ROOM:"isst das rohe Fleisch eines Petermaennchens und haelt sich "
 "ploetzlich stoehnend den Bauch.\n"]));
 SetProp(P_SMELL, "Das Petermaennchen riecht irgendwie komisch. Vielleicht "
 "solltest Du es genauer untersuchen bevor Du es ist.\n");

 AD(({"fleisch"}),
   "Das Fleisch des Petermaennchens hat einen eigenartigen grauen Schimmer.");
   
 AD(("schimmer"),
   "Etwas verdaechtig sieht der graue Schimmer schon aus, aber das muss ja "
   "nicht heissen das der Fisch schlecht schmeckt.");
}


destruct_func() {
	
object graete;
        
        graete=CLONEOB("/d/dschungel/trintrasil/fluss/obj/graete");
        graete->SetProp(P_LONG,"Die Graeten eines Petermaennchens");
        graete->move(ENV(TO), M_GO+ M_SILENT);
        TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
	M_SILENT);
        TO->remove();
}
	