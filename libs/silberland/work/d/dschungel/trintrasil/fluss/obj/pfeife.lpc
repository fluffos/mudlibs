
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"pfeife","fischpfeife"}));
   SetProp(P_NAME, "Fischpfeife");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT,"Eine kleine Pfeife");
   SetProp(P_LONG, BS("Mit dieser kleinen Fischpfeife kannst Du Fische "
                      "rufen."));
   SetProp(P_INFO, BS("Um einen Fisch an zu locken, musst Du am Ufer des Rio de la Puseta "
   "stehen, und mit dieser Pfeife pfeifen. syntax: pfeife mit pfeife."));
      
   AD(({"pfeife","fischpfeife"}),
     "Die zierliche kleine Pfeife ist aus Graetenholz geschnitzt.");
   
   AD(({"holz","graetenholz"}),
     "Aus dem Holz des Graetenbusches kann man diese kleinen Pfeifen schnitzen "
     "mit denen man eine Frequenz erreichen kann die manche Fischarten "
     "unwiederstehlich anlockt.");
   
   AD(({"graetenbusch","busch"}),
     "Dieser tropische Busch waechst bevorzugt im Flussgebiet des Rio de la "
     "Puseta.");

   AD(({"flussgebiet","fluss","gebiet","rio","rio de la Puseta"}),
     "Den ´Rio de la Puseta´ kennst Du sicher?");
     
   AD(({"ohr","ohren","frequenz","ton"}),
     "Die Frequenz ist so tief das sie fuer Deine Ohren nicht wahrnehmbar ist.");
     
   AD(({"fische","fischarten","arten","art"}),
     "Manche grosse Fischarten werden von dem Ton dieser Pfeife angelockt.");
   
   AD(({"locken","anlocken"}),
   "Pfeife am Rio de la Puseta mit der Pfeife.");
   
       
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_VALUE,400);
   SetProp(P_WEIGHT,10);
}

