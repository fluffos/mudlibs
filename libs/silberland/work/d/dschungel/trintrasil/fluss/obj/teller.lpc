
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

string eater;
string ausgabe;

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"teller","eisteller"}));
   SetProp(P_NAME, "Eisteller");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Eisteller" );
   
   SetProp(P_MATERIAL,MAT_CERAMIC);
   SetProp(P_VALUE,300+random(700));
   SetProp(P_WEIGHT,5+random(10) );
}

set_eater(string subj) {
	
	eater=subj;
	ausgabe=BS("Auf diesem Teller sind noch Spuren von geschmolzenem Vanilleeis. Er "
	"wurde von "+eater+" abgeschleckt.");
}

_query_long()  {
	
	return ausgabe;
}
