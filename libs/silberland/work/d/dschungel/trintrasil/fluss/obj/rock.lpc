//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"stein","felsen","brocken","felsbrocken"}));
   SetProp(P_NAME, "Stein");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein gewaltiggrosser Stein" );
   SetProp(P_LONG, BS(
   "Dieser Stein hat einen Spieler erschlagen, der wohl zu unvorsichtig war."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_STONE);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,1000000000000000000000000000000000000000000000);
}
