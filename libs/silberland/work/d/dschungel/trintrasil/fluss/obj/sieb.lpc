
inherit "std/weapon";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"sieb","goldsieb"}));
   SetProp(P_NAME, "Goldsieb");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Goldsieb" );
   SetProp(P_LONG, BS(
   "Das Sieb besteht aus einem schon ziemlich verwitterten Holzrahmen in dem "
   "ein schon rostiges Metallgitter befestigt wurde. Es wird von Goldsuchern "
   "verwendet um damit in Fluessen nach Gold zu sieben."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL, ([MAT_IRON: 20, MAT_WOOD: 80]));
   SetProp(P_VALUE, 30);
   SetProp(P_WEIGHT,250);
}
