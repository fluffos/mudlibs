
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Schnabeltierei");
 SetProp(P_LONG, BS("Die weissen Eier sind nur ca 1,7 cm gross. Sie sind "
                    "sicher recht nahrhaft."));
 SetProp(P_GENDER, NEUTER);
 SetProp(P_WEIGHT, 5);
 SetProp(P_VALUE, 100);
 AddId(({"schnabeltierei", "ei"}));
 SetProp(P_NAME, "Schnabeltierei");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);

 SetProp(P_FOOD_INFO, ([F_HEAL : ({5, 5}), F_SOAK : 1,
	F_MSG:"Du schiebst Dir das rohe Ei in den Mund und wirst etwas "
	"bleich.\n",
	F_MSG_ROOM:"isst ein winziges, rohes Schnabeltierei.\n"]));
}

