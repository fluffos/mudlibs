inherit "std/food";

#include <moving.h>
#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 

call_out("destruct_func", 15000+random(1000));//haltbarkeit der fisches

::create();

 SetProp(P_SHORT, "Flussgrundel");
 SetProp(P_LONG, "Die Flussgrundel ist nur ein kleiner Speisefisch und "
 "ausserdem ist der Fisch roh. Aber sie ist besser als nichts wenn Du "
 "Hunger hast.");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_VALUE, 50+random(30));
 AddId(({"grundel","flussgrundel","fisch"}));
 SetProp(P_NAME, "Flussgrundel");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);

/* SetProp(P_FOOD_INFO, ([F_HEAL : ({1,1}), 
 F_SOAK : 1,
 F_MSG:"Vorsichtig nimmst Du die Flussgrundel aus und isst ihr zartes, rohes "
 "Fleisch.", F_MSG_ROOM:"isst eine rohe Flussgrundel."]));*/
 SetProp(P_SMELL, "Du solltest Die Flussgrundel essen bevor sie "
 "verdirbt.\n");

 AD(({"speisefisch","speise"}),
   "Die Flussgrundel ist ein kleiner Speisefisch der nicht besonders viel "
   "ausgibt. Dennoch ist sie gut wenn Du Hunger hast.");
   
 AD(("hunger"),
   "Wenn Du sie jetzt nicht essen willst dann heb sie eben auf. Sie wird wohl "
   "noch laenger halten.");
}


destruct_func() {
	
object graete;
        
        graete=CLONEOB("/d/dschungel/trintrasil/fluss/obj/graete");
        graete->SetProp(P_LONG,"Die Graeten einer Flussgrundel");
        graete->move(ENV(TO), M_GO+ M_SILENT);
        TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
	M_SILENT);
        TO->remove();
}
