inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"graeten","fischgraeten","skelett","fischskelett","graete","fischgraete"}));
   SetProp(P_NAME, "Fischskelett");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Fischskelett");
   SetProp(P_MATERIAL,MAT_BONE);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,100+random(100) );
}
