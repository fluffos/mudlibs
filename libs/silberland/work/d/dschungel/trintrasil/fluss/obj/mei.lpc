//fertig und getestet

inherit "std/food";
#include <properties.h>
#include <food.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


create()
{
	
 if (!is_clone(this_object())) return; 

::create();


      switch(random(4)) {

      	case 1 : SetProp("nichtgebruetet", 1);
               break;
               
      	case 2 : SetProp("halbgebruetet", 1);
               break;
      	
      	case 3 : SetProp("fastausgebruetet", 1);
               break;
      	
      	case 0 : SetProp("ausgebruetet", 1);
      	       break;

      	default: this_object()->SetProp("ausgebruetet");
}


 SetProp(P_SHORT, "Moewenei");
 SetProp(P_LONG, BS("Das Klippenmoewenei schimmert leicht blaeulich. Du weisst "
                    "nicht wie weit es schon gebruetet wuerde, aber dass merkst "
                    "Du sicher wenn Du das Ei isst."));
 SetProp(P_GENDER, NEUTER);
 SetProp(P_WEIGHT, 20);
 SetProp(P_VALUE, 35);
 AddId(({"ei","moewenei","klippenmoewenei","PB_PERMISSION"}));
 SetProp(P_NAME, "Moewenei");
 SetProp(P_MATERIAL, MAT_CHALK);

 AddCmd(("iss"), "func_ei");
 
}

int func_ei(string str) {
	
	if(str=="moewenei"||str=="ei"||str=="klippenmoewenei") {
		
		if(this_object()->QueryProp("nichtgebruetet")) {
			write(BS("Du schlaegst ein kleines Loch in das Ei und "
			"schluerfst den Inhalt heraus."));
			say(BS(""+TPN+" schluerft ein Moewenei aus. "
			"Roh versteht sich."));
			this_player()->heal_self(20+random(10));
			this_object()->remove();
		return 1;}
		if(this_object()->QueryProp("halbgebruetet")) {
			write(BSL("Du schlaegst ein Loch in das Ei und "
			"schluerfst den Inhalt heraus.\n!!!SCHLUCK!!!\n"
			"Das Ei war schon halb ausgebruetet! "
			"Angewiedert schluckst Du das halbfertige Kueken "
			"hinunter.\n"));
			say(BS(""+TPN+" schluerft ein Moewenei aus und wird "
			"ploetzlich bleich."));
			this_player()->heal_self(3+random(5));
			this_object()->remove();
		return 1;}
		if(this_object()->QueryProp("fastausgebruetet")) {
			write(BSL("Du schlaegst ein Loch in das Ei und trinkst "
			"den Inhalt aus.\n"
			"!!!AARRGG!!!\n"
			"Du verschluckst Dich an einem beinahe fertig "
			"ausgebruetetem Kueken! KINDERMOERDER!\n"));
			say(BS(""+TPN+" trinkt ein Moewenei aus und schreit "
			"ploetzlich erschrocken auf."));
			this_player()->do_damage(1+random(5));
			this_object()->remove();
		return 1;}
		if(this_object()->QueryProp("ausgebruetet")) {
			
		object kueken;	
			
			tell_room(environment(this_player()), "\n");
			write(BS("Du schlaegst das Ei auf und willst es schon "
			"austrinken, als ploetzlich piepsend ein Moewenkueken "
			"aus dem Ei springt!"));
			say(BS(""+TPN+" schlaegt ein Moewenei auf und will es "
			"gerade austrinken, als ploetzlich ein piepsendes "
			"Moewenkueken aus dem Ei springt!"));
			tell_room(environment(this_player()), "\n");
			kueken=CLONEOB("/d/dschungel/trintrasil/fluss/obj/kueken");
			kueken->move(this_player(), M_NOCHECK);
			this_object()->remove();
		return 1;}
		
		else {
			write(BS("Du schlaegst ein kleines Loch in das Ei und "
			"schluerfst den Inhalt heraus."));
			say(BS(""+TPN+" schluerft ein Moewenei aus. "
			"Roh versteht sich."));
			this_player()->heal_self(20+random(10));
			this_object()->remove();
		return 1;}
	return 1;}
	
	if(!str) { return 0;}
return 0;}

		
			 
