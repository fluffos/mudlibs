
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Paar kleiner Haferschuach");
  SetProp (P_LONG,BS(
"Die Haferlschuach sind aus gelblichem Birkenholz und sicher extrem unbequem."));

AD(({"birkenholz","holz"}),
"Die Schuhe sind aus Birkenholz geschnitzt. Wenn Du Deine Fuesse da reinpresst "
"sind Blasen das wenigste.");
AD(({"blasen","blase"}),
"Du kannst froh sein wenn es nur bei Blasen bleibt.");
AD(("fuesse"),
"Ueberlege Dir gut ob Du die Schuhe tatsaechlich anziehen willst.");


  SetProp (P_NAME, "Haferlschuach");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, FEMALE);
  AddId (({"schuach","schuhe","haferlschuach"}));
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 200);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_MATERIAL, ([MAT_WOOD]));
  
}
