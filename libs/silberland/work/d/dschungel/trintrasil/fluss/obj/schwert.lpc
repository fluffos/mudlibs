

inherit "std/weapon";
#include <properties.h>     
#include <combat.h>        
#include <language.h>    
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Schwert");
SetProp (P_GENDER, NEUTER);
SetProp (P_VALUE, 80);
SetProp (P_WEIGHT, 1250);
SetProp (P_WEAPON_TYPE, WT_SWORD);

SP(P_LONG, BS(
"Das Schwert ist ein maechtiger, einseitig geschliffener Zweihaender. Die "
"Klinge ist leicht gebogen und glaenzt rasiermesserscharf. Es sieht aus wie "
"eine maechtige, magische Waffe die sogar Fels wie zartes Fleisch zerteilen "
"koennte. Die Waffe liegt federleicht und ausgewogen in der Hand und scheint "
"in ungeduldiger, blutruenstiger Erwartung zu vibrieren."));

AddId(({"waffe","schwert","zauberschwert","zweihaender","bihaender"}));

SP(P_SHORT, "Ein magisches Schwert");

SP(P_NAME_ADJ, "magisch");
SetProp (P_DAM_TYPE, ({ DT_SLASH}));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 1);//in wirklichkeit ist das schwert ein witz (was erwartet man auch von einem feenstab
SetProp (P_NR_HANDS, 2);
SetProp (P_MATERIAL, ([MAT_STEEL:100]));

AD(({"klinge","seite"}),
  "Die Klinge ist auf einer Seite rasiermesserscharf und makellos geschliffen. "
  "Mit dieser stahlharten Klinge wirst Du Deinen Feinden das Fuerchten "
  "lehren.");
  
AD(({"feinde","fuerchten"}),
  "Mit diesem magischen Schwert wirst Du bald keine Feinde mehr haben.");

AD(("fels"),
  "Mit dieser Waffe kannst Du sicher auch massiven Stein spalten, obwohl der "
  "Zweihaender dafuer viel zu schade ist.");
  
AD(("hand"),
  "Das Schwert ist hervorragend ausgewogen und wie fuer Dich gemacht. Es "
  "laesst sich federleicht fuehren.");
  
AD(("erwartung"),
  "Das Schwert scheint kaum merklich zu vibrieren als koennte es das Blut "
  "Deiner Feinde nicht mehr erwarten.");  
}   