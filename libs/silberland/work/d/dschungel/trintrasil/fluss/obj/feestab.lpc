inherit "std/weapon";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

int tauben=3;

reset()  {
::reset();
tauben=3;
}

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"stab","zauberstab"}));
   SetProp(P_NAME, "Zauberstab");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Zauberstab" );
   SetProp(P_LONG, BS(
   "Der Zauberstab ist dunkelblau und nur 30 cm lang. An seiner Spitze ist ein "
   "pinker Stern befestigt. Er wirkt eher wie ein Kinderspielzeug als wie ein "
   "maechtiges, magisches Werkzeug."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_VALUE,200);
   SetProp(P_WEIGHT,100 );

AD(("spitze"),
"An der Spitze des Stabes ist ein plump aussehender pink bemalter Stern "
"befestigt.");

AD(("stern"),
"Der globige Stern ist pink bemalt. Sehr maechtig sieht der Stab ja nicht aus, "
"aber probier einmal den ueblichen Kinderzauberspruch.");

AD(({"kinderzauberspruch","kinderspruch","spruch","zauberspruch"}),
"Grosse Erwartungen hast Du ja nicht, aber sag einmal Akra Kadabra.");

AD(({"werkzeug","spielzeug","kinderspielzeug","kinder"}),
"Der Zauberstab sieht eher wie ein billiges Kinderspielzeug aus. Sag einmal "
"Akra Kadabra. Vielleicht hilft passiert ja etwas.");

AddCmd(("sag"), "zauber");
}

int zauber(string str) {
	
	if(str!="akra kadabra") {
		return 0;
	}
		
	if(str=="akra kadabra") {
		write(BSL("Du schwingst theatralisch den Zauberstab und "
		"sagst: AKRA KADAABRA!\n\n"));
		say(BSL("\n"+TPN+" schwingt theatralisch einen Zauberstab "
		"und sagt: AKRA KADABRA!\n\n"));
	
		switch(random(9)) {
			
			case 1:	
			call_out("zauber1", 1);
			break;
			
			case 2:
			call_out("zauber2", 1);
			break;
			
			case 3:
			call_out("zauber3", 1);
			break;
			
			case 4:
			call_out("zauber4", 1);
			break;
			
			case 5:
			call_out("zauber5", 1);
			break;
			
			case 6:
			call_out("zauber6", 1);
			break;
			
			case 7:
			call_out("zauber7", 1);
			break;

                        case 8:
                        call_out("zauber8", 1);
                        break;
                        			
			case 0:
			call_out("zauber9", 1);
			break;
			
			default:
			call_out("zauber1", 1);
		}
	}
return 1;}

zauber1() {
	write(BS("Ploetzlich schiesst Dir mit lautem Geklingel Wasser aus "
	"den Ohren!"));
	say(BS(""+TPN+" schiesst ploetzlich mit lautem Geklingel Wasser aus "
	"den Ohren!"));
}

zauber2() {
	write(BS("BOEEEERPS! Mit einem unanstaendigen Ruelpser spritzen "
	"Konfetti aus Deinem Zauberstab!"));
	say(BS("BOEEEERPS! Mit einem unanstaendigen Ruelpser spritzen Konfetti "
	"aus dem Zauberstab von "+TPN+"!"));
}

zauber3() {
	write(BS("Eigenartig, der Zauberstab gibt nur einen mueden Furz von "
	"sich."));
	say(BS("Der Zauberstab von "+TPN+" gibt einen mueden Furz von sich."));
}

int zauber4() {
	
	object taube;
	
	if(tauben>=1) {
		write(BS("Mit einem lautem TROEROEEEE flattert eine "
		"schneeweisse Taube aus dem Zauberstab."));
		say(BS("Ein lautes TROEROEEEE ertoent und eine schneeweisse "
		"Taube flattert aus dem Zauberstab von "+TPN+"."));
		taube=CLONEOB("/d/dschungel/trintrasil/fluss/npc/taube");
		taube->move(environment(this_player()), M_GO+ M_SILENT);
		tauben--;
	}
	
	if(tauben<1) {
		write(BS("Du hoerst ein kurzes empoertes Gurren. Der "
		"Zauberstab sagt: Tut mir leid, aber die dumme Taube will noch "
		"nicht herauskommen."));
		say(BS("Du hoerst ein kurzes empoertes Gurren. Der Zauberstab "
		"von "+TPN+" sagt: Tut mir leid, aber die dumme Taube will "
		"noch nicht herauskommen."));
	}
}

zauber5() {
	write(BS("Der Zaubersab kruemmt sich kurz und ploetzlich riecht es hier "
	"penetrant nach Blutwurst."));
	say(BS("Der Zauberstab von "+TPN+" bewegt sich ruckartig und ploetzlich "
	"riecht es sehr penetrant nach Blutwurst."));
}

zauber6() {
	if(TP->QueryProp(P_GENDER)!=FEMALE) {
		write(BS("Der Zauberstab schreit: Lass mich in Ruhe Du "
		"Penner!"));
		say(BS("Der Zauberstab von "+TPN+" schreit: Lach mich in Ruhe "
		"Du Penner!"));
	}
	
	if(TP->QueryProp(P_GENDER)==FEMALE) {
		write(BS("Der Zauberstab schreit: Lass mich bloss in Ruhe Du "
		"Kuh!"));
		say(BS("Der Zauberstab von "+TPN+" schreit: Lass mich bloss in "
		"Ruhe Du Kuh!"));
	}
}

zauber7() {
	write(BS("Der Zauberstab lacht gehaessig und verbrennt Dir die "
	"Hand!"));
	say(BS("Der Zauberstab von "+TPN+" lacht gehaessig. "+TPN+" zuckt "
	"schmerzhaft zusammen."));
	TP->do_damage(2+random(3));
}

zauber8() {
	
	object schwert;
	
	write(BS("OOOOH! Der Zauberstab verwandelt sich ploetzlich in ein "
	"wunderschoenes Schwert!"));
	say(BS("OOOOH! Der Zauberstab von "+TPN+" verwandelt sich ploetzlich in "
	"ein wunderschoenes Schwert!"));
	schwert=CLONEOB("/d/dschungel/trintrasil/fluss/obj/schwert");
	schwert->move(TP, M_NOCHECK);
	this_object()->remove();
}

zauber9() {
	
	write(BSL("Der Zauberstab sagt: Du bist mir zu kindisch.\nDer "
	"Zauberstab verschwindet mit einem Knall und Schwefelduft."));
	say(BSL("Der Zauberstab von "+TPN+" sagt: Du bist mir zu kindisch.\n"
	"Der Zauberstab verschwindet mit einem Knall und Schwefelduft."));
	this_object()->remove();
}

 
		
