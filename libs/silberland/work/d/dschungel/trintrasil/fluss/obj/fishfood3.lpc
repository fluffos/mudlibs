inherit "std/food";

#include <moving.h>
#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{

 if (!is_clone(this_object())) return; 

call_out("destruct_func", 15000+random(1000));

::create();

 SetProp(P_SHORT, "Hundsbarbe");
 SetProp(P_LONG, "Die Hundsbarbe ist ein ziemlich grosser Speisefisch. Wenn Du "
 "Hunger hast solltest Du sie gleich essen bevor sie verdirbt.");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_VALUE, 50+random(30));
 AddId(({"barbe","hundsbarbe","fisch"}));
 SetProp(P_NAME, "Hundsbarbe");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);

 SetProp(P_FOOD_INFO, ([F_HEAL : ({1,1}), 
 F_SOAK : 1,
 F_MSG:"Melde Trintrasil bitte, dass mit den Speisefischen etwas nicht stimmt.\n",
 F_MSG_ROOM:"isst eine rohe Hundsbarbe."]));

 SetProp(P_SMELL, "Die Hundsbarbe riecht noch gut. Du solltest sie essen bevor "
 "sie verdirbt.\n");

 AD(({"speisefisch","speise"}),
   "Die Hundsbarbe ist ein guter Speisefisch. Auch wenn Du von rohem Fisch "
   "nicht besonders begeistert bist, gibt sie ein passales Essen.");
   
 AD(("essen"),
   "Wenn Du sie jetzt nicht essen willst dann heb sie eben auf. Sie wird wohl "
   "noch etwas halten.");
}


destruct_func() {
	
object graete;
        
        graete=CLONEOB("/d/dschungel/trintrasil/fluss/obj/graete");
        graete->SetProp(P_LONG,"Die Graeten einer Hundsbarbe");
        graete->move(ENV(TO), M_GO+ M_SILENT);
        TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
	M_SILENT);
        TO->remove();
}