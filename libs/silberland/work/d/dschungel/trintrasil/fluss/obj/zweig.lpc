
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"zweig","graetenzweige","graetenbuschzweig"}));
   SetProp(P_NAME, "Zweig");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Zweig" );
   SetProp(P_LONG, BS(
   "Dieser weisse, gerade Zweig stammt von einem Graetenbusch. Aus diesem "
   "feinen, zaehen Holz kann man Fischpfeifen schnitzen."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,5 );


   AD(({"fischpfeife","fischpfeifen","pfeife","pfeifen"}),
     "Der Ton dieser Pfeifen erreicht die Frequenz der Brunftlaute von manchen "
     "sehr grossen Fischarten. Wenn Du ein Taschenmesser hast koenntest Du "
     "aus diesem Zweig eine Fischpfeife schnitzen.");
     
   AD(({"fischarten","arten","laut","laute","brunftlaute"}),
     "Man lockt damit sehr grosse Fisch des ´Rio de la Puseta´ damit an um "
     "auf ihnen ueber dem Fluss zu reiten.");

   AD(({"ton","frequenz"}),
     "Der Ton ist so tief das Du ihn nicht hoeren kannst.");
    
   AD(({"rio","rio de la puseta","puseta"}),
     "Der Busch von dem dieser Zweig stammt waechst sicher im Flussgebiet des "
     "´Rio de la Puseta´.");
   
   AD(({"busch","graetenbusch"}),
     "Dieser tropische Busch waechst bevorzugt im Flussgebiet des ´Rio de la "
     "Puseta´.");
   
   AD(("holz"),
     "Das Holz ist knochenweiss und sehr zaeh.");
       
   AD(({"flussgebiet","gebiet","fluss"}),
     "Den grossen Fluss wirst Du doch kennen.");
     
   AddCmd(("schnitze"), "func_schnitzen");
}


  int func_schnitzen(string str) {
  	
    object pfeife;
    object tmesser, messer;
    tmesser=present("taschenmesser", TP);
    messer=present("messer", TP);
    
    notify_fail("Was willst Du aus was schnitzen?\n");
    
    if(str=="pfeife"||str=="fischpfeife"||str=="eine pfeife"||str=="eine "
       "fischpfeife"||str=="pfeife aus zweig"||str=="fischpfeife aus zweig"||
       str=="eine pfeife aus zweig"||str=="eine fischpfeife aus zweig"||
       str=="eine pfeife aus dem zweig"||str=="eine fischpfeife aus dem zweig"||
       str=="pfeife mit messer"||str=="fischpfeife mit messer"||str=="pfeife "
       "mit taschenmesser"||str=="fischpfeife mit taschenmesser") {
       	
       if((!messer)||(tmesser)) {
       	 
       	Z 
       	write(BS("Du brauchst ein Messer um zu schnitzen. Ein Schwert ist doch "
       	         "etwas zu unhandlich."));
       	         return 1;}
       	         
       if( ( (messer)&&(messer->QueryWielded()) )||
           ( (tmesser)&&(tmesser->QueryWielded())&&
           (tmesser->QueryProp("geoeffnet"))) ) {
       	
       	Z
       	write(BS("Vorsichtig beginnst Du damit die Rinde vom Zweig zu schaelen "
       	         "und hoelst diesen aus. Nach einiger Zeit ist diese einfache "
       	         "Fischpfeife fertig."));
       	say("\n\n");
       	say(BS(""+TPN+" schaelt vorsichtig die Rinde von einem Zweig und hoelt "
       	       "diesen aus. Nach einiger Zeit hat "+TPN+" eine Fischpfeife "
       	       "geschnitzt."));
       	pfeife=CLONEOB("/d/dschungel/trintrasil/fluss/obj/pfeife");
       	pfeife->move(TP, M_NOCHECK);
       	TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", M_GO+
       	         M_SILENT+ M_NO_SHOW);
       	TO->remove();
       return 1;}
       
        if( (tmesser)&&(tmesser->QueryWielded())&&
            (!messer->QueryProp("geoeffnet")) ) {
        	
         Z
         write(BS("Du wuerdest Dir beim Schnitzen leichter tun wenn Du das "
                  "Messer vorher oeffnen wuerdest."));
        return 1;}
        
        if( ( (tmesser)&&(tmesser->QueryProp("geoeffnet"))&&
              (!tmesser->QueryWielded())) || (messer)&&
              (!messer->QueryWielded()) ) {
           	
         Z
         write(BS("Du musst das Messer erst zuecken um damit zu schnitzen."));
        return 1;}
      return 0;}
    return 0;}
        	  