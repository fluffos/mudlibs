
inherit "std/weapon";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"wurm"}));
   SetProp(P_NAME, "Wurm");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Wurm" );
   SetProp(P_LONG, BS(
   "Der kleine, rosa Wurm moecht wohl eher wieder in die Erde kriechen als "
   "von Dir begutachtet zu werden."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL, MAT_MISC_LIVING);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,5 );
}
