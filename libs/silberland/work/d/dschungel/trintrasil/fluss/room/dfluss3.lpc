#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"

#define DFLUSS4 "/d/dschungel/trintrasil/fluss/room/dfluss4.lpc"


void create()
{
  ::create();

dschungelfluss_details();
jagdgebiet();//markiert diesen raum als jagdgebiet fuer fische mittels fischspeer

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Rio de la Puseta wird hier wieder etwas schmaeler, wodurch auch die "
"Fliessgeschwindigkeit zunimmt. Durch die staerkere Stroemung ist "
"der Seerosen und Schilfbewuchs weit geringer als im Nordwesten. Nach "
"Suedosten rauscht der schlammige Fluss weiter ueber einige gefaehrlich "
"aussehende Stromschnellen. Tueckische Felsen und geborstene Baumstaemme "
"ragen stellenweise aus dem Wasser, das sich rauschend an den Hindernissen "
"bricht."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_WATER]) );  

 AD(({"rio","fluss","rio de la puseta","puseta","suedosten"}),
   "Der schlammige Fluss rauscht nach Suedosten durch heimtueckisch aussehende "
   "Felsen. Diese Stromschnellen wirst Du mit dem Fisch nicht ueberwinden "
   "koennen.");
   
 ASD(({"schnellen","stromschnellen","hindernisse","fisch"}),
   "fisch");

 AD(({"felsen","fels"}),
   "Spitze Felsen ragen aus dem schaeumenden Fluss. Manche Felsen sind vom "
   "Fluss ganz ueberspuelt und schimmern nur verschlagen unter der "
   "Wasseroberflaeche. Aber einige besonders grosse Felsbloecke ragen wie "
   "kleine Inseln aus dem Wasser.");

 AD(({"geschwindigkeit","stroemung","fliessgeschwindigkeit"}),
   "Da sich der Fluss hier verengt, nimmt auch die Fliessgeschwindigkeit zu.");
   
 AD(("boden"),
   "Du siehst nur, dass einige tueckische Felsen aus dem Wasser ragen.");
   
 AD(("himmel"),
   "Der Himmel ist kaum bedeckt.");
       
 AD(({"oberflaeche","wasseroberflaeche"}),
   "Unter der Wasseroberflaeche lauern einige gefahren. An einigen Stellen "
   "woelbt sich das Wasser ueber einem spitzen Felsen auf.");
   
 AD(({"stelle","stellen"}),
   "Es gibt aber sicher genug andere gefaehrliche Stellen die Du nicht erkennst "
   "in diesen Stromschnellen.");
   
 AD(({"insel","inseln","bloecke","felsbloecke","block","felsblock"}),
   "Die meisten von ihnen ragen in bizarren Winkel aus dem schaeumenden Wasser, "
   "sodass man unmoeglich auf sie klettern kann.");
   
 ASD(("winkel"),
   "winkel");

 ASD(({"etwas","gegenstand"}),
   "etwas");
   
 AD(({"felsbrocken","brocken"}),
   "Du kannst auf den Felsbrocken klettern.");
      
 AD(("wasser"),
   "Das Wasser spritzt und schaeumt. Das Gefaelle das der Fluss hier "
   "ueberwindet ist doch recht beachtlich.");
   
 AD(({"gefaelle"}),
   "Der Fluss rauscht durch die Felsbloecke einige Meter steiler nach unten.");
   
 AD(("meter"),
   "Der Fluss rauscht hier durch Felsbloecke steiler nach unten. Weiter im "
   "Suedosten siehst Du ihn wieder ruhig und gemaechlich dahin fliessen.");
   
 AD(({"baumstaemme","treibholz","holz"}),
   "Treibholz hat sich teilweise zwischen den Felsen verfangen.");

 AD(({"bewuchs","schilfbewuchs","schilf","guertel","schilfguertel"}),
   "Am Ufer erkennst Du noch dichten Schilfbewuchs. Das Schilf waechst aber "
   "nicht so weit in den Fluss, da die Fliessgeschwindigkeit zu hoch ist.");

 AD(("dschungel"),
   "Der Dschungel wuchert hinter dem Schilfguertel am Ufer.");
   
 AD(("nordwesten"),
   "Im Nordwesten fliesst der Fluss ruhiger dahin, daher wachsen dort auch viel "
   "mehr Seerosen und Schilf.");
      
 AD(("ufer"),
   "Das feuchte, schlammige Ufer ist dicht mit Schilf bewachsen.");
   
 AD(({"seerosen","rosen","seerosenbewuchs"}),
   "Nur einige wenige kleinere Seerosen koennen sich in der Naehe des Ufers "
   "in der starken Stroemung halten.");
   
 AD(("naehe"),
   "Das Ufer ist hier schlammig und dicht mit Schilf verwachsen. Hier wirst Du "
   "sicher nicht ans Ufer gehen koennen.");


 AddSound( DEFAULT_SOUND,
   "Der Fluss rauscht spritzen ueber Felsbloecke.");
 
 AddSound(("fluss"),
   "Der Fluss rauscht spritzen ueber Felsbloecke.");
      
     
AddCmd(({"klettere","erklettere","steige"}), "func_felsen");

         
  AddExit("suedosten", ([
          EX_FUNC:"stromschnellen"]));

  NORDW
    }


NORDWF(dfluss2)

stromschnellen() {

    int i, moveint;
    object *inv;
    inv=all_inventory(environment(this_player()));
	
	if(interactive(TP)) {

     	if( present("wasserschlange", environment(this_player())) ) {

     		for(i=sizeof(inv)-1;i>=0;i--) {

                        if( inv[i]->id("EVENTSCHLANGE") ) {
                      
                                if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
                                	moveint++;
                                }
                        }
                        if( !inv[i]->id("EVENTSCHLANGE") ||
                        (inv[i]->id("EVENTSCHLANGE") && !inv[i]->QueryProp(""+this_player()->name()+"")) ) {

                        }
                }
                if(moveint>0) {
                	write(BSL("\nSolange Dein Fisch mit der Wasserschlange "
                	"kaempft laesst er sich nicht steuern.\n\n"));
                	return 1;
                }
                
                if(moveint==0) {
                	write(BSL("\nAls Du den Fisch auf die Stromschnellen "
                	"zusteuern willst, bockt dieser und droht Dich "
                	"abzuwerfen.\n\n"));
                	say(BSL("\n"+TPN+" versucht mit einem Fisch die "
                	"Stromschnellen hinunter zu schwimmen.\n\n"));
                	return 1;
                }
                moveint=0;
         return 1;}
         
         if( !present("wasserschlange", environment(this_player())) ) {
		write(BSL("\nAls Du den Fisch auf die Stromschnellen zusteuern "
		"willst, bockt dieser und droht Dich abzuwerfen.\n\n"));
		say(BSL("\n"+TPN+" versucht mit einem Fisch die Stromschnellen "
		"hinunter zu schwimmen.\n\n"));
		return 1;
	}
return 1;}                        
	if(!interactive(TP)) {
	return 1;}
return 0;}
          

func_felsen() {
	
	int i, moveint;
	object *inv;
	inv=all_inventory(environment(this_player()));
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" klettert auf den felsen in dfluss3.\n");
	
     	if( present("wasserschlange", environment(this_player())) ) {

     		for(i=sizeof(inv)-1;i>=0;i--) {

                        if( inv[i]->id("EVENTSCHLANGE") ) {
                      
                                if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
                                	moveint++;
                                }
                        }
                        if( !inv[i]->id("EVENTSCHLANGE") ||
                        (inv[i]->id("EVENTSCHLANGE") && !inv[i]->QueryProp(""+this_player()->name()+"")) ) {

                        }
                }
                if(moveint>0) {
                	write(BSL("\nSolange Dein Fisch mit der Wasserschlange "
                	"kaempft laesst er sich nicht steuern.\n\n"));
                	return 1;
                }
                
                if(moveint==0) {
                	write(BSL("\nDu steuerst den Fisch moeglichst nahe an "
                	"den Felsblock heran und ziehst Dich an dessen Rand "
                	"hoch. Dein Fisch taucht in das truebe Wasser des Rio "
                	"de la Puseta unter.\n\n"));
		        say(BS(""+TPN+" klettert auf einen Felsblock. Der Fisch "
		        "schwimmt schnell weg."));
		        TP->move("/d/dschungel/trintrasil/fluss/room/dfluss4.lpc", 
		        M_GO + M_SILENT);
                	return 1;
                }
                moveint=0;
         return 1;}
         
         if( !present("wasserschlange", environment(this_player())) ) {
         	write(BSL("\nDu steuerst den Fisch moeglichst nahe an den "
		"Felsblock heran und ziehst Dich an dessen Rand hoch. Dein "
		"Fisch taucht in das truebe Wasser des Rio de la Puseta "
		"unter.\n\n"));
		say(BS(""+TPN+" klettert auf einen Felsblock. Der Fisch "
		"schwimmt schnell weg."));
		TP->move("/d/dschungel/trintrasil/fluss/room/dfluss4.lpc", M_GO + 
	        M_SILENT);
		return 1;
	}
return 0;}
	
          
winkel() {
	
	if( DFLUSS4->objects() ) {
		return BS("Ein besonders grosser Brocken ist aber relativ flach "
		"und sieht auch einfach zu erklettern aus. Ausserdem scheint "
		"etwas auf ihm zu liegen.");
	}
	
	if( !DFLUSS4->objects() ) {
		return BS("Ein besonders grosser Brocken ist aber relativ flach "
		"und sieht auch einfach zu erklettern aus.");
	}
}


etwas() {
	
	if( DFLUSS4->objects() ) {
		return BS("Was genau auf dem Felsbrocken liegt, wuerdest Du "
		" sehen, wenn Du auf ihn klettern wuerdest.");
	}
	
	if( !DFLUSS4->objects() ) {
		return BS("Was meinst Du? Der Felsbrocken scheint leer zu "
		"sein.");
	}
}



fisch() {//da sdetails die diese abfrage beinhalten immer das gleiche muster 
//aufweisen wurde diese abfrage im myowndefine definiert

WSCHLANGENABFRAGE(return BS("Auch wenn Du die Wasserschlange toetest wird der "
		  "Fisch sicher nicht durch diese wilden Stromschnellen "
		  "schwimmen.");,return BS("Der Fisch wird sicher nicht durch "
		  "diese wilden Stromschnellen schwimmen.");)
}
		

   