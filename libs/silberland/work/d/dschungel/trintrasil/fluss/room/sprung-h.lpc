//fertig und getest

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";



create()
{
  ::create();

  SetProp( P_INT_SHORT, "kurz vor dem Ertrinken" );
  SetProp( P_INT_LONG, BS(
  "Sollte niemand sehen."));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
int no() {
	
	write(BSL("\nDu kaempfst verzweifelt gegen das Ertrinken.\n"));
return 1;}


int njet() {
	
	write(BSL("\nDu strampelst panisch, aber Wasser dringt Dir in Mund und Nase!\n"));
return 1;}

   
  init()
  {::init();

  if(query_once_interactive(this_player())){
  call_out("strudel1", 2);}
  }
  

strudel1() {
   	
   	NIX
        write(BSL("   !!!PLATSCH!!!\nDu klatscht spritzend ins Wasser.\n"));
        tell_room("/d/dschungel/trintrasil/fluss/room/fluss13", BSL("\n"+TPN+" "
        "klatscht spritzend ins Wasser und wird davon getrieben.\n\n"));
        tell_room("/d/dschungel/trintrasil/fluss/room/turm", BSL("  !!!PLATSCH!!!\n"
        "Du hoerst wie "+TPN+" unter Dir ins Wasser klatscht.")); 
        call_out("strudel2", 2);
}

   
strudel2() {
	
	NIX
	write(BSL("\nDie Stroemung reisst Dich sofort mit.\n"));
        call_out("strudel3", 2);
}

 
strudel3() {
	
	NIX
	write(BSL("\nDeine Arme werden schwer, Du gehst kurz unter.\n"));
        call_out("strudel4", 2);
}

 
strudel4() {
	
	NIX
	write(BSL("\nDeine Gegenstaende ziehen Dich entgueltig unter Wasser.\n"));
	call_out("strudel5", 2);
}


strudel5() {
	
	NIX
	write(BSL("\nDie Wasseroberflaeche schimmert unerreichbar ueber Dir.\n"));
	RemoveCmd("", "no");
        AddCmd("", "njet", 1);
        call_out("strudel6", 3);
        }
    
    
strudel6() {
	
	NIX
	write(BSL("\nPloetzlich fuehlst Du Grund unter Deinen Fuessen. Der Fluss wird "
	"jetzt schnell seichter."));
	call_out("strudel7", 3);
}


strudel7() {
	
	NIX
	tell_room("/d/dschungel/trintrasil/dorfneu/room/room9.lpc", BSL("\n"+TPN+" "
        "wird vom Fluss angespuelt.\n\n"));
        write(BSL("\nHustend und wasserspuckend kommst Du an die Oberflaeche und "
        "wankst an Land.\nGluecklicherweise hat Dich der Fluss hier irgendwo "
        "angespuelt.\n\n"));
        TP->move("/d/dschungel/trintrasil/dorfneu/room/room9.lpc", M_GO+ M_NO_SHOW+
        M_SILENT);
        RemoveCmd("","njet");
        AddCmd("","no", 1); 
}
   
     
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/dorfneu/room/room9.lpc",M_GO+ M_SILENT+
	M_NO_SHOW);
        tell_room("/d/dschungel/trintrasil/dorfneu/room/room9.lpc", BSL("\n"+TPN+" "
        "wird vom Fluss angespuelt.\n\n"));
return 1;}

  
  