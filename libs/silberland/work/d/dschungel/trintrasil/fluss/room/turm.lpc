#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";

int seil=0;//haengtseil fuer SD und long und abfrage aus fluss13
int kletterer=0;//klettert gerade jemand

reset() {
	if(kletterer!=0) {
	}
	
	if( (kletterer==0) && (seil!=0) ) {
		seil=0;
		tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
		BSL("\nNa sowas! Ein Seil, dass von einem Felsturm neben Dir "
		"hing faellt herunter und versinkt im Fluss!"));
		::reset();
	}
	
	if( (kletterer==0) && (seil==0) ) {
		::reset();
	}
}

	   
void create() {
	
  ::create();


  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string("Du befindest Dich auf einem kleineren "
          "Felsturm ca 7 Meter ueber dem Fluss. Der Felsturm hat die Form "
          "einer umgedrehten Birne und ist hier auf der Oberseite flach und "
          "ausladend. Es koennte richtig gemuetlich sein wenn da nicht dieser "
          "gehaessige Kobold waere."));

    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );  

  SetProp("turm", 1);
  
  AD(({"tuerme","saeulen","felssaeulen","felstuerme","riesen","riese"}),
    "An den Schluchtwaenden reihen sich einige dieser gelben Riesen, die "
    "meisten viel groesser als der Turm auf dem Du sitzt. Die groessten "
    "Felssaeulen ragen teilweise sogar ueber 20 Meter aus dem gruenen Wasser.");

  AD(({"turm","felsturm","felssaeule","saeule"}),
    "Der Felsturm verbreitert sich stark nach oben hin und biete hier bequem "
    "Platz. Viele Fischgraeten und herumliegende Lumpen zeigen deutlich "
    "das sich hier oefters jemand aufhaelt.");

  AD(("form"),
    "Der Felsturm verbreitert sich stark nach oben hin.");
    
  AD(("birne"),
    "Der Felsturm verbreitert sich nach oben. Sanft aber hartnaeckig schleift "
    "der umspuelende Fluss den Felsturm immer mehr ab und macht ihn unten "
    "somit immer duenner, bis diese grosse Birne ganz umfallen wird.");
  
  AD(("gurgeln"),
    "Sanft und traege gurgelt der gruene Fluss zwischen den grossen "
    "Felstuermen.");
     
  AD(("lumpen"),
    "Die Lumpen hat hier jemand ueber ein paar groessere Steine gebreitet um "
    "bequemer sitzen zu koennen. Sie sehen alle sehr mitgenommen und "
    "unbrauchbar aus.");
    
  AD(({"stein","steine"}),
    "Ueber ein paar ca trollkopfgrosse, gelbe Steine hat jemand Lumpen "
    "gebreitet um sie als Sitzplatz zu benutzen.");
    
  AD(({"platz","sitzplatz"}),
    "Von hier aus hast Du einen schoenen Blick ueber den Fluss. Du koenntest ja "
    "von hier oben ins Wasser springen.");
        
  AD(("wasser"),
    "Da hier wenig Licht in die Schlucht dringt schimmert das Wasser nur in "
    "einem matten Gruen. Ein Sprung waere ziemlich gewagt.");
  
  AD(("sprung"),
    "Springe vom Turm wenn Du mutig bist. Aber wie willst Du dann an Land gehen?");
  
  AD(("land"),
    "Das wirst Du nur erfahren wenn Du springst. Vielleicht gehst Du ja einfach nur "
    "unter und ertrinkst.");
    
  AD(({"licht","sonnenlicht","schein"}),
    "Durch die schuetzende Schlucht erreicht die stechende Sonne den "
    "Fluss nur als daemmriger Schein.");      

  AD(("sonne"),
    "Die Sonne kannst Du garnicht direkt sehen, da sie von den gewaltigen "
    "Uferwaenden abgeschirmt wird.");

  AD(({"uferwand","uferwaende","wand","waende","felswaende","felswand","schluchtwaende"}),
    "Die steilen Uferwaende ragen schattig in gelb-orangen Toenen neben Dir "
    "auf. Weiter oben, wo noch Sonnenlicht auf den Fels trifft, schimmern "
    "sie in einem feurigen orange.");

  AD(({"sandgestein","gestein"}) ,  
    "In dem daemmrigen Licht verliert das gelbe Gestein etwas an Farbkraft.");
      
  AD(({"farbkraft","kraft"}),
    "Das sonst gelb leuchtende Sandgestein wirkt hier matt und duester.");
    
  AD(({"schlucht","blick"}),
    "Die Schlucht ist hier besonders daemmrig, wodurch die zahlreichen "
    "Felstuerme bedrohlich auf Dich wirken. Im Sueden scheint sich die Schlucht "
    "allerdings sehr zu verbreitern und ist auch wieder sonniger.");
    
  AD(("fels"),
    "Der gesamte Fels besteht hier aus weichem Sandgestein.");
    
  AD(({"farbe","farbtoene","toene","gelb"}),
    "Farbtoene von gelb bis orange ziehen sich durchs Gestein.");

  AD(({"gischtregen","gischt","regen"}),
    "Ein leichter, sanfter Schleier weht von Sueden herein."),
    
  AD(({"schleier","sueden"}),
    "Mit einem feinen Gischtregen weht ein Rauschen von Sueden "
    "durch die Schlucht.");

  AD(("rauschen"),
    "Gedaempft hallt ein Rauschen durch die Schlucht.");
 
  AD(("gruen"),
    "Der Fluss liegt ca 7 Meter unter Dir. Wer weiss was passiert wenn Du ins Wasser "
    "springst. Vielleicht gehst Du unter und ertrinkst?");
  
  AD(("wind"),
    "Der Wind faehrt stetig durch die Schlucht.");
      
  AD(("himmel"),
    "Die Sonne dringt kaum zu Dir herab.");


//+++++++++ SD ANFANG ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
   
  ASD(({"boden","seite","oberseite"}),
    "oberseite");
  
  ASD(({"anker","seil","kletterseil","kletterhaken"}),
    "seilunt");
    
  ASD(({"jemand","kobold","kerlchen"}),
    "kobold");
    
  ASD(({"graeten","graete","fischgraeten","fischgraete","fisch"}),
     "graeten");
   
  ASD(({"fluss","rio","rio de la puseta","puseta"}),
    "fluss");
   
//+++++++++++++++++ SD ENDE ++++++++++++++++++++++++++++++++++++++++++++++++++++++

    
AddItem("/d/dschungel/trintrasil/fluss/npc/kobold", REFRESH_DESTRUCT);


AddCmd(({"ziehe","zieh"}), "func_seilhoch");
AddCmd(({"werfe","wirf"}), "func_kletterseil");
AddCmd(({"klettere","kletter"}), "func_hinunterklettern");
AddCmd(("springe"), "sprung_func");
AddCmd(("beherrsche"), "prevent_elementar");
AddCmd(("zaubere"), "prevent_undead_magic");
AddCmd(("drider"), "no_spiders_wanted");
 
 AddSound( DEFAULT_SOUND,
   "Der Wind bricht sich stoehnend an den Felstuermen.\n"
   "Von Sueden her hoerst Du gedaempft das Rauschen eines Wasserfalles.");

 AddSound(({"rauschen","wasserfall"}),
   "!!!WUUUUUUUUSCHHHHH!!!");
   
 AddSound(({"wlubb","blubb","gurgeln"}),
   "!Blubb, Gurgel, Blubb, Wlubb!");
    
}

  _query_int_long() {
  	
   if((present("kobold", TO))&&(seil!=0)) {
   	
   	return(BS("Du befindest Dich auf einem kleineren Felsturm ca 7 Meter "
   	  "ueber dem Fluss. Der Felsturm hat die Form einer umgedrehten Birne "
   	  "und ist hier auf der Oberseite flach und ausladend. Es koennte "
   	  "recht gemuetlich sein wenn da nicht dieser Kobold "
   	  "waere. Zwischen ein paar groesseren Steinen liegt ein kleiner "
   	  "Anker an dem ein Seil befestigt ist."));
        }
        
   if((present("kobold", TO))&&(seil==0)) {
   	
   	return(BS("Du befindest Dich auf einem kleineren Felsturm ca 7 Meter "
   	  "ueber dem Fluss. Der Felsturm hat die Form einer umgedrehten Birne "
   	  "und ist hier auf der Oberseite flach und ausladend. Es koennte "
   	  "recht gemuetlich sein wenn da nicht ein gehaessige Kobold waere."));
   	  }
   
   if((!present("kobold", TO))&&(seil==0)) {
   	
   	return (BS("Du befindest Dich auf einem kleineren Felsturm ca 7 Meter "
   	  "ueber dem Fluss. Der Felsturm hat die Form einer umgedrehten Birne "
   	  "und ist hier auf der Oberseite flach und ausladend."));
   	}
      
   if((!present("kobold", TO))&&(seil!=0)) {
    	
    	return(BS("Du befindest Dich auf einem kleineren Felsturm ca 7 Meter "
    	  "ueber dem Fluss. Der Felsturm hat die Form einer umgedrehten Birne "
    	  "und ist hier auf der Oberseite flach und ausladend. Zwischen ein "
    	  "paar groesseren Steinen liegt ein kleiner Anker an dem ein Seil "
    	  "befestigt ist."));
    	}
      }
      

no_spiders_wanted() {
	
	if( TP->QueryProp(P_GUILD)!="dunkelelfen" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst einen Drider zu rufen, aber nichst "
		"passiert."));
		return 1;
	}
}


prevent_undead_magic(string str) {//leichen versinken zwar ohnehin sofort im Fluss, aber wer weiss..
	
	if( TP->QueryProp(P_GUILD)!="nekromanten" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Deine dunklen Kraefte zu buendeln, aber "
		"sie scheinen von einer stoerenden Kraft gehindert zu sein."));
		return 1;
	}
}


prevent_elementar(string str) {
	
	if( TP->QueryProp(P_GUILD)!="druiden" || str!="eiselementar"||str!="feuerelementar"||
	str!="eiselementar"||str!="wasserelementar"||str!="humuselementar") {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Dich auf die Beherrschung zu konzentrieren, "
		"wirst aber von einer seltsamen Kraft gestoert."));
		return 1;
	}
}


koboldaufturm() {
	
	if(present("kobold")) {
		return 1;
	}
	
	if(!present("kobold")) {
		return 0;
	}
}



seilhaengt() {
	
	if(seil==0) {//es haengt kein seil
		return 0;
	}
	
	if(seil==1) {//seil haengt fest und ist bekletterbar
		return 1;
	}
	
	if(seil==2) {//seil wird gerade heraufgeworfen und ist noch nicht bekletterbar
		return 2;
	}
	
}

	    
seilstatus1() {
  seil=1;//seil haengt somit
}


seilstatus2() {
	seil=2;//seil wurde erst geworfen und ist noch nicht bekletterbar
}

  
sprung_func(string str) {
	
	notify_fail(BS("Von wo willst Du springen?"));
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" springt vom Turm.\n");
	
	if(str=="von felsturm"||str=="von turm"||str=="ins wasser"||str=="in wasser"||
	str=="in fluss"||str=="in tiefe"||str=="vom felsturm"||str=="vom turm"||
	str=="hinunter"||str=="nach unten"||str=="in fluss"||str=="in rio de la puseta") {
		
		write(BSL("Du atmest tief ein und springst mit ausgestreckten Armen "
		"vom Felsturm\n"));
		say(BS(""+TPN+" springt vom Felsturm in den Fluss."));
		TP->move("/d/dschungel/trintrasil/fluss/room/sprung-h.lpc", M_GO+ M_SILENT+
		M_NO_SHOW);
		tell_room("/d/dschungel/trintrasil/fluss/room/fluss13", BS("Du siehst "
		""+TPN+" von einem Felsturm springen."));
		return 1;
	}
}
   

int func_kletterseil(string str) {
	
object anker;
anker=present("anker", TP);

  if(str=="seil"||str=="kletterseil") {
  	write(BS("Was willst Du auswerfen? Ein Kletterseil?\n"));
       return 1;}

  
  if(str=="seil aus"||str=="kletterseil aus"||str=="seil hinunter"||
     str=="kletterseil hinunter") {
  	
    if(seil==2) {
    	write(BSL("\nDu brauchst kein Seil auswerfen, jemand wirft gerade einen "
    	"Anker von unten hoch."));
    	return 1;}
    	
    if(seil==1) {
      write(BSL("\nWozu willst Du ein Seil auswerfen wo doch schon eines "
    	        "vom Felsturm haengt."));
    	       return 1;}
    	       
    if((seil==0)&&(!present("anker", TP))&&(present("seil", TP))) {
      write(BSL("\nDas Seil allein hilft Dir wenig. Du musst das Seil erst an "
                "einem Anker befestigen. Sonst hat es ja keinen Halt."));
               return 1;}
               
    if((seil==0)&&(!present("anker", TP))&&(!present("seil", TP))) {
      write(BSL("\nDu hast absolut ueberhaupt nichts was Du auswerfen "
                "koenntest."));
               return 1;}
               
    if((seil==0)&&(present("anker", TP))&&(!anker->QueryProp("ankerseil"))&&
       (!present("seil", TP))) {
      write(BSL("\nWas willst Du nur mit diesem seillosen Anker?"));
               return 1;}
               
    if((seil==0)&&(present("anker", TP))&&(!anker->QueryProp("ankerseil"))&&
       (present("seil", TP))) {
      write(BSL("\nDu musst schon erst das Seil an diesem Anker befestigen. Wie "
                "soll denn das Seil sonst halten?"));
               return 1;}
               
    if((seil==0)&&(present("anker", TP))&&(anker->QueryProp("ankerseil"))) {
      write(BSL("\nDu verkeilst den Anker zwischen den Steinen und wirfst das "
                "Ankerseil ueber den Rand des Felsturmes zum Fluss hinab. "
                "Du kannst nun hinunter klettern."));
        say(BSL("\n"+TPN+" verkeilt einen Anker zwischen den Steinen und wirft "
                "das Ankerseil ueber den Rand des Felsturmes zum Fluss hinab. "
                "Du kannst nun am Seil hinunterkletter."));
      seil=1;
      present("anker", TP)->move("/d/dschungel/trintrasil/fluss/room/turm",
      M_TPORT);
      anker->SetProp("kletterhaken", 1);
      anker->SetProp(P_NOGET, BS("Du kannst den Anker nicht einfach nehmen. Er "
                                 "haelt das Seil das zum Fluss hinabhaengt und "
                                 "an dem vielleicht noch jemand hochklettern "
                                 "moechte. Du musst das Seil vorher "
                                 "hochziehen."));      
      tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
            BSL("\nWUSCH!! Da faellt ein Seil von einem Felsturm neben Dir "
                "herab. Es scheint fest zu sein. Du koenntest daran hinauf "
                "klettern."));
      return 1;}
    return 0;}
  return 0;}
  
  

int func_hinunterklettern(string str) {
	
  notify_fail("Woran willst Du hinunter klettern?\n\n");
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" klettert vom turm.\n");
	
  if(str=="am seil hinunter"||str=="hinunter"||str=="an seil hinunter"||
     str=="am seil nach unten"||str=="nach unten"||str=="an seil nach unten"||
     str=="runter") {
     	
     if(seil==0) {
     	
     	write(BSL("\nDa ist nichts woran Du hinunterklettern kannst. Du "
     	"muesstest erst ein kletterseil auswerfen."));
     	return 1;}
     	
     if((!kletterer)&&(seil!=0)) {
     	
     	kletterer=1;
     	call_other("/d/dschungel/trintrasil/fluss/room/fluss13", "klettererdef1");
     	write(BSL("\nDu packst das Seil und kletterst vorsichtig ueber den Rand "
     	          "des Felsturmes."));
     	  say(BSL("\n"+TPN+" laesst sich am seil vorsichtig ueber den Rand "
     	          "gleiten und klettert daran hinunter."));
        tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
                  BSL("\n"+TPN+" beginnt an einem Seil von einem Felsturm zu "
                  "klettern."));
     	TP->SetProp("downclimber", 1);
     	call_other("/d/dschungel/trintrasil/fluss/room/fluss13", 
     	           "klettererdef1");
     	TPM("/d/dschungel/trintrasil/fluss/room/turm1-h", M_GO+ M_NO_SHOW+
     	    M_SILENT);
     	return 1;}
     
     if((kletterer)&&(seil!=0)) {
     	
     	write(BSL("\nDa ist gerade jemand auf dem Seil. Du musst noch etwas "
     	          "warten."));
     	return 1;}
     return 0;}
   return 0;}    	
        
 

int func_seilhoch(string str) {
	
object anker;
anker=present("anker", TO);

write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" zieht das Seil in turm hoch.\n");
	
  notify_fail("Was willst Du hochziehen?\n");

  if(str=="seil hoch"||str=="seil hinauf"||str=="seil ein"||str=="seil") {
  	
    if((anker)&&(anker->QueryProp("kletterhaken"))&&(!kletterer)) {

      seil=0;//seil haengt nicht mehr
      tell_room("/d/dschungel/trintrasil/fluss/room/fluss13", 
        BSL("\nSCHWUPP! Da hat jemand von einem Felsturm neben Dir das "
            "Seil eingezogen das von ihm herab hing. Wenn Du auf diesen "
            "klettern willst musst Du nun einen Anker hinaufschleudern.\n"));
      write(BSL("\nDu rollst das Seil ein und steckst den Anker ein. Wenn Du "
                "hier wieder hinunterklettern willst musst Du nun erst wieder "
                "ein Seil auswerfen."));
      anker->SetProp("kletterhaken", 0);//anker ist kein kletterhaken mehr
      anker->SetProp(P_NOGET, 0);
      anker->move(TP, M_NOCHECK);
      say(BSL("\n"+TPN+" rollt das hinabhaengende Seil auf und steckt den Anker "
              "ein. Wenn Du hier wieder hinunterklettern willst musst Du erst "
              "wieder ein Seil auswerfen.")); 
      return 1;}
      
    if((anker)&&(anker->QueryProp("kletterhaken"))&&(kletterer)) {
    	
      write(BSL("\nDa ist gerade jemand auf diesem Seil. Du musst noch etwas "
               "warten."));
      return 1;}
      
    if((anker)&&(!anker->QueryProp("kletterhaken"))&&
       (anker->QueryProp("ankerseil"))) {
  
      write(BSL("\nDas Seil an diesem Anker ist ja gar nicht ausgeworfen. Du "
                "kannst ihn ganz einfach nehmen."));
      return 1;}
      
    if((anker)&&(!anker->QueryProp("ankerseil"))) {
      
      write(BSL("\nAn diesem Anker ist ja nicht einmal ein Seil befestigt. Du "
                "kannst ihn ganz einfach nehmen."));
      return 1;}
      
    if(!anker) {
      
      write(BS("Schau doch noch einmal. Wo siehst Du hier einen Anker mit "
               "einem Seil??"));
      return 1;}
    
    return 0;}
  return 0;}
  


klettererdef0() {
   kletterer=0;
    }
   
   

klettererdef1() {
   kletterer=1;
    }
   
   
      
kobold_wurf() {
 
  tell_room("/d/dschungel/trintrasil/fluss/room/turm",
        BSL("\nPloetzlich siehst Du von unten einen Gegenstand herauffliegen!"));
  call_out("kobold_wurf1", 2);
    }
  
  

kobold_wurf1() {

  tell_room("/d/dschungel/trintrasil/fluss/room/turm",
        BSL("\nDer Gegenstand trifft den Kobold genau am Kopf. Der kreischt "
            "zornig auf und verliert das Gleichgewicht!"));
  tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
        BSL("\nDu erkennst wie der Kobold auf dem Felsturm am Kopf getroffen "
            "wird und kreischend das Gleichgewicht verliert."));
  call_out("kobold_wurf2", 2);
  }
  
  
kobold_wurf2() {
	
  object kobold;
  kobold=present("kobold", TO);
        
        if(kobold) {
        	
  tell_room("/d/dschungel/trintrasil/fluss/room/turm",
        BSL("\nDer Kobold stuerzt mit den Armen rudernd vom Felsturm!"));

  kobold->move("/d/dschungel/trintrasil/fluss/room/fluss13", M_GO+
               M_SILENT);
  tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
        BSL("\nEin Kobold klatscht kreischend ins Wasser."));  
        }
    
        if(!kobold) {
//sollte nicht vorkommen koennen weil vorher die presenz des kobolds 
//abgefragt wird 
        	
        	tell_room("/d/dschungel/trintrasil/fluss/room/turm",
        	BSL("\nNanu wo ist denn der Kobold hin? Eben war er noch da!"));
        	tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
        	BSL("\nNanu wo ist denn der Kobold auf dem Felsturm hin? Eben "
        	"war er noch da!"));
        }
}
        	
    
    
//++++++++++++++++++ SPECIAL DETAILS +++++++++++++++++++++++++++++++++++++++++++++  

fluss() {
	
object anker;
anker=present("anker", TO);	
	
	if( anker && anker->QueryProp("kletterhaken") ) {
		return BS("Der gruene Fluss umspuelt ca 7 Meter unter Dir den "
		"Felsturm. Das sanfte Gurgeln mit dem er die Felssaeulen "
		"umstreicht klingt bis zu Dir herauf. Zwischen den Steinen ist "
		"ein Anker verhakt an dem ein Seil befestigt ist "
		"an dem Du wieder nach unten klettern kannst.");
	}
	
	else {
		return BS("Der gruene Fluss umspuelt ca 7 Meter unter Dir den "
		"Felsturm. Das sanfte Gurgeln mit dem er die Felssaeulen "
		"umstreicht klingt bis zu Dir herauf. Wenn Du wieder nach unten "
		"klettern willst musst Du erst ein Kletterseil auswerfen.");
	}
}

	 
oberseite() {

object anker;
anker=present("anker", TO);
	
	if( anker && anker->QueryProp("kletterhaken") ) {
		return BS("Du stehst auf der flachen Oberseite des Felsturmes. "
		"Der Boden ist vom Wind und dem Fluss der ihn einst umspuelte "
		"recht glatt poliert. Jemand hat hier einige Steine "
		"heraufgebracht. Ausserdem liegen Graeten herum. Zwischen den "
		"Steinen ist ein Anker verhakt an dem ein Seil festgebunden ist "
		"an dem Du wieder hinunter klettern kannst.");
	}
	
	else {
		return BS("Du stehst auf der flachen Oberseite des Felsturmes. "
		"Der Boden ist vom Wind und dem Fluss der ihn einst umspuelte "
		"recht glatt poliert. Jemand hat hier einige Steine "
		"heraufgebracht. Ausserdem liegen Graeten herum.");
	}
}
  
     
seilunt() {
	
  if(seil==2) {
  	return BS("Vorsicht! Da wirft gerade jemand ein Seil vom Fluss "
  	          "herauf.");
  	        }
  	        
  if(seil==1) {
  
    return BS("An dem Anker der zwischen den Steinen verhakt ist ein "
              "Seil festgebunden, das zum Fluss hinunter haengt. Du koenntest "
              "daran hinunterklettern.");
              }   

  if((seil==0)&&(!present("anker", TO))&&(!present("seil", TO))) {
    
    return BS("Du siehst hier auf dem Felsturm nirgendwo einen Anker oder ein "
              "Seil.");
              }

  if((seil==0)&&(!present("anker", TO))&&(present("seil", TO))) {
  	
    return BS("Ein Seil liegt zusammengerollt hier oben. Aber es ist kein "
              "Kletterseil ausgeworfen.");
              }

  if((seil==0)&&(present("anker", TO))&&(!present("seil", TO))) {
  	
    return BS("Ein Anker liegt zwischen den Steinen. Aber es ist kein "
              "Kletterseil ausgeworfen.");
              }
         
  if((seil==0)&&(present("anker", TO))&&(present("seil", TO))) {
  	
    return BS("Anker und Seil liegen hier oben auf dem Felsturm. Aber es ist "
              "kein Kletterseil ausgeworfen.");
              }     
           }



kobold() {
  if(present("kobold", TO)) {
    
    return BS("Schau doch, das haessliche Kerlchen steht direkt vor Dir.");
        }
        
  if(!present("kobold", TO)) {//waere interessant die namen der noch anwesenden anzufuehren
  	
    return BS("Du siehst hier sonst niemanden.");
        }
      }
 
 
graeten() {
  if(present("kobold", TO)) {
  	
    return BS("Fisch scheint dem Kobold besonders zu schmecken.");
        }
  if(!present("kobold", TO)) {
  	
    return BS("Jemandem scheint Fisch ganz besonders zu schmecken.");
        }
      }
      
  
     
