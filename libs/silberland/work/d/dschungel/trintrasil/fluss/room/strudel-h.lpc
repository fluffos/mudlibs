//fertig und getest

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";



create()
{
  ::create();

  SetProp( P_INT_SHORT, "kurz vor dem Ertrinken" );
  SetProp( P_INT_LONG, BS(
  "Sollte niemand sehen."));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
int no() {
	
	write(BSL("\nWasser dringt Dir in Mund und Nase.\n"));
return 1;}


int njet() {
	
	write(BSL("\nDu spuerts Deinen Koerper nicht mehr. Bist Du vielleicht "
	"schon tot!?\n"));
return 1;}

   
  init()
  {::init();

  if(query_once_interactive(this_player())){
  call_out("strudel1", 2);}
  }
  

strudel1() {
   	
   	NIX
        write(BSL("     !!!PLATSCH!!!\nDu versinkst augenblicklich wie ein "
        "Stein.\n"));
        tell_room("/d/dschungel/trintrasil/fluss/room/fluss5", BSL("\n"+TPN+" "
        "versinkt beinahe augenblicklich im Fluss.\n\n"));
        call_out("strudel2", 2);
}

   
strudel2() {
	
	NIX
	write(BSL("\nDu schlaegst verzweifelt mit den Armen, kommst in der "
	"starken Stroemung aber nicht mehr an die Oberflaeche.\n"));
        call_out("strudel3", 2);
}

 
strudel3() {
	
	NIX
	write(BSL("\nDu schlaegst mit dem Brustkorb gegen einen Felsen.\n"));
        call_out("strudel4", 2);
}

 
strudel4() {
	
	NIX
	write(BSL("\nWasser dringt Dir in Mund und Nase, Du verlierst die "
	"Orientierung.\n"));
	call_out("strudel5", 2);
}


strudel5() {
	
	NIX
	write(BSL("\nDir wird schwarz vor den Augen, das ist jetzt wohl das "
	"Ende.\n"));
	RemoveCmd("", "no");
        AddCmd("", "njet", 1);
        call_out("strude6", 5);
        }
    
    
    
strude6() {
	
	NIX
	tell_room("/d/dschungel/trintrasil/dorfneu/room/room9.lpc", BSL("\n"+TPN+" "
        "wird vom Fluss angespuelt.\n\n"));
        write(BSL("\nHustend und wasserspuckend kommst Du langsam wieder zu "
        "Dir.\nAnscheinend bist Du gluecklicherweise an Land gespuelt "
        "worden.\n\n"));
        TP->move("/d/dschungel/trintrasil/dorfneu/room/room9.lpc", M_GO+ M_NO_SHOW+
        M_SILENT);
        RemoveCmd("","njet");
        AddCmd("","no", 1); 
}
   
     
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/dorfneu/room/room9.lpc",M_GO+ M_SILENT+
	M_NO_SHOW);
        tell_room("/d/dschungel/trintrasil/dorfneu/room/room9.lpc", BSL("\n"+TPN+" "
        "wird vom Fluss angespuelt.\n\n"));
return 1;}

  
  