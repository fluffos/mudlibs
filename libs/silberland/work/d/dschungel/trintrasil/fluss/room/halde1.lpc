#include <properties.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <ansi.h>

#define HALDE2 "/d/dschungel/trintrasil/fluss/room/halde2"

inherit "/std/room";


reset() {
   ::reset();
   }
   
void create()
{
  ::create();



  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
  "Kantige und unfoermige Felsbrocken bilden hier eine bizarre, steile Rampe. "
  "Vorsichtig musst Du um eine lose Felsplatte herumklettern. Ober Dir scheint "
  "die Schutthalde, unterhalb der Bruchstelle, in eine flache Kuppe zu zulaufen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );  
 
  AD(({"fisch","junge","schwachsinn"}),
    "Der Junge klettert hier sicher nicht herauf. Der tut sich solchen Schwachsinn nicht an.");
      
  AD(({"felsplatte","platte"}),
    "Die Platte sieht sehr lose aus. Du solltest besser auf einen anderen "
    "Felsbrocken steigen.");
  
  AD(({"felsbrocken","brocken","steine","boden","geroell"}),
    "Die ausgebrochenen Steine sind teilweise nur lose ineinander verkeilt und "
    "koennten leicht losbrechen. Nur wenig Erde hat sich zwischen den "
    "Steinen angesammelt.");
    
  AD(("erde"),
    "Obwohl die Schutthalde sehr steinig ist hat ein keummerlicher Graetenbusch "
    "hier genug Halt gefunden.");
    
  AD(("halt"),
    "Der kleine Graetenbusch kann sich hier halten. Aber die Felsplatte sieht "
    "alles andere als geheuer aus. Wenn Du hier abstuerzt koennte das harte "
    "Folgen haben.");
  
  AD(("folgen"),
    "Wenn Du hier abstuerzt fallst Du die gesamte steile Schutthalde hinunter.");
      
  AD(({"rampe","schraege","zaehne"}),
    "Diese Schraege aus orange-gelben Splittern und Truemmern ist ein "
    "Sammelsurium an Formen und Kanten.");
  
  AD(("sammelsurium"),
    "Wie eckige Zaehne glaenzen scharfe Kanten und Spitzen in der Sonne.");
  
  AD(({"spitzen","spitze"}),
    "Pass auf das Du auf keine von ihnen trittst.");
    
  AD(({"fluss","rio de la puseta","stueck","rio","puseta"}),
    "Der Fluss liegt schon ein schoenes Stueck unter Dir");  
    
  AD(({"formen","kanten","stein","steine"}),
    "Kein Stein sieht gleich aus wie der andere.");

  AD(({"truemmer","splitter"}),
    "Mit etwas Anstrengung muesstest Du ueber die Steine noch weiter "
    "hinaufklettern koennen.");
  
  AD(("anstrengung"),
    "Wenn Du nach oben kletterst solltest Du lieber nicht auf die wackelige "
    "Felsplatte steigen.");

  AD(({"bruchstelle","stelle","felswand","wand"}),
    "Ueber Dir befindet sich die Stelle wo das Geroell aus der Felswand "
    "gebrochen ist.");
  
  AD(({"felswaende","schluchtwaende","uferwaende","waende","sandsteinwaende"}),
    "Die gewaltigen Schluchtwaende sind aus gelben Sandstein und schimmern in einem sanften, "
    "warmen Gelb.");

  AD(({"sandstein","gelb"}),
    "Der gelbe Sandstein wurde von Wind und Wasser ganz glatt poliert.");

  AD(("wind"),
    "Der Wind pfeift ueber die steile Schutthalde.");
  
  AD(("wasser"),
    "Der Rio de la Puseta rauscht unter Dir durch die Schlucht.");
    
  AD(("himmel"),
    "Der Himmel ist nahezu wolkenlos.");
    
  AD(("sonne"),
    "Auf dieser kahlen Schutthalde brennt die Sonne unangenehm auf Dich "
    "herab.");
    
  AD(({"schutthalde","halde"}),
    "Die Schutthalde faellt unter Dir weit bis zum Fluss hin ab.");
    
  AD(("gekreische"),
    "Der Fischadler kreischt boese zu Dir herab.");
  
  AD(({"felsen","fels"}),
    "Einige grosse, kantige Felsen liegen auf der Kuppe der Schutthalde.");

  AD(("schlucht"),
    "Die gewaltigen, gelben Sandsteinwaende der Schlucht fassen den gruene Fluss ein.");

  ASD(({"tier"}),
    "tier");
    
  ASD(("kuppe"),
    "kuppe");
  
  ASD(({"fischadler","adler"}),
    "adler");
      
  ASD(("nest"),
    "nest");
     
       
  AddCmd(({"steige","steig"}), "func_geroell");
  
  
  AddExit("oben", "./halde2");
  
  AddExit("unten", "./halde");


  AddItem("/d/dschungel/trintrasil/fluss/obj/graetenbusch", REFRESH_DESTRUCT);
 
  AddSound( DEFAULT_SOUND,
   "Ober Dir hoerst Du das Gekreische eines Fischadlers.");
 
  AddSound(({"gekreische","fischadler","adler"}),
   "!!KRAA KRAAAAA!!");     
}


int func_geroell(string str) {
	
	object sto;
	int i;
	object *inv;
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" loest eine lawine aus in halde1.\n");
	
	notify_fail("Auf was willst Du steigen?\n");
	
	if(str=="auf felsplatte"||str=="auf felsbrocken"||str=="auf brocken"||
	str=="auf platte"||str=="auf fels") {
		
		tell_room("/d/dschungel/trintrasil/fluss/room/fels",
		BSL("\nWWWWWUUUUUMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM\n"
		"Eine Steinlawine poltert von oben herab."));
		call_other("/d/dschungel/trintrasil/fluss/room/fels", "lawine");
		write(BSL("\n!!WUUMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM!!\n"
		"Wie Du Dir schon dachtest ist die Felsplatte nicht ganz stabil. "
		"Mit einem lautem Poltern krachst Du die Schutthalde hinunter und "
		"schlaegst in einem Steinhagel auf einem Felsen auf."));
		SP(P_KILL_NAME, "Eine Steinlawine");
		TP->do_damage(20+ random(37));
		tell_room("/d/dschungel/trintrasil/fluss/room/halde",
		BSL("\n!!WWWWUUUUUMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM!!\n"
		""+CAP(getuid(TP))+" loest ober Dir eine Steinlawine aus. Der Steinhagel "
		"poltert von oben auf Dich herab und reisst Dich mit nach unten!!!"));
		call_other("/d/dschungel/trintrasil/fluss/room/halde", "lawine");
		TPM("/d/dschungel/trintrasil/fluss/room/fels", M_TPORT+M_NO_SHOW,
		"mit lautem Krachen eine Steinlawine aus und stuerzt nach unten", "loest", 
		"kommt von oben herab gestuerzt");
		tell_room("/d/dschungel/trintrasil/fluss/room/halde1",
		BSL("\nWWWWWUUUUUMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM!!\n"
		""+TPN+" loest eine Steinlawine aus, die Dich mit nach unten "
		" reisst."));   
		
		inv=all_inventory(this_object());
		
		for(i=sizeof(inv)-1;i>=0;i--) if(living(inv[i])) { 
			
			inv[i]->move("/d/dschungel/trintrasil/fluss/room/fels", M_GO+M_NO_SHOW,
			"von der Lawine nach unten gerissen","wird", "stuerzt von oben herab");  
			inv[i]->do_damage(25 +random(23));
		}
		
		sto=clone_object("/d/dschungel/trintrasil/fluss/obj/rock.lpc");
		sto->move("/d/dschungel/trintrasil/fluss/room/fels.lpc", M_TPORT);
		sto->SP(P_LONG, BS("Diesen Stein hat "+CAP(getuid(TP))+" losgetreten."));
		return 1;
	}
	return 0;
}



nest() {
	
  if(HALDE2->adlerpresent()==1) {
   return BS("Unterhalb der Bruchstelle hat der Fischadler sein Nest gebaut. Er "
             "hat Dich anscheinend schon entdeckt und kreischt nervoes.");
        }
        
  if(HALDE2->adlerpresent()==0) {
   return BS("Unterhalb der Bruchstelle hat ein Fischadler sein Nest gabaut.");
        }
}


kuppe() {
  
  if(HALDE2->adlerpresent()==1) {
   return BS("Zwischen einigen groesseren Felsen auf der Kuppe flattert ein "
             "anscheinend aufgeregtes Tier.");
             }
  
  if(HALDE2->adlerpresent()==0) {
   return BS("Auf der abgeflachten Kuppe liegen einige groessere Felsbloecke.");
             }
           }


tier() {
  
  if(HALDE2->adlerpresent()==1) {
   return BS("Ein aufgeregter Fischadler huepft zwischen den Felsen umher.");
             }
  
  if(HALDE2->adlerpresent()==0) {
   return BS("Welches Tier meinst Du?");
             }
           } 


adler() {
  
  if(HALDE2->adlerpresent()==1) {
   return BS("Der Adler bewacht etwas das wie ein Nest aussieht.");
             }
  
  if(HALDE2->adlerpresent()==0) {
   return BS("Welchen Adler meinst Du?");
             }
           }