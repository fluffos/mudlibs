int get_ranke(string str)  {
	
	object stock;
	stock=present("stock", TP);
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" holt die Ranke im Nest herunter.\n");
	
	NF("Was willst Du herunter holen?! Die Ranke? syntax: <ranke herunter>\n");
	
	if(str=="ranke herunter")  {
		
		if(!stock)  {
			
			write(BS("Ohne Hilfsmittel kannst Du die Ranke nicht "
			"erreichen.\n"));
			return 1;
		}
		
		if(!stock->QueryWielded()) {
			
			write(BS("Du hast zwar einen Stock, aber den musst Du erst "
			"zuecken!\n"));
			return 1;
		}
		
		if(stock->QueryWielded()) {
			
			if(ranke_unten) {
				
				write(BS("Die Ranke ist schon herunten!\n"));
				return 1;
			}
			
			if(!ranke_unten) {
				
				write(BS("Du holst die Ranke mit dem Stock herunter!\n"));
				say(BS(""+TPN+" holt eine Ranke mit einem Stock "
				"herunter.\n"));
				ranke_unten=1;
				AddExit(""+ANSI_GREEN+"ranke"+ANSI_NORMAL+"", ([
				EX_FUNC:"kletterei"]));
				return 1;
			}
			return 0;
		}
		
		else  {
			write(BS("Du hast zwar einen Stock, aber der ist nicht "
			"gezueckt!\n"));
			return 1;
		}
		return 0;
	}
	return 0;
}

 

kletterei() {
	
	write(BSL("\nDu umfasst eine Ranke und beginnst vorsichtig daran hoch zu klettern."));
	say(BSL("\n"+TPN+" umfasst eine Ranke und beginnt daran hoch zu klettern.\n"));
	TP->move("/d/dschungel/trintrasil/fluss/room/ranke-h", M_TPORT+ 
	M_SILENT+ M_NO_SHOW);
	return 1;
}

           
           
               
int func_ei(string str) {
	
	object schalen;
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" durchwuehlt das Nest.\n");
	
	notify_fail( "Was willst Du durchwuehlen?\n");
	
	if(str=="gras"||str=="haufen"||str=="grashaufen"||str=="gras ganz"||
	str=="haufen ganz"||str=="grashaufen ganz") {
		
		if(schale) {
			
			schalen=CLONEOB("/d/dschungel/trintrasil/fluss/obj/schalen.lpc");
			
			if(schalen->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
				
				write(BS("Du findest ein paar Eierschalen, aber sogar die "
				"sind Dir zu schwer! Schwaechling!"));
				schalen->move(ENV(TP), M_NOCHECK);
			}
			
			else {
				write(BS("Du findest ein paar alte Eierschalen und steckst "
				"sie ein.\n"));
				say(BS(""+TPN+" findet ein paar Eierschalen im Adlernest.\n"));
				schalen->move(TP, M_GET+ M_SILENT);
			}
			
			schale--;
			return 1;
		}
		
		if(!schale) {
			
			write(BS("Den Haufen hat leider schon vor Dir wer durchwuehlt.\n"));
			say(BS("durchwuehlt einen Haufen, findet aber nichts.\n"));
		}
		return 1;
	}
	return 0;
}


int func_stock(string str) {
	 
	 object ob;
	 notify_fail("Was willst Du durchsuchen?\n");
	 
	 if(str=="nest"||str=="brutstaette"||str=="staette"||str=="nest nach stock"||
	 str=="brutstaette nach stock"||str=="staette nach stock") {
	 	
	 	if(stock)  {
	 		
	 		ob=clone_object("/d/dschungel/trintrasil/fluss/obj/stock.lpc");       
	 		
	 		if(ob->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
	 			
	 			write(BS("Du findest im Nestunterbau einen Stock der ca 1 "
	 			"meter lang ist. Der Stock ist Dir aber zu schwer."));
	 			ob->move(TO, M_NOCHECK);
	 		}
	 		
	 		else {
	 			write(BS("Du findest im Nestunterbau einen Stock der ca 1 "
	 			"meter lang ist. Zum Glueck faellt das Nest dadurch nicht "
	 			"auseinander.\n"));
	 			say(BS(""+TPN+" zieht einen Stock aus dem Nest heraus.\n"));
	 		}
	 		stock--;
	 	}
	 	
	 	if(!stock)   {
	 			
	 		write(BS("Sieht so aus als haette hier schon jemand einen "
	 		"Stock aus dem Nest gerissen!\n"));
	 		say(BS(CAP_TPN+" durchsucht das Nest, findet aber nichts!\n"));
	 	}
	 	return 1;
	 }
	 return 0;
}
	
//000 Funktionen die von Raum /d/dschungel/trintrasil/plateau/room/plateau1 aufgerufen werden 000000000000


int rankenstatus() {
	
	if(ranke_unten==0) {
		
		return 0;
	}
	
	if(ranke_unten==1) {
		
		return 1;
	}
}


ranke_down() {//bringt ranke hinunter
	
	if(ranke_unten==1) {//nur sicherheitsabfrage (sollte nicht eintreten koennen)
		
		return 0;
	}
	
	else {
		ranke_unten=1;
		AddExit(""+ANSI_GREEN+"ranke"+ANSI_NORMAL+"", ([EX_FUNC:"kletterei"]));
	}
}



//++++++++++++++++++++++++++++++  Special Details +++++++++++++++++++++++++++++++++++++++++++++++++++++++	


ranke()  {
  if(ranke_unten)  {
  	
  return BS("Die Ranke haengt tief herunter, sodass man an ihr "
            "hochklettern kann!");
  }
  if(!ranke_unten)  {
  	
  return BS("Die Ranke haengt sehr hoch oben! Mit einem Stock koennte man "
            "sie aber sicher herunter holen!");
  }  
}

dschungel() {
	
  if(!ranke_unten) {
  	
  return BS("Der direkt ueber Dir liegende Dschungel ist hinter dem Rand der "
            "Schlucht verborgen, aber da haengt doch etwas von oben herab.");
  }
  if(ranke_unten) {
  	
  return BS("Der direkt ueber Dir liegende Dschungel ist hinter dem Rand der "
            "Schlucht verborgen. Eine beinahe armdicke Ranke haengt von oben "
            "herab.");
  }
}

  etwas() {
  	
  if(!ranke_unten) {
  	
  return BS("Es sieht aus wie eine Ranke, aber sie haengt zu weit oben um sie "
            "ohne Hilfsmittel erreichen zu koennen.");
  }
  if(ranke_unten) {
  	
  return BS("Eine armdicke recht stabil aussehende Ranke haengt von "
            "oben herab.");
  }
}