#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


int anker=1;
int tier_int=1;
int ei=3;

reset() {
::reset();
anker=1;
tier_int=1;
ei=3;}


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, BS(
    "Der Rio de la Puseta windet sich hier gemaechlich durch sein in den "
    "Sandstein gegrabenes Bett von Norden nach Suedosten. Rund gewaschene "
    "Felstuerme stehen wie starre, ernste Waechter an die steilen Uferwaende "
    "gedraengt."));
    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Der Rio de la Puseta windet sich dem Meer entgegen.");
    
  AD(("himmel"),
    "Zwischen den Raendern der Uferwaende kannst Du die Sonne kaum erkennen.");
    
  AD(("sonne"),
    "Die Sonne wird durch die hohen Uferwaende abgeschirmt wodurch in der "
    "Schlucht tiefe Schatten herrschen.");
       
  AD(({"rand","raender"}),
    "Der Rand ist weit ober Dir.");
    
  AD( ({"meer","kontinent"}),
    "Der Fluss muendet auf der noch kaum erforschten Suedseite "
    "des Kontinentes ins Meer.");
    
  AD(({"suedseite","seite"}),
    "Du wirst sie sehen wenn Du weiter stromabwaerts schwimmst.");
  
  AD(({"sandstein","gestein","stein","fels"}) ,  
    "Der weiche Sandstein leuchtet in sanftem Gelb.");
    
  AD(({"lauf","zeit"}),
    "Mit der Zeit hat sich der Rio de la Puseta ein tiefes Bett in den "
    "Sandstein gegraben.");
    
  AD(({"bett","flussbett"}),
    "In seinen ersten Jahren muss der Fluss einmal auf der Oberflaeche geflossen "
    "sein.");
    
  AD(("oberflaeche"),
    "Weit ober Dir befindet sich der Dschungel in dessen Grundgestein sich der "
    "Fluss diese Schlucht gefressen hat.");
    
  AD(("grundgestein"),
    "Das Grundgestein wird hier offensichtlich aus weichem Sandstein gebildet. "
    "Wie weit sich der Fluss wohl noch in die Tiefe fressen wird?");
    
  AD(("dschungel"),
    "Der Dschungel liegt nun ca 200 meter ueber Dir.");
 
  AD(("tiefe"),
    "Vielleicht befindet sich in tieferen Schichten haerteres Gestein.");
    
  AD(({"schicht","schichten"}),
    "Die Schlucht bietet Dir die Moeglichkeit die freigewaschenen Schichten zu "
    "betrachten.");
    
  AD(("moeglichkeit"),
    "Anhand der Faerbung der Felswaende erkennst Du das der Sandstein "
    "unterschiedliche Dichten aufweist.");
    
  AD(({"dichten","dichte"}),
    "Fester gepresste Schichten sind dunkler als weichere."),
    
  AD(("jahre"),
    "Damals hat hier wohl noch alles anders ausgeschaut.");
    
  AD(({"tuerme","felstuerme","felsturm","turm"}),
    "Dir erscheinen die farbigen Felstuerme die der Fluss ausgespuelt "
    "hat wie Waechter. Im Lauf der Zeit hat sie der Fluss vollkommen "
    "glatt und rund gescheuert.");
  
  AD(({"waechter","felssaeulen","saeulen","standbilder","bilder"}),
    "Staunend reitest Du auf Deinem Fisch zwischen all den vom "
    "Fluss freigewaschenen und vom Wind polierten Formen hindurch.");
    
  AD(({"wind"}),
    "Wie gelb-orange gestreifte vom Wind polierte Standbilder "
    "schauen die stummen Felstuerme auf den Fluss herab.");
  
  AD(("formen"),
    "Als Du die ungewoehnlich geformten Felssaeulen bewunderst "
    "faellt Dir die oestliche Uferwand auf.");
     
  AD(({"uferwand","wand","oestliche uferwand","oestliche wand"}),
    "Die steilen Uferwaende ragen in gelb-orangen Toenen neben Dir auf. "
    "Hinter einem der Felstuerme bemerkst Du eine Bewegung.");
    
  AD(({"bewegung"}),
    "Mit einem leisen Plaetschern schwimmt etwas zwischen den Felstuermen "
    "umher.");
  
  AD(({"etwas","plaetschern"}),
    "Als Du hinter einen Felsturm schaust wer das Plaetschern verursacht, "
    "entdeckst Du halb unter der Wasseroberflaeche liegend eine kleine "
    "Hoehle.");
    
  AD(({"hoehle","loch"}),
    "Die Hoehle ist zum betreten viel zu klein. Aber Du kannst trotzdem in sie "
    "hinein schauen.");
    
  AD(({"wasseroberflaeche"}),
    "Das Loch liegt halb unter dem Wasser und ist gerade gross genug um "
    "hinein zu schauen.");
  
  AD(("wasser"),
    "Das Wasser schillert smaragdgruen.");
    
  AD(({"uferwaende","waende","felswaende"}),
    "Die glatten, hohen Uferwaende ragen steil neben Dir auf. "
    "Durch ihre Hoehe liegt der Fluss in einem angenehm kuehlen "
    "Schatten.");
  
  AD(({"schatten"}),
    "In der schattigen Schlucht ist es angenehm kuehl.");
    
  AD(({"schlucht","bogen"}),
    "Die Schlucht verlaeuft in einem leichten Bogen von Norden nach Suedosten.");
    
  AD(("hoehe"),
    "Die Waende ragen gute 200 meter vor Dir auf."); 
  
  AD(({"farbe","farbtoene","toene","gelb","faerbung"}),
    "Farbtoene von gelb bis orange ziehen sich durch den Sandstein.");

  AD(("boden"),
    "Du befindest Dich auf einem Fluss. Was erwartest Du?");

//SD-details
  AD(({"krebse","krebs","krebsschalen","krebsschale","schalen","schale","schnecken","schnecke","hauptnahrung"}),
    "Die Hauptnahrung des Schnabeltieres sind kleine Krebse und Schnecken.");
      
  AD(("erbauer"),
    "Der Erbauer dieses Nest ist ein Schnabeltier.");
    
  AD(({"zweige","flussgras","gras","zweig","material","materialien", "baumaterialien"}),
    "Die Baumaterialien sind kleine Zweige und Flussgras die das Schnabeltier "
    "Im Fluss gefunden hat.");
      
  ASD(({"schnabeltier","tier"}),
    "schnabel");
    
  ASD(({"nest","schnabeltiernest"}),
    "nest");
    
  ASD(("sicht"),
    "sicht");
    
  ASD(("glitzern"),
    "glitzern");
    
  ASD(("anker"),
    "anker");
    
  ASD(({"eier","ei"}),
    "ei");
    
    
  AddCmd(({"schaue","schau","schauen"}), "func_schnabel");
  
  AddCmd(({"nimm","nehmen","nehme"}), "func_nimm"); 
  
  
  NORD
  SUEDO


 AddSound( DEFAULT_SOUND,
   "Der Wind bricht sich stoehnend an den Felstuermen.");

 AddSound("wind",
   "Huuuuuuuiiiiiiihuuuuuuuuuiiiiiihiiiii!");
}

  
  NORDF(fluss8)
  SUEDOF(fluss10)
    
    
 int func_schnabel(string str)     {
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" hat die Hoehle in fluss9 entdeckt.\n");
	
  notify_fail("In was willst Du hineinschauen?\n");
  
  if(str=="in hoehle"||str=="in hoehle hinein"||str=="hoehle"||str=="loch"||
     str=="in loch"||str=="in loch hinein")
             {
             	
  if((tier_int)&&(anker))
                      {
  write(BS("In der kleinen Uferhoehle hat ein Schnabeltier sein Nest gebaut "
           "und scheint zu brueten. Hinter dem Schnabeltier faellt Dir ein "
           "seltsames Glitzern auf. Mehr kannst Du nicht erkennen, da Dir das "
           "unruhige Schnabeltier die Sicht verstellt."));
    say(BS(""+TPN+" scheint hinter einem Felsturm etwas zu suchen.\n"));

return 1; }


  if((!tier_int)&&(anker)&&(ei>0))
           {
  write(BS("In der kleinen Uferhoehle befindet sich ein verlassenes "
           "Schnabeltiernest in dem noch Eier liegen. Hinter dem Nest "
           "siehst Du einen kleinen rostigen Anker.\n"));
    say(BS(""+TPN+" scheint etwas hinter einem Felsturm zu suchen.\n"));
  
return 1;     }

  if((!tier_int)&&(!anker)&&(ei>0))
{
  write(BS("In der kleinen Uferhoehle befindet sich ein verlassenes "
           "Schnabeltiernest in dem noch Eier liegen.\n"));
    say(BS(""+TPN+" scheint etwas hinter einem Felsturm zu suchen.\n"));
    
return 1;}

  if((!tier_int)&&(anker)&&(!ei))
{
  write(BS("Hinter einem leeren Schnabeltiernest siehst Du einen kleinen "
           "rostigen Anker.\n"));
    say(BS(""+TPN+" sucht etwas hinter einem Felsturm.\n"));
    
return 1;}

  if((!tier_int)&&(!anker)&&(!ei))  
{
  write(BS("In der kleinen Uferhoehle befindet sich ein verlassenes, leeres "
           "Schnabeltiernest.\n"));
    say(BS(""+TPN+" scheint etwas hinter einem Felsturm zu suchen.\n"));
    
return 1;}
return 0;}
return 0;}


int func_nimm(string str) {
	
	object schnabelei, schnabeltier, ank, stier;
	
	stier=present("schnabeltier", environment(TP));
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" nimmt etwas aus der hoehle in fluss9.\n");
	
	notify_fail("Was willst Du aus dem Nest nehmen?\n");
	
	if(str=="ei"||str=="ei aus nest"||str=="eier"||str=="eier aus nest"||
	str=="eier weg"||str=="ei weg"||str=="schnabeltier eier weg"||
	str=="schnabeltier ei weg"||str=="tier eier weg"||str=="tier ei weg") {
		
		if(stier) {
			
			write(BS("Das Schnabeltier hackt Dir ins Bein!"));
			TP->do_damage(5);
			return 1; 
		}
		
		if( !stier && tier_int ) {
			
			schnabeltier=CLONEOB("/d/dschungel/trintrasil/fluss/npc/schnabeltier1.lpc");
			schnabeltier->move(environment (TP), M_TPORT);
			schnabeltier->Kill(TP);
			tier_int--;
			return 1;
		}
		
		if(!tier_int && ei>0 && anker) {
			
			schnabelei=CLONEOB("/d/dschungel/trintrasil/fluss/obj/schnabelei.lpc");
			
			if(schnabelei->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
				write(BS("Das Schnabeltierei ist Dir leider zu schwer. Du "
				"laesst es im Nest."));
				schnabelei->remove();
				return 1;
			}
			
			else {
				write(BS("Du nimmst ein kleines Schnabeltierei aus dem Nest "
				"und steckst es ein. Ausserdem siehst Du noch einen kleinen "
				"Anker hinter dem Nest.\n"));
				ei--;
				say(BS(""+TPN+" nimmt ein winziges Ei aus einer kleinen "
				"Hoehle.\n"));
				return 1;
			}
		}
		
		if( !tier_int && !ei && anker) {
			
			write(BS("Das Nest ist leider leer. Aber hinter dem Nest siehst Du "
			"einen kleinen Anker.\n"));
			say(BS(""+TPN+" greift in eine Hoehle.\n"));
			return 1;
		}
		
		if(!tier_int && ei>0 && !anker) {
			
			schnabelei=CLONEOB("/d/dschungel/trintrasil/fluss/obj/schnabelei.lpc");
			
			if(schnabelei->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
				write(BS("Das Schnabeltierei ist Dir leider zu schwer. Du "
				"laesst es im Nest."));
				schnabelei->remove();
				return 1;
			}
			
			else {
				write(BS("Du nimmst ein winziges Schnabeltierei aus dem Nest "
				"und steckst es ein.\n"));
				say(BS(""+TPN+" nimmt ein winziges Ei aus einer kleinen "
				"Hoehle.\n"));
				ei--;
				return 1;
			}
		}
		
		if(!tier_int && !ei && !anker) {
			
			write(BS("Das Nest und die uebrige Hoehle sind leider leer.\n"));
			say(BS(""+TPN+" stoebert in einer kleinen Hoehle herum.\n"));
		}
		
		if(tier_int) {
			
			write(BS("Im Nest sitzt doch noch das Schnabeltier!\n"));
			say(BS(""+TPN+" scheucht ein Tier aus einer kleinen Hoehle auf.\n"));
		}
		return 1;
	}
	
//nimm anker aus nest usw!!!!!!!!!
        if(str=="anker aus nest"||str=="anker"||str=="anker aus hoehle"||
        str=="anker aus hoehle heraus"||str=="anker aus loch"||
        str=="anker aus nest heraus"||str=="anker aus loch heraus") {
        	
        	if(stier)   {
        		
        		write(BS("Das Schnabeltier hackt Dir ins Bein!"));
        		TP->do_damage(5);
        		return 1; 
        	}
        	
        	if(!stier && tier_int) {
        		
        		write(BS("Als Du in das Loch greifst gurrt Dich das Schnabeltier "
        		"boese an.\n"));
        		say(BS(""+TPN+" greift in eine kleine Hoehle und weicht erschrocken "
        		"zurueck.\n"));
        		schnabeltier=CLONEOB("/d/dschungel/trintrasil/fluss/npc/schnabeltier1.lpc");
        		schnabeltier->move(environment(TP), M_TPORT);
        		schnabeltier->Kill(TP);
        		tier_int--;
        		return 1;
        	}
        	
        	if(!tier_int && anker && ei>0) {
        		
        		ank=CLONEOB("/d/dschungel/trintrasil/fluss/obj/anker.lpc");
        		if(ank->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
        			write(BS("Der Anker ist Dir leider zu schwer."));
        			ank->remove();
        			return 1;
        		}
        		else {
        			write(BS("Du greifst in die Hoehle und tastest im Nest herum. "
        			"Hinter dem Nest findest Du einen Anker und nimmst ihn gleich "
        			"heraus. Ausserdem liegen da noch Eier im Nest.\n"));
        			say(BS(""+TPN+" greift in eine kleine Hoehle.\n"));
        			anker--;
        			return 1;
        		}
        	}
        	
        	if(!tier_int && anker && !ei) {
        		
        		ank=CLONEOB("/d/dschungel/trintrasil/fluss/obj/anker.lpc");
        		if(ank->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY) {
        			write(BS("Der Anker ist Dir leider zu schwer."));
        			ank->remove();
        			return 1;
        		}
        		
        		else {
        			write(BS("Du greifst in die Hoehle und tastest im Nest "
        			"herum. Hinter dem leeren Nest findest Du einen Anker und "
        			"nimmst ihn gleich heraus.\n"));
        			say(BS(""+TPN+" greift in eine kleine Hoehle.\n"));
        			anker--; 
        			return 1;
        		}
        	}
        	
        	if(!tier_int && !anker && ei>0) {
        		
        		write(BS("Du greifst in die Hoehle und und ertastest im Nest noch ein "
        		"paar Schnabeltiereier.\n"));
        		say(BS(""+TPN+" greift in eine kleine Hoehle.\n"));
        		return 1;
        	}
        	
        	if(!tier_int && !anker && !ei) {
        		
        		write(BS("Du greifst in die Hoehle, aber das Nest und die restliche "
        		"Hoehle sind leider leer.\n"));
        		say(BS(""+TPN+" greift in eine kleine Hoehle.\n"));
        		return 1;
        	}
        	return 1;
        }
}


schnabel()
{
  if(tier_int)
{
  return BS("Das Schnabeltier scheint zu brueten und fuehlt sich von Dir "
           "bedroht. Willst Du ihm die Eier einfach wegnehmen?");
           

}
  if(!tier_int)
{
  return BS("Das Nest ist verlassen. Anscheinend hat das Tier jemand verjagt.");
}
}


nest()
{

  if(tier_int)
{
  return BS("Ein Schnabeltier hat in der kleinen Hoehle sein Nest gebaut. Es "
            "funkelt Dich unruhig an und fuehlt sich anscheinend von Dir "
            "bedroht.");
}


  if((!tier_int)&&(ei))
{
  return BS("Das Nest ist von seinem Erbauer verlassen. Zwischen den Schalen "
            "kleiner Krebse und Schnecken siehst Du noch ein paar winzige Eier.");
}


  if((!tier_int)&&(!ei))
{
  return BS("Das Nest aus kleinen Zweigen und Flussgras ist verlassen und leer.");
}



}



sicht()
{
  if(tier_int)
{
  return BS("Das Schnabeltier drueckt sich schuetzend auf sein Nest und gurrt "
            "Dich nervoes an.");
}
  if(!tier_int)
{
  return BS("In dem Nest ist kein Tier mehr das Dir die Sich versperren koennte.");
}
}


glitzern()
{
  if(tier_int)
{
  return BS("Hinter dem bruetenden Schnabeltier siehst Du ein metallisches "
            "Glitzern. Mehr kannst Du leider nicht erkennen da Dir das Tier "
            "die Sicht versperrt.");
}
  if((!tier_int)&&(anker))
{
  return BS("Das Glitzern kommt von einem schon etwas rostigen Anker hinter dem "
            "Schnabeltiernest.");
}
  if((!tier_int)&&(!anker))
{
  return BS("Die Hoehle hinter dem Nest ist leer.");
}
}





anker()
{
  if(tier_int)
{
  return BS("Du siehst keinen Anker in der Hoehle. Das boese gurrende "
            "Schnabeltier versperrt Dir die Sicht.");
}
  if((!tier_int)&&(anker))
{
  return BS("Hinter dem verlassenen Nest liegt ein schon etwas rostiger "
            "Anker.");
}
  if((!tier_int)&&(!anker))
{
  return BS("Die Hoehle hinter dem Nest ist leer. Du findest hier keinen Anker.");
}
}





ei()
{
  if(tier_int)
{
  return BS("Das bruetende Schnabeltier gurrt Dich nervoes an. Wenn Du die Eier "
            "wegnehmen willst greift es Dich sicher an.");
}


  if((!tier_int)&&(ei>1))
{
  return BS("In dem Schnabeltiernest siehst Du "+ei+" kleine Eier.");
}



  if((!tier_int)&&(ei==1))
{
  return BS("In dem verlassenen Nest siehst Du ein winziges Schnabeltierei.");
}
  if((!tier_int)&&(!ei))
{
  return BS("Das verlassene Nest ist bis auf ein paar Krebsschalen leer.");
}
}
