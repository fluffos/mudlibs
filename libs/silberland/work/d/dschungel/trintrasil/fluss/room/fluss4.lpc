#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"

int schaedelzahl=1;

reset() {
	schaedelzahl=1;
	::reset();
}
			
void create()
{
  ::create();

fluss_details();//includiert die fluss_details aus stdriopuseta
jagdgebiet();//markiert diesen raum als jagdgebiet fuer fische mittels fischspeer

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Fluss fliesst ruhig durch die tiefe, gewaltige Sandsteinschlucht. Das "
"Wasser schimmert tuerkis im daemmrigen Schatten der gelben Schluchtwaende. Nur "
"an manchen Stellen hat das Wasser eine dunkelgruene, undurchsichtige Farbe. "
"Weiter im Westen kannst Du einen grossen Wasserfall ausmachen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
  SetProp(P_NAME, "RAUM4");
	 
AD(({"fluss","rio","rio de la puseta","puseta"}),
  "Das Wasser des Rio de la Puseta schimmert smaragdgruen. An manchen Stellen "
  "ist das Wasser dunkel und undurchsichtig. Der Fluss fliesst gemaechlich nach "
  "Osten.");
  
AD(("schatten"),
  "Die maechtigen Sandsteinwaende werfen angenehm kuehle Schatten ueber den "
  "Fluss.");
  
AD(({"farbe","wasser"}),
  "An den dunklen Stellen im Wasser scheint Flussgras zu wachsen.");
  
AD(("stellen"),
  "An den dunklen Stellen waechst dichtes Flussgras.");
  
AD(({"flussgras","gras","faeden","grasfaeden"}),
  "An einer Stelle waechst das Flussgras nur knapp unter der Oberflaeche.");
  
AD(({"wasseroberflaeche","flaeche","oberflaeche"}),
  "Die Wasseroberflaeche des Rio de la Puseta schimmert smaragdgruen. Nur "
  "manchmal kraeuselt sich die ansonsten ruhige Oberflaeche.");
  
AD(("stelle"),
  "An einer Stelle wogt das dicke schwarze Flussgras so knapp unter der "
  "Wasseroberflaeche, dass Du es mit der Hand erreichen koenntest.");
  
AD(("hand"),
  "Na sowas! Schimmert da nicht etwas weiss zwischen den dunklen Grasfaeden.");

ASD(("etwas"),
  "etwas");
  
ASD(("schaedel"),
  "schaedsabre");

AD(({"wasserfall","fall"}),
  "Du hoerst den Wasserfall im Westen bis zu Dir her rauschen.");
  
AD(({"himmel"}),
  "Hoch ueber Dir weiter westlich kannst Du eine Haengebruecke ausmachen.");

AD(({"bruecke","haengebruecke"}),
  "Du kannst die lange Haengebruecke kaum mehr erkennen.");
    
AD(({"flussgrund","grund","boden"}),
  "Am Flussgrund scheint stellenweise Flussgras zu wachsen.");
       
AD(("westen"),
  "Im Westen liegt an der suedlichen Schlucht einen schmalen Sandstrand. "
  "Noch weiter westlich erkennst Du einen Wasserfall.");
  
AD(({"strand","sandstrand"}),
  "Im Westen erkennst Du sicher mehr.");
  
AD(({"sandsteinschlucht","schlucht"}),
  "Die tiefe, schattige Sandsteinschlucht fuehrt hier von Westen nach Osten.");
   
AD(("osten"),
  "Im Osten erkennst Du mehr vom Osten.");
  
AD(({"wand","waende","schluchtwand","schluchtwaende","sandsteinwand",
     "sandsteinwaende"}),
  "Die gelben, ca 250 Meter hohen beinahe senkrechten Waende ragen "
  "beeindruckend direkt neben dem Fluss auf. An der noerdlichen Schluchtwand "
  "fallen Dir seltsame Loecher auf.");

AD(("loecher"),
  "Die Loecher sind weit ueber Dir und sehen aus wie Hoehleneingaenge.");
  
AD(({"wohnhoehlen","eingaenge","hoehlen","hoehleneingaenge"}),
  "Dort oben liegen die Hoehlen der Steingiganten.");
  
AD(({"riesen","steingiganten","giganten"}),
  "Die Steingiganten sind unbewegte, friedliche Riesen angeblich ganz aus "
  "Stein. Ihre Wohnhoehlen sind genau ueber Dir im Sandgestein.");

AD(({"sandstein","sandgestein","gestein","stein"}),
  "Die Waende der Schlucht sind aus gelb schimmerndem Sandstein.");
    
AD(("meter"),
  "Faszinierend. Teilweise sind die glatten, gelben Sandsteinwaende sogar "
  "ueberhaengend.");

  
AddCmd(("taste"), "schaedel");
AddCmd(("testprop"), "schaedelprop");

AddSound( DEFAULT_SOUND,
   "Aus dem Westen dringt gedaempft das Rauschen eines Wasserfalles zu Dir.");
   
AddSound(({"rauschen","wasserfall"}),  
   "Aus dem Westen dringt gedaempft das Rauschen eines Wasserfalles zu Dir.");


  OST
  WEST 
  
    }


OSTF(fluss5)
WESTF(fluss3)


etwas() {

	if( !TP->QueryProp("schaedelfinder") && schaedelzahl==1 ) {
		
		return(BS("Es sieht aus wie ein Schaedel! Du koenntest mit der "
		"Hand nach ihm tasten."));
	}
	
	if( !TP->QueryProp("schaedelfinder") && schaedelzahl==0 ) {
		
		return(BS("Anscheinend ist hat im Flussgras einmal etwas "
		"gelegen. Es war wohl jemand vor Dir da."));
	}
	
	if( TP->QueryProp("schaedelfinder") ) {
		
		return(BS("Achja Du erinnerst Dich. Du hast hier einmal den "
		"Schaedel von Charles le Sabre gefunden."));
	}
}



schaedsabre() {
	
	if( !TP->QueryProp("schaedelfinder") && schaedelzahl==1 ) {
		return(BS("Taste nach dem Schaedel."));
	}
	
	if( !TP->QueryProp("schaedelfinder") && schaedelzahl==0 ) {
		return(BS("Welchen Schaedel meinst Du? Da ist nichts mehr im "
		"Flussgras."));
	}
	
	if( TP->QueryProp("schaedelfinder") ) {
		return(BS("Den Schaedel von Charles le Sabre hast Du doch schon "
		"gefunden."));
	}
}

		
		
schaedelprop() {
	
	TP->SetProp("schaedelfinder", 0);
return 1;}



int schaedel(string str) {
	
	object schaedel;
	schaedel=CLONEOB("/d/dschungel/trintrasil/fluss/obj/schaedel");
/*damit soll sicher gestellt werden das nur ein schaedel im spiel ist. Ist der 
schaedel geladen ist er im Besitzt eines spielers. wenn nicht ist er entweder
noch nie geladen worden oder wurde wieder aus dem speicher gemoved*/        

	notify_fail("Nach was willst Du tasten?\n");
	
	if(str=="nach schaedel"||str=="nach totenschaedel"||str=="nach kopf"||
	str=="nach etwas"||str=="mit hand nach schaedel"||str=="mit hand nach "
	"totenschaedel"||str=="mit hand nach kopf"||str=="mit hand nach totenkopf"||
	str=="mit hand nach etwas") {
		
		write_file("/d/dschungel/trintrasil/log/flusslog",
		""+ctime()+": "+CAP(getuid(TP))+" sucht den schaedel in fluss4.\n");
		
	if( (schaedelzahl==1) && (!TP->QueryProp("schaedelfinder")) ) {
		
		schaedel->move(TP, M_NOCHECK);
		this_player()->SetProp("schaedelfinder", 1);
		schaedelzahl=0;
		
		write(BS("Du ertastest im Flussgras einen kahlen Totenschaedel. "
		"Schaudernd steckst Du den ihn ein."));
		say(BS(""+TPN+" findet etwas im Flussgrass."));
	return 1;}
	
	if( TP->QueryProp("schaedelfinder") ) {
		
		write(BS("Du erinnerst Dich. Im dichten Flussgras hast Du "
		"einmal den Schaedel von Charles le Sabre gefunden."));
	return 1;}
	
	if( (schaedelzahl==0) && !TP->QueryProp("schaedelfinder") ) {
		
		
		write(BS("Du tastest suchend im Flussgras herum, kannst aber "
		"nichts finden."));
		say(BS(""+TPN+" durchsucht das Flussgras."));
	return 1;}
    return 0;}
return 0;}
	