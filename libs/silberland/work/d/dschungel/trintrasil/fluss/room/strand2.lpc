


inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fischdef.h"

int messerklinge=1;


reset() {
::reset();
messerklinge=1;
}


init() {
	
	object gott, schatten;
	gott=find_player("gott");
	schatten=clone_object("/d/dschungel/trintrasil/fluss/npc/schatten.lpc");
	
	::init();
	
	if( living(this_player()) && !interactive(this_player()) && !TP->QueryProp("flussnpc") &&
	!TP->QueryProp("shadow(trint)") ) {
		
		schatten;
		schatten->setze_besitzer();
		TP->SetProp("shadow(trint)", 1);
		//tell_object(gott, "\nEin Strand sagt: Ein Pursuernpc betritt mich!\n\n");
		//tell_room(TO, "\n SCHATTEN AKTIVIERT\n\n");
		//schatten->nenne_besitzer();
	}
}


create() { 
::create(); 

SetProp( P_LIGHT, 1 ); 
SetProp( P_INDOORS, 0 ); 
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_JUNGLE]) );  
SetProp( P_INT_SHORT, "Strand des 'Rio de la Puseta'" ); 

SetProp("begrenzungsraum_fpursuer", 1);

SetProp( P_INT_LONG, BS(

  "Der Sandstrand wird nach Osten immer schmaeler und endet nach einigen metern "
  "ganz. Du stehst direkt am gruenen, schillernden ´Rio de la Puseta, der "
  "gemaechlich gurgelnd nach Osten fliesst. Im Westen beginnt eine "
  "Holzpfahltreppe die sich die gesamte Schluchtwand hinaufschraubt. Im feinen "
  "Flusssand haben ein paar Pflanzen Halt gefunden." )); 

   
 AD(({"holzpfahltreppe","treppe","pfahltreppe"}), 
   "Die lange Treppe ist im Westen.");

 AD(({"wand","felswand","sandsteinwand","waende","felswaende","sandsteinwaende",
      "schluchtwand","schluchtwaende","suedliche wand","suedliche felswand",
      "suedliche sandsteinwand","sandstein","stein","uferwand","ufer","hoehe"}),
   "Die gelbe, Sandsteinwand der Schlucht erstreckt sich ca 250 meter nahezu "
   "senkrecht in die Hoehe. Das sanfte, weiche Gelb des Sandsteins schimmert "
   "matt.");

 AD(("gelb"),
   "Es waere interessant diese imposante Schlucht naeher zu erforschen. Der "
   "Strand ist hier aber leider schon zu Ende.");
   
 AD(("ende"),
   "Nun vielleicht findest Du eine andere Moeglichkeit weiter den Fluss "
   "hinunter zu gelangen.");
 
 AD(("moeglichkeit"),
   "(Diese Moeglichkeit kannst Du nur ausprobieren, aber noch nicht nutzen weil "
   "das Flussgebiet noch seinen Feinschliff braucht. Daher kommen hier nun auch "
   "keine weiteren Hinweise dazu.)");

 AD(("gehen"),
   "Du sinkst tief im feuchten Sand ein.");
    
 AD(({"feinschliff","schliff","jahr"}),
   "Gib mir noch eine Magierwoche :).");

 AD(({"sueden","flussgebiet","gebiet"}),
   "Dieses Gebiet erstreckt sich ueber den Flusslauf weit bis in den Sueden.");
      
 AD(("magierwoche"),
   "Also so ca ein halbes Jahr :).");
       
 AD(({"schlucht","sandsteinschlucht"}),
   "Du befindest Dich nun am Grund der Schlucht am Ufer der 'Rio de la Puseta'. "
   "Der gruen schimmernde Fluss fliesst gemaechlich von Westen nach Osten.");

 AD(("grund"),
   "Der Rand der Schlucht, ueber dem der Dschungel liegt, ist weit ueber Dir.");
    
 AD(({"schluchtrand","rand"}),
   "Weit ueber Dir ueberspannt eine Haengebruecke die Schlucht.");
   
 AD(({"bruecke","haengebruecke"}),
   "Die Bruecke hebt sich nur als schmales dunkles Band vom Himmel ab.");
   
 AD(("band"),
   "Sie ist immerhin ca 250 meter ueber Dir.");
   
 AD(("dschungel"),
   "Um in den Dschungel zu gelangen musst Du Dich die gesamte Treppe im Westen "
   "hinauf quaelen.");

 AD(({"rio","rio de la puseta","puseta","wasser","fluss"}),
   "Das Wasser des ´Rio de la Puseta´ schillert gruen. Der Fluss ist hier in "
   "der Schlucht ca 100 meter breit und fliesst gemaechlich von Westen nach "
   "Osten.");

 AD(("westen"),
   "Weiter im Westen donnert unablaessig der grosse Wasserfall.");

 AD(({"sueden","flusslauf","lauf","osten"}),
   "Weiter im Osten scheint der Fluss eine Biegung nach Sueden zu machen, aber "
   "der Sandstrand ist schon hier zu Ende.");

 AD(("biegung"),
   "Von hier aus kannst Du die Biegung nicht gut erkennen.");

 AD(({"wasserfall","massen","wassermassen"}),
   "Gewaltige Wassermassen donnern ueber den Wasserfall weiss schaeumend in den "
   "´Rio de la Puseta´.");

 AD(("himmel"),
   "Der Himmel ist strahlendblau.");
 
 AD(("boden"),
   "Der Sand ist sehr fein und weich.");

 AD(({"sandstrand","strand"}),
   "Der Strand ist hier sehr schmal. Im nassen, feinen Sand haben ein paar "
   "kuemmerliche Pflanzen Halt gefunden.");

 AD(("pflanzen"),
   "Ein paar bleiche Grasbueschel und ein Graetenbusch fristen hier ihr "
   "kaergliches Dasein.");

 AD(({"grasbueschel","bueschel","gras"}),
   "Die Grasbueschel sehen duerr und bleich aus. Sie sehen aus als wuerden sie "
   "unter Naehrstoffmangel leiden.");
      
 AD(({"halt","dasein","mangel","naehrstoffmangel"}),
   "Der sandige, nasse Boden enthaelt kaum Naehrstoffe.");
   
 AD(({"naehrstoff","naehrstoffe"}),
   "Du kannst den Sand ja einmal kosten. Vielleicht schmeckst Du ein paar "
   "besondere Naehrstoffe.");
   
 AD(({"flusssand","sand"}),
   "Der Sand der hier vom Fluss angespuelt wurde ist sehr fein. Du sinkst beim "
   "Gehen tief ein.");


 AddExit("westen", "/d/dschungel/trintrasil/sdschungel/room/strand1");
   

  AddItem("/d/dschungel/trintrasil/fluss/obj/graetenbusch1", 
           REFRESH_DESTRUCT);   
  
  REITEN
  PFEIFE
//  AddCmd(({"klettere","kletter"}), "func_reiten");
  AddCmd(({"iss","koste"}), "func_messer");

    
  AddSound( DEFAULT_SOUND,
    "Aus dem Westen hoerst Du das Tosen eines Wasserfalles.");
  
  AddSound(("tosen"),
    "!!!WWWUUUSSSCCCHHHHH!!!");
      
  AddSmell( DEFAULT_SMELL,
    "Der Sand riecht leicht modrig.");
  
  
}


FLUSSFISCHRUF
FLUSSFISCHCALLOUTS(vor dem Strand)
FLUSSREITFUNC(/d/dschungel/trintrasil/fluss/room/fluss3)

/*
func_reiten() {
	
  write(BS("Mit einem Fisch auf dem 'rio de la Puseta' zu reiten wird leider "
           "erst so in einer Magierwoche moeglich sein."));
        return 1;} 
*/

func_messer(string str) {
	
	object klinge;
	
	if(str=="sand"||str=="flussand"||str=="etwas sand"||str=="naehrstoffe"||
	str=="naehrstoff") {
		
		if(messerklinge==1) {
			
			write(BSL("\nDu nimmst eine Handvoll Sand in den Mund und spuckst sie "
			"vor Schreck gleich wieder aus. In dem, uebrigens nicht besonders gut "
                        "schmeckendem, Sand findest Du die Klinge eines kleinen "
                        "Taschenmessers die Du beinahe geschluckt haettest und steckst sie "
                        "ein."));
                        say(BSL("\n"+TPN+" nimmt eine Handvoll Sand in den Mund und findet "
                        "darin zufaellig die Klinge eines kleinen Taschenmessers."));
                        messerklinge=0;
                        klinge=clone_object("/d/dschungel/trintrasil/sdschungel/obj/klinge");
                        klinge->move(TP, M_NOCHECK);
                        return 1;
                }
                
                
                if(messerklinge==0) {
                	
                	write(BSL("\nDu kostest erwartungsvoll etwas von dem Sand, spuckst ihn "
                	"aber enttaeuscht wieder aus."));
                	say(BSL("\n"+TPN+" kostet etwas Sand, spuckt ihn aber gleich wieder "
                	"aus."));
                	return 1;
                }
                return 0;
        }
        return 0;
}  