#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


int anzahl=3;

reset() {
::reset();
anzahl=3;
}
 
void create()
{
  ::create();

jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
        "Die schroffen Uferwaende beginnen hier gegen Suedwesten etwas zurueckzuweichen "
        "und niedriger zu werden. Der Fluss wird hier langsamer und laesst "
        "Schwemmgut von seiner langen Reise absinken. Unter der glitzernden "
        "Wasseroberflaeche kannst Du manchmal die hellen Ruecken " 
        "von Sandbaenken erkennen."));
            
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN:TT_WATER]) );  
 
  ASD(({"fisch","ruecken"}),
    "fisch");

  AD(("suedwesten"),
    "Du bemerkst das sie Sandsteinwaende nach Suedwesten hin langsam niedriger "
    "werden.");
    
  AD(("sorgen"),
    "Die Sandbaenke liegen noch tief genug.");
    
  AD(({"gang","tiefgang"}),
    "Du wirst sicher nicht auf eine Sandbank auflaufen.");
  
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Der Rio de la Puseta wird hier deutlich breiter.");
    
  AD(({"sandstein","gestein","stein"}) ,  
    "Das milde Gelb ist ein schoener Kontrast zum gruenen Fluss.");
    
  AD(({"bett","flussbett"}),
    "Mit der Zeit hat sich der Rio de la Puseta dieses tiefe Flussbett "
    "in den Sandstein geschuerft.");
    
  AD(({"tuerme","felsbloecke","bloecke"}),
    "Du siehst einige gelb-orangen rundgewaschenen Felsbloecke aus dem Wasser stehen.");
     
  AD(({"uferwand","uferwaende","wand","waende","sandsteinwand","sandsteinwaende",
       "felswand","felswaende","schluchtwand","schluchtwaende"}),
    "Die Waende werden niedriger und zerkluefteter. Regenrinnen haben in "
    "weniger steile Wandstuecke ihre Spur eingegraben.");
        
  AD(({"sonnenlicht","licht","sonne","schein"}),
    "Durch die schuetzende Schlucht erreicht die stechende Sonne den "
    "Fluss nur als milden Schein.");
    
  AD(({"wasser","schwemmgut","gut"}),
    "Da der Fluss langsamer wird beginnt sich der mittreibende Sand "
    "abzusetzen.");
      
  AD(({"farbe","farbtoene","toene","gelb"}),
    "Farbtoene von gelb bis orange ziehen sich durchs Gestein.");

  AD(({"wandstueck","stueck","wandstuecke","stuecke","teile"}),
    "In weniger steilen, zurueckweichenden Teilen der Waende hat abrinnendes "
    "Regenwasser Spuren eingegraben.");

  AD(({"spuren","spur"}),
    "Die ausgewaschenen Rinnen lassen die Uferwaende faltig erscheinen.");
    
  AD(({"rinnen","regenrinnen","regenwasser"}),
    "Wenn es hier regnet fliesst das Regenwasser durch die Rinnen in kleinen "
    "Wasserfaellen in den Fluss.");
    
  AD(({"wasserfaelle","wasserfall"}),
    "Da es nicht regnet sind nur noch ihre Spuren zu sehen.");
    
  AD(({"aal","zitteraal"}),
    "Gleichgueltig und traege gleitet der Zitteraal unter Dir hinweg auf der Suche nach "
    "geeigneterer Beute.");
    
  AD(({"beute","nahrung"}),
    "Wehe den kleinen Fischen die sich unvorsichtig dem hungrigen Aal naehern.");
    
  AD(("suche"),
    "Da Du direkt ueber ihm schwimmst muesste er eigentlich nicht lange suchen.");
    
  AD(({"fische","kleine fische"}),
    "Ja, da waer Dein Fisch schon ein ausgiebigerer Happen."),
    
  AD(("happen"),
    "Du koenntest ja versuchen die Aufmerksamkeit des suessen Aales "
    "zu erregen."),
    
  AD(("aufmerksamkeit"),
    "Mit der Hand auf die Wasseroberflaeche zu klatschen muesste reichen."),
  
  AD(("hand"),
    "Ja genau mit der, noch ist sie ja dran.");
    
  AD(({"sandbaenke","baenke","sandbank","bank"}),
    "Der Sand lager sich hier zu flachen Sandbaenken ab.");
    
  AD(("sand"),
    "Der gelbe, feine Sand wurde vom Fluss aus dem Canyon geschuerft.");
    
  AD(("canyon"),
    "Der Fluss schuerft immer noch wie schon seit einer Ewigkeit an der "
    "Schlucht.");
    
  AD(("ewigkeit"),
    "Schoen das Dich die Ewigkeit interessiert, aber man sollte keine Ewigkeit "
    "darauf verwenden sich damit zu beschaeftigen.");
    
  AD(({"schlucht","sandsteinschlucht"}),
    "Die Sandsteinschlucht wird hier von Norden nach Sueden langsam niedriger "
    "und breiter, wodurch der Fluss feinen Sand ablaedt.");
    
  AD(("norden"),
    "Nach Norden hin werden die Schluchtwaende langsam hoeher.");
    
  AD(("sueden"),
    "Nach Sueden hin werden die Schluchtwaende langsam niedriger.");
    
  AD(("reise"),
    "Der Fluss hat schon eine lange Reise hinter sich.");
 
  AD(({"boden","grund"}),
    "Der Fluss ist hier seichter und der Grund ist mit feinem gelben Sand "
    "bedeckt. Daher wirkt der Fluss hier heller.");
    
  AD(("wind"),
    "Der Wind blaest hier nur lau und verspielt.");
  
  AD(("himmel"),
    "Die Felswaende weichen von Norden nach Sueden langsam ausseinander, "
    "wodurch die Schlucht heller als im Norden ist, wo die hohen Felswaende "
    "tiefe Schatten werfen.");
    
  AD(("felswaende"),
    "Du siehst die Waende der Schlucht im Norden hoeher und enger werden.");
    
  AD(("schatten"),
    "Die Sonne reicht hier bis auf die Wasseroberflaeche.");
    
  AD(({"oberflaeche","wasseroberflaeche"}),
    "Durch den hellen Grund schimmert die Wasseroberflaeche in hellem gruen.");
    
  AD(({"welle","wellen"}),
    "Ueber den groessten Sandbaenken entstehen kleine Wellen.");
  
    
  AddItem("/d/dschungel/trintrasil/fluss/npc/schnabeltier.lpc" ,REFRESH_DESTRUCT);
  
  AddCmd(({"klatsche","patsche","klatsch"}),  "func_aal");
   
  
  NORDW  
  SUEDW
  

  AddRoomMessage(({
           "\nUnter Dir schimmert eine Sandbank durch das gruene Wasser.\n",
           "\nDer Rio de la Puseta schillert smaragdgruen.\n",
           "\nDer Wind faehrt durch die Schlucht.\n",
           "\nEin silberner Zitteraal zieht unter Dir hinweg.\n",
           "\nEin sucht gierig Zitteraal nach Nahrung.\n",
           "\nStumm gleitet ein Zitteraal ueber den Grund.\n",
           "\nDurch das gruene Wasser schimmern gelbe Sandbaenke.\n", 
           "\nEin Zitteraal wirbelt den Grund auf der Suche nach Beute auf.\n",
           "\nDirekt unter Dir schwimmt ein riesiger Zitteraal.\n",
           "\nUnter Dir schwimmt ein Zitteraal. Pass auf, der koennte " 
           "gefaehrlich werden!\n",
           "\nEin riesiger Zitteraal schwimmt unter Dir durch.\n",
           "\nKleine Wellen kraeuseln sich ueber den groesseren Sandbaenken.\n",
          }),40);
//ist oefters notwendig um den spieler auf den Aal aufmerksam zu machen
}
 
  
 NORDWF(fluss15) 
 SUEDWF(fluss17)
 
 
  
int func_aal(string str) {
	
object aal;
	
	notify_fail("Auf was willst Du klatschen?\n");
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" spielt mit dem aal in fluss16.\n");
	
	if(str=="auf wasseroberflaeche"||str=="auf oberflaeche"||
	str=="auf wasser"||str=="mit hand auf wasseroberflaeche"||
	str=="mit hand auf wasser"||str=="mit hand auf oberflaeche") {
		
		WSCHLANGENABFRAGE(
		write(BSL("\nDu solltest erst die Wasserschlange toeten bevor "
		"Du etwas anderes machst."));,
		
		if(anzahl) {
		write(BSL("\nSpritzend schlaegst Du mit der Hand auf die "
		"Wasseroberflaeche und rufst dabei putputputput... \n"
		"Tatsaechlich aendert der Zitteraal seinen Kurs und schwimmt "
		"auf Dich zu.\n\n"));
		say(BS(""+TPN+" will mit einem niedlichen Zitteraal spielen."));
		aal=CLONEOB("/d/dschungel/trintrasil/fluss/npc/aal.lpc");
		aal->move(environment(TP), M_TPORT);
		anzahl=0;
		return 1;
		}
		
		if(!anzahl) {
		write(BSL("\nDer Aal will nicht!"));
		say(BSL("\n"+TPN+"klatscht mit der Hand auf die "
		"Wasseroberflaeche."));
			return 1;
		})
	return 1;}
return 0;}


fisch() {
	WSCHLANGENABFRAGE(
	return BS("Dein Fisch hat zu wenig Tiefgang. Du solltest Dir "
	"eher um die Wasserschlange als um die Sandbaenke Sorgen machen.");,
	return BS("Dein Fisch hat zu wenig Tiefgang. Um die Sandbaenke "
	"brauchst Du Dir keine Sorgen zu machen.");)
}