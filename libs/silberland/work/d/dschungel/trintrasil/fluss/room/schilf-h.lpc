//anhaengfertig und getestet

#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create()
{
  ::create();

AddItem("/d/dschungel/trintrasil/fluss/npc/kaiman",
        REFRESH_DESTRUCT);
}


kaimanpresent() {
		
	if(present("riesenkaiman")) {
		return 1;
	}
	
	if(!present("riesenkaiman")) {
		return 0;
	}
}


kaimanmove() {

object kaiman;
kaiman=present("kaiman", TO);	
	
	if(kaiman) {
		 kaiman->move("/d/dschungel/trintrasil/fluss/room/dfluss2",
		 M_TPORT);
	}
	if(!kaiman) {
		return 0;
	}
}
	
		  