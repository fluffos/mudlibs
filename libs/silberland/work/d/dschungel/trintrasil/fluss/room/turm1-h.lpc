//fertig und getestet

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h> 
#include <wizlevels.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Abseilen von einem Felsturm" );
  SetProp( P_INT_LONG, BS(
  "Die werden die Spieler nie sehen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no() {
 	
   write(BS("Du musst Deine gesamte Kraft fuer das Klettern "
   "aufwenden."));
   return 1;
}
     

  init() {
  	
  	::init();

  if(query_once_interactive(this_player())){
  call_out("a1", 2);}
}
  

  a1() {
  	
    NIX
    write(BSL(
    "\nStueckweise laesst Du das Seil durch Deine Haende laufen. Sieben Meter "
    "unter Dir rauscht der Rio de la Puseta dahin."));
    call_out("a2", 3);
}
    
    
   a2() {
   	
   NIX
   write(BSL(
   "\nDer Felsturm ist ueberhaengend, so das die Wand immer weiter von Dir "
   "entfernt ist je weiter Du nach unten kommst."));
   call_out("a3", 3);
} 
 
    
   a3() {
   	
   NIX
   write(BSL(
   "\nDie Wasseroberflaeche ist nun schon ganz nah. Bald bist Du unten."));
   call_out("a4", 2);
}
 
    
   a4() {
   	
   NIX
   write(BSL(
   "\nDu hast das Seilende nun erreicht und baumelst ueber der "
   "Wasseroberflaeche. Nun solltest Du Dir einen Fisch rufen. Ansonsten kommst "
   "Du von hier nur weg wenn Du wieder nach oben kletterst.\n\n"));
   tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
          BSL("\n"+TPN+" klettert vom Felsturm herunter und baumelt nun am Seil "
             "ueber der Wasseroberflaeche.\n\n"));  
   TPM("/d/dschungel/trintrasil/fluss/room/fluss13", M_GO+ M_NO_SHOW+
       M_SILENT);      
}
    
  
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/dante/fisch/room/fluss13",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  