#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";


int messerint=1;

reset() {
  ::reset();
  messerint=1;
}

  
void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Die Schutthalde aus kantigen Sandsteintruemmern windet sich steil in "
    "die Hoehe. Immer wieder poltern lose Steine unter Dir in die Tiefe. "
    "Du kannst die rampenartigen Halde noch weiter bis knapp unter den Rand "
    "der Schlucht hinauf klettern."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );  
  SP(P_KILL_NAME, "Eine Steinlawine");
 
  AD(({"fisch"}),
    "Der hoppelt natuerlich nicht neben Dir her.");

  AD(({"schutthalde","halde"}),
    "Die Schutthalde windet sich hoch und steil bis zum Rand der Schlucht. "
    "Mit einiger Anstrengung kannst Du weiter hinauf klettern.");
    
  AD(("rand"),
    "Von hier aus kannst Du den Rand nicht so gut erkennen, aber das letzte "
    "Stueck bis hinauf zum Dschungel ist senkrecht und sieht schwer erkletterbar "
    "aus.");
    
  AD(("dschungel"),
    "Der Dschungel liegt ueber der Schlucht.");
    
  AD(({"sandstein"}),
    "Das Geroell besteht natuerlich aus dem gleichen gelben Sandstein wie "
    "die Uferwand aus der es herausgebrochen ist. Ein besonders oranger "
    "Gesteinsbrocken faellt Dir auf.");
  
  ASD(({"gesteinsbrocken","brocken","gestein"}),
    "brocken");
 
  ASD(("etwas"),
    "etwas");

  AD(("orange"),
    "Der Gesteinsbrocken leuchtet in einem schoenen Orange.");
  
  AD(("geroell"),
    "Das Geroell ist natuerlich auch aus Sandstein. Es stammt ja auch aus "
    "der Schluchtwand.");

  AD(({"schluchtwand","wand","sandsteinwand","schluchtwaende","waende",
      "sandsteinwaende","uferwand","uferwaende","felswand","felswaende"}),
     "Die Schluchtwand ist hier abgerutscht und die Gesteinstruemmer bilden "
     "nun diese rampenartige Schutthalde.");
                 
  AD(({"steintruemmer","sandsteintruemmer","truemmer","gesteinstruemmer"}),
    "Du musst aufpassen, dass nicht ein Stein in diesem Geroell locker ist und "
    "Du abrutschen koenntest.");
    
  AD(({"tiefe","band"}),
    "Du befindest Dich bereits ca 15 meter ueber dem Rio de la Puseta.");
  
  AD(("hoehe"),
    "Ganz bis an den Rand der Schlucht wirst Du nicht klettern koennen.");
    
  AD(({"rand","dschungel","schluchtrand"}),
    "Hinter dem Schluchtrand ist der Dschungel.");
   
  AD(("schlucht"),
    "Diese Schlucht hat der Rio de la Puseta in den Dschungel gegraben.");
    
  AD(({"fluss","rio de la puseta","rio","puseta","wasser"}),
    "Wie ein breites, gruenes Band windet er sich durch die Schlucht.");  
    
  AD(("steine"),
    "Immer wieder loest sich ein Stein unter Deinem Fuss.");
  
  AD(("stein"),
    BSL("  !!  Klick  Klack  Klock  !!\nEin Stein poltert auf einen grossen Fels "
    "unter Dir."));
    
  AD(("fels"),
    "Der Fels wird vom Fluss beinahe ueberspuelt, scheint aber trotzdem recht "
    "trocken und sicher zu sein.");
    
  AD(("fuss"),
    "Noch alles dran.");
    
  AD(("anstrengung"),
    "Du musst nur aufpassen das Du auf dem losen Geroell nicht abstuerzt.");
    
  AD(("boden"),
    "Die Steine sind scharfkantig und teilweise recht lose.");
    
  AD(("himmel"),
    "Der Himmel ist nahezu wolkenlos.");

  
  AddCmd(("taste"), "messer_func");
  
  
  AddExit("unten", "./fels");

  AddExit("oben", "./halde1");
  
  
  AddSound( DEFAULT_SOUND,
   "Ueber Dir hoerst Du das aufgeregte Gekreische eines Fischadlers.");
 
 AddSound(({"gekreische","fischadler","adler"}),
   "!!KRAA KRAAAAA!!");     
}


int messer_func(string str) {
	
object messer;	
	
	notify_fail("Nach was willst Du tasten?\n");
	
	if(str=="etwas"||str=="nach etwas"||str=="messer"||str=="nach messer"||
	str=="unter gesteinsbrocken"||str=="unter gestein"||str=="unter "
	"brocken"||str=="unter stein") {
		
		if(messerint) {
			
			messer=CLONEOB("/d/dschungel/trintrasil/fluss/obj/messer");
			if(messer->move(TP, M_GET +M_SILENT)==ME_TOO_HEAVY) {
				write(BS("Das Messer ist leider zu schwer fuer Dich"));
				messer->remove();
				return 1;
			}
			
			else {
				write(BSL("\nDu tastest in einen schmalen Spalt unter "
				"dem Gesteinsbrocken und findest ein altes Messer. Du "
				"steckst es gleich ein."));
				say(BSL("\n"+TPN+" hat ein Messer unter einem "
				"Gesteinsbrocken gefunden."));
				messerint=0;
				return 1;
			}
		}
		
		if(!messerint) {
			write(BSL("\nDu findest leider nichts unter dem "
			"Gesteinsbrocken."));
			say(BSL("\n"+TPN+" tastet unter einen Gesteinsbrocken, "
			"findet aber nichts."));
			return 1;
		}
		return 1;
	}
	return 0;
}

	
lawine()  {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) if(living(inv[i]))  {
		
		inv[i]->move("/d/dschungel/trintrasil/fluss/room/fels", M_GO+M_NO_SHOW,
		"von der Lawine nach unten gerissen","wird",
		"stuerzt von oben herab");  
		inv[i]->do_damage(10 + random(20));  
        }
}
       
 
brocken() {
	if(messerint) {
		return BS("Hat da nicht etwas geglitzert? Unter dem Brocken "
		"scheint etwas zu liegen.");
	}
	
	if(!messerint) {
		return BS("Der Gesteinsbrocken leuchtet in einem kraeftigen "
		"Orange, aber sonst scheint er unscheinbar zu sein.");
	}
}


etwas() {
	if(messerint) {
		return BS("Es scheint etwas unter dem Gesteinsbrocken zu "
		"liegen. Du koenntest ja einmal danach tasten.");
	}
	
	if(!messerint) {
		return BS("Da liegt nichts unter dem Gesteinsbrocken.");
	}
}

 