#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

dschungelfluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Hier schwenkt der Fluss in einem weiten Bogen nach Norden, wo der Fluss "
    "aus einer tiefen Sandsteinschlucht austritt. Am westlichen " 
    "Ufer liegen einige Sandsteintruemmer und Felsbloecke, aber gegen Osten "
    "hast Du noch einen ungehindeten Einblick in den Dschungel."));    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "In einem weiten Bogen sucht sich der Rio de la Puseta seinen weg zum Meer.");
    
  AD(({"meer","weg"}),
    "Es ist noch ein weiter Weg fuer den Fluss.");
    
  AD(({"schlucht","sandsteinschlucht"}),
    "Im Norden siehst Du den Rio de la Puseta aus einer Schlucht austreten, "
    "welche durch einen Felsbruch abrupt endet.");
    
  AD(({"bruch","felsbruch","abbruch"}),
    "Das Grundgestein hat sich dort ueber eine weite Strecke hin abgesenkt, "
    "wodurch der noerdliche Teil des Dschungels auf einem hoeheren Plateau "
    "liegt als der suedliche abgesenkte Teil.");
    
  AD(("strecke"),
    "Von Westen nach Osten zieht sich eine durch den Bruch entstandene, vom "
    "Einschnitt der Schlucht zerteilte Felswand hin. Ihr Ende kannst Du nicht "
    "erkennen.");
    
  AD(("ende"),
    "Die Bruchwand verschwindet im Westen und Osten im Dschungel.");
    
  AD(({"einschnitt","schnitt"}),
    "Du bist noch zu weit weg. Weiter flussaufwaerts koenntest Du mehr erkennen.");
    
  AD(({"plateau","teil","dschungelplateau"}),
    "Der noerdliche Dschungel liegt durch den Bruch hoeher als der suedliche "
    "Teil.");
     
  AD (({"felswand","fels","bruchwand","wand","fuss"}),
    "Die Felswand ist durch einen Abbruch entstanden. Im Norden koenntest Du "
    "sie besser betrachten.");
     
  AD(("ufer") ,  
    "Das oestliche und das westliche Ufer sind hier sehr unterschiedlich.");
    
  AD(({"oestliches ufer","einblick","blick","osten"}),
    "Das oestliche Ufer steig nur leicht zum Dschungel hin an. "
    "Ein breiter Streifen weisser Baumgerippe zeigt eine "
    "Ueberschwemmungslinie.");
    
  AD(({"linie","ueberschwemmungslinie","streifen","stelle"}),
    "Die blassen Baumstuempfe markieren die Stelle bis zu der der Fluss "
    "wohl oefter ueber die Ufer tritt.");

  AD(({"baumstuempfe","stuempfe","gerippe","baumgerippe","baeume","reste"}),
    "Diese Baeume muessen vor kurzem noch unter Wasser gewesen sein. "
    "Jetzt faulen ihre Reste in der Sonne dahin.");
    
  AD(({"dschungel","wald"}),
    "Im Ostern erhebt sich der Dschungel. Grosse Baumriesen, wildes "
    "Dickicht und, verfilztes Unterholz kaempfen hier um ihren Platz.");
  
  AD(({"baumriesen","riesen"}),
    "Grosse, alte Riesen erheben sich aus dem engen Treiben des Dschungels "
    "und breiten ihre Kronen ungehindert ueber den Wald aus.");  
  
  AD(({"treiben","platz","pflanzen"}),
    "Das Leben draengt sich hier auf engstem Platz zusammen.");
    
  AD(("leben"),
    "Im Dschungel wimmelt es von Pflanzen und Tieren.");
    
  AD(({"kronen","schatten"}),
    "Erhaben breiten die Baumriesen ihre Kronen aus, scheinbar "
    "unbekuemmert vom Treiben in ihrem Schatten.");
    
  AD(({"dickicht","unterholz"}),
    "Bunte, exotische Straeucher und Schlingpflanzen machen den Dschungel "
    "beinahe unzugaenglich.");
    
  AD(({"straeucher","schlingpflanzen"}),
    "Kein Platz des Dschungels ist ungenutzt.");
    
  AD(("tiere"),
    "Die unterschiedlichsten Tiere leben in und auf dem Dschungel, und keines "
    "davon ist zahm.");
    
  AD(({ "westen","westliches ufer"}),
    "Am erhoehten westlichen Ufer liegen einige grosse, halb ueberwucherte "
    "Felsbloecke.");

  AD(({"sandsteintruemmer","truemmer","felsbloecke","bloecke","norden"}),
    "Im Norden direkt am Fuss der Bruchwand liegen die Felsbloecke noch viel "
    "dichter beieinander.");
        
  AD(({"suedosten","bogen"}),
    "Im Norden kannst Du eine lange imposante Bruchwand erkennen, nach "
    "Suedosten fliesst der Fluss im wuchernden, draengenden Dschungel.");     
    
  AD(("boden"),
    "Du schwimmst auf einem Fisch ueber den Fluss. Was erwartest Du?");
    
  AD(("himmel"),
    "Der Himmel ist beinahe wolkenlos.");
    
  AD(("sonne"),
    "Die weisse Sonnenscheibe brennt auf Dich nieder.");
    
  AD(({"sonnenscheibe","scheibe"}),
    "Die feuchte Hitze macht Dir zu schaffen. Naja Du befindest Dich auf einem "
    "Fluss, da kannst Du Dir doch Kuehlung verschaffen.");
    
  AD(("hitze"),
    "In der schattigen Schlucht noerdlich von Dir ist es sicher kuehler.");
    
  AD(("kuehlung"),
    "Kuehle Gesicht mit Wasser.");
    
  AD(("gesicht"),
    "Dein Gesicht glueht vor Hitze.");
    
  AD(("wasser"),
    "Das Wasser ist angenehm kuehl.");
   
  AD(({"grundgestein","gestein","grund"}),
    "Das Grundgestein des oberen Dschungelplateau besteht aus weichem gelben "
    "Sandstein.");
     
  AD(({"sandstein","stein"}),
    "In der Schlucht kannst Du ihn besser bewundern.");


  AddCmd(("kuehle"), "func_kuehlung");
      
  
  NORD
  SUEDO
  

 AddSound( DEFAULT_SOUND,
   "Aus dem Dschungel wehen Tierlaute zu Dir herueber.");
 
 AddSound(({"tierlaute","laute"}),
   "!!UH UH UH GROAAAAAAR!!");
   
 AddSmell( DEFAULT_SMELL,
   "Ein suesser Duft liegt ueber dem Dschungel.");
 
 AddSmell(({"duft","dschungel","blueten","geruch"}),
   "Ein aufdringlicher Geruch von insektenlockenden Blueten haengt über dem "
   "Fluss.");
   
}

 
 NORDF(fluss19a)
 SUEDOF(fluss21)
 

func_kuehlung(string str) {
	
	notify_fail("Was willst Du mit was kuehlen?");
	
	if(str=="gesicht mit wasser"||str=="gesicht"||
	str=="gesicht mit flusswasser") {
		
		WSCHLANGENABFRAGE(
		write(BSL("\nSolange Dein Fisch mit der Wasserschlange kaempft "
		"hast Du keine Zeit Dir das Gesicht mit Wasser zu kuehlen."));,
		write(BSL("\nDu schoepfst mit beiden Haenden kuehles Wasser aus "
		"dem Fluss und laesst es Dir geniesserisch ueber das Gesicht "
		"rinnen."));
		say(BSL("\n"+TPN+" kuehlt sich mit Flusswasser ab."));)
	return 1;}	
return 0;}