#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


int pilz=1;

reset() {
  ::reset();
  pilz=1;}
  
void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
        "Die weiter noerdlich so glattpolierten Sandsteinwaende sind hier "
        "zerkluefteter und von Rissen und Spalten durchzogen. Die abgesunkenen "
        "Uferwaende sind auch von Regenrinnen, in denen sich Gras und kleine "
        "Buesche krallen, zerfurcht. Im Sueden kannst Du das Ende der Schlucht "
        "erkennen." ));            
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_WATER]) );  

  AD(("sueden"),
    "Im Sueden ergiesst sich der Rio de la Puseta in den Dschungel und "
    "verlaesst die Schlucht.");
     
  AD(({"fluss","rio de la puseta","puseta","rio"}),
    "Weiter im Sueden verlaesst der Rio de la Puseta anscheinend die Schlucht "
    "und ergiesst sich in den Dschungel.");
    
  AD(("schlucht"),
    "Die Waende der Schlucht werden von Sueden nach Norden immer hoeher.");
    
  AD(({"reittier","tier"}),
    "Er traegt Dich sicher ueber das Wasser.");
    
  AD(({"gestein","fels"}),
    "Die Uferwaende der Schlucht sind aus Sandstein.");
    
  AD(({"sandstein","stein"}),
    "Sandstein ist besonders weich und durch Wind und Wasser leicht formbar.");
    
  AD(({"wasser"}) ,  
    "Das Wasser wird nach Sueden langsam trueber, da die Fliessgeschwindigkeit "
    "ab, und der Naehrstoffgehalt zunimmt.");
    
  AD(({"geschwindigkeit","fliessgeschwindigkeit","platz"}),
    "Die Schlucht verbreitert sich und bietet dem anschwellenden Fluss mehr Platz.");
    
  AD(({"gehalt","naehrstoff","naehrstoffgehalt"}),
    "Die Regenfaelle schwemmen Naehrstoffe vom oberen Dschungel in den Fluss.");
     
  AD(({"regenfaelle","regen"}),
    "Ein Regen waere bei der zunehmenden Hitze eine Erloesung.");
  
  AD(({"norden","hitze"}),
    "Weiter im Norden, wo die Schlucht tiefer wird ist sie auch schattiger und "
    "kuehler.");
    
  AD(("erloesung"),
    "Der Himmel sieht zwar nicht dannach aus, aber das kann sich schnell aendern.");
      
  AD(("himmel"),
    "Der Himmel ist nahezu wolkenlos.");
    
  AD(({"schlucht","ende"}),
    "Du siehst suedlich am Ende der Schlucht bereits einen gruenen Schimmer.");
     
  AD(("schimmer"),
    "Zwischen den Felswaenden der Schlucht siehst Du gruen den Dschungel hindurchschimmern.");
     
  //Alles Details die die Landschaftsform dieses Dschungelteils charakterisieren
  //das sollte doch genauer angeschaut werden und bei Bedarf geaendert werden 
  //da es doch die Landschaft dieses Dschungelteils (plateau usw.) genau 
  //bestimmt und ev. Auswirkungen 
  //auf andere Gebiete hat.   
     
  AD(({"felswaende","felswand"}),
    "Der Fluss ergiesst sich im Sueden in eine tiefer liegenden Teil des "
    "Dschungel. Schwimme nach Sueden wenn Dich die Bruchwand interessiert.");
    
  AD(("teil"),
    "Ober dem Schluchtrand liegt das hoehere Dschungelplateau. Weiter im "
    "Sueden bricht dieses abrupt ab, wodurch der Rio de la Puseta "
    "uebergangslos in den suedlich tieferen Dschungel fliesst.");
 
  AD(("schluchtrand"),
    "Der Dschungel liegt ober der zerkluefteten Uferwand verborgen.");
    
  AD(({"plateau","dschungelplateau","sandsteinplateau"}),
    "Der noerdliche Dschungel liegt hoeher als der suedliche.");
    
  AD(({"risse","riss","sprung","spruenge"}),
    "Hier am suedlichen Rand des Dschungelplateau, das der Fluss mit seiner "
    "Schlucht zerschnitten hat, scheinen grosse Spannungen das Gestein zu "
    "sprengen.");
    
  AD(({"spannung","spannungen"}),
    "Die Spruenge sehen aus als wuerde der Fels unter innerer Spannung stehen, "
    "Du wuerdest gern mehr ueber die Landschaftsform des Dschungelplateau "
    "wissen.");
    
  AD(({"landschaftsform","form","landschaft"}),
    "Ob es am Untergrund liegt, dass solche Spannungen durch den Fels laufen? "
    "Aus welchen Ursachen auch immer, im Sueden siehst Du den Bruch des "
    "Plateau der das Ende der Schlucht darstellt.");
    
  AD(({"untergrund","grund"}),
    "Vielleicht ist hier der Untergrund unter dem Dschungelplateau besonders "
    "nachgiebig. Kann man nur schaetzen.");
    
  AD(({"ursachen","ursache"}),
    "Die kennst Du leider nicht.");
    
  AD(("bruch"),
    "Wenn man aus der Schlucht faehrt sieht man wie das obere Dschungelplateau "
    "in einer Linie von osten nach westen eingesunken ist, und nun durch eine "
    "ueber 130 meter hohe Felswand geteilt wird.");
     
  AD(({"linie","bruchlinie","bruchwand"}),
    "Der genaue Verlauf der Bruchlinie ist unbekannt da sie sich im unerforschten "
    "Dschungel verliert.");
    
  AD(("verlauf"),
    "Einen Teil der Bruchwand kannst Du bestaunen wenn Du im Sueden die Schlucht "
    "verlaesst.");

  AD(("rand"),
    "Welchen Rand meinst Du? Den Schluchtrand oder den Rand des "
    "Dschungelplateaus?");
        
  AD(({"dschungelplateaurand","plateaurand"}),//iss ok?
    "Ein noerdlicher Rand ist eigentlich nicht vorhanden da sich das "
    "Sandsteinplateau ziemlich unauffaellig flach vom Meer her erhebt. Nur "
    "der suedliche Rand ist durch eine Bruchwand eindeutig erkennbar.");
    
  AD(({"seite","suedseite"}),
    "Die Suedseite des Kontinents ist beinahe unerforscht.");
    
 //ende der geographiestunde
    
  AD(("meer"),
    "Der Fluss muendet auf der Suedseite des Kontinents ins Meer.");
    
  AD(("kontinent"),
    "Die Groesse des Kontinent ist nicht genau bekannt da nur hauptsaechlich "
    "Gebiete um Tijara erforscht sind.");
    
  AD(("groesse"),
    "Der wuchernde, ungezaehmte Dschungel macht grosse Gebiete schwer zugaenglich.");
    
  AD(("gebiete"),
    "Die bekannten Gebiete erstrecken sich zwar schon weit von Tijara bis zu "
    "den abgelegen lebenden Steingiganten, aber der Kontinent ist sicher noch "
    "viel groesser.");
    
  AD(({"giganten","steingiganten"}),
    "Die Steingiganten leben noerdlich von hier in Hoehlen in der Schlucht.");
    
  AD(({"hoehle","hoehlen"}),
    "Die Hoehlen erstrecken sich tief ins Gestein.");
    
  AD(("tijara"),
    "Wer Tijara nicht kennt ist nicht hier.");
     
  AD(({"sandsteinwaende","waende","uferwaende","uferwand","wand","sandsteinwand",
       "schluchtwand","schluchtwaende"}),
    "Der milde, gelbe Sandstein bildet hier keine durchgehenden Uferwaende mehr "
    "sondern ist in zerklueftete Felsbloecke zerbrochen.");
        
  AD(({"felsbloecke","felsen","bloecke","block"}),//hier sollte maln ausgang der bukkenhoehle hin
    "Gewaltige Felsbloecke bilden hier, aufeinandergetuermt und aneinandergereiht, "
    "die ca 140 meter hohen Uferwaende.");
    
  AD(({"schatten","sonne"}),
    "Ungehindert brennt die Sonne vom Himmel und glaenzt auf den kahlen "
    "Glatzen der Felsbloecke.");
    
  AD(({"glatzen","haeupter"}),
    "Die steinernen Haeupter der titanischen Felsbloecke sind zerfurcht von "
    "Regenrinnen in die sich duerre, hartnaeckige Pflanzen eingenistet haben.");
      
  AD(({"pflanzen","pflanze"}),
    "Genuegsam und hartnaeckig krallen sich Gras und kleine Buesche in das "
    "wenige Erdreich das sich in den Regenrinnen gesammelt hat.");

  AD(({"gras","buesche"}),
    "Die Pflanzen wachsen weiter oben wo die Uferwaende flacher sind, "
    "darum kannst Du nichts genaueres erkennen.");

  AD(({"erdreich","erde"}),
    "Erde die der Regen vom Dschungel in die Rinnen gespuelt hat.");
    
  AD(({"rinne","regenrinne","rinnen","regenrinnen"}),
    "Da die Uferwaende besonders weiter oben noch weniger steil sind als im "
    "Norden, wo diese immer hoeher werden, bieten sie dem Regen eine groessere "
    "Angriffsflaeche.");
    
  AD(({"angriffsflaeche","flaeche"}),
    "Der Regen waescht Rinnen aus dem Fels.");
    
  AD(({"dschungel"}),
    "Oberhalb des Schluchtrandes wuchert der Dschungel. Du glaubst seinen "
    "suessen wuerzigen Duft schon riechen zu koennen.");
    
  AD(({"wind","duft"}),
    "der Wind traegt dem Duft von lockenden Blueten zu Dir herunter.");
    
  AD(({"spalten","spalte"}),
    "Die Zwischenraeume zwischen den Felsen bilden tiefe Spalten.");
    
  AD(({"boden","grund"}),
    "Da das Wasser recht trueb ist kannst Du den Grund nicht erkennen.");
  
  AD(({"zwischenraeume","zwischenraum"}),
    "Die Spalten sind zu eng um mit dem Fisch erforscht zu werden."
    "Als Du naeher an eine kopfbreite Spalte heransteuerst faellt "
    "Dir ein schwaches Leuchten auf.");
  
  ASD(("leuchten"),
    "leuchten");
    
  ASD(({"quietschpilze","pilze","quietschpilz","pilz","schwamm"}),
    "pilz");
    
  ASD(({"brei","ueberreste","rest","reste"}),
    "ignoranz");
    
  AD(({"schwammart","art"}),
    "Der stiellose Pilz waechst gerne in feuchten Felsspalten und ueberzieht "
    "diese mit leuchtenden birnenfoermigen Pilzkoepfen.");
    
  AD(({"pilzkopf","pilzkoepfe"}),
    "Druecke doch einmal einen von ihnen.");
    
  AD(({"geraeusche","geraeusch"}),
    "Wie dieser Schwamm diese Geraeusche erzeugt ist noch ein Raetsel.");
    
  AD(({"raetsel"}),
    "Dieses Raetsel hat schon viele gelehrte Koepfe zum Rauchen gebracht.");  
  
  AD(("rauchen"),
    "Ist ungesund (tut mir leid aber liebevoller gehts nicht wenn Du ´zum "
    "Rauchen´ untersuchst.)");
    
  AD(({"kopf","koepfe"}),
    "Vielleicht kommst Du der Sache mit einem Experiment naeher. "
    "Du koenntest versuchen den Schwamm zu simulieren und so seinen "
    "Quietschmechanismus nachvollziehen.");
    
  AD(({"experiment","sache"}),
    "Wenn Du keine Lust auf Experimente hast, kannst Du den Pilz ja auch "
    "vernichten.");
  
  AD(("lust"),
    "Wenn Du keine Lust hast die Pilze genauer zu untersuchen gibt es "
    "noch eine andere Moeglichkeit wie Du behaupten kannst Du verstuendest alles.");
    
  AD(("moeglichkeit"),
    "Vernichte die Pilze.");
    
  AD(({"mechanismus","quietschmechanismus"}),
    "simuliere pilz.");  
  
  AddCmd(("simuliere"), "func_wuerstchen");
  
  AddCmd(("vernichte"), "func_befriedigung");
  
  AddCmd(("druecke"),   "func_quietsch");    
  
 
  NORD
  SUED
  

 AddSound( DEFAULT_SOUND,
   "Der Fluss plaetschert in den Spalten zwischen den Felsen.");
   
 AddSmell( DEFAULT_SMELL,
   "Der Wind traegt bereits den wuerzigen Duft des Dschungels zu Dir herueber.");
   
 AddSmell(({"dschungel","blueten","duft"}),
   "Der suesse Duft von exotischen Blueten.");
   
}


 NORDF(fluss17) 
 SUEDF(fluss19)
 
 
int func_wuerstchen(string str)
{
  notify_fail( "Was willst Du simulieren?\n");
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" simuliert einen pilz in fluss18.\n");
	
  if(str=="pilz"||str=="schwamm"||str=="quietschpilz"||str=="pilze"||
     str=="schwaemme"||str=="quietschpilze") {
     	
  write(BSL("Du versetzt Dich intensiv in die Lage des Pilzes und versuchst ihn "
           "nachzuahmen...\n "
           "Du schaust moeglichst bloed drein und stichst Dir mit dem Finger "
           "ins Auge...\n !!!QUIIIEK!!!\n"));
           
  say(BSL("\n"+TPN+" simuliert einen Quietschpilz und quietscht erschrocken "
          "auf."));
    
return 1;}
return 0;}

int func_befriedigung(string str) {
	
  notify_fail("Was willst Du vernichten?\n");
  
  if(str=="pilz"||str=="quietschpilz"||str=="pilze"||str=="quietschpilze"||
     str=="schwamm"||str=="schwaemme")   {
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" ist in fluss18 konstruktiv.\n");
	
  if(pilz) {
  	
  write(BSL("\nDu gehst das Problem von der sensiblen Seite an und "
            "zerdrueckst den Schwamm an der Wand einfach zu Brei."));
           
  say(BSL("\n"+TPN+" laesst seiner Zerstoerungswut freien Lauf."));
    
  pilz=0;
  
return 1;}

  if(!pilz) {
  	
  write(BSL("\nEs sind leider keine Pilze mehr ueber. Sie kleben bereits alle "
            "als Brei auf der Felswand."));
  say(BSL("\n"+TPN+" sucht etwas in Felsspalte."));
  
return 1;}
return 0;}
return 0;}

int func_quietsch(string str) {
  	
  notify_fail("Was willst Du druecken?\n");
   
  if(str=="pilz"||str=="quietschpilz"||str=="schwamm"||str=="pilze"||
     str=="quietschpilze"||str=="schwaemme") {
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" quietscht in fluss18.\n");
		
  write(BSL("\n!!!!QUIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIEEEEETSCH!!!!"));
   
    say(BSL("\n!!!!QUIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIEEEEETSCH!!!!"));
  
return 1;}
return 0;}

pilz() {
  
  if(!pilz) {
  	 
  return BS("Diese stiellose Schwammart gibt quietschende Geraeusche von "
            "sich wenn man sie drueckt. Leider hat hier jemand ziemlich "
            "gewuetet und die Pilze zerdrueckt.");
               }
  if(pilz) {
  	
  return BS("Diese stiellose Schwammart gibt quietschende Geraeusche von sich "
            "wenn man sie drueckt.");
              }
        }

ignoranz() {
	
  if(pilz) {
  
  return BS("Welchen Brei meinst Du?");
         }
  if(!pilz) {
  	
  return BS("Die Reste dieser friedlichen, wunderbaren Pilze kleben brutal "
            "vernichtet an der Felswand.");
              }
      }

leuchten() {
	
  if(pilz) {
  return BS("An den feuchten Waenden wachsen fluoreszierende Quietschpilze.");
                }
  if(!pilz) {
  	
  return BS("An den feuchten Waenden kleben die Ueberreste zerquetschter "
            "Quietschpilze.");
                }
          }