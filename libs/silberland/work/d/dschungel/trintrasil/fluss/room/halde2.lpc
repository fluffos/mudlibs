#include <moving.h>
#include <properties.h>
#include <language.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";

int anzahl=5;

reset() {
   ::reset();
   anzahl=5;}
   
void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Du naeherst Dich nun der Bruchstelle der Uferwand wo die Schutthalde "
"etwas flacher wird. Durch die Abflachung hat sich hier Erde angesammelt "
"sodas auch ein kleiner Piffpaffbusch Wurzeln schlagen konnte. Ober Dir "
"kannst Du zwischen den Felsen ein Nest erkennen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );  
 
  AD(({"fisch"}),
    "Dem gefaellt es im Fluss sicher besser.");

  AD(({"bruchstelle","stelle"}),
    "An dieser Stelle hat die Erosion die Uferwand zum Abrutschen gebracht.");
  
  AD(("abflachung"),
    "Hier direkt unter der Bruchstelle ist die Schutthalde flacher.");
    
  AD(({"abrutschen","sturz","felssturz"}),
    "Die Felsen sind bis in den Flusslauf gestuerzt.");
    
  AD(({"flusslauf","lauf"}),
    "Der Fluss fliesst weit unter Dir durch die Schlucht.");
    
  AD(("erosion"),
    "Wahrscheinlich hat sie den Felssturz verursacht.");
    
  AD(({"felsen","fels"}),
    "Einige grosse, kantige Felsen liegen auf der Kuppe der Schutthalde. "
    "Zwischen ihnen hat ein Fischadler ein Nest gebaut.");
    
  AD(({"schutthalde","halde","hang"}),
    "Der eingebrochene Hang ist uebersäht mit gelben, kantigen Truemmerstuecken.");
    
  AD(({"uferwand","wand","felswand"}),
    "Der nicht eingebrochene, ueberhaengende Teil der Uferwand erhebt sich "
    "noch einige meter ueber die Kuppe der Schutthalde hinaus.");
  
  AD(({"waende","schluchtwaende","felswaende"}),
    "Die beiden Schluchtwaende sind hier insgesamt ca 180 meter hoch, wobei diese "
    "Felswand teilweise abgerutscht ist und eine Schutthalde bildet, auf der Du Dich "
    "gerade befindest.");
  
  AD(("teil"),
    "Die Uferwand erhebt sich noch ca 20 meter ueber die Kuppe der Bruchstelle "
    "hinaus.");
    
  AD(({"fluss","rio de la puseta","band","rio","puseta"}),
    "Wie ein gruenes Band windet sich der Fluss durch die Schlucht.");  
    
  AD(("schlucht"),
    "Die Schlucht hat der Rio de la Puseta in den Dschungel gegraben.");
  
  AD(({"truemmer","truemmerstuecke","steine","boden"}),
    "Durch die angeschwemmte Erde liegen die Steine hier weniger lose.");
    
  AD(("erde"),
    "Hier hat sich schon genug Erde gesammelt um einen kleinen Piffpaffbusch zu "
    "ernaehren.");
    
  AD(({"wurzeln","halt"}),
    "Die Erde reicht aus um den Wurzeln des Busches genug Halt zu geben.");

//SD
  
  ASD(({"piffpaffbusch","busch","piffpaff"}),
    "busch");

  ASD(({"druck","schoten","glueck","schote"}),
    "schote");
  
  AD(({"dschungel","rand"}),
    "Der Dschungel liegt hinter dem Rand der Schlucht verborgen.");

  AD(({"nest","kuppe"}),
    "Etwas erhoeht auf der abgeflachten Kuppe der Schutthalde hat ein "
    "Fischadler sein Nest erbaut. Fuer etwaige Schaendungen und "
    "Pluenderungen musst Du Dich schon hinein wagen.");
    
  AD(({"schaendungen","schaendung","pluenderungen","pluenderung"}),
    "Fuer einen echten Helden doch Kavaliersdelikte.");
        
  ASD(({"kavaliersdelikte","helden","delikte","delikt","kavaliersdelikt","held"}),
    "held");

  AD(({"retter","retterin"}),
    "Dann lass das Nest eben in Ruhe. Weichei.");
    
  AD(({"ruhe","weichei"}),
    "Pfffff. Feig!");
        
  AD(("himmel"),
    "Der Himmel verhaelt sich relativ unauffaellig.");
      
      
  AddCmd(({"druecke","drueck","sekiere"}), "func_piff");
  
  AddExit("unten",  "./halde1" );
  
  
  AddGuardedExit( "nest", "/d/dschungel/trintrasil/fluss/room/nest", "adler",
           "!!!KRAAAAAAAAAAAARRRRKKKKKKKKK!!! Der Adler laesst Dich nicht vorbei.\n"   );
  
  
  AddItem("/d/dschungel/trintrasil/fluss/npc/adler.lpc" ,REFRESH_DESTRUCT);


  AddSound( DEFAULT_SOUND,
    "Hoch ueber Dir hoerst Du den Schrei eines Fischadlers.");
 
  AddSound(({"schrei","fischadler","adler"}),
    "!!KRAA KRAAAAA!!");
}


int func_piff(string str) {
	
	object samen;

write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" drueckt schoten in halde2.\n");
	  	
	notify_fail("Was willst Du druecken?\n");
	
	if(str=="schote"||str=="schoten"||str=="schote auf"||str=="schoten auf"||
	str=="piffpaffschote"||str=="piffpaffschote auf"||str=="busch"||
	str=="piffpaffbusch"||str=="samen") {
		
		if(anzahl) {
			
			write(BSL("Die Schote zerplatzt mit einem lauten...\n"
			"!!!!!!!!PIIIIIIIIIIIIIIIFFFPAAAAAAAAAAAAAAAFFF!!!!!!!!\n"
			"Feine rote Samen schiessen aus der Schote.\n"));
			say(BSL(""+TPN+" drueckt eine Piffpaffschote...\n"
			"!!!PIIIIIIIIIIFFFPAAAAAAAAAAFFF!!!\n"
			"Feine rote Samen schiessen aus der Schote.\n"));
			samen=CLONEOB("/d/dschungel/trintrasil/fluss/npc/samen.lpc");
			samen->move(environment(TP), M_TPORT);
			anzahl--;
			return 1;
		}
		
		if(!anzahl) {
			
			write(BS("Alle reifen Schoten sind schon aufgeplatzt.\n"));
			say(BS(""+TPN+" sucht den Piffpaffbusch nach reifen Schoten ab.\n"));
			return 1;
		}
		return 0;
	}
	return 0;
}


busch() {
	
  if(anzahl) {
  	
  return BS("Dieser tropische Busch traegt pralle, rote Schoten die schon bei "
            "leichtem Druck aufplatzen.");
  }

  if(!anzahl) {
  	
  return BS("Auf dem Piffpaffbusch haengen lauter leere oder noch unreife rote "
            "Schoten.");
  }
}

schote() {
	
  if(anzahl) {
  	
  return BS("Die Schoten sind gerade reif...versuch Dein Glueck.");
  }
  
  if(!anzahl) {
  	
  return BS("Wenn Du Schoten aufdruecken willst musst Du warten bis sie wieder "
            "nachreifen.");
  }
}


held() {
	
	if(TP->QueryProp(P_GENDER)==FEMALE) {
		return(BS("Ruuuuuuuuuuuuueeeeelps! Du BOOOOEERSOOOERK? "
		"Oder bist Du mehr die sensible Retterin?"));
	}
	
	else {
		return(BS("Ruuuuuuuuuuuuueeeeelps! Du BOOOOEERSOOOERK? Oder "
		"bist Du mehr der sensible Retter?"));
	}
}


adlerpresent() {
	
	if(present("fischadlerweibchen", TO)) {
		return 1;
	}
	
	if(!present("fischadlerweibchen", TO)) {
		return 0;
	}
}
