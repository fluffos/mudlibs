#include <properties.h>
#include <language.h>
#include <moving.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"


int PreventInsert(object ob)  {
	
        ::PreventInsert(ob);
        call_out("PrevIns", 1+random(4), ob);
}

PrevIns(object ob) {
	
	if( !ob || !present(ob, TO) || living(ob) ) {
		
	return 1;}
	
	if( ob && present(ob, TO) ) {
		
		tell_room(TO, BSL("\n"+capitalize(ob->name(WER, 0))+" versinkt "
		"gluckernd im Fluss.\n") );
		ob->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_TPORT+ 
		M_SILENT);
		tell_room(ENV(ob), BSL("\n"+capitalize(ob->name(WER, 0))+" wird "
		"auf den Felsblock gespuelt."));
	return 1;}
return 0;}

void create()
{
  ::create();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Du befindest Dich in einer hohen, hellen Hoehle. Licht faellt von der Schlucht "
"herein und laesst das blaugruene, seichte Wasser leuchten. Die gelben "
"Hoehlenwaende schimmern feucht in den sanften Reflexionen des Wassers. "
"Enttaeuscht stellst Du aber fest das die Hoehle anscheinend nicht besonders "
"tief ist."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_JUNGLE]) );  
  
  
  AD(({"reflexionen","reflexion","muster"}),
    "Das Licht das von der Schlucht her hereinfaellt huscht sanft schimmernd "
    "ueber die Sandsteinwaende.");
  
  AD(("licht"),
    "Das Licht wird mild vom Wasser reflektiert und laesst die Waende sanft "
    "schimmern.");
      
  AD(({"fisch"}),
    "Der Fisch gleited ruhig durch das seichte Wasser.");

  AD(({"hoehle"}),
    "Die gelben Sandsteinwaende der Hoehle schimmern nass. Das reflektierte "
    "Licht malt auf ihnen bewegte Muster.");
    
  AD(({"sandsteinwaende","waende","wand","sandsteinwand","hoehlenwand","hoehlenwaende"}),
    "Die Waende sind der Laenge nach mit gelb-orangen Streifen durchzogen. "
    "Nach Osten laufen sie aufeinander zu und beenden die Hoehle bereits "
    "nach einigen Metern.");
  
  AD(({"osten","meter"}),
    "Am spitzen Ende der Hoehle ragt ein beeindruckender roter Steinblock aus "
    "dem Wasser.");
    
  AD(("ende"),
    "Hm vielleicht ist die Hoehle dort doch nicht zu ende sondern fuehrt hinter "
    "dem Steinblock weiter?");
  
  AD(({"block","steinblock","stein"}),
    "Der Steinblock ist dunkelrot und ca 3 Meter hoch. Aber da er zur Haelfte "
    "unter Wasser liegt koenntest Du trotzdem auf ihn klettern.");
  
  AD(("haelfte"),
    "Klettere auf den Stein.");
    
  AD(("wasser"),
    "Das Wasser des Rio de la Puseta ist hier vollkommen klar und schimmert "
    "tuerkis.");
    
  AD(({"rio","puseta","rio de la puseta","fluss","schlucht"}),
    "Wenn Du Deinen Fisch nach westen steuerst kommst Du auf den Fluss hinaus.");
           
  AD(({"streifen","linie","linien","laenge"}),
    "Gelbliche Linien unterschiedlich gefaebten Gesteins ziehen sich durch "
    "die Hoehlenwand.");
    
  AD(("decke"),
    "Die Waende laufen spitz zusammen.");
    
  AD(({"gestein","fels"}),
    "Das Gestein um Dich herum ist ausschlieszlich Sandstein.");
    
  AD(({"boden"}),
    "Durch das klare tuerkise Wasser kannst Du den weissen, sandigen Grund "
    "sehen.");
  
  AD(("grund"),
    "Das Wasser ist hier nur ca 1,5 meter tief und schimmert nahezu "
    "regungslos.");
    
  AD(({"sand"}) ,  
    "Der Sand scheint hier aus dem Fels geschuerft worden zu sein.");
    
  AD(({"sandstein"}),
    "Der Sandstein schimmert in Deinem Licht in den unterschiedlichsten "
    "Gelbtoenen.");
    
  AD(({"gelbtoene","toene","faerbung"}),
    "Erstaunlich warum der Sandstein keine einheitlich Faerbung hat. ");
    
  
  AddCmd(({"klettere","kletter"}), "func_stein");
  AddCmd(("beherrsche"), "prevent_elementar");
  AddCmd(("zaubere"), "prevent_undead_magic");
  AddCmd(("drider"), "no_spiders_wanted");
    
  WEST


 AddSound( DEFAULT_SOUND,
   "Leise rieselt Wasser von der Decke.");
 
  AddSound(("wasser"),
  "plitsch, plitsch, platsch"); 
 

  }


 WESTF(fluss10)
 

no_spiders_wanted() {
	
	if( TP->QueryProp(P_GUILD)!="dunkelelfen" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst einen Drider zu rufen, kannst Dich aber "
		"auf dem schwankenden Ruecken des Fisches nicht konzentrieren."));
		return 1;
	}
}


prevent_undead_magic(string str) {//leichen versinken zwar ohnehin sofort im Fluss, aber wer weiss..
	
	if( TP->QueryProp(P_GUILD)!="nekromanten" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Deine dunklen Kraefte zu buendeln, kannst "
		"Dich aber auf dem schwankenden Fisch nicht konzentrieren."));
		return 1;
	}
}


prevent_elementar(string str) {
	
	if( TP->QueryProp(P_GUILD)!="druiden" || str!="eiselementar"||str!="feuerelementar"||
	str!="eiselementar"||str!="wasserelementar"||str!="humuselementar") {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Dich auf die Beherrschung zu konzentrieren, "
		"findest aber auf dem schwankenden Ruecken des Fisches nicht die notwendige "
		"Ruhe."));
		return 1;
	}
}

 
int func_stein(string str) {
	
	notify_fail("Auf was willst Du klettern?\n");
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" will in hoehle auf den stein klettern.\n");
	
	if(str=="auf steinblock"||str=="auf stein"||str=="auf block"||str=="auf fels"||
	str=="auf felsblock") {
		
		if(KONTROLL->flut_aktiv()==0)  {
			
			write(BSL("\nDu wuerdest wirklich gerne wissen wie tief die Hoehle "
			"noch ins Gestein fuehrt. Aber im Moment sieht Dir das hier nicht "
			"geheuer aus.\n"));
			/*
			write(BSL("Du suchst in den Ritzen des Steinblockes nach Halt und "
			"ziehst Dich auf den glitschigen Fels.\n Dein Fisch schwimmt "
			"aus der Hoehle auf den Fluss hinaus.\n\n"));
			TPM("/d/dschungel/trintrasil/hoehle/room/fels.lpc", M_GO,
			"auf einen grossen Felsblock", "klettert", 
			"klettert vom Ruecken eines Fisches herauf");
			tell_room("/d/dschungel/trintrasil/fluss/room/schluchtein",
			BSL("\n@wessen@ Fisch schwimmt aus der Hoehle auf den Fluss "
			"hinaus.\n"));*/
			return 1;
		}
		
		if(KONTROLL->flut_aktiv()==1) {
			
			write(BSL("Das seltsame Rumpeln das bedrohlich aus dem hinteren Teil "
			"der Hoehle grollt ist Dir nicht ganz geheuer."));
			return 1;
		}
		
		if(KONTROLL->flut_aktiv()==2) {
			
			write(BSL("Bei diesen Wassermassen die aus dem hinteren Teil der "
			"Hoehle schiessen waere es glatter Selbstmord zu versuchen in die "
			"Hoehle vorzudringen."));
			return 1;
		}
		return 0;
	}
	return 0;
}


flucht() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(living(inv[i])) {
			
			inv[i]->move("/d/dschungel/trintrasil/fluss/room/fluss10", M_GO,
			"aus der Hoehle", "flieht", "kommt fluchtartig hinter den "
			"oestlichen Felstuermen hervor.");
			return 1;
		}
		return 0;
	}
	return 0;
}