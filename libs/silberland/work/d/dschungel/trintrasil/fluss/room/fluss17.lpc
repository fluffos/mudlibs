#include <properties.h>
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
        "Die Canyonwaende werden von Nordosten nach Sueden immer niedriger. "
        "Die Sandsteinwaende bestehen aus klobigen Felsbloecken die etwas "
        "abgesunken sind, wodurch die Schlucht weniger schattig und dunkel "
        "erscheint als weiter gegen Norden hin. Ungehindert strahlt die Sonne "
        "auf den gruenen Fluss, der sich ruhig durch die titanischen Steinbloecke "
        "seinen Weg zum Meer sucht." ));
                
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN:TT_WATER]) );  
  
  AD(("sueden"),
    "Nach Sueden hin werden die Schluchtwaende immer niedriger. Hier sind sie "
    "nur noch ca 160 meter hoch.");
    
  AD(({"schlucht","canyon","norden","nordosten"}),
    "Die Sandsteinwaende der Schlucht werden nach Norden hin zunehmend hoeher. "
    "hier scheint die Sonne beinahe ungehindert auf den Fluss.");
    
  AD(({"fluss","rio de la puseta","tier","rio","puseta"}),
    "Wie ein stures Tier kriecht der Fluss, nach sueden hin immer breiter "
    "werdend unbeirrt dem Meer entgegen.");
    
  AD(({"meer","ungeduld"}) ,  
    "In scheinbarer Ungeduld sich zu vereinigen schiebt sich "
    "der Rio de la Puseta dem Meer entgegen.");
    
  AD(({"sandstein","stein"}),
    "Der glatte Sandstein schimmert im Licht der Sonne in hellem gelb und "
    "orange.");
   
  AD(("weg"),
    "Zum Meer ist es noch sehr weit.");
    
  AD(({"fels","bloecke","felsbloecke","steinbloecke","stein","ufer"}),
    "Wie schlafende Zyklopen bilden riesige, ca 160 meter hohe Felsbloecke das "
    "Ufer.");
    
  AD(({"zyklopen"}),
    "Eng beieinanderstehend bilden diese sandsteinernen, gelben Zyklopen "
    "die Uferwand.");
     
  AD(({"sandsteinwaende","waende","uferwaende","uferwand","felswaende","wand","canyonwaende"}),
    "Der milde, gelbe Sandstein bildet hier keine durchgehenden Uferwaende "
    "sondern ist in zerklueftete Felsbloecke zerbrochen, zwischen denen "
    "tiefe Spalten klaffen.");
        
  AD(({"schatten","sonne"}),
    "Ungehindert brennt die Sonne vom Himmel und glaenzt auf den kahlen "
    "Glatzen der Felsbloecke.");
    
  AD(({"glatzen","haeupter","haupt","glatze"}),
    "Nicht eine Pflanze waechst auf den steinernen Haeuptern der Zyklopen.");
      
  AD(("pflanze"),
    "Du kannst zwar noch keine Pflanzen sehen, glaubst aber schon den "
    "wuerzigen, verlockenden Duft des Dschungels zu riechen.");

  AD(({"duft","dschungel"}),
    "Der Dschungel ist ober den Felswaenden verborgen.");

  AD(({"spalten","felsspalten","spalte","spalt"}),
    "Die Zwischenraeume zwischen den Felsen bilden tiefe Spalten.");
  
  AD(({"zwischenraeume","zwischenraum"}),
    "Als Du naeher an die oestliche Uferwand heranschwimmst faellt Dir eine "
    "besonders breite Kluft auf.");
    
  ASD(({"kluft","hoehle","hoehlen"}),
    "hoehle");

  ASD(("umriss"),
    "umriss");

  AD(("fackel"),
    "wirf fackel in hoehle.");
      
  AD(("kanu"),
    "Das Kanu ist gerade gross genug fuer zwei Menschen und wurde aus einem einzelnen "
    "Baum gehauen. Vielleicht weiss ein Lebewesen das hier am Fluss lebt etwas ueber "
    "diese Hoehlen.");
  
  AD(({"wesen","lebewesen"}),
    "Angeblich leben hier am Fluss Flussfeen. Die kennen hier sicher jeden "
    "Winkel.");
    
  AD(("winkel"),
    "Anscheinend befinden sich Hoehlen im Fels zu denen es sicher mehrere "
    "Eingaenge gibt.");
    
  AD(({"fee","flussfee","feen","flussfeen"}),
    "Flussfeen leben gern in der Naehe eines Wasserfalles.");
    
  AD(("wasserfall"),
    "Der naechstgelegenste Wasserfall ist der ´Zehn Ochsen´.");
    
  AD(({"ochsen","zehn ochsen","zehn","naehe"}),
    "Der Zehn Ochsen muendet weiter noerdlich in einem eindrucksvollen "
    "Wasserfall in den Rio de la Puseta.");
      
  AD(("baum"),
    "Wer das Kanu wohl dort hineingebracht hat.");
    
  AD(({"menschen","mensch"}),
    "Der Erbauer des Kanus war anscheinend ein Mensch. Seltsam, was treibt ein Mensch "
    "in diesem abgelegenen Hoehlensystem?");
    
  AD(("erbauer"),
    "Um ihn zu treffen musst Du irgendwie in das Hoehlensystem gelangen das "
    "anscheinend diesen Fels durchzieht.");
    
  AD(({"system","hoehlensystem"}),
    "Dieser Eingang ist fuer Dich mit dem Fisch leider zu schmal.");
    
  AD(({"eingang","eingaenge"}),
    "Es gibt sicher noch andere Eingaenge.");
    
  AD(("wind"),
    "Der Wind riecht nach den schweren Blueten des Dschungels.");
    
  AD(("blueten"),
    "Ueber die Felswaende wird es schwer sein in den Dschungel zu gelangen.");
    
  AD(({"boden","grund"}),
    "Du kannst den Grund des Flusses nicht durch das gruene Wasser erkennen.");
    
  AD(("wasser"),
    "Der Rio de la Puseta ist wegen seinem hohen Naehrstoffgehalt so gruen.");
    
  AD(({"gehalt","naehrstoffgehalt","naehrstoffe"}),
    "Baeche aus dem Dschungel die in den Fluss muenden reichern den Fluss stark "
    "mit Naehrstoffen an.");
    
  AD(({"baeche","bach","beispiel"}),
    "Einer dieser Baeche ist zum Beispiel ´Zehn Ochsen´.");
    
  AD(("himmel"),
    "Der Himmel ist wie immer unauffaellig blau.");
    
  AD(("licht"),
    "Der Schatten der Felswaende liegt hier nicht ueber dem ganzen Fluss.");
  
  AD(("nase"),
    "Durch die Polle schwillt sie langsam entsetzlich an.");
    
  AD(("blick"),
    "Du hast nur einen kurzen Blick in die Hoehle werfen koennen.");
    
  AddCmd(("wirf"), "func_salemmussbrennen");
  
  
  NORDO
  SUED
  

 AddSound(DEFAULT_SOUND,
   "Der Fluss plaetschert dumpf in den Spalten zwischen den Felsen.");
   
 AddSmell(DEFAULT_SMELL,
   "Der Wind traegt bereits den wuerzigen Duft des Dschungels zu Dir herueber.");
 
 AddSmell(("duft"),
   "!!HAAAATSCHI!! ..Verdammte Pollen.");
   
 AddSmell(({"pollen","polle"}),
   "Eine besonders grosse verstopft Deine Nase.");
   
 AddSmell(({"dschungel","blueten"}),
   "Der suesse Duft von exotischen Blueten.");   
}
  
   
 NORDOF(fluss16) 
 SUEDF(fluss18)
 
 
 
int func_salemmussbrennen(string str) {
	
object fackel;
fackel=present("fackel", TP);
  
  notify_fail("Wo willst die Fackel hin werfen?\n");
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" wirft in fluss17 eine fackel in den spalt.\n");
  
  if(str=="fackel in hoehle"||str=="fackel in kluft"||str=="fackel in spalte"||
     str=="fackel nach umriss"||str=="fackel in hoehle"||str=="fackel in kluft"|| str=="fackel in spalt") {
     	
     	WSCHLANGENABFRAGE(
     	write(BSL("\nDu musst erst die Wasserschlange toeten bevor Du "
     	"etwas anderes machen kannst."));,     	
     	
     	
     	if( TP->QueryProp(P_RACE) == "Dunkelelf" ) {
     	write(BSL("\nAls Dunkelelf hasst Du doch dieses schreckliche Licht. "
     	"Das Kanu sehen Deine empfindlichen Augen auch so\n."));
     	}
     	
     	if( TP->QueryProp(P_RACE) != "Dunkelelf" ) {
     		
     	if((fackel)&&(fackel->QueryProp("lighted"))) {
     		write(BSL("\nDu wirfst die brennende Fackel in die "
     		"Kluft. In einem weiten Bogen beleutet sie die engen "
     		"nassen Hoehlenwaende.\nBevor sie im Wasser auftrifft "
     		"und erlischt siehst Du noch wie sich die Hoehle weiter "
     		"hinten verbreitet und trocken wird.\nAusserdem kannst "
     		"Du noch einen kurzen Blick auf ein Kanu "
     		"erhaschen.\n"));
     		say(BSL("\n"+TPN+" wirft eine brennende Fackel in eine "
     		"schmale Kluft in der oestlichen Felswand.\n"));
     		fackel->remove("fackel");
/*  tell_room("/d/dschungel/trintrasil/hoehle/room/hoehle13", BS("Ploetzliche siehst Du "
            "draussen am Fluss eine Bewegung!!"));
  call_other("/d/dschungel/trintrasil/hoehle/room/hoehle13", "fackel_func");
  HOEHLE13 NOCH NICHT ANGEHAENGT */
         return 1;}        
         
         if((fackel)&&(!fackel->QueryProp("lighted"))) {
  	        write(BSL("\nEine nicht angezuendete Fackel bringt Dir "
  	        "wenig."));
         return 1;}
         
         if(!fackel) {
         	write(BSL("\nDu hast ja gar keine Fackel."));
         return 1;}
        })//schlangenabfrageende
        
         return 1;}       
return 0;}
  

hoehle() {
	WSCHLANGENABFRAGE(
	return BS("Dein Fisch kaempft mit einer Wasserschlange. Du musst sie "
	"erst toeten, sonst kannst Du in dem Durcheinander nichts genaueres "
	"erkennen.");,
	return BS("Die Kluft ist leider doch zu eng um mit dem Fisch hinein zu "
	"schwimmen, aber einige meter in der Hoehle faellt Dir ein eigenartiger "
	"Umriss auf.");)
}


umriss() {
	
	if( TP->QueryProp(P_RACE) == "Dunkelelf" ) {
     	return(BSL("\nDu erkennst wie sich die Hoehle weiter hinten verbreitert und trocken wird."
     	"\nAusserdem erkennst Du ein Kanu. Anscheinend sind in diesen Felswaenden "
     	"bewohnte Hoehlen.\n"));
     	}
     	
     	if( TP->QueryProp(P_RACE) != "Dunkelelf" ) {
     	return(BS("Du kannst nichts genaues erkennen. Wenn Du eine brennende Fackel in die "
        "Kluft werfen wuerdest koenntest Du vielleicht sehen was in dieser Spalte ist."));
        }
}
 
 
