#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

dschungelfluss_details();
jagdgebiet();//markiert diesen raum als jagdgebiet fuer fische mittels fischspeer

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Traege fliesst der Rio de la Puseta durch den ueppigen Dschungel. "
"Das Wasser wird hier schlammig und trueb. An den Ufern wuchern dichte "
"Schilfwaelder in denen noch einige hartnaeckige Baeume wachsen. Blutgierige "
"Insektenschwaerme schweben in der drueckenden Hitze ueber dem Wasser. Am "
"suedlichen Ufer entdeckst Du eine freigehackte Stelle."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_WATER]) );  
 
 AD(({"fluss","rio","rio de la puseta","puseta"}),
   "Der Fluss windet sich braun und trueb duerch den ueppigen Dschungel.");
   
 AD(("wasser"),
   "Das Wasser fliesst traege dahin. Die Sonne sticht auf den breiten, "
   "schattenlosen Fluss ueber den laestige, gierige Insektenschwaerme "
   "schweben.");

 AD(({"sonne","himmel","schatten"}),
   "Die Sonne brennt ungehindert auf den Fluss.");
   
 AD(({"weise","schwaerme","insektenschwaerme","insekten"}),
   "Die kleinen Vampiere folgen Dir zielstrebig und stechen Dich staendig "
   "mit einer ungenierten Penetranz.");
   
 AD(("penetranz"),
   "Die Moskitos lassen sich von Deinem hilflosen Gewedel in keiner Weise "
   "beeindrucken.");
   
 AD(({"vampiere","moskitos"}),
   "Wenn Du noch lange hier bleibst saugen sie Dich noch aus.");
   
 AD(("gewedel"),
   "Zu versuchen alle zu erschlagen ist dezent wenig aussichtsreich.");
   
 AD(("weise"),//func
   "Weise waere es die dichten Insektenschwaerme mit einem Flammenwerfer zu "
   "dezimieren, aber der wird hier leider nie erfunden.");
   
 AD(({"flammenwerfer","werfer"}),
   "Besorg Dir eben einen, wenn Du weisst woher.");

 AD(({"grund","boden"}),
   "Du kannst den Grund des Flusses durch das truebe Wasser nicht sehen.");
       
 AD(("baeume"),
   "Einige verkrueppelte Baeume wachsen im dichten, schlammigen Schilfguertel.");
   
 AD(("schilf"),
   "Die Ufer sind sehr dicht mit hohem Schilf bewachsen. Nur am suedlichen Ufer "
   "erkennst Du eine freigehackte Stelle an der Du an Land gehen koenntest.");
   
 AD(({"stelle","land"}),
   "Die schilffreie Stelle ist sicher nicht natuerlich entstanden, sondern "
   "wurde von Menschen freigehackt. Du kannst ja mal dort an Land gehen.");

 AD(({"schilfwaelder","waelder","wald","schilfwald","guertel","schilfguertel"}),
   "Der dichte, undurchdringliche Schilfguertel scheint sehr weitlaeufig zu "
   "sein.");
      
 AD(("menschen"),
   "Angeblich wohnen die Kannibalen in der Naehe, also sei vorsichtig.");
   
 AD(({"naehe","kannibalen"}),
   "Vielleicht fuehrt dort ein Weg zu ihrem Dorf.");
   
 AD(({"dorf","weg"}),
   "Geh eben an Land wenn es Dich interessiert.");

 AD(({"noerdliches ufer","suedliches ufer","ufer"}),
   "Das noerdliche Ufer kannst Du wegen dem dichten Schilf nicht betreten, aber "
   "am suedlichen Ufer erkennst Du eine freigehackte Stelle an der Du an "
   "Land gehen koenntest.");
      
 AD(({"kuehlung","hitze"}),
   "Die Sonne sticht erbarmungslos auf Dich herab. Der Fluss spendet hier kaum "
   "Kuehlung.");
   
 AD(("dschungel"),
   "Du kannst den Dschungel nicht durch die Schilfwaelder sehen, aber er "
   "wuchert sicher dahinter.");


 AddSound( DEFAULT_SOUND,
   "Du hoerst das hohe Summen von unzaehligen blutgierigen Moskitos.");
 
 AddSound(({"summen","moskitos"}),
   "Suuummmmmmm Suuummmmmmm.");


AddCmd(({"gehe","betrete","geh","steige"}), "func_ufer");

AddCmd(({"erfinde","besorge"}), "func_flammenwerfer");

AddCmd(({"erschlage","versuche"}), "func_insekten");


   
  OST
  WEST 
    }


OSTF(dfluss2)
WESTF(fluss21)

int func_ufer(string str) {

    int i, moveint;
    object *inv;
    inv=all_inventory(environment(this_player()));
    	
	notify_fail("Wo willst Du an Land gehen?\n");
	
	if(str=="suedliches ufer"||str=="ufer"||str=="stelle"||
	str=="freigehackte stelle"||str=="schilffreie stelle"||
	str=="am suedliche ufer an land"||str=="am ufer an land"||str=="an "
	"stelle an land"||str=="an freigehackter stelle an land"||str=="an "
	"schilffreier stelle an land"||str=="an freigehackten stelle "
	"an land"||str=="an schilffreien stelle an land"||str=="an land"||
	str=="land") {		

     	if( present("wasserschlange", environment(this_player())) ) {

     		for(i=sizeof(inv)-1;i>=0;i--) {

                        if( inv[i]->id("EVENTSCHLANGE") ) {
                      
                                if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
                                	moveint++;
                                }
                        }
                        if( !inv[i]->id("EVENTSCHLANGE") ||
                        (inv[i]->id("EVENTSCHLANGE") && !inv[i]->QueryProp(""+this_player()->name()+"")) ) {

                        }
                }
                if(moveint>0) {
			write(BSL("\nDu musst die Wasserschlange erst toeten "
			"bevor Du an Land gehen kannst."));
			return 1;
		}
                if(moveint==0) {
			write(BSL("\nDu steuerst Deinen Fisch zum Ufer und "
			"springst im seichten Wasser ab. Dein Fisch schwimmt "
			"wieder hinaus auf den Fluss.\n\n"));
			say(BSL("\n"+TPN+" steuert das suedliche Ufer an und "
			"geht an Land."));
			tell_room("/d/dschungel/trintrasil/dorfneu/room/room9", BSL("\n"+TPN+" "
			"kommt von einem Fisch an Land.\n\n"));
			TP->move("/d/dschungel/trintrasil/dorfneu/room/room9", M_GO+ M_SILENT);
			return 1;
		}
                moveint=0;
         return 1;}
         
         if( !present("wasserschlange", environment(this_player())) ) {
			write(BSL("\nDu steuerst Deinen Fisch zum Ufer und "
			"springst im seichten Wasser ab. Dein Fisch schwimmt "
			"wieder hinaus auf den Fluss.\n\n"));
			say(BSL("\n"+TPN+" steuert das suedliche Ufer an und "
			"geht an Land."));
			tell_room("/d/dschungel/trintrasil/dorfneu/room/room9", BSL("\n"+TPN+" "
			"kommt von einem Fisch an Land.\n\n"));
			TP->move("/d/dschungel/trintrasil/dorfneu/room/room9", M_GO+ M_SILENT);
			return 1;
	 }
return 1;}                        
}


func_insekten(string str) {
	
	notify_fail("Wen willst Du erschlagen?\n");
	
	if(str=="insekten"||str=="insektenschaerme"||str=="schwaerme"||
	str=="moskitos"||str=="moskitoschwaerme"||str=="quaelgeister"||
	str=="alle moskitos"||str=="alle insekten"||str=="alle quaelgeister"||
	str=="insekt"||str=="insektenschwarm"||str=="schwarm"||str=="moskito"||
	str=="moskitoschwarm"||str=="quaelgeist") {
		
		write_file("/d/dschungel/trintrasil/log/flusslog",
		""+ctime()+": "+CAP(getuid(TP))+" erschlaegt insekten in dfluss1.\n");
		
		write(BSL("\nDu fuchtelst wie ein Irrer herum und erwischt "
		"nicht ein einziges Moskito. Du kommst Dir ziemlich schnell "
		"laecherlich vor."));
		say(BSL("\n"+TPN+" fuchtelt wie irr herum. "+TPN+" versucht "
		"wohl ziemlich hilflos ein paar Moskitos zu erschlagen."));
		return 1;
	}
return 0;}
 

func_flammenwerfer(string str) {
	
	notify_fail("Was willst Du erfinden?\n");
	
	if(str=="flammenwerfer"||str=="werfer") {
		
		write_file("/d/dschungel/trintrasil/log/flusslog",
		""+ctime()+": "+CAP(getuid(TP))+" erfindet den flammenwerfer in dfluss1.\n");
		
		write(BSL("\nDu stellst Dir vor wie alle Insektenschwaerme "
		"hell auflodernd verbrennen. Tja traeumen ist erlaubt."));
		return 1;
	}
return 0;}
