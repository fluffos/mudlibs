#include <properties.h>
#include <language.h>
#include <moving.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fischdef.h"


init() {
	
	object schatten;
	schatten=clone_object("/d/dschungel/trintrasil/fluss/npc/schatten.lpc");
	
	::init();
	
	if( living(this_player()) && !interactive(this_player()) && !TP->QueryProp("flussnpc") &&
	!TP->QueryProp("shadow(trint)") ) {
		
		schatten;
		schatten->setze_besitzer();
		TP->SetProp("shadow(trint)", 1);
	}
}


void create()
{
  ::create();


SetProp( P_INT_SHORT, " Rio de la Puseta" );
SetProp( P_INT_LONG, break_string(
"Vorsichtig stehst Du auf einem glitschigen leicht schraegen "
"Felsblock. Der ´Rio de la Puseta´ schwappt ueber den Fels. Vor Dir ragt eine "
"steile, bizarre Schutthalde auf. Du koenntest hier nach einem Fisch pfeifen "
"und auf den Fluss hinaus reiten, wenn Du eine Fischpfeife hast."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );  
 
  AD(({"fisch"}),
    "Du koenntest mit einer Fischpfeife nach einem Fisch pfeifen und auf ihm auf "
    "den Fluss hinaus reiten.");

  AD(({"felsblock","block","fels"}),
    "Der grosse Fels liegt direkt am Fuss einer hohen Schutthalde "
    "im gurgelnden Fluss.");
  
  AD(("fuss"),
    "Die Schutthalde erstreckt sich weit hinauf bis beinahe an den Rand der "
    "Schlucht.");

  AD(({"nordosten","suedosten"}),
    "Wenn Du auf den Fluss hinaus gelangen willst musst Du mit einer "
    "Fischpfeife pfeifen.");
        
  AD(("schlucht"),
    "Die Schlucht fuehrt weiter nach Nordosten und Suedosten. Wenn Du sie "
    "weiter befahren willst musst Du wieder einen Fisch herbei pfeifen.");
    
  AD(({"rand","schluchtrand"}),
    "Der Schutt ist direkt unter dem Schluchtrand losgebrochen.");
    
  AD(({"schutthalde","halde"}),
    "Der eingebrochene Hang ist uebersaeht mit gelben, kantigen Truemmerstuecken.");
    
  AD(({"hang","stelle","sandsteinwand","schluchtwand","uferwand","wand","felswand"}),
    "An dieser Stelle ist die oestliche Uferwand in den Fluss gebrochen.");
  
  AD(({"oestliche wand","oestliche uferwand","oestliche felswand",
       "oestliche schluchtwand","oestliche sandsteinwand"}),
    "Die oestliche Schluchtwand ist hier teilweise abgerutscht und bildet eine Schutthalde, "
    "die vom Fluss beinahe fast bis an den Rand der Schlucht reicht.");
  
  AD(({"waende","schluchtwaende","felswaende","uferwaende","sandsteinwaende"}),  
    "Die gewaltigen Schluchtwaende sind aus gelben Sandstein und schimmern in einem sanften, "
    "warmen Gelb.");
  
  AD(({"sandstein","stein","gelb"}),
    "Der gelbe Sandstein wurde von Wind und Wasser ganz glatt poliert.");

  AD(({"westliche wand","westliche uferwand","westliche schluchtwand","westliche felswand",
       "westliche sandsteinwand"}),
    "Die westliche Schluchtwand ragt unversehrt ca 180 meter in die Hoehe.");
  
  AD(("hoehe"),
    "Der Schluchtrand ist ca 180 meter ueber Dir.");
    
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Gurgelnd umspuelt der Rio de la Puseta den Fels, der vom ueberschwappenden "
    "Wasser feucht und rutschig ist.");  
    
  AD(("wasser"),
    "Immer wieder schwappt Wasser ueber den Felsen hinweg.");
  
  AD(({"truemmer","truemmerstuecke","schutt"}),
    "Mit etwas Anstrengung muesstest Du ueber die Steine hinaufklettern koennen."),
    
  AD(("steine"),
    "Zwischen den kantigen scharfen Steinen wachsen einige hartnaeckige Grashalme, "
    "die mit der wenigen Erde zufrieden sind die der Regen immer wieder von oben "
    "herunter waescht."),
  
  AD(({"regen","himmel"}),
    "Der Himmel ist relativ klar und sieht nicht nach Regen aus.");
    
  AD(({"erde","halme","gras","grashalme"}),
    "Duerre bleiche Halme wachsen zwischen dem Schutt.");

  AD(("anstrengung"),
    "Es ist sicher nicht leicht ueber die steile Schutthalde nach oben zu klettern.");
  
  AD(({"algenbueschel","bueschel","alge","algen"}),
    "Der Fels ist stellenweise mit blauer Glissalge bewachsen.");
    
  AD(({"glissalge","algenart"}),
    "Diese Algenart schmeckt Napfschnecken besonders. Man muss aufpassen das man "
    "nicht ausrutscht wenn man auf sie tritt.");

  AD(("wind"),
    "Der Wind laesst die duerren Grashalme zittern.");
    
  AD(("boden"),
    "Der feuchte Fels ist blauer Glissalge bewachsen.");
   
  AD(({"napfschnecke","schnecke"}),
    "Hier siehst Du leider keine.");
    
  ASD(({"pfeife","fischpfeife"}),
    "fischpfeife");
   
  AD(({"holz","graetenholz"}),
    "Aus dem Holz des Graetenbusches kann man diese kleinen Pfeifen schnitzen "
    "mit denen man eine Frequenz erreichen kann die manche Fischarten "
    "unwiederstehlich anlockt.");
   
  AD(({"graetenbusch","busch"}),
    "Dieser tropische Busch waechst bevorzugt im Flussgebiet des Rio de la "
    "Puseta.");

  AD(({"flussgebiet"}),
    "Du bist mitten im Flussgebiet, auch wenn hier auf dem Felsblock kaum "
    "ein Graetenbusch wachsen kann.");
     
  AD(({"frequenz","ton"}),
    "Die Frequenz ist so tief das sie fuer Deine Ohren nicht wahrnehmbar ist.");
     
  AD(({"ohren","dinge","ohr","kopf"}),
    "Die zwei haesslichen Dinge die da links und rechts von Deinem Kopf "
    "abstehen.");
   
  AD(({"fische","fischarten"}),
    "Manche grosse Fischarten werden von dem Ton dieser Pfeife angelockt.");
 
        
  AddItem("/d/dschungel/trintrasil/fluss/npc/napf.lpc" ,REFRESH_DESTRUCT);


  AddCmd(({"trete","steige","steig"}), "func_alge");


  PFEIFE
  REITEN
  
  
  AddExit( "oben","./halde");


  AddSound( DEFAULT_SOUND,
  "Hoch ueber Dir hoerst Du den Schrei eines Fischadlers.");
 
  AddSound(({"schrei","fischadler","adler"}),
  "!!KRAA KRAAAAA!!");
}
 
  
  
FLUSSFISCHRUF
FLUSSREITFUNC(/d/dschungel/trintrasil/fluss/room/fluss15)
FLUSSFISCHCALLOUTS(um den Felsblock)



  int func_alge(string str) {
  
  notify_fail("Auf was willst Du steigen?\n");
   
  if( str=="auf alge"||str=="auf glissalge"||str=="auf bueschel"||
      str=="auf algenbueschel") {
      	
      	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" tritt auf die glissalge in fels.\n");
  
  write(BSL("\n!!!WUUUUTSCH!!!...\nDeine Beine rutschen unter Dir weg und Du "
            "landest heftig auf dem Hosenboden, und faellst beinahe in den "
            "Fluss."));
        
  say(BSL("\n"+TPN+" testet seinen Gleichgewichtssinn und landet auf dem "
          "Hosenboden."));

return 1;}
return 0;}


lawine() {
	
int i;
object *inv;
inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(living(inv[i])) {
			
			inv[i]->do_damage(25 +random(23));
		}
	}
}

		
fischpfeife() {
	
	if(present("fischpfeife", TP)) {
		return(BS("Du hast ja schon eine Fischpfeife. Du musst nur noch damit "
		"pfeifen."));
	}
	
	else {
		
		return(BS("Diese zierlichen kleinen Pfeifen sind aus Graetenholz geschnitzt. "
		"vielleicht solltest Du Dir erst einen Graetenbusch suchen."));
	}
}
