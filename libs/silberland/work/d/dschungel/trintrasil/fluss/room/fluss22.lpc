//Von diesem Raum aus soll man einmal auf einen Baum klettern koennen, von dem aus man 
//in den Dschungel kommt (geplant fuer spaetere zeiten)

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"

int anakint=1;

void create()
{
  ::create();

dschungelfluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Rio de la Puseta fliesst hier plaetschernd zwischen besonders zaehen "
"Baeumen, die sich mitten im Wasser halten koennen dahin. Viele abgestorbene, "
"weisse Baumstuempfe und abgebrochene, verkrueppelte Aeste ragen aus dem "
"seichten Wasser. Aber es ist hier im Schatten der Blaetterdaecher angenehm "
"kuehl."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
 
AD(({"fluss","rio","rio de la puseta","puseta"}),
  "Der dunkelgruene Fluss plaetschert traege zwischen den Baeumen und "
  "abgestorbenen Stuempfen. Das Wasser ist hier dunkel und trueb, und immer "
  "wieder ragen spitze Aeste heraus.");
  
AD(("wasser"),
  "Das truebe Wasser fliesst hier ueber den Uferstreifen und schwemmt viele "
  "Blaetter und Aeste mit.");
  
AD(({"aeste","blaetter"}),
  "Die Blaetter und Aeste stammen von den umgespuelten Baeumen die im Wasser "
  "vermodern.");
  
AD(({"uferstreifen","streifen","ufer"}),
  "Diese Uferstreifen hier in dem die umspuelten Baeume wachsen ist abwechselnd "
  "ueberschwemmt, so wie jetzt, und trocken.");

AD(({"baum","baeume"}),
  "Einige schwaechere Baeume hat der Fluss umgespuelt oder geknickt. Einige "
  "sehr grosse Baumriesen wachsen anscheinend schon sehr lange hier im "
  "Uferstreifen und breiten ihr maechtiges Blaetterdach aus.");
  
AD(({"struenke","baumstruenke","baumstuempfe","baumstumpf","stuempfe","stumpf"}),
  "Die Baumstuempfe stammen von Baeumen die der umgespuelt oder geknickt hat. "
  "Sie ragen weisslich faulend aus dem Wasser und sind eine Gefahr fuer den "
  "Fisch.");
  
ASD(("gefahr"),
  "gefahr");

ASD(("fisch"),
  "fisch");
    
AD(({"riesen","baumriesen"}),
  "Die Wurzeln einiger alter Baumriesen hat der Fluss freigespuelt, so dass es "
  "aussieht als wuerden sie auf grotesken Beinen stehen. In ihren dichten, "
  "maechtigen Blaetterdaechern siehst Du Lianen haengen.");
  
AD(({"wurzeln","wurzel","baumwurzel","baumwurzeln"}),
  "Die ledrigen, schwarzen Baumwurzeln sind oft einen halben meter dick.");
  
ASD(({"beine","bein"}),
  "bein");

ASD(({"form","pflanze","schlingpflanze"}),
  "form");
  
ASD(("muster"),
  "muster");
  
AD(("lianen"),
  "Die Lianen bilden ein dichtes Netz in den gruenen Blaetterdaechern.");
  
AD(("netz"),
  "Eine dicke Liane haengt so weit herunter, dass Du sie vom Fisch aus "
  "erreichen koenntest.");

AD(("liane"),
  "Du koenntest an der Liane hochklettern. So wurdest Du auf die Aeste des "
  "Baumriesen gelangen koennen.");
  
AD(({"riese","baumriese"}),
  "Der Baum hat dicke, ausladende Aeste, es waere leicht auf ihnen zu klettern. "
  "Vielleicht kommst Du so auf trockenen Boden.");
  
AD(("boden"),
  "Du weisst nicht genau wie tief der Fluss hier ist, aber er ist sicher "
  "recht seicht.");
  
AD(("himmel"),
  "Du kannst den Himmel durch das Blaetterdach nicht sehen.");

AD(("schatten"),
  "Im daemmrigen Schatten der Baeume ist es angenehm kuehl.");
       
AD(({"geaest","dach","daecher","blaetterdach","blaetterdaecher"}),
  "Das ausladende Geaest der Baeume ist dicht mit Lianen bewachsen.");
     
   
AddCmd(({"klettere","kletter"}), "liane_func");


  SUED

}


SUEDF(fluss21)


liane_func(string str) {
	
	notify_fail("Woran willst Du hoch klettern?\n");
	
	if(str=="an liane hoch"||str=="liane"||str=="liane hoch") {
		
		write_file("/d/dschungel/trintrasil/log/flusslog",
		""+ctime()+": "+CAP(getuid(TP))+" will in fluss22 an einer Liane "
		"hochklettern.\n");
		write(BSL("\nDu packst Die Liane und willst daran hochklettern, "
		"erkennst aber, dass das Geaest anscheinen noch nicht fertig "
		"ist und laesst es bleiben."));
	return 1;}
}


gefahr() {
	WSCHLANGENABFRAGE(
	return(BS("Der Fisch kaempft verbissen mit der Wasserschlange. Du musst "
	"ihm helfen!"));,
	return(BS("Der Fisch scheint die Gefaht instinktiv zu spueren und "
	"weicht den ueberspuelten Aesten aus."));)
}


fisch() {
	WSCHLANGENABFRAGE(
	return(BS("Der Fisch kaempft verbissen mit der Wasserschlange. Du musst "
	"ihm helfen!"));,
	return(BS("Der Fisch schwimmt sicher zwischen den Baeumen und den "
	"gefaehrlichen Baumstuempfen umher."));)
}


bein() {
	
	WSCHLANGENABFRAGE(
	return(BS("Du solltest Dich lieber auf die Wasserschlange konzentrieren "
	"bevor sie Deinen Fisch umbringt."));,
	if(present("zahnanakonda", TO)) {
		return(BS("Du hast jetzt bei weitem groessere Probleme als "
		"diese Wurzeln!!"));
	}
	
	if(!present("zahnanakonda", TO) && anakint==1) {
		return(BS("Als Du die dicken Wurzeln genauer betrachtest faellt "
		"Dir eine eigenartige, gebogene Form auf. Ist das etwas eine "
		"Schlingpflanze?"));
	}
	
	if(!present("zahnanakonda", TO) && anakint==0) {
		return(BS("Die ledrigen, schwarzen Baumwurzeln sind oft einen "
		"halben meter dick. Ansonsten scheinen sie unauffaellig zu "
		"sein."));
	})
}


form() {
	
	WSCHLANGENABFRAGE(
	return(BS("Kuemmere Dich lieber erst um die Wasserschlange."));,
	if(present("zahnanakonda", TO)) {
		return(BS("Du hast alle Muehe gegen die Anakonda am Leben zu "
		"bleiben!"));
	}
	
	if(!present("zahnanakonda", TO) && anakint==1) {
		return(BS("Du schwimmst naeher an die vermeindliche Pflanze "
		"heran und erkennst, dass sie von einem regelmaessigen Muster "
		"bedeckt ist."));
	}
	
	if(!present("zahnanakonda", TO) && anakint==0) {
		return(BS("Du entdeckst nichts Auffaelliges zwischen den "
		"Baumwurzeln."));
	})
}


muster() {
	
	WSCHLANGENABFRAGE(
	return(BS("Du solltest lieber erst die Wasserschlange vertreiben."));,
	if(present("zahnanakonda", TO)) {
		return(BS("Du wirst gleich gar kein Muster mehr sehen wenn "
		"Du Dich nicht auf die Anakonda konzentrierst."));
	}
	
	if(!present("zahnanakonda", TO) && anakint==1) {
		say(BS(""+TPN+" stoebert eine Zahnanakonda auf!!"));
		anakint=0;
		call_out("anaklone", 2);
		return(BS("Als Du das Muster aus der Naehe betrachtest erkennst "
		"Du entsetzt ,dass es sich um eine riesige Zahnanakonda "
		"handelt!!"));
	}
	
	if(!present("zahnanakonda", TO) && anakint==0) {
		return(BS("Welches Muster meinst Du? Falls Du hier etwas "
		"Besonderes suchst ist es anscheinend jetzt nicht da."));
	})
}


anaklone() {
	
	object anakonda;
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss22",BSL("\nEine "
	"riesige Zahnanakonda laesst sich vom Baum fallen!!\n\n"));
        anakonda=CLONEOB("/d/dschungel/trintrasil/fluss/npc/anakonda.lpc");
        anakonda->move("/d/dschungel/trintrasil/fluss/room/fluss22", M_GO+ 
        M_SILENT);
}
