#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Fluss fliesst ruhig durch die gelbe Sandsteinschlucht. Mitten im Fluss "
"liegt anscheinend ein gewaltiger Felsblock knapp unter der Wasseroberflaeche. "
"Der Fluss woelbt sich an dieser Stelle rauschend auf und bildet weisse Strudel "
"an der noerdliche Schluchtwand siehst Du einige Rinnen und Felsvorspruenge. Im "
"Osten macht der Fluss eine sanfte Biegung nach Sueden."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  

AD(({"fluss","rio","rio de la puseta"}),
  "Der Fluss woelbt sich an einer Stelle mitten im Fluss ploetzlich rauschend "
  "auf. Er scheint hier ein grosses Hindernis zu ueberspuelen.");
  
AD(({"hindernis","stelle"}),
  "Durch die weissen Strudel schimmert ein gewaltiger Felsblock. Er, soweit "
  "Du das erkennen kannst, ist ca ogergross und dunkelrot.");
  
AD(({"felsblock","block","fels"}),
  "Der Felsblock ist wohl aus der Sandsteinwand gebrochen und in den Fluss "
  "gestuerzt. Dass muss ein handfester Krach gewesen sein.");
  
AD(({"wand","sandsteinwand","felswand","schluchtwand","waende","sandsteinwaende",
     "felswaende","schluchtwaende"}),
  "Die noerdliche Schluchtwand ist von Regenrinnen zerfurcht. Du siehst einige "
  "Felsvorspruenge die ziemlich weit aus der Wand ragen.");
  
AD(({"noerdliche schluchtwand","noerdliche wand","noerdliche sandsteinwand",
     "noerdliche felswand","noerdliche schluchtwand"}),
   "Die gelbe Sandsteinwand ist teilweise vom Regen zerfurcht. Weit oben, "
   "in der Naehe des Randes siehst Du einen Felsvorsprung.");

AD(({"regen","regenrinnen","rinnen"}),
  "Anscheinend scheint hier das Regenwasser aus dem Dschungel die Regenrinnen "
  "hinunterzurinnen.");

AD(("dschungel"),
  "Der Dschungel liegt weit ueber Dir.");
    
AD(({"gewitter","regenwasser"}),
  "Hier in den Tropen gibt es oft heftige Gewitter. Dann fliesst anscheinend "
  " viele Regenwasser die noerdliche Schluchtwand hinab.");
  
AD(("tropen"),
  "Wo hast Du gedacht wo Du bist? Siehst Du hier etwa irgendwo Tannenbaeume?");
  
AD(({"baeume","tannenbaeume","baum","tannenbaum"}),
  "Koennte ein Indiz dafuer sein dass Du in den Tropen bist.");

AD(("indiz"),
  "Aber es ist kein Beweis. Vielleicht sind alle Tannenbaeume ja auch nur gerade "
  "nicht da.");

AD(("beweis"),
  "Ein Gutachten waere hier sicher hilfreich.");

AD(("gutachten"),
  "Das Gutachten wuerde sicher ergeben, dass es sehr vernueftig waere in den "
  "Strudel zu schwimmen.");
          
AD(({"schluchtrand","rand","naehe"}),
  "Der Schluchtrand ist ca 250 meter ueber Dir.");
  
AD(("meter"),
  "Imposant wie senkrecht die glatten Waende aufragen.");

AD(({"suedliche schluchtwand","suedliche wand","suedliche sandsteinwand",
    "suedliche felswand","suedliche schluchtwand"}),
    "Die suedliche Schluchtwand ist glatter als die zerfurchte noerdliche "
    "Schluchtwand.");
    
AD(({"felsvorspruenge","vorspruenge"}),
  "Auf einem Felsvorsprung scheint jemand zu stehen.");
  
AD(({"jemand","vorsprung","felsvorsprung"}),
  "Du kannst so hoch oben kaum etwas erkennen. Da will doch wohl nicht Jemand "
  "von so hoch ins Wasser springen?");
  
AD(({"fall","wasserfall"}),
  "Der Wasserfall ist so weit entfernt, Du kannst ihn kaum erkennen.");
  
AD(("wasser"),
  "Das Wasser baeumt sich weiss rauschend ueber dem mitten im Fluss liegenden "
  "Felsblock auf.");
   
AD(({"groesse","krach"}),
  "Bei der Groesse dieses Felsblockes muss es ganz schoen gekracht haben.");
  
AD(({"schlucht","sandsteinschlucht"}),
  "Die gewaltigen Schluchtwaende der gelben Sandsteinschlucht sind beinahe "
  "250 meter hoch. Im Osten siehst Du, dass die Schlucht eine Biegung nach "
  "Sueden beschreibt. Weit im Westen glaubst Du noch undeutlich einen "
  "Wasserfall zu erkennen.");
  
AD(({"biegung","osten"}),
  "Schwimme doch nach Osten um die Biegung.");
  
AD(("westen"),
  "Im Westen erkennst Du einen Wasserfall, der schon sehr weit entfernt ist.");
  
AD(("sueden"),
  "Wie der Fluss im Sueden weiter fliesst erkennst Du hinter der Biegung.");

AD(({"grund","flussgrund","boden"}),
  "Auf dem Flussgrund liegt ein gewaltiger Felsblock.");
  
AD(("strudel"),
  "Die Strudel sehen unberechenbar und wild aus. Du solltest nicht in einen "
  "Strudel schwimmen. Du weisst nicht wie weit unter der Oberflaeche der "
  "Felsblock liegt.");
  
AD(({"flaeche","oberflaeche","wasseroberflaeche"}),
  "Die Strudel ueber dem Felsblock sehen nicht ungefaehrlich aus.");
  
AD(("himmel"),
  "Der Himmel ist blau, wie sonst auch meistens.");

AD(({"sandstein","sandgestein","gestein","stein"}),
  "Die Waende der Schlucht sind aus gelb schimmerndem Sandstein.");


ACD(({"reite","schwimme"}), "strudel");  
    
    
AddItem("/d/dschungel/trintrasil/fluss/npc/natter", REFRESH_DESTRUCT);



AddSound( DEFAULT_SOUND,
   "Aus dem Westen hoerst Du leise das Rauschen eines Wasserfalles.");
   
AddSound(({"rauschen","wasserfall"}),  
   "Aus dem Westen hoerst Du leise das Rauschen eines Wasserfalles.");


  OST
  WEST 
    }


OSTF(fluss6)
WESTF(fluss4)


strudel(string str) {
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" schwimmt in den Strudel in fluss5.\n");
	
	notify_fail("In was willst Du schwimmen?\n");
	
	if(str=="strudel"||str=="in strudel"||str=="in einen strudel"||
	str=="durch strudel"||str=="durch einen strudel"||str=="ueber strudel"||
	str=="ueber einen strudel"||str=="in den strudel"||
	str=="durch den strudel"||str=="ueber den strudel") {
		
		WSCHLANGENABFRAGE(			
		write(BSL("\nDein Fisch kaempft mit einer Wasserschlange. Du "
		"kannst ihn nicht steuern bis Du die Schlange getoetet hast."));,
			
		switch(random(3)) {
			
			case 1..2: write(BSL("\nDu steuerst Deinen Fisch genau "
			"auf den grossen Strudel zu.\n"
			"Ploetzlich wird Dein Fisch hochgerissen und bockt "
			"erschreckt, wirft Dich aber nicht ab.\nDiesmal hast Du "
			"aber Glueck gehabt!\n\n"));
			say(BSL("\n"+TPN+" steuert seinem armen "
			"Fisch mitten durch einen Strudel.\n\n"));
			break;
			
			case 0: write(BSL("\nDu steuerst Deinen Fisch genau auf "
			"den grossen Strudel zu.\n"
			"Ploetzlich wird Dein Fisch hochgerissen, bockt "
			"erschreckt und wirft Dich ab.\n\n"));
			say(BSL("\n"+TPN+" steuert seinen Fisch mitten durch "
			"den grossen Strudel.\n"
			"Ploetzlich bockt der Fisch und wirft "+TPN+" ab.\n\n"));
			TP->move("/d/dschungel/trintrasil/fluss/room/strudel-h",
			M_GO+ M_NO_SHOW+ M_SILENT);
			break;
			
			default: write(BSL("\nDu steuerst Deinen Fisch genau "
			"auf den grossen Strudel zu.\n"
			"Ploetzlich wird Dein Fisch hochgerissen und bockt "
			"erschreckt, wirft Dich aber nicht ab.\nDiesmal hast Du "
			"aber Glueck gehabt!\n\n"));
			say(BSL("\n"+TPN+" steuert seinem armen "
			"Fisch mitten durch einen Strudel.\n\n"));
		return 1;})
	return 1;}
return 0;}

	
		 
		