
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";



create()
{
  ::create();

  SetProp( P_INT_SHORT, "Nachdem TP vom Kaiman vom Fisch geschlagen wurde." );
  SetProp( P_INT_LONG, BS(
  "Sollte niemand sehen."));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no() {
 	
   write("Du bist benommen und kannst Dich kaum bewegen.\n");
     return 1;
   }
   

  init() {
  	
  ::init();

  if(query_once_interactive(this_player())){
  	call_out("spell1", 3);}
  }
  

   spell1() {
    
   NIX
   write(BSL("\nIn einem hohen Bogen faellst Du ins Wasser.\n"));
   call_out("spell2", 2);
   }
   
   
    
   spell2() {
   
   NIX
   write(BSL("\nBenommen spuerst Du wie Wasser in Nase und Mund eintrinkt und "
   "wie Dich der Fluss vom Kampfplatz fort traegt.\n"));
   call_out("spell3", 2);
   }
 
 
    
   spell3() {
   
   NIX
   write(BSL("\nDu versuchst Dich muehsam ueber Wasser zu halten, doch "
   "vergeblich. Du gehst unweigerlich unter.\n"));
   call_out("spell4", 3);
   }
 
    
    
   spell4() {
   
   NIX
   write(BSL("\nPloetzlich wirst Du gegen einen Felsen gespuelt. Du ringst "
   "ertrinkend nach Luft.\n"));
   call_out("spell5", 2);
   }
    
    
    
   spell5(object pl) {
   
   NIX
   write(BSL("\nDu bekommst den Felsen zu fassen und ziehst Dich muehsam daran "
   "aus dem Wasser.\n\n"));
   tell_room("/d/dschungel/trintrasil/fluss/room/dfluss4",
   BSL("\n"+TPN+" wird halb ertrunken auf den Fels gespuelt.\n\n"));
   TP->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_GO+ M_SILENT+ M_NO_SHOW);
   }

  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  