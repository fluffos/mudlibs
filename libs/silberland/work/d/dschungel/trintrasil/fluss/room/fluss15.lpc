#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Eingefasst von den gelben Waenden der Schlucht fliesst der "
    "smaragdgruene Rio de la Puseta dem Meer entegegen. Die oestliche "
    "Uferwand ist etwas nach hinten eingebrochen und daher weniger steil "
    "als die beinahe senkrechte westliche Uferwand. Der Fluss bricht schaeumend "
    "an den Truemmern und Splittern die durch den Felssturz in den "
    "Flusslauf gestuerzt sind. Die im norden der Schlucht so zahlreichen "
    "Felstuerme sind hier nur noch einzeln vorhanden. Aus Nordosten hoerst "
    "Du ein gedaempftes Rauschen."));
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
 
  ASD(({"abstand","fisch","umrisse"}),
    "fisch");

  ASD(("kraeuseln"),
    "kraeuseln");

  AD(({"flusslauf","lauf"}),
    "Der Fluss ueberspuelt die meisten Truemmer des Felsabbruchs, wodurch "
    "oft nur knapp unter der Wasseroberflaeche scharfe Felsen lauern.");
    
  AD(({"wasseroberflaeche","oberflaeche"}),
    "Du beobachtest fasziniert wie sich die Wasseroberflaeche ueber den Felsen "
    "woelbt und sich manchmal ungeduldig schaeumend an hervorstehenden Spitzen "
    "bricht.");
     
  AD(("wasser"),
    "Fazinierend wie der Fluss schaeumend ueber die abgerutschten Felstruemmer "
    "tanzt.");
    
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Der Fluss fliesst schaeumend und gurgelnd ueber Felstruemmer die "
    "von der oestlichen Uferwand in den Fluss gestuerzt sind. Du haeltst "
    "lieber Abstand zu den tuekischen Spitzen.");
  
  AD(("spitzen"),
    "Du kannst die gefaehrlichen Spitzen manchmal nur an einem Kraeuseln des "
    "Flusses erkennen.");
      
  AD(("nordosten"),
    "Aus dem Nordosten, wo sich die Schlucht verbreitert, weht das  Rauschen "
    "eines Wasserfalles her.");
    
  AD(({"schlucht","sandsteinschlucht"}),
    "Im Nordosten verbreitert sich die gelbe Sandsteinschlucht anscheinend "
    "sehr stark.");
     
  AD(({"truemmer","splitter","felstruemmer"}),
    "Die ostliche Uferwand ist abgerutscht und bildet eine Schutthalde die bis "
    "in den Fluss reicht.");
     
  AD(("wasserfall"),
    "Dem Rauschen nach muss das ein recht grosser Wasserfall ein.");
    
  AD(("rauschen"),
    "!!WUUUUUUUUSCCCCCHHHHHHH!!");
    
  AD(({"felssturz","sturz","felsabbruch","abbruch"}),
    "Das muss ein gewaltiger Krach gewesen sein als ein Teil der Uferwand in "
    "den Fluss gestuerzt ist. Die Schutthalde waere aber trotz ihrer grossen "
    "Steigung zu erklettern.");
    
  AD(("krach"),
    "Der Felssturz liegt schon lange zurueck.");
    
  AD(("steigung"),
    "Die Schutthalde windet sich sehr steil in die Hoehe und man muesste "
    "aufpassen nicht abzurutschen. Besonders am oberen Ende geht der Schutt "
    "wieder in eine ziemlich senkrechte Felswand ueber.");
    
  AD(("hoehe"),
    "Der Rand der Schlucht ist ca 180 meter ueber Dir.");
    
  AD(("ende"),
    "Der Felssturz ist anscheinend nicht am oberen Rand der Felswand "
    "ausgebrochen, wodurch die Wand nun an ihrem oberen Ende ueberhaengend ist "
    "und nur sehr schwer erklettert werden kann.");  
    
  AD(("rand"),
    "Hinter dem ca 180 meter ueber Dir liegenden Rand der Felswand wuchert der "
    "Dschungel. Da die oestliche Wand weniger steil ist kannst Du dahinter "
    "undeutlich ein paar Wipfel des Dschungels sehen.");
    
  AD(("wipfel"),
    "Die Wipfel der groessten Dschungelriesen sind hinter dem Rand der Schlucht "
    "zu sehen.");
    
  AD(({"dschungelriesen","riesen","baeume","baum"}),
    "Die gewaltigen Riesen die oft Staemme, so dick wie zehn Maenner besitzen, "
    "ragen hinter dem Rand der Felswand hervor."); 
 
  AD(("staemme"),
    "Solche Staemme zu faellen ist beinahe unmoeglich.");
    
  AD(({"maenner","mann"}),
    "Die Staemme sind so gewaltig das die Maenner allesamt grosse Bierbaeuche "
    "haben koennen.");
    
  AD(({"bierbauch","bierbaeuche","bier","bauch","baeuche"}),
    "Kommt von zuviel Bier.");
 
  AD(({"farbe"}),
    "Der Dschungelfluss schillert in einem hellen klaren Gruen."),
  
  AD(("gruen"),
    "Diese frische, milde Farbe zieht ueber den ganzen Fluss.");
   
  AD( ("meer"),
    "Der Fluss muendet in auf der noch beinahe unerforschten "
    "Suedseite des Kontinentes ins Meer.");
    
  AD(({"suedseite","seite","kueste"}),//wenn soweit unbedingt aendern
  "Die Suedseite des Kontinentes ist noch kaum erforscht und der Fluss "
  "ist bisher auch die einzige Verbindung.");
  
  AD(({"verbindung"}),
    "Zwischen dem noerdlichen Tijara und der suedlichen Kueste "
    "liegt wilder Dschungel.");
  
  AD(("tijara"),
    "Besuchen und schweigen.");
    
  AD(("schatten"),
    "Der Fisch ist schon weiter geschwommen.");
    
  AD(({"kontinent","gebiet","gebiete","randgebiete","randgebiet","suedkontinent"}),
    "Der Suedkontinent ist ein der noch am wenigsten erforschten "
    "Randgebiete des Silberlandes."),
    
  AD(("silberland"),
    "Rate einmal wo Du Dich befindest.");
    
  AD(({"sandstein","gestein","stein"}),  
    "Der weiche Sandstein leuchtet in sanftem Gelb.");
    
  AD(({"uferwand","uferwaende","wand","waende","felswand","felswaende",
       "sandsteinwand","sandsteinwaende"}),
    "Die westliche Uferwand erhebt sich beinahe senkrecht ueber dem Fluss, "
    "waehrend die oestliche eingebrochen ist.");
    
  AD(({"tuerme","felstuerme","felssaeulen","saeulen"}),
    "Du siehst hier kaum noch Felstuerme. An der oestlichen Uferwand hat der "
    "Felssturz alle Felssaeulen umgerissen und begraben.");
     
  AD(("oestliche uferwand"),
    "Teile der oestlichen Uferwand sind herausgebrochen und in den Fluss "
    "gestuerzt. Die Truemmer bilden eine ziemlich steile Schutthalde.");
    
  AD(("dschungel"),
    "Ein paar der groessten Baeume kannst Du ueber der oestlichen Uferwand sehen.");
    
  AD(({"schutthalde","halde","schutt"}),
    "Schaeumend bricht sich der Fluss an den Felsbrocken die in den Fluss "
    "gestuerzt sind.");
  
  AD(({"teile","teil"}),
    "Umgestuerzte Felstuerme und herausgebrochene Felsbrocken sind "
    "in den Fluss gerutscht. Auf einen abgeflachten Felsblock "
    "muesste Du klettern koennen.");
  
  AD(({"felsblock","block","felsbloecke","bloecke"}),
    "Der Felsblock ist zwar feucht und rutschig aber sonst leicht zu erklettern.");
        
  AD(({"felsbrocken","brocken","felsen","fels"}),
    "Kantige Felsbloecke liegen an der oestlichen Uferseite im Fluss. Auf "
    "einen davon koenntest Du ohne Probleme klettern.");
    
  AD(({"probleme","problem"}),
    "Das muesstest Du schaffen.");
    
  AD(({"uferseite","fuss"}),
    "Auf der oestlichen Uferseite liegt am Fuss der Schutthalde ein Felsblock "
    "von dem aus Du auf die Schutthalde klettern kannst.");
    
  AD(("westliche Uferwand"),
    "Steil und unversehrt ragt die Wand neben Dir empor."); 

  AD(("nebel"),
    "Im Nordosten, von wo Du das Rauschen eines Wasserfalles hoerst haengt "
    "feiner Nebel ueber dem Fluss.");
    
  AD(({"grund","boden"}),
    "Den eigentlichen Grund kannst Du nicht erkennen. Du siehst nur die dunklen "
    "Umrisse scharfer Felsen unter Dir.");
    
  AD(("himmel"),
    "Da die oestliche Uferwand eingebrochen dringt der Schein der Sonne bis "
    "zum Fluss herab in die Schlucht.");
    
  AD(("sonne"),
    "Durch den Fluss ist es dennoch recht angenehm kuehl.");
    
  AD(("schein"),
    "Im Dschungel wird die Sonne moerderisch.");
    
  AD(("wind"),
    "Der allgegenwaertige Wind pfeift kuehlend durch die Schlucht.");
   
  AD(({"stelle","stellen"}),
    "An manchen Stellen ueberspuelt der Fluss aus der Uferwand gebrochene "
    "Felsbloecke.");
    
  AD(({"welle","wellen"}),
    "Der Fluss springt in Wellen ueber grosse Felsbloecke.");
     
  AddItem("/d/dschungel/trintrasil/fluss/npc/libelle.lpc" ,REFRESH_DESTRUCT);
  
  AddCmd( ({"klettere","kletter","steige","steig"}), "func_felsblock");

  AddCmd( ({"rate"}), "func_silber");
  
  
  NORDO
  SUEDO

  AddRoomMessage( ({
           "\nDer Schatten der Uferwaende faellt auf Dich.\n",
           "\nDer Rio de la Puseta schillert gruen.\n",
           "\nMit einem dumpfen Plaetschern schlaegt der Fluss gegen den Fels.\n",
           "\nDer Wind faehrt durch die Schlucht.\n",
           "\nDer Fluss umspuelt schaeumend die Felsen.\n",
           "\nDer Fluss rauscht ueber kantige Felsbloecke.\n",
           "\nWeisse Wellen spritzen ueber untiefe Stellen.\n",
           "\nVon Nordosten weht ein gedaempftes Rauschen her.\n",
           "\nWeiter im Nordosten haengt feiner Nebel ueber dem Fluss.\n",
           "\nDer Schatten eines Fisches huscht unter Dir hinweg.\n",
           "\nScharfe Spitzen blitzen aus dem Wasser.\n"
           }) ,45);

 AddSound( DEFAULT_SOUND,
   "Der Fluss rauscht ueber die Truemmer.\n Von Nordosten "
   "her hoerst Du gedaempft das Rauschen eines Wasserfalles");
   
 AddSound(({"rauschen","wasserfall"}),
   "!!!WUUUUUUUUSCHHHHHHHHH!!!!");
 
 AddSound(({"plaetschern"}),
   "Der Fluss gurgelt ueber die Felsen.");
}


 NORDOF(fluss14)
 SUEDOF(fluss16)
 
 
int func_felsblock(string str) {
  	 
  notify_fail("Auf was willst Du klettern?\n");
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" klettert in fluss15 auf den felsblock.\n");
	
  if(str =="auf felsblock"||str =="auf fels"||str =="auf block"||
     str=="felsen"||str=="fels"||str=="felsblock"||str=="auf felsen"||
     str=="auf felsblock"||str=="block"||str=="auf felsbrocken"||
     str=="felsbrocken"||str=="brocken"||str=="auf brocken") {
     	
     	WSCHLANGENABFRAGE(     	
     	write(BSL("\nSolange Dein Fisch mit einer Wasserschlange kaempft kannst "
     	"Du nicht auf den Felsblock klettern. Du musst die Schlange erst "
     	"toeten."));,
     	write(BSL("\nVorsichtig steigst Du vom Fisch und kletterst auf den "
     	"glitschigen Felsblock. Spritzend taucht der Fisch unter.\n\n"));
     	TPM("/d/dschungel/trintrasil/fluss/room/fels", M_TPORT,
        "vom Fisch und steigt auf einen Felsen", "klettert",
        "kommt hereingeklettert");)   

   return 1;}
return 0;}
 
 
func_silber(string str) {
	
	
  notify_fail("Leider falsch, die richtige Antwort waere: rate xxx.\n");
      
      if(str=="silberland") {
      	
      	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" ist ein raetslekoenig in fluss15.\n");
	
      	write(BSL("\n!BRAVOO! Dafuer gibts einen Forscherpunkt!\n\n"));
        say(BS(""+TPN+" ist bewundernswert intelligent.\n"));
        return 1;
      }
return 0;}


fisch() {
	WSCHLANGENABFRAGE(
	return BS("Da Dein Fisch mit einer Wasserschlange kaempft kann er auf "
	"die unter Wasser lauernden Spitzen nicht achten. Hoffentlich verletzt "
	"er sich nicht daran.");,
	return BS("Dein Fisch schwimmt unbesorgt zwischen den unter Wasser "
	"lauernden Spitzen umher.");)
}


kraeuseln() {
	WSCHLANGENABFRAGE(
	return BS("Bei weitem nicht alle Truemmer stehen aus dem Wasser. Da "
	"Dein Fisch mit einer Wasserschlange kaempft kann er auf die unter "
	"Wasser lauernden Spitzen nicht achten.");,
	return BS("Bei weitem nicht alle Truemmer stehen aus dem Wasser. Aber "
	"Du merkst beruhigt das der Fisch ohnehin von selbst den "
	"gefaehrlichsten Spitzen ausweicht.");)
}
	