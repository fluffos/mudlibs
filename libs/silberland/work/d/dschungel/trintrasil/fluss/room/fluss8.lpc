#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Wie ein gruener Wurm schiebt sich der Rio de la Puseta durch "
"die tief ausgeschuerfte Sandsteinschlucht. Die gelben, sanft schimmernden "
"Waende sind hier ueber 200 meter hoch und stehen ca 100 meter auseinander. Der "
"Fluss hat aus ihrem weichen Stein eine Maerchenwelt aus runden, ausgespuelten "
"Formen geschaffen und wie ein sorgfaeltiger Steinmetz haertere Steinknollen "
"als Felstuerme aus dem Mutterfels geschaelt. Im Norden macht der Fluss eine "
"leichte Biegung nach Nordwesten."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Der Fluss fliesst nun direkt nach sueden. Im Norden macht der "
    "Fluss einen vollstaendigen Bogen nach Westen.");
  
  ASD(({"nordwesten","bogen"}),
    "bogen");
  
  AD(({"uferwaende","waende","uferwand","wand","felswand","felswaende"}),
   "Die gelben Uferwaende aus Sandstein wurden hier vom Fluss tief " 
   "ausgewaschen. An manchen Stellen draengen sich ausgespuelte Felstuerme "
   "in ihrem Schatten.");
  
  AD(({"steinmetz","metz"}),
    "Vielleicht findest Du in Tijara einen Steinmetz, aber hier, nach der "
    "Unschaerferelation, eher kaum.");
    
  AD(({"unschaerferelation","relation"}),
    "Theoretisch koennte sich der Steinmetz ja unendlich weit weg von seiner "
    "Werkstatt befinden, aber hier bist Du sicher schon ausserhalb eines mit "
    "95% definierten Orbital.");
    
  AD(("orbital"),
    "Je nach definierter Wahrscheinlichkeit der wahrscheinliche "
    "Aufenthaltsorts des Steinmetz."),
  
  AD(({"ort","aufenthaltsort"}),
    "Dein Aufenthaltsort ist gerade der Sessel.");
    
  AD(("wahrscheinlichkeit"),
    "Wahrscheinlich ist es so."); 
        
  AD(({"hocker","stubenhocker"}),
    "So wie Du gerade eben.");
    
  AD(("sessel"),
    "Dort findet man meistens Stubenhocker.");
     
  AD(("werkstatt"),
    "Frage in Tijara nach."),
    
  AD(("tijara"),
    "Midas ist zwar die groesste, Tijara aber sicher die abenteuerlichste Stadt "
    "des Silberlandes.");
    
  AD(({"sandstein","stein","fels","mutterfels"}),  
    "Der weiche, gelblich Sandstein schimmert in milden Gelbtoenen. "
    "In unglaublich langer Zeit hat der Fluss diese Schlucht in ihn "
    "eingegraben.");
    
  AD(({"sandsteinschlucht","schlucht","umgebung"}),
    "Die Schlucht verlaeuft hier in sanften Wellen von Nord nach Sueden. "
    "Im Norden, biegt der Fluss ganz nach Nordwesten.");
     
  AD(("wellen"),
    "Der Fluss hat weiche Teile des Gesteins schneller ausgespuelt und haertere "
    "so herausgearbeitet.");
 
  AD(({"teile","teil"}),
    "Das weiche Gestein wurde vom Fluss ausgewaschen und von der Stroemung "
    "fortgetragen.");
    
  AD(({"maerchenwelt","welt"}),
    "Der Fluss hat im Lauf der Zeit viele seltsam geformte Felstuerme geschaffen.");
    
  AD(({"formen","form"}),
    "Kein Baumeister wuerde jemals so gewagte schraege Felstuerme bauen.");
    
  AD(({"felstuerme","felsturm","tuerme","turm","adern","gesteinsadern","teile","knollen","gesteinsknollen","steinknollen","stellen"}),
    "Um die harten Gesteinsadern hat der Fluss das weichere Gestein abgetragen "
    "und diese als seltsam gebogene und abgescheuerte Felstuerme ausgespuelt.");
    
  AD(("biegung"),
    "Im Norden macht der Fluss eine Biegung nach Nordwesten.");
    
  AD(({"baumeister","meister"}),
    "Kein menschliches Bauwerk ist vergleichbar mit solchen Formen.");
    
  AD(({"werk","bauwerk","wahrzeichen","zeichen"}),
    "Die beruehmte Kathedrale in Midas wirkt klein verglichen mit "
    "der Hoehe dieser Felswaende.");
  
  AD(("hoehe"),
    "Die gewaltigen gelben Felswaende sind ueber 200 meter hoch.");
 
  AD(("kathedrale"),
    "Das stolze Wahrzeichen der Stadt Midas.");
    
  AD(({"stadt","midas","siedlung"}),
    "Midas ist die groesste menschliche Siedlung im Silberland "
    "und liegt viel weiter noerdlich.");
    
  AD(({"silberland","land","umgebung"}),
    "Konzentrier Dich lieber auf Deine unmittelbare Umgebung.");
    
  AD(({"fischadler","adler"}),
    "Du kannst hoch ueber Dir seinen gebieterischen Schrei hoeren."),
    
  AD(("schrei"),
    " !!KRAAAKRAAAAAAAA!! ");
    
  AD(({"gestein"}),
    "Das weiche, wellig ausgewaschene Gestein ist beinahe vollkommen "
    "glatt und schimmert in dem milden Licht in einem sanften gelb.");
    
  AD(({"gelb","gelbtoene"}),
    "Die Uferwaende schimmern gelb.");
    
  AD(("mitte"),
    "Da der Fluss in der Mitte am tiefsten ist, wird es dort wohl am "
    "sichersten sein.");
    
  AD(({"gedanken","zeit","lauf"}),
    "Wie vergleichsweise kurz doch eine menschliche Lebensdauer ist.");
    
  AD(({"dauer","lebensdauer","leben"}),
    "Besonders Dein Leben ist saukurz.");
   
  AD(({"licht","sonnenlicht","grossteil"}),
    "Die hohen Uferwaende schirmen einen Grossteil des stechenden "
    "Sonnenlichtes ab, wodurch in der Schlucht eine angenehme schummrige "
    "Atmosphaere herrscht.");

  AD(("schatten"),
    "Die hohen Uferwaende werfen ihre Schatten ueber den Fluss.");
    
  AD(("atmosphaere"),
    "Die Formen erscheinen in diesem ruhigen Licht weicher. "
    "Ausserdem ist es nicht so drueckend heiss wie im Dschungel.");
  
  AD(({"himmel","rand","raendern"}),
    "Zwischen den Raendern der Uferwaende kannst Du den Himmel erkennen.");
    
  AD(({"boden","grund"}),
    "Du kannst den Grund des Flusses nicht erkennen.");
    
  AD(("sonne"),
    "In der Schlucht ist es auch viel kuehler als im Dschungel.");
    
  AD(("dschungel"),
    "Der Dschungel erstreckt sich hoch ueber Dir jenseits der Schlucht.");
    
  AD(("blatt"),
    "Das Blatt treibt nun im Wasser.");
    
  AD(("wasser"),
    "Das Wasser des Rio de la Puseta schimmert gruen.");
    
  AD(("wurm"),
    "Der Rio de la Puseta schlaengelt sich wie ein gruener Wurm von "
    "Norden nach Sueden.");

  AD(("norden"),
    "Im Norden macht der Fluss eine Biegung.");
    
  AD(("sueden"),
    "Du kannst dem Fluss noch weit nach Sueden folgen.");
        
  AD(("plaetschern"),
    "Der Fluss gurgelt zwischen den Felstuermen.");
    
    
  NORD
  SUED

 AddSound( DEFAULT_SOUND,
   "Leise seufzt der Wind in der Schlucht.");
 
  AddSound(("wind"),
  "Huuuuuuuuuuuuuuuuuuihuuuuuuuuuuu!"); 
 
    }


 NORDF(fluss7)
 SUEDF(fluss9)


bogen() {
	WSCHLANGENABFRAGE(
	return(BS("Der Fluss macht im Nordwesten einen vollstaendigen Bogen. "
	"Wenn Du wissen willst was hinter der Biegung liegt musst Du erst die "
	"Wasserschlange toeten die Deinen Fisch fest haelt damit Du ihn wieder "
	"steuern kannst."));,
	return(BS("Der Fluss macht im Nordwesten einen vollstaendigen Bogen. "
	"Wenn Du wissen willst was hinter der Biegung liegt musst Du auf Deinem "
	"Fisch nach Nordwesten schwimmen."));)
}
  
         