#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"


int anzahl=1;

reset() {
   ::reset();
   anzahl=1;}
   
   
int PreventInsert(object ob)  {
	
        ::PreventInsert(ob);
        call_out("PrevIns", 1+random(4), ob);
}

PrevIns(object ob) {
	
	if( !ob || !present(ob, TO) || living(ob) ) {
		
	return 1;}
	
	if( ob && present(ob, TO) && !living(ob) ) {
		
		tell_room(TO, BSL("\n"+capitalize(ob->name(WER, 0))+" versinkt "
		"gluckernd im Fluss.\n") );
		ob->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_TPORT+ 
		M_SILENT);
		tell_room(ENV(ob), BSL("\n"+capitalize(ob->name(WER, 0))+" wird "
		"auf den Felsblock gespuelt."));
	return 1;}
return 0;}

   
void create()
{
  ::create();

SetProp("riopuseta", 1);

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Du bist nun in einem ca 5 meter breiten, daemmrigen Kanal zwischen dem "
    "Felsriesen und der Uferwand. Das Plaetschern des Flusses gegen den "
    "Fels wird dumpf von der Felswand zurueckgeworfen. Nach Westen und "
    "Nordwesten kommst Du an der Felssaeule vorbei auf den Fluss."));
        
 SetProp( P_LIGHT, 1 );
 SetProp( P_INDOORS, 0 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"fisch","problem"}),
    "Der Fisch hat mit dem Kanal hier kein Problem.");

  AD(({"fluss","rio de la puseta","kanal","felskanal","rio","puseta"}),
    "Der Rio de la Puseta hat die Felssaeule umspuelt und so "
    "einen Spalt zwischen Felswand und Saeule getrieben.");
    
  AD( ("plaetschern"),
    "Leise schlaegt der Fluss gegen den unterspuelten Fels.");
    
  AD(({"fels"}),
    "Knapp unter der Wasserlinie hat der Fluss den Fels bereits "
    "untergraben.");
  
  AD(({"wasserlinie","linie"}),
    "Mit dem Gang der kleinen Flusswellen schlaegt der Fluss mit einem dumpfen "
    "Klatschen gegen den Felsturm und scheuert diesen dort weiter ab.");
    
  AD(({"gang","wellen","flusswellen"}),
    " WUUTSCHSSSSSS...   WUUTSCHSSSSSS...   WUUTSCHSSSSSS... ");
    
  AD(("klatschen"),
    "Unterhalb der Wasserlinie wird der Felsturm deutlich schmaeler. Ob er "
    "eines Tages umfallen wird?");
    
  AD(({"tag","tages"}),
    "Wenn dieser Koloss umfaellt mochtest Du nicht in der Naehe sein."),
    
  AD(("koloss"),
    "Wenn die Wellen zurueckweichen kommt Dir vor als wuerde sich etwas "
    "unterhalb der Wasserlinie an den Stein klammern.");
    
  AD(({"naehe","krach"}),
    "Der Krach muss gewaltig sein.");
    
  AD(("etwas"),
    "Du konntest es nur kurz sehen und kannst nicht genau sagen was sich dort "
    "befindet. Taste doch einmal nach dem Ding.");
    
  AD(("ding"),
    "taste nach (dem) ding/etwas.");
    
  AD(({"felswand","wand","uferwand","felswaende","uferwaende","waende",
       "sandsteinwand","sandsteinwaende"}) ,  
    "Die Wand schimmert feucht. Von oben rinnt Wasser die Wand "
    "herab.");
    
  AD(({"wasser"}),
    "Anscheinend sickert weiter oben ein Quelle durch den Sandstein.");
    
  AD(({"quelle","rand"}),
    "Du kannst nichts genaues erkennen. In dem schattigen Spalt "
    "kannst Du oben nur den Himmel als schmales Band ausmachen.");
     
  AD(({"himmel","band"}),
    "Der blaue Himmel hebt sich stark von der schattigen Felswand ab.");
    
  AD(({"sandstein","stein"}),
    "Die Felswand besteht auch hier aus dem gelben Sandstein.");
  
  AD(({"felssaeule","saeule","riese","steinriese","felsriese"}),
    "Unverrueckbar steht der gewaltige Felsturm im Fluss.Die glattpolierte "
    "Rueckseite schimmert orange-rot im schummrigen Licht.");
    
  AD(({"felsturm","turm"}),
    "Der riesige Turm hat dem zerreibenden Fluss getrotzt und ragt soweit Du "
    "erkennen kannst bis zum Rand der Schlucht auf.");
    
  AD(("schlucht"),
    "Der Felsturm steht ganz knapp an der Uferwand. Du kannst ihn nach Westen "
    "und Nordwesten umreiten.");

  AD(({"nordwesten","westen"}),
    "Nach Westen oder Nordwesten kommst Du wieder auf den breiten Fluss "
    "hinaus.");
        
  AD(("boden"),
    "Da der Kanal anscheinend ziemlich tief ist kannst Du den Grund "
    "nicht sehen.");
    
  AD(("grund"),
    "Es ist zu daemmrig in dem Spalt als das Du viel von ihm sehen koenntest.");
    
  AD(({"spalt","schatten"}),
    "In diesen Kanal zwischen den hohen Felswaenden dringt kaum "
    "Licht von oben.");
  
  AD(("licht"),
    "Die Felswand schimmert feucht in dem spaerlichen Licht. Anscheinend rinnt "
    "viel Wasser an ihr herab.");
    
  AD(({"rueckseite","seite","faerbung"}),
    "Die Rueckseite der Felssaeule ist zwar glatt, aber in der "
    "Faerbung glaubst Du Muster zu erkennen.");

  AD(("muster"),
    "Die Muster aehneln leicht einem verschwollenen Dantegesicht.");
    
  AD(({"gesicht","dantegesicht"}),
    "Als Du das Gesicht des Cardiobuebchen genauer betrachtest musst Du unwillkuerlich "
    "grinsen.");
    
  AD(("dante"),
    "Wohl wieder im Domizil aufstrebende Kuenstlerinnen demotiviert, der alte "
    "Schwede.");
  
  AD(({"treffpunkt","treff","domizil"}),
    "Das Domizil ist ein beliebter Treffpunkt junger, unentdeckter Kuenstler und Penner.");
    
  AD(("penner"),
    "Als solcher ist Dante ja auch erkannt worden als er junge Kuenstlerinnen "
    "belaestigte.");
      
  AD(({"kuenstlerinnen","kuenstler"}),
    "Naja im speziellen Fall in der Nacht mit Sonnenbrille im Haar, weil sie "
    "damit auf der Buehne besser rueberkommt.");
    
  AD(({"fall","informationen"}),
    "Genauere Informationen gibt Dir Dante.");
    
  AD(({"buehne","gogogirl","figur"}),
    "Die arme Figur schafft es wahrscheinlich gerade mal zum Gogogirl.");
    
  AD(({"sonnenbrille","brille","haar"}),
    "Hast Du kein so cooles Outfit?");
    
  AD(("outfit"),
    "Nein? Dann kommst Du sicher nicht so gut rueber.");
    
  AD(("nacht"),
    "Mit Dante immer lustig (wie immer man das auch verstehen mag).");
    
  AD(({"buebchen","bub","cardiobuebchen","cardio"}),
    "Du siehst ein Bild vor Deinem inneren Auge, bei dem der maechtige Trintrasil das "
    "atrophe, subkutanistische Cardiobuebchen Dante mit Leichtigkeit stemmt.");
  
  AD(({"wahrheit","auge","aug","bild"}),
    "Das innere Auge sieht immer die Wahrheit.");
    
  AD(({"trintrasil","trint","leichtigkeit"}),
    "MEINGOTT!!! Trintrasil wirf sogar auf den furchterregenden Rudi Kinderkopf einen "
    "Schatten!");
    
  AD(({"kinderkopf","kopf","rudi","rudi kinderkopf"}),
    "Rudi ist der Raecher und Schutzheilige aller Spiegel.");
    
  AD(({"schutzheiliger","heiliger","raecher","spiegel","rache"}),
    "Vorsicht, Rudis Rache kann ...kraeftig sein!");
    
  AD(("schwede"),
    "Vorsicht wenn Du ihn in der Strassenbahn triffst.");
    
  AD(({"strassenbahn","bahn"}),
    "Die besonders alten Schweden brechen einem schnell die Hand.");
    
  AD(("hand"),
    "Einmal schnell umgefallen und !!ZAAACK!!.");

  AD(("stroemung"),
    "Du spuerst die Stroemung hier hinter dem Felsturm nur schwach.");
        
  AD(("wind"),
    "Der heult in diesem Spalt besonders laut.");
    
  AddCmd( ("taste"), "func_scherchen");
  AddCmd(("beherrsche"), "prevent_elementar");
  AddCmd(("zaubere"), "prevent_undead_magic");
  AddCmd(("drider"), "no_spiders_wanted");

  WEST
  NORDW
  

  AddRoomMessage(({
           "\nDie Stroemung des Flusses ist hier kaum zu spueren.\n",
           "\nDer Schatten der Uferwaende faellt auf Dich.\n",
           "\nVon oben plaetschert Wasser in den Fluss.\n",
           "\nMit einem dumpfen Plaetschern schlaegt der Fluss gegen den Fels.\n",
           "\nDer Wind faehrt heulend durch die Spalt.\n"
           "\nDas Plaetschern des Flusses hallert zwischen den Waenden wieder.\n",
           "\nVon oben sickert nur sehr wenig Licht in den Spalt.\n",
           "\nIm daemmrigen Licht wirkt das Wasser fast schwarz.\n",
           "\nKleine Wellen klatschen gegen den Felsturm.\n",
           "\n!!plitschplitschplatsch!!\n",
           "\nplatschplitsch\n",
           }),45);

 AddSound( DEFAULT_SOUND,
   "Die Wellen des Flusses schlagen dumpf gegen den Felsturm.");
 
 AddSound(("wellen"),
   " WUUTSCHSSSSSS...   WUUTSCHSSSSSS...   WUUTSCHSSSSSS...");  
}
//keine flussevents hier  
 
 WESTF(fluss12)
 NORDWF(fluss10)

 
no_spiders_wanted() {
	
	if( TP->QueryProp(P_GUILD)!="dunkelelfen" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst einen Drider zu rufen, kannst Dich aber "
		"auf dem schwankenden Ruecken des Fisches nicht konzentrieren."));
		return 1;
	}
}


prevent_undead_magic(string str) {//leichen versinken zwar ohnehin sofort im Fluss, aber wer weiss..
	
	if( TP->QueryProp(P_GUILD)!="nekromanten" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Deine dunklen Kraefte zu buendeln, kannst "
		"Dich aber auf dem schwankenden Fisch nicht konzentrieren."));
		return 1;
	}
}


prevent_elementar(string str) {
	
	if( TP->QueryProp(P_GUILD)!="druiden" || str!="eiselementar"||str!="feuerelementar"||
	str!="eiselementar"||str!="wasserelementar"||str!="humuselementar") {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Dich auf die Beherrschung zu konzentrieren, "
		"findest aber auf dem schwankenden Ruecken des Fisches nicht die notwendige "
		"Ruhe."));
		return 1;
	}
}   


int func_scherchen(string str) {
	
	object krebs;
	
	notify_fail("Nach was willst Du tasten?\n");
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" findet den krebs in fluss11.\n");
	
	if(str=="nach etwas"||str=="nach dem etwas"||str=="nach dem ding"||
	str=="nach ding") {
		
		if(anzahl) {
			
			write(BS("!AUUTSCH!! Du hast gerade einen Krebs mit netten Scheren "
			"gestoert.\n"));
			TP->do_damage(9);
			say(BS(""+TPN+" tastet am Felsturm herum und zuckt fluchend "
			"zurueck.\n"));
			krebs=CLONEOB("/d/dschungel/trintrasil/fluss/npc/krebs.lpc");
			krebs->move(environment(TP), M_TPORT);
			anzahl--;
			return 1;
		}
		
		if(!anzahl) {
			
			write(BS("Was immer Du da gesehen hast ist jetzt weg.\n"));
			say(BS(""+TPN+" tastet den grossen Felsturm ab, findet aber nichts.\n"));
			return 1;
		}
	}
}