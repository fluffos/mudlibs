#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, BS(
"Du reitest auf Deinem Fisch ueber den Rio de la Puseta. Die gewaltigen "
"gelben Schluchtwaende werfen ihre Schatten ueber den gruenen Fluss, wodurch es "
"hier angenehm kuehl ist. Runde, weiche Steintuerme und Felsnasen die das "
"Wasser aus dem Sandstein geschaelt hat flankieren die Waende. Eng an die "
"suedliche Schluchtwand geschmiegt liegt ein schmaler Sandstrand. Im Westen "
"siehst Du eine schmale Sandbank."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  

  
AD(({"fluss","rio","rio de la puseta","puseta"}),
  "Du reitest auf Deinem Fisch auf dem Rio de la Puseta der leise murmelnd "
  "von Westen nach Osten fliesst.");
  
AD(("westen"),
  "Im Westen erkennst Du eine kleine Sandbank. Dahinter, noch weiter westlich "
  "donnert der Wasserfall.");

AD(({"sandbank","bank"}),
  "Die Sandbank liegt im Westen. Ueberhaupt scheint der Fluss im Westen "
  "seichter zu sein. Dahinter noch weiter im Westen donnert ein grosser "
  "Wasserfall.");

AD(({"sandstrand","strand"}),
  "An die suedliche Schluchtwand hat der Fluss einen schmalen Sandstrand "
  "angeschwemmt. Du koenntest von hier aus an Land gehen.");
  
AD(({"ufer","land"}),
  "Gehe an Land.");
      
AD(("osten"),
  "Gegen Osten kannst Du weiter flussabwaerts schwimmen.");
   
AD(({"schlucht","sandsteinschlucht"}),
  "Der Rio de la Puseta hat sich tief in den Sandstein eingeschuerft und diese "
  "Schlucht gebildet. Durch den Schatten der hohen, gelben Waende ist es hier "
  "angenehm kuehl.");
  
AD(("schatten"),
  "Die hohen Schluchtwaende werfen ihre Schatten ueber den Fluss, wodurch es "
  "angenehm daemmrig und keuhl ist.");
  
AD(({"sandstein","stein","fels","mutterfels"}),
  "Der weiche Sandstein wurde von Wind und Wasser ganz glatt poliert. Haertere "
  "Gesteinsadern wurden aus dem Mutterfels geschliffen und ragen nun als "
  "Felstuerme oder runde Felsnasen aus den Schluchtwaenden.");
  
AD(({"wand","waende","schluchtwand","schluchtwaende","felswand","felswaende",
  "sandsteinwand","sandsteinwaende"}),
  "Die gewaltigen, gelben Schluchtwaende ragen direkt neben dem Fluss auf "
  "und erstrecken sich nahezu 250 Meter in die Hoehe. Glatt polierte "
  "Felsnasen und Felstuerme ragen aus ihnen heraus.");

AD(("meter"),
  "Als Du die Schluchtwaende genauer musterst faellt Dir eine Pfahltreppe auf "
  "die an der suedlichen Schluchtwand empor fuehrt.");
  
AD(("hoehe"),
  "Die hohen Schluchtwaende werfen ihre tiefen Schatten auf Dich.");
  
AD(({"treppe","pfahltreppe"}),
  "Die Pfahltreppe beginnt etwas weiter westlich vom Sandstrand aus und windet "
  "sich die gesamte suedliche Schluchtwand hinauf.");

AD(("wasserfall"),
  "Der Wasserfall liegt weiter westlich. Aber sein Donnern hoerst Du bis hier "
  "her.");
  
AD(("donnern"),
  "Das Donnern des Wasserfalles ist hier noch recht laut zu hoeren.");
        
AD(("wind"),
  "Ein staendiger Wind schleift am weichen Sandstein.");
  
AD(("wasser"),
  "Das Wasser des Rio de la Puseta schimmert gruen.");
  
AD(({"adern","gesteinsadern"}),
  "Haertere Gesteinsadern konnten Wind und Wasser trotzen un ragen nun in "
  "eigentuemlichen Formen aus den Schluchtwaenden.");
  
AD(({"form","formen"}),
  "Gewundene Felstuerme und glatte Felsnasen ragen aus den Felswaenden.");
  
AD(({"tuerme","felstuerme","turm","felsturm","steinturm","steintuerme"}),
  "Manche Tuerme sind sehr hoch und beginnen direkt am Fluss. Viele sind "
  "gewunden und gebogen, so dass Du Dich wunderst warum sie nicht umfallen.");
  
AD(({"nasen","felsnasen"}),
  "Runde, glatt polierte Felsnasen ragen aus den gelben Schluchtwaenden.");

AD(({"grund","boden"}),
  "Der Fluss ist hier so tief das Du den Grund nicht erkennen kannst. Im Westen "
  "scheint er allerdings seichter zu sein.");

AD(({"bruecke","haengebruecke","himmel"}),
  "Hoch ueber Dir etwas weiter westlich spannt sich eine Haengebruecke ueber "
  "die Schlucht.");
  


AddSound( DEFAULT_SOUND,
   "Im Westen hoerst Du einen Wasserfall rauschen.");
   
AddSound(({"wasser","wasserfall"}),
   "WUUUSSSCCCHHHHH WUUUSSSCCCHHHHH");
 
       
  OST
  WEST    

AddCmd(("gehe"), "go_beach");

AddItem("/d/dschungel/trintrasil/fluss/npc/wkente", REFRESH_DESTRUCT);
AddItem("/d/dschungel/trintrasil/fluss/npc/mkente", REFRESH_DESTRUCT);
  }   


OSTF(fluss4)
WESTF(fluss2)

go_beach(string str) {
	
	notify_fail("Gehe an Land.\n");
	
	if(str=="an land"||str=="land") {
		
		WSCHLANGENABFRAGE(
		write(BSL("\nSolange Dein Fisch mit der Wasserschlange kaempft "
		"kannst Du ihn nicht auf das Ufer zu steuern. Du musst Die "
		"Schlange erst toeten."));,
		write(BSL("\nDu steuerst Deinen Fisch auf den Sandstrand zu, "
		"springst ins seichte Wasser und watest an Land. Dein Fisch "
		"schwimmt zurueck hinaus auf den Fluss.\n\n"));
		say(BSL("\n"+TPN+" steuert seinen Fisch auf den Sandstrand zu, "
		"springt ins seichte Wasser und watet an Land.\n\n"));
		tell_room("/d/dschungel/trintrasil/fluss/room/strand2",
		BSL("\n"+TPN+" springt von einem Fisch und watet an Land.\n\n"));
		TPM("/d/dschungel/trintrasil/fluss/room/strand2", M_GO + 
		M_SILENT);)
	return 1;}
return 0;}
	