//mein allererster raum.. ist aber im jetzigen fluss noch nicht vorgesehen
#include <properties.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "/std/room";

void create()
{
  ::create();

SP("getexits", "Sueden");

  SetProp( P_INT_SHORT, "Altwasserarm des Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Gmeaechlich treibt das Boot auf diesem Seitenarm dahin. Die Stroemung "
" ist hier nur leicht zu spueren.Ruhig windet sich der Fluss durch " 
"die Au."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );  
 
  AD(({"boot","Kanu"}),
    "Ein robustes wendiges Kanu.");

  AD(({"seitenarm","arm"}),
    "Du faehrst durch einen ruhigen Seitenarm des Flusses."
    " Das Wasser ist hier traeger und trueb.");
    
  AD( ({ "fluss","rio de la puseta" }),
    "Ruhig windet sich hier der Rio de la Puseta durch das Dickicht." );
    
  AD(("wasser"),
  "Das Wasser ist hier schlammig und trueb.Grosse alte Fische ziehen"
  " zwischen den Schlingpflanzen ihre Kreise." );
  
  AD(({"fische","schuppen","aufblitzen","blitzen"}) ,  
    "Du siehst manchmal ihre Schuppen im dunklen Wasser aufblitzen.");
    
  AD(( {"kreis","kreise"}),
    "Sie suchen hier wahrscheinlich nach Futter.");
    
  AD(("futter"),
    "Wenn Du Mitleid mit den armen hungrigen Fischlein hast dann "
    "steck doch deinen Kopf ins Wasser.");
    
  AD(({"schlingpflanzen","pflanzen"}),
     "Wie duenne Baeume schweben sie im Wasser.");
     
  AD(("baeume"),
    "Wie fingerduenne Baeume schweben diese langen Pflanzen "
    "vertraeumt im Fluss."); 
    
  AD(("stroemung"),
    "Die Stroemung ist hier nur noch schwach zu spueren.");
    
  AD(({"au","dickicht","ufer"}),
    "Die Ufer sind undurchdringbar verwachsen.");
    
  AD(("kopf"),
     "Noch ist er dran..wie fad."); 
     
  AddSmell( DEFAULT_SMELL,
     "Ein leicht modriger Geruch liegt ueber dem Wasser.");
   
  AddSound( DEFAULT_SOUND,
     "Manchmal kannst Du fremdartige Rufe aus dem Ufergestruepp hoeren.");
     
  AddSound( DEFAULT_SOUND,
     "Das sind eindeutig Tierlaute.");
  
   
  AddCmd( ({"stecke","steck"}), "func_Eierschaedl");


  AddExit( "norden",  "/gilden/abenteurer" );


  AddRoomMessage(({
           "Das Kanu schauckelt leicht.\n",
           "Ein bunter Vogel flattert kreischend aus dem Dickicht hoch.\n",
           "Ein Ast scharrt am Bootsboden entlang.\n",
           "Ein Fisch schwimmt unter dem Boot.\n",
           "Das Boot treibt durch einen Tangwald.\n"
           "Die Luft haengt schwer ueber dem Wasser.\n",
           "Ein leichter Wind kraeuslet die Wasseroberflaeche.\n",
                }),8);

}

int func_Eierschaedl(string str)
{
  notify_fail( "Ist Dir fad?\n" );

  if( str == "kopf in wasser"||str=="kopf unter wasser" )
  {
    write(BS( "Mitfuehlend haeltst Du Deinen Kopf ins Wasser, aber "
           "nicht einmal der altersschwaechste Hecht interessiert sich "
           "dafuer." ));
    
    say(BS(
    "Ach wie tierlieb und selbstlos "+TPN+" doch ist."));
    return 1;
  }
return 0;  //"geschafft...geil"
}


