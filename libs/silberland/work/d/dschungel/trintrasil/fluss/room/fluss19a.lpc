#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
         "Wie ein Tor erhebt sich vor Dir der Eingang einer schattigen "
         "Sandsteinschlucht aus der sich der Rio de la Puseta in den "
         "Dschungel ergiesst. Im Norden vor Dir siehst Du den Abbruch " 
         "des Tafelplateaus mit dem Einschnitt der Schlucht."));
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"farbton","wasser"}),
    "Der Fluss hat hier einen leichten braunen Farbton und leuchtet nicht mehr "
    "so smaragdgruen wie in der Schlucht.");
    
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Hier ergiesst sich der grosse gruene Fluss in den Dschungel.");
    
  AD(({"eingang"}),
    "Vor langer Zeit muesste der Fluss hier in einem Wasserfall "
    "vom noerdlichen Plateau herab gestuerzt sein.");
    
  AD(({"wasserfall","fall","zeit"}),
    "Das war in einer Zeit in der sich der Rio de la Puseta noch nicht "
    "so tief in den Sandstein eingeschuerft hat.");
    
  AD(("tor"),
    "Vor Dir erhebt sich der tiefe Einschnitt einer Schlucht die "
    "der Rio de la Puseta in das Gestein der noerdlichen Dschungelplatte "
    "geschuerft hat. ");
   
  AD(({"sandsteinwaende","waende","grundstein","schluchtwaende","felswaende",
       "uferwaende"}),
    "Die Sandsteinwaende kannst Du in der Schlucht besser bewundern.");
    
  AD(({"tafelplateau","plateau","dschungelplateau","norden"}),
    "Im Norden siehst Du die gewaltige Platte der Hochebene.");
    
  AD(({"platte","hochplateau","ebene","hochebene","gesteinsplatte"}),
  "Das Grundgestein hat sich hier abgesenkt und so liegt das "
  "noerdliche Plateau wie auf einer erhoehten Platte. Die Bruchwand "
  "leuchtet in einem hellen Gelb.");
  
  AD(({"abbruch","bruch","felsabbruch"}) ,  
    "Der Abbruch zwischen den beiden Platten ist aprupt und legt "
    "eine sich von Westen nach Osten ziehende Wand aus gelbem Sandstein frei. "
    "Vom Abbruch liegen am Flussufer nur noch Felsbloecke und Truemmer. "
    "Rinnsale rinnen ueber die Kante und muenden in den Rio de la Puseta.");
  
  AD(({"uferwand","felswand","schluchtwand"}),
    "Im Norden direkt vor Dir erhebt sich die gewaltige Bruchwand. Am Ufer liegen "
    "einige grosse Felsbloecke, aber von Schluchtwaenden kann man nicht sprechen.");
     
  AD(({"wand","bruchwand","sandsteinwand"}),
    "Die Sandsteinwand die durch den Abbruch der oberen Dschungelplatte "
    "entstand ist ueber 130 meter hoch und erstreckt sich beinahe senkrecht von "
    "westen nach Osten. Ihr Ende verliert sich im Dschungel. Ueber die ganze "
    "Laenge die Du einsehen kannst stuerzen Baeche an ihr herunter.");
    
  AD(({"baeche","bach"}),
    "Das Regenwasser des Dschungels sammelt sich in kleinen Senken und fliesst "
    "dann als Baeche ab. Die meisten von ihnen muenden in den Rio de la Puseta.");
    
  AD(({"regenwasser","regen"}),
    "Davon gibt es im Dschungel ja reichlich.");
    
  AD(({"senken","senke"}),
    "Das Dschungelplateau ist gebieteweise zwar relativ eben, aber flach ist es "
    "nicht.");
    
  AD(("augen"),
    "Du kneifts die Augen zusammen um besser sehen zu koennen.");
    
  AD(({"laenge","ende"}),
    "Die Bruchwand scheint unheimlich lang zu sein. Zumindest kannst Du sie "
    "nicht weiter einsehen da Dir der Dschungel den Blick versperrt.");
  
  AD(("blick"),
    "Der Dschungel wuchert und wildert bis an den Fuss der Bruchwand heran.");
    
    
  AD(("kante"),
    "Als Du der Kante mit den Augen folgst und die vielen Baeche betrachtest, "
    "die ueber die Wand herunterstuerzen, faellt Dir eine dunkle gezackte "
    "Linie auf.");
    
  AD(("gelb"),
    "Die gelbe hervorstechende Bruchwand leuchtet sanft im Sonnenlicht.");
    
  AD(({"sonnenlicht","sonne","licht"}),
    "Die Sonne scheint hell und ungetruebt vom nahezu wolkenlosen Himmel.");
    
  AD(({"flussufer","ufer"}),
    "Das Ufer am Fuss der Bruchwand ist ein Truemmerfeld unterschiedlichsten "
    "Felsbloecken die aus der Wand gebrochen sind.");
    
  AD(("fuss"),
    "Die Bruchwand erhebt sich ueber 130 meter bis zum hoeher liegenden "
    "Dschungelplateau.");
    
  AD(({"truemmerfeld","feld"}),
    "Zwischen den teilweise elefantengrossen Felsbloecken wuchert noch der "
    "ungeduldige Dschungel.");
    
  AD(({"rinnsale","rinnsal"}),
    "Die kleinen Baeche ziehen feine weisse Linien ueber den orange-"
    "gelben Sandstein der Bruchwand. Sie sind Regenwasser das der "
    "Dschungel langsam an den Fluss abgibt.");
    
  AD(({"stein","sandstein","naehe"}),
    "Das Grundgestein ist aus Sandstein. In der Schlucht kannst Du ihn aus "
    "naechster Naehe bewundern.");

  AD(({"schlucht","sandsteinschlucht"}),
    "Der Einschnitt in der Hochebene ist vor Dir im Norden.");
    
  AD(({"dschungel","wald"}),
    "Der weite Dschungel liegt im Sueden und quillt ueber die "
    "Felsbloecke am Ufer bis an den Fluss.");

  AD(("sueden"), 
    "Der Rio de la Puseta fliesst im Sueden weiter durch den Dschungel."); 
      
  AD(({"fels","felsbloecke","bloecke","truemmer","block"}),
    "Die Felsbloecke sind Truemmerstuecke vom Absenken der "
    "Gesteinsplatte und saeumen das Ufer.");  
  
  AD(({"truemmerstuecke","stuecke","bruchstuecke"}),
    "Zwischen den grossen Felsen draengt schon das Dickicht "
    "Dschungels. Ansonsten sind es nur gelbe Bruchstuecke aus Sandstein.");
    
  AD(({"absenken","senken"}),
    "Im Lauf vieler Jahre hat sich hier das Gestein abgesenkt und "
    "den Dschungel in ein Hochplateau und eine tiefere Ebene geteilt.");
    
  AD(("tiefebene"),
    "Der Teil des Dschungels suedlich der Abbruchstelle liegt tiefer.");
    
  AD(({"einschnitt"}),
    "Die Schlucht sieht aus wie ein tiefer Einschnitt in der gelben "
    "Sandsteinwand die sich hier von Osten nach Westen zieht.");

  AD(({"osten"}),
    "Das Ende der Felswand verliert sich im Dschungel, aber Du "
    "glaubst eine seltsame gezackte, dunkle Linie an der Wand "
    "erkennen zu koennen.");
    
  AD(({"linie","steig"}),
    "Weiter im Osten fuehrt anscheinen ein steiler Steig vom "
    "hoeher gelegenem Plateau herunter.");
    
  AD(({"westen"}),
    "Die gelbe Sandsteinwand verliert sich im Dickicht des Dschungels. "
    "Du siehst kleine Rinnsale vom hoeren Plateau ueber die Felskante "
    "herunterfliessen.");
    
  AD(("dickicht"),
    "Den verwachsenen, wilden Dschungel kannst Du im Sueden "
    "ungehindert bewundern.");
   
  AD(("boden"),
    "Der Fluss ist hier sehr dunkelgruen, beinahe schon braun.");
    
  AD(("himmel"),
    "Der Himmel ist nahezu wolkenlos."); 
   
  AD(({"grundgestein","gestein"}),
    "Das Gestein des Dschungelplateaus ist aus Sandstein, wie Du an der gelben "
    "Bruchwand erkennen kannst.");
     
  AD(({"lauf","jahre"}),
    "Vielleicht erfolgte der Abbruch durch Erdbeben.");
    
  AD(({"erdbeben","beben"}),
    "So etwas koennte jederzeit wieder passieren.");
    
  AD(("insekt"),
    "AAAAAAARRGG! Schon wieder wollte Dich eines stechen.");
    
  AD(("dschungelplatte"),
    "Das gesamte noerdliche Dschungelplateau ist eine beinahe durchgehende "
    "plattenartige Landschaftsformation die sich suedwestlich von Tijara "
    "langsam erhebt und hier in einem Felsabbruch endet.");
    
  AD(({"landschaftsformation","formation"}),
    "Das relativ ebene Plateau ist von der Schlucht des Rio de la Puseta "
    "zerschnitten.");
    
  AD(("tijara"),
    "Tijara ist so bekannt das es sicher keinen Forscherpunkt dafuer gibt.");
    
  AD(({"forscherpunkt","punkt"}),
    "Dafuer schon eher.");
    
  AD(("wind"),
    "Ein leichter weht aus der Schlucht.");
    
  
  NORD
  SUED
  

 AddSound( DEFAULT_SOUND,
   "Aus dem Dschungel wehen Tierlaute zu Dir herueber.");
 
 AddSound(({"tierlaute","laute"}),
   "!!UH UH UH GROAAAAAAR!!");
   
 AddSmell( DEFAULT_SMELL,
   "Ein suesser Duft liegt ueber dem Dschungel.");
 
 AddSmell(({"duft","dschungel","blueten"}),
   "Ein aufdringlicher Geruch nach insektenlockenden Blueten haengt über dem Fluss.");
   
 AddSmell(("geruch"),
   "Gottseidank bist Du kein Insekt.");
     
  }


 NORDF(fluss18)
 SUEDF(fluss20)