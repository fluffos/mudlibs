  AD(({"bergruecken","ruecken","berg","berge"}),//wenn mal wer einen schreibt waers sinnvoll den hier einzubauen
    "Hoehe Berge erheben sich nur im Zentrum des Kontinentes.");
    
  AD(("zentrum"),
