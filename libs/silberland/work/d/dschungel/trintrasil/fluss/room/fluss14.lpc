  AD(({"theater","schluchtwaende","waende","uferwaende","arena","wand","uferwand","felswand","felswaende","sandsteinwaende","sandsteinwand"}),
    "Wie ein grosses steinernes Theater umgeben die Schluchtwaende das runde "
