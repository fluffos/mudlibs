inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"

#define FEENHAUS "/d/dschungel/trintrasil/fluss/room/haus-h.lpc"
#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"


int tuer_offen=0; //ob an feenhaus schon geklopft oder nicht


reset() {
::reset();
tuer_offen=0;
}

void create()
{
  ::create();

jagdgebiet();

call_other("/d/dschungel/trintrasil/fluss/room/haus-h", "load");
//damit sich feen in feemaster eintragen..

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, BSL(
    "Der Fluss durchfliesst hier ein breites, helles Becken von Norden nach "
    "Suedwesten.\n"
    "In einem hellen Wirbel stuerzt ein Bach als rauschender Wasserfall ueber "
    "die oestliche Uferwand in den Fluss und zieht schaeumende Kreise in das "
    "wiederhallende Becken. Weisse Spruehnebel durchwehen die felsige Arena und "
    "legen sich als feine Gischt ueber Dein Gesicht. Tropfnasse, schwere "
    "Bluetenkelche draengen sich in Nischen der schattigen Felswand und trinken "
    "gierig den leichten Regen des Wasserfalles." ));
    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
  
