 NORDF(fluss13)
 SUEDWF(fluss15)
 
 
int func_tuer(string str) {
	
	if(str=="tuer"||str=="feentuer"||str=="tuer feenhaus"||
	str=="tuer haus"||str=="haustuer") {
		
		write_file("/d/dschungel/trintrasil/log/flusslog",
		""+ctime()+": "+CAP(getuid(TP))+" versucht in fluss14 die tuer zu oeffnen.\n");
	
		if(tuer_offen) {
			write(BS("Die Tuer ist ja schon offen."));
		        return 1;
	        }
	
	        if(!tuer_offen) {
	        	write(BS("Du versuchst die winzige Tuer zu oeffnen, "
	        	"bekommst sie aber nicht auf. Vielleicht macht jemand "
	        	"von innen auf wenn Du klopfst."));
		        return 1;
	        }
	}
	
	if(!str) {
		return 0;
	}
	
	if(str!="tuer"||str!="feentuer"||str!="tuer feenhaus"||
	str!="tuer haus"||str!="haustuer") {
		
		return 0;
	}
}



int func_fischchen(string str) {
	
	notify_fail("Wohin willst Du den Fisch lotsen?\n" );
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" lotst den fisch zum wasserfall in fluss14 hin.\n");
	
	if( str=="fisch wasserfall"||str=="fisch einschlagstelle"||
	str=="fisch wasservorhang"||str=="fisch wasserfall heran"||
	str=="fisch wasservorhang heran"||str=="fisch einschlagstelle heran"||
	str=="fisch zum wasserfall"||str=="fisch zur einschlagstelle"||
	str=="fisch zum wasservorhand") {

//notwendig um vorruebergehen den Zugang zu den noch nicht fertigen Hoehlen zu sperren..
		
		write(BSL("\nKomm wieder wenn die Hoehlen hinter dem Wasserfall "
		"zugaenglich sind."));
		return 1;
	}
}

