int func_fee(string str)  {

object fee;
 
  notify_fail("An was willst Du klopfen?\n");
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" klopft in fluss14 an das feenhaus.\n");
	
  if( str=="an"||str=="an tuer"||str=="tuer") {
  	
  	WSCHLANGENABFRAGE(
   	write(BSL("\nBevor Du etwas anderes tust solltest Du erst mal die "
   	"gefaehrliche Wasserschlange toeten."));,
   	if(tuer_offen==1) {
   		write(BSL("\nDie Tuer ist schon offen, da war anscheinend "
   		"schon jemand vor Dir da."));
   		say(BS(""+TPN+" klopft an die Tuer eines kleinen, versteckten "
                "Haeuschens."));
        return 1;}
        if(tuer_offen==0) {
        	write(BS("Du klopfst an die kleine Holztuer und nach kurzem "
        	"hoerst Du Schritte auf der anderen Seite trippeln."));
        	fee=CLONEOB("/d/dschungel/trintrasil/fluss/npc/fee.lpc");
                fee->move(environment(TP), M_TPORT+ M_SILENT);
                tell_room(TO, BSL("\nEine Flussfee oeffnet die Tuer und "
                "zirpt: Guten Tag! Was kann ich fuer Dich tun?\n\n"));
                tuer_offen=1;
                return 1;
        })
          
 return 0;}  
return 0;}    


//-------------------------- SD-BESCHREIBUNGEN ----------------------------------
 
tuer() {       
	
	if(tuer_offen==1) {  
		return BS("Die Tuer ist nur angelehnt. Anscheinend hat sie "
		"schon jemand vor Dir geoeffnet.");
	}
	
	if(tuer_offen==0) {
		return BS("Die kleine Holztuer ist verschlossen. Klopf doch "
		"einfach einmal, vielleicht ist jemand zu Hause.");
	}
}
 


haus()  {
	
	if(tuer_offen==1) {
		return BS("Die Tuer des kleinen Haeuschens ist offen. Du kannst "
		"durch die Tuer das Innere genauer untersuchen.");
	}
	
	if(tuer_offen==0) {
		return BS("Das kleine Haeuschen ist ganz aus Holz gebaut. Das "
		"Dach ist mit Algen und Tang gedeckt. Die Tuer ist mit "
		"Muschelschalen verziert.");
	}
}



feen() {
	if( (tuer_offen) && (FEENHAUS->feenimhaus()) ) { 
		return BS("Vier weitere kleine Feen sitzen an einem Tisch und "
		"spielen Karten.");
	}
	
	if( (tuer_offen) && (!FEENHAUS->feenimhaus()) ) {
		return BS("Das Haeuschen ist verlassen und leer. Kleine "
		"Spielkarten liegen auf dem Tisch als waere noch vor kurzem mit "
		"ihnen gespielt worden."); 
	}
	
	if(!tuer_offen) {
		return BS("Die tuer des Haeuschens ist doch geschlossen. Du "
		"kannst nicht ins Innere sehen.");
	}
}



einrichtung() {
	
	if(tuer_offen) { 
		return BS("Die Einrichtung ist so klein wie in einem "
		"Puppenhaus. Tisch und Kaesten sind nur ca 50 cm gross.");
	}
	
	if(!tuer_offen) {
		return BS("Die Tuer des Hauses ist geschlossen. Wenn Du hinein "
		"schauen willst solltest Du erst klopfen.");
	}
}



innen() {
	
	if( (tuer_offen) && (FEENHAUS->feenimhaus()) ) { 
		return BS("Im Inneren des Haeuschens befinden sich winzige "
                "Einrichtungsgegenstaende. An einem Tisch sitzen noch weitere "
                "Feen.");
        }
        
        if( (tuer_offen) && (!FEENHAUS->feenimhaus()) ) {
        	return BS("Im Inneren des Haeuschens befinden sich winzige "
                "Einrichtungsgegenstaende.");
        }
        
        if(!tuer_offen) {
        	return BS("Um ins Innere blicken zu koennen musst Du erst an "
        	"die Tuer klopfen.");
        }
}


tisch() {
	
	if(tuer_offen) {
		return BS("Alle kleinen Einrichtungsgegenstaende sind "
		"sorgfaeltig bemalt und mit Verzierungen versehen.");
        }
  
        if(!tuer_offen) {
        	return BS("Durch eine geschlossene Tuer kannst Du die "
        	"Einrichtung nicht sehen.");
        }
}


prob() {
	
	if(tuer_offen) {
		return BS("Alle Moebel sind baeuerlich bemalt und mit feinen "
		"Schnitzereien versehen.");
        }
  
        if(!tuer_offen) {
        	return BS("Die Tuer ist verschlossen. Wenn Du anklopfst laesst "
        	"Dich der Bewohner vielleicht seine Einrichtung bewundern.");
        }
}
 
 
karten() {
	
	if(tuer_offen) {
		return BS("Du kannst leider nicht damit spielen. Die Karten "
		"viel zu klein fuer Dich sind.");
        }
        
        if(!tuer_offen) {
        	return BS("Welche Karten meinst Du?");
        }
}
 

 
liebelei() {
	
	if(tuer_offen) {
		return BS("Das Flussfeen den Fluss lieben ist nicht weiter "
		"verwunderlich.");
        }
        
        if(!tuer_offen) {
        	return BS("Klopf doch einmal an die Tuer. Vielleicht ist der "
        	"Bewohner zu Hause.");
        }
}


bewohner() {
	if( (tuer_offen) && (FEENHAUS->feenimhaus()) ) {
		return BS("Vier Flussfeen sitzen noch am Tisch im Haeuschen und "
		"spielen Karten.");
        }
  
        if( (tuer_offen) && (!FEENHAUS->feenimhaus()) ) {
        	return BS("Das Haeuschen ist leider leer, aber da kein Weg zum "
        	"Haeuschen fuehrt muesste der Bewohner fliegen um es bequem zu "
        	"erreichen.");
        }
  
        if(!tuer_offen) {
        	return BS("Da kein Weg zum Haeuschen fuehrt muesste der "
        	"Bewohner beinahe fliegen um es bequem zu erreichen.");
        }
}


fisch() {
	WSCHLANGENABFRAGE(
	return BS("Dein Fisch kaempft verbissen mit einer Wasserschlange. Du "
	"musst ihm unbedingt helfen bevor er stirbt.");,
	return BS("Dein Fisch ist durch die Wellen des Wasserfalles "
	"verwirrt.");)
}


welle() {
	WSCHLANGENABFRAGE(
        return BS("Dein Fisch kaempft auf den spritzenden Wellen verbissen "
        "mit einer Wasserschlange. Er wird Dich bald abwerfen.");,
	return BS("Die Wellen die der Wasserfall aufwirft schaukeln Deinen "
	"nervoesen Fisch.");)
}


fontaine() {
	WSCHLANGENABFRAGE(
	return BS("Aufgewuehlt und ungestuem spritzt das Wasser an der "
	"Winschlagstelle hoch. Wenn Du die Wasserschlange getoetet hast "
	"koenntest Du den Fisch naeher an den schwankenden Wasservorhang "
	"heranlotsen.");,
	return BS("Aufgewuehlt und ungestuem spritzt das Wasser an der "
	"Einschlagstelle hoch. Du wuerdest Deinen Fisch gern naeher an "
	"den schwankenden Wasservorhang heranlotsen.");)
}


vorhang() {
	WSCHLANGENABFRAGE(
	return BS("Schaeumend und rauschend schiesst `Zehn Ochsen´ ueber "
	"die Felskante in den Fluss. Wenn Du die Wasserschlange getoetet hast "
	"kannst Du ja versuchen Deinen Fisch zum Wasserfall zu lotsen.");,
	return BS("Schaeumend und rauschend schiesst `Zehn Ochsen´ ueber die "
	"Felskante in den Fluss. Du kannst ja versuchen Deinen Fisch zum "
	"Wasserfall zu lotsen.");)
}


schatten() {
	WSCHLANGENABFRAGE(
	return BS("Du musst die Wasserschlange erst toeten. Bei den "
	"Spruengen Deines Fisch kannst Du nichts genaueres erkennen.");,
	return BS("Als Du den Fisch naeher heran steuerst siehst Du im "
	"Schatten des praechtigen Bluetenfaechers ein winziges Haeuschen, "
	"das kaum hoeher als ein meter ist.");)
}


stroemung() {
	WSCHLANGENABFRAGE(
	return BS("Der Einschlag des tosenden Wasserfalles verursacht eine "
	"Stroemung die Deinen Fisch irritiert. Darum musst Du die "
	"Wasserschlange umso schneller toeten, da er Dich sonst sicher "
	"abwirf.");,
	return BS("Der Einschlag des tosenden Wasserfalles verursacht eine "
	"Stroemung die Deinen Fisch etwas irritier.");)
}


einschlag() {
	WSCHLANGENABFRAGE(
	return BS("An der Einschlagstelle schleudert `Zehn Ochsen´ "
	"brodelnde, kochende Fontainen hoch. Wenn die Wasserschlange Deinen "
	"Fisch nicht umschlungen haette, koenntest Du den Fisch naeher zum "
	"Wasserfall lotsen.");,
	return BS("An der Einschlagstelle schleudert `Zehn Ochsen´ brodelnde, "
	"kochende Fontainen hoch. Du wuerdest den Fisch gerne zum Wasserfall "
	"lotsen.");)
}