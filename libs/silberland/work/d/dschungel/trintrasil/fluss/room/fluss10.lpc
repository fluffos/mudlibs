#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <fishing.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"

#define KONTROLL "/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc"

void create()
{
  ::create();

fluss_details();
jagdgebiet();//markiert diesen raum als jagdgebiet fuer fische mittels fischspeer

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Die Uferwand ist hier besonders dicht von Felssaeulen flankiert. "
    "Beinahe wie ein gelber, erstarrter Wald ragen die geformten Steine "
    "aus dem Wasser. Ein besonders grosser Felsturm wurde vom Fluss ganz "
    "umspuelt und steht suedoestlich etwas abseits der Uferwand."));
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
  
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Der Rio de la Puseta hat hier einen besonders grossen Felsriesen "
    "umspuelt.");
    
  AD(({"felsriese","riese","turm","felsturm","saeule","felssaeule"}),
    "Wie ein Riese aus rotem Stein steht der Felsturm im Fluss "
    "und trotzt dem Schuerfen des Flusses.");
    
  AD(({"schuerfen"}),
    "Die ganze Schlucht wurde vom Fluss in unvostellbar langer "
    "Zeit ausgewaschen.");
  
  AD(("wald"),
    "Stellenweise stehen die von Wind und Wasser geformten Steine so dicht wie "
    "Baeume in einem Wald");
    
  AD(("baeume"),
    "Bei manchen Felssaeulen wundert es Dich warum sie nicht umfallen. Ihre "
    "gewundene Form entspricht wohl dem ehemaligen Verlauf der Ader im "
    "Gestein.");
    
  AD(("form"),
    "Die Felssaeulen sind vom Wasser ganz glatt und rundgeschliffen.");
    
  AD(({"ader","gesteinsadern"}),
    "Du nimmst an, dass diese Felssaeulen freigespuelte haertere Gesteinsadern "
    "sind.");
  
  AD(("verlauf"),
    "Waere interessant mehr ueber das Gestein hier zu wissen.");
    
  AD(({"wasser","wind"}),
    "Diese Steine wurden eindeutig von Wind und Wasser aus dem Gestein "
    "herausgescheuert.");
    
  AD(("gestein"),
    "Die ganze Schlucht scheint hauptsaechlich aus Sandstein zu bestehen.");
    
  AD(("steine"),
    "Die einen sind rund und plump, andere wieder duenn und hoch wie gebrechliche "
    "Kiefern. Kein Stein sieht wie der andere aus.");
    
  AD(({"kiefern","ansammlung","kiefer"}),
    "Hinter einer Ansammlung kleinerer Felssaeulen kannst Du einen dunklen "
    "Fleck erkennen.");
    
  AD(("fleck"),
    "Es koennte eine Hoehle sein, aber um mehr zu erkennen musst Du den Fisch "
    "naeher hinsteuern.");
        
  AD(("hoehle"),
    "Halb von den Felstuermen verdeckt scheint sie tiefer ins Gestein zu "
    "fuehren.");
    
  AD(("dschungel"),
    "Den Dschungel kannst Du von hier aus nicht sehen. Dazu bist Du zu tief in "
    "der Schlucht.");
    
  AD(({"sandstein","gestein"}) ,  
    "Der weiche Sandstein der Uferwand leuchtet in sanftem gelb.");
    
  AD(("fels"),
    "Der gelbe Sandstein schimmert sanft in der schattigen Schlucht. Nur "
    "oberhalb der Wandschatten leuchtet er hell im Sonnenlicht.");
    
  AD(({"bett","flussbett"}),
    "Mit der Zeit hat sich der Rio de la Puseta ein tiefes Bett in den "
    "Sandstein gegraben.");
    
  AD(({"felssaeulen","felstuerme","tuerme","saeulen"}),
    "Nicht alle Steine sind so hoch und duenn wie Saeulen. Kein Felsturm sieht "
    "gleich aus.");
     
  AD(({"uferwand","uferwaende","wand","waende","teil","felswand","felswaende",
       "sandsteinwand","sandsteinwaende"}),
    "Die steilen Uferwaende ragen in gelb-orangen Toenen hoch neben "
    "Dir auf. ");
    
  AD(({"schlucht","zeit"}),
    "Du schauderst als Du versuchst Dir die Zeit vorzustellen "
    "die der Fluss brauchte um diese Schlucht ins Gestein zu schuerfen.");
  
  AD(("stein"),
    "Die abseits stehende Felssaeule besteht aus einem anscheinend "
    "haerterem rotem Stein.");
  
  AD(({"farbe","farbtoene","toene","gelb"}),
    "Farbtoene von gelb bis orange ziehen sich durchs Gestein.");
  
  AD(({"wandschatten","schatten"}),
    "Die hohen Uferwaende werfen ihren Schatten ueber die gesamte Schlucht.");
    
  AD(("himmel"),
    "Am Himmel brennt die Sonne, aber in der schattigen Schlucht herrscht "
    "angenehme Kuehle.");
    
  AD(({"sonne","sonnenlicht","licht","sonnenscheibe","scheibe"}),
    "Die Sonnenscheibe ist zwar von den Uferwaenden verdeckt, aber ihr Licht "
    "laesst den oberen Teil der Wand hell leuchten.");
  
  AD(("kuehle"),
    "Da die Sonne nicht direkt einstrahlt und da die gesamte Schlucht mit Wasser "
    "gefuellt ist, herrscht hier angenehme Kuehle.");
    
  AD(("boden"),
    "Was erwartest Du auf einem Fluss genau.");
    
  AD(({"rueckwand","enttaeuschung"}),
    "Die Hoehle fuehrt leider nicht tiefer ins Gestein.");

        
  AddCmd(({"steuer","steuere"}), "func_hoehle");
  
  AddCmd(("schwimme"), "func_eingang");
  
  
  NORDW
  SUED
  SUEDO
  
  
 AddSound( DEFAULT_SOUND,
   "Der Wind bricht sich stoehnend an den Felstuermen.");
 
 AddSound(("wind"),
   "!!HUUUUUUIIIIIIIIHUIIIIIIII!!!");
}

 
 NORDWF(fluss9) 
 SUEDF(fluss12) 
 SUEDOF(fluss11)

 
int func_hoehle(string str)
{
  notify_fail("Wohin willst Du den Fisch steuern?\n");
  
  write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" findet den hoehleneingang in fluss10.\n");

  if(str=="fisch zur hoehle"||str=="mit fisch naeher zur hoehle"||
     str=="mit fisch naeher zur hoehle hin"||str=="mit fisch zur hoehle"||
     str=="fisch zur hoehle hin"||str=="fisch naeher zur hoehle"||
     str=="fisch naeher zur hoehle hin"||str=="fisch naeher"||
     str=="fisch naeher hin"||str=="fisch hin") {
     	
     	WSCHLANGENABFRAGE(
     		write(BSL("\nDer Fisch laesst sich nicht steuern wenn er von "
     		"der Wasserschlange umschlungen ist."));,
     		write(BSL("\nAls Du den Fisch wendest und auf die Uferwand "
     		"zusteuerst siehst Du das der Fleck tatsaechlich eine Hoehle "
     		"ist, in die Du mit dem Fisch hineinschwimmen kannst."));
     		say(BSL("\n"+TPN+" steuert seinen Fisch auf die oestliche "
     		"Uferwand zu."));)
     	return 1;}	
return 0;}


int func_eingang(string str) {
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" schwimmt in die hoehle in fluss10.\n");
     	
  notify_fail("Wo willst Du mit dem Fisch hineinschwimmen?\n");
  
  if(str=="mit fisch in hoehle hinein"||str=="mit fisch in hoehle"||
     str=="mit fisch hinein"||str=="hinein"||str=="in hoehle"||
     str=="in hoehle hinein") {
     	
     	WSCHLANGENABFRAGE(
     	        write(BSL("\nDu kannst den Fisch erst wieder steuern wenn Du "
     		"die Wasserschlange getoetet hast die ihn umschlungen hat."));,
     		if(KONTROLL->flut_aktiv()==0) {
     			write(BSL("\nDu schwimmst mit Deinem Fisch in eine "
     			"hohe, aber nicht sehr breite Hoehle.\n\n"));
     			TPM("/d/dschungel/trintrasil/fluss/room/hoehle", M_GO, 
     			"zwischen den Felstuermen", "verschwindet", 
     			"schwimmt auf einem Fisch in die Hoehle");
     			return 1;
     		}
     		
     		if(KONTROLL->flut_aktiv()!=0) {
     			write(BSL("\nIrgendetwas Seltsames scheint in der "
     			"Hoehle vorzugehen. Du solltest lieber warten bis Du "
     			"wieder gefahrlos hinein schwimmen kannst."));
     			return 1;
     		})
     		
     	return 0;}
return 0;}