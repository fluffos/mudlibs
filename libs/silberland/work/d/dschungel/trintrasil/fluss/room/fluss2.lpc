#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Hier hat der Fluss eine schmale Sandbank angeschwemmt auf der Jemand sitzt "
"und angelt. Das Wasser hier ist stellenweise sehr seicht und einige "
"weisse Sandruecken schimmern knapp unter der Wasseroberflaeche. Gegen Osten "
"kannst Du flussabwaerts reiten. Im Westen kommst Du dem donnernden "
"Wasserfall schon sehr nahe."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
 
AD(("westen"),
  "Im Westen donnert der Wasserfall.");
  
AD(("osten"),
  "Gegen Osten kannst Du flussabwaerts schwimmen.");
  
AD(({"Fluss","rio","rio de la puseta","puseta"}),
  "Der gruene Rio de la Puseta hat hier eine kleine Sandbank angeschwemmt, auf "
  "der Jemand sitzt und angelt. Direkt unter der vom Wasserfall im Westen "
  "unruhigen Wasseroberflaeche schimmert angeschwemmter Sand.");
  
AD(({"meter","sandbank","ihr"}),
  "Die Sandbank ist relativ klein. Ein alter Mann in Matrosengewand "
  "sitzt auf Ihr.");
     
ASD(({"mann","matrosengewand","gewand"}),
  "matrose");

ASD(("fisch"),
  "fisch"); 

AD(("boden"),
  "Du sitz auf einem Fisch auf dem Rio de la Puseta.");

AD(("wasser"),
  "Das Wasser des Rio de la Puseta ist vom Wasserfall im Westen noch ziemlich "
  "aufgewuehlt und schaeumt und sprudelt stellenweise.");
    
AD(({"ruecken","sandruecken"}),
  "An den Stellen an denen der Fluss Sand angeschwemmt hat schimmern helle "
  "Sandruecken.");
  
AD(({"stellen","stelle"}),
  "Der Fluss ist hier so seicht das Du zur Sandbank waten kannst (wate zur "
  "Sandbank)");   

AD(({"jemand","matrose"}),
  "Ein alter Matrose sitzt auf der Sandbank und angelt. Er scheint zu doesen, "
  "auf jeden Fall scheint er Dich garnicht zu beachten.");
  
AD(("fall"),
  "Du kannst ja zum Matrosen auf die Sandbank gehen.");
  
AD(({"oberflaeche","wasseroberflaeche"}),
  "Die Wasseroberflaeche ist vom tosenden Wasserfall im Westen unruhig und "
  "aufgewuehlt.");
  
AD(("Sand"),
  "Bei den zahlreichen seichten Stellen schimmert der angeschwemmte Sand hell "
  "unter der Wasseroberflaeche.");
  
AD(("wasserfall"),
  "Du bist dem tosenden Wasserfall schon recht nahe. Dunstige Regenschleier "
  "wehen aus dem Westen heran und legen sich feucht ueber Dich.");
  
AD(({"regen","regenschleier","schleier"}),
  "Dunstige Regenschleier, wurden vom tosenden Wasserfall hochgeschleudert und "
  "durchwehen die Schlucht.");
  
AD(({"sandsteinschlucht","schlucht","schatten"}),
  "Die Sandsteinschlucht ist hier ca 250 Meter tief. Du befindest Dich auf "
  "ihrem Grund auf dem Rio de la Puseta. Die gelben Sandsteinwaende werfen "
  "ihre langen Schatten ueber Dich, wodurch es hier angenehm kuehl ist."); 

AD(("grund"),
  "Am Grund der Schlucht fliesst der Rio de la Puseta.");
  
AD(("himmel"),
  "Weit ueber Dir hebt sich eine Haengebruecke als dunkles Band vom hellblauen "
  "Himmel ab.");
  
AD(({"bruecke","haengebruecke","band"}),
  "Die Haengebruecke ueberspannt weit ueber Dir die Schlucht.");
    
AD(({"waende","sandsteinwaende","schluchtwaende"}),
  "Die gewaltigen Schluchtwaende wurdem vom Fluss ganz glatt poliert. Der "
  "Sandstein schimmert in sanften gelben bis orangen Farbtoenen. An die "
  "suedliche Schluchtwand schmiegt sich ein schmaler Sandstrand.");
  
AD(({"suedliche wand","suedliche schluchtwand","schluchtwand","wand"}),
  "An der suedlichen Schluchtwand windet sich eine Pfahltreppe hinauf, die Du "
  "vom Strand aus betreten koenntest.");
  
AD(({"strand","sandstrand"}),
  "Den Strand hat der Fluss hier angeschwemmt. Von ihm fuehrt eine Pfahltreppe "
  "die suedliche Schluchtwand hinauf. Im Osten muesstest Du den Strand "
  "betreten koennen.");
  
AD(({"treppe","pfahltreppe"}),
  "Die Treppe windet sich vom Strand aus die gesamte suedliche Schluchtwand "
  "hinauf.");
  
AD(({"farbtoene","toene","gelb"}),
  "Das angenehme Gelb des Sandsteins schimmert sanft.");
  
AD(({"stein","sandstein"}),
  "Der weiche Sandstein der Sandsteinschlucht wurde vom Fluss tief "
  "ausgeschuerft.");


ACD(({"wate","steige","betrete","gehe"}), "sandbank");

  
  OST 
  WEST

AddItem("/d/dschungel/trintrasil/fluss/npc/klis.lpc", REFRESH_DESTRUCT);

AddSound( DEFAULT_SOUND,
   "Der Wasserfall im Westen donnert und droehnt.");
   
AddSound(({"wasser","wasserfall"}),
   "WUUUUUMMMMMMMMM WUUUSSSCCCHHHHH");
   
    }


OSTF(fluss3)
WESTF(fluss1)

sandbank(string str) {
	
	notify_fail("Wohin willst Du waten?\n");
	
	if(str=="sandbank"||str=="zu sandbank"||str=="auf sandbank"||
	str=="matrose"||str=="zu matrose"||str=="an land"||str=="land"||
	str=="zu matrose auf sandbank"||str=="matrose auf sandbank"||
	str=="zur sandbank"||str=="zum matrosen") {
		
		write(BSL("\nDu kannst die unfertige Sandbank leider noch nicht "
		"betreten.\n"));
	return 1;}
return 0;}


matrose() {
	WSCHLANGENABFRAGE(
	return(BS("Wenn Dein Fisch nicht mit einer Wasserschlange kaempfen "
	"wuerde koenntest Du von ihm herunter steigen und zur Sandbank waten."));,
	return(BS("Das Wasser ist hier so seicht das Du vom Fisch steigen und "
	"zur Sandbank waten kannst"));)
}
	

fisch() {
	WSCHLANGENABFRAGE(
	return(BS("Der Fisch kaempft verzweifelt mit der Wasserschlange."));,
	return(BS("Der Fisch schwimmt vorsichtig um die seichtesten Stellen im "
	"Fluss herum."));)
}
 
 
	