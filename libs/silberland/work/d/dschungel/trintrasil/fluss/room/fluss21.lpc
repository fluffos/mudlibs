#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

jagdgebiet();
dschungelfluss_details();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
     "Breit und gemaechlich schiebt sich der Rio de la Puseta in den "
     "ueberquellenden Dschungel. Das Dickicht waechst hier so weit in "
     "den Fluss, dass halbueberspuelte Baeume wie hartnaeckige Vorposten im "
     "Wasser stehen. Im Osten beginnen Schilfguertel am Ufer zu wuchern."));    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_WATER]) );  
 
  ASD(({"fisch"}),
    "fisch");

  ASD(({"schatten","hitze"}),
    "schatten");

  AD(({"guertel","schilfguertel","schilf","osten"}),
    "Wenn Du nach Osten schwimmst siehst Du das Schilf genauer");
    
  AD(("bogen"),
    "Der Fluss laeuft in leichten Windungen durch den Dschungel.");
    
  AD(({"windung","windungen"}),
    "Eingefasst vom wuchernden, dichten Dschungel schiebt sich der ´Rio de la "
    "Puseta´ zum weit entfernten Meer.");
    
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "In einem weiten Bogen sucht sich der Rio de la Puseta seinen weg zum Meer.");
    
  AD( ({"meer","weg"}),
    "Es ist noch ein weiter Weg fuer den Fluss.");
    
  AD(({"dschungel","dickicht"}),
  "Dichtes Unterholz und exotische Baeume ueberwuchern jeden Quadratmeter.");
  
  AD(({"quadratmeter","meter"}),
    "Kein Platz bleibt ungenuetzt.");
  
  AD(({"unterholz","hecken"}),  
    "Kleinwuechsige Hecken und Farne ueberwuchern den Boden. Sogar bis in "
    "hoehere Baumregionen schlaengeln sich Lianen als wollten sie ihre "
    "hoeheren Konkurrenten zu Boden ziehen.");
    
  AD(("farne"),
    "Mannshohe Farne wachsen im Halbschatten zwischen den Baumriesen.");
    
  AD(({"konkurrenten"}),
    "Sonnenlicht und Platz sind im Dschungel heiss umkaempft.");

  AD(({"sonnenlicht","licht","platz"}),
    "Der, der am meisten Licht und Platz ergattern kann, ueberlebt.");
    
  AD(({"baumregion","region","baumregionen","regionen","lianenbewuchs","bewuchs"}),
    "Schmarotzerpflanzen und Lianen versuchen sich auf den Baeumen naeher "
    "an das Sonnenlicht heranzuschieben.");
  
  AD(({"schmarotzerpflanze","schmarotzerpflanzen","pflanzen","blueten"}),
    "Hoch oben in den dichten Baumkronen leuchten die zarten Blueten der "
    "Hexenzirsel.");
  
  AD(({"zirsel","hexenzirsel"}),
    "Die Hexenzirsel ist eine Schmarotzerpflanze die ihre Wurzeln in Baeume "
    "bohrt und sich vom Saft des Baumes ernaehrt.");
  
  AD(({"wurzel","wurzeln"}),
    "Die Hexenzirsel wurzelt im Baum, gleich wie die Mistel.");
  
  AD(({"misteln","mistel"}),
    "Misteln siehst Du keine. Du siehst nur hoch in den Baumkronen die zarten "
    "Blueten der artverwandten Hexenzirsel.");
     
  AD(({"saft","lebenssaft"}),
    "Die Hexenzirsel entzieht dem Baum Lebenssaft.");  
    
  AD(("blueten"),
    "Feine weisse Blueten leuchten im gruenen Blaetterdach.");
    
  AD(({"baumriesen","riesen","baeume","baum","waldriesen"}),
    "Eng aneinandergedraengt spannen die Baumriesen ihre Kronen ueber das "
    "Unterholz.");  
  
  AD(({"kronen","blaetterdach","dach"}),
    "Wie mit Faeden oder Vorhaengen sind die starken Aeste teilweise mit "
    "Lianen ueberzogen.");
  
  AD(({"faeden","straenge","faden"}),
    "Straenge waere bei den armdicken Lianen wohl passender, aber von hier aus "
    "sehen sie wie Faeden im Dschungel aus.");
    
  AD(({"lianen","vorhaenge","last"}),
    "Trotz des stellenweise sehr dichten Lianenbewuchses tragen die dicken "
    "Aeste der Waldriesen ihre Last tapfer.");
    
  AD(({"aeste","ast"}),
    "Entsprechend ihrer Groesse besitzen die groessten Baeume mannsdicke "
    "Aeste.");
    
  AD(("groesse"),
    "Manche Waldriesen sind wirklich gewaltig.");
    
  AD(({"halbschatten",}),
    "Durch ihre weiten Kronen schirmen die Baumriesen einen grossen Teil des "
    "Sonnenlichtes ab. Bei der Hitze hier waere es vielleicht angenehmer mit dem "
    "Fisch in den Schatten der umspuelten Baeume zu schwimmen.");
    
  AD(("teil"),
    "Am Boden des Dschungels herrscht duesteres, gruenes Zwielicht.");
  
  AD(("zwielicht"),
    "Was sich wohl zwischen den dunklen Schatten verbirgt?");
    
  AD(({"vorposten","posten"}),  
    "Besonders zaehe Baeume wachsen sogar bis in den Fluss hinein. "
    "Der Wasserstand aendert sich hier anscheinend staendig.");
  
  AD(({"wasserstand","stand"}),
    "Durch den sich staendig aendernden Wasserstand ist die Uferlinie eher eine "
    "breite Uferzone. ");

  AD(({"uferlinie","linie","uferzone","zone"}),
    "In dieser Uferzone wachsen hartnaeckige teilweise schraeg gespuelte "
    "Baeume im Fluss, zwischen denen noch bleiche faulige Struenke ihrer "
    "schwaecheren Artgenossen herausstehen. Es waere sicher kuehler im Schatten "
    "dieser Baeume weiter zu schwimmen.");
    
  AD(({"artgenossen","genossen","struenke","baumstuempfe","stuempfe","holz"}),
    "Abgestorbene faulige Baumstuempfe ragen aus dem Wasser.");
        
  AD(("ufer"),
    "Das Ufer ist ueberwuchert und schattig. Halb ueberspuelte Baeume wachsen beim "
    "gerade hohen Wasserstand in der Uferzone.");
    
  AD(({"wasser"}),
    "Das hellgruene Wasser des Rio de la Puseta ist dunkler geworden.");
    
  AD(({"boden"}),
    "Was hast Du denn fuer ein Vorstellungsvermoegen?.");
    
  AD(({"vermoegen","vorstellung","vorstellungsvermoegen"}),
    "Du reitest auf einem Fisch ueber einen Fluss. Was erwartest Du einen "
    "festen Boden?.");
      
  AD(("himmel"),
    "Der Himmel ist nahezu wolkenlos.");


  AddItem("/d/dschungel/trintrasil/fluss/npc/mosk", REFRESH_DESTRUCT);
    

  AddCmd(({"lenke","schwimme","schwimm","steuere","steuer"}), "fluss22");
  
      
  NORDW
  OST

  AddSound( DEFAULT_SOUND,
    "Aus dem Dschungel wehen Tierlaute zu Dir herueber.");
 
  AddSound(({"tierlaute","laute"}),
    "!!UH UH UH GROAAAAAAR!!");

   
  AddSmell( DEFAULT_SMELL,
    "Ein suesser, fauliger Duft liegt ueber dem Dschungel.");
 
  AddSmell(({"duft","dschungel","blueten","geruch"}),
    "Der Geruch kommt wahrscheinlich von moderndem Holz.");
}

 
 NORDWF(fluss20a)
 OSTF(dfluss1)
 
 
fluss22(string str) {
	
	notify_fail("Wohin willst Du den Fisch lenken?\n");
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" lenkt den Fisch in den Schatten in fluss21.\n");
	
	if(str=="fisch in schatten"||str=="fisch in schatten baeume"||
	str=="fisch zwischen baeume"||str=="fisch zu baeume"||
	str=="fisch zu vorposten"||str=="fisch unter baeume"||
	str=="im schatten baeume"||str=="im schatten"||str=="schatten"||
	str=="fisch im schatten weiter"||str=="fisch in uferzone"||
	str=="fisch in zone"||str=="fisch an ufer"||str=="fisch an noerdliches ufer"||
	str=="fisch ans noerdliche ufer"||str=="fisch ans ufer") {
		
		WSCHLANGENABFRAGE(
		write(BSL("\nSolange Dein Fisch mit einer Wasserschlange "
		"kaempft kannst Du ihn nicht lenken."));,
		write(BSL("\nDu steuerst Deinen Fisch zwischen die umspuelten "
		"Baeume am noerdlichen Ufer.\n\n"));
		say(BSL("\n"+TPN+" steuert seinen Fisch zwischen die umspuelten "
		"Baeume am noerdlichen Ufer.\n"));
		TP->move("/d/dschungel/trintrasil/fluss/room/fluss22", 
		M_TPORT+ M_SILENT);)
	return 1;}
return 0;}


fisch() {
	WSCHLANGENABFRAGE(
	return BS("Dein Fisch kaempft verbissen mit einer Wasserschlange. Du "
	"solltest ihm sofort helfen!");,
	return BS("Dein Fisch durchpfluegt sicher das truebe Wasser.");)
}
 

schatten() {
	WSCHLANGENABFRAGE(
	return BS("Wenn Du endlich die Wasserschlange toeten wuerdest koenntest "
	"Du den Fisch in den Schatten der Baeume lenken.");,
	return BS("Du koenntest den Fisch ja in den Schatten der Baeume "
	"lenken.");)
}

