#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
         "Wie durch ein Tor faehrst Du von der einengenden Schlucht "
         "hinaus auf den sich in den Dschungel ergiessenden "
         "Rio de la Puseta, der sich durch Rinnsale des oberen "
         "Plateau schlagartig verbreitert. Im Norden neben Dir siehst "
         "Du den Abbruch des Tafelplateaus mit dem Einschnitt der "
         "Schlucht."));
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"farbton","wasser"}),
    "Der Fluss hat hier einen leichten braunen Farbton und leuchtet nicht mehr "
    "so smaragdgruen wie in der Schlucht.");
    
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Von den Waenden der Schlucht nicht mehr eingeengt und durch "
    "Rinnsale vom Tafelplateau angewachsen schiebt sich der Rio de la "
    "Puseta durch den Wald.");
    
  ASD(("tor"),
    "tor");
   
  AD(({"schluchtwaende","sandsteinwaende","felswaende"}),
    "Die Schlucht hoert hier durch einen Felsabbruch abrupt auf und der Fluss "
    "ergiesst sich nun in den vor ihm liegenden Dschungel.");
    
  AD( ({"tafelplateau","plateau","dschungelplateau", "norden"}),
    "Direkt im Norden erhebt sich die gewaltige Platte der Hochebene 130 meter hoch.");
  
  AD(({"hochplateau","ebene","hochebene"}),
    "Das Grundgestein hat sich hier abgesenkt und so liegt das "
    "noerdliche Plateau wie auf einer erhoehten Platte. Die Bruchwand "
    "leuchtet in einem hellen Gelb.");
  
  AD(("gelb"),
    "Die gelbe hervorstechende Bruchwand leuchtet sanft im Sonnenlicht.");
    
  AD(({"sonnenlicht","sonne","licht"}),
    "Die Sonne scheint hell und ungetruebt vom nahezu wolkenlosen Himmel.");
    
  AD(("himmel"),
    "Der Himmel ist nahezu wolkenlos.");
    
  AD(({"abbruch","bruch","grundstein","felsabbruch"}) ,  
    "Der Abbruch zwischen den beiden Platten ist aprupt und legt eine sich "
    "von Westen nach Osten ziehende Wand aus gelbem Sandstein frei. Vom "
    "Abbruch liegen am Flussufer nur noch Felsbloecke und Truemmer. Rinnsale "
    "rinnen ueber die Kante und muenden in den Rio de la Puseta.");

  AD(({"uferwand","felswand","schluchtwand"}),
    "Im Norden direkt vor Dir erhebt sich die gewaltige Bruchwand. Am Ufer liegen "
    "einige grosse Felsbloecke, aber von Schluchtwaenden kann man nicht sprechen.");
    
  AD(({"wand","waende","bruchwand","sandsteinwand"}),
    "Die Sandsteinwand die durch den Abbruch der oberen Dschungelplatte "
    "entstand ist ueber 130 meter hoch und erstreckt sich beinahe senkrecht von "
    "Westen nach Osten. Ihr Ende kannst Du nicht sehen. Ueber die ganze Laenge "
    "die Du einsehen kannst stuerzen Baeche an ihr herunter.");
    
  AD(({"ende","laenge"}),
    "Die Bruchwand scheint unheimlich lange zu sein. Zumindest kannst Du sie "
    "nicht weiter sehen da Dir der Dschungel den Blick versperrt.");
    
  AD(({"blick"}),
    "Der Dschungel beginnt bereits am Fuss der Bruchwand zu wuchern und wildern.");
    
  AD(("kante"),
    "Als Du der Kante mit den Augen folgst und die vielen Baeche betrachtest, "
    "die ueber die Wand herunterstuerzen faellt Dir eine dunkle "
    "gezackte Linie auf.");
    
  AD(("augen"),
    "Du kneifst Deine Augen zusammen um besser sehen zu koennen.");
    
  AD(({"flussufer","ufer"}),
    "Das Ufer am Fuss der Bruchwand ist ein Truemmerfeld aus unterschiedlichsten "
    "Felsbloecken die aus der Wand gebrochen sind.");
    
  AD(({"feld","truemmerfeld"}),
    "Zwischen den teilweise elefantengrossen Felsbloecken wuchert der "
    "ungeduldige Dschungel.");
    
  AD(({"rinnsale","rinnsal"}),
    "Die kleinen Baeche ziehen feine weisse Linien ueber den orange-"
    "gelben Sandstein der Bruchwand. Sie sind Regenwasser, das der "
    "Dschungel langsam an den Fluss abgibt.");
    
  AD(({"bach","regenwasserbach","baeche","regenwasserbaeche"}),
    "Das Regenwasser des Dschungels sammelt sich in kleinen Senken und fliesst "
    "dann als Baeche ab. Die meisten von ihnen muenden in den Rio de la Puseta.");
    
  AD(({"regenwasser","regen"}),
    "Davon gibt es im Dschungel ja reichlich.");
    
  AD(({"senken","senke"}),
    "Das Dschungelplateau ist gebieteweis zwar relativ eben, aber flach ist es "
    "nicht.");
    
  AD(({"stein","sandstein","naehe"}),
    "Das Grundgestein ist aus Sandstein. In der Schlucht kannst Du ihn aus "
    "naechster Naehe bewundern.");

  AD(({"schlucht"}),
    "Der Einschnitt in der Hochebene ist direkt noerdlich vor Dir.");
    
  AD(({"dschungel","wald"}),
    "Der weite Dschungel liegt im Sueden und quillt ueber die "
    "Felsbloecke am Ufer bis an den Fluss.");

  AD(("sueden"), 
    "Der Rio de la Puseta fliesst im Sueden weiter durch den Dschungel."); 
  
  AD(({"fels","felsbloecke","bloecke","truemmer"}),
    "Die Felsbloecke sind Truemmerstuecke vom Absenken der "
    "Gesteinsplatte und saeumen das Ufer.");  
  
  AD(({"platte","gesteinsplatte","dschungelplatte"}),
    "Das gesamte Dschungelplateau ist eine beinahe durchgehende plattenartige "
    "Landschaftsformation die sich suedwestlich von Tijara langsam erhebt und "
    "hier in einem Felsabbruch endet.");
    
  AD(({"landschaftsformation","formation"}),
    "Das recht ebene Plateau ist von der Schlucht des Rio de la Puseta "
    "zerschnitten.");
    
  AD(("tijara"),
    "Tijara ist so bekannt das es sicher keinen Forscherpunkt dafuer gibt.");
    
  AD(({"forscherpunkt","punkt"}),
    "Dafuer vielleicht eventuell schon eher.");
    
  AD(({"truemmerstuecke","stuecke","bruchstuecke"}),
    "Zwischen den grossen Felsen sich draengt schon das Dickicht des"
    "Dschungels. Ansonsten sind es nur gelbe Bruchstuecke aus Sandstein.");
    
  AD(({"absenken","senken"}),
    "Im Lauf vieler Jahre hat sich hier das Gestein abgesenkt und "
    "den Dschungel in ein Hochplateau und eine tiefere Ebene geteilt.");
    
  AD(({"jahre","lauf"}),
    "Vielleicht erfolgte der Abbruch durch Erdbeben.");
    
  AD(("gestein"),
    "Das Gestein des Dschungelplateaus ist aus Sandstein, wie man in der "
    "Schlucht des Rio de la Puseta erkennen kann.");
    
  AD(("grundgestein"),
    "Ob sich die Platte durch ein Erdbeben abgesenkt hat?");
    
  AD(({"erdbeben","beben"}),  //Da koennte man vielleicht etwas machen..wie ein kurzevent.. bei bedarf auf alle faelle erweiterbar
    "So etwas kann jederzeit wieder passieren.");
    
  AD(("tiefebene"),
    "Der Teil des Dschungels suedlich der Abbruchstelle liegt tiefer.");
    
  AD(({"fuss"}),  
     "Die Bruchwand erhebt sich ueber 130 meter bis zum hoeher liegenden "
     "Dschungelplateau.");
  
  AD(({"einschnitt"}),
    "Die Schlucht sieht aus wie ein tiefer Einschnitt in der gelben "
    "Sandsteinwand die sich hier von Osten nach Westen zieht.");

  AD(({"osten"}),
    "Das Ende der Felswand verliert sich im Dschungel, aber Du "
    "glaubst eine seltsame gezackte, dunkle Linie an der Wand "
    "erkennen zu koennen.");
    
  AD(({"linie"}),   //ein blick in die zukunft
    "Weiter im Osten fuehrt anscheinen ein steiler Steig vom "
    "hoeher gelegenem Plateau herunter.");
    
  AD(("steig"),
    "Der Steig ist sicher sehr schmal und steil.");
    
  AD(({"westen"}),
    "Die gelbe Sandsteinwand verliert sich im Dickicht des Dschungels."
    "Du siehst kleine Rinnsale vom hoeren Plateau ueber die Felskante "
    "herunterfliessen.");
    
  AD(("dickicht"),
    "Den verwachsenen, wilden Dschungel kannst Du im Sueden "
    "ungehindert bewundern.");
    
  AD(("insekt"),
    "AAAAARG!! Schon wieder wollte Dich eines stechen.");
    
  AD(("boden"),
    "Der Fluss ist hier sehr dunkelgruen, beinahe schon braun.");
    
  AD(("wind"),
    "Ein leichter weht aus der Schlucht.");
    
      
  NORD
  SUED
  

 AddSound( DEFAULT_SOUND,
   "Aus dem Dschungel wehen Tierlaute zu Dir herueber.");
 
 AddSound(({"tierlaute","laute"}),
   "!!UH UH UH GROAAAAAAR!!");
   
 AddSmell( DEFAULT_SMELL,
   "Ein suesser Duft liegt ueber dem Dschungel.");
 
 AddSmell(({"duft","dschungel","blueten"}),
   "Ein aufdringlicher Geruch nach insektenlockenden Blueten haengt über dem Fluss.");
   
 AddSmell(("geruch"),
   "Gottseidank bist Du kein Insekt.");
     
  }

 
 NORDF(fluss18) 
 SUEDF(fluss20)

tor() {
	WSCHLANGENABFRAGE(
	return BS("Die Schlucht endet hier, aber Du kannst gar nicht genau auf "
	"Deine Umgebung achten solange Dein Fisch von einer Wasserschlange "
	"angegriffen wird.");,
	return BS("Du schwimmst wie durch ein Tor auf Deinem Fisch aus den "
	"einengenden Schluchtwaenden heraus auf den sich in den Dschungel "
	"ergiessenden ´Rio de la Puseta`.");)
}
 