#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

jagdgebiet();//markiert diesen raum als jagdgebiet fuer fische mittels fischspeer

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Fluss wird nach Westen hin immer unruhiger. Der Wasserfall im Westen "
"peitscht das Wasser zu spitzen, schaeumenden Wellen auf. Dein Fisch taenzelt "
"nervoes auf den spritzenden Schaumkronen. Dichte Regenschleier nehmen Dir die "
"Sicht. Du kannst unmoeglich naeher an den Wasserfall heranschwimmen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
  
AD(({"fluss","rio","rio de la puseta"}),
  "Der Fluss brodelt vom donnernden Wasserfall.");
  
AD(("wasserfall"),
  "Ein gewaltiger Wasserfall donnert hier in den Rio de la Puseta. Er wuehlt "
  "den Fluss auf und peitscht Regenschleier hoch. Du kannst unmoeglich naeher "
  "an den Wasserfall heranschwimmen.");
  
AD(({"schleier","regenschleier","regen"}),
  "Der Wasserfall erzeugt wabernde Regenschleier, die den Fuss des Wasserfalles "
  "als undurchsichtiger Dunst umwehen.");
  
AD(({"fuss","fuss des wasserfalles"}),
  "Du befindest Dich beinahe am Fuss des Wasserfalles.");
  
AD(("dunst"),
  "Deine Augen traenen schon von den dichten Regenschleiern.");

AD(({"augen","sicht"}),
  "Du kneifst die Augen etwas zu um sie vor den Regenschleiern zu schuetzen.");
  
AD(({"gewalt","naturgewalt"}),
  "Der Wasserfall ist eine beeindruckende Naturgewalt.");
    
ASD(({"welle","wellen"}),
  "wellen");
  
ASD(("fisch"),
  "fisch");
  
ASD(("stich"),
  "stich");

ASD(("stroemung"),
  "stroemung");
  
AD(({"kronen","schaumkronen"}),
  "Die hoechsten Wellen haben sogar weisse Schaumkronen.");
  
AD(("strudel"),
  "Der Wasserfall bildet im unruhigen Fluss gurgelnde Strudel.");
  
AD(("wasser"),
  "Das Wasser des Rio de la Puseta ist vom Wasserfall aufgewuehlt und "
  "unruhig. ");
  
AD(({"sandsteinschlucht","schlucht"}),
  "In der gelben schattigen Sandsteinschlucht ist es angenehm kuehl.");
      
AD(({"gestein","stein","sandstein"}),
  "Das Gestein des Schlucht besteht aus Sandstein.");
  
AD(({"waende","schluchtwaende"}),
  "Du kannst die gelben Schluchtwaende nur undeutlich durch die wabernden "
  "Regenschleier erkennen.");
  
AD(({"wassertropfen","tropfen","regentropfen"}),
  "Von den peitschenden Wassertropfen brennen Dir schon die Augen.");

AD(("haare"),
  "Deine Haare sind schon ganz nass.");
  
AD(("gesicht"),
  "Du wischt Dir Deine nassen Haare aus dem Gesicht.");
  
AD(("luft"),
  "Die Luft ist durch die aufgepeitschten Regenschleier dunstig und feucht.");
  
AD(({"boden","grund"}),
  "Du kannst den Grund des Flusses durch das schaeumende Wasser nicht sehen.");

AD(({"fontaenen","schaumfontaenen","fontaene"}),
  "Immer wieder schleudert der Wasserfall weisse Schaumfontaenen steil empor.");
  
AD(("himmel"),
  "Der Himmel interessiert Dich im Moment kaum.");

AD(("moment"),
  "Du bist viel mehr am beeindruckenden Wasserfall interessiert.");      

AD(("bruecke"),
  "Du kannst die Haengebruecke nur schemenhaft durch den Dunst weit ober Dir "
  "erkennen.");
  
AD(("sandbank"),
  "Die Sandbank ist oestlich von Dir.");
  
AD(({"welle","wellen"}),
  "Der Wasserfall peitscht den Fluss zu unruhigen Wellen hoch.");
  
  AddExit("westen", ([
          EX_FUNC:"wasserfall"]));
  OST 

  AddRoomMessage(({
  	"\nRegenschleier gehen auf Dich nieder.\n",
  	"\nWUUUSSSCCCHHHHH\nWUUUSSSCCCHHHHH\n",
  	"\nWUUUSSSCCCHHHHH droehnt der Wasserfall.\n",
  	"\nWUUUSSSCCCHHHHH WUUUSSSCCCHHHHH\n",
  	"\nWeisse Schaumfontaenen spritzen auf.\n",
  	"\nDu schauckelst wild auf den Wellen.\n",
  	"\nDu weichst einem brodelndem Strudel aus.\n",
  	"\nWeisse Regenschleier wabern um den Wasserfall.\n",
  	"\nDu bist schon total durchnaesst vom aufgewuehlten Wasser.\n",
  	"\nSo knapp am donnernden Wasserfall ist Dir schon mulmig zumute.\n",
  	"\nDas Wasser um Dich herum kocht und brodelt.\n",
  	"\nWUUUSSSCCCHHHHH\n!!Was fuer eine Naturgewalt!!\n",
  	"\nDir brennen die Augen von den aufgepeitschten Wassertropfen.\n",
  	"\nDeine Haare haengen Dir schon tropfnass ins Gesicht.\n",
  	"\nWUUUUUMMMMMMMMMM\nWUUUSSSCCCHHHHH\n"
  	}), 35);

 AddSound( DEFAULT_SOUND,
   "Der Wasserfall donnert und droehnt.");
   
 AddSound(({"wasser","wasserfall"}),
   "WUUUUUMMMMMMMMM WUUUSSSCCCHHHHH");

 AddSmell( DEFAULT_SMELL,
   "Dicht Regenschleier erfuellen die Luft um Dich herum.");

    }


_query_int_long() {
	
	WSCHLANGENABFRAGE(return BS("Der Fluss wird nach Westen hin immer "
	        "unruhiger. Der Wasserfall im Westen peitscht das Wasser zu "
	        "spitzen, schaeumenden Wellen auf. Dichte Regenschleier nehmen "
	        "Dir die Sicht. Ausserdem kaempft Dein Fisch mit einer "
	        "Wasserschlange die Du schnell toeten solltest.");,
	        return BS("Der Fluss wird nach Westen hin immer unruhiger. Der "
		"Wasserfall im Westen peitscht das Wasser zu spitzen, "
		"schaeumenden Wellen auf. Dein Fisch taenzelt nervoes auf den "
		"spritzenden Schaumkronen. Dichte Regenschleier nehmen Dir die "
		"Sicht. Du kannst unmoeglich naeher an den Wasserfall "
		"heranschwimmen.");)
}	
	
		
OSTF(fluss2)


wasserfall() {
	WSCHLANGENABFRAGE(write(BSL("\nDein Fisch kaempft um sein Leben. Den "
	"kannst Du nirgendwo hinsteuern bis Du die Wasserschlange getoetet "
	"hast."));,
	write(BSL("\nDu steuerst auf den Wasserfall zu. Aber als eine grosse "
	"Wellen vor dem Fisch aufgischt scheut dieser und dreht wieder bei."));) 
}


welle() {
	WSCHLANGENABFRAGE(
	return(BS("Dein Fisch kaempft mit einer Wasserschlange! Wenn Du ihm "
	"nicht hilfst laesst er Dich vielleicht im Stich."));,
	return(BS("Die spitzen, brodelnden Wellen beunruhigen Deinen Fisch."));)
}


fisch() {
	WSCHLANGENABFRAGE(return(BS("Dein Fisch kaempft mit einer "
	"Wasserschlange! Wenn Du ihm nicht hilfst laesst er Dich vielleicht im "
	"Stich."));,
	return(BS("Wenn Du noch lange hier bleibst laesst Dich Dein Fisch "
	"vielleicht im Stich."));)
}	


stich() {
	WSCHLANGENABFRAGE(return(BS("Wenn Dein Fisch einfach abtaucht oder "
	"von der Wasserschlange getoetet wird, ertrinkst Du vielleicht."));,
	return(BS("Wenn Dein Fisch einfach abtaucht, ertrinkst Du "
	"vielleicht."));)
}


stroemung() {
	WSCHLANGENABFRAGE(return(BS("Noch kann sich Dein Fisch gegen die "
	"unruhige Stroemung und die Wasserschlange halten."));,
	return(BS("Noch stemmt sich Dein Fisch unruhig gegen die Stroemung."));)
}
