
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

inherit "std/room";


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Nachdem TP vom Kaiman vom Fisch geschlagen wurde." );
  SetProp( P_INT_LONG, BS(
  "Sollte niemand sehen."));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no() {
 	
   write("Du haeltst Dich muehsam ueber Wasser.\n");
     return 1;
   }
   

  init() {
  	
  ::init();

  if(query_once_interactive(this_player())){
  	call_out("spell1", 3);}
  }
  

   spell1() {
    
   NIX
   write(BSL("\nDu schwimmst in einer Wolke von Fischblut und strampelst von "
   "der zerfetzten Leiche weg.\n"));
   call_out("spell2", 2);
   }
   
   
    
   spell2() {
   
   NIX
   write(BSL("\nDu schwimmst moeglichst schnell vom Kaiman weg. Im Wasser "
   "hast Du gegen ihn keine Chance.\n"));
   call_out("spell3", 2);
   }
 
 
    
   spell3() {
   
   NIX
   write(BSL("\nDie Stroemung erfasst Dich und der Kaiman ist schnell ausser "
   "Sichtweite.\n"));
   call_out("spell4", 3);
   }
 
    
    
   spell4() {
   
   NIX
   write(BSL("\nDu haeltst Dich muehsam ueber Wasser als Du ploetzlich ein "
   "Rauschen hoerst.\n"));
   call_out("spell5", 2);
   }
    
    
    
   spell5(object pl) {
   
   NIX
   write(BSL("\nDer Fluss treibt Dich auf einen Felsblock zu. Du bekommst "
   "den Felsen zu fassen und ziehst Dich aus dem Wasser.\n\n"));
   tell_room("/d/dschungel/trintrasil/fluss/room/dfluss4",
   BSL("\n"+TPN+" klettert aus dem Wasser auf den Fels.\n\n"));
   TP->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_GO+ M_SILENT+ M_NO_SHOW);
   }

  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  