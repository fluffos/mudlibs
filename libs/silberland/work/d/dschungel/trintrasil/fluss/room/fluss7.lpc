#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


int ei=1;
int mkueken=0;

reset() {
	ei=1;
	mkueken=0;
	::reset();
}


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Fluss beschreibt hier eine leichte Biegung von Nordwesten nach Sueden. Er "
"bricht sich leise murmelnd an der westlichen Schluchtwand die von den dagegen "
"drueckenden Wassermassen stetig unterspuelt wird. Einige windschiefe "
"Felstuerme draengen sich bizarr verbogen an die ueberhaengende Schluchtwand."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
 

AD(({"fluss","rio","puseta","rio de la puseta"}),
  "Der Fluss schwemmt hier in der Biegung die westliche Schluchtwand aus. "
  "Dadurch ist die Sandsteinwand extrem glatt und ueberhaengend.");

AD(({"oestliche wand","oestliche schluchtwand","oestliche felswand",
     "oestliche sandsteinwand"}),
   "Die oestliche Schluchtwand ragt weit ueber 200 meter vor Dir auf.");
   
AD(({"wand","schluchtwand","felswand","sandsteinwand","westliche wand",
     "westliche schluchtwand","westliche felswand","westliche sandsteinwand"}),
   "Die westliche Schluchtwand wurde vom Fluss extram glatt poliert und "
   "unterspuelt, wodurch sie ueberhaengend vor Dir aufragt.");
   
AD(({"waende","schluchtwaende","felswaende","sandsteinwaende","stein","fels",
     "sandstein"}),
  "Die Schluchtwaende bestehen aus gelben Sandstein.");
    
AD(({"bogen","biegung"}),
  "Der Fluss beschreibt hier einen Bogen von Nordwesten nach Sueden.");
  
AD(("nordwesten"),
  "Wenn Du nach Nordwesten schwimmst koenntest Du sehen was hinter der Biegung "
  "liegt.");
  
AD(("sueden"),
  "Du erkennst, dass sich der Fluss noch weit nach Sueden hin durch die "
  "Schlucht windet.");
  
AD(({"schatten","sandsteinschlucht","schlucht"}),
  "Die gelbe Sandsteinschlucht ist hier sehr tief und schattig, wodurch es viel "
  "kuehler als im restlichen Dschungel ist.");
  
AD(("dschungel"),
  "Im Dschungel ist die Luft viel heisser als hier im Schatten der Waende.");
  
AD(("luft"),
  "Schau doch in den Himmel, vielleicht siehst Du dann die Luft.");
  
AD(("himmel"),
  "Der Himmel leuchtet in poliertem Blau.");
  
AD(("blau"),
  "Na sowas. Jetzt wo Du angestrengt in den Himmel starrst erkennst Du einige "
  "kreisende Punkte ueber Dir.");
  
AD(({"punkt","punkte"}),
  "Es scheinen Klippenmoewen zu sein. Genaueres kannst Du leider kaum "
  "erkennen.");
  
AD(({"genaueres","moewen","klippenmoewen","moewe","klippenmoewe"}),
  "Klippenmoewen nisten bevorzugt in so steilen Felswaenden wie diesen hier.");

AD(({"boden","grund"}),
  "Du kannst den Grund des Flusses durch das tiefe, gruene Wasser nicht sehen.");
  
AD(({"wasser","massen","wassermassen"}),
  "Das smaragdgruene Wasser des Flusses spuelt hier bestaendig die westliche "
  "Schluchtwand aus.");
  
AD(({"felstuerme","felsturm","sandsteintuerme","sandsteinturm","turm","tuerme"}),
  "Manche der bizarr verkruepelt wirkenden Felstuerme hat der Fluss bereits "
  "umgeworfen. Du siehst noch ihre gelben Truemmer aus dem Wasser ragen.");
  
AD(("truemmer"),
  "Die Reste eines besonders grossen Felsturmes wie ein gefaellter "
  "Baumstamm aus dem Fluss.");
  
AD(({"reste","stamm","baumstamm","ueberreste"}),
  "In einer Spalte der Ueberreste scheint etwas zu liegen.");
  
AD(({"spalte","etwas"}),
  "In der Spalte versteckt sich ein Nest. Du koenntest es leicht erreichen.");
  
ASD(("nest"),
  "Dnest");
  
ASD(("ei"),
  "Dmoewenei");

ASD(("kueken"),
  "Dkueken");
  
AD(({"tier","muttertier","mutter","naehe"}),
  "Das Muttertier wird das Ei sicher heftig verteidigen.");


AddCmd(("stehle"), "func_ei");
AddCmd(("setze"), "func_kueken");

    
  SUED
  NORDW 

AddItem("/d/dschungel/trintrasil/fluss/npc/wels", REFRESH_DESTRUCT);
    }


SUEDF(fluss8)
NORDWF(fluss6)


Dkueken() {
	
	if(mkueken==0) {
		return(BS("Im Nest sitzt kein Kueken."));
	}
	if(mkueken==1) {
		return(BS("Im Nest sitzt ein kleines, flaumiges Moewenkueken, "
		"das ungeduldig nach Futter piepst."));
	}
	if(mkueken>1) {
		return(BS("Im Nest sitzen "+mkueken+" kleine flaumige "
		"Moewenkueken, die ungeduldig nach Futter piepsen."));
	}
}


Dnest() {
	if((ei==1)&&(mkueken==0)) {
		return(BS("In dem Nest siehst Du ein Ei. Es scheint das Nest "
		"einer Klippenmoewe zu sein."));
	}
	if((ei==0)&&(mkueken==0)) {
		return(BS("Das Nest ist leider vollkommen leer. Es scheint das "
		"Nest einer Klippenmoewe zu sein."));
	}
	if((ei==1)&&(mkueken>1)) {
		return(BS("Es scheint das Nest einer Klippenmoewe zu sein. "
		"Neben einem Ei erkennst Du "+mkueken+" piepsende Moewenkueken."));
	}
	if((ei==1)&&(mkueken==1)) {
		return(BS("Es scheint das Nest einer Klippenmoewe zu sein. "
		"Neben einem Ei siehst Du ein piepsendes Moewenkueken."));
	}
	if((ei==0)&&(mkueken>1)) {
		return(BS("Es scheint das Nest einer Klippenmoewe zu sein. "
		""+mkueken+" Moewenkueken sitzen im Nest und piepsen mir weit "
		"aufgerissenen Schnaebeln um Futter."));
	}
	if((ei==0)&&(mkueken==1)) {
		return(BS("Es scheint das Nest einer Klippenmoewe zu sein. "
		"Ein flaumiges, graues Kueken sitzt darin und piepst nach "
		"Nahrung."));
	}  
}


Dmoewenei() {
	if(ei==1) {
		return(BS("Du koenntest das Ei aus dem Nest stehlen. Aber sei "
		"vorsichtig! Das Muttertier ist sicher ganz in der Naehe."));
	}
	if(ei==0) {
		return(BS("Im Nest befindet sich leider kein Ei."));
	}
}


int func_kueken(string str) {
	
object mkueck;	
mkueck=present("klippenmoewenkueken", TP);
	
	notify_fail("Was willst Du wohin setzen?\n");
	
        if(!str) {
        return 0;}
  	
	if(str=="kueken nest"||str=="moewenkueken nest"||
	str=="klippenmoewenkueken nest"||str=="kueken moewennest"||
	str=="klippenmoewenkueken moewennest"||str=="kueken in nest"||
	str=="moewenkueken in nest"||str=="klippenmoewenkueken in nest"||
	str=="kueken in moewennest"||str=="moewenkueken in moewennest"||
	str=="klippenmoewenkueken in moewennest") {
	
	
		if(mkueck) {
			write(BSL("\nVorsichtig hebst Du das Kueken hoch und "
			"setzt es zurueck in das Nest."));
			say(BSL("\n"+TPN+" setzt ein Moewenkueken in ein "
			"Klippenmoewennest."));
			mkueck->remove();
		        mkueken++;
		        call_out("func_kueken1", 5+random(3));
		        write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" setzt das kueken zurueck ins nest(fluss7).\n");
	
		return 1;}
		if(!mkueck) {
			write(BS("Du hast doch gar kein Kueken."));
		return 1;}
	return 1;}
return 0;}


func_kueken1() {
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss7",BSL("\nPloetzlich "
	"hoerst Du ober Dir ein lautes Kraechzen!"));
	call_out("func_kueken2", 4+random(3));
}


func_kueken2() {
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss7",BSL("\nEin "
	"Klippemoewenmaennchen landet im Nest und fuettert das Kueken mit "
	"vorgekautem Fischbrei. Dannach macht es sich sofort auf neues Futter "
	"zu beschaffen."));
}


int func_ei(string str) {
	
	object mei;
	notify_fail("Was willst Du stehlen?\n");
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" nimmt ein ei aus dem nest in fluss7.\n");
	
	if(str=="ei"||str=="moewenei"||str=="klippenmoewenei"||str=="ei aus nest"||
	str=="ei aus moewennest"||str=="ei aus klippenmoewennest"||str=="moewenei aus nest"||
	str=="moewenei aus moewennest"||str=="moewenei aus klippenmoewennest"||
	str=="klippenmoewenei aus nest"||str=="klippenmoewenei aus moewennest"||
	str=="klippenmoewenei aus klippenmoewennest") {
		
		if(ei==1) {
			
			mei=CLONEOB("/d/dschungel/trintrasil/fluss/obj/mei");
			
			if( mei->move(TP, M_GET+ M_SILENT)==ME_TOO_HEAVY ) {
				
				write(BS("Das Ei ist Dir leider zu schwer, also laesst "
				"Du es im Nest"));
				mei->remove();
				return 1;
			}
			
			else {
				write(BS("Du greifst in das Nest und nimmst schnell das Ei."));
				say(BS(""+TPN+" nimmt etwas aus einer Spalte eines "
				"umgefallenen Felsturmes."));
				tell_room(environment(this_player()), "\n");
				ei=0;
				call_out("func_ei1", 2);
				return 1;
			}
		}
		
		if(ei==0) {
			
			write(BS("Das Nest ist leider leer."));
			say(BS(""+TPN+" sucht etwas in einer Spalte eines umgefallenen "
			"Felsturmes."));
			tell_room(environment(this_player()), "\n");
		}
		return 1;
	}
}


func_ei1() {
	tell_room(environment(this_player()), BS("Ploetzlich hoerst Du ein "
	"zorniges Kreischen!!"));
	tell_room(environment(this_player()), "\n");	
	call_out("func_ei2", 2);
}


func_ei2() {
	
object kmoewe;
	
	tell_object(this_player(), BS("Eine Klippenmoewe stuerzt auf Dich herab "
	"und greift Dich an."));
	say(BS("Eine zornige Klippenmoewe stuerzt sich auf "+TPN+"."));
	tell_room(environment(this_player()), "\n");
	kmoewe=CLONEOB("/d/dschungel/trintrasil/fluss/npc/kmoewe");
	kmoewe->move(environment(this_player()), M_TPORT + M_SILENT);
	this_player()->AddPursuer(kmoewe);
	kmoewe->Kill(this_player());
}

	  
