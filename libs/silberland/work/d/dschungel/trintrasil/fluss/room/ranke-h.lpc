
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create() {
	
  ::create();

  SetProp( P_INT_SHORT, "Rankenkletterraum" );
  SetProp( P_INT_LONG, BS(
  "Unnoetig!"));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  SetProp(P_KILL_NAME, "Ein harter Aufprall");
  AddCmd ("", "no", 1);   
  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
int no() {
	
	write (BSL("Du hast alle Haende voll zu tun nicht abzustuerzen!\n"));
	return 1;
}
     
    
init() {
	
	::init();
	
	if(query_once_interactive(this_player())){
		
		call_out("ranke1", 3);
	}
	
}
  

ranke1() {
	
	NIX
	write(BSL("\nDu ziehst Dich die ledrige, zaehe Ranke hinauf. Sie scheint Dein "
	"Gewicht zu tragen."));
	call_out("ranke2", 3);
}
   
   
ranke2() {
	
	NIX
	write(BSL("\nDu stemmst Deine Fuesse gegen den Sandstein. Die Felswand wird zusehends "
	"ueberhaengend und weicht immer weiter zurueck."));
	call_out("ranke3", 2);
}
 
    
ranke3() {
	
	NIX
	write(BSL("\nDu kannst die Schluchtwand nicht mehr erreichen. Deine Arme beginnen "
	"sich zu verkrampfen und zu zittern."));
	call_out("ranke4", 3);  
}

    
ranke4() {
	
	NIX
	write(BSL("\n   !!UFFF!!\n"
	"Endlich hast Du den Schluchtrand erreicht. Du haeltst Dich am Ende eines umgestuerzten "
	"Baumes fest, und ziehst Dich hoch. Du stehst nun am dicht bewachsenen Schluchtrand."));
	tell_room("/d/dschungel/trintrasil/plateau/room/plateau1",
        BSL(""+TPN+" kommt keuchend die Ranke herauf geklettert.\n"));
        TP->move("/d/dschungel/trintrasil/plateau/room/plateau1", M_GO+ M_NO_SHOW+
        M_SILENT);   
}
   
    
  
BecomesNetDead(object pl)  {
	
	pl->move("/d/dschungel/trintrasil/plateau/room/plateau1",M_GO+ 
	M_SILENT+ M_NO_SHOW);
	return 1;
}

   
   
void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	leiche=present("leiche", TO);
	
	if (leiche)  {
		
		leiche->move("d/dschungel/trintrasil/fluss/room/nest",
		M_TPORT+M_SILENT);
		tell_room("d/dschungel/trintrasil/fluss/room/nest",
                BS("Na sowas!! Die Leiche von "+CAP(getuid(TP))+" faellt von oben "
                "herunter! "));
        }
}   