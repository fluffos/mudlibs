#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"

#define SCHILF "/d/dschungel/trintrasil/fluss/room/schilf-h.lpc"


int lotosint = 0; //der schwarze lotos ist hier vorgesehen und leicht einbaubar hat aber
//lowpriotity
 
//int lotosint=2+random(4);


reset() {
  ::reset();
//  lotosint=2+random(4);
}


void create()
{
  ::create();

dschungelfluss_details();
jagdgebiet();//markiert diesen raum als jagdgebiet fuer fische mittels fischspeer

  SetProp( P_INT_SHORT, " Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Traege schiebt sich der breite, schlammige Rio de la Puseta durch den ueppigen "
"Dschungel. Dichte Tang und Seerosenwaelder bilden gruene Inseln auf dem "
"trueben Wasser. Die Schilfguertel am Ufer sind immer wieder von "
"Altwasserarmen unterbrochen. Im Suedosten scheint der Fluss wieder etwas "
"enger und schneller zu werden."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_WATER]) );  
 

AD(({"fluss","rio","rio de la puseta","puseta"}),
  "Der Fluss ist hier sehr breit und fliesst deshalb auch recht traege "
  "dahin. Durch die geringe Stroemung wachsen stellenweise dichte Tang und "
  "Seerosenwaelder. An den Ufern wachsen ausgedehnte Schilfguertel.");
  
AD(({"guertel","schilfguertel","schilf"}),
  "Die Schilfguertel scheinen sehr breit zu sein. Das eigentliche Ufer "
  "kannst Du garnicht erkennen. Du erkennst besonders im noerdlichen "
  "Schilfguertel einige grosse Altwasserarme.");
  
AD(("ufer"),
  "Dichte, hohe, Schilfguertel bilden hier soetwas wie ein Ufer. Besonders "
  "der noerdliche Schilfguertel scheint sehr gross zu sein.");
  
AD(({"noerdlicher schilfguertel","noerdliches schilf","noerdlicher guertel"}),
  "Du kannst die groesse des noerdlichen Schilfguertels nicht ueberblicken, "
  "aber Du erkennst einige recht breite Altwasserarme.");
  
AD(({"arme","altwasserarme","altwasser","arm","altwasserarm"}),
  "Einige der Kanaele im Schilf sind zwar sehr breit, aber vielleicht werden "
  "sie weiter im Schilf enger und seicht. Du kannst mit dem Fisch nicht "
  "dorthin.");

AD(("boden"),
  "Der Fluss scheint hier recht tief zu sein.");
  
AD(({"sonne","himmel"}),
  "Die Sonne brennt drueckend auf Dich nieder.");
  
AD(("wasser"),
  "Das Wasser ist hier hat hier eine dunkelgruene bis braune Farbe.");
  
AD(({"stoffe","naehrstoffe","farbe"}),
  "Durch die Naehrstoffe die vom Dschungel und dem Schilf in den Fluss "
  "gespuelt werden ist der Fluss hier dunkler als in der Schlucht.");

AD(("schlucht"),
  "Die Schlucht befindet sich weiter nordwestlich von hier. Du kannst sie von "
  "hier aus nicht sehen.");
  
AD(("stroemung"),
  "Da der Fluss hier breiter ist, ist auch die Stroemung schwaecher. Sie ist "
  "aber noch als bestaendiges, gemaechliches Ziehen bemerkbar.");
  
AD(("ziehen"),
  "Die Seerosen und Tangwaelder wiegen sich leicht in der Stroemung.");
  
AD(("dschungel"),
  "Du kannst den eigentlichen Dschungel von hier aus nicht sehen, da die Ufer "
  "von ausgedehnten Schilfguertel gesaeumt sind. Nur im Westen wachsen einige "
  "Baume mitten im Schilf. Noch weiter westlich erkennst Du allerdings, dass "
  "Baeume bis an den Fluss heran wachsen.");
  
AD(({"baum","baeume"}),
  "Im Westen wachsen einige kuemmerliche Baeume im Schilf. Noch weiter westlich "
  "geht das Schilf aber anscheinend zurueck und es wachsen einige grosse "
  "Baeume wie Vorposten sogar mitten im Fluss.");
  
AD(({"posten","vorposten"}),
  "Wenn Du weiter nach Westen schwimmst erkennst Du mehr.");
  
AD(("westen"),
  "Im Westen siehst Du mehr vom Westen.");

AD(({"insel","inseln","wald","waelder"}),
  "Dichte Tang und Seerosenwaelder wachsen mitten im breiten Fluss wie gruene "
  "Inseln.");

AD(({"tangwald","tangwaelder","tang"}),
  "Der hellgruene Tang wiegt sich leicht mit der Stroemung des Rio de la "
  "Puseta.");
          
AD(({"stellen","seerosen","seerosenwald","seerosenwaelder"}),
  "An einigen Stellen wachsen viele Seerosen inselartig dicht beisammen. Ihre "
  "hellen Blueten leuchten auf dem dunklen Wasser.");
  
AD(({"blueten","seerosenblueten"}),
  "Die grossen Bluetenkelche leuchten weiss und rosa.");
  
AD(({"kelche","bluetenkelche"}),
  "Zwischen den hellen Seerosenblueten fallen Dir einige schwarze Bluetenkelche "
  "auf.");
  
AD(({"schwarze blueten","schwarze kelche","schwarze bluetenkelche"}),
  "Tatsaechlich. In den dichten Seerosenwaeldern waechst auch der seltene "
  "und beruechtigte schwarze Lotos.");
  
AD(({"schwarzer lotos","lotos"}),
  "Der Bluetenstaub ist als gefaehrliche Droge bekannt. Du solltest vorsichtig "
  "sein.");
  
AD(("droge"),
  "Wer genuegend Bluetenstaub des schwarzen Lotos einatmet fuehlt "
  "sich zwar kurze Zeit sehr aufgepusht, aber er hat auch gefaehrliche "
  "Nebenwirkungen.");

AD(("zeit"),
  "Die aufbauende Wirkung dauert ca eine Stunde an.");
  
AD(({"reflexe","muedigkeit","wirkung"}),
  "Der Suechtige fuehlt sich stark, hat schnellere Reflexe und fuehlt keine "
  "Muedigkeit.");
     
AD(({"nebenwirkung","nebenwirkungen"}),
  "Nach einiger Zeit stellt sich Uebelkeit und Schwaeche ein. Ausserdem macht "
  "der schwarze Lotos suechtig.");
  
AD(("sucht"),
  "Sei vorsichtig, die Entzugserscheinungen sind furchtbar.");
  
AD(({"schwaeche","uebelkeit"}),
  "Nach einiger Zeit stellt sich Schwaeche ein. Und wer dann nicht regelmaessig "
  "schwarzen Lotos nimmt leidet an Entzugserscheinungen.");
  
AD(({"erscheinungen","entzug","entzugserscheinungen"}),
  "Der Leidende fuehlt sich krank und schwach. Aber wer die "
  "Entzugserscheinungen durchtaucht hat die Sucht ueberwunden.");
  
AD(({"leidender","leidende","suechtige","suechtiger","leid"}),
  "Ueberlege Dir gut ob Du schwarzen Lotos nimmst.");

AD(("suedosten"),
  "Im Suedosten wird der Fluss anscheinend wieder schmaeler. Ausserdem hoerst "
  "Du ein bestaendiges Rauschen.");
     
ASD(({"staub","bluetenstaub","lotosblueten","lotosbluete"}),
  "staub");
     
ASD(({"schilfkanaele","kanaele"}),
  "kanaele");
  
ASD(({"schilfkanal","kanal"}),
  "kanal");  
  
ASD(({"welle","wellen"}),
  "welle");
  

 AddSound( DEFAULT_SOUND,
   "Aus dem Suedosten hoerst Du ein Rauschen.");
 
 AddSound(({"suedosten","rauschen"}),
   "Du hoerst ein staendiges, gleichmaessiges Rauschen aus dem Suedosten.");


 AddSmell( DEFAULT_SMELL,
   "Die Seerosenblueten verstroemen einen suessen Duft.");
 
 AddSmell(({"duft","seerosenblueten","seerosen","blueten"}),
   "Der Duft ist suess und aufdringlich, aber er hat einen eigenartigen "
   "Beigeschmack.");
   
 AddSmell(({"geschmack","beigeschmack"}),
   "Ein eigenartiger Beigeschmack mischt sich in den Duft der Seerosen. Du "
   "solltest die Seerosenblueten vielleicht genauer untersuchen.");
   
   
AddCmd(({"untersuche","unt"}), "etwas");

AddCmd(({"breche","brich","pfluecke","pflueck"}), "droge");   

   
  WEST
  SUEDO
}


WESTF(dfluss1)
SUEDOF(dfluss3)


droge(string str) {

object staubgefaess;	
	
	notify_fail("Was willst Du abbrechen?\n");
		
	if(str=="schwarzen lotos"||str=="lotos"||str=="staubgefaess"||
	str=="staubgefaesse"||str=="staubgefaess ab"||str=="staubgefaesse ab"||
	str=="lotos ab"||str=="schwarzen lotos ab"||str=="blueten"||
	str=="blueten ab"||str=="gefaesse"||str=="gefaesse ab"||
	str=="lotosblueten"||str=="lotosblueten ab") {
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" sucht schwarzen lotos in dfluss2.\n");
	
	if(lotosint>0) {	
		
		write(BSL("\nVorsichtig brichst Du ein volles Staubgefaess "
		"aus einer Lotosbluete und steckst es ein."));
		say(BSL("\n"+TPN+" pflueckt etwas aus einem Seerosenwald."));
		lotosint--;
		staubgefaess=CLONEOB("/d/dschungel/trintrasil/fluss/obj/lotos");
		staubgefaess->move(TP, M_NOCHECK);
		return 1;
	}
	
	if(lotosint<=0) {
		
		write(BSL("\nDu findest keine Lotosbluete mit einem vollen "
		"Staubgefaess. Du musst warten bis wieder eine Lotosbluete "
		"nachreift."));
		return 1;
	}
	return 1;}	
return 0;}

	
etwas(string str) {

object kaiman;
kaiman=find_living("trintkaiman");	
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" findet den riesenkaiman in dfluss2.\n");
	
	if(str=="etwas") {
		
	if(SCHILF->kaimanpresent()==1) {
		write(BSL("\nAls Du die Ursache fuer die Wellen genauer "
		"untersuchen willst, schwimmt ploetzlich ein gewaltiger "
		"Riesenkaiman aus dem Schilfkanal in den Fluss!\n\n"));
		say(BSL("\n"+TPN+" hat einen gewaltigen Riesenkaiman "
		"aufgestoert!\n\n"));
		SCHILF->kaimanmove();
	        return 1;
	}
	
	if(SCHILF->kaimanpresent()==0) {
		write(BS("Was meinst Du? Da ist nichts in dem grossen "
		"Schilfkanal."));
	        return 1;
	}
	
	return 0;}
}


kanaele() {
	
	if(SCHILF->kaimanpresent()==1) {
		return(BS("Seltsam. Aus einem besonders grossen Schilfkanal "
		"kommen eigenartige Wellen."));
	}
	
	if(SCHILF->kaimanpresent()==0) {
		return(BS("Einige der Kanaele im Schilf sind zwar sehr breit, "
		"aber vielleicht werden sie weiter im Schilf enger und seicht. "
		"Du kannst mit dem Fisch nicht dorthin."));
	}
}


kanal() {
	
	if(SCHILF->kaimanpresent()==1) {
		return(BS("Aus einem der Schilfkanaele plaetschern eigenartige "
		"Wellen als wuerde sich etwas sehr grosses darin bewegen."));
	}
	if(SCHILF->kaimanpresent()==0) {
		return(BS("Der Schilfkanal scheint ruhig zu sein. Trotzdem "
		"kannst Du mit dem Fisch nicht hinein schwimmen."));
	}
}


welle() {
	
	if(SCHILF->kaimanpresent()==1) {
		return(BS("Du solltest vorsichtig sein. Was auch immer solche "
		"Wellen macht muss recht gross sein."));
	}
	if(SCHILF->kaimanpresent()==0) {
		return(BS("Du kannst keine Wellen aus dem grossen Schilfkanal "
		"entdecken."));
	}
}


staub() {
	
	if(lotosint>1) {
		return(BS("Du erkennst "+lotosint+" Lotosblueten mit vollen "
		"Staubgefaessen. Du kannst sie abbrechen."));
	}
	
	if(lotosint==1) {
		return(BS("Du findest nur noch eine Lotosbluete mit vollen "
		"Staubgefaessen. Du kannst sie abbrechen."));
	}
	
	if(lotosint==0) {
		return(BS("Die Lotosblueten tragen gerade keine vollen "
		"Staubgefaesse."));
	}
}

		