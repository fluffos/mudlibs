#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


int anzahl=2 + random(4);


reset() {
	anzahl=2 + random(4);
	::reset();
}


void create()
{
  ::create();

fluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
"Der Fluss beschreibt hier eine leichte Biegung von Westen nach Suedosten. "
"Murmelnd schieben sich die Wassermassen des Rio de la Puseta gegen die "
"nordoestliche Schluchtwand. Auf dieser riesigen, leicht ueberhaengenden "
"Sandsteinwand erkennst Du schmale Felsvorspruenge und Rinnen in denen sich "
"kleine Pflanzen festgesetzt haben. Im Suedosten macht der Fluss eine Biegung "
"nach Sueden."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  

AD(({"schlucht","sandsteinschlucht","fluss","rio","rio de la puseta","puseta"}),
  "Der gruene Fluss beschreibt eine Biegung nach Suedosten. Nach Westen fuehrt "
  "er bis zu einem weit entfernten Wasserfall.");
  
AD(("wasserfall"),
  "Der Wasserfall ist so weit im Westen, dass Du ihn kaum ausmachen kannst.");
  
AD(("westen"),
  "Weit im Westen ist ein Wasserfall. Das ist alles was Du von hier aus "
  "erkennen kannst.");
  
AD(("suedosten"),
  "Du kannst von hier aus nicht erkennen was hinter der Biegung liegt.");
   
AD(("biegung"),
  "Der Fluss beschreibt hier murmelnd eine Biegung nach Suedosten. Dadurch "
  "druecken die Wassermassen bestaendig gegen die zerfurchte nordoestliche "
  "Schluchtwand.");

AD(({"wand","sandsteinwand","steinwand","felswand","uferwand","schluchtwand",
     "waende","sandsteinwaende","steinwaende","felswaende","uferwaende",
     "schluchtwaende"}),
  "Welche Wand meinst Du? Die nordoestliche oder die suedwestliche "
  "Schluchtwand?");
  
AD(({"nordoestliche schluchtwand","nordoestliche sandsteinwand",
     "nordoestliche felswand","nordoestliche wand","nordoestliche schluchtwand"}),
  "Die gelbe Sandsteinwand ist von tiefen, sanft geschwungenen Rinnen "
  "durchzogen. Auf manchen der schmalen Felsvorspruenge wachsen Pflanzen die "
  "sich hartnaeckig in den Stein krallen.");

AD(({"rinne","rinnen"}),
  "Die ausgewaschenen Rinnen laufen in sanften Schwuengen die nordoestliche "
  "Schluchtwand hinab.");
  
AD(("schwuenge"),
  "Diese Rinnen wurden wahrscheinlich vom Regen ausgewaschen.");
  
AD(({"tropen","regen"}),
  "Regen faellt hier in den Tropen ja nahezu taeglich.");
    
AD(({"suedwestliche wand","suedwestliche sandsteinwand","suedwestliche wand",
     "suedwestliche schluchtwand","suedwestliche felswand"}),
  "Die suedwestliche Schluchtwand ist sehr glatt und schimmert in nahezu "
  "makellosem Gelb.");
  
AD(("gelb"),
  "Der Rio de la Puseta hat die Schlucht in den weichen Sandstein geschuerft.");
  
AD(({"platz","stein"}),
  "Der karge, gelbe Sandstein ist ein harter Platz fuer die Pflanzen.");
  
AD(("sandstein"),
  "Der gelbe, weiche Sandstein wurde vom Rio de la Puseta tief ausgeschuerft.");
  
AD(("pflanzen"),
  "Du erkennst einen verkrueppelten Flussapfelbaum der weiter oben kuemmerlich "
  "auf einem Felsvorsprung waechst.");

AD(({"felsvorspruenge","vorspruenge","vorsprung","felsvorsprung"}),
  "Schmale Felsvorspruenge ragen aus der hohen noerdoestlichen Schluchtwand.");
    
ASD(({"flussapfelbaum","apfelbaum","baum","baeumchen"}),
  "baum");

ASD(({"aepfel","apfel","flussaepfel","flussapfel"}),
  "SDapfel");
  
AD(("etwas"),
  "Es muesste natuerlich wertlos sein.");

AD(("himmel"),
  "Der Himmel ist blau, wie sonst auch meistens.");

AD(({"grund","boden"}),
  "Du kannst den Grund des Flusses durch das gruene Wasser nicht erkennen.");
    
AD(({"wasser","wassermassen"}),
  "Die smaragdgruenen Wassermassen fliessen hier murmelnd durch die Biegung.");


AddSound( DEFAULT_SOUND,
   "Der Wasserfall ganz im Westen kannst Du kaum noch hoeren.");
   
AddSound(({"wasser","wasserfall"}),
   "w u u u s s s c c c h h h h");
 

  AddCmd(({"wirf","werfen","werf"}), "func_apfel");
  
    
  SUEDO
  WEST 
    }


SUEDOF(fluss7)
WESTF(fluss5)


SDapfel() {
	
	if(anzahl >= 2) {
		return(BS("Auf dem Baum haengen gleich "+anzahl+" reife "
		"Aepfel. Du koenntest ja versuchen etwas nach dem Baeumchen zu "
		"werfen. Vielleicht wirft es dann einen Flussapfel ab."));
	return 1;}
	
	if(anzahl == 1) {
		return(BS("Auf dem Baum haengt noch ein reifer Apfel. Du "
		"koenntest ja versuchen etwas nach dem Baeumchen zu werfen. "
		"Vielleicht wirft es dann einen Flussapfel ab."));
	return 1;}
		
	if(anzahl == 0) {
		return(BS("Schade! Das Baeumchen traegt gerade keine reifen "
		"Aepfel."));
	return 1;}
return 0;}
	
				
baum() {

	if(anzahl >= 2) {
		return(BS("Obwohl der Felsvorsprung sehr karg ist erkennst Du "
		"dennoch "+anzahl+" reife Flussaepfel auf dem Baeumchen."));
	return 1;}
	
	if(anzahl == 1) {
		return(BS("Obwohl der Felsvorsprung sehr karg ist traegt das "
		"Baeumchen dennoch einen reifen Flussapfel."));
	return 1;}
	
	if(anzahl == 0) {
		return(BS("Entweder ist der Felsvorsprung zu karg, oder Jemand "
		"hat sich bereits die Aepfel vom Baum geholt. Der kuemmerliche "
		"Flussapfelbaum ist leider leer."));
	return 1;}
	else {
		write("!MISTAKE! Bitte Mail an Trintrasil!\n");
	return 1;}
}
 
  
  
int func_apfel(string str) {

object apfel;
string was;
string wohin;
object wurfg;

write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" holt einen apfel in fluss6.\n");

if(!str) {  return 0;}
      
if( (sscanf(str, "%s nach %s" , was, wohin) ) ||
    (sscanf(str, "%s auf %s" , was, wohin) ) ) {
   	
   	if(wohin=="baum"||wohin=="apfelbaum"||wohin=="flussapfelbaum"||
   	wohin=="baeumchen"||wohin=="apfelbaeumchen"||
   	wohin=="flussapfelbaeumchen") {
   		
   		wurfg=present(was, TP);

                if(!wurfg)  {
                	
                	write(BS("Du hast doch gar kein "+CAP(was)+"!"));
                return 1; }

                if((!anzahl) && (wurfg)) {
                	
                	write(BS("Der Flussapfelbaum traegt gerade leider keine Aepfel."));
  	        return 1;}
  	
                if((anzahl) && (wurfg) && wurfg->QueryProp(P_NODROP) || 
                wurfg->QueryProp(P_NEVERDROP)||(wurfg->QueryProp(P_VALUE)>0) )  {
                	
                	write(BS("Du willst doch "+wurfg->name(WEN)+" sicher "
                	"nicht wegwerfen!"));
                return 1; }

                if((anzahl) && (wurfg) && !wurfg->QueryProp(P_NODROP) &&
                !wurfg->QueryProp(P_NEVERDROP) && (wurfg->QP(P_VALUE)==0) )  {
                	
                        write(BSL("\nDu holst weit aus, zielst und wirfst "
                        ""+wurfg->name(WEN)+" nach dem Flussapfelbaum."));            
                        say(BSL("\n"+TPN+" wirft einen Gegenstand nach einem "
                        "Flussapfelbaum."));
                        wurfg->remove();
                        anzahl--;
                        call_out("func_apfel1", 2);
                return 1;}
        return 1;}
        
        else {
        	write(" Mit Was willst Du nach Wem werfen?\n");
        return 1;}
return 1;}
return 0;}


int func_apfel1() {

object fapfel;
	
	fapfel=CLONEOB("/d/dschungel/trintrasil/fluss/obj/apfel");
	
	if( fapfel->move(TP, M_GET +M_SILENT)==ME_TOO_HEAVY ) {
		write(BS("Schade! Du kannst den Apfel nicht mehr tragen"));
		say(BS(""+TPN+" kann den Apfel nicht mehr tragen. So ein "
		"Schwaechling."));
		fapfel->remove();
	}
	
	else {
		write(BSL("\nPlatsch!!! Ein reifer Flussapfel faellt direkt neben Dir "
		"in den Fluss. Du steckst ihn schnell ein bevor er davon treibt.\n"));
		say(BSL("\nPlatsch!!! Ein reifer Apfel faellt von einem Flussapfelbaum "
		"herab den "+TPN+" schnell einsteckt.\n"));
		fapfel->move(TP, M_NOCHECK);
	}
}
