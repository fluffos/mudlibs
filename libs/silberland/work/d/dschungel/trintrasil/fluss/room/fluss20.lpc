#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();

dschungelfluss_details();
jagdgebiet();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Hier schwenkt der Fluss in einem weiten Bogen nach Suedosten. "
    "Die hohen Schluchtwaende weiter im Norden sind einem beinahe flachen Ufer "
    "gewichen. Nur das westliche Ufer ist durch Felstruemmer noch etwas "
    "erhoeht. Gegen Osten hast Du aber einen ungehindeten Einblick in den "
    "Dschungel."));    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "In einem weiten Bogen sucht sich der Rio de la Puseta seinen Weg zum "
    "Meer.");
  
  AD(({"norden","suedosten","bogen"}),
    "Im Norden kannst Du noch die lange imposante Bruchwand erkennen. Nach "
    "Suedosten fliesst der Fluss im wuchernden, draengenden Dschungel.");
    
  AD(({"bruchwand","fuss"}),
    "Du siehst noch die gelbe, gewaltige Bruchwand im Licht der Sonne "
    "leuchten.");
    
  AD(({"grundgestein","gestein","grund"}),
    "In der Schlucht des Rio de la Puseta siehst Du sicher mehr Sandstein.");
    
  AD(({"licht","sonnenlicht"}),
    "Der gelbe Sandstein der Wand reflektiert das Sonnenlicht.");
      
  AD(("sonne"),
    "Die weisse Sonnenscheibe brennt drueckend auf Dich nieder.");
    
  AD(("himmel"),
    "Der Himmel ist beinahe wolkenlos.");
    
  AD(({"sonnenscheibe","scheibe"}),
    "Die feuchte Hitze macht Dir zu schaffen. Naja Du befindest Dich auf einem "
    "Fluss, da kannst Du Dir doch Kuehlung verschaffen.");
    
  AD(("gesicht"),
    "Dein Gesicht glueht vor Hitze.");
    
  AD(("wasser"),
    "Das Wasser ist angenehm kuehl.");
    
  AD(("hitze"),
    "In der schattigen Schlucht noerdlich von Dir ist es sicher kuehler.");
    
  AD(({"schlucht","sandsteinschlucht"}),
    "Die Schlucht hat der Rio de la Puseta weiter im Norden in den weichen "
    "Stein gegraben.");
    
  AD(({"stein","sandstein"}),
    "Das Grundgestein des oberen Dschungelplateau besteht aus weichem gelben "
    "Sandstein.");
    
  AD(({"plateau","dschungelplateau"}),
    "Von hier aus siehst Du nicht mehr viel davon weil Dir der Dschungel schon "
    "die Sicht versperrt.");
    
  AD(("sicht"),
    "Die gewaltige Pflanzenmasse draengt und wuchert das es manchmal den "
    "Anschein hat als wuerde das Gehoelz in den Fluss hineinwachsen.");
    
  AD(("anschein"),
    "Das dichte Gehoelz am oestlichen Ufer haengt weit in den Fluss hinein.");
    
  AD(("gehoelz"),
    "Vor dem dichten Dschungel haben auch die erfahrenstem Jaeger grossen "
    "Respekt.");
    
  AD(("respekt"),
    "Den solltest Du haben.");
    
  AD(("jaeger"),
    "In Tijara findest Du sicher mehrere.");
    
  AD(("tijara"),
    "Wer hier ist und Tijara nicht kennt ist verdaechtig.");
    
  AD(("kuehlung"),
    "Kuehle Gesicht mit Wasser.");
    
  AD(({"meer","weg"}),
    "Es ist noch ein weiter Weg fuer den Fluss.");
    
  AD(({"schluchtwand","schluchtwaende"}),
    "Das westlichen Ufer ist noch uebersaet mit Sandsteinresten und halb "
    "ueberwucherten Felstruemmern. Aber von einer Schlucht kann man hier nicht "
    "mehr sprechen.");
  
  AD(({"felstruemmer","truemmer","felsbloecke","bloecke"}),
    "Im Norden direkt am Fuss der Bruchwand liegen die Felsbloecke noch viel "
    "dichter beieinander.");
    
  AD(("ufer") ,  
    "Das oestliche und das westliche Ufer sind hier sehr unterschiedlich.");
    
  AD(({"oestliches ufer","einblick","uferseite","blick","osten"}),
    "Das oestliche Ufer steig nur leicht zum Dschungel hin an. Ein breiter "
    "Streifen weisser Baumgerippe zeigt eine Ueberschwemmungslinie.");
    
  AD(({"linie","ueberschwemmungslinie","streifen","stelle"}),
    "Die blassen Baumstuempfe markieren die Stelle bis zu der der Fluss "
    "wohl oefter ueber die Ufer tritt.");

  AD(({"baumstuempfe","stuempfe","gerippe","baumgerippe","baeume","reste"}),
    "Diese Baeume muessen vor kurzem noch unter Wasser gewesen sein. "
    "Jetzt faulen ihre Reste in der Sonne dahin.");
    
  AD(({"dschungel","wald"}),
    "Nach Osten hast Du einen ungehinderten Ausblick auf den Dschungel. Grosse "
    "Baumriesen, wildes Dickicht und, verfilztes Unterholz kaempfen hier um "
    "ihren Platz.");
  
  AD(({"baumriesen","riesen"}),
    "Grosse, alte Riesen erheben sich aus dem engen Treiben des Dschungels "
    "und breiten ihre Kronen ungehindert ueber den Wald aus.");  
  
  AD(({"treiben","platz","pflanzen","pflanzenmasse","masse"}),
    "Das Leben draengt sich hier auf engstem Platz zusammen.");
    
  AD(("leben"),
    "Im Dschungel wimmelt es von Pflanzen und Tieren. Hier regiert das Gesetz "
    "des Staerkeren");
    
  AD(({"starke","staerkere","gesetz"}),
    "Lege alle Deine Waffen ab und geh in den Dschungel, dann siehst Du wer "
    "der Staerkere ist.");
    
  AD(("waffen"),
    "Feig!");
    
  AD(({"kronen","schatten"}),
    "Erhaben breiten die Baumriesen ihre Kronen aus, scheinbar "
    "unbekuemmert vom Treiben in ihrem Schatten.");
    
  AD(({"dickicht","unterholz"}),
    "Bunte, exotische Straeucher und Schlingpflanzen machen den Dschungel "
    "beinahe unzugaenglich.");
    
  AD(({"straeucher","schlingpflanzen"}),
    "Kein Platz des Dschungels ist ungenutzt.");
    
  AD(("tiere"),
    "Die unterschiedlichsten Tiere leben in und auf dem Dschungel, und keines "
    "davon ist zahm.");
    
  AD(({ "westen","westliches ufer","westliche uferseite"}),
    "Am westlichen Ufer liegen halbueberwachsene, grosse Felsbloecke.");
    
  AD(({"rest","sandsteinreste"}),
    "Die gelbe Sandsteinwand ist hier nur noch ein kaum erkennbarer Rest.");
  
  AD(({"wand","waende","felswand","felswaende","uferwand","uferwaende"}),
    "Welche Wand meinst Du? Die Schluchtwaende weiter im Norden oder die "
    "gewaltige Bruchwand?");
     
  AD(({"sandsteinwand","sandsteinwaende"}),
    "Die hohen Sandsteinwaende der Schlucht brechen im Norden abrupt durch "
    "den Plattenbruch des Dschungelplateau ab.");
    
  AD(({"bruch","plattenbruch"}),
    "Hier siehst Du nur noch Reste und Felstruemmer auf der westlichen "
    "Uferseite.");
      
  AD(("boden"),
    "Du schwimmst auf einem Fisch ueber den Fluss. Was erwartest Du genau?");
    
  AddCmd(("kuehle"), "func_kuehlung");
  
  AddItem("/d/dschungel/trintrasil/fluss/npc/krokodil.lpc" ,REFRESH_DESTRUCT);   
    
    
  NORD
  SUEDO


 AddSound( DEFAULT_SOUND,
   "Aus dem Dschungel wehen Tierlaute zu Dir herueber.");
 
 AddSound(({"tierlaute","laute"}),
   "!!UH UH UH GROAAAAAAR!!");
   
 AddSmell( DEFAULT_SMELL,
   "Ein suesser Duft liegt ueber dem Dschungel.");
 
 AddSmell(({"duft","dschungel","blueten","geruch"}),
   "Ein aufdringlicher Geruch nach insektenlockenden Blueten haengt über dem Fluss.");
   
}

 
 NORDF(fluss19a)
 SUEDOF(fluss21)
 
 
func_kuehlung(string str) {
	
	write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" kuehlt sich in fluss20.\n");
	
	notify_fail("Was willst Du mit was kuehlen?");
	
	if(str=="gesicht mit wasser"||str=="gesicht"||
	str=="gesicht mit flusswasser") {
		
		WSCHLANGENABFRAGE(
		write(BSL("\nSolange Dein Fisch mit der Wasserschlange kaempft "
		"hast Du keine Zeit Dir das Gesicht mit Wasser zu kuehlen."));,
		write(BSL("\nDu schoepfst mit beiden Haenden kuehles Wasser aus "
		"dem Fluss und laesst es Dir geniesserisch ueber das Gesicht "
		"rinnen."));
		say(BSL("\n"+TPN+" kuehlt sich mit Flusswasser ab."));)
	return 1;}	
return 0;}