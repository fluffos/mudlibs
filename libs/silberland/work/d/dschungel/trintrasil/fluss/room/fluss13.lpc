  if(!TURM->koboldaufturm()) {
   return BS("Schau genau auf dem Dir anscheinend bekannten Felsturm nach. "
             "Dort sitzt niemand.");
             }
          }
    
    
seil() {
  
  if(TP->QueryProp("downclimber")) {
   return BS("Du baumelst am Ende des Seiles. Du solltest einen Fisch rufen "
             "oder wieder nach oben klettern.");
             }
        
  if(TP->QueryProp("climber")) {
   return BS("Du bist gerade am klettern. Pass auf das Du nicht in den Fluss "
             "faellst.");
             }
             
  if((TURM->seilhaengt()==0)&&(!TP->QueryProp("climber"))) {
   return BS("Wenn Du ein Seil auf den Felsturm hinauf schleudern willst "
             "musst Du das Seil erst an etwas befestigen. Sonst wuerde es "
             " oben ja nicht halten.");
             }
  
  if((TURM->seilhaengt()==1)&&(!TP->QueryProp("climber"))) {
   return BS("Da baumelt ja schon ein Seil von oben herab. Daran koenntest Du "
             "hochklettern.");
        }
       
  if((TURM->seilhaengt()==2)&&(!TP->QueryProp("climber"))) {
   return BS("Es wurde gerade erst ein Seil hinauf geworfen. Es hat noch keinen "
             "festen Halt.");
        }
       }


etwas() {
	
object anker;
anker=present("anker", TP);

  if(!anker) {    
    return BS("Die Kletterhilfe muesste aus Metall sein und Haken haben die "
    "sich auf der Oberseite des Felsturmes festhaken.");
        }
  if( anker && anker->QueryProp("ankerseil") ) {
    return BS("Na sowas! Du hast ja genau das Richtige schon bei Dir! Und ein "
    "Seil ist auch schon daran befestigt!");
        }

  if( anker && !anker->QueryProp("ankerseil") ) {
    return BS("Na sowas! Du hast ja genau das Richtige schon bei Dir! Du musst "
    "nur noch ein Seil daran befestigen.");
        }   
} 