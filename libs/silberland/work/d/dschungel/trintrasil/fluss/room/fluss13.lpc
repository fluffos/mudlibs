//ooooooooooooooo KLETTER UND SCHLEUDER-CALL_OUTS ENDE oooooooooooooooooooooooooo



//oooooooooooooooo CALL_OTHERS VON TURM ooooooooooooooooooooooooooooooooooooooooo

klettererdef1() {
	kletterer=1;
}


//ooooooooooooooooo CALL_OTHERS von turm ENDE ooooooooooooooooooooooooooooooooooo

//ooooooooooooooooooooo ALLES FISCHRUFRELEVANTES oooooooooooooooooooooooooooooooo

//gleich wie die bewegung sind diese funktionen nicht standardisiert von fischdef.h 
//uebernehmbar, da zusaetzlich beruecksichtigt werden muss ob der spieler gerade am seil
//klettert

int func_fischruf(string str) {
	
	object pfeife;
	pfeife=present("fischpfeife", TP);	
  	
  	notify_fail("Mit was willst Du pfeifen?\n");
  	
  	if(str=="mit pfeife"||str=="mit fischpfeife"||str=="nach fisch mit pfeife"||
  	str=="pfeife"||str=="fischpfeife"||str=="fisch"||str=="nach fisch")  {
  		
  		if(TP->QueryProp("climber")) {
  			
  			write(BSL("\nKonzentriere Dich lieber aufs Klettern. sonst faellst "
  			"Du noch in den Fluss."));
  			return 1;
  		}
  		
  		if( !TP->QueryProp("downclimber") && !TP->QueryProp("climber") ) {
  			
  			write(BSL("\nDu sitzt doch schon auf einem Fisch. Warum solltest "
  			"Du noch andere Fische rufen?"));
  			return 1;
  		}
  		
  		if( TP->QueryProp("downclimber") && !pfeife ) {
  			
  			write(BSL("\nUm mit einer Fischpfeife einen Fisch zu rufen braucht "
  			"man zu allererst einmal eine FISCHPFEIFE!"));
  			return 1;
  		}
  		
  		if( TP->QueryProp("downclimber") && pfeife && !present("stdfisch", TO) ) {
  			
  			write(BSL("\nDu haeltst Deinen Kopf unter Wasser und blaest mit "
  			"aller Kraft in die Pfeife. Du hoerst zwar absolut nichts, glaubst "
  			"aber ein unangenehmes Vibrieren zu spueren."));
  			say(BSL("\n"+TPN+" steckt seinen Kopf ins Wasser. Kurz darauf "
  			"spuerst Du ein leichtes, unangenehmes Vibrieren."));
  			call_out("fisch", 3);
  			return 1;
  		}
  		
  		if( TP->QueryProp("downclimber") && pfeife && present("stdfisch", TO) ) {
  			
  			write(BSL("\nWarum willst Du schon wieder Fische herbeipfeifen wo "
  			"doch noch einer hier ist."));
  			return 1;
  		}
  	}
}

            

int func_reiten(string str) {
	
	object fisch;
	fisch=present("STDFISCH", TO);
	
	notify_fail("Auf was willst Du steigen?\n");
	
	if(str=="auf fisch"||str=="fisch"||str=="auf ruecken fisches"||
	str=="auf ruecken fische"||str=="auf ruecken fisch"||str=="fischruecken"||
	str=="auf fischruecken")  {
		
		if(TP->QueryProp("climber")) {
			
			write(BSL("\nKonzentriere Dich lieber aufs Klettern! Sonst faellst "
			"Du noch in den Fluss."));
			return 1;
		}
		
		if( !TP->QueryProp("downclimber") && !TP->QueryProp("climber") ) {
			
			write(BSL("\nDu sitzt doch schon auf einem Fisch!"));
			return 1;
		}
		
		if( present("STDFISCH", TO) && TP->QueryProp("downclimber") ) {
			
			write(BSL("\nDu steigst vorsichtig vom Ende des Seiles auf den "
			"Ruecken eines Fisches. Der Fisch scheint Dich ohne Probleme zu "
			"tragen."));
			say(BSL("\n"+TPN+" steigt vorsichtig vom Ende des Seiles auf den "
			"Ruecken eines Fisches und reitet mit ihm auf dem Wasser."));
			kletterer=0;
			call_other("/d/dschungel/trintrasil/fluss/room/turm", "klettererdef0");
			fisch->remove();
			TP->SetProp("downclimber", 0);
			TP->SetProp("climber", 0);//sollte er garnicht haben (nur zur sicherheit)
			return 1;
		}
		
		if( !present("STDFISCH", TO) && TP->QueryProp("downclimber") ) {
			
			write(BSL("\nDa ist kein Fisch auf den Du steigen koenntest, den "
			"muesstest Du erst mit einer Fischpfeife rufen."));
			return 1;
		}
	}
}
  
//--------------------- alle fischcallouts --------------------------------------  
  
fisch() {
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss13",
	BSL("\nDas Wasser um den Felsturm geraet seltsam in Bewegung."));
	call_out("fisch1", 3);
}
 
   
fisch1() {
	
	object fisch;
	
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss13", BSL("\nSprudelnd und "
	"spritzend tauchen ploetzlich einige sehr grosse Fische auf."));
	fisch=CLONEOB("/d/dschungel/trintrasil/fluss/npc/stdfisch");
	fisch->move("/d/dschungel/trintrasil/fluss/room/fluss13", M_TPORT);
	fisch=CLONEOB("/d/dschungel/trintrasil/fluss/npc/stdfisch");
	fisch->move("/d/dschungel/trintrasil/fluss/room/fluss13", M_TPORT);
	fisch=CLONEOB("/d/dschungel/trintrasil/fluss/npc/stdfisch");
	fisch->move("/d/dschungel/trintrasil/fluss/room/fluss13", M_TPORT);
	call_out("fisch2", 2);
}


fisch2() {
	
	write(BSL("\nDu koenntest auf den Ruecken eines der Fische steigen."));
	call_out("fisch3", 4);
}


fisch3() {
	
	int i;
	object *inv;
	inv=all_inventory(TO);
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(i>=0) {
			
			if( inv[i]->id("stdfisch") ) {
				
				tell_room("/d/dschungel/trintrasil/hoehle/room/fels", BSL("\n"
				"Ein Fisch schwimmt wieder hinaus auf den Fluss."));
				inv[i]->remove();
				call_out("fisch3", 1+random(4));
				return 1;
			}
			
			if(i<0) {
				return 1;
			}
		}
	}
}

