         		"genuegend Schwung zu holen und schleuderst ihn dann "
         		"mit aller Kraft auf den Felsturm."));
                        anker->SetProp("kletterhaken", 1);
     	                anker->SetProp(P_NOGET, BS("Du kannst den Anker nicht "
     	                "einfach nehmen. Er haelt das Seil das zum Fluss "
     	                "hinabhaengt und an dem vielleicht noch jemand "
     	                "hochklettern moechte. Du musst das Seil vorher "
     	                "hochziehen."));
     	                anker->move("/d/dschungel/trintrasil/fluss/room/turm", M_TPORT);
                        TURM->seilstatus2();//sagt das seil gerade unterwegs, aber noch nicht begehbar ist
     	                say(BSL("\n"+TPN+" schleudert den Anker mit aller Kraft "
     	                "auf einen birnenfoermigen Felsturm in Deiner Naehe."));
     	                call_out("kletterhaken1", 2);
     	        return 1;}

                if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
                anker && !anker->QueryProp("ankerseil") && 
                TURM->seilhaengt()==0 ) {
                	
                	write(BSL("\nDu schwingst den Anker einige Male um "
                	"genuegend Schwung zu holen und schleuderst ihn mit "
                	"aller Kraft auf den Felsturm."));
                        anker->move("/d/dschungel/trintrasil/fluss/room/turm");
                        say(BSL("\n"+TPN+" schleudert einen Anker OHNE Seil auf "
                        "einen Felsturm in Deiner Naehe. :)"));
                        call_out("seillos", 2);
                return 1;}
            
                if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
                !anker ) {
                	
                	write(BS("Du hast so etwas gar nicht."));
                return 1;}
        
                if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
                TURM->seilhaengt()==1 ) {
                	
                	write(BS("Es ist bereits ein Seil auf dem Felsturm "
                	"befestigt."));
                return 1;}
            return 1;}
     return 0;}
return 0;}
 


int func_turmklettern(string str) {
	
	notify_fail("Woran willst Du hochklettern, am Seil?\n");
	
	if(str=="an seil hoch"||str=="am seil hoch"||str=="seil hoch"||
	str=="hinauf"||str=="nach oben"||str=="an seil hinauf"||
	str=="am seil hinauf"||str=="seil hinauf"||str=="an seil nach oben"||
	str=="am seil nach oben"||str=="seil nach oben"||str=="hoch"||
	str=="nach oben"||str=="auf turm"||str=="auf turm hinauf"||
	str=="auf felsturm"||str=="auf felsturm hinauf") {
		
		if(TP->QueryProp("climber")) {
			
			write(BS("Du kletterst ja schon!"));
			return 1;
		}
		
		if(TP->QueryProp("downclimber")) {
			
			write(BSL("\nDu packst das Seil fester und beginnst wieder "
			"hinauf zu klettern."));
			TP->SetProp("downclimber", 0);
			TP->SetProp("climber", 1);
			say(BSL("\n"+TPN+" klettert das Seil wieder hoch."));
			call_out("turmklettern1a", 3);
			return 1;
		}
		
		if( present("wasserschlange", environment(this_player())) ) {
			
			int i, moveint;
			object *inv;
			inv=all_inventory(environment(this_player()));
			
			for(i=sizeof(inv)-1;i>=0;i--) {
				
				tell_object(this_player(), ""+i+"");
				if( inv[i]->id("EVENTSCHLANGE") ) {
					
					if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
						
						moveint++;
					}
				}
				
				if( !inv[i]->id("EVENTSCHLANGE") ||
					(inv[i]->id("EVENTSCHLANGE") && 
					!inv[i]->QueryProp(""+this_player()->name()+"")) ) {
				}
			}
				
			if(moveint>0) {
				
				write(BS("Eine Wasserschlange hat Deinen Fisch "
				"umschlungen! Du musst sie erst toeten."));
			}
			
			if(moveint==0) {
				
				if( !TP->QueryProp("climber") && 
				!TP->QueryProp("downclimber") && TURM->seilhaengt()==2 ) {
					
					write(BSL("\nDas Seil wurde gerade erst "
					"geworfen. Du weisst nicht ob es auch schon "
					"fest sitzt."));
					return 1;
				}
				
				if( !TP->QueryProp("climber") && 
				!TP->QueryProp("downclimber") && TURM->seilhaengt()==1 &&
				kletterer==0 ) {
					
					write(BSL("\nDu packst das Seil mit beiden "
					"Haenden und ziehst Dich daran hoch. Dein Fisch "
					"schwimmt wieder gemaechlich auf den Fluss hinaus."));
					TP->SetProp("climber", 1);
					say(BSL("\n"+TPN+" klettert von seinem Fisch "
					"aus ein Seil hoch."));
					kletterer=1;
					call_other("/d/dschungel/trintrasil/fluss/room/turm", 
					"klettererdef1");
					call_out("turmklettern1", 3);
					return 1;
				}
				
				if( !TP->QueryProp("climber") && 
				!TP->QueryProp("downclimber") && TURM->seilhaengt()==1 &&
				kletterer==1 ) {
					
					write(BS("Da ist gerade jemand auf dem Seil. Du "
					"musst noch warten"));
					return 1;
				}
				
				if( !TP->QueryProp("climber") && 
				!TP->QueryProp("downclimber") && TURM->seilhaengt()==0 ) {
					
					write(BS("Woran willst Du hochklettern? Hier "
					"ist nichts woran man hochklettern koennte."));
					return 1;
				}
			}
			moveint=0;
			return 1;
		}
		
		if( !present("wasserschlange", environment(this_player())) ) {
			
			if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
                        TURM->seilhaengt()==2 ) {
                        	
                        	write(BSL("\nDas Seil wurde gerade erst geworfen. Du "
                        	"weisst nicht ob es auch schon fest sitzt."));
                        	return 1;
                        }
                        
                        if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
                        TURM->seilhaengt()==1 && kletterer==0 ) {
                        	
                        	write_file("/d/dschungel/trintrasil/log/flusslog",
                        	""+ctime()+": "+CAP(getuid(TP))+" klettert in fluss13 hoch.\n");
	
                        	write(BSL("\nDu packst das Seil mit beiden Haenden und "
                        	"ziehst Dich daran hoch. Dein Fisch schwimmt wieder "
                        	"gemaechlich auf den Fluss hinaus."));
                        	TP->SetProp("climber", 1);
                        	say(BSL("\n"+TPN+" klettert von seinem Fisch aus ein "
                        	"Seil hoch."));
                        	kletterer=1;
                        	call_other("/d/dschungel/trintrasil/fluss/room/turm", 
                        	"klettererdef1");
                        	call_out("turmklettern1", 3);
                        	return 1;
                        }
                        
                        if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
                        TURM->seilhaengt()==1 && kletterer==1 ) {
                        	
                        	write(BS("Da ist gerade jemand auf dem Seil. Du musst "
                        	"noch warten"));
                        	return 1;
                        }
                        
                        if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
                        TURM->seilhaengt()==0 ) {
                        	
                        	write(BS("Woran willst Du hochklettern? Hier ist nichts "
                        	"woran man hochklettern koennte."));
                        	return 1;
                        }
                        return 1;
                }
                return 0;
        }
        return 0;
}
    
        

