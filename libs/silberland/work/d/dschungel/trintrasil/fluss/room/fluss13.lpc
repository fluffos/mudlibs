                	write(BS("Eine Wasserschlange hat Deinen Fisch "
                	"umschlungen! Du musst sie erst toeten."));
                }
                
                if(moveint==0) {
                	
                	if( !TP->QueryProp("climber") && 
                	!TP->QueryProp("downclimber") && anker && 
                	anker->QueryProp("ankerseil") && 
                	TURM->seilhaengt()==0 ) {
                		
                		write(BSL("\nDu schwingst den Anker einige Male "
                		"um genuegend Schwung zu holen und schleuderst "
                		"ihn dann mit aller Kraft auf den Felsturm."));
                                anker->SetProp("kletterhaken", 1);
     	                        anker->SetProp(P_NOGET, BS("Du kannst den Anker "
     	                        "nicht einfach nehmen. Er haelt das Seil das "
     	                        "zum Fluss hinabhaengt und an dem vielleicht "
     	                        "noch jemand hochklettern moechte. Du musst das "
                                "Seil vorher hochziehen."));
     	                        anker->move("/d/dschungel/trintrasil/fluss/room/turm", M_TPORT);
                                TURM->seilstatus2();//sagt das seil gerade unterwegs, aber noch nicht begehbar ist
     	                        say(BSL("\n"+TPN+" schleudert den Anker mit "
     	                        "aller Kraft auf einen birnenfoermigen Felsturm "
     	                        "in Deiner Naehe."));
     	                        call_out("kletterhaken1", 2);
     	                return 1;}
     	                
     	                if( !TP->QueryProp("climber") && 
     	                !TP->QueryProp("downclimber") && anker && 
     	                !anker->QueryProp("ankerseil") && 
     	                TURM->seilhaengt()==0 ) {
     	                	
     	                	write(BSL("\nDu schwingst den Anker einige Male "
     	                	"um genuegend Schwung zu holen und schleuderst "
     	                	"ihn mit aller Kraft auf den Felsturm."));
                                anker->move("/d/dschungel/trintrasil/fluss/room/turm");
                                say(BSL("\n"+TPN+" schleudert einen Anker OHNE "
                                "Seil auf einen Felsturm in Deiner Naehe. :)"));
                                call_out("seillos", 2);
                        return 1;}
                        
                        if( !TP->QueryProp("climber") && 
                        !TP->QueryProp("downclimber") && !anker ) {
                        	
                        	write(BS("Du hast so etwas gar nicht."));
                        return 1;}
                        
                        if( !TP->QueryProp("climber") && 
                        !TP->QueryProp("downclimber") &&
                        TURM->seilhaengt()==1 ) {
                        	
                        	write(BS("Es ist bereits ein Seil auf dem "
                        	"Felsturm befestigt."));
                        return 1;}    

                }
                moveint=0;
         return 1;}

         if( !present("wasserschlange", environment(this_player())) ) {
         	
         	if( !TP->QueryProp("climber") && !TP->QueryProp("downclimber") &&
         	anker && anker->QueryProp("ankerseil") && 
         	TURM->seilhaengt()==0 ) {
         		
         		write_file("/d/dschungel/trintrasil/log/flusslog",
