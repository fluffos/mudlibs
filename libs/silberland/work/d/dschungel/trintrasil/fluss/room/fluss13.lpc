//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%SPECIAL DETAILS %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


jemand() {
	
	if(TURM->koboldaufturm()) {
		return BS("Jemand scheint Dich zu beobachten! Ob das mit dem "
		"eigenartigen Fischgeruch zusammenhaengt den der Wind immer "
		"wieder heran traegt?");
	}
	
		
	if(!TURM->koboldaufturm()) {
		return BS("Du kannst absolut niemanden entdecken. Vielleicht "
		"hast Du Dich getaeuscht.");
	}
}


fischspecialdet() {
	
	WSCHLANGENABFRAGE(
	return BS("Eine Wasserschlange hat Deinen Fisch umschlungen. Du musst "
	"sie schnell toeten bevor sie Deinen Fisch umbringt.");,
	
	if(TP->QueryProp("downclimber")) {
		return BS("Du baumelst am Ende eines Seiles. Du koenntest mit "
		"einer Fischpfeife nach einem Fisch pfeifen oder wieder nach "
		"oben klettern.");
        }
        
        if(!TP->QueryProp("downclimber")) {
        	return BS("Dein Fisch traegt Dich sicher ueber den Fluss.");
        })
}



turm() {
	
	if( TURM->koboldaufturm() && TURM->seilhaengt()==0 ) {
		
		return BS("Als Du den eigenartigen Felsturm genauer bedrachtest faellt Dir "
		"endlich die haessliche Gestalt auf die auf ihm sitzt. Wie eine "
		"ueberzogene Karrikatur eines aufgeblaehten Kindes grinst Dich ein "
		"sandgelber Kobold haemisch von oben herab an.");
	}
	
	if( !TURM->koboldaufturm() && TURM->seilhaengt()==0 ) {
		
		return BS("Der Felsturm gleich in Deiner Naehe ist ca 7 Meter hoch. Du kannst "
		"eigentlich sonst nichts besonderes erkennen. Du koenntest ja versuchen "
		"auf die Oberseite des Felsturmes zu klettern.");
	}
	
	if( TURM->koboldaufturm() && TURM->seilhaengt() ) {
		
		return BS("Als Du den eigenartigen Felsturm genauer betrachtest faellt Dir "
		"endlich die haessliche Gestalt auf die auf ihm sitzt. Wie eine "
		"ueberzogene Karrikatur eines aufgeblaehten kindes grinst Dich ein "
		"sandgelber Kobold haemisch von oben herab an. Du siehst ausserdem "
		"noch ein Seil das vom Felsturm herabbaumelt, an dem Du "
		"hochklettern koenntest.");
	}
	
	if( !TURM->koboldaufturm() && TURM->seilhaengt() ) {
		
		return BS("Der Felsturm gleich in Deiner Naehe ist ca 7 Meter hoch. Du "
		"erkennst ein Seil, das von oben herabbaumelt, an dem Du "
		"hochklettern koenntest.");
	}
}


kind() {
	
	if(TURM->koboldaufturm()) {
		
		return BS("Erinnert Dich irgendwie an klein "+TPN+".");
	}
	
	if(!TURM->koboldaufturm()) {
		
		return BS("welches Kind meinst Du?");
	}
}
 

geruch() {
	
	if(TURM->koboldaufturm()) {
		
		return BS("Gerueche riecht man im allgemeinen besser als man sie sieht.");
	}
	
	if(!TURM->koboldaufturm()) {
		
		return BS("Du riechst eigentlich nichts Besonderes.");
	}
}


gestalt() {
	
	if(TURM->koboldaufturm()) {
		
		return BS("Dir ist der Kobold deshalb nicht aufgefallen weil er sich "
