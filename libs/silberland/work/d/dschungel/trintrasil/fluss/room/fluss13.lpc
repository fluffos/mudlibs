//oooooooooooooooooo KLETTER UND SCHLEUDER CALL_OUTS oooooooooooooooooooooooooooo

turmklettern1() {
	
	write(BSL("\nMit den Fuessen findest Du im unteren Teil des Felsturmes keinen "
	"Halt. Der Wind schauckelt Dich leicht."));
	say(BSL("\nDer Fisch von "+TPN+" schwimmt wieder hinaus auf den Fluss."));
	call_out("turmklettern2", 3);
}
  
  
turmklettern1a() {
	
  write(BSL("\nMit den Fuessen findest Du im unteren Teil des Felsturmes keinen "
            "Halt. Der Wind schauckelt Dich leicht."));
  call_out("turmklettern2", 3);
    }
    
    
    
    
turmklettern2() {
	
  write(BSL("\nDeine Arme beginnen schon zu erlahmen. Endlich kannst Du die "
           "Fuesse gegen den Fels stemmen."));
  call_out("turmklettern3", 3);
    }


turmklettern3() {
	
  write(BSL("\nEndlich Du bist nun fast oben."));
  call_out("turmklettern4", 3);
    }
  
  
turmklettern4() {
	
  write(BSL("\nDas war ja anstrengender als Du Dir das von unten vorgestellt "
            "hast."));
  TP->SetProp("climber", 0);
  TPM("/d/dschungel/trintrasil/fluss/room/turm", M_GO, "keuchend oben auf dem "
      "Felsturm an", "kommt", "klettert herauf");
  kletterer=0;
  call_other("/d/dschungel/trintrasil/fluss/room/turm", "klettererdef0");      
        }


           
kletterhaken1() {
  
  write(BSL("\nDer Anker landet klirrend oben auf dem Felsturm."));
    say(BSL("\nDer Anker von "+CAP(getuid(TP))+" landet klirrend oben auf dem "
           "Felsturm."));
