               this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss14", M_GO, 
               "auf einem Fisch nach Sueden", "schwimmt", 
               "schwimmt auf einem Fisch herein"); 
         return 1;} 
    return 1;}
   
   if((interactive(this_player()))&&(TP->QueryProp("downclimber"))) {
     
     write(BSL("\nDu baumelst noch am Ende des Seiles. Du musst erst mit einer "
              "Fischpfeife pfeifen um auf den Fluss reiten zu koennen."));
         return 1;}
         
   if((interactive(this_player()))&&(TP->QueryProp("climber"))) {
     
     write(BSL("\nDu kletterst gerade!!"));
         return 1;}
  
   if((!interactive(this_player()))&&(this_player()->QueryProp("insekt")==1)) { 
     this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss14", M_GO, 
         "nach Sueden", "schwirrt", 
         "schwirrt herein"); 
         return 1;} 
   
   if((!interactive(this_player()))&&(this_player()->QueryProp("vogel")==1)) { 
     this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss14", M_GO, 
         "nach Sueden", "fliegt", 
         "fliegt herein"); 
         return 1;} 
  
   if((!interactive(this_player()))&&(!this_player()->QueryProp("insekt"))&& 
      (!this_player()->QueryProp("vogel"))) { 
     this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss14", M_GO, 
         "nach Sueden", "schwimmt", 
         "schwimmt herein"); 
   return 1;} 
return 0;} 
 
//ooooooooooooooooooooooooooooo BEWEGUNG ENDE ooooooooooooooooooooooooooooooooooo
 
  
int func_kobold(string str) {

int i, moveint;
object *inv, kobold, wurf, anker;
string was;
inv=all_inventory(environment(this_player()));



if(!str) {return 0;}
  
if(sscanf(str, "%s nach kobold", was) || 
   sscanf(str, "%s auf kobold", was) )  { 


 wurf=present(was, TP);

  if(TP->QueryProp("climber")) {
    
    write(BS("Du kletterst gerade! Pass lieber auf das Du nicht abstuerzt."));
     return 1;}
       
  if(TP->QueryProp("downclimber")) {
  	
    write(BS("Du baumelst am Ende des Seiles. Du koenntest mit einer "
             "Fischpfeife pfeifen oder wieder nach oben klettern."));
     return 1;}


     	if( present("wasserschlange", environment(this_player())) ) {

     		for(i=sizeof(inv)-1;i>=0;i--) {
     			tell_object(this_player(), ""+i+"");

                        if( inv[i]->id("EVENTSCHLANGE") ) {
                        	tell_object(this_player(), "SCHLANGE!\n");

                                if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
                                	moveint++;
                                }
                        }
                        if( !inv[i]->id("EVENTSCHLANGE") ||
                        (inv[i]->id("EVENTSCHLANGE") && 
                         !inv[i]->QueryProp(""+this_player()->name()+"")) ) {

                        }
                }
                if(moveint>0) {
                	  write(BS("Eine Wasserschlange hat Deinen Fisch "
                	  "umschlungen! Du musst sie erst toeten."));
                }
                if(moveint==0) {
                	
                	  if( !TP->QueryProp("climber")&& 
                	  !TP->QueryProp("downclimber")&& !wurf ) {
                	  	
                	  	write(BS("Du hast gar kein "+CAP(was)+"!"));
                	  return 1;}
                	  
                	  if( !TP->QueryProp("climber") && 
                	  !TP->QueryProp("downclimber") && 
                	  TURM->koboldaufturm() && (wurf->QueryProp(P_NODROP) ||
                	  wurf->QueryProp(P_NEVERDROP) || 
                	  wurf->QueryProp(P_VALUE)>>0) ) {
                	  	
                	  	write(BS("Aber "+CAP(getuid(TP))+"! Du willst "
                	  	"doch "+wurf->name(WEN)+" sicher nicht "
                	  	"wegwerfen!"));
                	  return 1; }
                	  
                	  if( !TP->QueryProp("downclimber") && 
                	  !TP->QueryProp("climber") && TURM->koboldaufturm() && 
                	  !wurf->QP(P_NODROP) && !wurf->QP(P_NEVERDROP) && 
                	  wurf->QP(P_VALUE)==0 ) {
                	  	
                	  	write(BSL("\nDu holst weit aus, zielst und "
                	  	"wirfst "+wurf->name(WEN)+" nach dem Kobold."));            
                	  	say(BSL("\n"+TPN+" wirft einen Gegenstand nach "
                	  	"einem Kobold."));
                	  	wurf->remove();
                	  	call_other("/d/dschungel/trintrasil/fluss/room/turm", "kobold_wurf");  
                	  return 1;}
                	  
                	  if( !TP->QueryProp("climber") && 
                	  !TP->QueryProp("downclimber") && 
                          !TURM->koboldaufturm() ) {
                          	
                          	write(BS("Auf was willst Du denn werfen? Da ist "
                          	"nichts auf dem Felsturm."));
                          	say(BS(""+TPN+" rudert eigenartig mit den "
                          	"Armen."));
                          return 1;} 

                }
                moveint=0;
         return 1;}

         if( !present("wasserschlange", environment(this_player())) ) {
         	  
         	  if( !TP->QueryProp("climber")&& !TP->QueryProp("downclimber")&&
         	  !wurf ) {
         	      	
         	      	write(BS("Du hast gar kein "+CAP(was)+"!"));
         	  return 1;}
         	  
         	  if( !TP->QueryProp("climber") && 
         	  !TP->QueryProp("downclimber") && TURM->koboldaufturm() && 
         	  (wurf->QueryProp(P_NODROP) || wurf->QueryProp(P_NEVERDROP) ||
         	  wurf->QueryProp(P_VALUE)>>0) ) {
         	  	
         	  	write(BS("Aber "+CAP(getuid(TP))+"! Du willst doch "
         	  	""+wurf->name(WEN)+" sicher nicht wegwerfen!"));
         	  return 1; }
         	  
         	  if( !TP->QueryProp("downclimber") && 
         	  !TP->QueryProp("climber") && TURM->koboldaufturm() && 
         	  !wurf->QP(P_NODROP) && !wurf->QP(P_NEVERDROP) && 
         	  wurf->QP(P_VALUE)==0 ) {
         	  	
         	  	write_file("/d/dschungel/trintrasil/log/flusslog",
         	  	""+ctime()+": "+CAP(getuid(TP))+" schiesst den kobold in fluss13 ab.\n");
         	  	
         	  	write(BSL("\nDu holst weit aus, zielst und wirfst "
         	  	""+wurf->name(WEN)+" nach dem Kobold."));            
      	                say(BSL("\n"+TPN+" wirft einen Gegenstand nach einem "
      	                "Kobold."));
                        wurf->remove();
                        call_other("/d/dschungel/trintrasil/fluss/room/turm", "kobold_wurf");  
                  return 1;}
                  
                  if( !TP->QueryProp("climber") && 
                  !TP->QueryProp("downclimber") && !TURM->koboldaufturm() ) {
                  	
                  	write(BS("Auf was willst Du denn werfen? Da ist nichts "
                  	"auf dem Felsturm."));
                        say(BS(""+TPN+" rudert eigenartig mit den Armen."));
                  return 1;} 
         return 1;} 
    return 1;}     
return 0;}



