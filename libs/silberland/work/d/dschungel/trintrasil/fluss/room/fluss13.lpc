int kletterer=0;//ob gerade jemand am seil herumklettert 


reset() {
	if(kletterer!=0) {
	}
	
	if(kletterer==0) {
		::reset();
	}
}

   
void create()
{
  ::create();

jagdgebiet();

TURM->lade();

  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Die Schlucht wirkt durch ueberhaengenden Uferwaende ziemlich "
    "duester. Einige Felstuerme ducken sich wie bucklige, monstroese "
    "Gnome in den Schatten der Waende. Aus dem helleren Sueden hoerst Du "
    "ein gedaempftes Rauschen."));
    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  

  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Der Rio de la Puseta windet sich dem Meer entgegen.");
    
  AD( ("meer"),
    "Der Fluss muendet auf der noch beinahe unerforschten Suedseite "
    "des Kontinentes ins Meer.");
    
  AD(({"kontinent","insel"}),
    "Eine dschungelueberwucherte Insel mitten im warmen Ozean. "
    "Ein Traum.. reif fuer die Insel.. oder ist auch das nur die "
    "uebliche Karotte vor der Eselnase?");
    
  AD(("ozean"),
    "Der Ozean ist immer um uns, nur warm ist er nicht immer.");
    
  AD(("traum"),
    "Schoen und schillernd solange man nicht zu genau hinsieht.");
  
  AD(({"karotte","idiotenkarotte"}),
    "Die Karotte der der Esel nachlaeuft aber nie erreicht, "
    "so wie unser taegliches Kasperltheater das uns immer aufs "
    "neue aus dem Bett stemmt.");
    
  AD(({"eselnase","nasen"}),
    "Unsere Nasen.");
    
  AD(("esel"),
    "Ich und Du, Muellers Kuh, Muellers Esel der bist Du.");
    
  AD(("kuh"),
    "Ob Kuh oder Esel, haben beide nicht wirklich viel zu sagen.");
    
  AD(("mueller"),
    "wer wohl der Mueller ist? Wahrscheinlich niemand.");
    
  AD(("niemand"),
    "graugraugrau... schau genau... vieles ist grau...");
  
  AD(("bett"),
    "Was wuerde passieren wenn Du mal liegen bleibst?.");
    
  AD(({"theater","kasperltheater"}),
    "Trallali, trallala ich die Idiotenkarotte bin schon da...");

  AD(("seite"),
    "Was meinst Du? Die Suedseite des Kontinentes?");
      
  AD(({"suedseite"}),
  "Du wirst sie sehen wenn Du weiter stromabwaerts faehrst.");
  
  AD(({"sandstein","gestein","stein"}) ,  
    "In dem daemmrigen Licht verliert der gelbe Stein etwas an Farbkraft.");
    
  AD(({"farbkraft","kraft"}),
    "Der sonst gelb leuchtende Sandstein wirkt hier matt und duester.");
    
  AD(("schlucht"),
    "Die Schlucht ist hier besonders daemmrig, wodurch die zahlreichen "
    "Felstuerme bedrohlich auf Dich wirken. Im Sueden ist die Schlucht "
    "allerdings wieder sonniger.");
    
  AD(({"tuerme","waechter","felstuerme"}),
    "Die Felstuerme sind hier merkwuerdig krumm. Wahrscheinlich hatten die "
    "Gesteinsadern aus denen sie geformt wurden eben diesen Verlauf. "
    "Dennoch wirken diese buckligen Gebilde wie uebergrosse Gnome auf Dich.");
     
  AD(({"gnome","gebilde","gnome"}),
    "In dem daemmrigen Licht scheinen Dich die Felstuerme spoettisch zu "
    "beobachten.");
    
  AD(("licht"),
    "Die tiefen Schatten hauchen den seltsamen Felsen unheimliches Leben ein.");
    
  AD(({"leben","rand","gesichtsfeld"}),
    "Wenn Du nicht genau hinsiehst scheinen sich die Gnome lauernd zu bewegen.");
    
  AD(("feld"),
    "Bist Du sogar zu faul Gesichtsfeld zu untersuchen?");
    
  AD(("schatten"),
    "Durch die ueberhaengenden Felswaende ist die Schlucht hier besonders "
    "schattig. Im Sueden ist die Schlucht wieder heller.");
    
  AD(({"gesteinsadern","adern"}),
    "Die Felstuerme waren haertere Gesteinsadern im Fels die der Fluss "
    "freigespuelt hat.");
    
  AD(("verlauf"),
    "Unheimlich sich vorzustellen das sich alle diese Gebilde einmal tief im "
    "Fels befunden haben.");
     
  AD(("fels"),
    "Das gesamte Gestein besteht hier aus weichem Sandstein.");
    
  AD(({"uferwand","uferwaende","wand","waende","felswaende","felswand",
       "sandsteinwand","sandsteinwaende"}),
    "Die steilen Uferwaende ragen schattig in gelb-orangen Toenen neben Dir "
    "auf. Weiter oben, wo noch Sonnenlicht auf den Fels trifft, schimmern "
    "sie in einem feuchten orange.");
    
  AD(({"sonnenlicht","sonne","schein"}),
    "Durch die schuetzende Schlucht erreicht die stechende Sonne den "
    "Fluss nur als daemmriger Schein.");
    
  AD(("wasser"),
    "Der Rio de la Puseta ist bekannt fuer sein smaragdgruenes Wasser."),
      
  AD(({"farbe","farbtoene","toene","gelb"}),
    "Farbtoene von gelb bis orange ziehen sich durchs Gestein.");

  AD(({"gischtregen","gischt","regen"}),
    "Ein leichter, sanfter Schleier weht von Sueden herein."),
    
  AD(({"schleier","sueden"}),
    "Mit einem feinen Gischtregen weht ein Rauschen von Sueden "
    "durch die Schlucht.");

  AD(("rauschen"),
    "Gedaempft hallt ein Rauschen durch die Schlucht.");
    
  AD(("wind"),
    "Unermuedlich wimmert der Wind leise in den Felstuermen, hier scheint der "
    "Wind sogar zu riechen.");
    
  AD(("gruen"),
    "Der Rio de la Puseta ist beruehmt fuer seine gruene Farbe.");
    
  AD(("himmel"),
    "Die Sonne dringt kaum zu Dir herab.");
    
  AD(({"ruecken","schauer"}),
    "Dir laeuft ein unangenehmer Schauer den Ruecken hinunter.");
    
  AD(("richtung"),
    "Hmm, es kommt Dir vor als wuerde der Gestank aus westen kommen.");
    
  AD(("westen"),
    "Direkt westlich neben Dir befindet sich ein brauner Felsturm in Form "
    "einer umgedrehten Birne."),
    
  AD(({"form","formen"}),
    "Der Felsturm verbreitert sich nach oben hin stark.");
    
  AD(("kichern"),
    "Lausch doch einmal.");
    
  AD(("fall"),
    "Gestank kommt nach dem Fall.");
        
  AD(("wasserfall"),
    "Im Sueden scheint ein Wasserfall zu liegen.");
    
  AD(("naehe"),
    "Von den vielen Felstuermen hier ist dieser birnenfoermige am naechsten.");

  AD(("boden"),
    "Du kannst den Grund des Flusses durch das truebgruene Wasser "
    "nicht erkennen.");
     
  AD(("grund"),
    "Der Grund liegt sicher tief unter Dir.");
   
  AD(({"oberseite"}),
    "Der Felsturm ist ueberhaengend. Ohne Kletterhilfe ist es undenkbar das Du "
    "ihn erklettern koenntest.");
    
  AD(({"hilfe","kletterhilfe"}),
    "Wenn Du etwas haettest an dem ein Seil befestigt ist, und das Du "
    "hinaufschleudern koenntest.");
  
  AD(("metall"),
    "Das ist schwer und hart genug.");
    
  AD(("haken"),
    "Wenn Du etwas aus Metall mit Haken, an dem ein Seil festgebunden ist, "
    "noch nicht hast, dann such doch. Vielleicht findest Du etwas hier ganz in der "
    "Naehe.");
  
  AD(({"richtiges","richtige"}),
    "Schau doch einmal nach.");

//+++++++++++++++++++++ SD ANFANG +++++++++++++++++++++++++++++++++++++++++++++++
  ASD(("jemand"),
    "jemand");

  ASD(("fisch"),
    "fischspecialdet");
    
  ASD(("seil"),
    "seil");

  ASD(("etwas"),
    "etwas");
 
  ASD(({"birne","felsturm","turm"}),
    "turm");
     
  ASD(("kind"),
    "kind");
    
  ASD(({"trangeruch","geruch","gerueche"}),
    "geruch");
   
  ASD(({"gestalt"}),
    "gestalt");
    
  ASD(("kutte"),
    "kutte");
    
  ASD(("kobold"),
    "kobold");
    
  ASD(("platz"),
    "platz");
    
  ASD(("gegenstand"),
    "gegenstand");
    
  ASD(("karrikatur"),
    "karrikatur");
    
  ASD(("augen"),
    "augen");
    
  ASD(("zunge"),
    "zunge");
    
  ASD(("kopf"),
    "kopf");
    
  ASD(("koerper"),
    "koerper");
  
  ASD(("fischkopf"),
    "fischkopf");
    
  ASD(("ohren"),
    "ohren");
    
  ASD(("luft"),
    "luft");
    
  ASD(({"gestank","fischgeruch","fischtrangeruch"}),
    "fischgeruch");
  
  ASD(("lappen"), 
    "lappen");
    
//+++++++++++++++++++++ SD ENDE +++++++++++++++++++++++++++++++++++++++++++++++++

     
    
  AddCmd(({"wirf","werfen","werf"}), "func_kobold");
  AddCmd(({"schleudere","schleuder"}), "func_kletterhacken");
  AddCmd(({"klettere","kletter"}), "func_turmklettern");
  AddCmd(("schau"), "func_schau");
  AddCmd(("pfeife"), "func_fischruf");
  AddCmd(({"steig","steige"}), "func_reiten");
  
  
  
  AddExit("nordwesten", ([ 
         EX_FUNC:"nordwfunc"]) );                
  AddExit("sueden", ([
         EX_FUNC:"suedfunc"]) );
  

     
 AddSound( DEFAULT_SOUND,
   "Der Wind bricht sich stoehnend an den Felstuermen.\n"
   "Von Sueden her hoerst Du gedaempft das Rauschen eines Wasserfalles.");

 AddSound(({"rauschen","wasserfall"}),
   "!!!WUUUUUUUUSCHHHHH!!!");
 
 AddSound(({"kichern"}),
   "Du kannst niemanden entdecken. Vielleicht hast Du Dich getaeuscht.");
   
 AddSmell( DEFAULT_SMELL,
   "Irgendwie riecht es hier nach ranzigem Tran.");
   
 AddSmell(("tran"),
   "Ab und zu traegt der Wind einen fuerchterlichen Fischtrangeruch zu Dir.");
   
 AddSmell(({"fischgeruch","geruch","fisch","gestank","fischtrangeruch",
   "trangeruch"}),
   "So richtig nach vergammelten Fisch !!WUERG!!"),
   
 AddSmell(("wind"),
   "Du versuchst die Richtung auszumachen und glaubst das der Wind den Geruch "
   "aus Westen hertraegt.");
   
 AddSmell(("westen"),
   "Ja die Richtung muesste passen. Das solltest Du einmal untersuchen.");
   

call_out("RoomMessage", 2+random(5));


}

//RoomMessages sollen nur kommen wenn ein kobold in turm.c sitzt
RoomMessage() {
	
	if(TURM->koboldaufturm()) {
		
		switch(random(12)) {
			
			case 1: tell_room(TO,
			BSL("\nDer daemmrige Schatten der Uferwaende liegt auf "
			"Dir."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 2: tell_room(TO,
			BSL("\nHat da nicht gerade Jemand hinter Deinem Ruecken "
			"gekichert?"));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 3: tell_room(TO,
			BSL("\nDer Wind weht einen leichten Trangeruch heran."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 4: tell_room(TO,
			BSL("\nDer Rio de la Puseta schimmert in mattem "
			"Gruen."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 5: tell_room(TO,
			BSL("\nDer Wind heult schaurig in der Schlucht."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 6: tell_room(TO,
			BSL("\nAus dem Sueden hoerst Du ein bestaendiges "
			"Rauschen."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 7: tell_room(TO,
			BSL("\nEin leiser Gischtregen weht von Sueden durch die "
			"Schlucht."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 8: tell_room(TO,
			BSL("\nWar da nicht ein leises Kichern zwischen den "
			"Felsen?"));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 9: tell_room(TO,
			BSL("\nAm Rand Deines Gesichtsfeldes hat sich etwas "
			"bewegt!"));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 10: tell_room(TO,
			BSL("\nDu fuehlst Dich von Jemanden beobachtet."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 11: tell_room(TO,
			BSL("\nDas Rauschen eines Wasserfalles weht von Sueden "
			"heran."));
			call_out("RoomMessage", 25+random(10));
			break;
			
			case 0: tell_room(TO,
			BSL("\n!HiiiiHiHiHiiii!"));
			call_out("RoomMessage", 25+random(10));
			break;
			
			default: tell_room(TO,
			BSL("\nDer Wind weht einen leichten Trangeruch heran."));
			call_out("RoomMessage", 25+random(10));
		}
	}

	
	if(!TURM->koboldaufturm()) {
		
		call_out("RoomMessage", 50);
	}
}

       
//ooooooooooooooooooooooo BEWEGUNG oooooooooooooooooooooooooooooooooooooooo

//die bewegung ist nicht aus dem stdriopusetaraum uebernehmbar, da dort das klettern nicht
//abgefragt wird. selbiges gilt fuer das rufen der fisch (siehe unten)
 
int nordwfunc() { 

    int i, moveint;
    object *inv;
    inv=all_inventory(environment(this_player()));

     if( interactive(this_player()) && !TP->QueryProp("climber") &&
         !TP->QueryProp("downclimber") ) {

     	if( present("wasserschlange", environment(this_player())) ) {

     		for(i=sizeof(inv)-1;i>=0;i--) {

                        if( inv[i]->id("EVENTSCHLANGE") ) {

                                if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
                                	moveint++;
                                }
                        }
                        if( !inv[i]->id("EVENTSCHLANGE") ||
                        (inv[i]->id("EVENTSCHLANGE") && !inv[i]->QueryProp(""+this_player()->name()+"")) ) {

                        }
                }
                if(moveint>0) {
                	write(BS("Die Schlange laesst Deinen Fisch nicht los! "
                        "Du musst sie erst toeten!"));
                }
                if(moveint==0) {
                        write("\nDu steuerst Deinen Fisch nach Nordwesten.\n\n");
                        this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss12", M_GO, 
                        "auf einem Fisch nach Nordwesten", "schwimmt", 
                        "schwimmt auf einem Fisch herein"); 
                }
                moveint=0;
         return 1;}

         if( !present("wasserschlange", environment(this_player())) ) {
               write("\nDu steuerst Deinen Fisch nach Nordwesten.\n\n");
               this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss12", M_GO, 
               "auf einem Fisch nach Nordwesten", "schwimmt", 
               "schwimmt auf einem Fisch herein"); 
         return 1;} 
    return 1;}
   
   if((interactive(this_player()))&&(TP->QueryProp("downclimber"))) {
     write(BSL("\nDu baumelst noch am Ende des Seiles. Du musst erst mit einer "
               "Fischpfeife pfeifen wenn Du auf den Fluss reiten willst."));
              
         return 1;}
   if((interactive(this_player()))&&(TP->QueryProp("climber"))) {
     write(BSL("\nDu kletterst gerade!!"));
         return 1;}
   
   if((!interactive(this_player()))&&(this_player()->QueryProp("insekt")==1)) { 
     this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss12", M_GO, 
         "nach Nordwesten", "schwirrt", 
         "schwirrt herein"); 
         return 1;} 
    
    if((!interactive(this_player()))&&(this_player()->QueryProp("vogel")==1)) { 
      this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss12", M_GO, 
          "nach Nordwesten", "fliegt", 
          "fliegt herein"); 
         return 1;} 
    
    if((!interactive(this_player()))&&(!this_player()->QueryProp("insekt"))&& 
       (!this_player()->QueryProp("vogel"))) { 
      this_player()->move("/d/dschungel/trintrasil/fluss/room/fluss12", M_GO, 
          "nach Nordwesten", "schwimmt", 
          "schwimmt herein"); 
         return 1;} 
        return 0;}                     
 



 int suedfunc() { 
   
    int i, moveint;
    object *inv;
    inv=all_inventory(environment(this_player()));

     if( interactive(this_player()) && !TP->QueryProp("climber") &&
         !TP->QueryProp("downclimber") ) {

     	if( present("wasserschlange", environment(this_player())) ) {

     		for(i=sizeof(inv)-1;i>=0;i--) {

                        if( inv[i]->id("EVENTSCHLANGE") ) {

                                if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
                                	moveint++;
                                }
                        }
                        if( !inv[i]->id("EVENTSCHLANGE") ||
                        (inv[i]->id("EVENTSCHLANGE") && !inv[i]->QueryProp(""+this_player()->name()+"")) ) {

                        }
                }
                if(moveint>0) {
                	write(BS("Die Schlange laesst Deinen Fisch nicht los! "
                        "Du musst sie erst toeten!"));
                }
                if(moveint==0) {
                        write("\nDu steuerst Deinen Fisch nach Sueden.\n\n");
