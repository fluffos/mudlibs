#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fbewdef.h"
#include "/d/dschungel/trintrasil/fluss/stdriopuseta.lpc"


void create()
{
  ::create();


fluss_details();
jagdgebiet();


  SetProp( P_INT_SHORT, "Am Rio de la Puseta" );
  SetProp( P_INT_LONG, break_string(
    "Der Rio de la Puseta windet sich durch die schattige, gelb-orange "
    "Sandsteinschlucht. Verspielt glitzert das Sonnenlicht auf dem gruen leuchtendem "
    "Wasser. Nordostlich von Dir steht einer der Felstuerme abseits der "
    "Uferwand im Fluss."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );  
 
  AD(({"fluss","rio de la puseta","rio","puseta"}),
    "Der Rio de la Puseta umspuelt hier einen der Felstuerme.");
    
  AD(({"osten","nordosten"}),
    "Du kannst nach Osten hinter den Felsturm schwimmen.");
    
  AD(("meer"),
    "Der Rio de la Puseta fliesst auf der Suedseite des Kontinentes ins Meer.");
    
  AD(({"suedseite","seite"}),
  "Du wirst sie sehen wenn Du weiter stromabwaerts faehrst.");
  
  AD(({"sandstein","gestein","stein"}) ,  
    "Das milde Gelb der Uferwand ist ein schoener Kontrast zum gruenen Fluss.");
    
  AD(("kontrast"),
    "Die gelben Waende schimmern matt im Licht das der gruene Fluss reflektier.");
    
  AD(("schatten"),
    "Der kuehlende Schatten ist viel angenehmer als die drueckende Hitze des "
    "Dschungels.");
    
  AD(("hitze"),
    "Schweisstreibende, feuchte und erschoepfende Hitze.");
    
  AD(("dschungel"),
    "Die gruene Hoelle liegt hinter dem Rand der Uferwaende verborgen.");
    
  AD(({"hoelle","gruene hoelle"}),
    "So nennen die malariakranken Jaeger schaudernd den Dschungel.");
    
  AD(("jaeger"),
    "Du findest in Tijara sicher einige von ihnen.");
    
  AD(("tijara"),
    "Ich weiss schon Du glaubst hier ist ein Forscherpunkt versteckt, aber "
    "Tijara muss Du einfach kennen.");
    
  AD(({"schlucht","bett","flussbett","sandsteinschlucht"}),
    "Mit der Zeit hat sich der Rio de la Puseta dieses tiefe Flussbett "
    "in den Sandstein geschuerft.");
    
  AD(({"tuerme","waechter","felstuerme"}),
    "Dir erscheinen die farbigen Felstuerme die der Fluss ausgespuelt "
    "hat wie ernste Waechter die sich stumm an die Uferwaende reihen.");
     
  AD(({"uferwand","uferwaende","wand","waende","sandsteinuferwand","felswaende",
       "sandsteinuferwaende","sandsteinwand","sandsteinwaende"}),
    "Die steilen, hohen Sandsteinuferwaende werfen ihren kuehlen Schatten "
    "ueber die Schlucht. Sie sind hier so hoch das Du ihren Rand nicht "
    "mehr erkennen kannst.");
    
  AD(("zeit"),
    "Geniess es, noch hast Du Zeit.");
    
  AD(({"sonnenlicht","licht","sonne","schein"}),
    "Durch die hohen Uferwaende ist die Schlucht sehr schattig "
    "und daemmrig.");
    
  AD(("wasser"),
    "Der Rio de la Puseta ist bekannt fuer sein smaragdgruenes Wasser."),
      
  AD(({"farbe","farbtoene","toene","gelb"}),
    "Farbtoene von gelb bis orange ziehen sich durchs Gestein.");

  AD(({"rand"}),
    "Den Rand der Schlucht kannst Du nicht mehr erkennen. Ober Dir "
    "hebt sich nur der blaue Himmel von den dunklen Waenden ab.");
    
  AD(({"himmel","forscherpunkt"}),
    "Seltsam Dir kommt es so vor als wuerdest Du weit oben einen "
    "schwarzen Punkt am Himmel sehen.");
    
  AD(("punkt"),
    "Oh!! Der Punkt wird ja immer groesser...\n"
    "!!!PITSCH!!!\n"
    "Na sowas da hat ein Fischadler glatt Dein Auge getroffen. Du kannst "
    "ueber so eine Zielgenauigkeit nur staunen.");
    
  AD(({"genauigkeit","zielgenauigkeit"}),
    "Vor Bewunderung vergisst Du ganz Dich ueber den Fischadler "
    "zu aergern.");
  
  AD(({"felsturm","turm","riese","felsriese","felssaeule","saeule"}),
    "Der Fluss umspuelt im Nordenosten neben Dir eine Felssaeule die "
    "anscheinend aus haerterem Stein ist.");
  
  AD(("stein"),
    "Der Felsriese ist aus einem roten Gestein.");
      
  AD(({"fischadler","adler"}),
    "Den Fischadler kannst Du nicht sehen, der kreist zu hoch oben "
    "ueber der Schlucht. Aber Du erkennst ihn an seinem Kot.");
    
  AD(("kot"),
    "Der Kot des Fischadlers in Deinem Auge.");
    
   AD(({"bewunderung","auge"}),
     "Tja der Adler zielte gut.");
     
   AD(("boden"),
     "Du kannst den Grund des Flusses durch das truebgruene Wasser "
     "nicht erkennen.");
     
   AD(("grund"),
     "Du traust Dich nicht so recht vom Fisch zu springen um nach "
     "ihm zu tauchen.");
       
   AD(("wind"),
     "Lausche doch einmal dem himmlischen Kind.");
     
   AD(({"kind","himmlisches kind"}),
     "So nennen die Maerchenerzaehler oft den verspielt wirkenden Wind.");
     
   AD(({"maerchenerzaehler","erzaehler"}),
     "Die Seefahrer nennen den Wind sicher anders als die Erzaehler in "
     "Ellesar.");
     
   AD(({"ellessar","waldstadt","wald","stadt"}),
     "Besuche doch einmal die Lagerfeuer des Waldstadt.");
     
   AD(({"feuer","lagerfeuer"}),
     "Dort wirst Du sicher Maerchenerzaehler treffen.");
     
   AD(({"seefahrer","fahrer"}),
     "Wer einmal einen tobenden Orkan erlebt hat wird den Wind nie mehr Kind "
     "nennen.");
     
   AD(("orkan"),
     "Eine ganz andere Seite des Windes als ein laues Sommerlueftchen.");
     
   AD(({"sommerlueftchen","lueftchen"}),
     "Der Seefahrer wuerde ueber darueber lachen.");
     
   AD(({"seite","zugang"}),
     "Seefahrer und Erzaehler haben eben beide andere Erfahrungen mit dem Wind.");
     
   AD(("seufzen"),
     "Der Wind bricht sich leise an den Felswaenden.");
     
   AD(({"felsspitzen","spitzen","fels","form","formen"}),
     "Der Wind hat viele seltsame Formen aus dem Fels gescheuert.");
     
  
  NORD
  SUEDO
  OST
  
  
 AddSound( DEFAULT_SOUND,
   "Der Schrei eines Fischadlers klingt durch das Seufzen des Windes "
   "zu Dir herab.\n");

 AddSound(({"fischadler","adler","schrei"}),
   "!!!KRAAAAKRAAAAAAAAA!!!");
 
 AddSound(({"wind","kind","himmlisches kind","himmlischem kind"}),
   " !!HUIIIIIIIHUIIIIIIIIIIIIIIII!! ");
   
 AddSound(("plaetschern"),
   "Der Fluss klatscht dumpf gegen das Gestein.");
 
}


 NORDF(fluss10) 
 OSTF(fluss11) 
 SUEDOF(fluss13) 
 

