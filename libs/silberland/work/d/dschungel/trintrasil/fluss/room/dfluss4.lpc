#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>

inherit "/std/room";

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fischdef.h"


int siebanzahl=1;
int gold=1+random(4);


init() {
	
	object schatten;
	schatten=clone_object("/d/dschungel/trintrasil/fluss/npc/schatten.lpc");
	
	::init();
	
	if( living(this_player()) && !interactive(this_player()) && !TP->QueryProp("flussnpc") &&
	!TP->QueryProp("shadow(trint)") ) {
		
		schatten;
		schatten->setze_besitzer();
		TP->SetProp("shadow(trint)", 1);
	}
}


void create()
{
  ::create();

SetProp( P_INT_SHORT, "Auf einem Felsbrocken im Rio de la Puseta");
SetProp( P_INT_LONG, break_string(
"Du stehst auf einem gelben, flachen Felsbrocken mitten im schaeumenden Rio de "
"la Puseta. Der Fluss rauscht hier durch einige Felsbloecke weiter nach "
"Suedosten, aber hier auf dem grossen Felsbrocken bist Du ziemlich sicher. Wenn "
"Du hier wieder weg willst musst Du wohl einen Fisch anlocken."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN:TT_JUNGLE]) );  

AD(({"rio","fluss","rio de la puseta","puseta"}),
  "Der Fluss umspuelt schaeumend den Felsbrocken. An der Hinterseite des "
  "Felsblockes hat der Fluss einigen Schutt abgelagert.");

AD(({"felsbloecke","bloecke","felsen","schnellen","stromschnellen"}),
  "Der Fluss bricht schaeumend und rauschend an den Felsbloecken. Es waere "
  "wohl Selbstmord zu versuchen mit einem Fisch dem Fluss weiter nach "
  "Suedosten zu folgen.");
  
AD(({"felsbrocken","brocken","block","felsblock","fels"}),
  "Der grosse flache Felsblock liegt sicher und fest mitten im rauschenden "
  "Rio de la Puseta. Immer wieder spritzt das schaeumende Flusswasser zu Dir "
  "herauf. An der Hinterseite hat der Fluss Schutt zusammengespuelt.");
  
AD(({"mord","selbstmord"}),
  "Du wuerdest gegen die Felsen geschleudert werden und ertrinken.");

AD(("fisch"),
  "Ein Fisch ist fuer Dich die einzige Moeglichkeit hier wegzukommen. Wenn "
  "Du eine Fischpfeife hast dann pfeife einfach mit ihr.");
  
AD(({"moeglichkeit","pfeife","fischpfeife"}),
  "Wenn Du mit der Fischpfeife pfeifst lockst Du grosse Fisch an, auf denen "
  "Du reiten kannst.");
      
AD(({"flusswasser","wasser"}),
  "Das Wasser rauscht spritzen ueber die Felsbloecke weiter nach Suedosten.");
  
AD(("schutt"),
  "Diese Seite des Felsbrockens ist der Stroemung abgewandt, darum hat der "
  "Fluss Steine, Sand und Kiesel hier abgelagert.");
  
AD(({"hinterseite","seite","stroemung","schutz"}),//special detail fuer zwerge
  "An der Hinterseite ist die Stroemung durch den Schutz des Felsblockes viel "
  "schwaecher, und daher hat der Fluss hier Gesteinsschutt abgelagert. "
  "Vielleicht hat er ja auch etwas wertvolles angespuelt?");

AD(("suedosten"),
  "Weiter nach Suedosten erkennst Du das sich der Flusslauf noch weit "
  "fortsetzt. Aber es ist wohl unmoeglich auf einem Fisch weiter zu reiten.");
  
AD(({"lauf","flusslauf"}),
  "Der Fluss fliesst noch sehr weit durch vollkommen unbekannten Dschungel.");
  
AD(("dschungel"),
  "Du erkennst den Dschungel hinter den Schilfguerteln an den Ufern.");
    
AD(({"schilf","schilfguertel","ufer","guertel"}),
  "Das feuchte, schlammige Ufer ist dicht mit Schilf bewachsen.");
  
AD(("etwas"),
  "Es lohnt sich vielleicht das Geroell und die Steine zu untersuchen.");
  
AD(({"schutte","geroell","gesteinsschutt","steine"}),
  "Das Geroell wurde zu einem lockeren Haufen zusammengeschwemmt und sieht "
  "recht lose und tueckisch aus. Bunte Flusskiesel und Sand schimmert in den "
  "Spalten zwischen den einzelnen Steinen.");

AD(("haufen"),
  "Das Geroell wurde vom Fluss zusammengetragen und bildet einen losen Haufen.");
    
AD(({"kiesel","sand","flusskiesel","ablagerungen","ablagerung","stein"}),
  "Feiner gelber Sand und bunte Kiesel haben sich in den Spalten abgelagert.");
  
AD(({"spalten"}),
  "Eigenartig, da schimmert ja etwas weisses in einer Spalte.");
  
AD(("spalte"),
  "In der Spalte liegen halb verdeckt und teilweise schon zerbrochen einige "
  "Knochen. Du findest auch einige Kleiderreste.");

AD(({"leiche","skelett","knochen"}),
  "Die Knochen scheinen schon lange hier zu liegen und sind teilweise schon "
  "zerbrochen.");
     
AD(("kerl"),
  "Was den Goldsucher hier wohl getoetet hat?");
  
AD(({"sucher","goldsucher"}),
  "Er hat diesen Felsen anscheinend fuer einen guten Platz zum Goldwaschen "
  "gehalten und auch etwas gefunden.");

AD(({"gold","goldwaschen","platz"}),
  "Du koenntest ja auch einmal versuchen hier Gold zu waschen.");
    
AD(("boden"),
  "Auch wenn der Felsen etwas nass ist bist Du hier ziemlich sicher.");
  
AD(({"sonne","himmel"}),
  "Die Sonne brennt ungehindert herab. Durch den Fluss ist es dennoch etwas "
  "kuehler.");

AD(({"gischtwellen","gischt"}),
  "Immer wieder spritzt zischend Gischt bis zu Dir herauf.");
  
AD(("strudel"),
  "Zwischen den Felsen gurgeln kleine Strudel.");


AddSound( DEFAULT_SOUND,
"Der Fluss rauscht spritzen ueber Felsbloecke.");
 
AddSound(("fluss"),
"Der Fluss rauscht spritzen ueber Felsbloecke.");

  
AddCmd(({"wasche","siebe","suche"}), "searchingforaheartofgold"); 
AddCmd(({"untersuche","unt"}), "goldsieb");
AddCmd(("test"), "goldfinderprop");


AddRoomMessage(({
	"\nDer Fluss schwappt spritzen ueber den Felsbrocken.\n",
  	"\nDer Fluss rauscht spritzend ueber die Felsen.\n",
  	"\nWeisse Gischtwellen und Strudel gurgeln zwischen den Felsen.\n",
  	"\nPITTSCHHH\nGischt spritzt bis zu Dir herauf.\n",
  	"\nDie Stromschnellen sehen wild und ziemlich gefaehrlich aus.\n",
  	"\nDer Felsbrocken ist nass und schluepfrig vom spritzenden Fluss.\n",
  	"\nWUUSSCCHHHHH.. WUUSSCCHHHHH..\n",
  	"\nDer Fluss springt rauschend und spritzend ueber die Felsen.\n" 
}), 35);

  
 PFEIFE
 REITEN
  
}


FLUSSFISCHRUF
FLUSSREITFUNC(/d/dschungel/trintrasil/fluss/room/dfluss3)
FLUSSFISCHCALLOUTS(um den Felsbrocken)

objects() {
	
int i;
object *inv;
inv = all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( living(inv[i]) ) {
		}
		
		if( !living(inv[i]) ) {
			return 1;
		}
	}
}


goldfinderprop() {
	
	TP->SetProp("goldfinder", 0);
	return 1;
}


int goldsieb(string str) {

object sieb, nugget;
	
	if(str=="kleider"||str=="kleiderreste"||str=="reste"||str=="fetzen"||
	str=="kleiderfetzen") {
		
		if( TP->QueryProp("goldfinder") ) {
			write(BS("Hier unter den Kleiderresten hast Du einmal "
			"ein altes Goldsieb gefunden."));
			return 1;
		}
		
		if( siebanzahl==1 && !TP->QueryProp("goldfinder") ) {
			
			TP->SetProp("goldfinder", 1);
			siebanzahl=0;
			sieb=CLONEOB("/d/dschungel/trintrasil/fluss/obj/sieb.lpc");
			
			if(sieb->move(TP, M_GET, M_SILENT)==ME_TOO_HEAVY) {
				write(BSL("Unter den schon nahezu ganz aufgeloesten "
				"Kleiderresten findest Du ein altes Goldsieb und ein "
				"glaenzendes Goldnugget, die Du leider nicht mehr "
				"tragen kannst."));
				sieb->move(TO, M_NOCHECK+ M_SILENT);
			}
			
			else {
				write(BS("Unter den schon nahezu ganz aufgeloesten "
				"Kleiderresten findest Du ein altes Goldsieb und ein "
				"glaenzendes Goldnugget, die Du einsteckst. Der arme "
				"Kerl war wohl ein Goldsucher!"));
				nugget=CLONEOB("/d/dschungel/trintrasil/fluss/obj/nugget.lpc");
				nugget->move(TP, M_NOCHECK+ M_SILENT);
				say(BS(""+TPN+" durchsucht eine Spalte."));
			}
			return 1;
		}
		
		if( siebanzahl==0 && !TP->QueryProp("goldfinder") ) {
			
			write(BS("Die Kleiderreste sehen durchwuehlt aus. "
			"Anscheinend hat sie schon jemand vor Dir durchsucht."));
			return 1;
		}
	}
	return 0;
}

		
int searchingforaheartofgold(string str) {
	
object nugget, sieb;	
sieb=present("goldsieb", TP);

notify_fail("Was willst Du waschen?\n");

        write_file("/d/dschungel/trintrasil/log/flusslog",
	""+ctime()+": "+CAP(getuid(TP))+" waescht Gold in dfluss4.\n");
		
	if(str=="gold"||str=="nach gold"||str=="mit sieb nach gold"||
	str=="mit goldsieb nach gold"||str=="mit sieb gold"||str=="mit goldsieb "
	"gold") {
		
	if( sieb && gold>0 ) {
		
		switch(random(5)) {
			
			case 0: write(BSL("\nDu schaufelst den Sand und kleine "
			"Steinchen in das Sieb und schuettelst sie langsam "
			"durch. Leider findest Du nichts, aber wahrscheinlich "
			"brauchst Du einfach Geduld.\n"));
			say(BSL("\n"+TPN+" waescht in den Ablagerungen nach "
			"Gold.\n"));
			break;
			
			case 1: write(BSL("\nDu siebst kleine Steinchen und "
			"Sand durch das Sieb, findest aber kein Gold. Das geht "
			"wohl doch nicht so schnell wie Du dachtest.\n"));
			say(BSL("\n"+TPN+" waescht in den Ablagerungen nach "
			"Gold.\n"));
			break;
			
			case 2: write(BSL("\nDu siebst Steinchen und Sand durch "
			"das Sieb, findest aber rein gar nichts interessantes. "
			"Du musst wohl noch laenger sieben bis Du etwas "
			"findest.\n"));
			say(BSL("\n"+TPN+" waescht in den Ablagerungen nach "
			"Gold.\n"));
			break;
			
			case 3: write(BSL("\nDu hockst zwischen den losen "
			"Steinen und siebst und siebst, findest aber nichts. "
			"Du musst noch weiter sieben wenn Du Gold finden "
			"moechtest.\n"));
			say(BSL("\n"+TPN+" waescht in den Ablagerungen nach "
			"Gold.\n"));
			break;
			
			case 4: write(BSL("\nDu siebst und siebst und willst "
			"schon aufgeben als ploetzlich etwas zwischen den "
			"kleinen Steinchen glitzert. Kein Zweifel! GOLD!\n"
			"Schnell steckst Du das Nugget ein.\n"));
			say(BSL("\n"+TPN+" findet GOLD! Vielleicht spendiert "
			""+TPN+" Dir jetzt ein Bier?\n"));
			gold--;
			nugget=CLONEOB("/d/dschungel/trintrasil/fluss/obj/nugget.lpc");
			nugget->move(TP, M_NOCHECK);
			break;
			
			default: write(BSL("\nDu hockst zwischen den losen "
			"Steinen und siebst und siebst, findest aber nichts. "
			" Du musst noch weiter sieben wenn Du Gold finden "
			"moechtest.\n"));
			say(BSL("\n"+TPN+" waescht in den Ablagerungen nach "
			"Gold.\n"));
			return 1;
		}
	return 1;}
	
	if( !sieb ) {
		
		write(BSL("\nDu hast kein Goldsieb, wie willst Du da nach "
		"Gold suchen?"));
	return 1;}
	
	if( sieb && gold<=0 ) {
		
		write(BSL("\nHier sieht es fast so aus als waere schon so "
		"ziemlich alles durchsiebt. Du solltest warten bis der Fluss "
		"wieder etwas anspuelt."));
	return 1;}
	
	return 1;}
return 0;}