//fertig und getestet
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Riesenkaiman");
  SetProp(P_LONG,
    "Der Riesenkaiman ist ca 8 Meter lang und umkreist Dich heimtueckisch. Sein "
    "muskuloeser, gepanzerter Ruecken schimmert braun und gleitet nahezu "
    "lautlos durch das Wasser. Er scheint sich Dir hungrig zu naehern.");
    
  SetProp(P_NAME, "Riesenkaiman");
  SetProp(P_GENDER, MALE);
  AddId(({"kaiman","riesenkaiman","NOWIMPY"}));
  
  AD(("ruecken"),
    "Auf dem muskuloesen Ruecken des Riesenkaiman wachsen dicke, harte "
    "Panzerplatten. Ausserdem hat er einen niedirgen Stachelkranz vom Nacken "
    "bis zur die Schwanzspitze.");
    
  AD(({"kranz","stachelkranz","hornstacheln"}),
    "Riesenkaimane besitzen eine Reihe kleiner Hornstacheln, die vom Nacken bis "
    "zur Schwanzspitze reicht.");
    
  AD(({"schwanz","schwanzspitze","spitze"}),
    "Mit dem Schwanz kann der Riesenkaiman kraeftige Schlaege austeilen.");
    
  AD(("nacken"),
    "Die Nackenmuskel sind sehr ausgepraegt. Immerhin muessen sie den "
    "schweren, breiten Kopf halten koennen.");
    
  AD(("kopf"),
    "Der Kaiman hat ein riesiges zaehnestarrendes Maul, dass so gebaut ist "
    "um furchtbare Wunden zu reissen.");

  AD(("maul"),
    "Der Kaiman haelt das Maul leicht geoeffnet. Du erkennst fingerlange, "
    "spitze Zaehne.");
    
  AD(({"wunden","zaehne"}),
    "Riesenkaimane sind sehr angriffslustig. Sei vorsichtig.");
        
  AD(({"knochenplatten","knochen","panzer","panzerplatten","platten","hornplatten"}),
    "Riesenkaimane sind die einzige hier heimischen Krokodilart, die dicke und "
    "harte Knochplatten am Ruecken hat. Die Kannibalen verwenden diese oft "
    "zum fertigen von Ruestungen wenn es ihnen gelingt eines der riesigen "
    "Tiere zu erlegen.");
    
  AD(({"kannibalen","ruestungen"}),
    "Bei den Kannibalen sind die Knochenplatten von Riesenkaimanen sehr "
    "wertvoll. Besonders Helme werden aus den Knochen gefertigt.");
    
  AD(({"helm","helme"}),
    "Die robusten Kaimanhelme der Kannibalen sind sehr wertvoll.");
    
  AD(({"art","krokodilart"}),
    "Die Riesenkaimane sind eine besonders gefuerchtete und aggressive "
    "Krokodilart. Wenn sie hunger haben, was nahezu immer der Fall ist, greifen "
    "sie alles in ihrer Umgebung an.");
    
  AD(({"fall","umgebung"}),
    "Du solltest zusehen das Du hier wegkommst.");
    
  create_default_npc(50, 4000);//macht weniger schaden und haelt dafuer mehr aus..
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinen furchterregenden Zaehnen", 
                     450 ,({DT_RIP,DT_PIERCE})}));
  SetProp(P_BODY, QueryProp(P_BODY) +30);//laengere kaempfe mit mehr spellerei
  SetProp(P_MAX_HP, 4000);
  SetProp(P_WEIGHT, 200000);
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 8000);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0.2);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " stirbt bruellend.\n");
  SetProp(P_KILL_MSG, "!!RUELPS!! !!SCHMATZ!! !!KAU!!\n");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0]));
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Der Riesenkaiman fixiert Dich mit unbewegtem Blick.\n"}) );
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 20+random(10), 50, 60 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/trintrasil/fluss/room/schilf-h");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp (P_MSGIN, "schwimmt leise herein");
  SetProp (P_MSGOUT, "schwimmt leise");
  SetProp (P_MMSGOUT, "taucht unter");
  SetProp (P_MMSGIN, "kommt bedrohlich knurrend aus dem Schilf");
  
  AddInfo(DEFAULT_INFO, "umkreist Dich argwoehnisch.\n");
 
  SetChats(10, ({
    "\nDer Kaiman knurrt tief und bedrohlich.\n",
    "\nUnglaublich wie elegant und leise sich das gewaltige Tier bewegt.\n",
    "\nDer Kaiman gleitet nahezu lautlos durch das Wasser.\n",
    "\nDer Kaiman kann Dich jeden Moment angreifen.\n",
    "\nDer Kaiman gleitet zielsicher auf Dich zu.\n",
    "\nDie nasse, ledrige Haut des Kaimans schimmert im Sonnenlicht.\n",
    "\nDer Kaiman ist im Wasser perfekt getarnt.\n",
    "\nDer Kaiman schwimmt mit einigen kraeftigen Schwanzschlaegen vorwaerts.\n",
    "\nDer Kaiman oeffnet sein zaehnestarrendes Maul.\n"
    }));

  SetAttackChats(5, ({
  	"\nDas Wasser kocht und brodelt vom wuetenden Kaiman.\n\n",
  	"\nDer Kaiman knurrt blutgierig.\n\n",
  	"\nDein Fisch kann dem Kaiman gerade noch ausweichen.\n\n",
  	"\nDer Kaiman wird Deinen Fisch zerfetzen!\n\n",
  	"\nDer Kaiman wuetet im Blutrausch.\n\n",}));
  	
  SetProp(P_SPELLRATE,35);

  AddSpell(5,550, 
    "\nDer Kaiman schleudert Dich mit Deinem Fisch zur Seite.\n\n",
    "\nDer Kaiman schleuder @WEN mit dem Fisch zu Seite.\n\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(5,650,
    "\nDer Kaiman reisst Dir bruellend die Seite auf.\n\n",
    "\nDer Kaiman reisst bruellen @WESSEN Seite auf.\n\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );
    
  AddSpell(5,1300, 
    "\nDer Kaiman verbeisst sich bruellend in Deinen Arm.\n\n",
    "\nDer Kaiman verbeisst sich bruellend in @WESSEN Arm.\n\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(5, 1,
    "\nDer Riesenkaiman teilt mit seinem Schwanz wuchtige Schlaege aus!\n",
    "\nDer Riesenkaiman teilt mit seinem Schwanz wuchtige Schlaege aus!\n",    
    DT_BLUDGEON, "spell_overkill");
    
  AddSpell(3, 300,  
    "\nDer Riesenkaiman toetet Deinen Fisch mit einem einzigen Biss!\n",
    "\nDer Riesenkaiman toetet @WESSEN Fisch mit einem einzigen Biss!\n",
    DT_BLUDGEON, "spell_fishkill");


  CLONEME("/d/dschungel/trintrasil/fluss/obj/kschaedel.lpc");


}


void spell_fishkill(object enemy) {
	
	tell_object(enemy, BSL("\nDein getoeter Fisch geht sofort unter und "
	"Du faellst in das vom Kampf brodelnde Wasser.\n\n"));
	enemy->move("/d/dschungel/trintrasil/fluss/room/spellfishkill-h",
	M_TPORT+ M_NO_SHOW+ M_SILENT);
	tell_room(environment(TO), BSL("\n"+TPN+" wird vom Fluss fort "
	"gespuelt.\n\n"));
}


void spell_overkill(object enemy, int damage, mixed dam_type) {
	
	int i;
	object *inv;inv=filter_array(all_inventory(environment(TO)),#'living) ;
	
// nur was lebt soll schaden bekommen
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if(interactive(inv[i])) {
			
			switch(random(3)) {
				
				case 1: tell_object(inv[i],
				BSL("\nDer Kaiman trifft Dich mit seinem Schwanz genau am "
				"Kopf und schlaegt Dich vom Fisch.\n\n"));
				inv[i]->Defend(600+random(50), DT_BLUDGEON, 0, this_object());
				inv[i]->move("/d/dschungel/trintrasil/fluss/room/spelloverkill-h",
				M_TPORT+ M_NO_SHOW+ M_SILENT);
				tell_room(environment(TO), BSL("\n"+inv[i]->name()+" wird "
				"vom Kaiman vom Fisch geschlagen.\n\n"));
				break;
				
				case 2: tell_object(inv[i],
				BSL("\nDer Kaiman trifft Dich mit seinem Schwanz am Brustkorb. "
				"Du kannst Dich gerade noch auf Deinem Fisch halten.\n\n"));
				inv[i]->Defend(400+random(50), DT_BLUDGEON, 0, this_object());
				break;
				
				case 0: tell_object(inv[i], 
				BSL("\nDu kannst einem wuchtigen Schwanzschlag des Riesenkaiman "
				"gerade noch ausweichen.\n\n"));
				break;
				
				default: tell_object(inv[i],
				BSL("\nDer Kaiman trifft Dich mit seinem Schwanz genau am "
				"Kopf und  schlaegt Dich vom Fisch.\n\n"));
				inv[i]->Defend(600+random(50), DT_BLUDGEON, 0, this_object());
				tell_room(environment(TO), BSL("\n"+inv[i]->name()+" wird "
				"vom Kaiman vom Fisch geschlagen.\n\n"));
			}
		}
		
		else if (!inv[i]->id("riesenkaiman")) {
			
			inv[i]->Defend(500+random(100), DT_BLUDGEON, 0, this_object());
		}
		
		else {
		}
	}
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	
	leiche=present("leiche", environment(TO));
	
	write_file("/d/dschungel/trintrasil/log/kaimanfile",
	"Der Riesenkaiman hat gerade "+CAP(getuid(player))+" umgebracht.\n");
	heal_self(500+random(50));
	tell_room(environment(TO), BSL("\nDer Riesenkaiman verschlingt knackend und "
	"schmatzend die Leiche von "+CAP(getuid(player))+"!\n\n"));
	
	if(present("leiche", environment(TO))) {
		
		leiche->remove("leiche");
        }
}