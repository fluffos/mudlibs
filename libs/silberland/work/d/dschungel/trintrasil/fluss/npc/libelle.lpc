//fertig und getestet
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine schimmernde Libelle");
  SetProp(P_LONG,
    "Die blauschimmernde Libelle kreist surrend ueber der Wasseroberflaeche.");
  SetProp(P_NAME, " schimmernde Libelle");
  SetProp(P_GENDER, FEMALE);
  AddId(({"libelle"}));

  create_default_npc(5);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit ihren schwirrenden Fluegeln", QueryProp(P_HANDS)[1] ,({DT_BLUDGEON})}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_WEIGHT, 20);
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 15);
  SetProp(P_DIE_MSG, " faellt surrend ins Wasser.\n");
  
  SetProp("insekt", 1); //zur flussbewegung(siehe schlucht.c zeile223)
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Die kann Libelle nichts nehmen und Dein Gegenstand faellt "
     "ins Wasser.\n"}) );
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 5+random(10), 30, 50 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss15.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp (P_MSGIN, "schwirrt herein");
  SetProp (P_MSGOUT, "schwirrt");
  SetProp (P_MMSGIN, "schwirrt herein");
  SetProp (P_MMSGOUT, "schwirrt fort");
  
  AddInfo(DEFAULT_INFO, "sagt: !!SUURRRRRRRRR!!.\n");
 
}
