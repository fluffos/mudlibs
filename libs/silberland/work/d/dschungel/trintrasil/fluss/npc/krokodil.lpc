//fertig und getestet
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Smaragdkrokodil");
  SetProp(P_LONG,
    "Das kleinere Smaragdkrokodil kommt im Rio de la Puseta sehr haeufig vor. "
    "Der wendige Jaeger besitzt eine hellgruene Haut und pirscht sich im Wasser "
    "zielstrebig und schnell an seine Beute an.");

  SetProp(P_NAME, "Smaragdkrokodil");
  SetProp(P_GENDER, NEUTER);
  AddId(({"smaragdkrokodil","krokodil"}));

  AD(("jaeger"),
    "Das Smaragdkrokodil ist ein aeusserst schneller und gefaehrlicher Jaeger. "
    "Es frisst groessere Fische und auch Wild das an den Fluss kommt um zu "
    "trinken.");
    
  AD(({"fische","wild","beute"}),
    "Fuer Menschen wird das Smaragdkrokodil nur gefaehrlich wenn es sonst "
    "wenig Nahrung findet.");
    
  AD(({"menschen","nahrung"}),
    "Das Smaragdkrokodil macht keine Anstalten Dich jetzt anzugreifen.");
    
  AD(({"zeit","anstalten"}),
    "Man kann zwar nie siecher sein, aber das Krokodil wirkt zu Zeit "
    "ungefsehrlich.");
      
  AD(("haut"),
    "Die Haut des Smaragdkrokodils ist auffaellig hellgruen und glatt. Damit "
    "tarnt es sich bevorzugt an seichten unuebersichtlichen Stellen im "
    "Wasser.");
    
  AD(({"stelle","stellen"}),
    "An diesen Stellen lauert es dann regungslos auf Wild das an den Fluss "
    "kommt um zu trinken.");
    
  create_default_npc(29);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_RACE, "Echse");
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", QueryProp(P_HANDS)[1], ({DT_RIP})}));
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 15000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 30);
  SetProp(P_DIE_MSG, " stirbt unter Kraempfen.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Das Smaragdkrokodil verharrt regungslos.\n"}) );
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 5+random(10), 40, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss20.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp (P_MSGIN, "schwimmt leise herein");
  SetProp (P_MSGOUT, "schwimmt leise");
  SetProp (P_MMSGIN, "schwimmt leise herein");
  SetProp (P_MMSGIN, "taucht blitzschnell unter");
  
  AddInfo(DEFAULT_INFO, "umkreist Dich argwoehnisch.\n");
 
  SetChats(3, ({
    "\nDas Smaragdkrokodil umkreist Dich still.\n", 
    "\nDas Smaragdkrokodil beobachtet Dich unauffaellig.\n", 
    "\nNur der Ruecken des Krokodils ist noch sichtbar.\n",
    "\nDas Krokodil gleitet anmutig durch das Wasser.\n",
    "\nDas Krokodil oeffnet leicht seinen Rachen.\n",
    "Das Krokodil schaukelt traege auf dem Wasser.\n",
    }));
}
