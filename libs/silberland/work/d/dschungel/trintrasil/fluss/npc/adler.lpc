//fertig und getestet
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Fischadlerweibchen");
  SetProp(P_LONG, BS(
    "Das Fischadlerweibchen schnarrt Dich nervoes an. Anscheinend befinden "
    "sich im Nest hinter ihr Junge. Du solltest dem praechtigen "
    "Fischadlerweibchen nicht zu nahe kommen."));

  SetProp(P_NAME, "Fischadlerweibchen");
  SetProp(P_GENDER, NEUTER);

  AddId(({"fischadler","adler","weibchen","fischadlerweibchen","NOWIMPY"}));

  create_default_npc(18);
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinem scharfen Schnabel", QueryProp(P_HANDS)[1] ,({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 60);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL, random(3));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_WEIGHT, 10000);
  
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "schiesst vom Himmel herab");
  SetProp(P_MMSGOUT, "flattert schnell hoch in den Himmel");
  
  SetProp(P_DIE_MSG,  " kreischt zornig auf und fliegt davon.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "kreischt: KRAAAAAAAAARRKKK!!!!.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Glaubst Du der Fischadler kann irgendetwas damit anfangen ?\n" }) );

  SetProp(P_SPELLRATE,20);
  
  AddSpell(40,150,
    "Der Fischadler hackt auf Dich ein.\n",
    "Der Fischadler hackt auf @WEN ein.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(13,600,
    "Der Fischadler peckt Dir beinahe das Auge aus.\n",
    "Der Fischadler peckt @WEM beinahe das Auge aus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(47,130,
     "Der Fischadler kratzt nach Deinem Gesicht.\n",
     "Der Fischadler kratzt nach @WESSEN Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AD(({"federn","gefieder"}),
    "Der suedliche Fischadler hat ein schwarzblau schimmerndes Gefieder. "
    "Nur am Kopf hat der Adler lange weisse Federn."); 
  
  AD(({"fluegel","schwingen","fluegelspannweite","spannweite"}),
    "Die Schwingen des Adlers sind beeindruckend. Auch wenn der Vogel nur da "
    "60 cm gross ist, hat er doch gut 1,5 meter Fluegelspannweite.");
    
  SetChats(6, ({
  "Das Adler plustert sein glaenzendes Gefieder.\n",
  "Das seidige Gefieder des Adlers schimmert schwarz blaeulich.\n",
  "Das Fischadlerweibchen schlaegt bedrohlich mit den Schwingen.\n",
  "Das Adlerweibchen wuerde sein Nest sicher verbissen verteidigen.\n",
  "Der Adler wippt nervoes mit dem Kopf.\n",
  "Der Adler peckt nach Dir.\n",
  "Kraaaaaarkarkk!!!\n",
  "Der Fischadler fuehlt sein Nest bedroht.\n",
  "Du solltest den Fischadler nicht noch mehr reizen.\n",
  "Du kannst dem wuetenden Adler gerade noch ausweichen.\n"}));
}