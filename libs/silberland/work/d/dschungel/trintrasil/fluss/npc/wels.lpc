//fertig und getestet
inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Stachelwels");
  SetProp(P_LONG, BS(
    "Der Stachelwels ist beinahe 2 meter lang und hat ein breites "
    "zaehnestarrendes Maul. Der Wels hat von der Rueckenflosse bis zur "
    "Schwanzflosse einen gefaehrlich aussehenden Stachelstrahl. Mit leicht "
    "geoeffneten Maul sucht der schuppenlose, graue Raubfisch nach Beute."));
  SetProp(P_NAME, "Stachelwels");
  SetProp(P_GENDER, MALE);

  AddId(({"wels","stachelwels","fisch"}));

  create_default_npc(32);

  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinen Zaehnen", QueryProp(P_HANDS)[1], ({DT_RIP})}));
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 15+random(8), 30, 25 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss7.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwebt vom Himmel herab");
  SetProp(P_MMSGOUT, "verschwindet in einem Schwarzen Loch");

  SetProp(P_DIE_MSG,  " geht sterbend unter.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "interessiert sich nur fuer Beute.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Stachelwels interessiert sich nur fuer Beute\n" }) );

AD(("maul"),
  "Das Maul des Welses ist so breit wie sein flacher breiter Kopf und wie bei "
  "Raubfischen ueblich dicht mit kleinen, scharfen Zaehnen besetzt.");
  
AD(("kopf"),
  "Der Kopf ist flach, wodurch der Wels stromlinienfoermiger ist. Links und "
  "rechts vom Maul hat der Wels zwei Bartel.");
  
AD(("bartel"),
  "Die Bartel verwendet der Wels zum Tasten wenn er ueber den Flussgrund "
  "gleitet.");
  
AD(("tasten"),
  "Der Wels sieht nicht gut.");
  
AD(({"grund","flussgrund"}),
  "Dort sucht der Wels nach Beute.");

AD(("fische"),
  "Der Stachelwels frisst ausschliesslich kleine Fische.");
    
AD(("rueckenflosse"),
  "Von der Rueckenflosse bis zur Schwanzflosse laeuft ein langer "
  "Stachelstrahl.");
  
AD(({"flosse","flossen"}),
  "Der Wels besitzt mehrere Flossen, am auffaelligsten sind die Rueckenflosse "
  "und die Schwanzflosse.");
  
AD(("schwanzflosse"),
  "Die Schwanzflosse sieht sehr kreaftig aus. Mit ihr kann der Wels erstaunlich "
  "schnell schwimmen.");
  
AD(({"stachelstrahl","strahl","stacheln","stachel"}),
  "Von der Ruecken- bis zur Schwanzflosse verlaeuft eine dichte Reihe "
  "Stacheln.");

AD(("reihe"),
  "Die Stacheln sehen ziemlich gefaehrlich aus. Vielleicht sind sie ja auch "
  "giftig.");
  
AD(("beute"),
  "Obwohl Fischer viele Geschichten ueber riesige blutruenstige Stachelwelse "
  "erzaehlen ernaehrt sich der Wels hauptsaechlich von kleinen Fischen.");
  
AD(({"fischer","geschichten","geschichte"}),
  "Angeblich haben riesige Stachelwelse auch schon Menschen angegriffen.");
  
AD(({"menschen","elfen","zwerge","hobbits"}),
  "Oder auch Elfen Zwerge und Hobbits. Nur Trolle greifen Stachelwelse sicher "
  "nicht an.");
  
AD(("trolle"),
  "Die sind doch etwas zu gross.");

AD(("raubfisch"),
  "Der Stachelwels ist ein imposanter Raubfisch der sich hauptsaechlich von "
  "kleineren Fischen ernaehrt.");
}