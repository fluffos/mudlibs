//fertig
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Piranha");
  SetProp(P_LONG, BS(
    "Der Piranha schwimmt unruhig um Dich herum. Das Maul mit den kleinen "
    "scharfen Zaehnen oeffnet und schliesst sich rastlos. Er hat das Blut "
    "von "+CAP(getuid(TP))+" gewittert."));
  SetProp(P_NAME, "Piranha");
  SetProp(P_GENDER,MALE);
  AddId(({"piranha"}));

  AD(("maul"),
    "Der Piranha ist ein recht kleiner Raubfisch mit einem Maul voller scharfer "
    "Zaehne. Einer allein ist sicher nicht gefaehrlich, aber Piranhas greifen "
    "meistens im Schwarm an.");
    
  AD(("zaehne"),
    "Die Zaehne sind zwar klein, aber sehr scharf.");
   
  AD(("schwarm"),
    "Viele Piranhas koennen ihre Beute in kurzer Zeit toeten.");
    
  AD(({"minute","zeit"}),
    "Oft toeten sie ihre Beute in weniger als einer Minute.");
    
  AD(({"piranhas","beute"}),
    "Piranhas greifen alles an was fuer sie fressbar ist.");
    
  create_default_npc(8);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", QueryProp(P_HANDS)[1],({DT_PIERCE})}));
  SetProp(P_SIZE, 25);
  SetProp(P_WEIGHT, 800);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL, random(2));//weil karpfen
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RACE, "Fisch");

  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "detoniert");

  SetProp(P_DIE_MSG,  " geht verwundet unter.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "ist nicht zum Sprechen aufgelegt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Piranha beisst Dir in die Hand.\n" }) );
}