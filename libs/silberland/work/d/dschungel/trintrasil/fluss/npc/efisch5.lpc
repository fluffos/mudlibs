//fertig und getestet
inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


int brennwert;
int flightint=0;


reset() {//fisch verschwindet nach einiger zeit wieder
	
	::reset();
	
	if(ENV(TO)) {
		tell_room(ENV(TO),BS("Die Smaragdzaehre taucht unter."));
	}
	TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
	M_SILENT);
	TO->remove();
}


void create() {

brennwert=30+random(15);
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Smaragdzaehre");
  SetProp(P_LONG, BS(
  "Die Smaragdzaehre ist nur etwa handgross. Dem smaragdgruen leuchtendem "
  "Fisch werden magische Kraefte nachgesagt. Die Smaragdzaehre raekelt sich "
  "anmutig knapp unter der Wasseroberflaeche. Mit einem Fischspeer muesstest "
  "Du sie leicht erreichen koennen."));
  
  AD(({"kraefte"}),
  "Angeblich hat die Smaragdzaehre heilende, magische Kraefte.");
  
  AD(({"oberflaeche","wasseroberflaeche"}),
  "Die Smaragdzaehre leuchtet magisch im dunklen Flusswasser.");
  
  AD(({"speer","fischspeer"}),
  "Mit so einem leichten duennen Speer koenntest Du die Smaragdzaehre jagen.");
  
  SetProp(P_NAME, "Smaragdzaehre");
  SetProp(P_GENDER, FEMALE);

  AddId(({"zaehre","smaragdzaehre","fisch","EFISCH"}));

  create_default_npc(5);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 6+random(4));
  SetProp(P_WEIGHT, 15+random(5));
  SetProp(P_ALIGN, 0);
  SetProp(P_NOATTACK, "weicht blitzschnell aus. Du kannst Sie nur mit \n"
  "einem Fischspeer jagen.\n");
  SetProp(P_INFO, BS("Du koenntest die Smaragdzaehre mit einem Fischspeer "
  "jagen."));
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 15+random(8), 30, 25 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss3.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "taucht unter");

  SetProp(P_DIE_MSG,  " stirbt zuckend.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "schwimmt ungestoert weiter.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Smaragdzaehre schwimmt uninteressiert herum.\n" }) );

AddCmd(("fischkont"), "sag_int");
}

clone_food(jaeger) {
	
	int weight;
	object fishfood5;
	
	if( ENV(TO)!=ENV(TP) ) {
		
		TO->remove();
		return 1;
	}
	
	if( ENV(TO)==ENV(TP) ) {
		
		weight=this_object()->QueryProp(P_WEIGHT);
	        
	        fishfood5=CLONEOB("/d/dschungel/trintrasil/fluss/obj/fishfood5.lpc");
	        
	        fishfood5->
	        SetProp(P_FOOD_INFO, ([F_HEAL : ({brennwert,brennwert}), 
	        F_SOAK : 1,
	        F_MSG:"Du iss die leicht saeuerliche Smaragdzaehre in einem "
	        "Stueck.\n",
	        F_MSG_ROOM:"isst eine rohe Smaragdzaehre.\n"]));
	        fishfood5->SetProp(P_WEIGHT, weight);
	        fishfood5->move(jaeger, M_NOCHECK);
	        TO->remove();
	        return 1;
	}
}


int flightcount() {
	flightint++;
}

int flight() {
	return flightint;
}


sag_int() {
	
	tell_room(ENV(TO), BSL("Brennwert:  "+brennwert+"\n"
	                       "Groesse:    "+TO->QueryProp(P_SIZE)+"\n"
	                       "Gewicht:    "+TO->QueryProp(P_WEIGHT)+"\n"));
	return 1;         
}