//fertig und getestet

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

object cloner;
//so wird global definiert welcher spieler von der schlange angegriffen wurde, 
//was im string plname verwendet wird, der in der long und in den details 
//verwendet wird siehe zeile 39
string plname;
  

void create() {

cloner = this_player();
plname = cloner->name();
   
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, BS("Eine  Wasserschlange die Deinen Fisch umschlungen hat"));
  SetProp(P_INT_LONG, BS(
    "Die gelbe Wasserschlange hat Deinen Fisch umschlungen und versucht ihn "
    "zu erwuergen. Dein Fisch zappelt in Panik, Du kannst Dich kaum noch auf "
    "seinem Ruecken halten. Du musst die Schlange vertreiben "
    "oder toeten!"));
  SetProp(P_NAME, "Wasserschlange");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schlange","wasserschlange","EVENTSCHLANGE","NOWIMPY"}));

  create_default_npc(15);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 160);
  SetProp(P_ALIGN, 50);
  SetProp(P_HANDS, ({" mit ihren Zaehnen", QueryProp(P_HANDS)[1],({DT_PIERCE, DT_POISON})}));
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " taucht blutend unter.\n");
  SetProp(P_NOCORPSE, 1),
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Das wird die Schlange sicher nicht vertreiben."}) );
  
  SetProp (P_MMSGIN, "umschlingt Deinen Fisch");
  SetProp (P_MMSGOUT, "schwimmt");
  SetProp (P_MSGIN, "schwimmt herein");
  SetProp (P_MSGOUT, "schwimmt");
  

  AD(({"griff","wuergegriff","chance"}),
    "Die Wasserschlange wird den Fisch erwuergen, wenn sie nicht getoetet "
    "wird.");

  ASD(({"flosse","rueckenflosse"}),
    "flosse");
              
  ASD(("fisch"),
    "fisch"); 
    
  ASD(("ruecken"),
    "ruecken");
    
  ASD(("panik"),
    "panik");

  ASD(({"spruenge","sprung"}),
    "sprung");
    
      
  AddCmd(("vertreibe"), "vfunc");

    
  AddInfo(DEFAULT_INFO, BS("ist viel zu sehr damit beschaeftigt den Fisch zu erwuergen.\n"));
}



_query_short() {
	
	if( TO->QueryProp(this_player()->name()) ) {
		return ("Eine  Wasserschlange die Deinen Fisch umschlungen hat");
	}
	
	if( !TO->QueryProp(this_player()->name()) ) {
		return ("Eine  Wasserschlange die "+plname+"s Fisch "
		"umschlungen hat");
	}
}


_query_long() {
	
if( TO->QueryProp(this_player()->name()) ) {

    write(BS(
    "Die gelbe Wasserschlange hat Deinen Fisch umschlungen und versucht ihn "
    "zu erwuergen. Dein Fisch zappelt in Panik, Du kannst Dich kaum noch auf "
    "seinem Ruecken halten. Du musst die Schlange vertreiben "
    "oder toeten!"));
  }

if( !TO->QueryProp(this_player()->name()) ) {
	
	write(BS(
	"Die gelbe Wasserschlange hat den Fisch von "+plname+" umschlungen und "
	"versucht ihn zu erwuergen. Der Fisch kaempft zwar verzweifelt, "
	"Du solltest aber "+plname+"s Fisch unbedingt helfen."));
  }
}


vfunc() {
	WSCHLANGENABFRAGE(
	write(BS("Die Schlange laesst nicht locker! Du musst sie wohl "
	"angreifen!"));,
	write(BS("Die Schlange laesst sich nicht vertreiben. Wenn Du "+plname+" "
        "helfen willst musst Du sie angreifen!"));)   	
return 0;}
   
        
fisch() {
	WSCHLANGENABFRAGE(
	return BS("Dein Fisch windet sich und versucht in wilden Spruengen die "
        "Schlange zu beissen!");,
        return BS("Der Fisch von "+plname+" versucht in wilden Spruengen die "
        "Schlange zu beissen.");)
}


flosse() {
	WSCHLANGENABFRAGE(
	return BS("Der Fisch windet sich verzweifelt im Wuergegriff der "
	"Wasserschlange. Du wirst heruntergeschleudert werden wenn Du die "
	"Schlange nicht bald toetest!");,
	return BS("Der Fisch windet sich verzweifelt im Wuergegriff der "
	"Schlange. "+plname+" wird heruntergeschleudert werden wenn die "
	"Schlange nicht bald getoetet wird!");)
}


ruecken() {
	WSCHLANGENABFRAGE(
	return BS("Du klammerst Dich wasserspuckend an die Rueckenflosse, aber "
        "wenn Du die Schlange nicht bald los wirst faellst Du in den Fluss.");,
        return BS(""+plname+" kann sich kaum noch auf dem bockenden Fisch "
        "halten. Du koenntest ja helfen die Schlange zu toeten.");)
}
        

panik() {
	WSCHLANGENABFRAGE(
	return BS("Dein Fisch versucht in Panik die gelbe Schlange zu "
	"beissen!");,
	return BS("Der Fisch von "+plname+" versucht in Panik die gelbe "
        "Wasserschlange zu beissen!");)  
}


sprung() {
	WSCHLANGENABFRAGE(
	return BSL("\n!!!!!PPPLLLAAATTTTTSSSSSCCCCCHHHHH!!!!\n\n"
        "Die Schlange laesst Deinem Fisch keine Chance. Du musst sie toeten!");,
        return BSL("\n!!!!!PPPLLLAAATTTTTSSSSSCCCCCHHHHH!!!!!\n\n"
        "Die Schlange laesst dem Fisch von "+plname+" keine Chance. Du "
        "koenntest helfen sie zu toeten.");)
}
