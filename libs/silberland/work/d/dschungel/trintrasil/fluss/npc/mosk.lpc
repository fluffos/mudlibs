inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>


int ei=3;//soll nicht resetet werden da es sonst kaum zur eiablage kommen kann

init() {
       ::init();
  
  if( (interactive(TP)) && (ei>=1) ) { 
  	
  	call_out("blut", 1+random(2)); 
  	}
  	
  if( (interactive(TP)) && (ei<=0) ) {
  	
  	call_out("eiablage", 1+random(2)); }
  	}
  
blut() {
	
 if( environment(TO) != environment(TP) ) {
 	return 1;}
 	
 else {

 write(BSL("\nDas Moskito hat entschieden das Dein Blut genau das Richtige ist! "
          "Es beginnt Dich heimtueckisch zu umkreisen und sucht eine gute "
          "Einstichstelle!\n"));
 call_out("blut1", 1+random(3));
     }
}


blut1() {
	
 if( environment(TO) != environment(TP) ) {
 	return 1;}
 	
 else {
 
        tell_object(TP, BSL("\n!!!AAUUU!!! Das Moskito hat Dich genau zwischen "
        "die Schulterblaetter gestochen, wo Du es mit der Hand nicht erreichen "
        "konntest. Fett von Blut beginnt es Dich wieder zu umkreisen.\n\n")); 	
        say(BSL("\n"+TPN+" wird vom Moskito gestochen und "
        "kreischt hysterisch auf.\n\n"), TP); 
        TP->do_damage(1+random(2));
        ei--;
        }
}



eiablage() {

 if( environment(TO) != environment(TP) ) {
 	return 1;}
 	
 else {
 
 object gelege;
 
 write(BSL("\n!!AUU!!  Das Moskito haelt Dich fuer ein ideales Wirtstier fuer "
          "seinen Nachwuchs und hat seine Eier unter Deine Haut gelegt!!!\n"));
 gelege=CLONEOB("/d/dschungel/trintrasil/fluss/obj/gelege.lpc");
 gelege->move(TP, M_NOCHECK); 
 ei=3;  
   }
}



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Moskito");
  SetProp(P_LONG,
          "Du kommst dem Quaelgeist gerade recht. Es ist naemlich dringend auf "
          "der Suche nach Blut um seine Eier fertig ausbilden zu koennen.");
          
  SetProp(P_NAME, "Moskito");
  SetProp(P_GENDER, NEUTER);
  AddId(({"moskito","drecksvieh"}));

  create_default_npc(5);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit nervtoetendem Sirren", QueryProp(P_HANDS)[1],({DT_BLUDGEON})}));
  SetProp(P_BODY, QueryProp(P_BODY) - 10);//wird nie gebraucht werden weil 
  SetProp(P_RACE, "Insekt");              //noattack npc
  SetProp(P_SIZE, 5);
  SetProp(P_WEIGHT, 5);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "weicht vollkommen unbeeindruckt aus.\n");
  SetProp(P_WIMPY, 15);
  SetProp(P_DIE_MSG, " faellt surrend ins Wasser.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
     BSL("Was soll denn das Moskito damit?\n  !!Platsch!!\nDein Gegenstand "
     "faellt ins Wasser.")}) );
  
  SetProp("insekt", 1); //zur flussbewegung(siehe schlucht.c zeile223)
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 10+random(15), 10+random(15), 10+random(15) }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/dickicht.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp (P_MSGIN, "schwirrt herein");
  SetProp (P_MSGOUT, "schwirrt");
  SetProp (P_MMSGIN, "schwirrt herein");
  SetProp (P_MMSGOUT, "schwirrt fort");


AD(({"tier","wirtstier"}),
  "Warum umkreist Dich das Moskito staendig?");

AD(({"quaelgeist"}),
  "Die einzige Moeglichkeit diese laestigen Viecher los zu werden ist sie "
  "zu erschlagen.");
  
AD(("moeglichkeit"),
  "zerklatsche moskito");
    
AD(({"haut","fleisch"}),
  "Das Moskito legt seine Eier unter die Haut eines Wirtstieres, wo es sich "
  "die Maden dann von dessen Fleisch ernaehren.");
  
AD(("maden"),
  "Bist Du gut genaehrt und nicht zu zaeh?"); 
  
ASD(("blut"),
  "blutwurst");
  
ASD(({"ei","eier"}),
  "eier");
  
ASD(("suche"),
  "suche");
  

AddCmd(({"klatsche","zerklatsche","erschlage","zerdruecke"}), "fleck");

  
  AddInfo(DEFAULT_INFO, "sagt: !!SSSSSSSSSSSSSSSSSSSSSSSSS!!.\n");
 
}

int fleck(string str) {
	
 object moskito;
 moskito=TO;
 
  notify_fail("Was willst Du erschlagen?\n");
  
  if(str=="moskito"||str=="stechmuecke"||str=="quaelgeist"||str=="blutsauger") {
  	
   switch(random(10)) {
   	
     case 0 : Z1
              write(BS("!!ZACK!! Das war ein Plattschuss! Das "
                       "Moskito wird sicher niemanden mehr aergern."));
              S1
              say(BS("!!BRAVO!! "+TPN+" hat das Moskito genau zwischen den "
                     "Augen getroffen! Es wird sicher niemanden mehr "
                     "aergern."), TP);
              moskito->remove("moskito");
              break;
              
     case 1 : Z1
              write(BS("Das Moskito weicht im letzen Moment aus!"));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);
              break;
              
     case 2 : Z1
              write(BS("Das Moskito schlaegt gerade noch einen Hacken!"));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;
              
     case 3 : Z1
              write(BS("Das Moskito taucht summend unter Deinem Arm durch!"));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;

     case 4 : Z1
              write(BS("Knapp daneben ist auch vorbei!"));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;
              
     case 5 : Z1
              write(BS("Das Moskito fliegt schnell hinter Dein Ohr."));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;
              
     case 6 : Z1
              write(BS("Das Moskito wirbelt summend um Deinen Kopf."));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;
              
     case 7 : Z1
              write(BS("Das Moskito versteckt sich schnell hinter Deinem "
                       "Ruecken."));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;
              
     case 8 : Z1
              write(BS("Das Moskito scheint Dich zu verhoehnen!"));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;
     
     case 9 : Z1
              write(BS("HAHAHA! Du bist vielleicht ungeschickt!"));
              S1
              say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          
              break;

     default : Z1
               write(BS("HAHAHA! Du bist vielleicht ungeschickt!"));
               S1
               say(BS(""+TPN+" versucht das Moskito zu erschlagen!"), TP);          

             return 1;}
           return 1;}
         return 0;}
         
         
                       
blutwurst() {
	
if(ei<=0) {
  return BS("Das Moskito braucht kein Blut mehr da es seine Eier schon fertig "
            "ausgebildet hat. Es wird sie sicher gleich legen.");
            }
            
if(ei==3) {
  return BS("Das Moskito hat noch nicht gestochen und braucht daher dringend "
            "Blut damit es neue Eier bilden kann.");
            }

if(ei==2) {
  return BS("Das Moskito hat erst einmal gestochen und braucht noch dringend "
            "Blut damit es neue Eier bilden kann.");
            }
                        
if(ei==1) {
  return BS("Das Moskito muss noch einmal stechen um seine Eier fertig "
            "auszubilden.");
            }
}


eier() {
	
 if(ei<=0) {
   return BS("Ja die Eier sind schon fertig! Das Moskito sucht nur noch das "
             "passende Wirtstier in das es sie ablegen kann.");
             }
             
  if(ei==3) {
    return BS("Das Moskito hat noch nicht gestochen. Es wird Dir etwas Blut "
              "abnehmen muessen bis neue Eier in Dein Fleisch legen kann.");
              }
          
  if(ei==2) {
    return BS("Das Moskito hat erst einmal gestochen. Es muss Dir noch ein "
              "paar mal Blut abnehmen bis es seine Eier in Dein Fleisch "
              "legt.");
              }
                          
  if(ei==1) {
    return BS("Sei so nett und lass das Moskito noch einmal stechen. Dann "
              "kann es endlich seine Eier in Dein Fleisch legen.");
              }
}              
    
              
suche() {
	
if(ei<=0) {
  return BS("Das Moskito sucht noch ein nettes, kinderfreundliches Wirtstier "
            "um seine Eier darin zu legen.");
            }
            
if(ei>=1) {
  return BS("Das Moskito braucht Blut. Du hast genug davon.");
           }
  }
  
  
  