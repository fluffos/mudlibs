//fertig und getestet
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


int PreventFollow(object dest) {
		
	if( dest->QueryProp("begrenzungsraum_fpursuer")==1 ) {
		
		tell_room(ENV(TO), BS("Die Klippenmoewe flattert zornig kreischend davon."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", M_TPORT+ 
		M_SILENT);
		return 2;
	}
	
	if( file_name(dest)=="/room/death/death_room")  {
		
		tell_room(ENV(TO), BS("Die Klippenmoewe flattert zornig kreischend davon."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", M_TPORT+ 
		M_SILENT);
		return 2;  
	}
	
	if(dest->QueryProp(P_INDOORS)) {
		tell_room(ENV(TO), BS("Die Klippenmoewe flattert zornig kreischend davon."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", M_TPORT+ 
		M_SILENT);
		return 2;
	}
	
	else {
		return 0;
	}
}



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Klippenmoewe");
  SetProp(P_LONG,
    "Die Klippenmoewe flattert zornig umher. Anscheinend hat sie irgend etwas "
    "sehr aufgeregt. Sie schlaegt hektisch mit ihren Fluegeln und stoesst "
    "spitze, hohe Schreie aus.");
  SetProp(P_NAME, "Klippenmoewe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"moewe","klippenmoewe"}));

  create_default_npc(12);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 0);
  SetProp(P_HANDS, ({" mit ihrem scharfen Schnabel", QueryProp(P_HANDS)[1], ({DT_PIERCE})}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_DIE_MSG, " flattert verwundet davon.\n");
  SetProp(P_NOCORPSE, 1),
  SetProp("vogel", 1);
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Die Klippenmoewe interessiert sich nicht fuer Deinen Krempl.\n"}) );
  
  SetProp (P_MMSGIN, "schwebt vom Himmel");
  SetProp (P_MMSGOUT, "fliegt davon");
  SetProp (P_MSGIN, "fliegt herein");
  SetProp (P_MSGOUT, "fliegt hinter "+previous_object()->name()+" her");
    
  AddInfo(DEFAULT_INFO, "stoesst einen greinenden Schrei aus.\n");

SetProp("vogel", 1);
}
