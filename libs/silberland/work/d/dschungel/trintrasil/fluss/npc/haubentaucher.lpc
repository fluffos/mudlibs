inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein bunter "+ANSI_RED+"H"+ANSI_GREEN+"a"ANSI_YELLOW+"u"
                   ""+ANSI_BLUE+"b"+ANSI_CYAN+"e"+ANSI_YELLOW+"n"+ANSI_PURPLE+""
                   "t"+ANSI_RED+"a"+ANSI_BLUE+"u"+ANSI_GREEN+"ch"+ANSI_YELLOW+""
                   "e"+ANSI_CYAN+"r"+ANSI_NORMAL+"");
  SetProp(P_LONG,
    "Anders Als die meisten Taucherarten hat dieser ein sehr bunt "
    "schillerndes Gefieder. Der Haubentaucher schnattert aufgeregt und schwimmt "
    "schnell etwas von Dir weg.");

  ASD(({"farbe","farben"}),
    "farbe");
    
  AD(({"taucherarten","taucherart","arten","art"}),
  "Dies ist ein patagonischer Bunthaubentaucher.");
  
  AD(("gefieder"),
  "Besonders die gekruemmten Schwanzfedern schillern in allen Farben. "
  "Typisch fuer Haubentaucher besitzt er einen schwarzen Schopf und einen "
  "roten Backenbart. Was fuer ein prachtvoller Vogel!");
  
  AD(("schopf"),
  "Der Haubentaucher wackelt aufgeregt mit dem Schopf.");
  
  AD(({"federn","schwanzfedern"}),
  "Die Schwanzfedern sind gekruemmt und leuchten bunt.");
  
  AD(({"bart","backenbart"}),
  "Alle Taucherarten haben einen faerbigen Backenbart.");
  
  AD(("vogel"),
  "Der Haubentaucher ist einer des schoensten Wasservogelarten des 'Rio de la "
  "Puseta'.");
  
  AD(({"vogelarten","wasservogelarten","arten","vogelart","wasservogelart",
  "art"}),
  "Wasservoegel gibt es hier natuerlich besonders viele.");
  
  
  SetProp(P_NAME, "Haubentaucher");
  SetProp(P_NAME_ADJ, "bunt"); 
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Vogel");
  AddId(({"taucher","haubentaucher","bunthaubentaucher",
          "patagonischer haubentaucher","patagonischer bunthaubentaucher"}));

  create_default_npc(8);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinem wippenden Schopf", QueryProp(P_HANDS)[1] ,({DT_WHIP})}));
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, random(2));
  SetProp(P_HEAL,1);
  SetProp(P_WEIGHT, 3000); 
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 20);
  SetProp(P_DIE_MSG, " taucht blutend unter.\n");
  
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Den Haubentaucher interessieren nur Fische.\n"}) );
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 10+random(8), 20, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/bresche.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp (P_MSGIN, "schwimmt herein");
  SetProp (P_MSGOUT, "schwimmt");
  SetProp (P_MMSGIN, "taucht auf");
  SetProp (P_MMSGOUT, "taucht unter");
  
  AddInfo(DEFAULT_INFO, "!!QUUAAACCCKKKKK!!.\n");
 
}


_query_short() {
	
	if(TP->QueryProp(P_TTY)=="ansi") {
		return "Ein bunter "+ANSI_RED+"H"+ANSI_GREEN+"a"ANSI_YELLOW+"u"
                ""+ANSI_BLUE+"b"+ANSI_CYAN+"e"+ANSI_YELLOW+"n"+ANSI_PURPLE+""
                "t"+ANSI_RED+"a"+ANSI_BLUE+"u"+ANSI_GREEN+"ch"+ANSI_YELLOW+""
                "e"+ANSI_CYAN+"r"+ANSI_NORMAL+"";
	}
	
	if(TP->QueryProp(P_TTY)!="ansi") {
		return BS("Ein bunter Haubentaucher dessen praechtige Farben Du "
		"nicht siehst");
	}
}


farbe() {
	
	if(TP->QueryProp(P_TTY)=="ansi") {
		return BS("Herrlich in wievielen hellen Farben das Gefieder "
		"leuchtet.");
	}
	
	if(TP->QueryProp(P_TTY)!="ansi") {
		return BS("Da Du keine Farben eingestellt hast kannst Du das "
		"praechtige Gefieder leider nicht bunt sehen.");
	}
}