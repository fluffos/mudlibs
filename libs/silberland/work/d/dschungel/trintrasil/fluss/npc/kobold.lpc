inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <npc.h>


void create()
{
 
  ::create();

  SetProp(P_SHORT, "Ein boesartiger Kobold");
  SetProp(P_LONG,
    "Der laestige Kobold sieht aus wie die Karrikatur eines haesslichen "
    "aufgeblaehten Kindes und beschimpft Dich das selbst eine Hafenhure "
    "in Tijara bleich werden wuerde.");
  
  SetProp(P_NAME, "boesartiger Kobold");
  SetProp(P_GENDER, MALE);
  AddId(({"kobold","gnom"}));

  create_default_npc(12);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinen dreckigen Pfoten", QueryProp(P_HANDS)[1] ,({DT_BLUDGEON})}));
  SetProp(P_HEAL, -50);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 50);
  SetProp(P_DIE_MSG, " spuckt Dir auf den Fuss und stirbt.\n");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
     BS("Der Kobold nimmt Deinen Gegenstand, verschluckt ihn und ruelpst Dir "
     "grinsend ins Gesicht.")}) );
  
  SetProp (P_MSGIN,  "springt herein");
  SetProp (P_MSGOUT, "springt");
  SetProp (P_MMSGIN, "springt herein");
  SetProp (P_MMSGOUT,"springt");
  
  AD(("lappen"),
    "Die ledrigen Ohren sind fast so gross wie der restliche Kobold.");
    
  AD(({"geruch","gestank","fischgeruch","fischtangeruch","fischgestank"}),
    "Der kleine Quaelgeist stinkt fuerchterlich.");
    
  AD(("ohren"),
    "Mit diesen unfoermigen riesigen Lappen faechelt sich der Kobold frische "
    "Luft zu.");
    
  AD(("luft"),
    "Die kann der Kobold bei seinem Gestank auch brauchen.");
    
  AD(("koerper"),
    "Der kleine Koerper sieht aus wie der eines aufgeblaehten kleinen Kindes.");
   
  AD(("kopf"),
    "Der haessliche Kopf ist fuer den restlichen Koerper viel zu gross.");
    
  AD(("zunge"),
    "Dich wundert das diese Zunge in dem kleinen Kobold ueberhaupt Platz hat.");
    
  AD(("augen"),
    "Du fuerchtest schon das sie ihm aus dem Kopf springen koennten.");
    
  AD(("kind"),
    "Erinnert Dich irgendwie an klein "+TPN+".");
   
  AD(("karrikatur"),
    "Als waere der Kobold irr rollt er mit den Augen und streckt Dir die Zunge "
    "heraus.");
    
  AD(({"hafenhure","hure"}),
    "Der Kobold wuerde SICHER keine gute Hafenhure abgeben.");
    
  AD(("tijara"),
    "Besuchen und schweigen.");
  
  AddInfo(({"faust","rote faust"}),
  "Ooch die, sind so nette Typen. Sind hier in der Gegend und tun so auf Revolution. "
  "Unausgelastete Jugend eben so wie Du.","sagt: ");
  
  AddInfo(("revolution"),
  "Die Rote Faust will den Gouverneur umbringen und eine Republik einfuehren. Dabei sind "
  "sie alles andere als zimperlich.","sagt: ");
  
  AddInfo(({"zack","zack de la rocha","rocha"}),
  "Der ist ihr Chef oder so. Kommandiert die Typen eben herum.","sagt: ");
  
  AddInfo(("gegend"),
  "Naja so da in den Hoehlen und im Dschungel mach die rum.","sagt: ");
  
  AddInfo(({"hoehle","hoehlen"}),
  "Mein Woody, kennst Dich ueberhaupt nicht aus? Weisst Du ueberhaupt wie Du "
  "heisst, Hohlbirne? Frag die Flussfeen. Die wissen so einen Schwachsinn.","sagt: ");
  
  AddInfo(DEFAULT_INFO, ({"sagt: Verschwinde einfach!\n",
  "sagt: Blablabla ich hoere Dir gar nicht zu!\n",
  "sagt: Wetten Du weisst nicht was pronoid heisst? Ha, dachte ich es mir doch!\n",
  "sagt: Gaehn! Du kannst vielleicht bloed fragen.\n",
  "sagt: Sag erst geliebter Imperator zu mir. Vielleicht antworte ich Dir wenn "
  "Du mir huldigst.\n",
  "sagt: Mein Woddy, da rackert man sich ein Leben lang ab und dann werden "
  "einem solche Fragen gestellt.\n",
  "sagt: Mach bei meiner Sekretaerin einen Termin fuer eine Audienz aus Du "
  "Wurm.\n"
  }));


SetChats(20, ({"@@chat_func@@"}));


  SUID;
  CLONEME("/d/dschungel/trintrasil/fluss/obj/haferl.lpc");
  command("trage schuhe");
}


chat_func() {
	
	if( environment(this_object()) && environment(this_object())->QueryProp("turm")==1 ) {
		
		switch(random(43)) {
			
			case 1 : return(BSS("Tu mir den Gefallen und sagt \"Den Gouverneur "
			"zum Gruss\" wenn Du jemand von der Roten Faust triffst.",
			"Der Kobold grinst: "));
			break;
			
			case 2 : return(BS("Der Kobold spuckt "
			"Dich an."));
			break;
			
			case 3 : return(BS("Du wuerdest den "
			"kleinen Quaelgeist am liebsten vom Felsen stossen."));
			break;
			
			case 4 : return(BS("Der Kobold rollt mit "
			"seinen uebergrossen Augen und ruelpst dabei."));
			break;
			
			case 5 : return(BS("Der Kobold haucht Dir "
			"seinen schlechten Atem ins Gesicht."));
			break;
			
			case 6 : return(BSS("Na los Du Schleimbeutel, "
			"hau ab so lange Du noch kannst.","Der Kobold sagt: "));
			break;
			
			case 7 : return(BS("Der Kobold versucht "
			"seine Unterlippe ueber seine Nase zu ziehen."));
			break;      	        
			
			case 8 : return(BS("Der Kobold wackelt "
			"mit den Ohren."));
			break;      
			
			case 9 :
			return(BSS("Schade, so eine Schiessbudenfigur wie Dich laesst "
			"wahrscheinlich sogar die Rote Faust laufen.",
			"Der Kobold seufzt: "));
			break;      
			
			case 10 : return(BS("Der Kobold gaehnt "
			"gelangweilt und zeigt Dir seine gelben Zaehne."));
			break;      
			
			case 11 : return(BSS("Gib mir all Dein Geld "
			"oder Du wirst mich kennen lernen.","Der Kobold sagt: "));
			break;
			
			case 12 : return(BSS("Du bist ja noch fader als "
			"eine vertrocknete Schnecke.","Der Kobold stoehnt: "));
			break;   
			
			case 13 : return(BS("Der Kobold bohrt in "
			"der Nase und seufzt."));
			break; 
			
			case 14 : return(BSS("Zeig mir mal Deinen "
			"Ausweis!","Der Kobold sagt: "));
			break;
			
			case 15 : return(BSS("Du siehst aus wie DJ-Amne!",
			"Der Kobold lacht: "));
			break;
			
			case 16 : return(BSS(
			"VERSCHWINDE VON MEINEM FELSEN HAB ICH GESAGT!!!",
			"Der Kobold schreit: "));
			break;
			
			case 17 : return(BS("Der Kobold beginnt "
			"so schrill zu kreischen das Dir die Ohren weh tun."));
			break; 
			
			case 18 : return(BS("Der Kobold stinkt "
			"ekelhaft nach vergammeltem Fisch."));
			break; 
			
			case 19 : return(BSS("Du Holzkopf, ich wuensch "
			"Dir lauter Bienen in Dein weiches Gehirn.",
			"Der Kobold knurrt: "));
			break;
			
			case 20 : return(BS("Der Kobold fummelt "
			"an Deiner Ausruestung herum."));
			break;
			
			case 21 : return(BSS("Kommst Du Dir mit "
			"Deinem Kasperlgewand nicht laecherlich vor?",
			"Der Kobold lacht: "));
			break; 
			
			case 22 : return(BS("Der Kobold lacht "
			"Dich gehaessig aus."));
			break;
			
			case 23 : return(BSS("Na warte, morgen erkennst "
			"Du Dich vor lauter Warzen nicht wieder!","Der Kobold sagt: "));
			break;
			
			case 24 : return(BSS("Schon mal ein Prinzesschen "
			"gerettet Du Schiessbudenfigur?","Der Kobold sagt: Na "));
			break;
			
			case 25 : return(BSS("Darfst Du ueberhaupt "
			"schon alleine aus dem Haus gehen?","Der Kobold fragt: "));
			break; 
			
			case 26 : return(BSS("Ist Dir klar das Du "
			"allen Grund hast mich zu fuerchten?","Der Kobold fragt: "));
			break; 
			
			case 27 : return(BSS("Wenn Du nicht puenktlich "
			"zur Milch zu Hause bist schimpft Deine Mutter wieder.",
			"Der Kobold warnt: "));
			break; 
			
			case 28 : return(BS("Der Kobold fragt: "
			"Bist Du ein Scheidungskind?"));
			break; 
			
			case 29 : return(BSS("Spielen wir Drache und "
			"dummer Held?","Der Kobold fragt: "));
			break;
			
			case 30 : return(BSS("Bekommst Du mit Deiner "
			"laecherlichen Kleidung manchmal ein Gratisbier?","Der Kobold "
			"fragt: "));
			break;
			
			case 31 : return(BS("Der Kobold fragt: "
			"Spielen wir schwedischer Dante?"));
			break;
			
			case 32 : return(BSS("Wenn Du nicht bald von "
			"selber gehst hau ich Dich einfach von meinem Felsturm.",
			"Der Kobold sagt: "));
			break;
			
			case 33 : return(BSS("Du wirst es noch bereuen "
			"mich gestoert zu haben!","Der Kobold sagt: "));
			break;
			
			case 34 : return(BSS("Kommst Du Dir eigentlich "
			"nicht manchmal laecherlich vor? Ich meine die ganzen Drachen "
			"und so.","Der Kobold lacht: "));
			break;
			
			case 35 : return(BSS("Privat laeufts wohl auch "
			"nichts zur Zeit, was? Wer rennt denn sonst so herum und makiert "
			"den grossen Held.","Der Kobold lacht: "));
			break;
			
			case 36 : return(BSS("Hau von meinem Felsturm ab! Sonst sag ich "
			"der Roten Faust das Du ein Fan vom Gouverneur bist.",
			"Der Kobold sagt: "));
			break;
			
			case 37 : return(BSS("Mit einem Hampeldoedel wie Dir haette "
			"die Rote Faust ihre Freude. Soll ich sie Dir einmal vorstellen?",
			"Der Kobold grinst: "));
			break;
			
			case 38 : return(BSS("Na warte. Ich werde Zack de la Rocha sagen "
			"Du haettest gesagt die Rote Faust ist ein Pfadfinderverein.",
			"Der Kobold grinst: "));
			break;
			
			case 39 : return(BSS("Hoffentlich erwischt Dich die Rote Faust. "
			"Ich kann mir nicht vorstellen das sie einen Idioten wie Dich "
			"wieder laufen lassen.","Der Kobold seufzt: "));
			break;
			
			case 40 : return(BS("Der Kobold zieht Dich "
			"an den Haaren."));
			break;
			
			case 41 : return(BSS("Wie waers wenn Du noch weiter in den Dschungel "
			"gehen wuerdest und ein \"Halleluja dem Gouverneur\" singen "
			"wuerdest? Die Rote Faust mag das sicher.","Der Kobold grinst: "));
			break;
			
			case 42 : return(BS("Der Kobold schubst "
			"Dich. Beinahe waerst Du vom Felsturm gestuerzt."));
			break;
			
			case 0 : return(BSS("Du hast wohl auch nichts "
			"gescheites gelernt. Immer nur dumm rumrennen und Orks aergern, "
			"wie?","Der Kobold lacht: "));
			break;
			
			default: return(BSS("Du siehst aus wie DJ-Amne!",
			"Der Kobold lacht: "));
		}
	}
	
	if( environment(this_object()) && environment(this_object())->QueryProp("turm")!=1 ) {
		
		switch(random(19)) {
			
			case 1 : return(BSS("Wenn Du mir nicht aus dem Wasser hilfst "
			"sag Ich der Roten Faust Du haettest ueber sie gemault!",
			"Der Kobold kreischt: "));
			break;
			
			case 2 : return(BS("Der Kobold spuckt "
			"gurgelnd Wasser."));
			break;
			
			case 3 : return(BSS("He Du, bring mich wieder "
			"auf den Felsturm da hinauf.","Der Kobold bruellt: "));
			break;
			
			case 4 : return(BS("Der Kobold rollt mit "
			"seinen uebergrossen Augen und ruelpst dabei blubbernd."));
			break;
			
			case 5 : return(BSS("Ich mach Dich reich "
			"und maechtig wenn Du mir aus dem Wasser hilfst!","Der Kobold "
			"kreischt: "));
			break;
			
			case 6 : return(BSS("Na los Du elender "
			"Schleimbeutel, zieh mich aus dem Wasser!","Der Kobold schreit: "));
			break;
			
			case 7 : return(BS("Der Kobold paddelt "
			"mit den Ohren."));
			break;
			
			case 8 : return(BS("Der Kobold "
			"verschreckt Deinen Fisch. Der wirft Dich beinahe ab!"));
			break;
			
			case 9 : return(BSS("Du assoziales Subjekt! "
			"Auch ICH hab meine Buergerrecht!","Der Kobold schreit: "));
			break;
			
			case 10 : return(BSS("Du ekeliges Klistier! "
			"Wegen Dir ist mein Sonntagsanzug total nass!","Der Kobold "
			"kreischt: "));
			break;
			
			case 11 : return(BSS("Wie lange soll Ich noch "
			"hier herumplantschen?!","Der Kobold schreit: "));
			break;
			
			case 12 : return(BS("Der Kobold beginnt "
			"so schrill zu kreischen das Dir die Ohren weh tun."));
			break;
			
			case 13 : return(BSS("Du Holzkopf, ich wuensch "
			"Dir lauter Bienen in Dein weiches Gehirn.","Der Kobold kreischt: "));
			break;
			
			case 14 : return(BSS("Glaubst Du der Fisch "
			"mag das, wenn ihm so ein Klops wie Du auf dem Ruecken hockt?",
			"Der Kobold schimpft: "));
			break;
			
			case 15 : return(BSS("Ob Du mit der Kinder"
			"ausruestung schwimmen kannst wenn ich jetzt Deinen Fisch "
			"absteche?","Der Kobold sagt: "));
			break;
			
			case 16 : return(BSS("Wenn Du mich nicht "
			"sofort rettest schick ich Dir meinen Anwalt! Ich habe eine "
			"Rechtsschutzversicherung! Ich mach Dich fertig!",
			"Der Kobold schreit: "));
			break;
			
			case 17 : return(BSS("Hol mich aus dem Wasser! "
			"Oder ich sag der Roten Faust das Du ein Regimetreuer bist!","Der "
			"Kobold schreit: "));
			break;
			
			case 18 : return(BS("Der Kobold kreischt "
			"wasserspuckend."));
			break;
			
			case 0 : return(BSS("Du kinderfressender "
			"Turbokapitalist! Ich verklage Dich wegen versuchten Ertraenkens "
			"*gurgelgurgel*!","Der Kobold kreischt: "));
			break;
			
			default: return(BSS("Hol mich aus dem Wasser! "
			"Oder ich sag der Roten Faust das Du ein Regimetreuer bist!",
			"Der Kobold schreit: "));
		}
	}
}