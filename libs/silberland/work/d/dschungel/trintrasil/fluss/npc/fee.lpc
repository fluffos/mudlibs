inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <npc.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#define FEEMASTER "/d/dschungel/trintrasil/fluss/feemaster.lpc"

void create()
{
  
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine Flussfee");
  SetProp(P_LONG,
    "Die zierliche, zerbrechlich wirkende Fee sirrt leicht mit ihren schimmernden "
    "Fluegeln und laechelt Dir zu. Sie glaenzt blau durchscheinend im "
    "Sonnenlicht. Ach wie nett!");
  SetProp(P_NAME, "Flussfee");
  SetProp(P_GENDER, FEMALE);
  AddId(({"flussfee","fee"}));

  create_default_npc(11);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit ihrer Magie", 140+random(30), (DT_WATER)}));
  SetProp(P_BODY, QueryProp(P_BODY) +30); //weil wendig ausweicht
  SetProp(P_NOMAGIC, 30);
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 45+random(10));
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -1-random(3) );
  SetProp(P_WEIGHT, 450+random(100));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY,25);
  SetProp(P_DIE_MSG, " zerfliesst in spritzende Wassertropfen.\n");
  SetProp(P_NOCORPSE, 1),
  SetProp(P_REJECT, ({ REJECT_GIVE,"Die Fee lehnt dankend ab.\n"}) );
  SetProp(P_RESISTANCE_STRENGTHS,([DT_FIRE: 1.0, DT_BLUDGEON: -0.3, DT_RIP: -0.3,
                                   DT_PIERCE: -0.3]));
  SetProp(P_MMSGIN, "oeffnet die Tuer und zirpt: GutenTag! Was kann ich fuer "
                    "Dich tun?");
  SetProp(P_MMSGOUT, "flattert");
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert fort");
  SetProp("insekt", 1);
  
  AD(({"fluegel","feenfluegel"}),
    "Die feinen Feenfluegel schimmern blaeulich im Sonnenlicht.");

  AD(({"licht","sonnenlicht"}),
    "Die kleine Fee schimmert im Licht wie klares Wasser.");
    
  AD(("wasser"),
    "Die Flussfee ist anscheinend ein vollkommen harmloses Wesen. Vielleicht "
    "kann sie Dir ja irgendwie helfen.");
    
  AD(("wesen"),
    "Immerhin ist der Fluss ihre Heimat. Sie kennt den Rio de la Puseta sicher "
    "besser als jeder andere.");
    
  AD(({"heimat","fluss","rio","rio de la puseta"}),
    "Wenn Du etwas ueber den Fluss wissen willst, dann bist Du bei diesem "
    "freundlichen Wesen sicher richtig.");
        
  AD(("laecheln"),
    "Die niedliche Fee sieht so aus als wuerde sie immer laecheln.");

  CLONEME("/d/dschungel/trintrasil/fluss/obj/feestab");
  
SetAttackChats(18, ({
	"\nEine Fee beginnt zischend zu dampfen!\n\n",
	"\nEine Fee versprueht feine Wassertropfen!\n\n",
	"\nEine Fee gurgelt bedrohlich!\n\n",
	"\nEine Fee surrt zornig!\n\n",
	"\nEine Fee versprueht zornblaue Funken!\n\n",
	"\nEine Fee blinkt magischblau!\n\n",
	"\nEine Fee schwirrt surrend um Deinen Kopf!\n\n",
	"\nAus einer Fee spritzt leuchtendes Wasser!\n\n",
	"\nEine Fee weicht behende aus!\n\n",
	"\nEine Fee taucht flink unter Deinem Arm durch!\n\n",
	"\nEine Fee umkreist Dich wie eine leuchtende Kugel!\n\n",
	"\nEine Fee weicht summend aus!\n\n"}) );
	
  	    
  AddInfo(DEFAULT_INFO, ({"neigt nur fragend den Kopf.\n",
           "sagt: Ich kann Dir da leeeiiider nicht helfen.\n",
           "klatscht froehlich in die Haende\n",
           "singt leise vor sich hin.\n",
           "sagt: tralali tralalaa wie schoen ist doch das Feenleeeeben.\n",
           "singt: Wie sind wir Feen doch lieb.\n",
           "laechelt mit ihren frischgeputzten Zaehnen.\n",
           "singt: Bluemchen und Voegelein, tralalaa.\n",
           "schreit: GEH MIR MIT DEINEN FRAGEN NUR JA NICHT AUF DEN "
           "SACK.\n"}));

  AddInfo(({"trintrasil","trint"}),
    "Wir Schokofeen stehen alle auf ihn.","schwaermt: ");
  
  AddInfo(({"wernzi","amnenion","unterhosen"}),
    "IIEEHHH! Wernzis Unterhosen sind immer braun.","schaudert: ");
    
  AddInfo(({"fluss","wasser","teil","tropfen"}),
    "Das Wasser ist meine Liebe und meine Heimat.","sirrt: ");
  
  AddInfo(({"boot","kanu"}),
    "Wozu brauche ich ein Boot wenn ich Fluegel besitze?","sirrt: "); 
  
  AddInfo(({"hoehle","hoehlen","hoehlensystem"}),
    "Die Hoehlen in diesen Felsen sind sehr weitlaeufig. Ich befliege sie nur "
    "ungern und selten. Ausserdem sind nicht alle ihre Bewohner "
    "ungefaehrlich.","sirrt: ");
    
  AddInfo(({"eingang","eingaenge","zugang","zugaenge","hoehleneingang",
            "hoehleneingaenge"}),
    "Eingaenge in die Hoehle gibt es viele, aber mich schaudert wenn ich an die "
    "Hoehle denke.","sirrt: ");        
              
  AddInfo(({"felsen","fels","gestein"}),
    "Der Fels interessiert mich kaum. Ich fuehle mich immer unwohl in seinen "
    "engen Hoehlen.","sirrt: ");
    
  AddInfo(({"bewohner"}),
    "Die Rote Faust benutzt die Hoehlen teilweise als Versteck. Sie haben weite "
    "Teile der Hoehle ueberhaupt erst zugaenglich gemacht.","sirrt: ");
    
  AddInfo(({"teile"}),
    "Sie haben weite Teile dieser Hoehlen trocken gelegt und sich in ihnen "
    "eingerichtet. Fueher war der groesste Teil der Hoehle geflutet.","sirrt: "),
    
  AddInfo(({"faust","rote faust"}),
    "Ich halte mich von der Roten Faust fern. Sie lassen uns in Ruhe. Man sieht "
    "sie ohnehin nur sehr selten.","sirrt: ");
    
  AddInfo(("ruhe"),
    "Ich weiss nicht was die Rote Faust will, aber sie sind alle bewaffnet. Ich "
    "kann mich noch sehr genau an die Kaempfe erinnern.","sirrt: ");
    
  AddInfo(({"kaempfe","kampf"}),
    "Vor etwas mehr als einem Jahr kam ein Trupp Soldaten hier her und durchsuchte "
    "das Gebiet hier.","sirrt: ");
    
  AddInfo(({"trupp","soldaten"}),
    "Sie waren sicher auf der Suche nach der Roten Faust. Sie kaempften im Dschungel "
    "oberhalb der Schlucht. Seither habe ich hier aber keine Soldaten mehr "
    "gesehen.","sirrt: ");
    
  AddInfo(({"gebiet"}),
    "Sie das ganze Flussgebiet durchsucht. Gefunden haben sie die Faust anscheinend "
    "im Dschungel oberhalb der Schlucht. Ich habe aber keinen Soldaten von dort "
    "zurueckkehren sehen.","sirrt: ");
    
  AddInfo(("dschungel"),
    "Ja der Dschungel der oberhalb der dieser Schlucht liegt. Wie Du dort hin kommst "
    "weiss ich nicht. Ich flog immer dort hin. Seit den Kaempfen halte ich "
    "mich von dort aber fern. Das solltest Du auch tun.","sirrt: ");
    
  AddInfo(("jahr"),
    "Es sind keine neuen Soldaten mehr gekommen. Gluecklicherweise herrscht seither "
    "Ruhe.");
    
  AddInfo(({"heimat","liebe"}),
    "Mein ganzes Leben verbrachte ich am Fluss. Wenn ich mich zu weit vom "
    "Wasser entfernen wuerde muesste ich vor Angst vergehen.","schaudert: ");
    
  AddInfo(("angst"),
    "Wenn ich den sanften Hauch des Wassers nicht mehr fuehle verbrennt meine "
    "Seele.","schaudert: ");
    
  AddInfo(("seele"),
    "Meine Seele ist ein Teil des Flusses.","sirrt: ");
    
  AddInfo(("hauch"),
    "Der stille Gesang der Tropfen und der sanfte Geruch des "
    "Wasser.","schwaermt: ");
    
  AddInfo(("geruch"),
    "Riechst Du es nicht? Wie die Sonne langsam den Fluss verdunstet und das "
    "Wasser leicht und froehlich ueber die Blaetter steigt, und die verspielten "
    "Tropfen die der Wasserfall durch das Becken wirbelt?","schwaermt :");
    
  AddInfo(("sonne"),
    "Sonne und Fluss, fuehle sie und frage nicht.","laechelt: ");
    
  AddInfo(("gesang"),
    "Feensingsang tralalaa","singt: ");
    
  AddInfo(({"feensingsang","singsang"}),
    "lalaliii lalalaaa","groehlt: ");  


//oooooooooooooooooooo EINTRAGEN IN FEENMASTER ooooooooooooooooooooooooooooooooooo

FEEMASTER->add_fee();

}


//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//+++++++++++++++++++++                                                           +++++++++++++++++++++++++++
//+++++++++++++++++++++  ALLES FEENMASTER BETREFFENDE IN FEE1 BESSER BESCHRIEBEN  +++++++++++++++++++++++++++
//+++++++++++++++++++++                                                           +++++++++++++++++++++++++++
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


//oooooooooooooooooooo FEE RUFT ANDERE FEEN ZUR HILFE oooooooooooooooooooooooooooo

void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
object attacked_fee;
attacked_fee=TO;	

        FEEMASTER->ruf_um_hilfe(enemy);
	FEEMASTER->mastersupport(attacked_fee);
        ::Defend(dam, dam_type, spell, enemy);	

        if (!pointerp(dam_type))
           dam_type = ({ dam_type });

           if (sizeof(dam_type & ({ DT_WATER }) )) {
           	tell_room(environment(TO), 
           	  BSL("\nDie Fee staerkt sich lachend durch den "
           	  "Wasserangriff.\n\n"));
           	heal_self(10+random(40));
        }
}


//oooooooooooooooooooo AUSTRAGEN AUS FEENMASTER oooooooooooooooooooooooooooooooooo
                                 
remove(int arg) {
	
	FEEMASTER->remove_fee(this_object());
        ::remove(arg);
}
          

//oooooooooooooooooooooooo FEE HILFT ANDEREN FEEN ooooooooooooooooooooooooooooo
          
support(attacked_fee) {
	
	if(attacked_fee==TO) {

//tell_room("/d/dschungel/trintrasil/fluss/room/fluss15", "\n!ABBORD SUPPORT fee!\n");
        	return 1;
        }
        
	if( find_call_out("support")!=-1 || find_call_out("support1")!=-1 ) {

//		tell_room(ENV(TO), "\n!FIND_CALL_OUT! fee\n\n");
		return 1;
	}
	
	else {
		
		call_out("support1", 4+random(3), attacked_fee);
	}
	
}


support1(attacked_fee) { 

  	if(!attacked_fee) {

  		return 1;
  	}
  	
    	if( TO->InFight() ) {

//    		tell_room(environment(TO), BSL("\nIM INFIGHT fee\n\n"));  
    		return 1;
    	}
    	
    	if( TO->QueryProp(P_HP)<=TO->QueryProp(P_WIMPY) ) {

//    		tell_room(environment(attacked_fee), "\nNo ENERGIE fee\n");
    		return 0;
    	}
    	
    	if(!TO->InFight() ) {
    		
    		if( environment(TO)==environment(attacked_fee) )  {

    		        tell_room(environment(TO), BSL("\nEine Fee hilft "
    		        "ihrer Schwester!\n\n"));
//tell_room("/d/dschungel/trintrasil/fluss/room/fluss15", "\n!SAME ENV! fee\n");
    		}
    		
    	
    	        if( environment(TO)!=environment(attacked_fee) &&
    	        TO->QueryProp(P_HP)>TO->QueryProp(P_WIMPY) ) {
    	        	
    	        	tell_room(ENV(TO), BSL("\nDie Fee eilt schnell einer "
    	        	"Schwester zur Hilfe!\n\n")); 
    		        TO->move(environment(attacked_fee), 
    		        M_GO+ M_SILENT);
    		        tell_room(environment(TO), BSL("\nEine Fee eilt ihrer "
    		        "Schwester zur Hilfe!\n\n"));
//    		        tell_room(environment(attacked_fee), "\nGO TO "
//    		        ""+attacked_fee->name()+" fee\n\n");
    		}
    	}
}


feenanzahlimraum() {
	
	int i, menge;
        object *inv;
        menge=0;
        inv=all_inventory(ENV(TO));
   
        for(i=sizeof(inv)-1;i>=0;i--) {
        	
        	if(inv[i]->id("flussfee")) {
        		
        		menge++;
        	}
        }
return menge;}
