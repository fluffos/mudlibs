//klistier spricht nicht auf moerder.. ansonsten fertig
inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Klistier");
  SetProp(P_LONG, BS(
    "Das Klistier ist ueber einen Meter lang und gehoert zur Gattung der "
    "sehr seltenen Riesenfadenwuermer. Das weisse Klistier schlaengelt "
    "tastend ueber den Grund des Flusses auf der Suche nach Nahrung."));
  SetProp(P_NAME, "Klistier");
  SetProp(P_GENDER, NEUTER);

  AddId(({"klistier","riesenfadenwurm","fadenwurm","wurm"}));

  create_default_npc(5);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_MURDER_MSG, "Probiers mal mit Kaffee. Das soll angeblich entspannen!\n");
  SetProp(P_MSG_FLAGS, ([P_MURDER_MSG:1]));
  
  SetProp(P_HANDS, ({" mit seinen Saugnaepfen", QueryProp(P_HANDS)[1], ({DT_SQUEEZE})}));
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 0);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  
  SetProp(P_MNPC_AREA "fluss");
  SetProp(P_MNPC_WAIT, ({ 20+random(8), 40, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss2.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES +  MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwebt vom Himmel herab");
  SetProp(P_MMSGOUT, "verschwindet in einem Schwarzen Loch");

  SetProp(P_DIE_MSG,  " streckt sich noch einmal sterbend.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "hat Dir sicher interessantes zu "
                        "berichten.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Fadenwurm ist sicher an Deinem Zeug interessiert!\n" }) );

AD(({"fadenwurmart","wurmart","wurmgattung","fadenwurmgattung","gattung","art",
     "fadenwuermer","wuermer"}),
  "Normale Fadenwuermer sind meist Schmarotzer die im Koerper ihrer Wirtstiere "
  "leben und schlimme Krankheiten verursachen koennen.");

AD(({"riesenwuermer","riesenfadenwuermer"}),
  "Riesenfadenwuermer sind sehr selten und kommen nahezu ausschliesslich im "
  "Flussgebiet des Rio de la Puseta vor. Obwohl sie sehr lang sind, sind sie "
  "harmloser als ihre schmarotzenden Artgenossen.");
  
AD(({"krankheit","krankheiten"}),
  "Der Tijarawurm zum Beispiel ist ein kleiner Fadenwurm der oft in "
  "Flusswasser vorkommt.");
  
AD(("tijarawurm"),//siehe Medinawurm in Realitaet
  "Wer Larven des Tijarawurmes trinkt erkrankt fuerchterlich.");
  
AD(("larven"),
  "Der Tijarawurm wird bis zu einen Meter lang und erzeugt Geschwuere im Darm, "
  "die dann aufbrechen und hunderte weitere Larven freisetzen.");
  
AD(({"geschwuere","darm"}),
  "Die Geschwuere sind zwar sehr schmerzhaft, der Tijarawurm fuehrt aber "
  "seltener zum Tod als Trichinebefall.");
  
AD(({"trichine","trichinebefall"}),
  "Trichine sind kleine Fadenwuermer, die mit befallenem Fleisch aufgenommen "
  "werden. Sie fressen sich dann durch Deine Darmwand in Dein Muskelgewebe, wo "
  "sie tausende Larven legen und jahrelang leben koennen, bis die Krankheit "
  "oft zum Tod fuehrt.");
  
AD(({"zeit","tod"}),
  "Naja da bleibt doch noch Zeit.");
  
AD(({"darmwand","fleisch"}),
  "Also nicht gleich alles essen was Du findest.");
  
AD(({"muskelschmerzen","muskelgewebe","gewebe","muskel"}),
  "Das fuehrt natuerlich zu hoellischen Muskelschmerzen.");
  
AD(({"genossen","artgenossen","schmarotzer"}),
  "Sie leben im Koerper ihrer Wirtstiere und vermehren sich dort.");
  
AD(("koerper"),
  "Gesund ernaehrt und durchtrainiert, so wie Deiner.");
  
AD(({"tiere","wirtstiere"}),
  "Du waerst als Wirtstier sicher hervorragend geeignet.");
  
AD(({"grund","nahrung","suche"}),
  "Das Klistier ist die einzige Fadenwurmart die nicht schmarotzend lebt und "
  "sich nur von Algen und anderen kleinen Pflanzen in Fluessen ernaehrt.");
  
AD(({"algen","pflanzen"}),
  "Das Klistier grast den Grund des Flusses nach Algen ab.");
  
AD(({"fluesse","fluss"}),
  "Das Klistier lebt ausschliesslich im Wasser.");  
}

