//fertig und getestet
//ueberpruefen ob reset ueberhaupt notwendig ist
inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

//erpel der das gemeine knackentenweibchen verfolgt

reset() {//sind beide enten tod werden sie in fluss3 wieder zusammen erneuert und
//das maennchen kann das weibchen wieder verfolgen

	if( ENV(TO) && present("Knackente", ENV(TO)) ) {
	
	}
	
        if( ENV(TO) && !present("Knackente", ENV(TO)) ) {
        	
        	tell_room(ENV(TO), "Der Erpel taucht blitzschnell unter.\n");
        	TO->remove();
        }
        ::reset();
}


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Knackentenerpel");
  SetProp(P_INT_LONG, BS(
    "Das gemeine Knackentenmaennchen traegt gerade sein rot, blaues "
    "Balzgefieder. Balzend und schnatternd schwimmt der Erpel um das Weibchen "
    "herum. Diese Entenart kommt nur in suedlichen Flussgebieten vor."));
  SetProp(P_NAME, "Knackentenerpel");
  SetProp(P_NAME_ADJ, "gemein");
  SetProp(P_GENDER, MALE);
  AddId(({"ente","knackente","erpel","entenmaennchen","knackentenmaennchen",
  "NOWIMPY"}));

  create_default_npc(8);

  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  enable_commands();
  set_living_name("mkente"); 

  AD(({"balzgefieder","gefieder"}), 
    "Der Erpel traegt gerade sein leuchtend blau, rotes Balzegfieder");
    
  AD(({"entenart","art"}),
    "Die gemeine Knackente ist eine tropische Entenart die nur hier "
    "in den suedlichen Feuchtgebieten vorkommt.");
    
  AD(({"flussgebiet","flussgebiete","gebiete","gebiet","feuchtgebiet",
       "feuchtgebiete"}),
    "Der Rio de la Puseta bildet riesige Feuchtgebiete.");
       
  SetProp(P_HANDS, ({" mit Hilflosigkeit", QueryProp(P_HANDS)[1],({DT_BLUDGEON})}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 50);
  SetProp(P_WEIGHT, 2800);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "folgt schnatternd dem Weibchen");
  SetProp(P_MMSGIN, "taucht schnatternd auf");
  SetProp(P_MMSGOUT, "taucht schnatternd unter");

  SetProp(P_DIE_MSG,  " geht zuckend unter.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "sagt: quaaackquaaaaaaaaack.\n");
  AddInfo("dante", "Will ich garnicht kennen.","ruelpst: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Glaubst Du eine Knackente kann irgendetwas damit anfangen?\n" }) );

call_out("pursuer", 1);
}


_query_long() {		
	
	if(present("entenweibchen", environment(this_object()) ) ) {
		
		return BS("Das gemeine Knackentenmaennchen traegt gerade "
		          "sein rot, blaues Balzgefieder. Balzend und "
		          "schnatternd schwimmt der Erpel um das Weibchen herum. "
		          "Diese Entenart kommt nur in suedlichen Flussgebieten "
		          "vor.");
	}
		
	if(!present("entenweibchen", environment(this_object()) ) ) {
	
		return BS("Das gemeine Knackentenmaennchen traegt gerade sein "
		          "rot, blaues Balzgefieder. Schnatternd durchpfluegt "
		          "er mit seinem Schnabel das Wasser auf Suche nach "
		          "Nahrung. Diese Entenart kommt nur in suedlichen "
		          "Flussgebieten vor.");
	}
}

		
pursuer() {

object weibchen;
weibchen = find_living("wkente");
weibchen->AddPursuer(this_object());
}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {

object ente;
ente=present("entenweibchen", ENV(TO));
	
	if(ente) {

		ente->support(enemy);
		::Defend(dam, dam_type, spell, enemy);
	}
	
	if(!ente) {
		
		::Defend(dam, dam_type, spell, enemy);		
	}
}


support(object enemy) {
	
	if(!TO->InFight()) {
		
		tell_room(ENV(TO), "\nDer Erpel hilft der Ente!\n\n");	
		TO->InsertEnemy(enemy);
	}
	
	if(TO->InFight()) {
		
		TO->InsertEnemy(enemy);
	}
}

         
                                
 		