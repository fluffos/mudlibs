//fertig und getestet
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Flussnatter");
  SetProp(P_LONG, BS(
    "Eine gesprenkelte Flussnatter schlaengelt pfeilschnell ueber das Wasser. "
    "Sie ist schwarz mit leuchtend gelben Punkten. Obwohl Du weisst das diese "
    "ohnehin eher kleine Natternart ungefaehrlich ist, schaudert Dich doch "
    "beim Anblick der schwimmenden Schlange."));
  SetProp(P_NAME, "Flussnatter");
  SetProp(P_NAME_ADJ, "gesprenkelt");
  SetProp(P_GENDER, FEMALE);

  AddId(({"schlange","flussnatter","natter","wasserschlange","flusschlange"}));

  create_default_npc(13);

  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit ihren scharfen Zaehnen", QueryProp(P_HANDS)[1], ({DT_RIP})}));
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 3500);
  SetProp(P_ALIGN, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 50);
  
  SetProp (P_MNPC_AREA "/d/dschungel/trintrasil/fluss");
  SetProp (P_MNPC_WAIT, ({ 20+random(8), 30, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss5.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "schwimmt fort");

  SetProp(P_DIE_MSG,  " versinkt im Fluss.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "reagiert nicht auf Dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Schlange reagiert nichr auf Dich.\n" }) );

AD(({"punkte","punkt"}),
  "Die giftig leuchtenden Punkte sollen die Natter fuer ihre Feinde "
  "gefaehrlich aussehen lassen. Soviel Du weisst ist die Natter aber ungiftig.");

AD(("feinde"),
  "Die Natter hat kaum Feinde. Wer frisst schon gerne eine giftgelb gesprenkelte "
  "Schlange.");
  
AD(({"art","natternart"}),
  "Diese Natternart ernaehrt sich nur von Insekten, daher braucht sie auch kein "
  "Gift.");
  
AD(("gift"),
  "Andere Natternarten, die sich von groesserer Beute ernaehren, sind oft sehr "
  "giftig.");
  
AD(({"beute","insekten"}),
  "Die gesprenkelte Flussnatter ernaehrt sich nur von Insekten, von denen sie "
  "hier am Fluss mehr als genug findet.");

AD(({"nattern","natternarten","arten"}),
  "Hier im Dschungel leben die gefaehrlichsten Schlangenarten des Silberlandes. "
  "Die gesprenkelte Flussnatter ist wohl eine der angenehmsten.");

AD(("anblick"),
  "Dir ist der Anblick der so knapp an Dir vorbei schwimmenden Schlange "
  "unangenehm. Das ist wohl eine angeborene Angst vor Schlangen.");
  
AD(({"angst","abneigung"}),
  "Beinahe Jeder hat eine angeborene Abneigung gegen Schlangen, was durchaus "
  "seinen Sinn hat.");
  
AD(("sinn"),
  "Jemand der gern mit lieben, kleinen Giftschlaengchen spielt koennte eine "
  "signifikant verkuerzte Lebenserwartung haben.");
  
AD(({"lebenserwartung","erwartung"}),
  "Die gesprenkelte Flussnatter sollte Deine Lebenserwartung kaum vermindern.");
  
AD(({"giftschlaengchen","schlaengchen"}),
  "Wenn Du gerne mit Giftschlaengchen spielst bist Du im Dschungel genau "
  "richtig.");   
}