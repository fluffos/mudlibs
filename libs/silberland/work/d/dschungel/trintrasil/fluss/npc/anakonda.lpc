//fertig
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zahnanakonda");
  SetProp(P_LONG, BS("Die Zahnanakonda ist eine gewaltige nahezu 9 meter lange Riesenschlange. "
  "Als einzige Art der Riesenschlangen besitzt diese gewaltige, lange Eckzaehne. Sie besitzt "
  "zwar kein Gift, toetet aber auch grosse Tiere mit ihrem furchtbaren Wuergegriff und ihren "
  "Zaehnen. Die Zahnanakonda lebt in feuchten Gebieten und ueberrascht ihre Beute im Wasser "
  "oder faellt sie von Baeumen herab an. Die Kannibalen nennen die Zahnanakonda den schnellen "
  "Tod."));
  SetProp(P_NAME, "Zahnanakonda");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_RACE, "Echse");
  
  AddId(({"tod","schneller tod","anakonda","zahnanakonda","schlange"}));

  AD(({"art","riesenschlangen"}),
    "Riesenschlangen toeten meistens nur mit ihrem Wuergegriff.");
    
  AD(({"griff","wuergegriff","bisse"}),
  "Die Schlange umschlingt ihre Beute und erdrueckt sie. Die Zahnanakonda toetet noch "
  "zusaetzlich durch Bisse.");
  
  AD(("gift"),
  "Das Gift braucht die Anakonda nicht.");
  
  AD(({"beute","tiere"}),
  "Die Anakonda ist nicht waehlerisch. Sie ernaehrt sich von allen grossen Tieren.");
  
  AD(({"zaehne","eckzaehne","zahn","eckzahn"}),
  "Die Zaehne sind ca 25 cm lang. Sie sind angeblich sehr wertvoll und bei den Kannibalen sehr "
  "beliebt.");
  
  AD(("gebiet"),
  "Die Zahnanakonda wurde bisher nur im Flussgebiet des Rio de la Puseta gesichtet.");
  
  AD(({"wasser","baeume","baum"}),
  "Die Zahnanakonda naehert sicher gerne unbemerkt unter Wasser ihrer ahnungslosen Beute oder "
  "faellt von Baeumen auf sie herab.");
  
  AD(({"tod","schneller tod"}),
  "Die Kannibalen, die im selben Gebiet leben wie die Zahnanakonda muessen es wissen.");
  
  AD(("kannibalen"),
  "Die Anakondazaehne sind bei den Kannibalen sehr beliebt.");
    
    
  create_default_npc(42);
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit ihren Eckzaehnen", QueryProp(P_HANDS)[1] ,({DT_PIERCE})}));
  SetProp(P_SIZE, 800+random(100));
  SetProp(P_WEIGHT, 100000);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_AGGRESSIVE,0.5);
  SetProp(P_KILL_MSG, "!!BSSSSSSSSSSSSSSSBSSSSSSSSSSSSS!! SCHMATZ!!\n");

  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "detoniert");

  SetProp(P_DIE_MSG,  " stirbt zuckend.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "will Dich toeten!\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Anakonda will Dich toeten!\n" }) );

  SetProp(P_SPELLRATE, 30);
  
  AddSpell(3,600, 
  "\nDie Zahnanakonda hackt ihre Zaehne in Dein Fleisch.\n\n",
  "\nDie Zahnanakonda hackt ihre Zaehne in @WESSEN Fleisch.\n\n",
  DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(3, 500,
  "\nDie Zahnanakonda verbeisst sich zischend in Deinen Arm.\n\n",
  "\nDie Zahnanakonda verbeisst sich zischend in @WESSEN Arm.\n\n",
  DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(2, 1,  
  "\nDie Zahnanakonda peitscht wuetend mit ihrem maechtigen Schwanz!\n\n",
  "\nDie Zahnanakonda peitscht wuetend mit ihrem maechtigen Schwanz!\n\n",
  DT_BLUDGEON, "spell_overkill");

  AddSpell(2, 200,
  "\nDie Anakonda umschlingt Dich und versucht Dich zu erwuergen!!\n\n",
  "\nDie Anakonda umschlingt @WEN und versucht @WEN zu erwuergen!!\n\n",
  DT_BLUDGEON, "paralyse");


  CLONEME("/d/dschungel/trintrasil/fluss/obj/azaehne.lpc");
}


void spell_overkill(object enemy, int damage, mixed dam_type) {
	
	int i;
        object *inv;
        inv=filter_array(all_inventory(environment(TO)),#'living) ;  
        
        for(i=sizeof(inv)-1;i>=0;i--) {
        	
        	if( interactive(inv[i]) ) {
        		
        		inv[i]->Defend(600+random(150), DT_BLUDGEON, 0, this_object());
        	}
        	
        	else {
        	}
        }
}


void paralyse(object enemy, int damage, mixed dam_type) {
	
	if (!enemy->QueryProp(P_PARALYZED)) {
		enemy->SetProp(P_PARALYZED, 
                ([PARALYZE_TIME: 5+random(3),
                PARALYZE_MSG: "\nDu bist vollkommen bewegungsunfaehig!\n\n",
                PARALYZE_MSG_OTHER: "\n%s ist von der Anakonda vollkommen eingeschnuert!\n\n",
                PARALYZE_END: "\nDu kannst Dich gerade noch aus dem Wuergegriff befreien!\n\n",
                PARALYZE_END_OTHER: "\n%s kann sich aus dem Wuergegriff befreien!\n\n"]));
	}
}