
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG, BS(
    "Das ist ein test Skelett."));
  SetProp(P_NAME, "Skelett");
  SetProp(P_GENDER, NEUTER);
  AddId(({"skelett"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen Tentakeln", 70+random(50) ,({DT_BLUDGEON})}));
  SetProp(P_RACE, "Untoter");
AddClass("CL_UNDEAD");
  SetProp(P_HP, 50);
  SetProp(P_MAX_HP, 50);
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL, 8);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MSGOUT, "klappert");
  SetProp(P_MMSGIN, "schiesst unter dem Stein hervor");
  SetProp(P_MMSGOUT, "verglueht am Ereignishorizonz");

  SetProp(P_DIE_MSG,  " zittert ein letzes mal mit seinen "
                      " Tentakeln.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "Der Tintenfisch beaeugt Dich misstrauisch.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Tintenfisch weicht nervoes zurueck.\n" }) );

  
     AddCmd("testmsg", "msg");

}


msg() {
	
	tell_object(TP, "Mein Schatten ist inaktiv.\n\n");
	return 1;
}
