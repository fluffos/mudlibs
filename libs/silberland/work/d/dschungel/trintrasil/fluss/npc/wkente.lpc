//fertig und getestet
inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


reset() {//sind beide enten tod werden sie in fluss3 wieder zusammen erneuert und
//das maennchen kann das weibchen wieder verfolgen

	if( ENV(TO) && present("Knackentenerpel", ENV(TO)) ) {
	}
	
        if( ENV(TO) && !present("Knackentenerpel", ENV(TO)) ) {
        	
        	tell_room(ENV(TO), "Die Ente taucht blitzschnell unter.\n");
        	TO->remove();
        }
        ::reset();
}


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Knackente");
  SetProp(P_LONG, BS(
    "Das gemeine Knackentenweibchen ist im Gegensatz zum balzenden Maennchen "
    "graubraun und unauffaellig. Diese Entenart kommt nur in suedlichen "
    "Flussgebieten vor."));
  SetProp(P_NAME, "Knackente");
  SetProp(P_NAME_ADJ, "gemein");
  SetProp(P_GENDER, FEMALE);
  AddId(({"ente","knackente","weibchen","entenweibchen","knackentenweibchen"}));

  create_default_npc(8);

  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  enable_commands();
  set_living_name("wkente");
  
  SetProp(P_HANDS, ({" mit Hilflosigkeit", QueryProp(P_HANDS)[1],({DT_BLUDGEON})}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 27);
  SetProp(P_WEIGHT, 2500);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 20);

  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 5+random(8), 10, 30 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss3.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "taucht schnatternd auf");
  SetProp(P_MMSGOUT, "taucht unter");

  SetProp(P_DIE_MSG,  " geht zuckend unter.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "sagt: quaaackquaaaaaaaaack!!\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Glaubst Du eine Knackente kann irgendetwas damit anfangen ?\n" }) );

}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {

object ente;
ente=present("knackentenmaennchen", ENV(TO));
	
	if(ente) {
	
		ente->support(enemy);
		::Defend(dam, dam_type, spell, enemy);
	}
	
	if(!ente) {
		
		::Defend(dam, dam_type, spell, enemy);		
	}
}


support(object enemy) {
	
	if(!TO->InFight()) {
		
		tell_room(ENV(TO), "\nDie Ente hilft dem Erpel!\n\n");	
		TO->InsertEnemy(enemy);
	}
	
	if(TO->InFight()) {
		
		TO->InsertEnemy(enemy);
	}	
}