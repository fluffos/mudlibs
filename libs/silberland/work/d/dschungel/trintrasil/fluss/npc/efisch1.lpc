//fertig und getestet
inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

string adj;
int brennwert, saettigung, adjint;
int flightint=0;


reset() {//fisch verschwindet nach einiger zeit wieder
	
	::reset();
	
	if( ENV(TO) ) {
		tell_room(ENV(TO),BS("Die Flussgrundel taucht unter."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
		M_SILENT);
		TO->remove();
	}
}


void create() {
	
	switch (random(7)) {
		
		case 0..1 :
		adj = "jung";
		adjint=0; 
		break;
		
		case 2..3 : 
		adj = "ausgewachsen"; 
		adjint=1;
		break;
		
		case 4..5 : 
		adj = "gross"; 
		adjint=2;
		break;
		
		case 6 : 
		adj = "riesig";
		adjint=3; 
		break;
		
		default:
		adj = "ausgewachsen"; 
		adjint=1;
	}
	
	brennwert=5+2*adjint+random(3);
	saettigung=1;
	
	if (!is_clone(TO)) return;
	
	::create();
	

SetProp(P_SHORT, "Eine Flussgrundel");
SetProp(P_LONG, BS(
"Die Grundel ist ein spindelfoermiger, langgezogener Speisefisch. Sie "
"schimmert gruenlich und schwimmt knapp unter der Wasseroberflaeche. Wenn "
"Du einen Fischspeer hast kannst Du sie damit jagen. Auch wenn sie klein ist "
"waere sie ein nahrhafter Happen."));
  
AD(({"happen","speisefisch","fisch"}),
  "Die Grundel ist ein kleiner, aber guter Speisefisch. Mit einem Fischspeer "
  "koenntest Du sie jagen.");
  
AD(({"oberflaeche","wasseroberflaeche"}),
  "Die Grundel gleitet seelenruhig knapp unter der Wasseroberflaeche.");
  
AD(({"speer","fischspeer"}),
  "Mit so einem leichten, duennen Speer koenntest Du die Grundel "
  "jagen.");
  
SetProp(P_NAME, "Flussgrundel");
SetProp(P_GENDER, FEMALE);

AddId(({"grundel","flussgrundel","fisch","EFISCH"}));

create_default_npc(5);

SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow  
SetProp(P_NAME_ADJ, ""+adj+"");
SetProp(P_RACE, "Fisch");
SetProp(P_SIZE, 8+4*adjint);
SetProp(P_WEIGHT, 70+20*adjint);
SetProp(P_NOATTACK, "weicht blitzschnell aus. Du kannst Sie nur mit \n"
                    "einem Fischspeer jagen.\n");
SetProp(P_INFO, BS("Du koenntest die Flussgrundel mit einem Fischspeer "
                   "jagen."));
  
SetProp (P_MNPC_AREA "fluss");
SetProp (P_MNPC_WAIT, ({ 15+random(8), 30, 25 }));
SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/trintrasil/fluss/room/fluss7.lpc");
SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
SetProp(P_MSGIN, "schwimmt herein");
SetProp(P_MSGOUT, "schwimmt");
SetProp(P_MMSGIN, "schwimmt herein");
SetProp(P_MMSGOUT, "taucht unter");

SetProp(P_DIE_MSG,  " stirbt zuckend.\n");
SetProp(P_NOCORPSE, 1);

AddInfo(DEFAULT_INFO, "bemerkt Dich gar nicht.\n");

SetProp( P_REJECT, ({ REJECT_DROP,
                     "Die Flussgrundel schwimmt uninteressiert herum.\n" }) );

AddCmd(("fischkont"), "sag_int");
}


/*erlegt ein spieler den fisch wird aus speer die funktion clone_food aufgerufen, in der ein 
dem fisch entsprechendes food gecloned und dem spieler ins inventory gemoved wird.
dannach wird der fisch removed. 
je nach eingenschaften des fisches hat das food unterschiedliche werte.
*/
	
clone_food(jaeger) {
	
	int weight;
	object fishfood1;
	
	if( ENV(TO)!=ENV(TP) ) {
		
		TO->remove();
		return 1;
	}
	
	if( ENV(TO)==ENV(TP) ) {
		
		weight=this_object()->QueryProp(P_WEIGHT);
	        
	        fishfood1=CLONEOB("/d/dschungel/trintrasil/fluss/obj/fishfood1.lpc");
	        
	        fishfood1->
	        SetProp(P_FOOD_INFO, ([F_HEAL : ({brennwert,brennwert}), 
	        F_SOAK : 1,
	        F_MSG:"Vorsichtig nimmst Du die Flussgrundel aus und isst ihr "
	        "zartes, rohes Fleisch.\n",
	        F_MSG_ROOM:"isst eine rohe Flussgrundel.\n"]));
	        fishfood1->SetProp(P_WEIGHT, weight);
	        fishfood1->move(jaeger, M_NOCHECK);
	        TO->remove();
	        return 1;
	}
}


int flightcount() {
	flightint++;
}


int flight() {
	return flightint;
}


sag_int() {
	
	tell_room(ENV(TO), BSL("Brennwert:  "+brennwert+"\n"
	                       "Saettigung: "+saettigung+"\n"
	                       "Adjint:     "+adjint+"\n"
	                       "AdjSting:   "+adj+"\n"
	                       "Groesse:    "+TO->QueryProp(P_SIZE)+"\n"
	                       "Gewicht:    "+TO->QueryProp(P_WEIGHT)+"\n"));
	return 1;         
}
	                
	                
 