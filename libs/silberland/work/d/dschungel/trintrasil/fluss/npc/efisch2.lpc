//fertig und getestet
inherit "std/mnpc";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


int adjint;
int flightint=0;
string adj;


reset() {//fisch verschwindet nach einiger zeit wieder
	
	::reset();
	
	if( ENV(TO) ) {
		
		tell_room(ENV(TO),BS("Das Petermaennchen taucht unter."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
		M_SILENT);
		TO->remove();
	}
}


void create() {

switch (random(7)) {
	
	case 0..1 : 
	adj = "jung";
	adjint=0; 
	break;
	
	case 2..3 : 
	adj = "ausgewachsen"; 
	adjint=1;
	break;
	
	case 4..5 : 
	adj = "gross"; 
	adjint=2;
	break;
	
	case 6 : 
	adj = "riesig";
	adjint=3; 
	break;
	
	default:
	adj = "ausgewachsen"; 
	adjint=1;
}
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Petermaennchen");
  SetProp(P_LONG, BS(
  "Das "+adj+"e Petermaennchen ist ca "+TO->QueryProp(P_SIZE)+" cm lang. Sein "
  "Koerper ist schmal und mit schraegen, schwarzen Streifen bedeckt. Am Bauch "
  "und auf dem Ruecken besitzt es jeweils einen langen, stacheligen Flossenkamm. "
  "Du koenntest diesen Fisch mit einem Fischspeer jagen."));
  
  AD(({"koerper"}),
  "Das Petermaennchen ist laenglich und schmal. Es ist mit dem Fischspeer "
  "sicher nicht leicht zu treffen.");
  
  AD(({"streifen"}),
  "Die dunklen Streifen bedecken den ganzen Koerper des Fisches.");
  
  AD(({"kamm","flossenkamm","laenge","ruecken","bauch"}),
  "Der Flossenkamm auf Ruecken und Bauch verlaeuft ueber die gesamte Laenge des "
  "Fisches.");
  
  AD(({"speer","fischspeer"}),
  "Mit diesem leichten duennen Speer koenntest Du das Petermaennchen "
  "aus dem Wasser stechen.");
  
  AD(("fleisch"),
  "Du kannst das Fleisch des Petermaennchens nicht untersuchen, es schwimmt ja "
  "noch im Wasser.");
  
  SetProp(P_NAME, "Petermaennchen");
  SetProp(P_GENDER, NEUTER);

  AddId(({"petermaennchen","fisch","EFISCH"}));

  create_default_npc(6);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_INFO, BS("Du koenntest das Petermaennchen mit einem Fischspeer "
  "jagen, aber untersuche lieber sein Fleisch bevor Du es isst."));
  SetProp(P_NAME_ADJ, ""+adj+"");
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 20+5*adjint+random(5));
  SetProp(P_WEIGHT, 300+100*adjint+random(200));
  SetProp(P_NOATTACK, "weicht blitzschnell aus. Du kannst es nur mit \n"
  "einem Fischspeer jagen.\n");
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 15+random(8), 30, 25 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss20.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "taucht unter");

  SetProp(P_DIE_MSG,  " stirbt zuckend.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "zieht ungestoert seine Kreise.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Petermaennchen schwimmt uninteressiert herum.\n" }) );

AddCmd(("fischkont"), "sag_int");
}


/*erlegt ein spieler den fisch wird aus speer die funktion clone_food aufgerufen, in der ein 
dem fisch entsprechendes food gecloned und dem spieler ins inventory gemoved wird.
dannach wird der fisch removed. 
je nach eingenschaften des fisches hat das food unterschiedliche werte.
*/
	
clone_food(jaeger) {
	
	int weight;
	object fishfood2;
	
	if( ENV(TO)!=ENV(TP) ) {
		
		TO->remove();
		return 1;
	}
	
	if( ENV(TO)==ENV(TP) ) {
		
		weight=this_object()->QueryProp(P_WEIGHT);
	        
	        fishfood2=CLONEOB("/d/dschungel/trintrasil/fluss/obj/fishfood2.lpc");
	        
	        fishfood2->
	        SetProp(P_FOOD_INFO, ([ F_POISON : 2+adjint, 
	        F_SOAK : 1,
	        F_MSG:"Du isst das rohe Fleisch des Petermaennchens und fuehlst ploetzlich "
	        "ein krampfhaftes Ziehen im Bauch.\nDas Petermaennchen ist anscheinend ein "
	        "giftiger Fisch!",
	        F_MSG_ROOM:"isst das rohe Fleisch eines Petermaennchens und haelt sich "
	        "ploetzlich stoehnend den Bauch.\n"]));
	        fishfood2->SetProp(P_WEIGHT, weight);
	        fishfood2->move(jaeger, M_NOCHECK);
	        TO->remove();
	        return 1;
	}
}	


int flightcount() {
	flightint++;
}

int flight() {
	return flightint;
}


sag_int() {
	
	tell_room(ENV(TO), BSL("Adjint:     "+adjint+"\n"
	                       "AdjSting:   "+adj+"\n"
	                       "Groesse:    "+TO->QueryProp(P_SIZE)+"\n"
	                       "Gewicht:    "+TO->QueryProp(P_WEIGHT)+"\n"));
	return 1;
}