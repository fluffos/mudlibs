//fertig und getestet
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "ein Nektarzuengler");
  SetProp(P_LONG,
    "Der kleine rote Nektaruengler ist nur ca fingerlang. Geschaeftig schwirrt "
    "er auf der Such nach Nektar umher.");
  SetProp(P_NAME, "Nektarzuengler");
  SetProp(P_GENDER, MALE);
  AddId(({"nektarzuengler","zuengler","vogel"}));
 
  AD(({"suche","nektar"}),
    "Diese kleine Vogelart ernaehrt sich aehnlich wie der Kolibri nur von "
    "Nektar.");
    
  AD(("liebe"),
    "Ja liebst Du denn das putzige Voegelchen nicht? Nein sowas!");
    
  create_default_npc(7);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinen Fluegelchen", QueryProp(P_HANDS)[1],({DT_BLUDGEON})}));
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 15);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 15);
  SetProp(P_DIE_MSG, " faellt tot ins Wasser.\n");
  
  SetProp("vogel", 1);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Der Nektarzuengler braucht nur Nektar und Liebe.\n"}) );
     
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 10+random(10), 20, 20 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss14.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp (P_MSGIN, "flattert herein");
  SetProp (P_MSGOUT, "flattert");
  SetProp (P_MMSGIN, "flattert herein");
  SetProp (P_MMSGOUT, "flattert fort");
   
  AddInfo(DEFAULT_INFO, "beachtet Dich gar nicht.\n");
}
