//fertig und getestet
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine braungestreifte Napfschnecke");
  SetProp(P_LONG, BS(
    "Die braune Napfschnecke hat sich am nassen Fels festgesaugt und nuckelt "
    "zufrieden an einem Algenbueschel."));
  SetProp(P_NAME, "Napfschnecke");
  SetProp(P_GENDER,FEMALE);
  AddId(({"schnecke","napfschnecke"}));

  create_default_npc(2);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit ihrer Wehrlosigkeit", QueryProp(P_HANDS)[1],({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_HP, 10);
  SetProp(P_MAX_HP, 10);
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 10);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht herein");
  SetProp(P_MMSGOUT, "kriecht fort");

  SetProp(P_DIE_MSG,  " pickt nun zermalmt am Felsen.\n");

  AddInfo(DEFAULT_INFO, "ist ganz in ihre Alge vertieft.\n");
  AddInfo("dante", "Dante hat Kontakte zur Rumaenenmafia.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Schnecke beachtet Dich gar nicht.\n" }) );
}