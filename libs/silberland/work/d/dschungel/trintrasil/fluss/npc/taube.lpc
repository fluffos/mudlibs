//fertig.. im fluss jetzt nicht vorgesehen...
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "eine Ringeltaube");
  SetProp(P_LONG,
    "Die Ringeltaube ist schneeweiss, nur um den Hals hat sie einen dunklen "
    "Ring. Sie ruckt leicht mit dem Kopf als wollte sie Dir sagen: GIB MIR "
    "KRUUUEEEMMMMMMMMEEELL.");
    
  SetProp(P_NAME, "Ringeltaube");
  SetProp(P_GENDER, FEMALE);
  AddId(({"taube","ringeltaube"}));
 
  AD(({"kruemel","speise","lieblingsspeise"}),
    "Kruemel sind die Lieblingsspeise magischer Ringeltauben.");
    
  AD(("kopf"),
    "Der Kopf wippt staendig nach vor und zurueck als wuerde die Taube unter "
    "manischer Todessehnsucht leiden.");
    
  AD(({"sehnsucht","todessehnsucht","sucht"}),
    "Die Taube muss ihr Gehirn sehr hassen wenn sie es so schuettelt.");
    
  AD(("gehirn"),
    "Fuer das Gehirn ist das sicher nicht gesund.");
    
  AD(("hals"),
    "Um den Hals hat die Taube einen schmalen dunklen Ring. Darum heisst "
    "sie wahrscheinlich auch Ringeltaube.");
    
  AD(("ring"),
    "Wenn der Ring nicht viel zu schmal waere koennte man ihn fuer Wuergemale "
    "einer Anakonda halten.");
    
  AD(({"anakonda","male","wuergemale"}),
    "Diese arme, verzweifelte, geschundene Taube! Du solltest sie gleich "
    "toeten.");
    
  create_default_npc(5);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit ihrem Ring", QueryProp(P_HANDS)[1],({DT_BLUDGEON})}));
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 15);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 25);
  SetProp(P_DIE_MSG, " verkruemelt sich.\n");
  
  SetProp("vogel", 1);
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Die Taube bruellt: GIB MIR KRUEMEL!\n"}) );
     
  SetProp (P_MNPC_WAIT, ({ 10+random(10), 20, 20 }));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp (P_MSGIN, "flattert herein");
  SetProp (P_MSGOUT, "flattert");
  SetProp (P_MMSGIN, "flattert herein");
  SetProp (P_MMSGOUT, "flattert fort");
   
  AddInfo(DEFAULT_INFO, "wippt manisch mit dem Kopf.\n");
}
