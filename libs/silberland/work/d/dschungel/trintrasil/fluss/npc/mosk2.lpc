//fertig und getestet
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <npc.h>

//npc der flusszufallsereignisse (siehe /d/dschungel/trintrasil/fluss/stdriopuseta.c
//moskitoschwarm verfolgt spieler und muss von diesem erschlagen werden

int PreventFollow(object dest) {
		
	if( dest->QueryProp("begrenzungsraum_fpursuer")==1 ) {
		
		tell_room(ENV(TO), BS("Das Moskito hatte genug Blut und schwirrt davon."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", M_TPORT+ 
		M_SILENT);
		return 2;
	}
	
	if( file_name(dest)=="/room/death/death_room")  {
		
		tell_room(ENV(TO), BS("Das Moskito hatte genug Blut und schwirrt davon."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h", M_TPORT+ 
		M_SILENT);
		return 2;  
	}
	
	else {
		return 0;
	}
}


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein blutgieriges Moskito");
  SetProp(P_LONG,
    "Das Moskito kreist schwirrt surrend um Dich herum und lauert auf eine gute Gelegenheit "
    "Dein Blut auszusaugen.");
  SetProp(P_NAME, " Moskito");
  SetProp(P_GENDER, NEUTER);
  AddId(({"moskito","blutsauger"}));

  create_default_npc(5);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_RACE, "Insekt");
  SetProp(P_WEIGHT, 1);
  SetProp(P_SIZE, 1);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " faellt surrend ins Wasser.\n");
  SetProp(P_NOATTACK, "Fuer einen Kampf ist das Moskito viel zu klein!\n");
  SetProp(P_INFO, BS("Am besten wird man so einen unguten Quaelgeist los indem man ihn "
  "einfach erschlaegt."));
  
  SetProp (P_MSGIN, "surrt herein");
  SetProp (P_MSGOUT, "surrt leise");
  SetProp (P_MMSGIN, "surrt herein");
  SetProp (P_MMSGIN, "surrt schnell davon");
    
  SetProp("insekt", 1); //zur flussbewegung(siehe schlucht.c zeile223)
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Das Moskito interessiert sich nur fuer Blut.\n"}) );

AD(("gelegenheit"),
"Diese Moskitos sind unermuedlich. Du wirst erst dann wieder Ruhe haben wenn Du sie "
"alle erschlagen hast.");

AD(("ruhe"),
"Es gibt nur eine Moeglichkeit. Erschlage das Moskito!");

AD(("blut"),
"Dein Blut zieht diese Quaelgeister magisch an. Sie werden nicht eher aufhoeren Dich zu "
"stechen bis sie Dich vollkommen leer gesaugt haben.");  
  
  AddInfo(DEFAULT_INFO, "singt: !!BSSS BS BS BSSS!!.\n");
 

SetChats(15, ({
  	"\nSUMMMMSUMMMM\n",
  	"\nSIRRRSURRRSIRRR\n",
  	"\nBSSSSSBSSSS\n",
  	"\nSSSUUURRRRRBSSBSS\n",
  	"\nSSIIIIIRRRRSSIIIIIRRRR\n",
  	"\n!!SSSSS!!SSSSS!!\n",
  	"\nBBSSSSS!SUURRR!BBSSSSS!\n"}));
 
  
AddCmd(({"klatsche","zerklatsche","erschlage","zerdruecke"}), "fleck");

}


int fleck(string str) {
	
	notify_fail("Was willst Du erschlagen?\n");
	
	if(str=="moskito"||str=="stechmuecke"||str=="blutsauger"||str=="quaelgeist") {
		
		switch(random(8)) {
			
			case 0..2 :
			write(BSL("\n!!PATSCH!! Du triffst das Moskito genau zwischen "
			"die Augen. Den Quaelgeist bist Du fuer immer los."));
			say(BSL("\n"+TPN+" hat das Moskito genau zwischen den Augen getroffen! "
			"Es wird sicher niemanden mehr aergern."), TP);
			TO->remove();
			break;
			
			case 3 :
			write(BSL("\nDas Moskito weicht im letzen Moment aus!"));
			say(BSL("\n"+TPN+" versucht das Moskito zu erschlagen!"), TP);
			break;
			
			case 4 :
			write(BSL("\n!!!!BSSSSSSSSSSSSSSSSSS!!!!\n"
			"Das Moskito schlaegt gerade noch einen Hacken!"));
			say(BSL("\n"+TPN+" versucht das Moskito zu erschlagen!"), TP);
			break;
			
			case 5 :
			write(BSL("\nDas Moskito weicht surrend nach linkshintenoben aus!"));
			say(BSL("\n"+TPN+" fuchtelt hysterisch mit den Armen!"), TP);
			break;
			
			case 6 :
			write(BSL("\nDu fuchtelst wie ein Irrer herum, triffst aber nichts!"));
			say(BSL("\n"+TPN+" ist fuer das Moskito viel zu langsam!"), TP);          
			break;
			
			case 7:
			write(BSL("\nDer kleine Quaelgeist entschluepft Dir gerade noch durch "
			"die Finger."));
			say(BSL("\n"+TPN+" versucht ein Moskito zu erschlagen."), TP);
			break;
			
			default :
			write(BSL("\nHAHAHA! Du bist vielleicht ungeschickt!"));
			say(BSL("\n"+TPN+" versucht das Moskito zu erschlagen!"), TP);
			
			return 1;
		}
		return 1;
	}
	return 0;
}


blut(opfer) {
	
	call_out("blut1", 2+random(10), opfer);
}



blut1(opfer) {
	
	say(BSL("\nDas Moskito sticht "+opfer->name(WEN, 0)+"."), opfer);
	write(BSL("\nDas Moskito sticht Dich."));
	opfer->do_damage(1);
	call_out("blut1", 2+random(28), opfer);
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	player->RemovePursuer(TO);
}