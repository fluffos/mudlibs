// my first one.. im fluss noch nicht vorgesehen

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein weisses Seidenhuhn");
  SetProp(P_LONG, BS(
    "Das ist ein kleines weisses Seidenhuhn."));
  SetProp(P_NAME, "Seidenhuhn");
  SetProp(P_GENDER, NEUTER);
  AddId(({"seidenhuhn","huhn"}));

  create_default_npc(12);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel an", QueryProp(P_HANDS)[1],({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_DISABLE_ATTACK, 1);
  SetProp(P_HP, 60);
  SetProp(P_MAX_HP, 100);
  SetProp(P_SIZE, 90);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 40);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "gackert");
  SetProp(P_MMSGIN, "schwebt vom Himmel herab");
  SetProp(P_MMSGOUT, "verschwindet in einem Schwarzen Loch");

  SetProp(P_DIE_MSG,  " gackert ein letztes Mal.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "kreischt hysterisch: gagaaaaaaaaackagagack!!\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Glaubst Du ein Seidenhuhn kann irgendetwas damit anfangen ?\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(9,100,
    "Das Seidenhuhn wirbelt um Dich herum.\n",
    "Das Seidenhuhn wirbelt um @WEN herum.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,500,
    "Das Seidenhuhn peckt Dir beinahe das Auge aus.\n",
    "Das Seidenhuhn peckt @WEM beinahe das Auge aus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(7, ({
  "Das Seidenhuhn findet einen Wurm.\n",
  "Das Seidenhuhn scharrt nach Koerner.\n",
  "Gagaaaack\n",
  "Das Seidenhuhn plustert sein Gefieder auf.\n"}) );
  SetAttackChats(15, ({
  "Das Seidenhuhn bekommt einen Adrenalinschub.\n",
  "Das Seidenhuhn legt aus Aufregung ein Ei.\n"
  
  }) );
  

}

