//fertig und getestet
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{

 if (!is_clone(TO)) return; 
 
  ::create();

  SetProp(P_SHORT, "Ein riesiger Zitteraal");
  SetProp(P_LONG, BS(
    "Einmal angelockt laesst sich der Aal nicht mehr so schnell "
    "vertreiben. Hartnaeckig versucht das riesige Exemplar ein Stueck "
    "aus Deinem Bein zu reissen."));
  SetProp(P_NAME, "Zitteraal");
  SetProp(P_GENDER, MALE);
  AddId(({"zitteraal","aal","fisch"}));

  AddDetail(("exemplar"),
    "Zitteraale kommen im Suesswasser nur sehr selten vor. Sie sind aber "
    "sehr gefaehrlich und koennen so starke Stromschlaege erzeugen die auch "
    "Menschen gefaehrlich werden koennen.");
    
  AddDetail(({"salzwasser","wasser","suesswasser"}),
    "Die meisten Zitteraalarten leben im Salzwasser.");
    
  AddDetail(({"art","arten","zitteraalart","aalart","aalarten","zitteraalarten"}),
    "Du kennst Dich mit Zitteraalen nicht so gut aus. Und ausserdem ist dieser "
    "hier besonders laestig.");
    
  AddDetail(({"stromschlag","stromschlaege","schlag","schlaege"}),
    "Der Zitteraal laehmt seine Beute mit Stromschlaegen. Er kann damit auch "
    "Menschen gefaehrlich werden.");
    
  AD(("beute"),
    "Anscheinend haelt er Dich fuer eine brauchbare Beute.");
      
  create_default_npc(32);
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 150);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,random(4));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_HANDS, ({" mit einem Stromschlag", QueryProp(P_HANDS)[1], ({DT_ELECTRIC})})); 
  SetProp(P_WEIGHT, 15000);

  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "taucht unter");
  SetProp(P_MMSGIN, "taucht sprizend neben Dir auf");
  SetProp(P_MMSGOUT, "verschwindet in einem Schwarzen Loch");

  SetProp(P_DIE_MSG,  " versinkt im Fluss.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "ist kein grosser Diskutierer.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Aal kann nichts nehmen und so faellt Dein Gegenstand ins Wasser.\n" }) );

  SetProp(P_SPELLRATE,35);
  
  AddSpell(15,350,
    "Der Aal schlaegt auf Dich ein.\n",
    "Der Aal schlaegt auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,600,
    "!!Der Aal reisst eine tiefe Wunde in Dein Bein!!\n",
    "!!Der Aal reisst eine tiefe Wunde in @WESSEN Bein!!.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(15,400,
     "Der Aal verbeisst sich in Deinen Fuss.\n",
     "Der Aal verbeisst sich in  @WESSEN Fuss.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
   
  AddSpell(15,200,
     "!!!!!!BBBBBBZZZZZZZZZZZZZZZZZZZZZ!!!!!!!\nDer Aal paralysiert "
     "Dich mit einem Stromstoss.\n",
     "!!!!!!BBBBBBZZZZZZZZZZZZZZZZZZZZZ!!!!!!!\nDer Aal paralysiert "
     "@WEN mit einem Stromstoss.\n",
     DT_ELECTRIC, "paralyse");

}

void paralyse(object enemy, int damage, mixed dam_type) {
	
	if (!enemy->QueryProp(P_DISABLE_ATTACK)) {
		enemy->SetProp(P_DISABLE_ATTACK, 6+random(4));
	}
}
