//fertig
inherit "std/mnpc";
inherit "std/npc/sequencer";

#include <ansi.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

reset() {
	
	::reset();
	
	if( environment(TO) ) {
		tell_room(environment(TO), "Die Samenwolke zerstreut sich.\n");
		TO->remove();
	}
}


create() {
	
  if (!is_clone(TO)) return;
  
  ::create();
  
  call_out("reiz_func", 3+random(3));
  
  SetProp (P_SHORT, "Eine Samenwolke");
  SetProp (P_LONG, BS(
  "Die feinen roten Samen sind aus einer Schote des Piffpaffbusches geplatzt "
  "und werden langsam verweht."));
  SetProp (P_NAME, "Samenwolke");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Wolke");
  AddId (({"samenwolke","wolke","samen"}));
  
  create_default_npc (1);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp (P_SIZE, 200);
  SetProp (P_HEAL, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));   

  SetProp (P_MSGIN, "schwebt sanft herein");
  SetProp(P_MMSGIN, "platzt aus einer Piffpaffschote");   
  SetProp(P_MSGOUT,"schwebt sanft");
  SetProp(P_MMSGOUT, "schwebt weit weg");
  SetProp(P_MNPC_AREA, "/d/dschungel/trintrasil/" );
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_INDOORS+MOV_SPECIAL+
  MOV_BACKWARDS );
  SetProp(P_NOATTACK, "wirbelt durch die Luft.\n");

  SetProp (P_ALIGN, 20);
  SetProp(P_DIE_MSG, " wird zerblasen.\n");
  AddInfo(DEFAULT_INFO, "ist doch kein Lebewesen!\n");

SC(5,({
 "Die Samen reizen Deine Lunge.\n",
 "Du musst gereizt husten.\n",
 "Dir kratzt der Hals.\n",
 "Die Samenwolke wird etwas verweht.\n",
 "Feine Samen legen sich ueber Dein Gesicht.\n",
 "Die Samen ueberziehen alles mit einem feinen roten Schleier.\n",
 "Die Samen leuchten purpurrot im Sonnenlicht.\n",
 "Deine Augen beginnen unangenehm zu jucken.\n",
 "Die Samenwolke lichtet sich.\n",
 }));

}


reiz_func() {
	
	int i;
	object *inv;
	inv=all_inventory(environment(TO));
	
	call_out("reiz_func", 7+random(3));
	
	tell_room(environment(TO),
	BSL("\n!HUST! !HUST! Der feine Samenstaub reizt furchtbar Deine Atemwege!"));
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( (living(inv[i])) && (!inv[i]->id("samen")) ) {
			
			inv[i]->do_damage(2+random(3));
		}
		
		else {
			return 0;
		}
	}
}  
   
   