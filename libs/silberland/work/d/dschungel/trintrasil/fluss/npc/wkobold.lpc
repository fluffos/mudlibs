inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>


void create()
{
 
  ::create();
//2. braucht eine die(anzahl in smaragd und turm auf 0 setzen

  SetProp(P_SHORT, "Ein boesartiger Kobold");
  SetProp(P_LONG,
    "Der laestige Kobold sieht aus wie die Karrikatur eines haesslichen "
    "aufgeblaehten Kindes und beschimpft Dich das selbst eine Hafenhure "
    "in Tijara bleich werden wuerde. Er wurde von "+CAP(getuid(TP))+" vom "
    "Felsen geworfen und paddelt unbeholfen herum.");
  
  SetProp(P_NAME, "boesartiger Kobold");
  SetProp(P_GENDER, MALE);
  AddId(({"kobold"}));

  create_default_npc(12);
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -50);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " spuckt noch einmal nach Dir und geht unter.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
     "Der Kobold nimmt Deinen Gegenstand, verschluckt ihn und ruelpst Dir "
     "grinsend ins Gesicht."}) );
  
  SetProp (P_MSGIN,  "springt herein");
  SetProp (P_MSGOUT, "springt");
  SetProp (P_MMSGIN, "klatscht ins Wasser");
  SetProp (P_MMSGOUT,"kichert");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_SPECIAL);
  
  AD(("lappen"),
    "Die ledrigen Ohren sind fast so gross wie der restliche Kobold.");
    
  AD(({"geruch","gestank","fischgeruch","fischtangeruch","fischgestank"}),
    "Der kleine Quaelgeist stinkt fuerchterlich.");
    
  AD(("ohren"),
    "Mit diesen unfoermigen riesigen Lappen faechelt sich der Kobold frische "
    "Luft zu.");
    
  AD(("luft"),
    "Die kann der Kobold bei seinem Gestank auch brauchen.");
    
  AD(("koerper"),
    "Der kleine Koerper sieht aus wie der eines aufgeblaehten kleinen Kindes.");
   
  AD(("kopf"),
    "Der haessliche Kopf ist fuer den restlichen Koerper viel zu gross.");
    
  AD(("zunge"),
    "Dich wundert das diese Zunge in dem kleinen Kobold ueberhaupt Platz hat.");
    
  AD(("augen"),
    "Du fuerchtest schon das sie ihm aus dem Kopf springen koennten.");
    
  AD(("kind"),
    "Erinnert Dich irgendwie an klein "+TPN+".");
   
  AD(("karrikatur"),
    "Als waere der Kobold irr rollt er mit den Augen und streckt Dir die Zunge "
    "heraus.");
    
  AD(({"hafenhure","hure"}),
    "Der Kobold wuerde SICHER keine gute Hafenhure abgeben.");
    
  AD(("tijara"),
    "Besuchen und schweigen.");
    
  AddInfo(DEFAULT_INFO, "sagt:´Halt den Mund Du hast Mundgeruch!\n");

  SUID;
  CLONEME("/d/dschungel/trintrasil/fluss/obj/haferl.lpc");
  command("trage schuhe");
  
  SetChats(18,({
    BS("Der Kobold zieht Dich an den Haaren."),
    BS("Der Kobold spuckt Dich an."),
    BS("Du wuerdest den kleinen Quaelgeist am liebsten ersaeufen."),
    BS("Der Kobold rollt mit seinen uebergrossen Augen und ruelpst dabei."),
    BS("Der Kobold haucht Dir seinen schlechten Atem ins Gesicht."),
    BS("Der Kobold sagt:´ Na los Du Schleimbeutel, hilf mir wieder auf meinen "
       "schoenen Felsen zu klettern.´"),
    BS("Der Kobold versucht seine Unterlippe ueber seine Nase zu ziehen."),
    BS("Der Kobold wackelt mit den Ohren."),
    BS("Der Kobold macht Deinen Fisch nervoes."),
    BS("Der Kobold fragt:´ Glaubst Du das Du mit all Deinem Schrott schwimmen "
       "kannst?´ und verschreckt grinsend Deinen Fisch."),
    BS("Der Kobold gaehnt gelangweilt und zeigt Dir seine gelben Zaehne."),
    BS("Der Kobold sagt:´ Gib mir all Dein Geld oder Du wirst mich kennen "
       "lernen.´"),
    BS("Der Kobold sagt:´ Du bist ja noch fader als eine vertrocknete "
       "Schnecke.´"),
    BS("Der Kobold bohrt in der Nase und seufzt."),
    BS("Der Kobold sagt:´ Zeig mir mal Deinen Ausweis!´"),
    BS("Der Kobold lacht:´ Du siehst aus wie DJ-Amne!´"),
    BS("Der Kobold schreit:´ ZURUECK AUF MEINEN FELSEN HAB ICH GESAGT!!!´"),
    BS("Der Kobold beginnt so schrill zu kreischen das Dein Fisch nervoes zum "
       "Untertauchen ansetzt."),
    BS("Der Kobold stinkt ekelhaft nach vergammeltem Fisch."),
    BS("Der Kobold knurrt:´ Du Holzkopf, ich wuensch Dir lauter Bienen in "
       "Dein weiches Gehirn."),
    BS("Der Kobold droht mit der Faust und schreit:´ AUF MEINEN FELSEN HAB "
       "ICH GESAGT!!!´"), 
    BS("Der Kobold fummelt an Deiner Ausruestung herum."),
    BS("´Kommst Du Dir mit Deinem Kasperlgewand nicht laecherlich vor?´"),
    BS("Der Kobold lacht Dich gehaessig aus."),
    BS("Der Kobold sagt:´ Na warte, morgen erkennst Du Dich vor lauter Warzen "
       "nicht wieder!´"),
    BS("Der Kobold sagt:´ Na schon mal ein Prinzesschen gerettet Du "
       "Schiessbudenfigur?´"),
    BS("Der Kobold fragt:´ Darfst Du ueberhaupt schon alleine aus dem Haus gehen?´"),
    BS("Der Kobold fragt:´ Ist Dir klar das Du allen Grund hast mich zu "
       "fuerchten?´"),
    BS("Der Kobold warnt:´ Wenn Du nicht puenktlich zur Milch zu Hause bist "
       "schimpft Deine Mutter wieder.´"),
    BS("Der Kobold fragt:´ Bist Du ein Scheidungskind?´"),
    BS("Der Kobold fragt:´ Spielen wir Drache und dummer Held?´"),
    BS("Der Kobold fragt:´ Bekommst Du mit Deiner laecherlichen Kleidung "
       "manchmal ein Gratisbier?´"),
    BS("Der Kobold fragt:´ Spielen wir schwedischer Dante?´"),
    BS("Der Kobold sagt:´ Du wirst es noch bereuen mich ins Wasser geworfen "
       "zu haben!´"),
    BS("Der Kobold schreit:´ Wie lange soll Ich noch hier herumplantschen?!´") 
    }));

}
