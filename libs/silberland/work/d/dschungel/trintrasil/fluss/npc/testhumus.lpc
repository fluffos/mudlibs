
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Humuselementar");
  SetProp(P_LONG, BS(
    "Das ist eine verhurte unfertige Amoebe."));
  SetProp(P_NAME, "Humuselementar");
  SetProp(P_GENDER, NEUTER);
  AddId(({"elementar"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen Tentakeln", 70+random(50) ,({DT_BLUDGEON})}));
  SetProp(P_RACE, "Fisch");
  SetProp(P_HP, 250);
  SetProp(P_MAX_HP, 250);
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL, 8);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "schiesst unter dem Stein hervor");
  SetProp(P_MMSGOUT, "verglueht am Ereignishorizonz");

  SetProp(P_DIE_MSG,  " zittert ein letzes mal mit seinen "
                      " Tentakeln.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "Der Tintenfisch beaeugt Dich misstrauisch.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Tintenfisch weicht nervoes zurueck.\n" }) );

  SetProp(P_SPELLRATE,40);
  
  AddSpell(13,150,
    "Der Tintenfisch schlaegt Dich mit seinen Tentakeln.\n",
    "Der Aal schlaegt auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(13,140,
    "!!Der Tintenfisch umwickelt Dein Bein!!\n",
    "!!Der Tintenfisch umwickelt @WEMs Bein!!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(13,180,
     "!!Der Tintenfisch saugt sich an Deinem Bein fest!!\n",
     "!!Der Tintenfisch saugt sich an  @WEMs Bein fest!!\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
   
  AddSpell(4,60,     //erblindungsspell
     "!!!!!!BBBBBBZZZZZZZZZZZZZZZZZZZZZ!!!!!! \nDer Aal paralysiert "
     "Dich mit einem Stromstoss.\n",
     "!!!!!!BBBBBBZZZZZZZZZZZZZZZZZZZZZ!!!!!! \nDer Aal paralysiert "
     "@WEN mit einem Stromstoss.\n",
     DT_POISON, "paralyse");
     
     AddCmd("testmsg", "msg");

}


msg() {
	
	tell_object(TP, "Mein Schatten ist inaktiv.\n\n");
	return 1;
}

void paralyse(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 5+random(2));
}
