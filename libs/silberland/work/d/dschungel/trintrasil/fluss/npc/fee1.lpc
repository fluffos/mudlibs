//fertig und getestet.. defend bitte noch einmal anschauen ob heilung durch 
//damage_type water funktioniert

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#define FEEMASTER "/d/dschungel/trintrasil/fluss/feemaster.lpc"

void create()
{
  
  if (!is_clone(TO)) return;
  ::create();

enable_commands();
set_living_name("flussfee");

  SetProp(P_SHORT, "Eine Flussfee");
  SetProp(P_LONG,
    "Die kleine, zerbrechlich wirkende Fee sirrt unruhig mit ihren "
    "schimmernden Fluegeln. Sie schwebt unruhig auf und ab. Sie scheint nach "
    "Jemand Ausschau zu halten. Etwas scheint sie aufgeregt zu haben da "
    "sie nervoes blinkt.");
  SetProp(P_NAME, "Flussfee");
  SetProp(P_GENDER, FEMALE);
  AddId(({"flussfee","fee"}));

  create_default_npc(9);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit ihrer Magie", 80+random(50), (DT_WATER)}));
  SetProp(P_BODY, QueryProp(P_BODY) +20); //weil wendig ausweicht
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 38+random(5));
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -1-random(3) );
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY,25);
  SetProp(P_DIE_MSG, " zerfliesst in spritzende Wassertropfen.\n");
  SetProp(P_NOCORPSE, 1),
  SetProp(P_WEIGHT, 380+random(50));
  SetProp(P_RESISTANCE_STRENGTHS,([DT_FIRE: 1.0, DT_BLUDGEON: -0.3, DT_RIP: -0.3,
                                   DT_PIERCE: -0.3]));
  SetProp(P_REJECT, ({ REJECT_GIVE,"Die Fee lehnt dankend ab.\n"}) );
  SetProp(P_MMSGIN, "flattert aufgeregt herbei");
  SetProp(P_MMSGOUT, "flattert");
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert fort");
  SetProp("insekt", 1);


  AD(({"fluegel","feenfluegel"}),
    "Die feinen Feenfluegel schimmern blaeulich im Sonnenlicht.");
    
  AD(({"licht","sonnenlicht"}),
    "Die Fee schimmert unruhig in allen Blautoenen.");
    
  AD(({"etwas","jemand"}),
    "Anscheinend hat Jemand die kleine Fee angegriffen.");
    
  AD(("ausschau"),
    "Die Flussfee schwirrt unruhig auf und ab.");


SetAttackChats(15, ({
	"\nEine Fee beginnt zischend zu dampfen!\n\n",
	"\nEine Fee versprueht feine Wassertropfen!\n\n",
	"\nEine Fee gurgelt bedrohlich!\n\n",
	"\nEine Fee surrt zornig!\n\n",
	"\nEine Fee versprueht zornblaue Funken!\n\n",
	"\nEine Feeblinkt magischblau!\n\n",
	"\nEine Fee schwirrt surrend um Deinen Kopf!\n\n",
	"\nAus einer Fee spritzt leuchtendes Wasser!\n\n",
	"\nEine Fee weicht behende aus!\n\n",
	"\nEine Fee taucht flink unter Deinem Arm durch!\n\n",
	"\nEine Fee umkreist Dich wie eine leuchtende Kugel!\n\n",
	"\nEine Fee weicht summend aus!\n\n"}));
	
	    
  AddInfo(DEFAULT_INFO, ({"neigt nur fragend den Kopf.\n",
           "saeuselt: Ich kann Dir da leider nicht helfen.\n",
           "klatscht froehlich in die Haende\n",
           "singt leise vor sich hin.\n",
           "saeuselt: tralali tralalaa wie schoen ist doch das Feenleben.\n",
           "singt: Wie sind wir Feen doch lieb.\n",
           "laechelt mit ihren frischgeputzten Zaehnen.\n",
           "singt: Bluemchen und Voegelein, tralalaa.\n",
           "saeuselt: Frag doch unsere intelligente Schwester.\n"}));


//oooooooooooooooooooo EINTRAGEN IN FEENMASTER oooooooooooooooooooooooooooooooo

FEEMASTER->add_fee();

}


//ooooooooooooooooooooo AUSTRAGEN AUS FEENMASTER ooooooooooooooooooooooooooooooo

remove(int arg) {
	
	FEEMASTER->remove_fee(this_object());
        ::remove(arg);
}


//ooooooooooooooooooo FEE RUFT ANDERE FEEN ZUR HILFE oooooooooooooooooooooooooo

void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
object attacked_fee;
attacked_fee=TO;	
	
	FEEMASTER->ruf_um_hilfe(enemy);
	FEEMASTER->mastersupport(attacked_fee);
        ::Defend(dam, dam_type, spell, enemy);
        
        if (!pointerp(dam_type))
           dam_type = ({ dam_type });

           if (sizeof(dam_type & ({ DT_WATER }) )) {
           	tell_room(environment(TO), 
           	  BSL("\nDie Fee staerkt sich lachend durch den "
           	  "Wasserangriff.\n\n"));
           	heal_self(10+random(40));
        }
}


//oooooooooooooooooooooooo FEE HILFT ANDEREN FEEN ooooooooooooooooooooooooooooo
          
support(attacked_fee) {

        if(attacked_fee==TO) {
        
//fee soll sich nicht selber unterstuetzen	
        	return 1;
        }
        	
	if( find_call_out("support")!=-1 || find_call_out("support1")!=-1 ) {

//support laeuft schon, nicht noch einmal durchlaufen		
		return 1;
	}
	
	else {
		
		call_out("support1", 4+random(3), attacked_fee);
	}
	
}


support1(attacked_fee) { 

/*flussfee soll zu hilfe eilen wenn sie selber nicht im kampf ist, wenn 
ihre HP >> 30 sind (wimpy), und wenn die attacked_fee noch lebt
dazu wird gefragt ob sie im selben raum mit attacked_fee seht, wann ja dann
nur mit kurzer meldung an den raum angreifen, wenn nein dann zu 
attacked fee moven und dann mit kurzer meldung angreifen*/
        
  	if(!attacked_fee) {

//soll verhindern das support weiter laeuft wenn attacked_fee schon tot
  		return 1;
  	}
  	
    	if( TO->InFight() ) {

//fee ist bereits im kampf, weitere support unnoetig
//    		tell_room(environment(TO), BSL("\nIM INFIGHT\n\n"));  
    		return 1;
    	}
    	
    	if( TO->QueryProp(P_HP)<=TO->QueryProp(P_WIMPY) ) {

//wenn fee bereits gefluechtet nicht mehr zu hilfe eilen
//    		tell_room(environment(attacked_fee), "\nNo ENERGIE\n");
    		return 1;
    	}
    	
    	if(!TO->InFight() ) {
    		
    		if( environment(TO)==environment(attacked_fee) )  {

//fee neben attacked_fee und muss nicht erst kommen
    		        tell_room(environment(TO), BSL("\nEine Fee hilft "
    		        "ihrer Schwester!\n\n"));
//tell_room("/d/dschungel/trintrasil/fluss/room/fluss15", "\n!SAME ENV!\n");
    		}
    		
    	
    	        if( environment(TO)!=environment(attacked_fee) &&
    	        TO->QueryProp(P_HP)>TO->QueryProp(P_WIMPY) ) {

//fee muss erst zur attacked_fee hin und hat auch noch genuegend HP
                        tell_room(environment(TO), BSL("\n Die Fee eilt "
                        "schnell einer Schwester zur Hilfe!\n\n"));    	        	
    		        TO->move(environment(attacked_fee), 
    		        M_GO+ M_SILENT);
    		        tell_room(environment(TO), BSL("\nEine Fee eilt ihrer "
    		        "Schwester zur Hilfe!\n\n"));
//    		        tell_room(environment(attacked_fee), "\nGO TO "
//    		        ""+attacked_fee->name()+"");
    		}
    	}
}


feenanzahlimraum() {//mit der funktion wird vom master ermittelt wieviele feen
//sich bei der attackierten fee befinden. ist keine fee bei der attackierten 
//fee kreischt diese um hilfe (feemaster zeile 77)
	
	int i, menge;
        object *inv;
        menge=0;
        inv=all_inventory(ENV(TO));
   
        for(i=sizeof(inv)-1;i>=0;i--) {
        	
        	if(inv[i]->id("flussfee")) {
        		
        		menge++;
        	}
        }
return menge;}


  
    		