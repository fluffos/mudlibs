inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <mnpc.h>


void create()
{
//rejectfkt fuer objecte zurueck ins inv geben 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schnabeltier");
  SetProp(P_LONG,
    "Das schlanke braun, behaarte Schnabeltier schwimmt aufgeregt umher. "
    "Du staunst ueber die anmutige Kombination von Fell und Schnabel. "
    "Es sieht so aus als wuerde es sich bedroht fuehlen.");
  
  SetProp(P_NAME, "Schnabeltier");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schnabeltier","tier","NOWIMPY"}));

  create_default_npc(7);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_HANDS, ({" mit seinem Schnabel", QueryProp(P_HANDS)[1],({DT_RIP,DT_PIERCE})}));
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 60);
  SetProp(P_ALIGN, 50);
  SetProp(P_WIMPY, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_DIE_MSG, " geht stark blutend unter.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Das Schnabeltier gurrt Dich boese an."}) );
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/canyon.lpc");
  SetProp (P_MSGIN, "schwimmt herein");
  SetProp (P_MSGOUT, "schwimmt");
  SetProp (P_MMSGIN, "schiesst zornig aus einer kleinen Hoehle");
  SetProp (P_MMSGOUT, "taucht schnell unter");
  AddInfo(DEFAULT_INFO, "gurrt Dich boese an.\n");
 
  AD(("schnabel"),
   "Mit dem breiten Schnabel stoebert es in Sand am Grund des Flusses nach "
   "kleinen Beutetieren.");
   
  AD(({"tiere","beutetiere","nahrung"}),
   "Wahrscheinlich hauptsaechlich kleine Krebse, Schnecken und Wuermer.");
   
  AD(({"schnecken,","wuermer","krebse"}),
   "Am Grund des Flusses findet das Schnabeltier anscheinend genug.");
   
  AD(("kombination"),
   "das Schnabeltier ist das einzige Tier mit einem Schnabel und einem Fell.");
   
  AD(("fell"),
   "Wenn das Schnabeltier auftaucht perlt das Wasser von seinem glatten, "
   "glaenzenden Fell. Anscheinend hat besitzt das Fell eine schuetzende "
   "Wachsschicht.");
   
  AD(({"schicht","wachsschicht","wachs"}),
   "Das gewachste Fell stoesst Wasser ab und schuetzt das Schnabeltier vor Kaelte.");
   
}
