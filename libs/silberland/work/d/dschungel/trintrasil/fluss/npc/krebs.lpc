//fertig und getestet
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create() {
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Flusskrebs");
  SetProp(P_LONG,
    "Der baunschwarz gepanzerte Flusskrebs klappert nervoes mit seinen "
    "Scheren und beaeugt Dich misstrauisch mit seinen Stilaugen.");
  SetProp(P_NAME, "Flusskrebs");
  SetProp(P_GENDER, MALE);
  AddId(({"krebs","flusskrebs","cherry"}));

  create_default_npc(12);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinen Scheren", QueryProp(P_HANDS)[1], ({DT_RIP})}));
  SetProp(P_HEAL, 1+random(3));
  SetProp(P_WEIGHT, 500);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 15);
  SetProp(P_DIE_MSG, " treibt nun ruecklings auf der Wasseroberlfaeche.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
     "Der Krebs kann nichts nehmen und Dein Gegenstand faellt ins "
     "Wasser.\n"}) );
  
  SetProp (P_MMSGIN, "schiesst aus der Niesche hervor");
  SetProp (P_MMSGOUT, "schwimmt");
  SetProp (P_MSGIN, "schwimmt herein");
  SetProp (P_MSGOUT, "schwimmt");
  
  AD(({"schere","scheren"}),
    "Der Krebs oeffnet nervoes seine grossen Scheren und starrt Dich mit "
    "seinen Stilaugen an.");
    
  AD(({"stilaugen","augen"}),
    "Die Augen sehen wie kalte, schwarze Kugeln auf langen knoechernen "
    "Stilen aus.");
    
  AD(({"stile"}),
    "Der Krebs dreht die Augen langsam zu Dir.");
    
  AD(("kugeln"),
    "Du spiegelst Dich verzerrt in den kalten, schimmernden Kugeln.");
    
  AD(("panzer"),
    "Mit dem dunklen Panzer ist der Krebs unter Wasser sicher gut getarnt.");
    
  AddInfo(DEFAULT_INFO, "klappert misstrauisch mit den Scheren.\n");

 SUID;
 CLONEME("/d/dschungel/trintrasil/fluss/obj/schere.lpc");
 command("zuecke schere");
  
}
