//fertig und getestet
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


int brennwert, saettigung, adjint;
int flightint=0;
string adj;


reset() {//fisch verschwindet nach einiger zeit wieder
	
	::reset();
	
	if( ENV(TO)) {
		tell_room(ENV(TO),BS("Die Hundsbarbe taucht unter."));
		TO->move("/d/dschungel/trintrasil/hoehle/room/kontrollraum-h.lpc", M_GO+ 
		M_SILENT);
		TO->remove();
	}
}


void create() {

switch (random(7)) {
	
	case 0..1 : 
	adj = "jung";
	adjint=0; 
	break;
	
	case 2..3 : 
	adj = "ausgewachsen"; 
	adjint=1;
	break;
	
	case 4..5 : 
	adj = "gross"; 
	adjint=2;
	break;
	
	case 6 : 
	adj = "riesig";
	adjint=3; 
	break;
	
	default:
	adj = "ausgewachsen"; 
	adjint=1;
}

brennwert=10+3*adjint+random(4);
saettigung=2;

  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Hundsbarbe");
  SetProp(P_LONG, BS(
  "Die Hundsbarbe gleitet traege knapp unter der Wasseroberflaeche dahin. Auf "
  "ihrem schuppigen, braungruenen Ruecken trohnt die typische grosse "
  "Rueckenflosse, an der Du sie als Barbe erkennst. Wenn Du einen Fischspeer "
  "hast kannst Du den grossen Speisefisch jagen."));
  
  AD(({"essen","speisefisch"}),
  "Die Hundsbare ist "+TO->QuerProp(P_SIZE)+" lang und gaebe ein gutes Essen.");
  
  AD(({"oberflaeche","wasseroberflaeche"}),
  "Mit einem Fischspeer muesstest Du die Hundsbarbe erreichen koennen.");
  
  AD(({"speer","fischspeer"}),
  "Mit so einem leichten, duennen Speer koenntest Du die Hundsbarbe "
  "aus dem Wasser stechen.");
  
  AD(({"schuppen","ruecken"}),
  "Die braungruenen Schuppen der Hundsbarbe schimmern truebe im gruenen "
  "Wasser.");
  
  AD(({"flosse","rueckenflosse"}),
  "Diese hohe auffaellige Rueckenflosse ist fuer Barben charakteristisch.");
  
  SetProp(P_NAME, "Hundsbarbe");
  SetProp(P_GENDER, FEMALE);

  AddId(({"barbe","hundsbarbe","fisch","EFISCH"}));

  create_default_npc(6);
  
  SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
  SetProp(P_NAME_ADJ, ""+adj+"");
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 25+5*adjint);
  SetProp(P_WEIGHT, 200+100*adjint+random(100));
  SetProp(P_NOATTACK, "weicht blitzschnell aus. Du kannst Sie nur mit \n"
  "einem Fischspeer jagen.\n");
  SetProp(P_INFO, BS("Du koenntest die Hundsbarbe mit einem Fischspeer "
  "jagen."));  
  
  SetProp (P_MNPC_AREA "fluss");
  SetProp (P_MNPC_WAIT, ({ 15+random(8), 30, 25 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fluss/room/fluss3.lpc");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL+ MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "taucht unter");

  SetProp(P_DIE_MSG,  " stirbt zuckend.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "schwimmt ungestoert weiter.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Hundsbarbe schwimmt uninteressiert herum.\n" }) );

AddCmd(("fischkont"), "sag_int");
}


clone_food(jaeger) {
	
	int weight;
	object fishfood3;
	
	if( ENV(TO)!=ENV(TP) ) {
		
		TO->remove();
		return 1;
	}
	
	if( ENV(TO)==ENV(TP) ) {
		
		weight=this_object()->QueryProp(P_WEIGHT);
	        
	        fishfood3=CLONEOB("/d/dschungel/trintrasil/fluss/obj/fishfood3.lpc");
	        
	        fishfood3->
	        SetProp(P_FOOD_INFO, ([F_HEAL : ({brennwert,brennwert}), 
	        F_SOAK : 1,
	        F_MSG:"Vorsichtig nimmst Du die Hundsbarbe aus und isst ihr "
		"kraeftiges, rohes Fleisch.\n",
		F_MSG_ROOM:"isst eine rohe Hundsbarbe.\n"]));
	        fishfood3->SetProp(P_WEIGHT, weight);
	        fishfood3->move(jaeger, M_NOCHECK);
	        TO->remove();
	        return 1;
	}
}


int flightcount() {
	flightint++;
}

int flight() {
	return flightint;
}


sag_int() {
	
	tell_room(ENV(TO), BSL("Brennwert:  "+brennwert+"\n"
	                       "Saettigung: "+saettigung+"\n"
	                       "Adjint:     "+adjint+"\n"
	                       "AdjSting:   "+adj+"\n"
	                       "Groesse:    "+TO->QueryProp(P_SIZE)+"\n"
	                       "Gewicht:    "+TO->QueryProp(P_WEIGHT)+"\n"));
	return 1;         
}