#include <moving.h>
#include <properties.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

/*
Durch diesen Master eilen sich die Flussfeen (/d/dschungel/trintrasil/npc/fee) aus dem 
raum /d/dschungel/trintrasil/fluss/room/fluss13 gegenseitig zu hilfe, wenn sie mehr HP als
ihre Vorsicht haben.
Weiters rufen sie um hilfe, wenn:
1.) ueberhaupt noch andere flussfeen vorhanden sind.
2.) diese nicht ohnehin im gleichen raum sind.

um sicherzugehen, dass der master keine call_others an nicht mehr vorhandene, aber noch im
master eingetragene npcs verschickt, werden alle call_others mit einer catch durchgefuehrt.
tritt ein Fehler auf, wird das Ziel der gescheiterten call_other aus dem master ausgetragen
*/

object *fee;

  create() {
    
    if (is_clone(this_object())) {
    	 
    	 return 0;}
    
    fee = ({});
    
  }


 remove_fee() {
    
    fee -= ({ previous_object() });
      }
  
  
 add_fee() {
    
    fee += ({ previous_object() });
      }


ruf_um_hilfe(object spieler) {

/*Zeitverzoegerung ist notwendig damit die support vollstaendig ausgefuehrt ist
wenn der spieler als enemy eingetragen wird*/
	
	call_out("ruf_um_hilfe1", 7, spieler);
}

	
	
ruf_um_hilfe1(object spieler) {
	
	int u;
	object *f;
	f=fee;
	
	for (u=sizeof(f)-1;u>=0;u--) {
		
		if (catch(f[u]->InsertEnemy(spieler))) {
//			tell_room("/d/dschungel/trintrasil/fluss/room/fluss15",
//			"\n!CATCH INSERTENEMY!\n");
			fee -= ({ f[u] });
		}
	}
}
 
      
mastersupport(object attacked_fee) {
	
	int u, r;
	object *f;
	f=fee;
	r=sizeof(f);
//tell_room("/d/dschungel/trintrasil/fluss/room/fluss15", "\n!MASTER "
//""+attacked_fee->name()+"!\n\n");
	
	for (u=sizeof(f)-1;u>=0;u--) {
	
		if (catch(f[u]->support(attacked_fee))) {
//			tell_room(environment(attacked_fee), "\n!SUPPORTCATCH!\n\n");
			fee -= ({ f[u] });
		}
	}
	
	if(r>1 && attacked_fee->feenanzahlimraum()==1 ) {
		
		switch(random(7)) {
			
			case 1 : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt laut um Hilfe!\n\n"));
                        break;
               
			case 2 : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt: Hilfe! Moerder!\n\n"));
                        break;
                        
			case 3 : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt: Schwestern wo bleibt "
			"ihr!\n\n"));
                        break;

			case 4 : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt: Zu Hilfe! Ein ganz boeses "
			"Wesen!\n\n"));
                        break;
			
			case 5 : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt: Geliebte Schwestern! So helft "
			"mir doch!\n\n"));
                        break;
                        
			case 6 : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt: Oooh! Ein gar grausames Wesen "
			"will mich toeten!\n\n"));
                        break;
                                                                 
			case 0 : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt: Schwestern kommt her! Man "
			"will mich toeten!\n\n"));
                        break;            
      	                
      	                default : tell_room(environment(attacked_fee), 
			BSL("\nDie Fee kreischt: Schwestern kommt her! Man "
			"will mich toeten!\n\n"));
		}
	}
	
	if(r>1 && attacked_fee->feenanzahlimraum()==0) {
//		tell_room(environment(attacked_fee), BSL("\nMENGE=0!\n\n"));
	        return 0;
	}
	
		
	if(r<=1) {
//		tell_room(ENV(attacked_fee), "\nNO FEEN\n\n");
		return 0;
	}
	
	if(r>1 && attacked_fee->feenanzahlimraum()>1 ) {
//                tell_room(ENV(attacked_fee), "\nFEE PRESENT\n\n");
		return 0;
	} 
}

     	
	