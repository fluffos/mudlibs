inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <attributes.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define ROOM_MOMB "/d/dschungel/charon/dorfneu/room/momb"


string tfarbe, gender, tiergeist, attr_mod, hfarbe;

//tfarbe = farbe der tierzeichnung auf helm
//gender = geschlecht des tieres der tierzeichnung
//tiergeist = tier in zeichnung
//attr_mod kann sein Intelligenz, Ausdauer, Geschicklichkeit, Staerke oder nichts. Attribut 
//das durch den helm erhoeht wird
//hfarbe = helmfarbe;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  switch(random(4)) {
  	
  	case 0:
  	tfarbe = "rot";
  	break;
  	
  	case 1:
  	tfarbe = "gruen";
  	break;
  	
  	case 2:
  	tfarbe = "blau";
  	break;
  	
  	case 3:
  	tfarbe = "gelb";
  	break;
  	
  	default:
  	tfarbe = "rot";
}


switch(random(3)) {
	
