  SetProp(P_SHORT, "Ein "+hfarbe+" Kaimanhelm");
  SetProp(P_LONG, BSL(
    "Der Helm ist aus dem Schaedel eines Riesenkaimans gefertigt. Die Kieferknochen und "
    "Zaehne bilden den Wangenschutz, waehrend die Augen des Traegers tief hinter den "
    "Augenhoehlen des Kaimans liegen.\n"
    "In den Helm ist eine "+tfarbe+"en Tierzeichnung geritzt."));
    
  SetProp (P_NAME, "Kaimanhelm");
  SetProp (P_GENDER, MALE);
  AddId (({"helm", "kaimanhelm"}));

  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 14);
  SetProp (P_MATERIAL, MAT_BONE);
  SetProp (P_WEIGHT, 3000);
  SetProp (P_VALUE, 6000);
  SetProp (P_QUALITY_DECAY, 180);
  SetProp (P_DAM_PROTECTION, 
      QueryProp(P_DAM_PROTECTION)+([DT_SOUND:1, DT_TERROR:1, DT_AIR:1]) );
  
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2,T_HEAT_PROT:2]) );

ASD(({"schulter","schultern"}),
"schulter");

AD(({"kaimanschaedel","totenschaedel","schaedel","schaedelknochen"}),
"Der Helm ist aus einem steinharten Schaedelknochen eines Riesenkaimans gefertigt. "
"Der polierte Schaedel glaenzt weiss im Licht.");

AD(({"licht","knochen"}),
"Die Totenschaedel scheint lauernd zu grinsen.");

AD(({"kaiman","riesenkaiman"}),
"Riesenkaimane leben in den Suempfen des Rio de la Puseta. Sie sind gefuerchtete Jaeger.");

AD(({"dschungel","ufer","rio","fluss","rio de la puseta"}),
"Der Rio de la Puseta ist der groesste Fluss im Dschungel.");

AD(({"sumpf","suempfe","schilf","schilfguertel"}),
"Die Riesenkaimane jagen vorwiegen in den weiten, sumpfigen Schilfguerteln des "
"Flusses.");

AD(("jaeger"),
"Hungrige Riesenkaimane sind gnadenlose Jaeger.");

AD(({"gesichtsschutz","schutz","wangenschutz","visier"}),
"Der Wangenschutz wurde aus den Kieferknochen gefertigt und verbirgt "
"das Gesicht wie ein Visier hinter den dichten Reihen der Kaimanzaehne. "
"Mit einem schwarzen Lederriemen kann man den Helm fest binden.");

AD(({"augenhoehlen","augen"}),
"Die Augen des Traegers liegen hinter den Augenhoehlen des Schaedels verborgen.");

AD(({"kieferknochen","kiefer"}),
"Die Kieferknochen sind mit dichten, spitzen Zahnreihen besetzt.");

AD(("gesicht"),
"Das Gesicht des Traegers wird vom zaehnestarrenden Wangenschutz geschuetzt.");

AD(({"riemen","lederriemen"}),
"Mit dem Lederriemen kann man den Helm unter dem Kinn fest binden.");

AD(({"kopf","kinn"}),
"Der Helm sitzt wie angegossen und fest auf Deinem Kopf.");

ASD(({"zaehne","reihen","zahnreihen","zahn"}),
"zaehne");

AD(("kaimanzaehne"),
"Die Kaimanzaehne sind ca 10 Zentimeter lang und schuetzen die untere Gesichtshaelfte.");

AD(({"stirn","haelfte","gesichtshaelfte","obere gesichtshaelfte","obere haelfte",
"untere haelfte","untere gesichtshaelfte"}),
"Die Augen und Stirn des Traegers sind durch den Schaedel geschuetzt. Die untere "
"Gesichtshaelfte wird von einem Visier aus Kieferknochen und Zaehnen bedeckt.");

AD(("kannibalen"),
"Die Kannibalen stellen solche Helme her. Sie sind sehr kostbar und selten.");

ASD(({"backenzaehne","anakondazaehne","zahnanakondazaehne"}),
"azaehne");

AD(({"wurm","sandwurm","wuermer","sandwuermer"}),
"Die Sandwuermer leben im Dschungel. Manchmal tauchen sie an sandigen Stellen am Rio "
"de la Puseta auf.");

AD(({"stelle","stellen"}),
"Die Wuermer jagen manchmal am sandigen Ufer des Rio de la Puseta nach Beute.");

AD(("beute"),
"Sandwuermer fressen alles was gross genug ist.");

AD(({"stelle","stellen"}),
"Niemand weiss genau wie diese riesigen Wuermer leben. Sie haben unterschiedliche "
"Farben, wobei die groessten bis zu 8 Meter lang werden und rostrot sind.");

AD(({"farbe","faerbung","farben","sandwurmfarbe"}),
"Die kleinsten, mindestens 2 Meter langen Wuermer sind sandgelb. Die groesseren "
"Sandwuermer sind dann steinweiss, staubgrau und rostrot.");

AD(({"art","anakondaart","zahnanakonda","anakonda"}),
"Die bis zu 9 Meter lange Schlange toetet ihre Opfer meistens durch Erdruecken. Die "
"Zahnanakonda hat als einzige Anakondaart auch lange Backenzaehne.");

AD(({"naehe","opfer","erdruecken","schlange"}),
"Die Zahnanakonda ist im Dschungel in der Naehe des Rio de la Puseta heimisch.");

ASD(({"oberseite","seite","horn","hoerner"}),
"seite");

ASD(({"haut","sandwurmhaut"}),
"haut");

ASD(({""+tiergeist+"","zeichnung","tierzeichnung"}),
"zeichnung");

ASD(({"schutzgeist","geist","tiergeist","aberglaube"}),
"schutzgeist");
}


_query_short() {
	
	if(hfarbe=="einfach") {
		
		return("Ein Kaimanhelm");
	}
	
	else {
		return("Ein "+hfarbe+"er Kaimanhelm");
	}
}

		
_query_long() {
	
	if(hfarbe=="einfach") {
		
		if(!TO->QueryProp("gezahnt")) {
			
			return(BSL("Der Helm ist aus dem Schaedel eines Riesenkaimans "
			"gefertigt. Die Kieferknochen und Zaehne bilden den Wangenschutz, "
			"waehrend die Augen tief hinter den Augenhoehlen des Kaimans "
			"liegen.\nIn den Helm ist eine "+tfarbe+"e Tierzeichnung geritzt."));
		}
		
		else {
			return(BSL("Der Helm ist aus dem Schaedel eines Riesenkaimans "
			"gefertigt. Die Kieferknochen und Zaehne bilden den Wangenschutz, "
			"waehrend die Augen tief hinter den Augenhoehlen des Kaimans "
			"liegen.\nAuf seiner Oberseite befinden sich zwei spitze "
			"Anakondazaehne.\nIn den Helm ist eine "+tfarbe+"e Tierzeichnung "
			"geritzt."));
		}
	}
	
	else {
		if(!TO->QueryProp("gezahnt")) {
			
			return(BSL("Der Helm ist aus dem Schaedel eines Riesenkaimans "
			"gefertigt. Die Kieferknochen und Zaehne bilden den Wangenschutz, "
			"waehrend die Augen tief hinter den Augenhoehlen des Kaimans "
			"liegen.\nDer Helm ist mit einer "+hfarbe+" schimmernden Wurmhaut "
			"ausgekleidet, die bis auf die Schultern reicht.\nIn den Helm ist "
			"eine "+tfarbe+"e Tierzeichnung geritzt."));
		}
		
		else {
			return(BSL("Der Helm ist aus dem Schaedel eines Riesenkaimans "
			"gefertigt. Die Kieferknochen und Zaehne bilden den Wangenschutz, "
			"waehrend die Augen tief hinter den Augenhoehlen des Kaimans "
			"liegen.\nDer Helm ist mit einer "+hfarbe+" schimmernden Wurmhaut "
			"ausgekleidet, die bis auf die Schultern reicht.\nAuf seiner Oberseite "
			"befinden sich zwei spitze Anakondazaehne.\nIn den Helm ist "
			"eine "+tfarbe+"e Tierzeichnung geritzt."));
		}
	}
}


seite() {
	
	if(TO->QueryProp("gezahnt")) {
		
		return(BS("Die Anakondazaehne wirken fast wie kleine Hoerner. Sie sind "
		"aber nicht so stark gebogen und spitzer."));
	}
	
	else {
		return(BS("Was soll mit der Oberseite sein?"));
	}
}


schutzgeist() {
	
	return(BS("Vielleicht ist es ja nur Aberglaube, aber die Kannibalen sagen, dass "
	"so der Schutzgeist dem Helmtraeger gewogen ist."));
}

	
schulter() {

	if(hfarbe=="einfach") {
		
		return(BS("Welche Haut meinst Du? Das ist ein einfacher Kaimanhelm."));
	}
	
	else {
		return(BS("Die Sandwurmhaut liegt geschmeidig auf Deinen Schultern auf "
		"und bietet so zusaetzlichen Schutz."));
	}
}
	
	
zaehne() {
	
	if(TO->QueryProp("gezahnt")) {
		
		return(BS("Welche Zaehne meinst Du? Die Kaimanzaehne die das Visier bilden "
		"oder die Anakondazaehne auf dem Helm?"));
	}
	
	else {
		
		return(BS("Die Kaimanzaehne sind ca 10 Zentimeter lang und schuetzen die "
		"untere Gesichtshaelfte."));
	}
}


haut() {
	
	if(hfarbe=="einfach") {
		
		return(BS("Welche Haut meinst Du? Das ist ein einfacher Kaimanhelm."));
	}
	
	else {
		return(BS("Der Helm ist mit einer "+hfarbe+" Sandwurmhaut ausgekleidet. "
		"Die geschmeidige aber feste Haut reicht bis auf die Schultern hinab."));
	}
}


azaehne() {
	
	if(TO->QueryProp("gezahnt")) {
		
		if(TP->QueryProp(P_GUILD)=="Berserker") {
			
			return(BS("Auf der Oberseite des Helms befinden sich zwei lange, "
			"spitze Zaehne einer Zahnanakonda. Sie sind ca 20 Zentimeter lang "
			"und leicht gebogen. Sie reissen sicher tiefe Wunden wenn man mit "
			"diesem Helm im Kampf einen Kopfstoss ausfuehrt."));
		}
		
		else {
			
			return(BS("Auf der Oberseite des Helms befinden sich zwei lange, "
			"spitze Zaehne einer Zahnanakonda. Sie sind ca 20 Zentimeter lang "
			"und leicht gebogen."));
		}
	}
	
	else {
		
		return(BS("Welche Anakondazaehne meinst Du? Auf diesem Kaimanhelm befinden "
		"sich keine."));
	}
}

	
zeichnung() {
	
	if(gender=="FEMALE") {
		
		return(BS("In den Helm ist eine "+tfarbe+"e "+tiergeist+" geritzt. Dieser "
		"Tiergeist soll den Traeger dieses Helmes beschuetzen."));
	}
	
	if(gender=="MALE") {
		
		return(BS("In den Helm ist ein "+tfarbe+"er "+tiergeist+" geritzt. Dieser "
		"Tiergeist soll den Traeger dieses Helmes beschuetzen."));
	}
	
	if(gender=="NEUTER") {
		
		return(BS("In den Helm ist ein "+tfarbe+"es "+tiergeist+" geritzt. Dieser "
		"Tiergeist soll den Traeger dieses Helmes beschuetzen."));
	}
}



counter() {
	
	call_out("helm_fertig", 20);//die zeit die der spieler auf den helm wartet (20 h noch setzen)
}


helm_fertig() {//verwendet von cmd hole in /d/dschungel/trintrasil/dorfneu/npc/mombassa beim abholen des helmes
	
	TO->SetProp("zu_uebergeben", 1);
}


helm_faerbung(string helm_farbe) {
	
	hfarbe=helm_farbe;//aufgerufen aus mombassa (funktion khelm_func() ) setzt die herlmfarbe aus der wurmhaut
}