init(string plname, snakevictim) {
	
	snakevictim = this_player()->name(WER);
	plname = this_player()->name(WESSEN);
	
	::init();
	
	if( !query_once_interactive(this_player()) || 
	(query_once_interactive(this_player()) && 
	(this_player()->QueryProp("climber") || 
	this_player()->QueryProp("downclimber")) ) ) {
		
		//damit spieler die sich vom felsturm abseilen und gar 
		//nicht auf einem fisch sitzen nicht flussevents bekommen 
		//(siehe /d/dschungel/trintrasil/fluss/room/fluss13
        	
        	return 0;
        }
        
        if( query_once_interactive(this_player()) && 
        !this_player()->QueryProp("climber") && 
        !this_player()->QueryProp("downclimber") ) {
        	
        	switch (random(280)) {
        		
        		object apfel;
        		object egel;
        		object taucher;
        		
        		case 0..1://ein schwarm piranhas greift den spieler an
        		NIX
        		write(BSL(""+ANSI_RED+"Um Deinen Fisch beginnt "
        		"sich das Wasser seltsam zu bewegen!!"
        		""+ANSI_NORMAL+"\n\n"));
        		say(BSL("\n"+ANSI_RED+"Das Wasser um "+TPN+" "
        		"beginnt sich seltsam zu bewegen!!"+ANSI_NORMAL"\n\n"));
        		call_out("event1a", 2);
        		break;
        		
        		case 2..3://ein einzelner piranha greift den spieler an
        		NIX
        		write(BSL(""+ANSI_RED+"Um Deinen Fisch beginnt sich das Wasser "
        		"seltsam zu bewegen!!"+ANSI_NORMAL+"\n\n"));
        		say(BS("\n"+ANSI_RED+"Das Wasser um "+TPN+" beginnt sich seltsam zu "
        		"bewegen!!"+ANSI_NORMAL"\n\n"));
        		call_out("event2a", 2);
        		break;
        		
        		case 4..5://ein blutegel saugt sich am spieler fest
        		write(BSL("Du spuerst kurz einen Biss!!! Du solltest nachsehen, "
        		"vielleicht hat Dich ein Blutegel gebissen.\n"));
        		egel=CLONEOB("/d/dschungel/trintrasil/fluss/obj/egel");
        		egel->move(TP, M_NOCHECK);
        		break;
        		
        		case 6..7://der spieler findet einen flussapfel
        		write(BSL(""+ANSI_RED+"Ein reifer Flussapfel treibt an Dir vorbei!\n"
        		""+ANSI_NORMAL+"Du greifst schnell zu und kannst den Apfel "
        		"gerade noch erwischen. Schnell steckst Du ihn ein.\n"));
        		say(BSL(""+TPN+" fischt einen Flussapfel aus dem Wasser und steckt "
        		"ihn ein.\n"));
        		apfel=CLONEOB("/d/dschungel/trintrasil/fluss/obj/apfel");
        		apfel->move(TP, M_NOCHECK);
        		break;
        		
        		case 8..9://der spieler entdeckt einen nervig bunten haubentaucher
        		write(BSL("Ploetzlich taucht direkt vor Dir ein Haubentaucher auf!! "
        		"Dein Fisch kann gerade noch ausweichen.\n\n"));
        		say(BSL("\nVor dem Fisch von "+TPN+" taucht ploetzlich ein "
        		"Haubentaucher auf.\n\n"));
        		taucher=CLONEOB("/d/dschungel/trintrasil/fluss/npc/haubentaucher");
        		taucher->move(environment(TP), M_TPORT+ M_SILENT);
        		break;
        		
        		case 10://eine wasserschlange umschlingt den fisch des spielers. der
        		NIX    // spieler ist so lange bewegungsunfaehig bis sie getoetet ist
        		write(BSL("Du nimmst unter Deinem Fisch eine eigenartige schlaengelnde "
        		"Bewegung wahr!\n\n"));
        		say(BSL("\nDu siehst unter dem Fisch von "+TPN+" eine eigenartige "
        		"schlaengelnde \nBewegung!\n\n"));
        		call_out("event6a", 1, snakevictim, plname);
        		break;
        		
        		case 11..12://der spieler entdeckt einen fisch den er mit dem 
        		NIX         //fischspeer jagen kann
        		write(BSL("Du entdeckst einen Fisch ganz knapp unter der "
        		"Wasseroberflaeche ganz in Deiner Naehe.\n\n"));
        		say(BSL("\nDu entdeckst einen Fisch ganz knapp unter der "
        		"Wasseroberflaeche ganz in Deiner Naehe.\n\n"));
        		
        		switch(random(13)) {
        			
        			object fisch1, fisch2, fisch3, fisch4, fisch5;
        			
        			case 0..2:
        			fisch1=CLONEOB("/d/dschungel/trintrasil/fluss/npc/efisch1");
        			fisch1->move(ENV(TP), M_GO+ M_SILENT);
        			break;
        			
        			case 3..5:
        			fisch2=CLONEOB("/d/dschungel/trintrasil/fluss/npc/efisch2");
        			fisch2->move(ENV(TP), M_GO+ M_SILENT);
        			break;
        			
        			case 6..8:
        			fisch3=CLONEOB("/d/dschungel/trintrasil/fluss/npc/efisch3");
        			fisch3->move(ENV(TP), M_GO+ M_SILENT);
        			break;
        			
        			case 9..11:
        			fisch4=CLONEOB("/d/dschungel/trintrasil/fluss/npc/efisch4");
        			fisch4->move(ENV(TP), M_GO+ M_SILENT);
        			break;
        			
        			case 12:
        			fisch5=CLONEOB("/d/dschungel/trintrasil/fluss/npc/efisch5");
        			fisch5->move(ENV(TP), M_GO+ M_SILENT);
        			break;
        			
        			default:
        			fisch1=CLONEOB("/d/dschungel/trintrasil/fluss/npc/efisch1");
        			fisch1->move(ENV(TP), M_GO+ M_SILENT);
        		}
        		break;
        		
        		case 13/*..128*/://ein moskitoschwarm greift den spieler an
        		tell_room(ENV(TP), BSL("\nDu hoerst ein eigenartiges, naeherkommendes "
        		"Surren!\n\n"));
        		call_out("event7a", 3);
        		break;
        		
        		case 14..279: 
        		break;
        	}
        }
}



event1a() {
	
	object piranha;
	
	NIX
	write(BSL("\nPIRANHAS GREIFEN DICH AN!!"));
	say(BSL("\nPIRANHAS GREIFEN "+TPN+" AN!!"));
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
}



event2a() {
	
	object piranha;
	
	NIX
	write(BSL("\nEIN PIRANHA GREIFT DICH AN!!"));
	say(BSL("\nEIN PIRANHA GREIFT "+TPN+" AN!!"));
	piranha=CLONEOB("/d/dschungel/trintrasil/fluss/npc/piranha.lpc");
	piranha->move(environment(TP), M_TPORT );
	piranha->Kill(TP);
}



event6a(string snakevictim, plname) {
	
	object schlange;
	
	schlange=CLONEOB("/d/dschungel/trintrasil/fluss/npc/wschlange");
	schlange->move(environment(TP), M_TPORT +M_SILENT);
	schlange->SetProp(""+snakevictim+"", 1);
	
	write(BSL("\nPloetzlich taucht unter Dir eine Wasserschlange hoch und "
        "umschlingt Deinen Fisch! Erschrocken versucht Dein Fisch die "
        "Schlange zu beissen."));
        say(BSL("\nUnter dem Fisch von "+TPN+" taucht eine Wasserschlange hoch und "
        "umschlingt "+plname+" Fisch!"));
}



event7a() {
	
	object moskito, opfer;
	
	opfer=this_player();
	
	write(BSL("\nEin Schwarm Moskitos beginnt Dich blutgierig zu umkreisen.\n"));
	say(BSL("\nEin Schwarm Moskitos beginnt "+TPN+" zu umkreisen.\n"));
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
	
	moskito=CLONEOB("/d/dschungel/trintrasil/fluss/npc/mosk2");
	moskito->move(ENV(TP), M_GO+ M_SILENT);
	moskito->blut(opfer);
	opfer->AddPursuer(moskito);
} 
