#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
inherit "/std/room";


void jagdgebiet() {//definiert ob in diesem raum mit dem fischspeer gejagt werden kann

	SetProp("riopuseta", 1);
	AddCmd(("beherrsche"), "prevent_elementar");
//	AddCmd(("zaubere"), "prevent_undead_magic");
	AddCmd(("drider"), "no_spiders_wanted");
}

no_spiders_wanted() {
	
	if( TP->QueryProp(P_GUILD)!="dunkelelfen" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst einen Drider zu rufen, kannst Dich aber "
		"auf dem schwankenden Ruecken des Fisches nicht konzentrieren."));
		return 1;
	}
}

/*
prevent_undead_magic(string str) {//leichen versinken ohnehin sofort im Fluss
	
	if( TP->QueryProp(P_GUILD)!="nekromanten" ) {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Deine dunklen Kraefte zu buendeln, kannst "
		"Dich aber auf dem schwankenden Fisch nicht konzentrieren."));
		return 1;
	}
}
*/

prevent_elementar(string str) {
	
	if( TP->QueryProp(P_GUILD)!="druiden" || str!="eiselementar"||str!="feuerelementar"||
	str!="eiselementar"||str!="wasserelementar"||str!="humuselementar") {
		
		return 0;
	}
	
	else {
		tell_object(TP, BSL("Du versuchst Dich auf die Beherrschung zu konzentrieren, "
		"findest aber auf dem schwankenden Ruecken des Fisches nicht die notwendige "
		"Ruhe."));
		return 1;
	}
}


//oooooooooooooooooooooooooooo STDDETAILS oooooooooooooooooooooooooooooooooooooooo

void fluss_details() {//stddetails fuer raeume des rio puseta in der schlucht 

AD(({"felswaende","schluchtwaende","uferwaende","waende","sandsteinwaende"}),
"Die gewaltigen Schluchtwaende sind aus gelben Sandstein und schimmern in einem sanften, "
"warmen Gelb.");

AD(({"sandstein","stein","gelb"}),
"Der gelbe Sandstein wurde von Wind und Wasser ganz glatt poliert.");

AD(("wind"),
"Der Wind zieht staendig durch die Schlucht.");

AD(("wasser"),
"Das Wasser des Rio de la Puseta hat die Schlucht in den Sandstein gegraben.");

AD(("schlucht"),
"Die gewaltigen, gelben Sandsteinwaende der Schlucht fassen den gruene Fluss ein.");
 
ASD("fisch",
  "fischdetail");

}


void dschungelfluss_details() {//stddetails fuer raeume des rio puseta im dschungel

AD(({"felswaende","schluchtwaende","uferwaende","waende","sandsteinwaende"}),
"Der Rio de la Puseta windet sich hier durch den Dschungel.");

AD(({"sandstein","stein","gelb"}),
"Du siehst hier nur gruen wuchernden Dschungel. Welchen sandstein meinst Du?");

AD(("wind"),
"Die heisse Luft steht nahezu bewegungslos ueber dem Wasser.");

AD(("wasser"),
"Das Wasser des Rio de la Puseta ist hier dunkelgruen und fliesst traege dahin.");

AD(("schlucht"),
"Der Fluss fliesst hier durch den Dschungel. Hier ist keine Schlucht.");
 
ASD("fisch",
  "fischdetail");

}	


fischdetail() {
	
	int i, moveint;
        object *inv;
        inv=all_inventory(environment(this_player()));

     	if( present("wasserschlange", environment(this_player())) ) {

     		for(i=sizeof(inv)-1;i>=0;i--) {

                        if( inv[i]->id("EVENTSCHLANGE") ) {

                                if( inv[i]->QueryProp(""+this_player()->name()+"") ) {
                                	moveint++;
                                }
                        }
                        if( !inv[i]->id("EVENTSCHLANGE") ||
                        (inv[i]->id("EVENTSCHLANGE") && !inv[i]->QueryProp(""+this_player()->name()+"")) ) {

                        }
                }
                
                if(moveint>0) {
                	return BS("Dein Fisch kaempft verbissen mit einer "
                	"Wasserschlange Du solltest sie toeten bevor Du vom "
                	"Fisch faellst.");
                }
                
                if(moveint==0) {
                	return BS("Du reitest auf Deinem Fisch zuverlaessig und "
                	"schnell ueber dem Wasser.");
                }
                moveint=0;
         return 1;}

         if( !present("wasserschlange", environment(this_player())) ) {
         	return BS("Du reitest auf Deinem Fisch zuverlaessig und schnell "
         	"ueber dem Wasser.");
        return 1;}
return 1;}



