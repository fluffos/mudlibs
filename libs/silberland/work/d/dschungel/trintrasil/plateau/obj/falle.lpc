//invisible fallschlinge
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


object gehaengte;


create() {
	
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"fall_sch"}));
   SetProp(P_NAME, "Falle");
   SetProp(P_SHORT, 0);
   SetProp( P_GENDER , FEMALE );
   SetProp(P_NOGET, 1);   
   SetProp(P_MATERIAL,MAT_STONE);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,1000000000000000000000000000000000000000000000);
   SetProp("fallen_status", 0);
}


victim_name() {
	
	string nam;
	
	nam=gehaengte->name();
	
	return nam;
}


set_victim(victim) {
	
	gehaengte=victim;
}


who_is_victim() {
	
	return gehaengte;
}