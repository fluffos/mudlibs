//wasser
//einbruch

inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <ansi.h>


int luecke=0;


reset() {//soll sicherstellen, dass der raum nicht resetet wird, wenn ein spieler anwesend ist..
	
	int i, players_present;
        object *inv;
        
        inv=all_inventory(TO);
        players_present=0;
        
        for(i=sizeof(inv)-1;i>=0;i--) {
        	
        	if( interactive(inv[i]) ) {
        		
        		players_present++;
        	}
        	
        	else {
        		
        	}
        }
        
        if( players_present>=1 ) { 
        	return 0;
        }
        
        if( players_present==0 ) {
        	
        	luecke=0;
        	::reset();
        }
}


create() { 

  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Auf einer Bruecke" );
  SetProp( P_INT_LONG, BSL(
  "Die Bruecke schwankt und knarrt als Du sie betrittst. Sie wurde sicher schon lange nicht "
  "mehr benutzt. Sie ist ca. 10 meter lang und fuehrt ueber den rauschenden Zehn Ochsen. "
  "Teilweise fehlen schon die modrigen Bodenbretter und das Gelaender.\nNach Norden und "
  "Sueden kommst Du auf einen verwachsenen Pfad in den Dschungel. Der Zehn Ochsen "
  "donnert im Westen ueber den Rand in die tiefe Schlucht des Rio de la Puseta.")); 

AD(({"pfad","weg","trampelpfad","dschungelpfad"}),
"Der Weg fuehrt nach Norden und Sueden in den duesteren, dichten Dschungel. Er ist schon sehr "
"verwachsen.");

AD(("dschungel"),
"Der Dschungel beginnt sofort vor und hinter der Bruecke und waechst sehr dicht. Der Pfad "
"sieht nicht sehr haeufig benutzt aus. Aber der Schein kann truegen.");

AD(("schein"),
"Vielleicht will der Aufsteller der Fallen, dass der Dschungel hier so verlassen aussieht.");

AD(({"fallensteller","aufsteller"}),
"Vielleicht sind es ja mehrere Personen die die Gegend hier mit Fallen vermint haben.");

AD(("personen"),
"Vielleicht findest Du noch mehrere Hinweise. Wenn die heimtueckischen Fallen hier nicht "
"waeren koennte man glauben die Gegend hier waere vollkommen verlassen.");

AD(("gegend"),
"Ausser den Fallen gibt es keinerlei Spuren.");

AD(({"spuren","hinweise"}),
"Vielleicht findest Du noch Hinweise auf den Fallensteller.");

AD(({"falle","fallen"}),
"Eine Falle kommt selten alleine. Sei darauf gefasst, dass hier noch mehr Fallen sind.");
   
AD(({"holzbruecke","bruecke"}),
"Die Bruecke ist aus mit Seilen verbundenen Staemmen gebaut. Das Gelaender ist teilweise "
"gebrochen und einige Bodenbretter fehlen.");

AD(({"brueckengelaender","gelaender"}),
"Das morsche Gelaender fehlt teilweise.");

AD(("seile"),
"Die einzelnen Staemme sind mit Seilen verbunden. Die meisten Seile scheinen ziemlich "
"alt zu sein. Manche Verbindungen sind aber auffaellig.");

AD(({"seilverbindungen","verbindungen"}),
"Einige wenige Seilverbindungen sind eindeutig relativ neu. So verfallen die Bruecke auch "
"aussieht, sie scheint doch noch benutzt zu werden. Eigenartig wo der Pfad nahezu ganz "
"verwachsen ist.");

AD(({"staemme","stamm"}),
"Die Bruecke wurde aus Staemmen aus dem Dschungel hier gebaut, die mit Seilen verbunden "
"wurden.");

AD(({"bretter","bodenbretter","boden","brett","bodenbrett"}),
"Die meisten Bretter sehen morsch und nicht sehr tragfaehig aus. Einige Planken sind aber "
"neu.");

AD(({"planke","planken"}),
"Ein paar Planken wurden erst vor kurzem eingesetzt. Sie sehen so aus als haetten sie eine "
"gute Tragkraft.");

AD(({"kraft","tragkraft"}),
"Irgend etwas stimmt mit den neuen Planken nicht. Du erkennst, dass ihre Befestigung "
"teilweise anders ist.");

AD(({"festigung","befestigung"}),
"Manche der neuen Planken wurden ueberhaupt nicht befestigt, sondern einfach auf die Bruecke "
"gelegt. Du koenntest ja versuchen eines dieser Bodenbretter um zu drehen.");

AD(({"schlucht","sandsteinschlucht"}),
"Im Westen liegt die tiefe Schlucht des Rio de la Puseta. Der Zehn Ochsen rauscht dort "
"ueber den Rand.");

AD(({"schluchtrand","rand","kante","schluchtkante"}),
"Der Zehn Ochsen bildet sicher einen gewaltigen Wasserfall. Du kannst von hier nicht erkennen "
"wie tief die Schlucht genau ist, weil Du zu weit vom Rand entfernt bist und ihren "
"Grund nicht siehst.");

AD(({"rio","puseta","rio de la puseta"}),
"Der Rio de la Puseta fliesst am Grund der Schlucht von Norden nach Sueden. Vielleicht "
"findest Du einen Abstieg zum Fluss.");

AD(("grund"),
"Du schaetzt, dass der Grund der Schlucht ca 200 meter unter Dir liegt, aber genau kannst "
"Du es nicht sagen.");

AD(({"fall","wasserfall"}),
"Von der Schlucht aus sieht der Wasserfall des Zehn Ochsen sicher gewaltig aus. Vielleicht "
"findest Du einen Abstieg.");

AD(({"naehe","abstieg","steig","absteigen"}),
"Vielleicht kannst Du hier irgendwo absteigen, um in die Schlucht zu gelangen.");

AD(({"zehn","ochsen","fluss","zehn ochsen"}),
"Der Zehn Ochsen ist ca 8 meter breit und fliesst von Osten nach Westen. Er ist ein im "
"Dschungel typischer Regenwasserfluss. Er stuerzt nach ca 50 meter ueber eine Kante "
"in eine tiefe Schlucht.");

AD(({"regenwasserfluss","regenwasser"}),
"Der viele Regen im Dschungel sammelt sich zu vielen Baechen. Die vereinigen sich zu "
"Fluesse, die wiederum meistens in den grossen Rio de la Puseta muenden.");

AD(("fluesse"),
"Es gibt viele solche kleinen Fluesse wie den Zehn Ochsen im Dschungel. Das Wasser des "
"Zehn Ochsen ist fuer einen Regenwasserfluss ungewoehnlich klar.");

AD(("wasser"),
"Das Wasser fliesst sehr schnell nach Westen. Es hat eine helle, beinahe gelbe Farbe.");

AD(("farbe"),
"Die Farbe hat der `Zehn Ochsen` vom Sandstein, der durch das klare Wasser schimmert.");

AD(({"stein","sandstein"}),
"Das ganze Plateau und die Schlucht sind aus Sandstein. Er bildet das glatt polierte "
"Bachbett des `Zehn Ochsen`.");

AD(({"bachbett","bett"}),
"Du starrst in das schnell dahin rauschende, gelb schimmernde Wasser. Da faellt Dir ploetzlich "
"ein dunkler Schatten auf.");

AD(("schatten"),
"Das Wasser ist an einer Stelle direkt und der Bruecke seltsam dunkel.");

AD(("stelle"),
"Tatsaechlich, direkt unter der Bruecke scheint ein Hoehleneingang unter Wasser zu liegen.");

AD(({"zugang","eingang","hoehleneingang"}),//in dieser Hoehle wird die Hydra und der Schatz von Robert le Bruce sein
"Der Eingang waere breit genug um sich durch zu zwaengen. Du koenntest zwar zu ihm hinunter "
"klettern, aber er liegt unter der Wasseroberflaeche. Man muesste den `Zehn Ochsen` irgendwie "
"umleiten.");

AD(("hoehle"),
"Der Zugang zur Hoehle liegt unter Wasser. Du muesstest durch tauchen.");

AD(({"flaeche","wasseroberflaeche","oberflaeche"}),
"Kennst Du eine Moeglichkeit den `Zehn Ochsen` um zu leiten? Hier oben wird kannst Du keine "
"erkennen.");

AD(("moeglichkeit"),//man wird eine Flut in der Hoehle hinter dem Wasserfall ausloesen koennen, wodurch der Ochsen dort abfliesst. Flut schon fertig.
"Versuche es nicht weiter. Das ist in Arbeit.");

AD(("arbeit"),
"Das ist vieeeeeel Arbeit.");

AD(("plateau"),
"Du befindest Dich oestlich ueber der Schlucht des `Rio de la Puseta`.");

AD(("baeche"),
"Der Zehn Ochsen kommt aus dem Dschungel im Osten. Woher er genau kommt, und woher er "
"seinen Namen hat weisst Du nicht.");

AD(("namen"),
"Vielleicht gibt es eine Legende zu diesem eigenartigen Namen.");

AD(("legende"),
"Vielleicht war Trintrasil aber auch einfach nur nicht kreativer als zehn Ochsen.");

AD(({"trintrasil","ochse"}),
"Es wurde soeben in einem Logfile vermerkt, dass Du Trintrasil mit Ochsen in "
"Verbindung bringst.");

AD(({"logfile","file","verbindung","auge"}),
"Vorsicht, ich behalte Dich im Auge.");

AD(({"regenwald","regen"}),
"Warum nennt man den Dschungel wohl Regenwald?");

AD(("himmel"),
"Anders als im dichten Dschungel kannst Du den Himmel hier ungehindert sehen. Das macht ihn "
"aber auch nicht spannender.");

AD(("luft"),
"Die Luft ist erfuellt vom Rauschen und Gurgeln, das der Zehn Ochsen erzeugt, wenn er "
"ueber die Schluchtkante stuerzt.");

AD(({"rauschen","gurgeln"}),
"Der Zehn Ochsen stuerzt ca 50 meter weiter westlich in die Schlucht.");


AddExit("sueden", ([
        EX_FUNC: "durchbruch"]) );

AddExit("norden", ([
        EX_FUNC: "durchbruch"]) );


AddSound( DEFAULT_SOUND,
"Im Westen rauscht der Zehn Ochsen ueber den Rand in eine Schlucht.");

AddSound(({"rauschen","gurgeln"}),
"RAUSCHRAUSCH !! WWW UUU SSS CCC HHHHH !! RAUSCHRAUSCH");


AddSmell( DEFAULT_SMELL,
"Die Luft ist hier drueckend und feucht");  


AddCmd(({"drehe","wende"}),"brett");
AddCmd(({"springe","steige","huepfe"}), "sprung");
AddCmd(({"klettere","kletter"}), "eingang_klettern");
}
//&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&% EX_FUNC %&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%&%


durchbruch() {
	
	write(BSL("Als Du ueber die Bruecke, gehst bricht Ploetzlich eines der Bodenbretter "
	"unter Dir durch.\nDu versuchst zwar noch das Gelaender zu erwischen, aber es "
	"ist zu spaet und Du stuerzt in den Zehn Ochsen."));
	say(BSL("Ploetzlich bricht eines der Bodenbretter unter "+TPN+" ein. \n"+TPN+" "
	"stuerzt schreiend in den Zehn Ochsen."));
	luecke++;
	TP->move("/d/dschungel/trintrasil/plateau/room/ochse-h", M_GO+ M_NO_SHOW+
	M_SILENT);
	return 1;
}


int eingang_klettern(string str) {
	
	notify_fail("Wohin willst Du klettern?\n");
	
	if(str=="nach unten"||str=="hinunter"||str=="unter bruecke"||str=="zum eingang"||
	str=="zum wasser"||str=="zum hoehleneingang"||str=="zur wasseroberflaeche"||
	str=="zur oberflaeche"||str=="unter gelaender"||str=="unter gelaender durch"||
	str=="unter brueckengelaender"||str=="unter brueckengelaender durch"||str=="unter "
	"bruecke") {
		
		write(BSL("\nDu kletterst unter das Gelaender durch und hangelst Dich die "
		"Bruecke hinab, obwohl das Wasser reissend darunter hinweg braust. Du laesst "
		"Dich das letzte Stueck zum Wasser hinunter fallen.\n\n"));
		TP->move("/d/dschungel/trintrasil/plateau/room/ochse-h", M_GO+ M_NO_SHOW+
		M_SILENT);
		
		if(TP->QueryProp(P_GENDER)=="FEMALE") {
			
			say(BSL("\n           !!PLATSCH!!\n"
			"\n"+TPN+" ist wohl wahnsinnig! Sie klettert unter dem "
			"Brueckengelaender durch und laesst sich einfach in den reissenden "
			"`Zehn Ochsen` fallen!\n\n"));
		}
		
		else {
			say(BSL("\n            !!PLATSCH!!\n"
			""+TPN+" ist wohl wahnsinnig! Er klettert unter dem Bruecken"
			"gelaender durch und laesst sich einfach in den reissenden `Zehn "
			"Ochsen´ fallen!\n\n"));
		}
		return 1;
	}
}

			
int brett(string str) {
	
	NF("Was willst Du umdrehen?\n");
	
	if(str=="brett um"||str=="bodenbrett um"||str=="planke um"||str=="holzbrett um"||
	str=="brett"||str=="bodenbrett"||str=="planke"||str=="holzbrett") {
		
		if(!luecke) {
			
			write(BS("Du nimmst eine der unbefestigten Planken und erkennst, "
			"dass sie angesaegt ist. Sie haette Dein Gewicht sicher nicht "
			"getragen und waere gebrochen. Wenn Du nach Norden oder "
			"Sueden gehst solltest Du besser ueber die neuen Planken "
			"steigen."));
			say(BS(""+TPN+" nimmt ein unbefestigtes Bodenbrett und dreht "
			"es um. Es ist tatsaechlich angesaegt."));
			return 1;
		}
		
		if(luecke==1) {
			
			write(BSL("Du nimmst eine der unbefestigten Planken und erkennst, "
			"dass sie angesaegt ist und gebrochen waere. Wenn Du nach "
			"Norden oder Sueden gehst solltest Du besser ueber die neuen "
			"Planken steigen.\nAusserdem faellt Dir jetzt die Luecken in der "
			"Bruecke auf. Da ist schon jemand durchgebrochen."));
			say(BS(""+TPN+" nimmt ein unbefestigtes Bodenbrett und dreht "
			"es um. Es ist tatsaechlich angesaegt."));
			return 1;
		}
		
		if(luecke>1) {
			
			write(BSL("Du nimmst eine der unbefestigten Planken und erkennst, "
			"dass sie angesaegt ist und gebrochen waere. Wenn Du nach "
			"Norden oder Sueden gehst solltest Du besser ueber die neuen "
			"Planken steigen.\nAusserdem fallen Dir jetzt die Luecken in der "
			"Bruecke auf. Da sind schon mehrere durchgebrochen."));
			say(BS(""+TPN+" nimmt ein unbefestigtes Bodenbrett und dreht "
			"es um. Es ist tatsaechlich angesaegt."));
			return 1;
		}
	}
}


int sprung(string str) {
	
	notify_fail("Wohin willst Du steigen?\n");
	
	if(str=="nach norden"||str=="norden"||str=="ueber planken nach norden"||
	str=="ueber neue planken nach norden"||str=="ueber bodenbretter nach norden"||
	str=="ueber neue bodenbretter nach norden"||str=="ueber bretter nach norden"||
	str=="ueber neue bretter nach norden") {
		
		write(BSL("\nDu steigst vorsichtig, die angesaegten Planken vermeidend, nach "
		"Norden.\n\n"));
		TP->move("/d/dschungel/trintrasil/plateau/room/plateau3",
		M_GO, "nach Norden", "geht", "kommt an");
		return 1;
	}
	
	if(str=="nach sueden"||str=="sueden"||str=="ueber planken nach sueden"||
	str=="ueber neue planken nach sueden"||str=="ueber bodenbretter nach sueden"||
	str=="ueber neue bodenbretter nach sueden"||str=="ueber bretter nach sueden"||
	str=="ueber neue bretter nach sueden") {
		
		write(BSL("\nDu steigst vorsichtig, die angesaegten Planken vermeidend, nach "
		"Sueden.\n\n"));
		TP->move("/d/dschungel/trintrasil/plateau/room/plateau2",
		M_GO, "nach Sueden", "geht", "kommt an");
		return 1;
	}
}
