//fertig und getestet
inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <ansi.h>

#define NEST "/d/dschungel/trintrasil/fluss/room/nest.lpc"
#define PLATEAU2 "/d/dschungel/trintrasil/plateau/room/plateau2.lpc"


create() { 

  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Am Schluchtrand" );
  SetProp( P_INT_LONG, BSL(
  "Du stehst direkt am Rand einer tiefen Schlucht. Oestlich von Dir wuchert der Dschungel. "
  "Westlich direkt neben Dir liegt die gelbe Sandsteinschlucht des Rio de la Puseta.\n"
  "Ein grosser mit Lianen bewachsener Baum ist hier umgestuerzt und liegt vermodernd "
  "im dicht wachsenden Farn. Nach Osten kommst Du auf einen Weg.")); 

AD(({"rand","schluchtrand"}),
"Du stehst direkt am Rand der tiefen Schlucht. Ein grosser umgestuerzter Baum liegt hier. "
"Ein rankenbewachsenes Ende des Baumes haengt ueber den Schluchtrand.");

AD(("baum"),
"Der lianenueberwucherte Baum liegt hier im Farn. Bei seinem Sturz hat er eine Bresche "
"geschlagen, durch die nach Osten auf einen Pfad gehen koenntest.");

AD(("sturz"),
"Der Baum scheint hier schon lange zu liegen.");

AD(({"luecke","bresche"}),
"Der Baum hat hier eine Luecke ins Buschwerk geschlagen, durch das Du nach Osten gehen "
"koenntest.");

AD(({"busch","buesche","buschwerk"}),
"Der ganze Dschungel ist durchsetzt mit undurchdringlichem Buschwerk.");

AD(("dschungel"),
"Der dichte Dschungel endet hier am Rand eine tiefen Schlucht.");

AD(({"schlucht","sandsteinschlucht"}),
"Am Grund der gewaltigen Schlucht fliesst der Rio de la Puseta. Sie ersteckt sich von "
"Norden nach Sueden.");

AD(("grund"),
"Sehr tief unter Dir fliesst der gruene Fluss, eingefasst von den gewaltigen "
"Sandsteinwaenden.");

AD(({"waende","schluchtwaende","sandsteinwaende","felswaende","uferwaende","gelb"}),
"Die maechtigen Felswaende ragen ca 180 meter in die Hoehe. Ihr gelber Sandstein schimmert "
"in einem sanften, warmen Gelb.");

AD(({"stein","gestein","sandstein"}),
"Die Sandsteinwaende sind vom Wind ganz glatt poliert und schimmern gelb.");

AD(("hoehe"),
"Die gewaltigen Schluchtwaende umfassen den Rio de la Puseta.");

AD(({"weg","pfad"}),
"Geh einfach nach Osten wenn Du wissen willst wohin der Pfad fuehrt.");

AD(("ende"),
"Der Baum ist ganz mit Lianen ueberwuchert. Eine der Ranken haengt in die Schlucht hinab.");

AD(({"ranke","ranken","liane","lianen"}),
"Die Liane haengt weit in die Tiefe.");

AD(("tiefe"),
"Als Du Dich ueber den Schluchtrand beugst erkennst Du, dass die Liane weit hinunter bis auf "
"die Spitze einer steilen Schutthalde reicht.");

AD(({"spitze","kuppe"}),
"Auf der Kuppe der langen Schutthalde erkennst Du ein Gebilde, dass wie ein Nest aussieht.");

AD(({"gebilde","nest"}),
"Mehr kannst Du von hier aus nicht erkennen. Aber Du koenntest versuchen an der Ranke nach "
"unten zur Schutthalde zu klettern.");

AD(({"halde","schutthalde"}),
"20 Meter unter dem Schluchtrand beginnt eine sehr steile Schutthalde, die bis an den Fluss "
"heran reicht.");

AD(({"fluss","rio","puseta","rio de la puseta"}),
"Der Rio de la Puseta windet sich nahezu 180 Meter unter Dir durch die Sandsteinschlucht.");   
   
AD(("boden"),
"Der Boden ist komplett mit Farn ueberwuchert.");

AD(({"farn","farn"}),
"Der breitfaechrige Farn ueberwuchert den Boden hier nahezu vollstaendig. Lediglich eine "
"Stelle scheint frei zu sein.");

AD(("stelle"),
"An diesem Fleck ist der Farn anscheinen niedergetreten.");

AD(("fleck"),
"Als Du die Stelle genau untersuchst erkennst Du einen Stiefelabdruck,");

AD(({"abdruck","stiefelabdruck"}),
"Das ist eindeutig der Abdruck eines Militaerstiefels. Er scheint noch ganz frisch zu "
"sein.");

AD(({"militaerstiefel","stiefel"}),
"Anscheinend trieben sich erst vor kurzem Soldaten hier herum, oder andere Personen mit "
"Militaerstiefel.");
 
AD(({"soldat","soldaten"}),
"Die Soldaten sind sicher nicht freiwillig so tief in den Dschungel eingedrungen. Was haben "
"die Soldaten hier wohl gesucht?");  

AD(({"person","personen"}),
"Was macht eine Person in Militaerstiefel hier im Dschungel?");

AD(({"wind","luft"}),
"Hier am Rand der Schlucht weht der Wind recht heftig.");

AD(("himmel"),
"Der Himmel ist nicht so auffaellig wie der Farn.");


AddExit("osten", "/d/dschungel/trintrasil/plateau/room/plateau2");

    
AddSmell( DEFAULT_SMELL,
    "Die Luft ist hier drueckend und feucht");  


AddCmd(({"kletter","klettere"}), "func_down");
AddCmd(("test2"), "test2");
}


test2() {
	
	
	
	PLATEAU2->reset();
	return 1;
}


int func_down(string str) {
	
	notify_fail("An was willst Du nach unten klettern?\n");
	
	if(str=="an ranke nach unten"||str=="an liane nach unten"||str=="an ranke hinunter"||
	str=="an liane hinunter"||str=="hinunter"||str=="nach unten"||str=="an ranke hinab"||
	str=="an liane hinab"||str=="runter"||str=="ranke nach unten"||str=="liane nach "
	"unten"||str=="ranke hinunter"||str=="liane hinunter"||str=="ranke hinab"||
	str=="liane hinab") {
		
		if(NEST->rankenstatus()==0) {
			
			tell_room(NEST, BSL("\nPloetzlich faellt eine Ranke von oben herab."));
			NEST->ranke_down();
			write(BSL("\nDu umfasst eine Ranke und beginnst vorsichtig in die "
			"Tiefe zu klettern."));
			say(BSL("\n"+TPN+" umfasst eine Ranke und beginnt daran in "
			"die Tiefe zu klettern.\n"));
			TP->move("/d/dschungel/trintrasil/plateau/room/ranke-h", M_TPORT+ 
			M_SILENT+ M_NO_SHOW);
			return 1;
		}
		
		else {
			
			tell_room(NEST, BSL("\nDie Ranke, die von oben herab haengt, "
			"beginnt ploetzlich eigenartig zu schwanken."));
			write(BSL("\nDu umfasst eine Ranke und beginnst daran in die Tiefe "
			"zu klettern.\n"));
			say(BSL("\n"+TPN+" umfasst eine Ranke und beginnt daran in "
			"die Tiefe zu klettern.\n"));
			TP->move("/d/dschungel/trintrasil/plateau/room/ranke-h", M_TPORT+ 
			M_SILENT+ M_NO_SHOW);
			return 1;
		}
	}
}