
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create() {
	
  ::create();

  SetProp( P_INT_SHORT, "Rankenkletterraum" );
  SetProp( P_INT_LONG, BS(
  "Unnoetig!"));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  SetProp(P_KILL_NAME, "Ein harter Aufprall");
  AddCmd ("", "no", 1);   
  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
int no() {
	
	write (BSL("Du hast alle Haende voll zu tun nicht abzustuerzen!\n"));
	return 1;
}
     
    
init() {
	
	::init();
	
	if(query_once_interactive(this_player())){
		
		call_out("ranke1", 3);
	}
	
}
  

ranke1() {
	
	NIX
	write(BSL("\nDu kletterst vorsichtig die ledrige, zaehe Ranke hinauf. Sie scheint dein "
	"Gewicht zu tragen."));
	call_out("ranke2", 3);
}
   
   
ranke2() {
	
	NIX
	write(BSL("\nDie Ranke schaukelt beangstigend im Wind. Du kannst Dich nicht einmal "
	"mit den Fuessen an der Felswand abstuetzen, da die ueberhaengende Wand zu weit "
	"weg ist."));
	tell_room("/d/dschungel/trintrasil/fluss/room/nest",
	BS("Die Ranke schaukelt, als wuerde jemand auf ihr klettern."));
	call_out("ranke3", 2);
}
 
    
ranke3() {
	
	NIX
	write(BSL("\nDeine Arme beginnen sich zu verkrampfen und zu zittern. Endlich erreichst "
	"Du mit den Fuessen die Sandsteinwand."));
	call_out("ranke4", 3);  
}

    
ranke4() {
	
	NIX
	write(BSL("\n   !!UFFF!!\n"
	"endlich hast Du es geschafft. Du bist unten angekommen und stehst nun in einem "
	"Nest auf der Kuppe der Schutthalde."));
	tell_room("/d/dschungel/trintrasil/fluss/room/nest",
        BSL(""+TPN+" kommt keuchend die Ranke herunter geklettert.\n"));
        TP->move("/d/dschungel/trintrasil/fluss/room/nest", M_GO+ M_NO_SHOW+
        M_SILENT);   
}
   
    
  
BecomesNetDead(object pl)  {
	
	pl->move("/d/dschungel/trintrasil/fluss/room/nest",M_GO+ 
	M_SILENT+ M_NO_SHOW);
	return 1;
}

   
   
void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	leiche=present("leiche", TO);
	
	if (leiche)  {
		
		leiche->move("d/dschungel/trintrasil/fluss/room/nest",
		M_TPORT+M_SILENT);
		tell_room("d/dschungel/trintrasil/fluss/room/nest",
                BS("Na sowas!! Die Leiche von "+CAP(getuid(TP))+" faellt von oben "
                "herunter! "));
        }
}   