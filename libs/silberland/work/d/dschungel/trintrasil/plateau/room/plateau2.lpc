AddSound(({"voegel","vogel","laute"}),
  "Du kannst die Voegel im Blaetterdach der Baeume kaum erkennen. Aber Du hoerst ihre "
  "seltsamen Schreie.");
  
AddSound(({"schreie","schrei"}),
  "   !! ZIPKRAAAAH !! ZIPKRAAAAH !! TUCTUCTUC !!");
    
AddSmell( DEFAULT_SMELL,
  "Die Luft ist hier drueckend und feucht");  


AddCmd(({"springe","steige","huepfe"}), "sprung");
AddCmd(({"schneide", "zerschneide"}), "befreiung");
AddCmd(("testi"), "test_func");
AddCmd(({"entschaerfe","loese"}), "clear_of_mine");

}
test_func() {
	
	write(BS(""+players_present+""));
}



_query_int_long() {
	
	object falle;
	falle=present("fall_sch", TO);
	
	if(!falle) {
		
		return(BS("Der Pfad ist vom Dschungel fast ganz ueberwachsen und sieht "
		"schon lange nicht mehr benutzt aus. Nach Norden fuehrt er auf eine "
		"verfallene Bruecke ueber den Zehn Ochsen. Ein Baum ist hier umgestuerzt "
		"und hat eine Luecke in das Gebuesch geschlagen, sodas Du nach Westen an "
		"den Schluchtrand gehen kannst."));
	}
	
	if( falle && falle->QueryProp("fallen_status")==0 ) {//heisst falle ist unversehrt und 
	                                                     //haelt einen Spieler
		
		if( falle->QueryProp("opfer")==TP->name() ) {
			
			return(BSL("Du haengst ueber einem Dschungelpfad in einer "
			"Fallschlinge. Der Pfad ist schon sehr verwachsen und sieht "
			"eigentlich selten benutzt aus. Nach Norden fuehrt er auf eine "
			"verfallene Bruecke ueber den Zehn Ochsen. Ein Baum ist hier "
			"umgestuerzt und hat eine Luecke in das Gebuesch geschlagen, sodas "
			"Du nach Westen an den Schluchtrand gehen koenntest.\nErst muesstest "
			"Du Dich aber aus der Falle befreien!"));
		}
		
		else {
			return(BSL("Der Pfad ist vom Dschungel fast ganz ueberwachsen und "
			"sieht schon lange nicht mehr benutzt aus. Nach Norden fuehrt er "
			"auf eine verfallene Bruecke ueber den Zehn Ochsen. Ein Baum ist "
			"hier umgestuerzt und hat eine Luecke in das Gebuesch geschlagen, "
			"sodas Du nach Westen an den Schluchtrand gehen kannst.\nUeber "
			"dem Pfad baumelt "+falle->QueryProp("opfer")+" hilflos in einer "
			"Fallschlinge."));
		}
	}
	
	if( falle && falle->QueryProp("fallen_status")==1 ) {//heisst spieler hat sich befreit
		
		return(BSL("Der Pfad ist vom Dschungel fast ganz ueberwachsen und sieht "
		"schon lange nicht mehr benutzt aus. Nach Norden fuehrt er auf eine "
		"verfallene Bruecke ueber den Zehn Ochsen. Ein Baum ist hier umgestuerzt "
		"und hat eine Luecke in das Gebuesch geschlagen, sodas Du nach Westen an "
		"den Schluchtrand gehen kannst.\nUeber dem Pfad baumelt eine leere "
		"Fallschlinge."));
	}
}

//oooooooooooooooooooooooooooooooo EX_FUNCTIONS ooooooooooooooooooooooooooooooooooooooooooooooooooo	

//suedosten

wegsperre() {
	
	object falle;
	falle=present("fall_sch", TO);
	
	if(falle && falle->QueryProp("opfer") == TP->name() && TP->QueryProp(P_GENDER)==MALE
	&& falle->QueryProp("fallen_status")==0) {
		
		write(BS("Du baumelst mit dem Kopf nach unten aufgehaengt an einem "
		"Baum. Solange Du Dich nicht losgeschnitten hast, kannst Du "
		"nirgendwo hin gehen!"));
		say(BS(""+TPN+" zapperl hilflos in einer Fallschlinge. Vielleicht "
		"koenntest Du ihn losschneiden."));
		return 1;
	}
	
	if(falle && falle->QueryProp("opfer")==TP->name() && TP->QueryProp(P_GENDER)==FEMALE
	&& falle->QueryProp("fallen_status")==0) {
	
		write(BS("Du baumelst mit dem Kopf nach unten aufgehaengt an einem "
		"Baum. Solange Du Dich nicht losgeschnitten hast, kannst Du "
		"nirgendwo hin gehen!"));
		say(BS(""+TPN+" zapperl hilflos in einer Fallschlinge. Vielleicht "
		"koenntest Du sie losschneiden."));
		return 1;
	}
	
	else {
		
		write(BS("Der Pfad ist nach Suedosten leider komplett verwachsen.\n"));
		return 1;
	}
}

//westen

schluchtrand() {
	
	object falle;
	falle=present("fall_sch", TO);
	
	if(falle && falle->QueryProp("opfer") == TP->name() && TP->QueryProp(P_GENDER)==MALE
	&& falle->QueryProp("fallen_status")==0 ) {
		
		write(BS("Du baumelst mit dem Kopf nach unten aufgehaengt an einem "
		"Baum. Solange Du Dich nicht losgeschnitten hast, kannst Du "
		"nirgendwo hin gehen!"));
		say(BS(""+TPN+" zapperl hilflos in einer Fallschlinge. Vielleicht "
		"koenntest Du ihn losschneiden."));
		return 1;
	}
	
	if(falle && falle->QueryProp("opfer")==TP->name() && TP->QueryProp(P_GENDER)==FEMALE
	&& falle->QueryProp("fallen_status")==0 ) {
	
		write(BS("Du baumelst mit dem Kopf nach unten aufgehaengt an einem "
		"Baum. Solange Du Dich nicht losgeschnitten hast, kannst Du "
		"nirgendwo hin gehen!"));
		say(BS(""+TPN+" zapperl hilflos in einer Fallschlinge. Vielleicht "
		"koenntest Du sie losschneiden."));
		return 1;
	}
	
	else {
		
		TP->move("/d/dschungel/trintrasil/plateau/room/plateau1", M_GO, 
		"nach Westen", "geht", "kommt an");
		return 1;
	}
}

//norden

fallschlinge() {
	
	object falle, victim;
	
	if( !present("fall_sch") ) {
		
		write(BSL("\n\n   !!!   WWWWWUUUUUSSSSSCCCCCHHHHHHHHHH    !!!\n\n"
		"Als Du auf den Pfad nach Norden gehst zieht sich ploetzlich etwas "
		"um Dein Bein. Du wirst von den Fuessen gerissen und baumelst ploetzlich "
		"mit dem Kopf nach unten aufgehaengt an einem Baum.\n\n"
		"   !!!Du bist in eine Fallschlinge getreten!!!"));
		say(BSL("\n\n    !!!    WWWWWUUUUUSSSSSCCCCCHHHHHHHHHH    !!!!\n\n"
		""+TPN+" steigt in eine verborgene Fallschlinge, wird von den Fuessen "
		"gerissen und baumelt jetzt mit dem Kopf nach unten aufgehaengt an einem "
		"Baum."));
		falle=CLONEOB("/d/dschungel/trintrasil/plateau/obj/falle");
		falle->move(TO, M_TPORT+ M_SILENT);
		falle->SetProp("opfer", ""+TP->name()+"");
		victim=this_player();
		falle->set_victim(victim);
		return 1;
	}
	
	else {
		
		falle=present("fall_sch", TO);
		
		if( TP->name()==falle->QueryProp("opfer") && TP->QueryProp(P_GENDER)==MALE 
		&& falle->QueryProp("fallen_status")==0 ) {
			
			write(BS("Du baumelst mit dem Kopf nach unten aufgehaengt an einem "
			"Baum. Solange Du Dich nicht losgeschnitten hast, kannst Du "
			"nirgendwo hin gehen!"));
			say(BS(""+TPN+" zapperl hilflos in einer Fallschlinge. Vielleicht "
			"koenntest Du ihn losschneiden."));
			return 1;
		}
		
		if( TP->name()==falle->QueryProp("opfer") && TP->QueryProp(P_GENDER)==FEMALE 
		&& falle->QueryProp("fallen_status")==0 ) {
			
			write(BS("Du baumelst mit dem Kopf nach unten aufgehaengt an einem "
			"Baum. Solange Du Dich nicht losgeschnitten hast, kannst Du "
			"nirgendwo hin gehen!"));
			say(BS(""+TPN+" zapperl hilflos in einer Fallschlinge. Vielleicht "
			"koenntest Du sie losschneiden."));
			return 1;
		}
		
		else {
			TP->move("/d/dschungel/trintrasil/plateau/room/bruecke", M_GO, 
			"nach Norden", "geht", "kommt an");
			return 1;
		}
	}
}


//§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§ COMMANDS §§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§§

int clear_of_mine(string str) {
	
	object ob, falle;
	string was;
	
	falle=present("fall_sch");
	
	if(!str) {
		return 0;
	}
	
	if(sscanf(str, "fallschlinge mit %s aus"||"schlinge mit % aus"||"falle mit %s aus"||
	"fallschlinge mit %s"||"schlinge mit %s"||"falle mit %s", was)) {
		
		ob=present(was, TP);
		
		if(falle && falle->QueryProp("fallen_status")==0) {
			
			write(BS("Es ist schon zu spaet um die Falle zu entschaerfen. "
			""+falle->QueryProp("opfer")+" haengt schon kopfueber am Baum."));
			return 1;
		}
		
		if(falle && falle->QueryProp("fallen_status")==1) {
			
			write(BS("Du brauchst die Falle nicht mehr zu entschaerfen. Die "
			"Fallschlinge baumelt schon leer und ungefaehrlich ueber dem Pfad."));
			return 1;
		}
		
		if(!falle) {
			
			if(!ob) {
				
				write(BS("Du hast ja gar kein "+CAP(was)+"!"));
				return 1;
			}
			
			if(ob && !ob->QueryProp(P_WC)) {
				
				write(BS("Nimm lieber eine Waffe zum entschaerfen der "
				"Falle."));
				return 1;
			}
			
			if(ob && ob->QueryProp(P_WC)) {
				
				if( !ob->QueryWielded() ) {
					
					write(BS("Du musst "+CAP(was)+" natuerlich erst "
					"zuecken."));
					return 1;
				}
				
				else {
					write(BSL("\nVorsichtig stichst Du mit "+CAP(was)+" "
					"auf die getarnte Fallschlinge.\n\n"
					"  !!!  WWWUUUSSSCCCHHHHHH  !!!\n\nDie Schlinge "
					"schnellt leer in die Hoehe und baumelt ungefaehrlich "
					"ueber dem Pfad."));
					say(BSL(""+TPN+" stochert mit "+CAP(was)+" vorsichtig "
					"am Boden herum.\n\n"
					"  !!!  WWWUUUSSSCCCHHHHHH  !!!\n\nPloetzlich "
					"schnellt eine Fallschlinge hoch und baumelt nun "
					"ungefaehrlich ueber dem Pfad. Gottseidank hat "
					""+TPN+" diese gemeine Falle entschaerft."));
					falle=CLONEOB("/d/dschungel/trintrasil/plateau/obj/falle");
					falle->SetProp("fallen_status", 1);
					falle->move(TO, M_TPORT+ M_SILENT);
					return 1;
				}
			}
		}
		write(BS("Was willst Du mit Was entschaerfen?"));
		return 1;
	}
	write(BS("Was willst Du mit Was entschaerfen?"));
	return 1;
}

	
int befreiung(string str) {
	
	string was;
	object werkzeug, gehaengte, falle;
	
	falle=present("fall_sch");
	
	if(!str) {
		return 0;
	}
	
	if(sscanf(str, "seil mit %s durch"||"schlinge mit %s durch"||"fallschlinge mit %s "
	"durch"||"falle mit %s durch"||"seil mit %s"||"schlinge mit %s"||
	"fallschlinge mit %s"||"falle mit %s", was)) {
		
		werkzeug=present(was, TP);
		
		if(falle && falle->QueryProp("fallen_status")==0 && !werkzeug)  {
			
			write(BS("Du hast doch gar kein "+CAP(was)+"!"));
			return 1;
		}
		
		if(falle && falle->QueryProp("fallen_status")==0 && werkzeug &&
		werkzeug->QueryProp(P_WC)>0 ) {
			
			if(falle && falle->QueryProp("fallen_status")==0 &&
			werkzeug && werkzeug->QueryProp(P_WEAPON_TYPE)!="sword" &&
			werkzeug->QueryProp(P_WEAPON_TYPE)!="knife" )  {
				
				write(BS("Du kannst die Fallschlinge nur mit einem Messer "
				"oder Schwert durchschneiden. Alles andere ist zu "
				"unhandlich."));
				return 1;
			}
			
			if(falle && falle->QueryProp("fallen_status")==0 &&
			werkzeug && (werkzeug->QueryProp(P_WEAPON_TYPE)=="sword" ||
			werkzeug->QueryProp(P_WEAPON_TYPE)=="knife") ) {
				
				if( !werkzeug->QueryWielded() ) {
					
					write(BS("Du musst "+werkzeug->name(WEN)+" erst "
					"zuecken."));
					return 1;
				}
				
				else {
					
					if( TP->name()==falle->QueryProp("opfer") ) {
						
						write(BSL("Du ziehst Dich muehsam hoch und "
						"schneidest das Seil der Fallschlinge durch."
						"\n\n    !! ZACCKKK !!    \n\nDu faellst "
						"keuchend zu Boden, bist jetzt aber wieder "
						"frei."));
						TP->do_damage(5+random(5));
						say(BS(""+TPN+" zieht sich hoch und schneidet "
						"keuchend das Seil der Fallschlinge durch.\n"
						""+TPN+" faellt zu Boden und ist jetzt wieder "
						"frei."));
						falle->SetProp("fallen_status", 1);
						return 1;
					}
					
					else {
						
						gehaengte=falle->who_is_victim();
						
						write(BSL("Du ziehst "
						""+falle->QueryProp("opfer")+" etwas "
						"herunter um das Seil leichter zu erreichen "
						"und schneidest es durch.\n"
						""+falle->QueryProp("opfer")+" faellt zu "
						"Boden und ist jetzt wieder frei."));
						gehaengte->do_damage(5+random(5));
						say(BS(""+TPN+" befreit "
						""+falle->QueryProp("opfer")+" aus der "
						"Fallschlinge."), gehaengte);
						tell_object(gehaengte, BSL(""+TPN+" zieht "
						"Dich etwas herunter und schneidet das Seil "
						"der Fallschlinge durch.\n\n"
						"    !! ZACCKKK !!    \n\nDu faellst zu "
						"Boden, bist jetzt aber wieder frei."));
						falle->SetProp("fallen_status", 1);
						return 1;
					}
				}
			}
		}
		
		if(falle && falle->QueryProp("fallen_status")==0 && werkzeug && 
		werkzeug->QueryProp(P_WC)<1 ) {
			
			write(BSL("\nScherzkeks! Wie willst Du denn mit "
			""+werkzeug->name(WEM)+" ein Seil durchschneiden?"));
			return 1;
		}
                
                if(falle && falle->QueryProp("fallen_status")!=0) {
                	
                	write(BS("Die Fallschlinge baumelt leer ueber dem Pfad. Du musst "
                	"sie nicht mehr durch schneiden."));
                	return 1;
                }
                
                if(!falle) {
                	
                	write(BS("Was willst Du ueberhaupt durchscheiden, die Fallschlinge? "
                	"Die musst Du anders entschaerfen?"));
                	return 1;
                }
        }
        write(BS("Was willst Du mit Was durchschneiden?"));
        return 1;
}

                		

int sprung(string str) {
	
	object falle;
	falle=present("fall_sch", TO);
	
	notify_fail("Wohin willst Du springen?\n");
	
	if(str=="nach norden"||str=="norden"||str=="ueber falle"||str=="ueber fallschlinge"||
	str=="ueber schlinge"||str=="ueber stelle"||str=="ueber fleck") {
		
		if( falle && falle->QueryProp("fallen_status")==0 ) {
			
			if( TP->name()==falle->QueryProp("opfer") ) {
				
				write(BSL("\nDu haengst mit dem Kopf nach unten auf einem "
				"Baum. Du solltest Dir schoen langsam Gedanken darueber "
				"machen wie Du wieder herunter kommst.\n\n"));
				return 1;
			}
			
			else {
				write(BSL("\nMit einem weiten Satz springst Du nach Norden, "
				"obwohl das garnicht mehr notwendig ist, da "
				""+falle->QueryProp("opfer")+" schon in der Fallschlinge "
				"baumelt.\n\n"));
				TP->move("/d/dschungel/trintrasil/plateau/room/bruecke",
				M_GO, "nach Norden", "springt", "kommt an");
				return 1;
			}
			
		}
		
		if( falle && falle->QueryProp("fallen_status")==1 ) {
			
			write(BSL("\nMit einem weiten Satz springst Du nach Norden, "
			"obwohl die Fallschlinge leer ueber dem Pfad baumelt.\n\n"));
			TP->move("/d/dschungel/trintrasil/plateau/room/bruecke",
			M_GO, "nach Norden", "springt", "kommt an");
			return 1;
		}
		
		if(!falle) {
			
			write(BSL("\nMit einem weiten Sprung springst Du ueber die "
			"heimtuekische Fallschlinge nach Norden.\n\n"));
			TP->move("/d/dschungel/trintrasil/plateau/room/bruecke",
			M_GO, "nach Norden", "springt", "kommt an");
			return 1;
		}
	}
}
	
	
//********************************** SpecialDetails *****************************************************

gegenstand() {
	
	object falle;
	falle=present("fall_sch", TO);
	
	if( falle && falle->QueryProp("fallen_status")==0 ) {
		
		if( TP->name()==falle->QueryProp("opfer") ) {
			
			return(BS("Mit einem gezueckten Schwert oder Messer koenntest Du "
			"Dich losschneiden."));
		}
		
		else {
			
			return(BS("Mit einem gezueckten Schwert oder Messer koenntest Du "
			""+falle->QueryProp("opfer")+" losschneiden."));
		}
	}
	
	if( falle && falle->QueryProp("fallen_status")==1 ) {
		
		return(BS("Die Fallschlinge baumelt leer ueber dem Weg. Anscheinend "
		"hat sie jemand ausgeloest und konnte sich daraus befreien."));
	}
	
	if(!falle) {
		
		return(BS("Du koenntest die Fallschlinge mit irgendeinem gezueckten "
		"Gegenstand entschaerfen."));
	}
}


pflanze() {
	
	object falle;
	falle=present("fall_sch", TO);
	
	if( falle && falle->QueryProp("fallen_status")==0 ) {
		
		if( TP->name()==falle->QueryProp("opfer") ) {
			
			return(BS("Jemand hat hier eine gut getarnte Fallschlinge gelegt. "
			"Jetzt ist es fuer Dich aber schon zu spaet."));
		}
		
		else {
			
			return(BS("Jemand hat hier eine gut getarnte Fallschlinge gelegt. "
			""+falle->QueryProp("opfer")+" hat sie aber anscheinend nicht "
			"gesehen."));
		}
	}
	
	if( falle && falle->QueryProp("fallen_status")==1 ) {
		
		return(BS("Hier hat jemand eine Fallschlinge gelegt. Die Schlinge baumelt "
		"aber schon leer ueber dem Pfad."));
	}
	
	if(!falle) {
		
		return(BS("Hier hat jemand eine gut getarnte Fallschlinge gelegt!"));
	}
}


schlinge() {
	
	object falle;
	falle=present("fall_sch", TO);
	
	if( falle && falle->QueryProp("fallen_status")==0 ) {
		
		if( TP->name()==falle->QueryProp("opfer") ) {
			
			return(BS("Ein Seil hat sich fest um Deinen Fuss geschlungen und "
			"Dich hoch gerissen. Dir rinnt schmerzhaft das Blut in den Kopf. "
			"Du solltest Dich moeglichst schnell mit einem gezueckten Messer "
			"oder Schwert losschneiden."));
		}
		
		else {
			
			return(BS(""+falle->QueryProp("opfer")+" baumelt kopfueber in der "
			"Falle. Vielleicht koenntest Du das Seil mit einem Messer oder "
			"einem Schwert durch schneiden."));
		}
	}
	
	if( falle && falle->QueryProp("fallen_status")==1 ) {
		
		return(BS("Die Fallschlinge baumelt leer ueber dem Pfad. Anscheinend "
		"hat sie schon jemand ausgeloest. Wer verlegt denn hier so gemeine "
		"Fallen??"));
	}
	
	if(!falle) {
		
		return(BS("Du koenntest die Fallschlinge mit einem Gegenstand ausloesen, "
		"oder einfach ueber sie hinweg nach Norden springen. Wenn Du normal nach "
		"Norden gehst, tappst Du genau hinein und wuerdest hochgezogen werden."));
	}
}