AddExit("westen", ([
        EX_FUNC: "schluchtrand"]) );

AddExit("suedosten", ([
        EX_FUNC: "wegsperre"]) );

AddExit("norden", ([
        EX_FUNC: "fallschlinge"]) );


AddSound( DEFAULT_SOUND,
  "Der Dschungel ist voller unheimlicher Geraeusche.");
  
AddSound(({"geraeusche","geraeusch"}),
