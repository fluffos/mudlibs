//reset unbedingt ueberpruefen

//fertig und getestet

inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <ansi.h>

int players_present;

reset() {
	
	int i;
        object *inv, falle;
        
        inv=all_inventory(TO);
        falle=present("fall_sch");
        players_present=0;
        
        for(i=sizeof(inv)-1;i>=0;i--) {
        	
        	if( interactive(inv[i]) ) {
        		
        		players_present++;
        	}
        	
        	else {
        		
        	}
        }
        
        if(!falle) {//wurde die falle garnicht ausgeloest, kann normal resetet werden.
        	
        	::reset();
        }
        
        if(falle) {
        	
        	if( players_present>=1 ) {//die fallschlinge soll nicht 
                                //regeneriert werden wenn spieler im raum sind, um die 
                                //frage offen zu lassen wer denn die falle erneuert
        	        return 0;
        	}
        	
        	if( players_present==0 ) {
        		
        		falle->remove();
        		::reset();
        	}
        }
}



create() { 

  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Im Dschungel" );
  SetProp(P_NO_TPORT, NO_TPORT_OUT);
  
  SetProp( P_INT_LONG, BS(
  "Der Pfad ist vom Dschungel fast ganz ueberwachsen und sieht schon lange nicht mehr benutzt "
  "aus. Nach Norden fuehrt er auf eine verfallene Bruecke ueber den Zehn Ochsen. Ein Baum "
  "ist hier umgestuerzt und hat eine Luecke in das Gebuesch geschlagen, sodas Du nach "
  "Westen an den Schluchtrand gehen kannst.")); 

AD(({"holzbruecke","bruecke"}),
"Die alte Holzbruecke fuehrt ueber den Zehn Ochsen. Sie sieht schon recht morsch aus. "
"Anscheinend ist sie schon laenger nicht mehr erneuert worden.");

AD(("holz"),
"Das Holz sieht schon ziemlich morsch aus.");

AD(({"zehn","ochsen","zehn ochsen","bach"}),
"Der Zehn Ochsen ist ca 8 meter breit und fliesst von Osten nach Westen. Anscheinend "
"fliesst er nach der Bruecke ueber den Schluchtrand. Aber das kannst Du von hier aus "
"nicht sehen.");

AD(({"weg","pfad","trampelpfad","dschungelweg","dschungelpfad"}),
"Der Pfad ist schon sehr ueberwuchert. Man sieht kaum mehr freien Boden. Er sieht nicht "
"sehr haeufig benutzt aus.");

AD(("boden"),
"Der Boden ist dicht mit Graesern und Gestruepp verwachsen. Du siehst kaum eine "
"freie Stelle.");

AD(("stelle"),
"Ein kleiner Fleck ist seltsam unbewachsen.");

AD(("fleck"),
"Hier hat anscheinend jemand die Pflanzen erst kuerzlich entfernt.");



ASD(("gegenstand"),
"gegenstand");

ASD(({"pflanze","pflanzen"}),
"pflanze");

ASD(({"seil","schlinge","fallschlinge","falle"}),
"schlinge");



AD(("jemand"),
"Diese Falle ist eindeutig nicht fuer Tiere, sondern fuer Menschen bestimmt.");

AD(("fallen"),
"Du solltest vorsichtig sein. Vielleicht sind noch mehr Fallen in der Naehe.");

AD(({"tiere","menschen"}),
"Anscheinend ist der Dschungel hier doch nicht so verlassen. Was ist hier wohl los?");

AD(({"gras","graeser"}),
"Auf dem Pfad wachsen seltsame bunte Blumen und verschiedene Graeser.");

AD(("blumen"),
"Verschiedene grosse farbenpraechtige Blumen wachsen hier.");

AD(("dschungel"),
"Der Dschungel wuchert hier undurchdringlich. Urspruenglich fuehrte der Weg auch noch "
"nach Suedosten weiter. Leider ist er jetzt unpassierbar verwachsen.");
   
AD(("baum"),
"Der Baum ist ganz mit Ranken und Lianen bewachsen. Bei seinem Sturz hat er eine Luecke "
"ins Gestruepp geschlagen, durch die Du nach Westen an den Rand einer Schlucht gehen "
