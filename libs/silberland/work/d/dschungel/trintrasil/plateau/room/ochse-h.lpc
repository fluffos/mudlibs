
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create() {
	
  ::create();

  SetProp( P_INT_SHORT, "Zehn Ochsen" );
  SetProp( P_INT_LONG, BS(
  "Unnoetig!"));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  SetProp(P_KILL_NAME, "Ein Sturz ueber einen Wasserfall");
  AddCmd ("", "no", 1);   
  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
int no() {
	
	write (BSL("Du bist vollends damit beschaeftigt nicht zu ersaufen!\n"));
	return 1;
}


int njet() {
	
	write(BS("Du bist bewusstlos. Du kannst nichts spueren, Du treibst verloren in "
	"wattiger Schwaerze."));
	return 1;
}


init() {
	
	::init();
	
	if(query_once_interactive(this_player())){
		
		call_out("ochse1", 2);
	}
	
}
  

ochse1() {
	
	NIX
	write(BSL("\n       !!!PLATSCH!!!.\n"));
	call_out("ochse2", 2);
}
   
   
ochse2() {
	
	NIX
	write(BSL("\nDu faellst ins Wasser und wirst sofort mitgerissen.\n"));
	call_out("ochse3", 3);
}
 
    
ochse3() {
	
	NIX
	write(BSL("\nDu versuchst hilflos zu schwimmen, aber gegen die gewaltige Stroemung "
	"hast Du keine Chance.\n"));
	call_out("ochse4", 3);  
}

    
ochse4() {
	
	NIX
	write(BSL("\nDu haeltst Dich panisch rudernd ueber Wasser. Entsetzt erkennst Du, "
	"dass Du auf den Wasserfall zu treibst!\n"));
	call_out("ochse5", 3);
}


ochse5() {
	
	NIX
	write(BSL("\nZu spaet!\nDu wirst vom `Zehn Ochsen` ueber den Schluchtrand gespuelt "
	"und stuerzt den Wasserfall hinab!\n"));
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\nDu siehst wie Jemand "
	"schreiend den Wasserfall hinab stürzt!!\n"));
	call_out("ochse6", 3);
}


ochse6() {
	
	NIX
	write(BSL("\nWeit unter Dir siehst Du den brodelnden Fluss auf Dich zu stuerzen. Das wird "
	"ein harter Aufprall!\n"));
	call_out("ochse7", 4);
}


ochse7() {
	
	NIX
	write(BSL("\n      !!! WUUUUUUMMMMMMMMMMMM !!!\n"
	"Du wirst fast zerrissen, als Du im Rio de la Puseta auf schlaegst. Betaeubt merkst Du, "
	"dass Du vom tosenden Wasserfall unter Wasser gedrueckt wirst.\n"));
	TP->SetProp(P_HP, 0);
	tell_room("/d/dschungel/trintrasil/fluss/room/fluss14", BSL("\n"+TPN+" schlaegt hart "
	"im Rio de la Puseta auf und geht sofort unter!\n"));
	call_out("ochse8", 2);
}


ochse8() {
	
	NIX
	write(BSL("\nWehrlos spuerst Du, wie Dir Wasser in Mund und Nase dringt.\n"
	"Alles wird ploetzlich still und dumpf.\n"
	"Du verlierst das Bewusstsein.\n"));
	RemoveCmd("", "no");
	AddCmd("", "njet", 1);
	call_out("ochse9", 6);
}


ochse9() {
	
	NIX
	write(BSL("\nEin krampfhafter Husten schuettelt Dich. Dein ganzer Koerper ist wie "
	"zerschlagen.\nDu spuerst harten Stein unter Dir. Muehsam oeffnest Du die Augen.\n"));
	call_out("ochse10", 2);
}


ochse10() {
	
	NIX
	write(BSL("\nDu wurdest anscheinend irgendwo angespuelt. Du hattest gewaltiges "
	"Glueck diesen Sturz zu ueberleben.\n"));
	RemoveCmd("","njet");
	AddCmd("","no", 1);
	tell_room("/d/dschungel/trintrasil/fluss/room/dfluss4",
        BS(""+TPN+" wird auf den Felsblock gespuelt."));
        TP->move("/d/dschungel/trintrasil/fluss/room/dfluss4", M_GO+ M_NO_SHOW+
        M_SILENT);
}
   
    
  
BecomesNetDead(object pl)  {
	
	pl->move("/d/dschungel/trintrasil/fluss/room/dfluss4",M_GO+ 
	M_SILENT+ M_NO_SHOW);
	return 1;
}

   
   
void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	object leiche;
	leiche=present("leiche", TO);
	
	if (leiche)  {
		
		leiche->move("d/dschungel/trintrasil/fluss/room/dfluss4",
		M_TPORT+M_SILENT);
		tell_room("d/dschungel/trintrasil/fluss/room/dfluss4",
                BS("Die Leiche von "+CAP(getuid(TP))+" wird auf den Felsblock gespuelt! "));
        }
}