AD(({"dschungelrand","waldrand","rand"}),
"Jetzt erst faellt Dir ein Baum am Rand neben der Bruecke auf.");

AD(("baum"),
"Jemand hat etwas in die Rinde des Baumes geritzt.");

AD(("rinde"),
"Du erkennst eine Parole. Du koenntest sie lesen.");

AD(("parole"),
"Du kannst versuchen die Parole zu lesen.");

AD(("himmel"),
"Du kannst den Himmel durch das dichte Blaetterdach nicht sehen.");
  
AD(({"dach","blaetterdach"}),
"Die Baeume und das Gestruepp wachsen hier so dicht, dass Dir die Sicht durch die "
