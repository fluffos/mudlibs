//sscanfunc fmd variabilitaet 
//fertig und getestet

inherit "std/room";
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <ansi.h>


int geschuetz_scharf=1;
int geschuetz_geladen=1;
int players_present=0;


reset() {
	
	int i;
        object *inv;
        
        inv=all_inventory(TO);
        players_present=0;
        
        for(i=sizeof(inv)-1;i>=0;i--) {
        	
        	if( interactive(inv[i]) ) {
        		
        		players_present++;
        	}
        	
        	else {
        		
        	}
        }
        
        if( players_present>=1 ) {//die Selbstschussanlage soll nicht 
                                //regeneriert werden wenn spieler im raum sind, um die 
                                //frage offen zu lassen wer denn die falle erneuert
        	return 0;
        }
        
        if( players_present==0 ) {
        	
        	geschuetz_scharf=1;
        	geschuetz_geladen=1;
        	::reset();
        }
}



create() { 

  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );  
  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
  "Der Pfad ist vom dichten Dschungel so verwachsen, dass Du ihn kaum erkennen kannst. "
  "Im Sueden fuehrt er auf eine altersschwache Bruecke ueber den Zehn Ochsen. Wer auch "
  "immer den Pfad angelegt hat hat ihn anscheinend aufgegeben.")); 
   
AD(("dschungel"),
"Der Dschungel hat den Pfad nach Norden schon unpassierbar gemacht. Die Baeume und Buesche "
"wachsen hier undurchdringlich dicht.");

AD(({"holzbruecke","bruecke"}),
"Im Sueden fuehrt der Pfad auf eine ziemlich baufaellig wirkende Bruecke ueber einen kleinen "
"Fluss.");

AD(({"zehn","ochsen","fluss","zehn ochsen"}),
"Der Zehn Ochsen ist ca 8 meter breit. Er ist ein fuer den Dschungel typischer "
"Regenwasserfluss. Er fliesst von Osten nach Westen.");

AD(({"regenwasser","regenwasserfluss","fluesse","wasser"}),
"Im Dschungel gibt es viele kleine und groessere Fluesse, die sich durch das viele "
"Regenwasser bilden. Die meisten muenden in den Rio de la Puseta.");

AD(({"rio","puseta","rio de la puseta"}),
"Die gewaltige Schlucht des Rio de la Puseta muesste direkt westlich von hier sein. "
"Wenn der Dschungel nicht waere wuerdest Du sie sehen koennen.");

AD(("schlucht"),
"Wenn nach Sueden auf die Bruecke hinaus trittst, kannst Du sicher in die Schlucht "
"sehen. Der Zehn Ochsen stuerzt dort nach Osten in die Schlucht hinab.");

AD(({"buesche","gestruepp"}),
"Du befindest Dich hier am Rand des Dschungels. Nach Sueden fuehrt der Pfad hinaus auf "
"eine Bruecke ueber den Zehn Ochsen. Aber auch hier am Rand wachsen die Buesche schon "
"sehr dicht.");

AD(({"pfad","dschungelpfad","dschungelweg","weg","trampelpfad"}),
"Der Weg ist mit hohen Graesern und Blumen bewachsen.");

AD(({"gras","graeser"}),
"Das Gras steht geht Dir ueber die Knie.");

AD(({"blumen"}),
"Viele bunte Blumen leuchten in allen Farben zwischen dem hohen Gras hervor.");

AD(({"farben","farbe"}),
"Eine Blume mit grossen Bluetenkelchen faellt Dir besonders auf.");

AD(({"bluete","bluetenkelch","blueten","bluetenkelche","blume","kelch","kelche"}),
"Die roten Bluetenkelche leuchten besonders kraeftig. Der Stengel scheint seltsam "
"gebogen.");

AD(("stengel"),
"Die Haltung des Stengels ist nicht natuerlich.");

AD(("haltung"),
"Als Du die Blume genau betrachtest faellt Dir auf, dass die Blume auf einem runden "
"Gegenstand waechst.");

AD(("gegenstand"),
"Der runde Gegenstand ist ein menschlicher Schaedel!!");

AD(("schaedel"),
"Der Schaedel ist schon vollstaendig kahl. Jetzt entdeckst Du auch das uebrige "
"Skelett im hohen Gras. Auf dem Schaedel befindet sich noch ein verrotteter Helm.");

AD(("helm"),
"Der Helm sieht aus wie ein Helm der Stadtgarde von Tijara! Er hat auf der Seite ein "
"ziemlich grosses Loch.");

AD(({"loch","seite"}),
"Dieses Loch geht durch den Helm in den Schaedel und war anscheinend die toetliche "
"Verletzung.");

AD(("verletzung"),
"Du siehst durch das Loch in den Schaedel und findest dort tatsaechlich noch den "
"Armbrustbolzen.");

AD(({"bolzen","armbrustbolzen","armbrust"}),
"Der schwere Bolzen sieht nicht wie ein normaler Bolzen aus. Er sieht eher aus wie ein "
"Bolzen der fuer fest montierte kleine Geschuetze verwendet wird.");

AD(({"geschuetz","geschuetze"}),
"Niemand verwendet solche Bolzen mit einer tragbaren Armbrust. Vielleicht ist die "
"Vorrichtung noch hier in der Naehe.");

AD(({"vorrichtung","naehe"}),
"Als Du Dich vorsichtig umsiehst, bemerkst Du hinter einem Busch ein metallisches "
"Glitzern.");

AD(({"busch","glitzern"}),
"Du ziehst die Aeste des Busches beiseite und findest eine Selbstschussanlage!!");



ASD(({"anlage","selbstschussanlage","falle"}),
"anlage");

ASD(({"abzug","schnur"}),
"schnur");



AD(("aeste"),
"Die Selbstschussanlage ist hinter den Aesten gut verborgen.");

AD(({"tote","leiche","skelett"}),
"Der Tote war eindeutig ein Stadtgardist aus Tijara. Was tun denn die Soldaten hier?");

AD(({"garde","stadtgarde","soldaten","soldat","stadtgardisten","gardisten","tijara"
     "gardist","stadtgardist"}),
"Du hast gar nicht gewusst, dass die Stadtgarde so tief im Dschungel operiert. Ob hier "
"eine geheime Operation statt gefunden hat?");

AD(("tijara"),
"In Tijara hast Du nichts davon gehoert, dass die Stadtgardisten kuerzlich so weit in "
"den Dschungel vorgedrungen waeren.");

AD(("operation"),
"Vielleicht wurden die Fallen hier gegen die Gardisten errichtet?");

AD(("fallen"),
"Wen oder was haben die Soldaten hier gesucht? Und wer hat diese Gegend hier mit "
"Fallen vermint?");

AD(("gegend"),
"Vielleicht solltest Du hier verschwinden bevor Du in etwas Gefaehrliches verwickelt wirst. "
"Der Dschungel scheint hier gefaehrlich zu sein.");

AD(("gefaehrliches"),
"Der tote Soldat, die Fallen. Du scheinst hier in einer netten Gegend zu sein.");

AD(({"knie","boden"}),
"Der Boden ist hier mit Gras komplett verwachsen und nicht zu erkennen.");

AD(("baeume"),
"Die Baeume wachsen hier sehr dicht. Daher ist es selbst hier am Rand des Dschungels "
