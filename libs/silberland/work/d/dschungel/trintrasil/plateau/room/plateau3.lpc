AD(("sicht"),
"Du siehst den Dschungel vor lauter Baume nicht mehr.");



AddExit("norden", ([
        EX_FUNC:"wegsperre"]) );

AddExit("sueden", ([
        EX_FUNC: "geschuetz"]) );


AddSound( DEFAULT_SOUND,
"Im Sueden rauscht der Zehn Ochsen unter der Bruecke durch.");

AddSound(({"fluss","zehn","ochsen","regenwasserfluss"}),
"Wenn Du nach Sueden auf die Bruecke gehst siehst Du sicher mehr.");

    
AddSmell( DEFAULT_SMELL,
    "In der Luft liegt ein leichter Duft von Blumen.");

AddSmell(({"duft","blumen","luft"}),
"Hier wachsen einige Blumen im hohen Gras. Sie riechen nicht nur gut, sie sehen auch "
"interessant aus.");  


AddCmd(({"lese","lies"}), "parole");
AddCmd(({"schneide","zerschneide","trenne","entschaerfe"}), "entschaerfung");
AddCmd(({"springe","steige","huepfe"}), "sprung");
}

//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% EX_FUNC %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

geschuetz() {
	
	string zone;
	int zone_dam;
	
	switch(random(6)) {
		
		case 0:
		zone="am Ruecken";
		zone_dam=8;
		break;
		
		case 1:
		zone="an der Huefte";
		zone_dam=10;
		break;
		
		case 2:
		zone="an der Brust";
		zone_dam=8;
		break;
		
		case 3:
		zone="am Arm";
		zone_dam=6;
		break;
		
		case 4:
		zone="am Bein";
		zone_dam=5;
		break;
		
		case 5:
		zone="am Kopf";
		zone_dam=20;
		break;
		
		default:
		zone="an der Brust";
		zone_dam=8;
	}
	
	if(geschuetz_scharf && geschuetz_geladen) {
		
		write(BSL("Als Du nach Sueden gehen willst bleibst Du bei einer "
		"Stolperschnur haengen.\n\n    !! ZAACCCKKKK !!\n\nPloetzlich schiesst ein "
		"Bolzen von einer versteckten Selbstschussanlage aus einem Busch. Durch "
		"Deine guten Reflexe kannst Du Dich ducken und der Bolzen streift Dich "
		"gluecklicherweise nur "+zone+". Ein Volltreffer waere wahrscheinlich "
		"toedlich gewesen!"));
		TP->do_damage(30+zone_dam+random(20));
		say(BSL("\n"+TPN+" stolpert ueber eine Schnur und loest eine versteckte "
		"Selbstschussanlage aus.\n\n    !! ZAACCCKKKK !!\n\nEin Bolzen "
		"schiesst aus einem Busch neben dem Pfad. Gluecklicherweise streift er "
		""+TPN+" aber nur."));
		geschuetz_geladen=0;
		return 1;
	}
	
	if(geschuetz_scharf && !geschuetz_geladen) {
		
		write(BSL("\nAls Du nach Sueden gehst stolperst Du ueber eine versteckt "
		"gespannte Schnur. Es passiert aber nichts weiter.\n\n"));
		TP->move("/d/dschungel/trintrasil/plateau/room/bruecke", M_GO, "nach Sueden",
		"geht", "kommt an");
		return 1;
	}
	
	else {
		TP->move("/d/dschungel/trintrasil/plateau/room/bruecke", M_GO, "nach Sueden",
		"geht", "kommt an");
		return 1;
	}
}

		
wegsperre() {
	
	write(BS("Der Pfad ist nach Norden leider komplett verwachsen.\n"));
        return 1;
}



//°°°°°°°°°°°°°°°°°°°°°°°°° SPEZIAL DETAILS °°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°

schnur() {
	
	if(geschuetz_scharf==1) {
		
		return(BS("Du bemerkst eine duenne Schnur die ueber den Pfad "
		"gespannt ist. Wer normal nach Sueden geht muss fast unweigerlich ueber "
		"die Schnur stolpern und die Selbstschussanlage ausloesen. Du "
		"koenntest die Schnur vorsichtig durchschneiden und so die Anlage "
		"entschaerfen. Oder Du springst ueber die Schnur nach Sueden."));
	}
	
	if(geschuetz_scharf==0) {
		
		return(BS("Du bemerkst eine duenne Schnur. Die Schnur war ueber den Pfad "
		"gespannt, wurde aber anscheinend vor kurzem von jemanden zerschnitten. "
		"Dadurch kann sie den Abzug der Selbstschussanlage nicht mehr betaetigen."));
	}
}


anlage() {
	
	if(geschuetz_geladen==1) {
		
		return(BS("Die Selbstschussanlage ist geladen! Wer installiert hier mitten "
		"im Dschungel solche Fallen? Am Abzug ist eine Schnur befestigt."));
	}
	
	else {
		return(BS("Die Selbstschussanlage ist nicht geladen. Es sieht so aus als "
		"haette sie jemand vor kurzem ausgeloest. Am Abzug ist eine Schnur "
		"befestigt."));
	}
}


//$$$$$$$$$$$$$$$$$$$$$$$$$$$$ COMMANDS $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$


parole(string str) {
	
	notify_fail("Was willst Du lesen?\n");
	
	if(str=="parole"||str=="schrift") {
		
		TP->More(BSL("\n"
"	TOD DEN UNTERDRUECKERN UND IHREN SOLDATEN\n"
"\n"
"             ES LEBE DIE ROTE FAUST\n"
"\n"
"        ES LEBE DIE FREIE REPUBLIK TIJARA\n"
"\n"
"                    _______\n"
"                   | | | | |_\n"
"                   |_| | | | |\n"
"                    ||_|_|_| |\n"
"                    |        /\n"
"                     \\   ___/\n"
"                     | || |\n"
"                     | || |\n\n"));
		write(BS("Wer immer das geschrieben hat, es sieht noch sehr neu aus."));
		return 1;
	}
}


sprung(string str) {
	
	notify_fail("Wohin willst Du springen?\n");
	
	if(str=="nach sueden"||str=="sueden"||str=="ueber falle"||str=="ueber schnur"||
	str=="ueber fallschnur"||str=="ueber stolperschnur") {
		
		TP->move("/d/dschungel/trintrasil/plateau/room/bruecke",
		M_GO, "nach Sueden", "springt", "kommt an");
		return 1;
	}
}
			

int entschaerfung(string str) {
	
	
	object ob;
	string was;
	
	if(!str) {
		return 0;
	}
	
	if(sscanf(str, "schnur mit %s durch"||"fallschnur mit % durch"||
	"stolperschnur mit %s durch"||"schnur mit %s"||"fallschnur mit %s"||
	"stolperschnur mit %s"||"falle mit %s", was)) {
		
		ob=present(was, TP);
		
		if(geschuetz_scharf==0) {
			
			write(BS("Die Stolperschnur wurde schon zerschnitten. Die "
			"Selbstschussanlage ist keine Gefahr mehr."));
			return 1;
		}
		
		else {
			if(!ob) {
				
				write(BS("Du hast gar kein "+CAP(was)+"."));
				return 1;
			}
			
			if( ob && !ob->QueryProp(P_WC) ) {
				
				write(BS("Glaubst Du das "+ob->name(WER, 1)+" dazu geeignet ist "
				"diese gefaehrliche Falle zu entschaerfen? Nimm lieber ein "
				"Schwert oder Messer."));
				return 1;
			}
			
			if( ob && ob->QueryProp(P_WC) && 
			(ob->QueryProp(P_WEAPON_TYPE)!="sword" &&
			ob->QueryProp(P_WEAPON_TYPE)!="knife") ) {
				
				write(BS("Nimm lieber ein Schwert oder Messer. Alles andere "
				"ist zu unhandlich. Du willst doch nicht beim Entschaefen "
				"die Selbstschussanlage ausloesen und sterben."));
				return 1;
			}
			
			else {
				if(!ob->QueryWielded()) {
					
					write(BS("Du musst "+ob->name(WEN, 1)+" erst zuecken."));
					return 1;
				}
				
				else {
					write(BSL("\nVorsichtig schneidest Du die "
					"Stolperschnur durch. Die Selbstschussanlage bleibt "
					"ruhig. Du hast es geschafft, das Geschuetz stellt "
					"keine Gefahr mehr dar.\n\n"));
					say(BSL("\n"+TPN+" schneidet vorsichtig eine "
					"verborgenen Stolperschnur durch. Alles bleibt "
					"ruhig. Die Falle ist nun keine Gefahr mehr.\n\n"));
					geschuetz_scharf=0;
					return 1;
				}
			}
		}
		write(BS("Was willst Du mit Was zerschneiden?"));
		return 1;
	}
	write(BS("Was willst Du mit Was zerschneiden?"));
	return 1;
}