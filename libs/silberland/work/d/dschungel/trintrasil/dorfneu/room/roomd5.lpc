
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <doors.h>
#include "room.h"
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
   ::create();

   SetProp(P_INT_SHORT, "Im Kannibalendorf");
   SetProp(P_INT_LONG,
      "Der enge Pfad ist eine Sackgasse, dicht umringt von den gelben Bambushuetten. Im "
      "Westen faellt Dir eine Tuer zu einer groesseren Huette auf, an die eine "
      "Krokodilhaut genagelt ist. In einer Hundehuette neben dem Eingang doest ein "
      "riesiger, fliegenumschwirrter Koeter faul dahin.");

   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_ROAD ]) );
   
   SetProp("dorfraum", 1);
   SetProp("begrenzungsraum_greis_roomd5", 1);
   SetProp("begrenzungsraum_kinder_roomd5", 1);
   
   
   AD(("eingang"),
   "Neben der Holztuer zu der groesseren Bambushuette steht eine Hundehuette.");
   
   ASD(("hundehuette"),
   "hhuette");

   ASD(({"vieh","koeter","hund"}),
   "hund");

   AD(({"fliege","fliegen"}),
   "Die ganze Hundehuette wird von fetten Fliegen umschwirrt.");

   AD(("kannibalen"),
   "Die Kannibalen sind wahrscheinlich in ihren Huetten.");
               
   AddDetail(({"gasse","sackgasse","pfad"}),
   "Der Pfad endet hier zwischen den Bambushuetten. Eine groessere Huette faellt hier auf.");
   
   AD(({"bambushuetten","huetten","wohnhuetten"}),
   "Die Bambushuetten stehen dicht beieinander, woduch der Pfad eng und schattig ist.");
   
   AD(({"bambushuette","huette","groessere huette","faelle"}),
   "Die Huette scheint einem wichtigen Stammesmitglied zu gehoeren. Auf alle Faelle ist "
   "sie deutlich groesser als die anderen Huetten, und an die Holztuer zur Huette ist eine "
   "Krokodilhaut genagelt.");
   
   AD(({"haut","krokodilhaut","krokodil"}),
   "Als Du die Haut genauer betrachtest erkennst Du, dass die Tuer mit der Haut eines "
   "Riesenkaimans bespannt ist.");

   AD(({"kaiman","riesenkaiman"}),
   "Im Rio de la Puseta leben riesige Kaimane. Sie sind aeusserst gefuerchtete Raeuber.");
   
   AD(({"rio","puseta","rio de la puseta","fluss"}),
   "Den Fluss kennst Du doch.");
   
   AD(({"tiere","raeuber"}),
   "Die Kannibalen fertigen aus den Schaedeln dieser Tiere sehr gute Helme, wenn es ihnen "
   "gelingt eines zu erlegen.");
   
   AD(({"schaedel","helme","helm","kaimanhelm","kaimanhelme"}),
   "Die Kannibalen fertigen aus den dicken, harten Schaedeln Helme, die dem Traeger angeblich "
   "besondere Kraefte verleihen. Aber solche Helme sind sehr selten und sehr wertvoll.");
   
   AD(({"kraft","kraefte"}),
   "Solche Kaimanhelme sind oft sehr unterschiedlich, je nach den Materialien die die "
   "Handwerker noch zusaetzlich verwenden.");
   
   AD(({"handwerker","traeger"}),
   "Du hast anscheinend die Huette eines solchen Handwerkers gefunden. Du kannst ihn ja fragen "
   "was er fuer einen solchen Helm verlangen wuerde.");
   
   AD(({"material","materialien"}),
   "Je nach Verfuegbarkeit verwenden die Kannibalen auch noch Sandwurmhaeute und Anakondazaehne "
   "fuer ihre Helme.");
   
   AD(("verfuegbarkeit"),
   "Wenn Du einen solchen Helm willst muesstest Du die Materialien natuerlich besorgen.");
   
   AD(({"haeute","sandwurmhaeute","zaehne","anakondazaehne","zahnanakondazaehne"}),
   "Diese Materialien sind sehr schwer zu bekommen. genaueres kann Dir sicher der Handwerker "
   "sagen.");

   AD(("bambus"),
   "Bambus ist leicht und trotzdem sehr belastbar.");

   AD(({"sonne","himmel"}),
   "Der Himmel ist strahlend blau. Die Sonne brennt heiss auf den trockenen Lehm.");
   
   AD(("hitze"),
   "Die Sonne brennt erbarmungslos vom Himmel.");
   
   AD(("lehm"),
   "Der Lehm ist trocken und hart.");
      
   AD(("boden"),
   "Die Boden besteht aus fest gestampftem Lehm.");
      
   ASD(({"mitglied","stammesmitglied"}),
   "mitglied");
   
     
   AddSound(DEFAULT_SOUND, "Bis auf das Summen der Fliegen ist es hier sehr still.\n");
   AddSound(({"summen","fliegen"}),
   "BSSSSSSSSSSSSSSSSSSSSSSBSSSSSSSSSSSSSSSSS!");
   

   AddItem("/d/dschungel/trintrasil/dorfneu/npc/hund", REFRESH_DESTRUCT);
   
     
   AddCmd(({"beruehre","wecke","streichle"}), "knurr");
   
        
AddExit("sueden", "./roomd4");

NewDoor("westen","./momb",({"tuer","holztuer"}),
({D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
  D_LONG,"An die Holztuer wurde eine Krokodilhaut genagelt.\n",
  D_SHORT,"Eine %se Holztuer\n",
  D_NAME,"Holztuer",
  D_GENDER, FEMALE,
  D_FUNC, "message",
  D_FUNC2,"begruessung",
  D_MSGS, ({"durch eine Holztuer","geht","kommt herein"}) 
  }) );

}


_query_int_long() {
	
	if(present("kkoeter", TO)) {
		
		if( present("kkoeter", TO)->QueryProp("doesend")==1 ) {
			
			if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==-1) {
				
				return(BSL("Der enge Pfad ist eine Sackgasse, dicht umringt von "
				"den gelben Bambushuetten. Im Westen faellt Dir eine Tuer zu "
				"einer groesseren Huette auf, an die eine Krokodilhaut genagelt "
				"ist. In einer Hundehuette neben dem Eingang doest ein riesiger, "
				"fliegenumschwirrter Koeter faul dahin.\nEine geschlossene "
				"Holztuer"));
			}
			
			if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==1) {
				
				return(BSL("Der enge Pfad ist eine Sackgasse, dicht umringt von "
				"den gelben Bambushuetten. Im Westen faellt Dir eine Tuer zu "
				"einer groesseren Huette auf, an die eine Krokodilhaut genagelt "
				"ist. In einer Hundehuette neben dem Eingang doest ein riesiger, "
				"fliegenumschwirrter Koeter faul dahin.\nEine goeffnete "
				"Holztuer"));
			}
		}
		
		if( present("kkoeter", TO)->QueryProp("doesen")==0 ) {
			
			if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==-1) {
				
				return(BSL("Der enge Pfad ist eine Sackgasse, dicht umringt von "
				"den gelben Bambushuetten. Im Westen faellt Dir eine Tuer zu "
				"einer groesseren Huette auf, an die eine Krokodilhaut genagelt "
				"ist. Vor einer Hundehuette neben dem Eingang steht ein "
				"riesiger, fliegenumschwirrter Koeter.\nEine geschlossene "
				"Holztuer"));
			}
			
			if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==1) {
				
				return(BSL("Der enge Pfad ist eine Sackgasse, dicht umringt von "
				"den gelben Bambushuetten. Im Westen faellt Dir eine Tuer zu "
				"einer groesseren Huette auf, an die eine Krokodilhaut genagelt "
				"ist. Vor einer Hundehuette neben dem Eingang steht ein "
				"riesiger, fliegenumschwirrter Koeter.\nEine geoeffnete "
				"Holztuer"));
			}
		}
		
	}
	
	if(!present("kkoeter", TO)) {
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==-1) {
			
			return(BSL("Der enge Pfad ist eine Sackgasse, dicht umringt von den "
			"gelben Bambushuetten. Im Westen faellt Dir eine Tuer zu einer "
			"groesseren Huette auf, an die eine Krokodilhaut genagelt ist. Neben "
			"dem Eingang steht eine fliegenumschwirrte Hundehuette, die anscheinend "
			"fuer einen beunruhigend grossen Hund gebaut wurde.\nEine geschlossene "
			"Holztuer."));
		}
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==1) {
			
			return(BSL("Der enge Pfad ist eine Sackgasse, dicht umringt von den "
			"gelben Bambushuetten. Im Westen faellt Dir eine Tuer zu einer "
			"groesseren Huette auf, an die eine Krokodilhaut genagelt ist. Neben "
			"dem Eingang steht eine fliegenumschwirrte Hundehuette, die anscheinend "
			"fuer einen beunruhigend grossen Hund gebaut wurde.\nEine geoeffnete "
			"Holztuer."));
		}
	}
}



message() {
	
	tell_object(TP, "\n      ! Du betrittst Mombassas Werkstatt !\n\n");
}


door_func_hau_ab() {
	
	if(TP->QueryProp("muss_sich_entscheiden")) {
		
		TP->SetProp("muss_sich_entscheiden", 0);
		tell_object(TP, BSS("Na bitte! Keine Antwort sein auch eine Antwort! "
		"Du kannst Dir Helm aufzeichnen wenn Du nicht sagen kannst welchen!",
		"Mombassa bruellt Dir aus der Werkstatt nach: "));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", BS(""+TPN+" laesst "
		"Mombassa ohne ihm eine Antwort zu geben einfach stehen. Wie unhoeflich!"));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", BSS("Na bitte! Keine "
		"Antwort sein auch eine Antwort! Du kannst Dir Helm aufzeichnen wenn Du "
		"nicht sagen kannst welchen!","Mombassa bruellt "+TPN+" nach: "));
	}
}


knurr(string str) {
	
	notify_fail("Wen willst Du streicheln?\n");
	
	if(str=="hund"||str=="koeter"||str=="vieh") {
		
		if(present("kkoeter", TO)) {
			
			if( present("kkoeter", TO)->QueryProp("doesend")==1 ) {
				
				write(BS("Als Du den Hund vorsichtig am Kopf beruehrst knurrt "
				"er ploetzlich tief und bedrohlich. Er scheint also doch nicht "
				"so tief zu schlafen wie Du dachtest."));
				say(BS(""+TPN+" will den riesigen Koeter streicheln! Hau "
				"schnell ab damit Du nicht mit von dem beunruhigend grossen "
				"Hund gefressen wirst!"));
				return 1;
			}
			
			if( present("kkoeter", TO)->QueryProp("doesen")==0 ) {
				
				write(BS("Als Du mit der Hand auf den Kopf des Hundes greifen "
				"willst knurrt er tief und bedrohlich und schnappt ploetzlich "
				"zaehnefletschend nach Dir. War ja auch eine bloede Idee."));
				say(BS("Ist "+TPN+" denn wahnsinnig?! "+TPN+" will wohl den "
				"Hund reizen!!"));
				return 1;
			}
			return 1; 
		}
		
		if(!present("kkoeter", TO)) {
			
			write(BS("Die Hundehuette ist leer! Sei doch froh darueber!"));
			say(BS(""+TPN+" will die leere Hundehuette streicheln. Die Sonne "
			"brennt heute wohl besonders heiss."));
			return 1;
		}
		return 1;
	}
	return 0;
}

		
mitglied() {
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")=="geschlossen") {
		
		return(BS("Die Huette besitzt eine Holztuer die mit einer Krokodilhaut "
		"bespannt ist. Wenn Du sie oeffnest kannst Du ja einmal eintreten und "
		"nachsehen wer in der Huette wohnt."));
	}
	
	else {
		
		return(BS("Die Holztuer zur Huette ist offen. Du kannst ja einmal eintreten "
		"und nachsehen wer dort wohnt."));
	}
}


hhuette() {
	
	if(present("kkoeter", TO)) {
		
		if( present("kkoeter", TO)->QueryProp("doesend")==1 ) {
			
			return(BS("In der Hundehuette liegt ein riesiger, fliegenumschwirrter "
			"Koeter und scheint zu doesen. Trotzdem solltest Du das unheimliche "
			"Vieh lieber nicht beruehren."));
		}
		
		if( present("kkoeter", TO)->QueryProp("doesend")==0 ) {
			
			return(BS("Vor der Hundehuette sitzt ein riesiger fliegenumschwirrter "
			"Koeter. Du solltest das unheimliche Vieh lieber nicht unnoetig "
			"reizen."));
		}
	}
	
	if(!present("kkoeter",TO)) {
		return(BS("Die Hundehuette ist gottseidank leer, bis auf die vielen Fliegen "
		"die darin herumkrabbeln."));
	}
}


hund() {
	
	if(present("kkoeter", TO)) {
		
		if( present("kkoeter", TO)->QueryProp("doesend")==1 ) {
			
			return(BS("Der Hund ist ziemlich gross und sieht nicht gerade "
			"ungefaehrlich aus. Du bist froh dass er schlaeft."));
		}
		
		if( present("kkoeter", TO)->QueryProp("doesend")==0 ) {
			
			return(BS("Der Hund ist ziemlich gross und sitzt knurrend vor der "
			"Hundehuette. Der koennte noch ungut werden."));
		}
	}
	
	if(!present("kkoeter", TO)) {
		
		return(BS("Du weisst nicht wo der Hund ist. In der Huette ist er jedenfalls "
		"nicht, was vielleicht garnicht schlecht ist."));
	}
}


hund_present() {
	
	if(present("kkoeter", TO)) {
		
		return 1;
	}
	
	else {
		return 0;
	}
}


hund_kommt(enemy) {
	
	object hund;
	hund = present("kkoeter", TO);
	
	if(hund && DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==-1) {
		
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", BSL("\nEin Hund rennt "
		"knurrend die Huettentuer auf und kommt Mombassa bellend zu Hilfe!\n\n"));
		tell_room(TO, BSL("Der Hund springt knurrend auf, rennt die "
		"Huettentuer auf und stuerzt sich bellend in den Kampf."));
		DOOR_MASTER->SetDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb", 1);
		hund->SetProp("doesend", 0);
		hund->Kill(enemy);
		hund->move("/d/dschungel/trintrasil/dorfneu/room/momb", M_TPORT + M_SILENT);
	}
	
	if(hund && DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==1) {
		
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", BSL("\nEin Hund springt "
		"knurrend von draussen herein und kommt Mombassa bellend zu Hilfe!\n\n"));
		tell_room(TO, BSL("Der Hund springt knurrend auf und laeuft bellend "
		"in die westliche Huette!"));
		hund->Kill(enemy);
		hund->SetProp("doesend", 0);
		hund->move("/d/dschungel/trintrasil/dorfneu/room/momb", M_TPORT + M_SILENT);
	}
	
	else {
		return 0;
	}
}


door_status() {//vom mombmaster verwendet
	
	if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb")==-1) {
		
		return -1;
	}
	
	else {
		return 1;
	}
}

open_door() {//vom mombmaster verwendet
	
	DOOR_MASTER->SetDoorStatus("/d/dschungel/trintrasil/dorfneu/room/momb", 1);
}