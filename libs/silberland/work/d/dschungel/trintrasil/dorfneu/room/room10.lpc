inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"


int astzahl = 2+random(3);


void create()
{
	
   ::create();

   
   SetProp(P_INT_SHORT, "Ein Trampelpfad");
   SetProp(P_INT_LONG,
      "Du befindest Dich noch immer auf einem Trampelpfad mitten im Dschungel."
      " Zu beiden Seiten des Pfades siehst Du nur gruen, und kein Laut ist zu"
      " hoeren."
    );

   
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   SetProp("no_help_here", 1);
   
   
   
   
   AddDetail( ({"boden","pfad","trampelpfad","pfades"}),
       "Der Pfad fuehrt mitten durch den Dschungel und besteht aus"
     + " festgetrampelten Lehm."
       );
   AddDetail("himmel",
       "Du kannst den wolkenlosen Himmel ueber Dir erkennen."
       );
   AddDetail( ({"dschungel"}),
       "Der Pfad befindet sich noch immer mitten im Dschungel. Durch das dichte "
       "Gestruepp ist der Pfad schattig und schummrig.");
       
   AddDetail(("gestruepp"),
   "Das Buschwerk ueberwaechst beinahe den Pfad.");
   
   AddDetail(({"werk","buschwerk"}),
   "Das Buschwerk hat sehr dichte Aeste.");
   
   ASD(({"aeste","ast"}),
   "aeste");
        
   AddDetail( "laut",
      "Du kannst wirklich nichts hoeren...sehr verdaechtig."
      );
   AddDetail( "lehm",
      "Der Pfad besteht aus festgetrampeltem Lehm, Du kannst nichts"
    + " Besonderes daran erkennen."
    );
   AddDetail( "besonderes",
      "Es gibt wirklich nichts zu sehen."
      );
   AddDetail( ({"seiten","seite"}),
      "Du siehst nur gruen."
      );
   AddDetail( "kleidung",
      "Deine Kleidung ist vom Schweiss nass."
      );
   AddDetail("schweiss",
      "Du schwitzt eben stark."
      );
   AddDetail( "angst",
      "Du hast eben Angst."
      );
   AddDetail( "stille",
      "Du kannst nichts hoeren."
      );
      
   AD(("etwas"),
   "Die Aeste wuerden gut brennen, wenn Du eine Feuerstelle haettest.");
   
   AD(({"stelle","feuer","feuerstelle"}),
   "Vielleicht findest Du ja eine Feuerstelle im Kannibalendorf. Obwohl es hier ohnehin heiss "
   "ist und ein Feuer im Moment bei weitem nicht das Wichtigste ist.");
   
   AD(({"moment","wichtigste"}),
   "Du musst selber wissen was fuer Dich im Moment das Wichtigste ist.");
   
   AD(({"naehe","dorf","kannibalendorf"}),
   "Das Kannibalendorf ist hier ganz in der Naehe.");
   
   
              
   
     
   AddSound(DEFAULT_SOUND, "Unheimliche Stille. Das Schmatzen Deiner Fuesse beim"
    + " Gehen laesst Dich erschaudern.\n");
   
  

   AddSmell(DEFAULT_SMELL, "Du riechst nur Deinen eigenen Angstschweiss.\n");
   AddSmell( ({"angstschweiss","schweiss"}), "Du schwitzt wie ein Schwein und"
    + " Deine Kleidung wird immer nasser...man koennte sagen, Du hast Angst!\n"
    );   
      
   
   
   AddCmd(({"brich","breche","reisse"}), "ast_func");
   
  
  AddExit("norden","./room9");
  AddExit("osten", "/d/dschungel/charon/dorfneu/room/room11");
   

}


aeste() {
	
	if(astzahl>1) {
		
		return(BS("Du siehst "+astzahl+" trockene Aeste die Du abbrechen koenntest. "
		"Vielleicht koenntest Du sie ja zu etwas gebrauchen."));
	}
	
	if(astzahl==1) {
		
		return(BS("Du siehst einen trockenen Ast den Du abbrechen koenntest. "
		"Vielleicht koenntest Du ihn ja zu etwas gebrauchen."));
	}
	
	if(astzahl<1) {
		
		return(BS("Du siehst hier keine brauchbaren trockenen Aeste mehr die Du "
		"abbrechen koenntest."));
	}
}


int ast_func(string str) {
	
	object ast;
	
	notify_fail("Was willst Du abbrechen?\n");
	
	if(str=="ast ab"||str=="ast"||str=="aeste ab"||str=="holz ab"||str=="feuerholz ab.") {
		
		if(astzahl>0) {
			
			write(BS("KNACK! Du brichst einen besonders trockenen Ast ab und "
			"steckst ihn ein."));
			say(BS("KNACK! "+TPN+" bricht einen trockenen Ast ab."));
			astzahl--;
			ast = CLONEOB("/d/dschungel/trintrasil/dorfneu/obj/ast");
			ast->move(TP, M_NOCHECK);
			return 1;
		}
		
		if(astzahl<=0) {
			
			write(BS("Du findest leider keine geeigneten Aeste."));
			return 1;
		}
	}
}
