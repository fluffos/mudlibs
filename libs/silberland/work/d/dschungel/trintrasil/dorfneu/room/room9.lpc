inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/fluss/fischdef.h"

#define QUESTMASTER "/d/dschungel/charon/dorfneu/questmaster.lpc"


int messer = 1;


reset()  {
::reset();
messer = 1;
}


init() {
	
	object schatten;
	schatten=clone_object("/d/dschungel/trintrasil/fluss/npc/schatten.lpc");
	
	::init();
	
	if( living(this_player()) && !interactive(this_player()) && !TP->QueryProp("flussnpc") &&
	!TP->QueryProp("shadow(trint)") ) {
		
		schatten;
		schatten->setze_besitzer();
		TP->SetProp("shadow(trint)", 1);
	}
}

	
void create()
{
   ::create();

   
   SetProp(P_INT_SHORT, "Ein Strand");
   SetProp(P_INT_LONG, BSL(
      "Du befindest Dich am Ufer des Rio de la Puseta. Das Schilf wurde hier weggehackt, damit "
      "man einen ungehinderten Zugang zum Fluss hat. Der Dschungel waechst hier beinahe bis "
      "ans Ufer, so dass die freie Stelle nur sehr schmal ist. Ausserdem wuchert im Westen "
      "ein dichtes Gebuesch.\nDirekt am Ufer steckt ein Pfahl mit einem aufgespiessten "
      "Schaedel."));

   
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   SetProp("no_help_here", 1);

   SetProp("begrenzungsraum_fpursuer", 1);
   SetProp("begrenzungsraum_greis_room9", 1);
   
   
   
   ASD(({"gebuesch","hecke","gestraeuch"}),
   "gebuesch");

   ASD(({"wimmern","jammer","gejammer","gewimmer"}),
   "wimmern");

   AD(({"schilf","zugang","stelle"}),
   "Das ueppig wuchernde Schilf wurde hier weggehackt um leichter zum Fluss zu gelangen.");
   
   AD(("ufer"),
   "Du befindest Dich direkt am Ufer des Rio de la Puseta. Hier waere ein guter Ort um einen "
   "Fisch zu rufen.");
   
   AD(("fisch"),
   "Untersuche einmal den Graetenbusch genauer.");
         
   AD(({"rio","puseta","rio de la puseta","fluss"}),
   "Du stehst am Ufer des gurgelnden Rio de la Puseta. Der grosse Fluss fliesst hier von "
   "Westen nach Osten.");
   
   AD(({"boden","pfad","trampelpfad"}),
   "Der Boden ist fruchtbar und feucht. Ein Pfad fuehrt mitten in den Dschungel und besteht "
   "aus festgetrampelten Lehm.");
   
   AD(("himmel"),
   "Du kannst den wolkenlosen Himmel ueber Dir erkennen.");
   
   AD(({"dschungel"}),
   "Der Pfad fuehrt in den Dschungel.");    
   
   AD(("vegetation"),
   "Die Vegetation ist sehr dicht und ueberaus gruen.");
   
   AD(("lehm"),
   "Der Pfad besteht aus festgetrampeltem Lehm, Du kannst nichts Besonderes daran erkennen.");
   
   AD(("besonderes"),
   "Es gibt wirklich nichts zu sehen.");
   
   AD(({"baum","baeume"}),
   "Die Baeume sind hier sehr hoch und aeusserst beeindruckend.");
   
   AD(("wind"),
   "Du kannst den Wind hoeren, der durch die Baeume pfeift.");
      
   AD(({"erde","erdreich"}),
   "Der reichliche Regen ist dafuer verantwortlich, dass das Erdreich nass ist.");
   
   AD(("regen"),
   "Der Regen ist hier ueberaus haeufig.");
   
   AD(("rauschen"),
   "schwiuschwiu.. Der Wind rauscht in den Baeumen.");
   
   AD(("pfahl"),
   "Kannibalen haben hier einen Pfahl mit einen Schaedel aufgestellt, als Warnung an "
   "Eindringlinge.");
   
   AD(("kannibalen"),
   "Die Kannibalen haben hier ihr Dorf.");
   
   AD(({"dorf","naehe"}),
   "Das Dorf muss ganz in der Naehe sein.");
   
   AD(({"eindringling","eindringlinge"}),
   "Ungebetene Eindringlinge wie Du.");
   
   AD(("warnung"),
   "Vielleicht solltest Du die Warnung ernst nehmen.");
   
   AD(({"kopf","schaedel"}),
   "Vom Kopf dieses armen Kerls ist nur noch der planke Schaedel ueber.");
   
   AD(("kerl"),
   "Der arme Kerl war wohl zur falschen Zeit am falschen Ort.");
   
   AD(("zeit"),
   "Pass auf, dass Dir nicht das gleiche passiert.");
   
   AD(("ort"),
   "Jetzt erkennst Du erst einen kleinen Gegenstand im Schaedel.");
   
   ASD(({"schaedelinnere","innere","gegenstand"}),
   "gegenstand");
   
   /*** Geraeusche ***/
     
   AddSound(DEFAULT_SOUND, "Du kannst das Rauschen der Vegetation hoeren, wenn"
        " der Wind durch die Baeume faehrt.\n");
         
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, "Du riechst den feuchten Lehm.\n");
   AddSmell( ({"lehm"}), "Durch den Regen ist das Erdreich"
      " durchnaesst und riecht nun erfrischend.\n"
    );   


   AddItem("/d/dschungel/trintrasil/fluss/obj/graetenbusch2", REFRESH_DESTRUCT);    
   
   
   /*** Commands ***/
   
   AddCmd( ({"krieche","krabble"}), "busch");
   AddCmd( ("greife"), "messer_func");
   AddCmd( ("queststat"), "querystat");
   
   
   
   /*** Exits ***/

AddExit("sueden", "./room10");
AddExit("osten", "/d/dschungel/charon/dorfneu/room/room12");

  PFEIFE
  REITEN
  
}


FLUSSFISCHRUF
FLUSSREITFUNC(/d/dschungel/trintrasil/fluss/room/dfluss1)
FLUSSFISCHCALLOUTS(vor dem Ufer)




querystat() {
	
	tell_room(TO, "\n"+QUESTMASTER->quest_status()+"\n");
	return 1;
}


messer_func() {
	
	object smesser;
	
	if(messer==1) {
		
		write(BS("Du greifst in das Innere des Schaedels und findest ein Messer und "
		"steckst es ein. Vielleicht kannst Du es brauchen."));
		say(BS(""+TPN+" greift in das Schaedelinnere und holt etwas heraus."));
		smesser=CLONEOB("/p/weapon/knife/messer");
		smesser->move(TP, M_NOCHECK);
		messer = 0;
		return 1;
	}
	
	if(messer==0) {
		
		write(BS("Du greifst in das Schaedelinnere, findest aber nichts. Wenn etwas "
		"darin war hat es anscheinend schon jemand heraus genommen."));
		say(BS(""+TPN+" greift in das Schaedelinnere, findet aber nichts."));
		return 1;
	}
}


int busch(string str) {
	
	notify_fail("Wohin willst Du kriechen?\n");
	
	if(str=="gebuesch"||str=="busch"||str=="durch gebuesch"||str=="durch busch"||
	str=="in gebuesch"||str=="in busch"||str=="ins gebuesch"||str=="hinter gebuesch"||
	str=="hinter busch") {
		
		if( TP->QueryQuest("1000 Qualen im Dorf der Kannibalen") ) {
			
			write(BSL("\nDu kriechst durch die dichten Aeste des Gebuesches.\n\n"));
			say(BSL("\n"+TPN+" kriecht durch das dichte Gebuesch.\n\n"));
			tell_room("/d/dschungel/trintrasil/dorfneu/room/busch-h", BS(""+TPN+" "
		        "kriecht durch das Gebuesch herein."));
			TP->move("/d/dschungel/trintrasil/dorfneu/room/busch-h", M_GO+ M_SILENT);
		        return 1;
		}
		
		if( !TP->QueryQuest("1000 Qualen im Dorf der Kannibalen") && 
		( QUESTMASTER->quest_status() == 0  || (QUESTMASTER->quest_status() == 1 && 
		present("\nkd_quest", TP)) ) )  {
			
			write(BSL("\nDu kriechst durch die dichten Aeste des Gebuesches.\n\n"));
			say(BSL("\n"+TPN+" kriecht durch das dichte Gebuesch.\n\n"));
		        tell_room("/d/dschungel/trintrasil/dorfneu/room/busch", BS(""+TPN+" "
		        "kriecht durch das Gebuesch herein."));
		        TP->move("/d/dschungel/trintrasil/dorfneu/room/busch", M_GO+ M_SILENT);
		        return 1;
		}
		
		else {
			
			write(BS("Dir kommt das Gebuesch nicht ganz geheuer vor. Komm besser "
			"spaeter wieder."));
			return 1;
		}		
	return 1;
	}
	
	else {
	
		write(BS("Wohin willst Du kriechen?\n"));
	return 1;
	}
return 0;
}


gebuesch() {
	
	if(TP->QueryQuest("1000 Qualen im Dorf der Kannibalen")) {
		
		return(BS("Du kannst Dich erinnern. Hinter diesem Busch hat sich Kai "
		"versteckt bevor Du seine Tochter befreit hast."));
	}
	
	if(!TP->QueryQuest("1000 Qualen im Dorf der Kannibalen")) {
		
		if( present("\nkd_quest",this_player()) ) {
			
			return(BS("Hinter diesem Busch versteckt sich Kai und wartet "
			"darauf, dass Du deine Aufgabe bei den Kannibalen fertig loest."));
		}
		
		if( !present("\nkd_quest",this_player()) ) {
			
			return(BS("Du hoerst ein seltsames Wimmern aus diesem Gebuesch. "
			"Vielleicht solltest Du einmal ins Gebuesch kriechen."));
		}
	}
}


wimmern() {
	
	if(TP->QueryQuest("1000 Qualen im Dorf der Kannibalen")) {
		
		return(BS("Welches Wimmern meinst Du? Kai ist doch schon laengst weg."));
	}
	
	if(!TP->QueryQuest("1000 Qualen im Dorf der Kannibalen")) {
		
		if( present("\nkd_quest",this_player()) ) {
			
			return(BS("Hinter diesem Busch versteckt sich Kai und wartet "
			"darauf, dass Du deine Aufgabe fertig erfuellst."));
		}
		
		if( !present("\nkd_quest",this_player()) ) {
			
			return(BS("Du hoerst ein seltsames Wimmern aus diesem Gebuesch. "
			"Vielleicht solltest Du einmal ins Gebuesch kriechen."));
		}
	}
}	


gegenstand() {
	
	if(messer=1) {
		
		return(BS("Greife in den Schaedel."));
	}
	
	if(messer=0) {
		
		return(BS("Komisch. Den Gegenstand hat wohl schon jemand vor Dir hier "
		"heraus geholt."));
	}
}


	