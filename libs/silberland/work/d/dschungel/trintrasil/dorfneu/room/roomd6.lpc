
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "room.h"

#include "/d/dschungel/trintrasil/myowndefine.h"

#define HUETTE "/d/dschungel/trintrasil/dorfneu/room/huette-h"

int fischz = 4+random(5);

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Im Kannibalendorf");
  SetProp(P_INT_LONG,
	  "Die breite Lehmstrasse endet hier vor einem zweiten grossen "
	  "Palisadentor, dass ebenfalls von zwei grimmig blickenden "
	  "Kriegern bewacht wird. Auf den Pfaehlen stecken Schaedel, "
	  "die teilweise noch die Helme der Stadtgarde von Tijara tragen. "
	  "Ein paar Schaedel scheinen noch recht frisch zu sein. Ueber "
	  "die Strasse ist ein Strick gespannt, an dem "
	  "Fische zum Trocknen aufgehaengt sind.");
  
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,  1);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_ROAD ]));
  
  SetProp("palisadenraum", 1);//wird beim angreifen des alten mannes benoetigt, kannibalen
  //reagieren hier anders da es sonst sehr schwer waere die wachen zu toeten wenn ihnen das
  //gesammte dorf zu hilfe eilen wuerde. siehe warmaster
  SetProp("begrenzungsraum_greis_roomd6", 1);
  SetProp("begrenzungsraum_kinder_roomd6", 1);
  
  AD(({"strasse","lehmstrasse"}),
     "Die Strasse endet hier vor einem Palisadentor, dass den Zugang zum Dorfzentrum verwehrt. ");
  
  AD(("inneres"),
     "Das Innere Dorfzentrum ist sicher gefaehrlich, Du solltest nicht ohne Grund da hinein "
     "gehen.");
  
  ASD(({"zentrum","dorfzentrum","zugang"}),
      "zentrum");
  
  ASD(("grund"),
      "grund");
   
  ASD(("rettung"),
      "rettung");
   
  ASD(({"wachen","krieger"}),
      "torwachen");
   
  AD(({"tor","palisadentor","holzpalisade"}),
     "Das Palisadentor reicht nahezu bis zum Rand der Holzpalisade. Es ist unmoeglich sie "
     "zu ueberklettern. Ins Dorfzentrum kommst Du nur durch dieses Tor.");

  AD(({"ueberklettern","palisadenrand","rand"}),
     "Der Palisadenrand ist zu hoch. Ausserdem sind die Holzpfaehle sehr spitzt.");
   
  AD(({"pfaehle","holzpfaehle","pfahl","holzpfahl","palisadenpfahl","palisadenpfaehle"}),
     "Dicke Holzpfaehle bilden die Palisade. Auf ihren Spitzen stecken Schaedel getoeter "
     "Feinde.");

  AD(({"innere palisade","palisade","zweite palisade"}),
     "Die Palisade scheint das gesamte Dorfzentrum zu umschliessen und bildet einen zweiten "
     "Schutz.");
  
  AD(({"aeussere palisade"}),
     "Durch die aeussere Palisade weiter im Norden gelangst Du zurueck in den Dschungel.");
   
  AD(({"norden","dschungel"}),
     "Das Kannibalendorf liegt gut geschuetzt tief im Dschungel.");
   
  AD(("schutz"),
     "Wenn es Feinden gelingen sollte die aeussere Palisade zu durchbrechen, waere das "
     "Dorfzentrum noch immer durch diese zweite Palisade geschuetzt.");
       
  AD(({"spitzen","palisadenspitzen"}),
     "Ein Ueberklettern der Palisade wird durch die angespitzen Holzpfaehle unmoeglich.");
   
  AD(({"feinde","koepfe","kopf","schaedel","totenschaedel"}),
     "Einige Schaedel sind nur noch ausgebleichte Totenschaedel, aber manche scheinen erst seit "
     "kurzem dort zu stecken.");
   
  AD(("feind"),
     "Wenn die Kannibalen Dich fuer einen Feind halten wuerden, dann haetten sie Dich schon "
     "getoetet.");
   
  AD(({"traeger","tijara","soldaten","garde","stadtgarde","gardisten","gardist"}),
     "Einige Schaedel tragen die typischen Helme der Stadtgarde von Tijara. Anscheinend stammen "
     "die meisten Schaedel von Soldaten.");
   
  AD(({"helme","helm"}),
     "Viele Helme sind schon total verrostet, aber ein paar Helme glaenzen noch wie frisch "
     "poliert. Anscheinend hat erst vor kurzem ein Kampf mit den Gardisten statt gefunden. "
     "Sie haben sogar noch die Loecher und Beulen, an denen ihre ungluecklichen Traeger "
     "gestorben sind.");

  AD(({"loecher","beulen"}),
     "Jetzt stecken ihre abgeschlagenen Koepfe auf den Palisadenpfaehlen und doerren in der "
     "Sonne, grauenhaft.");
      
  AD(({"bruecke","posten","vorposten","kampf"}),
     "Die Gardisten beim Vorposten an der Bruecke koennen Dir sicher etwas darueber sagen.");
   
  AD(({"sonne","himmel"}),
     "Der Himmel ist strahlend blau. Die Sonne brennt heiss auf den trockenen Lehm.");
   
  AD(("lehm"),
     "Der Lehm ist trocken und hart.");
      
  AD(({"boden","strasse","lehmstrasse"}),
     "Die Boden besteht aus fest gestampften Lehm und ist steinhart.");

  AD(("trocknen"),
     "Durch das Trocknen in der Sonne werden die Fische haltbar.");

  AD(("dorf"),
     "Du bist schon weit im Dorf der Kannibalen. Du stehst direkt vor dem inneren Tor zum "
     "Dorfzentrum.");
   
  AD(("kannibalen"),
     "Bis jetzt hast Du erst erstaunlich wenige Kannibalen gesehen.");
   
  ASD(({"fisch","fische"}),
      "fisch");
   
  ASD(("strick"),
      "strick");

  ASD(("besitzer"),
      "besitzer");
   
  ASD(("ruhe"),
      "ruhe");         
   
  ASD(("haeuptling"),
      "haeuptling");
     
  AddSound(DEFAULT_SOUND, "Das Dorf scheint eigenartig ruhig zu sein. Anscheinend sind "
	   "die Kannibalen Dir gegenueber sehr misstrauisch.\n");

  AddSmell(DEFAULT_SMELL, "Es riecht hier nach Fisch und einem unangenehmen Geruch der von "
	   "den Palisadenspitzen herunter weht.\n");
  AddSmell( ({"geruch","verwesungsgeruch","verwesung"}),
	    "Ein schwacher, suesslicher Verwesungsgeruch weht herab.");   

  AddItem("/d/dschungel/trintrasil/dorfneu/npc/wache", REFRESH_DESTRUCT);
  AddItem("/d/dschungel/trintrasil/dorfneu/npc/wache", REFRESH_DESTRUCT);
  
  AddCmd(({"nimm","nehme","stiehl","stehl","stehle"}), "fisch_func");
      
  AddExit("norden", "./roomd3");
  AddExit("sueden", ([EX_FUNC: "r_3func"]));
}

string _query_int_long() 
{
  if(present("wache"))
    return(BS("Die breite Lehmstrasse endet hier vor einem zweiten grossen "
	      "Palisadentor, dass ebenfalls von zwei grimmig blickenden Kriegern bewacht "
	      "wird. Auf den Pfaehlen stecken Schaedel, die teilweise noch die Helme der "
	      "Stadtgarde von Tijara tragen. Ein paar Schaedel scheinen noch recht frisch "
	      "zu sein. Ueber die Strasse ist ein Strick gespannt, an dem Fische zum "
	      "Trocknen aufgehaengt sind"));
  
  return(BS("Die breite Lehmstrasse endet hier vor einem zweiten grossen "
	    "Palisadentor, dass eigenartligerweise nicht bewacht ist. Auf den Pfaehlen "
	    "der Palisade stecken Schaedel, die teilweise noch die Helme der Stadtgarde "
	    "von Tijara tragen. Ein paar Schaedel scheinen noch recht frisch zu sein. "
	    "Ueber die Strasse ist ein Strick gespannt, an dem Fische zum Trocknen "
	    "aufgehaengt sind"));
}
	
r_3func() 
{
  if(TP->QueryQuest("1000 Qualen im Dorf der Kannibalen"))
    return write(BS("Die Kannibalen haben sicher nicht vergessen, dass Du ihren "
		    "Haeuptling getoetet hast. Du beschliesst das innere Dorf lieber "
		    "nicht zu betreten.")), 1;
  
  if(!present("\nkd_quest",TP))
    return write(BS("Das Palisadentor ist gerade verschlossen. Du kommst nicht in das "
		    "innere Dorf.")), 1;
	
  if(present("wache", TO))
    return write(BS("Die Kannibalenkrieger lassen Dich nicht durch das geoeffnete Tor "
		    "gehen.")), 1;
	
  write(BSL("\nMit einem mulmigen Gefuehl betrittst Du das innere Kannibalendorf, "
	    "in dem der Haeuptling wohnt.\n\n"));
  return "/d/dschungel/charon/dorfneu/room/room_r3:"+getuid(TP);
}

int wachen() 
{
  if(present("wache"))
    return 1;
  
  return 0;
}

int fisch_func(string str) {
	
  string dieb;
  object fisch;
  dieb = TP->name();
  
  notify_fail("Was willst Du stehlen?\n");
  
  if(str=="fisch"||str=="fische"||str=="fisch von strick"||str=="fische von strick"||
     str=="fisch von leine"||str=="fische von leine") 
    {
      if(HUETTE->ownerpresent()) 
	{//mit REFRESH_DESTRUCT wird sicher gestellt dass es nur einen besitzer gibt
			
      if(fischz<1) {
				
	write(BS("Auf dem Strick haengen keine Fische mehr."));
					
	return 1;
      }
			
      if(fischz==1) {
				
	write(BSL("Du stiehlst den letzten Fisch vom Strick.\nPloetzlich "
		  "stuermt ein wuetender Kannibale aus einer Huette und "
		  "fuchtelt schimpfend mit einem Kuechenmesser vor deinem "
		  "Gesicht herum."));
	say(BSL(""+TPN+" stiehlt einen Fisch.\nEin wuetender Kannibale "
		"kommt aus einer Huette."));
	HUETTE->ownermove();
	present("owner", TO)->more_aggression(dieb);
	fisch = CLONEOB("/d/dschungel/trintrasil/dorfneu/obj/fisch");
	fisch->move(TP, M_NOCHECK);
	fischz--;
	return 1;
      }
			
      if(fischz>1) {//anzahl der fische am strick
				
	write(BSL("Du stiehlst einen Fisch vom Strick.\nPloetzlich "
		  "stuermt ein wuetender Kannibale aus einer Huette und "
		  "fuchtelt schimpfend mit einem Kuechenmesser vor deinem "
		  "Gesicht herum."));
	say(BSL(""+TPN+" stiehlt einen Fisch.\nEin wuetender Kannibale "
		"kommt aus einer Huette."));
	HUETTE->ownermove();//kannibale wird aus huette hierher bewegt
	present("owner", TO)->more_aggression(dieb);//aggressivitaet wird beim kannibalen erhoeht und string fischdieb uebergeben
	fisch = CLONEOB("/d/dschungel/trintrasil/dorfneu/obj/fisch");
	fisch->move(TP, M_NOCHECK);
	fischz--;
	return 1;
      }
    }
		
    if( HUETTE->ownerpresent()==0 && present("owner", TO) ) {
			
      if(fischz<1) {
			
	write(BS("Auf dem Strick haengen keine Fische mehr."));
	return 1;
      }
			
      if(fischz==1) {
				
	write(BSL("Du stiehls den letzten Fisch vom Strick.\n"
		  "Der rundliche Kannibale bruellt zornig auf."));
	say(BSL(""+TPN+" stiehlt einen Fisch vom Strick.\n"
		"Der rundliche Kannibale bruellt zornig auf."));
	present("owner", TO)->more_aggression(dieb);
	fisch = CLONEOB("/d/dschungel/trintrasil/dorfneu/obj/fisch");
	fisch->move(TP, M_NOCHECK);
	fischz--;
	return 1;
      }
			
      if(fischz>1) {
				
	write(BSL("Du stiehlst einen Fisch vom Strick.\n"
		  "Der rundliche Kannibale bruellt zornig auf."));
	say(BSL(""+TPN+" stiehlt einen Fisch vom Strick.\n"
		"Der rundliche Kannibale bruellt zornig auf."));
	present("owner", TO)->more_aggression(dieb);
	fisch = CLONEOB("/d/dschungel/trintrasil/dorfneu/obj/fisch");
	fisch->move(TP, M_NOCHECK);
	fischz--;
	return 1;
      }
    }
		
    if( HUETTE->ownerpresent()==0 && !present("owner", TO) ) {
			
      if(fischz<1) {
				
	write(BS("Auf dem Strick haengen keine Fische mehr."));
	return 1;
      }
			
      if(fischz==1) {
				
	write(BSL("Du nimmst den letzen Fisch vom Strick.\n"
		  "Gut, dass das der Besitzer nicht gesehen hat."));
	say(BSL(""+TPN+" stiehlt einen Fisch vom Strick.\n"
		"Gut, dass das der Besitzer nicht gesehen hat."));
	fisch = CLONEOB("/d/dschungel/trintrasil/dorfneu/obj/fisch");
	fisch->move(TP, M_NOCHECK);
	fischz--;
	return 1;
      }
			
      if(fischz>1) {
				
	write(BSL("Du nimmst einen Fisch vom Strick.\n"
		  "Gut, dass das der Besitzer nicht gesehen hat."));
	say(BSL(""+TPN+" stiehlt einen Fisch vom Strick.\n"
		"Gut, dass das der Besitzer nicht gesehen hat."));
	fisch = CLONEOB("/d/dschungel/trintrasil/dorfneu/obj/fisch");
	fisch->move(TP, M_NOCHECK);
	fischz--;
	return 1;
      }
    }
  }
}

							 			

//+++++++++++++++++++++++++++++ SpecailDetails +++++++++++++++++++++++++++++++++++++++++++++++++

string zentrum() 
{
  if(TP->QueryQuest("1000 Qualen im Dorf der Kannibalen"))
    if(present("wache"))
      return(BS("Das Innere des Dorfes ist gut bewacht. Du hast den Haeuptling der "
		"Kannibalen schon getoetet, Du solltest Dich vom Dorfzentrum fern halten, "
		"bevor sich die Kannibalen an Dir raechen."));
  else
    return(BS("Du hast den Haeuptling der Kannibalen schon getoetet, Du solltest "
	      "Dich vom Dorfzentrum fern halten, bevor sich die Kannibalen an Dir raechen, "
	      "auch wenn das Tor gerade zu sein scheint."));
  else
  if(present("wache"))
    return(BS("Im gut bewachten Inneren des Dorfes lebt sicher der Haeuptling. "
	      "Wenn Du zu ihm gelangen willst musst Du erst an den Wachen vorbei, und die "
	      "sehen nicht so aus als wuerden sie es Dir leicht machen wollen."));
  else
    return(BS("Eigenartigerweise scheint das Tor zum Dorfzentrum gerade "
	      "unbewacht zu sein, obwohl dort sicher der Haeuptling der Kannibalen lebt."));
}

string grund() 
{
  if(TP->QueryQuest("1000 Qualen im Dorf der Kannibalen") ) 
    return(BS("Du hast einmal Carolina aus dem Dorf gerettet. Jetzt gibt es "
	      "keinen Grund mehr fuer Dich da hinein zu gehen."));
	
    if(present("\nkd_quest",TP)) 
      return(BS("Die Rettung Carolinas ist Grund genug."));
  
    return(BS("Wenn Du jemand aus dem Dorf retten muesstest, dann haettest Du "
	      "einen Grund in das Dorfzentrum vorzudringen, aber so nicht."));
}

string torwachen() {
	
  if(present("wache")) 
    return(BS("Die Krieger betrachten Dich misstrauisch, Ihnen waere es wohl "
	      "lieber Du wuerdest hier verschwinden."));
  else
    return(BS("Welche Krieger meinst Du? Das Tor ist seltsamerweise unbewacht."));
}

string rettung() 
{
  if(TP->QueryQuest("1000 Qualen im Dorf der Kannibalen")) 
    return(BS("Du hast Carolina schon gerettet"));
  	
  if(present("\nkd_quest",TP)) 
    return(BS("Beeil Dich, sonst toeten die Kannibalen Carolina waehrend Du "
	      "hier herumtroedelst."));
  
  return(BS("Hmm. Dir ist nicht bekannt das jemand im Dorfzentrum gefangen "
	    "waere und Dich braeuchte."));
}

string strick() 
{
  if(fischz) 	
    if(fischz>1)
      return(BS("Ueber die Strasse wurde ein Strick gespannt auf dem "+fischz+" "
		"Fische zum Trocknen aufgehaengt sind. Du solltest sie lieber in Ruhe "
		"lassen."));
    else
      return(BS("Ueber die Strasse wurde ein Strick gespannt auf dem nur noch ein "
		"Fisch zum Trocknen in der Sonne haengt. Anscheined hat schon jemand einige "
		"herunter genommen."));
  
  return(BS("Ueber die Strasse wurde ein Strick gespannt, der dem Geruch nach "
	    "zu schliessen zum Trocknen von Fischen verwendet wurde, Aber anscheinend hat "
	    "schon jemand alle Fische herunter genommen."));
}

string fisch() 
{
  if(fischz)
    if(fischz>1)
      return(BS("Es haengen "+fischz+" Fische auf dem Strick die Du stehlen koenntest. "
		"Allerdings wuerde der Besitzer der Fische nicht besonders erfreut sein."));
    else
      return(BS("Es haengt zwar nur mehr ein Fisch auf dem Strick, trotzdem wuerde "
		"der Besitzer wahrscheinlich boese werden wenn Du ihm den letzen Fisch "
		"stiehlst."));
  
  return(BS("Der Strick ist leer. Anscheinend hat schon jemand alle Fische "
	    "herunter genommen."));
}

string besitzer() 
{
  if(present("owner")) 
    if(fischz)
      return(BS("Reg den Kannibalen lieber nicht weiter auf, sonst koennte es "
		"hier ungemuetlich fuer Dich werden."));
    else
      return(BS("Der Kannibale ist sehr zornig dass ihm jemand seine Fische gestohlen "
		"hat."));

  if(fischz)
    return(BS("Der Besitzer ist gerade nicht da. Du solltest Dir trotzdem gut "
	      "ueberlegen ob Du einen Fisch stehlen willst."));
  
  return(BS("Der Strick ist ohnehin leer. Fall hier lieber nicht ungut auf."));
}

string ruhe() 
{
  if(present("owner", TO)) 
    return(BS("Der Kannibale regt sich fuerchterlich auf weil ihm jemand "
	      "Fische von seinem Strick gestohlen hat."));
  
  if(fischz)
    return(BS("Wenn Du einen Fisch stiehlst bleibt es sicher nicht so ruhig."));
  
  return(BS("Noch ist hier alles ruhig, hoffentlich bleibt es dabei."));
}

string haeuptling() 
{
  if(TP->QueryQuest("1000 Qualen im Dorf der Kannibalen")) 
    return(BS("Den Haeuptling der Kannibalen hast Du schon getoetet. Anscheinend "
	      "haben Dich die Kannibalen nicht erkannt. Sonst haetten sie Dich schon "
	      "laengst getoetet."));
  
	
  if(present("wache"))
    if(present("\nkd_quest",TP))
      return(BS("Der Haeuptling der Kannibalen lebt im inneren Dorf. Da Du Carolina "
		"befreien musst, musst Du ohnehin an den Wachen vorbei."));
    else
      return(BS("Die Wachen sehen nicht so aus als wuerden sie Dich vorbei lassen. "
		"Aber Du hast ja ohnehin keinen Grund ins innere Dorf vor zu dringen."));
  
  if(present("\nkd_quest",TP))
    return(BS("Der Weg ins innere Dorf ist frei. Dort wirst Du Carolina sicher "
	      "finden."));
  
  return(BS("Eigenartig, das innere Dorf ist anscheinend gerade unbewacht. "
	    "Aber Du hast eigentlich keinen Grund in das Dorf vor zu dringen."));
}
