
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "/d/dschungel/trintrasil/myowndefine.h"

#define ROOMD2 "/d/dschungel/trintrasil/dorfneu/room/roomd2"


void create()
{
   ::create();

   SetProp(P_INT_SHORT, "Im Kannibalendorf");
   SetProp(P_INT_LONG,
      "Du stehst am Ausgang des Kannibalendorfes. Die strohgedeckten Bambushuetten stehen "
      "dicht nebeneinander, links und rechts der breiten, gestampften Lehmstrasse auf "
      "der Du Dich gerade befindest. Nach Sueden fuehrt die Strasse ueber einen Dorfplatz "
      "weiter zu einem weiteren Tor.");

   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_ROAD ]) );
   
   SetProp("dorfraum", 1);//wird beim angreifen des alten Mannes benoetigt. wenn er im dorf
                          //ist eilen ihm kannibalen zur hilfe, ansonsten nicht.
   
   
   ASD(({"dorf","kannibalendorf"}),
   "dorf");
   
   ASD(("sueden"),
   "sueden");
   
   ASD(({"platz","dorfplatz"}),
   "platz");
   
   AD(({"siedler","kannibalen"}),
   "Es gab schon viele Kaempfe zwischen den Kannibalen und den Siedlern und da Du "
   "aussiehst wie jemand aus Tijara halten sie Dich anscheinend auch fuer einen.");
   
   AD(("kaempfe"),
   "Frag doch einmal die Wachsoldaten im Vorposten nach den Kannibalen.");
   
   AD(({"soldaten","wachsoldaten","posten","vorposten","wunder","erfahrungen"}),
   "Das Gouvernement hat einen Vorposten an der Bruecke eingerichtet wegen der staendigen "
   "Kaempfe.");
   
   AD(({"haengebruecke","bruecke"}),
   "Das Gouvernement hat weit im Norden eine Bruecke errichtet, die das Gebiet der Stadt "
   "Tijara mit diesem Teil des Dschungels verbindet.");
   
   AD(("teil"),
   "Dieser Teil des Dschungels ist schon weit abgelegen.");
   
   AD(({"tijara","gebiet","stadt","norden"}),
   "Tijara liegt weit im Norden von hier an der Kueste des Suedozeans.");
   
   AD(({"kueste","ozean","suedozean"}),
   "Wie bist Du denn hier her gekommen? Auf der Nudelsuppe?");
   
   AD(({"suppe","nudelsuppe"}),
   "Die Kannibalen werden Dir sicher keine Nudelsuppe spendieren.");
   
   AD(("dschungel"),
   "Tijara ist schon ganz schoen weit weg. Das Dorf liegt geschuetzt im tiefsten "
   "Dschungel.");
   
   AD(("gouvernement"),
   "Die Stadt Tijara hat schon seit langem nahezu staendig Kaempfe mit den "
   "Staemmen.");
   
   AD(({"stamm","staemme"}),
   "Der kriegerischste Stamm sind die Kannibalen. Aber tief im Dschungel leben noch andere "
   "Ureinwohner, von denen viele auch noch unbekannt sind.");
   
   AD(({"ureinwohner","einwohner"}),
   "Die Staemme lebten hier schon vor den Siedlern.");

   AD(({"bewohner","siedler"}),
   "Auch wenn die meisten Bewohner Tijaras dort geboren wurden, werden sie noch haeufig "
   "Siedler genannt.");
      
   AD(({"bambushuette","huette","huetten","bambushuetten"}),
   "Die Bambushuetten sind meistens eher niedrig und gedrungen, und sie stehen dicht "
   "beeinander. Aus manchen Huetten hoerst Du Geraeusche, woran Du erkennen kannst, dass "
   "sich anscheinend die meisten Kannibalen vor Dir verstecken.");
   
   AD(({"sonne","himmel"}),
   "Der Himmel ist strahlend blau. Die Sonne brennt heiss auf die trockene Lehmstrasse.");
   
   AD(({"boden","strasse","lehmstrasse"}),
   "Die Strasse besteht lediglich aus fest gestampften Lehm. Sie fuehrt nach Sueden weiter "
   "in das Dorf.");
   
   AD(("lehm"),
   "Der Lehm ist trocken und hart.");
   
   AD(("ausgang"),
   "Durch ein Tor gelangst Du aus dem Dorf in den Dschungel.");
   
   AD(("tor"),
   "Das massive Tor direkt im Norden von Dir ist mit zwei maechtigen Torfluegeln "
   "verschliessbar. Gottseidank sind die Torfluegel offen. Das zweite Tor im Sueden im "
   "Inneren des Dorfes kannst Du von hier aus nicht gut erkennen.");
   
   AD(({"innen","dorfinneres","inneres"}),
   "Geh weiter in das Dorf, wenn Du Dich traust.");
   
   AD(({"fluegel","torfluegel"}),
   "Die Torfluegel sind beinahe so hoch wie die Palisade und sehen sehr massiv aus.");
   
   AD(("palisade"),
   "Die hohe, hoelzerne Palisade umgibt das ganze Dorf und schuetzt es bei Angriffen.");
   
   AD(({"angriffe","angriff"}),
   "So tief in den Dschungel wagen sich die Soldaten aus Tijara ohnehin kaum vor.");

   AD(({"mitte","stelle","feuerstelle"}),
   "Die Feuerstelle auf dem Dorfplatz ist schon beinahe abgebrannt. Man muesste wieder "
   "Holz nachlegen.");
   
   AD(("holz"),
   "Vielleicht findest Du welches im Dschungel.");
   
   AD(({"rauch","rauchfahne","fahne"}),
   "Der duenne Rauch steigt zaghaft in den Himmel und wird schnell verweht.");      
   
     
   AddSound(DEFAULT_SOUND, "Das Dorf scheint eigenartig ruhig zu sein. Anscheinend sind "
   "die Kannibalen Dir gegenueber sehr misstrauisch.");

   AddSound(({"geraeusch","geraeusche"}),
   "Du hoerst die Kannibalen in ihren Huetten.");
   
   AddSmell(DEFAULT_SMELL, "Eine duenner Rauchgeruch weht durch das Dorf. Im Sueden erkennst "
   "Du ein kleines Feuer.");
   
   AddSmell( ({"feuer","rauch","geruch","rauchgeruch"}), 
   "Das Feuer ist nur klein und der Rauch wird schnell verweht");   
    
    AddItem("/d/dschungel/trintrasil/dorfneu/npc/kannibalin", REFRESH_DESTRUCT);
AddExit("norden", "/d/dschungel/charon/dorfneu/room/tor");
AddExit("sueden", "./roomd2");
}

dorf() {
	
	if( ROOMD2->kannibalen()==0 ) {
		
		return(BS("Das Dorf liegt wie ausgestorben vor Dir, es scheint als "
		"wuerden sich die Kannibalen vor Dir verstecken."));
	}
	
	if( ROOMD2->kannibalen()!=0 ) {
		
		return(BS("Bis auf ein paar unfreundlich aussehende Krieger im Sueden "
		"des Dorfes sind die Dorfstrassen leer. Es scheint als wuerden sich die "
		"Kannibalen vor Dir verstecken."));
	}
}


sueden() {
	
	if( ROOMD2->kannibalen()==0 ) {
		return(BS("Die Lehmstrasse fuehrt nach Sueden auf einen kleinen "
		"Dorfplatz."));
	}
	
	if( ROOMD2->kannibalen()!=0 ) {
		return(BS("Die Lehmstrasse fuehrt nach Sueden auf einen kleinen "
		"Dorfplatz, auf dem ein paar Krieger stehen und unfreundlich zu "
		"Dir herueber blicken."));
	}
}


platz() {
	
	if( ROOMD2->kannibalen()==0 ) {
		return(BS("Der Dorfplatz wirkt genauso verlassen und leer wie das restliche "
		"Dorf. In der Mitte befindet sich eine kleine Feuerstelle von der eine "
		"duenne Rauchfahne aufsteigt."));
	}
	
	if( ROOMD2->kannibalen()!=0 ) {
		return(BS("Auf dem Dorfplatz siehst Du ein paar Kannibalenkrieger stehen, "
		"hoffentlich bekommst Du mit ihnen keine Porbleme. In der Mitte befindet sich "
		"eine kleine Feuerstelle von der eine duenne Rauchfahne aufsteigt."));
	}
}


probleme() {
	
	if( ROOMD2->kannibalen()==0 ) {
		return(BS("Du siehst keine Kannibalen, also erwartest Du auch keine Probleme."));
	}
	
	if( ROOMD2->kannibalen()!=0 ) {
		return(BS("Die Kannibalen mustern Dich nicht gerade freundlich. Kein "
		"Wunder bei ihren Erfahrungen mit Siedlern."));
	}
}