//anhaengfertig und getestet

#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";


create()
{
  ::create();

AddItem("/d/dschungel/trintrasil/dorfneu/npc/besitzer",
        REFRESH_DESTRUCT);
        
AddItem("/d/dschungel/trintrasil/dorfneu/npc/kinder",
        REFRESH_DESTRUCT);
        
AddItem("/d/dschungel/trintrasil/dorfneu/npc/mutter",
        REFRESH_DESTRUCT);
}


kinderpresent() {
	
	if(present("kinderschar", TO)) {
		
		return 1;
	}
	
	if(!present("kinderschar", TO)) {
		
		return 0;
	}
}


mutterpresent() {
	
	if(present("mutter", TO)) {
		
		return 1;
	}
	
	if(!present("mutter", TO)) {
		
		return 0;
	}
}


ownerpresent() {
		
	if(present("owner")) {
		return 1;
	}
	
	if(!present("owner")) {
		return 0;
	}
}


kindermove() {
	
	object kinder;
	
	kinder=present("kinderschar", TO);
	
	if(kinder) {
		
		kinder->move("/d/dschungel/trintrasil/dorfneu/room/roomd4",
		M_TPORT);
		kinder->SetProp("ausserhaus", 1);
	}
	
	if(!kinder) {
		
		return 0;
	}
}


muttermove() {
	
	object kinder, mutter;
	kinder = find_living("kannibalenkinderschar");
	mutter = present("kannibalin", TO);
	
	if(kinder && kinder->QueryProp("ausserhaus")==1 ) {
		
		tell_room(ENV(kinder), BSL("\nEine zornig schimpfende Kannibalin kommt "
		"an und treibt die Kinder haendeklatschend in die naechste Huette.\n"
		"Beim Schliessen der Huettentuer droht sie Dir noch knurrend mit der "
		"Faust.\n\n"));
		kinder->go_home();
	}
}


ownermove(string dieb) {

object besitzer;
besitzer=present("owner", TO);	
	
	if(besitzer) {
		
		besitzer->move("/d/dschungel/trintrasil/dorfneu/room/roomd6",
		M_TPORT+ M_SILENT);
	}
	if(!besitzer) {
		return 0;
	}
}
	
		  