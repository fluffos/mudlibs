
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
   ::create();

   SetProp(P_INT_SHORT, "Im Kannibalendorf");
   SetProp(P_INT_LONG,
      "Du befindest Dich auf einem kleinen Dorfplatz mit einer Feuerstelle. Niedrige, "
      "dichtgedraengte Bambushuetten umringen den Platz. Lediglich ein paar Krieger "
      "stehen bei der Feuerstelle, beobachten Dich feindselig und unterhalten sich "
      "aufgeregt in einer Dir unverstaendlichen Sprache.");

   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_ROAD ]) );
   
   SetProp("dorfraum", 1);
   
   
   ASD(({"platz","dorfplatz","mitte","platzmitte"}),
   "platz");
   
   AD(({"feuerstelle","stelle","feuer"}),
   "Wenn Du Holz nachlegen wuerdest wuerde das Feuer vielleicht wieder zu lodern "
   "beginnen.");
   
   AD(("holz"),
   "Geeignetes Holz findest Du wahscheinlich im Dschungel.");

   AD(({"dorf","kannibalendorf","kannibalen"}),
   "Die Kannibalen verstecken sich anscheinend vor Dir. Der Dorfplatz wirkt beinahe "
   "fluchtartig verlassen.");
   
   AD(({"eile","flucht"}),
   "Auf dem Boden siehst noch einige wie in Eile verlorene Gegenstaende.");
   
   AD(({"messer","taschenmesser","sandale","gegenstaende","gegenstand"}),
   "Ein Taschenmesser und eine Sandale liegen wie eilig verloren auf dem Boden. Du laesst "
   "sie besser liegen.");
   
   AD(("boden"),
   "Der Dorfplatz besteht ebenfalls aus fest gestampftem Lehm. Er sieht fluchtartig "
   "verlassen aus. Einige verlorene Gegenstaende der Kannibalen liegen noch herum.");
   
   AD(("lehm"),
   "Der Lehm ist trocken und hart von der Sonne.");
   
   AD(({"sonne","himmel"}),
   "Der Himmel ist strahlend blau. Die Sonne brennt heiss auf den trockenen Boden.");
  
   AD(("dschungel"),
   "Das Dorf liegt umgeben von tiefem Dschungel.");

   AD(("sprache"),
   "Du kannst die Sprache nicht verstehen. Trotzdem hoerst Du ganz genau das die Krieger "
   "nicht gerade freundlich von Dir sprechen.");   
    
   AD(({"huette","bambushuette"}),
   "Die Huetten bestehen aus dicken Bambusstaemmen und sind mit Stroh gedeckt.");
   
   AD(({"lagen","stroh"}),
   "Die niedrigen Huetten sind mit dicken Lagen gelbem Stroh gedeckt.");
   
   AD(({"staemme","bambusstaemme","bambus"}),
   "Bambus waechst reichlich hier in der Naehe des Flusses. Obwohl er sehr leicht ist, "
   "ist er sehr stabil.");
   
   AD(({"rio","rio de la puseta","naehe","fluss"}),
   "Der Fluss fliesst im Norden am Dorf vorbei, Du musst ihn kennen.");
   
   AD(("hitz"),
   "Auf diesem Dorfplatz ist es extrem heiss.");
    
   AddSound(DEFAULT_SOUND, "Das Dorf scheint eigenartig ruhig zu sein. Anscheinend sind "
   "die Kannibalen Dir gegenueber sehr misstrauisch.");

   AddSmell(DEFAULT_SMELL, "Ein duenner Rauchgeruch steigt von der Feuerstelle auf.");
   AddSmell( ({"feuer","rauch","geruch","rauchgeruch"}), 
   "Das Feuer ist nur klein und der Rauch wird schnell verweht");   


   AddCmd(({"zuende","lege"}), "feuer");
   
   
   AddItem("/d/dschungel/trintrasil/dorfneu/npc/muschelkrieger", REFRESH_DESTRUCT);
   AddItem("/d/dschungel/trintrasil/dorfneu/npc/krieger", REFRESH_DESTRUCT);
   AddItem("/d/dschungel/trintrasil/dorfneu/npc/krieger", REFRESH_DESTRUCT);
   AddItem("/d/dschungel/trintrasil/dorfneu/npc/krieger", REFRESH_DESTRUCT);
   
       
AddExit("norden", "./roomd1");
AddExit("sueden", "./roomd3");
AddExit("suedwesten", "./roomd4");
}


_query_int_long()  {
	
	if(present("krieger", TO))  {
		
		return(BS("Du befindest Dich auf einem kleinen Dorfplatz mit einer Feuerstelle. "
		"Niedrige, dichtgedraengte Bambushuetten umringen den Platz. Lediglich ein paar "
		"Krieger stehen bei der Feuerstelle, beobachten Dich feindselig und unterhalten "
		"sich aufgeregt in einer Dir unverstaendlichen Sprache."));
        }
        
        else {
        	
        	return(BS("Du befindest Dich auf einem kleinen Dorfplatz mit einer "
        	"Feuerstelle, dichtgedraengte Bambushuetten umringen den Platz. Der "
        	"Dorfplatz ist verlassen und wirkt wie ausgestorben."));
       }
}

platz() {
	
	if(present("krieger", TO)) {
		
		return(BS("Der Dorfplatz ist klein und dicht von eng beieinander stehenden "
		"Huetten umgeben. Die Krieger die um die kleine, heruntergebrannte Feuerstelle "
		"in der Platzmitte herumstehen sehen Dich nicht gerade freundlich an."));
	}
	
	if(!present("krieger", TO)) {
		
		return(BS("Der Dorfplatz ist klein und dicht von eng beieinander stehenden "
		"Huetten umgeben. In der Platzmitte brennt eine beinahe erloschene "
		"Feuerstelle. Der Platz ist wie leergefegt."));
	}
}


kannibalen() {
		
	if(present("krieger")) {
		return 1;
	}
	
	if(!present("krieger")) {
		return 0;
	}
}


feuer(string str) {
	
	object ast, stock;
	ast = present("ast", TP);
	stock = present("stock", TP);
	
	if(str=="holz nach"||str=="feuerholz nach"||str=="ast nach"||str=="stock nach"||
	str=="holz auf feuerstelle"||str=="feuerholz auf feuerstelle"||str=="ast auf "
	"feuerstelle"||str=="stock auf feuerstelle"||str=="holz auf feuer"||str=="feuerholz "
	"auf feuer"||str=="ast auf feuer"||str=="stock auf feuerstelle"||str=="holz in feuer"||
	str=="feuerholz in feuer"||str=="ast in feuer"||str=="stock in feuer"||str=="holz an"||
	str=="feuerholz an"||str=="ast an"||str=="stock an"||str=="holz"||str=="feuerholz"||
	str=="ast"||str=="stock") {
		
		if(!ast && !stock) {
			
			write(BS("Du hast doch gar kein Holz zum Nachlegen."));
			return 1;
		}
		
		if(ast) {
			write(BSL("Du legst einen Ast in das zoegerliche Feuer. Es flackert "
			"zwar muede auf, ansonsten passiert aber nichts.\nDu hast aber "
			"ohnehin besseres zu tun als bei dieser Hitze Holz nach zu legen."));
			say(BS(""+TPN+" legt einen trockenen Ast in das kleine Feuer."));
			ast->remove();
			return 1;
		}
		
		if(stock) {
			write(BSL("Du legst einen Ast in das zoegerliche Feuer. Es flackert "
			"zwar muede auf, ansonsten passiert aber nichts.\nDu hast aber "
			"ohnehin besseres zu tun als bei dieser Hitze Holz nach zu legen."));
			say(BS(""+TPN+" legt einen trockenen Ast in das kleine Feuer."));
			stock->remove();
			return 1;
		}
			
	}
	
	else {
		return 0;
	}
}
