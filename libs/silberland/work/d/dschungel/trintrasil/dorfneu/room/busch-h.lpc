inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Eine Lichtung");
   SetProp(P_INT_LONG,
   "Du befindest Dich auf einer kleinen Lichtung hinter dem Gebuesch, die von dichtem "
   "Dschungel umringt ist. Hier hat sich einmal Kai versteckt bis Du ihm geholfen hast "
   "seine Tochter von den Kannibalen zu befreien.");

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:25, ENV_TERRAIN:TT_JUNGLE ]) );

   AD(({"vegetation","lichtung"}),
   "Die Lichtung ist sehr klein und schattig und von dichtem Dschungel umwuchert.");
   
   AD(("dschungel"),
   "Du befindest Dich mittem im suedlichen Dschungel.");
   
   AD(("suedlicher dschungel"),
   "Du bist weit weg von Tijara tief im Sueden des Gebietes des Rio de la Puseta.");
   
   AD(({"sueden","fluss","rio","rio de la puseta","puseta"}),
   "Du hoerst den Fluss noch leise rauschen.");
   
   AD(({"norden","tijara"}),
   "Tijara liegt weit im Norden von hier.");
   
   AD(({"gebuesch","busch","gestruepp"}),
   "Du gelangst durch das dichte Gestruepp im Osten auf den Trampelpfad zurueck.");
   
   AD(({"pfad","trampelpfad"}),
   "Das Gebuesch ist sehr dicht, sodass die Lichtung vom Trampelpfad aus gut versteckt ist.");
   
   AD(({"lehm","boden","fuesse","fuss","erdreich"}),
   "Der Boden ist hier feucht und mit dichtem langem Gras bewachsen.");
   
   AD(("gras"),
   "Da die Lichtung sehr schattig ist ist das saftige, dunkle Grass hier sehr feucht.");
   
   AD(("himmel"),
   "Der Himmel ist nahezu vollkommen von den Laubdaechern versteckt.");
   
   AD(({"daecher","laubdaecher"}),
   "Die dicht um die Lichtung wachsenden Baeume verdecken den Himmel nahezu vollstaendig.");
   
   AD(({"riesen","dschungelriesen","baum","baeume","schatten"}),
   "Auf der Lichtung ist es durch die Schatten der grossen Dschungelriesen angenehm kuehl.");
   
   AD(("regen"),
   "Hier im Dschungel regnet es nahezu taeglich.");

   AD(({"mann","kai"}),
   "Kai war ein alter, kranker und halb verbloedeter Mann dem Du geholfen hast. Du wirst "
   "Dich wohl noch erinnern koennen!");
   
   AD(({"tochter","carolina"}),
   "Du wirst Dich wohl noch an Carolina erinnern koennen!");
   
   AD(("kannibalen"),
   "Das Dorf der Kannibalen ist hier ganz in der Naehe.");
   
   AD(({"dorf","naehe","sueden"}),
   "Folge einfach dem Trampelpfad vor dem Gebuesch. Du kannst es garnicht verfehlen.");
      
       
   /*** Geraeusche ***/
     
   AddSound(DEFAULT_SOUND, "Du kannst das Rauschen der Vegetation hoeren, wenn"
        " der Wind durch die Baeume faehrt.\n");
         
   AddSound(({"rauschen","wind"}), 
   "Die grossen Baeume wiegen sanft knarrend im Wind.");
   
   
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, "Du riechst den Lehm unter Deinen Fuessen.\n");
   AddSmell( ({"lehm"}), "Durch den Regen ist das Erdreich"
      " durchnaesst und riecht nun erfrischend.");
        
   AddExit("osten", ([
          EX_FUNC:"gebuesch",
          EX_PLMSG:"\nDu kriechst durch das dichte Gebuesch nach osten.\n\n"]));    
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
gebuesch() {
	
	TP->move("/d/dschungel/trintrasil/dorfneu/room/room9", M_GO, "mit lautem Knacken von "
	"Aesten nach osten","kriecht","kriecht aus dem Gebuesch");
return 1;}  