//anhaengfertig und getestet

#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

inherit "std/room";

int owner_int = 0;
int helmfertig = 0;


create()
{
  ::create();


}

helm_da() {
	
	if(present("kaimanhelm", TO)) {
		
		return 1;
	}
	
	else {
		return 0;
	}
}


besitzer_ermitteln(kaeufer) {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( inv[i]->QueryProp("besitzer")!=""+kaeufer+"" )  {

		}
		
		if( inv[i]->QueryProp("besitzer")==""+kaeufer+"" ) {
			
			owner_int ++;
			
			if( inv[i]->QueryProp("zu_uebergeben")==1 ) {
				
				helmfertig ++;
			}
			
			if( !inv[i]->QueryProp("zu_uebergeben") ) {
				
			}
		}
	}
	
	if(owner_int==0 && helmfertig==0) {

		return -4;
	}
	
	if(owner_int>0 && helmfertig==0) {
		
		owner_int=0;
		return -3;
	}
	
	if(owner_int>0 && helmfertig>0) {
		
		owner_int=0;
		helmfertig=0;
		return -2;
	}
	
	else {
		
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", "ALARM! Melde das bitte "
		"Trint!\n");
	}
}



gib_helm(kunde, kaeufer) {//kunde=TP kaeufer=TPN//kaeufer muss als einheitlicher string 
                          //uebergeben werden (nicht kunde->name()!!!!)
	int i;
	object *inv, *exclude;
	string *helmfarbe;
	inv=all_inventory(this_object());
	exclude=({});
	
	helmfarbe=({});
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( inv[i]->QueryProp("besitzer")!=""+kaeufer+"" )  {

		}
		
		if( inv[i]->QueryProp("besitzer")==""+kaeufer+"" ) {
			
			owner_int ++;
			
			if( inv[i]->QueryProp("zu_uebergeben")==1 ) {
				
				exclude += ({kunde});
				helmfarbe=inv[i]->QueryProp(P_NAME_ADJ);
				
				if( catch(tell_object(kunde, BS("Mombassa gibt Dir einen "
				""+helmfarbe[0]+"en Kaimanhelm."))) ) {
					
					tell_object(kunde, BS("Mombassa gibt Dir einen "
					"Kaimanhelm."));
				}
				
				if( catch(tell_room("/d/dschungel/trintrasil/dorfneu/room/momb",
				BS("Mombassa gibt "+kaeufer+" einen "+helmfarbe[0]+"en "
				"Kaimanhelm."), exclude)) ) {
					
					tell_room("/d/dschungel/trintrasil/dorfneu/room/momb",
					BS("Mombassa gibt "+kaeufer+" einen Kaimanhelm."), exclude);
				}
				
				helmfertig ++;
				
				if( inv[i]->move(kunde, M_GET+ M_SILENT)==ME_TOO_HEAVY ) {
					tell_object(kunde, BSL("Der Helm ist Dir zu schwer.\n"
					"Mombassa legt ihn vor Dich hin."));
					inv[i]->move(ENV(kunde));
				}
			}
			
			if( !inv[i]->QueryProp("zu_uebergeben") ) {
				
			}
		}
	}
	
	if(owner_int==0 && helmfertig==0) {

		return -4;
	}
	
	if(owner_int>0 && helmfertig==0) {
		
		owner_int=0;
		return -3;
	}
	
	if(owner_int>0 && helmfertig>0) {
		
		owner_int=0;
		helmfertig=0;
		return -2;
	}
	
	else {
		
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", "ALARM! Melde das bitte Trint.\n");
	}
}	
	