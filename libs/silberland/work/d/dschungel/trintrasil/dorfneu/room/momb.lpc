
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <doors.h>
#include "room.h"

#include "/d/dschungel/trintrasil/myowndefine.h"

#define TRUHE "/d/dschungel/trintrasil/dorfneu/room/truhe-h"



int anwesende_spieler = 0;
string sound_func(string was);

void create()
{
   ::create();

   SetProp(P_INT_SHORT, "Mombassas Werkstatt");
   SetProp(P_INT_LONG, BSL(
      "Hier, im vorderen Teil der Huette arbeitet Mombassa an den Ruestungen und Waffen. "
      "Auf einer einfachen Werkbank liegen einige Werkzeuge und unfertige Ruestungsteile. "
      "Am Boden liegt aufgestapeltes Holz, Felle, Leder und Metallteile.\nAuf einem Tisch "
      "liegt eine metallene Speerspitze, die Mombassa gerade schaerft. An den Waenden "
      "haengen auch einige Waffen, die Mombassa sicher nicht selbst hergestellt hat. In "
      "einer Ecke des Raumes siehst Du auch eine kleine, erloschene Feuerstelle."));

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_HOUSE ]) );
   
   
   ASD(("tisch"),
   "tisch");
   
   AD(({"helm","helme"}),
   "Welche Helme meinst Du? Die Gardistenhelme die hier im Raum sind, oder Kaimanhelme?");
   
   ASD(({"kaimanhelm","kaimanhelme"}),
   "helm");
      
   ASD(("kannibalen"),
   "kannibalen");

   ASD(({"gegenstand","gegenstaende"}),
   "gegenstand");
   
   ASD(({"spitze","speerspitze"}),
   "speer");
   
   
         
   AD(("teil"),
   "Hier im vorderen Teil der Huette arbeitet Mombassa. Der Wohnbereich ist durch eine "
   "Wand abgetrennt.");
   
   AD(({"feuer","ecke","stelle","feuerstelle"}),
   "In einer Ecke des Raumes befindet sich eine geloeschte, kalte Feuerstelle. Einige "
   "Gussformen sind daneben aufgestapelt.");
   
   AD(("arbeitsbereich"),
   "In dem befindest Du Dich gerade.");
   
   AD(({"wohnbereich","bereich","wand","wohn"}),
   "Den Wohnbereich kannst Du nicht einsehen. Den wirst Du auch nicht betreten koennen.");
   
   AD(({"ruestungen","waffen","materialien"}),
   "Mombassa scheint fuer seine Ruestungen und Waffen hauptsaechlich Knochen, Leder, "
   "und Holz zu verwenden. Aber Du siehst auch einige Metallteile.");
   
   AD(({"bank","werkbank","teile"}),
   "Auf einer Werkbank liegen Metall- und Ruestungsteile.");
   
   AD(({"metall","metallteile"}),
   "Mombassa setzt das Metall sehr sparsam ein. Er muss das wenige Metall sicher "
   "eintauschen.");
   
   AD(({"ruestungsteile"}),
   "Auf der Werkbank liegen die Teile eines Lederpanzers.");
   
   AD(({"panzer","lederpanzer"}),
   "Auf der Werkbank liegen die einzelnen, gehaerteten Teile des Lederpanzers.");
   
   AD(({"werkzeug","bohrer","feile","feilen","stein","steine","schleifstein",
   "schleifsteine","hammer","werkzeuge"}),
   "Auf der Werkbank liegen Zangen, verschieden grosse Bohrer, Feilen Schleifsteine und ein "
   "Hammer. Neben der Feuerstelle siehst Du ausserdem kleine Gussformen.");
   
   AD(({"felle","fell","knochen","holz","leder"}),
   "Mombassa hat alle Materialien die er gerade nicht braucht am Boden aufgestapelt.");
   
   AD(({"formen","gussformen","form","gussform"}),
   "Neben der Feuerstelle stehen einige Gussformen fuer Pfeile oder Speerspitzen, aber auch "
   "fuer kurze Klingen.");
   
   AD(({"schwerter","schwert","klinge","klingen"}),
   "Die Gussform neben der Feuerstelle reicht nur fuer kurze Klingen. Schwerter stellt "
   "Mombassa anscheinend nicht her.");
   
   AD(({"ding","dinge","spitzen","pfeilspitzen","speerspitzen","pfeil","pfeile"}),
   "In diese Gussformen giesst Mombassa aufgeschmolzenes Metall wenn er eines dieser "
   "Dinge herstellen will.");
   
   AD(("raum"),
   "Der Raum ist rund wie die Huette und in der Mitte unterteilt.");
   
   AD(("mitte"),
   "In der Mitte teilt eine Wand die Huette in Wohn und Arbeitsbereich.");
   
   AD(({"haut","krokodilhaut"}),
   "Die Holztuer ist beidseitig mit der Haut eines Riesenkaimans bespannt.");
   
   AD(({"kaiman","riesenkaiman"}),
   "Bei den Kannibalen ist der Riesenkaiman ein ganz besonderes Tier. Sie fertigen "
   "aus ihren Schaedeln Kaimanhelme.");
   
   AD(({"schaedel","raeuber","tier"}),
   "Wenn sie einen dieser gewaltigen Raeuber erlegen koennen natuerlich.");
   
   AD(({"huette","bambushuette"}),
   "Die Bambushuette ist geraeumig und gross, verglichen mit den anderen, gedrungenen "
   "Huetten.");
   
   AD(({"tijara","garde","stadtgarde","kaempfe","leute"}),
   "Die Siedler aus Tijara sind bei den Kannibalen durch die vielen Kaempfe mit der "
   "Stadtgarde sehr unbeliebt.");

   AD(("siedler"),
   "Auch wenn Du nicht aus Tijara stammst siehst Du ihnen aehnlich.");
      
   AD(("bezahlung"),
   "Mombassa wird den Helm wahrscheinlich gegen mehrere Gegenstaende tauschen wollen. "
   "Irgendwoher muss er ja das Metall fuer seine Ruestungen bekommen.");

   AD(("waende"),
   "An der Wand haeng ein paar Schwerter, Gardistenhelme und eine Hellebarde. Sie "
   "scheinen allesamt aus Tijara zu stammen.");
   
   AD(({"hellebarde","gardistenhelm","gardistenhelme"}),
   "Einige wird Mombassa wahrscheinlich eingetauscht haben. Aber manches stammt sicher "
   "von Ueberfaellen.");   
   
   AD(({"ueberfall","ueberfaelle"}),
   "Die Kannibalen liefern sich immer wieder Kaempfe mit der Stadtgarde aus Tijara.");
   
   AD(("boden"),
   "Der Boden besteht auch hier drinnen aus gestampften Lehm.");
   
   AD(("lehm"),
   "Hier drinnen ist er allerdings feuchter und weicher als draussen.");
   
   AD(({"lage","lagen","wedel","palmwedel","decke"}),
   "Die Huette ist mit dicken Lagen Palmwedel gedeckt.");
   
   
   AddCmd ("", "no", 1);
   AddCmd ("waehle", "no");

  
   AddSound(DEFAULT_SOUND, #'sound_func);
   
   
   AddSound(({"stimmen","geraeusche"}), BS("Du hoerst Stimmen und andere typische Geraeusche. "
   "Sie sind aber durch die Waende gedaempft."));


   AddItem("/d/dschungel/trintrasil/dorfneu/npc/mombassa.lpc", REFRESH_DESTRUCT);

       
NewDoor("osten","./roomd5",({"tuer","holztuer"}),
({D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
  D_LONG,"An die Holztuer wurde eine Krokodilhaut genagelt.\n",
  D_SHORT,"Eine %se Holztuer\n",
  D_NAME,"Holztuer",
  D_GENDER, FEMALE,
  D_FUNC2,"door_func_hau_ab",
  D_MSGS, ({"nach draussen","geht","kommt aus einer Huette"}) 
  }) );
}


_query_int_long() {
	
	if(present("mombassa", TO)) {
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/roomd5")==1) {
			
			return(BSL("Hier, im vorderen Teil der Huette arbeitet Mombassa an den "
			"Ruestungen und Waffen. Auf einer einfachen Werkbank liegen einige "
			"Werkzeuge und unfertige Ruestungsteile. Am Boden liegt aufgestapeltes "
			"Holz, Felle, Leder und Metallteile.\nAuf einem Tisch liegt eine "
			"metallene Speerspitze, die Mombassa gerade schaerft. An den Waenden "
			"haengen auch einige Waffen, die Mombassa sicher nicht selbst "
			"hergestellt hat. In einer Ecke des Raumes siehst Du auch eine kleine, "
			"erloschene Feuerstelle.\nEine goeffnete Holztuer."));
		}
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/roomd5")==-1) {
			
			return(BSL("Hier, im vorderen Teil der Huette arbeitet Mombassa an den "
			"Ruestungen und Waffen. Auf einer einfachen Werkbank liegen einige "
			"Werkzeuge und unfertige Ruestungsteile. Am Boden liegt aufgestapeltes "
			"Holz, Felle, Leder und Metallteile.\nAuf einem Tisch liegt eine "
			"metallene Speerspitze, die Mombassa gerade schaerft. An den Waenden "
			"haengen auch einige Waffen, die Mombassa sicher nicht selbst "
			"hergestellt hat. In einer Ecke des Raumes siehst Du auch eine kleine, "
			"erloschene Feuerstelle.\nEine geschlossene Holztuer."));
		}
	}
	
	if(!present("mombassa", TO)) {
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/roomd5")==1) {
			
			return(BSL("Es sieht so aus, als wuerden hier im vorderen Teil der "
			"Huette Waffen und Ruestungen hergestellt werden. Auf einer einfachen "
			"Werkbank liegen einige Werkzeuge und unfertige Ruestungsteile. Am "
			"Boden liegt aufgestapeltes Holz, Felle, Leder und Metallteile.\nAuf "
			"einem Tisch liegt eine metallene Speerspitze, die noch halb "
			"geschliffen ist. An den Waenden haengen auch einige Waffen, die "
			"fuer die Kannibalen sehr untypisch sind. In einer Ecke des Raumes "
			"siehst Du auch eine kleine, erloschene Feuerstelle.\n"
			"Eine geoeffnete Holztuer."));
		}
		
		if(DOOR_MASTER->QueryDoorStatus("/d/dschungel/trintrasil/dorfneu/room/roomd5")==-1) {
			
			return(BSL("Es sieht so aus, als wuerden hier im vorderen Teil der "
			"Huette Waffen und Ruestungen hergestellt werden. Auf einer einfachen "
			"Werkbank liegen einige Werkzeuge und unfertige Ruestungsteile. Am "
			"Boden liegt aufgestapeltes Holz, Felle, Leder und Metallteile.\nAuf "
			"einem Tisch liegt eine metallene Speerspitze, die noch halb "
			"geschliffen ist. An den Waenden haengen auch einige Waffen, die "
			"fuer die Kannibalen sehr untypisch sind. In einer Ecke des Raumes "
			"siehst Du auch eine kleine, erloschene Feuerstelle.\n"
			"Eine geoeffnete Holztuer."));
		}
	}
}


sound_func(string was) {
	
	if(present("mombassa" , TO)) {
		was=(BSL("TSSST TSSST TSSST TSSST\nMombassa schleift gerade eine Speerspitze."));
		return was;
		
	}
			
	was=(BS("Du hoerst Stimmen und andere typische Geraeusche. Sie sind aber durch die "
	"Waende gedaempft."));
	return was;
}


speer() {
	
	if(present("mombassa", TO)) {
		
		return(BS("Mombassa schleift gerade diese Speerspitze mit einem kleinen "
		"Schleifstein."));
	}
	
	if(!present("mombassa", TO)) {
		
		return(BS("Die Speerspitze am Tisch ist erst halb geschliffen."));
	}
}


tisch() {
	
	if(present("mombassa", TO)) {
		
		return(BS("Mombassa schleift gerade eine Speerspitze die auf "
		"dem Tisch liegt."));
	}
	
	if(!present("mombassa", TO)) {
		
		return(BS("Am Tisch liegt noch eine halb geschliffene Speerspitze."));
	}
}


helm() {
	
	if(present("mombassa", TO)) {
		
		return(BS("Mombassa weiss ueber diese Helme sicher bestens bescheid."));
	}
	
	if(!present("mombassa", TO)) {
		
		return(BS("Wenn Mombassa da waere koenntest Du ihn nach einem Kaimanhelm "
		"fragen."));
	}
}


kannibalen() {
	
	if(present("mombassa", TO)) {
		
		return(BS("Die Kannibalen moegen zwar Leute wie Dich nicht, aber gegen "
		"Bezahlung fertig Dir Mombassa vielleicht trotzdem einen Kaimanhelm."));
	}
	
	if(!present("mombassa", TO)) {
		
		return(BS("Die Kannibalen moegen zwar Leute wie Dich nicht, aber gegen "
		"Bezahlung fertig Dir Mombassa vielleicht trotzdem einen Kaimanhelm, wenn "
		"er wieder da ist."));
	}
}


gegenstand() {
	
	if(present("mombassa", TO)) {
		
		return(BS("Frag Mombassa nach einem Kaimanhelm. Dann wird er Dir schon "
		"sagen was er braucht."));
	}
	
	if(!present("mombassa", TO)) {
		
		return(BS("Wenn Mombassa da waere koenntest Du ihn gleich fragen was er "
		"braucht."));
	}
}



int playercounter() {
	
	int i;
	object *inv;
	inv=all_inventory(this_object());
	
	for(i=sizeof(inv)-1;i>=0;i--) {
		
		if( living(inv[i]) && interactive(inv[i]) ) {
			
			anwesende_spieler ++;
		}
		
		else {
		}
	}
	
	if(anwesende_spieler > 1) {
		
		anwesende_spieler=0;
		return 1;
	}
	
	else {
		
		anwesende_spieler=0;
		return 0;
	}
}


int begruessung(string kaeufer) {
	
	kaeufer=TPN;
	
	if( !interactive(TP)||!present("mombassa", TO)||present("mombassa", TO)->InFight() ) {
		return 0;
	}
	
	
	if(TRUHE->helm_da()==1 && TRUHE->besitzer_ermitteln(kaeufer)==-2 ) {
		
		tell_room(TO, BSS("Ahigoo! Ich habe Kaimanhelm fuer Dich, "+TPN+". Willst Du "
		"jetzt abholen?",
		"Mombassa sagt: "));
		return 1;
	}
	
	if(TRUHE->helm_da()==1 && TRUHE->besitzer_ermitteln(kaeufer)==-3 ) {
		
		tell_room(TO, BSS("Ahigoo! Kaimanhelm noch nicht fertig, "+TPN+".",
		"Mombassa sagt: "));
		return 1;
	}
	
	if( (TRUHE->helm_da()==1 && TRUHE->besitzer_ermitteln(kaeufer)==-4) || 
	TRUHE->helm_da()==0 ) {
		
		if( (interactive(TP) && !present("mombassa", TO)) || !interactive(TP) ) {
			
			return 1;
		}
		
		if( interactive(TP) && present("mombassa", TO) && TO->playercounter()==0 ) {
			
			switch(random(5)) {
				
				case 1:
			        tell_room(TO, BSS("Quego enchero? Aah eine Siedler? Selten!\n",
			        "Mombassa sagt: "));
	                        break;
	                
	                        case 2:
	                        tell_room(TO, BSS("QueQue nabucco Skese? Hmm, Siedler? Wollen "
	                        "Geschaeft?\n","Mombassa sagt: "));
	                        break;
	                
	                        case 3:
	                        tell_room(TO, BSL("Mombassa muster Dich ueberrascht."));
	                        tell_room(TO, BSS("Siedler wollen Kaimanhelm, stimmt?\n",
	                        "Mombassa sagt: "));
	                        break;
	                
	                        case 4:
	                        tell_room(TO, BSL("Mombassa mustert Dich neugierig und zieht "
	                        "fragend die Augenbrauen hoch.\n"));
	                        break;
	                
	                        case 0:
	                        tell_room(TO, BSL("Mombassa muster Dich neugierig und zieht "
	                        "fragend die Augenbrauen hoch.\n"));
	                        break;
	                
	                        default:
	                        tell_room(TO, BSL("Mombassa muster Dich neugierig und zieht "
	                        "fragend die Augenbrauen hoch.\n"));
	                
	                        return 1;
	                }
	                
	                return 1;
	        }
	        
	        
	        if( interactive(TP) && present("mombassa", TO) && TO->playercounter()==1 ) {
	        	
	        	switch(random(7)) {
	        		
	        		case 0:
			        tell_room(TO, BSS("Enchero saul! Noch Siedler? Viele Siedler im "
			        "Dorf ist nicht gut!","Mombassa sagt: "));
		                break;
		        
		                case 1:
		                tell_room(TO, BSS("Miagi Pocollo! Heute kommen mehr Siedler!",
		                "Mombassa sagt: "));
		                break;
		        
		                case 2:
		                write(BS("Mombassa mustert Dich neugierig und schaerft "
		                "unruhig eine Speerspitze."));
		                say(BS("Mombassa muster "+TPN+" neugierig und schaerft unruhig "
		                "eine Speerspitze."));
		                break;
		        
		                case 3:
		                tell_room(TO, BSS("Noch eine Siedler! Nehmen Kaimanhelm, geben "
		                "Belohnung, gehen! Mehr, Viele heute!","Mombassa sagt: "));
		                break;
		        
		                case 4:
		                write(BS("Mombassa mustert Dich neugierig und zieht "
		                "fragend eine Augenbraue hoch."));
		                say(BS("Mombassa mustert "+TPN+" neugierig und zieht fragend "
		                "eine Augenbraue hoch."));
		                break;
		                
		                case 5:
		                tell_room(TO, BSS("Hmm selten so viele Siedler wie heute.",
		                "Mombassa sagt: "));
		                break;
		                
		                case 6:
		                write(BS("Mombassa mustert Dich neugierig und schaerft unruhig "
		                "eine Speerspitze."));
		                say(BS("Mombassa mustert "+TPN+" neugierig und schaerft unruhig "
		                "eine Speerspitze."));
		                break;
		        
		                default:
		                write(BS("Mombassa mustert Dich neugierig und zieht "
		                "fragend eine Augenbraue hoch."));
		                say(BS("Mombassa muster "+TPN+" neugierig und zieht fragend "
		                "eine Augenbraue hoch."));
		        
		                return 1;
		        }
		        return 1;
		}
		return 1;
	}
	return 1;	
}

 
no(string str) {
	
	int attribut;
	object mombassa, kaeufer;
	mombassa=present("mombassa", TO);
	
	if(str=="1") {
		
		if( TP->QueryProp("muss_sich_entscheiden") ) {
			
			TP->SetProp("muss_sich_entscheiden", 0);
			
			if(present("mombassa", TO)) {
				
				kaeufer=TP;
				attribut=1;
				mombassa->roter_helm(kaeufer, attribut);
				return 1;
			}
			
			else {
				tell_object(TP, BS("Nanu? Mombassa ist ja garnicht da! "
				"Komm wieder und kauf Deinen Helm wenn er wieder da ist."));
				return 1;
			}
		}
		
		if( !TP->QueryProp("muss_sich_entscheiden") ) {
			
			tell_object(TP, BS("Sehr lustig. Du bist wohl ein oberschlauer "
			"Spassvogel :). Aber nicht mit Trintrasil."));
			return 1;
		}
	}
	
	if(str=="2") {
		
		if( TP->QueryProp("muss_sich_entscheiden") ) {
			
			TP->SetProp("muss_sich_entscheiden", 0);
			
			if(present("mombassa", TO)) {
				
				kaeufer=TP;
				attribut=2;	
				mombassa->roter_helm(kaeufer, attribut);
				return 1;
			}
			
			else {
				tell_object(TP, BS("Nanu? Mombassa ist ja garnicht da! "
				"Komm wieder und kauf Deinen Helm wenn er wieder da ist."));
				return 1;
			}
		}
		
		if( !TP->QueryProp("muss_sich_entscheiden") ) {
			
			tell_object(TP, BS("Sehr lustig. Du bist wohl ein oberschlauer "
			"Spassvogel :). Aber nicht mit Trintrasil."));
			return 1;
		}
	}
	
	if(str=="3") {
		
		if( TP->QueryProp("muss_sich_entscheiden") ) {
			
			TP->SetProp("muss_sich_entscheiden", 0);
			
			if(present("mombassa", TO)) {
				
				kaeufer=TP;
				attribut=3;
				mombassa->roter_helm(kaeufer, attribut);
				return 1;
			}
			
			else {
				tell_object(TP, BS("Nanu? Mombassa ist ja garnicht da! "
				"Komm wieder und kauf Deinen Helm wenn er wieder da ist."));
				return 1;
			}
		}
		
		if( !TP->QueryProp("muss_sich_entscheiden") ) {
			
			tell_object(TP, BS("Sehr lustig. Du bist wohl ein oberschlauer "
			"Spassvogel :). Aber nicht mit Trintrasil."));
			return 1;
		}
	}
	
	if(str=="4") {
		
		if( TP->QueryProp("muss_sich_entscheiden") ) {
			
			TP->SetProp("muss_sich_entscheiden", 0);
			
			if(present("mombassa", TO)) {
				
				kaeufer=TP;
				attribut=4;	
				mombassa->roter_helm(kaeufer, attribut);
				return 1;
			}
			
			else {
				tell_object(TP, BS("Nanu? Mombassa ist ja garnicht da! "
				"Komm wieder und kauf Deinen Helm wenn er wieder da ist."));
				return 1;
			}
		}
		
		if( !TP->QueryProp("muss_sich_entscheiden") ) {
			
			tell_object(TP, BS("Sehr lustig. Du bist wohl ein oberschlauer "
			"Spassvogel :). Aber nicht mit Trintrasil."));
			return 1;
		}
	}
	
	if(str=="0") {
		if( TP->QueryProp("muss_sich_entscheiden") ) {
			
			TP->SetProp("muss_sich_entscheiden", 0);
			
			if(present("mombassa", TO)) {
				
				tell_room(TO, BSS("Na gut, Du kannst Dir Helm ja spaeter "
				"noch kaufen, "+TPN+".","Mombassa sagt: "));
				return 1;
			}
			
			else {
				tell_object(TP, BS("Nanu? Mombassa ist ja garnicht da! "
				"Damit eruebrigt sich der Kauf ohnehin."));
				return 1;
			}
		}
		
		if( !TP->QueryProp("muss_sich_entscheiden") ) {
			
			tell_object(TP, BS("Sehr lustig. Du bist wohl ein oberschlauer "
			"Spassvogel :). Aber nicht mit Trintrasil."));
			return 1;
		}
	}
	
	else {//ausfuehrung bei allen beliebigen kommandos wenn spieler prop muss sich entscheiden hat
		if( TP->QueryProp("muss_sich_entscheiden") ) {
			
			tell_object(TP, BSL(
			"Entscheide Dich erst was Dein Kaimanhelm erhoehen soll.\n\n"
			"Fuer Intelligenz tippe jetzt:          waehle 1\n"
			"Fuer Ausdauer tippe jetzt:             waehle 2\n"
			"Fuer Geschicklichkeit tippe jetzt:     waehle 3\n"
			"Fuer Kraft tippe jetzt:                waehle 4\n"
			"Ich will doch keinen Helm tippe jetzt: waehle 0"));
			return 1;
		}
		
		if( !TP->QueryProp("muss_sich_entscheiden") ) {
			return 0;
		}
	}
}

	
mombassada() {
	
	if( present("mombassa", TO) ) {
		
		return 1;
	}
	
	else {
		
		return 0;
	}
}


mombassafight() {
	
	if(present("mombassa", TO) && present("mombassa", TO)->InFight()) {
		
		return 2;
	}
	
	if(present("mombassa", TO) && present("mombassa", TO)->InFight()==0 ) {
		
		return 1;
	}
	
	else {
		return 0;
	}
}


hundfight() {
	
	if(present("hund", TO) && present("hund", TO)->InFight()) {
		
		return 2;
	}
	
	if(present("hund", TO) && present("hund", TO)->InFight()==0 ) {
		
		return 1;
	}
	
	else {
		return 0;
	}
}


hund_present() {
	
	if(present("kkoeter", TO)) {
		
		return 1;
	}
	
	else {
		return 0;
	}
}


hundattacke(enemy) {
	
	object hund;
	hund = presend("kkoeter", TO);
	
	if(hund) {
		
		hund->Kill(enemy);
	}
}


hund_move() {
	
	object hund;
	hund = present("kkoeter", TO);
	
	if(hund) {
		
		hund->move("/d/dschungel/trintrasil/dorfneu/room/roomd5", M_TPORT + M_SILENT);
	}
}