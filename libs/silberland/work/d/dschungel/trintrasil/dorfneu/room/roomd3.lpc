
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"


#define greis present("greis", TO)
#define ROOMD2 "/d/dschungel/trintrasil/dorfneu/room/roomd2"
#define ROOMD6 "/d/dschungel/trintrasil/dorfneu/room/roomd6"


void create()
{
   ::create();

   SetProp(P_INT_SHORT, "Im Kannibalendorf");
   SetProp(P_INT_LONG,
      "Du befindest Dich am suedlichen Ende eines kleinen Dorfplatzes. Vor einer der "
      "Bambushuetten sitzt ein alter Mann im Schatten eines strohgedeckten Vordaches "
      "und intoniert eine leise, bedrohlich klingende Melodie. In den Bambushuetten scheint "
      "reges Leben zu herrschen, die Bewohner lassen sich allerdings nicht blicken.");

   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_ROAD ]) );
   
   SetProp("dorfraum", 1);
   
   
   ASD(("leben"),
   "leben");

   ASD(("melodie"),
   "melodie");

   ASD(({"schauckelstuhl","stuhl","schatten"}),
   "stuhl"),

   ASD(("platz"),
   "platz");
      
   ASD(({"dach","vordach"}),
   "dach");

   ASD(({"feuer","stelle","feuerstelle"}),
   "feuer");

   ASD(({"platz","dorfplatz","ende","norden","mitte"}),
   "dorfplatz");

   AD(({"bambushuette","huette","huetten","bambushuetten"}),
   "Die Bambushuetten sind meistens eher niedrig und gedrungen, und sie stehen dicht "
   "beeinander. Aus manchen Huetten hoerst Du Geraeusche, woran Du erkennen kannst, dass "
   "sich anscheinend die meisten Kannibalen vor Dir verstecken.");
   
   AD(({"kannibalen","bewohner"}),
   "Siedler aus Tijara sind bei den Kannibalen sehr unbeliebt, aber da sie Dich anscheinend "
   "noch nicht fuer eine wirkliche Gefahr halten lassen sie Dich in Ruhe.");
   
   AD(({"gefahr","ruhe"}),
   "Hoffentlich bleibt das auch so.");
   
   AD(({"siedler","tijara"}),
   "Obwohl die meisten Einwohner Tijaras dort geboren wurden werden sie noch immer oft "
   "Siedler genannt.");                 
                 
   AD(("einwohner"),
   "Du siehst ihnen eben aehnlich, dass macht Dich bei den Kannibalen anscheinend nicht "
   "gerade beliebt.");
                 
   AD(({"sonne","himmel"}),
   "Der Himmel ist strahlend blau. Die Sonne brennt heiss auf den trockenen Lehm.");
   
   AD(("hitze"),
   "Die Sonne brennt erbarmungslos vom Himmel.");
   
   AD(("lehm"),
   "Der Lehm ist trocken und hart.");
      
   AD(({"boden","strasse","lehmstrasse"}),
   "Die Boden besteht aus fest gestampften Lehm und ist hart wie Beton.");
   
   AD(("beton"),
   "Beton ist ein Baustoff der Zukunft, von dem Astrologen manchmal sprechen.");
   
   AD(({"baustoff","stoff","astrologen","astrologe"}),
   "Jaja, hunderte meter hohe Haeuser aus Beton sagen diese Quatschkoepfe fuer die "
   "Zukunft vorraus.");
   
   AD(({"haeuser","quatschkoepfe","koepfe"}),
   "Viele Astrologen sind wirklich Hochstapler und reden nur Unsinn.");
   
   AD(("weissagung"),
   "Ich kann Dir sicher weissagen das Du Probleme bekommen wirst wenn Du in diesem "
   "Dorf ungut auffaelsst.");
   
   AD(({"hochstapler","unsinn"}),
   "Wenn Du fuer die Weissagung zahlst natuerlich.");
   
   AD(("zukunft"),
   "Fuer Dich sollte die Gegenwart jetzt wichtiger sein.");
   
   AD(({"probleme","gegenwart"}),
   "Das Dorf der Kannibalen ist nicht gerade ein gesunder Urlaubsort.");
   
   AD(({"ort","urlaubsort","urlaub"}),
   "Wenn Du die Kannibalen glauben, dass Du ungut werden koenntest werden sie Dich sicher "
   "toeten.");

   AD(({"kannibalendorf","dorf"}),
   "Du bist mitten im Kannibalendorf. Im Sueden siehst Du ein zweites, grosses Palisadentor, "
   "das anscheinend das Dorfzentrum schuetzt.");
   
   AD(({"dorfzentrum","zentrum"}),
   "Im Dorfzentrum wohnt der Haeuptling der Kannibalen.");
   
   AD(("palisade"),
   "Eine zweite innere Palisade schuetzt das Dorfzentrum.");
   
   ASD(({"kannibalenhaeuptling","haeuptling"}),
   "haeuptling");
   
   ASD(({"palisadentor","tor"}),
   "tor");

   ASD(({"wache","wachen"}),
   "wache");
   
   AddCmd(({"setze"}), "stuhl_func");
      
        
   AddSound(DEFAULT_SOUND, "Das Dorf scheint eigenartig ruhig zu sein. Anscheinend sind "
   "die Kannibalen Dir gegenueber sehr misstrauisch.\n");
   
   AddSound(("geraeusch"),
   "An den leisen Geraeuschen in den Huetten kannst Du erkennen, dass sich die Kannibalen "
   "anscheinend darin verstecken.");
   

   AddSmell(DEFAULT_SMELL, "Eine duenner Rauchgeruch weht durch das Dorf. Im Norden erkennst "
   "Du ein kleines Feuer.\n");
   
   AddSmell(({"geruch","rauchgeruch"}),
   "Der Rauchgeruch weht von einer kleinen Feuerstelle im Norden zu Dir.");
    

   AddSmell( ({"feuer","rauch"}), "Das Feuer ist nur klein und der Rauch wird schnell verweht");   


   AddItem("/d/dschungel/trintrasil/dorfneu/npc/greis", REFRESH_DESTRUCT);
   
       
AddExit("norden", "./roomd2");
AddExit("westen", "./roomd4");
AddExit("sueden", "./roomd6");
}

_query_int_long() {
	
	if( greis && greis->QueryProp("sitzend")==1 ) {
		return(BS("Du befindest Dich am suedlichen Ende eines kleinen Dorfplatzes. "
		"Vor einer der Bambushuetten sitzt ein alter Mann im Schatten eines "
		"palmwedelgedeckten Vordaches und intoniert eine leise, bedrohlich klingende "
		"Melodie. In den Huetten scheint reges Leben zu herrschen, die Bewohner "
		"lassen sich allerdings nicht blicken."));
	}
	
	else {
		return(BS("Du stehst am suedlichen Ende eines kleinen Dorfplatzes vor einer "
		"Bambushuette mit einem kleinen Vordach, unter dem ein Schauckelstuhl steht. "
		"In den Huetten scheint reges Leben zu herrschen, die Bewohner lassen sich "
		"allerdings nicht blicken."));
	}
}


leben() {
	
	if(greis) {
		return(BS("Die Kannibalen scheinen sich vor Dir in ihren Huetten zu "
		"verstecken, bis auf dieser Greis."));
	}
	
	if(!greis) {
		return(BS("Die Kannibalen scheinen sich vor Dir in ihren Huetten zu "
		"verstecken."));
	}
}


melodie() {
	
	if(greis) {
		return(BS("Die Melodie des alten Mannes klingt bedrohlich und beschwoerend."));
	}
	
	if(!greis) {
		return(BS("Welche Melodie meinst Du? Du hoerst hier nichts."));
	}
}


dach() {
	
	if( greis && greis->QueryProp("sitzend") ) {
		return(BS("Das Vordach ist mit grossen Palmwedeln gedeckt und spendet dem "
		"darunter sitzenden Greis kuehlen Schatten."));
	}
	
	else {
		return(BS("Das Vordach ist mit grossen Palmwedeln gedeckt und spendet kuehlen "
		"Schatten auf den Schaukelstuhl der darunter steht."));
	}
}


stuhl() {
	
	if( greis && greis->QueryProp("sitzend") ) {
		return(BS("Du beneidest den alten Mann um seinen Schatten in dieser "
		"bruetenden Hitze. Aber freiwillig wird er Dich kaum sitzen lassen."));
	}
	
	else {
		return(BS("Im Schatten auf dem Stuhl zu sitzen waere sicher angenehm "
		"in dieser bruetenden Hitze."));
	}
}


platz() {
	
	if( greis && greis->QueryProp("sitzend") ) {
		return(BS("Der alte Mann wuerde wahrscheinlich eher sterben als Dir Platz zu "
		"machen."));
	}
	
	else {
		return(BS("Der Schauckelstuhl ist frei, setzt Dich doch darauf und ruh Dich "
		"ein wenig aus."));
	}
}


feuer() {
	
	if( ROOMD2->kannibalen()==0 ) {
		return(BS("Im Norden glost ein kleines Feuer."));
	}
	
	if( ROOMD2->kannibalen()!=0 ) {
		return(BS("Im Norden glost ein kleines Feuer um das einige ungut blickende "
		"Kannibalen herum stehen."));
	}
}


dorfplatz() {
	
	if( ROOMD2->kannibalen()==0 ) {
		return(BS("Im Norden liegt die Mitte eines kleinen Dorfplatzes auf dem ein "
		"kleines Feuer glost."));
	}
	
	if( ROOMD2->kannibalen()!=0 ) {
		return(BS("Im Norden liegt die Mitte eines kleinen Dorfplatzes auf dem ein "
		"kleines Feuer glost. Bis auf ein paar unfreundlich blickender Krieger ist "
		"er vollkommen verlassen."));
	}
}


tor() {
	
	if( ROOMD6->wachen()!=0 ) {
		return(BS("Das Palisadentor ins Dorfzentrum wird von grimmig aussehenden "
		"Kriegern bewacht. Sie werden Dich sicher nicht das Zentrum betreten lassen."));
	}
	
	if( ROOMD6->wachen()==0 ) {
		return(BS("Das maechtige Palisadentor schuetzt den Zugang zum Dorfzentrum. "
		"Seltsamerweise stehen gar keine Wachen davor."));
	}
}


haeuptling() {
	
	if( TP->QueryQuest("1000 Qualen im Dorf der Kannibalen") ) {
		return(BS("Zumindest hat er dort gewohnt, bis Du ihn umgebracht hast."));
	}
	
	if( !TP->QueryQuest("1000 Qualen im DOrf der Kannibalen") ) {
		return(BS("Der Haeuptling befindet sich gut geschuetzt im Zentrum der "
		"Kannibalendorfes. Du solltest Dir gut ueberlegen ob Dich mit ihm anlegen "
		"willst."));
	}
}


wache() {
	
	if( ROOMD6->wachen()!=0 ) {
		return(BS("Das Tor zum Dorfzentrum in dem der Haeuptling wohnt ist natuerlich "
		"bewacht."));
	}
	
	if( ROOMD6->wachen()==0 ) {
		return(BS("Das Tor zum Dorfzentrum in dem der Haeuptling wohnt sollte doch "
		"eigentlich bewacht sein!"));
	}
} 


stuhl_func(string str) {
	
	notify_fail("Worauf willst Du Dich setzen?\n");
	
	if(str=="dich auf stuhl"||str=="dich auf sessel"||str=="dich stuhl"||str=="dich sessel"||
	str=="auf stuhl"||str=="auf sessel"||str=="stuhl"||str=="sessel"||str=="nieder"||
	str=="hin"||str=="in den schatten"||str=="in schatten"||str=="schatten"||str=="vor "
	"huette"||str=="unter vordach"||str=="unter dach"||str=="dich nieder"||str=="dich "
	"hin"||str=="dich in den schatten"||str=="dich in schatten"||str=="dich vor huette") {
		
		if(greis && greis->QueryProp("sitzend")==1) {
			
			write(BS("Als Du Dich hinsetzen willst kreischt der alte Kannibale "
			"laut auf und schlaegt mit seiner Rassel nach Dir."));
			say(BS(""+TPN+" will den alten Kannibalen ruecksichtslos von seinem "
			"Stuhl im Schatten verjagen."));
			return 1;
		}
		
		if(greis && greis->QueryProp("sitzend")!=1) {
			
			write(BS("Als Du Dich auf den Stuhl setzen willst kreischt der alte "
			"Kannibale laut auf und schlaegt mit einer Rassel nach Dir."));
			say(BSL("Der alte Kannibale kreischt laut auf.\n"+TPN+" belaestigt "
			"alte Maenner. UNERHOERT!"));
			return 1;
		}
		
		if(!greis && TP->InFight()==0) {
			
			write(BS("Du setzt Dich kurz auf den Stuhl unter dem Vordach und "
			"geniesst kurz die schattige Ruhe."));
			say(BS(""+TPN+" setzt sich kurz auf den Stuhl unter dem Vordach "
			"und ruht sich etwas aus."));
			return 1;
		}
		
		if(!greis && TP->InFight()!=0) {
			
			write(BSL("\nFalls Du es noch nicht bemerkt hast!\nEs gibt hier "
			"Jemanden der Dich gerne tot sehen wuerde!\n\n"));
			say(BSL("\n"+TPN+" will sich mitten im Kampf hinsetzen!\n"+TPN+" ist "
			"wohl nicht ganz bei der Sache!\n\n"));
			return 1;
		}
	}
}
