
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "/d/dschungel/trintrasil/myowndefine.h"

#define ROOMD2 "/d/dschungel/trintrasil/dorfneu/room/roomd2"
#define HUETTE "/d/dschungel/trintrasil/dorfneu/room/huette-h"
#define KINDERMASTER "/d/dschungel/trintrasil/dorfneu/kindermaster"


init() {
	
	::init();
	
	if(interactive(TP)) {
		
		HUETTE->lade();
	}
}


void create()
{
   ::create();

   SetProp(P_INT_SHORT, "Im Kannibalendorf");
   SetProp(P_INT_LONG,
      "Du stehst am suedwestlichen Ende eines kleinen Dorfplatzes. Ein "
      "gestampfter Lehmpfad fuehrt nach Norden zwischen die "
      "dichtgedraengten Bambushuetten. Aus den Huetten hoerst Du Stimmen, "
      "die aufgeregt in einer Dir unbekannten Sprache miteinander reden. "
      "Anscheinend verstecken sich die Kannibalen misstrauisch vor Dir.");

   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_ROAD ]) );
   
   SetProp("dorfraum", 1);
   
   
   AD(("ende"),
   "Die Mitte des kleinen Dorfplatzes liegt im Nordosten.");
   
   ASD(({"platz","dorfplatz","nordosten","mitte"}),
   "mitte");
   
   AD(({"stelle","feuerstelle"}),
   "Die Feuerstelle ist beinahe erloschen. Es steigt nur noch wenig Rauch auf.");
   
   AD(({"pfad","lehmpfad","weg"}),
   "Der Pfad ist sehr schmal und fuehrt zwischen die Bambushuetten.");
   
   AD(({"huetten","bambushuetten","wohnhuetten"}),
   "Die Huetten sehen hier im Dorf nahezu alle gleich aus. Sie sind eher klein, aber solide "
   "und ganz aus Bambus gebaut. Aus einer Huette direkt neben Dir hoerst Du aufgeregte "
   "Stimmen.");
   
   AD(({"huette","bambushuette","stimmen"}),
   "In der Huette scheinen sich viele Kannibalen aufzuhalten und aufgeregt miteinander zu "
   "reden. Obwohl Du die Sprache nicht verstehst koenntest Du ja einmal versuchen an der "
   "Huettenwand zu lauschen.");
   
   AD(("kannibalen"),
   "In der Huette neben Dir scheinen sich einige Kannibalen aufgeregt zu unterhalten.");
   
   AD(("sprache"),
   "Die Sprache ist Dir voellig unbekannt, aber vielleicht erfaehrst Du ja doch etwas wenn "
   "Du an der Huettenwand lauscht.");
   
   AD(({"wand","huettenwand"}),
   "Lausche an der Wand, obwohl es wahrscheinlich nichts bringen wird.");
   
   AD(("bambus"),
   "Bambus ist leicht und trotzdem sehr belastbar.");

   AD(({"sonne","himmel"}),
   "Der Himmel ist strahlend blau. Die Sonne brennt heiss auf den trockenen Lehm.");
   
   AD(("hitze"),
   "Die Sonne brennt erbarmungslos vom Himmel.");
   
   AD(("lehm"),
   "Der Lehm ist trocken und hart.");
      
   AD(("boden"),
   "Die Boden besteht aus fest gestampftem Lehm.");
   
   AD(("dorf"),
   "Du befindest Dich suedwestlich vom Dorfplatz. Nach Norden fuehrt ein Weg mitten zwischen "
   "die dicht beieinander stehenden Wohnhuetten.");      
   
   
   AddCmd(("lausche"), "lausch_func");
   
     
   AddSound(DEFAULT_SOUND, "Das Dorf scheint eigenartig ruhig zu sein. Anscheinend sind "
   "die Kannibalen Dir gegenueber sehr misstrauisch.\n");


   AddSmell(DEFAULT_SMELL, "Eine duenner Rauchgeruch weht durch das Dorf. Im Nordosten erkennst "
   "Du ein kleines Feuer.\n");
   AddSmell( ({"rauchgeruch","geruch","feuer","rauch"}),
   "Das Feuer ist nur klein und der Rauch wird schnell verweht");   

    
AddExit("nordosten", "./roomd2");
AddExit("osten", "./roomd3");
AddExit("norden", "./roomd5");
}


mitte() {
	
	if(ROOMD2->kannibalen()==0 ) {
		
		return(BS("Der Dorfplatz liegt wie ausgestorben da. Lediglich eine kleine "
		"Feuerstelle glost einsam vor sich hin."));
	}
	
	if(ROOMD2->kannibalen()!=0 ) {
		
		return(BS("Bis auf ein paar Krieger die um eine kleine Feuerstelle herum "
		"stehen ist der Dorfplatz leer."));
	}
}


lausch_func(string str) {
	
	object kinder;
	kinder=find_living("kannibalenkinderschar");
	
	if(str=="an wand"||str=="an huettenwand"||str=="wand"||str=="huettenwand"||
	str=="an huette"||str=="huette") {
		
		if( kinder && HUETTE->kinderpresent()) {
			
			write(BSL("Als Du das Ohr zum Lauschen an die Wand haeltst geht "
			"ploetzlich die Huettentuere auf und eine Kinderschar stuermt "
			"laut kreischend aus der Huette hervor.\n\n"));
			say(BSL(""+TPN+" will gerade an einer Huettenwand lauschen, als "
			"ploetzlich die Huettentuere aufgeht und eine Schar Kinder heraus "
			"stuermt.\n\n"));
			HUETTE->kindermove();
			TP->AddPursuer(kinder);
			kinder->SetProp(P_MSGOUT, "springt "+TPN+" hinterher");
			KINDERMASTER->mutterfunktion();
			return 1;
		}
		
		if( (!kinder || !HUETTE->kinderpresent()) && HUETTE->mutterpresent() ) {
			
			write(BSL("Du legst das Ohr an die Wand und lauscht.\nDu hoerst "
			"nur eine aufgeregte, schimpfende Frauenstimme."));
			say(BS(""+TPN+" legt das Ohr an eine Huettenwand und lauscht."));
			return 1;
		}
		
		if( (!kinder || !HUETTE->Kinderpresent()) && !HUETTE->mutterpresent()) {
			
			write(BS("Du legst das Ohr an die Wand und lauscht, kannst aber "
			"nichts besonderes hoeren."));
			say(BS(""+TPN+" legt das Ohr an eine Huettenwand und lauscht."));
			return 1;
		}
	}
}