//- Startplatz fuer Kannibalendorfquest

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define QUESTMASTER "/d/dschungel/charon/dorfneu/questmaster.lpc"

void create()
{
   ::create();

   
   SetProp(P_INT_SHORT, "Hinter einem Gebuesch");
   SetProp(P_INT_LONG,
      "Du befindest Dich auf einer kleinen Lichtung hinter einem dichten, hohem Gebuesch, "
      "die von dichtem Dschungel umwuchert ist. Ein aelterer, zerlumpt aussehender Mann kauert "
      "am Boden und macht einen verstoerten Eindruck. Es sieht so aus als wuerde er sich vor "
      "etwas verstecken."
    );

   
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:25, ENV_TERRAIN:TT_JUNGLE ]) );

   

   AD(({"vegetation","lichtung"}),
   "Die Lichtung ist sehr klein und schattig und von dichtem Dschungel umwuchert.");
   
   AD(("dschungel"),
   "Du befindest Dich mittem im suedlichen Dschungel.");
   
   AD(("suedlicher dschungel"),
   "Du bist weit weg von Tijara tief im Sueden des Gebietes des Rio de la Puseta.");
   
   AD(({"sueden","fluss","rio","rio de la puseta","puseta"}),
   "Du hoerst den Fluss noch leise rauschen.");
   
   AD(({"norden","tijara"}),
   "Tijara liegt weit im Norden von hier.");
   
   AD(({"gebuesch","busch","gestruepp"}),
   "Du gelangst durch das dichte Gestruepp im Osten auf den Trampelpfad zurueck.");
   
   AD(({"pfad","trampelpfad"}),
   "Das Gebuesch ist sehr dicht, sodass die Lichtung vom Trampelpfad aus gut versteckt ist.");
   
   AD(({"lehm","boden","fuesse","fuss","erdreich"}),
   "Der Boden ist hier feucht und mit dichtem langem Gras bewachsen.");
   
   AD(("gras"),
   "Da die Lichtung sehr schattig ist ist das saftige, dunkle Grass hier sehr feucht.");
   
   AD(("himmel"),
   "Der Himmel ist nahezu vollkommen von den Laubdaechern versteckt.");
   
   AD(({"daecher","laubdaecher"}),
   "Die dicht um die Lichtung wachsenden Baeume verdecken den Himmel nahezu vollstaendig.");
   
   AD(({"riesen","dschungelriesen","baum","baeume","schatten"}),
   "Auf der Lichtung ist es durch die Schatten der grossen Dschungelriesen angenehm kuehl.");
   
   AD(("regen"),
   "Hier im Dschungel regnet es nahezu taeglich.");
   
   ASD(({"eindruck","mann","alter mann"}),
   "kai");
      
   ASD(("hilfe"),
   "help");
   
       
   
     
   AddSound(DEFAULT_SOUND, "Du kannst das Rauschen der Vegetation hoeren, wenn"
        " der Wind durch die Baeume faehrt.\n");
         
   AddSound(({"rauschen","wind"}), 
   "Die grossen Baeume wiegen sanft knarrend im Wind.");
   
   
   

   AddSmell(DEFAULT_SMELL, "Du riechst den Lehm unter Deinen Fuessen.\n");
   AddSmell( ({"lehm"}), "Durch den Regen ist das Erdreich"
      " durchnaesst und riecht nun erfrischend.");   

   AddExit("osten", ([
          EX_FUNC:"gebuesch",
          EX_PLMSG:"\nDu kriechst durch das dichte Gebuesch nach osten.\n\n"]));    

   
   AddItem( "/d/dschungel/charon/dorfneu/npc/kai", REFRESH_DESTRUCT);


   AddCmd(("wiederherstellung"), "reset_quest");//versuchsweise
}

gebuesch() {
	
	TP->move("/d/dschungel/trintrasil/dorfneu/room/room9", M_GO, "mit lautem Knacken von "
	"Aesten nach osten","kriecht","kriecht aus dem Gebuesch");
return 1;} 


  
int reset_quest() {
	
	int i;
	object npc,room, *inv;
	inv=all_inventory(this_object());
  
        tell_room(TO, BSL("Kai schleicht sich.\nCarolina geht ihrem Vater nach.\n\n"));
        
        tell_room(TO, BS("Dich haelt hier auch nichts mehr. Du kriechst wieder hinter "
        "dem Gebuesch hervor."));
        
        for(i=sizeof(inv)-1;i>=0;i--) {
        	
        	if( interactive(inv[i]) ) {
        		
        		inv[i]->move("/d/dschungel/trintrasil/dorfneu/room/room9", M_GO+ M_NO_SHOW,
                        "durch das Gebuesch","kriecht","kriecht hinter einem Gebuesch hervor");
                }
                
                else {
                }
        }
	
	if(npc = present("\nkd_kai")) npc->remove();
   
        if(npc = present("\nkd_carolina")) npc->remove();
     
        else {
        	room = find_object("/d/dschungel/charon/dorfneu/room/kaefig");
   	
   	        if(room && (npc = present("\nkd_carolina",room))) npc->remove();
        }
   
        npc = clone_object("/d/dschungel/charon/dorfneu/npc/carolina"); 
        npc->SetVarGefesselt(1);
        npc->move("/d/dschungel/charon/dorfneu/room/kaefig",M_GO);
        npc = clone_object("/d/dschungel/charon/dorfneu/npc/kai");
        npc->move("/d/dschungel/charon/dorfneu/room/busch" ,M_GO);
        QUESTMASTER->make_quest_free();
        call_out("room_reset", 2);
}

room_reset() {//um zu viele gleichzeitige ladungen (sind ja auch npcs in den raeumen) zu vermeiden
	
	KANNIBALEN_DORF("room_k")->reset();
        KANNIBALEN_DORF("room_r1")->reset();
        KANNIBALEN_DORF("room_r2")->reset();
        KANNIBALEN_DORF("room_r3")->reset();
        call_out("room_reset1", 2);
}

room_reset1() {
	
	KANNIBALEN_DORF("room_r5")->reset();
	KANNIBALEN_DORF("room_r7")->reset();
	KANNIBALEN_DORF("room_r8")->reset();
}

//++++++++++++++++++++++++++++++++ SPECIAL DETAILS ++++++++++++++++++++++++++++++++++++++++++++++++++++++

kai() {
	
	if(!present("kai", TO)) {
		
		return(BS("Scheib bitte Trintrasil ein Mail das Kai hier fehlte!!"));
	}
	
	if(present("kai", TO) && present("\nkd_quest", TP) ) {
		
		return(BS("Kai scheint ziemlich mitgenommen zu sein. Du solltest Dich "
		"beeilen Deine Aufgabe zu erfuellen."));
	}
	
	else {
		
		return(BS("Kai scheint ziemlich mitgenommen zu sein. Frag ihn doch einmal "
		"nach Hilfe."));
	}
}


help() {
	
	if(!present("kai", TO)) {
		
		return(BS("Scheib bitte Trintrasil ein Mail das Kai hier fehlte!!"));
	}
	
	if(present("kai", TO) && present("\nkd_quest", TP) ) {
		
		return(BS("Du hilfst Kai ja schon. Wenn Du etwas von ihm wissen willst dann "
		"frag ihn doch einfach."));
	}
	
	else {
		
		return(BS("frage kai nach hilfe."));
	}
}