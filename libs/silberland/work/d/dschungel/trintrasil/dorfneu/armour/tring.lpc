
/*
 * blaeulich schimmernder ring
 * hoehle wassergsit
 * ---
 * 
 */

//#include "files.h"
#include <properties.h>
#include <combat.h>
#include <attributes.h>

inherit "std/armour";
int dex;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"ring", "geschicklichkeitsring", "ring der geschicklichkeit",
      "wasserring", "dexring"}));
  SetProp(P_SHORT, "Ein blaeulich schimmernder Wassering");
  SetProp(P_LONG,
    "Der Ring besteht aus einem Dir unbekanntem blaeulich schimmerndenn "
    "Kristall. In seinem Inneren scheint eine durchsichtige Fluessigkeit "
    "zu fliessen. Der Ring scheint eine verborgene Kraft zu haben...");
  SetProp(P_NAME, "Wasserring");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, random(5));

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 750+random(300));
  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:50, MAT_MISC_FLUID:50]));
  SetProp(P_MAGIC,1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:1]) );
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 140, DT_WATER : 0, 0 : 270 ]) );
  SetProp(P_INFO, 
    "Dieser Ring verleiht seinem Traeger moeglicherweise zusaetzliche "
    "Geschicklichkeit.");
  switch(random(100))
  {
    case 0..24: dex=-2; break;
    case 25..49: dex=-1; break;
    case 50..74: dex=0; break;
    case 75..89: dex=1; break;
    case 90..98: dex=2; break;
    case 99: 
      dex=3; 
      if (!random(100)) dex=4;
      if (!random(10000)) dex=5;
      break;
  }
  //dex=-2+random(3)*random(3)+random(2)*random(2); 

  SetProp(P_CURSED,0);
  SetProp(P_NEVERDROP,0);

  SetProp (P_ATTRIBUTES_MODIFIER, ([ A_DEX:10]) );  
}


