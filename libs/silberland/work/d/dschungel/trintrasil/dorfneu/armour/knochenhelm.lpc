inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knochenhelm");
  SetProp(P_LONG, 
    "Dieser Helm wurde aus den Schaedelknochen einer grossen Raubkatze "
    "gefertigt. Die grossen Fanzaehne beschatten die Augen und lassen den "
    "Traeger sehr gefaehrlich aussehen. Zusaetzlich sind noch viele "
    "kriegerische Symbole in die Knochen geritzt. Mit einem breiten "
    "Lederband kann man den Helm am Kinn festbinden.");
  SetProp(P_NAME, "Knochenhelm");
  SetProp(P_GENDER, MALE);
  AddId(({"helm", "knochenhelm"}));
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_LEATHER:10]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 250);

  AddDetail( ({"schaedelknochen", "knochen", "raubkatze"}),
    "Von welcher Raubkatze der Schaedelknochen stammt, laesst sich nicht "
    "mehr feststellen.");
  AddDetail( ({"lederband", "leder"}),
    "Mit einem breiten Lederband kann man den Helm am Kinn festbinden.");
}

