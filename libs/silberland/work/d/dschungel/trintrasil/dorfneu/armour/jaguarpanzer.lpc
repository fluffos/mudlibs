inherit "/std/armour";
 
#include <properties.h>
#include <combat.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

string farbe = "blau";


void create() {
	
	if (!is_clone(this_object())) return;
	::create();
	
  SetProp (P_SHORT, "Ein Jaguarpanzer");
  SetProp (P_INT_LONG, BSL(
  "Der Lederpanzer besteht aus gehaertetem, dunklem Leder und ist ein guter "
  "Schutz fuer den Oberkoerper. An einigen Stellen ist der Panzer durch "
  "eingearbeitete Knochen verstaerkt.\nAuf seiner Vorderseite ist ein "+farbe+"er, Zaehne "
  "fletschender Jaguar gemalt."));

     
  SetProp (P_NAME, "Jaguarpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","lederpanzer","jaguar"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 28);
  SetProp (P_MATERIAL, ([MAT_LEATHER:85, MAT_BONE:15]) );
  SetProp (P_WEIGHT, 2000);
  SetProp (P_VALUE, 700);

  AddDetail( ({"leder"}),
    "Das Leder wurde mit Wachs gehaertet, darum schuetzt es weitaus besser "
    "als andere Ruestungen aus Leder.");
  
  AddDetail(("wachs"),
  "Der harte, dunkle Panzer schimmert matt.");
  
  ASD(("jaguar"),
  "jaguar");
  
  ASD(({"seite","vorderseite"}),
  "seite");
  
  AddDetail(("farbe"),
  "Die Farbe ist in das Leder eingezogen.");
  
  AddDetail(("sprung"),
  "Der Jaguar springt seinem Opfer an den Hals und toetet es mit einem schnellen Biss.");
  
  AddDetail(({"hals","genick"}),
  "Der Jaguar ueberrascht sein Opfer meistens und toetet es mit einem schnellen Biss ins "
  "Genick.");
  
  AddDetail(({"jaeger","opfer"}),
  "Der Jaguar ist ein lautloser und schneller Jaeger.");
  
  AddDetail(("biss"),
  "Ein Jaguar braucht selten mehr als einen Biss um sein Opfer zu toeten.");
  
  AddDetail(({"zaehne","reisszaehne"}),
  "Die beiden Reisszaehne blitzen scharf und toedlich.");
  
  SetProp(P_SMELL,
    "Am Leder kann man noch Geruchsspuren der scharfen Gerbfluessigkeiten "
    "feststellen.\n");
    
    call_out("get_colour", 1);
}


get_colour() {
	
	object gott;
	string *adjective;
	gott = find_player("gott");
	adjective = environment(TO)->QueryProp(P_NAME_ADJ);
	
	if( environment(TO) && adjective[0]=="weiss" ) {
		
		farbe = "weiss";
	}
	
	if( environment(TO) && adjective[0]=="rot" ) {
		
		farbe = "rot";
	}

	if( !environment(TO) || (environment(TO) && adjective[0]!="weiss" && adjective[0]!="rot") ) {

		farbe = "gruen";
	}
}


_query_long() {
	
	return(BSL("Der Lederpanzer besteht aus gehaertetem, dunklem Leder und ist ein guter "
	"Schutz fuer den Oberkoerper. An einigen Stellen ist der Panzer durch "
	"eingearbeitete Knochen verstaerkt.\nAuf seiner Vorderseite ist ein "+farbe+"er, "
	"Zaehne fletschender Jaguar gemalt."));
}


seite() {
	
	return(BS("Vorne ist ein grosser "+farbe+"er Jaguar auf den Panzer gemalt. Die Farbe "
	"ist in das Leder eingearbeitet."));
}


jaguar() {
	
	return(BS("Der "+farbe+"e Jaguar fletscht fauchend die Zaehne, und setzt zum Sprung "
	"an."));
}

