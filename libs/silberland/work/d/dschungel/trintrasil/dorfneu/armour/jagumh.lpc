inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Jaguarumhang");
  SetProp (P_LONG,BS(
"Der Umhang ist aus dem praechtigen Fell eines Jaguars gefertigt. Aus kleinen, weissen "
"Knochensplittern sind Muster auf das Fell genaeht. Die Pfoten werden vor der Brust "
"zusammen gebunden."));
  
  AD(({"tier","jaguar"}),
  "Schade um das praechtige Tier das fuer diesen Umhang sterben musste.");
  
  AD(({"pfoten"}),
    "Den Umhang zieht man an indem man die Pfoten um den Hals legt und vor der Brust "
    "zusammen bindet.");
    
  AD(({"brust","hals"}),
    "Ich hoffe fuer Dich das Du sowas hast.");
    
  AD(({"knochensplitter","splitter","formen"}),
  "Die Knochensplitter wurden in die benoetigten Formen geschnitzt und auf den "
  "Umhang genaeht."); 
  
  AD(("muster"),
  "Die Muster sollen die Feinde des Traeger erschrecken.");
  
  
  
  SetProp (P_NAME, "Jaguarumhang");
  SetProp (P_GENDER, MALE);
  AddId (({"jaguarumhang","umhang"}));
  SetProp (P_WEIGHT, 250);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 1400);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_PELT:97, MAT_BONE:3]));
}


