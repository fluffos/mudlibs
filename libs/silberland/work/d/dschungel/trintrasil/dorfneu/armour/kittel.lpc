inherit "/std/armour";
 
#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kittel");
  SetProp(P_LONG, 
    "Der Kittel ist zerschlissen und an den Enden zerfranst und loechrig. Ob er einmal "
    "eine Farbe hatte kannst Du nicht erkennen, und wenn ist das schon laenger her.");
  SetProp(P_NAME, "Kittel");
  SetProp(P_GENDER, MALE);
  AddId( ({"kittel"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 30);
  
  AddDetail(("enden"),
  "An den Enden ist der Kittel ganz zerfranst.");
  
  AddDetail(("farbe"),
  "Der Kittel ist so zerschlissen und staubig, dass er einfach nur grau wirkt.");
}

