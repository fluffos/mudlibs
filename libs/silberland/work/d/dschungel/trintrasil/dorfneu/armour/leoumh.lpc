
inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Leopardenumhang");
  SetProp (P_LONG,BS(
"Der Leopardenumhang glaenzt praechtig. Das Fell ist gebuerstet und gefettet, "
"dieser Umhang war wohl der Stolz seines Besitzers. Die Pfoten kann man vor dem "
"Hals mit einer Eisenfibel verschliessen."));
  
  AD(({"stolz","leopardenfell","fell"}),
    "Der Vorbesitzer hat das Fell gut gepflegt.");
    
  AD(({"besitzer","vorbesitzer"}),
    "Wem hat denn das Fell vor Dir gehoert?");
    
  AD(({"pfoten"}),
    "Den Umhang zieht man an indem man sich die Pfoten um den Hals legt und "
    "mit der Eisenfibel verschliesst.");
    
  AD(("hals"),
    "Ich hoffe fuer Dich das Du sowas hast.");
    
  AD(({"eisenfibel","fibel","kreise","kreis"}),
    "Die Eisenfibel ist recht grob gearbeitet, sie stellt zwei einfache, "
    "verschlungene Kreise dar."); 
  
  
  SetProp (P_NAME, "Leopardenumhang");
  SetProp (P_GENDER, MALE);
  AddId (({"leopardenumhang","umhang"}));
  SetProp (P_WEIGHT, 250);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 1400);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_PELT:97, MAT_IRON:3]));
  
}


