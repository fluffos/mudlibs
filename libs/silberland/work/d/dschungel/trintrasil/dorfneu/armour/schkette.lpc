inherit "/std/armour";
 
#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Schaedelkette");
  SetProp(P_LONG, 
    "Auf ein Lederband wurden abwechselnd kleine Vogelschaedel und lange, bunte Federn "
    "aufgefaedelt.");
  SetProp(P_NAME, "Schaedelkette");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kette","halskette","schaedelkette","vogelschaedelkette"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_BONE: 70, MAT_SKIN: 30]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 450);
  
  AddDetail(({"band","lederband","leder"}), 
  "Auf dieses feste Lederband wurde abwechselnd je ein Schaedel und eine Feder aufgefaedelt.");
  
  AddDetail(({"schaedel","vogelschaedel"}),
  "Die Vogelschaedel sind sehr klein und weiss poliert. Sie stammen von unterschiedlichen "
  "Voegelarten.");
  
  AddDetail(({"arten","vogelarten","voegel"}),
  "Du kannst meistens nicht erkennen um welche Vogelart es sich handelt, aber ein paar "
  "Schaedel identifizierst Du als Papageienschaedel.");
  
  AddDetail(({"papageienschaedel","papagei","papageien","schnabel"}),
  "Du erkennst die Papageienschaedel an ihrem krummen Schnabel.");
  
  AddDetail(({"federn","vogelfedern"}),
  "Nahezu alle Federn sind lange, bunte Schwanzfedern von Papageien. Nur eine besonders "
  "hell leuchtende, rote Feder stammt wahrscheinlich von einem Paradeisvogel.");
  
  AddDetail(({"paradeisvogel","vogel","vogelart","dschungel","paradeisvoegel"}),
  "Paradeisvoegel ist eine besonders praechtige, rote Vogelart hier im Dschungel.");
}

