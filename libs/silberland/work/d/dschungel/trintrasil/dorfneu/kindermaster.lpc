#include <moving.h>
#include <properties.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define HUETTE "/d/dschungel/trintrasil/dorfneu/room/huette-h"

mutterfunktion() {
	
	call_out("mutterfunktion1", 20);
}


mutterfunktion1() {
	
	object kinder;
	kinder = find_living("kannibalenkinderschar");
	
	if(find_call_out("mutterfunktion1")==-1 && HUETTE->mutterpresent() && 
	!HUETTE->kinderpresent() ) {
		
		if(kinder) {
			
			HUETTE->muttermove();
		}
		
		if(!kinder) {
			tell_room("/d/dschungel/trintrasil/dorfneu/room/huette-h", "\nNOKIDS\n\n");
		}
	}
}
