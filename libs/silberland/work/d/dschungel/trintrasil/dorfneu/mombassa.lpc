/* 
** Helmbauer Trintrasil Maerz 2003
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define TRUHE "/d/dschungel/trintrasil/dorfneu/room/truhe-h"
#define MOMBMASTER "/d/dschungel/trintrasil/dorfneu/mombmaster"


create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","mombassa","handwerker","NOWIMPY"}) );
   create_default_npc( 16 );   

   
   SetProp(P_SHORT, "Mombassa");
   SetProp(P_LONG,  "Mombassa ist der Waffenbauer der Kannibalen. Er ist zwar ein schon etwas "
   "aelterer Kannibale, aber er wirkt sehnig und durchtrainiert. Mit seinen geschickten "
   "Haenden schleift er gerade eine Speerspitze. Seinen Taetowierungen und seinem Schmuck nach "
   "zu schliessen ist er im Dorf sehr angesehen. Er mustert Dich erwartungsvoll.");

   SetProp(P_NAME,      "Mombassa");
   SetProp(P_ARTICLE, 0);
   SetProp(P_GENDER,    MALE);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_WEIGHT, 70000);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt roechelnd.\n");
   SetProp(P_DEFAULT_INFO,"sieht Dich misstrauisch an. Er scheint Dich nicht zu verstehen.");


   clone_object("/d/dschungel/trintrasil/dorfneu/weapon/ksaebel")->move(TO);
   clone_object("/p/armour/trousers/lederhose")->move(this_object());
   clone_object("/p/armour/cloak/lederschuerze")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/schkette")->move(TO);
   
   command("zuecke saebel");
   command("trage alles");
   

   AD(({"bauer","waffenbauer"}),
   "Mombassa fertigt fuer die Kannibalen Waffen und Ruestungen.");
   
   AD(({"schaedelkette","kette","schmuck","halsschmuck","halskette"}),
   "Mombassa traegt eine Halskette aus kleinen Vogelschaedeln und Federn.");
   
   AD(({"papagei","papageien","schwanzfedern","schwanz","federn"}),
   "Die Federn sind Schwanzfedern von Papageien.");
   
   AD(({"schaedel","schaedeln","vogelschaedel","vogelschaedeln"}),
   "Die kleinen Schaedel sind durchbohrt und auf einem Lederband aufgefaedelt.");
   
   AD(({"band","lederband"}),
   "Die Schaedelkette rasselt leise wenn sich Mombassa bewegt.");
   
   AD(("haende"),
   "Mombassa schleift gerade eine Speerspitze. Im Waffenbau ist er geuebt und dafuer im "
   "Dorf sehr angesehen.");
   
   AD(({"koerper","oberkoerper","taetowierung","taetowierungen"}),
   "Die Taetowierung eines blutroten Kaimans ringelt sich um Mombassas Oberkoerper.");
   
   AD(("kaiman"),
   "Die Riesenkaimane leben im weiten Schilfguerteln hier im Flussgebiet. Mombassa fertigt "
   "aus ihren Schaedeln begehrte und wertvolle Helme.");
   
   AD(({"guertel","schilfguertel"}),
   "Die Schilfguertel sind die Rueckzugsraeume der Kaiman. Zum Jagen schwimmen sie aber "
   "hinaus auf den Rio de la Puseta.");
   
   AD(({"rueckzugsraum","raum","rueckzugsraeume","raeume"}),
   "Die Riesenkaimane fallen oft aus dem Schilf heraus ihre Beute an.");
   
   AD(("helme"),
   "Die Kaimanhelme sind sehr gut wertvoll. Mombassa kann Dir ueber die unterschiedlichen "
   "Arten von Kaimanhelmen sicher mehr sagen.");
   
   AD(({"art","arten"}),
   "Es gibt einfache, sandgelbe, steinweisse, staubgraue und rostrote Kaimanhelme. Auf manchen "
   "Helmen findet man auch riesige Zaehne der Zahnanakonde.");
   
   AD(({"zaehne","zahn","zahnanakondazaehne","zahnanakondazahn"}),
   "Die Zaehne dienen als Helmschmuck. Manchmal werden sie aber auch zum Aufspiessen von "
   "Feinden auf dem Helm befestigt.");
   
   AD(({"spiessen","aufspiessen","helmschmuck","feinde"}),
   "Berserker koennen mit diesen Zaehnen ihre Feinde verletzen.");
   
   AD(({"anakonda","zahnanakonde"}),
   "Die Zahnanakonde ist die einzige bekannte Riesenschlangenart mit langen Eckzaehnen. "
   "Sie laesst sich von Baeumen herab auf ihre Beute fallen.");
    
   AD(("baeume"),
   "Die Zahnanakonda lebt auf Baeumen nahe des Rio de la Puseta."); 


   AddCmd(("kaufe"), "khelm_func");
   AddCmd(("hole"), "get_func");
   
         
  AddInfo(DEFAULT_INFO, ({"neigt nur fragend den Kopf.\n",
           "sagt: Wollen Siedler nun handeln oder kaum?\n",
           "sagt: Tikahok! Kaimanhelm?"}));

  AddInfo(({"zeichnung","tierzeichnung"}),
  "Geist von Tier segnet Helmtraeger und bringt Schutz.","sagt: ");
  
  AddInfo(({"tiergeister","tiergeist","geister","geist","tier"}),
  "Geister von starken Tieren sind maechtig und sind zu Traeger gut wenn Zeichnung.","sagt: ");
  
  AddInfo(({"schutz","tiere","segen"}),
  "Wenn Tierzeichnung auf Helm erkennt Tiere den Helmtraeger und beobachtet ihn. Vielleicht "
  "auch beginnt ihn zu lieben.");
  
  AddInfo(({"traeger","helmtraeger"}),
  "Traeger muss erweisen wuerdig fuer Kaimanhelm. Sonst wird Kaimangeist Wertlosen toeten.",
  "sagt: ");
  
  AddInfo(({"vater","kaimangeist"}),
  "Kaimangeist grosser Vater unter Tiergeister. Oft sehr grausam und ohne Mitleid, aber wenn "
  "Menschen richtig und Respekt dann kann Kaimangeist helfen wenn Not am groessten.","sagt: ");
  
  AddInfo(({"mitleid"}),
  "Wenn Menschen falsch Kaimangeist tilgt sie sofort. Aber manchmal schenkt Kaimangeist "
  "Menschen Kaimanschaedel zum Segen wenn sie wuerdig einen seiner Kinder zu "
  "besiegen.","sagt: ");
  
  AddInfo(({"kaiman","riesenkaiman","kinder","kind","kaimane","riesenkaimane"}),
  "Kinder von Kaimageist leben am grossen Fluss. Sind gern in Schilf, wo Mensch sie nicht "
  "gleich sieht.","sagt: ");
  
  AddInfo(({"mutter","flussmutter","fluss"}),
  "Tinkahook! Du kennst doch grosse Flussmutter!","ruft erstaunt: ");
  
  AddInfo(({"schilf","schilfguertel","haare"}),
  "Kikik! Kaimankinder leben gern in Haare von Flussmutter. Dort ist Ruhe und willkommen "
  "fuer Kaiman.","Mombassa lacht: ");
   
  AddInfo(({"kaimanhelme","helme","arten","kaimanhelm","helm","art"}),
  "Ich mache unterschiedliche Helme. Einfach, sandgelb, steinweiss, staubgrau und "
  "rostrot mit Haut von grossem Wurm. Kann auch anmachen Zaehne von schnellen Tod.","sagt: ");
    
  AddInfo(({"tod","schneller tod","zahnanakonda","anakonda"}),
  "Schneller Tod lebt in grossen Baeumen an Fluss. Ihr nennt ihn Zahnanakonda.","sagt: ");
  
  AddInfo(({"zaehne","anakondazaehne"}),
  "Ich mache auch Zaehne auf Helm. Du musst mir aber selber die Zaehne von schneller Tod "
  "bringen. Kostet zusaetzlich 1000 Muenzen.","sagt: ");
  
  AddInfo(({"wurm","sandwurm"}),
  "Wenn Du mir Haut von grossem Wurm lebt im Sand bringst, kann ich auch Wurmhaut fuer "
  "Helm verwenden.","sagt: ");
  
  AddInfo(({"haut","wurmhaut"}),
  "Ich spanne Haut auf Helm. Gibt Helm mehr Staerke und macht ihn in Farbe von "
  "Sandwurm.","sagt: ");
  
  AddInfo(({"staerke"}),
  "Staerke unterschiedlich mit Farbe von Wurmhaut. Es gibt einfache, sandgelbe, steinweisse, "
  "staubgraue und rostrote Kaimanhelme.","sagt: ");
  
  AddInfo(({"einfache kaimanhelme","einfacher kaimanhelm","einfache helme","einfacher helm"}),
  "Einfacher Kaimanhelm ist ohne Wurmhaut. Brauche dafuer nur Kaimanschaedel und kostet 5000 "
  "Muenzen und eine Hellebarde. Wenn Du Zaehne auf Helm willst musst Du kaufen einfachen, "
  "gezahnten Kaimanhelm. Zaehne kosten zusaetzlich 1000 Muenzen.","sagt: ");
  
  AddInfo(({"sandgelber kaimanhelm","sandgelbe kaimanhelme","sandgelber helm","sandgelbe helme"}),
  "Sandgelber Kaimanhelm haerter als einfacher Kaimanhelm und besserer Schutz bei Hitze. Ich "
  "brauche dazu sandgelbe Wurmhaut und Kaimanschaedel. Kostet 6000 Muenzen und Hellebarde. "
  "Wenn Du Zaehne auf Helm willst musst Du kaufen sandgelben, gezahnten Kaimanhelm. Zaehne "
  "kosten zusaetzlich 1000 Muenzen.","sagt: ");
  
  AddInfo(({"steinweisser kaimanhelm","steinweisse kaimanhelme","steinweisser herlm","steinweisse helme"}),
  "Steinweisser Kaimanhelm haerter als einfacher Kaimanhelm und besserer Schutz bei Hitze und "
  "Kaelte auch Wasserangriff. Ich brauche dazu steinweisse Wurmhaut und Kaimanschaedel. Kostet "
  "7000 Muenzen und Hellebarde. Wenn Du Zaehne auf Helm willst musst Du kaufen steinweissen, "
  "gezahnten Kaimanhelm. Zaehne kosten zusaetzlich 1000 Muenzen.","sagt: ");
  
  AddInfo(({"staubgrauer kaimanhelm","staubgraue kaimanhelme","staubgrauer helm","staubgraue helme"}),
  "Staubgrauer Kaimanhelm haerter als einfacher Kaimanhelm und besserer Schutz bei Hitze, "
  "Kaelte und Wasserangriff. Ausserdem macht staubgrauer Kaimanhelm Traeger ertragen mehr "
  "Wunden. Ich brauche dazu staubgraue Wurmhaut und Kaimanschaedel. Kostet 8000 Muenzen und "
  "Infanteriesaebel. Wenn Du Zaehne auf Helm willst musst Du kaufen staubgrauer, "
  "gezahnter Kaimanhelm. Zaehne kosten zusaetzlich 1000 Muenzen.","sagt: ");
  
  AddInfo(({"rostroter kaimanhelm","rostrote kaimanhelme","rostroter helm","rostrote helme"}),
  "Rostroter Kaimanhelm haerter als staubgrauer Kaimanhelm und besserer Schutz bei Hitze, "
  "Kaelte, Wasserangriff und Feuerangriff. Ausserdem macht rostroter Kaimanhelm Traeger "
  "ertragen mehr Wunden. Ich brauche dazu rostrote Wurmhaut und Kaimanschaedel. Kostet 9000 "
  "Muenzen und Infanteriesaebel. Wenn Du Zaehne auf Helm willst musst Du kaufen rostroter, "
  "gezahnter Kaimanhelm. Zaehne kosten zusaetzlich 1000 Muenzen.","sagt: ");  
}


int khelm_func(string str) {
	
	string *hautfarbe;
	object schaedel, zaehne, hbarde, muenzen, khelm, whaut, isaebel;
	schaedel = deep_present("kaimanschaedel", TP);
	zaehne = deep_present("anakondazaehne", TP);
	hbarde = deep_present("hellebarde", TP);
	isaebel = deep_present("infanteriesaebel", TP);
	muenzen = deep_present("muenzen", TP);
	whaut = deep_present("wurmhaut", TP);
	
	hautfarbe=({});
	
	notify_fail("Was moechtest Du kaufen?\n");
	
	
	
	if(str=="kaimanhelm"||str=="helm") {
		
		say(BS(""+TPN+" will einen Kaimanhelm kaufen."));
		tell_room(ENV(TO), BSS("Welche Art Kaimanhelm willst Du kaufen?",
		"Mombassa fragt: "));
		return 1;
	}
	
	
	
	if(str=="einfachen kaimanhelm"||str=="einfachen helm") {
		
		write(BS("Du willst einen Kaimanhelm von Mombassa kaufen."));
	        say(BS(""+TPN+" will einen Kaimanhelm von Mombassa kaufen."), TP);
		
		if(!schaedel) {
			
			tell_room(ENV(TO), BSS("Du hast keinen Kaimanschaedel. Ich kann Dir "
			"nur Helm machen wenn Du mir einen Schaedel von Riesenkaiman gibts.",
			"Mombassa sagt: "));
			return 1;
		}
		
		if( schaedel && (!hbarde || !muenzen || muenzen->QueryProp(P_AMOUNT)<5000 ) ) {
			
			tell_room(ENV(TO), BSS("Hmm. Helm kostet 5000 Muenzen und Hellebarde. "
			"Bezahlung nehme ich vor Kaimanhelm.","Mombassa sagt: "));
			return 1;
		}
		
		if( schaedel && hbarde && muenzen && muenzen->QueryProp(P_AMOUNT)>=5000 ) {
			
			write(BSL("Mombassa sagt: Gut Siedler. Du kannst Helm abholen in ca 20 "
			"Stunden.\nMombassa nimmt den Schaedel.\nDu gibst Mombassa 5000 Muenzen "
			"und die Hellebarde."));
			say(BSL("Mombassa sagt zu "+TPN+": Gut Siedler. Du kannst Helm abholen "
			"in ca 20 Stunden.\n"+TPN+" gibt Mombassa 5000 Muenzen und eine "
			"Hellebarde."),TP);
			schaedel->remove();
			hbarde->remove();
			muenzen->SetProp(P_AMOUNT, muenzen->QueryProp(P_AMOUNT)+5000);
			khelm = CLONEOB("/d/dschungel/trintrasil/fluss/armour/kaimanhelm");
			khelm->move("/d/dschungel/trintrasil/dorfneu/room/truhe-h.lpc");
			khelm->SetProp("besitzer", ""+TPN+"");
			khelm->counter();
			return 1;
		}
	}
	
	
	
	if(str=="einfachen gezahnten kaimanhelm"||str=="einfachen gezahnten helm") {
		
		write(BS("Du willst einen Kaimanhelm von Mombassa kaufen."));
	        say(BS(""+TPN+" will einen Kaimanhelm von Mombassa kaufen."), TP);
		
		if(!schaedel) {
			
			tell_room(ENV(TO), BSS("Du hast keinen Kaimanschaedel. Ich kann Dir "
			"nur Helm machen wenn Du mir einen Schaedel von Riesenkaiman gibts.",
			"Mombassa sagt: "));
			return 1;
		}
		
		if(schaedel && !zaehne) {
			
			tell_room(ENV(TO), BSS("Fuer gezahnten Helm brauche ich Zaehne von "
			"schnellem Tod.","Mombassa sagt: "));
			return 1;
		}
		
		if( schaedel && zaehne && 
		(!hbarde || !muenzen || muenzen->QueryProp(P_AMOUNT)<6000 ) ) {
			
			tell_room(ENV(TO), BSS("Hmm. Helm kostet 6000 Muenzen und Hellebarde. "
			"Bezahlung nehme ich vor Kaimanhelm.","Mombassa sagt: "));
			return 1;
		}
		
		if( schaedel && zaehne && hbarde && muenzen && 
		muenzen->QueryProp(P_AMOUNT)>=6000 ) {
			
			write(BSL("Mombassa sagt: Gut Siedler. Du kannst Helm abholen in ca 20 "
			"Stunden.\nMombassa nimmt den Schaedel und die Zaehne.\nDu gibst "
			"Mombassa 6000 Muenzen und die Hellebarde."));
			say(BSL("Mombassa sagt zu "+TPN+": Gut Siedler. Du kannst Helm abholen "
			"in ca 20 Stunden.\n"+TPN+" gibt Mombassa 5000 Muenzen und eine "
			"Hellebarde."),TP);
			schaedel->remove();
			hbarde->remove();
			muenzen->SetProp(P_AMOUNT, muenzen->QueryProp(P_AMOUNT)+5000);
			khelm = CLONEOB("/d/dschungel/trintrasil/fluss/armour/kaimanhelm");
			khelm->move("/d/dschungel/trintrasil/dorfneu/room/truhe-h.lpc");
			khelm->SetProp("besitzer", ""+TPN+"");
			khelm->SetProp(P_EFFECTIVE_WC, 100+random(20));
			khelm->SetProp("gezahnt");
			khelm->SetProp(P_NAME_ADJ, "gezahnt");
			khelm->counter();
			return 1;
		}
	}
	
	
	
	if(str=="sandgelben kaimanhelm"||str=="sandgelben helm"||str=="gelben kaimanhelm"||
	str=="gelben helm") {
		
		write(BS("Du willst einen Kaimanhelm von Mombassa kaufen."));
	        say(BS(""+TPN+" will einen Kaimanhelm von Mombassa kaufen."), TP);
	
		if(!schaedel) {
			
			tell_room(ENV(TO), BSS("Du hast keinen Kaimanschaedel. Ich kann Dir "
			"nur Helm machen wenn Du mir einen Schaedel von Riesenkaiman gibts.",
			"Mombassa sagt: "));
			return 1;
		}
		
		if(schaedel && !whaut) {
			
			tell_room(ENV(TO), BSS("Fuer sandgelben Kaimanhelm brauche Ich sand"
			"gelbe Haut von grossem Sandwurm.","Mombassa sagt: "));
			return 1;
		}
		
		if(schaedel && whaut) {
			
			hautfarbe=whaut->QueryProp(P_NAME_ADJ);
			
			if(hautfarbe[0]!="sandgelb") {
				
				tell_room(ENV(TO), BSS("Deine Wurmhaut ist "+hautfarbe[0]+". "
				"Wenn Du einen sandgelben Helm willst brauche ich aber auch "
				"sandgelbe Haut.","Mombassa sagt: "));
				return 1;
			}
			
			if(hautfarbe[0]=="sandgelb" && (!hbarde || !muenzen ||
			muenzen->QueryProp(P_AMOUNT)<6000 ) ) {
				
				tell_room(ENV(TO), BSS("Hmm. Helm kostet 6000 Muenzen und "
				"Hellebarde. Bezahlung nehme ich vor Kaimanhelm.",
				"Mombassa sagt: "));
				return 1;
			}
			
			if(hautfarbe[0]=="sandgelb" && hbarde && muenzen && 
			muenzen->QueryProp(P_AMOUNT)>=6000 ) {
				
				write(BSL("Mombassa sagt: Gut Siedler. Du kannst Helm abholen "
				"in ca 20 Stunden.\nMombassa nimmt den Schaedel und die "
				"Wurmhaut.\nDu gibst Mombassa 6000 Muenzen und die "
				"Hellebarde."));
				say(BSL("Mombassa sagt zu "+TPN+": Gut Siedler. Du kannst Helm "
				"abholen in ca 20 Stunden.\n"+TPN+" gibt Mombassa 6000 Muenzen "
				"und eine Hellebarde."),TP);
				schaedel->remove();
				hbarde->remove();
				whaut->remove();
				muenzen->SetProp(P_AMOUNT, muenzen->QueryProp(P_AMOUNT)+5000);
				khelm = CLONEOB("/d/dschungel/trintrasil/fluss/armour/kaimanhelm");
				khelm->move("/d/dschungel/trintrasil/dorfneu/room/truhe-h.lpc");
				khelm->SetProp("besitzer", ""+TPN+"");
				khelm->SetProp(P_NAME_ADJ, "sandgelb");
				khelm->SetProp(P_AC, 15);
				khelm->SetProp(P_TEMPERATURE_PROTECTION, 
				             ([T_COLD_PROT:2,T_HEAT_PROT:4]));
				khelm->counter();
				return 1;
			}
		}	
	}
	
	
	
	if(str=="sandgelben gezahnten kaimanhelm"||str=="sandgelben gezahnten helm"||
	str=="gelben gezahnten kaimanhelm"||str=="gelben gezahnten helm") {
		
		write(BS("Du willst einen Kaimanhelm von Mombassa kaufen."));
	        say(BS(""+TPN+" will einen Kaimanhelm von Mombassa kaufen."), TP);
	        
	        if(!schaedel) {
			
			tell_room(ENV(TO), BSS("Du hast keinen Kaimanschaedel. Ich kann Dir "
			"nur Helm machen wenn Du mir einen Schaedel von Riesenkaiman gibts.",
			"Mombassa sagt: "));
			return 1;
		}
		
		if(schaedel && !whaut) {
			
			tell_room(ENV(TO), BSS("Fuer sandgelben Kaimanhelm brauche Ich "
			"sandgelbe Haut von grossem Sandwurm.","Mombassa sagt: "));
			return 1;
		}
		
		if(schaedel && whaut) {
			
			hautfarbe=whaut->QueryProp(P_NAME_ADJ);
			
			if(hautfarbe[0]!="sandgelb") {
				
				tell_room(ENV(TO), BSS("Deine Wurmhaut ist "+hautfarbe[0]+". "
				"Wenn Du einen sandgelben Helm willst brauche ich aber auch "
				"sandgelbe Haut.","Mombassa sagt: "));
				return 1;
			}
			
			if(hautfarbe[0]=="sandgelb" && !zaehne) {
				
				tell_room(ENV(TO), BSS("Fuer gezahnten Kaimanhelm brauche ich "
				"lange Zaehne von schnellem Tod.","Mombassa sagt: "));
				return 1;
			}
			
			if(hautfarbe[0]=="sandgelb" && zaehne && 
		        (!hbarde || !muenzen || muenzen->QueryProp(P_AMOUNT)<7000 ) ) {
		        	
		        	tell_room(ENV(TO), BSS("Hmm. Helm kostet 7000 Muenzen und "
		        	"Hellebarde. Bezahlung nehme ich vor Kaimanhelm.",
		        	"Mombassa sagt: "));
		        	return 1;
		        }
		        
		        if(hautfarbe[0]=="sandgelb" && hbarde && zaehne && muenzen && 
		        muenzen->QueryProp(P_AMOUNT)>=7000 ) {
		        	
		        	write(BSL("Mombassa sagt: Gut Siedler. Du kannst Helm abholen "
		        	"in ca 20 Stunden.\nMombassa nimmt den Schaedel, die Wurmhaut "
		        	"und die Zaehne.\nDu gibst Mombassa 7000 Muenzen und die "
		        	"Hellebarde."));
		        	say(BSL("Mombassa sagt zu "+TPN+": Gut Siedler. Du kannst Helm "
		        	"abholen in ca 20 Stunden.\n"+TPN+" gibt Mombassa 7000 Muenzen "
		        	"und eine Hellebarde."),TP);
		        	schaedel->remove();
		        	hbarde->remove();
		        	zaehne->remove();
		        	whaut->remove();
		        	muenzen->SetProp(P_AMOUNT, muenzen->QueryProp(P_AMOUNT)+5000);
		        	khelm = CLONEOB("/d/dschungel/trintrasil/fluss/armour/kaimanhelm");
		        	khelm->move("/d/dschungel/trintrasil/dorfneu/room/truhe-h.lpc");
		        	khelm->SetProp("besitzer", ""+TPN+"");
		        	khelm->SetProp(P_NAME_ADJ, ({"sandgelb","gezahnt"}) );
		        	khelm->SetProp(P_AC, 15);
		        	//khelm->SetProp(P_TEMPERATURE_PROTECTION, 
		        	  //            ([T_COLD_PROT:2,T_HEAT_PROT:4]));
		        	khelm->SetProp(P_EFFECTIVE_WC, 100+random(20));
		        	khelm->SetProp("gezahnt");
		        	khelm->counter();
		        	return 1;
		        }
		}
	}
	
	
	
	if(str=="steinweissen kaimanhelm"||str=="steinweissen helm"||str=="weissen kaimanhelm"||
	str=="weissen helm") {
		
		write(BS("Du willst einen Kaimanhelm von Mombassa kaufen."));
	        say(BS(""+TPN+" will einen Kaimanhelm von Mombassa kaufen."), TP);
	
		if(!schaedel) {
			
			tell_room(ENV(TO), BSS("Du hast keinen Kaimanschaedel. Ich kann Dir "
			"nur Helm machen wenn Du mir einen Schaedel von Riesenkaiman gibts.",
			"Mombassa sagt: "));
			return 1;
		}
		
		if(schaedel && !whaut) {
			
			tell_room(ENV(TO), BSS("Fuer sandgelben Kaimanhelm brauche Ich "
			"steinweisse Haut von grossem Sandwurm.","Mombassa sagt: "));
			return 1;
		}
		
		if(schaedel && whaut) {
			
			hautfarbe=whaut->QueryProp(P_NAME_ADJ);
			
			if(hautfarbe[0]!="steinweiss") {
				
				tell_room(ENV(TO), BSS("Deine Wurmhaut ist "+hautfarbe[0]+". "
