roter_helm(kaeufer, attribut) {
	
	object isaebel, zaehne, schaedel, muenzen, whaut, khelm;
	schaedel = deep_present("kaimanschaedel", TP);
	zaehne = deep_present("anakondazaehne", TP);
	isaebel = deep_present("infanteriesaebel", TP);
	muenzen = deep_present("muenzen", TP);
	whaut = deep_present("wurmhaut", TP);
	
	khelm = CLONEOB("/d/dschungel/trintrasil/fluss/armour/kaimanhelm");
	
	if(kaeufer->QueryProp("kaimanhelm_gezahnt")) {
		
		kaeufer->SetProp("kaimanhelm_gezahnt", 0);
		
		write(BSL("Mombassa sagt: Gut Siedler. Du kannst Helm abholen in ca 20 "
		"Stunden.\nMombassa nimmt den Schaedel, die Wurmhaut und die Zaehne.\n"
		"Du gibst Mombassa 10000 Muenzen und den Saebel."));
		say(BSL("Mombassa sagt zu "+TPN+": Gut Siedler. Du kannst Helm abholen "
		"in ca 20 Stunden.\n"+TPN+" gibt Mombassa 10000 Muenzen und einen "
		"Infateriesaebel."),TP);
		zaehne->remove();
		muenzen->SetProp(P_AMOUNT, muenzen->QueryProp(P_AMOUNT)+5000);
		khelm->SetProp(P_NAME_ADJ, ({"rostrot","gezahnt"}) );
		khelm->SetProp("gezahnt");
		khelm->SetProp(P_EFFECTIVE_WC, 100+random(20));
	}
	
	else {
		write(BSL("Mombassa sagt: Gut Siedler. Du kannst Helm abholen in ca 20 "
		"Stunden.\nMombassa nimmt den Schaedel und die Wurmhaut.\nDu gibst "
		"Mombassa 9000 Muenzen und den Saebel."));
		say(BSL("Mombassa sagt zu "+TPN+": Gut Siedler. Du kannst Helm abholen "
		"in ca 20 Stunden.\n"+TPN+" gibt Mombassa 9000 Muenzen und einen "
		"Infanteriesaebel."),TP);
		muenzen->SetProp(P_AMOUNT, muenzen->QueryProp(P_AMOUNT)+5000);
		khelm->SetProp(P_NAME_ADJ, "rostrot");
	}
	
	if(attribut==1) {
		khelm->SetProp(P_ATTRIBUTES_MODIFIER, ([ A_INT:1 ]));
	}
	
	if(attribut==2) {
		khelm->SetProp(P_ATTRIBUTES_MODIFIER, ([ A_CON:1 ]));
	}
	
	if(attribut==3) {
		khelm->SetProp(P_ATTRIBUTES_MODIFIER, ([ A_DEX:1 ]));
	}
	
	if(attribut==4) {
		khelm->SetProp(P_ATTRIBUTES_MODIFIER, ([ A_STR:1 ]));
	}
	
	khelm->SetProp(P_AC, 15);
	khelm->SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4,T_HEAT_PROT:4]));
	
         khelm->SetProp(P_DAM_PROTECTION,
	      ( khelm->QueryProp(P_DAM_PROTECTION) + ([DT_SOUND:1, DT_TERROR:1,
	       DT_AIR:1, DT_WATER:1, DT_FIRE:1]) ));

	
	schaedel->remove();
	isaebel->remove();
	whaut->remove();
	khelm->SetProp("besitzer", ""+kaeufer->name()+"");
	khelm->counter();
	khelm->move("/d/dschungel/trintrasil/dorfneu/room/truhe-h.lpc");
	return 1;
}

		

get_func(string str, kaeufer) {
	
	object kunde;
	kunde = TP;
	kaeufer=TPN;
	
	notify_fail("Was willst Du abholen? Einen Kaimanhelm?\n");
	
	if(str=="kaimanhelm ab"||str=="helm ab"||str=="kaimanhelm"||str=="helm") {
		
		say(BS(""+TPN+" will einen Kaimanhelm von Mombassa abholen."), TP);
		write(BS("Du fragst Mombassa nach Deinem Kaimanhelm."));
		
		if(TRUHE->helm_da()==1 && TRUHE->besitzer_ermitteln(kaeufer)==-2 ) {
			
			tell_room(ENV(TO), BS("Mombassa geht in den Wohnbereich der Huette und "
			"kommt kurze Zeit spaeter mit einem praechtigen Kaimanhelm wieder!"));
			TRUHE->gib_helm(kunde, kaeufer);
			tell_room(ENV(TO), BSS("Halte ihn in Ehren und handle in Respekt vor "
			"grossem Geist von Kaiman, "+TPN+".", "Mombassa sagt: "));
			return 1;
		}
		
		if(TRUHE->helm_da()==1 && TRUHE->besitzer_ermitteln(kaeufer)==-3 ) {
			
			tell_room(ENV(TO), BSS("Kaimanhelm noch nicht fertig, "+TPN+".",
			"Mombassa sagt: "));
			return 1;
		}
		
		if( (TRUHE->helm_da()==1 && TRUHE->besitzer_ermitteln(kaeufer)==-4) || 
	        TRUHE->helm_da()==0 ) {
	        	
	        	tell_room(ENV(TO), BSS("Von welchem Kaimanhelm redest Du? Du hast "
	        	"keine Helm bei mir bestellt, "+TPN+".","Mombassa sagt: "));
	        	return 1;
	        }
	}
}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	MOMBMASTER->ruf_um_hilfe(enemy);
}