#include <moving.h>
#include <properties.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

object *kannibale, *helfer;
string *helfer_namen;

/*
     Hier musst Du die arrays definieren, die im master vorkommen. Dass ein object oder string
     ein array ist, erkennst Du am * davor.
     Während ein object immer ein bestimmtes definiertes object ist, kann ein array ein
     oder mehrere objecte mit gleichen Eigenschaften beinhalten.
     
     In unserem Fall beinhalten die array helfer und kannibale npcs, und das
     array helfer_namen strings [also Texte].
     helfer_namen brauchen wir erst später.
     
     Weiter gleich unten bei der create Zeile 29.
*/

create() {
	
	if (is_clone(this_object())) {
		this_object()->remove();
		return 0;
	}
	
	kannibale = ({});   //Wenn der master erzeugt wird, sind die array leer...
	helfer = ({});
}


add_kannibale() {
	
	kannibale += ({ previous_object() });
}
/*
     Das ist die Funktion, die von den npcs bei ihrem createn aufgerufen wird [bei uns vom
     beispielkrieger Zeile 88], und die diese in das array einträgt.
     
     Sie bedeuten folgendes:

     kannibale [name des array] += [zufügen zum array] ({ previous_object() [gibt vorhergehendes object an, also jenes, das die funktion aufgerufen hat] });

     Wenn Dich die Funktion previous_object() usw genauer interessiert, lies das bitte in der
     manpage nach. Ich beschränke mich hier nur auf das Masterrelevante.
*/



add_helfer() {
	
	helfer += ({ previous_object() });
}


/*
     Somit ist unser npc in das array eingetragen und kann durch dieses angesprochen werden.
     
     Wie das funktioniert zeige ich Dir gleich anhand der Funktion, die einen angreifenden
     Spieler bei allen kannibalen als Feind einträgt.
     
     Dieser Vorgang beginnt wieder in unserem Beispielkrieger in der Funktion Defend
     
     [** weiter beispielkrieger Zeile 99 **]
*/
     



feind_eintragen(object spieler) {
	
	int u;
        object *w;
        w=kannibale;
        
        for (u=sizeof(w)-1;u>=0;u--) {
        	
        	if ( catch(w[u]->InsertEnemy(spieler)) ) {
        		
        		kannibale -= ({ w[u] });
        	}
        }
}


schicke_verstaerkung(waechter, exclude) {//wird vom Muschelkrieger der nach Verstaerkung ruf
                                         //aufgerufen
	
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd1", BSL("\nBOOOOOOOEEEEEEEEB!!\n"
	"Du hoerst den tiefen Alarmton eines Muschelhornes!\n\n"), exclude);
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd2", BSL("\nBOOOOOOOEEEEEEEEB!!\n"
	"Du hoerst den tiefen Alarmton eines Muschelhornes!\n\n"), exclude);
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd3", BSL("\nBOOOOOOOEEEEEEEEB!!\n"
	"Du hoerst den tiefen Alarmton eines Muschelhornes!\n\n"), exclude);
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd4", BSL("\nBOOOOOOOEEEEEEEEB!!\n"
	"Du hoerst den tiefen Alarmton eines Muschelhornes!\n\n"), exclude);
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd5", BSL("\nBOOOOOOOEEEEEEEEB!!\n"
	"Du hoerst den tiefen Alarmton eines Muschelhornes!\n\n"), exclude);
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd6", BSL("\nBOOOOOOOEEEEEEEEB!!\n"
	"Du hoerst den tiefen Alarmton eines Muschelhornes!\n\n"), exclude);
	call_out("verstaerkung", 2, waechter);
}
/*
     In der obrigen Funktion der Aktion Verstärkung rufen passiert nicht mehr, als dass der
     Alarmton im ganzen Dorf zu hören ist, und über ein call_out die Aktion weiter
     geleitet wird. Dabei werden alle objects, die wir vorher in das array exclude eingetragen
     haben, also alle Spieler im gleichen Raum wie der Beispielkrieger von diesen Meldungen
     ausgenommen.
     Das object waechter wird mit der call_out wieder weiter gegeben. (Zeile 103 und Zeile 116)
*/



verstaerkung(waechter) {
                        
	
	int i;
        object *h;        
        string nam;
        h=helfer;
	helfer_namen = ({});   

	for(i=0; i<sizeof(h); i++ ) {
		
		nam=h[i]->QueryProp(P_NAME);
		helfer_namen+=({ nam  });		
	}
	
	call_out("verstaerkung1", 1, waechter);
}
/*
     Der master schickt nicht nur Verstärkung, er prüft auch noch, ob Verstärkung von den
     vorherigen Runden noch vorhanden ist, und schickt daraufhin Verstärkung in 
     unterschiedlicher Stärke.
     
     Um das zu realisieren, werden erst alle Namen der Helfer als string [also text] in dieser
     Funktion erfasst.
     
     Das geschieht wieder mit einer for-schleife:
       
       1. Wir sprechen alle im array helfer eingetragenen objecte über das erstellte array *h
          in der for-schleife an.
            
            object *h;
            
            h=helfer
            
       2. Wir leeren zu Beginn das array helfer_namen (definiert siehe Zeile 7). In das wollen
          wir ja alle Namen eintragen. Wir müssen somit sicher gehen, dass keine alten Namen
          eingetragen sind.
          
            helfer_namen = ({});
          
       3. Wir definieren einen string [also text] nam. Den werden wir in der for-schleife zum
          Erfassen der Namen verwenden.
          
       4. In der for-schleife wird jedes object im array helfer angesprochen und nach seinem
          Namen gefragt. Der rückgemeldete namen wird als "nam" erfasst und in das array
          helfer_namen eingetragen.
          
            nam=h[i]->QueryProp(P_NAME);
            helfer_namen+=({ nam });
            
          Somit haben wir alle namen als text in einem array gesammelt.
          
       5. Mit einem weiteren call_out wird die Aktion fortgesetzt.
*/

verstaerkung1(waechter) {//es wird ermittelt welche npcs bereits helfen. Ist zB kein Jaguar-
                         //krieger mehr unter den Helfern kommt sofort einer nach.
	
	int i;
	object *h, j_krieger, krieger, kan_krieger;
	h=helfer;
        for (i=sizeof(h);5-i>0;i++) {

/*
     In dieser Funktion wird erst einmal geschaut, ob weniger als 5 Kannibalen vorhanden sind
     [in der for "5-i>0"]. Sind 5 vorhanden, wird die for-schleife nicht ausgeführt und die
     Aktion abgebrochen. Sind weniger als 5 Kannibalen im array helfer, wird ermittel, wie
     stark die eventuell noch von vorherigen Verstärkungsrunden vorhandenen Kannibalen sind.
     Das wird so gemacht, indem das oben erstellte helfer_namen array nach "Jaguarkrieger"
     durchsucht, der mit Abstand der stärkste Kannibale ist. Wird ein solcher gefunden, ist
     noch ein Jaguarkrieger als helfer vorhanden, und es ist kein weiterer notwendig.
     Ist also ein Jaguarkrieger vorhanden, wird nach der zweitstärksten Verstärkung gesucht.
     Nach einem Helfer mit dem Namen Krieger. Wird keiner gefunden, wird ein solcher als
     Verstärkung geschickt. Ist aber auch ein solcher noch vorhanden, sind die Spieler
     anscheinend mit den vorhandenen Kannibalen ohnehin recht gut bedient, und es wird nur
     ein schwacher einfacher Kannibale geschickt.
     
     Der Namensvergleich funktioniert mit der Funktion "member_array".
     
     Mit dieser Funktion kann man arrays durchsuchen. Findet die Funktion den angegebenen
     Suchstring [also Suchtext] im angegebenen array nicht, dann gibt sie den Zahlenwert
     -1 zurück.
     
     Das heisst:
      
       if(member_array("Jaguarkrieger", helfer_namen)==-1) {
       
       bedeutet: wenn "Jaguarkrieger" nicht im array "helfer_namen" gefunden wird.
     
*/        	
        	if( member_array("Jaguarkrieger", helfer_namen)==-1) {
        		
        		switch(random(2)) {
        			
        			case 0:
        			j_krieger=clone_object("/d/dschungel/trintrasil/dorfneu/npc/jaguarkrieger");
        			tell_room(ENV(waechter), BSL("\nEin weisser Jaguarkrieger "
        			"kommt bruellend aus einer Huette!\n\n"));  
        			j_krieger->move(ENV(waechter), M_TPORT +M_SILENT);
        			break;
        			
        			case 1:
        			j_krieger=clone_object("/d/dschungel/trintrasil/dorfneu/npc/jaguarkrieger1");
        			tell_room(ENV(waechter), BSL("\nEin roter Jaguarkrieger "
        			"kommt bruellend aus einer Huette!\n\n"));
        			j_krieger->move(ENV(waechter), M_TPORT +M_SILENT);
        			break;
        			
        			default:
        			j_krieger=clone_object("/d/dschungel/trintrasil/dorfneu/npc/jaguarkrieger");
        			tell_room(ENV(waechter), BSL("\nEin weisser Jaguarkrieger "
        			"kommt fauchend aus einer Huette!\n\n"));  
        			j_krieger->move(ENV(waechter), M_TPORT +M_SILENT);
        		}
        	}
        	
/*
     Das "switch(random)" ist für die Funktionsweise des masters eigentlich irrelevant.
     Dabei wird nur zufällig einer von zwei Jaguarkriegern ausgewählt. Die beiden sehen
     anders aus und sind auch unterschiedlich bewaffnet. Wenn immer der gleiche Dorftrottel
     aus einer Hütte krachen würde wäre das zu fad.
     
     Wie Du siehst wird der Krieger gecloned, also ganz neu erschaffen (es kann also unendlich
     viele von ihnen geben wenn die Spieler unseren Beispielkrieger mit der Muschel nicht
     klein bekommen) und mit der entsprechenden Meldung in das environment [also Umgebung;
     sprich Raum] unseres Beispielkriegers bewegt.
     Daher mussten wir dem master auch den Krieger als object waechter in der Funktion
     verstaerkung mit schicken, damit er ihn jetzt wieder findet, und weiss wohin er die 
     Verstärkung schicken soll.
     
       (Definition von waechter siehe Beispielkrieger Zeile 152, Übergabe siehe Beispielkrieger
        Zeile 172)
*/

        	if( member_array("Jaguarkrieger", helfer_namen)!=-1 && 
        	member_array("Krieger", helfer_namen)==-1 ) {
        		
        		krieger=clone_object("/d/dschungel/trintrasil/dorfneu/npc/krieger1");
        		tell_room(ENV(waechter), BSL("\nEin bemalter Krieger kommt schreiend "
        		"aus einer Huette!\n\n"));
        		krieger->move(ENV(waechter), M_TPORT +M_SILENT);
        	}
        	
        	if( member_array("Jaguarkrieger", helfer_namen)!=-1 && 
        	member_array("Krieger", helfer_namen)!=-1 )   {
        		
        		kan_krieger=clone_object("/d/dschungel/trintrasil/dorfneu/npc/krieger");
        		tell_room(ENV(waechter), BSL("\nEin Kannibale kommt schreiend aus "
        		"einer Huette!\n\n"));
        		kan_krieger->move(ENV(waechter), M_TPORT +M_SILENT);
        	}
        } 
}
		



/*
     Hier noch die Funktionen, mit denen sich die objects aus den arrays hier im master
     austragen, wenn sie removed werden.

     Da liegt auch die grösste Schwachstelle so konstruierter master.
     
     Werden die objects removed, können sie sich regulär beim master abmelden und alles
     funktioniert wunderbar. Werden sie aber destructet, was passiert wenn sie zB zu lange
     alleine ohne Spieler in einem Raum stehen, bekommen sie das nicht mit, und können sich
     auch nicht abmelden.
     Wenn Du jetzt die objecte vom master aus direkt ansprichst, wie wir das zB oben bei
     der Funktion "InsertEnemy()" [siehe Zeile 72] machen, gibt es massenhaft
     bugs, wenn dieses object noch eingetragen ist, aber nicht mehr existiert.
     Der master versucht dann jedesmal das object anzusprechen, obwohl es nicht mehr da ist.
     
     Eine mögliche Abhilfe, und die einzige die mir eingefallen ist, ist die Verwendung von
     catch().
     
     Ich zeige das an der Funktion "feind_eintragen", die schon oben in Zeile 72 steht.

     
feind_eintragen(object spieler) {
	
	int u;
        object *w;
        w=kannibale;
        
        for (u=sizeof(w)-1;u>=0;u--) {
        	
        	if ( catch(w[u]->InsertEnemy(spieler)) ) {
        		
        		kannibale -= ({ w[u] });
        	}
        }
}


     Bei dieser Funktion soll jedem object, dass im array kannibale eingetragen ist, der rabiate
     Spieler, der unseren Krieger angegriffen hat als Feind eingetragen werden.
     Dazu wird das array Eintrag für Eintrag mit einer for-schleife abgearbeitet.
     
     1. Erst wird ein object *w definiert, welches Mitglied des array kannibale ist.
     
          object *w
          w=kannibale
     
     2. Innerhalb einer catch() wird dann jedem w der Spieler als Feind eingetragen.
        
          w[u]->InsertEnemy(spieler)
          
        Der Spieler wird dieser Funktion vom angegriffenen Krieger beim Aufrufen dieser
        Funktion aus der Defend mitgeteilt [übergeben] (siehe master Zeile 72) "object spieler";
        und siehe Beispielkrieger Zeile 137)
        
     Der ganze Ablauf steht innerhalb einer catch(). Das heisst, ist das Durchführen der
     Aktionen innerhalb der catch möglich, werden sie ausgeführt, wenn nicht, wird das
     durchgeführt, was nach der catch() steht, nämlich:
       
       kannibale -= ({ w[u] });
       
     Das heisst:
       Das Ausführen der catch war nicht möglich, da das object w anscheinend nicht mehr 
       existiert.
       Daher wird es aus dem array kannibale ausgetragen [ kannibale -= ({ w[u] }) ] und
       kann dort nicht mehr stören.
     
     Mein erster master hat auf diese Art und Weise bugs verursacht, dass einem das Heulen
     kommen konnte, wobei er in der Testphase natürlich einwandfrei lief.
     Feyaria hat mich daraufhin verzweifelt gebeten keinen master mehr zu proggen, weil das
     Teil noch dazu extrem lang und unübersichtlich war, woran ich mich anscheinend aber
     nicht gehalten habe.


     Das wars.
     
     Du kannst mit den objecten die du in so einem master in arrays eingetragen hast natürlich
     alles machen, und in ihnen, oder in ihren Räumen, zentral gesteuert vom master alle
     möglichen Funktion aufrufen. Das hier war noch eine relativ übersichtliche.
     Je komplexer und vielfältiger die Aktionen, umso mehr musst Du mögliche seltsame
     Eventuallitäten beachten.
       
       1. In welchen Räumen können sich die npcs mittlerweile überall befinden und wie
          beeinflusst das ihre Handlungsweise.
          zB steht der Wachposten auf dem Turm, muss er dort runterklettern. Steht er schon auf
          der Brücke, kann er gleich loswatschen.
       
       2. Was will ich von meinen objects wissen.
          Brauche ich die Namen wie beim obrigen Namensvergleich, dann muss ich in das array
          strings eintragen, weil einen string [Text :)] kann ich nur mit strings vergleichen.
          
       3. Gibt es verschiedene Gruppen von npcs, die in unterschiedliche arrays eingetragen
          werden, wie hier im ursprünglichen master solche die helfen oder denen geholfen 
          wird. Es kann auch sein das ein und der selbe npc zu mehreren Gruppen gehört.
          Dann musst Du evtl. sicherstellen, dass sich das nicht im Weg ist.
       
       4. Was ich auch hier brauchte, man kann einer Funktion gewisse objecte übergeben, wie
          zB mit unserem array *exclude. Sowas kann man immer brauchen wenn man Ausnahmen
          macht, und vielleicht manche objects im array anders behandelt als andere, oder wie
          bei uns verhindern will, dass die Spieler die den Beispielkrieger beim Alarmblasen
          beobachten evtl. noch ein weiteres mal eine Alarmmeldung sehen.
       
       5. Immer wenn Du Aktionen schreibst musst Du auch den Faktor Zeit berücksichtigen.
          Es ist nicht nur unrealistisch, sondern auch stressig für den Spieler, wenn
          alles auf einmal passiert. Daher habe ich immer auch call_out verwendet, mit
          dem sich die Zeit, die die Aktionen brauchen sollen problemlos einstellen lässt.
          Wenn Du 2 von einander abhängige Aktionen schreibst, die evtl. von 2 mastern
          gesteuert werden, musst Du aufpassen, das die Zeit beider Aktionen zusammen passt.
          Ich hatte einmal das Problem, das aus unerklärlichen Gründen auf meinem homemud die
          Zeit anders verging als im realmud, wodurch im realmud Zeitprobleme auftragen.
          Daher mache ich alles was zusammen gehört auch immer in einem master, weil, egal
          welche relativistischen Effekte Dein Zeitkontinuum krümmen, innerhalb eines masters
          ist der Zeitverlauf homogen :).          
       
   Viel Spass auf alle Fälle. Mastern ist geil und gibt einen viele komische Möglichkeiten :)..
   
   mfg Trint
*/



remove_kannibale() {
    
    kannibale -= ({ previous_object() });
}


remove_helfer() {
	
	helfer -= ({ previous_object() });
}


//++++++++++++++Funktionen zum testen des masters (keine Verwendung im Spiel)++++++++++++++++++++	

/*
     Achja, hier sind noch ein paar Testfunktionen. Wenn der master spinnt, und Du nicht mehr
     weisst was zur Hölle überhaupt noch in den arrays eingetragen ist, und was nicht, kannst
     Du das mit solchen Funktionen überprüfen.
     Wenn Du sie brauchen solltest und nicht weisst wie ansprechen und damit umgehen,
     stehe ich gerne zur Verfügung.
*/


check_helfer_namen() {
	
	int i;
	object gott;
	gott=find_player("gott");
	
	if(gott) {
		
		if(!sizeof(helfer_namen)) {
			
			tell_object(gott, "helfer_namen = NULL\n");
		}
		
		if(sizeof(helfer_namen)) {
			
			for(i=0; i<sizeof(helfer_namen); i++)  {
       	        		
       	        		tell_object(gott,
       	        		" "+(i+1)+".) "+helfer_namen[i]+"\n");
       	        	}
		}	
	}
}

					
check_kannibalen()  {
	
	int i;
	object dante, trintrasil, gott;
	dante=find_player("dante");
	trintrasil=find_player("trintrasil");
	gott=find_player("gott");
	
	if(gott)  {
		
		if(!sizeof(kannibale))  {
			
			tell_object(gott,"kannibale = NULL\n");
       	        }  				
       	        
       	        if(sizeof(kannibale))  {
       	        	
       	        	for(i=0; i<sizeof(kannibale); i++)  {
       	        		
       	        		tell_object(gott,
       	        		" "+(i+1)+".) Name: "+kannibale[i]->QueryProp(P_NAME)+"\n");
       	        	}
		}	
	}
	
	if(trintrasil)  {
		
		if(!sizeof(kannibale))  {
			
			tell_object(trintrasil,"kannibale = NULL\n");
       	        }  				
       	        
       	        if(sizeof(kannibale))  {
       	        	
       	        	for(i=0; i<sizeof(kannibale); i++)  {
       	        		
       	        		tell_object(trintrasil,
       	        		" "+(i+1)+".) Name: "+kannibale[i]->QueryProp(P_NAME)+"\n");
       	        	}
		}	
	}
	
	if(dante)  {
		
		if(!sizeof(kannibale))  {
			
			tell_object(dante,"kannibale = NULL\n");
       	        }  				
       	        
       	        if(sizeof(kannibale))  {
       	        	
       	        	for(i=0; i<sizeof(kannibale); i++)  {
       	        		
       	        		tell_object(dante,
       	        		" "+(i+1)+".) Name: "+kannibale[i]->QueryProp(P_NAME)+"\n");
       	        	}
		}	
	}
}


check_helfer()  {
	
	int i;
	object dante;
	dante=find_player("gott");
	
	if(dante)  {
		
		if(!sizeof(helfer))  {
			
			tell_object(dante,"helfer = NULL\n");
       	        }  				
       	        
       	        if(sizeof(helfer))  {
       	        	
       	        	for(i=0; i<sizeof(helfer); i++)  {
       	        		
       	        		tell_object(dante,
       	        		" "+(i+1)+".) Name: "+helfer[i]->QueryProp(P_NAME)+"\n");
       	        	}
		}	
	}
}