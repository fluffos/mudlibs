#include <moving.h>
#include <properties.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define HUNDEHUETTE "/d/dschungel/trintrasil/dorfneu/room/roomd5"
#define WERKSTATT "/d/dschungel/trintrasil/dorfneu/room/momb"

int durchlauf = 0;//wird in hund_kommt() in /d/dschungel/trintrasil/dorfneu/room/roomd5 wieder
                  //zurueckgesetzt


ruf_um_hilfe(enemy) {
	
	if( HUNDEHUETTE->hund_present()==1 && durchlauf==0 ) {
		
		durchlauf=1;
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", BSL("\nPFIIIIIFFFF!!\n"
		"Mombassa ruft: KUKURUZ, SAPPORO EL GAIJIN!!\n\n"));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd5", BSL("\nAus der "
		"Huette neben Dir hoerst Du Kampflaerm.\nJemand ruft: KUKURUZ, SAPPORO EL "
		"GAIJIN!!\n\n"));
		call_out("ruf_um_hilfe1", 3, enemy);
		call_out("durchlauf_reset", 30);
	}
	
	if( WERKSTATT->hund_present()==1 && durchlauf==0 ) {
		
		durchlauf=1;
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", BSL("\nMombassa ruft: "
		"KUKURUZ, SAPPORO EL GAIJIN!!\n\n"));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd5", BSL("\nAus der "
		"Huette neben Dir hoerst Du Kampflaerm.\nJemand ruft: KUKURUZ, SAPPORO EL "
		"GAIJIN!!\n\n"));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/momb", BSL("\nDer Hund stuerzt "
		"sich zaehnefletschend in den Kampf.\n\n"));
		WERKSTATT->hundattacke(enemy);
		call_out("durchlauf_reset", 30);
	}
		
	else {
		return 0;
	}
}


ruf_um_hilfe1(enemy) {
	
	if( find_call_out("ruf_um_hilfe1")==-1 && HUNDEHUETTE->hund_present()==1 ) {
		
		HUNDEHUETTE->hund_kommt(enemy);
	}
	 
	else {
	}
}


durchlauf_reset() {
	
	if( WERKSTATT->mombassafight()==2 || WERKSTATT->hundfight()==2 ) {
		
		call_out("durchlauf_reset", 30);
		return 0;
	}
	
	if( WERKSTATT->hund_present() && WERKSTATT->mombassafight()==1 ) {
		
		if(HUNDEHUETTE->door_status()==-1) {
			
			HUNDEHUETTE->open_door();
			tell_room(WERKSTATT, BSL("Mombassa oeffnet die Tuer.\n"
			"\nMombassa sagt: Kikkido el Totee, Kukuruz.\n"
			"Der Hund geht vor die Huette.\n\n"));
			WERKSTATT->hund_move();
			tell_room(HUNDEHUETTE, BSL("Die Tuer der westlichen Huette oeffnet "
			"sich.\nEin Hund kommt aus der Huette und legt sich auf den Boden."));
			durchlauf = 0;
		}
		else {
			tell_room(WERKSTATT, BSL("Mombassa sagt: Kikkido el Totee, Kukuruz.\n"
			"Der Hund geht vor die Huette.\n\n"));
			WERKSTATT->hund_move();
			tell_room(HUNDEHUETTE, BS("Ein Hund kommt aus der westlichen Huette "
			"und legt sich auf den Boden."));
			durchlauf = 0;
		}
	}
	
	if( WERKSTATT->mombassada()==0 && WERKSTATT->hundfight()==1 ) {
		
		if(HUNDEHUETTE->door_status()==-1) {
			
			HUNDEHUETTE->open_door();
			tell_room(WERKSTATT, BSL("\nDer Hund stoesst die Tuer auf und geht "
			"knurrend vor die Huette.\n\n"));
			tell_room(HUNDEHUETTE, BSL("\nDie Tuer der westlichen Huette wird "
			"aufgestossen.\nEin Hund kommt knurrend aus der Huette und legt sich "
			"auf den Boden."));
			WERKSTATT->hund_move();
			durchlauf = 0;
		}
		
		else {
			tell_room(WERKSTATT, BSL("\nDer Hund geht knurrend vor die "
			"Huette.\n\n"));
			tell_room(HUNDEHUETTE, BSL("\nEin Hund kommt knurrend aus der "
			"Huette und legt sich auf den Boden."));
			WERKSTATT->hund_move();
			durchlauf = 0;
		}
	}
	
	else {
		durchlauf = 0;
	}
}