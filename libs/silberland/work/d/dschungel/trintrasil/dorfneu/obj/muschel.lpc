inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"schneckenhaus","haus","muschel","schale","muschelschale","kaorimuschel","kaorischale","kaorimuschelschale"}));
   SetProp(P_NAME, "Kaorimuschel");
   SetProp(P_NAME_ADJ, "gewunden");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Eine Kaorimuschel" );
   SetProp(P_LONG, BS(
   "Das rosa schimmernde Haus der Kaorimuschel ist beinahe armlang. Sie sieht eigentlich "
   "aus wie ein spitzes Schneckenhaus. Wenn man in die Muschel blaest kann man seltsame, "
   "laute Toene erzeugen."));
   SetProp(P_MATERIAL,MAT_MISC_SOLID);
   SetProp(P_VALUE,400);
   SetProp(P_WEIGHT,300);
   
   AD(({"toene","ton"}),
   "Blase einmal in die Muschel. Dann wirst Du es hoeren.");
   
   AddCmd(({"blase","blas"}), "toet");
}


toet(string str) {
	
	notify_fail("In was willst Du blasen?\n");
	
	if(str=="in muschel"||str=="in schneckenhaus"||str=="in haus"||str=="in schale"||
	str=="in muschelschale"||str=="in kaorimuschel"||str=="kaorischale") {
		
		write(BS("Du blaest in die Muschelschale und erzeugst einen ueber"
		"raschend lauten, tiefen Ton."));
		say(BSL("\nBOOOEEEEEEB!\n"+TPN+" blaest in eine Kaorimuschel."));
		return 1;
	}
}
