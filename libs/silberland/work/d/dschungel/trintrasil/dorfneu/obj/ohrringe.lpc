//diese ohrringe koennen zwar getragen und wieder abgelegt werde (das lebewesen muss nur das 
//pro "can_wear_earrings" haben) aber das wegwerfen, ablegen usw wird noch nicht abgefragt.

inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Ohrringe");
  SetProp(P_LONG, 
    "Die Ohrringe sind aus Knochen geschnitzt und sehr gross. Kleine bunte Federn "
    "sind an ihnen befestigt.");
  SetProp(P_NAME, "Ohrringe");
  SetProp (P_PLURAL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1 );
  AddId( ({"ringe","ohrringe","paar ohrringe","paar ringe"}) );
  
  SetProp(P_MATERIAL, ([MAT_BONE: 90, MAT_FEATHER: 10]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 350);
  
  AddDetail(("knochen"), 
  "Du erkennst das drei Knochenstuecke zu einem grossen Ring verbunden wurden.");
  
  AddDetail(({"stuecke","knochenstuecke"}),
  "Wahrscheinlich waren die einzelnen Knochen nicht gross genug um so einen grossen Ring "
  "aus ihnen schnitzen zu koennen.");
  
  AddDetail(({"knochen","ring"}),
  "Ein Ohrring ist ca so gross wie Deine Hand.");
  
  AddDetail(({"haende","hand"}),
  "Glaubst Du tatsaechlich dass Ohrringe Haende haben? Dein Weltbild moechte ich nicht haben.");
  
  AddDetail(({"bild","weltbild"}),
  "Du hast sicher Angst jeder Ohrring koennte Dich mit seinen Haenden erwuergen.");
  
  AddDetail(("angst"),
  "Schnell! Wirf die Ohrringe weg! AAAAH, Jetzt hat Dich so ein bloeder Ring am Hals gepackt.");
  
  AddDetail(("hals"),
  "Du bekommst kaum noch Luft! Toete den boesen Ohrring!");
  
  AddDetail(("luft"),
  "GurgelGurgelRoechel");
  
  AddDetail(({"feder","federn"}),
  "An den weiss polierten Knochenohrringen wurden kleine bunte Federn befestigt.");
  
  AddCmd(({"trage","stecke"}), "wear_func");
  AddCmd(({"ziehe","nimm"}), "undress_func");
}

_query_short() {
	
	if( TO->QueryProp("getragen")==1 ) {
		
		return("Ein Paar Ohrringe (getragen)");
	}
	
	else {
		return("Ein Paar Ohrringe");
	}
}


wear_func(string str) {
	
	if(str=="ringe"||str=="ohrringe"|str=="ringe an"||str=="ohrringe an") {
		
		if(TP->QueryProp("can_wear_earrings")>0) {
			
			if(interactive(TP)) {
				
				write(BS("Du steckst die Ohrringe an."));
				say(BS(""+TPN+" steckt sich Ohrringe an."));
				TO->SetProp("getragen");
				return 1;
			}
			
			else {
				TO->SetProp("getragen");
				return 1;
			}
		}
		
		if( !TP->QueryProp("can_wear_earrings") ) {
			
			tell_object(TP, BSL("\nDu kannst die Ohrringe nicht tragen.\nDeine "
			"Ohren sind nicht gestochen."));
			return 1;
		}
	}
	
	if(str=="alles") {
		
		if(TP->QueryProp("can_wear_earrings")>0) {
			
			if(interactive(TP)) {
				
				tell_object(TP, BS("Ein Paar Ohrringe: Du steckst die "
				"Ohrringe an."));
				tell_room(ENV(TP), BS(""+TPN+" steckt sich Ohrringe "
				"an."), TP);
				TO->SetProp("getragen",1);
				return 0;
			}
			
			else {
				TO->SetProp("getragen",1);
				return 0;
			}
		}
		
		if( !TP->QueryProp("can_wear_earrings") ) {
			
			tell_object(TP, BS("Ein Paar Ohrringe: Deine Ohren sind nicht "
			"gestochen."));
		return 0;
		}
	}
}


undress_func(string str) {
	
	if(str=="ringe aus"||str=="ohrringe aus"||str=="ringe ab"||str=="ohrringe ab") {
		
		if( !TO->QueryProp("getragen") || !TP->QueryProp("can_wear_earrings") ) {
			
			write(BS("Du traegst diese Ohrringe doch garnicht."));
			return 1;
		}
		
		if( TO->QueryProp("getragen")==1 && TP->QueryProp("can_wear_earrings")>0 ) {
			
			write(BS("Du nimmst die Ohrringe ab."));
			say(BS(""+TPN+" nimmt ein Paar Ohrringe ab."));
			TO->SetProp("getragen")==0;
			return 1;
		}
	}
	
	if(str=="alles aus") {
		
		if( !TO->QueryProp("getragen") || !TP->QueryProp("can_wear_earrings") ) {
			
			write(BS("Ein Paar Ohrringe: Du traegst diese Ohrringe garnicht."));
			return 0;
		}
		
		if( TO->QueryProp("getragen")==1 && TP->QueryProp("can_wear_earrings")>0 ) {
			
			write(BS("Ein Paar Ohrringe: Du nimmst die Ohrringe ab."));
			say(BS(""+TPN+" nimmt ein Paar Ohrringe ab."));
			TO->SetProp("getragen")==0;
			return 0;
		}
	}
}		