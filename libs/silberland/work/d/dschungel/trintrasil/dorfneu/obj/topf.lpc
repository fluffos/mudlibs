inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

int erbsen = 1;

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"tontopf","erbsentopf","topf"}));
   SetProp(P_NAME, "Topf");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Topf" );
   SetProp(P_LONG, BS(
   "Der kleine Topf ist ganz aus Ton. Er ist ca halbvoll mit Erbsen."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_CERAMIC);
   SetProp(P_VALUE,50);
   SetProp(P_WEIGHT,1000 );

   ASD(("erbsen"),
   "erbsen");
   AD(("ton"),
   "Der Topf ist sehr zweckmaessig und einfach gehalten. Der Ton ist von schlechter "
   "Qualitaet und nur einfach gebrannt.");
   AD(("qualitaet"),
   "Der Topf ist eben ein einfacher Gebrauchsgegenstand und kein Kunstwerk.");
   AD(({"werk","kunstwerk"}),
   "Wenn Du glaubst den Topf auf einer Kunstauktion teuer versteigern zu koennen bist Du "
   "nicht gerade ein Kenner.");
   AD(({"kenner","auktion","kunstauktion"}),
   "Naja, versuchen kannst Du es ja. Zumindest wird es avantgardistisch wirken.");
   
   AddCmd("iss", "junggemuese");
}

_query_long() {
	
	if(erbsen) {
		return(BS("Der kleine, einfach gearbeitete Topf ist ganz aus Ton. Er ist "
		"ca halbvoll mit Erbsen. Er scheint nicht besonders wertvoll zu sein, aber die "
		"Erbsen sehen gut aus."));
	}
	
	if(!erbsen) {
		return(BS("Der kleine, einfach gearbeitet Topf ist ganz aus Ton. Er ist "
		"leider leer. Er scheint nicht besonders wertvoll zu sein."));
	}
}


erbsen() {
	
	if(erbsen) {
		return(BS("Die Erbsen sind frisch und sehen ziemlich gut aus. Du koenntest "
		"sie ja essen."));
	}
	
	if(!erbsen) {
		return(BS("Welche Erbsen meinst Du? Der Topf ist leer."));
	}
}


int junggemuese(string str) {
	
	if(str=="erbsen aus topf"||str=="erbsen"||str=="erbsen topf"||str=="topf leer") {
		
		if(erbsen) {
			
			say(BS(""+TPN+" isst einen Erbsentopf leer. Sie scheinen geschmeckt "
			"zu haben."));
			write(BS("Du isst den ganzen Erbsentopf leer. Besonders viele waren "
			"es zwar nicht, aber sie waren nicht schlecht."));
			this_player()->heal_self(15+random(10));
			erbsen = 0;
			return 1;
		}
		
		if(!erbsen) {
			
			write(BS("Welche Erbsen meinst Du? Der Topf ist leer."));
			say(BS(""+TPN+" starrt sehnsuechtig in einen Topf."));
			return 1;
		}
	}
}

	