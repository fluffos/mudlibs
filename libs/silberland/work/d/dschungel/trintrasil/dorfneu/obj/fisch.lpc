inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
 string str;

 if (!is_clone(this_object())) return; 
::create();

 SetProp(P_SHORT, "Eine getrocknete Flussgrundel");
 SetProp(P_LONG, "Die Flussgrundel ist nur ein kleiner Speisefisch. Sie ist getrocknet "
 "und haelt dadurch sicher laenger. Auch wenn der Fisch recht klein ist schmeckt er sicher "
 "nicht schlecht und macht sicher notduerftig satt wenn Du Hunger hast.\n");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_VALUE, 50+random(30));
 AddId(({"grundel","flussgrundel","fisch","speisefisch"}));
 SetProp(P_NAME, "Flussgrundel");
 SetProp(P_MATERIAL, MAT_MISC_FOOD);
SetProp(P_NAME_ADJ, "getrocknet");
 SetProp(P_SMELL, BS("Die getrocknete Flussgrundel ist etwas eingesalzen. Ansonsten riecht "
 "sie wie ein normaler Fisch."));

SetProp(P_FOOD_INFO, ([F_HEAL : ({15,10+random(10)}), 
	        F_SOAK : 2,
	        F_MSG:"Du isst eine salzige, trockene Flussgrundel.\n",
	        F_MSG_ROOM:"isst einen Trockenfisch.\n"]));
	        
	        
 AD(({"speisefisch","speise"}),
   "Die Flussgrundel ist ein kleiner Speisefisch der nicht besonders viel "
   "ausgibt. Dennoch ist sie gut wenn Du Hunger hast.");
   
 AD(("hunger"),
   "Wenn Du sie jetzt nicht essen willst dann heb sie eben auf. Sie wird wohl "
   "noch laenger halten.");
}

