inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"feder","papageienfeder","schwanzfeder"}));
   SetProp(P_NAME, "Papageienfeder");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Eine Papageienfeder" );
   SetProp(P_LONG, BS(
   "Das ist eine Schwanzfeder eines maennlichen Papageies. Sie leuchtet in hellem "
   "Rot."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_FEATHER);
   SetProp(P_VALUE,10);
   SetProp(P_WEIGHT,5 );
   
   AD(({"maennchen","papagei","papageienmaennchen"}),
   "Es war wohl gerade Brunftzeit als das Papageienmaennchen diese Feder verloren hat.");
   
   AD(({"zeit","brunftzeit"}),
   "In der Brunftzeit locken die Papageienmaennchen die Weibchen mit besonders leuchtenden "
   "Federn.");
   
   AD(("weibchen"),
   "Und die Weibchen fallen darauf hinein.");
   
   AD(("rot"),
   "Das Rot ist satt und kraeftig und leuchtet besonders schoen."); 
}

