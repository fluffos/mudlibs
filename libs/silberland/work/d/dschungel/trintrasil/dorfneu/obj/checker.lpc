inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"checker"}));
   SetProp(P_NAME, "Checker");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Checker" );
   SetProp(P_LONG, BS(
   "Das ist eine Schwanzfeder eines maennlichen Papageies. Sie leuchtet in hellem "
   "Rot."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL,MAT_FEATHER);
   SetProp(P_VALUE,10);
   SetProp(P_WEIGHT,5 );
   
   AddCmd("test", "test_func");
   AddCmd("stein", "stein_func");
}

stein_func(string str) {
	
	object stein, dolly;
	dolly=find_player("dolly");
	
	if(str=="dolly") {
	
	stein=CLONEOB("/d/dschungel/trintrasil/fluss/obj/rock");
	stein->move(dolly, M_NOCHECK);
	return 1;
	}
}


test_func(string str) {
	
	object fisch;
	fisch=present("fisch", ENV(TP));
	
	notify_fail("Was willst Du testen?\n");
	
	if(str=="fisch" && fisch) {

		fisch->sag_int();
		return 1;
	}
		
	if(str=="kannibalen") {
		
		WARMASTER->check_kannibalen();
		return 1;
	}
	
	if(str=="helfer") {
		
		WARMASTER->check_helfer();
		return 1;
	}
	
	if(str=="namen") {
		
		WARMASTER->check_helfer_namen();
		return 1;
	}
	
	if(str=="turm") {
		
		tell_object(TP, BS("SetProp(\"turm\")=="+environment(TP)->QueryProp("turm")+""));
		return 1;
	}
}