
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"rassel","knochenrassel"}));
   SetProp(P_NAME, "Knochenrassel");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Eine Knochenrassel" );
   SetProp(P_LONG, BS(
   "Die Rassel besteht aus einem kleinen getrockneten Kuerbis und einem kurzen Holzgriff. In "
   "den Kuerbis wurden kleine Knochenstuecke eingefuellt um damit rasseln zu koennen. "
   "Am Griffende ist ein kleiner Vogelschaedel befestigt. Ausserdem ist die Rassel mit "
   "eigenartigen Schriftzeichen bedeckt."));
   SetProp(P_NOGET, 0);   
   SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:50, MAT_TICTOC_WOOD:40, MAT_BONE:10]) );
   SetProp(P_VALUE,50);
   SetProp(P_WEIGHT,100 );
   
   AD(({"trocknen","kuerbis"}),
   "Der Kuerbis ist ca faustgross und durch das Trocknen hart. Er ist mit seltsamen Zeichen "
   "bemalt.");
   
   AD(({"griff","holzgriff","ende","griffende"}),
   "Der Griff ist da 20 cm lang. An seinem Ende wurde ein kleiner Vogelschaedel befestigt.");
   
   AD(({"schaedel","vogelschaedel","papageienschaedel"}),
   "Der kleine Schaedel ist ein Papageienschaedel und ist am Griffende festgebunden.");
   
   AD(({"stuecke","knochenstuecke","knochen"}),
   "Die kleinen Knoechenstuecke kugeln rasselnd im trockenen Kuerbis herum wenn man ihn "
   "schuettelt."); 
   
   AD(({"schrift","zeichen","schriftzeichen"}),
   "Du kannst nichteinmal erkennen ob die Zeichen wirklich eine Schrift darstellen. Du "
   "weisst leider ueberhaupt nichts darueber.");
   
   SetProp(P_INFO, BS("Der Griff der Rassel ist aus Tictocholz. Ob die Rassel vielleicht "
   "magisch ist? Rassle doch einmal damit."));
   
   AddCmd(({"rassle","schuettle"}), "rassel_func");
}


rassel_func(string str) {
	
	notify_fail("Mit was willst Du rasseln?\n");
	
	if(str=="mit rassel"||str=="mit knochenrassel"||str=="mit kuerbisrassel"||
	str=="rassel"||str=="knochenrassel"||str=="kuerbisrassel") {
		
		switch(random(5)) {
			
			case 0:
			write(BSL("tschk, tschk, tschtschtschk..\nDu schuettelst die Rassel, "
			"es scheint aber nichts zu passieren."));
			say(BSL("tschk, tschk,tschtschtschk..\n"+TPN+" rasselt mit einer "
			"Rassel."));
			break;
			
			case 1:
			write(BSL("tschk, tschk, tschk..\nDu schuettelst die Rassel und "
			"ploetzlich wird Dir unheimlich kalt."));
			say(BSL("thsck, tschk,tschk..\n"+TPN+" rasselt mit einer "
			"Rassel. Bildest Du Dir das ein oder ist es ploetzlich "
			"kaelter."));
			break;
			
			case 2:
			write(BSL("tschk, tschk, tschtschtschk..\nDu schuettelst die Rassel. "
			"Ploetzlich kommt eine kleine Rauchwolke aus dem Vogelschaedel."));
			say(BSL("tschk, tschk, tschtschtschk..\n"+TPN+" rasselt mit einer "
			"Rassel. Ploetzlich ist "+TPN+" in eine kleine Rauchwolke gehuellt."));
			break;
			
			case 3:
			write(BSL("tschk, tschk, tschk..\nDu schuettelst die Rassel. "
			"Irgendwie kommt es Dir hier jetzt dunkler vor."));
			say(BSL("tschk, tschk, tschk..\n"+TPN+" rasselt mit einer Rassel. "
			"Irgendwie kommt er Dir hier jetzt dunkler vor."));
			break;
			
			case 4:
			write(BSL("tschk, tschk, tschk..\nDu schuettelst die Rassel. "
			"Ploetzlich wird die Rassel kurz brennheiss. Der Papageienschaedel "
			"scheint boesartig zu grinsen."));
			say(BSL("tschk, tschk, tschk..\n"+TPN+" rasselt mit einer Rassel "
			"und zuckt erschrocken."));
			break;
			
			default:
			write(BSL("tschk, tschk, tschtschtschk..\nDu schuettelst die Rassel, "
			"er scehint aber nichts zu passieren."));
			say(BSL("tschk, tschk,tschtschtschk..\n"+TPN+" rasselt mit einer "
			"Rassel."));
		}
		return 1;
	}
}
