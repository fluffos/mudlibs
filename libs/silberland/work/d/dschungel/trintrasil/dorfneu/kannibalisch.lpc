noun() {
	
	switch(random(21)) {
		
		case 0:
		return "Mombassa";
		break;
		
		case 1:
		return "Sekko";
		break;
		
		case 2:
		return "Moorto";
		break;
		
		case 3:
		return "Karoolo";
		break;
		
		case 4:
		return "Sucharo";
		break;
		
		case 5: 
		return "Sukko";
		break;
		
		case 6:
		return "Terrigee";
		break;
		
		case 7:
		return "Totee";
		break;
		
		case 8:
		return "Izzikee";
		break;
		
		case 9:
		return "Puchinee";
		break;
		
		case 10:
		return "Siantee";
		break;
		
		case 11:
		return "Jabata";
		break;
		
		case 12:
		return "Suota";
		break;
		
		case 13:
		return "Jimoa";
		break;
		
		case 14:
		return "Seggeta";
		break;
		
		case 15:
		return "Dante";
		break;
		
		case 16:
		return "Amnenion";
		break;
		
		case 17:
		return "Haustier";
		break;
		
		case 18:
		return "Trintrasil";
		break;
		
		case 19:
		return "Boersenkurse";
		break;
		
		case 20:
		return "Gaijin";
		break;
		
		default:
		return "Sukko";
	}
}


verb() {
	
	switch(random(12)) {
		
		case 0:
		return "encho";
		break;
		
		case 1:
		return "enchu";
		break;
		
		case 2:
		return "ratto";
		break;
		
		case 3:
		return "rattu";
		break;
		
		case 4:
		return "sachego";
		break;
		
		case 5:
		return "sachegu";
		break;
		
		case 6:
		return "jemeno";
		break;
		
		case 7:
		return "jemenu";
		break;
		
		case 8:
		return "kikkido";
		break;
		
		case 9:
		return "kikkidu";
		break;
		
		case 10:
		return "gekiddo";
		break;
		
		case 11:
		return "gekiddu";
		break;
		
		default:
