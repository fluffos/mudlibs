
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>

#include "/d/dschungel/trintrasil/myowndefine.h"



#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"



int beispielkrieger_durchlauf=0;



create()
{
   if (!is_clone(this_object())) return;

   ::create();



	
AddId( ({"kannibale","krieger","kannibalenkrieger","bemalter krieger","Axtkaempfer","NOWIMPY"}) );
   
create_default_npc( 21 );   


SetProp(P_SHORT, "Ein bemalter Krieger");
SetProp(P_LONG,  BSL("Der Krieger scheint bei den Kannibalen sehr geachtet zu sein. Er hat "
"seine vielen Narben mit roter Farbe nachgezogen. Auf seine Brust ist ein "
"schwarzer Leopard taetowiert. Er traegt einen gelb bemalten Helm eines "
"Wachsoldaten aus dem Vorposten, den er wahrscheinlich getoetet hat.\nDer Krieger beobachtet "
"Dich mit ruhiger, selbstsicherer Miene."));

SetProp(P_NAME_ADJ, "bemalt");
SetProp(P_NAME,      "Muschelkrieger");
SetProp(P_GENDER,    MALE);
SetProp(P_ARTICLE,   1);
SetProp(P_SIZE,      170+random(20));
SetProp(P_WEIGHT, 80000);
SetProp(P_MAX_HANDS, 2);
SetProp(P_ALIGN,     -35);
SetProp(P_RACE,      "Mensch");
SetProp(P_DIE_MSG,   " stirbt roechelnd.\n");
SetProp(P_DEFAULT_INFO,"sieht Dich gelassen an. Er scheint Dich nicht zu verstehen.");
   
SetProp("muschelkrieger", 1);

/*   
   clone_object("/d/dschungel/trintrasil/dorfneu/obj/muschel")->move(this_object());
   clone_object("/p/weapon/axe/steinaxt")->move(this_object());
   clone_object("/p/armour/trousers/lederhose")->move(this_object());
   clone_object("/d/dschungel/trintrasil/bogh/obj/leoumh")->move(this_object());
   khelm = clone_object("/d/dschungel/trintrasil/dorfneu/armour/kdschungelhelm")->move(TO);
   
   
   
   
   command("zuecke axt");
   command("trage alles");
*/

AddDetail( ("narben"),
"Die Narben hat der Krieger anscheinend aus vielen Kaempfen. Um sie zu betonen und um "
"sich ein unheimlicheres Aussehen zu geben hat er sie mit roter Farbe betont.");

AddDetail(("farbe"),
"Die Farbe ist hellrot und laesst die Narben gut sichtbar leuchten.");
   
AddDetail(({"ueberfall","soldat","gardist","stadtgardist","posten","vorposten"}),
"Anscheinend hat der Kannibale schon oefters bei einem Ueberfall auf den Vorposten "
"teilgenommen und dort einem getoetetem Soldaten den Helm abgenommen.");
   
AddDetail(({"beunruhigung","miene"}),
"Die ruhige, ueberlegen Miene des Kriegers zeigt keine Beunruhigung.");


   
WARMASTER->add_kannibale();
WARMASTER->add_helfer();

/*
     Hier ruft der Beispielkrieger im master die Funktionen add_kannibale() und add_helfer
     auf, mit denen er sich beim master einträgt.
     
     [** weiter beispielmasta Zeile 6 **]
*/      
}

/*
     Die Defend wird jedesmal aufgerufen, wenn der Krieger angegriffen wird, also jede
     Runde, in der ihm ein Schaden übergeben wird.
     
     ::Defend (siehe unten) darf nicht fehlen, sonst wird kein Schaden an den Krieger
     übergeben. Der normale Kampf soll durch unsere extra ausgeführte Defend nicht
     beeinträchtigt werden.
     
     Wir verwenden die Defend hier für zwei Dinge:
     
     1. Der den Beispielkrieger angreifende Feind soll allen Kannibalen als Feind
        eingetragen werden.
     
     2. Wir starten von hier aus die Aktion "verstärkung". Das ist eine Aktion des
        Beispielkriegers, in der er mit seinem Muschelhorn andere Kannibalen zu Hilfe
        ruft. Diese Aktion läuft auch über den master. Sie soll als Beispiel zeigen
        was man mit solchen arrays noch machen kann.
        
     Der Aufruf von Aktionen aus der Defend, hat ein Problem. Die Defend wird wie schon gesagt
     in jeder Kampfrunde aufgerufen.
     Das heisst der Beispielkrieger würde in jeder Runde Alarm schlagen. Ich habe das mit der
     Abfrage der Zahl "beispielkrieger_durchlauf" gelöst.
     
     Diese Zahl ist am fileanfang definiert (siehe Zeile 19) und ist zu Beginn 0.
     Wird die Defend jetzt ausgeführt (der Krieger angegriffen), ist diese Zahl in der ersten
     Runde 0.
     Somit wird "if(beispielkrieger_durchlauf==0)" ausgeführt.
     Mittels call_out wird die Funktion verstärkung aufgerufen, und die Zahl
     "beispielkrieger_durchlauf" wird 1 gesetzt.
     In der zweiten Runde ist sie somit nicht mehr 0 und die if wird nicht mehr ausgeführt.
     
     Die Aktion Verstärkung ist somit mittels call_out gestartet.
*/     


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
	
	if(beispielkrieger_durchlauf==0) {
		
		call_out("verstaerkung", 10+random(5));
		beispielkrieger_durchlauf=1;
	}
}




verstaerkung() {
	
	int i;
	object waechter, *exclude, *p;
	waechter=TO;
	exclude =({});
	p=all_inventory(ENV(TO));
	
	if(TO->InFight()==0) {
		
		muschelkrieger_durchlauf=0;
	}
	
	if(TO->InFight()) {
		
		for(i=sizeof(p)-1;i>=0;i--) {
			
			if(interactive(p[i])) {
				
				exclude += ({ p[i] });
			}
		}
		
		WARMASTER->schicke_verstaerkung(waechter, exclude);
		beispielkrieger_durchlauf=0;
		tell_room(ENV(TO), BSL("\n!!BOOOOOOOEEEEEEEEB!!\nDer bemalte Krieger blast "
		"nach Verstaerkung!\n\n"));
	}
}
/*
     Es soll für im Spiel folgendes passieren:
     
     1. Nach einer gewissen Zeit, nachdem der Krieger angegriffen wurde, blast er mit dem
        Muschelhorn Alarm und ruft somit alle im master als helfer eingetragenen Kannibalen
        herbei. (Das wird im Beispiel nicht behandelt)
        
     2. Weiters ruft der Beispielkrieger auch in regelmässigen Abständen mit dem Horn
        neue Kannibalen aus den Hütten.
        Diese Kannibalen werden dann neu erzeugt. Ihre Anzahl ist theoretisch unendlich. Der
        Krieger sollte also schnellstmöglich umgebracht werden. Wie das funktioniert zeige
        ich später im master.
     
     Gehen wir die Funktion Schritt für Schritt durch.
     
     
     A. Der master wird später in alle Räume im Dorf Meldungen verschicken, dass der
        Krieger in sein Horn bläst (es ist also überall zu hören). Um zu verhindern,
        dass Spieler, die im gleichen Raum wie der Krieger sind, und diese Meldung ohnehin
        schon von ihm sehen, noch eine zweite vom master bekommen, werden erst alle Spieler
        im gleichen Raum erfasst.
        Was damit wie gemacht wird, wird im master noch weiter gezeigt.
        
        Das Erfassen der anwesenden Spieler wird mit einer for-schleife gemacht [Zeile 164]:
           
           1. Wir müssen das array definieren, in die wir die anwesenden Spieler packen.
              
                *exclude
              
           2. Wir schicken dem master auch die Identität des Beispielkriegers als object. Das
              brauchen wir, damit der master ihn später in der Aktion wieder findet. Das wird
              im master noch genauer gezeigt.
              
                waechter
           
           3. Wir brauchen ein array, mit dem wir alle sich im Raum befindlichen Spieler in der
              for-schleife erfassen, und mit dem wir das array *exclude erstellen.
              
                *p
              
                p=all_inventory(ENV(TO));
              
                 [p ist also alles in der Umgebung dieses ojectes, also im gleichen Raum wie der
                  Beispielkrieger]
              
           Diese objecte werden in der Zeile 152 definiert
           
           4. Vielleicht hat der Kieger seinen Feind in der Zeit, die zwischen Angriff und
              Alarmschlagen vergeht schon alleine umgebracht, oder der Feind ist nicht mehr
              da.
              Daher müssen wir zuerst abfragen, ob der Krieger überhaupt noch im Kampf ist.
                
                if(TO->InFight()==0) {
		
		beispielkrieger_durchlauf=0;
		}
	      
	      Ist der Krieger nicht mehr im Kampf, gibt die Abfragefunktion InFight() 0
	      zurück, dann passiert nichts, ausser, dass die Zahl "beispielkrieger_durchlauf"
	      auf 0 gesetzt wird.
	      Wird der Krieger neuerlich angegriffen, kann er also in der Defend wieder Alarm
	      schlagen.
	    
	    5. Ist er allerdings noch im Kampf, also "TO->InFight()==1", läuft die Funktion
	       wie geplant weiter.
	      
	       In der for-schleife werden alle vorhandenen objecte in dem array *p erfasst.
	       Nur wenn das object ein interactive [spieler] ist, wird es in das array
	       *exclude eingetragen. Somit werden alle unnotwendigen objects ausgenommen.
	    
	    6. Im master wird die Funktion "schicke_verstärkung aufgerufen", wobei das erstellte
	       *exclude und der waechter mit übergeben werden. Wozu der master sie in dem Fall
	       braucht sehen wir später.
	    
	    7. die Zahl "beispielkrieger_durchlauf" wird wieder auf 0 gesetzt, damit der
	       Krieger erneut nach Verstärkung rufen kann. Somit ruft er den ganzen Kampf
	       über regelmässig Nachschub.
	    
	    Verfolgen wir die Aktion weiter in den master
	    
	    [** weiter beispielmasta Zeile 106 **]
*/




		
remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
	WARMASTER->remove_helfer(this_object());
        ::remove(arg);
}



help_victim(victim, victim_name) {
	
	if(ENV(victim)!=ENV(TO)) {
		
		tell_room(ENV(TO), BSL("\nDer bemalte Krieger eilt "+victim_name+" zu "
		"Hilfe!"));
	        tell_room(ENV(victim), BSL("\nEin bemalter Krieger eilt "+victim_name+" "
	        "zu Hilfe!\n\n"));
	        TO->move(ENV(victim), M_TPORT+ M_SILENT);
	}
}