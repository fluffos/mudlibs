
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#include "/d/dschungel/trintrasil/langdef.h"

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"mutter","kannibalin","kannibalenfrau","frau"}) );
   create_default_npc( 11 );   

SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow  
   
   SetProp(P_SHORT, "Eine Kannibalin");
   SetProp(P_LONG,  "Die Kannibalin scheint sehr aufgeregt zu sein und mustert Dich mit "
   "giftigen Blicken.");

   SetProp(P_NAME,      "Kannibalin");
   SetProp(P_GENDER,    FEMALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      150+random(20));
   SetProp(P_WEIGHT, 60000);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HANDS,     ({" ihren Fingernaegeln", 60}));
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt kreischend.\n");
   SetProp(P_DEFAULT_INFO,"kreischt: ""@@info@@");
   
   SetProp (P_MSGIN, "kommt schreiend an");
   SetProp (P_MMSGIN, "lauft schreiend aus einer Huette");
   SetProp (P_MSGOUT, "lauft schreiend weg");

   AD(({"blick","blicke"}),
   "Die Kannibalin muster Dich mit giftigen Blicken. Du scheinst ihr nicht besonders "
   "sympathisch zu sein.");
      
}

_query_long() {
	
	object kinder;
	kinder = present("kinderschar", ENV(TO));
	
	if(kinder) {
		
		return(BS("Die Kannibalin scheint sehr aufgeregt zu sein und mustert Dich mit "
		"giftigen Blicken. Sie klatscht ungeduldig in die Haende und will die Kinder "
		"in eine Huette treiben."));
	}
	
	if(!kinder) {
		
		return(BS("Die Kannibalin scheint sehr aufgeregt zu sein und mustert Dich mit "
		"giftigen Blicken. Sie sieht sich ungeduldig um und murrt zornig."));
	}
}

string info () {
	
	return(BS(""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+"."));
}
