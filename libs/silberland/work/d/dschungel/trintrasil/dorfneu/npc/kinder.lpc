
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#include "/d/dschungel/trintrasil/langdef.h"


int PreventFollow(object dest) {
	
	if( ENV(TO)->QueryProp("begrenzungsraum_kinder_tor")==1 ) {
		
		tell_room(ENV(TO), BSL("\nDie Kinderschar laeuft kreischend nach Sueden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd1", BSL("\nEine Kinder"
		"schar laeuft an Dir vorbei nach Sueden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd2", BSL("\nEine Kinder"
		"schar laeuft an Dir vorbei nach Suedwesten."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd4", BSL("\nEine "
		"laermende Kinderschar kommt aus dem Nordosten und laeuft kreischend in eine "
		"Huette."));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", M_GO + M_SILENT);
		return 2;
	}
	
	if( ENV(TO)->QueryProp("begrenzungsraum_kinder_roomd6")==1 ) {
		
		tell_room(ENV(TO), BSL("\nDie Kinderschar laeuft kreischend nach Norden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd3", BSL("\nEine "
		"Kinderschar laeuft an Dir vorbei nach Westen."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd4", BSL("\nEine "
		"laermende Kinderschar kommt aus dem Osten und laeuft kreischend in eine "
		"Huette."));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", M_GO + M_SILENT);
		return 2;
	}
	
	if( ENV(TO)->QueryProp("begrenzungsraum_kinder_roomd5")==1 ) {
		
		tell_room(ENV(TO), BSL("\nDie Kinderschar laeuft kreischend nach Sueden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd4", BSL("\nEine "
		"laermende Kinderschar kommt aus dem Norden und laeuft kreischend in eine "
		"Huette."));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", M_GO + M_SILENT);
		return 2;
	}
	
	else {
		return 0;
	}
}
		
		
create()
{
	
   
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kinder","schar","kinderschar"}) );
   create_default_npc( 10 );   
   
SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
   
   SetProp(P_SHORT, "Eine Kinderschar");
   SetProp(P_LONG,  "Die Kinder laufen kreischend und lachend um Dich herum und zerren "
   "neugierig an Deiner Kleidung. Sie sind Dir gegenueber weder misstrauisch noch "
   "aengstlich.");

   SetProp(P_NAME,      "Kinderschar");
   SetProp(P_NAME_ADJ, "laermend");
   SetProp(P_GENDER,    FEMALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      100+random(20));
   SetProp(P_WEIGHT, 240000);
   SetProp(P_MAX_HANDS, 11);
   SetProp(P_HANDS,     ({" ihren vielen Haenden", 60}));
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt weinend.\n");
   SetProp(P_DEFAULT_INFO,"lacht ueber Dein fuer sie unverstaendliches Geplapper.");
   
   SetProp (P_MSGIN, "kommt schreiend an");
   SetProp (P_MMSGIN, "lauft schreiend aus einer Huette");
   SetProp (P_MSGOUT, "lauft schreiend weg");
   
   set_living_name ("kannibalenkinderschar");
   
   

   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   
   
   command("trage alles");
   
   
   
   SetChats(25, ({
  	"\nDie Kinder laufen kreischend um Dich herum.\n",
  	"\nEin Kind haengt sich an Dein Bein.\n",
  	"\nEin Kind nimmt einem anderen einen Zuckerkaefer weg.\n",
  	"\nEin Kind beginnt mit einem anderen zu raufen.\n",
  	"\nEin Kind haut einem anderem Kind eine runter.\n",
  	"\nDie Kinder schreien vergnuegt und springen vor Dir umher.\n",
  	"\nEin Kind schlaegt sich ein Knie auf und beginnt zu weinen.\n",
  	"\nDie Kinder zerren neugierig an Deiner Ausruestung.\n",
  	"\nEin Kind haengt sich an Deinen Arm.\n",
  	"\nDie Kinder betasten Dich neugierig.\n",
  	"\nDie Kinder laufen kreischend um Dich herum.\n",
  	"\nDie Kinderschar schreit: AAIIIIIIIIIIIIIIHHHHH!!!\n",
  	"\nDie Kinderschar schreit: AAIIIIIIIIIIIIIIHHHHH!!!\n",
  	"\nDie Kinderschar zerrt lachend an Deinen Armen.\n",
  	"\nEin Kind pinkelt in seinen Lendenschurz.\n",
  	"\nDie Kinder singen: "+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+"!\n",
  	"\nDie Kinder singen: "+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+"!\n"}));

   
}


go_home() {
	
	int i;
        object *inv;
        inv=all_inventory(environment(TO));
    
        for(i=sizeof(inv)-1;i>=0;i--) { 
        	
        	if(interactive(inv[i]))  {
        		
        		inv[i]->RemovePursuer(find_living("kannibalenkinderschar"));
        	}
        }
        
        TO->SetProp("ausserhaus", 0);
        TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", M_TPORT + M_SILENT);
}