inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"

int durchlauf_greis=0;


init() {
	
	::init();
	
	if( interactive(TP) ) {
		
		if(TO->QueryProp("sitzend")==1 && (environment(TP)==environment(TO)) ) {
			
			call_out("init1", 3);
		}
	}
}


int PreventFollow(object dest) {
		
	if( ENV(TO)->QueryProp("begrenzungsraum_greis_room9")==1 ) {
		
		tell_room("/d/dschungel/trintrasil/dorfneu/room/room9", BSL("\nDer Greis geht "
		"rasselnd und singend zurueck ins Dorf."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/room10", BSL("\nEin rasselnder, "
		"singender Greis geht an Dir vorbei nach Osten."));
		tell_room("/d/dschungel/charon/dorfneu/room/room11", BSL("\nEin rasselnder, "
		"singender Greis geht an Dir vorbei nach Sueden."));
		tell_room("/d/dschungel/charon/dorfneu/room/tor", BSL("\nEin rasselnder, "
		"singender Greis geht an Dir vorbei nach Sueden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd1", BSL("\nEin rasselnder, "
		"singender Greis geht an Dir vorbei nach Sueden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd2", BSL("\nEin rasselnder, "
		"singender Greis geht an Dir vorbei nach Sueden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd3", BSL("\nEin Greis kommt an "
		"und setzt sich auf einen Stuhl vor der Huette."));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/roomd3", M_GO+ M_SILENT);
		TO->SetProp("sitzend", 1);
		return 2;
	}
	
	if( ENV(TO)->QueryProp("begrenzungsraum_greis_roomd5")==1 ) {
		
		tell_room( ENV(TO), BSL("Der Greis geht rasselnd und singen nach Sueden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd4", BSL("\nEin rasselnder, "
		"singender Greis geht an Dir vorbei nach Osten."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd3", BSL("\nEin Greis "
		"kommt an und setzt sich auf einen Stuhl vor der Huette."));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/roomd3", M_GO+ M_SILENT);
		TO->SetProp("sitzend", 1);
		return 2;
	}
	
	if( ENV(TO)->QueryProp("begrenzungsraum_greis_roomd6")==1 ) {
		
		tell_room( ENV(TO), BSL("Der Greis geht rasselnd und singen nach Norden."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd3", BSL("\nEin Greis "
		"kommt an und setzt sich auf einen Stuhl vor der Huette."));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/roomd3", M_GO+ M_SILENT);
		TO->SetProp("sitzend", 1);
		return 2;
	}
	
	if( file_name(dest)=="/room/death/death_room")  {
		
		tell_room(ENV(TO), BS("Der Greis lacht gehaessig und geht rasselnd davon."));
		tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd3", BSL("\nEin Greis "
		"kommt an und setzt sich auf einen Stuhl vor der Huette."));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/roomd3", M_GO+ M_SILENT);
		TO->SetProp("sitzend", 1);
		return 2;  
	}
			
	else {
		return 0;
	}
}


create()
{
	object kittel;
	
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","greis","mann","alter"}) );
   create_default_npc( 8 );   

   SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
   
   SetProp(P_SHORT, "Ein alter Kannibale");
   SetProp(P_LONG,  "Das Gesicht des alten Kannibalen ist mit einem dichten Netz tiefer "
   "Runzeln ueberzogen. Er ist sehr duerr und wirkt etwas zittrig. In sein langes, weisses "
   "Haar hat er einige Papageienfedern geflochten. Er singt mit seiner eigenartig hohen "
   "Greisenstimme eine seltsame Melodie.");

   SetProp(P_NAME,      "Kannibale");
   SetProp(P_NAME_ADJ, "alt"); 
   SetProp(P_GENDER,    MALE);
   SetProp(P_WEIGHT, 50000);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      150+random(20));
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt kreischend.\n");
   
   SetProp (P_MSGIN, "kommt rasselnd an");
   SetProp (P_MMSGIN, "kommt rasselnd an");
   SetProp (P_MSGOUT, "geht weg");
   
   SetProp("sitzend", 1);
   
   set_living_name ("kannibalengreis");   
   

   
   
   kittel = clone_object("/d/dschungel/trintrasil/dorfneu/armour/kittel");
   kittel->move(this_object());
   kittel->Damage(4);
   
   clone_object("/d/dschungel/trintrasil/dorfneu/obj/feder")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/obj/feder")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/obj/rassel")->move(this_object());

   
   command("trage alles");
   
   
   AddDetail(({"runzeln","gesicht"}),
   "Das braune Gesicht des Greises ist mit einem Labyrinth aus Runzeln ueberzogen.");
    
   AddDetail(({"runzel","runzeln","netz","labyrinth"}),
   "Der Kannibale ist wohl schon sehr alt. Auch wenn er etwas zittrig wirkt sieht er aber "
   "noch recht fit aus.");
   
   AddDetail(("haar"),
   "Der Kannibale hat einige Federn in sein langes duennes Haar geflochten.");
   
   AddDetail(({"haar","papageienfedern","federn"}),
   "Der Greis hat die leuchtend bunten Federn sehr sorgfaeltig in sein schneeweisses Haar "
   "geflochten.");
   
   AddDetail(({"stimme","greisenstimme"}),
   "Die Stimme des alten Kannibalen klingt duenn und hoch. Er singt staendig die gleiche "
   "Melodie.");
   
   AddDetail(("melodie"),
   "Die Melodie klingt wie eine Beschwoerung. Vielleicht will Dich der Greis verfluchen?");
   
   AddDetail(({"nackenhaare","rythmus","beschwoerung","haare"}),
   "Deine Nackenhaare richten sich auf als der Greis seine Rassel in deine Richtung "
   "schuettelt.");
   
   AddDetail(({"knochenrassel","richtung","rassel"}),
   "tschk, tschk, tschtschtschk... der Greis schuettelt seine Knochenrassel immer im "
   "gleichen Rythmus.");
   
   
   SetProp(P_DEFAULT_INFO,"singt nur immer die gleiche Melodie.");
   
   
SetChats(20, ({
  	"\nDer Greis schuettelt beschwoerend seine Rassel.\n",
  	"\nDer Greis singt eine hohe Melodie.\n",
  	"\nDer Greis blickt Dich mit starrem Ausdruck an.\n",
  	"\nDer Greis schuettelt die Rassel in Deine Richtung.\n",
  	"\nDer Greis ruckt eigenartig mit dem Kopf.\n",
  	"\nDer Greis singt: Kikihaa, Kikihaa, tok tok sese miagi.\n",
  	"\nDer Greis singt: Kikihaa, Kikihaa, tok tok sese miagi.\n",
  	"\nDer Greis wiegt summend den Kopf.\n",
  	"\nDich froestelt beim Klang der duennen Stimme.\n",
  	"\nDer Greis schuettelt seine Rassel und traellert dabei schrill.\n",
  	"\nDer Greis schuettelt beschwoerend seine Rassel.\n"}));
 

   WARMASTER->add_kannibale();
   
}


init1() {
	
	if( !TO->InFight() && find_call_out("init1")==-1 && ENV(TP)==ENV(TO) ) {
		
		this_player()->AddPursuer(this_object());
		write(BSL("\nDer alte Mann steht auf und schuettelt seine Rassel "
		"bedrohlich in Deine Richtung."));
		say(BSL("\nDer alte Mann steht auf und schuettelt seine Rassel "
		"bedrohlich in die Richtung von "+TPN+"."), TP);
		TO->SetProp("sitzend", 0);
		TO->SetProp(P_MSGOUT, "geht "+TPN+" hinterher");
	}
}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	int i;
	object victim, *exclude, *p;
	string victim_name;
	victim = this_object();
	victim_name = "dem alten Kannibalen";
	
	exclude = ({});
	p=all_inventory(ENV(TO)); 
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
	
	if(durchlauf_greis==0 && !ENV(TO)->QueryProp("no_help_here") && !ENV(TO)->QueryProp("palisadenraum") ) {//durchlauf reseten
		
		for(i=sizeof(p)-1;i>=0;i--) {
			
			if(interactive(p[i])) {
				
				exclude += ({ p[i] });
				p[i]->RemovePursuer(find_living("kannibalengreis"));
			}
		}
		
		tell_room(ENV(TO), BSL("\nDer Greis beginnt laut zu schreien!\n\n"));
		WARMASTER->kannibalen_attack(victim, victim_name, exclude);
		durchlauf_greis=1;
		TO->SetProp("sitzend", 0);//reseten wenn er wieder vor die huette geht
		call_out("flight", 8+random(5));
	}
	
	if(durchlauf_greis==0 && (ENV(TO)->QueryProp("no_help_here")||ENV(TO)->QueryProp("palisadenraum")) ) {
		
		for(i=sizeof(p)-1;i>=0;i--) {
			
			if(interactive(p[i])) {
				
				p[i]->RemovePursuer(find_living("kannibalengreis"));
			}
		}
		
		durchlauf_greis=1;
		TO->SetProp("sitzen", 0);
		call_out("flight", 8+random(5));
	}
}


flight() {
	
	if(ENV(TO)->QueryProp("no_help_here")==1) {
		
		tell_room(ENV(TO), BSL("\nDer alte Kannibale flieht schnell zurueck ins "
		"Dorf.\n\n"));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", M_TPORT+ M_SILENT);
		call_out("go_back", 300+random(100));
		durchlauf_greis=0;
	}
	
	else {
		tell_room(ENV(TO), BSL("\nDer alte Kannibale flieht eilig in eine "
		"Huette.\n\n"));
		TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", M_TPORT+ M_SILENT);
		call_out("go_back", 300+random(100));
		durchlauf_greis=0;
	}
}


go_back() {
	
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd3", BSL("\nEin alter Kannibale "
	"kommt aus einer Huette und setzt sich auf einen Stuhl unter einem Vordacht."));
	TO->SetProp("sitzend", 1);
	TO->move("/d/dschungel/trintrasil/dorfneu/room/roomd3", M_TPORT+ M_SILENT);
}


remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
        ::remove(arg);
}