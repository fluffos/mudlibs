
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","krieger","jaguarkrieger","Schwertmeister","Talkpartner","NOWIMPY"}) );
   create_default_npc( 39 );   

SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow   
   
   SetProp(P_SHORT, "Ein weisser Jaguarkrieger");
   SetProp(P_LONG, BSL("Die Jaguarkrieger der Kannibalen sind bei den Gardisten gefuerchtet. "
   "Dieser Krieger sind alle gross, durchtrainiert und leben nur um zu toeten und tun dies "
   "besonders im Dschungel lautlos, schnell und zielsicher. Sein knurrendes Gesicht ist "
   "mit der schwarzen Fratze eines Totenschaedels bemalt und seine Arme sind mit weissen "
   "Taetowierungen bedeckt.\nDie weissen Jaguarkrieger kaempfen mit Macheten."));

   SetProp(P_NAME_ADJ, "weiss");
   SetProp(P_NAME,      "Jaguarkrieger");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_WEIGHT, 90000);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_ALIGN,     -35);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt knurrend.\n");
   SetProp(P_DEFAULT_INFO,"reagiert ueberhaupt nicht auf Dich.");

   clone_object("/d/dschungel/trintrasil/dorfneu/weapon/machete")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lederhose")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/jagumh")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/knochenhelm")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/jaguarpanzer")->move(this_object());
   
   
   
   command("zuecke machete");
   command("trage alles");
   
   
   AddDetail( ({"wachsoldaten","gardisten","soldaten"}),
   "Die Wachsoldaten fuerchten die Jaguarkrieger wegen ihrer Anpassungsfaehigkeit im "
   "Dschungel und ihrer Grausamkeit.");
   
   AddDetail(("anpassungsfaehigkeit"),
   "Die Jaguarkrieger sind im Dschungel aufgewachsen und koennen sich schnell und lautlos "
   "in ihm bewegen.");
   
   AddDetail(({"grausamkeit"}),
   "Die Jaguarkrieger toeten schnell und ohne Mitleid.");
   
   AddDetail(({"mitleid","faehigkeit"}),
   "Jemand der von Kindesbeinen an nur zum Kaempfen erzogen wird verliert irgendwann die "
   "Faehigkeit Mitleid zu empfinden.");
    
   
SetAttackChats(25, ({
	"\n Der weisse Jaguarkrieger bleckt die Zaehne!\n\n",
	"\n Der weisse Jaguarkrieger knurrt!\n\n",
	"\n Der rote Jaguarkrieger faucht: El Sekko poncho il Jishee!\n\n",
	"\n Der weisse Jaguarkrieger fletscht knurrend die Zaehne!\n\n",
	"\n Der weisse Jaguarkrieger kaempft ohne Ruecksicht auf eigene Wunden!\n\n",
	"\n Der weisse Jaguarkrieger hackt mit der Machete auf Dich ein!\n\n",
	"\n Der weisse Jaguarkrieger bleckt zischend die Zaehne!\n\n",
	"\n Der weisse Jaguarkrieger faucht: Sekko Seehhh!\n\n",
	"\n Der weisse Jaguarkrieger knurrt: Encho varro del Moorto!\n\n",
	"\n Der weisse Jaguarkrieger weicht unglaublich schnell aus!\n\n",
	"\n Der weisse Jaguarkrieger faucht wie eine Raubkatze!\n\n"}) );

SetChats(5, ({
	"\nDer weisse Jaguarkrieger stiert Dich durchdringend an.\n",
	"\nDer weisse Jaguarkrieger knurrt leise.\n",
	"\nDer weisse Jaguarkrieger stoesst ein klaeffendes Bellen aus.\n",
	"\nDer weisse Jaguarkrieger knurrt in Deine Richtung.\n",
	"\nDer weisse Jaguarkrieger schwingt seine Machete.\n",
	"\nDer weisse Jaguarkrieger lockert seine Muskeln.\n",
	"\nDer weisse Jaguarkrieger bellt in Deine Richtung.\n",
	"\nDer weisse Jaguarkrieger sagt: Sukko mem bo Karoolo.\n",
	"\nDer weisse Jaguarkrieger sagt: El Serrekigo Mombassa.\n",
	"\nDer weisse Jaguarkrieger knurrt: Enchero sekko sucharo Moorto.\n"}) );
	

WARMASTER->add_kannibale();
WARMASTER->add_helfer();


SetProp(P_SPELLRATE, 5);

AddSpell(1,1000+random(500),
BSL("\nDer weisse Jaguarkrieger knurrt: Jaguar coyocco hijaceh!\nDer Jaguarkrieger macht eine "
"Kombination von Schlaegen und hackt Dir seine Machete gegen die Brust.\n\n"),
BSL("\nDer weisse Jaguarkrieger knurrt: Jaguar coyocco hijaceh!\nDer Jaguarkrieger macht eine "
"Kombination von Schlaegen und hackt seine Machete gegen @WESSEN Brust.\n\n"),
DT_SLASH, ([SP_SHOW_DAMAGE:1]) );


}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
}


remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
        WARMASTER->remove_helfer(this_object());
        ::remove(arg);
} 


help_victim(victim, victim_name) {
	
	if(ENV(victim)!=ENV(TO)) {
		
		tell_room(ENV(TO), BSL("\nDer Jaguarkrieger eilt "+victim_name+" zu "
		"Hilfe!"));
	        tell_room(ENV(victim), BSL("\nEin bemalter Krieger eilt "+victim_name+" "
	        "zu Hilfe!\n\n"));
	        TO->move(ENV(victim), M_TPORT+ M_SILENT);
	}
}