
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"


create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","krieger","jaguarkrieger","Keulenmeister","Talkpartner","NOWIMPY"}) );
   create_default_npc( 39 );   

 SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow 
   
   SetProp(P_SHORT, "Ein roter Jaguarkrieger");
   SetProp(P_LONG, BSL("Die Jaguarkrieger der Kannibalen sind bei den Gardisten gefuerchtet. "
   "Dieser Krieger sind alle gross, durchtrainiert und leben nur um zu toeten und tun dies "
   "besonders im Dschungel lautlos, schnell und zielsicher. Sein knurrendes Gesicht ist "
   "mit der schwarzen Fratze eines Totenschaedels bemalt und seine Arme sind mit roten "
   "Taetowierungen bedeckt.\nDie roten Jaguarkrieger verwendent Stachelkeulen."));

   SetProp(P_NAME_ADJ, "rot");
   SetProp(P_NAME,      "Jaguarkrieger");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_WEIGHT, 90000);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_ALIGN,     -35);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt knurrend.\n");
   SetProp(P_DEFAULT_INFO,"reagiert ueberhaupt nicht auf Dich.");

   clone_object("/d/dschungel/trintrasil/dorfneu/weapon/stachelkeule")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lederhose")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/jagumh")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/knochenhelm")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/jaguarpanzer")->move(this_object());
   
   
   
   command("zuecke keule");
   command("trage alles");
   
   
   AddDetail( ({"wachsoldaten","gardisten","soldaten"}),
   "Die Wachsoldaten fuerchten die Jaguarkrieger wegen ihrer Anpassungsfaehigkeit im "
   "Dschungel und ihrer Grausamkeit.");
   
   AddDetail(("anpassungsfaehigkeit"),
   "Die Jaguarkrieger sind im Dschungel aufgewachsen und koennen sich schnell und lautlos "
   "in ihm bewegen.");
   
   AddDetail(({"grausamkeit"}),
   "Die Jaguarkrieger toeten schnell und ohne Mitleid.");
   
   AddDetail(({"mitleid","faehigkeit"}),
   "Jemand der von Kindesbeinen an nur zum Kaempfen erzogen wird verliert irgendwann die "
   "Faehigkeit Mitleid zu empfinden.");
    
   
SetAttackChats(25, ({
	"\n Der rote Jaguarkrieger bleckt die Zaehne!\n\n",
	"\n Der rote Jaguarkrieger knurrt!\n\n",
	"\n Der rote Jaguarkrieger faucht: El Sekko poncho il Jaohee!\n\n",
	"\n Der rote Jaguarkrieger fletscht knurrend die Zaehne!\n\n",
	"\n Der rote Jaguarkrieger kaempft ohne Ruecksicht auf eigene Wunden!\n\n",
	"\n Der rote Jaguarkrieger hackt mit der Stachelkeule auf Dich ein!\n\n",
	"\n Der rote Jaguarkrieger bleckt zischend die Zaehne!\n\n",
	"\n Der rote Jaguarkrieger faucht: Sekko Seehhh!\n\n",
	"\n Der rote Jaguarkrieger knurrt: Encho varro del Moorto!\n\n",
	"\n Der rote Jaguarkrieger weicht unglaublich schnell aus!\n\n",
	"\n Der rote Jaguarkrieger faucht wie eine Raubkatze!\n\n"}) );

SetChats(3, ({
	"\nDer rote Jaguarkrieger stiert Dich durchdringend an.\n",
	"\nDer rote Jaguarkrieger knurrt leise.\n",
	"\nDer rote Jaguarkrieger stoesst ein klaeffendes Bellen aus.\n",
	"\nDer rote Jaguarkrieger knurrt in Deine Richtung.\n",
	"\nDer rote Jaguarkrieger schwingt seine Stachelkeule.\n",
	"\nDer rote Jaguarkrieger lockert seine Muskeln.\n",
	"\nDer rote Jaguarkrieger bellt in Deine Richtung.\n",
	"\nDer rote Jaguarkrieger sagt: Sukko mem bo Karoolo.\n",
	"\nDer rote Jaguarkrieger sagt: Serrekigo el Mombassa.\n",
	"\nDer rote Jaguarkrieger knurrt: Enchero sekko sucharo Moorto.\n"}) );


WARMASTER->add_kannibale();
WARMASTER->add_helfer();


SetProp(P_SPELLRATE, 5);

AddSpell(1,1000+random(500),
BSL("\nDer rote Jaguarkrieger knurrt: Jaguar eche el Sorvossa!\nDer Jaguarkrieger macht "
"einen gedrehten Wuchtschlag und kracht Dir seine Stachelkeule an den Schaedel.\n\n"),
BSL("\nDer rote Jaguarkrieger knurrt: Jaguar eche dek Moorto!\nDer Jaguarkrieger macht "
"einen gedrehten Wuchtschlag und kracht seine Stachelkeule an @WESSEN Schaedel.\n\n"),
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
}


remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
	WARMASTER->remove_helfer(this_object());
        ::remove(arg);
}


help_victim(victim, victim_name) {
	
	if(ENV(victim)!=ENV(TO)) {
		
		tell_room(ENV(TO), BSL("\nDer Jaguarkrieger eilt "+victim_name+" zu "
		"Hilfe!"));
	        tell_room(ENV(victim), BSL("\nEin bemalter Krieger eilt "+victim_name+" "
	        "zu Hilfe!\n\n"));
	        TO->move(ENV(victim), M_TPORT+ M_SILENT);
	}
}