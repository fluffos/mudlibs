
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#include "/d/dschungel/trintrasil/langdef.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"

int question_counter = 0;
int durchlauf_kannibalin = 0;

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"mutter","kannibalin","kannibalenfrau","frau"}) );
   create_default_npc( 9 );   

 SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow  
   
   SetProp(P_SHORT, "Eine Kannibalin");
   SetProp(P_LONG,  BSL("Die Kannibalin sitzt mit verschraenkten Beinen vor einer Huette und "
   "schaelt Erbsen in einen Topf.\nIhr Koerper ist mit weissen Kreidezeichnungen verziert. "
   "Sie muster Dich verstohlen mit neugierigen, aber misstrauischen Blicken."));

   SetProp(P_NAME,      "Kannibalin");
   SetProp(P_NAME_ADJ, "jung");
   SetProp(P_GENDER,    FEMALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      150+random(20));
   SetProp(P_WEIGHT, 60000);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HANDS,     ({" ihren Fingernaegeln", 60}));
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt kreischend.\n");
   
   SetProp("sitzend", 1);
   SetProp("can_wear_earrings", 1);

   clone_object("/d/dschungel/trintrasil/dorfneu/obj/topf")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/obj/ohrringe")->move(this_object());
   
   
   command("trage alles");
   

   AD(({"blick","blicke"}),
   "Die Kannibalin mustert Dich neugierig wenn sie glaubt, dass Du es nicht bemerkst. "
   "Sie scheint aber sehr misstrauisch zu sein.");
   
   AD(({"bein","beine"}),
   "Die Kannibalin sitzt mit verschraenten Beinen auf dem Boden und schaelt Erbsen in einen "
   "Topf auf ihrem Schoss.");
   
   AD(("schoss"),
   "Auf ihrem Schoss hat sie einen Topf mit Erbsen.");
   
   AD(({"erbsen","topf"}),
   "Die Erbsen in ihrem Topf sehen gut aus. Ihr wuerde es aber sicher nicht gefallen wenn "
   "Du Dir einfach ein paar nehmen wuerdest.");
   
   AD(("koerper"),
   "Ihr schwarzer Koerper ist mit weissen Kreidezeichnungen bemalt. Bis auf einen Lenden"
   "schurz ist sie unbekleidet. Bei den Kannibalen scheint Nacktheit nichts besonderes zu "
   "sein.");
   
   AD(("nacktheit"),
   "Dem Reinen ist eben alles rein.");
   
   AD(("reiner"),
   "Du bist wohl nicht so besonders rein, was? Schaem Dich!");
   
   AD(({"zeichnungen","kreidezeichnungen","muster","verzierung"}),
   "Die Zeichnungen sind einfach nur Muster. Du weisst leider nicht ob sie etwas "
   "bedeuten oder ob sie nur zur Verzierung dienen.");

   
   AddCmd(({"nimm","stehle","greife"}), "topf_take");
   AddCmd(({"frage","frag"}), "info_func");
   

WARMASTER->add_kannibale();

}

_query_long() {
	
	if(TO->QueryProp("sitzend")==1) {
		
		return(BSL("Die Kannibalin sitzt mit verschraenkten Beinen vor einer Huette "
		"und schaelt Erbsen in einen Topf.\nIhr Koerper ist mit weissen "
		"Kreidezeichnungen bemalt. Sie muster Dich verstohlen mit neugierigen, aber "
		"misstrauischen Blicken."));
	}
	
	if(TO->QueryProp("sitzend")==0) {
		
		return(BS("Die Kannibalin sieht Dich aengstlich an. Sie fuchtelt wild mit den "
		"Armen und schreit laut. Es wird nicht lange dauern bis ihr die Krieger "
		"des Dorfes zu Hilfe eilen und es hier wirklich ungemuetlich fuer Dich "
		"wird."));
	}
}


int info_func(string str) {
	
	string was;
	
        if(sscanf(str, "kannibalin nach %s", was)) {
        	
        	if(question_counter<2) {
        		
        		tell_room(ENV(TO), BSS(""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "
        		""+ARTICLE_k+" "+NOUN_k+".","Die Kannibalin sagt: "));
        		question_counter++;
        		return 1;
        	}
        	
        	if(question_counter>=2) {
        		
        		tell_room(ENV(TO), BSS(""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "
        		""+ARTICLE_k+" "+NOUN_k+".","Die Kannibalin sagt: "));
        		tell_room(ENV(TO), BS("Die Kannibalin nimmt ihren Topf und geht in "
        		"die naechste Huette."));
        		TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", 
        		M_TPORT + M_SILENT);
        		question_counter=0;
        		call_out("move_back", 20+ random(10));
        		return 1;
        	}
        }
}


move_back() {
	
	tell_room("/d/dschungel/trintrasil/dorfneu/room/roomd1", BSL("\nEine Huettentuer geht "
	"auf und eine junge Kannibalin kommt heraus.\nSie setzt sich auf den Boden und "
	"schaelt Erbsen in einen Topf."));
	TO->move("/d/dschungel/trintrasil/dorfneu/room/roomd1", M_TPORT+ M_SILENT);
}


int topf_take(string str) {
	
	notify_fail("Was willst Du nehmen?\n");
	
	if(str=="erbsen"||str=="erbsen aus topf"||str=="topf"||str=="in topf"||
	str=="kannibalin erbsen"||str=="kannibalin erbsen weg"||str=="kannibalin topf weg") {
		
		if(present("topf", TO)) {
			
			write(BS("Als Du einfach in den Topf greifen willst kreischt "
			"die Kannibalin auf und haelt schuetzend ihre Haende ueber den "
			"Topf."));
			say(BS(""+TPN+" will der Kannibalin die Erbsen stehlen. "
			"Unglaublich!"), TP);
			tell_room(ENV(TO), BSS(""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "
			""+ARTICLE_k+" "+NOUN_k+"!","Die Kannibalin sagt: "));
			return 1;
		}
		
		else {//ist eigentlich nicht moeglich, aber atomkraftwerke konnten ja auch nie explodieren..
			write(BS("Welche Erbsen meinst Du? Die Kannibalin ist arm und "
			"mittellos, Du raubender Turbokapitalist!"));
			return 1;
		}
		return 0;
	}
}

			
void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	int i;
	object victim, *exclude, *p;
	string victim_name;
	victim = this_object();
	victim_name = "der Kannibalin";
	
	exclude =({});
	p=all_inventory(ENV(TO));
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
	
	if(durchlauf_kannibalin==0) {
		
		for(i=sizeof(p)-1;i>=0;i--) {
			
			if(interactive(p[i])) {
				
				exclude += ({ p[i] });
			}
		}
		
		tell_room(ENV(TO), BSL("\nDie Kannibalin beginnt laut zu schreien!\n\n"));
		WARMASTER->kannibalen_attack(victim, victim_name, exclude);
		durchlauf_kannibalin=1;
		TO->SetProp("sitzend", 0);
		call_out("flight", 8+random(5));
	}	
}


flight() {
	
	object topf;
	
	tell_room(ENV(TO), BSL("\nDie Kannibalin laesst ihren Topf fallen und laeuft schnell "
	"in eine Huette!\n\n"));
	topf=present("topf", TO);
	topf->move(ENV(TO), M_TPORT+ M_NOCHECK);
	TO->move("/d/dschungel/trintrasil/dorfneu/room/huette-h", M_TPORT +M_SILENT);
	TO->remove();
}


remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
        ::remove(arg);
}