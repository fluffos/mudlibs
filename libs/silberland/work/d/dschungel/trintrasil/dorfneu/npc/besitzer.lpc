
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"

int aggression = 0;
string fischdieb;

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","krieger","kannibalenkrieger","owner"}) );
   create_default_npc( 10 );   

   SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
   
   SetProp(P_SHORT, "Ein rundlicher Kannibale");
   SetProp(P_LONG,  "Der rundliche Kannibale sieht Dich missmutig an. Irgendetwas scheint ihn "
   "aufzuregen, denn er schimpft vor sich hin und fuchtelt zornig mit einem uebergrossen "
   "Kuechenmesser.");
   
   SetProp(P_NAME_ADJ, "rundlich");
   SetProp(P_NAME,      "Kannibale");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_WEIGHT, 90000);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_ALIGN,     -35);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt roechelnd.\n");
   SetProp(P_DEFAULT_INFO,"sieht Dich misstrauisch an. Er scheint Dich nicht zu verstehen.");

   
  
   clone_object("/d/dschungel/trintrasil/dorfneu/weapon/kuechenmesser")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   
   
   
   
   command("zuecke messer");
   command("trage alles");
   
   

   AD(({"messer","kuechenmesser","waffe"}),
   "Das Kuechenmesser ist zwar nicht als Waffe gedacht, dennoch sieht der Kannibale so aus "
   "als wuerde er es als solche einsetzen wenn Du ihn weiter reizt.");
       

WARMASTER->add_kannibale();

}


_query_long() {
	
	if(aggression>0 && TPN!=""+fischdieb+"" ) {
		
		return(BS("Der rundliche Kannibale sieht Dich missmutig an. Er ist wuetend "
		"weil "+fischdieb+" ihm einen Fisch gestohlen hat. Er schimpft vor sich hin und "
		"fuchtelt zornig mit einem uebergrossen Kuechenmesser."));
	}
	
	if(aggression>0 && TPN==""+fischdieb+"" ) {
		
		return(BS("Der rundliche Kannibale sieht Dich missmutig an. Er ist wuetend weil "
		"Du ihm einen Fisch gestohlen hast. Er schimpft vor sich hin und fuchtelt "
		"zornig mit einem uebergrossen Kuechenmesser."));
	}
	
	if(aggression==0) {
		
		return(BS("Der rundliche Kannibale sieht Dich missmutig an. Er scheint sich "
		"gerade sehr aufgeregt zu haben, hat sich aber wieder beruhigt. Dennoch haelt "
		"er immer noch sein grosses Kuechenmesser in der Hand. Du solltest ihn nicht "
		"unnoetig reizen."));
	}
}
 
		

int more_aggression(string dieb) {
	
	if(aggression<=2) {
		
		aggression++;
		fischdieb = dieb;
	}
	
	if(aggression>2) {
		
		aggression++;
		fischdieb = dieb;
		TO->Kill(this_player());
	}
}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
}


remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
        ::remove(arg);
}