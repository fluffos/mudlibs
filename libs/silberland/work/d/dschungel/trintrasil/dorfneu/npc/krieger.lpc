inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","krieger","kannibalenkrieger","Talkpartner","NOWIMPY"}) );
   create_default_npc( 15 );   

SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow   
   
   SetProp(P_SHORT, "Ein Kannibalenkrieger");
   SetProp(P_LONG,  "Der Krieger muster Dich argwoehnisch. Er scheint nicht vorhaben Dich "
   "gleich anzugreifen, wenn Du Dich aber verdaechtig verhaeltst wird er sicher nicht "
   "zoegern Dich zu attackieren. Er traegt den typischen kurzen Speer und Lendenschurz, "
   "wie man ihn oft bei Kannibalen sieht.");

   SetProp(P_NAME,      "Kannibale");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_WEIGHT, 80000);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_ALIGN,     -35);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt roechelnd.\n");
   SetProp(P_DEFAULT_INFO,"sieht Dich misstrauisch an. Er scheint Dich nicht zu verstehen.");

   clone_object("/d/dschungel/trintrasil/dorfneu/weapon/kannibalenspeer")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   
   
   command("zuecke speer");
   command("trage alles");
   
   
   AddDetail(("lendenschurz"),
   "Der Lendenschurz ist bei der Hitze angenehm und praktisch.");
   
   AddDetail(("speer"),
   "Der kurze Kannibalenspeer ist eine typische Waffe der Staemme.");
   
   AddDetail(({"staemme","stamm"}),
   "Tief im Dschungel wohnen auch noch andere Staemme als die Kannibalen.");
        

WARMASTER->add_kannibale();
WARMASTER->add_helfer();

}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
}


remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
	WARMASTER->remove_helfer(this_object());
        ::remove(arg);
}


help_victim(victim, victim_name) {
	
	if(ENV(victim)!=ENV(TO)) {
		
		tell_room(ENV(TO), BSL("\nDer Kannibalenrieger eilt "+victim_name+" zu "
		"Hilfe!"));
	        tell_room(ENV(victim), BSL("\nEin bemalter Krieger eilt "+victim_name+" "
	        "zu Hilfe!\n\n"));
	        TO->move(ENV(victim), M_TPORT+ M_SILENT);
	}
}