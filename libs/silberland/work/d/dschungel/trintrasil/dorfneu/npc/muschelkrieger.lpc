
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>

#include "/d/dschungel/trintrasil/myowndefine.h"
#include "/d/dschungel/trintrasil/langdef.h"

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"


int muschelkrieger_durchlauf=0;
string farbe, tatoo, hfarbe;
object khelm;


create()
{
   if (!is_clone(this_object())) return;

   ::create();


switch(random(6)) {
	
	case 0:
	hfarbe = "rot";
	break;
	
	case 1:
	hfarbe = "gelb";
	break;
	
	case 2:
	hfarbe = "blau";
	break;
	
	case 3:
	hfarbe = "gruen";
	break;
	
	case 4:
	hfarbe = "schwarz";
	break;
	
	case 5:
	hfarbe = "weiss";
	break;
	
	default:
	hfarbe = "rot";
}
switch(random(6)) {
	
	case 0:
	farbe = "rot";
	break;
	
	case 1:
	farbe = "gelb";
	break;
	
	case 2:
	farbe = "blau";
	break;
	
	case 3:
	farbe = "gruen";
	break;
	
	case 4:
	farbe = "schwarz";
	break;
	
	case 5:
	farbe = "weiss";
	break;
	
	default:
	farbe = "rot";
}


switch(random(7)) {
	
	case 0:
	tatoo = "Panther";
	break;
	
	case 1:
	tatoo = "Tiger";
	break;
	
	case 2:
	tatoo = "Elefant";
	break;
	
	case 3:
	tatoo = "Rabe";
	break;
	
	case 4:
	tatoo = "Archaeopterix";
	break;
	
	case 5:
	tatoo = "Leopard";
	break;
	
	case 6:
	tatoo = "Sandwurm";
	break;
	
	default:
	tatoo = "Leopard";
}

	
   AddId( ({"kannibale","krieger","kannibalenkrieger","bemalter krieger","Axtexperte","NOWIMPY"}) );
   create_default_npc( 28 );   

SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
   
   SetProp(P_SHORT, "Ein bemalter Krieger");
   SetProp(P_LONG,  BSL("Der Krieger scheint bei den Kannibalen sehr geachtet zu sein. Er hat "
   "seine vielen Narben mit "+farbe+"er Farbe nachgezogen. Auf seine Brust ist ein "
   ""+farbe+"er "+tatoo+" taetowiert. Er traegt einen "+hfarbe+" bemalten Helm eines "
   "Wachsoldaten aus dem Vorposten, den er wahrscheinlich getoetet hat.\nDer Krieger beobachtet "
   "Dich mit ruhiger, selbstsicherer Miene."));

   SetProp(P_NAME_ADJ, "bemalt");
   SetProp(P_MAX_HP, 1500);//erhoeht damit er laenger überlebt und Kannibalen rufen kann
   SetProp(P_NAME,      "Muschelkrieger");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_WEIGHT, 80000);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_ALIGN,     -35);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt roechelnd.\n");
   SetProp(P_DEFAULT_INFO,"sieht Dich gelassen an. Er scheint Dich nicht zu verstehen.");
   
   SetProp("muschelkrieger", 1);

   
   clone_object("/d/dschungel/trintrasil/dorfneu/obj/muschel")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/weapon/steinaxt")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lederhose")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/leoumh")->move(this_object());
   khelm = clone_object("/d/dschungel/trintrasil/dorfneu/armour/kdschungelhelm")->move(TO);
   call_other(present("helm", TO), "farbesetzen", hfarbe);
   
   
   
   command("zuecke axt");
   command("trage alles");
   
   
   
   AddDetail( ("narben"),
   "Die Narben hat der Krieger anscheinend aus vielen Kaempfen. Um sie zu betonen und um "
   "sich ein unheimlicheres Aussehen zu geben hat er sie mit roter Farbe betont.");

   AddDetail(({"bild",""+tatoo+""}),
   "Der "+farbe+"e "+tatoo+" ist mehr ein symbolisches als ein naturgetreues Bild. Es wirkt "
   "aber beeindruckend.");
      
   AddDetail(("farbe"),
   "Die Farbe ist hellrot und laesst die Narben gut sichtbar leuchten.");
   
   AddDetail(({"ueberfall","soldat","gardist","stadtgardist","posten","vorposten"}),
   "Anscheinend hat der Kannibale schon oefters bei einem Ueberfall auf den Vorposten "
   "teilgenommen und dort einem getoetetem Soldaten den Helm abgenommen.");
   
   AddDetail(({"beunruhigung","miene"}),
   "Die ruhige, ueberlegen Miene des Kriegers zeigt keine Beunruhigung.");

   call_out("talkmaster", 5);
   
   
WARMASTER->add_kannibale();
WARMASTER->add_helfer();
       
}

//die sprechfaehigkeit soll einmal in ein invisible object umgewandelt werden, dass den npc
//der es besitzt automatisch sprechfaehig mit gewissen partnern macht, aber die idee wurde nach
//dieser verwirklichung hier geboren und ist im moment zweitrangig.. 

talkmaster() {
	
	if(  TO->InFight()!=0 || !present("Talkpartner", ENV(TO)) ) {
	     	
	     	call_out("talkmaster", 30+random(10));
		return 0;
	}
	
	else {
		switch(random(4)) {
			
			case 0:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer bemalte Krieger sagt: "));
			call_out("responsemaster2", 1);
			break;
			
			case 1:
			tell_room(ENV(TO), BSS(
			""+QUESTION_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+"?",
			"\nDer bemalte Krieger fragt: "));
			call_out("responsemaster1", 1);
			break;
			
			case 2:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer bemalte Krieger fluestert: "));
			call_out("responsemaster2", 1);
			break;
			
			case 3:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer bemalte Krieger knurrt: "));
			call_out("responsemaster2", 1);
			break;
			
			default:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer bemalte Krieger sagt: "));
			call_out("responsemaster2", 1);
		}
		call_out("talkmaster", 30+random(10)); 
	}
}


responsemaster1() {
	
	if( present("jaguarkrieger", ENV(TO)) ) {
		
		tell_room(ENV(TO), BSS(
		""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
		"\nDer Jaguarkrieger antwortet knurrend: "));
	}
	
	if( !present("jaguarkrieger", ENV(TO)) && present("Talkpartner", ENV(TO)) ) {
		
		tell_room(ENV(TO), BSS(
		""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
		"\nDer Kannibale antwortet: "));
	}
	
	else {
		return 0;
	}
}


responsemaster2() {
	
	if( present("jaguarkrieger", ENV(TO)) ) {
		
		switch(random(6)) {
			
			case 0:
			tell_room(ENV(TO), BSL("\nDer Jaguarkrieger nickt schweigend mit dem "
			"Kopf.\n"));
			break;
			
			case 1:
			tell_room(ENV(TO), "\nDer Jaguarkrieger lacht heiser\n");
			break;
			
			case 2:
			tell_room(ENV(TO), "\nDer Jaguarkrieger knurrt zustimmend\n");
			break;
			
			case 3:
			tell_room(ENV(TO), "\nDer Jaguarkrieger schuettelt den Kopf\n");
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"Der Jaguarkrieger murrt: "));
			break;
			
			case 4:
			tell_room(ENV(TO), BSL("\nDer Jaguarkrieger klopft dem bemalten "
			"Krieger lachend auf die Schulter."));
			break;
			
			case 5:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer Jaguarkrieger erwidert: "));
			break;
			
			default:
			tell_room(ENV(TO), "\nDer Jaguarkrieger lacht heiser\n");
		}
	}
	
	if( !present("jaguarkrieger", ENV(TO)) && present("Talkpartner", ENV(TO)) ) {

		switch(random(6)) {
			
			case 0:
			tell_room(ENV(TO), BSL("\nDer Kannibale lacht laut."));
			break;
			
			case 1:
			tell_room(ENV(TO), BSL("\nDer Kannibale nickt zustimmend mit dem "
			"Kopf."));
			break;
			
			case 2:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer Kannibale erwidert: "));
			break;
			
			case 3:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer Kannibale erwidert: "));
			break;
			
			case 4:
			tell_room(ENV(TO), BSL("\nDer Kannibale schuettelt den Kopf.")); 
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"Der Kannibale sagt: "));
			break;
			
			case 5:
			tell_room(ENV(TO), BSL("\nDer Kannibale klopft dem bemalten Krieger "
			"lachend auf den Arm."));
			break;
			
			default:
			tell_room(ENV(TO), BSS(
			""+NOUN_k+" "+VERB_k+" "+OTHER_k+" "+ARTICLE_k+" "+NOUN_k+".",
			"\nDer Kannibale erwidert: "));
		}
	}
	
	else {
		return 0;
	}
}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
	
	if(muschelkrieger_durchlauf==0) {
		
		call_out("verstaerkung", 10+random(5));
		muschelkrieger_durchlauf=1;
	}
}


verstaerkung() {
	
	int i;
	object waechter, *exclude, *p;
	waechter=TO;
	exclude =({});
	p=all_inventory(ENV(TO));
	
	if(TO->InFight()==0) {
		
		muschelkrieger_durchlauf=0;
	}
	
	if(TO->InFight()) {
		
		for(i=sizeof(p)-1;i>=0;i--) {
			
			if(interactive(p[i])) {
				
				exclude += ({ p[i] });
			}
		}
		
		WARMASTER->schicke_verstaerkung(waechter, exclude);
		muschelkrieger_durchlauf=0;
		tell_room(ENV(TO), BSL("\n!!BOOOOOOOEEEEEEEEB!!\nDer bemalte Krieger blast "
		"nach Verstaerkung!\n\n"));
	}
}

		
remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
	WARMASTER->remove_helfer(this_object());
        ::remove(arg);
}


help_victim(victim, victim_name) {
	
	if(ENV(victim)!=ENV(TO)) {
		
		tell_room(ENV(TO), BSL("\nDer bemalte Krieger eilt "+victim_name+" zu "
		"Hilfe!"));
	        tell_room(ENV(victim), BSL("\nEin bemalter Krieger eilt "+victim_name+" "
	        "zu Hilfe!\n\n"));
	        TO->move(ENV(victim), M_TPORT+ M_SILENT);
	}
}
