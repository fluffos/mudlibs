
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"toelle","hund","koeter","vieh","kkoeter"}) );
   create_default_npc( 38 );   

SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow

   /*** NPC properties ***/
   
   SetProp(P_SHORT, "Ein Hund");
   SetProp(P_LONG,  "Der Hund hat ein ungepflegtes, raeudiges, kurzes Fell. Er ist "
   "anscheinend ein bunter Mischling. Aber er ist von ungewoehnlich kraeftiger "
   "Statur und sehr gross. Seine Zaehne sehen nicht unbedingt wie freundliche "
   "Friedenstauben aus.");


   SetProp("doesend", 1);
   
   
   SetProp(P_NAME,      "Hund");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      70+random(10));
   SetProp(P_WEIGHT, 40000);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HANDS,     ({" mit seinen Reisszaehnen", 60}));
   SetProp(P_ALIGN,     0);
   SetProp(P_RACE,      "Hund");
   SetProp(P_DIE_MSG,   " stirbt jaulend.\n");
   SetProp(P_DEFAULT_INFO,"!!KNURRR!!");

   /*** NPC details ***/
   AddDetail( ("fell"),
   "Das graue Fell des Hundes ist borstig und kurz.");
   
   AD(({"rasse","hunderasse","mischling"}),
   "Die Hunderasse ist dem Besitzer sicher vollkommen egal.");
   
   AD(("besitzer"),
   "Der Besitzer ist sicher ein Kannibale, zu dem Du besser freundlich sein solltest.");
   
   AD(("statur"),
   "Der Hund ist gross und kraeftig gebaut.");
   
   AD(({"zaehne","zahn","gebiss"}),
   "Die Zaehne des Hundes sind seiner Groesse entsprechend lang und koennen sicher "
   "grosse Wunden reissen.");
   
   AD(("wunden"),
   "Zum reissen von Wunden sind diese Zaehne anscheinend da.");
   
   AD(({"taube","friedentaube","tauben","friedenstauben"}),
   "Die Zaehne sehen nicht gerade freundlich und friedlich aus.");
    
   
   
   SetAttackChats(40, ({
	"\n KNURR, RAFF, RAFF!\n\n",
	"\n Der Hund versenkt seine Zaehne in Dein Fleisch!\n\n",
	"\n Der Hund versucht Dich an der Kehle zu packen!\n\n",
	"\n KLAEFF KLAEFF!\n\n",
	"\n Der Hund reisst Dich beinahe nieder!\n\n",
	"\n Der Koeter hackt Dir seine Reisszaehne ins Bein!\n\n",
	"\n KNURR KNURR KLAEFF!\n\n",
	"\n Der Hund rast vor Zorn!\n\n",
	"\n Die Toelle will Dich einfach nur noch tot sehen!\n\n",
	"\n Der Koeter springt knurrend an Dir hoch!\n\n",
	"\n WAU WAU KLAEFFFF!\n\n",
	"\n Der Hund fletscht rasend seine Zaehne!\n\n"}) );

}