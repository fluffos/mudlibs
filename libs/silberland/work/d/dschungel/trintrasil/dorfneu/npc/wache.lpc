
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>

#define WARMASTER "/d/dschungel/trintrasil/dorfneu/warmaster"


create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","krieger","kannibalenkrieger","wache","Speerkaempfer","NOWIMPY"}) );
   create_default_npc( 18 );   

SetProp("flussnpc", 1);//somit ist er als flussnpc ausgewiesen und bewegt sich ohne shadow
   
   SetProp(P_SHORT, "Ein Kannibalenkrieger");
   SetProp(P_LONG,  "Der Krieger bewacht das Tor zum inneren Dorf. Seinen Bemalungen nach "
   "scheint er zur Garde der Haeuptlings zu gehoeren. Du solltest es Dir gut ueberlegen ob "
   "Du Dich mit ihm anlegen willst.");

   SetProp(P_NAME,      "Kannibale");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HANDS,     ({" mit seinem Speer", 60}));
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " stirbt roechelnd.\n");
   SetProp(P_DEFAULT_INFO,"sieht Dich misstrauisch an. Er scheint Dich nicht zu verstehen.");

   

   clone_object("/d/dschungel/trintrasil/dorfneu/weapon/kannibalenspeer")->move(this_object());
   clone_object("/d/dschungel/trintrasil/dorfneu/armour/lendenschurz")->move(this_object());
   
   
   command("zuecke speer");
   command("trage alles");
   
   
   AddDetail(("bemalung"),
   "Der Krieger ist mit einem bruellenden, weissen Panther bemalt");
   
   AddDetail(({"wache","garde"}),
   "Wenn Du ins innere Dorf vordringen willst wird Dir nichts andere uebrig bleiben als "
   "gegen die Wache zu kaempfen.");
   
   AddDetail(("panther"),
   "Der bruellende Panther sieht so aus als wuerde er Dich angreifen wollen.");
    

WARMASTER->add_kannibale();

}


void Defend(int dam, mixed dam_type, mixed spell, object enemy) {
	
	::Defend(dam, dam_type, spell, enemy);
	WARMASTER->feind_eintragen(enemy);
}


remove(int arg) {
	
	WARMASTER->remove_kannibale(this_object());
        ::remove(arg);
}