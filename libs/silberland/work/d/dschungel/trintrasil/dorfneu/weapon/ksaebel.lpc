inherit "std/weapon";
#include <properties.h>     
#include <combat.h>       
#include <language.h>      
#include <new_skills.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

string farbe;

create()
{

if (!is_clone(this_object()))
return;
::create();

switch(random(4)) {
	
	case 0:
	farbe = "rot";
	break;
	
	case 1:
	farbe = "blau";
	break;
	
	case 2:
	farbe = "gruen";
	break;
	
	case 3:
	farbe = "gelb";
	break;
	
	default:
	farbe = "rot";
}


SetProp( P_NAME_ADJ, "bemalt");
SetProp (P_NAME, "Infanteriesaebel");
SetProp (P_GENDER, MALE);
SetProp (P_VALUE, 2100+random(105));
SetProp (P_WEIGHT, 950);
SetProp (P_WEAPON_TYPE, WT_SWORD);
SP(P_LONG, BSL(
"Dieser Saebel ist wie bei Saebeln ueblich leicht gebogen und einseitig "
"geschliffen. Er ist als typischer Infanteriesaebel zwar kuerzer, aber sehr "
"scharf und besonders leicht zu fuehren.\nEr ist "+farbe+" bemalt. Ein Kannibalen hat ihn "
"einem Offizier im Vorposten abgenommen."));


AddId(({"saebel","infanteriesaebel"}));

SP(P_SHORT, "Ein bemalter Infanteriesaebel");

SetProp (P_DAM_TYPE, ({ DT_SLASH}));
SetProp (P_NOBUY, 0);
SetProp (P_WC, 150);
SetProp (P_WC_BONUS, (["mombassa": 100]) );
SetProp (P_WC_FIX, 50);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_STEEL:100]));
SetProp (P_WIELD_RESTRICTIONS, ([A_DEX: 1]));

AddCmd(("test"), "test_func");
}

test_func() {
	
	write(BS(""+QueryProp(P_WEAPON_TYPE)+""));
}
