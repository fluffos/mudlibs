inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()))  return;
  ::create();

  SetProp(P_SHORT, "Eine Machete");
  SetProp(P_LONG,  
    "Diese Machete, auch Haumesser genannt, ist ideal dazu geeignet, um sich "
    "im Dschungel den Weg freizuschlagen. Sie besitzt ein breite, "
    "einschneidige Klinge und die Spitze ist abgerundet. Es handelt sich also "
    "wirklich eher um ein Werkzeug als um eine Waffe." );
  SetProp(P_NAME, "Machete");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"machete", "haumesser"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":300]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1333);
  SetProp(P_SIZE, 50);
  SetProp(P_QUALITY_DECAY, 75);
}

