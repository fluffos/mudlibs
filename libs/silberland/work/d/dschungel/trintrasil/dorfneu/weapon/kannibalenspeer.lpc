inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Angriffsspeer");
  SetProp(P_LONG,
    "Der Kannibalenspeer ist eine kurze, gefaehrliche Waffe und ist sehr handlich und "
    "leicht. Die gehaertete Knochenspitze besitzt eine gezahnten Ruecken, der wie "
    "mit Widerhaken besetzt schlimme Wunden reissen kann.");
    
  SetProp(P_NAME, "Kannibalenspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"waffe","speer", "kannibalenspeer"}) );

  AD(("ruecken"),
  "Der Speerruecken ist lange und gezahnt.");
  
  AD(({"knochenspitze","spitze"}),
  "Die Spitze des Speeres besteht aus aufwendig gehaertetem und poliertem Knochen.");
  
  AD(({"wunden","spitzen","haken","widerhaken"}),
  "Die Spitzen des Rueckens bleiben im Fleisch stecken und verursachen beim Heraus"
  "reissen schlimme Wunden.");
  
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 35);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":170, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OAK:75, MAT_STEEL:15, MAT_IRON:10]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 800);
  SetProp(P_SIZE, 135);
  SetProp(P_QUALITY_DECAY, 140 );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:7]) );
}

