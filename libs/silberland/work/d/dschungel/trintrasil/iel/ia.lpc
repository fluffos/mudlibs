
inherit "std/thing";

#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"


init() {
	
	::init();
	
	if(interactive(ENV(TO)) && ENV(TO)->QueryProp(P_NAME)=="Ielahiah") {
		
		tell_object(ENV(TO), BS("Ia reibt leise seinen Kopf an Deinem Arm als Du ihn "
		"nimmst."));
		tell_room(ENV(TO), BS("Ia reibt freudig seinen Kopf an Ielahiahs Arm als "
		"sie ihn nimmt."));
		return 1;
	}
	
	if(interactive(ENV(TO)) && ENV(TO)->QueryProp(P_NAME)!="Ielahiah") {
		
		tell_object(ENV(TO), BS("Ia sieht Dich traurig an."));
		return 1;
	}
	
	if(ENV(TO)->interactive()!=1) {
		
		tell_room(ENV(TO), BSS("Iaaaaaaaaaaaaaaa.","Ia macht traurig: "));
		return 1;
	}
}


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   
   AddId(({"ia","esel","stofftier","stofftieresel"}));
   SetProp(P_NAME, "Ia");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ia der Stofftieresel");
   SetProp(P_NAME_ADJ, "traurig");
   SetProp(P_LONG, BS(
   "Ia der graue Stofftieresel hat ein etwas zerzaustes Fell und sieht irgendwie traurig und "
   "zerdrueckt aus. Er hat grosse, treuherzige Augen und lange, haengende Ohren. Vielleicht "
   "geht es Ia besser wenn Du ihn an Dich drueckst."));
   SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:50, MAT_TICTOC_WOOD:40, MAT_BONE:10]) );
   SetProp(P_VALUE, 269);
   SetProp(P_WEIGHT,10);
   SetProp(P_NOSELL, BS("Ia blickt Dich so traurig an dass Du es einfach nicht uebers "
   "Herz bringst Ihn zu verkaufen."));
   SetProp(P_AUTOLOADOBJ, 1);
   
   AD(("fell"),
   "Du kraulst das warme, kurze Fell von Ia und er schmiegt seinen Kopf dankbar an Dich.");
   
   AD(("kopf"),
   "Ia laesst seinen Kopf immer haengen, er scheint wohl etwas traurig zu sein.");
   
   AD(({"augen"}),
   "Ia hat grosse feuchte Augen die Dich traurig und warmherzig anblicken.");
   
   AD(({"ohren","ohr"}),
   "Die Ohren sind lang und haengen schlapp.");
   
   AddCmd(({"druecke","drueck","kuschle","kuschel"}), "ia_func");

  
}

ia_func(string str) {	
	
	if(str=="ia"||str=="ia an dich"||str=="esel"||str=="esel an dich"||str=="stofftier"||
	str=="stofftier an dich"||str=="stofftieresel"||str=="stofftieresel an dich") {
		
		write(BS("Du nimmst Ia in den Arm und drueckst ihn warm an Dich."));
		say(BS(""+TPN+" nimmt Ia den Stofftieresel in den Arm und drueckt ihn sanft."));
		tell_room(ENV(TP), BSS("Iaaaaaaaaaaaaaaaaa.","Ia der Esel macht leise:"));
		write(BS("Ia blickt Dich dankbar an. Er fuehlt sich jetzt sicher besser."));
		return 1;
	}
	
	else {
		return 0;
	}
}
