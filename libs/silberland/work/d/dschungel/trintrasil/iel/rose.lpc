
inherit "std/thing";

#include <language.h>
#include <properties.h>
#include "/d/dschungel/trintrasil/myowndefine.h"

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"rose"}));
   SetProp(P_NAME, "Rose");
   SetProp( P_GENDER , FEMALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Eine Rose");
   SetProp(P_NAME_ADJ, "rot");
   SetProp(P_LONG, BS(
   "Die Rose hat einen langen, saftigen, dunkelgruenen Stil mit zarten Blaettern. Ihre "
   "duftende Bluete leuchtet feuerrot."));
   SetProp(P_MATERIAL,MAT_PLANT);
   SetProp(P_VALUE,300+random(700));
   SetProp(P_WEIGHT,10);
   
   SetProp(P_AUTOLOADOBJ, 1);
  
   AD(({"blatt","blaetter"}),
   "Die Blaetter sind zaeh und dunkel. Ihr Rand ist leicht gezackt.");
   
   AD(({"bluete","bluetenblaetter"}),
   "Die Bluetenblaetter leuchten in einem hellen Rot. Die Rose wirkt auf Dich sehr "
   "lebendig und irgendwie froehlich.");
   
   AD(("rot"),
   "Das Rot ist hell und lebendig.");
   
   AD(("stil"),
   "Der Stil ist lang und hart. Verborgen zwischen den Blaettern siehst Du spitze Dornen.");
   
   AD(("dornen"),
   "Die Dornen sind hart und sehr spitz, aber sie stechen Dich aus irgendeinem "
   "Grund nicht.");
   
   AD(({"hand","grund"}),
   "Die Rose liegt warm und sanft in Deiner Hand. Sie scheint perfekt zu Dir zu passen.");
      
   AddCmd(({"rieche","riech","schnupper","schnuppere"}), "rose_func");
}

int rose_func(string str) {
	
	if(str=="an rose"||str=="rose"||str=="bluete"||str=="an bluete"||str=="rosenbluete"||
	str=="an rosenbluete") {
		
		tell_object(TP, BS("Die Rose duftet herrlich stark, "
		"aber trotzdem leicht und nicht aufdringlich."));
		return 1;
	}
	
	else {
		return 0;
	}
}