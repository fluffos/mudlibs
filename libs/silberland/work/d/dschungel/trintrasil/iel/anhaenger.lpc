inherit "/std/armour";
 
#include <properties.h>
#include <combat.h>

#include "/d/dschungel/trintrasil/myowndefine.h"

int bild = 1;

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Luchs aus Sonnenstein");
  SetProp(P_LONG, 
    "Der Anhaenger ist ein kleiner Luchs aus Sonnenstein an einem schwarzen Lederband. Der Luchs "
    "ist sehr fein gearbeitet, Du erkennst viele Details. Seine Augen sind aus gruenen "
    "Steinsplittern gefertigt. Der Luchs ist circa so gross wie Dein Handteller und fuehlt sich "
    "seltsam warm an.");
  
  SetProp(P_NAME, "Luchsanhaenger");
  SetProp(P_GENDER, MALE);
  AddId( ({"anhaenger","luchsanhaenger","kette","halskette","luchskette","luchs"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_MISC);

  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL: 80, MAT_LEATHER: 20]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 45000000);
  
  SetProp(P_NOSELL, "Dieser Anhaenger ist unverkaeuflich. Er ist allein nur fuer Dich "
  "bestimmt.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INFO, "Dieser Luchsanhaenger ist nur fuer Ielahiah bestimmt.\n");
  SetProp(P_MAGIC, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_TEXT, ({ BSL("Du haengst Dir den Anhaenger um den Hals.\nDu spuerst kurz "
  "das warme Fell eines Luchses um Deine Seite streifen."), " haengt sich einen Luchsanhaenger um "
  "den Hals.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ BSL("Du nimmst den Luchsanhaenger ab.\nEine warme Schnauze stubst "
  "Dich schnurrend hinter dem Ohr."), " nimmt den Luchsanhaenger ab.\n" }) );
  
  AddDetail(({"luchs"}),
  "Der Luchs ist sehr fein gefertigt. Er wirkt auf Dich sehr lebendig. Du erkennst sein etwas "
  "raeudiges Fell, seine laechelnden Zaehne, und besonders seine gruenen Augen die Dich "
  "liebevoll betrachten.");
  
  AddDetail(({"band","lederband"}),
  "Das Lederband ist recht duenn und fein, aber es wirkt trotzdem unzerreisbar. Damit "
  "haengt man sich den Anhaenger um den Hals.");
  
  AddDetail(("hals"),
  "Der Anhaenger scheint nur um Deinen Hals zu passen. Er ist ideal fuer Dich gefertigt.");
  
  AddDetail(({"stein","sonnenstein"}),
  "Der gelbe Sonnenstein waermt Dich und erfuellt Dich mit einer angenehmen Ruhe und Freude.");
 
  AddDetail(({"freude","ruhe"}),
  "Der Luchs scheint sich zaertlich schnurrend an Deinen Hals zu schmiegen.");
  
  AddDetail(("fell"),
  "Das Fell des Luchses wirkt etwas raeudig. Du koenntest mit den Fingern darueber streichen.");
  
  AddDetail(("finger"),
  "Obwohl das Fell des Luchs etwas raeudig aussieht, wirkt es doch weich und angenehm "
  "fuer Dich. Du koenntest einmal mit den Fingern darueber streichen.");
  
  AddDetail(({"zahn","zaehne"}),
  "Die Zaehne sind scharf und fest, aber der Luchs laechelt Dich freundlich an.");
  
  AddDetail(({"auge","steinsplitter","splitter","steine","augen"}),
  "Der Luchs wiegt sehnsuechtig den Kopf und seine Augen leuchten Dir sanft entgegen. Du meinst "
  "Bilder in ihnen erkennen zu koennen.");
  
  AddDetail(({"bild","bilder"}),
  "Die Augen des Luchses zeigen so viele Bilder, einige kannst Du erkennen, wenn Du ihm "
  "tief in die Augen schaust.");

  AddDetail(({"detail","details"}),
  "Der Luchs hat einen schlanken und wendigen Koerperbau, er scheint recht weit gelaufen "
  "zu sein und sein Fell wirkt etwas rauh. Aber seine gruenen Augen blicken Dich sehr sanft und "
  "liebevoll an. An seinen neugierig aufgerichteten Ohren erkennst Du die fuer einen "
  "Luchs typischen Haarbueschel. Er scheint eine zaertlichte, weiche Schnauze zu haben und "
  "die scharfen, schlanken Zaehne blitzen durch ein verspieltes Laecheln.");
  
  AddDetail(({"laeufer","bau","koerperbau"}),
  "Der Koerperbau des Luchs ist schlank und sehnig. Er scheint ein ausdauernder Laeufer "
  "zu sein.");
  
  AddDetail(({"ohren","bueschel","haarbueschel"}),
  "Die Ohren sind aufmerksam aufgerichtet und scheinen neugierig zu lauschen.");
  
  AddDetail(("laecheln"),
  "Dieses warme, vertraeumte Laecheln scheint Dir zu gelten.");
  
  AddDetail(("schnauze"),
  "Du haeltst den Anhaenger in der Hand. Du merkst wie sich die warme Schnauze zaertlich "
  "in Deinen Handteller schmiegt.");
  
  AddDetail(({"handteller","teller","hand"}),
  "Der Anhaenger liegt angenehm und warm in Deiner Hand, als waere er ideal fuer Dich "
  "geschaffen.");
  
  AddCmd(({"schau","schaue"}), "bilder");
  AddCmd(({"streichle","streiche"}), "fell");
}


fell(string str) {
	
	notify_fail("Ueber was willst Du streichen?\n");
	
	if(str=="fell"||str=="ueber fell"||str=="luchs"||str=="luchsfell"||str=="mit finger "
	"ueber fell"||str=="mit finger fell"||str=="mit finger luchs"||str=="mit finger "
	"luchsfell") {
		
		switch(random(9)) {
			
			case 0:
			tell_object(TP, BSL("\nDu nimmst den Luchs in Deine Hand und streichst "
			"mit einem Finger zart ueber sein Fell. Der Luchs schmiegt sich "
			"vertraeumt in Deinen Handteller und schnurrt zufrieden."));
			break;
			
			case 1:
			tell_object(TP, BSL("\nDu streichst mit einem Finger zaertlich ueber das "
			"Fell. Du hoerst ein sanftes Schnurren und hast das Gefuehl ein "
			"Luchs wuerde um Deine Beine streichen."));
			break;
			
			case 2:
			tell_object(TP, BSL("\nDu streichelst mit einem Finger ueber das Fell. "
			"Du hoerst ein sanftes Schnurren und spuerst die weiche Schnauze eines "
			"Luchses an Deiner Wange."));
			break;
			
			case 3:
			tell_object(TP, BSL("\nDu umschliesst den Luchs sanft mit Deinen "
			"Fingern. Du spuerst wie Dich jemand liebevoll und waermend an "
			"sich drueckt."));
			break;
			
			case 4:
			tell_object(TP, BSL("\nDu streichelst ueber den Luchs, und spuerst eine "
			"warme Schnauze die sanft mit Deinem Ohr spielt."));
			break;
			
			case 5:
			tell_object(TP, BSL("\nDu streichelst mit den Fingern ueber das Fell. "
			"Du spuerst den Kopf eines Luchses, der sich schnurrend an Deinen "
			"Hals schmiegt."));
			break;
			
			case 6:
			tell_object(TP, BSL("\nDu streichst mit Deinen Fingern ueber den Luchs "
			"und spuerst wie sich eine warme Schnauze zaertlich an Deiner Wange "
			"reibt."));
			break;
			
			case 7:
			tell_object(TP, BSL("\nDu streichelst ueber den Luchs, und spuerst wie "
			"sich ein Luchs schnurrend an Deinen Ruecken schmiegt."));
			break;
			
			case 8:
			tell_object(TP, BSL("\nDu streichst mit Deinem Fingern ueber das Fell. "
			"Du spuerst das warme Fell eines Luchses, das liebevoll ueber "
			"Deine Haut streicht."));
			break;
			
			default:
			tell_object(TP, BSL("\nDu streichst mit Deinem Fingern ueber das Fell. "
			"Du spuerst das warme Fell eines Luchses, das liebevoll ueber "
			"Deine Haut streicht."));
		}
		return 1;
	}
}


bilder(string str) {
	
	notify_fail("Schau dem Luchs in die Augen!\n");
	
	if(str=="luchs in augen"||str=="luchs tief in augen"||str=="luchs in auge"||
	str=="luchs in augen"||str=="luchs tief in auge") {
		
		tell_object(TP, BSL("\nDu schaust in die gruenen Augen des Luchses."));
		
		if(bild==1) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs Fell an "
			"Fell durch hohes gelbes Steppengras streichen."));
			bild++;
			return 1;
		}
		
		if(bild==2) {
			
			tell_object(TP, BSL("Du siehst einen Luchs wie er liebevoll die Ohren "
			"einer schnurrenden Woelfin leckt."));
			bild++;
			return 1;
		}
		
		if(bild==3) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs "
			"nebeneinander durch einen dichten verfilzten Wald streifen."));
			bild++;
			return 1;
		}
		
		if(bild==4) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin und einen Luchs zaertlich und "
			"verspielt auf einer sonnigen Lichtung balgen."));
			bild++;
			return 1;
		}
		
		if(bild==5) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs eng "
			"aneinander gekuschelt auf einem kalten Berggipfel sitzen, und "
			"den stillen Mond beobachten."));
			bild++;
			return 1;
		}
		
		if(bild==6) {
			
			tell_object(TP, BSL("Du siehst einen Luchs der sich lachend auf die "
			"Hinterpfoten stellt und einer Woelfin liebevoll an den Hals "
			"springt."));
			bild++;
			return 1;
		}
		
		if(bild==7) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs faul und "
			"zufrieden miteinander im Gras liegen und Emos beim grasen beobachten."));
			bild++;
			return 1;
		}
		
		if(bild==8) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin wie sie zaertlich an den "
			"Ohren eines Luchs knabbert."));
			bild++;
			return 1;
		}
		
		if(bild==9) {
			
			tell_object(TP, BSL("Du siehst einen Luchs wie er sanft sein Gesicht "
			"am Gesicht eines Woelfchens reibt."));
			bild++;
			return 1;
		}
		
		if(bild==10) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin und einen Luchs eng "
			"aneinander geschmiegt auf einem maechtigen Berghang stehen und den "
			"majestaetischen Flug eines Greifen beobachten."));
			bild++;
			return 1;
		}
		
		if(bild==11) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs lachend "
			"und knurrend durch hohes Steppengras jagen."));
			bild++;
			return 1;
		}
		
		if(bild==12) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs verspielt "
			"ueber einen dicken, umgestuerzten Baumstamm springen."));
			bild++;
			return 1;
		}
		
		if(bild==13) {
			
			tell_object(TP, BSL("Du siehst einen Luchs, wie er froehlich einer "
			"lachend ausweichenden Woelfin in den Nacken springt."));
			bild++;
			return 1;
		}
		
		if(bild==14) {
			
			tell_object(TP, BSL("Du siehst wie sich ein Woelfchen und ein Luchs "
			"geniesserisch miteinander in der Sonne rekeln."));
			bild++;
			return 1;
		}
		
		if(bild==15) {
			
			tell_object(TP, BSL("Du siehst wie eine Woelfin und ein Luchs bei Regen "
			"im Unterholz kauern und sich gegenseitig waermen."));
			bild++;
			return 1;
		}
		
		if(bild==16) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs wie "
			"sie bei Sturm einen kalten schroffen Berghang erklimmen. Beide wirken "
			"erschoepft und muede."));
			bild++;
			return 1;
		}
		
		if(bild==17) {
			
			tell_object(TP, BSL("Du siehst eine verletzt liegende Woelfin, "
			"und einen Luchs, der ihr liebevoll die Schnauze leckt und etwas "
			"zu essen bringt."));
			bild++;
			return 1;
		}
		
		if(bild==18) {
			
			tell_object(TP, BSL("Du siehst einen erschoepften Luchs unschluessig "
			"auf einem Stein kauern, und eine Woelfin, die Ihn zaertlich mit der "
			"Schnauze in die Seite stubst und unermuedlich zum Aufstehen bewegt."));
			bild++;
			return 1;
		}
		
		if(bild==19) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs zusammen "
			"ueber schmale kantige Grade wandern."));
			bild++;
			return 1;
		}
		
		if(bild==20) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs verliebt "
			"in einer kargen Felsniesche kauern."));
			bild++;
			return 1;
		}
		
		if(bild==21) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin und einen Luchs mit "
			"gefletschten Zaehnen und gluehenden Augen Seite an Seite gegen "
			"reudige, bissige Hyaenen kaempfen."));
			bild++;
			return 1;
		}
		
		if(bild==22) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs, wie "
			"sie sich im Schatten eines Marillenbaumes ausrasten, und die "
			"Wangen aneinander schmiegen."));
			bild++;
			return 1;
		}
		
		if(bild==23) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs vertraeumt "
			"an einem Sandstrand stehen, und Moewen beim Fliegen beobachten."));
			bild++;
			return 1;
		}
		
		if(bild==24) {
			
			tell_object(TP, BSL("Du siehst die Abdruecke einer Woelfin dicht neben "
			"den Abdruecken eines Luchses im Sand, und in weiter Ferne beide "
			"unbeirrbar neben einander ueber den Strand schlendern."));
			bild++;
			return 1;
		}
		
		if(bild==25) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin und einen Luchs aneinander "
			"geschmiegt in einem Strandkorb liegen, und sich gegenseitig "
			"waermend die Sterne zaehlen."));
			bild++;
			return 1;
		}
		
		if(bild==26) {
			
			tell_object(TP, BSL("Du siehst ein Woelfchen und einen Luchs "
			"verspielt und lachend ueber Deiche tollen."));
			bild++;
			return 1;
		}
		
		if(bild==27) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin auf einer moosbedeckten "
			"Lichtung liegen, und einen Luchs, der Ihr liebevoll das Gesicht leckt "
			"und zaertlich hinter den Ohren beschnuppert."));
			bild++;
			return 1;
		}
		
		if(bild==28) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin und einen Luchs, sehr weit "
			"voneinander entfernt an einsamen Plaetzchen kauern und traurig "
			"voneinander traeumen."));
			bild++;
			return 1;
		}
		
		if(bild==29) {
			
			tell_object(TP, BSL("Du siehst ein lachendes Woelfchen und einen "
			"springenden Luchs, wie sie sich nach langer Zeit freudig "
			"ungestuem begruessend um den Hals fallen."));
			bild++;
			return 1;
		}
		
		if(bild==30) {
			
			tell_object(TP, BSL("Du siehst eine Woelfin neben einem Luchs an einem "
			"stillen Waldteich stehen, und erstaunt ihr Spiegelbild betrachten. "
			"Sie wirken so verschieden, die eine Wolf, der andere Luchs, aber sie "
			"stehen weiches Fell an raeudiges Fell liebevoll nebeneinander, und "
			"betrachten ihre unabsehbar lange, bunte Geschichte."));
			bild=1;
			return 1;
		}
		return 1;
	}
	
	else {
		return 0;
	}
	
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
	
	tell_object(player, BSL("\nDu hoerst das tieftraurige Greinen eines Luchses.\n"));
	call_out("dead1", 2);
}


dead1(object player) {
	
	tell_object(ENV(this_object()), BSL("\nEin Luchs tapst knurrend hinter Dir "
	"her."));
	return 1;
}
