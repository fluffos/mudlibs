/* 
** S'hiriin - die verschonte Jungfrau, nun altes Weib (Questchar)
** 28.09.1999  V1.0  Charon@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include "../ft_def.h"

create()
{   
   object sandalen,bluse,rock,umhang;
   
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"s'hiriin", "weib","\nft_shiriin"}) );
   create_default_npc( 10 );

   /*** NPC properties ***/

   SetProp(P_SHORT, "S'hiriin, ein altes Weib");
   SetProp(P_LONG,  ""
      );
   SetProp(P_NAME,    "S'hiriin");
   SetProp(P_GENDER,  FEMALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_HANDS,   ({" mit ihren Haenden", 10, DT_BLUDGEON}));
   SetProp(P_ALIGN,   300);
   SetProp(P_RACE,    "Mensch");
   SetProp(P_WIMPY,   30);
   SetProp(P_SIZE,    155);

   SetProp(P_DIE_MSG, " entschwindet mit einem unverstaendlichem Murmeln"
                    + " auf den Lippen.\n");

   SetProp(P_INFO, "S'hiriin muss sehr alt sein, denn sie sieht auch so"
                 + "aus. Allerdings glaubst Du, dass sie noch aelter ist"
                 + " als Du sie schaetzen wuerdest. Du fragst Dich, warum"
                 + " dies wohl so ist, und wie alt S'hiriin wirklich ist.\n");

   /*** NPC object stuff ***/
   // euid setzen, damit Objekte gecloned werden koennen
   seteuid(getuid(this_object()));

   // Objekte clonen
   sandalen = clone_object("/p/armour/sandalen");
   rock     = clone_object("/p/armour/rock");
   bluse    = clone_object("/p/armour/bluse");
   umhang   = clone_object("/p/armour/umhang");
   
   sandalen->move(this_object());
   rock->move(this_object());
   bluse->move(this_object());
   umhang->move(this_object());

   // Objekte benutzen
   command ("trage alles");

   /*** NPC details ***/

   AddDetail( ({"kleidung", "gewand"}),
      ""
    + ""
    );   

   /*** NPC information ***/

   AddInfo("charon",
      "\"Mein Herr und Erzeuger!\"",
      "kniet nieder und ruft: "
      );
    AddInfo( ({"hilfe","aufgabe","quest"}), 
       "@@aufgabe@@\n", 
       "sagt: "
       );
         
   /*** NPC chats ***/

   SetChats(3, ({
      "Kai jammert: Wenn ich hier kein Cannabis krieg', ich bald unter der Erde lieg'!\n",
      break_string("Carolina, mein Kleines - wahrscheinlich haben sie sie schon"
    + " verputzt...\n",
    78,"Kai seufzt: "),
      "Kai murmelt: Wenn sie nur jemand befreien koennte...\n",
      "Kai sudert: Wenn mir nur jemand helfen wuerde...\n",
      break_string("Haett' ich bloss ein Messer - schlitzte ich"
    + " auf die Menschenfresser! Schaute in sie hinein, wer denn"
    + " frass mein Toechterlein.\n",
    78,"Kai schluchzt: ")
      }) );

   SetProp(P_DEFAULT_INFO, ({
      "seufzt und legt die Haende in ihren Schoss.\n",
      "murmelt Unverstaendliches.\n",
      "schuettelt den Kopf uhnd murmelt: 'Warum nur?'",
      "scheint " }) 
      );


   /*** NPC attack chats ***/

   SetAttackChats(30, ({
     "Kai schreit: Hau bloss ab, Du feiges Schwein, sonst schlag ich Dir die Fresse ein!\n",
     "Kai jammert: Bitte, bitte schlag mich nicht - mein Kreuz tut weh - ich hab' die Gicht!\n",
     "Kai ruft: Fuer den Koenig!\n",
     "Kai lacht: Sauf Dir's Aug' aus - gehoerst eh ins Narrenhaus!\n",
     "Kai grinst: In Preussen treten wir doch Dreck wie Dich in den A... ganz fuerchterlich!"
     }) );
}


/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

/*** quest related stuff ****/
string aufgabe ()
{
  object ob;

  if (TP->QueryQuest("Der Tempel der Fallanassi"))
  {
     return(BS("Danke fuer Dein Angebot, " + TPN + ", aber Du hast"
             + " diese Aufgabe schon geloest - sie waere nicht noch"
             + " ein Mal eine Herausforderung fuer Dich.")
             );   
  }

  if (present("\nft_questitem", TP))
  {
     return(BS("Nun, Du hast mir Deine Hilfe schon angeboten, " + TPN
             + ". Mehr als ein Mal kannst auch DU mir doch nicht helfen,"
             + " oder?")
             );
  }
  else
  {
     ob = clone_object( FT_OBJ("ft_questitem"));
     ob->move(TP, M_NOCHECK);
	  return (BS(""));
   }
}