#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"ast","astgabel","ft_astgabel"}) );
  
   SetProp(P_SHORT, "Eine Astgabel");
   SetProp(P_LONG,
      "Die Astgabel ist ungefaehr zwei Ellen lang und stark gebogen."
      " Sie sieht ziemlich stabil aus und koennte durchaus Dein Gewicht"
      " tragen." 
      );
   SetProp(P_INFO, 
      "Auch Deine magischen Kraefte koennen nichts daran aendern -"
      " es ist eine normale Astgabel.");
   
   SetProp(P_NAME,    "Astgabel");
   SetProp(P_GENDER,  FEMALE);
   SetProp(P_ARTICLE, 1);
   
   SetProp(P_MATERIAL,MAT_WOOD);
   SetProp(P_WEIGHT,  1500);
   SetProp(P_VALUE,   100);
   SetProp(P_NOBUY,   1);
}
