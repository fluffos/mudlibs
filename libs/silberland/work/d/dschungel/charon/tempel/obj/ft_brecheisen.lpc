/*
** Brecheisen zum Herausbrechen des Steins VIII
** 10.11.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
   if (!is_clone(TO)) return;

   ::create();

   AddId(({"brecheisen", "eisen", "\nft_brecheisen"}));
   
   SetProp(P_SHORT, "Ein Brecheisen");
   SetProp(P_LONG, "Ein solides Brecheisen. Damit kann man"
      " irgendwas auf- oder wegbrechen."
      );
        
   SetProp(P_NAME,      "Brecheisen");
   SetProp(P_GENDER,    NEUTER);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_IRON);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_NOSELL,    1);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_WEIGHT,    200);
}
