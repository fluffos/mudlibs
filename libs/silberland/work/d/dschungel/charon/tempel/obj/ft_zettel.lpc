/*
** Zettel - Hinweise, um das Tempeltor zu oeffnen
** 28.09.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "/std/thing";

#include <properties.h>
#include <moving.h>

create()
{
   if(!is_clone(TO)) return;

   ::create();

   AddId( ({"zettel","\nft_zettel"}) );

   SetProp(P_SHORT, "Ein vergilbter Zettel");
   SetProp(P_LONG,  "Der Zettel ist schon sehr vergilbt - er duerfte"
      " also sehr alt sein. Dem Zettel scheint eine besondere Bedeutung"
      " zukommen. Das Papier sieht zwar schon recht mitgenommen aus, aber"
      " Du kannst es noch immer lesen."
      );

   SetProp(P_NAME,     "Zettel");
   SetProp(P_GENDER,   MALE);
   SetProp(P_ARTICLE,  1);
   SetProp(P_MATERIAL, MAT_PAPER);

   AddDetail( ({ "papier" }),
      "Das Papier ist stark vergilbt und weist schon starke"
    + " Zerfallserscheinungen auf. Dennoch - oder gerade deswegen - scheint"
    + " es eine besondere Bedeutung zu besitzen."
      );
   AddDetail( ({ "zerfallserscheinungen","zerfallserscheinung",
                 "zerfall","erscheinungen","erscheinung" }),
      "Das Papier ist sehr alt und abgegriffen, obwohl man sich bemueht"
    + " hat, es zu schuetzen. Das Alter ist ihm anzusehen und Du denkst:"
    + " 'Wenn man einen solchen Zettel schon so lange aufbewahrt, dann"
    + " muss es schon eine besondere Bewandtnis mit ihm haben.'"
      );      
   AddDetail( ({ "bedeutung","bewandtnis" }),
      "Um die Bedeutung herauszubekommen, solltest Du den Zettel"
    + " vielleicht lesen..."
      );
   AddDetail( ({ "alter"}),
      "Der Zettel ist sehr alt."
      );
   
   /*** Klartext ***/   
   /*       "auserwaehlter diese zeilen stellen die letzte ueberlieferung dar die"
    + " uns unser gott hinterlassen hat um in seinen geheiligten tempel zu"
    + " gelangen. doch um zu diesem heiligtum vordringen zu koennen muessen"
    + " erst die gefahren des dschungels bewaeltigt werden. denn im dschungel"
    + " sind acht steine versteckt die das tempeltor oeffnen. aber huete"
    + " dich vor zu grosser eile auserwaehlter denn im dschungel lauern"
    + " toedliche gefahren denn die steine sollten nur vom wahren auserwaehlten"
    + " gefunden werden. die fallen sind heimtueckisch und toedlich, doch"
    + " solltest du es bis zum tempel schaffen und alle acht steine gefunden"
    + " haben dann beherzige folgendes \n\n   acht steine acht vertiefungen nur"
    + " zwei loesungen kein stein soll\n   neben einem verwandten liegen in keiner"
    + " richtung des himmels \n\nnur so wirst du in den tempel gelangen."
    + " eines gebe ich dir noch mit auf den weg. du hast nur einen versuch,"
    + " sonst wird es dir schlecht ergehen. viel glueck auserwaehlter und"
    + " moege der gott fallanassi deine schritte behueten."
    */
   AddReadDetail( ({ "zettel" }),
      "a userw ae hlte rdi esezei lenstel lend iel e t zteue be rli efer ungdar"
    + " di eun sun serg ot thi nte rlas senh atu mi nsei nengeh ei li gte"
    + " nte mpelz ugel an gen. doc humz udie semh eil igtumv ord ri ngenz"
    + " ukoe nnenmue ssener stdi egef ahre nde sdsc hun gelsbe wae lti gtwe"
    + " rden. d enni mds chu ngels in dac htst ein ever stec ktd ieda stem"
    + " pe lto roef fn en. a be rhu et ed ic hvo rzugro sse re ileau se rwa"
    + " ehl terde nni mdsc hun gella uernt oe dlich ege fah rend en ndieste"
    + " in eso ll tenn urvo mwa hre naus erwa eh lte ngef un denw erd en. di"
    + " efa lle nsi ndhe imtu ec ki schu ndto edli ch, do chso ll testdue sbis"
    + " zu mte mpels chaf fenu ndal leach tst e ineg ef unde nha bend annbe"
    + " he rz igefol gend es \n\n   ac htst e in each tve rti efu ngenn urz"
    + " we iloe su ngenk ei nst eins oll\n   n eb enei ne mver wa ndt enli"
    + " egen i nk ei nerri ch tun gde shi mme ls \n\nnu rsow irs tdui nde"
    + " nte mpe lge lan gen. ei nesg ebei chdi rno chmi ta ufde nw eg. duh"
    + " as tn ure ine nve rs uchs ons twi rde sd irsc hle chter ge hen."
    + " vi elg lue ckau ser waeh lte run dmo egede rg ottf al lan assid ei"
    + " nesch rit teb ehue ten."
      );
}
