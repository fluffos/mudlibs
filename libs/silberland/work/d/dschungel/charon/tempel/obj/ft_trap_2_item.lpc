/*
** Item fuer Falle bei Stein Nr. II bei Fallanasitempelquest
** Muss vorhanden sein, damit Falle bei Stein II nicht ausloest.
** 24.09.1999  V1.0  Charon@SL
*/

inherit "std/thing";

#include "../ft_def.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId (({"\nft_trap_2_item","ft_trap_2_item"}));
  
  SetProp (P_SHORT,     0);
  SetProp (P_NAME,      "FT_Trap_2_Item");
  SetProp (P_GENDER,    NEUTER);
  SetProp (P_WEIGHT,    0);
  SetProp (P_VALUE,     0);
  SetProp (P_NOBUY,     1);
  SetProp (P_NODROP,    1);
  SetProp (P_NEVERDROP, 1);
}
