/*
** Stein 2 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_2","\nft_stein_2"}) );
  
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_LONG,
      "Der Stein ist in etwa so gross wie ein Huehnerei, auch die Farbe"
      " scheint dem eines Eis zu aehneln."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Stein ist.");
   
   SetProp(P_NAME,      "Stein");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_STONE);
   SetProp(P_WEIGHT,    100);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);

   /* Details zum Object */
   AddDetail( ({"farbe"}),
      "Die Farbe ist ein helles Beige. Du streichst mit Deinen Haenden"
    + " vorsichtig ueber den Stein bemerkst eine andere Farbschattierung"
    + " darauf."
    );
   AddDetail( ({"farbschattierung","schattierung"}),
      "Jemand hat sich die Muehe gemacht, um ein Zeichen in grossen Lettern"
    + " auf den Stein zu pinseln, nur um sie danach wieder ueberdecken."
    );   
   AddDetail( ({"lettern","letter"}),
      "Die Lettern ergeben ein Zeichen."
    );
   AddSpecialDetail( ({"zeichen"}), "zeichen");
}

string zeichen()
{
   SetProp(P_SHORT, "Ein Stein (II)");  
   
   return(BS("Du bist uebergluecklich, dass Dich Deine Schulkenntnisse"
    + " noch nicht verlassen haben und Du das Zeichen 'II' erkennst.\n")
    );
}
