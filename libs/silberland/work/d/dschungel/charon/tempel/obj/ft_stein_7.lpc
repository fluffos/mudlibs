/*
** Stein 7 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_7","\nft_stein_7",
         "lehm","lehmhaufen","haufen"}) );
  
   SetProp(P_SHORT, "Ein Haufen Lehm");
   SetProp(P_LONG,
      "Obwohl Du zuerst dachtest, Du haettest einen Stein gefunden, wirst"
      " Du nun eines besseren belehrt. Denn in Deinen Haenden befindet sich"
      " ein fester Haufen Lehm."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Haufen Lehm ist.");
   
   SetProp(P_NAME,      "Haufen Lehm");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_EARTH);
   SetProp(P_WEIGHT,    400);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);


   /* Details zum Object */
   AddDetail( ({"lehm","haufen","lehmhaufen"}),
      "Als Du den Lehmhaufen so in Deinen Haenden herumdrehst und knetest,"
    + " faellt Dir auf, dass unter der Schicht aus Lehm noch ein harter"
    + " Kern verborgen ist."
    );
   AddDetail( ({"kern"}),
      "Vorsichtig kratzt Du den Lehm ab und legst immer mehr des harten"
    + " Kerns frei. Du kannst eindeutig spueren, dass Du einen weiteren"
    + " Stein entdeckt hast."
    );   
   AddSpecialDetail( ({"stein"}),"stein");
}

string stein()
{
   RemoveId( ({"lehm","lehmhaufen","haufen"}) );
   SetProp(P_SHORT, "Ein Stein (VII)");  
   SetProp(P_LONG,
      "Nun erkennst du eindeutig, dass es ein Stein ist."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Stein ist.");
   SetProp(P_NAME,    "Stein");
   SetProp(P_WEIGHT,  200);
   SetProp(P_MATERIAL,MAT_STONE);
     
   return(BS("Nachdem Du den Stein vom Lehm befreit hast, kannst Du"
     + " eindeutig eine 'VII' erkennen.\n")
    );
}
