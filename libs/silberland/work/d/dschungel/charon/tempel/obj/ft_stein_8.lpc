/*
** Stein 8 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_8","\nft_stein_8"}) );
  
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_LONG,
      "Dieser Stein ist genauso, wie Du es von einem Stein erwartest."
      " Klein und hart. Durch Dein nun geschultes Auge erkennst Du"
      " sofort ein Zeichen daran."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Stein ist.");
   
   SetProp(P_NAME,      "Stein");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_STONE);
   SetProp(P_WEIGHT,    300);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);
   

   AddSpecialDetail( ({"zeichen"}),"zeichen");
}

string zeichen()
{
   SetProp(P_SHORT, "Ein Stein (VIII)");  
     
   return(BS("Du kannst Du eindeutig eine 'VIII' erkennen.\n") );
}
