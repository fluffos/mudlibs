/*
** Stein 1 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_1","\nft_stein_1"}) );
  
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_LONG,
      "Der Stein ist in etwa faustgross und nicht sehr schwer."
      " Er liegt gut in der Hand und als Du ihn von allen Seiten"
      " betrachtest, faellt Dir eine Unebenheit am Stein auf."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Stein ist.");
   
   SetProp(P_NAME,      "Stein");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_STONE);
   SetProp(P_WEIGHT,    200);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);

   /* Details zum Object */
   AddDetail( ({"unebenheit"}),
      "Deine Finger tasten ueber die Oberflaeche des Steins und entdecken"
    + " eine Rille darin."
    );
   AddDetail( ({"oberflaeche"}),
      "Die Oberflaeche des Steins ist ein wenig rauh, was an den"
    + " hiesigen Witterungsverhaeltnissen liegen duerfte, weist aber"
    + " auf der einen Seite eine kleine Unebenheit auf."
    );   
   AddDetail( ({"rille"}),
      "Die Rille ist nicht sehr tief, aber jemand hat sich grosse Muehe"
    + " gegeben, sie so in den Stein zu ritzen, dass sie viele Jahrhunderte"
    + " ueberdauern kann. Mit dem Fingernagel schabst Du ein wenig Erde weg"
    + " und legst damit das Zeichen vollends frei."
    );
   AddSpecialDetail( ({"zeichen"}), "zeichen");
}

string zeichen()
{
   SetProp(P_SHORT, "Ein Stein (I)");  
   
   return(BS("Zwar schwer zu erkennen, aber Du kramst Deine Lateinkenntnisse"
    + " heraus und nach laengerem Ueberlegen erkennst Du, dass es sich"
    + " bei diesem Zeichen um eine 'I' handelt.\n")
    );
}
