/*
** Stein 6 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_6","\nft_stein_6"}) );
  
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_LONG,
      "Man kann eigentlich kaum von einem Stein sprechen, denn dieser in"
      " Deinen Haenden ist beinahe eine Kugel. Nur die obere Polkappe ist"
      " ein wenig abgeflacht."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Stein ist.");
   
   SetProp(P_NAME,      "Stein");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_STONE);
   SetProp(P_WEIGHT,    800);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);

   /* Details zum Object */
   AddDetail( ({"polkappe","pol","kappe"}),
      "Der obere Teil der Kugel (wenn man bei einer Kugel von einem oberen"
    + " Teil sprechen kann), ist leicht abgeflacht. Du kannst den Sinn nicht"
    + " ganz erkennen, denn sonst scheint dieser Stein eine perfekte Kugel"
    + " zu sein."
    );
   AddDetail( ({"kugel","teil"}),
      "Du drehst die Kugel in Deinen Haenden, als sie Dir auf einmal aus den"
    + " Haenden rutscht und auf den Boden faellt. Leise stoesst Du einen"
    + " Fluch aus...doch dann faellt Dein Blick auf die Bruchstuecke."
    );   
   AddSpecialDetail( ({"buechstuecke","bruchstueck","stuecke","stueck"}),
                "bruchstuecke");
}

string bruchstuecke()
{
   SetProp(P_SHORT, "Ein Stein (VI)");  
   SetProp(P_WEIGHT,  200);
     
   return(BS("Du erkennst eindeutig einen kleineren Stein, der nur von"
     + " einer Tonhuelle umgeben war. Vorsichtig bueckst Du Dich und hebst"
     + " den kleineren Stein aus den Scherben auf. Eine 'VI' leuchtet Dir"
     + " strahlend entgegen.\n")
    );
}
