/*
** Unsichtbares Item fuer Tempeltorschloss
** 14.09.1999  V1.0  Charon@SL
*/

inherit "std/thing";

#include "../ft_def.h"

string *erg = allocate(8);
int cnt = 0;

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId (({"\nft_tempelschlossitem","ft_tempelschlossitem"}));
  
  SetProp (P_SHORT,     0);
  SetProp (P_NAME,      "TempelschlossItem");
  SetProp (P_GENDER,    NEUTER);
  SetProp (P_WEIGHT,    0);
  SetProp (P_VALUE,     0);
  SetProp (P_NOBUY,     0);
  SetProp (P_NODROP,    1);
  SetProp (P_NEVERDROP, 1);
}

string *set_tempelschloss(string stein,int vertiefung)
{
   if(getuid(previous_object()) != "charon") return 0;
  
   switch(vertiefung)
   {
      case "a":   erg[0] = stein;
      break;
      case "b":   erg[1] = stein;
      break;
      case "c":   erg[2] = stein;
      break;
      case "d":   erg[3] = stein;
      break;
      case "e":   erg[4] = stein;
      break;
      case "f":   erg[5] = stein;
      break;
      case "g":   erg[6] = stein;
      break;
      case "h":   erg[7] = stein;
      break;
   }
   cnt++;                
   return erg;
}

int query_tempelschloss_cnt()
{
   return cnt;
}

string *query_tempelschloss()
{
   return erg;
}