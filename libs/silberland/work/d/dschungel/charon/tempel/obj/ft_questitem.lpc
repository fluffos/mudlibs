/*
** Questitem fuer Fallanasitempelquest
** 23.09.1999  V1.0  Charon@SL
** 09.11.1999  V1.1  Charon@SL   - Umbau, so dass jedes Item der Quest
**                                 durch eigenen Zahl repraesentiert wird.
**                                 Vermeidung unnuetzer Invis-Items im 
**                                 Inventory
*/

inherit "std/thing";

#include "../ft_def.h"

int quest = 0;

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId (({"\nft_questitem","ft_questitem"}));
  
   SetProp (P_SHORT,     0);
   SetProp (P_NAME,      "FT_QuestItem");
   SetProp (P_GENDER,    NEUTER);
   SetProp (P_WEIGHT,    0);
   SetProp (P_VALUE,     0);
   SetProp (P_NOBUY,     1);
   SetProp (P_NODROP,    1);
   SetProp (P_NEVERDROP, 1);
}

int set_quest(int item)
{
   if(getuid(previous_object()) != "charon") return 0;
  
   quest |= item;
                
/*  DB ("KANNIBALENDORFQUEST: "+this_player()->name()+" ist bei Punkt: "+quest+" --> "+KDQSTRING[stufe]+"\n");
  DBM("KANNIBALENDORFQUEST: "+this_player()->name()+" ist bei: "+KDQSTRING[stufe]+"\n");
  write_file (KANNIBALENDORFQUESTLOG,
     sprintf ("%s: "+this_player()->name()+" ist bei Punkt: "+quest+
              " --> "+KDQSTRING[stufe]+"\n",dtime(time())
             )
     );
*/

  return quest;
}

int query_quest()
{
   return quest;
}