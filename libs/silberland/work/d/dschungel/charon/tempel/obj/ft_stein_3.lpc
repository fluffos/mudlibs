/*
** Stein 3 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_3","\nft_stein_3"}) );
  
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_LONG,
      "Der Stein ist ein kleiner Kieselstein, nur so gross wie Dein"
      " Daumennagel, dafuer strahlt er aber in einem herrlichen Blau."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Stein ist.");
   
   SetProp(P_NAME,      "Stein");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_STONE);
   SetProp(P_WEIGHT,    20);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);

   /* Details zum Object */
   AddDetail( ({"blau"}),
      "Du hast selten etwas von einer solchen Reinheit und Schoenheit"
    + " gesehen, wie diesen einfachen Kieselstein. Nur eine kleine"
    + " Verunreinigung stoert das makellose Erscheinungsbild dieses"
    + " Kieselsteins."
    );
   AddDetail( ({"erscheinungsbild","bild","erscheinung"}),
      "Obwohl von makelloser Schoenheit ist eine Verunreinigung zu"
    + " sehen. Doch Du glaubst nicht, dass diese natuerlichen Ursprungs"
    + " ist."
    );   
   AddDetail( ({"schoenheit"}),
      "Diese Schoenheit bestaerkt Dich in dem Glauben, dass es Goetter"
    + " geben muss."
    );
   AddSpecialDetail( ({"verunreinigung"}), "verunreinigung");
}

string verunreinigung()
{
   SetProp(P_SHORT, "Ein Stein (III)");  
   
   return(BS("Du haeltst den Stein knapp vor Dein Auge und betrachtest "
    + " ihn ganz genau von allen Seiten. Unter einem bestimmten Winkel"
    + " kommt es Dir so vor, als ob Du eine 'III' erkennst.\n")
    );
}
