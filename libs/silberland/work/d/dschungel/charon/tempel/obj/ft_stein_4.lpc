/*
** Stein 4 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_4","\nft_stein_4"}) );
  
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_LONG,
      "Der Stein ist zeimlich gross und unhandlich. Seine Ecken und Kanten"
      " sind sehr scharf und koennen Dir leicht Schaden zufuegen. Du musst"
      " schon Deine ganze Geschicklichkeit einsetzen, um ihn in Deinen Haenden"
      " zu drehen."
      );
   SetProp(P_INFO, 
      "Deine magischen Kraefte lassen Dich nur erkennen, dass"
      " es ein normaler Stein ist.");
   
   SetProp(P_NAME,      "Stein");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_STONE);
   SetProp(P_WEIGHT,    10000);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);

   /* Details zum Object */
   AddDetail( ({"ecken","kanten","ecke","kante"}),
      "Du betrachtest die Kanten genauer, dabei faellt Dir auf, dass sie"
    + " nicht willkuerlich angeordnet sind, sondern einem Muster folgen."
    );
   AddDetail( ({"muster"}),
      "So wie die Kanten zueinander stehen ergeben sie ein geometrisches"
    + " Bild."
    );   
   AddSpecialDetail( ({"bild"}), "bild");
}

string bild()
{
   SetProp(P_SHORT, "Ein Stein (IV)");  
   TP->AddHp(-5);
   
   return(BS("Du drehst den Stein in Deinen Haenden und verletzt Dich dabei"
    + " am Arm. Die Wunde ist nicht weiter schlimm, aber sie blutet. Das"
    + " Blut tropft ueber Deinen Arm auf den Stein und bringt das"
    + " geometrische Muster noch besser hervor. Du erkennst eine 'IV'.\n")
    );
}
