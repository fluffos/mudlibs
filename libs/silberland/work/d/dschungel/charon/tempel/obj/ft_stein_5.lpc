/*
** Stein 5 - Einer der 8 Steine, um das Tempeltor zu oeffnen
** 13.09.1999  V1.0  Charon@SL
*/

#include "/d/dschungel/charon/charon_def.h"
#include "../ft_def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() 
{

   if (!is_clone(TO)) return;
   ::create();

   AddId( ({"stein","ft_stein_5","\nft_stein_5"}) );
  
   SetProp(P_SHORT, "Ein Stein");
   SetProp(P_LONG,
      "Du erkennst einen sehr flachen Stein, der in etwa handtellergross"
      " ist. Obwohl er nicht sehr schwer ist, scheint etwas Besonderes an"
      " ihm zu haften. Aus den Augenwinkeln glaubst Du, ein leichtes"
      " Schimmern erkennen zu koennen."
      );
   SetProp(P_INFO, 
      "Das Schimmern scheint aus dem Inneren des Steins zu kommen. Er"
      " scheint von besonderes Bedeutung zu sein, um Dir weiterzuhelfen.");
   
   SetProp(P_NAME,      "Stein");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   
   SetProp(P_MATERIAL,  MAT_STONE);
   SetProp(P_WEIGHT,    500);
   SetProp(P_VALUE,     100);
   SetProp(P_NOBUY,     1);
   SetProp(P_NODROP,    1);
   SetProp(P_NEVERDROP, 1);

   /* Details zum Object */
   AddDetail( ({"schimmern"}),
      "Du glaubst, ein leichtes Schimmern erkennen zu koennen, weisst aber"
    + " nicht, ob das nur Einbildung ist. Dir faellt besonders eine kleine,"
    + " blanke Flaeche an diesem Stein auf."
    );
   AddDetail( ({"flaeche"}),
      "Als Du mit Deinem Finger die Flaeche beruehrst, leuchtet sie auf"
    + " und laesst Dich ein Zeichen erkennen."
    );   
   AddSpecialDetail( ({"zeichen"}), "zeichen");
}

string zeichen()
{
   SetProp(P_SHORT, "Ein Stein (V)");  
   
   return(BS("Das leuchtende Zeichen stellt eine 'V' dar.\n")
    );
}
