/*
** D4 - Raum mit Stein Nr. II
** 30.09.1999  V1.0  Charon@SL
** 09.11.1999  V1.1  Charon@SL   - Anpassung an neues Questitem
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

#define RINDE        0
#define ERDE         1
#define FLECHTWERK   2
#define WURZEL       3
#define LOCH         4

#define VERSTECKE 5
int versteck = random(VERSTECKE); /* 5 Verstecke fuer den Stein */

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Im Dschungel" );
   SetProp(P_INT_LONG,
      "Der Weg geht nach der Luecke weiter, und Du wunderst Dich,"
      " wieso Du ihn auf der anderen Seite nicht gesehen hast. Du schaust"
      " Dich um und siehst nur Pflanzen rings um Dich."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Der Boden laesst Dich kaum Unterschiede zu anderen Stellen,"
    + " die Du zuvor gesehen hast, erkennen. Die Pflanzen wuchern"
    + " rings um Dich, manche uebermannshoch, andere schlaengeln sich"
    + " am Boden dahin. Das Erdreich ist teilweise noch zu sehen."
      );
   AddDetail( ({ "stellen","stelle","orte","ort" }),
      "Orte, die Du schon zuvor durchwandert bist."
      );
   AddDetail( ({ "pflanzen","pflanze","wunderwerke","wunderwerk" }),
      "Sie sind einfach atemberaubend. Die gigantischen Staemme, die"
    + " riesigen Blaetter und die verdrehten Wurzeln. Du staunst immer"
    + " noch ueber die Wunderwerke, welche die Natur hervorgebracht hat."
      );
   AddDetail( ({ "natur" }),
      "Alles hier - die Baeume, die Straeucher, die Blumen und alles andere."
      );
   AddDetail( ({ "baeume","baum","gigant","giganten","riesen" }),
      "Die Baeume sind gigantisch. Sie ueberragen Dich weit. Schon die"
    + " Rinde ist beeindruckend."
      );
   AddDetail( ({ "staemme","stamm" }),
      "Die Staemme ragen bis weit in den Himmel. Diese Giganten scheinen"
    + " jedem und allem zu trotzen, egal welche Widrigkeiten da kommen"
    + " moegen."
      );
   AddDetail( ({ "widrigkeiten","widrigkeit" }),
      "Die Natur haelt viele Widrigkeiten fuer alle Pflanzen - Blumen und"
      + " Baeume - bereit. Doch obwohl die Baeume so riesig und"
      + " widerstandfaehig sind, haben sie dennoch Feinde."
      );
   AddDetail( ({ "feinde","feind" }),
      "Die Feinde solcher Riesen sind meist viel kleiner - Maeuse und andere"
    + " Nager."
      );
   AddDetail( ({ "maeuse","maus","nager" }),
      "Die kleinen Nager fressen gerne Loecher in die Rinde der Baeume."
      );
   AddDetail( ({ "loecher","loch" }),
      "Ja, auch der Baum vor Dir hat ein Loch, das von einem Nager herruehrt."
      );
   AddDetail( ({ "rinde" }),
      "Die Rinde ist bei den meisten Baeumen grob und rissig - zumindest"
    + " sieht es so aus. Du kannst Dir vorstellen, dass diese Giganten"
    + " auch gewaltige Feuer und Braende ueberstehen wuerden."
      );
   AddDetail( ({ "feuer","braende","brand" }),
      "Wenn hier jemand Feuer legen sollte - die Baeume wuerden es sicher"
    + " unbeschadet ueberstehen."
      );
   AddDetail( ({ "pfad","weg" }),
      "Der Pfad setzt sich wieder nach Sueden fort. Er sit stark von"
    + " Pflanzen ueberwuchert und daher ist nur schwer voranzukommen."
      );
   AddDetail( ({ "luecke" }),
      "Die Luecke, durch die Du gekommen bist, ist genau hinter Dir."
    + " Dir kommt es nur eigenartig vor, dass Du sie auf der anderen"
    + " Seite nicht gesehen hast,"
      );
   AddDetail( ({ "seite" }),
      "Die Seite vor der Luecke, also bevor du hierhergekommen bist."
      );
   AddDetail( ({ "blaettern","blaetter","blatt" }),
      "Die Blaetter sind ein allen Groessen vorhanden. Von kleinen ueber"
    + " tellergrosse bis hin zu einer solchen Groesse, dass man sich leicht"
    + " damit zudecken oder bei Regen Unterschlupf finden koennte."
      );
   AddDetail( ({ "groessen","groesse" }),
      "Jede Groesse von Blaettern ist zu finden. Du findest die riesigen am"
    + " beeindruckendsten, weil sie einen Unterschlupf bilden, der vor Regen"
    + " schuetzt."
      );
   AddDetail( ({ "regen" }),
      "Bei Regen braucht man hier einen Unterschlupf, denn es regnet haeufig"
    + " und stark."
      );
   AddDetail( ({ "unterschlupf","schutz" }),
      "Die riesigen Blaetter liegen so geschickt uebereinander, dass man meinen"
    + " koennte, sie seien miteinander verwoben. Doch dieses Flechtwerk bietet"
    + " einen ausgezeichneten Schutz vor Regen."
      );
   AddDetail( ({ "flechtwerk","werk" }),
      "Das Flechtwerk der Blaetter ist sehr dicht, und beinahe schon als"
    + " kuenstlerisch zu bezeichnen. Du bezweifelst beinahe, dass es"
    + " natuerlichen Ursprungs ist - zu gleichmaessig ist es angeordnet."
      );
   AddDetail( ({ "ursprungs","ursprung" }),
      "Du betrachtest das Flechtwerk genauer und bemerkst auf einmal, dass"
    + " das Material nicht pflanzlich ist. Die Oberflaeche ist matter als"
    + " gewoehnlich."
      );
   AddDetail( ({ "material" }),
      "Es ist bestimmt keine Pflanze, denn das Material sieht ziemlich"
    + " widerstandfaehig aus."
      );
   AddDetail( ({ "oberflaeche" }),
      "Die Oberflaeche schimmert matt im spaerlichen Licht. Du streichst"
    + " langsam darueber - anerkennend nickst Du zu dieser Meisterleistung"
    + " der Imitation."
      );
   AddDetail( ({ "meisterleistung","leistung","imitation" }),
      "Du bist Dir sicher, dass diese Imitation nur deshalb so perfekt ist,"
    + " weil sie etwas verbergen soll. Du koenntest ja einmal versuchen, das"
    + " Flechtwerk zu zerreissen."
      );
   AddDetail( ({ "wurzeln","wurzel" }),
      "Die Wurzeln ranken sich kreuz und quer, drunter und drueber, sind"
    + " ineinander verschlungen und zusammengewachsen. Sie sind kaum mehr"
    + " einem einzigen Baum zuzuordnen, vielmehr stellen sie fast ein eigenes"
    + " Gebilde dar."
      );
   AddDetail( ({ "gebilde" }),
      "Die Wurzeln sind so ineinander verflochten, dass sie kaum mehr"
    + " zu unterscheiden sind. Zwischen den Wurzeln bilden sich immer"
    + " wieder Hohlraeume, die unterschiedlich gross sein koennen."
      );
   AddDetail( ({ "hohlraeume","hohlraum" }),
      "Die Hohlraeume bieten sich an, um dort etwas zu verstecken. Sie"
    + " sind teilweise gross genug, dass man hineingreifen kann."
      );
   AddDetail( ({ "erdreich","erdreiches","erde","unterschied",
                 "unterschiede" }),
      "Das Erdreich ist nicht vollstaendig von Pflanzen ueberwuchert. Ein"
    + " fast schon vertrauter Geruch stroemt von der Erde aus. Der Boden"
    + " macht einen sehr lockeren Eindruck."
      );
   AddDetail( ({ "eindruck" }),
      "Du stehst auf einem ziemlich weichen Teil der Erdreiches. Du koenntest"
    + " Dir gut vorstellen, dass die Erde nicht zufaellig so locker und weich"
    + " ist."
      );
   AddDetail( ({ "teil" }),
      "Du koenntest ja diesen Teil genauer unter die Lupe nehmen."
      );
   AddDetail( ({ "lupe" }),
      "Dir muss man aber auch alles aus der Nase ziehen, oder? Wie meinst"
    + " Du, kann man Erde genauer untersuchen?"
      );
   AddDetail( ({ "nase" }),
      "Ja, Deine Nase ist ziemlich gross (oder etwa nicht?). Vielleicht"
    + " solltest Du sie in die Erde stecken und endlich zu graben anfangen."
      );
   AddDetail( ({ "blumen","blume" }),
      "Die Blumen sind einfach ueberwaeltigend - riesig und sehr"
    + " farbenpraechtig."
      );
   AddDetail( ({ "straeucher","strauch" }),
      "Man koennte fast schon sagen, die Straeucher sind kleine Baeume, so"
    + " riesenhaft sind sie."
      );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","licht","vielleicht" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das entfernte Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden","geruch" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "zwaenge","zwaeng" }), "zwaengeDurchLuecke" );
   
   /* Versteck 0 */
   AddCmd( ({ "mache","mach" }),                  "macheFeuer" );
   /* Versteck 1 */
   AddCmd( ({ "grab","grabe","wuehl","wuehle" }), "grabeInErde" );   
   /* Versteck 2 */
   AddCmd( ({ "zerreiss","zerreisse" }),          "zerreisseFlechtwerk" );   
   /* Versteck 3,4 */
   AddCmd( ({ "greife","greif" }),                "greifIn" );   
   
         
   /*** Items ***/

   /*** Exits ***/
   AddExit( "sueden", "./room_d5" );
   
   call_out("aktuellesVersteck", 0);
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int zwaengeDurchLuecke(string str)
{
   object ob;
   string str1;
   int damage;
      
   notify_fail( "Wo Du Dich durchzwaengen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "durch %s",str1) != 1)
   	return 0;
      
   if( str1 == "luecke")
   {
      if (TP->QueryProp(P_SIZE) > 170)
      {
         write(BS("Obwohl Du weisst, dass Du Dich verletzen wirst,"
                + " musst Du Dich durch diese Luecek zwaengen, passt"
                + " aber besser auf und verletzt Dich weniger.")
             );
         damage = -((TP->QueryProp(P_SIZE) - 170) / 4);
         TP->AddHp(damage);
      }
      else
         write(BS("Du zwaengst Dich langsam durch die enge Luecke.") );

      TP->move(FT_ROOM("room_e4"),M_GO,
                  "oestlich von Dir",
                  "verschwindet","kommt westlich von Dir herein"
                  );       
      return 1;   
   }
   
   return 0;
}

aktuellesVersteck()  
{
   object ob;
   string str;
   
   ob = find_living("charon");
   if(ob)  
   {
      switch(versteck)
      {
         case RINDE:       str = "In Rinde ('mach feuer')";
         break;
         case ERDE:        str = "In Erde ('grabe in erde')";
         break;
         case FLECHTWERK:  str = "Hinter Flechtwerk ('zerreisse flechtwerk')";
         break;
         case WURZEL:      str = "Unter Wurzel ('greif in hohlraum')";
         break;
         case LOCH:        str = "In Loch ('greif in loch')";
         break;
      }
      tell_object(ob,"\n--> Stein II liegt in Versteck: " + str + "\n");   
   }  
}

int moveSteinInInventory()
{
   object stein;
   
   stein = clone_object(FT_OBJ("ft_stein_2"));
   if (stein->move(TP,M_GET) == ME_TOO_HEAVY)
   {
      write(BS("Du kannst nicht mehr so viel tragen, daher nimmst Du"
             + " den Stein nicht.")
             );
      say(BS(TPN + " kann nicht mehr so viel tragen und nimmt den Stein"
             + " daher nicht.")
             );
                
      stein->destruct();
   }
   else
   {
      write(BS("Du verstaust den Stein in Deiner Tasche."));
      say(BS(TPN + " verstaut den Stein in einer Tasche."));
      
      /* Stein wieder neu verstecken */
      versteck = random(VERSTECKE);
      call_out("aktuellesVersteck", 0);
   }
   
   return 1;   
}

int checkTrap()
{
   object ob;
   
   /* Falle ausloesen, wenn Spieler FT_TRAP_2_DISABLED nicht hat. */
   if(!(ob = FT_QUESTITEM))
   {
      write(BS(NOT_PLAYING_QUEST));       
      return 1;
   }
   if(!(ob->query_quest() & FT_TRAP_2_DISABLED))
   {
      write(BS("Du stuerzt in eine Falle."
             + " ")
             );
      say(BS(TPN + " stuerzt in eine Falle.")
           );
         
      return 1;            
   }   
   return 0;
}

int macheFeuer(string str)
{
   string str1;

   notify_fail( "Was moechtest Du machen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s",str1) != 1)
   	return 0;
   
   if (str1 == "feuer")
   {
      /* Checken, ob Falle ausloesen soll */
      if(checkTrap()) 
         return 1;
      
      if(FT_QUESTITEM && versteck == RINDE && (!FT_STONE("\nft_stein_2")) )
      {
         write(BS("Du zoegerst nicht lange und machst ein kleines Feuer"
                + " an. Du schlichtest Lianen und duenne Aeste zu einer"
                + " kleinen Pyramide auf und zuendest das Ganze an. Schnell"
                + " wird das Feuer groesser und erfasst auch die umstehenden"
                + " Baeume. Die Rinde faengt auch Feuer und beginnt lichterloh"
                + " zu brennen. Du denkst noch: 'Was soll ich nun tun?' und"
                + " wartest einfach. ... Nach einiger Zeit sinken die Flammen"
                + " wieder in sich zusammen, und Du entdeckst einen Stein in"
                + " der verschmorten Rinde. Schnell greifst Du nach dem Stein.")
                );
         say(BS(TPN + " zuendet einkleines Feuer an, das rasch um sich greift."
              + " Auch die Rinde der Baeume faengt Feuer und brennt lichterloh."
              + " Nach einiger Zeit sinken die Flammen wieder in sich zusammen,"
              + " und " + TPN + " entdeckt etwas und greift danach.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Du zoegerst nicht lange und machst ein kleines Feuer"
                + " an. Du schlichtest Lianen und duenne Aeste zu einer"
                + " kleinen Pyramide auf und zuendest das Ganze an. Schnell"
                + " wird das Feuer groesser und erfasst auch die umstehenden"
                + " Baeume. Die Rinde faengt auch Feuer und beginnt lichterloh"
                + " zu brennen. Du denkst noch: 'Was soll ich nun tun?' und"
                + " wartest einfach. ... Nach einiger Zeit sinken die Flammen"
                + " wieder in sich zusammen. Du kannst allerdings nichts in"
                + " den Ueberresten entdecken.")
                );
         say(BS(TPN + " zuendet einkleines Feuer an, das rasch um sich greift."
              + " Auch die Rinde der Baeume faengt Feuer und brennt lichterloh."
              + " Nach einiger Zeit sinken die Flammen wieder in sich zusammen,"
              + " und " + TPN + " wendet sich enttaeuscht ab.")
              );
         return 1;   
      }
   }
   
   return 0;
}

int grabeInErde(string str)
{
   object ob;
   string str1;

   notify_fail( "Worin moechtest Du graben?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "in %s",str1) != 1)
   	return 0;
   
   if (str1 == "erde" || str1 == "boden")
   {
      /* Checken, ob Falle ausloesen soll */
      if(checkTrap()) 
         return 1;
      
      if(FT_QUESTITEM && versteck == ERDE && (!FT_STONE("\nft_stein_2")) )
      {
         write(BS("Vorsichtig steckst Du Deine Hand in die feuchte Erde."
                + " Immer tiefer und tiefer wuehlst Du, bis fast Dein gesamter"
                + " Arm im Erdboden verschwunden ist. Doch dann ploetzlich"
                + " ertasten Deine Finger etwas und packen zu. Schnell ziehst"
                + " Du Deinen Aerm zurueck und blickst auf einen dreckigen"
                + " Stein, den Du sofort saeuberst.")
                );
         say(BS(TPN + " steckt vorsichtig einen Arm in den Boden und scheint"
              + " nach etwas zu graben. Nach kurzen Bemuehungen findet"
              + " " + TPN + "auch etwas und saeubert es anschliessend.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Vorsichtig steckst Du Deine Hand in die feuchte Erde."
                + " Immer tiefer und tiefer wuehlst Du, bis fast Dein gesamter"
                + " Arm im Erdboden verschwunden ist. Du wuehlst und wuehlst,"
                + " doch kannst Du nichts finden und ziehst enttaeuscht Deinen"
                + " Arm wieder heraus.")
                );
         say(BS(TPN + " steckt vorsichtig einen Arm in den Boden und scheint"
              + " nach etwas zu graben. Doch obwohl " + TPN + " angestrengt"
              + " sucht, scheint hier nichts verborgen zu sein.")
              );

         return 1;   
      }
   }
   
   return 0;
}

int zerreisseFlechtwerk(string str)
{
   string str1;

   notify_fail( "Was moechtest Du zerreisen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s",str1) != 1)
   	return 0;
   
   if (str1 == "flechtwerk")
   {
      /* Checken, ob Falle ausloesen soll */
      if(checkTrap()) 
         return 1;
      
      if(FT_QUESTITEM && versteck == FLECHTWERK && (!FT_STONE("\nft_stein_2")) )
      {
         write(BS("Du schlaegst die umliegenden Pflanzen zur Seite, um"
                + " ungehindert ans Flechtwerk zu kommen. Du beginnst nach"
                + " Leibeskraeften daran zu ziehen, und auf einmal loest sich"
                + " mit einem Ruck das gesamte Flechtwerk. Am unteren Ende"
                + " baumelt gut befestigt ein Stein, den Du auspackst.")
                );
         say(BS(TPN + " schlaegt die umliegenden Pflanzen zur Seite und"
              + " beginnt an einer Pflanze zu zerren, die sich ploetzlich"
              + " mit einem Rueckloest. An deren unterem Ende baumelt etwas,"
              + " das " + TPN + "auspackt.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Du schlaegst die umliegenden Pflanzen zur Seite, um"
                + " ungehindert ans Flechtwerk zu kommen. Du beginnst nach"
                + " Leibeskraeften daran zu ziehen, und auf einmal loest sich"
                + " mit einem Ruck das gesamte Flechtwerk. Du durchsucht die"
                + " Umgebung des Flechtwerks genau, doch kannst Du nichts"
                + " entdecken.")
                );
         say(BS(TPN + " schlaegt die umliegenden Pflanzen zur Seite und"
              + " beginnt an einer Pflanze zu zerren, die sich ploetzlich"
              + " mit einem Rueck loest. " + TPN + " durchsucht die Ueberreste"
              + " der Pflanze und das Loch, das sie hinterlassen hat, wendet"
              + " sich dann aber enttaeuscht ab.")
              );

         return 1;   
      }
   }
   
   return 0;
}

int greifIn(string str)
{
   string str1;

   notify_fail( "Wo moechtest Du hineingreifen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "in %s",str1) != 1)
   	return 0;
   
   
   /*** greif in Hohlraum (Versteck 0) ***/
   if (str1 == "hohlraum" || str1 == "hohlraeume")
   {
      /* Checken, ob Falle ausloesen soll */
      if(checkTrap()) 
         return 1;
      
      if(FT_QUESTITEM && versteck == WURZEL && (!FT_STONE("\nft_stein_2")) )
      {
         write(BS("Hastig und etwas furchtsam greifst Du in den Hohlraum,"
                + " immer an die zahlreichen Fallen denkend, von denen Du"
                + " gelesen hast. Deine Hand wandert im Hohlraum hinter den"
                + " Wurzeln suchend umher und findet schliesslich einen Stein,"
                + " den Du mit der Hand umschliesst und herausziehest.")
                );
         say(BS(TPN + " greift in den Hohlraum hinter den Wurzeln und sieht"
              + " dabei etwas furchtsam aus - wahrscheinlich wegen der Fallen."
              + " " + TPN + " findet schliesslich einen Stein und zieht ihn"
              + " heraus.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Hastig und etwas furchtsam greifst Du in den Hohlraum,"
                + " immer an die zahlreichen Fallen denkend, von denen Du"
                + " gelesen hast. Deine Hand wandert im Hohlraum hinter den"
                + " Wurzeln suchend umher. Du suchst und suchst, kannst aber"
                + " nichts finden.")
                );
         say(BS(TPN + " greift in den Hohlraum hinter den Wurzeln und sieht"
              + " dabei etwas furchtsam aus - wahrscheinlich wegen der Fallen."
              + " " + TPN + " sucht und sucht, kann aber nichts finden.")
              );
              
         return 1;   
      }
   }
   
   /*** greif in Loch (Versteck 4) ***/
   if (str1 == "loch")
   {
      /* Checken, ob Falle ausloesen soll */
      if(checkTrap()) 
         return 1;
      
      if(FT_QUESTITEM && versteck == LOCH && (!FT_STONE("\nft_stein_2")) )
      {
         write(BS("Du kletterst ein wenig auf den Stamm des Baumes vor Dir"
                + " und greifst in das Loch, das von einem kleinen Nager"
                + " stammt. Sofort spuerst Du, dass sich darin etwas verbirgt,"
                + " umfasst es und ziehst es heraus. Du haeltst einen Stein in"
                + " Deinen Haenden.")
                );
         say(BS(TPN + " klettert ein wenig auf den Baum, greift in ein"
              + " Loch und zieht die Hand sofort wieder heraus."
              + " " + TPN + " haelt etwas in der Hand.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Du kletterst ein wenig auf den Stamm des Baumes vor Dir"
                + " und greifst in das Loch, das von einem kleinen Nager"
                + " stammt. Sofort erkennst Du, dass das Loch leer ist.")
                );
         say(BS(TPN + " klettert ein wenig auf den Baum, greift in ein"
              + " Loch und zieht die Hand sofort wieder heraus, ohne etwas"
              + " gefunden zu haben.")
              );
              
         return 1;   
      }
   }
   
   return 0;
}
