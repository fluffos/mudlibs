/*
** A1 - Raum auf dem Weg zur Haengebruecke
** 23.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Irgendwo am Trampelpfad im Dschungel" );
   SetProp(P_INT_LONG,
      "Dich umgibt nur dichter Dschungel. Das Blaetterdach ist hier"
      " so dicht, dass Du schon fast eine Lichtquelle brauchst, um"
      " Dich zu orientieren. Du erfuehlst den Pfad mehr, als Du ihn"
      " siehst. Dennoch arbeitest Du Dich weiter vor."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du kannst den Himmel von hier nicht sehen, denn die Vegetation"
    + " ist zu dicht."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig. "
      );      
   AddDetail( ({"pflanze","pflanzen","vegetation","blaetterdach","blaetter"}),
      "Die Pflanzen wuchern wie wild um Dich. Hier waere eine Machete"
    + " wirklich von Vorteil, um schneller voranzukommen. Die Pflanzen"
    + " wirken auf Dich wie eine Mauer, die undurchdringlich ist."
      );
  AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Der Weg fuehrt Dich immer weiter in den Dschungel."
    + " Und obwohl Du erfahren bist, froestelt es Dich manchmal, wenn"
    + " Du daran denkst, was alles hinter diesen Pflanzen lauern koennte."
      );
   AddDetail( ({ "trampelpfad","pfad","weg" }),
      "Du kannst ihn von hier aus gerade noch durch all diese wuchernden"
    + " Pflanzen erkennen. Er ist nicht sehr breit, aber fuer Dich"
    + " reicht es gerade noch."
      );
   AddDetail( ({ "lichtquelle","licht","quelle" }),
      "Wenn Du hier mehr Licht haettest, koenntest Du sicher mehr"
    + " entdecken, wenn es etwas zu entdecken gaebe. So aber siehst"
    + " Du nur Blaetter, Pflanzen und immer nur gruen. Wenn das so"
    + " weitergeht, dann wirst Du noch verrueckt."
      );            
   AddDetail( ({ "machete" }),
      "Damit koenntest Du den Pfad erweitern. Aber derzeit ist es"
    + " gerade noch nicht notwendig."
      );            
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "vorteil","mauer" }),
      "Das ist voellig uninteressant."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );
      
   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach frischem Regen."
      );
   AddSmell( ({ "regen","boden" }),
      "Wie eben ein Boden nach einem Regen riecht."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "osten",     "./room_b1" );
   AddExit( "suedosten", "./room_b2" );
   AddExit( "sueden",    "./room_a2" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/