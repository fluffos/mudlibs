/*
** E2 - Raum auf dem Weg zum Tempel
** 22.09.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Im Dschungel" );
   SetProp(P_INT_LONG,
      "Du arbeitest Dich weiter in den Dschungel vor, teils mit erheblichen"
      " Muehen, denn die Pflanzen versperren Dir immer wieder den Weg. Vor"
      " allem die niedrigen Bodengewaechse hindern Dich am raschen Vorankommen"
      " in dieser gruenen Hoelle."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden","pfad" }),
      "Der Boden besteht aus gestgestampfter Erde, denn Du stehst ja auf"
    + " einem Pfad. Rings um den Weg wuchern Pflanzen."
      );      
   AddDetail( ({ "erde" }),
      "Was soll man dazu sagen...einfach festgestampfte Erde."
      );
   AddDetail( ({"pflanze","pflanzen"}),
      "Die Pflanzen versperren Dir immer wieder den Weg, so"
    + " dass Du ueber sie klettern oder unter ihnen durchzwaengen musst."
    + " Woody-sei-Dank hast Du heute nicht Deinen Sonntagsanzug an."
      );
   AddDetail( ({ "sonntagsanzug","anzug" }),
      "Den Dir Deine Mutti noch gekauft hat."
      );
   AddDetail( ({ "mutti","mutter" }),
      "Du weisst nicht, wer Deine Mutter ist? Armer Tropf!"
      );      
   AddDetail( ({ "tropf" }),
      "Du eben."
      );      
   AddDetail( ({ "dschungel","hoelle" }),
      "Du glaubst, Du bewegst Dich schon ewig durch diese gruene, schwuele"
    + " Hoelle."
      );
   AddDetail( ({ "weg" }),
      "Der Weg kommt aus dem Sueden und fuehrt weiter nach Osten und"
    + " und Suedosten."
      );
   AddDetail( ({ "bodengewaechse","bodengewaechs","gewaechse","gewaechs" }),
      "Die Pflanzen bedecken fast den gesamten Boden. Mit ihren Luftwurzeln"
    + " und Ranken wollen sie Dich fast wie Fangarme festhalten. Du hast"
    + " etliche Muehe, Dich da durchzukaempfen."
      );
   AddDetail( ({ "luftwurzeln","luftwurzel","wurzeln","wurzel",
                  "ranken","ranke","fangarme","fangarm","arme","arm" }),
      "Sie schlaengeln sich ueber den gesamten Weg und erschweren ein"
    + " Weiterkommen erheblich. Du findest es nur eigenartig, dass sie"
    + " an einer Stelle massierter als rundherum auftreten."
      );      
   AddDetail( ({ "stelle" }),
      "Du bueckst Dich, um mehr sehen zu koennen. Und Du hattest Recht,"
    + " die Ranken sind hier dichter als rundherum. Vorsichtig schiebst"
    + " Du einen Stock zwischen den Ranken durch und erkennst, dass der"
    + " Weg sich hinter diesem Rankengeflecht fortsetzt. Du seufzst und"
    + " erhebst Dich wieder."
      );            
   AddDetail( ({ "stock" }),
      "Den benutzt Du, um die Ranken wegzuschieben."
      );
   AddDetail( ({ "rankengeflecht","geflecht" }),
      "Es ist sehr verflochten und ineinander verwoben, allerdings"
    + " koenntest Du vielleicht hindurchkriechen."
      );            
   AddDetail( ({ "muehen","muehe","schwitzen","weiterkommen" }),
      "Ja, das ist muehsam, sich durch den Dschungel zu kaempfen."
    + " Du kommst immer mehr ins Schwitzen."
      );      
   AddDetail( ({ "vorankommen" }),
      "Du kommst nur muehsam voran."
      );    
        
   AddSpecialDetail( ({ "dank" }), "dankWoody");
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","osten","suedosten","sueden","recht" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "kriech","krieche" }), "kriecheDurchGeflecht" );
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "osten",     "./room_f2" );
   AddExit( "suedosten", "./room_f3" );
   AddExit( "sueden",    "./room_e3" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int dankWoody()
{
   write(BS("Du faellst auf Deine Knie und beginnst Woody fuer seinen"
          + " Grossmut zu danken. Immer und immer wieder beschwoerst Du"
          + " seine Gnade, dass er Dich auf dem weiteren Weg nicht"
          + " verlaesst.")
          );
   write(BS("Woody scheint Dich zu erhoeren und schenkt Dir neue Kraft."));
   TP->AddHp(5);             
   return 1;
}

int kriecheDurchGeflecht(string str)
{
   string str1;
      
   notify_fail( "Wo moechtest Du hindurchkriechen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "durch %s",str1) != 1)
   	return 0;
   
   if( str1 == "geflecht" || str1 == "rankengeflecht")
   {
      write(BS("Du bueckst Dich, gehst auf Deine Knie und beginnst"
             + " Dich langsam durch das dichte Geflecht durchzuschieben."
             + " Muehsam kommst Du voran, immer wieder hindern Dich"
             + " querliegende Ranken. Du beginnst heftiger zu schwitzen,"
             + " die Anstrengung laesst Dein Gesicht rot anlaufen. Doch"
             + " die Muehen lohnen sich, als Du nach langen Minuten auf"
             + " der anderen Seite das Dockicht wieder verlaesst.")
             );
      say(BS(TPN + "bueckt sich, gehst auf die Knie und beginnt"
             + " sich langsam durch das dichte Geflecht durchzuschieben."
             + " " + TPN + " kommt muehsam voran, immer wieder versperren"
             + " querliegende Ranken " + TPN + " den Weg. " + TPN + " beginnt"
             + " heftig zu schwitzen, doch die Muehen lohnen sich, als Du"
             + " " + TPN + " nach langen Minuten im Dickicht verschwinden"
             + " siehst.")
             );
      TP->move(FT_ROOM("room_e1"),M_GO,
                  "durch das dichte Geflecht",
                  "kriecht","kriecht durch das dichte Geflecht herein"
                  );       
      return 1;   
   }
   
   return 0;
}
