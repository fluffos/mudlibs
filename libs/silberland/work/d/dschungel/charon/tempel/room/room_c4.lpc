/*
** C4 - Lichtung suedlich der Haengebruecke
** 28.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Lichtung suedlich der Haengebruecke" );
   SetProp(P_INT_LONG,
      "Du stehst an einer hellen Lichtung am Rande einer tiefen Schlucht." 
      " Im Norden kannst Du noch die Ueberreste der Haengebruecke erkennen,"
      " die Du zuvor gesehen hast. Der Abgrund vor Dir scheint unendlich"
      " tief zu sein, aber Du weisst, dass Dich Deine Sinne taeuschen."
      " Allerdings wird Dir schon mulmig, wenn Du daran denkst, dass Dich"
      " jemand hinunterschubsen wuerde. Du machst schnell ein paar Schritte"
      " zurueck vom Rand der Schlucht."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "lichtung" }),
      "Du stehst auf einer Lichtung mitten im Dschungel. Hinter Dir"
    + " erkennst Du den Pfad, auf dem Du hierher gekommen bist."
      );
   AddDetail( ({ "himmel" }),
      "Du siehst endlich wieder den blauen Himmel ueber Dir und atmest"
    + " erleichtert auf."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig."
      );      
   AddDetail ( ({"pflanze","pflanzen"}),
      "Du erkennst hinter Dir riesige, gruene Pflanzen, von denen einige"
    + " sicher giftig sind."
      );   
   AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Der Dschungel ist nicht weit weg, denn er beginnt gleich hinter"
    + " Dir. Die schwuele Hoelle macht Dir ganz schoen zu schaffen, und"
    + " Du waerest froh, wenn Du dieses Gebiet sofort wieder verlassen"
    + " koenntest."
      );
   AddDetail( ({ "schlucht","abgrunds","abgrunds","tiefe" }),
      "Vor Dir faellt der Boden senkrecht in die Tiefe, und Du meinst,"
    + " dass Du den Grund des Tales gar nicht erblicken kannst. Nur"
    + " unscharf erkennst Du den Grund, bist Dir aber nicht sicher, ob"
    + " Du Dich nicht taeuscht."
      );
   AddDetail( ({ "grund" }),
      "Der Grund liegt so weit unter Dir, dass Du ihn nicht mit blossem"
    + " Auge erkennen kannst."
      );
   AddDetail( ({ "pfad","trampelpfad" }),
      "Der gewundene Pfad endet hier auf dieser Lichtung und fuehrt"
    + " nur zurueck nach Norden."
      );
   AddDetail( ({ "bruecke","haengebruecke","bauwerk","kunstwerks",
                 "kunstwerk","werk" }),
      "Dieses ehemals imposante Bauwerk befindet sich etwas weiter"
    + " noerdlich, aber Du kannst es von hier aus noch gut erkennen."
    + " Du siehst, dass die Bruecke von einem Ende der Schlucht zum"
    + " anderen reicht. Du koenntest ja die Bruecke benutzen, um auf"
    + " die andere Seite zu kommen." 
      );
   AddDetail( ({ "ueberreste","ueberrest","reste","rest" }),
      "Etwas weiter noerdlich kannst Du die traurigen Ueberreste einer"
    + " ehemals stolzen und praechtigen Bruecke erkennen. Du bewunderst"
    + " die Fertigkeit der Baumeister dieses architektonischen Kunstwerks"
    + " und fragst Dich, wie sie es fertiggebracht haben, ein solches"
    + " Bauwerk ueber die Schlucht zu bauen."
      );
   AddDetail( ({ "baumeister","meister","baumeisters" }),
      "Ja, sie waren wirklich Meister ihres Faches."
      );    
   AddDetail( ({ "faches","fach" }),
      "Meister im Brueckenbauen, Du Ignorant!"
      );      
  AddDetail( ({ "brueckenbauen" }),
      "Dir ist nicht zu helfen!"
      );            
   AddDetail( ({ "ignorant" }),
      "Du bist ein Ignorant."
      );      
   AddDetail( ({ "seite","ende" }),
      "Das andere Ende der Bruecke koennte auch noch weiter weg sein -"
    + " fuer Dich wuerde das keinen Unterschied machen."
      );         
   AddDetail( ({ "fertigkeit" }),
      "Nun ja, wie soll man das erklaeren? Die Fertigkeit eines Baumeisters"
    +" drueckt sich in seinen Bauwerken aus."
      );         
      
   AddDetail( ({ "rande","rand" }),   
      "Du begibst Dich gefaehrlich nahe an den Rand des Abgrunds, nur um"
    + " hinunterblicken zu koennen. Doch leider wirst Du enttaeuscht."
    + " Auch wenn Du Dich noch so weit vorbeugst, Du kannst nicht mehr"
    + " erkennen, als dass es sehr steil bergab geht."
      );
   AddDetail( ({ "schritte","schritt" }),   
      "Dir wird ziemlich unwohl, als Du so nah am Abgrund stehst."
    + " Solltest Du vielleicht doch Hoehenangst haben?"
      );
   AddDetail( ({ "hoehenangst","angst" }),   
      "Es sieht danach aus, als ob Du in letzter Zeit empfindlicher"
    + " auf grosse Hoehen reagierst, doch Du kannst es Dir nicht"
    + " erklaeren, warum dies so ist."
      );
   AddDetail( ({ "hoehen","hoehe" }),   
      "Du stehst ziemlich weit ueber dem Grund der Schlucht."
      );
   AddDetail( ({ "tales","tal" }),   
      "Das Tal, welches eigentlich wunderschoen ist, wie Du bemerkst,"
    + " erstreckt sich zu Deinen Fuessen soweit Dein Auge reicht, von"
    + " Norden nach Sueden. Du wirst Dir etwas einfallen lassen muessen,"
    + " um auf die andere Seite zu kommen."
      );

      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "auge","sinne","sache","fuessen","fuesse","zeit",
                 "unterschied" }),
      "Das tut hier nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Du wirst muede, einschlafen und in die Schlucht stuerzen,"
    + " wenn Du noch weiter hinhoerst."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***

   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden", "./bridge_west" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/