/*
** E1 - Raum auf dem Weg zum Tempel
** 23.09.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Hinter einem dichten Wurzelgeflecht" );
   SetProp(P_INT_LONG,
      "Nachdem Du Dich muehevoll durch das Geflecht im Sueden gekaempft"
      " hast, lichtet sich der Dschungel hier wieder - nicht dass Du jetzt"
      " weit sehen koenntest, aber mehr als vorhin unter dem Geflecht. Der"
      " Weg macht hier eine Biegung und fuehrt Dich tiefer in den Dschungel"
      " hinein."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden","pfad" }),
      "Der Boden besteht aus gestgestampfter Erde, denn Du stehst ja auf"
    + " einem Pfad. Rings um den Weg wuchern Pflanzen."
      );      
   AddDetail( ({ "erde" }),
      "Was soll man dazu sagen...einfach festgestampfte Erde."
      );
   AddDetail( ({ "pflanze","pflanzen" }),
      "Die Pflanzen umgeben Dich wie ein lebendiges Wesen. Du glaubst"
    + " manchmal zu spueren, wie sich Augen in Deinen Ruecken bohren -"
    + " das kann allerdings auch Einbildung sein."
      );
   AddDetail( ({ "wesen" }),
      "Der Dschungel scheint zu atmen und zu leben."
      );            
   AddDetail( ({ "augen" }),
      "Du fuehlst Dich beobachtet."
      );            
   AddDetail( ({ "einbildung" }),
      "Das ist das, was man zu sehen glaubt, obowhl es nicht da ist."
    + " Oder aber vielleicht ist es ja doch da, aber man sieht es nur nicht..."
      );            
   AddDetail( ({ "ruecken" }),
      "Auch ein schoener Ruecken kann entzuecken."
      );            
   AddDetail( ({ "dschungel","hoelle" }),
      "Der Dschungel ist allgegenwaertig und umgibt Dich von allen Seiten."
    + " Und wie es aussieht, wird das noch laengere Zeit so bleiben."
      );
   AddDetail( ({ "weg" }),
      "Der Weg setzt sich hier hinter dem Rankengeflecht fort und macht"
    + " einen Biegung nach Westen."
      );
   AddDetail( ({ "biegung" }),
      "Der Pfad beschreibt hier eine sanfte Biegung nach Westen. Dahinter"
    + " wird der Dschungel wieder ein wenig dichter."
      );            
   AddDetail( ({ "rankengeflecht","geflecht" }),
      "Das Rankengeflecht liegt nun suedlich hinter Dir. Es ist ziemlich"
    + " dicht und es wundert Dich jetzt noch, dass Du den Durchgang entdeckt"
    + " hast."
      );            
   AddDetail( ({ "durchgang","gang" }),
      "Der Durchgang durch das Rankengeflecht ist gut versteckt, aber da Du"
    + " ja nun weisst, wo er ist, ist es leicht fuer Dich, ihn wiederzufinden."
    + " Aber die Kriecherei bleibt Dir wohl nicht erspart..."
      );      
   AddDetail( ({"kriecherei"}),
      "Anders wirst Du das Rankengeflecht nicht ueberwinden koennen."
      );      
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","sueden","westen","seiten","zeit" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "kriech","krieche" }), "kriecheDurchGeflecht" );
      
   /*** Items ***/

   /*** Exits ***/

   AddExit( "westen", "./room_d1" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int kriecheDurchGeflecht(string str)
{
   string str1;
      
   notify_fail( "Wo moechtest Du hindurchkriechen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "durch %s",str1) != 1)
   	return 0;
   
   if( str1 == "geflecht" || str1 == "rankengeflecht")
   {
      write(BS("Du bueckst Dich, gehst auf Deine Knie und beginnst"
             + " Dich langsam durch das dichte Geflecht durchzuschieben."
             + " Muehsam kommst Du voran, immer wieder hindern Dich"
             + " querliegende Ranken. Du beginnst heftiger zu schwitzen,"
             + " die Anstrengung laesst Dein Gesicht rot anlaufen. Doch"
             + " die Muehen lohnen sich, als Du nach langen Minuten auf"
             + " der anderen Seite das Dockicht wieder verlaesst.")
             );
      say(BS(TPN + "bueckt sich, gehst auf die Knie und beginnt"
             + " sich langsam durch das dichte Geflecht durchzuschieben."
             + " " + TPN + " kommt muehsam voran, immer wieder versperren"
             + " querliegende Ranken " + TPN + " den Weg. " + TPN + " beginnt"
             + " heftig zu schwitzen, doch die Muehen lohnen sich, als Du"
             + " " + TPN + " nach langen Minuten im Dickicht verschwinden"
             + " siehst.")
             );
      TP->move(FT_ROOM("room_e2"),M_GO,
                  "durch das dichte Geflecht",
                  "kriecht","kriecht durch das dichte Geflecht herein"
                  );       
      return 1;   
   }
   
   return 0;
}