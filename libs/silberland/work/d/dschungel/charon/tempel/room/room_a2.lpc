/*
** A2 - Raum auf dem Weg zur Haengebruecke
** 23.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Am Trampelpfad im Dschungel" );
   SetProp(P_INT_LONG,
      "Du bewegst Dich am Trampelpfad immer weiter in den Dschungel"
      " in den Dschungel hinein. Obwohl Du das fuer nicht moeglich"
      " gehalten hast, wird die Vegetation immer dichter. Du moechtest"
      " den Weg lieber nicht verlassen, und das ist auch besser so."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst nichts ausser Pflanzen ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig."
      );      
   AddDetail( ({"pflanze","pflanzen","vegetation"}),
      "Die Pflanzen werden immer dichter und versperren Dir schon"
    + " fast den Weg, so, als ob sie Dich zurueckhalten wollen. Wenn"
    + " das so weitergeht, und Du Deinen Weg fortsetzen willst, wirst"
    + " Du eine Machete brauchen."
      );
  AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Vor Dir breitet sich die schwuele, gruene Hoelle aus. Du hast den"
    + " Dschungel bald satt, aber noch willst Du nicht aufgeben."
      );
   AddDetail( ({ "machete","hilfsmittel","mittel" }),
      "Wohl eines der wenigen Hilfsmittel, mit dem man dem Dschungel Herr"
    + " werden kann."
      );
   AddDetail( ({ "trampelpfad","pfad","weg" }),
      "Du folgst dem Pfad nun schon seit einiger Zeit, und er fuehrt"
    + " Dich immer weiter in den Dschungel hinein."
      );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "zeit","herr" }),
      "Das ist voellig uninteressant."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden",     "./room_a1" );
   AddExit( "nordosten",  "./room_b1" );
   AddExit( "osten",      "./room_b2" );
   AddExit( "sueden",     "./room_a3" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/