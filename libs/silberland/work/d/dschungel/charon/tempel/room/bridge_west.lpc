/*
** Haengebruecke diesseits - Platz am dieseitigen Ende der zerstoerten Haengebruecke
** 21.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Lichtung an einer tiefen Schlucht" );
   SetProp(P_INT_LONG,
      "Du stehst an einer hellen Lichtung am Rande einer tiefen Schlucht." 
      " Hinter Dir scheint der Dschungel den schmalen Trampelpfad, der Dich"
      " zu dieser Stelle gefuehrt hat, zu verschlucken und Du bist froh, den"
      " blauen Himmel ueber Dir zu sehen. Vor Dir spannt sich eine gewaltige"
      " Haengebruecke bzw. das, was noch von ihr uebrig ist, ueber die"
      " Schlucht."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "lichtung" }),
      "Du stehst auf einer Lichtung mitten im Dschungel. Hinter Dir"
    + " erkennst Du den Pfad, auf dem Du hierher gekommen bist."
      );
   AddDetail( ({ "himmel" }),
      "Du kannst den klaren, blauen Himmel ueber Dir erkennen und atmest"
    + " auf, dass Du dieser gruenen Hoelle entkommen bist. Denn eigentlich"
    + " hasst Du den Dschungel."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig."
      );      
   AddDetail ( ({"pflanze","pflanzen"}),
      "Du erkennst riesige, gruene Pflanzen, von denen einige sicher"
    + " giftig sind."
      );   
   AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Du hast gerade die schwuele, gruene Hoelle hinter Dir gelassen und"
    + " bist sehr froh darueber, denn man weiss ja nie, welche"
    + " Ueberraschungen der Dschungel fuer einen bereithaelt."
      );
   AddDetail( ({ "ueberraschung","ueberraschungen" }),
      "Was lauert wohl sonst noch alles im Dschungel?"
      );
   AddDetail( ({ "schlucht" }),
      "Die Schlucht ist so tief, dass Deine Blicke nicht den Grund des"
    + " Tales erfassen koennen. Du spuerst, wie Dein Mund trocken wird."
      );
   AddDetail( ({ "grund" }),
      "Der Grund liegt so weit unter Dir, dass Du ihn nicht mit blossem"
    + " Auge erkennen kannst."
      );
   AddDetail( ({ "pfad","trampelpfad" }),
      "Der gewundene Pfad fuehrt noch ein Stueck weiter nach Sueden."
      );
   AddDetail( ({ "bruecke","haengebruecke","bauwerk","bauwerks" }),
      "Du stehst vor den traurigen Ueberresten einer ehemals gewaltigen"
    + " Haengebruecke. Doch von diesem stolzen Bauwerk ist nicht mehr"
    + " viel zu sehen, denn die Zeit hat ihre Spuren hinterlassen. Von den"
    + " Holzbohlen sind saemtliche vermodert, einzig das ueber die Schlucht"
    + " gespannte Seil sieht noch einigermassen intakt aus."
      );
   AddDetail( ({ "ueberreste","rest","reste","spur","spuren" }),
      "Die klaeglichen Ueberreste dieses imposanten Bauwerks sind ein paar"
    + " ziemlich morsche Holzbohlen, die wohl frueher den Gehbelag der"
    + " Bruecke dargestellt haben, und das Tragseil, an dem dieser Gehbelag"
    + " aufgehaengt war. Letzteres scheint noch in gutem Zustand zu sein."
      );
   AddDetail( ({ "holzbohlen","bohlen","holzbohle","bohle","gehbelag" }),
      "Sie Bohlen sind, wo noch vorhanden, ziemlich morsch und vermodert"
    + " und wuerden Dich keinesfalls sicher ueber die Schlucht bringen."
      );
   AddDetail( ({ "seil","tragseil" }),
      "Das Seil spannt sich ueber die gesamte Schlucht und verbindet somit"
    + " beide Seiten. Es sieht zudem noch ziemlich intakt aus und koennte"
    + " Dich durchwegs tragen. Aber die Laenge des Seils erschreckt Dich"
    + " dann doch, als Du versuchst, Dich daran hinueberzuhangeln."
    + " Du wirst also nicht hinueberklettern koennen."
      );
   AddDetail( ({ "laenge" }),
      "Das Seil ist sehr lang, aber fest und muesste Dich eigentlich tragen."
    + " Doch muss es eine andere Art geben, um auf die andere Seite zu"
    + " kommen, als sich daran hinueberzuhangeln. Dies ist zu anstrengend,"
    + " wie Du bereits festgestellt hast."
      );
   AddDetail( ({ "seite","seiten" }),
      " Die andere Seite der Schlucht ist weit entfernt. Du kannst sie"
    + " nicht durch Springen erreichen, was aber Dir aber sowieso klar war."
    + " Also muss es eine andere Moeglichkeit geben."
      );      
   AddDetail( ({ "springen" }),
      "Springen kannst Du nicht auf die andere Seite."
      );      
   AddDetail( ({ "moeglichkeit" }),
      "Du musst nur scharf nachdenken. Wie kann man eine Schlucht noch"
    + " ueberqueren? Springen, klettern und ...?"
      );      
   AddDetail( ({ "tal","tales" }),
      "Das Tal ist sehr breit und tief. Es wird nicht einfach werden,"
    + " es zu ueberwinden."
      );      
   AddDetail( ({ "zeit" }),
      "Die Zeit hat ihre Spuren in die Ueberreste der Bruecke gegeraben."
      );      
   AddDetail( ({ "spur","spuren" }),
      "Die Zeit hat der Bruecke stark zugesetzt, aber das Seil sieht"
    + " noch intakt aus."
      );      
   AddDetail( ({ "zustand" }),
      "Der Zustand des Seiles ist sehr vertrauenerweckend, was man von"
    + " der uebrigen Bruecke nicht sagen kann."
      );      
   AddDetail( ({ "rand","rande","abgrund","abhang" }),
      "Du stehst genau vor dem Abgrund und beugst Dich leicht vor, damit"
    + " Du hinunterschauen kannst. Dich ueberkommen sofort Schwindelgefuehle,"
    + " denn Du bemerkst, dass Du den Boden der Schlucht nicht erkennen"
    + " kannst. Allerdings siehst Du etliche Meter unter Dir zerbrochene"
    + " Astgabeln am Abhang liegen."
      );      
   AddDetail( ({ "astgabeln","astgabel","ast","aeste" }),
      "Du kannst sie nicht erreichen, aber Du erkennst, dass sie"
    + " zerbrochen sind. In Dir beginnt sich eine Idee zu manifestieren,"
    + " wie man die Schlucht ueberwinden koennte."
      );      
   AddDetail( ({ "idee","hilfe" }),
      "Mit Hilfe einer solchen Astgabel koennte man den Abgrund vielleicht"
    + " ueberwinden."
      );      
   AddDetail( ({ "art" }),
      "Du musst Dich schon mehr anstrengen, um hinueberzukommen."
      );      
   AddDetail ( ({"schwindelgefuehle","schwindelgefuehl","gefuehl"}),
      "Blick nicht zu lange in den Abgrund."
      );   
   AddDetail( ({ "stelle" }),
      "Du stehst darauf."
      );
   AddDetail( ({ "blatt","blaetter" }),
      "So wie ueberall im Dschungel bist Du nahezu eingeschlossen von"
    + " gruenen Blaettern und Bambus. Du solltest Dich schon daran gewoehnt"
    + " haben."
      );
   AddDetail( ({ "bambus" }),
      "Der Bambus ist hier gleich wie ueberall im Dschungel."
      );
            
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "blick","blicke","mund","auge","meter","sache",
                 "stueck","sueden" }),
      "Das tut hier nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Du wirst muede, einschlafen und in die Schlucht stuerzen,"
    + " wenn Du noch weiter hinhoerst."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "rutsch","rutsche" }), "ueberquereSchlucht" );

   /*** Items ***/

   /*** Exits ***/
   AddExit( "sueden", "./room_c4" );
   AddExit( "westen", "nach Westen in den Dschungel#./room_b3" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int ueberquereSchlucht(string str)
{
   object astgabel;
   string dest;
   int damage;
      
   notify_fail( "Worueber willst Du rutschen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "ueber %s",dest) != 1)
   	return 0;
   
   if( dest == "schlucht" || dest == "tal" || dest == "seil")
   {
      if (astgabel = deep_present("ft_astgabel", TP))
      {
         write(BS("Du rutscht mit Hilfe der Astgabel ueber die Schlucht.\n"));
                  
         TP->move(FT_ROOM("bridge_east"),M_GO,
                  "das Seil und ueberwindet damit den Abgrund",
                  "benutzt","laesst die Astgabel los und landet auf dem Boden"
                  );
         
         /*** Astgabel nach Verwendung zerstoeren ***/         
         write(BS("Durch die grosse Hitzeentwicklung waehrend des Rutschens"
            + " zerbricht Dir die Astgabel.\n")
               );
         say(BS("Durch die grosse Hitzeentwicklung waehrend des Rutschens"
            + " zerbricht " + TPN + " die Astgabel.\n")
               );               
         astgabel->remove();
         if (astgabel) destruct(astgabel);

         /*** Schaden bei ungenuegender Geschicklichkeit ***/
         damage = 12 - TP->QueryAttribute(A_DEX);
         if (damage > 0)
         {
            write(BS("Durch Deine Ungeschicklichkeit beim Aufsprung"
               + " verstauchst Du Dir den Knoechel.\n")
                  );
            say(BS("Durch den ungeschickten Aufsprung verstaucht sich " 
               + TPN + " den Knoechel.\n")
                  );                  
            TP->AddHp(-3*damage);
          }  
         
         return 1;
      }
      else
      {
         write(BS("Du versuchst, mit Deinen blossen Haenden das Seil"
            + " umklammert, rutschend die Schlucht zu ueberqueren."
            + " Du kommst auch einige Meter weit, aber dann werden Deine"
            + " Haende so heiss, dass Du beschliesst zurueckzuklettern."
            + " Das tust Du dann auch, aber Deine brennenden Haende"
            + " schmerzen fuerchterlich. Du wirst wohl ein Hilfsmittel"
            + " brauchen.\n")
               );
         say(BS(TPN + " versucht mit blossen Haenden das Seil zu"
            + " ueberqueren und verbrennt sich dabei fuerchterlich die"
            + " Haende. "+ TPN + " schaut sich suchend nach einem"
            + " Hilfmittel um.\n")
            );

         TP->AddHp(-10);

         return 1;
      }
   }
   return 0;
}
