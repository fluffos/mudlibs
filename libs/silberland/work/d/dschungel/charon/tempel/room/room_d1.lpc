/*
** D1 - Raum auf dem Weg zum Tempel
** 23.09.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int steinplatte = 0;
int loch        = 0;

reset()
{
   RemoveExit("unten");
   RemoveDetail("metallring");
   steinplatte = 0;
   loch        = 0;
   
   ::reset();   
}

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Im Dschungel" );
   SetProp(P_INT_LONG,
      "Du gehst langsam den Pfad entlang und folgst der sanften Biegung."
      " Du hast es nicht fuer moeglich gehalten, aber es wird noch"
      " bedrohlicher. Der Pfad findet einige Meter vor Dir ein abruptes"
      " Ende."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Der Boden besteht aus gestgestampfter Erde, denn Du stehst ja auf"
    + " einem Pfad. Rings um den Weg wuchern Pflanzen."
      );      
   AddDetail( ({ "pflanzen","pflanze" }),
      "Sie sind sehr dicht und ueberragen Dich weit."
      );            
   AddDetail( ({ "erde" }),
      "Was soll man dazu sagen...einfach festgestampfte Erde."
      );
   AddDetail( ({ "pfades","pfad","weges","weg" }),
      "Du bist dem Pfad gefolgt, doch nun stehst Du vor dem Ende des Weges."
    + " Du blickst Dich um, kannst aber nirgends eine Fortsetzung des Pfades"
    + " sehen."
      );      
   AddDetail( ({ "biegung" }),
      "Der Weg beschreibt hier eine sanfte Biegung."
      );            
   AddDetail( ({ "ende","fortsetzung" }),
      "Der Weg fuehrt nicht mehr weiter durch den Dschungel, denn"
    + " scheinbar ist das hier ein 'Sackpfad'."
      );      
   AddDetail( ({ "sackpfad" }),
      "Aehnlich einer Sackgasse fuehrt auch ein Sackpfad nicht mehr weiter."
    + " Etwas verwirrt blickst Du Dich um und entdeckst - mehr zufaellig -"
    + " am Boden eine Unebenheit."
      );      
   AddDetail( ({ "sackgasse","gasse" }),
      "Eine Gasse, die abrupt endet - solltest Du doch kennen."
      );      
      
   AddDetail( ({ "unebenheit" }),
      "Von Pflanzen ueberwuchert entdeckst Du eine Steinplatte."
      );      
   AddDetail( ({ "steinplatte","stein","platte" }),
      "Du haettest die Steinplatte fast uebersehen, denn sie ist fast"
    + " gaenzlich von Pflanzen ueberwuchert. Um mehr zu sehen, wirst Du"
    + " sie wohl reinigen muessen."
      );      
   AddDetail( ({ "dschungel","hoelle" }),
      "Du befindest Dich noch immer in dieser tropischen Hoelle."
      );
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","meter" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "reinige","saeubere","saeuber" }), "reinigeSteinplatte" );
   AddCmd( ({ "hebe","heb" }), "hebeSteinplatte" );
         
   /*** Items ***/

   /*** Exits ***/
   AddExit( "osten", "./room_e1" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int reinigeSteinplatte(string str)
{
   string str1;
      
   notify_fail( "Was moechtest Du reinigen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s",str1) != 1)
   	return 0;
      
   if( str1 == "steinplatte" || str1 == "stein" || str1 == "platte")
   {
      /* Steinplatte wurde bereits gereinigt */
      if (steinplatte)
      {
         write(BS("Du hast die Steinplatte bereits gereinigt."));
         return 1;   
      }

      write(BS("Du laesst Dich auf die Knie nieder und beginnst wie ein"
             + " Wahnsinniger an den Pflanzen, die Dir den Weg versperren,"
             + " zu zerren. Stueck um Stueck legst Du die Platte frei, bis"
             + " sie letztendlich unbedeckt vor Dir liegt. Sofort faellt"
             + " Dir nun ein Metallring an der Steinplatte auf.")
             );
      say(BS(TPN + " kniet nieder und beginnt wie wild Pflanzen von der"
             + " Steinplatte zu reissen, bis sie voellig sichtbar ist.")
             );
             
      AddDetail( ({ "metallring","ring" }),
          "Der Metallring schimmert vor Deinen Augen. Nun, da Du ihn entdeckt"
        + " hast, sollte es ein leichtes sein, die Steinplatte anzuheben."
        );      
      steinplatte = 1;
            
      return 1;   
   }
   
   return 0;
}

int hebeSteinplatte(string str)
{
   string str1;
      
   notify_fail( "Was moechtest Du anheben?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s an",str1) != 1)
   	return 0;
      
   if (str1 == "steinplatte" || str1 == "stein" || str1 == "platte")
   {
      /* Platte noch nicht gereinigt */
      if (!steinplatte)
      {
         write(BS("Die Steinplatte ist sehr gut in den Boden eingelassen"
                + " und an der Seite sind keinerlei fugen, bei denen man"
                + " ansetzen koennte, um sie herauszuheben.")
               );   
             
         return 1;
      }
      
      /* Ausgang (loch nach unten) existiert bereits */
      if (loch)
      {
         write(BS("Aber Du hast die Steinplatte doch schon angehoben."));
         return 1;   
      }      
      
      write(BS("Du bueckst Dich, greifst nach dem Metallring und"
             + " beginnst, nach Leibeskraeften zu ziehen. Dein Kopf"
             + " laeuft wiederum rot an, doch die Platte scheint"
             + " unverrueckbar an ihrem Platz zu verharren. Als Du"
             + " gerade von ihr ablassen willst, hoerst Du ein sattes"
             + " Schmatzen, und die Platte loest sich mit einem Ruck"
             + " aus ihrer Halterung. Dein eigener Schwung wirft Dich"
             + " zurueck und Du setzt Dich unsanft auf Deinen Hosenboden.")
             );
      say(BS(TPN + " bueckt sich, greift nach einem Metallring und"
             + " beginnt, nach Leibeskraeften zu ziehen. Du meinst schon,"
             + " " + TP->Name(WESSEN) + " Kopf wuerde explodieren, so rot"
             + " laeuft er an, aber just in dem Moment, als " + TPN 
             + " aufgeben will ist ein lautes Schmatzen zu vernehmen, und die"
             + " Steinplatte loest sich aus ihrer Verankerung. " + TPN 
             + " wird vom eigenen Schwung unsanft auf den Hosenboden"
             + " geschmissen.")
             );
             
      AddExit( "unten", "./room_d2" );
      loch = 1; /* Ausgang existiert */
        
      return 1;   
   }
   
   return 0;
}
