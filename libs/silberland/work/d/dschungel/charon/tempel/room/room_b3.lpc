/*
** A3 - Raum auf dem Weg zur Haengebruecke
** 23.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Irgendwo am Trampelpfad im Dschungel" );
   SetProp(P_INT_LONG,
      "Du irrst noch immer durch den Dschungel, in der Hoffnung,"
      " endlich wieder eine Lichtung zu finden, wo Deine Augen"
      " sich entspannen koennen und endlich wieder andere Farben"
      " als gruen erkennen koennen. Hier ist wiederum nur dichte"
      " Vegetation um Dich, so wie Du es bisher gesehen hast."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du kannst den Himmel von hier nicht sehen, denn die Vegetation"
    + " ist viel zu dicht."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig. "
      );      
   AddDetail( ({"pflanze","pflanzen","vegetation"}),
      "Die Pflanzen sind ueberall um Dich herum. Wenn Du nicht bald,"
    + " etwas anderes siehst, dann wirst Du noch wahnsinnig."
      );
   AddDetail( ({ "trampelpfad","pfad","weg" }),
      "Du kannst den Trampelpfad von hier aus gerade noch durch all"
    + " diese wuchernden Pflanzen erkennen. Er ist nicht sehr breit,"
    + " aber fuer Dich reicht es gerade noch."
      );
   AddDetail( ({ "farben","farbe" }),
      "Du beginnst die Farbe 'gruen' zu hassen, aber alles um Dich"
    + " herum ist eben gruen, was Dich noch mehr in Rage bringt."
      );            
   AddDetail( ({ "malaria" }),
      "Sei froh, dass Du noch nicht erkrankt bist."
      );            
   AddDetail( ({ "lichtung" }),
      "Deine Augen weiten sich, als Du an eine sonnenueberflutete"
    + " Lichtung denkst. Aber was war das? Drang da nicht gerade ein"
    + " Lichtstrahl von Osten durch die dichte Vegetation?"
      );            
   AddDetail( ({ "lichtstrahl","licht","strahl" }),
      "Ja, er kam eindeutig von Osten."
      );     
   AddDetail( ({ "hoffnung" }),
      "Ja, hoffen darfst Du."
      );            
   AddDetail( ({ "augen" }),
      "Deinen Augen wuerde es guttun, wenn sie etwas anderes als gruen"
    + " sehen wuerden."
      );            
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "rage","berserker","blutrausch","osten" }),
      "Das ist voellig uninteressant."
      );
      
   /*** Special Details ***/          
   AddSpecialDetail( ({ "dschungel","hoelle","gebiet" }),
      "infectPlayerWithMalaria");
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );
      
   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach frischem Regen."
      );
   AddSmell( ({ "regen","boden" }),
      "Wie eben ein Boden nach einem Regen riecht."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden", "./room_b2" );
   AddExit( "osten",  "./bridge_west" );
   AddExit( "westen", "./room_a3" );

}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
string infectPlayerWithMalaria()
{
   if (deep_present("dmala", TP))  
      return(BS("Der Weg fuehrt Dich immer weiter in den Dschungel."
         + " Und Du fuehlst Dich elend, weil Dir heiss ist, Du schwitzt"
         + " wie ein Berserker im Blutrausch und Dir ist ein wenig schlecht."
         + " Wie Du weisst, bekommt man im Dschungel leicht Malaria."
         + " Du siehst gerade noch eine Stechmuecke von Deinem Arm"
         + " wegfliegen und denkst Dir: 'Was soll's, ich bin ja schon"
         + " infiziert.' ")
            );
   else    
   {
      CLONE("/d/dschungel/dante/weg/obj/dmala", TP);
    
      return(BS("Der Weg fuehrt Dich immer weiter in den Dschungel."
         + " Und Du fuehlst Dich elend, weil Dir heiss ist, Du schwitzt"
         + " wie ein Berserker im Blutrausch und Dir ist ein wenig schlecht."
         + " Wie Du weisst, bekommt man im Dschungel leicht Malaria."
         + " Du siehst gerade noch eine Stechmuecke von Deinem Arm"
         + " wegfliegen und denkst Dir: 'Hoffentlich habe ich nun nicht"
         + " Malaria...', doch Du wirst enttaeuscht, denn Du bist infiziert.")
            );
   }       
}