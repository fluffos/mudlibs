/*
** E4 - Raum auf dem Weg zum Tempel 
**      Entschaerfung fuer Falle bei Stein II ('drueck linke augenhoehle')
** 24.09.1999  V1.0  Charon@SL
** 09.11.1999  V1.1  Charon@SL   - Anpassung an neues Questitem
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "An einer Wegkreuzung" );
   SetProp(P_INT_LONG,
      "Der Pfad, dem Du folgst, verzweigt sich hier. Rings um Dich"
      " ragen die Urwaldriesen auf und vermitteln Dir ein Gefuehl"
      " der Nichtigkeit. Dieser Ort hier ist Dir unheimlich, und Du"
      " moechtest ihn moeglichst schnell verlassen."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "ort" }),
      "Du musst schon genauer sagen, was Du untersuchen willst."
      );      
   AddDetail( ({ "boden" }),
      "Der Boden besteht aus festgestampfter Erde, denn Du stehst ja auf"
    + " einem Pfad. Rings um den Weg wuchern monstroese Pflanzen. Als"
    + " Du Dich bueckst, um den Boden genauer zu betrachten, glaubst Du,"
    + " etwas wie ein Gesicht bei einem der Baeume gesehen zu haben."
      );      
  AddDetail( ({ "gesicht" }),
      "Du richtest Dich wieder auf und blickst Dich um, kannst aber nichts"
    + " erkennen - Du musst Dich getaeuscht haben."
      );
   AddDetail( ({ "pfad","hauptpfad","weg" }),
      "Der Hauptpfad fuehrt weiter in Richtung Nordosten und Osten, aber ein"
    + " schmaler Seitenpfad zweigt hier nach Sueden ab."
      );      
   AddDetail( ({"seitenpfad"}),
      "Der schmale Seitenpfad verschwindet in Richtung Sueden wieder im"
    + " dichter werdenden Dschungel."
      );      
   AddDetail( ({ "erde" }),
      "Was soll man dazu sagen...einfach festgestampfte Erde."
      );
   AddDetail( ({"pflanze","pflanzen","vegetation","finger"}),
      "Die Pflanzen sind mannshoch oder noch hoeher und recken sich"
    + " wie Finger gen Himmel, als ob sie sich gegen die Goetter verschworen"
    + " haetten."
      );
   AddDetail( ({ "goetter","goettern","woody","dusty" }),
      "Du solltest sie mittlerweile schon kennen - Woody und Dusty."
      );
   AddDetail( ({ "urwaldriesen","urwaldriese","riesen","riese","urwald" }),
      "Die maechtigen Baeume stehen rings um Dich. Scheinbar sind sie von"
    + " den Goettern erschaffen worden, zumindest erwecken sie den Anschein."
      );
   AddDetail( ({ "baeume","baum" }),
      "Sie sind wirklch sehr beeindruckend mit ihren gewaltigen Staemmen und"
    + " ausladenden Aesten."
      );
   AddDetail( ({ "aesten","aeste","ast" }),
      "Du kannst die Aeste nur von hier unten betrachten, daber beeindruckt"
    + " Dich auch schon."
      );
   AddDetail( ({ "staemmen","staemme","stamm" }),
      "Sie sind einfach beeindruckend - allein schon die Rinde ist fast"
    + " meterdick - und die Hoehe der Baeume laesst sich nur schwer schaetzen."
      );
   AddDetail( ({ "hoehe" }),
      "Gewaltig."
      );
   AddDetail( ({ "rinde" }),
      "Du betastest langsam die Rinde eines der Riesen und schluckst"
    + " ehrfuerchtig. Und dann bleiben Deine Finger an einer Stelle"
    + " haengen."
      );
   AddDetail( ({ "stelle" }),
      "Die betrachtest die Stelle genauer und erkennst, dass es sich dabei"
    + " um eine Schnitzerei handelt."
      );
   AddDetail( ({ "schnitzerei" }),
      "Die Schnitzerei muss schon sehr alt sein, denn sie ist kaum mehr"
    + " auf der Rinde zu erkennen. Doch zu meinst, dass sie eine Totemmaske"
    + " darstellen soll."
      );
   AddDetail( ({ "totemmaske","totem","maske" }),
      "Du betrachtest die Schnitzereien genauer, und da faellt Dir etwas"
    + " an der linken Augenhoehle der Totemmaske auf."
      );
   AddDetail( ({ "augenhoehle","augen","hoehle" }),
      "Welche meinst Du? Die linke oder die rechte Augenhoehle?"
      );
   AddDetail( ({ "rechte augenhoehle" }),
      "Sie ist nichtso tief ausgehoehlt wie die linke Augenhoehle."
      );
   AddDetail( ({ "linke augenhoehle" }),
      "Sie ist, verglichen mit der rechten Augenhoehle, etwas tiefer"
    + " ausgehoehlt."
      );
   AddDetail( ({ "nichtigkeit","gefuehl" }),
      "Anders gesagt - Du bist ein Wurm."
      );
   AddDetail( ({ "wurm" }),
      "DU bist der Wurm!"
      );

   AddSpecialDetail( ({ "dschungel" }), "untDschungel" );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "norden","nordosten","osten","sueden","sache","anschein" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "druecke","drueck" }), "drueckeInAugenhoehle" );
   AddCmd( ({ "zwaenge","zwaeng" }), "zwaengeDurchLuecke" );
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden",    "./room_e3" );
   AddExit( "nordosten", "./room_f3" );
   AddExit( "osten",     "./room_f4" );
   AddExit( "sueden",    "./room_e5" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int drueckeInAugenhoehle(string str)
{
   object ob;
   string str1;
      
   notify_fail( "Was moechtest Du druecken?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s",str1) != 1)
   	return 0;
      
   if( str1 == "augenhoehle" || str1 == "linke augenhoehle")
   {
      /* Switch-Schalter (ein-aus) fuer Falle     */
      /* Dies verhindert, dass Falle bei Stein II */
      /* ausgeloest wird. Geht aber nur einmal,   */
      /* danach muss man nochmals druecken !      */
      if(!(ob = FT_QUESTITEM))
      {
         write(BS(NOT_PLAYING_QUEST));      
         return 1;  
      }
      ob->set_quest(FT_TRAP_2_DISABLED);

      write(BS("Du steckst Deinen Finger vorsichtig in die linke"
             + " Augenhoehle und drueckst zuerst zaghaft, dann fester"
             + " hinein. Doch Du kannst keinerlei Veraenderung"
             + " feststellen.")
             );
      say(BS(TPN + " drueckt den Finger in die Baumrinde und blickt sich"
             + " nachher fragend um. " + TPN + " zuckt mit den Achseln"
             + " als keinerlei Veraenderung feststellbar ist.")
             );
      return 1;   
   }
   
   return 0;
}

string untGewaechs(string str)
{
   object ob;
   
   if(!(ob = FT_QUESTITEM))
   {
      return(BS(NOT_PLAYING_QUEST));       
   }
   if(ob->query_quest() & FT_UNT_DSCHUNGEL)
      return(BS("Dieses Gewaechs ist Dir zuvor nicht aufgefallen. Scheinbar"
              + " war es zuvor noch nicht da, obwohl Dir das eigenartig"
              + " vorkommt. Doch Dir faellt auf, dass in dem Gewaechs eine"
              + " kleine Luecke klafft.")
              );
   else
      return(BS("Da ist kein Gewaechs - Du musst Dich getaeuscht haben."));   
}

string untLuecke(string str)
{
   object ob;
   
   if(!(ob = FT_QUESTITEM))
   {
      return(BS(NOT_PLAYING_QUEST));       
   }
   if(ob->query_quest() & FT_UNT_DSCHUNGEL)
      return(BS("Die Luecke ist nicht gerade gross, aber vielleicht schaffst"
              + " Du es, Dich da durchzuzwaengen.")
              );
   else
      return(BS("Du scheinst Dich getaeuscht zu haben, denn Du kannst keine"
              + " Luecke entdecken.")
              );   
}

string untDschungel(string str)
{
   object ob;
   
   if(!(ob = FT_QUESTITEM))
   {
      return(BS(NOT_PLAYING_QUEST));       
   }
   ob->set_quest(FT_UNT_DSCHUNGEL);
   
   AddSpecialDetail( ({ "gewaechs" }), "untGewaechs");
   AddSpecialDetail( ({ "luecke" }),   "untLuecke");   

   return(BS("Der Dschungel umgibt Dich beinahe beaengstigend. Urwaldriesen"
          + " ragen in den Himmel und lassen Dich klein uind hilflos"
          + " erscheinen. Doch faellt Dir ein Gewaechs im Westen auf.")
          );
}

int zwaengeDurchLuecke(string str)
{
   object ob;
   string str1;
   int damage;
      
   notify_fail( "Wo Du Dich durchzwaengen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "durch %s",str1) != 1)
   	return 0;
   
   if(!(ob = FT_QUESTITEM))
   {
      write(BS(NOT_PLAYING_QUEST));       
      return 1;
   }
   if(!(ob->query_quest() & FT_UNT_DSCHUNGEL))
   {
      write(BS("Es ist keine Luecke da, durch die Du Dich zwaengen kannst."));
      return 1;   
   }
   if( str1 == "luecke")
   {
      if (TP->QueryProp(P_SIZE) > 170)
      {
         write(BS("Du hast die Groesse der Luecke wohl ueberschaetzt."
                + " Du passt nicht durch die Luecke, willst es aber"
                + " trotzdem und verletzt Dich dabei leicht. Aber Du"
                + " wolltest es ja nicht anders.")
             );
         damage = -((TP->QueryProp(P_SIZE) - 170) / 3);
         TP->AddHp(damage);
      }
      else
         write(BS("Du zwaengst Dich langsam durch die enge Luecke.") );

      TP->move(FT_ROOM("room_d4"),M_GO,
                  "westlich von Dir",
                  "verschwindet","zwaengt sich durch die enge Luecke herein"
                  );       
      return 1;   
   }
   
   return 0;
}
