/*
** D5 - Raum auf dem Weg zum Tempel
** 28.10.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Im Dschungel" );
   SetProp(P_INT_LONG,
      "Du dringst tiefer in den Dschungel ein, musst aber nun erkennen,"
      " dass es sich hier um einen toten Weg handelt. Es scheint hier"
      " nirgendwo weiterzugehen, ausser dorthin, von wo Du gekommen bist."
      " Dennoch bist Du wieder ueberwaeltigt von der Vielfalt und"
      " Andersartigkeit der Vegetation Deiner Umgebung."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Der Boden besteht aus gestgestampfter Erde, denn Du stehst ja auf"
    + " einem Pfad. Rings um den Weg wuchern Pflanzen. Ausserdem kannst Du"
    + " etliche Fussabdruecke erkennen."
      );      
   AddDetail( ({ "pfad","weg" }),
      "Der Pfad hat Dich hierher gefuehrt, doch scheint er hier zu enden."
    + " Du kannst nirgendwo eine Spur erkennen, wo der Weg sich fortsetzt."
      );      
  AddDetail( ({ "spur" }),
      "Wie gesagt, Du siehst keine Spur, wo sich der Weg fortsetzt. Das"
    + " Einzige, das nach einer Spur aussieht, sind die Fussabdruecke von"
    + " kleinen nud groesseren Tieren."
      );
  AddDetail( ({ "fussabdruecke","fussabdruck","abdruecke","abdruck",
                "einzige" }),
      "Die Abdruecke sind alles, was von den vorbeigezogenen Tieren"
    + " noch zu sehen ist."
      );  
  AddDetail( ({ "tieren","tiere","tier" }),
      "Die Tiere unterschiedlicher Groesse sind hier durch den Dschungel"
    + " gewandert, wahrscheinlich auf der Suche nach Beute."
      );
  AddDetail( ({ "suche" }),
      "Die Tiere des Dschungels suchen nach Fressbaren, meist andere"
    + " Tiere oder Pflanzen."
      );
  AddDetail( ({ "groesse" }),
      "Die Groesse der Tiere divergiert beachtlich, wie Du aus den"
    + " vorhandenen Fussabdruecken im Boden sehen kannst."
      );      
  AddDetail( ({ "beute","fressbaren" }),
      "Die kleineren Tiere sind die Beute der groesseren, die groesseren"
    + " die der noch groesseren. So wie immer in der Natur."
      );
  AddDetail( ({ "natur" }),
      "Nur der Staerkere kann ueberleben."
      );
  AddDetail( ({ "staerkere" }),
      "Bist Du der Staerkere?"
      );
  AddDetail( ({ "andersartigkeit" }),
      "Die Vegetation hier im Dschungel unterscheidet sich stark von allem,"
    + " das Du bisher auf Deinen Reisen gesehen hast. Sie ist viel ueppiger,"
    + " farbenpraechtiger und irgendwie bedrohlicher. Du wuerdest Dich nicht"
    + " wundern, wenn es hier die eine oder andere Falle geben wuerde. Und"
    + " Du beschliesst, besonders vorsichtig zu sein, wenn Du den Dschungel"
    + " weiter erkundest."
      );
  AddDetail( ({ "fallen","falle" }),
      "Du bist immer mehr davon ueberzeugt, dass es hier Fallen gibt."
      );
  AddDetail( ({ "reisen","reise" }),
      "Du bist doch sicher schon viel im Silberland(tm) herumgekommen, oder?"
      );
  AddDetail( ({ "vielfalt" }),
      "Die Vielfalt der Vegetation beeindruckt Dich sehr. Doch gleichzeitig"
    + " wird Dir dabei ganz mumlig, denn man weiss ja nie, was so eine"
    + " Vielfalt alles hervorbringt."
      );
  AddDetail( ({ "vegetation" }),
      "Die Vegetation des Dschungels ist sehr vielfaeltig und"
    + " farbenpraechtig. Viele Pflanzen hat Du noch nie gesehen, andere"
    + " glaubst Du zu kennen."
      );      
  AddDetail( ({ "pflanzen","pflanze","arten","art" }),
      "Die Pflanzen sind teilweise mannshoch oder noch groesser. Vielerlei"
    + " Arten draengen sich dicht an dicht ringsum Dich. Dich wundert nur,"
    + " warum der Weg noch nicht ueberwuchert wurde."
      );      
  AddDetail( ({ "dschungel","dschungels","umgebung" }),
      "Du bist ringsherum vom Dschungel mit seinen Pflanzen und Tieren"
    + " umgeben."
      );
   
   AddSpecialDetail( ({ "silberland(tm)","silberland" }), "untSL" );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","vielerlei" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden", "./room_d4" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
string untSL(string str)
{
   shout(BS(TPN + " kennt das Silberland(tm) nicht. An den Pranger mit"
          + " " + TPN + "!")
          );
   return(BS("Das hast Du nun davon."));
}