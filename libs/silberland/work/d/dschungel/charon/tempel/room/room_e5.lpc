/*
** E5 - Raum auf dem Weg zum Tempel
** 28.10.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Im Dschungel" );
   SetProp(P_INT_LONG,
      "Du stehst auf einer kleinen Lichtung im Dschungel. Du wirst"
      " geradezu umringt von einer Mauer von Pflanzen. Die einzigen"
      " Richtungen, in die Du gehen kannst, sind vor und zurueck."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst deutlich den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Der Boden besteht aus festgestampfter Erde, denn Du stehst ja auf"
    + " einem Weg. Rings um den Weg wuchern Pflanzen."
      );      
   AddDetail( ({ "pfad","weg" }),
      "Der Pfad hat Dich hierher gefuehrt, doch fuehrt er nur tiefer in"
    + " in den Dschungel oder wieder zurueck, woher Du gekommen bist."
      );
   AddDetail( ({ "pflanzen","pflanze" }),
      "Diese Artenvielfalt beeindruckt Dich immer wieder, doch gleichzeitig"
    + " laesst sie Dich froesteln, denn Du denkst daran, wie viele"
    + " unerforschte Lebewesen es hier geben mag."
      );   
   AddDetail( ({ "lebewesen","wesen" }),
      "Die Zahl der Lebewesen, die im Dschungel hausen, ist nicht einmal"
    + " annaehernd bekannt. Und Du moechtest es auch nicht so genau wissen"
    + " bzw. mit allen Bekanntschaft machen."
      );   
   AddDetail( ({ "artenvielfalt","vielfalt","arten","art","zahl" }),
      "Der Dschungel hat unzaehlige Arten von Lebewesen und Pflanzen"
    + " hervorgebracht. Und nicht alle sind fuer Dich ungefaehrlich,"
    + " auch wenn Du schon viel herumgekommen und nicht ganz wehrlos"
    + " bist. Und nicht nur die Natur birgt noch zahlreiche Ueberraschungen"
    + " fuer Dich, auch einstigen Bewohner haben sicher Massnahmen erdacht,"
    + " um unliebsame Gaeste loszuwerden."
      );   
   AddDetail( ({ "natur" }),
      "Fauna und Flora eben."
      );   
   AddDetail( ({ "fauna","flora" }),
      "Ok, dann langsam: Flora = Pflanzen, Fauna = Lebewesen."
      );   
   AddDetail( ({ "ueberraschungen","ueberraschung" }),
      "Du weisst nie, was Dich noch hier erwartet."
      );   
   AddDetail( ({ "massnahmen","massnahme" }),
      "Wenn Du Dich anstrengst, faellt Dir sicher auch etwas ein,"
    + " mit dem man unliebsame Gaeste wieder loswerden kann."
      );   
   AddDetail( ({ "gaeste","gast","eindringlinge","eindringling" }),
      "Eindringlinge wie Du."
      );   
   AddDetail( ({ "mauer" }),
      "Die Pflanzen umringen Dich wie eine dichte Mauer. Du muesstest"
    + " Dich schon sehr anstrengen, wolltest Du den Pfad verlassen. Und"
    + " selbst dann ist noch nicht gesagt, ob Du weit kommen wuerdest."
      );   
   AddDetail( ({ "bewohner" }),
      "Du fragst Dich, ob Du die einstigen Bewohner noch zu sehen bekommst,"
    + " oder ob sie schon laengst mitsamt ihrer Kultur untergegangen sind."
      );   
   AddDetail( ({ "kultur" }),
      "Du weisst, dass sie einen riesigen Tempel erbaut haben, also"
    + " muessen sie eine hochstehende Kultur gehabt haben."
      );   
   AddDetail( ({ "tempel" }),
      "Du hast ihn schon von der Schlucht aus gesehen."
      );   
   AddDetail( ({ "schlucht" }),
      "Die Schlucht hast Du wagemutig ueberquert, wenn Du Dich noch"
    + " erinnern kannst."
      );   
   AddDetail( ({ "dschungel" }),
      "Du bewegst Dich scheinbar seit geraumer Zeit durch den Dschungel."
    + " Dir erscheint es, dass Du an manchen Stellen schon gewesen bist,"
    + " aber der Eindruck kann auch taeuschen."
      );   
   AddDetail( ({ "stellen","stelle" }),
      "Du glaubst, manche Stellen wiederzuerkennen - oder taeuscht Du Dich?"
      );   
   AddDetail( ({ "lichtung" }),
      "Du bist froh, wieder den Himmel vollstaendig zu sehen. Die"
    + " Pflanzen rund um Dich sind schon beklemmend genug, aber wenn sie"
    + " auch noch ein Dach bilden, das den Blick nach oben verwehrt...das"
    + " ist wirklich beaengstigend."
      );   
   AddDetail( ({ "dach" }),
      "Die Pflanzen sind dann nicht nur um Dich herum, sondern auch"
    + " ueber Dir."
      );   
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","bekanntschaft","eindruck","blick","zeit" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden", "./room_e4" );
   AddExit( "osten",  "./room_f5" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/