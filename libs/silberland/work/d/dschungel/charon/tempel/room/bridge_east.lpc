/*
** Haengebruecke jenseits - Platz am jenseitigen Ende der zerstoerten Haengebruecke
** 21.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Andere Seite der Schlucht" );
   SetProp(P_INT_LONG,
      "Du stehst nun auf der anderen Seite der Schlucht. Deine waghalsige"
      " Aktion war von Erfolg gekroent gewesen, obwohl Du bezweifelst,"
      " ob Du so etwas nochmals machen willst, denn Dir schlottern jetzt"
      " noch die Knie. Du moechtest nur weg von diesem Abgrund."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du kannst den klaren, blauen Himmel ueber Dir erkennen."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig."
      );      
   AddDetail( ({"pflanze","pflanzen","vegetation"}),
      "Die uebliche Vegetation hier."
      );
   AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Du hast gerade den Abgrund lebensverachtend ueberquert und nun"
    + " breitet sich vor Dir die schwuele, gruene Hoelle aus. Du hast den"
    + " Dschungel bald satt, aber noch willst Du nicht aufgeben."
      );
   AddDetail( ({ "schlucht","abgrund" }),
      "Der tiefe Abgrund liegt nun hinter Dir, und Du wagst es kaum, Dich"
    + " umzudrehen und nochmals hinabzublicken."
      );
   AddDetail( ({ "seite" }),
      "Die hast den Abgrund hinter Dir gelassen und stehst nun auf der"
    + " anderen Seite der Schlucht. Und darueber bist Du sehr froh."
      );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "aktion","erfolg","knie","sache" }),
      "Das tut hier nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Du wirst muede, einschlafen und in die Schlucht stuerzen,"
    + " wenn Du noch weiter hinhoerst."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/

   /*** Items ***/

   /*** Exits ***/
   AddExit( "osten", "nach Osten in den Dschungel#./room_e3" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
