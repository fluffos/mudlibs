/*
** F2 - Raum auf dem Weg zum Tempel
** 10.11.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Im Dschungel" );
   SetProp(P_INT_LONG,
      "Du schlaegst Dich tapfer durch diese unwirtliche Landschaft und"
      " siehst aber nicht viel davon, ausser den hoch aufragenden"
      " Pflanzen vor Dir. Der Weg teilt sich hier wiederum und biegt ab"
      " nach Sueden."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden","pfad","weg" }),
      "Der Boden besteht aus gestgestampfter Erde, denn Du stehst ja auf"
    + " einem Pfad. Rings um den Weg wuchern Pflanzen. Der Pfad biegt"
    + " nach Sueden ab."
      );      
   AddDetail( ({ "erde" }),
      "Was soll man dazu sagen...einfach festgestampfte Erde."
      );
   AddDetail( ({ "landschaft" }),
      "Der Dich umgebende Dschungel ist zwar einerseits sehr faszinierend,"
    + " andererseits auch sehr gefaehrlich. Du solltest immer daran denken,"
    + " Dich vorsichtig zu bewegen."
      );      
   AddDetail( ({"pflanze","pflanzen"}),
      "Fuer die Pflanzen scheint das Klima hier im Dschungel bestens zu"
    + " sein, denn sie gedeihen hier ueppiger als irgendwo sonst. Und"
    + " ausserdem gibt es hier eine Artenvielfalt, wie Du sie noch nie"
    + " zuvor gesehen hast."
      );
   AddDetail( ({ "artenvielfalt","vielfalt","arten","art" }),
      "Die Vielfalt der Arten ist schier unermaesslich. Du entdeckst"
    + " immer wieder neue Arten und bist erstaunt, wie einfallsreich die"
    + " Natur hier im Dschungel gewesen ist."
      );
   AddDetail( ({ "natur" }),
      "Die Natur ist alles, was Dich hier im Dschungel umgibt. Und nicht"
    + " alles ist Dir freundlich gesinnt, sei versichert!"
      );      
   AddDetail( ({ "klima" }),
      "Das Klima ist feucht und schwuel, Dir rinnen schon Schweisstropfen"
    + " ueber das Gesicht. Dies ist keine sehr angenehmer Platz, um laenger"
    + " zu verweilen."
      );
   AddDetail( ({ "gesicht" }),
      "Na, Dein Gesicht. Schau' in einen Spiegel, dann siehst Du es."
      );
   AddDetail( ({ "spiegel" }),
      "Wenn Du keinen mit hast, hier ist sicher keiner zu finden."
      );
   AddDetail( ({ "schweisstropfen","schweiss","tropfen" }),
      "Dir ist sehr heiss und Du schwitzt stark. Dir laufen"
    + " Schweisstropfen, gross und salzig, ueber das Gesicht."
      );
   AddDetail( ({ "platz" }),
      "Der Dschungel ist kein Platz, um sich auszurasten und zu erholen."
      );
   AddDetail( ({ "dschungel","dschungels" }),
      "Der Dschungel ist ueberall um Dich herum, denn Du bist schon weit"
    + " in ihn eingedrungen. Er erscheint Dir fast wie ein lebendiges Wesen,"
    + " das zu atmen scheint. Du vermeinst, den Hauch des Atems in Deinem"
    + " Nacken zu verspueren."
      );      
   AddDetail( ({ "wesen","hauch" }),
      "Du vermeinst den Atem des Dschungels auf Deinem Nacken zu spueren."
    + " Dir laeuft es kalt ueber den Ruecken hinunter, als Du Dir"
    + " vorstellst, was sich alles hinter Deinem Ruecken befinden koennte."
    + " Aber da ist natuerlich nichts, oder?"
      );
   AddDetail( ({ "atem","atems" }),
      "Der Atem scheint stossweise zu kommen, wie von einem gehetzten"
    + " Tier - nur nicht umdrehen jetzt."
      );
   AddDetail( ({ "tier" }),
      "Es gibt viele Tiere hier im Dschungel - einige sind ungefaehrlich,"
    + " andere wieder nicht."
      );
   AddDetail( ({ "nacken" }),
      "Man sagt auch Hals dazu."
      );
   AddDetail( ({ "hals" }),
      "Stell' Dich nicht so an. Du weisst, was das ist."
      );
   AddDetail( ({ "ruecken" }),
      "Das soll nur heissen, dass Du nicht weisst, was Dich erwartet."
      );
            
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "umdrehen" }), "umdrehen" );
      
   /*** Items ***/

   /*** Exits ***/
   AddExit( "osten",  "./room_g2" );
   AddExit( "sueden", "./room_f3" );
   AddExit( "westen", "./room_e2" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int umdrehen(string str)
{
   write(BS("Du drehst Dich rasch um, um einen Blick auf das"
           + " zu werfen, was sich hinter Dir befindet. Doch Du erkennst"
           + " nichts, ausser den schier undurchdringlichen Dschungel mit"
           + " seinen ineinander verschlungenen Pflanzen.")
           );
   return 1;           
}
