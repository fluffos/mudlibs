/*
** E3 - Raum auf dem Weg zum Tempel
** 22.09.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "An einer Wegkreuzung" );
   SetProp(P_INT_LONG,
      "Du betrittst den dichten Dschungel und stehst unmittelbar vor"
      " einer Wegkreuzung und denkst: 'Allein im Dschungel und dann vielleicht"
      " auch noch ein Labyrinth...genau das, was ich brauche.' Da Du aber"
      " schon so weit gekommen bist, moechtest Du nun nicht aufgeben."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Der Boden besteht aus gestgestampfter Erde, denn Du stehst ja auf"
    + " einem Pfad. Rings um den Weg wuchern Pflanzen."
      );      
   AddDetail( ({ "pfad" }),
      "Der Pfad verzweigt sich unmittelbar vor Dir. Du kannst auswaehlen,"
    + " welchem Du folgen willst."
      );      
   AddDetail( ({ "erde" }),
      "Was soll man dazu sagen...einfach festgestampfte Erde."
      );
   AddDetail( ({"pflanze","pflanzen","vegetation","finger"}),
      "Die Pflanzen sind mannshoch oder noch hoeher und recken sich"
    + " wie Finger gen Himmel."
      );
  AddDetail( ({ "dschungel" }),
      "Du hast Dich wieder in den Dschungel begeben. Hinter Dir kannst Du"
    + " gerade noch die Lichtung sehen, die Du durch Deine abenteuerliche"
    + " Rutschfahrt erreicht hast. Du erkennst, dass Du die Schlucht auf"
    + " diese Art nicht mehr ueberwinden kannst."
      );
   AddDetail( ({ "lichtung" }),
      "An dieser Lichtung bist Du angekommen nach Deiner Rutschfahrt. Du"
    + " kannst sie gerade noch erkennen, weil die Pflanzen fast"
    + " undurchdringlich sind und kaum gestatten, aus dem Dschungel zu"
    + " blicken."
      );
   AddDetail( ({ "rutschfahrt","rutsch","fahrt" }),
      "Ja, das war wirklich moerderisch gut (oder gut moerderisch?)."
      );      
   AddDetail( ({ "schlucht" }),
      "Die Schlucht kannst du von hier nicht mehr erkennen, aber Dich"
    + " schaudert, wenn Du an Deine Rutschfahrt ueber sie zurueckdenkst."
      );            
   AddDetail( ({ "wegkreuzung","weg","wege","kreuzung" }),
      "Du blickst zu Boden und siehst, dass die Wege in alle vier"
    + " Himmelsrichtungen im Dschungel verschwinden."
      );      
   AddDetail( ({ "labyrinth" }),
      "Tja, es sieht beinahe so aus, als wuerdest Du in ein Labyrinth"
    + " gehen, aber wer weiss, vielleicht bildest Du Dir das auch nur ein."
      );
   AddDetail( ({ "himmelsrichtungen","himmelsrichtung","richtung" }),
      "Ok, dann eben taxativ: Norden, Osten, Sueden und Westen."
    + ""
      );
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "art","norden","osten","sueden","westen","sache","da" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden", "./room_e2" );
   AddExit( "osten",  "./room_f3" );
   AddExit( "sueden", "./room_e4" );
   AddExit( "westen", "./bridge_east" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/