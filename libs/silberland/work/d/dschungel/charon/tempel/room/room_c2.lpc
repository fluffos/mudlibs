/*
** C2 - In diesem Raum ist die Astgabel fuer das Ueberqueren der 
**      Schlucht versteckt
** 22.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Abseits des Trampelpfads" );
   SetProp(P_INT_LONG,
      "Du stehst augenblicklich etwas abseits des Trampelpfads, umgeben"
      " von riesigen gruenen Blaettern, Staemmen und anderen Gewaechsen."
      " Du fragst Dich, warum Du hier uns Unterholz gegangen bist. Doch"
      " irgendetwas in Dir meint, dass Du hier etwas von Bedeutung finden"
      " wirst."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du kannst den klaren, blauen Himmel ueber Dir erkennen."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig."
      );      
   AddDetail( ({"pflanze","pflanzen","vegetation"}),
      "Die Pflanzen wuchern rings um Dich. Und manchmal glaubst Du,"
    + " dass sie irgendwie lebendig waeren, was natuerlich unsinnig ist."
      );
   AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Vor Dir breitet sich die schwuele, gruene Hoelle aus. Du hast den"
    + " Dschungel bald satt, aber noch willst Du nicht aufgeben."
      );
   AddDetail( ({ "blaetter","blatt" }),
      "Du bewunderst die riesigen, gruenen Blaetter dieser ueppigen"
    + " Vegatation im Dschungel. Unter diesen Blaetter etwas zu finden,"
    + " wuerde nicht leicht sein."
      );
   AddDetail( ({ "staemme","stamm","baeume","baum","exemplare","exemplar" }),
      "Die Staemme der Baeume sind gerade zu riesenhaft, aber es finden"
    + " sich auch kleinere Exemplare hier. An einem kleineren Baum faellt"
    + " Dir eine Astgabel besonders auf."
      );
   AddDetail( ({ "gewaechsen","gewaechse","gewaechs",
               "blattgewaechse","blattgewaechs" }),
      "Du kannst mannshohe Blattgewaechse und meterdicke Staemme der"
    + " Baeume erkennen. Und die Vegetation ist so dicht, dass Du kaum"
    + " den Boden erkennen kannst."
      );      
   AddDetail( ({ "unterholz" }),
      "Das Unterholz ist sehr sperrig und hindert Dich am weiteren"
    + " Vordringen in den Dschungel neben dem Trampelpfad."
      );      
   AddDetail( ({ "vordringen" }),
      "Du kannst nicht weiter in das Unterholz vordringen."
      );
   AddDetail( ({ "astgabel","ast" }),
      "Diese Astgabel scheint ziemlich stabil zu sein, wenn man sie"
    + " abbrechen wuerde. Aber wozu sollte man sie brauchen?"
      );
   
   AddDetail( ({ "trampelpfad","pfad" }),
      "Du kannst ihn von hier aus gerade noch erkennen durch all diese"
    + " wuchernden Pflanzen. Er ist nicht sehr breit, aber fuer Dich"
    + " reicht es gerade noch."
      );
   AddDetail( ({ "bedeutung","wichtiges" }),
      "Du weisst schon, was gemein ist: etwas Wichtiges, was Dir"
    + " spaeter weiterhelfen wird."
      );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "" }),
      "Das ist voellig uninteressant."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "brich" }), "brichAstgabelAb" );
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "westen", "nach Westen in den Dschungel#./room_b2" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
int brichAstgabelAb(string str)
{
   object astgabel;
   string str1;
   
   notify_fail( "Was willst Du abbrechen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s ab",str1) != 1)
   	return 0;
   
   if( str1 == "astgabel" || str1 == "ast")
   {
      if (astgabel = present("ft_astgabel",TO))
      {
         write(BS("Aber am Boden liegt doch schon eine Astgabel.\n"));   
         
         return 1;
      }
      
      if (astgabel = deep_present("ft_astgabel", TP))
      {
         write(BS("Du zerrst mit aller Kraft an der Astgabel, aber"
                + " die bewegt sich keinen Millimeter, bis Du"
                + " schliesslich erschoepft aufgibst.\n")
                );
         say(BS(TPN + " zerrt mit aller Kraft an der Astgabel, die"
                + " jedoch keinen Millimeter nachgibt. " + TPN
                + " gibt schliesslich erschoepft auf.\n")
                );
                       
         return 1;
      }
      else
      {
         write(BS("Du beginnst mit aller Kraft an der Astgabel zu zerren"
            + " und reissen, hoerst, wie das Holz knackt und arbeitet, und"
            + " auf einmal loest sich die Astgabel vom uebrigen Ast und"
            + " Du haeltst Deine Trophaee in Deinen Haenden.\n")
               );
         say(BS(TPN + " beginnt mit aller Kraft an der Astgabel zu zerren"
            + " und reissen, hoert, wie das Holz knackt und arbeitet, und"
            + " auf einmal loest sich die Astgabel vom uebrigen Ast und "
            + TPN + " haelt die Astgabel in den Haenden.\n")
            );
         
         astgabel = clone_object( FT_OBJ("ft_astgabel"));
         astgabel->move(TP, M_NOCHECK);
         
         return 1;
      }
   }
   return 0;
}