/*
** F3 - Raum mit Stein Nr. VIII
** 10.11.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

#define STEIN        0
#define ERDE         1
#define FLECHTWERK   2
#define WURZEL       3
#define LOCH         4

#define VERSTECKE 5
int versteck = random(VERSTECKE); /* 5 Verstecke fuer den Stein */

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Im Dschungel" );
   SetProp(P_INT_LONG,
      "Du bist Dir nicht sicher, aber langsam verlierst Du hier die"
      " Orientierung. Der Dschungel umgibt Dich wiederum von allen Seiten,"
      " laesst kaum einen Blick durch das dichte Geaest und Geflecht"
      " durchdringen. Der Weg fuehrt hier in alle Himmelsrichtungen weiter,"
      " und Dir faellt eine Steinsaeule ein wenig vor Dir auf."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst kaum den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Der Boden sieht hier nicht viel anders aus als ueberall anders im"
    + " Dschungel. Von allen Seiten wuchern Pflanzen, allein der Weg und"
    + " die Steinsaeule vor Dir sind noch gut zu sehen."
      );
   AddDetail( ({ "steinsaeule","saeule" }),
      "Die Steinsaeule ragt ein wenig vor Dir aus dem Boden. Du wunderst"
    + " Dich, warum sie von den vielen Pflanzen hier noch nicht"
    + " ueberwuchert wurde. Die Saeule ist sehr schlicht, aber trotzdem"
    + " geht von ihr eine Ausstrahlung aus, die Dich ueberwaeltigt. Du wirst"
    + " magisch angezogen von ihr und entdeckst eine Unebenheit an der"
    + " Oberseite der Saeule."
      );
   AddDetail( ({ "oberseite" }),
      "Die Oberseite ist ebenso wie die Seitenflaechen vollkommen glatt"
    + " und sauber, bis auf eine kleine Unebenheit ungefaehr in der Mitte."
      );
   AddDetail( ({ "seiten","seite" }),
      "Du musst schon sagen, was Du meinst: die Seitenflaechen oder die"
    + " Oberseite."
      );
   AddDetail( ({ "seitenflaechen","seitenflaeche","flaechen","flaeche" }),
      "Die Seitenflaechen sind vollkommen glatt und sauber. Du kannst Dir"
    + " kaum vorstellen, wie man eine Flaeche so glatt bekommt, aber"
    + " dennoch ist es so. Als Du darueber streichst, fuehlst Du keinerlei"
    + " Erhebungen."
      );
   AddDetail( ({ "erhebungen","erhebung" }),
      "Es gibt keine, denn die Seitenflaechen sind vollkommen glatt."
      );
   AddDetail( ({ "unebenheit" }),
      "Du betrachtest und befuehlst die Unebenheit genauer und bemerkst"
    + " schliesslich, dass es sich dabei um einen Stein handelt, der in"
    + " der Saeule verankert wurde."
      );
   AddDetail( ({ "stein" }),
      "Der Stein ist halb in der Oberseite der Saeule eingelassen. Die"
    + " Verbindung sieht sehr stabil aus, und als Du daran ruettelst,"
    + " bewegt sich der Stein keinen Millimeter. So wirst Du den Stein"
    + " nicht herausbrechen koennen."
      );
   AddDetail( ({ "verbindung" }),
      "Der Stein und die Saeule sind fest miteinander verbunden, so dass"
    + " Du in sicher nicht mit roher Kraft alleine herausbrechen kannst."
      );
   AddDetail( ({ "kraft" }),
      "Du wirst ein Hilfsmittel brauchen."
      );
   AddDetail( ({ "hilfsmittel" }),
      "Denk' nach, was eignet sich gut, um damit einen Stein herauszubrechen?"
      );
   AddDetail( ({ "ausstrahlung" }),
      "Sie beeinflusst Dich, so dass Du nur mehr an diesen Stein denken"
    + " kannst. Du willst (und musst) ihn unbedingt haben, koste es, was es"
    + " wolle."
      );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","millimeter" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das entfernte Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden","geruch" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   AddCmd( ({ "breche","brich" }), "brichSteinAusSaeule" );
   
   /* Versteck 0 */
//   AddCmd( ({ "mache","mach" }),                  "macheFeuer" );
   /* Versteck 1 */
//   AddCmd( ({ "grab","grabe","wuehl","wuehle" }), "grabeInErde" );   
   /* Versteck 2 */
//   AddCmd( ({ "zerreiss","zerreisse" }),          "zerreisseFlechtwerk" );   
   /* Versteck 3,4 */
//   AddCmd( ({ "greife","greif" }),                "greifIn" );   
   
         
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden",     "./room_f2" );
   AddExit( "nordosten",  "./room_g2" );
   AddExit( "osten",      "./room_g3" );
   AddExit( "suedosten",  "./room_g4" );
   AddExit( "sueden",     "./room_f4" );
   AddExit( "suedwesten", "./room_e4" );
   AddExit( "westen",     "./room_e3" );
   AddExit( "norwesten",  "./room_e2" );
                     
   call_out("aktuellesVersteck", 0);
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
aktuellesVersteck()  
{
   object ob;
   string str;
   
   ob = find_living("charon");
   if(ob)  
   {
      switch(versteck)
      {
         case STEIN:       str = "In Rinde ('mach feuer')";
         break;
         case ERDE:        str = "In Erde ('grabe in erde')";
         break;
         case FLECHTWERK:  str = "Hinter Flechtwerk ('zerreisse flechtwerk')";
         break;
         case WURZEL:      str = "Unter Wurzel ('greif in hohlraum')";
         break;
         case LOCH:        str = "In Loch ('greif in loch')";
         break;
      }
      tell_object(ob,"\n--> Brecheisen liegt in Versteck: " + str + "\n");   
   }  
}

int moveSteinInInventory()
{
   object stein;
   
   stein = clone_object(FT_OBJ("ft_stein_8"));
   if (stein->move(TP,M_GET) == ME_TOO_HEAVY)
   {
      write(BS("Du kannst nicht mehr so viel tragen, daher nimmst Du"
             + " den Stein nicht.")
             );
      say(BS(TPN + " kann nicht mehr so viel tragen und nimmt den Stein"
             + " daher nicht.")
             );
                
      stein->destruct();
   }
   else
   {
      write(BS("Du verstaust den Stein in Deiner Tasche."));
      say(BS(TPN + " verstaut den Stein in einer Tasche."));
      
      /* Stein wieder neu verstecken */
      versteck = random(VERSTECKE);
      call_out("aktuellesVersteck", 0);
   }
   
   return 1;   
}

int brichSteinAusSaeule(string str)
{
   object ob;
   string str1;

   notify_fail( "Was moechtest Du herausbrechen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s",str1) != 1)
   	return 0;
   
   if (str1 == "stein aus saeule" || str1 == "stein heraus" || 
       str1 == "stein aus saeule heraus" )
   {  
      if(!FT_BRECHEISEN)
      {
         write(BS("Du kannst den Stein nicht mit blossen Haenden"
                + " herausbrechen.")
                );
         return 1;
      }
          
      if(FT_QUESTITEM && FT_BRECHEISEN && (!FT_STONE("\nft_stein_8")) )
      {
         write(BS("Du setzt das Brecheisen genau an der Verbindung zwischen"
                + " Stein und Saeule an und versucht, den Stein auszuhebeln."
                + " Redlich bemuehst Du Dich, aber so einfach will es Dir"
                + " nicht gelingen. Mit letzter Kraft wirfst Du Dein gesamtes"
                + " Gewicht auf das Brecheisen, und endlich gibt der Stein nach"
                + " und loest sich aus der Verankerung. Leider zerbricht Dein"
                + " Brecheisen, so dass Du es nicht mehr gebrauchen kannst.")
                );
         say(BS(TPN + " setzt das Brecheisen an der Verbindung zwischen Stein"
              + " und Saeule an und schafft es nach mehreren vergeblichen"
              + " Versuchen, den Stein herauszubrechen. Das Brecheisen"
              + " zerbricht und ist nicht mehr zu gebrauchen.")
              );
         
         moveSteinInInventory();
     
         ob = deep_present("\nft_brecheisen");
         ob->remove();
         return 1;            
      }
      else
      {
         write(BS("Du setzt das Brecheisen genau an der Verbindung zwischen"
                + " Stein und Saeule an und versucht, den Stein auszuhebeln."
                + " Redlich bemuehst Du Dich, aber es will Dir nicht"
                + " gelingen.")
                );
         say(BS(TPN + " setzt das Brecheisen an der Verbindung zwischen Stein"
              + " und Saeule an und schafft es auch nach mehreren "
              + " Versuchen nicht, den Stein herauszubrechen.")
              );

         return 1;   
      }
   }
   
   return 0;
}
