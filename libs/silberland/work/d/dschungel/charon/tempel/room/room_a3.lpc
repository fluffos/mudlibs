/*
** A3 - Raum auf dem Weg zur Haengebruecke
** 23.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Lichtung am Anfang des Trampelwegs" );
   SetProp(P_INT_LONG,
      "Du stehst auf einer kleinen, sonnigen Lichtung mitten im"
      " Dschungel. Nicht weit von Dir beginnt ein Trampelpfad, der"
      " tiefer in die gruene Hoelle fuehrt. Du bemerkst, dass Du"
      " in diesem Teil des Dschungels noch nie warst, denn alles"
      " kommt Dir fremd und eigenartig vor, selbst die banalsten"
      " Dinge. Du fuehlst Dich ein wenig unbehaglich."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du siehst den blauen, wolkenlose Himmel ueber Dir."
      );
   AddDetail( ({ "boden" }),
      "Das Sonnenlicht bricht sich in den Wassertropfen auf den Pflanzen."
    + " Scheinbar hat es erst kuerzlich geregnet."
      );      
   AddDetail( ({ "regentropfen","wassertropfen","wasser","tropfen" }),
      "Die Wassertropfen ruehren vom kuerzlichen Regen her und haben"
    + " sich in Pfuetzen unter und auf den Pflanzen gesammelt."
      );
   AddDetail( ({ "pfuetzen","pfuetze" }),
      "Viele Regentropfen ergeben eine Pfuetze, in der sich die"
    + " Sonne spiegeln kann."
      );                  
   AddDetail( ({"pflanze","pflanzen","vegetation","finger"}),
      "Die Pflanzen sind mannshoch oder noch hoeher und recken sich"
    + " wie Finger gen Himmel."
      );
  AddDetail( ({ "dschungel","hoelle","teil" }),
      "Du befindest Dich irgendwo im Dschungel und denkst: 'Eine"
    + " Karte waere nicht schlecht.'"
      );
   AddDetail( ({ "trampelpfad","pfad","weg" }),
      "Der Weg beginnt unweit von Dir und fuehrt Dich tiefer in den"
    + " Dschungel. Er ist nicht sehr breit, aber Du solltest keine"
    + " Schwierigkeiten haben, ihm zu folgen."
      );
   AddDetail( ({ "dinge","ding" }),
      "ALLES ist fremdartig hier. du kannst es zwar nicht genau"
    + " erklaeren, aber Du hast ein ungutes Gefuehl. Du zoegerst"
    + " und ueberlegst, ob du weitergehen sollst."
      );            
   AddDetail( ({ "gefuehl" }),
      "Dein Gefuehl hat Dich noch nie betrogen."
      );            
   AddDetail( ({ "karte" }),
      "Dann wuesstest Du immer, wo Du bist."
      );            
   AddDetail( ({ "lichtung" }),
      "Du befindest Dich gerade auf dieser Lichtung. Und obwohl"
    + " die Sonne scheint, froestelt Dich."
      );            
   AddDetail( ({ "sonne","licht","sonnenlicht" }),
      "Sie scheint vom Himmel auf Dich herab."
      );            

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "schwierigkeiten","schwierigkeit","sache" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden", "./room_a2" );
   AddExit( "osten",  "./room_b3" );
   AddExit( "westen", "/d/dschungel/dante/weg/room/weg14" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/