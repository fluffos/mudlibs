/*
** B2 - Raum auf dem Weg zur Haengebruecke
** 22.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Am Trampelpfad im Dschungel" );
   SetProp(P_INT_LONG,
      "Du stehst am Trampelpfad, umgeben von riesigen gruenen Blaettern,"
      " Staemmen und anderen Gewaechsen. Du erkennst oestlich von Dir"
      " dichtes Unterholz."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du kannst den klaren, blauen Himmel ueber Dir erkennen."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig."
      );      
   AddDetail( ({"pflanze","pflanzen","vegetation"}),
      "Die Pflanzen wuchern rings um Dich. Und manchmal glaubst Du,"
    + " dass sie irgendwie lebendig waeren, was natuerlich unsinnig ist."
      );
  AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Vor Dir breitet sich die schwuele, gruene Hoelle aus. Du hast den"
    + " Dschungel bald satt, aber noch willst Du nicht aufgeben."
      );
   AddDetail( ({ "blaetter","blatt" }),
      "Du bewunderst die riesigen, gruenen Blaetter dieser ueppigen"
    + " Vegatation im Dschungel. Unter diesen Blaetter etwas zu finden,"
    + " wuerde nicht leicht sein."
      );
   AddDetail( ({ "unterholz","holz" }),
      "Das Unterholz im Osten ist zwar ziemlich dicht, aber Du"
    + " koenntest es noch schaffen, durchzukommen."
      );   
   AddDetail( ({ "trampelpfad","pfad" }),
      "Du kannst ihn von hier aus gerade noch erkennen durch all diese"
    + " wuchernden Pflanzen. Er ist nicht sehr breit, aber fuer Dich"
    + " reicht es gerade noch."
      );
   AddDetail( ({ "gewaechsen","gewaechse","gewaechs",
               "blattgewaechse","blattgewaechs" }),
      "Du kannst mannshohe Blattgewaechse und meterdicke Staemme der"
    + " Baeume erkennen."
      );            
   AddDetail( ({ "staemme","stamm" }),
      "Sie sind wirklich sehr dick. Die Baeume muessen schon alt sein."
      );
   AddDetail( ({ "baeume","baum" }),
      "Sie sind bestimmt sehr alt."
      );      
   
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "osten" }),
      "Das ist voellig uninteressant."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das Rauschen der Blaetter."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "norden",     "./room_b1" );
   AddExit( "osten",      "nach Osten ins Unterholz#./room_c2" );
   AddExit( "sueden",     "./room_b3" );
   AddExit( "westen",     "./room_a2" );
   AddExit( "nordwesten", "./room_a1" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/