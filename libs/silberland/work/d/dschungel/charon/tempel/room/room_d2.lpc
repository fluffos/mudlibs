/*
** D2 - Raum mit Stein Nr. I
** 23.09.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

#define VORSPRUNG 0
#define ERDE      1
#define SPALTE    2
#define STEIN     3

#define VERSTECKE 4
int versteck = random(VERSTECKE); /* derzeit 4 Verstecke fuer den Stein */

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "In einer Hoehle" );
   SetProp(P_INT_LONG,
      "Es ist dunkel. Nur ein schwacher Lichtstrahl tritt durch das Loch"
      " in der Decke der Hoehle, doch er erhellt die Umgebung nicht genug,"
      " um viel erkennen zu koennen."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   0);
   SetProp(P_INDOORS, 1);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 33, ENV_TERRAIN: TT_CAVE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "decke" }),
      "In der Decke kannst Du die Steinplatte erkennen, die das Loch"
    + " verdeckt, durch das Du hereingekommen bist. Sonst ist die Decke"
    + " ein wenig feucht und modrig und weist ein paar kleine Unebenheiten"
    + " auf."
      );
   AddDetail( ({ "lichtstrahl" }),
      "Der Lichtstrahl dringt schwach durch das Loch in die Hoehle ein, doch"
    + " kann er sie nicht wirklich erhellen."
      );
   AddDetail( ({ "umgebung" }),
      "Diese Angabe ist wohl zu allgemein. Du musst schon genauer sagen, was"
    + " Du untersuchen willst."
      );
   AddDetail( ({ "unebenheiten","unebenheit" }),
      "Langsam laesst Du Deine Hand ueber die Decke streichen, wobei"
    + " Du sie bei den Unebenheiten laenger verweilen laesst. Ein kleiner"
    + " Vorsprung erregt Deine Aufmerksamkeit."
      );
   AddDetail( ({ "aufmerksamkeit" }),
      "Noch mehr Hinweise waeren illegal."
      );
   AddDetail( ({ "vorsprung" }),
      "Du streckst Dich, um einen genaueren Blick auf den Vorsprung zu"
    + " erhaschen. Deine Hand umgreift den steinernen Vorsprung und ertasten"
    + " einen kleinen Riss."
      );
   AddDetail( ({ "riss" }),
      "Der Riss verlaeuft genau an jenem Punkt, wo der Vorsprung in die"
    + " Decke uebergeht. Du faehrst vorsichtig mit der Hand den Riss entlang,"
    + " wobei Du darauf achtest, den Vorsprung nicht abzubrechen, um Dich"
    + " nicht zu verletzen. Du stellst fest, dass sich der Riss um den"
    + " gesamten Vorsprung zieht."
      );
   AddDetail( ({ "punkt" }),
      "Bei diesem Punkt treffen Vorsprung und Decke aufeinander."
      );
   AddDetail( ({ "waende","wand" }),
      "Du untersucht die Waende dieser Hoehle, stellst aber nur fest, dass"
    + " sie aus festem Gestein bestehen."
      );
   AddDetail( ({ "gestein" }),
      "Das Gestein der Waende ist harter Fels, genauer gesagt Granit."
      );
   AddDetail( ({ "fels","granit" }),
      "Der Granit ist sehr hart, nicht daran zu denken, dass Du ihn"
    + " irgendwie auch nur beschaedigen koenntest. Du glaubst sogar, dass"
    + " er magieresistent sein koennte. Aber trotzdem weist er vertikale"
    + " Rillen auf."
      );
   AddDetail( ({ "rillen","rille" }),
      "Die Rillen stellen sich als Felsspalten heraus."
      );
   AddDetail( ({ "felsspalten","felsspalte","spalten","spalte" }),
      "Die Felsspalten sind bis auf eine sehr schmal."
      );
   AddDetail( ({ "boden" }),
      "Der Boden besteht aus lockerem Erdreich. Wie Du nach unten blickst,"
    + " bemerkst Du, dass Du in der weichen Erde ein weing einsinkst."
    + " Ausserdem erkennst Du in einer Ecke einen Haufen."
      );
   AddDetail( ({ "erde","erdreich" }),
      "Deine Fuesse versinken leicht im lockeren Erdreich, und Du wunderst"
    + " Dich, warum der Boden hier so weich ist."
      );
   AddDetail( ({ "ecke" }),
      "Du erkennst in der Ecke eine Haufen loser Steine."
      );   
   AddDetail( ({ "haufen" }),
      "Als Du genauer hinsiehst, erkennst Du, dass es sich bei diesem Haufen"
    + " um einen Haufen Steine handelt."
      );
   AddDetail( ({ "steine","stein" }),
      "Sie liegen einfach lose in der Ecke. Doch sie liegen Dir ZU"
    + " unauffaellig in der Ecke. Du koenntest ja den einen oder anderen"
    + " Stein einmal umdrehen."
      );      
   AddDetail( ({ "haende","hand","fuesse","fuss",
                 "extremitaeten","extremitaet" }),
      "Deine Extremitaeten solltest Du aber schon kennen."
      );
   AddDetail( ({ "hoehle" }),
      " Die Hoehle ist nicht sehr gross, gerade mal so gross, dass Du bequem"
    + " darin stehen und Dich umsehen kannst."
      );
   AddDetail( ({ "loch" }),
      "Durch dieses Loch bist Du hier in die Hoehle gelangt und wirst auch"
    + " hoffentlich wieder hinauskommen. Das Loch wird durch eine Steinplatte"
    + " verschlossen."
      );
   AddDetail( ({ "steinplatte","stein","platte" }),
      "Die Steinplatte verschliesst das Loch. Du hast sie aber hochgehoben,"
    + " und nun bist Du in der darunterliegenden Hoehle."
      );
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "sache","blick","hinweise","angabe","zu" }),
      "Das tut nichts zur Sache."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst nur das entfernte Rauschen der Blaetter ausserhalb der Hoehle."
      );
   AddSound( ({ "blaetter","rauschen" }),
      "Das Rauschen der Blaetter ist ziemlich eintoenig."
      );

   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach feuchter Erde oder anders gesagt ein wenig"
    + " modrig."
      );
   AddSmell( ({ "erde","boden" }),
      "Auch wenn Du Dich noch so sehr anstrengst und am Boden herumkriechst"
    + " - Du riechst nur modrige Erde."
      );

   /*** Raum Commands ***/
   
   /* Versteck 0 */
   AddCmd( ({ "brich" }),                         "brichVorsprungAb" );
   /* Versteck 1 */
   AddCmd( ({ "grab","grabe","wuehl","wuehle" }), "grabeInErde" );   
   /* Versteck 2 */
   AddCmd( ({ "greife","greif" }),                "greifeInFelsspalte" );   
   /* Versteck 3 */
   AddCmd( ({ "drehe","dreh" }),                  "drehSteinUm" );   
   
         
   /*** Items ***/

   /*** Exits ***/
   AddExit( "oben", "./room_d1" );
   
   call_out("aktuellesVersteck", 0);
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
aktuellesVersteck()  
{
   object ob;
   string str;
   
   ob = find_living("charon");
   if(ob)  
   {
      switch(versteck)
      {
         case VORSPRUNG:   str = "Felsvorsprung ('brich vorsprung ab')";
         break;
         case ERDE:        str = "In Erde ('grabe in erde')";
         break;
         case SPALTE:      str = "In Felsspalte ('greife in felsspalte')";
         break;
         case STEIN:       str = "Unter Stein ('dreh stein um')";
         break;
      }
      tell_object(ob,"\n--> Stein I liegt in Versteck: " + str + "\n");   
   }  
}

int moveSteinInInventory()
{
   object stein;
   
   stein = clone_object(FT_OBJ("ft_stein_1"));
   if (stein->move(TP,M_GET) == ME_TOO_HEAVY)
   {
      write(BS("Du kannst nicht mehr so viel tragen, daher nimmst Du"
             + " den Stein nicht.")
             );
      say(BS(TPN + " kann nicht mehr so viel tragen und nimmt den Stein"
             + " daher nicht.")
             );
                
      stein->destruct();
   }
   else
   {
      write(BS("Du verstaust den Stein in Deiner Tasche."));
      say(BS(TPN + " verstaut den Stein in einer Tasche."));
      
      /* Stein wieder neu verstecken */
      versteck = random(VERSTECKE);
      call_out("aktuellesVersteck", 0);
   }
   
   return 1;   
}

int brichVorsprungAb(string str)
{
   string str1;

   notify_fail( "Was moechtest Du abbrechen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s ab",str1) != 1)
   	return 0;
   
   if (str1 == "vorsprung")
   { 
      if(FT_QUESTITEM && versteck == VORSPRUNG && (!FT_STONE("\nft_stein_1")) )
      {
         write(BS("Du fasst den Felsvorsprung mit beiden Haenden und"
                + " beginnst kraeftig daran zu ruetteln. Mit der Zeit"
                + " lockert sich der Vorsprung, und ein Stein faellt in"
                + " Deine Haende.")
                );
         say(BS(TPN + " fasst den Felsvorsprung mit beiden Haenden und"
              + " beginnt kraeftig daran zu ruetteln. Nach einiger Zeit"
              + " ist " + TPN + " Erfolg beschert, und ein Stein faellt"
              + " in " + TP->Name(WESSEN) + " Haende.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Du fasst den Felsvorsprung mit beiden Haenden und"
                + " beginnst kraeftig daran zu ruetteln. Doch trotz"
                +" aller Deiner Kraftanstrengungen (Du schwitzt schon"
                + " wieder!) will der Vorsprung nicht abbrechen.")
                );
         say(BS(TPN + " fasst den Felsvorsprung mit beiden Haenden und"
              + " beginnt kraeftig daran zu ruetteln, doch ist " + TPN 
              + " kein Erfolg beschert.")
              );
         return 1;   
      }
   }
   
   return 0;
}

int grabeInErde(string str)
{
   string str1;
      
   notify_fail( "Worin moechtest Du graben?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "in %s",str1) != 1)
   	return 0;
   
   if (str1 == "erde" || str1 == "erdreich" || str1 == "boden")
   {
      if(FT_QUESTITEM && versteck == ERDE && (!FT_STONE("\nft_stein_1")) )
      {
         write(BS("Du kniest nieder und beginnst, mit Deinen Haenden in "
                + " der Erde zu graben. Deine Finger durchwuehlen den"
                + " lockeren Boden, in der Hoffnung, dass sie etwas"
                + " von Bedeutung finden. Deine linke Hand stoesst auf"
                + " etwas Hartes, und Du haeltst einen Stein in Deinen"
                + " Haenden.")
                );
         say(BS(TPN + " kniet nieder und beginnt, in der Erde zu graben."
              + " Kurz darauf findet " + TPN + " einen Stein.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Du kniest nieder und beginnst, mit Deinen Haenden in "
                + " der Erde zu graben. Deine Finger durchwuehlen den"
                + " lockeren Boden, in der Hoffnung, dass sie etwas"
                + " von Bedeutung finden. Doch Du findest nichts.")
                );
         say(BS(TPN + " kniet nieder und beginnt, in der Erde zu graben."
              + " Doch " + TPN + " hat sich umsonst bemueht.")
              );
         return 1;   
      }
   }
   return 0;
}

int greifeInFelsspalte(string str)
{
   string str1;
      
   notify_fail( "Wohin moechtest Du greifen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "in %s",str1) != 1)
   	return 0;
   
   if (str1 == "felsspalte" || str1 == "felsspalt" ||
       str1 == "spalte"     || str1 == "spalt")
   {
      if(FT_QUESTITEM && versteck == SPALTE && (!FT_STONE("\nft_stein_1")) )
      {
         write(BS("Du naeherst Dich der Wand und tastest sie mit Deinen "
                + " Haenden ab. Sobald sie die Felsspalte gefunden haben,"
                + " laesst Du sie hineinwandern und bringst einen Stein"
                + " zum Vorschein.")
                );
         say(BS(TPN + " greift in eine Felsspalte und bringt einen Stein"
              + " zum Vorschein.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Du naeherst Dich der Wand und tastest sie mit Deinen "
                + " Haenden ab. Sobald sie die Felsspalte gefunden haben,"
                + " laesst Du sie hineinwandern, hoerst aber enttaeuscht"
                + " auf, als Du nichts findest.")
                );
         say(BS(TPN + " greift in eine Felsspalte, findet aber nichts.")
              );
         return 1;   
      }
   }
   return 0;
}

int drehSteinUm(string str)
{
   string str1;
      
   notify_fail( "Was moechtest Du umdrehen?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "%s um",str1) != 1)
   	return 0;
   
   if (str1 == "stein")
   {
      if(FT_QUESTITEM && versteck == STEIN && (!FT_STONE("\nft_stein_1")) )
      {
         write(BS("Du bueckst Dich und drehst den Stein um und findest"
                + " wiederum einen Stein.")
                );
         say(BS(TPN + " bueckst sich, dreht einen Stein um und findet"
              + " wiederum einen Stein.")
              );
         
         moveSteinInInventory();
     
         return 1;            
      }
      else
      {
         write(BS("Du bueckst Dich und drehst den Stein um und findest"
                + " nichts.")
                );
         say(BS(TPN + " bueckst sich, dreht einen Stein um und findet"
              + " nichts.")
              );
         return 1;   
      }
   }
   return 0;
}