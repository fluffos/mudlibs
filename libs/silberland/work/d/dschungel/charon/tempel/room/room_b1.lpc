/*
** B1 - Raum auf dem Weg zur Haengebruecke
** 23.06.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Irgendwo am Trampelpfad im Dschungel" );
   SetProp(P_INT_LONG,
      "Du stehst am Trampelpfad und siehst um Dich herum nur dichte"
      " Vegetation. Die Vegetation ist so dicht, dass Du kaum noch"
      " den Weg erkennen kannst."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "himmel" }),
      "Du kannst den Himmel von hier nicht sehen, denn die Vegetation"
    + " ist zu dicht."
      );
   AddDetail( ({ "boden" }),
      "Wie ueberall im Dschungel ist der Boden von Pflanzen ueberwuchert"
    + " und riecht etwas modrig. Du kannst grosse Pfuetzen erkennen."
      );      
   AddDetail( ({ "pfuetzen","pfuetze" }),
      "Hier im Dschungel sind ausgiebige Regenschauer ueblich. Scheinbar"
    + " hat es erst kuerzlich geregnet und es haben sich grosse Pfuetzen"
    + " gebildet. Als Du in eine der Pfuetzen blickst, erkennst Du Dein"
    + " Abbild und erschrickst."
      );
   AddDetail( ({ "abbild" }),
      "Du erblickt in der Pfuetze Dein verzerrtes Abbild, doch nicht"
    + " dies laesst Dich erschauern, sondern neben Deinem Abbild siehst"
    + " Du noch etwas - einen Totenkopf!"
      );
   AddDetail( ({ "totenkopf","kopf" }),
      "Der Totenkopf scheint Dich anzugrinsen, so, als wuesste er etwas,"
    + " das Dir noch verborgen ist."
      );      
   AddDetail( ({ "regenschauer","regen" }),
      "Im Dschungel absolut ueblich, wenn auch so ein Regenschauer keine"
    + " Abkuehlung bringt."
      );
   AddDetail( ({ "abkuehlung" }),
      "Das soll heissen, dass es nach einem Regenschauer noch genauso"
    + " heiss wie davor ist."
      );   
   AddDetail( ({"pflanze","pflanzen","vegetation"}),
      "Die Pflanzen wuchern rings um Dich. Sie sind dermassen dicht,"
    + " dass Du kaum weiter als ein paar Meter sehen kannst. Manchmal"
    + " erkennst Du nicht einmal mehr Deine Fuesse, die dann unter der"
    + " dichten Vegetation verborgen sind."
      );
  AddDetail ( ({"fuesse","fuss"}),
      "Du hast zwar sehr grosse Fuesse, aber Du kannst sie trotzdem"
    + " kaum sehen."
      );      
  AddDetail( ({ "dschungel","hoelle","gebiet" }),
      "Deine Wanderungen fuehren Dich immer weiter in den Dschungel."
    + " Und obwohl Du erfahren bist, froestelt es Dich manchmal, wenn"
    + " Du daran denkst, was alles hinter diesen Pflanzen lauern koennte."
      );
  AddDetail ( ({"wanderungen","wanderung","streifzuege","streifzug"}),
      "Deine Streifzuege haben Dich schon durch grosse Teile des"
    + " Dschungels gefuehrt."
      );    
  AddDetail ( ({"teile","teil"}),
      "Ja, man koennte sagen, Du hast schon viel vom Dschungel gesehen."
      );    
   AddDetail( ({ "trampelpfad","pfad","weg" }),
      "Du kannst ihn von hier aus gerade noch durch all diese wuchernden"
    + " Pflanzen erkennen. Er ist nicht sehr breit, aber fuer Dich"
    + " reicht es gerade noch."
      );
      
   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "meter","gehen" }),
      "Das ist voellig uninteressant."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      "Du hoerst die Geraeusche des Dschungels."
      );
   AddSound( ({ "geraeusche","geraeusch" }),
      "Du hoerst das Rauschen der Blaetter, die Schreie der Tiere und"
    + " Deine Schritte."
      );
   AddSound( ({ "rauschen","blaetter","blatt" }),
      "Wie wird sich das wohl anhoeren?"
      );
   AddSound( ({ "schreie","schrei","tiere","tier" }),
      "Furchteinfluessend."
      );
   AddSound( ({ "schritte","schritt" }),
      "Du erzeugst schmatzende Geraeusche beim Gehen."
      );
      
   /*** Smells ***/
   AddSmell( DEFAULT_SMELL,
      "Der Boden riecht nach frischem Regen."
      );
   AddSmell( ({ "regen","boden" }),
      "Wie eben ein Boden nach einem Regenschauer riecht."
      );

   /*** Raum Commands ***/
   
   /*** Items ***/

   /*** Exits ***/
   AddExit( "sueden",     "./room_b2" );
   AddExit( "suedwesten", "./room_a2" );
   AddExit( "westen",     "./room_a1" );

}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/