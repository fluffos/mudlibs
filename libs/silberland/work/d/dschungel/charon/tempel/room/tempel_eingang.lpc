/*
** Eingang zum Tempel - Loesen des Raetsels erforderlich um hineinzugelangen
** 14.09.1999  V1.0  Charon@SL
*/

#include "../ft_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int steine  = 0;           /* Anzahl der Steine, die schon gelegt worden */
/* erste Loesungsmoeglichkeit  */
string erg1 = "iii-v-vii-i-viii-ii-iv-vi";  
/* zweite Loesungsmoeglichkeit */
string erg2 = "v-iii-ii-viii-i-vii-vi-iv";  
string *erg; /* Ergebnis des Users */

create() 
{
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Eingang zum Tempel" );
   SetProp(P_INT_LONG,
      "Du verlaesst den Dschungel und betrittst eine grosse Lichtung und"
      " stehst nun am Eingang eines gewaltigen Tempels. Vor Dir ragt das"
      " Eingangstor auf, links und rechts von Dir erstreckt sich die grosse"
      " Lichtung, die Du gerade betreten hast, nur begrenzt vom Dschungel"
      " und dem riesigen Tempel vor Dir."
      );
   
   /*** Settings fuer Raum ***/   
   SetProp(P_LIGHT,   1);
   SetProp(P_INDOORS, 0);
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

   /*** Details fuer Raum ***/
   AddDetail( ({ "tempel","tempels","meisterwerks","meisterwerk",
                 "werk","bauwerk" }),
      "Der Tempel ragt vor Dir fast in den Himmel. Zumindest moechte"
    + " es Dir so erscheinen. Die Erbauer dieses Meisterwerks aus Stein"
    + " muessen viel Schweiss und Zeit dafuer aufgebracht haben."
      );
   AddDetail( ({ "erbauer","volk","volks" }),
      "Ja, dieses Volk hat wahrlich ein Meisterwerk geschaffen. Du"
    + " bewunderst ihren Einfallsreichtum und Kunstfertigkeit."
      );      
   AddDetail( ({ "einfallsreichtum","ideen","idee" }),
      "Die Erbauer hatten sehr viele ausgefallene Ideen und haben"
    + " diese auch umgesetzt."
      );      
   AddDetail( ({ "kunstfertigkeit","faehigkeit" }),
      "Die kuenstlerische Faehigkeit diese aussergweoehnlichen Volks"
    + " sucht seinesgleichen im Silberland (tm)."
      );      
   AddDetail( ({ "silberland" }),
      "Muss man das wirklich noch erklaeren??? Du laeufst doch eh"
    + " schon fast ewig darin herum..."
      );      
   AddDetail( ({ "stein" }),
      "Der ehemals grobe Stein ist meisterhaft bearbeitet worden und"
    + " stellt nun ein Meisterwerk dar, das einzigartig im Silberland"
    + " ist."
      );      
   AddDetail( ({ "lichtung" }),
      "Die Lichtung erstreckt sich noch weit links und rechts von Dir."
    + " Hinter Dir erkennst Du noch den Pfad, der Dich aus dem Dschungel"
    + " hierher gefuehrt hat."
      );
   AddDetail( ({ "pfad" }),
      "Dieser Pfad hat Dich hierher gefuehrt und wird Dich hoffentlich"
    + " auch wieder zurueckbringen."
      );
      
   AddDetail( ({ "himmel" }),
      "Du kannst den Himmel ueber Dir nur schwer erkennen, denn das"
    + " kollossale Bauwerk vor Dir ragt scheinbar bis in den Himmel."
      );
   AddDetail( ({ "boden" }),
      "Der Boden vor dem Tempel ist komischerweise nicht ueberwuchert."
      );      
   AddDetail( ({ "dschungel" }),
      "Du hast den Dschungel gerade verlassen und bist eigentlich ganz"
    + " froh darueber, denn man weiss ja nie, welche Ueberraschungen"
    + " der Dschungel fuer einen bereithaelt."
      );
   AddDetail( ({ "ueberraschung","ueberraschungen" }),
      "Was lauert wohl sonst noch alles im Dschungel?"
      );
   AddDetail( ({ "schweiss" }),
      "Das Bauwerk zu errichten, hat den Erbauern wohl viel Schweiss"
    + " gekostet und wer weiss, was sonst noch alles."
      );
   AddDetail( ({ "eingangstor","tor","eingang" }),
      "Schon das Tor ueberragt Dich, so dass Du Deinen Kopf in den"
    + " Nacken legen musst, um das obere Ende des Tempels zu sehen."
    + " Es sieht sehr massiv aus und ist grosszuegig mit Verzierungen"
    + " versehen. Ausserdem erwecken die linke und die rechte Wand"
    + " Deine Aufmerksamkeit."
      );
   AddDetail( ({ "verzierungen","verzierung","abbilder","abbild" }),
      "Es sind Abbilder einer Gottheit zu sehen, aus denen Du aber"
    + " nicht schlau wirst."
      );
   AddDetail( ({ "gottheit","gott" }),
      "Die Erbauer muessen ihren Gott sehr geachtet haben, wenn sie ihm"
    + " zu Ehren ein solches Meisterwerk errichtet haben."
      );
   AddDetail( ({ "wand" }),
      "Welche Wand meinst Du? Die rechte oder die linke Wand?"
      );
   AddDetail( ({ "linke wand","wand links" }),
      "Obwohl die linke Wand auch praechtig verziert ist, faellt Dir"
    + " doch eine Vertiefung auf."
      );
   AddDetail( ({ "vertiefung" }),
      "Eigentlich ist es ja nicht eine Vertiefung, sondern acht."
    + " Es sieht so aus, koennte man dort etwas hineinlegen. Du siehst"
    + " es Dir genauer an und erkennst, dass es annaehernd eine"
    + " geometrische Figur ist."
      );
   
   AddSpecialDetail( ({"figur"}), "showFigure");
      
   AddDetail( ({ "rechte wand","wand rechts" }),
      "Sie ist ueber und ueber prunkvoll verziehrt. Scheinbar sollen"
    + " die Darstellungen das alltaegliche Leben der Erbauer"
    + " versinnbildlichen."
      );
   AddDetail( ({ "darstellungen","darstellung","szenen","szene" }),
      "Es werden Szenen aus dem Leben der Erbauer und ihrem Gott"
    + " dargestellt, aber so ausdrucksstark und praechtig, dass Du meinst"
    + " die Szenen wuerden sich vor Deinen Augen wahrhaftig abspielen."
      );

   /* Dummy-Antwort fuer alle uninteressanten Details */
   AddDetail( ({ "kopf","ende","nacken","zeit","ehren",
                 "aufmerksamkeit","leben","augen" }),
      "Du solltest lieber Deine Zeit dazu verwenden, anderes zu"
    + " zu untersuchen."
      );
   
   /*** Sounds ***/
   AddSound( DEFAULT_SOUND,
      ""
      );
   AddSound( ({ "" }),
      ""
    + ""
      );

   /*** Smells ***/
   
   /*** Raum Commands ***/
   AddCmd( ({ "leg","lege","stecke","steck" }), "legeStein" );

   /*** Items ***/

   /*** Exits ***/
//   AddExit( "sueden", "./room_c4" );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
showFigure()
{
   TP->More(read_file(FT_TEMPEL_SCHLOSS));
}

int legeStein(string str)
{
   object tempelschlossitem,remove_stein;
   string stein,vertiefung,erg_str,remove_stein_id;
   int num_vertiefung,geloest;
   
   notify_fail( "Du legst was wohin?\n" );
   
   if(!str) return 0;
   
   if (sscanf(str, "stein %s in vertiefung %s",stein,vertiefung) != 2)
   	return 0;
   
   if (!(tempelschlossitem = deep_present("\nft_tempelschlossitem", TP)))
   {
      tempelschlossitem = clone_object( FT_OBJ("tempelschlossitem"));
      tempelschlossitem->move(TP, M_NOCHECK);
   }
   
   switch(stein)
   {
      case "i":    remove_stein_id = "\nft_stein_1";
      break;
      case "ii":   remove_stein_id = "\nft_stein_2";
      break;
      case "iii":  remove_stein_id = "\nft_stein_3";
      break;
      case "iv":   remove_stein_id = "\nft_stein_4";
      break;
      case "v":    remove_stein_id = "\nft_stein_5";
      break;
      case "vi":   remove_stein_id = "\nft_stein_6";
      break;
      case "vii":  remove_stein_id = "\nft_stein_7";
      break;
      case "viii": remove_stein_id = "\nft_stein_8";
      break;
   }
   
   /* Checken, ob Spieler den Stein ueberhaupt hat */
   if (!remove_stein = deep_present(remove_stein_id,TP) )
   {
      write(BS("Wie sollst Du den Stein "+stein+" in die Vertiefung"
            + " legen, wenn Du diesen Stein gar nicht hast?")
            );
      return 1;  
   }
   /* Checken, ob schon etwas in dieser Vertiefung liegt */
   erg = tempelschlossitem->query_tempelschloss(); 
   switch(vertiefung)
   {
      case "a":   num_vertiefung = 0;
      break;
      case "b":   num_vertiefung = 1;
      break;
      case "c":   num_vertiefung = 2;
      break;
      case "d":   num_vertiefung = 3;
      break;
      case "e":   num_vertiefung = 4;
      break;
      case "f":   num_vertiefung = 5;
      break;
      case "g":   num_vertiefung = 6;
      break;
      case "h":   num_vertiefung = 7;
      break;
   }
   if (erg[num_vertiefung] != 0 && erg[num_vertiefung] != "")
   {
      write(BS("Aber in der Vertiefung "+vertiefung+" liegt doch schon"
             + " der Stein "+erg[num_vertiefung]+".")
             );
      return 1;  
   }
   
   /* Stein in Vertiefung ablegen und dem Spieler wegnehmen */
   erg = tempelschlossitem->set_tempelschloss(stein,vertiefung);
   remove_stein->remove();
   
   write(BS("Vorsichtig legst Du den Stein "+stein+" in die Vertiefung"
          + " "+vertiefung+". Deine Haende zittern leicht, denn Du weisst,"
          + " dass Du nur diesen einen Versuch hast.")
          );
   say(BS("Vorsichtig legt "+TPN+" einen Stein in eine Vertiefung."));
          
   /* Alle 8 Steine in die Vertiefungen gelegt */
   if (tempelschlossitem->query_tempelschloss_cnt() == 8)
   {
      write(BS("Als Du den letzten Stein loslaesst, und er in seiner"
             + " Vertiefung verschwindet, hoerst Du ploetzlich ein lautes,"
             + " unheilvolles Rumpeln tief aus dem Inneren des Tempels."
             + " Dir schwant Boeses, als Du erkennst, dass Du der Ausloeser"
             + " dieses uralten Mechanismus bist.")
             );
      say(BS("Als "+TPN+" den letzten Stein loslaesst, und dieser in"
           + " seiner Vertiefung verschwindet, ist ploetzlich ein lautes,"
           + " unheilvolles Rumpeln aus dem Inneren des Tempels zu vernehmen."
           + " Scheinbar hat "+TPN+" einen uralten Mechanismus ausgeloest.")
           );
           
      /* Array umwandeln in String getrennt durch '-' */
      /* Dadurch ist er besser zu vergleichen, als 2  */
      /* Arrays miteinander.                          */ 
      erg_str = implode (erg,"-"); 
      geloest = 0;
      if (erg_str == erg1) geloest = 1;
      if (erg_str == erg2) geloest = 2;
      
      if (geloest > 0)
      {
         write(BS("Du bemerkst, dass Du noch immer Deine beiden Haende"
                + " in der Vertiefung hast und ziehst sie schnell heraus."
                + " Wer weiss, was haette alles passieren koennen durch"
                + " Deine Unachtsamkeit?")
                );
         say(BS(TPN+" bemerkt, dass die Haende noch immer in der Vertiefung"
              + " weilen und zieht sie schnell heraus. Wer weiss, was da"
              + " haette alles passieren koennen?")
              );                
      }
      else
      {
         write(BS("Du bemerkst, dass Du noch immer Deine beiden Haende"
                + " in der Vertiefung hast und moechtest sie schnell"
                + " herausziehen, doch Du hast einen Moment zu lange"
                + " gezoegert...Du hoerst nur mehr ein Rasuchen"
                + " bewegter Luft, dann starrst Du Deine beiden"
                + " Armstuempfe an. Die Erbauer des Tempels wollten"
                + " wohl keine unerlaubten Eindringlinge und haben diverse"
                + " Fallen eingebaut. So auch diese, bei der Du soeben"
                + " Deine beiden Haende verloren hast.")
                );
         say(BS(TPN+" bemerkt, dass die Haende noch immer in der Vertiefung"
              + " weilen und moechte sie noch herausziehen, doch da ist es"
              + " schon zu spaet. Die Falle der Erbauer schlaegt erbarmungslos"
              + " zu und "+TPN+" blickt nur fassungslos auf die verbliebenen"
              + " Armstuempfe.")
              );
      }
   }
   
// write(sprintf("%O\n",erg));
   
   return 1;
}