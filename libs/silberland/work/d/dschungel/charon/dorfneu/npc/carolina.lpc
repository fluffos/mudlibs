/* 
** Carolina - Gefangene des Kannibalendorfes
** 17.12.1998  V1.0  Charon@SL
** debugged by dante 2001
*/

inherit "std/npc";

#include "../def.h"

nosave int gefesselt;

varargs int remove(int s)
{
  int i;
  object *inv;
  
  inv=all_inventory(ME); 
  
  for(i=sizeof(inv)-1;i>=0;i--) 
    inv[i]->remove(1);

  return ::remove(s);	
}

void create()
{
  object bluse, guertel, lederschuhe, lederhose;
  
  gefesselt=1;
  
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({ "gefangene", "carolina","\nkd_carolina"}));
  create_default_npc(10);
  set_living_name("carolina");
  
  /*** NPC properties ***/
  
  SetProp(P_SHORT, "Die Gefangene Carolina");
  SetProp(P_LONG,  
	  BS("Carolina ist eine Gefangene der Kannibalen."
	     " Sie sitzt in einem Winkel des Kaefigs, die Arme um die angezogenen"
	     " Beine geschlungen, welche mit einer schweren Kette gefesselt sind." 
	     " Sie hat lange, dunkelbraune Haare, ihre Haut ist"
	     " durch die tropische Sonne leicht gebraeunt. Sie traegt eine verschmutzte"
	     " Bluse, die in besseren Tagen wohl weiss gewesen sein mag und eine"
	     " zerrissene Hose. Doch all die verschlissene Kleidung kann nicht darueber"
	     " hinwegtaeuschen, dass Carolina eine wunderschoene Frau mit einer exzellenten"
	     " Figur ist. Im Gegenteil, die Kleidungsfetzen lassen Dich Dinge sehen,"
	     " die Du normalerweiser wohl kaum zu Gesicht bekommen wuerdest.\n"
	     "Irgendwie macht sie nicht den Eindruck, mit ihrer derzeitigen Unterkunft"
	     " sehr gluecklich zu sein.\n"
	     "Aus irgendeinem Grund wurde sie nicht sofort getoetet und verspeist.\n"
	     ));
  SetProp(P_NAME,    "Carolina");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_HANDS,   ({" mit einem Guertel", 80}));
  SetProp(P_ALIGN,   200);
  SetProp(P_RACE,    "Mensch");
  SetProp(P_WIMPY,   30);
  SetProp(P_SIZE,    170);
  SetProp(P_DIE_MSG, " verblutet. Ihr schoener Koerper liegt verrenkt zu"
	  " Deinen Fuessen. Fuehlst Du Dich jetzt besser?\n");
  SetProp(P_INFO,    "Eine sehr huebsche Frau - Neben den nicht zu"
	  " unterschaetzenden magichen Kraeften (die jedoch nur bei"
	  " maennlichen Kreaturen Wirkung zeigen) verfuegt sie auch noch"
	  " ueber eine spitze Zunge.\n");
  //SetProp(P_REJECT, ({REJECT_DROP, ""}));
  
  /*** NPC object stuff ***/
  
  // euid setzen, damit Objekte gecloned werden koennen
  SUID;
  
  // Objekte clonen
  bluse       = clone_object("/p/armour/armour/bluse");
  guertel     = clone_object("/p/armour/belt/guertel");
  lederschuhe = clone_object("/p/armour/boots/lederschuhe");
  lederhose   = clone_object("/p/armour/trousers/hose");
  
  bluse->move(this_object());
  guertel->move(this_object());
  lederschuhe->move(this_object());
  lederhose->move(this_object());
  
  bluse->Damage(9);
  guertel->Damage(3);
  lederschuhe->damage(3);
  lederhose->Damage(2);
  
  // Objekte benutzen
  command("trage alles");
  
  /*** NPC details ***/
  
  AddDetail("haut",
    "Carolinas Haut ist gebraeunt und sicher seidig-weich, wenn man"
    " sie beruehren koennte - doch da ist nun mal der Kaefig im Weg.");
  AddDetail("arme",
    "Carolinas Arme und Gesicht werden durch Spritzer inzwischen"
    " aufgetrockneter Dschungel-Erde geziert - Dschungel-Makeup.");
   AddDetail( ({"haare","haar"}),
      "Carolinas Haar ist von einem dunklen Braun. Im Kontrast zu" 
      " ihrem durch den Kaefigaufenthalt etwas ungepflegten Zustand" 
      " scheint das Haar auffallend gepflegt und sauber zu sein.");
   AddDetail("bluse",
     "Die Bluse ist von Dschungel- und Kaefigaufenthalt verschmutzt" 
     " und zerschlissen.");
   AddDetail("hose",
     "Die Hose wird von einem breiten Lederguertel mit Messingschnalle"
     " gehalten. An einigen Stellen ist die Hose stark zerrissen." 
     " Im Halbdunkel des Kaefigs kannst Du durch die Loecher einen" 
     " Blick auf Carolinas lange Beine erhaschen: auch leicht gebraeunt.");
   AddDetail(({"koerper","beine","brust","busen"}),
     "Carolina verdreht die Augen und seufzt: Jetzt fang' bloss nicht zu"  
     " sabbern an! Hol' mich lieber raus hier!");
   AddDetail("gesicht",
     "Carolina streicht sich die Haare aus dem Gesicht, wendet Dir das"
     " Gesicht zu und deutet einen kurzen Grinser an: So, genug gegafft!" 
     " Sind wir im Zoo hier? Hol' mich hier raus!");
   AddDetail("guertel",
     "Der Guertel haelt die weite Hose an Carolinas schlanker Taille."
     " Er hat eine grosse Messingschnalle, die sicher hoellisch" 
     " Ohrensausen hinterlaesst, wenn man mit dem Guertel eins uebergezogen" 
     " bekommt.");
   AddDetail(({"fusskette","kette"}),
     "Eine Kette aus grob geschmiedeten Eisengliedern hindert"
     " Carolina am verlassen des Kaefigs. Du denkst: 'Mit der koennte"
     " man sie gleich ans Bett oder an den Herd ketten, wenn man sie"
     " hier mal rausbekommen hat...'");

   /*** NPC information ***/

   SetProp(P_DEFAULT_INFO, ({
      "legt den Kopf schief und sieht Dich aus"
      " schmalen Augen an: Was brabbelst Du da?\n",
      "sagt: Dir hat die Tropensonne wohl zu lange auf die Birne geknallt!\n",
      "zieht die Nase kraus: Du hast wohl ein Problem?!\n",
      "sagt: Keine Ahnung was Du meinst - nuschel mal etwas deutlicher!\n",
      "laechelt: Ja genau! Das frag' ich mich auch immer!\n",
      "prustet: Du kriegst ja auch wirklich nix gebacken, ey!\n"}));

   AddInfo( ({"gefangene","gefangen","eingesperrt"}),
      "Die Kannibalen-Brut hat mich eingefangen als ich in der Nacht um"
      " das Dorf schlich um sie zu beobachten.", "sagt: ");
   AddInfo( "beobachten",
      "Tja, ich bin - oder besser war - dabei diese Gruppe von Kannibalen"
      " zu studieren. Ich bin Anthropologin und bekomm' Kohle dafuer oder"
      " glaubst Du ich schleppe mich zum Spass durch diesen popeligen"
      " Dschungel??.\n", "sieht Dich an und seufzt: ");
   AddInfo( "studieren",
      "Was fuer 'ne Frage! Was eben von Interesse ist: ihre"
      " Verhaltensmuster, ihre sozialen Strukturen und Interaktionsschemata"
      " und natuerlich Sprache und Schrift!\n", "sagt: ");
      
   AddInfo("zettel",
     "Durchtrenne die Ketten, dann gib ihn mir!", "sagt: ");
      
   AddInfo( ({"sprache","schrift","uebersetzen",}),
      "Erst moechte ich die Unterkunft wechseln, dann koennen wir darueber"
      " reden.\n", "laechelt Dich an und haucht: ");
   AddInfo( ({"kaefig", "unterkunft", "eingefangen", "gefaengnis"}),
      "Sie haben mich hier eingesperrt, bis sie geruhen mich zu verspeisen." 
      " Hol mich hier raus - Bitte!", "seufzt: ");
   AddInfo( ({"gluecklich", "traurig"}),
      "In meiner Lage verspuert man nicht den Ueberschwang des Gluecks!",
      "faucht: ");
   AddInfo( ({"heraus holen", "befreien", "unterkunft wechseln"}),
      "etwas hinderlich...", "deutet auf ihre Fusskette und sagt: ");
   AddInfo( ({"fusskette", "kette"}),
      "Die muesste man abzwicken koennen...", "murmelt: ");
   AddInfo( ({ "waechter","wache","wachen" }),
      "Du koenntest mir einen grossen Gefallen tun - mach sie kalt, alle!",
      "laechelt bitter-suess: ");
   AddInfo( ({"kannibale", "kannibalen", "brut"}),
      "Krankes, stinkendes Gesocks - immer nur am Fressen.",
      "verzieht den Mund und sagt: ");
   AddInfo( ({"verspeisen","fressen","gefressen","getoetet","toeten"}),
      "'Sie wollen mich noch ein wenig maesten.' Komisch - maesten im Kaefig," 
      " woran mich das erinnert...", "seufzt: ");
   AddInfo( "maesten",
      "'Was wohl? Die wollen was zwischen die Beisserchen kriegen.'"
      " Dir faellt auf, dass Carolina ziemlich schlank zu sein scheint.",
      "sagt: "
      );
   AddInfo( ({"vater","kai"}),
      "Mein Vater ist sehr krank. Er leidet unter der seltenen Krankheit"
      " 'Morbus Degeneratus, welche ihn zum plappernden Idioten macht."
      " Ich bin in Kannibalendorf aufgebrochen, um ihm die einzige Medizin"
      " zu besorgen, die Heilung verspricht - Cannabis! Doch der Heiltrank"
      " ist nicht leicht zu finden bzw. zu bekommen, weil keiner weiss,"
      " wer im Dorf ihn genau hat. Aber meiner Meinung nach hat ihn"
      " der Koch. Doch huete Dich, schnell landest Du in seinem Kochtopf.",
      "seufzt: ");
    AddInfo( ({"trank","heiltrank","medizin","cannabis"}),
       "Ja, das Cannabis koennte meinen Vater retten, koenntest Du es"
       " besorgen fuer ihn?", "sagt: ");
    AddInfo("koch",
       "Der muss hier irgendwo im Dorf sein.", "sagt: ");
    AddInfo("eintopf",
       "Die Kannibalen lieben Eintopf.", "sagt: ");
    AddInfo("dorf",
       "Ich kam ins Dorf der Kannibalen, um meinem Vater zu helfen,"
       " nun bin ich es, der man helfen muss.", "seufzt: ");
          
   /*** NPC chats ***/

   SetChats(1, ({
      "Carolina seufzt und lehnt den Kopf an die Staebe ihres Gefaengnisses.\n",
      "Carolina sagt: Pass bloss auf! Wenn sie Dich erwischen, gibt's wieder" 
      " Eintopf. Ich hasse Eintopf!\n",
      "Carolina blickt mit traurigen Augen ins Leere.\n",
      "Carolina streicht sich eine Haarstraehne aus dem Gesicht.\n",
      "Carolina geht in ihrem Gefaengnis auf und ab.\n",
      "Carolina wirft Dir einen traurigen Blick aus ihren gruenen Augen zu.\n"
      "Carolina fluestert: Wenn Du mich befreist, dann helfe ich Dir beim"
      " Uebersetzen.\n"}));

   /*** NPC attack chats ***/

   SetAttackChats(30, ({
     "Carolina zieht @WEM eins mit dem Guertel ueber die Birne.\n",
     "Carolina ruft: Du feiges Schwein!\n",
     "Carolina ruft: Fuer den Koenig!\n",
     "Carolina jammert: Hoer auf!\n",
     "Carolina grinst: Ich bin doch nur ein schwaches Maedchen. Carolina"
     " zieht @WEM eins mit dem Guertel ueber.\n",
     "Carolina scheint zu bemerken, dass sie langsam ihre Hose verliert...\n"
     }) );

   /*** NPC commands ***/
}
/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

void SetVarGefesselt(int value)
{
  gefesselt = value;
}

int ShowVarGefesselt()
{
  return gefesselt;
}

void give_notify(object ob)
{
  object obj;
  
  if (gefesselt != 0)
    write(BS("Carolina sagt: Zuerst moechte ich die Kette loswerden.\n"));
  else
    {
      if (ob->id("\nkd_zettel"))
      {   
         write(break_string("Ok, hoer' zu....da steht:"
               " 'Nur wer in seinen Haenden das Messer der Vorvaeter haelt,"
               " raeumt den unbesiegbaren Waechter aus der Welt,"
               " der seine Kraft aus seinem Kopfschmuck bezieht -"
               " auch wenn dieser gammelig aussieht."
               " Der Waechter wird Dich nicht zu seinem Haeuptling lassen -"
               " und auch nicht zum Koch, zum Futter fassen!"
               " Hast Du die Wache jedoch niedergerungen,"
               " wohl wird Dein Ruhm noch lange besungen."
               " Doch Dir vorallem eine fette Belohnung winkt - "
               " klar willst Du die haben, weil Geld ja nicht stinkt."
               " Einfach wird sie aber nicht zu finden sein -"
               " denn Dir wird heisser als in der Wueste sein und stinken"
               " wirst Du wie ein Schwein."
               " Sei also vorsichtig, Fremdling, und geh' umsichtig vor,"
               " sonst haengst Du bald wie die anderen am Tor! ...' Es steht"
               " zwar noch mehr auf dem Zettel, aber der Zahn der Zeit hat"
               " es unleserlich gemacht.",
               78, "Carolina uebersetzt: "));
          write(break_string("Ok, nachdem Du mich nun befreit hast, gehe ich"
                " nun zu meinem Vater. Bring' ihm bitte sein Heilmittel. Und"
                " einen Tip geb' ich Dir noch mit: Du hast doch schon das rituelle"
                " Messer gefunden, oder? Beim Waechter des Haeuptling wirst Du es"
                " brauchen, glaube mir.",
                78, "Carolina sagt: "));
                DOOR_MASTER->SetDoorStatus(ROOM "kaefig",D_STATUS_CLOSED);
                move(BUSCH,M_GO,"aus dem Kaefig","geht",
		     "kriecht durch das Gebuesch herein");
      }
      else
	{
	  write(BS("Carolina schnauzt Dich an: Was soll ich mit dem?"));
	  drop_obj(ob);
	}
    }
  
  npc::give_notify(ob);	
}
