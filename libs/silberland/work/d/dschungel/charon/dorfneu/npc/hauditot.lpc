/* 
** Starke Wache (2) des Kannibalendorfes
** 17.12.1998  V1.0  Charon@SL
*/
inherit "std/npc";

#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"kannibale", "kannibalen_wache", "hauditot","\nkd_hauditot"}));
  create_default_npc(13);
  set_living_name("hauditot");
  
  /*** NPC properties ***/
  
  SetProp(P_SHORT, "Der Kannibale Hauditot");
  SetProp(P_LONG,  
      BS("Der Menschenfresser Hauditot ist derzeit als Waechter"
      " fuer das Kannibalendorf eingesetzt. Sein Koerperbau predestiniert ihn"
      " geradezu fuer diesen Job, denn er ist um gut einen Kopf groesser als"
      " seine Kollegen. Auch seine Statur ist gleichsam einem Halbgott nachempfunden."
      " Du erschauderst bei dem Gedanken, gegen diesen Muskelberg kaempfen zu"
      " zu muessen. Dieser Eindruck wird noch durch sein gemaltes Totenkopfgrinsen"
      " und die Skalps seiner frueheren Gegner, die an seiner Lende baumeln,"
      " verstaerkt. Seine Haut ist uebersaet von Narben, ebenso wie sein Gesicht,"
      " die ebenfalls von frueheren Kaempfen herruehren."));
   
  SetProp(P_NAME,    "Hauditot");
  SetProp(P_GENDER,  MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE,    203);
  SetProp(P_HANDS,   ({" mit seinen Haenden", 70}));
  SetProp(P_ALIGN,   -100);
  SetProp(P_RACE,    "Mensch");
  SetProp(P_DIE_MSG, " grinst satanisch und alles Leben weicht aus seinem Koerper.\n");
  SetProp(P_DEFAULT_INFO,"murmelt: Grmmmpf?!?");
  
  SetAttribute(A_STR, 18);
  SetAttribute(A_INT,  9);
  
  /*** NPC object stuff ***/
  
  // euid setzen, damit Objekte gecloned werden koennen
  SUID;
  
  // Objekte clonen
  CLONEME(WEAPON "sch_keule");
  CLONEME("/p/armour/trousers/lendenschurz");
  
  // Objekte benutzen
  command("zuecke keule");
  command("trage alles");
  
  /*** NPC details ***/
  
  /*** NPC information ***/
  
  /*** NPC chats ***/
  
  /*** NPC attack chats ***/
}
