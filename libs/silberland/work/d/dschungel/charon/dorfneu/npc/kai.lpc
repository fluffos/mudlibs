/* 
** Kai - Vater von Carolina
** 16.02.1999  V1.0  Charon@SL
*/

inherit "std/npc";

#include "../def.h"

varargs int remove(int s)
{
  int i;
  object *inv;
  
  inv=all_inventory(ME);
  
  for(i=sizeof(inv)-1;i>=0;i--) 
    inv[i]->remove(1);
  
  return ::remove(s);	
}

void create()
{
  object lederruestung;
  object guertel;
  object lederschuhe;
  object lederhose;
   
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"kai", "vater","\nkd_kai"}));
  create_default_npc(10);

  /*** NPC properties ***/
  
  SetProp(P_SHORT, "Kai, der Vater von Carolina");
  SetProp(P_LONG,  
	  BS("Kai ist ein schlanker Mann mitte 50. Seine Kleidung ist"
	     " ziemlich gammelig, und er macht insgesamt einen recht verwahrlosten"
	     " Eindruck. Abgesehen von seinem Aeusseren scheint auch sonst"
	     " Irgendetwas mit ihm nicht in Ordnung zu sein."));
  SetProp(P_NAME,    "Kai");
  SetProp(P_GENDER,  MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_HANDS,   ({" mit seinen Haenden", 140, DT_BLUDGEON}));
  SetProp(P_ALIGN,   200);
  SetProp(P_RACE,    "Mensch");
  SetProp(P_WIMPY,   30);
  SetProp(P_SIZE,    175);
  
  SetProp(P_DIE_MSG, " stuerzt toedlich getroffen zu Boden. Ein Seufzen"
	  " entringt sich seiner Brust: \"Wenn ich jetzt nur Cannabis-Saft haett', fuehlte ich"
	  " mich wie im Bett!\"\n");
  
  SetProp(P_INFO, "Kai verfuegt bloss ueber eine nicht unnennenswerte " 
	  "Anzahl bloeder Sprueche.\n");

  /*** NPC object stuff ***/
  // euid setzen, damit Objekte gecloned werden koennen
  SUID;
  
  // Objekte clonen
  lederruestung = clone_object("/p/armour/armour/lederruestung");
  guertel       = clone_object("/p/armour/belt/guertel");
  lederschuhe   = clone_object("/p/armour/boots/lederschuhe");
  lederhose     = clone_object("/p/armour/trousers/lederhose");
  
  lederruestung->move(this_object());
  guertel->move(this_object());
  lederschuhe->move(this_object());
  lederhose->move(this_object());
  
  lederruestung->Damage(2);
  guertel->Damage(3);
  lederschuhe->Damage(4);
  lederhose->Damage(2);
  
  // Objekte benutzen
  command ("trage alles");
  
  /*** NPC details ***/
  
  AddDetail( ({"kleidung", "gewand"}),
     "Kais Gewand ist mit Spritzern getrockneten Dschungelschlamms"
     " uebersaeht. Ausserdem laesst der ins muffige gehende Geruch"
     " seiner Kleidung darauf schliessen, dass der letzte Waschtag"
     " schon lange her ist.");
  AddDetail(({"mann", "vater"}),
    "Mann oh mann - hast es gecheckt - dass in Kai ein Maennchen steckt?");
   
  /*** NPC information ***/
  
  AddInfo("charon",
      "\"Mein Herr und Erzeuger!\"",
      "kniet nieder und ruft: "
      );
  AddInfo( "messer",
      ({ "Ja, ein Messer waere besser!",
         "Tja, ein Messer waer' was gegen Menschenfresser!",
         "Ich hab' leider kein Messer, dafuer Angst vorm Menschenfresser..."
         }), "sagt: ");
  AddInfo( ({"cannabis","saft","cannabis-saft","trank","heiltrank"}),
      ({ "Hast Du Cannabis in der Tasche? Reich mir schnell die ganze Flasche!",
         "Cannabis ist ein wahrer Segen, laesst selbst bei mir sich etwas regen!",
         "Braeuchte ich etwas zu saufen, wuerde ich stets nur Cannabis kaufen!",
         "Cannabis ist ein Wundertrank, heilt den Kai, der siech und krank!" 
         }), "sagt: ");
  AddInfo ( "krank",
      ({ "Ja, mir geht es nicht so gut. Ich leide an einer seltenen Krankheit."
         " Nur ein Wunder koennte mich heilen oder ein Heiltrank."
         }), "seufzt: ");
  AddInfo ("krankheit",
      ({ "Sie heisst: Morbus Degeneratus. Sie verursacht Schwindelgefuehle,"
         " Uebelkeit und man muss immer dummes Zeugs reden. Und nun mach'"
         " ran, wenn Du mir helfen willst. Frag' mir nicht dauernd Loecher"
         " in den Bauch."
         }), "sagt: ");
  AddInfo( ({"carolina", "tochter"}),
      "Da gehste bloss ins Dorf hinein und holste se raus, das waer' echt fein!",
      "sagt: ");
  AddInfo( ({"kannibale", "kannibalen", "menschenfresser"}),
      ({ "Was? Sach bloss, das weisste nicht - hier gibt's Kannibalen, bloede G'schicht!",
         "Doch Du darfst Dich nicht ankacken, musst sie einfach niederhacken!" 
         }), "lallt: ");
  AddInfo( "dorf",
      ({ "Jojo - hollaradelodioh!",
         "Im Dorf wohnen die Kannibalen, welche Dir antun 1000 Qualen!"
       + " Einen Siemens(tm) E-Herd haben sie auch dabei, garen Dich auf Stufe 3!" 
       }), "jodelt: ");
  AddInfo( ({"hilfe","aufgabe","quest"}), 
       "@@aufgabe@@\n", "sagt: ");
  
  /*** NPC chats ***/
  
  SetChats(3, ({
      "Kai jammert: Wenn ich hier kein Cannabis krieg', ich bald unter der Erde lieg'!\n",
      break_string("Carolina, mein Kleines - wahrscheinlich haben sie sie schon"
    + " verputzt...\n",
    78,"Kai seufzt: "),
      "Kai murmelt: Wenn sie nur jemand befreien koennte...\n",
      "Kai sudert: Wenn mir nur jemand helfen wuerde...\n",
      break_string("Haett' ich bloss ein Messer - schlitzte ich"
     " auf die Menschenfresser! Schaute in sie hinein, wer denn"
     " frass mein Toechterlein.\n",
    78,"Kai schluchzt: ")
      }) );

  SetProp(P_DEFAULT_INFO, ({
      "quiekt: Heehe - Hilfe! Schreck mich bloss nicht - Hohlbirne!\n",
      "sagt: Da kannst mir mal helfen, wenn Dir fad im Schaedel ist.\n",
      "lacht: Hiiiiihihihiiiiii hi    hi iiiiih hi\n",
      "sagt: Mach Dich vom Acker, Dumpfbacke!\n",
      "stoehnt: Kannst Du mir mal den Arsch kratzen - mein Kreuz is"
      " schon ganz steif vom rumgammeln hier!\n",
      "fragt: Waaas? Kannste mal meine Tochter befreien?\n" 
     }) );

  /*** NPC attack chats ***/
  
  SetAttackChats(30, ({
     "Kai schreit: Hau bloss ab, Du feiges Schwein, sonst schlag ich Dir die Fresse ein!\n",
     "Kai jammert: Bitte, bitte schlag mich nicht - mein Kreuz tut weh - ich hab' die Gicht!\n",
     "Kai ruft: Fuer den Koenig!\n",
     "Kai lacht: Sauf Dir's Aug' aus - gehoerst eh ins Narrenhaus!\n",
     "Kai grinst: In Preussen treten wir doch Dreck wie Dich in den A... ganz fuerchterlich!"
       }));
}


/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

/*** quest related stuff ****/
string aufgabe()
{
  if(TP->QueryQuest(KANNIBALENDORFQUEST))
    return("Ne, danke! DU hast mir schon geholfen. Mehr als genug!");

  if(present("\nkd_quest", TP))
    return("Was willste denn schon wieder, Du Trantuete? Haste das "
	   "Cannabis schon ausgefasst? Oder meine Tochter befreit - "
	   "na gut, die is nicht so wichtig...");

  CLONE(OBJ "questitem", TP);
  
  return 
    "Waas? Du Flasche glaubst, Du koenntest was gegen die Kannibalen ausrichten??" 
    " Hiiiiiiiiiiiihi hii iiih iiii hiiiii hihihihih ihih hii. *raeusper*"
    " Na gut. Hiiihihi! Also, bring' mir so'n Cannabis-Teil aus dem Dorf, das brauche"
    " ich naemlich *gurgel*. Wenn meine Tochter noch am Leben ist, kannst Du sie"
    " befreien, wenn Du willst. Ich glaube, sie wollen aus ihr das naechste Essen"
    " zaubern. Nicht dass sie nicht gut waere, aber sie ist doch meine Tochter"
    " Hihihihi! Wenn ich nicht so krank waere, dann wuerde ich mir ja selbst"
    " helfen, und den Trank besorgen.";
}

void remove_quest_stuff()
{
  object ob;
  
  while ((ob=present("\nkd_cannabis",       TP))) ob->remove(1);
  while ((ob=present("\nkd_quest",          TP))) ob->remove(1);
  while ((ob=present("\nkd_bolzenschneider",TP))) ob->remove(1);
  while ((ob=present("\nkd_schluessel",     TP))) ob->remove(1);
  while ((ob=present("\nkd_zettel",         TP))) ob->remove(1);
  while ((ob=present("\nkd_messer",         TP))) ob->remove(1);
  while ((ob=present("\nkd_schluessel",     TP))) ob->remove(1);
}

void give_notify(object obj)
{
  int q;  
  object kd_quest;
  
  if(obj->id("\nkd_cannabis"))
    {
      /* Spieler macht Quest nicht -> alles wegnehmen */
      if(!(kd_quest=present("\nkd_quest", TP)))
	{
	  tell_room(MENV, 
           break_string("Nanu? Was soll ich mit dem Kram? Da musste"
			" ja bloss furzen von. Hau wech, den Dreck..!"
			" Du hilfst mir ja nicht!",
			78,"Kai staunt: "));
	  remove_quest_stuff();
	  return ::give_notify(obj);
	}
      
      /*  Spieler hat noch nicht alle questrelavanten Punkte erfuellt */
      if(kd_quest->query_quest() != 7)
      { 
	write(break_string("Du wirst doch nicht glauben, dass das alles war?!?"
			   " Schau, dass Du weiterkommst und mach' alles richtig.", 
			   78,"Kai bruellt Dich an: "));
	write(break_string("Aber so ist das wahrscheinlich, wenn man sich mit"
			   " einem Stuemper einlaesst.", 
			   78,"Kai murmelt: "));   
	
	drop_obj(obj);
	write("Kai laesst das Cannabis achtlos fallen.\n");
	return;
      }
      
      /* Spieler hat Quest bestanden */
      q=TP->GiveQuest(KANNIBALENDORFQUEST);
      if(q==1)
	{
	  tell_room(MENV,
             "Kai strahlt: WUJAJA! Cannabis-Saft *lechz*\n "
             " Kai saeuft das ganze Flaeschchen glucksend aus.\n"+
             BS("Du hast geholfen, Kai von Morbus Degeneratus zu heilen, und "
             "seine Tochter befreit. Kai ist Dir von ganzem Herzen dankbar "
             "und wird es Dir nie vergessen. Doch hoffentlich wird er in "
             "Zukunft keine Leute mehr mit bloeden Spruechen belaestigen.")+
             "Kai ruelpst herzhaft.\n"
           );
          write_file(KANNIBALENDORFQUESTLOG,
             sprintf("%s  %s hat die 1000 Qualen im Dorf der Kannibalen bestanden.\n",
		     dtime(time()), capitalize(this_player()->query_real_name())));
          write_file(LOG "kannibalendorf.log",
             sprintf("%s  %s hat die 1000 Qualen im Dorf der Kannibalen bestanden.\n",
		     dtime(time()), capitalize(this_player()->query_real_name())));
	  
          remove_quest_stuff();
          return;
	}

      if(q != -1)
	return write (sprintf("Unbekannter Fehler, bitte den zustaendigen Magier "+
			      "verstaendigen ("+CAP(MAGIERNAME)+")!\nFehlercode: %d\n",
			      q));
    
      call_other(BUSCH,"reset_quest");
    }
}
