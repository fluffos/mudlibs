/*
** Die Wache des Haeuptlings, der Leibwaechter Losdinetdurch
** ---
** 18.01.1999  V1.0  Charon@SL
** ??.??.2000  Dante: Debugges
** 22.04.2002  Woody: return -1 fuer Cmd-Failures, Messer muss gezueckt sein.
**
*/

inherit "std/npc";

#include "../def.h"

nosave int haare;

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  haare = 1;
  
  AddId(({ "kannibale", "kannibalen_wache",
	      "losdinetdurch","leibwaechter","waechter",
	      "\nkd_losdinetdurch"}));
  create_default_npc(16);
  set_living_name("losdinetdurch");
  
  /*** NPC properties ***/
  
  SetProp(P_SHORT, "Der Leibwaechter Losdinetdurch");
  SetProp(P_LONG,
        BS("Der Kannibale Losdinetdurch ist der Leibwaechter des Haeuptlings. "
        "Von ueberragender Statur, die wohl viele Bodybuilder erblassen "
        "liesse, nimmt er seine Aufgabe sehr ernst und wuerde Dich wohl "
        "niemals zu seinem Haeuptling vorlassen. Wie eine griechische "
        "Goetterstatue steht er vor Dir, wie ein Fels in der Brandung, "
        "die langen Haare kunstvoll zu einem Zopf geflochten. "
        "Du weisst schon jetzt, dass Du ihn toeten musst, um zum "
        "Haeuptling zu gelangen, aber Du fragts Dich: 'WIE?'"));
  
  SetProp(P_NAME,         "Losdinetdurch");
  SetProp(P_GENDER,       MALE);
  SetProp(P_ARTICLE,      0);
  SetProp(P_SIZE,         212);
  SetProp(P_HANDS,        ({" mit seinen Haenden", 130,({ DT_BLUDGEON })}));
  SetProp(P_ALIGN,        -50);
  SetProp(P_RACE,         "Kannibale");
  SetProp(P_DIE_MSG,      " bricht schwer blutend zusammen und stirbt.\n");
  SetProp(P_DEFAULT_INFO, "grummelt: Grmmpf!");
  
  SetAttribute(A_STR, 22);
  
  /*** NPC details ***/
  
  AddDetail( ({"zopf","haar","haare"}),
         "Ja, er hat schoene lange Haare, die irgendwie magisch zu sein "
         "scheinen. Vielleicht gab es ja aehnliche Wesen, fuer die ihre "
         "Haare eine besondere Bedeutung zu haben schienen. Denk' mal nach!");

  /*** NPC object stuff ***/
  
  // euid setzen, damit Objekte gecloned werden koennen
  SUID;
  
  // Objekte clonen
  CLONEME("/p/weapon/spear/lanze");  
  CLONEME("/p/armour/armour/lederpanzer");
  CLONEME("/p/armour/helm/knochenhelm");
  CLONEME("/p/armour/trousers/lederhose");
  CLONEME("/p/armour/boots/lederschuhe");
  CLONEME("/p/armour/gloves/lederhandschuhe");
  CLONEME("/p/armour/cloak/umhang");
  
  // Objekte benutzen
  command("zuecke lanze");
  command("trage alles");
  
  /*** NPC details ***/
  
  /*** NPC information ***/
  AddInfo( ({"haeuptling"}),
      "Du kannst da nicht rein. Nur ueber meine Leiche!", "warnt Dich: ");

  /*** NPC chats ***/
  
  /*** NPC attack chats ***/
  
  /*** Commands ***/
  AddCmd( ({"schneid","schneide"}), "schneide_haare_ab");
}
/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

/*** Defend() wird ueberschrieben, damit LosDinetdurch nur LP ***/
/*** verliert, wenn man zuerst seine Haare abgschnitten hat.  ***/
int Defend(int dam, string dtype, mixed spell, object enemy)
{
  if(haare==1)
   {
     tell_room(MENV,
         BS("Losdinetdurch lacht ueber Deine laecherlichen Kraefte."
            " Er scheint durch einen Art Zauber geschuetzt zu sein. "
            "Du verletzt Dich leicht!"));
     enemy->do_damage(random(15));
     //so hiermit ist ueben nicht mehr sooo super. dante
     return ::Defend(0, dtype, spell, enemy);
   }
  
  return ::Defend(dam, dtype, spell, enemy);
}

/*** Spieler will haare abschneiden ***/
nosave int schneide_haare_ab(string str)
{
  object kd_quest, messer;
  
  notify_fail ("Was moechtest Du abschneiden?\n");
  
  if(!str) return 0;
  if(str == "waechter haare ab"     || str == "losdinetdurch haare ab"     ||
     str == "haare von waechter ab" || str == "haare von losdinetdurch ab" ||
     str == "kannibalen haare ab"   || str == "haare von kannibalen ab"    ||
     str == "haare ab"              || str == "losdinetdurchs haare ab")
    {
      if (!haare)
	return write(break_string("Aber er hat doch gar keine Haare mehr!")), 
	  -1;
      
      /* Nachschauen, ob der Spieler das Messer schon [gezueckt] hat. */
      if(objectp(messer=TP->QueryProp(P_WEAPON)) && (messer->id("\nkd_messer")))
	{
	  if(!kd_quest = present("\nkd_quest", TP))
	    return write(BS("Du moechtest den Haarschopf von Losdinetdurch"
			    " abschneiden, aber mit einer schnellen Bewegung schuettelt er Dich"
			    " von seinem Ruecken.")), 1;
	  
	  kd_quest->set_quest(KDQ_HAARE_ABGESCHNITTEN);
	  
	  write(BS("Mit geschickten Haenden zueckst du das"
		   " Messer und schneidest Losdinetdurch schnell seinen"
		   " Haarschopf ab. Ein Schauer durchlaeuft den Kannibalen,"
		   " und er kommt Dir nun wesentlich verletzlicher vor"
		   " als zuvor."));
	  haare = 0;
	  return 1;
	}
      else
	{
	  /* deep_present...auch Beutel, etc. werden durchsucht. */
	  if(messer=deep_present("\nkd_messer", TP))
            write("Du solltest das Messer schon auch zuecken!\n");
	  else
            write("Dir fehlt das richtige Werkzeug.\n");
	  return -1;
	}
    }
  return 0;
}
