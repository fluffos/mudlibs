/* 
**  Furzian - Haeuptling der Kannibalen
** 02.02.1998  V1.0  Charon@SL
*/

inherit "std/npc";

#include "../def.h"

void create()
{
   if(!is_clone(ME)) return;
   ::create();
   
   AddId(({"kannibale", "haeuptling", "furzian","\nkd_furzian"}));
   create_default_npc(18);
   set_living_name("furzian");

   /*** NPC properties ***/

   SetProp(P_SHORT, "Furzian, der Haeuptling der Kannibalen");
   SetProp(P_LONG,  
	   BS("Furzian, der Haeuptling der Kannibalen, ist wirklich"
	      " eine ehrfurchtgebietende Erscheinung. Weniger wegen seines Auftretens als"
	      " wegen seiner unglaublichen Koerperfuelle. Dir ist klar, warum er der"
	      " Haeuptling der Kannibalen ist. Er ist das mit Abstand haesslichste und"
	      " dreckigste Subjekt, das hier durch die Gegend laeuft."
	      " Frueher war er sicher ein maechtiger und kraeftiger Kannibale, doch das"
	      " Alter liess die Kraefte schwinden, und was blieb ist ein massiger Fleischberg,"
	      " dessen durch die Koerperfuelle gedehnte Haut auf dem ganzen Koerper in"
	      " grossen Fettfalten herabhaengt. Schweiss steht auf Furzians Stirn und"
	      " rinnt in grossen Tropfen ueber sein Gesicht herab, sammelt sich zwischen"
	      " seinen Lippen und an seinem Kinn, von wo er weiter auf seinen Bauch tropft."
	      " Furzian scheint mit seinen kleinen, stechenden Schweinsaeuglein durch Dich"
	      " hindurch einen Punkt im Unendlichen zu fixieren."));
   SetProp(P_NAME,    "Furzian");
   SetProp(P_GENDER,  MALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_BODY,    140);
   SetProp(P_ALIGN,   -200);
   SetProp(P_RACE,    "Mensch");
   SetProp(P_SIZE,    205);
   SetProp(P_HANDS,   ({" mit seinen fetten Wurstfingern", 120}));
 
   /*** secondary NPC properties ***/

   SetProp(P_DEFAULT_INFO, ({
      "blickt durch Dich hindurch.\n",
      "knurrt: Du bist ein Haufen Dreck, schaff' Dich besser weg!\n",
      "sieht Dich ausdruckslos an. Ploetzlich muss er husten, ein fetter"
      " Schleimbatzen klatscht in Dein Geschicht. Furzian lacht droehnend.\n",
      "brummt: Bloede Fragen mag ich nicht, doch mag ich Dich als Leibgericht.\n",
      }) );
   SetProp(P_DIE_MSG, " reisst den Mund weit auf, unsaeglicher Gestank"
      " nimmt Dir den Atem. Du siehst verfaulte Zahnstummel und seine weit"
      " aufgerissenen, blutunterlaufenen Augen als er sich langsam neigt und -"
      " auf Dich zu stuerzen droht! Schnell springst Du zur Seite, Furzian"
      " schlaegt tot zu Boden.\n");
   SetProp(P_INFO, "Furzian besitzt keinerlei magische Kraefte. Doch sind"
      " seine toxischen Furze eine Falle fuer alle unvorsichtigen Angreifer.\n");

   /*** NPC object stuff ***/
   // euid setzen, damit Objekte gecloned werden koennen
   SUID;

   // Objekte clonen
   CLONEME(WEAPON "schwert");
   CLONEME("/p/armour/trousers/lendenschurz");
  
   // Objekte benutzen
   command("zuecke schwert");
   command("trage alles");
  
   /*** NPC details ***/

   AddDetail( ({"gesicht","schweiss"}),
      "Stinkender Schweiss rinnt in Baechen ueber Furzians fettiges Gesicht"
      " und sammelt sich auf seinem fetten Bauch."
    );
   AddDetail( ({"fett", "fettfalten"}),
      "Die Haut an Furzians Seiten und auf seinem Bauch haengt in grossen Falten"
      " herab. Auch die Haut in seiner Backen haengt in Falten herunter."
    );
   AddDetail( "augen",
      "Im Gegensatz zu Furzians maechtigen, unbeweglichen Koerper"
      " muten seine Augen winzig an. Sie sind stechend und huschen flink von"
      " links nach rechts alle Ereignisse herum erfassend."
    );

   /*** NPC information ***/
   
   AddInfo( ({"schluessel", "aufsperren"}),
      ({ "Schaff Dich, Du Furz!",
         "Was fuer einen Schluessel?!"}),
         "grunzt: "
      );
   AddInfo( ({"carolina", "gefangene", "frau", "maedchen"}),
      "Die gibt vielleicht noch mehr ab, als nur ein feines Fresserchen.",
      "lacht dreckig: "
      );
   AddInfo( "smilander",
      "Eine bloede Pfeife! Ein Wunder, dass er sich noch nicht selbst umgelegt hat.",
      "ruelpst: "
      );
   AddInfo( ({"waechter","kannibalen"}),
      "Alle Idioten, wie soll das bloss weitergehen!?",
      "schnauft: "
      );

   /* emuliere toxischen fuaz via spell */

   SetProp(P_SPELLRATE,30);
   AddSpell(1,100, 
      BS("Furzian laesst einen scheusslichen Furz ziehen, eine undurchsichtige"
      " Wolke huellt Dich ein. Dir wird schwarz vor Augen, du bekommst keine Luft.\n"),
      BS("Furzian laesst einen scheusslichen Furz. Eine gruene Wolke huellt" 
      " @WEN ein. @WER ringt nach Luft und strauchelt.\n")
    );

   /*** NPC chats ***/

   SetChats(1, ({
      BS("Furzian laesst ein tiefes grollendes Lachen ertoenen. Es klingt, als kaeme"
         " die Stimme aus einem Brunnenschacht.\n"),
      BS("Furzian laesst einen donnernden Furz fahren. Du spuerst den Boden erzittern.\n"),
      BS("Furzian zieht geraeuschvoll einen riesigen Schleimbatzen hoch und spuckt"
      " ueber Deine Schulter hinweg Richtung Huetteneingang.\n"),
      BS("Furzian raeuspert sich geraeuschvoll.\n")
    }) );

   /*** NPC attack chats ***/

   SetAttackChats(30, ({
     "Furzian bruellt: Du bist ein Haufen weicher Scheisse!\n",
     "Furzian grunzt: Das war Dein letzter Fehler jetzt, weil Furzian Dich gleich zerfetzt!\n",
     "Furzian laesst einen krachen, eine undurchsichtige Wolke huellt Dich ein.\n",
     "Furzian grunzt: Vielleicht moechtest Du schnell noch beten, ich werd' Dich naemlich jetzt zertreten!\n",
     "Furzian lacht schallend.\n",
     "Furzian schreit: Tod allen, die WinWord verwenden!\n"}) );

   /*** NPC moving ***/
}
