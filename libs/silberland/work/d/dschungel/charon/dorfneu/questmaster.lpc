
#include "/d/dschungel/trintrasil/myowndefine.h"
#include <properties.h>

int guy_is_just_making_quest = 0;


int make_quest_free() {
	
	guy_is_just_making_quest = 0;
}


int lock_quest() {
	
	tell_room("/d/dschungel/trintrasil/dorfneu/room/busch", "\nLOCKED\n");
	
	guy_is_just_making_quest = 1;
}


int quest_status() {
	
	return guy_is_just_making_quest;
}

