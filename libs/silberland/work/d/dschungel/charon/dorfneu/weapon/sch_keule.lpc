/*
** Schaedelkeule eines Kannibalen
** 09.02.1999  V1.0  Charon@SL
*/
/*** Danke an Dante fuer die erste Version ***/

inherit "std/weapon";

#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId( ({"\nkd_schaedelkeule","schaedelkeule", "keule"}) );
  
  /*** OBJ properties ***/
  
  SetProp(P_SHORT, "Eine Schaedelkeule");
  SetProp(P_LONG, 
	  BS("Diese Keule ist eigentlich keine wirkliche Keule,"
	     " sondern aehnelt am ehesten einem Morgenstern. Der einzige"
	     " Unterschied ist, dass hier der Schaedel eines gluecklosen"
	     " Abenteurers verwendet wird.")); 
  
  SetProp(P_NAME,        "Schaedelkeule");
  SetProp(P_GENDER,      FEMALE);
  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC,          130);
  SetProp(P_DAM_TYPE,    DT_BLUDGEON );
  SetProp(P_NR_HANDS,    1);
  SetProp(P_SIZE,        80);
  SetProp(P_MATERIAL,    MAT_HORN );
  SetProp(P_WEIGHT,      3000);
  SetProp(P_VALUE,       350);
  SetProp(P_NOBUY,       0);
  
  /*** OBJ Details ***/
  
  AddDetail(({"schaedel","abenteurer"}),
     "Taeuscht Du Dich, oder hat Dich der Schaedel eben angegrinst?!?");
}
