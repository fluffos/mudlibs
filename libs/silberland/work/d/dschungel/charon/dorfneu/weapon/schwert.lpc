/*
** Knochenschwert fuer Kannibalen
** 09.02.1999  V1.0  Charon@SL
*/
/*** Danke an Dante fuer die erste Version ***/

inherit "std/weapon";

#include "../def.h"

void create()
{
  if(!is_clone(ME))  return;
  ::create();
  
  AddId(({"\nkd_knochenschwert","schwert","knochenschwert"}));
  
  /*** OBJ properties ***/
  
  SetProp(P_SHORT, "Ein Knochenschwert");
  SetProp(P_LONG, 
	  BS("Diese Waffe wurde von den Kannibalen aus einem"
	     " Oberschenkelknochen eines grossen Tieres gefertigt. In den"
	     " richtigen Haenden kann es grossen Schaden zufuegen.")); 
  SetProp(P_INFO, "Diese Waffe wurde aus den Knochen des ehemaligen"
	  " Abenteurers Charon gemacht.");
  
  SetProp(P_NAME,        "Knochenschwert");
  SetProp(P_GENDER,      NEUTER);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC,          110);
  SetProp(P_WC_FIX,      20);
  SetProp(P_WC_BONUS,    (["kannibale":70]) );
  SetProp(P_DAM_TYPE,    ({DT_RIP,DT_BLUDGEON}) );
  SetProp(P_NR_HANDS,    1);
  SetProp(P_SIZE,        90);
  SetProp(P_MATERIAL,    MAT_BONE);
  SetProp(P_WEIGHT,      4000);
  SetProp(P_VALUE,       600);
  SetProp(P_NOBUY,       0);
  
  /*** OBJ Details ***/
  
  AddDetail( ({"knochen","tier","oberschenkelknochen"}),
     "Die Laenge des Schwertes ist beachtlich, es muss sich um ein"
     " einst gewaltiges Tier gehandelt haben.");
  AddDetail( ({"kannibalen","kannibale"}),
     "Sei froh, dass im Moment keiner hier ist!\n"); 
}
