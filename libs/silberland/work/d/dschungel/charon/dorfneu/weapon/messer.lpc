/*
** Messer des Kannibalen
** 17.12.1998  V1.0  Charon@SL
*/

inherit "std/weapon";

#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId( ({"messer","\nkd_messer", "NODESTRUCT", "QUESTITEM"}) );
  
  /*** OBJ properties ***/
  
  SetProp(P_SHORT, "Ein rituelles Messer");
  SetProp(P_LONG,  
      BS("Das Messer hat einen metallene Klinge und einen Holzgriff."
      " Die Klinge besteht vollstaendig aus Eisen, der Griff ist aus einem"
      " dunklen Holz eines Baumes aus dem Dschungel. Er ist reichlich und sehr"
      " kunstvoll verziert. Es scheint fuer eine besondere Verwendung gemacht."
      ));

  SetProp(P_NAME,        "Messer");
  SetProp(P_NAME_ADJ,    "rituell");
  SetProp(P_GENDER,      NEUTER);
  SetProp(P_VALUE,       500);
  SetProp(P_WEIGHT,      850);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE,    DT_BLUDGEON);
  SetProp(P_WC,          145);
  SetProp(P_NR_HANDS,    1);
  SetProp(P_MAGIC,       1);
  SetProp(P_NODROP,      "WAS? Das brauchst Du vielleicht noch!\n");
  SetProp(P_NEVERDROP,   1);

  /*** OBJ Details ***/

  AddDetail( ({"griff","holz","holzgriff"}),
      "Der Griff ist aufwendig verziert mit zahlreichen Schnitzereien."
      " Obwohl die Kannibalen ein kriegerisches Volk sind, finden einige"
      " doch die Zeit, sich angenehmen Dingen des Lebens zu widmen.");
  AddDetail( ({"klinge","eisen"}),
      "Die Klinge macht einen sehr scharfen Eindruck. Sie duerfte, geschickt"
      " gefuehrt, Dir leicht einen Arm oder Bein abtrennen koennen.");
  AddDetail( "verwendung",
      "Sieht so aus, als koenne man mit dem Messer etwas Besonderes abschneiden."
      );
}

void init()
{
  ::init();
  
  if(TP && interactive(TP) && !present("\nkd_quest", TP))
    call_out("remove", 0, 1);
}
