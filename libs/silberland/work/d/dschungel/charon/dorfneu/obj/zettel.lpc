/*
** Zettel - Hinweise fuer weiteres Vorgehen
** 23.12.1998  V1.0  Charon@SL
*/

inherit "/std/thing";

#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"zettel","\nkd_zettel"}));
  
  SetProp(P_SHORT, "Ein Zettel");
  SetProp(P_LONG,  
     BS("Auf dem Zettel kannst Du Schriftzeichen erkennen."
	" Doch da du ueber keinerlei anthropologische Kenntnisse verfuegst,"
	" kannst Du den Text nicht uebersetzen."));
  
  SetProp(P_NAME,     "Zettel");
  SetProp(P_GENDER,   MALE);
  SetProp(P_ARTICLE,  1);
  SetProp(P_MATERIAL, MAT_PAPER);
  
  AddDetail(({"schriftzeichen","zeichen","schrift","text"}),
    "Du kannst sie nicht uebersetzen, da Du unwissend bist.");
}
