** Questhilfsitem (unsichtbar)
** 16.02.1999  V1.0  Charon@SL
** debuggey by dante 2000
*/

inherit "std/thing";

#include "../def.h"

nosave int quest;

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"\nkd_quest"}));
  
  SetProp(P_SHORT,     0);
  SetProp(P_NAME,      "QuestItem");
  SetProp(P_GENDER,    NEUTER);
  SetProp(P_WEIGHT,    0);
  SetProp(P_VALUE,     0);
  SetProp(P_NOBUY,     0);
  SetProp(P_NODROP,    1);
  SetProp(P_NEVERDROP, 1);
  
  SUID;
}

int set_quest(int stufe)
{
  if(getuid(previous_object()) != "dante" && 
     getuid(previous_object()) != "charon" &&
     getuid(previous_object()) != "feyaria" &&
     getuid(previous_object()) != "cirion" &&
     getuid(previous_object()) != getuid(ME))
    {
      raise_error("getuid(PO) problem in Quest!");
      return 0;
    }
  
  quest|=stufe;
  
  DB("KANNIBALENDORFQUEST: "+MENV->name()+" ist bei Punkt: "+quest+" --> "+KDQSTRING[stufe]+"\n");
//  DBM("KANNIBALENDORFQUEST: "+this_player()->name()+" ist bei: "+KDQSTRING[stufe]+"\n");
  write_file(LOG "kannibalendorf.log",
	     sprintf ("%s: "+MENV->name()+" ist bei Punkt: "+quest+
		      " --> "+KDQSTRING[stufe]+"\n",dtime(time())));
  return quest;
}

int query_quest()
{
  return quest;
}
