/*
** Kannibalenkot - wird Spieler ins Inventory gesetzt, sobald er in Schiesse wuehlt.
** 19.01.1999  V1.0  Charon@SL
** 10.02.1999  V1.1  Charon@SL
*/

inherit "std/thing";

#include "../def.h"

nosave int    alter;
nosave object wuehler;
	 
void init()
{
   ::init();

  wuehler=TP;
  
  if(query_once_interactive(TP))
    call_out("stinken", 5,0);
}

void create()
{
  ::create();

  AddId( ({"\nkd_kot","kd_kot"}) );

  SetProp(P_SHORT,   0);
  SetProp(P_LONG,    0);
  SetProp(P_NAME,    "Kannibalenkot");
  SetProp(P_GENDER,  1);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NODROP,  "Du wirst die Scheisse nicht los.\n");
  SetProp(P_NEVERDROP,1);
  SetProp(P_WEIGHT, 0);

  alter = 0;
}

void stinken()
{
  int i;
  
  if(!objectp(wuehler)) return;
  
  if (!alter)
    {
      tell_room(ENV(wuehler), 
		BS(wuehler->name() +
		   " hat sich ueber und ueber mit Kannibalenkot beschmiert."
		   " Wahrscheinlich ist es besser, "
		   + wuehler->name() + " nicht zu nahe zu kommen...der"
		   " Gestank ist unertraeglich."),({wuehler}));
      write(BS("Du hast Dich ueberall mit Scheisse beschmiert, und"
	       " die faengt nun zu stinken an. Deine armen Mitspieler."));
    }
  
  alter++;
  
  if(!random(6))
    switch(random(5))
      {
      case 0:
	tell_room(ENV(wuehler), 
		  BS(wuehler->name(WESSEN)+" Gestank ist nun kaum zu"
		     " ueberriechen.\n"),({wuehler}));
	break;
      case 1:
	tell_room(ENV(wuehler),
		  BS("Du siehst " + wuehler->name() + " an und kommst zu"
		     " dem Schluss, dass " + wuehler->name() + " in Scheisse gebadet"
		     " haben muss.\n"),({wuehler}));
	break;
      case 2:
	tell_room(ENV(wuehler),
		  BS(wuehler->name() + " riecht wie Xavers Misthaufen.\n"),
		  ({wuehler}));
	break;
      case 3:
	tell_room(ENV(wuehler),
		  BS("Sieh doch nur, " + wuehler->name() + " hat sich"
		     " von oben bis unten mit Scheisse besudelt. *ekel*\n"),
		  ({wuehler}));
	break;
      default:
	tell_room(ENV(wuehler),
		  BS(wuehler->name(WESSEN) + " neuer Anzug gefaellt Dir."
		     " Oekologisch einwandfrei, wiederverwertbar und keinerlei"
		     " Rohstoffknappheit in Sicht. Der Ueberzug aus Kannibalenkot"
		     " hat viele Vorteile. Aber er riecht eher streng!\n"),
		  ({wuehler}));
      }
  
  if (alter < 45) call_out("stinken", 5,0);
  
  if (alter == 45) 
    {
      tell_room(ENV(wuehler),
		BS("Die Scheisse an " + wuehler->name() + " ist nun getrocknet"
		   " und beginnt langsam abzubroeckeln. " + wuehler->name() + " atmet"
		   " erleichtert auf.\n"),({wuehler}));
      call_out("remove",0);
    }
}
  
