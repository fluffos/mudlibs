/*
** Kochtopf
** 11.02.1999  V1.0  Charon@SL
** 09.11.1999  V1.1  Charon@SL
*/
inherit "/std/room";

#include "../def.h"

void create()
{
  ::create();
  
  /*** Raumbeschreibung ***/
  SetProp( P_INT_SHORT, "Im Kochtopf");
  SetProp( P_INT_LONG,
      BS("Du faellst direkt in einen gusseisenen Kochtopf. Du erkennst, dass"
      " unter Dir ein grosses Feuer brennt. Du siehst ausserdem einige"
      " Ingredenzien um Dich herumschwimmen. Der Geruch ist aber anregend."
      " Dennoch wird Dir ziemlich heiss, befindest Du dich doch in kochendem"
      " Wasser. Vielleicht solltest Du hier schnellstens rausklettern..."));
  
  /*** Settings fuer Raum ***/
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,  1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:80,ENV_WATER:120,ENV_TERRAIN:TT_OTHER]));
  
  /*** Details fuer Raum ***/
  AddDetail( ({"kannibale","kannibalen","menschenfresser"}),
      "Die Menschenfresser sind ziemlich blutruenstig und ihr"
      " Koch bereitet ihnen dann ein gutes Sueppchen zu.");
  AddDetail( ({"frissdibled","koch"}),
      "Du schwimmst gerade in seinem Kochtopf.");
  AddDetail( ({"topf","kochtopf"}),
      "Der Topf ist aus roh gegossenem Eisen und steht ueber einem"
      " Feuer, das ihn erhitzen soll. Als Du Dich umblickst, kannst Du"
      " die Ingredenzien des Festessens schon sehen.");
  AddDetail( ({"ingredienz","ingredenzien"}),
      "Du erblickst Augen, Finger, Armknochen (Elle und Speiche), ein paar"
      " Oberschenkelknochen, Karotten, Kartoffel...eben alles, was in eine"
      " ordentliche Mahlzeit fuer Kannibalen hineingehoert.");
   
  AddDetail( ({"augen","finger","armknochen","elle","speiche","oberschenkelknochen",
		   "karotten","kartoffel"}),
      "Eine Ingredienz fuer eine Mahlzeit der Kannibalen, denn sie sind"
      " immer hungrig.");
  AddDetail( ({"mahlzeit","festessens","festessen","essen","suppe","sueppchen"}),
       "Da die Kannibalen immer hungrig sind, ist Frissdibled immer"
       " beschaeftigt, um ihnen ein ausgiebiges Essen aufzutischen."
       " Er bereitet es in seinem grossen Topf vor.");
  AddDetail( "eisen",
      "Eben Eisen.");
  AddDetail( "feuer",
      "Es brennt sehr hoch, damit die Suppe im Topf vor sich hinkoecheln kann."
      " Deswegen ist Dir auch schon so heiss...vielleicht solltest Du bald raus.");
  AddDetail( "geruch",
      "Was macht man bei Geruch...riechen!");
  AddDetail( ({"boden","wand","waende"}),
      "Eisen...was sonst?");
  AddDetail( ({"decke","himmel"}),
      "Nur der blaue Himmel.");
  
  /*** Geruch ***/
  AddSmell(DEFAULT_SMELL, "Es riecht nach Festessen.\n");
  AddSmell( ({"topf","kochtopf"}), "Du saugst genuesslich den Geruch"
      " des Festessens in Dich ein, bis Du die Ingredenzien genauer"
      " sehen kannst...Dir wird uebel.");
  
  /*** Commands ***/
  AddCmd( ({"kletter","klettere"}), "kletter_aus_topf"); 
  
  /*** Exits ***/
  
  /*** NPCs ***/
  
  PO->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

varargs string GetExits(object viewer)
{
  return "";
}

/*** Spieler muss aus Topf klettern, um Koch besiegen zu koennen ***/
nosave int kletter_aus_topf(string str)
{
  notify_fail ("Wohin moechtest Du denn klettern?\n");
  
  if(!str) return 0;
  
  if(str == "aus topf" || "aus kochtopf" || str == "raus")
    {
      if(!random(3))
   	{
	  write(BS("Du kletterst aus dem Topf, aber ob das eine gute"
		   " Idee war?"));
	  say(BS(TP->name()+" klettert aus dem Topf und"
		 " ueberlegt sich, ob das eine gute Idee war."));
	  TP->move(ROOM "room_k:"+getuid(TP), M_GO,"klettert aus dem Topf");
	}
      else
	{
	  write(BS("Du versuchst aus dem Topf zu klettern, aber"
            " eine leblose Hand haelt Dich zurueck. Aber so schnell willst"
            " Du nicht aufgeben und denkst: 'Ich sollte es gleich nochmals"
            " probieren."));
	  say(BS(TP->name()+" versucht aus dem Topf zu"
            " klettern, aber eine leblose Hand hindert "+TP->name()+" daran."));
	}
      return 1;
    }
  
  if(str == "topf")
    {
      write(BS("Aber Du steckst doch schon mitten im Topf"
         " und siehst, wie Dich diverse Koerperteile glueckloser Vorgaenger"
         " umkreisen, ebenso wie diverse Gewuerze, die Deinem Teint sicher"
         " nicht zutraeglich sind."));
      say(BS(TP->name()+" versucht aus dem Topf zu"
         " klettern, dabei steckt "+TP->name()+" schon mitten"
         " drin, umkreist von diversen Koerperteilen glueckloser Vorgaenger"
         " und Gewuerzen, die dem Teint sicher schaden."));
      return 1;
    }
  
  return 0;
}
