/*
** VOID - Void-Raum fuer Schwimm-Sequenz
** 03.03.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include "../def.h"

#define ANSCHLUSS "/d/dschungel/feyaria/kueste/room/room_a7"

void init()
{
  ::init();	
  
  call_out("schwimmen1", 2, TP);
}

void create()
{
  ::create();
  
  /*** Raumbeschreibung ***/
  SetProp(P_INT_SHORT, "");
  SetProp(P_INT_LONG,  "");
  
  /*** Settings fuer Raum ***/
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,  0);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:6, ENV_TERRAIN:TT_UNDERWATER]) );
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

void schwimmen1(object pl)
{
  if(!objectp(pl)) return;
  if(!present(pl)) return;
  write(BS("Wagemutig wirfst Du Dich in die Fluten, uebersiehst"
	   " aber, dass gerade eine groessere Welle tosend auf das Ufer zurollt."
	   " Die maechtige Woge schlaegt ueber Dir zusammen und reisst Dich in"
	   " die Tiefe. Du verlierst die Orientierung."));
  
  call_out("schwimmen2", 5, pl);
}

void schwimmen2(object pl)
{
  if(!objectp(pl)) return;
  if(!present(pl)) return;
  
  write(BS("Als Du Dich den Natuergewalten ausgeliefert fuehlst,"
	   " und glaubst, dass Dein letztes Stuendlein geschlagen hat, weil Deine"
	   " Lungen schon brennen vor Sauerstoffmangel, kommst Du an die Oberflaeche"
	   " der tosenden See und kannst Deine Lungen mit kuehler Luft fuellen."
	   " Doch gleich darauf bricht abermals eine Welle ueber Dir und Dir wird"
	   " schwarz vor Augen."));
  
  call_out("schwimmen3", 10, pl);
}	

void schwimmen3(object pl)
{
  if(!objectp(pl)) return;
  if(!present(pl)) return;

  write(BS("Nach schier ewiger Zeit kommst Du wieder zu Dir"
	   " und siehst, dass Du am Wasser treibst. Als Du Dich umblickst kannst,"
	   " Du in einiger Entfernung schon die Kueste sehen. Du nimmst Deine"
	   " letzten Kraftreserven zusammen und beginnst, Deinen Koerper"
	   " gegen den Wellengang in Richtung Land zu bewegen. Und unendlich"
	   " langsam kommt die Kueste naeher...\n"
	   ));
  
  call_out("teleportieren", 1, pl);
}

void teleportieren(object pl)
{
  if(!objectp(pl)) return;
  if(!present(pl)) return;

  pl->move(ANSCHLUSS, M_GO, "unter", "geht","wird an Land gespuelt");
}
