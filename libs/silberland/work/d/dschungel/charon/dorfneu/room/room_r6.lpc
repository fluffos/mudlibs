/*
** R6 - Normaler Raum
** 13.01.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include "../def.h"

void create()
{
  ::create();
  
  /*** Raumbeschreibung ***/
  SetProp(P_INT_SHORT, "Im Kannibalendorf");
  SetProp(P_INT_LONG,
      BS("Du stehst ziemlich in der Mitte des Kannibalendorfes. Um Dich herum"
      " kannst Du einige Huetten sehen, ausserdem steht fast in unmittelbarer"
      " Naehe ein Pfahl. Wie ueblich sind einige Ueberreste der letzten Mahlzeiten"
      " der Kannibalen noch zu sehen. Ansonsten scheint dieser Ort keinerlei"
      " Besonderheiten zu haben."));
  
  /*** Settings fuer Raum ***/
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,  1);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));

  /*** Details fuer Raum ***/
  AddDetail( ({"huette","huetten"}),
       "Du kannst sie ein wenig weiter von Dir entfernt entdecken.");
  AddDetail( ({"boden","erde"}),
       "Der Boden besteht aus gestampfter Erde.");
  AddDetail("himmel",
       "Wie immer im Dschungel ... blau.");
  AddDetail( ({"dschungel","dschungels"}),
       "Das Kannibalendorf befindet sich mitten im Dschungel.");    
  AddDetail( ({"dorf","dorfes","kannibalendorf","mitte"}),
       "Du befindest Dich mitten im Dorf der Menschenfresser.");
  AddDetail( ({"kannibalen","kannibale","menschenfresser"}),
       "Mit den Kannibalen ist nicht zu spassen.");    
  AddDetail( ({"knochen","mahlzeit","mahlzeiten","ueberreste"}),
      "Du siehst verblichene Knochen, die scheinbar schon laenger hier zu"
      " liegen scheinen, aber auch Knochen, die frisch angenagt aussehen.");
  AddDetail( "ort",
      "Du stehst doch hier - warum fragst Du also?");
  AddDetail( "naehe",
      "In der Naehe heisst nicht unbedingt, dass etwas hier zu finden ist.");
  AddDetail( "pfahl",
      "Der Pfahl steht nicht hier, aber in der Naehe.");
  AddDetail( "besonderheiten",
      "Du siehst eben keine(!) Besonderheiten.");
  
  PO->CustomizeObject();
}

void init()
{
  ::init();
  
  if(!sizeof(QueryProp(P_EXITS)))
    if(TP && interactive(TP))
      {
	AddExit("westen", ROOM "room_r5:"+getuid(TP));
	AddExit("sueden", ROOM "room_r7:"+getuid(TP));
	AddExit("norden", ROOM "room_r2:"+getuid(TP));
      }
}
