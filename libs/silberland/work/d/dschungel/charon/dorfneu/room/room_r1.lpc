/*
** R1 - Huette von Smilander
** 22.12.1998  V1.0  Charon@SL
*/
inherit "/std/room";

#include "../def.h"

void create()
{
  ::create();
  
  /*** Raumbeschreibung ***/
  
  SetProp(P_INT_SHORT, "Smilanders Huette");
  SetProp(P_INT_LONG,
      BS("Die Huette ist ein kleiner gammeliger Bambusverschlag.\n"
      "Als Du die Huette betrittst, vermeinst Du in ein Loch gestossen"
      " zu werden, das eine Mischung aus Klaeranlage, Senkgrube,"
      " Schlachthof und Abfalleimer darstellt. Ein bestialischer Gestank"
      " raubt Dir den Atem. Smilander scheint keine rechte Motivation"
      " zu haben, seine Huette heimelig zu gestalten.\n"
      "Du gewoehnst Dich schoen langsam an das schummrige"
      " Daemmerlicht in der Huette und Du erkennst neben zahllosen,"
      " am Boden verstreuten halb- und ganz verfaulten Koerperteilen,"
      " den Umriss eines an der Rueckwand der Huette aufgehaengten"
      " Gegenstandes. An der linken Wand der Huette sind einige"
      " irdene Gefaesse aufgehaengt. In einer Ecke befindet sich ein"
      " Haufen aus Fellen, Haaren und trockenem Gras. Offensichtlich"
      " die Bettstatt von Smilander - angenehme Traeume - *yuck*!"));
  
  /*** Settings fuer Raum ***/
  
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,  1);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_HOUSE ]) );
  
  /*** Details fuer Raum ***/
  
  AddDetail("smilander",
      "Eben Smilander...untersuche den."      );
  AddDetail( ({"kannibale","kannibalen","menschenfresser","wesen"}),
      "Du hast selten so grausame Wesen getroffen."      );
  AddDetail( ({"dorf","dorfes","kannibalendorf","kannibalendorfes"}),
      "Du befindest Dich in einer Huette im Dorf der Menschenfresser."      );
  AddDetail( ({"huette","huetten"}),
      "Die Huette besteht wie alles hier aus Bambus.");
  AddDetail( ({"boden","erde"}),
      "Der Boden der Huette besteht aus gestampfter Erde. Er ist mit"
      " Ueberresten von Koerperteilen bedeckt, die ihren menschlichen"
      " Eigentuemern einmal nuetzliche Dienste geleistet haben duerften.");
  AddDetail("decke",
      "Auch die Decke besteht aus Bambus, dem bevorzugten, da einzigem Baumaterial"
      " hier im Dschungel.");
  AddDetail("ecke",
      "Eine ganz normale Ecke, aber dort liegt was.");
  AddDetail( ({"wand","waende"}),
      "Rate mal...ja, auch aus Bambus.");
  AddDetail( ({"dschungel","dschungels"}),
      "Das Kannibalendorf befindet sich mitten im Dschungel."); 
  AddDetail( ({"bambus","baumaterial"}),
      "Der Bambus eignet sich hervorragend als Baumaterial, weil er einerseits"
      " sehr stabil, aber doch biegsam ist, andererseits ist er hier leicht im"
      " Dschungel zu finden.");
  AddDetail( ({"bambusverschlag","verschlag"}),
      "Die Huette ist schnell aus Bambus zusammengezimmert worden."
      " So sieht es auch aus.");
  AddDetail("motivation",
      "Smilander ist faul.");
  AddDetail("rumkreuchen",
      "Was kreucht und fleucht denn da?");
  AddDetail(({"koerperteile","teil","gliedmassen","arm","arme","kopf",
   				"koepfe","koepfen","teilen","splitter","bein", 
   	          "teile","rumpfteile","ueberreste","knochensplittern",
   	          "knochensplitter","knochen","beine","fleisch"}),
      "Der Boden der Huette ist uebersaeht mit an- und abgeknabberten"
      " halb- und ganz verfaulten Gliedmassen, Koepfen, Rumpfteilen,"
      " Armen und was Mensch halt noch so zum Rumkreuchen vom lieben"
      " Gott geschenkt bekam. Dicke, schwarze Fliegen kreisen laut"
      " summend ueber den Ueberresten der Mahlzeiten von Smilander.");
  AddDetail( ({"dienst","dienste"}),
      "Die Toten benoetigen die Dienste ihrer Koerperteile nicht mehr..."
      " wozu auch?");
  AddDetail("mahlzeiten",
      "Auch ein Kannibale will schliesslich was essen.");
  AddDetail( ({"fliegen","fliege","schwarm"}),
      "Ein Schwarm Fliegen umkreist schon die verfaulten Koerperteile."); 
  AddDetail( ({"eigentuemer","eigentuemern","kampfesgegner","gegner"}),
      "Tja, sie und ihre Teile haengen bzw. liegen hier jetzt so rum.");
  AddDetail( ({"mensch","menschen","gegenstand","gegenstandes"}),
      "Tja, der haengt wohl hier fuer spaeter.");
  AddDetail("gott",
      "Auch Kannibalen glauben an Gott.");
  AddDetail("linke wand",
      "Am Bambusgeflecht der Wand sind Tongefaesse mit Schnueren"
      " befestigt.");
  AddDetail( ({"geflecht","bambusgeflecht","schnuere","schnueren"}),
      "Eben Schnuere, aus Bambus gefertigt.");
  AddDetail( ({"gefaess","gefaesse"}),
      "Gefaesse aus Ton haengen an Schnueren an der linken Wand der"
      " Huette. Ein seltsamer suesslicher Geruch geht von ihnen aus.");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
       "Es richt seltsam suesslich. Dieser Geruch kommt wohl aus den "
       "Gefaessen an der linken Wand der Huette.");
  AddSmell( ({"gefaess", "gefaesse"}),
       "Die Gefaesse riechen seltsam suesslich.");
       
  AddDetail( "ton",
      "Ganz normaler Ton.");
  AddDetail( ({"rueckwand","hintere wand","umriss"}),
      "Du kannst im Halbdunkel der Huette einen Koerper erkennen,"
      " der an der Rueckwand der Huette zu haengen scheint.");       
  AddDetail( ({"koerper","toten","toter"}),
      "Als Du naeher trittst erkennst Du, dass ein Mensch, oder"
      " besser gesagt, das was von ihm uebrig ist, mit zahlreichen"
      " kleinen Knochensplittern durch Arme und Beine an die Wand"
      " genagelt wurde. Die Haut vom Kopf wurde abgezogen, die Augen"
      " hingegen fein saeuberlich wieder an ihren Platz gesetzt."
      " In einer Zahnluecke des herunter geklappten Unterkiefers"
      " steckt eine halb abgebrannte Zigarette. Dir faellt ein"
      " kleines Holzschild auf, das um den Hals des Toten haengt.");
  AddDetail( ({"augen","platz"}),
      "Die Augen sitzen wieder an ihrem angestammten Platz.");
  AddDetail("haut",
      "Die Haut wurde dem Toten sauber abgezogen.");
  AddDetail( ({"holzschild","schild"}),
      "Hmm..so geht das nicht. Wie war das nochmals? Buchstaben, Saetze"
      " ... was muss man mit diesen tun?");
  AddDetail( ({"saetze","satz","buchstaben","buchstabe"}),
      "LIES...! . o O (Du bist heute wieder langsam!)");
  AddReadDetail( ({"holzschild","schild"}),
      " 'Warnung des Gesundheitsministers: Auch Rauchen kann Ihre"
      " Gesundheit gefaehrden! - MUHAHAHA!'");
  AddDetail("hals",
      "Dort haengt ein Schild.");
  AddDetail( ({"unterkiefer","kiefer","unterkiefers"}),
      "Das untere Teil des Kiefers eben.");
  AddDetail("zahnluecke",
      "Da steckt die Zigarette drin.");
  AddDetail( ({"bettstatt","bett","haufen","felle","fell","fellen",
   	         "gras","haare","polsterung","haar"}),
      "Das Bett von Smilander sieht zwar durchaus weich, aber nicht"
      " wirklich einladend aus. Du erkennst, dass das viele Haar,"
      " das als Polsterung dient, der natuerliche Kopfschmuck diverser"
      " ehemaliger Gegner war. Wie es sich fuer gute Skalps"
      " gehoert, ist die Kopfhaut noch dran, was auch den"
      " wuerzigen Duft der Lagerstatt erklaert.");
  AddDetail("gegner",
      "Die verschiedensten Teile von ihnen dienen Smilander nun"
      " als Lagerstatt.");
  AddDetail("lagerstatt",
      "Fuer Dich: ein Bett.");
  AddDetail( ({"skalps","skalp","kopfhaut","schmueck","kopfschmuck"}),
      "Nicht gerade schoen anzusehen, diese blutigen Skalps.");
  AddDetail( ({"gestank","loch","klaeranlage","senkgrube",
   	           "schlachthof","abfalleimer","mischung"}),
      "Du kannst ja mal riechen, wenn Du es nicht glaubst.");
  AddDetail("atem",
      "Du kannst fast nicht mehr atmen, so stickig ist es hier drin.");
  AddDetail( ({"daemmerlicht","licht","halbdunkel"}),
      "So hell wie draussen ist es nicht.");
  AddDetail("zigarette",
      "Nein, die kannst Du nicht mehr rauchen.");
  AddDetail( ({"traeume","traum"}),
      "Du ueberlegst, ob man hier gut traeumen kann.");
  AddDetail( ({"geruch","duft"}),
      "Sehr suess und drueckend.\n");
  
  /*** Geruch ***/
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach verfaultem Fleisch. *Yuck*");
  AddSmell( ({"gefaess","gefaesse"}), "Den Gefaessen entstroemt ein"
      " suesslicher Geruch. du bist neugierig was wohl in den Gefaessen "
      "drinnen ist. Vielleicht solltest Du einmal dort hineinschauen.");
  
  /*** Commands ***/
  
  AddCmd( ({"schau","schaue","durchsuche"}), "schau_gefaess");
  
  /*** Exits ***/
  
  AddExit("osten",  "./room_r2:"+getuid(this_player()));
  AddExit("norden", "./room_r4:"+getuid(this_player()));
  AddExit("sueden", "./room_r5:"+getuid(this_player()));   
  PO->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

void init()
{
  ::init();
  
  if(!sizeof(QueryProp(P_EXITS)))
    if(TP && interactive(TP))
      {
	AddExit("osten",  ROOM "room_r2:"+getuid(TP));
	AddExit("norden", ROOM "room_r4:"+getuid(TP));
	AddExit("sueden", ROOM "room_r5:"+getuid(TP));
      }
}

nosave int schau_gefaess(string str)
{
  object trunk;
  
  notify_fail ("Wo willst Du hineinschauen?\n");
  
  if (!str) return 0;
  
  if (str=="in gefaess" || str=="in gefaess hinein" || str=="in gefaesse" 
      || str=="in gefaesse hinein" || str == "gefaess" || str == "gefaesse"
      || str=="in tongefaess" || str=="in tongefaess hinein" || str=="in tongefaesse" 
      || str=="in tongefaesse hinein" || str == "tongefaess" || str == "tongefaesse" )
    {
      write(BS("Ein Augenpaar blickt Dich an. Du spuerst, wie"
         " Deine letzte Mahlzeit sich wieder Luft zu verschaffen sucht. In"
         " einer dicken Suppe geronnenen Blutes schwimmen diverse Organe und"
         " die Augen. Dem Geruch nach wurde auch Alkohol zugesetzt."
         " Offensichtlich wird hier ein Getraenk gebraut..."));
      
      if(deep_present("\nkd_getraenk",       TP) || 
	 deep_present("\nkd_bolzenschneider",TP))
   	{
	  write(BS("Du schaust in die Gefaesse, findest aber nichts."));
	  say(BS(TP->name()+" schaut in die Gefaesse, findet aber nichts."));
	  return 1;	
   	}
      
      write(BS("Du findest ein kleines, rundes Gefaess mit einem"
	       " suesslich riechenden Trank."));
      say(BS(TP->name()+" findet ein kleines, rundes Gefaess mit"
	     " einem suesslich riechenden Trank."));
       
      // euid setzen, damit Objekte gecloned werden koennen
      SUID;

      // Objekte clonen
      trunk = clone_object(OBJ "trunk");
      
      // Object ins Inventory des Spielers stellen
      if((trunk->move(TP,M_GET))==ME_TOO_HEAVY)
	{
	  write("Du kannst den Trunk nicht mehr tragen!\n");
	  trunk->move(ME, M_NOCHECK);
	}
      
      return 1;
    }
  
  return 0;
}
