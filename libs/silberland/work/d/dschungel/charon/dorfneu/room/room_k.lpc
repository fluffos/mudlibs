/*
** K - Raum des Kochs
** 11.02.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include "../def.h"

void create()
{
  ::create();
  
  /*** Raumbeschreibung ***/
  SetProp( P_INT_SHORT, "Huette des Kochs");
  SetProp( P_INT_LONG,
      BS("Du betrittst nun das Domizil von Frissdibled. Der Platz ist zwar"
      " nicht besonders geraeumig, aber Frissdibled ist zufrieden. Du"
      " kannst allerlei Regale, an Palmen montiert, erkennen, auf denen"
      " diverse Gefaesse und Tiegel zu sehen sind. Aber dominiert wird der"
      " gesamte Platz von einem ueberdimensionalem Kochtopf, der mitten drin"
      " auf einem Feuer steht, und dem ein angenehmer Geruch entstroemt."
      " Frissdibled ruehrt im Topf gemaechlich um, denn es scheint, dass"
      " bald wieder ein Festessen ansteht."));

  /*** Settings fuer Raum ***/
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,  1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  
  /*** Details fuer Raum ***/
  AddDetail( ({"platz","domizil"}),
      "Hier wirkt und herrscht Frissdibled.");
  AddDetail( ({"palme","palmen"}),
      "Es gibt hier auch Palmen, seltener, aber immerhin.");
  AddDetail( ({"regal","regale","regalen"}),
      "Auf den Regalen stehen Gefaesse und Tiegel, die solltest Du"
      " Dir genauer ansehen, denn das Regal ist, wie immer, nur aus"
      " Bambus.");
  AddDetail( ({"gefaess","gefaesse","tiegel"}),
      "Sie sind aus Ton gefertigt und objektiv betrachtet ziemlich"
      " kuenstlerisch gefertigt. Du haettest so etwas den Kannibalen"
      " gar nicht zugetraut.");
  AddDetail( ({"ton","erde"}),
      "Kennst Du keinen Ton? Ok, dann anders...gebrannte Erde, also"
      " nichts besonderes.");
  AddDetail( "bambus",
      "Bambus muss wohl nicht mehr genauer erklaert werden.");
  AddDetail( ({"kannibale","kannibalen","menschenfresser"}),
      "Die Menschenfresser sind ziemlich blutruenstig und ihr"
      " Koch bereitet ihnen dann ein gutes Sueppchen zu.");
  AddDetail( ({"topf","kochtopf"}),
      "Der Topf ist aus roh geschmiedetem Eisen und steht ueber einem"
      " Feuer, das ihn erhitzen soll. Als Du hineinblickst, kannst Du"
      " die Ingredienzien des Festessens schon sehen.");
  AddDetail( ({"ingredienz","ingredienzien"}),
      "Du erblickst Augen, Finger, Armknochen (Elle und Speiche), ein paar"
      " Oberschenkelknochen, Karotten, Kartoffel...eben alles, was in eine"
      " ordentliche Mahlzeit fuer Kannibalen hineingehoert.");
   
  AddDetail( ({"augen","finger","armknochen","elle","speiche","oberschenkelknochen",
                "karotten","kartoffel"}),
      "Eine Ingredienz fuer eine Mahlzeit der Kannibalen, denn sie sind"
      " immer hungrig.");
  AddDetail( ({"mahlzeit","festessens","festessen","essen","suppe","sueppchen"}),
       "Da die Kannibalen immer hungrig sind, ist Frissdibled immer"
       " beschaeftigt, um ihnen ein ausgiebiges Essen aufzutischen."
       " Er bereitet es in seinem grossen Topf vor.");
  AddDetail( "eisen",
      "Eben Eisen.");
  AddDetail( "feuer",
      "Es brennt sehr hoch, damit die Suppe im Topf vor sich hinkoecheln kann.");
  AddDetail( "geruch",
      "Was macht man bei Geruch...riechen!");
  AddDetail( ({"boden"}),
      "Er besteht aus gestampfter Erde.");
  AddDetail( ({"himmel", "decke"}),
      "Der Himmel ist wolkenlos blau.");
  
  /*** Geruch ***/
  AddSmell(DEFAULT_SMELL, "Es riecht nach Festessen.\n");
  AddSmell( ({"topf","kochtopf"}), "Du saugst genuesslich den Geruch"
      " des Festessens in Dich ein, bis Du die Ingredienzien genauer"
      " sehen kannst...Dir wird uebel.");
  
  /*** Commands ***/
  
  /*** Exits ***/
  
  //AddExit("huette", "./room_r8:"+getuid(this_player()));
  
  /*** NPCs ***/
  
  AddItem(NPC "frissdibled", REFRESH_NONE);
  PO->CustomizeObject();
}

void init()
{
  ::init();
  
  if(!sizeof(QueryProp(P_EXITS)))
    if(TP && interactive(TP))
      {
	AddExit("huette", ROOM "room_r8:"+getuid(TP));
      }
}
