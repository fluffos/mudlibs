/*
** R4 - Huette im Kannibalendorf
** 22.12.1998  V1.0  Charon@SL
*/
inherit "/std/room";

#include "../def.h"

void create()
{
  ::create();
  
  /*** Raumbeschreibung ***/
  SetProp( P_INT_SHORT, "Ein Kaefig");
  SetProp( P_INT_LONG,
     BS("Dieser Kaefig besteht aus Bambus und scheint ziemlich stabil zu sein."
      " An seiner Tuer haengt ein ehernes, aber verrostetes Schloss."
      " Der Kaefig wird von den Kannibalen dazu verwendet, Gefangene muerbe"
      " zu machen. Manche Opfer verrotteten hier oder sie wurden am Pfahl"
      " gefoltert, nachher getoetet und verzehrt. Am Boden liegen noch"
      " ihre Knochen und Ueberreste verstreut."));
  
  /*** Settings fuer Raum ***/
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,  1);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]));
  
  /*** Details fuer Raum ***/
  AddDetail( ({"kannibale","kannibalen"}),
       "Je mehr Du ueber sie herausfindest, desto mehr beginnst du sie zu hassen.");
  AddDetail( ({"boden","decke"}),
       "Der Boden und Decke des Kaefigs besteht aus stabilen Bambus.");
  AddDetail("wand",
       "Der Bambus wird auch hier verwendet.");
  AddDetail( ({"knochen","ueberreste","teil","teile",
		   "leichenteil","leichenteile","leichenteilen"}),
      "Angeekelt von den Leichenteilen, wendest Du Dich ab und uebergibst Dich.");
  AddDetail( ({"opfer","gefangene","menschen"}),
      "Die armen Menschen ...");
  AddDetail("wimmern",
      "Wohl wieder eines der armen Opfer der Kannibalen...");
  AddDetail("kaefig",
      "Im Kaefig kannst Du ein Wimmern hoeren.");
  AddDetail("bambus",
      "DAS solltest Du aber nun wirklich wissen im Dschungel.");
  AddDetail ("dschungel",
      "Du bist schon laenger im Dschungel, also frag' nicht dauernd danach.");
  AddDetail( ({"tuer","tor"}),
      "Auch das Tor zum Kaefig ist aus Bambus und Du kannst ein Schloss"
       " sehen, das den Kaefig verschliesst.");
  AddDetail("schloss",
      "Du hast das Schloss schon laengst geoeffnet.");
  AddDetail(({"kette", "fusskette"}),
      "Die Kette ist schon ziemlich alt und rostig, aber noch"
      " immer zweckdienlich. Die Kette haelt die Gefangene"
      " fest, und um sie zu befreien, muesste man sie irgendwie"
      " durchtrennen oder durchschneiden.");
  AddDetail("pfahl",
      "Du kannst den Pfahl von hier aus sehen.");
      
  /*** Geraeusche ***/
  
  AddSound(DEFAULT_SOUND, "Du kannst ein leises Wimmern im Kaefig hoeren.\n");
  AddSound( ({ "wimmern" }), "Das Wimmern stammt von Carolina, die im Kaefig"
	    " gefangengehalten wird. Arme Frau...!\n");
  
  /*** Commands ***/
  AddCmd( ({"trenn","trenne","durchtrenne","schneid","schneide","durchschneide"}),
	  "durchtrenne_kette");
  
  /*** Exits ***/
  
  //AddExit("raus", ROOM "room_r5:"+getuid(TP));
  
  /*** NPCs ***/
  
  AddItem(NPC "carolina", REFRESH_NONE);
  PO->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

void init()
{
  ::init();
  
  if(!sizeof(QueryProp(P_EXITS)))
    if(TP && interactive(TP))
      {
	AddExit("raus", ROOM "room_r5:"+getuid(TP));
      }
}

/*** Spieler durchtrennt Kette ***/
int durchtrenne_kette (string str)
{
  object kd_quest,caro,b_schneider;
  
  notify_fail ("Was moechtest Du durchtrennen?\n");
  
  if (!str) return 0;
  
  if(!(caro=present("\nkd_carolina")))
    return write(BS("Aber Carolina ist nicht da! Was moechtest Du da durchtrennen?")), 1;

   if(str == "kette durch" || str == "kette")
   {
     /* nachschauen, ob der Spieler den Bolzenschneider schon hat. */
     /* deep_present...auch Beutel, etc. werden durchsucht.        */
     if (b_schneider = deep_present("\nkd_bolzenschneider", TP))
       {
	 /* Checken, ob Spieler ueberhaupt die Quest macht */
	 if(!kd_quest=present("\nkd_quest",TP) )
	   { 
	     write(BS("Du setzt an, um Carolinas Ketten zu durchtrennen, aber"
		      " wirst von Smilander daran gehindert."));
	     say(BS(TP->name()+" setzt an, um Carolinas Ketten zu"
		   " durchtrennen, wird aber von Smilander daran gehindert."));
             TP->move(ROOM "room_r5:"+getuid(TP), M_GO, "aus dem Kaefig");
	     
	     return 1;	
	   }
	 
	 /* Spieler versucht Carolina mehrmals zu befreien. */
	 if (caro->ShowVarGefesselt() == 0)
	   return write("Aber Du hast sie doch schon befreit.\n"), 1;
	 
	 kd_quest->set_quest(KDQ_CAROLINA_BEFREIT);
   	
         write(BS("Du packst die Griffe des Bolzenschneider entschlossen"
		  " und bemuehst Dich, Carolinas Kette zu durchtrennen. Schweiss steigt"
		  " Dir auf die Stirn, als endlich die Kette mit einem Knacken nachgibt."
		  " Allerdings zerbricht Dir auch der Bolzenschneider. War wohl doch nicht"
		  " so stabil, wie er aussah."));
         say(BS(TP->name()+" packt die Griffe des Bolzenschneider"
		" entschlossen und bemuehst sich, Carolinas Kette zu durchtrennen. Nach"
		" einigem Bemuehen gibt die Kette endlich mit einem Knacken nach.")); 
         caro->SetVarGefesselt(0);
         b_schneider->remove(1);
         
         write(break_string("Danke, dass Du mich befreit hast! Dafuer werde ich"
			    " Dir nun helfen. Wie Du weisst, bin ich Anthropologin, daher kann"
			    " ich auch Texte uebersetzen.",
			    78, "Carolina sagt: "));
         return 1;
       }
     
     write("Dir fehlt Entscheidendes.\n");
     
     return 1;
   }
   
   return 0;
}
