inherit "std/virtual/v_compiler";

#include <v_compiler.h>
#include "../def.h"

#define P_VALID_NAME "valid_name"

void create()
{
  ::create();
  
  SetProp(P_COMPILER_PATH, ROOM "");
  SetProp(P_STD_OBJECT, ROOM "room_r3");
  SetProp(P_VALID_NAME, ({"room_r3","room_r2","room_r1","room_r5",
		"room_r7","room_r8","room_k","kochtopf","kaefig","room_r6",
		"room_r4"}) );
}

string Validate(string file)
{
  string path, who, name;
  
  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      (who==lower_case(who)))
    {
      SetProp(P_STD_OBJECT, ROOM ""+name);
      
      return file;
    }
}

int CustomizeObject()
{
  string name,foo, who;
  
  name = ::CustomizeObject();

  if (!name || (sscanf(name,"%s:%s",foo,who)!=2))
    return 0;
  
  return 1;
}

