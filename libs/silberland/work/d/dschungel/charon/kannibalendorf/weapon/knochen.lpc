/*
** Knochen im Kannibalendorf
** 09.02.1999  V1.0  Charon@SL
*/
/*** Danke an Dante fuer die erste Version ***/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include "../defines.h"

create()
{
   if (!is_clone(this_object()))
      return;

   ::create();

   AddId( ({"knochen","\nkd_knochen"}) );  

   /*** OBJ properties ***/
   
   SetProp(P_SHORT, "Ein Knochen");
   SetProp(P_LONG, "Dieser Knochen hat einmal einem Abenteurer wie Dir gehoert."
    + " An seiner Oberflaeche fallen Dir merkwuerdige Einkerbungen auf. Er ist"
    + " ziemlich schwer und sicher auch als Waffe zu gebrauchen."
    );
   
   SetProp(P_NAME,        "Knochen");
   SetProp(P_GENDER,      MALE);
   SetProp(P_VALUE,       150);
   SetProp(P_WC,          50);
   SetProp(P_WC_FIX,      0);
   SetProp(P_WEAPON_TYPE, WT_CLUB);
   SetProp(P_MATERIAL,    MAT_HORN);
   SetProp(P_WEIGHT,      2000);
   SetProp(P_SIZE,        70);
   SetProp(P_NR_HANDS,    1);
   SetProp(P_DAM_TYPE,    DT_BLUDGEON);
  
   /*** OBJ Details ***/

   AddDetail( ({"einkerbung","einkerbungen","oberflaeche"}),
      "Mit Grausen stellst Du fest, dass die Einkerbungen von Zaehnen"
    + " wilder Tiere herruehren. Den frueheren Besitzer muss ein furchtbares"
    + " Schicksal ereilt haben...");
}
