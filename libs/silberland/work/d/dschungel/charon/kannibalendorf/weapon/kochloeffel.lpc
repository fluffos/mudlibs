/*
** Obj: Der Kochloeffel von Frissdibled(tm)
** Map: Kannibalendorf
** Von: Charon@SL  
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object()))
     return;

  ::create();

  SetProp(P_SHORT, "Frissdibleds Kochloeffel");
  SetProp(P_LONG, 
     "Ein grosser Kochloeffel zur Verwendung mit einem grossen Kessel."
   + " Er besteht aus hartem Tropenholz und ist grob geschnitzt."
   + " Durch seine Groesse und Schwere ist er in den richtigen Haenden"
   + " eine nicht ungefaehrliche Waffe.\n"
   );

  SetProp(P_NAME, "Kochloeffel");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, "Frissdibleds Kochloeffel besteht vollstaendig aus hartem"
   + " Tropenholz. Er besitzt keine magischen Eigenschaften.\n"
   );

  AddId( ({"\nkd_kochloeffel","kochloeffel","loeffel"}) );

  SetProp(P_VALUE,         50);
  SetProp(P_WEIGHT,        2500);   /* in Gramm */
  SetProp(P_WEAPON_TYPE,   WT_CLUB);
  SetProp(P_DAM_TYPE,      DT_BLUDGEON);
  SetProp(P_WC,            90);
  SetProp(P_WC_BONUS,      (["frissdibled":90]) );
  SetProp(P_NR_HANDS,      2);  /* Bedienung nur mit 2 Haenden moegl. */
  SetProp(P_WC_FIXFACTOR,  0.2);
  SetProp(P_MATERIAL,      ([MAT_MISC_WOOD:100]) );
  SetProp(P_QUALITY_DECAY, 30);

  /* Anpassung der Default-Meldungen fuer Waffen */ 

  SetProp(P_WIELD_TEXT,
   ({"Du packst Frissdibleds Kochloeffel mit beiden"
   + " Haenden am langen Griff.\n",
     " packt einen grossen, ekelig stinkenden Kochloeffel und schwingt ihn"
   + " am langen Griff.\n"
   }) );
  SetProp(P_UNWIELD_TEXT,
   ({"Du steckst den Kochloeffel weg.\n",
     " steckt einen grossen, stinkenden Kochloeffel weg.\n"
   }) );
  SetProp(P_NOSELL, "Das wuerde Dir Frissdibled NIE verzeihen!\n");
}
