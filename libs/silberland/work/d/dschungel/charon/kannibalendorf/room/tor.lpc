/*
** Tor - Eingang zu Kannibalendorf
** 22.12.1998  V1.0  Charon@SL
*/

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp( P_INT_SHORT, "Das Tor zum Kannibalendorf");
   SetProp( P_INT_LONG,
      "Du stehst vor dem riesigen, hoelzernen Tor, das den Eingang zum"  
      " Kannibalendorf darstellt.\n"
      "Als Du Deinen Blick nach links und rechts schweifen laesst, erkennst"
      " Du einen riesigen Pfahlzaun, der das gesamte Dorf zu umgeben scheint." 
      " Doch alles wird von dem imposanten Tor ueberragt, das von zwei"
      " kraeftigen Kannibalen bewacht wird. Neben den beiden Torfluegel"
      " kannst Du neben Beutestuecken aus den Raubzuegen der Menschenfresser"
      " auch noch einige Deiner gluecklosen Vorgaenger haengen sehen."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/
   AddDetail("boden",
       "Der Boden ist wie im Dschungel ueblich feucht und weich."
       );
   AddDetail("himmel",
       "Durch das dichte Gruen des Dschungels kannst Du nur vereinzelt"
     + " den blauen Himmel blitzen sehen."
     );
   AddDetail( ({"dschungel","dschungels","vegetation","gruen"}),
       "Du siehst rund um Dich nur ueppige, gruene Vegetation."
       );    
   AddDetail( ({"zaun","pfahl","pfaehle","pfahlzaun","schutz"}), 
       "Die Hoehe des Zaunes und die 'netten' Kleinigkeiten, welche die Kannibalen"
     + " zum Schutz ihres Dorfes auf den Pfaehlen befestigt haben, machen es"
     + " unmoeglich ueber den Zaun zu klettern."
     );
   AddDetail("kleinigkeiten",
       "Als Du die Kleinigkeiten genauer ansiehst, faellt Dir auf,"
     + " dass es toedlich sein kann, ueber den Zaun zu klettern."
     );
   AddDetail( ({"dorf","dorfes","kannibalendorf"}),
       "Du stehst vor dem Dorf der Menschenfresser."
       );
   AddDetail( ({"tor","torfluegel","fluegel","eingang"}),
       "Das Tor besteht aus zwei riesigen Torfluegeln, gefertigt aus den"
     + " Hoelzern des Dschungels."
     );
   AddDetail( ({"hoelzer","hoelzern"}),
       "Die Kannibalen haben nur die haertesten Hoelzer aus dem Dschungel"
     + " genommen."
     );
   AddDetail( ({"beutestuecke","beute","stuecke","waffen",
   	         "ruestungen","gegenstaende" }),
       "Du siehst Waffen, Ruestungen und andere Gegenstaende, welche die Kannibalen"
     + " auf ihren Beutezuegen erbeutet haben."
     );
   AddDetail( ({"beutezuege","raubzuege","beutezuegen","raubzuegen"}),
       "Ja, die Kannibalen lieben es, Beutezuege zu veranstalten."
       );
   AddDetail( ({"vorgaenger","kaempen"}),
       "Du siehst die Ueberreste von wackeren Kaempen, die nicht so viel Glueck"
     + " hatten, aus dem Dorf lebend zu entkommen."
     );
   AddDetail( ({"kannibalen","kannibale","menschenfresser"}),
       "Die Kannibalen sehen ziemlich furchterregend aus."
       );
   AddDetail("ueberreste",
       "Du siehst die vermoderten Ueberreste Deiner gluecklosen Vorgaenger."
       );
   AddDetail("blick",
       "Du hast Deinen Blick nach links und rechts schweifen lassen."
       );
   AddDetail("glueck",
       "Ja, Du hattest viel Glueck...bis jetzt!"
       );
   AddDetail("hoehe",
       "Der Zaun ist ziemlich hoch."
       );
   AddDetail( ({"ader","adern","blut"}),
      "Das Blut rauscht durch die Adern und laesst Dich leben."
      );
   AddDetail( ({"mal","sterben"}),   
      "Jeder muss einmal sterben."
      );
   AddDetail( "waechter",   
      "Die beiden Waechter grunzen, weil sie Dir zeigen wollen, dass"
    + " Du nun besser verschwinden solltest."
    );

   /*** Geraeusche ***/
     
   AddSound(DEFAULT_SOUND, "Du hoerst das laute Grunzen der beiden Waechter.\n");
   AddSound( ({"grunzen"}), "Dieses Grunzen laesst Dir das Blut in den Adern"
    + " gefrieren - und Du denkst das erste Mal ans Sterben.\n"
      );
   
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, "Du riechst den Todesschweiss Deiner gluecklosen Vorgaenger.\n");
   AddSmell( ({"todesschweiss","schweiss"}), "Scharf und stechend.\n"
    );   
    
   /*** Commands ***/
   AddCmd("kletter", "kletter_zaun");
       
   AddExit("norden",  ([
 //          EX_DEST   : KD_ROOM("room_r3:"+getuid(this_player())),
           EX_FUNC   : "rausfunc",
           EXG_ID    : "kannibalen_wache",
           EXG_PLMSG : "@@killhim@@Der Kannibale laesst dich nicht vorbei!\n",
           EXG_RMMSG : "Der Kannibale laesst @wen@ nicht passieren.\n"
           ]) );
   AddExit("sueden", "./room_r11:"+getuid(this_player()));
   
   /*** NPCs ***/
   AddItem( KD_NPC("haudibled"), REFRESH_DESTRUCT);
   AddItem( KD_NPC("hauditot"),  REFRESH_DESTRUCT);

   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

string rausfunc() {
  if (!interactive(this_player())) return "";
  return KD_ROOM("room_r3:"+getuid(this_player()));
 }

/*** Spieler versucht, ueber Zaun zu klettern ***/
int kletter_zaun (string str)
{
   notify_fail ("Wohin willst Du klettern?\n");

   if (!str) return 0;
   if (str=="ueber zaun" || str=="auf zaun")
   {
   	write(break_string("Diverse 'Kleinigkeiten' erlassen es als gesundheitsschaedlich"
   	   " erscheinen, ueber den Zaun zu klettern.\n"));
   	return 1;
   }
   return 0;
}

/*** Spieler attackieren bei versuchtem Durchschreiten ***/
string killhim()
{
   catch(present("kannibalen_wache", this_object())->Kill(this_player()));
   return "";
}

