/*
** R12 - Trampelpfad
** 17.02.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Ein Trampelpfad");
   SetProp(P_INT_LONG,
      "Du kannst in der Ferne schon wieder die Lichtung sehen,"
      " von der Du aufgebrochen bist. Ansonsten umgibt Dich nur"
      " gruene Vegetation."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/
   
   AddDetail( ({"boden","pfad","trampelpfad","pfades"}),
       "Der Pfad fuehrt mitten durch den Dschungel und besteht aus"
     + " festgetrampelten Lehm."
       );
   AddDetail("himmel",
       "Du kannst den wolkenlosen Himmel ueber Dir erkennen."
       );
   AddDetail( ({"vegetation"}),
       "Sie ist mannshoch und gruen, gruen, gruen."
       );    
   AddDetail( "dschungel",
      "Wenn Du nicht bald hier rauskommst, dann verlaeufst Du Dich"
    + " im Dschungel bestimmt noch."
      );
   AddDetail( "stille",
      "Du kannst nichts hoeren...sehr verdaechtig."
      );
   AddDetail( ({"vogel","tier","tiere"}),
      "Du kannst sie weder sehen noch hoeren."
      );
   AddDetail( "lehm",
      "Der Pfad besteht aus festgetrampeltem Lehm, Du kannst nichts"
    + " Besonderes daran erkennen."
    );
   AddDetail( "besonderes",
      "Es gibt wirklich nichts zu sehen."
      );
   AddDetail( ({"lichtung","ferne"}),      
      "Du hast dort Kai getroffen."
      );
   AddDetail( ({"kai","vater"}),
      "Den Vater von Carolina."
      );
   AddDetail( "carolina",
      "Du solltest hingehen und ihn selbst fragen."
      );
   AddDetail( ({"platzregen","regen"}),
      "Es regnet hier sehr haeufig und auch sehr viel."
      );
      
   /*** Geraeusche ***/
     
   AddSound(DEFAULT_SOUND, "Du kannst absolut nichts hoeren, auch die normalen"
      + " Geraeusche des Dschungels sind verstummt, und Du fragst Dich warum.\n"
      );
   AddSound( ({"dschungel","geraeusch","geraeusche"}), "Du kannst eben"
     + " diese Geraeusche nicht hoeren.\n"
      );
      
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, "Es riecht nach feuchtem Lehm.\n");
   AddSmell( ({"lehm"}), "Der kuerzliche Platzregen ist fuer diesen"
    + " Geruch verantwortlich.\n"
    );   
   AddSmell( ({"geruch"}), "Du denkst nach...es riecht"
    + " nach feuchtem Lehm.\n"
    );  
       
   /*** Commands ***/
   
   /*** Exits ***/
   AddExit("westen", "./room_r9:"+getuid(this_player()));
   AddExit("norden", "./room_r11:"+getuid(this_player()));
   
   /*** NPCs ***/

   /*** OBJs ***/
   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/
