/*
** R8 - Raum des Haeuptlings
** 15.01.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

reset()
{
  ::reset();	
  if (!is_clone(this_object())) return;
  RemoveExit("loch");
  RemoveDetail("loch");
}
void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp( P_INT_SHORT, "Huette des Haeuptlings");
   SetProp( P_INT_LONG,
      "Als Du endlich durch die schweren, gewobenen Vorhaenge trittst,"
      " bleibst Du wie angewurzelt stehen. Du bist ueberwaeltigt von der"
      " Pracht dieser Huette. Die Kannibalen scheinen wirklich nicht gespart"
      " zu haben, um ihrem Haeuptling eine beeindruckende Behausung"
      " zu geben. Du erkennst mitten im Raum einen Podest, auf dem ein"
      " Thron steht und auf diesem sitzt der Haeuptling. Links und rechts"
      " vom Thron kannst Du zwei Gefaesse erkennen, in denen Flammen lodern,"
      " um den Raum zu erleuchten. An den Waenden sind zahlreiche"
      " Gegenstaende zu erkennen, die der Haeuptling seinen (jetzt toten)"
      " Gegnern abgenommen hat. Aber ueberstrahlt wird alles von einem,"
      " wie Du annimmst, goldenen Schild, das an der hinteren Wand haengt."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,  1);
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/
   AddDetail( ({"huette","behausung"}),
      "Du stehst nun mitten in der Huette des Haeuptlings."
      );
   AddDetail( ({"pracht"}),
      "Du bist wirklich sehr beeindruckt, was die Kannibalen aus"
    + " dieser schlichten Huette gemacht haben. An den Waenden"
    + " haengen diverse Gegenstaende und Zierate, die wohl frueher"
    + " anderen Besitzern gehoert haben."
    );
   AddDetail( ({"raum"}),
      "Sieh Dich bitte genauer um."
    );
   AddDetail( ({"zierat","zierate","gegenstand","gegenstaende","gegenstaenden"}),
      "Als du die Gegenstaende und Zierate genauer untersuchst,"
    + " faellt Dir dieser eigenartige Geruch auf. Er scheint von"
    + " den Gegenstaenden auszugehen. Du kannst wiederum vielerlei"
    + " Waffen erkennen, die wohl frueher auch nicht den Kannibalen"
    + " gehoert haben. Ausserdem siehst Du reich verzierte"
    + " Gegenstaende, deren Zweck Du nicht ergruenden kannst."
    + " Besonders aber faellt Dir ein Schild an der hinteren Wand"
    + " auf."
    );
   AddDetail( ({"waffe","waffen"}),
      "Wirklich wunderschoen anzusehende Waffen, aber wahrscheinlich"
    + " genauso toedlich."
    );
   AddDetail( ({"wand","waende"}),
      "Sie bestehen natuerlich auch aus Bambus und sind mit"
    + " vielerlei Gegenstaenden und Ziraten behangen. An der hinteren"
    + " Wand haengt ein riesiger Schild."
    );
   AddDetail( ({"boden","erde"}),
       "Der Boden der Huette besteht aus gestampfter Erde."
     + " Aber diesmal scheint der Boden ziemlich sauber zu sein."
     );
   AddDetail("decke",
      "Bambus..kunstvoll geflochten."
      );
   AddDetail( ({"bambus","baumaterial"}),
      "Der Bambus eignet sich hervorragend als Baumaterial, weil er einerseits"
    + " sehr stabil, aber doch biegsam ist, andererseits ist er hier leicht im"
    + " Dschungel zu finden."
    );
   AddDetail( ({"dschungel","dschungels"}),
     "Die Huette des Haeuptlings befindet sich auch mitten im Dschungel."
     );    
   AddDetail( ({"kannibalen","kannibale","menschenfresser"}),
     "Mit den Kannibalen ist nicht zu spassen."
     );    
   AddDetail( ({"haeuptling","haeuptlings"}),
      "Den Haeuptling kannst Du nicht sehen, wahrscheinlich ist er"
    + " im Raum hinter den Vorhaengen zu finden."
    );
   AddDetail( ({"vorhang","vorhaenge","vorhaengen"}),
      "Die Vorhaenge bestehen aus schlecht gewobenem Stoff,"
    + " erfuellen aber ihren Zweck."
      );
   AddDetail( "zweck",
      "Was ist wohl der Zweck von Vorhaengen?"
      );
   AddDetail( "stoff",
      "Ein ziemlich grob gewebter Stoff, der zeigt, dass die Kannibalen"
    + " besser mit Waffen als mit der Nadel umgehen koennen."
    );
   AddDetail( "nadel",
      "Du weisst schon...naehen!"
      );
   AddDetail( ({"gefaess","gefaesse"}),
      "Sie sind wohl mit einer brennbaren Fluessigkeit gefuellt,"
    + " denn die Flammen schlagen hoch aus ihnen heraus."
    );     
   AddDetail( ({"flamme","flammen"}),
      "Sie lodern hoch und unstet. Geistesabweisend starrst Du in"
    + " die Flammen."
    );
   AddDetail( "fluessigkeit",
      "Du hast angenommen, dass es eine normale brennbare Fluessigkeit"
    + " sein muss, aber nun musst Du erkennen, dass Du Dich getaeuscht hast."
    + " Wie alles bei den Menschenfressern werden auch hier rein"
    + " organische Mittel benutzt. Hier ist es eine Mischung aus"
    + " Blut und anderen undefinierbaren Ingredenzien."
    );
   AddDetail( ({"blut","ingredenzien","mittel","mischung"}),
      "Dir graut, wenn Du Dir vorstellst, wie diese brennbare"
    + " Fluessigkeit hergestellt wird. War das nicht gerade ein"
    + " Auge, das mitten im Gefaess zu sehen war?"
    );
   AddDetail( "auge",
      "Es war ein Auge."
      );
   AddDetail( ({"gegner","besitzer","besitzern"}),
      "Nun ja..aufregen koennen sich die frueheren Besitzer sicher nicht"
    + " mehr, denn jetzt sind sie ja tot."
    );
   AddDetail( "geruch",
      "Was muss man da tun?"
      );
   AddDetail( "podest",
      "Damit der Haeuptling noch beeindruckender wirkt, haben seine"
    + " Kannibalen den Thron auf ein Podest aus Menschenknochen"
    + " gestellt. Damit jeder gleich weiss, dass er es mit einem"
    + " Haeuptling der Kannibalen zu tun hat."
    );
   AddDetail( ({"knochen","menschenknochen","ueberreste"}),
      "Das sind die Ueberreste der gluecklosen Gegner des"
    + " Haeuptlings. Du wirst sehen, ob Dir mehr Glueck beschieden"
    + " ist."
    );
   AddDetail( "glueck",
      "Ja, Glueck kannst Du brauchen...fang' schon mal an zu beten."
      );
   AddDetail( ({"thron","meisterwerk","Menschenschaedellegekunst"}),
      "Der Thron ist ein Meisterwerk der Menschenschaedellegekunst."
    + " Du bist wahrlich beeindruckt und fragst Dich, wie eine so"
    + " filigrane Konstruktion, den fetten Haeuptling aushalten kann."
    + " Als du genauer hinsiehst, kannst du in manchen Schaedeln"
    + " noch die vertrockneten Augen erkennen."
    );
   AddDetail( "konstruktion",
      "Die Konstruktion scheint sehr filigran, aber dennoch"
    + " stabil zu sein."
    );
   AddDetail( ({"schaedel","schaedeln"}),
      "In manchen steckt noch ein Auge."
      );
   AddDetail( ({"auge","augen"}),
      "Es blickt Dich genau an und Du schrickst zurueck."
      );
   AddDetail( "schild",
      " Ein schwerer, goldener Schild. Du siehst das Abbild eines"
    + " Tieres auf ihm."
    );
   AddDetail( ({"bild","abbild","tier","tieres"}),
      " Das Abbild ist kunstvoll gearbeitet und zeigt einen"
    + " Tiger, der sein Opfer aus dem Dschungel anfaellt."
    );
   AddDetail( "opfer",
      "Sei froh, dass du nicht anstelle des bedauernswerten Opfers bist."
      );
   AddDetail( "tiger",
      "Das Abbild ist schoen gearbeitet, Du kannst jede Straehne des"
    + " Fells erkennen. Mit einer Pfote stuetzt sich der Tiger auf"
    + " einem Fels ab."
    );
   AddDetail( ({"straehne","fell"}),
      "Das Fell scheint fast lebendig zu sein."
      );
   AddDetail( "pfote",
      "Der Tiger stuetzt sich mit ihr auf einen Fels."
      );
   AddDetail( "fels",
      "Der Fels springt Dich foermlich an, ausserdem ist er"
    + " weiter vom restlichen Bild abgehoben und weist eine"
    + " blanke Stelle auf."
    );
   AddDetail( "stelle",
      "Ziemlich blank poliert durch haeufiges Druecken, wie Dir scheint."
      );
   AddDetail( "benutzen",
      "Wie kann man etwas benutzen, was blank poliert ist?"
      );
     
   /*** Geruch ***/
   AddSmell(DEFAULT_SMELL, "Es riecht nach Verwesung.\n");
   AddSmell( ({"verwesung"}), "Dir wird fast uebel bei diesem Geruch."
    + " Wahrscheinlich ruehrt er von den Menschenknochen und dem, was"
    + " noch an den Knochen dranhaengt, her."
    );
    
   /*** Commands ***/
   AddCmd( ({"drueck","druecke"}), "drueck_stelle"); 
   
   /*** Exits ***/

   AddExit("osten", "./room_r7:"+getuid(this_player()));
      
   /*** NPCs ***/

   AddItem( KD_NPC("furzian"), REFRESH_DESTRUCT);
   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

/*** Spieler holt Infos von Gefangener ***/
int drueck_stelle(string str)
{
   notify_fail ("Was moechtest Du denn druecken?\n");

   if(!str) return 0;
   if(str == "stelle")
   {
      write(break_string("Du drueckst auf die blankpolierte Stelle"
       + " und wie von Geisterhand schwingt der Thron zur Seite"
       + " und gibt einen Durchgang frei.\n"
       ));
      say(break_string(this_player()->name()+" beruehrt die Wand und"
       + " wie von Geisterhand schwingt der Thron zur Seite"
       + " und gibt einen Durchgang frei.\n"
       ));
      
      AddExit("durchlass",  ([
        //   EX_DEST   : "./kochtopf",
           EX_FUNC   : "kochtopffunc",
           EXG_ID    : "furzian",
           EXG_PLMSG : "@@killhim@@Der Haeuptling der Kannibalen laesst Dich nicht vorbei!\n",
           EXG_RMMSG : "Der Haeuptling der Kannibalen laesst @wen@ nicht passieren.\n"
           ]) );
      AddDetail("loch",
         "Das Loch scheint irgendwo hinzufuehren...vielleicht solltest Du mal reingehen."
         );
      return 1;
   }
   return 0;
}

string kochtopffunc() {
  if (!interactive(this_player())) return "";
  return KD_ROOM("kochtopf:"+getuid(this_player()));
}

string killhim()
{
   catch(present("\nkd_furzian", this_object())->Kill(this_player()));
   return "";
}
