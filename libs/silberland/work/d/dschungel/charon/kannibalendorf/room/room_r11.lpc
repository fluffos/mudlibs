/*
** R11 - Trampelpfad
** 17.02.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Ein Trampelpfad");
   SetProp(P_INT_LONG,
      "Der Trampelpfad schlaengelt sich vorbei an mannshoher Vegetation."
      " Dir kommt die eigenartige Stille verdaechtig vor, denn Du kannst"
      " keinen Vogel oder andere Tiere hoeren...verdaechtig."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/
   
   AddDetail( ({"boden","pfad","trampelpfad","pfades"}),
       "Der Pfad fuehrt mitten durch die Vegetation und besteht aus"
     + " festgetrampelten Lehm."
       );
   AddDetail("himmel",
       "Du kannst den wolkenlosen Himmel ueber Dir erkennen."
       );
   AddDetail( ({"vegetation"}),
       "Sie ist mannshoch und gruen, gruen, gruen."
       );    
   AddDetail( "stille",
      "Du kannst nichts hoeren...sehr verdaechtig."
      );
   AddDetail( ({"vogel","tier","tiere"}),
      "Du kannst sie weder sehen noch hoeren."
      );
   AddDetail( "lehm",
      "Der Pfad besteht aus festgetrampeltem Lehm, Du kannst nichts"
    + " Besonderes daran erkennen."
    );
   AddDetail( "besonderes",
      "Es gibt wirklich nichts zu sehen."
      );
   AddDetail( "abenteurer",
      "Du bist auch einer."
      );
   AddDetail( "leben",
      "Du haengst sehr daran."
      );
   AddDetail( "lebewesen",
      "Die Lebewesen haengen auch am Leben."
      );
   AddDetail( "naehe",
      "Du kannst niemand in Deiner Naehe sehen."
      );
   AddDetail( "geruch",
      "Du musst riechen."
      );   
       
   /*** Geraeusche ***/
     
   AddSound(DEFAULT_SOUND, "ABSOLUTE STILLE!\n");
   
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, "Du glaubst den Geruch von Angst und Tod zu riechen!\n");
   AddSmell( ({"geruch","angst","tod"}), "Du kennst diesen Geruch als weitgereister Abenteurer -"
    + " so riecht es, wenn in der Naehe Lebewesen ihr Leben lassen mussten.\n"
    );   
      
   /*** Commands ***/
   
   /*** Exits ***/
   AddExit("westen", "./room_r10:"+getuid(this_player()));
   AddExit("sueden", "./room_r12:"+getuid(this_player()));
   AddExit("norden", ([EX_FUNC: "torfunc"]));
   
   /*** NPCs ***/

   /*** OBJs ***/
   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

string torfunc() {
  if (!interactive(this_player())) return "";
  return KD_ROOM("tor:"+getuid(this_player()));
}
