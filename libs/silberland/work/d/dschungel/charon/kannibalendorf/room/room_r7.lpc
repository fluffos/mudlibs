/*
** R7 - Raum der Wache des Haeuptlings
** 14.01.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp( P_INT_SHORT, "Vorraum der Haeuptlingshuette");
   SetProp( P_INT_LONG,
      "Du betrittst den Vorraum der Haeuptlingshuette. Obwohl es hier"
      " ziemlich dunkel ist, kannst Du doch einiges erkennen. Der"
      " riesige Waechter ist wohl kaum zu uebersehen, selbst wenn Du"
      " blind waerest. Der Raum ist spartanisch ausgeschmueckt, denn die"
      " Kannibalen wollten nur den Raum ihres Haeuptlings zu einer"
      " beeindruckenden Behausung machen. Durch die gewobenen Vorhaenge"
      " kannst Du in das Innere der Huette spaehen, und schon dieser"
      " kurze Blick laesst Dich vor Ehrfurcht erschaudern."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,  1);
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/
   AddDetail( ({"huette","huetten","haeuptlingshuette"}),
       "Du stehst in einem Vorraum der Huette des Haeuptlings."
       );
   AddDetail( ({"vorraum"}),
       "Wie oft denn noch...Du stehst in einem Vorraum der Huette"
     + " des Haeuptlings."
       );
   AddDetail( ({"raum"}),
       "Obwohl spartanisch geschmueckt, erfuellt Dich Ehrfurcht."
     + " Ob das an der Wache oder an der Einrichtung liegt,"
     + " kannst Du aber nicht sagen."
       );
   AddDetail( "einrichtung",
       "Eigentlich ziemlich wenig, abgesehen von den ueblichen"
     + " Ziraten an den Waende - und die Ueberreste am Boden nicht"
     + " zu vergessen. "
     );
   AddDetail( ({"zirat","zirate","waffe","waffen"}),
      "Du erkennst Waffen montroeser Groesse und fragst Dich, wie"
    + " wohl die Traeger erst ausgesehen haben muessen. Besonders"
    + " beeindruckend aber findest Du eine Skizze an der Wand."
    );
   AddDetail( "groesse",
      "Du erkennst wirklich grosse Waffen."
      );
   AddDetail( "traeger",
      "Die Traeger der Waffen muessen ungeheuer stark gewesen sein."
    + " Aber wie stark muessen dann erst diejenigen gewesen sein,"
    + " die die Traeger besiegt haben???"
    );
   AddDetail( ({"wand","waende"}),
      "Sie bestehen auch aus Bambus und erscheinen Dir nicht"
    + " nicht aussergewoehnlich, wenn man von der Skizze an der"
    + " einen Wand absieht."
    );
   AddDetail( "skizze",
      "Die Skizze zeigt eine Kampfszene."
      );
   AddDetail( ({"kampfszene","kampf","szene","schlacht"}),
      "Du erkennst eine riesige Schlacht. Du siehst ueberall nur Blut"
    + " und bist froh, dass Du bei diesem Kampf nicht dabei warst."
    + " Die Kannibalen sind durch und durch blutruenstig."
    );
   AddDetail( "blut",
      "Du siehst ueberall in dieser Szene nur Blut."
      );
   AddDetail( ({"boden","erde"}),
       "Der Boden der Huette besteht aus gestampfter Erde."
     + " Du siehst - wie immer - Ueberreste der frueheren"
     + " Mahlzeiten am Boden verstreut liegen."
     );
   AddDetail("decke",
       "Bambus..was sonst?"
     );
   AddDetail( ({"bambus","baumaterial"}),
       "Der Bambus eignet sich hervorragend als Baumaterial, weil er einerseits"
     + " sehr stabil, aber doch biegsam ist, andererseits ist er hier leicht im"
     + " Dschungel zu finden."
     );
   AddDetail( ({"dschungel","dschungels"}),
     "Die Huette befindet sich auch mitten im Dschungel."
     );    
   AddDetail( ({"kannibalen","kannibale","menschenfresser"}),
     "Mit den Kannibalen ist nicht zu spassen."
     );    
   AddDetail( ({"knochen","mahlzeit","mahlzeiten","ueberreste"}),
      "Du siehst verblichene Knochen, die scheinbar schon laenger hier"
    + " liegen, aber auch Knochen, die frisch von den"
    + " Menschenfressern angenagt aussehen."
    );
   AddDetail( ({"haeuptling","haeuptlings"}),
      "Den Haeuptling kannst Du nicht sehen, wahrscheinlich ist er"
    + " im Raum hinter den Vorhaengen zu finden."
    );
   AddDetail( ({"vorhang","vorhaenge"}),
      "Nicht sehr beeindruckend der Stoff, aber zweckdienlich."
      );
   AddDetail( "stoff",
      "Ein ziemlich grob gewebter Stoff, der zeigt, dass die Kannibalen"
    + " besser mit Waffen als mit der Nadel umgehen koennen."
    );
   AddDetail( "nadel",
      "Du weisst schon...naehen!"
      );
   AddDetail( "blick",
      "Dein Blick schweift in das Innere der Huette."
      );
   AddDetail( ({"innere","behausung"}),
      "Du musst scheinbar doch hineingehen, wenn Du mehr sehen willst."
      );
   AddDetail( "ehrfurcht",
      "Du erbebst schon fast."
      );
   AddDetail( ({"wachen","wache","waechter"}),
      "Der sieht nicht sehr freundlich aus."
      );     
    
   /*** Geruch ***/
    
   /*** Commands ***/
    
   /*** Exits ***/
   AddExit("sueden", "./room_r6:"+getuid(this_player()));
   AddExit("westen",  ([
         //  EX_DEST   : "./room_r8",
           EX_FUNC   : "r8func",
           EXG_ID    : "losdinetdurch",
           EXG_PLMSG : "@@killhim@@Der Kannibale laesst Dich nicht vorbei!\n",
           EXG_RMMSG : "Der Kannibale laesst @wen@ nicht passieren.\n"
           ]) );           
   
   /*** NPCs ***/
   AddItem( KD_NPC("losdinetdurch"), REFRESH_DESTRUCT);
   previous_object()->CustomizeObject();
}

string r8func() {
  if (!interactive(this_player())) return "";
  return KD_ROOM("room_r8:"+getuid(this_player()));
}

string killhim()
{
   catch(present("\nkd_losdinetdurch", this_object())->Kill(this_player()));
   return "";
}
