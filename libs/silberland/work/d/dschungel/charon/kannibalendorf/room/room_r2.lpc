/*
** R2 - Raum mit Zettel
** 22.12.1998  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

#define MAX_WUEHLEN   3

object zettel,kot;
int cnt_wuehlen = MAX_WUEHLEN;

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/

   SetProp( P_INT_SHORT, "Eine dunkle Ecke im Dorf");
   SetProp( P_INT_LONG, "Diese versteckte, halbdunkle Ecke scheinen die"
      " Kannibalen fuer besondere Zwecke zu benutzen. Es riecht hier sehr"
      " streng und Dein Gesicht verfaerbt sich schon blau. Der 'Duft' wird"
      " naeher zum Boden immer staerker."
      );

   /*** Settings fuer Raum ***/

   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/

   AddDetail("ecke",
      "Eine abgeschiedene, dunkle Ecke am Rande des Dorfes."
      );
   AddDetail( ({"rande","rand"}),
      "Die Ecke befindet sich am aeussersten Rand des Dorfes - warum wohl?"
      );
   AddDetail( ({"dorf","dorfes","kannibalendorf"}),
      "Du weisst es doch schon...Du bist im Kannibalendorf."
      );
   AddDetail("himmel",
      "Du kannst den Himmel nicht sehen."
      );
   AddDetail("boden",
      "Der Boden ist eigenartig weich und nachgiebig, ausserdem erzeugt er"
    + " ein schmatzendes Geraeusch beim Gehen."
    );
   AddDetail("geraeusch",
      "'Sehen' kann man ein Geraeusch nicht."
      );
   AddDetail( ({"scheisse","faekalien","masse"}),
      "Eine zaehfluessige, in allen Braunschattierungen gefaerbte breiige Masse,"
    + " in der Du gerade herumstapfst. Du solltest Deine Fuesse nachher besonders"
    + " sorgfaeltig waschen. Du fragst Dich, ob es Spass machen wuerde, hier zu"
    + " wuehlen."
    );
    AddDetail("Braunschattierungen",
       "So sehen Faekalien einfach aus."
       );
    AddDetail( ({"fuss","fuesse"}),
       "Bitte..wasche sie nachher."
       );
    AddDetail( ({"duft","geruch"}),
       "Du koenntest ja mal riechen."
       );
    AddDetail("gesicht",
       "Dein Gesicht verfaerbt sich schon gruen und blau."
       );
   AddDetail( ({"zwecke","zweck"}),
      "Welcher Zweck koennte das wohl sein?"
      );
   AddDetail( ({"schritt","schritte"}),
      "Deine Schritte versinken im matschigen Boden."
      );
   AddDetail("gehen",
      "Sehr weich und matschig...irgendwie komisch und untypisch fuer das"
    + " Kannibalendorf."
      );
   AddDetail( ({"kannibalen","kannibale"}),
      "Sie sind nicht sehr freundlich."
      );
   AddDetail("latrine",
      "Hier erleichtern sich die Kannibalen."
      );
      
   /*** Geraeusche ***/
   
   AddSound(DEFAULT_SOUND, 
      "Du kannst ein leises Schmatzen Deiner Schritte vernehmen.\n");
   AddSound( ({"schmatzen","boden","schritt","schritte"}), 
      "Deine Schritte erzeugen ein eingenartiges Schmatzen."
    + " Der Boden hier muss sehr feucht sein.\n"
      );
   
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, "Du kannst es nicht glauben...es riecht tatsaechlich nach Sch.....!\n");
   AddSmell( ({"duft","scheisse","boden"}), "Dir wird schlecht, als Du den Geruch"
    + " nun richtig einordnen kannst. Scheinbar stehst Du mitten in der"
    + " Latrine der Kannibalen.\n"
    );
    
   /*** Commands ***/

   AddCmd("wuehle", "wuehle_scheisse");
	AddCmd( ({"scheiss","scheisse"}), "scheisse_latrine");
	
   /*** Exits ***/

   AddExit("westen", "./room_r1:"+getuid(this_player()));
   AddExit("sueden", "./room_r3:"+getuid(this_player()));
   AddExit("norden", "./room_r6:"+getuid(this_player()));   
   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

/*** Spieler will schei.... ***/
int scheisse_latrine(string str)
{
	write(break_string("Du ziehst Deine Hose runter, gehst in die Knie,"
	      " und strengst Dich an. Dein Gesicht laeuft rot und blau an,"
	      " die Anstrengung ist Dir ins Gesicht geschrieben."
   	   " Als Du fertig bist, fuehlst Du Dich unsaeglich erleichtert."
   	   " Wie praktisch, dass die Kannibalen hier eine Latrine hatten.\n")
   	   );
   say(break_string(this_player()->name()+" zieht die Hose runter,"
         " geht in die Knie, und strengt sich an. "+this_player()->name(WESSEN)+
         " Gesicht laeuft rot und blau an, die Anstrengung ist deutlich"
         " erkennbar. "+this_player()->name()+" fuehlt sich unsaeglich erleichtert."
   	   " Wie praktisch, dass die Kannibalen hier eine Latrine hatten.\n")
   	   );
	return 1;
}

/*** Spieler will Scheisse durchwuehlen ***/
int wuehle_scheisse(string str)
{
   notify_fail ("Worin moechtest Du wuehlen?\n");

   if (!str) return 0;
   if (str=="in scheisse")
   {
      if(cnt_wuehlen > 0)
   	 {
   	    cnt_wuehlen--;
         write(break_string("Du wuehlst in den Faekalien der Kannibalen und"
   	       " beschmierst Dich von oben bis unten damit. Dir graut vor Dir"
   	       " selbst. Dennoch willst Du noch ein wenig weiterwuehlen -"
   	       " scheinbar erinnert es Dich an Deine Kindheit.\n")
   	       );
         say(break_string(this_player()->name()+" wuehlt in den Faekalien der"
            " Kannibalen und beschmierst sich von oben bis unten damit.")
   	       );
   	    return 1;
   	 }
   	 else
   	 {
   	 	if (deep_present("\nkd_zettel",this_player()))
   	 	{
   	 		write(break_string("Du fischt in den Faekalien, findest"
             " aber nichts.\n"
             ));
            say(break_string(this_player()->name()+" fischt in den Faekalien,"
             " findet aber nichts.\n"
             ));
   	 	   return 1;	
   	 	}
   	 	
         // euid setzen, damit Objekte gecloned werden koennen
         seteuid(getuid(this_object()));

         // Objekte clonen
         zettel = clone_object( KD_OBJ("zettel") );
         kot    = clone_object( KD_OBJ("kot") );
         
         // Object ins Inventory des Spielers stellen
         if ( (zettel->move(this_player(),M_GET) ) == ME_TOO_HEAVY)
         {
         	write("Du kannst den Zettel nicht mehr tragen!\n");
         	zettel->move(this_object(),M_NOCHECK);
         }
         if ( (kot->move(this_player(),M_NOCHECK) ) == ME_TOO_HEAVY)
         {
         	//do nothing...stinkt er eben net
         	kot->remove();
         }
         
         cnt_wuehlen = MAX_WUEHLEN;
         write(break_string("Von oben bis unten mit Faekalien besudelt, erwischen"
            " Deine Haende einen Zettel und fischen ihn heraus.\n")
            );
         say(break_string(this_player()->name()+" besudelt sich von oben bis unten"
            " mit Faekalien, erwischt aber mit den Haenden einen Zettel und fischt"
            " ihn heraus.\n")
   	       );
         return 1;
   	 }
   }
}
