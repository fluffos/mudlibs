/*
** R5 - Platz im Kannibalendorf
** 22.12.1998  V1.0  Charon@SL
** 15.10.1999  V1.1  Charon@SL - Remove des Schluessels herausgenommen, da
**                               die NPCs nicht mehr bei jedem Reset, wenn sie
**                               tot sind, neu geclont werden.
*/
inherit "/std/room";
inherit "/std/container";
inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

object carolina;
int kaefigtuer_exists = 0;

reset()
{
   ::reset();	
   if (!is_clone(this_object())) return;
   if (kaefigtuer_exists != 0)
  	   RemoveExit("kaefig");

   kaefigtuer_exists = 0;
}

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp( P_INT_SHORT, "Platz im Kannibalendorf");
   SetProp( P_INT_LONG,
      "Du befindest Dich auf einem Platz inmitten des Dorfes. Entfernt kannst Du"
      " den Zaun sehen, der sich um das gesamte Dorf spannt. Auf diesem Platz"
      " duerften die Kannibalen immer ihre Gelage abhalten, denn Du siehst"
      " ungeheuer viele Knochen und andere sterbliche Ueberreste herumliegen."
      " Ein suesslicher Geruch liegt ueber dem verlassenen Platz."
      " In der Mitte des Platzes steht ein Pfahl, rund um diesen sind Baumstaemme"
      " aufgestellt. Aus einer dunklen Ecke hoerst Du leises Wimmern."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/
   AddDetail( ({"huette","huetten"}),
       "Etwas weiter entfernt kannst Du welche erkennen."
       );
   AddDetail("zaun",
       "Du kannst ihn von hier aus sehen."
       );
   AddDetail( ({"kannibale","kannibalen","menschenfresser","wesen"}),
       "Du hast selten so grausame Wesen getroffen."
       );
   AddDetail( ({"boden","platz","platzes"}),
       "Der Boden des Platzes ist von den naechtlichen Gelagen festgetrampelt."
       );
   AddDetail("himmel",
       "Du kannst den wolkenlosen Himmel ueber Dir erkennen."
       );
   AddDetail( ({"dschungel","dschungels"}),
       "Das Kannibalendorf befindet sich mitten im Dschungel."
       );    
   AddDetail( ({"dorf","dorfes","kannibalendorf","platz","platzes"}),
       "Du befindest Dich auf einem Platz im Dorf der Menschenfresser."
       );
   AddDetail( ({"knochen","ueberreste","leichenteilen","leichen","teilen",
                "leiche","teil","teile","rest","reste", "leichenteile"}),
      "Angeekelt von den Leichenteilen, wendest Du Dich ab und uebergibst Dich."
      );
   AddDetail( ({"stamm","staemme","baumstamm","baumstaemme","sitzgelegenheiten","baum","baeumen"}),
      "Grobe zubehauene Staemme aus gefaellten Baeumen, die nun als Sitzgelegenheiten"
    + " bei den animalischen Gelagen der Menschenfresser dienen."
    );
   AddDetail( ({"gelage","gelagen","riten"}),
      "Du hast doch schon sicher von solchen Riten gehoert, wo die Kannibalen"
    + " ihre Opfer zuerst quaelen und schliesslich genuesslich verspeisen."
    );
   AddDetail("opfer",
      "Du kannst ihre Ueberreste ja noch sehen."
      );
   AddDetail( ({"pfahl","mitte"}),
      "Ein kunstvoll geschnitzter Pfahl erhebt sich in der Mitte des Platzes."
    + " Du denkst gerade ueber den Verwendungszweck nach, als Du Blutspuren und"
    + " Eisenketten daran siehst. Voller Entsetzen wendest Du Dich ab."
    );
   AddDetail("verwendungszweck",
      "Welchen Verwendungszweck wird dieser Pfahl wohl haben???"
      );
   AddDetail( ({"blut","spuren","blutspuren"}),
      "Als Du das Blut genauer untersuchst, stellst Du fest, dass es noch warm ist."
    + " Du musst Dich uebergeben."
    );
   AddDetail( ({"ketten","eisenketten"}),
      "Diese Ketten dienen dazu, die Opfer der Kannibalen an den Pfahl zu ketten,"
    + " um sie danach stundenlang foltern und danach verspeisen zu koennen."
    );
   AddDetail( ({"entsetzen","unmenschlichkeit"}),
      "Dir graut vor so viel Unmenschlichkeit."
      );
   AddDetail("ecke",
      "Obwohl es in der Ecke sehr dunkel ist, kannst Du doch einen Kaefig erkennen."
      );
   AddDetail("wimmern",
      "Wohl wieder eines der armen Opfer der Kannibalen..."
      );
   AddDetail("atem",
      "Du kannst schon fast nicht mehr atmen."
      );
   AddDetail("geruch",
      "'Sehen' kannst Du den Geruch nicht ..."
      );
   /* Special Detail */
   AddSpecialDetail("kaefig","unt_kaefig");
   
   AddDetail("bambus",
      "DAS solltest Du aber nun wirklich wissen im Dschungel."
      );
   AddDetail( ({"carolina","frau","forscherin"}),
      "Die Gefangene im Kaefig. Vielleicht solltest Du sie befreien, denn"
    + " bequem schaut dieser Kaefig nicht aus. Und ausserdem...wer weiss"
    + " wann sie von den Kannibalen verzehrt wird. Also, spute Dich..."
    );
   AddDetail("schloss",
      "So einfach wird sich das Schloss nicht oeffnen lassen."
    + " Frag' die Gefangene, ob sie Dir helfen kann."
    );
   AddDetail("gefangene",
      "Du hoerst ein schwaches Wimmern aus einer dunklen Ecke, das"
    + " von der gefangenen Forscherin Carolina stammt. Sie kann"
    + " Dir bestimmt weiterhelfen."
    );

   /*** Geruch ***/
   AddSmell(({DEFAULT_SMELL, "geruch"}), 
       "Es riecht nach Tod.\n");
   AddSmell( ({"tod"}), "Die Ueberreste der Opfer fangen schon an zu"
    + " verfaulen und dieser Geruch nimmt Dir den Atem.\n"
    );
   
   /*** Geraeusche ***/
   AddSound(DEFAULT_SOUND, 
       "Du kannst ein leises Wimmern aus dem Kaefig hoeren.\n");
   AddSound( ({"wimmern"}), 
       "Das Wimmern stammt von Carolina, die im Kaefig"
      " gefangengehalten wird. Arme Frau...!\n"
      );
      
   /*** Commands ***/
   AddCmd("oeffne", "oeffne_schloss");
   AddCmd( ({"frag","frage"}), "frage_gefangene");
   
   /*** Exits ***/
   AddExit("osten",  "./room_r6:"+getuid(this_player()));
   AddExit("sueden", "./room_r1:"+getuid(this_player()));   

   /*** NPCs ***/
   AddItem( KD_NPC("smilander"), REFRESH_DESTRUCT);

   /*** OBJs ***/
   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

string unt_kaefig()
{
	if(kaefigtuer_exists == 0)
		return BS("Du kannst gerade noch einen Kaefig aus Bambus erkennen, aus dem"
       + " ein Wimmern erklingt. Er ist mit einem Schloss versperrt. Du wirst"
       + " es wohl oeffnen muessen, um in den Kaefig zu gelangen.\n");
   else 
   	return BS("Du kannst gerade noch einen Kaefig aus Bambus erkennen, aus dem"
       + " ein Wimmern erklingt. Er steht offen.\n");
}

/*** Spieler holt Infos von Gefangener ***/
int frage_gefangene(string str)
{
  string str1,str2;

  notify_fail ("Was moechtest Du wen fragen?\n");

  if(!str) return 0;
  if (sscanf(str, "%s nach %s",str1,str2) != 2)
    return 0;

  if (str1 == "carolina" || str1 == "gefangene")
  {
    if(str2 == "gefangene")
    {
      write(break_string("Die Kannibalen-Brut hat mich"
            + " eingefangen als ich in der Nacht um das Dorf schlich, um sie"
            + " zu beobachten.", 
            78, "Carolina fluestert: "
            ));
      return 1;
    }
    if(str2 == "kaefig")
    {
      write(break_string("Sie haben mich hier eingesperrt,"
            + " bis sie geruhen mich zu verspeisen. Hol' mich hier raus - Bitte!\n",
            78, "Carolina seufzt: "
            ));
      return 1;
    }
    if(str2 == "schloss")
    {
      write(break_string("Du brauchst einen Schluessel fuer das Schloss.\n",
            78, "Carolina seufzt: "
            ));
      return 1;
    }
    if(str2 == "hilfe")
    {
      write(break_string("Carolina wispert: Befreie mich aus dem Kaefig.\n"));
      return 1;
    }
    if(str2 == "befreien")
    {
      write(break_string("Carolina fluestert: Ein Waechter hat den Schluessel.\n"));
      return 1;
    }
    if(str2 == "schluessel" || str2 == "waechter")
    {
      write(break_string("Finde den richtigen Waechter und toete ihn!"
            " Er hat den Schluessel fuer das Schloss.\n",
            78, "Carolina sagt mit glaenzenden Augen: "));
      return 1;
    }
    if(str2 == "kai" || str2 == "vater")
    {
      write(break_string("Oh, Du hast ihn schon getroffen? Dann muss er noch"
            " leben. Aber Du musst Dich beeilen, um ihm zu helfen.\n",
            78, "Carolina sagt mit glaenzenden Augen: "));
      return 1;
    }
    write(break_string("Carolina fluestert: Darueber weiss ich leider nichts.\n"));
  }
  return 1;
}

/*** Spieler versucht, das Schloss zu oeffnen ***/
int oeffne_schloss (string str)
{
	object key;
	
   notify_fail ("Was moechtest Du oeffnen?\n");

   if (!str) return 0;
   if (strstr(str, "kaefig")!=-1 )
   {
   	write(break_string("Da ist ein Schloss dran.\n"));
   	return 1;
   }
   if (str == "schloss")
   {
   	write(break_string("So einfach laesst sich das Schloss nicht oeffnen."
   	   " Frag' die Gefangene, ob sie Dir helfen kann.\n"));
   	return 1;
   }
   if (str == "schloss mit schluessel" || str == "schloss mit bambusschluessel")
   {
   	 /* nachschauen, ob der Spieler den Eisenschluessel schon hat. */
   	 /* deep_present...auch Beutel, etc. werden durchsucht.        */
      if (key = deep_present("\nkd_schluessel", this_player()))
      {
         if(kaefigtuer_exists == 0)
         {
         	kaefigtuer_exists = 1;
 /*           NewDoor("kaefig", KD_ROOM("kaefig:"+getuid(this_player())),
                ({"tuer", "tor", "kaefigtor", "kaefigtuer" }),
                ({
                D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
                D_LONG, "Eine Tuer aus Bambus.\n",
                D_GENDER, FEMALE,
                D_SHORT, "Eine %se Bambustuer.",
                D_NAME, "Bambustuer",      
                }) ); */
              AddExit("kaefig", KD_ROOM("kaefig:"+getuid(this_player())));
         }
/*         key->remove();
         write(break_string("Der Bambusschluessel zerbricht - war ja"
            " doch nur aus Bambus.\n")
            );
*/
//         DOOR_MASTER->SetDoorStatus(KD_ROOM("kaefig"), D_STATUS_OPEN);
         write(break_string("Du oeffnest die Tuere zum Kaefig.\n"));
         return 1;
      }
      else
      {
         write(break_string("Aber Du hast ja den Schluessel gar nicht.\n"));
         return 1;
      }
   }
   return 0;
}

