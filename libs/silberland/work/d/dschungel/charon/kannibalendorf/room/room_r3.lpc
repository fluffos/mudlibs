/*
** R1 - Huette der Torwache
** 22.12.1998  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

   /*** Raumbeschreibung ***/
   SetProp( P_INT_SHORT, "Huette der Torwache");
   SetProp( P_INT_LONG,
      "Du befindest Dich in der Huette der Torwache oestlich des Kannibalendorfes."
      " Die Huette bietet nichts aufregendes, wenn man von den Waffen in der Ecke"
      " absieht. Kannibalen scheinen sehr genuegsam bei ihrem Dienst zu sein."
      " Du siehst noch einen Tisch und ein paar Stuehle auf dem Boden stehen bzw."
      " liegen. Ausserdem riecht es nach Schweiss, was bei der grossen Hitze aber"
      " nicht aussergewoehnlich erscheint. Und die verstreuten Knochen scheinen"
      " in jede Huette, die etwas auf sich haelt, zu gehoeren. An den Waenden"
      " kannst Du noch einige Trophaeen erkennen."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,  1);
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_HOUSE ]) );

   /*** Details fuer Raum ***/
   AddDetail( ({"huette","huetten","wachhuette"}),
       "Die Wachhuette besteht wie alle hier aus Bambus."
       );
   AddDetail( ({"boden","erde"}),
       "Der Boden der Huette besteht aus gestampfter Erde."
       );
   AddDetail("decke",
       "Auch die Decke besteht aus Bambus, dem bevorzugten, da einzigen Baumaterial"
     + " hier im Dschungel."
     );
   AddDetail( ({"wand","waende"}),
       "Rate mal...ja, auch aus Bambus."
       );
   AddDetail( ({"bambus","baumaterial"}),
       "Der Bambus eignet sich hervorragend als Baumaterial, weil er einerseits"
     + " sehr stabil, aber doch biegsam ist, andererseits ist er hier leicht im"
     + " Dschungel zu finden."
     );
   AddDetail( ({"dschungel","dschungels"}),
       "Das Kannibalendorf befindet sich mitten im Dschungel."
       );    
   AddDetail( ({"dorf","dorfes","kannibalendorf"}),
       "Du befindest Dich im Dorf der Menschenfresser."
       );
   AddDetail( ({"wache","wachen","torwache","kannibalen","kannibale",
                "menschenfresser"
                }),
       "Mit den Kannibalen ist nicht zu spassen."
       );    
   AddDetail( "knochen",
      "Du siehst verblichene Knochen, die scheinbar schon laenger hier zu"
    + " liegen scheinen, aber auch Knochen, an denen Du noch Fleischreste"
    + " erkennen kannst."
    );
   AddDetail( ({"fleischreste","fleisch","fleischfetzen","fetzen"}),
      "Dir wird uebel, als Du beginnst Dir vorzustellen, dass diese Fleischfetzen"
    + " einmal ein Arm oder ein Fuss waren."
    );
   AddDetail( ({"arm","fuss"}),
      "Nun sind nur mehr Knochen und Fleischreste uebrig."
      );
   AddDetail( ({"stuhl","stuehle","tisch"}),
      "Um es den Wachen ein wenig gemuetlich zu machen, stehen in der"
    + " Huette Stuehle und ein Tisch...man goennt sich ja sonst nichts."
    );
   AddDetail( ({"trophaee","trophaeen"}),
      "Waffen und Knochen besiegter Gegner."
      );
   AddDetail("gegner",
      "Ihnen war kein Glueck beschert, so wie du es derzeit noch gepachtet zu"
    + " haben scheinst."
    );
   AddDetail("glueck",
  	 "Das Glueck kommt und geht."
  	 );
   AddDetail( ({"dienst","wachdienst"}),
      "Einige Kannibalen muessen immer Wachdienst schieben."
      );
   AddDetail("hitze",
      "Du spuerst es schon deutlich, es ist sehr heiss hier."
      );
   AddDetail("schweiss",
      "Schweiss kann man nicht untersuchen, aber man kann ihn ...."
      );
   AddDetail( ({"waffe","waffen","ecke"}),
      "Die Kannibalen scheinen grosse und klobige Waffen zu bevorzugen."
    + " Du moechtest Dir lieber nicht vorstellen, was passiert, wenn Dich"
    + " jemand mit so einer Waffe trifft."
    );
   AddDetail( ({"ausduenstung","ausduenstungen"}),
      "Du solltest vielleicht mal riechen..."
      );
   AddDetail( ({"ohren","ohr"}), 
      "Die Kannibalen reden so laut, dass Du sie Dir"
    + " zuhalten musst."
    );
    
   /*** Geraeusche ***/
     
   AddSound(DEFAULT_SOUND, 
       "Du kannst die lauten Stimmen der Wachen hoeren.\n");
   AddSound( ({"stimmen"}), 
       "Obwohl die Kannibalen leise reden,"
      " musst Du Dir fast die Ohren zuhalten.\n"
      );
      
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, 
       "Es riecht nach Schweiss.\n");
   AddSmell( ({"schweiss", "ausduenstungen", "ausduenstung"}), 
       "Du kannst die fauligen Ausduenstungen"
      " der Kannibalen riechen. Besser man kommt ihnen nicht zu nahe."
      " Dir ekelt schon jetzt vor ihnen.\n"
    );    
    
   /*** Commands ***/
    
   /*** Exits ***/

   AddExit("sueden","./tor:"+getuid(this_player()));
   AddExit("norden","./room_r2:"+getuid(this_player()));
   AddExit("westen","./room_r4:"+getuid(this_player()));
   
   /*** NPCs ***/

   AddItem( KD_NPC("kannibale"), REFRESH_DESTRUCT);
   AddItem( KD_NPC("kannibale"), REFRESH_DESTRUCT);   
   AddItem( KD_NPC("haumined"),  REFRESH_DESTRUCT);

   previous_object()->CustomizeObject();

   AddCmd( ({"halt", "halte"}), "halten");
}

int halten(string str)
{
  notify_fail("Willst Du Dir etwa die Ohren zuhalten?\n");
  if(str!="ohren zu") return 0;
  write("Du haeltst Dir die Ohren zu.\n");
  say(TP->Name(WER)+" haelt sich die Ohren zu.\n");
  return 1;
}

