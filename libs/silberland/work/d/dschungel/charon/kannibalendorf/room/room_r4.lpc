/*
** R4 - Huette im Kannibalendorf
** 22.12.1998  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp( P_INT_SHORT, "Huette im Kannibalendorf");
   SetProp( P_INT_LONG,
      "Du befindest Dich in einer Huette aus Bambus am Rande des Kannibalendorfes."  
    + " Die Huette ist ziemlich kaerglich eingerichtet, denn abgesehen von einem Bett"
    + " und einer Truhe, ist sie leer, wenn man von den Knochenresten am Boden absieht.\n"
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,  1);
   SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_HOUSE ]) );
   
   /*** Details fuer Raum ***/
   AddDetail( ({"huette","huetten"}),
       "In solchen Huetten wohnen die Kannibalen. Die Huetten bestehen fast "
       "vollstaendig aus Bambus."
     );
   AddDetail( ({"boden","erde"}),
       "Der Boden der Huette besteht aus gestampfter Erde."
       );
   AddDetail( ({"rand","rande"}),
       "Eine Huette am westlichen Rand eben. Nichts besonderes."
       );
   AddDetail("decke",
       "Auch die Decke besteht aus Bambus, dem bevorzugten, da einzigem Baumaterial"
     + " hier im Dschungel."
     );
   AddDetail( ({"wand","waende"}),
       "Rate mal...ja, auch aus Bambus."
       );
   AddDetail( ({"bambus","baumaterial"}),
       "Der Bambus eignet sich hervorragend als Baumaterial, weil er einerseits"
     + " sehr stabil, aber doch biegsam ist, andererseits ist er hier leicht im"
     + " Dschungel zu finden."
     );
   AddDetail( ({"dschungel","dschungels"}),
       "Das Kannibalendorf befindet sich mitten im Dschungel."
       );    
   AddDetail( ({"dorf","dorfes","kannibalendorf"}),
       "Du befindest Dich im Dorf der Menschenfresser."
       );
   AddDetail( ({"kannibalen","kannibale","menschenfresser"}),
       "Die Kannibalen sehen ziemlich furchterregend aus."
       );    
   AddDetail( ({"truhe","kiste"}),
       "Die Truhe scheint schon alt zu sein, wovon der Rost auf der gesamten"
     + " Kiste zeugt. Du koenntest ja versuchen, sie zu oeffnen."
     );
   AddDetail( "schloss",
      "Das Schloss ist ziemlich verrostet, aber vielleicht kannst Du es"
    + " trotzdem oeffnen?"
    );
   AddDetail( ({"rost","verfaerbung"}),
       "Rost...so eine rotbraune Verfaerbung auf der Truhe."
       );
   AddDetail("bett",
      "Sieht nicht sonderlich gemuetlich aus mit all den Knochenresten darin"
    + " verstreut."
    );
   AddDetail( ({"knochen","knochenreste","reste"}),
      "Du siehst verblichene Knochen, die scheinbar schon laenger hier zu"
    + " liegen scheinen, aber auch Knochen, an denen Du noch Fleischreste"
    + " erkennen kannst."
    );
   AddDetail( ({"fleischreste","fleisch","fleischfetzen","fetzen"}),
      "Dir wird uebel, als Du beginnst Dir vorzustellen, dass diese Fleischfetzen"
    + " einmal ein Arm oder ein Fuss waren."
    );
   AddDetail( ({"arm","fuss"}),
      "Nun sind nur mehr Knochen und Fleischreste uebrig."
      );
      
   /*** Commands ***/
   
   AddCmd("oeffne", "oeffne_truhe");
    
   /*** Exits ***/
   
   AddExit("norden","./room_r1:"+getuid(this_player()));
   AddExit("osten", KD_ROOM("/room_r3:"+getuid(this_player())));
     
   /*** NPCs ***/
   
//   AddItem("/players/charon/diener.lpc", REFRESH_NONE);
   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

int oeffne_truhe(string str)
{
   notify_fail ("Was willst Du oeffnen?\n");

   if (!str) return 0;
   if (str == "truhe" || str == "schloss" || str=="kiste")
   {
   	write(break_string("Mit Deinen geschickten Haenden hantierst Du an der Truhe"
   	   " herum. Es scheint ein ziemlich kompliziertes Schloss zu sein.\n"
        "Du beginnst leicht zu schwitzen.\n"
        "Schliesslich gibst Du auf...das Schloss ist zu kompliziert fuer Dich.\n")
        );
   	return 1;
   }
   return 0;
}
