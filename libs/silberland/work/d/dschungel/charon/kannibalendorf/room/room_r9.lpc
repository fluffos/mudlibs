/*
** R9 - Startplatz fuer Kannibalendorfquest
** 17.02.1999  V1.0  Charon@SL
*/
inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "room.h"
#include "../defines.h"

void create()
{
   if (!is_clone(this_object())) return;
   ::create();

   /*** Raumbeschreibung ***/
   SetProp(P_INT_SHORT, "Eine Lichtung");
   SetProp(P_INT_LONG,
      "Du befindest Dich auf einer kleinen Lichtung mitten im Dschungel."
      " Du kannst einen Trampelpfad erkennen, aber sonst nicht viel,"
      " weil die Vegetation so dicht ist. Du erkennst aber einen"
      " Fluss, der Dich scheinbar hierhergeschwemmt hat."
    );

   /*** Settings fuer Raum ***/
   SetProp(P_INDOORS,0);
   SetProp(P_LIGHT,  1);
   SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE ]) );

   /*** Details fuer Raum ***/
   
   AddDetail( "fluss",
      "Es scheint, als ob Dich der Fluss hierhergeschwemmt hat."
    + " Du bist wahrscheinlich sehr gluecklich, dass Du noch"
    + " lebst und nicht ertrunken bist."
    );
   AddDetail( "lichtung",
      "Du stehst auf dieser Lichtung."
      );
   AddDetail( ({"boden","pfad","trampelpfad"}),
       "Der Pfad fuehrt mitten durch den Dschungel und besteht aus"
     + " festgetrampelten Lehm."
       );
   AddDetail("himmel",
       "Du kannst den wolkenlosen Himmel ueber Dir erkennen."
       );
   AddDetail( ({"dschungel"}),
       "Der Pfad befindet sich mitten im Dschungel."
       );    
   AddDetail( "vegetation",
      "Die Vegetation ist sehr dicht und ueberaus gruen."
      );
   AddDetail( "lehm",
      "Der Pfad besteht aus festgetrampeltem Lehm, Du kannst nichts"
    + " Besonderes daran erkennen."
    );
   AddDetail( "besonderes",
      "Es gibt wirklich nichts zu sehen."
      );
   AddDetail( ({"baum","baeume"}),
      "Die Baeume sind hier sehr hoch und aeusserst beeindruckend."
      );
   AddDetail("wind",
      "Du kannst den Wind hoeren, der durch die Baeume pfeift."
      );
   AddDetail( ({"erde","erdreich"}),
      "Der reichliche Regen ist dafuer verantwortlich, dass das"
    + " Erdreich nass ist."
    )   ;
   AddDetail("regen",
      "Der Regen ist hier ueberaus haeufig."
      );
   AddDetail("wasser",
      "Das Wasser in ziemlich schlammig, was aber nicht verwunderlich"
    + " ist, denn der Fluss traegt die vom Regen ausgeschwemmte Erde"
    + " mit sich."
    );
    
   /*** Geraeusche ***/
     
   AddSound(DEFAULT_SOUND, "Du kannst das Rauschen der Vegetation hoeren, wenn"
      + " der Wind durch die Baeume faehrt.\n");
         
   /*** Geruch ***/

   AddSmell(DEFAULT_SMELL, "Du riechst den Lehm unter Deinen Fuessen.\n");
   AddSmell( ({"lehm"}), "Durch den Regen ist das Erdreich"
    + " durchnaesst und riecht nun erfrischend.\n"
    );   
    
   /*** Commands ***/
   AddCmd( ({"schwimm","schwimme"}), "schwimm_fluss");
   
   /*** Exits ***/
   AddExit("norden","./room_r10:"+getuid(this_player()));
   AddExit("osten", "./room_r12:"+getuid(this_player()));

   /*** NPCs ***/
   AddItem( KD_NPC("kai"), REFRESH_DESTRUCT);

   /*** OBJs ***/
   previous_object()->CustomizeObject();
}

/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

reset_quest()
{
	object npc,room;

   say(break_string("Kai schleicht sich.\n"));
   say(break_string("Carolina geht ihrem Vater nach.\n"));

	if(npc = present("\nkd_kai")) npc->remove();
   if(npc = present("\nkd_carolina")) 
   	npc->remove();
   else
   {
   	room = find_object(KD_ROOM("kaefig"));
   	if(room && (npc = present("\nkd_carolina",room))) npc->remove();
   }
   
   npc = clone_object(KD_NPC("carolina")); 
   npc->SetVarGefesselt(1);
   npc->move(KD_ROOM("kaefig"),M_GO);
   
   npc = clone_object(KD_NPC("kai"));
   npc->move(KD_ROOM("room_r9"),M_GO);
}

/*** Spieler moechte durch den Fluss zurueckschwimmen ***/
int schwimm_fluss(string str)
{
	string str1,str2;

	notify_fail ("Wo moechtest Du schwimmen?\n");

	if(!str) return 0;
   if (sscanf(str, "%s %s",str1,str2) != 2)
   	return 0;
   
   if (str1 == "in" || str == "durch")
   {
   	if (str2 == "fluss")
   	{
   		TP->SetProp(P_PARALYZED,
    		([PARALYZE_TIME:      10,
      	  PARALYZE_MSG:       "Du stuerzt Dich wagemutig in den Fluss.\n",
      	  PARALYZE_MSG_OTHER: "",
      	  PARALYZE_END:       "",
      	  PARALYZE_END_OTHER: ""
      	 ]));
   		call_out("schwimmen1", 2,0);
/*   		this_player()->move( KD_ROOM("room_void"), M_SILENT);
   		write(BS("Du stuerzt Dich wagemutig in den Fluss.\n"
   		   ));*/
			return 1;
   	}
   	write(break_string("Du kannst da nicht durchschwimmen.\n"
   	     ));
  		return 1;
   }
   return 0;
}

schwimmen1()
{
  write(break_string("Wagemutig wirfst Du Dich in die Fluten, uebersiehst"
   + " aber, dass gerade eine groessere Welle tosend auf das Ufer zurollt."
	+ " Die maechtige Woge schlaegt ueber Dir zusammen und reisst Dich in"
	+ " die Tiefe. Du verlierst die Orientierung.\n"
	));
  call_out("schwimmen2", 5, 0);
}

schwimmen2()
{
  write(break_string("Als Du Dich den Natuergewalten ausgeliefert fuehlst,"
	+ " und glaubst, dass Dein letztes Stuendlein geschlagen hat, weil Deine"
	+ " Lungen schon brennen vor Sauerstoffmangel, kommst Du an die Oberflaeche"
	+ " der tosenden See und kannst Deine Lungen mit kuehler Luft fuellen."
	+ " Doch gleich darauf bricht abermals eine Welle ueber Dir und Dir wird"
	+ " schwarz vor Augen.\n"
	));
  call_out("schwimmen3", 10, 0);
}	

schwimmen3()
{
  write(break_string("Nach schier ewiger Zeit kommst Du wieder zu Dir"
   + " und siehst, dass Du am Wasser treibst. Als Du Dich umblickst kannst,"
   + " Du in einiger Entfernung schon die Kueste sehen. Du nimmst Deine"
   + " letzten Kraftreserven zusammen und beginnst, Deinen Koerper"
   + " gegen den Wellengang in Richtung Land zu bewegen. Und unendlich"
   + " langsam kommt die Kueste naeher...\n"
	));
  call_out("teleportieren",1,1);
}

teleportieren()
{
  this_player()->move("/d/dschungel/feyaria/kueste/room/room_a7", M_GO, "unter", "geht","wird an Land gespuelt");
}

real_reset()
{
	::reset();
}
