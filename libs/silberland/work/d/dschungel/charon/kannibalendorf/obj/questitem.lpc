inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../defines.h"

int quest;

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId (({"quest","\nkd_quest"}));
  
  SetProp (P_SHORT,     0);
  SetProp (P_NAME,      "QuestItem");
  SetProp (P_GENDER,    NEUTER);
  SetProp (P_WEIGHT,    0);
  SetProp (P_VALUE,     0);
  SetProp (P_NOBUY,     0);
  SetProp (P_NODROP,    1);
  SetProp (P_NEVERDROP, 1);

  SUID;
AddCmd("test123", "setze_wert_auf_7");

}

setze_wert_auf_7()  {

  if(getuid(TP)=="dante" )  {
	write(
	"OK, quest= 7!\n");
	
	quest=7; return 1; }

return 0;  }	


int set_quest(int stufe)
{
  if(getuid(previous_object()) != "dante" && 
     getuid(previous_object()) != "feyaria" && 
     getuid(previous_object()) != getuid(this_object()))
  {
    raise_error("getuid(PO) problem in Quest!");
    return 0;
  }

  quest|=stufe;
                
  DB ("KANNIBALENDORFQUEST: "+this_player()->name()+" ist bei Punkt: "+quest+" --> "+KDQSTRING[stufe]+"\n");
  DBM("KANNIBALENDORFQUEST: "+this_player()->name()+" ist bei: "+KDQSTRING[stufe]+"\n");
  write_file (KANNIBALENDORFQUESTLOG2,
     sprintf ("%s: "+this_player()->name()+" ist bei Punkt: "+quest+
              " --> "+KDQSTRING[stufe]+"\n",dtime(time())
             )
     );
  return quest;
}

int query_quest()
{
  return quest;
}
