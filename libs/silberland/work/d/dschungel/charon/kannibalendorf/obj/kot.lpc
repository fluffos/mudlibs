/*
** Kannibalenkot - wird Spieler ins Inventory gesetzt, sobald er in Schiesse wuehlt.
** 19.01.1999  V1.0  Charon@SL
** 10.02.1999  V1.1  Charon@SL
*/

#include <properties.h>
#include <language.h>
inherit "std/thing";

int    alter;
object wuehler;
	 
init()
{
   wuehler = this_player();

   if (query_once_interactive(this_player()))
	   call_out("stinken", 5,0);
   ::init();
}		   
create()
{
  ::create();

  AddId( ({"\nkd_kot","kd_kot"}) );

  SetProp(P_SHORT,   0);
  SetProp(P_LONG,    0);
  SetProp(P_NAME,    "Kannibalenkot");
  SetProp(P_GENDER,  1);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NODROP,  "Du wirst die Scheisse nicht los.\n");
  SetProp(P_NEVERDROP,1);
  SetProp(P_WEIGHT, 0);

  alter = 0;
}

stinken()
{
   int i;
   
   if (!alter)
   {
      tell_room(environment(wuehler), 
       	         break_string(wuehler->name() 
                   + " hat sich ueber und ueber mit Kannibalenkot beschmiert."
                   + " Wahrscheinlich ist es besser, "
                   + wuehler->name() + " nicht zu nahe zu kommen...der"
                   + " Gestank ist unertraeglich.\n"
                   ),({wuehler}));
      write(break_string("Du hast Dich ueberall mit Scheisse beschmiert, und"
             + " die faengt nun zu stinken an. Deine armen Mitspieler.\n"
             ));
   }
   
   alter++;
   if (!random(6))
   {
      i = random(5);
      if (i == 0)
         tell_room(environment(wuehler), 
                   break_string(wuehler->name(WESSEN)+" Gestank ist nun kaum zu"
                     + " ueberriechen.\n"
                     ),({wuehler}));
      if (i == 1)
         tell_room(environment(wuehler),
                   break_string("Du siehst " + wuehler->name() + " an und kommst zu"
                     + " dem Schluss, dass " + wuehler->name() + " in Scheisse gebadet"
                     + " haben muss.\n"
                     ),({wuehler}));
      if (i == 2)
         tell_room(environment(wuehler),
                   break_string(wuehler->name() + " riecht wie Xavers Misthaufen.\n"
                   ),({wuehler}));
      if (i == 3)
         tell_room(environment(wuehler),
                   break_string("Sieh doch nur, " + wuehler->name() + " hat sich"
                     + " von oben bis unten mit Scheisse besudelt. *ekel*\n"
                     ),({wuehler}));
      if (i == 4)
         tell_room(environment(wuehler),
                   break_string(wuehler->name(WESSEN) + " neuer Anzug gefaellt Dir."
                     + " Oekologisch einwandfrei, wiederverwertbar und keinerlei"
                     + " Rohstoffknappheit in Sicht. Der Ueberzug aus Kannibalenkot"
                     + " hat viele Vorteile. Aber er riecht eher streng!\n"
                     ),({wuehler}));
   }
   
   if (alter < 45) call_out("stinken", 5,0);
      
   if (alter == 45) 
   {
      tell_room(environment(wuehler),
                break_string("Die Scheisse an " + wuehler->name() + " ist nun getrocknet"
                  + " und beginnt langsam abzubroeckeln. " + wuehler->name() + " atmet"
                  + " erleichtert auf.\n"
                  ),({wuehler}));
      destruct(this_object());
   }
}
