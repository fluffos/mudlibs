/*
** Trunk - muss getrunken werden, um an Bolzenschneider zu kommen
** 22.12.1998  V1.0  Charon@SL
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../defines.h"

object zange;

void create()
{
   if (!is_clone(this_object())) return;

   ::create( ({"trink","trinke","trinke aus"}) );

   AddId( ({"trank","getraenk","\nkd_getraenk"}) );

   SetProp(P_SHORT, "Ein Getraenk in einem Tongefaess");
   SetProp(P_LONG,
      "Ein kugelrundes Tongefaess mit drei kleinen Fuesschen und einem Schnabel."
      " Es enthaelt ein suesslich riechendes Getraenk.\n"
    );

   SetProp(P_NAME,      "Trank");
   SetProp(P_WEIGHT,    300);
   SetProp(P_VALUE,     250);
   SetProp(P_NODROP,    "WAS? Das brauchst Du vielleicht noch!\n");
   SetProp(P_SMELL,
      "Das Getraenk verstroemt einen verfuehrerischen Geruch."
      " Fruchtige Suesse stroemt in Deine Nase, was gar nicht zu"
      " den Inkredenzien passen will. Willst du einen Schluck"
      " nehmen?\n"
    );
   SetProp(P_FOOD_INFO, ([F_HEAL : ({-4, 2}), F_SOAK : 10, F_DRINK : 20,
      F_ALCOHOL : 3 , F_POISON : 1, F_VERB : "trinken"]));
}

int BeimEssen()
{
	object kd_quest;
	
	if(!kd_quest=present("\nkd_quest",this_player()) )
	{ 
		write(break_string("Du setzt den Trinkschnabel des Gefaesses an und machst einen"
       + " Schluck. Aber nichts passiert, ausser dass Du Dich vor diesem"
       + " Gebraeu ekelst.\n"
       ));
      say(break_string(this_player()->name()+" nimmt einen vorsichtigen Schluck aus einem"
       + " runden Tongefaess.\n"
       ));
		return 0;	
	}
	else
   	kd_quest->set_quest(KDQ_BOLZENSCHNEIDER_GEFUNDEN);
	
   write(break_string("Du setzt den Trinkschnabel des Gefaesses an und machst einen"
    + " Schluck. Sofort bereust Du Deine Entscheidung. Siedend heiss"
    + " laeuft es Deine Kehle hinab. Du wuergst und es wird Dir schwarz vor"
    + " Augen.\n")
    );
   say(break_string(this_player()->name()+" nimmt einen vorsichtigen Schluck aus einem"
    + " runden Tongefaess.\n"
    +this_player()->name()+" reisst die Augen auf. Aus dem ebenfalls"
    + " aufgerissenen Mund entringt sich ein heiseres Roecheln.\n"
    +this_player()->name()+" faellt um wie ein Brett und eine gruener Rauch"
    + " quillt aus der Nase.\n")
    );

    write(break_string("Als Du wieder zu Dir kommst, scheint es, dass"
     + " Du nun schwerer zu tragen hast.\n")
     );
    say(break_string("Als "+this_player()->name()+" wieder zu sich kommt, scheint es,"
     + " dass "+this_player()->name()+" nun schwerer zu tragen hat.\n")
     );

   // euid setzen, damit Objekte gecloned werden koennen
   seteuid(getuid(this_object()));

   // Objekte clonen
   zange = clone_object( KD_OBJ("bolzenschneider") );

   // Object ins Inventory des Spielers stellen
   if( (zange->move(this_player(),M_GET)) == ME_TOO_HEAVY)
   {
   	write("Du kannst den Bolzenschneider nicht mehr tragen!\n");
        zange->move(environment(this_player()),M_NOCHECK);
   }
   return 1;	
}
