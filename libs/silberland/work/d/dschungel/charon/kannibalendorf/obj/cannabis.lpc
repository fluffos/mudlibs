/*
** Flaeschchen mit Cannabis-Saft
** 11.02.1999  V1.0  Charon@SL
** 13.10.1999  V1.1  Charon@SL - Nur mehr 2 Mal trinken moeglich, Flaeschchen
**                               loest sich danach auch nicht auf, damit man
**                               es Kai noch geben kann (notweniddig, da kein
**                               beim Reset in den Raeumen die NPCs nciht mehr
**                               geclont werden.
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../defines.h"

int fuellungen = 3;

void create()
{
   if (!is_clone(this_object())) return;

   ::create( ({"trink","trinke"}) );

   AddId( ({"flaeschchen","cannabis","cannabis-saft","\nkd_cannabis"}) );

   SetProp(P_SHORT, "Ein Flaeschchen mit Cannabis-Saft");
   SetProp(P_LONG, 
      "Ein herkoemmliches Flaeschchen, das aber innerlich zu leuchten scheint, und"
    + " nur auf den Genuss wartet."
    );
    
   SetProp(P_NAME,      "Flaeschchen mit Cannabis-Saft");
   SetProp(P_MATERIAL,  MAT_MISC_FLUID);
   SetProp(P_GENDER,    NEUTER);
   SetProp(P_WEIGHT,    200);
   SetProp(P_VALUE,     3050);
   SetProp(P_DRINK,     2);
   SetProp(P_FOOD_INFO, ([F_HEAL: 20, F_SOAK: 10, F_DRINK: 20]));
   SetProp(P_SMELL,     "Eigentlich komisch, aber Du riechst ueberhaupt nichts.");

   AddCmd( ({"trinke", "trink"}), "BeimTrinken");
}

int BeimTrinken()
{
   if(fuellungen<2)
   {
	   write(break_string("Du solltest wirklich nicht mehr trinken. Wer weiss,"
	    + " welche Nebenwirkungen das Zeug hat. Ausserdem solltest Du es ja zu"
	    + " Kai bringen.\n"
	    ));
   }
   else
   {
      write(break_string("Du setzt das Flaeschchen an und nimmst einen kraeftigen"
       + " Schluck. Eiskalt rinnt es Deine Kehle hinunter und dann spuerst"
       + " Du, wie sich eine wohlige Waerme in Deinem Koerper ausbreitet."
       + " Deine Muskeln scheinen zu wachsen und Du fuehlst Dich, als koenntest"
       + " Du Baeume ausreissen.\n"
       ));
      say(break_string(this_player()->name()+" setzt das Flaeschchen an und nimmst"
       + " einen kraeftigen Schluck. Eiskalt rinnt es "+this_player()->name(WESSEN)
       + " Kehle hinunter und dann leuchten "+this_player()->name(WESSEN)+" Augen"
       + " auf. "+this_player()->name()+" glaubt nun, Baeume ausreissen zu koennen.\n"
      ));
      fuellungen--;
   }
   
   return 1;
}

