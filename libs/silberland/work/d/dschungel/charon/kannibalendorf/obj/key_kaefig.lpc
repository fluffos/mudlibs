/*
** Der Schluessel zum Kaefig der Anthropologin Carolina
** 17.12.1998  V1.0  Charon@SL
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../defines.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  
  AddId (({"\nkd_schluessel","schluessel","bambusschluessel"}));
  
  /*** OBJ properties ***/

  SetProp (P_SHORT, "Ein Bambusschluessel");
  SetProp (P_LONG,  "Der Schluessel besteht vollstaendig aus Bambus."
     " Wo konnte man ihn nur gebrauchen...?");
     
  SetProp (P_NAME,     "Bambusschluessel");
  SetProp (P_GENDER,   MALE);
  SetProp (P_VALUE,    50);
  SetProp (P_WEIGHT,   50);
  SetProp (P_NOBUY,    1);
  SetProp (P_MATERIAL, MAT_MISC_TROPICAL_WOOD);
  SetProp(P_NODROP,    "WAS? Das brauchst Du vielleicht noch!\n");
}

string QueryDoorKey()
{
  return KD_ROOM("room_r5")+":"+KD_ROOM("kaefig");
}


