/*
** Bolzenschneider - Zur Befreiung von Carolina
** 22.12.1998  V1.0  Charon@SL  
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include "../defines.h"

create()
{
   if (!is_clone(this_object()))
      return;

   ::create();

   AddId( ({"\nkd_bolzenschneider","bolzenschneider","schneider"}) );

   SetProp(P_SHORT, "Ein Bolzenschneider");
   SetProp(P_LONG, 
      "Der Bolzenschneider ist eine grosse Zange mit zwei langen Hebeln."
      " Man kann damit massive Metallteile durchtrennen. Durch seine Laenge"
      " hat er ein betraechtliches Gewicht, so dass ein Schlag damit,"
      " auch auf harte Koepfe, heftiges Kopfzucken und Ohrensausen zur"
      " Folge hat."
    );


   SetProp(P_NAME,         "Bolzenschneider");
   SetProp(P_GENDER,       MALE);
   SetProp(P_VALUE,        800);
   SetProp(P_WEIGHT,       4300);   /* in Gramm */
   SetProp(P_WEAPON_TYPE,  WT_KNIFE);
   SetProp(P_DAM_TYPE,     DT_BLUDGEON);
   SetProp(P_WC,           145);
   SetProp(P_NR_HANDS,     2);  /* Bedienung nur mit 2 Haenden moegl. */
   SetProp(P_WC_FIXFACTOR, 0.4);
   SetProp(P_MATERIAL,     ([MAT_MISC_METAL: 100]) );
   SetProp(P_QUALITY_DECAY,150);
   SetProp(P_NODROP,       "WAS? Das brauchst Du vielleicht noch!\n");

   SetProp(P_INFO, "Der Bolzenschneider besteht vollstaendig aus diversen"
    + " grob verarbeiteten Schmiedeteilen, die miteinander vernietet wurden."
    + " Er besitzt keine magischen Eigenschaften.\n"
    );

   /* Anpassung der Default-Meldungen fuer Objekte */ 

   SetProp(P_WIELD_TEXT, ({"Du packst den Bolzenschneider mit beiden Haenden"
    + " an den langen Hebeln.\n",
      " packt einen schweren Bolzenschneider mit beiden Haenden an den"
    + " langen Hebeln.\n"
    }) );
   SetProp(P_UNWIELD_TEXT, ({"Du packst den Bolzenschneider weg.\n",
      " packt einen schweren Bolzenschneider weg.\n"
      }) );
   SetProp(P_NOSELL, "Du willst doch nicht diesen qualitativ hochwertigen,"
    + " ueberaus nauetzlichen Bolzenschneider verhoekern?!?\n"
    );
}
