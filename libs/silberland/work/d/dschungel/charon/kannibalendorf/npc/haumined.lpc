/* 
** Schwache Wache des Kannibalendorfes
** 17.12.1998  V1.0  Charon@SL
*/
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../defines.h"

object this_player;

// init()
// Wird aufgerufen, sobald sich zwei Objekte, von denen mindestens eines
// ein Living ist, begegnen. this_player() (TP) ist in diesem Fall das
// entsprechende Objekt, das uns begegnet - wir pruefen, ob es sich um
// einen anderen Soeldner handelt, und wenn ja, kommt er in unsere
// Defender-Liste. Es verteidigen sich somit alle Wachen, die einander
// begegnen (Alternative: per Master; aber irgendwie unlogisch... wenn
// sich zwei Wachen nie begegnen, koennen sie auch nicht Informationen
// ueber ihre Feinde austauschen, oder? Handy werden sie ja doch keins
// haben :)).
//
init()
{
  ::init();
  if (this_player && this_player->id("kannibalen_wache")) AddDefender(this_player);
}

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale", "kannibalen_wache", "haumined","\nkd_haumined" }) );
   create_default_npc( 7 );   
   set_living_name ("haumined");

   /*** NPC properties ***/

   SetProp(P_SHORT, "Der Kannibale Haumined");
   SetProp(P_LONG,  "Der Menschenfresser Haumined ist derzeit als Waechter"
      " fuer das Kannibalendorf eingesetzt. Er ist mit dieser Aufgabe nicht"
      " zufrieden, weil ihn die anderen Waechter immer wieder wegen seiner"
      " schmaechtigen Statur haenseln. Er waere viel lieber Medizinmann,"
      " aber seine Familie hat einen zu geringen gesellschaftlichen Status"
      " inne, um ihm seinen Traum erfuellen zu koennen. Daher leistet er"
      " seinen Wachdienst, bis ihn ein netter Zeitgenosse endlich von"
      " seinem Leiden erloest..."
      );

   SetProp(P_NAME,    "Haumined");
   SetProp(P_GENDER,  MALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_SIZE,    154);
   SetProp(P_HANDS,   ({" mit seinen zarten Haenden", 55}));
   SetProp(P_ALIGN,   -25);
   SetProp(P_RACE,    "Mensch");
   SetProp(P_DIE_MSG, " ist froh, endlich von seinem schweren Los erloest zu werden.\n");
   SetProp(P_DEFAULT_INFO,"meint: Biiddae???");

   SetAttribute(A_INT, 12);
   SetAttribute(A_STR, 5);

   /*** NPC object stuff ***/

   // euid setzen, damit Objekte gecloned werden koennen
   seteuid(getuid(this_object()));

   // Objekte clonen
   clone_object(KD_WEAPON("knochen"))->move(this_object());
   clone_object("/p/armour/trousers/lendenschurz")->move(this_object());

   // Objekte benutzen
   command("zuecke knochen");
   command("trage alles");
   
   /*** NPC details ***/

   /*** NPC information ***/

   /*** NPC chats ***/

   /*** NPC attack chats ***/
}

