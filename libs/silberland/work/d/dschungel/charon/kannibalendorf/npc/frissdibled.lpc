/* 
** Frissdibled - Kochwanst des Kannibalendorfes
** 23.12.1998  V1.0  Charon@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "../defines.h"

init()
{
	if(!IS_WIZARD(this_player()) && interactive(this_player())) 
      this_object()->Kill(this_player());	
   ::init();
}

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","frissdibled","koch","\nkd_furzian"}) );
   create_default_npc( 18 );

   /*** NPC properties ***/
   SetProp(P_SHORT, "Frissdibled, der Koch des Kannibalenstammes");
   SetProp(P_LONG,  "Bei Frissdibleds Anblick fragst Du Dich, warum"
      " so ein fettes, haessliches Subjekt wie Frissdibled die"
      " Augen anderer Bewohner dieser Welt mit seiner unaesthetischen"
      " Erscheinung beleidigen muss. Den Koch selbst scheint dieser"
      " Umstand wenig zu stoeren. Den Kochloeffel schwingend,"
      " froehlich pfeifend, braut er eine abscheulich riechende Bruehe"
      " in einem grossen Gusseisenkessel zusammen.\n"
      "Auch Frissdibled ist gross und von maechtiger Statur: Er"
      " hat einen breiten Ruecken, der mit ungefaehr 1232"
      " Eiterpickeln ueberwuchert ist. Er scheint betrunken zu sein."
      );

   SetProp(P_NAME,      "Frissdibled");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   0);
   SetProp(P_ALIGN,     -200);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_SIZE,      205);
   SetProp(P_HANDS,     ({" mit seinen fettigen Grapschern", 100}));
   SetProp(P_SPELLRATE, 1);

   /*** secondary NPC properties ***/
   SetProp(P_DEFAULT_INFO, ({
      "sieht Dich mit seinen kleinen, stechenden Schweinsaeuglein an.\n"
    + "Frissdibled grunzt: Was liegt an, Zwerg?\n",
      "dreht Dir den Ruecken zu und - furzt in Dein Gesicht! MAHLZEIT!\n",
      "fragt zurueck: Was ist? Willste mal 'ne Runde im Pot zieh'n?\n"
      }) );
   SetProp(P_DIE_MSG, " rudert mit den fetten Armen und schlaegt auf"
    + " den Ruecken. Schmatzend entladen sich die Pickel auf seinem"
    + " Ruecken unter dem Gewicht seines fetten Leibes."
    + " Ein letzter Furz entringt sich seinen Eingeweiden und"
    + " Frissdibled verendet mit einem Roecheln. Du hast diese"
    + " schoene Welt von diesem ekeligen Subjekt befreit!\n");
   SetProp(P_INFO, "Frissdibled besitzt keinerlei magische Kraefte.\n"
    + "Bloss seine Faehigkeit fast ununterbrochen Furzen zu koennen, mutet"
    + " schon fast uebernatuerlich an.\n");

   /*** NPC object stuff ***/

   // euid setzen, damit Objekte gecloned werden koennen
   seteuid(getuid(this_object()));

   // Objekte clonen
   clone_object(KD_WEAPON("kochloeffel"))->move(this_object());
   clone_object("/p/armour/trousers/lendenschurz")->move(this_object());
   clone_object(KD_OBJ("cannabis"))->move(this_object());

   // Objekte benutzen
   command("zuecke kochloeffel");
   command("trage alles");
  
   /*** NPC details ***/

   AddDetail( ({"ruecken","statur"}),
      "Frissdibled hat einen maechtigen Brustkorb und einen noch"
    + " maechtigern Wanst. Sein Ruecken ist breit und von Pickeln ueberseht."
    );
   AddDetail( ({"pickel","pickeln","kraterlandschaft"}),
      "Frissdibled hat eine gute Menge davon. Vor allem der Ruecken ist"
    + " eine einzige Kraterlandschaft. Du malst Dir aus wie das Eiter"
    + " spritzt, wenn es Frissdibled mal ordentlich auf den Ruecken legt."
    );
   AddDetail( ({ "subjekt","erscheinung" }),
      "Frissdibleds Erscheinung kann ohne Uebertreibung als optische"
    + "Umweltverschmutzung bezeichnet werden. Wie jemand, der so fett ist,"
    + "sich noch wohlfuehlen kann, ist Dir ein Raetsel."
    );

   /*** NPC information ***/

   AddInfo( ({"waechter","kannibale","kannibalen","wache","wachen"}),
      "Ja, Du kleiner Penner, die machen Dich platt, wenn sie Dich erwischen!",
      "grunzt: "
      );
   AddInfo( ({"schluessel","aufsperren"}),
      ({ "Was Schluessel? Bist wohl am Phantasieren. Da nimm ein' guten"
       + " Schluck Bruehe!",
         "Schluessel was? Ja, wenn ich einen haett', wuerd' ich meinen Arsch"
       + " fuer 'ne Weile abschliessen - BRUHAHAHA!\n"}),
      "sagt: "
      );
   AddInfo( ({"carolina","gefangene","frau","maedchen"}),
      "Die muss ich noch gut maesten! Is ja so duenn wie ein Arm von mir.",
      "grinst: "
      );
   AddInfo( ({"kaefig","gefaengnis"}),
      "Was ist? Willste auch dorthin?",
      " grunzt: "
      );
   AddInfo( ({"latrine","scheisse"}),
      "Was? A pro pos!\nFrissdibled laesst einen scheusslichen"
    + " Stinkefurz ziehen.",
      "sagt: "
      );
   AddInfo( ({"betrunken","trinken","besoffen"}),
      "Ey, wer is hier besoffen?\nFrissdibled pinkelt Dir ans Bein.",
      "lallt: "
      ); 

   /*** NPC chats ***/

   SetChats(1, ({
      "Frissdibled roehrt: Smoerebroed Roehrebloed *RUEEEEELPS*"
    + " Schwerenoet <HICK>\n",
      "Frissdibled wischt eine fettige Hand in seinem grauslichen Lederschurz ab.\n",
      "Frissdibled furzt maechtig.\nFrissdibled seufzt: jaaAAAaaahhh! Tut das gut.\n"
    + "Von den Bauemen rundherum fallen ein paar tote Voegel.\n",
      "Frissdibled ruehrt die stinkende Bruehe im Kessel um.\n",
      "Frissdibled denkt . o O (Boah, ich muss mal dringend sch...)\nFrissdibled"
    + " sieht den Kochkessel versonnen an.\n",
      "Frissdibled kratzt sich am Hintern, dann steckt er einen Finger in"
    + " den Kochkessel und kostet genuesslich schmatzend die Bruehe.\n",
      "Frissdibled lacht polternd: BRUHAHAR, was fuer 'ne Kotzbruehe!\n",
      "Frissdibled sieht Dich aus kleinen, engstehenden Schweinsaeuglein an.\n"
    + "Frissdibled grunzt: Was liegt an, Du Gerippe? Mach ma' dasste"
    + " weita kommst. Sonst kommste in' Pott!\n",
      "Frissdibled furzt hinter Dir her.\n",
    }) );

   /*** NPC attack chats ***/

   SetAttackChats(30, ({
      "Frissdibled furzt geraeuschvoll. "+this_player()->name()+" wird"
    + " beinahe davon geblasen\n",
      "Frissdibled schreit: Der Pot wartet ey, Du alte Topsau!\n",
      "Frissdibled drueckt flink einen Pickel in seinem Gesicht: "
    + this_player()->name()+" wird von einem stinkenden Eiterbatzen"
    + " getroffen.\n",
      "Frissdibled grunzt laut. Sabber trieft von seinen fettigen Lippen.\n"
      "Frissdibled schreit: Du kannst keinen Kannibalen klarmachen,"
    + " kleines Gesocks!\n",
      "Frissdibled lacht irr: BRUHAHAHAHAR *glglg*\n",
      "Frissdibled fasst in den Kessel und wirft eine Ladung der"
    + " scheusslichen, stinkenden Bruehe. Deckung!\n"
   }) );
   
   /*** NPC attack spells ***/
   AddSpell(10,1,
      "Frissdibled sagt: 'Do eini!' und wirft Dich wieder in seinen Topf.\n",
      "Frissdibled sagt: 'Do eini!' und wirft @WEN wieder in seinen Topf.\n",
      DT_MAGIC, "mv_player"
      );
}
/*******************************************************/
/********************* SUBROUTINES *********************/
/*******************************************************/

/*** Der Spieler wird von Frissdibled in den Kochtopf gemoved ***/
mv_player(object enemy, int damage, mixed dam_type)
{
	enemy->move(KD_ROOM("kochtopf:"+getuid(enemy)),M_GO);	
}
