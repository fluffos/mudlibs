/* 
** Smilander - Hueter des Kaefigschluessels
** 17.12.1998  V1.0  Charon@SL
*/
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "../defines.h"

create()
{
   if (!is_clone(this_object())) return;

   ::create();
  
   AddId( ({"kannibale", "kannibalen_wache", "smilander","\nkd_smilander",
         "Keulenkaempfer"}) );
   create_default_npc( 15 );
   set_living_name ("smilander");

   /*** NPC properties ***/

   SetProp(P_SHORT, "Der Kannibale Smilander");
   SetProp(P_LONG,  "Smilander ist ein Waechter der Kannibalen."
      " Er ist nicht ganz so gross wie die anderen Waechter, hat"
      " aber einen breiten Ruecken und maechtige Pranken - von"
      " ihm moechtest Du keine Maulschelle kassieren. Es scheint"
      " Dir, als habe er seine Berufung verfehlt: 'Maurer'. Ganz"
      " im Gegensatz zu seinem maechtigen Koerper ist sein Kopf"
      " auffallend klein. Kleine, eng stehende Augen und eine"
      " plattgedrueckte Nase. Nur der Mund ist gross und breit und"
      " fast andauernd zu einem duemmlichen Grinsen verzogen - NIEMAND"
      " grinst wie er: Smilander - es kann nur einen geben!"
      );
   SetProp(P_NAME,  "Smilander");
   SetProp(P_GENDER, MALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_ALIGN, -150);
   SetProp(P_RACE, "Mensch");
   SetProp(P_WIMPY, 30);
   SetProp(P_SIZE, 195); 
   SetProp(P_HANDS, ({" mit seinen dreckigen Grapschern", 100}));

   /*** secondary NPC properties ***/

   SetProp(P_DEFAULT_INFO, ({
      "sieht Dich mit einem unsaeglich dummen Gesichtsausdruck an und - grinst.\n",
      "grinst Dich an.\n",
      "sagt: 'Ja?' und grinst Dich an.\n",
      "stammelt: 'W-w-wie? W-w-w-weiss n-n-nicht.'\nSmilander grinst.\n",
      }) );
   SetProp(P_DIE_MSG, " stoehnt auf.\nEin Blutstrahl schiesst aus seinem"
    + " Mund und er faellt zu Boden.\nSmilander stirbt mit einem breiten"
    + " Grinsen.\n"
    );
   SetProp(P_INFO, "Smilander besitzt keinerlei magische Kraefte. Lediglich"
    + " sein penetrantes Grinsen kann ganz schoen aufreibend und"
    + " kampfkraftzersetzend sein.\n"
    );

   /*** NPC object stuff ***/
   // euid setzen, damit Objekte gecloned werden koennen
   seteuid(getuid(this_object()));

   // Objekte clonen
   clone_object("/p/weapon/club/knueppel")->move(this_object());
   clone_object("/p/armour/trousers/lendenschurz")->move(this_object());
   clone_object(KD_OBJ("key_kaefig"))->move(this_object());
  
   // Objekte benutzen
   command ("zuecke knueppel");
   command("trage alles");
  
   /*** NPC details ***/

   AddDetail("ruecken",
      "Smilanders Ruecken ist so breit, dass in seinem Schatten"
    + " eine Familie mit 3 Kindern an einem sonnigen Nachmittag"
    + " gemuetlich picknicken koennte."
    );
   AddDetail( ({"haende","pranken"}),
      "Smilanders Pranken sind gross wie Maurerkellen. Er koennte ohne"
    + " Werkzeuge ein Haus bauen."
    );
   AddDetail("kopf",
      "Smilanders Kopf mutet neben seinem Koerper wie ein Mond"
    + " neben seinem grossen Planeten an. Nur der Grinsemund ist gross,"
    + " was neben auffaelligem Grinsen auch beschleunigte"
    + " Nahrungsaufnahme beguenstigen duerfte."
    );

   /*** NPC information ***/

   AddInfo( ({"waechter","kannibale","kannibalen","wache","wachen"}),
      ({ "Hu hmm - Waechter!","Smilander ist ... ein Waechter!",
         "Kannibalen-Waechter! Stark und schlau!" }),
      "sagt: "
      );
   AddInfo( ({"schluessel", "aufsperren"}),
      ({ "Was Sch-schsssluessel? Nix Schluessel!",
         "I prack di zamm!",
         "H-ha-haha h h habe keinen Schl-l-luessel nicht!" }),
      "schaut Dich entgeistert an und grunzt: "
      );
   AddInfo( ({"kaefig","gefaengnis","carolina","gefangene","frau","maedchen"}),
      "Hmm - glglgl - f ffff - f - Frau!",
      "schwenkt den Unterleib vor und zurueck und grinst: "
      );
   AddInfo( ({"haudibled","hauditot"}),
      "H-h-ha-haha-Haudi stark! Prakt di zsamm!",
      "grinst: "
      );
   AddInfo("haumined",
      "Hau-hau-mined schwach! Prakt di net zsamm!",
      "grinst noch breiter: "
      );
   AddInfo( ({"grinsen","smilander"}),
      "Es kann n-n-nur einen geben!",
      "zeigt sein breitestes Grinsen: "
      );

   /*** NPC chats ***/

   SetChats(1, ({
      "Smilander grinst.\n",
      "Smilander bohrt in der Nase ohne mit dem Grinsen aufzuhoeren.\n",
      "Smilander dreht einen fetten Popel und schnippt ihn mit"
    + " breitem Grinsen in die Botanik.\n",
      "Smilander kratzt sich am Kopf - und grinst.\n",
      "Smilander schaut verbluefft - selbst jetzt scheint er noch zu grinsen.\n",
      "Smilander griiiIIInnnst: rE!\n"
    }) );

   /*** NPC attack chats ***/

   SetAttackChats(30, ({
     "Smilander grinst: Hihi, ich k-kkk-klopf Dich w  w w-www ... weich!\n",
     "Smilander ruft: aeh - aeh - nix!\n",
     "Smilander grinst Dich an - am liebsten wuerdest Du ihm in die"
   + " Fresse treten...\n",
     "Smilander furzt geraeuschvoll. Smilander grinst Dich unschuldig an.\n",
     "Smilander schreit: H-h-hab's vergessen!\n",
     "Smilander bohrt genuesslich grinsend in der Nase, waehrend er"
   + " Dich mit einer Hand fertig macht.\n"
   }) );

   /*** NPC moving ***/
   
   SetProp(P_MNPC_AREA, KD_ROOM(""));
   SetProp(P_MNPC_WAIT, ({20, 20, 20}));
   SetProp(P_MNPC_DEFAULTROOM, KD_ROOM("room_r5"));
   SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
   SetProp(P_MSGIN,  "kommt an und grinst");
   SetProp(P_MSGOUT, "grinst und geht");
}
