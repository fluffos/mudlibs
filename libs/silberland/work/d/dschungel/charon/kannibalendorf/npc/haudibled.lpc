/* 
** Starke Wache (1) des Kannibalendorfes
** 17.12.1998  V1.0  Charon@SL
*/
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../defines.h"

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale", "kannibalen_wache", "haudibled","\nkd_haudibled" }) );
   create_default_npc( 13 );   
   set_living_name ("haudibled");

   /*** NPC properties ***/
   
   SetProp(P_SHORT, "Der Kannibale Haudibled");
   SetProp(P_LONG,  "Der Menschenfresser Haudibled ist derzeit als Waechter"
      " fuer das Kannibalendorf eingesetzt. So wie sein Bruder Hauditot ist"
      " auch er von ueberagender Statur, wenn gleich um ein bisschen kleiner."
      " Wie Hauditot liebt er seinen Beruf und es erfuellt ihn mit Stolz,"
      " den Feinden seines Stammes eines ueberzubraten. Gerne laesst er"
      " sich von huebschen Frauen beim Muskeltraining oder Ringkampf"
      " zusehen - man koennte sagen, er ist eitel. Aber reizen sollte"
      " man ihn mit seiner Eitelkeit nicht, denn wo er hinschlaegt, dort"
      " gedeiht nichts Schoenes mehr."
      );

   SetProp(P_NAME,    "Haudibled");
   SetProp(P_GENDER,  MALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_SIZE,    202);
   SetProp(P_HANDS,   ({" mit seinen Haenden", 70}));
   SetProp(P_ALIGN,   -100);
   SetProp(P_RACE,    "Mensch");
   SetProp(P_DIE_MSG, " stammelt: 'Warum habe ich diesen Angriff nicht gesehen?' und stirbt.\n");
   SetProp(P_DEFAULT_INFO,"stammelt: Haeehh?!?");
   
   SetAttribute(A_STR, 18);
   SetAttribute(A_INT,  9);
   /*** NPC object stuff ***/

   // euid setzen, damit Objekte gecloned werden koennen
   seteuid(getuid(this_object()));

   // Objekte clonen
   clone_object(KD_WEAPON("sch_keule"))->move(this_object());
   clone_object("/p/armour/trousers/lendenschurz")->move(this_object());

   // Objekte benutzen
   command("zuecke keule");
   command("trage alles");
      
   /*** NPC details ***/

   /*** NPC information ***/
   AddInfo( ({"eitel","eitelkeit"}),
      "Wennst bled wirst, hau' ich Dir die Birne ein!!!",
      "schreit: "
      );
      
   /*** NPC chats ***/

   /*** NPC attack chats ***/
}

