/* 
** Normaler Bewohner des Kannibalendorfes
** 17.12.1998  V1.0  Charon@SL
*/
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../defines.h"

create()
{
   if (!is_clone(this_object())) return;

   ::create();

   AddId( ({"kannibale","\nkd_kannibale"}) );
   create_default_npc( 12 );   
//   set_living_name ("");

   /*** NPC properties ***/
   
   SetProp(P_SHORT, "Ein Kannibale");
   SetProp(P_LONG,  "Der Kannibale sieht furchteinfloessend aus. Beinahe moechtest"
      " Du wegrennen, als du in sein Gesicht siehst, denn Du erblickst eine Fratze"
      " des Todes. Die rituelle Bemalung soll vor boesen Geistern schuetzen und"
      " dem Kannibalen Kraft im Kampf geben. Du kannst Dir leicht vorstellen,"
      " dass es fuer den Kannibalen ein wahres Vergnuegen waere, Dich zu toeten"
      " und Dich danach genuesslich als Dessert zu verspeisen."
      );

   SetProp(P_NAME,      "Kannibale");
   SetProp(P_GENDER,    MALE);
   SetProp(P_ARTICLE,   1);
   SetProp(P_SIZE,      170+random(20));
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HANDS,     ({" mit seinem Messer", 60}));
   SetProp(P_ALIGN,     -35);
   SetProp(P_RACE,      "Mensch");
   SetProp(P_DIE_MSG,   " ist nun selbst das Dessert fuer den Tod.\n");
   SetProp(P_DEFAULT_INFO,"bruellt: AAaaaauuuugah????");

   /*** NPC object stuff ***/
   // euid setzen, damit Objekte gecloned werden koennen
   seteuid(getuid(this_object()));

   // Objekte clonen
   clone_object(KD_WEAPON("messer"))->move(this_object());
   clone_object("/p/armour/trousers/lederhose")->move(this_object());
   clone_object("/p/armour/cloak/lederschuerze")->move(this_object());
   
   // Objekte benutzen
   command("zuecke messer");
   command("trage alles");
   
   /*** NPC details ***/
   AddDetail( ({"gesicht","fratze","tod","todes"}),
      "Du kannst eine rituelle Bemalung erkennen, so wie sie bei Natuervoelkern"
    + " ueblich sind."
    );
   AddDetail( "bemalung",
      "Sie stellt den Tod dar. Kannibalen haben eine besondere Affinitaet zum"
    + " Tod, wahrscheinlich weil sie oft den Tod ueber andere bringen."
    );
   AddDetail("kraft",
      "Er ist zwar nicht so kraeftig wie Haudibled oder Hauditot, aber vom"
    + " Kampf gestaehlt und sicher kein leichter Gegner."
    );
   AddDetail("vergnuegen",
      "Ja, es wuerde ihn wirklich freuen, wenn er Dich toeten duerfte. Also,"
    + " greif ihn an."
    );
    
   /*** NPC information ***/

   /*** NPC chats ***/

   /*** NPC attack chats ***/
}

