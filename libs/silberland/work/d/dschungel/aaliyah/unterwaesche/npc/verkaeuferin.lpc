// Die Verklaeuferin des Unterwaescheladens
// 2005-04-15 Feyaria@SilberLand

inherit "std/npc";

#include "../def.h"

void init()
{
  ::init();
  if ( TP && TP->id("ELF")) AddDefender(TP);
}

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

   SetProp(P_SHORT, "Ayadriel, die Verkaeuferin");
   SetProp(P_LONG, 
     "Die Verkaeuferin des Unterwaescheladens ist eine bildhuebsche, junge "
     "Elfe mit langen, blauschwarzen Haaren. Sie verkauft hier die feinste "
     "Unterwaesche im ganzen SilberLand. Sie hat eine fantastische Figur, mit "
     "den richtigen Proportionen am richtigen Platz; sicher sieht sie in "
     "ihrer Unterwaesche umwerfend aus, aber momentan traegt sie ein leichtes "
     "Bauschkleid. Wenn man sie ganz nett bittet, ist sie vielleicht auch "
     "bereit, das eine oder andere Modell ihrer Kollektion vorzufuehren.");

  AddId ( ({ "verkaeuferin", "ayadriel", "elf","elfe", "elfin", "ELF"}) );

  create_default_npc(16);

  SetProp(P_NAME, "Ayadriel"); 
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 850);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit ihren Naehnadeln", 160, DT_PIERCE}) );
  SetProp(P_SIZE, 177);

  SetProp(P_DIE_MSG,
    " faellt tot zu Boden.\n" ); 
  SetProp(P_REJECT, ({ REJECT_KEEP,
    "Ayadriel sagt: Vielen Dank!\n" }) );

  SetProp(P_LOG_INFO,"feyaria/elfendorf");
  AddInfo(DEFAULT_INFO, ({
    "sagt: Du brauchst dringend neue Unterwaesche.\n",
    "sagt: Wann hast Du das letzte Mal Deine Unterwaesche gewechselt?\n",
    "sagt: Kauf doch etwas!\n" }) );
  AddLibrary( NPC "elfendorf.lib",1);

  AddInfo( ({"ayadriel", "verkaeuferin"}), "nickt.\n");
  AddInfo( ({"laden", "unterwaescheladen", "angebot"}),
    "Das ist mein Unterwaescheladen. Wenn Du Dich ueber das Angebot informieren "
    "willst, dann mach einfach 'zeige'.", "sagt: ");
  AddInfo( ({"unterwaesche", "string", "top", "pareo", "slip", "bh",
        "buestenhalter", "pants", "hotpants", "unterhose", "shorts",
        "boxershorts", "struempfe", "hoeschen", "unterhoeschen",
        "seidenstruempfe"}),
    "Das kannst Du bei mir kaufen.", "sagt: ");
  AddInfo( ({"mutter", "schneiderin", "kleidung"}),
      "Meine Mutter, die Schneiderin, verkauft Kleidung gleich nebenan.",
      "sagt: ");
  AddInfo( ({"farben", "farbe",}), 
      "Folgenden Farben habe ich zur Auswahl: Schwarz, Weiss, Kirschrot, "
      "Zartrosa, Hellblau und Lila.", "sagt: ");
  AddInfo( ({"schwarz"}),
      "Eine erotische Farbe.", "sagt: ");
  AddInfo( ({"weiss"}),
      "Eine unschuldige Farbe.", "sagt: ");
  AddInfo( ({"rot", "kirschrot"}),
      "Eine leidenschaftliche Farbe.", "sagt: ");
  AddInfo( ({"rosa", "zartrosa"}),
      "Eine verspielte Farbe.", "sagt: ");
  AddInfo( ({"hellblau", "blau"}),
      "Eine schoene Farbe.", "sagt: ");
  AddInfo( ({"lila"}),
      "Eine verfuehrerische Farbe.", "sagt: ");

  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE,25);
  AddSpell(1,350,
    "Ayadriel wirft Dir einen Bauschballen auf den Kopf.\n",
    "Ayadriel wirft @WEM einen Bauschballen auf den Kopf.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]) );
 
  SetChats(3, ({
    Name(WER,1) + " sortiert die Unterwaesche.\n",
    Name(WER,1) + " zeigt Dir einen verfuehrerischen Spitzen-BH.\n",
    Name(WER,1) + " sagt: Du brauchst dringend neue Unterwaesche.\n",
    Name(WER,1) + " sagt: Ich habe die groesste Auswahl an Dessous im ganzen Silberland.\n",
    Name(WER,1) + " sagt: Ein Tanga steht Dir sicher gut.\n",
    Name(WER,1) + " gruebelt: Rosa? Oder Hellblau? Oder doch lieber Weiss?\n",
    Name(WER,1) + " strahlt Dich an.\n",
    Name(WER,1) + " laechelt Dich an.\n",
    Name(WER,1) + " fragt Dich: Willst Du etwas kaufen?\n",
    Name(WER,1) + " sagt: Ich habe sehr schoene Dessous im Angebot.\n",
    Name(WER,1) + " sagt: Darf ich Dir mein Angebot zeigen?\n",
    Name(WER,1) + " sagt: Mit der richtigen Unterwaesche wirkt jeder erotisch.\n",
    Name(WER,1) + " sagt: Unterwaesche ist die wichtigste Kleidung.\n",
    Name(WER,1) + " sagt: Mit 'zeige fuer frauen' siehst Du alle Dessous nur fuer Frauen.\n",
    Name(WER,1) + " sagt: Mit 'zeige fuer maenner' siehst Du alle Unterwaesche fuer Maenner.\n",
    Name(WER,1) + " sagt: Mit 'zeige jeden BH' siehst Du alle Buestenhalter.\n",
    Name(WER,1) + " sagt: Mit 'zeige jede unterhose' siehst Du alle Unterhosen.\n",
    }) );

  SUID;

  if( random(2) )
  {
    CLONEME( ARMOUR_DS "b_kleid" );
  }
  else
  {
    CLONEME( ARMOUR_ELF "rock" );
    CLONEME( ARMOUR_DS "bluse" );
  }
  if( !random(5)  )
    CLONEME( ARMOUR_DS "seidentuch");
  command("trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Warum machst Du so boese Sachen, "+TPN+"?");
}

void intim()
{
  if( TP->QueryProp(P_RACE)!="Zwerg")
  {
    if( TP->QueryProp(P_GENDER) == QueryProp(P_GENDER) )
      command_me("sag Bist Du vielleicht anders rum, "+TPN+"?");
    else
    {
      write(Name(WER,1)+" schmiegt sich an Dir an und fluestert: Du bist "
        "lieb, "+TPN+".\n");
      tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an und "
        "fluestert etwas.\n");
    }
  }
  else
    command_me("sag Lass das, Du Zwerg!");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " treostet "+TPN+".\n", ({TP, TO}) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "elfendorf", ctime()+": "+Name(WER,1)+
                 " hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

