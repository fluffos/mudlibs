// Unterwaescheladen
// 2005-04-15 Feyaria@SilberLand

inherit "std/laden";

#include <laden.h>
#include "../def.h"

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem Unterwaescheladen" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem Unterwaescheladen. Ueberall an den Waenden "
    "sind zarte Gebilde aus feinster Seide zu sehen, die sich bei naeherer "
    "Betrachtung als Dessous herausstellen. Du siehst alle verschiedenen "
    "Arten von Unterwaesche in den verschiedensten Farben und Groessen, "
    "sodass sich hier wohl fuer jeden Geschmack etwas finden laesst. "
    "Boden und Decke dagegen bieten kaum etwas Interessantes, auch die "
    "Tuer nach Osten kann Deinen Blick nicht von den vielen Dessous ablenken.");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN: TT_HOUSE]));

  SetStorageRoom (ROOM "store");
  SetBuyFact(4);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+ SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "verkaeuferin");
  SetProp(P_SHOPKEEPER_NAME, "Ayadriel");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SPECIAL_SHOP, ([1: "Ayadriel sagt: Tut mir leid, ich kaufe nichts an.\n"]) );

  AddDetail( ({"boden", "holzbretter", "holzbrett", "decke"}),
      "Der Boden und die Decke bestehen aus Holzbrettern und sind total "
      "uninteressant.");
  AddDetail( ({"holz"}),
      "Wie alles in diesem Dorf ist auch hier alles aus Holz erbaut.");
  AddDetail( ({"dorf", "dschungelelfen"}),
      "Du befindest Dich im Dorf der Dschungelelfen.");
  AddDetail( ({"wand", "waende"}),
      "An den Waenden sieht man die vielen verschiedenen Arten von Unterwaesche, "
      "die man hier kaufen kann. Es gibt so viele verschiedene Modelle in den "
      "verschiedensten Farben, dass Du kaum alles richtig erfassen kannst.");
  AddDetail( ({"laden", "unterwaescheladen", "dessousladen", "raum"}),
      QueryProp(P_INT_LONG));
  AddDetail( ({"gebilde", "betrachtung"}), 
      "Bei naeherer Betrachtung stellen die Gebilde sich als Dessous heraus.");
  AddDetail( ({"seide"}), 
      "Feinste Seide wurde fuer diese Unterwaesche verwendet, daher wird sie "
      "sich sicher sehr gut auf der Haut anfuehlen.");
  AddDetail( ({"haut"}),
      "Unterwaesche aus Seide fuehlt sich sehr gut auf der Haut an.");
  AddDetail( ({"dessous", "unterwaesche"}), 
      "Spitzenunterhoeschen, Seidentangas, Seidenbhs usw.");
  AddDetail( ({"spitzenunterhoeschen", "unterhoeschen", "seidentanga",
        "seidentangas", "tanga", "tangas", "seidenbhs", "bhs", "bh", 
        "seidenbh"}),
      "Kauf es Dir, wenn Du es naeher anschauen willst.");
  AddDetail( ({"farben", "farbe",}), 
      "Schwarz, Weiss, Rot, Rosa, Hellblau, Lila.....");
  AddDetail( ({"schwarz"}),
      "Eine erotische Farbe.");
  AddDetail( ({"weiss"}),
      "Eine unschuldige Farbe.");
  AddDetail( ({"geschmack"}),
      "Jeder hat einen anderen Geschmack.");
   AddDetail( ({"auswahl"}),
      "Du hast hier eine grosse Auswahl.");
  
  
  AddDetail( ({"rot"}),
      "Eine leidenschaftliche Farbe.");
  AddDetail( ({"rosa"}),
      "Eine verspielte Farbe.");
  AddDetail( ({"hellblau"}),
      "Eine schoene Farbe.");
  AddDetail( ({"lila"}),
      "Eine verfuehrerische Farbe.");
  AddDetail( ({"groessen", "groesse"}), 
      "Die Groessen passen fuer alle Rassen im Silberland.");
  AddDetail( ({"silberland", "rassen", "elfen"}),
      "Im Silberland gibt es viele Rassen, hier leben hauptsaechlich Elfen.");
  AddDetail( ({"modell", "modelle", "art", "arten"}), 
      "Es gibt hier Modelle in den unterschiedlichsten Farben und Groessen, "
      "es muesste eigentlich fuer jeden etwas dabei sein.");
  AddDetail( ({"geschmack", "geschmaecker"}), 
      "Die Geschmaecker sind verschieden, aber da es hier so viel Auswahl "
      "gibt, wird sicher jeder etwas passendes finden.");
  AddDetail( ({"auswahl"}),
      "Dieser Laden hat eine grosse Auswahl an Unterwaesche.");
  AddDetail( ({"interessantes", "interesse", "blick"}), 
      "Ausser den vielen Dessous vermag hier nichts Dein Interesse zu wecken, "
      "aber da es hier so viele davon gibt, genuegt das, um Dich fuer einige "
      "Zeit zu beschaeftigen.");
  AddDetail( ({"zeit"}),
      "Du koenntest viel Zeit damit verbringen, die ganzen Dessous hier zu "
      "betrachten.");
  AddDetail( ({"tuer", "osten"}), 
      "Die Tuer fuehrt nach Osten.");
  

  AddSound( DEFAULT_SOUND, "Es ist sehr leise hier.");
  AddSmell( DEFAULT_SMELL, "Es riecht angenehm hier.");

  AddExit( "osten",   "/d/dschungel/feyaria/dorf/room/bauschladen" );

  AddItem( NPC "verkaeuferin", REFRESH_DESTRUCT );
  RemoveFixedObject();
}

int Is_male(object ob) 
{
  if (!mappingp(ob->QueryProp(P_WEAR_RESTRICTIONS))) return 1;
  if (ob->QueryProp(P_WEAR_RESTRICTIONS)[P_GENDER] == FEMALE) return 0;
  return 1;
}

int Is_female(object ob) 
{
  if (!mappingp(ob->QueryProp(P_WEAR_RESTRICTIONS))) return 1;
  if (ob->QueryProp(P_WEAR_RESTRICTIONS)[P_GENDER] == MALE) return 0;
  return 1;
}

int list(string str)
{
  if (str == "maenner" || str == "fuer maenner")
    return DoList("Is_male",0,0, "Unterwaesche fuer Maenner");
  if (str == "frauen" || str == "fuer frauen")
    return DoList("Is_female",0,0, "Dessous fuer Frauen");
  return ::list(str);
}
