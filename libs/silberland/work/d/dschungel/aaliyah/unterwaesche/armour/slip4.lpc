#include "../def.h"

inherit ARMOUR "std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein gruener Maennerslip");
  SetProp(P_LONG, 
    "Ein einfacher, roter Maennerslip. Genau diese Art von Unterwaesche, "
    "die Mann traegt wenn ers bequem und einfach haben moechte. Der Slip "
    "liegt perfekt an den Lenden des Traegers an und macht einen knackigen "
    "Po.");
  SetProp(P_NAME, "Maennerslip");
  SetProp(P_GENDER, MALE); 
  AddId( ({"slip","maennerslip"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_NAME_ADJ, "gruen");
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 
  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );
    
 }  
   
