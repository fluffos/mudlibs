inherit "std/armour";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein hellblaues Negligee");
  SetProp(P_LONG, 
    "Dieses zarte, hellblaue Negligee ist ein maerchenhaftes Gebilde "
    "aus purer Seide. Es hat duenne Spaghettitraeger und einen tiefen, "
    "V-foermigen Ausschnitt. Weiters liegt es hauteng am Oberkoerper an. "
    "Der weiche Stoff flattert um die Lenden der Traegerin und reicht bis "
    "kurz ueber die Knie.");
  SetProp(P_NAME, "Negligee");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"negligee"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "hellblau");
  
  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
 }  
   
