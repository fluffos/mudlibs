#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein getupfter Seiden-BH");
  SetProp(P_LONG, 
    "Dieser BH besteht aus hellblauer Seide. Viele weisse Tupfen zieren ihn "
    "und bilden somit ein verspieltes Muster. Die Koerbchen sind verstaerkt "
    "sodass die Brueste schoen geformt werden. Zwischen den Koerbchen wurde "
    "eine kleine weisse Masche aufgenaeht.");
  SetProp(P_INFO, "Dieser Seiden-BH laesst Dich Deinen Traummann finden");
  SetProp(P_NAME, "Seiden-BH");
  SetProp(P_GENDER, MALE); 
  AddId( ({"getupfter seidenbh","bh","seidenbh"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 670);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "getupft");
  AddDetail( ({"masche"}),
	 "Eine suesse kleine Masche wurde zwischen den Koerbchen angenaeht.");

  SetProp("underwear_type", "Buestenhalter");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
