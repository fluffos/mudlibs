#include "../def.h"

inherit ARMOUR "std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein schwarzer Seidentanga");
  SetProp(P_LONG, 
    "Dieser zarte Seidentanga ist ein Traum jedes Mannes. Er schmiegt sich "
    "eng an den Koerper der Frau und bringt ihre Figur perfekt zur Geltung. "
    "Eine kleine schwarze Masche ziert die Vorderseite.");
  SetProp(P_NAME, "Seidentanga");
  SetProp(P_GENDER, MALE); 
  AddId( ({"tanga","seidentanga","string","unterhose"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 450);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "schwarz");
  AddDetail( ({"masche"}),
	 "Die Masche ist klein, zart und pechschwarz.");

  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
