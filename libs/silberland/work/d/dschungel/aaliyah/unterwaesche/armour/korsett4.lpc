#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";


int korsett = 0;
void create()
	
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein schwarzes Latexkorsett");
  SetProp(P_LONG, 
    "Das Korsett besteht aus schwarzem Latex. Es liegt hauteng am Koerper "
    "der Traegerin und bringt ihn somit gut zur Geltung. Auf der Rueckseite "
    "befinden sich zwei Lederbaender, mit denen man es schnueren kann. "
    "Ausserdem ist es auf der Vorderseite sehr freizuegig ausgeschnitten, "
    "sodass man viel nackte Haut der Traegerin zu Gesicht bekommt. Weiters "
    "werden die Brueste der Traegerin enorm in die Hoehe gehoben.");
  SetProp(P_INFO, "Dieses Korsett macht grosse Brueste und taeuscht die "
		  "Maenner somit perfekt.");
  SetProp(P_NAME, "Latexkorsett");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"korsett"}) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 1500);
  SetProp(P_MATERIAL, ([MAT_PLASTIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "schwarz");
  AddDetail( ({"brueste"}),
	 "Dieses Korsett macht aus kleinen Bruesten, grosse Brueste.");

  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
   string extra_look()
 {
  object player;
  if (!player = environment()) return "";
  if (QueryProp(P_WORN))
  
      return player->Name() + " hat so ein atemberaubendes Dekolletee, dass "                                 "Dir ganz schwindlig wird.\n";
  else
    return "";  
  }

