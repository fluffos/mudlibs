#include "../def.h"

inherit ARMOUR "std_underwear";


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein lustiger Elefantenstring");
  SetProp(P_LONG, 
    "Dieser kitschige Elefantentanga ist die Sensation jedes Abends. Er "
    "ist grau und hat auf der Vorderseite den Kopf eines Elefantens aufgenaeht. "
    "Sein Ruessel sieht dermassen lustig aus, dass Du wirklich lachen musst.");
  SetProp(P_NAME, "Elefantenstring");
  SetProp(P_GENDER, MALE); 
  AddId( ({"elefantenstring","string"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 600);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "lustig");
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );

 }  
   
