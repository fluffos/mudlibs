inherit "std/armour";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Teddypyjama");
  SetProp(P_LONG, 
    "Ein suesser, beiger Pyjama mit einem huebschen, bunten Teddybaermuster. "
    "Er besteht vollkommen aus Baumwolle und fuehlt sich wunderbar auf der "
    "Haut an. Seine weite Passform verschafft einen enormen Tragekomfort.");
  SetProp(P_INFO, "Dieser Pyjama versetzt Dich in Kuschellaune");
  SetProp(P_NAME, "Teddypyjama");
  SetProp(P_GENDER, MALE); 
  AddId( ({"pyjama","teddypyjama"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2400);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 0);

      
 }  
   
