#include "../def.h"

inherit ARMOUR "std_underwear";


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Schwarze Boxershorts");
  SetProp(P_LONG, 
    "Diese schwarzen Boxershorts sind ein Traum jeden Mannes. Sie sind so "
    "bequem zu tragen, dass Mann sie am liebsten ueberall tragen moechte. "
    "Auf der Vorderseite steht in neongelben Lettern *Rammler* geschrieben.");
  SetProp(P_NAME, "Boxershorts");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"shorts","boxershorts"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 
  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );

  
    
 }  
   
