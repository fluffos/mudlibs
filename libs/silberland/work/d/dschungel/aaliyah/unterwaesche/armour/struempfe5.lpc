#include "../def.h"

inherit ARMOUR "std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Zartrosa Seidenstruempfe");
  SetProp(P_LONG, 
    "Zartrosa, durchsichtige Seidenstruempfe. Sie haben einen Spitzensaum und "
    "haften selbstklebend an den Oberschenkeln. Durch die Beimischung von "
    "Elasthan ist eine perfekte Passform gegeben.");
  SetProp(P_NAME, "Seidenstruempfe");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"struempfe","seidenstruempfe"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 650);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "zartrosan");
   
  SetProp("underwear_type", "Struempfe");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
   
 }  
   
