#include "../def.h"

inherit ARMOUR "std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein weisses Spitzenunterhoeschen");
  SetProp(P_LONG, 
    "Ein weisses, zartes Unterhoeschen. Es besteht voellig aus Spitzen und "
    "ist die perfekte Unterwaesche fuer eine Braut. Auf etwas gebraeunter "
    "Haut sieht das Hoeschen noch toller aus.");
  SetProp(P_NAME, "Spitzenunterhoeschen");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"unterhoeschen","spitzenunterhoeschen","hoeschen","unterhose"}) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 600);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_NAME_ADJ, "weiss");
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 
  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

    
 }  
   
