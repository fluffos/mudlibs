#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein zartrosa Korsett");
  SetProp(P_LONG, 
    "Das Korsett besteht aus rosafarbenen Spitzen. Es ist hat zwei duenne "
    "Traeger, auf denen einige kleine Blueten aufgenaeht sind. Auf der "
    "Rueckseite befinden sich zwei zarte rosa Baender, mit denen es geschnuert "
    "werden kann. Ausserdem ist es mit einigen huebschen, aufgenaehten "
    "Blueten und Perlen verziert.");
  SetProp(P_INFO, "Dieses Korsett versetzt Dich in eine romantische Stimmung.");
  SetProp(P_NAME, "Korsett");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"korsett"}) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 450);
  SetProp(P_MATERIAL, ([MAT_SATIN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "zartrosan");
  AddDetail( ({"blueten"}),
	 "Die Blueten bestehen aus rosa Satin und haben eine Perle in der "
	 "Mitte.");

  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
