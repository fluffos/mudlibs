#include "../def.h"

inherit ARMOUR "std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein schwarzes Netzshirt");
  SetProp(P_LONG, 
    "Dieses schwarze Netzshirt liegt hauteng am Koerper an. Es erinnert "
    "irgendwie an ein Spinnennetz so perfekt formt es sich an den Traeger. "
    "Es sieht sehr erotisch aus.");
  SetProp(P_NAME, "Netzshirt");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"netzshirt","shirt"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 700);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );

 }  
   
