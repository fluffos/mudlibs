#include "../def.h"

inherit ARMOUR "std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein zartrosa Top");
  SetProp(P_LONG, 
    "Dieses zartrosa Top schmiegt sich perfekt an den Koerper seiner "
    "Traegerin. Es hat ein kleines Muster aus hellblauen Bluemchen und "
    "sieht somit sehr verspielt und suess aus.");
  SetProp(P_NAME, "Top");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"top"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 650);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "zartrosan");
  AddDetail( ({"muster","bluemchen"}),
	 "Viele zarte Bluemchen bilden ein suesses Muster.");

  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
