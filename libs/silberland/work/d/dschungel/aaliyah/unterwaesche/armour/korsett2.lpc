#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein bluetenweisses Korsett");
  SetProp(P_LONG, 
    "Das Korsett besteht aus weissem, glaenzendem Satin. Es ist schulterfrei "
    "und wird am Ruecken zusammengeschnuert. Die Vorderseite besteht aus "
    "durchsichtigen Spitzen, die einen freizuegigen Einblick ermoeglichen. "
    "Ausserdem hat dieses Korsett eine Push-Up-Wirkung und macht ein sehr "
    "schoenes Dekolletee.");
  SetProp(P_INFO, "Dieses Korsett zieht die Maenner magisch an.");
  SetProp(P_NAME, "Korsett");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"korsett"}) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 1000);
  SetProp(P_MATERIAL, ([MAT_SATIN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "bluetenweiss");
  AddDetail( ({"spitzen","vorderseite"}),
	 "Die Vorderseite besteht aus lauter Spitzen und ist durchsichtig.");

  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
