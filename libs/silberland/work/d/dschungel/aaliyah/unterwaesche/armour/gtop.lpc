#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein getupftes Top");
  SetProp(P_LONG, 
    "Dieses suesse hellblaue Seidentop schmiegt sich eng an den Koerper an. "
    "Es bringt die Figur so richtig gut zur Geltung und ist bauchfrei. Viele "
    "weisse Tupfen bilden ein niedliches Muster. Es hat zarte Spaghettitraeger "
    "und beim Dekolletee wurde eine kleine weisse Masche aufgenaeht.");
  SetProp(P_INFO, "Dieses niedliche Top bringt Dich zum Traeumen");
  SetProp(P_NAME, "Top");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"seidentop","getupftes top","top"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 870);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "getupft");
  AddDetail( ({"masche"}),
	 "Eine suesse kleine Masche wurde am Dekolletee angenaeht.");

  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
