#include "../def.h"

inherit ARMOUR "std_underwear";


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Bunte Hawaiibermudas");
  SetProp(P_LONG, 
    "Diese quietschfroehlichen, bunten Bermudas garantieren die vollkommene "
    "Bewegungsfreiheit. Sie haben ein lustiges Muster und flattern locker und "
    "leicht um die Lenden des Traegers. Sie sind sehr bequem und werden auch "
    "gerne zum Baden verwendet.");
  SetProp(P_NAME, "Hawaiibermudas");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"bermudas","hawaiibermudas"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_NAME_ADJ, "bunt");
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

  AddDetail( ({"muster"}),
   "Viele Palmen, einige Dschungelelfen beim Cocktailtrinken und viele "
   "huebsche Dschungelelfinnen, knapp bekleidet mit Blumenkraenzen.");
 
			  
  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );
    
 }  
   
