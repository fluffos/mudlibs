#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein rotschwarzes Korsett");
  SetProp(P_LONG, 
    "Das Korsett besteht voellig aus rotem und schwarzem Satin. Es ist "
    "schulterfrei und wird am Ruecken zusammengeschnuert. Ausserdem kann es "
    "auch an der Vorderseite geschnuert werden, was aber nur der Zierde dient. "
    "Es ist ein sehr reizvolles Kleidungsstueck, das die Formen der Traegerin "
    "gewiss gut zur Geltung bringt.");
  SetProp(P_INFO, "Dieses Korsett verleiht Dir eine hocherotische Ausstrahlung");
  SetProp(P_NAME, "Korsett");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"korsett"}) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 450);
  SetProp(P_MATERIAL, ([MAT_SATIN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "rotschwarz");
  AddDetail( ({"masche"}),
	 "Die Masche ist klein, zart und hellblau.");

  SetProp("underwear_type", "Top");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
