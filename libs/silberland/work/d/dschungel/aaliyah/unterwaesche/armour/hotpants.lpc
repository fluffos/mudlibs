inherit "std/armour";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Zartrosa Hotpants");
  SetProp(P_LONG, 
    "Diese zartrosa Hotpants schmiegen sich perfekt an die Taille ihrer "
    "Traegerin. Sie haben ein kleines Muster aus hellblauen Bluemchen und "
    "sehen sehr verspielt und suess aus.");
  SetProp(P_NAME, "Hotpants");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"hotpants","pants"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "zartrosan");
  AddDetail( ({"muster","bluemchen"}),
	 "Viele zarte Bluemchen bilden ein suesses Muster.");
  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
