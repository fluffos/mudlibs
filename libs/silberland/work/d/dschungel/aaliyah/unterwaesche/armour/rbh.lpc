inherit "std/armour";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein zartrosa Spitzen-BH");
  SetProp(P_LONG, 
    "Dieser rosafarbene, zarte Spitzenbh schmiegt sich perfekt an die Brueste "
    "seiner Traegerin. Er pusht sie etwas in die Hoehe und laesst sie somit "
    "voller und knackiger wirken und verleiht ein traumhaftes Dekolletee.");
  SetProp(P_NAME, "Spitzen-BH");
  SetProp(P_GENDER, MALE); 
  AddId( ({"bh","spitzenbh","buestenhalter"}) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_NAME_ADJ, "rosan");
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

  SetProp("underwear_type", "Buestenhalter");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
    
 }  
   
