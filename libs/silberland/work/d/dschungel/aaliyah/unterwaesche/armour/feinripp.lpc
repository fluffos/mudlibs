#include "../def.h"

inherit ARMOUR "std_underwear";


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Opas Feinripp mit Eingriff");
  SetProp(P_LONG, 
    "Diese Unterhose flattert um die Lenden ihres Traegers. Sie hat an der "
    "Vorderseite einen bequemen Eingriff. Sie sieht zwar nicht sehr erotisch "
    "aus, jedoch bietet sie so einen hohen Komfort dass die Nachfrage gross "
    "ist.");
  SetProp(P_NAME, "Feinripp mit Eingriff");
  SetProp(P_GENDER, MALE); 
  AddId( ({"feinripp","unterhose"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 350);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

  AddDetail( ({"eingriff"}),
    "Ja der ist dazu da, um dem kleinen Mann die grosse Welt zu zeigen."); 
			  
  
  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );

 }  
   
