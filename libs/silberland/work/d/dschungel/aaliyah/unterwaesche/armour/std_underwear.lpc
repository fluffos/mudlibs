inherit "/std/armour";

#include "../def.h"

int first = 0;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SUID;
}

int underwear_test(object ob)
{
  if (ob->QueryProp("underwear_type") == QueryProp("underwear_type"))
    return 1;
  return 0;
}

varargs int DoWear(int silent, int all)
{
  object *obs, *misc;
  
  if (sizeof(misc = environment()->QueryArmours(AT_MISC)))
  {
    if (sizeof(obs = filter_array(misc, "underwear_test"))) 
    {
      if (obs[0] != this_object())
      {
        if (all)
        {
          tell_object(environment(),
              sprintf("Aber Du traegst bereits %s als %s.\n",
                obs[0]->name(WEN,1), QueryProp("underwear_type")));
          return 0;
        }
        else
          obs[0]->DoUnwear();
      }
    }
  }
  if (first == 1)
  {
    WLOG(LOG "underwear", "zieht " + name(WEN) + " an");
    first = 2;
  }
  return ::DoWear(silent, all);
}

void init()
{
  ::init();
  if (first == 0 && TP && MENV && TP == MENV && ENV(TP) &&
      file_name(ENV(TP)) == ROOM "laden")
  {
    WLOG(LOG "underwear", "kauft " + name(WEN));
    first = 1;
  }
}

