#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein beige Panty");
  SetProp(P_LONG, 
    "Die beige Panty sitzt enganliegend am Koerper an und betont somit perfekt "
    "die Figur. Vorne befindet sich ein Muster aus gezogenen, altrosa "
    "Satinbaendern. ");
  SetProp(P_INFO, "Diese Panty macht Dich irgendwie jugendlicher");
  SetProp(P_NAME, "Panty");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"panty","unterhose"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 450);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "beig");
  AddDetail( ({"muster","satinbaendern","satinbaender","baender"}),
	 "Drei zartrosa Satinbaender wurden zu einem verspieltem Muster "
	 "gezogen.");

  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
