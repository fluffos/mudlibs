#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Getupfte Hotpants");
  SetProp(P_LONG, 
    "Diese suessen Hotpants besteht aus hellblauer Seide. Viele kleine weisse "
    "Punkte bilden ihr Muster. An den Saeumen wurden zarte Rueschen aufgenaeht "
    "und lassen sie niedlich aussehen.");
  SetProp(P_NAME, "Hotpants");
  SetProp(P_INFO, "Diese Hotpants verleiht Dir einen enormen Charme");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"getupfte hotpants","hotpants","pants","unterhose"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 670);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_NAME_ADJ, "getupft");
  AddDetail( ({"rueschen"}),
	 "Die Rueschen zieren die Hotpants und lassen sie so verspielt wirken.");

  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

 }  
   
