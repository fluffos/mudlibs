inherit "std/armour";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Beige enge Shorts");
  SetProp(P_LONG, 
    "Frauenherzen schlagen hoeher bei dieser hocherotischen Art der "
    "Unterwaesche. Diese Shorts liegen hauteng an den Lenden des Traegers "
    "an und verleihen ihm ein aeusserst maskulines Aussehen. Weiters sind sie "
    "sehr bequem und zwicken nichts ein, sodass sie gerne getragen werden.");
  SetProp(P_NAME, "Shorts");
  SetProp(P_INFO, "Diese Shorts lassen Frauenherzen hoeher schlagen");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"shorts","unterhose"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "beige");
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

  SetProp("underwear_type", "Unterhose");
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]) );

 }  
   
