#include "../def.h"

inherit  "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Nachthemd aus Seide");
  SetProp(P_LONG, 
    "Ein langes Nachthemd aus purer Seide. Es ist hellblau und schmiegt sich "
    "sanft am Koerper an. Das Nachthemd ist schulterfrei und bodenlang und "
    "hat an den Saeumen einige Perlenstraenge aufgenaeht. Ausserdem befinden "
    "sich am Dekolletee einige Pailetten, die ein schoenes Muster ergeben.");
  SetProp(P_NAME, "Nachthemd");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"nachthemd","hemd"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 950);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 0);
  AddDetail( ({"muster","orchidee"}),
	 "Irgendwie erinnert Dich das Muster an eine Orchidee.");

  AddDetail( ({"perlenstraenge","straenge","saeume","saeumen"}),
	  "An den Saeumen wurden viele kleine hellblaue Perlen aufgenaeht. "
	  "Auch einige dunkelblaue Perlen befinden sich darunter.");

  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

}  
   
