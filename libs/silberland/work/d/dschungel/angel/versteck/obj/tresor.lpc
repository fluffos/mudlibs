/******************************************************************************
 * Netter Tresor der das Kristallherz der Liebe (ungesegnet) enthaelt
 * Datei: tresor.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */
 
inherit "/obj/container";

#include "def.h"
#include <exploration.h>

int   tries;
int   elapsed_time;
mixed thieves;
mixed combination, state;

int is_element (mixed arr, mixed el)
{
  int i, max;

  max = sizeof(arr);
  for (i = 0;i < max; i++)
  {
     if (arr[i][0] == el) return i;
  }
  return -1;
}

mixed get_thieves ()
{
  return thieves;
}

string add_thief ( object thief)
{
   if ( !pointerp (thieves) )
   {
      thieves = ({ ({ to_string(thief), 0 }) });
      return "Du konzentrierst Deine Lautwahrnehmung nun auf den Tresor.\n";
   }
   
   if ( is_element(thieves, to_string(thief)) == -1 )
   {
      thieves += ({ ({ to_string(thief), 0 }) });
      return "Du konzentrierst Deine Lautwahrnehmung nun auf den Tresor.\n";
   }
   else
      if ( TP->QueryProp(P_GENDER) == 2 )
         return "Das ist doch fuer Dich 'Panzerknackerin' selbstverstaendlich!\n";
      else
         return "Das ist doch fuer Dich 'Panzerknacker' selbstverstaendlich!\n";
}

string lausche_tresor()
{
   return add_thief( this_player() );
}

int do_open(string args)
{
  object key;
  string s1, s2;

  notify_fail("WAS moechtest Du oeffnen?\n");
  if (!args || !PL) return 0;
  notify_fail("Das kannst Du nicht oeffnen.\n");
  if (sscanf(args, "%s mit %s", s1, s2) < 2)
  { s1 = args; s2 = 0;}
  if (!id(s1)) return 0;

  if ( (state[0] != combination[0]) || (state[1] != combination[1]) || 
       (state[2] != combination[2]) )
  {
      write("Du musst die richtige Kombination einstellen, um "+name(WEN,1)+
            " zu oeffnen.\n");
      return -1;
  }
  if (_query_cnt_status() == CNT_STATUS_OPEN ) 
  {
    write(CAP(name(WER,1))+" ist doch schon geoeffnet!\n");
    return -1;
  }

  write("Du oeffnest "+name(WEN,1)+".\n");
  say(CAP(PL->name())+" oeffnet "+name(WEN,1)+".\n");
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);
  EPMASTER->GiveExplorationPoint("tresor", EP_MISC);
  return 1;
}

int do_close(string args)
{
  object key;
  string s1, s2;

  notify_fail("WAS moechtest Du schliessen?\n");
  if (!args || !PL) return 0;
  notify_fail("Das kannst Du nicht schliessen.\n");
  if (sscanf(args, "%s mit %s", s1, s2) < 2)
  { s1 = args; s2 = 0;}
  if (!id(s1)) return 0;

  if (!_query_cnt_status() == CNT_STATUS_OPEN )
  {
    write(CAP(name(WER,1))+" ist doch schon geschlossen!\n");
    return 1;
  }

  write("Du schliesst "+name(WEN,1)+".\n");
  say(CAP(PL->name())+" schliesst "+name(WEN,1)+".\n");

  SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
  return 1;
}


void set_combination ()
{
   combination = ({ random (10), random (10), random (10)});
   state = ({ 0, 0, 0 });
   tries = 0;
   SetProp(P_CNT_STATUS, CNT_STATUS_LOCKED);
   say( break_string("Der Tresor rasselt und die Raeder drehen sich. "+
           "Anscheinend hat er sich auf eine neue Kombination eingestellt.\n",
           78), ({}));
}

string show_frontside ()
{
   return("   __________________\n"+
     "  /                 /|\n"+
     " /________________ / |\n"+
     "|  /-\\ /-\\ /-\\    |  |\n"+
     "|  |"+to_string(state[0])+"| |"+to_string(state[1])+"| |"+
     to_string(state[2])+"|    |  |\n"+
     "|  \\-/ \\-/ \\-/    |  |\n"+
     "|   |   |   |   = |  |\n"+
     "|  -O- -O- -O-  | |  |\n"+
     "|   |   |   |   = |  |\n"+
     "|                 | /\n"+
     "|_________________|/\n");
}

void reset ()
{
   set_combination ();
   if ( !present("kristallherz", this_object()) )
      clone_object(HERZ)->move (this_object(), M_GET);
   ::reset();
}

void create()
{
	
  if (!is_clone(this_object()))
    return;
    
  container::create();
  ::create();

  SetProp(P_MAX_WEIGHT, 100000);
  AddId("tresor");
  SetProp(P_NAME,"Tresor");
  SetProp(P_GENDER,MALE);
  SetProp(P_SHORT,"Ein kleiner Tresor");
  SetProp(P_LONG,
      "Du siehst einen klein, aber sehr stabil wirkenden Tresor. "+
      "Auf seiner Vorderseite befinden sich drei drehbar gelagerte "
      "Raeder, sowie eine Nummer ueber jedem einzelnen Rad. "+
      "Weiters befindet sich dort auch noch ein Griff zum oeffnen. Auf "+
      "der Oberseite des Tresors befindet sich eine Plakette.\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, 1);  
  SetProp(P_WEIGHT,100000);
  SetProp(P_MATERIAL, MAT_TITANIUM );
  SetProp(P_CNT_KEY, "\nno_key\n");
  SetProp(P_NOGET, "Dieser Tresor ist viel zu schwer!");
  SetProp(P_SOUND, #'lausche_tresor );
  seteuid(getuid());  
  
  AddDetail ( ({"rad", "raeder", "vorderseite", "nummern", "nummer", "kombination" }), 
     #'show_frontside
  );
  
  AddDetail ( "oberseite",
     "Dort befindet sich eine Plakette.\n"
  );
  
  AddDetail ( "plakette",
     "Du koenntest versuchen sie zu lesen!\n" 
  );
  
  AddDetail ( "griff",
     "Dieser Griff ermoeglicht Dir den Tresor zu oeffnen, "+
     "sofern die Kombination richtig ist.\n" );
  
  AddReadDetail ( "plakette",
     "Benutzerhinweise:\n"+
     "=================\n"+
     "Dieser Tresor aendert seine Kombination in kurzen Intervallen, "+
     "sowie nach 30 Raddrehungen und ist deshalb nur von einem wahren "+
     "Meisterdieb zu oeffnen. Fuer alle anderen ist dieses Unterfangen "+
     "unmoeglich zu bewerkstelligen.\n"
  );
  
  restore_object ( "/d/"+REGION+"/"+MAGIERNAME+"/"+GEBIET+"/save/tresor" );
  
  AddCmd(({"drehe", "dreh"}), "turn_wheel");
  
  set_combination ();
  
  clone_object ("/d/dschungel/angel/liebe/obj/herz")->move (this_object(), M_GET);
}

void test_turn ( int nr )
{
   int chance, i;
   
   chance = random(100)+1;  // Chance dass ein Spieler das richtige hoert
   
   state[nr-1] ++;
   if ( state[nr-1] == 10 )
      state[nr-1] = 0;
   tries ++;
   if ( tries > 30 )
      set_combination();

   if ( ((i = is_element(thieves, to_string(this_player()))) != -1) && 
        ( environment(this_object()) == environment(this_player()) ) )
   {
      switch (thieves[i][1])
      {
      	case  20: {
      		     write ("Du lernst die Geraeusche des Tresors immer klarer wahrzunehmen.\n");  
      		     break;
      		  }
      		  
      	case  40: {
      		     write ("Du lernst immer besser die Geraeusche des Tresors zu unterscheiden.\n"); 
      		     break;
                  }
                        		     
      	case  60: {
      		     write ("Du bist Dir bei der Einordnung der Geraeusche schon ziemlich sicher.\n"); 
      		     break; 
                  }
                  
      	case  80: {
      		     write ("Deinem Ohr entgeht schon beinahe nichts mehr.\n"); 
      		     break;
      		  }
      		  
      	case 100: {
      		     write ("Du kannst Dich nun als wahren Meister des 'Tresorknackens' betrachten.\n"); 
      		     break;
      		  }
      }
      thieves[i][1] ++;
      save_object ( "/d/"+REGION+"/"+MAGIERNAME+"/"+GEBIET+"/save/tresor" );
      if ( thieves[i][1] >= chance ) // Sind wir gut genug das Klick vom Klack unterscheiden zu koennen?
      {
      	 if (state[nr-1] == combination[nr-1])
      	    write ("Du hoerst ein 'Klack!' im Tresor.\n");
      	 else
      	    write ("Du hoerst ein 'Klick!' im Tresor.\n");
      }
      else  // ... sind wir nicht wir wissen nicht was das war ...
      {
      	if ( (random(100)+1) < 50 )
           write ("Du hoerst ein 'Klick!' im Tresor.\n");
        else
           write ("Du hoerst ein 'Klack!' im Tresor.\n");
      }
   }
      
   if ( (state[0] == combination[0]) && (state[1] == combination[1]) &&
        (state[2] == combination[2]))
   {
      SetProp(P_CNT_STATUS, CNT_STATUS_CLOSED);
      say ("Der Tresor beginnt zu rasseln und verstummt wieder.\n", ({}));
   }
}

int turn_wheel ( string args )
{
   int wheel;
   
   notify_fail ("Welches Rad moechtest Du drehen?\n");
   if ( !stringp (args) )
      return 0;
   
   if ( sscanf (args, "rad %d", wheel) != 1 )
      return 0;
  
   notify_fail ("Das Rad laesst sich nicht drehen solange der Tresor offen steht.\n");
   if ( _query_cnt_status() == CNT_STATUS_OPEN )
      return 0;
   
   if (time() < elapsed_time)
   {
      write ("Die Mechanik im Tresor ist noch nicht ganz eingerastet!\n");   	
      return 1;
   }
   
   switch (wheel)
   {
     case 1: {
     	        write ("Du drehst am ersten Rad.\n");
     	        say (this_player()->name()+" dreht am ersten Rad.\n");
     	        call_out ("test_turn", 5, 1);
                elapsed_time = time()+5;
     	        return 1;
     	     }
     case 2: {
     	        write ("Du drehst am zweiten Rad.\n");
     	        say (this_player()->name()+" dreht am zweiten Rad.\n");
     	        call_out ("test_turn", 5, 2);
                elapsed_time = time()+5;     	        
     	        return 1;     	
     	     }
     case 3: {
     	        write ("Du drehst am dritten Rad.\n");
     	        say (this_player()->name()+" dreht am dritten Rad.\n");
     	        call_out ("test_turn", 5, 3);
                elapsed_time = time()+5;     	        
     	        return 1;     	
     	     }
     default: {
     	        write ("Dieser Tresor hat nur drei Raeder!\n");
     	        return 1;
     	      }
    }
}
