inherit "/d/dschungel/angel/versteck/obj/brombeeren.lpc";

#include "/d/wasser/atoll/sys/std_plant.h"

void create ()
{
  ::create();
  SetProp (P_SHORT, "Ein welkender Brombeerstrauch");
  SetProp (P_UNIDENTIFIED_SHORT, "Ein welkender Strauch");
  SetProp (P_LONG, "Du siehst einen welkenden Brombeer. Er wird sicher bald absterben");
  SetProp (P_UNIDENTIFIED_LONG, "Du siehst einen welkenden Strauch");
  SetProp (P_NAME, "Brombeerstrauch");
  SetProp (P_UNIDENTIFIED_NAME, "Strauch");
  SetProp (P_PLURAL, "Brombeerstraeucher");
  SetProp (P_UNIDENTIFIED_PLURAL, "Straeucher");
  SetProp (P_NAME_ADJ, ({ "welkend" }) );
  SetProp (P_UNIDENTIFIED_NAME_ADJ, ({ "welkend" }) );
  SetProp (P_GENDER, MALE);
  SetProp (P_PLANT_SEASON_COUNT, 1);
  SetProp (P_PLANT_LIFE_PERIODE, 5);
  SetProp (P_HIDDEN, 0);
  SetProp (P_LORE_DIFFICULTY, 2500);
  SetProp (P_PLANT_WITHERS, 0);
  SetProp (P_PLANT_CHANGE_MSG, "Der Strauch verwelkt");
  SetProp (P_WEIGHT, 60);
  SetProp (P_NOGET, 0);
  SetProp (P_INFO, "Dieser Strauch wird sicher bald vertrocknen.\n");

  AddId ( ({"strauch", "staude"}) );
}