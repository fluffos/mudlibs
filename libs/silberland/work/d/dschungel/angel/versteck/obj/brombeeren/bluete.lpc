inherit "/d/wasser/atoll/std/std_bloom.lpc";

#include "/d/wasser/atoll/sys/oekosystem.h"


void create() {
    ::create();

  SetProp( P_NAME, "Brombeerbluete" );
  SetProp( P_NAME_ADJ, "weiss" );
  SetProp (P_UNIDENTIFIED_NAME_ADJ, ({"unbekannt", "weiss"}) );
  SetProp( P_SHORT, "Eine weisse Brombeerbluete" );
  SetProp( P_UNIDENTIFIED_SHORT, "Eine unbekannte weisse Bluete" );
  SetProp( P_VALUE, 1 );
  SetProp( P_WEIGHT, 3 );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_PLURAL, "Brombeerblueten" );
  SetProp( P_LONG,
	    "Dies ist die bluetenweisse Bluete eines Brombeerstrauchs" );
  SetProp (P_LORE_DIFFICULTY, 1500);
  SetProp (P_INFO, "Dies ist zweifelsohne eine Bluete.\n");
  
  AddId( ({ "brombeerbluete", "brombeerbluete", "bluete" }) );
}
