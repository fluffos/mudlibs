inherit "/d/dschungel/angel/versteck/obj/brombeeren.lpc";

#include "/d/wasser/atoll/sys/std_plant.h"

void create ()
{
  ::create();
  SetProp (P_SHORT, "Ein ausgewachsener Brombeerstrauch");
  SetProp (P_UNIDENTIFIED_SHORT, "Ein unbekannter Strauch");
  SetProp (P_LONG, "Du siehst einen ausgewachsenen Brombeerstrauch");
  SetProp (P_UNIDENTIFIED_LONG, "Du siehst einen Dir unbekannten Strauch");
  SetProp (P_NAME, "Brombeerstrauch");
  SetProp (P_UNIDENTIFIED_NAME, "Strauch");
  SetProp (P_NAME_ADJ, ({ "ausgewachsen"}) );
  SetProp (P_UNIDENTIFIED_NAME_ADJ, ({ "unbekannt"}) );
  SetProp (P_PLURAL, "Brombeerstraeucher");
  SetProp (P_UNIDENTIFIED_PLURAL, "Straeucher");
  SetProp (P_GENDER, MALE);
  SetProp (P_PLANT_SEASON_COUNT, 1);
  SetProp (P_PLANT_LIFE_PERIODE, 4);
  SetProp (P_HIDDEN, -500);
  SetProp (P_LORE_DIFFICULTY, -2500);
  SetProp (P_PLANT_CHANGE_MSG, "Die Fruechte am Strauch reifen");
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOGET, 0);
  SetProp (P_INFO, "Ein Strauch wie dieser kann sich auf dem richtigen Boden praechtig entwickeln.\n");

  AddId ( ({"strauch", "staude"}) );
}