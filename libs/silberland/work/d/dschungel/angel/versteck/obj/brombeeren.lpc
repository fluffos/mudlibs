inherit "/d/wasser/atoll/std/std_plant.lpc";

#include "/d/wasser/atoll/sys/std_plant.h"

#define path "/d/dschungel/angel/versteck/obj/"

void create ()
{
  ::create();

  SetProp (P_SHORT, 0);
  SetProp (P_LONG, "");
  SetProp (P_ADJECTIVES, 0);
  SetProp (P_GENDER, MALE);
  SetProp (P_UNIDENTIFIED_GENDER, MALE);

  // Initialisierung der Pflanzenspezifischen Werte:
  SetProp (P_PLANT_SPAWNS_FRUIT, ([ 4: path+"brombeeren/frucht"; 5 ]) );
  SetProp (P_PLANT_SPAWNS_BLOSSOM, ([ 3: path+"brombeeren/bluete"; 7 ]));
  SetProp (P_PLANT_WITHERS, ({ 5, 5 }) );
  SetProp (P_PLANT_IS_PERENNIAL, 3);
  SetProp (P_PLANT_POLLINATION, BY_INSECTS);
  SetProp (P_PLANT_REPRODUCTION, BY_SPAWN + BY_SEED);
  SetProp (P_PLANT_TYPE, BUSH);
  SetProp (P_LORE_DIFFICULTY, 0);
  SetProp (P_PLANT_FULLY_GROWN, 2);
  SetProp (P_PLANT_NEEDS_CLIMATE, ([ FERTILITY: 40, HUMIDITY: 30, TEMPERATURE: 25, TERRAIN_TYPE: ({ TT_OTHER }) ]) );
  SetProp (P_PLANT_CLIMATIC_TOLERANCE, ([ FERTILITY: 30, HUMIDITY: 10, TEMPERATURE: 10 ]) );
  SetProp (P_PLANT_PERSISTENCE, 60);
  SetProp (P_PLANT_HARVESTABLE, ([ "frucht": HARVEST_FRUIT, "beere": HARVEST_FRUIT, "bluete": HARVEST_BLOOM, "pflanze": HARVEST_PLANT, "strauch": HARVEST_PLANT, "staude": HARVEST_PLANT, "keimling":HARVEST_PLANT ]) );

  // Aufbau des Lebenszyklus:
  // ([ ID: filename; duration ])
  SetProp (P_PLANT_LIFECYCLE, ([ 1: path+"brombeeren/keimling"; 2,
                                 2: path+"brombeeren/pflanze_gruen"; 1,
                                 3: path+"brombeeren/pflanze_blueht"; 2,
                                 4: path+"brombeeren/pflanze_traegt"; 2,
                                 5: path+"brombeeren/pflanze_welk"; 1]) );
}