inherit "/d/wasser/atoll/std/std_fruit.lpc";

#include "/d/wasser/atoll/sys/oekosystem.h"
#include <food.h>


void create() {
    ::create();

    SetProp( P_NAME, "Brombeere" );
    SetProp( P_UNIDENTIFIED_NAME, "Beere" );
    SetProp( P_NAME_ADJ, "lecker" );
    SetProp (P_UNIDENTIFIED_NAME_ADJ, ({ "unbekannt", "schwarz" }) );
    SetProp( P_VALUE, 1 );
    SetProp( P_WEIGHT, 5 );
    SetProp( P_GENDER, FEMALE );
    SetProp( P_SHORT, "Eine leckere Brombeere" );
    SetProp (P_UNIDENTIFIED_SHORT, "Eine unbekannte schwarze Beere" );
    SetProp( P_PLURAL, "Walderdbeeren" );
    SetProp( P_UNIDENTIFIED_PLURAL, "Beeren" );
    SetProp( P_LONG, "Dies ist eine leckere schwarze Brombeere" );
    SetProp (P_LORE_DIFFICULTY, -2500);
    SetProp (P_FOOD_INFO, ([
      F_HEAL     : ({5,5}),                 // 10 LP, 5 MP
      F_SOAK: 2,
      F_DRINK: 0, 
      F_ALCOHOL: 0, 
      F_POISON:0,
      F_MSG      : "Du isst die leckere Beere.\n",
      F_MSG_ROOM : "isst eine lecker aussehende, schwarze Beere.",
      F_VERB     : "essen" ]) );

   SetProp (P_INFO, "Diese Frucht kannst Du sicher essen, nur ob sie gesund ist ist eine andere Frage.\n");

    AddId( ({ "brombeere", "beere", "obst", "frucht" }) );
}
