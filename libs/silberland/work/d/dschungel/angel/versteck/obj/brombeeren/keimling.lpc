inherit "/d/dschungel/angel/versteck/obj/brombeeren.lpc";

#include "/d/wasser/atoll/sys/std_plant.h"

void create ()
{
  ::create();
  SetProp (P_SHORT, "Ein Keimling eines Brombeerstrauches");
  SetProp (P_UNIDENTIFIED_SHORT, "Der Keimling einer unbekannten Pflanze");
  SetProp (P_LONG, "Du siehst den Keimling eines Brombeerstrauches");
  SetProp (P_UNIDENTIFIED_LONG, "Du siehst den Keimling einer unbekannten Pflanze");
  SetProp (P_NAME, "Keimling");
  SetProp (P_UNIDENTIFIED_NAME, "Keimling");
  SetProp (P_UNIDENTIFIED_NAME_ADJ, "unbekannt");
  SetProp (P_PLURAL, "Keimlinge");
  SetProp (P_UNIDENTIFIED_PLURAL, "Keimlinge");
  SetProp (P_ADJECTIVES, 0);
  SetProp (P_GENDER, MALE);
  SetProp (P_PLANT_SEASON_COUNT, 1);
  SetProp (P_PLANT_LIFE_PERIODE, 1);
  SetProp (P_HIDDEN, 2500);
  SetProp (P_LORE_DIFFICULTY, 2500);
  SetProp (P_WEIGHT, 10);
  SetProp (P_NOGET, 0);
  SetProp (P_INFO, "Dieser Keimling wird einmal ein Strauch wenn Du ihn wachsen laesst.\n");

  AddId ( "keimling" );
}