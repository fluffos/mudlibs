inherit "/d/dschungel/angel/versteck/obj/brombeeren.lpc";

#include "/d/wasser/atoll/sys/std_plant.h"

void create ()
{
  ::create();
  SetProp (P_SHORT, "Ein ausgewachsener gruener Brombeerstrauch");
  SetProp (P_UNIDENTIFIED_SHORT, "Ein unbekannter gruener Strauch");
  SetProp (P_LONG, "Du siehst einen ausgewachsenen gruenen Brombeerstrauch, "
                   "der wohl bald bluehen wird");
  SetProp (P_UNIDENTIFIED_LONG, "Du siehst einen unbekannten, gruenen Strauch");
  SetProp (P_NAME, "Brombeerstrauch");
  SetProp (P_UNIDENTIFIED_NAME, "Strauch");
  SetProp (P_PLURAL, "Brombeerstraeucher");
  SetProp (P_UNIDENTIFIED_PLURAL, "Straeucher");
  SetProp (P_NAME_ADJ, ({ "gruen" }) );
  SetProp (P_UNIDENTIFIED_NAME_ADJ, ({"gruen"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_PLANT_SEASON_COUNT, 1);
  SetProp (P_PLANT_LIFE_PERIODE, 2);
  SetProp (P_HIDDEN, 0);
  SetProp (P_LORE_DIFFICULTY, 2000);
  SetProp (P_PLANT_CHANGE_MSG, "Der Strauch waechst heran");
  SetProp (P_WEIGHT, 60);
  SetProp (P_NOGET, 0);
  SetProp (P_INFO, "Ein Strauch wie dieser kann sich auf dem richtigen Boden praechtig entwickeln.\n");

  AddId ( ({"strauch", "staude"}) );
}