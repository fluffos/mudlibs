#include <language.h>
#include <ansi.h>
#include "./def.h"
#include "../../lib/unique_npc/headers/unique_npc.h"

inherit "std/npc/sequencer";
inherit NPC "thief_race_specs";
inherit LIB_UNIQUE "classes/unique_npc";

create()
{
  if (!is_clone(this_object()))
    return;
    
  thief_race_specs::create();
  unique_npc::create();
  ::create();
  SetProp(P_UNIQUE_RACE_PROBABILITY, ({ ({"Mensch", 100}), ({"Elf", 30}), 
                          ({"Zwerg", 60}), ({"Hobbit", 100}), ({"Dunkelelf", 100}) }) );

  create_default_unique_npc( 30, 50, -1 );
  SetProp(P_ARTICLE, 1);
  AddId(distinguish_gender("meisterdieb", "meisterdiebin"));
  AddId(distinguish_gender("dieb", "diebin"));
  AddId("Schwertexperte");
  AddId("Meisterdieb");
  SetProp(P_NAME,
    distinguish_gender("Meisterdieb", "Meisterdiebin"));
  
  SetProp(P_SHORT, 
    capitalize(QueryArticle())+QueryProp(P_NAME) );
    
  SetProp(P_LONG,  get_long("Vor Dir steht ein Meisterdieb. ",
                       "Vor Dir steht eine Meisterdiebin. ") );

  SetProp( P_ALIGN, -200 );
  SetProp(P_MAX_HANDS, 2);
  seteuid(getuid(this_object()));
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_DIE_MSG, " stirbt Deinen Namen verfluchend.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Fordere niemals einen Meisterdieb!");
  SetProp(P_MURDER_MSG, "Pah! Aber Du bestiehlst mich trotzdem nicht, %s!");
  SetProp(P_DEFAULT_INFO, "sagt: Verschwinde sofort aus meiner Huette!\n");
  SetProp(P_AGGRESSIVE, 1);
    
  SetAttackChats(5, ({
    name()+" sagt: Verschwinde Du Landplage!\n",
    name()+" sagt: Renn weg solange Du noch kannst!\n",
    name()+" sagt: Es war ein Fehler Dich mit mir anzulegen!\n" }) );

  // Unser Dieb ist sauer und alles andere als Gespraechig!

  SetProp (P_SPELLRATE, 30);
  
  // Tritt:
  AddSpell(5, 1000,
           Name(WER,1)+" tritt Dir mit voller Wucht in die Magengrube.\n",
           Name(WER,1)+" tritt @WEM mit voller Wucht in die Magengrube.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
  
  // Ausfall:
  AddSpell(3, 1200,
           Name(WER,1)+" macht einen Ausfall und sticht mehrere Male auf Dich ein.\n",
           Name(WER,1)+" macht einen Ausfall und sticht mehrere Male auf @WEN ein.\n ",
          ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
          
  // "backstab":
  AddSpell(2, 1500,
           Name(WER,1)+" verschwindet ploetzlich und stoesst Dir den Degen in den Ruecken.\n",
           Name(WER,1)+" verschwindet ploetzlich und stoesst @WEM den Degen in den Ruecken.\n",
          ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );

  clone_object ("/p/armour/helm/hut")->move (this_object(), M_GET);
  clone_object ("/p/armour/armour/lederruestung")->move (this_object(), M_GET);
  clone_object ("/p/armour/gloves/lederhandschuhe")->move (this_object(), M_GET);  
  clone_object ("/p/armour/boots/lederstiefel")->move (this_object(), M_GET);
  clone_object ("/p/armour/belt/guertel")->move (this_object(), M_GET);
  command_me("trage alles");

  clone_object ("/p/weapon/sword/stossdegen")->move (this_object(), M_GET);
  command_me("zuecke degen");
}

// Begruesungsroutine
void greet_player(mixed people)
{
   int i;
   string msg;
   
   // Niemand zum gruessen? Dann raus!
   if (!sizeof(people))
      return;
      
   msg = "Verschwindet sofort aus meiner Huette "; 
   
   if (pointerp(people))
   for (i = 0; i < sizeof(people); i++)
   {
      if ( i == (sizeof(people) - 2) )
      {
         msg += people[i]->name()+" und ";
      }
      else 
      {
      	if ( i == (sizeof(people) - 1) )
            msg += people[i]->name()+"!\n";
        else
            msg += people[i]->name()+", ";
      }
   }
   say  ( TO->name()+" donnert: "+msg );
}
