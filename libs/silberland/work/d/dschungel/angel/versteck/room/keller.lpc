#pragma strong_types

inherit "std/room";

#include "./def.h"


void create()
{
  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "Ein karger, kuehler Keller" );
  SetProp( P_INT_LONG, break_string("Du befindest Dich in einem kargen, "+
           "gemauerten und unbeleuchteten Keller. Die Temperatur hier unten "+
           "ist angenehm kuehl. Beim ersten Umsehen faellt Dir nur ein Tresor "+
           "auf der in einer Ecke steht.",78)); 

  SetProp(P_INDOORS, 1);

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( "temperatur",
             "Hier ist es angenehm kuehl.\n" );
             
  AddDetail( ({ "keller", "raum" }),  
             QueryProp(P_INT_LONG) );
             
  AddDetail( "umsehen",
             "Das tust Du im Augenblick ziemlich genau.\n" );
             
  AddDetail( "augenblick",
             "Der ist zu kurz um genauer untersucht zu werden.\n" );

  AddDetail( "boden",
             "Der Boden hier ist wie auch die Waende und Decke gemauert. Mit "+
             "der Zeit hat sich hier ettliches an Staub angesammelt.\n" );

  AddDetail( "zeit",
             "Dazu faellt dir nur 'relativ' ein, warum weisst Du aber nicht.\n" );

  AddDetail( ({ "wand", "waende" }),
             "Wie der Boden und die Decke sind auch die Waende gemauert.\n" );

  AddDetail( "decke",
             "Wie der Boden und die Waende ist auch die Decke gemauert.\n" );

  AddDetail( "staub",
             "Auf dem Boden hat sich schon einiges an Staub angesammelt.\n" );

  AddDetail( "treppe", 
             "Ueber diese Treppe kommst Du wieder nach oben ins Haus.\n" );
             
  AddDetail( "ecke",
             "Dieser Raum hat vier Ecken. In einer steht ein kleiner, jedoch "+
             "massiv wirkender Tresor.\n" );
          
  AddDetail( "ecken",
             "Auf Reinlichkeit wird hier scheinbar wenig Wert gelegt. Die "+
             "Ecken sind mit Spinnweben ueberzogen.\n" );
 
  AddDetail( ({ "spinnweben", "weben", "spinnwebe" }),
             "In einer Spinnwebe kannst Du eine eine kleine Spinne erkennen.\n" );
             
  AddDetail( "spinne",
             "Sie sitzt in der Mitte ihres Netzes und wartet auf Beute.\n" );
            
  AddDetail( ({ "mitte", "netz" }),
             "Dort wartet eine geduldige Spinne auf Beute.\n" );
         
  AddDetail( "beute",
             "Fliegen und andere kleine Insekten sieht die Spinne als ihre Beute an.\n" );
             
  AddDetail( ({ "fliege", "fliegen", "insekten", "insekt" }),
             "Du kannst hier keine erspaehen, die Spinne wird sich wohl noch "+
             "gedulden muessen.\n" );
 
  AddDetail( ({ "reinlichkeit", "wert" }),
             "Du denkst nicht dass hier jemand aufraeumt oder putzt.\n" );
             
  AddDetail( ({ "ohren", "ohr" }),
             "Ohren hast Du und das ist auch gut so!\n" );
             
  AddDetail( "wort",
             "Nun mach Dich aber nicht laecherlich ... 'wort' zu untersuchen zzzzt!\n" );             
             
  // Tresor ist ein Item -> selbstbeschreibend
  
  AddSmell( DEFAULT_SMELL,
            "Die Luft hier riecht muffig und abgestanden.\n" );
            
  AddSmell( "luft",
            "Du hast Dich nicht geirrt, sie ist definitiv abgestanden.\n" );
     
  AddSound( DEFAULT_SOUND,
            "Hier unten ist es totenstill. Irgendwie ueberkommt Dich eine "+
            "Ahnung, dass Dein Gehoer hier nuetzlich sein koennte.\n" );
  
  AddSound( "gehoer",
            "Nun damit kannst Du horchen, aber Geraeusche macht es keine.\n" );
            
  AddSound( "ahnung",
            "Benutze deine Ohren ...\n" );          
            
  AddSound( ({ "geraeusch", "geraeusche" }), 
            "Was verstehst Du an dem Wort 'keine' nicht?\n" );
                          

  AddExit("oben", ([ EX_DEST : ROOM "huette",
                     EX_MSG  : "die Treppe hinauf"]) );
                     
  AddItem (OBJ "tresor", REFRESH_DESTRUCT);
}
