#pragma strong_types

inherit "std/room";

#include "./def.h"

void create()
{

  room::create();
   
  SetProp (P_LIGHT, 1);
  SetProp (P_NO_MNPC, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
    "Du stehst auf einer kleinen Lichtung oestlich der Obstplantagen. Rund um Dich ist alles "+
    "verwachsen, ein wahres Meer aus Pflanzen, welche diesen Platz saeumen. Dieser Ort "+
    "waere wie geschaffen fuer ein Versteck.\n")
  );
    
  SetProp (P_INT_SHORT, "Auf einer kleinen Lichtung nahe der Obstplantage");
   
  AddDetail( ({ "platz", "lichtung", "ort" }),
    QueryProp(P_INT_LONG)
  ); 
   
  AddDetail ( "dschungel",
    "Du befindest Dich mitten im tiefsten Dschungel.\n"
  );
  
  AddDetail(({"plantage","plantagen","obstplantagen","obstplantage"}),
    "Die Obstplantagen befinden sich im Westen, hinter dem Dickicht.\n"
  );

  AddDetail(( "boden"),
    "Der Boden ist hier mit Farnen und Graesern bewachsen."
  );
  
  AddDetail ( "meer",
    "Wie ein Meer aus Pflanzen in den verschiedensten Farben wirkt dieser Ort auf Dich.\n"
  );
  
  AddDetail(({"farn","farne", "graeser"}),
    "Graeser und Farne sind typische Gewaechse fuer den Dschungel."
  );
  
  AddDetail( ({ "gewaechse", "pflanzen" }),
    "Die meisten Pflanzen hier sind Dir fremd.\n" 
  );
  
  AddDetail("westen",
    "Rings um die Lichtung siehst Du nur undurchdringbares Dickicht, welches Du im "+
    "Westen irgendwie durchdrungen hast.\n"
  );
  
  AddDetail("dickicht",
    "Ja durch dieses Dickicht hast Du dich durchgezwaengt."
  );
  
  AddDetail ( ({ "versteck", "osten" }),
    "Du blickst Dich um und glaubst im Osten die Umrisse eines Gebaeudes zu sehen.\n"
  );
    
  AddDetail ( ({ "gebaeude", "umriss", "umrisse" }),
    "Sieht nach einer Huette aus, der Groesse nach zu urteilen.\n"
  );
    
  AddDetail ( "groesse",
    "Was immer es auch ist, gross ist es nicht.\n"
  );
  
  AddDetail( "huette",
    "Ja da scheint wirklich eine Huette am Rande der Lichtung zu stehen, ist Dir auf den ersten Blick "+
    "gar nicht aufgefallen vor lauter Pflanzen."
  );
  
  AddDetail( "blick",
    "Auffaellig ist die Huette jedenfalls nicht, trotzdem koenntest Du sie mit 'huette' betreten.\n"
  );
  
  AddDetail( "rand",
    "Nicht weit, geh einfach mal naeher ran!\n"
  );
  
  AddDetail ( "himmel", 
    "Der Himmel ist wolkenlos.\n"
  );

  AddDetail ( "vogel", 
    "Du versuchst den Vogel auszumachen, kannst ihn aber in der bunten Farbenvielfalt nicht erkennen.\n"
  );
    
  AddDetail ( ({ "farbe", "farben", "farbenvielfalt" }),
    "Die Pflanzen des Dschungels in ihren grellen, exotischen Farben sind eine wahre Augenweide.\n" 
  );
  
  AddDetail ( ({ "augenweide", "anblick" }), 
    "Geniesse den Anblick solange Du moechtest.\n" 
  );
  
  AddDetail ( "ohr",
    "Du fasst an Dein Ohr und es ist da wo es hin gehoert.\n" 
  );
  
  AddSmell( ({DEFAULT_SMELL,"luft"}),
    "Die Luft riecht frisch und klar.\n"
  );

  AddSound( ({DEFAULT_SOUND, "vogel"}),
    "Liebliches Vogelzwitschern dringt an Dein Ohr.\n"
  );

  AddSound( ({ "vogel", "vogelzwitschern", "zwitschern", "gesang", "voegel" }),
    "Du erfreust Dich am Gesang der Voegel."
  );
  
  AddExit( "huette", ([ EX_DEST : "./huette",
                     EX_MSG  : "in die Huette"]) );
                     
  SetProp(P_HIDE_EXITS, ({"huette"}));                   
                     
  AddExit( "westen", ([ EX_DEST : VERSTECK_ANSCHLUSS,
                     EX_MSG  : "durch das Dickicht, zurueck auf die Plantage"]) );

  AddItem ( OBJ+"brombeeren", REFRESH_DESTRUCT);
}

