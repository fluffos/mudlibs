create()
{
  if(!is_clone(TO))
    return;

  ::create();
  AddId(({"kristallherz", "herz"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME,"Ein Kristallherz der Liebe");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_SHORT, "Ein Kristallherz der Liebe");
  SetProp(P_LONG,
      "Du siehst ein gruenlich schimmerndes Herz aus Kristall. Es ist zur Zeit fuer eine neue Verbindung offen.\n");
  SetProp(P_INFO, "Mit <hhilfe> bekommst Du weitere Hinweise!\n");
  SetProp( P_MATERIAL, ([ MAT_CRYSTAL : 60, MAT_MISC_MAGIC : 40 ]) );
  SetProp(P_VALUE,5);
  SetProp(P_WEIGHT,10);
  SetProp(P_NODROP, "Dieses Herz moechtest Du auf keinen Fall verlieren!\n");
  SetProp(P_NEVERDROP, 1);
  seteuid(getuid());

  // Allgemeine Commands:
  AddCmd("hhilfe", "help_function");
  AddCmd("herz", "heart_switch");

  // Custom-Commands:
  AddCmd("dc", "define_command");
  AddCmd("rc", "restore_command");
  AddCmd("lc", "list_commands");
  AddCmd("cc", "custom_command");

  // activation commands:
  AddCmd(({"schenke", "schenk", "verschenk", "verschenke"}), "activate");
  AddCmd("loese", "deactivate");
  AddCmd("verfuehre", "initiate");                  // Nr. 16
  AddCmd("verfalle", "start_sex");                  // Nr. 17
  AddCmd(({"halt", "aus"}), "stop_act");
  AddCmd("privatsphaere", "player_privacy");

  // sequencer commands: (for state > 1)
  AddCmd("edit", "sequencer_commands");
  AddCmd("weiter", "resume_scene");
  AddCmd("pause", "pause_scene");


  // direct, active commands: (for state > 1)
  // These comamnds only work for the chosen partner.

  AddCmd(({"kuesse","kuess"}), "kiss");             // Nr.  1
  AddCmd(({"knutsche","knutsch"}), "long_kiss");    // Nr.  2
  AddCmd("schmuse", "smooch_kiss");                 // Nr.  3
  AddCmd(({"zkuss", "zungenkuss"}), "french_kiss"); // Nr.  4


  AddCmd(({"zieh", "ziehe"}), "undress_partner");   // Nr.  5
  AddCmd(({"reisse","reiss"}), "ripp_off_clothes"); // Nr.  6
  AddCmd("nimm", "disarm_partner");                 // Nr.  7

  AddCmd(({"knabber", "knabbere"}), "nibble");      // Nr.  8
  AddCmd(({"schlecke", "schleck"}), "lick");        // Nr.  9
  AddCmd(({"nasche", "nasch"}),"graze");                        // Nr. 10
  AddCmd("liebkose", "snuggle");                    // Nr. 11
  AddCmd(({"streichle", "streichel"}), "petting");  // Nr. 12
  AddCmd(({"streiche", "streich"}), "stroke");      // Nr. 13
  AddCmd(({"massiere", "massier"}), "massage");     // Nr. 14
  AddCmd(({"beruehre","beruehr"}), "touch");        // Nr. 15


  command_list = std_commands1;
  command_list += std_commands2 + std_commands3;
  is_active = 1;
}

// Help-functions:
int query_zahnschutz( object ob )
{
   object schutz;

   schutz = present("zahnschutz", ob);
   if (objectp(schutz))
      if ( ob == schutz->QueryWorn() )
         return 1;
      else
         return 0;
   else
      return 0;
}

object worn_item ( string msg, object ob )
{
   int i, size;
   size = sizeof ( ob->QueryProp(P_ARMOURS) );
   for (i = 0; i < size; i++ )
   {
      if ( objectp(ob->QueryProp(P_ARMOURS)[i]) )
          if ( ob->QueryProp(P_ARMOURS)[i]->id (msg) )
             return ob->QueryProp(P_ARMOURS)[i];
   }
   return 0;
}

string _in(string a, mapping m)
{
  if (member(m,lower_case(a)))
    return m[a];
  else
    return "";
}

string ParseAdverben(string str, object ob)
{
  string *advpart;
  mixed quotedpart;
  mapping adverben;

  if (!str) return 0;
  str=" "+str;
  adverben=ob->QueryStdAdverbs()+ob->QueryAdverbs();
  advpart=explode(str,"/");
  if (sizeof(advpart)>1)
      quotedpart=" "+implode(advpart[1..],"/");
  else
    quotedpart="";
  advpart=regexplode(advpart[0],"\\<[^, ]*\\>");
  advpart=map_array(advpart,#'_in,adverben) - ({""});
  return sizeof(advpart) ? ob->CountUp(advpart)+quotedpart : quotedpart[1..];
}

string CheckAlternative ( string args, object ob )
{
  int i;
  string result;

  // Keine Aenderung noetig
  if ( !stringp (args) || (args == "") || (args == lower_case(partner->name())) )
     return 0;

  i = strlen(partner->name());

  // Partner name wegschneiden:
  if ( args[0 .. i-1] == lower_case(partner->name()) )
     args = args[i ..];

  result = ParseAdverben ( args, ob );

  if ( result == "" )
     return 0;
  else
     return result;
}

