// Simple parser to handle partnername and own name.
string parse_text ( string str )
{
   int pos, casus;
   string name_string;

   do
   {
      if ( (pos = member (str, '$')) != -1 )
      {
      	 if ( strlen(str) < pos+7 ) // in dem Fall liegt ein Fehler in der Syntax vor.
      	 {
      	    write ("Fehler: Inkorrekte Anzahl von Parametern fuer '$'!\n");
      	    return str;
      	 }

         name_string = "";

         casus = to_int(str[pos+6 .. pos+6])-1; // Wenn nicht angegeben ist es 0

         if ( str[pos+1] == 'p' )
         {
            if ( str[pos+2 .. pos+5] == "name" )
               name_string = partner->name(casus);
            if ( str[pos+2 .. pos+5] == "pron" )
               name_string = partner->QueryPronoun(casus);
            if ( str[pos+2 .. pos+3] == "bf" )
               name_string = partner->QueryPossPronoun( to_int(str[pos+4 .. pos+4]), casus, to_int(str[pos+5 .. pos+5])  );
         }

         if ( str[pos+1] == 's' )
         {
            if ( str[pos+2 .. pos+5] == "name" )
               name_string = TP->name(casus);
            if ( str[pos+2 .. pos+5] == "pron" )
               name_string = TP->QueryPronoun(casus);
            if ( str[pos+2 .. pos+3] == "bf" )
               name_string = TP->QueryPossPronoun( to_int(str[pos+4 .. pos+4]), casus, to_int(str[pos+5 .. pos+5])  );
         }

         if ( str[pos+1] == 'i' )
         {
            if ( objectp (partner_item) )
               name_string = partner_item->name(casus);
            else
               name_string = "nichts besonderes";
         }


         if ((pos-1 >= 0) && (pos+7 < strlen(str)))
            str = str[0 .. pos-1] + name_string + str[pos+7 .. strlen(str)-1];
         else
         {
            if ( (pos-1 < 0) && (pos+7 >= strlen(str)) )
               return name_string;

            if ( (pos-1 < 0) )
               str = capitalize(name_string) + str[pos+7 .. strlen(str)-1];

            if ( (pos+7 >= strlen(str)) )
               str = str[0 .. pos-1] + name_string;
         }
      }
   } while (pos != -1);
   return str;
}

varargs int move(mixed dest, int method, string dir, string textout, string textin)
{
  object destination;

  if (!objectp(dest))
  {
     destination = find_living(dest);
     if (objectp(destination))
     {
     	if ( present ("kristallherz", destination) )
     	{
           tell_object( destination, "Zwei Herzen waeren zu viel fuer Dich!\n" );
           return 0;
     	}
     	SetProp(P_NAME, destination->name(WESSEN)+" Kristallherz der Liebe");
        SetProp(P_SHORT, destination->name(WESSEN)+" Kristallherz der Liebe");
        SetProp(P_LONG,
           "Dies ist "+destination->name(WESSEN)+
           " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren."+
           "Es ist zur Zeit fuer eine neue Verbindung offen.\n");
        restore_object ( SAVEDIR "herz_"+getuid(TP));
     }
  }
  else
  {
     destination = dest;
     if ( objectp(destination) && interactive(destination) )
     {
     	if ( present ("kristallherz", destination) )
     	{
           tell_object( destination, "Zwei Herzen waeren zu viel fuer Dich!\n" );
           return 0;
     	}
     	SetProp(P_NAME, destination->name(WESSEN)+" Kristallherz der Liebe");
        SetProp(P_SHORT, destination->name(WESSEN)+" Kristallherz der Liebe");
        SetProp(P_LONG,
           "Dies ist "+destination->name(WESSEN)+
           " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren."+
           " Es ist zur Zeit fuer eine neue Verbindung offen.\n");
        restore_object ( SAVEDIR "herz_"+getuid(TP));
     }
  }

  return(::move(dest, method, dir, textout, textin));

}

int reset_values()
{
   partner = 0;
   partner_heart = 0;
   state = 0;
   privacy = 0;
   stream_pointer = 0;
   paused = 0;
   editing = 0;
}

// Wir fuegen uns auf die Verehrerliste des Wunschpartners
int add_votary(object ob)
{
   if (!pointerp(votaries))
   {
      votaries = ({ob});
      write ("Dein Herz hat sich "+environment(TO)->name()+" offenbart.\n");
      tell_object(environment(TO), ob->name()+" moechte Dein Herz gewinnen!\n");
      return 1;
   }
   else
   {
      if ( is_element(votaries, ob) )
      {
      	 write ("Du bist bereits auf der Liste der Verehrer von "+environment(TO)->name()+"!\n");
      	 return 0;
      }
      else
      {
         votaries += ({ob});
         write ("Dein Herz hat sich "+environment(TO)->name()+" offenbart.\n");
         tell_object(environment(TO), ob->name()+" moechte Dein Herz gewinnen!\n");
         return 1;
      }
   }

}

object verify_partner (string name)
{
  object ob;

  ob = find_living(name); // Grundsaetzlich mal den Partner finden.

  if (!objectp(ob)) return 0;  // War nix: Kein Lebewesen mit diesem Namen!

  // Wenn sich der Partner im gleichen Raum befindet ...
  if (present(lower_case(name), environment(TP)))
  {
      return ob;
  }
  return 0;
}

int verify_partner_interaction ()
{
  if (present(lower_case(partner->name()), environment(TP)))
  {
      return 1;
  }
}

// Es wird geprueft, ob der Spieler ein Kristallherz besitzt
object check_heart(object peer)
{
  object heart;

  if (heart = present(("kristallherz"), peer))
  {
    return heart;
  }
  else
  {
    return 0;
  }
}

void output_text ( int msg )
{
   write ( BS(parse_text(command_list[msg][0]+"\n")) );
   tell_object( partner, BS(parse_text(command_list[msg][1]+"\n")) );
   if ( !privacy )
      say ( BS( parse_text(command_list[msg][2]+"\n") ), ({TP, partner}) );
}

void output_scene ( mixed data )
{
   tell_object( environment(TO), BS(parse_text(data[0]+"\n")) );
   tell_object( partner, BS(parse_text(data[1]+"\n")) );
   if ( !privacy )
      say ( BS( parse_text(data[2]+"\n") ), ({ environment(TO), partner }) );
}

int heart_switch ( string args )
{
   notify_fail ("Moechtst Du Dein Kristallherz aktivieren oder deaktivieren?\n");
   if ( args != "ein" && args != "aus" )
      return 0;

   if ( is_active && args == "aus" )
   {
      is_active = 0;
      write("Du deaktivierst Dein Kristallherz.\n" );
      return 1;
   }
   else
     if ( is_active && args == "ein" )
     {
        notify_fail ("Dein Kristallherz ist schon aktiv!\n");
        return 0;
     }
     else
       if ( !is_active && args == "ein" )
       {
          is_active = 1;
          write("Du aktivierst Dein Kristallherz.\n" );
          return 1;
       }
       else
       {
       	  notify_fail ("Dein Kristallherz ist schon deaktiviert!\n");
       	  return 0;
       }

}

int player_privacy ( string args )
{
   if ( args == "ein" )
   {
      write ("Du wuenscht beim Liebesspiel ungestoert zu sein.\n");
      privacy = 1;
      return 1;
   }
   else
      privacy = 0;

   write ("Du wuenscht keine Privatspaere beim Liebesspiel.\n");
   return 1;
}

int initiate ( string args )
{
   if ( !is_active )
      return 0;

   notify_fail ("Hast Du denn einen Partner den Du verfuehren koenntest?\n");
   if ( check_state() < 1 )
      return 0;

   notify_fail ("Das hast Du doch bereits gemacht!\n");
   if ( check_state() > 2 )
      return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   set_state (2);
   output_text (15);
   return 1;

}

int stop_act ( string args )
{
   if ( !is_active )
      return 0;

   if ( check_state() < 2)
     return 0;

   write ("Du beendest Dein Liebesspiel mit "+partner->name(WEM)+".\n");
   tell_object(partner, TP->name()+" beendet das Liebesspiel mit Dir.\n");
   set_state (1);
   partner->set_state (1);
   // stop_scene();
   return 1;
}

int activate(string args)
{
   string test, p_name;

   if ( !is_active )
      return 0;

   notify_fail("Wem moechtest Du Dein Herz schenken?\n");

   if (!stringp(args))
      return 0;

   args = lower_case(args);

   // Ist die Syntax korrekt?
   if (sscanf (args, "%s an %s", test, p_name) != 2)
      return 0;

   if ( (test != "herz")&&(test != "kristallherz") )
      return 0;

   // Liebe Dich selbst ... okay, aber net so!
   if ( lower_case(TP->name()) == p_name )
   {
      notify_fail ("Also eine Beziehung mit Dir selbst solltest Du hoffentlich schon haben!\n");
      return 0;
   }

   // Haben wir schon eine Beziehung?
   if (state != 0)
   {
      notify_fail("Du befindest Dich doch schon in einer Verbindung!\n");
      return 0;
   }

   // Ist der Wunschpartner im Raum?
   if ( !objectp( partner = verify_partner(p_name) ) )
   {
      notify_fail("Diese Person ist nicht in Deiner Naehe!\n");
      reset_values();
      return 0;
   }

   // Hat der Wunschpartner ein Kristallherz?
   if ( !objectp( partner_heart = check_heart(partner) ) )
   {
      notify_fail("Diese Person kann Deine Zuneigung leider noch nicht erwiedern!\n");
      reset_values();
      return 0;
   }

   // Ist der Wunschpartner schon liiert?
   if ( partner_heart->get_state() )
   {
      notify_fail("Diese Person hat zur Zeit eine enge Vebindung mit jemand anders.\n");
      reset_values();
      return 0;
   }

   // Mal sehen ob wir auf der Liste der begehrten Stehen!
   if ( is_element(get_votaries(), partner ) )
   {
      write ("Du gehst eine enge Beziehung mit "+partner->name()+" ein.\n");
      tell_object (partner, environment(TO)->name()+" hat den Ruf Deines Herzens erhoert!\n");
      state = 1; // Wir sind nun liiert!!
      partner_heart->set_state(1);
      votaries = 0;
      partner_heart->set_votaries(0);
      SetProp(P_LONG,
        "Dies ist "+environment(TO)->name(WESSEN)+
        " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren. "+
        "Es schlaegt ganz und gar fuer "+
          partner->name()+".\n");
      partner_heart->SetProp(P_LONG,
        "Dies ist "+partner->name(WESSEN)+
        " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren. "+
        "Es schlaegt ganz und gar fuer "+
          environment(TO)->name()+".\n");
      save_object ( SAVEDIR "herz_"+getuid(TP));
      return 1;
   }
   else
   {
      partner_heart->add_votary(environment(TO));
      return 1;
   }
}

int deactivate(string args)
{
   if ( !is_active )
      return 0;

   notify_fail("Moechtest Du vielleicht eine Verbindung loesen?\n");

   if (!stringp(args))
      return 0;

   args = lower_case(args);

   if (args != "verbindung")
      return 0;

   notify_fail("Du hast zur Zeit keine direkte Verbindung zu Deinem Partner bestehen.\n");
   if (state == 0)
      return 0;

   if (objectp(partner_heart))
   {
      if ( partner_heart->get_partner() == environment(TO) )
      {
         if (objectp(partner))
         {
           write("Du hast Deine Verbindung zu "+partner->name()+" getrennt.\n");
           tell_object( partner, environment(TO)->name()+" hat die Verbindung zu Dir getrennt.\n");
           tell_object( partner, "Dein Herz ist nun wieder fuer eine neue Partnerschaft offen.\n");
         }
         write("Dein Herz ist nun wieder fuer eine neue Partnerschaft offen.\n");
      	 partner_heart->SetProp(P_LONG,
           "Dies ist "+partner->name(WESSEN)+
           " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren. "+
           "Es ist zur Zeit fuer eine neue Verbindung offen.\n");
         SetProp(P_LONG,
            "Dies ist "+environment(TO)->name(WESSEN)+
            " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren. "+
            "Es ist zur Zeit fuer eine neue Verbindung offen.\n");
      	 partner_heart->reset_values();
      	 reset_values();
      	 save_object ( SAVEDIR "herz_"+getuid(TP));
      	 return 1;
      }
      else
      {
      	 write("Dein Herz ist nun wieder fuer eine neue Partnerschaft offen.\n");
         SetProp(P_LONG,
            "Dies ist "+environment(TO)->name(WESSEN)+
            " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren. "+
            "Es ist zur Zeit fuer eine neue Verbindung offen.\n");
      	 reset_values();
      	 save_object ( SAVEDIR "herz_"+getuid(TP));
      	 return 1;
      }
   }
   else
   {
      write("Dein Herz ist nun wieder fuer eine neue Partnerschaft offen.\n");
       SetProp(P_LONG,
          "Dies ist "+environment(TO)->name(WESSEN)+
          " gruenlich schimmerndes Kristallherz. In seiner Mitte scheint es leicht rosa zu pulsieren. "+
          "Es ist zur Zeit fuer eine neue Verbindung offen.\n");
      reset_values();
      save_object ( SAVEDIR "herz_"+getuid(TP));
      return 1;
   }
}


// All of those commands are ONLY valid if:
