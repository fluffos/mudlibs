}

void menu_choice ( string args )
{
   int i;

   if ( args == "it" )
   {
      switch ( partner_heart->get_editing() )
      {
      	case 0: {
      		   write (partner->name()+" ist noch nicht bereit!\n");
      		   tell_object (partner, TP->name()+" moechte mit Dir ein Liebesspiel besprechen.\n");
      		   call_out ("edit_sequence", 0);
      		   return;
      		}
      	case 1: {
      		   editing = 2;  // Wir sperren den Zugriff
      		   write ("Text der Dir selbst ausgegeben wird: ");
      		   saved_command = ({ TP });
      		   input_to("insert_own_text");
      		   return;
      	        }
      	case 2: {
      		   write (partner->name()+" bearbeitet im Augenblick die Sequenz!\n");
      		   call_out ("edit_sequence", 0);
      		   return;
      	        }
      }
      write ( "Fehler! Dein Partner befindet sich in einem ungueltigen EditMode! Bitte Angel benachrichtigen!\n" );
      return;
   }

   if ( args == "ik" )
   {
      switch ( partner_heart->get_editing() )
      {
      	case 0: {
      		   write (partner->name()+" ist noch nicht bereit!\n");
      		   tell_object (partner, TP->name()+" moechte mit Dir ein Liebesspiel besprechen.\n");
      		   call_out ("edit_sequence", 0);
      		   return;
      		}
      	case 1: {
      		   editing = 2;  // Wir sperren den Zugriff
      		   write ("Bitte Kommando eingeben: ");
      		   input_to("insert_command");
      		   return;
      	        }
      	case 2: {
      		   write (partner->name()+" bearbeitet im Augenblick die Sequenz!\n");
      		   call_out ("edit_sequence", 0);
      		   return;
      	        }
      }
      write ( "Fehler! Dein Partner befindet sich in einem ungueltigen EditMode! Bitte Angel benachrichtigen!\n" );
      return;
   }

   if ( args == "ip" )
   {
      switch ( partner_heart->get_editing() )
      {
      	case 0: {
      		   write (partner->name()+" ist noch nicht bereit!\n");
      		   tell_object (partner, TP->name()+" moechte mit Dir ein Liebesspiel besprechen.\n");
      		   call_out ("edit_sequence", 0);
      		   return;
      		}
      	case 1: {
      		   editing = 2;  // Wir sperren den Zugriff
      		   write ("Wie viele Sekunden soll die Pause dauern? ");
      		   input_to("insert_pause");
      		   return;
      	        }
      	case 2: {
      		   write (partner->name()+" bearbeitet im Augenblick die Sequenz!\n");
      		   call_out ("edit_sequence", 0);
      		   return;
      	        }
      }
      write ( "Fehler! Dein Partner befindet sich in einem ungueltigen EditMode! Bitte Angel benachrichtigen!\n" );
      return;
   }

   if ( strlen (args) == 1 )
   switch ( args[0] )
   {
      case 'b': {
      	          write ("Du setzt den Sequenzzeiger vor den Anfang der Sequenz.\n");
      	          tell_object (partner, TP->name()+" setzt den Sequenzzeiger vor den Anfang der Sequenz.\n");
      	          stream_pointer = -1;
      	          partner_heart->set_stream_pointer (-1);
      	          call_out ("edit_sequence", 0);
      	          return;
      	        }

      case 'e': {
      	          write ("Du setzt den Sequenzzeiger ans Ende der Sequenz.\n");
      	          tell_object (partner, TP->name()+" setzt den Sequenzzeiger ans Ende der Sequenz.\n");
      	          stream_pointer = sizeof(sequence);
      	          partner_heart->set_stream_pointer (stream_pointer);
      	          call_out ("edit_sequence", 0);
      	          return;
                }

      case 'n': {
      	          if ( stream_pointer >= sizeof(sequence) )
      	          {
      	             write ("Der Sequenzzeiger ist schon am Ende der Sequenz!\n");
      	             call_out ("edit_sequence", 0);
      	             return;
      	          }
      	          stream_pointer ++;
      	          write ("Du rueckst den Sequenzzeiger um eine Szene auf die Stelle "+to_string(stream_pointer)+" vor.\n");
      	          tell_object (partner, TP->name()+" rueckt den Sequenzzeiger um eine Szene auf die Stelle "+to_string(stream_pointer)+" vor.\n");
      	          partner_heart->set_stream_pointer (stream_pointer);
      	          call_out ("edit_sequence", 0);
      	          return;
                }

      case 'z': {
      	          if ( stream_pointer < 0 )
      	          {
      	             write ("Der Sequenzzeiger ist schon vor dem Anfang der Sequenz!\n");
      	             call_out ("edit_sequence", 0);
      	             return;
      	          }
      	          stream_pointer --;
      	          write ("Du stellst den Sequenzzeiger um eine Szene auf die Stelle "+to_string(stream_pointer)+" zurueck.\n");
      	          tell_object (partner, TP->name()+" stellt den Sequenzzeiger um eine Szene auf die Stelle "+to_string(stream_pointer)+" zurueck.\n");
      	          partner_heart->set_stream_pointer (stream_pointer);
      	          call_out ("edit_sequence", 0);
      	          return;
                }

      case 'd': {
      	          if ( (stream_pointer < 0) || (!sizeof(sequence)) )
      	          {
      	             write ("Der Sequenzzeiger ist vor dem Anfang der Sequenz!\n");
      	             call_out ("edit_sequence", 0);
      	             return;
      	          }
      	          if ( stream_pointer >= sizeof(sequence) )
      	          {
      	             write ("Der Sequenzzeiger ist am Ende der Sequenz!\n");
      	             call_out ("edit_sequence", 0);
      	             return;
      	          }
      	          if ( stream_pointer == 0)
      	            sequence = sequence[1 .. sizeof(sequence)-1];
      	          else
                     if ( stream_pointer == (sizeof(sequence)-1) )
                        sequence = sequence[0 .. sizeof(sequence)-2];
                     else
                        sequence = sequence[0 .. stream_pointer-1] + sequence[stream_pointer+1 .. (sizeof(sequence)-1)];
      	          write ("Du loescht die Szene an der Stelle "+to_string(stream_pointer)+".\n");
      	          tell_object (partner, TP->name()+" loescht die Szene an der Stelle "+to_string(stream_pointer)+".\n");
      	          call_out ("edit_sequence", 0);
      	          return;
      	        }

      case 'l': {
      	          for (i = 0; i < sizeof(sequence); i++)
      	          {
      	             write ("Szene "+to_string(i)+": "+get_scene( sequence, i ) );
      	          }
      	          call_out ("edit_sequence", 0);
      	          return;
      	        }

      case 'v': {
      	          write ("Szene "+to_string(stream_pointer)+": "+get_scene( sequence, stream_pointer ) );
      	          call_out ("edit_sequence", 0);
      	          return;
      	        }

      case 's': {
      	          write ("Du merkst Dir den Ablauf des Liebesspieles ganz genau.\n");
      	          tell_object (partner, TP->name()+" merkst sich den Ablauf des Liebesspieles ganz genau.\n");
      	          store_data( sequence, SAVEDIR "sequence/"+getuid(TP)+"&"+getuid(partner)+".seq" );
      	          call_out ("edit_sequence", 0);
      	          return;
      	        }
      case 'h': {
      	          edit_menu();
      	          call_out ("edit_sequence", 0);
      	          return;
      	        }
      case 'q': {
      	          editing = 0;
      	          tell_object (partner, TP->name()+" hat den Editor beendet.\n");
      	          return;  // Abbruch
      	        }
   }
   write ("Ungueltige Eingabe!\n");
   call_out ("edit_sequence", 0);
}

void edit_menu ()
{
   write ("Sequenz-Editor-Menue:\n");
   write ("---------------------\n");
   write ("it/ik/ip ... Text/Kommando/Pause einfuegen\n");
   write ("b        ... springe vor die erste Szene\n");
   write ("e        ... springe zum Ende der Sequenz\n");
   write ("n        ... eine Szene nach vor\n");
   write ("z        ... eine Szene zurueck\n");
   write ("d        ... loeschen der aktuellen Szene\n");
   write ("l        ... alle Szenen auflisten\n");
   write ("v        ... aktuelle Szene anzeigen\n");
   write ("s        ... Sequenz sichern\n");
   write ("h        ... diesen Hilfetext anzeigen\n");
   write ("q        ... Editor beenden\n");
   write ("----------------------------------------\n");
   write ("Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n");
   write ("----------------------------------------\n");
}

void edit_sequence ()
{
   if ( check_state() < 1 )
   {
      write ("Zwischen Dir und Deinem Partner ist etwas vorgefallen!\n");
      return;
   }

   if ( !editing )
      return;

   write ("Deine Wahl: ");
   input_to("menu_choice");
}

int sequencer_commands ( string args )
{
   if ( !is_active )
      return 0;

   notify_fail ("Hast Du denn einen Partner mit dem Du das tun koenntest?\n");
   if ( check_state() < 1 )
      return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   if ( !partner_heart->get_editing() )
      tell_object (partner, TP->name()+" moechte mit Dir ein Liebesspiel besprechen.\n");

   editing = 1;
   stream_pointer = -1; // Anfang der Sequenz
   if ( !pointerp(sequence) )
      sequence = ( ({}) );
   partner_heart->set_sequence(sequence);

   edit_menu ();
   call_out ("edit_sequence", 0);
   return 1;
}
