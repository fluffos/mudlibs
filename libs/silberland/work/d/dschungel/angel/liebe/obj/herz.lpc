// Custom Commands
int do_restore_command ( int nr )
{
   if ( sizeof(std_commands2) + sizeof(std_commands2) + sizeof(std_commands3) > nr )
      if (nr > 7)
         command_list[nr] = std_commands2[nr-7];
      else
         if (nr > 14)
           command_list[nr] = std_commands3[nr-14];
         else
           command_list[nr] = std_commands2[nr-7];
}

int restore_command ( string args )
{
   int zahl;

   notify_fail ("Dieses Kommando gibt es nicht!\n");
   if ( ((zahl = to_int(args) ) > 0) && (to_int(args) <= sizeof(std_commands1) + sizeof(std_commands2) + sizeof(std_commands3))  )
   {
      do_restore_command (zahl-1);
      write ("Kommando wieder hergestellt!\n");
      save_object ( SAVEDIR "herz_"+getuid(TP));
      return 1;
   }
   return 0;
}

void confirm_command ( string args )
{
   string test;

   if (  sscanf(args, "ja%s", test) == 1 )
   {
      write ("Kommando gesetzt!\n");
      save_object ( SAVEDIR "herz_"+getuid(TP));
      return;
   }
   else
   {
      command_list[pointer] = saved_command;
   }
}

void define_others_text ( string args )
{
   if ( stringp (args) )
      command_list[pointer][2] = args;
   else
      command_list[pointer][2] = "";

   write ("Zusamenfassung des Kommandos:\n");
   write (command_list[pointer][0]+"\n"+command_list[pointer][1]+ "\n"+command_list[pointer][2]+"\n");

   write ("Ist das richtig? (ja/nein): ");
   input_to ("confirm_command");
}

void define_partner_text ( string args )
{
   if ( stringp (args) )
      command_list[pointer][1] = args;
   else
      command_list[pointer][1] = "";

   write ("Text der Zusehern ausgegeben wird: ");
   input_to ("define_others_text");
}

void define_own_text (string args )
{
   if ( stringp (args) )
      command_list[pointer][0] = args;
   else
      command_list[pointer][0] = "";

   write ("Text der dem Partner / der Partnerin ausgegeben wird: ");
   input_to ("define_partner_text");
}


// Define command versteht: Eine Integerzahl, sowie "neu" als Parameter.
int define_command ( string args )
{
   if ( !is_active )
      return 0;

   if ( strlen (args) < 3 )
      pointer = to_int(args) - 1;
   else
      if ( args[0 .. 2] == "neu" )
      {
      	 pointer = sizeof(command_list);
      	 command_list += new_command;
      	 write ("In Ordnung! Du erstellst ein neues Kommando mit der Nummer: "+to_string(pointer+1)+"\n");
      }
      else
         pointer = to_int(args) - 1;

   notify_fail ("Du kannst die Nummer eines vorhandenen Kommandos angeben, oder 'neu' um ein neues zu erschaffen!\n");
   if ( (pointer < 0 )||(pointer >= sizeof(command_list)))
      return 0;

   saved_command = command_list[pointer];

   write ("Text der Dir selbst ausgegeben wird: ");
   input_to ("define_own_text");
   return 1;
}

int custom_command ( string args )
{
   if ( !is_active )
      return 0;

   pointer = to_int(args) - 1;

   notify_fail ("Du kannst nur die Nummer eines vorhandenen Kommandos angeben!\n");
   if ( (pointer < 0 )||(pointer >= sizeof(command_list)))
      return 0;

   notify_fail ("Hast Du denn einen Partner mit dem Du das tun koenntest?\n");
   if ( check_state() < 1 )
      return 0;

   notify_fail (partner->name()+" fuehlt sich dafuer noch nicht in Stimmung!\n");
   if ( check_state() < 2)
     return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   output_text (pointer);
   return 1;
}

int list_commands ( string args )
{
   int i;
   string result;

   if ( !is_active )
      return 0;

   result = "";
   for (i=0; i < sizeof(command_list); i++)
   {
      result += "Kommando Nr.:"+to_string(i+1)+"\n";
      result += command_list[i][0]+"\n"+command_list[i][1]+ "\n"+command_list[i][2]+"\n\n";
   }

   TP->More (result);
   return 1;
}

void help_menu ( string args )
{
   int nr;

   if ( !stringp (args) )
      nr = 0;
   else
      nr = to_int (args);

   switch (nr)
   {
     case 0: TP->More(read_file(ZONE "help/herz.hlp")); break;
     case 1: TP->More(read_file(ZONE "help/kurzinfo.hlp")); break;
     case 2: TP->More(read_file(ZONE "help/verben_kommandos.hlp")); break;
     case 3: TP->More(read_file(ZONE "help/custom_commands.hlp")); break;
     case 4: TP->More(read_file(ZONE "help/sequenzer.hlp")); break;
     case 5: TP->More(read_file(ZONE "help/anmerkungen.hlp")); break;
     default: write ("Diesen Unterpunkt gibt es nicht!\n"); break;
   }
}

void help_text()
{
   write ("Hilfe zum Kristallherz der Liebe:\n");
   write ("---------------------------------\n");
   write (" 0 ... gesamter Hilfetext\n");
   write (" 1 ... Kurzinfo (Zusammenfassung)\n");
   write (" 2 ... Verben & Kommandos\n");
   write (" 3 ... custom commands (frei einstellbar)\n");
   write (" 4 ... Sequenzer (fuer das Liebesspiel)\n");
   write (" 5 ... Anmerkungen & Erklaerungen\n");
   write ("---------------------------------\n");
   write ("Deine Wahl: ");
}

int help_function ( string args )
{
   help_text();
   input_to ("help_menu");
   return 1;
}

mixed load_data ( string file_name )
{
   mixed data;
   mixed raw_data;
   mixed insert;
   int i;

   raw_data = read_file (file_name);  // Raw_Data -> String

   raw_data = explode (raw_data, "\n");

   if (!pointerp(raw_data))
      return 0;

   data = ({});

   for (i = 0; i < sizeof (raw_data); i++)
   {
      if ( (member(raw_data[i], '|')) != -1 )
      {
      	 insert = explode (raw_data[i], "|");  // Text Szene oder Kommando
      	 data += ({ insert });
      }
      else
         data += ({ to_int(raw_data[i]) }); // Pause
   }
   return data;
}

int store_data ( mixed data, string file_name )
{
   string result;
   int i;

   if (!pointerp(data))
      return 0;

   result = "";

   for (i = 0; i < sizeof (data); i++)
   {
      if ( pointerp (data[i]) )
      {
      	 data[i][0] = to_string (data[i][0]);
      	 result += to_string (implode (data[i], "|"))+"\n";  // Text Szene oder Kommando
      }
      else
      	 result += to_string(data[i])+"\n"; // Pause
   }
   rm ( file_name );
   return write_file ( file_name, result );
}

string get_scene ( mixed data, int pos )
{
   if (!pointerp(data))
      return 0;

   if ( (pos < 0) || pos >= sizeof(data) )
      return "";

   if ( pointerp (data[pos]) )
   {
      data[pos][0] = to_string (data[pos][0]);
      return to_string (implode (data[pos], "|"))+"\n";  // Text Szene oder Kommando
   }
   else
      return to_string(data[pos])+"\n"; // Pause
}

int play_sequence ( int resume )
{
   if ( paused || partner_heart->get_paused() )
      return 0;

   if ( !resume )
      stream_pointer = 0;

   if ( !pointerp(sequence) )
      return 0;

   if ( check_state() < 3) // Sind wir im Liebesspiel?
      return 0;

   if ( !verify_partner_interaction () ) // Sind beide Partner am selben Ort?
      return 0;

   if ( stream_pointer >= sizeof (sequence) )
   {
      state = 2;
      partner_heart->set_state(2);
      return 0;
   }

   // Check the type of the stream:
   if ( pointerp (sequence[stream_pointer]) )
   {
      if ( sizeof ( sequence[stream_pointer] ) > 2 )
      {
      	 if ( to_object(sequence[stream_pointer][0]) == environment(active) )
            active->output_scene (sequence[stream_pointer][1 .. 3]);  // Text Szene
         else
            passive->output_scene (sequence[stream_pointer][1 .. 3]);

         stream_pointer ++;
         partner_heart->set_stream_pointer( stream_pointer );
         call_out ("play_sequence", 0, 1);
      }
      else
      {
      	 if ( to_object(sequence[stream_pointer][0]) == environment(active) )
            environment(active)->command_me( sequence[stream_pointer][1] );
         else
            environment(passive)->command_me( sequence[stream_pointer][1] );

         stream_pointer ++;
         partner_heart->set_stream_pointer( stream_pointer );
         call_out ("play_sequence", 0, 1);
      }
   }
   else
   {
      if ( intp( sequence[stream_pointer] ) ) // Kommando
      {
         call_out ("play_sequence", sequence[stream_pointer], 1); // Pause
         stream_pointer ++;
         partner_heart->set_stream_pointer( stream_pointer );
      }
   }
   return 1;
}

int start_sex ( string args )
{
   if ( !is_active )
      return 0;

   notify_fail ("Hast Du denn einen Partner mit dem Du das tun koenntest?\n");
   if ( check_state() < 1 )
      return 0;

   notify_fail (partner->name()+" fuehlt sich dafuer noch nicht in Stimmung!\n");
   if ( check_state() < 2)
     return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   sequence = load_data (SAVEDIR "sequence/"+getuid(partner)+"&"+getuid(TP)+".seq");
   partner_heart->set_sequence( sequence );

   notify_fail ("Ihr habt doch noch gar nicht besprochen wie das ablaufen soll!\n");

   if ( !pointerp (sequence) )
      return 0;

   state = 3;
   partner_heart->set_state (3);
   active = TO;
   partner_heart->set_active (TO);
   passive = partner_heart;
   partner_heart->set_passive (partner_heart);
   output_text (16);

   if ( play_sequence (0) )
   {
      return 1;
   }
   else
   {
      state = 2;
      partner_heart->set_state (2);
      return 0;
   }
}

int pause_scene ( string args )
{
   if ( !is_active )
      return 0;

   notify_fail ("Du bist Doch garnicht beim Liebesspiel!\n");
   if ( check_state() < 3)
     return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   paused = 1;

   write ("Du legst eine Pause ein.\n");
   tell_object ( get_partner(), TP->name()+" legt eine Pause ein.\n" );
   return 1;
}

int resume_scene ( string args )
{
   if ( !is_active )
      return 0;

   notify_fail ("Du bist Doch garnicht beim Liebesspiel!\n");
   if ( ( check_state() < 3 )||( stream_pointer) )
     return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   paused = 0;

   if ( partner_heart->get_paused() )
   {
      notify_fail (get_partner()->name()+" moechte immer noch pausieren.\n");
      return 0;
   }

   write ("Und es geht weiter!\n");
   tell_object (get_partner(), "Und es geht weiter!\n");

   return 1;
}

void insert_command ( string args )
{
   if ( !stringp( args ) )
   {
      write ("Kein Kommando eingefuegt!\n");
      call_out ("edit_sequence", 0);
      return;
   }

   if ( stream_pointer == -1 ) // Einfuegen am Anfang
   {
      sequence = ({ ({ TP, args }) }) + sequence;
      stream_pointer ++;
      write ("Du fuegst das Kommando '"+args+"' ein.\n");
      tell_object ( partner, TP->name()+" fuegt das Kommando '"+args+"' ein.\n" );
      tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
      partner_heart->set_sequence (sequence);
      partner_heart->set_stream_pointer (stream_pointer);
      editing = 1;
      call_out ("edit_sequence", 0);
      return;
   }

   if ( stream_pointer >= sizeof(sequence) ) // Einfuegen am Ende
   {
      sequence =  sequence + ({ ({ TP, args }) });
      stream_pointer == sizeof(sequence);
      write ("Du fuegst das Kommando '"+args+"' ein.\n");
      tell_object ( partner, TP->name()+" fuegt das Kommando '"+args+"' ein.\n" );
      tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
      partner_heart->set_sequence (sequence);
      partner_heart->set_stream_pointer (stream_pointer);
      editing = 1;
      call_out ("edit_sequence", 0);
      return;
   }

   // Einfuegen zwischen Anfang und Ende:
   sequence =  sequence[0 .. stream_pointer] + ({ ({ TP, args }) }) + sequence[stream_pointer+1 .. sizeof(sequence)-1];
   stream_pointer ++;
   write ("Du fuegst das Kommando '"+args+"' ein.\n");
   tell_object ( partner, TP->name()+" fuegt das Kommando '"+args+"' ein.\n" );
   tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
   partner_heart->set_sequence (sequence);
   partner_heart->set_stream_pointer (stream_pointer);
   editing = 1;
   call_out ("edit_sequence", 0);
   return;
}

void insert_pause ( string args )
{
   int pause;

   pause = to_int ( args );
   if ( pause < 1 )
   {
      write ("Keine Pause eingefuegt!\n");
      call_out ("edit_sequence", 0);
      return;
   }

   if ( stream_pointer == -1 ) // Einfuegen am Anfang
   {
      sequence = ({ pause }) + sequence;
      stream_pointer ++;
      write ("Du fuegst eine Pause von "+to_string(pause)+" Sekunden ein.\n");
      tell_object ( partner, TP->name()+" fuegt eine Pause von "+to_string(pause)+" Sekunden ein.\n" );
      tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
      partner_heart->set_sequence (sequence);
      partner_heart->set_stream_pointer (stream_pointer);
      editing = 1;
      call_out ("edit_sequence", 0);
      return;
   }

   if ( stream_pointer >= sizeof(sequence) ) // Einfuegen am Ende
   {
      sequence =  sequence + ({ pause });
      stream_pointer == sizeof(sequence);
      write ("Du fuegst eine Pause von "+to_string(pause)+" Sekunden ein.\n");
      tell_object ( partner, TP->name()+" fuegt eine Pause von "+to_string(pause)+" Sekunden ein.\n" );
      tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
      partner_heart->set_sequence (sequence);
      partner_heart->set_stream_pointer (stream_pointer);
      editing = 1;
      call_out ("edit_sequence", 0);
      return;
   }

   // Einfuegen zwischen Anfang und Ende:
   sequence =  sequence[0 .. stream_pointer] + ({ pause }) + sequence[stream_pointer+1 .. sizeof(sequence)-1];
   stream_pointer ++;
   write ("Du fuegst eine Pause von "+to_string(pause)+" Sekunden ein.\n");
   tell_object ( partner, TP->name()+" fuegt eine Pause von "+to_string(pause)+" Sekunden ein.\n" );
   tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
   partner_heart->set_sequence (sequence);
   partner_heart->set_stream_pointer (stream_pointer);
   editing = 1;
   call_out ("edit_sequence", 0);
   return;
}

void insert_others_text ( string args )
{
   if ( !stringp(args) )
      saved_command += ({ "" });
   else
      saved_command += ({ args });

   if ( stream_pointer == -1 ) // Einfuegen am Anfang
   {
      sequence = ({ saved_command }) + sequence;
      stream_pointer ++;
      write ("Du fuegst die Szene "+get_scene( sequence, stream_pointer )+" ein.\n");
      tell_object ( partner, TP->name()+" fuegt die Szene "+get_scene( sequence, stream_pointer )+" ein.\n");
      tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
      partner_heart->set_sequence (sequence);
      partner_heart->set_stream_pointer (stream_pointer);
      editing = 1;
      call_out ("edit_sequence", 0);
      return;
   }

   if ( stream_pointer >= sizeof(sequence) ) // Einfuegen am Ende
   {
      sequence =  sequence + ({ saved_command });
      stream_pointer == sizeof(sequence);
      write ("Du fuegst die Szene "+get_scene( sequence, stream_pointer )+" ein.\n");
      tell_object ( partner, TP->name()+" fuegt die Szene "+get_scene( sequence, stream_pointer )+" ein.\n");
      tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
      partner_heart->set_sequence (sequence);
      partner_heart->set_stream_pointer (stream_pointer);
      editing = 1;
      call_out ("edit_sequence", 0);
      return;
   }

   // Einfuegen zwischen Anfang und Ende:
   sequence =  sequence[0 .. stream_pointer] + ({ saved_command }) + sequence[stream_pointer+1 .. sizeof(sequence)-1];
   stream_pointer ++;
   write ("Du fuegst die Szene "+get_scene( sequence, stream_pointer )+" ein.\n");
   tell_object ( partner, TP->name()+" fuegt die Szene "+get_scene( sequence, stream_pointer )+" ein.\n");
   tell_object ( partner, "Der Sequenzzeiger steht auf der Szene: "+to_string (stream_pointer)+"\n" );
   partner_heart->set_sequence (sequence);
   partner_heart->set_stream_pointer (stream_pointer);
   editing = 1;
   call_out ("edit_sequence", 0);
   return;
}

