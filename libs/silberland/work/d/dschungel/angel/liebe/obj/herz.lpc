// clothes & weapons

int undress_partner ( string args )
{
   string test, testp, part;

   if ( !is_active )
      return 0;

   if ( check_state() < 2)
     return 0;

   notify_fail ("Was moechtest Du wem denn ausziehen?\n");
   if ( !stringp(args) || sscanf(args, "%s %s aus%s", testp ,part, test) != 3 ||
        testp != lower_case(partner->name()) )
      return 0;

   notify_fail (get_partner()->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   notify_fail (get_partner()->name()+" ist doch schon splitternackt!\n");
   if (!sizeof(get_partner()->QueryProp(P_ARMOURS)))
      return 0;

   partner_item = worn_item( part, partner );

   if ( !objectp( partner_item ) )
      return 0;
   else
      if ( (member ( get_partner()->QueryProp(P_ARMOURS), partner_item ) == -1) )
         return 0;

   notify_fail ("Du kannst "+get_partner()->name()+" das nicht ausziehen!\n");
   if (!partner_item->DoUnwear(1))
   {
      return 0;
   }

   output_text (4);
   return 1;
}

int ripp_off_clothes ( string args )
{
   int i;
   mixed worn;

   if ( !is_active )
      return 0;

   notify_fail ("Hast Du denn einen Partner mit dem Du das tun koenntest?\n");
   if ( check_state() < 1 )
      return 0;

   notify_fail (partner->name()+" fuehlt sich dafuer noch nicht in Stimmung!\n");
   if ( check_state() < 2)
     return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   worn = get_partner()->QueryProp(P_ARMOURS);
   notify_fail (get_partner()->name()+" ist doch schon splitternackt!\n");
   if (!sizeof(worn))
      return 0;

   for (i = 0; i < sizeof(worn); i++)
       worn[i]->DoUnwear(1);

   output_text (5);
   return 1;
}

int disarm_partner ( string args )
{
   string test, testp, part;

   if ( !is_active )
      return 0;

   if ( check_state() < 2)
     return 0;

   notify_fail ("Was moechtest Du wem aus der Hand nehmen?\n");
   if ( !stringp (args) || sscanf(args, "%s %s ab%s", testp, part, test) != 3 ||
        testp != lower_case(partner->name()) )
      return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   notify_fail (get_partner()->name()+" haelt Doch gar nichts in der Hand!\n");
   if (!objectp(get_partner()->QueryProp(P_WEAPON)))
      return 0;

   partner_item = present( part, get_partner() );

   if ( !objectp( partner_item ) )
      return 0;
   else
      if ( get_partner()->QueryProp(P_WEAPON)!= partner_item )
         return 0;

   notify_fail ("Du kannst "+get_partner()->name()+" das nicht aus der Hand nehmen!\n");
   if (!partner_item->DoUnwield(1))
      return 0;

   output_text (6);
   return 1;
}

