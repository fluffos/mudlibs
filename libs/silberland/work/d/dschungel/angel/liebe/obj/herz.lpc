// * We are doing those things to OUR partner

// Kisses:

int kiss ( string args )
{
   string alternative;

   if ( !is_active )
      return 0;

   if ( stringp(args) && member ( args, '/' ) != -1 ) // altes soul-command
      return 0;

   if ( check_state() < 2)
     return 0;

   notify_fail (partner->name()+" ist doch gar nicht bei Dir!\n");
   if ( !verify_partner_interaction () )
      return 0;

   notify_fail ( partner->name()+" traegt einen Zahnschutz!\n" );
   if ( query_zahnschutz( partner ) )
      return 0;

   notify_fail ("Spuck gefaelligst vorher Deinen Zahnschutz aus!\n");
   if ( query_zahnschutz( TP ) )
      return 0;

   if ( stringp (alternative = CheckAlternative ( args, this_player() )) )
   {
      write ("Du kuesst "+partner->name(WEN)+" "+alternative+".\n");
      tell_object (partner, TPN+" kuesst Dich "+alternative+".\n");
      say (TPN+" kuesst "+partner->name(WEN)+" "+alternative+".\n", ({ TP, partner}) );
      return 1;
   }

   output_text (0);
   return 1;
}

