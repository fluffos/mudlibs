/******************************************************************************
 * Server fuer die Debug Tools
 * Datei: debug_server.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "./def.h"

nosave mixed  client_list;         // Alle registrierten Clients.

create()
{
  ::create();   

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Unique Debug Server" );
  SetProp(P_INVIS, 1);

  if (is_clone(this_object())) 
     destruct (this_object());

  AddId("unique_debug_server");
}

// Checkt ob el element von arr ist.
int is_element (mixed arr, object el)
{
  int i;
  for (i = 0;i < sizeof(arr) ;i++)
  {
     if (arr[i] == el) return 1;
  }
  return 0;
}


// Wir verbinden mal die Clients mit dem Server.
int link_into_system (object client)
{
  if (!client->id("unique_debug_tool"))
  {
     write ("This is no propper debug-tool!\n");
     return 0;
  }

  // Sehen wir mal ob schon jemand auf der Liste steht:
  if (!pointerp(client_list))
  { 
    // Dranhaengen des neuen Client!
    write ("Connected to debug-server!\n");
    client_list = ({client});
    return 1; 
  }
  else
  { 
    // Ist client noch nicht auf unserer Liste ...
    if (!is_element (client_list, client))
    {
       write ("Connected to debug-server!\n");
       client_list += ({client});
       return 1;
    }
    else
    {
       write ("You debug-tool is already connected!\n");
       return 0;
    }
  } 
}

// Sofern sich ein Client verabschieden moechte ...
int unlink_client (object client)
{
  if (!client->id("unique_debug_tool"))
     return 0;

  // Sehen wir mal ob schon jemand auf der Liste steht:
  if (!sizeof(client_list))
  {
    // Keiner da!
    write ("Your debug-tool ist not connected!\n");
    return 0;
  }
  else
  {
    // Ist client schon auf unserer Liste ...
    if (is_element (client_list, client))
    {
      // Runter mit dem Client!
      write ("Disconnected from debug-server!\n");
      client_list = client_list-({client});
      return 1;
    }
    else
    { 
       write ("Your debug-tool ist not connected!\n");
       return 0;
    }
  }
}

// Hier werden die Clients geprueft und die Nachricht an die
// angelschlossennen Clients in Reichweite (auf der Tribuene) verschickt:
void broadcast_debug_message (string msg)
{
  int i;

  for (i=0; i<sizeof(client_list); i++)
  {
     // Los geht's! Auf Sendung!
     if (objectp(client_list[i]))
        if (interactive(environment(client_list[i])))
           tell_object (environment(client_list[i]), msg);
  }
}
