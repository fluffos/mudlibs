#------------------------------------------------------------------------------ 
# Im Header einer solchen Bibliothek finden sich Schluessel, welche festlegen, 
# wie die weitere Information verarbeitet werden soll. 
# Format: 
# 
# ;key: <detail(str)> : <text> [<info-key>]<text> .. [<info-key>]<text>;
#------------------------------------------------------------------------------ 
;key: augen : <WER> hat [eyes]e Augen.;
;key: haar|haare : <WER> hat [hair_style]es, [hair_colour]es, [hair_status]es Haar.;
;key: naegel : <WESSEN> Naegel sehen [nails] aus.;
;key: klauen : <WESSEN> Klauen sehen [claws] aus.;
;key: bart : <WER> traegt [beard].;
;key: haut : <WER> hat [hue]e Haut.;
;key: fell : <WER> hat [fur]es Fell.;
;key: ohren: <WER> hat [ears]e Ohren.; 
;key: brust|brueste|busen : <WER> hat [breast]e Brueste.; 
;key: nase|nasenloecher : <WER> hat eine [nose]e Nase mit [nosehole] Nasenloechern.; 
;key: koerperbau : <WER> ist [body].;
;key: <look> : <WER> hat ~[eyes]e Augen, ~[hair_style]es, ~[hair_colour]es, ~[hair_status]es Haar, ~[ears]e Ohren, eine ~[nose]e Nase, {@TEST_KEY@[nails]?"~[nails]e Naegel"%"~[claws]e Klauen"}{@RACE@==[Zwerg]?", traegt ~[beard]"%{@GENDER@==@M@?", traegt ~[beard]"%""}}{@TEST_KEY@[breast]?", hat ~[breast]e Brueste"%""} und ist ~[body].;

