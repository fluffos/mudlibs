/******************************************************************************
 * Server fuer die Unique NPC
 * Datei: unpc_banishing_system.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../headers/unique_npc.h"
#include "./def.h"

nosave mixed names_storage;  // Die zu speichernden Namen.
nosave mixed illegal_names;  // Die schon vorhandenen Namen.

create()
{
  ::create();   

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Unique Banishing System" );
  SetProp(P_INVIS, 1);

  if (is_clone(this_object())) 
     destruct (this_object());

  AddId("unique_banishing_system");
  
  names_storage = 0;
}

// Findet die Position von el in arr[i][k]
int find_pos (mixed arr, mixed el, int k)
{
  int i, max;
  
  if (pointerp(arr))
  {
    max = sizeof(arr);
    for (i = 0; i < max; i++)
    {
       if (arr[i][k] == el) return i;
    }
  }
  return -1;
}

// Prueft und filtert Namen auf schon vorhandene.
verify_names(mixed names)
{
  int i;
  for (i=0; i < sizeof (names_storage); i++)
      names -= ({ names_storage[i] });
  for (i=0; i < sizeof (illegal_names); i++)
      names -= ({ illegal_names[i] });
  return names;
}

// Fuegt einen neuen Namen an die Liste der vorhandenen Namen.
int notify_new_name (string name)
{
  if (pointerp(names_storage))
     names_storage += ({ name });
  else
     names_storage = ({ name  });
     
  if (file_size(sprintf("/save/%c/%s.o", lower_case(name)[0], lower_case(name))) > 0)
  {
     write_file ( P_UNIQUE_BANISHING_LIST , name+" "+ctime()+"\n" );
     
     if (!pointerp(illegal_names))
        illegal_names = ({ name });
     else
        illegal_names += ({ name });
     return 0;
  }
  
  // Pruefen wir ob sonst ein NPC so heisst.
  if (find_living(name))
     return 0;
  else
     return 1;
}

// Loescht nicht mehr benoetigten Namen aus der Liste.
void notify_unused_name (string name)
{
  int i;
  if (pointerp(names_storage))
     names_storage -= ({ name });
}

// Im Reset raeumen wir auf:
reset()
{
  int i, max;
  mixed work;
  ::reset();
  
  // Alle nicht mehr verwendeten Namen werden rausgeworfen.
  work = names_storage;
  if (pointerp(names_storage))
  {
    max = sizeof (names_storage);
    for (i=0; i < max; i++)
    {
        if (!find_living(lower_case(names_storage[i])))
           work -= ({ names_storage[i] });
    }
  }
  names_storage = work;
}

mixed get_names_storage()
{
   return names_storage;
}

mixed get_illegal_names()
{
   return illegal_names;
}