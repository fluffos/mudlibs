#include "./def.h"

inherit LIB_UNIQUE "classes/unique_npc";

#include <properties.h>
#include <language.h>

create()
{
  ::create();   
  unique_npc::create();
  SetProp(P_SHORT, "Testi, das freundliche Debugtool");
  SetProp(P_LONG, 
    break_string("Das ist Testi, das  Debugtool. Es wird Dir sicher gerne helfen, Fehler bei "+
    "Unique NPCs ausfindig zu machen. Du kannst ihm z.B. mitteilen, "+
    "dass Du den Empfang von Fehlermeldungen wuenscht, bzw. nicht mehr wuenscht. "+
    "Testi kann sich darueber hinaus mit seinem Freund, dem Parser, unterhalten "+
    "und so ist es moeglich die Syntax und Runtime einer Detail-Bibliotheksdatei zu "+
    "pruefen. Frag Testi einfach mal nach der Syntax, dann hast Du den Dreh schnell heraussen!\n", 78));
  SetProp(P_ARTICLE, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NAME, "Testi");
  SetProp(P_GENDER, NEUTER);
  enable_commands();
  AddId( ({"debugtool", "tool", "unique_debug_tool", "testi"}) );
  SetProp(P_WEIGHT, 0);

  AddCmd ("empfang", "receive_broadcast");
  AddCmd (({"unpctest","UNT"}), "test_library");
  AddCmd (({"nimm","nehme"}), "take_tool");

  AddInfo( DEFAULT_INFO, "sagt: Da muss ich erst mal meine Freunde fragen ...\n");
 
  AddInfo(({"parser","freund","freunde"}),
  "sagt: Der Parser ist mein bester Freund!.\n");

  AddInfo(({"syntax","kommandos"}),
  "sagt: Ich verstehe die Kommandos <empfang> und <unpctest|UNT>.\n");

  AddInfo("empfang",
  "Mit <empfang ein/aus> bitte ich meinen Freund, den Parser, mich bei seinem Kumpel, dem Debugserver anzumelden, dann kann ich Dir alle Fehlermeldungen sofort mitteilen!\n", "sagt: ");

  AddInfo( ({"test","UNT", "unpctest"}),
  "Mit <UNT|unpctest [bibliothek(str)] [race(str)] [gender(int)]> bitte ich meinen Freund, den Parser, mir zu sagen ob denn diese Bibliothek denn auch konsistent ist.\nEr wird mir alle Ausgaben mitteilen, welche ich mit _FREUDE_ an Dich weiter leite! *strahl*\n", "sagt: ");

}

int take_tool (string args)
{
  string test;

  if (!stringp(args))
     return 0;

  switch (args)
  {
    case "testi": {
                    if ( IS_LEARNER( this_player() ) ) 
                    { 
                       this_object()->move(this_player(), M_NOCHECK|M_SILENT); 
                       tell_room(environment(this_player()), this_player()->name(WER)+" nimmt Testi an sich.\n", ({this_player()}) );
                       write ("Du nimmst Testi an Dich.\n");
                       return 1; 
                    } 
                    break;
                  }
    case "tool" : {
                    if ( IS_LEARNER( this_player() ) ) 
                    { 
                       this_object()->move(this_player(), M_NOCHECK|M_SILENT);
                       tell_room(environment(this_player()), this_player()->name(WER)+" nimmt Testi an sich.\n", ({this_player()}) );
                       write ("Du nimmst Testi an Dich.\n");
                       return 1; 
                    }
                    break;
                  }  
  }
  return 0;
}

int receive_broadcast (string args)
{
  object server;
  mixed test;
  string check;

  // Wir laden den Debug Server
  call_other( LIB_UNIQUE "classes/debug_server", "???", 0);

  server = find_object ( LIB_UNIQUE "classes/debug_server" );
  if (!objectp(server))
  {
    // Kein Debug Server Online!!! 
    notify_fail ("No debug server online - please install one and try again!\n");
    return 0;
  }

  // Haben wir ein Argument angegeben?
  if (!stringp(args))
  {
     notify_fail("Testi meint: Versuch es mal mit <empfang ein/aus>.\n");
     return 0;
  }

  if (sscanf (args, "aus%s", check) == 1)
  {
     server->unlink_client (this_object());
     return 1; // Fehlermeldung gibt's vom Server!
  }

  if (sscanf (args, "ein%s", check) == 1)
  {
     server->link_into_system (this_object());
     return 1; // Fehlermeldung gibt's vom Server!
  }

  notify_fail ("Syntax: <empfang ein/aus>\n");
  return 0;
}

int test_library (string args)
{
  int dice, i, index, index2, gender;
  string type, pre, post, lib, race;
  mixed header, details, keys, result;

  notify_fail ("Testi meint: <UNT|unpctest [library(str)] [race(str)] [gender(int)]> ginge besser.\n");
  if (!stringp(args))
     return 0; 

  if (sscanf(args, "%s %s %d", lib, race, gender) != 3)
     return 0;
  
  SetProp (P_GENDER, gender);
  SetProp (P_RACE, capitalize(race));
  
  notify_fail ("Keine gueltige Detail-Bibliothek!\n");

  if (!pointerp(header = load_details_header (lib)))
     return 0;

  for (i = 0; i < sizeof (header); i++)
  {
    if (i > 0)
       keys = result[1]; // Key-list

    result = parse(header[i][1], lib, keys);

    if (header[i][0] == "<look>")
    {
       do
       {
          index = find_char(result[0], "\"", 0);
          if (index >= 0)
          {
             index2 = find_char(result[0], "\"", index+1);
             if (index2 > 0)
             {
                if (!index)
                   pre = "";
                else
                   pre = result[0][0 .. index - 1];
                post = result[0] [index2 + 1 .. strlen (result[0]) - 1];
                result[0] = pre+post;
             }
          }
       }
       while (index != -1 && index2 != -1);

       write("\nP_LONG: "+result[0]+"\n");
    }
    else
    {
      index = find_char(result[0], "\"", 0);
      if (index >= 0)
      {
        do
        {
           index2 = find_char(result[0], "\"", index+1);
           if (index2 > 0)
           {
              if (!index)
                 pre = "";
              else
                 pre = result[0][0 .. index - 1];
              post = result[0] [index2 + 1 .. strlen (result[0]) - 1];

              header[i][0] += "|" + result[0][index +1 .. index2 -1];
              result[0] = pre+post;
           }
         }
         while (index != -1 && index2 != -1);
      }
      keys = explode (header[i][0], "|");
      if (!sizeof(keys))
         keys = header[i][0];
      write ("Detail: "+header[i][0]+" '"+result[0]+"'\n");
    }
  }

  return 1;
}
