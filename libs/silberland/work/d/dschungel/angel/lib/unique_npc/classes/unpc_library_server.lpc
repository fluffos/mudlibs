/******************************************************************************
 * Server fuer die Unique NPC
 * Datei: unpc_library_server.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "./def.h"

nosave mixed  data_storage;  // Die zu speichernde Info.

create()
{
  ::create();   

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Unique NPC Library Server" );
  SetProp(P_INVIS, 1);

  if (is_clone(this_object())) 
     destruct (this_object());

  AddId("unpc_library_server");
  
  data_storage = 0;
}

// Findet die Position von el in arr[i][0]
int find_pos (mixed arr, mixed el, int k)
{
  int i, max;
  
  if (pointerp(arr))
  { 
    max = sizeof(arr);
    for (i = 0; i < max; i++)
    {
       if (k == 0)
       if (arr[i][0] == el && arr[i][1] == k) return i;
    }
  }
  return -1;
}

// Modi:
// 0 .. Namen
// 1 .. Details Header
// 2 .. Details Body
// 3 .. Extras


// Laedt und die gespeicherten Daten
mixed load_lib (string lib, int mode)
{
   int position;
   
   if (!pointerp(data_storage))
      return 0;
   // Sehen wir mal ob wir schon etwas abgelegt haben:
   position = find_pos (data_storage, lib, mode);
   if (position != -1)
   {
      return data_storage[position][2];
   }
   else
   {
      return 0;
   }
}

// Legt ein Konstrukt im Speicher ab
void store_lib (string lib, int mode, mixed data)
{
   int position;
   // Sehen wir mal ob wir schon etwas abgelegt haben:
   position = find_pos (data_storage, lib, mode);
   if (position == -1)
   {
      if (!pointerp(data_storage))
         data_storage = ({ ({ lib, mode, data }) });
      else
         data_storage += ({ ({ lib, mode, data }) });
   }
   else
   {
      data_storage[position] = ({ lib, mode, data });
   }
   return;
}
