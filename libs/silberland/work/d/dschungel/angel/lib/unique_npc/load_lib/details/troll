#------------------------------------------------------------------------------
# Dies ist eine Bibliothek fuer rassenspezifische Details, wie sie von der 
# unique_npc.c Klasse verwendet wird. 
#------------------------------------------------------------------------------ 
# Autor: Angel 
# email: avs@sbox.tu-graz.ac.at 
#------------------------------------------------------------------------------ 
# Im Header einer solchen Bibliothek finden sich Schluessel, welche festlegen, 
# wie die weitere Information verarbeitet werden soll. 
# Format: 
# 
# ;key: <detail(str)> : <text> [<info-key>]<text> .. [<info-key>]<text>;
#------------------------------------------------------------------------------ 
;key: augen : <WER> hat [eyes]e Augen.;
;key: haar|haare : <WER> hat [hair_style]es, [hair_colour]es, [hair_status]es Haar.;
;key: klauen : <WESSEN> Klauen sehen [claws] aus.;
;key: bart : {@TEST_KEY@[beard]?"<WER> traegt [beard]."%""};
;key: haut : <WER> hat [hue]e Haut.;
;key: ohren : <WER> hat [ears]e Ohren.; 
;key: brust|brueste|busen : {@TEST_KEY@[breast]?"<WER> hat [breast]e Brueste."%""}; 
;key: nase|nasenloecher : <WER> hat eine [nose] mit [nosehole] Nasenloechern.; 
;key: koerperbau : <WER> ist [body].;
;key: <look> : <WER> hat ~[eyes]e Augen, ~[hair_style]es, ~[hair_colour]es, ~[hair_status]es Haar, ~[ears]e Ohren, eine ~[nose], ~[claws]e Klauen{@GENDER@==@M@?", traegt ~[beard]"%", hat ~[breast]e Brueste"} und ist ~[body].;
#------------------------------------------------------------------------------ 
# Im Body einer solchen Bibliothek finden sich 'info-keys', mit dazugehoerigen 
# Information, welche nach den Schluesseln im Header verarbeitet werden. 
# Format: 
# 
# <gender> bedeutet: 1 -> nur Maenner, 2 -> nur Frauen, 0 -> beide Geschlechter
# 
# <race(str)> - <gender(int)> - <info-key(str)> : <info(str)>, .. <info>;
#------------------------------------------------------------------------------ 
Troll - 0 - eyes : blau, gruen, gruenblau, rot, braun, schwarz, gruengelb, grau, blaugrau; 
Troll - 0 - hair_colour : schwarz, pechschwarz, braun, hellbraun, dunkelbraun, blond, bruenett, rot, feuerrot; 
Troll - 0 - hair_style : wild wachsend, straehnig, in viele kleine Zoepfe gebunden; 
Troll - 0 - hair_status : ungepflegt, struppig, verdreckt, gesplissen; 
Troll - 0 - claws : ungepflegt, abgebissen, verdreckt; 
Troll - 1 - beard : keinen Bart, einen Vollbart, einen langen ungepflegten Bart; 
Troll - 0 - hue : ledrig, roetlich, dunkelbraun, borstig; 
Troll - 0 - ears : rund, abstehend, gross, riesig, von Haaren verdeckt; 
Troll - 2 - breast : ueppig, ueberquellend, unmenschlich gross, gebirgig; 
Troll - 0 - nose : Ruebennase, Hakennase, Breitnase, Knollnase;
Troll - 0 - nosehole : grossen, sehr grossen; 
Troll - 0 - body : rundlich, fett, muskuloes gebaut, nur aus Muskeln gebaut, wie ein Berg aus Muskeln gebaut; 