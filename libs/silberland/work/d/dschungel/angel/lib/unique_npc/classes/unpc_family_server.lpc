/******************************************************************************
 * Server fuer die Unique NPC
 * Datei: unpc_family_server.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "./def.h"

nosave mixed  data_storage;         // Die zu speichernde Info.

create()
{
  ::create();   

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "Unique NPC Family Server" );
  SetProp(P_INVIS, 1);

  if (is_clone(this_object())) 
     destruct (this_object());

  AddId("unpc_family_server");
  
  data_storage = 0;
}

// Findet die Position von el in arr[i][k]
int find_pos (mixed arr, mixed el, int k)
{
  int i, max;
  
  if (pointerp(arr))
  {
    max = sizeof(arr);
    for (i = 0; i < max; i++)
    {
       if (arr[i][k] == el) return i;
    }
  }
  return -1;
}

// Laedt und die gespeicherten Daten
mixed load_data (string id)
{
   int position;
   
   if (!pointerp(data_storage))
      return 0;
   
   // Sehen wir mal ob wir schon etwas abgelegt haben:
   position = find_pos (data_storage, id, 0);
   if (position != -1)
      return data_storage[position][1];
   else
      return 0;
}

// Legt ein Konstrukt im Speicher ab
void store_data (string id, mixed data)
{
   int position;
   
   // Sehen wir mal ob wir schon etwas abgelegt haben:
   position = find_pos (data_storage, id, 0);
   if (position == -1)
      if (pointerp(data_storage))
         data_storage += ({ ({ id, data }) });
      else
         data_storage = ({ ({ id, data }) });
      
   else
      data_storage[position] = ({ id, data });
      
   return;
}

mixed data_dump ()
{
  return data_storage;
}