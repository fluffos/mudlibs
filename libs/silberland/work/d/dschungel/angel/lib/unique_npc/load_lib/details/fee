#------------------------------------------------------------------------------ 
# Im Header einer solchen Bibliothek finden sich Schluessel, welche festlegen, 
# wie die weitere Information verarbeitet werden soll. 
# Format: 
# 
# ;key: <detail(str)> : <text> [<info-key>]<text> .. [<info-key>]<text>;
#------------------------------------------------------------------------------ 
;key: augen : <WER> hat [eyes]e Augen.;
;key: haar|haare : <WER> hat [hair_style]es, [hair_colour]es, [hair_status]es Haar.;
;key: naegel : <WESSEN> Naegel sehen [nails] aus.;
;key: haut : <WER> hat [hue]e Haut.;
;key: ohren : {@TEST_KEY@[ears]?"<WER> hat [ears]e Ohren."%""}; 
;key: brust|brueste|busen : <WER> hat [breast]e Brueste.; 
;key: nase|nasenloecher : <WER> hat eine [nose] mit [nosehole] Nasenloechern.; 
;key: koerperbau : <WER> ist [body].;
;key: <look> : <WER> hat ~[eyes]e Augen, ~[hair_style]es, ~[hair_colour]es, ~[hair_status]es Haar, ~[ears]e Ohren, eine ~[nose], ~[nails]e Naegel, hat ~[breast]e Brueste und ist ~[body].;
#------------------------------------------------------------------------------ 
# Im Body einer solchen Bibliothek finden sich 'info-keys', mit dazugehoerigen 
# Information, welche nach den Schluesseln im Header verarbeitet werden. 
# Format: 
# 
# <gender> bedeutet: 1 -> nur Maenner, 2 -> nur Frauen, 0 -> beide Geschlechter
# 
# <race(str)> - <gender(int)> - <info-key(str)> : <info(str)>, .. <info>;
#------------------------------------------------------------------------------ 
