#------------------------------------------------------------------------------ 
# Im Header einer solchen Bibliothek finden sich Schluessel, welche festlegen, 
# wie die weitere Information verarbeitet werden soll. 
# Format: 
# 
# ;key: <detail(str)> : <text> [<info-key>]<text> .. [<info-key>]<text>;
#------------------------------------------------------------------------------ 
;key: augen : <WER> hat [eyes]e Augen.;
;key: haar|haare : <WER> hat [hair_style]es, [hair_colour]es, [hair_status]es Haar.;
;key: naegel : <WESSEN> Naegel sehen [nails] aus.;
;key: bart : <WER> traegt [beard].;
;key: haut : <WER> hat [hue]e Haut.;
;key: ohren : <WER> hat [ears]e Ohren.; 
;key: brust|brueste|busen : {@TEST_KEY@[breast]?"<WER> hat [breast]e Brueste."%""}; 
;key: nase|nasenloecher : <WER> hat eine [nose] mit [nosehole] Nasenloechern.; 
;key: koerperbau : <WER> ist [body].;
;key: <look> : <WER> hat ~[eyes]e Augen, ~[hair_style]es, ~[hair_colour]es, ~[hair_status]es Haar, ~[ears]e Ohren, eine ~[nose], ~[nails]e Naegel, traegt ~[beard]{@GENDER@==@M@?""%", hat ~[breast]e Brueste"} und ist ~[body].;
#------------------------------------------------------------------------------ 
# Im Body einer solchen Bibliothek finden sich 'info-keys', mit dazugehoerigen 
# Information, welche nach den Schluesseln im Header verarbeitet werden. 
# Format: 
# 
# <gender> bedeutet: 1 -> nur Maenner, 2 -> nur Frauen, 0 -> beide Geschlechter
# 
# <race(str)> - <gender(int)> - <info-key(str)> : <info(str)>, .. <info>;
#------------------------------------------------------------------------------ 
Zwerg - 0 - eyes : blau, gruen, gruenblau, rot, braun, schwarz, gruengelb, grau, blaugrau; 
Zwerg - 0 - hair_colour : schwarz, pechschwarz, braun, dunkelbraun, weiss, grau, aschgrau; 
Zwerg - 0 - hair_style : kurz geschnitten, zu einem Pagenkopf geschnitten, lang; 
Zwerg - 0 - hair_status : gepflegt, struppig, verdreckt, gesplissenes, gekaemmt; 
Zwerg - 0 - nails : gepflegt, geschnitten; 
Zwerg - 0 - beard : einen Vollbart, einen gepflegten Langbart; 
Zwerg - 0 - hue : gelblich, roetlich, dunkelbraun; 
Zwerg - 0 - ears : rund, klein, von Haaren verdeckt; 
Zwerg - 2 - breast : leicht angedeutet, sportlich, fest, ueppig, wuchtig, schmal, klein, mittler;
Zwerg - 0 - nose : Ruebennase, Hakennase, Breitnase, Adlernase;
Zwerg - 0 - nosehole : normalen, breiten, flachen; 
Zwerg - 0 - body : gedrungen gebaut, rundlich, muskuloes gebaut; 