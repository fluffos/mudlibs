#------------------------------------------------------------------------------
# Dies ist eine Bibliothek fuer rassenspezifische Details, wie sie von der 
# unique_npc.c Klasse verwendet wird. 
#------------------------------------------------------------------------------ 
# Autor: Angel 
# email: avs@sbox.tu-graz.ac.at 
#------------------------------------------------------------------------------ 
# Im Header einer solchen Bibliothek finden sich Schluessel, welche festlegen, 
# wie die weitere Information verarbeitet werden soll. 
# Format: 
# 
# ;key: <detail(str)> : <text> [<info-key>]<text> .. [<info-key>]<text>;
#------------------------------------------------------------------------------ 
;key: augen : <WER> hat [eyes]e Augen.;
;key: haar|haare : <WER> hat [hair_style]es, [hair_colour]es, [hair_status]es Haar.;
;key: naegel : <WESSEN> Naegel sehen [nails] aus.;
;key: bart : {@TEST_KEY@[beard]?"<WER> traegt [beard]."%""};
;key: haut : <WER> hat [hue]e Haut.;
;key: ohren : <WER> hat [ears]e Ohren.; 
;key: brust|brueste|busen : {@TEST_KEY@[breast]?"<WER> hat [breast]e Brueste."%""}; 
;key: nase|nasenloecher : <WER> hat eine [nose] mit [nosehole] Nasenloechern.; 
;key: koerperbau : <WER> ist [body].;
;key: <look> : <WER> hat ~[eyes]e Augen, ~[hair_style]es, ~[hair_colour]es, ~[hair_status]es Haar, ~[ears]e Ohren, eine ~[nose], ~[nails]e Naegel{@GENDER@==@M@?", traegt ~[beard]"%", hat ~[breast]e Brueste"} und ist ~[body].;
#------------------------------------------------------------------------------ 
# Im Body einer solchen Bibliothek finden sich 'info-keys', mit dazugehoerigen 
# Information, welche nach den Schluesseln im Header verarbeitet werden. 
# Format: 
# 
# <gender> bedeutet: 1 -> nur Maenner, 2 -> nur Frauen, 0 -> beide Geschlechter
# 
# <race(str)> - <gender(int)> - <info-key(str)> : <info(str)>, .. <info>;
#------------------------------------------------------------------------------ 
Elf - 0 - eyes : blau, gruen, gruenblau, braun, schwarz, gruengelb, grau, blaugrau; 
Elf - 0 - hair_colour : schwarz, braun, bruenett, rot, blond, weiss, aschgrau, grau, silbrig; 
Elf - 0 - hair_style : kurz geschnitten, schulterlang, lang; 
Elf - 0 - hair_status : gepflegt, gekaemmt, seidig; 
Elf - 1 - nails : gepflegt, geschnitten, poliert; 
Elf - 2 - nails : gepflegt, geschnitten, lackiert, lang, poliert; 
Elf - 1 - beard : keinen Bart; 
Elf - 0 - hue : sonnengebraeunt, gelblich, zart; 
Elf - 0 - ears : fast rund, eher spitz, sehr spitz, von Haaren verdeckt; 
Elf - 2 - breast : sportlich, fest, ueppig, wuchtig, schmal, klein, mittler;
Elf - 0 - nose : Stupsnase, Hakennase, Schmalnase, Langnase, spitze Nase, Adlernase, kleine Nase;
Elf - 0 - nosehole : normalen, kleinen, schmalen; 
Elf - 0 - body : duenn, normal gebaut, sportlich gebaut, muskuloes gebaut; 