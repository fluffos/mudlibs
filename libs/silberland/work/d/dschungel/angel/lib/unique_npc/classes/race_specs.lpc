inherit "std/thing/properties";

#include "./def.h"
#include LIB_UNIQUE "/headers/race_specs.h"
#include LIB_UNIQUE "/headers/unique_npc.h"

void create ()
{
   SetProp(P_UNIQUE_GENDER_RESTRICTIONS, ({ ({"Fee",1}) }) );
}


// Liefert die %abweichung einer Zahl + die Zahl
int get_variation (int number, int percent)
{
  int dice;

  dice = (random ( ( number * 2 * percent ) / 100 ) -
                 ( ( number * percent ) / 100 ) );

  return (dice + number);
}

void dwarf_specs ()
{
  // Groesse und Gewicht stellen wir mit einer zufaelligen Abweichung von
  // +/- 20 % vom Durchschnitt fest:
  
  SetProp(P_UNIQUE_AVERAGE_SIZE, 120);
  SetProp(P_SIZE, get_variation(QueryProp(P_UNIQUE_AVERAGE_SIZE), 20));  
  SetProp(P_UNIQUE_AVERAGE_WEIGHT, 75000);
  SetProp(P_WEIGHT, get_variation(QueryProp(P_UNIQUE_AVERAGE_WEIGHT), 20));
  
  SetProp(P_UNIQUE_RACE_DECLINATIONS, ({ ({"Zwerg","Zwerges","Zwerg","Zwerg"}),
                                         ({"Zwergin","Zwergin","Zwergin","Zwergin"}) }) );
  SetProp(P_UNIQUE_SURNAME_POLICY, 1);
  SetProp(P_MAX_FOOD, 80);
  SetProp(P_MAX_DRINK, 90);
  SetProp(P_MAX_ALCOHOL, 130);
  SetProp(P_FOOD_DELAY, 12);
  SetProp(P_DRINK_DELAY, 11);
  SetProp(P_ALCOHOL_DELAY, 3);
  SetProp(P_ALIGN, get_variation(50, 20));

  SetProp(P_HANDS, ({" mit blossen Haenden",QueryProp(P_LEVEL)*10,DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_FIRE  : -0.2,
         DT_POISON: -0.4,
         DT_MAGIC :  0.2,
         DT_WATER :  0.4, ]) );
}

