  SetProp(P_ALCOHOL_DELAY, 4);
 
  SetProp(P_HANDS, ({" mit blossen Haenden",QueryProp(P_LEVEL)*10,DT_BLUDGEON}) );
}


// Wir setzen hier mal die Werte fuer unsere NPC-Rassen.
// Es koennen ohne weiters neue Rassenspecs hinzugefuegt werden.
void set_race_specs(string race)
{
   switch (race)
   {
     case "Zwerg"     : dwarf_specs();  return;
     case "Elf"       : elf_specs();    return;
     case "Mensch"    : human_specs();  return;
     case "Hobbit"    : hobbit_specs(); return;
     case "Fee"       : fairy_specs();  return;
     case "Troll"     : troll_specs();  return;
     case "Oger"      : ogre_specs();   return;
     case "Dunkelelf" : drow_specs();   return;
     default : default_specs(); return; 
   }     
}

