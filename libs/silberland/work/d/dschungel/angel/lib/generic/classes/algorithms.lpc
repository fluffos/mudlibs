mixed field;

int PartitionField(int left, int right, int criteria)
{
  mixed pivot, swap;
  int j, k, i;

  pivot = field[left];

  j = left - 1;
  k = right + 1;

  while (1)
  {
     if (criteria == -1)
        do { j++; } while (field[j] < pivot);
     else
        do { j++; } while (field[j][criteria] < pivot[criteria]);
     if (criteria == -1)
        do { k--; } while (field[k] > pivot);
     else
        do { k--; } while (field[k][criteria] > pivot[criteria]);
     if ( j < k )
     {
       swap = field[k];
       field[k] = field[j];
       field[j] = swap;
     }
     else return k;
  }
}

void QuickSortField(int left, int right, int criteria)
{
  int k;
  if (left < right)
  {
    k = PartitionField(left, right, criteria);
    QuickSortField(left, k, criteria);
    QuickSortField(k+1, right, criteria);
  }
  return;
}

mixed SortField (mixed to_sort, int criteria)
{
  if (!pointerp(to_sort))
     return 0;

  else
  {
     field = to_sort;
 
     QuickSortField (0, sizeof(field)-1, criteria);
  }

  return field;
}

string delete_whites(string str)
{
  int i, max;
  
  if (!stringp(str))
     return 0;
  max = strlen(str);
  for (i = 0; i < max; i++)
  {
    if (str[i .. i] == " " || str[i .. i] == "	")
    {
      if (i == 0)
         str = str[1 .. strlen(str)];
      else
         str = str[0 .. i-1] + str[i+1 .. strlen(str)];
      i--;
    } 
  }
  return str;
}

// Checkt ob el element von arr ist.
int is_element (mixed arr, mixed el)
{
  int i, max;

  max = sizeof(arr);
  for (i = 0;i < max; i++)
  {
     if (arr[i] == el) return 1;
  }
  return 0;
}


// Finde das erste Zeichen 'char' in einem String
varargs int find_char(string str, string char, int start, int no_brackets)
{
  int i, max;
  int bracket;

  if (stringp(str) && stringp(char))
  {
    max = strlen(str);
    for (i = start; i < max; i++)
    {
      switch (str[i .. i])
      {
        case "{"  : bracket ++; break;
        case "}"  : bracket --; break; 
        default   : break; 
      }
      if (char == str[i .. i]) 
      {
         if (!no_brackets || !bracket)
            return i; 
      }
    }
  }
  return -1;
}

float pwr (float x, float y)
{
   return (exp(y*log(x)));
}