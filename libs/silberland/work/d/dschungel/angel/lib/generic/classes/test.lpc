inherit "/d/pk/angel/lib/generic/classes/parser";
inherit "/std/npc.lpc";

#include <properties.h>

int do_test (string str)
{
   write ("Geben sie einen String an: ");
   input_to ("parse");

   return 1;
}


create ()
{
  int i;
  string str;

  ::create();
  SetProp (P_SHORT, "test");
  AddId("test");
  SetProp (P_RACE, "Troll");
  SetProp (P_GENDER, 2);
  AddCmd ("test", "do_test");
  
}
