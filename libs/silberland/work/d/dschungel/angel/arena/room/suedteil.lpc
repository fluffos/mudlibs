#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "./def.h"
#include <moving.h>

void notify_gloves()
{
   tell_object (this_player(), "Mit diesen alten Zombiehandschuhen darfst Du die Arena nicht betreten!\n");
}

void init()
{
  object glove;
  mixed ident;
  
  ::init();
  glove = deep_present("zombiehandschuhe", this_player());
  
  if (objectp(glove))
  {
    ident = explode(file_name(glove), "#");
    if (ident[0] == "/d/wasser/dante/zinsel/armour/zha2")
    {
       if (glove->QueryProp(P_CLONE_TIME) < 994520000)
       {
       	  call_out("notify_gloves", 2);
       	  this_player()->move("/d/dschungel/dante/tijaraneu/room/ti_pfad11", M_GO);
       }
    }
  }
}

void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Eingang zur Arena in Neutijara" );
  SetProp( P_INT_LONG, break_string("Du stehst im suedlichen Teil der Eingangshalle "+
           "der Arena in Neutijara. Dieser Teil ist ueberdacht. Hier nimmt ein Vertreter der Arenaleitung die Besucher "+
           "der Arena in Empfang. Im Norden siehst Du den Eingang zum Kampfplatz der Arena. "+
           "Im Westen kann man das Buero der Arenaverwaltung betreten. ", 78));

  SetProp(P_INDOORS, 1);

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "besucher", "beispiel" }),
             "Leute wie Dich zum Beispiel.\n" );
  AddDetail( "leute",
             "Viele Leute kommen von weit her, um ihre Faehigkeiten im Duell unter Beweis zu stellen, oder um diesem Schauspiel beizuwohnen.\n" );
  AddDetail( "schauspiel",
             "Viele Leute empfinden die Duelle in der Arena als aufregend.\n");
  AddDetail( ({ "duell", "duelle", "arena" }),
             "In dieser Arena werden 'ehrenvolle Duelle' unter der Aufsicht der Arenaleitung ausgetragen.\n" );
  AddDetail( ({ "aufsicht", "arenaleitung", "leitung", "vertreter"}),
             "Du koenntest einen Vertreter der Arenaleitung nach den Regeln des ehrenvollen Duells fragen.\n" );
  AddDetail( "vertreter",
             "Sofern sie nicht anderwaertig beschaeftigt sind, versehen die Vertreter der Arenaleitung hier ihren Dienst.\n" );
  AddDetail( "dienst",
             "Besuchern, wie Dir, Auskunft ueber die Duelle in der Arena zu geben, sowie auch selbige zu beaufsichtigen.\n" );           
  AddDetail( ({ "boden", "fussboden", "holzboden" }),
	     "Der Boden besteht aus blutrotem Blutulmenholz.\n" );
  AddDetail( ({ "holz", "blutulmenholz" }),
             "Dieses Holz stammt sicher aus dem Dschungel.\n" );
  AddDetail( "dschungel",
             "Im Dschungel gibt es bei weitem die meisten Holzsorten im Silberland.\n" );
  AddDetail( ({ "silberland", "land" }), 
             "Dieses Land ist als Silberland bekannt.\n" );
  AddDetail( "holzsorten",
             "Die kennst Du sicher nicht alle, aber vielleicht kannst Du ja einige in der Arena finden.\n" );
  AddDetail( ({ "wand","waende" }),
	     "Die Waende der Eingangshalle sind, wie der Boden und das Dach aus Blutulmenholz.\n" );
  AddDetail( ({ "decke", "dach" }),
             "Dieser Teil der Eingangshalle ist ueberdacht, was reichlich Schatten spendet.\n" );
  AddDetail( "schatten",
             "Etwas Schatten tut an einem heissen Tag wie heute wirklich gut!\n");
  AddDetail( ({ "arena","arenen","gebaeude" }),
             "Eine Arena ist ein Platz auf dem Duelle ausgetragen werden. "+
             "Wenn Du Deine eigene Staerke beweisen willst, kannst Du Dich und "+
             "einen Partner zum Duell registrieren.\n" );
  AddDetail( ({ "partner","jemand" }),
             "Jemand der bereit ist sich mit Dir in der Arena zu messen.\n" );
  AddDetail( ({ "platz", "stadion", "form" }),
             "Die Arena hat die Form eines ovalen Stadions.\n" );
  AddDetail( "staerke",
             "Wenn Du wirklich von Dir und Deiner Staerke ueberzeugt bist, dann wage es einfach!\n" );
  AddDetail( "regeln",
             "Danach fragst Du am besten einen Vertreter der Arenaleitung.\n" );
  AddDetail( ({ "arenaverwaltung", "beamter", "arenabeamte", "arenabeamter", "buero" }),
             "Das Buero der Arenaverwaltung befindet sich oestlich von hier.\n" );
  AddDetail( "tag",
             "Ein Tag im Dschungel ... was hast Du erwartet ... etwa Kaelte und Eisbaeren?\n" );
  AddDetail( "kaelte",
             "Dafuer bist Du hier fehl am Platz.\n" );
  AddDetail( "eisbaeren",
             "Die leben sicher NICHT im Dschungel!\n");
  AddDetail( ({ "eingang", "eingangshalle", "halle", "suedteil" }),
             "Du befindest Dich hier im Suedteil der Eingangshalle in der Arena von Neutijara. \n" );
  AddDetail( "empfang",
             "Hier kannst Du mit etwas Glueck einen Vertreter der Arenaleitung antreffen.\n");
  AddDetail( ({ "glueck","quaentchen" }),
             "Ohne ein Quaentchen Glueck kommt man nicht weit.\n" );
  AddDetail( ({ "auskunft", "hilfe", "auskuenfte" }),
             "Fuer Auskuenfte fragst Du am besten einen Arenabeamten oder einen Vertreter der Arenaleitung.\n" );
  AddDetail( ({ "kampfplatz","norden" }),
             "Der Kampfplatz der Arena befindet sich im Norden.\n");
  AddDetail( ({ "neutijara", "teil", "stadtteil" }),
             "Neutijara ist ein Stadtteil von Tijara.\n" );
  AddDetail( ({ "tijara", "hauptstadt" }), 
             "Tijara ist die Hauptstadt der Region Dschungel.\n" );
  AddDetail( "region",
             "Diese Region heisst Dschungel.\n" );
       
  AddSmell( ({ DEFAULT_SMELL, "geruch" }),
            "Du kannst hier noch den Geruch der Stadt wahrnehmen.\n" );
     
  AddSound( DEFAULT_SOUND,
            "Von der Strasse her dringt etwas Laerm an Dein Ohr.\n" );
            
  AddSound( ({"strasse", "laerm", "stadt"}),
            "Der Laerm einer Stadt.\n" );
            
  AddSound( "ohr",
            "Dein Ohr hoerst Du nicht, sondern DAMIT hoerst Du etwas!\n" ); 


  AddExit("osten","auf die Strasse#/d/dschungel/dante/tijaraneu/room/ti_pfad11");

  AddExit("norden",([ EX_DEST : ROOM "nordteil",
                      EX_MSG  : "in den noerdlichen Teil der Eingangshalle"]) );

  AddExit("westen",([ EX_DEST : ROOM "arena_buero",
                      EX_MSG  : "nach Westen, in's Buero der Arenaverwaltung"]) );
  
  AddItem(NPC "arena_master", REFRESH_DESTRUCT);
  AddItem(OBJ "turschild",REFRESH_DESTRUCT);  //Infos ueber das Turnier
}
