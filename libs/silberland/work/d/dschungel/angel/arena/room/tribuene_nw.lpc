#pragma strong_types

inherit "std/room";

#include "./def.h"

// Laesst Spieler auf den Kampfplatz schreien
int shout_battle(string args)
{
  object server;
  
  args = this_player()->_unparsed_args();
  
  catch(call_other(PKOBJ "coordinator", "???", 0));
  server = find_object(PKOBJ "coordinator");
  if (!objectp(server))
     return 0;
   
  if (stringp(args))
  {
     write ("Du bruellst: "+args+"\n");
     args = this_player()->name()+" bruellt: "+args+"\n";
     tell_room(this_object(), args, ({this_player()}) );
     server->transmit_shout(args);
  }
     
  return 1;
}

// Funktion zum Festhalten von Gegnern
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, this_object(), "freeze_in_place"}) );
}

// Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Du solltest Dich erst erheben!\n";
}


// Unterscheiden wir mal die Rassen:
string distinguish_race()
{
   switch (this_player()->QueryProp(P_RACE) )
   {
      case "Mensch": return BS("Diese angenehm gepolsterten Stuehle waeren jetzt genau das richtige fuer Dich! Moechtest Du Dich nicht setzen?\n");
      default : return BS ("Diese Sitzmoeglichkeiten sagen Dir nicht wirklich zu. Schau Dich doch noch weiter um!\n");
   }
}

// Funktion zum Setzten:
int do_sit_down( string args )
{
  mixed res;
  
  // Pruefung ob evtl. ein MOVE_HOOK gesetzt ist.
  if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
         && intp(res[0]) && time() < res[0]
         && objectp(res[1]) && stringp(res[2]) )
       {
         // In diesem Fall sitzen wir gerade:
         if (res[1] == this_object())
         {
            notify_fail("Du sitzt doch schon!\n");
            return 0; 
         }
         else
         {
            notify_fail("Irgendwie kannst Du Dich derzeit nicht bewegen!\n");
            return 0; 
         }
       }
  }
   switch (this_player()->QueryProp(P_RACE) )
   {
      case "Mensch": {
      	               write (BS("Du laesst Dich auf einem der Stuehle nieder und entspannst Dich.\n"));
      	               tell_room(this_object(), this_player()->name()+" setzt sich entspannt auf einen Stuhl.\n", ({this_player()}));
      	               paralyze (1800, this_player());
      	               return 1;      	               
      	             }
      default : {
      	          write (BS ("Das ist Dir ganz einfach zu unbequem. Du entscheidest Dich dafuer stehen zu bleiben.\n"));
      	          return 1;
      	        }
   }
}

// Funktion zum Aufstehen:
int do_get_up( string args )
{
   string test;
   mixed res;
      
  notify_fail("Aber Du sitzt Doch noch gar nicht!\n");
  // Pruefung ob evtl. ein MOVE_HOOK gesetzt ist.
  if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
         && intp(res[0]) && time() < res[0]
         && objectp(res[1]) && stringp(res[2]) )
       {
         // In diesem Fall sitzen wir gerade:
         if (res[1] == this_object())
         {
            write("Du erhebst Dich wieder von Deinem Sitzplatz.\n");
            tell_room(this_object(), this_player()->name()+" erhebt sich wieder vom Sitzplatz.\n", ({this_player()}));
            this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
            return 1; 
         }
         else 
            return 0; 
       }
  }
  return 0;
}

// Zufaellige Meldungen
string zuschauer()
{
  mixed messages;
  
  messages = ({ "Setz doch mal Deine Magie ein Du Versager!!!\n", "Jetzt streng Dich doch mal an!!!\n", "Lass Ihn leben!!! Lass Ihn leben!!!\n", "Buuuuuuh!!!\n", "Nieder mit ihm!!!\n", "Unfair!!! Dieser Schlag war REGELWIDRIG!!!\n" });
  return messages[random(sizeof(messages)-1)]; 
}

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Nordwestlicher Teil der Arenatribuene in Neutijara");
  SetProp( P_INT_LONG, break_string("Du stehst auf der nordwestlichen Tribuene der Arena. "+
           "Von hier aus kannst Du die Kaempfe, auf dem weiter unten gelegenen Kampfplatz, beobachten. "+
           "Ein komplexes Spiegelsystem ermoeglicht, dass man von jedem Ort der Tribuene aus alle Vorkommnisse auf der Kampfflaeche beobachten kann. "+           
           "Damit man nicht die ganze Zeit stehen muss, gibt es, wie auch in den anderen Teilen der Tribuene, "+
           "zweckdienliche Sitzmoeglichkeiten. Hier sind es gepolsterte Stuehle.",78)); // Menschen

  SetProp(P_INDOORS,0);

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 31, ENV_TERRAIN: TT_TOWN]) );


  AddDetail( ({ "ort", "teil", "abschnitt" }),
             "Du befindest Dich im nordwestlichen Teil der Tribuene.\n");
  AddDetail( ({"spiegel", "spiegelsystem" }),
             "Du findest, dass es gut funktioniert, aber Du durchschaust es nicht.\n" );
  AddDetail( "vorkommnisse",
             "Wuerde es Dich nicht interessieren, was auf der Kampfflaeche passiert, waerst Du kaum hier.\n" );
  AddDetail( ({ "sitzmoeglichkeit", "sitzmoeglichkeiten", "mensch", "menschen" }),
             "Wenn Du kein Mensch bist, wirst Du hier auch nicht besonders bequem sitzen.\n" );
  AddDetail( "stuehle",
             "Diese gepolsterten Stuehle werden von Menschen bevorzugt.\n" );
  AddDetail( "zeit",
             "Nutze die Zeit! Sie verrinnt viel zu schnell!\n" );
  AddDetail( ({ "fingernagel", "naegel", "fingernaegel" }),
             "Deine Fingernaegel sind haerter als das Tannenholz.\n" );
  AddDetail( ({ "boden", "fussboden", "holzboden" }),
	     "Der Boden dieses Teils der Arena besteht aus Tannenholz.\n" );
  AddDetail( ({ "holz", "tannenholz" }),
             "Du bist Dir dabei ziemlich sicher, da dieses Holz die typische Charakteristik von Tannenholz besitzt.\n" );
  AddDetail( ({ "charakteristik", "farbe" }),
             "Tannenholz hat helle Farbe, praegnante Maserung aber keine besonders gute Stabilitaet.\n" );
  AddDetail( "maserung",
             "Du verfolgst die Maserung des Holzes und findest eine Stelle, die wie ein Herz aussieht!\n" );
  AddDetail( ({ "stelle","herz" }),
             "Das findest Du suess.\n" );
  AddDetail( ({ "stabilitaet", "festigkeit", "abriebfestigkeit", "eigenschaften", "festigkeitseigenschaften" }),
             "Tannenholz besitzt - bist Du Dir sogar ganz sicher, nachdem Du mit dem Fingernagel eine Rille ins "+
             "weiche Holz gedrueckt hast, - keine besonderen Festigkeitseigenschaften, Du solltest hier also besonders "+
             "aufpassen, damit Du nichts kaputt machst.\n" );
  AddDetail( ({ "rille", "rillen" }),
             "Es sieht fast so aus, als haetten schon mehrere Leute hier die Festigkeit des Holzes getestet.\n" );
  AddDetail( "leute",
             "Leute wie Du, die die Festigkeit des Holzes testen wollten.\n" );
  AddDetail( ({ "tribuene", "tribuenen", "innenwand", "innenwaende" }),
	     "Die Innenwaende der Tribuene bestehen in diesem Teil der Tribuene, wie der Boden, aus Tannenholz.\n" );
  AddDetail( ({ "wand", "waende" }),
             "Meinst Du die Aussenwand oder die Innenwaende?\n");
  AddDetail(  "aussenwand",
              "Die Aussenwand dieses Abschnittes besteht - hmm Du bist Dir nicht ganz sicher ... aber Du glaubst - aus Fichtenholz.\n" );
  AddDetail(  "fichtenholz",
             "Wie das Tannenholz, besitzt auch das Fichtenholz keine besonders guten Festigkeitseigenschaften.\n" );
  AddDetail( ({ "decke" }),
             "Dass es im Freien keine Decke gibt, stoehrt Dich nicht im geringsten. Du siehst zum Himmel und fragst Dich wie es nur so ein herrliches Blau geban kann.\n" );
  AddDetail( "blau",
             "Vieleicht nicht Deine Lieblingsfarbe, aber die Intensitaet dieses Blaus ist nicht zu verachten.\n" );
  AddDetail( "lieblingsfarbe",
             "Die weisst Du selbst am besten!\n" );
  AddDetail( "intensitaet",
             "Wirklich beeindruckend!\n" );
  AddDetail( ({ "himmel" }),
             "Die gluehend heisse Sonne verschont Dich auch in diesem Teil der Arena nicht.\n" );
  AddDetail( "sonne",
             "Von sonnenseitiger Schonung kann hier jedenfalls nicht die Rede sein.\n");
  AddDetail( ({ "schonung", "rede" }),
             "Hast Du Dir denn irgendwie Schonung verdient?\n" );  
  AddDetail( ({ "arena","arenen","gebaeude" }),
             "Eine Arena ist ein Platz auf dem ehrenvolle Duelle ausgetragen werden.\n" );
  AddDetail( ({ "duell","duelle" }),
             "Danach solltest Du jemanden fragen der sich auskennt.\n" );
  AddDetail( ({ "platz","kampfplatz", "kampfflaeche", "kaempfe" }),
             "Der Platz, auf dem die Duellanten aufeinander losgehen nennet man Kampfplatz.\n" );
  AddDetail( ({ "gegner", "duellanten" }),
             "Die beiden Gegner, die sich in einem Duell gegenueberstehen nennt man Duellanten.\n" );

  AddSmell( DEFAULT_SMELL,
            "Hier riecht es nach frischer Luft.\n" );
            
  AddSmell( "luft",
            "Ein wenig Luft tut Dir bei dieser Hitze gut.\n" );
     
  AddSound( DEFAULT_SOUND,
            "Du kannst immer wieder Zuschauer hoeren, die etwas auf die Kampfflaeche bruellen.\n" );   
            
  AddSound( "zuschauer",
            #'zuschauer );   
            
  AddExit("suedwesten", ([EX_DEST : ROOM "tribuene_w"]) );
  AddExit("osten", ([EX_DEST : ROOM "tribuene_no"]) );
  
  AddCmd ( ({"bruelle", "bruell" }), "shout_battle");
  AddCmd ( ({"setze", "setz", "sitz" }), "do_sit_down");
  AddCmd ( "erhebe", "do_get_up");  
}
