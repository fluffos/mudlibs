#pragma strong_types

inherit "std/room";

#include "./def.h"

// Laesst Spieler auf den Kampfplatz schreien
int shout_battle(string args)
{
  object server;
  
  args = this_player()->_unparsed_args();
  
  catch(call_other(PKOBJ "coordinator", "???", 0));
  server = find_object(PKOBJ "coordinator");
  if (!objectp(server))
     return 0;
   
  if (stringp(args))
  {
     write ("Du bruellst: "+args+"\n");
     args = this_player()->name()+" bruellt: "+args+"\n";
     tell_room(this_object(), args, ({this_player()}) );
     server->transmit_shout(args);
  }
     
  return 1;
}

// Funktion zum Festhalten von Gegnern
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, this_object(), "freeze_in_place"}) );
}

// Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Du solltest Dich erst erheben!\n";
}


// Unterscheiden wir mal die Rassen:
string distinguish_race()
{
   switch (this_player()->QueryProp(P_RACE) )
   {
      case "Dunkelelf": return BS("Das Design der Stuehle zieht Dich magisch an! Moechtest Du Dich nicht setzen?\n");
      default : return BS ("Diese Sitzmoeglichkeiten sagen Dir nicht wirklich zu. Schau Dich doch noch weiter um!\n");
   }
   
}

// Funktion zum Setzten:
int do_sit_down( string args )
{
  mixed res;
  
  // Pruefung ob evtl. ein MOVE_HOOK gesetzt ist.
  if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
         && intp(res[0]) && time() < res[0]
         && objectp(res[1]) && stringp(res[2]) )
       {
         // In diesem Fall sitzen wir gerade:
         if (res[1] == this_object())
         {
            notify_fail("Du sitzt doch schon!\n");
            return 0; 
         }
         else
         {
            notify_fail("Irgendwie kannst Du Dich derzeit nicht bewegen!\n");
            return 0; 
         }
       }
  }
   switch (this_player()->QueryProp(P_RACE) )
   {
      case "Dunkelelf": {
      	               write (BS("Du laesst Dich auf einem der Stuehle nieder und fuehlst Dich fast wie Zuhause.\n"));
      	               tell_room(this_object(), this_player()->name()+" laesst sich entspannt auf einem der Stuehle nieder.\n", ({this_player()}));
      	               paralyze (1800, this_player());
      	               return 1;      	               
      	             }
      default : {
      	          write (BS ("Das ist Dir ganz einfach zu unbequem. Du entscheidest Dich dafuer stehen zu bleiben.\n"));
      	          return 1;
      	        }
   }
}

// Funktion zum Aufstehen:
int do_get_up( string args )
{
   string test;
   mixed res;
      
  notify_fail("Aber Du sitzt Doch noch garnicht!\n");
  // Pruefung ob evtl. ein MOVE_HOOK gesetzt ist.
  if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
         && intp(res[0]) && time() < res[0]
         && objectp(res[1]) && stringp(res[2]) )
       {
         // In diesem Fall sitzen wir gerade:
         if (res[1] == this_object())
         {
            write("Du erhebst Dich wieder von Deinem Sitzplatz.\n");
            tell_room(this_object(), this_player()->name()+" erhebt sich wieder vom Sitzplatz.\n", ({this_player()}));
            this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
            return 1; 
         }
         else 
            return 0; 
       }
  }
  return 0;
}

// Zufaellige Meldungen
string zuschauer()
{
  mixed messages;
  
  messages = ({ "Setz doch mal Deine Magie ein Du Versager!!!\n", "Jetzt streng Dich doch mal an!!!\n", "Lass Ihn leben!!! Lass Ihn leben!!!\n", "Buuuuuuh!!!\n", "Nieder mit ihm!!!\n", "Unfair!!! Dieser Schlag war REGELWIDRIG!!!\n" });
  return messages[random(sizeof(messages)-1)]; 
}

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Suedwestlicher Teil der Arenatribuene in Neutijara");
  SetProp( P_INT_LONG, break_string("Du stehst auf der oestlichen Tribuene der Arena. "+
           "Von hier aus kannst Du die Kaempfe, auf dem weiter unten gelegenen Kampfplatz, beobachten. "+
           "Ein komplexes Spiegelsystem ermoeglicht, dass man von jedem Ort der Tribuene aus alle Vorkommnisse auf der Kampfflaeche beobachten kann. "+
           "Damit man nicht die ganze Zeit stehen muss, gibt es, wie auch in den anderen Teilen der Tribuene, "+
           "zweckdienliche Sitzmoeglichkeiten. In diesem Fall sind es grotesk anmutende, schwarze, achtbeinige, "+ // Drow
           "chitinbezogene Stuehle.",78));

  SetProp(P_INDOORS,0);

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 31, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "spiegel", "spiegelsystem" }),
             "Hier wurde eben beinahe an alles gedacht.\n" );
  AddDetail( ({ "ort", "vorkommnisse" }),
             "Durch das Spiegelsystem sieht man an jedem Ort auf der Tribuene bis in den letzten Winkel der Kampfflaeche.\n" );
  AddDetail( "winkel",
             "Dadurch entgehen Dir auch keine wichtigen Vorkommnisse auf der Kampfflaeche.\n" ); 
  AddDetail( ({ "zeit", "redewendung" }),
             "Wenn man sich sinnvoll beschaeftigt, vergeht die Zeit wie im Flug.\n" );
  AddDetail(  "flug",
             "Das ist eine Redewendung.\n" );
  AddDetail( "sitzmoeglichkeiten",
             "Hier scheint man besonders auf das Wohl der Besucher bedacht zu sein.\n" );
  AddDetail( ({ "stuehle", "fall" }),
             "Ganz in schwarz, achtbeinig, wie eine Spinne und mit Chitin ueberzogen - also ganz der Stil von Dunkelelfen.\n" );
  AddDetail( ({ "dunkelelfen", "dunkelelf" }),
             "Dunkelelfen werden diese Stuehle zu schaetzen wissen.\n" );
  AddDetail( ({ "spinne", "chitin", "stil" }),
             "Damit fuehlt sich ein Dunkelelf wie daheim.\n" );
  AddDetail( ({ "einstellung", "wohl", "besucher" }),
             "Eine solche Einstellung ist aeusserst lobenswert!\n" );
  AddDetail( ({ "boden", "fussboden", "holzboden" }),
	     "Der Boden dieses Teils der Arena besteht aus Eichenholz.\n" );
  AddDetail( ({ "holz", "eichenholz" }),
             "Du bist Dir dabei ziemlich sicher, da dieses Holz die typische Charakteristik von Eichenholz besitzt.\n" );
  AddDetail( ({ "charakteristik","farbe" }),
             "Eichenholz hat helle Farbe und hohe Stabilitaet.\n" );
  AddDetail( ({ "stabilitaet", "festigkeit", "abriebfestigkeit", "eigenschaften", "festigkeitseigenschaften" }),
             "Eichenholz besitzt - glaubst Du zu wissen - hervorragende Festigkeitseigenschaften und hohe Abriebfestigkeit, was dem Boden besonders zugute kommt.\n" );
  AddDetail( ({ "tribuene", "tribuenen", "innenwand", "innenwaende" }),
	     "Die Innenwaende der Tribuene bestehen in diesem Teil der Tribuene, wie der Boden, aus Eichenholz.\n" );
  AddDetail( ({ "wand", "waende" }),
             "Meinst Du die Aussenwand oder die Innenwaende?\n");
  AddDetail(  "aussenwand",
              "Die Aussenwand dieses Abschnittes besteht - soweit Du das beurteilen kannst - aus typisch roetlichem Buchenholz.\n" );
  AddDetail(  "buchenholz",
             "Wie das Eichenholz, besitzt auch das Buchenholz besonders gute Eigenschaften.\n" );
  AddDetail( ({ "decke" }),
             "Du siehst zum Himmel, als gerade ein Schwarm Voegel vorbeizieht.\n" );
  AddDetail( ({ "voegel","schwarm" }),
             "Du denkst, dass es sich bei den Voegeln um Schwalben handelt.\n" );
  AddDetail( "vogel", 
             "Unter einem Schwarm Voegel versteht man mehr als einen einzelnen Vogel.\n" );
  AddDetail( ({ "himmel" }),
             "Die gluehend heisse Sonne scheint erbarmungslos vom Himmel.\n" );
  AddDetail( "sonne",
             "Die Sonne scheint heute gar kein Mitleid mit Dir zu haben.\n");
  AddDetail( "mitleid",
             "Warum sollte Die Sonne gerade Dich bevorzugen?\n" );
  AddDetail( ({ "teil", "abschnitt"}),
             "Dies ist der suedwestliche Teil der Tribuene.\n" );
  AddDetail( ({ "arena","arenen","gebaeude" }),
             "Eine Arena ist ein Platz auf dem ehrenvolle Duelle ausgetragen werden.\n" );
  AddDetail( ({ "duell", "duelle", "kaempfe" }),
             "Duelle sind faire Kaempfe wobei man gegen einen einzigen Gegner antritt.\n" );
  AddDetail( "gegner",
             "Waehren es mehrere, so waer es kein Duell.\n" );
  AddDetail( ({ "platz", "kampfplatz", "kampfflaeche" }),
             "Dorthin begibst Du Dich besser nicht ohne gruendlich darueber nachgedacht zu haben.\n" );
  AddDetail( ({ "die", "details" }),
             "Details wie 'die' muss man nun wirklich nicht untersuchen ...\n" );
             
  AddSmell( DEFAULT_SMELL,
            "Hier riecht es nach frischer Luft.\n" );
            
  AddSmell( "luft",
            "Ein wenig Luft tut Dir bei dieser Hitze gut.\n" );
     
  AddSound( DEFAULT_SOUND,
            "Du kannst immer wieder Zuschauer hoeren, die etwas auf die Kampfflaeche bruellen.\n" );   
            
  AddSound( "zuschauer",
            #'zuschauer );        

  AddExit("nordwesten", ([EX_DEST : ROOM "tribuene_w"]) );
  AddExit("osten", ([EX_DEST : ROOM "tribuene_so"]) );
  
  AddCmd ( ({"bruelle", "bruell" }), "shout_battle");
  AddCmd ( ({"setze", "setz", "sitz" }), "do_sit_down");
  AddCmd ( "erhebe", "do_get_up");  
}
