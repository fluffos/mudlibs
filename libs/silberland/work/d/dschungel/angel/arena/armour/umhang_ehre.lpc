inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Umhang der Ehre");
  SetProp(P_LONG,  
  "Ein Umhang, wie ihn die Arenaleiter der Arena in Neutijara tragen. "+
  "Er ist aus feinestem Stoff gefertigt und scheint ueberdies, eine besondere "+
  "Aura zu besitzen.");
  
  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( "umhang" );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_COTTON:75, MAT_MAGIC:25]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 1500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:1, T_HEAT_PROT:-1 ]) );
}
