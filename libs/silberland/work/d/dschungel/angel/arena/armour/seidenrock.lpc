inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer Seidenrock");
  SetProp(P_LONG,
    "Dieser lange, schwarze Rock aus feinster Seide, "+
    "wuerde sicher die Beine seiner Traegerin vorteilhaft hervorheben.");
    
  SetProp(P_NAME, "Seidenrock" );
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "schwarz");
  AddId( ({"rock", "seidenrock"}) );
  SetProp(P_INFO, "Natuerlich tragen nur Frauen solch einen Rock.\n");
  AddAdjective( ({"schwarzer"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 800);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE ]) );
  
  AddDetail( ({"seide"}),
    "Die Seide ist sehr weich und anschmiegsam, genau wie es viele Frauen "
    "lieben.");
  AddDetail( "beine",
    "Dieser Rock unterstreicht noch die Schoenheit gepflegeter, langer Frauenbeine.");
}

