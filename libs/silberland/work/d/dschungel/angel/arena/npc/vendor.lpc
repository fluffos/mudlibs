#include <language.h>
#include <ansi.h>
#include "./def.h"
#include "../../lib/unique_npc/headers/unique_npc.h"

inherit "std/npc/sequencer";
inherit NPC "arena_race_specs";
inherit LIB "unique_npc/classes/unique_npc";

void create()
{
  if (!is_clone(this_object()))
    return;
    
  arena_race_specs::create();
  unique_npc::create();
  ::create(); 
  
  SetProp(P_UNIQUE_RACE_PROBABILITY, ({ ({"Mensch",100}), ({"Elf",30}), 
                      ({"Zwerg",30}), ({"Hobbit",30}), }) );
  //create_unique_family( 60, 60, 15, 50, 0, NPC "arena_names", NPC "arena_surnames" );
  create_default_npc( 15 );
  SetProp(P_GENDER, get_gender(50));  
  SetProp(P_NAME, distinguish_gender("Arenabeamter", "Arenabeamtin"));
  SetProp(P_RACE, get_race(QueryProp(P_GENDER))); 
  set_race_specs(QueryProp(P_RACE)); 
  AddId(lower_case(QueryProp(P_NAME)));
  AddId(distinguish_gender("beamter", "beamtin"));
  AddId(distinguish_gender("arenabeamter", "arenabeamtin"));
  AddId("vendor");
  SetProp(P_SHORT, Name(WER,1) );
  SetProp(P_LONG,  get_long("Vor Dir steht der Arenabeamte. ",
                            "Vor Dir steht die Arenabeamtin. ") );

  SetProp(P_ALIGN, get_between(100, 300) );
  SetProp(P_MAX_HANDS, 2);
  seteuid(getuid(this_object()));
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_DIE_MSG, " faellt tot hinter den Schreibtisch.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Die Jugend von heute ...");
  SetProp(P_MURDER_MSG, "Gut %s, nun duerft IHR meine Beamtentaetigkeit ausueben!");
  SetProp(P_DEFAULT_INFO,"sagt: Da fragt Ihr am besten einen Vertreter "+
                         "der Arenaleitung!\n");
  SetChats(2, ({
    Name(WER,1)+" blickt Dich erwartungsvoll an.\n",
    Name(WER,1)+" fragt: Sucht Ihr nach einem Fernglas?\n",
    Name(WER,1)+" sagt: Eintrittskarten fuer die Tribuene verkaufe ich hier.\n",
    Name(WER,1)+" fragt: Wollt Ihr Euch fuer ein Duell registrieren?\n",
    Name(WER,1)+" sortiert die Unterlagen auf dem Schreibtisch.\n" }) );
    
  SetAttackChats(5, ({
    Name(WER,1)+" sagt: Ich kann Eure Feindseligkeit nicht verstehen!\n",
    Name(WER,1)+" sagt: Tragt Eure Kampfe doch in der Arena aus!\n",
    Name(WER,1)+" sagt: Wie soll ich bitte arbeiten, wenn ich dauernd gestoert werde?\n" }) );
             
  // Spezielle Informationen, bei denen der Spieler weitergeleitet wird:
  AddInfo( "hilfe",
    "Hier im Buero, koennt Ihr Euch zum ehrenvollen Duell registrieren "+
    "lassen. Weitere Informationen entnehmt Ihr bitte der Tafel an der Wand "
    "oder fragt einen Vertreter der Arenaleitung.", "sagt: " 
  );
  // Spezielle Informationen, die der NPC selbst beantwortet:
  AddInfo( "tafel",
    "Sie enthaelt eine Uebersicht an Informationen die Registrierung von "+
    "Duellen betreffend.\n","sagt: " 
  );
  AddInfo( ({ "fernglas", "fernglaeser" }),
    "Mit einem Fernglas koennt Ihr die Kaempfe besonders genau von "+
    "der Tribuene aus verfolgen.\n", "sagt: " );
  AddInfo(({"ticket", "tickets", "eintrittskarte", "karte"}),
    "Mit einer Eintrittskarte, welche Ihr bei mir kaeuflich erwerben "+
    "koennt, duerft Ihr die Tribuene.\n", "sagt: " 
  );
  AddInfo("arena",
    "In dieser Arena koennt Ihr einen Gegner zum ehrenvollen "+
    "Duell herausfordern.\n", "sagt: "
  );
  AddInfo( "tribuene",
    "Mit einer Eintrittskarte duerft Ihr die Tribuene der Arena betreten. Moechtet "+
    "Ihr die Duelle genauer beobachten, so empfiehlt es sich, ein "+
    "Fernglas zu erwerben.", "sagt: " 
  ); 
  AddInfo(({"registrierung","registrieren","bestaetigung","bestaetigen"}),
    "Dazu lest Ihr am besten die Tafel an der Wand und stellt dann noch offene "+
    "Fragen an einen Vertreter der Arenaleitung.\n", "sagt: "
  );
  AddInfo( "eingangshalle",
    "Einfach aus dem Buero hinausgehen, dann seid Ihr dort.\n", "sagt: " 
  );
  AddInfo( ({ "vertreter", "arenaleitung" }),
    "Im Osten muesstet Ihr einen Vertreter der Arenaleitung finden.\n", "sagt: " 
  );
  AddInfo( "buero",
    "Dies ist das Buero der Arenaverwaltung, hier arbeite ich.\n", "sagt: " 
  );
  AddInfo( "informationen",
    "Sollten die Informationen der Tafel nicht ausreichend sein, so fragt "+
    "am besten einen Vertreter der Arenaleitung.\n", "sagt: "
  );
  
  SetProp (P_SPELLRATE, 25);
  
  // Angriff mit der Fuellfeder:
  AddSpell(9, 400,
           Name(WER,1)+" greift sich eine Schreibfeder und sticht nach Dir.\n",
           Name(WER,1)+" greift sich eine Schreibfeder und sticht nach @WEM.\n",
          ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
          
  // So ein Stuhl am Kopf tut nicht gut:
  AddSpell(1, 750,
           Name(WER,1)+" wirft Dir den Stuhl an den Kopf.\n",
           Name(WER,1)+" wirft @WEM den Stuhl an den Kopf.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
  
  if (QueryProp(P_GENDER) == 1)
  {
     clone_object (ARMOUR "seidenhose")->move (this_object(), M_GET);
     clone_object (ARMOUR "seidenhemd")->move (this_object(), M_GET);
     clone_object (ARMOUR "lederschuhe_fein")->move (this_object(), M_GET);
  }
  else
  {
     clone_object (ARMOUR "seidenrock")->move (this_object(), M_GET);
     clone_object ("/p/armour/armour/bluse")->move (this_object(), M_GET);
     clone_object ("/p/armour/boots/seidenschuhe")->move (this_object(), M_GET);
     clone_object ("/p/armour/ring/ring")->move (this_object(), M_GET);
  }
  command_me("trage alles");
}

void die(int poisondeath) 
{
  mixed farben;
  object orden;
  orden = present("DuellItem", QueryProp(P_KILLER)||TP);
  if (objectp(orden))
  {
     switch (TP->QueryProp(P_TTY))
     {
       case "ansi": farben=({ANSI_BG_RED+ANSI_BOLD, ANSI_NORMAL}); break;
       case "vt100": farben=({ANSI_BOLD, ANSI_NORMAL}); break;
       default: farben=({"",""}); break;
     }
     tell_object(QueryProp(P_KILLER)||TP, sprintf("\n\n%sDiese Schandtat hat Dich Deine Ehre "+
                                          "gekostet!%s\n\n\n", farben[0], farben[1]) );
     orden->remove();
  }
  ::die(poisondeath);
}

// Begruesungsroutine
void greet_player(mixed people)
{
   int i;
   string msg;
   
   // Niemand zum gruessen? Dann raus!
   if (!sizeof(people))
      return;
      
   msg = "Seid gegruesst "; 
   
   if (pointerp(people))
   for (i = 0; i < sizeof(people); i++)
   {
      if ( i == (sizeof(people) - 2) )
      {
         msg += people[i]->name()+" und ";
      }
      else 
      {
      	if ( i == (sizeof(people) - 1) )
            msg += people[i]->name()+"!\n";
        else
            msg += people[i]->name()+", ";
      }
   }
   command ("sag " + msg + 
       "Ich repraesentiere die Arenaverwaltung dieser Arena. "+
       "Wie kann ich Euch weiterhelfen?");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "sagt: Lasst mich doch einfach in Ruhe!");
      break;
    case "aergerlich":
      call_out("react", 0, "fragt: Was hat Euch denn vergraemt, "+TPN+"?",0);
      break;
    case "traurig":
      call_out("react", 0, "sagt: Auf Regen folgt wieder Sonnenschein.");
      break;
    case "albern":
      call_out("react", 0, "kann sich ein Grinsen nicht verkneifen.",0);
      break;
    case "neutral":
      call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+" an.");
      break;
    case "intim":
      if ( QueryProp(P_GENDER) != TP->QueryProp(P_GENDER) )
         call_out("react", 0, "fluestert Dir zu: Nach Dienstschluss habe ich mehr Zeit.", 
                  "fluestert "+TP->name(WEN)+" etwas zu.");
      else
         call_out("react", 0, "distanciert sich hoeflich, aber bestimmt von Dir.", 
                  "distanciert sich hoeflich, aber bestimmt von "+TP->name(WEM)+".");
      break;
    case "froh":
      call_out("react", 0, "freut sich mit Dir.",
             "freut such mit "+TP->name(WEM)+".");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Das ist alles halb so schlimm, "+TPN+".");
      break;
    case "frech":
      call_out("react", 0, "legt die Stirn in Falten und wundert sich offenbar ueber Dich.", 
      "legt die Stirn in Falten und wundert sich offenbar ueber "+TP->name(WEN)+".");
      break;
    case "nett":
      call_out("react", 0, "nickt Dir freundlich zu.", "nickt "+TP->name(WEM)+" freundlich zu.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
