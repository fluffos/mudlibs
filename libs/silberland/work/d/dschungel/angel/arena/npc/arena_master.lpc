// Pruefung ob wir jemanden vom Arenapersonal auf dem Gewissen haben
int verify_honour()
{
   object family_server;
   mixed family_tree;
   int i;
   
   family_server = find_object( LIB_UNIQUE "classes/unpc_family_server");
   if (!objectp(family_server))
      return 1;
   
   // Pruefung ob wir den Arenaleiter selber getoetet haben:
   family_tree = family_server->load_data(NPC "arena_master");
   if (pointerp(family_tree))
   {
      for (i = 0; i < sizeof(family_tree[1]); i++)
      {
      	if (family_tree[1][i][5] == getuid(this_player()))
      	   return 0; // Wir haben jemanden auf dem Gewissen!
      }
   }
/*
   // Pruefung ob wir den Kartenabreisser getoetet haben:
   family_tree = family_server->load_data(NPC "collector");
   if (pointerp(family_tree))
   {
      for (i = 0; i < sizeof(family_tree[1]); i++)
      {
      	if (family_tree[1][i][5] == getuid(this_player()))
      	   return 0; // Wir haben jemanden auf dem Gewissen!
      }
   }   
   // Pruefung ob wir den Wirt getoeten haben:
   family_tree = family_server->load_data(NPC "barman");
   if (pointerp(family_tree))
   {
      for (i = 0; i < sizeof(family_tree[1]); i++)
      {
      	if (family_tree[1][i][5] == getuid(this_player()))
      	   return 0; // Wir haben jemanden auf dem Gewissen!
      }
   }   
   // Pruefung ob wir den Beamten getoetet haben:
   family_tree = family_server->load_data(NPC "vendor");
   if (pointerp(family_tree))
   {
      for (i = 0; i < sizeof(family_tree[1]); i++)
      {
      	if (family_tree[1][i][5] == getuid(this_player()))
      	   return 0; // Wir haben jemanden auf dem Gewissen!
      }
   } */
   return 1;
}

string request_probation ()
{  
   object orden, orden_neu;
   int penalty;
   
   if ( this_player()->QueryProp(P_CLONE_TIME) < 992469600 )
      return (this_player()->name()+", zu Eurer eigenen Sicherheit kann ich Euch leider "+
              "keinen Orden aushaendigen! Bitte wendet Euch an einen Magier, falls Ihr Euch dem Ritual der "+
              "Erneuerung unterziehen wollt!\n");
   
   if (verify_honour())
   {
      if (!objectp(present("DuellItem", this_player())))
      {           
         clone_object( LIB_DUELL "obj/orden_bew" )->move(this_player());
         return ("In Ordnung "+this_player()->name()+
             "! Ihr sollt Eure Chance erhalten!\nNehmt Diesen Orden als "+
             "Zeichen Eures Strebens nach Ehre!\n");
      }
      else
      {
      	 orden = present("DuellItem", this_player());
      	 if (!orden->id("EhreOrden"))
      	 {
      	    // Damit man nicht sinnlos Orden wechseln kann!
      	    if ( orden->QueryProp(P_CLONE_TIME) + 300 < time() 
      	         && !orden->check_duell() 
      	         && !orden->is_registered(this_player()) )
      	    {
      	      // Die Wartezeit wird uebertragen
      	      penalty = orden->get_wartezeit();
              orden->remove();
              orden_neu = clone_object( LIB_DUELL "obj/orden_bew" );
              orden_neu->move(this_player());
              orden_neu->set_wartezeit( penalty );
              return ("In Ordnung "+this_player()->name()+
                    "! Euer Orden wurde erneuert!\n");
            }
            else
               return ("Ich werde Euren Orden noch nicht erneuern, "+this_player()->name()+"!\n");         
         }
         else
            return (this_player()->name()+
                    ", Euer Orden der Ehre ist mehr als nur ausreichend!\n");                     
      }
   } 
   else
   {
      return (this_player()->name()+
           ", Ihr habt mit Euren Missetaten bewiesen, dass Ihr nicht "+
           "wuerdig seid!\n");
   }
}

void create()
{
  if (!is_clone(this_object()))
    return;
    
  arena_race_specs::create();
  duell::create();
  ::create(); 
  
  SetProp(P_UNIQUE_RACE_PROBABILITY, ({ ({"Mensch",100}), ({"Elf",30}), 
                          ({"Zwerg",30}), ({"Hobbit",30}), }) );
//  SetProp(P_ARTICLE, 0);
//  create_unique_family( 15, 60, 30, 50, 0, NPC "arena_names", NPC "arena_surnames" );
  create_default_npc(30);
  SetProp(P_GENDER, get_gender(50));  
  SetProp(P_NAME, distinguish_gender("Arenaleiter", "Arenaleiterin"));
  set_living_name("arena_master");
  SetProp(P_RACE, get_race(QueryProp(P_GENDER))); 
  set_race_specs(QueryProp(P_RACE)); 
  AddId(lower_case(QueryProp(P_NAME)));
  AddId(distinguish_gender("leiter", "leiterin"));
  AddId(distinguish_gender("arenaleiter", "arenaleiterin"));
  AddId("Schwertexperte");
//  SetProp(P_SHORT, 
//  QueryProp(P_NAME) + distinguish_gender(" der Arenaleiter", " die Arenaleiterin"));
//  SetProp(P_LONG,  get_long("Vor Dir steht "+QueryProp(P_NAME)+", der Arenaleiter. ",
//                       "Vor Dir steht "+QueryProp(P_NAME)+", die Arenaleiterin. ") );
//  set_details ("/d/dschungel/angel/lib/unique_npc/load_lib/details", 1);

  SetProp(P_SHORT, Name(WER,1) + " ueberwacht alle Aktivitaeten in der Arena");  
  SetProp(P_LONG, "Vor Dir steht " + name(WER,1) + ". " + capitalize(QueryPronoun(WER)) +  
      " ueberwacht alle Aktivitaeten in der Arena. " + get_long() ); 
  SetProp( P_ALIGN, get_between (600, 800) );
  SetProp(P_MAX_HANDS, 2);
  seteuid(getuid(this_object()));
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_DIE_MSG, " stirbt den Heldentod.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Ihr muesst noch einiges ueber Ehre lernen!");
  SetProp(P_MURDER_MSG, "Eine beachtliche Leistung mich zu besiegen!");
  SetProp(P_DEFAULT_INFO, "sagt: Tut mir leid, dazu faellt mir nichts ein, "+
