  SetChats(2, ({
    Name(WER,1)+" laechelt Dich an.\n",
    Name(WER,1)+" fragt: Seid Ihr hier um ein Duell auszutragen?\n",
    Name(WER,1)+" sagt: Der Pfad der Tugend ist nicht der einfachste.\n",
    Name(WER,1)+" fragt: Wollt Ihr Euch fuer ein Duell registrieren?\n",
    Name(WER,1)+" sagt: Ehre ist fuer uns die wichtigste Tugend!\n",
    Name(WER,1)+" fragt: Kennt Ihr die Regeln des ehrenvollen Duells?\n" }) );
    
  SetAttackChats(5, ({
    Name(WER,1)+" sagt: Euer Verhalten ist eine Schande!\n",
    Name(WER,1)+" sagt: Seid Ihr nicht mutig genug diesen Kampf in der Arena auszutragen?\n",
