void die(int poisondeath) 
{
  mixed farben;
  object orden;
  orden = present("DuellItem", QueryProp(P_KILLER)||TP);
  if (objectp(orden))
  {
     switch (TP->QueryProp(P_TTY))
     {
       case "ansi": farben=({ANSI_BG_RED+ANSI_BOLD, ANSI_NORMAL}); break;
       case "vt100": farben=({ANSI_BOLD, ANSI_NORMAL}); break;
       default: farben=({"",""}); break;
     }
     tell_object(QueryProp(P_KILLER)||TP, sprintf("\n\n%sDiese Schandtat hat Dich Deine Ehre "+
                                          "gekostet!%s\n\n\n", farben[0], farben[1]) );
     orden->remove();
  }
  ::die(poisondeath);
}

// Begruesungsroutine
void greet_player(mixed people)
{
   int i;
   string msg;
   
   // Niemand zum gruessen? Dann raus!
   if (!sizeof(people))
      return;
      
   msg = "Seid gegruesst "; 
   
   if (pointerp(people))
   for (i = 0; i < sizeof(people); i++)
   {
      if ( i == (sizeof(people) - 2) )
      {
         msg += people[i]->name()+" und ";
      }
      else 
      {
      	if ( i == (sizeof(people) - 1) )
            msg += people[i]->name()+"!\n";
        else
            msg += people[i]->name()+", ";
      }
   }
   say (break_string ( msg + /* "Mein Name ist "+name()+ */
       "Ich repraesentiere die Arenaleitung dieser Arena. "+
       "Solltet Ihr Fragen zur Arena oder zu Duellen haben, so "+
       "werde ich nach Kraeften versuchen diese zufriedenstellend "+
       "zu beantworten.\n", 78, Name(WER,1)+" sagt: ", 1) );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "sagt scharf: Zuegelt Euer Benehmen, "+TPN+"!");
      break;
    case "aergerlich":
      call_out("react", 0, "fragt: Aerger ist keine Loesung, "+TPN+"!");
      break;
    case "traurig":
      call_out("react", 0, "sagt: Auf Regen folgt wieder Sonnenschein.");
      break;
    case "albern":
      call_out("react", 0, "laechelt gutmuetig.");
      break;
    case "neutral":
      call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEM)+" zu.");
      break;
    case "intim":
      if ( QueryProp(P_GENDER) != TP->QueryProp(P_GENDER) )
         call_out("react", 0, "fluestert Dir zu: Bei Gelegenheit!", 
                  "fluestert "+TP->name(WEM)+" etwas zu.");
      else
         call_out("react", 0, "distanciert sich hoeflich, aber bestimmt von Dir.", 
                  "distanciert sich hoeflich, aber bestimmt von "+TP->name(WEM)+".");
      break;
    case "froh":
      call_out("react", 0, "freut sich mit Dir.",
             "freut such mit "+TP->name(WEM)+".");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Folgt dem Pfad der Ehre, dann braucht Ihr nichts zu fuerchten!");
      break;
    case "frech":
      call_out("react", 0, "meint: Ihr habt noch einen weiten Weg vor Euch, "+TPN+".");
      break;
    case "nett":
      call_out("react", 0, "nickt Dir freundlich zu.", "nickt "+TP->name(WEM)+" freundlich zu.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
