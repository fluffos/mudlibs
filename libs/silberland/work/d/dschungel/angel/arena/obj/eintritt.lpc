/******************************************************************************
 * Accessoire fuer die Arenatribuene in der Stadt der Ehre
 * Datei: eintritt.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "./def.h"

create()
{
  ::create();   

  SetProp(P_SHORT, "Eine Eintrittskarte");
  SetProp(P_LONG, 
    break_string("Dies ist eine Eintrittskarte fuer die Tribuene in der "+
    "Arena der Stadt der Ehre. Sie ist fuer eine Person gueltig.\n", 79));
  SetProp(P_NAME, "Eintrittskarte");
  SetProp(P_GENDER, FEMALE);
  AddId(({"eintrittskarte","karte","ticket", "\narena_eintrittskarte"}));
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 50);
}

mixed _query_noget()
{
  if(deep_present("\narena_eintrittskarte", this_player()))
    return "Du hast doch schon eine Eintrittskarte!\n";
  return 0;
}
