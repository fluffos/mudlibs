inherit "/std/thing.lpc";

#include <properties.h>
#include <moving.h>
#include "../def.h"


int arena_shout( string args )
{
   notify_fail ("Was moechtest Du im Namen der Arenaleitung sagen?\n");
   if ( !stringp (args) )
      return 0;
   
   "/d/pk/angel/arena/std/duell_channel_master"->Channel( this_player()->_unparsed_args() );
   return 1;
}

void create ()
{
   ::create();

   SetProp (P_NAME, "Mikrophon");
   SetProp (P_SHORT, "Ein Arenamikrophon");
   SetProp (P_LONG,  "Mit diesem Arenamikrophon kannst Du Duelle "+
                     "und Turniere in der Arena mit <ashout 'text'> kommentieren.");
   SetProp (P_AUTOLOADOBJ, 1);
   SetProp (P_NEVERDROP, 1);

   seteuid(getuid(this_object()));

   AddId( ({ "mikrophon", "mikrofon", "arenamikrophon", "arenamikrofon" }));

   AddCmd ( "ashout", "arena_shout" );
}

