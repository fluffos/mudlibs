/******************************************************************************
 * Truhe fuer Items aus der Arena in Neutijara
 * Datei: arena_box.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */
 
inherit "/obj/container";

#include <language.h>
#include <properties.h>
#include <container.h>
#include <defines.h>

void create()
{
  if (is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }
  	
   container::create();
   ::create();

   SetProp(P_MAX_WEIGHT, 10000000);

   SetProp(P_NOGET, "Diese Truhe ist viel zu gross fuer Dich!\n");
   
   SetProp(P_SHORT, "Eine riesige mysterioese Truhe.");
   
   SetProp(P_LONG, "Du siehst eine mysterioese Truhe mit "+
   "gigantischen Dimensionen. Es scheint ein magisches Leuchten "+
   "von ihr zu auszugehen.\n");
   
   SetProp(P_NAME, "Truhe");
   
   SetProp(P_GENDER, 2);
   
   AddId("truhe");
   
   AddDetail ( "leuchten", "Dir ist diese Truhe nicht ganz geheuer." );
   AddDetail ( ({ "magie", "sache" }) , "Es wird gemunkelt, dass alle Gegenstaende der in der Arena "+
               "Gefallenen, auf magischem Wege, hier hinein transportiert werden." );
   AddDetail ( ({ "gefallene", "gegenstaende" }), "Ueberlege es Dir gut bevor Du auch in der Truhe endest!" );
   AddDetail ( "dimensionen", "Diese Truhe ist wirklich unheimlich gross. Man munkelt, "+
               "dass ihr maechtige Magie innewohnt." );
   AddDetail ( ({ "weg", "wege" }), "Darueber weisst Du nichts, was Dir die Sache verstaendlich machen wuerde." );
}

