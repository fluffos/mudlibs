/******************************************************************************
 * Accessoire fuer die Arenatribuene in der Stadt der Ehre
 * Datei: fernglas.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "./def.h"

int spyglass_help(string args)
{
   tell_object(this_player(),
               "\nDie Kommandos fuer dieses Fernglas sind:\n"+
               "----------------------------------------\n"+
               "Um jemanden auf der Kampfflaeche zu betrachten:\n"+
               "<erspaehe name>\n"+
               "Um die Duelle der Arena genau zu verfolgen:\n"+
               "<blicke durch fernglas>\n"+
               "Um die Duelle nicht mehr zu verfolgen:\n"+
               "<beende verfolgung>\n\n" );
   return 1;
}

create()
{
  ::create();   

  SetProp(P_SHORT, "Ein kleines Fernglas");
  SetProp(P_LONG, 
    "Dies ist ein kleines goldenes Fernglas mit dem Du sicher "+
    "in einer Arena den Durchblick bewahrst, da es Dir ermoeglicht, "+
    "kleineste Details zu erspaehen!\nMit <fghilfe> erfaehrt man mehr "+
    "ueber dieses Fernglas.");
  SetProp(P_INFO, "Mit <fghilfe> erfaehrt man mehr ueber das Fernglas.\n");
                  
  SetProp(P_NAME, "Fernglas");
  SetProp(P_GENDER, NEUTER);
  AddId("fernglas");
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 500);

  AddCmd ("fghilfe", "spyglass_help");
  AddCmd ("erspaehe", "look_for");
  AddCmd ( ({"blicke", "blick"}), "receive_broadcast");
  AddCmd ( "beende", "block_broadcast"); 
}

// Beobachten eines Wesens auf der Kampfflaeche der Arena
int look_for (string args)
{
  object target;
  mixed test;
  
  // Haben wir ein Argument angegeben?
  if (!stringp(args))
  {
    notify_fail("Was moechtest Du mit Deinem Fernglas erspaehen?\n");
    return 0;
  }

  // Sind wir auf der Tribuene?
  if (test = regexp( ({file_name(environment(this_player()))}) , 
      TRIBUENE ))
     if (!sizeof(test))
     {
       notify_fail("Du befindest Dich Doch nicht auf der Tribuene!\n");
       return 0;
     }

  // Wir sehen nach ob sich unser gesuchtes Objekt auf der Kampfflaeche befindet:
  target = find_living (args);
  
  notify_fail ("Dieses Wesen kannst Du auf der Kampfflaeche nicht ausmachen!\n");
  
  if (!objectp(target))
  {
    return 0;
  }
  else
  {
    if (test = regexp( ({file_name(environment(target))}) , PKROOM "battle_field_" ))
       if (!sizeof(test))
          return 0;
  }

  // Also hier haben wir es gefunden!
  write(target->long()); 
  return 1;
}

// Verfolgung der Duelle auf der Kampfflaeche
int receive_broadcast (string args)
{
  object server;
  mixed test;
  string check;

  server = find_object ( PKOBJ "coordinator" );
  if (!objectp(server))
  {
    // Kein Duell Koordinator da!!! 
    notify_fail ("Mit den Linsen Deines Fernglases scheint etwas nicht in Ordnung zu sein!\n");
    return 0;
  }
  
  notify_fail ("Moechtest Du durch Dein Fernglas blicken?\n");
  
  // Haben wir ein Argument angegeben?
  if (!stringp(args))
  {
    
    return 0; 
  }

  // Sind wir auf der Tribuene?
  if (test = regexp( ({file_name(environment(this_player()))}) ,
      TRIBUENE ))
     if (!sizeof(test))
     {
       notify_fail("Du befindest Dich Doch nicht auf der Tribuene!\n");
       return 0;
     }
  if (sscanf (args, "durch fernglas%s", check) == 1)
  {
     server->link_into_system (this_object());
     return 1; // Fehlermeldung gibt's vom Server!
  }
  else
  {
     return 0;
  }
}

// Beenden der Verfolgung
int block_broadcast (string args)
{
  object server;
  mixed test;
  string check;

  server = find_object ( PKOBJ "coordinator" );
  if (!objectp(server))
  {
    // Kein Duell Koordinator da!!! 
    notify_fail ("Mit den Linsen Deines Fernglases scheint etwas nicht in Ordnung zu sein!\n");
    return 0;
  }

  notify_fail("Moechtest Du die Verfolgung der Duelle beenden?\n");

  // Haben wir ein Argument angegeben?
  if (!stringp(args))
  {
    return 0; 
  }

  // Sind wir auf der Tribuene?
  if (test = regexp( ({file_name(environment(this_player()))}) ,
      TRIBUENE ))
     if (!sizeof(test))
     {
       notify_fail("Du befindest Dich Doch nicht auf der Tribuene!\n");
       return 0;
     }
  if (sscanf (args, "verfolgung%s", check) == 1)
  {
     server->unlink_client (this_object());
     return 1; // Fehlermeldung gibt's vom Server!
  }
  else
  {
     return 0;
  }
}

