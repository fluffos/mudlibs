/******************************************************************************
 * Truhe fuer Items aus der Arena in Neutijara
 * Datei: arena_box.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "/obj/container";

#include <language.h>
#include <properties.h>
#include <container.h>
#include <defines.h>

void create()
{
  if (is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

   container::create();
   ::create();

   SetProp(P_MAX_WEIGHT, 1000000);

   SetProp(P_NOGET, "Diese Kiste kannst Du nicht mitnehmen!\n");

   SetProp(P_SHORT, "Eine einfache Kiste zum sicheren unterbringen der Gegenstaende.");

   SetProp(P_LONG, "Du siehst eine einfache, grosse Kiste "+
   "die hier in der Kabine aufgestellt wurde, damit Leute wie Du "+
   "Ihre Sachen sicher darin unterbringen koennen.\n");

   SetProp(P_NAME, "Kiste");

   SetProp(P_GENDER, 2);

   AddId("kiste");
}

