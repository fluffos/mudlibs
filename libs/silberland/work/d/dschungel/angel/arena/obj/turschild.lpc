#include "../def.h"

inherit "std/thing";


void create()
{
  if (!is_clone(TO))return;

  ::create();

  SetProp(P_SHORT, "Ein dickes Warnschild");
  SetProp(P_LONG,
    "Ein Schild, recht einfach zusammengezimmert. Du kannst es lesen.");

  SetProp(P_NAME, "Schild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schild", "warnschild"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 450);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET,"Das Schild steckt fest im Boden\n");

  AddCmd( ({"les","lese","lies"})      , "cmd_lesen");


}




int cmd_lesen(string str)
{
  notify_fail("Was moechtest Du lesen?\n");

  if(!str || str == "") return 0;
  if(!id(str))          return 0;



  TP->More(read_file("/d/dschungel/angel/arena/obj/schild.txt"));
  return 1;
}

