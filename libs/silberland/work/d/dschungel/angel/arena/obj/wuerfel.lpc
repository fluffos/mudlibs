inherit "/std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if(!is_clone(this_object()))
    return;

  ::create();
  AddId("wuerfel");
  SetProp(P_NAME,"Wuerfel");
  SetProp(P_GENDER,MALE);
  SetProp(P_SHORT,"Ein riesiger Wuerfel");
  SetProp(P_LONG,
      "Ein riesiger Wuerfel mit 100 Flaechen.\n");
  SetProp(P_VALUE,5);
  SetProp(P_WEIGHT,10000);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_NOGET, "Dieser Wuerfel ist viel zu schwer!");
  AddCmd(({"wuerfle"}), "wuerfle");
}

wuerfle(str)
{
  int zahl;
  zahl = random(100)+1;
  say(this_player()->name()+" wuerfelt die Zahl "+to_string(zahl)+".\n");
  write ("Du wirfst "+to_string(zahl)+".\n");
  return 1;
}