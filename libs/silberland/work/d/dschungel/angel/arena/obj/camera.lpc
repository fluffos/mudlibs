/******************************************************************************
 * System zur Weiterleitung des Gesagten und der Aktionen auf die Tribuene
 * Datei: camera.c
 * Autor: Angel (avs@sbox.tu-graz.ac.at)
 */

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "./def.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();   

  SetProp(P_SHORT, "Eine unsichtbare, magische Kamera.");

  SetProp(P_NAME, "Arena Camera" );

  SetProp(P_INVIS, 1);

  AddId("arena_camera");

  set_living_name ("arena_camera");

  SetProp(P_GENDER, FEMALE);

  create_default_npc( 1 );

  SetProp(P_RACE, "Kamera");

  SetProp(P_NOATTACK, 1);

}

int filter_string(string str)
{
   string test;
   object source;
   mixed text;
   
   text = explode (str, " ");
   if (!pointerp(text))
      return 0;

   source = find_living(lower_case(text[0]));
   if (objectp(source))
      test = source->name() +" "+source->QueryProp(P_MSGIN)+".\n";

   if (test == str)
      return 1;
   else
      return 0;
}

void catch_tell(string str)
{
  string test1, test2;

  if (!filter_string(str))
  {
    // Hier geben wir die Ausgaben an die Tribuene weiter!
    if (find_object( ROOM "tribuene_sw"))
       efun::tell_room ( ROOM "tribuene_sw", str);
    if (find_object( ROOM "tribuene_w"))
       efun::tell_room ( ROOM "tribuene_w", str);
    if (find_object( ROOM "tribuene_nw"))
       efun::tell_room ( ROOM "tribuene_nw", str);
    if (find_object( ROOM "tribuene_no"))
       efun::tell_room ( ROOM "tribuene_no", str);
    if (find_object( ROOM "tribuene_o"))
       efun::tell_room ( ROOM "tribuene_o", str);
    if (find_object( ROOM "tribuene_so"))
       efun::tell_room ( ROOM "tribuene_so", str);
  }

  return;
}

