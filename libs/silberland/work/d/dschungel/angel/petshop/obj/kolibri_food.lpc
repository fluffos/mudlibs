/********************************************************************
 * ITEM: Kolibrifutter                                              *
 * Datei: /d/dschungel/angel/petshop/obj/kolibri_food.c             *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Kolibrifutter" );
  SetProp( P_NAME, "Kolibrifutter" );

  SetProp( P_LONG, "Dieses Futter scheint genau auf die Beduerfnisse von Kolibris abgestimmt zu sein - "
                   "was immer das heissen mag! Dieser suesslich riechende Brei kann doch keinem Vogel schmecken, oder?" );

  SetProp( P_VALUE, 10 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( "brei", "Sieht sehr fluessig aus, lass lieber die Fingern davon.");
  AddDetail ( ({"beduerfnis", "beduerfnisse"}), "Da musst Du Dich wohl auf die Experten verlassen." );
  AddDetail ( ({"experte", "experten", "spezialfutter" }), "Nun dieses Spezialfutter hast Du doch von einem Experten erworben oder?" );

  SetProp(P_SMELL, "Dieser glibbrige Brei riecht suesslich.\n");

  AddId( ({"kolibrifutter", "futter"}) );
}