/********************************************************************
 * ITEM: Katzenfutter                                               *
 * Datei: /d/dschungel/angel/petshop/obj/cat_food.c                 *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Katzenfutter" );
  SetProp( P_NAME, "Katzenfutter" );
  SetProp( P_LONG, "Dieses Katzenfutter hast Du wohl in einer Tierhandlung erstanden. "+
                   "Sehr schmackhaft sieht es jedenfalls nicht aus mit all den sulzigen "+
                   "Fleischklumpen, jedoch bist Du eine Katze um das beurteilen zu koennen?" );

  SetProp( P_VALUE, 50 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( ({"klumpen", "fleischklumpen"}), "Du wuerdest sowas jedenfalls nicht essen wollen.");
  AddDetail ( "fleisch", "Um welches Fleisch es sich hier genau handelt weisst Du nicht, koennte alles sein.");

  SetProp(P_SMELL, "Das Katzenfutter riecht uebel.\n");

  AddId( ({"katzenfutter", "futter"}) );
}