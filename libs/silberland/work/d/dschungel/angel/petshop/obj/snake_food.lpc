/********************************************************************
 * ITEM: Schlangenfutter                                            *
 * Datei: /d/dschungel/angel/petshop/obj/snake_food.c               *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Schlangenfutter" );
  SetProp( P_NAME, "Schlangenfutter" );

  SetProp( P_LONG, "Dieses Schlangenfutter hast Du wohl in einer Tierhandlung erstanden. "+
                   "Sehr schmackhaft sieht es jedenfalls nicht aus, aeher wie Trockenfleisch, "+
                   "jedoch bist Du eine Schlange "+
                   "um das beurteilen zu koennen?" );

  SetProp( P_VALUE, 40 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( ({ "fleisch", "trockenfleisch" }), "Um welches Fleisch es sich hier genau handelt "+
                 "weisst Du nicht, koennte alles sein. Aber eins ist sicher: Es ist staubtrocken.");

  SetProp(P_SMELL, BS("Das Schlangenfutter riecht irgendwie so wie es aussieht - abgestanden, trocken - einfach scheusslich!"));

  AddId( ({"schlangenfutter", "futter"}) );
}