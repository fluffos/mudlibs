/********************************************************************
 * ITEM: Vogelfutter                                                *
 * Datei: /d/dschungel/angel/petshop/obj/bird_food.c                *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Vogelfutter" );
  SetProp( P_NAME, "Vogelfutter" );
  SetProp( P_LONG, "Eindeutig Vogelfutter, es besteht aus den verschiedensten Koernern und Samen. "
                   "Ueber die Qualitaet der Koerner kannst Du keine Aussage treffen." );

  SetProp( P_VALUE, 20 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( "qualitaet", "Wie schon vermutet kannst Du dazu nichts sagen.");
  AddDetail ( ({ "korn", "koerner", "same", "samen" }), BS("Koerner und Samen sollen "
            "ja angeblich gesund sein, aber Du laesst es besser nicht auf einen Test ankommen."));

  SetProp(P_SMELL, "Das Vogelfutter riecht nicht besonders gut oder schlecht.\n");

  AddId( ({"vogelfutter", "futter"}) );
}