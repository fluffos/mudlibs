/********************************************************************
 * NPC: Tierverkaeufer                                              *
 * Datei: /d/dschungel/angel/petshop/nps/halkyon.c                  *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

#include "../def.h"

inherit "/p/service/angel/haustiere/std_petshop_vendor";

create()
{
  ::create();
  SetProp( P_NAME, "Halkyon" );
  SetProp( P_ARTICLE, 0 );
  SetProp( P_RACE, "Mensch" );
  SetProp( P_SHORT, "Halkyon, der Haustierverkaeufer" );
  SetProp( P_LONG, "Vor Dir steht Halkyon, der Verkaeufer im Tierladen des Dschungels. "
                   "Er ist von kraeftiger Statur und vom Anschein her duerfte er auch "
                   "ein wenig Erfahrung in Schlaegereien haben." );

  SetProp( P_ALIGN, 200);

  create_default_npc (15);

  set_living_name("halkyon");
  enable_commands();

  SetChats(1, ({
    name()+" blickt Dich erwartungsvoll an.\n",
    name()+" fragt: Habt Ihr schon gewaehlt?\n",
    name()+" sagt: Ich habe hier die feinsten Haustiere im ganzen Dschungel!\n",
    name()+" fragt: Seid ihr wegen einem Haustier hier?\n",
    name()+" betreut die Haustiere in ihren Kaefigen.\n",
    name()+" seht Euch die Tafel an, ich habe die guenstigsten Preise im ganzen Dschungel\n" }) );

  AddDetail ( "statur", "Halkyon sieht relativ kraeftig aus.");
  AddDetail ( "anschein", "Nunja ein kraeftiger Kerl, mit dem koennte man sich schon eine nette Schlaegerei anfangen.");
  AddDetail ( ({ "erfahrung", "schlaegerei" }), "Alles reine Vermutungen.");

  AddInfo ( DEFAULT_INFO, "sagt: Dazu faellt mir im Moment nichts ein, tut mir leid." );
  AddInfo ( ({"haustier", "haustiere"}), "sagt: Ich verkaufe die feinsten Haustiere im Dschungel." );
  AddInfo ( "dschungel", "Der Dschungel beherbergt viele wilde Tiere, einige davon sind als Haustiere geeignet.", "sagt: " );
  AddInfo ( "tiere", "Je staerker das Tier, desto schwerer ist es zu zaehmen, darum sind auch die "
            "Prachtexemplare dieses Ladens beinahe unerschwinglich.", "sagt: " );
  AddInfo ( ({ "exemplare", "prachtexemplare" }), "Meine Koenigstiger sind wirkliche Prachtexemplare, "
               "aber Ihr sehr mir nicht unbedingt so reich aus diese Wahl in erwaegung zu ziehen.", "meint: " );
  AddInfo ( "wahl", "Waehlt einfach das Tier, das am besten zu Euch passt.", "meint: " );
  AddInfo ( ({ "preis", "preise" }), "Speziell die groesseren Tiere haben ihren Preis, und ich kann verstehen "
             "wenn Ihr nicht all das Geld auf einmal mitnehmen koennt. Dafuer gibt es hier im Laden Gutscheine.", "sagt: " );
  AddInfo ( ({ "gutschein", "gutscheine" }), "Mit Gutscheinen koennt Ihr Tiere kaufen, doch fuer Futter und Zubehoer nehme "
               "ich nur Muenzen.", "sagt: " );
  AddInfo ( "futter", "Wer sein Haustier fuettert, haelt es bei Laune, aber gebt ihm nicht zu viel auf einmal, sondern mehrere "
            "kleine Mahlzeiten.", "sagt: " );
  AddInfo ( "zubehoer", "meint: Ihr koennt alles was ihr braucht hier im Laden erwerben." );
  AddInfo ( "laden", "sagt: Ich bin der Verkaeufer in diesem Laden und stolz auf meine Arbeit." );
  AddInfo ( ({ "arbeit", "teil"}), "Ich verkaufe Haustiere und schaue auf ihr Wohlbefinden hier im Laden.", "sagt: " );
  AddInfo ( "verkaeufer", "sagt: Das Verkaufen von Haustieren ist nur ein Teil meiner Arbeit." );
  AddInfo ( "laune", "Die Loyalitaet des Haustieres ist wichtig, wenn man es nicht eines Tages verlieren will.", "sagt: " );
  AddInfo ( "loyalitaet", "Wenn Ihr Euer Haustier nicht nett behandelt, wird es Euch eines Tages verlassen.", "meint: " );


  SetAttackChats(5, ({
    name()+" schreit: Lasst mich in Ruhe Ihr Wuestling!\n",
    name()+" droht: Verschwindet, oder ich lasse die Tiger auf Euch los!\n",
    name()+" schreit: Hinfort mit Euch\n" }) );

  SetProp (P_SPELLRATE, 25);

  // Faustschlag:
  AddSpell(9, 400,
           name()+" schlaegt Dir mit der Faust in die Magengrube.\n",
           name()+" schlaegt @WEM mit der Fause in die Magengrube.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

  // So ein Stuhl am Kopf tut nicht gut:
  AddSpell(1, 750,
           name()+" zerbricht einen Stuhl an Deinem Kopf.\n",
           name()+" zerbricht einen Stuhl an @WESSEN Kopf.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

   AddId ("halkyon");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe)
  {
    case "fies":
      call_out("react", 0, "sagt: Lasst mich in Ruhe, "+TPN+"!", 0 );
      break;
    case "aergerlich":
      call_out("react", 0, "fragt: Was ist Euch ueber die Leber gelaufen, "+TPN+"?", 0);
      break;
    case "traurig":
      call_out("react", 0, "Das wird schon wieder, "+TPN+".", 0 );
      break;
    case "albern":
      call_out("react", 0, "grinst breit.", 0);
      break;
    case "neutral":
      call_out("react", 0, "grinst Dich an.", "grinst "+TP->name(WEN)+" an.");
      break;
    case "intim":
      call_out("react", 0, "nicht im Dienst, tut mir leid, "+TPN+".", 0 );
      break;
    case "froh":
      call_out("react", 0, "freut sich mit Dir.",
             "freut sich mit "+TP->name(WEM)+".");
      break;
    case "aengstlich":
      call_out("react", 0, "nur Mut, "+TPN+", kann gar nicht so schlimm sein!", 0 );
      break;
    case "frech":
      call_out("react", 0, "zwinkert Dir zu.", "zwinkert "+TP->name(WEM)+" zu.");
      break;
    case "nett":
      call_out("react", 0, "umarmt Dich.", "umarmt "+TP->name(WEN)+".");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void GiveIntroduction ()
{
   write ( "Halkyon gibt Dir noch ein kleines, goldenes Gloeckchen und meint:\n"+
         "Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste Tier vertraegt nicht alles.\n"
         "Solltet Ihr Futter oder Zubehoer suchen, koennt ihr alles noetige im Laden kaufen.\n" );
   say ( "Halkyon gibt "+this_player()->Name(WEM)+" noch ein kleines, goldenes Gloeckchen und meint:\n"+
         "Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste Tier vertraegt nicht alles.\n"
         "Solltet Ihr Futter oder Zubehoer suchen, koennt ihr alles noetige im Laden kaufen.\n", ({this_player()}) );
}