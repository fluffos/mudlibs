/********************************************************************
 * Raum: Tierhandlung im Dschungel                                  *
 * Datei: /d/dschungel/angel/petshop/room/petshop.c                 *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_petshop";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"
#include <laden.h>

int open_window ( string dummy )
{
   if ( member ( ({"fensterladen", "fensterlaeden", "fenster" }), dummy) != -1 )
   {
	  notify_fail ("Die Fensterlaeden sind doch schon offen!\n");
	  return 0;
   }
   notify_fail ("Was moechtest Du oeffnen?\n");
   return 0;
}

int close_window ( string dummy )
{
   if ( member ( ({"fensterladen", "fensterlaeden", "fenster" }), dummy) != -1 )
   {
	  notify_fail ("Dafuer ist es viel zu heiss!\n");
	  return 0;
   }

   notify_fail ("Was moechtest Du schliessen?\n");
   return 0;
}

string query_pet_sound ()
{
   return ({ "Das Bruellen eines Tigers.", "Das Schnurren eines Panthers.", "Das Schwirren eines Kolibris.",
             "Das Kraechzen eines Kakadus.", "Das Zischen einer Giftschlange.", "Das Schlaengeln einer Riesenschlange." })[random(6)]+"\n";
}

void create()
{
  ::create();

  seteuid(getuid(this_object()));
  
  // Laden-Konstanten:
  SetProp(P_SHOPKEEPER_NAME, "Halkyon" );
  SetProp(P_SHOPKEEPER_GENDER, MALE );
  catch(call_other(ROOM "pet_store", "???"));
  SetStorageRoom(ROOM "pet_store");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INT_SHORT, "Die Tierhandlung im Dschungel" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in der Tierhandlung des Dschungels. Dieser Laden ist "
    "beinahe gesteckt voll mit Tierkaefigen und Regalen und besitzt ausser "
    "dieser zweckgebundenen Einrichtung lediglich einen schlichten Tisch "
    "sowie einen Sessel, den Halkyon, der Verkaeufer im Laden, scheinbar "
    "selten bis nie benutzt, da er viel zu beschaeftigt ist all die Tiere "
    "rings herum zu versorgen. Zwei Oeffnungen in den Waenden dienen als "
    "Fenster. An den Tisch ist eine grosse Tafel gelehnt."
  );

  SetProp ( P_PET_KONFIG_TOOL, "/p/service/angel/haustiere/obj/glocke");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_TOWN]) );

  AddPet( "kolibri", "/p/service/angel/haustiere/npc/kolibri" );
  AddPet( "giftschlange", "/p/service/angel/haustiere/npc/schlange" );
  AddPet( "kakadu", "/p/service/angel/haustiere/npc/kakadu" );
  AddPet( "riesenschlange", "/p/service/angel/haustiere/npc/rschlange" );
  AddPet( "panther", "/p/service/angel/haustiere/npc/panther" );
  AddPet( "tiger", "/p/service/angel/haustiere/npc/tiger" );
  AddPet( "tigerin", "/p/service/angel/haustiere/npc/tigerin" );
//  AddPet( "loewenbaer", "/p/service/angel/haustiere/npc/loewenbaer.lpc" );
  
  AddReadDetail ( ({ "tafel", "preistafel" }), GetPriceList() );

  AddDetail ( "boden", "Der Boden besteht aus soliden Holzbohlen." );
  AddDetail ( "decke", "Die Decke besteht, wie auch Boden und Waende, aus soliden Holzbohlen." );
  AddDetail ( "holz", "Welches Holz das genau ist weisst Du leider nicht." );
  AddDetail ( ({ "bohlen", "holzbohlen" }), "Die Holzbohlen sehen sehr stabil aus." );
  AddDetail ( "dschungel", "Du befindest Dich mitten drin." );
  AddDetail ( "einrichtung", "Die Einrichtung hier ist relativ spaerlich: Ausser einem Tisch und einem "
              "Sessel stehen nur einige wenige Regale an den Waenden." );
  AddDetail ( ({ "regal", "regale" }), "Diese Regale dienen wohl der Aufbewahrung von Tierfutter und Zubehoer." );
  AddDetail ( ({ "tierfutter", "futter", "zubehoer" }), "Vielleicht moechtest Du ja davon etwas kaufen?" );
  AddDetail ( "aufbewahrung", "Diese Regale scheinen fuer die Aufbewahrung von Futter und Zubehoer gut geeignet." );
  AddDetail ( ({ "tierhandlung", "handlung", "laden" }), "Sieh Dich doch einfach weiter um." );
  AddDetail ( "halkyon", "Halkyon scheint nicht im Laden zu sein. Das ist fuer ihn aber gar nicht typisch ... "
              "ob ihm etwas zugestossen ist?" );
  AddDetail ( "verkaeufer", "Der Verkaeufer hier heisst Halkyon. Er kuemmert sich um die Haustiere und wuerde "
              "Dir sicher auch eines verkaufen solltest Du genuegend Geld besitzen." );
  AddDetail ( "sessel", "Auf diesem Sessel ruht sich Halkyon manchmal aus. Er besteht aus schlichtem Holz "
              "und ist einfach verarbeitet." );
  AddDetail ( "tafel", "Hier sind scheinbar die Preise der Haustiere notiert." );
  AddDetail ( ({"tiere", "haustiere"}), "Da liest Du am besten auf der Tafel nach." );
  AddDetail ( "tisch", "Wie auch der Sessel ist dieser Tisch aus schlichtem Holz und wurde einfach verarbeitet." );
  AddDetail ( ({ "preis", "preise" }), "Die Preise kannst Du der Tafel entnehmen, welche am Tisch lehnt." );
  AddDetail ( "tierkaefige", "An den Waenden stehen Kaefige in den verschiedensten Groessen." );
  AddDetail ( ({ "kaefige", "kaefig" }), "In diesen Kaefigen warten unzaehlige Tiere darauf von einer liebenswerten Person wie Dir "
              "zum Haustier gewaehlt zu werden." );
  AddDetail ( "tiere", "Eine Uebersicht aller Tiere findest Du auf der Tafel." );
  AddDetail ( "uebersicht", "Lies einfach die Tafel." );
  AddDetail ( "person", "Bist Du keine liebenswerte Person?" );
  AddDetail ( ({ "haustier", "tier", "tierchen" }), "Verdiene etwas Geld, dann kannst Du Dir auch eines leisten." );
  AddDetail ( "kaefig", "Du beneidest diese Tier nicht um ihr Los." );
  AddDetail ( "los", "Nun, eingesperrt zu sein in einen engen Kaefig." );
  AddDetail ( "geld", "Ja, davon braucht man schon jede Menge, um sich solch ein Tierchen zu kaufen." );
  AddDetail ( "menge", "Kommt darauf an welches Tierchen Du moechtest und wieviel Geld Du locker machen kannst." );
  AddDetail ( ({ "groessen", "groesse" }), "Jedes Tier hat einen Kaefig mit angemessener Groesse." );
  AddDetail ( ({ "wand", "waende" }), "Die Waende sind aus soliden Holzbohlen." );
  AddDetail ( "fenster", "Zwei unverglaste Oeffnungen in den Waenden dienen dem Laden als Fenster." );
  AddDetail ( "oeffnungen", "Die Oeffnungen haben zwar kein Glas, jedoch kann man sie mit Fensterlaeden verschliessen." );
  AddDetail ( "glas", "Wo siehst Du hier Glas?" );
  AddDetail ( ({ "fensterlaeden", "fensterladen" }), "Sie bestehen aus Holz. Sollte es einmal regnen wuerden sie wahrscheinlich geschlossen." );

  AddRoomMessage ( ({
    "RrrRRrrrrrRRrr!\n",
    "Fieeeep! Fieeeeeep!\n",
    "SsssSssssSsss!\n",
    "Chrrrchrrrchrrrr!\n" }), 15 );


  AddCmd ( "oeffne", "open_window");
  AddCmd ( "schliesse", "close_window");

  AddSmell ( DEFAULT_SMELL, "Hier riecht es nach den verschiedensten Tieren." );
  AddSmell ( "tiere", "Eingesperrte Tiere riechen nicht besonders angenehm." );

  AddSound ( DEFAULT_SOUND, "Du hoerst die verschiedensten Tierstimmen." );
  AddSound ( ({ "stimme", "stimmen", "tierstimme", "tierstimmen" }), #'query_pet_sound );

  AddItem ( NPC "halkyon", REFRESH_DESTRUCT );

  AddExit ("westen", ([ EX_DEST : "/d/dschungel/dante/tijaraneu/room/ti_pfad14",
                        EX_MSG  : "hinaus auf den Weg" ]) );
}

int sell(string str, int f)
{
  notify_fail ("Werter Besucher, hier kann leider nichts angekauft werden.\n");
  return 0;
}
