#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
inherit "std/thing";



create()
{
if (!is_clone(TO) )  return;

::create();

SetProp(P_SHORT, "Ein Daemonenkopf");
SetProp(P_LONG, BS(
"Diesen Kopf hat ein boeser Magier einst einem fast so boesen Daemon abgeschlagen, "
"auf dass der Daemon auf alle Ewigkeiten kopflos herumirren muss. Er blutet stark, "
"scheint Dich aber trotzdem irgendwie frech anzugrinsen."));
SP(P_INFO, "Hmm, vielleicht braucht ja der Daemon seinen Kopf...\n");
SetProp(P_NAME, "Daemonenkopf");
SetProp(P_GENDER, MALE);
AddId( ({"daemonenkopf", "kopf", "DKOPF"}) );

SetProp(P_MATERIAL, MAT_MISC_DEAD );
SetProp(P_WEIGHT, 50);
SetProp(P_VALUE, 3000);
SetProp(P_NOBUY, 1);
}
