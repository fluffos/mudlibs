/*
**
** vc fuer die wurstquest...
*/

inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

#define P_VALID_NAME "valid_name"



create()
{
  ::create();
  SetProp(P_COMPILER_PATH, "/d/dschungel/dante/wurstquest/" );
  SetProp(P_STD_OBJECT, "/d/dschungel/dante/wurstquest/hwurst");
  SetProp(P_VALID_NAME, ({"bude"}) );
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, "/d/dschungel/dante/wurstquest/"+name);
    return file;
  }
}


int CustomizeObject()
{
  string name,foo, who;
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d",foo,who)!=2)
    return 0;
  return 1;
}



