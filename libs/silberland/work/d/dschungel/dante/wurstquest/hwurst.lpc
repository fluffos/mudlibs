/* hans wurst. hier beginnt die wurstquest
   dante sl 20000
   
*/
   
   

inherit "std/mnpc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>


#define QUESTKEY "Der unheimliche Wuerstchenjob"
#define TIME  1 // 5+random(5) //nur zum testen

object cash;
int oldcash;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der schmaechtige Hanswurst");
  SetProp(P_LONG, BS (
"Das ist Hanswurst. Warum er so heisst ist nicht ganz klar, aber "
 "er steht irgendwie im Zusammenhang mit 'Lars Geisterwuerstelbude'. "
 "Hans ist sehr schmaechtig und eher klein. Einen Kampf koennte er nicht "
 "lange ueberstehen und er waere sicher ein leichtes Opfer fuer Dich. "
"Achja, Hans gehoert zur Rasse der Hobbits, diesen stinkenden Fellmonstern..."));


set_living_name("hanswurst");



	
  SP(P_ARTICLE, 1);
  SetProp(P_NAME,  "Hanswurst");

SP(P_NAME_ADJ, "schmaechtig");

  SetProp(P_GENDER, MALE);
  SP(P_RACE, "Hobbit");
  AddId(({"wurst","hans", "hobbit", "hanswurst", "\hans_wurst"}));
  create_default_npc(1 );
  SetProp(P_HANDS, ({" mit seinen schwachen Haenden", 33, DT_BLUDGEON}));
  SetProp(P_BODY,25);
  SetProp(P_SIZE, 120+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, " sagt: Eines ist klar! Wurst ist gesund!\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Hanswurst grinst Dich an und behaelt @WEN.\n"}));

  SetProp(P_MSGIN, "spaziert singend herein");
  SetProp(P_MSGOUT, "spaziert dumm guckend");
  SetProp(P_MMSGIN, "kommt dumm guckend herein");
  SetProp(P_MMSGOUT, "sagt: Adios Embrios!");
  
   SetProp(P_MNPC_AREA, ("/"));
   SetProp(P_MNPC_FLAGS,MOV_OUTDOORS + MOV_INDOORS+MOV_MOVES+
   MOV_BACKWARDS+MOV_SPECIAL);
   SetProp(P_MNPC_WAIT, ({1, 20, 20}));
   SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/feyaria/tijara/room/platz_d5");


    AI("dante",
    "Der Arsch hat mich gemacht!", "sagt: ");
          
          AI(({"wurst","wuerste"}),
          "Wuerste sind sehr lecker! Doch mein Geld ist noch "
          "viel besser!", "sagt: ");
          
          AI(({"geld","muenze","muenzen"}),
          "Nur ueber meine Leiche! Los komm!", "bruellt: ");
          
          AI("lars",
          "HIHI! Davon weiss ich nichts Du Wurst!", "grinst: ");
          
  
   SUID;                                                                                                                        
cash=clone_object("/obj/money");
cash->SetProp(P_AMOUNT, 10000);
cash->move(TO, M_GET);
oldcash=cash->QP(P_AMOUNT);


 SetChats(5, ({
  "Hanswurst sagt: Ich bin eine Wurst, genau wie Du auch!\n"
  "Hanswurst sagt: Kennst Du Lars?!\n"
  "Hanswurst sagt: Ich habe sehr viel Geld!\n",
  "Hanswurst sagt: Ich bin reicher als DU!!!\n",
  "Hanswurst sagt: Willst Du mein Geld, musst Du mich toeten!\n",
  "Hanswurst sagt: Geld reicht besser als Wurst!\n",
  "Hanswurst sagt: Hmm, kennst Du Wurst?!\n",
  "Hanswurst huepft um Dich herum.\n",
  "Hanswurst springt herum.\n",
  "Hanswurst sagt: Wurst! Eine Philosophie fuer sich!\n",
  "Hanswurst sagt: Dante liebt Wuerste!\n"
    }));
    
    
  }



   

  init(){
    ::init();
      
      if(interactive(TP)){
      	oldcash=cash->QP(P_AMOUNT);
      	cash->SP(P_AMOUNT, oldcash+100);
      call_out("hallo", 0); } }
      
      
      
      
      hallo()   {
      if(environment(TO)!=environment(TP))  { return ;}

if(TP->QueryQuest(QUESTKEY))  {

write(BSA(
"Hallo "+TPN+"! Na, Dich haben Lars und ich ja ganz schoen verarscht?!",
"Hanswurst lacht: "));
return;  }


if(deep_present("DANTE_WURST_QUEST", TP))  {

write(BSA(
"Hallo "+TPN+"! HE! Du solltest ja in Lars Wuerstelbude arbeiten! Los hin mit Dir!",
"Hanswurst sagt: "));

return;
}

      
write(BSA(
"Hallo "+TPN+"! Auch auf der Suche nach einer Wurst?!",
"Hanswurst sagt: "));


      }   






  void trans_sl()
   {
   switch(random(10))
     {
     case 0:
     TO->move("d/dschungel/feyaria/dorf/room/weg3", M_TPORT);
     break;
     case 1: 
     TO->move("/d/gebirge/speedy/trollager/room/t6", M_TPORT);
     break;
     case 2:
     TO->move("/d/ebene/zordan/ogerhoehle/room/room_e3", M_TPORT);
     break;
     case 3:
     TO->move("/d/ebene/lamuerte/wwald/room/12y_25x", M_TPORT);
     break;
     case 4:
     TO->move("/d/gebirge/dusty/weg/l27", M_TPORT);
     break;
     case 5:
     TO->move("/d/polar/lamuerte/dorf/rooms/steg", M_TPORT);
     break;
     case 6:
       TO->move("/d/huegelland/raballion/hobbits/room/nordtor", M_TPORT);
     break;
     case 7:
     TO->move("/d/kristallwald/sargola/wald/room/1002", M_TPORT);
     break;
     
       case 8:
     TO->move("/d/gebirge/dante/friedhof/room/pfad1", M_TPORT);
     break;
       case 9:
     TO->move("/d/unterwelt/dante/skel/portal", M_TPORT);
     break;
     
     default: TO->move("/gilden/abenteurer", M_TPORT);
     }
   }  
  
  
  
  reset()
  {
  
  ::reset();
  oldcash=cash->QP(P_AMOUNT);
  cash->SP(P_AMOUNT, oldcash+1000);
  if(!random(2))  {
  call_out("trans_sl", 0);  }
  
  }


 catch_tell(string str)
    {
            string dum1,dum2,dum3;
      if(sscanf(str,"%s teilt Dir mit: %s",dum1,dum2))   
      { call_out("back",2,dum1,dum2);}
                        }

   back(string dum1,string dum2)
     {  string dum3;
        object ob;
   object env;
   string *path;
   string ans;               
 dum3=explode(dum1," ");
   dum3=dum3[sizeof(dum3)-1];
  ob=find_player(lower_case(dum3));
             
    if(strstr(dum2,"wo bist du")!=-1 || strstr(dum2,"Wo bist du")!=-1)
  {
    if (!(env=environment()))
        return;
 path=explode(file_name(env),"/");      
  if (path[0]=="d")
     {
         switch(path[1])
             {
    case "dschungel":
     case "gebirge":
    case "kristallwald":
   case "huegelland":  
      ans="im "+capitalize(path[1]);        
      break;
         case "polar":
     ans="im Polargebiet";
     break;
   case "wasser":
           ans="am Wasser";
      break;
     case "ebene":
    switch(path[2])
    {
    case "Gaffos":
       ans="bei den Gaffos";
  break;
  case "Silberwald":
     case "Park":
   ans="im "+path[2];  
   break;
      case "Midas":
     ans="in Midas";
       break;
       default:
     ans="in der Ebene";
    } 
     break;
    case "wueste":
     case "tundra":
       case "unterwelt":
     ans="in der "+capitalize(path[1]);
    break;
     case "wahnsinn":
      ans="in einer verrueckten Umgebung";
             break;
     default:
             ans="werweisswo ..";
      }
          ans="Ich bin "+ans+"";
            }
 if (path[0]=="players")
  ans="Ich hab mich verlaufen - ich schaetze, "+capitalize(path[1])+
  " hat was damit zu tun ...\n";               
 if (path[0]=="gilden")
     ans="Ich bin in einer Gilde.\n";
         
  tell_object(ob,
  "Hanswurst teilt dir mit: Verfluchte Wurst! "+ans+"! Wurst, verfluchte!\n");
  }
  
  else
  {
     tell_object(ob,
     "Hanswurst teilt Dir mit: Hmm, willst Du wissen wo ich bin?!\n");
      }
}       
               





 Defend(int dam, string dtype, int spell, object enemy)  {

if(enemy->QP(P_GHOST))  {
	  enemy->StopHuntFor(ME);
          StopHuntFor(enemy);
    tell_object(enemy,
    "Hanswurst sagt: Du dummer Geist! Hau ab!\n");
       return ::Defend(0, dtype, spell, enemy);      
        }


    if(enemy->deep_present("DANTE_WURST_QUEST"))  {
       tell_object(enemy,
     "Hanswurst sagt: Was willst Du Idiot denn noch von mir?!\n");
      enemy->StopHuntFor(ME);
          StopHuntFor(enemy);
           return ::Defend(0, dtype, spell, enemy);    	
     }

 tell_object(enemy,
 "Hanswurst sagt: Lass mich und mein Geld zufrieden!!!\n");

     return ::Defend(dam, dtype, spell, enemy);    }    
   
   



    die(arg)  {
       if(TP->deep_present("DANTE_WURST_QUEST"))  {
       write(BSA(
     "Was willst Du Idiot denn noch von mir?! HAEH! Hau ab zu Lars!",
     "Hanswurst bruellt: "));
     heal_self(300);
     return 0;
     }

      write(BSA(
      "Du dummer kleiner Narr! Dachtest Du kannst mich umbringen!!!!",
      "Hanswurst lacht: "));
      call_out("lars_holt_dich", TIME );
      heal_self(300);
   write("\n");
   write("Irgendetwas seltsames geht hier vor sich!!!\n");
   write("\n");
   
   
      return 0; }
      

      
lars_holt_dich()   {
 object ob;
 object enemy;
 enemy=TP;
 
  
 ob=find_living(""+getuid(enemy)+"");
 
 if(!ob) return;
 
 if(ob)  {
 
  
  write(BSA(
  "Du kleiner mieser Wurm "+TPN+"! Deine Geldgier hat Dir nun kostenlose "
  "Frondienste in meiner Geisterwuerstelbude eingebracht! Du musst "	   "solange bei mir dienen, bis ich mit Deiner Arbeit zufrieden bin! "
  "Und glaube mir, die Toten sind keine angenehmen Kunden! HAHAHA!",
  "Lars teilt Dir mit: "));
  

tell_room(environment(ob),
CAP_TPN+" erschrickt ploetzlich. Der Tod persoenlich scheint mit "
""+TP->QueryPronoun(WEM)+" zu sprechen!\n", ({ob}));

write("\n");
  call_out("ab_in_die_bude", TIME, getuid(TP) );
        }
    }
    	      
      
      ab_in_die_bude()     {
       object ob;
  
 ob=find_living( ""+getuid(TP)+"" );
 
 if(!ob) return;
 
 if(ob)  {
 
 
 write(BSA(
 "Mach Dich bereit in das Reich der Toten geholt zu werden!",
 "Lars teilt Dir mit: "));
 
 write(BS(
 "Ploetzlich schwinden Dir die Sinne und Du merkst wie Du langsam stirbst!"));
 
 
 tell_room(environment(ob),
 CAP_TPN+" scheint langsam dahin zu sterben! Lars will "+TP->QueryPronoun(WEN)+"" " zu sich holen!\n", ({ob}));
   
   call_out("nun_aber_echt", 8);
   
  
 write("\n");
     }
 }
       
          
      
nun_aber_echt()   {
 object ob, questob;
 
  
 ob=find_living(""+getuid(TP)+"");
 
 if(!ob) return;
 
 
 if(ob)  {
 
 if(!deep_present("DANTE_WURST_QUEST"))  {
  questob=clone_object("/d/dschungel/dante/wurstquest/questobj");
 questob->move(TP, M_NOCHECK);	
}
//jaja paranoia alles absichern 34 mal;-))

 write(BS(
 "Lars kommt vorbei und nimmt Dich mit ins Reich der Toten!"));
 
          
   ob->move("/d/dschungel/dante/wurstquest/bude:"+getuid(TP)+"",
  M_GO+M_NOCHECK, 
  "ploetzlich vom Tod hier abgeholt und mitgenommen", "wird",
  "kommt an");
  previous_object()->CustomizeObject();   
 ob->SP(P_GHOST, 1);
   
   
     }
 }
 