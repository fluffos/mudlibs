/*
die wuerstelbude von lars...
hier kommen nur tote vorbei
dante sl 2000
*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

#define WARNUNG (member(warnung, getuid(this_player()))!=-1)
 string *warnung=({});
 
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Wuerstelbude vom Lars im Reich der Toten" );
  SetProp( P_INT_LONG, BS(
  " Ein Schacht scheint schraeg durch den Boden nach unten zu fuehren. "));
  

  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );

 
  AddSound( DEFAULT_SOUND,
    "Im Reich der Toten ist es sehr still!");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht in der Wuerstelbude nach Oel, Brot, Senf und natuerlich "
    "nach Wuersten aller Art.");
    
AddSmell("oel",
"Das Oel ist alt, man sollte es austauschen!");

AddSmell("brot",
"Das Brot riecht gut!");
AddSmell("senf",
"Senf riecht meistens wuerzig.");
AddSmell(({"wuerste","wuersten","wurst"}),
"Sie riechen wirklich lecker!!!");

previous_object()->CustomizeObject();          


AddSpecialExit("leben", "check");

}

check()   {
object ob;
ob=deep_present("DANTE_WURST_QUEST");

if(!WARNUNG)  {
  write(BSA(
  "Wenn Du einfach abhaust, ohne alles erledigt zu haben! Musst Du von ganz "
  "vorne beginnen!",
  "Lars teilt Dir mit: "));
  
 warnung += ({getuid(this_player())});   
 return 1; }
 
 if(WARNUNG)  {
  
  write(BSA(
  "Wie Du willst! Hau ab! Aber dann war alles umsonst!",
  "Lars teilt Dir mit: "));
  warnung -= ({getuid(this_player())});   

         
         if(ob)  {
	ob->remove();
                 }
     
     
     TPM("/d/ebene/Midas/room/kapelle", M_GO+M_NOCHECK,
     "vom Tod hier hergebracht.\nDer Tod grinst und ist dann verschwunden", "wird",
     "");
      
      
      return 1; 
       }
   }



init()  {
  ::init();
          if(interactive(TP))  {
  	if(!IS_WIZARD(TP))  {
      if(!deep_present("DANTE_WURST_QUEST", TP)) {
     TPM("gilden/abenteurer", M_SILENT+M_NOCHECK);
     }
    }
   }	
  }	