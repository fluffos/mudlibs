// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Der Schatz des Erdbebendaemons");
  SetProp(P_LONG, BS( 
    "Der Schatz des Erdbebendaemons ist eigentlich nur ein riesengrosser, "
    "brauner Diamant. Wahrscheinlich gefaellt ihm die Farbe gut..."));
  SetProp(P_INFO, "Der Diamant ist sehr viel wert.\n");
  SetProp(P_NAME, "Erdbebendaemonschatz");
  SetProp(P_GENDER, MALE);
  AddId(({"erdbebendaemonschatz","diamant","schatz"}));

  SetProp(P_MATERIAL, ({MAT_JEWEL}));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 4000+random(500));
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NODROP, 0);
}
