/*
** schlueysel fuer tuer/erde
** 
** 2. 4 97 dante
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../files.h"


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein kleiner, rostiger Eisenschluessel");
  SetProp (P_LONG, BS(
               "Der Schluesel besteht aus Eisen, das schon ziemlich rostig ist. "  
               "Er liegt schwer in der Hand und weisst kleine Einkerbungen auf."));
         AddDetail(({"einkerbung","einkerbungen"}),
         "Wo mag wohl das passende Schloss dazu sein...");
  SetProp (P_NAME, "Eisenschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  AddId (({"eisenschluessel", "schluessel"}));
  
SetProp(P_MATERIAL, MAT_IRON);
}
string QueryDoorKey()
{
return ("/d/dschungel/dante/erde/room/tuer")+":"+("/d/dschungel/dante/erde/room/tuer2");
}











