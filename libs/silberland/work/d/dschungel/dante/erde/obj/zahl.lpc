// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Zahl");
  SetProp(P_LONG, BS( 
    "Vor Dir hast Du die Zahl acht."));
  SetProp(P_INFO, "Welchen Sinn hat diese Zahl nur... ");
  SetProp(P_NAME, "Zahl");
  SetProp(P_GENDER, FEMALE);
  AddId("zahl");

  SetProp(P_MATERIAL, (MAT_MAGIC));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 0);
}
