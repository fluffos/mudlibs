// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine alte Maulwurfskralle");
  SetProp(P_LONG, BS( 
    "Diese Maulwurfskralle ist schon alt und zerkratzt, aber scheinbar gefaellt "
    "sie dem Erdgeist so gut, dass er sie haben will..."));
  SetProp(P_NAME, "Maulwurfskralle");
  SetProp(P_GENDER, FEMALE);
  AddId(({"maulwurfskralle","kralle"}));

  SetProp(P_MATERIAL, ({MAT_HORN}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
}
