/*
** Steinpilz
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Pekingente");
  SetProp (P_LONG, "Eine herrlich duftende Pekingente mit knuspriger Haut.");
  SetProp (P_NAME, "Pekingente");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_VALUE, 300);
  SetProp (P_WEIGHT, 200);
  SetProp(P_SIZE, 40);
  SetProp (P_NOBUY, 1);
  SetProp(P_INFO, ("Diese Pekingente schmeckt einfach herrlich"));
  AddId (({"pekingente","ente"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 20, F_SOAK: 6, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
write ("Du isst die ganze Pekingente mit lautem Schmatzen und Sabbern.\n");
say (""+TPN+" isst die Pekingente mit lautem Schmatzen und Sabbern.\n");
return ::BeimEssen();
}
