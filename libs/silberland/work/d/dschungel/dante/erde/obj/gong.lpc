
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein kleiner Gong");
  SetProp(P_LONG, BS( 
    "Der Gong ist aus einem Dir unbekanntem Metall gefertig. Welchen Sinn der wohl hat."));
    
  SetProp(P_INFO, "Wozu ist ein Gong wohl da ?");
  SetProp(P_NAME, "Gong");
  SetProp(P_GENDER, MALE);
  AddId("gong");

  SetProp(P_MATERIAL, ({MAT_METAL, MAT_MAGIC}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  
  AddCmd(({"schlage","schlag"}), "ton");
}

 int ton (string str)
 {
 notify_fail("Worauf oder was willst Du schlagen ?\n");
 
 if (!str)
 return 0;
 
 if (member (({"auf gong", "gong"}), str ) !=-1 )
 {
 write("Du schlaegst auf den Gong und erzeugst einen wundersamen Ton, "
 "der langsam verhallt...\n");
 say(""+TPN+" schlaegt auf den Gong und erzeugt einen wundersamen Ton, "
 "der langsam verhallt...\n");
 return 1;
  }
  return 0;
 }
 
