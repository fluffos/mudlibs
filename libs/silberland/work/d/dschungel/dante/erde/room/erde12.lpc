// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";
#include <moving.h>
#include <properties.h>
#include <language.h>
nosave int essen;
create()
{
  ::create();
  essen = 1;

  AddDetail(({"pfuetze","pfuetzen"}),
      "Neben einer der Pfuetzen siehst Du einen kleinen, gelben Knopf.");
  AddDetail(("knopf"),
      "Am Knopf steht ein Text.");
  AddDetail(("text"),
      "Du kannst den Text lesen.");
  AddReadDetail(("text"),
      "'Fuer Pekingenten mache ich fast alles!' Zitat C.N. \n");
  AddDetail(("decke"),
      "In der Decke siehst Du eine kleine Klappe...");
  AddDetail(("klappe"),
      "Aus der Klappe stroemt ein herrlicher Duft. Wie man sie wohl aufbekommt...");
  AddDetail(("duft"),
      "Hmm, Dir laeuft das Wasser im Munde zusammen.");


  AddSmell( ({DEFAULT_SMELL, "duft", "pekingente"}),
      "Hier riecht es herrlich nach Pekingente.");

  AddCmd(({"druecke","drueck"}), "open");

  AddItem( ({NPC"kroete", NPC"erd"}), REFRESH_DESTRUCT);

  AddExit("sueden", "./erde11");
}

reset()
{
  essen = 1;
  ::reset();
}


open ( string str)
{object ob;
  notify_fail("Was willst Du hier druecken ?\n");
  if ( !str = "knopf")
    return 0;


  if ( !essen )
  {
    write ( " \n"
        "Du drueckst auf den Knopf und ploetzlich oeffnet sich die Klappe ober Dir ..\n");
    say(CAP_TPN+" drueckt auf einen Knopf und eine Klappe oeffnet sich...\n");
    ob= clone_object("/d/dschungel/dante/erde/npc/erdskorpion.lpc");
    ob->move(environment(TP), M_SILENT + M_TPORT);
    return 1;
  }
  if ( str == "knopf")
  {
    write( " \n"
        "Du drueckst auf den Knopf und eine herrlich, knusprige Pekingente faellt genau "
        "in Deine Arme...\n");
    say(CAP_TPN+" drueckt auf einen Knopf und eine Klappe oeffnet sich...\n");
    CLONE(OBJ"ente", TP);
    essen--;
    return 1;
  }
  return 0;
}


