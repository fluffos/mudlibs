#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

AddDetail(("decke"),
"In der Decke siehst Du eine Oeffnung...");
AddDetail(("oeffnung"),
"Durch die Oeffnung in der Decke kommst Du nach oben...");
    
  AddItem(NPC"ferdg",REFRESH_DESTRUCT);                                                    
  AddItem( ({NPC"erd", NPC "mops", NPC_HOEHLE "dfledermaus"}), REFRESH_DESTRUCT);
  
  AddExit("westen", "./erde6");
  AddExit("oben",  "./erde4");
  AddExit("osten", "./erde8");
  AddExit("norden","./erde7");
  AddExit("sueden", "./erde9");
  
  }
  
