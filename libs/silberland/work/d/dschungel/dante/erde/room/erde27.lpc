// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>

#define AD AddDetail
create()
{
  ::create();
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich in einem dunklem Gang. Am Boden steht etwas Wasser, "
        "dass von den Waenden in kleinen Stroemen nach unten fliesst. Die Erde "
        "hier scheint locker zu sein. Die kleinen Stroeme formen sich hier zu "
        "einem Wasserfall der in einem grossen Loch im Boden irgendwohin "
        "weiter fliesst. Spuren fuehren direkt zu dem Loch."));

  AD("loch",
      "Das Loch ist recht gross, Du wuerdest sicher hineinpassen, wenn Du "
      "ueberhaupt mutig genug bist.");
  AD(({"spur","spuren"}),
      "Die Spuren fuehren direkt zum Loch. Das erregt Deine Neugier.");
  AD("neugier",
      "Man kann in das Loch sicher hineinspringen.");
  AD(({"wasserfall","fall"}),
      "Der Wasserfall entsteht hier und verschwindet auch sofort wieder in dem "
      "Loch im Boden. AH! Da steckt in einer Wand ein Zahn!");
  AD("zahn",
      "Der Zahn steckt verdammt fest in der Wand. Es ist ein Zahn eines "
      "Unterwasserdrachens.");
  AD(({"drachen","unterwasserdrachen","drachens","unterwasserdrachens"}),
      "Hmm, ob sie dort unten wohnen?!");


  AddDetail(("decke"),
      "An der Decke siehst Du ein Gekritzel...");
  AddDetail(("gekritzel"),
      "Du kannst es lesen.");
  AddReadDetail(("gekritzel"),
      "Wer dies liest ist doof!");

  AddItem( ({NPC"gnom", NPC "kroete"}),REFRESH_DESTRUCT);

  AddExit( "norden", "./erde26" );
  AddCmd(({"spring","springe","springen"}), "go_down");
}

int go_down(string str)  {
  notify_fail("Wo willst Du hinein springen!\n");
  if(str=="in loch"||str=="ins loch"||str=="runter"||str=="hinunter"||
      str=="in loch runter"||str=="ins loch hinunter"||str=="in loch hinein"||
      str=="ins loch hinein")  {

    if(present("gnom", TO))  {
      say(BS( CAP_TPN+" wird von einem Gnom festgehalten!"));
      write(BS( "Der Gnom sagt: STOP!"));
      return 1;  
    }

    write(BS("Im letzten Moment ueberlegst Du es Dir doch anders, weil "
	"Du die innere Erleuchtung hast, dass das Gebiet dahinter noch "
	"nicht fertig programmiert ist."));
/*
    write(BS( "Mutig springst Du durch das Loch in den Wasserfall."));
    TP->move("d/dschungel/dante/erde/room/droom1", M_GO,
        "in den Wasserfall","springt","kommt von oben herabgesprungen");
*/
    return 1;  
  }
  return 0; 
}

