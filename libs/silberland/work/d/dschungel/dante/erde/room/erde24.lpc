
// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{
  ::create();

  AddDetail(({"loch","loecher"}),
      "Eines der Loecher erinnert an Dich an Emmentalerkaese...");
  AddDetail(("kaese"),
      "Du meinst Emmentalerkaese, oder ?\n");
  AddDetail(({"emmentaler","emmentalerkaese"}),
      "Eigentlich waren es ja nur die Loecher, die diese dumme Assoziation "
      "hervorgerufen haben..");
  AddDetail(("assoziation"),
      "Ploetzlich sieht ein Huegel am Boden wie eine Gugelhupf aus, und "
      "das Relief der Wand wie ein Picasso...");
  AddDetail(("huegel"),
      "Naja, so aehnlich ist er einem Gugelhupf auch wieder nicht...");
  AddDetail(("gugelhupf"),
      "Hmm, Dir rinnt das Wasser im Munde zusammen...");
  AddDetail(({"mund","munde"}),
      "Schliess Deinen Mund bitte.");
  AddDetail(("relief"),
      "Man erkennt eine zerrinnede Uhr, die wohl die Vergaenglichkeit der Zeit "
      "und allen Lebens ueberhaupt symbolisieren soll...");
  AddDetail(("vergaenglichkeit"),
      "Du denkst . o O (Staub zu Staub, Asche zu Asche)");
  AddDetail(("uhr"),
      "Die Uhr scheint dahinzuschmelzen. Sowohl der grosse, als auch der kleine "
      "Zeiger stehen auf zwoelf Uhr...");
  AddDetail(("leben"),
      "Das Leben koennte hier bald vorbei sein...");
  AddDetail(("zeiger"),
      "Die Uhr hat einen grossen und einen kleinen Zeiger.");
  AddDetail(("zeit"),
      "Wird es fuer Dich nicht Zeit wieder an die Realitaet zu denken ?");
  AddDetail(("realitaet"),
      "Gibts es eine andere Realitaet ausser dem Mud ?");
  AddDetail(("mud"),
      "Englisch fuer Schlamm, Dreck...");
  AddDetail(("picasso"),
      "Hmm, nach gruendlichem Ueberlegen sieht es eher nach einem Bild von "
      "Salvatore Dali aus."); 
  AddDetail( ({"dali", "salvatore", "salvatore dali"}),
      "Auch so ein verrueckter Maler...");
  AddDetail( ({"maler"}),
      "Leute wie Picasso oder Dali....");
  AddDetail( ({"grosser zeiger", "grossen zeiger"}) ,
      "Der grosse Zeiger kommt Dir irgendwie seltsam vor...");
  AddDetail( ({"kleiner zeiger", "kleinen zeiger"}),
      "Hmm, der kleine Zeiger klemmt fest..."); 

  AddItem( ({NPC_WEG"dratte", NPC_HOEHLE "dfledermaus"}), REFRESH_DESTRUCT);

  AddCmd(({"schiebe","schieb"}), "get");
  AddExit( "raus", "./erde23" );
}

int  get (string str)
{
  string zahl;
  notify_fail("Was willst Du hier wohin schieben ?\n"
      "syntax: <schiebe grossen zeiger auf XXX >\n");
  if (!str) return 0;
  if( sscanf( str, "grossen zeiger auf %s",zahl)!=1 ) return 0;
  if ( zahl == "eins" || zahl == "1" )
  {
    write(" \n"
        "Du schiebst den grossen Zeiger auf eins...\n"
        "Ploetzlich beginnt sich eine verborgene Drehtuer zu bewegen und reisst Dich \n"
        "irgendwo anders hin...\n");
    TP->move("/d/dschungel/dante/erde/room/erde25" ,M_NO_SHOW + M_GO,
        "ploetzlich von einer verborgenen Drehtuer weggeschleudert", "wird",
        "wird in den Raum geschleudert");
    TP->reduce_hit_points(5);
    return 1;
  }
  notify_fail("Du machst Dich am Zeiger zu schaffen, aber nichts passiert...\n");
  return 0;
}  

