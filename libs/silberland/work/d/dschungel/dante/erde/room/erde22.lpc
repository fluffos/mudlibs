// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";
#include <moving.h>
#include <properties.h>
#include <language.h>

int erdgeist=1;

create()
{
  ::create();

  AddDetail(("decke"),
      "Von der Decke haengt ein grosser langer Felsbrocken herab.");
  AddDetail(({"fels","brocken","felsbrocken"}),
      "Der Felsbrocken haengt sehr weit oben, Du kannst ihn sicher nicht erreichen. "
      "Er hat eine merkwuerdige Form.");
  AddDetail(("form"),
      "Die Form erinnert Dich an ein Musikinstrument...");
  AddDetail(("instrument"),
      "Du meinst ein chirurgisches Instrument oder ein Musikinstrument...");
  AddDetail(("musikinstrument"),
      "Eher schaut der Brocken schon wie ein Schlegel aus...");
  AddDetail(("schlegel"),
      "Der grosse Schlegel haengt aber von der Decke herab, also kann man ihn wohl "
      "nicht wie einen normalen Schlegel verwenden, aber vielleicht kann man etwas "
      "darauf werfen.");

  AddSound( DEFAULT_SOUND,
      "Du glaubst das Murmeln eines Erdgeistes zu hoeren...");

  AddSmell( DEFAULT_SMELL,
      "Hier riecht es nach Erdgeistern...");
  AddItem( ({NPC_HOEHLE"dfledermaus", NPC "erd", NPC "kroete"}),REFRESH_DESTRUCT);

  AddExit("oben", "./erde11");
  AddCmd(({"wirf", "werfe", "schleudere", "schleuder"}),"call");
}


call( string str)
{
  object ob;
  notify_fail("Was willst Du hier gegen was werfen oder schleudern? \n");
  if ( !str) return 0;
  if( (str == "gong gegen schlegel") && ( !present("gong", TP)))
  {
    write(" \n"
        "Du hast doch gar nichts geeignetes zum Schlagen dabei...\n");
    return 1;
  }
  if(( str == "gong gegen schlegel") && ( present("gong", TP)))
  {
    write("Du schlaegst den Gong gegen den Schlegel, ein wundersamer Ton erklingt "
        "und die Erde ringsum Dich scheint zu erbeben...\n");
    say(CAP_TPN+" schlaegt mit dem Gong gegen den Fels...\n");
    if(erdgeist && !present("erdgeist"))
    {
      ob = clone_object("/d/dschungel/dante/erde/npc/erdg.lpc");
      ob->move(environment(TP),M_TPORT);
      erdgeist=0;
    }
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  erdgeist=1;
}

