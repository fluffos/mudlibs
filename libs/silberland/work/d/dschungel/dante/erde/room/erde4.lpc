// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  AddDetail(("decke"),
      "An der Decke siehst Du ein Gekritzel...");
  AddDetail(("gekritzel"),
      "Du kannst es lesen...");
  AddReadDetail(("gekritzel"),
      "                               TEST\n");
  AddDetail( ({"boden", "oeffnung"}),
      "Am Boden ist zwischen den Pfuetzen eine Oeffnung, durch die Du "
      "hinuntergelangen kannst.");

  AddItem( ({NPC"mops", NPC_HOEHLE"dfledermaus"}),REFRESH_DESTRUCT);

  AddExit("unten", "./erde5");
  AddExit( "sueden", "./erde3" );
}
