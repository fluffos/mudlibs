// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
#define AD AddDetail
#define SP SetProp
#define QP QueryProp

int code;
int i;
int fix;

string *liste=({
"a","w","e", "r", "t", "z", "u", "i", "o", "p", 
 "s","d" ,"f" ,"g", "h" ,"j" ,"k" ,"l", 
"y","x" ,"c" ,"v", "b", "n", "m"});

create()
{
  ::create();


SetProp(P_INT_LONG, BS(
"Du befindest Dich in einem dunklem Gang. Am Boden steht etwas Wasser, dass von "
"den Waenden in kleinen Stroemen nach unten fliesst. Die Erde hier scheint "
"locker zu sein. In der Ostwand ist eine Tuer eingelassen. Die Nordwand "
"hingegen besteht aus Fels."));



AD("nordwand",
"Die Nordwand besteht aus sehr harten Fels.");
AD("fels",
"Der Fels scheint undurchdringbar, doch da entdeckst Du einen massiven "
"Schrank aus Metall, der in die Wand eingebaut wurde.");

AD("metall",
"Glaenzendes, schwarzes Metall.");
AD("schrank",
"Der Schrank weist eine kleine Metalltuere auf.");
AD("metalltuere",
"Die Metalltuere hat vier kleine Raeder angebracht.");
AD(({"raeder","rad"}),
"Die Raeder kann man drehen. Vielleicht geht so ja die Metalltuere auf.");
AD(({"metalltuere","metalltuer"}),
"Die Metalltuere geht irgendwie auf.");

AddDetail(({"wand","waende"}),
"An den Waenden fliesst Wasser nach unten. Manchmal sind sie mit Moos bewachsen. "
"In die Ostwand ist die Tuere eingelassen.");

AddDetail(("ostwand"),
"An der Ostwand erkennst Du eine kleine, niedere, sehr alt aussehende Tuere...");
AddDetail(("moos"),
"Das Moss ist gruen und feucht. He, da ist ein Abdruck!");
AD("abdruck",
"Ui, da hat irgenjemand etwas ins Moss gedrueckt. Du siehst einige Zeichen!");
AD(({"zeichen"}),
"Irgendwie kann man da lesen:\n"
"Bevor ichs vergessen, achja was wollte ich doch gleich...\n"
"Aja, die verfluchten Raeder. Hmm, die Zahl war es.\n"
"Kozdeich ergibt "+fix+"...komisch...\n");

AddDetail(({"tuer","tuere"}),
"Die Tuere ist eine alte Holztuer.");
AddDetail(("holz"),
"Das Holz war einst braun und saftig, nun sieht es eher grau und trocken aus.");
    
 //AddItem("/d/dschungel/dante/perlenquest/pgnom", REFRESH_DESTRUCT);
  
  
 NewDoor("osten", ("/d/dschungel/dante/erde/room/tuer"),
 ({"holztuere","holztuer","tuere","tuer"}),
({
D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
D_LONG, "Die alte Holztuer sieht noch immer recht stabil aus.\n",
D_GENDER, FEMALE,
D_SHORT, "Eine %se, alte Holztuer.",
D_NAME, "Holztuer",
}) );

AddCmd(({"drehe","dreh"}), "code");
AddCmd("test","test");
}

int test(string str)  {
string *zerlegt;
	notify_fail("namen?!?!!?\n");
	if(!str) return 0; 
	
for(i=0; i<strlen(str)	; i++)   {
	zerlegt+=({str[i]});
       write(""+str[i]+"\n");
 	}
return 1; }
	


int code(string str)  {
	object ob;
	notify_fail("Die Syntax lautet: 'drehe raeder auf zahl'\n"
	"Wobei 'zahl' natuerlich eine echte Zahl sein muss, also z.B. 3891238.\n");
	
	}
