
// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";
#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{
  ::create();

  AddDetail(("moos"),
      "Neben dem Moos siehst Du einen kleinen Kaefer.");
  AddDetail(("kaefer"),
      "Der Kaefer krabbelt einfach so ueber die Pflanzen und Steine...");
  AddDetail(({"steine","steine"}),
      "Die Steine liegen ueberall, nur vor der Ostwand liegen keine...");
  AddDetail(("ostwand"),
      "Die Ostwand kommt Dir sehr merkwuerdig vor...");
  AddDetail(({"pflanzen","pflanze"}),
      "Ausser Moos wachsen hier noch einige Straeucher und ein kleiner Baum.");
  AddDetail(({"strauch","straeucher"}),
      "Es handelt sich hierbei um Nachtschattengewaechse...");
  AddDetail(({"nachtschattengewaechse","nachtschattengewaechs"}),
      "Viel der Nachtschattengewaechse sind giftig, wie der Stechapfel, andere "
      "hingegen schmecken sehr gut, wie die Tomate...");
  AddDetail(("tomate"),
      "Rund und rot...");
  AddDetail(("stechapfel"),
      "Den Genuss von Stechapfel kann ich nur abraten...");
  AddDetail(("genuss"),
      "Genuss waere das sicher keiner!");
  AddDetail(("baum"),
      "Der Baum steht klein und unscheinbar in einer Ecke. Er traegt "
      +"grosse Fruechte "
      "und schaut recht krank mit seinen braunen Blaettern aus.");
  AddDetail(({"frucht","fruechte"}),
      "Die Fruechte haben eine graue Farbe und sehen faul aus.");
  AddDetail(("farbe"),
      "GRAU!");
  AddDetail(({"blatt","blaetter"}),
      "Braun und verwelkt haengen sie lustlos von den Aesten...");
  AddDetail(({"ast","aeste"}),
      "Die Aeste wirken duerr und ausgetrocknet. Der Stamm sieht auch nicht viel "
      "gesuender aus.");
  AddDetail(("stamm"),
      "Die Rinde sieht grau und tot aus. Ueberall wuchern Pilze...");
  AddDetail(({"pilz","pilze"}),
      "Der Baum scheint wirklich sehr krank zu sein...");
  AddDetail(("rinde"),
      "Eine Stelle an der Rinde faellt Dir besonders auf.");
  AddDetail(("stelle"),
      "Hier weisst die Rinde eine Verdickung auf.");
  AddDetail(("verdickung"),
      "Die Verdickung erweist sich bei naeherer Betrachtung als ein Scharnier!");
  AddDetail(("scharnier"),
      "Tatsaechlich hat der Stamm ein Scharnier! Was soll den das wohl "
      +"bedeuten...");
  AddDetail(("betrachtung"),
      "Bist Du blind ?");
  AddDetail(({"ecke","ecken"}),
      "In einer der Ecken steht ein kleiner Baum.");

  AddItem( ({NPC"mops", NPC"erd", NPC_WEG "dratte"}), REFRESH_DESTRUCT);

  AddCmd(({"knicke","knick","lege","leg","biege","bieg"}), "get");

  AddExit("unten", "./erde26");
  AddExit( "nordwesten", "./erde9" );
}


int get ( string str)
{
  notify_fail("Was willst Du machen?\n");
  if ( !str ) return 0;
  if ( member( ( {"stamm","stamm um","stamm nach hinten", "scharnier um", 
          "scharnier", "scharnier nach hinten"}),str )!=-1)
  {
    write( BS( "Du knickst den Stamm des Baumes um, das Scharnier klickt leise, "
          "ploetzlich oeffnet sich eine Geheimtuere in der Wand und Du wirst "
          "nach nebenan gezogen."));
    TP->move("/d/dschungel/dante/erde/room/erde24",M_SILENT + M_GO);
    return 1;
  }
  return 0;
}

