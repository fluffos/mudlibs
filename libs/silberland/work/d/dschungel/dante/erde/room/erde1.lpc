// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einem dunklem Gang. Am Boden steht etwas Wasser, dass "
    "von den Waenden in kleinen Stroemen nach unten fliesst. Die Erde hier scheint "
    "locker zu sein. Hier kann man ohne Lichtquelle noch etwas erkennen, doch "
    "tiefer unten scheint es finster zu werden... ")+
    "Eine Tafel.\n");
    
  AddDetail(("tafel"),
  "Du kannst sie lesen.");
  AddReadDetail(("tafel"),
  "+------------------------+\n"
  "|        Gegraben        |\n"
  "|           im           |\n"
  "|         Jahre          |\n"
  "|          Eins          |\n"
  "|          nach          |\n"
  "|      der Erschaffung   |\n"
  "|         dieser         |\n"
  "|          Welt          |\n"
  "|                        |\n"
  "|   117 Zwergensklaven   |\n"
  "|         mussten        |\n"
  "|          dabei         |\n"
  "|          ihr           |\n"
  "|         Leben          |\n"
  "|        lassen !        |\n"       
  "+------------------------+\n");
       
    AddDetail(({"lichtquelle","licht","quelle"}),
    "Hoffentlich traegst Du eine bei Dir.");
    
  SetProp( P_LIGHT, 1 );

AddDetail(("boden"),
"Am Boden sammelt sich das Wasser in kleinen Pfuetzen und rinnt glucksend nach unten."
" Auch Du kannst nach unten weitersteigen...");

AddDetail(("decke"),
"In der Decke siehst Du eine Oeffnung...");
AddDetail(({"oeffnung", "tageslicht"}),
"Durch die Oeffnung in der Decke kommst Du wieder zurueck ans Tageslicht...");

  AddExit("unten", "./erde2");
  AddSpecialExit( "oben", "oben");
//  AddExit( "oben", "/d/dschungel/dante/fels/room/fels46" );
}

int oben()
{
  write("Nach oben wird es spaeter mal gehen, bitte Geduld!\n");
  return 1;
}

