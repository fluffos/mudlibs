// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  AddDetail(("boden"),
    "Am Boden sammelt sich das Wasser in kleinen Pfuetzen. Durch eine kleine "
    "Oeffnung kommst Du nach unten.");
  AddDetail(("decke"),
    "In der Decke siehst Du eine Oeffnung...");
  AddDetail(("oeffnung"),
    "Durch die Oeffnung in der Decke kommst Du nach oben, durch die Oeffnung "
    "im Boden kommst Du nach unten.");

  AddExit("unten","./erde22");
  AddExit("oben", "./erde8");
  AddExit( "norden", "./erde12" );
}
