
// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
nosave int gong;
create()
{
  ::create();

  gong = 1;


  AddDetail(("decke"),
      "An der Decke siehst Du eine Zeichnung...");
  AddDetail(("zeichnung"),
      "Auf der Zeichnung siehst Du eine Tuere, einen Daemon, einen Erdgeist, einen Abenteurer...");
  AddDetail(("tuere"),
      "Die Tuere scheint verschlossen zu sein...");
  AddDetail(("abenteurer"),
      "Der Abenteurer steht irgendwo tief unten und hat einen kleinen Gong in der Hand.");
  AddDetail(("gong"),
      "Tja, woher soll man so einen Gong wohl bekommen ?");
  AddDetail(("daemon"),
      "Der Daemon loest ein Erdbeben nach dem anderen aus...");
  AddDetail(({"erdgeist","geist"}),
      "Der Erdgeist ist ein gutes Wesen, das viel ueber Tueren und Schloesser weiss...");
  AddDetail(("wesen"),
      "Der Erdgeist haelt sich hier irgendwo in seinem Versteck auf...");
  AddDetail(("versteck"),
      "Der Erdgeist kommt nur, wenn man ihn an der richtigen Stelle laut hervorlockt...");
  AddDetail(("stelle"),
      "Die Stelle musst Du wohl suchen...");
  AddDetail(({"wurm","wuermer"}),
      "Ein kleiner Sandwurm kriecht gerade am Boden entlang.");
  AddDetail(("sandwurm"),
      "Neben dem Sandwurm siehst Du einen kleinen, dunklen Fleck...");
  AddDetail(("fleck"),
      "Der Fleck besteht aus dunklen, fast nicht mehr zu erkennenden Schriftzeichen.");
  AddDetail(({"schriftzeichen","zeichen"}),
      "Du kannst die Schriftzeichen lesen...");
  AddReadDetail(({"schriftzeichen","zeichen"}),
      "Sand u  mer m ss  ma n al e zertr t n!"); 

  gong = 1;

  AddItem( ({NPC_WEG"dratte", NPC_HOEHLE "dfledermaus"}) ,REFRESH_DESTRUCT);

  AddCmd(({"zertritt","zertrete"}), "worm");
  AddExit("raus", "./erde16");
}

reset()
{
  gong = 1;
  ::reset();
}


worm ( string str)
{
  notify_fail("Was willst Du zertreten ?\n");
  if ( str !="sandwurm")
    return 0;

  if ( !gong)
  {
    write(" \n"+BS(
        "Du versuchst den Sandwurm am Boden zu zertreten, stellst aber zu Deinem "
        "Erstaunen fest, dass es sich nur um ein Trugbild handelt.\n"));
    return 1;
  }

  if (str == "sandwurm")
  {
    write(" \n"+BS(
        "Du zertrittst den Sandwurm, rutscht dabei aus und siehst an der Suedostwand "
        "einen alten Gong, der auf einem Nagel augehaengt ist. Sofort nimmst Du den Gong "
        "von der Wand und freust Dich...\n"));
    say(""+TPN+" zertritt einen Wurm am Boden und grinst danach doof.\n");
    CLONE(OBJ"gong", TP);
    gong--;
    return 1;
  }
  return 0;
}
