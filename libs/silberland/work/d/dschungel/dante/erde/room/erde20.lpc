#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

AddDetail(("decke"),
"In der Decke siehst Du eine Oeffnung...");
AddDetail(("oeffnung"),
"Durch die Oeffnung in der Decke kommst Du nach oben...");
    
  AddItem( ({NPC_WEG"dratte", NPC"kroete", NPC "mops", NPC "erd", 
             NPC_HOEHLE "dfledermaus"}), REFRESH_DESTRUCT);
  AddExit("nordwesten", "./erde21");
  AddExit("oben", "./erde9");
}
