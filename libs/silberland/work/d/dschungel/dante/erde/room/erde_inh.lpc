#include "../def.h"
#include <properties.h>

inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem dunklen Gang" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einem dunklen Gang. Am Boden steht etwas Wasser, "
    "dass von den Waenden in kleinen Stroemen nach unten fliesst. Die Erde "
    "hier scheint locker zu sein."));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );

  AddDetail(("boden"),
    "Am Boden sammelt sich das Wasser in kleinen Pfuetzen.");
  AddDetail(({"pfuetze","pfuetzen"}),
    "Platsch! Schon bist Du in eine gestiegen.");
  AddDetail(("decke"),
    "Die Decke besteht aus fester Erde. Es tropft Wasser herunter.");
  AddDetail(({"stroeme"}),
    "Glucksend fliesst das Wasser zu Boden.");
  AddDetail( ({ "gang" }),
    "Wo fuehrt dieser Gang denn wohl hin ?");
  AddDetail(("wasser"),
    "Das Wasser stroemt in kleinen Baechen die Waende entlang zu Boden.");
  AddDetail(({"bach","baeche"}),
    "Die kleinen Baeche glucksen und gurgeln...");
  AddDetail(({"wand","waende"}),
    "An den Waenden fliesst Wasser nach unten. Manchmal sind sie mit Moos "
    "bewachsen.");
  AddDetail(("moos"),
    "Das Moos ist gruen und feucht.");
  AddDetail(("erde"),
    "Die Erde hat eine brauen Farbe und Du erkennst einige Loecher in ihr.");
  AddDetail(({"loch","loecher"}),
    "Die Loecher stammen von kleinen Wuermern...");
  AddDetail(({"wurm","wuermer"}),
    "Hier kannst Du leider keinen sehen.");
  AddDetail( ({"farbe"}),
   "Die Erde ist braun, das Moos ist gruen.");

  AddSound( ({DEFAULT_SOUND, "wasser"}),
    "Das Wasser gluckst und plaetschert...");
    
  AddSmell( ({DEFAULT_SMELL, "erde"}),
    "Hier riecht es nach feuchter Erde.");

}

