
// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
nosave int kelle;
create()
{
  ::create();

 kelle = 1;
 
AddDetail(("moos"),
"Neben dem Moos faellt Dir eine Spalte in der Wand auf.");
AddDetail(("spalte"),
"Die Spalte ist sehr eng. Du kannst mit Deiner Hand sicher nicht hineingreifen...");
AddDetail(("erde"),
"Die Erde hat eine brauen Farbe und Du erkennst einige Loecher in ihr. "
"Am Boden liegt hier eine alte, tote Erdkroete herum...");
AddDetail(({"kroete","erdkroete"}),
"Die Kroete scheint an irgendeiner, seltsamen Krankheit gestorben zu sein.");
AddDetail(("krankheit"),
"Ihr Koerper ist grausig entstellt.");
AddDetail(("koerper"),
"Ueberall hat sie Beulen und Auswuechse. Eiter rinnt aus ihren Wunden...");
AddDetail(({"beulen","beule"}),
"Ein ekliger Anblick...");
AddDetail(("anblick"),
"Du wendest Dich von der toten Kroete ab.");
AddDetail(({"eiter", "wunden"}),
"Gelb und gruen rinnt Eiter aus den Wunden der Kroete heraus.");
AddDetail(({"auswuechse","auswuchs"}),
"Die Auswuechse sind gross und prall, so dass sie sicher platzen, wenn man sie "
"zerdrueckt...");

  AddCmd(({"quetsche","quetsch", "zerdrueck", "zerdruecke"}), "get");
  AddExit( "sueden", "./erde7");  
  AddExit( "unten", "./erde19" );

AddItem("/d/dschungel/dante/erde/npc/ringgeist", REFRESH_DESTRUCT);

}

reset()
{
kelle= 1;
::reset();
}

get ( string str)
{
notify_fail("Was willst Du hier quetschen ?\n");
if ( str != "auswuchs" && str != "auswuechse" )
{
write("");

return 0;
}

if ( !kelle)
{
  write(" \n"
  "Du quetscht den Auswuchs mit aller Kraft, aber nichst passiert.\n");
  say(CAP_TPN+" questscht den Auswuchs mit aller Kraft, aber nichts passiert.\n");
  return 1;
}

  write(BS( "Du quetscht den Auswuchs und ploetzlich erscheint ein Maulwurf, "
          "der Dir eine Maulwurfskralle " "gibt und genauso schnell wieder "
          "verschwindet wie er erschienen ist."));
  say(BS(CAP_TPN+" quetscht den Auswuchs und ploetzlich erscheint ein Maulwurf, "
         "der aber gleich wieder im Erdreich verschwindet."));
  CLONE(OBJ"kelle", TP);
  kelle--;
  return 1;
}


