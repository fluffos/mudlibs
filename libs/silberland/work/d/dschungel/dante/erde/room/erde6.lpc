
// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
nosave int fackel;
create()
{
  ::create();

 fackel = 1;
 

AddDetail(("decke"),
"Von der Decke tropft Wasser. Du erkennst eine kleines Loch..");
AddDetail( ({"loch", "oeffnung"}),
"In die Oeffnung kann man hineingreifen...");
                                                      
AddItem( ({NPC_WEG"dratte", NPC"gnom", NPC_HOEHLE "dfledermaus", NPC "mops",
           NPC "erd"}), REFRESH_DESTRUCT);
  
  AddCmd(({"greife","greif"}), "get");
  AddExit ("nordwesten", "./erde15");
  AddExit("osten", "./erde5");
  AddExit( "sueden", "./erde13" );
}

reset()
{
fackel= 1;
::reset();
}

get ( string str)
{
  notify_fail("Wo willst Du hier hinein greifen ?\n");
  if ( str != "loch" && str != "oeffnung" && str != "in loch" && str!="in oeffnung" )
    return 0;
  if ( !fackel)
  {
     write(" \n"
       "Du greifst in die Oeffnung und verspuerst einen stechenden Schmerz.\n");
     say(""+TPN+" greift in eine Oeffnung an der Decke.\n");
     TP->do_damage(7);
     return 1;
  }
  else
  {
    write(
      "Du greifst in die Oeffnung und findest einen Gegenstand, den Du an Dich nimmst.\n");
    say(""+TPN+" greift in eine Oeffnung an der Decke.\n");
    CLONE("/obj/fackel", TP);
    fackel--;
    return 1;
  }
  return 0;
}


