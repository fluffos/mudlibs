// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_LONG, BS(
        "Du befindest Dich in einem dunklem Gang. Am Boden steht etwas Wasser, "
        "dass von den Waenden in kleinen Stroemen nach unten fliesst. Die Erde "
        "ist hier nicht nur locker wie sonst, sondern direkt schlammig und weist "
        "einige Spuren auf. Was moegen die wohl bedeuten..."));

  AddDetail(("boden"),
      "Der Boden ist feucht vom Wasser und man kann im Schlamm deutlich Spuren erkennen.");
  AddDetail(({"pfuetze","pfuetzen"}),
      "Die Pfuetzen weisen einige tiefe Abdruecke auf.");
  AddDetail(("decke"),
      "Von der Decke tropft Wasser...");
  AddDetail( ({ "gang" }),
      "Der Gang ist hier irgendwie anders...");
  AddDetail(("erde"),
      "Die Erde ist hier sehr schlammig.");
  AddDetail(("schlamm"),
      "Der Schlamm ist tief und stinkt ziemlich...");
  AddDetail(({"spuren","spur"}),
      "Die Spuren fuehren direkt zur Ostwand...");
  AddDetail(("ostwand"),
      "An der Ostwand enden die Spuren im Schlamm. Die Wand selbst ist hier voller Algen und Schlamm...");
  AddDetail(({"algen","alge"}),
      "Die Algen scheinen hier besonders gut zu wachsen, sie schlaengeln sich nach oben "
      "und bilden bizzare Muster...");
  AddDetail(("muster"),
      "Genaues kann man nicht erkennen, doch Du glaubst einen Kopf zu erkennen...");
  AddDetail(("kopf"),
      "Der Kopf ist besser ausgedrueckt ein Januskopf.");
  AddDetail(({"januskopf"}),
      "Zwei Gesichter sind zu erkennen, das eine stellt eine boesartige Fratze dar, "
      "das andere ein freundliches Gesicht eines Clowns...");
  AddDetail(("fratze"),
      "Boese lachen Dich die Augen der Fratze an...");
  AddDetail(({"auge","augen"}),
      "Seltsam, eines der Augen steht etwas hervor und Dir faellt auch ein kleiner "
      "leuchternder Edelstein auf.");
  AddDetail(("edelstein"),
      "In eines der Augen hat irgendjemand einen funkelnden Rubin gesteckt.");
  AddDetail(("rubin"),
      "Der Rubin leuchtet in hellem Rot und sendet gleisende Strahlen in alle Richtungen.");

  //AddSpecialDetail(({"strahl","strahlen"}), "d_clown");
  AddDetail(({"strahlen","strahl"}),
      "Schoen sind sie.");



  AddDetail(({"richtungen","richtung"}),
      "Ueberall leuchtet und funkelt es rot...");
  AddDetail(("gesicht"),
      "Das Gesicht laechelt Dich freundlich an...");
  AddDetail(("clown"),
      "Der Clown kommt Dir so bekannt vor...");

  AddItem( ({NPC"erd", NPC "kroete", NPC_WEG "dratte"}), REFRESH_DESTRUCT);

  AddExit("sueden", "./erde2");
  AddExit( "norden", "./erde4" );
}

