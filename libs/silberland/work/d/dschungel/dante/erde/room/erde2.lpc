
// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
nosave int fackel;
create()
{
  ::create();

 fackel = 1;
 

AddDetail(("decke"),
"In der Decke siehst Du eine Oeffnung...");
AddDetail(("oeffnung"),
"Durch die Oeffnung in der Decke kommst Du nach oben...");
AddDetail(("moos"),
"Neben dem Moos faellt Dir eine Spalte in der Wand auf.");
AddDetail(("spalte"),
"Die Spalte ist tief. Was da wohl drinnen sein mag...");

                                                      
AddItem( ({NPC_WEG"dratte", NPC "erd"}),REFRESH_DESTRUCT);
  
  AddCmd(({"greife","greif"}), "get");
  
  AddExit("norden", "./erde3");
  AddExit( "oben", "./erde1" );
}

reset()
{
fackel= 1;
::reset();
}


get ( string str)
{
notify_fail("Wo willst Du hier hinein greifen ?\n");
if ( str != "in spalte" && str!="in spalte hinein")
return 0;


if ( !fackel)
{
  write(" \n"
   "Du greifst in die Spalte, aber sie scheint leer zu sein.\n");
  say(CAP_TPN+" greift neben dem Moos an der Wand herum.\n");
  return 1;
}

write(" \n"
"Du greifst in die Spalte und findest einen Gegenstand, den Du an Dich nimmst.\n");
say(CAP_TPN+" greift neben dem Moos an der Wand herum.\n");
CLONE("/obj/fackel", TP);
fackel--;
return 1;
}


