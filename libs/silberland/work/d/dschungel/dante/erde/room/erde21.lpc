// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_LONG, BS(
        "Du befindest Dich in einem dunklem Gang. Am Boden steht etwas Wasser, "
        "dass von den Waenden in kleinen Stroemen nach unten fliesst. Die Erde hier "
        "scheint locker zu sein. Von oben faellt etwas Licht herein, Du glaubst "
        "Baeume zu sehen. ")); 
  SetProp( P_LIGHT, 1 );
  AddDetail(("licht"),
      "Das herabfallende Licht erklaert auch, warum Du hier noch etwas sehen "
      "kannst ohne "
      "eine kuenstliche Lichtquelle.");
  AddDetail(("lichtquelle"),
      "Eine Fackel, eine Lampe...");
  AddDetail(("baeume"),
      "Du glaubst, aber genau erkennen kannst Du nichts.");
  AddDetail(("decke"),
      "In der Decke siehst Du eine Oeffnung...");
  AddDetail(("oeffnung"),
      "Durch die Oeffnung in der Decke kommst Du nach oben...");

  AddItem( ({NPC"gnom", NPC "erd", NPC "kroete"}), REFRESH_DESTRUCT);

  AddExit("suedosten", "./erde20");
  AddExit( "oben", "/d/dschungel/dante/weg/room/planta6" );
}

init() {
  ::init();
  if(interactive(TP)) {call_out("tag", 0); 
  }
}

tag()  {
  if(environment(TP)!=TO) return;
  write(BS(
        "Solltest Du Dich wundern, das diese Gegend hier unten irgendwie "
        "unfertig wirkt, so hast Du recht. Warum und wieso zu erklaeren "
        "sprengt den Rahmen, aber bitte frag mich, Dante, nicht danach. Vielleicht "
        "wird sie ja eines Tages auch mal fertig gestellt. Danke!"));
}

