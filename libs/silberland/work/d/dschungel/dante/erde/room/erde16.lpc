
// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";
#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{
  ::create();

 

AddDetail(("boden"),
"Am Boden sammelt sich das Wasser in kleinen Pfuetzen. Man kann durch eine "
"grosse Oeffnung bequem nach unten gelangen.");
AddDetail(("oeffnung"),
"Die Oeffnung fuehrt nach unten.");
AddDetail(("decke"),
"Von der Decke tropft Wasser...");
AddDetail(({"bach","baeche"}),
"Die Baeche verschwinden alle in einem breiten Riss in der Wand.");
AddDetail(("riss"),
"Der Riss ist ziemlich gross. Lebewesen koennen da sicher durchsteigen.");
AddDetail(("moos"),
"Neben dem Moos faellt Dir eine Spalte in der Wand auf.");
AddDetail(("spalte"),
"Die Spalte ist voellig uninteressant...");

  AddItem( ({ NPC_WEG"dratte", NPC"mops", NPC "erd"}), REFRESH_DESTRUCT);
  
  AddCmd(({"steige","steig"}), "get");
  
  AddExit( "unten", "./erde15" );
}


int get ( string str)
{
notify_fail("Wo willst Du durch steigen ?\n");
if ( !str )
return 0;
if ( member( ( {"durch riss"}),str )!=-1)
{
write(" \n"
"Du steigst durch den Riss.\n");
TP->move("/d/dschungel/dante/erde/room/erde17",M_GO,"durch den Riss",
"steigt", "kommt durch einen Riss gestiegen");
return 1;
}
return 0;
}

