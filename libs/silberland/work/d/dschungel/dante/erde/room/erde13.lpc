#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create()
{
  ::create();

                                                      
  AddItem(NPC "erddaemon",REFRESH_DESTRUCT, ([P_MNPC_FLAGS:0]) );
  
  AddGuardedExit("unten", "/d/dschungel/dante/erde/room/erde14", "erdbebendaemon",
   "Der Daemon loest ein kleines Erdbeben aus und Du wirst zu Boden geschleudert.\n" );
  AddExit( "norden", "./erde6" );
}
