// erdloch dante maer 97

#include "../def.h"

inherit ROOM "erde_inh";

#include <properties.h>
#include <language.h>
nosave int heilen;

void create()
{
  ::create();

  AddDetail(("boden"),
      "Am Boden sprudelt hier eine kleine Quelle. Ihr frisches, klares Wasser "
      "schaut sehr gut aus...\n");
  AddDetail(({"quelle"}),
      "Die Quelle blubbert und gluckst. Du bekommst Durst...");
  AddDetail(("durst"),
      "Tja, wenn man Durst hat, dann...");
  AddDetail(("decke"),
      "An der Decke erkennst Du eine Schrift...");
  AddDetail(("schrift"),
      "Du kannst sie lesen...");
  AddReadDetail(("schrift"),
      "DANTE IST EIN GFRAST!!!");

  heilen = 2+random(4);                

  AddCmd(({"trinke","trink"}), "heal");                                  


  AddExit("norden", "./erde18");                                                      
  AddItem(NPC"drfledermaus",REFRESH_DESTRUCT);
  AddExit("sueden", "./erde5");
}

void reset()
{
  heilen = 2+random(4);
  ::reset();
}

int heal( string str)
{
  notify_fail("Was willst Du hier trinken ?\n");
  if ( str != "wasser")
    return 0;

  if (!heilen)
  {
    write(" \n"
        "Du trinkst einen Schluck Wasser aus der Quelle, aber so gut wie es aussieht "
        "schmeckt es bei weitem nicht...\n");
    say(""+TPN+" trinkt einen Schluck Wasser aus einer Quelle.\n");
    return 1;
  }

  if ( str== "wasser")
  {
    write(" \n"
        "Du trinkst einen Schluck Wasser aus der Quelle und fuehlst Dich erfrischt.\n");
    say(""+TPN+" trinkt einen Schluck Wasser aus einer Quelle.\n");
    TP->heal_self(15+random(7));
    heilen--;
    return 1;
  }
  return 0;
}
