//riesen fledermaus

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Riesenfledermaus");
  SetProp(P_LONG, BS(
    "Die Riesenfledermaus ist ein gewaltiges Exemplar ihrer Gattung. Ihre spitzen "
    "Zaehne sind sicherlich furchtbare Waffen."));
  AddDetail(({"zaehne","zahn","waffen"}),
  "Mit diesen saebelartigen Zaehnen solltest Du besser nicht in Beruehrung kommen.\n");
  
  SetProp(P_NAME, "Riesenfledermaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({"fledermaus","riesenfledermaus"}));
  set_living_name("riesenfledermaus");
  
  create_default_npc(14);
  SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen",140,({DT_POISON,DT_PIERCE}) }));
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_UNHOLY,DT_BLUDGEON })); 
  
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Riesenfledermaus will Deine Sachen nicht.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(5, 300,
    "Die Riesenfledermaus zerkratzt Dein Gesicht.\n",
    "Die Riesenfledermaus zerkratzt @WESSEN Gesicht.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,600,
    "Die Riesenfledermaus schlaegt ihre spitzen Zaehne in Deinen Hals.\n",
    "Die Riesenfledermaus schlaegt ihre spitzen Zaehne in @WESSEN Hals.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 300,
  "Die Riesenfledermaus zerfetzt Dein Gesicht.\n",
  "Die Riesenfledermaus zerfetzt @WESSEN Gesicht.\n",
  DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  
  SetChats(5, ({
  "Die Riesenfledermaus schwirrt um Dich herum.\n",
  "Die Riesenfledermaus haengt von der Decke herab.\n",
  "Die Riesenfledermaus stoesst schrille Laute aus.\n",
  "Die Riesenfledermaus bleckt ihre spitzen Zaehne.\n",
  "Die Riesenfledermaus faengt eine kleine Spinne.\n",
  "Die Riesenfledermaus scheint Dich zu beobachten.\n",
  
  "Die Riesenfledermaus flattert aufgeregt umher.\n"}) );
  
  SetAttackChats(10, ({
  "Die Riesenfledermaus versucht sich in Dein Haar zu krallen.\n",
  "Die Riesenfledermaus stoesst schrille Laute aus.\n",
  "Die Riesenfledermaus will Dein Gesicht zerfetzten.\n",
  "Die Riesenfledermaus stuerzt sich von oben auf Dich.\n"}) );

}

