// satanskobra fuer die boesen buben

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <mnpc.h>
#include <new_skills.h>
 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein runder Erdmops");
  SetProp(P_LONG, BS(
    "Der Erdmops ist eine Mischung aus Trueffelschwein und Rollmops. "
     "Wie das aussieht stell Dir lieber selbst vor."));
  
  SetProp(P_NAME, "Erdmops");
  SetProp(P_GENDER, MALE);
  AddId(({"erdmops", "mops"}));

  create_default_npc(11);
  SetProp(P_HANDS,  ({" mit seime Erdmopsruessel", 100+random(30),DT_BLUDGEON}) );
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "mopst herein");
  SetProp(P_MSGOUT, "mopst");
  SetProp(P_MMSGIN, "mopst grunzend herein");
  SetProp(P_MMSGOUT, "mopst grunzend weit weg");
  SetProp(P_MNPC_AREA, ROOM "erde");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "erde5");
  SetProp(P_MNPC_WAIT, ({5 , 10, 10}) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);
  
  
  SetProp(P_DIE_MSG,  " wird nie wieder mopsen.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "mopst Dich freundlich an.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Erdmops grunzt dankend.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(5,100,
    "Der Erdmops grunzt Dich furchtbar laut an.\n",
    "Der Erdmops grunzt @WEN furchtbar laut an.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));
   AddSpell(3,250,   
    "Der Erdmops schlaegt Dir seinen Ruessel ins Gesicht.",
    "Der Erdmops schlaegt @WEM seinen Ruessel ins Gesicht",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
     AddSpell(1,350,   
    "Der Erdmops mopst Dich fast zu Tode.",
    "Der Erdmops mopst @WEN fast zu Tode.",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
    
  SetChats(3, ({
  "Der Erdmops mopst leise vor sich hin.\n",
  "Der Erdmops mopst.\n",
  "Der Erdmops grinst.\n",
  "Der Erdmops graebt im Boden nach Trueffeln.\n",
  "Der Erdmops scharrt im Sand.\n"}));
 
  
}

