// satanskobra fuer die boesen buben

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <mnpc.h>
#include <new_skills.h>
create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine rollender Erdklumpen");
  SetProp(P_LONG, BS(
        "Der rollende Erdklumpen ist ein lebendiges Wesen. Er rollt alles nieder was "
        "sich ihm hier unten in den Weg stellt."));

  SetProp(P_NAME, "Erdklumpen");
  SetProp(P_GENDER, MALE);
  AddId(({"klumpen", "erdklumpen"}));

  create_default_npc(11);
  SetProp(P_HANDS,  ({" rollend", 80+random(40),DT_BLUDGEON}) );
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "rollt herein");
  SetProp(P_MSGOUT, "rollt");
  SetProp(P_MMSGIN, "rollt krachend herein");
  SetProp(P_MMSGOUT, "rollt krachen weit weg");
  SetProp(P_MNPC_AREA, ROOM "erde");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "erde5");
  SetProp(P_MNPC_WAIT, ({15 , 15, 10}) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);


  SetProp(P_DIE_MSG,  " zerfaellt in viele kleine Erdkluempchen.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "rollt Dich nieder.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Der Erdklumpen rollt Dich dankend nieder.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(5,200,
      "Der Erdklumpen ueberrollt Dich beinahe.\n",
      "Der Erdklumpen ueberrollt @WEN beinahe.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,   
      "Der Erdklumpen drueckt Dich an die Wand.\n",
      "Der Erdklumpen drueckt @WEN an die Wand.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4,350,   
      "Der Erdklumpen ueberrollt Dein Bein.\n",
      "Der Erdklumpen ueberrollt @WESSEN Bein.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Erdklumpen rollt hin.\n",
        "Der Erdklumpen rollt her.\n",
        "Der Erdklumpen stoeest gegen die Wand.\n",
        "Der Erdklumpen zerbroeckelt ein wenig.\n",
        "Der Erdklumpen macht grossen Laerm.\n"}));


}

