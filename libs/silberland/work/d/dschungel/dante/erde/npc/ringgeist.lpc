

inherit "std/mnpc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include <class.h>

object ob;

create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser brauner Humusgeist");
  SetProp(P_LONG, (
        "Der Humusgeist ist ein freundliches Wesen. Er besteht aus einer "
        "durchsichtigen, hin und herwogenden, braunen Masse und laechelt Dich "
        "freundlich an."));
  SetProp(P_NAME, "Humusgeist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist", "humusgeist"}) );
  AddAdjective( ({"gross", "grosser", "grossen", "braun", "brauner", "braunen"}) );
  //AddClass(CL_UNDEAD);

  create_default_npc(30);

  AddInfo(({"ring","erdring"}),
      "Dieset Ring verleiht grosse Macht!", "sagt: ");


  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt leise herein");
  SetProp(P_MMSGOUT, "schwebt weit weg");
  SetProp(P_MNPC_AREA, ROOM "erde");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "erde18");
  SetProp(P_MNPC_WAIT, ({15 , 15, 10}) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);

  SetProp(P_HANDS, ({" mit seinen brauen Armen", 230+random(30), DT_MAGIC}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, ({
        "grinst Dich frech an.\n",
        "sagt: Davon weiss ich leider nichts...\n",
        "schuettelt sich vor Lachen...\n",
        "grinst daemlich.\n",
        "sagt: Ja, das fragten viele schon...\n",
        "kichert leise.\n",
        "freut sich ueber soviel Dummheit.\n",
        "meint: 1 + 1 = 2 !\n",
        "kratzt sich unterm Kinn.\n",
        "sagt: Diese Frage ist mir zu dumm.\n"}));

  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
        "Der Humusgeist laesst @WEN verschwinden.\n"}));
  SetProp(P_DIE_MSG, " verschwindet wieder in die Welt der Geister.\n");
  SetProp(P_NOCORPSE, 1);

  SetProp(P_NOMAGIC, 40+random(10));
  SetProp(P_SPELLRATE, 60+random(10));

  AddSpell(5, 300, 
      "Der Humusgeist huellt Dich in braunen Nebel.\n",
      "Der Humusgeist huellt @WEN in braunen Nebel.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 700, 
      "Der Humusgeist laesst Humusbrocken auf Dich herabfallen.\n",
      "Der Humusgeist laesst Humusbrocken auf @WEN herabfallen.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 900,
      "Der Humusgeist verflucht Dich.\n",
      "Der Humusgeist verflucht @WEN.\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 500,
      "Der Humusgeist versucht Dich in der Humuse zu vergraben.\n",
      "Der Humusgeist versucht @WEN in der Humuse zu vergraben.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));


  SetChats(4, ({
        "Der Humusgeist schwebt nach oben...\n",
        "Der Humusgeist schwebt nach unten...\n",
        "Der Humusgeist deutet auf die Wunder dieser Welt.\n",
        "Der Humusgeist scheint voellig durchsichtig zu sein.\n",
        "Der Humusgeist sagt: Ich liebe unsere Humuse.\n",
        "Der Humusgeist verschwindet, taucht aber hinter Dir wieder auf.\n",
        "Der Humusgeist fluestert: Verschwinde wieder in die Stadt zurueck.\n",
        "Der Humusgeist schimmert braeunlich...\n",
        "Der Humusgeist laechelt Dich an.\n",
        "Der Humusgeist sagt: Verschmutze unsere Erde nicht.\n"}));


  SetAttackChats(20, ({
        "Der Humusgeist sagt: Das war ein Fehler, Du Unwissender.\n",
        "Der Humusgeist versucht Dich zu entmaterialisieren.\n",
        "Der Humusgeist lacht Dich aus.\n",
        "Der Humusgeist sagt: Verschinde von hier!.\n",
        "Du beginnst zu taummeln.\n",
        "Der Humusgeist zieht Dich an Deiner Nase.\n"}));
  SetProp(P_TRANSPARENT, 0);

  SUID;
  ob=clone_object("/gilden/druidenzirkel/armour/elementarring");
  ob->set_ring_element("humus");
  ob->move(this_object(), M_NOCHECK);

}


