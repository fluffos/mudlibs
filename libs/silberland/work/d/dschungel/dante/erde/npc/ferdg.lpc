

inherit "std/mnpc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner brauner Erdgeist");
  SetProp(P_LONG, (
    "Der braune Erdgeist ist ein freundliches Wesen. Er besteht aus einer "
    "durchsichtigen, hin und herwogenden , braunen Masse und laechelt Dich freundlich an."));
  SetProp(P_NAME, "Erdgeist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist", "erdgeist"}) );
  AddAdjective( ({"klein", "kleiner", "kleinen", "braun", "brauner", "braunen"}) );
  AddDetail(("masse"),
    "Der Koerper des Erdgeistes ist undefinierbar, zu sehr ist er Veraenderungen unterworfen.");
    AddDetail(("koerper"),
    "Dieses seltsame Wesen scheint keinerlei fixe Gestalt zu haben.\n");
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen brauen Armen", 150+random(30), DT_MAGIC}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "Du suchst wohl meinen grossen Bruder...\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
     "Der Erdgeist laesst @WEN verschwinden.\n"}));
  SetProp(P_DIE_MSG, " verschwindet wieder in die Welt der Geister.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_FIRE,DT_SLASH}));
  
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MNPC_AREA, ROOM "erde");
  SetProp(P_MNPC_WAIT, ({10,15,10}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "erde5");
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);  
    
  SetProp(P_NOMAGIC, 20+random(10));
  SetProp(P_SPELLRATE, 40+random(10));
  AddSpell(5, 200, 
   "Der Erdgeistgeist huellt Dich in braunen Nebel.\n",
    "Der Erdgeist huellt @WEN in braunen Nebel.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 500, 
    "Der Erdgeist laesst Erdbrocken auf Dich herabfallen.\n",
    "Der Erdgesit laesst Erdgeist auf @WEN herabfallen.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 666,
    "Der Erdgeist verflucht Dich.\n",
    "Der Erdgeist verflucht Dich.\n",
     DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 300,
    "Der Erdgeist versucht Dich in der Erde zu vergraben.\n",
    "Der Erdgesit versucht @WEN in der Erde zu vergraben.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  

 SetChats(4, ({
    "Der Erdgeist schwebt nach oben...\n",
    "Der Erdgeist schwebt nach unten...\n",
    "Der Erdgeist deutet auf die Wunder dieser Welt.\n",
    "Der Erdgeist scheint voellig durchsichtig zu sein.\n",
    "Der Erdgeist sagt: Ich liebe unsere Erde.\n",
    "Der Erdgeist verschwindet, taucht aber hinter Dir wieder auf.\n",
    "Der Erdgeist fluestert: Verschwinde wieder in die Stadt zurueck.\n",
    "Der Erdgeist schimmert braeunlich...\n",
    "Der Erdgeist laechelt Dich an.\n",
    "Der Erdgeist sagt: Verschmutze unsere Erde nicht.\n"}));
 SetAttackChats(20, ({
    "Der Erdgeist sagt: Das war ein Fehler, Du Unwissender.\n",
    "Der Erdgeist versucht Dich zu entmaterialisieren.\n",
    "Der Erdgeist lacht Dich aus.\n",
    "Der Erdgeist sagt: Verschinde von hier!.\n",
    "Du beginnst zu taummeln.\n",
    "Der Erdgeist zieht Dich an Deiner Nase.\n"}));
 
 
 
 AddInfo("dante",
 "sagt: Dante, das alte Erdferkel!\n");   
 AddInfo("dschungel",
    "sagt: Der Dschungel ist meine Heimat.\n");
 AddInfo("feyaria",
 "sagt: Sie ist die Herrin des Dschungels.");   
 AddInfo("silberland",
 "sagt: Der Dschungel ist das schoenste Gebiet im Silberland.");   
    AddInfo("tijara",
    "sagt: Naja, eben eine Stadt.");
    AddInfo(({"daemonen","daemon"}),
    "sagt: Die Daemonen der Zerstoerung sind unsere groessten Feinde.");
    AddInfo("tiere",
    "sagt: Sie sind die Bewohner des Dschungels.");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler liebt den Dschungel.\n");
    AddInfo("bruder",
    "sagt: Ach den kann man ja sogar riechen...\n");               
  }


