// dante 2.april     @SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boesartiger Erdgnom");
  SetProp(P_LONG, BS(
    "Der Erdgnom ist ein kleines, aber sehr kraeftiges Wesen. Seine dunklen "
    "Augen funkeln Dich hinterlistig an. Du solltest Dich vor ihm in Acht nehmen..."));

  AddDetail(({"auge","augen"}),
  "Dunkel und hinterlistig blinzeln Dich die Augen des Erdgnoms an.");
    
  SetProp(P_NAME, "Erdgnom");
  SetProp(P_GENDER, MALE);
  AddId(({"gnom", "erdgnom"}));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen dreckigen Klauen",150+random(30),DT_BLUDGEON}));
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_UNHOLY, DT_TERROR })); 
  SetProp(P_VULNERABILITY, ({ DT_HOLY }));
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft davon");

  SetProp(P_DIE_MSG,  " grinst Dich noch einmal boesartig an und faellt dann tot um.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "spuckt Dich an.\n");
  AddInfo("dante", "Feyaria hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Erdgnom schreit: Gib mir Deine Muenzen!\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,200,
    "Der Erdgnom erschreckt Dich fast zu Tode.\n",
    "Der Erdgnom erschreckt @WEN fast zu Tode.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,400,
    "Der Erdgnom verflucht Dich lauthals.\n",
    "Der Erdgnom verflucht @WEN lauthals.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));
   AddSpell(3,300,
  "Der Erdgnom spuckt Dir in die Augen.\n",
  "Der Erdgnom spuckt @WEM in die Augen.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
     AddSpell(2,400,
  "Der Erdgnom stopft Dir Erde in den Mund.\n",
  "Der Erdgnom stopft @WEM Erde in den Mund.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
     
  SetChats(3, ({
  "Der Erdgnom grinst Dich boesartig an.\n",
  "Der Erdgnom scheint etwas auszuhecken...\n",
  "Der Erdgnom lacht laut.\n",
  "Der Erdgnom kratzt seinen Buckel.\n",
  "Der Erdgnom wuehlt im Boden.\n", 
  "Der Erdgnom stinkt ziemlich.\n"}) );
  
  SetAttackChats(10, ({
  "Der Erdgnom tritt Dich.\n",
  "Der Erdgnom schreit laut.\n",
  "Der Erdgnom will fluechten.\n"}) );

  SUID;
//  CLONEME(OBJ "zahl" );
//  command("zuecke waffe");
 // CLONEME(ARMOUR "" );
//  command("trage alles");
}
