// skorpionchen

inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Erdskorpion");
  SetProp(P_LONG, BS(
    "Dieser Skorpion misst von Kopf bis Schwanz an die 1 Meter. Sein gewaltiger "
    "Stachel ragt gefaehrlich drohend ueber Dir in die Hoehe."));
  SetProp(P_NAME, "Erdskorpion");
  SetProp(P_GENDER, MALE);
  AddId(({"skorpion", "erdskorpion"}));
  
  AddDetail(({"stachel","giftstachel"}),
  "Der Giftstachel kann Dir sicher grosse Schmerzen bereiten...\n");
  AddDetail(({"kopf","schwanz"}),
  "Vor Dir siehst Du ein wahrhaft gewaltiges Tier!\n");
  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinem Giftstachel",120,({DT_POISON,DT_PIERCE}) }));
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_POISON,DT_WATER,DT_BLUDGEON })); 
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kracht zu tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Erdskorpion will @WEN nicht.\n" }) );

  SetProp(P_SPELLRATE,50+random(10));
  AddSpell(5, 250,
    "Der Erdskorpion bohrt seinen Gifststachel in Dich.\n",
    "Der Erdskorpion bohrt seinen Giftstachel in @WEN.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));  
  AddSpell(1,500,
    "Der Erdskorpion spiesst Dich auf.\n",
    "Der Erdskorpion spiesst @WEN auf.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,1,DS_POISON);
  
  
  SetChats(5, ({
  "Der Skorpion krabbelt naeher an Dich heran.\n",
  "Der Giftstachel sieht wirklich beaengstigend aus.\n",
  "Der Erdskorpion beobachtet Dich genau.\n",
  "Ploetzlich schnellt der Skorpion vor...\n",
  "Der Erdkorpion zerquetscht eine Ratte.\n",
  "Der Erdskorpion droht mit seinem Giftstachel.\n",
  "Der Erdskorpion schabt am Boden.\n"}) );
  
  SetAttackChats(10, ({
  "Der Erdskorpion versucht Dich zu stechen.\n",
  "Der Erdskorpion will Dich zerquetschen.\n",
  "Der Erdskorpion drueckt Dich gegen die Wand.\n",
  "Der Erdskorpion kratzt Dich am Bein.\n"}) );

}

