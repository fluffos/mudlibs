#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <mnpc.h>
#define QUESTKEY "Tithons Fluch"

int truemmer=0;
string wer;
int open=0;

init() {
  object staub;
  ::init();
  if(!interactive(TP)) { 
    return;  
  }
  if(deep_present("staub", TP)) { 
    return;  
  }
  if(random(3))  {
    staub=clone_object("/d/dschungel/dante/weg/obj/staub");
    staub->move(TP, M_NOCHECK);
  }	
}


create() {
  ::create();
  
  SetProp( P_INT_SHORT, "Eine Ruine in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun mitten in dem verfallenen Haus mit der "
        "traurigen Geschichte. Einst muss es sehr schoen "
        "gewesen sein, denn an den kaerglichen Resten der Mauern erkennt man ab "
        "und an die alte Marmorverkleidung. Die Decke des Hauses scheint aber noch "
        "tragfaehig zu sein, denn sie ist nicht herabgefallen. Eine kleine, morsche "
        "Klappe fuehrt nach oben. " 
        "Sonst liegen aber nur mehr Truemmer herum, "
        "so dass diese Ruine ein Paradies fuer Ratten geworden ist. Ob hier noch andere "
        "Monster hausen? Im Westen kommst Du wieder zurueck auf den Weg."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_HOUSE]) );        

  AD("geschichte",
      "Sie steht auf einem Schild vor dem Haus.");
  AD("schild",
      "Vor dem Haus!");
  AD("tijara",
      "Da bist Du nun!");
  AD("haus",
      "Das Haus war einst sehr prunkvoll und schoen anzusehen. Nun ist es nur mehr "
      "eine verfallene Ruine.");
  AD(({"rest","reste"}),
      "Die Reste der Mauern wirken bedrohlich und Du kannst Dir nicht sicher sein, "
      "ob das Haus nicht gleich total zusammen stuerzt.");
  AD(({"wand","waende","mauer","mauern"}),
      "Die Mauern sind teilweise eingefallen. An den Resten erkennt man Marmor.");
  AD(({"marmor","marmorverkleidung","verkleidung"}),
      "Dieses Haus war einst mit Marmor verkleidet. An der Marmorverkleidung "
      "siehst Du eine Inschrift.");
  AD("schluesel",
      "Ja, wo koennte der sein...");
  AD("stadt",
      "Du bist mitten drin.");
  ARD("inschrift",
      "Hmm nicht zu entziffern.");
  ASD("inschrift", "ok");
  AD("boden",
      "Der Boden ist uebersaeht mit Truemmern.");
  AD("decke",
      "Die Decke haelt noch, noch! Sie kann aber gleich herabstuerzen und Dich begraben!");
  AD("ruine",
      "Das ehemals schoene Haus ist nun verfallen und verkommen. Ratten hausen hier ueberall.");
  AD(({"ratte","ratten"}),
      "Die Ratten wohnen nun schon sehr lange hier.");
  AD("paradies",
      "Die Ratten poppen hier und werden so immer mehr.");
  AD("monster",
      "Hier kann man nie wissen, was einen noch so erwartet.");
  AD("weg",
      "Der Weg liegt im Westen, kann aber von den Truemmern versperrt sein...");
  AD("westen",
      "Da kommst Du wieder hinaus auf den Weg.");
//  ASD("truemmer", "truemmer");
  AD("truemmer", "Auch hier gibt es noch einige Truemmer. Der Weg zurueck ist aber "
    "dennoch frei.");
  ASE("westen", "ruine");
  if(!random(2))  {
    AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT,
        ([ P_MNPC_FLAGS: 0]));   
  }
  if(!random(2))  {
    AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT,
        ([ P_MNPC_FLAGS: 0]));  
  }        
  AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT,
      ([ P_MNPC_FLAGS: 0]));
  AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT,
      ([ P_MNPC_FLAGS: 0]));
  AddSound( DEFAULT_SOUND,
      "Du glaubst Laerm zu hoeren.");
  AddSound("laerm",
      "Das ist eben eine Stadt hier.\n");
  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach frischer Luft.");
  AddSmell("luft",
      "Frisch.");
  ACD(({"raeume","raeume"}), "weg");
  AD("klappe",
      "Eine alte morsche Klappe fuehrt nach oben. Sie ist geschlossen. Man sieht ein "
      "Schluesselloch.");
  AD(({"loch","schluesselloch"}),
      "Wenn Du den Schluessel hast, kannst Du einfach nach oben gehen.");
  ASE("oben", "oben");
  previous_object()->CustomizeObject(); 
}


oben() {

  if(present("ratte", TO))  {
    write(BS("Die Ratte haelt Dich auf!"));
    return 1;
  }	

  if(TP->QueryQuest(QUESTKEY))  {	

    if(deep_present("\nratkey_normal", TP))  {
      write(BS(
        "Du oeffnest mit dem Schluessel die Klappe und gehst nach oben. Die Klappe "
        "faellt hinter Dir wieder zu."));
      TPM("/d/dschungel/dante/ratmanquest/room/ruine2", M_GO, 	
          "durch die Klappe nach oben", "geht" ,
          "kommt von unten durch die Klappe herauf. Die Klappe faellt wieder zu.");
      return 1;
    }	

    write(BS(
      "Du brauchst einen Schluessel, um die Klappe zu oeffnen. Wenn Du ihn hast kannst "
      "Du ohne Probleme nach oben gehen. Sicher hat jeder derjenigen die hier frueher "
      "gewohnt haben, so einen Schluessel."));
    return 1;  
  }

  if(deep_present("\nratkey_quest", TP))  {
    write(BS(
      "Du oeffnest mit dem Schluessel die Klappe und gehst nach oben. Die Klappe "
      "faellt hinter Dir wieder zu."));
    TP->move("d/dschungel/dante/ratmanquest/room/ruine2:"+getuid(TP), M_GO,
             "durch die Klappe nach oben", "geht" , 
             "kommt von unten durch die Klappe herauf. Die Klappe faellt wieder zu.");
      return 1;  
  }
  write(BS(
    "Du brauchst einen Schluessel um die Klappe zu oeffnen. Wenn Du ihn hast kannst "
    "Du ohne Probleme nach oben gehen."));
  return 1;  
}


int weg(string str) {
  NF("Was willst Du wegraeumen?\n");
  if(str=="truemmer weg" || str=="truemmer aus dem weg") {
    say(BS(CAP_TPN+" versucht den Weg nach Westen frei zu machen."));
    if(truemmer==1) {
      write(BS("Du raeumst die Truemmer aus dem Weg."));
      truemmer=0;
      wer=CAP(getuid(TP));
      return 1;  
    }
    write(BS("Die Truemmer wurden schon von "+wer+" aus dem Weg geraeumt."));
    return 1;  
  }
  return 0; 
}


string truemmer() {
  if(truemmer==1) {
    return "Die Truemmer versperren Dir den Weg!\n";
  }		
  return "Die Truemmer wurden von "+(wer?wer:"Jemandem")+" beiseite geraeumt!\n";
}


int ruine() {
  if(truemmer==1) {	
    write(BS(
      "Du versuchst ins Freie zu gelangen, doch Truemmer versperren Dir den Weg."
      " Vielleicht kann man sie ja aus dem Weg raeumen."));
    return 1;  
  }

  if( (present("ratte", TO)) ) {
    write(BS("Die Ratte haelt Dich auf!"));
    return 1; 
  }
  TP->move("d/dschungel/dante/ratmanquest/room/ti_pfad10", M_GO,
      "aus der Ruine raus", "geht", "kommt aus der Ruine heraus");
  return 1;  
}


ok() {
  object da;
  object ob;

  if(deep_present("ratkey", TP)) {
    write(BS(
     "Hmm, die Inschrift sieht wirklich seltsam aus. Du "
     "verstehst kein Wort davon."));
    return "\n";  
  }

  if(TP->QueryQuest(QUESTKEY)) {
    ob=clone_object("/d/dschungel/dante/ratmanquest/obj/ratkey");
    ob->move(TP, M_NOCHECK);		 
    write(BS(
      "Du findest einen kleinen Schluessel als Du die Inschrift genauer ansiehst."));
    return "\n";      
  }	
  da=deep_present("RATTENJUNGEQUEST", TP);
  if(da && da->QP("P_BUR_AMOUNT")==-1 ) {
    ob=clone_object("/d/dschungel/dante/ratmanquest/obj/ratkey_quest");
    ob->move(TP, M_NOCHECK);		 
    write(BS(
      "Du findest einen kleinen schwarzen Schluessel als Du die Inschrift genauer "
      "ansiehst."));
    return "\n";      
  }
  write(BS(
    "Hmm, die Inschrift sieht wirklich seltsam aus. Du verstehst kein Wort davon. "
    "Du solltest Dich noch einmal genauer mit dem Rattenjungen unterhalten!"));
  return "\n";  
}

