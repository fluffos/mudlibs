#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <mnpc.h>
#define QUESTKEY "Tithons Fluch"

int x1, y1, z1;
int x2, y2, z2;
int x3, y3, z3;
int tip;
int open=0;
int code;
string pfeil;

int vater=1;

reset() {
  ::reset();
  vater=1;  
}


create() {
  ::create();
  
  z1=100+random(900);
  y1=100+random(900);
  x1=100+random(900);

  z2=100+random(900);
  y2=100+random(900);
  x2=100+random(900);

  z3=100+random(900);
  y3=100+random(900);
  x3=100+random(900);

  tip =1+random(8);

  erzeuge_code();

  SetProp( P_INT_SHORT, "Eine Ruine in Tijara (1. Stock)" );
  SetProp( P_INT_LONG, BS(
        "Du bist nun durch die morsche, alte Klappe in das Obergeschoss des "
        "einstmals so schoenen Haus gestiegen. Hier ist es merkwuerdigerweise "
        "viel kaelter als unten. Eine bedrohliche Aura scheint Dich zu umhuellen und "
        "Dir froestelt. Auch hier sieht man wieder nur Truemmer. Nur findet man "
        "sehr viel mehr Staub als unten. Die Decke ist eingestuerzt und man kann den "
        "Himmel sehen. Trotzdem ist es hier seltsamerweise dunkel?! " 
        "Die Waende sind halb verfallen und wirken noch "
        "zerstoerter als unten."));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );

  AD("verriegelung",
      "Ja, wirklich, da sieht man eine Verriegelung am Sarg. Man sieht auch ein kleines "
      "Feld.");
  AD("feld",
      "Das Feld besteht aus 10 Zahlen. Null bis Neun. Man kann sie antippen.");
  ASD(({"zahl","zahlen"}),"zahlentipp");
  AD("ruine",
      "Das Haus besteht fast nur mehr aus Truemmern. Die Decke ist herabgestuerzt. Ah, "
      "da haengt ein Brett herab!");
  AD("brett",
      "Auf dem Brett ist ein Zeichen eingeritzt worden!");
  ASD("zeichen", "show_pfeil");
  AD("boden",
      "Der Boden ist uebersaeht mit Truemmern. Du siehst ein aufgemaltes, kleines "
      "Quadrat.");
  ASD("quadrat", "fake");
  AD("aura",
      "Hier ist es still und unheimlich.");
  AD("staub",
      "Der Staub bedeckt hier alles.");
  AD("decke",
      "Die Decke ist herabgestuerzt und man erkennt den Himmel.");
  AD("himmel",
      "Der Himmel ist wunderschoen blau. Trotzdem ist es hier seltsamerweise "
      "dunkel?!?!");
  AD(({"wand","waende","mauer","mauern"}),
      "Die Waende und Mauern sind halb verfallen und liegen als Truemmer in dieser "
      "Behausung herum.");
  AD("behausung",
      "Einst war dies hier ein schoenes Wohnzimmer.");
  AD(({"wohnzimmer","zimmer"}),
      "Der Besitzer des Hauses hatte hier auch einen Safe versteckt.");
  AD("safe",
      "Der Safe steht sogar noch hier. Er ist leer und ausgepluendert. Dahinter "
      "sieht man eine grosse, schwarze Truhe.");
  AD("truhe",
      "Die Truhe ist total verschmutzt.");
  AD(({"familie","gebeine"}),
      "Na, die werden wohl im Sarg sein...");
  AD("schmutz",
      "Der Schmutz ist braun bis schwarz. HE!!! Da steht etwas grosses Schwarzes!!!");
  AD("schwarzes",
      "JA!!! Wirklich! Da steht ein Sarg!!!");
  AD("haus",
      "Du bist nun im Obergeschoss des Hauses. Aber eigentlich ist es ja kein "
      "Haus sondern mehr eine Ruine.");
  AD(({"geschoss","obergeschoss"}),
      "Hier wohnten einst die Besitzer des Hauses. Unten war ihr Juwelierladen.");
  AD("besitzer",
      "Sie sind schon alle tot.");
  AD(({"laden","juwelierladen"}),
      "Den Laden gibts es schon lange nicht mehr.");
  AD("sarg", 
      "Der Sarg ist geschlossen. Eine Tafel ist an ihm "
      "angebracht.");
  //kann so bleiben, denn der sarg geht nie echt auf in der quest

  AD("tafel",
      "Lies sie.");
  ARD("tafel",
      "*****************************************************\n"
      "* Hier ruhen die Gebeine der ungluecklichen Familie.*\n"
      "*****************************************************\n");
  AD("truemmer", 
      "Ueberall liegen sie hier herum!");
  if(!random(2)) {
    AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT,
        ([ P_MNPC_FLAGS: 0]));
  }
  if(!random(2)) {
    AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT,
        ([ P_MNPC_FLAGS: 0]));
  }
  AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT,
      ([ P_MNPC_FLAGS: 0]));
  AddSound( DEFAULT_SOUND,
      "Hier ist es sehr still.");

  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach alter Luft.");
  AddSmell("luft",
      "Stickig.");
  ACD(({"brich","breche","brechen"}), "brake");
  AIT("d/dschungel/dante/ratmanquest/npc/stkrok", REFRESH_DESTRUCT);
  ACD(({"oeffne","oeffnen","loese","loesen","loes"}), "nix");
  ACD(({"tipp","tippe"}), "open_coffin");
  AD("klappe",
      "Eine alte morsche Klappe fuehrt nach unten. Sie ist geschlossen. "
      "Direkt in die Klappe ist ein Symbol geritzt!");
      AD(({"symbol","symbole"}),
      "Du siehst vier Symbole! Symbol 1, 2, 3, 4.");
     
  ASD("symbol 1", "symbol1");
  ASD("symbol 2", "symbol2");
  ASD("symbol 3", "symbol3");
  ASD("symbol 4", "symbol4");      
  ASE("unten", "unten");
  previous_object()->CustomizeObject(); 
}

symbol1() {
  TP->More(read_file("/d/dschungel/dante/ratmanquest/obj/symbol1.txt"));
  return "\n";
}

symbol2() {
  TP->More(read_file("/d/dschungel/dante/ratmanquest/obj/symbol2.txt"));
  return "\n";
}

symbol3() {
  TP->More(read_file("/d/dschungel/dante/ratmanquest/obj/symbol3.txt"));
  return "\n";
}

symbol4() {
  TP->More(read_file("/d/dschungel/dante/ratmanquest/obj/symbol4.txt"));
  return "\n";
}

show_pfeil()  {
  write(""+pfeil+"\n");	
  return "\n";
}


erzeuge_code() {
  switch(tip) {	
    case 1:	
      code=x1*y1*z1;
      pfeil="\n"
      " +----------------+\n"
      " |                |\n"
      " | -------------> |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " +----------------+\n";
      break;
    case 2:	
      code=x2*y2*z2;
      pfeil="\n"
      " +----------------+\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " | -------------> |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " +----------------+\n";
      break;
    case 3:	
      code=x3*y3*z3;
      pfeil="\n"
      " +----------------+\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " |                |\n"
      " | -------------> |\n"
      " |                |\n"
      " +----------------+\n";
      break;		
    case 4:	
      code=x1*x2*x3;
      pfeil="\n"
      " +----------------+\n"
      " |  |             |\n"
      " |  |             |\n"
      " |  |             |\n"
      " |  |             |\n"
      " |  |             |\n"
      " |  |             |\n"
      " |  |             |\n"
      " |  |             |\n"
      " |  v             |\n"
      " +----------------+\n";
      break;
    case 5:	
      code=y1*y2*y3;
      pfeil="\n"
      " +-----------------+\n"
      " |        |        |\n"
      " |        |        |\n"
      " |        |        |\n"
      " |        |        |\n"
      " |        |        |\n"
      " |        |        |\n"
      " |        |        |\n"
      " |        |        |\n"
      " |        v        |\n"
      " +-----------------+\n";
      break;
    case 6:	
      code=z1*z2*z3;
      pfeil="\n"
      " +-----------------+\n"
      " |              |  |\n"
      " |              |  |\n"
      " |              |  |\n"
      " |              |  |\n"
      " |              |  |\n"
      " |              |  |\n"
      " |              |  |\n"
      " |              |  |\n"
      " |              v  |\n"
      " +-----------------+\n";
      break;
    case 7:	
      code=x1*y2*z3;
      pfeil="\n"
        " \\\n"
        "  \\\n"
        "   \\\n"
        "    \\\n"
        "     \\\n"
        "      \\\n"
        "       \\\n"
        "        \\\n"
        "         v\n";
      break;
    case 8:	
      code=z1*y2*x3;
      pfeil="\n"
        "          /\n"
        "         /\n"
        "        /\n"
        "       /\n"
        "      /\n"
        "     /\n"
        "    /\n"
        "   /\n"
        "  v\n";
      break;
  }
  //write(""+code+"\n");
  //write(""+pfeil+"\n");
}





int open_coffin(string str)  {
  int zahlen;
  NF("Was willst Du tippen?! Bitte nur Zahlen angeben!\n");
  if(!str) return 0;  

  if(sscanf(str, "%d", zahlen)!=1)  { 
    return 0;  }
  
  write(BS("Du drueckst die Zahlen "+zahlen+" auf der Verriegelung."));

  if(open==1) {
    write(BS("Aber der Sarg wurde doch schon entriegelt!"));
    return 1;  
  }

  if(zahlen==code) {
    write(BS("Die Verriegelung surrt leise und macht klick."));
    open=1;
    return 1;  
  } else
  
   {
    write(BS("Nichts passiert!"));
    return 1; 
  }	
  return 0;  
}



nix(string str) {
  NF("Was willst Du oeffnen?!\n");
  if(member(({"sarg","verriegelung"}),str)!=-1)  {
    write("Du versuchst den Sarg irgendwie zu oeffnen, aber so "
      "scheint das nicht zu klappen. Vielleicht kann man ja den Sarg aufbrechen!\n");
    say(CAP_TPN+" macht sich an der Kiste zu schaffen.\n");
    return 1;
  }
}


int brake(string str) {
  object monster;
  NF("Was willst Du aufbrechen?!\n");
  if(str=="sarg"||str=="sarg auf") {
    say(BS(CAP_TPN+" versucht den Sarg aufzubrechen."));
    write(BS("Du versuchst den Sarg aufzubrechen!"));	
    if(present("monster", TO)) {
      write(BS("Krok bruellt Dich an!"));
      return 1;  
    }
    if(present("ratte", TO)) {
      write(BS("Die Ratten lassen Dich nicht an den Sarg!"));
      return 1;  
    }     
    if(open==0) {
      write(BS("Du musst erst die Verriegelung loesen!"));
      return 1;  
    }
    if(present("vater", environment(TP)) ) {
      write(BS("Der Rattenjungenvater schlaegt Dich nieder!"));
      return 1;  
    }
    if(vater!=1) {
      write(BS("Der Sarg ist verklemmt. Geduld!"));
      return 1;  
    }
    if(deep_present("\nrockaestchen", TP)) {
      write(BS("Der Sarg ist verklemmt."));
      return 1;  
    }
    if(deep_present("\nrockaestchen", TO)) {	
      write(BS("Der Sarg ist verklemmt."));
      return 1;  
    }
    monster=clone_object("/d/dschungel/dante/ratmanquest/npc/gvater");
    if(TP->QueryQuest(QUESTKEY)) { 
      monster->SetProp(P_MAX_HP, TP->QueryProp(P_LEVEL)*100);
    } else {
      monster->SetProp(P_MAX_HP, TP->QueryProp(P_LEVEL)*25);
    }
    monster->move(TO, M_NOCHECK);
    monster->Kill(TP);
    vater=0;
    write(BS(
      "Du willst den Sarg aufbrechen, doch ploetzlich springt ein Geist "
      "aus den Truemmern hervor!!!"));
    erzeuge_code();
    return 1;  
  }
  return 0;  
}


fake() {
  //write(""+tip+"\n");
  write(
      " +----------------------+\n"
      " |                      |\n"
      " |                      |\n"
      " |  "+x1+"   "+y1+"    "+z1+"    |\n"
      " |                      |\n"
      " |                      |\n"
      " |  "+x2+"   "+y2+"    "+z2+"    |\n"
      " |                      |\n"
      " |                      |\n"
      " |  "+x3+"   "+y3+"    "+z3+"    |\n"
      " |                      |\n"
      " |                      |\n"
      " +----------------------+\n\n"
      "Hmm was soll das bedeuten?!\n");
  return "\n";
}	

string zahlentipp() {      
  return BS("Sie gehen von Null bis Neun. <syntax: tipp(e) zahlen> z.b: "+
            "'tipp "+(100000000+random(900000000))+"'."); 
}

unten() {
  if(TP->QueryQuest(QUESTKEY))  {
    write(BS(
      "Du oeffnest die Klappe und gehst wieder nach unten. Hinter Dir faellt die "
      "Klappe zu."));
    TPM("/d/dschungel/dante/ratmanquest/room/ruine", M_GO, 	
        "durch die Klappe nach unten", "geht" ,
        "kommt von oben durch die Klappe herunter. Die Klappe faellt wieder zu.");
    return 1;  
  }	
  write(BS(
    "Du oeffnest die Klappe und gehst wieder nach unten. Hinter Dir faellt die "
    "Klappe wieder zu."));

  TP->move("d/dschungel/dante/ratmanquest/room/ruine:"+getuid(TP), M_GO,
           "durch die Klappe nach unten", "geht" ,
           "kommt von oben durch die Klappe herunter. Die Klappe faellt wieder zu.");
  return 1;  
}	

