#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <mnpc.h>

#define QUESTKEY "Tithons Fluch"

int truemmer=1;
string wer;

create() {
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Weg in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun auf einem Weg in Tijara. Er laeuft von Norden nach Sueden "
        "oder umgekehrt, wie Du eben willst." 
        " Vom Himmel brennt die Sonne erbarmungslos herab. "
        "Den Weg markieren ordentlich verlegte weisse Platten, die aus Stein bestehen. "
        "Im Osten kannst Du ein sehr altes, verfallenes Gebaeude betreten. Ein Schandfleck "
        "fuer die schoenste Stadt im Silberland! Im Westen sieht man nur eine "
        "braeunliche alte Hausmauer auf der ein Schild angebracht ist. "));

  AD(({"mauer","hausmauer"}),  
      "Die Hausmauer ist alt und braeunlich. Du siehst ein Schild.");
  AD("ruine",
      "Die Ruine sieht sehr schmutzig und staubig aus. Irgendwie unheimlich.");
  AD("schild",
      "Lies es.");
  ARD("schild",
      "+-------------------------------------------------------+\n"
      "|   Dieses Schild wurde im Gedenken an das tragische    |\n"
      "|     Schicksal einer Familie aus Tijara angebracht!    |\n"
      "|            Sie moegen in Frieden Ruhen!               |\n"
      "|                                                       |\n"
      "|                                                       |\n"
      "| Vor langer Zeit, wohnte in dem nun verkommenen Haus   |\n"
      "| ein Mann, eine Frau und ihr kleiner Sohn.             |\n"
      "| Der Mann war ein reicher Juwelier der sehr geizig     |\n"
      "| und geldgierig war. Er wollte immer mehr und mehr und |\n"
      "| war nie zufrieden.                                    |\n"
      "| Alles ging gut, bis der Vater dem Pflanzentrollmagier |\n"
      "| Tithon eine seltene Pflanze stahl und sie verkaufte.  |\n"
      "| Aus Zorn darueber verfluchte Tithon den Sohn der      |\n"
      "| Familie. Dieser solle einer Ratte aehnlicher und      |\n"
      "| aehnlicher werden. Und so passierte es auch.          |\n"
      "| Die anderen Bewohner Tijaras mieden nun die Familie   |\n"
      "| und so kam es, dass die Familie total verarmte, ihr   |\n"
      "| Haus zu einer Ruine verfiel. Der Vater brachte aus    |\n"
      "| Verzweiflung zuerst seine Frau und dann sich selbst   |\n"
      "| um. Der Rattenjunge hingegen soll noch immer irgendwo |\n"
      "| in Tijara herumlaufen. Suche ihn...                   |\n"
      "+-------------------------------------------------------+\n");

  ASD("truemmer", "truemmer");
  AD("osten",
      "Im Osten steht ein verfallenes Gebaeude.");
  AD("gebaeude",
      "Das Gebaeude ist eher eine verkommene Ruine. Eine echte Schande!!!");
  AD(({"schande","schandfleck"}),
      "So ein haessliches Gebaeude sollte in einer so schoenen Stadt nicht stehen duerfen!");
  AD(({"tijara","stadt","silberland"}),
      "Tijara ist die beste, schoenste und geheimnisvollste Stadt im Silberland. "
      "Gegruendet von Feyaria und erbaut, ausgebaut, erweitert von Dante.");
  AD(({"dante","feyaria"}),
      "Hmm, so toll ist die Stadt nun wieder auch nicht...");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );
  AD("decke",
      "Nur der Himmel ist hier.");
  AD(({"wand","waende"}),
      "Hier kaum zu sehen. Ausser einer Hausmauer.");
  AD("westen",
      "Da steht eine Hausmauer. Man erkennt ein Schild.");
  AddDetail(({"teil","teile", "teilen"}),
      "Im Westen liegt der alte Teil von Tijara.");
  AddDetail( ({ "tijara", "stadt" }), BS(
        "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
        "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
        "der Grund fuer die Hitze hier.") );
  AD("grund",
      "Die Sonne.");
  AddDetail( ({ "weg" }), 
      "Der Weg geht hier nach Norden und Sueden weiter.");
  AddDetail( ({ "hauptplatz", "platz" }), BS(
        "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
        "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
        "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
        "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
        "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}), 
      "Der Boden wird hier durch Steinplatten gebildet.");
  AD("stein",
      "Der Stein war einmal weiss, nun ist er grau.");
  AD(({"platte","platten","steinplatten","steinplatte"}),
      "Die Steinplatten sind ordentlich verlegt "
      "und fuehren nach Norden weiter.");

  AD(({"norden","sueden"}),
      "Der Weg fuehrt hier weiter nach Norden und Sueden.");
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
        "Das Wohngebiet liegt etwas weiter im Westen."));
  ASE( "osten", "ruine" );
  AE("norden", "/d/dschungel/dante/tijaraneu/room/ti_pfad11");
  AE("sueden", "/d/dschungel/dante/tijaraneu/room/ti_pfad9");
  AIT("/d/dschungel/dante/weg/npc/dschimp", REFRESH_DESTRUCT,
      ([ P_MNPC_AREA:"/d/dschungel/",
         P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad7",
         P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS]));
  AddSound( DEFAULT_SOUND,
      "Du glaubst Laerm zu hoeren.");
  AddSound("laerm",
      "Das ist eben eine Stadt hier.\n");
  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach frischer Luft.");
  AddSmell("luft",
      "Frisch");
  ACD(({"raeume","raeume"}), "weg");
}

int weg(string str) {
  NF("Was willst Du wegraeumen?!\n");
  if(str=="truemmer weg"||str=="truemmer aus dem weg") {
    say(BS(CAP_TPN+" versucht den Weg nach Osten frei zu machen."));
    if(TP->QueryQuest(QUESTKEY) ) {
      if(truemmer==1) {
        write(BS("Du raeumst die Truemmer aus dem Weg."));
        truemmer=0;
        wer=CAP(getuid(TP));
        return 1;  
      }
      write(BS("Die Truemmer wurden schon von "+ wer +" aus dem Weg geraeumt."));
      return 1;  
    }
    if(!deep_present("RATTENJUNGEQUEST", TP)) { 
      write(BS("Du musst zuerst Kontakt zum Rattenjungen aufnehmen!"));
      return 1; 
    }
    if(truemmer==1) {
      write(BS("Du raeumst die Truemmer aus dem Weg."));
      truemmer=0;
      wer=CAP(getuid(TP));
      return 1;  
    }
    write(BS("Die Truemmer wurden schon von "+wer+" aus dem Weg geraeumt."));
    return 1;  
  }
  return 0; 
}


string truemmer() {
  if(truemmer==1) {
    return "Die Truemmer versperren Dir den Weg!\n";
  }		
  return "Die Truemmer wurden von "+ wer +" beiseite geraeumt!\n";
}


int ruine() {
  if(TP->QueryQuest(QUESTKEY) ) {
    if(truemmer==1) {	
      write(BS(
        "Du versuchst nach Osten zu gelangen, doch Truemmer versperren Dir den Weg."
        " Vielleicht kann man sie ja aus dem Weg raeumen."));
      return 1;  
    }
/* 
   write("Du erinnerst Dich an die vielen Geister und Ratten in dieser "
        "Ruine.\nDu denkst . o O (einmal ist genug)\n");
  
  */
  
    TP->move("d/dschungel/dante/ratmanquest/room/ruine", M_GO,
             "in die Ruine", "geht", "kommt aus dem Westen herein");
    return 1;  
  }
  if(!deep_present("RATTENJUNGEQUEST", TP)) { 
    write( BS(
      "Ohne Erlaubnis des Besitzers traust Du Dich nicht, diese Ruine "
      "zu betreten. Du musst zuerst Kontakt zum Rattenjungen aufnehmen!"));
    return 1;
  }	
  if(truemmer==1) {	
    write(BS(
      "Du versuchst nach Osten zu gelangen, doch Truemmer versperren Dir den Weg."
      " Vielleicht kann man sie ja aus dem Weg raeumen."));
    return 1;  
  }
  TP->move("d/dschungel/dante/ratmanquest/room/ruine:"+getuid(TP), M_GO,
           "in die Ruine", "geht", "kommt aus dem Westen herein");
  return 1;  
}


reset() {
  ::reset();
  truemmer=1;  
}


init() {
  ::init();
  if(interactive(TP)) { 
    call_out("tag", 3); 
  }
}


tag() {
  if(!TP || TO !=environment(TP)) return ;
  write(BSA("Besuche die unheimliche Ruine...",
    "Eine Stimme sagt: "));	
}
