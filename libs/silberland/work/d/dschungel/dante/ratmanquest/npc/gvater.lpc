//dante sl
inherit "std/mnpc";
#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define QUESTKEY "Tithons Fluch"

string x;

void create()
{
  string *y;
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Der unselige Geist des Rattenjungenvaters");
  SetProp(P_LONG, BS(
        "Das ist der unselige Geist des Rattenjungenvaters. Einst war er reicher "
        "Juwelier, dann wurde er arm und geschmaeht. Darauf brachte er sich "
        "und seine Frau um. Sein Sohn ist auf ewig verdammt als Rattenjunge "
        "umher zu laufen."));


  SetProp(P_NAME,"Rattenjungenvater");
  SetProp(P_GENDER, MALE);
  AddId(({"rattenjungenvater","vater","geist"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit duesteren Haenden", 100,DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");
  SetProp(P_BODY, 55);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Toete den Vater, er hat einen Schatz!!!\n");
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "kommt aus dem Sarg geschwebt");
  SetProp(P_MSGOUT, "schwebt weiter");
  SetProp(P_MMSGIN, "kommt aus dem sarg geschwebt");
  SetProp(P_MMSGOUT, "schwebt weit weg");

  SP(P_DIE_MSG, " ist ploetzlich verschwunden.\n");
  SetProp(P_MURDER_MSG, "Auch im Geisterreich habe ich nur Pech!!!");
  SetProp(P_KILL_NAME, "Der Vater des Rattenjungen");
  SetProp(P_KILL_MSG, "Lasst uns unsere Totenruhe!!!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));
  AddId(({"NOCONTROL", "NOWIMPY"}));
  SetProp(P_SPELLRATE,30);

  AddSpell(5, 200, 
      "Der Vater des Rattenjungen wirft Dich mit einer Windboee fast um.\n",
      "Der Vater des Rattenjungen wirft @WEN mit einer Windboee fast um.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 300,
      "Der Vater des Rattenjungen entfacht einen Wirbelwind ueber Dir.\n",
      "Der Vater des Rattenjungen entfacht einen Wirbelwind ueber @WEM.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));

  SetChats(4, ({
        "Der Vater des Rattenjungen schwebt nach oben...\n",
        "Der Vater des Rattenjungen schwebt nach unten...\n",
        "Der Vater des Rattenjungen scheint voellig durchsichtig zu sein.\n",
        "Der Vater des Rattenjungen grinst Dich unfreundlich an.\n",
        "Der Vater des Rattenjungen verschwindet, taucht aber ueber Dir wieder auf.\n",
        "Der Vater des Rattenjungen schimmert blaeulich...\n",
        "Der Vater des Rattenjungen schimmert leicht weisslich...\n"}));
  SetAttackChats(90, ({
        "Der Vater des Rattenjungen sagt: Das war ein Fehler, Du Unwissender.\n",
        "Der Vater des Rattenjungen versucht Dich zu entmaterialisieren.\n",
        "Der Vater des Rattenjungen lacht Dich aus.\n",
        "Der Vater des Rattenjungen sagt: Verschwinde von hier!.\n",
        "Der Vater des Rattenjungen sagt: Nur ein @@item@@ kann mich verletzen!.\n",
        "Du beginnst zu taummeln.\n",
        "Du kriegst kaum noch Luft...\n"}));
   
    y=({ "yari", "kuheuter",  "loewenzahn",  "kleeblatt",  "essiggurkerlbonbon", "brennesselbonbon", "haselzweig", "twinni", "chromkraut", "onyx", "hering", "magiestein", "schleimbaellchen"});
   x=y[random(sizeof(y))];
}

string item()
{
  return capitalize(x);
}


//neues die()

die(arg)  {
  object pflanze, key; 
  int i;
  object *inv;

  key=deep_present("ratkey", TP);  

  if(!interactive(TP))  { return;  }
  //keine elementare usw

  if(key)  {
    key->remove();
  }

  if(!deep_present("antifluchsubstanz", TP))  {
    pflanze=clone_object("d/dschungel/dante/ratmanquest/obj/substanz");	
    pflanze->move(TP, M_NOCHECK);

    write(BS(
          "Der Rattenjungenvater explodiert und wird zu einer seltsamen "
          "Substanz, die Du schnell aufhebst! Du solltest den Rattenjungen danach "
          "fragen!"));

  }


  write_file("/d/dschungel/dante/ratmanquest/log/gvater",
      dtime(time())+": "+CAP(getuid(TP))+" killt den Vater\n");


  if(interactive(TP))  {
    inv=all_inventory(TP); 

    if(!sizeof(inv))  { ::die(arg); }

    for(i=0 ;i<sizeof(inv); i++) {

      if(inv[i]->id("yari") )  {
        inv[i]->remove();

      }
    } 
  }

  ::die(arg);

}


//die ende


Defend(int dam, string dtype, int spell, object enemy)
{
  
  int plus;
  object y;
  plus=1; 

//wer die quest hat trifft den vater automatisch doppelt hart
if(enemy && interactive(enemy) && enemy->QueryQuest(QUESTKEY) )  {
   
   return ::Defend( dam*3, dtype, spell, enemy);
   
   }	
   	

  if(y=present(x, enemy)) {

    plus=10;
    y->SetProp(P_NODROP, 1);

  }


  return ::Defend( (dam)*plus/3, dtype, spell, enemy);
}




void NotifyPlayerDeath(object player, object killer, int lostexp)
{

  write_file("d/dschungel/dante/ratmanquest/log/gvater",
      dtime()+": Vater toetet "+CAP(getuid(player))+" ("+lostexp+")\n");

  heal_self(1000);

}

