//dante sl eigentlich von mops:))))

inherit "std/mnpc";
#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Krok, das Staubmonster");
  SetProp(P_LONG, BS(
        "Krok, das Staubmonster hat einen grauen, ueber und ueber mit Staubflunsen "
        "bedeckten Koerper. Ueberall wo es auftaucht fliegt der Staub umher."));
  SetProp(P_NAME,"Krok, das Staubmonster");
  SetProp(P_GENDER, NEUTER);
  AddId(({"staubmonster","monster","krok"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit einer Staubwolke", QueryProp(P_HANDS)[1],DT_TERROR}));
  SetProp(P_BODY, 50);
  //SP(P_MAX_HP, 2000);
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Krok verursacht nur Staub!!!\n");
  SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: -0.6, DT_TERROR:-0.2,
DT_BLUDGEON:-1.0, DT_MAGIC:-0.5, DT_WATER:0.4, DT_COLD:0.5]));

  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "kommt staubend herein");
  SetProp(P_MSGOUT, "staubt staubig weiter");
  SetProp(P_MMSGIN, "staubt staubig herein");
  SetProp(P_MMSGOUT, "staubt weit weg");

  SP(P_DIE_MSG, " explodiert in einer Staubwolke.\n");
  SetProp(P_MURDER_MSG, "Verdammt staubig bei Lars!");
  SetProp(P_KILL_NAME, "Krok, das Staubmonster");
  SetProp(P_KILL_MSG, "lacht: Tja, ich staube ab!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));
  AddId(({"NOCONTROL", "NOWIMPY"}));



  SetChats(5,({
        "Krok, das Staubmonster staubt umher.\n",
        "Krok, das Staubmonster hustet laut.\n",
        "Krok, das Staubmonster sagt: Kennst Du den Terrormops!\n",
        "Krok, das Staubmonster produziert Staub.\n",
        "Krok, das Staubmonster verschwindet kurz in einer Staubwolke.\n",
        "Krok, das Staubmonster staubt staubig umher.\n"}));

  AddInfo(({"mops","terrormops"}),
      "lacht sich krumm ueber den Terrormops!");



  SetProp(P_SPELLRATE,30);

  SUID;
  CLONEME("/d/dschungel/dante/weg/obj/tdrink");


  AddSpell(9,300,
      "Krok, das Staubmonster huellt Dich in eine Staubwolke.\n",
      "Krok, das Staubmonster huellt @WEN in eine Staubwolke.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));


  AddSpell(1,200,
      "Krok, das Staubmonster schuettet gruenen Staub auf Dich.\n",
      "Krok, das Staubmonster schuettet gruenen Staub auf @WEN.\n",
      DT_TERROR, "spell_frog",([SP_SHOW_DAMAGE:1]));


}

void spell_frog(object enemy,int damage,mixed dam_type)
{
  if(enemy->QueryProp(P_FROG))  {
    tell_object(enemy,
        "Der gruene Staub kriecht in Deine Lungen.\n");
    enemy->AddPoison(random(2));
  }
  else
    tell_object(enemy,
        "Der gruene Staub kriecht in Deine Lungen.\n"
        "Ploetzlich schrumpfst Du...\n");
  enemy->SetProp(P_FROG, 60);
}


die(arg)  {

  write_file("/d/dschungel/dante/weg/log/krok",
      dtime(time())+": "+CAP(getuid(TP))+" killt KROK\n");
  ::die(arg);

}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{

  write_file("d/dschungel/dante/weg/log/krok",
      dtime()+": KROK toetet "+CAP(getuid(player))+" ("+lostexp+")\n");

  heal_self(1000);

  // call_out("nimm_alles_aus_leiche", 0);
}

