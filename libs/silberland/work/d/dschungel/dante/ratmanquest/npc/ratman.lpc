inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../../def.h"
#include <mnpc.h>
#include <ansi.h>

#define QUESTNAME "Tithons Fluch"
#define QUESTOBJECTID "RATTENJUNGEQUEST"
#define BSA(x,y) break_string(x,78,y)       
#define TIME 20

int erloest=0;
object cash;
string spass(string wort);
string quest_ende();
string quest_start();

void create() {

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Rattenjunge");
  SetProp(P_LONG, BS(
        "Du siehst einen Rattenjungen, der zunaechst menschlich zu sein scheint, " 
        "auf den zweiten Blick aber einer Ratte sehr aehnlich sieht. Er huscht "
        "flink um Dich herum und beschnuppert alles mit seiner langen Nase, die "
        "geradezu uebertrieben zwischen den Knopfaugen herausragt. Zwei "
        "Rattenzaehne sind sehr stark ausgepraegt. Der Junge wuerde so gerne "
        "wieder einmal Spass haben...")  );
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME, "Rattenjunge");
  SetProp(P_RACE, "Rattenmensch");
  SetProp(P_GENDER, MALE);
  AddId(({"rattenjunge", "jungen", "rattenjungen","junge", "ratte", "\nratman"}));
  SetProp(P_WIMPY,50);

  create_default_npc(18);

  SetProp(P_BODY, 50+random(10));
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "faucht und entwischt Dir.");

  SetProp(P_MSGIN, "schnueffelt herein");
  SetProp(P_MSGOUT, "schnueffelt");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_MNPC_AREA, ({"/d/dschungel/feyaria/tijara/room/",                             "/d/dschungel/dante/tijaraneu/room/"}));
  SetProp(P_MNPC_FLAGS, 
    MOV_OUTDOORS +MOV_SPECIAL+ MOV_MOVES +MOV_INDOORS +MOV_INFIGHT,
    MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({10, 15, 15}));
  SetProp(P_MNPC_DEFAULTROOM, (
    "/d/dschungel/feyaria/tijara/room/weg_a3.lpc"));   
  SetProp(P_DIE_MSG, " schreit: Verdammt!\n");
  SetProp(P_NOCORPSE, 0);
  AddInfo("spass",
      "Ja, lachen waer schon was...lachen!", "sagt: ");
  AddInfo(({"klette","kletten"}),
      "HIHI! Die will ich haben!", "sagt: ");
  AddInfo("dante",
      "Den kannst Du voll vergessen!", "gnarzt: ");
  AddInfo("roc",
      "Wo ist er?", "strahlt: ");
  AddInfo("buzzom",
      "Den mag ich nicht!", "schreit los: ");
  AddInfo("tijara",
      "Naja, hier treib' ich mich die meiste Zeit herum.", "glotzt Dich an "
      "und sagt: ");
  AddInfo("schluessel",
      "Was willst Du mit meinem Schluessel? Ich kann ihn Dir nicht geben! Es "
      "sei denn... es sei denn, Du bringst mich zum Lachen...", 
      "wundert sich: ");
  AddInfo("schicksal",
      "Meines ist kein leichtes, aber ich klage nicht...", "sagt: ");
  AddInfo(({"hilfe","quest","abenteuer"}), #'quest_start,"sagt: ",1);
  AddInfo("irgendetwas",
      "Vielleicht eine magische Substanz oder etwas aehnliches koennte "
      "mir helfen.",
      "sagt: ");
  AddInfo("schild",
      "Lies es doch! Oder kannst Du das etwa auch nicht?!",
      "sagt: ");
  AddInfo("ruine",
      "Sie ist im westlichen Teil!",
      "sagt: ");
  AddInfo(({"tithon", "pflanzenmagier"}),
      "Dieser verdammte Magier hat meine Familie auf dem Gewissen und ist "
      "verantwortlich fuer meine jetzige Gestalt! Ich wuenschte, ich koennte "
      "ihm alles sofort heimzahlen!", "kreischt: ");
  AddInfo(({"fluch", "tithons fluch"}), 
      "Tithons Fluch hat mich in diese graessliche Gestalt verwandelt. Kannst "
      "Du Dir vorstellen, wie es mir geht, wenn ich mich selbst in einer "
      "Pfuetze sehe?", "erzaehlt erregt: ");
  AddInfo("pfuetze",
      "Schoen ist das nicht, glaub mir das!", "sagt: ");
  AddInfo("magier",
      "Meinst Du Tithon?!", "fragt: ");
  AddInfo("gestalt",
      "Ich weiss ich bin nicht schoen, aber Du bist auch nicht gerade huebsch!",
      "sagt: ");
  AddInfo("gewissen",
      "Ja, die ganze Familie musste leiden!", "sagt: ");
  AddInfo("quadrat",
      "Das ist das Werk von Tithon!!!!", "schreit: ");
  AddInfo("wahnsinn",
      "Ja, mein Vater wurde irr.", "sagt: ");
  AddInfo("familie",
      "Die Auswirkungen von Tithons Fluch und die unertraegliche Armut haben "
      "meinen Vater in den Wahnsinn getrieben. Zuerst brachte er meine Mutter "
      "um, dann sich selbst. Seither lebe ich unter den Ratten von Tijara, "
      "denn unser Haus ist fast restlos zerfallen.",
      "spricht zu Dir: ");
  AddInfo("vater", 
      "Ich hoffe seine Seele hat inzwischen Frieden gefunden.", 
      "sagt mit gesenktem Haupt: ");
  AddInfo("mutter",
      "Sie fehlt mir sehr.", "wimmert: ");
  AddInfo(({"ratten","ratte"}),
      "In Tijara gibt es viele Ratten! Der Gouverneur kann Dir sicher ein paar "
      "Geschichten ueber sie erzaehlen.", "berichtet grinsend: ");
  AddInfo("gouverneur",
      "Der Gouverneur von Tijara natuerlich.", "platzt heraus: ");
  AddInfo(({"geschichten","geschichte"}), 
      "Sehe ich etwa wie ein Gouverneur aus?", "lacht schallend: ");
  AddInfo("lachen",  #'spass, "sagt kichernd: ");
  AddInfo("haus",
      "Eine Weile habe ich dort noch gewohnt, aber dann konnte ich es nicht "
      "mehr unterhalten. Kaufen wollte es auch keiner, obwohl es ein schoenes, "
      "wenn auch schlichtes Haus war. Manchmal gehe ich noch daran vorbei und "
      "mit jedem Mal sieht es zerfallener und unheimlicher aus.", "erzaehlt: ");
  AddInfo("wesen",  
      "Ich glaube, es nennt sich Gouffre und haelt sich in der Naehe des "
      "Feldlagers auf.", "gruebelt: ");
  AddInfo("feldlager",  
      "Ja, das Feldlager. Im Suedosten von Midas.", "meint: ");
  AddInfo("midas",
      "Na hoer' mal, Du weisst nicht, wo Midas ist?", "wundert sich: ");
  AddInfo("gouffre",
      "Hmm, ja das wohnt im Feldlager!", "sagt: ");
  AddInfo("inschrift",
      "Diese Inschrift stimmt mich traurig. Wenn ich Dir was darueber "
      "erzaehlen soll, musst Du mich vorher zum lachen bringen.",
      "sagt: ");
  AddInfo("substanz", #'quest_ende, "sagt: ");
  AddInfo(DEFAULT_INFO,({        
        "sagt: Komm, geh' mir nicht auf die Kletten!\n",
        "sagt: Ist mir egal!\n",
        "fragt: Was?\n",
        "sagt: Buzzom weiss das sicher auch nicht.\n",
        "sagt: Roc wirds Dir erklaeren.\n",
        "sagt: Ich habe darueber gelesen.\n",
        "sagt ploetzlich: Darf ich Dich anknabbern?\n",
        "sagt: Achso! Hmm... Wieso achso? \n",
        "sagt: Zu viel Schaum, zu wenig Bier!\n",
        "sagt: Eben drum!\n",
        "sagt: Gestern gings noch.\n",
        "sagt: Unff! Unff!",
        "murmelt: Frag doch den Gaffo!",
        "sagt: Davon wuesste ich!\n"}));

  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Der Rattenjunge sagt: Danke, und jetzt schnell weg...\n" }) );

  SetChats(3, ({
        "Der Rattenjunge versucht an Dir zu knabbern.\n",
        "Der Rattenjunge kratzt sich an der Nase.\n",
        "Der Rattenjunge haut seine grossen Zaehne in den Boden.\n",
        "Der Rattenjunge schnueffelt aufgeregt herum.\n",
        "Der Rattenjunge wedelt mit seinem Schwanz.\n",
        "Der Rattenjunge wackelt mit seinen Ohren.\n",
        "Der Rattenjunge blinzelt Dich an.\n",
        "Der Rattenjunge laeuft im Kreis.\n",
        "Der Rattenjunge sagt: Ha!\n",
        "Der Rattenjunge fragt: Wo ist denn hier das Nagestudio?\n",
        "Der Rattenjunge fragt: Hab' ich mich verlaufen?\n",
        "Der Rattenjunge flucht: Grummel und Donnerwetter!\n",
        "Der Rattenjunge schaut sich um.\n",
        "Der Rattenjunge faengt an aufgeregt herumzuzappeln.\n",
        "Der Rattenjunge zwickt Dich.\n",
        "Der Rattenjunge holt einen Schluessel hervor und steckt ihn gleich "
        "wieder weg.\n",
        "Der Rattenjunge prueft seine Taschen.\n",
        "Der Rattenjunge schaut Dir direkt in die Augen.\n",
        "Der Rattenjunge ruempft seine lange Nase.\n",
        "Der Rattenjunge grinst und zeigt Dir seine Rattenzaehne.\n",
        "Der Rattenjunge findet etwas in seinem Fell.\n",
        "Der Rattenjunge schleicht um Dich herum.\n"

  }));
  set_living_name("rattenjunge");
  SUID;
}

string quest_start() {
  object newQuestObject;
  if( TP->QueryQuest(QUESTNAME)==1 ) {
    return "Vielen Dank fuer Deine Hilfe. Leider hat es nicht recht lange "
      "gewirkt. Tithons Fluch ist doch zu stark. Aber vielleicht kann mir "
      "ja wer anderer eine staerkere Substanz bringen.";
  }
  if( TP->QueryProp(P_LEVEL)<20) {
    return "Du bist wohl noch zu unerfahren, um mir helfen zu koennen.";
  }
  if( deep_present(QUESTOBJECTID, TP)==0 ) {
     write_file("/log/quests/tithonsfluch", dtime(time()) +": "+
            CAP(getuid(TP))+" beginnt die Quest Tithons Fluch.\n");
        newQuestObject=clone_object("d/dschungel/dante/ratmanquest/obj/ratjungobj");
        newQuestObject->move(TP, M_NOCHECK);
  }
  return     
      "Vielleicht kannst Du mir ja helfen, den Fluch zu ueberwinden. "
      "Irgendetwas muss es doch geben, dass ich meine alte Gestalt "
      "wiederbekomme. Schau Dir doch einmal die Ruine in Neutijara an! "
      "Irgendwo davor ist ein Schild...";
}     


StartReaction(verb, gruppe, adverb, touch) {
  object questObject;
  int burAmount;
  object burs;
  if( touch && verb == "umarm" && TP ) {
    if(erloest!=0)  {
      write( BS("Ich bin doch kein Rattenjunge mehr! Gib Ruhe!"));
    }
    if( TP->QueryQuest(QUESTNAME)==1 ) {
      write(BSA(
            "Hey, nur weil Du mich einmal "
            "zum Lachen gebracht hast, heisst das noch lange nicht, dass "
            "Du mich jetzt staendig umarmen darfst. Wer weiss, was ich mir "
            "da fuer Krankheiten hole! ", "Der Rattenjunge sagt barsch: ")
           );
    } else {
      if( deep_present(QUESTOBJECTID, TP)==0 ) {
        say("Der Rattenjunge reisst sich los.\n");
      } else {
        questObject=deep_present(QUESTOBJECTID, TP);
        if(deep_present("\nkletten_gebracht", TP)) {
          write(BSA(
                "Aber "+TPN+" Du hast mich doch schon "
                "mit Kletten umarmt und zum Lachen gebracht!",
                "Der Rattenjunge sagt: "));
          return;
        }	
        if( deep_present("\nklette", TP)==0 ) {	
          write(BSA(
                "Wir hatten abgemacht, dass Du mich "
                "mit den Kletten umarmst, Du Perversling!",
                "Der Rattenjunge kreischt: "));
        } else {
          burs=deep_present("\nklette", TP);
          if( burs->QueryProp(P_AMOUNT) >= 
              questObject->QueryProp("P_BUR_AMOUNT") ) {
            questObject->AddId("\nkletten_gebracht");
            write(BS(
                  "Der Rattenjunge umarmt Dich und kann sich vor Lachen kaum "
                  "noch auf den Beinen halten. Auf einmal schiesst Dir das Bild "
                  "durch den Kopf, das ihr beide in diesem Moment wohl abgeben "
                  "muesst und Du denkst Dir, dass dieser Rattenjunge eigentlich "
                  "ziemlich krank sein muss und mal ehrlich... Dir muss wohl auch "
                  "eine Schraube fehlen, wenn Du Dich zu so einem Bloedsinn "
                  "ueberreden laesst. Doch trotzdem faengst Du an zu "
                  "Lachen und vergisst Deinen Klettenmantel fuer eine Weile. "
                  "Der Rattenjunge laesst Dich los und grinst Dich mit einer "
                  "Fratze an, die alles andere als Freude vermuten laesst. "
                  "Endlich beruhigt er sich und faengt zu erzaehlen an... \n")
                 );
            write("\n\n");
            write(BSA(
                  "Der Schluessel zum ersten Stock des "
                  "verfallenen Hauses, befindet sich im Haus selbst. Ich habe "
                  "ihn, waehrend Du Dir dieses schoene Gewand aus Kletten besorgt "
                  "hast, dort versteckt. Ach ja und eine Sache noch... Es scheint "
                  "so, als spuke es dort. Ich bin mir nicht sicher, aber es "
                  "sieht so aus, als wuerden Geister dort ihr Unwesen treiben. Das "
                  "ist wohl auch einer der Gruende, warum bisher niemand das Haus "
                  "kaufen wollte. Doch nun geh' und viel Spass beim Suchen! ",
                  "Der Rattenjunge sagt: ")
                 );
            write(BS("Der Rattenjunge lacht laut und wendet sich dann ab."));
            questObject->SetProp("P_BUR_AMOUNT", -1);
            burs->SetProp(P_AMOUNT, -1);
          }	else {
            write(BSA("Du hast aber erst "+ burs->QueryProp(P_AMOUNT) +
              " Kletten, brauchst aber "+questObject->QueryProp("P_BUR_AMOUNT") +
              ". Vorher werde ich Dir nicht helfen!", "Der Rattenjunge jammert: "));
          }
        }
      }
    }
  }
}


string quest_ende()  {
  object substanz, kiste, questobj;
  substanz=deep_present("antifluchsubstanz_tithonsfluch", TP);
  
  questobj=deep_present(QUESTOBJECTID, TP);
  
  if( !substanz ) {
    return (
      "Ja, es gibt da eine magische Substanz, die mir "
      "angeblich helfen kann. Irgendwie muss es mit meinem "
      "Vater zu tun haben! Aber Tithon ist sehr maechtig und "
      "sein Fluch stark!");
  }		
  if(erloest!=0) {
    return BS("Ich bin doch kein Rattenjunge mehr! Gib Ruhe!");
  }
  if(substanz) {
    substanz->remove();
    if(deep_present("\nrockaestchen", TP)) {
      write( BSA(
        "AH! "+CAP_TPN+", danke! Du hast ja die magische Substanz! Her damit!",
        "Der Rattenjunge sagt: "));
    }	
    
    //if(!deep_present("\nrockaestchen", TP) || (TP->QueryQuest(QUESTNAME)==1) ) 
    
   // {

  // bugfixing by roc 7.11.2003 - spieler hat ein kaestchen,
  // oder es liegt wo rum?
  //if(deep_present("\nrockaestchen", TP) ||
  //     find_object("kaestchen_from_"+ geteuid(TP))) {
  if(deep_present("\nrockaestchen", TP)) {
    write(BSA("WAS?! Du hast ja schon ein Kaestchen!",
              "Der Rattenjunge zischt: "));
  } else {
    kiste=clone_object("d/dschungel/dante/ratmanquest/obj/kaestchen");
    kiste->move(TP, M_NOCHECK);
    write(BSA(
      "AH! "+CAP_TPN+", danke! Du hast ja die magische Substanz! Her damit! "
      "Hier, dafuer gebe ich Dir dieses wunderschoene Kaestchen!",
      "Der Rattenjunge bruellt: "));
    write("Der Rattenjunge gibt Dir ein wunderschoenes Kaestchen!\n");
  
  }
  
  //}  
    
    write("\nDer Rattenjunge nimmt Dir die Substanz weg und isst sie auf!\n\n");
    write(BS(
      "Der Rattenjunge beginnt sich "
      "ploetzlich zu dehnen und strecken und "
      "zu verwandeln. Sein Fell wird weniger und verschwindet, seine langen "
      "Nagezaehne werden kuerzer, sein Rattenschwanz faellt ab und "
      "ploetzlich steht ein huebscher, junger Knabe vor Dir, der Dir gluecklich "
      "um den Hals faellt und irgendetwas von 'endlich' und 'Erloesung' "
      "stammelt! Du hast den armen Rattenjungen erloest!"));
    write("\n");
    tell_room(environment(TO),
        "Der Rattenjunge verwandelt sich wieder in seine alte, normale "
        "Gestalt.\nDann faellt er "+TP->Name(WEM)+" dankbar um den Hals!\n",
        ({TP}));
    SetProp(P_NAME_ADJ, "ehemalig");
    SetProp(P_SHORT, "Der ehemalige Rattenjunge");
    SetProp(P_LONG, BS(
      "Du siehst einen ehemaligen Rattenjungen, der von "+CAP(getuid(TP))+" "
      "erloest wurde. Ob das auch wirklich von Dauer ist..."));
    erloest=1;  
    call_out("transform", TIME);
    
    if( TP->QueryQuest(QUESTNAME)!=1 ) {
      	      //redundanter muell
      switch (TP->GiveQuest(QUESTNAME)) {
        case 1:  write_file("/log/quests/tithonsfluch", 
                   dtime(time())+": "+ CAP(getuid(TP))+ 
                   " loest die Quest Tithons Fluch.\n");
                 break;
        default: write_file("/log/quests/tithonsfluch",
                   dtime(time())+": Fehler bei "+CAP(getuid(TP))+"!\n");
      }
      
      if(questobj)  {
        questobj->remove();         
      }
      if( questobj = deep_present("\nratkey_quest")) {
        questobj->remove();
      }
    }
    return BS("HURRA! Endlich bin ich wieder normal!");
  }
}    


transform() {
  tell_room(environment(TO),BS(
    "PLOPPPP!!!!! Ploetzlich mutiert der arme ehemalige Rattenjunge wieder "
    "zu einer ekligen Kreatur und sieht nun wieder wie eine grosse Ratte aus!"));
  domainshout(BS(
    "PLOPPPP!!!!! Ploetzlich mutiert der arme ehemalige Rattenjunge wieder "
    "zu einer ekligen Kreatur und sieht nun wieder wie eine grosse Ratte aus!"
    " Scheinbar hat ihm "+CAP(getuid(TP))+" doch nicht helfen koennen!"));
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_SHORT, "Der Rattenjunge");
  SetProp(P_LONG, BS(
    "Du siehst einen Rattenjungen, der zunaechst menschlich zu sein scheint, " 
    "auf den zweiten Blick aber einer Ratte sehr aehnlich sieht. Er huscht "
    "flink um Dich herum und beschnuppert alles mit seiner langen Nase, die "
    "geradezu uebertrieben zwischen den Knopfaugen herausragt. Zwei "
    "Rattenzaehne sind sehr stark ausgepraegt.")  );
  erloest=0;  
}


string spass(string wort) {
  object questObject;
  int burAmount; 
  int factor;
  int level;
  object newQuestObject;
  object burs;
  if( TP ) {
    if(erloest!=0) {
      return BS("Ich bin doch kein Rattenjunge mehr! Gib Ruhe!");
    }
    if(deep_present("\nkletten_gebracht", TP)) {
      return ("Aber "+TPN+" Du hast mich doch schon "
        "mit Kletten umarmt und zum Lachen gebracht!");
    }	
    if( TP->QueryQuest(QUESTNAME)==1 ) {
      return "Du bist aber ein komischer Kautz, ich dachte, eine "
          "Demuetigung haette Dir gereicht. Nun, Du weisst ja "
          "jetzt, wo sich der Schluessel befindet.";
    } else if( (questObject=deep_present(QUESTOBJECTID, TP))==0 ) {
      return "Spass kann ich spaeter haben, vorher moechte ich, dass Du "
        "mir hilfst, meine richtige Gestalt wiederzubekommen." ;
    } else {
      if( questObject->QueryProp("P_BUR_AMOUNT")==0 ) {
        /* Kein Eintrag fuer Kletten vorhanden */
        level=TP->QueryProp(P_LEVEL);
        //das is verdammt viel!!! ueberleg dir das nochmal, dante.
        //anzahl herabgesetzt weiter runter
        burAmount=10+(random(10+(factor*10))+level);
        questObject->SetProp("P_BUR_AMOUNT", burAmount);
        return BS("Ich moechte mir einen Spass mit Dir erlauben. Es gibt "
            "im Silberland ein Wesen, das Dich mit Kletten bewirft "
            "wenn Du es angreifst. Lass Dich mit, sagen wir, "+
            burAmount +" Kletten bewerfen, komm dann zu mir zurueck "
            "und umarme mich damit.");
      } else {
        /* Questobject vorhanden */
        if( deep_present("\nklette", TP)==0 ) {
          return "Du hast ja ueberhaupt keine Klette an Dir haengen! "
            "So werde ich nie zu meinem Spass kommen... Geh' und "
            "lass Dir die "+ questObject->QueryProp("P_BUR_AMOUNT")+
            " Kletten anhaengen, bevor Du das naechste Mal zu mir "
            "kommst!";
        } else {
          burs=deep_present("\nklette", TP);
          if( burs->QueryProp(P_AMOUNT) >= 
              questObject->QueryProp("P_BUR_AMOUNT") ) {
            return BS("Prima, Du hast genug Kletten an Dir, jetzt musst Du "
                "mich damit nur noch umarmen!");
          } else {
            return BS("Ja, ich weiss, dass Du mir helfen willst, aber Du "
                "hast noch nicht genug Kletten an Dir, denn es sind "
                "bisher erst "+ burs->QueryProp(P_AMOUNT) +". Wenn Du "+
                questObject->QueryProp("P_BUR_AMOUNT") +" Kletten hast, "
                "komm wieder und umarme mich!");
          }
        }
      }
    }
  }
}


void init() {
  ::init();
  if (interactive(TP)) call_out("hallo", 0);
}


void hallo() {
  if(environment(TP)!=environment(TO))  { return;  }	
  if( getuid(TP)=="dante" ) {
    tell_object(TP, 
      "Der Rattenjunge grinst Dich an und streckt die Zunge raus.\n");
    tell_room(environment(TP), 
      "Der Rattenjunge grinst Dante an und streckt ihm die Zunge "
      "heraus.\n", ({TP}));
    return;
  }
  if( getuid(TP)=="roc" ) {
    tell_object(TP, 
      "Der Rattenjunge kuschelt sich an Dich an.\n");
    tell_room(environment(TP), 
      "Der Rattenjunge kuschelt sich an Roc an.\n", ({TP}));
    return;
  }
  if( getuid(TP)=="buzzom" ) {
    tell_object(TP, "Der Rattenjunge lacht Dich aus.\n");
    tell_room(environment(TP), "Der Rattenjunge lacht Buzzom aus.\n", ({TP}));
    return;
  }
  if( getuid(TP)=="yeza" ) {
    tell_object(TP, "Der Rattenjunge zupft an Deinen Zoepfen.\n");
    tell_room(environment(TP), "Der Rattenjunge zupft Yeza an den "
      "Zoepfen.\n", ({TP}));
    return;
  }
  if( getuid(TP)=="wotan" ) {
    tell_object(TP, 
      "Der Rattenjunge steckt Dir ein Skript zu.\n");
    tell_room(environment(TP), 
      "Der Rattenjunge steckt Wotan ein Skript zu.\n", ({TP}));
    return;
  }
  if( getuid(TP)=="baldur" ) {
    tell_object(TP, "Der Rattenjunge fragt Dich nach Jenni.\n");
    tell_room(environment(TP), "Der Rattenjunge fragt Baldur "
      "etwas.\n", ({TP}));
    return;
  }
  if( getuid(TP)=="fenris" ) {
    tell_object(TP, "Der Rattenjunge zwickt Dir in den Po.\n");
    tell_room(environment(TP), "Der Rattenjunge zwickt Fenris in den "
      "Po.\n", ({TP}));
    return;
  }
  write("Der Rattenjunge zuckt zusammen.\n");
  return;
}


