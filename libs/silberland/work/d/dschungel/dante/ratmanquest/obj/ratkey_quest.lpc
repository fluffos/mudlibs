//dante sl 99

inherit "std/thing";

#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <thing.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein kleiner Schluessel");
  SetProp(P_LONG,BS(
  	"Dieser kleine Schluessel gehoerte einst dem Rattenjungen in "
  	"Tijara.") );

  AddId(({"schluessel","ratkey", "\nratkey_quest"}));

  SetProp(P_NAME,"Schluessel");
  SP(P_VALUE, 0);
  SP(P_WEIGHT, 10);
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
  SetProp(P_GENDER,MALE);
  SetProp(P_MATERIAL,([MAT_STEEL:100]));
}

	
