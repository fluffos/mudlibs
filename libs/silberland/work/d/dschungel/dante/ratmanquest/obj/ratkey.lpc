//dante sl 99

inherit "std/thing";

#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <thing.h>
#define QUESTKEY "Tithons Fluch"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein kleiner Schluessel");
  SetProp(P_LONG,BS(
  	"Dieser kleine Schluessel gehoerte einst dem Rattenjungen in "
  	"Tijara.") );

  AddId(({"schluessel","ratkey", "\nratkey_normal"}));

  SetProp(P_NAME,"Schluessel");
  SP(P_VALUE, 0);
  SP(P_WEIGHT, 10);
  SetProp(P_GENDER,MALE);
  SetProp(P_MATERIAL,([MAT_STEEL:100]));
}

int _query_noget()
{
  if(!TP || !interactive(TP)) return 0;
  if(!TP->QueryQuest(QUESTKEY))
    return write("Dieser Schluessel ist der falsche fuer dich!\n"),1;
  if(deep_present("\nratkey_normal", this_player()))
    return write("Du hast ja schon solch einen Schluessel!\n"),1;
  return 0; 
} 
