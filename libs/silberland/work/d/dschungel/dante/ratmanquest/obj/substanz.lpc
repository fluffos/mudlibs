/*
die substanz die der rattenjungenvater verliert wenn er stirbt
zum junge gehen, nach erloesung fragen-->kaestchen bekommen!!!
dante
*/

#include "/players/dante/myowndefine.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>


create()
{
  if (!is_clone(TO) )  return;

  ::create();


  SetProp(P_SHORT, "Eine merkwuerdige weissliche Substanz");
  SetProp(P_LONG, BS(
"Diese Substanz schimmert weisslich und ist halbfest und halbweich. "
"Irgendwie pulsiert sie magisch. "
"Sie enthaelt jegliche Energie des Rattenjungenvaters und vielleicht "
"kannst Du damit ja dem Rattenjungen helfen!"));
 
  SetProp(P_NAME, "Substanz");
  SP(P_NAME_ADJ, "merkwuerdig");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  AddId(({"substanz","antifluchsubstanz_tithonsfluch","antifluchsubstanz"}));
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
  


 }