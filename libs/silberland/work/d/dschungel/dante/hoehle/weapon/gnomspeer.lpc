//gnomenspeer dante sl 98

#include "../def.h"
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Gnomenspeer");
  SetProp(P_LONG, BS( 
  "Dieser Speer ist an die 3 Meter lang. Du wunderst Dich, dass ein eher "
  "kleines Lebewesen, wie ein Hoehlengnom, so eine Waffe besitzt. Sie ist "
  "trotz ihrer Laenge sehr leicht und dadurch im Kampf auch gut zu fuehren. "
  "An ihrem Schaft kannst Du eine Verzierung erkennen. Die Spitze "
  "des Gnomenspeers ist unglaublich spitz, ideal um Deine Feinde aufzuspiessen."));
  AddDetail("schaft",
  "Am Schaft ist eine Verzierung.");
  AddDetail("verzierung",
  "Sie zeigt einen Gnom.");
  AddDetail(({"gnom","hoehlengnom"}),
  "Der Hoehlengnom grinst boesartig und scheint Dich zu fixieren!");
  AddDetail("waffe",
  "Fuer manche eine sehr brauchbare Waffe!");
  AddDetail("laenge",
  "In etwas 3 Meter.");
  AddDetail("spitze",
  "Sehr spitz!");
  
  SetProp(P_NAME,"Gnomenspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer","gnomenspeer", "\ngnomenspeer"}) );
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC,180);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_SIZE, 300);
  SetProp(P_MATERIAL, ([MAT_STEEL:20, MAT_OAK:80]));
  SetProp(P_WEIGHT, 350);
  SetProp(P_MAGIC, 0);
  SetProp(P_VALUE,2000+random(300));
  SetProp(P_NOBUY, 1);
}
