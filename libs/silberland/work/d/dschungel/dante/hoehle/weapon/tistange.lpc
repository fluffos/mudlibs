inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"stange", "TIREKS_STANGE","magiestange"}));
  SetProp (P_SHORT, "Eine lange, schwarze Stange");
  SetProp (P_LONG, BS(
"Diese Stange wurde aus schwarzem Stahl geschmiedet. Angeblich "
"war der Erschaffer ein Zwergenschmied. Sie muss fuer Ewigkeiten "
"in dieser Stele gelagert gewesen sein. Trotzdem scheint sie noch "
"sehr brauchbar. Ihre Spitze scheint manchmal gruen zu gluehen..."));
AD("stahl",
"Haertester schwarzer Stahl!");
AD("spitze",
"Die Spitze glueht ab und zu gruen. Welchen Sinn das wohl hat?!\n");

  SP(P_NAME_ADJ, ({"lang", "schwarz"}));
  SetProp (P_NAME, "Stange");
  SetProp (P_GENDER, FEMALE);
 SetProp(P_MAGIC, 1);
 SP(P_INFO, BS("Die Stange soll bestimmten Wesen dauerhaft ihre Faehigkeit zu "
 "zaubern reduzieren. Man kann mit ihr zustechen..."));
SP(P_WIELD_RESTRICTIONS, ([A_STR: 15]));

  SetProp (P_VALUE, 8000);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_SPEAR);
  SetProp (P_DAM_TYPE, DT_RIP);
  SetProp(P_NOBUY, 1);
  SetProp (P_WC, 100);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, ([MAT_MAGIC:1]));
}

