//dante sl 99!!!!!!!


inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"axt", "TIREKS_AXT","doppelaxt"}));
  SetProp (P_SHORT, "Eine schwere Doppelaxt");
  SetProp (P_LONG, BS(
"Diese Axt ist enorm gross und schwer. Sie hat ein doppelseitiges, "
"extrem scharfes Axtblatt, das im Licht hell aufblitzt!"));
AD(({"blatt","axtblatt"}),
"Doppelseitig und extrem scharf!");


  SP(P_NAME_ADJ, ({"schwer"}));
  SetProp (P_NAME, "Doppelaxt");
  SetProp (P_GENDER, FEMALE);
 SetProp(P_MAGIC, 1);
 SP(P_INFO, BS(
"Die Doppelaxt soll gegen die Krallen eines bestimmten Unwesens "
"wirken! Man kann mit ihr angeblich die Krallen abhacken!!!"));

SP(P_WIELD_RESTRICTIONS, ([A_STR: 15]));

  SetProp (P_VALUE, 8000);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_WEAPON_TYPE, WT_AXE);
  SetProp (P_DAM_TYPE, DT_RIP);
  SetProp(P_NOBUY, 1);
  SetProp (P_WC, 150);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, ([MAT_STEEL:1, MAT_OAK:99]));
}

