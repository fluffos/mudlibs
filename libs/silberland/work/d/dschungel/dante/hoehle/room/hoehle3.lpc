// 

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer finsteren Kammer" );
  SetProp( P_INT_LONG, BS(
        "Du befindest mitten in der Wohnkammer eines Riesenskorpions, der nur auf "
        "dumme Abenteurer wie Dich gewartet hat. Ueberall liegen die Reste seiner "
        "Opfer herum und Du denkst auch schon an Flucht..."));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ("boden"),
      "Der Boden ist voellig sauber. Nur manchmal sieht man einige Lachen, die "
      "das Wasser, das von den Waenden tropft, bildet.");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus rauhem Naturstein. Du kannst einige Kratzer "
      +"erkennen.\n");
  AddDetail(("kratzer"),
      "Die Spuren an den Waenden scheinen von gewaltigen Werkzeugen "
      +"herzuruehren.\n");
  AddDetail( ({"spuren", "werkzeug", "werkzeuge"}),
      "Man braucht schon gutes Werkzeug um solche Kratzer zu erzeugen.");
  AddDetail(("knochen"),
      "Einige sehr sauber angenagte Knochen liegen hier herum.");
  AddDetail(("decke"),
      "An der Decke erkennst Du ein Loch. Du koenntest es erreichen...");
  AddDetail(("opfer"),
      "Du siehst Knochen wohin Du nur blickst...");
  AddDetail(("stein"),
      "Der Stein ist rauh und weisst viele Risse auf.");
  AddDetail(({"risse","riss"}),
      "Die Risse bilden lange Furchen in den Waenden.");
  AddDetail(({"furche","furchen"}),
      "In dem Furchen rinnt manchmal ein wenig Wasser nach unten.");
  AddDetail(("wasser"),
      "Das Wasser sammelt sich am Boden und bildet kleine Lachen.");
  AddDetail(({"lachen","lache"}),
      "In den Lachen kannst Du Dein verschwommenes Spiegelbild sehen.");
  AddDetail(({"bild","spiegelbild"}),
      "Du schaust aengstlich und eingeschuechtert aus...");
  AddDetail(("naturstein"),
      "Welche Sorte Stein es ist weisst Du nicht...");
  AddDetail(("sorte"),
      "Hmm, was koennte das sein...");
  AddDetail(({"reste","rest"}),
      "Einige der Knochen sehen grausam verstuemmelt aus.");
  AddSound( ({DEFAULT_SOUND, "geraeuscche"}),
      "Der Riesenskorpion macht grausige Geraeusche.");
  AddDetail(("loch"),
      "Durch das Loch in der Decke koenntest Du nach oben gelangen.");
  AddSmell( DEFAULT_SMELL,
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");

  AddExit( "norden", "./hoehle2");
  AddItem(NPC"dskor2" , REFRESH_DESTRUCT);
  AddItem(WEAPON_WEG"dknochen" , REFRESH_REMOVE);
  AddGuardedExit("oben", "/d/dschungel/dante/hoehle/room/hoehle4", "skorpion",
      "Der Skorpion laesst Dich nicht vorbei.\n"); 

} 


