// hoehle 2

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int schlamm;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer finsteren Hoehle" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun tiefer in der Hoehle. Der Raum hier ist seltsamer Weise "
        "bis auf einige Knochen voellig sauber und kahl geputzt. Du wunderst Dich, wer "
        "wohl dafuer sorgt, dass alles hier so aufgeraeumt aussieht..."));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({"hoehle"}),
      "Du bist in einer finsteren Hoehle."),
  AddDetail(("stein"),
      "Der Stein sieht rauh und hart aus...");
  AddDetail(("naturstein"),
      "Manchmal rinnt etwas Wasser die Waende nach unten...");
  AddDetail(("wasser"),
      "Das Wasser bildet am Boden grosse Lachen.");
  AddDetail(("lachen"),
      "Die Lachen scheinen voller Schlamm und Dreck zu sein.");
  AddDetail(("dreck"),
      "Ganz normaler, brauner Dreck...");
  AddDetail(("boden"),
      "Der Boden ist voellig sauber.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein. Du kannst einige Kratzer erkennen.\n");
  AddDetail(("kratzer"),
      "Die Spuren an den Waenden scheinen von gewaltigen Werkzeugen herzuruehren.\n");
  AddDetail( ({"spuren", "werkzeug", "werkzeuge"}),
      "Man braucht schon gutes Werkzeug um solche Kratzer zu erzeugen.");
  AddDetail(("knochen"),
      "Einige sehr sauber angenagte Knochen liegen hier herum.\n");
  AddDetail(("decke"),
      "Die Decke ist zu hoch oben um etwas zu erkennen.\n");

  AddSound( DEFAULT_SOUND,
      "Aus dem Nebenraum kannst Du etwas krabbeln hoeren.");

  AddSmell( ({DEFAULT_SMELL, "tod", "verwesung"}),
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");

  AddItem(NPC"dfledermaus" , REFRESH_DESTRUCT);
  AddExit( "norden", "./hoehle11");
  AddExit( "osten", "./hoehle2");

  schlamm=1;
  AddSpecialDetail(({"schlamm"}),"d_schlamm");

}

string d_schlamm()
{
  object ob;
  if( schlamm )
  {
    write( " \n"
        "Du starrst in den Schlamm und ploetzlich...\n");
    ob = clone_object(NPC_WEG "dschlamm2.lpc");
    ob->move(environment(TP), M_TPORT);
    if(IS_WIZARD(TP))
      write("Der Schlammspringer traut sich nicht, Dich anzugreifen.\n");
    else
      ob->Kill(TP);
    schlamm--;
    return(""); 
  }
  else
    return "Du siehst nur Schlamm.\n"; 
}

void reset()
{
  ::reset();
  schlamm=1;
}



