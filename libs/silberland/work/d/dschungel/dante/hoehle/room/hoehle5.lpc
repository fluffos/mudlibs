// hoehle 5

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
nosave int stein;

create()
{ 
  ::create();

  SetProp( P_INT_SHORT, "In einem engem Schacht" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich in einem engem Schacht, den man aber muehelos nach "
        "unten oder oben durchklettern kann. Die Waende bestehen aus grauem Naturstein "
        "und weisen viele Risse und Furchen auf. Sonst ist hier nichts interessantes "
        "zu erkennen..."));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail(("stein"),
      "Der Stein ist grau und rauh...");
  AddDetail(("naturstein"),
      "Der Stein ist grau, zerklueftet und sehr uneben.");
  AddDetail(({"wand","waende"}),
      "Die Waende hier sind rauh und zerfurcht.");
  AddDetail(("decke"),
      "Die Decke ist zu hoch oben um etwas zu erkennen.\n");
  AddDetail( "boden",
      "Der Boden ist zu weit unten um etwas zu erkennen.\n");
  AddDetail(("nische"),
      "Genau kannst Du die Nische in diesem schlechten Licht nicht erkennen, aber "
      "Du kannst hineingreifen.");

  AddItem(NPC"dfledermaus" , REFRESH_DESTRUCT); 

  AddDetail(({"riss","risse"}),
      "Die Risse ziehen sich entlang der gesamten Wand...");
  AddDetail(({"furche","furchen"}),
      "Die langen tiefen Furchen zerklueften die ganze Wand. Manchmal erkennt man "
      "etwas Moos und Farne.");
  AddDetail(("moos"),
      "Das Moos ist gruen und saftig.");
  AddDetail(({"farn","farne"}),
      "Die Farne wachsen irgendwie nach einer Dir unbekannten Ordnung.");
  AddDetail(("ordnung"),
      "Seltsam aber die Farne bilden einen Kreis.");
  AddDetail(("kreis"),
      "In der Mitte des Kreises entdeckst Du einen kleinen, dunklen Fleck.");
  AddDetail(("fleck"),
      "Der Fleck erweist sich als eine kleine Nische."); 
  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
      "Von unten hoerst Du seltsame Geraeusche.");

  AddSmell( ({DEFAULT_SMELL, "tod", "verwesung"}),
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");
  stein = 1; 

  AddCmd(({"greife", "greif"}), "greifen");

  AddExit( "unten", "./hoehle4");
  AddExit( "oben", "./hoehle6");
}

reset()
{
  stein=1;
  ::reset();
}

int greifen (string str)
{
  notify_fail("Wo willst Du hinein greifen?");
  if (str !="in nische")  return 0; 

  if (!stein) 
  {
    write(BS("Du greifst in die Nische und spuerst einen stechenden Schmerz. "
          "Sofort ziehst Du Deine Hand wieder zurueck!"));
    TP->do_damage(10);
    say(CAP_TPN+" greift in eine Nische, zieht aber seine hand schnell wieder zurueck.\n");
    return 1;
  }

  write(BS("Du greifst in die Nische und findest einen schweren Gegenstand, "
        "den Du sofort einsteckst."));
  CLONE(OBJ"dsi", TP);
  say(CAP_TPN+" greift in eine Nische und schaut Dich dann erfreut an.\n");
  stein--;
  return 1;
}

