// hoehle 4 dante sl 97 maerz

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
object cash;

int stange=1;
int pulled=0;
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Hoehle des Mutantenvampirs" );
  SetProp( P_INT_LONG, BS(
        "Du stehst in der finsteren Hoehle des Mutantenvampirs. Alles hier ist "
        "voller Schleim, Blut und den Ueberresten von Opfern. Es riecht nach "
        "Verwesung und Tod. Hau lieber ab, wenn Dir Dein Leben was wert ist, "
        "denn dieser Ort koennte Dein Grab werden. In der Mitte des Raums "
        "steht eine seltsame Stele. "));
  AD("grausen",
      "IHHHHH!!!!");
  AddDetail("stele",
      "Sie besteht aus festem Stahl. Irgendwie "
      "sieht sie sehr seltsam aus.");
  AddDetail(({"berx", "freunde","stahldorn","muddymud","homer","levitikus"}),
      "Grausam geschlachtet wurden sie.");
  AddDetail("verfasser",
      "Der abgrundtief boese Dante.");
  AddDetail("dante",
      "WUAHHHHHHHHHHHHA!");
  AddDetail("tropfen",
      "Plitsch!");
  AD(({"kopf","fuss","mund","nase","tod", "auge"}),
      "Du ekelst Dich!");
  AddDetail("auswahl",
      "Es koennten noch mehr sein.");
  AddDetail("gewissen",
      "Was ist das?");
  AddDetail("stahl",
      "Der Stahl ist rauh und weist einige Kratzer auf.");
  AddDetail("kratzer",
      "Die Kratzer sind sehr tief und haben seltsame Formen!");
  AddDetail(({"raum", "mitte"}),
      "Du stehst im Raum. In der Mitte steht eine Stele.");
  AddDetail(({"formen","form"}),
      "Irgendwie sehen alle Kratzer zusammen wie eine boesartige Fratze aus.");
  AddDetail("fratze",
      "Die Fratze scheint Dich auszulachen! Mach es doch gleich!");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("schleim"),
      "Woher stammt der eklige gruene Schleim bloss ?");
  AddDetail(("verwesung"),
      "Hier stinkt es furchtbar...");
  AddDetail(({"reste","ueberreste"}),
      "WAEH!!! Da liegt die Hand von Levitikus, das Auge von Stahldorn, der Fuss "
      "von Homer, die Nase von Berx, der Kopf von Muddymud und vieles mehr. Mit "
      "Grausen wendest Du Dich von den Resten Deiner alten Freunde ab. "
      "(Anmerkung des Verfassers: Keiner soll beleidigt sein, weil er hier "
      "nicht erwaehnt wurde. Die Auswahl ist rein zufaellig...)");

  AddDetail(("blut"),
      "Sogar die Decke ist bluttriefend.");
  AddDetail(("decke"),
      "IGITT!!! Ein dicker Tropfen Blut faellt genau in Deinen offenen Mund!");
  AddDetail(({"opfer","opfern"}),
      "Zerfetzt und zerrissen stapeln sich hier ihre Leichen.");
  AddDetail(({"leiche","leichen"}),
      "Die Leichen sehen alle uebel zugerichtet aus. Eine scheint mit der Hand in "
      "eine Ecke zu zeigen.");
  AddDetail(("hand"),
      "Die Hand zeigt in eine bestimmte Ecke.");
  AddDetail(("ecke"),
      "In der Ecke kannst Du einige Zeichen erkennen.");
  AddDetail(("zeichen"),
      "Du kannst sie lesen.");
  AddReadDetail(("zeichen"),
      "   \n"
      "                               R.I.P.\n"
      " \n");
  AD("hoehle",
      "In der Hoehle des Mutantenvampirs!");
  AddDetail( ("boden"),
      "Der Boden ist uebersaeht mit vermoderten Leichen.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende sind blutbespritzt.\n");
  AddDetail(({"stein","naturstein"}),
      "Hier hat man frueher Stein sehen koennen, aber nun ist alles "
      +"blutverschmiert.");
  AddDetail(("leben"),
      "Dein Gewissen raet Dir schnell von hier zu verschwinden...");
  AddDetail(("grab"),
      "Dein Grab ist nicht hier, aber dafuer entdeckst Du einen kleinen Spalt! ");
  AddDetail("spalt",
      "Im Spalt siehst Du einen Hebel und daneben ein Schild!!!");
  AD("hebel",
      "Den kann man sicher ziehen!");
  AD("schild",
      "Lesen!");
  ARD("schild",
      "+---------------------+\n"
      "| Erst den Vampir,    |\n"
      "| dann Hebel hier!    |\n"
      "| Und nun viel Glueck |\n"
      "| beim Fratzenstueck! |\n"
      "+---------------------+\n");

  AddDetail(("ort"),
      "Dieser Ort ist Dir nicht ganz geheuer.");

  AddSound( DEFAULT_SOUND,
      "Hier glaubt man den Tod zu hoeren.");

  AddExit( "westen" , "./loch3");


  AddItem("/d/dschungel/dante/hoehle/npc/dvamp", REFRESH_DESTRUCT);

  AddSmell( DEFAULT_SMELL,
      "Hier stinkt es grauslich nach Verwesung...");
  AddSmell("verwesung",
      "Es stinkt wirklich hier."); 
  AddCmd(({"lach","lache"}), "go");
  AddCmd(({"zieh","ziehe"}), "do_hebel");

}


int do_hebel(string str)   
{
  NF("Was willst Du ziehen?!\n");
  if(str=="hebel"||str=="hebel runter")  
  {
    if (present("mutantenvampir"))
    {
      write("Der Vampir schlaegt Dir ins Gesicht!\n");
      say("Der Vampir schlaegt "+TPN+" ins Gesicht!\n");
      TP->do_damage(10+random(10));
      return 1;
    }
    if(pulled)  
    {
      write("Du ziehst den Hebel, doch nichts passiert!\n");
      say(CAP_TPN+" zieht einen Hebel!\n");
      return 1; 
    }
    if(!pulled)  
    {
      write("Du ziehst einen Hebel und die Stele seufzt laut!\n");
      say(CAP_TPN+" zieht einen Hebel und man hoert ein Geraeusch!\n");
      pulled=1; 
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


int go(string str)
{
  object ob;

  notify_fail("Wen oder was willst Du auslachen?\n");
  if(member(({"fratze aus", "fratze"}), str)!=-1)
  {
    if (present("mutantenvampir"))
    {
      write("Der Vampir schlaegt Dir ins Gesicht!\n");
      say("Der Vampir schlaegt "+TPN+" ins Gesicht!\n");
      TP->do_damage(10+random(10));
      return 1;
    }
    if(!pulled)   {
      write("Du lachst die Fratze aus!\n"
          "Ein Blitz schiesst aus der Fratze direkt in Deine Augen!\n");
      TP->SetProp(P_BLIND, 100);
      say(CAP_TPN+" wird von einem Blitz getroffen!\n");
      return 1; 
    }

    if(!stange)   {
      write(BS("Du lachst die Fratze aus, doch die Zeit ist noch "
            "nicht reif genug!"));
      say(CAP_TPN+" lacht die Fratze aus, doch nichts!\n");
      return 1; 
    }
    if(stange)
    {
      write(BS(
            "Du lachst die Fratze aus! "
            "Die Fratze verzerrt sich und ploetzlich broeselt etwas Stahlstaub "
            "von der Stele und eine seltsame Stange faellt in Deine Arme!"));

      say(CAP_TPN+" lacht auf und ploetzlich broeckelt etwas aus der Stele heraus!\n");
      stange=0;
      ob=clone_object("/d/dschungel/dante/hoehle/weapon/tistange");
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    return 0;
  }
  return 0;
}

reset(){
  ::reset();
  stange=1;
  pulled=0;

}

