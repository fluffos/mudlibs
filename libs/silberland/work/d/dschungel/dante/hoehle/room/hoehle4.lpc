// hoehle 4

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <rooms.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem engem Schacht" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich in einem engem Schacht, den man aber muehelos nach "
        "unten oder oben durchklettern kann. Die Waende bestehen aus grauem "
        "Naturstein und weisen viele Risse und Kratzer auf. Sonst kann man hier "
        "eigentlich nicht viel entdecken."));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(({"riss","risse"}),
      "Die Risse laufen der ganzen Wand entlang.");
  AddDetail(("kratzer"),
      "Viele tiefe Kratzer zerteilen die Wand in viele kleine Flaechen.");
  AddDetail(({"flaeche","flaechen"}),
      "Die Flaechen haben teilweise amuesante Muster.");
  AddDetail(("muster"),
      "Viele verschiedene Flaechen und Muster, wie ein grosses Puzzle...");
  AddDetail(("puzzle"),
      "Die Natur ist doch der groesste Baumeister...");
  AddDetail(("natur"),
      "Du denkst Dir . o O 'Ich sollte vielleicht naturbewusster leben...'\n");
  AddDetail(("boden"),
      "Den Boden der unter Dir liegenden Kammer kannst Du kaum mehr erkennen.");
  AddDetail(("kammer"),
      "Dort unten wohnt ein Riesenskorpion.");
  AddDetail(({"skorpion","riesenskorpion"}),
      "Als Du so ueber den Riesenskorpion nachdenkst, faellt Dir etwas an der Wand auf.");
  AddDetail(("etwas"),
      "Das Etwas ist bei naeherer Betrachtung eine Zeichnung.");
  AddDetail(("zeichnung"),
      "Irgend ein Witzbold hat hier einen Skorpion gezeichnet, der gerade einen "
      "Abenteurer zerfetzt...");
  AddDetail(("witzbold"),
      "Der Witzbold war sicher Dante...");
  AddDetail(({"wand","waende", "naturstein", "stein", "fels"}),
      "Die Waende bestehn aus rauhem Naturstein und sind ziemlich zerfurcht.");
  AddDetail(("decke"),
      "Die Decke ist zu hoch oben um etwas zu erkennen.");

  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
      "Von unten hoerst Du seltsame Geraeusche.");

  AddSmell( ({DEFAULT_SMELL, "tod", "verwesung"}),
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");

  AddItem(NPC_WEG"dratte" , REFRESH_DESTRUCT);
  AddExit( "unten", "./hoehle3");
  AddExit( "oben", "./hoehle5");
}
