// hoehle 2

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int skelett;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer finsteren Hoehle" );
  SetProp( P_INT_LONG, BS(
        "Du stehst in einem finsteren, engen Spalt. Rund herum nur grauer, kahler "
        "Stein. Der Raum scheint ziemlich genau quadratisch zu sein. Etwas faellt "
        "Dir hier aber doch auf...\n"));

  AddDetail(({"skelett", "abenteurer"}),
      "Das war einmal ein Abenteurer, der hier verhungert ist. "
      "Irgendwie sehen die Augen des Skelettes noch sehr lebendig aus...");    
  AddDetail(({"ecke","ecken"}),
      "In einer der Ecken liegt ein altes Skelett.");    
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("etwas"),
      "Ja, in der Ecke liegt etwas.");

  AddDetail( ("boden"),
      "Der Boden besteht aus blankem Stein. Irgendjemand hat einen Pfeil in den "
      "harten Boden geritzt.");
  AddDetail(("pfeil"),
      "Der Pfeil weist auf eine kleine Linie.");
  AddDetail(("linie"),
      "Die Linie fuehrt zu einem Punkt.");
  AddDetail(("punkt"),
      "Rund um den Punkt siehst Du einen Kreis und ein kleiner Kaefer krabbelt herum.");
  AddDetail(("kaefer"),
      "Der Kaefer krabbelt nach Osten...");
  AddDetail(("osten"),
      "Im Osten liegt die Ostwand.");
  AddDetail(("ostwand"),
      "Erst jetzt faellt Dir in der Ostwand ein kleiner Durchschlupf auf.");
  AddDetail(("durchschlupf"),
      "Durch den kannst Du nach Osten schluepfen.");
  AddDetail(("kreis"),
      "Der Kreis hat seltsame Dellen.");
  AddDetail(({"delle","dellen"}),
      "Die Dellen sehen wie ein Krater aus.");
  AddDetail(("krater"),
      "Im Krater sieht man einen Pfeil.");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein.\n");
  AddDetail(({"stein","naturstein"}),
      "Du bist leider kein Geologe und weisst daher nicht um welchen Stein es "
      "sich hier handelt.");
  AddDetail(("spalt"),
      "Durch diesen Spalt kann man kriechen.");

  AddDetail(("decke"),
      "An der Decke sieht man komische Zeichen.\n");

  AddDetail(("zeichen"),
      "Du kannst sie lesen...");
  AddReadDetail(("zeichen"),
      " \n"
      "Wer das liest ist doof."
      " \n");
  AddSound( DEFAULT_SOUND,
      "Hier ist es voellig still.");

  AddSpecialDetail(({"auge","augen"}), "d_skelett");
  skelett=1;

  AddSmell( DEFAULT_SMELL,
      "Eigentlich riecht es hier nach nichts.");

  AddCmd(({"krieche","kriech"}), "kriechen");
  AddCmd(({"schluepfe","schluepf"}), "schluepfen");

  AddExit( "nordwesten", "./hoehle13");
}

kriechen (string str)
{
  notify_fail("Wo willst Du hinein kriechen ?\n");
  if ( !str ) return 0;  
  if ( member( ({"in spalt", "durch spalt", "in spalte","durch spalte"}),str) !=-1 )
  {
    write(" \n"
        "Du kriecht mit grosser Muehe durch den Spalt.\n");
    TP->move("/d/dschungel/dante/hoehle/room/hoehle11", M_GO,
        "mit grosser Muehe durch den Spalt.","kriecht",
        "kommt durch den Spalt gekrochen.");
    return 1;
  }
  return 0;
}

string d_skelett()
{
  object ob;
  if( skelett)
  {
    write( " \n"
        "Du betrachtest Dir die Augen des Skelettes naeher und ploetzlich...\n"
        " \n");
    ob = clone_object("/d/dschungel/dante/hoehle/npc/dskelett.lpc");
    ob->move(environment(TP),M_TPORT,M_SILENT);
    skelett--;
    if(IS_WIZARD(TP))
      write("Das Skelett traut sich nicht, Dich anzugreifen.\n");
    else
      ob->Kill(TP);
    return("");
  }
  else
    return "Die Augen schauen doch leblos aus. War wohl eine Taeuschung.\n";
}

schluepfen (string str)
{
  notify_fail("Wo willst Du durch schluepfen ?\n");
  if ( !str ) return 0;  
  if ( member( ({"in durchschlupf", "durch durchschlupf"}),str) !=-1 )
  {
    write(" \n"
        "Du schlupfst geschickt durch den Durchschlupf.\n");
    TP->move("/d/dschungel/dante/hoehle/room/loch5", M_GO,
        "geschickt durch den Durchschlupf.","schluepft",
        "kommt durch den Durchschlupf geschluepft.");
    return 1;
  }
  return 0;
}

