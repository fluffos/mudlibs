// fels 5 mit quellee heilstelle  by dante 97

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

int wasser;

create()
{
  ::create();
  wasser=2;
  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  SetProp( P_INT_LONG, 
      "Das enge Loch erweitert sich hier zu einer kleinen Hoehle, in die "
      "von oben durch schmale Ritzen Licht faellt. Der Boden ist hier saftig "
      "und sehr feucht und an den Waenden laeuft Wasser herunter, das sich "
      "zu einer kleinen Pfuetze sammelt. Im Westen endet die Hoehle an einer Felswand.");
  AddDetail("raum", QueryProp(P_INT_LONG));
  AddDetail(("westen"),
      "Im Westen scheint eine Felswand den Raum abzuschliessen.");
  AddDetail(("felswand"),
      "Die Felswand weist viele Spalten auf.");
  AddDetail(({"spalte","spalten"}),
      "Du erkennst, dass Du durch eine besonders grosse Spalte ohne Probleme hindurch gehen kannst.");
  AddDetail(({"ritze","ritzen"}),
      "In den Waenden kann man viele kleine Ritzen erkennen.");
  AddDetail(("hoehle"),
      "Die Hoehle macht einen verwachsenen Eindruck. Ueberall sieht man Pflanzen "
      "und kleine Rinnsale.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("pfuetze"),
      "Das herabfliessende Wasser sammelt sich am Boden und versiegt dann "
      "langsam im Erdreich.");
  AddDetail(("erdreich"),
      "Die Erde hier ist braun und weich.");
  AddDetail(("erde"),
      "Als Du Dir die Erde naeher betrachtest fallen Dir Spuren eines Kampfes auf.");
  AddDetail(({"spur","spuren"}),
      "Hier muss ein furchtbarer Kampf stattgefunden haben. Alles ist voller Blut.");
  AddDetail(("blut"),
      "Alles ist damit besudelt.");
  AddDetail(("loch"),
      "Das Loch erweitert sich hier zu einer Hoehle.");
  AddDetail(({"boden"}),
      "Der Boden schein eine ideale Naehrquelle fuer Pflanzen zu sein.");
  AddDetail( ({"quelle","naehrquelle"}),
      "Hier gedeihen einige Pflanzen, was Dich doch etwas erstaunt.");

  AddDetail(({"wand","waende"}),
      "Kleine Rinnsale laufen die Waende herab und sorgen fuer ein feuchtes "
      "Klima, in dem Pflanzen sicher gut gedeihen.");
  AddDetail(("klima"),
      "Feucht und schwuel ist es hier. Aber trotzdem scheint die Luft angenehm zu sein.");
  AddDetail(({"rinnsale","rinnsal"}),
      "Das Wasser plaetschert munter von der Decke herab... ");
  AddDetail(({"decke"}),
      "Platsch! Als Du Dir die Decke betrachtest faellt Dir ein Wassertropfen "
      "genau ins Auge.");

  AddDetail(({"tropfen","wassertropfen"}),
      "PLATSCH!!! Schon wieder einer...");

  AddDetail("wasser", "Das Wasser gluckert und blubbert...");

  AddDetail(({"sonne","licht"}),
      "Das Licht faellt durch die Ritzen in den Waenden herein und erhellt so "
      "den ganzen Raum.");
  AddDetail(({"wind","luft"}),                                                            
      "Durch Dir Ritzen stroemt auch frische Luft herein.");

  AddDetail(({"pflanze","pflanzen"}),
      "Die Pflanzen wuchern wild und nehmen bald die ganze Hoehle in Besitz. "
      "Ein kleiner Apfelbaum waechst auch hier.");
  AddDetail(({"baum","apfelbaum"}),
      "Der Baum traegt viele rotleuchtende Aepfel.");
  AddDetail(({"aepfel","apfel"}),
      "Die Aepfel lachen Dich reif und lecker aussehend an.");
  AddSound( DEFAULT_SOUND,
      "Du hoerst den Todesschrei eines Abenteurers.");

  AddSmell( DEFAULT_SMELL,
      "Die Luft ist hier erstaunlich frisch...");


  AddItem(NPC"dskelett" , REFRESH_DESTRUCT);
  SetProp(P_HIDE_EXITS, ({"westen"})); 
  AddExit( "nordosten", "./loch3");
  AddExit( "westen", "./hoehle12");
  AddCmd(({"pfluecke", "pflueck"}), "trinken");
}

reset()
{
  ::reset();
  wasser=2;
}



trinken (string str)
{
  notify_fail("Scheint wohl nicht zu funktionieren...\n");
  if( !str) return 0;
  if ( member( ({"apfel","aepfel"}),str) !=-1 )
  {
    if(wasser)
    {
      write(BS("Du pflueckst einen Apfel, isst ihn und fuehlst Dich "
            +"sehr gut.\n"));
      say(BS(CAP_TPN+" pflueckt einen Apfel und isst sie."));
      this_player()->heal_self(18+random(5));                                                  
      wasser--;
      return 1;
    }
    write(BS("Du pflueckst einen Apfel und isst ihn, aber nix passiert.\n"));
    say (BS(CAP_TPN+" pflueckt einen Apfel und isst ihn.\n"));
  }
  return 0;
}


