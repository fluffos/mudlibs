// hoehle 6

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int spinne;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor dem Abgrund" );
  SetProp( P_INT_LONG, BS(
        "Der enge Gang ist hier zu einem kleinem Raum erweitert, der im Westen "
        "wieder zurueck in den Gang fuehrt, im Osten jedoch senkrecht in die Tiefe "
        "abbfaellt. Sonst bist Du hier voellig von steinernen Waenden umgeben."));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein. Du kannst eigenartige Schriftzeichen "
      "an einer der Waende erkennen.");
  AddDetail(({"zeichen","schriftzeichen"}),
      "Du kannst sie lesen... ");
  AddReadDetail(({"zeichen","schriftzeichen"}),
      " \n"
      "Magier sind doof und stinken!!!\n"
      " \n");
  AddDetail(("decke"),
      "An der Decke ist hier viel hoeher als im Gang. Ein Spinnennetz haengt "
      "in einer der Ecken.");
  AddDetail(("boden"),
      "Der Boden besteht aus hartem Granit. Du kannst einige eigenartige "
      "Zeichnungen erkennen, die jemand hier eingeritzt hat. Ausserdem faellt Dir "
      "eine kleine Oeffnung im Boden auf.");
  AddDetail(("oeffnung"),
      "Die Oeffnung ist sehr eng, da passt Du nie durch.");
  AddDetail(({"zeichnung","zeichnungen"}),
      "Hmm, sehen irgendwie einer Leiter aehnlich...");
  AddDetail(({"ecke","ecken"}),
      "In einer der Ecken haengt ein grosses schoenes Spinnennetz.");
  AddDetail(("granit"),
      "Granit ist ein besonders harter Stein.");
  AddDetail(("gang"),
      "Der Gang fuehrt von hier aus nach Westen.");
  AddDetail(("westen"),
      "Im Westen beginnt der enge Gang.");
  AddDetail(("osten"),
      "Im Osten tut sich ploetzlich ein tiefer Abgrund auf.");
  AddDetail(("tiefe"),
      "Der Boden faellt hier jaeh nach unten ab und verschwindet in der "
      "Dunkelheit des Abgrunds.");
  AddDetail(("abgrund"),
      "Es geht hier sehr weit nach unten. So weit, das Du den Boden gar "
      "nicht mehr erkennen kannst. "
      "Hier runter zu springen waere ein zu grosses Risiko. Lass es sein!!!");
  AddSound( ({DEFAULT_SOUND, "krachen"}),
      "Aus dem Abgrund hoert man lautes Krachen.\n");

  AddCmd(({"springe","spring"}), "springen");
  AddCmd(({"steig", "steige"}), "steigen");

  AddSmell( ({DEFAULT_SMELL, "stein"}),
      "Hier riecht es seltsamerweise nach Stein ?\n");
  AddSpecialDetail(({"netz", "spinnennetz"}), "d_netz");
  spinne=1; 

  AddItem("/d/dschungel/dante/hoehle/npc/axtgnom", REFRESH_DESTRUCT);


  AddExit( "westen", "./hoehle21");
}

string d_netz()
{
  object ob;
  if(spinne)
  {
    write(" \n"
        "Du betrachtest das Netz und...\n");
    ob = clone_object("/d/dschungel/dante/hoehle/npc/dspinne2.lpc");
    ob->move(environment(TP),M_TPORT);
    if(IS_WIZARD(TP) )
      write("Die Spinne traut sich nicht, Dich anzugreifen.\n");
    else
      ob->Kill(TP);
    spinne--;
    return("");
  }
  else
    return "Das Spinnennetz ist leer.\n";
}

void reset()
{
  ::reset();
  spinne=1;
}

springen (string str )
{
  notify_fail("Wohin willst Du springen ?\n");
  if ( !str ) return 0;
  if ( member( ({"in abgrund", "in tiefe", "runter", "nach unten", "unten"}),str) !=-1 )
  {
    write("Du springst leichtsinnig in die Tiefe...\n"
        " \n"
        "   AAAA...\n"
        "         AAAA...\n"
        "               AAAA...\n"
        "                     AAAA...\n"
        "                           AAAA...\n"
        "                                 AAAA...\n"
        "                                      AHHH...\n"
        " \n");

    TP->move("/d/dschungel/dante/stein/room/stein16" , M_GO,
        "wagemutig in die Tiefe.","springt",
        "kommt von sehr weit oben herab gesprungen");
    SetProp(P_KILL_NAME, "Ein wagemutiger Sprung");
    TP->do_damage(20+random(10));
    return 1;
  }
  return 0;
}

steigen ( str )
{
  notify_fail("Wo willst Du hinunter steigen ?\n");

  if (( !present("leiter", TP))&&(str == "nach unten" || str == "runter" || str == "in abgrund"))
  {
    write("Du versuchst nach unten zu steigen, gibst aber gleich wieder auf, denn ohne Leiter wird das nie etwas.\n");
    say(""+TPN+" versucht nach unten zu steigen, gibt aber gleich wieder auf.\n");
    return 1;
  }
  if(( present("leiter", TP))&&(str == "nach unten" || str == "runter" || str == "in abgrund"))

  {
    write (" \n"
        "Du steigst mit Hilfe der Leiter nach unten.\n"
        " \n");
    TP->move("/d/dschungel/dante/stein/room/stein16" , M_GO,
        "mit einer langen Leiter nach unten.", "steigt" ,
        "kommt mit einer langen Leiter herunter gestiegen");
    return 1;
  }
  return 0;
}

