// hoehle 2

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
nosave int fackel;
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer finsteren Hoehle" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun tiefer in der Hoehle. Der Raum hier ist seltsamer Weise\n"
        "bis auf einige Knochen voellig sauber und kahl geputzt...\n"));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ("boden"),
      "Der Boden ist voellig sauber.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein. Du kannst einige Kratzer erkennen.\n");
  AddDetail(("kratzer"),
      "Die Spuren an den Waenden scheinen von gewaltigen Werkzeugen herzuruehren.\n");
  AddDetail( ({"spuren", "werkzeug", "werkzeuge"}),
      "Man braucht schon gutes Werkzeug um solche Kratzer zu erzeugen.");
  AddDetail(("knochen"),
      "Einige sehr sauber angenagte Knochen liegen hier herum.\n");
  AddDetail(("decke"),
      "Als Du Dir die Decke naeher betrachtest, faellt Dir ein langer Riss entlang der Wand auf.");
  AddDetail(("riss"),
      "Der Riss fuhert von der Decke bis zum Boden, direkt zu einer Vertiefung...");
  AddDetail(("vertiefung"),
      "Die Vertiefung ist sehr schmal und Du kannst nicht erkennen, was in ihr "
      "lauert, aber Du willst doch wissen, was da drinnen steckt...");

  AddSound( DEFAULT_SOUND,
      "Aus dem Nebenraum kannst Du etwas krabbeln hoeren.");

  AddSmell( ({DEFAULT_SMELL, "tod", "verwesung"}),
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");

  AddItem(WEAPON_WEG"dknochen", REFRESH_REMOVE);
  AddItem(NPC_WEG"dratte" , REFRESH_DESTRUCT);

  AddExit( "suedosten", "./hoehle1");
  AddExit( "sueden", "./hoehle3");
  AddExit( "westen", "./hoehle10");

  fackel = 1;
  AddCmd(({"greife","greif","lange","lang"}), "greifen");
}

reset()
{
  fackel=1;
  ::reset();
}


greifen (string str)
{
  notify_fail("Wo willst Du hineingreifen ?\n");
  if ( str != "in vertiefung")
    return 0;

  if ( !fackel)
  {
    write( " \n"
        "Du greifst in die Vertiefung, findest aber nichts...\n");
    say(CAP_TPN+" greift in eine Vertiefung, scheint aber nichts zu finden...\n");
    return 1;
  }

  write(" \n"
      "Du greifst in die Vertiefung und findest eine Fackel.\n");
  say(CAP_TPN+" greift in eine Vertiefung und findet einen Gegenstand.\n");
  CLONE("/obj/fackel", TP);
  fackel--;
  return 1;
}

