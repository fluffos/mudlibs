// fels 5 mit quellee heilstelle  by dante 97

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

int wasser;

create()
{
  ::create();
  wasser=random(5)+1;
  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  SetProp( P_INT_LONG, 
      "Das enge Loch erweitert sich hier zu einer kleinen Hoehle, in die "
      "von oben durch schmale Ritzen Licht faellt. Der Boden ist hier saftig "
      "und sehr feucht und an den Waenden laeuft Wasser herunter, das sich "
      "zu einer kleinen Pfuetze sammelt.");
  AddDetail(({"ritze","ritzen"}),
      "In den Waenden kann man viele kleine Ritzen erkennen.");
  AddDetail(("hoehle"),
      "Die Hoehle macht einen verwachsenen Eindruck. Ueberall sieht man Pflanzen "
      "und kleine Rinnsale.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("pfuetze"),
      "Das herabfliessende Wasser sammelt sich am Boden und versiegt dann "
      "langsam im Erdreich.");
  AddDetail(("erdreich"),
      "Die Erde hier ist braun und weich.");
  AddDetail(("erde"),
      "Als Du Dir die Erde naeher betrachtest fallen Dir Spuren eines Kampfes auf.");
  AddDetail(({"spur","spuren", "kampf"}),
      "Hier muss ein furchtbarer Kampf stattgefunden haben. Alles ist voller Blut.");
  AddDetail(("blut"),
      "Alles ist damit besudelt.");
  AddDetail(("loch"),
      "Das enge Loch liegt von hier aus im Nordwesten.");
  AddDetail(("nordwesten"),
      "Nach Nordwesten kannst Du gehen.");
  AddDetail(({"boden"}),
      "Der Boden schein eine ideale Naehrquelle fuer Pflanzen zu sein.");
  AddDetail( ({"quelle","naehrquelle"}),
      "Hier gedeihen einige Pflanzen, was Dich doch etwas erstaunt.");

  AddDetail(({"wand","waende"}),
      "Kleine Rinnsale laufen die Waende herab und sorgen fuer ein feuchtes "
      "Klima, in dem Pflanzen sicher gut gedeihen.");
  AddDetail(("klima"),
      "Feucht und schwuel ist es hier. Aber trotzdem scheint die Luft angehnem zu sein.");
  AddDetail(({"rinnsale","rinnsal"}),
      "Das Wasser plaetschert munter von der Decke herab... ");
  AddDetail(({"decke"}),
      "Platsch! Als Du Dir die Decke betrachtest faellt Dir ein Wassertropfen "
      "genau ins Auge.");

  AddDetail(({"tropfen","wassertropfen"}),
      "PLATSCH!!! Schon wieder einer...");

  AddDetail("wasser", "Das Wasser gluckert und blubbert...");

  AddDetail(({"sonne","licht"}),
      "Das Licht faellt durch die Ritzen in den Waenden herein und erhellt so "
      "den ganzen Raum.");
  AddDetail(({"wind","luft"}),                                                            
      "Durch Dir Ritzen stroemt auch frische Luft herein.");

  AddDetail(({"pflanze","pflanzen"}),
      "Die Pflanzen wuchern wild und nehmen bald die ganze Hoehle in Besitz. "
      "Ein kleiner Kaktus faellt Dir besonders auf.");
  AddDetail(("kaktus"),
      "Der Kaktus hat sehr spitze Stacheln.");
  AddDetail(({"stachel","stacheln"}),
      "Du kommst den Stacheln zu nahe, verletzt Dich leicht am Finger und "
      "stolperst erschrocken, wobei Du direkt unter einem Busch zu liegen "
      "kommst.");
  AddDetail(("busch"),
      "Der Busch leuchtet in saftigem Gruen und traegt sehr viele Beeren.");
  AddDetail(({"beere","beeren"}),
      "Die Beeren lachen Dich reif und lecker aussehend an.");
  AddSound( DEFAULT_SOUND,
      "Aus dem Raum im Osten kommen Geraeusche.");
  AddSound ("geraeusche",
      "Sie kommen aus dem Raum im Osten.");

  AddSmell( DEFAULT_SMELL,
      "Die Luft ist hier erstaunlich frisch...");


  AddItem(NPC_WEG"dratte" , REFRESH_DESTRUCT);

  AddExit( "nordwesten", "./loch2");
  AddExit( "osten", "./loch4" );
  AddExit( "suedwesten", "./loch5");

  AddCmd(({"pfluecke", "pflueck"}), "trinken");
}

reset()
{
  ::reset();
  wasser=random(5)+1;
}



trinken (string str)
{
  notify_fail("Scheint wohl nicht zu funktionieren...\n");
  if( !str) return 0;
  if ( member( ({"beere","beeren"}),str) !=-1 )
  {
    if(wasser)
    {
      write(BS("Du pflueckst eine Beere, isst sie und fuehlst Dich sehr gut.\n"));
      say(TPN+BS(" pflueckt eine Beere und isst sie."));
      this_player()->heal_self(15+random(8));                                                  
      wasser--;
      return 1;
    }
    write(BS("Du pflueckst eine Beere und isst sie, aber nix passiert.\n"));
    say (BS(CAP_TPN+" pflueckt eine Beere und isst sie.\n"));
    return 1;
  }
  return 0;
}


