// dantes pilzfarm:)
//erweiter fuer bilder quest dante 98 sl
//mehr details
//npc rein usw

#include "../def.h"
inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
//absichtlich nicht erweitert auf multiplayer, da die sonst sich dauernd pilze holen

int knopf;
int hebel=0;
create()
{
  ::create();
  knopf=1;
  SetProp( P_INT_SHORT, "Dantes Pilzfarm" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun mitten in Dantes Pilzfarm. Das Klima ist hier feucht und "
        "schwuel, genau so wies Dantes kleine Lieblinge eben gerne haben. Die Erde ist "
        "humusreich und locker. Von der Decke strahlt eine kuenstliche Sonne herab, "
        "die in bestimmten Zyklen Licht spendet. Die Einrichtung ist noch karg, "
        "am auffaelligsten ist wohl die Berieselungsanlage, die den Pilzen "
        "kuehles Nass spendet.")+
      "Eine Tafel.\n");
  AddDetail(("tafel"),
      "Du kannst sie lesen...");
  AddDetail("hebel",
      "Die Hebel haben sicher einen Sinn, doch der ist Dir noch verborgen.");
  AddDetail("sinn",
      "Probieren...");
  AddDetail("rausch",
      "Hmm, hat er nie!");
  AddDetail("konstruktion",
      "Wahrlich meisterhaft.");
  AddDetail("schlaf",
      "ZZZZZZZZZZZZZZZzzzzzzzzzzzzzzzzz");
  AddDetail("boden",
      "Am Boden sieht man eine Zeichnung.");    
  AddDetail(({"wand","waende"}),
      "Die Waende sind leer, bis auf ein Bild.");
  AddDetail("bild",
      "Es zeigt einen seltsamen Pilz.");
  AddDetail(({"pilz","pilze"}),
      "Ja, endlich war Dante nicht zu faul, und hat das Detail Pilz "
      "eingebaut, dafuer gehoert ihm gratuliert per mail!\n");
  AddDetail("detail",
      "Keines...");
  AddDetail("zeichnung",
      "Sie zeigt Angrox und Dante.\nAngrox sagt gerade zu Dante:\n"
      "He, Sklave! Da fehlt das Detail Boden! Du Depp!!!\n"
      "Dafuer gibts wieder Pruegel!\n"
      "\nAnmerkung des Autors: Das ist nicht der Stil den Angrox i.A. pflegt!\n");
  AddDetail( ({"dante", "angrox"}),
      "Der ist ja gar nicht hier!");
  AddDetail(({"anlage","berieselungsanlage"}),
      "Die Berieselungsanlage ist eine komplizierte Konstruktion aus Roehren, "
      "Hebeln, Knoepfen,...");
  AddDetail(("hebel"),
      "Lass ja die Finger von denen...");
  AddDetail(({"roehre","roehren"}),
      "Durch sie fliesst das Wasser...");
  AddDetail(({"knoepfe","knopf"}),
      "Einen davon kann man druecken, aber was dann passiert...");
  AddDetail(("einrichtung"),
      "Du siehst nur einen Kuehlschrank und einen gemuetlichen Sessel.");
  AddDetail(({"schrank","kuehlschrank"}),
      "Hier bewahrt Dante sein Pepsimax auf. Lass ja die Finger davon!");
  AddDetail(("sessel"),
      "Dantes gemuetlicher Schlafstuhl...");
  AddDetail(({"stuhl","schlafstuhl"}),
      "Hier schlaeft Dante nach getaner Arbeit den Schlaf des Gerechten, "
      "oder er schlaeft einfach seinen Rausch aus...");
  AddDetail(({"pepsi","pepsimax"}),
      "                 ...The Taste of A New Generation...\n");
  AddDetail(("licht"),
      "Die Sonne strahlt ein kuenstliches Licht aus.");
  AddDetail(("nass"),
      "Damit ist Wasser gemeint...");
  AddDetail(("wasser"),
      "Die Pilze brauchen wenig aber regelmaessig Wasser.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15,ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({ "pilzfarm","farm" }),
      "Die Pilzfarm ist erst im Aufbau, sie soll spaeter viel groesser werden.");
  AddDetail(("klima"),
      "In diesem Klima gedeihen die Pilze herrlich.");
  AddDetail(("decke"),
      "Von der Decke strahlt die kuenstliche Sonne herab.");
  AddDetail(({"lieblinge","liebling"}),
      "Pilze und Wuschels...");
  AddDetail(("erde"),
      "Die Erde ist importiert...");
  AddDetail(("sonne"),
      "Die Sonne ist eine kuenstliche Lichtquelle. Dante hat einfach in einen Kaefig "
      "Pilzgluehwuermchen gesperrt.");
  AddDetail(({"pilzgluehwuermchen","pilzgluehwurm","wurm","wuermchen","gluehwurm","gluehwuermchen"}),
      "Essen kann man die auch...");
  AddDetail(({"lichtquelle","quelle"}),
      "Sie strahlt in bestimmten Zyklen Licht ab.");
  AddDetail(({"zyklus","zyklen"}),
      "Dante hat sie nach jahrelanger Arbeit errechnet.");
  AddDetail(("arbeit"),
      "Wer hat die schon gerne...");
  AddDetail(("kaefig"),
      "Der Kaefig ist oval und aus Metall.");
  AddDetail(("metall"),
      "Du siehst das seltene Pilzcronium vor Dir.");
  AddDetail(("pilzcronium"),
      "Was es nicht alles so gibt ?");
  AddReadDetail( ({ "tafel" }),
      "+----------------------+\n"
      "|        FINGER        |\n"
      "|         weg          |\n"
      "|         von          |\n"
      "|        MEINEN        |\n"
      "|        PILZEN        |\n"
      "|                      |\n"
      "|               Dante  |\n"        
      "+----------------------+\n");

  AddSound( DEFAULT_SOUND,
      "Du glaubst die Pilze wachsen zu hoeren.");

  AddSmell( DEFAULT_SMELL,
      "Hmm, die Pilze duften herrlich.");

  AddRoomMessage(({
        "Die kuenstliche Sonne aendert ihren Zyklus.\n",
        "Die kuenstliche Sonne schaltet sich ein.\n",
        "Die Berieselungsanlage schaltet sich aus.\n", 
        "Die Berieselungsanlage schaltet sich ein.\n"}),60);

  AddCmd( ({ "drueck","druecke" }), "druecken" );
  AddCmd(({"ziehe","zieh"}), "done");


  AddExit( "raus", "./hoehle13" );
}


int done(string str)
{
  notify_fail("Was willst Du hier ziehen?\n");
  if(!str) return 0;

  if(str=="hebel"||str=="am hebel"||str=="an hebel")
  {
    if(!present("ELEF", TP))
    {
      write("Die Hebel lassen sich von Dir nicht bewegen.\n");
      return 1;
    }

    if(present("ELEF", TP))         
    { 
      write("Du ziehst einen Hebel, es rumpelt in der Anlage, sonst "
          "passiert nichts. Beeile Dich!\n");
      hebel=1;
      call_out("hebel_weg", 60);//hihi
      return 1;
    }
    return 1;
  }
  return 0;
}  


void hebel_weg()  
{
  hebel=0;
  tell_room("d/dschungel/dante/hoehle/room/farm",
      "Es rumpelt in der Anlage und ein Hebel bewegt sich.\n");
}

reset()
{
  ::reset();
  hebel=0;
}

druecken (string str)
{
  notify_fail("Scheint nicht zu funktionieren...\n");
  if ( !str) return 0;
  if ( member( ({ "knopf", "knoepfe"}),str) !=-1 )
  {
    if(knopf)
    {
      write(
          " \n"
          "Du drueckst auf einen Knopf und ploetzlich aendert die kuenstliche Sonne \n"
          "ihren Zyklus und Wasser stroemt aus der Berieselungsanlage.\n"
          "Irgendwas scheint da zu passieren...\n");
      say (CAP_TPN+" drueckt auf einen Knopf...\n");
      call_out("pilz",8);

      knopf--;
      call_out("new_pilz", 600);
      return 1;
    }

    write(
        " \n"
        "Du drueckst den Knopf aber es passiert nichts.\n");
    say(CAP_TPN+" drueckt auf einen Knopf...\n");
    return 0;
  }
  return 0;
}

void new_pilz()
{
  knopf++;
  tell_room("/d/dschungel/dante/hoehle/room/farm",
      "Irgendwie scheinen die Pilze wieder reif zu sein.\n");
}

void pilz()
{
  object trp;
  object ob;
  write( " \n"
      "Ploetzlich schiessen die Pilze wie wild aus dem Boden.\n");


  if(!hebel)
  {

    ob = clone_object("/d/dschungel/dante/hoehle/obj/dpilz.lpc");
    ob->move(TO,M_SILENT,M_TPORT);
    ob = clone_object("/d/dschungel/dante/hoehle/obj/pilz1.lpc");
    ob->move(TO,M_SILENT,M_TPORT);
    ob = clone_object("/d/dschungel/dante/hoehle/obj/pilz2.lpc");
    ob->move(TO,M_SILENT,M_TPORT);
    ob = clone_object("/d/dschungel/dante/hoehle/obj/pilz3.lpc");
    ob->move(TO,M_SILENT,M_TPORT);
    ob = clone_object("/d/dschungel/dante/hoehle/obj/pilz4.lpc");
    ob->move(TO,M_SILENT,M_TPORT);
    ob = clone_object("/d/dschungel/dante/hoehle/obj/pilz5.lpc");
    ob->move(TO,M_SILENT,M_TPORT);
  }

  if(hebel)
  {
    trp=clone_object("d/dschungel/dante/news/obj/trpilz");
    trp->SetProp(P_NAME, CAP_TPN+"'s Trompetenpilz");
    trp->move(TP, M_NOCHECK);
    write("Einer der Pilze scheint irgendwie seltsam zu sein!\n"
        "Er fliegt direkt aus der Erde in Deine Arme!\n");
  }

}


