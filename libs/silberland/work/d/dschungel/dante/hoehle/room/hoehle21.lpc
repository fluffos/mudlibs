// hoehle 21

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave int sma;
create()
{ 
  ::create();

  SetProp( P_INT_SHORT, "In einem kleinen Gang" );
  SetProp( P_INT_LONG, BS(
        "Du stehst hier in einem kleinen Gang der vom Schacht nach Osten abbiegt "
        "und hier jaeh nach unten fuehrt. Die Waende, der Boden, die Decke, "
        "alles, aber wirklich alles besteht hier aus Stein."));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein. Du kannst ein seltsames Loch "
      "an einer der Waende erkennen.");
  AddDetail(("loch"),
      "Hmm, erkennen kann man nicht viel vom Loch...");
  AddDetail(("decke"),
      "An der Decke siehst Du einen kleinen Knopf.");
  AddDetail(("boden"),
      "Der Boden besteht aus hartem Granit.");
  AddDetail(({"granit", "stein", "naturstein"}),
      "Granit ist ein besonders harter Stein.");
  AddDetail(("knopf"),
      "Den Knopf kann man sicher druecken. Aber was er wohl bewirkt ?"); 
  AddDetail( ({"schacht"}),
      "Der Schacht fuehrt nach oben.");
  AddSound( DEFAULT_SOUND,
      "Von nebenan hoerst Du seltsame Geraeusche.");

  AddSmell( DEFAULT_SMELL,
      "Hier riecht es nicht mehr so schlecht wie in dem engem Schacht.");

  AddItem(NPC_WEG"skobra", REFRESH_DESTRUCT);

  sma = 1;

  AddCmd(({"drueck", "druecke"}), "betaetigen");

  AddExit( "oben", "./hoehle20");
  AddExit( "osten", "./hoehle22");
}

reset()
{
  sma=1;
  ::reset();
}

betaetigen (string str)
{
  notify_fail("Was willst Du druecken ?\n");
  if ( str != "knopf") return 0; 

  if (!sma) {
    write(BS("Du drueckst den Knopf, ein Pfeil schiesst aus dem Loch an der "
          "Wand und verwundet Dich."));
    TP->AddHP(-10-random(5));

    return 1;
  }
  write (BS("Du drueckst den Knopf, eine verborgene Klappe oeffnet sich und "
        "ein Edelstein faellt Dir genau in die Haende."));
  say(BS(CAP_TPN+" drueckst den Knopf, eine verborgene Klappe oeffnet sich "
        "und ein glitzernder Edelstein faellt ihm genau in die Haende."));
  CLONE("/obj/gems/smaragd", TP);
  sma--;
  return 1;
}

