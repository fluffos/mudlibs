// hoehle 2

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem finsterem Loch" );
  SetProp( P_INT_LONG, BS(
        "Du stehst in einem finsteren, engem Loch. Hoch oben in der Decke faellt "
        "Dir eine Oeffnung auf. Sonst ist hier alles aus Stein und voellig uninterresant."));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ("boden"),
      "Der Boden besteht aus blankem Stein.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein. An der Nordwand erkennst "
      "Du etwas.");
  AddDetail( ({"nordwand"}),
      "An der Nordwand ist eine Zeichnung.");
  AddDetail(({"stein","naturstein"}),
      "Du bist leider kein Geologe und weisst daher nicht um welchen Stein es "
      "sich hier handelt.");
  AddDetail(("geologe"),
      "Geologen befassen sich mit so interessanten Dingen wie eben Steinen. "
      "Sie laufen mit kleinen Haemmern durch die Gegend und hauen auf jeden "
      +"Stein drauf.");
  AddDetail(("gegend"),
      "Diese Gegend hier koennte Dein Grab werden...");
  AddDetail(("hammer"),
      "Der Geologe haemmert mit dem Hammer...");
  AddDetail(("grab"),
      "Dein Grab waere eher schmucklos hier, nicht so schoen wie das TajMahal oder "
      "die grossen Pyramiden der Aegypter.");
  AddDetail(("aegypter"),
      "Du singst 'Geh'n wie'n Aegypter...'");
  AddDetail(({"pyramiden","pyramide"}),
      "Grosse Gebilde aus unzaehligen Felsbloecken erbaut in jahrhundertelanger Schufterei.");
  AddDetail(("gebilde"),
      "Bauwerke...");
  AddDetail(({"felsbloecke","bloecke","block","felsblock"}),
      "Als Du die soh Gedanken ueber die Pyramiden machst, faellt Dir eine kleine Zeichnung "
      "an der Wand auf.");
  AddDetail(("tajmahal"),
      "Ein Grabmal fuer eine Frau in Indien...");
  AddDetail(("zeichnung"),
      "Die Zeichnung stellt Wuschel dar...");
  AddDetail(("wuschel"),
      "Seltsam, wer hat wohl Wuschel hier hergezeichnet. Aber sie ist es, ohne Zweifel."
      " Stupsnasig grinst sie Dich an und scheint Dich auszulachen.");
  AddDetail(({"nase","stupsnase"}),
      "Wuschel hat eine suesse Nase. Ob sies gerne hat, wenn man ihre Nase drueckt ?");


  AddDetail(("bauwerk"),
      "Eben grosse Gebilde.");
  AddDetail(("schufterei"),
      "Proggen kann auch ne grosse Schufterei sein. Also sei nett zu den Magiern!");
  AddDetail(({"magier","magiern"}),
      "Sei nett und hoeflich zu ihnen!");
  AddDetail(("oeffnung"),
      "Durch diese Oeffnung kommst Du nicht mehr hier hinaus.");

  AddDetail(("decke"),
      "An der Decke sieht man ausser der Oeffnung nur grauen Stein.\n");

  AddSound( DEFAULT_SOUND,
      "Hier ist es voellig still.");
  AddExit( "suedosten" , "./loch3");   
  AddSmell( DEFAULT_SMELL,
      "Eigentlich riecht es hier nach nichts.");
  AddCmd(({"drueck","druecke"}), "ziehen");
  AddRoomMessage( 
      ({"Hier ist es ganz schoen dunkel.\n",
       "Du zitterst vor Furcht...\n",
       "Wuschel ruft: Kauf Dir lieber eine Schwimmweste Dante!\n",
       "Dir ist hier ziemlich kalt...\n",
       "Irgendwie ist es hier so wuschelig...\n",
       "Du fuehlst Dich hier beobachtet...\n",
       "Du denkst . o O 'Paranoia...?'\n",
       "Du fuehlst Dich sehr eingeengt hier.\n"}),60 );

  AddItem(NPC_WEG"skobra",REFRESH_DESTRUCT,([P_AGGRESSIVE, 0]));

}


ziehen (string str)
{
  notify_fail("Was willst Du druecken ?\n");
  if ( !str ) return 0;  
  if ( member( ({"nase", "stupsnase", "auf nase", "auf stupsnase"}),str) !=-1 )
  {
    write(BS(
          "Du drueckst Wuschels Nase und kriegst von ihr dafuer eine Ohrfeige, "
          "die Dich wieder zurueck an die Oberflaeche befoerdert."));

    TP->move("/d/dschungel/dante/weg/room/loch", M_NO_SHOW + M_GO,
        "Wuschels Stupsnase und wird von ihr an die Oberflaeche zurueck getreten",
        "drueckt", "fliegt von Wuschel getreten direkt vor Deine Beine");
    return 1;
  }
  return 0;
}

