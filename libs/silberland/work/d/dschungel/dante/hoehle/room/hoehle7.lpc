// hoehle 7

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer kleinen Kammer" );
  SetProp( P_INT_LONG, BS(
        "Der Schacht endet hier in einer kleinen Felskammer. Von Westen strahlt "
        "ein wenig Sonnenlicht durch eine Oeffnung herein, sodass Du auch die "
        "Felswaende und die Decke gut erkennen kannst."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail(("oeffnung"),
      "Durch diese Oeffnung im Felsen kann man ans Tageslicht gelangen.\n");
  AddDetail(({"sonne","licht","sonnenlicht"}),
      "Die Sonne strahlt hell und freundlich von Westen in die kleine Kammer.\n");
  AddDetail(("westen"),
      "Im Westen kann man die Felskammer verlassen.\n");

  AddDetail(({"kammer","felskammer"}),
      "In der stehst Du gerade.\n");
  AddDetail(({"wand","waende", "felswand", "felswaende"}),
      "Die Waende bestehn aus rauhem Naturstein. An einer der Waende kannst Du \n"
      "einige Schriftzeichen erkennen.\n");
  AddDetail(("decke"),
      "An der Decke kann man ausser einem Spinnennetz nichts erkennen.\n");
  AddDetail(({"schriftzeichen","zeichen"}),
      "Du liest: 'Dieser verfluchte Skorpion...'\n");
  AddDetail(({"netz","spinnennetz"}),
      "Das Spinnennetz scheint schon lange verlassen zu sein...\n");
  AddDetail( ({"boden"}),
      "Kein Boden, unter Dir geht der Schacht nach unten.");
  AddSound( DEFAULT_SOUND,
      "Von draussen hoerst Du die Geraeusche des Dschungels.");

  AddSmell( DEFAULT_SMELL,
      "Du kannst bereits hier den intensiven Duft der Pflanzen wahrnehmen.");

  AddExit( "unten", "./hoehle6");
  // AddExit( "westen", HOEHLE_FELS);
  AddSpecialExit("westen", "westen");

  AddItem(NPC"dfledermaus" , REFRESH_DESTRUCT);
}


int westen()
{
  write("Nach Westen geht es noch nicht weiter, aber bald!\n");
  return 1;
}



