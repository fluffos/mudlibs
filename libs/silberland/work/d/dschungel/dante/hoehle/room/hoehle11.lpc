// hoehle 2

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave int pilz;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer finsteren Hoehle" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun tiefer in der Hoehle. Der Raum hier ist seltsamer Weise "
        "bis auf einige Knochen voellig sauber und kahl geputzt. Am Boden erkennst Du hier "
        "grosse Wasserlachen und auch Moos scheint hier praechtig zu gedeihen..."));
  AddDetail(({"wasserlachen","wasserlache"}),
      "Grosse Wasserlachen kann man ueberall hier erkennen...");
  AddDetail(({"lache","lachen"}),
      "Dante lacht Dich aus, denn Du meinst wohl Wasserlachen.");

  AddDetail(("moos"),
      "Gruen und saftig waechst es hier fast ueberall. Einige kleine Pilze fallen Dir "
      "auch auf.");
  AddDetail(({"pilze","pilz"}),
      "Die Pilze stehen in einer Ecke und warten darauf gepflueckt zu werden...");
  AddDetail(("ecken"),
      "In einer der Ecken faellt Dir etwas auf...");
  AddDetail(("ecke"),
      "In einer der Ecken stehen einige Pilze.");
  AddDetail(("etwas"),
      "Das Etwas sind einige Pilze...");
  AddDetail(("wasser"),
      "Das Wasser tropft an manchen Stellen von der Decke...");
  AddDetail(({"stelle","stellen"}),
      "An der Decke sieht man feuchte Stellen, von denen Wasser herab tropft.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ("boden"),
      "Der Boden ist voellig sauber.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein. Du kannst einige Kratzer erkennen.\n");
  AddDetail( ({"stein", "naturstein"}),
      "Natuerlicher Stein, nur die Kratzer sind interessant.");
  AddDetail(("kratzer"),
      "Die Spuren an den Waenden scheinen von gewaltigen Werkzeugen herzuruehren.\n");
  AddDetail( ({"spuren", "werkzeug", "werkzeuge"}),
      "Man braucht schon gutes Werkzeug um solche Kratzer zu erzeugen.");
  AddDetail(("knochen"),
      "Einige sehr sauber angenagte Knochen liegen hier herum. Hinter einem der "
      "Knochen kannst Du einen Spalt erkennen.");
  AddDetail(("spalt"),
      "Durch diesen Spalt kann man sicher kriechen, aber wohin er wohl fuehren mag?");

  AddDetail(("decke"),
      "Die Decke ist zu hoch oben um etwas zu erkennen.\n");

  AddSound( DEFAULT_SOUND,
      "Aus dem Nebenraum kannst Du etwas krabbeln hoeren.");

  AddSmell( DEFAULT_SMELL,
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");
  AddCmd(({"krieche","kriech"}), "kriechen");


  pilz = 3;

  AddCmd(({"pflueck","pfluecke"}),"pfluecken"); 

  AddExit( "sueden", "./hoehle10");
  AddItem(NPC"dviper", REFRESH_DESTRUCT);
}

kriechen (string str)
{
  notify_fail("Wo willst Du hinein kriechen ?");
  if ( !str ) return 0;  
  if ( member( ({"in spalt", "durch spalt", "in spalte","durch spalte"}),str) !=-1 )
  {
    write(" \n"
        "Du kriecht mit grosser Muehe durch den Spalt.\n");
    TP->move("/d/dschungel/dante/hoehle/room/hoehle12", M_GO,
        "mit grosser Muehe durch den Spalt", "kriecht",
        "kommt durch den Spalt gekrochen");
    return 1;
  }
  return 0;
}

reset()
{
  pilz = 3;
  ::reset();
}

int pfluecken(string str)
{
  notify_fail("Was willst Du hier pfluecken ?\n");


  if ( !str)
    return 0;

  if ( member( ({"pilz","pilze","champignon","champigons"}), str) !=-1 ) 
  {
    if ( pilz )
    {
      write( " \n"
          "Du pflueckst einen herrlichen Pilz.\n");
      say(""+TPN+" pflueckt einen herrlichen Pilz.\n");
      CLONE(OBJ"pilz3", TP);
      pilz--;

      return 1;
    }

    write(" \n"
        "Seltsam, aber die Pilze laufen vor Dir davon und Du bist zu langsam einen zu fangen...\n");
    say(""+TPN+" versucht einen Pilz zu pfluecken, ist aber zu dumm dafuer...\n");
    return 1;
  }                                                                                                                                  
  return 0;
}
