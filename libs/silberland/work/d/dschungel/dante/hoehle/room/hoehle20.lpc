// hoehle 6

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem kleinen Gang" );
  SetProp( P_INT_LONG, BS(
        "Du stehst hier in einerm kleinen Gang der vom Schacht nach Osten abbiegt "
        "und hier jaeh nach unten fuehrt. Die Waende, der Boden, die Decke, "
        "alles, aber wirklich alles besteht hier aus Stein."));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein.");
  AddDetail(("decke"),
      "Die Decke ist hier sehr niedrig. Pass auf Deinen Kopf auf!\n");
  AddDetail(("boden"),
      "Der Boden besteht aus hartem Granit.");
  AddDetail(({"granit", "stein", "naturstein"}),
      "Als Du Dir den Granit naeher betrachtest, faellt Dir ein kleiner Hebel "
      "am Boden auf.");
  AddDetail(("hebel"),
      "Den Hebel kann man sicher betaetigen. Aber was er wohl bewirkt ?"); 
  AddDetail("klappe",
      "Falls es hier eine Klappe geben sollte, ist sie zu gut versteckt, um "
      "sie zu erkennen.");
  AddSound( DEFAULT_SOUND,
      "Von nebenan hoerst Du seltsame Geraeusche.");
  AddSound( "geraeusche",
      "Sie kommen von nebenan.");

  AddSmell( DEFAULT_SMELL,
      "Hier riecht es nicht mehr so schlecht wie in dem engem Schacht.");

  AddCmd(({"zieh", "ziehe", "betaetige", "betaetig"}), "betaetigen");

  AddExit( "westen", "./hoehle6");
  AddExit( "unten", "./hoehle21");

  AddItem(NPC"hgnom" , REFRESH_DESTRUCT);
}



betaetigen ( str )
{
  notify_fail("Was willst Du betaetigen ?\n");
  if ( str != "hebel") return 0;
  if ( str == "hebel")
  {
    write(" \n"
        "Du betaetigst den Hebel, eine versteckte Klappe geht ober Dir auf und\n"
        "ein Stein faellt Dir genau auf dem Kopf. AUA!!!\n");
    say (BS(CAP_TPN+" betaetigt einen Hebel, eine verborgene Klappe oeffnet "
          "sich und ein Stein faellt ihm genau auf den Kopf")); 
    SetProp(P_KILL_NAME, "Ein Stein von oben");
    TP->do_damage(10+random(10));
    return 1;
  }
  return 0;
}


