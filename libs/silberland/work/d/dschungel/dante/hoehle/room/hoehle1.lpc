// hoehle 1

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer finsteren Hoehle" );
  SetProp( P_INT_LONG, BS(
        "Du bist durch die enge Spalte hinab in eine Hoehle gefallen. "
        +"Um Dich herum nichts als nackter Fels. Du bemerkst, wie ein "
        "unangenehmes Gefuehl in Dir aufsteigt.\n"));

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ("boden"),
      "Der Boden ist uebersaet mit Knochen und Skeletten.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus rauhem Naturstein. Du kannst einige Kratzer "
      +"erkennen.\n");
  AddDetail(("kratzer"),
      "Die Spuren an den Waenden scheinen von gewaltigen Werkzeugen "
      +"herzuruehren.");
  AddDetail( ({"spuren", "werkzeug", "werkzeuge"}),
      "Man braucht schon gutes Werkzeug um solche Kratzer zu erzeugen.");
  AddDetail(("knochen"),
      "Viele Knochen liegen verstreut um Dich. Von wem die wohl alle stammen?\n");
  AddDetail(({"skelett","skelette", "lebewesen", "arten"}),
      "Lebewesen aller Arten haben hier ihre letzte Ruhe gefunden.\n");
  AddDetail(({"spalt","spalte"}),
      "Die Spalte klafft hoch oben in der Decke. Durch die kommst Du nur mehr mit "
      "einem Seil raus...");
  AddDetail(("decke"),
      "Die Decke ist zu hoch oben um etwas zu erkennen.\n");
  AddDetail( ({"gefuehl"}),
      "Du hast ein unangenehmes Gefuehl hier in dieser Hoehle.");
  AddDetail( ({"hoehle"}),
      "Du befindest Dich in einer dunklen Hoehle.");
  AddDetail( "fels",
      "Waende, Decke und Boden betehen aus nacktem Fels.");

  AddSound( ({DEFAULT_SOUND, "wasser", "rauschen"}),
      "Du kannst das nahe Wasser rauschen hoeren.");

  AddSmell( ({DEFAULT_SMELL, "tod", "verwesung"}),
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");

  AddItem(NPC_WEG"dratte" , REFRESH_DESTRUCT);

  AddCmd( ({"kletter", "klettere"}), "klettern");

  AddExit( "nordwesten", "./hoehle2");

}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if( member( ({"spalte", "spalt", "durch spalte", "durch spalte",
          "in spalt","in spalte"}), str)!=-1 )
  {
    if( present( "seil", TP ) )
    {
      write("Du kletterst mit Deinem Seil durch die Spalte nach oben.\n");
      say( CAP_TPN+" klettert mit einem Seil nach oben.\n");
      TP->move("/d/dschungel/dante/weg/room/weg5",M_GO);
    }
    else
      write("Dazu brauchst Du ein Seil!\n");
    return 1;
  }
  return 0;
}


