// hoehle 2

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer finsteren Hoehle" );
  SetProp( P_INT_LONG, BS(
        "Du stehst in einem finsteren, engem Spalt. Hier ist es so dunkel, dass man die Hand vor Augen "
        "nicht mehr erkennen kann. Trotzdem fuehlst Du Dich beobachtet. Etwas scheint "
        "im Raum zu sein, aber was? Du drehst Dich rasch um, aber nichts ist da..."));
  AddDetail(("skelett"),
      "Das war einmal ein Abenteurer, der hier verhungert ist.");
  AddDetail(("abenteurer"),
      "Du wirst auch schon wieder hungrig...");    
  AddDetail(({"ecke","ecken"}),
      "In einer der Ecken steht Dante und grinst Dich an.");
  AddDetail(("wurstmagier"),
      "Wurstmagier sind Magier, die immer alles im Griff haben...");    
  AddDetail(("etwas"),
      "Du scheinst Dich geirrt zu haben.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("dante"),
      "Dante, der nette Wurstmagier steht in der Ecke grinst, und lacht Dich aus. "
      "Er schaut Dich frech an und Du wuerdest ihn gerne treten, aber ob es klug "
      "ist einen Magier zu treten?");
  AddDetail(("etwas"),
      "Ja, in der Ecke steht jemand.");
  AddDetail(("jemand"),
      "Wer mag der Jemand wohl sein?\n");
  AddDetail( ("boden"),
      "Der Boden besteht aus blankem Stein.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus rauhem Naturstein.\n");
  AddDetail(({"stein","naturstein"}),
      "Du bist leider kein Geologe und weisst daher nicht um welchen Stein es "
      "sich hier handelt.");
  AddCmd(({"tritt","trete"}), "treten");
  AddDetail(("decke"),
      "Die Decke besteht aus purem Granit.\n");

  AddSound( DEFAULT_SOUND,
      "Dante pfeift ein froehliches Lied.");

  AddSmell( DEFAULT_SMELL,
      "Das Aftershave von Dante stinkt erbaermlich.");
  AddRoomMessage( 
      ({"Hier ist es ganz schoen dunkel.\n",
       "Du glaubst den Schatten von Dante zu erkennen.\n",
       "Du zitterst vor Furcht...\n",
       "Irgendjemand ist hier im Raum...\n",
       "Du fuehlst Dich beobachtet.\n",
       "Du fuehlst Dich sehr eingeengt hier.\n"}),60 );

  AddItem(NPC_WEG"dratte", REFRESH_DESTRUCT);
  AddItem(NPC"dskelett", REFRESH_DESTRUCT);

  AddExit( "suedosten", "./hoehle12");  
}

treten (string str)
{
  notify_fail("Wen oder was willst Du treten?\n");
  if ( !str ) return 0;  
  if ( member( ({"dante","test"}),str) !=-1 )
  {
    write(BS(
          "Du nimmst allen Mut zusammen und trittst Dante in den Arsch. "
          "Er lacht und gibt Dir einen Tritt zurueck, dass Dir der Kopf wackelt "
          "und Du fuer kurze Zeit nur mehr Sterne siehst..."));
    TP->move("/d/dschungel/dante/hoehle/room/farm", M_NO_SHOW + M_GO,
        "Dante einen Tritt in den Arsch und bekommt von Dante eine Tritt zurueck, "
        "der "+TPN+" aus dem Raum schleudert..", "gibt",
        "fliegt von Dante hierhergetreten direkt vor Deine Fuesse");
    return 1;
  }
  return 0;
}

