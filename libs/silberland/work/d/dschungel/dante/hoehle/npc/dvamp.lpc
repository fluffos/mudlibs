// maerz 97 sl dante

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include  "/players/dante/myowndefine.h"
#include <mnpc.h>
#include <class.h>

object cash;

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der abgrundtiefboese Mutantenvampir");
  SetProp(P_LONG, BS(
        "Der abgrundtiefboese Mutantenvampir ist eine ekelerregende, widerliche "
        "Gestalt. Blut und Sabber laeuft ihm aus seinem Maul. Seine Krallen sind "
        "nur dafuer da, um sich an toten Abenteurern zu vergreifen, und nichts "
        "bereitet ihm mehr Spass, als wehrlose Abenteurer auszusaugen."));
  SetProp(P_NAME, "Mutantenvampir");

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, 5000+random(5000));
  cash->move(ME);  

  AddDetail(({"kralle","krallen"}),
      "Mit den scharfen Krallen reisst er Deine Halsschlagader auf.");
  AddDetail(("schleim"),
      "Rotes , dickes Blut seiner Opfer tropft aus seinem Maul...");
  AddDetail(("maul"),
      "Grosse spitze Zaehne blinken Dich an.");
  AddDetail(({"zahn","zaehne"}),
      "Mit diesen Zaehnen wuehlt er dann in den Eingeweiden seiner Opfer.");
  AddDetail(("gestalt"),
      "Voller Warzen, Schleim und Sabber uebberragt er Dich bei weitem.");
  AddDetail(("sabber"),
      "WAEH!!! Der Mutantenvampir ist wirklich eine grausliche Gestalt.");
  AddDetail(({"warze","warzen"}),
      "Sein ganzer Koerper ist ueber und ueber mit Warzen bedeckt.");
  AddDetail(("koerper"),
      "Wenn er nicht ab und zu ein Opfer aussaugt, verfaellt sein Koerper.");
  SetProp(P_GENDER, MALE);
  AddId(({"mutantenvampir","vampir","mutant"}));
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen mutierten Vampirkrallen", 250+random(30) ,({DT_RIP,DT_UNHOLY})}));
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, 5+random(10));
  SetProp(P_VULNERABILITY, ({DT_HOLY}));
  AddClass(CL_UNDEAD);

  SetProp(P_INFO, "Der Mutantenvampir hasst es selbst ausgesaugt zu werden.\n");
  SetProp(P_RESISTANCE, ({DT_TERROR,DT_UNHOLY}));

  SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "schleicht in seine Hoehle zurueck");
  SetProp(P_DIE_MSG,  " verwandelt sich in eine Fledermaus.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NOATTACK, "sagt: Nix da, Du Wurm!\n");
  AddInfo(DEFAULT_INFO, "sagt: Dich schaende ich auch noch!!!\n");
  AddInfo("dante", "Dante hat so suesses Blut...","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
  AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Ich will nur Dein Blut!!!\n" }) );

  SetProp(P_SPELLRATE,80);

  AddSpell(5,200,
      "Der Mutantenvampir spuckt Blut auf Dich.\n",
      "Der Mutantenvampir spuckt Blut auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600+random(100),
      "Der Mutantenvampir saugt Blut aus Dir.\n",
      "Der Mutantenvampir saugt Blut aus @WEM.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
      "Der Mutantenvampir versucht Dich zu zerfetzten.\n",
      "Der Mutantenvampir versucht @WEN zu zerfetzten.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,300,
      "Der Mutantenvampir schlaegt seine Zaehne in Deinen Hals.\n",
      "Der Mutantenvampir schlaegt seine Zaehne in @WESSEN Hals.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,500,
      "Der Mutantenvampir schreit: BOESES BLUT.\n",
      "Der Mutantenvampir Schreit: BOESES BLUT.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,900,
      "Der Mutantenvampir schreit: PROGRESSIVE PARALYSE.\n",
      "Der Mutantenvampir schreit PROGRESSIVE PARALYSE.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Mutantenvampir sagt: Wehe Du saugst mein Blut aus!\n",
        "Der Mutantenvampir grinst Dich blutgierig an.\n",
        "Der Mutantenvampir fragt: Welche Blutgruppe hast Du ?\n",
        "Der Mutantenvampir sagt: B positiv liebe ich....\n",
        "Der Mutantenvampir schreit: Ich will Blut...\n",
        "Der Mutantenvampir lacht ueber Dich.\n",
        "Der Mutantenvampir stoehnt laut auf.\n",
        "Der Mutantenvampir schreit: Ich werde Dich aussaugen!\n",
        "Der Mutantenvampir sagt: Ich will Dich!\n"}) );
  SetAttackChats(10, ({
        "Der Mutantenvampir schreit: ICH SAUGE DICH LEER !!!\n",
        "Der Mutantenvampir bruellt: Dein Blut ist mein!!!\n",
        "Der Mutantenvampir laeuft rot an...\n"}) );

  AddCmd(({"sauge", "saug", "beiss", "beisse"}), "saugen");

  AddInfo("fratze",
      "Hmm, die hat Sinn, aber welchen?", "lacht: ");
  AddInfo("stele",
      "Ich muss sie bewachen!!! Du Wurm!", "lacht boese: ");

}

void reset()  {
  ::reset();
  SP(P_NOATTACK, 1);
  SP(P_AGGRESSIVE, 0);  
}

int saugen (string str)
{
  object ob;
  notify_fail("Wen willst Du hier aussaugen ?\n");
  if ( !str ) return 0;
  if ( member( ({"mutantenvampir","vampir","vampir aus","mutant aus", "mutantenvampir aus"}),str) !=-1 )
  {
    write(" \n"
        "Du stuerzt Dich auf den Mutantenvampir und versuchst sein Blut auszusaugen.\n"
        "Er bruellt auf und stuerzt sich in rasender Wut auf Dich.\n");
    Kill(TP);
    SetProp(P_AGGRESSIVE, 1);
    SetProp(P_NOATTACK, 0);

    return 1;
  }
  return 0;
}

die(arg)
{
  if (!present("fledermaus",environment()))
    clone_object("/d/dschungel/dante/hoehle/npc/dfledermaus")->move(MENV, M_NOCHECK + M_SILENT);
  ::die(arg);
}

