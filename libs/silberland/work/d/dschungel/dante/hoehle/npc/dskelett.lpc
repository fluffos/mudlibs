// maerz 97 sl dante

inherit "p/std/npc/skeleton";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein altes Skelett");
  SetProp(P_LONG, BS(
        "Dies ist das alte, sehr klapprige Skelett eine ehemaligen Abenteurers."));
  SetProp(P_NAME, "Skelett");
  SetProp(P_GENDER, NEUTER);
  AddId(({"skelett"}));

  create_default_skeleton(12);
  SetProp(P_HANDS, ({" mit seinen spitzen Knochenhaenden", 100+random(10) ,({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Skelett");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, ([P_GUILD: (["nekromanten":0.0, 0:1])]) );
  SetProp(P_NOMAGIC, 5);

  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MSGOUT, "klappert");
  SetProp(P_MMSGIN, "erhebt sich ploetzlich aus der Ecke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(DEFAULT_INFO, "stoere meine Totenruhe nicht.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Was soll ein Skelett mit Deinen Sachen ?\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(5,200,
      "Das Skelett haucht Dich mit seinem Todesatem an.\n",
      "Das Skelett haucht @WEN mit seinem Todesatem an.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
      "Das Skelett sticht Dir mit seinen spitzen Fingern ins Auge.\n",
      "Das Skelett sticht @WEM mit seinen spitzen Fingern ins Auge.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Das Skelett klappert laut.\n"}) );
  SetAttackChats(10, ({
        "Das Skelett bruellt: Kann man nicht mal hier seine Ruhe haben?\n",
        "Das Skelett scheint zu Staub zu zerfallen...\n",
        "Das Skelett klappert laut.\n"}) );


}

