
inherit "std/npc";
inherit "std/npc/sequencer";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "files.h"
#include <new_skills.h>
create()
{
  if (!is_clone(this_object())) return;
  :: create();
  create_default_npc (11);
  SetProp(P_NAME, "Hoellenviper");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine Hoellenviper");
  SetProp(P_HEAL, 0);
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 9000);
  SetProp(P_ALIGN, -200);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen", 90+random(20),({DT_POISON,DT_RIP}) }));
  AddId(({"schlange","viper","hoellenviper"}));
  SetProp(P_DIE_MSG, " windet sich noch einmal am Boden und verendet dann lautlos.\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, "Die Hoellenviper zischt Dich nur an.\n"}) );

  SetProp(P_MMSGIN, "schlaengelt zischend herein");
  SetProp(P_MMSGOUT, "schlaengelt davon");
  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt"); 

  SetAttackChats(10, ({
        "Die Hoellenviper bedraengt Dich hart.\n",
        "Die Hoellenviper kriecht naeher an Dich heran.\n",
        "Die Hoellenviper pfaucht wild.\n",
        "Die Hoellenviper richtet sich auf.\n"}));

  SetChats(5, ({
        "Die Hoellenviper richtet sich auf und pfaucht Dich an.\n",
        "Die Hoellenviper kriecht naeher an Dich heran.\n",
        "Die Hoellenviper versucht Dich zu attackieren.\n",
        "OH!!! Fast waerst Du auf die Hoellenviper getreten!\n",
        "Du weichst der Hoellenviper behende aus.\n",
        "Die Hoellenviper schlaengelt um Dich herum.\n"}) );

  SetProp(P_SPELLRATE, 50);
  AddSpell(5,250,
      "Die Hoellenviper schlaegt ihre Zaehne in Deine Hand.\n",
      "Die Hoellenviper schlaegt ihre Zaehne in @WESSEN Hand.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1])); 
  AddSpell(2,300,
      "Die Hoellenviper spuckt Dir Gift in die Augen.\n",
      "Die Hoellenviper spuckt @WEM Gift in die Augen.\n",
      DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
      "Die Hoellenviper beisst Dir ins Bein.\n",
      "Die Hoellenviper beisst @WEM ins Bein.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,400,
      "Die Hoellenviper zerfetzt Dein Gesicht.\n",
      "Die Hoellenviper zerfetzt Dein Gesicht.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,1,DS_POISON);

  SetProp(P_LONG, ("Die Hoellenviper ist eine grosse giftige Schlange. Ihren Namen "
        "hat sie, weil ihr tiefschwarzer Koerper rote flammenaehnliche "
        "Flecken aufweisst.\n"));
  AddDetail(({"flammen","flecken","koerper" }),
      "Die Flecken erinnern Dich wirklich an Feuer und die Hoelle.\n");
}                          

