/*
** Steinpilz
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Fliegenpilz");
  SetProp (P_LONG, "Ein knallroter Fliegenpilz, der sicher nicht gesund ist.\n");
  SetProp (P_NAME, "Fliegenpilz");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 50);
  SetProp(P_SIZE, 20);
  SetProp (P_NOBUY, 0);
  SetProp(P_INFO, ("Dieser Pilz stammt aus Dantes Pilzfarm und Du solltest ihn besser nicht essen. \n"));
  AddId (({"pilz","fliegenpilz"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: -15, F_SOAK: 3, F_ALCOHOL: 0, F_POISON: 5]));
}

BeimEssen()
{
write ("Du isst den Fliegenpilz mit einem merkwuerdigen Gesichtsausdruck.\n");
say (TPN+" verspeisst den Fliegenpilz mit einem merkwuerdigen Gesichtsausdruck.\n");
return ::BeimEssen();
}