// gold von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Klumpen Silber");
  SetProp(P_LONG, BS(
  "Ein dicker, schwerer Klumpen reinstes Silber. Er ist sicherlich sehr viel wert...")); 
  SetProp(P_NAME, "Silberklumpen");
  SetProp(P_GENDER, MALE);
  AddId(({"klumpen","silber"}));

  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 1400+random(300));
  SetProp(P_NOBUY, 0);

}
