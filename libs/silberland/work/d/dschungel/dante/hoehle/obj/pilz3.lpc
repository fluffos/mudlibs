/*
** Steinpilz
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Champignon");
  SetProp (P_LONG, "Ein kleiner, aber feiner Wiesenchampignon.\n");
  SetProp (P_NAME, "Champignon");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 50);
  SetProp(P_SIZE, 20);
  SetProp (P_NOBUY, 0);
  SetProp(P_INFO, ("Dieser Pilz stammt aus Dantes Pilzfarm. \n"));
  AddId (({"pilz","wiesenchampgignon","champignon"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 10, F_SOAK: 3, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
write ("Du isst den Champignon mit grossem Genuss.\n");
say (TPN+" verspeisst den Champignon mit grossem Genuss.\n");
return ::BeimEssen();
}