//axt fuer kinderquest boese boese

inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SP(P_INFO, BS("Das ist kein normaler Stock. Er ist irgendwie magisch "
"und trifft Kinder, die von einem Daemon "
"besessen sind besonders gut!"));
SetProp (P_NAME, "Rohrstock");
SetProp (P_GENDER, MALE);
SetProp (P_VALUE, 0);
SetProp (P_WEIGHT, 100);
SetProp (P_MAGIC, 1);
SetProp (P_WEAPON_TYPE, WT_CLUB);
SP(P_LONG, BS(
"Das ist der Rohrstock von Gouvernante, mit dem sie ihre Kinder zuechtigt!"));
AddId(({"rohrstock","stock"}));
SP(P_SHORT, "Ein langer Rohrstock");

SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);


SetProp (P_DAM_TYPE, ({ DT_BLUDGEON}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 30);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([ MAT_OAK:100]));//wegen druiden stelle raus!!!!!!!!!!
 
}

                      
  