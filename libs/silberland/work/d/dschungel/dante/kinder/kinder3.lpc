//der kindergarten

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#define XDET   if(!present("KINDER_DANTE_KINDERTOT", TP))  {  write("Gouvernante teilt Dir mit: He! Zuerst musst Du Dich um die Kinder kuemmern!/n");return ""; }

#define XFUN  if(!present("KINDER_DANTE", TP))  { write("Gouvernante teilt Dir mit: He! Zuerst musst Du Dich um die Kinder kuemmern!/n");return 1; }



int dante_tot=0;
int mb_geholfen=0;

int count=0;

reset()  {
  ::reset();
  count++;
  if(count>5)  {
    dante_tot=0;
    mb_geholfen=0; 
  }
}


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter dem Kindergarten von Tijara" );
  SetProp( P_INT_LONG, BS(
        "Nun stehst Du im Keller des Kindergartens von Tijara. "
        "Durch das Loch in der Decke faellt etwas Licht herein und so "
        "Du Deine Umgebung erkennen, doch was Du siehst erschreckt Dich nur! "
        "Seltsam, irgendwie scheint es hier nebelig zu sein. "
        "Hier muss ein noch boesartigeres, animalisches Wesen gewuetet haben, "
        "denn der Keller ist voellig zerstoert. Nur mehr Truemmer sind "
        "von der ehemaligen Einrichtung uebriggeblieben. Irgendwie fuehlst "
        "Du Dich hier nicht wohl. "
        "Im Westen fuehrt ein Tor weiter."));

  AD("westen",
      "Da liegt das Tor.");
  AD("tor",
      "Es wirkt bedrohlich.");

  SetProp(P_NO_TPORT, NO_TPORT_OUT);  
  AD("umgebung",
      "Hier ist nichts mehr ganz. Alles wurde zertruemmert.");
  AD(({"kind","kinder"}),
      "Scheinen nicht hier zu sein, oder doch...");
  AD("einrichtung",
      "Die Einrichtung liegt zertruemmert am Boden herum.");
  AD(({"eck","ecke"}),
      "Hmm, schlecht zu erkennen. Die Luft ist sehr schmutzig hier.");
  AD("luft",
      "Die Luft scheint irgendwie voller Nebel zu sein.");
  AD("nebel",
      "Verbirgt sich etwa ein Wesen im Nebel?!");
  AD("wesen",
      "Koennte sein...");

  AD("himmel",
      "Nicht da.");
  AD("licht",
      "Das Licht faellt durch ein Loch in der Decke!");
  AD("tijara",
      "Du bist mitten im Kindergarten von Tijara.");
  AD("kindergarten",
      "Das hier ist der Keller des Kindergartens. Er scheint voellig verwuestet "
      "zu sein.");
  AD("boden",
      "Der Boden ist voellig uebersaeht mit Truemmern. Die gesamte Einrichtung "
      "wurde bis auf einen Kasten vernichtet.");

  AD("loch",
      "Durch das Loch kommt man wieder nach oben, oder...");
  AD("decke",
      "Die Decke ist nicht allzu weit ober Dir.");

  AD("keller",
      "Der Keller war frueher einmal ein Lagerraum. Nun ist er nicht "
      "mehr zu gebrauchen.");










  AD("raum",
      "Der Keller ist ein Raum.");
  AD("lagerraum",
      "Hier hat man in Kaesten Dinge aufbewahrt.");
  AD(({ "kaesten"}),
      "Von den Kaesten sind nur mehr Truemmer uebrig. Naja, einer scheint "
      "heil geblieben zu sein.");
  AD("kasten",
      "Der einzige Kasten der noch ganz geblieben ist hat eine grosse "
      "Kastentuere. Hmm, sieht sehr interessant aus!");
  AD(({"tuer","tuere","kastentuere"}),
      "Die Kastentuere scheint nicht versperrt zu sein.");

  AD("truemmer",
      "Wild verstreut liegen sie am Boden umher.");
  AD(({"ding","dinge"}),
      "Irgendetwas ist hier, aber wo...");


  AD("kiste",
      "Die Kiste ist gut versteckt hinter dem Kasten gewesen, doch nun hast Du sie "
      "ja gefunden. Sie scheint sehr stabil zu sein. Ab und zu glaubst Du Jammern "
      "aus der Kiste zu hoeren. Dann wiederum scheint es, als wackle die ganze Kiste "
      "ein wenig. Seltsam. Auf dem Deckel der Kiste hat sich bereits einiges an "
      "Staub angesammelt.");

  AD(({"wand","waende"}),
      "Die Waende waren einst weiss getuencht. Nun aber sind sie total "
      "versaut, pardon, verdreckt. Abscheuliche Kreaturen schmuecken nun "
      "die Waende.");
  AD(({"kreaturen","kreatur"}),
      "Scheinbar handelt es sich um Daemonen und Kinder. Du siehst Kinder, "
      "die Dich aengstlich anschauen, Kinder die von Daemonen gehetzt werden, "
      "Kinder die wie irr toben und wueten und scheinbar schon besessen sind! "
      "Eines der Kinder scheint sogar zu mutieren und zum Halbdaemon zu werden!");

  AD("halbdaemon",
      "Der Halbdaemon, halb Kind, halb Daemon, sieht Dich boese an und irgendwie "
      "hast Du den Verdacht, das dieser Halbdaemon doch irgendwie lebt.");
  AD("verdacht",
      "Dein Verdacht scheint sich zu bestaetigen, denn die eklige Fratze scheint "
      "Dich auszulachen und zu verhoehnen!!!");


  AD("staub",
      "Der Staub liegt schwer und aehnlich einem Totentuch auf der Kiste.");
  AD("deckel",
      "Der Deckel ist massiv und voller Staub. Irgendjemand hat etwas in den "
      "Staub gemalt und so eine Zeichnung hinterlassen.");
  AD("zeichnung",
      "Die Zeichnung stellt ein verkehrtes Kreuz dar. Vielleicht solltest Du "
      "die Kiste besser nicht mehr untersuchen.");
  AD("kreuz",
      "In diese Kiste hat Kleindante, der schon lange mehr Daemon als Kind ist, "
      "Baerchen eingesperrt. Geknebelt und gefesselt liegt der arme Baerchen nun in "
      "dieser Kiste und wartet auf seine Rettung! Angeblich wollen die "
      "Daemonen beim naechsten grossen Daemonenfest Baerchen braten und dann halbblutig "
      "auffressen. Aber wer ausser dem Schoepfer der Daemonen weiss das schon so genau. "
      "Wie dem auch sei, Baerchen will sicher aus der Kiste raus!");

  AD(({"daemon","daemone","daemonen"}),
      "Einer davon muss ganz nahe sein...oder sind es mehrere...");

  AD(({"fest","daemonenfest"}),
      "Sei froh, dass Du soetwas noch nie erlebt hast. Wichtiger fuer Dich ist "
      "allerdings wie Du Baerchen aus der Kiste helfen kannst. Hmm, probiers mal "
      "mit dem Schloss, das am Deckel durch den Staub "
      "kaum zu erkennen ist.");


  AD("dante",
      "Der hat das hier verbrochen.");
  AD("kleindante",
      "Tja, wo ist der bloss. Angeblich ist er halb Kind halb Daemon.");

  AD(({"tuch","totentuch"}),
      "Du wirst aengstlich.");

  AD("schloss",
      "Ein kleines, aber scheinbar noch brauchbares Schloss sichert die Kiste. "
      "Hmm, vielleicht nuetzt Gewalt hier etwas...");
  AD("gewalt",
      "Brich es einfach auf.");


  AD("schoepfer",
      "Er ist der Vater aller Daemonen.");
  AD("vater",
      "Keiner kennt ihn so genau.");

  AD("rettung",
      "Willst Du ihn nicht befreien...");
  AD("baerchen",
      "Hmm, ja wo koennte der wohl sein. Such ihn!");
  AD("rettung",
      "Willst Du ihn nicht befreien...");





  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]) );


  AddSound( DEFAULT_SOUND,
      "Von irgendwo her kommt leises Stoehnen und Jammern!");
  AddSound("jammern",
      "Das Jammern scheint von ganz nahe zu kommen.");
  AddSound("stoehnen",
      "Das Jammern scheint aus einer Kiste zu kommen, die in einer Ecke hinter "
      "dem Kasten geschoben wurde.");   
  AddSmell( DEFAULT_SMELL,
      "Es riecht nach Angst!");
  AddSmell("angst",
      "Hmm, wer hat hier Angst...");

  AddSpecialExit("oben", "fake");

  ASE("westen", "w");
  ASD(({"fratze"}), "dante_come");
  ACD(({"oeffne"}), "go_up");

  AIT("/d/dschungel/dante/kinder/kinschl", REFRESH_DESTRUCT);

  ACD(({"brich","breche","brech"}), "fake2");	
  ACD(({"sperr","sperre"}), "mb_come");

  ACD(({"teile","teil","tm"}), "help_mb");
  //previous_object()->CustomizeObject();            
}


int help_mb(string str)  {
  NF("Was willst Du Baerchen mitteilen?!\n");
  if(member(({
          "baerchen hilfe",
          "baerchen mit hilfe", "baerchen mit hilf","baerchen mit hilf mir"}),
        str)!=-1)   {	

    // XFUN

    // else {


    if((mb_geholfen) || (deep_present("KINDER_AXT",TP))) {
      write("Baerchen teilt Dir mit: Okay, ich mach mich auf die Sandalen!Ich eile!\n\n"
          "Sekunden spaeter streckt Baerchen seine Hand durch das Loch herab und zieht\n"
          "Dich geschwind nach oben! Dann winkt er, laechelt, und ist schon wieder weg!\n");
      TP->move("/d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), M_GO+M_SILENT);
      return 1; 
    }

    if(!mb_geholfen)   {
      write("Baerchen teilt Dir mit: DU WITZBOLD!!!\n"
          "Baerchen teilt Dir mit: Ich bin doch noch in der Kiste eingesperrt!\n"
          "Baerchen teilt Dir mit: Zuerst hol mich hier raus!\n");
      return 1; 
    }

    return 0; 
  }
  return 0; 
  }
  //return 0; }




int mb_come(string str)  {
  object ob, key;
  key=deep_present("kinderkey",TP);

  if(str=="kiste auf"||str=="schloss auf"||str=="deckel auf")  {


    if(deep_present("KINDER_AXT", TP))  {
      write("Scheinbar ist die Kiste verklemmt.\n"
          "Du bekommst sie nicht mehr auf!\n");
      return 1; 
    }

    if(!key) {
      write("Du brauchst einen Schluessel um die Kiste aufzusperren!\n");
      return 1; 
    }


    else  {

      write("Du sperrst die Kiste auf und hebst den Deckel hoch.\n"
          "Der Schluessel bricht dabei leider ab!\n\n"
          "Baerchen springt aus der Kiste heraus und knuddelt Dich hocherfreut!\n");
      write(BSA(
            "Danke! "+TPN+", Du hast mich endlich befreit! Wie kann ich Dir nur danken? "
            "Ah, ich weiss schon wie! Hier hast Du eine magische Axt! Sie wird "
            "Dir sicher noch gute Dienste leisten! In dieser verfluchten Kiste "
            "war es ja auch wirklich zu staubig und eng! Danke nochmals!!! "
            "Ah, noch was! Solltest Du hier unten Probleme haben, so teile mir, "
            "Baerchen, das einfach mit! syntax: <teile baerchen mit hilfe>!!! Das solltest "
            "Du wirklich nicht vergessen!!! Aja, noch was!!! Ich kann Dir nur helfen, aus diesem " 
            "Raum zu entkommen! Woanders kann ich Dir NICHT helfen!!!",
            "Baerchen sagt: "));
      write(BS(
            "Dann packt Baerchen ein Paar Sandalen aus, zieht sie an und macht "
            "sich auf den gleichnamigen auf und davon! Weg ist er!"));
      ob=clone_object("d/dschungel/dante/kinder/kaxt");
      ob->move(TP, M_NOCHECK);
      mb_geholfen=1;
      if(key)  {
        key->remove();
      }
      return 1; 
    }
    return 0;
  }
  notify_fail("Was willst Du aufsperren?\n");
  return 0;
}



int fake2(string str)  {
  object ob;
  //XFUN
  NF("Was willst Du hier aufbrechen?!\n");
  if(str=="schloss auf"||str=="kiste auf"||str=="deckel auf")  {

    if(deep_present("kinderkey", TP))  {
      write("Du versuchst es mit Gewalt, doch das nuetzt auch nichts.\n"
          "Wie waers mit Deinem Schluessel?!\n");  return 1; 
    }

    if(deep_present("KINDER_AXT", TP))   {
      write("Wozu noch eine Axt?!\n"); return 1; 
    }

    else  {
      write(BS("Du versuchst die Kiste mit Gewalt aufzubrechen, doch "
            "wie nicht anders zu erwarten bist Du zu schwach. Etwas Staub faellt zu "
            "Boden und erst nun entdeckst Du einen kleinen Schluessel im Staub, den "
            "Du sofort einsteckst! Ob er wohl die Kiste aufsperrt!!!"));
      ob=clone_object("d/dschungel/dante/kinder/kinderkey.lpc");
      ob->move(TP, M_NOCHECK);
      return 1; 
    }
    return 0; 
  }
  return 0;
}







fake()  {
  NF(BS( "Du versuchst durch das Loch nach oben zu kommen, doch irgendwie "
        "schaffst Du das nicht. So ein Pech!"));
  return 0; 
}

w()  {

  if(IS_WIZARD(TP)) {

    return TP->move("d/dschungel/dante/kinder/kinder4:"+getuid(this_player()),M_GO,
        "nach Westen durch das Tor", "geht");  
  }

  else		

    if(!deep_present("KINDER_DANTE_DANTETOT", TP))  {
      NF(BS("Eine unheimliche Stimme lacht Dich aus. Du kannst "
            "hier noch nicht durch!")); return ;
    }

  if(present("daemonenschlange", TO))  {
    NF("Die Daemonenschlange haelt Dich auf!\n");
    return ; 
  }



  return TP->move("d/dschungel/dante/kinder/kinder4:"+getuid(this_player()),M_GO,
      "nach Westen durch das Tor", "geht");  
}



int go_up(string str)   {

  NF("Was willst Du hier oeffnen?!\n");


  if(str=="kiste"||str=="deckel")  {
    write(BS(
          "Du oeffnest den Deckel der Kiste und ploetzlich rast ein Daemon herein und "
          "schlaegt Dir brutal ins Gesicht. Lachend faehrt er durch den Boden dorthin "
          "zurueck von wo er kam. Hmm, ob man sie mit einem Schluessel aufsperren muss..."));
    TP->do_damage(10);
    return 1;   
  }


  if(str=="tuer"||str=="tuere"||str=="kasten"||
      str=="kastentuere"||str=="kastentuer")  {
    write(BS("Du oeffnest die Kastentuere, ein grosser Stiefel schnellt hervor, "
          "und tritt Dich brutal nieder. Dann wird alles schwarz."));
    TP->do_damage(10);
    TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 4+random(4),
          PARALYZE_MSG: "Du bist doch bewusstlos wie ein Komapatient!\n",
          PARALYZE_END: "Du erwachst wieder, leicht benommen.\n"]));
    return 1;  
  }
  return 0; 
}


dante_come()  {
  object ob;

  if(!present("KINDER_DANTE_KINDERTOT", TP))
  {
    write(BS("Du blickst in die Fratze des Halbdaemons Kleindante und Dir wird "
          "Angst und Bange! Irgendwie steigen Gedanken in Dir hoch, dass der richtige "
          "Zeitpunkt noch nicht da ist...")); 
    write(BSA(
          "\nHe! "+TPN+", Du solltest Dich besser um die Kinder kuemmern! "
          "Die Fratze kannst Du ja spaeter auch noch untersuchen!", 
          "Gouvernante teilt Dir mit: ")); 
    return ""; 
  }
  else
  {
    if(present("k_dante", TO))   {
      write("Kleindante bruellt: HE! "+TPN+"! Du Arsch! Ich bin hier!\n");
      return ""; 
    }
    else
    {
      if(dante_tot==1)  {
        write("Aber wozu noch einen Kleindante umlegen?!\n");  return ""; 
      }
      else   {   
        write(BS("Du blickst in die Fratze des Halbdaemons Kleindante! "
              "Die Fratze beginnt sich zu verzehren, wird immer unwirklicher und "
              "dann fliegt irgendetwas aus dem Bild direkt auf Dich zu! Das Irgendetwas "
              "ist der Halbdaemon persoenlich..."));
        ob=clone_object("d/dschungel/dante/kinder/k_dante");
        ob->move(TO, M_TPORT);
        return ""; 
      }  
    }
  }
}


dante_stirbt()  {
  dante_tot=1;  
}
