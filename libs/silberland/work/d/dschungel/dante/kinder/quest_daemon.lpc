inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#include <class.h>


void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Der Daemon Tzakathz");

SP(P_LONG, BS(
"Das ist Tzakathz, ein boesartiger gemeiner Daemon. Er und seine "
"untergebenen Daemonen haben Besitz von den Kindern von Tijara "
"ergriffen! Da Du seinen Bann einmal gebrochen hast, bist Du "
"auch in der Lage zu ihm vorzudringen. Doch sei auf der Hut!"));

SetProp(P_NAME,"Tzakathz");

SetProp(P_GENDER, MALE);
AddId(({"daemon","tzakathz"}));
SetProp(P_ARTICLE, 0);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 40]));
 
 create_default_npc(25);
AddClass(CL_DEMON);

SetProp(P_HANDS, ({" mit seinen Reissklauen",290,({DT_TERROR,DT_RIP})}));
SetProp(P_BODY, 60+random(10));
SetProp(P_SIZE, 260+random(200));
SetProp(P_ALIGN, -500);

SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:0.3, DT_BLUDGEON:0.5,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:-0.6, DT_AIR:0.6, DT_RIP:-0.7,
 DT_PIERCE:-0.7,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0]));

SetProp(P_HEAL,0 );
SetProp(P_AGGRESSIVE, 1);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,5); 

SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "erscheint bruellend");
SetProp(P_MSGOUT, "erscheint bruellend");
SetProp(P_MMSGIN, "erscheint bruellend");
SetProp(P_MMSGOUT, "verschwindet im Boden");


SUID;
CLONEME("d/dschungel/dante/kinder/daemkey");
CLONEME("d/dschungel/dante/kinder/daemku");
CLONEME("d/dschungel/dante/kinder/daemku");
CLONEME("d/dschungel/dante/kinder/darkoblev");



SP(P_DIE_MSG, " flucht laut und faehrt in den Boden!\n");
SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Der Daemon Tzakathz");
SetProp(P_KILL_MSG, "burellt: Ihr elenden Sterblichen, Eure Tage sind gezaehlt!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



SetProp(P_SPELLRATE,60);

AddSpell(2,500,
"Tzakathz schleudert puren Hass auf Dich!\n",
"Tzakathz schleudert puren Hass auf @WEN!\n",
 DT_TERROR, ([SP_SHOW_DAMAGE:1]));

AddSpell(1, 600,
"Tzakathz versucht Dir das Genick zu brechen!\n",
"Tzakathz versucht @WEM das Genick zu brechen!\n",
DT_RIP, ([SP_SHOW_DAMAGE: 1]));


AddSpell(4,300,
"Tzakathz sticht Dir seine Krallen in den Leib!\n",
"Tzakathz sticht @WEM seine Krallen in den Leib!\n",
 DT_RIP, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, 400,
"Tzakathz rammt Dir eine Kralle ins Gesicht!\n",
"Tzakathz rammt @WEM eine Kralle ins Gesicht!\n",
DT_RIP, ([SP_SHOW_DAMAGE: 1]));



SetChats(10,({
"Tzakathz spuckt Dich an!\n",
"Tzakathz verhoehnt Dich!\n",
"Tzakathz lacht Dich aus!\n",
"Tzakathz bruellt: Du &$&/ hast meinen Bann gebrochen!\n",
"Tzakathz sagt: Verfluchter Spieler!\n",
"Tzakathz sagt: Die Kinder sind mein!\n",
"Tzakathz sagt: Ich will Rache!\n"}));

}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
write_file("/d/dschungel/dante/kinder/log/daemon",
ctime()+": Daemon hat "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)   
{
//domainshout(CAP_TPN+" hat den Daemon Tzakathz bezwungen!!!\n");
write_file("/d/dschungel/dante/kinder/log/daemon",
ctime()+": Tzakathz wurde von "+CAP(getuid(PL))+" umgebracht.\n");


::die(arg); }
