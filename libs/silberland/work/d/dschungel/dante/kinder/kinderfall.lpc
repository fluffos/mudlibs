//der kindergarten

#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#define TIME 10

create()
{
  ::create();
  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
  SetProp( P_INT_SHORT, "Im freien Fall direkt zu Deinem Begraebniss!!!" );
  SP(P_INT_LONG, BS(
        "Du stuerzt irgendwo leeren Raum immer tiefer nach unten. Rundherum scheint "
        "nichts zu sein ausser unheimlicher Dunkelheit. Ab und zu glaubst Du eine "
        "haessliche Fratze zu sehen, ein unheimliches Irrlicht, doch wahrscheinlich "
        "spielt Dir nur Deine Angst einen Streich! Und weiter gehts es im freien "
        "Fall nach unten. Hoffentlich zerplatzt Du nicht beim Aufprall. Was ist, wenn "
        "Du nie irgendwo aufprallst?!"));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );


  ACD("", "nix", 1);
}

int nix()  {

  if(!IS_WIZARD(TP))  {
    write(BS(
          "Konzentrier Dich lieber auf den Fall und auf den Aufprall!!!"));
    return 1;
  }
  return 0; 
}

init()  {
  ::init();

  if(interactive(TP))  {
    call_out("a1", TIME);  
  }
}



a1()  {
  write("\n"); if(environment(TP)!=TO) return ;
  write(BS(
        "Du faellst immer tiefer nach unten. Um Dich herum scheint nichts zu sein!"));
  call_out("a2", 3);   
}


a2()  {
  write("\n"); if(environment(TP)!=TO) return ;
  write(BS(
        "Du faellst noch immer in diesem unendlichen, schwarzen Loch nach unten!"));
  call_out("a3", 3);   
}



a3()  {
  write("\n"); if(environment(TP)!=TO) return ;
  write(BS(
        "Eine Fratze scheint um Dich herum zu fliegen. Weiter gehts nach unten!"));
  call_out("a4", 3);   
}




a4()  {
  write("\n"); if(environment(TP)!=TO) return ;
  write(BS(
        "Du rast immer weiter nach unten?! Wo soll das enden?! Wo faellst Du hin?"));
  call_out("a5", 3);   
}



a5()  {
  write("\n");
  if(environment(TP)!=TO) return ;
  write(BS(
        "Du wirst immer schneller! Der Aufprall wird Dich umbringen!"));
  call_out("a6", 3);   
}


a6()  {
  write("\n");
  if(environment(TP)!=TO) return ;
  write(BS(
        "Irgendetwas unter Dir kommt immer naeher! Du scheinst bald am Ziel zu sein!"));
  call_out("time_out", 3);   
}


BecomesNetDead(object pl)  {
  pl->move("/d/dschungel/dante/kinder/kinder1", M_GO+M_SILENT+M_NO_SHOW);
  return 1;
}





time_out()   {
  if(environment(TP)!=TO) return ;

  write("\n"
      "WWWWWWUUUUUUUUUUUUUUUMMMMMMMMMMMMMMMMMMMMMMMMM!!!\n"
      "Du schlaegst mit voller Wucht in einer seltsamen Umgebung auf!\n"
      "Viel passiert ist Dir zum Glueck nicht!!!\n");
  TPM("/d/dschungel/dante/kinder/kinder5:"+getuid(this_player()), M_GO +M_NO_SHOW);
  TP->do_damage(5);
}

