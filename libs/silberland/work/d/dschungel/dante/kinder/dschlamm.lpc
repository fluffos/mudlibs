//npc by dante


inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#include <class.h>

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein brauner Schlammdaemon");

  SP(P_LONG, BS(
        "Dieser Daemon ist eine wabbelnde Mase braunen Schlamms. Er wogt hin und her, "
        "jederzeit bereit Dich anzufallen. Er ist einer der Untertanen von "
        "Tzakathz, dem Daemon der die Kinder in seinen Bann gezogen hat! "
        "Toete den Schlammdaemon und Du wirst die Moeglichkeit bekommen, "
        "Tzakathz zu begegnen!"));
  SetProp(P_NAME,"Schlammdaemon");
  SP(P_NAME_ADJ, "braun");
  SetProp(P_GENDER, MALE);
  AddId(({"daemon","schlammdaemon"}));
  SetProp(P_ARTICLE, 1);
  AddClass(CL_DEMON);


  AI(({"kreuz","daemonenkreuz"}),
      "Du Arsch, das kriegst Du nie! Ich muss es hueten!!!", "sagt: ");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));
  create_default_npc(18);

  //mal sehn ob 18 ok is:))

  SetProp(P_HANDS, ({" mit seinen Schlammklauen",250,({DT_TERROR,DT_RIP})}));
  SetProp(P_BODY, 30+random(10));
  SetProp(P_SIZE, 260+random(200));
  SetProp(P_ALIGN, -500);

  SetProp(P_MAX_HANDS, 2);

  SetProp( P_RESISTANCE_STRENGTHS,


      ([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:0.4,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:-0.4, DT_AIR:-0.6, DT_RIP:0.3,
DT_PIERCE:-0.7,DT_LIGHTNING:0.4, DT_ELECTRIC:0.4]));

  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);
  SetProp(P_NOCORPSE, 1);
  SP(P_DIE_MSG, " faehrt direkt in die Hoelle!\n");

  SetProp(P_MSGIN, "schwabbelt schlammig herein");
  SetProp(P_MSGOUT, "schwabbelt schwammig davon");
  SetProp(P_MMSGIN, "taucht ploetzlich aus einer Schlammlache auf");
  SetProp(P_MMSGOUT, "verschwindet in einem Schlammloch");




  SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
  SetProp(P_KILL_NAME, "Ein brauner Schlammdaemon");
  SetProp(P_KILL_MSG, "bruellt: Ihr elenden Sterblichen, Eure Tage sind gezaehlt! "
      "Ich stecke Euch alle in den Schlamm!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



  SetProp(P_SPELLRATE,60);


  AddSpell(4,200,
      "Der Schlammdaemon schleudert Schlamm nach Dir.\n",
      "Der Schlammdaemon schleudert Schlamm nach @WEM.\n",
      DT_POISON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
      "Der Schlammdaemon umhuellt Dich Schlamm!\n",
      "Der Schlammdaemon umhuellt @WEN mit Schlamm!\n",
      DT_POISON, ([SP_SHOW_DAMAGE: 1]));

  SetChats(10,({
        "Der Schlammdaemon stiert Dich an.\n",
        "Der Schlammdaemon bruellt Dich an.\n",
        "Du fuehlst Dich sehr schlammig.\n",
        "Der Schlammdaemon sagt: Ich liebe Schlamm!\n",
        "Der Schlammdaemon sagt: He, Du hast Schlamm am Kopf!\n",
        "Angrox teilt Dir mit: Du hast Schlamm im Kopf.\n",
        "Der Schlammdaemon lacht Dich aus!\n"}));




}

die(arg)   {
  object ob, ob1, ob2;
  ob1=deep_present("daemonenkreuz", TP);

  if(!ob1)  {
    write("Du nimmst ein Daemonenkreuz aus dem sterbenden Daemon!\n");
    ob2=clone_object("d/dschungel/dante/kinder/tzkiller");
    ob2->move(TP, M_NOCHECK);   
  }
  ob=deep_present("KINDER_DANTE_DANTETOT", TP);
  if(!ob)  {
    heal_self(500);  return;  
  }
  write("\n\n");

  write(BS("Der Schlammdaemon versinkt im Schlamm und dann hoert "
        "man lautes Toben und Bruellen von irgendwoher weit unten. "
        "Das dunkle Loch im Boden blitzt hell auf, scheinbar ist die Zeit "
        "nun gekommen!!! Doch huete Dich vor Tzakathz!!!"));

  if(ob)  {
    ob->AddId("KINDER_SCHLAMMTOT"); 
  }
  ::die(arg); 
}


