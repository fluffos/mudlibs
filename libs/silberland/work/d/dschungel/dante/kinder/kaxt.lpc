//axt fuer kinderquest boese boese

inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Axt");
SetProp (P_GENDER, FEMALE);
SP(P_NAME_ADJ, ({"alt", "rostig"}));
SetProp (P_VALUE, 0);
SetProp (P_WEIGHT, 20);
SetProp (P_MAGIC, 1);
SetProp (P_WEAPON_TYPE, WT_AXE);
SP(P_LONG, BS(
"Diese Axt ist sehr alt und rostig. Wenn man damit jemanden schlaegt, fuegt man ihm "
"sicher sehr gemeine Wunden zu. Nicht gerade nett. Seltsamerweise ist sie aus "
"Holz, rostet aber trotzdem?!?!??"));

AddId(({"axt","KINDER_AXT"}));

SP(P_SHORT, "Eine alte, rostige Axt");

SetProp (P_DAM_TYPE, ({ DT_RIP}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 100);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_OAK:100]));//logisch waere stell auch aber dann sind die druiden wieder arm dran
 


SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
SP(P_INFO, BS(
"Diese Axt wurde fuer den Kampf gegen Halbdaemone geschmiedet!\n"));


}

