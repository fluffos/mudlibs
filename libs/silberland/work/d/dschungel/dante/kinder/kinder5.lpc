//der kindergarten

#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#define QUESTKEY "Keine Gnade"


//das ist der raum in dem man waehrend der quest reinkommt!!!!!!!!!!!!!!!!


create()
{
  ::create();
  SetProp(P_NO_TPORT, NO_TPORT_OUT);  
  SetProp( P_INT_SHORT, "Unter dem Kindergarten von Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du bist hier im Reich von Tzakathz, dem Daemon der von den Kindern "
        "des Kindergarten von Tijara Besitz ergriffen hat. Nur wer den "
        "Bann einmal durchbrochen hat, hat die Macht hier vorzudringen. "
        "Staunend siehst Du Dir dieses seltsame Reich an. Der Boden besteht "
        "aus einem sehr engen Gitter, das Dich vor einem Fall ins "
        "Bodenlose bewahrt. Die Decke ist sehr niedrig und besteht ebenfalls "
        "aus diesem merkwuerdigen Gitter. Auch die Waende bestehen aus "
        "diesem Gitter und nun erst faellt Dir auf, dass Du in einem "
        "Kaefig aus Stahl bist, der in der Unendlichkeit haengt."));

  AD("macht",
      "Hier nuetzt Dir das wenig.");
  AD("reich",
      "Tzakathz kommt nur hier her, wenn man ihn ruft.");
  AD("boden",
      "Richtigen Boden gibt es hier nicht. Nur die Gitterstaebe "
      "bewahren Dich vor einem Fall ins Bodenlose.");
  AD("bodenlose",
      "Unter Dir ist ein gaehnender Abgrund.");
  AD("abgrund",
      "Wohin er fuehrt weiss keiner. Angeblich, nein, wenn ich Dir das "
      "verrate muesste ich Dich sofort toeten!");
  AD(({"stab","gitterstab","gitterstaebe","gitterstab"}),
      "Die Gitterstaebe sind aus blankem Stahl, der irgendwie magisch "
      "pulsiert und Licht reflektiert. Die Reflexionen werden gebuendelt "
      "und bilden eine seltsame Figur.");
  AD("figur",
      "Man sieht sie, trotzdem ist sie durchsichtig, aehnlich einem "
      "Hologramm.");
  AD(({"reflexion","reflexionen"}),
      "Die Reflexionen treffen sich zu einer Figur.");
  AD("hologramm",
      "Das Hologramm zeigt eine Statue.");
  AD("statue",
      "Die Statue zeigt einen haesslichen Daemon. Seine Nuestern sind "
      "aufgeblaeht, seine Augen blicken Dich stumm an. Sein Bauch entsetzt "
      "Dich!");

  AD("nuestern",
      "Seine Nuestern scheinen zu lodern.");
  AD("bauch",
      "Der Bauch ist zerfetzt und aufgerissen, als ob jemand in den "
      "Eingeweiden gewuehlt hat...");
  AD(({"eingeweide","eingeweiden"}),
      "Die Eingeweide sind zerfetzt und blutverschmiert. Irgendjemand "
      "hat darin herumgewuehlt. Sei vorsichtig!!! Das hier sieht SEHR gefaehrlich aus!!!");
  AD("blut",
      "WAEH!!! Du willst nicht in den Eingeweiden herumwuehlen!!!");
  AD(({"wand","waende"}),
      "Richtige Waende gibt es hier nicht. Nur Gitter.");
  AD("gitter",
      "Das Gitter besteht aus Stahl. Du kannst es sicher nicht zerstoeren.");
  AD("decke",
      "Die Decke ist nieder und besteht auch aus Gitter. Nur ein seltsames "
      "Rohr faellt Dir auf.");
  AD("rohr",
      "Das Rohr fuehrt nach oben.");
  AD("sog",
      "Ein leichter Sog entsteht im Rohr ueber Dir!\n");
  AD("fall",
      "Unendlich lange wuerdest Du fallen...");

  AD(({"kindergarten"}),
      "Wo der nun ist, weisst Du nicht. Du weisst ja selbst nicht wo Du bist.");
  AD("tijara",
      "Irgendwo ueber Dir oder unter Dir...");
  AD("besitz",
      "Du hast den Bann kurz brechen koennen.");
  AD(({"kinder","bann"}),
      "Die Kinder waren bessesen von Tzakathz.");

  AD("tzakathz",
      "Der maechtige Daemon scheint nicht hier zu sein.");
  AD("reich",
      "Das Reich von Tzakathz ist die Dunkelheit. In diesen Kaefig "
      "hat er Dich nur gelockt, um Dich nun genuesslich zu foltern.");
  AD("dunkelheit",
      "Von tief unten scheint schwaches Licht bis hier herauf.");
  AD("licht",
      "Schwach scheint es von unten bis hier herauf.");
  AD("kaefig",
      "Rund um Dich herum nur Gitter aus Stahl. Keine Tuere, kein Tor.");
  AD("stahl",
      "Der Stahl ist unerbittlich hart.");
  AD(({"tuer","tuere","tor"}),
      "Nein! Mitgegangen, mitgefangen.");
  AD("dunkelheit",
      "Die Daemonen leben in einer eigenen Dimension, die von ihrem "
      "Anfuehrer brutal beherrscht wird. Vielleicht lernst Du die "
      "Dimension der Daemonen noch kennen, sie ist im entstehen...");
  AD(({"anfuehrer","dimension"}),
      "Der Namenlose, Anfuehrer aller Daemonen, herrscht dort.");
  AD(({"namenloser","namenlose"}),
      "Huete Dich vor ihm und seinen Daemonen.");
  AD(({"daemon","daemonen"}),
      "Momentan scheint keiner da zu sein, gut fuer Dich!");

  AD("himmel",
      "Nicht hier.");
  AD("unendlichkeit",
      "Der Kaefig ist in der Unendlichkeit aufgehaengt. Da schwingt "
      "er fuer immer hin und her. Wie und wo er aufgehaengt ist weisst "
      "Du nicht.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]) );


  AddSound( DEFAULT_SOUND,
      "Du hoerst nur wie der Kaefig hin und her schwingt.");

  AddSmell( DEFAULT_SMELL,
      "Es stinkt!");


  AD(({"auge","augen"}), 
      "Die Augen leuchten boese. Irgendwie wirken sie aber loechrig. Da hat doch glatt "
      "irgendwer in die Augen gestochen!!!");


  ACD(({"stich","steche","stech"}), "up");
  ACD(({"wuehl", "wuehle"}), "d_come");
  ACD(({"kletter","klettere","kriech","krieche","spring","springe",
        "steig","steige"}), "nix");

  AddRoomMessage(({
        "Der Kaefig schwingt umher.\n"
        "Der Kaefig schwingt hin und her.\n",
        "Der Kaefig wackelt leicht.\n",
        "Das Rohr ueber Dir scheint zu vibrieren!\n",
        "Ein leichter Sog entsteht im Rohr ueber Dir!\n",
        "Das Rohr ueber Dir scheint lebenswichtig zu sein!\n",
        "Aus der Tiefe hoerst Du Schreie!\n",
        "Die Augen der Statue blitzen auf!!!\n",
        "Die Augen der Statue scheinen wichtig zu sein!\n",
        "Der Kaefig vibriert!\n",
        "Du hast Angst hier.\n",
        "Der Kaefig schwingt in der Unendlichkeit.\n",
        "Du verlierst fast das Gleichgewicht!\n"
        "Aus Angst machst Du Dir in die Hose!\n"}),
      20);

}



int nix(string str)  {
  NF("Wo willst Du rein?\n");
  if(member(({"ins rohr","rohr", "in rohr", "in rohr rein",
          "in rohr hinein","durch rohr", "durch rohr durch","ins rohr hinein",
          "ins rohr rein"}),str)!=-1)  {
    write(BS(
          "Du versuchst ins Rohr hinein zu kommen, schaffst es aber nicht."));
    say(CAP_TPN+" versucht ins Rohr zu klettern.\n");
    return 1; 
  }
  return 0; 
}

int d_come(string str)    {
  object ob;
  NF("Wo willst Du herumwuehlen?! Worin?\n");

  if(member(({"in eingeweide herum", "in eingeweide",
          "in eingeweiden", "in eingeweiden herum"}),str)!=-1)   {

    if(!deep_present("KINDER_DANTE", TP))  {
      write("Sorry, aber Du kannst hier nichts tun!\n");
      return 1; 
    }
    else  {
      if(present("tzakathz", TO))   {
        write("Aber der Daemon ist doch schon da!\n");
        return 1; }
        if(!present("tzakathz", TO))   {	
          write(BS("Du wuehlst in den Eingeweiden der Statue herum!!!"
                "Lichtblitze zucken durch den Raum und ploetzlich steht ein Daemon "
                "vor Dir!"));
          tell_room(environment(TP),
              "Tzakathz sagt: Wer wagt es mich zu rufen!\n");

          ob=clone_object("d/dschungel/dante/kinder/k_daemon");
          ob->move(TO, M_GO+M_SILENT);
          return 1; 
        }
        return 0; 
    }
    return 0; 
  }
  return 0; 
}

int up(string str)  {
  NF("Wo willst Du hineinstechen?!\n");
  if(str=="in auge"||str=="in augen")  {
    write(BS("Du stichst brutal in die Augen der Statue. "
          "Ploetzlich entsteht ein ungeheurer Sog, der alles ins Rohr "
          "ziehen will.  SCHWUPPPPP!!! Schon hat er Dich erfasst und ab gehts "
          "nach oben!"));

    TPM("/d/dschungel/dante/kinder/kinder1", M_GO,
        "durch das Rohr nach oben",
        "rast", "kommt aus einem Rohr heraufgeschossen");
    return 1; 
  }
  return 0; 
}
