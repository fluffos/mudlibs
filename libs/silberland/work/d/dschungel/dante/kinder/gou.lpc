// dante@SilberLand
//questnpc fuer kindertoetenquest

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define QUESTKEY "Keine Gnade"

int runden=0;

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gouvernante, die gestrenge Kindergartentante");
  SetProp(P_LONG, BS(
        "Das ist Gouvernante, die gestrenge Kindergartentante. Ihr Name ist Gouvernante, "
        "und so musste sie wohl oder uebel diesen Beruf ergreifen. Ihr Gesichtsausdruck "
        "ist schwer einzuschaetzen. Ist sie eine fuersorgliche Frau oder ist sie "
        "boesartig und verschlagen..."));

  AI("iwo",
      "IGITT!!! Das ist doch das schleimige Ding aus der Unterwelt, das "
      "alle frech anmotzt. Angeblich ein Irrer, aber sympathisch!", "sagt: ");

  SetProp(P_NAME, "Gouvernante");
  SetProp(P_GENDER, FEMALE);
  AddId(({"gouvernante","kindergartentante", "tante"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit einem Rohrstock",160,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 500);
  SP(P_HP, 500);
  SetProp(P_BODY, 80);
  SetProp(P_SIZE, 160);
  SetProp(P_ALIGN, 300);
  SP(P_INFO, "Boese Zungen behaupten, dass der wahre Name von Gouvernante Claudia sei!");

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  set_living_name("gouvernante");
  SetProp(P_NOCORPSE,0);

  SetProp(P_MSGIN, "kommt strengen Blickes herein");
  SetProp(P_MSGOUT, "geht mit strengen Blick");
  SetProp(P_MMSGIN, "kommt strengen Blickes herein");
  SetProp(P_MMSGOUT, "geht weit weg");


  SetProp(P_DIE_MSG,  " bruellt: Deine Erziehung war umsonst!!!\nDann stirbt sie!\n");

  AddInfo(DEFAULT_INFO, ({
        "sagt: Die Kinder sind auch zu laestig!\n",
        "sagt: Diese verdammten kleinen Goeren!\n",
        "seufzt nur laut ueber die Kinder!\n",
        "sagt: Erziehung muss hart sein!\n"}));

  AddInfo("dante", "Dante, hmm, da hat jede Erziehung versagt!","sagt: ");
  AddInfo("wuschel", "UI! Die hat eine lustige Nase!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Gouvernante sagt: Hmm, Deine Erziehung war gut! Danke!\n" }) );

  AI(({"stock", "rohrstock"}),
      "Hmm, der Rohrstock liegt hier irgendwo. Such ihn einfach!",
      "sagt: ");
  AI(({"tante", "kindergartentante", "gouvernante"}),
      "Tja, ich habe das Pech das zu sein!", "flucht: ");
  AI(({"kindergarten","kinderzimmer"}),
      "Hier beaufsichtige ich die Kinder vieler Leute! Ein º$&%%$$% Job!",
      "sagt: ");
  AI(({"leute", "job"}),
      "Der Job ist mies, die Leute undankbar!", "sagt: ");
  AI("kinder",
      "Ich muss diese kleinen, boesartigen Geschoepfe alle erziehen "
      "und auf sie aufpassen!", "sagt: ");
  AI("hilfe",
      "Hmm, tja, das ganze ist nicht so einfach. Kannst Du Geheimnisse bewahren?!"
      " Du bekommst auch eine Art Belohnung!","sagt leise: ");
  AI(({"art", "belohnung"}),
      "Das wirst Du dann schon noch selbst herausfinden!",
      "lacht brutal: ");



  AI(({"andyl","kleinandyl"}),
      "Der macht nur Krawall und nennt das auch noch Musik!", "sagt: ");

  AI(({"woody","kleinwoody"}),
      "Unser aller Gott. Angeblich traegt er derzeit gruen!!!", "lacht: ");

  AI(({"angrox","kleinangrox"}),
      "Kleinangrox ist eigentlich ein braves Kind! Vielleicht will er es allen "
      "Recht machen und verzweifelt oft daran, weil das ja kaum geht! Er muesste oefter mal auf die Pauke haun!",
      " sagt: ");

  AI(({"stahldorn","kleinstahldorn"}),
      "Er waer so gerne stark und gross und will immer alles toeten! Aber...", "lacht: ");

  AI(({"dusty","kleindusty"}),
      "Sie singt dauernd Musicals und zwar unglaublich falsch!", "sagt: ");

  AI(({"feyaria","kleinfeyaria"}),
      "UI UI UI!!! Ein ganz boeses kleines Elfenmaedchen! Aber angeblich ist sie nun"
      " etwas braver geworden!", "sagt: ");

  AI(({"kleinmuaddib","muaddib"}),
      "Der Kleinmuaddib redet und redet und tut leider so wenig. Aber eigentlich auch ein "
      "recht braves Kind!", "sagt: ");

  AI(({"berx","kleinberx"}),
      "Der kleine Berx! Hmm, der ist still und unauffaeliig!!", "sagt: ");


  AI(({"kleinprotheg","protheg"}),
      "Der Kleinprotheg denkt er ist Michael BrummBrumm Schumacher.", "lacht: ");

  AI(({"kleincreative","creative"}),
      "Ein nettes, oft einsames Kind, das oft nur so tut als ob es froehlich waere...", "seufzt: ");

  AI("kleindante",
      "Hmm, Kleindante ist auch bei den anderen Kindern. Pass auf, er ist sehr frech!",
      "sagt: ");
  AI(({"name", "namen"}),
      "Ich heisse Gouvernante!", "bruellt: ");
  AI("claudia",
      "Soll ich Dir Deine Zaehne einschlagen!!! Du verfluchtes Histamin!!!",
      "flucht: ");
  AI(({"histamin","histamine"}),
      "Die machen uns alle tot!!!",
      "sagt paranoid: ");


  AI("keller",
      "Der Kindergarten ist unterkellert. Ich glaube, dass da unten "
      "Daemonen hausen...", "sagt: ");
  AI(({"daemon","daemone", "daemonen"}),
      "Hmm, ich bin mir da nicht sicher, aber manchmal denke ich, dass "
      "die Kinder von einem Daemon besessen sind.", "sagt: ");

  AI("tijara",
      "Na da sind wir, Idiot", "sagt: ");

  AI(({"geheimnis", "geheimnisse"}),
      "Hmm, wir muessen da vorsichtig sein! Also, die Kinder rauben mir meinen "
      "letzen Nerv. Ich suche jemanden, der brutal und skrupellos ist. Er darf "
      "keine Gnade kennen und sich auch durch Winseln und Jammern der Kinder "
      "nicht davon abhalten lassen, die kleinen Monster zu schlachten, "
      "denn ich glaube, dass die Kinder nicht mehr die echten "
      "Kinder sind, sondern schon lange von einem Daemon besessen. Also "
      "denke ich, wir muessen sie so erloesen! Damit "
      "das ganze auch eine paedagogische Komponente hat, musst Du einen ganz "
      "speziellen Rohrstock verwenden! Bist Du so jemand, ich glaube nicht. Wenn Du mir "
      "aber doch helfen willst, so tippe einfach <gnadenlos>!",
      "sagt: ");

  AI("abgesandter",
      "Hmm, irgendwo im Keller haust ein Schlammdaemon! Toete ihn "
      "und Tzakathz Einfluss hier ist so gering, dass die Kinder "
      "vor ihm sicher sind!", "sagt: ");
  AI("schlammdaemon",
      "Ich glaube er haust im Keller...", "sagt: ");

  AI(({"schreibtisch","tisch"}),
      "Der Schreibtisch ist irgendwie seltsam. Untersuche ihn genau!",
      "sagt: ");
  AI("baerchen",
      "Den habe ich schon sehr lange nicht mehr gesehen! Angeblich steckt er in einer Kiste!", "sagt: ");
  AI("tzakathz",
      "Hmm, angeblich hat vor langer Zeit ein Daemon dieses Namens "
      "Kinder verflucht oder so...", "sagt: ");
  AI("axt",
      "Hmm, es gibt da eine, mit der kann man Halbdaemone sehr gut "
      "schlagen! Sie ist irgendwo im Keller...", "sagt: ");
  AI(({"lade","schreibtischlade"}),
      "Hmm, ja der Tisch hat eine Lade, aber den Schluessel hat Tzakathz "
      "angeblich gestohlen.", "sagt: ");
  AI("schluessel",
      "Tja, einen Schluessel gibts fuer die Lade vom Tisch. Den anderen "
      "braucht man fuer die Kiste im Keller, aber wo der ist, weiss "
      "ich nicht.", "sagt: ");

  SetChats(2, ({
        "Gouvernante sagt: Dieser verdammte Kleindante!\n",
        "Gouvernante sagt: Ich glaube Kleindante ist schon wieder im Keller!\n",
        "Gouvernante sagt: Erziehung ist mein Leben!\n",
        "Gouvernante sagt: Hast Du Deine Arbeiten erledigt!?\n",
        "Gouvernante schaut Dich pruefend an!\n",
        "Gouvernante sagt: Diese verdammten Kinder!\n",
        "Gouvernante flucht ueber ihre Schuetzlinge!\n",
        "Gouvernante sagt: Ich brauche Hilfe!\n",
        "Gouvernante sagt: Lange halte ich diese Kinder nicht mehr aus!\n"}));



  AddCmd("gnadenlos", "start");

} 


int start()
{
  object ob;
  if(deep_present("KINDER_DANTE", TP)) {
    write(BSA("Aber "+TPN+", Du willst doch die Kinder schon brutal meucheln!!\n",
          "Gouvernante sagt: "));
    return 1;
  }

  else  {
    write(BSA(
          "Gut so, "+TPN+"! Das freut mich zu hoeren! Also der Rohrstock liegt hier irgendwo, "
          "ich weiss nicht mehr genau wo. Wenn Du ihn hast, geh einfach in das Zimmer "
          "im Osten und stoeber die Kinder auf. Dann walte Deines Amtes! Aber keine Gnade! "
          "Lass ja keines am Leben! Und noch was: UNTERSUCHE ALLES SEHR GUT!!! SEI VORSICHTIG!!! DENK MIT!!!"
          ,"Gouvernante sagt leise: "));

    ob=clone_object("/d/dschungel/dante/kinder/kinderobj");
    ob->move(TP, M_GET);
    write_file("/log/quests/kinder",
        dtime(time())+": "+capitalize(getuid(this_player()))+ " beginnt die Quest.\n");
    return 1;
  }
  return 0;
}





void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}                


void hallo()
{
  object ob;
  ob=deep_present("KINDER_QUESTFERTIG", TP);  
  if(environment(TP)!=environment(TO))        return;  

  if(ob)  {
    write(BSA(
          "Gut gemacht, "+TPN+"! Gratuliere! Hehe, denen habens wir gezeigt! "
          "Ich bin mir sicher, dass Du die Daemonen aus den Kindern vertrieben "
          "hast! Tzakathz wird wohl so schnell nicht mehr zu uns kommen!!! "
          "Du solltest Dir nun mal den Schreibtisch etwas genauer ansehen. "
          "Einerseits kannst Du nun die Lade mit Deinem Schluessel aufsperren! "
          "Andererseits kannst Du irgendwie direkt zu Tzakatzh gelangen! "
          "Aber sei vorsichtig, irgendetwas stimmt nicht damit...",
          "Gouvernante sagt: "));
    ob->remove();


    if(!TP->QueryQuest(QUESTKEY))  {

      TP->GiveQuest(QUESTKEY);
      write_file("/log/quests/kinder",
          dtime(time())+": "+capitalize(getuid(this_player()))+ "loest die Quest.\n");
      return ;
    }
    return;

  }



  if(present("KINDER_SCHLAMMTOT", TP))  {

    write(BSA(
          "Gut gemacht! Der Schlammdaemon ist erledigt! Nun aber runter zu "
          "Tzakathz! Mach ihn fertig!",
          "Gouvernante sagt: ")); return ; 
  }



  if(present("KINDER_DANTE_DANTETOT", TP))  {
    write(BSA(
          "Gut gemacht "+TPN+", Kleindante ist ja tot. Aber Du musst "
          "noch den Abgesandten von Tzakathz toeten! Dann hast "
          "Du den Weg frei zu Tzakathz! Toete ihn und alles ist gut!!!",
          "Gouvernante sagt: "));
    return ;  
  }



  if(present("KINDER_DANTE_KINDERTOT", TP))  {
    write(BSA(
          "Gut gemacht, "+TPN+"! Nun fehlt Dir nur noch der verdammte "
          "Kleindante!?", "Gouvernante sagt: "));
    return ;  
  }


  if(present("KINDER_DANTE", TP)) {
    write(BSA(
          "He! "+TPN+", Du wolltest doch etwas fuer mich erledigen?! Lebt etwa eines "
          "der kleinen Ungeheuer noch!?", "Gouvernante sagt leise: "));
    return ;
  }
  if(TP->QueryQuest(QUESTKEY))  {
    write(BSA(
          "Hallo "+TPN+"! Willst Du etwa zu Tzakathz?!",
          "Gouvernante sagt: "));
    return ;
  }
  else 
    write(BSA(
          CAP_TPN+", fuer den Kindergarten bist Du aber schon etwas zu "
          "alt, oder?!", "Gouvernante sagt: "));
}


Defend(int dam, string dtype, int spell, object enemy)
{

  runden++;
  if(runden<3)
  {
    tell_object(enemy,
        "Gouvernante sagt: "+enemy->name()+", Deine Erziehung bringt Dich noch um!\n");
    return::Defend(dam, dtype, spell, enemy);        
  }
  if(runden>=3)
  {
    TO->heal_self(300);
    enemy->move("d/unterwelt/dante/skel/dach", M_NO_SHOW+M_TPORT);
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    tell_object(enemy,
        "Die Gouvernante teilt Dir mit: Schoenes Sterben!\n");
    runden=0;
    return ;      
  }
}
