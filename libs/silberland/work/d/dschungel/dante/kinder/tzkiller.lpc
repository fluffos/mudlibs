//waffe fuer den daemon tzakathz
//dante sl 99

inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Daemonenkreuz");
SetProp (P_GENDER, NEUTER);
SP(P_NAME_ADJ, ({ "heilig"}));
SetProp (P_VALUE, 0);
SetProp (P_WEIGHT, 500);
SetProp (P_MAGIC, 1);
SetProp (P_WEAPON_TYPE, WT_SPEAR);
SP(P_LONG, BS(
"Das ist ein uraltes, heliges Daemonenkreuz mit dem einst ein Exorzist "
"Tzakathz besiegt hat. Es wurde geweiht und mit unzaehligen Bannspruechen "
"des Guten belegt. Ohne dieser Waffe wuerdest Du den Daemon nie besiegen, "
"also huete sie gut!"));


AddId(({"kreuz","KINDER_KILLER", "daemonenkreuz"}));

SP(P_SHORT, "Ein heiliges Daemonenkreuz");

SetProp (P_DAM_TYPE, ({ DT_HOLY}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 100);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([
 MAT_OAK:100]));
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
}

