inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


#include "/players/dante/myowndefine.h"
#define QN QueryProp(P_NAME)
#define QL QueryProp(P_LEVEL)


int i, x;
string *wie, *was;


void create()
{


  if (!is_clone(TO)) return;
  ::create();


  wie=({
      "lang","kurz","dick","duenn","boesartig","geheimnissvoll",
      "alt","jung","untot","haesslich","gigantisch",
      "bombastisch"});

  was=({
      "dantinisch","angroxmaessig","blutrot","gelb","gruen","giftgruen",
      "eklig","schwarz","nachtschwarz","grellblau",
      "weiss","blaugruen","verwest"});


  x=random(sizeof(wie));
  i=random(sizeof(was));

  SP(P_SHORT, "Eine "+wie[x]+"e, "+was[i]+"e Daemonenschlange");

  SetProp(P_LONG, BS(
        "Diese Daemonenschlange ist ein "+wie[x]+"es, "+was[i]+"es "
        "Unwesen aus dem Land der Daemonen. Sie schlaengelt sich bedrohlich hin und her "
        "und scheint Dich zu beobachten."));




  SetProp(P_NAME,"Daemonenschlange");

  SetProp(P_GENDER, FEMALE);
  AddId(({"daemon","schlange","daemonenschlange"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(6+random(6));
  SetProp(P_HANDS, ({" mit ihren Giftzaehnen",
        50+QueryProp(P_LEVEL)*7,DT_POISON}));
  SetProp(P_BODY, 20+QueryProp(P_LEVEL)*2);
  SetProp(P_SIZE, 50+QueryProp(P_LEVEL)*10);
  SetProp(P_ALIGN, -300-QueryProp(P_LEVEL)*10);
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: 0.3, DT_UNHOLY:-1.0, DT_TERROR:-1.0,
DT_ACID:-0.5, DT_FIRE:0.6, DT_POISON:-0.7,DT_BLUDGEON:0.8]));

  SetProp(P_HEAL, -QueryProp(P_LEVEL));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 20);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "schlaengelt sich zischend");
  SetProp(P_MSGOUT, "schlaengelt sich zischend");
  SetProp(P_MMSGIN, "taucht ploetzlich  aus dem Nichts auf");
  SetProp(P_MMSGOUT, "verschwindet zischend");


  SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
  SetProp(P_KILL_NAME, "Eine Daemonenschlange");
  SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));



  SetProp(P_SPELLRATE, QueryProp(P_LEVEL)*5);


  AddSpell(5,80+QueryProp(P_LEVEL)*8,
      //im min: 80+48, max 80+88
      "Die "+QN+" versucht Dich zu erwuergen.\n",
      "Die "+QN+" versucht @WEN zu erwuergen!\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 120+QueryProp(P_LEVEL)*10,
      "Die "+QN+" schlaegt ihre Zaehne in Deine Hand!\n",
      "Die "+QN+" schlaegt ihre Zaehne in Deine Hand!\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
  AddSpell(1, 100,
      "Die "+QN+" spuckt Dich mit giftigem Schleim an!\n",
      "Die "+QN+" spuckt @WEN mit giftigem Schleim an!\n",
      DT_POISON, "spell_gift");

  SetChats(5,({
        "Die "+QueryProp(P_NAME)+" zischt laut.\n",
        "Die "+QueryProp(P_NAME)+" faucht Dich an.\n",
        "Du fuehlst Dich sehr schlecht hier.\n",
        "Die "+QueryProp(P_NAME)+" schlaengelt bedrohlich nahe zu Dir.\n",
        "Die "+QueryProp(P_NAME)+" baut sich vor Dir auf.\n"}));

  ACD(({"entferne","entfern","drehe","dreh"}), "nix", 1);
}

int nix()  {
  write("Die Daemonenschlange faucht Dich an!\n");
  return 1; }


void spell_gift(object enemy,int damage,mixed dam_type)
{
  switch(random(20))
  {
    case 0..6:
      enemy->AddPoison(1);
      break;
    case 7..8:
      enemy->AddPoison(2);
      break;
    case 9:
      enemy->AddPoison(3);
    case 10..19:
      tell_object(enemy,
          "Die Daemonenschlange verfehlt Dich!\n");
      break;
    default: enemy->AddPoison(2);
  }
}

