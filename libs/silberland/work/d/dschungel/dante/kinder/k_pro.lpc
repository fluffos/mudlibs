// dante@SilberLand
//questnpc fuer kindertoetenquest

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

int count=0;
 
void create()
{
  if (!is_clone(TO)) return;
  ::create();


AddId("NOWIMPY");  
  SetProp(P_SHORT, "Kleinprotheg");
  SetProp(P_LONG, BS(
 "Das ist Kleinprotheg, der obwohl er noch sehr jung ist, schon "
 "recht beachtliche Ausmasse hat. Irgendwie sieht es so aus, als "
 "ob Kleinprotheg eine gruene Uniform anhat, oder taeuscht das..."));
 
 AD("uniform",
 "Hmm, koennte sein...steht ihm gut.");
   
  AI("protheg",
   "HIHI!!! Der werde ich mal wenn ich gross bin!", "lacht: ");
    AI("kleinprotheg",
     "Das bin ich, Du Sack!", "sagt frech: ");
     
  SetProp(P_NAME, "Kleinprotheg");
  SetProp(P_GENDER, MALE);
  AddId(({"kind","kleinprotheg", "protheg", "k_protheg"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(6);
  SetProp(P_HANDS, ({" mit seinen starken Haenden",90,DT_BLUDGEON}));
  SetProp(P_BODY, 20);
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, -300);
  SP(P_RACE, "");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE,0);
  
  SetProp(P_MSGIN, "springt BRUMMM BRUMMM machend hervor");
  SetProp(P_MSGOUT, "springt BRUMMM BRUMM machend davon");
  SetProp(P_MMSGIN, "springt laut BRUMM BRUMM machend herein");
  SetProp(P_MMSGOUT, "springt BRUUMMMM machend davon");
  
        
  SetProp(P_DIE_MSG,  " macht das letze Mal BRUMMMMMM!\n");
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: BRUMMMMM BRUMMMMM!\n"}));
  
  SP(P_INFO, BS(
  QueryProp(P_NAME)+" ist von einem Daemon besessen. Hab also keine "
  "Gnade und walte Deines Amtes. Der wahre "+QueryProp(P_NAME)+""
  " kann nur wiederentstehen, wenn Du dieses Wesen toetest!"));
  
  
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    QueryProp(P_NAME)+" sagt: Was soll ich damit?!\n" }) );
  SetChats(20,({
QueryProp(P_NAME)+" tritt Dir ins Bein!\n",
QueryProp(P_NAME)+" spuckt Dich an!\n",
QueryProp(P_NAME)+" verhoehnt Dich!\n",
QueryProp(P_NAME)+" lacht Dich aus!\n",
QueryProp(P_NAME)+" zieht Dich an den Haaren!\n",
QueryProp(P_NAME)+" sagt: Du bist ja zu bloed!\n",

"Kleinprotheg macht BRUMMMM BRUMMMMMM!\n",
"Kleinprotheg sagt: Ich will ESSSSEN!!!\n",
"Kleinprotheg sagt: Sisqui sagt ich sei ein Riesenbaby!\n",
"Kleinprotheg sagt: Wenn ich gross bin bekomme ich ein BRUMM BRUMM!\n",
"Kleinprotheg sagt: Mit meinem BRUMM BRUMM ueberfahre ich Dich dann!\n",
"Kleinprotheg bruellt Dir BRUMMMMMM BRUMMM ins Ohr!\n",
"Kleinprotheg sagt: Die Wueste lebt! BRUMM!\n"}));


              
  } 
  
reset()  {
  ::reset();
 count++;
 if(count>=1)  {
  write(QueryProp(P_NAME)+" verschwindet wieder irgendwo!\n");
 	  	
}}


Defend(int dam, dam_type)
{
 object enemy, schl;
    if(!(enemy = QueryEnemy()))
    enemy = TP ;
    if(schl = present("rohrstock", enemy))
                 {
        if(schl -> QueryWielded())  {
 return ::Defend(dam, dam_type); }

else  {
                         tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;  } }
 
 
                   else {
                        tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht sich krumm ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;
                          } }



  die(arg)  {
  	
  		object ob;
  	ob=deep_present("KINDER_DANTE", TP);
  	if(ob)  {
  ob->KillChild();  }
  	
  write(
  "Ein Daemon faehrt aus der Leiche, verflucht Dich und verschwindet dann!\n");
  
  call_other("d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), "pro_stirbt");
  ::die(arg); }
  