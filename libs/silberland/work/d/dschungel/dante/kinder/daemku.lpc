//daemonenkugel
//macht schaden bei allen npcs im raum
//mal sehn:) 

inherit "/std/unit";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <wizlevels.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

create() {
  if (!is_clone(TO) ) return;
  ::create();
  SetProp(P_NAME,({"Daemonenkugel","Daemonenkugeln"}));
  AddId(({"kugeln","daemonenkugeln"})); 
  AddSingularId(({"kugel","daemonenkugel"}));
  AddId("DAEMONEN_KUGEL");
  SetProp(P_SHORT, "Eine schwarze Daemonenkugel");
  SP(P_NAME_ADJ, "schwarz");
  SetProp(P_LONG, BS(
        "Diese Daemonenkugel gehoerte einst einem Daemon namens "
        "Tzakathz. Sie besteht aus schwarzem Stahl, in den blutrote "
        "verkehrte Kreuze eingebrannt wurden."));
  AD(({"kreuz","kreuze"}),
      "Die Kreuze leuchten unheimlich!");
  AD("stahl",
      "Kalter schwerer Stahl!");
  SetProp(P_INFO, "Die Kugel ist eine magische Waffe. Cmd:<wirf, werfe> \n");
  SetProp(P_MATERIAL, ([MAT_STEEL:90,MAT_MAGIC:10]));
  AddPluralId(({"daemonenkugeln","kugeln"}));
  SetCoinsPerUnits(1000,1);
  SetGramsPerUnits(100,1);

  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 1000);  

  //so nun kommt der doofe teil:))

  SetProp(P_COMBATCMDS, (["wirf kugel":
        ([C_MIN:10,C_AVG:22,C_MAX:35,C_DTYPES:({DT_MAGIC,DT_TERROR})])
        ]));

  AddCmd(({"wirf","werfe", "werf"}),"hit_me");
}

hit_me(str)
{
  object pl,ob,targs,env;
  int i,dam;
  string aus;

  if (!str) return 0;
  if (!(pl=PL)) return 0;
  if (ME!=present(lower_case(str),PL)) return 0;
  if (!ME->id(str)) return 0;
  if (!env=environment(PL)) return 0;
  if (QueryProp(P_AMOUNT)<1) return 0;
  if (pl->QueryProp(P_GHOST)) {
    notify_fail("Das kannst Du in diesem immateriellen Zustand nicht.\n");
    return 0;
  }
  if ((pl->QueryProp(P_MAX_HANDS) -
        pl->QueryProp(P_USED_HANDS)) <1) {
    write("Du brauchst mindestens eine freie Hand.\n");
    return 1;
  }

  if(PL->QueryProp(P_ATTACK_BUSY))
  {
    write( "Du schaffst es nicht die Daemonenkugel zu werfen.\n");
    return 1;
  }

  /*
     das hier is sehr wichtig aus balancegruenden also NIE entfernen

     dante 99.10.10

*/    

  if(PL->InFight())  {

    write("Du schaffst es nicht die Kugel waehrend dem Kampf zu werfen!\n");
    return 1; }





    PL->SetProp(P_ATTACK_BUSY, 1);  
    targs=({});  
    if (query_once_interactive(PL)) {
      for (ob=first_inventory(env);ob;ob=next_inventory(ob)) {
        if (!living(ob)) continue;
        if (query_once_interactive(ob)) continue;

        targs+=({ob});
      }
    } else {
      for (ob=first_inventory(env);ob;ob=next_inventory(ob)) {
        if (!living(ob)) continue;
        if (!interactive(ob)) continue;
        if (IS_LEARNER(ob)) continue;

        if(IS_WIZARD(ob)) continue;
        //nun drin!!!


        if (ob->QueryProp(P_INVIS) || ob->QueryProp(P_WANTS_TO_LEARN))
          continue;

        targs+=({ob});
      }
    }

    AddAmount(-1);
    write("Du wirfst eine Daemonenkugel.\n");
    say(capitalize(PL->name(WER))+
        " wirft eine Daemonenkugel.\n",PL);
    if (!sizeof(targs)) {
      tell_room(env,"Die Daemonenkugel leuchtet hell auf und explodiert, trifft aber niemanden.\n");
      return 1;
    }
    aus="";
    for (i=sizeof(targs)-1;i>=0;i--) {
      aus+=targs[i]->name(WEN);
      if (i)
        aus+=((string)((i>1)?", ":" und "));
    }
    say(BS(
          "Die Daemonenkugel leuchtet auf, explodiert und trifft "+aus+"."),targs);
    dam= 50+pl->QueryAttribute(A_INT)*5+random(150);  // 50..314 (50+23*5+149)
    for (i=sizeof(targs)-1;i>=0;i--) {
      ob=targs[i];
      //     tell_object(ob,"Die platzende Daemonenkugel trifft Dich.\n");
      ob->Defend( dam, ({DT_MAGIC, DT_TERROR}), 
          ([SP_NAME:"Daemonenkugel", SP_SHOW_DAMAGE:1]), PL);
    }
    return 1;
}
