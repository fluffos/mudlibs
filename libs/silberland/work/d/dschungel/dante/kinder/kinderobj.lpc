   void KillChild(){
   tote++;

   if(tote>=WIEVIELE) {
   	call_out("tm_g", 1); }  }
   	
   	void tm_g()  {
   object ob, na, stock;
   stock=deep_present("rohrstock", TP);
   if(stock)  {
   	stock->remove(1);
   	write("Dein Rohrstock zerbricht in 1000 Teile!\n");  }
   	
   ob=environment(TO);
   na=ob->QueryProp(P_NAME);
   tell_object(ob,
   "Gouvernante teilt Dir mit: He, "+na+", ich denke, das reicht!\n"
   "Gouvernante teilt Dir mit: Die Kinder haben genug geblutet!!!*lol*\n"
  "Gouvernante teilt Dir mit: Du solltest nun wohl besser Kleindante suchen!\n");
   TO->AddId("KINDER_DANTE_KINDERTOT");}
    
   
       
     


