//obj fuer quest by dante
inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

#include <moving.h>
#include "/players/dante/myowndefine.h"

#define QUESTKEY "Keine Gnade"
#define WIEVIELE 10

int counter=0;
int tote=0;

void KilledChild();
 
create()
{
  if(!is_clone(this_object())) return;

  ::create();

  seteuid( getuid(this_object()));  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  SP(P_AUTOLOADOBJ, 1);

  AddId(({"KINDER_DANTE"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}
 
