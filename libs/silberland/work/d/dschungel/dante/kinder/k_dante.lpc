// dante@SilberLand
//questnpc fuer kindertoetenquest
//dante

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

 
void create()
{
  if (!is_clone(TO)) return;
  ::create();
AddId("NOWIMPY");  
  SetProp(P_SHORT, "Kleindante, der Halbdaemon");
  SetProp(P_LONG, BS(
  "Das ist Kleindante! Mittlerweile schon laengst mehr Daemon als Kind! "
  "Engel war er nie einer, aber nun ist er nur mehr boesartig! Sein "
  "Gesicht ist zu einer ekligen Fratze entstellt und sein Koerper "
  "ist total ueberzogen mit einer seltsamen schwarzen Haut aus "
  "totem Fleisch! Krallen sind ihm aus seinen Fingern gewachsen, mit "
  "denen er nur eines will, Dich zerfetzen und quaelen. Sei auf der Hut!"));
  
  
  AD(({"gesicht","fratze"}),
  "Boesartig grinst Dich die eklige Fratze an!");
  AD(({"koerper","haut"}),
  "Der Koeper ist entstellt durch eine seltsame, schwarze Haut, die "
  "den Halbdaemon schuetzt!");
  AD(({"fleisch"}),
  "Schwarzes, totes Fleisch!");
  AD(({"krallen","finger","kralle"}),
  "Spitze, giftige Krallen!");
  
  
      
  SetProp(P_NAME, "Kleindante");
  SetProp(P_GENDER, MALE);
  AddId(({"kind","kleindante","halbdaemon", "k_dante"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit seinen Krallen",200,DT_RIP}));
  SetProp(P_BODY, 30);
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -500);
  SP(P_RACE, "Halbdaemon");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE,1);
  
  SetProp(P_MSGIN, "springt direkt aus der Wand");
  SetProp(P_MSGOUT, "springt davon");
  SetProp(P_MMSGIN, "springt direkt aus der Wand hervor");
  SetProp(P_MMSGOUT, "faehrt in den Boden davon");
  
        
  SetProp(P_DIE_MSG,  " flucht laut!!!\n");
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Halts Maul!!!\n"}));
  
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Kleindante sagt: So ein Mist!!!\n" }) );
    
  SetAttackChats(20,({
 "Kleindante, der Halbdaemon sagt: Du Sau hau ab!\n",
 "Kleindante, der Halbdaemon bruellt Dich an!\n",
 "Kleindante, der Halbdaemon tritt Dir zwischen die Beine!\n",
 "Kleindante, der Halbdaemon spuckt Dich an!\n",
 "Kleindante, der Halbdaemon verhoehnt Dich!\n",
 "Kleindante, der Halbdaemon sagt: Deine Mutter war eine Hure!(c) Jojogeist!\n",
 "Kleindante, der Halbdaemon sagt: Du mieser Arsch!\n"}));
 AI("dante",
  "HIHI!!! Der werde ich mal wenn ich gross bin!", "lacht: ");
   AI("kleindante",
    "Das bin ich, Du Sack!", "sagt frech: ");
              
  SP(P_SPELLRATE, 50); 
              
  AddSpell(7,250,
  "Kleindante, der Halbdaemon sticht Dir seine Krallen in den Bauch!\n",
  "Kleindante, der Halbdaemon sticht @WEM seine Krallen in den Bauch!\n",
  DT_RIP, ([SP_SHOW_DAMAGE:1]));
  
               
  AddSpell(4,350,
  "Kleindante, der Halbdaemon sticht Dir seine Krallen ins Gesicht!\n",
  "Kleindante, der Halbdaemon sticht @WEM seine Krallen ins Gesicht!\n",
  DT_RIP, ([SP_SHOW_DAMAGE:1]));            
              
              
                           
  AddSpell(1,50,
  "Kleindante, der Halbdaemon will Dich vergiften!\n",
  "Kleindante, der Halbdaemon will @WEN vergiften!\n",
  DT_POISON, "spell_gift");
  } 


reset()  {
	::reset();
	write("Kleindante, der Halbdaemon grinst und ist dann verschwunden!\n");
	remove();  }
	


spell_gift(object enemy)  {
  tell_object(enemy,
  "Kleindante der Halbdaemon vergiftet Dich!\n");
  enemy->AddPoison(random(2)+1);
}
	
	
	


Defend(int dam, dam_type)
{
 object enemy, schl;
 
 
    if(!(enemy = QueryEnemy()))
    enemy = TP ;
    
/*    
    if(!deep_present("KINDER_DANTE_KINDERTOT", enemy))  {
    	tell_object(enemy,
    	"BUG!!! Melde das bitte Dante oder einem anderen Magier!\n");
    	TPM("/gilden/abenteurer", M_GO); 
         }   
    
 */
    
    if(schl = present("KINDER_AXT", enemy))
                 {
        if(schl -> QueryWielded())  {
 return ::Defend(dam*4, dam_type); }

 else   {
 	tell_object(enemy,
 	"Kleindante, der Halbdaemon verhoehnt Dich!\n");
 	 return ::Defend(0, dam_type); } }

else  {
                         tell_object(enemy,
  TO->QueryProp(P_SHORT)+" lacht ueber Deine enorme Dummheit!!!\n");
       
       return ::Defend(0, dam_type); } }
 
        
       
       
 

  die(arg)  {
  	object kinderobj, axt;
  	axt=deep_present("KINDER_AXT", TP);
  	kinderobj=deep_present("KINDER_DANTE_KINDERTOT", TP);

  	if(kinderobj)  {
 kinderobj->AddId("KINDER_DANTE_DANTETOT");
  write(
  "Kleindante, der Halbdaemon bruellt laut auf und verflucht Dich:\n"
 "Du verfluchtes $%º$!!$&&%&!!! Na warte! Das wirst Du buessen!!!\n\n"
"Dann blinkt das Tor im Westen hell auf. Vielleicht ist nun die Zeit reif...!\n");


 
  call_other("d/dschungel/dante/kinder/kinder3:"+getuid(this_player()), "dante_stirbt");
}
if(!kinderobj)  {
	 write("NIX DA!\n");
	 heal_self(500); return ; }
	 if(axt)  {
	 	axt->remove(1);
	 write("Deine rostige Axt zerbroeselt!\n"); }
  ::die(arg); }





init()  {
::init();
if(interactive(TP))  {
call_out("mp_abzug", 0); }}

mp_abzug()   {
if(environment(TO)!=environment(TP)) return ;
 else  
 write("Kleindante, der Halbdaemon saugt Dir Magie ab!\n");
 TP->restore_spell_points(-random(15));
 call_out("mp_abzug", 5);   }
  