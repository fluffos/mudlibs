//raum fuer die gouvernante

#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <wizlevels.h>      
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <player.h>
#define NEIN   if(!present("KINDER_DANTE", TP)) {write("Sorry, Du musst erst mit Gouvernante reden!\n"); return 1;  }
#define STOCK   deep_present("rohrstock", TP)

#define QUESTKEY "Keine Gnade"
#define NEU call_out("neuer_ort", 0);


/*
   es gint 2 raeume fuer tzakatz im kinder5.c kommt man hin wenn man
   die quest spielt
   im questraum kommt man hin wenn man ihn umhauen will
   da kommt man nur hin wenn man die quest ereits hat
   */




int ort=random(5);
int snake=3;
int heilen=3;
int rand=random(5)+1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Vorraum des Kindergartens" );
  SetProp( P_INT_LONG, BS(
        "Hier befindest Du Dich im Vorraum des Kindergarten von Tijara. "
        "Durch die grossen Fenster faellt viel Licht von draussen herein und "
        "schaffen eine freundliche, angenehme Atmosphaere, ideal fuer die Erziehung "
        "von unschuldigen, kleinen Kindern. Bunte Tapeten erheitern Dich sofort "
        "mit ihren lustigen Motiven aus der Maerchenwelt. Der Boden besteht aus "
        "hellgruen gestrichenem Holz und passt so sehr gut zu den blitzblauen "
        "Kleiderhaken, die an den Waenden montiert sind. Sonst sieht man nur "
        "einen Schreibtisch, der hellgelb bemalt ist. Im Osten fuehrt eine "
        "grosse, rote Tuere in den Hauptraum des Kindergartens. Im Norden "
        "kommt man durch eine weisse Tuere wieder auf die Strassen von Tijara "
        "zurueck.")); 

  AD(({"tisch","schreibtisch"}),
      "Der Schreibtisch besteht ebenfalls aus Holz. Er ist hellgelb bemalt und "
      "gehoert Gouvernante. Auf der grossen Tischplatte liegen viele Zettel.");
  AD(({"platte","tischplatte"}),
      "Die Tischplatte besteht eben so aus Holz. Irgendwie wirkt sie protzig. "
      "Darunter sieht man eine Lade.");
  AD(({"lade","tischlade"}),
      "Die Tischlade ist verschlossen. Ein stabiles Schloss sichert sie. Hmm, "
      "wie kann man sie wohl aufbekommen...");
  AD("schloss",
      "Das Schloss scheint stabil zu sein. Wo mag wohl der Schluessel sein...haha, "
      "ein Reim.");
  AD(({"reim","forscherpunkt","punkt","forscherpunkte", "detail"}),
      "Dieses Detail war "+rand+" Forscherpunkte wert.");
  AD("schluessel",
      "Hmm, so einfach wird man den wohl nicht finden.");

  AD("gouvernante",
      "Die Gouvernante scheint nicht hier zu sein.");
  AD("zettel",
      "Die Zettel liegen wild verstreut herum. Man hat sie mit einer seltsamen, "
      "schweren Figur beschwert.");
  AD("figur",
      "Die Figur stellt eine eklige Fratze dar. Was sucht soetwas in einem Kindergarten!");
  AD("fratze",
      "Die Fratze lacht Dich boese an. Ihre Augen strahlen magisch.");
  AD(({"auge","augen"}),
      "Die Augen blicken stumm und boesartig. Der Mund steht leicht offen.");
  AD("mund",
      "Dir steht der Mund offen, als Du siehst, was im Mund der Fratze ist! "
      "Die Zunge ist schwarz und verkohlt!!!");
  AD("zunge",
      "In die Zunge hat jemand ein blutrotes, verkehrtes Kreuz eingebrannt!");

  ASD("kreuz", "go_down");

  AD(({"strasse","strassen"}),
      "Die Strassen von Tijara sind meistens sehr belebt.");


  AD("haelfte",
      "1/2");
  AD("ordnung",
      "Bitte raeumen Sie umgehend mein homedirectory auf! Danke sehr!");
  AD("boden",
      "Der Boden besteht aus Holz, das man hellgruen gestrichen hat. Das Emblem des "
      "Kindergartens wurde auch eingestanzt.");
  AD("emblem",
      "Es ist irgendwie verschlungen und da stehen dumme Worte wie Lernen fuer das "
      "Leben oder so...");
  AD(({"lernen","worte"}),
      "Du denkst . o O (So ein Schrott!)");
  AD(({"himmel","decke"}),
      "Die Decke ist hellblau bemalt und stellt einen Himmel voller Sterne dar.");
  AD(({"stern","sterne"}),
      "Die Sterne leuchten magisch. Du bist fasziniert. Irgendwie blinkt ein "
      "Stern besonders hell...Tip: heller stern!");
  AD(({"heller stern", "besonders heller stern","blinkender stern"}),
      "Der Stern blinkt so hell, dass Du geblendet wirst und auf einmal eine "
      "kurze Vision hast!");
  AD("vision",
      "Du siehst Dich auf ein Kind einschlagen und ploetzlich stirbt das Kind und "
      "aus der Leiche steigt ein grausiger Daemon empor!!! Mehr kannst Du nicht "
      "erkennen...");
  AD("leiche",
      "Die Vision ist wieder weg.");
  AD("holz",
      "Hier ist vieles aus Holz. Je nach dem hat es auch eine andere Farbe.");
  AD("farbe",
      "Rot, weiss, gruen...");
  AD(({"wand","waende"}),
      "Die Waende sind mit bunten Tapeten verziert. Sie weisen einige Kleiderhaken "
      "auf.");
  AD(({"haken","kleiderhaken"}),
      "Die Kleiderhaken dienen wohl zum aufhaengen der Kleider der Kinder. Vermute ich...");
  AD("kleider",
      "Einer der Haken ist besonders gross. Seltsam...");
  AD(({"grosser haken", "form"}),
      "Der grosse Haken hat die Form einer Schlange.");
  ASD("schlange", "snake");

  AD(({"tapete","tapeten"}),
      "Die Tapeten sind sehr bunt und weisen lustige Motive auf.");
  AD(({"motiv","motive"}),
      "Du siehst den gestiefelten Kater, Frau Holle, Schneewittchen, Rapunzel, "
      "den traurigen Drachen Kunibald und und und...");


  //infos fuer den rohrstock!!!

  AD(({"kater","gestiefelter kater"}),
      "Der gestiefelte Kater hat schmutzige Stiefel.");
  AD("stiefel",
      "Hmm, man koennte doch...");

  AD("frau",
      "Frau Holle!");
  AD("schrott",
      "So wie alles hier...");
  AD("kissen",
      "Sie schuettelt ihre Kissen aus und so schneit es...");
  AD(({"holle", "frau holle"}),
      "Frau Holle schuettelt gerade ein Kissen aus und es schneit. Der Schnee faellt "
      "locker und flockig nach unten.");
  AD("schnee",
      "Schneebaelle zu formen ist sehr lustig!");
  AD(({"ball","schneeball","schneebaelle"}),
      "Du solltest das echt einmal versuchen!");



  AD("schneewittchen",
      "Schneewittchen sieht hier sehr traurig aus. Sie benoetigt sicher Trost.");
  AD("trost",
      "Naja, sei doch nett!");



  AD("rapunzel",
      "Rapunzel hat langes, blondes Haar.");
  AD("haar",
      "Das Haar von Rapunzel reizt Dich! Irgendwie sollte man es vielleicht abschneiden...");


  AD(({"drache","kunibald","drache kunibald"}),
      "Kunibald ist ein kleiner, junger Drache. Aus irgendeinem Grund ist er "
      "traurig. Zum Lachen! Ein trauriger Drache! Drachen haben doch boese zu sein! "
      "Man sollte ihn verspotten!");
  AD("grund",
      "Den kenne nur ich.");


  //infos aus





  AD(({"welt","maerchenwelt"}),
      "Die Welt der Maerchen.");
  AD("maerchen",
      "Kennst Du das Maerchen vom realitaetsfernen, mudsuechtigen Menschen, der "
      "schliesslich unter einer Bruecke leben musste?!");
  AD("menschen",
      "Gibt es die?");
  AD("bruecke",
      "0 FP dafuer!");


  AD("erziehung",
      "Erziehung ist das halbe Leben, die andere Haelfte ist Ordnung. Wo bleibt dann "
      "eigentlich das Leben?!");
  ASD("leben", "show_dead");

  AD("licht",
      "Hier ist es hell und freundlich.");
  AD("atmosphaere",
      "Dieser Raum gefaellt Dir sehr gut und irgendwie bereust Du es kein Kind "
      "mehr zu sein...");
  AD(({"kind","kinder"}),
      "Die Kinder sind anscheinen nicht hier. Sie sind ja auch im Hauptraum. "
      "Aber, wenn Du ganz genau in Deinen Monitor schaust, siehst Du gerade nun, "
      "in diesem Moment, ein spielendes Kind!!! Wer koennte das wohl sein!");
  AD("monitor",
      "Schau genau!");
  AD("moment",
      "Noch immer spielt das Kind im Monitor!");
  AD("hauptraum",
      "Der Hauptraum ist im Osten. Dort sind auch die Kinder!");
  AD("osten",
      "Im Osten liegt der Hauptraum. Du kannst ihn durch eine rote Tuere betreten!");
  AD(({"tuer","tuere"}),
      "Welche? Rot oder weiss?");
  AD(({"rote tuere","rote tuer"}),
      "Die rote Tuere fuehrt nach Osten in den Hauptraum!");
  AD(({"weisse tuer","weisse tuere"}),
      "Die weisse Tuer fuehrt nach draussen.");
  AD(({"raum","vorraum"}),
      "Das hier ist der Vorraum des Kindergartens. Ein netter Raum!");
  AD(({"garten","kindergarten"}), 
      "Der Kindergarten von Tijara ist beruehmt. Du befindest Dich im Vorraum des "
      "Kindergartens.");
  AD("tijara",
      "Du stehst mitten in Tijara. Sozusagen...");

  AD("fenster",
      "Durch die vielen grossen Fenster faellt viel Licht herein. Daher ist es "
      "hier hell und gemuetlich. Die Fenster sind sauber geputzt. HE! Du entdeckst "
      "einen kleinen Fettfleck!");

  AD(({"fettfleck", "fleck"}),
      "Der Fettfleck erweist sich als Nachricht!");
  AD("nachricht",
      "Lies sie, es wird Dir sicher nuetzen.");
  ARD("nachricht",
      "Die Kinder sind verflucht! Huete Dich vor ihnen! In jedem einzelnen steckt ein "
      "Daemon!!!");
  AD( ({"daemon", "daemonen", "wesen"}),
      "Daemonen sind abgrundtief boese Wesen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]) );

  AddSound(DEFAULT_SOUND,
      "Von nebenan hoert man lautes Schreien!");
  AddSound(({"schreien", "schreie"}),
      "Laute, schrille Schreie!!!");
  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach nichts.");
  AddSmell( "nichts",
      "Fuer nach nichts riechen gibts sicher keine Forscherpunkte....");

  AddItem("/d/dschungel/dante/kinder/gou" , REFRESH_DESTRUCT);
  AE("norden", "/d/dschungel/dante/tijaraneu/room/ti_pfad3");

  ASE("ostunten", "go_o"); 

  ACD(({"putze","putz","saeuber","saeubere"}), "ort0");
  ACD(({"forme","form"}), "ort1");
  ACD(({"troeste","troest"}), "ort2");
  ACD(({"verspotte", "verspott","spotte","spott"}), "ort3");
  ACD(({"schneid","schneide"}), "ort4");

  ACD(({"sperr","sperre","schliess","schliesse"}), "heal_now");
  ACD(({"oeffne","oeffnen","mach","mache"}), "nix1");
  ACD(({"brech","brich","breche","reisse","reiss","knacke","knack"}), "nix2");

  //call_out("nummer", 0);
}

int go_o()  {


  /*
     if(TP->QueryQuest(QUESTKEY))  {

     write(BS(
     "Wozu zweimal?!"));
     return 1;
     }
     */



  if(!present("KINDER_DANTE", TP))  {
    NF(BSA(
          "He! "+TPN+" zuerst musst Du mal mit mir reden! Stop!",
          "Gouvernante teilt Dir mit: "));  
  }
  else
    return TPM("/d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), M_GO,
        "nach Osten", "geht");
  //	   previous_object()->CustomizeObject();    
}


int ort1 (string str)   {
  object ob;
  NF("Was willst Du formen?!\n");
  NEIN

    if(str=="schneeball"||str=="ball"||str=="ball aus schnee"||str=="schneeball aus schnee")  {


      if(( ort!=1)|| STOCK )   {
        write(BS(
              "Du versuchst aus dem Schnee einen Ball zu formen, bekommst aber nur kalte Finger."));
        say(CAP_TPN+" spielt im Schnee!\n");
        return 1; 
      }


      if (ort==1)    {
        write(BS(
              "Du versuchst aus dem Schnee einen Ball zu formen, bekommst aber nur kalte "
              "Finger. Frau Holle grinst freundlich und schenkt Dir dann etwas!"));
        say(CAP_TPN+" spielt im Schnee?!\n");
        ob=clone_object("d/dschungel/dante/kinder/rstock");
        ob->move(TP, M_NOCHECK);
        NEU
          return 1; 
      }
      return 0; 
    }
  return 0; 
}


nummer()  {
  object ob;
  ob=find_living("dante");
  if(ob)  {
    tell_object(ob,
        "Ort: "+ort+"\n");   
  }  
}





int ort4 (string str)   {
  object ob;
  NF("Was willst Du abschneiden?!\n");
  NEIN


    if(str=="haar ab"||str=="haare ab" ||str=="rapunzel haar ab"||
        str=="rapunzel haare ab"||str=="rapunzels haare ab"||
        str=="rapunzels haar ab")  {


      if((ort!=4)||STOCK)   {
        write(BS(
              "Du versuchst Rapunzel Haare abzuschneiden, doch irgendwie gleiten Dir die Haare "
              "immer durch die Finger!"));
        say(CAP_TPN+" guckt dumm!\n");
        return 1; 
      }

      if(ort==4)    {
        write(BS(
              "Du grinst boese und schneidest Rapunzel eine Haarstraehne ab! Rapunzel findet "
              "das weniger lustig und wirft daher etwas nach Dir!!!"));
        say(CAP_TPN+" grinst boese?!\n");
        ob=clone_object("d/dschungel/dante/kinder/rstock");
        ob->move(TP, M_NOCHECK);
        NEU
          return 1; 
      }

      return 0; 
    }
  return 0; 
}



int ort0 (string str)   {
  object ob;
  NF("Was willst Du putzen/saeubern?!\n");
  NEIN


    if(str=="stiefel") {
      if((ort!=0)||STOCK)   {
        write(BS(
              "Du putzt dem gestiefelten Kater die Stiefel. Er grinst Dich an, dann ist "
              "er wieder stumm. Seltsam..."));
        say(CAP_TPN+" putzt gerne Stiefel!\n");
        return 1; 
      }


      if(ort==0)    {
        write(BS(
              "Du putzt die schmutzigen Stiefel des Katers und ploetzlich grinst er Dich an "
              "und schenkt Dir als Belohnung einen Rohrstock!!!"));
        say(CAP_TPN+" bekommt vom gestiefelten Kater etwas geschenkt!\n");
        ob=clone_object("d/dschungel/dante/kinder/rstock");
        ob->move(TP, M_NOCHECK);
        NEU
          return 1; 
      }
      return 0; 
    }
  return 0; 
}


int ort2 (string str)   {
  object ob;
  NF("Wen willst Du troesten?!\n");
  NEIN


    if(str=="schneewittchen")  {

      if((ort!=2)||STOCK)   {
        write(BS(
              "Du versuchst Schneewittchen zu troesten, doch es nuetzt nichts."));
        say(CAP_TPN+" schaut nett.\n");
        return 1; 
      }

      if(ort==2)    {
        write(BS(
              "Du bist nett und troestest Schneewittchen! Als Dank schenkt sie Dir etwas!"));
        say(CAP_TPN+" schaut nett!\n");
        ob=clone_object("d/dschungel/dante/kinder/rstock");
        ob->move(TP, M_NOCHECK);
        NEU
          return 1; 
      }

      return 0; 
    }
  return 0; 
}


int ort3 (string str)   {
  object ob;
  NF("Wen willst Du verspotten?!\n");
  NEIN


    if(str=="drache"||str=="drache kunibald"||str=="kunibald")   {


      if((ort!=3)||STOCK)   {
        write(BS(
              "Du verspottest den Drachen Kunibald und der schaut nur boese!"));
        say(CAP_TPN+" verspottet Erzmagier!\n");
        return 1; 
      }

      if(ort==3)    {
        write(BS(
              "Du verspottest den Drachen Kunibald! Gut so! Irgendwie schaut der Drache nun "
              "gluecklicher aus. Kurz speit er magisches Feuer und Du hast etwas in der Hand!"));
        say(CAP_TPN+" verspottet Magier?!\n");
        ob=clone_object("d/dschungel/dante/kinder/rstock");
        ob->move(TP, M_NOCHECK);
        NEU
          return 1; 
      }

      return 0; 
    }
  return 0; 
}

neuer_ort()   {
  ort=random(5);  
}




int heal_now (string str)   {
  NF("Was willst Du aufsperren/aufschliessen?!\n");  {

    if(!deep_present("kinder_daemonen_key", TP))  {
      write("Nein, Du hast keinen geeigneten Schluessel!\n"
          "Den hat ein Daemon unter Dir...\n");
      return 1; 
    }

    if ((!TP->QueryQuest(QUESTKEY))  &&(!IS_WIZARD(TP)))   {
      write(
          "Ploetzlich ertoent eine dunkle Stimme und lacht Dich aus!\n"
          "Dann saust ein Stachel aus dem Schreibtisch und trifft Dich hart!\n");

      TP->do_damage(10+random(10));

      say(CAP_TPN+" wird von einer dunklen Stimme verhoehnt!\n"
          "Dann wird "+TPN+" von einem Stachel hart getroffen\n");
      return 1; 
    }

    if(member(({"schloss auf", "lade auf", "schreibtisch auf",
            "schreibtischlade auf"
            "schloss mit schluessel auf","lade mit schluessel auf",
            "schreibtisch mit schluessel auf",
            "schreibtischlade mit schluessel auf" }),str)!=-1)   {

      if(heilen>0)    {
        write(BS(
              "Du sperrst die Lade auf. Findest darin einen Zaubertrank, den Du "
              "natuerlich sofort austrinkst. Du fuehlst Dich stark und gut!!!\n"));
        say(CAP_TPN+" sperrt eine Lade auf und findet darin einen Zaubertrank!\n");
        //   domainshout(CAP_TPN+" findet einen Zaubertrank!\n");
        TP->heal_self(200);
        heilen--;
        return 1; 
      }
      if(heilen<=0)    {
        write(
            "Du sperrst die Lade auf. Sie ist aber leider leer und so schliesst Du sie wieder.\n");
        say(CAP_TPN+" oeffnet eine Lade und schaut dann enttaeuscht.\n");
        return 1; 
      }
      return 0;  
    }
    return 0; 
  }
  return 0; 
}






int nix1 (string str)   {
  NF("Was willst Du oeffnen/aufmachen?\n");  

  NEIN

    if(member(({"lade","tischlade","schreibtischlade",
            "lade auf","tischlade auf","schreibtischlade auf"}),str)!=-1)  {

      write(
          "Du versuchst die Lade zu oeffnen, doch ohne Schluessel geht das nicht.\n");
      say(CAP_TPN+" versucht vergeblich eine Lade zu oeffnen.\n");
      return 1; 
    }
  return 0; 
}



int nix2 (string str)   {
  NF("Was willst Du aufbrechen/knacken?\n");  

  NEIN
    if(member(({"lade","tischlade","schreibtischlade",
            "lade auf","tischlade auf","schreibtischlade auf"
            "tisch auf", "schloss auf", "schreibtisch auf"}),str)!=-1)  {
      write("Du versuchst es mit Gewalt, und scheiterst ebenso.\n");
      say(CAP_TPN+" versucht vergeblich  mit Gewalt eine Lade zu oeffnen.\n");
      return 1; 
    }
  return 0; 
}




string go_down()  {

  if ((IS_WIZARD(TP)) || (TP->QueryQuest(QUESTKEY)))     {


    write("Du darfst auch so nach unten...\n"
        "Eine geheime Klappe im Boden geht auf und Du faellst ins Dunkle!\n");
    TPM("d/dschungel/dante/kinder/questraum", M_TPORT, "von einem Loch im Boden ploetzlich verschluckt",
        "wird", "faellt von oben herein");   
  }
  else   {
    write(BS("Das Kreuz sieht bedrohlich und gefaehrlich aus. Vielleicht solltest Du "
          "es noch einmal untersuchen, wenn Du den Auftrag der Gouvernante erfuellt hast!"));  
  }
  return ""; 
}


string snake()   {
  object ob;
  if(snake)  {
    write("Du betrachtest den Haken und ploetzlich formt sich aus ihm eine Schlange!\n");
    say(CAP_TPN+" wird von einer Schlange angegriffen!\n");
    ob=clone_object("d/dschungel/dante/weg/npc/dschlange");
    ob->SetProp(P_SHORT, "Eine Schlange gerufen von "+TPN+"");
    ob->move(TO, M_TPORT+M_SILENT);
    ob->Kill(TP);
    snake--;   
  }
  else   {
    write("Der Haken scheint doch normal zu sein!\n");   
  }
  return ""; 
}


string show_dead()  {
  write("Du hast es bisher "+TP->QueryProp(P_DEADS)+" mal ausgehaucht!\n");
  return ""; 
}

reset()  {
  ::reset();
  snake=3;
  heilen=3;
  rand=random(5)+1;
  ort=random(5);  
}
