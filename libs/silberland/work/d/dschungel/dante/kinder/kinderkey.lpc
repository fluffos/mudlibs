#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
inherit "std/thing";



create()
{
if (!is_clone(TO) )  return;

::create();

SetProp(P_SHORT, "Ein kleiner Schluessel");
SetProp(P_LONG, BS(
"Dieser Schluessel ist klein und sehr fein gearbeitet. Das dazugehoerige "
"Schloss ist sicherlich auch nicht allzu gross."));

SP(P_INFO, "Hmm, der Schluessel passt sicher irgendwo hinein...\n");
SetProp(P_NAME, "Schluessel");
SetProp(P_GENDER, MALE);
AddId( ({"kinderkey", "schluessel"}) );
SP(P_NAME_ADJ, "klein");
SetProp(P_MATERIAL, ([MAT_IRON:100]) );
SetProp(P_WEIGHT, 20);
SetProp(P_VALUE, 0);
SetProp(P_NOBUY, 1);
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
SP(P_MAGIC, 1);
}
