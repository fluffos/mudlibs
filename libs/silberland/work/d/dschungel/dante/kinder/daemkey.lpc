#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
inherit "std/thing";

int count=0;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein schwarzer Schreibtischschluessel");
  SetProp(P_LONG, BS(
        "Dieser Schluessel gehoert zum Schreibtisch der Gouvernante. Sie "
        "arbeitet im Kindergarten von Tijara. Den Schluessel hatte einst "
        "der Daemon Tzakathz gestohlen..."));

  SP(P_INFO, BS("Hmm, der Schluessel kann Dir gute Dienste leisten. Du kannst damit die Lade des Schreibtisches "
        "im Kindergarten von Tijara aufsperren!"));
  SetProp(P_NAME, "Schreibtischschluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({"kinder_daemonen_key", "schluessel", "schreibtischschluessel"}) );
  SP(P_NAME_ADJ, "schwarz");
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  SP(P_NODROP, 0);
  SP(P_NEVERDROP, 0);
  SP(P_MAGIC, 1);
}


reset()  {
  ::reset();

  if(!environment(TO)) return;

  count++;

  if(count>=10)  {
    say("Dein schwarzer Schluessel zerfaellt!\n");
    remove();  
  } 
}

