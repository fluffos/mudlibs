// dante@SilberLand
//questnpc fuer kindertoetenquest

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

int count=0;
 
void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kleinangrox");
  SetProp(P_LONG, BS(
  "Das ist Kleinangrox. Er sieht eigentlich sehr freundlich aus. "
  "Scheinbar legte seine Mutter viel Wert auf Hoeflichkeit. Doch nun "
  "ist sogar er kein nettes Kind mehr. Seltsam. Irgendwie, glaubst "
  "Du einen leichten Anflug von Bart auf seiner Oberlippe zu erkennen..."));
  
  AD("bart",
  "Hmm, oder taeuscht das nur...");
  AD("anflug",
  "Hmm, ja leicht dunkel ist die Lippe ja.");
  AD(({"oberlippe","lippe"}),
  "Du glaubst einen Bart zu sehen. Bei einem Kind?!\n");
  
 AI("angrox",
  "HIHI!!! Der werde ich mal wenn ich gross bin!", "lacht: ");
   AI("kleinangrox",
    "Das bin ich, Du Sack!", "sagt frech: ");      
  SetProp(P_NAME, "Kleinangrox");
  SetProp(P_GENDER, MALE);
  AddId(({"kind","kleinangrox", "angrox", "k_angrox"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen Haenden",80,DT_BLUDGEON}));
  SetProp(P_BODY, 15);
  SetProp(P_SIZE, 70);
  SetProp(P_ALIGN, -300);
  SP(P_RACE, "Zwerg");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE,0);
  
  SP(P_INFO, BS(
  QueryProp(P_NAME)+" ist von einem Daemon besessen. Hab also keine "
  "Gnade und walte Deines Amtes. Der wahre "+QueryProp(P_NAME)+""
  " kann nur wiederentstehen, wenn Du dieses Wesen toetest!"));
  
  
  SetProp(P_MSGIN, "materialisiert sich vor Dir");
  SetProp(P_MSGOUT, "loest sich auf");
  SetProp(P_MMSGIN, "materialisiert sich vor Dir");
  SetProp(P_MMSGOUT, "loest sich auf");
  
        
  SetProp(P_DIE_MSG,  " sagt: Das war aber nicht nett!!!\n");
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Bitte! Immer hoeflich sein!\n"}));
 AI(({"bart"}),
 "Eine boesartige Luege von Kleindante!", "sagt: ");
  
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    QueryProp(P_NAME)+" sagt: Was soll ich damit?!\n" }) );
  SetChats(20,({
QueryProp(P_NAME)+" tritt Dir ins Bein!\n",
QueryProp(P_NAME)+" spuckt Dich an!\n",
QueryProp(P_NAME)+" verhoehnt Dich!\n",
QueryProp(P_NAME)+" lacht Dich aus!\n",
QueryProp(P_NAME)+" zieht Dich an den Haaren!\n",
QueryProp(P_NAME)+" sagt: Du bist ja zu bloed!\n",


"Kleinangrox sagt: Wenn ich gross bin werde ich Erzmagier!\n",
"Kleinangrox tritt Dir ins Bein und entschuldigt sich dann!\n",
"Kleinangrox denkt . o O 'Ich sollte einmal auf den Tisch hauen!'.\n",
 "Kleinangrox sagt: Irgendwie liebe ich die Gouvernante...\n",
 "Kleinangrox sagt: Kleindante quaelt mich immer...\n",
 "Kleinangrox sagt: Kleindante zwingt mich zum testen!\n",
 "Kleinangrox sagt: Wenn ich gross bin, designe ich T-Shirts.\n",
 "Kleinangrox denkt an Druidenspells...seltsam?!\n",
 "Kleinangrox sagt: 3 Monate fuer 10 Files muessen reichen...\n"}));
              
  } 


Defend(int dam, dam_type)
{
 object enemy, schl;
    if(!(enemy = QueryEnemy()))
    enemy = TP ;
    if(schl = present("rohrstock", enemy))
                 {
        if(schl -> QueryWielded())  {
 return ::Defend(dam, dam_type); }

else  {
                         tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;  } }
 
 
                   else {
                        tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht sich krumm ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;
                          } }


reset()  {
  ::reset();
 count++;
 if(count>=1)  {
  write(QueryProp(P_NAME)+" verschwindet wieder irgendwo!\n");
}} 	  	


  die(arg)  {
  	
  		object ob;
  	ob=deep_present("KINDER_DANTE", TP);
  	if(ob)  {
  ob->KillChild();  }
  write(
  "Ein Daemon faehrt aus der Leiche, verflucht Dich und verschwindet dann!\n");
  
  call_other("d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), "angrox_stirbt");
  ::die(arg); }
  