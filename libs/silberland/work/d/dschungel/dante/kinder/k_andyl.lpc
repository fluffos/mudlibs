// dante@SilberLand
//questnpc fuer kindertoetenquest

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
int count=0;
 
void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kleinandyl");
  SetProp(P_LONG, BS(
  "Das ist Kleinandyl. Er trompetet, trommelt und singt ueberall "
  "und immer. Wenn er gross ist, moechte er einmal Soundmagier werden."));
   
 
AddId("NOWIMPY");
      
  SetProp(P_NAME, "Kleinandyl");
  SetProp(P_GENDER, MALE);
  AddId(({"kind","kleinandyl", "andyl", "k_andyl"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seiner Trommel",80,DT_BLUDGEON}));
  SetProp(P_BODY, 15);
  SetProp(P_SIZE, 70);
  SetProp(P_ALIGN, -300);
  SP(P_RACE, "Hobbit");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE,0);
  
  SetProp(P_MSGIN, "springt trommelnd hervor");
  SetProp(P_MSGOUT, "springt trommelnd davon");
  SetProp(P_MMSGIN, "springt laut trommelnd herein");
  SetProp(P_MMSGOUT, "trommelt sich davon");
  
        
  SetProp(P_DIE_MSG,  " bricht trommelnd nieder!\n");
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Ich trommle fuer mein Leben gern!\n"}));
 AI(({"soundmagier", "sound", "musik"}),
 "Ich liebe die Musik, Du Sack!", "singt falsch: ");
 
 AI("andyl",
 "HIHI!!! Der werde ich mal wenn ich gross bin!", "lacht: ");
 AI("kleinandyl",
 "Das bin ich, Du Sack!", "sagt frech: ");
 
 
 
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    QueryProp(P_NAME)+" sagt: Was soll ich damit?!\n" }) );
  SetChats(20,({
QueryProp(P_NAME)+" tritt Dir ins Bein!\n",
QueryProp(P_NAME)+" spuckt Dich an!\n",
QueryProp(P_NAME)+" verhoehnt Dich!\n",
QueryProp(P_NAME)+" lacht Dich aus!\n",
QueryProp(P_NAME)+" zieht Dich an den Haaren!\n",
QueryProp(P_NAME)+" sagt: Du bist ja zu bloed!\n",

"Kleinandyl meint: Wenn ich gross bin werd ich einmal Soundmagier!\n",
"Kleinandyl trommelt unbekuemmert auf Deinen Zehe herum.\n",
"Kleinandyl faengt auf einmal an laut und falsch zu singen.\n",
"Kleinandyl schreit Dir ploetzlich irrwitzig laut ins Ohr!\n",
"Kleinandyl wirft seine kleine Trommel auf Dich.\n",
"Kleinandyl nuschelt Dir zu: Kleinprotheg is a Luschn, aber ned\n"
"Kleinandyl nuschelt Dir zu: weitersagen!\n",
"Kleinandyl brummelt: Ich bin von lauter Banausen umgeben...\n",
"Kleinandyl ruft: Ich hab HUNGAAAAA !!!\n",
"Kleinandyl sagt: Los sing fuer mich!\n",
"Kleinandyl hechtet sich auf Dich und verwuschelt Dir die Haare.\n", 
"Kleinandyl stopft sich eine Semmel in den Mund.\n",
"Kleinandyl spricht mit vollen Backen: dasch zscheug hie is gutsch *mampf*!\n"}));

  
  SP(P_INFO, BS(
  QueryProp(P_NAME)+" ist von einem Daemon besessen. Hab also keine "
  "Gnade und walte Deines Amtes. Der wahre "+QueryProp(P_NAME)+""
  " kann nur wiederentstehen, wenn Du dieses Wesen toetest!"));
  
              
  } 


Defend(int dam, dam_type)
{
 object enemy, schl;
    if(!(enemy = QueryEnemy()))
    enemy = TP ;
    if(schl = present("rohrstock", enemy))
                 {
        if(schl -> QueryWielded())  {
 return ::Defend(dam, dam_type); }

else  {
                         tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;  } }
 
 
                   else {
                        tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht sich krumm ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;
                          } }

reset()  {
  ::reset();
 count++;
 if(count>=1)  {
  write(QueryProp(P_NAME)+" verschwindet wieder irgendwo!\n");
 	  	
}}



  die(arg)  {
  	object ob;
  	ob=deep_present("KINDER_DANTE", TP);
  	if(ob)  {
  ob->KillChild();  }
   
  write(
  "Ein Daemon faehrt aus der Leiche, verflucht Dich und verschwindet dann!\n");
    
  call_other("d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), "andyl_stirbt");
  ::die(arg); }
  