int down(string str)  {
  NF("Willst Du runter steigen?!\n");
  if(str=="runter"||str=="nach unten")  {
    write("Du steigst durch das Loch nach unten.\n");
    TPM("d/dschungel/dante/kinder/kinder3:"+getuid(this_player()), M_GO,
        "steigt","nach unten");
    return 1; 
  }
  return 0; 
}


//andyl kratzer

c_come1()  {
  object ob;

  XDET    

    if((present("k_andyl", environment(TP))) || (andyl_tot)) {
      write(BS("Aber "+TPN+", wozu noch einen Kleinandyl?!\n"));
      return "";  
    }

    else  {
      ob=clone_object("d/dschungel/dante/kinder/k_andyl");
      write(BS("Du untersuchst den S foermigen Kratzer und ploetzlich "
            "springt etwas hinter Dir herum!"));
      ob->move(TO, M_TPORT);
      // andyl_da=1;
      return "";
    } 
}

andyl_stirbt()  {
  andyl_tot=1;  
}

//andyl ende

