//der kindergarten

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

#define XDET   if(!present("KINDER_DANTE", TP))  {  write("Leider kannst Du hier nichts tun! Geh zuerst zu Gouvernante!\n");return ""; }
#define XFUN  if(!present("KINDER_DANTE", TP))  {  write("Leider kannst Du hier nichts tun! Geh zuerst zu Gouvernante!\n"); return 1; }



int andyl_tot=0;
int pro_tot=0;
int angrox_tot=0;
int mua_tot=0;
int stahl_tot=0;
int dusty_tot=0;
int crea_tot=0;
int berx_tot=0;
int woody_tot=0;
int fey_tot=0;

//wenn jem auch nene kleinname haben will mir sagen aber ich
//hatte nach 10 mags keine lust mehr:))
//fey muss dazu ,der loescht sonst wieder was :)
int count=0;

reset()  {
  ::reset();
  count++;
  if(count>=5)  {
    angrox_tot=0;
    mua_tot=0;
    stahl_tot=0;
    dusty_tot=0;
    crea_tot=0;
    berx_tot=0;
    woody_tot=0;
    fey_tot=0;	
  }
}


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Kindergarten von Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun direkt im Hauptraum des Kindergarten von Tijara. "
        "Irgendwas oder Irgendwer muss hier schlimm gewuetet haben, denn hier "
        "herrscht das totale Chaos. Die Fenster sind zerschlagen und haengen "
        "nur mehr schief in ihren Rahmen. Die Vorhaenge sind zerfetzt. Die "
        "ehemals so schoenen, bunten Tapeten sind mit obszoenen Spruechen "
        "vollgeschmiert oder zerrissen. Das ganze paedagogisch so wertvolle "
        "Spielzeug ist zertrampelt und liegt am Boden herum. Alle Buecher sind "
        "beschmiert und zerrissen. Die bunten, kleinen Sessel sind zertruemmert und "
        "liegen halbverkohlt herum. Unordnung ueber Unordnung. Normale Kinder "
        "koennen so etwas niemals anrichten. Wer hat das wohl getan? "
        "Im Westen fuehrt eine total zerkratzte Tuere wieder in den Vorraum zurueck. "
        "Ein Schacht scheint schraeg durch den Boden nach unten zu fuehren. "));

  AD("schacht",
      "Der Schacht sieht duester und bedrohlich aus. Er fuehrt westwaerts nach "
      "unten.");

  AD("spielzeug",
      "Das Spielzeug liegt zertrampelt am Boden herum. Leider scheint nichts heil "
      "geblieben zu sein. Ein bunter Ball, eine kleine Schaufel und ein Tregoli "
      "scheinen vielleicht noch verwendbar zu sein.");

  AD("irgendwer",
      "Irgendwer lacht Dich aus.");

  AD(({"buch","buecher"}),
      "Die Buecher waren einst so sinnvoll. Nun sind sie nur mehr Muell. Naja, eines "
      "scheint noch halbwegs in Ordnung zu sein. Sein Einband ist interessant.");
  AD("muell",
      "Muell gibt es hier genug.");
  AD("ordnung", 
      "Die herrscht hier sicher nicht.");
  AD("unordnung",
      "Unordnung rulez!");
  AD("einband",
      "Der Einband ist nicht mehr leserlich. Das Buch ist enorm gross und irgendwie "
      "abartig fett. Seltsam. Sollte man den Einband hochklappen...");
  AD("vorhaenge",
      "Die Vorhaenge wehen lustig im Wind. Sie sind zerrissen.");
  AD("wind",
      "Der Wind blaest durch die zerbrochene Fenster herein. Irgendwie wird "
      "dadurch ein Vorhang sehr ausgebeult. Man koennte sagen, er hat eine "
      "Beule.");
  AD("vorhang",
      "Der Vorhang ist sehr ausgebeult. Seltsam. Ob sich dahinter etwas verbirgt..");


  ASD("beule", "c_come4");

  AD("kindergarten",
      "Du stehst im Kindergarten von Tijara!");

  AD("ball",
      "Der Ball scheint das Chaos ueberstanden zu haben. Hmm, was kann man mit "
      "einem Ball machen...");


  AD("schaufel",
      "Die Schaufel liegt einfach so herum. Mehr nicht.");
  AD("tregoli",
      "Tregoli ist ein sehr seltsames Spielzeug. Keiner weiss so recht, welchen "
      "Sinn es hat.");
  AD("sinn",
      "Tregoli ist eine Art Kiste.");
  AD(({"kiste","art"}),
      "Die Kiste hat einen Knopf. Wenn man ihn drueckt kommt ein Kasperl heraus, der alle "
      "Kinder erschreckt.");
  AD("knopf",
      "Welchen Sinn der wohl hat.");
  AD("kasperl",
      "Keines da, ausser Dir.");


  AD("holz",
      "In diesem Raum ist einiges aus Holz. Frueher war es einmal bunt bemalt "
      "und sauber. Nun aber ist es entweder halbverbrannt, zerkratzt oder angeschmiert.");


  AD("rahmen",
      "Die Rahmen sind auch stark beschaedigt. Die zerbrochenen Fenster haengen "
      "schief in ihnen. Eines der Fenster haengt besonders schief. Man sollte vielleicht "
      "probieren, es wieder gerade zu haengen...");


  AD("schiefes fenster",
      "Dieses Fenster haengt besonders schief. Erstaunlich...");


  AD("fenster",
      "Die Fenster sind alle zerbrochen. Vermutlich hat man sie eingeschlagen.");


  AD("kinder",
      "Tja, wo sind nur die Kinder...");
  AD("kind",
      "Hmm, keines da...komisch...");


  AD("sessel",
      "Die ehemals schoenen Sessel der Kinder wurden angezuendet. Ihre Ueberreste "
      "liegen wild verstreut am Boden herum.");

  AD("dschungel",
      "Tijara ist die Hauptstadt des Dschungels. Du bist sozusagen am Anfang des "
      "Dschungels.");
  AD("anfang",
      "Anfangs war dieser Raum sicher einmal sehr schoen, aber nun...HE!!! "
      "Was siehst Du da am Boden! Ein grosses, bisher verdecktes Loch!");

  AD("loch",
      "Das Loch war bisher durch den ganzen Schrott verdeckt. Es scheint nach unten "
      "zu fuehren. Man kann sicher einfach runtersteigen...");

  AD("schrott",
      "Naja, sowas wie Muell. HE! Da am Boden ist ein Loch!!!");


  AD("unordnung",
      "Die Kinder die dieses Chaos verursacht haben, koennen nicht normal gewesen sein, "
      "oder doch.");

  AD("himmel",
      "Der Himmel ist von hier nicht zu erkennen. Aber die Decke ist auch schoen.");
  AD("decke",
      "Die Decke war einst hellblau, wie der Himmel. Nun aber ist sie beschmiert. "
      "Eine grosse Lampe haengt von ihr herab.");
  AD("lampe",
      "Die Lampe schwingt hin und her, als ob jemand sich an ihr hin und her geschwungen hat. "
      "Das wuerde sicher Spass machen.");
  AD("spass",
      "An der grossen Lampe zu schwingen...");

  AD(({"wand","waende"}),
      "Die Waende hatten frueher bunte Tapeten. Doch die sind nun vollgeschmiert "
      "mit Spruechen und zerrissen.");
  AD("chaos",
      "Hier herrscht das totale Chaos. Nichts ist heilgeblieben. Doch etwas. Der "
      "kleine Muelleimer in der Ecke.");
  AD("ecke",
      "In einer Ecke steht ein kleiner Muelleimer.");
  AD(({"eimer","muelleimer"}),
      "Der Muelleimer scheint noch heil zu sein. Ein verbeulter Deckel liegt oben "
      "und irgendwie sieht das ganze sehr interessant aus.");
  AD("deckel",
      "Der Deckel wackelt ein wenig. Sollte man den Deckel nicht einfach hochheben?!");
  AD("boden",
      "Der Boden ist uebersaeht mit zerrissenen Buechern und zerstoertem Spielzeug. "
      "Auch die Ueberreste der kleinen Sessel liegen zerstreut herum. "
      "Ausserdem ist da noch der seltsame Schacht!");
  AD("vorraum",
      "Der Vorraum liegt nebenan. Du hier bist im Hauptraum.");
  AD("hauptraum",
      "Du stehst mitten im Hauptraum des Kindergarten von Tijara.");
  AD("tijara",
      "Tijara ist die Hauptstadt des Dschungels.");
  AD(({"stadt","hauptstadt"}),
      "He! Du entdeckst eine kleine Modellstadt, die halbverwuestet am Boden steht.");
  AD("modellstadt",
      "Die Modellstadt ist aus Holz. Sie zeigt Tijara. Nur mehr ein kleiner Turm "
      "scheint halbwegs ganz zu sein.");
  AD("modell",
      "Einst hat man sicher mehr an diesem Modell erkennen koennen, aber nun...");
  AD(({"tapete","tapeten"}),
      "Die Tapeten sind zerfetzt und mit obszoenen Spruechen beschmiert. Kinder "
      "koennen soetwas doch nicht vollbringen...");
  AD(({"spruch","sprueche"}),
      "Die kann man lesen.");
  AD(({"reste","ueberreste"}),
      "Die Reste der Sessel liegen wild im Raum herum. Irgendjemand muss versucht "
      "haben sie anzuzuenden. Sollte man sein Werk nicht vollenden?!");
  AD("werk",
      "Die Ueberreste anzuenden...");
  ASD("turm", "c_come2");
  AD("westen",
      "Im Westen liegt der Vorraum. Durch eine Tuere kommt man dorthin.");
  AD(({"tuere", "tuer"}),
      "Die Tuere ist total zerkratzt. Die Kratzer sind tief und ueberall.");
  AD("kratzer",
      "Irgendjemand muss an der Tuere gewuetet haben. Einer der Kratzer ist "
      "S foermig.");

  AD("raum",
      "Vorraum ist nebenan. Hauptraum hier.");

  ASD(({"s","S","s foermiger kratzer", "S foermiger kratzer"}), "c_come1");

  ASE("unten", "u");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );


  AddSound( DEFAULT_SOUND,
      "Man hoert leise Geraeusche!");
  AddSound(({"geraeusch","geraeusche"}), 
      "Von irgendwo her hoert man etwas.");

  AddSmell( DEFAULT_SMELL,
      "Es riecht nach Kindern!!");
  AddSmell("kinder",
      "Irgendwo haben sie sich versteckt.");

  AE("westoben", "./kinder1");


  //detail:
  // S kratzer andyl
  //turm angrox
  //beule pro

  //funcs:

  //fenster gerade haengen fey
  //ueberreste anzuenden berx
  //tritt ball woody
  //druecke knopf crea
  //deckel hochheben dusty
  //klappe einband hoch stahl
  //sprueche lesen mua


  ACD(({"haenge", "haeng"}), "c_come10");
  ACD(({"zuende", "zuend"}), "c_come9");
  ACD(({"tritt","trete","tret"}), "c_come8");
  ACD(({"drueck","druecke"}), "c_come7");
  ACD(({"hebe","heb"}), "c_come6");
  ACD(({"klapp","klappe"}), "c_come5");
  ACD(({"lies","lese","les"}), "c_come3");


  ACD(({"steig","steige"}), "down");

  previous_object()->CustomizeObject();          

  ACD(({"schwinge","schwing"}), "spass");
}

int spass(string str)  {
  NF("Wo willst Du rumschwingen oder woran?!\n");
  if(str=="an lampe"||str=="an lampe hin und her"||
      str=="mit lampe"||str=="mit lampe hin und her")  {
    write(BS(
          "Du schwingst Dich mit der Lampe hin und her und ploetzlich "
          "kommt es Dir in den Sinn, dass Du, wenn Du die Kinder oder einen "
          "anderen Daemon bekaempfst und dafuer eine spezielle Waffe verwenden musst, "
          "trotzdem Deinen Gegner zusaetzlich auch mit Magie/Zauberspruechen bekaempfen kannst! "
          "Das beschleunigt die Sache enorm! Schlauer geworden laesst Du die Lampe nun in Ruhe!"));
    return 1; 
  }
  return 0; 
}


u()  {
  NF(BS(
        "Du versuchst, durch den dunklen Schacht nach unten zu gelangen, "
        "gibst es aber wieder auf. Hmm, vielleicht kann man ja hier "
        "irgendwann von unten herauf kommen."));
}



//berx beginn

int c_come9(string str)  {
  object ob;
  NF("Was willst Du anzuenden!?\n");
  XFUN   

    if(str=="ueberreste"||str=="ueberreste an"||str=="reste an")  {

      if((present("k_berx", environment(TP))) || (berx_tot)) {
        write(BS("Aber "+TPN+", wozu noch ein Kleinberxilein?!\n"));  
        return 1;  
      }

      else  {
        ob=clone_object("d/dschungel/dante/kinder/k_berx");
        write(BS(
              "Du zuendest die Ueberreste an. Die Flammen zuengeln hoch und ploetzlich "
              "formt sich etwas aus dem Feuer!"));
        ob->move(TO, M_TPORT);
        return 1; 
      }
      return 0; 
    }
  return 0; 
}


berx_stirbt()  {
  berx_tot=1;  
}



//berx ende



//fey beginn

int c_come10(string str)  {
  object ob;
  NF("Was willst Du gerade haengen!?\n");
  XFUN   

    if(str=="fenster gerade"||str=="gerade fenster")  {

      if((present("k_fey", environment(TP))) || (fey_tot)) {
        write(BS("Aber "+TPN+", wozu noch eine Kleinfeyaria?!\n"));  
        return 1;  
      }

      else  {
        ob=clone_object("d/dschungel/dante/kinder/k_fey");
        write(BS(
              "Du versuchst das Fenster wieder irgendwie gerade zu haengen, doch ploetzlich "
              "springt etwas Kleines dahinter hervor und tritt Dich!"));
        ob->move(TO, M_TPORT);
        return 1; 
      }
      return 0; 
    }
  return 0; 
}


fey_stirbt()  {
  fey_tot=1;  
}



