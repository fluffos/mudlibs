// dante@SilberLand
//questnpc fuer kindertoetenquest

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

int count=0;
 
void create()
{
  if (!is_clone(TO)) return;
  ::create();
AddId("NOWIMPY");  
  SetProp(P_SHORT, "Kleinmuaddib");
  SetProp(P_LONG, BS(
  "Das ist Kleinmuaddib. Angeblich hat er Angst vor Gouvernante, "
  "weil sie ja soo gemein zu ihm ist."));
      
  SetProp(P_NAME, "Kleinmuaddib");
  SetProp(P_GENDER, MALE);
  AddId(({"kind","kleinmuaddib", "muaddib", "k_mua"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
 AI("muaddib",
  "HIHI!!! Der werde ich mal wenn ich gross bin!", "lacht: ");
   AI("kleinmuaddib",
    "Das bin ich, Du Sack!", "sagt frech: ");


  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen Haenden",80,DT_BLUDGEON}));
  SetProp(P_BODY, 15);
  SetProp(P_SIZE, 70);
  SetProp(P_ALIGN, -300);
  SP(P_RACE, "");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE,0);
  
  SP(P_INFO, BS(
  QueryProp(P_NAME)+" ist von einem Daemon besessen. Hab also keine "
  "Gnade und walte Deines Amtes. Der wahre "+QueryProp(P_NAME)+""
  " kann nur wiederentstehen, wenn Du dieses Wesen toetest!"));
  
  
  SetProp(P_MSGIN, "materialisiert sich vor Dir");
  SetProp(P_MSGOUT, "loest sich auf");
  SetProp(P_MMSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MMSGOUT, "loest sich auf");
  AI("gouvernante",
  "Die ist immer so boese zu mir!", "weint: ");
  
        
  SetProp(P_DIE_MSG,  " sagt: AUA, das war ein Hole in One...\n");
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Wir diskutieren das besser aus!\n"}));

  
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    QueryProp(P_NAME)+" sagt: Was soll ich damit?!\n" }) );
  SetChats(20,({
QueryProp(P_NAME)+" tritt Dir ins Bein!\n",
QueryProp(P_NAME)+" spuckt Dich an!\n",
QueryProp(P_NAME)+" verhoehnt Dich!\n",
QueryProp(P_NAME)+" lacht Dich aus!\n",
QueryProp(P_NAME)+" zieht Dich an den Haaren!\n",
QueryProp(P_NAME)+" sagt: Du bist ja zu bloed!\n",

"Kleinmuaddib sagt: Gouvernante ist ja so boese zu mir!\n",
"Kleinmuaddib sagt: Wenn ich gross bin will ich Erzmagier sein!\n",
"Kleinmuaddib sagt: Ich waer so gerne wichtig hier...\n",
"Kleinmuaddib sagt: Ich will Golf-Pro werden!\n",
"Kleinmuaddib denkt an eine Wolke...\n",
"Kleinmuaddib zeigt Dir seinen imaginaeren Putter...\n"}));


  } 


Defend(int dam, dam_type)
{
 object enemy, schl;
    if(!(enemy = QueryEnemy()))
    enemy = TP ;
    if(schl = present("rohrstock", enemy))
                 {
        if(schl -> QueryWielded())  {
 return ::Defend(dam, dam_type); }

else  {
                         tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;  } }
 
 
                   else {
                        tell_object(enemy,
  TO->QueryProp(P_NAME)+" lacht sich krumm ueber Dich!\n"
  "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
  enemy->do_damage(random(25));
         StopHuntingMode() ;
       enemy->StopHuntingMode() ;
                          } }


reset()  {
  ::reset();
  	
 count++;
 if(count>=1)  {
  write(QueryProp(P_NAME)+" verschwindet wieder irgendwo!\n");
}} 	  	


  die(arg)  {
  	object ob;
  	ob=deep_present("KINDER_DANTE", TP);
  	if(ob)  {
  ob->KillChild();  }
  write(
  "Ein Daemon faehrt aus der Leiche, verflucht Dich und verschwindet dann!\n");
  
  call_other("d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), "mua_stirbt");
  ::die(arg); }
  