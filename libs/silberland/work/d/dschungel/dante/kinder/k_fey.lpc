// dante@SilberLand
//questnpc fuer kindertoetenquest

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

int count=0;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddId("NOWIMPY");  
  SetProp(P_SHORT, "Kleinfeyaria");
  SetProp(P_LONG, BS(
        "Das ist Kleinfeyaria. Eigentlich ein suesses Maedchen, doch "
        "der Schein truegt. Sie wackelt zwar lustig mit Ihren Elfinnenohren, "
        "doch lieber waere sie ein starker Berserker, der Dich mit seiner "
        "Axt spaltet."));


  SetProp(P_NAME, "Kleinfeyaria");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kind","kleinfeyaria", "feyaria", "k_fey", "fey", "kleinfey"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihrer imaginaeren Axt",90,DT_BLUDGEON}));
  SetProp(P_BODY, 15);
  SetProp(P_SIZE, 70);
  SetProp(P_ALIGN, -300);
  SP(P_RACE, "Elf");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE,0);

  SP(P_INFO, BS(
        QueryProp(P_NAME)+" ist von einem Daemon besessen. Hab also keine "
        "Gnade und walte Deines Amtes. Die wahre "+QueryProp(P_NAME)+""
        " kann nur wiederentstehen, wenn Du dieses Wesen toetest!"));
  AI("feyaria",
      "HIHI!!! Die werde ich mal wenn ich gross bin!", "lacht: ");
  AI("kleinfeyaria",
      "Das bin ich, Du Sack!", "sagt frech: ");  

  SetProp(P_MSGIN, "kommt ohrenwackelnd herein");
  SetProp(P_MSGOUT, "geht ohrenwackelnd");
  SetProp(P_MMSGIN, "kommt ohrenwackelnd herein");
  SetProp(P_MMSGOUT, "geht davon");


  SetProp(P_DIE_MSG,  " sagt: Dafuer loesch ich Dich!!!\n");

  AddInfo(DEFAULT_INFO, ({
        "sagt: Was soll ich loeschen?!!\n"}));


  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        QueryProp(P_NAME)+" sagt: Was soll ich damit?!\n" }) );
  SetChats(20,({
        QueryProp(P_NAME)+" tritt Dir ins Bein!\n",
        QueryProp(P_NAME)+" spuckt Dich an!\n",
        QueryProp(P_NAME)+" verhoehnt Dich!\n",
        QueryProp(P_NAME)+" lacht Dich aus!\n",
        QueryProp(P_NAME)+" zieht Dich an den Haaren!\n",
        QueryProp(P_NAME)+" sagt: Du bist ja zu bloed!\n",

        "Kleinfeyaria sagt: He! Ich loesch Dich gleich!\n",
        "Kleinfeyaria sagt: Wenn ich gross bin werde ich Berserker\n",
        "Kleinfeyaria sagt: Kennt wer die Arndtgasse?!\n",
        "Kleinfeyaria sagt: Ich will noch ein Bier!\n",
        "Kleinfeyaria taumelt umher.\n",
        "Kleinfeyaria sagt: DEATHMETAL!!!\n",
        "Kleinfeyaria bruellt Dir SAUFEN ins Ohr!\n"}));


} 


Defend(int dam, dam_type)
{
  object enemy, schl;
  if(!(enemy = QueryEnemy()))
    enemy = TP ;
  if(schl = present("rohrstock", enemy))
  {
    if(schl -> QueryWielded())  {
      return ::Defend(dam, dam_type); 
    }

    else  {
      tell_object(enemy,
          TO->QueryProp(P_NAME)+" lacht ueber Dich!\n"
          "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
      enemy->do_damage(random(25));
      StopHuntingMode() ;
      enemy->StopHuntingMode() ;  
    } 
  }


  else {
    tell_object(enemy,
        TO->QueryProp(P_NAME)+" lacht sich krumm ueber Dich!\n"
        "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
    enemy->do_damage(random(25));
    StopHuntingMode() ;
    enemy->StopHuntingMode() ;
  } 
}

reset()  {
  ::reset();
  count++;
  if(count>=1)  {
    write(QueryProp(P_NAME)+" verschwindet wieder irgendwo!\n");
  }
}




die(arg)  {
  object ob;
  ob=deep_present("KINDER_DANTE", TP);
  if(ob)  {
    ob->KillChild();  
  }
  write(
      "Ein Daemon faehrt aus der Leiche, verflucht Dich und verschwindet dann!\n");

  call_other("d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), "fey_stirbt");
  ::die(arg); 
}

