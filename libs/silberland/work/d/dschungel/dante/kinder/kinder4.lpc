//der kindergarten

#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#define QUESTKEY "Keine Gnade"

int entfernt=0;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter dem Kindergarten von Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich unter dem Kindergarten von Tijara, doch dieser "
        "Raum ist ganz anders als die Raeume, die Du bisher gesehen hast. "
        "Er muss uralt sein und ist scheinbar in Vergessenheit geraten. "
        "Dicke, schwere Spinnweben haengen von der Decke herab. Die Mauern "
        "bestehen aus uraltem, behauenen Stein, der ueber und ueber mit "
        "Schimmel ist. Wasser tropft manchmal von der Decke und sammelt sich "
        "zu kleinen Lachen am Boden. Im Boden zieht Dich ein dunkles "
        "Loch unheimlich an!"));

  AD("loch",
      "Vom Loch geht eine unheimliche, bedrohliche Aura aus!");
  AD("aura",
      "Was Dich da so veraengstigt, ist Dir noch nicht klar, aber es wird wohl "
      "etwas mit Tzakathz zu tun haben...");


  AD("himmel",
      "NIX DA!");

  AD("boden",
      "Der Boden ist teilweise voller Schlamm, teilweise ist er "
      "von Lachen bedeckt.");
  AD("schlamm",
      "Brauner, schwarzer, feuchter Schlamm.");
  AD(({"lachen","lache"}),
      "Das Wasser tropft von der Decke herab und bildet kleine "
      "Lachen am Boden. Irgendwie spiegelt sich da Etwas im Wasser...");
  AD("etwas",
      "Hmm, ja wirklich, Etwas spiegelt sich da. Aber was?!");
  AD("wasser",
      "Das Wasser ist dreckig und hat eine braune Farbe.");
  AD("farbe",
      "Du siehst Dir die Farbe des Wassers genauer an und erkennst, "
      "dass sich eine besonders dicke, schwarze Spinnwebe sogar schon "
      "bis zum Boden ausgedehnt hat. Sie hat also fast die "
      "Flaeche der ganzen Wand.");
  AD("flaeche",
      "Sie ist wirklich sehr gross. Sie scheint Dir die Sicht "
      "zu versperren.");
  AD("sicht",
      "Hmm, man sollte sie wohl entfernen, damit man besser sieht, was "
      "vielleicht dahinter ist.");
  AD("stein",
      "Der Stein ist uralt und schon recht verfallen.");
  AD(({"mauer","mauern"}),
      "Die Mauern sind feucht und teilweise von Spinnweben verdeckt. "
      "Schimmel ergreift auch Besitz von ihnen.");
  AD("besitz",
      "=;-)");
  AD(({"spinnwebe","spinnweben"}),
      "Spinnweben sind hier fast ueberall. An der Decke, auf den Waenden...");


  AD("vergessenheit",
      "Dieser Raum wurde vor sehr langer Zeit als Versteck erbaut.");
  AD("zeit",
      "Sehr lange ist das her.");
  AD("versteck",
      "Die Einwohner von Tijara haben sich hier unten vor einem Daemon "
      "verstecken wollen.");
  AD(({"daemon","daemonen"}),
      "Der Daemon hies Tzakathz und soll von den Kindern der Einwohner "
      "Besitz ergriffen haben.");
  AD(({"kinder"}),
      "Die Kinder wurden besessen und gehorchten nicht mehr. Manche wurden "
      "auch fast zu Daemonen.");
  AD("einwohner",
      "Von den heute lebenden Einwohnern weiss keiner mehr von diesem Raum und "
      "dem Daemon Tzakathz.");
  AD("tzakathz",
      "Tzakathz soll extrem boesartig wie fast alle Daemonen sein. Er wurde angeblich "
      "vertrieben, doch vielleicht solltest Du das besser nicht glauben. Vielleicht "
      "treibt er ja doch noch irgendwo sein Unwesen.");
  AD("unwesen",
      "Vielleicht ist er Dir ja naeher als Dir lieb ist. "
      "Ein Exorzist soll ihn damals besiegt haben.");
  AD("exorzist",
      "Der Exorzist soll damals, als Tzakathz in diesen Raum zu den versteckten "
      "Kindern vordrang, ihn mit einem Trick aus diesem Raum verbannt haben.");
  AD("trick",
      "Das Zeichen vieler Daemonen ist ein verkehrtes Kreuz. Der Exorzist soll "
      "damals alle Kreuze wieder umgedreht haben und sie mit magischen "
      "Riten so versiegelt haben, das der Daemon fluechten musste.");

  AD("schimmel",
      "Der Schimmel ueberwuchert langsam alle Waende.");
  AD(({"wand", "waende"}),
      "Die Waende bestehen aus altem Stein. Sie sind bedeckt mit Schimmel. "
      "Spinnweben haengen von der Decke herab und gelangen so auch zu "
      "den Waenden.");



  AD("decke",
      "Die Decke ist eher flach. Spinnweben haengen von ihr herab. Ein "
      "schmaler Schacht fuehrt oestlich nach oben.");
  AD("schacht",
      "Der Schacht fuehrt nach oben in den Kindergarten.");


  AD(({"ritus","riten"}),
      "Die Riten kennt keiner mehr.");

  AIT("/d/dschungel/dante/kinder/kinschl", REFRESH_DESTRUCT);


  ASD(({"kreuz","kreuze"}), "see_cross");
  AD(({"zeichen"}),
      "Wo immer verkehrte Kreuze sind, koennen auch Daemonen sein!");


  AD("kindergarten",
      "Der Kindergarten ist irgendwo ober Dir.");
  AD("tijara",
      "Du bist sozusagen in oder unter Tijara.");
  AD(({"raum","raeume"}),
      "Diesen Raum haben nur wenige Sterbliche betreten und angeblich noch "
      "weniger wieder verlassen.");
  AD(({"sterbliche","sterblicher"}),
      "So wie Du.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]) );


  AddSound( DEFAULT_SOUND,
      "PLOPP!!!PLITSCH!!!");
  AddSmell( DEFAULT_SMELL,
      "Es riecht modrig und verfault.");


  AE("oben", "./kinder2:"+getuid(this_player()));

  ASE("unten", "down");
  ACD(({"entferne", "entfern"}), "weg");
  ACD(({"drehe","dreh"}), "d_come");
}

down()  {

  if(IS_WIZARD(TP)) {
    return TPM("d/dschungel/dante/kinder/kinderfall:"+getuid(this_player()), M_GO,
        "in das dunkle Loch", "springt","kommt hereingeflogen");
  }


  if(!present("KINDER_SCHLAMMTOT", TP))  {
    NF(BSA(
          "Du kleiner Wurm, was wagst Du es Dir zu zutrauen in mein Reich eindringen "
          "zu wollen! Die Zeit ist dafuer noch nicht reif und schwach wie Du bist, "
          "wirst Du es auch nie schaffen zu mir zu gelangen, Du mieser, kleiner "
          "Sterblicher!", "Tzakathz teilt Dir mit: "));  
  }
  else   {

    write(BS(
          "Du nimmst allen Mut zusammen und springst in das dunkle Loch!"));
    return TPM("d/dschungel/dante/kinder/kinderfall:"+getuid(this_player()), M_GO,
        "in das dunkle Loch", "springt","kommt hereingeflogen");
  }
}




int weg(string str)  {
  NF("Was willst Du entfernen?\n");

  if(!present("KINDER_DANTE_DANTETOT", TP))  {
    write("Du kannst hier gar nichts tun!\n");  
  }

  if(str=="spinnweben"||str=="spinnwebe")   {

    write(BS(
          "Du ueberwindest Deinen Ekel und entfernst mit Deinen Haenden "
          "eine grosse, dunkle Spinnwebe. Was dahinter zum Vorschein "
          "kommt, laesst Dich erzittern. Du siehst ein uraltes Kreuz, "
          "das vor langer Zeit hier von einem Daemonen aufgehaengt wurde, "
          "dann aber von einem Exorzisten wieder umgedreht und magisch "
          "versiegelt wurde."));
    entfernt=1;
    return 1; 
  }
  return 0; 
}




string see_cross()  {

  if(!present("KINDER_DANTE_DANTETOT", TP))  {
    write("Du kannst hier gar nichts tun!\n");  
  }




  if(!entfernt)   {
    write("Du kannst hier kein Kreuz entdecken!\n");  
  }

  if(entfernt)  {
    write(BS(
          "Du siehst nun hinter den Spinnweben ein Kreuz!!! Das Kreuz haengt wieder "
          "verkehrt herum! Das ist kein gutes Zeichen, denn nur ein Daemon "
          "kann es wieder gedreht haben!!!"));  
  }
  return "";  
}


int d_come(string str)    {
  object ob;
  NF("Was willst Du hier drehen?!\n");

  if(member(({"kreuz um", "kreuz"}),str)!=-1)   {
    if(!deep_present("KINDER_DANTE_DANTETOT", TP))  {
      write("Sorry, aber Du kannst hier nichts tun! Geh nach oben!\n");
      return 1; 
    }

    if(!entfernt)   {
      write("Wo bitte siehst Du ein Kreuz!?\n");
      return 1; 
    }



    if(deep_present("daemonenkreuz", TP))  {
      write("Du hast ja schon ein Kreuz also kommt auch kein Daemon mehr!\n");
      return 1;  
    }

    else  {

      if(present("schlammdaemon", TO))   {
        write("Aber der Daemon ist doch schon da!\n");
        return 1; 
      }
      if(!present("schlammdaemon", TO))   {	
        write(BS("Du drehst das verkehrte Kreuz um! "
              "Lichtblitze zucken durch den Raum und ploetzlich steht ein Daemon "
              "vor Dir!"));
        ob=clone_object("d/dschungel/dante/kinder/dschlamm");
        ob->move(TO, M_GO+M_SILENT);
        return 1; 
      }
      return 0; 
    }
    return 0; 
  }
  return 0; 
}


