// dante@SilberLand
//questnpc fuer kindertoetenquest

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

int count=0;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddId("NOWIMPY");  
  SetProp(P_SHORT, "Kleindusty");
  SetProp(P_LONG, BS(
        "Das ist Kleindusty, immer ruhig und besonnen. Was fuer ein "
        "gemeiner Daemon muss das sein, wenn er sogar so ein nettes "
        "Maedchen quaelt!"));


  SetProp(P_NAME, "Kleindusty");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kind","kleindusty", "dusty", "k_dusty"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(4);
  SetProp(P_HANDS, ({" mit ihren zarten Haendchen",50,DT_BLUDGEON}));
  SetProp(P_BODY, 15);
  SetProp(P_SIZE, 70);
  SetProp(P_ALIGN, -300);
  SP(P_RACE, "Zwerg");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE,0);

  SP(P_INFO, BS(
        QueryProp(P_NAME)+" ist von einem Daemon besessen. Hab also keine "
        "Gnade und walte Deines Amtes. Die wahre "+QueryProp(P_NAME)+""
        " kann nur wiederentstehen, wenn Du dieses Wesen toetest!"));


  SetProp(P_MSGIN, "materialisiert sich vor Dir");
  SetProp(P_MSGOUT, "loest sich auf");
  SetProp(P_MMSGIN, "steht ploetzlich hinter Dir");
  SetProp(P_MMSGOUT, "loest sich auf");


  SetProp(P_DIE_MSG,  " sagt: FIEPPPPPPPP!!!\n");

  AddInfo(DEFAULT_INFO, ({
        "fieppt vor sich hin!\n"}));

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        QueryProp(P_NAME)+" sagt: Was soll ich damit?!\n" }) );
  SetChats(20,({
        QueryProp(P_NAME)+" tritt Dir ins Bein!\n",
        QueryProp(P_NAME)+" spuckt Dich an!\n",
        QueryProp(P_NAME)+" verhoehnt Dich!\n",
        QueryProp(P_NAME)+" lacht Dich aus!\n",
        QueryProp(P_NAME)+" zieht Dich an den Haaren!\n",
        QueryProp(P_NAME)+" sagt: Du bist ja zu bloed!\n",

        "Kleindusty fieppt laut!\n",
        "Kleindusty sagt: Wir Zwerge sind die besten!\n",
        "Kleindusty sagt: Wenn ich gross bin werde ich Musical-Star!\n",
        "Kleindusty sind irgendetwas aus dem Musical 'Sissi'!\n",
        "Du haeltst Dir die Ohren zu. Kleindusty singt zu falsch!\n",
        "Kleindusty fragt: Kennst Du Uwe Kroeger!? *KOTZ (c) by Dante99*\n",
        "Kleindusty singt: Ich bin das Phantom der OOOOOPER!!!\n"}));

} 


Defend(int dam, dam_type)
{
  object enemy, schl;
  if(!(enemy = QueryEnemy()))
    enemy = TP ;
  if(schl = present("rohrstock", enemy))
  {
    if(schl -> QueryWielded())  {
      return ::Defend(dam, dam_type); 
    }
    else  {
      tell_object(enemy,
          TO->QueryProp(P_NAME)+" lacht ueber Dich!\n"
          "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
      enemy->do_damage(random(25));
      StopHuntingMode() ;
      enemy->StopHuntingMode() ;  
    } 
  }
  else {
    tell_object(enemy,
        TO->QueryProp(P_NAME)+" lacht sich krumm ueber Dich!\n"
        "Dann tritt "+TO->QueryProp(P_NAME)+" Dir ins Schienbein!\n");
    enemy->do_damage(random(25));
    StopHuntingMode() ;
    enemy->StopHuntingMode() ;
  } 
}


reset()  {
  ::reset();
  count++;
  if(count>=1)  {
    write(QueryProp(P_NAME)+" verschwindet wieder irgendwo!\n");
  }
} 	  	


die(arg)  {
  object ob;
  ob=deep_present("KINDER_DANTE", TP);
  if(ob)  {
    ob->KillChild();  
  }
  write(
      "Ein Daemon faehrt aus der Leiche, verflucht Dich und verschwindet dann!\n");

  call_other("d/dschungel/dante/kinder/kinder2:"+getuid(this_player()), "dusty_stirbt");
  ::die(arg); 
}

