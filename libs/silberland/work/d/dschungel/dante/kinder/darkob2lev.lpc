//dante sl 99 dunkelobj

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

#include <moving.h>
#include "/players/dante/myowndefine.h"

/*
die werte muss man noch austesten
wenn ein lustiger mag das ding in nen raum legt, passiert nix
weil licht==0 is :))
*/

int lev, inte;


 
void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  seteuid( getuid(this_object()));  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10000000);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);

  AddId(({"DANTE_DARK"}));
  SP(P_NOGET, 1);
}

 
dark_time(lev, inte) 
{
  call_out("weg", inte*lev);  
}
 
weg()   
{
//  remove(); Z meint weg damit:-)

  remove();  
  if (this_object())	
    destruct(this_object());
}
 
 //nur ne sicherheitsmassnahme zordans idee
 
void reset()  
{
  ::reset();
  remove();  
}
   
