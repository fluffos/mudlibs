/* Paracelsus: Office-Editor */

#include "/players/woody/files.h"
#include <properties.h>
#include <language.h>

#define EDIT_ANTRAG     1
#define EDIT_KOMMENTAR  2
#define EDIT_OFFICE     "/d/dschungel/dante/objbuero"

#define FPL(x) find_player(x)
#define TIA this_interactive()
#define UTP getuid(this_player())
#define PO previous_object()
#define FN file_name
#define ETO environment()

#ifdef bs
#undef bs
#endif

inherit "/std/thing";

#undef TP
#include "/mail/nedit.lpc"

private int     security;
private int     modus;
private int     nummer;
private object  owner;
private string  titel;

create()
{   if (!is_clone(TO))
        return;
    ::create();
    SetProp(P_SHORT,0);
    SetProp(P_LONG,0);
    SetProp(P_NAME,"Editor");
    SetProp(P_GENDER,MALE);
    AddId( "officeeditor" );
    AddId( "PARA_O_EDIT" );
    SetProp(P_WEIGHT,0);
    SetProp(P_VALUE,0);
    SetProp(P_NODROP,1);
    SetProp(P_NEVERDROP,1);
    security=0;
    if (!PO || FN(PO)!="/d/dschungel/dante/objbuero") {
        call_out("remove",1);
        return; }
    security=1;
}

int query_prevent_shadow() { return 1; }

nomask void StartEditorA(object pl, string ti)
{
    if (!objectp(pl) || !ETO || pl!=ETO || !security) {
        call_out("remove",1);
        return; }
    if (!ti || !stringp(ti) || strlen(ti)<1) {
        call_out("remove",1);
        return; }
    tell_object(pl,">> Du bist nun bereits im ANTRAGS-EDITOR!!! <<\n");
    owner=pl;
    modus=EDIT_ANTRAG;
    titel=ti;
    nedit("EndEditorA");
}

nomask void EndEditorA(string text)
{   if (!objectp(owner) || !ETO || owner!=ETO || !security) {
        call_out("remove",1);
        return; }
    if (modus!=EDIT_ANTRAG) {
        call_out("remove",1);
        return; }
    if (!text || !stringp(text) || strlen(text)<1) {
        tell_object(owner,"Der Antrag loest sich auf.\n");
        call_out("remove",1);
        return; }
    EDIT_OFFICE->EditorOutputA(owner,titel,text);
    call_out("remove",1);
}

nomask void StartEditorK(object pl, string pretext, int num)
{
    if (!objectp(pl) || !ETO || pl!=ETO || !security) {
        call_out("remove",1);
        return; }
    tell_object(pl,">> Du bist nun bereits im KOMMENTAR-EDITOR!!! <<\n");
    owner=pl;
    modus=EDIT_KOMMENTAR;
    nummer=num;
    titel=0;
    nedit("EndEditorK",pretext);
}

nomask void EndEditorK(string text)
{   if (!objectp(owner) || !ETO || owner!=ETO || !security) {
        call_out("remove",1);
        return; }
    if (modus!=EDIT_KOMMENTAR) {
        call_out("remove",1);
        return; }
    if (!text || !stringp(text) || strlen(text)<1) {
        tell_object(owner,"Der Kommentar loest sich auf.\n");
        call_out("remove",1);
        return; }
    EDIT_OFFICE->EditorOutputK(owner,text,nummer);
    call_out("remove",1);
}
