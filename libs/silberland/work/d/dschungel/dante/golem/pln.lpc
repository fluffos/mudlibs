#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>

inherit "std/thing";
#define PATH "/d/dschungel/dante/golem/"
#define ZUKLEIN if(nummer<1) { write(BSA("Diese Nummer ist zu klein!", "Der Marmorgolem sagt: ")); return 1; }
mapping alltext;



mapping alltext = allocate_mapping(10, 1);

 int nummer;
 int max_zeichen=400;
 int max_nummer=9;

 int zeit_an=0;
  satz();
  
string col=ANSI_WHITE; //std farbe ; muss sein! sonst 0 eintrag im text


init() {
  ::init();
   if(!environment(TO)) return ;

  if (!interactive(environment(TO)))  {
  remove();  }


  if( !TP->QueryQuest("Die verlorene Seele") ||
 
  present("PLAYER_NOTIZ 2", environment(TO)))  {

 remove(); }

// if(!remove())  { destruct(); }
 }


create()
{
if (!is_clone(this_object())) return;

 ::create();





 AddId(({"golem","marmorgolem","kleiner golem",
 "kleiner marmorgolem","PLAYER_NOTIZ"}));
 SetProp(P_NAME,"Marmorgolem");
 SP(P_NAME_ADJ, "klein");
 SetProp(P_GENDER, MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein kleiner Marmorgolem" );
 SetProp(P_LONG,BS(
  "Der Magier Humfrey hat diesen Golem erschaffen und ihn dann Dir "
 "aus Dank fuer Deine Hilfe geschenkt. "
"Der kleine Marmorgolem ist eigentlich nicht lebendig, trotzdem "
"kann er sich Alles merken, was Du willst. Mehr dazu mit <ghilfe>. "
"Sei behutsam mit ihm, denn er ist wahrlich wertvoll!"));

 SetProp(P_VALUE,10000);
 SP(P_WEIGHT, 0);
 SP(P_MATERIAL, ([MAT_MISC_MAGIC: 50, MAT_MARBLE:50]));
 SP(P_NOBUY, 1);


 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);


 SP(P_MAGIC, 1);
 SP(P_NOSELL, 1);

 //cmds:
 ACD("ghilfe","help_txt");

ACD(({"gmerk","gmerke"}), "merke_fun");
ACD(({"gsprich"}), "sprich_fun");
ACD(({"gvergiss"}), "vergiss_fun");
ACD(({"gnummer","gnummern"}), "nummer_fun");
ACD(({"galle"}), "alle_fun");
ACD("gvergissalle", "vergissalle_fun");
ACD(({"gsende","gsend"}), "gsende_fun");


ACD(({"gerweiter","gerweitere"}), "erweiter_fun");
ACD(({"gsuche","gsuch"}), "suche_fun");

ACD(({"gzeitan"}), "zeitan_fun");
ACD(({"gzeitaus"}), "zeitaus_fun");
ACD("gfarbe", "fun_farbe");

  seteuid(getuid());

}

int fun_farbe(string str)  {

NF(BS(
""+col+"Der Marmorgolem sagt: Deine momentane Farbe!"+ANSI_NORMAL+""));


if (str=="blau") { 
  col=ANSI_BLUE;
        satz(str);
        return 1;  }
          
   if(str=="gelb")  {
   col=ANSI_YELLOW;
      satz(str);
      return 1;
                 }

          
   if(str=="weiss")  {
   col=ANSI_WHITE;
      satz(str);
      return 1;
                 }
                 
               
   if(str=="violett")  {
   col=ANSI_PURPLE;
      satz(str);
      return 1;
                 }
                 
                           
   if(str=="schwarz")  {
   col=ANSI_BLACK;
      satz(str);
      return 1;
                 }            
          
   if(str=="tuerkis")  {
   col=ANSI_CYAN;
      satz(str);
      return 1;
                 }
             
   if(str=="gruen")  {
   col=ANSI_GREEN;
      satz(str);
      return 1;
                 }
                         
  
        return 0; }
        
  
satz(str)  {
 write("OK Farbe ist "+col+""+str+"!"+ANSI_NORMAL+"\n");  
  }
   




mixed _query_autoloadobj()  {

 return ({alltext, zeit_an, col});

   }
 

void _set_autoloadobj(mixed arg)  {
     
        alltext=arg[0];
        zeit_an=arg[1];
        col=arg[2];
       }
     

//funcs beginn


 zeitan_fun()  {
  
  if(zeit_an!=0)  {
    write( BSA(
    "Die Zeit wird schon mitgemerkt!",
    "Der Marmorgolem sagt: "));
    return 1;      }
    
  if(zeit_an==0)  {
    zeit_an=1;     
     write( BSA(
    "Die Zeit wird nun mitgemerkt!",
    "Der Marmorgolem sagt: "));
    return 1;
    }
     return 0;
            }
           



 zeitaus_fun()  {
  
  if(zeit_an==0)  {
    write( BSA(
    "Die Zeit wird sowieso schon nicht mitgemerkt!",
    "Der Marmorgolem sagt: "));
    return 1;      }
    
  if(zeit_an!=0)  {
   zeit_an=0;     
     write( BSA(
    "Die Zeit wird nun nicht mehr mitgemerkt!",
    "Der Marmorgolem sagt: "));
    return 1;      }
     
     return 0;
           }
           



int suche_fun(string str)  {
  int i;
  string *alletexte;
  string *allenummern;
  
  NF(BSA(
  "Leider habe ich `"+str+"` nicht gefunden!",
  "Der Marmorgolem sagt: "));
  
if(!str)  {
write(BSA(
"<gsuch(e) wort>!",
"Der Marmorgolem sagt: "));
return 1; }

if(sscanf(str,"%d", str))  {
write(BSA(
"Ich kann nur nach Worten suchen!",
"Der Marmorgolem sagt: "));
return 1; }

if(strlen(str)>20)  {
  write(BSA(
  "Leider ist dieser Begriff zu lange!",
  "Der Marmorgolem sagt: "));
return 1; }

  
  alletexte=m_values(alltext);
  allenummern=m_indices(alltext);
  
if(!sizeof(allenummern)) {
  write(BSA(
  "Ich habe mir noch gar nichts gemerkt!",
  "Der Marmorgolem sagt: "));
  return 1; }
  
  
  /*
  if(( member_array(str, alletexte))==1)  {
  write("JA!\n");
  return 1; }
 */ 
  
  
  


 for(i=0;i<sizeof(alletexte); i++)  {


        for(i=0;i<sizeof(allenummern); i++)  {
  
//if((member(alletexte[i], str))!=-1)  {
//if(( member_array(str, alletexte[i]))!=-1)  {
// alles dreck!!! if(regexplode (alletexte[i], ""+str+""))  {


if(strstr(alletexte[i], ""+str+""))  {


write(BS(""+str+" in "+allenummern[i]+" gefunden!"));
  write(BS(""+alletexte[i]+""));
  
  
      }
  
    }
  
  return 1;
  }
  
  

return 0; }








//suche aus erweiter beginn


int erweiter_fun(string str)  {
  int i;
  string *alletexte;
  string *allenummern;
  string was;

 NF(BS(
 "Der Marmorgolem sagt: <gerweiter(e) nummer text>!"));       

if(sscanf(str, "%d %s", nummer, was)<2)   {
      return 0;  }

 ZUKLEIN

 if(nummer>max_nummer)  {
  write(BSA(
 "Diese Nummer ist zu gross!",
 "Der Marmorgolem sagt: "));
      return 1; }


allenummern=m_indices(alltext);
alletexte=m_values(alltext); 

 if(!sizeof(allenummern))  {
    write(BSA(
    "Du hast ueberhaupt nichts gespeichert!",
    "Der Marmorgolem sagt: "));
   return 1; }
   
 was=TP->_unparsed_args();


 for(i=0;i<sizeof(alletexte); i++)  {


        for(i=0;i<sizeof(allenummern); i++)  {
  
    if(nummer==to_int(allenummern[i]))  {
   
   
   if(( strlen(was) + strlen(alletexte[i]) ) > max_zeichen)  {
   
   write(BSA(
   "Leider ist die gesamte Anzahl an Zeichen zu lange!",
   "Der Marmorgolem sagt: "));
   return 1; }
   
   
     
   
   
 write(BSA(
 "Unter der Nummer "+nummer+" zusaetzlich gemerkt: ",
 "Der Marmorgolem sagt: "));

 write(""+col+""+was[1..]+""+ANSI_NORMAL+"\n\n");

 write(BSA(
 "Unter der Nummer "+nummer+" merke ich mir nun: ",
  "Der Marmorgolem sagt: "));
            
  write("\n"+alletexte[i]+""+col+""+was[1..]+""+ANSI_NORMAL+"\n");
 
 alltext+=
  ([ allenummern[i]: alletexte[i]+""+col+""+was[1..]+""+ANSI_NORMAL+""]);
 
 
 return 1;
 
           }
          }
     }
     
    
     
   write(BSA(
   "Unter dieser Nummer habe ich mir nichts gemerkt!",
   "Der Marmorgolem sagt: "));

   return 1; }
        
             

//sende fun beginn erweiter aus

int gsende_fun(string str)    {
 object pla, tafel;
 int i;
 string *allenummern;
 string *alletexte;
 string wen;
 NF("Der Marmorgolem sagt: <gsend(e) nummer name>!\n");

 if(!str) return 0;


if(sscanf(str, "%d %s", nummer, wen)<2)   {
      return 0;  }

 ZUKLEIN

 if(nummer>max_nummer)  {
  write(BSA(
 "Diese Nummer ist zu gross!",
 "Der Marmorgolem sagt: "));
      return 1; }
    
    pla=find_player(wen);


 
  if( (!pla)||(pla->QP(P_INVIS) ))  {

  write(BSA(
  "Diesen Spieler kann ich nicht finden! Sorry!",
  "Der Marmorgolem sagt: "));
  return 1; }
   
      if(!interactive(pla))  {
  write(BSA(
  "Ich versende Marmortafeln nur an Spieler, Seher oder "
  "wenn es unbedingt sein muss auch an Magier!",
  "Der Marmorgolem sagt: "));
  return 1; }


  if(getuid(pla)==getuid(TP))  {
  write(BSA(
  "Dir selbst eine Tafel schicken! Nein, das will ich nicht!",
  "Der Marmorgolem sagt grinsend: "));
  return 1; }


   
     
allenummern=m_indices(alltext);
alletexte=m_values(alltext);

if(!sizeof(allenummern))  {
write(BSA(
"Ich habe mir doch gar nichts gemerkt. Also kann ich auch "
"Niemandem eine Marmortafel senden!",
"Der Marmorgolem sagt: "));
return 1; }

 for(i=0;i<sizeof(alletexte); i++)  {


        for(i=0;i<sizeof(allenummern); i++)  {
  
    if(nummer==to_int(allenummern[i]))  {

    tafel=CLONEOB(PATH"tafel");
    tafel->SP(P_SHORT,
     "Eine kleine Marmortafel von "+CAP(getuid(TP))+" fuer "+CAP(getuid(pla))+"");
    tafel->SP(P_LONG, BS(
    "Der Marmorgolem von "+CAP(getuid(TP))+" hat einen Text "
    "in diese kleine Marmortafel fuer Dich gemeisselt. Mit "
    "<lies text> kannst Du ihn lesen."));
    tafel->ARD("text",
    ""+alletexte[i]+"\n");
     tafel->move(pla, M_NOCHECK);
     tell_object(pla,BS(
     ""+CAP(getuid(TP))+" sendet Dir eine kleine Marmortafel!\a\a\a"));
   
    write(BSA(
    "Ich habe "+CAP(getuid(pla))+" die Marmortafel zugesandt!",
    "Der Marmorgolem sagt: "));
         }
        }
      }
   return 1; }
         
   
    
//ende sende:fun beginn vergissalle fun


int vergissalle_fun()  {
int i;

string *allenummern;

allenummern=m_indices(alltext);

if(!sizeof(allenummern))  {



 write(BSA(
 "Ich habe mir ja ueberhaupt nichts gemerkt, wie also "
 "soll ich was vergessen!",
 "Der Marmorgolem sagt: "));
 return 1; }

 else

 alltext=([]);
 write(BSA(
 "Ich habe nun alles vergessen! Unwiderruflich! ",
 "Der Marmorgolem sagt: "));
 return 1; }





int alle_fun()  {
string *allenummern;
string *alletexte;

int i;


alletexte=m_values(alltext);
allenummern=m_indices(alltext);

if(!sizeof(alletexte))  {

write(BSA(
"OH! Ich habe mir unter keiner Nummer etwas gemerkt!",
"Der Marmorgolem sagt: "));
return 1; }

write(BSA(
"Ich habe mir bisher folgendes gemerkt:",
"Der Marmorgolem sagt: "));

write("\n");
for (i=0; i<sizeof(alletexte);  i++)
 {
  for(i=0; i<sizeof(allenummern); i++)  {
  
    write(""+alletexte[i]+"\n\n");  }  }
  
    return 1; }
  

//alle fun aus nummern fun beginn




int nummer_fun()   {
string *allenummern;
int i;


allenummern=m_indices(alltext);


if(!sizeof(allenummern))  {
write(BSA(
"OH! Ich habe mir unter keiner Nummer etwas gemerkt!",
"Der Marmorgolem sagt: "));
return 1; }

write(BSA(
"Unter folgenden Nummern habe ich mir bereits etwas gemerkt!",
"Der Marmorgolem sagt: "));

for(i=0; i<sizeof(allenummern);  i++)  {
 
write((""+allenummern[i]+" "));
  }

write("\n");

return 1; }

//galle fun aus vergiss beginn


int vergiss_fun(string str)  {
 
   NF("Der Golem sagt: <vergiss nummer>!\n");

 if(!str)  return 0;


 if(nummer>max_nummer)   {
 write(BSA(
 "Diese Nummer habe ich mir sicher nicht gemerkt! Sie ist "
 "zu hoch!",
 "Der Golem sagt: "));
 return 1; }

 ZUKLEIN

if(sscanf(str, "%d", nummer)<1)   {
   write(BSA(
   "Das ist leider keine Nummer!",
   "Der Marmorgolem sagt: "));
   return 1;
     }
   
 if(!member(alltext, nummer))   {  
    
  
write(BSA(
"Unter der Nummer "+nummer+" habe ich mir nichts gemerkt! "
"Ich kann daher auch nichts vergessen!",
"Der Golem sagt grinsend: "));
return 1; }
   


 else

 alltext -= ([nummer]);
 write(BSA(
 "Gut! Ich vergesse alles was ich unter Nummer "+nummer+" "
 "gemerkt habe!",
 "Der Marmorgolem sagt: "));
 return 1;
  }




   
   // vergiss fun aus sprich beginn
   


int sprich_fun(string str)  {
int i;
string *alletexte;
string *allenummern;

NF("Der Golem sagt: <gsprich nummer>!\n");

if(!str) return 0;

 
if(sscanf(str, "%d", nummer)<1)   {
   write(BSA(
   "Das ist leider keine Nummer!",
   "Der Marmorgolem sagt: "));
   return 1;
     }
 
if(nummer>max_nummer)   {

write(BSA(
"Diese Nummer ist zu gross!",
"Der Golem sagt: "));
return 1; }

ZUKLEIN
 if(!member(alltext, nummer))  {



write(BSA(
"Unter der Nummer "+nummer+" habe ich mir nichts gemerkt!",
"Der Golem sagt: "));
return 1; }

 
 
   else
 
 
   write(BSA(
   "Darunter habe ich mir folgendes gemerkt: ",
   "Der Marmorgolem sagt: "));
write("\n");

alletexte=m_values(alltext);
allenummern=m_indices(alltext);




for (i=0; i<sizeof(alletexte); i++ ) {
 
 
   for (i=0; i<sizeof(allenummern); i++ ) {
     


if(nummer==to_int(allenummern[i]))  {


write(""+alletexte[i]+"\n");  } }  }





   return 1; }
 
 
   //merke fun beginn sprich aus
 
 
 
int merke_fun(string str)  {
   string was;

 
   NF("Der Golem sagt: <gmerk(e) nummer text!>\n");

   if(!str) return 0;


  
   if ((sscanf(str,"%d %s",nummer,was)<2))  {
  return 0; }
   was=TP->_unparsed_args();

  if(nummer>max_nummer)   {
  write(BSA(
  "Sorry, aber ich kann mir nur Nummern von 1 bis "+max_nummer+" merken!",
  "Der Golem sagt: "));
   return 1; }
 
 
   ZUKLEIN
 
  if(strlen(was)>max_zeichen)  {
  write(BSA(
  "Sorry, aber ich kann mir so nur "+max_zeichen+" Zeichen aufeinmal merken!",
  "Der Golem sagt: "));
  return 1; }




  if(member(alltext, nummer))  {

  write(BSA(
  "Sorry, aber unter der Nummer "+nummer+" habe ich mir bereits etwas gemerkt."
  " Loesch diesen Text oder nimm eine andere Nummer!",
  "Der Golem sagt: "));



  return 1; }



  else


 if(zeit_an==0)  {
 
  alltext +=([nummer: ""+nummer+""+col+""+was[1..]+""+ANSI_NORMAL+""]);

      }

if(zeit_an!=0)  {
 
 alltext +=
 ([nummer: ""+nummer+" "+ANSI_RED+""+ctime()+""+col+""+was[1..]+""+ANSI_NORMAL+""]);
           
   }
   

  write(BSA(
"Darunter merke ich mir nun folgendes: ",
"Der Marmorgolem sagt: "));
write("\n");
write(""+nummer+""+col+""+was[1..]+""+ANSI_NORMAL+"\n");
  
 
 return 1; }



  





int help_txt(string str)  {

   NF("Der Marmorgolem sagt: Tippe <ghilfe>!\n");
 
   if(!str)  {
 
 TP->More(read_file(PATH"stdhilfe.txt"));
 write("\n");
 return 1; }
 
 
if(str=="gzeitan"||str=="gzeitaus")  {
  TP->More(read_file(PATH"zeit.txt"));
 write("\n");
  return 1; }
  
  
if(str=="gfarbe")  {
  TP->More(read_file(PATH"farbe.txt"));
 write("\n");
  return 1; }

 if (str=="gmerke"||str=="gmerk")   {
 TP->More(read_file(PATH"merke.txt"));
 write("\n");
   return 1; }
   

 if(str=="gvergiss")  {
  TP->More(read_file(PATH"vergiss.txt"));
 write("\n");
   return 1; }
 
 if(str=="gsprich")   {
  TP->More(read_file(PATH"sprich.txt"));
 write("\n");
   return 1; }
  
 
   if(str=="gnummer"||str=="gnummern")  {
  TP->More(read_file(PATH"nummer.txt"));
 write("\n");
   return 1; }
 
if(str=="galle")  {
 TP->More(read_file(PATH"alle.txt"));
 write("\n");
   return 1; }
  

if(str=="gsend"||str=="gsende")  {
 TP->More(read_file(PATH"sende.txt"));
 write("\n");
   return 1; }
   
 if(str=="gvergissalle")  {
 
  TP->More(read_file(PATH"vergissalle.txt"));
 write("\n");
   return 1; }
   
 
if(str=="gerweiter"||str=="gerweitere")  {
 TP->More(read_file(PATH"erweitere.txt"));
 write("\n");
   return 1; }
   

if(str=="gsuche"||str=="gsuch")  {

 TP->More(read_file(PATH"suche.txt"));
 write("\n");
   return 1; }
   
 return 0; }

 
