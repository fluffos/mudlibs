/* die tafel die der marmorgolem versenden kann
dante sl 200o (c)

*/


#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"tafel","marmortafel", "PLAYER_NOTIZ_TAFEL"}));
 SetProp(P_NAME,"Marmortafel" );
 SP(P_NAME_ADJ, "klein");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 0);
 SP(P_MATERIAL, ([MAT_MARBLE: 100]));
 SP(P_NOBUY, 1);
 AD("text", "Lies ihn!");

}
