inherit "std/thing";
#include <language.h>
#include <defines.h>
#include <properties.h>
#include <wizlevels.h>
#include <moving.h>
#include <rooms.h>
#include <combat.h>

#define BS     break_string
#define AD     AddDetail
#define ASD    AddSpecialDetail
#define ARD    AddReadDetail

#define MSG ({ "*quietsch*\n", \
               "*knarz*\n", \
               "*knirsch*\n", \
               "*schnarch*\n" })
               
object shadow_ob;

void create(){
  ::create();
  SetProp(P_NAME,"Rollstuhl");
  SetProp(P_SHORT,"Ein Rollstuhl");
  SetProp(P_LONG,
   BS("Ein superbequemer Rollstuhl. In ihm ist das Rentner-Dasein "
    "sicher nur noch halb so schwer. Dicke Ballonreifen "
    "lassen ihn ohne spuerbare Erschuetterungen ueber den Boden gleiten und "
    "trotzdem sind noch 1-A-Stossdaempfer angebracht, falls man doch mal "
    "in ein kleines Scharmuetzel geraten sollte. Damit einem das Sitzen "
    "auf die Dauer nicht so schwer faellt, ist das Kissen prallvoll mit den "
    "feinsten und weichsten Daunen. Eine Erlaeuterung der Kommandos gibts "
    "mit <rhilfe>.",78));
  AD(({"dasein","rentnerdasein","rentner-dasein"}),BS("In diesem Rollstuhl "
   "ist es sicher doppelt bequem und angenehm.",78));
  AD(({"reifen","ballonreifen"}),BS("Die dicken Ballonreifen sind prall "
   "aufgepumpt und lassen Dich ohne spuerbare Erschuetterungen selbst in "
   "unwegsamen Gelaende vorwaerts kommen.",78));
  AD(({"gelaende"}),BS("Auf gehts!",78));
  AD(({"erschuetterung","erschuetterungen"}),BS("Dank der Ballonreifen wirst "
   "Du sie nichtmal bemerken.",78));
  AD(({"boden"}),BS("Er ist sicher noch da, sonst koenntest Du wohl kaum mit "
   "Deinem Rollstuhl darueber fahren.",78));
  AD(({"daempfer","stossdaempfer","1-a-stossdaempfer"}),BS("Die Stossdaempfer "
   "sind eine Meisterleistung der Handwerkskunst. Sie wurden eigens fuer den "
   "Rollstuhl entwickelt und angefertigt.",78));
  AD(({"kunst","handwerkskunst","handwerk"}),BS("Wer auch immer diesen "
   "Rollstuhl entwickelt und gefertigt hat verstand viel davon.",78));
  AD(({"leistung","meisterleistung"}),BS("Nicht nur die Stossdaempfer, "
   "sondern der komplette Rollstuhl ist eine solche. Du bist stolz einen "
   "besitzen zu duerfen.",78));
  AD(({"scharmuetzel"}),BS("Du kannst gefahrlos in eines geraten.",78));
  ASD("sitzen","sitzen");
  AD(({"dauer"}),BS("Dank des Kissens ist es vollkommen egal, wie lange Du "
   "in dem Rollstuhl sitzt.",78));
  AD(({"daune","daunen","feder","federn","daunenfedern"}),BS("Die Daunen in "
   "dem Kissen sind superweich, sicher mussten viele Gaense dafuer Federn "
   "lassen.",78));
  AD(({"gans","gaense"}),BS("Die waren sicherlich nicht gerade begeistert "
   "darueber.",78));
  AD(({"kissen"}),BS("Das Kissen ist gefuellt mit weichen Daunenfedern, es "
   "ist wirklich aeusserst bequem. In das Kissen wurde etwas eingestickt.",78));
  AD(({"stickerei"}),BS("Du kannst sie sicher lesen.",78));
  ARD(({"stickerei"}),BS("This Rollstuhl was manufactured in 98/04/20 by "
   "tilly@mg.mud.de. Modification and copying only allowed with permission "
   "of the original author. No warranty.",78));
  AD(({"erlaeuterung","erlaeuterungen"}),BS("Fuer eine Uebersicht und "
   "Erlaeuterung der Kommandos gibt es den Befehl <rhilfe>.",78));
  AD(({"kommando","kommandos"}),BS("Auch hier sei nochmal auf den Befehl "
   "<rhilfe> hingewiesen.",78));
  AD(({"befehl","befehle"}),BS("Es gibt mehrere Befehle, der wichtigste "
   "lautet <rhilfe> und gibt eine Uebersicht ueber alle anderen aus.",78));
  AD(({"uebersicht"}),BS("Die gibt es mit <rhilfe>.",78));
  SetProp(P_VALUE,15000);
  SetProp(P_ARTICLE,1);
  SetProp(P_WEIGHT,900);
  SetProp(P_NOBUY,1);
  SetProp(P_NODROP,"Du willst doch den tollen Rollstuhl nicht wegwerfen!\n");
  SetProp(P_NEVERDROP,1);
  SetProp(P_SHOW_INV,1);
  SetProp(P_MATERIAL,MAT_MISC_SOLID);
  SetProp(P_GENDER,MALE);
  SetProp(P_INFO,
   BS("Man munkelt, dass dieser Rollstuhl fuer einen bestimmten "
    "Seher gebastelt wurde, weil dessen Elend nicht mehr mit anzugucken "
    "war. Du haeltst das fuer ein Geruecht.",78));
  AddId("stuhl");
  AddId("rolli");
  AddId("rollstuhl");
  AddId("\nfuer_therin");
  AddId("\(c)'98:tilly@mg.mud.de");
  AddCmd(({"rsitze","rsitz","rsetz","rsetze"}),"hinsetzen");
  AddCmd(({"rsteh","rstehe"}),"aufstehen");
  AddCmd("rhilfe","hilfe");  
  AddCmd(({"rrolle","rroll"}),"rollen");
  AddCmd(({"rfahre","rfahr"}),"fahren");
  AddCmd(({"rhau","rhaue"}),"fallen"); 
  AddCmd(({"rtatter","rtattere","rtattre"}),"tattern"); 
  AddCmd(({"rrase","rras"}),"rasen"); 
  AddCmd(({"rschaukel","rschaukele","rschaukle"}),"schaukeln");
  AddCmd(({"resse","ress","riss"}),"essen");
}

int QueryRollstuhl(object pl){
 if(!shadow_ob){
    write("Dazu solltest Du schon im Rollstuhl sitzen.\n");
   return 1;
  }
 return 0;
}

nosave string sitzen(){
  if(QueryRollstuhl(this_player()))
    return "Du sitzt doch in dem Rollstuhl.\n";
  else
    return "Vielleicht solltest Du Dich wirklich in den Rollstuhl setzen.\n";  
}

aufstehen(str,pl){
  if(!pl) pl=this_player();
  notify_fail("Woraus moechtest Du denn aufstehen?\n");
  if(sizeof(regexp(({str}),".*\\<(stuhl|rollstuhl)\\>.*"))){
     if(QueryRollstuhl(this_player())) return 1;
     shadow_ob->_tarn_turn_off(); 
     tell_object(pl,BS("Du stehst unter grossen Anstrengungen aus Deinem "
      "Rollstuhl auf.",78));
     tell_room(environment(pl),sprintf("%s steht unter dem Knacken "
       +pl->QueryPossPronoun(MALE,WESSEN,PLURAL)+" Gelenke aus "
       +"einem Rollstuhl auf.\n",pl->name()),({pl}));
     SetProp(P_SHORT,"Ein Rollstuhl");
     if(find_call_out("quietschen")>-1)
       remove_call_out("quietschen");  
     return 1;
   }
}   

nosave int hinsetzen(string str){
  notify_fail("Wo moechtest Du Dich denn hinein setzen?\n");
  if(sizeof(regexp(({str}),".*\\<(stuhl|rollstuhl)\\>.*"))){
      if(shadow_ob){
         write("Du sitzt doch schon in Deinem Rollstuhl!\n");
        return 1;
       }  


     /*
     Der Pfad fuer den Shadow muss ggf. an das Mud angepasst werden
     */
     if(!shadow_ob=clone_object("/std/player/shadows/rollstuhl_shadow")){
        write("Fehler: Bitte Dante verstaendigen!\n");
       return 1;
      }  
      shadow_ob->_tarn_turn_on(this_player(),1);
      write("Du sitzt endlich wieder in Deinem Rollstuhl.\n");
      say(this_player()->name(WER)+" setzt sich in "
       +this_player()->QueryPossPronoun(MALE,WEN,SINGULAR)+" Rollstuhl "
       +"und seufzt gluecklich auf.\n");
      this_object()->SetProp(P_SHORT,"Ein Rollstuhl (besetzt)");
     return 1;                          
   }
 return 0;  
}

nosave int quietschen(int i){
 object en;
 en = environment();
 tell_object(en,"Du schaukelst gemuetlich in Deinem Rollstuhl.\n");
 tell_object(en,MSG[random(sizeof(MSG))]);
 tell_room(environment(en),BS(this_player()->name()+" schaukelt "
  "in "+this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+" Rollstuhl.",78),
  ({this_player()}));
 tell_room(environment(en),MSG[random(sizeof(MSG))],({this_player()}));
 if(i)
   call_out("quietschen",5+random(5),i-1);
 return 1;
}
    
nosave int hilfe(){

 /*
 Der Pfad sollte natuerlich an das Mud angepasst werden sofern ich dort
 kein Magier bin 
 */
 this_player()->More(read_file("/d/dschungel/dante/rstuhl/rhilfe.txt"));
 return 1;
} 

void BecomesNetDead(){
 if(shadow_ob) shadow_ob->_tarn_turn_off();
 this_object()->SetProp(P_SHORT,"Ein Rollstuhl");
 if(find_call_out("quietschen")>-1)
   remove_call_out("quietschen");  
}

void NotifyPlayerDeath(){
 if(shadow_ob) shadow_ob->_tarn_turn_off();
 this_object()->SetProp(P_SHORT,"Ein Rollstuhl");
 if(find_call_out("quietschen")>-1)
   remove_call_out("quietschen");  
}
 
void BecomesNetAlive(){
 if(shadow_ob) shadow_ob->_tarn_turn_off();
 this_object()->SetProp(P_SHORT,"Ein Rollstuhl");
}

int QueryOpfer(object pl,string opfer){
 object wem;
 if(!wem=present(opfer,environment(this_player()))){
    write(capitalize(opfer)+" ist doch gar nicht da.\n");
   return 1;
  }  
 wem=find_player(opfer);
 if(wem==this_player()){
    write("Das sollst Du doch nicht bei Dir machen!\n");
   return 1;
  }  
 if(!wem){
    write("Das geht bei "+capitalize(opfer)+" nicht.\n");
   return 1;
  }  
 return 0;
}
 
nosave int rollen(string opfer){
 object wem;
 wem=find_player(opfer);
  notify_fail("Wem willst Du denn ueber die Fuesse rollen?\n");
  if(!opfer) return 0;
  if(QueryRollstuhl(this_player())) return 1;
  if(QueryOpfer(this_player(),opfer)) return 1;
  write(BS("Genuesslich rollst Du mit Deinem Rollstuhl ueber die Fuesse "
   +"von "+capitalize(opfer)+" und freust Dich ueber den schmerzverzerrten "
   +"Blick.",78));
  tell_object(wem,BS(this_player()->name()+" faehrt Dir mit "
   +this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+" Rollstuhl "
   +"ueber die Fuesse. Voller Schmerz hoppelst Du durch die Gegend.",78));
  tell_room(environment(this_player()),BS(this_player()->name()+" rollt "
   "genuesslich ueber die Fuesse von "+capitalize(opfer)+" und lacht "
   "dabei so laut, dass fast die dritten Zaehne aus "
   +this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+" Mund fallen.",78),
   ({opfer,wem,this_player()}));
 return 1;
}
      
nosave int fahren(string opfer){
 object wem;
 wem=find_player(opfer);
  notify_fail("Wem willst Du denn gegens Knie fahren?\n");
  if(!opfer) return 0;
  if(QueryRollstuhl(this_player())) return 1;
  if(QueryOpfer(this_player(),opfer)) return 1;
  write(BS("Voller Wucht faehrst Du mit deinem Rollstuhl gegen ein Knie von "
   +capitalize(opfer)+" und ergoetzt Dich an dem darauffolgenden "
   "Gejammere.",78));
  tell_object(wem,BS(this_player()->name()+" knallt voller Wucht mit "
   +this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+" Rollstuhl gegen "
   "Dein linkes Knie. Laut jammernd reibst Du es.",78));
  tell_room(environment(this_player()),BS(this_player()->name()+" faehrt "
   "voller Wucht mit "+this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+
   " Rollstuhl gegen "+capitalize(opfer)+"s Knie und kichert dabei "
   "fies.",78),({opfer,wem,this_player()}));
 return 1;
}

nosave int fallen(string opfer){
 object wem;
 wem=find_player(opfer);
  notify_fail("Wen willst Du denn von Deinem Rollstuhl heraus hauen?\n");
  if(!opfer) return 0;
  if(QueryRollstuhl(this_player())) return 1;
  if(QueryOpfer(this_player(),opfer)) return 1;
  write(BS("Mit aller Kraft richtest Du Dich auf um "+capitalize(opfer)+
   " ordentlich zu hauen. Dummerweise verhedderst Du Dich und faellst dabei "
   "fast aus dem Rollstuhl! "+capitalize(opfer)+" kichert haehmisch.",78));
  tell_object(wem,BS(this_player()->name()+" baeumt sich mit voller Kraft in "
   +this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+" Rollstuhl auf um "
   "Dich zu hauen. Gluecklicherweise verheddert "
   +this_player()->QueryPronoun(WER)+" sich und faellt voll auf die Schnauze. "
   "Du kannst Dir ein haehmisches Kichern nicht verkneifen.",78));
  tell_room(environment(this_player()),BS(this_player()->name()+" baeumt sich "
   "mit letzter Kraft in "+this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+
   " Rollstuhl auf, und versucht "+capitalize(opfer)+" zu hauen. Bloederweise "
   "verheddert "+this_player()->QueryPronoun(WER)+" sich dabei und knallt "
   "voll auf die Schnauze. "+capitalize(opfer)+" kichert ob solcher "
   "Dummheit.",78),({opfer,wem,this_player()}));
 return 1;
}

nosave int schaukeln(string str){
 notify_fail("Was willst Du in Deinem Rollstuhl machen?\n");
 if(QueryRollstuhl(this_player())) return 1;
 write(BS("Zufrieden lehnst Du Dich in Deinem Rollstuhl zurueck und "
  "beginnst gemaechlich zu schaukeln. Hin und her und hin und her, so "
  "langsam wirst Du richtig doesig und moechtest am liebsten ein kleines "
  "Nickerchen machen.",78));
 tell_room(environment(this_player()),BS(this_player()->name()+" beginnt "
  "langsam in "+this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+
  " Rollstuhl zu schaukeln.",78),({this_player()}));
 if(find_call_out("quietschen")==-1)
   call_out("quietschen",2,5+random(5));
 return 1;
}
     
nosave int tattern(string str){
  notify_fail("Was willst Du in Deinem Rollstuhl machen?\n");
  if(QueryRollstuhl(this_player())) return 1;
  write(BS("Du tatterst wild in Deinem Rollstuhl und schaffst es sogar, dass "
   "ein bisschen Sabber aus Deinem Mundwinkel laeuft. Mit Traenen in den "
   "Augen erheischt Du die mitleidigen Blicke der Umstehenden.",78));
  tell_room(environment(this_player()),BS(this_player()->name()+" tattert "
   "in "+this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+" Rollstuhl rum. "
   "Sogar etwas Sabber laeuft "+this_player()->name(WEM)+" aus dem Mund. "
   "Voller Ruehrung kramst Du in Deinen Taschen nach ein paar Muenzen fuer "
   "die bemitleidenswerte Kreatur.",78),({this_player()}));
 return 1;
}

nosave int rasen(string str){
  notify_fail("Was moechtest Du mit Deinem Rollstuhl denn machen?\n");
  if(QueryRollstuhl(this_player())) return 1;
  write(BS("Wild und ungezuegelt rast Du mit Deinem Rollstuhl umher. "
   "Schneller und immer schneller werden die Kreise die Du ziehst. Voellig "
   "ausser Atem haeltst Du einen Moment inne und schaust Dich "
   "beifallheischend um.",78));
  tell_room(environment(this_player()),BS(this_player()->name()+" rast wild "
   "und ungezuegelt mit "+this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+
   " Rollstuhl um Dich herum. Voller Angst springst Du beiseite und fluchst "
   "auf dieses ruecksichtslose und eigentlich unnuetze Rentnerpack.",78),
   ({this_player()}));
 return 1;
}      

nosave int essen(string str){
  notify_fail("Was willst Du denn jetzt machen?\n");
  if(QueryRollstuhl(this_player())) return 1;
  write(BS("Ungeniert packst Du ein Butterbrot und ein Flaeschchen "
   "Nieren-Blasen-Tee aus und beginnst zu essen und trinken. Da Du aber nicht "
   "mehr die ganze Kontrolle ueber Deinen Bewegungsapparat hast, kleckerst "
   "und schmierst Du Dich von oben bis unten voll. Peinlich beruehrt blickst "
   "Du in die Runde. Anscheinend hat niemand etwas gesehen. Beruhigt atmest "
   "Du auf.",78));
  tell_room(environment(this_player()),BS(this_player()->name()+" packt "
   "ungeniert Butterbrot und Nieren-Blasen-Tee aus und beginnt zu speisen. "
   "Da "+this_player()->QueryPronoun(WER)+" aber nicht mehr im Vollbesitz "
   +this_player()->QueryPossPronoun(FEMALE,WEM,PLURAL)+" koerperlichen "
   "Grundfunktionen ist, bekleckert "+this_player()->QueryPronoun(WER)+" sich "
   "von oben bis unten. Du brichst vor Lachen zusammen und kannst Dich grad "
   "noch so beherrschen als sich "+this_player()->name()+" beschaemt "
   "umschaut. Na wenigstens ist es "+this_player()->QueryPronoun(WEM)+
   " peinlich.",78),({this_player()}));
 return 1;
}      
