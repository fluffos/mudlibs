//net das wieder sowas wie bei padreics maexchen passiert gell:-)))

#include <defines.h>
#include <properties.h>

#define WEG destruct(this_object())

object player;

_tarn_turn_on(pl){
  if(!objectp(pl)||!interactive(pl)) return WEG;
  player=pl;
  shadow(pl,1);
}    

_query_extralook(){
 return player->name()+" ist Rentner"
  +(player->QueryProp(P_GENDER)==2?"in":"")+" und sitzt im Rollstuhl.\n";
}

_query_msgin(){ 
 return "eiert auf einem Rollstuhl muehsam herein";
}
_query_msgout(){
 return "eiert auf einem Rollstuhl";
}
_query_mmsgin(){ 
 return "flitzt in einem Rollstuhl herein und bleibt mit brennenden Reifen "
  +"stehen";
}
_query_mmsgout(){  
 return "macht einen Burn-Out mit einem Rollstuhl und ist weg";
}

_tarn_turn_off(){
  WEG;
}
