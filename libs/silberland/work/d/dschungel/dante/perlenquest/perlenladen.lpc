/*


perlenladen von tijara
man kann perlen kaufen &verkaufen, kaufen is halt sehr teuer
und natuerlich das spiel spielen
funcs sind im npc
dante


*/

#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>




int schuppe=50;
int code;
int i, ii, zufall, geraten;

string fix;
string *liste=({
"a","b","c", "d", "e", "f", "g", "h", "i", "j", 
 "k","l" ,"m" ,"n", "o" ,"p" ,"q" ,"r", 
"s","t" ,"u" ,"v", "w", "x", "y","z"});

object da;
string *allowed;

reset()  {
	::reset();
	schuppe=schuppe++;
	zufall=1+random(26);}
        

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Perlen-Laden von Tijara" );
  SetProp( P_INT_LONG, BS(
"Du bist nun im Perlenladen von Tijara. Hier wird mit Perlen aller "
"Art gehandelt. Der Perlenhandel muss reich machen, denn die Waende "
"sind aus purem weinroten Marmor und grosse Mosaike aus Perlen verzieren "
"die Decke und den Boden. Eine pompoese Theke aus Bergkristall ist das "
"Zentrum des Ladens. Von hier aus erledigt der Besitzer all seine "
"Geschaefte. Aus grossen Loechern in den Ecken blaest kuehle Luft. "
"Ja, der Besitzer muss wirklich reich sein. Im Westen fuehrt eine Tuere "
"wieder hinaus ins heisse, staubige Tijara. Eine Holztuere fuehrt nach unten.               "
"                                   Eine Tafel."));

da=find_living("dante");
allowed=({});

AD(({"holztuer","holztuere"}),
"Die Holztuere fuehrt nach unten. Ob es eine normele Tuere ist?!");


AD(({"raeder","rad"}),
"An der Holztuere ist ein komplizierter Mechanismus angebracht. "
"Er kann mit den Raedern bedient werden.");
AD("mechanismus",
"Mit den Raedern kann man diese Holtzuere oeffnen. <syntax: drehe raeder auf zahl>.");

AD("tafel", "Lies sie!");
ARD("tafel",
"##########################################################\n"
"#         Willkommen im Perlenladen von Tijara!          #\n"
"#                                                        #\n"
"#      Du kannst hier Perlen kaufen und verkaufen.       #\n"
"#  Ausserdem kannst Du mit Pole Kozdeich ein kleines,    #\n"
"#  aber verflixtes Spiel spielen. Frage ihn einfach!     #\n"
"#                                                        #\n"
"#                                                 Dante  #\n"
"##########################################################\n");

AD(({"loch","loecher"}),
"AHHH, frische Luft stroemt heraus...angenehm kuehl...");
AD(({"ecke","ecken"}),
"Aus den Ecken des Ladens stroemt kuehle Luft.");
AD("luft",
"Frisch und kuehl. Herlich!");
AD("westen",
"Da ist die Tuere.");
AD(({"tuere","tuer"}),
"Da geht es hinaus.");
AD("zentrum",
"Tijara is das Zentrum des Dschungels, der Dschungel das Zentrum des Silberland.");
AD(({"handel","perlenhandel","geschaefte","geschaeft"}),
"Wenn man schlau ist kann man mit dem Handel von Perlen viel verdienen.");
AD(({"wand","waende"}),
"Die Waende sind aus weinrotem Marmor.");
AD("marmor",
"Er wirkt sehr elegant und muss wirklich teuer gewesen sein.");
AD(({"mosaik","mosaike"}),
"Die Mosaike wirken teils pompoes, teils wirklich gelungen.");
AD("boden",
"Du stehst gerade auf einem der Mosaike herum!");
AD("decke",
"Die Decke ist auch mit Mosaiken verziert. Ah! Das sieht aus wie ein Zeichen!");
AD("theke",
"WOW! So eine Theke hast Du noch nie gesehen. Sie ist aus purem "
"Bergkristall. Im Inneren der Theke kannst Du Etwas erkennen!");

ASD(({"inneres","innerem","etwas","inneren"}), "fake");
AD(({"bergkristall","kristall"}),
"Der Bergkristall funkelt und glitzert magisch.");

AddSpecialDetail(({"zeichen"}),"zeichen");


AD(({"laden","perlen-laden","perlenladen"}),
"Hier wird mit Perlen aller Art gehandelt.");
AD(({"tijara","stadt","dschungel"}),
"Tijara ist die groesste und schoenste Stadt und liegt im Dschungel.");
AD("art",
"Frag den Besitzer des Ladens nach 'liste'. Er kennt sie alle.");
AD("besitzer",
"Der Besitzer des Ladens heist Pole Kozdeich.");
AD(({"pole","kozdeich"}),
"Er kauft und verkauft Perlen und spielt auch gerne damit.");
AD(({"perle","perlen"}),
"Ueberall im Silberland kann man Perlen finden oder erbeuten.");
AD("silberland",
"Da leben wir alle.");



  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN: TT_HOUSE]) );


  AE("westen", "/d/dschungel/dante/tijaraneu/room/ti_pfad12");

AIT("/d/dschungel/dante/perlenquest/pole", REFRESH_DESTRUCT);



 AddSound( DEFAULT_SOUND,
     "Du glaubst Laerm zu hoeren.");
     AddSound("laerm",
     "Das ist eben eine Stadt hier.\n");
     AddSound("stadt",
     "LAUT!!!!!");
     
 AddSmell( DEFAULT_SMELL,
  "Es riecht hier nach frischer Luft.");

AddSmell("luft",
"Frisch.");

ASE("unten", "unten");
AddCmd(({"drehe","dreh"}), "code");
AddCmd("test","test");
fix="";
}



int unten()  {

if(member_array(getuid(TP), allowed ) ==-1 )  {

	write(BS(
	"Als Du durch die Holztuere nach unten gehen willst, "
	"fallen Dir einige, kleine Raeder an der Tuere auf. So einfach "
	"scheint man da nicht runterzukommen..."));
         return 1;  }
         
       if(member_array(getuid(TP), allowed)!=-1 )  {
	
	write(BS(
	"Du gehst nach unten!"));
	TPM("/d/dschungel/dante/perlenquest/unten:"+getuid(TP),
	M_NOCHECK, "nach unten", "geht", "kommt herunter");
	
	return 1;
	}  
       }  
       
       
       
int test(string str)  {
string *zerlegt;
string x, y;

zerlegt=({});
fix="";
geraten=0;

code=0;

if(!IS_WIZARD(TP))  { return 0; }

if(da) { tell_object(da,
      "zufall: "+zufall+"\n"); }


	notify_fail("namen?!?!!?\n");
	if(!str) return 0; 
	
for(i=0; i<strlen(str); i++)   {
        
x=str[i..i];
 if(da) { tell_object(da,
         ""+x+"\n");}
zerlegt+=({ x }); 	


for(ii=0; ii<sizeof(liste); ii++)   {

y=liste[ii];

if(x==y)  {
	
code=ii+zufall;	
if(code > 26 ) { //soviel buchstaben hat das alphabet im dt.
code=code-26;
             }// 
fix+=to_string(code);
if(da) { tell_object(da,
 "c:"+code+" x:"+x+" y:"+y+"\n"); }
         }
        }
      }
   
   if(da) { tell_object(da,
   fix+" in testfunc\n");  }
   
    geraten=to_int(fix);
     
return 1; }



string zeichen()  {

	test("+kozdeich+");
	
	
	return (
	"Irgendwie kann man da lesen:\n"
"Bevor ichs vergessen, achja was wollte ich doch gleich...\n"
"Aja, die verfluchten Raeder. Hmm, die Zahl war es.\n"
"Kozdeich ergibt "+fix+"...komisch...\n"
"Und dann steht da noch:\n"
"Du bist die Loesung...???\n");


}	


int code(string str)  {
	int zahl;
	object ob;
	notify_fail("Die Syntax lautet: 'drehe raeder auf zahl'\n"
	"Wobei 'zahl' natuerlich eine echte Zahl sein muss, also z.B. 3891238.\n");
	
if(!str)  { return 0;  }

if(sscanf(str, "raeder auf %d", zahl)!=1 )  {
 
 return 0; }	



	
test(getuid(this_player()));

if(zahl==geraten) {

	if(da) { 
		tell_object(da,
"Code richtig: fix:"+fix+"..str:"+str+"\n"); }

write(BS(
"Du drehst die Raeder auf die Zahl "+zahl+". Es macht ein leises Klicken, "
"die Tuere geht auf und Du kannst nun nach unten gehen!"));
say(BS(
CAP_TPN+" dreht die Raeder auf die richtige Kombination."));

if(member_array(getuid(TP), allowed)!=-1 )  {
	
	write(BS(
	"Du darfst ohnehin schon nach unten gehen!"));
     return 1;
	}



//wenn noch nicht drin dann rein ins array wenn er drin is kann er eh runter
if(member_array(getuid(TP), allowed)==-1 )  {
	allowed+=({getuid(TP)});
	}


	return 1; }
else

if(da) { tell_object(da,
"Code falsch: richtig: "+fix+"..falsch: "+str+"\n"); }
write(BS(
"Du drehst die Raeder auf die Zahl "+zahl+". Es macht ein leises Klicken, "
"die Tuere geht aber nicht auf. Diese Kombination war leider falsch! "
"Versuche es weiter."));
say(BS(
CAP_TPN+" dreht die Raeder leider auf die falsche Kombination!"));

if(member_array(getuid(TP), allowed)!=-1 )  {
	write(BS(
	"Du darfst ohnehin schon nach unten gehen!"));
	}

return 1;
	
}




string fake()  {
	return BS(
	"WOW! Da sind mitten in den Bergkristall "+schuppe+" Drachenschuppen "
	"eingelegt worden! Wie man die wohl herausbekommen kann?!?!");
	}