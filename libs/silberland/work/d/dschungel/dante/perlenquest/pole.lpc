//questnpc by dante

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

#define QUESTKEY "Das verflixte Perlenspiel"
#define BONUS 200
string liste();
string perlenspiel();

string check_dirs(string dir);
string *perlen;
object cash;
int i;
int wert, preis;

init(){
::init();
if(interactive(TP))  {
call_out("hallo", 0); }}

hallo() {
if(environment(TO)!=environment(TP)) return ;




 if(TP->QueryQuest(QUESTKEY))  {
 	write(BSA(
  CAP_TPN+", Hallo! Na, macht das Spiel Spass?!",
  "Pole Kozdeich sagt: "));  return ;  }
  		 
else  {
  write(BSA(
  "Hallo, "+TPN+", was kann ich fuer Sie tun, wehrter Kunde!",
  "Pole Kozdeich sagt freundlich: "));  return ; }}
  	



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(40);
  SetProp(P_SHORT, "Pole Kozdeich");
  SetProp(P_LONG, BS(
  "Das ist Pole Kozdeich, ein listiger Mischling, halb Mensch, "
  "halb Troll, der sich "
  "hier, weit ab von seiner Heimat, niedergelassen hat. Er "
  "betreibt Geschaefte mit Perlen. Er ist zu jedem Spass bereit und "
  "spielt gerne Spiele. Frag ihn danach! Du kannst bei ihm auch Perlen "
  "kaufen und auch verkaufen! Er sagt Dir auch welche Perlen es ueberhaupt gibt. "
  "Frag ihn nach Liste."
  " Solltest Du das Abenteuer "+QUESTKEY+" schon bestanden haben "
	"und ein neues Spiel haben wollen, weil Du Dein, "
	"altes verloren hast, so frage einfach nach Belohnung!"));
	
  
  
  
set_living_name("pole");
   
  SP(P_INFO, "Frag Pole doch einfach nach Spiel!");
  SetProp(P_NAME, "Pole Kozdeich");
  SetProp(P_GENDER, MALE);
  AddId( ({"pole","kozdeich" "pole kozdeich", "NOWIMPY"}));
  SetProp(P_RACE, "Mischling");
  SetProp(P_SIZE, 280);
  SetProp(P_ALIGN, 300);
  
  SetProp(P_MAX_HANDS, 2);
  SP(P_ARTICLE, 0);
  SP(P_BODY, 140);
  
  
  
 SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));

SetProp(P_HANDS, ({" mit seinen starken Armen",280,({DT_BLUDGEON})}));

 
SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt gierig nach spielfreudig herein");
SetProp(P_MSGOUT, "geht grinsend");
SetProp(P_MMSGIN, "kommt voller Spass herein");
SetProp(P_MMSGOUT, "geht singend davon");


SetProp(P_SPELLRATE,60);


AddSpell(4,300,
 "Pole Kozdeich greift Dich mit einem Tritt an!\n",
 "Pole Kozdeich greift @WEN mit einem Tritt an!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, 400,
"Pole Kozdeich schleudert einen Stein nach Dir!\n",
"Pole Kozdeich schleudert einen Stein nach @WEM!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, 600,
"Pole Kozdeich pruegelt irr auf Dich ein!\n",
"Pole Kozdeich pruegelt irr auf @WEN ein!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

SetChats(3,({
"Pole Kozdeich sagt: Ich liebe alle Perlen!\n",
"Pole Kozdeich sagt: Perlen!!! Ich verehre sie!\n",
"Pole Kozdeich zaehlt seine Perlen!\n",
"Pole Kozdeich ueberprueft seine Perlen!\n",
"Pole Kozdeich poliert eine Perle!\n",
"Pole Kozdeich sagt: Hast Du das Spiel schon??!\n",
"Pole Kozdeich sagt: Komm, spiel mit mir was!!\n",
"Pole Kozdeich sagt: Perlen sind mein Leben!\n",
"Pole Kozdeich sagt: Ich spiele gerne Spiele!\n",
"Pole Kozdeich sagt: Wollen wir ein Spiel machen?!\n",
"Pole Kozdeich sagt: Du kannst mit mir ein Spiel machen!\n"}));

SetAttackChats(20,({
"Pole Kozdeich sagt: Du mieser Raeuber!\n",
"Pole Kozdeich sagt: Hilfe!\n",
"Pole Kozdeich schreit: Ueberfall!!!\n",
"Pole Kozdeich sagt: Du Verbrecher!\n",
"Pole Kozdeich sagt: Hau ab!\n"}));




AI(({"kozdeich", "pole","pole kozdeich"}),
"Das bin ich, wer sonst?!", "sagt: ");
AI("silberland",
"Na, hier leben wir alle?!", "sagt: ");
AI("stadt",
"Diese Stadt hier heisst Tijara!", "sagt: ");
AI("tijara",
"So heisst diese Stadt!", "sagt: ");
AI("dschungel",
"Tijara liegt im Dschungel, oder besser der Dschungel beginnt "
"hier. Er ist eine der aufregendsten Gegenden dieses Landes.", "sagt: ");



AI(({"drachen","drache"}),
"Ach, es gibt viele davon. Nur sind sie meistens nicht "
"sehr freundlich!", "sagt: ");
AI(({"dschungelphantom", "phantom"}),
"Das Dschungelphantom treibt sich gerne bei einem Tuempel "
"herum. Es zaubert sich aber im ganzen Dschungel umher, und so "
"ist es schwer es zu finden.", "sagt: ");


//wichtige infos

AI(({"perle","perlen"}),
"Du kannst bei mir Perlen kaufen und verkaufen! Ich zahle die besten Preise! "
"Viel bessere als jeder normale Laden und auch viel bessere als Gihr Heuchlox, "
"der Edelsteinspezialist! Frag mich ruhig nach einer Liste davon.",
"sagt: ");
AI(({"gihr","heuchlox","edelstein","edelsteine"}),
"Gihr handelt mit Edelsreinen!","sagt: ");
AI(({"spiel","spiele"}),
"Ich spiele gerne, am liebsten mit Perlen. Ich kenne da ein gutes Spiel. "
"Wenn Du es mit mir wirklich Spielen willst, so frag mich nach "
"Perlenspiel!", "sagt: ");
AI("liste",  #'liste, "sagt: ");
AI("perlenspiel", #'perlenspiel, "sagt: ");

AI("beginn",
"Wenn Du das Abenteuer beginnen willst, so gehe in das untere Zimmer. "
"Dort bist Du alleine und hast Ruhe. Die genaue Syntax und die "
"Befehle werden Dir auch dort erklaert. Viel Spass und Erfolg!", "sagt: ");


  AddInfo(DEFAULT_INFO, ({
  "sagt: Ich liebe alle Perlen!\n",
  "sagt: Ach was, bring mir lieber Perlen!\n",
  "schaut Dich spielfreudig an!\n",
  "sagt: Hmm, Perlen und Spiele sind mir am liebsten!\n"}));
  

  SUID;
  cash=clone_object("/obj/money");
  cash->SP(P_AMOUNT, 534+random(676));
  cash->move(TO, M_NOCHECK);
  
  switch(random(4)) {
    case 0: CLONEME("/d/gebirge/speedy/trollager/weapon/trolldolch" ); break;
    case 1: CLONEME( "/p/weapon/club/dornenknueppel" ); break;
    case 2: CLONEME( "/p/weapon/club/dornenkeule"); break;
    case 3: CLONEME( "/p/weapon/axe/steinbeil"); break;
  }
  CLONEME("/d/gebirge/speedy/trollager/armour/trollruestung" );
  command("ziehe alles an");
 command("zuecke dolch");
  command("zuecke knueppel");
  command("zuecke keule");
  command("zuecke beil");
    

ACD(({"verkaufe","verkauf"}), "verkaufe_perle");
ACD(({"kaufe","kauf"}), "kaufe_perlen");


}

string perlenspiel()  {
	 return (
"Bei dem Spiel geht es darum mit Perlen, die man sich entweder vorher "
"durch metzeln, tauschen, kaufen usw. besorgt hat eine mastermindaehnliche "
"Aufgabe zu loesen. Ich suche mir 4 Perlenarten aus und setze sie dann "
"in einer beliebigen Reihenfolge. "
"Du musst nun die 4 Perlenarten herauszufinden "
"und sie dann in die richtigen Positionen setzen. "
"Perlen, die Du falsch legst, gehoeren mir, also wirst Du durchaus "
"einige Perlen brauchen. Hier wird mit 4 Positionen ohne Mehrfach- "
"legungen gespielt. Wenn Du zu viele Versuche "
"brauchst, wird das Spiel neu gestartet. "
"Solltest Du gewinnen, bekommst Du von mir eine wertvolle Belohnung!!!"
" Wenn Du bereit fuer das Spiel bist, dann frage mich nach 'beginn'! ");	
}


string liste()  {
	int num;
	perlen=get_dir("/obj/pearls/*");
        
        perlen=filter_array(perlen, #'check_dirs);
	
	for(i=0;i<sizeof(perlen); i++) {
        
        
        perlen[i]=perlen[i][0..(strlen(perlen[i])-3)];
      write(""+(i+1)+".) "+CAP(perlen[i])+"\n");
    
               }
 
 return "Das sind alle Perlen die es momentan gibt!\n";	
	
	}

string check_dirs(string dir)   {

    
       if(strstr(dir, ".lpc")!=-1) 
       
       return dir;

         }






int kaufe_perlen(string str)  {
	object ob, perle;
	 NF("Pole Kozdeich sagt: Was willst Du genau kaufen?!\n");

    if (!str) return 0;              

if(str=="perle"||str=="perlen")  {
	write(BSA(
	"Welche Perle genau!", "Pole sagt: "));
	return 1; }

if(strstr(str, "perlen")!=-1)  {
	write(BSA(
	"Moment! Du kannst immer nur eine Perle kaufen!"
	"Ich kenn mich sonst nicht mehr aus! Sorry",
	"Pole sagt: "));
	return 1; }
	
	

perlen=get_dir("/obj/pearls/*");
 
 perlen=filter_array(perlen, #'check_dirs);
 
if(!sizeof(perlen))  {	write(BS(
"BUG! Bitte Erzmagier oder Dante verstaendigen!"));
return 1; }



for(i=0;i<sizeof(perlen); i++) {
        perlen[i]=perlen[i][0..(strlen(perlen[i])-3)];
   }

 
	
if(member_array(str, perlen)==-1)  {
write(BSA(
	"Sorry, aber '"+str+"' verkaufe ich hier nicht!",
	"Pole sagt: "));
	return 1;
     }

wert=clone_object("/obj/pearls/"+str+"")->QP(P_VALUE);

preis=wert*7+random(100);

if(TP->QueryMoney() < preis)  {
	write(BSA(
	"Sorry, aber Du hast nicht "+preis+" Muenzen, und genausoviel "
	"wuerde eine "+CAP(str)+" hier kosten!",
	"Pole sagt: "));
  return 1; }
  
ob=present(str, TP);

if(ob)  {
	ob->AddAmount(1);
        }
if(!ob)  {
	perle=clone_object("/obj/pearls/"+str+"");
	perle->move(TP, M_NOCHECK);
	}

write(BS(
"Du kaufst um "+preis+" Muenzen eine "+CAP(str)+".\n"));
write(BSA(
"Gut, hier hast Du eine "+CAP(str)+"!",
"Pole sagt: "));
tell_room(environment(TP),
CAP_TPN+" kauft sich eine "+CAP(str)+" bei Pole.\n", ({TP}));


TP->AddMoney(-preis);

if(!present("muenzen", TO)) {
  cash->SP(P_AMOUNT, preis);
  cash->move(TO, M_NOCHECK); }
  
  else

  cash=present("muenzen", TO);
  cash->AddAmount(preis);
  
  
return 1;  }
	


//kaufe aus verkaufe start


int verkaufe_perle(string str)  {

object ob;


  NF("Pole Kozdeich sagt: Was willst Du mir verkaufen?!\n");
   
     if (!str) return 0;              


ob=present(str, TP);


if(!ob)  {
	write(BSA(
"Aber "+TPN+", Du hast doch "+CAP(str)+" gar nicht!",
"Pole Kozdeich sagt: "));
return 1; }
	


if(!ob->IsUnit())  {
	write(BSA(
  "Nein! Das will ich nicht kaufen! "
  "Das gefaellt mir nicht!",
  "Pole Kozdeich sagt: "));
  return 1; }
  	
     
    if(str=="perle"||str=="perlen")  {
 
 if(!present("perle", TP))  {
 write(BSA(
 "Aber Du hast gar keinen Perle, vielleicht hast Du ja einen "
 "irgendwo eingesteckt?!",
 "Pole Kozdeich sagt leise: "));
 return 1; }
 
if(present("perle", TP))  { 
 write(BSA(
 "Welchen Perle willst Du mir verkaufen?! Genau bitte!",
 "Pole Kozdeich sagt leise: "));
 return 1; }

  return 0;  }
 
  if(!ob)  {
  write(BSA(
  "Aber "+TPN+", Du hast "+capitalize(str)+" doch gar nicht!",
  "Pole Kozdeich sagt leise: "));
  return 1; }


  if(ob)  {
 
 
     if(!ob->id("perle"))  {             
      write(BSA(
      CAP_TPN+", ist "+capitalize(str)+" etwa ein Perle?!",
      "Pole Kozdeich sagt grantig: "));
      return 1; }


  
    if(ob->id("perle"))  {
 
 wert=ob->QueryProp(P_VALUE);

  
   write("Pole Kozdeich schaut sich "+ob->name(WEN)+" mit einer Lupe genau an.\n\n");
   
    if(file_name(ob)[0..11]=="/obj/pearls/")  {
    

preis=wert+100+random(BONUS);

    write(BSA(
    "Ok, "+TPN+" das Geschaeft ist fixiert. Ich gebe Dir dafuer "+preis+" "
    "Muenzen!", "Pole Kozdeich sagt leise: "));
write("Pole Kozdeich wirft das Geld vor Deine Fuesse und Du gibst ihm "+ob->name(WEN)+"!\n"
    "Dann sperrt er "+ob->name(WEN)+" schnell in einen geheimen Schrank!\n");
    cash=clone_object("obj/money");
    cash->SetProp(P_AMOUNT, preis);
    cash->move(environment(TP), M_NOCHECK);
    
    ob->AddAmount(-1);
    return 1; }

    
    return 0; }
   return 0; }
return 0; }
 
 

die(arg)   {
     write_file("/d/dschungel/dante/weg/log/pole",
    dtime(time())+": "+CAP(getuid(TP))+" toetet Pole!\n");
       ::die(arg);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/dschungel/dante/weg/log/pole",           
    ctime()+": Pole hat "+CAP(getuid(player))+" umgebracht.\n");
NAL1
}
NAL2
