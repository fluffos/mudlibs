#include "/players/dante/myowndefine.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <ansi.h>
#include <wizlevels.h>

int anzahl=3; //ergibt vier also vier std
              //das is der std wert...4 positionen

int max_versuche=12;
int multi=1;

string *geraten;
string *gesetzt;
int i, x, counter,  game_counter, perle_richtig;
int position_richtig; 
//counter zaehlt versuche mit....game_counter spiele

string *perlen, *operlen;
int frage();
bestrafung(int damage);

create()
{
  if (!is_clone(TO) )  return;

  ::create();
//orginal array, wird nie veraendert.....
operlen=({
"derlimperle","felseninselperle","haiperle","knarkhperle","korallenperle",
"krakenperle","mauritiusperle","midasperle","oktopusperle",
"piratenperle","polarperle","quaulperle","riffperle",
"schwertfischperle","smoerskyperle",
"suedseeperle","tiefseeperle","tijaraperle","walperle","zombieinselperle"});
  
  perlen=operlen; 
//perlen wird veraendert...da werden die bereitsgenommenen rausgetan...
//wenn ein spieler zuviele versuche braucht wird neu begonnen, dafuer
//brauche ich noch das orginalarray..umstaendlich ich weiss






  SetProp(P_SHORT, "Ein merkwuerdiges Perlen-Spiel");
  SP(P_LONG, BS(
  "Das Spiel besteht aus einem zylinderfoermigen Gegenstand "
  "der aus tausenden von Edelsteinsplittern gemacht wurden. "
  "An der Oberflaeche sieht man "+(anzahl+1)+" Vertiefungen, in "
  "welche Du Perlen setzen kannst. Das Innere des Zylinders kann "
  "man nicht genau erkennen; bunter Edelsteinstaub scheint langsam "
  "im Inneren auf und ab zu schweben und ab und an glaubst Du einen "
  "winzigen Magier mit einem grossen, schwarzen Hut zu erkennen. "
  "Hilfe gibt es mit 'ph|philfe' und mit 'pbefehl|pbefehle'."));
  
  SetProp(P_NAME, "Perlenspiel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SP(P_VALUE, 0);

 SP(P_MAGIC, 1);
 SP(P_NOSELL, 1);

  AddId(({"t","spiel","perlenspiel" "NODESTRUCT", 
  "PERLENSPIEL_DANTE_QUEST","PERLEN_SPIEL_DANTE"}));

ACD(({"psetz","psetze"}), "rate_werte");
ACD(({"ph","philfe"}), "philfe");
ACD(({"pbefehl","pbefehle"}), "pbefehl");
ACD("pstart", "setze_werte");

counter=0;

}

        
        
//hier beginnt die rate fun()    

int rate_werte(string str)   {
	string *namen;
	object pearl;
	
	NF("Du musst "+(anzahl+1)+" Perlen angeben!\n"
	"Z.B.: 'psetze riffperle haiperle walperle tijaraperle'.\n");


if(!sizeof(gesetzt) || sizeof(gesetzt)!=(anzahl+1) )  {
	write(BS(
	"Bitte starte das Spiel zuerst! "
	"'"+ANSI_RED+"pstart"+ANSI_NORMAL+"'!"));
	return 1;  }
	
write("Du beginnst zu setzen!\n");

if(!str) return 0;


namen=explode(str, " ");

if(!sizeof(namen))  { return 0; }
//eigentlich redundant..

if(sizeof(namen)!= (anzahl+1) )  {
	
	write(BS(
	"Du musst "+ANSI_RED+""+(anzahl+1)+""+ANSI_NORMAL+" Perlen angeben!"));
	return 1;  }
	

for(i=0; i<sizeof(namen);i++)   {
	
	if(member_array(namen[i], operlen)==-1)  {
	write(BS(
	"Sorry, aber eine '"+ANSI_RED+""+namen[i]+""+ANSI_NORMAL+"' kenne ich nicht."));
	return 1;  }
        }

for(i=0; i<sizeof(namen);i++)   {
	
   if(!deep_present(""+namen[i]+"", TP))  {
   	write(BS(
   	"Aber Du hast doch gar keine "+CAP(namen[i])+"!"));
   	return 1;  }
   }		



geraten=({});

counter++;
write(
"\nDas ist Dein "+ANSI_RED+""+counter+""+ANSI_NORMAL+" Versuch!\n");

for(i=0;i<=anzahl;i++)   {

 geraten+= ({namen[i]}); 
 
write("Auf die "+ANSI_RED+""+(i+1)+""+ANSI_NORMAL+" Position "
"setzt Du die "+ANSI_RED+""+CAP(geraten[i])+""+ANSI_NORMAL+".\n");  
      
 

                         }


if( !sizeof(geraten) || sizeof(geraten)!=(anzahl+1)  )  {
	write(BS(
	"Bug in geraten/sizeof Bitte Dante verstaendigen! Danke!"));
	return 1;                     }
	
  

//ok ab hier wird geschaut ob eines der geratenen worte im gesetzen
//array is.....
	
perle_richtig=0;	

for(i=0; i<=anzahl;i++)  {
	
     if(member_array(geraten[i], gesetzt)!=-1)  {
	perle_richtig++;
		}
         }
         
         
         
if(perle_richtig==0)  {
	write(BS(
	"Leider ist "+ANSI_RED+"keine"+ANSI_NORMAL+" der Perlen richtig!"));
	      
	  bestrafung(40);    
	      
	      }

if(perle_richtig==1)  {
	write(BS(
""+ANSI_RED+"Eine"+ANSI_NORMAL+" der gesetzten Perlen befindet sich unter den gesuchten "+(anzahl+1)+" Perlen."));
              bestrafung(30);
              }

if(perle_richtig > 1)  {
	write(BS(
""+ANSI_RED+""+perle_richtig+""+ANSI_NORMAL+" Perlen befinden sich unter den gesuchten "+(anzahl+1)+" Perlen!"));
              
              bestrafung((4-perle_richtig)*10);
              }

//ab hier wird gesehen welche positionen richtig sind......


position_richtig=0;	


for(i=0; i<=(anzahl); i++)  {
 
 if(  geraten[i]==gesetzt[i] ) {
     
  //  write("Diese passen!:\n");
    //     write("geraten an "+(i+1)+": "+geraten[i]+"\n");
      //  write("gesetzt an "+(i+1)+": "+gesetzt[i]+"\n");
 		position_richtig++;  
		}
            }         
         
if(position_richtig==0)  {
	write(BS(
"Leider ist "+ANSI_RED+"keine"+ANSI_NORMAL+" der Positionen richtig!"));
                 }

if(position_richtig==1)  {
	write(BS(
	"Leider ist nur "+ANSI_RED+"eine"+ANSI_NORMAL+" Position richtig!"));
              }

if(position_richtig > 1 && (position_richtig < (anzahl+1)) )  {
	write(BS(
	""+ANSI_RED+""+position_richtig+""+ANSI_NORMAL+" Perlen liegen in der richtigen Position!"));
              }
//alle richtig spiel gewonnen!!!!
	
	if(position_richtig == (anzahl+1))   {
  
   write("\n"+ANSI_RED+"Du hast das Spiel gewonnen!"+ANSI_NORMAL+"\n"
   "Du hast "+ANSI_RED+""+(counter == 1 ? "nur einen Versuch":""+counter+" Versuche")+""+ANSI_NORMAL+" gebraucht!\n"
   "Gratuliere!\n");
   //give quest!!!!!!
   //remove und belohngung gibts bei pole
   
   //counter=0;
   //gewinn++; 
   

     //frage();
          return 1;
                        }


if(counter >= max_versuche)  {
	
	 write("\n"+ANSI_RED+"Du hast das Spiel verloren!"+ANSI_NORMAL+"\n"
	"Du hast zu viele Versuche gebraucht, naemlich "
	""+ANSI_RED+""+counter+""+ANSI_NORMAL+".\n"
	"Die richtige Loesung waere gewesen:\n\n");

	
	for(i=0;i<=anzahl; i++)   {
   
   write(" POSITION "+ANSI_CYAN+""+(i+1)+""+ANSI_NORMAL+":"+ANSI_NORMAL+""
   " "+ANSI_RED+""+CAP(gesetzt[i])+""+ANSI_NORMAL+"\n");

                      }
	
        frage();
        counter=0;         
	return 1;   
	 }

write("Du hast noch "+ANSI_RED+""+(max_versuche-counter)+""+ANSI_NORMAL+" Versuche uebrig!\n");

return 1; }

//ende raten  ***********************************************************

frage() { 
 write(
        "\nNeues Spiel               : "+ANSI_RED+"pstart"+ANSI_NORMAL+".\n"
        //"Hilfe:                      : "+ANSI_RED+"ph/philfe"+ANSI_NORMAL+".\n" 
        //"Kommandos:                  : "+ANSI_RED+"pbefehl/pbefehle"+ANSI_NORMAL+".\n"
        //"Status                    : "+ANSI_RED+"pstatus"+ANSI_NORMAL+".\n"
        //"Mehrfachsetzungen:        : "+ANSI_RED+"pmultipel"+ANSI_NORMAL+".\n"
        //"Anzahl der Positionen     : "+ANSI_RED+"ppos zahl"+ANSI_NORMAL+".\n" 
       // "Spiel endgueltig verlassen: "+ANSI_RED+"pende"+ANSI_NORMAL+". "
       // "Alle Werte werden geloescht! Spiel wird zerstoert!\n"
        "Jede beliebige andere Taste beendet vorlaeufig den Spielmodus!\n"
        "Bitte gib nun etwas ein!\n\n");

  input_to("abfrage");
        }




int abfrage(string str) {
	
	
             
             if(str=="pstart")
              {
                    call_out("setze_werte", 0);
                return 1;
              }
              
        
              
              
        else
       write(BS(
       "Asta la Vista Baby!"));
       return 1;
     }                                                        


//beginn setzen*********************************************************
int setze_werte()  {


if(  file_name(environment(TP))!="/d/dschungel/dante/perlenquest/unten:"+getuid(TP)+"" )  
             {
     write(BS("Das Spiel scheint hier nicht zu funktionieren!"));
     return 1; 
              }

write(BS(
"Das Spiel beginnt neu!"));

	gesetzt=({});
	counter=0;
	perlen=operlen;
	
	if( (sizeof(perlen) < anzahl)   ||
	
	(!sizeof(perlen)) ) 
	
	 {  write(BS(
	"Bug! Bitte Dante verstaendigen! PERLEN LEER!"));
	return 1;  }
	
	
	for(i=0;i<=anzahl; i++)   {
		
	x=random(sizeof(perlen));
        
        gesetzt+= ({perlen[x]});
 	
 	//write("typ: "+perlen[x]+"\n");
 	if(multi!=1 )  {
 	
 	perlen-=({perlen[x]});
        
         }
     }
//einbauen das man anzahl spielen kann 	: done
//einbauen das man multimode spielen kann: done

write(
"Es wurden "+ANSI_RED+""+(anzahl+1)+""+ANSI_NORMAL+" Perlen gesetzt! Fang an zu setzen!\n");
if(multi!=1 )  {
	write(BS(
	"Mehrfachsetzungen einer Perlenart moeglich!"));
       }

   if( !sizeof(gesetzt) || (sizeof(gesetzt)>(anzahl+1))  )  {
	write(BS(
	"Bug!! sizeof anzahl  Bitte Erzmagier oder Dante verstaendigen!"));
	return 1;  }

   
   if( TP && getuid(TP)=="dante" )  {
   	write(BS(
   	"Nur zum testen!"));
   	
  	for(i=0;i<=anzahl; i++)   {
   write(" POSITION "+(i+1)+":   "+gesetzt[i]+"\n");
                                  }  		
                }
                
                
                
game_counter++;
write(BS(
"Das ist Dein "+game_counter+" Spiel insgesamt!"));

return 1;  }



int philfe()  {
	
	write(BS(
	"Dieses Spiel ist eine Art 'Mastermind-Spiel'. Es geht darum "
	"mit moeglichst wenigen Versuchen eine Kombination der "
	"unterschiedlichsten Perlen zu erraten. Man setzt eine "
	"Kombination aus Perlen und erfaehrt dann wieviele "
	"Arten von Perlen mit den vom kleinen Magier gesetzten "
	"uebereinstimmen und wieviele Positionen richtig sind. "
	"Sind alle Arten richtig und auch auf die richtigen Plaetze "
	"gesetzt, so hat man das Spiel gewonnen. "
	"Hat man die Kombination nach einer bestimmten Anzahl von "
	"Versuchen nicht gefunden, so hat man verloren! "
	"Momentan sind es immer dreimal so viele Versuche wie "
	"Positionen. Also bei "+(anzahl+1)+" Positionen"
	" "+((anzahl+1)*3)+" Versuche!"
	"ACHTUNG! In der Questversion verlierst Du die falsch gesetzten "
	"Perlen! Sie kommen alle in die Schatzkammer von Pole Kozdeich! "
	" Weitere Infos mit 'pbefehl|pbefehle'. Viel Spass!"));
	
	return 1;  }



int pbefehl() {

	write( 
	"Mit '"+ANSI_RED+"pstart"+ANSI_NORMAL+"' startest Du das Spiel neu.\n"
	"Mit '"+ANSI_RED+"psetzt(e) perle1 perle2 perle3 usw"+ANSI_NORMAL+"' "
	"kannst Du Perlen auf Positionen setzen.\nWobei Du natuerlich nur "
	"Perlen setzen kannst die Du auch besitzt.\nEs muessen immer soviele "
	"Perlen angegeben werden, wie es Positionen gibt.\n");
	
	return 1;
	 }

       
bestrafung(int damage)  {
	TP->do_damage(damage);
	write(BS(
	"Ein Blitz schiesst aus dem Spiel heraus und bestraft Dich!"));
        return; }
