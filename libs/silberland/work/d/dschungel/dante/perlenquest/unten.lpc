

#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Keller des Perlen-Laden von Tijara" );
  SetProp( P_INT_LONG, BS(
"Der Keller ist sehr schlicht. Keine Perlen oder andere wertvolle "
"Gegenstaende. Einfache Waende aus Holz, ein Boden aus Lehm, eine "
"Decke aus Holz und eine Treppe die wieder nach oben fuehrt. Du bist "
"enttaeuscht. "));

AD("keller",
"Du stehst mitten drin.");
AD(({"laden","perlenladen"}),
"Der Keller gehoert dazu. Du bist unter dem Laden.");
AD(({"perle","perlen"}),
"Offensichtlich liegen hier keine Perlen herum.");
AD(({"gegenstaende","gegenstand"}),
"Siehst Du auch keine.");
AD("holz",
"Boden und Decke wurden aus Holz gefertigt.");
AD("decke",
"Von der Decke haengt eine kleine Lampe. Sie schaukelt hin und her, "
"als wenn sie jemand angestossen hat. Merkwuerdig.");
AD("lampe",
"Die Lampe schaukelt hin und her. Es ist eine grosse Lampe.");
AD("lehm",
"Brauner, trockener Lehm.");
AD(({"wand","waende"}),
"Die Waende sind kahl und aus Holz.");

AD("boden",
"Der Boden ist aus Lehm und leer.");
AD("treppe",
"Die Treppe fuehrt wieder nach oben.");  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN: TT_HOUSE]) );


  AE("oben", "/d/dschungel/dante/perlenquest/perlenladen");




 AddSound( DEFAULT_SOUND,
     "Du glaubst Laerm zu hoeren.");
     AddSound("laerm",
     "Das ist eben eine Stadt hier.\n");
     AddSound("stadt",
     "LAUT!!!!!");
     
 AddSmell( DEFAULT_SMELL,
  "Es riecht hier nach alter Luft.");

AddSmell("luft",
"Stickig.");
ASE("oben", "oben");
ACD(({"stosse","stoss"}), "get_game");
}
int get_game(string str)  {
	object game;
	NF("Was willst Du anstossen?!\n");
	if(str=="lampe an" ||str=="lampe"|| str=="an lampe")  {
		
	write(BS(
	"Du stoesst an die Lampe."));
	if(!deep_present("PERLENSPIEL_DANTE_QUEST", TP) &&
	 !present("PERLENSPIEL_DANTE_QUEST", TO) ) {

	game=clone_object("/d/dschungel/dante/perlenquest/pgame.lpc");
	game->move(TO, M_NOCHECK);
	write(BS(
	"Ploetzlich faellt etwas aus der Lampe direkt vor Deine Beine."));
	return 1;  }
	
else
write(BS(
"Die Lampe schauckelt lustig umher."));
return 1;  }
return 0; }
		
		

int oben() {
	object spiel;
	spiel=deep_present("PERLENSPIEL_DANTE_QUEST", TP);
	
	if(spiel)  {
		write(BS(
		"Als Du nach oben gehst, faellt Dir das Spiel auf den "
		"Boden."));
	spiel->move(TO, M_NOCHECK);
	TPM("/d/dschungel/dante/perlenquest/perlenladen", M_GO,
	"nach oben", "geht", "kommt von unten herauf");
	return 1;  }

         if(!spiel)  {
        write(BS(
         "Du gehst wieder nach oben."));
	TPM("/d/dschungel/dante/perlenquest/perlenladen", M_GO,
	"nach oben", "geht", "kommt von unten herauf");
	return 1;  }		
		
	}	