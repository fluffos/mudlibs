//std_muraene von dante...sl 1999-2001

inherit "std/mnpc";
inherit "/std/npc/spells";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>


int i;
string *was;
string *was2;

void create()
{
  if (!is_clone(this_object())) return;  
  ::create();
  was=({"Grossmaul","Panzer","Ringel","Peitschen","Langschwanz",
      "Riff","Breitmaul","Rundkopf","Spitzmaul","Silber",
      "Meeres", "Dschungel","Silberland","Tigermuster","Dunkel","Punkt","Streifen"});

  was2=({
      "gross","klein","duenn","lang","dick","breit",
      "riesig","fett","schnell","behaebig","aggressiv"});


  i=random(sizeof(was));
  i=random(sizeof(was2));



  AddId(({"muraene" , ""+LOWER(was[i])+"muraene"}));
  create_default_npc(12+random(5));
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_ALIGN, 100);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_SHORT, "Eine "+was2[i]+"e "+was[i]+"muraene");
  SetProp(P_LONG, BS(
        "Das ist eine "+was[i]+"muraene. Muraenen lieben die Dunkelheit und "
        "leben gerne zurueckgezogen in dunklen Hoehlen oder Spalten. "
        "Dieses Exemplar ist besonders "+was2[i]+"!"));




  SetProp(P_NAME, ""+was[i]+"muraene");
  SetProp(P_GENDER, FEMALE);      

  SetProp(P_DIE_MSG, " versinkt in den Tiefen.\n");

  SetProp(P_NAME_ADJ, ""+was2[i]+"");
  SetProp(P_RACE, "Fisch");
  SetProp(P_BODY, 30+random(10));
  SetProp(P_SIZE, 100+random(300)); 
  SetProp(P_HANDS, ({" mit ihren scharfen Zaehnen", 100+random(150), DT_RIP}) );     

  SetProp(P_MSGIN, "kommt ploetzlich angeschwommen");
  SetProp(P_MSGOUT, "schwimmt an Dir vorbei");
  SetProp(P_MMSGIN, "schwimmt paddelnd hierher");
  SetProp(P_MMSGOUT, "schwimmt weit davon");
  SetProp(P_MNPC_AREA, "/d/dschungel/dante/uwhoehle/room/");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_INDOORS + MOV_MOVES+MOV_BACKWARDS );
  SetProp(P_MNPC_WAIT, ({10, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/uwhoehle/room/droom6");


  SetProp(P_REJECT, ({ REJECT_DROP, "Die Muraene hat daran kein Interesse.\n" }) );
  SetProp(P_SPELLRATE, 50);

  SUID;
  //CLONEME("d/wasser/dante/zinsel/obj/flo");


  SetChats(15,({
        "Die "+was[i]+"muraene schwimmt um Dich herum!\n",
        "Die "+was[i]+"muraene schwimmt an Dich heran!\n",
        "Die "+was[i]+"muraene schnappt nach Dir.\n",
        "Die "+was[i]+"muraene taucht kurz unter aber sofort wieder auf.\n",
        "Die "+was[i]+"muraene schlaegt mit ihrem Schwanz!\n",
        }));




  AddSpell(5, 200+random(100),
      "Die "+was[i]+"muraene beisst Dir ins Bein!\n",
      "Die "+was[i]+"muraene beisst @WEM ins Bein!\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 300+random(100),
      "Die "+was[i]+"muraene beisst Dir in den Arm!\n",
      "Die "+was[i]+"muraene beisst @WEM in den Arm!\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));


  AddDefaultSpell(1, 300, DS_PARALYZE,
      "Die "+was[i]+"muraene packt Dich und klemmt Dich in ihrem Maul fest!\n",
      "Die "+was[i]+"muraene packt @WEN und klemmt @WEN in ihrem Maul fest!\n",
      ([SP_SHOW_DAMAGE:1]));


}
