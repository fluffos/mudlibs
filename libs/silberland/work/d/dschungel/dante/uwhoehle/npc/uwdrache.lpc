//unterwasserdrachen by dante, speihen kein feuer


inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <ansi.h>
inherit "/std/npc/spells";
rueste_mich_aus();

int i;
string art, namen;
object gem, perl, cash, schuppe;
int zufall=1+random(5);


string *liste=({
    "a","w","e", "r", "t", "z", "u", "i", "o", "p", 
    "s","d" ,"f" ,"g", "h" ,"j" ,"k" ,"l", 
    "y","x" ,"c" ,"v", "b", "n", "m"});




void create()
{

  if (!is_clone(TO)) return;
  ::create();

  if(zufall < 1 || zufall > 5)  { zufall=3;  }

  switch(zufall)   {

    case 1:
      art="klein";
      break;
    case 2:
      art="mittelgross";
      break;
    case 3:
      art="gross";
      break;
    case 4:
      art="sehr gross";
      break;
    case 5:
      art="riesig";
      break;
    default: art="gross";
  }
  namen=""+liste[random(sizeof(liste))]+"";


  for(i=0;i<16;i++)  {
    namen+=""+liste[random(sizeof(liste))]+"";

  }


  SetProp(P_SHORT, "Ein "+art+"er Unterwasserdrache namens "+CAP(namen)+"");

  SetProp(P_LONG, BS(
        "Du siehst ein "+art+"es Exemplar eines Wasserdrachen vor Dir. Diese "
        "Art von Drachen kann nur Unterwasser leben. Trotzdem sind sie nicht zu "
        "unterschaetzen. Sie speihen logischerweise kein Feuer, doch ihre "
        "Schlagkraft und ihre anderen Fertigkeiten koennen Dir auch sehr "
        "gefaehrlich werden. Dieser heist "+CAP(namen)+"."));

  SP(P_ARTICLE, 0);


  SP(P_RACE, "Drache");
  SetProp(P_NAME, ({
        ""+CAP(namen)+", der Unterwasserdrache",
        ""+CAP(namen)+", des Unterwasserdrachens",
        ""+CAP(namen)+", dem Unterwasserdrachen",
        ""+CAP(namen)+", den Unterwasserdrachen"}));


  SetProp(P_GENDER, MALE);
  AddId(({""+namen+"","NOWIMPY", "NOCONTROLL","unterwasserdrache", "drache"}));

  create_default_npc(30+zufall*5);


  SetProp(P_HANDS, ({" mit seinen Unterwasserklauen",290+zufall*35,
        ({DT_RIP, DT_WATER})}));
  SetProp(P_SIZE, 400+zufall*100);
  SetProp(P_ALIGN, 0);

  SetProp(P_BODY, 150+zufall*30);
  SetProp(P_HEAL,zufall*5);
  SetProp(P_AGGRESSIVE, 0); 
  SetProp(P_WIMPY, 0);

  SetProp(P_RESISTANCE_STRENGTHS, ([DT_MAGIC: 0.1, DT_FIRE:-0.9, DT_BLUDGEON:-0.3,
    DT_TERROR: -0.9, DT_ACID: -0.5,DT_COLD: -0.2, DT_SLASH: -0.3, DT_WATER: -1.0,
    DT_HOLY:-0.1, DT_WHIP:0.5]));   

  SetProp(P_NOMAGIC, 5+zufall+random(zufall));

  SetProp(P_MSGIN, "schwimmt paddelnd hierher");
  SetProp(P_MSGOUT, "schwimmt eilig");
  SetProp(P_MMSGIN, "schwimmt paddelnd hierher");
  SetProp(P_MMSGOUT, "schwimmt weit davon");

  SetProp(P_DIE_MSG,  " stirbt laut blubbernd.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Das Wasser ist mein Zuhause! Hier bin ich unschlagbar!\n");  
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));
  SP(P_MURDER_MSG, "Du sollst qualvoll ertrinken, Du Beckenrandschwimmer!\n");

  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp(P_MAX_HANDS, 6);
  SetProp(P_TEMPERATURE_RANGE, ([0:-10, 1:50]));

  SetProp(P_SPELLRATE,40+zufall*3);


  set_living_name("unterwasserdrache");


  AddSpell(1,100+zufall*50,
      "Der Unterwasserdrache "+CAP(namen)+" schlaegt wild mit dem Schwanz nach Dir!\n",
      "Der Unterwasserdrache "+CAP(namen)+" schlaegt mit dem Schwanz nach @WEM!\n",
      DT_MAGIC, "spell_trans",([SP_SHOW_DAMAGE:1]));


  AddSpell(1,100+zufall*50,
      "Der Unterwasserdrache "+CAP(namen)+" spuelt Dir Wasser in Deine Augen!\n",
      "Der Unterwasserdrache "+CAP(namen)+" spuelt Wasser in @WESSEN Augen!\n",
      DT_MAGIC, "spell_blind",([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 200+zufall*50,DS_POISON,
      "Der Unterwasserdrache "+CAP(namen)+" sprueht gruenes Wasser um sich!\n",
      "Der Unterwasserdrache "+CAP(namen)+" sprueht gruenes Wasser um sich!\n");

  if(zufall > 2)  {
    AddDefaultSpell(1, 100, DS_DISARM); 
  }


  if(zufall > 3)    {
    AddDefaultSpell(1, 1, DS_CURSE_WEAPON, 
        "Der Unterwasserdrache "+CAP(namen)+" speiht gelbes Wasser auf Dich!\n",
        "Der Unterwasserdrache "+CAP(namen)+" speiht gelbes Wasser @WEN!\n");

    AddDefaultSpell(1, 1, DS_CURSE_ARMOUR, 
        "Der Unterwasserdrache speiht "+CAP(namen)+" schwarzes Wasser auf Dich!\n",
        "Der Unterwasserdrache speiht "+CAP(namen)+" schwarzes Wasser auf @WEN!\n");


    AddSpell(2,100+zufall*50,
        "Der Unterwasserdrache "+CAP(namen)+" wird sehr zornig!\n",
        "Der Unterwasserdrache "+CAP(namen)+" wird sehr zornig!\n",
        DT_MAGIC, "spell_all",([SP_SHOW_DAMAGE:1]));
  }


  AddSpell(6,300+zufall*40,
      "Der Unterwasserdrache "+CAP(namen)+" ringelt seinen Schwanz um Dich!\n",
      "Der Unterwasserdrache "+CAP(namen)+" ringelt seinen Schwanz um @WEN!\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5,350+zufall*40,
      "Der Unterwasserdrache speiht "+CAP(namen)+" stoesst eine Wasserfontaene aus.\n",
      "Der Unterwasserdrache speiht "+CAP(namen)+" stoesst eine Wasserfontaene aus.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(4,400+zufall*40,
      "Der Unterwasserdrache speiht "+CAP(namen)+" faucht Dich an.\n",
      "Der Unterwasserdrache speiht "+CAP(namen)+" faucht @WEN an.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,500+zufall*40,
      "Der Unterwasserdrache speiht "+CAP(namen)+" gurgelt magische Worte.\n",
      "Der Unterwasserdrache speiht "+CAP(namen)+" gurgelt magische Worte.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,600+zufall*50,
      "Der Unterwasserdrache speiht "+CAP(namen)+" entfacht ein Unterwasserbeben.\n",
      "Der Unterwasserdrache speiht "+CAP(namen)+" entfacht ein Unterwasserbeben.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
        "Der Unterwasserdrache "+CAP(namen)+" gurgelt laut.\n",
        "Der Unterwasserdrache "+CAP(namen)+" schwimmt nach oben.\n",
        "Der Unterwasserdrache "+CAP(namen)+" schwimmt umher.\n",
        "Der Unterwasserdrache "+CAP(namen)+" schwimmt nach unten.\n",
        "Der Unterwasserdrache "+CAP(namen)+" macht: BLUBB!\n",
        "Der Unterwasserdrache "+CAP(namen)+" ringelt seinen Schwanz umher.\n",
        "Der Unterwasserdrache "+CAP(namen)+" schwimmt naeher an Dich heran.\n",
        "Der Unterwasserdrache "+CAP(namen)+" sagt: Wasser!\n"}));

  SP(P_TRANSPARENT, 0);

  SP(P_KILL_NAME, "Der Unterwasserdrache "+CAP(namen)+"");

  SUID;
  call_out("rueste_mich_aus", 2);


}


void rueste_mich_aus()  {
  object da;
  string *ids;

  if(!environment())  { return;  }

  ids=environment(TO)->QP(P_IDS);

  da=find_living("dante");	
  if(member_array("ausruestungspezial", ids)!=-1)  {


    if(da)  {
      tell_object(da,
          "jo!\n");
    }

    if(zufall < 3 )   {

      switch(random(10))  {	
        case 0..4:
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwhose");	
          break;
        case 5..7:
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwstiefel");	
          break;
        case 8..9:
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwumhang");	
          break;
        default:

      }
    }

    if(zufall == 3 )  {
      switch(random(10))  {	
        case 0..2:
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwhose");	
          break;
        case 3..4:
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwstiefel");	
          break;
        case 5..6:
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwumhang");	
        case 7..9:
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwumhang");	
          CLONEME("d/dschungel/dante/uwhoehle/armour/uwhose");	
          break;
        default:

      }
    }


    if(zufall >= 4 )  {

      if(zufall==4 )  {  
        "obj/pearlmaster"->DistributePearl(zufall, 1, 1, 1); 
      }


      if(zufall == 5 )   {
        schuppe=clone_object("p/std/dragons/obj/schuppe");
        schuppe->SetProp(P_AMOUNT, (zufall) + random(6) ) ;
        schuppe->move(TO, M_NOCHECK);       

      }	
      switch(random(11))  {	


        break;
        case 0..2:
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwhose");	
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwstiefel");	
        break;
        case 3..4:
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwstiefel");	
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwpanzer");	
        break;
        case 5..6:
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwumhang");	
        case 7..8:
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwumhang");	
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwpanzer");	
        break;
        case 9:
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwumhang");	
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwstiefel");	
        break;
        case 10:
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwhose");
        CLONEME("d/dschungel/dante/uwhoehle/armour/uwpanzer");	
        break;	

        default:	

      }
    }	


    return;	
  }		


  switch(random(3))  {
    case 0:
      "obj/gemmaster"->DistributeGem(zufall, 3, 1, 1);	
      break;
    case 1:
      "obj/pearlmaster"->DistributePearl(zufall, 3, 1, 1); 
      break;
    case 2:
      cash=CLONEOB("/obj/money");
      cash->SP(P_AMOUNT, zufall*1111+random(3000) );
      cash->move(ME, M_NOCHECK);
      break;
    default: "obj/gemmaster"->DistributeGem(zufall, 3, 1, 1);
  } 

  schuppe=clone_object("p/std/dragons/obj/schuppe");
  schuppe->SetProp(P_AMOUNT, random(zufall*5) + random(6) ) ;
  schuppe->move(TO, M_NOCHECK);       

  //************************************************************
}

void spell_trans(object enemy)
{
  tell_object(enemy,
      "Der Unterwasserdrache "+CAP(namen)+" will Dich fortschleudern!\n");

  tell_room(environment(TO),
      "Der Unterwasserdrache "+CAP(namen)+" will "+enemy->name(WEN)+" fortschleudern!\n", ({enemy}));


  switch(random(100))
  {

    case 0 .. 60:
      enemy->move("/d/dschungel/dante/weg/room/tuempel2",M_NO_SHOW + M_TPORT);
      break;
    case 61.. 80:
      break; enemy->move("/d/wasser/dante/zinsel/room/steg1",M_NO_SHOW + M_TPORT);
      break;
    case 81 .. 99:
      tell_object (enemy,
          "Der Unterwasserdrache "+CAP(namen)+" schreit: Du Wurm hast nur Glueck gehabt!\n");
      break;
  }
}


void spell_blind(object enemy)
{
  switch(random(100))
  {
    case 0 .. 50:
      enemy->SetProp(P_BLIND, 10+zufall*5+random(20));
      break;
    case 51.. 100:
      tell_object(enemy,
          "Das Wasser schadet Dir nicht! Du hast nochmal Glueck gehabt!!!\n");
  }
}


void die(int arg)  {
  write_file("/d/dschungel/dante/weg/log/uwdrache",
      ctime()+": Uwdrache "+art+" wurde von "+CAP(getuid(TP))+" umgebracht.\n");
  ::die(arg);  }


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/dschungel/dante/weg/log/uwdrache",
      ctime()+": Uwdrache "+art+" hat "+CAP(getuid(player))+" umgebracht.\n");

}

_query_wimpy() { return 0;}



void spell_all(object enemy,int damage,mixed dam_type)
{
  int i;
  object *inv;
  inv=PresentEnemies();
  damage=random((700)+100+zufall*50);
  damage/=sizeof(inv);
  tell_room(ENV(ME), BS("Der Unterwasserdrache "+CAP(namen)+" schlaegt wild um sich!\n"));
  for(i=sizeof(inv)-1;i>=0;i--)
  {
    tell_object(inv[i], "Du wirst schwerstens getroffen!\n");
    inv[i]->Defend(damage, dam_type,
        ([SP_SHOW_DAMAGE:1,SP_NAME:"Unterwasserdrache"]), this_object());
  }
}



int Defend(int dam, mixed dtype, int spell, object enemy)    
{ 

  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (sizeof(dtype & ({ DT_FIRE }) ))
  {
    tell_object(enemy, "Dein Feuerangriff wird durch das Wasser geloescht.\n");
    return ::Defend(0, dtype, spell, enemy);  }

    return ::Defend(dam, dtype, spell, enemy);    
}

