
inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <npc.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
inherit "/std/npc/spells";

init()  {
	::init();
if(interactive(TP))  { call_out("tag", 1);  }

}

tag()  {
	if(environment(TO)!= environment(TP))  { return;  }


if(getuid(TP)=="creative")  {
	write(BSA(
	"Servus Creative, danke fuer den Namen! Lubbox war ja zu bloed!",
	"Blubbox sagt: "));
return;
}
	

write(BS("Blubbox sagt: Willkommen "+TPN+"! Trink doch was!"));


   
   }		

create()
{
  if (!is_clone(this_object())) return;  
  ::create();

  AddId(({"blubbox" , "zwerg", "mutant","mutantenzwerg"}));
  create_default_npc(20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, 100);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_SHORT, "Blubbox, der mutierte Zwerg");
  SetProp(P_LONG, BS(
"Das ist Blubbox, ein Zwerg der schon vor langer Zeit vom Gebirge und seinen "
"Bewohnern die Schnauze voll hatte, und hier her ausgewandert ist. Durch das "
"staendige Tauchen und Schwimmen wachsen ihm bereits Kiemen und man sieht sogar "
"eine kleine Flosse."));

AD(({"kiemen","floss"}),
"Ja, wirklich! Er mutiert zu einem Fisch...");  

AI(({"blase","luftblase"}),
"Die schuetzt uns vor dem Wasser!\n", "sagt: ");

AI("wasser",
"Es kann heilen aber auch toeten!", "sagt: ");
AI(({"drache","unterwasserdrache","drachen"}),
"Hmm, niemals mit Feuer angreifen oder mit Wasser!", "sagt: ");
AI("creative",
"Der hat mich umgetauft!", "sagt: ");

AI("daemon",
"Hmm, ein mieser Typ!", "sagt: ");

AI("dante",
"Der hat mich erschaffen!", "sagt: ");
AI(({"blubbox","zwerg"}),
"Das bin ich!", "sagt: ");

SP(P_ARTICLE, 0);

  SetProp(P_NAME, "Blubbox");
  SetProp(P_GENDER, MALE);      

SP(P_DIE_MSG, " versinkt in den Tiefen.\n");

  SetProp(P_RACE, "Zwerg");
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 134); 
  SetProp(P_HANDS, ({" mit seinen starken Haenden", 130+random(50), DT_BLUDGEON}) );     

  SetProp(P_MSGIN, "kommt ploetzlich angeschwommen");
  SetProp(P_MSGOUT, "schwimmt an Dir vorbei");
  SetProp(P_MMSGIN, "schwimmt paddelnd hierher");
  SetProp(P_MMSGOUT, "schwimmt weit davon");

  SetProp( P_REJECT, ({ REJECT_DROP, "Blubbox hat daran kein Interesse.\n" }) );

   SP(P_SPELLRATE, 50);
  
  SUID;
  
  
  SetChats(3,({
"Blubbox sagt: Hmm, heute ist es wieder stuermisch!\n",
"Blubbox sagt: Huete Dich vor dem Unterwasserdrachen!\n",
"Blubbox sagt: Hmm, da war doch etwas...\n",
"Blubbox sieht sich die Luftblase an.\n",
"Blubbox sagt: Tja, da fragt man sich doch wirklich, was das soll...\n"
   }));
   
   
   
   
   AddSpell(5, 200,
   "Blubbox beisst Dir ins Bein!\n",
   "Blubbox beisst @WEM ins Bein!\n",
   DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 300,
   "Blubbox beisst Dir in den Arm!\n",
   "Blubbox beisst @WEM in den Arm!\n",
   DT_RIP, ([SP_SHOW_DAMAGE:1]));
   

  AddDefaultSpell(1, 300, DS_PARALYZE,
   "Blubbox packt Dich und klemmt Dich fest!\n",
   "Blubbox packt @WEN und klemmt @WEN fest!\n",
   ([SP_SHOW_DAMAGE:1]));


}
