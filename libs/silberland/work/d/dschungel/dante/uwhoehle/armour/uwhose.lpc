//dante, sl, unterwasserdrachen ausruestung
//eigentlich gleiche werte wie das sandzeugs aus der wueste nur eben wasser

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"
int bon=random(2);

create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId (({"UWA",  	
        "unterwasserhose","unterwasserdrachenhose","drachenhose", "hose"}));
  SetProp(P_SHORT, "Eine Unterwasserdrachenhose");
  SetProp(P_LONG, BS(
        "Die Unterwasserdrachenhose besteht aus Millionen kleinster Schueppchen, die "
        "im Laufe der Zeit zu einem undurchdringbaren Schutz wurden."));

  AD(({"schueppchen", "schutz"}),	
      "Sie sind mit freiem Auge nicht zu sehen.");

  SetProp(P_NAME, "Unterwasserdrachenhose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 740-bon*100);
  SetProp(P_VALUE, 2900+bon*1000);
  SetProp(P_NOBUY, 1);

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 9+bon);

  SetProp(P_MATERIAL, ([MAT_HORN:80, MAT_MISC_LIVING:20]));

  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 30]));

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2+bon,T_HEAT_PROT:2+bon]));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_WATER:1+bon]));
  SetProp("itemd_elemental_value", (["wasser": 2+2*bon]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:random(2)*random(7), P_SP:random(2)*random(7)]) );
  
}

_query_info()  {
  switch(bon)  {
    case 0:
      return BS(
          "Diese Hose ist ein ausgezeichneter Schutz!!!");
      break;
    case 1:
      return BS(
          "Diese Hose ist sogar fuer eine Unterwasserdrachenhose "
          "extrem gut! Ein sehr seltenes Exemplar!");
      break;
    default:
      return BS(
          "Diese Hose ist ein ausgezeichneter Schutz!!!");
  }
}	
