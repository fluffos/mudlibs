//dante, sl, unterwasserdrachen ausruestung
//eigentlich gleiche werte wie das sandzeugs aus der wueste nur eben wasser

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(ME)) return;
  ::create();

  AddId (({"UWA",
        "unterwasserstiefel","unterwasserdrachenstiefel",
        "drachenstiefel", "stiefel"}));

  SetProp(P_SHORT, "Ein Paar Unterwasserdrachenstiefel");
  SetProp(P_LONG,  BS(
        "Die Unterwasserdrachenstiefel besteht aus Millionen kleinster Schueppchen, die "
        "im Laufe der Zeit zu einem undurchdringbaren Schutz wurden."));

  AD(({"schueppchen", "schutz"}),	
      "Sie sind mit freiem Auge nicht zu sehen.");


  SetProp(P_NAME, "Paar Unterwasserdrachenstiefel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 240);
  SetProp(P_VALUE, 1233);
  SetProp(P_NOBUY, 1);

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 8);

  SetProp(P_MATERIAL, ([MAT_HORN:80, MAT_MISC_LIVING:20]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 30]));

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1,T_HEAT_PROT:3]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_WATER:1]));
  SetProp("itemd_elemental_value", (["wasser": 2+random(3)]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:random(2)*random(7), P_SP:random(2)*random(7)]) );

}
