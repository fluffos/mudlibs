//dante stiefel fuer daemonen

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"UWA", "flutwellenstiefel","stiefel","daemonenstiefel",
        "flutwellendaemonenstiefel", "flutwellendaemonstiefel"}));
  SetProp(P_SHORT, "Ein Paar Flutwellendaemonstiefel");
  SetProp(P_LONG, BS("Die Flutwellenstiefel gehoerten einst einem Flutwellendaemonen. "
                   "Er trug sie selbst zum Schutz vor seinen eigenen Flutwellen."));
  SetProp(P_NAME, "Flutwellendaemonstiefel");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_WEIGHT, 700);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_VALUE, 2500);
  SetProp(P_INFO, ("Die Flutwellenstiefel sind hervorragend.\n"));
  SetProp(P_ARMOUR_TYPE, AT_BOOT);  
  SetProp(P_AC, 9);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_WATER:1]));
  SetProp("itemd_elemental_value", (["wasser": 2+random(3)]) );

  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, A_INT:18]) );
}
