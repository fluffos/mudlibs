#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"
#define AD AddDetail
#define SP SetProp

inherit (WROOM+"/wroom");


void create()
{
  ::create();

  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,BS(
        "Du bist nun in einer Unterwasserhoehle, also vergiss nicht, dass Du "
        "hier kaum ewig atmen kannst. Das Wasser sprudelt wild um Dich herum, "
        "und die Gischt schaeumt wild. Einige gruene Unterwasserpflanzen "
        "werden schnell hin und hergespuelt. In der Decke, die nun recht weit ober" 
        " Dir ist, siehst Du das "
        "Loch, durch das der Wasserfall hereinstroemt."));

  AddDetail( ({ "gischt" }), 
      break_string( "Wild spritzt die Gischt umher.", 78 ) );
  AD(({"pflanze","pflanzen","unterwasserpflanzen","unterwasserpflanze"}),
      "Die Pflanzen kringeln sich wild herum.");
  AD(({"hoehle","wasserhoehle","unterwasserhoehle"}),
      "Die Hoehle ist voll und ganz mit Wasser ausgefuellt, das wild herumstroemt. "
      "Vielleicht wirst Du ja irgendwo hin mitgerissen...");
  AD("wasser",
      "Das Wasser ist brauenlich und man kann kaum etwas erkennen. Es stroemt "
      "wild umher und Du wirst wirst hin und hergeworfen.");
  AD("decke",
      "In der Decke ist das Loch, durch das der Wasserfall hereinstroemt. Es ist schon weit oben.");
  AD("wasserfall",
      "Er stuerzt von oben herab und verursacht diese wilde Stroemung.");
  AD("stroemung",
      "Frueher oder spaeter wird Dich die Stroemung irgendwo hinreissen...");
  AD("boden",
      "Den Boden der Hoehle kann man nicht erkennen. Die Gischt ist zu stark, "
      "das Wasser zu schmutzig.");
  AD(({"wand","waende"}),
      "Die Waende sind nicht zu sehen, doch Du kannst nach oben tauchen.");
  AD("loch",
      "Durch das Loch kommst Du nach oben! Aber von hier nicht!");
  AD(({"pflanze","pflanzen","unterwasserpflanzen","unterwasserpflanze"}),
      "Die Pflanzen kringeln sich wild herum.");

  AddSmell ( ({DEFAULT_SMELL}),
      "Hmm, das Wasser schmeckt schmutzig.");
  AddSound ( ({DEFAULT_SOUND, "wasser","wasserfall"}),
      "Das Wasser rauscht hier laut.");

  AddDiveExit("oben", "/d/dschungel/dante/uwhoehle/room/droom4");
  AddItem("d/dschungel/dante/uwhoehle/npc/flutdaemon", REFRESH_DESTRUCT);


}  

