// hoehle der steingiganten1

#include "/d/dschungel/dante/stein/room/files.h"

inherit "/d/dschungel/dante/stein/room/stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define AD AddDetail
create()
{
  ::create();

 AddDetail("boden", 
 "Am Boden ist ein enger Riss zu sehen.");
 AddDetail("riss",
 "Der Riss ist zu eng, da kommst Du nicht runter.");
 
 
 AddItem("/d/dschungel/dante/stein/npc/kagig" , REFRESH_DESTRUCT);

 AddExit( "oben", "/d/dschungel/dante/uwhoehle/room/bstartoben2");
AddDetail(({"loecher","loch"}),
"Diese Loecher sehen wie riesengrosse Bisspuren aus. Von wem die wohl alle "
" stammen? Eines der Loecher ist so gross, dass man es eigentlich als Durchbruch "
"bezeichnen koennte.");

AD("durchbruch",
"Es ist so gross, dass man ohne Probleme durch koennte. Doch dahinter siehst Du "
"tosende Wassermassen herabstuerzen.");
AD(({"wassermassen","massen"}),
"Dahinter fliesst ein unterirdischer Fluss. Man kommt dorthin, aber wie, hier sicher nicht; und "
"ob das gesund ist...");
AD("fluss",
"Er tost und bruellt hinter dem grossen Loch. Er scheint hier um eine Kurve zu biegen...");
AD("kurve",
"Von hier kaum zu erkennen.");

 
 }

     
           
           
 
 
 
 
