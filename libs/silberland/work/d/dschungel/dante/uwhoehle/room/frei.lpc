// hoehle der steingiganten1

#include "/d/dschungel/dante/stein/room/files.h"

inherit "/d/dschungel/dante/stein/room/stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail("boden", 
      "Am Boden ist eine Klappe zu sehen.");
  AddDetail("klappe",
      "Die Klappe fuehrt nach unten.");


  AddItem("/d/dschungel/dante/stein/npc/kagig" , REFRESH_DESTRUCT);

  AddExit( "oben", "/d/dschungel/dante/uwhoehle/room/frei2");

  AddCmd(({"oeffne","offnen"}), "raus");

}

int raus(string str)  {
  if(str=="klappe")  {

    if(present("gigant", TO) )  {
      write(BS(
            "Du versuchst die Klappe zu oeffnen, doch der Gigant "
            "haelt Dich auf."));
      return 1; 
    }

    write(BS(
          "Du versuchst die Klappe zu oeffnen, bist aber momentan "
          "noch zu erschoepft dazu!"));
    say(BS(
          CAP_TPN+" versucht eine Klappe zu oeffnen, ist aber zu schwach dazu!"));
    return 1; 
  }

}


