#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"
#define AD AddDetail
#define SP SetProp

inherit (WROOM+"/wroom");

int da=2+random(3);



int da;
init()  {
  ::init();
  if(interactive(TP))  {
    call_out("stroemung", 25+random(10) );
  }		
}

stroemung()  {
  object rue;

  if(!TP || TO!=environment(TP))  { return;  }

  rue=present("UWA", TP);

  if(rue && rue->QueryProp(P_WORN) )   {

    write(BS(""+rue->QueryProp(P_SHORT)+" verhindert, dass Du abgetrieben wirst."));

    say(BS(
          CAP_TPN+" kann der Stroemung auf magische Art und Weise entgehen!"));
    call_out("stroemung", 25+random(10));
    return;  

  }		
  write(BS(
        "Die Stroemung reisst Dich fort!"));
  say(BS(
        CAP_TPN+" kaempft mit der Stroemung!"));

  switch(random(3))  {
    case 0..1:
      TP->move("d/dschungel/dante/uwhoehle/room/droomdaemon", M_GO,
          "von der Stroemung nach unten getrieben","wird","wird von der Stroemung hier hergetrieben");	
      break;
    case 3:
      write(BS(
            "Mit Glueck kannst Du der Stroemung widerstehen!"));
      break;
    default:
      TP->move("d/dschungel/dante/uwhoehle/room/droomdaemon", M_GO,
          "von der Stroemung nach unten getrieben","wird","wird von der Stroemung hier hergetrieben");	
  }
  call_out("stroemung", 25+random(10));

}


void create()
{
  ::create();

  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,BS(
        "Du bist nun in einer Unterwasserhoehle, also vergiss nicht, dass Du "
        "hier kaum ewig atmen kannst. Das Wasser sprudelt wild um Dich herum, "
        "und die Gischt schaeumt wild. Einige gruene Unterwasserpflanzen "
        "werden schnell hin und hergespuelt. In der Decke, die nun recht weit ober" 
        " Dir ist, siehst Du das "
        "Loch, durch das der Wasserfall hereinstroemt."));

  AD( "gischt",
      "Die Gischt schaeumt wild.");
  AD(({"pflanze","pflanzen","unterwasserpflanzen","unterwasserpflanze"}),
      "Die Pflanzen kringeln sich wild herum.");
  AD(({"hoehle","wasserhoehle","unterwasserhoehle"}),
      "Die Hoehle ist voll und ganz mit Wasser ausgefuellt, das wild herumstroemt. "
      "Vielleicht wirst Du ja irgendwo hin mitgerissen...");
  AD("wasser",
      "Das Wasser ist brauenlich und man kann kaum etwas erkennen. Es stroemt "
      "wild umher und Du wirst wirst hin und hergeworfen.");

  AD("decke",
      "In der Decke ist das Loch, durch das der Wasserfall hereinstroemt. Es ist schon weit oben.");
  AD("wasserfall",
      "Er stuerzt von oben herab und verursacht diese wilde Stroemung.");
  AD("stroemung",
      "Frueher oder spaeter wird Dich die Stroemung irgendwo hinreissen...");
  AD("boden",
      "Den Boden der Hoehle kann man nicht erkennen. Die Gischt ist zu stark, "
      "das Wasser zu schmutzig.");
  AD(({"wand","waende"}),
      "Die Waende sind nicht zu sehen, doch Du kannst nach oben und unten tauchen.");
  AD("loch",
      "Durch das Loch kommst Du nach oben! Aber von hier nicht!");


  AD(({"pflanze","pflanzen","unterwasserpflanzen","unterwasserpflanze"}),
      "Die Pflanzen kringeln sich wild herum. Manche sehen wie kleine Tiere aus.");



  AD(({"tiere","tier"}),
      "Nein, Du musst Dich irren. Sie sehen nicht wie Tiere aus, eher wie "
      "wild-zerzauste Haare.");
  AD(({"haar","haare"}),
      "Zwischen diesen ganzen zerzausten Pflanzen treibt eine Knospe hin und her.");
  AddSpecialDetail("knospe", "get_knospe");


  AddSmell ( ({DEFAULT_SMELL}),
      "Hmm, das Wasser schmeckt schmutzig.");
  AddSound ( ({DEFAULT_SOUND, "wasser","wasserfall"}),
      "Das Wasser rauscht hier laut.");




  AddDiveExit("oben", "/d/dschungel/dante/uwhoehle/room/droom1");
  AddDiveExit("unten", "/d/dschungel/dante/uwhoehle/room/droomdaemon");
  AddItem("d/wasser/dante/zinsel/npc/shark", REFRESH_DESTRUCT);
  AddItem("d/dschungel/dante/uwhoehle/npc/muraene", REFRESH_DESTRUCT);


}  




get_knospe()  {
  object knospe;
  object hai;
  hai=present("hai", environment(TP));

  if(hai)  {
    write(BS(
          "Der Hai stoesst Dich weg!"));
    hai->Kill(TP);
    say(BS(
          CAP_TPN+" wird von einem Hai attackiert!"));
    return "\n"; }


    if(da > 0)  {	

      knospe=clone_object("/d/dschungel/feyaria/kueste/obj/kajubo");
      da--;
      knospe->move(TP, M_NOCHECK);
      write(BS(
            "Du nimmst die Kajuboknospe erfreut an Dich!"));
      return "\n";
    }

    else return BS(
        "Du willst die Knospe nehmen, doch die Gischt treibt sie immer wieder weg.");
}


reset()  {
  ::reset();
  da=2+random(3);
}


