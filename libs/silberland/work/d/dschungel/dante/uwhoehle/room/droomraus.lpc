#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"
#define AD AddDetail
#define SP SetProp
inherit (WROOM+"/wroom");

init()  {
  ::init();
  if(interactive(TP))  {
    call_out("stroemung", 25+random(10) );
  }		
}

stroemung()  {

  object rue;

  if(!TP || TO!=environment(TP))  { return;  }

  rue=present("UWA", TP);

  if(rue && rue->QueryProp(P_WORN) )   {

    write(BS(""+rue->QueryProp(P_SHORT)+" verhindert, dass Du abgetrieben wirst."));

    say(BS(
          CAP_TPN+" kann der Stroemung auf magische Art und Weise entgehen!"));
    call_out("stroemung", 15+random(10));
    return;  

  }	

  write(BS(
        "Die Stroemung reisst Dich fort!"));
  say(BS(
        CAP_TPN+" kaempft mit der Stroemung!"));

  switch(random(3))  {
    case 0..1:
      TP->move("d/dschungel/dante/uwhoehle/room/droom7", M_GO+M_NO_SHOW,
          "von der Stroemung nach Norden getrieben","wird","wird von der Stroemung hier hergetrieben");	
      break;
    case 3:
      write(BS(
            "Mit Glueck kannst Du der Stroemung widerstehen!"));
      break;
    default:
      TP->move("d/dschungel/dante/uwhoehle/room/droom7", M_GO+M_NO_SHOW,
          "von der Stroemung nach Norden getrieben","wird","wird von der Stroemung hier hergetrieben");	
  }
  call_out("stroemung", 25+random(10));

}



void create()
{
  ::create();


  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,BS(
        "Du bist nun in einer Unterwasserhoehle, also vergiss nicht, dass Du "
        "hier kaum ewig atmen kannst. Das Wasser sprudelt wild um Dich herum, "
        "und die Gischt schaeumt wild. Einige gruene Unterwasserpflanzen "
        "werden schnell hin und hergespuelt. Die Decke ist hier sehr niedrig "
        "und es scheint als bist Du in einem Seitenarm gelandet, der hier blind "
        "endet."));

  AD(({"arm","seitenarm"}),
      "Es scheint hier nicht weiter zugehen.");
  AD(({"pflanze","pflanzen","unterwasserpflanzen","unterwasserpflanze"}),
      "Die Pflanzen kringeln sich wild herum.");
  AD("decke",
      "Die Decke ist wirklich sehr niedrig. Du kannst eine Klappe erkennen.");
  AD("klappe",
      "Die Klappe ist geschlossen und fuehrt sicher in die Freiheit.");
  AD("freiheit",
      "Oeffne die Klappe!");


  AD("gischt",
      "Die Gischt schaeumt und wirbelt um Dich herum.");

  AD(({"hoehle","wasserhoehle","unterwasserhoehle"}),
      "Die Hoehle ist voll und ganz mit Wasser ausgefuellt, das wild herumstroemt. "
      "Vielleicht wirst Du ja irgendwo hin mitgerissen...");
  AD("wasser",
      "Das Wasser ist brauenlich und man kann kaum etwas erkennen. Es stroemt "
      "wild umher und Du wirst wild hin und hergeworfen.");
  AD("gischt",
      "Die Gischt schaeumt und wirbelt um Dich herum.");
  AD("wasserfall",
      "Er stuerzt von oben herab und verursacht diese wilde Stroemung.");
  AD("stroemung",
      "Frueher oder spaeter wird Dich die Stroemung irgendwo hinreissen...");
  AD("boden",
      "Den Boden der Hoehle kann man nicht erkennen. Die Gischt ist zu stark, "
      "das Wasser zu schmutzig.");
  AD(({"wand","waende"}),
      "Die Waende sind nicht zu sehen, zu trueb ist das Wasser. Aber Du kannst "
      "nach Norden schwimmen.");
  AD("norden",
      "Hmm, kann man nicht sehen was da so ist...");



  AddSmell ( ({DEFAULT_SMELL}),
      "Hmm, das Wasser schmeckt schmutzig.");
  AddSound ( ({DEFAULT_SOUND, "wasser","wasserfall"}),
      "Das Wasser rauscht hier laut.");

  AddItem("/d/dschungel/dante/weg/npc/kfisch" , REFRESH_DESTRUCT);
  AddItem("/d/dschungel/dante/weg/npc/cfisch", REFRESH_DESTRUCT);

  AddHiddenWaterExit("norden", 
      "nach Norden#/d/dschungel/dante/uwhoehle/room/droom7");

  AddCmd(({"oeffne","offnen"}), "raus");

}

int raus(string str)  {
  if(str=="klappe")  {

    if(present("fisch", TO) || present("hai", TO)|| present("muraene", TO) )  {
      write(BS(
            "Du versuchst die Klappe zu oeffnen, doch der Fisch "
            "haelt Dich auf."));
      say(BS(
            CAP_TPN+" will fluechten, doch ein Fisch haelt ihn auf."));
      return 1; 
    }


    if(TP->QueryProp(P_HP) < 20+random(10) )  {
      write(BS(
            "Du versuchst die Klappe zu oeffnen, bist aber momentan "
            "noch zu erschoepft dazu!"));
      say(BS(
            CAP_TPN+" versucht zu fluechten, ist aber zu schwach dazu!"));
      return 1; 
    }
    write(BS(
          "Du oeffnest die Klappe und kletterst behende nach oben!"));
    TP->move("/d/dschungel/dante/uwhoehle/room/frei", M_GO,
        "die Klappe, kletter nach oben und die Klappe faellt wieder zu", "oeffnet"	,
        "kommt durch die Klappe heraufgeklettert. Dann faellt die Klappe wieder zu");
    return 1;  
  } 

}

