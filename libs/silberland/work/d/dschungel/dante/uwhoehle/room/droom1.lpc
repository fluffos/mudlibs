#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"
#define AD AddDetail
#define SP SetProp
inherit (WROOM+"/wroom");

int da;
init()  {
  ::init();
  if(interactive(TP))  {

    call_out("stroemung", 45+random(10) );
  }	
}


stroemung()  {
  object rue;

  if(!TP || TO!=environment(TP))  { return;  }

  rue=present("UWA", TP);

  if(rue && rue->QueryProp(P_WORN) )   {

    write(BS(""+rue->QueryProp(P_SHORT)+" verhindert, dass Du abgetrieben wirst."));

    say(BS(
          CAP_TPN+" kann der Stroemung auf magische Art und Weise entgehen!"));
    call_out("stroemung", 35+random(10));
    return;  

  }	




  write(BS(
        "Die Stroemung reisst Dich fort!"));
  say(BS(
        CAP_TPN+" kaempft mit der Stroemung!"));

  switch(random(5))  {
    case 0..1:
      TP->move("d/dschungel/dante/uwhoehle/room/droom4", M_GO+M_NO_SHOW,
          "von der Stroemung nach unten getrieben","wird","wird von der Stroemung hier hergetrieben");	
      break;
    case 2..3:
      TP->move("d/dschungel/dante/uwhoehle/room/droom2", M_GO+M_NO_SHOW,
          "von der Stroemung nach Norden getrieben","wird","wird von der Stroemung hier hergetrieben");	
      break;	
    case 4:
      write(BS(
            "Mit Glueck kannst Du der Stroemung widerstehen!"));
      break;
    default:
      TP->move("d/dschungel/dante/uwhoehle/room/droom4", M_GO+M_NO_SHOW,
          "von der Stroemung nach untengetrieben","wird","wird von der Stroemung hier hergetrieben");	
  }
  call_out("stroemung", 35+random(10));

}



void create()
{
  ::create();
  da=3+random(3);


  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,BS(
        "Du bist nun in einer Unterwasserhoehle, also vergiss nicht, dass Du "
        "hier kaum ewig atmen kannst. Das Wasser sprudelt wild um Dich herum, "
        "und die Gischt schaeumt wild. Einige gruene Unterwasserpflanzen "
        "werden schnell hin und hergespuelt. In der Decke siehst Du das "
        "Loch, durch das der Wasserfall hereinstroemt. Im Osten siehst Du eine grosse, "
        "schimmernde Luftblase."));

  AD( ({"pflanzen", "pflanze", "unterwasserpflanze", "unterwasserpflanzen"}),
      "Einige gruene Unterwasserpflanzen wachsen hier.");
  AD("osten",
      "Da ist eine grosse, schimmernde Luftblase.");
  AD(({"blase","luftblase","luft"}),
      "Dahinter verbirgt sich etwas, betritt die Blase einfach...");
  AD("gischt",
      "Die Gischt schaeumt und wirbelt um Dich herum. Aus einer Spalte aus einem "
      "nahen Felsen stroemt eine merkwuerdige Fluessigkeit.");
  AD("spalte",
      "Sie ist sehr schmal.");
  AD("fluessigkeit",
      "Die Fluessigkeit ist dunkelblau und pulsiert.");
  AD("felsen",
      "Aus dem Felsen stroemt eine Fluessigkeit. Man kann sie sicher kosten.");

  AD(({"hoehle","wasserhoehle","unterwasserhoehle"}),
      "Die Hoehle ist voll und ganz mit Wasser ausgefuellt, das wild herumstroemt. "
      "Vielleicht wirst Du ja irgendwo hin mitgerissen...");
  AD("wasser",
      "Das Wasser ist brauenlich und man kann kaum etwas erkennen. Es stroemt "
      "wild umher und Du wirst wild hin und hergeworfen.");
  AD("gischt",
      "Die Gischt schaeumt und wirbelt um Dich herum.");
  AD("decke",
      "In der Decke ist das Loch, durch das der Wasserfall hereinstroemt.");
  AD("wasserfall",
      "Er stuerzt von oben herab und verursacht diese wilde Stroemung.");
  AD("stroemung",
      "Frueher oder spaeter wird Dich die Stroemung irgendwo hinreissen...");
  AD("boden",
      "Den Boden der Hoehle kann man nicht erkennen. Die Gischt ist zu stark, "
      "das Wasser zu schmutzig.");
  AD(({"wand","waende"}),
      "Die Waende sind nicht zu sehen, zu trueb ist das Wasser. Aber Du kannst "
      "nach unten tauchen und nach Norden schwimmen.");
  AD("loch",
      "Durch das Loch kommst Du nach oben!");
  AD("norden",
      "Hmm, kann man nicht sehen was da so ist...");



  AddSmell ( ({DEFAULT_SMELL}),
      "Hmm, das Wasser schmeckt schmutzig.");
  AddSound ( ({DEFAULT_SOUND, "wasser","wasserfall"}),
      "Das Wasser rauscht hier laut.");

  AddItem("/d/dschungel/dante/weg/npc/kfisch" , REFRESH_DESTRUCT);
  AddItem("/d/dschungel/dante/weg/npc/cfisch", REFRESH_DESTRUCT);



  AddWaterExit("oben","nach oben#/d/dschungel/dante/stein/room/stein6");


  AddHiddenWaterExit("norden", 
      "nach Norden#/d/dschungel/dante/uwhoehle/room/droom2");
  AddDiveExit("unten", "/d/dschungel/dante/uwhoehle/room/droom4");


  AddCmd(({"kost","koste","kosten"}), "koste");
  AddCmd(({"betritt","betreten","betrete"}), "go_o");

}

int go_o(string str)  {
  notify_fail("Was willst Du betreten?!\n");
  if(str=="blase"||str=="luftblase")  {
    write(BS(
          "Du paddelst in die Luftblase und schwupppppppp......"
          "wirst Du auch schon reingesaugt...."));

    TP->move("/d/dschungel/dante/uwhoehle/room/uwbar", M_GO,
        "in eine Luftblase und ist verschwunden","paddelt",
        "kommt hereingesaust");
    return 1;  
  }

  return 0; 
}



reset()  {
  ::reset();
  da=3+random(3);
} 


int koste(string str)  {
  notify_fail("Was willst Du kosten?!\n");

  if(str=="fluessigkeit"||str=="von fluessigkeit")  {

    write(BS(
          "Du kostest von der Fluessigkeit."));
    say(BS(
          CAP_TPN+" kostet von der Fluessigkeit."));

    if(da)  {
      da--;
      write(BS(
            "AHH!!! Herrlich! Deine Magie steigt!"));
      TP->AddSp(25+random(30));
      return 1;  
    }

    if(!da)  {

      write(BS(
            "Hmm, schmeckt gut, aber, hmm. Geduld!"));
      return 1;  
    }

    return 0;  
  }	  	 	
  return 0;  
}

