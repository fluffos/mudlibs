//dante sl 99-2000

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include <wizlevels.h>

#define NIX  if(environment(TP)!=TO || !TP) return 0;     


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem unterirdischen Fluss treibend" );
  SetProp( P_INT_LONG, BS(
        "Die Stroemung hat Dich nun in den unterirdischen Fluss mitgerissen. "
        "In wilder Fahrt geth es dahin, Gischt sprudelt um Dich herum, das "
        "Wasser peitscht in Dein Gesicht und Du hoffst, dass Du noch einmal "
        "lebend davon kommst..."));
  AddCmd ("", "no", 1);   

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}



int no()
{

  write (BS(
        "Daran solltest Du nicht denken, schau lieber, dass Du nicht absaeufst!"));
  return 1;
}


init()
{

  ::init();

  if(query_once_interactive(this_player())){
    call_out("a1", 2);}
}


a1()
{
  NIX
    write("WOW!!! Die Stroemung reisst Dich sofort mit sich!!!\n\n");
  call_out("a2", 2);
}

a2()
{NIX
  write("In wilder Fahrt geht es unter Wasser dahin!\n\n");
  call_out("a3", 2);
}

a3()
{ NIX  
  write("Die Gischt spritzt auf und nieder!\n\n");
  call_out("a4", 3);
}

a4()
{NIX
  write("Das Wasser wirbelt Dich wild umher! Hilfe Luft!\n\n");

  call_out("a5", 2);
}     

a5()
{
  NIX
    write("Du wirst wild nach oben geschwemmt, dann wieder nach unten!\n\n");
  call_out("a6", 2);
}

a6()
{NIX
  write("Du wirst direkt auf einen Felsen zugetrieben!\n\n");
  call_out("a7", 2);
}

a7()
{NIX

  write("WAH!!! Fast waerst Du am Felsen zerquetscht worden!\n\n");

  call_out("a8", 2);
}    


a8()
{NIX
  write("Weiter geht die wilde Fahrt!\n\n");
  call_out("a9", 2);
}

a9()
{NIX
  write("PLATSCH!!! Die Gischt trifft Dich voll im Gesicht!\n\n");
  call_out("a11", 2);
}


a11()
{
  NIX
    write("Ein dunkler Schatten naehert sich Dir schnell! PANIK!!!\n\n");
  call_out("a21", 2);
}



a21(){
  NIX
    write(
        "Der Strudel schleudert Dich hin und her, Dein Kopf schlaegt gegen Felsen!\n\n");
  call_out("a22", 2);
}

a22()   { 
  NIX
    write(BS(
        "Ploetzlich macht der unterirdische Fluss eine rasante Kurve und Du wirst aus der Kurve geschleudert. "
        "Du saust direkt auf die Felswand zu, hast aber Glueck und fliegst genau durch ein "
        "Loch irgendwohin...\n"));

  call_out("weg", 2);
}

weg()
{
  tell_room("d/dschungel/dante/uwhoehle/room/bstartoben1",
      CAP_TPN+" wird mit einer grossen Wasserfontaene durch ein Loch in der Wand "
      "hereingeschleudert.\n");

  TP->move("d/dschungel/dante/uwhoehle/room/bstartoben1",M_GO
      +M_SILENT+M_NO_SHOW);

}



BecomesNetDead(object pl)  {
  pl->move("/d/dschungel/dante/stein/room/stein15",M_GO+ M_SILENT+
      M_NO_SHOW);
  return 1;
}



