#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"
#define AD AddDetail
#define SP SetProp
#define UWHOEHLE "/d/dschungel/dante/uwhoehle/"

inherit (WROOM+"/wroom");

int da;
init()  {
  ::init();
  if(interactive(TP))  {
    call_out("stroemung", 35+random(10) );
  }		
}

stroemung()  {
  object rue;

  if(!TP || TO!=environment(TP))  { return;  }

  rue=present("UWA", TP);

  if(rue && rue->QueryProp(P_WORN) )   {

    write(BS(""+rue->QueryProp(P_SHORT)+" verhindert, dass Du abgetrieben wirst."));

    say(BS(
          CAP_TPN+" kann der Stroemung auf magische Art und Weise entgehen!"));
    call_out("stroemung", 35+random(10));
    return;  

  }		




  write(BS(
        "Die Stroemung reisst Dich fort!"));
  say(BS(
        CAP_TPN+" kaempft mit der Stroemung!"));

  switch(random(3))  {
    case 0..1:
      TP->move("d/dschungel/dante/uwhoehle/room/droom6", M_GO,
          "von der Stroemung nach Westen getrieben","wird","wird von der Stroemung hier hergetrieben");	
      break;
    case 3:
      write(BS(
            "Mit Glueck kannst Du der Stroemung widerstehen!"));
      break;
    default:
      TP->move("d/dschungel/dante/uwhoehle/room/droom6", M_GO,
          "von der Stroemung nach Westen getrieben","wird","wird von der Stroemung hier hergetrieben");	
  }
  call_out("stroemung", 35+random(10));

}



void create()
{
  ::create();

  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,BS(
        "Du bist nun in einer Unterwasserhoehle, also vergiss nicht, dass Du "
        "hier kaum ewig atmen kannst. Das Wasser sprudelt wild um Dich herum, "
        "und die Gischt schaeumt wild. Einige gruene Unterwasserpflanzen "
        "werden schnell hin und hergespuelt. Die Stroemung zieht hier deutlich "
        "nach Westen."));

  AD("westen",
      "Du kannst nicht sehen was da ist..."); 


  AD(({"pflanze","pflanzen","unterwasserpflanzen","unterwasserpflanze"}),
      "Die Pflanzen kringeln sich wild herum.");


  AD(({"hoehle","wasserhoehle","unterwasserhoehle"}),
      "Die Hoehle ist voll und ganz mit Wasser ausgefuellt, das wild herumstroemt. "
      "Vielleicht wirst Du ja irgendwo hin mitgerissen...");
  AD("wasser",
      "Das Wasser ist brauenlich und man kann kaum etwas erkennen. Es stroemt "
      "wild umher und Du wirst wild hin und hergeworfen.");
  AD("gischt",
      "Die Gischt schaeumt und wirbelt um Dich herum.");
  AD("decke",
      "Die Decke ist hier kaum zu erkennen.");
  AD("wasserfall",
      "Er stuerzt von oben herab und verursacht diese wilde Stroemung.");
  AD("stroemung",
      "Frueher oder spaeter wird Dich die Stroemung irgendwo hinreissen...");
  AD("boden",
      "Den Boden der Hoehle kann man nicht erkennen. Die Gischt ist zu stark, "
      "das Wasser zu schmutzig.");
  AD(({"wand","waende"}),
      "Die Waende sind nicht zu sehen, zu trueb ist das Wasser. Aber Du kannst "
      "nach Westen schwimmen. Nach oben ist die Stroemung sehr stark!");
  AD("oben",
      "Hmm, kann man nicht sehen was da so ist. Die Gischt ist zu stark...");


  AddSmell ( ({DEFAULT_SMELL}),
      "Hmm, das Wasser schmeckt schmutzig.");
  AddSound ( ({DEFAULT_SOUND, "wasser","wasserfall"}),
      "Das Wasser rauscht hier laut.");

  AddItem( ({"d/wasser/dante/zinsel/npc/shark",
        "d/wasser/dante/zinsel/npc/stdfisch"}),
      REFRESH_DESTRUCT);



  AddCmd(({"schwimme","schwimm","tauch","tauchen","tauche","schwimmen"}), "nix");
}


int nix(string str)  {
  notify_fail("Wohin?!\n");
  if(str=="oben"||str=="rauf"||str=="hinauf"||str=="nach oben"||
      str=="auf" )  {
    if(random(3))  {
      write(BS(
            "Du versuchst nach oben zu gelangen, doch die Stroemung ist "
            "zu stark. Versuchs weiter!"));
      say(BS(
            CAP_TPN+" versucht nach oben zu gelangen, doch die Stroemung ist zu stark."));
      return 1;  
    }

    else

      write(BS(
            "Du schwimmst gegen die sehr starke Stroemung nach oben!"));
    TP->move("/d/dschungel/dante/uwhoehle/room/droom2", M_GO,
        "nach oben","schwimmt","kommt heraufgeschwommen");       
    return 1;  
  }

  if(str=="nach westen" )  {

    write(BS(
          "Du schwimmst nach Westen!"));
    TP->move("/d/dschungel/dante/uwhoehle/room/droom6", M_GO,
        "nach Westen","schwimmt","kommt hereingeschwommen");       
    return 1;  
  }
  return 0;
}

