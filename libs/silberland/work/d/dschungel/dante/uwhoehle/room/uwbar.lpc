
/*
   kneipe dante&sl 99
   uwkneipe
   ne exakte kopie der zombiekneipe

*/

#include "/players/dante/myowndefine.h"

inherit "std/pub";
#include <pub.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <mnpc.h>


create()
{
  ::create();


  SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "blubbox");
  SetProp(P_PUBKEEPER_NAME, "Blubbox");
  SetProp(P_PUBMSG_NOKEEPER, "Sorry, aber Blubbox ist nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
        "Blubbox serviert DIR hoechstens den Tod!"));

  SetProp(P_PUBMSG_NOINVITE, BS(
        "Blubbox serviert Dir sicher nichts!"));
  SetProp(P_PUBMSG_FIGHTING, "Blubbox ist doch beschaeftigt!!!\n");

  SP(P_INT_SHORT, "In einer Luftblase");

  AddExit ("westen", "./droom1");
  AIT("d/dschungel/dante/uwhoehle/npc/lubb", REFRESH_DESTRUCT);

  SetProp( P_INT_LONG, BS(
        "Du bist nun in der grossen, schimmernden Luftblase und staunst nur mehr! "
        "Hier ist eine Kneipe! Und zwar die von Blubbox, dem mutierten Zwerg! "
        "In Mitten all des Wassers und der Gischt gibt es eine "
        "Kneipe. Sie wird von der Luftblase umhuellt und geschuetzt und scheint recht "
        "sicher zu sein. Stuehle, Theke oder Tische, sowas siehst Du hier nicht. "
        "Du kannst jederzeit nach Westen hinaus..."));  

  SetProp( P_INDOORS, 1 );

  AD(({"blase","luftblase"}),
      "Sie wirkt von hier noch viel groesser, direkt gemuetlich und sicher.");
  AD("kneipe",
      "Eine aeusserst ungewoehnliche Kneipe!");
  AD("mitten",
      "Die Luftblase schuetzt Dich hier vor dem tobenden Wasser!");
  AD("wasser",
      "Hier ist es trocken, draussen aber wuetet die Gischt.");
  AD("gischt",
      "Hmm, leider musst Du wieder raus...");
  AD(({"boden","wand","waende","decke"}),
      "Alles Luftblase, genauer ihre Haut.");
  AD("haut",
      "Hmm, zaeh und doch durchsichtig, hart und doch nachgiebig!");
  AD("westen",
      "Da geht es hinaus ins Wasser.");
  AD(({"stuehle","stuhl","theke","tisch","tische"}),
      "Hmm, seltsam. Hier gibts es ueberhaupt nichts. Woher Blubbox sein Angebot nimmt...");
  AD("angebot",
      "Hmm, naja wenn es in einer Luftblase eine Kneipe geben kann, dann kann das auch sein.");


  AddSmell(DEFAULT_SMELL,
      "Hmmm, nichts,....");

  AddSound(DEFAULT_SOUND,
      "Gurgel, rausch, zisch....\n");


  AD(({"Blubbox","zwerg"}),
      "Na der wohnt und arbeitet hier!");


  AddDrink("Sprudelwasser", ({"wasser", "sprudelwasser","sprudel"}),
      45, 10, 0, 5, 
      ({"Du trinkst ein dreckiges Sprudelwasser.",
       "&& trinkt ein dreckiges Sprudelwasser."}));



  AddDrink("Sprudelbier", ({"bier", "sprudelbier"}),
      120, 25, 3, 5, 
      ({"Du trinkst ein kuehles Sprudelbier.",
       "&& trinkt ein kuehles Sprudelbier."}));


  AddDrink("Feiglingswasser", ({"feiglingswasser", "wasser", "feigling"}),
      190, 30, 0, 9,
      ({"Du bestellt Dir ein Feiglingswasser und bekommst eine warme Milch "
       "in einer Tasse serviert auf der Mamis Liebling steht.",
       "&& bestellt sich ein Feiglingswasser und jammert dabei aengstlich."}));


  AddDrink("Haikiller", ({"killer", "haikiller"}),
      450, 50, 0, 14,
      ({"Du trinkst einen Haikiller. WOW!! Das Zeug geht ab!",
       "&& trinkt einen Haikiller und schaut dann mordluestern."}));


  AddDrink("Brennender Wassertod",({"wassertod","tod"}),
      550, 100, 32, 1,
      ({"Du bekommst einfach einen grossen Topf brennenden Wassers. "
       "Du trinkst den Topf leer, verbrennst Dir hoellisch die Zunge "
       "und weisst nun warum das Getraenk brennend genannt wird.",
       "&& bestellt sich ein brennendes Wasser, trinkst es und hat danach einen "
       "hochroten Kopf und eine verbrannte Zunge."}));


  AddDrink("Muraenen Mix", ({"muraenenmix","mix","muraene","muraenen"}),
      2400, 150, 17, 17,
      ({"Du bekommst einen grossen Krug, der randvoll gefuellt ist mit "
       "schwarzem, dickfluessigem Blut der verschiedensten Muraenen. "
       "Du ekelst Dich, trotzdem schuettest Du es in Dich hinein und "
       "fuehlst Dich danach sehr stark.",
       "&& trinkt mit Ekel und Grausen einen grossen Krug, der randvoll "
       "mit sprudelblut ist."}));



  //FOOOOOOOOOOODDDD

  AddFood ( "Fischbrot", ({"brot", "fischbrot", 
        }),  60, 10, 3,
      ({"Du bestellst Dir ein Fischbrot.",
       "&& bekommt ein Fischbrot. "}));


  AddFood ( "Haiauge", ({"auge", "haiauge", 
        }),  140, 25, 7,
      ({"Du bestellst Dir ein Haiauge und bekommst eine schleimige, "+
       "glitschrige Kugel serviert. Du wuergst das Auge runter und musst Dich "+
       "fast uebergeben.",
       "&& bekommt eine schleimige, glitschrige Kugel serviert, die && nur "
       "unter Wuergen vertilgt."}));

  AddFood ( "Wasserkuchen", ({"kuchen", "wasserkuchen", 
        }),  150, 20, 6,
      ({"Du bestellst Dir ein Stueck Wasserkuchen, das so leicht ist, "+
       "dass es Dir fast wieder aus dem Magen heraufschwebt.",
       "&& bekommt ein Stueck Wasserkuchen. "}));

  AddFood ( "Muraenenhirn", ({"hirn", "muraenenhirn"}), 
      230, 35, 10,
      ({"Du bekommst ein halbes Muraenenhirn, dass erstaunlicherweise "+
       "koestlich schmeckt.",
       "&& bekommt ein halbes Muraenenhirn. "}));


  AddFood ( "Toter Unterwasserdrache", ({"toter drache", "drache","unterwasserdrache"}), 
      450, 50, 13,
      ({"Du bestellt einen toten Drachen und erhaeltst tatsaechlich einen "
       "ganzen, wenn auch kleinen gebackenen Drachen, denn Du mit grosser "
       "Muehe verschlingst.",
       "&& bestellt sich eine ganzen, wenn auch kleinen toten Drachen, den "
       "&& mit Muehe tatsaechlich alleine verschlingt."}));


  AddFood ( "Hai a la Surprise", ({"hai","surprise", "surpris"}), 
      3000, 122,26 ,
      ({"Du bekommst den Hai a la Surprise und bist sehr enttaeuscht. "
       "Die Ueberraschung besteht aus einem kleinen Marzipanhai, der nicht einmal "
       "gut schmeckt...",
       "&& bestellt sich einen Hai a la Surprise."}));

  AddFood ( "Zordans Unterwassersteak(spezial)", ({"steak", "zordans","unterwassersteak"}), 
      333, 0, 0 ,
      ({
       "Du bestellst Zordans Unterwassersteak. Zordan kommt herein, hat ein grosses Steak und "
       "einen grossen Bottich voller Wasser bei sich. Er steckt seinen Kopf in den Bottich, und "
       "versucht dann verzweifelt das Steak unter Wasser zu essen. Nach einiger Zeit zappelt er "
       "und es blubbert wild im Bottich. Dann strampelt er wie wild und ploetzlich haengt "
       "er nur mehr regungslos am Bottich. Woody kommt herein und lacht ueber Zordan. "
       "Dann wird Zordan von 6 Elfen weggetragen und irgendwoe reanimiert. Hmm, er hat seinen Mund "
       "wohl etwas zu voll genommen. Hmm, Illusion ? Was war das?! Dann ist alles wieder wie vorhin!",    
       "&& bestellt sich Zordans Unterwassersteak. "
       "Zordan kommt herein, hat ein grosses Steak und "
       "einen grossen Bottich voller Wasser bei sich. Er steckt seinen Kopf in den Bottich, und "
       "versucht dann verzweifelt das Steak unter Wasser zu essen. Nach einiger Zeit zappelt er "
       "und es blubbert wild im Bottich. Dann strampelt er wie wild und ploetzlich haengt "
       "er nur mehr regungslos am Bottich. Woody kommt herein und lacht ueber Zordan. "
       "Dann wird Zordan von 6 Elfen weggetragen und irgendwoe reanimiert. Hmm, er hat seinen Mund "
       "wohl etwas zu voll genommen. Hmm, Illusion ? Was war das?! Dann ist alles wieder wie vorhin!"
       "&& bestellt sich Zordans Unterwassersteak. "
       }));



}
