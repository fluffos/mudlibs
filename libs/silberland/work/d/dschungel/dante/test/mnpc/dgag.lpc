// hahahah

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "files.h"
#include <mnpc.h>
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, BS(
    0));
  SetProp(P_NAME, "Gag");
  SetProp(P_GENDER, MALE);
  AddId(({"gag", "witz",}));

  create_default_npc(20);
  SetProp(P_HANDS, ({"",1,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 400);
  SetProp(P_MAX_SP, 1000);
  SetProp(P_BODY, 100);
  SetProp(P_INVIS, 1);
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "");
  SetProp(P_MSGOUT, "");
  SetProp(P_MMSGIN, "");
  SetProp(P_MMSGOUT, "");

  SetProp(P_DIE_MSG,  "");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  
  SetProp(P_MNPC_WAIT, ({10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM"d/ebene/Midas/room/kneipen");
  SetProp(P_MNPC_AREA, ROOM "room");
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES); 
  
  
  SUID;
  CLONEME(OBJ"furz");
 }
 init()
{ 
 ::init();
   
    
    
   clone_object(OBJ"furz")->move(TP, M_NOCHECK);
  }  