//unsinn is ja ne passionsfrucht....
//leuchtete wenn man sie mit wuermern vollstopft....
//je mehr wuermer desto hoeherer lichtlevel
//irgendwann is die frucht dann wegefressen
// wer die frucht ist mit wuermern drin bekommt wurmbefallhmm mal sehn
//veraendert am 30.5.98

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"
#define CAP_TPN capitalize(this_player()->name())

int wurm, hohl, count;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine ganz spezielle Passionsfrucht");
  
  SetProp (P_LONG, BS(
      "Die Passionsfrucht ist eine der leckersten und schoensten Fruechte " 
      "des ganzen Dschungels. Natuerlich hat sie Dante gezuechtet, der ja "  
      "im ganzen Silberland fuer seinen exzellenten frukalen Geschmack "
      "beruehmt und geliebt ist.\n"));      
  
  wurm=0;
  hohl=0;
  count = 0;
                                                                          
  SetProp (P_NAME, "Passionsfrucht");
  SetProp (P_GENDER, FEMALE);
  AddId (({"passionsfrucht", "frucht", "\nplantangenfrucht"}));
  SetProp (P_INFO, ("Die Passionsfrucht leuchtet im Dunklen wenn man sie "
  "mit bestimmen Tieren besiedelt. Dazu muss man sie aushoehlen, dann die "
  "Tiere, "
  "nein, weder Balrog noch Rok, reinstopfen. Mit untersuche Wurmbestand kannst "
  "Du nachsehen wieviele Lichtwuermer bereits in dieser Frucht sind.\n"));
  SetProp(P_LIGHT, 0);
  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FRUIT);
  SetProp (P_FOOD_INFO, ([F_HEAL: 15, F_SOAK: 10, F_ALCOHOL: 0, F_POISON:0]));
  AddSpecialDetail(({"wurmbestand"}), "d_worm");
    
  
  AddCmd(({"hoehle", "hoehl"}), "loch");
  AddCmd(({"stopfe","stecke","stopf","steck"}), "putin");
   }
  
  string d_worm()
   {
   if (!wurm)
      {
   return("Du siehst in dieser Passionsfrucht keine Wuermer!\n");
      }
   if (wurm==1)
       {
   return("Du siehst einen Lichtwurm in dieser Passionsfrucht!\n");
      }
   if(wurm>1)
      {
   return("Du siehst "+wurm+" Wuermer in dieser Passionsfrucht!\n");
      }
  }
   
   
  putin(string str)
      {
      
      object wu;
      object sp;  
      notify_fail("Was willst Du wohinein stopfen?\n");
      if (!str) return 0;
      
if((member(({"wurm in frucht","lichtwurm in frucht","wurm in passionsfrucht",
  "lichtwurm in passionsfrucht"}),str)!=-1)&&(!hohl)&&(present("lw2", TP)))      
      {
      write("Bevor Du den armen Lichtwurm noch an der Frucht zerquescht, "
      "solltest Du sie zuerst einmal aushoehlen!\n");
      say(""+TPN+" quaelt arme, unschuldige Lichtwuermer.\n");
      return 1;
      }
      
if((member(({"wurm in frucht","lichtwurm in frucht","wurm in passionsfrucht",
  "lichtwurm in passionsfrucht"}),str)!=-1)&&(!hohl)&&(!present("lw2", TP)))      
   {
   write("Du hast weder einen Lichtwurm zum in die Frucht stopfen, noch "
   "hast Du die Passionsfrucht ausgehoehlt.\n");
   say(""+TPN+" macht wieder nur Unsinn!\n");
   return 1;
   }
      
if((member(({"wurm in frucht","lichtwurm in frucht","wurm in passionsfrucht",
  "lichtwurm in passionsfrucht"}),str)!=-1)&&(hohl)&&(!present("lw2", TP)) )     
    {
    write("Du hast die Frucht zwar ausgehoehlt, aber keinen Lichtwurm "
    "zum hineinstopfen!\n");
    say(""+TPN+" ist voellig wurm und ahnungslos.\n");
    return 1;
    }
    
      
if((member(({"wurm in frucht","lichtwurm in frucht","wurm in passionsfrucht",
  "lichtwurm in passionsfrucht"}),str)!=-1)&&(hohl)&&(present("lw2", TP)))      
   {
  
  
   
   if ((!wurm)||(wurm==1))
   {
   wu=present("lw2", TP);
   wu->remove(1);
   wurm++;
    
  say(""+TPN+" stopft einen Lichtwurm in die Passionsfrucht!\n");
   
   write("Du stopfst den Lichtwurm vorsichtig in die ausgehoehlte "
   "Passionsfrucht, aber es passiert nichts. Scheinbar benoetigst Du mehr "
   "Lichtwuermer!\n");
    SetProp (P_SHORT, "Eine Passionsfrucht (ausgehoehlt, Wuermer: "+wurm+")");
   
   return 1;
   }
  
   if ((wurm== 2 ) || (wurm == 3) ||(wurm==4))
   {
   wu=present("lw2", TP);
   wu->remove(1);
   wurm++;
    SetProp(P_VALUE, 500);
    SetProp(P_NOBUY, 1);
  say(""+TPN+" stopft einen Lichtwurm in die Passionsfrucht!\n");
   
   write("Du stopfst den Lichtwurm vorsichtig in die ausgehoehlte "
   "Passionsfrucht. Sofort leuchtet die Frucht hell auf.\n");
   SetProp(P_LIGHT, 1);
    SetProp (P_SHORT, "Eine Passionsfrucht (ausgehoehlt, Wuermer: "+wurm+")");
   
   return 1;
   }
   
   
   if ((wurm ==5 )||(wurm == 6)||(wurm==7))
   {
   SetProp(P_VALUE, 1000);
   SetProp(P_NOBUY, 1);
   wu=present("lw2", TP);
   wu->remove(1);
   wurm++;
    say(""+TPN+" stopft einen Lichtwurm in die Passionsfrucht!\n");
    SetProp (P_SHORT, "Eine Passionsfrucht (ausgehoehlt, Wuermer: "+wurm+")");

   write("Du stopfst den Lichtwurm vorsichtig in die ausgehoehlte "
   "Passionsfrucht. Sofort leuchtet die Frucht extrem hell auf.\n");
   SetProp(P_LIGHT, 2);
   
   return 1;
        }
        
   
   if(wurm ==8)
   {
   SetProp(P_VALUE, 3000);
   SetProp(P_NOBUY, 1);
   wu=present("lw2", TP);
   wu->remove(1);
   wurm++;
    say(""+TPN+" stopft einen Lichtwurm in die Passionsfrucht!\n");
    SetProp (P_SHORT, "Eine Passionsfrucht (ausgehoehlt, Wuermer: "+wurm+")");
  
   write("Du stopfst den Lichtwurm vorsichtig in die ausgehoehlte "
   "Passionsfrucht. Sofort blitzt ein gigantischer Lichtbogen von der Frucht "
   "auf!\n"
   "Du solltest besser keinen Wurm mehr in diese Frucht stopfen!\n");
   SetProp(P_LIGHT, 10);
   return 1;
        }
   
     if(wurm == 9)
         {
          wu=present("lw2", TP);
          wu->remove(1);
   write("Du hast die Warnung missachtet!\n"
   "Du stopfst noch einen Wurm in die Passiomsfrucht und ploetzlich "
   "beginnt es in\nder Frucht zu brodeln und zu blitzen!!!\n"
   "Ein heller Lichtblitz blendet Dich und Deine Augen schmerzen sehr!\n"
   "WUMMMMMMMMMMMMMM!!!!!!!!!Die Frucht explodiert in Deinen Haenden!\n");
  // TP->do_damage(random(10)+10);
   say(CAP_TPN+" stopft zu viele Wuermer in eine Passionsfrucht.\n"
   "Die Frucht explodiert und "+CAP_TPN+" erblindet. Auch Du bekommst "
   "einiges von der Explosion ab! Bedank Dich bei "+CAP_TPN+"!\n");
   call_out("dam", 0);
   TP->SetProp(P_BLIND, 200);
   return 1;
        }
     return 0;
       }
    return 0;
    }
  
void dam()
  {
  int i;
  object *inv;
inv=all_inventory(environment(TP));
    for(i=sizeof(inv)-1;i>=0;i--) if(living(inv[i]))
 inv[i]->reduce_hit_point(random(30)+30);
 write_file("/d/dschungel/dante/weg/log/frucht_expl",
   ctime()+": "+capitalize(getuid(PL))+" laesst die PFrucht explodieren.\n");    
   TO->remove(1);
   }
                          
//aushoehlen

  loch(string str)
     {
    notify_fail("Was willst Du aushoehlen?\n");
    if (!str)
            {
            say(""+TPN+" ist ein Hohlkopf.\n");
            write("Was fuer eine Hoehle? Meinst Du die leere Hoehle die Du "
            "Deinen Kopf nennst?\n");
            return 1;
            }
  
  if((member(({"frucht aus", "passionsfrucht aus"}),str)!=-1)&&(!hohl))
            {
    write("Du hoehlst die Passionsfrucht aus.\n");
    say(""+TPN+" hoehlt eine Passionsfrucht aus.\n");
  SetProp(P_SHORT, "Eine Passionsfrucht (ausgehoehlt)");
  SetProp (P_LONG, BS(
      "Die Passionsfrucht ist eine der leckersten und schoensten Fruechte " 
      "des ganzen Dschungels. Natuerlich hat sie Dante gezuechtet, der ja "  
      "im ganzen Silberland fuer seinen exzellenten frukalen Geschmack "
      "beruehmt und geliebt ist. Diese Passionsfrucht ist ausgehoehlt.\n"));
      hohl++;      
        return 1;
         }
         
         
         
  if((member(({"frucht aus", "passionsfrucht aus"}),str)!=-1)&&(hohl))
         {
     write("Aber diese Passionsfrucht ist ja bereits ausgehoehlt, "
         +"Du Hohlkopf!\n");
     say(""+TPN+" ist ein Hohlkopf!\n");
     return 1;
        }
    return 0;
    }
          
            
BeimEssen()
{  
   if(!wurm)
   {
  write ("Du isst die Passionsfrucht mit grossem Genuss.\n");
  say (TPN+" verspeisst die Passionsfrucht mit grossem Genuss.\n");
  return ::BeimEssen(); 
    }
  if (wurm)
    {
  write("Baeh!!! Es war nicht klug die mit Wuermen ausgestopfte Frucht zu "
      +"essen!\n");
  TP->AddPoison(wurm);  
  return ::BeimEssen();
     }
  }

void reset()
   {
   ::reset();
   if (count==60 - wurm*2) //je mehr wuermer desto schneller
     {
     write("Die Passionsfrucht verfault.\n");
     TO->remove();
     }
     else
        {
     count++;
        }
     }
     
