// dante@SilberLand

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Mini, die Minischnecke");
  SetProp(P_LONG, BS(
  "Das ist Mini, eine sehr kleine Schecke, die hier als Wirtin arbeitet."));
  SetProp(P_NAME, "Mini, die Minischnecke");
  SetProp(P_GENDER, FEMALE);
  AddId(({"minischnecke", "mini"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(8);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit ihrem schleimigen Schwanz",160,DT_ACID}));
  SetProp(P_MAX_HP, 200);
  SetProp(P_BODY, 30);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  set_living_name("mini");
  
  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht herein");
  SetProp(P_MMSGOUT, "kriecht");
  
  
  AddInfo("kneipe",
  "Da lebe und arbeite ich!","sagt: ");
  AddInfo("schnecke",
  "Tja, ich bin eine.", "sagt: ");
  AddInfo("haus",
  "Ich habe eines am Ruecken.","sagt: ");
  AddInfo("tausendfuessler",
  "Zaehl mal seine Beine ab!", "sagt: ");
  AddInfo("dschungel",
  "Da leben wir!", "sagt: ");
  AddInfo("schneckenhaus", 
  "Hmmm, ich hab eines und leben in einem...","sagt: ");
  AddInfo("kiste",
  "lacht freundlich und sagt: Tja, ich verrate nichts!\n");
    
  SetProp(P_DIE_MSG,  " kruemmt sich sterbend zusammen!\n");
  
  AddInfo(DEFAULT_INFO, "sagt: Bestell lieber ne Keule!\n");
  AddInfo("dante", "Dante, hmm, der war mal mein bester Gast.","sagt: ");
  AddInfo("wuschel", "UI! Die hat eine lustige Nase!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Mini sagt: Danke...\n" }) );

  SetProp(P_SPELLRATE,60);
  
  AddSpell(3,150,
    "Mini schleimt Dich voll.\n",
    "Mini schleimt @WEN voll.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,250,
    "Mini schleudert Dir Schneckendreck ins Auge.\n",
    "Mini schleudert @WEM Schneckendreck ins Auge.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
  "Mini sagt: Was darfs sein?\n",
  "Mini krammt herum.\n",
  "Mini kriecht umher.\n",
  "Mini schleimt herum.\n",
  "Du musterst MIni genau!\n",
  "Mini sagt: Schoener Tag heute...\n",
  "Mini sagt: Trink was!\n",
  "Mini sagt: Probieren Sie unsere Keulen!\n"}));
    

   SUID;
   
   ob=clone_object("/d/dschungel/dante/armour/minih");
   ob->move(TO, M_NOCHECK);
   
   
   command("zieh alles an");  
  
  
  } 

void init()
{
  ::init();
    if(interactive(TP)) call_out("hallo",0);
    }                


  void hallo()
  {
   command("emote sagt freundlich: "+ TP->name(RAW) +", willkommen im Schneckenhaus!\n");
   }


  die(arg)
  {
  object ob;
  ob=clone_object("/d/dschungel/dante/weg/npc/wae.lpc");
  ob->move(environment(TP), M_TPORT);
  ob->Kill(TP);
  ::die(arg);
  }
   
   