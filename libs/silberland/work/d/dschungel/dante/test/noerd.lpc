//noerds geist

inherit "std/mnpc";


#include <mnpc.h>    
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Der Geist von Noerd");
  SetProp(P_LONG, BS(
   "Das ist also der Geist von Noerd, den Du solange gesucht hast, Beeindruckend "
   "sieht er ja nicht gerade aus. Klein, schwach. Aber welcher Geist, der hier "
   "eingesperrt ist ohne seine Geisterfreunde, waere schon in besserer Form. "
   "Ueberhaupt, haben Geister eine Form ? Vor allem, Noerds Geist will ja gar "
   "kein Geist mehr sein, aber wenn Du das bishier her nicht weisst, bist Du "
   "entweder doof, oder Du hast Dir von einem Magier helfen lassen..."));
    
   
   
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist","noerd","noerdsgeist"}) );
  SetProp(P_INFO, "Bring ihm endlich seine ersehne Ruhe!\n");
  create_default_npc(5);
  SetProp(P_NOATTACK, ("Du willst ihm doch nicht so seine letzte Ruhe geben.\n"));
  
  SetProp(P_HANDS, ({" mit einem heiligen Angriff", 100+random(20), ({DT_HOLY})}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 100+random(200));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Durch den Geist faellt alles hindurch...\n"}));
  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
 
  AddInfo(DEFAULT_INFO,({       
  "Der Geist von Noerd sagt: Ich weiss nix, sorry.\n",
  "Der Geist von Noerd sagt: Hmm, interessant.\n",
  "Der Geist von Noerd lacht bloed.\n",
  "Der Geist von Noerd sagt: UI, wie schlau!\n",
  "Der Geist von Noerd meint: Nein, das glaub ich nicht.\n"}));
  
  

AddInfo("geist",
"Ich bin einer.\n", "sagt: ");
AddInfo("priester",
"Tja, den kenne ich nicht, war ja immer hier eingesperrt.\n", "sagt: ");
AddInfo("grab",
"Naja, Du bist in meinem. Ich will hier meine letze Ruhe haben.\n", "sagt: ");
AddInfo("friedhof",
"Der Friedhof ist ueber uns.\n", "sagt: ");
AddInfo("noerd",
"Tja, das bin ich. Der Geist von Noerd sozusagen.\n");
AddInfo("totengraeber",
"Als ich noch lebte, kannte ich ihn.", "sagt: ");
AddInfo("ruhestaette",
 "Das hier soll meine letze Ruhestaette sein. Um mir meine Ruhe zu geben, "
 "musst Du meine Gebeine hier beisetzen oder so aehnlich...\n");
 AddInfo(({"knochen","gebeine"}),
 "Tja, meine Gebeine wurden von den boesen Monstern der Katakomben "
 "versteckt. Such sie! Vlad weiss mehr!", "sagt: ");
 AddInfo("sarg",
 "Hmm, irgendwo muss einer sein.", "sagt: ");
 AddInfo("vlad",
 "Der wohnt in den Katakomben, frag ihn aus.", "sagt: ");
 AddInfo("katakomben",
 "Huete Dich davor...", "sagt: ");
 AddInfo("ruhe",
 "Ich will meine letze Ruhe haben!", "sagt: );
 AddInfo("tuberkulose",
 "Tja, die hatte ich einmal, du ja auch!", "grinst: ");
 AddInfo("grube",
 "Tja was weiss ich...");
 

 SetChats(4, ({
    "Der Geist von Noerd schwebt nach oben...\n",
    "Der Geist von Noerd schwebt nach unten...\n",
    "Der Geist von Noerd jammert.\n",
    "Der Geist von Noerd sagt: Kannst Du mir bitte helfen?\n",
    "Der Geist von Noerd sagt: Erloese mich!\n",
    "Der Geist von Noerd sagt: Hilf mir!\n",
    "Der Geist von Noerd ist ein Nerd.\n",
    "Der Geist von Noerd sagt: Nun loes schon die Quest, Penner!\n",
    "Der Geist von Noerd sagt: Verflucht seien die Katakomben.\n",
    "Der Geist verschwindet, taucht aber hinter Dir wieder auf.\n"}));
}
