inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "files.h"
#include <new_skills.h>
object wer;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Luftschild");
  SetProp (P_LONG, (
  "Dieses Schild besteht aus keinem naeher erkennbaren Material. "
  "Es ist einfach eine magische Lufthuelle, die den Traeger vor vielen "
  "Gefahren bewahren kann."));
  SetProp (P_INFO, "Dieses Schild ist wahrlich hervorragend. \n");
  SetProp (P_NAME, "Luftschild");
  SetProp (P_GENDER, NEUTER);
  AddId (({"schild","luftschild"}));
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 1);
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_AIR}));
  SetProp (P_VALUE, 3000);
  SetProp(P_EXTRA_LOOK, ""+TPN+" wird von einer magischen Lufthuelle umgeben.\n");
  
  SetProp (P_ARMOUR_TYPE, AT_SHIELD);
  SetProp (P_AC, 25+random(5));
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_AIR}));
  SetDefendFunc (TO);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:0, SR_GOOD:0, A_INT:18, A_DEX:18]));
  SetWearFunc (TO);
}

int WearFunc()
{
  wer = TP;
  return 1;
}



int DefendFunc (string dam_type, int spell, object enemy)
{
    if (member( dam_type,({DT_RIP,DT_ELECTRIC,DT_POISON,DT_ACID,DT_UNHOLY,DT_TERROR,DT_WHIP,DT_LIGHTNING,DT_PIERCE,DT_COLD,DT_SQUEEZE,DT_EXPLOSION,DT_AIR,DT_FIRE,DT_SLASH,DT_BLUDGEON,DT_MAGIC})) >=0 )
    {
       tell_object (wer, "Das Luftschild wehrt den Angriff nur wenig ab.\n");
       return 5;
    }
    else
       return 0;
}
