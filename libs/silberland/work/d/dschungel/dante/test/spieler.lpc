//wesen fuer quest

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"
#include <combat.h>   
#include <new_skills.h>     
#include <npc.h>        

inherit "/std/npc";

void spiel(int nr, int to_go);
int lsg, anz;

create()
{
  ::create();
  SetProp(P_SHORT, "Eine dreiarmiges Wesen");
  SetProp(P_LONG,BS(
  "Dieses Wesen sieht sehr komisch aus. Es hat 3 Arme, aber keine Beine! "
  "Es sitzt hier nur so herum und schaut Dich neugierig an! Manchmal "
  "tauscht es einfach seine Arme hin und her. Du staunst noch mehr!")); 
  SetProp(P_NAME, "Wesen");
  create_default_npc(19);
  SetProp(P_RACE, "monster");
  SetProp(P_DEFAULT_INFO, "sagt: Davon habe ich keine Ahnung.\n");
  SetProp(P_REJECT, ({ REJECT_GIVE, "Das Wesen wuerde lieber mit Dir spielen.\n"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Das Wesen hat ein Hobby!\n");
  SetProp(P_ALIGN, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"wesen"}) );
  AddCmd( ({"antworte"}), "antw");
  SetProp(P_NOATTACK, "Das dreiarmige Wesen lacht Dich nur aus!\n");   
  AddInfo( ({"spiel", "spielen"}), "@@do_it@@");
  AddInfo( ({"syntax"}), 
    "Du kannst mir mit 'antworte <links|mitte|rechts>' sagen, wo Du die Flasche vermutest. ",
    "sagt: ");
    AddInfo("hobby",
    "Tja, mach ein Spielchen mit mir. Wenn Du 3 mal gewinnst, gebe ich "
    "Dir die Flasche Baldrian!", "sagt: ");
    AddInfo("flasche",
    "Du meinst den Baldrian...", "sagt: ");
    AddInfo("baldrian",
    "Ach was, ich will nur meinem Hobby froehnen!", "sagt: ");
   

 }

void spiel(int nr, int to_go)
{
  object qs;
  int zeit;
  
  if(file_name(environment(TP))!="/d/dschungel/dante/stein/room/bar4") 
  {
    lsg=0;
    write(
      "Das dreiarmige Wesen teilt Dir mit: Weglaufen ist keine Loesung. Jetzt musst Du wieder\n"
    + "Das dreiarmige Wesen teilt Dir mit: von vorne anfangen.\n");
    qs=QUEST_STATS;
    if(!qs) 
    {
      write(NO_QUEST_STATS);
      return;
    }
    qs->RestoreAntwHi();
    return;
  }
  
  if(find_call_out("spiel")!=-1) return;
  if(!to_go) nr=-1;
  switch(nr)
  {
    case 0: { 
      write("Das Wesen legt die Flasche unter den mittleren Arm.\n");
      lsg=2; break; }
    case 1: { 
      write("Das Wesen vertauscht den linken Arm mit dem rechten Arm.\n");
      if(lsg==1) lsg=3;
      
      else if(lsg==3) lsg=1;
      break; }
    case 2: { 
      write("Das Wesen vertauscht den linken Arm mit dem mittleren Arm.\n");
      if(lsg==1) lsg=2;
      else if(lsg==2) lsg=1;
      break; }
    case 3: { 
      write("Das Wesen vertauscht den mittleren Arm mit dem rechten Arm.\n");
      if(lsg==2) lsg=3;
      else if(lsg==3) lsg=2;
      break; }
    case 4: { 
      write("Das Wesen gibt den rechten Arm ganz nach links.\n");
      lsg++;
      if(lsg==4) lsg=1;
      break; }
    case 5: { 
      write("Das Wesen gibt den linken Arm ganz nach rechts.\n");
      lsg--;
      if(lsg==0) lsg=3;
      break; }
    default: {
      write("Das Wesen sagt: Antworte, aber die Zeit is begrenzt.\n");
      call_out("schade", 25);
      return; }
  }
  call_out("spiel", 2, random(5)+1, to_go-1);
}

antw(str)
{
object fl;
  object qs;
  int ant, l;
  string tx;
  
  notify_fail("Was moechtest Du antworten?\n");
  if(!str) return 0;
  if(find_call_out("spiel")!=-1)
  {
    write("Das Wesen sagt: Warte! Ich bin noch nicht fertig!\n");
    return 1;
  }
  if(find_call_out("schade")==-1)
  {
    write("Das Wesen sagt: Deine Zeit is um! Verloren!\n");
    return 1;
  }
  qs=QUEST_STATS;
  if(!qs)
  {
    write(NO_QUEST_STATS);
    return 1;
  }
  l=-1;
  if(str=="links") l=1;
  else if(str=="mitte") l=2;
  else if(str=="rechts") l=3;
  while(remove_call_out("schade")!=-1){}
  if(l==lsg)
  {
    qs->SetAntwHi();
    ant=qs->QueryAntwHi();
    write("Das Wesen sagt: JAWOHL!!! Korrekt!!!\n");
    if(ant==1)//aendern
    
    {
      if(deep_present("bald", TP))
      {
        write("Aber Du hast doch schon Baldrian bei Dir.\n");
      }
      else
      {
      fl=clone_object("/d/dschungel/dante/stein/obj/bald.lpc");
      fl->move(TP,M_NOCHECK);    
        write(
          "Das Wesen sagt: Ok, hier hast Du die Flasche.\n");
      }
    }
    return 1;
  }
  else
  {
    if(lsg==1) tx="links";
    else if(lsg==2) tx="in der Mitte";
    else if(lsg==3) tx="rechts";
    write("Das Wesen sagt: Nein! Die Flasche war "+tx+"! Versuchs noch einmal.\n");  
//    qs->RestoreAntwHi();
    return 1;
  }
}

do_it()
{
  spiel(0, 20);
  return "grinst hinterlistig.\n";
}

schade()
{
  object qs;
  
  qs=QUEST_STATS;
  if(!qs)
  {
    return;
  }
  write("Das Wesen sagt: Die Zeit ist um! Noch einmal!\n");
  qs->RestoreAntwHi();
}
