
/*
 * spiegelring
 * spiegelbild
 * ---
 * 
 */

#include "files.h"
#include <properties.h>
#include <combat.h>
#include <attributes.h>

inherit "std/armour";
int inte;
int power;
int aus;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  
  AddId(({"ring", "spiegelring", "spiegelbildring"}));
  SetProp(P_SHORT, "Ein glitzernder Spiegelring");
  SetProp(P_LONG,BS(
  "Der Spiegelring glitzert und funkelt und manchmal wenn das Licht richtig "
  "einfaellt kann man sich selbst darin erkennen.")); 
  
  SetProp(P_NAME, "Spiegelring");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 5);

  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 5000+random(500));
  SetProp(P_MATERIAL, ([MAT_MAGIC:100, MAT_METAL:100]));
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:20]) );
  SetProp(P_INFO, BS(
  "Der Spiegelring ist eine wahre Kostbarkeit und kann dem Traeger "
  "moeglicherweise sehr hilfreich sein. Kraft, Ausdauer, Intelligenz, "
  "wer weiss was in diesem Ring steckt.\n"));
  aus=-1+random(4); 
  inte=-1+random(4);
  power=-1+random(4);
  
  //SetProp(P_CURSED,1);
  if(( aus==0 ) || ( power==0) || (inte==0))
    SetProp(P_VALUE,600+random(200));
}

_set_autoload(mixed arg)
{
	if(!arg) return ;

	scanf(arg, "%d:%d:%d", inte, power, aus);
}

_query_autoload()
{
	return inte+":"+power+":"+aus;
}
                                 

varargs int DoWear(int silent, int all)
{
 int ret;
switch(random(100))
 {
 case 0 .. 33:
 { 
  ret = ::DoWear (silent, all);
  if (QueryProp(P_WORN))
  {
    SetProp (P_X_ATTR_MOD, ([ A_CON:aus]) );
    this_player()->UpdateAttributes();
  }  
  return ret;
  break;
 }   
 case 34 .. 67:
 {
  
  ret = ::DoWear (silent, all);
  if (QueryProp(P_WORN))
  {
    SetProp (P_X_ATTR_MOD, ([ A_INT:inte]) );
    this_player()->UpdateAttributes();
  }
  return ret;
  break;
 }
  
  case 68 .. 99:
 {
     
  
  ret = ::DoWear (silent, all);
  if (QueryProp(P_WORN))
  {
    SetProp (P_X_ATTR_MOD, ([ A_STR:power]) );
    this_player()->UpdateAttributes();
  }
  return ret;
 }
}
} 
 
 
varargs int DoUnwear(int silent)
{
  int ret;
  ret = ::DoUnwear (silent);
  if (!QueryProp(P_WORN)) {
    SetProp (P_X_ATTR_MOD, 0 );
    this_player()->UpdateAttributes();
  }
  return ret;
}

