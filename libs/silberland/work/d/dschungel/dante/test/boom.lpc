//dante ok geklaut
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "../files.h"
#define ZUENDDAUER 20

int zeit;

create()
{
   ::create();
   zeit = ZUENDDAUER;
   SetProp(P_SHORT, "Dantemit");
   SetProp(P_NAME, "Dantemit");
   SetProp(P_GENDER, NEUTER);
   SetProp(P_ARTICLE,0);
   AddId(({"sprengstoff", "dantemit", "dynamit"}));
   SetProp(P_WEIGHT, 1000);
   SetProp(P_VALUE, 23000);
   SetProp(P_NOBUY, 1);
}

long()
{
   return 
   "Sei besser vorsichtig damit, wenn Du das anzuendest, solltest Du\n"+
   "moeglichst weit weggehen. Eine Zuendschnur ist am Dantemit\n"
   "befestigt, Du schaetzt dass sie etwa " + zeit + " Sekunden brennen koennte.\n";
}

init()
{
   ::init();
   add_action("zuende", "zuende");
   add_action("zuende", "zuend");
}

zuende(str)
{
   string bla;
   notify_fail("Was moechtest Du anzuenden?\n");
   if (!str)
      return 0;
   if (!sscanf(str, "%s an", bla))
      return 0;
   if (!id(bla) && bla!="zuendschnur")
      return 0;
   write("Du zuendest die Zuendschnur an.\n");
   say(this_player()->name()+" zuendet eine Zuendschnur an.\n");
   call_out("explosion", 2, this_player());
   return 1;
}

explosion(pl)
{
   object env;
   mapping exits;
   object* all;
   int i, j;

   zeit -= 2;
   env = environment();

   if (zeit)
   {
      if (living(env))
	 tell_object(env, "Zischhhh.....\n");
      else
	 tell_room(env, "Zischhhh.....\n");
      call_out("explosion", 2, pl);
      return;
   }
   if (living(env))
   {
      tell_object(env, "KAWUMMMMMMMMMMMMMMM\n");
      tell_object(env, "Das Dantemit zerreisst Dich in Fetzen.\n");
      tell_room(environment(env), "KAWUMMMMMMMMMMMMMMM\n", ({env}));
      tell_room(environment(env), "das Dantemit zerreisst " +
		env->name(WEN) + " in Fetzen.\n", ({env}));
      if (env->QueryProp(P_NAME)=="Tireks")
	 tell_room(environment(env), "Die Fetzen verbinden sich wieder und "+ env->name()+" sieht aus wie neu.\n");
      else
	 env->Defend(5000, DT_EXPLOSION, ([SP_NAME:"Dantemit"]));
      remove();
      return 1;
   }
   tell_room(env, "KAWUMMMMMMMMMMMMMMM\n");
   tell_room(env, "Das Dantemit explodiert direkt neben Dir.\n");
   all = all_inventory(env);
   if (sizeof(all))
      for (i==0; i<sizeof(all); i++)
	 if (all[i]->QueryProp(P_NAME)!="Tireks")
	    all[i]->Defend(2000, DT_EXPLOSION, ([SP_NAME:"Hoellenfeuer"]));

   exits = (mapping)env->QueryProp(P_EXITS);
   if (!mappingp(exits))
      exits = ([ ]);
   walk_mapping(exits, "_hit_neighbour", this_object());

//   if (env == find_object(WALL_BLAST_ROOM))
 //     remove_wall();
   remove();
}

_hit_neighbour(dir, dest)
{
   object *all;
   int i;

   tell_room(dest, "Du hoerst ein lautes Krachen aus dem Nebenraum.\n");
   tell_room(dest, "Gleich darauf schiesst eine Stichflamme heraus und verbrennt\nDich fuerchterlich.\n");
   all = all_inventory(find_object(dest));
   if (sizeof(all))
      for (i=0; i<sizeof(all); i++)
	 if (all[i]->QueryProp(P_NAME)!="Tireks")
	    all[i]->Defend(1500, DT_EXPLOSION, ([SP_NAME:"Dantemit"]));
}


