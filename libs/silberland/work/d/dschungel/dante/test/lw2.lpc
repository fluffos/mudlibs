//objekt wurm um reinzustecken in frucht usw

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Lichtwurm");
  SetProp(P_LONG, BS( 
    "Das ist ein kleiner gefangener Lichtwurm. Zumindest war er "
    "einmal gefangen und ist nun in einer Art Totenstarre. Du kannst ihn "
    "weder angreifen noch kann er Dir etwas anthaben!"));
    SetProp(P_INFO, "Der Lichtwurm hat sicher eine Bedeutung!\n");
  SetProp(P_NAME, "Lichtwurm");
  SetProp(P_GENDER, MALE);
  AddId(({"lw2", "lw", "wurm", "lichtwurm"}));
  SetProp(P_MATERIAL, ({ MAT_ANIMAL}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);

}
