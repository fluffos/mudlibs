inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <actions.h>
#include <mnpc.h>

nosave int brez;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein frecher Jojogeist");
  SetProp(P_LONG, BS(
  "Das ist ein Jojogeist. Er hat eine dem Jojo sehr aehnliche Koerperform "
  "und ist vor allem eines laestig, nervend frech. Allzu gefaehrlich ist er "
  "aber nicht..."));
  SetProp(P_NAME, "Jojogeist");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  
  AddId(({"jojogeist","geist"}));
 
call_out("weg", 600);

  create_default_npc(5);
  
  SetProp(P_HANDS, ({" mit seinen jojoartigen Fingern", 30+random(10),({DT_TERROR}) }));
  SetProp(P_BODY, (10+random(10)));
  SetProp(P_MAX_HP, 500);
  SetProp(P_MAX_SP, 500);
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 150);
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-3);
  SetProp(P_AGGRESSIVE,0); 
  
  SetProp(P_INFO, ("Der Jojogeist ist eine Nervensaege!\n"
  "Solltest Du im Kampf mit ihm sein, kannst ihn beruhigen.\n"
  "Sytax: friede, frieden, befriede...geist,jojo,jojogeist\n"
  "Er wird Dir augenblicklich gehorchen.\n"));
   
  SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON: 0.5, DT_SLASH:2.0, DT_MAGIC:1.0,
 DT_FIRE: 2.0 ,DT_TERROR:2.0, DT_HOLY:2.0, DT_PIERCE:0.3 ,DT_UNHOLY:1.5]));
    
    
    
  SetProp(P_MSGIN, "kommt Dich tretend und grinsend herein");
  SetProp(P_MSGOUT, "rennt nervend und dumm grinsend");
  SetProp(P_MMSGIN, "wird aus dem Jojo geformt");
  SetProp(P_MMSGOUT,  "verwandelt sich wieder in ein Jojo");
  SetProp(P_SPELLRATE, 60);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_DIE_MSG,  " sagt: Jaja, ich geh schon wieder.\n");
  SetProp(P_NOCORPSE, 1);
  
  
    AddSpell(3,40,
    "Der Jojogeist tritt Dir ins Schienbein.\n",
    "Der Jojogeist tritt @WEM ins Schienbein.\n",
                 DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
                 
    AddSpell(2,50,
    "Dee Jojogeist spuckt Dir ins Gesicht.\n",
    "Der Jojogeist spuckt @WEM ins Gesicht.\n",
                 DT_ACID,([SP_SHOW_DAMAGE:1]));                     
  
   AddSpell(3,50,
    "Der Jojogeist zwickt Dir in die Nase.\n",
    "Der Jojogeist zwickt @WEM in die Nase.\n",
                 DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  
   AddSpell(3,50,
    "Der Jojogeist reisst an Deinen Haaren.\n",
    "Der Jojogeist reisst an @WESSEN Haaren.\n",
                 DT_TERROR,([SP_SHOW_DAMAGE:1]));
   
   AddSpell(2,70,
    "Der Jojogeist schreit Dir laut ins Ohr.\n",
    "Der Jojogeist schreit laut in @WESSEN Ohr.\n",
                 DT_TERROR,([SP_SHOW_DAMAGE:1]));
  
                  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Halts Maul!\n",
  "sagt: Du bist ein ziemlicher Idiot!\n",
  "lacht Dich aus.\n",
  "sagt: Igit, bist du eklig.\n",
  "sagt: Naja, loesch Dich einfach!\n",
  "sagt: Du Sackgesicht!\n",
  "spuckt Dich an.\n"}));
  
  
  SUID;
  CLONEME(OBJ"brezel");
  

  
  AddInfo("brezel",
  "Das ist was zum Essen und ein Spieler. Ich kann Dir Brezel, das Essen, "
  "nicht den Spieler verkaufen. [kaufe brezel]", "sagt: ");
  AddInfo("wuschel",
  "Die irre Schlampe?!","sagt: ");// mit erlaubnis von wuschel!!
 AddInfo("jojo",
 "Ich bin der Jojogeist!","sagt: ");
 AddInfo("dante",
 "Dante ist fast so doof wie DU!","sagt: ");
  AddInfo("dante", "Dante ist ein Pschyoork.","sagt: ");
  AddInfo("feyaria",
  "Feyaria, hmm, ist das was zum essen?","sagt: ");//kleiner scherz net ernst gemeitn fey!
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Jojogeist sagt: Gib schon her, Du Sack!.\n" }) );


  SetAttackChats(40, ({
    "Der Jojogeist sagt: Du mieser Sack!\n",
    "Der Jojogeist bruellt: Deine Mutter war eine Hure!\n",//hehehe
    "Der Jojogeist schreit: Ich werde Dich toeten!\n",
    "Der Jojogeist tobt vor Wut.\n"
            }) );    
  
  SetChats(17, ({
    "Der Jojogeist spuckt Dich an.\n",
      "Der Jojogeist nimm Dir Dein Geld weg.\n",
      "Der Jojogeist lacht Dich aus.\n",
      "Der Jojogeist schlaegt Dir auf Dein Ohr.\n",
      "Der Jojogeist sagt: Humor ist wenn man trotzdem lacht.\n",
      "Der Jojogeist sagt: Dich mag hier niemand, hau ab.\n",
      "Der Jojogeist huepft wie wild um Dich.\n",
      "Du bekommst eine grosse Wut auf den Jojogeist.\n",
      "Der Jojogeist sagt: Na, geh ich Dir auf den Geist!\n",
      "Du trittst den Jojogeist.\n",
      "Der Jojogeist ruft: Magier sind doof und stinken.\n",
      "Der Jojogeist sagt: Du bist sooo haesslich!\n",
      "Der Jojogeist sagt: Komm, toete mich doch , Du Feigling!\n",
      "Der Jojogeist sabbert Dich an.\n",
      "Der Jojogeist sagt: Du stinkst!\n",
      "Der Jojogeist pinkelt Dir ans Bein.\n",
      "Der Jojogeist drueckt auf Dein Auge.\n",
      "Der Jojogeist sagt: Dein Panzer ist Muell!\n",
      "Der Jojogeist stellt Dir ein Bein.\n",
      "Der Jojogeist sagt: Du hast ja die Kraetze.\n",
      "Der Jojogeist schleimt Dich an.\n",
      "Der Jojogeist sagt: Waeh! Du hast Haemorrhoiden!\n",
      "Der Jojogeist sagt: Niemand ist so doof wie DU!\n",
      "Der Jojogeist sagt: Niemand ist so haesslich wie DU!\n",
      "Du wuerdest den Jojogeist gerne toeten.\n",
      "Der Jojogeist sagt: Los loesch Dich selbst!\n",
      "Der Jojogeist sagt: Dein Password ist ja zu doof!\n",
      "Der Jojogeist sagt: Waeh! Du hast ja Pickel.\n",
      "Der Jojogeist sagt: Du schleimiger Wurm!\n",
        "Der Jojogeist tritt Dir ins Schienbein!\n",
        "Der Jojogeist quaelt Dich sehr!\n",
        "Der Jojogeist nervt Dich gewaltig.\n",
        "Der Jojogeist sagt: Du Trottel!\n",
        "Der Jojogeist klaut Deine Waffe.\n",
        "Du denkst . o O ' Wann haut der Jojogeist endlich ab.'\n",
        "Du verfluchst den Jojogeist.\n",
        "Der Jojogeist sagt: Du Kretin!\n",
          "Der Jojogeist haut Dir auf die Nase.\n"
            }) ); 
  
  
  brez=5+random(5);
  
  AddCmd(({"frieden","friede","befriede"}), "peace");
  AddCmd(({"kaufe","kauf"}), "brezel");
  AddCmd(({"befehle","befehl"}), "go");
}


//reset() nicht noetig
//{
//  ::reset();
 //   brez=3;
//    } 



int go(string str)
{
 object mon;
 string  monster, ich;
 notify_fail("Was soll der Jojogeist machen?\n");
 (!str)
    {
    write("Der Jojogeist schlaegt Dir aufs Mauls und sagt frech:\n"
    "Mach das ja nicht nochmal mit mir Du Sack!\n");
    return 1;
    TP->do_damage(10);
    }
    
   // if ( !id(ich)) return 0;
    
   if(!present(TP, "attjo")
   {
   write("Der Jojogeist sagt: Halts Maul, Du hast mir nichts zu sagen!\n");
   write("Der Jojogeist schlaegt Dir ins Gesicht.\n");
   TP->do_damage(10);
   return 1;
   }
   
   if((present(TP, "attjo") && (sscanf(str, "% verfolge %",ich, monster) != 2))
   {
    
     
        if( !mon = find_player( monster))
        {
        write("Der Jojogeist teilt Dir mit:  "+capitalize(monster)+" ist nicht anwesend. Leider!\n");
        return 1;
       }
         
     else
      {
      this_object()->move( environment(mon), M_TPORT );   
      tell_object( mon, "Der Jojogeist sagt: Hallo "+mon->name()+"! "+this_player()->name()+
      " hat mich geschickt, damit ich Dich quaelen kann.\n");
     mon->AddPursuer( this_object());  
     SetProp( P_MSGOUT, "nervt "+capitalize(getuid(mon))+" hinterher" ); 
      return 1;
      }
      return 0;
      }                                                                         


int brezel(string str)
{
object ob;
notify_fail("Was willst Du vom Jojogeist kaufen?\n");
if (!str) return 0;

if(TP->QueryMoney() < 100)
       {
    write("Ein Brezel kostet 100 Muenzen und soviel hast Du nicht bei Dir.\n");
//    say(""+TPN+" versucht vergeblich ein Brezel vom Jojogeist zu kaufen.\n");
    return 1;
       }
    

   if((member(({"brezel","brezel von geist","brezel von jojogeist"}), str)!=-1)&&
    (TP->QueryMoney() > 99 ) && (brez))
       {
       ob=clone_object("/d/dschungel/dante/weg/obj/brezel.lpc");
       ob->move(TP, M_NOCHECK);
       Tp->AddMoney(-100);
       write(
       "Du kaufst ein Brezel vom Jojogeist.\n");
  //     say(""+TPN+" kauft sich beim Jojogeist ein Brezel.\n");
       brez--; 
       return 1;
       }
      
     if((member(({"brezel","brezel von geist","brezel von jojogeist"}), str)!=-1)&&
      (TP->QueryMoney() > 99 ) && (!brez))                                         
      {
        write("Der Jojogeist sagt: Pech gehabt! Ausverkauft!\n");
    //    say(""+TPN+" wird vom Jojogeist ausgelacht.\n");
        return 1;
        }
        return 0;
        }



peace(string str)
{
notify_fail("Wen willst Du hier befrieden?\n");
    if(!str) return 0;
    
    if(str=="jojogeist" || str=="jojo" || str=="geist")
        {
         write("Du befriedest den Jojogeist. Er aergert sich, muss aber gehorchen.\n");
         say(""+TPN+" befriedet den Jojogeist.\n");
         
         
         
         
         
             TP->StopHuntFor(ME);
                 StopHuntFor(TP);
         TP->restore_spell_points(-15);//damits nicht zu oft geht
        return 1;
        }
        return 0;
    }


   die(arg)
      {
      object ob; 
      write("Der Geist ist endlich weg, und Du hast Dein Jojo wieder.\n");
      ob=clone_object("/d/dschungel/dante/weg/obj/jojo");
      ob->move(TP, M_NOCHECK);
       ::die(arg);    
      }


weg()
{
write("Der Jojogeist haut Dir nocheinmal aufs Maul und verschwindet dann.\n"
"Du seufzt erleichtert und bist froh, diesen Quaelgeist los zu sein.\n");
remove();
}

