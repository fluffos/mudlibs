//objekt um andere objekte zu bemalen....
//farbe und symbole nach wahl

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"
#include <ansi.h>



/*
string *farben=({"gelb","rot","blau","gruen","orange","lila","rosa","schwarz",
                 "violett","braun","okker","hellblau","himmelblau","tuerkis",
                 "giftgruen","weiss","azur","grau"});
*/


create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein durchsichtiger Kristallkubus");
  SetProp(P_LONG,BS(
  "Du betrachtest Dir den Kubus genauer und erkennst im Inneren "
  "eine grosse Anzahl eingeschlossener, sehr kleiner Schreibteufelchen. "
  "Sie scheinen alle zu leben und werfen und spruehen unzaehlige Worte "
  "um sich herum. Irgendeine seltsame Macht muss vor langer Zeit dieses "
  "obskure Objekt geschaffen haben..."));
  AddDetail(({"inneres","innerem","inneren"}),
  "Im Inneren siehst Du viele gefangene Schreibteufelchen.");
  AddDetail(({"worte","wort"}),
  "Du erblickst unzaehlige Worte. Viele davon hast Du bis heute "
  "noch nie erblickt.");
  AddDetail("anzahl",
  "Zuviele um sie zu zaehlen...");
  AddDetail(({"schreibteufel","teufel","schreibteufelchen","schreibteufel","teufelchen"}),
  "Sie springen wie von Sinnen im Inneren des Kubus auf und ab und wollen "
  "irgendetwas von Dir, aber was....");
  AddDetail(({"kristall","kubus","kristallkubus"}),
  "Der Kubus ist aus lupenreinem Kristall gefertigt. Er scheint hohl zu sein, "
  "denn im Inneren springen sehr viele kleine Schreibteufelchen umher.");
  
     

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,3000);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Kristallkubus");
  SetProp(P_MATERIAL,([MAT_CRYSTAL:100, MAT_MISC_MAGIC:100]));  
     
  SetProp(P_INFO, "Die Schreibteufelchen wollen nur eines: Alles beschriften!!!\n"
  "Der Besitzer dieses Kubus kann ihnen den Befehl dazugeben.\n"
  "Mit <iteufel> kannst Du Dinge beschreiben lassen die Du besitzt.\n"
  "Mit <eteufel> kannst Du Dinge beschreiben lassen die in Deiner Umgebung sind. "
  "Beispiel: < iteufel  wasimmerduebenwillst auf wasimmerduwillst> .\n"
  "Du kannst nur Objekte beschriften, die Du entweder bei Dir hast, oder die "
  "in Deiner Umgebung sind.\n"
  "Das Beherrschen der Teufel kostet aber einige magische Faehigkeit und "
  "die Schreibteufelchen sind auch nicht unsterblich...\n");
  
  AddId(({"kristall","kubus","kristallkubus"}));
  SetProp(P_NOBUY, 1);
  AddCmd(({"iteufel"}),"paint");
  AddCmd(({"eteufel"}), "epaint");
}



int paint(string str)
{
 
 string oldlong, pl;
  int sp;
 object ob;
 string  t1, t2;
  notify_fail("Was sollen die Schreibteufel worauf schreiben?\n");
  if (!str) 
  {
  write("Du musst den Schreibteufelchen schon sagen was sie schreiben sollen!\n");
  return 1;
  }
  
  if( sscanf(str, "%s auf %s",t1,t2))
        {
    if (!ob=present(t2,TP))// || (!ob=present(t2, environment(TP))) )
    {
    write("Hast Du nicht!\n");
    return 1;
    }
  
  
    sp=this_player()->QueryProp(P_SP);
    
    if(sp<=20)                 
    {
        
    write("Deine Magie reicht dafuer nicht aus!\n");
    return 1;
    }
    
    
    oldlong=ob->QueryProp(P_LONG);
    
    
      
     {
     pl=TP->QueryProp(P_NAME);
     TP->restore_spell_points(-20);
     write("Die Schreibteufelchen schreiben "+t1+" auf "+(ob->name())+".\n");
     ob->SetProp(P_LONG, oldlong+"\n"
     ""+capitalize(pl)+" hat folgendes auf "
     ""+(ob->name())+" geschrieben:\n" 
      ""+capitalize(t1)+"\n");
     return 1;
        }
     return 0;
     }
     
   return 0;
   }
   

int epaint(string str)
{
 
 string oldlong, pl;
  int sp;
 object ob;
 string  t1, t2;
  notify_fail("Was sollen die Schreibteufel worauf schreiben?\n");
  if (!str) 
  {
  write("Du musst den Schreibteufelchen schon sagen was sie schreiben sollen!\n");
  return 1;
  }
  
  if( sscanf(str, "%s auf %s",t1,t2))
        {
    if (!ob=present(t2,environment(TP)))// || (!ob=present(t2, environment(TP))) )
    {
    write("Ist nicht hier!\n");
    return 1;
    }
  
  
    sp=this_player()->QueryProp(P_SP);
    
    if(sp<=20)                 
    {
        
    write("Deine Magie reicht dafuer nicht aus!\n");
    return 1;
    }
    
    
    oldlong=ob->QueryProp(P_LONG);
    
    
      
     {
     pl=TP->QueryProp(P_NAME);
     TP->restore_spell_points(-20);
     write("Die Schreibteufelchen schreiben "+t1+" auf "+(ob->name())+".\n");
     ob->SetProp(P_LONG, oldlong+"\n"
     ""+capitalize(pl)+" hat folgendes auf "
     ""+(ob->name())+" geschrieben:\n" 
      ""+capitalize(t1)+"\n");
     return 1;
        }
     return 0;
     }
     
   return 0;
   }
     
          