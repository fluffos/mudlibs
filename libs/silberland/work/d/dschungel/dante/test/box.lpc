// 97 dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"


int z1, z2, z3, z4;
int antwort;
int t;



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  
  z1=3+random(7);
  z2=3+random(7);
  z3=3+random(7);
  z4=3+random(7);
    
  antwort=1+z1+z1*z2+z1*z2*z3+z1*z2*z3*z4;
 t=random(200)+antwort-random(200);
  SetProp(P_SHORT, "Ein kraeftiger Waechter");
  SetProp(P_LONG, BS(
   "Dieser kraeftige Waechter sorgt fuer Ruhe und Ordnung in dem "
   "von Menschen, Zwergen und anderen Teilen der Hoehle. Er ist freundlich, "
   "aber bestimmt.<syntax: raetsel...loesung>"));    
  SetProp(P_NAME, "Waechter");
  SetProp(P_GENDER, MALE);
  AddId(({ "waechter", "wache"}));

  create_default_npc(12);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen starken Armen",130+random(20),DT_BLUDGEON}));
  SetProp(P_MAX_HP, 200+random(50));
  SetProp(P_BODY, 50+random(10));
 // SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "waechter");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weit weg");

  SetProp(P_DIE_MSG,  " bricht in Plichterfuellung nieder.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sagt: Hier herrscht Ruhe und Ordnung!\n");
  AddInfo("dante", "Dante hat mich erschaffen.\n","sagt: ");


AddCmd(({"schaetze"}), "test3");
AddCmd(({"raetsel"}), "test");
AddCmd(({"loesung"}), "test2");
}


test3()
  {
  
  write("der Waechter sagt:\n"
  "Die Zahl ist ca bei "+t+"!\n");
  return 1;
  }
  
test()
{
write("Der Waechter sagt: Ich habe eine Schachtel! In dieser Schachtel "
"befinden sich "+z1+" weitere Schachteln! In jeder dieser Schachteln sind "
"wiederum "+z2+" Schachteln! Und in diesen Schachteln habe ich "+z3+" Schachteln! "
"Und wiederum hab ich in diesen Schachteln "+z4+" Schachteln! Tja, wieviel "
"Schachteln hab ich nun????\n");

return 1;
}

  test2(int was)
{
  if (!was || was == "")
      return 0;
    
        
  if(was==""+antwort+"")
    {
    write("JA!\n");
    call_out("new", 0);
   return 1;
   
    }
  else
  {
  write("Richtig waere: "+antwort+"!\n");
  
  write("Nein!\n");
  call_out("new", 0);
  return 1;
      }
return 0;
}

  void new()
  {
  t=0;
  antwort=0;
  z1=3+random(7);
  z2=3+random(7);
  z3=3+random(7);
  z4=3+random(7);
  antwort=1+z1+z1*z2+z1*z2*z3+z1*z2*z3*z4;
  t=random(200)+antwort-(200);
  return;
      
  }
  
