//grosser dehwurm fuer dschungel
//hat drehwurm eier zum reinstopfen in ohr der spieler
//kein damge im ei nur spasssss

inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>    

int i;
create()
{

 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Drehwurm");
  SetProp(P_LONG, BS(
  "Das ist ein Drehwurm. Er kommt nur hier im Dschungel vor, und auch hier "
  "ist er nur selten zu treffen. Er ist eigentlich ein friedlicher Zeitgenosse, "
  "interessant sind vor allem seine Eier."));  
  SetProp(P_NAME, "Drehwurm");
  SetProp(P_GENDER, MALE);
  AddId(({"wurm", "drehwurm"}));
  SetProp(P_INFO,
  "Die Eier des Drehwurmes koenne viel Spass bereiten...\n");
  
  create_default_npc(99);
  SetProp(P_HANDS, ({" mit seinen gedrehten Zaehnen", 1, DT_POISON}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, 0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht aus der Erde heraus");
  SetProp(P_MMSGOUT, "kriecht wieder in die Erde zurueck");
  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/stein/room/"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS );
  SetProp(P_MNPC_WAIT, ({0, 10,10}));
  SetProp(P_MNPC_DEFAULTROOM,  "/d/dschungel/dante/stein/room/stein3.lpc");
  SetProp(P_DIE_MSG,  "dreht sich zu Tode.\n");
  SetProp(P_DEFAULT_INFO, "dreht sich nur herum.\n");
  
//    SetProp(P_NOATTACK, "dreht sich geschickt weg!\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Drehwurm kann Deine Sachen doch gar nicht tragen.\n" }) );

SUID;
for(i=0;i<random(4)+1;i++)
  CLONEME("/d/dschungel/dante/stein/obj/dei");

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 0);

   SetChats(5, ({
   "Der Drehwurm dreht sich herum.\n",
   "Der Drehwurm dreht sich blitzschnell.\n",
   "Dir wird schwindlig.\n",
   "Der Drehwurm dreht sich um sich selbst.\n",
   "Der Drehwurm verdreht sich.\n"}));
         
 SetProp(P_SPELLRATE, 0);
  AddSpell(5, 300,
  "Der Drehwurm dreht sich um Dich herum.\n",
  "Der Drehwurm dreht sich um @WEN herum.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));          

  AddSpell(3, 400,
  "Der Drehwurm dreht Dir fast ein Bein ab.\n",
  "Der Drehwurm dreht dreht @WEM fast ein Bein ab.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));          

  AddSpell(1, 500,
  "Der Drehwurm verdreht Dir den Kopf.\n",
  "Der Drehwurm verdreht @WESSEN Kopf.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));          

}

  die(arg)
  
  {
  object ob;
  ob=clone_object("/d/dschungel/dante/stein/obj/turn");
  ob->move(TP, M_NOCHECK);
  write("Sterbend spuckt der Drehwurm irgendetwas Schleimiges in Deinen Mund!!!\n");
  ::die(arg);
  }
  
  
  
