//dante fuer quest tic tac toe




inherit "std/room";
#include "files.h"
#include <properties.h>
#include <room.h>
#include <combat.h>
#include <language.h>
#include <moving.h>



object qs;
int  won(string xo);
int  test(string xo);
void setze();
int  patt();

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem seltsamen Raum" );
  SetProp( P_INT_LONG,BS(
  "NIX"));
  SetProp(P_INDOORS,1);
  SetProp( P_LIGHT, 1 );
    SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));  
  AddCmd( ({"kreuze", "setze", "markiere"}), "cross");

  AddDetail( ({"spieler"}),
    "Xooxo ist gemeint.\n");
  AddDetail( ({"tic-tac-toe", "tic", "tac", "toe", "tic tac toe", "tictactoe"}),
    "Das kennst Du nicht? Dann frag mal auf -a.\n");
  AddDetail( ({"gittermuster"}),
    "#\n");
  AddDetail( ({"o"}),
    "O\n");
  AddDetail( ({"x"}),
    "X\n");
  AddSpecialDetail(({"spiel"}), "game");
  AddDetail( ({"ort", "zelle", "raum", "zimmer"}),
    "Tausende von Tic-Tac-Toe-Spielen sind an die Waende gemalt.\n");
  AddDetail( ({"tisch"}),
    "Ein kleiner Tisch aus Holz steht hier.\n");
  AddDetail( ({"stuhl"}),
    "Ein hoelzerner Stuhl steht hier herum.\n");
  AddDetail( ({"bett", "pritsche"}),
    "An der Wand ist eine Pritsche angebracht.\n");
  AddDetail( ({"holz"}),
    "Es handelt sich wohl um billiges Holz.\n");
  AddDetail( ({"boden", "fussboden"}),
    "Der Boden hier sieht neu aus. Irgendwie zumindest.\n");
  AddDetail( ({"wand", "waende"}),
    "An einer Wand ist ein Spiel angemalt, das Xooxo wohl fuer Dich reserviert hat,\n"
  + "denn dort ist noch nichts angekreuzt.\n");
  AddDetail( ({"decke", "zimmerdecke"}),
    "Die Decke ist ganz normal.\n");
  AddDetail( ({"stein", "steine", "gestein"}),
    "Die Waende bestehen aus grossen Steinen.\n");
  AddDetail( ({"eisenstaebe", "staebe"}),
    "Staebe aus Eisen.\n");
  AddDetail( ({"eisen"}),
    "Eisen ist sehr hart und fest.\n");
  AddDetail( ({"licht"}),
    "Licht gibt es hier auch.\n");
  AddDetail( ({"fenster"}),
    "An das Fenster kommst Du gar nicht heran, denn es ist direkt unter der Decke.\n");
  AddDetail( ({"flur"}),
    "Von hier hast Du einen guten Ausblick auf den Flur.\n");
  AddDetail( ({"ausblick"}),
    "Was man so Ausblick nennt.\n");

}


game()
{
  object qs;
  
 qs=QUEST_STATS;
  if(!qs) return NO_QUEST_STATS;
  qs->Show6aAufg();
  return "Das sieht doch einfach aus.\n";
}

cross(str)
{
  int nr, s;
  object qs;
  
  qs=QUEST_STATS;
  if(!qs) 
  {
    write(NO_QUEST_STATS);
    return 1;
  }
  notify_fail("Syntax: kreuze <nr>\n");
  if((nr=to_int(str))<1 || nr>9) return 0;
  notify_fail("Das Feld ist schon belegt.\n");
  if((qs->Query6a(nr))!=" ") return 0;
  qs->Set6a(nr,"X");
  write("Du kreuzt das Feld an.\n");
  if(won("X"))
  {
    write("Xooxo sagt: Du hast gewonnen!\n");
    qs->generate6a();
    if((qs->AddWon6a()))
    {
      write("Xooxo sagt: Na gut. Du hast mich geschlagen. Der Code ist "+qs->QueryCode(8)+"!\n");
   //   DO_LOG_LSG("6A");
    }
  }
  else
  {
    if(patt())
    {
      write("Xooxo sagt: Hmmm. Neuer Versuch!\n");
      qs->generate6a();
    }
    else
    {
      if((s=test("O"))!=-1) 
      {
        qs->Set6a(s+1,"O");    
      }
      else 
      {
        if((s=test("X"))!=-1) 
        {
         qs->Set6a(s+1,"O");    
       }
        else
        {
          while((qs->Query6a(s=random(9)+1))!=" "){}
          qs->Set6a(s,"O");
        }
      }
      write("Xooxo markiert ein Feld.\n");
      qs->Show6aAufg();
      if(won("O"))
      {
        write("Xooxo sagt: Ich habe gewonnen!\n");
        qs->generate6a();
        qs->Loose6a();
      }
      else
      if(patt())
      {
        write("Xooxo sagt: Hmmm. Neuer Versuch!\n");
        qs->generate6a();
      }
    }
  }
  return 1;
}

int won(string xo)
{
  string *tx;
  int l1;
  object qs;
  
  qs=QUEST_STATS;
  if(!qs)
  {
    write(NO_QUEST_STATS);
    return 0;
  }
  tx=allocate(9);
  l1=0;
  while(l1<9)
  {
    tx[l1]=qs->Query6a(l1+1);
    l1++;
  }
  if((tx[0]==xo)&&(tx[1]==xo)&&(tx[2]==xo)) return 1;
  if((tx[3]==xo)&&(tx[4]==xo)&&(tx[5]==xo)) return 1;
  if((tx[6]==xo)&&(tx[7]==xo)&&(tx[8]==xo)) return 1;
  if((tx[0]==xo)&&(tx[3]==xo)&&(tx[6]==xo)) return 1;
  if((tx[1]==xo)&&(tx[4]==xo)&&(tx[7]==xo)) return 1;
  if((tx[2]==xo)&&(tx[5]==xo)&&(tx[8]==xo)) return 1;
  if((tx[0]==xo)&&(tx[4]==xo)&&(tx[8]==xo)) return 1;
  if((tx[2]==xo)&&(tx[4]==xo)&&(tx[6]==xo)) return 1;
  return 0;
}

int test(string xo)
{
  string *tx;
  int l1;
  object qs;
  
  qs=QUEST_STATS;
  if(!qs)
  {
    write(NO_QUEST_STATS);
    return -1;
  }
  tx=allocate(9);
  l1=0;
  while(l1<9)
  {
    tx[l1]=qs->Query6a(l1+1);
    l1++;
  }
  if((tx[0]==" ")&&(tx[1]==xo)&&(tx[2]==xo)) return 0;
  if((tx[3]==" ")&&(tx[4]==xo)&&(tx[5]==xo)) return 3;
  if((tx[6]==" ")&&(tx[7]==xo)&&(tx[8]==xo)) return 6;
  if((tx[0]==" ")&&(tx[3]==xo)&&(tx[6]==xo)) return 0;
  if((tx[1]==" ")&&(tx[4]==xo)&&(tx[7]==xo)) return 1;
  if((tx[2]==" ")&&(tx[5]==xo)&&(tx[8]==xo)) return 2;
  if((tx[0]==" ")&&(tx[4]==xo)&&(tx[8]==xo)) return 0;
  if((tx[2]==" ")&&(tx[4]==xo)&&(tx[6]==xo)) return 2;
  if((tx[0]==xo)&&(tx[1]==" ")&&(tx[2]==xo)) return 1;
  if((tx[3]==xo)&&(tx[4]==" ")&&(tx[5]==xo)) return 4;
  if((tx[6]==xo)&&(tx[7]==" ")&&(tx[8]==xo)) return 7;
  if((tx[0]==xo)&&(tx[3]==" ")&&(tx[6]==xo)) return 3;
  if((tx[1]==xo)&&(tx[4]==" ")&&(tx[7]==xo)) return 4;
  if((tx[2]==xo)&&(tx[5]==" ")&&(tx[8]==xo)) return 5;
  if((tx[0]==xo)&&(tx[4]==" ")&&(tx[8]==xo)) return 4;
  if((tx[2]==xo)&&(tx[4]==" ")&&(tx[6]==xo)) return 4;
  if((tx[0]==xo)&&(tx[1]==xo)&&(tx[2]==" ")) return 2;
  if((tx[3]==xo)&&(tx[4]==xo)&&(tx[5]==" ")) return 5;
  if((tx[6]==xo)&&(tx[7]==xo)&&(tx[8]==" ")) return 8;
  if((tx[0]==xo)&&(tx[3]==xo)&&(tx[6]==" ")) return 6;
  if((tx[1]==xo)&&(tx[4]==xo)&&(tx[7]==" ")) return 7;
  if((tx[2]==xo)&&(tx[5]==xo)&&(tx[8]==" ")) return 8;
  if((tx[0]==xo)&&(tx[4]==xo)&&(tx[8]==" ")) return 8;
  if((tx[2]==xo)&&(tx[4]==xo)&&(tx[6]==" ")) return 6;
  return -1;
}

int patt()
{
  int l1, p;
  object qs;
  
  qs=QUEST_STATS;
  if(!qs)
  {
    write(NO_QUEST_STATS);
    return 0;
  }
  p=1;
  l1=0;
  while(l1<9)
  {
    if((qs->Query6a(l1+1))==" ") p=0;
    l1++;
  }
  return p;
}
