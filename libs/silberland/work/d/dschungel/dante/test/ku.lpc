//objekt um andere objekte zu bemalen....
//farbe und symbole nach wahl
//unterschiedliche cms fuer npcs spieler onj im inv  obj im env usw...
//moeglicherweise asciigraphiken wenn geht:))
//dante 98

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"
#include <ansi.h>

//int strresult;

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein durchsichtiger Kristallkubus");
  SetProp(P_LONG,BS(
  "Du betrachtest Dir den Kubus genauer und erkennst im Inneren "
  "eine grosse Anzahl eingeschlossener, sehr kleiner Farbteufelchen. "
  "Sie scheinen alle zu leben und werfen und spruehen unzaehlige Farben "
  "um sich herum. Irgendeine seltsame Macht muss vor langer Zeit dieses "
  "obskure Objekt geschaffen haben..."));
  AddDetail(({"inneres","innerem","inneren"}),
  "Im Inneren siehst Du viele gefangene Farbteufelchen.");
  AddDetail(({"farbe","farben"}),
  "Du erblickst unzaehlige Farben. Viele davon hast Du bis heute "
  "noch nie erblickt.");
  AddDetail("anzahl",
  "Zuviele um sie zu zaehlen...");
  AddDetail(({"farbteufel","teufel","farbteufelchen","farbteufel","teufelchen"}),
  "Sie springen wie von Sinnen im Inneren des Kubus auf und ab und wollen "
  "irgendetwas von Dir, aber was. Sie scheinen Dir auch irgendetwas sagen "
  "zu wollen, aber ihre Stimmen sind so leise...");
  AddDetail(({"stimme","stimmen"}),
  "Du kannst sie kaum vernehmen...");
   SetProp(P_SMELL,  
    "Der Kubus riecht nach nichts...\n");
    SetProp(P_SOUND,
    "Du glaubst das Gemurmel der Stimmen so deuten zu koennen:\n"
    "plfarbe motiv auf wasimmerduwillst fuer spieler\n"
    "monfarbe motiv auf wasimmerduwillst fuer monster\n"
    "Allerdings kostet das viel Magie und koennte ins Auge gehen!\n");
    
  AddDetail(({"kristall","kubus","kristallkubus"}),
  "Der Kubus ist aus lupenreinem Kristall gefertigt. Er scheint hohl zu sein, "
  "denn im Inneren springen sehr viele kleine Farbteufelchen umher.");
  
     

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,3000);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Kristallkubus");
  SetProp(P_MATERIAL,([MAT_CRYSTAL:100, MAT_MISC_MAGIC:100]));  
     
  SetProp(P_INFO, "Die Farbteufelchen wollen nur eines: Alles anmalen!!!\n"
  "Der Besitzer dieses Kubus kann ihnen den Befehl dazugeben.\n"
  "Du kannst nur Objekte anmalen, die Du entweder bei Dir hast, oder die "
  "in Deiner Umgebung sind.\n"
  "<iteufel motiv auf wasimmerduwillst> bemalt Dinge die Du besitzt.\n"
  "<eteufel usw..> bemalt Dinge in Deiner Umgebung.\n"
  "Beispiel: iteufel gruene wurst auf schwert. Die Farbe sollte an erster "
  "Stelle stehn, wobei die Farben rot, gruen, blau, gelb, violett, cyan, weiss "
  "und schwarz die besten Resultate liefern. "
  "Das Beherrschen der Teufel kostet aber einige magische Faehigkeit und "
  "die Farbteufel sind auch nicht unsterblich...\n");
  
  AddId(({"kristall","kubus","kristallkubus"}));
  SetProp(P_NOBUY, 1);
  AddCmd(({"iteufel"}),"paint");
 AddCmd(({"eteufel"}),"paint2");
 AddCmd(({"monfarbe"}), "paint3");
 AddCmd(({"plfarbe"}), "paint4");
}



int paint(string str)
{
 
 string oldlong, pl, farbe;
  int sp, i;
 object ob;
 string  t1, t2, *tt;
 farbe="";
  notify_fail("Was sollen die Farbteufel worauf malen?\n");
  if (!str) 
  {
  write("Du musst den Farbteufelchen schon sagen was sie malen sollen!\n");
  return 1;
  }
  
  if( sscanf(str, "%s auf %s",t1,t2))
        {
    if (!ob=present(t2,TP))
    {
    write("Hast Du nicht!\n");
    return 1;
    }
      sp=this_player()->QueryProp(P_SP);       
       if(sp<=20)      
        {
        
            write("Deine Magie reicht dafuer nicht aus!\n");
                return 1;
                    }
       
      oldlong=ob->QueryProp(P_LONG);
      
     if (strstr(t1,"rot",0) !=-1) {farbe=ANSI_RED + ANSI_BOLD;}
     if (strstr(t1,"blau",0)!=-1) {farbe=ANSI_BLUE + ANSI_BOLD;}
     if (strstr(t1,"weiss",0)!=-1){farbe=ANSI_WHITE + ANSI_BOLD;}
      if (strstr(t1,"gruen",0)!=-1){farbe=ANSI_GREEN + ANSI_BOLD;}
       if (strstr(t1,"gelb",0)!=-1){farbe=ANSI_YELLOW + ANSI_BOLD;}
        if (strstr(t1,"violett",0)!=-1){farbe=ANSI_PURPLE + ANSI_BOLD;}
       if (strstr(t1,"schwarz",0)!=-1){farbe=ANSI_BLACK + ANSI_BOLD;}
        if (strstr(t1,"cyan",0)!=-1){farbe=ANSI_CYAN + ANSI_BOLD;}       
       

    {
        
         pl=TP->QueryProp(P_NAME);
              TP->restore_spell_points(-20);
         tt=explode(t1, " ");
         for (i=sizeof(tt)-1; i>=0; i--)
           tt[i]=capitalize(tt[i]);
         t1=implode(tt, " ");
         write("Die Farbteufelchen schreiben "+t1+" auf "+(ob->name())+".\n");
       ob->SetProp(P_LONG, oldlong+"\n"
     ""+capitalize(pl)+" hat folgendes auf "
     ""+(ob->name())+" malen lassen:\n"
     ""+farbe+""
     ""+capitalize(t1)+""+ANSI_NORMAL+"");
     ob->AddId("schonbemalt");
    return 1;   
         }                    
 //    write("stringresult:"+strresult+"\n");
                     
     return 0;
     }
   return 0;
   }
     

int paint2(string str)
{
 
 string oldlong, pl, farbe;
  int sp, i;
 object ob;
 string  t1, t2, *tt;
 farbe="";
  notify_fail("Was sollen die Farbteufel worauf malen?\n");
  if (!str) 
  {
  write("Du musst den Farbteufelchen schon sagen was sie malen sollen!\n");
  return 1;
  }
  
  if( sscanf(str, "%s auf %s",t1,t2))
        {
    if (!ob=present(t2,environment(TP)))
    {
    write("Ist nicht hier!\n");
    return 1;
    }
      sp=this_player()->QueryProp(P_SP);       
       if(sp<=20)      
        {
        
            write("Deine Magie reicht dafuer nicht aus!\n");
                return 1;
   }
   
    if(living(ob))
    { 
  write("Nein! So einfach kannst Du "+ob->name()+" nicht anmalen!\n");
         return 1;
         }
          
          
      oldlong=ob->QueryProp(P_LONG);
      
     if (strstr(t1,"rot",0) !=-1) {farbe=ANSI_RED + ANSI_BOLD;}
     if (strstr(t1,"blau",0)!=-1) {farbe=ANSI_BLUE + ANSI_BOLD;}
     if (strstr(t1,"weiss",0)!=-1){farbe=ANSI_WHITE + ANSI_BOLD;}
      if (strstr(t1,"gruen",0)!=-1){farbe=ANSI_GREEN + ANSI_BOLD;}
       if (strstr(t1,"gelb",0)!=-1){farbe=ANSI_YELLOW + ANSI_BOLD;}
        if (strstr(t1,"violett",0)!=-1){farbe=ANSI_PURPLE + ANSI_BOLD;}
       if (strstr(t1,"schwarz",0)!=-1){farbe=ANSI_BLACK + ANSI_BOLD;}
        if (strstr(t1,"cyan",0)!=-1){farbe=ANSI_CYAN + ANSI_BOLD;}       
       

    {
        
         pl=TP->QueryProp(P_NAME);
              TP->restore_spell_points(-20);
         tt=explode(t1, " ");
         for (i=sizeof(tt)-1; i>=0; i--)
           tt[i]=capitalize(tt[i]);
         t1=implode(tt, " ");
         write("Die Farbteufelchen schreiben "+t1+" auf "+(ob->name())+".\n");
       ob->SetProp(P_LONG, oldlong+"\n"
     ""+capitalize(pl)+" hat folgendes auf "
     ""+(ob->name())+" malen lassen:\n"
     ""+farbe+""
     ""+capitalize(t1)+""+ANSI_NORMAL+"");
     ob->AddId("schonbemalt");
    return 1;   
         }                    
 //    write("stringresult:"+strresult+"\n");
                     
     return 0;
     }
   return 0;
   }
 
     

int paint3(string str)
{
//monstermalen 
 string oldlong, pl, farbe;
  int sp, i;
 object ob;
 string  t1, t2, *tt;
 farbe="";
  notify_fail("Was sollen die Farbteufel worauf malen?\n");
  if (!str) 
  {
  write("Du musst den Farbteufelchen schon sagen was sie malen sollen!\n");
  return 1;
  }
  
  if( sscanf(str, "%s auf %s",t1,t2))
        {
    if (!ob=present(t2,environment(TP)))
    {
    write("Ist nicht hier!\n");
    return 1;
    }
    
     if(interactive(ob))
      {
      write("Nein! Das ist kein NPC, sondern ein Spieler!\n");
      return 1;
      }
    
    
      sp=this_player()->QueryProp(P_SP);       
       if(sp<=50)      
        {
        
            write("Deine Magie reicht dafuer nicht aus!\n");
                return 1;
   }
          
      oldlong=ob->QueryProp(P_LONG);
      
     if (strstr(t1,"rot",0) !=-1) {farbe=ANSI_RED + ANSI_BOLD;}
     if (strstr(t1,"blau",0)!=-1) {farbe=ANSI_BLUE + ANSI_BOLD;}
     if (strstr(t1,"weiss",0)!=-1){farbe=ANSI_WHITE + ANSI_BOLD;}
      if (strstr(t1,"gruen",0)!=-1){farbe=ANSI_GREEN + ANSI_BOLD;}
       if (strstr(t1,"gelb",0)!=-1){farbe=ANSI_YELLOW + ANSI_BOLD;}
        if (strstr(t1,"violett",0)!=-1){farbe=ANSI_PURPLE + ANSI_BOLD;}
       if (strstr(t1,"schwarz",0)!=-1){farbe=ANSI_BLACK + ANSI_BOLD;}
        if (strstr(t1,"cyan",0)!=-1){farbe=ANSI_CYAN + ANSI_BOLD;}       
       

    {
        
         pl=TP->QueryProp(P_NAME);
              TP->restore_spell_points(-50);
         tt=explode(t1, " ");
         for (i=sizeof(tt)-1; i>=0; i--)
           tt[i]=capitalize(tt[i]);
         t1=implode(tt, " ");
         write("Die Farbteufelchen schreiben "+t1+" auf "+(ob->name())+".\n");
       ob->SetProp(P_LONG, oldlong+"\n"
     ""+capitalize(pl)+" hat folgendes auf "
     ""+(ob->name())+" malen lassen:\n"
     ""+farbe+""
     ""+capitalize(t1)+""+ANSI_NORMAL+"");
     ob->Kill(TP);
     
    return 1;   
         }                    
                     
     return 0;
     }
   return 0;
   }


int paint4(string str)
{
 
 string oldlong, pl, farbe;
  int sp, i;
 object ob;
 string  t1, t2, *tt;
 farbe="";
  notify_fail("Was sollen die Farbteufel worauf malen?\n");
  if (!str) 
  {
  write("Du musst den Farbteufelchen schon sagen was sie malen sollen!\n");
  return 1;
  }
  
  if( sscanf(str, "%s auf %s",t1,t2))
        {
    if (!ob=present(t2,environment(TP)))
    {
    write("Ist nicht hier!\n");
    return 1;
    }
    
      
      sp=this_player()->QueryProp(P_SP);       
       if(sp<=50)      
        {
        
            write("Deine Magie reicht dafuer nicht aus!\n");
                return 1;
   }
   
   if(!interactive(ob))
      {
      write("Nein! So geht das nicht. Mit diesem Befehl kann man "
      "nur Spieler bemalen lassen! Also...\n");
      return 1;
      }
          
      oldlong=ob->QueryProp(P_EXTRA_LOOK);
      
     if (strstr(t1,"rot",0) !=-1) {farbe=ANSI_RED + ANSI_BOLD;}
     if (strstr(t1,"blau",0)!=-1) {farbe=ANSI_BLUE + ANSI_BOLD;}
     if (strstr(t1,"weiss",0)!=-1){farbe=ANSI_WHITE + ANSI_BOLD;}
      if (strstr(t1,"gruen",0)!=-1){farbe=ANSI_GREEN + ANSI_BOLD;}
       if (strstr(t1,"gelb",0)!=-1){farbe=ANSI_YELLOW + ANSI_BOLD;}
        if (strstr(t1,"violett",0)!=-1){farbe=ANSI_PURPLE + ANSI_BOLD;}
       if (strstr(t1,"schwarz",0)!=-1){farbe=ANSI_BLACK + ANSI_BOLD;}
        if (strstr(t1,"cyan",0)!=-1){farbe=ANSI_CYAN + ANSI_BOLD;}       
       

    {
        
         pl=TP->QueryProp(P_NAME);
              TP->restore_spell_points(-50);
         tt=explode(t1, " ");
         for (i=sizeof(tt)-1; i>=0; i--)
           tt[i]=capitalize(tt[i]);
         t1=implode(tt, " ");
         write("Die Farbteufelchen schreiben "+t1+" auf "+(ob->name())+".\n");
       ob->SetProp(P_EXTRA_LOOK, oldlong+"\n"
     ""+capitalize(pl)+" hat folgendes auf "
     ""+(ob->name())+" malen lassen:\n"
     ""+farbe+""
     ""+capitalize(t1)+""+ANSI_NORMAL+"\n");
     tell_object(ob,
     ""+TPN+" murmelt Deinen Namen in einen Kristallkubus.\n");
    return 1;   
         }
                     
     return 0;
     }
   return 0;
   }
