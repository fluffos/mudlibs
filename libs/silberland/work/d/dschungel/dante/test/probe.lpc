inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tireks");
  SetProp(P_LONG, BS(
    "Der Tireks ist ein abscheuliches Monster aus einer anderen Zeit. "
    "Mutige Abenteurer und waghalsige Forscher haben ihn in einer anderen Welt gefunden, gefangen und "
    "wollten ihn zu einer Attraktion machen. Doch leider hat der Tireks die "
    "Eigenschafft in unserer Welt unsichtbar zu sein, es sei denn man behandelt "
    "ihn mit einem Spezialspray, doch auch diese Wirkung haelt nur kurze Zeit an. "
    "Dieser Tireks ist allerdings nur eine Kopie aus Leder,Holz und Gummi. Er stellt "
    "eine Art Werbeattraktion dar..."));
    
  SetProp(P_NAME, "Tireks");
  SetProp(P_GENDER, MALE);
  AddId(({"tireks", "monster"}));
  set_living_name("tireks");

  create_default_npc(44);
  SetProp(P_HANDS, ({" mit seinen furchtbaren Klauen",350+random(50),({DT_RIP, DT_PIERCE, DT_BLUDGEON })}));
  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 800);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_FOOD,0);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_TERROR })); 
  SetProp(P_VULNERABILITY, ({ DT_LIGHTNING }));
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOATTACK, ({" Aber dieser Tireks ist doch nur ein Modell!"}));
  SetProp(P_MSGIN, "wird ploetzlich durch die magische Farbe sichtbar");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "wird ploetzlich durch die magische Farbe sichtbar");
  SetProp(P_MMSGOUT, "wird ploetzlich wieder unsichtbar");

  SetProp(P_DIE_MSG,  " stuerzt mit lautem Gebruell zu Boden und wird wieder unsichtbar.\n");
  SetProp(P_NOCORPSE, 1);
  
//  SetProp(P_MURDER_MSG, "blabla");
  SetProp(P_KILL_NAME, "Tireks");
  SetProp(P_KILL_MSG, "Der naechste bitte!!!");
  
  SetProp(P_ARTICLE, 0);
  AddInfo(DEFAULT_INFO, "bruellt Dich nur an.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll Tireks mit Deinem Schrott.\n" }) );

  SetProp(P_SPELLRATE,90);
  AddSpell(4,800,
    "Tireks schlaegt Dir seine Krallen in den Leib.\n",
    "Tireks schlaegt @WEM seine Krallen in den Leib.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    "Tireks huellt Dich in eine Feuerwolke ein.\n",
    "Tireks huellt @WEN in eine Feuerwolke ein.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,600,
    "Tireks versucht Dich mit seinen gewaltigen Beinen zu zertreten.\n",
    "Tireks versucht @WEN mit seinen gewaltigen Beinen zu zertreten.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,900,
    "Tireks probiert Dir den Kopf abzureissen.\n",
    "Tireks probiert @WESSEN Kopf abzureissen.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    "Tireks spuckt Fluesse von Magensaeure auf Dich.\n",
    "Tireks spuckt Fluesse von Magensaeure auf @WEN.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    "Tireks schlaegt Dir den Boden unter den Beinen weg.\n",
    "Tireks schlaegt @WEM den Boden unter den Beinen weg.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    "Tireks speit einen gewaltigen Wasserstrahl auf Dich.\n",
    "Tireks speit einen gewaltigen Wasserstrahl auf @WEN.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,150,
    "Tireks versetzt Dir einen extrem harten Schlag auf die Arme.\n",
    "Tireks versetzt @WEM einen extem harten Schlag auf die Arme.\n",
     DT_BLUDGEON,"spell_waffe");
  AddSpell(2,150,
    "Tireks schlaegt Dir mit ungeheurer Wucht auf den Oberkoerper.\n",
    "Tireks schlaegt @WEN mit ungeheurer Wucht auf den Oberkoerper.\n",
     DT_BLUDGEON,"spell_ruestung");
  AddSpell(1,150,
    "Tireks schlaegt Dir mit grosser Wucht auf den Kopf.\n",
    "Tireks schlaegt @WEN mit grosser Wucht auf den Kopf.\n",
     DT_BLUDGEON,"spell_sleep");
  AddSpell(1,100,
    "Tireks versucht Dir Deinen Koerper zu stehlen.\n",
    "Tirels versucht @WESSEN Koerper zu stehlen.\n",
    DT_MAGIC, "spell_ghost");


  SetAttackChats(10, ({
  "Tireks bruellt Dich laut an.\n",
  "Du zitterst aus Angst!\n",
  "Tireks kommt immer naeher an Dich heran.\n",
  "Du brichst beinahe zusammen.\n",
  "Tireks draengt Dich zurueck.\n",
  "Dein Atem rast dahin...\n",
  "Tireks kommt direkt auf Dich zu.\n",
  "Fluechte lieber...\n",
  "Tireks schaut Dir genau in die Augen.\n",
  "Tireks tobt wie wild...\n",
  "Tireks will Dich vernichten.\n"}) );


//call_out("invis1", 1000);

   SUID;
   CLONEME(WEAPON "wandler" );
   CLONEME(OBJ "auge");
}

 invis1()
  {
  object ob;
  if (ob=present("auge",TO))
   {
   ob->remove();
   }
   call_out("invis2",0);
   }
   
   
 invis2()
  {
  object ob;
  if (ob=present("wandler",TO))
  {
  ob->remove();
  }
  call_out("invis3",0);
 }
 //ich weiss nicht gerade elegant das da oben....
 
 invis3()
 {
 write("Tireks wird wieder unsichtbar.");
 remove();
 }
 
  void spell_ghost(object enemy, int damage, mixed dam_type)
  {
switch(random(100))
{
case 0 .. 50 :
    enemy->SetProp(P_GHOST, 1);
    tell_object(enemy,
    "Tireks beraubt Dich Deines Koerpers!\n");
    break;
    
case 51 .. 100 :
     tell_object(enemy,
     "Tireks schafft es nicht Dir Deinen Koeper zu stehlen!\n");
     
  }
 
}
 
  void spell_sleep(object enemy, int damage, mixed dam_type)
  {object ob;
   ob=CLONEOB(OBJ"bewust1");
   
  switch(random(100))
  {
  case 0 .. 50:
 // object ob;
 // ob=CLONEOB(OBJ"bewust1");
  ob->move(enemy, M_NOCHECK);
  break;
  
  case 51 .. 100:
  tell_object(enemy,
  "Du taumelst umher, wirst aber nicht ohnmaechtig.\n");
  }
  
  }


void spell_ruestung(object enemy,int damage, mixed dam_type)
 {
   int groesse;
   object* ob;
   ob=enemy->QueryProp(P_ARMOURS);
   groesse=sizeof(ob);
   
   if(groesse)
   {
   ob[random(groesse)]->remove();
   tell_object(enemy,
   "Tireks zerbroeselt Deine Ruestung!\n");
   }
   
   
  else
  {
   enemy->do_damage(20)+random(10);
    tell_object(enemy,
    "Tireks bricht Dir fast die Rippen.\n");
   } 
    
  }
    
 void spell_waffe(object enemy,int damage, mixed dam_type)
  {
   object ob1;
   string waffenname;
   ob1=enemy->QueryProp(P_WEAPON);
   
   if (ob1 && !(ob1->QueryProp(P_CURSED)))
   {
   tell_object(enemy,
   "Tireks schlaegt Dir Deine Waffe aus der Hand und vernichtet sie.\n");
   ob1->remove();
   
   }
   else
   
   tell_object(enemy,
   "Tireks trifft Dich sehr hart.\n");
   enemy->do_damage(20)+random(10);
   
   }

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{

domainshout(""+this_player()->name(WER,RAW)+" hat Tireks besiegt !\n");
  write_file(LOG "tireks",
   ctime()+": "+CAP(getuid(PL))+" killt Tireks.\n");
     ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{

  write_file(LOG "tireks",
    ctime()+": Tireks hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
  command_me("iss leiche");
  heal_self(100);
  domainshout("Tireks hat gerade die Leiche von "+player->QueryProp(P_NAME)+" verschlungen!\n");
}

