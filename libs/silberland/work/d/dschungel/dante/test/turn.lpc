//invis obj fuer fdrehwurm
//kein dammage nur spass....moeglichweweise verwirrug des orietierungssinns
//mal sehn dante 98 sl

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

int count;


create()


{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
count = 0;

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"drehwurmturn","turn"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 call_out("a", 10);
 
}
   
   a()
   {
   write("Du fuehlst wie irgendetwas in Dir herumkriecht.\n");
   say(CAP_TPN+" zuckt. Ein winziger Wurm lugt aus "+CAP_TPN+"`s Ohr hervor.\n");
   call_out("b", 20);
   }
   
   b()
   {
   write("Du spuerst genau wie irgendetwas in Deinem Kopf herumkriecht.\n");
   say(CAP_TPN+" tastet aengstlich den Kopf ab.\nIrgendetwas kriecht in "
   ""+CAP_TPN+"'s Kopf herum. Kein schoenes Gefuehl!\n");
   call_out("c", 20);
   }
   
   c()
   {
    if (count)>=20)
       {
    call_out("ende", 30);
        }
    else
        {
    
    switch(random(10))
         {
      case 0:
             write("Du scheinst den Drehwurm zu haben!\n"
             "Du drehst Dich um die eigene Achse!\n");
             say(CAP_TPN+" hat den Drehwurm!\n"
             ""+CAP_TPN+" dreht sich um die eingene Achse.\n");
             count++;
             break;
      case 1:
      write("Du drehst Dich wie wild herum.\n");
      say(CAP_TPN+" dreht sich wie wild herum.\n");
      count++;
      break;       
      case 2:
      write("Dir wird schwindlig vom vielen Herumdrehen!\n");
      say(CAP_TPN+" wird vom vielen Herumdrehen gruen im Gesicht.\n");
      count++;
      break;
      case 3:
      write("Du drehst Dich wie ein irrer Kreisel herum.\n");
      say(CAP_TPN+" dreht sich wie ein irrer Kreisel herum.\n");
      count++;
      break;
      case 4:
      write("Der Drehwurm zwingt Dich zu einer ganzen Drehung!\n");
      say(CAP_TPN+" macht eine ganze Drehung!\n");
      count++;
      break;
      case 5:
      write("Der Drehwurm dreht sich und Dich herum!\n");
      say(CAP_TPN+" wird vom Drehwurm herumgedreht!\n");
      count++;
      break;
      case 6:
      write("Du drehst Dich wie eine Ballerina mit Kinderlaehmung im Kreis.\n");
      say(CAP_TPN+" dreht sich wie eine Ballerina mit Kinderlaehmung im Kreis.\n");
      count++;
      break;
      case 7:
      write("Wummm!!!Du drehst Dich und landest unsanft am Boden!\n");
      say(CAP_TPN+" dreht sich und landet unsanft am Po!\n");
      count++;
      break;
      case 8:
      write("Du machst eine grazioese Drehung! Grazioes wie ein besoffenes Nashorn!\n");
      say(CAP_TPN+" dreht sich grazioes wie ein besoffenes Nashorn!\n");
      count++;
      break;
      case 9:
      write("Du drehst Dich wild im Kreis und stoesst ueberall an!\n");
      say(CAP_TPN+" freht sich und rammt Dich dabei! Flegel!\n");
      count++;
      break;
      default:write("BUG!\n");
      
      call_out("c", 30);
      }
     }
     
     
     ende()
     {
     write("Der Drehwurm scheint Dich nicht mehr zu drehen!\n");
     say(CAP_TPN+" ist vom Drehwurm erloest!\n");
     TO->remove();
     }
     
        