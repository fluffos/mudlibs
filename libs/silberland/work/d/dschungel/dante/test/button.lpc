// dante@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein BREZEL-LIEBT-DICH-BUTTON");
  SetProp(P_LONG, BS(
  "Brezel liebt Dich und Du ihn!!\n")), 
  SetProp(P_NAME, "BREZEL-LIEBT-DICH-BUTTON");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
 // SetProp(P_INFO, ("Der Button leuchtet im Dunkeln! \n"));
  SetProp(P_MATERIAL, MAT_PLASTIC );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 1800);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  AddId( ({"button"}) );

}

string extra_look()
{
  return( CAP(ENV(TO)->QueryPronoun(WER))+" traegt "+
    ENV(TO)->QueryPossPronoun(MALE, WEN, SINGULAR)+ " BREZEL-LIEBT-DICH-Button "
    "voller Liebe zu Brezel.\n");
}
