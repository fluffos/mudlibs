#include "files.h"
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "files.h"

int x;
int loesung;
create()
{
  
loesung=1+random(24);
x=0;




	if(!is_clone(ME)) return;
	::create();
        AddId("stele");
	SetProp( P_SHORT, "Eine seltsame Stele" );
	SetProp( P_LONG,BS(
        "Keien ahnugn was das wird."));
        SetProp(P_GENDER, FEMALE);
        SetProp(P_NAME, "Stele");
        SetProp(P_NOGET, 1);
        SetProp(P_MATERIAL, MAT_STONE);



      AddCmd(({"rolle", "roll"}), "in");

         
}


in (string str)
{
   int a;
   
   
    notify_fail("Was willst?\n");
    if (!str) return 0;
 
    if(x>0)
    {
    
    write("WARTE!\n");
    return 1;
    }
    
 
    if(loesung==1) {a="blau,rot,gruen,weiss";}
    if(loesung==2) {a="blau,gruen,rot,weiss";}
    if(loesung==3) {a="blau,rot,weiss,gruen";}
    if(loesung==4) {a="blau,gruen,weiss,rot";}
    if(loesung==5) {a="blau,weiss,rot,gruen";}
    if(loesung==6) {a="blau,weiss,gruen,rot";}
    
    if(loesung==7) {a="weiss,rot,gruen,blau";}
    if(loesung==8) {a="weiss,rot,blau,gruen";}
    if(loesung==9) {a="weiss,blau,rot,gruen";}
    if(loesung==10) {a="weiss,blau,gruen,rot";}
    if(loesung==11) {a="weiss,gruen,rot,blau";}
    if(loesung==12) {a="weiss,gruen,blau,rot";}
    
    if(loesung==13) {a="gruen,blau,rot,weiss";}
    if(loesung==14) {a="gruen,blau,weiss,rot";}
    if(loesung==15) {a="gruen,weiss,rot,blau";}
    if(loesung==16) {a="gruen,weiss,blau,rot";}
    if(loesung==17) {a="gruen,rot,weiss,blau";}
    if(loesung==18) {a="gruen,rot,blau,weiss";}
    
    if(loesung==19) {a="rot,blau,weiss,gruen";}
    if(loesung==20) {a="rot,blau,gruen,weiss";}
    if(loesung==21) {a="rot,gruen,blau,weiss";}
    if(loesung==22) {a="rot,gruen,weiss,blau";}
    if(loesung==23) {a="rot,weiss,gruen,blau";}
    if(loesung==24) {a="rot,weiss,blau,gruen";}
    
   
   else("write: BUG!\n");
   
   
   if( (loesung >=19) && 
    (str=="rot,blau,weiss,gruen"||str=="rot,blau,gruen,weiss"||1~
     str=="rot,gruen,blau,weiss" || str=="rot,gruen,weiss,blau"||
    str=="rot,weiss,gruen,blau"|| str=="rot,weiss,blau,gruen"));
    {
    write("Rot ist korrekt!\n");
    return 1;
    }



    
    if(str==""+a+"")
    {
    x=1;
    write("richtig!\n");
    call_out("new", 0);
    
    return 1;
    }
    
    else
    {
    x=1;
    
       call_out("new", 0);
            
    write("Loesung waere:"+a+"!\n");
    return 1;
    }
    
    return 0;
    }
    
  new()
  {
  x=0;
  loesung=1+random(24);;
  return ;
  }
  