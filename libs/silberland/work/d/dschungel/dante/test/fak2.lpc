//zt bei kiste
inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <pub.h>
#include "files.h"



create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Schneckenhaus");
  SetProp (P_INT_LONG, BS(
  "Du befindest Dich nun im Schneckenhaus, besser gesagt in einer kleinen "
  "Kneipe die im Schneckenhaus ist. Einrichtung gibt es hier kaum. Weder Baenke "
  "noch Tische. Alles ist ziemlich leer, wie eben ein Schneckenhaus ohne Schnecke "
  "so ist. An einer der Waende haengt eine Tafel. Darunter ist ein kleiner "
  "Eisblock auf dem die Getraenke und Speisen gelagert werden. Durch eine "
  "kleine Oeffnung komsmt Du wieder raus. Mit < unt umgebung> kannst Du sehen wo "
  "Du Dich gerade befindest."));
  
  
  AddSpecialDetail("umgebung", "look");
  AddDetail(({"stich", "sonnenstich"}),
  "Draussen ist es ziemlich warm. Du solltest Dich vor der Sonne schuetzen...");
  AddDetail("sonne",
  "Hier dringt sie nur sehr spaerlich ein.");
  AddDetail("tafel",
  "Mit <menue> kannst Du sie lesen.");
  AddDetail("einrichtung",
  "Die Einrichtung besteht aus einem Eisblock und einer Tafel.");
  AddDetail(({"baenke","bank","tisch","tische"}),
  "Doch in einer Ecke steht eine imanginaere Bank. Du hast wohl einen Sonnenstich!");
  AddDetail(({"eck","ecke"}),
  "Gibt es hier nicht, das Haus ist rund.");
  AddDetail("himmel",
  "Den Himmel kann man hier natuerlich nicht sehen.");
  AddDetail("schnecke",
  "Die hat hier frueher mal gelebt.");
  AddDetail(({"wand","waende"}),
  "Die Waende sind glatt und sauber. An einer der Waende haengt eine Tafel. "
  "Gegenueber sieht man eine kleine Oeffnung.");
  AddDetail(({"eisblock","block"}),
  "Der Eisblock haelt die Getraenke und Speisen kuehl. Du wunderst Dich, dass "
  "er nicht zerrinnt. naja, hier ist es ueberhaupt angenehm kuehl.");
  AddDetail(({"getraenk","getraenke","speisen","speise"}),
  "Du siehst alles moegliche auf dem Eisblock. Glaeser, Flaschen, eine kleine Kiste...");
  AddDetail("kiste",
  "Die Kiste ist belanglos, oder doch nicht...");
  
  
  AddDetail(({"glas","glaeser"}),
  "Du bekommst Durst!");
  AddDetail(({"flasche","flaschen"}),
  "Hmm, was da wohl alles drin ist.");
  
  AddDetail("oeffnung",
  "Durch sie kommst Du wieder raus.");
  AddDetail("boden",
  "Der Boden ist sauber und besteht aus Chitin und Horn.");
  AddDetail(({"horn","chitin"}),
  "Daraus besteht das Schneckenhaus.");
   AddDetail(({"haus","kneipe","schneckenhaus"}),
   "Du stehst mitten drin!");
   
   
   
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "mini");
  SetProp(P_PUBKEEPER_NAME, "Mini");
  SetProp(P_PUBMSG_NOKEEPER, "Mini, die Wirtin ist nicht da.\n");
  SetProp(P_PUBMSG_NOENEMY, BS("Aber Du kaempfst doch gerade mit Mini , glaubst "
      "Du im Ernst, dass sie Dir dann auch noch etwas servieren wuerde???"));
  SetProp(P_PUBMSG_NOINVITE, BS("Mini denkt gar nicht daran, ihren Gegnern "
      "auch noch etwas zu servieren."));
  SetProp(P_PUBMSG_FIGHTING, "Mini hat gerade was zu tun!!!\n");
  AddSound (DEFAULT_SOUND,
    "Von draussen hoerst Du den Laerm des Dschungels.\n");

  AddSmell(DEFAULT_SMELL,
  "Es riecht nach...hmm...Schnecke???\n");
  

AddCmd(({"oeffne","mach","schliesse","schliess"}),"noopen");
AddCmd(({"steige","kletter","steig","klettere"}),"get");


  AddDrink("Cola light", ({"cola light", "cola","light"}),
           40, 8, 0, 5,
           ({
             "Mini bringt Dir ein Glas Cola light."+
             "Viel Geschmack, keine Kalorien!",
             "&& bekommt von Mini ein Glas Cola light."}));

  AddDrink("Pepsi Max", ({"max", "pepsi max", "pepsi"}),
           50, 10, 0, 7,
           ({
             "Mini bringt Dir Dein eiskaltes Pepsi Max."+
             "Du spuerst den Geschmack einer neuen Genration!",
             "&& schuettet gierig ein eiskaltes Pepsi Max runter."}));

  AddDrink("Schneckensaft",({"saft","schneckensaft"}),      // Name, IDs,
           70, 12, 0, 10,                       // Preis, LP, Alk, Saettigung,
           ({"Mini bringt Dir ein kleines Glas Schneckensaft, "+
             "dass Du vorsichtig anschaust und dann runterwuergst. "+
             "Waeh! Eklig!",
             "&& trinkt mit verzerrtem Gesicht ein Glas mit braunem Schneckensaft.\n"+
             "Dann wuergt && herum..."}));

  AddDrink("Dschungelpils", ({"pils", "dschungel pils", }),
           100, 15, 5, 12,
           ({"Mini serviert Dir ein Dschungelpils.",
             "&& trinkt mit lautem Ruelpsen ein Dschungelpils."}));

  AddDrink("Schlammwein", ({"wein","schlammwein","schlamm"}),
  150, 17,7,14,
           ({"Mini bringt Dir Dein Glaeschen Schlammwein. "+
             "Er schmeckt genauso wie er heisst, schlammig!",
             "&& geniesst ein Glaeschen schlammigen Schlammwein."}));

  AddDrink("Affenschnaps", ({"affenschnaps", "schnaps"}), 200, 22, 10, 3,
           ({"Mini bringt Dir Deinen Affenschnaps.\n"+
             "Du trinkst ihn und springst dann wie ein Affe herum!",
             "&& kippt ein Stamperl Affenschnaps runter, springt "+
             "dann wie ein Affe herum."}));

  AddDrink("Kannibalentod", ({"kannibalentod", "tod", "kannibale"}),
           300,25,12,6,
           ({ "Mini bringt Dir einen hohlen Schaedel, gefuehlt mit "
              "einer blutroten Fluessigkeit. Du leerst das Zeug runter und "
              "fuehlst Dich stark wie ein Kannibale!",
              "&& bestellt sich einen Kannibalentod und bruellt dabei wie am "
              "Spiess!" }));


  AddDrink("Malariabrand", ({"malaria","malariabrand","brand"}),
  400, 30,10,9,
           ({"Mini bringt Dir Dein Glas Malariabrand."+
           "Es macht seinem Namen alle Ehre!",
             "&& geniesst ein Glaeschen Malariabrand und roechelt dann."}));

  AddDrink("Tigerblut", ({"tiger","tigerblut","blut"}),
  1000, 100,25,20,
           ({"Mini bringt Dir Dein Glas Tigerblut."
           "Du trinkst es aus und denkst Dir waechst ein Fell!!!ROARRRR!!!",
           "&& trinkt Tigerblut und schaut Dich hungrig an!"}));


  AddFood("Bananenmatsch",({"bananen","matsch","bananenmatsch"}),
  50, 5,5,
  ({"Du bekommst zermatsche Bananen von Mini.", 
  "&& isst zermatsche Bananen!"}));


  AddFood("Moskitosandwich",({"moskito","sandwich","moskitosandwich"}),
  70, 7,6,
  ({"Du isst ein Sandwich, das mit Moskitos belegt ist. "
  "Irgendwie ist Dir nun flau im Magen!", 
  "&& isst ein Moskitosandwich."}));
  
  
  AddFood("Schlangensuppe",({"suppe","schlangensuppe","schlange"}),
  90, 8 ,4,
  ({"Du loeffelst eine Schlangensuppe!",
  "&& loeffelt eine Schlangensuppe."}));



  AddFood("Spielerkeule",({"keule","spieler","spielerkeule"}),
  100, 10,10,"iss_spieler");
  
  AddFood("Affenhirn",({"hirn","affenhirn","affe"}),
  150, 17,12,
  ({"Du bestellst ein Affenhirn, isst es auf und fuehlst Dich "
  "danach viel schlauer.",
  "&& isst ein Affenhirn un glaubt nun klueger zu sein!"}));
    
  
  AddFood("Tapirmilz",({"milz","tapirmilz","tapir"}),
  200, 20 ,13,
  ({"Du isst die Milz eines Tapirs!",
  "&& frisst die Milz eines Tapirs."}));

  
  
  AddFood("Ein halber Kanninale",({"kannibale","halber kannibale"}),
  250, 25,17,
  ({"Du frisst einen halben Kannibalen!!!", 
  "&& frisst einen halben Kannibalen"}));
  
  
  AddFood("Wurtsmagier",({"magier","wurst","wurstmagier"}),
  350, 30,20,
  ({"Du bekommst eine Riesenwurst, die einen Magier darstellt. "
  "Sie schmeckt irgendwie faul...", 
  "&& frisst Wurstmagier gerne auf"}));
  
  
  AddFood("Kobraspaghetti",({"kobra","kobraspaghetti","spaghetti"}),
  500, 50,25,
  ({"Du bekommst einige verwickelte Jungkobras mit Sauce! "
  "Langsam lasst Du sie in Deinen Mund gleiten!", 
  "&& frisst verwickelte Kobras mit Sauce!"}));
  
  
  AddCmd (({"kauf","kaufe","bestell","bestelle"}),"bestelle");
  AddCmd (({"spendier","spendiere"}),"spendiere");
  AddCmd ("","able",1);

 AddSpecialExit("raus", "find");

//  AddItem (NPC "mini", REFRESH_REMOVE);

}


 int iss_spieler(object e, object z)
    {
    
    
    
    
      tell_object(e,BS(mess(
      "Du bestellst eine Spielerkeule und bekommst von Mini eine  "+e->name()+"-Keule "
      "serviert! Etwas verwundert und angeekelt isst Du alles auf!",e)));

      tell_room(ME,BS(e->Name()+" bestellt eine Spielerkeule und bekommt kurz "
     "darauf von Mini eine  "+e->name()+"-Keule serviert. Kannibale!!!"), ({e}));  
                  
      }
          



 get(string str)
  {
  notify_fail("Was willst Du mit der Kiste machen?\n");
  if (!str) return 0;
     if(member(({"auf kiste", "auf kiste rauf","hinauf auf kiste","auf kiste hinauf"}),str)!=-1)
         {
         
          if( this_player()->FindPotion(     
          "Du kletterst auf die Kiste und ploetzlich faellt eine kleine Zauberschnecke\n"
          "von der Decke genau in Deinen Mund!!! Du freust Dich sehr!!!\n"))
          return 1;
          
   //  WLOG(LOG "schnecken_zt", "findet den ZT im Schneckenhaus");    
           
              
                else
             
                     {
                     say(""+TPN+" faellt von der Kiste herunter!\n");
                     
                     TP->do_damage(5);
               write("Du kletterst auf die Kiste, die Kiste wackelt und Du stuerzt herab!!!\n");
               return 1;
                    }
              return 1;
              }
         return 0;
          }
                            
 noopen(string str)
   {
   notify_fail("Was willst Du mit der Kiste machen?\n");
   if (!str) return 0;
      if(member(({"kiste","kiste auf"}),str)!=-1)
          {
          write("Du versuchst die Kiste irgendwie zu oeffnen, aber so "
          "scheint das nicht zu klappen. Vielleicht kann man ja mit der Kiste "
          "etwas anderes machen!\n");
          say(""+TPN+" macht sich an der Kiste zu schaffen.\n");
          return 1;
          }
     return 0;
     }
          


look()
  {
  
     object ob;
     ob = find_living("schneckenhaus");

     if(objectp(ob))
     
     return("Du schaust durch die kleine Oeffnung nach draussen:\n"+environment(ob)->QueryProp(P_INT_LONG));
     
     else
     
     return BS("Die Umgebung sieht langweilig aus.\n");
     
     }
      
     
            
   find()
    {
   object ob;
   ob = find_living("schneckenhaus"); 
       
       
   if(objectp(ob))
    TP->move(environment(ob), M_GO);
    else
   TP->move("/d/dschungel/dante/weg/room/weg14", M_GO);
   return 1;
       }                                                      
                                                               
       
