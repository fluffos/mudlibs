/*
** giftstachel fuer den skorpion 
** dante sl 97 jaenner
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"stachel", "giftstachel"}));
  SetProp (P_SHORT, "Ein Giftstachel");
  SetProp (P_LONG, "Du siehst den Stachel eines Riesenskorpions vor Dir und bist "
         "heilfroh, dass der ehemalige Besitzer nicht hier ist.\n");
  SetProp (P_NAME, "Stachel");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 500);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, ({DT_PIERCE,DT_RIP,DT_POISON}));
  SetProp (P_WC, 60);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
