// 
// buschmesser dante 97
// 

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Buschmesser");
  SetProp(P_LONG, BS( 
    "Dieses Messer benoetigt man im Dschungel um sich einen Weg durch das"
    " Dickicht zu schlagen. Es ist aber auch eine recht brauchbare Waffe.\n"));
 
  SetProp(P_NAME,"Buschmesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "buschmesser"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC,65);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 60);
  SetProp(P_MATERIAL, MAT_METAL);
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE,280);
  SetProp(P_NOBUY, 0);
}
