// ochenschwert duer die kannibalen
// dante 97 jaenner

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Knochenschwert");
  SetProp(P_LONG, BS( 
  "Diese Waffe wurde von den Kannibalen aus einem Oberschenkelknochen "
  "eines grossen Tieres gefertigt. In den richtigen Haenden kann es "
  "grossen Schaden zufuegen.\n"));
    
  SetProp(P_INFO, "Diese Waffe wurde aus den Knochen des ehemaligen Abenteurers Dante gemacht.");
  
  SetProp(P_NAME, "Knochenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert","knochenschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 110);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_BLUDGEON,DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 90);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
  AddDetail(({"knochen","tier","oberschenkelknochen"}),
  "Die Laenge des Schwertes ist beachtlich, es muss sich einst um ein"
  " gewaltiges Tier gehandelt haben.\n");
  AddDetail(({"kannibalen","kannibale"}),
  "Sei froh, dass im Moment keiner hier ist!\n");
  
 }