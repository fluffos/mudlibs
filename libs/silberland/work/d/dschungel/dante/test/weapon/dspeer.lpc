// ein speer von dante fuer die lieben kannibalen kinder


#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Bambusspeer");
  SetProp(P_LONG, BS( 
    "Dieser Speer ist eigentlich nichts anderes als ein langes Bambusrohr,"
    " mit einer Spitze, die aus vielen kleinen messerscharfen Obsidiankristallen"
    " besetzt ist.\n"));
  SetProp(P_NAME, "Speer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer","bambusspeer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC,60);
  SetProp(P_DAM_TYPE, DT_RIP);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,({MAT_WOOD,MAT_JEWEL}));
  SetProp(P_WEIGHT,2000);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 0);
  AddDetail(("spitze"),
   "Die Spitze funkelt und blitzt im Sonnenlicht wircklich gefaehrlich.\n");
 AddDetail(({"obsidian","kristalle","obsidiankristalle"}),
  "Der Obsidian ist ein wertvoller Halbedelstein, der von den Kannibalen"
  " vor allem zur Verbesserung ihrer Waffen verwendet wird.\n");  
}