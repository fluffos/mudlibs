// schaedelkeule fuer die lieben kannibalen...dante 97 jaenner..


#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Schaedelkeule");
  SetProp(P_LONG, BS( 
    "Diese Keule ist eigentlich keine wirckliche Keule sondern aehnelt am"
    " ehesten einem Morgenstern. Der einzige Unterschied ist, dass hier der"
    " Schaedel eines Abenteurers verwendet wird.\n")); 
  AddDetail(({"schaedel","abenteurer"}),
  "Taeuscht Du Dich, oder hat Dich der Schaedel eben angegrinst...\n");
  SetProp(P_NAME, "Schaedelkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schaedelkeule", "keule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 80);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 80);
  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 350);
  SetProp(P_NOBUY, 0);


}
