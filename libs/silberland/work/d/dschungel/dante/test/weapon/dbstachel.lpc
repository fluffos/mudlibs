// bienenstachel

#include "files.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Bienenstachel");
  SetProp(P_LONG, BS( 
    "Der kleine, aber spitze Stachel einer Biene.") );
  SetProp(P_INFO, "Der Stchel tut sicher weh...");
  SetProp(P_NAME, "Bienenstachel");
  SetProp(P_GENDER, MALE);
  AddId( ({"bienenstachel", "stachel"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 50);
  SetProp(P_DAM_TYPE, ({DT_PIERCE,DT_RIP}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 0);


}

