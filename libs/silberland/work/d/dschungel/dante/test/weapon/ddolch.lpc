// dolch fuer den obermacho der kannibalen

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Opferdolch");
  SetProp(P_LONG, BS( 
  "Dieser Dolch gehoert zu einem grausigem Ritual, das der Kannibalenpriester "
  "vor der tobenden Menge vollzieht. Er dient zum Aufschlitzen der Opfer und "
  "ist dementsprechend scharf.\n"));
    
  SetProp(P_INFO, "An dieser Waffe klebt das Blut vieler Abenteurer. ");
  
  SetProp(P_NAME, "Opferdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch","opferdolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 90);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 40);
  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 1);
  AddDetail(({"kannibalenpriester","priester", "menge","ritual"}),
  "Das unglueckliche Opfer wird dabei auf einem grossen Stein in der Mitte des "
  " Dorfes vom Priester aufgeschlitzt, der dann als erster das frische Blut "
  "trinkt.\n");
  AddDetail(({"kannibalen","kannibale"}),
  "Sei froh, dass im Moment keiner hier ist!\n");
  
 }