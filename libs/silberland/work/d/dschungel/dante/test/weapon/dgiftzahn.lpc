/*
** giftzahn fuer die schlangen
** dante sl 97 jaenner
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"zahn", "giftzahn"}));
  SetProp (P_SHORT, "Ein Giftzahn");
  SetProp (P_LONG, "Dieser Zahn gehoerte einst einer Satanskobra. Er fuehlt sich in"
         " Deiner Hand sehr gut an und gibt sicher eine brauchbare Waffe ab.\n");
  SetProp (P_NAME, "Zahn");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 700);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, ({DT_PIERCE,DT_RIP,DT_SLASH,DT_POISON}));
  SetProp (P_WC, 100);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
