//pfahl von vlad dem sack:)

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <new_skills.h>
#include "files.h"


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Vlads Pfahl");

  SetProp (P_LONG,BS(
  "Das ist der Pfahl von Vlad, dem Pfaehler. Ein langes, zugespitzes "
  "Stueck Holz.")); 
     
  SetProp (P_NAME, "Vlads Pfahl");
  SetProp (P_GENDER, MALE);

  AddId (({"holz", "pfahl","vlads pfahl"}));

  SetProp (P_VALUE, 1800+random(500));
  SetProp(P_WEIGHT, 1000);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, ({DT_PIERCE,DT_TERROR}));
  SetProp(P_NOBUY, 1);
  SetProp (P_WC, 0);
  call_out("t", 0);
  SetProp(P_MATERIAL, ({MAT_OAK, MAT_SHADOW}));
  SetProp (P_NR_HANDS, 1);
  SetProp(P_INFO, BS("Der Pfahl ist eine boese Waffe. Seltsamerweise ist "
  "der Pfahl immer unterschiedlich stark. Mit <staerke> kannst Du sehn "
  "wie gut dein Pfahl ist!\n"));
  AddCmd("staerke", "show");
}


   show()
   {
   if(TO->QueryProp(P_WC)==100)
   {
   write("Dein Pfahl ist schwach!\n");
   return 1;
   }
   else
   {
   write("test\n");
   return 1;
   }
   return 0;
   }
   
   
   
  t()
   {
   switch(random(16))
       {
       case 0  :
       SetProp (P_WC, 100);
       break;
       case 1..4 :
       SetProp(P_WC, 150);
       break;
       case 5 ..8:
       SetProp(P_WC, 200);
       break;
       case 9 ..12:
       SetProp(P_WC, 225);
       break;
       case 13 ..14:
       SetProp(P_WC, 250);
       break;
       case 15:
       SetProp(P_WC, 275);
       break;
       default:write("BUG!\n");
       }
   }
