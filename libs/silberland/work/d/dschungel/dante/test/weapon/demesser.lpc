// 
// ernte messer dante 97
// 

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Erntemesser");
  SetProp(P_LONG, BS( 
    "Dieses Messer benoetigt die Plantagenarbeiter von Tijara fuer die Pflege"
    " und Ernte der Obstbaeume.\n"));
 
  SetProp(P_NAME,"Erntemesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "erntemesser"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC,65);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 70);
  SetProp(P_MATERIAL, MAT_METAL);
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE,280);
  SetProp(P_NOBUY, 0);
}
