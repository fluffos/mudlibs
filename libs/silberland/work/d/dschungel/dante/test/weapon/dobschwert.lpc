// obsidianschwert fuer den obermacker der kannibalen


#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Obsidianschwert");
  SetProp(P_LONG, BS( 
    "Diese Waffe besteht aus purem Obsidian, der mit einer duennen Schicht"
    " Hwaxanocium ueberzogen ist. Es stammt aus der sagenumwobenen Schmiede"
    " von N'KhadourAztec, die tief im Dschungel verborgen liegen soll. Du "
    "wunderst Dich wie die Kannibalen zu solch einer Waffe kommen. Die"
    " Klinge ist wellenfoemig und der Griff symbolisiert einen Ankh.\n"));  
  AddDetail(({"schicht","hwaxanocium"}),
  "Dieses extrem harte Metall findet man in den Minen vom K'Ndour, die aber"
  " schon seit Jahrhunderten verschuettet sind.\n");
  SetProp(P_INFO, "Dieses Schwert hat eine vergiftete Klinge. ");
  AddDetail(("obsidian"),
  "Obsidian ist ein Halbedelstein, der in dieser Region sehr gefragt ist."
  " Er wird vor allem zur Veredelung von Waffen verwendet.\n");
  AddDetail(("schmiede"),
  "Diese Schmiede hat noch nie ein Sterblicher erblickt. Vielleicht ist sie"
  " doch nur zum Reich der Mythen zu zaehlen.\n");
  AddDetail(("klinge"),
  "Die Klinge windet sich wie eine giftige Schlange empor.\n");
  AddDetail(({"ankh","griff"}),
  "Warum der Griff gerade diese Form hat ist dir unerklaerlich, aber irgendeine"
  " geheimnisvolle Bewandnis wird es damit schon auf sich haben.\n");
  SetProp(P_NAME, "Obsidianschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert","obsidianschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC,160);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_BLUDGEON,DT_POISON,DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,({MAT_METAL,MAT_JEWEL}) );
  SetProp(P_WEIGHT, 6000);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  
  
}

