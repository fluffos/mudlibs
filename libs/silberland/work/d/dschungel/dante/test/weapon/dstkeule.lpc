/*
** ne stein keule
** 
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <wizlevels.h>
#include "files.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"steinkeule","keule"}));
  SetProp (P_SHORT, "Eine riesige Granitkeule");
  SetProp (P_LONG, "Die Granitkeule ist gewaltig gross und sehr schwer, aber sie verursacht auch gewaltigen Schaden.");
  SetProp(P_NOBUY, 1); 
  SetProp (P_NAME, "Granitkeule");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_INFO, "In der Granitkeule haben die Steingiganten einen Geist gefangen, der viele Jahre lang ihr Gegner war. Diese Waffe wirkt daher besonders gut gegen die Steingiganten, hat aber doch ihre Eigenheiten.");
  SetProp (P_VALUE, 3000);
  SetProp (P_WEIGHT, 4500);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, DT_BLUDGEON);
  SetProp (P_WC, 130);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, MAT_STONE);
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  call_out("destroy", 3600);

  SetProp(P_NODROP, 1);
  SetProp(P_NOSELL, 1);

}
int WieldFunc(object waffe)
{
if ( TP->QueryAttribute(A_STR)<16 )
{
write("Du bist nicht stark genug um diese Waffe zu fuehren.\n");
return 0;
}
return 1;
}

int HitFunc(object enemy)
{
if ( enemy->id("steingigant") )
{
 write("Der Geist der Granitkeule will den Giganten vernichten.\n");

 return 100*enemy->QueryProp(P_LEVEL)+TP->QueryProp(A_STR)*100;
 }
 write(CAP(enemy->name(WER) )+" ist mit dieser Granitkeule nicht zu treffen.\n");
 return -150;
 
 }
 
 

destroy()
{
write(
" \n"
"Der Geist der Granitkeule will ausbrechen...\n");
call_out("destroy2",1800);
}

destroy2()
{
write(
" \n"
"Die Granitkeule zerbroeselt...\n");
call_out("destroy3",1800);
}

destroy3()
{
write(
" \n"
"Der Geist der Granitkeule will ausbrechen...\n");
call_out("destroy4",1800);
}

destroy4()
{
write(
" \n"
"Die Granitkeule zerbroeselt immer mehr...\n");
call_out("destroy5",1800);
}

destroy5()
{
write(
" \n"
"Die Granitkeule zerfaellt zu Staub und der ehemals eingesperrte Geist ist wieder frei.\n");
remove("granitkeule");
}
