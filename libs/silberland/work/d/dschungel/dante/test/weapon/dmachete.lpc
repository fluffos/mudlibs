// DANTE
// 97 sl
// 

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
      ::create();

  SetProp(P_SHORT, "Eine Machete");
  SetProp(P_LONG, BS( 
    "Die Machete ist ein besonders scharfes und langes Buschmesser. Sie "
    "dient nicht nur dazu sich den Weg durch den Dschungel frei zu schlagen,"
    " sondern ist auch als Waffe gut zu gebrauchen.\n"));
                                                                                              
  SetProp(P_NAME,"Machete");
  SetProp(P_GENDER, FEMALE);
  AddId ("machete");

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 80);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_BLUDGEON,DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_METAL);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 350);
  SetProp(P_NOBUY, 0);
}
  
  
  




