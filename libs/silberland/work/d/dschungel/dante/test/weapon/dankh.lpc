// ein ankh fuer den boooooooooooosen priester der kannibalen

#include "files.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>

create()
{
  if( !is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Ankh");
  SetProp(P_LONG, BS(
   "Das ist der lange verschollen geglaubte Ankh von Aztlepec, einem"
   " einst sehr maechtigen, guten Zauberer. Er schmiedete ihn, um seinen "
   "Erzfeind Kruozuq, einen boesartigen Kannibalenpriester zu vernichten.\n"));
  SetProp(P_NAME, "Ankh");
  SetProp(P_INFO, BS(
    "Der Ankh ist eine gutartige Waffe, die ihre Magie nur gegen ganz "
    "bestimmte Wesen verwendet.\n"));
  SetProp(P_GENDER, MALE);
  SetProp(P_WEAPON_TYPE, WT_MAGIC );
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_PIERCE}) );
  SetProp(P_WC, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({ MAT_METAL, MAT_MAGIC}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 6000);
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);

  AddId( ("ankh") );

  AddDetail( ({"aztlepec", "zauberer"}), BS(
    "Aztlepec ist schon vor langer, langer Zeit im Dschungel verschwunden."));
    
}

int WieldFunc(object waffe)
{

  if( TP->QueryAttribute(A_INT)<19 )
  {
    write("Deine magischen Faehigkeiten sind fuer den Ankh noch zu gering.\n");
    return 0;
  } 
  return 1;
}

int HitFunc(object enemy)
{
  int schaden;
  if( enemy->id("kannibalenpriester") )
  {
    schaden=random(400);
    if( schaden>100)
      write("Der Ankh leuchtet hell auf und wendet seine Magie gegen "+
       enemy->name(WEN)+".\n");
    return 10*enemy->QueryProp(P_LEVEL)+schaden;
  }
  write(CAP(enemy->name(WER) )+" ist mit dem Ankh nicht zu verwunden.\n");
  return -250;      
}
