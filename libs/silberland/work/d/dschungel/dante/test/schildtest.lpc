inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "files.h"
#include <new_skills.h>

object wer;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine magische Lufthuelle");
  SetProp (P_LONG, (
  "Diese Lufthuelle ist eine Art Schild und besteht aus keinem naeher erkennbaren Material. "
  "Es ist einfach ein magischer Schutz, der den Traeger vor vielen "
  "Gefahren bewahren kann."));
  SetProp (P_INFO, "Diese Lufthuelle ist wahrlich hervorragend. \n");
  SetProp (P_NAME, "Lufthuelle");
  SetProp (P_GENDER, FEMALE);
  AddId (({"schild","luftschild","lufthuelle","huelle"}));
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 1);
  SetProp(P_EXTRA_LOOK, ""+TPN+" wird von einer magischen Lufthuelle umgeben.\n");
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_AIR}));
  SetProp (P_VALUE, 3000);
  SetProp (P_ARMOUR_TYPE, AT_SHIELD);
  SetProp (P_AC, 25+random(5));
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_AIR}));
  SetDefendFunc (TO);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:0, SR_GOOD:0, A_INT:18, A_DEX:18]));
 SetWearFunc (TO);
}





int WearFunc()
{
  wer = TP;
  return 1;
}




 DefendFunc (string *dtype,mixed spell, object enemy)
 {
     string *abwehrschaden;
     
       abwehrschaden = ({DT_LIGHTNING,DT_PIERCE,DT_COLD,DT_SQUEEZE,DT_EXPLOSION,DT_AIR,DT_FIRE,DT_SLASH,DT_BLUDGEON,DT_MAGIC});
         
                       
       if(sizeof(dtype - abwehrschaden))                                         
                         

    {
       switch(random(100))
       {
       
       case 0 .. 20:
       {
       tell_object(wer, "Deine magische Lufthuelle wehrt den Angriff nur wenig ab.\n");
       return 5;
       break;
      }

       case 21 .. 46:
       {
       tell_object(wer, "Deine magische Lufthuelle wehrt den Angriff ein bisschen ab.\n");
       return 10;
       break;
      }
      
      
       case 47 .. 63:
       {
       tell_object(wer, "Deine magische Lufthuelle wehrt den Angriff etwas ab.\n");
       return 15;
       break;
      }

       case 64 .. 83:
       {
       tell_object(wer, "Deine magische Lufthuelle wehrt den Angriff fast ab.\n");
       return 20;
       break;
      }
      
       case 84 .. 99:
       {
       tell_object(wer, "Deine magische Lufthuelle wehrt den Angriff ab.\n");
       return 25;
       break;
     }
      default: write("Seltsam...\n");
    } 
     }  
    
       return 0;
}
