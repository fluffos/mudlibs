// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"





void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gigantischer Ykath");
  SetProp(P_LONG, BS(
  "Der Ykaht ist ein seltsames Wesen. Er scheint dahinzudaemmern und friedlich zu "
  "schlafen. In Wirklichkeit ist das aber nur ein Trick, denn er kann jede "
  "Sekunde losschlagen. Dieses Exemplar ist besonders gewaltig."));
  
  SetProp(P_NAME, "Ykaht");
  SetProp(P_GENDER, MALE);
  AddId(({"ykath", "bigykath"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(40);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinem Feueratem",350,DT_FIRE}));
  SetProp(P_BODY, 120);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 700);
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Verhalte Dich ruhig und unauffaelig!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "schnellt davon");
  

  SetProp(P_DIE_MSG,  " loest sich langsam auf!\n");
  
  
  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Ykaht damit?!\n" }) );
SetChats(5,({
"Der Ykaht schaut eigentlich friedlich aus.\n",
"Der Ykaht brummt laut.\n",
"Der Ykaht murmelt irgendetwas.\n",
"Der Ykaht grunzt laut.\n",
"Der Ykaht blinzelt Dich an!\n",
"Der Ykaht dreht sich um.\n"}));

  SetProp(P_SPELLRATE,70);


 AddCmd(({"nehme", "nimm"}), "nehmen", 1);   
  
  AddSpell(3,500,
    "Der Ykaht speit blaues Feuer nach Dir.\n",
    "Der Ykaht speit blaues Feuer nach @WEM.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,600,
    "Der Ykaht speit rotes Feuer nach Dir.\n",
    "Der Ykaht speit rotes Feuer nach @WEM.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  
  AddSpell(2,700,
    "Der Ykaht baut um Dich eine Feuerwand auf.\n",
    "Der Ykaht baut um @WEM eine Feuerwand auf.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,850,
    "Der Ykaht verwandelt Dich in eine Fackel.\n",
    "Der Ykaht verwandelt @WEM in eine Fackel.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,500,
    "Der Ykaht schlaegt brutalst auf Dich ein.\n",
    "Der Ykaht schlaegt brutalst auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  
  AddSpell(3,500,
    "Der Ykaht versucht Dich zu zerfetzen.\n",
    "Der Ykaht versucht @WEN zu zerfetzen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  
  AddSpell(1,200,
   "Der Ykath verwandelt sich in einen Feuerball.\n",
   "Der Ykath verwandelt sich in einen Feuerball.\n",
     DT_FIRE, "spell_fire");


  AddSpell(1,200,
   "Der Ykath geraet in Todesrage.\n",
   "Der Ykath geraet in Todesrage.\n",
     DT_TERROR, "spell_all");



  
  } 






 void spell_all(object enemy,int damage,mixed dam_type)
    {
      int i;
         object *inv;
      inv=PresentEnemies();
             damage=random((70)+70);//hmm wie hoch????
                         damage/=sizeof(inv);
        tell_room(ENV(ME), BS("Der Ykath trampelt Dich fast zu Tode!!!\n"));
          for(i=sizeof(inv)-1;i>=0;i--)
                  {
         tell_object(inv[i], "Du geraetst in aergste Bedraengniss!!!\n");
          inv[i]->Defend(damage, dam_type,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Ykath"]), this_object());
     }
   }


 void spell_fire(object enemy,int damage,mixed dam_type)
    {
      int i;
         object *inv;
      inv=PresentEnemies();
             damage=random((50)+50);//hmm wie hoch????
                         damage/=sizeof(inv);
        tell_room(ENV(ME), BS("Du verbrennst fast!!!\n"));
          for(i=sizeof(inv)-1;i>=0;i--)
                  {
         tell_object(inv[i], "Du bist eine lebendige Fackel!\n");
          inv[i]->Defend(damage, dam_type,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Ykath"]), this_object());
     }
   }
                                                                            


 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_FIRE }) ))
          
                  {
                     tell_room(environment(), "Der Ykaht freut sich sehr!\n");
                           heal_self(dam);
                                return ::Defend(0, dtype, spell, enemy);
                                        }         
  

  
  return ::Defend(dam, dtype, spell, enemy);
         }


   init()
   {
   ::init();
    if(deep_present("obsidianschale", TP))
      {
    write("Der Ykaht bruellt: "+CAP_TPN+", Du hast eine Obsidianschale! Stirb!\n");
    TO->Kill(TP);
      }
    }
    

int nehmen()
   {
   write("Der Ykath schleudert Dich brutal zu Boden!\n");
   return 1;
   }
   
    
    
     void NotifyPlayerDeath(object player, object killer, int lostexp)
      {
      
      
         write_file("/d/gebirge/dante/log/npc.deads",
                ctime()+": Bigykath hat "+CAP(getuid(PL))+" umgebracht.\n");
                       TO->heal_self(100);
                              }   
                              
                              
      
      void die(int poisondeath)
      
    {
     write_file(LOG "npc.kills",
           ctime()+": "
                     +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
                                   +" killt Bigykath.\n");
                                                   ::die(poisondeath);
                                                                   }                                        