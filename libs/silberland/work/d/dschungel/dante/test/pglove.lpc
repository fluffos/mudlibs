//widoltsring dante

inherit "/std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"
#include <thing/material.h>
#include <new_skills.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Widolts Panzerhandschuhe");
  SetProp(P_LONG,BS(
  "Das sind Widolts Panzerhandschuhe. Sie sind nicht nur ein guter Schutz "
  "sondern haben auch magische Kraefte, die Dich im Kampf unterstuetzen koennen."));
  SetProp(P_NAME, "Panzerhandschuhe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,0);
  AddId("handschuhe");
  AddId("panzerhandschuhe");
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY,1);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 9);
  SetDefendFunc(ME);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_SLASH:-0.5, DT_MAGIC:-1, DT_BLUDGEON:-1, DT_FIRE:-0.5]));
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:15, A_STR:15]) );
  SetProp(P_MATERIAL,([MAT_MISC_METAL:100,MAT_MISC_MAGIC:100]));
}

attack_enemy(enemy) {
  object pl;

  if (!objectp(enemy)) return;
  if (enemy->QueryProp(P_NAME)=="Widolt") return;
  pl=QueryWorn();
  if (!objectp(pl)) return;
  if (query_once_interactive(pl) && !interactive(pl)) return;
  if (enemy==pl) return;
  if (environment(enemy)!=environment(pl)) return;
  if (pl->QueryProp(P_NAME)!="Widolt" && random(100)<30) return;
  if (pl->QueryProp(P_SP)<5) return;
  tell_object(pl,"  Die Panzerhanschuhe versetzen "+
			  enemy->name(WEM)+" einen harten Schlag.\n");
  say("  "+capitalize(pl->name(WESSEN))+
	  " Panzerhanschuhe versetzen "+enemy->name(WEM)+" einen harten Schlag.\n",
	  ({pl,enemy}));
  tell_object(enemy,"  "+capitalize(pl->name(WESSEN))+
			  " versetzt Dir einen harten Schlag.\n");
  pl->restore_spell_points(-3);
  enemy->do_damage(7+random(3),pl);
}

DefendFunc(dtype,enemy) {
  object pl;

  if (!enemy) enemy=TP;
  if (!pointerp(dtype)) dtype=({dtype});
  call_out("attack_enemy",0,enemy);
  pl=QueryWorn();
  if (objectp(pl) && pl->QueryProp(P_NAME)=="Widolt") return 50;
  if (member(dtype,DT_MAGIC)>=0 ||
	  member(dtype,DT_FIRE)>=0) {
	if (objectp(enemy) && enemy->QueryProp(P_NAME)!="Widolt") return 0;
	return 15;
  }
  return 0;
}
