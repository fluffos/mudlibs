
inherit "/std/thing";

#include <properties.h>
#include "files.h"
       string *tx6a;
       int    won6a;
       void   Set6a(int nr, string xo);
       string Query6a(int nr);
       int    AddWon6a();
       void   Loose6a();
       void   Show6aAufg();
       void   generate6a();
       int    do_remove();

create()
{

  if(!is_clone(this_object())) return;  
  ::create();
  seteuid( getuid(this_object())); 
  SetProp(P_WEIGHT, 500);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Du willst doch wohl nicht den Schluesselbund wegwerfen?\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME, "Schluesselbund");
  SetProp(P_GENDER, MALE);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId( ({"\ngi_schlbund", "bund","jojoquest", "schluesselbund", "schluessel"}) );


}

void Set6a(int nr, string xo)
{
  tx6a[nr-1]=xo;
}

string Query6a(int nr)
{
  return(tx6a[nr-1]);
}

int AddWon6a()
{
  won6a++;
  return(won6a>2);
}

int Loose6a()
{
  won6a=0;
}

void Show6aAufg()
{
  write(
    "1    |2    |3\n"
  + "  "+tx6a{0}+"  |  "+tx6a{1}+"  |  "+tx6a{2}+"\n"  
  + "_____|_____|_____\n"
  + "4    |5    |6\n"   
  + "  "+tx6a[3]+"  |  "+tx6a[4]+"  |  "+tx6a[5]+"\n"  
  + "_____|_____|_____\n"
  + "7    |8    |9\n"
  + "  "+tx6a[6]+"  |  "+tx6a[7]+"  |  "+tx6a[8]+"\n"  
  + "     |     |\n");
}

void generate6a()
{
  tx6a=({" ", " ", " ", " ", " ", " ", " ", " ", " "});
}


