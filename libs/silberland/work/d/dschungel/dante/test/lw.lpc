//lichtwurm gibts auf der plantage
//in ner passionsfrucht erzeugt er licht...
//wird zum objekt wenn man ihn faengt
//verschwindet nach einer bestimmten zeit wieder in erde

inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>    

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Lichtwurm");
  SetProp(P_LONG, BS(
  "Das ist ein sogennanter Lichtwurm. Er lebt in der Erde und "
  "ist in der Lage bestimmte Fruechte zum Leuchten zum bringen. "
  "Dabei frisst er langsam die Frucht auf und seine Ausscheidungen erzeugen "
  "durch eine unglaublich komplizierte chemische Reaktion dann Licht in der "
  "Frucht."));
  
  SetProp(P_NAME, "Lichtwurm");
  SetProp(P_GENDER, MALE);
  AddId(({"wurm", "lichtwurm", "lw"}));
  SetProp(P_INFO,
  "Angeblich soll die besagte Frucht eine leidenschaftliche sein...\n");
  
  create_default_npc(3);
  SetProp(P_HANDS, ({" mit seinen winzigen Zaehnchen", 30, DT_POISON}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, 0);

  SetProp(P_MSGIN, "kriecht");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht aus der Erde heraus");
  SetProp(P_MMSGOUT, "kriecht wieder in die Erde zurueck");
 // SetProp(P_MNPC_AREA, ("/d/dschungel/dante/weg/room/planta"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS );
  SetProp(P_MNPC_WAIT, ({3, 3,2}));
 // SetProp(P_MNPC_DEFAULTROOM,  "/d/dschungel/dante/weg/room/planta4");
  SetProp(P_DIE_MSG,  " verblasst schnell.\n");
  SetProp(P_DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  
    

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Lichtwurm kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 0);

 AddCmd(({"fange", "fang"}), "tryget");
}

 tryget(string str)
  {
  notify_fail("Wen oder was willst Du hier einfangen?\n");
  if (!str)
      {
      write("Du versuchst Deinen Po zu fangen, doch das klappt nicht so recht. "
      "Er scheint wohl zu dick zu sein!\n");
      say(""+TPN+" versucht sich selbst zu fangen! Verliert aber gegen sich "
      "selbst.\n");
      return 1;
      }
      
  if (member(({"wurm ein", "lichtwurm ein"}),str)!=-1)
    {
    switch(random(10))
         {
         case 0 .. 3:
         write("Du versuchst den Wurm zu fangen, doch er schluepft zwischen "
         "Deinen Haenden hindurch.\n");
         break;
         case 4 .. 6:
         write("Du packst blitzschnell zu und faengst einen kleinen "
         "Lichtwurm ein.\n");
         call_out("weg", 0);
         break;
         case 7 .. 9:
         write("Du versuchst den Lichtwurm einzufangen, doch er schnappt "
         "mit seinen winzigen Zaehnen nach Dir und erwischt Dich leicht "
         "an der Hand.\n");
         TP->do_damage(3);
         break;
         default: write("BUG!\n");
        } 
       return 1;
     }
  return 0;
  }


   weg()
     {
     object wu;
     wu=clone_object("/d/dschungel/dante/weg/obj/lw2.lpc");
     wu->move(TP, M_NOCHECK);
     TO->remove(1);
     }
     
     
