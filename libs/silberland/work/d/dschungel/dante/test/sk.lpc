int HitFunc(object enemy) {
  object pl;
  int sk,dex,bonus;
  
  if (!objectp(pl=QueryProp(P_WIELDED)))
    return 0;

  sk=pl->QueryProp(TONFA_ATTACK_SKILL);
  dex=pl->QueryAttribute(A_DEX);
  bonus=random(dex*(5000+sk))/3000;
      
    if (bonus>70)
    {
      bonus=70;
  }
  if (sk>random(10000))
    return random(bonus);

    sk+=random(2);
  if (sk>10000)
    sk=10000;
  pl->SetProp(TONFA_ATTACK_SKILL,sk);
  pl->Set(TONFA_ATTACK_SKILL,SAVE,F_MODE_AS);
  return random(bonus);
}
