string valtostr(int val) {
  switch(val) {
    case 0..1999: return "sauschlecht";
    case 2000..3999: return "schlecht";
    case 4000..5999: return "mittelmaessig";
    case 6000..7999: return "gut";
    case 8000..9999: return "sehr gut";
    default: return "perfekt";
  }
}

_query_info() {
  return break_string("Du kannst damit momentan "+
		      valtostr(TP->QueryProp(TONFA_ATTACK_SKILL))+
		      " zuschlagen!\n");
		     //  und "+
		    //  valtostr(TP->QueryProp(TONFA_DEFEND_SKILL))+
		    //  " abwehren. Uebe mal etwas, damit es besser wird.",78);
}
