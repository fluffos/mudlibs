#define TONFA_ATTACK_SKILL "Tonfa_attack_skill"
//#define TONFA_DEFEND_SKILL "Tonfa_defend_skill"
//#define ME this_object()
//#define TP this_player()
  
create() {
  if (!is_clone(this_object())) return;
//  armour::create();
  weapon::create();

  SetProp(P_SHORT,"Eine Tonfa");
  SetProp(P_LONG,
"Eine Tonfa ist ein kurzer Stock (etwas ueber Unterarmlaenge)\n\
mit einem Griff, der sich sowohl fuer Angriff wie auch Abwehr eignet.\n");
  SetProp(P_NAME,"Tonfa");
  SetProp(P_GENDER,FEMALE);
  AddId("tonfa");
  SetProp(P_MATERIAL,MAT_OAK); // Soll schon stabil sein :)
  
  SetProp(P_WEIGHT,400); 
  SetProp(P_VALUE,2000);
  SetProp(P_NR_HANDS, 1);

  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC,120);
//  SetProp(P_EFFECTIVE_WC,153); // bei Dex 20 ohne Uebung
  SetHitFunc(ME);
  
 // SetProp(P_ARMOUR_TYPE,AT_SHIELD);
 // SetProp(P_AC,10);
 // SetProp(P_EFFECTIVE_AC,20); // bei Dex 20 ohne Uebung
 // SetDefendFunc(ME);
}

init() {
 // armour::init();
  weapon::init();
}

varargs int DoUnwield(int silent, int rek) {
  int res;

  res=(::DoUnwield(silent));
 // if (res && !rek)
//    DoUnwear(M_SILENT,1);
  return res;
}

