// dante@SilberLand
//monster fuer katakomben

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Emil, der Totengraeber");
  SetProp(P_LONG, BS(
  "Das ist Emil, der Totengraeber. Er lebt hier schon seit unzaehligen "
  "Jahren und hat seine Eigentuemlichkeiten. Viel Hilfe kannst Du Dir "
  "von ihm nicht erwarten, trotzdem ohne Emil, geht hier sicher nichts."));  

  SetProp(P_NAME, "Emil");
  SetProp(P_GENDER, MALE);
  AddId(({"emil", "totengraeber"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(15);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen eiskalten Haenden",200,DT_TERROR}));
  SetProp(P_BODY, 50);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Emil spricht in einer eigentuemlichen Sprache, "
  "die Du aber verstehen kannst, wenn Du weisst...\n"
  "Angreifen solltest Du Emil allerdings nie!\n");
   
  
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");
  
  SetProp(P_DIE_MSG, " bruellt: Ttzogft!\n");
  
  
  
  AddInfo(DEFAULT_INFO,({
  "sagt: Ktzehjiztndfe Arrhggnoouklnzzg?!\n"})); 
      
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll Emil damit?!\n" }) );


SetChats(9,({
"Emil hustet laut.\n",
"Emil gaehnt.\n",
"Emil meint: Hbnatgu artb!\n",
"Emil sagt: Gtrudftdfejhn Tsdahug!\n",
"Emil ruelpst.\n"}));  
  
  } 

 Defend(int dam, string dtype, int spell, object enemy)
   {
    enemy->move("d/gebirge/dante/room/dead", M_GO);
    write("Du wolltest ja nicht hoeren!\n");
        return ::Defend(dam, dtype, spell, enemy);            
    }
    
    
    
    