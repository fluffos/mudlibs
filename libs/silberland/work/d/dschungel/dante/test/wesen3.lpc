//wesen fuer quest
//keien ahnung ob das so geht

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"
#include <combat.h>   
#include <new_skills.h>     
#include <npc.h>        

inherit "/std/npc";


     


create()
{
  ::create();
  SetProp(P_SHORT, "Eines der 3 seltsamen Wesen");
  SetProp(P_LONG,BS(
  "Das ist eines der 3 seltsamsten Wesen, die Du je gesehen hast. "
   "Es gibt derer 3 und alle 3 zusammen besitzen nur einen Mund. "
  "Wenn sie etwas sagen wollen, geben sie den Mund einfach weiter. Der Mund ist "
  "so klein und so gut versteckt am Koerper dieser Wesen, dass man ihn kaum erkennen kann."));
  
  AddDetail("mund",
  "Du bist Dir nicht sicher, ob der Mund gerade bei diesem der 3 Wesen ist.");
  AddDetail("koerper",
  "Irgendwie sieht alles wie Mund aus, irgendwie aber auch nicht...");
  
  
  
  SetProp(P_NAME, "Wesen");
  create_default_npc(19);
  SetProp(P_RACE, "monster");
  SetProp(P_DEFAULT_INFO, "sagt: Davon habe ich keine Ahnung.\n");
  SetProp(P_REJECT, ({ REJECT_GIVE, "Das Wesen wuerde lieber mit Dir ihrem Hobby nachgehen.\n"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Die seltsamen Wesen haben ein Hobby!\n");
  SetProp(P_ALIGN, 0);
  SetProp(P_GENDER, FEMALE);//absicht
  AddId( ({"wesen", "wesen3"}) );
  AddCmd( ({"antworte"}), "antw");
  SetProp(P_NOATTACK, "Die seltsamen Wesen lachen Dich nur aus!\n");   
//  AddInfo( ({"spiel", "spielen"}), "@@do_it@@");
  AddInfo( ({"syntax", "regeln", "antwort","regel"}), 
    "Du kannst uns mit 'antworte <linkes wesen|mittleres wesen|rechtes wesen>' sagen, wo Du den Mund vermutest. ",
    "sagen: ");
    AddInfo("hobby",
    "Tja, mach ein Spielchen mit mir. Wenn Du 3 mal hintereinander gewinnst, gebe ich "
    "Dir eine Flasche Baldrian!", "sagen: ");
    AddInfo("flasche",
    "Du meinst den Baldrian...", "sagen: ");
    AddInfo("baldrian",
    "Ach was, unser Hobby interessiert uns!", "sagen: ");
   AddInfo("spielchen",
   "Tja, wie Du siehst haben wir 3 nur einen Mund! Errate wo er ist und wir geben "
   "Dir eine Flasche Baldrian dafuer! Aber Du musst 3 mal in Folge gewinnen! "
   "Frag uns einfach nach Spiel!", "sagen: ");




 }
