// dwurmhaut.c
// 
// anlehnung an feys wurmhaut

#include "files.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Wurmhaut");
  SetProp(P_LONG, BS( 
    "Diese Wurmhaut gehoerte einst einem Schlammwurm. Sie ist so klein, dass"
    " nur ein Wurm sie tragen kann.") );
  SetProp(P_NAME, "Wurmhaut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"haut", "wurmhaut"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, MAT_ANIMAL );
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 500);

  SetProp(P_WEAR_FUNC, TO );
}

int WearFunc(object me)
{
  if( TP->QuerProp(P_FROG) || TP->QueryProp(P_SIZE)<20)
    return 1;
  write("Du bist doch viel zu gross fuer so eine kleine Wurmhaut.\n");
  return 0;
}
