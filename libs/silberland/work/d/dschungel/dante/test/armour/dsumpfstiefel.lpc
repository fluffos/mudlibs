/*
** 
** sumpfstiefel fuer den einsiedler
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"stiefel","sumpfstiefel"}));
  SetProp (P_SHORT, "Ein Paar Sumpfstiefel");
  SetProp (P_LONG, ("Diese Art von Stiefel ist speziell fuer das Sumpfgebiet des Dschungels"
                   " geeignet. Sie reichen ueber die Knie und sind aus besonders festem"
                   " Material angefertigt. An der rechten Ferse ist ein kleines Ettiket.\n"));
  AddDetail(({"ferse","etikett","etikette"}),
           "Auf dem Etikett steht: 'MADE by DANTE(97)'.");
  
  SetProp (P_NAME, "Paar Sumpfstiefel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 800);

  SetProp (P_ARMOUR_TYPE, AT_BOOT);  //
  SetProp (P_AC, 6);
}
