/*
** federkrone.c
** dante sl 97 jaenner
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"krone", "federkrone"}));
  SetProp (P_SHORT, "Eine Federkrone");
  SetProp (P_LONG, ("Die Krone besteht aus einem goldenem Ring, von dem aus mehrere"
               " Dutzend Federn senkrecht in die Hoehe stehn.\n"));
  SetProp (P_MATERIAL, MAT_GOLD);
  AddDetail(("ring"),
  "Der Ring scheint aus massivem Gold zu sein, denn die Krone ist sehr schwer.\n");
  AddDetail(({"feder","federn"}),
  "Du erkennst Federn von Papageien, von Geiern, vom Archaeopterix, eben "
  "unterschiedlichste Federn in allen moeglichen Farben.\n");
         
  SetProp (P_NAME, "Federkrone");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 3000);
  SetProp (P_VALUE, 3000);
  SetProp (P_INFO, ("Die Federkrone ist sehr viel wert. "));
  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 6);
}
