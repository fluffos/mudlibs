inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schild","hwaxanociumschild"}));
  SetProp (P_SHORT, "Ein Hwaxanociumschild");
  SetProp (P_LONG, "Dieses Schild ist aus einem sehr harten Metall, dem Hwaxanocium."
                   " Es stammt aus den laengst verschuetteten Minen von K'Ndour.\n"); 
  
  SetProp (P_NAME, "Hwaxanociumschild");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 900);
  SetProp (P_VALUE, 1600);

  SetProp (P_ARMOUR_TYPE, AT_SHIELD);  
  SetProp (P_AC, 25);
}
