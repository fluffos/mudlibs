/*
** schlangenhaut
** 
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId ("haut");
  SetProp (P_SHORT, "Eine Kobrahaut");
  SetProp (P_LONG, "Dies ist die Haut der bruechtigten Satanskobra.\n");
  SetProp (P_NAME, "Kobrahaut");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 250);
  SetProp (P_VALUE, 1000);
  SetProp (P_NOBUY, 1);
  
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp (P_AC, 8);
}
