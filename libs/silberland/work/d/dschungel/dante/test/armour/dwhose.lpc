inherit "std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Eine Wildlederhose");
  SetProp(P_LONG,
    "Diese Hose hat der Einsiedler selbst aus dem Leder von Zwergtapiren hergestellt."
    " Sie wiegt zwar sehr viel, ist aber ein ausgezeichneter Schutz. An den Oberschenkeln"
    " kannst Du einige dunkle Flecken erkennen.\n");
    AddDetail(({"flecke","fleck","flecken"}),
    "Eingetrocknetes Blut von erlegten Tieren haben diese Flecken verursacht.\n");
  AddDetail(({"schenkel","oberschenkel"}),
  "Die Oberschenkel sind der Teil zwischen Becken und Knie.\n");
  AddDetail(({"leder","schutz"}),
  "Dieses Leder zeichnet sich durch hohe Schlagfestigkeit aus.\n");
  SetProp(P_NAME, "Wildlederhose");
  AddId(({"Wildlederhose","lederhose","hose"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT,1400);
  SetProp(P_VALUE,1200);
  SetProp(P_AC, 9);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, MAT_LEATHER);
}