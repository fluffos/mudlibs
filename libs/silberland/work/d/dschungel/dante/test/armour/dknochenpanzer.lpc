/*
** knochenpanzer
** dante 97 jaenner sl
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer","knochenpanzer"}));
  SetProp (P_SHORT, "Knochenpanzer");
  SetProp (P_LONG, "Dieser Panzer wurde aus den Plattenknochen vieler unschuldiger"
  " Opfer gefertigt. Die Kannibalen haben gute Arbeit geleistet, denn der "
  "Panzer sieht sehr kompakt aus.\n");
  AddDetail("arbeit",
  "Der Knochenpanzer ist wircklich gut gelungen.\n");
  SetProp(P_NOBUY, 1);
  AddDetail("opfer",   
   "Sei vorsichtig sonst wirst Du auch so enden...\n");
  SetProp (P_NAME, "Knochenpanzer");
  
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1500);
  SetProp (P_VALUE, 5000);
  AddDetail(({"knochen","plattenknochen"}),
  "Du erkennst ein Hueftbein, ein Schulterblatt,...\n");
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 35);
   SetProp(P_MATERIAL, MAT_HORN);

}
