/*
** schamanenhandschuhe
** dante 97 sl
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"handschuhe","tigerhandschuhe"}));  
  SetProp (P_SHORT, "Tigerhandschuhe");
  AddDetail(({"haut","tiger"}),
  "Der weisse Tiger gilt bei den Eingeborenen als heiliges Tier.");
  SetProp (P_LONG, ("Diese Handschuhe sind aus der Haut eines weissen Tigers gemacht."));
  SetProp (P_NAME, "Tigerhandschuhe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 250);
  SetProp (P_VALUE, 1500);
  SetProp (P_MATERIAL, MAT_MAGIC);
  SetProp (P_INFO, ("Der weisse Tiger verleiht Dir grossen Schutz. \n"));
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_GLOVE); 
  SetProp (P_AC, 10);
}
