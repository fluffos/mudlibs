/*
** totenmaske
** dante sl jaenner 97
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"maske","totenmaske"}));
  SetProp (P_SHORT, "Eine Totenmaske");
  SetProp (P_LONG, "Die Totenmaske ist eines der boesen Werke des Kannibalenpriesters. Du "
  "wirst totenbleich als Du erkennst, dass sie genau ein Ebenbild Deines "
  "Gesichtes darstellt. Nur ist Dein Antlitz zu einer eine grausige Fratze"
  " entstellt, die Dich hoehnisch anlacht!\n");
  AddDetail(({"ebenbild","gesicht"}),
  "So haesslich kannst Du ja nicht sein...\n");
  AddDetail(({"antlitz","fratze"}),
  "DIE FRATZE BRUELLT DICH AN: JA!!! ICH BIN DEIN BOESES ICH!!!\n");
  SetProp (P_NAME, "Totenmaske");
  SetProp (P_INFO, ("Diese Maske ist Dir nicht ganz geheuer...\n"));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 1000);
  SetProp (P_MATERIAL, MAT_SILVER);
  SetProp(P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 5);
}
