/*
** steinkrone
** dante sl 97 jaenner
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"krone", "steinkrone","granitkrone"}));
  SetProp (P_SHORT, "Eine Steinkrone");
  SetProp (P_LONG, ("Die Krone besteht aus reinem Granit, schlicht gearbeitet und ziemlich schwer. "));

           SetProp (P_MATERIAL, MAT_STONE); 
  SetProp (P_NAME, "Steinkrone");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 4000);
  SetProp (P_VALUE, 4000);
  SetProp (P_INFO, ("Die Steinkrone ist herrvorragend. "));
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
    SetProp (P_MATERIAL, MAT_STONE); 
  SetProp (P_AC, 10);
}
