// tigerfell.....
// dante sl 97 jaaen danke feyaria

#include "files.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Tigerfell");
  SetProp(P_LONG, ( 
    "Das Fell des Tigers hat die bekannte schwarz-gelbe Streifung, die auch "
    "Dir sehr gut gefaellt. Wenn Du es anziehst wird es Dir nicht nur Schutz "
    "bieten, sondern Dir sicherlich auch eine angemessene Zierde sein.\n"));
    
  SetProp(P_NAME, "Tigerfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "tigerfell"}) );
  SetProp(P_INFO, ("Das Tigerfell ist ein hervorragender Schutz.\n"));
  SetProp(P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_ANIMAL );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 2000);
}

