/*
** 
** knochenhelm fuer die kannibalen waechter dante 97 jaenner
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"helm", "knochenhelm"}));
  SetProp (P_SHORT, "Ein Knochenhelm");
  SetProp (P_LONG, "Der Helm wurde von den Kannibalen aus der Schaedelkapsel eines grossen"
     " Tieres gefertigt. Welches Tier das wohl gewesen sein mag?\n");
     AddDetail(({"kapsel","tier","schaedel","schaedelkapsel"}),
     "Das Tier muss sehr gross gewesen sein, denn Dein Kopf passt leicht hinein.\n");
  SetProp (P_NAME, "Knochenhelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 600);
  SetProp (P_VALUE, 400);
  SetProp (P_INFO, ("Eigentlich sehr makaber sich so etwas auf den Kopf zu setzten.\n"));
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  
  SetProp (P_AC, 6);
  SetProp (P_MATERIAL, MAT_HORN);

}
