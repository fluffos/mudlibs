/*
** ein lederhut fuer den einsiedler von dante 97 jaenner
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"hut", "lederhut"}));
  SetProp (P_SHORT, "Ein Lederhut");
  SetProp (P_LONG, "Dieser Hut war einmal aus steifem, braunem Leder gefertigt."
   " Regen, Wind und die unbarmherzige Sonne haben ihn aber ausbleichen lassen "
   "und schlapp gemacht. Die einzige Zierde die ihn schmueckt, ist"
   " ein breites ehemals weisses, aber schon lange eher graues Band, das ein "
   "Stueck ueber die Krempe herunterhaengt.\n");
  AddDetail(("leder"),
  "Das Leder der Antilope ist ein besonders strapazierfaehiger Stoff.");
  AddDetail(({"zierde","band"}),
  "Das Stoffband ist mehrmals um den Hut herumgewickelt und ein Ende haengt"
  " hinten herab.\n");
  AddDetail(("krempe"),
  "Von der Krempe ist nicht mehr viel uebrig geblieben. Der Hut muss wohl"
  " schon viele Jahre im Besitz des Einsiedlers gewesen sein.\n");
  
  SetProp (P_NAME, "Lederhut");
  
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 300);
  
  
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  
  SetProp (P_AC, 5);
  SetProp (P_MATERIAL, MAT_LEATHER);

}
