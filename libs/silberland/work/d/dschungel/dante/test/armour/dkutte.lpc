inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "files.h"

object wer;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine Schamanenkutte");
  SetProp (P_LONG, (
    "Diese Kutte gehoerte einst dem maechtigen Schamanen der Kannibalen."
    " Ihr pupurener, merkwuerdig glaenzender Stoff ist ueber und ueber"
    " mit Symbolen bestickt.\n"));
  AddDetail(({"symbole","symbolen"}),
    "Leider kennst Du von keinem einzigen Zeichen die Bedeutung.\n");
  AddDetail(("stoff"),
    "Als Du die Kutte naeher betrachtest, faellt Dir erst auf, dass rot"
    " nicht die urspruengliche Farbe war! Erst durch das Blut hunderter"
    " Opfer hat sie diese Farbe bekommen!\n");
  SetProp (P_INFO, "Diese Kutte schuetzt Dich vor boeser Magie. \n");
  SetProp (P_NAME, "Schamanenkutte");
  SetProp (P_GENDER, FEMALE);
  AddId (({"kutte","schamanenkutte"}));
  SetProp (P_WEIGHT, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 3000);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 3);

  SetDefendFunc (TO);
  SetWearFunc (TO);
}

int WearFunc()
{
  wer = TP;
  return 1;
}


int DefendFunc (mixed dam_type, int spell, object enemy)
{
    if (member(dam_type, DT_MAGIC) != -1)
    {
       tell_object (wer, "Die Kutte schuetzt Dich vor der boesen Magie.\n");
       return 10;
    }
    else
       return 0;
}
