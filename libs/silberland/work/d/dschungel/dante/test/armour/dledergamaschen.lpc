/*
** Lederstiefel
** (w) 1996-01-07 Woody@Everywhere
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"gamaschen","ledergamaschen"}));
  SetProp (P_SHORT, "Ein Paar Ledergamaschen");
  SetProp (P_LONG, ("Ledergamaschen bestehen eigentlich nur aus etwas Leder, das mit\n"
                   "einer Schnur um die Fuesse gebunden wird.\n"));
  SetProp (P_NAME, "Paar Ledergamaschen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 300);
  SetProp (P_INFO, ("Ledergamaschen sind ein schlechter Schutz fuer Deine Beine.\n"));
  SetProp (P_ARMOUR_TYPE, AT_BOOT);  
  SetProp (P_AC, 3);
}
