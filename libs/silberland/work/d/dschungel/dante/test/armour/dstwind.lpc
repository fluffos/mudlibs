inherit "std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Steinerne Windeln");
  SetProp(P_LONG,
    "Diese Windeln bestehen aus Granit und haben einmal dem Steingigantenbaby gehoert."
    " Man kann sie als Hosen tragen.");
  AddDetail(({"granit","stein"}),
  "Diese Windeln sind leider etwas hart...\n");
  SetProp(P_NAME, "Steinwindeln");
  AddId(({"windeln","windel","steinwindeln","steinwindel"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_WEIGHT,1400);
  SetProp(P_VALUE,200);
  SetProp(P_AC, 5);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, MAT_STONE);
}