/*
** medaillon 
** 97 dante basierend auf halsband von eros
*
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "files.h"

int ready;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  ready = 1;
  AddId (({"medaillon","medailon",}));
  SetProp (P_SHORT, "Ein Medaillon");
  SetProp (P_LONG, (
    "Dieses fein gearbeitete Medaillon blinkt und glitzert, dass Du die Augen "
    "zukneifen musst. Auf seiner Oberflaeche kannst Du Schriftzeichen erkennen,"
    " die Dir aber sehr fremd vorkommen. Eine magische Aura scheint dieses "
    "praechtige Schmuckstueck zu umgeben.\n"));
    
  SetProp (P_NAME, "Medaillon");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 1600);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 1);
  SetProp(P_INFO, (
    "Das Medaillon hat wircklich magische Kraefte. Das Wort 'lhwaxanoc' wird "
    "Dir sein Geheimis enthuellen.\n"));
  SetProp(P_MATERIAL, MAT_GOLD);
  AddDetail (({"oberflaeche","schriftzeichen","zeichen"}),
     ("Leider kennst Du diese archaische Sprache aus grauer Vorzeit nicht, "
     "sonst waerst Du nun sicher schlauer.\n"));
  AddDetail (({"schmuckstueck","stueck","aura"}),
     ("Diese Preziose blinkt und strahlt so hell, das Du Dich geblendet ab"
     "wendest. Seine Ausstrahlung hat sicher einen verborgenen Grund.\n"));
        
       
    
    
  

  
    
  
  
    
    

  AddCmd("lhwaxanoc", "lhwaxanoc");
}

do_wear(string str, int silent)
{
  if (present("\nnein 2"))
    {
    write(("Das Medaillon teilt Dir mit: "+
    "Leider darfst Du mich nicht zweimal anziehen, denn die Goetter haben "+
    "es untersagt!\n"));
    return 1;
    }
  return ::do_wear(str, silent);
}


lhwaxanoc()
{
  if (QueryWorn()!=this_player())
  {
    notify_fail("Die heilende Energie kann nur auf Dich uebergehen, "+
    "wenn Du es\nauch angezogen hast.\n");
    return 0;
  }

  if (!ready)
  {
    write("So wie alle Magie ist auch die des Medaillon begrenzt und Du"+
    "musst Dich noch gedulden.\n");
    return 1;
  }

  write("Das Medaillon blinkt auf und gibt Dir wieder Kraft.\n");
  say
  ("Ein greller Blitz trifft "+this_player()->name(WER,RAW)+" und "+
      " verleiht "+this_player()->QueryPronoun(WEM)+" neue Kraft.\n");
  {
    this_player()->heal_self(50);
  }


  call_out("aufladen", 800);
  ready--;
  return 1;
}

aufladen()
  {
    ready++;
  }
