inherit "std/thing";

#include <properties.h>
#include <language.h>

#define TP this_player()
#define TPN this_player()->name()

int offen;
int seite;
int seitenzahl;
int seitzahl;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  offen = 0;
  seite = 0;
  seitenzahl = getseitzahl();
  SetProp(P_SHORT, "Ein Buch");
  SetProp(P_LONG,
	"Du haelst ein leinengebundenes Buch in Deinen Haenden. Der Titel heisst:\n"+
	"@@buchinfo@@.\n");
  SetProp(P_NAME,"Buch");
  AddId("buch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT,80);
  SetProp(P_NOBUY, 1);
  AddCmd(({"lies","lese"}), "lies");
  AddCmd("oeffne","oeffne");
  AddCmd("schliesse","schliesse");
  AddCmd("blaettere","blaettere");
}

oeffne(str) {
  string was;
  if (!str) return 0;
  if (!id(str)) return 0;
  if (offen) write("Es ist schon geoeffnet.\n");
  if (!offen) {
	offen=1;
	write("Du oeffnest das Buch auf Seite 1.\n");
	say(TPN + " oeffnet ein Buch.\n",TP);
	seite=1;
  }
  return 1;
}

schliesse(str) {
  string was;
  if (!str) return 0;
  if (!id(str)) return 0;
  if (!offen) write("Es ist schon geschlossen.\n");
  if (offen) {
	offen=0;
	write("Du schliesst das Buch wieder.\n");
	say(TPN + " schliesst ein Buch wieder.\n",TP);
	seite=0;
  }
  return 1;
}

blaettere(str) {
  if (!offen) return 0;
  if (!str) return 0;
  if (sscanf(str,"zu seite %d",seitzahl)<1) return 0;
  if ((seitzahl < 1) || (seitzahl > seitenzahl)) return 0;
  if (((seitzahl/2)*2) == seitzahl) seitzahl++;
  write("Du blaetterst zu Seite "+seitzahl+".\n");
  say(TPN + "blaettert in einem Buch.\n");
  seite=seitzahl;
  return 1;
}

lies(str)
{
  string was;
  notify_fail("Was willst Du lesen ? Syntax: LIES <ETWAS>.\n");
  if(!str) return 0;
  if(sscanf(str,"%s",was)!=1) return 0;
  if (!id(str)) return 0;
  say(TPN + " liest in einem Buch.\n",TP);
  if (offen) {
	lesbuch();
  } else {
	titel();
  }
  return 1;
}

lesbuch() {
	TP->more(buchdir()+"seite"+seite);
	seite+=2;
	if (seite > seitenzahl) {
		offen=0;
		write("Du hast das Buch ausgelesen und schliesst es.\n");
		say(TPN + " hat ein Buch ausgelesen und schliesst es.\n",TP);
		seite=0;
	} else {
		write("Du blaetterst um.\n");
		say(TPN + " blaettert um.\n",TP);
	}
	return 1;
}

titel() {
	TP->more(buchdir()+"titel");
	return 1;
}

buchinfo() {
	return "'Standardbuch oder Wie man ein standardisiertes Buch schreibt'";
}

getseitzahl() {
	return 3;
}

buchdir() {
        return "/obj/buch/";
}
