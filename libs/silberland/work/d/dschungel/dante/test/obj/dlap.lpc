// lapislazuli von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Lapislazuli");
  SetProp(P_LONG, BS( 
    "Der Lapislazuli ist ein besonders seltener Edelstein. Die Farbpalette reicht von"
    " Blau ueber Violett bis Gruen.\n"));
  SetProp(P_INFO, "Dieser Stein ist sicher sehr viel wert. ");
  SetProp(P_NAME, "Lapislazuli");
  SetProp(P_GENDER, MALE);
  AddId(("lapislazuli","edelstein","stein"));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 1800);
  SetProp(P_NOBUY, 0);

}
