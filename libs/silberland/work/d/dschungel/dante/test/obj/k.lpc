inherit "std/food";
#include <food.h>
#include "files.h"
#include <properties.h>
#include <language.h>
#define textlist ({ "Der Kopf noergelt und noergelt...\n", \
 "Der Kopf schreit: Los, mach das so wie Ich will...\n", \
 "Der Kopf bruellt Dich an: Ich bin hier der Chef!.\n", \
 "Der Kopf nervt Dich gewaltig...\n", \
 "Du haeltst Dir die Ohren zu...\n", \
 "Ah, der Kopf treibt Dich in den Wahnsinn....\n", \
 "Der Kopf noergelt und noergelt....\n", \
 "Der Kopf bruellt: Das will ich noch und das musst Du noch machen.. !!\n" \
                 });
 string *text;
 string str;
 string cstr;  

init()
{
  ::init();
  add_action("throw_it","wirf"); 
  add_action("ww", "ww");
}

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  text=textlist;
  SetProp(P_SHORT,"Ein Kopf");
  SetProp(P_LONG,"Ein stinkender, halbverfaulter, eitriger Kopf einer Regionsmagierin.\n");
  AddId(({"fey","kopf"}));
  SetProp(P_NAME,"Kopf");
  SetProp(P_NAME_ADJ, "verfault", "stinkendes", "faules");
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT,20);
  SetProp(P_VALUE,0);
  SetProp(P_MATERIAL,MAT_FOOD);
  SetProp(P_INFO, ("Es ist der stinkende, eklige noch immer noergelnde Kopf von Feyaria, der \n" 
  		   "sein Maul noch immer weit aufreisst und kritisiert...\n")); 
  SetProp(P_FOOD_INFO, ([F_HEAL: -200, F_SOAK: 5, F_ALCOHOL: 0, F_POISON:11]));		   
  SetProp(P_SMELL, ("Ein widerlicher Gestank stroemt von diesem Kopf aus. Er steigt einem sofort in die Nase, und setzt sich dort fest.\n"));

  call_out("faulen",5+random(5));
}  

void faulen() 
{
  string thistext;
  thistext = text [ random(sizeof(text)) ];
  if(living(environment()))
    tell_object(environment(), thistext);
  else
    tell_room(environment(), thistext);
  call_out("faulen",5+random(5)); 
}

/* 
remove()
 {
   while (remove_call_out("faulen") != -1);
   return ::remove();
 }

*/

BeimEssen()
{
  write ("Du frisst den ekligen, eitrigen Kopf und uebergibst Dich sofort wieder....\n");
  say (TPN+" frisst feyaria Kopf auf...\n");
  return ::BeimEssen();
}

ww(str)
{
  if (str)
    return throw_it("Kopf nach "+str);
  else
  {
    object *all, *liv;
    int i;

    all=all_inventory(environment(this_player()));
    for (i=0; i<sizeof(all); i++)
      if (query_once_interactive(all[i]))
        if (!liv)
	  liv = ({all[i]});
        else
          liv = liv+({all[i]});
    i = random(sizeof(liv));
    return throw_it("Kopf nach "+lower_case(liv[i]->query_real_name()));
  }
}

throw_it(str)
{
  int treffer;
  string victim_name,werfer_name;
  string victim_string,werfer_string;
  string was,at,wen;
  int fehler;
  object victim;

  if (!str) return 0;
  fehler = 0;
  if (sscanf(str,"%s %s %s",was,at,wen) != 3)
    fehler = 1;
  if (!id(was) || at != "nach")
    fehler = 1;
  if (fehler)
  { notify_fail("Zum Werfen: wirf Kopf nach <spielername>\n");
    return 0;
  }
  victim = find_living(wen);
  if (!victim || !present(victim,environment(this_player())))
    { write("Die Noergelei des eitrigen Kopfes macht Dich anscheinend schon ganz dusselig, denn beim genaueren Umsehen erkennst Du, dass dieser Spieler gar nicht anwesend ist.\n");                                
      return 1;                                                                                                                                                                                      
    }                                                                           
  victim_name = capitalize(victim->query_real_name());
  werfer_name = capitalize(this_player()->query_real_name());
  treffer = random(5);
  write("Du schmeisst den eitrigen Kopf nach " + victim_name +".\n");
  say(werfer_name + " wirft den eitrigen Kopf nach " + victim_name + ".\n");
  if (treffer==0)
  {
    werfer_string = "Der eitrige Kopf fliegt an " + victim_name + " vorbei.\n";
    victim_string = werfer_name + " trifft Dich nicht.\n";
    this_object()->move(environment(this_player()));
  }
  if (treffer==1)
  {
    werfer_string = "Der eitrige Kopf zerplatzt an " + victim_name + "'s Koerper und besudelt die gesamte Kleidung.\n";
    victim_string = "Der eitrige Kopf zerbricht an Deinem Koerper, und der Eiter verteilt sich af Deiner Kleidung.\n";
  }
  if (treffer==2)
  {
    werfer_string = "KLATSCH! Du triffst " + victim_name + " mitten ins Gesicht.\n";
    victim_string = "KLATSCH! Der eitrige Kopf trifft Dich mitten im Gesicht!\n";
  }
  if (treffer==3)
  {
    werfer_string = "PATSCH! Der eitrige Kopf trifft " + victim_name + "'s Nase mit voller Wucht - igitt!.\n";
    victim_string = "PATSCH! Der eitrige Kopf fliegt mit voller Wucht gegen Deine Nase - igitt!.\n";
  }
  if (treffer==4)
  {
    werfer_string = victim_name + " versucht zu schreien, und kriegt dabei den eitrigen Kopf mitten in den Mund - waeh!.\n";
    victim_string = "Du versuchst zu schreien, und kriegst den eitrigen Kopf dabei mitten in den Mund - waeh!.\n";
  }
  write(werfer_string);
  tell_object(victim,victim_string);
  if (treffer) this_object()->move(victim);
  return 1;
}

