// paralyse im Kampf: fuer eine gewisse Zeit kann kein PlayerKommando 
// ausgefuehrt werden.von eumel bzw woody veraender von dante

inherit "/players/eumel/zust/fluch";

init() {
     ::init();
     if (find_call_out("remove")==-1) call_out("remove",10);
     add_action("paral","",1);
     id = "paralyse";
}

paral() {
    if (this_player()!=this_interactive()) return 0;
    if (!present("kannibalenpriester", environment(this_player()))) {
       remove();
       return 0;
       }
    write("Du stehst in Todesangst wie gelaehmt vor dem Priester!\n");
    return 1;
}
