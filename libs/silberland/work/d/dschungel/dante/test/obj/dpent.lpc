// 

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Pentagramm");
  SetProp(P_LONG, BS( 
    "Dieses Pentagramm gehoerte einst dem maechtigen Kannibalenpriester. Es "
    "hat sicherlich magische Faehigkeiten, aber Dir kleinem Wurm wird es die "
    "wahrscheinlich kaum offenbaren.\n"));
  
  SetProp(P_INFO, "Der Kannibalenpriester braucht es fuer seinen boesen Zauber.\n");
  SetProp(P_NAME, "Pentagramm");
  SetProp(P_GENDER,NEUTER);
  AddId(("pentagramm"));

  SetProp(P_MATERIAL, MAT_SILVER);
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 1);

}
