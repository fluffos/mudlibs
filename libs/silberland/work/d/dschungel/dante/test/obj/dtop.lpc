// topas von dante.c

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Topas");
  SetProp(P_LONG, BS( 
    "Der Topas ist ein Edelstein, den es in vielen Farbvarianten gibt. Er ist unter den Kannibalen "
    "als Schmuckstein sehr beliebt.\n"));
    
  SetProp(P_INFO, "Dieser Stein ist sicher sehr viel wert. ");
  SetProp(P_NAME, "Smaragd");
  SetProp(P_GENDER, MALE);
  AddId(("topas","edelstein","stein"));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1300);
  SetProp(P_NOBUY, 0);

}
