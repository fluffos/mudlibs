// smaragd von dante.c

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Smaragd");
  SetProp(P_LONG, BS( 
    "Der Smaragd ist ein besonders seltener gruener Edelstein. Er glitzert und blinkt im"
    " Sonnenlicht so hell, das Du Deine Augen schliessen musst...\n"));
  SetProp(P_INFO, "Dieser Stein ist sicher sehr viel wert. ");
  SetProp(P_NAME, "Smaragd");
  SetProp(P_GENDER, MALE);
  AddId(("smaragd","edelstein","stein"));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 0);

}
