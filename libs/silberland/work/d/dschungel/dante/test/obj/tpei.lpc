//tireks schwanz als waffe peitsche
//wird je nach splitter besser
//neverdrop
//max wc 260

inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "files.h"


create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  AddId (({"peitsche", "schwanz", "tireksschwanz"}));       // IDs
  SetProp(P_SHORT, "Der Schwanz von Tireks");    //Kurzbeschreibung
  SetProp(P_LONG, BS(
   "Das ist der Schwanz des sagenumwobenen Monster Tireks. Er sieht wie "
   "eine dicke, extrem harte, aber doch leicht zu fuehrende Peitsche aus. "
   "Stahharte, gezackte Schuppen reissen die Haut Deiner Opfer auf, die 7 "
   "grossen Zacken am Ende des Schwanzes zerfetzen alles, was ihnen in die "
   "Quere kommt. Teilweise weist der Schwanze viele, kleine Loecher auf."));

  SetProp (P_NAME, "Tireksschwanz"); 
  SetProp (P_GENDER, MALE);  
  SetProp (P_VALUE, 3005+random(101)); 
  SetProp (P_WEIGHT, 900); 
  SetProp (P_MAGIC, 1);
  SetProp (P_WEAPON_TYPE, WT_WHIP);
  SetProp (P_DAM_TYPE, ({DT_WHIP, DT_TERROR, DT_PIERCE, DT_RIP})); 
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 200);
  SetProp (P_WC_FIXFACTOR, 0.6);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_SKIN, MAT_HORN, MAT_MAGIC, MAT_BONE]));
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 10, A_INT:15, A_DEX:15]));
  SetProp(P_INFO,"Die Loecher in dem Schwanz haben den Sinn, dass man in sie "
  "die Splitter von Tireksgebiss stecken kann, und so die Waffe mit spitzen, "
  "gefaehrlichen, kleinen Spiessen bestueckt, was ihre Wirkung natuerlich "
  "verbessert.\n");
  AddCmd(({"stecke", "steck"}), "putin");
}

putin(string str)
   {
   object ob;
   int oldwc, oldamount;
   oldwc=TO->QueryProp(P_WC);
   
   
   notify_fail("Was willst Du worein stecken?\n");
   if (!str) return 0;
   
    if (!deep_present("spli", TP))
    {
    write("Du hast nichts geeignetes dafuer.\n");
    return 1;
    }
    
    if(member(({"splitter in loch", "spliiter in loecher", "splitter in peitsche",
    "splitter in schwanz", "zaehne in loch", "zahn in loch", "zahn in peitsche",
    "zaehne in peitsche", "zaehne in schwanz", "zahn in schwanz"}), str)!=-1)
        //hoffe du denkst nix falsches:)
        {
       ob=("d/dschungel/dante/stein/obj/spli");
       oldamount=ob->QueryProp(P_AMOUNT);
          TO->SetProp(P_WC, 5+oldwc);
          write("Du steckst den Splitter in die Peitsche.");
         oldamount--;
          return 1;
          }
     return 0;
     }
                     



