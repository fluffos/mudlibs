/*
** Steinpilz
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Eierschwammerl");
  SetProp (P_LONG, "Ein kleines orangeleuchtendes Eierschwammerl.\n");
  SetProp (P_NAME, "Eierschwammerl");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 50);
  SetProp(P_SIZE, 20);
  SetProp (P_NOBUY, 0);
  SetProp(P_INFO, ("Dieser Pilz stammt aus Dantes Pilzfarm. Man nennt ihn auch Pfifferling. \n"));
  AddId (({"pilz","schwammerl","eierschwammerl"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 12, F_SOAK: 3, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
write ("Du isst das Eierschwammerl mit grossem Genuss.\n");
say (TPN+"verspeisst das Eierschwammerl mit grossem Genuss.\n");
return ::BeimEssen();
}