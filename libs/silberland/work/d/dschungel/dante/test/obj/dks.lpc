// kniescheibe von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Kniescheibe");
  SetProp(P_LONG, BS( 
    "Dieser Knochen gehoerte einst zu einem abenteuerlustigen Zwerg. Er war wohl zu "
    "unternehmungsfreudig, denn sonst wuerdest Du nicht seine Kniescheibe in den "
    "Haenden halten. Auf der Vorderseite kann Du seltsame Kratzer erkennen."));
    AddDetail(({"kratzer","vorderseite"}),
    "Hmm, hier hat ein Kannibale wohl sehr kraeftig genagt!\n");
  AddDetail(({"zwerg","haende","haenden"}),
  "Zwergen sind eigentlich bei den Kannibalen nicht sehr beliebt. Zu wenig und zu "
  "zaehes Fleisch, aber Du kennst das ja...\n");
  
  SetProp(P_INFO, "Wie geht der Zwerg ohne Kniescheibe bloss...\n");
  SetProp(P_NAME, "Kniescheibe");
  SetProp(P_GENDER,FEMALE);
  AddId(({"kniescheibe","knochen"}));

  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 0);

}
