#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
//  SetProp(P_LONG, 0); 
  AddId(({"objekt"}));
  SetProp(P_INVIS, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, 1);
  SetProp(P_NODROP, 0);
  call_out("st1", 10);
}
st1()
{
write("Du furzt laut.\n");
say(""+TPN+" furzt laut und lacht dabei.\n");
call_out("st2", 8);
}

st2()
{
write("Du stinkst erbaermlich.\n");
say(""+TPN+" stinkt erbaermlich.\n");
call_out("st3", 8);
}
st3()
{
write("Du kotz Dich voll.\n");
    say(""+TPN+" kotzt sich voll.\n");
      call_out("st4",8);
      }
     
 st4()
 {
 write("Du machst Dir in die Hosen.\n");
 say(""+TPN+" macht sich in die Hose.\n");
 call_out("st5", 8);
 }
 st5()
 {
 write("Du stinkst erbaermlich.\n");
 say(""+TPN+" stinkt wie ein Schweinestall.\n");
 call_out("st6", 8);
 }
 st6()
 {
 write("Du furzt laut.\n");
 say(""+TPN+" furzt Dich genau an.\n");
 call_out("st7", 8);
 }
 st7()
 {
 write("Du bohrst in der Nase und isst die Popel auf.\n");
 say(""+TPN+" bohrt in der Nase und isst die Popel genuesslich auf.\n");
 call_out("st8",8);
 }
 st8()
 {
 write("Du rotzt Dich selbst an.\n");
 say(""+TPN+" rotzt sich selbst an und freut sich dabei.\n");
 say(""+TPN+" tritt Dir zwischen die Beine.\n");
 
 call_out("st9", 8);
      }
      
 st9()
 {
 write("Du stinkst erbaermlich, furz aber weiter!\n");
 say(""+TPN+" stinkt erbaermlich, furz aber weiter.\n");
 call_out("st10", 8);
 }
 st10()
 {
 write("Du schaemst Dich, weil du so ein ekliges Schwein bist.\n");
 say(""+TPN+" schaemt sich, weil "+TPN+" ein ekliges Schwein ist.\n");
 call_out("st1",100 );
 }
      