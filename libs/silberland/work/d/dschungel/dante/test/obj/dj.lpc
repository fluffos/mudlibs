#include <properties.h>

inherit "std/thing";

int rauchen,dauer;
object player;

create() {
	::create();
	AddId("joint");
	SetProp(P_NAME,"Joint");
	SetProp(P_SHORT,"Joint");
	SetProp(P_LONG,"Dies ist ein echt guter Joint. Vielleicht solltest du ihn rauchen.\n");
	SetProp(P_WEIGHT,1);
	SetProp(P_VALUE,0);
	SetProp(P_GENDER,1);
	rauchen = 0;
	dauer = 5;
}

init()
{
	::init();
	add_action("rauche","rauch");
	add_action("rauche","rauche");
}
rauche(arg) {
        int gift;
        int gift1;
	if(arg != "joint") return 0;
	if (rauchen == 1) {
		write("Aber Du rauchst doch schon einen.\n");
		return 1;
	}
	rauchen = 1;
	player=this_player();
                write("Du setzt Dich hin und rauchst den Joint. Das ist wirklich guter Stoff.\n"+
			"Du fuehlst Dich etwas benommen.\n");
		say(capitalize(player->name())+" setzt sich hin und raucht einen Joint.\n");
                this_player()->drink_alcohol(10);
/*
		gift = random(5);  
               	if(gift==3) {
			gift1 = player->query_poison();
			gift = gift+1;
			this_player()->set_poison(gift1);
                       	write("AAHH! Das war wohl keine gute Idee!\n");
                       	write("Du spuerst wie dein Koerper vergiftet wird!\n");
			} 
*/ 
	call_out("rauch",6);
	return 1;
}

rauch() {
	if(dauer>0) {

		write("Der Rauch des Joints huellt Dich in dicke Rauchwolken ein. Du fuehlst Dich\n"+
			"wie im siebten Himmel.\n");
		say(capitalize(player->name())+" wird von dicken Rauchwolken aus "+this_player()->QueryPossPronoun(1, 2)+" Joint eingehuellt.\n");
		dauer=dauer-1;
		call_out("rauch",10);
		return 1;
	}
	write("Nun hast Du den Joint aufgeraucht. Die Qualmwolken um Dich loesen sich\n"+
		"langsam auf. Allmaehlich kommst Du auf den Boden der Tatsachen wieder zurueck.\n"
		"Dante erscheint vor Dir und meint: Rauch bloss nicht zuviel davon!!*grins*\n");
	say(capitalize(player->name())+" hat den Joint aufgeraucht und wird langsam wieder normal.\n");
	rauchen=0;
	remove();
	return 1;
}                                                                                               
 