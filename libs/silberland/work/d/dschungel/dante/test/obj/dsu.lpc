#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Schulterblatt");
  SetProp(P_LONG, BS( 
    "Der einstige Besitzer dieses Knochen war ein Hobbit namens Frodo der Dritte. "
    " Er wollte es seinem beruehmten Namensvetter gleich tun, hatte aber weniger "
    "Erfolg...\n"));
    AddDetail(({"hobbit","frodo","namensvetter"}),
    "Frodo Beutlin war der Held vieler Abenteuer, die Du im Herrn der Ringe von J.R.R"
    " Tolkien nachlesen kannst."); 
  SetProp(P_INFO, "Dieser Frodo war eher ein Versager.\n");
  SetProp(P_NAME, "Schulterblatt");
  SetProp(P_GENDER, NEUTER);
  AddId(({"schulterblatt","knochen"}));

  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 0);

}
