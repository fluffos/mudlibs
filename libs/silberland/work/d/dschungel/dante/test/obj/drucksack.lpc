#include <properties.h>
inherit "/std/container";
#include <combat.h>
#include "files.h"  
#include "dbehaelter.lpc"  
  init () {SetProp(P_LIGHT, 1);
  ::init(); }
   
create()
{

behaelter::create();
 


  
  
  SetProp(P_SHORT, "Ein Rucksack"); 
  SetProp(P_LONG, ("Ein Rucksack aus einem dir unbekanntem Material. Es fuehlt "
                   "sich sehr fest und hart an und du glaubst die Reste von ehem"        
                   "maligen Schuppen zu erkennen. Man kann sicher einige Sachen in "  
                   "ihm unterbringen. Du siehst auch ein kleines Etikett.\n")); 
  AddId(({"rucksack", "sack"}));
  SetProp(P_NAME, "Rucksack");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 300);
  SetProp(P_TRANSPARENT,0);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAX_WEIGHT, 14000);
                                                                  
  
  SetProp(P_VALUE, 700);
  SetProp(P_INFO, ("Dieser Rucksack ist aus der Haut eines Feuerdrachen gemacht. "
                   "Sein magisches Material strahlt in der Dunkelheit Licht aus. "
                   "Wenn man den Rucksack anzieht, kann man mehr tragen!\n"));
  
  SetWearFunc(this_object());
  SetRemoveFunc(this_object());                 
                               
  SetProp(P_MATERIAL, MAT_MAGIC);
  
  AddDetail(("material"), 
                      "Niemals zuvor hast du etwas aehnliches gesehen. Es muss aus "
                      "aus einem fernen Land vor deiner Zeit stammen. Welches Ge"
                      "heimnis es wohl verbergen mag?\n");
  AddDetail(({"etikett","etikette"}),
                  "Copyright by Dante. Made in Silberland.\n");
  
  AddDetail(("schuppen"),
                         "Diese Schuppen muessen einst von sehr harter und rauher Kon"
                         "sistenz gewesen sein und sind einmal ein hervorragender Sch "
                         "utz fuer den ehemaligen Besitzer gewesen. Du bist sehr froh, "
                         "dass dieser nicht hier ist, sondern nur ein kleiner Teil "
                         "seiner frueheren Haut.\n");
                                                                                                                    
  AddDetail(("reste"), 
                      "Wenn man genau hinsieht kann man die Reste von grossen "
                      "rotleuchtenden Schuppen erkennen. Du gleitest ueber die "
                      "Oberflaeche und glaubst einen leichten elektrischen "
                      "Schlag zu spueren.\n");
} 

short() {
  string str;
  str=QueryProp(P_SHORT);
  str=str+(QueryProp(P_CNT_STATUS)?" (geschlossen)":" (geoeffnet)");
  str=str+(QueryProp(P_WORN)?" und (angezogen).\n":".\n");
  return str;
  }
  
long(){
 return behaelter::long();}

init()
{
behaelter::init();
     add_action("open","oeffne");
     add_action("close","schliesse);
     add_action("close","schlies");
     add_action("getout","nimm");
     add_action("putin","stecke");
     add_action("putin","steck");
     add_action("throw","wirf");
     add_action("throw","werfe");
     add_action("throw","lasse");
     add_action("throw","lass");
     add_action("throw","leg");
     add_action("throw","lege");
     
     }
       
            
open(str)
{
 if(!str) return 0;
 if(!id(str)) return 0;
 if(this_object()->QueryWorn())
    {
    write("Den Rucksack musst du dazu wohl ausziehn!\n");
    return 1;
    }
 return ::oefne(str);
 
 }   
  
 close(str)
  {
  if(!str) return 0;
  if(!id(str) return 0;
  if(this_object()->QueryWorn())
          {
          write("Dazu musst du den Rucksack ausziehn!\n");
          return 1;
          }
         
  getout(str)
  {
     string dum, dum2;
     if(str && sscanf(str,"&s aus %s",dum,dum2))
     {
     if(dum2=="sack"||dum2=="rucksack")
       if(this_object()->QueryWorn())
       {
       write("Du musst den Rucksack erstmal ausziehn!\n");
       return 1;
       }
       
      } 
   }     
       
               
 putin(string str)
   {
      string dum, dum";
      if(str && sscanf(str,"%s in %s",dum,dum2))
      {
      if(dum2=="rucksack"||dum2"sack")
      if this_object()->QueryWorn())
       {
        write("Dazu muss du den Rucksack ausziehn!\n");
        return 1;
        
       }
      }
   }      


int WearFunc(object ob)
{
Set(P-TOTAL_WEIGHT;QueryProp(P_TOTAL_WEIGHT)*2,F_QUERY_METHOD);

return 1;
}

throw(str)
{
 
 string d1,d2;
   if(str && sscanf(str,"%s %s",d1,d2)==2)
     if(d1=="rucksack"||d1=="sack"||d1=="alles")
     if(d2=="weg"||d2=="ab")
        {
        RemoveFunc(this_object());
        this_object()->SetProp(P_Worn,0);
        }
  }      
     
     
          