// diamant von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Diamant");
  SetProp(P_LONG, BS( 
    "Der Diamant ist der haerteste Stein auf dieser Welt. Viele nennen ihn den Koenig"
    " der Edelsteine. Es gibt ihn farblos, aber auch in vielen Farbvarianten.\n"));
  SetProp(P_INFO, "Dieser Stein ist sicher sehr viel wert. ");
  SetProp(P_NAME, "Smaragd");
  SetProp(P_GENDER, MALE);
  AddId(("diamant","edelstein","stein"));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 1600);
  SetProp(P_NOBUY, 0);

}
