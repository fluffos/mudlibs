// gold von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Goldklumpen");
  SetProp(P_LONG, BS( 
    "GOLD!!!GOLD!!! So haben schon viele Abenteurer einen Goldfund bejubelt, aber noch"
    " viel mehr Abenteurer hat der Goldrausch den Tod gekostet!!!\n"));
  SetProp(P_INFO, "Gold ist sehr sehr schwer... ");
  SetProp(P_NAME, "Goldklumpen");
  SetProp(P_GENDER, MALE);
  AddId(("goldklumpen","klumpen","gold"));

  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 1900);
  SetProp(P_NOBUY, 0);

}
