// Amethyst von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Amethyst");
  SetProp(P_LONG, BS( 
    "Dieser Edelstein ist unter den Eingeborenen sehr beliebt. Sie schreiben ihm "
    "grosse Heilkraefte zu.\n"));
  SetProp(P_INFO, "Bist Du genauso aberglaeubisch wie diese Wilden? ");
  SetProp(P_NAME, "Amethyst");
  SetProp(P_GENDER, MALE);
  AddId(("amethyst","edelstein","stein"));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 0);

}
