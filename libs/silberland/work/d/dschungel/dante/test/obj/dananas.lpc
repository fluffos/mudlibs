/* eine ananas dante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Zwergananas");
  SetProp (P_LONG, "Eine frische Zwergananas aus dem Dschungel.\n");
     
  SetProp (P_NAME, "Zwergananas");
  SetProp (P_GENDER, FEMALE);
  AddId (({"zwergananas", "frucht","ananas"}));
  SetProp (P_INFO, ("Die Zwergananas ist eine besondere Zuechtung von Dante.\n"
                    "Ihr fehlt die sonst ungeniessbare Schale.\n")); 
  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 500);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 20, F_SOAK: 10, F_ALCOHOL: 5, F_POISON:0]));
}

BeimEssen()
{
  write ("Dante wuenscht Dir guten Appetit...\n");
  say (TPN+" verspeisst die Zwergananas und jubelt vor Entzuecken.\n");
  return ::BeimEssen();
}
