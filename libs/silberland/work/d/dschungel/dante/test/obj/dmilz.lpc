/* eine gute milz dante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Milz");
  SetProp (P_LONG, "Dieses Organ gehoerte einst einem Elf. Er hat wohl auch Bekanntschaft"
     " mit den Kannibalen gemacht...\n");
  SetProp (P_NAME, "Milz");
  SetProp (P_GENDER, FEMALE);
  AddId ("milz");
  SetProp (P_INFO, ("Die Milz ist in einem guten Zustand..."));
  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 800);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 10, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst die Milz mit gemischten Gefuehlen.\n");
  say (TPN+" verspeisst die Milz mit seltsamen Gesichtsausdruck.\n");
  return ::BeimEssen();
}
