// eine feder fuer den archeopterix
#include "files.h"
#include <properties.h>
#include <language.h>
inherit "std/thing";

create()
{
 if (!is_clone(TO) ) return;
 :: create();
 SetProp(P_SHORT, "Eine Feder");
 SetProp(P_LONG, (
 "Diese wunderschoene farbenpraechtige Feder gehoerte einst dem Urvogel "
 "Archaeopterix. Ihre praechtige Musterung begeistert Dich immer wieder"
 "aufs neue, bestimmt ist sie viel wert.\n"));
 SetProp(P_INFO, "Schaem Dich, das Du diesen schoenen Vogel getoetet hast!\n");
 SetProp(P_NAME, "Feder");
 SetProp(P_GENDER, FEMALE);
 AddId("feder");
 SetProp(P_MATERIAL, MAT_ANIMAL);
 SetProp(P_VALUE, 600);
 SetProp(P_WEIGHT, 50);
 SetProp(P_SIZE, 60);
 AddDetail(({"muster","musterung"}),
   "Die Zeichnung dieser Feder uebertrifft auch die Kunstwerke der Zwerge.\n");
 }
 