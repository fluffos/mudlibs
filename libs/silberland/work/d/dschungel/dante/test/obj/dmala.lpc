
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "files.h"
#include <wizlevels.h>


object player;
create() 
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"MALA"}));
call_out("st1", 100);

SetProp(P_WEIGHT, 0);
}


  
 st1()
 
 {
 player=this_player();
 
 write(
       "Dir wird ploetzlich ganz heiss...\n");
  say(capitalize(player->name())+" bekommt einen roten Kopf.\n");     
       
 call_out("st2",10);           
 
  }  
      
st2()
 { say(capitalize(player->name())+" schwitzt sehr stark.\n");
 
 write("Du schwitzt sehr stark...\n");
 TP->reduce_hit_point(10);         
      call_out("st3",10); 
       }
       
 st3()
 { 
  say(capitalize(player->name())+" scheint hohes Fieber zu haben.\n");
   write(
        "Du fuehlst Dich sehr schwach.\n");
  call_out("story4", 10);
  }           
  story4()
  { 
   say(capitalize(player->name())+" scheint sehr krank zu sein.\n");
   write(
        "Du scheinst eine schlimme Krankheit zu haben.\n");
        TP->reduce_hit_point(15);
  call_out("story5", 10);
  }
  story5()
  {  say(capitalize(player->name())+" taumelt herum...\n");
  write(
        "Du hast sehr hohes Fieber...\n");
  call_out("story6", 10);
    say(capitalize(player->name())+" hat sehr boesen Schuettelfrost.\n");
  }                    
  story6()
  {  say(capitalize(player->name())+" redet wirres Zeug im Fieberwahn.\n");
  write(
        "Du wirst immer schwaecher...\n");
        TP->reduce_hit_point(20);
  call_out("story7", 10);
  }
  story7()
  {  say(capitalize(player->name())+" schaut sehr krank aus.\n");
  write(
        "Du scheinst an der Malaria erkrankt zu sein.\n");
  call_out("story8", 10);
  }
  
  story8()
  { write(
        "Du hast sehr hohes Fieber.\n");
  call_out("story9", 10);
  }
 story9()
 { say(capitalize(player->name())+" scheint zu gluehen.\n");
 write(
       "Du hast sehr schlimmen Schuettelfrost.\n");
        say(capitalize(player->name())+" wird von Schuettelfrost gebeutelt.\n");
 call_out("story10", 10);
 TP->reduce_hit_point(15);
 }
 
 story10()
 { write(
       "Das Fieber wird immer hoeher...\n");
 call_out("story11", 15);
  say(capitalize(player->name())+" schwitzt sehr stark.\n");
 }      
 story11()
 { write(
       "Du taumelst nur mehr umher...\n");
 call_out("story12", 10);
   say(capitalize(player->name())+" ist an Malaria erkrankt.\n");
   TP->reduce_hit_point(10);
 }
 
 
 
 
 
 story12()
 
 {  say(capitalize(player->name())+" hat sehr hohes Fieber.\n");
 write(
       "Du fuehlst Dich sterbenskrank!\n");
       call_out("story13" ,10);
       TP->reduce_hit_point(15);
       }
 story13()
 { say(capitalize(player->name())+" fuehlt sich sehr schlecht.\n"); 
 write(
       "Du wirst von Schuettelfrost gebeutelt.\n");
       call_out("story14", 10);
       }
       
 story14()
 { say(capitalize(player->name())+" kotzt sich von oben bis unten an...\n");
 write(
 "Die Malaria hat Dich voll erwischt.\n");
 TP->reduce_hit_point(15);      
  call_out("story15", 10);
  }
  
story15()
{ say(capitalize(player->name())+" scheint zu gluehen.\n");
write(
"Du hast extrem hohes Fieber.\n");
 call_out("story16", 10);
 }
 story16()
 { say(capitalize(player->name())+" wird von Schuettelfrost gebeutelt.\n");
 write(
 "Du scheinst bald zu sterben...\n");
 call_out("story20", 10);
 TP->reduce_hit_point(20);
 }
   
  story20()
  { say(capitalize(player->name())+" schwitzt sehr stark...\n");
  write(
  "Du taumelst nur mehr im Fieberwahn herum...\n");
  call_out("story21", 10);
  }
  
  story21()
  { say(capitalize(player->name())+" hat sehr hohes Fieber.\n");
  write(
  "Soll das wircklich schon Dein Ende sein?\n");
  call_out("story22" ,10);
  }
  
  story22()
  {
  write(
 "Dein Kopf scheint zu gluehen...\n");
 call_out("story17" ,10);
 TP->reduce_hit_point(10); 
  }
       
 story17()
 { say(capitalize(player->name())+" ist an Malaria erkrankt.\n");
 write(
  "Dein Fieber scheint zu sinken...\n");
      call_out("story18", 10);
      }
 
 
 
 story18()
  { say(capitalize(player->name())+" scheint Fieber zu haben.\n");
  write(
      "Du erholst Dich langsam wieder...\n");
call_out("story19", 5);

}          

story19()
{ say(capitalize(player->name())+" scheint die Malaria zu ueberwinden.\n");
   
 
 write(
 "Das Fieber sinkt und sinkt... \n");
 call_out("story30", 3);
 } 

story30()
{ say(capitalize(player->name())+" ist scheinbar wieder gesund.\n");
write(
"Du hast die Malaria ueberwunden.\n"
" \n");
remove("malaria");
return 1;
}