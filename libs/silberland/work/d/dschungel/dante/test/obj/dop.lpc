// opal von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Opal");
  SetProp(P_LONG, BS( 
    "Dieser Edelstein ist ein blaeulich bis weisses Kunstwerk der Natur. Besonders "
    " wertvoll ist der Feueropal, der aber nur sehr selten gefunden wird.\n"));
  SetProp(P_INFO, "Dieser Stein ist sicher sehr viel wert. ");
  SetProp(P_NAME, "Opal");
  SetProp(P_GENDER, MALE);
  AddId(("opal","edelstein","stein"));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 1300);
  SetProp(P_NOBUY, 0);

}
