// unterkiefer von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Unterkieferknochen");
  SetProp(P_LONG, BS( 
    "Was Du hier vor Dir siehst ist ein Unterkieferknochen eines ungluecklichen "
    " Abenteurers. Die Kannibalen waren ueber diese unverhoffte Mahlzeit aber "
    "um so gluecklicher...\n"));
    AddDetail(({"kannibalen","mahlzeit","abenteurer"}),
    "Sei bloss vorsichtig, sonst endest Du auch noch so...\n");
  SetProp(P_INFO, "Als Zahnprotese ist der nicht mehr zu verwenden...\n");
  SetProp(P_NAME, "Unterkieferknochen");
  SetProp(P_GENDER, MALE);
  AddId(({"unterkieferknochen","knochen","kiefer"}));

  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 0);

}
