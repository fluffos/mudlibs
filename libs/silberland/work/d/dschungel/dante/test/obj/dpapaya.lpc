/* eine papaya dante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Papaya");
  SetProp (P_LONG, "Eine reife Papaya aus dem Dschungel.\n");
     
  SetProp (P_NAME, "Papaya");
  SetProp (P_GENDER, FEMALE);
  AddId (({"papaya", "frucht"}));
  SetProp (P_INFO, ("Die Papaya schmeckt sicher herrlich."));
  SetProp (P_VALUE, 40);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 12, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst die Papaya mit grossem Genuss.\n");
  say (TPN+" verspeisst die Papaya mit grossem Genuss.\n");
  return ::BeimEssen();
}
