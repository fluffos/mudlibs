// saphir von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Saphir");
  SetProp(P_LONG, BS( 
    "Der Saphir ist ein blau glitzernder Edelstein. Er funkelt und strahlt im Licht, "
    "das Du kurz wegschaun musst.\n"));
  SetProp(P_INFO, "Dieser Stein ist sicher sehr viel wert. ");
  SetProp(P_NAME, "Saphir");
  SetProp(P_GENDER, MALE);
  AddId(("saphir","edelstein","stein"));

  SetProp(P_MATERIAL, MAT_JEWEL);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);

}
