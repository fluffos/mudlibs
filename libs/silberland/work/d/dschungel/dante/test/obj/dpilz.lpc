 story17()
 { say(capitalize(player->name())+" waelzt sich am Boden...\n");
 write(
 "     \n"
 "     \n"
 "     \n"
  "LARS schaut Dich an, grinst und schnippt mit den Fingern....\n"
       "                                               \n"
       "                                                       \n");
      call_out("story18", 5);
      }
 
 
 
 story18()
  { say(capitalize(player->name())+" fleht um Gnade...\n");
  write(
  "   \n"
  " \n"
  " \n"
    "Alles beginnt sich zu drehen und Dir schwinden wieder die Sinne.\n"
    "            \n"  
    "            \n"               
 
 "Dante erscheint, lacht Dich aus und sagt: Du Narr hast nochmal Glueck gehabt!\n"
      "                                                                     \n"
      "         \n");
call_out("story19", 5);

}          

story19()
{ say(capitalize(player->name())+" faellt bewusstlos um...\n");
 TP->SetProp(P_POISON, 2);   
 
 write(
 " \n"
 "Du erwachst aus diesem Alptraum und findest Dich am Boden liegend wieder...\n"
 " \n"
 " \n"
 " \n");
 call_out("story30", 3);
 } 

story30()
{ say(capitalize(player->name())+" scheint wieder zu erwachen...\n");
write(
"Du hast starke Kopfschmerzen und kannst nur mit Muehe wieder aufstehen...\n"
" \n");
remove("pilz");
return 1;
}