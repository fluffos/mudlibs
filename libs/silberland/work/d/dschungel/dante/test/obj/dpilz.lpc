
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "files.h"
#include <wizlevels.h>



int essen;
object player;
create() 
{

::create();

SetProp(P_SHORT, "Ein Pilz");

SetProp(P_LONG, "Dieser Pilz sieht nicht besonders aussergewoehnlich aus "
                "Er hat eine kleine, runde Kappe und einen langen duennen "
                "Stiel. Ob er geniessbar ist?\n");
AddId (({"psychopilz", "pilz"}));


SetProp(P_NOBUY, 1);
SetProp(P_MATERIAL, MAT_MAGIC);
SetProp(P_GENDER, MALE);
SetProp(P_NAME, "Pilz");
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 100);
AddDetail (("kappe"),
            "Die schwarz schillernde Kappe gefaellt Dir gut.\n");
AddDetail (("stiel"),
           "Der Stiel ist weisslich und sehr duenn.\n");
SetProp(P_INFO, ("Dieser Pilz ist ein Psilocype mexicana. Der Wirkstoff, den er "
                 "enthaelt ist ein starkes Halluzinogen , das Psilocybin, das schon " 
                 "vor mehr als 3000 Jahren vor allem in Sued- und Mittelamerika ein "
                 "beliebtes Rauschmittel war. Es wird aber auch in der modernen "
                 "Psychotherapie zur Behandlung von Psychoneurosen verwendet. "
                 "Man kann den Pilz verschlucken.\n"));
SetProp(P_WEIGHT, 100);
essen = 0;


  }
  init()
{
  ::init();
add_action("essen","schlucke" );
add_action("essen","verschlucke");
}

essen(arg)
{
if(arg != "pilz") return 0;
if (essen == 1) 
{
write ("Aber Du hast doch gerade einen geschluckt!");
 return 0;
   }
   essen = 1;
   player=this_player();
   

write("Du isst den Pilz voller Freude.....doch irgendwie hast\n"
      "Du ein seltsames Gefuehl. Ob es gut war den zu essen?\n");
 
          
 say(capitalize(player->name())+" isst den Pilz. Irgendwas scheint merkwuerdiges zu passieren...\n");

 
 
 call_out("story1",10);
 
 }     
 story1()
 
 {
 
 
 write(
      "                                                         \n"  
      "                                                         \n"
      "                                                         \n"
       "Ploetzlich erschreckst Du Dich als du feststellen musst,\n"
       "dass sich Deine Sinneswahrnehmungen sehr drastisch ver-\n"
       "aendert haben! Alles schaut so ungewohnt aus, so verzerrt!\n"
       "Du bekommst es mit der Angst zu tun....\n");
  TP->SetProp(P_TITLE, "liebt Dantes Pilze...");     
  say(capitalize(player->name())+" benimmt sich aeusserst merkwuerdig...\n");     
  clone_object("/d/dschungel/dante/weg/obj/trip.lpc")->move(TP, M_NOCHECK);       
       
 call_out("story2",10);           
 
  }  
      
story2()
 { say(capitalize(player->name())+" kriecht am Boden herum...\n");
 
 write("                                                          \n"
 "                                                              \n"
 "                                                               \n"
      "....Farben, viele Farben schwirren um Dich herum....\n");
      call_out("story3",9); 
       }
       
 story3()
 { 
  say(capitalize(player->name())+" benimmt sich aeusserst merkwuerdig...\n");
   write(
  " \n"
  " \n"
  " \n"
        ".....Du hoerst Toene und Geraeusche wie nie zuvor....\n"
        "      ....was soll das alles ueberhaupt.....\n"
        "sollte etwa der, aeh, hmm, vernuenftig zu denken faellt\n"
        "Dir schon sehr schwer, PILZ die Ursache sein........\n"
        "     ....aber das alles ist Dir ganz egal....\n");
  call_out("story4", 10);
  }           
  story4()
  { 
   say(capitalize(player->name())+" lallt wirres Zeug...\n");
   write(
  " \n"
  " \n"
  " \n"
   ".....Du scheinst zu schweben.....\n"
        "....die Welt ist ja so ein schoener Ort....\n"
        "...Du grinst gluecklich und zufrieden....\n" 
        "..und Du schwebst weiter und weiter....\n");
  call_out("story5", 10);
  }
  story5()
  {  say(capitalize(player->name())+" ruft: Farben, alles voller Farben...\n");
  write(
  " \n"
  " \n"
  " \n"
    "....Deine Haut fuehlt sich ganz warm an....\n"
        "      ...und trotzdem frierst Du...\n"
        "...die Farben scheinen zu Dir zu sprechen...\n"
        "....seltsam aber Du kannst sie verstehen...\n");
  call_out("story6", 10);
    say(capitalize(player->name())+" benimmt sich aeusserst merkwuerdig...\n");
  }                    
  story6()
  {  say(capitalize(player->name())+" zieht sich nackt aus und waelzt sich am Boden.\n");
  write(
  " \n"
  " \n"
  " \n"
        "....ploetzlich spricht Dich ein Baum an....\n"        
        "...und verwandelt sich in einen Stein...\n"
        "...du fuehlst Dich ganz und gar eins mit der Natur...\n"
        "...willst Deine Kleider vom Leib reissen...\n"
        "  ...und nackt durch die Gegend laufen...\n");
  call_out("story7", 10);
  }
  story7()
  {  say(capitalize(player->name())+" glaubt ein gelber Baum zu sein...\n");
  write(
  " \n"
  " \n"
  " \n"
     "               ...Deine Beine sind voellig gefuehllos...\n"
        "            ...und Deine Leber beklagt sich bei Dir..\n"      
        "        ...Du solltest wohl weniger Alkohol trinken...\n"
        "...irgendwie steigt in Dir ein beklemmendes Gefuehl hoch...\n");
          say(capitalize(player->name())+" benimmt sich aeusserst merkwuerdig...\n");
  call_out("story8", 10);
  }
  
  story8()
  { write(
  " \n"
  " \n"
  " \n"
      "...Du bemerkst wie sich Dein Gesicht zu einer Fratze wird...\n"
        "..es beginnt sich nach innen zu stuepen, was hoellisch schmerzt...\n"
        "          ...Du willst schreien, nach Hilfe rufen...\n"
        "        ...aber Du kannst nicht, denn du bist stumm....\n");
  call_out("story9", 10);
  }
 story9()
 { say(capitalize(player->name())+" sabbert auf den Boden...\n");
 write(
 " \n"
 " \n"
 " \n"
  "....verzweifelt reisst Du denn Mund weit auf....\n"
       "         ...und erschrickst furchtbar...\n"
       "      ...dort wo frueher Deine Zunge war...\n"
       "...steckt nun ein Klumpen faules Fleisch...\n"
       "          ...Du uebergibst Dich...\n");
        say(capitalize(player->name())+" benimmt sich aeusserst merkwuerdig...\n");
 call_out("story10", 10);
 }
 
 story10()
 { write(
   " \n"
   " \n"
   " \n"
 "         ...Du hast furchtbare Angst...\n"
       "  ...das Blut haemmert in Deinem Schaedel...\n"
       "    ...und Du fuerchtest um Dein Leben...\n"
       "    ...Deine tote Mutter zieht vorbei...\n"
       "    ...im Arm ein totes Neugeborenes...\n"
       "   ...und Du weisst, dass es DU bist...\n"  
       "...wann wird dieser Alptraum wohl enden...\n");
 call_out("story11", 15);
  say(capitalize(player->name())+" schlaegt auf einen unsichtbaren Gegner ein.\n");
 }      
 story11()
 { write(
 " \n"
 " \n"
 " \n"
   "...Du jammerst und flehst man moege dich erloesen...\n"
       "             ...doch niemand hoert Dich...\n"
       "...Du laeufst und laeufst, doch kommst nicht vom Fleck...\n"
       "       ...erschoepft brichst Du nieder...\n"
       "      ... und Dir schwinden die Sinne...\n");
 call_out("story12", 10);
   say(capitalize(player->name())+" benimmt sich aeusserst merkwuerdig...\n");
 }
 
 
 
 
 story12()
 
 {  say(capitalize(player->name())+" scheint Todesangst zu verspueren.\n");
 write(
 " \n"
 " \n"
 " \n"
   "LARS schuettelt den Kopf und meint zu TIMOTHY LEARY:\n"
   " \n"
       "Wieder so ein dummer Sterblicher der von Dantes Pilzen ass...\n"
       "...koennens einfach nicht lassen, diese Idioten...glauben das\n"
       "was ihr ihnen predigt und zahlen mit ihrem Leben!!!\n");
       call_out("story13" ,10);
       }
 story13()
 { say(capitalize(player->name())+" windet sich unter starken Schmerzen am Boden.\n"); 
 write("                                                \n"
       " \n"
       " \n"
       "W.S.BORROUGHS sagt zu LARS: HEY Lars sei nicht so....\n");
       call_out("story14", 5);
       }
       
 story14()
 { say(capitalize(player->name())+" kotz sich von oben bis unten an...\n");
 write(
 " \n"
 " \n"
 " \n"      
 "TIMOTHY LEARY groellt: Nimm lieber noch'n Schluck Schnaps Lars...\n");      
  call_out("story15", 5);
  }
  
story15()
{ say(capitalize(player->name())+" scheint wie erstarrt einen Punkt im Raum zu fixieren.\n");
write(
" \n"
" \n"
" \n"
"W.S.BORROUGHS sagt: Hey LARS, jeder hat ne zweite Chance verdient...\n");
 call_out("story16", 5);
 }
 story16()
 { say(capitalize(player->name())+" kniet ploetzlich nieder und fleht um das Leben.\n");
 write(
 " \n"
 " \n"
 " \n"
 "LARS sagt: Hmm, nein, lieber was zum Rauchen...\n");
 call_out("story20", 5);
 }
   
