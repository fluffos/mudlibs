/* eine gute mango dante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine ganz spezielle Passionsfrucht");
  
  SetProp (P_LONG, BS("Die Passionsfrucht ist eine der leckersten und schoensten Fruechte "                                                
                   "des ganzen Dschungels. Natuerlich hat sie Dante gezuechtet, der ja "  
                   "im ganzen Silberland fuer seinen exzellenten frukalen Geschmack "
                   "beruehmt und geliebt ist.\n"));      
                                                                          
  SetProp (P_NAME, "Passionsfrucht");
  SetProp (P_GENDER, FEMALE);
  AddId (({"passionsfrucht", "frucht"}));
  SetProp (P_INFO, ("Die Passionsfrucht leuchtet im Dunklen. "));
  SetProp(P_LIGHT, 1);
  SetProp (P_VALUE, 40);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 15, F_SOAK: 1, F_ALCOHOL: 10, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst die Passionsfrucht mit grossem Genuss.\n");
  say (TPN+" verspeisst die Passionsfrucht mit grossem Genuss.\n");
  return ::BeimEssen();
}
