inherit "std/food";
#include <food.h>
#include "files.h"
#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine Pizza");
  SetProp(P_LONG,"Eine schoen belegte und mit Liebe gebackene Pizza. \n");
  AddId(({"pizza","Pizza"}));
  SetProp(P_NAME,"Pizza");
  SetProp(P_NAME_ADJ, "herrlich", "lecker belegte", "gute");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,50);
  SetProp(P_VALUE,0);
  SetProp(P_MATERIAL,MAT_FOOD);
  SetProp(P_INFO, ("Es handelt sich hierbei um eine Pizza, die vom Pietro Pizzi Nostromo, dem Pizzameister und Herr ueber alle Pizzae in seinem\n" 
  		   "Steinofen gebacken wurde. Sie duftet herrlich.\n"));
  SetProp(P_FOOD_INFO, ([F_HEAL: 0, F_SOAK: 0, F_ALCOHOL: 0, F_POISON:0]));		   
  SetProp(P_SMELL, ("Sie stroemt einen herrlichen Duft aus, der Dir nicht mehr aus der Nase geht.\n"));
}

BeimEssen()
{
  write ("Gerade als Du die Pizza essen willst, erscheint Dante und klaut Dir Deine Pizza, lacht Dich aus, reibt sich den Bauch und verschwindet wieder.\n");
  say (TPN+" will die Pizza essen, aber Dante erscheint und nimmt ihm die Pizza einfach weg, lacht laut, reibt seinen Bauch und verschwindet wieder.\n");
  return ::BeimEssen();
}



