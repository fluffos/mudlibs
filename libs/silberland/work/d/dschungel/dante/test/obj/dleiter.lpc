// leuter von dante sl 97 feb

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein langer Baumstamm");
  SetProp(P_LONG, BS( 
    "Dieser Baumstamm wurde von irgendjemandem so barbeitet, dass man ihn gute als Leiter verwenden kann."));
  SetProp(P_NAME, "Baumstamm");
  AddDetail(("holz"),
  "Der Baumstamm ist aus hartem Eichenholz.");
  SetProp(P_GENDER, MALE);
  AddId(({"baumstamm","stamm"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 300);
  SetProp(P_VALUE, 200);
}
