
inherit "std/weapon";

#include <properties.h>
#include <combat.h>



create()
{
if (!is_clone(this_object()))
return;

::create();

SetProp(P_SHORT, "Eine leere Flasche");
SetProp(P_LONG, "Diese Flasche hat sicher der Trinker geleert. Sie ist hat eine "
                "gruenliche Farbe und liegt recht gut in der Hand. Vielleicht hat "
                "er sie ja als Waffe in so mancher Wirthausschlaegerei verwendet? "
                "Auf dem schmutzigen Etikett glaubst Du etwas zu erkennen.\n");

AddId("flasche");               
SetProp(P_VALUE, 150);
SetProp(P_WEIGHT, 100);
SetProp(P_SIZE, 40);
SetProp(P_WEAPON_TYPE, WT_CLUB);
SetProp(P_DAM_TYPE, DT_BLUDGEON);
SetProp(P_GENDER, FEMALE);
SetProp(P_MATERIAL, (MAT_GLASS));
SetProp(P_WC, 60);
SetProp(P_NR_HANDS, 1);
SetProp(P_NAME, "Flasche");
SetProp(P_INFO, ("Dies ist die magische Sandlerflasche. Wer sie zu oft benutz wird einer!"));

AddDetail(({"etikett","etikette"}),
           ("Du betrachtest das Etikett genauer und kannst ein Schloss und "
            "Weinberge erkennen. Du kratzt etwas Dreck von der Flasche "
            "und glaubst Chateau Clochard lesen zu koennen.\n"));

AddDetail(("schloss"),
           ("Man kann ein kleines, aber trotzdem imposantes Loire Schloss "
            "erkennen. Du schmunzelst als Du im Schlossgarten den Herrn des "
            "Schlosses bei einem wilden Gelage erblickst. Was ist das? "
            "Ein junges Burgfraeulein scheint sich von einem der Tuerme "
            "herab zu uebergeben. Zeiten sind das...!\n"));

AddDetail(({"berge","weinberge"}),
          ("Ringsum das Schloss kann man Weinberge erkennen. So weit das "
           "Auge reicht siehst Du die kultivierten Reben mit den suessen "            
           "Fruechten. Dir laeuft das wasser im Munde zusammen...\n"));             
AddDetail(({"clochard","chateau"}),
            "Tja, Franzoesisch muesste man koennen...");

AddDetail(({"gelage","garten","schlossgarten"}),
          ("Inmitten einer grossen Parkanlage tummeln sich illustre Gest- "
           "stalten froehlich lachend. Du siehst eine schoene Elfin, die "
           "auf einem der Brunnenraender einen Schleiertanz darbietet. "
           "Ein edler Ritter wird von jungen, kichernden Hobbitfraeulein "
           "bewundet, waehrend er von seinen Heldentaten in fernen Laendern "
           "berichtet. Der Burherr, ein fetter, aufgequollener Ork stopft "
           "sich gerade eine Hammelkeule in den Mund. Neben ihm  sitz "
           "an der Tafel ein Zauberer, der immer wenn die Weinfaesser leer "
           "sind, sie mit seiner Magie erneut anfuellt. Selbst trinkt er "
           "keinen Tropfen. Du kannst noch viele Gestalten erkennen, aber "
           "irgendwie wird dir das zu langweilig.\n"));  

AddDetail(({"turm","tuerme","fraeulein","burgfraeulein"}),
          ("Dieses Schloss hat viele hohe Tuerme, manche mit bunten Fahnen "
           "verziert, die im Wind hin und her tanzen. Eine dieser Fahnen "
           "sieht irgendwie besonders interessant aus. Andere Tuerme sind "
           "mit Zinnen bestueckt, zwischen denen du Pechnasen erkennst. "
           "Diese dienen im Kriegsfall zur Verteidigung des Schloss. Durch "
           "sie kann man, wie der Name schon sagt, siedendes Pech auf die "
           "Angreifer schuetten. Auf einem der Tuerme kannst du nun eine "
           "junge Frau, erkennen die nicht Pech, sondern ihren Mageninhalt "
           "von oben herab in den Schlossgraben leert.\n"));  

AddDetail(({"fahne","fahnen"}),
           ("Inmitten der vielen im Wind tanzenden Fahnen gefaellt dir diese "
            "eine besonders gut. Auf ihr siehst du Dante Alighieri, der von "
            "seinem Fuehrer Vergil gerade durch das Inferno geleitet wird. "
            "Es handelt sich hierbei um eine Darstellung aus der goettlichen  "
            "Komoedie. Der Kuenstler war Gustav Dore, der scheinbar nicht nur "
            "Kupferstiche gemacht hat, sondern auch Fahnen bemalt hat. Aber "
            "das ist dir voellig egal.\n"));
AddDetail(({"dante","vergil"}),
           ("Dante ist der Magier, der diese Flasche verbrochen hat!\n"   
           "Vergil ist sein Fuehrer durch die Hoelle!"));
  
          
}
                
