/* eine gute mandastromodante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Mandastromo");
  SetProp (P_LONG, "Eine herrliche, saftige Mandastromo aus den Plantagen von Tijara.\n");
     
  SetProp (P_NAME, "Mandastromo");
  SetProp (P_GENDER, FEMALE);
  AddId (({"mandastromo", "frucht"}));
  SetProp (P_INFO, ("Die Mandastromo ist eine Mischung aus den leckersten Fruechten, die \n"
                    "das Silberland zu bieten hat. Viele Zuechter haben sich daran probiert, \n"
                    "aber nur dem Magier Nostromo ist es gelungen sie zu zuechten. Am ehesten \n"
                    "schaut sie noch wie eine zu grossgeraten blaue Mandarine aus. Eigentlich \n"
                    "hat Nostromo sie ja Dante geklaut, aber...\n"));     
  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 15, F_SOAK: 10, F_ALCOHOL: 20, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst die Mandastromo mit sehr merkwuerdigem Geichtsausdruck.\n");
  say (TPN+" verspeisst die Mandastromo mit einem merkwuerdigem Gesichtsausdruck.\n");
  return ::BeimEssen();
}
