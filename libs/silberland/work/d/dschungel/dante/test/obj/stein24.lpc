// hoehle der steingiganten1

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


object ob;
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Schatzkammer der Steingiganten" );
  SetProp( P_INT_LONG, BS(
    "Du stehst nun in der Schatzkammer der Steingiganten. Eigentlich ist hier nichts anders als im Rest der Hoehle, ausser, dass hier einige Habseligkeiten der Steingiganten herumliegen. Alles, aber wircklich "
    "alles besteht hier aus purem Stein. Die Waende, der Boden, die Decke, Du siehst"
    " nichts als Stein. Ueberall liegen meterhohe Gesteinstruemmer herum..."));
    AddDetail(({"gesteinstruemmer","truemmer","gestein"}),
    "Die Steingiganten haben ganze Arbeit geleistet und die Hoehle zu einem "
    "einzigen steinernen Chaos gemacht.");
    AddDetail(({"kammer","schatzkammer"}),
    "Die Schatzkammer ist eigentlich nur ein kleiner Raum der etwas ueber dem "
    "Niveau der restlichen Hoehle liegt.");
    AddDetail(({"habseligkeiten","habseligkeit"}),
    "Was die Steingiganten eben gerade so finde, wird hier abgelegt.");
    AddDetail(("chaos"),
    "Truemmer, Truemmer und nochmals Truemmer...");
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );
AddDetail(("stein"),
"Du glaubst Granit zu erkennen.");
AddDetail(("granit"),
"Granit ist ein besonders hartes Gestein.");
  
  AddDetail( ("boden"),
  "Der Boden besteht aus blankem Granit und ist uebersaeht mit Kratzern.\n");
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus Stein und weisen viele seltsame Loecher auf.\n");
  AddDetail(("kratzer"),
  "Die Spuren am Boden scheinen von gewaltigen Werkzeugen herzuruehren.\n");
  AddDetail(({"loecher","loch"}),
  "Diese Loecher sehen wie riesengrosse Bisspuren aus. Von wem die wohl alle stammen?");
  AddDetail(({"bisspuren","spuren","spur","bisspur"}),
  "Hier beissen hungrige Steingiganten ab und zu einmal ab.\n");
  AddDetail(("decke"),
  "Die Decke besteht aus reinem Granit und ist sehr weit oben.");
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst wie tief im Inneren Stein zermalmt wird.");
    
  AddSmell( DEFAULT_SMELL,
    "Seltsam, aber hier riecht es steinig?.");

  AddRoomMessage( 
    ({"Die Steine scheinen sich zu bewegen.\n",
      "Du hoerst ein malmendes Gerausch.\n"
      "Die Erde scheint zu erbeben.\n",
      "Die Steine scheinen hier zu leben...\n",
      "Eine kleiner Stein faellt von der Decke herab.\n"}) );
 AddExit( "unten", "./stein11");
 AddItem(OBJ"fackel", REFRESH_REMOVE);
 AddItem(OBJ"dgo", REFRESH_REMOVE);
 AddItem(OBJ"dtop", REFRESH_REMOVE);
 
 (ob = clone_object("/obj/money.lpc")) ->SetProp(P_AMOUNT,random(3000));
 ob->move("/d/dschungel/dante/weg/room/stein24");
 
AddItem(OBJ"dananas", REFRESH_REMOVE);
 }
 
 
 
 