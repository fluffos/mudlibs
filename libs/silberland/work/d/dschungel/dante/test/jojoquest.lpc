
inherit "/std/thing";

#include <properties.h>
#include "files.h"



       int    antwHi;
       void   SetAntwHi();
       int    QueryAntwHi();
       void   RestoreAntwHi();


create()
{

  if(!is_clone(this_object())) return;  
  ::create();
  seteuid( getuid(this_object())); 
  SetProp(P_WEIGHT, 500);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Du willst doch wohl nicht den Schluesselbund wegwerfen?\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME, "Schluesselbund");
  SetProp(P_GENDER, MALE);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId( ({"\ngi_schlbund", "bund","jojoquest", "schluesselbund", "schluessel"}) );


}

void SetAntwHi()
{
  antwHi++;
    }

int QueryAntwHi()
{
  return antwHi;
  }
  
  void RestoreAntwHi()
  {
    antwHi=0;
      }
          

