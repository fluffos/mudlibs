//
//schlegel fuer glocke in kneipe fuer quest

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine Flasche Baldrian");
  SetProp(P_LONG,BS(
  "Diese Flasche gehoert dem Koffeinjunkie. Er braucht sie dringend!"));
  
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,500);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Flasche");
  SetProp(P_MATERIAL, ({MAT_GLASS}));
  
  AddId(({"flasche", "bald", "baldrian"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
//kein neverdrop usw da give_notify im npc!!

}

