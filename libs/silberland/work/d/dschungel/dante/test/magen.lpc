//magen des riesensteinmauls

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>



create()
{

  ::create();
  
  SetProp( P_INT_SHORT, "In Magen des Riesensteinmauls" );
SetProp(P_NO_QUIT, 1);

   SetProp(P_NO_TPORT, NO_TPORT_OUT);   
AddDetail("zeit",
"Tja, die laeuft Dir hier davon...");
AddDetail("bakterien",
"Die Bakterien haben Dich schon infiltriert und loesen Dich gerade von innen auf! "
"Viel Spass dabei!");
AddDetail(({"wand","waende"}),
"Die Waende sind hier Magenwaende.");
AddDetail(({"magenwand", "magenwaende"}),
"Die Magenwaende sind ueber und ueber mit Schleim bedeckt. Viele Druesen produzieren "
"immerfort Schleim, Saeure und Enzyme.");
AddDetail(({"enzyme","enzym"}),
"Die Enzyme hier sind besonders boesartig und zerlegen alles was hier runter kommt.");
AddDetail(({"druese","druesen"}),
"Die Druesen produzieren und produzieren. Es scheint ihnen Spass zu machen.");
AddDetail("spass",
"Was Du siehst macht keinen Spass. Die Waende sind ueberzogen mit boesen "
"Geschwueren! Eklig!");
AddDetail(({"geschwuer", "geschwuere"}),
"Die Geschwuere eitern und bluten schon.");
AddDetail("eiter",
"Eklig rinnt es herab...");
AddDetail("blut",
"Die Geschwuere meussen ziemlich weh tun. Vielleicht kann man da ja etwas "
"nachhelfen! Etwas sehr gemeines tun...");
SetProp(P_INT_LONG, BS(
   "Du Idiot hast das Riesensteinmaul trotz aller Warnungen angegriffen! "
   "Nun wirst Du hier langsam verdaut, und kannst nichts dagegen unternehmen! "
   "Ein schrecklicher, qualvoller Tod! Die Magensaeuere loest Dich langsam auf, "
   "die Bakterien zerfressen Dich und der Schleim huellt Dich langsam ein...\n"));


AddDetail("tod",
"Bald triffst Du ihn wieder!");
AddDetail("riesensteinmaul",
"Das Riesensteinmaul hat Dich einfach verschluckt!");
AddDetail("maul",
"Tja, reiss dein Maul lieber nicht so weit auf!");
AddDetail(({"warnungen", "warnung"}),
"Tja, wer nicht hoeren will muss fuehlen!");
AddDetail("decke",
  "Naja, hier gibts es keine richtige Decke. Ober Dir siehst Du eine gewaltige "
  "Roehre.");
  AddDetail("roehre",
  "Es handelt sich um die Speiseroehre.");
 AddSpecialDetail("speiseroehre", "wum");
  AddDetail("boden",
  "Der Boden ist ueberzogen mit Schleim und Saeure, die Dich beide "
  "langsam zersetzen...");
  AddDetail("schleim",
  "Der Schleim ueberzieht Dich mit einer dicken Schicht.");
  AddDetail("schicht",
  "Eklig...");
  AddDetail(({"saeure","magensaeure"}),
  "Die Saeure ist sehr aggressiv und zersetzt alles binnen Minuten!");
  AddDetail(({"minute", "minuten"}),
  "Tja, viel Zeit verbleibt Dir auch nicht mehr!");
  AddDetail("magen",
  "Da bist Du nun Du Narr!");
  AddSpecialDetail("narr","u");
   

AddCmd(({"tritt", "trete", "schlage", "schlag", "verletzte", "reisse", "reiss"}),"out");


  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:40]));      
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
   AddSmell( DEFAULT_SMELL,
   "Es riecht nach verfaulten Sachen allerlei Art\n");
     AddSound( DEFAULT_SOUND,
     "Manchmal hoert man ein lautes Glucksen und Knurren.\n");
                  
 }

 int out(string str)
 {
 notify_fail("Was willst Du hier tun?\n");
 if (!str) return 0;
     if(member(({"geschwuere", "magengeschwuere","geschwuer", "magengeschwuer",
     "geschwuer auf","geschwuere auf", "magengeschwuere auf", "magengeschwuer auf"}), str)!=-1)
     
         {
         remove_call_out("time");
         remove_call_out("time1");
          remove_call_out("time2");
        remove_call_out("time3");
        remove_call_out("time4");
        remove_call_out("time5");
        remove_call_out("time6");
        remove_call_out("time7");
        remove_call_out("time8");
        remove_call_out("time9"); 
         write("Du trittst brutal auf den Magengeschwueren herum und ploetzlich "
        "beginnt das Riesensteinmaul zu erbrechen! Du hast Glueck und wirst "
        "wieder hochgewuergt!!! Lass Dir das lieber eine Lehre sein!\n");
        TP->move("/d/dschungel/dante/stein/room/stein14.lpc", M_GO, 
        "vom Riesensreinmaul ausgekotzt", "wird vom Riesensteinmaul ausgekotzt");
        return 1;
         }
      return 0;
      }  
     



void init()
{
::init();
 if (query_once_interactive(this_player()))
 {
       
call_out("time", 0);   
   }
 }
 
   
  void time()
    { 
   write("Du hast noch 2 Minuten bis zur totalen Verdauung!\n");
   call_out("time1", 60);
   }
   
   void time1()
   {
    TP->do_damage(10);  
   write("Du hast noch 1 Minute bis zur totalen Verdauung!\n");
   
   call_out("time2",30);
   }
   
   void time2()
   {
    TP->do_damage(12);  
   write("Du hast noch 30 Sekunden bis zur totalen Verdauung!\n");
   call_out("time3",10);
   }
    

   void time3()
   {
    TP->do_damage(15);  
   write("Du hast noch 20 Sekunden bis zur totalen Verdauung!\n");
   call_out("time4",10);
   }
   

   void time4()
   {
    TP->do_damage(17);  
   write("Du hast noch 10 Sekunden bis zur totalen Verdauung!\n");
   call_out("time5",5);
   }
   
   
   void time5()
   {
    TP->do_damage(20);  
   write("Du hast noch 5 Sekunden bis zur totalen Verdauung!\n");
   call_out("time6",3);
   }
   
   void time6()
   {
   write("Du hast noch DREI SEKUNDEN bis zur totalen Verdauung!\n");
   call_out("time7",1);
   }
   
   void time7()
   {
   write("Du hast noch ZWEI SEKUNDEN bis zur totalen Verdauung!\n");
   call_out("time8",1);
   }
   
   void time8()
   {
   write("Du hast noch EINE SEKUNDE bis zur totalen Verdauung!\n");
   call_out("time9",1);
   }
   
   void time9()
   {
   
   write("Die Saeure hat Dich total zerfressen!\n"
   "Die Bakterien haben Dich zersetzt!\n"
   "Der Schleim hat Dich total ueberzogen!\n");
   TP->do_damage(500);
   SetProp(P_NOCORPSE, 1);
   SetProp(P_KILL_MSG, "Saeure, Schleim und Bakterien");
   
   }
   
   
string wum()
  {
     
       write("Du schaust nach oben und WUMMM!!!!\n"
       "Ein ekliger Batzen trifft Dich genau am Kopf!\n");
       TP->do_damage(20);
       SetProp(P_KILL_MSG, "Ein ekliger Brocken");
         say(""+TPN+" wird hart am Kopf getroffen!\n");
           return "";
             }
             
    
    string u()
      {
         
           write("Du, "+TPN+", bist gemeint damit!\n");
             say(""+TPN+" macht sich zum Idioten!\n");
               return "";

                 }         