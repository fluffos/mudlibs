//das hier regelt wieviele antirekse es geben darf
//finger weg davon ok:)

#include "files.h"
#define MAXANTI 6

int anti;

void create() {
  if(is_clone(ME)) {
    destruct(ME);
    return;
  }
  anti=0;
  return;
}

void create_anti() {
  anti++;
  return;
}

int allow_anti() {
  if(anti<MAXANTI) return 1;
  return 0;
}

void destruct_anti() {
  anti--;
  return;
}

int query_anti() {
  return anti;
}

reset() {}

