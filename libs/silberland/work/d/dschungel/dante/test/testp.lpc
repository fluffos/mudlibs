/*
** Steinpilz
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Parasol");
  SetProp (P_LONG, "Ein riesengrosser, herrlich duftender Parasol.\n");
  SetProp (P_NAME, "Parasol");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 50);
  SetProp(P_SIZE, 20);
  SetProp (P_NOBUY, 0);
  SetProp(P_INFO, ("Dieser Pilz stammt aus Dantes Pilzfarm. \n"));
  AddId (({"pilz","parasol"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 18, F_SOAK: 4, F_ALCOHOL: 0, F_POISON: -1]));
}

BeimEssen()
{
TP->SetProp(P_DEADS, 1000);
write ("Du isst den Parasol mit grossem Genuss.\n");
say (TPN+" verspeisst den Parasol mit grossem Genuss.\n");
return ::BeimEssen();
}
