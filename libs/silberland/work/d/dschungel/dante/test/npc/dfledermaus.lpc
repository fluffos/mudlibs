// fledermaus

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Fledermaus");
  SetProp(P_LONG, BS(
    "Die Fledermaus ist ein gefaehrlicher Blutsauger. Sei froh, dass Du ein kleines "
    "Exemplar vor Dir siehst..."));
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  AddId(("fledermaus"));
  set_living_name("fledermaus");
  
  create_default_npc(9);
  SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen",100,({DT_RIP,DT_POISON,DT_PIERCE}) }));
  SetProp(P_MAX_HP, 300);
  SetProp(P_MAX_SP, 300);
  SetProp(P_BODY, 100);
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 30);
  SetProp(P_RESISTANCE, ({ DT_WATER,DT_BLUDGEON })); 

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Fledermaus will Deine Sachen nicht.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(50, 150,
    "Die Fledermaus zerkratzt Dein Gesicht.\n",
    "Die Fledermaus zerkratzt @WESSEN Gesicht.\n");
  AddSpell(10,300,
    "Die Fledermaus schlaegt ihre spitzen Zaehne in Deinen Hals.\n",
    "Die Fledermaus schlaegt ihre spitzen Zaehne in @WESSEN Hals.\n");
  
  SetChats(5, ({
  "Die Fledermaus schwirrt um Dich herum.\n",
  "Die Fledermaus haengt von der Decke herab.\n",
  "Die Fledermaus stoesst schrille Laute aus.\n",
  "Die Fledermaus bleckt ihre spitzen Zaehne.\n",
  "Die Fledermaus faengt eine kleine Spinne.\n",
  "Die Fledermaus scheint Dich zu beobachten.\n",
  
  "Die Fledermaus flattert aufgeregt umher.\n"}) );
  
  SetAttackChats(10, ({
  "Die Fledermaus versucht sich in Dein Haar zu krallen.\n",
  "Die Fledermaus stoesst schrille Laute aus.\n",
  "Die Fledermaus will Dein Gesicht zerfetzten.\n",
  "Die Fledermaus stuerzt sich von oben auf Dich.\n"}) );

}

