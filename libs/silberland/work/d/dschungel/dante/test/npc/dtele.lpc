

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>

#include <moving.h>
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "C-ATOM");
  SetProp(P_LONG, (
    "Das C-Atom ist sehr schwer zu beschreiben, denn Du hast bisher nichts aehliches "
   "gesehen. Stell Dir einfach ein extrem ueberdimensioniertes C-8-ATOM vor."));                                                                                   
  SetProp(P_NAME, "C-ATOM");
  SetProp(P_GENDER, MALE);
  AddId( ({"c", "atom"}) );
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ", 350, DT_MAGIC}));
  SetProp(P_MAX_HP, 550+random(100));
  SetProp(P_BODY, 300+random(100));
  SetProp(P_XP, 19000*100);
  SetProp(P_SIZE, 100+random(20));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_WEIGHT, 1);
  AddInfo(DEFAULT_INFO, "Das C-Atom versteht Dich nicht.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Wie soll ein Atom das tragen ?\n"}));
  SetProp(P_DIE_MSG, " loest sich in Elementarteilchen auf.\n");
  SetProp(P_INFO, ("Das C-Atom ist ein lebendiges Wesen."));
  call_out("st1", 25);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOMAGIC, 30);
  SetProp(P_SPELLRATE, 30);
  AddSpell(50, 300, 
   "Das C-Atom dringt in Deine Zellen ein.\n",
    "Das C-Atom dringt in @WESSEN Zellen ein.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(50, 400, 
    "Das C-Atom bombardiert Dich mit Higgsteilchen.\n",
    "Das C-Atom bombardiert @WEN mit Higgsteilchen.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  AddSpell(50, 400,
    "Das C-Atom strahlt ionale Energie auf Dich ab.\n",
    "Das C-Atom strahlt ionale Energie auf @WEN ab.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  AddSpell(50, 400,
    "Das C-Atom schleudert Positronen nach Dir.\n",
    "Das C-Atom schleudert Positronen nach @WEM.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
 
  AddSpell(50, 400,
    "Das C-Atom huellt Dich in eine Wolke aus Quarks ein.\n",
    "Das C-Atom huellt @WEN in eine Wolke aus Quarks ein.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1])); 
 AddSpell(50, 400,
    "Das C-Atom huellt Dich in eine Wolke aus Quarks ein.\n",
    "Das C-Atom huellt @WEN in eine Wolke aus Quarks ein.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
 SetChats(4, ({
    "Das C-Atom schwirrt um Dich herum.\n",
    "Die Elektronen sausen herum.\n",
    "Die Orbitale werden kleiner und groesser.\n",
    "Das C-Atom scheint zu pulsieren.\n"}) );
 
  SUID;
  CLONEME(OBJ"dsma");
  CLONEME(OBJ"dsa");
  CLONEME(OBJ"dtop");
  CLONEME(OBJ"ddia");
  CLONEME(OBJ"dlap");
  CLONEME(OBJ"dame");
  }
  
 st1()
  {
   move("/d/dschungel/dante/weg/room/vorsprung", M_TPORT);
   call_out("st2", 25);
 }

 st2()
  {
   move("/d/dschungel/dante/weg/room/fels22", M_TPORT);
   call_out("st3",25);
 }
 st3()
 {
 move("/d/dschungel/dante/weg/room/planta3", M_TPORT);
 call_out("st1",25);
 }
 
 
 
