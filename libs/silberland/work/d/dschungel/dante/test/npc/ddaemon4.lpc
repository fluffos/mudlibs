

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Erdbebendaemon");
  SetProp(P_LONG, (
    "Der Erdbebendaemon hat einen staemmigen, aber sehr kraeftigen Koerper, "
    "mit dem er gewaltige Erdbeben ausloesen kann, mit denen er alles Leben "
    " zu vernichten versucht."));
  SetProp(P_NAME, "Erdbebendaemon");
  SetProp(P_GENDER, MALE);
  AddId( ({"erdbebendaemon", "daemon"}) );
  AddDetail(({"erdbeben"}),
  "Warte bis Du eines zu spueren bekommst...");
  AddDetail(({"koerper"}),
    "Der kraeftige Koerper ist geradezu praedestiniert um Erdbeben auszuloesen.\n");
    AddDetail(("leben"),
    "Alles Leben soll zerstoert werden von den Daemonen des Schrecken.\n");
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit einem Erdbeben", 150, DT_BLUDGEON}));
  SetProp(P_MAX_HP, 400+random(100));
  SetProp(P_BODY,100+random(100));
  SetProp(P_XP, 9000*100);
  SetProp(P_RACE, "daemon");
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, -900);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 30000);
  AddInfo(DEFAULT_INFO, "loest ein kleines Erdbeben aus.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Erdbebendaemon tritt Dich.\n"}));
  SetProp(P_DIE_MSG, " verschwindet wieder in die Dimension der Daemonen.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_BLUDGEON}));
  SetProp(P_NOMAGIC, 30);
  SetProp(P_SPELLRATE, 90);
  AddSpell(50, 300, 
   "Der Erdbebendaemon laesst die Erde unter Dir erbeben.\n",
    "Der Erdbebendaemon laesst die Erde unter @WEM erbeben\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(20, 500, 
    "Der Erdbebendaemon loest ein gewaltiges Erdbeben aus.\n",
    "Der Erdbebendaemon loest ein gewaltiges Erbeben aus.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(50, 400,
    "Der Erdbebendaemon schleudert Dich zu Boden.\n",
    "Der Erdbebendaemon schleudert @WEN zu Boden.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(50, 300,
    "Der Erdbebendaemon stampft wild auf die Erde.\n",
    "Der Erdbebendaemon stampft wild auf die Erde.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(10, 800,
  "Der Erdbebendaemon spricht den grossen Bebenzauber ueber Dir.\n",
  "Der Erdbebendaemon spricht den grossen Bebenzauber ueber @WEM.\n",
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

 SetChats(4, ({
    "Der Erdbebendaemon stampft mit dem Fuss auf den Boden.\n",
    "Der Erdbebendaemon laesst die Erde erzittern.\n",
    "Der Erdbebendaemon fragt: Sterblicher, was willst Du von uns ?\n",
    "Der Erdbebendaemon sagt: Die Erde muss beben!\n",
    "Der Erdbebendaemon loest ein kleines Erdbeben aus.\n",
    "Der Erdbebendaemon schlaegt mit der Faust auf den Boden.\n",
    "Der Erdbebendaemon tritt Dich.\n",
    "Der Erdbebendaemon fragt: Kleines Beben gefaellig ?\n",
    "Die Erde scheint zu erzittern.\n",
    "Der Boden unter Deinen Fuessen wackelt.\n"
    }));
 SetAttackChats(20, ({
    "Der Erdbebendaemon schreit: Erde erbebe!\n",
    "Der Erdbebendaemon schlaegt mit der Faust auf den Boden.\n",
    "Die Erde erbebt und schleudert Dich zu Boden!\n",
    "Der Erdbebendaemon schreit: Verschinde von hier!\n",
    "Du taumelst umher.\n",
    "Der Boden vibriert stark.\n",
    "Das Erdbeben wird immer schlimmer.\n"}));
 
 
 AddInfo(({"priester","kannibalenpriester"}),
    "fluestert: Der Kannibalenpriester ist unser Freund!\n");
 AddInfo("dante",
 "sagt: Dante, der alte Angsthase!\n");   
 AddInfo(({"kannibalen","kannibale"}),
    "sagt: Die Kannibalen sind auch nur dumme Sterbliche.\n");
 AddInfo("dschungel",
    "sagt: Den Dschungel mache ich den Erdboden gleich.\n");
 AddInfo("feyaria",
 "sagt: Sie hat grosse Angst vor Erdbeben.");   
 AddInfo("silberland",
 "sagt: Das Silberland verwuesten wir!");   
 AddInfo("erdbeben",
    "sagt: Ich liebe es, wenn die Erde erbebt.\n");
    AddInfo("pflanzen",
    "sagt: Die werden alle vernichtet!");
    AddInfo("tijara",
    "sagt: Wir bald nur mehr aus Truemmern bestehen.");
    AddInfo("tiere",
    "sagt: Krepieren sollen sie alle!");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler wird von seiner Huette erschlagen werden.\n");
 AddInfo("beben",
 "sagt: Gleich kommt eines...");
 AddInfo("natur",
 "lacht nur...");
 AddInfo("schrecken",
 "sagt: Schrecken verbreiten wir ueberall!");
 AddInfo("anfuehrer",
 "sagt: Er ist der maechtigste aller Schreckensdaemonen!");
 AddInfo("statue",
 "flucht: Die ist fuer die Ewigkeit gebaut!.");
 AddInfo("leben",
 "lacht ueber alles Leben.");
 AddInfo("tod",
 "sagt: Den Tod willst Du haben, kein Problem...");
                   
  }
