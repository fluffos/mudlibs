

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Harpie");
  SetProp(P_LONG, (
    "Die Harpie ist ein gewaltiger Vogel mit maechtigen Klauen. Sie hat die "
    "Gestalt eines Uhus, nur ist sie viel, viel gewaltiger. Ihr spitzer stein"
    "harter Schnabel hat so manchen Angreifer das Fuerchten gelehrt. An ihrem"
    "maechtigen Schaedel fallen Dir besonders die dunkeln, unheimlichen Augen"
    "auf.\n"));
  AddDetail(({"schaedel","augen"}),
    "Die Augen der Harpie blicken Dich durchdringend an und Du hast das un"
    "angenehme Gefuehl, dass in diesem Vogelkoerper mehr steckt...\n");                                                                                             
  SetProp(P_NAME, "Harpie");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"harpie", "harpie"}) );
  AddDetail( ({"klaue", "klauen"}),
    "So gigantische Klauen hast Du bei einem Vogel noch nie gesehen.");
  AddDetail(("schnabel"),
    "Der Schnabel der Harpie koennte Dir muehelos dem Arm abreissen.\n");
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit ihren furchtbaren Klauen", 260, DT_RIP,DT_MAGIC}));
  SetProp(P_MAX_HP, 500);
  SetProp(P_BODY,130);
  SetProp(P_XP, 8000*100);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 200000);
  AddInfo(DEFAULT_INFO, " schaut Dich nur wissend an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Harpie will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " stuerzt toedlich verwundet ab.\n");
  SetProp(P_KILL_MSG, ("Die Harpie zerfetzt Deinen Kadaver.\n")); 
  set_living_name("harpie");
  SetProp(P_INFO, ("Die Harpie ist ein magischer Vogel."));
  SetProp(P_HEAL,30);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_WHIP,DT_PIERCE,DT_WATER,DT_BLUDGEON,DT_FIRE,DT_RIP}));
  
  SetProp(P_NOMAGIC, 50);
  SetProp(P_SPELLRATE, 50);
  AddSpell(50, 300, 
    "Die Harpie greift Dich mit ihrem spitzen Schnabel an.\n",
    "Der Harpie greift @WEN mit seinem spitzen Schnabel an.\n");
                                                                   
  AddSpell(20, 400, 
    "Der Harpie zerfetzt Deinen Koerper.\n",
    "Der Harpie zerfetzt @WESSEN Koerper.\n");
  AddSpell(50, 400,
    "Die Harpie reisst Dier einen Arm ab.\n",
    "Die Harpie reisst @WEM einen Arm ab.\n");
  AddSpell(40, 200,
    "Die Harpie hackt ein Stueck Fleisch aus Deinem Arm.\n",
    "Die Harpie hackt ein Stueck Fleisch aus @WESSEN Arm.\n");
  AddSpell(10, 900,
    "Der boese Blick der Harpie trifft Dich.\n",
    "Der boese Blick der Harpie trifft @WEN.\n");
  AddSpell(20, 650,
    "Ein Blitz faehrt aus den Augen der Harpie auf Dich herab.\n",
    "Ein Blitz faehrt aus den Augen der Harpie auf @WENN herab.\n");
          
  
  SUID;                                                                                                                        
    CLONEME(OBJ "dfrucht");
    CLONEME(OBJ "dmedaillon");

 SetChats(6, ({
    "Die Harpie funkelt Dich mit ihren tiefgruendigen Augen an.\n",
    "Die Harpie fluestert etwas in einer fremdartigen Sprache,\n",
    "Die Harpie wendet ihren Kopf um 180 Grad\n",
    "Neben diesem gigantischen Vogel kommst Du Dir sehr mickrig vor.\n",
    "Die Harpie versucht Dir etwas mit zu teilen.\n",
    "Die Harpie versinkt in eine totenaehnliche Trance.\n",
    "Die Harpie fluestert 'Nelabinnak'...\n",
    "Die Harpie gurrt 'Oodoov'..\n",
    "Die Harpie wetzt ihre gewaltigen Klauen.\n",
    "Die Harpie reisst ihren maechtigen Schnabel auf.\n"}));
 SetAttackChats(20, ({
    "Die Harpie kreischt: Das war ein Fehler, du Unwissender\n",
    "Die Harpie versucht Dir den Schaedel zu knacken.\n",
    "Die Harpie stoesst von oben auf Dich herab.\n",
    "Du beginnst zu taummeln.\n",
    "Du stolperst und faellst hin.\n",
    "Fluechte Sterblicher, fluechte...\n"}));
 
 
 
 AddInfo("voodoo",
    "fluestert: Voodoo ist nicht nur eine Religion der Eingeborenen, "
    " sondern auch ein maechtiger Zauber....\n");
 AddInfo("kannibalen",
    "sagt: Das Dorf der Kannibalen ist in der Naehe von hier...\n");
 AddInfo("dschungel",
    "sagt: Der Dschungel steckt voller Gefahren....\n");
 AddInfo("kreuz",
    "kreischt: Das bekommst Du nur ueber meine Leiche!\n");
 AddInfo("pyramide",
    "sagt: Huete Dich vor der verfluchten Pyramide...\n");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler ist ein guter, hilfsbereiter Mensch.\n");               
  }


