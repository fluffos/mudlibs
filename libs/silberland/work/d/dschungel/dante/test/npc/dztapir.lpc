inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();
  AddId (({"tapir","Schabrackentapir"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Schabrackentapir");
  SetProp(P_SHORT, "Ein Schabrackentapir");
  SetProp(P_LONG, BS(
  "Der Schabrackentapir ist ein nilpferdgrosser Unpaarhufer, dessen bevorzugte Mahlzeit"
  " Wuermer und anderes Kleingetier sind. Er hat einen kurzen, kraeftigen Ruessel, eher"
  " staemmige Gliedmassen und eine sehr aufffaelige Zeichnung.\n"));
  AddDetail(({"ruessel","wuermer","kleingetier"}),
  "Mit seinem kraeftigen Ruessel durchwuehlt er dem Boden nach Nahrung.\n");
  AddDetail(("zeichnung"),
  "Das vordere Koerperdrittel und die Hinterbeine sind schwarz; der Rest des Koerpers"
  " grauweiss. Ein drolliges Tier, wenn es nicht nur so gross waere...\n");
  AddDetail(("mahlzeit"),
  "Keine Sorge, Du schmeckst ihm nicht!\n");
  SetProp(P_REJECT, ({REJECT_KEEP, "Der Schabrackentapir schleckt Dir mit seiner Zunge durchs Gesicht.\n"}));
  create_default_npc(15);
  SetProp(P_DIE_MSG, " verendet mit einem lauten Grunzen.\n");
  SetProp(P_WIMPY, 100);
  SetProp(P_MAX_HP, 400);
  SetProp(P_ALIGN, 100);
  SetProp (P_HANDS, ({" mit seinem wuchtigem Koerper an. ", 100, DT_BLUDGEON}) );
  SetChats (4, ({
   "Der Tapir sucht mit seinem Ruessel nach Ameisen.\n",
   "Eine Ameise kann gerade noch vor dem Tapir fluechten.\n",
   "Der Schabrackentapir untersucht Dich mit seinem Ruessel.\n",
   "Ein Wurm wird genussvoll vom Tapir eingesaugt.\n",
   "Der Tapir wuehlt im Boden nach Nahrung.\n",
   "Du bestaunst dieses seltsame Tier.\n",
   "Der Schabrackentapir gibt seltsame Grunzlaute von sich.\n",
   "Der Tapir schleckt Dir mit seiner langen Zunge ueber das Gesicht.\n",
   "Der Schabrackentapir stoebert einige Wuermer auf.\n"}) );
  
  SetProp(P_DEFAULT_INFO, " grunzt nur unverstaendlich.\n");

  SUID;
  CLONEME(OBJ "druessel");

}

