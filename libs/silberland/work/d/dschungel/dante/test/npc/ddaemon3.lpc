

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer Pestdaemon");
  SetProp(P_LONG, (
    "Der Pestdaemon ist eine grauenerregende Gestalt, ueber und ueber mit Pestbeulen "
    " bedeckt, der nur darauf wartet unschuldige Opfer mit dieser todbringenden "
    " Seuche zu quaelen"));
    
  SetProp(P_NAME, "Pestdaemon");
  SetProp(P_GENDER, MALE);
  AddId( ({"pestdaemon", "daemon"}) );
  AddDetail(({"beule","pestbeule"}),
  "Mit Grausen wendest Du Deinen Blick von den eitertriefenden Furunkeln wieder ab.");
  AddDetail(({"seuche"}),
    "Die Pest wird nicht umsonst der schwarze Tod genannt.\n");
    AddDetail(({"furunkel","furunkeln"}),
    "Der Koerper des Pestdaemonen ist uebersaeht damit.\n");
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit einer Flutwelle", 150, DT_POISON,DT_ACID}));
  SetProp(P_MAX_HP, 400+random(100));
  SetProp(P_BODY,100+random(100));
  SetProp(P_XP, 9000*100);
  SetProp(P_RACE, "daemon");
  SetProp(P_SIZE, 300+random(20));
  SetProp(P_ALIGN, -900);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 20000);
  AddInfo(DEFAULT_INFO, "lacht Dich nur aus.\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Der Pestdaemon sagt: Dort wo ich Dich hinschicke brauchst Du nichts mehr.\n"}));
  SetProp(P_DIE_MSG, " verschwindet wieder in die Dimension der Daemonen.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_POISON}));
 // SetProp(P_VULNERABILITY, ({DT_HOLY}) );
  SetProp(P_NOMAGIC, 50);
  SetProp(P_SPELLRATE, 90);
  AddSpell(50, 300, 
   "Der schwarze Pestdaemon wirft Pestbeulen nach Dir.\n",
    "Der schwarze Pestdaemon wirft Pestbeulen nach @WEM.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(20, 600, 
    "Der schwarze Pestdaemon versucht Dich mit der Pest zu infizieren.\n",
    "Der schwarze Pestdaemon versucht @WEN mit der Pest zu infizieren.\n",
     DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(50, 400,
    "Der schwarze Pestdaemon schleudert Viren nach Dir.\n",
    "Der schwarze Pestdaemon schleudert Viren nach @WEM.\n",
     DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(40, 300,
    "Der schwarze Pestdaemon hetzt eine Meute pestverseuchter Ratten auf Dich.\n",
    "Der schwarze Pestdaemon hetzt eine Meute pestverseuchter Ratten aud @WEN.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));
  

 SetChats(4, ({
    "Der schwarze Pestdaemon laesst eine Pestbeule platzen.\n",
    "Der schwarze Pestdaemon lacht ueber Dich.\n",
    "Der schwarze Pestdaemon fragt: Na, bisschen Pest gefaellig ?\n",
    "Der schwarze Pestdaemon stinkt erbaermlich.\n",
    "Der schwarze Pestdaemon wirft Eiter nach Dir.\n",
    "Du glaubst den Todeshauch der Pest zu spueren.\n",
    "Der schwarze Pestdaemon sagt: Verschwinde Du ekliger Gesunder.\n",
    "Der schwarze Pestdaemon sagt: Bald haben alle Kreaturen die Pest!\n",
    "Der schwarze Pestdaemon spuckt Dich an.\n",
    "Der schwarze Pestdaemon singt 'Oh du lieber Augustin, Augustin...'\n",
    "Der schwarze Pestdaemon fragt: Hey, kennst Du den schwarzen Tod ?\n",
    "Der schwarze Pestdaemon scheint innerlich zu verfaulen.\n"}));
 SetAttackChats(20, ({
    "Der schwarze Pestdaemon schreit: Dir schicke ich die pest auf den Hals!\n",
    "Der schwarze Pestdaemon bruellt: Dein Tod ist nahe!\n",
    "Einige Pestbeulen platzen auf!\n",
    "Der schwarze Pestdaemon sagt: Verschinde von hier!\n",
    "Du glaubst Dich infiziert zu haben.\n",
    "Der Todeshauch der Pest umweht Dich.\n",
     }));
 
 
 AddInfo(({"priester","kannibalenpriester"}),
    "fluestert: Der Kannibalenpriester ist unser Freund!\n");
 AddInfo("dante",
 "sagt: Dante, die alte Pestbeule!\n");   
 AddInfo(({"kannibalen","kannibale"}),
    "sagt: Die Kannibalen sind auch nur dumme Sterbliche.\n");
 AddInfo("dschungel",
    "sagt: Die Kreaturen des Dschungels rotte ich mit der Pest alle aus.\n");
 AddInfo("feyaria",
 "sagt: Der wuensche ich die Pest an den Hals.");   
 AddInfo("silberland",
 "sagt: Das Silberland ist bald ne einzige Pestgrube.");   
 AddInfo("pest",
    "sagt: Ich liebe die Pest.\n");
    AddInfo("pflanzen",
    "sagt: Die Pest kann denen leider nichts anhaben.");
    AddInfo("tijara",
    "lacht nur pestmaessig.");
    AddInfo("tiere",
    "sagt: Tja, bald siechen die alle dahin.");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler soll elendig an der Pest krepieren.\n");
 AddInfo("beulen",
 "sagt: Irre ich mich, oder sehe ich in Deinem Gesicht schon eine ?");
 AddInfo("natur",
 "lacht nur...");
 AddInfo("schrecken",
 "sagt: Schrecken verbreiten wir ueberall!");
 AddInfo("anfuehrer",
 "sagt: Er ist der maechtigste aller Schreckensdaemonen!");
 AddInfo("statue",
 "flucht: Sie stellt unseren Anfuehrer dar.");
 AddInfo("leben",
 "lacht ueber alles Leben.");
 AddInfo("tod",
 "sagt: Den schwarzen Tod willst Du haben, kein Problem...");
 AddInfo(({"pestbeule","pestbeulen","beule"}),
 "sagt: Schoen sehen die aus, oder?");                  
  }
