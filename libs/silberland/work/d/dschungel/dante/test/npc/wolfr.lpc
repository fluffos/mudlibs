inherit "/std/npc";
inherit "/std/player/moneyhandler";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <attributes.h>
#include <wizlevels.h>

int richtung;

create() {
  if (!is_clone(this_object())) return;
  npc::create();
  create_default_npc(12);
  AddId("bettler");
  SetProp(P_NAME,"Bettler");
  SetProp(P_SHORT,"Ein stummer Bettler");
  SetProp(P_LONG,
"Ein stummer Bettler. Er traegt einen Button mit der Aufschrift\n'Ich mag Wolpies!'\n");
  SetProp(P_GENDER,MALE);

  SetAttribute(A_DEX,14);
  SetAttribute(A_STR,15);
  SetProp(P_WIMPY,20);
  SetProp(P_NOMAGIC,10);
  SetProp(P_RESISTANCE,({DT_COLD}));

  SetProp(P_ALIGN,0);
  seteuid(getuid(this_object()));
  AddMoney(20+random(20));
  richtung=random(2);
}

TryMove() {
  object env;
  string fn;

  if (InFight()) return 1;
  if (!env=environment()) return 0;
  fn=file_name(env);
  if (fn[0..22]!="/d/ebene/room/PortVain/" &&
      fn[0..28]!="/d/ebene/kobayashi/wolp/room/") return 0;
  fn=fn[23..];
  switch(fn) {
  case "fischrestaurant":
	if ((QueryProp(P_MAX_HP)-QueryProp(P_HP))>20)
	  command("bestell scotch");
	if ((QueryProp(P_MAX_HP)-QueryProp(P_HP))>10)
	  command("bestell korn");
	if ((QueryProp(P_MAX_HP)-QueryProp(P_HP))>5)
	  command("bestell wein");
	if ((QueryProp(P_MAX_HP)-QueryProp(P_HP))>1)
	  command("bestell pils");
	richtung=1;
	command("norden");
	break;
  case "pova_la4":
	command(((string)(richtung?"osten":"sueden")));
	break;
  case "po_ma":
  case "po_haf0":
  case "po_haf1":
	command(((string)(richtung?"osten":"westen")));
	break;
  case "po_haf1a":
	command(((string)(richtung?"sueden":"westen")));
	break;
  case "pub2":
	if ((QueryProp(P_MAX_HP)-QueryProp(P_HP))>20)
	  command("bestell rachenputzer");
	if ((QueryProp(P_MAX_HP)-QueryProp(P_HP))>10)
	  command("bestell schnaps");
	if ((QueryProp(P_MAX_HP)-QueryProp(P_HP))>5)
	  command("bestell bier");
	richtung=0;
	command("norden");
	break;
  default:
	return 0;
  }
  return 1;
}

NextMove() {
  while (remove_call_out("NextMove")!=-1);
  if (TryMove())
	call_out("NextMove",10+random(10));
}

init() {
  npc::init();
  if (find_call_out("NextMove")==-1)
	call_out("NextMove",5);
  if (!QueryProp(P_ALCOHOL))
	SetProp(P_ALCOHOL,40+random(20));
  if (interactive(this_player())) return;
  if (
}
