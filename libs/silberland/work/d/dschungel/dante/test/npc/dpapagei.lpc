// 
// Ein Papagei
// 22-10-1996  Feyaria@SilberLand veraendert von dante97 jaenner

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "files.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grauer Papagei");
  SetProp(P_LONG, (
    "Dieser Papagei ist ein Graupapagei. Er ist unter allen Papageien der"
    "intelligenteste aber auch der fechste.\n"));
  SetProp(P_NAME, "Papagei");
  SetProp(P_NAME_ADJ, "grau");
  SetProp(P_GENDER, MALE);
  AddId( ({"papagei", "vogel"}) );
  AddAdjective( ({"grauen", "grauer", "grauem"}) );

  create_default_npc(9);
  SetProp(P_HANDS, ({" mit seinem harten Schnabel", 80, DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 50+random(10));
  SetProp(P_ALIGN, 250);
  SetProp(P_WIMPY, 80);

  SetProp(P_MSGIN, "flattert laut kraechzend herein");
  SetProp(P_MSGOUT, "flattert laut kraechzend");
  SetProp(P_MMSGIN, "flattert laut kraechzend herein");
  SetProp(P_MMSGOUT, "flattert laut kraechzend weit weg");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_m5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "kraechzt etwas unverstaendliches.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "kraechzt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Papagei will Deine Sachen nicht tragen.\n" }) );

  SetChats(5, ({
    "Der Graupapagei laermt mit seinem Schnabel.\n",
    "Der Papagei kraechzt laut.\n",
    "Der Graupapagei setz sich auf Deine Schulter.\n",
    "Der Papagei zwickt Dich in Dein Ohr.\n",
    "Der Papagei fliegt einen Kreis um Dich herum.\n",
    "Der Papagei kraechzt: Magier sind dumm und stinken.\n",
    "Der Graupapagei verlangt nach Futter.\n",
    "Der Graupapagei sagt : Nora...Nora...\n"}) );
    
    
    
    }
    
init()
{
  ::init();
  command("emote kraechzt: Hallo "+ TP->name(RAW) +" , Du Feigling!");
}

string y;

void catch_tell (string str)
{
  string x;
  int l;
  if (sscanf(str, "%s sagt: %s", x, y)==2)
  {
    if( (l=strlen(y)) >30 ) y = y[0..29];
    else y=y[0..l-2];
    call_out("sagen", 1+random(3), y);
  }
}

void sagen(string str)
{
  command ("emote kraechzt: Krah! .."+ str +".. Krah!..Du Idiot!");
}
