

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Flutwellendaemon");
  SetProp(P_LONG, (
    "Der Flutwellendaemon besteht aus einer undurchsichtigen graubraunen Masse, "
    "die zu fliessen scheint. Er ist ein boesartiger Geselle, nur darauf aus"
    " jegliches Leben mit seinen toedlichen Flutwellen hinweg zu schwemmmen."));
  SetProp(P_NAME, "Flutwellendaemon");
  SetProp(P_GENDER, MALE);
  AddId( ({"flutwellendaemon", "daemon"}) );
  AddDetail(({"welle","flutwelle"}),
  "Der Daemon ist in der Lage Flutwellen auf seine Gegner loszulassen.");
  AddDetail(({"masse"}),
    "Die eklige Masse scheint hin und herzu schwappen.\n");
    AddDetail(("geselle"),
    "Er gehoert zum Heer des namenlosen Anfuehrers,dem staerksten und schlimmsten aller Daemonen.\n");
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit einer Flutwelle", 150, DT_WATER}));
  SetProp(P_MAX_HP, 500+random(100));
  SetProp(P_BODY,100+random(100));
  SetProp(P_XP, 9000*100);
  SetProp(P_RACE, "daemon");
  SetProp(P_SIZE, 300+random(20));
  SetProp(P_ALIGN, -900);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 20000);
  AddInfo(DEFAULT_INFO, "lacht Dich nur aus.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Flutwellendaemon sagt: Behalte Deinen Kram, du Wurm.\n"}));
  SetProp(P_DIE_MSG, " verschwindet wieder in die Dimension der Daemonen.\n");
  SetProp(P_INFO, ("Der Flutwellendaemon hasst Feuer und Blitz."));
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_WATER}));
  SetProp(P_VULNERABILITY, ({DT_FIRE,DT_LIGHT}) );
  SetProp(P_NOMAGIC, 50);
  SetProp(P_SPELLRATE, 90);
  AddSpell(50, 300, 
   "Der Flutwellendaemon versucht Dich hinwegzuspuelen.\n",
    "Der Flutwellendaemon versucht @WEN hinwegzuspuelen.\n",
    DT_WATER, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(20, 400, 
    "Der Flutwellendaemon huellt Dich in toedliche Wassermassen.\n",
    "Der Flutwellendaemon huellt @WEN in toedliche Wassermassen.\n",
     DT_WATER, ([SP_SHOW_DAMAGE:1]));
  AddSpell(50, 400,
    "Der Flutwellendaemon versucht Dich zu ertraenken.\n",
    "Der Flutwellendaemon versucht @WEN zu ertraenken.\n",
     DT_WATER, ([SP_SHOW_DAMAGE:1]));
  AddSpell(20, 500,
    "Der Flutwellendaemon entfacht eine gigantische Flutwelle ueber Dir.\n",
    "Der Flutwellendaemon entfacht eine gigantische Flutwelle ueber @WEM.\n",
     DT_WATER, ([SP_SHOW_DAMAGE:1]));
  

 SetChats(4, ({
    "Der Flutwellendaemon fliesst nach oben...\n",
    "Der Flutwellendaemon fliesst nach unten...\n",
    "Der Flutwellendaemon fragt: Sterblicher, was willst Du von uns ?\n",
    "Der Flutwellendaemon fliesst durch Dich hindurch.\n",
    "Der Flutwellendaemon entfacht eine kleine Flutwelle.\n",
    "Der Flutwellendaemon speit Wasser nach Dir.\n",
    "Der Flutwellendaemon sagt: Bald flute ich das Silberland.\n",
    "Der Flutwellendaemon murmelt: Wassermassen moegen fliessen...\n",
    "Du bekommst eine kalte Dreckwasserdusche vom Flutwellendaemon.\n",
    "Aus dem Inneren des Flutwellendaemons hoert man lautes Rauschen.\n",
    "Die Masse des Flutwellendaemons schwabbt hin und her.\n"}));
 SetAttackChats(20, ({
    "Der Flutwellendaemon schreit: Wasser marsch!\n",
    "Der Flutwellendaemon schwillt immer mehr an.\n",
    "Der Flutwellendaemon bruellt: Ich ersaeuffe Dich, Du Wurm!\n",
    "Der Flutwellendaemon schreit: Verschinde von hier!\n",
    "Du bist voellig durchnaesst.\n",
    "Wasser, Wasser, ueberall nur Wasser...\n",
    "Eine Flutwelle rast auf Dich zu...\n"}));
 
 
 AddInfo(({"priester","kannibalenpriester"}),
    "fluestert: Der Kannibalenpriester ist unser Freund!\n");
 AddInfo("dante",
 "sagt: Dante, der alte Nichtschwimmer!\n");   
 AddInfo(({"kannibalen","kannibale"}),
    "sagt: Die Kannibalen sind auch nur dumme Sterbliche.\n");
 AddInfo("dschungel",
    "sagt: Den Dschungel setze ich bald unter Wasser.\n");
 AddInfo("feyaria",
 "sagt: Sie trinkt lieber Bier als Wasser.");   
 AddInfo("silberland",
 "sagt: Das Silberland heisst bald Totesmeer.");   
 AddInfo("wasser",
    "sagt: Wasser kann sehr zerstoerend sein.\n");
    AddInfo("pflanzen",
    "sagt: Die ertraenke ich alle!");
    AddInfo("tijara",
    "sagt: Bald taufen wir es Atlantis...");
    AddInfo("tiere",
    "sagt: Sollen alle absaufen...");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler gehoert ertraenkt.\n");
 AddInfo("flutwellen",
 "sagt: Gleich kommt eine...");
 AddInfo("natur",
 "lacht nur...");
 AddInfo("schrecken",
 "sagt: Schrecken verbreiten wir ueberall!");
 AddInfo("anfuehrer",
 "sagt: Er ist der maechtigste aller Schreckensdaemonen!");
 AddInfo("statue",
 "flucht: Sie zeigt unseren maechtigen Anfuehrer.");
 AddInfo("leben",
 "lacht ueber alles Leben.");
 AddInfo("tod",
 "sagt: Den Tod willst Du haben, kein Problem...");
                   
  }
