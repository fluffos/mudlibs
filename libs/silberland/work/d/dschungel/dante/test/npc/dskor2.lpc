// skorpionchen

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Riesenskorpion");
  SetProp(P_LONG, BS(
    "Dieser Skorpion misst von Kopf bis Schwanz an die 2 Meter. Sein gewaltiger "
    "Stachel ragt gefaehrlich drohend ueber Dir in die Hoehe."));
  SetProp(P_NAME, "Riesenskorpion");
  SetProp(P_GENDER, MALE);
  AddId(({"skorpion", "riesenskorpion"}));
  set_living_name("riesenskorpion");
  
  AddDetail(({"stachel","giftstachel"}),
  "Der Giftstachel kann Dir sicher grosse Schmerzen bereiten...\n");
  AddDetail(({"kopf","schwanz"}),
  "Vor Dir siehst du ein wahrhaft gewaltiges Tier!\n");
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit seinem Giftstachel",150,({DT_RIP,DT_POISON,DT_PIERCE}) }));
  SetProp(P_MAX_HP, 500);
  SetProp(P_MAX_SP, 500);
  SetProp(P_BODY, 100);
  SetProp(P_SIZE, 150);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_WATER,DT_BLUDGEON })); 
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kracht zu tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Riesenskorpion");
  SetProp(P_KILL_MSG, "Ich warte auf Dich!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Riesenskorpion will Deine Sachen nicht.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(50, 250,
    "Der Riesenskorpion bohrt seinen Gifststachel in Dich.\n",
    "Der Riesenskorpion bohrt seinen Giftstachel in @WEN.\n",
  DT_POISON, ([SP_SHOW_DAMAGE:1]));  
    
  AddSpell(10,500,
    "Der Riesenskorpion spiesst Dich auf.\n",
    "Der Riesenskorpion spiesst @WEN auf.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
    
  
  SetChats(5, ({
  "Der Skorpion krabbelt naeher an Dich heran.\n",
  "Der Giftstachel sieht wircklich beaengstigend aus.\n",
  "Der Riesenskorpion beobachtet Dich genau.\n",
  "Ploetzlich schnellt der Skorpion vor...\n",
  "Der Riesenskorpion zerquetscht eine Ratte.\n",
  "Der Riesenskorpion droht mit seinem Giftstachel.\n",
  "Der Riesenskorpion schabt am Boden.\n"}) );
  
  SetAttackChats(10, ({
  "Der Riesenskorpion versucht Dich zu stechen.\n",
  "Der Riesenskorpion will Dich zerquetschen.\n",
  "Der Riesenskorpion drueckt Dich gegen die Wand.\n",
  "Der Riesenskorpion kratzt Dich am Bein.\n"}) );

  SUID;
  CLONEME(OBJ"dgo");
  CLONEME(OBJ"dop");
  CLONEME(WEAPON "dgiftst" );
  command("zuecke waffe");
}

