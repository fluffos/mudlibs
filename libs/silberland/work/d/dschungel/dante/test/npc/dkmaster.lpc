// /d/dschungel/feyaria/tijara/npc/garde_master.c   
// Master fuer die Gardisten in Tijara
// 31-10-1996  Feyaria@SilberLand

object *gardisten;

create()
{
  if (is_clone(this_object())) return 0;
  gardisten = ({});
}

add_gardist()
{
  gardisten += ({ previous_object() });
}

ruf_um_hilfe(object spieler)
{
  int u;
  object *w;
  w=gardisten;
  for (u=sizeof(w)-1;u>=0;u--)
    if (catch(w[u]->InsertEnemy(spieler)))
      gardisten -= ({ w[u] });
}

remove_gardist()
{
  gardisten -= ({ previous_object() });
}
    
