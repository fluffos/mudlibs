/* eine mumie fuer die pyramide von dante fuer sl/dschungel jaenner 97*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include <class.h>
#include <mnpc.h>
 
create()
{
object cash;
 if (!is_clone(this_object())) return;
 :: create();
 
 SetProp(P_SHORT, "Eine Mumie");
 SetProp(P_LONG, bs(
    "Eine uralte, finster dreinblickende Mumie. In ihren dunklen Augenhoehlen"
    " schlaengeln sich kleine schwarze Schlangen, die Dich boese anzischen!"
    " Um den eingefallenen Hals traegt die Mumie einen seltsam aussehenden "
    "Ring, den Grabraeuber vergangener Tage scheinbar uebersehen haben!\n"));
 
 AddDetail(({"schlangen","augenhoehlen"}),
      ("Die schwarzen, sicherlich giftigen Schlangen sind zwar sehr klein, aber"
       " dafuer um so aggresiver. Von ihnen gebissen zu werden, koennte schlimme"
 
       " Folgen fuer Dich haben!\n"));
 AddDetail(({"hals","ring"}),
    ("Der Ring strahlt Dich merkwuerdig fahl an, fast wie Elfenbein,"
     "doch manchmal glaubst Du einen roetlichen Schimmer zu erkennen.\n"));
 AddDetail(({"raeuber","grabraeuber","tage"}),
    ("Sei froh, dass keine Grabraeuber in der Naehe sind. Obwohl du ja eben erst"
     " ein merkwuerdiges Geraeusch aus dem Nebenraum gehoert hast...\n"));
 
 SetProp(P_LEVEL, 14);
 SetProp(P_GENDER, FEMALE);
 SetProp(P_KILL_MSG, ("Was hast Du auch hier verloren!\n"));
 SetProp(P_SPELLRATE,50);
 create_default_npc( 14 );
  
 SetProp(P_DIE_MSG,  " zerfaellt zu Staub, doch die Schlangen...\n");    
 
 
 
 SetProp(P_NAME, "Mumie");
 set_living_name("mumie");
 AddId("mumie");
 
 SetProp(P_RACE, "Untot");
 SetProp(P_ALIGN, -300);
 SetProp(P_HANDS, ({" mit ihren verfaulten Stuempfen.", 140,DT_POISON,DT_BLUDGEON}));
 SetProp(P_SIZE, 180);
 SetProp(P_WEIGHT, 20000);
 SetProp(P_XP, 400000);
 SetProp(P_BODY, 150);
 SetProp(P_RESISTANCE, ({DT_COLD, DT_POISON}));
 SetProp(P_MAX_HP, 400);
 SetProp(P_MAX_SP, 500);
 SetProp(P_DEFAULT_INFO,"fluestert: Verschwinde solange Du noch kannst!\n");
 
 
 
 SetProp(P_MAX_HANDS, 2);
 
 
 AddInfo("dante",
         "fluestert: Er hat mich erschaffen!\n");
 SUID;
 cash=CLONEOB("/obj/money");
 cash->SetProp(P_AMOUNT, random(500));
 cash->move(ME);        
  CLONEME( ARMOUR "dring");
 
 
 SetProp(P_REJECT, ({REJECT_DROP, "Die Mumie sagt: Was soll ich mit dem Muell?\n" }));
 
 
      
 AddSpell(40,200,
         " Die Mumie bohrt Dir einen Finger ins Auge.\n"
         " Die Mumie bohrt @WEM einen Finger ins Auge.\n");
 AddSpell(20,400,
         " Die Mumie greift Dich mit der Kraft der Ewigkeit an.\n"
         " Die Mumie greift @WEN mit der Kraft der Ewigkeit an.\n");        
 AddSpell(60,100,
         " Die Schlangen beissen Dich in den Arm.\n"
         " Die Schlangen beissen @WEN in den Arm.\n");
 AddSpell(60,100,
         " Die Schlangen spucken Dir Gift in die Augen.\n"
         " Die Schlangen spucken @WEM Gift in die Augen.\n");
 AddSpell(70,100,
         "Die Schlangen zerfetzen Dein Gesicht\n"
         "Die Schlangen zerfetzen @WESSEN Gesicht\n");
 AddSpell(50,80,
         "Eine Schlange kriecht in Deine Hose\n"
         "Eine Schlange kriecht in @WESSEN Hose.\n");        
 }                     


die(arg)
 {
int i;
  for(i=0; i<random(4)+1;i++)
    clone_object(NPC "dschlange")->move(MENV, M_NOCHECK|M_SILENT);
  ::die(arg);
}
