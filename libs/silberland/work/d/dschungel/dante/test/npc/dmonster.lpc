// maerz 97 sl dante
//99 erweitert

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Monsternekrophile");
  SetProp(P_LONG, BS(
    "Der Monsternekrophile ist eine ekelerregende, widerliche Gestalt. Schleim und "
    "Sabber laeuft ihm aus seinem Maul. Seine Krallen sind nur dafuer da, "
    "um sich an toten Abenteurern zu vergreifen, und nichts bereitet ihm mehr Spass, als junge, suesse Hobbitbraeute zu schaenden."));
  SetProp(P_NAME, "Monsternekrophile");
  AddDetail(({"kralle","krallen"}),
  "Mit den scharfen Krallen vergreift er sich an Deinem Unterleib.");
  AddDetail(("schleim"),
  "Gruener Schleim tropft aus seinem Maul...");
  AddDetail(("maul"),
  "Grosse spitze Zaehne blinken Dich an.");
  AddDetail(({"zahn","zaehne"}),
  "Mit diesen Zaehnen wuehlt er dann in den Eingeweiden seiner Opfer.");
  AddDetail(("gestalt"),
  "Voller Warzen, Schleim und Sabber uebberragt er Dich bei weitem.");
  AddDetail(("sabber"),
  "WAEH!!! Der Monsternekrophile ist wircklich eine grausliche Gestalt.");
  AddDetail(({"warze","warzen"}),
  "Sein ganzer Koerper ist ueber und ueber mit Warzen bedeckt.");
  AddDetail(("koerper"),
  "Wenn er nicht ab und zu eine Leiche schaendet, verfaellt sein Koerper.");
  SetProp(P_GENDER, MALE);
  AddId(({"monsternekrophile","monster","nekrophiler"}));
SetProp(P_INFO, "Der Monsternekrophile hat Angst selbst geschaendet zu werden!\n");
  create_default_npc(20+random(5));
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen Nekrophilenkrallen", 250+random(100) ,DT_RIP,DT_PIERCE}));
  SetProp(P_MAX_HP, 500+random(200));
  SetProp(P_BODY, 150+random(50));
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, 10+random(10));
  SetProp(P_MSGIN, "schleicht lauernd herein");
  
  SetProp(P_MSGOUT, "schleicht lauernd");
  SetProp(P_MMSGIN, "schleicht lauernd herein");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

/*  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/test/room/hoehle4"));
 SetProp(P_MNPC_DEFAULTROOM, ROOM "hoehle4");
 SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_OUTDOORS+ MOV_INDOORS + MOV_BACKWARDS);
 SetProp(P_MNPC_WAIT, ({10, 10, 10}));
 */
  
  SetProp(P_DIE_MSG,  " beedet seine abscheulichen Taten fuer immer.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "Dich schaende ich auch noch!!!\n");
  AddInfo("dante", "Dante liebt das Schaenden.","sagt: ");
  AddInfo("leichen", "Ich liebe Leichen.", "sagt: ");
   AddInfo("sex", "NUR mit Toten.", "sagt: ");
 AddInfo("tod", "Der Tod bringt mir viel Spass.", "sagt: ");
 AddInfo("nekrophilie", "Nekrophil, na und ?", "sagt: ");
  AddInfo("nekrophil", "Bist Du etwa...?", "sagt: ");
   AddInfo("pervers", "Pervers, hmm kenne ich nicht", "lacht: ");
   AddInfo("leiche", "Ich liebe Leichen.", "sagt: ");
  


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ich will Deine Leiche!!!\n" }) );

  SetProp(P_SPELLRATE,75+random(24));
  
  AddSpell(5,200,
    "Der Monsternekrophile spuckt Schleim auf Dich.\n",
    "Der Monsternekrophile spuckt Schleim auf @WEN.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));

 AddSpell(1,600+random(200),
    "Der Monsternekrophile schaendet Dich.\n",
    "Der Monsternekrophile schaendet @WEN.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Der Monsternekrophile versucht Dich zu vergewaltigen.\n",
    "Der Monsternekrophile versucht @WEN zu vergewaltigen.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
     
      AddSpell(5,200,
    "Der Monsternekrophile zerfetzt Deinen Unterleib.\n",
    "Der Monsternekrophile zerfetzt @WESSEN Unterleib.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
      AddSpell(2,500,
    "Der Monsternekrophile infiziert Dich mit Syphilis.\n",
    "Der Monsternekrophile infiziert @WEN mit Syphilis.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
      AddSpell(2,500,
    "Der Monsternekrophile schreit: PROGRESSIVE PARALYSE.\n",
    "Der Monsternekrophile schreit PROGRESSIVE PARALYSE.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  SetChats(3, ({
  "Der Nekrophile sagt: Wehe Du schaendest mich!\n",
  "Der Monsternekrophile sabbert Dich an.\n",
  "Der Monsternekrophile betascht Deinen Po.\n",
  "Der Monsternekrophile sagt: Ich werde Dich schaenden.\n",
  "Der Monsternekrophile schleimt...\n",
  "Der Monsternekrophile steigt Dich an.\n",
  "Der Monsternekrophile ist furchtbar geil auf Dich.\n",
  "Der Monsternekrophile schaut Dich gierig an.\n",
  "Der Monsternekrophile sagt: Ich will Dich!\n"}) );
  SetAttackChats(10, ({
  "Der Monsternekrophile bruellt: ICH SCHAENDE DICH!!!",
  "Der Monsternekrophile greift Dir an den Unterleib.",
  "Der Monsternekrophile wird immer geiler.\n"}) );


SP(P_NOATTACK, 0);

}


 int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
if (!IsEnemy(enemy))
{

TP->AddPursuer(dmonster.c);
say(""+TPN+" wird nun vom Monsternekrophilen bis in den Tod verfolgt.\n");
 SetProp(P_MNPC_AREA, ("/d/dschungel/dante/zinsel/room/i"));
}
::Defend(int dam);
}

 

