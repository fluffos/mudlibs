/* eine mumie fuer die pyramide von dante fuer sl/dschungel jaenner 97*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <class.h>
#include <mnpc.h>
 
create()
{
object cash;
 if (!is_clone(this_object())) return;
 :: create();
 
 SetProp(P_SHORT, "Eine Mumie");
 SetProp(P_LONG, (
    "Eine uralte, finster dreinblickende Mumie. In ihren dunklen Augenhoehlen"
    " schlaengeln sich kleine schwarze Schlangen, die Dich boese anzischen!"));
   
    
 
 AddDetail(({"schlangen","augenhoehlen"}),
    bs("Die schwarzen, sicherlich giftigen Schlangen sind zwar sehr klein, aber"
       " dafuer um so aggressiver. Von ihnen gebissen zu werden, koennte schlimme"
 
       " Folgen fuer Dich haben!\n"));
 
  
     
 
  
     
 
 SetProp(P_LEVEL, 14);
 SetProp(P_GENDER, FEMALE);
 SetProp(P_KILL_MSG, ("Was hast Du auch hier verloren!\n"));
 SetProp(P_SPELLRATE,40);
 create_default_npc( 10 );
  
 SetProp(P_DIE_MSG,  " zerfaellt zu Staub, die Schlangen verkriechen sich.\n");    
 
 
 
 SetProp(P_NAME, "Mumie");
 set_living_name("mumie");
 AddId("mumie");
 SetProp(P_HEAL, -5);
 SetProp(P_RACE, "mumie");
 SetProp(P_ALIGN, -300);
 SetProp(P_HANDS, ({" mit ihren verfaulten Stuempfen.", 120,DT_BLUDGEON}));
 SetProp(P_SIZE, 180);
 SetProp(P_WEIGHT, 20000);
 SetProp(P_XP, 300000);
 SetProp(P_BODY, 130);
 SetProp(P_RESISTANCE, ({DT_COLD, DT_POISON}));
 SetProp(P_MAX_HP, 300);
 SetProp(P_MAX_SP, 800);
 SetProp(P_DEFAULT_INFO,"fluestert: Verschwinde solange Du noch kannst!\n");
 
 
 
 SetProp(P_MAX_HANDS, 2);
 
 
 AddInfo("dante",
         "fluestert: Er hat mich erschaffen!\n");
 SUID;
 cash=CLONEOB("/obj/money");
 cash->SetProp(P_AMOUNT, random(300));
 cash->move(ME);        
 
 
 
 SetProp(P_REJECT, ({REJECT_DROP, "Die Mumie sagt: Was soll ich mit dem Muell?\n" }));
 
 
      
 AddSpell(40,200,
         " Die Mumie bohrt Dir einen Finger ins Auge.\n"
         " Die Mumie bohrt @WEM einen Finger ins Auge.\n");
 AddSpell(20,400,
         " Die Mumie greift Dich mit der Kraft der Ewigkeit an.\n"
         " Die Mumie greift @WEN mit der Kraft der Ewigkeit an.\n");        
 AddSpell(70,100,
         " Die Mumie reisst Dir die Bauchdecke auf.\n"
         " Die Mumie reisst @WEM die Bauchdecke auf.\n");
 AddSpell(70,100,
         " Die Mumie zerquetscht Dich an der Wand.\n"
         " Die Mumie zerquetscht @WEN an der Wand.\n");
                      
    }                   