// ein kleiner guter ekliger schleimiger frosch by dante97 jaenner
// basierend auf feys quak
// 
// 

inherit "std/npc";
inherit "std/npc/sequencer";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "files.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Frosch");
  SetProp(P_LONG, "Der Frosch hat eine schlichte gruene Faerbung. Ueberhaupt kann "
  
    " man an diesem Tier ueberhaupt nichts Interessantes entdecken und so beachtest"
    " Du ihn nicht naeher.\n");
     
    
  AddDetail(({"Interressantes","faerbung","tier"}),
    ("Dieser Frosch ist einfach gruen, nur gruen.\n")); 
     
  SetProp(P_NAME, "Frosch");
  SetProp(P_GENDER, MALE);
  AddId ("frosch");
  SetProp(P_INFO, ("Dieser Frosch ist eine Delikatesse!\n"));
  SetProp(P_DIE_MSG, "huepft ein allerletztes Mal.\n");
  
  create_default_npc (4);
  SetProp(P_HANDS, ({" mit seiner roten Zunge", 30, DT_WHIP}));
  SetProp(P_BODY, 40);
  SetProp(P_XP, 200*100);
  SetProp(P_RACE, "Frosch");
  SetProp(P_SIZE, 16);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft weiter.");
  SetProp(P_MMSGIN, "springt herein.");
  SetProp(P_MMSGOUT, "springt weit fort.");
  AddInfo(DEFAULT_INFO, (" Der Frosch quakt nur und springt vergnuegt herum.\n"));
  SetProp(P_HEAL, -12);
  AddInfo("dante",
          "quakt: Ich kann viel besser quaken als her...\n"); 
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Frosch springt quackend ueber Deine Sachen hinweg.\n"}));
  
  
}
