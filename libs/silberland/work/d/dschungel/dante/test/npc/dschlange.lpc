/* schlange von dante fuer mumie und pyramide*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "files.h"

create()
{
if (!is_clone(this_object())) return;
:: create();

SetProp(P_NAME, "Schlange");
SetProp(P_GENDER, FEMALE);
SetProp(P_SHORT, "Eine Schlange");
SetProp(P_LEVEL, 10);
SetProp(P_HEAL, -3);
SetProp(P_SIZE, 100);
SetProp(P_WEIGHT, 9000);
SetProp(P_ALIGN, -100);
SetProp(P_AGGRESSIVE, 1);
SetProp(P_XP, 70000);
SetProp(P_BODY, 50);
SetProp(P_MAX_HANDS, 2);
SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen an.", 40,DT_POISON}));
create_default_npc ( 9 );
AddId("schlange");
SetProp(P_DIE_MSG, " windet sich noch einmal am Boden und verendet dann lautlos.\n");
set_living_name ("schlange");
SetProp(P_MAX_HP,  200);
SetProp(P_MAX_SP, 1000);
SetProp(P_REJECT, ({ REJECT_KEEP, "Die Schlange zischt dich nur an.\n"}) );

SetAttackChats(20, ({
    "Die Schlange beisst Dir in die Beine.\n",
    "Die Schlange zerfetzt Deine Hand.\n",
    "Die ScHlange verbeisst sich in Deinem Hals.\n",
    "Die Schlange springt Dir an die Kehle.\n"}));
SetChats(5, ({
    "Die Schlange richtet sich auf und pfaucht Dich an.\n",
    "Die Schlange kriecht naeher an Dich heran.\n",
    "Die Schlange versucht Dich zu attackieren.\n",
    "OH!!! Fast waerst Du auf die Schlange getreten!\n",
    "Du weichst der Schlange behende aus.\n",
    "Die Schlange schlaengelt um Dich herum.\n"}) );

SetProp(P_SPELLRATE, 50);
           
AddSpell(40,50,
    "Die Schlange schlaegt ihre Zaehne in Deine Hand.\n",
    "Die Schlange schlaegt ihre Zaehne in @WESSEN Hand.\n"); 
AddSpell(10,100,
    "Die Schlange spuckt Dir Gift in die Augen.\n",
    "Die Schlange spuckt @WEM Gift in die Augen.\n");
    
SetProp(P_LONG, ("Diese Schlange mag zwar nicht so gross sein wie andere, aber "
                 "dafuer ist sie um so schneller und boesartiger. Sie wartet "
                 "nur auf einen leichtsinnigen Abenteurer wie Dich, um ihre hoch"
                 "giftigen Zaehne in sein Fleisch zu bohren.\n"));
   AddDetail(({"zaehne","fleisch"}),
            ("Die spitzen, nadelfoermigen Giftzaehne bereiten sicherlich furcht"
             "bare Schmerzen. Du solltest besser vorsichtig sein!\n"));
     }                          