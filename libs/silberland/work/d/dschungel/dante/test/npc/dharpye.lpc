

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Harpye");
  SetProp(P_LONG, (
    "Die Harpye ist ein gewaltiger Vogel mit maechtigen Klauen. Sie hat die "
    "Gestalt eines Uhus, nur ist sie viel, viel gewaltiger. Ihr spitzer stein"
    "harter Schnabel hat so manchen Angreifer das Fuerchten gelehrt. An ihrem"
    " maechtigen Schaedel fallen Dir besonders die dunkeln, unheimlichen Augen"
    " auf.\n"));
  AddDetail(({"schaedel","augen"}),
    "Die Augen der Harpye blicken Dich durchdringend an und Du hast das un"
    "angenehme Gefuehl, dass in diesem Vogelkoerper mehr steckt...\n");                                                                                             
  SetProp(P_NAME, "Harpye");
  SetProp(P_GENDER, FEMALE);
  AddId( ("harpye") );
  AddDetail( ({"klaue", "klauen"}),
    "So gigantische Klauen hast Du bei einem Vogel noch nie gesehen.");
  AddDetail(("schnabel"),
    "Der Schnabel der Harpye koennte Dir muehelos den Arm abreissen.\n");
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit ihren furchtbaren Klauen", 260, DT_RIP,DT_MAGIC}));
  SetProp(P_MAX_HP, 500);
  SetProp(P_BODY,200);
  SetProp(P_XP, 8000*100);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 200000);
  AddInfo(DEFAULT_INFO, " schaut Dich nur wissend an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Harpye will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " stuerzt toedlich verwundet ab.\n");
  SetProp(P_KILL_MSG, ("Die Harpye zerfetzt Deinen Kadaver.\n")); 
  set_living_name("harpye");
  SetProp(P_INFO, ("Die Harpye ist ein magischer Vogel."));
  SetProp(P_HEAL,30);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_WHIP,DT_PIERCE,DT_WATER,DT_BLUDGEON,DT_FIRE,DT_RIP}));
  
  SetProp(P_NOMAGIC, 50);
  SetProp(P_SPELLRATE, 50);
  AddSpell(50, 300, 
    "Die Harpye greift Dich mit ihrem spitzen Schnabel an.\n",
    "Der Harpye greift @WEN mit seinem spitzen Schnabel an.\n");
                                                                   
  AddSpell(20, 400, 
    "Der Harpye zerfetzt Deinen Koerper.\n",
    "Der Harpye zerfetzt @WESSEN Koerper.\n");
  AddSpell(50, 400,
    "Die Harpye reisst Dir einen Arm ab.\n",
    "Die Harpye reisst @WEM einen Arm ab.\n");
  AddSpell(40, 200,
    "Die Harpye hackt ein Stueck Fleisch aus Deinem Arm.\n",
    "Die Harpye hackt ein Stueck Fleisch aus @WESSEN Arm.\n");
  AddSpell(10, 900,
    "Der boese Blick der Harpye trifft Dich.\n",
    "Der boese Blick der Harpye trifft @WEN.\n");
  AddSpell(20, 650,
    "Ein Blitz faehrt aus den Augen der Harpye auf Dich herab.\n",
    "Ein Blitz faehrt aus den Augen der Harpye auf @WENN herab.\n");
          
  
  SUID;                                                                                                                        
    CLONEME(OBJ "dfrucht");
    CLONEME(ARMOUR "dmedaillon");

 SetChats(4, ({
    "Die Harpye funkelt Dich mit ihren tiefgruendigen Augen an.\n",
    "Die Harpye fluestert etwas in einer fremdartigen Sprache.\n",
    "Die Harpye wendet ihren Kopf um 180 Grad.\n",
    "Neben diesem gigantischen Vogel kommst Du Dir sehr mickrig vor.\n",
    "Die Harpye versucht Dir etwas mit zu teilen.\n",
    "Die Harpye versinkt in eine totenaehnliche Trance.\n",
    "Die Harpye fluestert 'Nelabinnak'...\n",
    "Die Harpye gurrt 'Huete Dich vor dem Boesen'\n",
    "Die Harpye wetzt ihre gewaltigen Klauen.\n",
    "Die Harpye reisst ihren maechtigen Schnabel auf.\n"}));
 SetAttackChats(20, ({
    "Die Harpye kreischt: Das war ein Fehler, du Unwissender.\n",
    "Die Harpye versucht Dir den Schaedel zu knacken.\n",
    "Die Harpye stoesst von oben auf Dich herab.\n",
    "Die Harpye will Dich zerreissen.\n",
    "Du beginnst zu taummeln.\n",
    "Du stolperst und faellst hin.\n",
    "Fluechte Sterblicher, fluechte...\n"}));
 
 
 
 AddInfo(({"priester","kannibalenpriester"}),
    "fluestert: Der Kannibalenpriester will Deinen Tod!\n");
 AddInfo("dante",
 "sagt: Der macht mir nur Sorgen!\n");   
 AddInfo(({"kannibalen","kannibale"}),
    "sagt: Das Dorf der Kannibalen ist in der Naehe von hier...\n");
 AddInfo("dschungel",
    "sagt: Der Dschungel steckt voller Gefahren....\n");
 AddInfo("medaillon",
    "kreischt: Das bekommst Du nur ueber meine Leiche!\n");
 AddInfo("pyramide",
    "sagt: Huete Dich vor der verfluchten Pyramide...\n");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler ist ein guter, hilfsbereiter Mensch.\n");               
  }


