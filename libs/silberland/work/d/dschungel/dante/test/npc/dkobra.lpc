// satanskobra fuer die boesen buben

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Satanskobra");
  SetProp(P_LONG, BS(
    "Die Satanskobra ist eine hochgiftige riesengrosse Schlange. Sie ist das"
    " Lieblingstier aller Schwarzmagier und Satanisten. Ihre scharfen Giftzaehne"
    " blinken Dich gefaehrlich an...\n"));
  AddDetail(({"giftzaehne","zahn","zaehne"}),
  "Diese Zaehne sind eine toedliche Waffe.\n");
  
  SetProp(P_NAME, "Satanskobra");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schlange", "kobra", "satanskobra"}));
  set_living_name("satanskobra");

  create_default_npc(16);
  SetProp(P_HANDS, ({" mit ihrem Giftzaehnen ",200,({DT_POISON,DT_RIP,DT_PIERCE}) }) );
  SetProp(P_MAX_HP, 500);
  SetProp(P_BODY, 150);
  SetProp(P_MAX_SP, 700);
  SetProp(P_SIZE, 800);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_RESISTANCE, ({ DT_POISON,DT_MAGIC})); 
  SetProp(P_VULNERABILITY, ({ DT_FIRE,DT_WATER }));
  SetProp(P_NOMAGIC,30);

  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " zischt Dich nie wieder an.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "SSSSS....SSSS....");
  SetProp(P_KILL_NAME, "Satanskobra");
  SetProp(P_KILL_MSG, "SSSSS.....SSSS....");

  AddInfo(DEFAULT_INFO, "zischt Dich nur boese an.\n");
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Satanskobra braucht Deinen Muell nicht.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(70,200,
    "Die Satanskobra schlaegt ihre Zaehne in dein Fleisch.\n",
    "Die Satanskobra schlaegt ihre Zaehne in @WESSEN Fleich.\n");
  AddSpell(10,600,   
    "Die Satanskobra spuckt Dir Gift in die Augen.",
    "Die Satanskobra spuckt @WEM Gift in die Augen.");
  SetChats(3, ({
  "Die Satanskobra zischt Dich boese an.\n",
  "Die Satanskobra richtet sich auf.\n",
  "Die Satanskobra schnappt nach Dir.\n",
  "Du bekreuzigst Dich aengstlich.\n",
  "Die Satanskobra beobachtet Dich genau.\n",
  "Die Satanskobra pfaucht Dich an.\n",
  "Die Satanskobra beisst sich in den Schwanz.\n",
  "Die Satanskobra schlaengelt naeher an Dich heran.\n",
  "Die Satanskobra schlaengelt zwischen Deinen Beinen durch.\n"}) );
  SetAttackChats(10, ({
  "Die Satanskobra versucht Dich zu erwuergen.\n",
  "Die Satanskobra draengt Dich in ein Eck.\n",
  "Die Satanskobra zerquetscht Dein Bein.\n",
  "Du stolperst ueber Die Kobra.\n"}) );
  
  SUID;
  CLONEME(WEAPON "dgiftzahn");
  command("zuecke waffe");
  CLONEME(ARMOUR "dhaut");
  command("trage alles");
}

