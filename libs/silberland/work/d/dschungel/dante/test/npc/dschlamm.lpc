// /d/<region>/<magiername>/<gebiet>/npc/standard_npc.c   
// Ein Standard File fuer NPCs
// 27-10-1996  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grauer Schlammspringer");
  SetProp(P_LONG, BS(
    "Ein kleiner grauer Schlammspringer, der nur Schlamm isst und sein Gebiet "
    "tapfer verteidigt."));
  SetProp(P_NAME, "Schlammspringer");
  SetProp(P_GENDER, MALE);
  AddId(({"springer", "schlammspringer"}));

  create_default_npc(10);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen schlammigen Pfoten", 80,DT_ACID,DT_POISON}));
  SetProp(P_MAX_HP, 150 );
  SetProp(P_BODY, 60);
 // SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "schlammspringer");
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_ACID,DT_WATER })); 

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " versinkt im Schlamm.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "sagt: BLUBB BLUBB.\n");
  AddInfo("Dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schlammspringer will Deine Sachen nicht tragen.\n" }) );


  SetChats(3, ({
  "Der Schlammspringer sagt: BLUBB BLUBB\n",
  "Der Schlammspringer wuehlt im Schlamm.\n",
  "Der Schlammspringer bespritzt Dich mit Schlamm\n",
  "Der Schlammspringer huepft im Schlamm herum.\n"}) );
  SetAttackChats(10, ({
  "Der Schlammspringer springt Dich an.\n",
  "Der Schlammspringer versucht im Schlamm unterzutauchen.\n",
  "Der Schlammspringer schleudert Dir Schlamm ins Gesicht.\n",
  "Der Schlammspringer versteckt sich im Schlamm.\n"}) );

  SUID;
  CLONEME(OBJ "dlap" );
}

