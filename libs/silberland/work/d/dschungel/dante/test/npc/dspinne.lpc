// 3koepfige spinne


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine dreikoepfige Mutantenspinne");
  SetProp(P_LONG, BS(
    "Die Mutantenspinne ist eine grausige Laune der Natur. Drei Koepfe streiten"
    " sich um einen Koerper. Sechs Beisszangen kaempfen um Nahrung fuer nur einen"
    " Magen."));
  AddDetail(({"beisszangen","zangen"}),
  "Diese kraeftigen Zangen zerfetzen jeden Gegner der ihnen zu nahe kommt.\n");
  AddDetail(("koerper"),
  "Diese Spinne ist auch in ihrer Groesse ein Mutant. Sie misst sicher einen"
  " Meter im Durchmesser...\n");
  AddDetail(({"kopf","koepfe"}),
  "Die Drei Koepfe beobachten Dich hungrig...\n");
  
  SetProp(P_NAME, "Mutantenspinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"mutantenspinne", "spinne"}));
  set_living_name("mutantenspinne");

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit ihren Beisszangen", 100, DT_BLUDGEON,DT_RIP,DT_PIERCE}));
  SetProp(P_INFO, ("Die Mutantenspinne lauert nur auf eine Chance Dich zu fressen!"));
  SetProp(P_MAX_HP, 250);
  SetProp(P_BODY, 200);
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_SP, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_WATER,DT_FIRE })); 
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " bricht mit lautem Krachen zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Dreikoepfige Mutantenspinne");
  SetProp(P_KILL_MSG, "Die Spinne saugt Deinen Koerper aus!");

  AddInfo(DEFAULT_INFO, " krabbelt naeher an Dich heran.\n");
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(50,300,
    "Die Mutantenspinne saugt Deinen Koerper leer.\n",
    "Die Mutantenspinne saugt @WESEN Koerper leer.\n");
  AddSpell(10, 600,
    "Die Mutantenspinne injeziert Dir ihren Verdauungssaft.\n",
    "Die Mutenatenspinne injeziert @WEM ihren Verdauungssaft.\n");
      
  SetChats(3, ({
  "Die Mutantenspinne krabbelt naeher an Dich heran.\n",
  "Du bekommst es mit der Angst zu tun.\n",
  "Die Mutantenspinne streckt ihre Fuehler nach Dir aus.\n",
  "Die Mutantenspinne kneift Dir ins Bein.\n",
  "Die drei Koepfe streiten darum wer Dich fressen darf.\n",
  "Die drei Koepfe beobachten Dich genau.\n",
  "Einer der Koepfe schnappt nach Dir.\n"}) );
  
  SetAttackChats(10, ({
  "Die Spinne versucht Dich in die Ecke zu draengen.\n",
  "Die Mutantenspinne zerfetzt Dein Bein.\n",
  "Du stolperst ueber einen Stein.\n",
  "Die Mutantenspinne zerdrueckt Deinen Arm.\n"}) );

  SUID;
  CLONEME(ARMOUR "dmpanzer");
  command("trage alles");
}

