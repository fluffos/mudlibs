// gorilla von dante 97 jaenner

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Gorilla");
  SetProp(P_LONG, BS(
    "Der Gorilla springt wuetend vor Dir auf und ab und stoesst wilde Grunzlaute"
    " aus. Scheinbar betrachtet er Dich als Eindringling in sein Teritorium,"
    " denn er trommelt wild mit seinen Faeusten auf seine Brust und schwingt"
    " dabei einen grossen Holzknueppel.\n"));
  SetProp(P_NAME, "Gorilla");
  SetProp(P_GENDER, MALE);
  AddId(({"woody", "affe", "gorilla"}));
  set_living_name("gorilla");

  AddDetail(({"knueppl","knueppel","hand"}),
  "Mit diesem Knueppel kann er sicher gewaltig zuhaun...\m");
  AddDetail(({"eindringling","teritorium"}),
  
  "Verschwinde lieber schnell...\n");
 AddDetail(({"brust","faeuste","faust"}),
  "Das laute Droehnen erfuellt die Lichtung mit Laerm.\n");
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Armen",DT_BLUDGEON}));
  SetProp(P_MAX_HP, 250);
  SetProp(P_BODY, 180);
  SetProp(P_RACE, "affe");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 70);
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_WATER })); 
  SetProp(P_VULNERABILITY, ({ DT_MAGIC,DT_FIRE }));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "springt von einem Baum herab");
  SetProp(P_MMSGOUT, "verschwindet zu Diane Fossey");

  SetProp(P_DIE_MSG,  " stuerzt zu Boden.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "trommelt nur wild aus seine breite Brust.\n");
  AddInfo("dante", "Dante ist mein Herr und Meister","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Gorilla grunzt nur laut.\n" }) );


  SetChats(4, ({
  "Der Gorilla schlaegt mit seiner Keule nach Dir.\n",
  "Der Gorilla reisst an Deiner Kleidung.\n",
  "Der Gorilla zieht an Deinen Haaren.\n",
  "Der Gorilla grunzt laut.\n",
  "Der Gorilla schwingt seine Keule.\n",
  "Der Gorilla schubst Dich.\n",
  "Der Gorilla gestikuliert Dir zu verschwinden.\n",
  "Der Gorilla laesst Dich keinen Moment aus den Augen.\n",
  "Der Gorilla macht einen Handstand.\n"}) );
  
  SetAttackChats(10, ({
  "Der Gorilla beisst Dir in den Arm.\n",
  "Der Gorilla schlaegt Dich zu Boden.\n",
  "AUA!!! Tut die Keule weh!!!\n",
  "Der Gorilla spuckt Dich an.\n",
  "Der Gorilla draengt Dich zurueck.\n"}) );
  
  SUID;
  CLONEME(OBJ "dbana");
  CLONEME(WEAPON "dknueppel");
  command("zuecke waffe");
}

