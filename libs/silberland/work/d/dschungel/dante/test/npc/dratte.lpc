/*
** ne dschungelratte
** ---
** 
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>
#include <combat.h>


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Ratte");
  SetProp (P_LONG, bs("Du siehst vor Dir eine fette Dschungelratte, die immer"
  " auf der Suche nach Nahrung ist.\n"));
  SetProp (P_NAME, "Ratte");
  SetProp(P_INFO, ("Ratten uebertragen die Pest...\n"));
  SetProp (P_GENDER, FEMALE);
  AddId ("ratte");
  create_default_npc (6);
   SetProp (P_BODY, 60);
  SetProp (P_SIZE, 50);
  SetProp (P_HEAL, -8);
  SetProp (P_MSGIN, "trappselt herein");
  SetProp (P_HANDS, ({" mit ihren Krallen", 25, DT_POISON,DT_RIP,DT_PIERCE}));
  SetProp (P_ALIGN, -100);
  SetProp (P_XP, 25000);
  SetChats(5, ({
  "Die Ratte huscht an Dir vorueber.",
  "Die Ratte schnuppert nach Dir.",
  "Die Ratte pinkelt Dir auf die Fuesse.",
  "Die Ratte wuehlt im Boden.",
  "Die Ratte kratzt sich.",
  "Die Ratte sucht nach Nahrung." }) );
  
  
  SUID;
  CLONEME (WEAPON "dzahn");
  command ("zuecke rattenzahn");
}
