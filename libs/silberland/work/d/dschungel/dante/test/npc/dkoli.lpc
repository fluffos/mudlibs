// klolibri.
//dante 97 jaenner
// 
// 

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein bunter Kolibri");
  SetProp(P_LONG, (
    "Der Kolibri ist ein kleiner aber enorm schneller Vogel."));
  SetProp(P_NAME, "Kolibri");
  SetProp(P_GENDER, MALE);
  AddId( ({"kolibri"}));

  create_default_npc (6);
  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel", 60, DT_PIERCE,DT_RIP}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 12);
  SetProp(P_ALIGN, 50);
  SetProp(P_DIE_MSG, " faellt zu Boden.\n");
  SetProp(P_HEAL, 3);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weit weg");

  AddInfo(DEFAULT_INFO, "flattert aufgeregt mit seinen kleinen Fluegeln.\n");
  
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Der Kolibri ist doch voel zu klein.\n"}));

  SetChats(4, ({
    "Der Kolibri haemmert gegen den Stamm.\n",
    "Der Kolibri fliegt zum naechsten Ast.\n",
    "Der Kolibri schaut Dich neugierig an.\n",
    "Der Kolibri scheint Dich mit seinem Lied zu verhoehnen.\n",
    "Du hoerst begeistert dem Traellern des Kolibris zu.\n",
    "Der Kolibri putzt sein Gefieder.\n",
    "Der Kolibri flattert aufgeregt mit den Fluegeln.\n",
    "Der Kolibri traellert eine froehliche Melodie.\n"}) );

SetAttackChats(20, ({
"Der Kolibri sticht Dir ins Auge.\n",
"Der Kolibri versucht zu fliehen.\n",
"Der Kolibri zwickt Dir in die Nase.\n"}) );
}
