// der kannibalenhaeuptling

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Kannibalenhaeuptling");
  SetProp(P_LONG, BS(
    "Vor Dir siehst Du den maechtigen Haeuptling der Kannibalen. Er ist nicht "
    "nur der groesste, staerkste und gewaltaetigste, sondern auch der blut-"
    "ruenstigste. Er baut sich siegessicher mit seinem gewaltigen Koerper vor "
    "Dir auf und scheint Dich nicht ganz ernst zu nehmen.\n"));
  AddDetail("koerper",
  "Der Haeuptling ist ein wahrer Riese, muskelbepackt und strotzend vor Kraft.\n");
  SetProp(P_NAME, "Kannibalenhaeuptling");
  SetProp(P_GENDER, MALE);
  AddId(({"kannibalenhaeuptling", "kannibale", "haeuptling"}));
  set_living_name("kannibalenhaeuptling");

  create_default_npc(20);
  SetProp(P_HANDS, ({"mit seinen grossen Faeusten ",200,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 800);
  SetProp(P_SMELL, "Der Haeuptling riecht nach frischem Zwergenfleisch.\n");
  SetProp(P_INFO, ("Der Haeuptling wuerde Dich am liebsten gleich fressen.\n"));
  SetProp(P_BODY, 150);
  SetProp(P_MAX_SP, 1000);
  SetProp(P_RACE, "kannibale");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_SLASH })); 
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " bricht mit einem lauten Auschrei nieder.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Kannibalenhaeuptling");
  SetProp(P_KILL_MSG, "Du wirst mit gut schmecken.");

  AddInfo(DEFAULT_INFO, ({
  "sagt: Verschwinde solange Du noch kannst!\n",
  "tritt Dir in den Bauch.\n",
  "flucht nur laut.\n",
  "lacht ueber Deine dummen Fragen.\n",
  "sagt: Du wirst gut schmecken!\n",
  "sagt: Wenn interessiert das schon!\n",
  "sagt: Frag lieber den Balrog.\n",
  "murmmelt etwas unverstaendliches.\n"}) );
  
  
  
  AddInfo("dante", "Dante wird mir gut munden...","sagt: ");
  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kannibalenhaeuptling schlaegt Dir ins Gesicht.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(10,400,
  
    "Der Kannibalenhaeuptling schlaegt Dir den Schaedel ein.\n",
    "Der Kannibalenhaeuptling schlaegt @WEM den Schaedel ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(50,200,
   "Der Kannibalenhaeuptling bricht Dir die Knochen.\n",
   "Der Kannibalenhaeuptling bricht @WESSEN Knochen.\n",
   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(30,300,
  "Der Kannibalenhaeuptling zertruemmert Dein Gesicht.\n",
  "Der Kannibalenhaeuptling zertruemmert @WESSEN Gesicht.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  
  SetChats(3, ({
  "Der Kannibalenhaeuptling lacht ueber Dich.\n",
  "Der Kannibalenhaeuptling frisst eine rohe Leber.\n",
  "Der Kannibalenhaeuptling spuckt knapp an Dir vorbei.\n",
  "Der Kannibalenhaeuptling flucht laut.\n",
  "Der Kannibalenhaeuptling schreit: Ich will Menschenfleisch!\n",
  "Der Kannibalenhaeuptling protzt mit seinen Muskeln.\n",
  "Der Kannibalenhaeuptling furzt laut.\n",
  "Der Kannibalenhaeuptling verlangt ein Zwergensteak.\n",
  "Der Kannibalenhaeuptling verhoehnt Dich.\n",
  "Du bewunderst die Muskeln des Haeuptlings.\n",
  "Der Kannibalenhaeuptling sagt: Was willst Du denn hier?\n",
  "Der Kannibalenhaeuptling sagt: Hau ab, Du Wurm!\n",
  "Der Kannibalenhaeuptling stoesst Dich zur Seite.\n",
  "Der Kannibalenhaeuptling schreit: Los, bringt mir eine Hobbit!\n"}) );
  
  SetAttackChats(10, ({
  "Der Kannibalenhaeuptling spuckt Dir ins Gesicht.\n",
  "Der Kannibalenhaeuptling lacht Dich aus.\n",
  "Der Kannibalenhaeuptling schreit: Dich fresse ich roh!\n",
  "Der Kannibalenhaeuptling bruellt: Du mieser Feigling!\n",
  "Der Kannibalenhaeuptling draengt Dich in eine Ecke.\n"
  "Der Kannibalenhaeuptling versucht Dich zu erwuergen.\n",
  "Der Kannibalenhaeuptling verspricht Dir einen grausamen Tod.\n"}) );

  
  SUID;
  CLONEME(WEAPON "dobschwert");
  command("zuecke schwert");
  CLONEME(ARMOUR "dknochenpanzer");
  CLONEME(ARMOUR "dfederkrone");
  CLONEME(ARMOUR "dhwschild");
  CLONEME(OBJ "dhirn");
  command("trage alles");
}

