// Ein dummer vogel.....dante   
// diesmal ein geier
// 

inherit "std/npc";
inherit "std/npc/sequencer";
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>




create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Aasgeier");
  SetProp(P_LONG, (
    "Der Aasgeier ernaehrt sich wie eben sein Name schon sagt, von Kada"
    "vern, also sei auf der Hut, dass Du nicht zu seiner Mahlzeit "
    "wirst. Mit seinem kraeftigen Schnabel kann er muehelos harte Knochen"
    " aufhacken. Er hat bereits ein Auge auf Dich geworfen, obwohl Du noch"
    " lebst...\n"));
    
  SetProp(P_NAME, "Aasgeier");
  SetProp(P_GENDER, MALE);
  AddId( ({"geier","aasgeier"}) );
  AddDetail( ({"schnabel", "knochen"}),
    "Der Aasgeier knackt mit seinem harten, gekruemten Schnabel die Schaedel"
    "decke seiner Opfer auf und pickt dann ihr Hirn heraus.\n");
  

  create_default_npc ( 14 );
  SetProp(P_HANDS, ({" mit seinem harten Schnabel.", 110,
                     DT_RIP}));
  SetProp(P_XP, 1000*100);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 80+random(20));
  SetProp(P_ALIGN, -100);
 
  SetProp(P_DIE_MSG, " wird nun selbst eine Mahlzeit fuer die Tiere des Dschungels.\n");
  SetProp(P_MAX_HP, 200);
  SetProp(P_BODY, 50);
  set_living_name ("assgeier");
  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "segelt herein");
  SetProp(P_MMSGOUT, "segelt davon");
  SetProp(P_MAX_SP, 500);
  SetProp(P_SPELLRATE,40);
  SetProp(P_RESISTANCE, ({ DT_POISON }));
  SetProp(P_NOMAGIC, 50);
  AddInfo(DEFAULT_INFO, "beobachtet Dich nur.\n");
  AddInfo("dante", "Dante waere ein leckerer Happen.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Was soll ein Vogel mit Deinem Kram?\n"}));
  SetProp(P_KILL_MSG,("Der Geier stuerzt sich auf Deinen Kadaver.\n"));
  AddSpell(60,100,
  "Der Geier reisst Dir mit seinem Schnabel ein Stueck Fleisch heraus.\n",
  "Der Geier reisst @WEM mit seinem Schnabel ein Stueck Fleich heraus.\n");
    
  AddSpell(20,200,
  "Der Geier hackt Dir mit seinem Klauen die Augen aus.\n",
  "Der Geier hackt @WEM mit seinen Klauen die Augen aus.\n"); 
    
 SetChats(10, ({
  "Der Geier putzt sein blutverschmiertes Gefieder.\n",
  "Der Geier spaeht nach einem Kadaver.\n",
  "Du weichst vor dem Geier zurueck.\n",
  "Der Geier erhebt sich in die Luefte.\n",  
  "Eine Maus kann sich gerade noch vor dem Geier retten.\n",
  "Der Geier stoesst einen markerschuetternden Schrei aus.\n"}) );
  
  SetAttackChats(20, ({
  "Der Geier stuerzt sich auf Dich.\n",
  "Du verlierst fast das Gleichgewicht.\n",
  "Der Geier versucht Dich zu kratzen.\n",
  "Der Geier stoesst auf Dich herab.\n"}) );  
   } 
   