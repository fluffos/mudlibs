// maerz 97 sl dante

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein altes Skelett");
  SetProp(P_LONG, BS(
    "Dies ist das alte, sehr klapprige Skelett eine ehemaligen Abenteurers."));
  SetProp(P_NAME, "Skelett");
  SetProp(P_GENDER, NEUTER);
  AddId(({"skelett"}));

  create_default_npc(12);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen spitzen Knochenhaenden", 130 ,DT_RIP,DT_PIERCE}));
  SetProp(P_MAX_HP, 150);
  SetProp(P_BODY, 80);
  SetProp(P_RACE, "skelett");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MSGOUT, "klappert");
  SetProp(P_MMSGIN, "erhebt sich ploetzlich aus der Ecke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " zerfaellt zu Staub.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "stoere meine Totenruhe nicht.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll ein Skelett mit Deinen Sachen ?\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(50,200,
    "Das Skelett haucht Dich mit seinem Todesatem an.\n",
    "Das Skelett haucht @WEN mit seinem Todesatem an.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Das Skelett klappert laut.\n"}) );
  SetAttackChats(10, ({
  "Das Skelett bruellt: Kann man nicht mal hier seine Ruhe haben ?",
  "Das Skelett scheint zu Staun zu zerfallen...",
  "Das Skelett klappert laut.\n"}) );

   AddSpell(20,300,
    "Das Skelett sticht Dir mit seinen spitzen Fingern ins Auge.\n",
    "Das Skelett sticht @WEM mit seinen spitzen Fingern ins Auge.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
}

