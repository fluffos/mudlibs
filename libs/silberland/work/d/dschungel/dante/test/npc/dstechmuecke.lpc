// laestige moskitos
// von dante(97) jaenner   
// 
// 

inherit "std/npc";
inherit "std/npc/sequencer";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "files.h"
#include <moving.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine laestige Stechmuecke");
  SetProp(P_LONG, (
    "Diese nette kleine Muecke gehoert zu den Stechmuecken, genauer es ist "
    "eine Anopheles. Diese Art hat die nette Angewohnheit Plasmodien, Filarien"
    "und andere Viren zu uebertragen, die uns so nette Krankheiten wie Malaria"
    " bescheren.\n"));
  AddDetail(({"filarien","filarie"}),
    ("Filarien wie z.B. F. loa oder F. malayi sind hochspezialisierte Vertreter"
     "der Nemathelminten, den Faden- oder Schlauchwuermern. Ueber mehrere Wirts"
     "wechsel gelangen sie letztendlich in unvorsichtige Abenteurer wie Dich,"
     " denen sie schmerzhafte Erkrankungen wie Loa Loa oder Wucheria Bancrofti"
     "bringen....\n"));  
  AddDetail(({"virus","viren"}),
    ("Die Anophelesmuecke uebertraegt durch ihren Stich z.B. den O'Nyongnyong-"
     "Virus. Aber was der so macht weiss ich nicht mehr...\n"));
  AddDetail(({"plasmodien","plasmodium"}),
    ("Plasmodien sind Parasiten, die vorwiegend in den roten Blutkoerperchen"
     "existieren. Sie machen mehrere Wirts- und Genaerationswechsel durch bis"
     "sie letztendlich in unserem Koerper landen. Bei den Plasmodien kann man"
     " zumindest 4 verschiedene Arten unterscheiden, die auch verschiedene "
     "Arten der Malaria ausloesen.\n"));
  AddDetail(({"krankheit","krankheiten"}),
    ("Tja, welche wird wohl Dich ereilen...die Palette ist ja gross...\n"));
       
                                                                                  
    
  SetProp(P_NAME, "Stechmuecke");
  SetProp(P_GENDER, FEMALE);
  AddId(({"stechmuecke","muecke"}));
                        
                        
  create_default_npc(3);
  SetProp(P_HANDS, ({" mit ihrem spitzen Stachel", 20, DT_POISON}));
  SetProp(P_XP, 50*100);
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weit weg");

  AddInfo(DEFAULT_INFO, "surrt wild um Dich herum.\n");
  AddInfo("dante", "teilt Dir mit: Dante hat mich zu Dir geschickt.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Aber wie soll denn so ein kleines Insekt das tragen?\n"}));

  SetChats(5, ({
    "Die Stechmuecke setzt sich auf Deine Nase.\n",
    "Tja, eine Fliegenklappe waere hier wohl angebracht.\n",
    "Die Stechmuecke beisst Dich.\n",
    "Die Stechmuecke saugt Blut etwas Blut aus Dir.\n",
    "Die Stechmuecke sticht Dir in die Nase!AUA!\n",
    "Du versuchst die Stechmuecke mit der Hand zu erschlagen.\n",
    "Die Stechmuecke surrt herum.\n",
    "Die Stechmuecke surrt um Deinen Kopf herum.\n"}) );
}

die(arg)
{
CLONE(OBJ"dmala", TP);
::die(arg);
}