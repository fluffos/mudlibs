//wurm.c   
// schlammwurm
// 

inherit "std/npc";
inherit "std/npc/sequencer";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Schlammwurm");
  SetProp(P_LONG, BS(
    "Dieser Schlammwurm ist so klein, dass man ihn mit normalen Waffen kaum "
    "treffen kann. Aber vielleicht kann man ihn zertreten.") );
  SetProp(P_NAME, "Schlammwurm");
  SetProp(P_GENDER, MALE);
  AddId(({"wurm", "Schlammwurm"}));

  create_default_npc(4);
  SetProp(P_HANDS, ({" mit seinen giftigen Zaehnchen", 30, DT_POISON}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, 0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht her");
  SetProp(P_MMSGOUT, "kriecht weg");

  SetProp(P_DIE_MSG,  " wird zerquetscht.\n");
  SetProp(P_DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  
    

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schlammwurm kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON, DT_FIRE, DT_WATER, DT_POISON,
                           DT_TERROR, DT_ACID, DT_LIGHT, DT_SOUND})); 
  SetProp(P_VULNERABILITY, ({ DT_COLD, DT_SQUEEZE, DT_EXPLOSION}));

  SUID;
  CLONEME( ARMOUR "/dwurmhaut");
  command("trage alles");

  AddCmd( "zertrete", "zertreten");
}

void Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if( random(222)<enemy->QueryProp(P_SIZE) )
  {
    write("Der Wurm ist so klein, dass Du ihn gar nicht triffst.\n");
    return ::Defend(0, dam_type, spell, enemy);
  }
  return ::Defend(dam/4, dam_type, spell, enemy);
}

int zertreten(string str)
{
  object *schuhe;
  int dam;
  notify_fail("Wen willst Du zertreten?\n");
  if( !str) return 0;
  if( id(str) )
  {
    schuhe=filter_objects(PL->QueryProp(P_ARMOURS), "id", AT_BOOT); 
    if (sizeof(schuhe) && objectp(schuhe[0]))
    {
      write("Du zertrittst den Schlammwurm.\n");
      say( CAP(TPN)+ " zertritt einen Schlammwurm.\n");
      dam = 1000 + random( schuhe[0]->QueryProp(P_WEIGHT) * 
            TP->QueryAttribute(A_STR) );
      ::Defend(dam/100, DT_SQUEEZE, 0, TP);
      return 1;
    }
    write("Schmerzhaft trittst du mit blossen Fuessen auf den Schlammwurm.\n"
          "Ob das eine gute Idee war?\n");
    TP->reduce_hit_point( 5+random(10) );
    return 1;
  }
  return 0;
}
