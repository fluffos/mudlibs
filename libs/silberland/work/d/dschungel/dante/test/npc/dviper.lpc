
inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "files.h"

create()
{
if (!is_clone(this_object())) return;
:: create();

SetProp(P_NAME, "Hoellenviper");
SetProp(P_GENDER, FEMALE);
SetProp(P_SHORT, "Eine Hoellenviper");
SetProp(P_LEVEL, 12);
SetProp(P_HEAL, -3);
SetProp(P_SIZE, 150);
SetProp(P_WEIGHT, 9000);
SetProp(P_ALIGN, -200);
SetProp(P_AGGRESSIVE, 1);
SetProp(P_XP, 70000);
SetProp(P_BODY, 90);
SetProp(P_MAX_HANDS, 2);
SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen an.", 80,DT_POISON}));
create_default_npc ( 12 );
AddId(({"schlange","viper","hoellenviper"}));
SetProp(P_DIE_MSG, " windet sich noch einmal am Boden und verendet dann lautlos.\n");
set_living_name ("hoellenviper");
SetProp(P_MAX_HP,  300);
SetProp(P_MAX_SP, 1000);
SetProp(P_REJECT, ({ REJECT_KEEP, "Die Hoellenviper zischt dich nur an.\n"}) );

SetAttackChats(20, ({
    "Die Hoellenviper beisst Dir in die Beine.\n",
    "Die Hoellenviper zerfetzt Deine Hand.\n",
    "Die Hoellenviper verbeisst sich in Deinem Hals.\n",
    "Die Hoellenviper springt Dir an die Kehle.\n"}));
SetChats(5, ({
    "Die Hoellenviper richtet sich auf und pfaucht Dich an.\n",
    "Die Hoellenviper kriecht naeher an Dich heran.\n",
    "Die Hoellenviper versucht Dich zu attackieren.\n",
    "OH!!! Fast waerst Du auf die Hoellenviper getreten!\n",
    "Du weichst der Hoellenviper behende aus.\n",
    "Die Hoellenviper schlaengelt um Dich herum.\n"}) );

SetProp(P_SPELLRATE, 50);
           
AddSpell(50,150,
    "Die Hoellenviper schlaegt ihre Zaehne in Deine Hand.\n",
    "Die Hoellenviper schlaegt ihre Zaehne in @WESSEN Hand.\n"); 
AddSpell(15,300,
    "Die Hoellenviper spuckt Dir Gift in die Augen.\n",
    "Die Hoellenviper spuckt @WEM Gift in die Augen.\n");
    
SetProp(P_LONG, ("Die Hoellenviper ist eine grosse giftige Schlange. Ihren Namen "
                 "hat sie, weil ihr tiefschwarzer Koerper rote flammenaehnliche "
                 "Flecken aufweisst.\n"));
   AddDetail(({"flammen","flecken","koerper" }),
            "Die Flecken erinnern Dich wircklich an Feuer und die Hoelle.\n");
     }                          