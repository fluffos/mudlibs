// kannibalenkoch

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kannibalenkoch");
  SetProp(P_LONG, BS(
    "Du siehst einen fetten Kannibalen, der gerade dabei ist einen Elf zu"
    " tranchieren. Kochmuetze hat er allerdings keine!\n"));
  SetProp(P_NAME, "Kannibale");
  SetProp(P_GENDER, MALE);
  AddId(({"kannibale","kannibalenkoch","koch"}));

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen Faeusten",130,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 300);
  SetProp(P_MAX_SP, 600);
  SetProp(P_BODY, 200);
  SetProp(P_RACE, "kannibale");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " haucht sein Kannibalenleben aus.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Dich fresse ich auch noch!!!");
  SetProp(P_KILL_NAME, "Kannibalenkoch");
  SetProp(P_KILL_MSG, "HAHA! Du kommst in meinen Topf!!");

  AddInfo(DEFAULT_INFO, "fragt: Kann man das fressen?.\n");
  AddInfo("priester", "Er ist der maechtigste Mann im Dorf.","sagt: ");
  SetProp(P_LOG_INFO, "npc_logfile");
  AddInfo("kannibale", "Ich bin einer davon, Du Idiot!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Kannibale sagt: Hmm, welche Fuellung soll ich dazu machen?\n" }) );
  SetProp(P_SPELLRATE, 30);
  AddSpell(10, 200,
  "Der Kannibalenkoch schlaegt Dir den Schaedel ein.\n",
  "Der Kannibalenkoch schlaegt @WEM den Schaedel ein.\n");
  AddSpell(30,100,
  "Der Kannibalenkoch schlitzt Dich auf.\n",
  "Der Kannibalenkoch schlitzt @WENN auf.\n");
  SetChats(3, ({
  "Der Kannibalenkoch furzt hemmungslos.\n",
  "Der Kannibalenkoch ruelpst laut.\n",
  "Der Kannibalenkoch tritt Dich.\n",
  "Der Kannibalenkoch will ein Stueck Fleisch von Dir abschneiden.\n",
  "Der Kannibalenkoch will Dich wuerzen.\n",
  "Der Kannibalenkoch will Dich poekeln.\n",
  "Der Kannibalenkoch zerhackt eine Milz.\n",
  "Der Kannibalenkoch murmmelt etwas von filetierten Zwergen.\n",
  "Der Kannibalenkoch schaut Dich hungrig an.\n",
  "Der Kannibalenkoch ueberlegt Deine Fuellung.\n",
  "Der Kannibalenkoch kratzt sich am Knie.\n",
  "Der Kannibalenkoch schreit Dich an.\n"}) );
  
  SetAttackChats(10, ({
  "Der Kannibalenkoch versucht Dich zu erwuergen!\n",
  "Der Kannibalenkoch will Dich roh fressen!\n",
  "Der Kannibalenkoch ruft seine Stammesbrueder zu Hilfe.\n",
  "Der Kannibalenkoch freut sich auf Deine Leber.\n",
  "Der Kannibalenkoch will Dich in seinen Topf draengen.\n",
  "Der Kannibalenkoch verflucht Dich.\n",
  "Der Kannibalenkoch draegt Dich zurueck.\n"}) );

  SUID;
  CLONEME(WEAPON "dtrmesser");
  command("zuecke schwert");
  CLONEME(OBJ "dfrucht");
  CLONEME(OBJ "dleb");
  CLONEME(OBJ "dri");
  CLONEME(ARMOUR "dledergamaschen");
  command("trage alles");
}

