

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine wuetende Steingigantenmama");
  SetProp(P_LONG, (
    "Die Steingigantenmama besteht aus purem Granit. Ihre steinerne Haut "
    "schuetzt sie vor laestigen Angreifern, die sie mit ihren gewaltigen "
    "Faeusten zermalmt. Du haettest ihr Baby  besser in Ruhe gelassen.\n"));
  SetProp(P_NAME, "Steingigantenmama");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AGGRESSIVE, 1);
  AddDetail(("granit"),
  "Granit, Granit , sie besteht eben nur aus Granit...\n");
  AddId( ({"gigant", "steingigant","mama","steingigantenmama","gigantenmama"}) );
  AddDetail(({"faust","faeuste"}),
    "Die Faeuste der Steingigantenmama solltest Du besser niemals zu spueren bekommen.\n");
    AddDetail(("haut"),
    "Die harte Haut der Steingigantenmama ist ein hervorragender Schutz.\n");
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit ihren steinernen Faeusten", 250, DT_BLUDGEON}));
  SetProp(P_MAX_HP, 400+random(100));
  SetProp(P_BODY,150+random(100));
  SetProp(P_XP, 9000*100);
  SetProp(P_RACE, "Gigant");
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 20000);
  AddInfo(DEFAULT_INFO, "Die Steingigantenmama sagt: Du Kindermoerder!!!.\n");
  SetProp(P_REJECT, ({ REJECT_DROP 
     "Von Dir nehme ich nichts.\n"}));
  SetProp(P_DIE_MSG, " folgt ihrem Kind in den Steingigantenhimmel.\n");
  SetProp(P_INFO, ("Die Steingigantenmama will den Tod Ihres Kindes Raechen."));
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_SLASH}));
  
  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 30);
  AddSpell(50, 200, 
   "Die Steingigantenmama zertruemmert Deinen Arm.\n",
    "Die Steingigantenmama zertruemmert @WESSEN Arm.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(20, 300, 
    "Die Steingigantenmama schleudert Felsbloecke nach Dir.\n",
    "Die Steingigantenmama schleudert Felsbloecke nach @WEM.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(50, 300,
    "Die Faust der Steingigantenmama schlaegt auf Deinen Schaedel.\n",
    "Die Faust der Steingigantenmama schlaegt auf @WESSEN Schaedel.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 1000,
    "Die Steimngigantenmama raecht sich fuer ihr totes Kind fuerchterlich an Dir.\n",
    "Die Steingigantenmama raecht sich fuer ihr totes Kind fuerchterlich an @WEM.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  

 SetAttackChats(20, ({
    "Die Steingigantemama schreit: Du Kindermoerder!\n",
    "Die Steingigantenmama sagt: Das bezahlst Du mit Deinem Leben.\n",
    "Die Steingigantenmama bruellt vor Kummer.\n",
    "Die Steingigantenmama ruft: Wo ist mein geliebtes Kind!\n",
    "Die Steingigantenmama sagt: Stirb, Du Schwein!\n",
    "Du beginnst den Kindesmord zu bereuen.\n",
    "Die Steingigantenmama schreit: Elender Moerder!\n"}));
 
  }


