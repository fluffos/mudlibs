// kannibale mit helm u staerker

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kannibale");
  SetProp(P_LONG, BS(
    "Du siehst einen wild dreinblickenden sehnigen Kannibalen vor Dir, dem "
    "man die Mordlust direkt ansehen kann!\n"));
  SetProp(P_NAME, "Kannibale");
  SetProp(P_GENDER, MALE);
  AddId(({"kannibale","mann"}));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Faeusten",130,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 450);
  SetProp(P_MAX_SP, 600);
  SetProp(P_BODY, 250);
  SetProp(P_RACE, "kannibale");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " haucht sein Kannibalenleben aus.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Dich fresse ich auch noch!!!");
  SetProp(P_KILL_NAME, "Kannibale");
  SetProp(P_KILL_MSG, "HAHA! Du kommst in meinen Topf!!");

  AddInfo(DEFAULT_INFO, "schreit: Verschwinde aus dem Dorf, oder wir fressen Dich.\n");
  AddInfo("priester", "Er ist der maechtigste Mann im Dorf.","sagt: ");
  SetProp(P_LOG_INFO, "npc_logfile");
  AddInfo("kannibale", "Ich bin einer davon, Du Idiot!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Kannibale sagt: Erwartest Du fuer den Muell auch noch Dank?\n" }) );
  SetProp(P_SPELLRATE, 30);
  AddSpell(10, 250,
  "Der Kannibale schlaegt Dir den Schaedel ein.\n",
  "Der Kannibale schlaegt @WEM den Schaedel ein.\n");
  AddSpell(30,150,
  "Der Kannibale schlitzt Dich auf.\n",
  "Der Kannibale schlitzt @WENN auf.\n");
  SetChats(3, ({
  "Der Kannibale furzt hemmungslos.\n",
  "Der Kannibale ruelpst laut.\n",
  "Der Kannibale tritt Dich.\n",
  "Der Kannibale will ein Stueck Fleisch von Dir abschneiden.\n",
  "Der Kannibale schaut Dich hungrig an.\n",
  "Der Kannibale tobt.\n",
  "Der Kannibale schwingt sein Knochenschwert.\n",
  "Der Kannibale baut sich vor Dir drohend auf.\n",
  "Der Kannibale kratzt sich am Knie.\n",
  "Der Kannibale deutet Dir zu verschwinden.\n",
  "Der Kannibale schreit Dich an.\n"}) );
  
  SetAttackChats(10, ({
  "Der Kannibale versucht Dich zu erwuergen!\n",
  "Der Kannibale will Dich roh fressen!\n",
  "Der Kannibale ruft seine Stammesbrueder zu Hilfe.\n",
  "Der Kannibale freut sich auf Deine Leber.\n",
  "Der Kannibale verflucht Dich.\n",
  "Der Kannibale draegt Dich zurueck.\n"}) );

  SUID;
  CLONEME(WEAPON "dkschwert");
  command("zuecke schwert");
  CLONEME(ARMOUR "dkschild");
  CLONEME(OBJ "dri");
  CLONEME(ARMOUR "dkhelm");
  command("trage alles");
}

