//kann blinde entblinden
//dante sl 98
//nur begrenz benutzbar

#include <properties.h>
#include <combat.h>
inherit "std/armour";
#include "files.h"
 
int ready;
int anzahl;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  ready = 1;
  anzahl=random(5)+20;
  SetProp(P_SHORT, "Das Wasserauge");
  SetProp(P_LONG,BS(
  "Das ist das beruehmte Wasserauge des Spiegelgeistes! Es haengt an einer Kette "
  "mit deren Hilfe man es anziehen kann! Die Pupille des Auges scheint genau "
  "auf Dich gerichtet zu sein!"));
  AddDetail("pupille",
  "In Deinem Geist formt sich ein Wort: `opthalmolo'!");
  
  AddDetail("kette",
  "Zum anziehen!"); 
  SetProp(P_NAME, "Wasserauge");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 4);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 2200);
  SetProp(P_INFO, "Das Wasserauge kann Blinde sehend machen! \n");
  SetProp(P_MATERIAL, ([MAT_WATER:90, MAT_MISC_MAGIC:10]));
  AddId(({"amulett", "auge","wasserauge"}));
  AddCmd("opthalmolo", "done");
}

done()
{
  if (QueryWorn()!=this_player())
  {
    notify_fail("Du hast das Wasserauge nicht angezogen.\n");
    return 0;
  }
  if (!ready)
  {
    write("Das Wasserauge ist noch geschwaecht.\n");
    return 1;
  }
  
  if(!anzahl)
  {
  write("Das Wasserauge zerrinnt langsam in deinen Haenden!\n");
  say(""+TPN+" schaut dumm drein!\n");
  remove();
  return 1;
  }
  
  if ((TP->QueryProp(P_BLIND)==1)&&(ready)&&(anzahl))
  {
  write("Das Wasserauge blitz kurz auf, ein Strahl trifft Deine Augen und Du "
  "kannst wieder sehen!\n");
  
  say("Das Wasserauge von "+this_player()->name(WESSEN)+
      " blitzt kurz auf und ein Strahl trifft "+this_player()->name(WESSEN)+
      " Augen.\n");
      TP->SetProp(P_BLIND, 0);
      call_out("aufladen", 2000);
      ready=0;
      anzahl--;
      return 1;
                }
                
   if ((TP->QueryProp(P_BLIND)==0)&&(ready)&&(anzahl))
                {
      say(""+TPN+" erblindet aus eigener Schuld!\n");          
     write("Du warst nicht blind! Dafuer bist Du es nun!\n"
     "Das Wasserauge laesst nicht mit sich Spassen!\n");
     TP->SetProp(P_BLIND, 1);
       call_out("aufladen", 2000);
    ready=0;
    anzahl--;
    return 1;
       }
       
       
       
    return 0;
  }
  
  
  
    
aufladen()
{
   write("Das Wasserauge blitzt kurz auf.\n");
  ready = 1;
}

//ende