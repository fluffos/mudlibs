


#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

inherit "/std/npc";

void spiel(int nr, int to_go);
int lsg, anz;

create()
{
  ::create();
  SetProp(P_SHORT, "Xooxo");
  SetProp(P_LONG, 
    "Das ist Xooxo. Sie ist sehr klein.\n");
  SetProp(P_NAME, "Xooxo");
  create_default_npc(19);
  SetProp(P_RACE, "Mensch");
  SetProp(P_DEFAULT_INFO, "sagt: Davon habe ich noch nie gehoert.\n");
  SetProp(P_REJECT, ({ REJECT_GIVE, "Xooxo moechte das gar nicht haben.\n"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, 100);
  SetProp(P_GENDER, MALE);
  AddId( ({"\ngi_xooxo","xooxo"}) );
  AddInfo( ({"xooxo"}), 
    "Das ist mein Name. ",
    "sagt: ");
  AddInfo( ({"frager"}), 
    "Mit dem kann man nicht spielen. Der fragt nur. ",
    "sagt: ");
  AddInfo( ({"prof", "professor", "verwirrter professor"}), 
    "Der ist zu verwirrt zum Spielen. ",
    "sagt: ");
  AddInfo( ({"sandfresser"}), 
    "Der hat nur Sand im Kopf. ",
    "sagt: ");
  AddInfo( ({"kartograph"}), 
    "Der hat auch keinen Plan. ",
    "sagt: ");
  AddInfo( ({"wirt"}), 
    "Den kenne ich gar nicht. ",
    "sagt: ");
  AddInfo( ({"zocker"}), 
    "Der spielt andere Spiele. ",
    "sagt: ");
  AddInfo( ({"koch"}), 
    "Rede nicht von dem! Da bekomme ich nur Hunger. ",
    "sagt: ");
  AddInfo( ({"wache", "wachen"}), 
    "Wachen koennen auch nicht spielen. ",
    "sagt: ");
  AddInfo( ({"zwilling", "zwillinge"}), 
    "Die sind zu zweit. Das ist dann unfair. ",
    "sagt: ");
  AddInfo( ({"eskimos", "eskimo"}), 
    "Das ist ein eiskalter Spieler. ",
    "sagt: ");
  AddInfo( ({"orks", "ork"}), 
    "Hier gibt es einen, aber der ist doof. ",
    "sagt: ");
  AddInfo( ({"mr. q", "q", "mr q", "mister q"}), 
    "Mr. Q ist zwar schlau, hat aber selten Zeit. ",
    "sagt: ");
  AddInfo( ({"graf", "zahl", "graf zahl"}), 
    "Der Graf spielt hoechstens mit Zahlen. ",
    "sagt: ");
  AddInfo( ({"jack", "shaky", "shakies", "jack der shaky", "jack dem shaky"}), 
    "Jack betruegt immer. ",
    "sagt: ");
  AddInfo( ({"codeknacker"}), 
    "Der hat eine gute Strategie. ",
    "sagt: ");
  AddInfo( ({"croupier"}), 
    "Mit solchen spiele ich erst gar nicht. ",
    "sagt: ");
  AddInfo( ({"wolpihasser"}), 
    "Der kann nicht verlieren. ",
    "sagt: ");
  AddInfo( ({"code", "codes"}), 
    "Ich kenne einen, aber Du musst mich erst im Tic-Tac-Toe schlagen. ",
    "sagt: ");
  AddInfo( ({"schluessel"}), 
    "Ich habe keinen. ",
    "sagt: ");
  AddInfo( ({"zelle", "zellen"}), 
    "Die Waende gehen mir bald aus. ",
    "sagt: ");
  AddInfo( ({"insel", "gefaengnis", "gefaengnisinsel"}), 
    "Hier ist es echt oede. ",
    "sagt: ");
  AddInfo( ({"strafe"}), 
    "Ich bin dazu verdammt, Euch ohnehin schon verzweifelten Spieler noch mehr "
  + "zu belaestigen. ",
    "sagt: ");
  AddInfo( ({"grund", "tat"}), 
    "Ich habe mal gegen Shakedbeer gespielt und er hat verloren. Irgendwie hat der das "
  + "nicht ganz verkraftet. ",
    "sagt: ");
  AddInfo( ({"hilfe"}), 
    "Du darfst anfangen. ",
    "sagt: ");
  AddInfo( ({"tip"}), 
    "Es gibt eine sichere Strategie. ",
    "sagt: ");
  AddInfo( ({"problem"}), 
    "Ich habe keinen Spielpartner. ",
    "sagt: ");
  AddInfo( ({"ausbruch", "ausbrechen"}), 
    "Habe ich nie versucht. ",
    "sagt: ");
  AddInfo( ({"hof"}), 
    "Da gibt es frische Luft. ",
    "sagt: ");
  AddInfo( ({"kneipe"}), 
    "Da waere ich gerne mal. ",
    "sagt: ");
  AddInfo( ({"eingang"}), 
    "Den sehe ich selten. ",
    "sagt: ");
  AddInfo( ({"turm"}), 
    "Keine Ahnung was mit dem ist. ",
    "sagt: ");
  AddInfo( ({"raetsel", "aufgabe"}), 
    "Du musst dreimal hintereinander gegen mich Tic-Tac-Toe gewinnen. Ein "
  + "Unentschieden gilt weder als Sieg noch als Niederlage. Sollte ich gewinnen, "
  + "musst Du von vorne anfangen. Du bist immer zuerst dran. ",
    "sagt: ");
  AddInfo( ({"loesung"}), 
    "Probieren geht ueber studieren. ",
    "sagt: ");
  AddInfo( ({"syntax"}), 
    "Du kannst die Felder mit 'kreuze <nummer>' markieren. ",
    "sagt: ");
}
