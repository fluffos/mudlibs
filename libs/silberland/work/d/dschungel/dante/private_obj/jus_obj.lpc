/*
** steinpanzer dante sl jaenner 97
** die justavius variante!!!!!!!!!!!!!
 
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer","steinpanzer","granitpanzer", "justaviuspanzer"}));
  SetProp (P_SHORT, "Der steinerne Panzer von Justavius");
  SetProp (P_LONG, BS(
 "Aus irgendeinem Grund gehoert dieser Panzer Justavius! Wie die Steingiganten dazu "
 "gekommen sind, weiss man auch nicht mehr. Seltsam! Auf jeden Fall ist er "
 "ein gigantisch guter Panzer!"));
  SetProp (P_NAME, "Justaviuspanzer");
  SetProp (P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "steinern");
  SetProp (P_WEIGHT, 4000);
  SetProp (P_VALUE, 7000);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 38);
  SetProp (P_MATERIAL, MAT_GRANITE);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:18]) );
  SetProp(P_QUALITY_DECAY, 88 );
}

