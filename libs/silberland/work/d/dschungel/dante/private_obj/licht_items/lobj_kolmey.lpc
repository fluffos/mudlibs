/*

kolmeys lampe

*/

#include "privat.h" 
 
inherit PRIVDIR "std_light_obj"; 

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"lampe","stirnlampe"}));
  SetProp(P_SHORT, "Die rote Stirnlampe von Kolmey");
  SetProp(P_LONG, BS(
    "Das ist Kolmeys rote Stirnlampe. Sie haengt an einem Lederband, das man "
    "um den Kopf oder Helm tragen kann. Sie ist Dir sicher sehr nuetzlich."));
  
  SetProp(P_NAME, "Stirnlampe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "rot");
 
  SetProp (P_MATERIAL, ([MAT_LEATHER:80, MAT_MISC_MAGIC:20]));
}
