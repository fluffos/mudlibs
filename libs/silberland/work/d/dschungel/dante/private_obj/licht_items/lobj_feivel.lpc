/*

feivel
 Feivels Gluehwuermchen der Erleuchtung
*/

#include "privat.h"

inherit PRIVDIR "std_light_obj";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"wuermchen","wurm","gluehwurm","gluehwuermchen"}));
  SetProp(P_SHORT, "Feivels Gluehwuermchen der Erleuchtung");
  SetProp(P_LONG, BS(
    "Das ist Feivels Gluehwuermchen der Erleuchtung. Boese Zungen behaupten, dass "
    "es ihm wenig genuetzt hat. Es haengt an einer Kette, die man um den Hals tragen kann."));
 
  AD("kette", "Zum umhaengen!");

  SetProp(P_NAME, "Gluehwuermchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "erleuchtet");

  SetProp (P_MATERIAL, ([MAT_MISC_LIVING:20, MAT_STEEL:80]));
}
