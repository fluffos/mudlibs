/*

mcrobs titanring der strahlung

*/

#include "privat.h" 
 
inherit PRIVDIR "std_light_obj"; 

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"ring","titanring", "titanring der strahlung"}));
  SetProp(P_SHORT, "Der Titanring der Strahlung von Mcrobs");
  SetProp(P_LONG, BS(
    "Das ist der Titanring der Strahlung von Mcrobs. Er fuehlt sich sehr seltsam an "
    "und irgendwie scheint er zu leuchten..."));
  SetProp(P_NAME, "Titanring");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "strahlend");
 
  SetProp (P_MATERIAL, ([MAT_TITANIUM:90, MAT_MISC_MAGIC:10]));
}
