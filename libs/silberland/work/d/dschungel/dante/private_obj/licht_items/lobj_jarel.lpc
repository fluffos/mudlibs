/*

jarels lichtjuwel

*/

#include "privat.h"

inherit PRIVDIR "std_light_obj";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"juwel","lichtjuwel"}));
  SetProp(P_SHORT, "Das magische Lichtjuwel von Jarel");
  SetProp(P_LONG, BS(
    "Das ist das magische Lichtjuwel von Jarel. Es haengt an einer goldenen Kette "
    "und glaenzt mysthisch im Licht. Sicher kann es noch mehr, als schoen ausschauen..."));
  SetProp(P_NAME, "Lichtjuwel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "magisch");

  SetProp (P_MATERIAL, ([MAT_GOLD:10, MAT_JEWEL:80, MAT_MISC_MAGIC:10]));
}
