/*

cherubs lampe oder so

*/

#include "privat.h"

inherit PRIVDIR "std_light_obj";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"halsband","band"}));
  SetProp(P_SHORT, "Das Halsband der Helligkeit von Cherub");
  SetProp(P_LONG, BS(
    "Das ist Cherubs Halsband der Helligkeit. Es besteht aus einem gemischten "
    "Gewebe aus Baumwolle und Goldfasern."));  
  SetProp(P_NAME, "Halsband");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "hell");

  SetProp (P_MATERIAL, ([MAT_GOLD:20, MAT_COTTON:80]));
}
