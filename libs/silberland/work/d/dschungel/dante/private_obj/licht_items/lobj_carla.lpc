/*

"Carla's Steinhoerner des Lichts/der Hellsicht"

*/
#include "privat.h"

inherit PRIVDIR "std_light_obj";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId (({"steinhoerner","hoerner","horn"}));
  SetProp(P_SHORT, "Carlas Steinhoerner der Hellsicht");
  SetProp(P_LONG, BS(
    "Das sind Steinhoerner der Hellsicht! Sie gehoeren Carla! Man kann "
    "sie mit einem Riemen um den Kopf binden bzw. anziehen!"));
 
  AD("riemen", "Zum anziehen!");

  SetProp(P_NAME, "Steinhoerner der Hellsicht");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_PLURAL, 1);
 
  SetProp (P_MATERIAL, ([MAT_HORN:80, MAT_MISC_MAGIC:20]));
}
