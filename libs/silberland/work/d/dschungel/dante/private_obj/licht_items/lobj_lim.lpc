/*

Lims stinkende Socken

*/

#include "privat.h"

inherit PRIVDIR "std_light_obj";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"


create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"socken","neonsocken"}));
  SetProp(P_SHORT, "Lims stinkende Neonsocken");
  SetProp(P_LONG, BS(
    "Das sind Lims stinkende Neonsocken. Sie leuchten angeblich sogar im "
    "Dunkeln. Ein kleines Loch laesst wohl den grossen Zeh rausgucken."));
  
  SetProp(P_NAME, "Neonsocken");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "stinkig");
  SetProp(P_WEIGHT, 10);
 
  SetProp(P_MATERIAL, ([MAT_CLOTH:80, MAT_MISC_MAGIC:20]));
}
