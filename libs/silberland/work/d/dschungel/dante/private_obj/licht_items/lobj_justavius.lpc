/*
 Justavius Heiligenschein!!!!!!


*/

#include "privat.h"

inherit PRIVDIR "std_light_obj";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{  
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"heiligenschein","schein"}));
 
  SetProp(P_SHORT, "Justavius Heiligenschein der Scheinheiligkeit");
  SetProp(P_LONG, 
	  BS("Diesen Heiligenschein kann man anziehen. Er schwebt dann "
	     "ueber Deinem Kopf oder auch Deinem Helm. Er gehoerte "
	     "urspruenglich Justavius, sollte also wohl eher "
	     "Scheinheiligenschein heissen. Angeblich kann er Dir Deinen "
	     "Weg ausleuchten, also etwas Licht erzeugen!"));

  SetProp(P_NAME, "Heiligenschein der Scheinheiligkeit");
  SetProp(P_GENDER, MALE);
  
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100,MAT_MISC_HOLY:100]));
}
