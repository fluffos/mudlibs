/*
  
  kaefer fuer clementine
  
*/

#include "privat.h"

inherit PRIVDIR "std_light_obj";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  AddId(({"marienkaefer","kaefer"}));
  SetProp(P_SHORT, "Der magische Marienkaefer von Clementine");
  SetProp(P_LONG, 
	  BS("Das ist der magische Marienkaefer von Clementine. Man kann ihn sich "
	     "anstecken/anziehen."));
  SetProp(P_NAME, "Marienkaefer");
  SetProp(P_NAME_ADJ, "magisch");
  SetProp(P_GENDER, MALE);
  
  SetProp (P_MATERIAL, ([MAT_GOLD:20, MAT_MAGIC:80]));
}

init()
{
  object pl;

  ::init();
  
  if(pl=ENV(ME))
    if(interactive(pl))
      if(getuid(pl)!="clementine")
	{
	  tell_object(pl, "Der Marienkaefer winkt Dir zu und fliegt weg...\n");
	  call_out("remove",0);
	}
}
