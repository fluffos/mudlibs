/*

  Raabs Uransteinamulett

*/

#include "privat.h" 
 
inherit PRIVDIR "std_light_obj"; 

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"amulett","uranamulett","uransteinamulett"}));
  SetProp(P_SHORT, "Raabs leuchtendes Uransteinamulett");
  SetProp(P_LONG, BS(
    "Das ist Raabs leuchtendes Uransteinamulett. Es besteht aus einem der seltesten, "
    "aber auch gefaehrlichsten Materialien ueberhaupt, aus Uran. Das Uran befindet "
    "sich in einem magischen Glasbehaelter, sodass dem Traeger dieses Amulettes kein "
    "Schaden widerfahren kann. Das ganze haengt an einer feinen, jedoch solide "
    "gearbeiteten Goldkette."));
  
  SetProp(P_NAME, "Uransteinamulett");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "leuchtend");
 
  SetProp(P_MATERIAL, ([MAT_GOLD:50, MAT_MISC_MAGIC:20, MAT_GLASS:20, MAT_DUST:10]));
}
