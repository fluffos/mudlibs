/*
  
Leas Korsett

*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

nosave int ok;
nosave string last;

create() 
{
  if(!is_clone(TO)) return;
  ::create();

  AddId(({"PRIVATE_OBJ","korsett"}));
  SetProp(P_SHORT, "Ein samtenes Korsett");
  SetProp(P_NAME, "Korsett");
  SetProp(P_NAME_ADJ, "samten");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_VELVET:90,MAT_STEEL:5,MAT_SILVER:5]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_WORN_TEXT, "umgeschnuert");
  AddCmd(({"trage","trag"}), "noselfon");
  AddCmd(({"schnuere","schnuer"}),"schnueren");
  ok=0;
}

long()
{
  string str;
  int worn;
  
  worn=QueryProp(P_WORN);
  str="Ein samtenes, kostbar aussehendes Korsett in schwarz und lila "+
    "gehalten und mit Stahlstreben verstaerkt. Vorne befinden sich ein "+
    "paar Knoepfe aus purem Silber und hinten eine feste Schnur mit "+
    "mehreren silbernen Oesen, um das Korsett richtig zuschnueren zu "+
    "koennen und der Traegerin eine Wespentaille zu bescheren.\n";
  if(!worn&&TP&&(TP->QueryProp(P_GENDER)==FEMALE))
    str+="Am liebsten wuerdest Du es sofort anziehen, aber alleine wirst "+
      "Du es wohl nicht schaffen, das Korsett zuzuschnueren.\n";
  if(QueryProp(P_WORN)&&last)
    str+="Es wurde Dir von "+CAP(last)+" angelegt und zugeschnuert.\n";
  SetProp(P_LONG, str);
  return ::long();
}
 
int WearFunc(string str)
{
  if(ok) return 1;
  else
    return write("Du bist zu ungeschickt, um es Dir alleine anzuziehen. "+
		 "Lass es Dir doch von jemandem umschnueren!\n"),0;
}

int RemoveFunc(object me)
{
  write("Du ziehst an einer Schnur und sofort loest sich das Korsett ab.\n");
  return 1;
}

string extra_look()
{
  return "Ein eng geschnuertes Korsett ziert ihren Koerper.\n"+
    (last ? CAP(last)+" hat es ihr umgeschnuert":"")+"\n";
}

schnueren(string str)
{
  object pl,kor,tp;
  string who;
  
  notify_fail("Was willst Du denn wem umschnueren?\n");
  if(!str) return 0;

  if(sscanf(str, "%s korsett um", who)!=1) return 0;
  
  who=lower_case(who);

  if(!who=="lea") return write("Dieses Korsett ist nur fuer Lea reserviert!\n"),1;

  tp=TP;

  if(!pl=find_player(who))
    return write("Aber Lea ist doch gar nicht da!\n"),1;
  if(ENV(pl)!=ENV(tp))
    return write("Lea sollte wenigstens hier bei Dir stehen!\n"),1;

  if(ME->move(pl,M_GIVE)==ME_TOO_HEAVY)
    return write("Lea kann das nicht mehr tragen!\n"),1;

  if(kor=present("korsett",pl))
    if(kor->QueryProp(P_WORN)==pl)
      return write("Lea traegt bereits ein Korsett!.\n"),1;

  ok=1;
  ME->DoWear(1);
  ok=0;
  
  write("Du schnuerst Lea mit allergroesster Sorgfalt das Korsett um und "+
	"ziehst es fest an, sodass sie eine schoene Taille bekommt.\n");
  
  tell_object(pl, CAP(getuid(tp))+" schnuert Dir mit aller Kraft ein "+
	      "Korsett um, sodass Dir kurze Zeit die Luft wegbleibt.\n");
  last=getuid(tp);
  return 1;
}

