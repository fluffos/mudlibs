/*
  
  Rockwusel von Torgrimm,
  Objekt, dass er bei sich traegt
  
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

#define PRIVDIR "/d/dschungel/dante/private_obj/std_items/"

nosave string owner;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  AddId(({"PRIVATE_OBJ","wusel","rockwusel","\nprivaterrockwusel_drinnen"}));
  SetProp(P_SHORT, "Ein kleiner Rockwusel haelt sich an Dir fest");
  SetProp(P_LONG,
	  BS("Ein kleiner, schwarzer Rockwusel mit einer Gitarre haelt sich "
	     "an Dir fest. Sein tiefschwarzes Fell ist mit einem in "
	     "rot-orange-gelben Flammen stehenden Totenkopf am Ruecken "
	     "geschmueckt. Ein Nietenhalsband laesst ihn zusaetzlich noch "
	     "sehr gefaehrlich aussehen."));
  SetProp(P_INFO, 
	  BS("Du kannst den Rockwusel mit 'rockwusel' absetzen, bzw wieder "
	     "aufnehmen. Du kannst ihn auch dazu bringen, 'musik' zu machen."));

  SetProp(P_NAME, "Rockwusel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective(({"klein","kleiner","kleine","kleinen"}));

  SetProp(P_GENDER, MALE);

  AddDetail(({"fell","rockfell"}),
	    "Der Rockwusel hat ein tiefschwarzes Fell, ein Nietenhalsband "
	    "und eine gezueckte Gitarre.");
  AddDetail(({"halsband","nietenhalsband"}),
	    "Das Nietenhalsband laesst den Rockwusel gemein aussehen.");
  AddDetail(({"gitarre"}),
	    "Eine rockwuselgrosse Rockgitarre haelt der Rockwusel in "
	    "seinen Haenden und laermt damit andauernd herum.");

  SetProp(P_MATERIAL, ([MAT_HAIR:90,MAT_MISC_LIVING:10]));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd(({"rockwusel"}), "rockwusel");
  AddCmd(({"musik"}), "musik");

  owner="torgrimm";
}

void zurueck()
{
  SetProp(P_INVIS, 0);
}

nosave musik(string str)
{
  if(getuid(TP)!=owner)
    return write("Das darf nur "+CAP(owner)+" dem Rockwusel befehlen!\n"),1;
  
  write("Du zwinkerst dem Rockwusel zu.\n"
	"Der Rockwusel grinst Dich an und haut in die Saiten seiner "
	"Gitarre...\nEin fetziger Rocksong dringt an Dein Ohr.\n"
	"Der Rockwusel kann wirklich gut spielen!!\n"+
	(sizeof(all_inventory(ENV(TP))) > 2 ? "Alle applaudieren dem "
	 "Rockwusel zu.\n":"Schade nur, dass es kein anderer hoeren kann.\n"));
  say(BS(CAP(owner)+" zwinkert dem Rockwusel zu, worauf dieser anfaengt, "
	 "kraeftig in die Saiten seiner Gitarre zu hauen...")+
      "Der Rockwusel ist wirklich gut!!\n"
      "Du gratulierst "+CAP(owner)+" zu dem Rockwusel.\n", ({TP}));
  return 1;
}

nosave rockwusel(string str)
{
  object wusel;

  if(!ENV(TP)) return 1;
  
  if(QueryProp(P_INVIS))
    {
      if(wusel=present("\nprivaterrockwusel_draussen", ENV(TP)))
	{
	  write("Du rufst deinen Rockwusel zurueck...\n"
		"Er rennt los, springt hoch und landet auf Deiner Schulter.\n");
	  say(CAP(owner)+" pfeift seinen Rockwusel zurueck.\n",({TP}));
	  wusel->remove(1);
	}
      zurueck();
    }
  else
    {
      write("Du setzt den Rockwusel ab...\n"
	    "Der Rockwusel quietscht vergnuegt.\n");
      say(CAP(owner)+" setzt seinen Rockwusel ab...\n"
	  "Der Rockwusel quietscht vergnuegt.\n");
      wusel=clone_object(PRIVDIR "torgrimmrockwusel");
      wusel->move(ENV(TP), M_NOCHECK|M_SILENT);
      SetProp(P_INVIS, 1);
    }
  return 1;
}

string extra_look()
{
  if(QueryProp(P_INVIS))
    return "";
  else
    return BS(CAP(owner)+" hat einen Rockwusel an sich haengen.");
}

void BecomesNetDead(object spieler)
{
  if(getuid(spieler)==owner && QueryProp(P_INVIS))
    rockwusel();
}
