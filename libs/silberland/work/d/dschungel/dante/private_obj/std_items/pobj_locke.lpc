/*

  lockes locke:-) dante sl 2000

*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"


create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"PRIVATE_OBJ","lockenwickler","wickler"}));
  SetProp(P_SHORT, "Der Lockenwickler von Locke");
  SetProp(P_LONG, BS(
    "Das ist der Lockenwickler von Locke. Er besteht aus reinem Gold und "
    "hat eine schwarze Schleife. Sieht extrem scharf aus und Locke "+
    "gefaellts eben so!"));
  
  SetProp(P_NAME, "Lockenwickler");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100000);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 
  SetProp(P_MATERIAL, ([MAT_GOLD:20, MAT_COTTON:80]));
  SP(P_NOSELL, 1);
  SP(P_NOBUY, 1);
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
  
  SetProp(P_WEAR_FUNC, TO);

  SP(P_INFO, BS(
    "Lockes Lockenwickler sieht extrem geil aus!"));

}

string extra_look()
{
  return BS(CAP(ENV(TO)->QueryPronoun(WER))+
    " traegt einen goldenen Lockenwickler mit schwarzer Schleife! \n"
    "UH! Sieht das scharf aus!\n");
}
  
int WearFunc(object me)
{
  write(BS("Du steckst Dir Deinen goldenen Lockenwickler ins Haar!"));
  say(BS(CAP(getuid(PL))+" steckt sich Lockes Lockenwickler ins Haar! "+
    "Sieht toal scharf aus!"));
  return 1; 
}

 