/*
  
  Fellwusel von Arkyns, 
  Objekt, dass er bei sich traegt
  
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

#define PRIVDIR "/d/dschungel/dante/private_obj/std_items/"

nosave string owner;

create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  AddId(({"PRIVATE_OBJ","wusel","fellwusel","\nprivaterfellwusel_drinnen"}));
  SetProp(P_SHORT, "Ein kleiner Fellwusel haelt sich an Dir fest");
  SetProp(P_LONG,
	  BS("Ein suesser, kleiner Fellwusel haelt sich an Dir fest. "
	     "Sein dunkelblaues Fell, das mit schwarzen Flecken uebersaeht "
	     "ist, ist total zerzaust vom andauernden verwuscheln."));
  SetProp(P_INFO, 
	  BS("Du kannst den Fellwusel mit 'fellwusel' absetzen, bzw wieder "
	     "aufnehmen."));

  SetProp(P_NAME, "Fellwusel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective(({"klein","kleiner","kleine","kleinen"}));

  SetProp(P_GENDER, MALE);

  AddDetail(({"fell","wuselfell"}),
	    "Der Fellwusel hat ein dunkelblaues Fell mit schwarzen Flecken.");
  AddDetail(({"fleck","flecken"}),
	    "Lauter runde, schwarze Flecken, fast koennte man meinen, der "
	    "Fellwusel aehnelt einem Fussball...");
  AddDetail(({"fussball","ball"}),
	    "Nieee wuerdest Du das denken!\n");

  SetProp(P_MATERIAL, ([MAT_HAIR:90,MAT_MISC_LIVING:10]));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd(({"fellwusel"}), "fellwusel");
  owner="arkyns";
}

zurueck()
{
  SetProp(P_INVIS, 0);
}

nosave fellwusel(string str)
{
  object wusel;

  if(!ENV(TP)) return 1;
  
  if(QueryProp(P_INVIS))
    {
      if(wusel=present("\nprivaterfellwusel_draussen", ENV(TP)))
	{
	  write("Du rufst deinen Fellwusel zurueck...\n"
		"Er rennt los, springt hoch und landet auf Deiner Schulter.\n");
	  say(CAP(owner)+" pfeift seinen Fellwusel zurueck.\n",({TP}));
	  wusel->remove(1);
	}
      zurueck();
    }
  else
    {
      write("Du setzt den Fellwusel ab...\n"
	    "Der Fellwusel quietscht vergnuegt.\n");
      say(CAP(owner)+" setzt seinen Fellwusel ab...\n"
	  "Der Fellwusel quietscht vergnuegt.\n");
      wusel=clone_object(PRIVDIR "arkynsfellwusel");
      wusel->move(ENV(TP), M_NOCHECK|M_SILENT);
      SetProp(P_INVIS, 1);
    }
  return 1;
}

string extra_look()
{
  if(QueryProp(P_INVIS))
    return "";
  else
    return BS(CAP(owner)+" hat einen Fellwusel an sich haengen.");
}

void BecomesNetDead(object spieler)
{
  if(getuid(spieler)==owner && QueryProp(P_INVIS))
    fellwusel();
}
