/*

  seriss killitem:-))
  dante 2000

*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

int kills=3;
int kill=0;

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"PRIVATE_OBJ","daemonenschaedel","helm", "schaedel"}));
  SetProp(P_SHORT, "Der Daemonenschaedel von Serii");
  SetProp(P_LONG, BS(
    "Das ist ein extrem grausiger Daemonenschaedel, den Dante aus einer seiner "
    "unzaehligen Reisen ins Land der Daemonen mitgebracht hat. Nun gehoert "
    "er aber Serii, und was der damit tut, oder was der Schaedel mit ihm tut, "
    "weiss keiner so genau. Zieh ihn an und tippe <krepier>."));
     
  SetProp(P_NAME, "Daemonenschaedel");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "ekelerregend");
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100000);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 0);
  SP(P_NOSELL, 1);
  SP(P_NOBUY, 1);
  
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:20, MAT_BONE:80]));

  SP(P_KILL_NAME, "Ein grausiger Daemonenschaedel");
  SP(P_KILL_MSG, "Dante, wie befohlen habe ich den Kopf wie eine faule Birne zerquetscht!\n");


  SP(P_INFO, BS(
    "Der Daemonenschaedel ist eine Art Helm, aber huete Dich vor ihm. "
    "Mit <schaedel an/aus> kannst Du eine Vorrichtung betaetigen."));

  ACD(({"schaedel"}), "fun_schaedel");
  ACD(({"krepier"}), "stirb_fun"); 
}
   
int fun_schaedel(string str)
{
  NF("Was willst Du mit dem Schaedel machen?! <schaedel an/aus>\n");
  if(str=="an")  
    {
      if(kill)
        return write(BS("Die Vorrichtung ist bereits auf 'an'!")),1;
       
      if(!kill)
        {
          write(BS(
          "Du stellst die Vorrichtung auf 'an'. Ob das schlau ist?! "
          "Du glaubst, den Schaedel lachen gehoert zu haben!"));
          kill=1;
          return 1;
        }
       
      return 0; 
    }
           
  if(str=="aus")
    {
      if(kill)
        {
          write(BS("Du stellst die Vorrichtung auf 'aus'!"));
          kill=0;
          return 1; 
        }
       
      if(!kill)
        return write(BS("Die Vorrichtung ist bereits auf 'aus'.")),1;
       
      return 0;
    }
        
  return 0; 
}

string extra_look()
{
  return CAP(ENV(TO)->QueryPronoun(WER))+" traegt einen extrem ekelerregenden "+
    "Daemonenschaedel als Helm!\n";
}

int WearFunc(object me)
{
  write(BS("Du steckst Deinen Kopf in den ekligen Daemonenschaedel!"));
  say(BS(CAP(getuid(PL))+" steckt den Kopf in einen extrem ekligen Daemonenschaedel!"));
  return 1; 
}

reset()
{
  ::reset();
  kills=3;
}

int stirb_fun()
{
  NF("Irgendetwas funktioniert mit dem Sterben nicht so ganz!\n");
    
  if(kill==0) return 0;
  if(kills==0) return 0;
  if(QueryWorn()!=TP) return 0;
  if(TP->QP(P_GHOST)) return 0;
    
  write(BS(
    "Der Daemonenschaedel zieht sich ploetzlich ruckartig zusammen und "
    "zerquetscht Deinen Schaedel wie eine faule Birne! Sterbend hoerst Du noch "
    "wie sich saemtliche Untoten dieser Welt freuen und bruellen!!! Du stirbst!"));
    
  tell_room(environment(TP),
    "Der Daemonenschaedel von "+TP->name(WEM)+" zieht sich ploetzlich "
    "zusammen und zerquetscht den Kopf von "+TP->name(WER)+" wie eine "
    "faule Birne! Saemtliche Untoten dieser Welt bruellen: JAAAA!!! Unser "
    "Meister hat gesiegt! "+TP->name(WER)+" stirbt einen furchtbaren Tod!\n", 
    ({TP}));
    
  kills--;
  TP->die();
  return 1;
}

