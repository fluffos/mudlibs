/*

  dante sl obj fuer sailorzahn

*/

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine alte Ketchupflasche");
  SetProp(P_LONG, BS(
    "Das ist Sailorzahns alte Ketchupflasche. Fast so alt wie er selbst. "
    "Mit <rotfront text> kannst Du jeden Drider zum emoten bringen! "
    "Aber beklecker Dich nur selbst nicht..."));

  AddId(({"ketchupflasche", "flasche", "ketchup", "PRIVATE_OBJ"}));
  SetProp(P_NAME,"Ketchupflasche");
  SP(P_NAME_ADJ, "alt");
  SetProp(P_GENDER,FEMALE);
  SP(P_INFO, "Der Hebel hat sicher Sinn!");
  SP(P_MATERIAL, ([MAT_GLASS: 100 ]));
  SetProp(P_WEIGHT,0);
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
  AddDetail(({"hebel"}), 
    "Irgendeinen Sinn hat er sicher! Dante wuerde es doch sonst nicht "+
    "proggen, oder etwa doch?\n");
  AddDetail(({"sinn","dante","unsinn"}),
    "Alles was Dante proggt macht einen Sinn.\n");
  ACD(({"rotfront"}), "do_drider");
}

int do_drider(string str)
{
  NF("Was soll denn der doofe Drider machen?! Dir etwa die Haare abschneiden?!\n");
  if(!str) return 0;

  if(!present("drider", environment(TP)))
    {
      write(BS("Du spritzt Dich selbst mit Ketchup voll! Fein! Wie gehabt!"));
      say(BS(CAP(getuid(PL))+" zueckt eine Ketchupflasche und spritzt sich "+
        "selbst damit voll! Lecker!"));
      return 1; 
    }
  else 
    {
      write(BS("Du zueckst die Ketchupflasche und spritzt den Drider voll. "+
        "Mit Ketchup!"));
      say(BS(CAP(getuid(PL))+" zueckt eine Ketchupflasche und spritzt dann "+
        "den Drider voller Ketchup!"));

      str=this_player()->_unparsed_args();
   
      tell_room(environment(this_player()),
        break_string(str,78,"Der Drider sagt: "),({TP}));           
   
      tell_object(TP, break_string(str,78,"Der Drider sagt: "));                   
 
      return 1; 
    }
  return 0;
}
