/*
  Torgrimms Rockwusel,
  NPC-Version
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

nosave string owner;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  owner="torgrimm";

  AddId(({"PRIVATE_OBJ","wusel","rockwusel","\nprivaterrockwusel_draussen"}));
  
  SetProp(P_SHORT, "Der kleine Rockwusel von "+CAP(owner));
  SetProp(P_LONG,
	  BS("Ein kleiner Rockwusel macht hier Laerm mit seiner Gitarre. "
	     "Sein tiefschwarzes Fell laesst ihn wie einen Schatten "
	     "erscheinen, nur der in rot-orange-gelben Flammen stehende "
	     "Totenkopf am Ruecken und das Nietenhalsband unterscheiden "
	     "ihn von einem freilebenden Wusel."));
  
  SetProp(P_NAME, "Rockwusel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective(({"klein","kleiner","kleine","kleinen"}));

  SetProp(P_GENDER, MALE);

  SetProp(P_MATERIAL, ([MAT_HAIR:90,MAT_MISC_LIVING:10]));
  SetProp(P_WEIGHT, 0);

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:80]));
  
  create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinen haarigen Haendchen",
		       QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, 10);
  SetProp(P_BODY, 1);
  SetProp(P_XP, 0);
  SetProp(P_RACE, "Wusel");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 90);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_NOMAGIC, 100);

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  
	  " stirbt und alles was uebrig bleibt, ist ein Haarhaufen.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NOATTACK, 1);

  AddDetail(({"fell","rockfell"}),
	    "Der Rockwusel hat ein tiefschwarzes Fell, ein Nietenhalsband "
	    "und eine gezueckte Gitarre.");
  AddDetail(({"halsband","nietenhalsband"}),
	    "Das Nietenhalsband laesst den Rockwusel gemein aussehen.");
  AddDetail(({"gitarre"}),
	    "Eine rockwuselgrosse Rockgitarre haelt der Rockwusel in "
	    "seinen Haenden und laermt damit andauernd herum.");

  AddInfo(DEFAULT_INFO, ({
    "huepft um Dich herum.\n",
      "laechelt Dich an.\n",
      "grinst Dich an.\n",
      "spielt nur auf seiner Gitarre rum.\n",
      "murmelt irgendwas unverstaendliches.\n"}));

  AddInfo(({"herrchen",owner}),
	  "murmelt: "+CAP(owner)+" ist mein Herrchen!");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP,"Der Rockwusel kann nichts tragen.\n"}));
  
  SetChats(3, ({
    "Der Rockwusel wuselt um Dich herum.\n",
      "Der Rockwusel schnueffelt an Deinem rechten Bein.\n",
      "Der Rockwusel schnueffelt an Deinem rechten Bein.\n",
      "Der Rockwusel kuschelt sich an Dich an.\n",
      "Der Rockwusel guggt ganz Dich lieb an.\n",
      "Der Rockwusel spielt ein Lied auf seiner Gitarre.\n",
      "Der Rockwusel scheint Dich zu moegen.\n",
      "Der Rockwusel huepft um Dich herum.\n",
      "Der Rockwusel schmiegt sich an Dein Bein.\n",
      "Der Rockwusel laechelt Dich treuherzig an.\n"}));
 
  AddCmd("musik","musik");

  SUID;
}

nosave musik(string str)
{
  if(getuid(TP)!=owner)
    return write("Das darf nur "+CAP(owner)+" dem Rockwusel befehlen!\n"),1;
  
  write("Du zwinkerst dem Rockwusel zu.\n"
	"Der Rockwusel grinst Dich an und haut in die Saiten seiner "
	"Gitarre...\nEin fetziger Rocksong dringt an Dein Ohr.\n"
	"Der Rockwusel kann wirklich gut spielen!!\n"+
	(sizeof(all_inventory(ENV(TP))) > 2 ? "Alle applaudieren dem "
	 "Rockwusel zu.\n":"Schade nur, dass es kein anderer hoeren kann.\n"));
  say(BS(CAP(owner)+" zwinkert dem Rockwusel zu, worauf dieser anfaengt, "
	 "kraeftig in die Saiten seiner Gitarre zu hauen...")+
      "Der Rockwusel ist wirklich gut!!\n"
      "Du gratulierst "+CAP(owner)+" zu dem Rockwusel.\n", ({TP}));
  return 1;
}

long()
{
  return QueryProp(P_LONG);
}

init()
{
  object pl;

  ::init();
  
  if(pl=find_player(owner)) 
    if(pointerp(QueryProp(P_PURSUERS)) &&
       sizeof(QueryProp(P_PURSUERS)) &&
       objectp(QueryProp(P_PURSUERS)[0]) && 
       QueryProp(P_PURSUERS)[0]==pl)
      return;
    else
      pl->AddPursuer(ME);
  else
    remove(1);
}

int PreventFollow(object dest)
{
  if(!MENV) return 2;
  if(dest==MENV) return 1;
  
  tell_room(MENV, "Der Rockwusel huepft "+CAP(owner)+" hinterher.\n");
  tell_object(find_player(owner), 
	      "Der Rockwusel wuselt herein.\n"
	      "Der Rockwusel huepft Dir auf die Schulter und bleibt haengen.\n");
  catch(present("\nprivaterrockwusel_drinnen", find_player(owner))->zurueck());
  
  call_out("remove",0);
  
  return 2;
}

reset()
{
  ::reset();

  if(!find_player(owner))
    remove(1);
}

varargs int PreventLeave(object ob, mixed dest)
{
  if(query_once_interactive(ob))
    if(getuid(ob)==owner)
      {
	tell_object(ob, 
		    "Dein Rockwusel huepft Dir schnell auf die Schulter.\n");
	call_out("remove", 0);
      }
}

void BecomesNetDead(object spieler)
{
  if(getuid(spieler)==owner)
    {
      catch(present("\nprivaterrockwusel_drinnen", 
		    find_player(owner))->zurueck());
      call_out("remove", 0);
    }
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;

  if(verb[0..4]=="kraul")
    return call_out("reaction",0,TP,
		    "schnurrt zufrieden.",
		    "schnurrt "+TP->name(WEN)+" zufrieden an.");
  switch (gruppe) 
    {
    case "aengstlich":
      call_out("reaction", 0, TP, 
	       "grinst Dich an.",
	       "grinst "+TP->name(WEN)+" an.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
	       "kichert.",
	       "kichert.");
      break;

    case "fies":
    case "aergerlich":
    case "frech":
      call_out("reaction", 0, TP,
	       "zieht Dir mit seiner Gitarre eins ueber.",
	       "zieht "+TP->name(WEN)+" eins mit seiner Gitarre ueber.",2);
      break;
    case "froh":
      call_out("reaction", 0, TP,
	       "grinst Dich an.",
	       "grinst "+TP->name(WEN)+" an.");
      break;
    case "intim":
      if(random(100)<50)
	call_out("reaction", 0, TP,
		 "schmiegt sich ganz lieb an Dich an.",
		 "schmiegt sich ganz lieb an "+TP->name(WEN)+" an.");
      else
	call_out("reaction", 0, TP,
		 "freut sich und laeuft dabei rot an.",
		 "freut sich und laeuft dabei rot an.");
      break;
    case "nett":
      if(random(100)<50)
	call_out("reaction", 0, TP,
		 "verwuschelt Deine Haare.",
		 "verwuschelt "+TP->name(WESSEN)+" Haare.");
      else
	call_out("reaction", 0, TP,
		 "knuddelt Dich erfreut.",
		 "knuddelt "+TP->name(WEN)+".");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "verwuschelt Deine Haare.",
	       "verwuschelt "+TP->name(WESSEN)+" Haare.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	       "setzt sich Dir auf die Schulter und wuschelt solange Deine "
	       "Haare, bis Du grinsen musst.",
	       "verwuschelt "+TP->name(WESSEN)+" Haare ganz fest.");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere, int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS("Der Rockwusel "+macher));
      tell_room(ENV(TO), BS("Der Rockwusel "+andere), ({ob}));
      if(flag)
	if(flag==2)
	  ob->AddHp(random(3)-4);
	else
	  {
	    tell_room(MENV, 
		      BS("Der Rockwusel kehrt beleidigt zu seinem Herrchen zurueck."));
	    catch(present("\nprivaterrockwusel_drinnen", find_player(owner))->zurueck());
	    call_out("remove",0);
	}
    }
}
