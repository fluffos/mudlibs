/*
  yezas zoepfe
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

create() 
{
  if(!is_clone(TO)) return;
  ::create();

  AddId(({"PRIVATE_OBJ","zopf", "zoepfe"}));
  SetProp(P_SHORT, "Yezas rotblonde Zoepfe");
  SetProp(P_NAME, "Zoepfe");
  SetProp(P_NAME_ADJ, "rotblond");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_HAIR:100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE,  0);
  SetProp(P_SHOW_INV, 1);
  SP(P_WEAR_FUNC, TO);
  SetProp(P_WORN_TEXT, "aufm Kopf");
  SetProp(P_LONG, 
	  BS("Yezas Zoepfe sind rotblond und glitzern in der Sonne magisch. Sie "+
	     "fallen weich und geschmeidig herab und benetzen ihre Schultern wie "+
	     "der Tau das jungfraeuliche Gras am Morgen. Ihr liebliches Gesicht "+
	     "wird durch sie noch schoener und die Zoepfe umrahmen es wie ein "+
	     "seidener Vorhang am Fenster eine wundervolle Landschaft umrahmt. "+
	     "Du kannst an den Zoepfen ziehen!"));
  
  ACD(({"ziehe","zieh"}), "pull");
}

int WearFunc(object me)
{
  if(TP && getuid(TP)=="yeza")
    return 1;   
  
  return write(BS("Yezas Zoepfe lachen Dich nur aus! Du Wurst!")),0;
}

nosave int pull(string str)  
{
  int i;
  object *inv;

  if(str=="am zopf"||str=="zopf"||str=="an zoepfen"||str=="an zoepfen")  
    {
      
      if(getuid(TP)!="yeza")
	return write(BS("Dir gehoeren diese Zoepfe nicht! Die Zoepfe hauen "+
			"Dir eines ueber den Mund!")),1;
  	
      if(!QueryWorn(TO))
	return write(BS("Du musst Deine Zoepfe schon 'anziehen'!")),1;
  	
      write(BS("Du ziehst an Deinen Zoepfen."));
      say(BS(CAP_TPN+" zieht an ihren Zoepfen!"));
  
      inv=all_inventory(environment(TP));
      
      if(!sizeof(inv))
	return write(BS("Leider ist keiner da zum Beeindrucken!")),1;
  
  
      for(i=0 ;i<sizeof(inv); i++) 
	if(living(inv[i]) && getuid(inv[i])!=getuid(TP))
	  {
	    if(!inv[i]->QueryProp(P_INVIS))
	      write(BS("Du beeindruckst "+inv[i]->name(WEN)+
		       " mit Deinen Zoepfen!"));
	    tell_object(inv[i],
			CAP_TPN+" beeindruckt Dich sehr mit ihren Zoepfen!\n");	
	  }
      tell_room(environment(TP),
		"Alle sind schwer von Yezas Zoepfen beeindruckt!\n", ({TP}));
      return 1;
    }
  return 0;
}	

string extra_look()
{
  return "Lange rotblonde Zoepfe umrahmen ihr liebliches Gesicht und fallen "+
    "dann weiter nach unten auf ihren lieblichen Koerper.\n";
  
}
