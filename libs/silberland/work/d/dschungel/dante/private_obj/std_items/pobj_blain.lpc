/*

  Blains Ein-Mann-zusammenklappbares-Fitnesscenter

*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"


create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"PRIVATE_OBJ","fitnesscenter","kraftkammer"}));
  SetProp(P_SHORT, "Eine Ein-Mann-Kraftkammer zum Aufklappen");
  SetProp(P_LONG, 
	  BS("Das ist die 'FC 900', die im Moment modernste "
	     "Ein-Oger-Kraftkammer zum Aufklappen, die man bekommen kann. "
	     "Das Geraet strotzt nur so vor Haken und Oesen, an denen "
	     "man seine Muskeln staerken kann."));
  
  SetProp(P_NAME, "FC 900");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "supermodern");
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100000);
 
  SetProp(P_MATERIAL, ([MAT_IRON:80, MAT_PLASTIC:20]));
  SP(P_NOSELL, 1);
  SP(P_NOBUY, 1);
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
  
  SP(P_INFO, 
     BS("Mit 'turne' kannst Du die 'FC 900' benutzen, um Deine Muskeln "
	"zu staehlen!"));

  AddCmd(({"turne","turnen"}), "turnen");
}

string extra_look()
{
  return BS(CAP(ENV(TO)->QueryPronoun(WESSEN))+
	    " Haengebauch ist durch das Training mit einer 'FC 900' "
	    "fast gaenzlich verschwunden.");
}

nosave turnen(string str)
{
  string what;

  what=({"ein paar Klimmzuege","ein paar Bizepscurls",
	   "ein paar Deltamuskelcurls","ein paar Trizepsbeugen",
	   "Brustmuskeltraining","Bauchmuskeltraining",
	   "ein paar Kniebeugen","ein paar Liegestuetze"})[random(8)];
  return 1;
}
