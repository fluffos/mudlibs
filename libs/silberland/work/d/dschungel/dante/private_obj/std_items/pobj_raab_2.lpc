//raabs autogramkarten

inherit "std/thing";
#include <properties.h>     // Properties definieren
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>
#include <moving.h>

#define MAX 20

int karten=0;

reset()  {
	::reset();
	karten=0;
  }	



create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Autogrammkarte");
SetProp (P_GENDER, FEMALE);
SetProp (P_VALUE, 0);
SetProp (P_WEIGHT, 0);
SetProp(P_SIZE, 10);

AddId(({"autogrammkarte","karte"}));

SP(P_SHORT, "Die magische Autogrammkarte von Stefan Raab");
SP(P_LONG,BS(
	  "Das ist Deine magische Autogrammkarte. Mit 'autogramm name' "
	  "kannst Du sie fuer einen anderen Spieler oder Magier unterschreiben "
	  "und sie ihm automatisch ueberreichen. Er muss allerdings in Deiner "
	  "Naehe sein!"));
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
SP(P_MAGIC, 1);	  
          
SetProp (P_MATERIAL, ([ MAT_PAPER:100]));

ACD(({"autogramm"}), "autogramm");
}


	   
	


int autogramm(string str)  {
	object ob, get;
	NF("Wem willst Du das Autogramm geben?!\n");

  if( getuid(TP)!="dante" &&
      getuid(TP)!="raab"  )  {
   	
   	write(BS(
   	"Wie bitte? Das geht leider nicht..."));
   	return 1;  }
   	


if(!str)  { return 0;  }




     
      if(!ob=present(str,environment(TP)))
        {
        write(CAP(str)+" ist doch nicht hier!\n");
        return 1;
        }
     
      if (!interactive(ob))
        {
        write("Nein! Das geht leider nicht!\n");
        
        return 1;
       }


if(ob->QP(P_GHOST) )  {
	write("Nein! "+(capitalize(str))+" ist leider ein Geist!\n");
        return 1;
  }


	
if(karten > MAX )   {
	write(BS(
	"Du hast schon zu viele Karten verteilt. Warte ein wenig!"));
	return 1;  }

if(getuid(TP)==getuid(ob) )  {
	write(BS(
	"Nein, so doof bist nicht einmal DU!"));
	return 1;
}


if(deep_present("autogrammraab", ob ))  {
	write(BS(
	"Sorry, aber "+CAP(str)+" hat schon eine Karte!"));
	return 1;  }
	
		
	   else

        {
        
        get=clone_object("/d/dschungel/dante/weg/obj/kraab");
        get->move(ob, M_NOCHECK);
      get-> SP(P_NODROP, 0);
     get-> SP(P_NEVERDROP, 0);
       get->SP(P_MAGIC, 0);	  
 
 get->SetProp(P_SHORT, "Eine Autogrammkarte von Stefan Raab fuer "+CAP(getuid(ob))+"");
  
 get->SP(P_LONG, BS(
 "Das ist eine Autogrammkarte von Stefan Raab fuer "+CAP(getuid(ob))+"! Sie besitzt eine "
 "originale Unterschrift von Stefan Raab und wurde nur "+CAP(getuid(ob))+" gewidmet! "
 "Sie muss wahrlich Millionen wert sein! Du bist froh und gluecklich "
 "darueber, dass Du soetwas Grossartiges besitzen darfst!"));

   get->RemoveCmd(({"autogramm"}), "autogramm");

 
 
                   
        write(BS(
"Du laesst Dich herab und schreibst eine Autogrammkarte nur fuer "+(capitalize(str))+"! "
"Dein Showpraktikant Elton laeuft herein, kniet sich nieder und Du schreibst "
"die Karte schnell auf seinen Ruecken. Elton kriecht dann zu "+(capitalize(str))+" "
"und ueberreicht "+(capitalize(str))+" die Karte. "
"Dann laeuft Elton wieder davon."));


tell_object(ob, BS(
"Raab laesst sich herab und schreibt eine Autogrammkarte nur fuer Dich! "
"Sein Showpraktikant Elton laeuft herein, kniet sich nieder und Raab schreibt "
"die Karte schnell auf seinen Ruecken. Elton kriecht dann zu Dir "
"und ueberreicht Dir die Karte. "
"Dann laeuft Elton wieder davon und Du bist gluecklich und dankbar!"));

tell_room(environment(TP), BS(
"Rabb laesst sich herab und schreibt eine Autogrammkarte nur fuer "+(capitalize(str))+"! "
"Sein Showpraktikant Elton laeuft herein, kniet sich nieder und Raab schreibt "
"die Karte schnell auf seinen Ruecken. Elton kriecht dann zu "+(capitalize(str))+" "
"und ueberreicht "+(capitalize(str))+" die Karte. "+(capitalize(str))+" freut "
"sich und ist uebergluecklich! "
"Dann laeuft Elton wieder davon."), ({TP, ob}));
             
             
karten++;
        return 1;
        }
return 0;
      }


