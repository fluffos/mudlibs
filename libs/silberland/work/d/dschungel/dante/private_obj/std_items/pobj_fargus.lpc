/*

  Fargus' Baerenzahnkette

*/

#include "/players/protheg/def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Baerenzahnkette");
  SetProp(P_LONG,
	  BS("In Deinen Haenden haelst Du eine kleine Goldkette, an der einige "+
	     "Baerenzaehne befestigt sind. Der verwegene Held Fargus hat mit seiner "+
	     "Axt allein zehn Baeren getoetet und je den schoensten Eckzahn an "+
	     "dieser Kette befestigt.")+"Moege Dir dieser Gluecksbringer hold sein!");
  SetProp(P_INFO, 
	  BS("Diese Kette ist ein wertvoller Gluecksbringer. Halte sie stets in "+
	     "Ehren!"));
  SetProp(P_NAME, "Baerenzahnkette");
  SetProp(P_GENDER, FEMALE);

  AddId(({"kette", "zahnkette", "baerenzahnkette","PRIVATE_OBJ"}));

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC,0);
  SetProp(P_MATERIAL, ([ MAT_GOLD:10, MAT_IVORY:89, MAT_BLOOD:1]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 700);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddDetail(({"gold","goldkette"}),
	    "Eine hervorragend gearbeitete Goldkette. Die muss wohl ein Zwerg "+
	    "gefertigt haben, so wunderbar ist sie.\n");
  AddDetail(({"zahn","zaehne","baerenzahn","baerenzaehne","eckzahn","baereneckzahn"}),
	    "Zehn praechtige Baerenzaehne prangen an der kleinen Goldkette.\n");
  AddDetail(({"glueck","gluecksbringer"}),
	    "Moegen Dir die Baerenzaehne Glueck bringen!\n");
}

QueryProp(string prop) 
{
  if(prop==P_SHORT && environment() && TP && MENV!=TP)
    if(!IS_WIZARD(TP))
      if(QueryProp(P_WORN))
	{
	  tell_object(MENV, TPN+" bewundert Deine Baerenzahnkette.\n");
	  tell_object(TP, MENV->Name()+" zeigt Dir stolz "+
		      MENV->QueryPossPronoun(FEMALE,WEN)+" Baerenzahnkette.\n");
	}
  return ::QueryProp(prop); 
}
