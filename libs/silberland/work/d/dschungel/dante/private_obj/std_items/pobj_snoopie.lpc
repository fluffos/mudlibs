/*
** Ein Schlumpf fuer Snoopie 
** (original: /d/gebirge/dante/friedhof/obj/quaatsch.c)
**
** 2002-05-30  PROtheG
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

void create()
{ 
  if(!is_clone(ME)) return;
  ::create();
  
  AddId(({"schlumpf","dunkelschlumpf","PRIVATE_OBJ"}));

  SetProp(P_SHORT, "Ein suesser Dunkelschlumpf");
  SetProp(P_LONG, 
	  BS("Der Dunkelschlumpf ist eine kleine dunkelschlumpfige "
	     "Plueschfigur mit einer knallgelben Schlumpfmuetze. "
	     "Aus grossen Augen schaut er Dich an, Dein kleiner "
	     "Dunkelschlumpf! Er moechte unbedingt lieb gehabt werden!"));

  SetProp(P_INFO,
	  BS("Er moechte unbedingt lieb gehabt werden!"));
  
  SetProp(P_NAME, "Schlumpf");
  SetProp(P_NAME_ADJ, ({"dunkelschlumpfig"}));
  AddAdjective(({"dunkelblau","dunkelblauer","dunkelblauen",
		   "dunkelschlumpfiger","dunkelschlumpfigen"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Nein! Deinen Dunkelschlumpf gibst Du nicht her!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  
  AddDetail(({"muetze","schlumpfmuetze"}),
	    "Der Dunkelschlumpf traegt eine knallgelbe Schlumpfmuetze.");

  AddDetail(({"augen","glubscher","glubschaugen"}),
	    "Der Dunkelschlumpf hat grosse, kreisrunde Glubschaugen, aus "
	    "denen er Dich lieb anschaut.");
  
  AddDetail(({"figur","plueschfigur"}),
	    QueryProp(P_LONG));

  AddCmd(({"kuschel", "kuschele", "kuschle"}), "kuschel_schlumpf");
  AddCmd(({"streichel", "streichele", "streichle"}), "streichel_schlumpf");
  AddCmd(({"wuschel", "wuschele", "wuschle"}), "wuschel_schlumpf");
  AddCmd(({"knuddel", "knuddele", "knuddle"}), "knuddel_schlumpf"); 
}

nosave int kuschel_schlumpf(string str)
{
  if(str && id (str)) 
    {
      write(BS("Du drueckst den suessen Dunkelschlumpf fest an Dich und "
	       "kuschelst Dich in sein schlumpfiges Fell."));
      
      say(BS(TPN+" kuschelt sich wild an "+TP->QueryPossPronoun(MALE, WEN)+
	     " kleinen Dunkelschlumpf."));
      
      return 1;
    }
  
  return 0;  
}

nosave int streichel_schlumpf (string str)
{
  if(str && id (str)) 
    {
      write(BS("Du streichelst Deinen Dunkelschlumpf ganz lieb und hast das "
	       "Gefuehl, als wuerde er Dich anlaecheln und mit seinen "
	       "grossen Glubschaugen anschlumpfen."));
      
      say(BS(TPN+" streichelt "+TP->QueryPossPronoun(MALE, WEN)+
	     " Dunkelschlumpf ganz lieb."));
      
      return 1;
    }
  
  return 0;
}

nosave int wuschel_schlumpf (string str)
{
  if(str && id (str)) 
    {
      write(BS("Du verwuschelst dem Dunkelschlumpf sein schlumpfiges Fell!")+
	    BS("Vorsicht, sonst fallen ihm die Haare aus... *g*"));
      say(BS(TPN+" verwuschelt "+TP->QueryPossPronoun(MALE, WEM)+
	     " Dunkelschlumpf sein schlumpfiges Fell."));
      
      return 1;
    }
  
  return 0;
}

nosave int knuddel_schlumpf (string str)
{
  if(str && id (str)) 
    {
      write(BS("Du nimmst den Dunkelschlumpf fest in Deine Arme und knuddelst "
	       "ihn so lange, bis er ganz flachgeknuddelt ist... *g*"));
      say(BS(TPN+" knuddelt "+TP->QueryPossPronoun(MALE, WEM)+
	     " Dunkelschlumpf so richtig durch."));

      return 1;
    }
  
  return 0;
}

string extra_look()
{
  if((MENV) && (interactive(MENV)))
    return BS(CAP(getuid(MENV))+" hat einen schlumpfigen Dunkelschlumpf "
	      "auf der Schulter sitzen.");
}
