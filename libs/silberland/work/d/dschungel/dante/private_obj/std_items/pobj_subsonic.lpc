/*

  subsonics gelbe hiphopmuetze
  
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"PRIVATE_OBJ","hiphophaube","haube"}));
  SetProp(P_SHORT, "Die knallgelbe Hiphophaube von Subsonic");
  SetProp(P_LONG, BS(
    "Das ist die knallgelbe Haube von Subsonic. Ideal zum Dubben, was immer das "
    "auch sein mag. Eigentlich ist sie ja eher kotzgelb. Sie ist konkret krass, die "
    "gelbe Hiphophaube von Subsonic."));
  SetProp(P_NAME, "Hiphophaube");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "knallgelb");
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100000);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_WOOL:100]));
  SP(P_INFO, BS(
    "Die Haube kann, wenn auch nur sehr kurz, Musik machen. "
    "<syntax: laerm>"));
 
 ACD("laerm", "laerm"); 
}

int laerm(string str)
{
  write(
  "Die Haube blaeht sich auf und Du haelst Dir die Ohren zu!\n"
  "Dann ploetzlich hoerst Du die Musik der originalfidelen SubsonicTriphopbuam.\n\n"
  "Dubb Dubb Tripp Hop Dubb, die Musik ist konkret krass, Dubb Trip Hop Hop,\n"
  "der Karli Moik ist dagegen ein Schaas, Dub Dub Trip Trip Hob...\n\n");

  say(
  "Die Haube von Subsonic blaeht sich auf und Du haelst Dir die Ohren zu!\n"
  "Dann ploetzlich hoerst Du die Musik der originalfidelen SubsonicTriphopbuam.\n\n"
  "Dubb Dubb Tripp Hop Dubb, die Musik ist konkret krass, Dubb Trip Hop Hop,\n"
  "der Karli Moik ist dagegen ein Schaas, Dub Dub Trip Trip Hob...\n\n"
  "Wahnsinn, diese originalfidelen SubsonicTriphopbuam!!!\n");
  return 1; 
}
