/*

  Kias Bauchnabelpiercing, Hochzeitsgeschenk von Cadrim 
  PROtheG, 25012002

*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
//#include "/players/dante/myowndefine.h"
#include "/players/protheg/def.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"PRIVATE_OBJ","piercing","nabelpiercing","bauchnabelpiercing",
	    "stift","titanstift"}));
  SetProp(P_SHORT, "Ein Bauchnabelpiercing");
  SetProp(P_LONG, 
	  BS("Ein wunderschoenes Bauchnabelpiercing, welches Du da traegst. "
	     "Es besteht aus einem gekruemmten Titanstift an dessen Ende ein "
	     "wunderschoen verarbeiteter, kleiner Diamant befestigt ist.")+
	  BS("Es scheint, als sei das ein magisches Bauchnabelpiercing, "
	     "fuer welches man den Nabel vorher nicht durchstechen muss."));
  
  SetProp(P_NAME, "Kia's Bauchnabelpiercing");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100000);
  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_ARTICLE, 0);

  SetProp(P_WORN_TEXT, "angesteckt");

  SetProp(P_WEAR_TEXT, 
	  ({"Du beruehrst mit dem Piercing Deinen Bauchnabel und das Piercing "
	      "beginnt mit Deinem Koerper zu verschmelzen...\n",
	      " steckt sich ein Piercing in den Bauchnabel.\n"}));

  SetProp(P_UNWEAR_TEXT, 
	  ({"Du beruehrst das Piercing und es loest sich aus Deinem "
	      "Bauchnabel...\n",
	      " nimmt ein Bauchnabelpiercing ab.\n"}));

  AddDetail(({"stift","titanstift","titan"}),
	    "Der makellos verarbeitete Titanstift ist etwa vier Centimeter "
	    "lang und hat an einem Ende eine kleine Rose, in der ein winziger "
	    "Diamant eingebettet wurde. Du erkennst leichte Kratzer an der "
	    "Rueckseite, oder sind das irgendwelche Zeichen?");
  
  AddDetail(({"ende","stiftende","titanstiftende"}),
	    "An einem Ende der Titanstiftes befindet sich eine kleine Rose. "
	    "Das andere Ende ist schmucklos.");
  
  AddDetail(({"rose","titanrose"}),
	    "Eine aeusserst filigran gearbeitete Rose aus purem Titan ziert "
	    "ein Ende des Stiftes. Ein winziger Diamant wurde bei ihr "
	    "eingesetzt.");
  
  AddDetail(({"diamant"}),
	    "Ein winziger Diamant ist in die kleine Titanrose eingelassen. "
	    "Anscheinend stellt er einen Tropfen Morgentau dar. Ein kleiner "
	    "Fleck faellt Dir auf...");
  
  AddDetail(({"fleck"}),
	    "Tatsaechlich! Ein winziger Fleck ist da auf dem Diamanten. "
	    "Wie haesslich! Vielleicht kannst Du ihn ja wegreiben.");
  
  AddDetail(({"tau","morgentau","tropfen","morgentautropfen"}),
	    "Der Diamant sitzt wie ein Tropfen Morgentau auf der kleinen "
	    "Titanrose.");

  AddDetail(({"kratzer"}),
	    "Nein, es sind keine Kratzer, doch es scheint sich wirklich um "
	    "Zeichen, wenn nicht sogar Schriftzeichen zu handeln.");
  
  AddDetail(({"zeichen","schriftzeichen"}),
	    "Eine Inschrift!");
  
  AddDetail(({"inschrift","schrift"}),
	    "Inschriften liest man...");
  
  AddReadDetail(({"schrift","inschrift"}),
		"Die Inschrift lautet: \"Fuer Kia, in ewiger Liebe Cadrim\"");
  
  SetProp(P_MATERIAL, ([MAT_TITANIUM:80, MAT_DIAMOND:10, MAT_MISC_MAGIC:10]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  SetProp(P_INFO, 
	  BS("Du kannst Dir das Bauchnabelpiercing auch anstecken, obwohl Du "
	     "kein dafuer vorgesehenes Loch in Deinem Bauchnabel hast...")+
	  BS("An der Rueckseite des Titanstiftes befinden sich ein paar "
	     "Kratzer, oder sind das irgendwelche Zeichen?"));
  
  AddCmd(({"reibe","reib","putz","putze"}), "cmd_putzen");
  
}

string extra_look()
{
  if(QueryProp(P_WORN))
    return BS(CAP(getuid(ENV(TO))+" traegt ein magisches Bauchnabelpiercing."));
  else
    return "";
}

nosave cmd_putzen(string str)
{
  notify_fail(BS("Was willst Du denn putzen?"));
  if(!str) return 0;
  
  if(str=="diamant"||str=="fleck"||str=="fleck weg")
    {
      write(BS("Du reibst etwas an dem Diamanten, aber vorsichtig, dass Du "
	       "ihn nicht beschaedigst, doch der Fleck bleibt...")+
	    BS("Als Du den Fleck naeher betrachtest, erkennst Du, dass es "
	       "kein Fleck, sondern ein eingraviertes Bild von Deinem, Dich "
	       "ueber alles liebenden Gemahl Cadrim ist!"));
      return 1;
    }

  return 0;
}
