/*

  Ademion das Holzschwert, fuer Sennah

*/

inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Das Holzschwert Ademion");
  SetProp(P_LONG, 
	  BS("In Deinen Haenden haeltst Du das Holzschwert, dass den "
	     "beruechtigten Namen 'Ademion' traegt und fuehlst Dich wie ein "
	     "kleines Kind. Seufzend betrachtest Du die kurze und schon recht "
	     "abgenutzte Klinge aus Holz, das breite Schwertheft und den "
	     "kurzen, fuer Kinderhaende gefertigten Griff. War das schoen, als "
	     "Kind damit herumzulaufen und wilde Schlachten auszufechten."));
  
  AddDetail(({"kind"}),
	    "Ach, war das damals schoen, als kleines Kind mit dem Schwert in der "
	    "Hand herumzulaufen und von grossen Abenteuern zu traeumen. Damals "
	    "wusstest Du noch nichts vom langweiligen Forschen, oder vom ewig-"
	    "tanken-rennen-muessen.\n");
  AddDetail(({"klinge","holzklinge"}),
	    "Die kurze Holzklinge hatt bereits einigen Schlaegen standhalten "
	    "muessen und sieht auch dementsprechend aus.\n");
  AddDetail(({"holz","eiche","eichenholz"}),
	    "Das Holzschwert Ademion besteht aus hervorragend verarbeitetem "
	    "Eichenholz.\n");
  AddDetail(({"heft","schwertheft"}),
	    "Das breite Schwertheft schuetzt die Finger vor schmerzhaften "
	    "Fehlschlaegen.\n");
  AddDetail(({"griff","schwertgriff","holzgriff"}),
	    "Der hoelzerne Schwertgriff ist speziell fuer kleine Kinderhaende "
	    "angepasst und wirkt daher etwas zu klein.\n");


  AddId(({"schwert","holzschwert","ademion","PRIVATE_OBJ"}));
  SetProp(P_NAME,
	  ({"Holzschwert Ademion","Holzschwertes Ademion",
	      "Holzschwert Ademion","Holzschwert Ademion"}));
  SetProp(P_INFO,
	  BS("Du kannst mit Deinem Holzchwert wild in der Gegend rumfuchteln "
	     "und alle beeindrucken."));
  SetProp(P_GENDER, NEUTER);
  SP(P_NAME_ADJ, "magisch");
  SetProp(P_VALUE, 10000);
  SetProp(P_WEIGHT, 1200);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAPON_TYPE, WT_SWORD);

  SetProp(P_DAM_TYPE, ({DT_SLASH}));

  SetProp(P_WC, 50);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OAK:100]));
  SetProp(P_HIT_FUNC, TO);

  Damage(70);
  AddCmd(({"fuchtel","fuchtle"}), "schwertfuchteln");
}

nosave schwertfuchteln(string str)
{
  notify_fail("Womit willst Du den herumfuchteln?\n");
  if(!str) return 0;
  
  str=explode(str, " herum")[0];
  
  if(str=="mit schwert"||str=="mit ademion"||
     str=="mit holzschwert"||str=="mit holzschwert ademion")
    {
      if(ME->QueryProp(P_WIELDED)!=TP)
	return write("Du solltest Ademion erstmal zuecken!\n"),1;
      write(BS("Du haelst das Holzschwert Ademion vor Dir in der Luft "
	       "und beginnst, damit wie ein Wilder in der Gegend "
	       "herumzufuchteln. Alle sind von Deinem offensichtlichen "
	       "\"Kampfstil\" schwer beeindruckt."));
      tell_room(ENV(TP),
		BS(TP->Name()+" hebt das Holzschwert Ademion in die Luft "
		   "und beginnt dann in einem seltsamen Rythmus umherzutanzen "
		   "und mit dem Schwert wild in der Gegend herumzufuchteln. "
		   "Du bist schwer beeindruckt."),({TP}));
      return 1;
    }
  return 0;
}

int HitFunc(object enemy)
{
  return -300;
}

int Damage(int i)
{
  if(i<0) 
    return 0;
  else 
    return ::Damage(i);
}

