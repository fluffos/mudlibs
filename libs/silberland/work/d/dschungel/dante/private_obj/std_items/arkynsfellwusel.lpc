/*
  Arkyns Fellwusel,
  NPC-Version
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

nosave string owner;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  owner="arkyns";

  AddId(({"PRIVATE_OBJ","wusel","fellwusel","\nprivaterfellwusel_draussen"}));
  
  SetProp(P_SHORT, "Der kleine Fellwusel von "+CAP(owner));
  SetProp(P_LONG,
	  BS("Ein suesser, kleiner Fellwusel wuselt hier herum. "
	     "Sein dunkelblaues Fell, das mit schwarzen Flecken uebersaeht "
	     "ist, ist total zerzaust vom andauernden verwuscheln."));
  
  SetProp(P_NAME, "Fellwusel");
  SetProp(P_NAME_ADJ, "klein");
  AddAdjective(({"klein","kleiner","kleine","kleinen"}));

  SetProp(P_GENDER, MALE);

  SetProp(P_MATERIAL, ([MAT_HAIR:90,MAT_MISC_LIVING:10]));
  SetProp(P_WEIGHT, 0);

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:80]));
  
  create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinen haarigen Haendchen",
		       QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, 10);
  SetProp(P_BODY, 1);
  SetProp(P_XP, 0);
  SetProp(P_RACE, "Wusel");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 90);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_NOMAGIC, 100);

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  
	  " stirbt und alles was uebrig bleibt, ist ein Haarhaufen.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_NOATTACK, 1);

  AddDetail(({"fell","wuselfell"}),
	    "Der Fellwusel hat ein dunkelblaues Fell mit schwarzen Flecken.");
  AddDetail(({"fleck","flecken"}),
	    "Lauter runde, schwarze Flecken, fast koennte man meinen, der "
	    "Fellwusel aehnelt einem Fussball...");
  AddDetail(({"fussball","ball"}),
	    "Nieee wuerdest Du das denken!\n");

  AddInfo(DEFAULT_INFO, ({
    "huepft um Dich herum.\n",
      "laechelt Dich an.\n",
      "grinst Dich lieb an.\n",
      "murmelt irgendwas unverstaendliches."}));

  AddInfo(({"herrchen","arkyns"}),
	  "murmelt: "+CAP(owner)+" ist mein Herrchen!");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP,"Der Fellwusel kann nichts tragen.\n"}));
  
  SetChats(3, ({
    "Der Fellwusel wuselt um Dich herum.\n",
      "Der Fellwusel schnueffelt an Deinem rechten Bein.\n",
      "Der Fellwusel schnueffelt an Deinem rechten Bein.\n",
      "Der Fellwusel kuschelt sich an Dich an.\n",
      "Der Fellwusel guggt ganz Dich lieb an.\n",
      "Der Fellwusel scheint Dich zu moegen.\n",
      "Der Fellwusel huepft um Dich herum.\n",
      "Der Fellwusel schmiegt sich an Dein Bein.\n",
      "Der Fellwusel laechelt Dich treuherzig an.\n"}));
  
  SUID;
}

long()
{
  return QueryProp(P_LONG);
}

init()
{
  object pl;

  ::init();
  
  if(pl=find_player(owner))
    if(pointerp(QueryProp(P_PURSUERS)) &&
       sizeof(QueryProp(P_PURSUERS)) &&
       objectp(QueryProp(P_PURSUERS)[0]) && 
       QueryProp(P_PURSUERS)[0]==pl)
      return;
    else
      pl->AddPursuer(ME);
  else
    remove(1);
}

int PreventFollow(object dest)
{
  if(!MENV) return 2;
  if(dest==MENV) return 1;

  tell_room(MENV, "Der Fellwusel huepft "+CAP(owner)+" hinterher.\n");
  tell_object(find_player(owner), 
	      "Der Fellwusel wuselt herein.\n"
	      "Der Fellwusel huepft Dir auf die Schulter und bleibt haengen.\n");
  catch(present("\nprivaterfellwusel_drinnen", find_player(owner))->zurueck());
  
  call_out("remove",0);
  
  return 2;
}

reset()
{
  ::reset();

  if(!find_player(owner))
    remove(1);
}

varargs int PreventLeave(object ob, mixed dest)
{
  if(query_once_interactive(ob))
    if(getuid(ob)==owner)
      {
	tell_object(ob, 
		    "Dein Fellwusel huepft Dir schnell auf die Schulter.\n");
	call_out("remove", 0);
      }
}

void BecomesNetDead(object spieler)
{
  if(getuid(spieler)==owner)
    {
      catch(present("\nprivaterfellwusel_drinnen", 
		    find_player(owner))->zurueck());
      call_out("remove", 0);
    }
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;

  if(verb[0..4]=="kraul")
    return call_out("reaction",0,TP,
		    "schnurrt zufrieden.",
		    "schnurrt "+TP->name(WEN)+" zufrieden an.");
  switch (gruppe) 
    {
    case "aengstlich":
      call_out("reaction", 0, TP, 
	       "grinst Dich lieb an.",
	       "grinst "+TP->name(WEN)+" lieb an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
	       "schaut Dich mit seinen grossen, lieben Kulleraugen an.",
	       "schaut "+TP->name(WEN)+
	       " mit seinen grossen, lieben Kulleraugen an.",1);
      break;
    case "albern":
      call_out("reaction", 0, TP,
	       "kichert.",
	       "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
	       "snieft Dich urtraurig an.",
	       "snieft "+TP->name(WEN)+" an.",1);
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "knurrt Dich beleidigt an.",
	       "knurrt "+TP->name(WEN)+" beleidigt an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
	       "grinst Dich an.",
	       "grinst "+TP->name(WEN)+" an.");
      break;
    case "intim":
      if(random(100)<50)
	call_out("reaction", 0, TP,
		 "schmiegt sich ganz lieb an Dich an.",
		 "schmiegt sich ganz lieb an "+TP->name(WEN)+" an.");
      else
	call_out("reaction", 0, TP,
		 "freut sich und laeuft dabei rot an.",
		 "freut sich und laeuft dabei rot an.");
      break;
    case "nett":
      if(random(100)<50)
	call_out("reaction", 0, TP,
		 "verwuschelt Deine Haare.",
		 "verwuschelt "+TP->name(WESSEN)+" Haare.");
      else
	call_out("reaction", 0, TP,
		 "knuddelt Dich erfreut.",
		 "knuddelt "+TP->name(WEN)+".");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "verwuschelt Deine Haare.",
	       "verwuschelt "+TP->name(WESSEN)+" Haare.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	       "setzt sich Dir auf die Schulter und wuschelt solange Deine "
	       "Haare, bis Du grinsen musst.",
	       "verwuschelt "+TP->name(WESSEN)+" Haare ganz fest.");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere, int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS("Der Fellwusel "+macher));
      tell_room(ENV(TO), BS("Der Fellwusel "+andere), ({ob}));
      if(flag)
	{
	  tell_room(MENV, 
		    BS("Der Fellwusel kehrt beleidigt zu seinem Herrchen zurueck."));
	  catch(present("\nprivaterfellwusel_drinnen", find_player(owner))->zurueck());
	  call_out("remove",0);
	}
    }
}
