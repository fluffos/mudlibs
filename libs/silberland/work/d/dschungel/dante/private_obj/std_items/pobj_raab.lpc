/*

  raabs axt kann nix nur so

*/

inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Todesaxt");
  SetProp(P_GENDER, FEMALE);
  SP(P_NAME_ADJ, ({"gefaehrlich","doppelblaettrig"}));
  SetProp(P_VALUE, 10000);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SP(P_SHORT, "Raabs doppelblaettrige Todesaxt");
  SP(P_LONG, BS(
    "Du haeltst nun eine der gefaehrlichsten Waffen dieser Welt in den Haenden! "
    "Raabs doppelblaettrige Todesaxt! Wo sie hinschlaegt, da waechst kein "
    "Gras mehr! Du siehst eine Gravur auf ihrem Stiel!"));

  AddId(({"axt","todesaxt", "PRIVATE_OBJ"}));

  AD(({"stiel","gravur"}),
    "Auf dem Stiel steht:\nNur ein wahrer Held kann mich zuecken!\n");

  SetProp (P_DAM_TYPE, ({DT_TERROR,DT_SLASH}));

  SetProp(P_WC, 150);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:70, MAT_MISC_WOOD:25, MAT_BLOOD:5, MAT_MAGIC:100,]));
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_FUNC, TO);
}

int HitFunc(object enemy)
{
  if(!query_once_interactive(enemy))
	  enemy->heal_self(100);
//nix da:-)
	
return -300;
}

int WieldFunc(object waffe)
{
  if(getuid(TP)=="raab")
    return 1;
  else   
    {
   	  write("Du bist nicht maechtig genug um diese waffe zuecken zu koennen.\n"
        "Nur ein wahrer Held wie Raab kann dies tun!\n");
      say(BS(CAP_TPN+" ist nicht maechtig genug um Raabs Todesaxt zu zuecken!"));
      return 0;
    }
}

