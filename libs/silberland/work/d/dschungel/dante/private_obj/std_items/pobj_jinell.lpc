/*

  jinnels schleier

*/

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Schattenschleier");
  SetProp(P_LONG,BS(
    "Dieser Schleier gehoert Jinnell. Er besteht aus seltener, kostbarer Seide und "
    "ist federleicht. Manchmal rauscht und knistert er magisch. Ein wirkliches "
    "Meisterwerk dunkelelfischer Kunst. Mit <schwebe> kannst Du einen kleinen "
    "Trick vorfuehren, der die anderen im Raum sicher verbluefft!"));
  SP(P_ARTICLE, 1);
  SP(P_NAME_ADJ, "schwarz");
  SetProp(P_NAME, "Schattenschleier");
  SetProp(P_GENDER, MALE);
  AddId(({"jinnells schleier","schleier", "PRIVATE_OBJ", "schattenschleier"}));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILK:90, MAT_MISC_MAGIC:10]));
  SP(P_NOBUY, 1);
  SP(P_NOSELL, 1);  
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);

  ACD(({"schwebe","schweb"}), "trick");
  SetProp(P_WEAR_FUNC, this_object());        
}

string extra_look()
{
  return BS(CAP(ENV(TO)->QueryPronoun(WER))+" hat sich mit einem "+
    "Schattenschleier verschleiert.\n");
}
  
int WearFunc(object me)
{
  write(BS("Du verschleierst Dich mit einem Schattenschleier!"));
  say(BS(CAP(getuid(PL))+" verschleiert sich mit einem Schattenschleier!"));
  return 1; 
}
  
trick(string str)
{
  write(BS("Du wirfst den Schleier hoch in die Luft und springst dann "+
    "waehrend er zu Boden sinkt auf ihn drauf! Kurz schwebst Du auf dem "+
    "Schleider durch den Raum! WOW!"));
  say(BS(CAP(getuid(PL))+" wirft einen Schattenschleier hoch in die Luft "+
    "und hechtet dann hinterher! "+CAP(getuid(PL))+" schwebt kurz auf dem "+
    "Schleier durch die Luft und landet dann wieder sanft neben Dir! WOW! "+
    "Du bist verbluefft!"));
 return 1; 
}
 