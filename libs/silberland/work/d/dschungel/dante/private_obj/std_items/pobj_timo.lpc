/*

  timos fluegelhorn

*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

string *presay=({
"der Orks","der Zwergen","der Trolle", "der Goblins","der Menschen",
"der Feen","der Riesen",
"der Elfen","der Hobbits","der Unterwelt","des Dschungel","von Tijara",
"der Drachen",
"des Gebirges","von Smoersky","vos Midas","vom Polar","der Wuesten",
"von Derlim",
"von Elessar","von Felonia","vom Dschungelelfendorf","von Yiqanuc",
"von Knarkh", "von Lars",
"der Hoehlen","der Hoelle","der Zombies","der Vampire","der Skelette",
"der Kannibalen","der Silberwoelfe","des Vogel Rok",
"von Dhrkion","der Tiger","des Drachenwurms","der Dunkelelfen","von Dante",
"von Timo","des Waechters des Dschungels","der Paladine",
"der Druiden","der Abenteurer"
"der Erzmagier","der Goetter","der Wolken", "des Teufels", "des Todes"});

//47

string *titel=({"den Walzer","die Polka","den Tango","den Samba",
"die Arie","die Ballade",
"die Oper",
"das Musical","den Rap","den HipHop","die Ouvertuere","den Marsch",
"den Tanz","den Volkstanz",
"den BossaNova","den Jazz","den Dixieland","den Bebop","den Swing",
"die Variation",
"die Improvisation","die Fuge","das Menuett","den Blues","den Soul",
"den Reggae",
"den Funk","die Volksmusik","den Grunge","den Deathmetal","den Hardrock",
"den Latin","den Merengue","den Ambient","den Trance","den Vikingmetal",
"die Operette"});
//37                 


string *wie1=({
"sehr","extrem","total","enorm","extremst","absolut","ungeheuer",
"ausserordentlich","phaenomenal","scheusslich","grauenhaft", 
"ekelhaft","furchtbar","unglaublich","unheimlich","voellig",
"absonderlich","wenig","aeusserst"});

//19

string *wie2=({
"falsch","richtig","laut","leise", "melodisch","unmelodisch",
"taktvoll","taktlos","harmonisch","disharmonisch"});

//10


create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId (({"PRIVATE_OBJ","horn","fluegelhorn"}));
  SetProp (P_SHORT, "Timos silberlackiertes Fluegelhorn");
  SetProp (P_LONG, BS(
    "Das ist Timos Fluegelhorn. Ein Fluegelhorn ist ein Blasinstrument, "
    "angeblich dem Kornett verwadnt. Dieses hier ist mit reinem Silber "
    "aus den Minen der Zwerge lackiert worden. Man kann es mit "
    "<fhorn> spielen. Mit <kombi> bekommst Du die derzeit "
    "moeglichen Kombinationen."));
   

  SetProp(P_NAME, "Fluegelhorn");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "silberlackiert");
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 100000);
 
  SetProp (P_MATERIAL, ([MAT_SILVER:20, MAT_HORN:80]));
  SP(P_NODROP, 1);
  SP(P_NOSELL, 1);
  SP(P_NOBUY, 1);
  SP(P_NEVERDROP, 1);

  SP(P_INFO, BS("Timos Fluegelhorn kann alles spielen!"));

  AddCmd("kombi", "kombi");
  AddCmd("fhorn", "play");
}
   
int kombi()  
{
  int m;
  m=47*37*19*10;
  write(BS("Derzeit gibt es "+m+" Moeglichkeiten."));
  return 1; 
}

int play()
{
  int p,t,w1,w2;

  p =random(sizeof(presay));
  t =random(sizeof(titel));
  w1=random(sizeof(wie1));
  w2=random(sizeof(wie2));
 
  
  write("Du holst tief Luft und blaest in das Fluegelhorn.\n"
    "Du spielst "+wie1[w1]+" "+wie2[w2]+" "+titel[t]+" "+presay[p]+".\n");

  say(CAP(getuid(TP))+" holt tief Luft und blaest in Timos Fluegelhorn.\n"+
    BS(CAP(getuid(TP))+" spielt "+wie1[w1]+" "+wie2[w2]+" "+titel[t]+" "+
       presay[p]+".\n"));

  return 1; 
}

    