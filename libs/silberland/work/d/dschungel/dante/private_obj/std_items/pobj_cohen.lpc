/* 
  Personal Item for Cohen, Teddy mit Metfaesschen, Rage Jan, 2001

  angepasst und angehaengt von dante
  10.01.2001

  Die privaten Dinger sollten standardmaessig NODROP NEVERDROP sein...
  PROtheG   
*/
   
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

nosave int verkorkt;

create()
{
  if(!is_clone(TO) )  return;
  ::create();

  verkorkt=1;

  SetProp(P_SHORT, "Cohens Spezialteddy" );
  SetProp(P_LONG,
          BS("Du haeltst in Deinen Haenden einen urlangweiligen Teddy, den man nicht "
             "knuddeln, nicht wuscheln und mit dem Du sonst auch nichts machen kannst, "
             "aber dafuer hat er liebe, grosse Glubschaugen. Sein Fell ist schon sehr "
             "zersaust, wurde anscheinend schon oft missbraucht. Na hoppla, um den "
             "Hals hat er ein Faesschen gebunden. Was da wohl drin ist?"));
  AddSpecialDetail(({"faesschen","tonne","fass"}), "detailTonne");
  AddSpecialDetail("korken", "detailKorken");
  AddSpecialDetail(({"trank","fluessigkeit"}), "detailFluessigkeit");
  AddDetail("schnur",
      "Die Schnur ist einerseits am Korken festgebunden und andererseits irgendwie "
      "mit dem Faesschen verbunden worden, damit der Korken nicht verloren geht.");
  AddDetail(({"glubschaugen","augen"}),
      "Die glubschen Dich an.");
  AddDetail("fell",
      "Ist total zersaust. Der Teddy musste schon viel Leid mitertragen.");
  AddDetail("hals",
      "Um den Hals des Teddys haengt ein Faesschen. Es ist ziemlich schwer aus. "
      "Willst Du dem Teddy nicht dabei helfen, ihm die Last ein wenig abzunehmen?");
  SetProp(P_SOUND,
      "Du hoerst das Schwappen einer Fluessigkeit im Inneren des Fasses.\n");
  SetProp(P_SMELL,
      "Du schnupperst am Teddy, aber Dich interessiert eigentlich der Geruch, "
      "der von dem Faesschen ausgeht, mehr, denn der erinnert Dich doch glatt "
      "an Met. Trink am besten mal davon!\n");

  SetProp(P_NAME, "Spezialteddy");
  SetProp(P_GENDER, MALE);
  AddId(({"PRIVATE_OBJ","teddy","spezialteddy","cohenteddy","cohenspezialteddy"}));
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Nein! Deinen Met gibst Du nicht her!\n");
  SetProp(P_NEVERDROP, 1);

  AddCmd(({"zieh","ziehe" }), "ziehen");
  AddCmd(({"stoppel","stopple" }), "stoppeln");
  AddCmd(({"trink","trinke","sauf","saufe" }), "trinken");
}

//SPECIAL DETAILS
nosave string detailKorken()
{
  if(verkorkt)
    return BS(
      "Der Korken sitzt fest in der Tonne. Zieh ihn doch gleich mal raus, damit "
      "Du Dir einen kraeftigen Schluck goennen kannst.");
  else
    return BS(
      "Der Korken wurde bereits herausgezogen und baumelt nun an einer Schnur. "
      "Stoppel ihn besser wieder rein, nachdem Du getrunken hast, denn sonst "
      "raucht der gute Trank aus.");
}

nosave string detailTonne()
{
  if(verkorkt)
    return BS(
      "Das Faesschen ist vielmehr eine kleine Tonne, aehnlich jener von denen, "
      "die Du von den Berhardinern her kennst. Auf einer Seite steckt ein Korken "
      "drin. Du merkst, dass drinnen eine Fluessigkeit schwappt.");
  else
    return BS(
      "Das Faesschen ist vielmehr eine kleine Tonne, aehnlich jener, die "
      "Bernhardinern umgehaengt werden. Auf einer Seite baumelt ein Korken, der mit "
      "einer Schnur mit der Tonne verbunden ist, herum. Ein paar Tropfen einer "
      "Fluessigkeit troepfeln heraus.");
}

nosave string detailFluessigkeit()
{
  if(verkorkt)
    return BS(
      "Da die Tonne verkorkt ist, kannst Du die Fluessigkeit auch nicht sehen. Du "
      "vernimmst nur das Schwappen darin." );
  else
    return BS(
      "Dort, wo vorher noch der Korken war, versuchst Du in die Tonne reinzuschauen, "
      "doch leider erkennst Du nichts genaueres. Am besten Du machst mal einen "
      "Schluck, dann weisst Du, was drin ist und wie es schmeckt." );
}
//END SPECIAL DETAILS

//COMMANDS
nosave ziehen(string str)
{
  notify_fail("Du willst wohl den Korken rausziehen?\n");

  if(member(({ "korken raus","an korken","korken heraus" }),str)!=-1)
    if(!verkorkt)
      return write("Der Korken wurde bereits herausgezogen.\n"),1;
    else
      {
        verkorkt=0;
        return write(BS(
          "Mit einem leichten Ruck loest sich der Korken und baumelt nun an der "
          "Schnur. Einem kraeftigen Schluck steht nichts mehr im Weg.")),1;
      }
  return 0;
}

nosave stoppeln(string str)
{
  notify_fail("Willst Du das Faesschen wieder zustoppeln?\n");

  if(member(({"faesschen zu","tonne zu","fass zu","faesschen mit korken zu",
                  "tonne mit korken zu","fass mit korken zu"}),str)!=-1)
    if(verkorkt)
      return write("Der Korken steckt schon im Fass drin.\n"),1;
    else
      {
        verkorkt=1;
        return write( BS(
          "Damit nichts vom kostbaren Met rausrinnt, stoppelst Du das Fass mit dem "
          "Korken rasch wieder zu.")),1;
      }
  return 0;
}

nosave trinken(string str)
{
  notify_fail("Moechtest Du Dir etwas aus dem Faesschen goennen?\n");

  if(member(({ "aus faesschen","aus tonne","aus fass","met","fluessigkeit"}),str)!=-1)
    if(verkorkt)
      return write(BS(
        "Bevor Du trinkst, musst Du zuerst noch den Korken aus dem Fass "
        "herausziehen.")),1;
    else
      {
        say(TPN+" hebt einen Teddy hoch, dreht dessen Faesschen um und nimmt einen "
          "grossen Schluck Met. Hmmmmmmmm, lecker!\n");
        write(BS(
          "Du hebst den Teddy hoch, drehst das Fass so, dass die Fluessigkeit genau "
          "in Deinen gierigen Rachen trifft und nimmst einen grossen Schluck. "
          "Hmmmmmmmm, lecker. Der Met fliesst Deine in Deiner Kehle angenehm "
          "hinunter, bis er in Deinem Magen ankommt, wo er ein wohlig warmes Gefuehl "
          "in Dir erzeugt. Am besten gleich noch einen Schluck nehmen, weil es doch "
          "so gut war."));
        return 1;
      }
}
//END COMMANDS
