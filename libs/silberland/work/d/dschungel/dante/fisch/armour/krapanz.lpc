inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>



create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();     
  
  SetProp(P_SHORT, "Ein Krabbenpanzer");
  SetProp(P_LONG, 
    "Dieser roetliche Krabbenpanzer schuetzt Riesenkrabben ein wenig vor "
    "Feinden. Ausserdem kann die Krabbe dort schnell hinein kriechen, falls "
    "sie in all zu grosser Gefahr schwebt. " );
  SetProp(P_NAME, "Krabbenpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "krabbenpanzer", "\nkrabbenpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 18);
  SetProp(P_MATERIAL,([MAT_CHITIN:50,MAT_BONE:50]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  
}
