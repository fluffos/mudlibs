//dante sl 98 98
#include <properties.h>        
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
inherit "/std/weapon";

create ()
{
        ::create();
        SetProp(P_WEAPON_TYPE, WT_SPEAR);
SetProp(P_INFO, break_string(
"Diese Harpune ist magisch und vor allem gegen den grossen, gruenen "
"Dschungelhai zu verwenden!!!"));

SetProp(P_DAM_TYPE, DT_MAGIC);
SetProp(P_GENDER, FEMALE);
SetProp(P_VALUE, 0);
SetProp(P_WEIGHT, 1000);
SetProp(P_SHORT, "Eine lange Harpune");
SetProp(P_NAME, "Harpune");
SP(P_NAME_ADJ, "lang");

SetProp(P_WC, 100);
SetProp(P_LONG, break_string(
"Diese Harpune hat angeblich magische Eigenschaften. Sie sieht "
"jedoch voellig normal und fast langweilig aus. Eben eine Harpune. "
"Du siehst einen kleinen Punkt."));

AD("punkt",
"(c) Doby Mick anno woody 3.");

       AddId("harpune");
AddId("DANTE_HARPUNE");
SetProp(P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_STEEL: 50, MAT_OAK:50]));         
 SetProp (P_MAGIC, 1);
 SetProp (P_NOBUY, 1);
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
}
