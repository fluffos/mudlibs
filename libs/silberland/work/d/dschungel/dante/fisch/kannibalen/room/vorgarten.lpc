//einer der stdraeume dante sl 97-2000

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>

#define NPC_WEG "/d/dschungel/dante/weg/npc/"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Dschungellichtung" );
  SetProp( P_INT_LONG, BS(
  "Du bist nun wieder auf einem kleinen Pfad der hier in ein kleine "
  "Lichtung mitten im dichtesten Dschungel muendet. Seltsam ist nur, dass der "
  "Pfad hier direkt an der Hinterwand der Kneipe endet und sich nur Richtung "
  "Lichtung erstreckt?!"
  " Der Boden ist plattgetrampelt und "
  "ueberall sieht man die Spuren von Affen. Im Westen scheint die Lichtung "
  "groesser zu werden, denn dort kann man eine kleine Huette erkennen. "
  "Nach Nordosten scheint ein sehr enger, dicht zugewachsener Weg zu fuehren!"));
  
  AD("weg",
  "Der weh sieht sehr unheimlich aus.");
  AD("nordosten",
  "Der Weg dorthin gefaellt Dir gar nicht.");
  

AD(({"wand","hinterwand"}),
"Du siehst auch die Klappe durch die Du hier her gekommen bist. "
"Du kannst so auch wieder in die Kneipe kriechen.");
AD("kneipe",
"Der Pfad endet oder beginnt, wie man es eben will, an der Hinterwand "
"der Kneipe.");
AD("richtung",
"Der Pfad fuehrt hier nach Westen.");



AD("enge",
"Die Lichtung sieht eigentlich recht froehlich aus.");
AD("genaueres",
"Eben nicht.");
AD(({"pflanze","pflanzen"}),
"Sie sind hier grossteils von den Affen niedergetreten worden.");
AD("umgebung",
"Die Umgebung ist von den Affen verwuestet worden.");
AD(({"bewohner","dschungelbewohner"}),
"Die Affen sind die nettesten aller Dschungelbewohner.");


  AddDetail( ({ "klappe" }), 
    "Durch die Klappe kann man wieder in die Kneipe kriechen." );
  AddDetail(("westen"),
  "Im Westen der Lichtung siehst Du eine Blockhuette, die einsam und verlassen "
  "mitten im Dschungel steht."); 
  AddDetail(("huette"),
  "Du glaubst, dass es sich hierbei um eine Blockhuette handelt, doch aus "
  "dieser Entfernung kannst Du noch nicht viel erkennen.");
  AddDetail(("entfernung"),
  "Du wirst wohl naeher hingehen muessen.");
  AddDetail(("blockhuette"),
  "Um Genaueres zu erkennen bist Du noch zu weit entfernt von der Huette.");  
  AddDetail(({"pfad","ende"}),
  
  "Der Pfad fuehrt von hier nur mehr zurueck nach Suedosten, doch die Lichtung "
  "wird im Westen breiter.");
  AddDetail(("himmel"),
  "Der Dschungel ist hier so dicht, dass man den Himmel kaum erkennen kann.");
  
  AddDetail(("lichtung"),
  "Die Lichtung ist hier nicht allzu gross, doch in der beklemmenden Enge des "
  "Dschungels fuehlst Du Dich hier doch sehr wohl. Im Westen liegt eine kleine "
  "Huette.");
  AddDetail(("boden"),
  "Die Affen haben hier alles niedergewalzt...\n");
  AddDetail(("affen"),
  "Sie sind die lustigsten aller Dschungelbewohner.\n");
  AddDetail(({"spur","spuren"}),
  "Ueberall liegen Bananenschalen und Affendreck herum.\n");
  AddDetail(({"affendreck","dreck"}),
  "Nun bist Du genau hineingestiegen!!!\n");
  
  AddSpecialDetail(({"schale","bananenschale","schalen","bananenschalen"}), "d_down");
  
  AddDetail(({"banane","bananen"}),
  "Hoch oben kannst Du welche erkennen. Wie man an die wohl rankommt?\n");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Die Affen in der Umgebung kreischen wie wild.");
 AddSound(({"affe","affen"}),
 "Kreischhhhhhh!!!");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark.");

   AddItem( ({NPC_WEG"dgorilla2", NPC_WEG "dschimp", NPC_WEG "dpavian"}) , 
   REFRESH_DESTRUCT,
    ([P_MNPC: 0]));

  
   
ASE("nordosten", "check");
AddExit("westen", "./garten");

 ACD(({"krieche","kriech"}), "go_vorgarten");

}

init()  {
	::init();
if(interactive(TP))  {

affen();

        }	
}

affen()  {
	object af;
	if(!present("affe", environment(TP) ))  {

     switch(random(3))  {
case 0:
af=clone_object(NPC_WEG"dgorilla2");
break;
case 1:
af=clone_object(NPC_WEG"dschimp");
break;
case 2:
af=clone_object(NPC_WEG"dpavian");
break;	

default:
af=clone_object(NPC_WEG"dgorilla2");
                       } 
 af->move(TO, M_GO+M_SILENT);
 af->SetProp(P_MNPC_FLAGS, 0);

     }
  }



int check()  {

 if(present("affe", TO))  {
     write(BS(
 "Der Affe laesst Dich nicht vorbei!"));
 return 1; }
 
 if(!present("DANTE_EINSIEDLER_TAUSCH", TP))  {
     write(BS(	
   "Du wagst Dich noch nicht dorthin!"));
   return 1; }
   
   TPM(KROOM"vorgrube", M_GO,
   "im Dschungel", "verschwindet","kommt aus dem Dschungel hervor");	
   return 1; }
   





int go_vorgarten(string str)  {
	NF("Wo willst Du durchkriechen?!\n");
if(str=="durch klappe")  {

TPM(KROOM"kneipe", M_GO,
"ploetzlich durch eine Wand in die Kneipe", "verschwindet", 
"kommt durch die Hinterwand der Kneipe hereingekrochen");
     return 1; }

return 0; }

string d_down()
{
 write("Und schwuppp bist Du schon auf einer Bananenschale augerutscht!\n");
 TP->reduce_hit_point(10);
 say(CAP_TPN+" rutscht auf einer Bananenschale aus.\n");
 return "";
 }
