
#include "../kani.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  

  SetProp( P_INT_LONG, BS(
  "Der kleine Pfad fuehrt hier steil bergauf auf einen kleinen Huegel. "
  "Rings um Dich undurchdringbarer Dschungel, nur der Pfad gibt Dir einen "
  "Anhaltspunkt. Hier ist der Pflanzenwuchs besonders dicht, so dass man "
  "die naehere Umgebung ueberhaupt nicht mehr erkennen kann. Am Boden liegt hier einiger Muell herum..."));
  
  AddDetail(("huegel"),
  "Auf dem Huegel glaubst Du einen gruen schimmernden Fleck zu sehen, "
  "aber genaues kannst Du aus dieser Entfernung nicht erkennen.");
  AddDetail(("muell"),
  "Alte Eimer, ein Rad einer Kutsche und ein verrostetter, alter Helm...");
  AddDetail(("helm"),
"Der Helm ist alt und rostig und man sollte ihn aufheben! Sieht nicht schoen aus!");

  AddDetail(("eimer"),
  "Der Eimer hat viele grosse und kleine Loecher und ist sicher nicht "
  "mehr zu gebrauchen.");
  AddDetail(({"loch","loecher"}),
  "Durch die Loecher kann man das Regenwasser sehen...");
  AddDetail(({"wasser","regenwasser"}),
  "Im Laufe der Zeit hat sich das Regenwasser im Eimer angesammelt.");
  AddDetail(("rad"),
  "Ein Rad einer alten Kutsche, bei dem fast alle Speichen fehlen...");
  AddDetail(("speiche"),
  "Von den Speichen sind nur mehr einige wenige vorhanden.");
  AddDetail(("kutsche"),
  "Etwas weiter weg siehst Du auch die traurigen Reste einer einst stolzen "
  "Kutsche.");
  AddDetail(({"reste","rest"}),
  "Abseits des Pfades liegen die Truemmer der Kutsche verstreut.");
  AddDetail(("truemmer"),
  "Eisen, alte Holzbretter, Polsterbezuege, Leder...");
  AddDetail(("polster"),
  "Die Polster der Kutsche hatten einst feine, seidene Bezuege, die man fuer die MacDucks immer glattstreichen musste...");
  AddDetail(({"polsterbezug","polsterbezueg","bezuege","bezug"}),
  "Einer der Bezuege faellt Dir besonders auf. Er scheint etwas zu verbergen, denn er weisst eine kleine, kaum sichtbare Woelbung auf.");
  AddDetail(("woelbung"),
  "Ja, wirklich eine kleine Woelbung, die sicher etwas verbirgt...");  
  AddDetail(("eisen"),
  "Das alte Eisen scheint komplett verrostet zu sein.");
  AddDetail(({"bretter","holzbretter"}),
  "Die Holzbretter sind feucht und morsch...");
  AddDetail(("holz"),
 "Auf einem der Holzbretter erkennst Du ein Wappen...");
  AddDetail(("wappen"),
  "Es ist das Wappen derer von MacDuck...");
  AddDetail(("macduck"),
  "Die MacDucks aus Entenhausen...");
  AddDetail(("entenhausen"),
  "QUACK!!!!QUACK!!!!");
  AddDetail(("leder"),
  "Das einst schoene, braune Leder ist nun grau und bruechig...");
  
  
  AddDetail(("entfernung"),
  "Du wirst wohl naeher herangehen muessen, um genaueres zu erfahren...");
  AddDetail(("fleck"),
  "Der gruene Fleck tanzt auf und ab und scheint manchmal fuer kurze "
  "Zeit zu verschwinden...");
  AddDetail(("umgebung"),
  "Da die Straeucher, Baeume und Farne hier so dicht wachsen, kannst Du nur "
  "wenige Meter in den Dschungel sehen.");
  AddDetail(({"wuchs","pflanzewuchs"}),
  "Die Pflanzen wachsen hier besonders ueppig und gedeihen praechtig.");
  AddDetail(("pflanzen"),
  "Du erkennst Baeume, Farne, Straeucher,...");
  AddDetail(({"farn","farne"}),
  "Die Farne hier erreichen fast die Hoehe eines ausgewachsenen Elfen.");
  AddDetail(("hoehe"),
  "Du befindest Dich auf 100 Meter ueber Meereshoehe.");
  AddDetail(({"strauch","straeucher"}),
  "Die Straeucher kitzeln Dich ein wenig.");
  
  AddDetail(("meereshoehe"),
  "Tijara liegt auf Meereshoehe, und der Tafelberg auf dem Du stehst ist folglich etwas hoeher.");
  AddDetail(({"elf","elfen","elfe"}),
  "Die Elfen haben leider noch keine eigene Stadt hier.");
  AddDetail(({"baum","baeume"}),
  "Hier wachsen vor allem Naobabs, die fuer ihre spitzen Stacheln bekannt sind.");
  AddDetail(({"naobab","naobabs"}),
  "Der Naobab ist eine Gummibaumart, die nur suedlich der Stadt Tijara vorkommt. "
  "Hinter einem der Baeume faellt Dir ein vermoderter Baumstamm auf.");
  AddDetail(({"baumstamm","stamm"}),
  "Der Baumstamm ist umgefallen und vermodert langsam.");
  AddDetail(({"gummibaum","gummibaumart","art"}),
  "Aus ihnen stellen fleissige Bauern Kaugummi her.");
  AddDetail(({"bauer","bauern"}),
  "Sie bewitschaften grosse Naobabplantagen.");
  AddDetail(({"plantagen","naobabplantagen","plantage"}),
  "Hier wachsen die Naobabs allerdings wild.");
  AddDetail(("kaugummi"),
  "Einen Kaugummi haettest Du im Moment sehr gerne...");
  AddDetail(({"stadt","tijara"}),
  "Tijara ist die groesste Stadt des Gouvernements Dschungel.");
  AddDetail(("gouvernements"),
  "Der Gouverneur der Stadt Tijara leitet das Gouvernement Dschungel.");
  AddDetail(({"stachel","stacheln"}),
  "Pass bloss auf, dass Du ihnen nicht zu nahe kommst!");
  AddDetail(("dickicht"),
  "Wild wuchern die Pflanzen hier...\n");  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Hier ist es auffaellig still.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht man die pure Natur.");
  
  AddCmd(({"streiche","streich"}),"streichen");    
  AddCmd(({"hebe","heb"}), "aufheben");
  
    
  ASE( "oben", "check");
  AddExit( "unten", "./");
}



int check()  {

if(  (deep_present("DANTE_ZETTEL", TP)) &&
     (deep_present("DANTE_ROST_HELM", TP)) )	
{
write(BS(
"Du gehst guten Gewissens nach oben."));
TPM(KROOM"halde2", M_GO, "nach oben","geht",
"kommt von unten herauf");
    return 1; }
    
write(BS(
"Du solltest Dich zuerst um die Natur kuemmern..."));

return 1; }



streichen (string str)
{
	object ob;
notify_fail("Was willst Du hier glatt streichen ?\n");

if (str != "bezug glatt")

return 0;

if (deep_present("DANTE_ZETTEL", TP))
{
write(BS(
"Du versuchst einen der Polsterbezuege glatt zu streichen, stellst Dich aber so ungschickt an, "
"dass Du dich an einer herumliegenden Scherbe leicht verletzt."));
TP->do_damage(3);
say(BS(CAP_TPN+" versucht einen Polsterbezug glatt zu streichen, verletzt sich "
"aber dabei nur an der Hand..."));
return 1;
}

write ( " \n"
"Du streichst einen Polsterbezuege glatt und findest dabei einen kleinen, flachen "
"Gegenstand, den Du sofort an Dich nimmst.\n");
say(""+TPN+" streicht einen der Polsterbezuege glatt und findet dabei einen, "
"kleinen, flachen Gegenstand.\n");
ob=clone_object(KOBJ"zettel");
ob->move(TP, M_NOCHECK);
return 1;
}



 aufheben (string str)
 {
 	object ob;
 notify_fail("Was willst Du hier aufheben ?\n");

if(str=="helm auf"||str=="helm von boden auf"||str=="helm vom boden auf")  {


if(deep_present("DANTE_ROST_HELM", TP))  {

 write( BS( "Du versuchst den Helm vom Boden auf zu heben aber ploetzlich "
            "ist er verschwunden..."));
 say(CAP_TPN+" versucht einen schweren Helm vom Boden aufzuheben...\n");
 return 1;
 }


 write (BS(
 "Du hebst den Helm mit grosser Muehe vom Boden auf und nimmst ihn an Dich."));
 say(CAP_TPN+" hebt einen schweren Helm vom Boden auf und nimmt ihn an sich.\n");
 ob=clone_object(KARMOUR"rhelm");
 ob->move(TP, M_NOCHECK);
 return 1;
 }
    return 0;
    }