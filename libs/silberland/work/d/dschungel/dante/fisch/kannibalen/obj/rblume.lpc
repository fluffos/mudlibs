
inherit "std/thing";

#include <properties.h>
#include <thing.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine schoene rote Blume");
  SetProp (P_LONG, "Eine wild geschlaengelte sehr schoene rote Blume.\n");
  SetProp (P_NAME, "Blume");
  SP(P_NAME_ADJ, "rot");
  SetProp (P_GENDER, FEMALE);
  AddId (({"rote blume", "blume", "DANTE_ROTE_BLUME"}));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NOBUY, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp (P_MATERIAL, ([MAT_PLANT:100]));
}

