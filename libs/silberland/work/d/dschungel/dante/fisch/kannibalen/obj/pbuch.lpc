//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Pflanzenbuch");
  SetProp(P_LONG,BS(
  "Dieses Buch erklaert den Sinn saemtlicher Pflanzen im Silberland."));
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Pflanzenbuch");
  SetProp(P_MATERIAL, ([MAT_PAPER:100]));
  SetProp(P_INFO, ("Irgendeinen Sinn wird das Buch schon haben.\n"));
  AddReadDetail(({"buch","inhalt"}),
  "Du schlaegst das Buch auf, verstehst aber ueberhaupt nichts. "
  "Enttaeuscht schlaegst Du das Buch wieder zu.");
  AddId(({"buch","pflanzenbuch", "DANTE_PFLANZEN_BUCH"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}

