//dante sl 99

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"
#include <class.h>

int l;

void create()
{
  string rasse;

  if (!is_clone(TO)) return;
  ::create();

  switch (random(24))
  {
    case 0..2 : rasse = "Hoellen"; break;
    case 3..5 : rasse = "Satans"; break;
    case 6..8 : rasse = "Moerder"; break;
    case 9..11 : rasse = "Pfeil"; break;
    case 12..14: rasse= "Panzer"; break;
    case 15..17: rasse= "Wuerge"; break;
    case 18..20: rasse = "Tiger"; break;
    case 21..23: rasse= "Panther" ; break;
  }

  SetProp(P_SHORT, "Eine "+ rasse+ "schlange");
  SetProp(P_LONG, BS(
 "Diese "+rasse+"schlange ist einer der heimtuekischten Bewohner dieser "
 "Umgebung. Huete Dich vor dieser Schlange!"));

 
 SetProp(P_NAME, ""+rasse+"schlange");
 	
  SetProp(P_GENDER, FEMALE);
  AddId(({ LOWER(rasse), "schlange",""+LOWER(rasse)+"schlange"}));
 
  create_default_npc(9+random(5));

l=TO->QueryProp(P_LEVEL);
  SetProp(P_HANDS, ({" mit seinen "+ rasse +"schwanz",l*15,({DT_RIP})}));
  SetProp(P_BODY, 30+l);
  SetProp(P_RACE, "Schlange");
     SetProp(P_SIZE, 100 + random(200));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0.2);
  SetProp(P_WIMPY, 0);

  SetProp(P_DIE_MSG,  " verendet zischend.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "macht nur: SSSSSS SSSSSS SSSSSSSS!\n");

  SetProp(P_MSGIN, "kriecht hier her");
  SetProp(P_MSGOUT, "kriecht fauchend aufgeregt");
  SetProp(P_MMSGIN, "erscheint aus dem Boden");
  SetProp(P_MMSGOUT, "kriecht fauchend hierherein");

  SetProp(P_MNPC_AREA, "/d/dschungel/dante/fisch/kannibalen/room/gr" );
  SetProp(P_MNPC_WAIT, ({ 5, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/gr");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS+
         MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);




  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
"Die Schlange faucht Dich an!"}));
  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,l*10,
"Die "+rasse+"schlange versucht Dir ins Bein zu beissen.\n",
"Die "+rasse+"schlange versucht @WEM ins Bein zu beissen.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]) );
  

  AddSpell(3,l*15,
"Die "+rasse+"schlange versucht Dir in die Hand zu beissen.\n",
"Die "+rasse+"schlange versucht @WEM in die Hand zu beissen.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]) );
  
             
SetChats(1,({
"Die "+rasse+"schlange kriecht um Dich herum.\n",
"Die "+rasse+"schlange zischt laut.\n",
"Die "+rasse+"schlange faucht Dich an.\n",
"Die "+rasse+"schlange schlaengelt herum.\n",
"Die "+rasse+"schlange richtet sich auf.\n",
"Die "+rasse+"schlange zuengelt wild.\n"
    }));

}