
#include "../kani.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein alter, loechriger Schuh");
  SetProp(P_LONG, BS(
  "Diesen alten loechrigen Schuh hat irgenein Umweltsuender im Dschungel "
  "weggeworfen. Anziehn kann man ihn auf keinen Fall mehr."));
  SetProp(P_NAME, "Schuh");
  SetProp(P_GENDER, MALE);
  AddId(({"schuh", "DANTE_SCHUH"}));

  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
}
