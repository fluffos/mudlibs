// am minigipfel

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <player.h>
#include <language.h>

int burned=0;

void create()
{

  ::create();
  
  SetProp( P_INT_SHORT, "Am Gipfel des Hochplateaus" );
  SetProp( P_INT_LONG, BS(
  "Du stehst am Gipfel des kleinen Felsplateaus, der eigentlich nur eine "
  "schmale Felsplatte ist. Rings um Dich fallen schroffe Klippen steil ab."
  "In der Mitte des luftigen Platzes erheben sich sechs Steinsaeulen, die"
  "einen Kreis um eine tiefe Feuergrube bilden. Nach Osten fuehrt ein "
  "gefaehrlich enger Vorsprung naeher an den Abgrund heran.\n"));

/*


 Felswaende, Form, Moment, , , Pentagramm, 

 */
 
 
 AD("tag",
 "Bevor dieser Tag endet wirst Du sterben!!!");
 AD("ort",
 "Ein unheimlicher, blutruenstiger Ort.");
 
 AD("moment",
 "Jeden Moment kann Dir hier etwas passieren.");
 
 
 
AD("boden",
"Der Boden besteht weitgehend aus Stein.");
AD("himmel",
"Der Himmel ist hier blutrot. Seltsam.");

AddDetail(({"plateau","felsplateau"}),
"Das Felsplateau liegt tief unter Dir.\n");
AddDetail(({"klippe","klippen"}),
"Nahezu senkrecht stuerzen die Felswaende in den Dschungel hinab.\n");
AddDetail(("gipfel"),
"Der Gipfel ist ein schmaler flacher Fels, auf dem gerade einige wenige"
"Personen Platz finden.\n");
AddDetail(({"platte","felsplatte","fels"}),
"Du stehst auf einem grossen waagrechten Stein in luftiger Hoehe.\n");
AddDetail(("stein"),
"Hier ist eigentlich fast alles aus Stein.\n");
AddDetail(("mitte"),
"Im Zentrum siehst Du die merkwuerdig angeordneten Steine...\n");
AD("zentrum",
"Dort wird auch das Ritual vollbracht.");
AD("ritual",
"Hier feiern die Kannibalen ihre grausamen Rituale.");
AD(({"kannibale","kannibalen"}),
"Die Kannibalen feiern hiere ihre Opferrituale.");
AD(({"opferritual","opferrituale"}),
"Die Opferrituale sind sehr grausam und blutruenstig.");

AddDetail(("hoehe"),
"Hier ist es ziemlich hoch oben...\n");
AddDetail(({"platz","platzes"}),
"Ein seltsamer Ort...\n");
AddDetail(("osten"),
"Nach Osten kann man weiter hinaus auf einen Vorsprung balancieren.\n");
AddDetail(("vorsprung"),
"Du musst schon weiter nach Osten gehen, um etwas genaueres zu erkennen.\n");
AddDetail(("abgrund"),
"Tief unter Dir erkennst Du den Dschungel in all seiner Pracht.\n");
AD("pracht",
"Der Dschungel ist wirklich eine Pracht!");

AddDetail(("dschungel"),
"Er ist wirklich sehr, sehr weit unten.\n");
AddDetail(("kreis"),
"Die sechs Saeulen sind genau in einem Kreis um die Grube angeordnet. "
"AH! Da sieht man ein seltsames Zeichen an einer der Saeulen!");
AD("zeichen",
"Es sieht so wie ein Pentagramm aus.");
AD("pentagramm",
"Das Pentagramm loder hell auf!!!");
AD("form",
"Kreisrund.");

AD(({"wand","waende","felswaende","felswand"}),
"Die Felswand faellt hier steil nach unten ab!");


AddDetail(({"saeule","saeulen","steinsaeule","steinsaeulen"}),
"Irgendjemand muss die Steinsaeulen hier in Form eines Kreises aufgestellt"
"haben. Welchen Sinn sie wohl haben?\n");
AddDetail(("sinn"),
"Hier feiern die Kannibalen an den Aequinoktien ihre grausamen Opferrituale."
"Die sechs Saeulen symbolisieren ihre sechs Geister des Windes...\n");
AddDetail(({"wolke","wolken"}),
"Mit viel Phantasie glaubst Du Dante in den Wolken zu erkennen.\n");
AddDetail(({"aequinoktien","aequinoktium"}),
"Die Aequinoktien sind Tag-Nachtgleichen...\n");
AD(({"tagnachtgleiche","tagnachtgleichen", "gleichen","nachtgleiche"}),
"Es sollte bald so weit sein! Ein neues Opfer muss her.");
AD("opfer",
"Du sollst es wohl sein.");

AddDetail(({"wind","geist","geister"}),
"Der Wind blaest zwar hier oben, aber Geister kannst Du keine erkennen.\n");
AddDetail(({"grube","feuergrube"}),
"In dieser Grube sollte eigentlich ein grosses Feuer brennen. Im Moment "
"scheint es ausgegangen zu sein.\n");
AddDetail(("feuer"),
"Das Feuer ist verloschen. Im Moment ist die Grube voller Asche. "
"Irgendwie muss man das Feuer ja wieder anzuenden koennen...");

AddDetail(("asche"),
"Vielleicht solltest Du die Asche naeher untersuchen...\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );
AddSound(DEFAULT_SOUND,
"Der Wind pfeifft.");
AddSound("wind",
"HUIIIIIIIIIIIIIIIII.");
  
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Feuer und verbranntem Fleisch...");
AddSmell(({"feuer","fleisch"}),
"Es stinkt hier.");


AIT(KNPC"kman", REFRESH_DESTRUCT);
AIT(KNPC"kman", REFRESH_DESTRUCT);

     
     
  AddExit( "unten", "./fels14");
ASE("westen", "go_westen");

 AddCmd(({"grabe", "grab"}), "grabe");
 AddCmd(({"zuende","zuend"}), "burn");

}

int go_westen()
 {
TPM(KROOM"fels16:"+getuid(TP), 
M_GO+M_NOCHECK,
"nach Westen", "geht","kommt herein");
 previous_object()->CustomizeObject();   
return 1;}



int burn(string str)  {
object pent;
pent=deep_present("DANTE_PENT", TP);

	NF("Was willst Du anzuenden?!\n");

if(str=="feuer an" || str=="feuer")   {


if(present("kannibale", environment(TP)))  {
	write(BS(
	"Der Kannibale bruellt Dich an!"));
return 1; }
	


write(BS(
"Du versuchst das Feuer wieder zu entfachen."));

     if( (deep_present("krakenwaffe", TP))|| (burned==1)   )   {
	write(BS(
      "Leider gelingt es Dir nicht mehr."));
     return 1; }

if(!pent)  {
	write(BS(
"Hmm, nichts passiert. Dir scheint etwas zu fehlen!"));
return 1; }
	


     write(BS(
     "Das Pentagramm explodiert in Deiner Hand! "
     "Die Asche blitzt kurz auf, eine Stichflamme schiesst heraus. Dann ist "
     "alles wieder vorbei! Hmm!"));
      burned=1;
     pent->remove();
     
     return 1; }

    return 0; }










grabe ( string str )
{ object waffe;

  notify_fail("Wo willst Du graben?\n");
  
  if(!str) return 0;
  
  if(( !present("schaufel",TP))&&(str == "in asche"))
  {
    TP->reduce_hit_point(10)+random(10);
    write("Du versuchst es ohne geeignetes Werkzeug und verbrennst Dir die Haende.\n");
    return 1;
  }

  if(( present("schaufel",TP))&&(str == "in asche"))
  {
    if( present("kannibale"))
    {
      write("Die Kannibalen wollen nicht, dass Du in der Asche graebst.\n");
      return 1;
    }

    if (deep_present("krakenwaffe", TP))
    {
      write("Du graebst und graebst, gibst aber bald wieder auf.\n");
      return 1;
    }
    
    
    if ( !burned )  {
    write(BS("Du graebst herum in der Asche, doch so wird das "
    	"nie was. Da fehlt noch einiges..."));
   return 1; }
   
    
    
    write("Du findest einen seltsamen Gegenstand, den Du sofort einsteckst.\n");
   waffe=clone_object("d/dschungel/dante/fisch/kannibalen/weapon/kwaffe");
   waffe->move(TP, M_NOCHECK);
   


    return 1;
  }
  return 0;
}
	 
  
