#include "files.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Schlangengrube der Kannibalen" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich nun an einem wahrhaft grausigen Ort! "
  "Hier feiern die Kannibalen ihre blutigen Rituale, bei denen sie "
  "wehrlose Gefangene, auf die sie keinen Appettit mehr haben, ihrem "
  "maechtigstem Goetzen widmen. Vor Dir oeffnet sich eine "
  "breite, kuenstlich "
   "angelegte Grube, aus der lautes Zischen und Klappern und ab und zu auch "
  "ein Todesschrei dringen. Im Suedwesten kommst Du wieder zurueck."));
  

AD("suedwesten",
"Rette dich solange es geht!");

  AddDetail(("ort"),
  "Dieser Ort wird von den Kannibalen fuer ihre grausam Opferungen verwendet.");
  AddDetail(("opferung"),
  "Sie werfen dabei Gefangene in diese Schlangengrube.");
  AddDetail(("himmel"),
  "Der Himmel ist durch das dichte Pflanzendach kaum zu sehen.");
  AddDetail(({"dach","pflanzendach"}),
  "Die Pflanzen sind hier recht dicht.");
  AD(({"pflanze","pflanzen"}),
  "Sogar sie wirken hier todesluestern.");
  AddDetail(("boden"),
  "Der Boden ist voller Spuren...");
  AddDetail(({"spur","spuren"}),
  "Die Spuren fuehren direkt in die Grube!");
  AddDetail(({"gefangene","gefangener"}),
  "Unvorsichtige verlieren so oft zuerst ihr Fleisch und dann ihr Leben...");
  AD("fleisch",
  "Du schaust Dich selbst an und stellst Dir vor, wie es waere, wenn man Dich "
  "fressen wuerde.");
  AddDetail(("leben"),
  "Auch Deines ist hier in Gefahr...");
  AddDetail(("gefahr"),
  "Die Gefahr lauert hier ueberall!");
  AddDetail(({"rituale","ritual"}),
  "Sie werfen ihre Gefangenen den Schlangen, Vipern, Nattern "
  "und Ottern zum Frasse vor.");
  AddDetail(("frasse"),
  "Grausam und brutal zerfetzen die Schlangen ihre Opfer.");
  AddDetail(({"schlange","schlangen","vipern","viper","natter","nattern", "otter","ottern"}),
  "Spring in die Grube und Du lernst sie alle kennen.");
  
  AddDetail(("appettit"),
  "Die Kannibalen haben eigentlich fast immer Hunger...");
  AddDetail(("hunger"),
  "Auch Du wuerdest ihnen schmecken...");
  AddDetail(({"todesschrei","todesschreie","schreie"}),
  "AHHHHHHHHHHHHHH!!!!!!!!!!");
  AddDetail(("schrei"),
  "Du beisst Dir in die Lippen, um einen Angstschrei zu unterdruecken.\n");
  AddDetail(({"lippe","lippen"}),
  "Deine Lippen sind zerbissen umd blutig...");
  AddDetail(("goetze"),
 "Der maechtigste Gott der Kannibalen ist der Schlangengott.");
  AddDetail(({"schlangengott","gott"}),
  "Der Gott der Schlangen verlangt von den Kannibalen "
  "grausame, blutige Opfer.");
  AddDetail(("opfer"),
  "Unbewaffnet werden sie in die Schlangengrube geworfen, um dort unten "
  "einen qualvollen, aber sicheren Tod zu finden.");
  
  AddDetail(("zischen"),
  "Du glaubst dieses Geraeusch zu kennen...");
  AddDetail(("klappern"),
  "Klingt nach einer Klapperschlange...");
  AD("klapperschlange",
  "Sie erwartet Dich bereits.");
  AddDetail(("grube"),
  "Die Kannibalen haben hier ihre Schlangengrube angelegt...");
  AddDetail(("kannibalen"),
  "Die Kannibalen werfen, wenn sie satt sind manchmal wehrlose Opfer "
  "in diese Grube. Pass bloss auf, dass sie Dich hier nicht finden...");
  AddDetail(({"schlangengrube","grube"}),
  "Wehrlose Opfer werden hier dem Schlangengott geopfert...");
  
  
   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Der Dschungel wird hier Dein Tod sein.\n");
AD("brise",
"Hier weht der Tod...");
  
  AD("tod",
  "Dieser Ort ist dem Tod geweiht.");
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die wuetenden Schlangen in der Grube zischen...");
    AddSound(({"zischen","schlange","schlangen"}),
     "SSSSSSSS!!!!SSSSSSS!!!!!");    

      AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Verwesung.");
 
 AddSmell("verwesung",
     "Es stinkt erbaermlich hier.");
 
  
  AddRoomMessage(({ 
    "Irgendwie bekommst Du ein unangenehmes Gefuehl.\n",
    "Du hoerst verzweifelte Hilferufe aus der Grube.\n",
    "Eine Springkobra versucht aus der Grube zu entkommen.\n",
    "Aus der Grube kommt ein Todeschrei...\n",
    "Du wagst es kaum in die Grube zu blicken.\n",
    "Ein wildes Tier bruellt im Dschungel.\n",
    "Der Wind blaest durcht die Blaetter.\n",
    "Du weichst ein Stueck von der grube zurueck.\n",
    "Aus der Grube kommt lautes Zischen.\n",
    "Du schauderst vor dem grausigen Anblick...\n",
    }),10);
  
/*  AddItem(({NPC"dkkind", NPC"dkfrau", NPC"dkanni"}), REFRESH_DESTRUCT);
  AddItem(({NPC"dkkind", NPC"dkfrau", NPC"dkanni",NPC"dkanni"}), REFRESH_DESTRUCT);
  AddItem(({NPC"dkfrau", NPC"dkanni",NPC"dkanni"}), REFRESH_DESTRUCT);
  */
  
  AddCmd(({"kletter","spring","klettere", "springe","steig"}), "klettern");
   
  AddExit( "suedwesten", "./vorgarten");

}






int klettern(string str)
{
notify_fail ("Wohin willst du springen ?\n");
if ( !str) 
return 0;

if ( member ( ({"in grube","in schlangengrube"}), str) !=-1 )
{
	
	
	if(present("kannibale", TO))  {
write(BS(
"Der Kannibale schlaegt Dich nieder!"));
return 1; }
		
	
	
write
( " \n"
"Du nimmst allen Mut zusammen den Du hast und springst in die Schlangengrube.\n");
TP->move(KROOM"grube", M_GO,
"mit Todesverachtung im Gesicht in die Schlangengrube.", "springt",
"kommt laut bruellend von oben hrein gesprungen.");
return 1;
}
return 0;
}
