//kneipe by dante fuer die fisch-kannibalenquest


inherit "std/pub";
#include <pub.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "files.h"


init()   {
   ::init();
   if(TP->id("kannibale"))  {
   
        
   TP->move(KROOM"fels3", M_NOCHECK+M_SILENT);
   tell_room(KROOM"fels3", BS(
   "Der Kannibale bruellt auf und laeuft wieder hinaus!"));
   
   }
 }


create()
{
  ::create();


  SetProp(P_LIGHT, 1);
   SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));   
  SetProp( P_INT_SHORT, "Eine bescheidene Buschkneipe" );

SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
 SetProp(P_PUBKEEPER_ID, "hojo");
      SetProp(P_PUBKEEPER_NAME, "Hojo");
 SetProp(P_PUBMSG_NOKEEPER, "Sorry, aber Hojo ist nicht hier.\n");
SetProp(P_PUBMSG_NOENEMY, BS(
"Hojo serviert DIR hoechstens den Tod!"));

 SetProp(P_PUBMSG_NOINVITE, BS(
 "Hojo serviert Dir sicher nichts!"));
 SetProp(P_PUBMSG_FIGHTING, "Hojo ist doch beschaeftigt!!!\n");
                            
  
  
  SetProp( P_INT_LONG, BS(
"Du stehst nun in einer kleinen Kneipe mitten im wildesten Dschungel. "
"Sie ist sehr bescheiden eingerichtet. Es gibt nur einen Tisch, einige alte "
"Stuehle und eine schmale Theke. Die gesamte Einrichtung ist aus Holz, aber "
"das ist im Dschungel nicht anders zu erwarten. "
"Es sieht nicht so aus, als ob es hier viel zu bestellen gaebe, doch Du musst "
"wohl mit allem zufrieden sein. " 
"Im Sueden gelangt "
"man durch eine kleine, offene Tuere wieder nach draussen in den wilden Dschungel."));  


AD("tisch",
"Der Tisch ist rund. Seine Platte scheint sehr alt zu sein.");

AD("platte",
"Du entdeckst auf der Platte einen eingeritzten Schriftzug.");
AD(({"schrift","schriftzug"}),
"Lies ihn!");

ARD(({"schrift","schriftzug"}),
"Toete den Kannibalenpriester und dann wirst Du siegen.");
AD(({"priester","kannibalenpriester"}),
"Hmm, wo der wohl ist?!");


AD("boden",
"Der Boden besteht aus mittlerweile grauem Holz.");
AD("holz",
"Das Holz stammt aus dem hiesigen Dschungel.");

AD(({"stuhl","stuehle"}),
"Die Stuehle sind ebenfalls aus Holz. Neu sehen sie nicht gerade aus.");
AD("theke",
"Die Theke ist einfach und sehr schlicht, wie alles hier.");
AD("einrichtung",
"Die spaerliche Einrichtung ist nicht gerade gemuetlich. AH! Da ist ja eine "
"Klappe an der nordwestelichen Wand angebracht.");

AD("klappe",
"Hmm, es sieht so aus als wenn man durch die Klappe hindurch wo anders hin "
"gelangen kann. Man kann hindurchkriechen.");

AD("decke",
"Die Decke ist sehr nieder und aus Holz.");
AD("sueden",
"Da kommst Du wieder hinaus.");
AD(({"wand","waende"}),
"Die Waende sind aus gezimmertem Holz. Total langweilig hier!");






AD("kneipe",
"Du stehst mitten drin.");
AD("dschungel",
"Der ist direkt draussen vor der Tuere.");
AD("tuere",
"Die Tuere fuehrt wieder hinaus in den Dschungel.");




  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE ]) );

  AddSmell(DEFAULT_SMELL,
  "Hier riecht es nach Alkohol und frischem Fleisch.\n");
  AddSmell("alkohol",
  "Trink was!\n");
  AddSmell("fleisch",
  "Iss was!\n");
  
  AddSound(DEFAULT_SOUND,
  "Es ist hier angenehm leise.\n");





  AddDrink("Dschungelwasser", ({"dschungel", "dschungelwasser"}),
    50, 13, 0, 6,
    ({"Du trinkst etwas von dem guten Dschungelwasser.",
      "&& trinkt etwas vom Dschungelwasser."}));
      
  AddDrink("Hojowasser", ({"hojowasser", "wasser", "hojo"}),
    65, 5, 0, 9,
    ({"Du bestellt Dir ein Hojowasser.",
      "&& bestellt sich ein Hojowasser."}));
  AddDrink("Runenbraeu", ({"braeu", "dschungelbraeu"}),
    90, 20, 6, 9,
    ({"Du trinkst ein starkes, bitteres Dschungelbraeu.",
      "&& trinkt ein starkes, bitteres Dschungelbraeu."}));

      
  AddDrink("Kannibalenatem",({"lannibalenatem","atem"}),
    130, 30, 12, 13,
    ({"Du bekommst ein voellig durchsichtiges Getraenk. Anfangs zoegerst "
      "Du, aber dann nimmst Du allen Mut zusammen und trinkst es mit einen "
      "Schluck weg. BAEH!!!",
      "&& bekommt ein voellig durchsichtiges Getraenk. && zoegert zuerst, "
      "nimmt dann aber allen Mut zusammen und trinkt es mit einem Schluck "
      "weg. BAEH! && sagt: Das war eklig!!!"}));

  AddDrink("Schlangenblut", ({"blut", "schlangenblut"}),
    250, 50, 20, 18,
    ({"Du bekommst einen grossen Krug, der randvoll gefuellt ist mit "
      "schwarzem, dickfluessigem Blut der verschiedensten Schlangen. "
      "Du ekelst Dich, trotzdem schuettest Du es in Dich hinein und "
      "fuehlst Dich danach sehr stark.",
      "&& trinkt mit Ekel und Grausen einen grossen Krug, der randvoll "
      "mit Schlangenblut ist."}));



  AddFood ( "Schlangenauge", ({"auge", "schlangenauge", 
    }),  100, 15, 10,
    ({"Du bestellst Dir ein Schlangenauge und bekommst eine schleimige, "+
    "glitschrige Kugel serviert. Du wuergst das Auge runter und musst Dich "+
    "fast uebergeben.",
    "&& bekommt eine schleimige, glitschrige Kugel serviert, die && nur "
    "unter Wuergen vertilgt."}));
    
     AddFood ( "Kroetenkuchen", ({"kuchen", "kroetenkuchen", 
    }), 110 , 15, 8,
    ({"Du bestellst Dir ein Stueck Kroetenkuchen, das so eklig ist, "+
    "dass es Dir fast wieder aus dem Magen hochkommt.",
    "&& bekommt ein Stueck Kroetenkuchen. "}));
    
  AddFood ( "Affenhirn", ({"hirn", "affenhirn"}), 
      120, 17, 11,
    ({"Du bekommst ein halbes Affenhirn, dass erstaunlicherweise "+
    "koestlich schmeckt.",
    "&& bekommt ein halbes Affenhirn. "}));
    
   
    
    
  
   AddFood ( "Toter Kannibale", ({"toter kannibale", "kannibale","toter","toten"}), 
      250, 60, 29,
    ({"Du bestellt einen toten Kannibalen und erhaeltst tatsaechlich einen "
    "ganzen, wenn auch kleinen gebackenen Kannibalen, denn Du mit grosser "
    "Muehe verschlingst. Wer wohl hier der Kannibale ist?!",
    "&& bestellt sich eine ganzen, wenn auch kleinen toten Kannibalen, den "
     "&& mit Muehe tatsaechlich alleine verschlingt."}));
     
     AddFood ( "Frisches Kroetenherz", ({"herz", "kroetenherz"}), 
      300, 50,20 ,
    ({"Du isst mit Gruseln ein frisches Kroetenherz.",
    "&& isst mit Gruseln ein frisches Kroetenherz."}));
 
 AE("sueden", "./vorkneipe");
 
 AIT(KNPC"hojo", REFRESH_DESTRUCT);
 
 
 ACD(({"krieche","kriech"}), "go_vorgarten");

}


int go_vorgarten(string str)  {
	NF("Wo willst Du durchkriechen?!\n");
if(str=="durch klappe")  {

TPM(KROOM"vorgarten", M_GO,
"ploetzlich durch eine Wand der Kneipe", "verschwindet", 
"kommt durch die Hinterwand der Kneipe hereingekrochen");
     return 1; }

return 0; }

