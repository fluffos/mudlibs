// dante@SilberLand

#include "../kani.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

#define LOOK (member(look, getuid(this_player()))!=-1)
string *look=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer verfallenen Huette" );
  SetProp( P_INT_LONG, BS(
"Du bist nun in der verfallenen Huette. Hier liegen nur noch Truemmer herum "
"und von der ehemaligen Einrichtung ist nichts mehr zu erkennen. Die Tuere ist "
"von innen her verramelt worden und dass erklaert, warum man nicht herein kann. "
"Durch die beschaedigte Decke kann man das Dach erkennen und durch die "
"dreckigen Fenster nach aussen sehen. Im Boden ist ein Loch, durch das Du "
"hier her gelangt bist."));

AD("decke",
"Die Decke ist stark beschaedigt und man kann durchsie durch aufs Dach sehen.");

AD("huette",
"Die Huette ist voellig verfallen und ueberall liegen Truemmer herum.");
AD("truemmer",
"Die Truemmer sind die ehemalige Einrichtung der Huette. Viel ist davon "
"nicht mehr zu erkennen.");
AD("einrichtung",
"Sie ist entweder zerfallen oder zerstoert worden.");
AD("boden",
"Der Boden ist sehr staubig und uebersaeht mit Truemmern.");
AD("staub",
"Der liegt hier massenhaft herum.");
AD("loch",
"Durch das Loch bist Du heraufgestiegen und kannst auch wieder hinunter, oder "
"auch nicht.");
AD(({"wand","waende"}),
"Die Waende sind staubig und stellenweise eingefallen.");
AD("fenster",
"Die Fenster sind verschmiert, verstaubt, man kann kaum nach draussen sehen. "
"HE! Da hat sich doch etwas draussen bewegt. Hmm, was war das?! Du solltest "
"durch die Fenster blicken!");


    
    AD("stille",
    "Stille...");
  
  
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );

  AddDetail(("grab"),
   "Du steckst sozusagen ueber den Toten.");
   AddDetail(({"tote","toter","toten"}),
   "Vielleicht kommt ja bald einer zu Dir.");
  AD(({"gott","totengott"}),
  "Der Totengott der Kannibalen ist ein grausames Monster, das jeden Toten "
  "selbst verspeist.");
  AD("monster",
"Der Totengott ist blutruenstig.");
AddSound(DEFAULT_SOUND, 
    "Hier ist es totenstill.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Lehm.");
  AddSmell("lehm",
  "Der Lehm riecht feucht.");

 AddItem(KNPC "dmumie" , REFRESH_DESTRUCT, 
 ([P_AGGRESSIVE: 0]));
  AddItem(KNPC "dmumie" , REFRESH_DESTRUCT, 
 ([P_AGGRESSIVE: 0]));
  AddItem(KNPC "dmumie" , REFRESH_DESTRUCT, 
 ([P_AGGRESSIVE: 0]));


ASE("suedunten", "nix");


AD("weg",
"Ja, wo kann der sein...");
AD("dach",
"Das Dach macht einen voellig desolaten Eindruck.");
AD("eindruck",
"Der Eindruck kann taeuschen, tut er aber hier sicher nicht. Du siehst "
"aber eine kleine Luecke im Dach.");
AD("luecke",
"Nein, die ist auch zu eng um nach oben zu gelangen. Verzweiflung "
"kommt bei Dir auf.");
AD("verzweiflung",
"Als Du gerade aufgeben willst, entdeckst Du einen kleinen Hebelgriff an der Tuere.");
AD(({"tuer","tuere"}),
"Die Tuere wurde von innen her verramelt, so als wollte sich hier jemand "
"verstecken oder schuetzen...");
AD("hebel",
"Der Hebel sieht nicht interessant aus.");
AD(({"hebelgriff","griff"}),
"Der Griff des Hebels sieht alt aus, taugt aber noch. Hmm, was koennte man damit "
"machen.");


ACD(({"drehe","drehen","dreh"}), "out");
ACD(({"blick","blicke","blicken"}), "do_look");

ASD("reflexion", "reflexion");
ASD(({"wesen","malerei"}), "wesen");
ASD("knopf","knopf");
ASD(({"kobra","koenig"}), "kobra");
ACD(({"druecke","drueck"}), "push");
}

int push(string str)  {
NF("Das geht nicht!\n");

 if(str=="knopf")  {
 
 if(!LOOK)  {
 	return 0;  }	

if(present("mumie", TO))  {
	write(BS(
	"Die Mumie schiebt Dich weg!"));
	return 1; }


write(BS(
"Du drueckst den Knopf und ploetzlich geht eine geheime Tuere auf und "
"Du wirst wie magisch eingesogen!"));

TPM(KROOM"kata3", M_GO,
"ploetzlich verschwunden","ist","kommt durch die Geheimtuer herein");

return 1; }
	
}


string knopf()  {

	if(!LOOK)  {
	return "Sowas siehst Du da nicht!\n";	
	}
write(BS(
"Was macht man mit Knoepfen wohl..."));
return "";  }
		


string kobra()  {

	if(!LOOK)  {
	return "Sowas siehst Du da nicht!\n";	
	}
write(BS(
"Es ist der Koenig der Kobras!"));
return "";  }
		


string wesen()  {
	if(!LOOK)  {
	return "Sowas siehst Du da nicht!\n";	
	}
write(BS(
"Hmm man sieht eine grosse Kobra! Daneben ist ein Knopf! "
"Hmm, seltsam das alles..."));
return "";
 }		







string reflexion()  {
	
 if(!LOOK)  {
  	return "Sowas siehst Du da nicht!\n";	
        }
       
       write(BS(
       "Du siehst hinter Dir an der Wand eine Malerei, die ein "
       "grosses Wesen zeigt."));
       return ""; }
      
      
      
        

do_look(string str)  {
    NF("Wodurch willst Du blicken?!\n");
    
    if(str=="durch fenster"||str=="fenster")	
    
      {
      	
      write(BS(
      "Du blickst durch die Fenster und siehst in einer Reflexion etwas, das scheinbar "
      "hier im Raum ist."));
      say(BS(
      "Sieht nach draussen."));
      
      if(!LOOK)  {
       look += ({getuid(this_player())});   
      }
      
      return 1; }
return 0; }
      	
    	
    	
	

int out(string str)    {
   NF("Was willst Du hier drehen?!\n");
  
   if(str=="hebel")  {
   	write(BS(
   	"Du drehst den Hebel, doch nichts passiert..."));
   	say(BS(
   	CAP_TPN+" reisst wild an der Tuer herum."));
   	return 1;  }
   	
  if(str=="griff"||str=="hebelgriff")  {
  	 	
  	 write(
  	"Du drehst den Hebelgriff um. KLICKK.\n"
  	"NICHTS passiert! Verdammt.\n"
  	"Du bruellst laut um Hilfe, ob das etwas hilft?!\n");
  say(BS(
   	CAP_TPN+" reisst wild an der Tuer herum."));
   call_out("get_pl", 4);
  
     return 1; }
  
  return 0; }
   
  
  
  get_pl()  {
  	
  if(environment(TP)!=TO)  { return; }	
  
  
  write(
  "\nPloetzlich hoerst Du Geraeusche am Dach.\n"
  "Ein Halbaffe sieht herunter und grinst.\n"
  "Woozoanmu, der Halbaffe laesst ein Seil herab.\n"
  "Du bindest es an Dir fest und er zieht dich nach oben!\n"
  "Dann klettert ihr beide wieder vom Dach herab.\n\n");
  
  say(BS(
  CAP_TPN+" wird vom Halbaffen Woozoanmu aus dieser Misere gerettet."));
  
    TPM(KROOM"kata0", M_GO+M_NO_SHOW,
  "nach oben und dann vom Dach nach unten vor die Huette","klettert",
  "kommt mit Woozoanmu dem Halbaffen von der Huette herabgeklettert");
  
  call_out("get_pl1", 3);
  }

  get_pl1()  {
  
  write(BSA(
  "Na "+TPN+", das ging ja noch mal gut. Aber keine Sorge, ich werde "
  "Dich immer wieder hier herausziehen!!!", 
  "Der Halbaffe Woozoanmu sagt: "));
  write("Dann verschwindet der Halbaffe Woozoanmu wieder im Dschungel.\n");
  }
  
   		
   	
int nix ()  {
 write(BS(
 "Du versuchst durch das Loch nach unten zu gelangen, kommst aber nicht "
 "runter. Du MUSST Dir einen anderen Weg suchen!"));
 return 1; }	
	
