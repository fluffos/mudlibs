// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Hier weitet sich der Pfad etwas aus und Du erkennst nun deutlich "
  "direkt im Norden eine kleine Huette. Sie besteht aus einfachen "
  "Holz, sieht aber recht gepflegt und sicher auch bewohnt aus! "
  "Kannibalen koennen hier doch sicher nicht wohnen? Oder? "
  "Vergiss nicht, rings um Dich herrscht dichter Dschungel und in dem "
  "lauern tausend Gefahren auf Dich..."));
  
  
  
  AD("huette",
  "Es handelt sich um eine Kneipe.");
  AD("kneipe",
  "Die Kneipe gehoert Hojo.");
  AD("hojo",
  "Hojo serviert Dir sicher Etwas zum essen und trinken.");
  AD("etwas",
  "Er bietet einiges in seiner Kneipe an.");
  AD("norden",
  "Im Norden liegt die Kneipe von Hojo.");
  AD("holz",
  "Holz gibt es im Dschungel genug.");
  AD(({"kannibale","kannibalen"}),
  "Die Kannibalen belaestigen Hojo nur selten.");
  AD(({"gefahr","gefahren"}),
  "Die groesste Gefahr geht hier sicher von den Kannibalen aus.");
  AD("himmel",
  "Der Himmel ist hier sehr blau und wolkenfrei.");
  
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im "
    "Dschungel erhebt.");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten "
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  
  AD(({"pflanze","pflanzen"}),
  "Die Pflanzen sind hier unscheinbar. Trotzdem sind sie schoen anzusehen.");
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein lautes Trommeln...");
 AD(({"trommel","trommeln"}),
 "BUMMMMM!!!!");
 AD("boden",
 "Der Boden ist hier weich und sehr fruchtbar.");
 AD("pfad",
 "Der Pfad fuehrt hier bis zur Kneipe von Hojo.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Affen.");
 AD(({"affe","affen"}),
 "Sie schei... aber auch ueberall hin.");
 
  
 AddExit( "sueden", "./fels2");
 
AIT(KNPC"kman", REFRESH_DESTRUCT);

     AGE("norden","/d/dschungel/dante/fisch/kannibalen/room/kneipe",
     "kannibale", "Der Kannibale bruellt: Iuiophn GZUI hoi!\n");
     
 
}
