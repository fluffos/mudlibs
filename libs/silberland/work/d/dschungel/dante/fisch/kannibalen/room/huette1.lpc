// a, felsen 2  by dante 97

#include "files.h"
inherit "std/room";
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Huette des Einsiedlers" );
  SetProp( P_INT_LONG, BS(
 "Du befindest Dich in der Huette des Einsiedlers. An den Waenden stehen Regale und Schraenke. "
 "Auf dem Boden liegt ein alter Teppich, und in der Ecke liegt ein aufgerollter Futon. "
 "Es sieht hier sehr gemuetlich aus, und gar nicht wie man es in der Huette eines "
 "Einsiedlers vermutet. Dieser Einsiedler scheint kein gewoehnlicher zu sein."
 " Der einzige Ausgang der Huette ist im Osten."));
  AddDetail(("ausgang"),
  "Im Osten komsmt Du aus der Huette wieder hinaus.");
  AddDetail(({"wand","waende"}),
  "An den Waenden stehen Regale und Schraenke, nur an einer Wand ist ein "
  "grosser offener Kamin zusehen.");
  AddDetail(("kamin"),
  "Im Kamin brennt ein helles Feuer, das den Einsiedler in kalten Naechten "
  "waermt.");
  AddDetail(("feuer"),
  "Die Flammen zuengeln hell um die Holzscheite und strahlen eine angenehme "
  "Waerme aus.");
  AddDetail(("waerme"),
  "Du kannst die Waerme bis zu Dir her spueren.");
  AddDetail(({"holzscheite","holzscheit"}),
  "Dicke Scheite gluehen im Kamin. Manchmal sieht man stobende Funken, direkt "
  "romantisch.");
  AddDetail(({"funke","funken"}),
  "Die Funken spritzen nur so aus dem Kamin.");
  AddDetail(("ecke"),
  "In der Ecke steht ein alter Futon und eine alte Truhe.");
  AddDetail(("truhe"),
  "Die Truhe ist aus Metall gefertig und weist ein grosses Schloss auf.");
  AddDetail(("metall"),
  "Du kannst nicht genau sehen was fuer ein Metall es ist.");
  AddDetail(("schloss"),
  "Du ruettelst am Schloss, doch es bewegt sich nicht.");
  AddDetail(("boden"),
  "Am Boden liegt ein alter Teppich und ein grosser Korb.");
  AddDetail(("korb"),
  "In diesem grossen Korb aus Weiden liegt der Hund des Einsiedlers.");
  AddDetail(("weiden"),
  "Der Korb besteht aus geflochteten Weiden.");
  AddDetail(("teppich"),
  "Es ist ein alter Teppich, der mit magischen Zeichen bestickt ist.");
  AddDetail(("zeichen"),
  "Sie sehen sehr interessant aus, aber sie sagen Dir nichts.");
  AddDetail(("decke"),
  "Von der Decke haengt eine alte, ziemlich zerbeulte Lampe.");
  AddDetail(("lampe"),
  "Es ist eine Petroleumlampe.");
  AddDetail(("Petroleumlampe"),
  "Die Petroleumlampe flackert nur mehr schwach, scheinbar sollte man sie wieder anfuellen.");
  AddDetail(({"schraenke","schrank"}),
  "Die Schraenke sind aus festem Holz gezimmert. Ein einziger Wandschrank erscheint "
  "Dir interessant.");
  AddDetail(("wandschrank"),
  "Der Schrank beinhaltet einige Trophaeen und Buecher.");
  AddDetail(({"trophaee","trophaeen"}),
  "Es sind die Koepfe von erlegten und ausgestopften Tieren.");
  AddDetail(({"tier","tiere"}),
  "Die gefaehrlichsten und seltesten Tiere des Dschungels hat der Einsiedler "
  "scheinbar alleine erlegt.");
  AddDetail(({"buch","buecher"}),
  "Die Buecher sind alle alt und vergilbt.");
  AddDetail(("dschungel"),
  "Die Huette liegt mitten im Dschungel.");
  AddDetail(({"regal","regale"}),
  "Du wuerdest die Regale gerne naeher ansehen, aber es haengen Vorhaenge davor, "
 "so dass Du nichts sehen kannst.");
  AddDetail(({"vorhang","vorhaenge"}),
  "Sie sind aus dunklem Stoff und mit Zeichen bestickt.");
  AddDetail(("stoff"),
  "Der Stoff ist sehr dunkel und grob.");
  AddDetail(({"tuer","tuere"}),
  "Welche Tuere meinst Du ? Die Holztuer oder die Baobabtuere ?");
  AddDetail(("baobab"),
  "Baobab ist eine sehr besondere Holzart des Dschungels.");
  AddDetail(({"holzart","art"}),
  "Sehr hart, trotzdem gut zu bearbeiten.");
    
  
  AddDetail(({"garten","vorgarten"}),
  "Der Garten ist draussen vor der Huette.");
  AddDetail(("holz"),
  "Die Staemme, aus denen die Huette gebaut wurde, sind aus hartem Holz hiesiger Baeume.");
  AddDetail(({"baum","baeume"}),
  "Die Baeume wurden gefaellt, also sind sie kaum mehr hier.");
  AddDetail(("westen"),
  "Im Westen liegt ein kleines Zimmer.");
  AddDetail(("zimmer"),
  "Von hier kannst Du nichts erkennen.");
  AddDetail(("osten"),
  "Im Osten befindet sich der Garten.");
  AddDetail(("blockhuette"),
  "Die Blockhuette wurde aus groben Staemmen gezimmert und trotz hier schon "
  "viele Jahre dem Dschungel. Eine kleine Tuer fuehrt wieder hinaus in den "
  "Dschungel");
  
  AddDetail(("huette"),
  "Du stehst mitten in der Huette.");
  AddDetail(({"stamm","staemme"}),
  "Hartes Holz aus dem Dschungel hat man fuer diese Blockhuette verwendet.");  
  AddDetail(({"fenster"}),
  "Das Fenster ist nur sehr schmal.");
  AddDetail(("innere"),
  "Du befindest Dich im Inneren der Huette.");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );
  
  AddDetail(({"matte","matten","baumwollmatten","baumwollmatte","futon"}),
"Eine jener Baumwollmatten, auf denen man herrlich schlaeft, "
"und die seit einiger Zeit in Mode gekommen sind.");

  AddDetail(("mode"),
  "Naja, so modern ist diese Matte auch nicht.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Knarren der Huette.");

AddSound(({"huette","knarren"}),
"KRRRRRRRRR");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Tabak, einem Hund, Schweiss, Fleisch...");


AddSmell(({"tabak","hund","schweiss","fleisch"}),
"Hier lebt eben ein der Einsiedler mit seinem Hund.");

  
  AddItem(KNPC"deinsi", REFRESH_DESTRUCT);  
  AddItem(KNPC"dwhund", REFRESH_DESTRUCT);
  
   NewDoor("osten", (KROOM"garten"),
    ({"holztuer"}),
     
      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
        D_LONG, "Die Tuer sieht stabil aus und ist ebenfalls aus Holz gefertigt.\n",
         D_GENDER, FEMALE,
          D_SHORT, "Eine %se Holztuer.",
           D_NAME, "Holztuer",
            } ));
  
   NewDoor("westen", (KROOM"huette2"),
    ({"baobabtuer","baobatuere"}),
     
      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
        D_LONG, "Die Baobabtuer ist klein und niedrig.\n",
         D_GENDER, FEMALE,
          D_SHORT, "Eine %se Baobabtuer.",
           D_NAME, "Baobabtuer",
            } ));
             
} 
            
