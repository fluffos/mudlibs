// 3koepfige spinne


inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine gigantische, dreikoepfige Mutantenspinne");
  SetProp(P_LONG, BS(
    "Die Mutantenspinne ist eine grausige Laune der Natur. Drei Koepfe streiten"
    " sich um einen Koerper. Sechs Beisszangen kaempfen um Nahrung fuer nur einen"
    " Magen."));
  AddDetail(({"beisszangen","zangen"}),
  "Diese kraeftigen Zangen zerfetzen jeden Gegner der ihnen zu nahe kommt.\n");
  AddDetail(("koerper"),
  "Diese Spinne ist auch in ihrer Groesse ein Mutant. Sie misst sicher einen"
  " Meter im Durchmesser...\n");
  AddDetail(({"kopf","koepfe"}),
  "Die Drei Koepfe beobachten Dich hungrig...\n");
  
  SetProp(P_NAME, "Mutantenspinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"mutantenspinne", "spinne"}));
  SetProp(P_RACE, "Spinne");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren Beisszangen", 200+random(30), ({DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_ACID}) }));
  SetProp(P_INFO, ("Die Mutantenspinne lauert nur auf eine Chance Dich zu fressen!\n"));
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0.4);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_ACID:-1.0, DT_POISON:-1.0, DT_FIRE:-0.3,
     DT_UNHOLY:0.2,DT_TERROR:0.3,DT_RIP: 0.5, DT_HOLY:0.1]));
     
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "krabbelt laut krachend herein");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " bricht mit lautem Krachen zusammen.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, " krabbelt naeher an Dich heran.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll die Spinne mit Deinem Muell!\n" }) );

  SetProp(P_SPELLRATE,60+random(10));
  
  AddSpell(5,300,
    "Die Mutantenspinne saugt Deinen Koerper leer.\n",
    "Die Mutantenspinne saugt @WESSEN Koerper leer.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400,
    "Die Mutantenspinne injeziert Dir ihren Verdauungssaft.\n",
    "Die Mutenatenspinne injeziert @WEM ihren Verdauungssaft.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5,200,
    "Die Mutantenspinne versucht Deine Beine abzuzwicken.\n",
    "Die Mutantenspinne versucht @WESSEN Beine abzuzwicken.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
    "Die Mutantenspinne beisst Dir in den Bauch.\n",
    "Die Mutantenspinne beisst in @WESSEN Bauch.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1])); 
  AddDefaultSpell(1,1,DS_POISON);
       
  SetChats(3, ({
  "Die Mutantenspinne krabbelt naeher an Dich heran.\n",
  "Du bekommst es mit der Angst zu tun.\n",
  "Die Mutantenspinne streckt ihre Fuehler nach Dir aus.\n",
  "Die Mutantenspinne kneift Dir ins Bein.\n",
  "Die drei Koepfe streiten darum wer Dich fressen darf.\n",
  "Die drei Koepfe beobachten Dich genau.\n",
  "Einer der Koepfe schnappt nach Dir.\n"}) );
  
  SetAttackChats(10, ({
  "Die Spinne versucht Dich in die Ecke zu draengen.\n",
  "Die Mutantenspinne zerfetzt Dein Bein.\n",
  "Du stolperst ueber einen Stein.\n",
  "Die Mutantenspinne zerdrueckt Deinen Arm.\n"}) );

  
}

die(arg) {
object ob, pa;
 call_other("d/dschungel/dante/fisch/kannibalen/room/spinnennest", "new_spider");
if((!deep_present("DANTE_PFLANZEN_BUCH", TP))&&
 
    (present("DANTE_FISCH_LISTE_VIER", TP))&&(!deep_present("DANTE_SPINNEN_PANZER", TP)))
     {
     ob=clone_object(KOBJ"pbuch");
     ob->move(TP, M_NOCHECK);
     pa=clone_object(KARMOUR"dmpanzer");
     pa->move(TP, M_NOCHECK);
     write("Du durchwuehlst die Leiche und findest ein Buch und einen Panzer!\n");
     }
 ::die(arg);}
  

 Defend(int dam, string dtype, int spell, object enemy)
   {
    if(!present("DANTE_FISCH_LISTE_VIER", TP))  {
    write("Die Spinne ist von Dir nicht zu treffen!\n");
     return ::Defend(0, dtype, spell, enemy); }

     else    {

      return ::Defend(dam, dtype, spell, enemy); }

          }



