inherit "std/armour";
#include "../def.h"
#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Leggins");
  SetProp(P_LONG, BS(
    "Dieses Beinkleid besteht eigentlich nur aus mehreren grossen "
    "Lederstuecken, die durch Lederschnuere zusammengebunden sind. An der "
    "rechten Pobacke ist eine Tasche nachtraeglich angebracht worden."));
  SetProp(P_NAME, "Leggins");
  AddId(({"fellhose","hose","leggins"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT,1000);
  SetProp(P_VALUE,800);
  SetProp(P_AC, 5);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
 SetProp(P_MATERIAL, MAT_LEATHER);
 AddDetail(({"po","backe","tasche","pobacke"}),
 "Leider ist die Tasche leer.\n");
 AddDetail(({"schnuere","lederschnuere"}),
 "Eine luftige Angelegenheit diese Art von Hose.\n");
 
 }
