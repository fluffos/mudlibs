/*
pentragramm fuer den priester

*/

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein schwarzes Pentagramm");
  SetProp(P_LONG,BS(
  "In Deinen Haenden hast Du ein unheimliches, schwarzes Pentagramm. "
  "Es dient wohl einem Ritual!"));
  SetProp(P_VALUE,100000);
  SetProp(P_WEIGHT, 1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Pentagramm");
  SP(P_NAME_ADJ, "schwarz");
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_INFO, ("Irgendeinen Sinn wird das Pentragramm schon haben.\n"));
  
  
  AddId(({"pentagramm","DANTE_PENT"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}

