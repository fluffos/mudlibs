/*
der forscher fuer die olle quest
dante sl 2000 
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
#include <mnpc.h>

init()
{
  ::init();
if(interactive(TP))  {
call_out("hallo", 1); }

}


hallo()  {
object ob, ob1;
ob=present("DANTE_PFLANZEN_BUCH", TP);
 
 if(environment(TO)!=environment(TP)) return ;
 
 
 if(deep_present("DANTE_RIPPE", TP)) {
 write(BSA(
 "Na, weisst Du schon welchen Sinn die Rippe hat?!",
 "Stanley fragt: "));
     return ; }
 
 
 
 
    if(ob)  {
    write(BSA(
    "HE! Du hast ja das Buch! Herrlich! Danke sehr! Wie lange habe ich dieses"
    " Buch gesucht! Danke!",
    "Der Forscher sagt: "));
    write("\n");
 
    ob->remove();
 
 if(!deep_present("DANTE_RIPPE", TP))  {
    write(BS(
    "Du gibts dem Forscher das Buch und er gibt Dir dafuer eine seltsame Rippe!"));
    
    write(BSA(
    "Wozu sie gut ist, weiss ich nicht, aber sie hilft Dir sicher "
    "weiter.",
    "Stanley sagt: "));
    
     ob1=clone_object(KOBJ"rippe");
     ob1->move(TP, M_NOCHECK);
                                            }
                         return ;    }                   
    
    write(BSA(
    "Hallo! "+CAP_TPN+"! Was fuehrt Dich hier her!",
    "Stanley sagt: "));
    
    }






create()
{
 
  if (!is_clone(TO)) return;
      ::create();

  SetProp(P_SHORT, "Ein Forscher namens Stanley");
  SetProp(P_LONG, BS(
"Das ist Stanley, ein Forscher. Er erforscht die wilden Pflanzen des Dschungels. "
"Er lebt seit Jahren hier und ist durch die Einsamkeit eher schweigsam geworden. "
"Viel wirst Du von ihm nicht erfahren, doch vielleicht kanst Du ihm ja irgendwie helfen."));

SP(P_ARTICLE, 0);

  SetProp(P_NAME, "Stanley");
  SetProp(P_GENDER, MALE);
  AddId(({"stanley", "forscher"}));

  create_default_npc(13+random(5));
  SetProp(P_HANDS, ({" mit seinen Faeusten",140+random(20),DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180+random(20));
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 100);

  SetProp(P_MSGIN, "wandert interessiert herein");
  SetProp(P_MSGOUT, "wandert interessiert");
  SetProp(P_MMSGIN, "kommt hinter einem Busch hervor");
  SetProp(P_MMSGOUT, "verschwindet murmelnd im Busch");

  SetProp(P_DIE_MSG,  " haucht sein kurzes Forscherleben aus.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_MNPC_AREA, KROOM "fels");
  SetProp(P_MNPC_WAIT, ({10,20, 19}));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS + MOV_OUTDOORS); 
  SetProp(P_MNPC_DEFAULTROOM, KROOM "fels5");
  







  AddInfo(DEFAULT_INFO, ({
  "sagt: Hmm, mich interessieren vor allem Pflanzen!\n",
  "sieht sich eine kleine Pflanze an.\n",
  "sagt: Pflanzen sind mein Leben!\n",
  "sagt: Ich kenne mich nirgendwo ausser bei Pflanzen aus!\n",
  "sagt: Die Kannibalen tun mir nichts!\n",
  "deutet auf eine grosse, schoene Pflanze!\n"}));
  

  AddInfo(({"priester","kannibalenpriester"}),
   "Er ist der maechtigste aller Kannibalen.","sagt: ");
  AddInfo(({"kannibale","kannibalen"}),
  "Hmm, mir machen sie nichts! Sie leben eher im Nordosten von hier.", "sagt: ");

AI("rippe",
"Ich habe sie gefunden! Keine Ahnung wozu sie dient!",
"sagt: ");

AI(({"pflanze","pflanzen"}),
"Ich sammle und erforsche alle Pflanzen des Dschungels schon seit vielen "
"Jahren. Doch momentan habe ich eine Krise!!", "sagt: ");
AI("dschungel",
"Der Dschungel ist voller herrlichster Pflanzen!", "sagt: ");
AI("krise",
"Tja, das ist so ein Problem!", "sagt: ");
AI("problem",
"Ich stecke in einer Krise! Das ist mein Problem!", "sagt: ");
AI(({"quest","hilfe","abenteuer"}),
"Alles fein, aber mir hilft das nicht weiter!", "sagt: ");
AI("buch",
"Welches Buch meinst Du denn?!\n", "sagt: ");
AI("pflanzenbuch",
"JA!!! GENAU! Ich habe mein Pflanzenbuch verloren oder man hat es mir "
"gestohlen! Bring es mir und ich helfe Dir sicher!", "sagt: ");


/* Es gibt da so einen boesen Pflanzentrollmagier, ich glaube der "
"hat es!", "sagt: ");
AI(({"pflanzentrollmagier", "trollmagier","troll"}),
"Er heisst Harlinberg und wohnt irgendwo hier im Sueden.", "sagt: ");
AI(({"harlinberg", "sueden"}),
"Wo genau er wohnt keine Ahnung, aber ich denke ich kann Dir helfen, wenn "
"Du mir das Pflanzenbuch
 */
    
  SetProp( P_REJECT, ({ REJECT_KEEP,
   "Stanley sagt: Hmm, nicht schoen das!\n"}));
  
  SetProp(P_SPELLRATE, 50);
  
  AddSpell(1, 200,
    "Stanley tritt Dir ins Knie.\n",
    "Stanley tritt @WEM ins Knie!\n"
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
   "Stanley schlaegt Dir ins Gesicht.\n",
    "Stanley schlaegt @WEM ins Gesicht\n"
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));



  SetChats(3, ({
   "Stanley bueckt sich um eine Pflanze aufzuheben.\n",
   "Stanley sagt: Die Pflanzen sind alles was ich habe!\n",
    "Stanley sagt: Irgendwann werde ich beruehmt sein!\n",
   "Stanley sagt: Verflucht! Wo kann es nur sein!!!\n",
    "Stanley sagt: Wo kann nur das verfluchte Pflanzenbuch sein!\n",
   "Stanley sucht eine kleine, seltene Pflanze.\n"
   "Stanley schaut sich eine gelbe Pflanze genau an.\n",
   "Stanley sucht irgendetwas, aber was...\n",
   "Stanley sagt: Hmm, wo habe ich das nur verloren?!\n"}));
             
  SUID;
    CLONEME("/p/weapon/messer"); 
      command("zuecke messer");
     
   CLONEME(KARMOUR "dleinenhemd");
   CLONEME(KARMOUR "dlederhut");
   CLONEME(KARMOUR "dleggins");

 
  command("trage alles");

}
