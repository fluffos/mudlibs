//kobra fuer quest!! dante 97



inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../kani.h"
#include <new_skills.h>

 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Koenig der Kobras");
  SetProp(P_LONG, BS(
  "Das ist der Koenig der Kobras. Er ist groesser, staerker und natuerlich "
  "auch viel laenger als Du! Er ist ein sehr starker Gegner, also huete Dich vor ihm, "
  "auch wenn er nicht aggressive ist."));
  
  
  SetProp(P_NAME, "Koenig der Kobras");
  SetProp(P_GENDER, MALE);
  AddId(({"schlange", "kobra","koenig", "koenigskobra"}));

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen Giftzaehnen",350+random(20),({DT_POISON,DT_PIERCE}) }) );
  SetProp(P_SIZE, 10000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 15);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC,10);
  
  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "schlaengelt herein");
  SetProp(P_MMSGOUT, "schlaengelt hinaus");

  SetProp(P_DIE_MSG,  " zischt Dich nie wieder an.\n");

  AddInfo(DEFAULT_INFO, "zischt Dich nur boese an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Kobra braucht Deinen Muell nicht.\n" }) );

  AddInfo("zahn",
  "Du meinst meinen Giftzahn!?","sagt: ");
  AddInfo("giftzahn",
  "Den bekommst Du nie!","sagt: ");

  AddInfo(({"mungo","mungos"}),
  "Der schlimmste von ihnen ist ihr Koenig.","sagt: ");

  AddInfo(({"koenig", "mungokoenig"}), 
  "Den Mungokoenig hassen wir Schlangen!", "sagt: ");
  

  
  SetProp(P_SPELLRATE,50);
  AddSpell(4,400,
    "Der Koenig der Kobras schlaegt seine Zaehne in Dein Fleisch.\n",
    "Der Koenig der Kobras schlaegt seine Zaehne in @WESSEN Fleisch.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,500,   
    "Der Koenig der Kobras spuckt Dir Gift in die Augen.\n",
    "Der Koenig der Kobras spuckt @WEM Gift in die Augen.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
     AddSpell(1,500,   
    "Der Koenig der Kobras erwuergt Dich beinahe.\n",
    "Die Koenig der Kobras erwuergt @WEN beinahe.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
     AddSpell(5,400,   
    "Der Koenig der Kobras zerfetzt Dein Bein.\n",
    "Der Koenig der Kobras zerfetzt @WESSEN Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(1,1,DS_POISON);
  
  SetChats(3, ({
  "Der Koenig der Kobras zischt Dich boese an.\n",
  "Der koenig der KObras richtet sich auf.\n",
  "Der koenig der Kobras schnappt nach Dir.\n",
  "Du bekreuzigst Dich aengstlich.\n",
  "Der Koenig der Kobras beobachtet Dich genau.\n",
  "Der Koenig der Kobras pfaucht Dich an.\n",
  "Der Koenig der Kobras beisst sich in den Schwanz.\n",
  "Der Koenig der Kobras schlaengelt naeher an Dich heran.\n",
  "Der Koenig der Kobras schlaengelt zwischen Deinen Beinen durch.\n"}) );
  
}
  
  
  
    _query_wimpy() { return 0;}
  
  
 Defend(int dam, string dtype, int spell, object enemy)
   {
   object power;
   power=present("MUNGOPOWER", TP);

 if(!power)  {
 
 return ::Defend(dam/10, dtype, spell, enemy);  
 
  }

 
 if(power)  {

 

   tell_object(enemy,
"Mit der Kraft von 1000 Mungos stuermst Du auf den Koenig der Kobras ein!\n"
"Der Koenig der Kobras bruellt und zischt in Todesagonie auf!\n");
   
 return ::Defend(dam*5, dtype, spell, enemy);


     }



    }

  
  
die(arg)  {
    
    object zahn;
    if(!deep_present("DANTE_KOBRAZAHN", TP))  {
    	zahn=clone_object(KOBJ"kzahn");
    	zahn->move(TP, M_NOCHECK);
    write(BS(
    "Als der Koenig stirbt, brichst Du ihm schnell noch einen Zahn aus!"));
    	}
   ::die(arg);
        
        }
    
            
