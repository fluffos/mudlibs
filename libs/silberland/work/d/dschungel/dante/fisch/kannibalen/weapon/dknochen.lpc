// ein mieser knochen dante 97 jaenner
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
inherit "std/weapon";

create()
{
 if (!is_clone(TO) ) return;
  :: create();
  
  SetProp(P_SHORT, ("ein Knochen"));
  SetProp(P_LONG, (
  "Dieser Knochen hat einmal einem Abenteurer wie Dir gehoert. An seiner "
  "Oberflaeche fallen Dir merkwuerdige Einkerbungen auf. Er ist ziemlich "
  "schwer und sicher auch als Waffe zu gebrauchen.\n"));
  SetProp(P_NAME, "Knochen");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 150);
  SetProp(P_WC, 20);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 70);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  AddId("knochen");
  AddDetail(({"einkerbung","einkerbungen","oberflaeche"}),
   "Mit Grausen stellst Du fest, dass die Einkerbungen von Zaehnen "
   "wilder Tiere herruehren. Den frueheren Besitzer muss ein furchtbares"
   " Schicksal ereilt haben...\n");
   }
  
  
  
  
  