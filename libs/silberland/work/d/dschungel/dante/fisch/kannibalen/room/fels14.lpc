// auf einer felstreppe

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer schmalen Felstreppe" );
  SetProp( P_INT_LONG, BS(
  "Du stehst auf einer schmalen Felstreppe, umgeben von blankem Fels."
  "Die Steintreppe fuehrt weiter nach oben, auf den Gipfel dieses "
  "kleinen Berges. Dir kommt langsam in den Sinn, dass es sich hier "
  "um eine Kultstaette der Kannibalen handeln koennte. Wir man Dich, "
  "wenn Du oben angekommen bist, opfern und dann auffressen?! "
  "Ausser "
  "einem auffaeligen Fleck, kannst Du hier nichts Interessantes erkennen."));
  
  AD(({"berg"}),
  "Auf dem Gipfel dieses kleinen Berges befindet sich eine Kultstaette der "
  "Kannibalen.");
  AD(({"kannibale","kannibalen"}),
  "Sie sehen es nicht gerne wenn Du weiter nach oben gehst. Sie werden sicher "
  "alles versuchen um Dich zu toeten.");
  
  AD(({"kult","staette","kultstaette"}),
  "Die Kannibalen feiern hier ihre grausamen Rituale, wobei sie ihre "
  "Opfer ins Feuer werfen und dann wenn sie gar sind auffressen.");
  AD(({"ritual","rituale"}),
  "Noch kein Opfer hat das ueberlebt.");
  AD("opfer",
  "Wirst Du eines werden?!");
  AD("feuer",
  "Dort oben brennt es.");
  
  
  
  
  
  AD("himmel",
  "Der Himmel wird nun wieder etwas dunkler.");
  
  AD("interessantes",
  "Der Berg alleine ist schon sehr interessant.");
  AD("sinn",
  "Der Sinn dieses Berges ist es Dich zu opfern!");
  
  AddDetail(("fleck"),
  "Als Du den Fleck genauer betrachtest, erkennst Du das es sich um eine"
  "Blutlache handelt.\n");
  AddDetail(({"blut","blutlache","lache"}),
  "Von wem die wohl stammen mag?\n");
  AddDetail(({"lacke","blutlacke"}),
  "Dante teilt Dir mit: Das korrekte Wort ist Lache.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
AD("dante",
". o 0 'Hmm?!'");

  AddDetail(("gipfel"),
  "Der Gipfel ist von hier aus nicht zu erkennen, aber geh ruhig rauf...\n");
  AddDetail(({"stein","fels"}),
  
  "Hier ist eigentlich alles aus Stein.\n");
  AddDetail(({"treppe","felstreppe","steintreppe"}),
  "Die Steintreppe wurde in muehseliger Arbeit aus dem Stein gehauen. Sie\n"
  "fuehrt steil nach oben, aber wo genau hin kann man nicht erkennen.\n");
  
AD("arbeit",
"Es muss sehr lange gedauert haben bis sie fertig war.");
  
  AddDetail( ("boden"),
  "Der Boden besteht aus behauenem Stein.\n");
  AddDetail(("sonne"),
  "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich\n"
   "herab.\n");
  AddDetail(("erbauer"),
   "Sei froh, dass der gerade nicht da ist.\n");
 
  AddSound( DEFAULT_SOUND,
    "Vom Gipfel hoerst Du Stimmen, kannst aber nichts genaueres verstehen.");
    AddSound(({"stimme","stimmen"}),
 "Du kannst nicht verstehen, was da oben los ist.");
  AddSmell( DEFAULT_SMELL,
    "Schon wieder dieser Geruch nach Feuer...");
AddSmell(({"feuer","geruch"}),
 "Es riecht verbrannt.");      

// AddItem( ({NPC_WEG"dmoskito", NPC_WEG "dstechmuecke"}), REFRESH_DESTRUCT);
 
ASE("oben", "go_oben");
 AddExit( "unten", "./fels13");  
}


init()  {
	::init();
if(interactive(TP))  {
if(!random(5))  {
call_out("ui", 1+random(3));  }  }
}

ui()  {
	if(environment(TP)!=TO) return;

write(BS(
"Du rutscht auf dem Felsen aus und faellst wieder nach unten."));
say(BS(
CAP_TPN+" rutscht auf dem Felsen aus!"));
TP->do_damage(5);
TPM("d/dschungel/dante/fisch/kannibalen/room/fels13", M_GO,
"wieder nach unten", "faellt", "faellt von oben herab");
     }



int go_oben()
 {
TPM(KROOM"fels15:"+getuid(TP), 
M_GO+M_NOCHECK,
"nach oben", "geht","kommt herein");
 previous_object()->CustomizeObject();   
return 1;}

