//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../kani.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Mungokraut");

  SetProp(P_LONG,BS(
"Du siehst eine kleine, blau schimmernde Pflanze vor Dir. Ein Mungokraut. "
"Mungos schuetzen sich damit gegen das Gift der Schlangen. Du kannst es sicher "
"noch gut gebrauchen."));

  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Mungokraut");
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:100]));
  AddId(({"mungokraut","kraut","MUNGO_KRAUT"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}
