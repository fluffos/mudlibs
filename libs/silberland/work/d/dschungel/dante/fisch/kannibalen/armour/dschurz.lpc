/*
** 
** lendenschurz fuer die kanibalen 
**
*/
#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ("schurz");
  SetProp (P_SHORT, "Ein Lendenschurz");
  SetProp (P_LONG, "Der Lendenschurz gehoerte einst einem Kannibalen.\n");
                           
  SetProp (P_NAME, "Lendenschurz");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 300);

  SetProp (P_ARMOUR_TYPE, AT_TROUSERS);  // siehe sys/combat.h
  SetProp (P_AC, 3);
  SetProp (P_MATERIAL, MAT_LEATHER);
}
