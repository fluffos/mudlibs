// a, felsen 2  by dante 97

#include "./files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int da=1;

reset()  {
	::reset();
     da=1;	
     }


void gebein_da() {
	write(BS(
"Du hoerst wie irgendwo hier Gebeine rumpeln..."));
	
	da=1;  }



create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du folgst dem kleinen Pfad und gelangst zu einer kleinen Huette, die hier "
  "einsam und verlassen mitten im Dschungel steht. Ringsum die Huette wuchern "
  "wild die Pflanzen. "
  "Die Huette sieht nicht gerade einladend aus. Sie scheint schon lange verlassen "
  "zu sein, was nicht gerade Deine Stimmung hebt."));
  
  AD("pfad",
  "Der Pfad scheint hier an der Huette zu enden.");
  AD(({"pflanze","pflanzen"}),
  "Hier wuchern die Pflanzen die Huette wieder zu.");
  AddDetail(("grab"),
  "Das Grab scheint schon sehr alt zu sein. Weder Blumen noch irgendeinanderer Schmuck "
  "ist zu sehn, nur ein verblichener Grabstein ist die einzige Zierde.");
  AddDetail(("zierde"),
  "Der Grabstein steht am Ende des Grabes und ist auch schon schwer gezeichnet vom Klima des Dschungels.");
  AddDetail(({"stein","steine"}),
  "Am Boden liegen einige kleine Steine herum...");
  AddDetail(("grabstein"),
  "Der Grabstein ist ein schlichter grauer Felsblock. Jemand hat ihn grob zugehauen "
  "und Etwas eingemeiselt...");
  AddDetail(("etwas"),
  "Das Etwas ist ein kaum mehr zu lesender Schriftzug...");
  AddDetail(("schriftzug"),
  "Du kannst ihn lesen.");
  AddReadDetail(("schriftzug"),
  "\n"
  "Hier ruhen die Gebeine meiner Kameraden!  Gott moege ihnen gnaedig sein!\n"
  "\n"
  "Im 3. Jahre unsere unseligen Dschungelexpedition bin nunmehr nur noch ich am Leben. "
  "Kannibalen, wilde Tiere und die Malaria haben allen meinen Kameraden das Leben "
  "gekostet, darum gebe ich die Forschungsstation auf.\n"
  "Ich glaube, ich habe einen schweren Fehler gemacht, weil ich\n"
  "meine Kameraden in einem alten Kannibalengrab beerdigt habe.\n"
  "Der Totengott der Kannibalen soll uns verflucht haben...\n"
  "Hier endet der Text. Der Schreiber muss wohl in seiner Arbeit gestoert worden sein!\n");
  AddDetail(({"blumen","blume","schmuck"}),
  "Niemand scheint sich um die Toten zu kuemmern.");
  AddDetail(({"toter","toten","tote"}),
  "Vielleicht liegst Du auch bald hier...");
  AddReadDetail(("schild"),
  "Das Schild ist zu verwittert um es noch zu lesen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im "
    "Dschungel erhebt.");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten "
  "Wind ertraeglicher gemacht.");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.");
  AddDetail(("himmel"),
  "Der HImmel ist strahlendblau.");
  AddDetail(("boden"),
  "Der Boden weist keinerlei Besonderheiten auf.");
  AddDetail(({"besonderheiten","besonderheit"}),
  "Du siehst keine Besonderheiten.");
  AddDetail(("huette"),
  "Die Huette ist aus solidem Holz erbaut, doch der Zahn der Zeit hat ihr "
  "offensichtlich schwer zugesetzt. Die Fensterlaeden haengen nur mehr schief "
  "im Wind und das Dach scheint auch schon loechrig zu sein. Einzig die kleine "
  "Holztuere scheint Dir noch einen stabilen Eindruck zu erwecken.");
  AddDetail(("dach"),
  "Viel kannst Du von hier unten nicht erkennen, aber es macht einen sehr desolaten Eindruck.");
  AddDetail(("eindruck"),
  "Der Eindruck ist schlecht.");
  AddDetail(({"fensterladen","laden","laeden","fensterlaeden"}),
  "Die Fensterlaeden haengen nur mehr sehr locker und geben einen Blick auf die "
  "Fenster frei...");
  AD(({"blick","innere"}),
  "Man kann nicht ins Innere der Huette sehen.");
  AddDetail(("fenster"),
  "Die Fenster sind voellig verschmutzt und beschlagen, sodass man nicht ins Innere "
  "der Huette schauen kann.");
  AddDetail(({"tuer","holztuer","tuere","holztuere"}),
  "Die Holztuere ist noch gut erhalten und scheint verschlossen zu sein. Ein kleines "
  "Schild haengt neben ihr...");
  AddDetail(("schild"),
  "Du versuchst es zu entziffern, doch vergeblich...");
  AD("stimmung",
  "Schlecht...");
  AD("brise",
  "Der Wind macht den Dschungel etwas angenehmer.");
  AddDetail(("holz"),
  "Das Holz war einst sicher hart und zaeh, doch nun ist es morsch und verfault langsam.");
  AddDetail(("zeit"),
  "Die Zeit spielt uns allen uebel mit.");
  AddDetail(("zahn"),
  "Er nagt immer...");
  AddDetail(("loch"),
  "Direkt hinter dem Grabstein siehst Du ein Loch, das sicher gross genug ist "
  "um hinunterzusteigen. Doch ob es ratsam ist in ein Grab zu klettern ?");
  
  AddSound( DEFAULT_SOUND,
    "Hier ist es totenstill.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht hier nach einem Grab.");
AddSmell("grab",
"Ja, wirklich, da ist eines!!!");

  AddCmd(({"oeffne","oeffnen"}), "auf");

  AddCmd(({"kletter","klettere","steige","steig"}), "down");
  
  ASD(({"gebein","gebeine"}), "fun_gebeine");
  
  ACD(({"raeume","raeum","raeumen"}), "gebeine_weg");
}

int gebeine_weg(string str)  {
   
   NF("Was willst Du wegraeumen?!\n");

   if(str=="gebeine weg"||str=="gebein weg" )  {
	
         if(da==1)  {

     write(BS(
     "Du raeumst mit Ekel die Gebeine beiseite!"));
     say(BS(
     CAP_TPN+" raeumt mit Ekel etwas weg."));
      da=0;
  
    if(find_call_out("gebein_da")==-1)  {
    call_out("gebein_da", 30);
                        }
  
     return 1; }

write(BS(
"Die Gebeine wurden schon beiseite geraeumt."));
    return 1; }
return 0;
}



string fun_gebeine()  {
	if(da==1)  {

return BS("Alte Gebeine, die einfach "
"so herumliegen versperren den Weg! Man sollte sie weg raeumen...");
    }

return BS(
"Die Gebeine wurden beiseite geraeumt. Man kann nun hinunter.");
     }




  int down (string str)
   {
    notify_fail("Wo willst Du hier hinuntersteigen ?\n");
    if ( !str)
    return 0;
    
    
if(str=="runter"||str=="in grab"||str=="in grab hinein"||
str=="hinunter"||str=="hinunter in grab"||str=="hinab in grab"||
"in grab hinunter") {


if(da==1)  {
	write(BS(
"Du willst durch das Loch nach unten, aber alte Gebeine, die einfach "
"so herumliegen versperren den Weg!"));
  return 1; }	

write(
"Du nimmst allen Mut zusammen und steigst in das Grab hinab.\n\n"
"Dunkelheit und Stille umgeben Dich!\n");
    
    TP->move(KROOM"kata1", M_GO+M_NO_SHOW,
    "allen Mut zusammen und steigt hinunter in das Grab","steigt",
    "kommt von oben in das Grab gestiegen");
    
    return 1;
    }
    return 0;
    }

  int auf (string str)
   {
    notify_fail("Was willst Du hier oeffnen ?\n");
    if ( !str)
    return 0;
    
    
    if ( member( ({"tuer","holztuer","tuere","holztuere"}),str ) !=-1 )
    {
    write("Du versuchst die alte Holztuere zu oeffnen, aber sie scheint verklemmt zu sein. "
    "Allerdings bemerkst Du dabei ein grosses Loch hinter dem Grabstein.\n");
    return 1;
    }
    return 0;
    }
