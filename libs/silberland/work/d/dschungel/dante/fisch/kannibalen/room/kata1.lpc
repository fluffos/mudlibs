// dante@SilberLand

#include "./def.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem unterirdischen Grab" );
  SetProp( P_INT_LONG, BS(
    "Du steckst mitten in einem dunklen, duesteren Grab. Die Waende sind aus dunklem "
    "Lehm, der feucht und broeckelig aussieht. Trotzdem kann man Malereien, "
    "die sehr bedrohlich auf Dich wirken erkennen. Ober Dir in der Decke, "
    "klafft das Loch, durch das Du herabgekommen bist. Wohl und gemuetlich "
    "fuehlst Du ich hier in dieser unheimlichen Stille nicht."));
    
    AD("stille",
    "Stille...");
  
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );

AD("ausgang",
"Nach oben kannst Du fluechten...");
  AddDetail( ({ "erde" }),
    "Ueber Dir, unter Dir, ueberall ist Erde...");
  AddDetail(("grab"),
   "Du steckst sozusagen mitten zwischen den Toten.");
   AddDetail(({"tote","toter","toten"}),
   "Vielleicht kommt ja bald einer zu Dir.");
  AddDetail(("boden"),
  "Der Boden ist weich und modrig.");
  AddDetail(({"wand","waende"}),
  "Die Waende sind dunkel und feucht, aber man kann noch Malereien erkennen.");
  AD(({"malerei","malereien"}),
  "Die Malereien stellen einen Totengott der Kannibalen dar.");
  AD(({"kannibale","kannibalen"}),
  "Die Kannibalen haben hier ihre Toten beerdigt. Naja, die Toten, die "
  "sie nicht gleich selbst verspeist haben...");
  AD(({"gott","totengott"}),
  "Der Totengott der Kannibalen ist ein grausames Monster, das jeden Toten "
  "selbst verspeist.");
  AD("monster",
  "Die Malereien wirken unheimlich und bedrohlich. Zwischen ihnen entdeckst Du einen "
  "scheinbar versteckten Ausgang nach Nordoben");
  AD("nordoben",
  "Ja, tatsaechlich, so scheint man weiter zu kommen.");
  
  
 
  AddDetail(("decke"),
  "Die Decke ist sehr niedrig. Man kann ein Loch erkennen.");
  AddDetail(("loch"),
  "Durch das Loch kommst du hier wieder hinaus.");
  AddSound( DEFAULT_SOUND,
    "Hier ist es totenstill.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Lehm.");
  AddSmell("lehm",
  "Der Lehm riecht feucht.");

 AddItem(KNPC "dmumie" , REFRESH_DESTRUCT);

ACD(({"nordoben"}), "up");
  AddExit( "raus", "./kata0" );
}

string up()  {
	if(present("mumie", TO))  {
	
	write(BS(
	"Die Mumie hindert Dich daran!"));
               return "";
               
               }
write(BS(
"Du kriechst weiter nach Nordoben."));

return TPM(KROOM"kata2", M_GO, "in die Dunkelheit","kriecht",
"kriecht herein");
            }	