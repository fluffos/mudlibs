// in einer felsnische

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define LOOT (member(loot, getuid(this_player()))!=-1)
string *loot=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Felsnische" );
  SetProp( P_INT_LONG, BS(
    "Du  befindest Dich in einer kleinen Felsnische. Das Seil endet "
    "hier und weiter nach oben fuehrt eine in den Stein gemeisselte Treppe."
    "Der Gipfel ist von hier aus kaum zu sehen, aber weit kann er nicht "
    "mehr sein. In einer Ecke siehst Du ein grosses Vogelnest."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );


/*
  Feuer, Geruch,  Steintreppe, Stimmen, Ursprungs
*/



AD("himmel",
"Du kommst dem Himmel immer naeher.");



  AddDetail(({"nest","vogelnest"}),
  "Dieses Nest gehoert einem grossen Geier. Komischwerweise siehst Du aber "
  "keine Eier im Nest. ");
  AD(({"ei","eier"}),
  "Hmm, das nest wurde wohl ausgeraubt!");
  
  AddDetail(({"eck","ecke"}),
  "In einer Ecke der Felsnische hat ein Geierpaerchen ein grosses Nest "
  "errichtet. ");
  AddDetail(("gipfel"),
  "Der Gipfel ist von hier aus nicht zu erkennen, aber geh ruhig rauf...\n");
  AddDetail(("stein"),
  "Hier ist eigentlich alles aus Stein.\n");
  AddDetail(("seil"),
  "Das Seil ist an einem Felsvorsprung angebunden.\n"),
  AddDetail(({"vorsprung","felsvorsprung"}),
  "Der Felsvorsprung ist natuerlichen Ursprungs, aber geradezu ideal um "
  "das Seil hier anzuknuepfen.\n");
  AD("ursprung",
  "Sei froh, dass hier bereits ein Seil haengt.");
  
  AddDetail(({"treppe","steintreppe"}),
  "Die Steintreppe wurde in muehseliger Arbeit aus dem Stein gehauen. Sie "
  "fuehrt steil nach oben, aber wo genau hin kann man nicht erkennen.");
  AddDetail(({"nische","felsnische"}),
  "Die Nische in der Du Dich gerade befindest, ist gerade gross genug um\n"
  "Dir einen sicheren Standplatz zu bieten.\n");
  
  AD("arbeit",
  "Arbeit stinkt!");
  
  AD(({"geierpaerchen","paerchen"}),
  "Das Nest ist sehr interessant. Man sollte es durchwuehlen! Aber koennten dann "
  "nicht die Geier sehr sauer werden?!");
  
  
  AddDetail( ("boden"),
  "Den Boden kannst Du von hier oben nicht erkennen.\n");
  AddDetail(("sonne"),
  "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich\n"
   "herab.\n");
  AddDetail(({"blaetter","ast","aeste","blaettern","aesten","pflanze","pflanzen"}),
   "Gruen, gruen, gruen, alles nur gruen...\n");
  AddDetail(({"platz","standplatz"}),
   "Wie schon erwaehnt, davon ist hier nicht allzu viel.\n");
  AddDetail(("erbauer"),
   "Sei froh, dass der gerade nicht da ist.\n");
 
  AddSound( DEFAULT_SOUND,
    "Vom Gipfel hoerst Du Stimmen, kannst aber nichts genaueres verstehen.");
 
 AddSound(({"stimme","stimmen"}),
 "Du kannst nicht verstehen, was da oben los ist.");
 
    
  AddSmell( DEFAULT_SMELL,
    "Schon wieder dieser Geruch nach Feuer...");
 
 
 AddSmell(({"feuer","geruch"}),
 "Es riecht verbrannt.");
 
 
  AddItem(NPC_WEG"dgeier" , REFRESH_DESTRUCT);
  
 AddCmd(( {"hangel", "hangle", "hantel", "hantle"}), "hangel");

ASE("oben", "check");  
ACD(({"wuehle","durchwuehle"}), "looting");

}

int looting(string str)   {
  object ob;
  
    NF("Was willst Du durchwuehlen?\n");
   ob=present("geier", TO);

if(str=="nest"||str=="vogelnest")  {	
   
   say(BS(CAP_TPN+" durchwuehlt ein Vogelnest!"));
   
   if(ob)  {
  ob->Kill(TP);
    }

   
   if(LOOT)  {
   
   write(BS(
   	"Wie oft willst Du es noch durchwuehlen?!"));
   return 1; }
   	

  if(!LOOT)  {
 write(BS(
 "Du durchwuehlst das Vogelnest. Du findest nichts und das Nest wird sehr "
 "langweilig fuer Dich. Also weiter nach oben!"));
 loot += ({getuid(this_player())});    
     return 1; }

  return 0; }
 return 0; }
 

int check()  {
  
  if(LOOT)  {
  write(BS(
  "Du gehst weiter nach oben."));
  TPM(KROOM"fels14", M_GO, "weiter nach oben", "geht", "kommt von unten herauf");
  return 1; }
  
 if(!LOOT)  {
 	write(BS(
 "Du willst nach oben, aber irgendwie kannst Du Dich von dem Vogelnest nicht losreissen."));
 return 1; }
 }
	



 int hangel(string str )
{
  notify_fail( "Wohin willst Du?\n" );
  if( !str ) return 0; 
  if( member( ({"an seil nach unten", "an seil runter", "an seil hinunter", "mit seil runter", "mit seil nach unten",
                "mit seil hinuter " , "auf seil nach unten", "auf seil runter" , "auf seil hinunter"}),str) !=-1 )
    
    {
    write("Du hangelst Dich am Seil nach unten.\n");
    TP->move(KROOM"fels11", M_GO, "nach unten","klettert"
      "kommt von oben herab geklettert");
      
    return 1;
       }
  return 0;
     }
