#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


create()
{
  ::create();


  SetProp( P_INT_SHORT, "Im Vorgarten einer Blockhuette" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich nun im Vorgarten einer kleinen Blockhuette, die mitten "
  "im dichtesten Dschungel liegt. Im Osten liegt eine kleine Lichtung, im Westen "
  "die Huette, sonst bist Du ueberall von Dickicht umgeben. Der Garten besteht eigentlich "
  "nur aus einigen kleinen Beeten, in denen irgendjemand versucht Gemuese anzubauen."));
  
  AddDetail(("dickicht"),
  "Das Dickicht ist hier nicht ganz so dicht wie sonst.");
  
  AddDetail(({"garten","vorgarten"}),
  "Der Garten besteht eigentlich nur aus einigen kleinen Beeten.");
  AddDetail(("beete"),
  "In den Beeten waechst verschiedenes Gemuese, teilweise schon reif, teilweise "
  "noch unreif.");
  AddDetail(("gemuese"),
  "Die meisten Sorten kennst Du nicht, nur Karotten kommen die bekannt vor.");
  AddDetail(({"sorte","sorten"}),
  "Du kennst keine davon.");
  AddDetail(({"karotte","karotten"}),
  "Lecker und orange lachen sie Dich an.");
  AddDetail(("holz"),
  "Die Staemme, aus denen die Huette gebaut wurde, sind aus hartem Holz hiesiger Baeume.");
  AddDetail(({"baum","baeume"}),
  "Die Baeume wurden gefaellt, also sind sie kaum mehr hier.");
  AddDetail(("westen"),
  "Im Westen des Gartens liegt die Blockhuette.");
  AddDetail(("osten"),
  "Im Osten befindet sich die kleine Lichtung.");
  AddDetail(("blockhuette"),
  "Die Blockhuette wurde aus groben Staemmen gezimmert und trotz hier schon "
  "viele Jahre dem Dschungel. Eine kleine Tuer und ein schmales Fenster sind "
  "alles was Du von hier erkennen kannst. Das Dach ist flach und mit Moos bewachsen.");
  AddDetail(("huette"),
  "Es scheint sich um eine Blockhuette zu handeln.");
  AddDetail(("moos"),
  "Viele Jahre muss es schon auf dem Dach wuchern.");
  AddDetail(("dach"),
  "Das Dach ist aus flachen Staemmen gefertigt und mit einer schwarzen Masse angestrichen.");
  AddDetail(("masse"),
  "Du kennst diese Masse nicht.");
  AddDetail(("jahre"),
  "So wie die Huette ausschaut muss sie schon sehr alt sein.");
  AddDetail(({"stamm","staemme"}),
  "Hartes Holz aus dem Dschungel hat man fuer diese Blockhuette verwendet.");  
  AddDetail(({"pfad","ende"}),
  "Der Pfad liegt weiter im Osten.");
  AddDetail(("himmel"),
  "Strahlendblau und wolkenlos liegt der Himmel ueber Dir.");
  AddDetail(("weg"),
  "Ein kleiner Weg fuehrt durch die Beete direkt zur Tuer der Huette.");
  AddDetail(({"fenster"}),
  "Das Fenster ist nur sehr schmal. Fensterlaeden haengen vor ihm.");
  AddDetail(({"fensterlaeden","fensterladen"}),
  "Die Fensterladen sollen das Innere der Huette vor Unwettern schuetzen.");
  AddDetail(("innere"),
  "Was wohl in der Huette sein mag ?");
  AddDetail(("unwetter"),
  "Im Dschungel gibt es haeufig Unwetter...");
  AddDetail(("lichtung"),
  "Die Lichtung liegt weiter im Osten.");
  AddDetail(("boden"),
  "Der Boden ist hier sauber und frei von Unkraut. Die Erde scheint fruchtbar zu sein.");
  AD("unkraut",
  "Eben nicht.");
  
  AddDetail(("erde"),
  "Dier Erde ist in den Beeten braun und saftig. Nur ein kleiner Weg fuehrt direkt zur "
  "Tuer der Huette.");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Der Dschungel scheint hier etwas gerodet zu sein.");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst Laerm aus der Huette.");
   
   AddSound("laerm",
   "Hmm, wer ist das wohl..."); 
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark.");

  AddExit("osten", "./vorgarten");
  
   NewDoor("westen", (KROOM"huette1"),
    ({"tuer","holztuer"}),
     
      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
        D_LONG, "Die Tuer sieht stabil aus und ist ebenfalls aus Holz gefertigt.\n",
         D_GENDER, FEMALE,
          D_SHORT, "Eine %se Tuer.",
           D_NAME, "Tuer",
            } ));

 AddCmd(({"pflueck","pfluecke"}), "get_nix");
AddCmd(({"grabe","grab"}), "get");

}

 
 


int get(string str)  {
  object ob;


  NF("Wo willst Du hier graben? Und womit? Ohne Schaufel wird das nichts!?\n"
  "syntax <grabe mit schaufel in erde>!\n");
  

if(!str)  { write(BS(
"Du kannst hier nur mit einer Schaufel graben."));
return 1; }


  
  if(member(({"mit schaufel in erde",
              "mit schaufel",
              "erde mit schaufel um",
              "in erde mit schaufel",
              "in erde", "erde um"}),str)!=-1)  {
              
    if(!present("schaufel", TP)) { 

    write(BS("Du graebst mit blossen Haenden, doch das ist sinnlos. "
    "Nebenbei bemerkt, Du hast gar keine Schaufel!"));

    return 1;  }


    
    if(deep_present("DANTE_KAROTTE", TP)) {
    write(BS("Du graebst mit der Schaufel in der Erde herum. "
   "Doch kannst Du hier nichts finden."));
   
    return 1; }

      if(!deep_present("DANTE_EINSIEDLER_TAUSCH", TP)) {
    write(BS("Du graebst mit der Schaufel in der Erde herum. "
   "Doch kannst Du hier nichts finden."));
   
    return 1; }
    
    
    
    
    
    if(!present("DANTE_KAROTTE", TP))  {
    write(BS("Du graebst mit der Schaufel in der Erde herum. "
    "AH! Du findest doch noch eine Karotte."));
    ob=clone_object(KOBJ"karotte");
    ob->move(TP, M_NOCHECK);

    return 1; }

    return 0; }

return 0; }
    
        
    
  
 
 
 
 
int get_nix ( string str )
{
	object ob;
  notify_fail("Was willst Du pfluecken?\n");

  if(str != "karotte") return 0;
           

	write(BS(
  "Du stellst Dich viel zu dumm an um eine Karotte pfluecken zu koennen."));
  	
   return 1;
}
                            
