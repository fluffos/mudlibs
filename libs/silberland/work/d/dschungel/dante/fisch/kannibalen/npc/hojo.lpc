
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
#include <npc.h>

init()
{
  ::init();
if(interactive(TP))  {
call_out("hallo", 1); }

}


hallo()  {
 
 if(environment(TO)!=environment(TP)) return ;

write(BS(
"Hojo deutet Dir irgendetwas mit den Haenden! Sieht freundlich aus"));
    
    }






create()
{
 
  if (!is_clone(TO)) return;
      ::create();

  SetProp(P_SHORT, "Hojo, der Einsiedler");
  SetProp(P_LONG, BS(
"Das ist Hojo, der Einsiedler. Er ist stumm. Die Kannibalen haben ihm "
"im Kampf die Zunge abgebissen. Trotzdem kann er Dir hier etwas zu trinken "
"und essen geben."));
SP(P_ARTICLE, 0);

  SetProp(P_NAME, "Hojo");
  SetProp(P_GENDER, MALE);
  AddId(({"hojo", "NOWIMPY"}));

  create_default_npc(20+random(2));
  SetProp(P_HANDS, ({" mit seinen Faeusten",190+random(20),DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180+random(20));
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_MSGIN, "wandert interessiert herein");
  SetProp(P_MSGOUT, "wandert interessiert");
  SetProp(P_MMSGIN, "kommt hinter der Theke hervor");
  SetProp(P_MMSGOUT, "verschwindet murmelnd im Busch");

  SetProp(P_DIE_MSG,  " haucht sein Einsiedlerleben aus.\n");
  SetProp(P_NOCORPSE, 0 );







  AddInfo(DEFAULT_INFO, ({
  "deutet irgendetwas mit den Haenden!\n"}));
  

    
  SetProp( P_REJECT, ({ REJECT_KEEP,
   "Hojo laechelt Dir zu!\n"}));
  
  SetProp(P_SPELLRATE, 50);
  
  AddSpell(1, 200,
    "Hojo tritt Dir ins Knie.\n",
    "Hojo tritt @WEM ins Knie!\n"
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
   "Hojo schlaegt Dir ins Gesicht.\n",
    "Hojo schlaegt @WEM ins Gesicht\n"
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));



  SetChats(3, ({
   "Hojo bueckt sich um ein Glas.\n",
   "Hojo sucht eine kleine Flasche.\n",
   "Hojo deutet Dir irgendetwas.\n",
   "Hojo deutet Dur mehr zu trinken.\n",
   "Hojo deutet Dir mehr zu essen.\n",
   "Hojo zeigt Dir den Finger!!!\n",
   "Hojo schaut sich ein Glas genau an.\n",
   "Hojo sucht irgendetwas, aber was...\n",
   }));
             
  SUID;
    CLONEME("/p/weapon/messer"); 
      command("zuecke messer");
     
   CLONEME(KARMOUR "dleinenhemd");
   CLONEME(KARMOUR "dlederhut");
   CLONEME(KARMOUR "dleggins");

 
  command("trage alles");

}
