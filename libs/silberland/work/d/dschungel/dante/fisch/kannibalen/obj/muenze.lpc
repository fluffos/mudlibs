/*
muenze fuer spork dan te sl 97-2000
*/

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine seltsame Muenze aus Gold");
  SetProp(P_LONG,BS(
  "Diese Muenze weist Dir unbekannte Symbole auf. Wozu die wohl dient? "
  "Egal, wert ist sie sicher sehr viel, denn sie ist aus purem Gold!"));
  SetProp(P_VALUE,100000);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Goldmuenze");
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_INFO, ("Irgendeinen Sinn wird die Muenze schon haben.\n"));
  
  AddDetail(({"symbole","symbol"}),
  "Dir sagen diese Symbole nichts.");
  
  AddId(({"muenze","goldmuenze", "DANTE_MUENZE"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}

