/* hirn dante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Gehirn");
  SetProp (P_LONG, "Vor Dir siehst Du das Hirn eines kleinen Hobbitmaedchens. Es muss wohl"
          " schon lange hier gelegen haben, denn auf seiner Oberflaeche kriechen "
          "zahlreiche Wuermer herum.\n");  
  AddDetail(({"wuermer","wurm","oberflaeche"}),
  "Mit Ekel beobachtest Du die kleinen Tiere wie sie sich immer tiefer hinein fressen...\n");
  SetProp (P_NAME, "Gehirn");
  SetProp (P_GENDER, NEUTER);
  AddId (({"gehirn","hirn"}));
  SetProp (P_INFO, ("Es kann nicht ratsam sein diese Gehirn zu essen..."));
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, ([MAT_MISC_DEAD:100]));
  SetProp (P_FOOD_INFO, ([F_HEAL: -10, F_SOAK: 8, F_ALCOHOL: 2, F_POISON:1]));
}

BeimEssen()
{
  write ("Du isst das Hirn mit einem schlechten Gefuehl.\n");
  say (TPN+" verspeisst das Hirn mit seltsamen Gesichtsausdruck.\n");
  return ::BeimEssen();
}
