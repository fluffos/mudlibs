/* eine mumie fuer die pyramide von dante fuer sl/dschungel jaenner 97*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../kani.h"
#include <class.h>
#include <new_skills.h>
#include <npc.h>
#include <wizlevels.h>
 
create()
{
object cash;
 if (!is_clone(this_object())) return;
 :: create();
 
 SetProp(P_SHORT, "Eine starre Mumie");
 SetProp(P_LONG, BS(
    "Eine uralte, finster dreinblickende Mumie. In ihren dunklen Augenhoehlen"
    " schlaengeln sich kleine schwarze Schlangen, die Dich boese anzischen!"
    " Die Mumie aber scheint voellig starr zu sein und bewegt sich nicht. "
    "Du brauchst keine Angst vor ihr zu haben? Oder doch?!"));
 
 AddDetail(({"schlangen","augenhoehlen"}),
    "Die schwarzen, sicherlich giftigen Schlangen sind zwar sehr klein, aber"
       " dafuer um so aggressiver. Von ihnen gebissen zu werden, koennte schlimme"
       " Folgen fuer Dich haben!");
 
 SetProp(P_GENDER, FEMALE);
 create_default_npc (20);
  
 SetProp(P_DIE_MSG,  " zerfaellt zu Staub.\n");    
 
 SP(P_INFO, BS(
 "Traue der Mumie nicht!!!"));
 
 SP(P_NAME_ADJ, "starr");
 SetProp(P_NAME, "Mumie");
 AddId("mumie");
 AddClass(CL_UNDEAD);
 SetProp(P_HEAL, 0);
 SetProp(P_RACE, "Mumie");
 SetProp(P_ALIGN, -300);
 SetProp(P_HANDS, ({" mit ihren verfaulten Stuempfen", 150,({DT_ACID,DT_BLUDGEON})}));
 SetProp(P_SIZE, 180);
 SetProp(P_DEFAULT_INFO,"fluestert: Verschwinde solange Du noch kannst!\n");
 SetProp(P_MAX_HANDS, 2);
 SetProp(P_AGGRESSIVE, 0.05);
 SP(P_NOCORPSE, 1);
 AddInfo("dante",
         "fluestert: Er hat mich erschaffen!\n");
 
 SetAttackChats(10,({
 "Die Mumie scheint Dich anzugrinsen.\n",
 "Die Mumie kommt immer naeher.\n",
 "Die Mumie scheint zu zerfallen...\n",
 "Die Mumie stoehnt laut.\n",
 "Die Mumie eitert aus ihren Wunden...\n"}));
 
 SetProp(P_REJECT, ({REJECT_DROP, "Die Mumie sagt: Was soll ich mit dem Muell?\n" }));
 
 SetProp(P_SPELLRATE, 90);
      
 AddSpell(2,400,
         " Die Mumie bohrt Dir einen Finger ins Auge.\n",
         " Die Mumie bohrt @WEM einen Finger ins Auge.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));       
 AddSpell(1,500,
         " Die Mumie greift Dich mit der Kraft der Ewigkeit an.\n",
         " Die Mumie greift @WEN mit der Kraft der Ewigkeit an.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));                
 AddSpell(4,250,
         " Die Mumie reisst Dir die Bauchdecke auf.\n",
         " Die Mumie reisst @WEM die Bauchdecke auf.\n",
   DT_RIP,([SP_SHOW_DAMAGE:1]));       
 AddSpell(3,300,
         " Die Mumie zerquetscht Dich an der Wand.\n",
         " Die Mumie zerquetscht @WEN an der Wand.\n",
  DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));        
                      
  }
    
  die(arg)
  {
  	object ob;
  ob=clone_object(KNPC"stdsnake");
  ob->move(environment(TP), M_GO+M_SILENT);	
  tell_room(environment(TO),
  "Eine Schlange kriecht aus den Augen der Mumie heraus als diese zu Staub "
  "zerfaellt.\n");
  ::die(arg);
  }
  
                       
