// ein felsvorsprung

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int x=random(100);

init()  {
	::init();
if(interactive(TP))  {
  if(x<5)  {	
	call_out("pech", 5);
             }  
        }
 }


      pech()  {  
      if(environment(TP)!=TO)  return;
write(BS(
"Du rutscht aus und faellst in den Abgrund!!!! AHHHHHHHHHH"));
TP->move(KROOM"fels5", M_GO+M_NO_SHOW,
"nach unten", "faellt", 
"faellt von sehr weit oben hier her herab");
     }	


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsvorsprung" );
  SetProp( P_INT_LONG, BS(
    "Vorsichtig balancierst Du auf dem aeussersten Rand des Felsvorsprungs "
    "und Dir wird ziemlich schwindlig als Du in den gaehnenden Abgrund blickst. "
    "Dieser Ort hier ist Dir nicht geheuer. Von hier aus wirft der Priester der "
    "Kannibalen seine Opfer bei lebendigem Leibe hinunter in den Abgrund. Keiner "
    "hat das jemals ueberlebt!!! "
    "Trotzdem hat man von hier oben eine sehr schoene Aussicht..."));
   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail(({"richtung","himmelsrichtung","richtungen","himmelsrichtungen"}),
  "Norden, Westen,...\n");
  AD("leibe",
  "Unten angekommen zerplatzen die Opfer dann!!!");
  
  
AD(({"fels","vorsprung","felsvorsprung"}),
"Der Felsvorsprung haengt direkt ueber einem tiefen Abgrund!");
 
 AD("rand",
 "Man kann hier sehr leicht abstuerzen!!!");
 
 AD(({"mauer","stadtmauer"}),
 "Die Stadtmauer sieht von hier sehr klein aus.");
 
 
AD(({"kannibale","kannibalen"}),
"Die Kannibalen kommen hier nur her, wenn ihr Priester ein Opfer nach unten "
"schleudern will.");

AD("ort",
"Wohl fuehlen kann man sich hier kaum.");
  
  AD("himmel",
  "Der Himmel ist hier rot wie Blut!");
  AD("blut",
  "Dein Blut!");
  AD("horizont",
  "Die Aussicht ist einfach herrlich hier.");
  AD("opfer",
  "Der Priester schleudert seine Opfer einfach nach unten wo sie zerschellen.");
  
  
  AddDetail(("abgrund"),
  "Du scheinst nicht einmal bis zum Boden zu sehen..\n");
  AddDetail( ("boden"),
  "Den Boden kannst Du von hier oben nicht erkennen. Die vielen Pflanzen "
  "versperren Dir jegliche Sicht nach unten.\n");
  AddDetail(({"sicht","pflanzen"}),
  "Die vielen Blaetter und Aeste machen es unmoeglich weit "
  " nach unten zu sehn.");
  AddDetail(("sonne"),
  "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich "
   "herab.\n");
  AddDetail(({"blaetter","ast","aeste","blaettern","aesten","pflanze","pflanzen"}),
   "Gruen, gruen, gruen, alles nur gruen...\n");
  AddDetail(("aussicht"),
   "Du erkennst von hier oben im Norden die Stadt Tijara, im Sueden glaubst"
   " Du eine breite Schlucht zu sehen und noch suedlicher ein Dorf."
   " Weit im Westen erstreckt sich das Meer und nach Osten nichts als der gruene"
   " Dschungel.");   
  AddDetail(({"norden","stadt","tijara"}),
   "Du erkennst die Stadtmauer und das Suedtor, aber sonst nichts.\n");
   AD(({"tor","suedtor"}),
   "Das Tor ist fast nicht mehr zu sehen.");
   
  AddDetail(({"westen","meer"}),
   "Blau, blau und unendlich weit...\n");
  AddDetail(({"sueden","schlucht"}),
   "Der Pfad scheint direkt zur Schlucht und noch weiter zu fuehren.\n");
   AD("pfad",
   "Du kennst Dich ja hier ueberhaupt nicht aus! Du Wurstspieler!");
   
   AD("wurstspieler",
   ";-]");
   
  AddDetail(("dorf"),
   "Wer wohl in dem Dorf wohnen mag?\n");
  AddDetail(({"dschungel","osten"}),
   "Bis zum Horizont kannst Du nur den scheinbar unendlich grossen Dschungel "
 "erblicken.");
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Pfeifen des Windes...");
AddSound(({"wind","pfeifen"}),
"SSSSSSSSUUUUUUUUUUUUUUURRRRRRRR!");
    
  AddSmell( DEFAULT_SMELL,
    "AHH! Hier riecht es schon viel besser!");



 
 AddItem(KNPC"kprie" , REFRESH_DESTRUCT);
 
ASE("osten", "go_o"); 
  
}

int go_o()
 {
TPM(KROOM"fels15:"+getuid(TP), 
M_GO+M_NOCHECK,
"nach Osten", "geht","kommt herein");
 previous_object()->CustomizeObject();   
return 1;}





