#include "../kani.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

int zufall=1+random(9);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Versteck der Mungos" );
  SetProp( P_INT_LONG, BS(
"Nun bist Du in ein Versteck der Mungos gelangt. Die Mungos sind "
"die schlimmsten Feinde der Schlangen und hassen und toeten sie wann "
"immer es nur geht. Von hier aus starten sie ihre Angriffe. Viel ist hier "
"nicht zu sehen. Der Boden besteht aus trockener Erde, ebenso die Waende. "
"Im Norden fuehrt ein Spalt wieder hinaus in die Schlangengrube."));

AD("versteck",
"Hier sammeln sich die Mungos, wenn sie die Schlangen ueberfallen wollen.");
AD(({"mungo","mungos"}),
"Die Mungos hassen alle Schlangen und werden Dir sicher helfen sie zu toeten!");
AD(({"schlange","schlangen"}),
"Die Schlangen wissen nicht, dass es dieses Versteck gibt.");
AD(({"feind","feinde"}),
"Mungos und Schlangen sind erbitterte Feinde.");
AD(({"angriff","angriffe"}),
"Die Mungos greifen die Schlangen immer ueberaschend an.");
AD("boden",
"Der Boden besteht aus trockener Erde.");
AD("decke",
"Die Decke ist flach und ebenso aus Erde.");
AD(({"wand","waende"}),
"Die Waende sind aus trockener Erde. Voellig langweilig.");
AD("erde",
"Die Erde ist braun und trocken. Ab und an sieht man kleine Haufen.");
AD("haufen",
"Hmm, wozu dienen die wohl. Einer der Haufen ist besonders gross und "
"sehr auffaelig. Du erkennst an ihm eine kleine Oeffnung.");
AD("norden",
"Da ist die Schlangengrube.");
AD("spalt",
"Durch den Spalt kommst Du wieder raus.");
AD(({"grube","schlangengrube"}),
"Die Schlangengrube wartet im Norden auf Dich.");
AD("oeffnung",
"Hmm, wozu die wohl dient?! Angeblich muss man ein Mungokraut hineinlegen?!");

AD(({"mungokraut","kraut"}),
"Hmm, wo man das wohl herbekommt?!");
   
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die wuetenden Schlangen draussen zischen...");
    AddSound(({"schlange","schlangen"}),
    "SSSSSSSS SSSSSSSSS!!!");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach nichts.");
   AddExit("raus","./gr2");

ACD(({"legen","lege","leg"}), "come_mungo");

}

int come_mungo(string str)  {
   object kraut;  
   object mungo;
     
  NF("Was willst Du in die Oeffnung legen?!\n");

 kraut=present("MUNGO_KRAUT", TP);
 
 if(str=="kraut in oeffnung"||str=="in oeffnung kraut"||
 str=="mungokraut in oeffnung"||str=="in oeffnung mungokraut")  {
 	
      if(!kraut)  {
       write(BS(
       "Du hast gar kein Mungokraut."));
        return 1;}
  
  
   if(present("mungokoenig", TO))  {
   	
   	write(BS(
   	"Der Mungokoenig sagt: Lass das!"));
   	return 1;  }
   	
  kraut->remove();
 
  write(BS(
  "Du legst das Mungokraut in die Oeffnung und hoerst ein Rascheln. "
  "Dann kommt ein sehr grosser Mungo aus dem Haufen gekrochen!"));
  mungo=clone_object(KNPC"kmungo");
  mungo->move(TO, M_GO+M_SILENT);
              return 1; }
  
           }
