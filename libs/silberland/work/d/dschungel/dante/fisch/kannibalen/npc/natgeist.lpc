

inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gruener Dschungelgeist");
  SetProp(P_LONG, (
    "Der gruene Dschungelgeist schimmert durchsichtig vor Dir. Du kannst kaum "
    "etwas genaues erkennen, da seine Konturen in staendigem Fluss sind."
    " Bald sieht er aus wie ein grueber durchsichtiger Mensch, bald eher wie"
    " eine Pflanze..."));
  SetProp(P_NAME, "Dschungelgeist");
  SetProp(P_GENDER, MALE);
  AddId( ({"geist", "dschungelgeist"}) );
  AddDetail(({"konturen","kontur"}),
    "Die Umrisse des Dschungelgeistes verschwimmen staendig.\n");
    AddDetail(("fluss"),
    "Dieses seltsame Wesen scheint keinerlei fixe Gestalt zu haben.\n");
  create_default_npc(28);
  SetProp(P_HANDS, ({" mit seinen gruenen Armen", 220+random(20),({DT_HOLY, DT_MAGIC}) }));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 300+random(20));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "Der Dschungelgeist sagt: Achte alles Leben im Dschungel.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "@WER faellt durch den Geist zu Boden.\n"}));
  SetProp(P_DIE_MSG, " verschwindet wieder in die Welt der Geister.\n");
  SetProp(P_INFO, ("Der Dschungelgeist beschuetzt die Tiere des Dschungels.\n"));
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_FIRE,DT_SLASH}));
  
  SetProp(P_NOMAGIC, 20);
  SetProp(P_SPELLRATE, 90);
  AddSpell(3, 400, 
   "Der Dschungelgeist huellt Dich in gruenen Nebel.\n",
    "Der Dschungelgeist huellt @WEN in gruenen Nebel.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 500, 
    "Der Dschungelgeist laesst Baeume auf Dich herabfallen.\n",
    "Der Dschungelgeist laesst Baeume auf @WEN herabfallen.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 400,
    "Der Dschungelgeist verflucht Dich.\n",
    "Der Dschungelgeist verflucht Dich.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 300,
    "Der Dschungelgeist spuckt gruenen Schleim nach Dir.\n",
    "Der Dschungelgeist spuckt gruenen Schleim nach @WEM.\n",
     DT_ACID, ([SP_SHOW_DAMAGE:1]));
  

 SetChats(4, ({
    "Der Dschungelgeist schwebt nach oben...\n",
    "Der Dschungelgeist schwebt nach unten...\n",
    "Der Dschungelgeist deutet auf die Wunder dieser Welt.\n",
    "Der Dschungelgeist scheint voellig durchsichtig zu sein.\n",
    "Der Dschungelgeist sagt: Achte das Leben im Dschungel.\n",
    "Der Dschungelgeist verschwindet, taucht aber hinter Dir wieder auf.\n",
    "Der Dschungelgeist fluestert: Verschwinde lieber wieder in die Stadt zurueck\n",
    "Der Dschungelgeist schimmert gruen...\n",
    "Der Dschungelgeist schimmer leicht braeunlich.\n",
    "Der Dschungelgeist sagt: Verschmutze den Dschungel nicht.\n"}));
 SetAttackChats(20, ({
    "Der Dschungelgeist sagt: Das war ein Fehler, du Unwissender.\n",
    "Der Dschungelgeist versucht Dich zu entmaterialisieren.\n",
    "Der Dschungelgeist lacht Dich aus.\n",
    "Der Dschungelgeist sagt: Verschinde von hier!.\n",
    "Du beginnst zu taummeln.\n",
    "Der Dschungelgeist zieht Dich an Deiner Nase.\n",
    "Fluechte Sterblicher, fluechte...\n"}));
 
 
 SetProp(P_LOG_INFO, "ddschungelgeist");
 
 AddInfo(({"priester","kannibalenpriester"}),
    "fluestert: Der Kannibalenpriester will Deinen Tod!\n");
 AddInfo("dante",
 "sagt: Dante liebt alle Tiere und Pflanzen des Dschungels!\n");   
 AddInfo(({"kannibalen","kannibale"}),
    "sagt: Das Dorf der Kannibalen ist in der Naehe von hier...\n");
 AddInfo("dschungel",
    "sagt: Der Dschungel ist meine Heimat.\n");
 AddInfo("feyaria",
 "sagt: Sie ist die Herrin des Dschungels.");   
 AddInfo("silberland",
 "sagt: Der Dschungel ist das schoenste Gebiet im Silberland.");   
 AddInfo("pyramide",
    "sagt: Huete Dich vor der verfluchten Pyramide...\n");
    AddInfo("pflanzen",
    "sagt: Bewundere, aber zerstoere sie nicht!");
    AddInfo("tijara",
    "sagt: Naja, eben eine Stadt.");
    AddInfo(({"daemonen","daemon"}),
    "sagt: Die Daemonen der Zerstoerung sind unsere groessten Feinde.");
    AddInfo("tiere",
    "sagt: Sie sind die Bewohner des Dschungels.");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler liebt den Dschungel.\n");               
  }


