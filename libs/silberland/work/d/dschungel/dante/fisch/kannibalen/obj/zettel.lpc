// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein alter vergilbter Zettel");
  SetProp(P_LONG, BS( 
    "Der Zettel schaut schon sehr mitgenommen aus. Du kannst ihn lesen."));
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  AddId(({"zettel","DANTE_ZETTEL"}));

  SetProp(P_MATERIAL, ([MAT_PAPER:100]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  
  AddReadDetail(("zettel"),
  "+---------------------------+\n"
  "|                           |\n"
  "|  H ere a f Dei  Gew s  n  |\n"
  "|                           |\n"
  "|     un  hi f d r Na ur    |\n"
  "|                           |\n"
  "+---------------------------+\n");   
  
  
}
