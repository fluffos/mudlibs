/*
in den steinen, hier wohnt der troll
*/


#include "files.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>


init()  {
  ::init();
  if(interactive(TP))  {
  call_out("check", 1);  }
  }
  
  
  check()  {
  object rue;
  if(environment(TP)!= TO)  return;
  
   rue=present("DANTE_SPINNEN_PANZER", TP);
   
   if(!rue)  {
   write(BS(
   "Die giftigen Spinnweben verletzen Dich! Du fliehst hinaus! "
   "Ungeschuetzt wirst Du es hier nie aushalten!"));
   
   TPM(KROOM"fels10", M_GO, "wieder hinaus", "springt", 
   "erscheint ploetzlich vor Dir");
   
   TP->do_damage(3+random(3));
   TP->AddPoison(1);
   return ;  }
   
   if(!rue->QueryWorn())  {
    write(BS(
   "Die Spinnweben verletzen Dich! Du fliehst hinaus! Du solltest fuer "
   "speziellen Schutz sorgen!"));
   TPM(KROOM"fels10", M_GO, "wieder hinaus", "springt", 
   "erscheint ploetzlich vor Dir");
   TP->do_damage(3+random(3));
   TP->AddPoison(1);
   return ;  }
  
  write(BS(
  "Dein Spinnenpanzer schuetzt Dich vor den giftigen Spinnweben!"));
           
           }
           


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im seltsamen Stein" );
  SetProp( P_INT_LONG, BS(
"Du bist nun mitten in dem seltsamen, grossen Stein. Wer haette gedacht, "
"das er hohl ist, und sich in ihm eine kleine Hoehle befindet. Hier muessen "
"seit ewig Spinnen hausen, denn alles, wirklich alles ist voller "
"Spinnweben. Du ekelst Dich ein wenig."));

AD("stein",
"Du steckst mitten im Stein drin. In einer kleinen Hoehle.");
AD("hoehle",
"Die Hoehle ist nicht allzu gross, doch umso ekliger. Alles ist voller "
"Spinnweben.");
AD(({"spinnweben","weben"}),
"Sie sind wie ein dichter Wall und fast undurchdringbar.");
AD("wall",
"AH! Da kann man scheinbar nach oben gehen!");
AD(({"wand","waende"}),
"Auch sie sind voll mit Spinnweben.");
AD("decke",
"Die Decke ist ueberzogen mit Spinnweben.");
AD("boden",
"Kaum zu erkennen wegen der Spinnweben.");
AD(({"spinne","spinnen"}),
"Sollte keine da sein, sei froh!");

  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Krabbeln von vielen Spinnen.");
    AddSound(({"krabbeln","spinnen","spinne"}),
    "TAPPP, TAPPP, TRIPPEL...\n");
 
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es giftig");
  
     AddItem(KNPC"spork", REFRESH_DESTRUCT);  
     AddItem(KNPC"spinne3", REFRESH_DESTRUCT);
    
  AE("oben", "./stein");
SP(P_HIDE_EXITS, ({"oben"}));


} 
   