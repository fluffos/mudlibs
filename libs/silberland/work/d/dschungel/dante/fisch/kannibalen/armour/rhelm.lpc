
#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"helm", "eisenhelm", "DANTE_ROST_HELM"}));
  SetProp (P_SHORT, "Ein alter, rostiger Eisenhelm");
  SetProp (P_LONG, BS("Der Helm besteht aus Eisen und ist voellig verrostet. "));
  
  SetProp (P_NAME, "Eisenhelm");
  SP(P_NAME_ADJ, "rostig");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 2000);
   SetProp (P_MATERIAL, ([MAT_IRON:100]));
  SetProp (P_VALUE, 10);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  
  SetProp (P_AC, 2);

}
