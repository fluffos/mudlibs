/*
der spinnenork fuer die olle quest
dante sl 2000 
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
#include <npc.h>

object cash;


init()
{
  ::init();
if(interactive(TP))  {
call_out("hallo", 1); }

}


hallo()  {
object ob;

ob=deep_present("DANTE_MUENZE", TP);
 
 if(environment(TO)!=environment(TP)) return ;
 
 
 if(deep_present("DANTE_ANKH", TP)) {
 write(BSA(
 "Na, weisst Du schon welchen Sinn der Ankh hat?!",
 "Spork fragt: "));
     return ; }
 
 
 
 
    if(ob)  {
    write(BSA(
   "HEHE! Da ist ja die Muenze! Und nun krepier Du Hund! Los her damit!",
   "Spork bruellt: "));
    Kill(TP);
    return;
    };
    
    write(BSA(
    "Hallo! "+CAP_TPN+"! Ich freue mich Dich zu sehen!",
    "Spork sagt listig: "));
    
    }






create()
{
 
  if (!is_clone(TO)) return;
      ::create();

  SetProp(P_SHORT, "Spork, der Spinnenork");
  SetProp(P_LONG, BS(
"Das ist Spork. Ein Ork, der schon seit ewig hier unten bei den Spinnen haust. "
"Er sieht mittlerweile einer Spinne sehr aehnlich, so dass man sagen kann, "
"er ist ein Spinnenork geworden. Eine durch und durch haessliche und vor allem "
"gierige Kreatur!"));

SP(P_ARTICLE, 0);

  SetProp(P_NAME, "Spork");
  SetProp(P_GENDER, MALE);
  AddId(({"spinnenork", "spork", "ork"}));

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen Faeusten",140+random(20),DT_BLUDGEON}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 110+random(20));
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "wandert interessiert herein");
  SetProp(P_MSGOUT, "wandert interessiert");
  SetProp(P_MMSGIN, "kriecht grunzend herein");
  SetProp(P_MMSGOUT, "verschwindet grunzend in den Spinnweben");

  SetProp(P_NOCORPSE, 0 );


  AddInfo(DEFAULT_INFO, ({
  "sagt: Interessiert mich nicht! Ich will Gold!\n",
  "sagt: Weiss ich nicht!\n",
  "grunzt nur laut.\n",
  "kriecht wie eine Spinne umher.\n",
  "sagt: Spinne ich?!\n"}));  

  AddInfo(({"priester","kannibalenpriester"}),
   "Er ist der maechtigste aller Kannibalen.","sagt: ");
  AddInfo(({"kannibale","kannibalen"}),
  "Hmm, mir machen sie nichts! Sie leben eher im Nordosten von hier.", "sagt: ");

AI("rippe",
"Die Rippe, hmm, woher hast Du Hund sie!!!",
"sagt: ");

AI("dschungel",
"Der Dschungel ist voller Gold!", "sagt: ");
AI("gold",
"JA!!! ich will Gold! Besonders eine spezielle Muenze will ich haben!",
"sagt gierig: ");
AI("muenze",
"Irgendwo im Dschungel soll sie sein! Eine ganz besondere Muenze! Los such sie!"
" Und dann komm wieder her und ich helfe Dir sicher!", "sagt listig: ");

AI(({"quest","hilfe","abenteuer"}),
"Bring mir Gold!!!", "sagt: ");

AI("ankh",
"Hmm, der Ank ist eine heilige Waffe, glaube ich. Mir egal, der ist nicht aus "
"Gold! Los hau ab!", "flucht: ");
AI(({"spinne","spinnen"}),
"Die Spinnen sind meine Freunde!", "sagt: ");

    
  SetProp( P_REJECT, ({ REJECT_KEEP,
   "Spork sagt: ich will die Muenze haben!\n"}));
  
  SetProp(P_SPELLRATE, 50);
  
  AddSpell(1, 200,
    "Spork pruegelt auf Dich ein!\n",
    "Spork pruegelt auf @WEN ein.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
   "Spork schlaegt Dir ins Gesicht.\n",
    "Spork schlaegt @WEM ins Gesicht.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));



  SetChats(3, ({
     "Spork kriecht umher.\n",
     "Spork sieht einer Spinne schon sehr aehnlich.\n",
     "Spork sagt: Gold!\n",
     "Spork sieht Dich gierig an.\n",
     "Spork sagt: Die Spinnen sid meine Freunde!\n",
     "Spork krabbelt umher.\n",
     "Spork sagt: Bring mir die Muenze!\n"}));
                  
  SUID;
//      CLONEME("/p/weapon/messer"); 
//      command("zuecke schwert");
     

 
  //command("trage alles");

cash=clone_object("obj/money");
cash->SP(P_AMOUNT, 1000+random(1000));
cash->move(TO, M_NOCHECK);


}

  
     
     Defend(int dam, string dtype, mixed spell, object enemy)
{
    if(!deep_present("DANTE_FISCH_LISTE_VIER", enemy))  {
        StopHuntingMode();
        enemy->StopHuntingMode();
      heal_self(500);
    return ;
       }
 
  if(!deep_present("DANTE_MUENZE", enemy))  {
    write(BSA(
    "NEIN! Hier wird nicht gekaempft! AUS!",
    "Spork bruellt Dich an: "));
    heal_self(500);
     StopHuntingMode();
        enemy->StopHuntingMode();
        return ;  }
        
        
     write(BSA(
     "Gib mir die Muenze!",
     "Spork bruellt: "));
        
        return ::Defend(dam, dtype, spell, enemy);
        
        
         }
 
die(arg)   {
        object ob, ob1;
      ob=deep_present("DANTE_MUENZE", TP);
      if(!ob)  {
      heal_self(500);
      return;        
       }
       
    if( (ob)&&(!deep_present("DANTE_ANKH", TP)))  {

    ob->remove();       
    ob1=clone_object(KWEAPON"dankh");
    ob1->move(TP, M_NOCHECK);
    write(BSA(
    "JAJA! Ist ja schon gut, hier Deine Belohnung! Ich gebe sie Dir ja wohl! "
    "Her mit der Muenze! Hier hast Du etwas!",
    "Spork jammert laut: "));
    write(BS(
    "Du gibst Spork die Muenze und er Dir etwas anderes dafuer!"));
     StopHuntingMode();
        TP->StopHuntingMode();
    heal_self(500);
    return ;  }
   heal_self(500);
   return ;  }
    