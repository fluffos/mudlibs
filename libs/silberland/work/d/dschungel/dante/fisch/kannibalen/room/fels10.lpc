// a, felsen by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor dem Felstor" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun vor den beiden Steinen. Sie ragen einige Meter in die Hoehe "
  "und symbolisieren scheinbar ein Tor. Auf beiden Steinen kannst Du einge"
  "meiselte Schriftzeichen erkennen. Was hinter dem Tor liegt, kannst Du von "
  "hier nicht erkennen, da der Weg scharf abbiegt. "));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({"meter","hoehe"}),
    "Die beiden Steine muessen von jemanden so aufgestellt worden sein. Du "
    "fragst Dich nach dem Sinn?\n");
  AddDetail(("tor"),
  "Zwischen den beiden Steinen kann man muehelos hindurchgehen, wie eben "
  "durch ein Tor.\n");
  AddDetail(("weg"),
  "Der Weg biegt gleich nach dem Steintor nach Suedwesten ab. Was dich da "
  "wohl erwartet?\n");
  AddDetail(({"steine","stein"}),
  "Zwei hohe Granitbloecke wurden hier von irgendjemanden aufgestellt.\n");
  AddDetail(({"zeichen","schriftzeichen"}),
  "Leider kannst Du keines dieser Zeichen deuten. Aber Dir schwant nichts "
  "Gutes....");
  AD("gutes",
  "Doch Du gibst die Hoffnung nie auf!");
  AD("hoffnung",
  "Hoffnung besteht immer, auch hier.");
  AD("Du schoepfst neuen Mut, da Du eine seltsame kleine Einkerbung entdeckst.");
  AD("einkerbung",
  "Einer der grossen Steine traegt eine Einkerbung. Sie sieht einem "
  "Schluesselloch aehnlich.");
  AD("loch",
  "Welches Loch!?");
  AD("schluesselloch",
  "Hmm, und nun entdeckst Du, das der grosse Stein Linien aufweist, die einer "
  "Tuere aehneln. Scheinbar geht es hier hinein!");
  AD(({"linie","linien"}),
  "Sie zeichnen eine Tuere nach!");
  AD("tuere",
  "Sie scheint wirklich hinein in den Stein zu fuehren! Doch wo ist "
  "der Schluessel?! Und vor allem was?!");
  AD("schluessel",
  "Was koennte diese seltsame Tuere aufsperren?!");
  
  AD("gruen",
  "Alles hier, fast alles hier ist gruen.");
  
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst am Rande eines kleinen Hochplateaus, einer Insel inmitten des "
  "ewigen Gruens...\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedich durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Die Vegetation scheint doch etwas anders als am Boden zu sein...\n");
  AddDetail(("vegetation"),
  "Dieser Teil des Plateaus ist nicht so dicht bewachsen. Irgendwie schaut er\n"
  "gerodet aus.\n");
  AddDetail("himmel",
  "Der Himmel ist strahlenblau.");
  AddDetail("sinn",
  "Muss immer alles einen Sinn haben?");
  AddDetail("boden",
  "Der Boden scheint ziemlich oft begangen zu werden.");
  AddDetail("steintor",
  "Naja, richtiges Tor ist es ja keines, nur bene zwei Steine.");
  AddDetail(({"block","bloecke","granitbloecke","granitblock"}),
  "Gewaltige Steine bilden ein Steintor.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst lautes Schreien.");
    AddSound(({"schreien","schreie"}),
    "UGA UGA!!!");
    
  AddSmell( DEFAULT_SMELL,
    "Du glaubst Fleisch und Feuer riechen zu koennen.");
AddSmell(({"fleisch","feuer"}),
"Du wirst doch etwas aengstlich!\n");

//AddItem( ({NPC_WEG"dstechmuecke", NPC_WEG "dkoli", NPC_WEG "dmoskito"}),
  //   REFRESH_DESTRUCT);
  


  AddExit( "norden", "./fels5");
  AGE( "suedwesten",KROOM"fels11", "kannibale", 
  "Der Kannibale bruellt: HE! STOP! Du %&%%&$%!\n");

ACD(({"sperr","sperre"}), "go");
}

int go(string str)   {

      object ri;
      ri=present("DANTE_RIPPE", TP);

      NF("Womit willst Du die Tuere aufsperren?!\n");
    if(!deep_present("DANTE_FISCH_LISTE_VIER"))  {
    
    write(BS(
    "Du kannst hier gar nichts machen!"));
    return 1; }
    
    if(str =="tuere mit rippe auf"||
    str=="tuer mit rippe auf"||
    str=="tuere mit schluessel auf"||
    str=="tuer mit schluessel auf")  {
    
    if(ri)                   {
    write(BS(
    "Du sperrst mit der Rippe die seltsame Tuere auf. Sie schwingt auf, Du "
    "trittst erschrocken in das Innere des Steines ein!"));
    TPM(KROOM"stein", M_GO, "ploetzlich im Stein", "verschwindet",
    "kommt von draussen herein");
    return 1;            }
    
    if(!ri)              {
    write(BS(
    "Ein Blitz schiesst vom Himmel herab und verbrennt Dich ein wenig!Luegner!"));
    TP->do_damage(10);
    return 1;
                        }
     return 0; }
  return 0; }
    