// kannibale by dante 97 - 2000 sl

inherit "std/npc";
inherit "std/inpc/select";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
#include <inpc.h>

int i;
string *wie=({"wilder","boeser","blutruenstiger","boesartiger",
"grosser","fetter","kleiner","schrecklicher"});


init()
{
  object defender;
  ::init();
  if (defender = present("Kmann")) AddDefender(defender);
 if (defender = present("Kmann 2")) AddDefender(defender);
  if (defender = present("Kfrau")) AddDefender(defender);
  if (defender = present("Kkind")) AddDefender(defender);
}


create()
{
 
  if (!is_clone(TO)) return;
  npc::create();

i=random(sizeof(wie));

  SetProp(P_SHORT, "Ein "+wie[i]+" Kannibale");
  SetProp(P_LONG, BS(
    "Du siehst einen wild dreinblickenden sehnigen Kannibalen vor Dir, dem "
    "man die Mordlust direkt ansehen kann!"));
  SetProp(P_NAME, "Kannibale");
  SetProp(P_GENDER, MALE);
  AddId(({"kannibale","mann", "Kmann","kannibalenmann","NOWIMPY"}));

  create_default_npc(15+random(3));
  SetProp(P_HANDS, ({" mit seinen Faeusten",140+random(20),DT_BLUDGEON}));
  SetProp(P_RACE, "Kannibale");
  SetProp(P_SIZE, 180+random(20));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0.4);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "stuermt herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "springt hinter einem Busch hervor");
  SetProp(P_MMSGOUT, "verschwindet im Busch");

  SetProp(P_DIE_MSG,  " haucht sein Kannibalenleben aus.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schreit: Verschwinde oder wir fressen Dich.\n");


SP(P_RESISTANCE_STRENGTHS, ([DT_BLUDGEON:0.1, DT_FIRE:0.5,
DT_COLD:0.7]));




  AddInfo("priester", "Er ist der maechtigste Mann von allen Kannibalen.","sagt: ");
  AddInfo("kannibale", "Ich bin einer davon, Du Idiot!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Kannibale sagt: Erwartest Du fuer den Muell auch noch Dank?\n" }) );
  SetProp(P_SPELLRATE, 50);
  
  AddSpell(1, 400,
    "Der Kannibale schlaegt Dir den Schaedel ein.\n",
    "Der Kannibale schlaegt @WEM den Schaedel ein.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5,300,
    "Der Kannibale schlitzt Dich auf.\n",
    "Der Kannibale schlitzt @WENN auf.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5,300,
    "Der Kannibale tritt Dir in den Bauch.\n",
    "Der Kannibale tritt Dir in den Bauch.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(6,250,
    "Der Kannibale schleudert giftige Pfeile nach Dir.\n",
    "Der Kannibale schleudert giftige Pfeile nach Dir.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
  

  SetChats(3, ({
  "Der Kannibale furzt hemmungslos.\n",
  "Der Kannibale ruelpst laut.\n",
  "Der Kannibale tritt Dich.\n",
  "Der Kannibale will ein Stueck Fleisch von Dir abschneiden.\n",
  "Der Kannibale schaut Dich hungrig an.\n",
  "Der Kannibale tobt.\n",
  "Der Kannibale schwingt sein Knochenschwert.\n",
  "Der Kannibale baut sich vor Dir drohend auf.\n",
  "Der Kannibale kratzt sich am Knie.\n",
  "Der Kannibale deutet Dir zu verschwinden.\n",
  "Der Kannibale schreit Dich an.\n"}) );
  
  SetAttackChats(10, ({
  "Der Kannibale versucht Dich zu erwuergen!\n",
  "Der Kannibale will Dich roh fressen!\n",
  "Der Kannibale ruft seine Stammesbrueder zu Hilfe.\n",
  "Der Kannibale freut sich auf Deine Leber.\n",
  "Der Kannibale verflucht Dich.\n",
  "Der Kannibale draegt Dich zurueck.\n"}) );

  SUID;
  switch(random(3))
  {
    case 0: 
      CLONEME(KWEAPON "dkschwert"); 
      command("zuecke schwert");
      break;
    case 1: 
      CLONEME(KWEAPON "dschkeule"); 
      command("zuecke keule");
      break;
    case 2:
     CLONEME(KWEAPON "dspeer");
     command("zuecke speer");
     break;
     default:
      CLONEME(KWEAPON "dspeer");
     command("zuecke speer"); 
     
  }
  switch(random(5))
  {
    case 0:
      CLONEME(KOBJ "dmilz");
      break;
    case 1:
      CLONEME(KOBJ "dmilz");
      break;
    case 2:
      CLONEME(KOBJ "dun");
      break;
    case 3:
      CLONEME(KOBJ "dhirn");
      break;
    case 4:
      CLONEME(KOBJ "dleb");
      break;
  default:   CLONEME(KOBJ "dleb");
  
  }
     
  if( random(100) < 45 ) CLONEME(KARMOUR "dledergamaschen");
  if( random(100) < 85 ) CLONEME(KARMOUR "dkschild");
  if( random(100) < 55 ) CLONEME(KARMOUR "dkhelm");
  if( random(100) < 75 ) CLONEME(KARMOUR "dschurz");

 
  command("trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("nimm alles aus leiche");
  command_me("ziehe alles aus");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe");
  command_me("trage alles");
}

