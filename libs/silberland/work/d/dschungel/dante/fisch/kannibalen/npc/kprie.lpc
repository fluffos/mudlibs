// der boese boese kannibalenpriester
/* kann nur mit dem ankh umgenietet werden
ohne dem keine chance
Einer meiner ersten NPCS!!!! Nun doch verwendet!!*freu*

*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <wizlevels.h>
#include <actions.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"




init()
{
  ::init();
if(interactive(TP))  {
call_out("hallo", 1); }

}


hallo()  {
object ob;

ob=deep_present("DANTE_ANKH", TP);
 
 if(environment(TO)!=environment(TP)) return ;
 
if(ob)  {
  write(BSA(
  "Du mieser Wurm! Dich bringe ich um! Stirb! Woher hast Du den heiligen "
  "Ankh!!!",
  "Der Kannibalenpriester bruellt: "));
  Kill(TP);
  return ; 
          }
  
    write(BSA(
    "Du kleiner mieser Wurm! Was suchst Du hier im Gebiet der Kannibalen! "
    "Du solltest besser verschwinden und zwar rasch! Sonst vernichte ich Dich!",
    "Der Kannibalenpriester sagt boese: "));
    return ;
  
  }
   






void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Kannibalenpriester Aztlepec");
  SetProp(P_LONG, BS(
    "Der Kannibalenpriester Aztlepec ist ein duerrer Mann mit unbestimmbaren Alter und "
    "tiefbrauner Haut. Du fuehlst direkt die Aura des Boesen und der Mordlust. "
    "Sein hageres Gesicht scheint wie eine Maske, es zeigt keine Spur von "
    "Leben. Lediglich die Augen scheinen Dich zu fixieren. Sein Koerper ist "
    "ueber und ueber mit rituellen Narben verziert. "
    "                                       Ein schwarzes Pentagramm."));
  
  AddDetail("alter",
  "Der Priester scheint gleich alt wie das Boese zu sein.\n");
SP(P_ARTICLE, 0);
  
  AddDetail(({"haut","koerper","narben"}),
  "Du betrachtest die Ritztaetowierungen des Priesters, kannst aber leider "
  "nichts genaueres erkennen.\n");
  AddDetail(({"aura","boese","mordlust"}),
  "Du spuerst wie sich das Boese langsam Deiner Seele bemaechtigt.\n");
  AddDetail(({"auge","augen"}),
  "Du zuckst zusammen, als Du erkennst, dass der Priester keine Pupillen hat.\n");
  AddDetail(({"gesicht","maske"}),
  "Totengleich starrt der Priester Dich an und scheint gleichzeitig in Dein "
  "tiefstes Inneres zu schauen.\n");                                             
  
  SetProp(P_NAME, "Aztlepec");
  SetProp(P_GENDER, MALE);
  AddId(({"aztlepec","kannibale", "kannibalenpriester", "priester"}));

  create_default_npc(60);
  SetProp(P_HANDS, ({" mit seinen knochigen Fingern ",350,DT_BLUDGEON}));
  SetProp(P_BODY, 200);
  SetProp(P_RACE, "kannibale");
  SetProp(P_SIZE, 180);
  SetProp(P_SMELL, "Du glaubst den Tod riechen zu koennen.\n");
  SetProp(P_INFO, ("Der Kannibalenpriester ist ein maechtiger Magier.\n"));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "erscheint vor Dir");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "zaubert sich herein");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " bricht sterbend Dich verfluchend nieder!!!\n");
  SetProp(P_NOCORPSE, 0 );
  
  SetProp(P_MURDER_MSG, "Die dunkle Magie des Boesen hat versagt! Wie nur! Dante hilf mir!");
  SetProp(P_KILL_NAME, "Der Kannibalenpriester Aztlepec");
  SetProp(P_KILL_MSG, "Dich fresse ich mit Haut und Haaren! Und die anderen auch!!!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

  AddInfo(DEFAULT_INFO, ({
  "sagt: Verschwinde solange Du noch kannst!!!\n",
  "blickt Dich nur finster an.\n",
  "tritt Dir in den Bauch.\n",
  "stoesst Dich zu Boden.\n",
  "schlaegt Dir ins Gesicht.\n",
  "sagt: Was soll die dumme Fragerei?\n",
  "sagt: Du lebst nicht mehr lange...\n",
  "flucht nur laut.\n",
  "droht Dir den Tod an.\n",
  "sagt: Dein Herz wird mir gut schmecken!!!\n",
  "lacht Dich nur aus.\n"}) );
  
  AddInfo("dante", "Dante erwische ich auch noch!","sagt: ");

  AddInfo("tod", 
  "sagt: Deiner ist naeher als Du glaubst...\n");
  AddInfo("zaubertrank",
  "sagt: Wenn Du mich toetest...\n");
  AddInfo("dorf",
  "sagt: Das wirst Du wohl nicht mehr verlassen.\n");
  AddInfo(({"kannibale","kannibalen"}),
  "sagt: Die haben Dich zum fressen gern.\n");
  AddInfo("tijara",
  "lacht: Ha, da leben die Zivilisierten!\n");

  AddInfo("pentagramm",
  "Das Pentagramm hat grosse magische Faehigkeiten. Das bekommst Du nie! "
  "Man braucht es um das Feuer dort drueben zu entzuenden!", "sagt: ");
AI("feuer",
"Dort im Osten kann man eines entfachen!", "sagt: ");
  

  AddInfo("elsurion",
  "lacht: Der Wurm schimpft sich Zauberer.\n");
  AddInfo("ritual",
  "sagt: Das lernst Du bald sehr gut kennen.\n");


  AddInfo(({"auge","augen"}),
  "grinst und sagt: Deine werde ich essen.\n");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Was soll ich mit Deinem Muell!!!\n" }) );

  SetProp(P_SPELLRATE,90);
  AddSpell(2,500,
    "Der Kannibalenpriester sticht Dir mitten in Dein Herz.\n",
    "Der Kannibalenpriester sticht @WEM mitten in sein Herz .\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 800,
  "Der Kannibalenpriester raubt Dir Deine Seele.\n",
  "Der Kannibalenpriester raubt @WESSEN Seele.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,400,
  "Der Kannibalenpriester schlitzt deine Bauchdecke auf.\n",
  "Der Kannibalenpriester schlitzt @WESSEN Bauchdecke auf.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,500,
  "Der Kannibalenpriester zerquetscht Deine Eingeweide.\n",
  "Der Kannibalenpriester zerquetscht @WESSEN Eingeweide.\n",
  DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,500,
  "Der Kannibalenpriester hetzt Dir eine Satanskobra auf den Hals.\n",
  "Der Kannibalenpriester hetzt @WEM eine Satanskobra auf den Hals.\n",
  DT_POISON, "gift", ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,500,
  "Der Kannibalenpriester spricht den Skorpionzauber ueber Dir.\n",
  "Der Kannibalenpriester spricht den Skorpionzauber ueber @WEM.\n",
  DT_POISON, "gift", ([SP_SHOW_DAMAGE:1]));
     

  SetChats(3, ({
  "Der Kannibalenpriester lacht Dich aus.\n",
  "Der Kannibalenpriester blickt Dich veraechtlich an.\n",
  "Der Kannibalenpriester versinkt in tiefer Trance.\n",
  "Der Kannibalenpriester grinst Dich blutruenstig an.\n",
  "Du denkst an Flucht.\n",
  "Der Kannibalenpriester betet archaische Formeln.\n",
  "Der Kannibalenpriester murmmelt in einer fremden Sprache.\n",
  "Dir beginnen die Knie zu zittern...\n",
  "Der Kannibalenpriester bereitet ein grausiges Ritual vor.\n",
  "Der Kannibalenpriester schaerft seinen Opferdolch.\n",
  "Der Kannibalenpriester geht einen Schritt auf Dich zu.\n",
  "Der Kannibalenpriester scheint Dich zu verhoehnen.\n",
  "Der Kannibalenpriester krammt in einer Truhe.\n",
  "Der Kannibalenpriester verzieht sein Gesicht zu einer Fratze.\n"}) );
  
  
  
  SetAttackChats(10, ({
  "Der Kannibalenpriester schreit: Dein Tod wird quallvoll sein!!!\n",
  "Der Kannibalenpriester verwirrt Dich.\n",
  "Der Kannibalenpriester bruellt: Dich fressen wir lebendig!!!\n",
  "Der Kannibalenpriester lacht Dich nur aus.\n",
  "Der Kannibalenpriester hoehnt: Du mickriger Wurm?\n",
  "Der Dolch des Kannibalenpriesters blitzt auf.\n",
  "FLUECHTE!!! FLUECHTE!!! Solange Du noch kannst...\n",
  "Das Gesicht des Kannibalenpriesters wird zu einer Fratze.\n",
  "Der Kannibalenpriester verflucht Deine Seele.\n"}) );
  
  


}




die(arg)
  {
  object ob, pent;
  ob=present("DANTE_ANKH", TP);
  
   if(!ob)  {
      heal_self(1000);
      return ;  //kein betrug:-)
       }
  
  if(ob)  { ob->remove(1);
  
  write(BS(
  "Dein Ankh zerbricht in 1000 Teile!"));
  domainshout(""+this_player()->name(WER,RAW)+" hat den Kannibalenpriester besiegt.\n");
  call_other(KROOM"fels16", "new_priest");
   
   pent=clone_object("d/dschungel/dante/fisch/kannibalen/obj/pent");   
   
    if(!deep_present("DANTE_PENT", TP)) {
    	pent->move(TP, M_NOCHECK);
    write(BS(
    "Der Priester wirft etwas auf Dich! Du faengst es aber geschickt auf!"));
    }
  
      
      }
      
     
       
  ::die(arg);
  }

  _query_wimpy() { return 0;}



 Defend(int dam, string dtype, int spell, object enemy)
   {
   object ankh;
   ankh=present("DANTE_ANKH", TP);

if(!ankh)  {
 return ::Defend(dam/3, dtype, spell, enemy);}

 
 if(ankh)  {

 if(ankh->QP(P_WIELDED))   {
 

   tell_object(enemy,
   "Du stichst dem Kannibalenpriester mitten ins Herz!\n");
 return ::Defend(dam*2, dtype, spell, enemy);
     }
   else
   {
  return ::Defend(dam/5, dtype, spell, enemy);}
  //dummheit muss bestraft werden
          }
    }








  void gift( object enemy, int damage, mixed dam_type)
  {
  int poison, maxpoison;
  if( random(2)==1)
   {
  poison=enemy->QueryProp(P_POISON)+3;
  maxpoison=enemy->QueryProp(P_MAX_POISON);

  enemy->SetProp(P_POISON,poison>maxpoison?maxpoison:poison);
   }
  }
  
  
