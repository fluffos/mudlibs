// dante@SilberLand

#include "../kani.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer verfallenen Huette (Geheimraum)" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun in einem sehr kleinen Geheimraum, bist aber noch immer "
"in der verfallenen Huette. Hier liegen auch Truemmer herum "
"und von der ehemaligen Einrichtung ist nichts mehr zu erkennen. "
"Du kommst durch eine kleine Spalte wieder hinaus."));


AD(({"raum","geheimraum"}),
"Hmm, wozu diente dieser Raum frueher einmal...");

AD("spalte",
"Durch sie kommst Du wieder hinaus.");
AD("decke",
"Die Decke ist stark beschaedigt.");

AD("huette",
"Die Huette ist voellig verfallen und ueberall liegen Truemmer herum.");
AD("truemmer",
"Die Truemmer sind die ehemalige Einrichtung der Huette. Viel ist davon "
"nicht mehr zu erkennen.");
AD("einrichtung",
"Sie ist entweder zerfallen oder zerstoert worden.");
AD("boden",
"Der Boden ist sehr staubig und uebersaeht mit Truemmern.");
AD("staub",
"Der liegt hier massenhaft herum.");

AD(({"wand","waende"}),
"Die Waende sind staubig und stellenweise eingefallen.");
    
    AD("stille",
    "Stille...");
  
  
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );

  AddDetail(("grab"),
   "Du steckst sozusagen ueber den Toten.");
   AddDetail(({"tote","toter","toten"}),
   "Vielleicht kommt ja bald einer zu Dir.");
  AD(({"gott","totengott"}),
  "Der Totengott der Kannibalen ist ein grausames Monster, das jeden Toten "
  "selbst verspeist.");
  AD("monster",
"Der Totengott ist blutruenstig.");
AddSound(DEFAULT_SOUND, 
    "Hier ist es totenstill.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Lehm.");
  AddSmell("lehm",
  "Der Lehm riecht feucht.");


AIT(KNPC"kinkk", REFRESH_DESTRUCT);

AE("raus", "./kata2");

}