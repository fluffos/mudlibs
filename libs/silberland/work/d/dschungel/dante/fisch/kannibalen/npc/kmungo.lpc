//mungo fuer quest dante 97

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <actions.h>




void init()
{
  ::init();
      if(interactive(TP)) call_out("hallo",0);
          }   

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Koenig aller Mungos");
  SetProp(P_LONG, BS(
  "Vor Dir steht der Koenig aller Mungos, der schlimmste Feind der Schlangen. "
  "Sie hassen und fuerchten ihn wie die Pest. Dir ist er aber gutgesinnt, "
  "doch angreifen solltest Du ihn besser nicht."));
  
  
  SetProp(P_NAME, "Mungokoenig");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  
  AddId(({"mungokoenig","koenig", "mungo"}));
  set_living_name("mungo");
  create_default_npc(99);
  
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 250,({DT_BLUDGEON,DT_TERROR}) }));
  SetProp(P_BODY, 200);
  SetProp(P_RACE, "Mungo");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp( P_RESISTANCE, ALL_DAMAGE_TYPES );    
    
  SetProp(P_MSGIN, "schnellt herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "stampft polternd herein");
  SetProp(P_MMSGOUT,  "stampft davon");
  SetProp(P_SPELLRATE, 80);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_DIE_MSG,  " bricht laut stoehnend nieder und stirbt.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_DEFEND_FUNC, TO);
  

}


die(arg)  {
	heal_self(1000);
	return 1;
     }	

  void hallo()
    {
       object ob;
       object einsi;
       
       ob=deep_present("schlangenwaffe", TP);
         einsi=deep_present("DANTE_EINSIEDLER_TAUSCH", TP);

    if(ob && einsi)    {

    ob->remove(1);
    einsi->AddId("MUNGOPOWER");
    
    write(BSA(
    "AH! Danke sehr "+TPN+"! Genau die wollte ich!",
    "Der Koenig sagt: "));

    write(BS(
    "Der Mungo nimmt Dir die Schlangenwaffe weg. "
     "Dann konzentriert er sich und Du spuerst wie die Kraft von 1000 Mungos in Dich "
     "uebergeht. Sie ist aber nur kurzzeitig wirksam und nur gegen den Koenig "
     "der Kobras anwendbar."));

      return;
      
      }

    else
    {
       command("emote sagt: "+ TP->name(RAW) +", sei froh, dass Du keine Schlange bist.\n");
    }
 }
    