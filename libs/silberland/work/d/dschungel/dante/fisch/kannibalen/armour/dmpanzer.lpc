/*
** mutantenspinnenpanzer dante sl jaenner 97
** 
*/
#include <thing/material.h>
inherit "std/armour";
#include <new_skills.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer","mutantenspinnenpanzer","spinnenpanzer",
  "DANTE_SPINNEN_PANZER"}));
  SetProp (P_SHORT, "Ein Mutantenspinnenpanzer");
  SetProp (P_LONG, BS("Das ist der Panzer der dreikoepfigen Mutantenspinne. Er passt"
  " Dir sehr gut, denn fuer Deinen Kopf und Deine beiden Arme sind ja die Loecher"
  " der drei Koepfe da."));
  SetProp (P_NAME, "Mutantenspinnenpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 500);
  SetProp(P_INFO, "Der Panzer ist sicher braucbar.\n");
  SetProp (P_VALUE, 0);
  SetProp (P_MATERIAL,([ MAT_HORN:100]));
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 30);
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);  
  
  
}
