

#include "files.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "/d/dschungel/dante/fisch/kannibalen/room/std_grube.lpc"


int heilen=5;

int i;

create()
{
  ::create();

grube_std();

  
AddDetail(("boden"),
"Der Boden ist mit Sand bestreut, doch hier sieht man kein Blut, sondern "
"ein grosses, in den Sand gemaltes Symbol.");
AddDetail(("symbol"),
"Das Symbol sagt Dir nichts, aber auf unerklaerliche Weise geht von ihm eine "
"positive Kraft aus. Vielleicht solltest Du es beruehren...");
AddDetail(("kraft"),
"Die Kraft koennte ja heilende Wirkung haben ?\n");
AddDetail(("blut"),
"Langsam versiegt es im Boden...");



for(i=0; i<1+random(3); i++)  {
AIT(KNPC"stdsnake", REFRESH_DESTRUCT);
 }
AddExit("osten", "./gr3");

 AddCmd(({"beruehre","beruehr"}), "beruehren");
  


  
//  AddItem(NPC_WEG"bmamba", REFRESH_DESTRUCT);
 // AddItem(NPC_WEG"dschlange", REFRESH_DESTRUCT);
  
  
  AddCmd(({"kletter","klettere","steig"}), "klettern");
 
    
}

int klettern(string str)
{
notify_fail ("Wohin willst Du hinklettern ?\n");
if ( !str) 
return 0;

if ( member ( ({"raus","nach draussen","nach oben","aus grube","aus schlangengrube"}), str) !=-1 )
{
write
( " \n"
"Du versuchst verzweifelt an der glatten Lehmwand aus der Grube zu klettern, rutscht aber immer wieder ab...\n");
say(""+TPN+" versucht aus der Grube zu klettern, rutscht an der glatten lehmwand aber immer wieder ab.\n");

return 1;
}
return 0;
}

reset()
{
heilen = 5;
::reset();
}

beruehren(string str)
{
notify_fail("Was willst Du hier beruehren ?\n");
if ( str != "symbol")
return 0;

if (!heilen)
{
write( " \n"
"Du beruehrst das Symbol am Boden, doch leider passiert nichts...\n");
say(""+TPN+" bueckt sich zum Boden, doch nichts scheint zu geschehen.\n");
return 1;
}
if ( str == "symbol")
write(" \n"
"Du beruehrst das Symbol, und spuerst wie positive Energie in Dich uebergeht.\n");
say(""+TPN+" bueckt sich zum Boden und steht kurz darauf erholt wieder auf.\n");
TP->heal_self(50+random(20));
heilen--;
return 1;
}



