

#include "files.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "/d/dschungel/dante/fisch/kannibalen/room/std_grube.lpc"
int i;

create()
{
  ::create();

grube_std();
 AddDetail(({"wand"," waende"}),
  "Die Waende bestehen aud glattem Lehm, und sind ziemlich hoch. Im Nordosten "
  "kannst Du eine kleine etwas, etwas erhohente Nische erkennen, die vielleicht "
  "Schutz vor den lauernden Bestien bietet...");
  AddDetail(("nische"),
  "Du kannst sie im Nordosten betreten...");
  AddDetail(("nordosten"),
  "Im Nordosten liegt eine kleine Nische. Sie koennte Deine Rettung sein...");
  AddDetail(("schutz"),
  "Schutz haettest Du hier bitter noetig!");
  
  AddCmd(({"kletter","klettere","steig"}), "klettern");
   AddExit("suedwesten", "./gr3");
   AddExit("suedosten","./gr1");
  AddExit( "nordosten", "./nische");
  AddExit( "sueden", "./gr");


for(i=0; i<1+random(3); i++)  {
AIT(KNPC"stdsnake", REFRESH_DESTRUCT);
 }
}

int klettern(string str)
{
notify_fail ("Wohin willst Du hinklettern ?\n");
if ( !str) 
return 0;

if ( member ( ({"raus","nach draussen","nach oben","aus grube","aus schlangengrube"}), str) !=-1 )
{
write
( " \n"
"Du versuchst verzweifelt an der glatten Lehmwand aus der Grube zu klettern, rutscht aber immer wieder ab...\n");
say(""+TPN+" versucht aus der Grube zu klettern, rutscht an der glatten lehmwand aber immer wieder ab.\n");

return 1;
}
return 0;
}

