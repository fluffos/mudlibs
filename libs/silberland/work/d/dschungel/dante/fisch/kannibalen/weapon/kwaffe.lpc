//waffe fuer tantalus


#include "files.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>

create()
{
  if( !is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine merkwuerdige Stangenwaffe");
  SetProp(P_LONG, BS(
"Diese Waffe besteht aus einer sehr langen Stange an deren Spitze "
"mehrer scharfe Zacken angebracht wurden. Seltsame Zeichen verzieren sie "
"und von ihr geht eine sehr angenehme freundliche Aura aus."));

  SetProp(P_NAME, "Stangenwaffe");
  
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEAPON_TYPE, WT_MAGIC );
  SetProp(P_DAM_TYPE, DT_MAGIC);
  SetProp(P_WC, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_NEVERDROP, 1);
  SP(P_NODROP, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_HIT_FUNC, TO);
SP(P_INFO, BS(
"Mit dieser heiligen Waffe kannst Du nun gegen Tantalus antreten!!!"));

  AddId(({"stange","stangenwaffe", "krakenwaffe", "waffe"}));
}

int HitFunc(object enemy)
{
  int schaden;
  if( enemy->id("tantalus")||enemy->id("tentakel") )
  {
    schaden=random(600);
    if( schaden>300)
      write("Die Stangenwaffe zischt und wendet ihre gute Magie gegen "+
       enemy->name(WEN)+".\n");
    return 5*enemy->QueryProp(P_LEVEL)+schaden;
  }
  write(CAP(enemy->name(WER) )+" ist mit der Schlangenwaffe nicht zu verwunden.\n");
  return -250;      
}
