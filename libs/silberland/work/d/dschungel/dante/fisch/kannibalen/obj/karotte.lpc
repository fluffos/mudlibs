
inherit "std/thing";

#include <properties.h>
#include <thing.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine sehr grosse Karotte");
  SetProp (P_LONG, "Eine leckere, reife, grosse Karotte.\n");
  SetProp (P_NAME, "Karotte");
  SetProp (P_GENDER, FEMALE);
  AddId (({"karotte", "gemuese", "DANTE_KAROTTE"}));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NOBUY, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp (P_MATERIAL, ([MAT_FOOD:100]));
}

