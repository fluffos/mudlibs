// hinter dem steintor am plateau zweiter raum

#include "files.h"
inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Felsspalte" );
  SetProp( P_INT_LONG, BS(
   "Hier endet die kleine Schlucht ploetzlich an einer steil aufragenden "
   "Felswand, die von wilden Pflanzen ueberwuchert ist. Du fuehlst Dich "
   "beklemmt und unwohl zwischen all dem Fels. In einiger Hoehe faellt Dir"
   " Etwas in der Wand auf. Ueberall sieht man gruenes Kletterefeu."));
   AddDetail(("hoehe"),
   "Tja, das etwas ist ziemlich hoch oben...\n");
   AddDetail(("etwas"),
   "Du betrachtest die Wand naeher und erkennst eine kleine Felsnische.\n");
   AddDetail(({"nische","felsnische"}),
   "Die Nische ist zwar ziemlich hoch oben, aber irgendwie kann man sie\n"
   "sicher erklimmen. Vielleicht mit dem Efeu?!");
   
   AddDetail(("weg"),
   "Der Weg fuehrt vom Steintor weiter in die kleine Schlucht hinein.\n");
   AddDetail(("knick"),
   "Der Weg endet hier jaeh an einer steilen Felswand.\n");
   AddDetail(({"felswand","felswaende","wand","waende"}),
   "Die Waende sind steil und wild bewachsen. Ob man sie erklimmen kann?\n");
   
   AD(({"spalt","spalte"}),
   "Eng, schmal, dunkel, unheimlich...");
   
   AddDetail(("schlucht"),
   "Diese kleine Schlucht ist eher eine Spalte zwischen zwei steil nach oben \n"
   "ragenden Felswaenden.\n");
   AddDetail(({"tor","steintor"}),
   "Das Tor kann man von hier aus nicht sehen.\n");
   AddDetail(({"plateau","hochplateau"}),
   "Von hier aus kann man kaum was vom Plateau erkennen, obwohl Du ja noch \n"
   "immer auf ihm bist.\n");
   AddDetail(("fels"),
   "Du bist hier eigentlich von Fels umzingelt.\n");
  AddDetail(("himmel"),
  "Am blauen Himmel kann man keine einzige Wolke sehn.\n");
  AddDetail(("sonne"),
  "Hoch am Himmel steht die Sonne und brennt unbarmherzig herunter.\n");
   AddDetail(({"pflanze","pflanzen"}),
   "Die Waende sind voller exotischer Pflanzen. Lianen haengen von oben \n"
   "herab, Kletterefeu windet sich nach oben, am Boden stehn kleine Buesche,\n"
   "ein tropischer Gummibaum waechst fast bis nach oben...\n");
  AddDetail(({"liane","lianen"}),
  "Die Lianen haengen ueber den oberen Rand bis ganz nach unten. Ob man an\n"
  "ihnen hochklettern kann?\n");
  AddDetail(({"boden", "buesche","busch"}),
  "Ein kleiner mickriger Busch. Er hat hier wohl zu wenig Sonne...\n");
  AddDetail(({"efeu","kletterefeu"}),
  "Das Efeu schlaengelt sich vom Boden nach oben.\n");
  AddDetail(("gummibaum"),
  "Aus so einem Baum kann man Kautschuk gewinnen.\n");
  AddDetail(("kautschuk"),
  "Kautschuk ist eine Art Naturgummi...\n");   
   AD("baum",
   "Na ein Baum eben!");
   AD("art",
   "In etwa...");
   AD(({"gummi","naturgummi"}),
   "Recht weich und knetbar.");   
    AD("wolke",
    "KEINE! Doch eine, und die lacht Dich aus!");
    
  
  SetProp( P_LIGHT, 1 );
  
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

 AddDetail(("dschungel"),
 "Vom Dschungel ist hier wenig zu sehn...\n");

AD(({"blume", "blumen"}),
"Die Blumen sind wild geschlaengelt. Du solltest sie ausgraben.");


  AddSound( DEFAULT_SOUND,
    "Von weiter oben glaubst Du etwas zu hoeren.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es rauchig.");

  
  AddExit( "osten", "./fels11");


ACD(({"kletter","klettere","erklimme","erklimm"}),"nix",1);




AddCmd(({"grabe","grab"}), "get");

}


int get(string str)  {
  object ob;


  NF("Was willst Du hier ausgraben? Und womit? Ohne Schaufel wird das nichts!?\n"
  "syntax <grabe mit schaufel blume aus>!\n");
  

if(!str)  { write(BS(
"Du kannst hier nur mit einer Schaufel graben."));
return 1; }


  
  if(member(({"mit schaufel blume aus",
              "mit schaufel blumen aus",
              "erde mit schaufel um",
              "blume mit schaufel aus",
              "blumen mit schaufel aus"
              }),str)!=-1)  {
              
    if(!present("schaufel", TP)) { 

    write(BS("Du graebst mit blossen Haenden, doch das ist sinnlos. "
    "Nebenbei bemerkt, Du hast gar keine Schaufel!"));

    return 1;  }


    
    if(deep_present("DANTE_ROTE_BLUME", TP)) {
    write(BS("Du graebst mit der Schaufel in der Erde herum. "
   "Doch kannst Du keine Blume ausgraben."));
   
    return 1; }

      if(!deep_present("DANTE_EINSIEDLER_TAUSCH", TP)) {
    write(BS("Du graebst mit der Schaufel in der Erde herum. "
   "Doch kannst Du irgendwie die Blume nicht ausgraben. Hmm, vielleicht musst "
   "Du ja zuerst was anderes machen..."));
   
    return 1; }
    
    
    if(!present("DANTE_KAROTTE", TP))  {
    write(BS("Du graebst mit der Schaufel in der Erde herum. "
    "Du schaffst es eine der roten Blumen austugraben! Hurra!"));
    ob=clone_object(KOBJ"rblume");
    ob->move(TP, M_NOCHECK);

    return 1; }

    return 0; }

return 0; }
    
        



int nix(string str)  {
   write( BS(
   "Du kannst hier klettern und erklimmen soviel Du willst, Du schaffst "
   "es nicht zur Nische! Aber, was ist das da! Einige rote Blumen!"));
   return 1; }
   
   