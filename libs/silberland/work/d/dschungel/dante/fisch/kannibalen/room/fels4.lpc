// a, felsen by dante 97

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <wizlevels.h>

int heilen=5;

//  Dschungel, Erde, Gesang,  Idylle

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Rand des Hochplateaus" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun mitten im dichtesten Dschungel des Plateaus. Vor Dir, "
  "hinter Dir, ueberall bist Du von Pflanzen umgeben. Sie wuchern so dicht, "
  "dass Du den Boden kaum erkennen kannst auf dem Du stehst. Auch den Himmel "
  "und die Sonne kann man durch das dichte Blaetterdach kaum mehr sehen. "));

  AddDetail(({"pflanzen","pflanze"}),
  "Bunte, grosse Baeume ragen in den Himmel. Farne kitzeln Dich und exotisch "
  "anmutende Blumen erfreuen Dich. ");
  AddDetail(({"baeume","baum"}),
  "Du kannst an den Baeumen nicht aussergewoehnliches erkennen.\n");
  AddDetail(({"farn","farne"}),
  "Die Farne ueberragen Dich um einiges.\n");
  AddDetail(({"blumen","blume"}),
  "Sie duften wunderbar...\n");
  AddDetail(("himmel"),
  "Er scheint blau und voellig klar zu sein.\n");
  AddDetail(("sonne"),
  "Die Sonne schickt ihre waermenden Strahlen auf die Erde, doch hier dringen "
  "nur sehr wenige ein. ");
  AddDetail(({"blaetterdach","dach"}),
  "Die vielen Pflanzen bilden beinahe ein Dach ueber Deinen Kopf. ");
AD("kopf",
"Viel ist nicht gerade drin...");
AD("erde",
"Gute Erde aus dem Dschungel.");

  AddDetail(({"blatt","blaetter"}),
  "Zaehl sie bitte fuer mich ab...");
  AddDetail(("boden"),
  "Der Boden scheint trocken aber weich zu sein.\n");
  AddDetail(({"strahl","strahlen","sonnenstrahlen","sonnenstrahl"}),
 "Die Sonnenstrahlen fallen durch das dichte Blaetterdach auf den Boden und\n"
 "bilden merkwuerdigerweise einen kleinen Kreis auf der Erde.\n");


 AddDetail(("kreis"),
 "Dieser Kreis ist von einem Druiden hier angelegt worden. Welche Bedeutung "
 "mag er wohl haben?");
AD("bedeutung",
"Das solltest Du herausfinden!");



 AddDetail(({"druide","druiden"}),
 "Der ist schon lange nicht mehr hier...\n");
 
  AddDetail(({"plateau","hochplateau"}),
  "Das kleine, verborgen gelegene Plateau ist eine stille Idylle im sonst so"
  "feindlichen Urwald.\n");
  AddDetail(({"urwald","dschungel"}),
  "Der Dschungel hier scheint voellig unberuehrt zu sein.\n");
  AD("idylle",
  "AHHH, wie romantisch!");
  
  
  SetProp( P_LIGHT, 1 );
  
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  
  AddSound( DEFAULT_SOUND,
    "Du hoerst des Gesang vieler verschiedener Voegel.");
    
   AddSound(({"voegel","vogel","gesang"}),
    "FIEPP!!!!");    
  AddSmell( DEFAULT_SMELL,
    "AHHH!!! Herrlich diese gute Luft...");

AddSmell("luft",
"Frisch und rein!");

//  AddItem( ({NPC_WEG"darcheo", NPC_WEG "dkakadu", NPC_WEG "dkoli",
//             NPC_WEG "dkobra"}), REFRESH_DESTRUCT);
  
  AIT(KNPC"forscher", REFRESH_DESTRUCT);
  
  
  AddExit( "westen", "./fels6");
  AddExit( "osten", "./fels2");

 AddCmd( ({"betrete", "betritt"}), "tele");


}

 int tele(string str)
 {
 notify_fail("Was willst Du hier machen?\n");
 if( !str ) return 0;
 if( member( ({"kreis", "druidenkreis"}),str) !=-1 )
 {
  write(BS(
  "Du betrittst den Druidenkreis!"));
  say(BS(
  CAP_TPN+" betritt einen Druidenkreis!"));

  if(heilen)  {
  	write(BS(
  	"AHH!!! Das tat gut!"));
  TP->heal_self(25+random(25));
  heilen--;  
  return 1; }
  	
          
   if(!heilen)  {
   	write(BS(
   "Leider passiert nichts!"));
   return 1; }
   return 0; }
   return 0; }
   
   
   reset() {
   	::reset();
   heilen=5;
   }
