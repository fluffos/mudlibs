#include "files.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#define TIME 180

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer sicheren Nische" );
  SetProp( P_INT_LONG, BS(
  "Du hast Dich in eine sicher Nische vor den Schlangen retten koennen. "
  "Vielleicht kannst Du ja hier dem scheinbar schon sicheren Tod entgehen. "
  "Der Boden ist aber auch hier mit Blut besudelt, also bleib nicht zu "
  "lange hier..."));
 
 SP(P_KILL_NAME, "Langes Warten und eine Giftschlange");
 
  
  AddDetail( ({ "gott", "schlangengott" }), 
    "Der Schlangengott verlangt dieses Morden!" );
  AddDetail( ({ "morden" }), 
    "Morden erheitert die Schlangen." );
  AddDetail( ({ "verwesung" }), 
    "Du ekelst Dich!" );
  AddDetail( ({ "zeit" }), 
    "Die Zeit steht hier still." );
  AddDetail( ({ "tod" }), 
    "Der Tod lauert ueberall hier." );
  AddDetail( ({ "opfer" }), 
    "Du willst doch keines sein!" );
  AddDetail(("leben"),
  "Auch Deines ist hier in Gefahr...");
  AddDetail(("gefahr"),
  "Die Gefahr lauert hier ueberall!");
  AddDetail(({"schlange","schlangen","vipern","viper","natter","nattern"}),
  "Sie lauern draussen vor der Nische...");
  AddDetail(({"otter","ottern"}),
  "Sie lauern draussen vor der Nische..");
  AddDetail(({"wand"," waende"}),
  "Die Waende bestehen aud glattem Lehm.");
  AddDetail(("lehm"),
  "Der Lehm weist hier viele Kratzer und Loecher auf.");
  AddDetail(({"kratzer"}),
  "Doe Verzweifelten Opfer versuchen hier noch einmal ihr Leben zu retten.");
  AddDetail(({"loecher","loch"}),
  "Die Loecher scheinen voellig uninteressant zu sein... ");
  AddDetail(("nische"),
  "Diese Nische ist mitten in der Schlangengrube, sie kann Dich aber "
  "sicherlich eine Zeit vor den Schlangen schuetzen. Du kannst aus der Nische rausklettern.");
  AddDetail(("zischen"),
  "Die Schlangen kommen immer naeher...");
  AddDetail(("klappern"),
  "War da nicht eben eine grosse Klapperschlange hinter Dir...");
  AddDetail(("grube"),
  "Du stehst mitten in der Schlangegrube...");
  AddDetail(("kannibalen"),
  "Die Kannibalen werfen, wenn sie satt sind manchmal wehrlose Opfer "
  "in diese Grube. Pass bloss auf, dass sie Dich hier nicht finden...");
  AddDetail(("schlangengrube"),
  "Wehrlose Opfer werden hier dem Schlangengott geopfert...");
AddDetail(("dschungel"),
"Aus der Grube heraus kannst Du nur mehr die Geraeusche des Dschungels hoeren..."); 
AddDetail(("boden"),
"Der Boden ist auch hier gezeichnet vom Morden der Schlangen.");
AddDetail(("blut"),
"Langsam versiegt es im Boden...");
  AddDetail(("himmel"),
  "Den Himmel kann man aus der Nische kaum mehr erkennen...");
  AddDetail(({"teil","teile","leichenteile","leichenteil"}),
  "Hier liegen weniger Teile herum als draussen...");
   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier ist es voellig windstill.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die wuetenden Schlangen draussen zischen...");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Verwesung.");
  SP(P_KILL_NAME, "Zu langes Warten und Feigheit");
  
    
AddExit("raus", "./gr4");
  
   AddRoomMessage(({ 
    "Irgendwie bekommst Du ein unangenehmes Gefuehl.\n",
    "Bist Du hier wirklich in Sicherheit...\n",
    "Du hoerst Dich selbst im Hilfe rufen....\n",
    "Dir schlottern die Knie...\n",
    "Du solltest nicht zu lange hier verweilen...\n",
    "Du bekomst einen kalten Schweissausbruch....\n",
    "Eine Satanskobra richtet sich draussen vor der Nische drohend auf...\n",
    "Bleib nicht zu lange hier...\n",
    "Du hoerst ein lautes Zischen von draussen...\n",
    "Du schauderst vor dem grausigen Anblick...\n",
    }),10);
  
     
}

init()  {
	::init();
 if(interactive(TP))  {
    if(!present("schlange", TO))  {
    	call_out("hihi", TIME);
        }   
     }      
 }
        
       hihi()  {
       object ob;
     if(TO!=environment(TP) )  { return; }
     
     write(BS(
     "Ploetzlich schiest eine Giftschlange herein! Sie beisst Dir in den Arm "
     "und ist genauso schnell wieder verschwunden."));
    TP->do_damage(10);
    TP->AddPoison(2+random(2));
    }
     	
     	 	