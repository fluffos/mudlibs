// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
// , Fruechte, Gruens, Himmel, Mitte, , Wasser.

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich in der Mitte des Felsplateaus. Im Osten und Sueden "
  "erhebt sich eine hohe Felswand. Der Dschungel um Dich herum blueht und "
  "gedeiht wie im Paradies. Das Plateau streckt sich von hier nach Westen "
  "und Norden aus. Der Boden ist hier weicher als sonst."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
AD("himmel",
"Der Himmel ist hier voellig wolkenfrei!");
  AD("mitte",
  "Hier ist so ungefaehr die Mitte.");
  AD(({"gruen","gruens"}), 
  "Herrlich ist es hier, aber auch gefaehrlich!");
  
  AddDetail( ({"boden"}),
    "Der Boden besteht hier teilweise aus brauner Erde.");
    AD("erde",
    "Die Erde ist recht weich und vielleicht kann man hier ja was unternehmen...");
    
    
  AddDetail(("norden"),
  "Du versuchst in den Dschungel einzudringen, gibst aber bald wieder auf.\n");
  AddDetail(("paradies"),
  "Hier mag es zwar so aussehn, aber...\n");
  AddDetail(("westen"),
  "In diese Richtung kann man sich einen Weg bahnen...\n");
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im "
    "Dschungel erhebt.\n");
  AddDetail(({"osten","sueden"}),
  "Die Felswaende ringsum Dich scheinen nicht zu bezwingen.");
  AddDetail(({"fels","wand","felswand", "spitze"}),
  "Die Felswand fuehrt weiter nach oben auf die Spitze des Felsen. Wie man "
  "da wohl hinauf gelangen kann?\n");
  AddDetail(({"plateau","hochplateau", "felsplateau", "insel"}),
  "Du stehst auf einem kleinen Hochplateau, einer Insel inmitten des\n"
  "ewigen Gruens...");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedich durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Die Vegetation scheint doch etwas anders als am Boden zu sein...\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Irgendwo hier fliesst Wasser...");
    
    AddSound("wasser",
    "Es muss sehr nahe sein.");
    
  AddSmell( DEFAULT_SMELL,
    "Du glaubst irgendwelche Fruechte zu riechen.");
AddSmell(({"frucht","fruechte"}),
"Sie scheinen suess zu duften!");

  //AddItem( ({NPC_WEG"dschlange1", NPC_WEG "gmamba", NPC_WEG "dratte", 
   //          NPC_WEG "dkoli"}), REFRESH_DESTRUCT);
  
  AddExit( "westen", "./fels5");
  AddExit( "osten", "./fels1");

ACD(({"grab","grabe"}), "get");

}

int get(string str){
object ob;
	NF("Wo willst Du hier graben?!\n");
	
if(str=="in erde"||str=="erde"||str=="erde um")  {

     write(BS(
      "Du graebst in der Erde."));
	
if(!present("schaufel", TP))  {
	write(BS(
	"Mit blossen Haenden kommst Du nicht weit. Du gibts auf!"));
	return 1; }

if( (deep_present("DANTE_MUENZE", TP)) || (deep_present("DANTE_ANKH", TP)) )    {
	write(BS(
"Du graebst immer tiefer. Doch Du findest hier nichts! Gib auf!"));
return 1; }

write(BS(
"Du graebst mit der Schaufel tief nach unten und findest eine Muenze!!!"));
ob=clone_object("/d/dschungel/dante/fisch/kannibalen/obj/muenze");
ob->move(TP, M_NOCHECK);
      return 1; }
return 0; }

