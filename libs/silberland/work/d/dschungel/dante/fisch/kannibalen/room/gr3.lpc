

#include "files.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "/d/dschungel/dante/fisch/kannibalen/room/std_grube.lpc"
int i;

create()
{
  ::create();

grube_std();

  AddExit("nordosten","./gr4");
  AddExit( "osten" ,"./gr");
  AddExit( "suedosten", "./gr2");
  AddExit( "westen", "./gr5");  

for(i=0; i<1+random(3); i++)  {
AIT(KNPC"stdsnake", REFRESH_DESTRUCT);
 }
}


int klettern(string str)
{
notify_fail ("Wohin willst Du hinklettern ?\n");
if ( !str) 
return 0;

if ( member ( ({"raus","nach draussen","nach oben","aus grube","aus schlangengrube"}), str) !=-1 )
{
write
( " \n"
"Du kletterst an der glatten Lehmwand aus der Schlangengrube hinaus.\n");
TP->move(KROOM"vorgrube", M_GO,
"an der glatten Lehmwand aus der Schlangengrube hinaus", "klettert",
"kommt mit aengstlichem Blick aus der Schlangengrube geklettert");
return 1;
}
return 0;
}

