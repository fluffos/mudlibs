//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../kani.h"


int an=0;

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Handbohrer (aus)");
  
  SetProp(P_LONG,BS(
  "Das ist ein kleiner Handbohrer, so wie man ihn zum Beispiel beim "
  "Zahnarzt braucht. Eine schreckliche Vorstellung! "
  "Er wird haendisch betrieben und ist eine sehr einfach Konstruktion. "
  "Du kannst ihn ein- und ausschalten. "));
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 50);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Handbohrer");
  SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_METAL:90]));
  SetProp(P_INFO, ("SURRRRRRR!!!KREISCH!!!!!QIETSCHHHHHHHHH!!!!\n"));
  AddId(({"bohrer","handbohrer","zahnbohrer", "DANTE_BOHRER"}));
  SetProp(P_NOBUY, 1);
   SetProp(P_SOUND, ("Der Bohrer gibt kein Geraeusch von sich.\n"));
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddCmd(({"schalte","schalt"}), "act");
  
  
}

int act(string str)
   {
   notify_fail("Was willst Du ein oder ausschalten?\n");
   
 
   if (str=="bohrer aus")
      {

    if(an!=1)  {
  write(BS(
  "Der Bohrer ist schon ausgeschalten."));
      return 1;  }


      write("Du schaltest den Bohrer aus.\n");
      say(CAP_TPN+" schaltet einen Bohrer aus.\n");
      
      SetProp(P_SHORT, "Ein Handbohrer (aus)");
      SetProp(P_SOUND, ("Der Bohrer gibt kein Geraeusch von sich.\n"));

     RemoveId("bohr");
     an=0;
     
     return 1;
     }
 
 
   
   if (str=="bohrer ein")
 
 {     
 
     if(an==1)  {
     	
     write(BS(
     "Der Bohrer ist schon eingeschalten."));
     return 1; }
 
     	
      write("Du schaltest den Bohrer ein, er surrt, doch viel scheint "
      "da nicht zu passieren.\n");
      say(""+TPN+" schaltet einen Bohrer ein.\n");
      SetProp(P_SHORT, "Ein Handbohrer (ein)");
      SetProp(P_SOUND, ("Der Boher summt leise.\n"));
     an=1;
     AddId(({"bohr"}));
     
     return 1;
     
     }
 
return 0; 
  }
     