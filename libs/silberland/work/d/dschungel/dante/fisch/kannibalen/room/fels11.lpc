// hinter dem steintor am plateau
//dante 97 - 2000
#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>


/*
 , Kopf, Schwaerme, Taeuschung
 */
 



create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hinter dem Felstor" );
  SetProp( P_INT_LONG, BS(
   "Der Weg macht einen scharfen Knick und fuehrt Dich in einen enge, kleine "
   "Schlucht. Wozu das Steintor fragst Du dich, hier scheint ja nix, zu sein. "
   "Die steilen Waende sind hier voller Pflanzen, die sich den Fels verdreht nach oben "
   "winden. "));
   
   AddDetail(("weg"),
   "Der Weg fuehrt vom Steintor weiter in die kleine Schlucht hinein.\n");
   AddDetail(("knick"),
   "Der Weg biegt hier scharf nach Westen um. ");
   AddDetail(({"felswand","felswaende","wand","waende"}),
   "Die Waende sind steil und wild bewachsen. Ob man sie erklimmen kann?\n");
   
   
   AD("taeuschung",
   "Dir wird auf einmal uebel. Bist Du vergiftet?!");
   
   
   AddDetail(("schlucht"),
   "Diese kleine Schlucht ist eher eine Spalte zwischen zwei steil nach oben "
   "ragenden Felswaenden.\n");
   AddDetail(({"tor","steintor"}),
   "Das Tor fuehrt wieder nach draussen auf das Hochplateau\n");
   AddDetail(({"plateau","hochplateau"}),
   "Von hier aus kann man kaum was vom Plateau erkennen, obwohl Du ja noch "
   "immer auf ihm bist.\n");
   AddDetail(("fels"),
   "Du bist hier eigentlich von Fels umzingelt.\n");
  AddDetail(({"spalte","spalt"}),
  "Wenn Du senkrecht nach oben schaust, glaubst Du, dass der Spalt nach oben"
  " hin immer enger wird. Tja, wahrscheinlich eine optische Taeuschung? Man "
  "erkennt auch einen strahlendblauen Himmel, die Sonne steht am Zenit und "
  "ein paar Voegel ziehen vorbei.\n"); 
  AddDetail(("himmel"),
  "Am blauen Himmel kann man keine einzige Wolke sehn.");
  AddDetail(({"vogel","voegel"}),
  "Exotische Voegel ziehen ueber Dich hinweg.\n");
  AddDetail(("sonne"),
  "Hoch am Himmel steht die Sonne und brennt unbarmherzig herunter.\n");
  AddDetail(("zenit"),
  "Hmm, was koennte das wohl sein?\n");
  AddDetail(({"wolken","wolke"}),
   "Ueber den Wolken muss die Freiheit wohl grenzenlos sein...\n");
   AD("freiheit",
   "Die Freiheit im Dschungel ist grenzenlos, aber gefaehrlich.");
   
   AddDetail(({"pflanze","pflanzen"}),
   "Die Waende sind voller exotischer Pflanzen. Lianen haengen von oben "
   "herab, Kletterefeu windet sich nach oben, am Boden stehn kleine Buesche,"
   "ein tropischer Gummibaum waechst fast bis nach oben...");
  AddDetail(({"liane","lianen"}),
  "Die Lianen haengen ueber den oberen Rand bis ganz nach unten. Ob man an"
  " ihnen hochklettern kann?");
  AddDetail(({"boden", "buesche","busch"}),
  "Ein kleiner mickriger Busch. Er hat hier wohl zu wenig Sonne...\n");
  AddDetail(({"efeu","kletterefeu"}),
  "Das Efeu schlaengelt sich vom Boden nach oben.\n");
  AddDetail(({"gummibaum","baum"}),
  "Aus so einem Baum kann man Kautschuk gewinnen.\n");
  AddDetail(("kautschuk"),
  "Als Du Dir gerade ueberlegst, was Kautschuk wohl ist, siehst Du auf \n"
  "auf ein Seil von oben herab haengen, das Du wohl uebersehen hast.\n");
  
  AddDetail(("seil"),
  "An diesem Seil kann man sich sicher hochhangeln...\n"); 
  SetProp( P_LIGHT, 1 );
  
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

 AddDetail(("dschungel"),
 "Vom Dschungel ist hier wenig zu sehn...\n");

  AddSound( DEFAULT_SOUND,
    "Von weiter oben glaubst Du Stimmen zu hoeren.");
    
    AddSound(({"stimme","stimmen"}),
    "Die Stimmen sind recht leise.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Rauch und Feuer.");

AddSmell(({"rauch","feuer"}),
"Du wirst doch etwas aengstlich!\n");
  
  AddExit( "nordosten", "./fels10");
  AddExit( "westen", "./fels12");

 AddCmd( ({"hangel","hantel","hangle","hantle"}), "hangel");
ACD(({"kletter","klettere"}), "nix");
 
}


int hangel(string str)
{
 notify_fail("Wohin willst Du ?\n");
 if( !str ) return 0;
 if(str=="mit seil nach oben"||str=="auf seil hoch"||str=="auf seil nach oben"||
            str=="an seil hoch"||str=="an seil nach oben"||
            str=="mit seil hoch")   {
            
   write("Du hangelst Dich am Seil hoeher.\n");
   TP->move(KROOM"fels13", M_GO, "nach oben","klettert",              
             "kommt von unten herauf geklettert");
             return 1;
        }
return 0; }
        
        
int nix (string str)  {        
        
        NF("Womit oder wo willst Du hier nach oben klettern?!\n");
        
    if(str=="an liane hoch"||str=="mit liane rauf"||str=="an liane rauf"||str=="mit liane nach oben"||
    str=="liane rauf"||str=="liane nach oben"||str=="liane hinauf")  {    
        
       write(BS(
       "Irgendwie schaffts Du es mit der Liane nicht nach oben. Hmm, es gibt aber sicher irgendwie "
       "einen Weg hier nach oben!"));
       return 1; }
        
             return 0;
             }   
             
