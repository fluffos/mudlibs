//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../kani.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein grosser Giftzahn");

  SetProp(P_LONG,BS(
  "Das ist ein grosser Giftzahn einer Kobra. Er gehoerte eins dem Koenig "
  "der Kobras, den Du mit der Hilfe eines Mungos getoetet hast."));

  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Giftzahn");
  SP(P_NAME_ADJ, "gross");
  SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_MISC_POISON:10]));
  AddId(({"giftzahn","zahn","DANTE_KOBRAZAHN"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}
