//mungo fuer quest dante 97

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <actions.h>




void init()
{
  ::init();
      if(interactive(TP)) call_out("hallo",0);
          }   

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Koenig aller Mungos");
  SetProp(P_LONG, BS(
  "Vor Dir steht der Koenig aller Mungos, der schlimmste Feind der Schlangen. "
  "Sie hassen und fuerchten ihn wie die Pest. Dir ist er aber gutgesinnt, "
  "doch angreifen solltest Du ihn besser nicht."));
  
  
  SetProp(P_NAME, "Mungokoenig");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  
  AddId(({"mungokoenig","koenig", "mungo"}));
  set_living_name("mungo");
  create_default_npc(30);
  
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 250+random(30),({DT_BLUDGEON,DT_TERROR}) }));
  SetProp(P_BODY, 200+random(10));
  SetProp(P_RACE, "mungo");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE, 0);
SetProp( P_RESISTANCE, ALL_DAMAGE_TYPES );    
    
     SetProp(P_ATTRIBUTES, ([A_INT:50, A_DEX:70, A_STR:50, A_CON:45]) );
  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "stampft polternd herein");
  SetProp(P_MMSGOUT,  "stampft davon");
  SetProp(P_SPELLRATE, 80);
  SetProp(P_NOMAGIC, 99);
  SetProp(P_DIE_MSG,  " bricht laut stoehnend nieder und stirbt.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_DEFEND_FUNC, TO);
  

}


void give_notify(object ob)
     {
       if( (ob->id("schlangenwaffe") ) )
               {
    write("Der Koenig der Mungos lacht sich fast Tod ueber Deine Dummheit!!!\n"
     "\n"
     "Der Koenig der Mungos sagt zynisch grinsend: \n"
     "So einen grossen Idioten wie Dich hab ich ja selten gesehen.\n"
     "Eigentlich sollte ich Dich ja nun toeten, aber Du bist mit\n"
      "Deiner Dummheit schon genug gestraft. Schaemt sich Deine Mutter\n"         
     "eigentlich fuer Dich!*lach*!Los hau ab Du Idiot!\n");
     ob->remove();
      write("Der Koenig der Mungos zerbricht die Schlangenwaffe in 1000 Stuecke.\n");
         return;
        }
      ::give_notify(ob);
    }





Defend(int dam, dam_type) 
{    
 object enemy, schl;
 
   if(!(enemy = QueryEnemy()))
       enemy = TP ;
                         

  if(schl = present("schlangenwaffe", enemy))
    {
        if(schl -> QueryWielded())
              return ::Defend(dam, dam_type) ;
                  else                                                          
          tell_object(enemy,                                                             
        "Der Koenig der Mungos sieht zu Tode erschreckt die Schlangenwaffe an.\n");
        
        }
         tell_object(enemy,                                                              
          "Der Koenig der Mungos lacht: Mit der Waffe willst Du mich angreifen?\n");
          StopHuntingMode() ;
          enemy->StopHuntingMode() ;  
       
       }
 





die()
{
  object obj;
  object z;
  
    if(!obj=QueryEnemy())
        obj=TP;
     
     write("Du erschlaegst den Koenig der Mungos und Deine Schlangenwaffe "
     "verwandelt sich in einen Giftzahn!!!\n");
     
       if(obj=present("schlangenwaffe", obj))
           obj->remove();
      z=clone_object("/d/dschungel/dante/fels/obj/ding6.lpc");
      z->move(environment(TP), M_TPORT);                                                                     
            ::die() ;      
            
     }
                     


 void NotifyPlayerDeath(object player, object killer, int lostexp)  
 {
 command("nimm alles aus leiche");
 }
 


  void hallo()
    {
    
    if(present("schlangenwaffe", TP))
    {
    command("emote zuckt erschreckt zusammen und sagt: "+ TP->name(RAW) +", gib mir bitte die Schlangenwaffe. "
    "Ich werde Dich dafuer reich belohnen.\n");
    }
    else
    {
       command("emote sagt: "+ TP->name(RAW) +", sei froh, dass Du keine Schlange bist.\n");
    }
 }
    