#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"krakenauge","auge" ,"DANTE_KRAKENAUGE"}));
 SetProp(P_NAME,"Krakenauge" );
 SP(P_NAME_ADJ, "gross");
 SetProp(P_GENDER, NEUTER);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein grosses Krakenauge" );
 SetProp(P_LONG,BS(
 "Das ist also eines der seltenen, grossen Krakenaugen."));
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_MISC_DEAD: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

}
