//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
inherit "std/thing"; 
int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"trollflunder", "flunder", "D_FISCH", "fisch"}));
 SetProp(P_NAME,"Trollflunder" );
 SetProp(P_GENDER,FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine Trollflunder" );
 SetProp(P_LONG,BS(
 "Die Trollflunder sieht dem flachen Schaedel eines Trolls recht aehnlich, "
 "wenn man will..."));
SP(P_NOBUY, 1);
SP(P_WEIGHT, 60);
SP(P_VALUE, 0);
SP(P_INFO, "Die Trollflunder haelt nicht ewig!\n");




 
}
    
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
      