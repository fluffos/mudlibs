#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"haken", "DANTE_HAKEN"}));
 SetProp(P_NAME,"Haken" );
 SP(P_NAME_ADJ, "spitz");
 SetProp(P_GENDER, MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein spitzer Haken" );
 SetProp(P_LONG,BS(
  "Das ist genau der Haken den Du zum angeln benoetigst.")); 
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_STEEL: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

}
