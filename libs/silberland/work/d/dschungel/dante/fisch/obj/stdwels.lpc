//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();

wie=({"Bartel","Hai","Grundel", "Panzer","Silber","Tijara",
      "Schlamm", "Wuehl","Boden", "Midas"});
//10
i=random(sizeof(wie));


 AddId(({"wels", "D_FISCH", "fisch", ""+lower_case(wie[i])+"wels",
  ""+wie[i]+"wels"}));
 SetProp(P_NAME,""+wie[i]+"wels" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein "+wie[i]+"wels" );
  SetProp(P_LONG,BS(
 "Die Welse sind grosse Fische, die am liebsten am Boden nach "
 "Nahrung suchen. Sie lieben schlammiges Wasser! "
 "Dieser hier ist ein "+wie[i]+"wels!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Welse verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 2000);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         