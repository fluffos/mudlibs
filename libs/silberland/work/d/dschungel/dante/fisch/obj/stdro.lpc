//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();


wie=({"Platt","Pfeil","Gift", "Panzer","Dschungel","Stachel",
      "Punkt", "Streifen","Linien", "Silber"});

i=random(sizeof(wie));

 AddId(({"rochen", "D_FISCH", "fisch", ""+wie[i]+"rochen",
  ""+lower_case(wie[i])+"rochen"}));
  
 SetProp(P_NAME,""+wie[i]+"rochen" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein "+wie[i]+"rochen" );
  SetProp(P_LONG,BS(
 "Die Rochen sind sehr merkwuerdige Unterwassertiere. Manche sind "
 "hochgiftig, andere voellig harmlos! "
 "Dieser hier ist ein "+wie[i]+"rochen!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Rochen verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 400);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         
