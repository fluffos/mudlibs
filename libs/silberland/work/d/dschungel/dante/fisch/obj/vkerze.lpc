//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

int burning=0;

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine schwarze Kerze");
  SetProp(P_LONG,BS(
  "Das ist eine der seltenen, schwarzen Kerzen. Sie gehoerte einst einer "
  "Harpye. Sie weist ueberall seltsame Verzierungen auf..."));
SP(P_NAME_ADJ, "schwarz");
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Kerze");
  SetProp(P_INFO, "Diese Kerze kann man nicht mehr loeschen...\n"
  "Ausserdem ist da noch ein kleines Schild!");
  ASD("schild", "doof");
  SetProp(P_MATERIAL, ({MAT_WAX, MAT_MAGIC}));
  AddId(({"vkerze","kerze"}));
  SetProp(P_NOBUY, 1);
  AddDetail(({"verzierung","verzierungen"}),
  "Sie sehen irgendwie Tentakel aehnlich...");
  AddDetail("tentakel",
  "Naja, aehnlich...");
  AddCmd(({"zuende", "zuend"}), "burn");  
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
}

 string doof()   {
return ("Wenn Du das liest "+TPN+", weisst Du, das Du doof bist!\n");
}

 int burn(string str)
   {
   notify_fail("Was willst Du anzuenden?\n");
   if(str=="kerze an")
       {
       if(burning)
          {
          write("Aber die Kerze brennt ja bereits!\n");
          return 1;
          }
       if(!burning)
         {
         RemoveId("vkerze");
         AddId(({"kerze_burn"}));
         write("Du zuendest die schwarze Kerze an!\n");
         SetProp(P_SHORT, "Eine brennende, schwarze Kerze"); 
         SetProp(P_NAME_ADJ, ({"brennend", "schwarz"}));
         return 1;
         }
   return 0;
   }
  return 0;
  }
  
