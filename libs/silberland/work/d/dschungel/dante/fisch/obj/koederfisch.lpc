//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;
create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"fisch", "DANTE_KOEDER_FISCH", "koederfisch"}));
 SetProp(P_NAME,"Koederfisch" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein kleiner Koederfisch" );
 SetProp(P_LONG,BS(
 "Diese kleinen Fische haben keinen eigenen Namen. Da sie gute Koeder sind, "
 "nennt man sie hier Koederfische!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Koederfische verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fischfleisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
	if(environment(TO))  {
		tell_object(environment(TO),
  TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }}
  
   
         
