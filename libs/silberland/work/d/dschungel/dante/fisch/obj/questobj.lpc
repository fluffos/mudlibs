//questobjeckt fuer die fischerquest
/*
"zaehlt" die bereits gefangenen fische usw............."
*/


#include "/players/dante/myowndefine.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>

string *fische;
mapping erledigt;
int gekauft_bei_gus;

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine alte, zerschliessene Seemuetze");
  SetProp(P_NAME, "Seemuetze");
  SetProp(P_GENDER, FEMALE);
  SP(P_LONG, BS(
  "Eine alte zerschliessene Muetze, die man nicht mehr aufsetzen kann. "
  "Diese Muetze ist keine normale "
  "Muetze. Sie merkt sich genau welche Fische Du bereits gefangen und Doby Mick "
  "gebracht hast und auch Dir noch fehlen. Welche Fische Du genau fangen "
  "sollst, weisst Du noch nicht, vielleicht hilft Dir aber das eingestickte "
  "Wappen weiter."));
  
  AddId( ({"muetze", "DANTE_FISCH_LISTE", "seemuetze"}));
  SP(P_NAME_ADJ, ({"alt", "zerschliessen"}));
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);
AD("wappen",
"Das Wappen zeigt eine Vielzahl von bekannten und unbekannten Fischen. Sie "
"sind kreisfoermig angeordnet. Der Kreis scheint mehr zu bedeuten. ");
AD("kreis",
"Die Fische sind kreisfoermig eingestickt. Aber was soll das?! Vielleicht "
"solltest Du die Muetze genauer untersuchen!");
AD(({"fisch","fische"}),
"Es sind recht viele Fische und so betrachtet sagen sie Dir auch nicht viel. ");







}


 _query_info()
 
{
  string ret;
  int i;


  ret = "Das Wappen zeigt einige Fische und andere Wassertiere:\n\n"; 
  for(i=0; i<sizeof(fische); i++)
  {
     ret += " - "+fische[i]+((erledigt[fische[i]])?("   (gefangen)"):"")+"\n";
  }
  ret += 
     "\nWenn Du einen Fisch gefangen hast, so bring ihn einfach \n"
     +"dem alten Fischer Doby Mick. Er merkt sich genau welcher es war.\n";    
  return ret;
}


void SetZutaten(string *arg)
{
  int i;  
  
  erledigt = ([]);
  fische = arg;
  for (i=0; i<sizeof(fische); i++)
    erledigt[fische[i]] = 0;
  return;
}

string *QueryZutaten() { return fische; }

void SetZutatErledigt(string key) { erledigt[key] = 1; }

int QueryZutatErledigt(string key) { return erledigt[key]; }

int QueryErledigt() 
{ 
  int i, done;

  done = 1;
  for(i=0; i<sizeof(fische); i++)
  {
    if(!erledigt[fische[i]]) 
      done = 0;
  }
  return done;
}


mixed _query_autoloadobj()
{
  return ({erledigt, fische, gekauft_bei_gus, QueryProp(P_IDS) });
}
void _set_autoloadobj(mixed arg)
{
  if (sizeof(arg) > 1)
  {
    erledigt=arg[0];
    fische=arg[1];
    gekauft_bei_gus=arg[2];
    AddId(arg[3]);
  }
}




