#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"griff","DANTE_GRIFF"}));
 SetProp(P_NAME,"Griff" );
 SP(P_NAME_ADJ, "dick");
 SetProp(P_GENDER, MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein dicker Griff" );
 SetProp(P_LONG,BS(
"Das ist der Griff, der zu Deiner Angel passt."));
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_OAK: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

}
