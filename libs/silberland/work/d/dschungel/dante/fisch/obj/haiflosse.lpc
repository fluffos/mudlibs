//haiflosse

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"haiflosse", "flosse", "flossen", "haiflossen", "DANTE_HAIFLOSSE"}));
 SetProp(P_NAME,"Haiflosse" );
 SP(P_NAME_ADJ, "lang");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine lange Haiflosse" );
 SetProp(P_LONG,BS(
"Das ist die seltene Flosse eines grossen, gruenen Dschungelhaies. Du solltest "
"sie eigentlich Doby Mick abliefern! <syntax: dschungelhai>."));
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_MISC_LIVING: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);
 SP(P_AUTOLOADOBJ, 1);
}
