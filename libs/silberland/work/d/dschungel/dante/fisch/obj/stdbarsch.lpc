//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();

wie=({"Silber","Zacken","Kannibalen","Alligator"});

i=random(sizeof(wie));


 AddId(({"barsch", "D_FISCH", "fisch", ""+lower_case(wie[i])+"barsch",
  ""+wie[i]+"barsch"}));
 SetProp(P_NAME,""+wie[i]+"barsch" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein "+wie[i]+"barsch" );
  SetProp(P_LONG,BS(
"Barsche sind mittelgrosse Fische, die aeusserst schnell sind. "
 "Dieser hier ist ein "+wie[i]+"barsch!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Barsche verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 168);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         