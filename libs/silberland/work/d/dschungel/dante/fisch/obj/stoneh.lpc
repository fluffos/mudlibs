#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"hai", "STEINHAI", "steinhai"}));
 SetProp(P_NAME,"Hai" );
 SP(P_NAME_ADJ, "versteinert");
 SetProp(P_GENDER, MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein versteinerter Hai" );
 SetProp(P_LONG,BS(
"Du siehst einen kleinen, versteinerten Hai vor Dir. Hmm, wie wurde "
"der wohl versteinert? Angeblich haben solche versteinerten Haie "
"irgendwelche magischen Kraefte."));

 SP(P_INFO, BS(
 "Dieser Hai gehoert zu einer Zeremonie, um die Harpune zu bekommen."));
 
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 20);
 SP(P_MATERIAL, ([MAT_STONE: 50, MAT_MISC_MAGIC:100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

}