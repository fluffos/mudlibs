//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
//#include <fishing.h>

inherit "std/thing";

//6 koeder... pro fischgruppe einer
int muschel_da=0;
int schnecke_da=0;
int wattwurm_da=0;
int krebs_da=0;
int fisch_da=0;
int mehlwurm_da=0;

int koeder_da=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"angel", "DANTE_ANGEL"}));
 SetProp(P_NAME,"Angel" );
 SetProp(P_GENDER,FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine Angel" );
 SetProp(P_LONG,BS(
 "Das ist Deine komplette Angel. Sie besteht aus einem Griff, in dem eine "
 "lange Rute steckt. Daran ist eine Schnur befestigt. An der Schnur ist ein "
 "Haken befestigt. Du bist auf Deine Angel sehr stolz!"));

 SP(P_INFO, BS(
 "Du kannst einen Koeder an den Haken stecken! Aber immer nur einen! "
 "Du kannst den Koeder aber auch wieder entfernen. <entferne koedername>"));
 
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 500);
 SP(P_MATERIAL, ([MAT_OAK: 80, MAT_COTTON: 15, MAT_METAL: 5]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);
AD("griff",
"Der Griff ist aus Holz.");
AD("rute",
"Die Rute ist aus Holz. Sie ist sehr biegsam.");
AD("holz",
"Holz eben.");
AD("schnur",
"Die Schnur ist aus Baumwolle.");
AD(({"wolle", "baumwolle"}),
"Tja, damit angelt man hier eben.");
ASD("haken", "show_koeder");

ACD(({"entferne", "entfern"}), "koeder_weg");
ACD(({"spiess", "spiesse"}), "koe_der"); 
}



int koeder_weg(string str)  {
 object get_muschel;
 object get_schnecke;
 object get_wattwurm;
 object get_mehlwurm;
 object get_krebs;
 object get_fisch;
 
 NF("Was willst Du entfernen?\n");
 
 if(!koeder_da)  {
   write("Der Haken ist doch leer!\n");
   return 1; }
 if(str=="wurm")  {
 write("Welchen Wurm?!\n");
 return 1; }
if(str=="fisch")  {
  write("Du meinst einen Koederfisch!\n");
  return 1; }
 
 if(str=="koeder")  {
 if(!koeder_da)  {
   write("Der Haken ist doch leer!\n");
   return 1; }
 if(str=="koeder")  { 
  write("Bitte genauen Koedernamen!\n");
  return 1; }
  return 0; }
   


if (str=="muschel")   {
 if (muschel_da==0)   {
write("Du willst eine Muschel vom Haken entfernen, aber da ist keine!\n");
return 1; }

if(muschel_da!=0)   {
 write("Du entfernst die Muschel wieder vom Haken.\n");
 muschel_da=0;
 koeder_da=0;

 TO->RemoveId("DANTE_ANGEL_MUSCHEL");

 get_muschel=clone_object("/d/dschungel/dante/fisch/obj/muschel");
 get_muschel->move(TP, M_GET);
 return 1; }
 return 0; }



if (str=="krebs")   {
 if (krebs_da==0)   {
write("Du willst einen Krebs vom Haken entfernen, aber da ist keiner!\n");
return 1; }

if(krebs_da!=0)   {
 write("Du entfernst den Krebs wieder vom Haken.\n");
 krebs_da=0;
 koeder_da=0;

 TO->RemoveId("DANTE_ANGEL_KREBS");

 get_krebs=clone_object("/d/dschungel/dante/fisch/obj/krebs");
 get_krebs->move(TP, M_GET);
 return 1; }
 return 0; }




if (str=="mehlwurm")   {
 if (mehlwurm_da==0)   {
write("Du willst einen Mehlwurm vom Haken entfernen, aber da ist keiner!\n");
return 1; }

if(mehlwurm_da!=0)   {
 write("Du entfernst den Mehlwurm wieder vom Haken.\n");
 mehlwurm_da=0;
 koeder_da=0;

 TO->RemoveId("DANTE_ANGEL_MEHLWURM");

 get_mehlwurm=clone_object("/d/dschungel/dante/fisch/obj/mehlwurm");
 get_mehlwurm->move(TP, M_GET);
 return 1; }
 return 0; }



if (str=="koederfisch")   {
 if (fisch_da==0)   {
write("Du willst einen Koederfisch vom Haken entfernen, aber da ist keiner!\n");
return 1; }

if(fisch_da!=0)   {
 write("Du entfernst den Koederfisch wieder vom Haken.\n");
 fisch_da=0;
 koeder_da=0;

 TO->RemoveId("DANTE_ANGEL_FISCH");

 get_fisch=clone_object("/d/dschungel/dante/fisch/obj/koederfisch");
 get_fisch->move(TP, M_GET);
 return 1; }
 return 0; }



if (str=="schnecke"||str=="wasserschnecke")   {
 if (schnecke_da==0)   {
write("Du willst eine Schnecke vom Haken entfernen, aber da ist keine!\n");
return 1; }

if(schnecke_da!=0)   {
 write("Du entfernst die Schnecke wieder vom Haken.\n");
 schnecke_da=0;
 koeder_da=0;

 TO->RemoveId("DANTE_ANGEL_SCHNECKE");

 get_schnecke=clone_object("/d/dschungel/dante/fisch/obj/schnecke");
 get_schnecke->move(TP, M_GET);
 return 1; }
 return 0; }



if (str=="wattwurm")   {
 if (wattwurm_da==0)   {
write("Du willst einen Wattwurm vom Haken entfernen, aber da ist keiner!\n");
return 1; }

if(wattwurm_da!=0)   {
 write("Du entfernst den Wattwurm wieder vom Haken.\n");
 wattwurm_da=0;
 koeder_da=0;

 TO->RemoveId("DANTE_ANGEL_WATTWURM");

 get_wattwurm=clone_object("/d/dschungel/dante/fisch/obj/wattwurm");
 get_wattwurm->move(TP, M_GET);
 return 1; }
 return 0; }


 return 0; }
  

//ende


  string show_koeder()   {
  if(!koeder_da)  {
  write("Der Haken ist leer!\n");  }

  if(muschel_da!=0)   {
  write("Du hast eine Muschel als Koeder auf den Haken gespiesst!\n");  }

  if(schnecke_da!=0)   {
  write("Du hast eine Wasserschnecke als Koeder auf den Haken gespiesst!\n");  }

  if(wattwurm_da!=0)   {
  write("Du hast einen Wattwurm als Koeder auf den Haken gespiesst!\n");  }

  if(krebs_da!=0)   {
  write("Du hast einen Krebs als Koeder auf den Haken gespiesst!\n");  }

  if(mehlwurm_da!=0)   {
  write("Du hast einen Mehlwurm als Koeder auf den Haken gespiesst!\n");  }

  if(fisch_da!=0)   {
  write("Du hast einen Koederfisch als Koeder auf den Haken gespiesst!\n");  }


  return ""; }






  
  
  
  int koe_der(string str)   {
   object koeder, hat_muschel, hat_schnecke, hat_wattwurm,
   hat_krebs, hat_fisch, hat_mehlwurm;
  NF("Was willst Du auf den Haken spiessen?!\n");
  
  hat_muschel=present("DANTE_KOEDER_MUSCHEL", TP);
  hat_schnecke=present("DANTE_KOEDER_SCHNECKE", TP);
  hat_wattwurm=present("DANTE_KOEDER_WATTWURM", TP);
  hat_mehlwurm=present("DANTE_KOEDER_MEHLWURM", TP);
  hat_krebs=present("DANTE_KOEDER_KREBS", TP);
  hat_fisch=present("DANTE_KOEDER_FISCH", TP);
  
  if(koeder_da)   {
  write("Aber Du hast schon einen Koeder am Haken!\n");
  return 1; }
  
  if(str=="wurm an haken"||str=="wurm auf haken")  {
  write("Welchen Wurm?!\n");
  return 1; }
  
  
  if(str=="fisch an haken"||str=="fisch auf haken")  {
  write("Welchen Fisch?! Einen Walhai oder etwa den Koederfisch?!\n");
  return 1; }
  
  
  if(str=="koeder an haken"||str=="koeder auf haken")  {
  write("Welchen Koeder! Bitte genauen Namen des Koeders!\n");
  return 1; }
  
//muschel

  if(str=="muschel an haken"||str=="muschel auf haken")   {

  if(!hat_muschel)   {
  write("Du hast keine geeignete Muschel!\n");
  return 1; }
  
  if(hat_muschel) {

  write("Du spiesst die Muschel auf den Haken! Brutal!\n");
  hat_muschel->remove();
  muschel_da=1;
  koeder_da=1;
  TO->AddId("DANTE_ANGEL_MUSCHEL");
  return 1; }
  return 0; }
  
//muschelende
  
//schnecke

  if(str=="schecke an haken"||str=="schnecke auf haken" ||
  str=="wasserschnecke auf haken"|| str=="wasserschecke an haken")   {

  if(!hat_schnecke)   {
  write("Du hast keine geeignete Schnecke!\n");
  return 1; }
  
  if(hat_schnecke) {

  write("Du spiesst die Schnecke auf den Haken! Brutal!\n");
  hat_schnecke->remove();
  schnecke_da=1;
  koeder_da=1;
  TO->AddId("DANTE_ANGEL_SCHNECKE");
  return 1; }
  return 0; }
  
  //schnecke ende
  
  
//wattwurm

  if(str=="wattwurm an haken"||str=="wattwurm auf haken")  {

  if(!hat_wattwurm)   {
  write("Du hast keinen geeigneten Wattwurm!\n");
  return 1; }
  
  if(hat_wattwurm) {

  write("Du spiesst den Wattwurm auf den Haken! Brutal!\n");
  hat_wattwurm->remove();
  wattwurm_da=1;
  koeder_da=1;
  TO->AddId("DANTE_ANGEL_WATTWURM");
  return 1; }
  return 0; }

//mehlwurm
  if(str=="mehlwurm an haken"||str=="mehlwurm auf haken")  {

  if(!hat_mehlwurm)   {
  write("Du hast keinen geeigneten Mehlwurm!\n");
  return 1; }
  
  if(hat_mehlwurm) {

  write("Du spiesst den Mehlwurm auf den Haken! Brutal!\n");
  hat_mehlwurm->remove();
  mehlwurm_da=1;
  koeder_da=1;
  TO->AddId("DANTE_ANGEL_MEHLWURM");
  return 1; }
  return 0; }
  //krebs
  
  if(str=="krebs an haken"||str=="krebs auf haken")  {

  if(!hat_krebs)   {
  write("Du hast keinen geeigneten Krebs!\n");
  return 1; }
  
  if(hat_krebs) {

  write("Du spiesst den Krebs auf den Haken! Brutal!\n");
  hat_krebs->remove();
  krebs_da=1;
  koeder_da=1;
  TO->AddId("DANTE_ANGEL_KREBS");
  return 1; }
  return 0; }


//koederfisch
  
  if(str=="koederfisch an haken"||str=="koederfisch auf haken")  {

  if(!hat_fisch)   {
  write("Du hast keinen geeigneten Koederfisch!\n");
  return 1; }
  
  if(hat_fisch) {

  write("Du spiesst den Koederfisch auf den Haken! Brutal!\n");
  hat_fisch->remove();
  fisch_da=1;
  koeder_da=1;
  TO->AddId("DANTE_ANGEL_FISCH");
  return 1; }
  return 0; }

  
  return 0; }
  
     
