#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"schnur","DANTE_SCHNUR"}));
 SetProp(P_NAME,"Schnur" );
 SP(P_NAME_ADJ, "lang");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine lange Schnur" );
 SetProp(P_LONG,BS(
"Diese Schnur ist ideal zum zusammenbinden von Dingen."));
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_COTTON: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

}
