/*
das hier ist das zweite questobject fuer die fischerquest
*/


inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_NAME, 0);
  AddId( ({"SEC_OBJ", "DANTE_FISCH_LISTE_ZWEI"}));
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_AUTOLOADOBJ, 1);
 }
