//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();

wie=({"Fluss","Dschungel","Regenbogen"});

i=random(sizeof(wie));


 AddId(({"forelle", "D_FISCH", "fisch", ""+lower_case(wie[i])+"forelle",
  ""+wie[i]+"forelle"}));
 SetProp(P_NAME,""+wie[i]+"forelle" );
 SetProp(P_GENDER,FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine "+wie[i]+"forelle" );
  SetProp(P_LONG,BS(
"Forellen gehoeren zu den schoensten und schnellsten Fischen ueberhaupt. "
 "Diese hier ist eine "+wie[i]+"forelle!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Forellen verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 200);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         