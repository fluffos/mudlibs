#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"rute", "DANTE_ANGEL_TEIL"}));
 SetProp(P_NAME,"Rute" );
 SP(P_NAME_ADJ, "lang");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine lange Rute" );
 SetProp(P_LONG,BS(
 "Das ist einer der Teile Deiner Angel. Eine Art lange Rute aus Holz. "
 "Es fehlen noch der Griff, die Schnur und der Haken. Wenn Du "
 "alle anderen Teile hast, bau einfach die Angel zusammen. "
 "syntax <angelbau>."));
 
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 100);
 SP(P_MATERIAL, ([MAT_OAK: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

ACD(({"angelbau"}), "bau_angel");
}
 int bau_angel()  {
 	object haken, griff, schnur, angel;
 haken=present("DANTE_HAKEN", TP);
 schnur=present("DANTE_ANGELSCHNUR", TP);
 griff=present("DANTE_GRIFF", TP);
 
 if(!haken)  {
 	write("Aber Dir fehlt noch der Haken.\n");
 	return 1; }
 if(!schnur)  {
 	write("Aber Dir fehlt ja noch die Schnur!\n");
 	return 1; }
 if(!griff)  {
 	write("Aber wo ist denn Dein Griff?!\n");
 	return 1; }
 else  {
  haken->remove();
  schnur->remove();
  griff->remove();
 angel=clone_object(FO"angel");
 angel->move(TP, M_GET);
 write(BS(
 "Du baust die vier Teile zu einer ganzen Angel zusammen und freust "
 "Dich!"));
 say(BS(
 CAP_TPN+" baut sich eine komplette Angel."));
 remove();
 return 1; }
 return 0; }
  					