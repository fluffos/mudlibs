//fisch by dante99sl

inherit "std/thing"; 
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>


int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"dorsch", "palmendorsch", "D_FISCH", "fisch"}));
 SetProp(P_NAME,"Palmendorsch" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein Palmendorsch" );
 SetProp(P_LONG,BS(
  "Der Palmendorsch steht gerne unter Palmen, die direkt am Ufer wachsen."));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Fische verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 145);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

}
     
      
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
 