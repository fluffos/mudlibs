#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"zahn", "HAIZAHN", "haizahn"}));
 SetProp(P_NAME,"Haizahn" );
 SP(P_NAME_ADJ, "lang");
 SetProp(P_GENDER, MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein langer Haizahn" );
 SetProp(P_LONG,BS(
 "Du hast einen langen Haizahn in Haenden. Er sieht eigentlich recht "
 "normal aus, aber irgendeinen tieferen Sinn wird er schon haben."));
 
 SP(P_INFO, BS(
 "Dieser Haizahn gehoert zu einer Zeremonie, um die Harpune zu bekommen."));
 
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 20);
 SP(P_MATERIAL, ([MAT_BONE: 50, MAT_MISC_MAGIC:100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

}