#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>

inherit "std/thing";
int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"tonne", "DANTE_TONNE"}));
 SetProp(P_NAME,"Tonne" );
 SP(P_NAME_ADJ, "alt");
 SetProp(P_GENDER,FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine alte Tonne aus Holz" );
 SetProp(P_LONG,BS(
  "Diese alte Tonne hast Du Dir selbst aus Holz und einer Schnur zusammengebaut. "
  "Sie ist sehr stabil, trotzdem nicht all zu schwer. Sie wuerde Dich "
  "bei einem Fall aus grosser Hoehe sicher gut schuetzen!")); 
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_OAK: 90, MAT_LEATHER:10]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);
 
 
 }

reset()  {
::reset();
count++;
if(count>=20)   {
  write("Die Tonne loest sich in Luft auf!\n");
  remove();   } }
  
   
         