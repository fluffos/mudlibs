//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();



 AddId(({"barsch", "D_FISCH", "fisch", "hai"}));
 SetProp(P_NAME,"Todehai" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein Schwarzhai" );
  SetProp(P_LONG,BS(
"Barsche sind mittelgrosse Fische, die aeusserst schnell sind. "));

 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Barsche verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 168);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
   
         