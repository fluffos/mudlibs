//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>

inherit "std/thing";

int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"D_FISCH", "fisch"}));
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Fische verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 100);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS("Dieser Fisch besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write("Ein Fisch verfault gaenzlich!\n");
  remove();   } }
  
   
         