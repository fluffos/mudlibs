//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>

inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();

wie=({"Spiegel","Fett","Wurm","Blau","Silber", "Ork"});
      
i=random(sizeof(wie));

 AddId(({"karpfen", "D_FISCH", "fisch", ""+wie[i]+"karpfen",
 ""+lower_case(wie[i])+"karpfen"}));
 
 SetProp(P_NAME,""+wie[i]+"karpfen" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein "+wie[i]+"karpfen" );
  SetProp(P_LONG,BS(
"Die Karpfen sind ruhige und friedliche Fische! "
 "Dieser hier ist ein "+wie[i]+"karpfen!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Karpfen verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 100);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         
