#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "/d/dschungel/dante/fisch/fisch.h"
inherit "std/thing";


create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"knochen", "DANTE_MOOSBONE"}));
 SetProp(P_NAME,"Knochen" );
 SP(P_NAME_ADJ, "gruen");
 SetProp(P_GENDER, MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein gruener Knochen" );
 SetProp(P_LONG,BS(
"Das ist ein seltsamer, gruener Knochen eines Moosmonsters."));
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, ([MAT_BONE: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);

}
