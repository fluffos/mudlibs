//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>

inherit "std/thing";

int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"neunauge","flussneunauge", "D_FISCH", "fisch"}));
 SetProp(P_NAME,"Flussneunauge" );
 SetProp(P_GENDER,NEUTER);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein Flussneunauge" );
 SetProp(P_LONG,BS(
 "Das Neunauge hat nicht 9 Augen. Oder doch?! Schau doch mal!"));
 AD(({"auge","augen"}),
 "1, 2, mehr werden es nicht!");
 SetProp(P_VALUE,0);
 SP(P_INFO, "Fische verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 30);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         