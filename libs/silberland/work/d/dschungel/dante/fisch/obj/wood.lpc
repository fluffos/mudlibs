//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>

inherit "std/thing";
int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"holz","DANTE_WOOD", "DANTE_HOLZ"}));
 SetProp(P_NAME,"Holz" );
 SetProp(P_GENDER,NEUTER);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Einige Stuecke altes Holz" );
 SetProp(P_LONG,BS(
 "Dieses Holz hast Du im Nest der Harpye gesammelt. Es scheint noch "
 "sehr stabil zu sein, obwohl es so alt ist."));
 SP(P_INFO, "Das Holz kann man gut verweden um daraus eine Art Tonne zu bauen!");
 SetProp(P_VALUE,0);
 SP(P_WEIGHT, 200);
 SP(P_MATERIAL, ([MAT_OAK: 100]));
 SP(P_NOBUY, 1);
 SP(P_NODROP, 1);
 SP(P_NEVERDROP, 1);
 
ACD(({"bau", "baue"}), "do_tonne");
 
 }
 
 int do_tonne(string str)   {
 object ob, tonne;
 ob=present("DANTE_SCHNUR", TP);
 NF("Was willst Du mit dem Holz bauen?! Du Wappler!\n");
 if (str=="tonne mit holz" || str=="tonne aus holz"||str=="tonne")    {
    if(!ob)   {
    write("Du versuchst aus dem Holz eine Tonne zu bauen.\n"
    "Ohne irgendetwas zum zusammenbinden geht das aber nicht!\n");
    return 1; }
    else   {
    say(CAP_TPN+" baut sich eine Art Tonne!\n");
    write("Du nimmst Deine Schnur und das Holz und baust damit eine Tonne!\n");
    ob->remove();
     tonne=clone_object("d/dschungel/dante/fisch/obj/tonne");
     tonne->move(TP, M_GET);
     remove();
     return 1; }
     return 0; }
     return 0; }
     

reset()  {
::reset();
count++;
if(count>=20)   {
  write("Das Holz verfault!\n");
  remove();   } }
  
   
         