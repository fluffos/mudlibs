//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#define COL blau 
inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();

wie=({"rot","blau","gruen","gelb","weiss","schwarz", "orangefarben",
      "tuerkis","pinkfarben","grau"}); 
i=random(sizeof(wie));

 AddId(({"lachs", "D_FISCH", "fisch"}));
 SetProp(P_NAME,"Lachs" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein "+wie[i]+"er Lachs" );
  SetProp(P_LONG,BS(
  "Der Lachs ist einer der schoensten Fische ueberhaupt. Dieser hier ist "
  "ein "+wie[i]+"es Exemplar!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Fische verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 100);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
     
         