//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"teufelskopf", "D_FISCH", "fisch"}));
 SetProp(P_NAME,"Teufelskopf" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein Teufelskopf" );
 SetProp(P_LONG,BS(
 "Der Teufelskopf ist ein ganz spezieller Fisch, der an seinem Kopf 2 "
 "Hoerner hat. Ein ekliger Anblick!"));
 AD(({"kopf", "horn", "hoerner"}),
 "UI, dieser hat ja sogar 3 Hoerner! Ein mutierter Fisch!");
 SetProp(P_VALUE,0);
 SP(P_INFO, "Fische verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 1000);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         