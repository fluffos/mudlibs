//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>

inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();
//im mom 22 haie
wie=({"Haken","Wuerge","Trommel","Pfeil","Gift", "Panzer",
       "Dante","Moerder", "Kuschel", "Blau","Midas",
       "Tijara", "Gouverneurs", "Goblins", "Hammer",
       "Silber", "Todes", "Dunkel", "Nacht", "Sichel", "Riff", "Fluss",
       "Schwarz"});
i=random(sizeof(wie));

 AddId(({"hai", "D_FISCH", "fisch", ""+wie[i]+"hai",  ""+lower_case(wie[i])+"hai",}));
 SetProp(P_NAME,""+wie[i]+"hai" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein "+wie[i]+"hai" );
  SetProp(P_LONG,BS(
 "Die Haie gehoeren zu den gemeinsten und boesartigesten aller Fische. "
 "Dieser hier ist ein "+wie[i]+"hai!"));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Haie verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 500);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         