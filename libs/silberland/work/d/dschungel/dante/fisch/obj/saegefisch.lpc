//fisch by dante99sl

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;

create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"saegefisch", "fisch", "D_FISCH", "fisch"}));
 SetProp(P_NAME,"Saegefisch" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein Saegefisch" );
 SetProp(P_LONG,BS(
 "Der Saegefisch heisst nicht deswegen Saegefisch, weil er etwa ein Maul in "
 "Form einer Saege hat, nein, er heisst deswegen so, weil er angeblich, "
 "wenn er schlaeft unglaublich laut schnarcht. Angeblich. Aber wer hat "
 "schon jemals einen Fisch schnarchen hegoert..."));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Fische verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 500);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
         