#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
//#include <fishing.h>

inherit "std/thing";

int count=0;
create()
{
if (!is_clone(this_object())) return;
 ::create();

 AddId(({"schnecke", "DANTE_KOEDER_SCHNECKE", "wasserschnecke"}));
 SetProp(P_NAME,"Wasserschnecke" );
 SetProp(P_GENDER,FEMALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Eine Wasserschnecke" );
 SetProp(P_LONG,BS(
 "Die Wasserschnecke ist ein ekliges, schleimiges Tier."));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Wasserschnecken verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 10);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Schneckenfleisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
	if(environment(TO))  {
		tell_object(environment(TO),
  TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }}  
   
         