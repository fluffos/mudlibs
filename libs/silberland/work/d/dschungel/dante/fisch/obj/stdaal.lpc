#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>

inherit "std/thing";

int count=0;
int i;
string *wie;

create()
{
if (!is_clone(this_object())) return;
 ::create();

wie=({"lang","kurz","dick","duenn","sehr lang", "sehr dick",
       "sehr kurz","sehr duenn"});
i=random(sizeof(wie));

 AddId(({"aal", "D_FISCH", "fisch"}));
 SetProp(P_NAME,"Aal" );
 SetProp(P_GENDER,MALE);
 SetProp(P_ARTICLE,1);
 SetProp(P_SHORT,"Ein "+wie[i]+"er Aal" );
  SetProp(P_LONG,BS(
"Aale sind laengliche, schleimige Fische, die vor allem im Schlamm leben. "
"Das hier ist ein "+wie[i]+"er Aal."));
 SetProp(P_VALUE,0);
 SP(P_INFO, "Auch Aale verfaulen nach einiger Zeit...\n");
 SP(P_WEIGHT, 200);
 SP(P_MATERIAL, MAT_MISC_DEAD);
 SP(P_NOBUY, 1);

 
}
     
       _query_material()   {
       write
       (BS( TO->QueryProp(P_SHORT)+" besteht aus Fisch, was sonst?!"));
       return "";   }

reset()  {
::reset();
count++;
if(count>=10)   {
  write(TO->QueryProp(P_SHORT)+" verfault gaenzlich!\n");
  remove();   } }
  
   
   