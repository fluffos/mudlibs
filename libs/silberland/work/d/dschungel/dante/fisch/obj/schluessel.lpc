/*
** schlueysel fuer tuer/erde
** 
** 2. 4 97 dante
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "/players/dante/myowndefine.h"


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein kleiner Messingschluessel");
  SetProp (P_LONG, BS(
               "Der Schluesel besteht aus Messing. Damit kann man die Tuer zum "
               "hinteren Zimmer von Wim van Kielhol aufsperren."));  
  SetProp (P_NAME, "Messingschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NOBUY, 1);
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
  SP(P_AUTOLOADOBJ, 1);
  AddId (({"messingschluessel", "schluessel", "DANTE_FISCH_LISTE_SECHS"}));
  
SetProp(P_MATERIAL, ([MAT_METAL:100]));
}


string QueryDoorKey()
{
return ("/d/dschungel/dante/fisch/kannibalen/room/huette1")+":"+("/d/dschungel/dante/fisch/kannibalen/room/huette2");

}


