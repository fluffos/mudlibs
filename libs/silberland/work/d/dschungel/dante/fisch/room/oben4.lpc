//DANTE!!!
//sl 99-98
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"


#define OPFER (member(opfer, getuid(this_player()))!=-1)
 string *opfer=({});
#define ZAHN (member(zahn, getuid(this_player()))!=-1)
 string *zahn=({});
#define GEBET (member(gebet, getuid(this_player()))!=-1)
 string *gebet=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem dunklem Loch hoch ueber den Klippen" );
  SetProp( P_INT_LONG, BS(
  "Du bist nun durch das dunkle Loch direkt in die Klippen gestiegen "
  "und findest eine kleine, feuchte Hoehle vor. Die Nordwand besteht "
  "aus einem grossen, steinernen Altar, der den Haigott darstellt. An der "
  "Westwand siehst Du ein grosses Bild, das einen tiefen Wasserstrudel "
  "symbolisiert. An der Ostwand ist eine bunte Zeichnung angebracht, "
  "die einen Kraken darstellt. Im Sueden geht es wieder hinaus."));



AD("westwand",
"Du siehst dort ein Bild, das einen Wasserstrudel darstellt.");
AD("bild",
"Man sieht dort einen grossen Wasserstrudel.");
AD(({"wasserstrudel","strudel"}),
"Der Strudel dreht sich wie wild. Dir wird schwindlig.");
AD("ostwand",
"Dort sieht man eine Zeichnung.");
AD("zeichnung",
"Sie stellt einen Kraken dar.");
AD(({"kraken","krake"}),
"Der Krake tobt wie wild und Du zuckst zusammen als Du bemerkst wie "
"ein Tentakel Deinen Hals umschlingt!!!");
AD("tentakel",
"Hmm, keiner da, Du scheinst Dich wohl getaeuscht zu haben!!!");
AD("hals",
"Alles in Ordnung damit! Hmm, seltsam...");
AD("ordnung",
"Deinem Hals gehts gut!");


AD(({"wand","waende"}),
"Die Waende sind hier sehr unterschiedlich. Du solltest Dir die "
"Nordwand, die Westwand und die Ostwand genau ansehen!");

AD("nordwand",
"An der Nordwand siehst Du einen grossen Altar aus Stein.");
AD("stein",
"Der Stein glaenzt und schimmert hell.");
AD("altar",
"Der Altar stellt den Haigott dar.");
AD(({"gott","hai","haigott"}),
"Der Haigott hat sein Maul weit aufgerissen. Enorm spitze Zaehne "
"blinken Dich an. Boese, dunkle Augen aengstigen Dich!");
AD(({"auge","augen"}),
"Die Augen blicken Dich an und Du zuckst zusammen! Solltest Du dem Haigott nicht irgendwie "
"irgendwas opfern, ihm huldigen...?!");

AD(({"zaehne","zahn"}),
"Die Zaehne sehen sehr gefaehrlich aus. Doch da faellt Dir eine "
"Stelle auf!");
AD("stelle",
"Hmm, an dieser Stelle scheint ein Zahn zu fehlen?! Seltsam!");
AD("maul",
"Das Maul ist weit aufgerissen, und man kann direkt hinein sehen. "
"Du erkennst eine Harpune, die mitten im Maul ruht.");

AD("harpune",
"Sie scheint Dich anzuziehen! Wie gerne haettest Du sie doch!!! Du "
"kannst versuchen sie aus dem Haimaul zu holen! Doch ganz so einfach soll das nicht sein...");



AD("loch",
"Das Loch fuehrt wieder hinaus.");
AD("sueden",
"Im Sueden kannst Du die Hoehle verlassen.");
AD(({"klippe","klippen"}),
"Du stehst eigentlich direkt in den Klippen.");
AD("hoehle",
"Die Hoehle ist nicht allzu gross und sehr feucht.");
AD("wasser",
"Wasser tropft von der Decke herab.");
AD("decke",
"Dreckiges Wasser tropft von der Decke herab.");
AD("boden",
"Das Wasser sammelt sich am Boden und macht ihn so sehr weich und feucht.");


     
//hier is ein haimaul das zubeisst, wenn man nicht vorher am altar

//dem haigott preisst, einen heiligen hai opfert

//den versteinerten hai findet man im raum oben2.c

//zusaetzlich muss man auch einen haizahn in ein loch werfen
//loch haigottstatue altar

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]));
  

  AddSound( DEFAULT_SOUND,
    "Hier ist es still.");
  AddSmell( DEFAULT_SMELL,
    "Hier ist es sehr feucht.");



ACD(({"hole", "hol"}), "get_harpune");

ACD(({"huldige", "huldig"}), "bete");

ACD(({"opfer", "opfere"}), "opfer_hai");
 SP(P_KILL_NAME, "Der unbarmherzige Haigott");
ACD(({"stecke", "steck"}), "reindamit");
AE("sueden", "./oben3");
}


int get_harpune(string str)   {
object harpune;
if(!str) return 0;

  NF("Was willst Du woraus holen?!\n");
  
  if(member(({"harpune aus maul", "harpune aus haimaul",
   "harpune aus haigottmaul","harpune aus maul heraus"}), str)!=-1)  {


if(!present("DANTE_FISCH_LISTE_ZWEI", TP))  {
	write(BS(
	"Du solltest zuerst alle Fische fangen, bevor Du hier irgendetwas erreichen kannst."));
	return 1; }
	
   
   if(deep_present("DANTE_HARPUNE", TP))  {
   write("Nein, eine Harpune reicht!\n");
   return 1; }
  
    
     if((ZAHN)&&(OPFER)&& (GEBET))  {
   write(BS(
   "Vorsichtig streckst Du Deine Hand in das Haigottmaul. Das Haimaul "
   "zuckt! Du erschrickst, doch dann Stille. Beruhigt nimmst Du die "
   "Harpune aus dem Maul! Danach schliesst sich das Maul und oeffnet sich sofort wieder!"));
   harpune=clone_object("/d/dschungel/dante/fisch/weapon/harpune");
   harpune->SetProp(P_SHORT, "Die Haiharpune von "+CAP(getuid(PL))+"");
   harpune->move(TP, M_NOCHECK);
   return 1; }
  
else {   

   write(BS(
   "Du nimmst Deinen ganzen Mut zusammen und greifst mit Deiner "
   "Hand nach der Harpune! Das Haimaul schnappt ruckartig zu!!! "
   "Die scharfen Zaehne bohren sich in Deinen Arm!!!!!AAHHHH!!!"
   "Sofort versuchst Du Deine Hand aus dem Maul zu reissen, was "
   "Dir jedoch nur nach einigen Versuchen gelingt! Irgendetwas war da wohl nicht ganz in Ordnung! "
   "Vielleicht muss man ja den Haigott irgenwie gnaedig stimmen..."));
   
   TP->do_damage(10);
  
   say(CAP_TPN+" steckt eine Hand in das Haigottmaul und bruellt dann auf!\n");
   return 1; }
 
   return 0; }
   return 0; }
   

int reindamit(string str)  {
object z;
z=present("HAIZAHN", TP);

NF("Was willst Du wo reinstecken!?\n");

if(member(({"zahn in kiefer", "haizahn in kiefer",
     "zahn in stelle", "zahn in stelle im kiefer",
     "haizahn in stelle", "haizahn in stelle im kiefer"}),str)!=-1)  {
     

    if(!z)  {
    write("Die Augen des Haigottes blitzen auf. Ein Strahl trifft Dich!\n");
    say(CAP_TPN+" wird von einem Strahl hart getroffen!\n");
    TP->do_damage(10);
   return 1; }
   
      if(ZAHN)   {
         write("Du steckst schon wieder einen Haizahn in die Stelle, wozu?!\n");
         say(CAP_TPN+" stimmt den Haigott gnaedig, schon wieder!\n");
         z->remove();
         return 1;  }
                   
     if(!ZAHN) {

write(BS("Vorsichtig steckst Du den Haizahn in die freie Stelle. Dann "
"ziehst Du Deine Hand wieder vorsichtig zurueck! Das Maul des Haigottes "
"schnappt kurz zu. Dann geht es wieder auf und der Zahn ist weg! Doch "
"Du bist Dir sicher, dass dies ein gutes Zeichen war!"));
z->remove();
         say(CAP_TPN+" spielt Zahnarzt!\n");
          zahn += ({getuid(this_player())});   
         return 1; }
      return 0;  }
    return 0; }
                
   
   



int opfer_hai(string str)  {
object hai;
hai=present("STEINHAI", TP);
NF("Was willst Du opfern?!\n");
     if(str=="hai"||str=="heiligen hai")   {
    if(!hai)  {
    write("Die Augen des Haigottes blitzen auf. Ein Strahl trifft Dich!\n");
    say(CAP_TPN+" wird von einem Strahl hart getroffen! So geht das nicht!\n");
    TP->do_damage(10);
   return 1; }
   
   if(hai)  {
         if(OPFER) {
         write("Du opferst schon wieder einen Hai! Danke sehr!\n");
         hai->remove();
         say(CAP_TPN+" opfert gerne Dinge!\n");
         return 1; }
         
         if(!OPFER)   {
         write(BS("Du wirfst den steinernen Hai in das Maul des Haigottes! "
         "Du glaubst ein zufriedenes Schnaltzen zu hoeren!?"));
         say(CAP_TPN+" stimmt den Haigott gnaedig!\n");
         hai->remove();         
          opfer += ({getuid(this_player())});   
         return 1; }
      return 0;  }
    return 0; }
   return 0; }
                
   
   
   

  int bete(string str)   {
    NF("Wem willst Du huldigen?!\n");
    if(!str) return 0;
      if(str=="haigott")   {
      if(GEBET) {
      write("Du huldigst schon wieder dem Haigott, lass das doch mal!\n");
      say(CAP_TPN+" kniet dumm herum!\n");
      return 1; }
      if(!GEBET)   {
      write(BS("Du kniest kurz nieder und huldigst dem Haigott. "
      "Die toten Augen das Haigottes leuchten gnaedig auf!"));
      say(CAP_TPN+" kniet kurz nieder.\n");
     gebet += ({getuid(this_player())});   
     return 1; }
     return 0; }
      return 0;  }


init()  {
	::init();
  if(interactive(TP))  {
  	if(present("DANTE_FISCH_LISTE", TP))  {
  		
  	  call_out("text", 3);
  	}}}
  	
  	text()  {
  	  write(BSA(
  	  "HE! Piet van Kielhol! Du solltest zuerst mal alle Fische fangen und mir bringen, bevor "
  	  "Du Dich dort oben herumtreibst! Los, komm wieder runter!",
  	  "Doby Mick teilt Dir mit: "));
              }  	  	  	