inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Osten, Westen und Norden."
  "Im Sueden wird er durch den Fluss begrenzt. "
  "Dieser Teil der Sandbank floesst Dir grosse Furcht ein..."));
AD("teil",
"Du scheinst dem Zentrum schon sehr nahe zu sein.");
AD("furcht",
"Du zitterst.");
AD("zentrum",
"Im Zentrum lauert Tantalus auf Dich!\n");
AD("tantalus",
"Scheinbar ist er nicht hier, oder doch...");

AD("osten",
"Im Osten liegt Sand und etwas weiter weg hoch in der Luft die Bruecke.");
AD("leiter",
"Die Leiter liegt schon weit im Osten.");
AD("bruecke",
"Die liegt hoch ueber Dir im Osten.");

AD("norden",
"Im Norden liegt Sand und weit dahinter begrenzen hohe Klippen die Sandbank.");
AD("westen",
"Im Westen liegt nur Sand und weiter im Westen der Fluss und der Wasserfall.");
AD("wasser",
"Das Wasser ist hier seicht und ruhig. Richtig angeln kann man hier kaum, aber da sind doch einige "
"kleine Fische im Wasser!!!");
AD(({"fische","fisch"}),
"Es handelt sich wohl um Koederfische!");
AD(({"koederfisch","koeder","koederfische"}),
"Die Koederfische tumeln sich direkt vor Dir im seichten Wasser! Probier mal einen zu fangen!!!");

AD("wasserfall",
"Der Wasserfall stuerzt weit im Westen ueber eine enorm hohe Klippe. Er rauscht "
"extrem laut.");
AD(({"klippe", "klippen"}),
"Die Klippen liegen weit im Norden. Weit im Westen "
 "stuerzt ein Wasserfall ueber eine enorm hohe Klippe.");
AD("sueden",
"Im Sueden fliesst der Fluss rauschend an Dir vorueber.");

AD("fluss",
"Der Fluss rauscht Sueden an der Sandbank vorbei.");

AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt. ");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann...");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");

AD("sandbank",
"Die Sandbank erstreckt sich hier nach Westen, Osten und Norden.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");


ASE("norden", "nix");
AE("westen", "./sand5");
AE("osten", "./sand7");

ACD(({"grab","grabe"}), "get_koeder");

DO_ANGEL



AIT("d/dschungel/dante/fisch/npc/moewe", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 15, 30, 10}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand5"]) );
   
   if(random(2)) {
   
AIT("d/dschungel/dante/fisch/npc/moewe", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 15, 30, 10}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand6"]) );
   
   }
   
   
ACD(({"fang","fange"}), "get_koederfisch");

}







  int do_angel()   {
  write (BS(
  "Hier ist kein geeigneter Platz zum Angeln! Versuch es woanders!")); 
  return 1;
  }
  
  

int get_koederfisch(string str)  {
	
	object ob;
	
	NF("Was willst Du hier fangen?!\n");
  if(str=="fisch"||str=="koederfisch")  {
  	write(BS(
  "Du greifst blitzschnell mit der Hand ins seichte Wasser."));
  say(BS(
  CAP_TPN+" versucht einen Koederfisch zu fangen."));
   
   if ( (!present("DANTE_FISCH_LISTE", TP)) ||
        (deep_present("koederfisch", TP))||
        (deep_present("DANTE_ANGEL_FISCH", TP))  )  

          {
   	write(BS(
"Du faehrst ins Leere. Die Koederfische scheinen zu schnell fuer Dich zu sein."));
   return 1; }
   
   
  else  {
  	switch(random(6))  {
  		case 0..1:
  	ob=clone_object(FO"koederfisch");
  	ob->move(TP, M_NOCHECK);
  write(BS(
  "Geschickt faengst Du einen kleinen Koederfisch."));
  break;
  case 3..4:
  write(BS(
  "Du bist zu langsam. Die Koederfische scheinen Dich auszulachen. Versuchs nochmal!"));
  break;
  case 5..6:
  write(BS(
  "Ein grosser Fisch taucht auf und beisst Dir in die Hand! AUA! "
  "Erschrocken ziehst Du Deine Hand wieder zurueck! Gib nicht auf!"));
  TP->do_damage(5);
  break;
  default: 
   write(BS(
  "Du bist zu langsam. Die Koederfische scheinen Dich auszulachen. Versuchs nochmal!"));
     }
     return 1; }
  return 0; }
return 0; }
  	
  


int nix()
  {
NF("Du bleibst im tiefen Sand stecken!\n");
return 0; }

int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
     
return 0; }
 


