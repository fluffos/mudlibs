// 99  tante dante@SilberLand

#include "/players/dante/myowndefine.h"


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define JUMPED (member(jumped, getuid(this_player()))!=-1)
 string *jumped=({});
 
#include <wizlevels.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Plattform" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun auf einer schmalen Plattform hoch ueber dem Fluss. "
  "Es gibt kein Gelaender, das Dich vor einem Sturz in die Tiefe bewahren "
  "koennte. Hin und her schwankt die Plattform und Dir wird schwindlig. "
  "Am Boden sind gegenueber von der Strickleiter einige, recht dicke Seile angebracht."));
  
  AD(({"leiter","strickleiter"}),
  "Sie fuehrt wieder nach unten an den Strand!");
  AD("strand",
  "Der Strand liegt unter Dir.");
 AD("himmel",
 "Blau und wolkenlos.");
 AD("boden",
 "Der Boden ist aus Holz und sozusagen die Plattform.");
 AD("holz",
 "Es sieht noch recht stabil aus.");
 AD(({"seil","seile"}),
 "Die Seile sind recht dick, sehen auch stabil aus. Sie sind fest an der "
 "Plattform mit grossen Naegeln befestigt und haengen frei nach unten. Sie baumeln eigentlich "
 "direkt ueber dem Fluss.");
 AD("beine",
 "Haxen");
 AD("haxen",
 "Wadl");
 AD("wadl",
 "Gib Ruhe!");
 AD("decke",
 "Siehe Himmel.");
 AD(({"nagel","naegel"}),
 "Sie sind sicher so dick wie Du, nein so dick nicht, aber sie sind dick genug.");
AddDetail("plattform",
"Sie ist eher ein langes Brett, das hoch ueber dem Fluss hin und her "
"schwankt.");
AD("brett",
"Allzu dick ist es nicht, aber Dich scheint es zu tragen...noch...");
AD("fluss",
"Gruen und blau schimmert er unter Dir. Das Wasser ist klar und irgenwie "
"hast Du Lust runterzuspringen.");
AD("wasser",
"Das Wasser sieht herrlich sauber aus.");
AD("lust",
"Gib ihr nach!");
AD("gelaender",
"Hier kannst Du Dich nirgends anhalten...");
AD("tiefe",
"Du blickst nach unten, taumelst und faellst fast runter.");
AD("sturz",
"Macht sicher Spass...");
AD("spass",
"Goenne ihn Dir!");
AddDetail("zubau", 
"Die Plattform ist sehr schmal und hat kein Gelaender.");

    AddDetail(("westen"),
    "Der Wasserfall liegt weiter flussaufwaerts im Westen.");
    AddDetail(("wasserfall"),
    "Gewaltig wie der Wasserfall in die Tiefe stuerzt.");                                                                        
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(({"bruecke","haengebruecke"}),
"Die Bruecke liegt etwas weiter im Osten. Sie ist durch einen "
"grossen Spalt von dieser Plattform getrennt.");
AD("spalt",
"Zu gross fuer Dich.");
AD(({"pfahl","pfaehle"}),
"Die Plattform steht auf insgesamt 6 dicken Pfaehlen aus Holz.");

  AddDetail(("dschungel"),
  "Der Dschungel liegt zu beiden Seiten der Schlucht.");

  AddDetail(("farbe"),
  "Die Farbe des Wassers ist gruen-blau.");
  AddDetail(("wind"),
  "Der Wind laesst die Bruecke hin und herschwanken...");
  AddDetail(({"ohr","ohren"}),
  "Du hoerst den Fluss rauschen und den Wind pfeiffen...");
  AddDetail(("sonne"),
  "Die Sonne strahlt hell herab und veraendert die Farbe des Wassers.");
  AddDetail(("blick"),
  "Viele, viele Meter gehst es in die Tiefe...");
AddDetail(("schlucht"),
"Die Schlucht liegt unter Dir und beeindruckt Dich mit ihren gewaltigen Ausmassen.");
AddDetail(({"ausmasse","ausmassen"}),
"Die Schlucht schaut von hier oben wirklich gigantisch aus.");
  AddSound( DEFAULT_SOUND,
    "In der Tiefe rauscht das Wasser.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
AddSmell("luft",
"Hmm, wie ein Tag am Meer.");
AD("osten",
"Da liegt die eigentliche Bruecke.");
AD("meer",
"Das ist weit weg.");


ACD(({"spring","springe"}), "down_allow");
ACD(({"kletter","klettere","steige","steig"}), "now_down");

AIT("d/dschungel/dante/fisch/npc/krabbe", REFRESH_DESTRUCT);
if(random(2))  {
AIT("d/dschungel/dante/fisch/npc/krabbe", REFRESH_DESTRUCT);  }

if(random(4))  {
	AIT("d/dschungel/dante/fisch/npc/krabbe", REFRESH_DESTRUCT);
}


}
  
  int now_down(string str)
     {
     NF("Wo willst Du runter klettern/steigen? Seil oder Strickleiter?!\n"
     "syntax: <kletter an seil runter/kletter an leiter runter>\n");
     
    if(str=="an strickleiter runter"||str=="an leiter runter" )  {
write("Du kletterst wieder an den Strand zurueck nach unten.\n");
    	TPM("/d/dschungel/dante/fisch/room/sand7",M_GO,
    	"an der Strickleiter nach unten","klettert",
    	"kommt von oben herabgeklettert");
    	return 1; }
    	 
     
if(member(({"am seil runter","an seil runter"}),str)!=-1)
     {
     
     if(!present("DANTE_FISCH_LISTE_DREI", TP))  {
 write(BS(
 "Irgendeine Kraft haelt Dich auf, Du solltest wohl zuerst einmal die anderen "
 "Aufgaben von Doby Mick erfuellen."));
 return 1; }



if(present("krabbe", environment(TP)))  {
  say(BS(
  CAP_TPN+" wird von der Krabbe weggestossen!"));
  write(BS(
  "Die Krabbe laesst Dich nicht vorbei!"));
  return 1; }
  




      
     if(!JUMPED)
        {
        write("Du bist zu feige, um nach unten zu klettern!\n");
        say(CAP_TPN+" ist zu feige, um nach unten zu klettern.\n");
        return 1;
        }
     else
        {
        write("Du nimmst allen Mut zusammen, und kletterst nach unten!\n");
        TP->move("/d/dschungel/dante/fisch/room/jump2", M_GO,
        "am Seil nach unten", "klettert", "kommt von oben herabgeklettert");
        return 1;
        }
    return 0;
    }
 return 0;
 }
                 
     
     
     
  int down_allow(string str)
    {
    NF("Wohin oder wohinunter willst Du springen?\n");
  if(member(({"runter", "in fluss","nach unten","hinab"}),str)!=-1)
    {
    
     
     if(!present("DANTE_FISCH_LISTE_DREI", TP))  {
     write(BS("Nein, so kannst Du hier nichts erreichen. Erledig zuerst "
     "einmal die anderen Aufgaben von Doby Mick!"));
     return 1; }
     
    
    
    if(JUMPED)
      {
      write("Du hast doch Deinen Mut schon bewiesen, lass es...\n");
      return 1;
      }
      else
      {
    write("Du willst in den Fluss springen, doch Deine Vernunft ist "
    "staerker. Trotzdem irgendwie scheint Dein Mut gestiegen zu sein.\n");
    say(CAP_TPN+" ist mutig genug sich in die Tiefe zu stuerzen, wird "
    "aber durch Vernunft doch noch zurueckgehalten!\n");
  jumped += ({getuid(this_player())});   
        return 1;
         }
    return 0;
    } 
  return 0;
  }
     