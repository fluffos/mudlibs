//dante sl 98 -99-2000 unterirdischer raum fuer fischerquest

#include "/players/dante/myowndefine.h"
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h> 
#include <wizlevels.h>
#include "/d/dschungel/dante/fisch/fisch.h"

#define RAUS (member(raus, getuid(this_player()))!=-1)
 string *raus=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Unterwasserhoehle" );
  SetProp( P_INT_LONG, BS(
  "Laut rauscht das Wasser ueber Deinem Kopf hinweg. Aus irgendwelchen "
  "Gruenden, ist diese Unterwasserhoehle recht trocken geblieben und "
  "nicht ueberflutet. Zu Deinem Glueck. Die Waende bestehen aus feuchtem "
  "Stein, Moos wuchert ueberall und ab und zu tropft es von der "
  "Decke herab!"));
AD("boden",
"Der Boden ist feucht und ab und zu von Lachen bedeckt.");
  AD("stein",
  "Der Stein ist feucht und rutschig. Ab und zu weist die glatte Flaeche "
  "Erhebungen auf.");
  ASD("flaeche","get");
  
  AD(({"erhebungen","erhebung"}),
  "Recht unspektakulaer, diese Erhebungen, wenn da nicht ein Loch dazwischen "
  "waere...");
  AD("loch",
  "Das Loch scheint direkt nach unten zu fuehren. Ein seltsamer Glanz umgibt es. "
  "Das Loch ist sicher zu klein, um hineinzukriechen, aber vielleicht kann man ja etwas hineinschleudern...");
  AD("glanz",
  "Hmm, der Glanz sieht irgendwie dem einer Kerze aehnlich...");
  AD("kerze",
  "Hmm, ob man eine Kerze hier gebrauchen koennte!?");
  
  
 AD("wasser",
  "Laut und enorm schnell fliesst es ueber Dir hinweg. Es haette Dir fast "
  "den Tod gebracht.");
  AD("tod", 
  "Der lauert hier auch...");
  AD("kopf",
  "Der ist noch dran, was gut so ist...");
 AD(({"gruende","grund"}),
 "Das Wasser scheint so schnell zu fliessen, dass nur ein sehr kleiner "
 "Teil hier runter fliessen kann.");
 AD("teil",
 "Sehr wenig.");
 AD("glueck",
 "Zu Deinem Glueck, siehst Du an einer der Waende eine Zeichnung.");
 AD("zeichnung",
 "Sie stellt eine Krake dar.");
 AD("krake",
 "Die Krake hat gigantische Augen, so gross, dass man sie vielleicht sogar "
 "betreten koennte. Aber das geht natuerlich nicht, wie auch...");
 AD(({"auge","augen"}),
 "Die Augen sind sicher so gross wie Du.");
 AD(({"hoehle","unterwasserhoehle"}),
 "Die Hoehle scheint nicht allzu geraeumig zu sein. Jedenfalls kannst Du "
 "nicht viel erkennen. Die Waende sind feucht und Moos waechst ueberall. ");
 AD("moos",
 "Das Moos ist saftig und gruen, irgendwie wirkt es aber gefaehrlich. "
 "Koennte sein, dass sich im Moos etwas verbirgt...");
 AD(({"wand","waende"}),
  "Wasser rinnt die Waende entlang und sammelt sich am Boden zu kleinen "
  "Lachen.");
  AD(({"lache","lachen"}),
  "Die Lachen spiegeln die Decke wieder und manchmal glaubst Du ein "
  "Bild in ihnen zu erkennen...");
  AD("bild",
  "Seltsam verschwommen, glaubst Du ein grosses Tier zu sehen...");
  AD("tier",
   "Genaues kann man nicht erkennen, aber es scheint viele, viele Arme "
   "zu haben...");
   AD(({"arm","arme"}),
   "Hmm, zu verschwommen, oder sind das etwas Tentakel?");
   AD("tentakel",
   "Kann sein, muss aber nicht.");
   AD("decke",
   "Von der Decke tropft Wasser. Ein schmaler Spalt fuehrt direkt nach oben.");
   AD("spalt",
   "Durch den Spalt bist Du hereingeschleudert worden. Ueber ihn rast das Wasser "
   "des Fluss hinweg.");
   AD("fluss", 
   "Der Fluss rast ueber Dir dahin.");
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    "Ueber Dir rauscht das Wasser.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es modrig und feucht.");
    
    
ACD(({"betritt","betrete"}),"go_out");
ACD(({"wuehle","wuehl","durchsuche","durchsuch"}), "come_in");
ACD(({"schleuder","schleudere"}), "try_come");


}

 string get()
   {
   if(deep_present("kerze", TP))
     {
     write(BS("Die Flaeche zeigt jemanden, der in der einen Hand eine "
     "brennende, schwarze Kerze haelt und mit der anderen Hand einen "
     "merkwuerdigen Knochen in ein Loch wirft!"));
     }
     else
     {
     write(BS("Die Flaeche zeigt einen seltsamen Vogel, eine Harpye, die "
     "eine schwarze Kerze besitzt. Wo dieser Vogel wohl lebt?!"));
     }
     return "";
   }



 int try_come(string str)
   {
   object ob1, ob2, ob3;

   ob1=present("DANTE_MOOSBONE", TP);
   ob2=present("kerze_burn", TP);

   NF("Was willst Du wo hinein schleudern?\n");
   if(str=="knochen in loch")
       {
       if(!ob1)
            {
            write("Du hast nichts, das hier passen wuerde.\n");
            return 1;
            }
       if((ob1)&&(!ob2) )
            {
  write(BS("Du wirfst den Knochen des Moosmonsters in das Loch. "
 "Du hoerst ein lautes Bruellen aus der Tiefe und ploetzlich fliegt der Knochen wieder herauf in Deine Haende!"));
         return 1;
         }
            
  if(present("vkerze", TP))   {
  	write(BS(
  	"Du hast zwar eine Kerze, aber irgendwas fehlt da noch."));
  	return 1; }
  	          
            
     if((ob1)&&(ob2))
       {
          if(!deep_present("FISCH_KRAKENAUGE", TP))
             {
write(BS(
"Du wirfst den Knochen des Mossmonster in das Loch. Die Kerze erlischt und "
"zerfliesst in Deinen Haenden. Dann hoerst Du ein lautes Glucksen aus der "
"Tiefe, eine Art Ruelpsen, und ploetzlich saust irgendetwas von unten herauf "
"und fliegt genau in Deine Haende! Nun aber weg hier!"));

 ob3=clone_object("d/dschungel/dante/fisch/obj/krakenauge");
 ob3->move(TP, M_NOCHECK);
       ob1->remove();
       ob2->remove();
       return 1;
           }
           
          if(deep_present("DANTE_KRAKENAUGE", TP))
           {
           write("Du wirfst den Knochen des Moosmonsters in das Loch!\n"
           "Die Kerze blitzt auf und verschwindet dann.\n"
           "Du hast doch schon ein Krakenauge!!!\n");
           ob1->remove();
           ob2->remove();;
           return 1;
           }
        return 0;
        }      
      return 0;
      }
   return 0;
   }
              





int go_out(string str)
   {
   NF("Was willst Du hier betreten?!\n");
   if(str=="auge"||str=="augen")
      {

if(!RAUS)  {

write(BSA(
"HEIJA! PIET! Durch dieses magische Auge kommst Du direkt wieder zu mir! "
"Wenn Du wirklich schn zu mir moechtest, betritt es noch einmal!",
"Doby Mick teilt Dir mit: "));
   raus += ({getuid(this_player())});   
return 1;
    }
    
if(RAUS)  {


  write("Du versuchst das Auge des Kraken zu betreten, was aber nicht geht.\n"
   "Doch ploetzlich beginnt alles um Dich herum zu surren und zu verschwimmen.\n");
     TP->move("d/dschungel/dante/fisch/room/fischer", M_GO+M_SILENT+M_NO_SHOW);
       return 1;
         raus-= ({getuid(this_player())});   
       }
      return 0; }
       
  return 0;
  }
  
       
   
 int come_in(string str)
   {
   object ob;
   NF("Was willst Du hier durchwuehlen/durchsuchen?\n");
   if(str=="moos"||str=="in moos"||str=="im moos")
    {  
    
    if(present("MOOS", environment(TP)))
      {
      TP->do_damage(3);
      write("Das Moosmonster tritt Dich weg!\n");
      say(CAP_TPN+" wird vom Moosmonster getreten!\n");
      return 1;
      }
else

       {
       write("Du durchsuchst das Moos und ploetzlich...\n");
       ob=clone_object("d/dschungel/dante/fisch/npc/moosm");
       ob->move(environment(TP), M_TPORT);
       return 1;
       }
   return 0;
   }
  return 0;
  }
