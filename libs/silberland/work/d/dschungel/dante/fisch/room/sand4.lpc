//dante

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>

int fische=0;
#define MAX 30
#define TI 0 //2+random(4)

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Sueden, Osten und Norden. "
  "Im Westen wird er durch den Fluss begrenzt. Ob es klug war, sich " 
  "bis hier her zu wagen ?"));



AD("osten",
"Im Osten liegt Sand und hoch in der Luft die Bruecke.");
AD("leiter",
"Die Leiter liegt schon weit im Osten.");
AD("bruecke",
"Die liegt hoch ueber Dir im Osten.");

AD("norden",
"Im Norden liegt Sand und dahinter begrenzen hohe Klippen die Sandbank.");
AD("westen",
"Im Westen liegt der Fluss und noch weiter im Westen den Wasserfall.");


AD("wasser",
"Das Wasser ist hier auffaelig trueb und schlamig. Hmm, welche Fische hier wohl leben?!");




AD("wasserfall",
"Der Wasserfall stuerzt im Westen ueber eine enorm hohe Klippe. Er rauscht "
"extrem laut.");
AD(({"klippe", "klippen"}),
"Die Klippen liegen etwas weiter im Norden. Im Westen liegt der Fluss und "
 "ein Wasserfall stuerzt ueber eine enorm hohe Klippe.");
AD("sueden",
"Im Sueden liegt Sand. Dahinter fliesst der Fluss.");

AD("fluss",
"Der Fluss rauscht im Westen an der Sandbank vorbei.");

AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt. ");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann. Veruschs doch mit graben..");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");

AD("sandbank",
"Die Sandbank erstreckt sich hier nach Sueden ,Osten und Norden.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");


AE("sueden", "./sand5");
AE("norden", "./sand3");

ASE("osten", "nix");

DO_ANGEL
SHOW_FISCH



AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   
   


AIT("d/dschungel/feyaria/kueste/npc/wurm", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   
   
   
   
ACD(({"grab","grabe"}), "get_koeder");
}


int nix()
  {
NF("Du bleibst im tiefen Sand stecken!\n");
return 0; }
int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
return 0; }
 



int do_angel()   {
	object oba, obb;
	obb=present("DANTE_ANGEL_SCHNECKE", TP);
	oba=present("DANTE_ANGEL", TP);
	
if(present("fishingaction", TP))   {
	write("Aber Du angelst doch schon!!!\n");
	return 1; }
		
	
     if(!oba)  {
     	write("Du hast keine geeignete Angel!\n");
     	return 1; }

    if((oba) &&(!obb))  {
   	write(BS("Du wirfst Deine Angel gekonnt aus und wartest."));
   	call_out("fail", TI);
   	  oba->AddId("fishingaction");
   	say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
   	return 1; }

        if(obb)  {	   
     	write("Du wirfst Deine Angel gekonnt aus und wartest.\n");
        say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
        call_out("ok", TI);
        obb->AddId("fishingaction");
           return 1; }
        return 0; }
 
 
 //das hier muss sein damit die spieler nicht 100000000
 //fische erzeugen koennen
 reset()  {
 	::reset();
  fische=MAX;   }
  	
 
 
        
    fail()   {object ob;
    	ob=present("DANTE_ANGEL", TP);
    	if(ob)  {  
    	ob->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    else  {
    write(BS(
  "Du holst die Angel wieder ein, irgendetwas scheint nicht zu stimmen. "
  "Der Koeder, der Ort..."));
    return ; }
}

 
        
        
    ok()   {object obb, ob;
    	obb=present("DANTE_ANGEL_SCHNECKE", TP);
    	if(obb)  {  
    	obb->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    		
    	if(fische>= MAX)  {
    		write(BS(
    "Du ziehst die Angel aus dem Wasser, das Gewaesser scheint "
    "leer gefischt zu sein. Warte ein wenig bitte!"));
    return ; }
    			
    		
    else  {
    write(BS(
"Irgendetwas zieht an Deiner Angel! Du reisst sie aus dem Wasser!"));

    switch(random(10))  {


      case 0: 
      write("Leider ist der Haken leer!\n"); return ;
      break;
    case 1..7:
    ob=clone_object("/d/dschungel/dante/fisch/obj/stdaal");
    break;
    case 8:
     ob=clone_object("/d/dschungel/dante/fisch/obj/neun");
     break;
     case 9:
     write(BS(
     "Ein Aal haengt an Deinem Haken, kann sich aber gerade noch befreien und verschwindet im Schlamm!"));
     return;
     break;
      default:   ob=clone_object("/d/dschungel/dante/fisch/obj/stdaal");
}

fische++;
  write(BS("Ein Fisch zappelt am Haken! "
  ""+ob->short()+"Du nimmst den Fisch"
  " sofort vom Haken und steckst ihn ein!!!"));
  write("Dein Koeder scheint noch gut zu sein!!!\n");
  
  ob->move(TP, M_GET);
}

    }


    
 string show_fisch()   {
    switch(random(7))   {
    case 0:
    write("Du glaubst fuer den Bruchteil einer Sekunde einen Aal zu sehen!\n");
    break;
    case 1:
    write("Ein dicker Aal verschwindet gerade im Schlamm!\n");
    break;
    case 3:
    write("Im Moment siehst Du leider keinen Fisch!\n");
    break;
    case 4:
    write("Du glaubst einen sehr langen, duennen Fisch zu sehen!\n");
    break;
    case 5:
    write("Der Schlamm ist momentan zu stark!\n");
    break;
    case 6:
    write("Du glaubst einen kurzen Aal zu sehen!\n");
    break;
    default: write("Du siehst einen lanen Aal!!!\n");}
     return"";}
    
 