 inherit "/d/dschungel/dante/fisch/room/gang_inh";
 

create()
{
make_room();

switch(random(5))   {
	case 0:

AIT("/d/dschungel/dante/fisch/kannibalen/npc/kind", REFRESH_DESTRUCT);
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kfrau", REFRESH_DESTRUCT);
break;

case 1:
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kman", REFRESH_DESTRUCT);
break;
case 2:
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kind", REFRESH_DESTRUCT);
break;
case 3:
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kman", REFRESH_DESTRUCT);
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kind", REFRESH_DESTRUCT);
break;
case 4:
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kfrau", REFRESH_DESTRUCT);
break;
default:
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kman", REFRESH_DESTRUCT);
  }

AGE("nordwesten", "/d/dschungel/dante/fisch/room/gang3",
"kannibale", "Der Kannibale bruellt: Tznwnpi Bfwen Nixinixi!!!\n");

AE("nordwesten", "./gang3");
AE("suedosten", "./gang1");

}