//DANTE!!!
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

int heilen=3;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hoch ueber den Klippen" );
  SetProp( P_INT_LONG, BS(
"Ein kleines Felsplateau streckt sich nun vor Dir aus. Allzu gross "
"ist es nicht, aber zumindest viel groesser als der Vorsprung, der unter "
"Dir liegt. Die Klippen fallen nicht allzu steil von hier ab, dafuer "
"steigen sie aber umso steiler nach oben an. Hier kommt man sicher "
"nicht mehr weiter rauf. Zwischen einigen versprengten Felskloetzen "
"scheint ein dunkles Loch gen Norden direkt in die Klippen zu fuehren."));



AD("vorsprung",
"Der Vorsprung liegt tief unter Dir.");
AD(({"klippe","klippen"}),
"Du stehst hier schon fast ganz oben auf den Klippen. Weiter gehts es allerdings nicht. "
"Nach unten kannst Du klettern, doch nach oben wird es zu steil.");
AD(({"kloetze","felskloetze","klotz","kloetze","felsklotz"}),
"Die Felskloetze liegen wild verstreut umher. Ein dunkles Loch fuehrt "
"direkt in eine Hoehle.");
AD("loch",
"Das Loch klafft in den Klippen und scheint hinein zu fuehren.");
AD("hoehle",
"Du musst wohl oder uebel hineingehen.");
AD("norden",
"Irgendwie wirkt die Hoehle unheimlich. Geh lieber wieder nach Midas...");
ASD("midas", "out");

AD("fels",
"Hier wirkt der Fels wild und zerklueftet. Du entdeckst eine kleine Mulde!");
AD("mulde",
"Hmm, in der Mulde steckt ein grosser Haiknochen!");
AD(({"knochen","haiknochen"}),
"Der Haiknochen steckt im Boden der Mulde! Du willst ihn haben! Reiss ihn aus!");

AD("decke",
"Gibt es nicht.");
AD("himmel",
"Strahlendblau.");
AD("boden",
"Der Boden besteht aus Fels und ist uebersaeht mit Felskloetzen.");
AD(({"wand","waende"}),
"Die Waende bestehen hier aus Fels.");


AD(({"plateau","felsplateau"}),
"Das Plateau liegt hoch ueber dem Strand. Der Wind pfeifft laut und "
"der Fluss sieht schon recht klein aus.");
AD("strand",
"Der Strand liegt tief unter Dir.");
AD("wind",
"Er pfeifft, doch das hoert man nur.");
AD("fluss",
"Der Fluss liegt sehr ief unten. Er erscheint von hier oben nicht mehr "
"so gewaltig gross.");
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({ "wasserfall" }), 
    "Der Wasserfall rast im Westen herab." );
  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Frisch und kuehl.");


ACD(({"reiss", "reisse"}), "heal");

ACD(({"kletter", "klettere"}), "up");

AddGuardedExit("norden", "/d/dschungel/dante/fisch/room/oben4",
"krabbe", "Die Krabbe hackt Dir ins Bein!\n");

AIT("d/dschungel/dante/fisch/npc/krabbe", REFRESH_DESTRUCT);
AIT("d/dschungel/dante/fisch/npc/krabbe", REFRESH_DESTRUCT);
if(random(3))  {
AIT("d/dschungel/dante/fisch/npc/krabbe", REFRESH_DESTRUCT);  }

if(random(3))  {
AIT("d/dschungel/dante/fisch/npc/krabbe", REFRESH_DESTRUCT);
}

}

string out()  {
write("Du bist feig und lahm!\n");
	shout(BS(
CAP(getuid(PL))+" ruft: Ich bin ein Hosenscheisser und will nach Midas!"));
 return "";	
}

int up(string str)  {
   NF("Wo willst Du hin klettern?\n");
   if(!str) return 0;
   
if(str=="klippe runter"||str=="klippen nach unten" ||str=="nach unten"||
str=="klippen runter"||str=="runter")   {

   write("Du kletterst die Klippe runter.\n");
   TPM("/d/dschungel/dante/fisch/room/oben2", M_GO, 
   "die Klippe runter", "klettert", "kommt heruntergeklettert");
   return 1; }
   return 0; }




int heal(string str)  {
   NF("Was willst Du ausreissen?\n");
if(str=="knochen aus"||str=="haiknochen aus"||
"knochen aus mulde"||str=="haiknochen aus boden"||str=="knochen aus boden")   {
       if(!heilen)  {
       write("Du versuchst den Haiknochen auszureissen, scheiterst aber.\n");
       say(CAP_TPN+" reisst an einem Stein herum!\n");
       return 1;  }
       if(heilen)  {
       write(BS(
   "Du versuchst den Haiknochen auszureissen, er blinkt hell auf und "
   "ploetzlich fuehlst Du die Staerke eines Haies in Dir! Du wurdest etwas geheilt!"));
   say(CAP_TPN+" grinst wie ein Hai!\n");
   TP->heal_self(25+random(50));
   heilen--;
   return 1; }
   return 0; }
   return 0; }
   
   
reset() {
::reset();
heilen=3+random(3);  }



       
