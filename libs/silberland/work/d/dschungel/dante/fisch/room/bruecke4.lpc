//dante

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>


int fische=0;
#define MAX 30
#define TI 0  //2+random(4)

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Westen. Im Norden "
  "wird er durch hohe Klippen begrenzt und im Osten endet sie am Fluss. "
  "Im Sueden rauscht der Fluss vorbei. "
  "Hoch ueber Dir liegt die Bruecke, zu der Du mit einer Leiter wieder "
  "hochklettern kannst. Im Norden scheint eine Hoehle in die Klippen zu fuehren."));   



AD("osten",
"Im Osten macht der Fluss eine kleine Biegung und begrenzt so den Sand.");
AD("leiter",
"Eine schmale Leiter fuehrt nach oben zur Bruecke.");
AD("bruecke",
"Die liegt hoch ueber Dir.");

AD("norden",
"Im Norden begrenzen hohe Klippen die Sandbank. Eine dunkle Hoehle scheint "
"ins Innere der Klippen zu fuehren...");
AD("hoehle",
"Die Hoehle wirkt sehr bedrohlich und unheimlich...");
AD(({"inneres","innen"}),
"Die Hoehle ist weder unheimlich noch bedrohlich. Ein alter, weiser Fischer "
"soll in ihr leben.");
AD("fischer",
"Er wohnt schon seit ewig in dieser Hoehle. Besuche ihn!");
AD("westen",
"Im Westen sieht man nur Sand und noch weiter im Westen den Wasserfall.");
AD("wasser",
"Das wasser ist hier ruhig und flach. HE! Da war doch ein Fisch!");


AD("wasserfall",
"Der Wasserfall stuerzt im Westen ueber eine enorm hohe Klippe. Er rauscht "
"so laut, dass man sein eigens Wort nicht mehr verstehen kann.");
AD("wort",
"Wie bitte?!?!??!Ich verstehe nichts?");
AD(({"klippe", "klippen"}),
"Die Klippen liegen direkt neben Dir im Norden. Im Westen stuerzt ein "
"Wasserfall ueber eine enorm hohe Klippe.");
AD("sueden",
"Im Sueden liegt fliesst der Fluss.");

AD("fluss",
"Der Fluss rauscht an der Sandbank vorbei.");

AD(({"urlaub","urlaubsgefuehle"}),
"Hier sicher nicht!");
AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt, "
"erzeugt Urlaubsgefuehle bei Dir. Aber dafuer bist Du nicht hier...");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann...");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");
AD("sandbank",
"Die Sandbank erstreckt sich hier nach Westen.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Es rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Hmm, es riecht nach Fischen!");
    AddSmell(({"fisch","fische"}),
    "Viele, viele Fische...");
    


AE("norden", "/d/dschungel/dante/fisch/room/fischer");
AE("westen", "/d/dschungel/dante/fisch/room/sand1");

ACD(({"kletter", "klettere"}),"up");



DO_ANGEL
SHOW_FISCH



AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2",
     P_AGGRESSIVE: 1
     ]) );
  


AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
    
   
   
   
ACD(({"grab","grabe"}), "get_koeder");
}

int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
return 0; }
  	
  
  



int do_angel()   {
	object oba, obb;
	obb=present("DANTE_ANGEL_MEHLWURM", TP);
	oba=present("DANTE_ANGEL", TP);
	
if(present("fishingaction", TP))   {
	write("Aber Du angelst doch schon!!!\n");
	return 1; }
		
	
     if(!oba)  {
     	write("Du hast keine geeignete Angel!\n");
     	return 1; }

    if((oba) &&(!obb))  {
   	write(BS("Du wirfst Deine Angel gekonnt aus und wartest."));
   	call_out("fail", TI);
   	  oba->AddId("fishingaction");
   	say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
   	return 1; }

        if(obb)  {	   
     	write("Du wirfst Deine Angel gekonnt aus und wartest.\n");
        say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
        call_out("ok", TI);
        obb->AddId("fishingaction");
           return 1; }
        return 0; }
 
 
 //das hier muss sein damit die spieler nicht 100000000
 //fische erzeugen koennen
 reset()  {
 	::reset();
  fische=MAX;   }
  	
 
 
        
    fail()   {object ob;
    	ob=present("DANTE_ANGEL", TP);
    	if(ob)  {  
    	ob->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    else  {
    write(BS(
  "Du holst die Angel wieder ein, irgendetwas scheint nicht zu stimmen. "
  "Der Koeder, der Ort..."));
    return ; }
}

 
        
        
    ok()   {object obb, ob;
    	obb=present("DANTE_ANGEL_MEHLWURM", TP);
    	if(obb)  {  
    	obb->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    		
    	if(fische>= MAX)  {
    		write(BS(
    "Du ziehst die Angel aus dem Wasser, das Gewaesser scheint "
    "leer gefischt zu sein. Warte ein wenig bitte!"));
    return ; }
    			
    		
    else  {
    write(BS(
"Irgendetwas zieht an Deiner Angel! Du reisst sie aus dem Wasser!"));
    
    switch(random(18))  {



      case 0: 
      write("Leider ist der Haken leer!\n"); return ;
      break;
    case 1..6:
    ob=clone_object("/d/dschungel/dante/fisch/obj/stdkarp");
    break;
    case 7:
     ob=clone_object("/d/dschungel/dante/fisch/obj/stich");
     break;
     case 8:
      ob=clone_object("/d/dschungel/dante/fisch/obj/bsaib");
      break;
     case 9: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/ssaib");
     break;
       case 10: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/sfisch");
     break;
       case 11: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/gfisch");
     break;
       case 12: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/gorfe");
     break;
       case 13: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/sorfe");
     break;
      case 14: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/piranha");
     break;     
        case 15: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/seehase");
     break;     
        case 16: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/hering");
     break;     
        case 17: 
write(BS(
"Ein kleiner Fisch kann sich gerade noch von Deinem Haken befreien!"));return;
    break;          
      default:   ob=clone_object("/d/dschungel/dante/fisch/obj/stdkarp");
}

fische++;
  write(BS("Ein Fisch zappelt am Haken! "
  ""+ob->short()+"Du nimmst den Fisch"
  " sofort vom Haken und steckst ihn ein!!!"));
  write("Dein Koeder scheint noch gut zu sein!!!\n");
  
//der koeder bleibt absichtlich gut wuerde die spieler nur nerven
//dauernd koeder raufstecken und sammeln zu muessen!!!!
  ob->move(TP, M_GET);
}

    }



//GROSSE fische hier rein!!!!!!!!!!!!!!!!!!

    
 string show_fisch()   {
    switch(random(7))   {
    case 0:
    write("Du glaubst fuer den Bruchteil einer Sekunde einen Goldfisch zu sehen!\n");
    break;
    case 1:
    write("Ein kleiner Fisch springt gerade wild durch das Wasser!\n");
    break;
    case 3:
    write("Im Moment siehst Du leider keinen Fisch!\n");
    break;
    case 4:
    write("Du glaubst einen sehr kleinen Fisch zu sehen!\n");
    break;
    case 5:
    write("Momentan siehst Du leidr nichts!\n");
    break;
    case 6:
    write("Du glaubst einen kleinen Fisch zu sehen!\n");
    break;
    default: write("Du siehst einen kleinen Fisch!!!\n");}
     return"";}
    
 

   
 int up(string str)
   {
   NF("Wo oder womit willst Du nach oben klettern!?\n");
   if(member(({"nach oben","rauf","hinauf","mit leiter rauf",
   "mit leiter nach oben", "mit leiter hinauf"}),str)!=-1)
        {
        write("Du kletterst die Leiter nach oben und bist froh noch zu leben\n");
        TP->move("d/dschungel/dante/weg/room/bruecke2", M_GO,
        "an der Leiter nach oben", "klettert", "kommt von unten herauf geklettert");
        return 1;
        }
      return 0;
      }
        
