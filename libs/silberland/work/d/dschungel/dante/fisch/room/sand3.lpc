//dante
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Sueden und Osten. "
  "Im Westen wird er durch den Fluss und Im Norden " 
  "durch hohe Klippen begrenzt. Die Bruecke mit der "
  "rettenden Leiter liegt etwas weiter im Osten."));


AD("osten",
"Im Osten liegt Sand und hoch in der Luft die Bruecke.");
AD("leiter",
"Die Leiter liegt schon etwas weiter im Osten.");
AD("bruecke",
"Die liegt hoch ueber Dir im Osten.");

AD("norden",
"Im Norden begrenzen hohe Klippen die Sandbank. Du erkennst "
"eine gigantische Zeichnung. Darunter sieht man eine Schrift und ein "
"grosses schwarzes Loch!");
AD("loch",
"Das Loch fuehrt in die Klippen hinein. Es ist tiefschwarz! Eine unheimliche "
"Macht geht von ihm aus! Du kannst sicher in das Loch klettern!");
AD("schrift",
"Irgendjemand hat sie hier eingemeiselt. Lies sie! ");


AddReadDetail("schrift",
"\nAlle heiligen Zeiten beschwoeren wir in diesem Loch die\n"
"gigantische Krake TANTALUS, um ihr grausige, blutruenstige\n"
"Opfer zu bringen. Dunkles Feuer nur kann sie rufen!\n");

AD("macht",
"Kannst Du sie schon ueberwinden?!\n");
AD("zeichung",
"Die Zeichnung stellt eine gigantische Krake dar.");
AD("krake",
"Sie ist fast so hoch wie die Klippen und hat enorm viele Tentakel.");
AD("tentakel",
"Tja, keiner da, sie froh!");
AD("westen",
"Im Westen liegt der Fluss und noch weiter im Westen den Wasserfall.");
AD("wasser",
"Das Wasser sieht hier sehr uninteressant aus. Keine Fische, einfach nichts! "
"Doch Du kannst von hier aus ins Wasser waten...");

AD(({"fisch", "fische"}),
"Hier kann man nicht fischen, es waere sinnlos.");
AD("wasserfall",
"Der Wasserfall stuerzt im Westen ueber eine enorm hohe Klippe. Er rauscht "
"extrem laut.");
AD(({"klippe", "klippen"}),
"Die Klippen liegen direkt neben Dir im Norden. Im Westen stuerzt ein "
"Wasserfall ueber eine enorm hohe Klippe.");
AD("sueden",
"Im Sueden liegt Sand. Dahinter fliesst der Fluss.");

AD("fluss",
"Der Fluss rauscht im Westen und Sueden an der Sandbank vorbei.");

AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt. ");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann. Aber graben kann man im Sand!");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");

AD("sandbank",
"Die Sandbank erstreckt sich hier nach Sueden und Osten.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");


AE("sueden", "./sand4");
AE("osten", "./sand2");

ASE("suedosten", "nix");
ACD(({"kletter", "klettere"}), "hoehle");
ACD(({"wate"}),"go_water");
DO_ANGEL






AIT("d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 15, 30, 10}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand3"]) );
   
ACD(({"grab","grabe"}), "get_koeder");
}




  int do_angel()   {
  write (BS(
  "Hier ist kein geeigneter Platz zum Angeln! Versuch es woanders!")); 
  return 1;
  }

int nix()
  {
NF("Du bleibst im tiefen Sand stecken!\n");
return 0; }

int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   if ( (!present("DANTE_FISCH_LISTE", TP)) ||
        (deep_present("krebs", TP))||
        (deep_present("DANTE_ANGEL_KREBS", TP))  )  

          {
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
  else  {
  	ob=clone_object(FO"krebs");
  	ob->move(TP, M_NOCHECK);
  write(BS(
  "Du findest einen Krebs, den Du sofort einsteckst."));
     return 1; }
  return 0; }
return 0; }
  	
  
  


int go_water(string str)   {
   NF("Wohin willst Du waten?!\n");
    if(str=="wasser"||str=="in wasser"||str=="ins wasser")   {
  write("Du watest ins Wasser hinaus!\n");
  TPM("d/dschungel/dante/fisch/room/tauch2", M_GO,
  "ins das Wasser hinaus", "watet", "kommt ins Wasser gewatet");
  return 1; }
  return 0; }
  



int hoehle(string str)  {
   NF("Wo willst Du hinein klettern?\n");
if(str=="in loch"||str=="in loch hinein")   {
   
   if(present("DANTE_FISCH_LISTE_VIER", TP))   {
   write("Du kletterst in das schwarze Loch.\n");
   TPM("/d/dschungel/dante/fisch/room/gang1", M_GO, 
   "in das schwarze Loch", "klettert", "kommt hereingeklettert");
   return 1; }
   else
   {
   write(BS("Du versuchst in das schwarze Loch zu klettern, aber im Moment "
   "kannst Du das noch nicht. Du musst er andere Aufgaben erledigen! "));
   
   
   say(CAP_TPN+" versucht vergeblich in das schwarze Loch zu klettern.\n");
   return 1; }
   return 0; }
   return 0; }
   
