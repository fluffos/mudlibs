//raum fuer doby

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"

#define GEFUNDEN  (member(gefunden, getuid(this_player()))!=-1)
 string *gefunden=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Dobys Wohnhoehle" );
  SetProp( P_INT_LONG, BS(
  "Du stehst hier mitten in der sehr schlicht eingerichteten Wohnhoehle "
  "von Doby Mick. Eine Haengematte, eine alte Kiste, ein Tisch und "
  "ein morscher Stuhl stellen die gesamte Einrichtung dar. Die "
  "Waende bestehen aus beschlagenem Stein und ueberall haengen "
  "ausgestopfte Fische. Im Sueden kommst Du wieder zurueck an "
  "den Strand.                                                       Eine Tafel."));
 
 AD("tafel", "Lies sie!");
 
 ARD("tafel",
 "+-------------------------------------------------------+\n"
 "|                                                       |\n"
 "| Die Abenteuer die Doby Mick fuer Dich zu loesen hat,  |\n"
 "| sind recht aufwendig, aber nicht unloesbar und auch   |\n"
 "| nicht extrem gefaehrlich. Insgesamt sind es vier      |\n"
 "| verschiedene Aufgaben, die Du zu loesen hast.         |\n"
 "| Anfangs musst Du Fische fangen, dann einen speziellen |\n"
 "| Hai erlegen. Danach ein seltenes Krakenauge finden.   |\n"   
 "| Erst dann wartet die letzte, grosse Herausfoerderung  |\n"
 "| auf Dich. Du musst einen verborgenen Teil des         |\n"
 "| Dschungels finden, der von Kannibalen bewohnt wird,   |\n"
 "| und dort um Dein Leben bangen...                      |\n"
 "|                                                       |\n"
 "| Doch genug verraten!                                  |\n"
 "| Hast Du eine Aufgabe bereits erledigt, so merkt sich  |\n"
 "| Doby Mick das fuer immer!!!                           |\n"
 "| Du kannst also auch nach einem Reboot jederzeit       |\n"
 "| weiter forschen und nichts geht so verloren!!!        |\n"
 "|                                                       |\n"
 "| Viel Spass!                                           |\n"
 "|                              Dante                    |\n"
 "+-------------------------------------------------------+\n");
 
 
 
 
 AD("einrichtung",
 "Naja, was hier ist kennst Du ja schon. Nein, da ist noch "
 "eine alte Kanne.");
 AD("kanne",
 "Die Kanne ist aus Blech und uralt.");
 AD("himmel",
 "Den sieht man hier nicht.");
 
 ASD("blech", "get_schnur");
 
 AD("tisch",
 "Der Tisch ist auch schon recht alt und besteht aus Holz.");
 AD("holz",
 "Das Holz ist morsch und man sieht Wurmloecher.");
 AD(({"loch","loecher"}),
 "Wurmloecher.");
 ARD("buch",
 "Hier ist nichts zum lesen, oder doch...");
 
 ASD(({"wurmloecher","wurmloch"}), "buch_gefunden");
 
 AD("stuhl",
 "Der Stuhl ist sehr instabil und scheint nur drei Beine zu haben.");
 AD(({"bein","beine"}),
 "Die Beine des Stuhles bilden ein Dreieck am Boden.");


 ASD("dreieck", "get_haken");


 ASD("buch", "show_text");
 
 AD(({"matte","haengematte"}),
 "In der Haengematte schlaeft Doby.");
 AD("kiste",
 "Es ist eine alte Seemanskiste.");
 AD("seemanskiste",
 "Sie ist aus Holz und wird durch ein Schloss gesichert.");
 AD("schloss",
 "Es ist aus Stahl und stabil.");
 AD("stahl",
 "Der Stahl glaenzt und verhoehnt Dich direkt. Vergiss es, diese "
 "Kiste geht fuer Dich nie auf.");
 
 
AD("stein",
"Der Stein ist grau und teilweise bearbeitet."); 
 AD(({"wand","waende"}),
 "Die Waende bestehen aus Stein der bearbeitet wurde. Unzaehlige "
 "ausgestopfte Fische haengen an ihnen.");
 AD(({"fische","fisch"}),
 "Es sind zuviele um sie alle aufzuzaehlen. Aber ein Hai, ein "
 "Wels, ein Rochen und ein Aal gefallen Dir besonders gut.");
 AD("hai",
 "Der Hai ist sicher an die 5 Meter lang. Er sieht enorm gefaehrlich aus. "
 "Neben dem Hai faellt Dir eine Spalte in der Wand auf.");

AD("rochen",
"Der Rochen sieht eher langweilig aus. Klein, kaum ein Meter gross und grau.");
AD("aal",
"Der Aal scheint uralt gewesen zu sein. Er ist an die 3 Meter gross und "
"sehr dick. Sein Schwanz schlaengelt sich wild herum.");
AD("schwanz",
"Der Schwanz haengt in wilden Schlingen an der Wand.");
AD(({"schlinge","schlingen"}),
"Die Schlingen verstecken doch glatt einen Knopf hinter der Wand.");


AD("knopf",
"Wozu?!");

AD("spalte",
"Ob man da reingreifen sollte?!");


AD("meter",
"Es gibt kurze und lange Fische, aber dass wird Dir nicht neu sein.");
AD("wels",
"Der Wels hat lustige Antennen auf dem Ruecken.");
AD("ruecken",
"Der Ruecken des Wels ist bestueckt mit Antennen.");
AD(({"antenne","antennen"}),
"Naja, soetwas wie Stacheln.");
AD(({"stachel","stacheln"}),
"Die Stacheln sind enorm spitz. Eine der Stacheln sieht verdammt aus "
"wie ein Hebel!!!");


AD("hebel",
"Was kann man damit machen...");
 
 
 AD("boden",
 "Der Boden besteht aus gewalztem Lehm.");
 AD("lehm",
 "Der Lehm ist braun.");
 AD("decke",
 "Die Decke ist hier recht niedrig. Eine alte Lampe haengt herab.");
 AD("lampe",
 "Die Lampe stammt noch aus der Zeit als Doby Fischer war.");
 AD("zeit",
 "Untersuch weiter.");
 
 AD("sueden",
 "Dort liegt der Strand.");
 AD("strand",
 "Der Strand liegt im Sueden.");
  
 AD(({"hoehle","wohnhoehle"}),
 "Hier lebt Doby Mick schon lange.");
 AD(({"doby", "mick"}),
 "Doby war frueher  sehr lange Fischer.");
 AD("fischer",
 "Er fischte und fischte und fischte. Ab und zu betrank er sich.");
    

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    "Hier ist es sehr leise.");
  AddSmell( DEFAULT_SMELL,
    "Hmm, es riecht nach Fischen!");
    AddSmell(({"fisch","fische"}),
    "Viele, viele Fische...");
    
AIT(FN"questnpc", REFRESH_DESTRUCT);

AE("sueden", "./bruecke4");
ACD(({"greif","greife"}), "gag");
ACD(({"drueck","druecke"}), "get_griff");
ACD(({"zieh","ziehe"}), "get_angel");
ACD("seite2", "seite2");

}

int get_angel(string str)  {
	object ob;
	NF("Was willst Du ziehen?!\n");
	
	NOLIST
	
if(str=="hebel"||str=="am hebel"||str=="an hebel")  {
say(BS(
CAP_TPN+" macht sich an der Wand zu schaffen."));

if((present("DANTE_ANGEL_TEIL", TP))||(present("DANTE_ANGEL", TP)))  {
	write(BS(
"Du ziehst den Hebel, doch nichts passiert."));
return 1; }
if(!present("DANTE_ANGEL_TEIL", TP))  {
  write(BS(
"Du ziehst den Hebel, der Rochen blaeht sich auf und spuckt Dir etwas "
"entgegen."));
  ob=clone_object(FO"angelteil");
  ob->move(TP, M_GET);
  return 1; }
  return 0; }
  return 0; }
  

int get_griff(string str)  {
	object ob;
	NF("Was willst Du druecken?!\n");
NOLIST



if(str=="knopf")  {
say(BS(
CAP_TPN+" macht sich an der Wand zu schaffen."));

if((present("DANTE_GRIFF", TP))||(present("DANTE_ANGEL", TP)))  {
	write(BS(
"Du drueckst den Knopf, doch nichts passiert."));
return 1; }
if(!present("DANTE_GRIFF", TP))  {
  write(BS(
  "Du drueckst den Knopf, der Aal reisst sein Maul auf und spuckt "
  "Dir etwas entgegen!"));
  ob=clone_object(FO"griff");
  ob->move(TP, M_GET);
  return 1; }
  return 0; }
  return 0; }
  



string get_schnur()  {
	object ob, s;
ob=deep_present("DANTE_ANGELSCHNUR", TP);
if((ob)||(!present("DANTE_FISCH_LISTE", TP))||(present("DANTE_ANGEL", TP)))  {
	return BS(
"Das Blech ist alt und vergammelt.");  }
if(!ob)		{
	s=clone_object(FO"angelschnur");
	s->move(TP, M_GET);
return BS(
"Um die Kanne war eine Angelschnur gewickelt, die Du nun einsteckst!");  
} }

		
string get_haken()  {
	object ob, ha;
ob=deep_present("DANTE_HAKEN", TP);
if((ob)|| (!present("DANTE_FISCH_LISTE", TP))
|| (present("DANTE_ANGEL", TP)))  {
	return BS(
"Du siehst ein Dreieck.");  }
if(!ob)		{
	ha=clone_object(FO"haken");
	ha->move(TP, M_GET);
return BS(
"Du findest unter Stuhl einen Haken!");  }}
	


int gag(string str)  {
	NF("Wo willst Du reingreifen?!\n");
if(member(({"in spalte","spalte","spalt","in spalt", "in spalt rein",
"in spalt hinein"}),str)!=-1)  {
	write(BS(
"Du greifst in die Spalte und irgendetwas beisst Dir in die Hand! AUA!"));
TP->do_damage(5);
say(BS(
CAP_TPN+" greift in eine Spalte und jammert dann laut."));
return 1; }
return 0;}
int seite2()  {
	if(!present("DANTE_FISCH_LISTE", TP))  {
	write (BS(
	"Rede zuerst mit Doby!"));  return 1; }
		
	if(!GEFUNDEN)  {
	write( BS(
"Sowas siehst Du da nicht."));  return 1; }

else {
	write(
"Da das Fischen in diesen Gewaessern ohne Wissen sehr zeitwufwendig sein kann, "
"habe ich hier eine kleine Aufstellung gemacht:\n\n");			
write(
 "Fischarten               Gewaesser                         Koeder\n\n"
"1. Forellen/Lachse:   Wildes, sauerstoffreiches Wasser     Wattwuermer\n"
"2. Rochen/Flundern:   ruhiges, truebes Wasser              Muscheln\n"
"3. Haie:              Starke Stroemung, tiefes Wasser      Fische\n"
"4. Aaale:             Schlamiges Wasser                    Schnecken\n"
"5. Div. Kleinfische:  Ruhiges, flaches Wasser              Mehlwuermer\n"
"6. Div. Grossfische:  Tiefes Wasser, mittlere Stroemung    Krebse\n\n"
"Ich hoffe, dass Dir hiermit etwas geholfen ist. Petri Heil!!!\n");

return 1; }
return 0; }


string show_text()  {
	
	if(!present("DANTE_FISCH_LISTE", TP))  {
	return BS(
	"Rede zuerst mit Doby!");  }
		
	if(!GEFUNDEN)  {
	return BS(
"Sowas siehst Du da nicht.");  }
if(GEFUNDEN)   {
	return (BS(
"Ich bin schon sehr alt und bevor ich alles vergesse schreibe ich es hier auf. "
"Vor vielen Jahren habe ich mich mit der Fischerei und den Fischen "
"dieser Gegend beschaeftigt. So habe ich herausgefunden, dass nicht "
"jeder Fisch jeden Koeder fressen will. Auch wurde mir klar, dass "
"verschiedene Fische verschieden Arten des Wassers bevorzugen. Manche "
"eher flaches, andere wildes und sauerstoffreiches. Koeder findet man "
"am besten am Strand oder auch im Wasser, je nach dem. <weiter mit seite2>"));

}}
			
string buch_gefunden()  {
	
if(!present("DANTE_FISCH_LISTE", TP))  {
	return BS(
	"Rede zuerst mit Doby!");  }
		
	if(!GEFUNDEN)  {
gefunden += ({getuid(this_player())});   		
   return BS(
 "Du betrachtest die Wurmloecher und entdeckst am Boden ein "
 "altes Buch!");  }
 if(GEFUNDEN)  {
 	return BS(
 "Da ist das alte Buch; kennst Du doch schon.");	  
}}
