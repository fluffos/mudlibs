/*dante sl 98 99
hier landet man wenn man von oben vom wasserfall kommt
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"


init()  {
  ::init();
  if(interactive(TP)) {
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 5+random(5),
  PARALYZE_MSG: "Aber Du bist doch total benommen!\n",
  PARALYZE_MSG_OTHER: "%s wird vom Wasser hierhergeschleudert und liegt benommen herum!\n",
  PARALYZE_END: "Du kommst wieder zu Sinnen!\n",
  PARALYZE_END_OTHER: "%s kommt dumm guckend wieder zu sich!\n"]));
  } }
  

#define AIR  (member(air, getuid(this_player()))!=-1)
 string *air=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsen mitten im Fluss" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun auf einem schmalen Felsen mitten im Fluss und bist "
  "froh, dass Du den Sturz den Wasserfall hinab in Deiner Tonne "
  "ueberlebt hast. Der Wasserfall stuerzt direkt im Norden von hier "
  "tosend herab und bildet eine wilde, weisse Gischt rings um den Felsen. "
  "Der Fluss ist hier so wild, dass an Schwimmen wohl kaum zu denken "
  "ist. Der Strand liegt irgendwo weiter im Sueden."));
  
  AD("norden",
  "Im Norden rast der Wasserfall herab, aber den kennst Du ja bereits.");
  
  AD("gischt",
  "Die Gischt tobt direkt um Dich herum. Sie ist voellig weiss und "
  "ihr Wasser ist voller Sauerstoff.");
  AD("sauerstoff",
  "Das Wasser soll so gesund sein, das es angeblich alles heilen kann! Trink es doch!");
  
  AD("boden",
  "Der Boden hier ist sehr nass und rutschig.");
  AD("decke",
  "Himmel.");
  AD("himmel",
  "Er ist wirklich enorm blau, irgendwie kitschig!");
  AD(({"wand","waende"}),
  "Die Waende sind tapeziert und recht dreckig!!! Wo bitte sollen hier Waende sein!!!");
  
    AD("schwimmen",
  "Es scheint kaum zu klappen, aber man kann es ja probieren!");
  
    AD(({"fels","felsen"}),
    "Der Felsen ist recht schmal, viel bewegen kannst Du Dich hier "
    "nicht. Das wilde Wasser tobt direkt an ihm flussabwaerts vorbei.");
    AD("fluss",
    "Der Fluss wird hier sozusagen durch den Wasserfall aufgewirbelt, "
    "wird aber weiter im Sueden viel ruhiger.");
    AD("wasserfall",
    "Der Wasserfall hat Dich und Deine Tonne hier hergeworfen. Er rast "
    "an Dir vorbei und wirbelt hier unten das Wasser weiss auf.");
    
    
    AD("wasser",
    "Enorm viel Wasser rast herunter und bildet hier eine weisse "
    "Gischt.");
    
    AD("tonne",
    "Deine Tonne ist bei dem Sturz zertruemmert worden. Sie hat Dich aber "
    "sicherlich vor dem Tod gerettet.");
    AD("sturz",
    "Du hast ihn knapp ueberlebt.");
    AD("tod",
    "Fast waerst du krepiert.");
    
    
    AD("sueden",
    "Da liegt der Strand. Wie kommst Du da wohl hin...");
    AD("strand",
    "Du siehst den Strand von hier aus nicht besonders gut. Sand und "
    "Klippen und die Bruecke.");
    AD("sand",
    "Braun, teilweise eher weiss und heiss.");
    AD("bruecke",
    "Die sieht man hoch oben im Sueden.");
    AD(({"klippe","klippen"}),
    "Die Klippen ragen steil nach oben. He! Da winkt Dir Jemand zu.");
    AD("jemand",
    "Hmm, wer das wohl sein mag?!");
     
AD("oeffnung",
"Da ist doch glatt eine schmale Oeffnung im Boden. Sie ist voller "
"Wasser. Irgendwie sieht sie unheimlich aus, aber doch interessant. "
"Hmm, wie koennte man ihn sie gelangen. Sei gewarnt! Hier drin werden Dir weder "
"Kajubos noch Elementare helfen koennen.");

AD(({"kajubo","kajubos","elementar","elementare"}),
"In dieser Oeffnung hilft Dir nichts mehr.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");

AddSound("wasserfall",
"Der Wasserfall ist hier lauter als laut.");
AddSmell("luft",
"Die Luft ist hier so herrlich frisch, fast ein Kurort!");

ACD(({"schwimm","schwimme"}), "nix", 1);

ACD(({"hole", "hol", "atme"}), "get_air");
ACD(({"tauche", "tauch"}), "go_down");
ACD(({"trink","trinke"}), "fake");

ACD(({"kletter","klettere","steige","steig","krieche","kriech",
"springe","spring"}), "nix2");




AIT("d/dschungel/dante/hoehle/npc/dskor2", REFRESH_DESTRUCT);

   


}

int nix2(string str)  {
	NF("Was willst Du hier genau machen?!\n");
	if(str=="oeffnung"||str=="in oeffnung"||
	str=="in oeffnung hinein"|| str=="in oeffnung rein")  {
	
	write(BS(
	"Du willst in die Oeffnung, aber so nicht. Probiers mal mit "
	"tauchen, aber sei vorsichtig. Wer weiss ob Du da nicht ertrinken koenntest "
	"ohne viel Luft!"));
say(BS(
	CAP_TPN+" versucht irgendwie von hier abzuhauen!"));
	return 1; }
   return 0; }
		
int fake(string str)  {
	 NF("Was willst Du hier trinken?!\n");
	 if(str=="wasser")  {
write(BS(
"Du beugst Dich nach vorne um an das Wasser aus der Gischt zu gelangen. "
"Du rutscht dabei aber aus, knallst auf den Kopf und nun erst "
"siehst Du eine gar nicht so kleine Oeffnung im Felsen!"));
say(BS(
CAP_TPN+" knallt auf den Felsen!"));
    return 1; }
return 0; }
	 	

int nix()  {
	write(BS(
"Du versuchst in der wilden Gischt zu schwimmen, doch das Wasser "
"wirft Dich immer wieder auf den Felsen zurueck."));
say(BS(
CAP_TPN+" versucht verzweifelt im Wasser zu schwimmen."));	
	return 1; }
	      
      
int get_air(string str)  {
       NF("Was willst Du atmen/holen?\n");
     if(str=="luft"||str=="luft ein")   {
  
  if(AIR)  {
    write("Aber Du hast doch schon tief Luft geholt!\n");
    say(CAP_TPN+" atmet dumm!\n");
    return 1;               }
   
    if(!AIR)           {
    write(BS(
    "Du holst Luft. Fein. Aber das ist irgendwie zu wenig. Du "
    "solltest lieber tief Luft holen."));
   say(CAP_TPN+" holt Luft!\n");
    return 1; }
    return 0; }
    if(str=="tief luft"||str=="luft tief ein")   {
  
  if(AIR)  {
    write("Aber Du hast doch schon tief Luft geholt!\n");
    say(CAP_TPN+" atmet dumm!\n");
    return 1;               }
   
    if(!AIR)           {
    write(BS(
    "Du holst einige Male tief Luft. Nun bist Du bereit!"));
    say(CAP_TPN+" holt tief Luft!\n");
  air += ({getuid(this_player())});   
   say(CAP_TPN+" holt Luft!\n");
    return 1; }
    return 0; }
    return 0; }
      


int go_down(string str)   {
      NF("Wo willst Du rein tauchen?!\n");
  if(member(({"in oeffnung", "in oeffnung rein", "in oeffnung hinein"}), str)!=-1)  {
  
  if(!AIR)   {
  write("Du tauchst wagemutig in die Oeffnung hinein.\n");
  TPM("/d/dschungel/dante/fisch/room/tauch", M_GO,
  "in das dunkle Loch hinein", "taucht", "kommt hereingetaucht");
  return 1; }
  if(AIR)   {
  write("Du hast genug Luft und tauchst in die dunkle Oeffnung hinein!\n"
  "Schnell durchtauchst Du einen dunklen Tunnel und kommst irgendwo "
  "wieder ans Tageslicht! Gut gemacht!\n");
  say(CAP_TPN+" taucht in eine dunkle Oeffnung hinein!\n");
  TPM("/d/dschungel/dante/fisch/room/tauch2", M_GO,
  "in das dunkle Loch hinein", "taucht", "kommt hereingetaucht");
  return 1;  }
  return 0;  }
  return 0; }
  
              