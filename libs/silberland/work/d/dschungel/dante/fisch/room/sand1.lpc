//hier lebt die krake wenn sie an land ist....aufstieg per leiter nach
///weg/room/bruecke2.c

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"

#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Westen und Sueden. Im Norden "
  "wird er durch hohe Klippen begrenzt und im Osten endet sie am Fluss. "
  "Hoch ueber Dir liegt im Osten die Bruecke, zu der Du mit einer Leiter wieder "
  "hochklettern kannst."));   



AD("osten",
"Im Osten macht der Fluss eine kleine Biegung und begrenzt so den Sand.");
AD("leiter",
"Eine schmale Leiter fuehrt im Osten nach oben zur Bruecke.");
AD("bruecke",
"Die liegt hoch ueber Dir etwas ostwaerts.");

AD("norden",
"Im Norden begrenzen hohe Klippen die Sandbank. Die Klippen sind hier "
"sehr zerfurcht und haben viele Risse.");
AD(({"riss","risse"}),
"Die Risse fuehren die ganze Klippe hoch. Man kann so sicher "
"irgendwie nach oben gelangen.");
AD("westen",
"Im Westen sieht man nur Sand und noch weiter im Westen den Wasserfall.");
AD("wasser",
"Das Wasser des Fluss raucht an Dir vorueber.");
AD("wasserfall",
"Der Wasserfall stuerzt im Westen ueber eine enorm hohe Klippe. Er rauscht "
"so laut, dass man sein eigens Wort nicht mehr verstehen kann.");
AD("wort",
"Wie bitte?!?!??!Ich verstehe nichts?");
AD(({"klippe", "klippen"}),
"Die Klippen liegen direkt neben Dir im Norden. Im Westen stuerzt ein "
"Wasserfall ueber eine enorm hohe Klippe. Die Klippen hier weisen viele "
"Risse auf. Hoch oben erkennt man einen Vorsprung.");
AD("vorsprung",
"Der Vorsprung ist hoch oben. Was oder wer da wohl lebt?!");
AD("sueden",
"Im Sueden liegt Sand. Dahinter fliesst der Fluss.");

AD("fluss",
"Der Fluss rauscht an der Sandbank vorbei.");

AD(({"urlaub","urlaubsgefuehle"}),
"Hier sicher nicht!");
AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt, "
"erzeugt Urlaubsgefuehle bei Dir. Aber dafuer bist Du nicht hier...");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann. Aber graben kann man im Sand.");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");
AD("sandbank",
"Die Sandbank erstreckt sich hier nach Sueden und Westen.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({ "luft" }), 
    "Sehr frisch." );
  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");

AE("osten", "./bruecke4");
AE("westen", "./sand2");

ASE("sueden", "nix");
ASE("suedwesten", "nix");

ACD(({"kletter","klettere","steige","steig"}), "up");
DO_ANGEL
ACD(({"grab","grabe"}), "get_koeder");



AIT("d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 15, 30, 10}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand3"]) );
   
  

}

  int do_angel()   {
  write (BS(
  "Hier ist kein geeigneter Platz zum Angeln! Versuch es woanders!")); 
  return 1;
  }
int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   if ( (!present("DANTE_FISCH_LISTE", TP)) ||
        (deep_present("wattwurm", TP))||
        (deep_present("DANTE_ANGEL_WATTWURM", TP))  )  

          {
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
  else  {
  	ob=clone_object(FO"wattwurm");
  	ob->move(TP, M_NOCHECK);
  write(BS(
  "Du findest einen Wattwurm, den Du sofort einsteckst."));
     return 1; }
  return 0; }
return 0; }
  	
  
  
  	
int up(string str)  {
   NF("Wo willst Du hinauf klettern?\n");
if(str=="klippe hoch"||str=="klippen hoch" ||str=="nach oben"||
str=="rauf"||str=="hinauf"||
str=="zu vorsprung"||str=="zum vorsprung"||str=="zu vorsprung hoch")   {
if(present("DANTE_FISCH_LISTE_ZWEI", TP))   {   
   write("Du kletterst die Klippe hoch.\n");
   TPM("/d/dschungel/dante/fisch/room/oben", M_GO, 
   "die Klippe hoch", "klettert", "kommt hereingeklettert");
   return 1; }
   else
   {
   write(BS("Du versuchst die Klippen hoch zu klettern, aber im Moment "
   "kannst Du das noch nicht. Geduld! Erst musst Fische fangen!"));
   say(CAP_TPN+" versucht vergeblich die Klippen hoch zu klettern.\n");
   return 1; }
   return 0; }
   return 0; }



   
   


int nix()
  {
NF("Du bleibst im tiefen Sand stecken!\n");
return 0; }
       
