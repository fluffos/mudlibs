inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

/*flache fische ok!!!!!!

*/

int fische=0;
#define MAX 30
#define TI 0//2+random(4)

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im halbhohen Wasser" );
  SetProp( P_INT_LONG, BS(
"Hier ist das Wasser halbhoch und reicht Dir je nach Wasserstand "
"und persoenlicher Groesse bis an die Knie oder auch bis an den Hals. "
"Es plaetschert ruhig dahin, wird aber im Westen abrupt tiefer und wilder. "
"Im Norden stehen die hohen Klippen und begrenzen so den Fluss. Im Osten liegt "
"der Strand, zu dem Du bequem hinwaten kannst."));


AD("boden",
"Der Boden ist hier der Grund des Flusses.");

AD("grund",
"Hmm, man sieht es nicht genau, aber Du glaubst eine Oeffnung zu sehen!");

AD("oeffnung",
"Hmm, ob man in sie hineintauchen kann?!");
AD("decke",
"Himmel.");
AD("himmel",
"Er ist wolkenlos und sehr blau.");
AD(({"wand","waende"}),
"Keine zu sehen , wie auch.");


AD("westen",
"Im Westen liegt der Wasserfall, dort wird das wasser natuerlich "
"sehr wild. Du kannst dort nicht hinschwimmen.");
AD("wasserfall",
"Der Wasserfall sieht enorm imposant aus.");

AD("norden",
"Im Norden stehen die alles ueberragenden Klippen.");
AD(({"klippe","klippen"}),
"Die Klippen sollen eine Hoehle verbergen.");
AD("hoehle",
"Sie ist leider von hier nicht zu sehen.");

AD("osten",
"Im Osten liegt der Strand. Man kann hinwaten.");
AD("strand",
"Der Strand liegt oestlich von hier. Er ist ganz nahe!");


AD("wasser",
"Das Wasser ist hier ruhig und trueb. Hier "
"scheinen andere Fische als sonst wo im Fluss zu leben.");
AD("fluss",
"Der Fluss ist hier ruhig, wird aber weiter draussen wieder wilder.");
AD("knie",
"Haengt von Deiner Groesse ab!");
AD("hals",
"Sei froh, dass Du nicht untergehst.");
ASD("groesse", "gros");

AD("wasserstand",
"Momentan fuehrt der Fluss eher wenig Wasser.");




     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Plaetscher, gurgel,...");
  AddSmell( DEFAULT_SMELL,
"Es riecht sehr frisch.");

AIT("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);
AIT("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);

ACD(({"wate"}), "water");
ACD(({"tauche","tauch"}), "nix");

DO_ANGEL

SHOW_FISCH
}


int do_angel()   {
	object oba, obb;
	obb=present("DANTE_ANGEL_MUSCHEL", TP);
	oba=present("DANTE_ANGEL", TP);
	
if(present("fishingaction", TP))   {
	write("Aber Du angelst doch schon!!!\n");
	return 1; }
		
	
     if(!oba)  {
     	write("Du hast keine geeignete Angel!\n");
     	return 1; }

    if((oba) &&(!obb))  {
   	write(BS("Du wirfst Deine Angel gekonnt aus und wartest."));
   	call_out("fail", TI);
   	  oba->AddId("fishingaction");
   	say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
   	return 1; }

        if(obb)  {	   
     	write("Du wirfst Deine Angel gekonnt aus und wartest.\n");
        say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
        call_out("ok", TI);
        obb->AddId("fishingaction");
           return 1; }
        return 0; }
 
 
 //das hier muss sein damit die spieler nicht 100000000
 //fische erzeugen koennen
 reset()  {
 	::reset();
  fische=MAX;   }
  	
 
 
        
    fail()   {object ob;
    	ob=present("DANTE_ANGEL", TP);
    	if(ob)  {  
    	ob->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    else  {
    write(BS(
  "Du holst die Angel wieder ein, irgendetwas scheint nicht zu stimmen. "
  "Der Koeder, der Ort..."));
    return ; }
}

 
        
        
    ok()   {object obb, ob;
    	obb=present("DANTE_ANGEL_MUSCHEL", TP);
    	if(obb)  {  
    	obb->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    		
    	if(fische>= MAX)  {
    		write(BS(
    "Du ziehst die Angel aus dem Wasser, das Gewaesser scheint "
    "leer gefischt zu sein. Warte ein wenig bitte!"));
    return ; }
    			
    		
    else  {
    write(BS(
"Irgendetwas zieht an Deiner Angel! Du reisst sie aus dem Wasser!"));

    switch(random(15))  {


      case 0: 
      write("Leider ist der Haken leer!\n"); return ;
      break;
    case 1..10:
    ob=clone_object("/d/dschungel/dante/fisch/obj/stdro");
    break;
    case 11:
     ob=clone_object("/d/dschungel/dante/fisch/obj/teukopf");
     break;
     case 12:
      ob=clone_object("/d/dschungel/dante/fisch/obj/flunder");
      break;
     case 13: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/scholle");
     break;
       case 14: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/szunge");
     break;
      default:   ob=clone_object("/d/dschungel/dante/fisch/obj/stdro");
}

fische++;
  write(BS("Ein Fisch zappelt am Haken! "
  ""+ob->short()+"Du nimmst den Fisch"
  " sofort vom Haken und steckst ihn ein!!!"));
  write("Dein Koeder scheint noch gut zu sein!!!\n");
  
  ob->move(TP, M_GET);
}

    }





string gros()  {
	if(TP->QueryProp(P_SIZE)<150)  {
	return BS(
"Das Wasser reicht Dir fast bis an den Hals!");  }
if(TP->QP(P_SIZE)>=150 && TP->QP(P_SIZE)<190)  {
	return BS(
"Das Wasser reicht Dir kaum zur Huefte!");  }
else  
 return BS(
 "Das Wasser steht etwas ueber Deinen Knien!");  }
 			

string show_fisch()  {
	switch(random(6))  {
 case 0:
    write("Du glaubst fuer den Bruchteil einer Sekunde eine Flunder zu sehen!\n");
    break;
    case 1:
    write("Ein Rochen taucht kurz auf, verschwindet aber sofort wieder!\n");
    break;
    case 3:
    write("Im Moment siehst Du leider keinen Fisch!\n");
    break;
    case 4:
    write("Du glaubst einen Dschungelrochen zu sehen!\n");
    break;
    case 5:
    write(BS("Du siehst kurz eine Seezunge!"));
    break;
    default: write("Du siehst einen Dschungelrochen!!!\n");}
     return"";}
    








int nix(string str)  {
	 NF("Wo willst Du hier tauchen?!\n");
	if(!str)  {
		
		say(BS(
CAP_TPN+" taucht kurz unter, aber bald wieder auf."));
		write(BS(
	"Du tauchst kurz unter, aber sofort wieder auf."));
	return 1; }
	
	
if(str=="in oeffnung"||str=="in oeffnung rein"||str=="in oeffnung hinein")  {

	write(BS(
"Du versuchst in die Oeffnung hinein zu tauchen, schaffst es aber nicht!"));
say(BS(
CAP_TPN+" taucht kurz unter, aber bald wieder auf."));
return 1; }
return 0; }
			 


int water(string str)   {
   NF("Wohin willst Du waten?!\n");
    if(str=="zu sand"||str=="zum sand"||str=="nach osten"||
    str=="zu strand"||str=="zum strand"||
    str=="an strand"||str=="zurueck"||str=="raus")   {
  write("Du watest an den Strand zurueck!\n");
  TPM("d/dschungel/dante/fisch/room/sand3", M_GO,
  "an den Strand zurueck", "watet", "kommt aus dem Wasser gewatet");
  return 1; }
  return 0; }
  
