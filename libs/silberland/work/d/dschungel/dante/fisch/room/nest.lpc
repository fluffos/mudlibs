//dante sl 98-99

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"

#define BLOW  (member(blow, getuid(this_player()))!=-1)
 string *blow=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG, BS(
  "Du bist nun in einer geraeumigen, feuchten Hoehle gelandet. "
  "Ein Wasserfall, der durch ein Loch in der Decke hier eindringt, "
  "verlaesst die Hoehle durch eine weite, klaffende Oeffnung im "
  "Sueden wieder. Ein einziger, kleiner Fleck ist halbwegs trocken, "
  "und genau auf dem stehst Du. Von hier aus scheint es nach "
  "Norden weiter in die Hoehle zu gehen."));

AD("boden",
"Der Boden ist bis auf den kleinen Fleck total mit Wasser erfuellt.");
AD(({"wand","waende"}),
"Die Waende bestehen aus groben Steinen und sind sehr feucht.");
AD(({"stein","steinen"}),
"Du siehst eine Zeichnung, die jemand hier eingeritzt hat.");
AD("zeichnung",
"Hmm, da stuerzt sich jemand den Wasserfall hinunter...");
 
AD("fleck",
"Genau da stehst Du. Das Wasser rast an Dir vorbei und Dir wird "
"schwindlig. Von hier aus koennte man sich sicher gut in den "
"Wasserfall stuerzen.");

AD("wasserfall",
"Der Wasserfall stuerzt durch ein Loch in der Decke herein, prallt auf und "
"rast dann weiter durch die Oeffnung hinaus.");
 
 
 AD("hoehle",
 "Die Hoehle ist recht gross, doch leider fast total vom "
 "Wasser ueberflutet.");
 AD("wasser",
 "Das Wasser stuerzt durch ein Loch in der Decke herab und verlaesst "
 "die Hoehle durch eine Oeffnung im Sueden wieder.");
 AD("decke",
 "In der Decke befindet sich ein grosses Loch, durch das der Wasserfall "
 "herabstuerzt.");
 AD("loch",
 "Durch das Loch rast das Wasser herein.");
 AD("norden",
 "Dort scheint es weiter zu gehen.");
 AD("sueden",
 "Im Sueden stuerzt das Wasser durch eine Oeffnung wieder nach unten aus der Hoehle heraus.");
 AD("oeffnung", 
 "Die Oeffnung klafft in der Wand, durch die das Wasser hinaus rast.");
 
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
AD("feder",
"Sie ist vorhanden, doch scheinbar kann man sie nicht sehen. "
"Ob man sie anpusten kann...");
AD("luft",
"Feucht!");

ASE("norden", "test");
ACD(({"puste", "pust", "blase", "blas"}), "get_ex");
ACD(({"stuerze", "stuerz"}), "go_down");

AIT(FN"harp2", REFRESH_DESTRUCT);

}


init()  {
	::init();
	
	if ( (interactive(TP)) &&
	     (!IS_WIZARD(TP))  &&
	     (!present("DANTE_FISCH_LISTE_DREI", TP)) ) {
	 TPM("gilden/abenteurer", M_GO+M_SILENT);
	 }}    	



 test()  {
     if(!BLOW)   {
      write(BS( "Irgendetwas stosst Dich sanft zur Seite! Hmm, "
      "Du glaubst, dass es eine grosse, unsichtbare Feder war?!"));
      
      return 1; }
   
      if(BLOW)  {
      write("Die Feder biegt sich Sanft zur Seite!\n");
      return TPM("d/dschungel/dante/fisch/room/nest2",M_GO,
      "an der Feder vorbeizuschweben", "scheint",
      "schwebt herein");      }
      }
      
      
int get_ex(string str)  {
       NF("Was willst Du anpusten?\n");
     if(str=="feder an"||str=="an feder")   {
  
  if(BLOW)  {
    write("Aber Du hast die Feder schon einmal angepustet!\n");
    say(CAP_TPN+" pustet dumm herum!\n");
    return 1;               }
   
    if(!BLOW)           {
    write(BS("Du holst tief Luft und pustest die Feder an! "
    "Wie durch Zauber biegt sich die Feder und scheint Dir nun "
    "gut gesonnen zu sein!"));
  blow += ({getuid(this_player())});   
   say(CAP_TPN+" pustet Luft herum!\n");
   return 1; }
   return 0; }
   return 0; }
       




int go_down(string str)   {
object ob;
ob=present("DANTE_TONNE", TP);
  NF("Wo willst Du Dich hinunter stuerzen?!\n");
  
  if(member(({"wasserfall runter", "wasserfall hinunter",
              "ins wasser runter", "nach unten",
              "in wasserfall", "runter",
              "wasser runter","wasser hinunter",
              "ins wasser runter", "ins wasser hinunter"}),str)!=-1) {
  
  if(ob)  {
  write(BS("Du hast doch eine Tonne. Stuerze Dich lieber "            
  "mit ihr in den Wasserfall!"));
  say(CAP_TPN+" versucht vergeblich den Wasserfall hinunterzugelangen.");
  return 1;                        }
  
  if(!ob)  {
  
  write(BS(
  "Du versuchst ohne Hilfsmittel den Wasserfall hinunter zu stuerzen! "
  "Du springst dumm wie Du bist in den Wasserfall, doch der starke "
  "Wasserdruckt schleudert Dich gegen einen Felsen und Du bleibst "
  "benommen liegen!"));
  TP->do_damage(10);
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 5+random(5),
  PARALYZE_MSG: "Aber Du bist doch total benommen!\n",
  PARALYZE_MSG_OTHER: "%s wird gegen einen Flesen geschleudert und liegt benommen am Boden!\n",
  PARALYZE_END: "Du kommst wieder zu Sinnen!\n",
  PARALYZE_END_OTHER: "%s kommt dumm guckend wieder zu sich!\n"]));
  return 1;                         }
  return 0; }
  
  if (member(({"in tonne wasserfall hinunter",
               "wasser mit tonne runter",
               "wasserfall in tonne runter",
               "wasserfall mit tonne runter",
               "wasserfall in tonne hinunter",
               "in tonne wasserfall runter",
               "in tonne wasser runter",
               "mit tonne in wasser",
               "mit tonne wasser runter",
               "mit tonne in wasserfall",
               "mit tonne wasserfall runter",
               "in wasserfall mit tonne",
               "in tonne wasserfall runter"}), str)!=-1)   {
           if (!ob)  {
  write(BS(
  "Du bist so dumm zu luegen und das ist die Strafe! "
  "Du springst dumm wie Du bist in den Wasserfall, doch der starke "
  "Wasserdruckt schleudert Dich gegen einen  extrem spitzen Felsen und Du bleibst "
  "benommen und blutend liegen!"));
  TP->do_damage(100);
  SP(P_KILL_MSG, "Dummheit und Luegen");
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 10+random(10),
  PARALYZE_MSG: "Aber Du bist doch total benommen!\n",
  PARALYZE_MSG_OTHER: "%s wird gegen einen Felsen geschleudert und liegt benommen am Boden!\n",
  PARALYZE_END: "Du kommst wieder zu Sinnen!\n",
  PARALYZE_END_OTHER: "%s kommt dumm guckend wieder zu sich!\n"]));
  return 1; }
       
  if(ob)  {
    write(BS("Du nimmst die Tonne, setzt sie aufs Wasser und "
    "springst dann wagemutig hinein! Sofort reisst Dich die starke "
    "Stroemung mit und ab geht die Todesfahrt den Wasserfall hinunter!"));
    write("\n\n");
    say(CAP_TPN+" stuerzt sich todesmutig in den Wasserfall und wird sofort "
    "mitgerissen!");
    ob->remove();
    TPM("d/dschungel/dante/fisch/room/fall", M_GO+M_SILENT);
    return 1; }
    return 0;}
   return 0; }
        