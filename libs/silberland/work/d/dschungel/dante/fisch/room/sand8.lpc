inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

#define QUESTKEY "Die Abenteuer des Piraten Piet van Kielhol"

#include "/d/dschungel/dante/fisch/fisch.h"
#include <mnpc.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Westen, Norden und Sueden. "
  "Im Osten wird er durch den Fluss begrenzt. "
  "Die rettende Leiter ist im Norden! "
  "Du kannst hier Deinem Tod fast in die Augen schauen! "
  "Etwas Schreckliches muss ganz in der Naehe sein!"));
AD(({"auge","augen"}),
"Nahe, sehr nahe, ist Tantalus!");
AD("tantalus",
"Bald ist es soweit, und Du erblickst ihn!");
AD("schreckliches",
"TANTALUS, der Krake!");
AD("krake",
"TANTALUS!");

AD("tod",
"Der Tod erwartet Dich!");

AD("osten",
"Im Osten rauscht der Fluss an Dir vorbei.");
AD("leiter",
"Die Leiter liegt im Norden.");
AD("bruecke",
"Die Bruecke liegt hoch ueber Dir im Osten.");

AD("norden",
"Im Norden liegt Sand und weit dahinter begrenzen hohe Klippen die Sandbank.");
AD("westen",
"Im Westen liegt nur Sand und sehr weit im Westen der Fluss und der Wasserfall.");
AD("wasser",
"Das Wasser des Fluss rauscht im Osten an Dir vorueber. Es sieht hier sehr "
"interessant aus. Es ist gruen und Du glaubst auch einen sehr grossen "
"dunklen Schatten zu erkennen.");
AD("schatten",
"Der Schatten koennte ein grosser Hai sein.");
AD("hai",
"Der Hai sieht gewaltig gross aus, aber es ist ja nur ein Schatten. Um mehr "
"erkennen zu koennen, muesstest Du ins Wasser waten, aber ob das anzuraten ist...");

AD("wasserfall",
"Der Wasserfall stuerzt sehr weit im Westen ueber eine enorm hohe Klippe. Er rauscht "
"extrem laut.");
AD(({"klippe", "klippen"}),
"Die Klippen liegen weit im Norden.");
AD("sueden",
"Im Sueden liegt Sand und weiter suedwaerts fliesst der Fluss rauschend an Dir vorueber.");

AD("fluss",
"Der Fluss rauscht im Osten an der Sandbank vorbei. Hier scheint man nicht "
"besonders gut fischen zu koennen, doch das Wasser ist trotzdem sehr interessant.");

AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt. ");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann...");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");

AD("sandbank",
"Die Sandbank erstreckt sich hier nach Westen, Sueden und Norden.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");


AE("sueden", "./sand7");

ASE("norden", "go_n");

ASE("westen", "go_w");
ACD(({"wate"}), "water");
DO_ANGEL

AIT("d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 15, 30, 10}),
     P_AGGRESSIVE: 1,
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand3"]) );
   


AIT("d/dschungel/feyaria/kueste/npc/wurm", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   
ACD(({"grab","grabe"}), "get_koeder");
}


  int do_angel()   {
  write (BS(
  "Hier ist kein geeigneter Platz zum Angeln! Versuch es woanders!")); 
  return 1;
  }
int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   if ( (!present("DANTE_FISCH_LISTE", TP)) ||
        (deep_present("schnecke", TP))||
        (deep_present("DANTE_ANGEL_SCHNECKE", TP))  )  

          {
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
  else  {
  	ob=clone_object(FO"schnecke");
  	ob->move(TP, M_NOCHECK);
  write(BS(
  "Du findest eine Schnecke, die Du sofort einsteckst."));
     return 1; }
  return 0; }
return 0; }
  	
  

int water(string str)   {
   NF("Wohin willst Du waten?!\n");
    if(str=="ins wasser"||str=="in wasser")   {
         if(!present("DANTE_FISCH_LISTE_ZWEI", TP))  {
         write("Nein, Du kannst das nicht. Geh zuerst zu Doby Mick!\n");
         return 1; }
  else  {
  write("Du watest ins Wasser hinaus!\n");
  TPM("d/dschungel/dante/fisch/room/hairaum", M_GO,
  "ins Wasser hinaus", "watet", "kommt hereingewatet");
  return 1; }
  return 0; }
return 0; }
  

  int go_w()
     {
    
    if  ( present("DANTE_FISCH_LISTE_VIER", TP) )
  {    
    
     return  TP->move("d/dschungel/dante/fisch/room/sandzentrum:"+getuid(TP),
      M_GO+M_NOCHECK,
     "sich nach Westen", "wagt", "wagt sich herein");            
  
  previous_object()->CustomizeObject();   
  return 1;
         }

if(TP->QueryQuest(QUESTKEY))  {
 return  TP->move("d/dschungel/dante/fisch/room/sandzentrum",
      M_GO+M_NOCHECK,
     "sich nach Westen", "wagt", "wagt sich herein");            
  
  return 1;	
       }

    
    write(BS(
    "Du willst nach Westen, doch eine unbekannte Macht haelt Dich auf! "
    "Erst wenn Du einige Aufgaben von Doby Mick geloest hast, darfst Du "
    "zum Kraken Tantalus vordringen."));
    return 1;


}


   
   int go_n()
     {
       
       NF("Du versuchst nach Norden zu gehen, bleibst aber im tiefen Sand stecken.\n"
       "Tja, dieser Fluchtweg scheint nicht zu klappen!\n");
       return 0;
    }
       
