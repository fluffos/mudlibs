//gang
//dante sl 99
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
 inherit "/d/dschungel/dante/fisch/room/gang_inh";
 
#define FACE (member(face, getuid(this_player()))!=-1)
       
   string *face=({});
 
 

 

create()
{
make_room();
  SetProp( P_INT_LONG, BS(
  "Der dunkle Gang wird hier flacher und scheint im Westen wieder "
  "ans Tageslicht zu gelangen. "
 "Die Waende sind aus rauhem Stein, geschaffen von einem "
  "unterirdischen Fluss, der hier vor sehr langer Zeit geflossen ist. "
  "Nun ist er aber schon seit langem versiegt und so kannst "
  "Du problemlos sein ehemaliges Flussbett betreten. "
  "Fackeln stecken in Spalten in den Waenden und spenden Dir "
  "genug Licht um Dich orientieren zu koennen. "
  "Von der Decke "
  "haengen duenne Schnuere herab, an die Knochen geknuepft sind. Ein "
  "schauriger Anblick! Wer sie hier wohl aufgehaengt hat?"));
  
  
ASE("westen", "check");

AE("suedosten", "./gang3");
AD("westen",
"Im Westen scheint es viel heller zu werden!!! Was mag da wohl liegen?!");
AD(({"tageslicht", "licht"}),
"Hier wird das schwache Licht der Fackeln durch das Licht der Sonne "
"vestaerkt!");
AD("sonne",
"Die Sonne scheint hier aus dem Westen herein!!!");
AD("form",
"Sieht wie ein grosser Schaedel aus!");

AD("boden",
"Im Boden entdeckst Du eine merkwuerdige Oeffnung!");
AD("oeffnung",
"Die Oeffnung hat die Form eines Schaedels!");
AD("schaedel",
"Hmm, seltsam. Was hat das zu bedeuten?! Hat es einen Sinn?!");
AD("sinn",
"Irgendwie haengt es sicher mit dem Ausgang im Westen zusammen!");
AD("ausgang",
"Der Ausgang im Westen kann nur verwendet werden, wenn man seinen "
"Schaedel in die Oeffnung steckt. Aber das koennte auch eine "
"Falle sein und Du Deinen Kopf dann auch los!!! Achtung: Anmerkung "
"des Autors: Es ist moeglich das Du hier stirbst!!! "
"syntax: <stecke schaedel in oeffnung>!");
AD("falle",
"Naja, man sollte diesem Magier nicht trauen, oder?!");
AD("magier",
"Aber so boesartig ist nicht mal Dante, oder! Wenn Du denkst er ist es doch, "
"so email ihm einfach und sag ihm das!");
AD("dante",
"Er hat dies hier erschaffen!");


ACD(({"stecke","steck"}), "kopf");
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kman", REFRESH_DESTRUCT);

}


int kopf(string str)  {
	NF("Was willst Du wo hinein stecken?! \n");

if(!str) return 0; 
	
	if(str=="schaedel in oeffnung")  {
	write(BS(
	"Du ueberlegst kurz und wagst es dann! Du steckst Deinen Schaedel "
	"mutig in die Oeffnung! Ploetzlich beginnt es zu knarren..."));
	say(BS(
	CAP_TPN+" steckt den Schaedel in die Oeffnung!!!"));
	
	if(FACE)   {
	write(BS(
	"Nichts passiert und Du nimmst Deinen Schaedel wieder heraus!"));
	say(BS("Nichts passiert!"));
	return 1; }
	
	if(!FACE)   {
 write(BS(
 "Die Oeffnung scheint sich zusammen zu ziehen und enger zu werden! "
 "Wird Dein Kopf nun zu Mus zerquetscht?!!! Schnell ziehst Du Deinen "
 "Kopf wieder heraus! Glueck gehabt, denn ploetzlich "
 "schnappt die Oeffnung schnell zu und geht dann wieder auf! Irgendwas "
 "scheint sich aber getan zu haben!!!"));
 face+= ({getuid(this_player())});    		
	say(BS(CAP_TPN+" erschrickt furchtbar, denn die Oeffnung wird "
	"enger und enger! "+TPN+" schreit auf und reisst den Kopf aus der Oeffnung "
	"schnell heraus!!!"));
	return 1; }
return 0; }
return 0; }
		
		


 int check()  {
	
	if(!FACE)   {
	write (BS("Du willst nach Westen gehen, doch ploetzlich wirst "
	"Du von einer unsichtbaren Macht aufgehalten!!! Irgendwie kommt man hier "
	"aber sicher weiter!!!")); 
	return 1; }
	
if(FACE)  {
	write(BS(
	"Du kannst ohne Probleme nach Westen gehen!"));
	
	 TPM("/d/dschungel/dante/fisch/kannibalen/room/fels1",M_GO,
	"nach Westen", "geht", "kommt aus der Hoehle im Westen heraus"); 
	return 1;}
}

			