
#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define Z write("\n\n"); 
#include <wizlevels.h>

#define NIX  if(environment(TP)!=TO || !TP) return 0;     
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Sturz den Wasserfall runter" );
  SetProp( P_INT_LONG, BS(
  "Du sitzt in Deiner Tonne und stuerzt Dich todesmutig den Wasserfall "
  "nach unten. Bete, dass die Tonne den Aufprall aushaelt und Du nicht "
  "als Fischfutter endest! Viel Glueck!"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no()
 {
   write (
"Bete lieber, dass Deine Tonne Dein mieses Leben rettet!\n");
   return 1;
   }
     

  init()
  {::init();

  if(query_once_interactive(this_player())){
  call_out("a1", 3);}
  }
  

  a1()
    {
    NIX
    Z
    write(BS(
    "SCHHHHHHHH!!!!!! Und ab geht es nach unten!"));
    call_out("a2", 3);
    }
    
   a2()
   {NIX
   Z
   write(BS(
   "Mitten im Wasserfall stuerzt Du ins Bodenlose! Bete um Dein Leben!"));
   call_out("a3", 3);
     }
 
 
    
   a3()
   {NIX
   Z
   write(BS(
   "SSSSSSSSSSSSSSSSSSSCCCCCCCCCCCCCCCCCCCCCCCHHHHHHHHHHHHHHHHHHHH!!!"
   "Wassermassen dringen in Deine Tonne ein! Du wirst Total nass!!!"));
   call_out("a4", 3);
     }
 
    
   a4()
   {NIX
   Z
   write(BS(
   "Die Tonne aechzt und knarrt. Das Wasser rauscht und schleudert Dich "
   "fast aus der Tonne. Gib Acht!"));
   call_out("a5", 3);
     }
    
   a5()
   {NIX
   Z
   write(BS(
   "Der Wasserfall scheint ja nie zu enden! Du hast Angst vor dem Aufprall!"));
   call_out("a6", 3);
     }
 
 
    
   a6()
   {NIX
   Z
   write(BS(
   "Das Toben und rauschen wird nun immer lauter. Der Aufprall naht!"));
   call_out("a7", 2);
     }
    
   a7()
   {NIX
   Z
   write(BS(
   "SSSSSSSSSSSSSSSSSSSSSSCCCCCCCCCCCCCCCCCCCCCCHHHHHHHHHHHHHHHHHHHHHH!!!"
   "Der Aufprall steht unmittelbar bevor!"));
   call_out("a8", 2);
     }
 
    
   a8()
   {NIX
   Z
   write(BS(
    "WWWWWWWWWWWWUUUUUUUUUUUUUUUUUUUUUUUUMMMMMMMMMMMMMMMMMMMMMMMMMMMMM!!!"
    "Du schlaegst mit enormer Wucht am Wasser auf!!!"));
   call_out("a9", 1);
     }
 
 
    
   a9()
   {NIX
   Z
   write(BS(
   "Deine Tonne explodiert und Du wirst bewusstlos!"));
   call_out("a10", 1);
     }
 
    
   a10()
   {NIX
   Z
   write(BS(
   "Irgendwie bekommst Du noch mit, dass Du durch die Wassermassen "
   "irgendwo hin geschleudert wirst. Dann Stille und Schwaerze um Dich!"));
    TP->move("d/dschungel/dante/fisch/room/fels", M_GO+M_SILENT+M_NO_SHOW);
     }
 
 
  
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/dante/fisch/room/nest",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  