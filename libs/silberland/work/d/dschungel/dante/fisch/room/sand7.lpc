//hier kann man auf die plattform rauf....

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"




int fische=0;
#define MAX 30
#define TI 0//2+random(4)


//AAAALLLEEE!!!!


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Westen und Norden. "
  "Im Sueden und Osten wird er durch den Fluss begrenzt. "
  "Hier spuert man direkt die Anwesenheit des Todes! "
  "Die Bruecke und eine kleine, aber doch aufaellige Plattform sind fast direkt ober Dir."));

AD("anwesenheit",
"Er steht direkt hinter Dir!");
AD("tod",
"Der Tod erwartet Dich!");

AD("osten",
"Im Osten rauscht der Fluss an Dir vorbei.");
AD("leiter",
"Die Leiter, die zur Bruecke fuehrt, liegt weiter im Norden.");
AD("bruecke",
"Die Bruecke liegt hoch ueber Dir im Osten. Direkt ueber Dir ist "
"eine kleine Plattform, die man von der Bruecke aus erkennen kann.");
AD("plattform",
"Sie scheint irgendwie zur Bruecke zu gehoeren. Sie besteht "
"ebenso aus Holz. Sie steht auf 6 dicken Pfaehlen.");
AD(({"pfahl","pfaehle"}),
"Die Pfaehle hat irgendjemand hier in den Sand gerammt und dann "
"sie Plattform oben hinauf gebaut.");

AD("holz",
"Das Holz scheint noch recht stabil zu sein. Eine Strickleiter "
"ist oben an der Plattform angebracht!");
AD("strickleiter",
"Schmal und wackelig, aber Dich traegt sie sicher noch.");


AD("norden",
"Im Norden liegt Sand und sehr weit dahinter begrenzen hohe Klippen die Sandbank.");
AD("westen",
"Im Westen liegt nur Sand und weit im Westen der Fluss und der Wasserfall.");
AD("wasser",
"Das Wasser hat hier eine starke Stroemung und ist tief!");
AD("stroemung",
"Hmm, hier scheint es ideal fuer Haie zu sein!");

AD("wasserfall",
"Der Wasserfall stuerzt sehr weit im Westen ueber eine enorm hohe Klippe. Er rauscht "
"extrem laut.");
AD(({"klippe", "klippen"}),
"Die Klippen liegen sehr weit im Norden.");
AD("sueden",
"Im Sueden fliesst der Fluss rauschend an Dir vorueber.");

AD("fluss",
"Der Fluss rauscht im Sueden und Osten an der Sandbank vorbei.");

AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt. ");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann...");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");

AD("sandbank",
"Die Sandbank erstreckt sich hier nach Westen und Norden.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");


AIT("d/dschungel/feyaria/felseninsel/npc/wsk", REFRESH_DESTRUCT);

AIT("/d/dschungel/dante/fisch/npc/gus", REFRESH_DESTRUCT);

   

ASE("nordwesten", "nix");
AE("norden", "./sand8");
AE("westen", "./sand6");

ACD(({"kletter","klettere"}), "go_up");

DO_ANGEL

ASD(({"hai","haie","fisch","fische"}), "get_info");

ACD(({"grab","grabe"}), "get_koeder");
}

int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
return 0; }
 




int do_angel()   {
	object oba, obb;
	obb=present("DANTE_ANGEL_FISCH", TP);
	oba=present("DANTE_ANGEL", TP);
	
if(present("fishingaction", TP))   {
	write("Aber Du angelst doch schon!!!\n");
	return 1; }
		
	
     if(!oba)  {
     	write("Du hast keine geeignete Angel!\n");
     	return 1; }

    if((oba) &&(!obb))  {
   	write(BS("Du wirfst Deine Angel gekonnt aus und wartest."));
   	call_out("fail", TI);
   	  oba->AddId("fishingaction");
   	say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
   	return 1; }

        if(obb)  {	   
     	write("Du wirfst Deine Angel gekonnt aus und wartest.\n");
        say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
        call_out("ok", TI);
        obb->AddId("fishingaction");
           return 1; }
        return 0; }
 
 
 //das hier muss sein damit die spieler nicht 100000000
 //fische erzeugen koennen
 reset()  {
 	::reset();
  fische=MAX;   }
  	
 
 
        
    fail()   {object ob;
    	ob=present("DANTE_ANGEL", TP);
    	if(ob)  {  
    	ob->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    else  {
    write(BS(
  "Du holst die Angel wieder ein, irgendetwas scheint nicht zu stimmen. "
  "Der Koeder, der Ort..."));
    return ; }
}

 
        
        
    ok()   {object obb, ob;
    	obb=present("DANTE_ANGEL_FISCH", TP);
    	if(obb)  {  
    	obb->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    		
    	if(fische>= MAX)  {
    		write(BS(
    "Du ziehst die Angel aus dem Wasser, das Gewaesser scheint "
    "leer gefischt zu sein. Warte ein wenig bitte!"));
    return ; }
    			
    		
    else  {
    write(BS(
"Irgendetwas zieht an Deiner Angel! Du reisst sie aus dem Wasser!"));

    switch(random(15))  {


      case 0: 
      write("Leider ist der Haken leer!\n"); return ;
      break;
    case 1..13:
    ob=clone_object("/d/dschungel/dante/fisch/obj/stdhai");
    break;
    case 14:
    write(BS(
    "Ein gigantischer Hai taucht auf und reisst Dich ins Wasser! "
    "Mit letzer Kraft schaffst Du es schnell wieder an den Strand zu fliehen!"));
    return;
    break;
 default:   ob=clone_object("/d/dschungel/dante/fisch/obj/stdhai");
}

fische++;
  write(BS("Ein Fisch zappelt am Haken! "
  ""+ob->short()+"Du nimmst den Fisch"
  " sofort vom Haken und steckst ihn ein!!!"));
  write("Dein Koeder scheint noch gut zu sein!!!\n");
  
  ob->move(TP, M_GET);
}

    }




string get_info() {
	switch(random(3)) {
case 0: write(BS("Ein Hai scheint gerade einen anderen Fisch zu zerreisen!"));
break;
case 1: write(BS("Du glaubst einen Hai im Wasser zu erkennen."));
break;
case 2: write(BS("Das Wasser fliesst zu schnell, als das man etwas erkennen kann."));
break;
default: write(BS("Du glaubst einen Hai im Wasser zu entdecken!"));
}}
		

   int go_up(string str)  {
   	NF("Tip: syntax <kletter mit strickleiter/leiter rauf>\n");
   	
  if(member(({"mit strickleiter rauf", "mit leiter rauf"}),str)!=-1)   {   	

   	write("Du kletterst mit der Strickleiter nach oben.\n");
   	
   TPM("d/dschungel/dante/fisch/room/jump", M_GO,
   "mit einer Strickleiter nach oben", "klettert",
    "kommt heraufgeklettert");
    return 1;   }
   return 0;  }
   

int nix()
  {
NF("Du bleibst im tiefen Sand stecken!\n");
return 0; }