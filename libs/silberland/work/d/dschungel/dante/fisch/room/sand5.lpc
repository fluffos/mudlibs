///weg/room/bruecke2.c
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Osten und Norden. "
  "Im Westen und Sueden rauscht der Fluss vorbei. Du fuehlst Dich "
  "hier gar nicht mehr wohl...")); 



AD("osten",
"Im Osten liegt Sand und hoch in der Luft die Bruecke.");
AD("leiter",
"Die Leiter liegt schon weit im Osten.");
AD("bruecke",
"Die liegt hoch ueber Dir im Osten.");

AD("norden",
"Im Norden liegt Sand und dahinter begrenzen hohe Klippen die Sandbank.");
AD("westen",
"Im Westen und Sueden liegt der Fluss und noch weiter im Westen den Wasserfall.");
AD("wasser",
"Das Wasser des Fluss rauscht an Dir vorueber.");
AD("wasserfall",
"Der Wasserfall stuerzt im Westen ueber eine enorm hohe Klippe. Er rauscht "
"extrem laut. Von hier aus ist es gar nicht soweit zum Wasserfall. "
"Wenn man genau schaut, erkennt man sogar einen grossen Felsen, der "
"etwas abseits vom Wasserfall liegt.");
AD("felsen",
"Der Felsen wird nicht direkt vom Wasser getroffen, obwohl er sicher sehr "
"rutschig ist. Hmm, ob man da wohl hinschwimmen kann?");
AD(({"klippe", "klippen"}),
"Die Klippen liegen  weit im Norden. Im Westen liegt der Fluss und "
 "ein Wasserfall stuerzt ueber eine enorm hohe Klippe.");
AD("sueden",
"Im Sueden fliesst der Fluss.");

AD("fluss",
"Der Fluss rauscht im Westen und Sueden an der Sandbank vorbei.");

AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt. ");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann...");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");

AD("sandbank",
"Die Sandbank erstreckt sich hier nach Osten und Norden.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");

ACD(({"schwimm", "schwimme"}), "swim");
ASE("nordosten", "nix");
AE("norden", "./sand4");
AE("osten", "./sand6");

DO_ANGEL



AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_AGGRESSIVE: 0.5,
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   


AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_AGGRESSIVE: 1,
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   

AIT("d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 15, 30, 10}),
     P_AGGRESSIVE: 0.3,
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand3"]) );
   
ACD(({"grab","grabe"}), "get_koeder");
}

int nix()
  {
NF("Du bleibst im tiefen Sand stecken!\n");
return 0; }
int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   if ( (!present("DANTE_FISCH_LISTE", TP)) ||
        (deep_present("muschel", TP))||
        (deep_present("DANTE_ANGEL_MUSCHEL", TP))  )  

          {
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
  else  {
  	ob=clone_object(FO"muschel");
  	ob->move(TP, M_NOCHECK);
  write(BS(
  "Du findest eine Muschel, die Du sofort einsteckst."));
     return 1; }
  return 0; }
return 0; }
  	
  

int swim(string str)  {
 NF("Wohin willst Du schwimmen?!\n");

if(!present("DANTE_FISCH_LISTE", TP))   {
  write("Du kannst nirgendwo hinschwimmen. Geh zuerst zu Doby Mick!\n");
   return 1; }  
  if(str=="zu felsen"||str=="zum felsen")  {
    write("Du wagst es und stuerzt Dich in die Fluten!\n"
    "Die Stroemung ist stark, doch Du schaffst es bis zum glitschigen Felsen!\n");
    say(CAP_TPN+" springt ins Wasser!\n");
    TPM("/d/dschungel/dante/fisch/room/fels2",M_GO,
    "bis zu einem Felsen", "schwimmt", "kommt auf den Felsen gestiegen!\n");
    return 1; }
    return 0; }
       
  

  int do_angel()   {
  write (BS(
  "Hier ist kein geeigneter Platz zum Angeln! Versuch es woanders!")); 
  return 1;
  }
   