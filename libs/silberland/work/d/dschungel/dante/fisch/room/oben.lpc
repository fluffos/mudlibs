//dante sl

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"


#define SPEED (member(speed, getuid(this_player()))!=-1)
 string *speed=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hoch ueber den Klippen" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun auf einem sehr schmalen Vorsprung hoch ueber "
  "den Klippen. Hinter Dir geht die Felswand steil nach oben, vor "
  "Dir geht es senkrecht nach unten. Unter Dir liegt der Strand. "
  "Vielleicht kann man ja im Westen oder Osten irgendwie weiter gelangen."));
  
  AD("decke",
  "Himmel.");
  AD("himmel",
  "Der Himmel scheint hier sehr nahe zu sein, doch das taeuscht nur.");
  
  AD("vorsprung",
  "Der Vorsprung ist recht schmal, aber doch recht lang.");
  AD(({"klippe","klippen"}),
  "Die Klippen sind hier besonders steil. Nach oben kannst Du hier "
  "sicher nicht klettern. Nach unten sehr wohl!");
  AD(({"wand","waende","felswand","felswaende"}),
  "Die Felswaende sind schroff und sehr hart. Sie fallen steil ab "
  "zum Strand. Hinter Dir geht es senkrecht nach oben.");
  AD("fluss",
  "Von hier sieht der Fluss sehr imposant aus! Scheinbar "
  "spiegelt sich da Etwas im Fluss?!");
  AD("etwas",
  "Das Etwas scheint eine Truhe zu sein.");
  AD("truhe",
  "Die Truhe, die sich da im Fluss spiegelt, muss neben Dir stehen. Ganz in Deiner Naehe!");
  AD("naehe",
  "Ja, wirklich! Da steht die Truhe! Nein, eher ist es ja eine Kiste!");
  AD("kiste",
  "Hmm, die Kiste ist extrem schwer. Scheinbar geht sie auch nicht auf. Verzweiflung "
  "kommt bei Dir auf.");
  AD("verzweiflung",
  "Ach was, schau Dir doch lieber mal die Sonne an.");
  AD("sonne",
  "Hmm, die Sonne ist schuld daran, dass sich die Kiste/Truhe ueberhaupt "
  "im Fluss spiegeln kann. Klar oder? Vielleicht solltest "
  "Du Dir die Rillen ansehen, die ueberall im Fels sind.");
  AD(({"rille","rillen"}),
  "Die Rillen sind langweilig und Dir wird es. Hmm, untersuch doch "
  "mal den Buckel da am Boden.");
  AD("buckel",
  "Du untersuchst Dir einen Buckel am Buckel, findest aber nichts. Deine "
  "Wirbelsaeule schmerzt.");
  ASD("wirbelsaeule", "get_zahn");
  
     
  AD("wasser",
  "Das Wasser leuchtet hell und ist sehr gruen.");
  AD("wasserfall",
  "Er liegt weiter oben am Fluss. Man sieht ihn von hier recht gut. "
  "Beeindruckend wie das Wasser herabstuerzt. He! Fliegt da nicht "
  "gerade eine Tonne den Wasserfall herab?!");
  AD("tonne",
  "Hmm, ja es ist eine Tonne!");
  AD("strand",
  "Der Strand sieht von hier oben sehr schoen aus. Flach, gleichmaessig, "
  "fast idyllisch.");
  AD("westen",
  "Im Westen liegt ein sehr schmaler Grat. Ob es klug ist, ihn "
  "zu benutzen...");
  AD("osten",
  "Nach Osten fuehrt ein schmaler, teils eingestuerzter Grat. "
  "Ueberhaupt scheint kein Weg mehr dahin zu fuehren!!!");
  AD("grat",
  "Sowohl nach Osten als auch nach Westen konnte man frueher einmal "
  "gehen, doch nun ist der Grat eingestuerzt. Naja, vielleicht kommt "
  "man ja irgendwie noch nach Westen!");
  AD("boden",
  "Der Boden besteht aus Fels. Viel ist hier davon nicht da.");
AD("fels",
"Der Fels ist recht glatt, fast zu glatt.");  
  
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
AddSpecialExit("westen", "go_down");
ACD(({"spring", "springe"}), "jump");

ACD(({"nimm", "nehme"}), "get_speed");
ASE("osten", "go_down");

ACD(({"kletter", "klettere"}), "up");

AIT("/d/dschungel/dante/weg/npc/rvogel", REFRESH_DESTRUCT);
AIT("/d/dschungel/dante/weg/npc/rvogel", REFRESH_DESTRUCT);
}


string get_zahn()  {
	object ob;

  
   if(!deep_present("DANTE_FISCH_LISTE_ZWEI", TP))  {
   	write(BS(
   "Naja, Du bist eben schon alt."));
            }
  
  if(deep_present("HAIZAHN", TP))  {
  	write(BS(
  "Ein Haizahn genuegt doch..."));
      }
   if(deep_present("DANTE_FISCH_LISTE_ZWEI", TP))  {
  
   
 
  	ob=CLONEOB("/d/dschungel/dante/fisch/obj/haizahn");
  	ob->move(TP, M_NOCHECK);
  write(BSA(
  "Du alter Depp, Piet! Schoen langsam habe ich Mitleid mit Dir! "
  "Warte eine Sekunde, gleich kommt ein Bote mit einem Haizahn vorbei!",
  "Doby Mick teilt Dir mit: "));
  write("\nEin Haikondor segelt herein, wirft Dir einen Haizahn zu, und "
  "segelt eiligst wieder davon! COOL!!!\n");
}
return "";
}

  

	
get_speed(string str)   {

NF("Was willst Du nehmen?!\n");
   if(str=="anlauf")  {
          if(SPEED)   {
          write("Wieviel Anlauf noch?!\n");
          say(CAP_TPN+" holt schon wieder Anlauf!\n");
          return 1; }
          
          if(!SPEED)   {
          write("Du nimmst Anlauf. Nun gehts aber los!\n");
          say(CAP_TPN+" nimmt grossen Anlauf!\n");
          speed += ({getuid(this_player())});   
          
          call_out("anlauf_weg", 10);
          return 1;
          }
          return 0;  }
          return 0; }
          
anlauf_weg()   {
if(!SPEED) return ;
          speed -= ({getuid(this_player())});   
write("Der positive Effekt Deines Anlaufs ist weg!\n");
 }
 






int up(string str)  {
   NF("Wo willst Du hin klettern?\n");
if(str=="klippe runter"||str=="klippen nach unten" ||str=="nach unten")   {

   write("Du kletterst die Klippe runter.\n");
   TPM("/d/dschungel/dante/fisch/room/sand1", M_GO, 
   "die Klippe runter", "klettert", "kommt hereingeklettert");
   return 1; }
   return 0; }





go_down()  {
 write(BS("Du Idiot willst den Grat entlang gehen! Der schmale Grat ist aber "
"eingestuerzt. Also stuerzt Du nach unten in die Tiefe und wirst "
"dort zu Brei! In Zukunft besser untersuchen!"));
 say(CAP_TPN+" stuerzt in die Tiefe und zerplatzt dort fast!\n");

 TPM("d/dschungel/dante/fisch/room/sand1", M_GO+M_NO_SHOW,
 "in die Tiefe", "stuerzt", "stuerzt von oben herab");

 write("Du hast Glueck, der weiche Sand daempft Deinen Sturz ab!\n");
 say(CAP_TPN+" hat grosses Glueck. " 
 "Der Sand bremst "+TP->name(WESSEN)+" Sturz ab!\n");
 TP->do_damage(10+random(10));
 return 1 ;   }
 
 





int jump(string str)  {
   NF("Wo willst Du hinspringen?\n");
   if(!str) return 0;
   
   
if(str=="nach westen"||str=="westwaerts"||str="nach w"||
str=="westen"||str=="w")   {



if(SPEED)   {
             speed -= ({getuid(this_player())});   
   write("Du springst nach Westen.\n");
   TPM("/d/dschungel/dante/fisch/room/oben2", M_GO, 
   "nach Westen", "springt", "kommt hereingesprungen");
   return 1; }

if(!SPEED)   {
       write(BS(
       "Du versuchst nach Westen zu springen, doch Du bist zu langsam. "
       "Hmm, Anlauf waere gut..."));
       say(CAP_TPN+" schafft es nicht nach Westen zu springen!\n");
       return 1; }
   return 0; }
   return 0; }