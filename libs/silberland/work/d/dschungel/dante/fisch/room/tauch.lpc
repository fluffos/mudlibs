/*dante sl 98 99
hier sauft man leicht ab...
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

#define NIX  if(environment(TP)!=TO || !TP) return 0;     


init()  {
  ::init();
  if(interactive(TP)){
  call_out("a1", 10);  }}



create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Unterwassertunnel" );
  SetProp( P_INT_LONG, BS(
  "Nun bist Du in die dunkle Oeffnung getaucht und findest "
  "Dich in einem stockdunklen Unterwassertunnel wieder. Hier kommt kein Licht her. Nie! "
  "Das Wasser ist tiefschwarz, wie alles andere auch. Kurz gesagt, "
  "Du siehst hier ueberhaupt nichts. Und langsam, aber sicher, wird Dir "
  "Der Sauerstoff knapp. Nebenbei bemerkt, hier kann Dir auch "
  "kein sonst vielleicht nuetzliches Hilfsmittel helfen. Also, schau zu, dass "
  "Du schnell hier wieder rauskommst!"));
  
     
  SetProp( P_LIGHT, -20);
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Es ist totenstill.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht verwest.");


SP(P_KILL_NAME, "Ein Unterwassertunnel und zu wenig Sauerstoff");
ACD(({"hole", "hol", "atme"}), "get_air");
ACD(({"tauche", "tauch"}), "go_out");
ACD(({"schwimm","schwimme"}), "nix", 1);



AIT("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);
AIT("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);
}


int nix()  {
write(BS(
	"Du schwimmst verzweifelt umher, siehst aber leider ueberhaupt nichts. MIST!!!"));
return 1; }

BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/dante/fisch/room/fels",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}



  a1()
    {
    NIX
    write(BS(
   "Du solltest hier schnell verschwinden, denn Deine Luft wird knapp!"));
    call_out("a2", 10);
    }
      
 
  a2()
    {
    NIX
    write(BS(
    "Du solltest besser raustauchen! Du stirbst sonst!"));
    call_out("a3", 10);
    }
      
      
      
      
  a3()
    {
    NIX
    write(BS(
    "Deine Luft geht bald zu Ende! Hau ab!!!"));
    call_out("a4", 10);
    }
      
 
  a4()
    {
    NIX
    write(BS(
   "Deine Luft geht zu Ende! Tauch raus!"));
    call_out("a5", 10);
    }
      
 
      
  a5()
    {
    NIX
    write(BS(
   "Deine Luft geht zu Ende! Du erstickt elendiglich!!!"));
    TP->do_damage(1000);
    }
      
 
      
      
      
      
int get_air(string str)  {
       NF("Was willst Du atmen/holen?\n");
     if(str=="luft"||str=="luft ein" ||
     str=="luft tief ein"||str=="tief luft ein")   {
      write("Unter Wasser atmen geht selten, hier aber sicher nicht!\n"
      "Du solltest raustauchen und zwar schnell!!!\n");
      return 1; }
     return 0; }
      


int go_out(string str)   {
      NF("Du willst doch raus tauchen?!\n");
     if (str=="raus"||str=="hinaus"||str=="aus loch"||str=="aus tunnel")  {
     write("Du tauchst wieder aus dem dunklen Tunnel raus! Gut so!\n");
     TPM("/d/dschungel/dante/fisch/room/fels", M_GO,
     "raus", "taucht",
     "kommt aus dem Loch herausgetaucht");
     return 1; }
     return 0; }
                   