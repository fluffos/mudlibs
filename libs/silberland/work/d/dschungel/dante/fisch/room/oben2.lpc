//dante sl 99

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"

#define SPEED (member(speed, getuid(this_player()))!=-1)
 string *speed=({});

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hoch ueber den Klippen" );
  SetProp( P_INT_LONG, BS(
"Der Vorsprung in der Felswand auf dem Du nun stehst, ist um "
"nichts breiter als der im Osten. Sehr schmall, aber recht lang. "
"Die Klippen steigen auch hier enorm steil auf, wenn auch vielleicht "
"nicht ganz so steil wie sonst. Dafuer fallen sie um so tiefer und steiler "
"nach unten zum Strand hin ab! "
"Der Grat fuehrt hier nach Osten und Westen weiter."));
  
  AD("decke",
  "Himmel.");
  AD("himmel",
  "Der Himmel scheint hier sehr nahe zu sein, doch das taeuscht nur.");
  
  AD("vorsprung",
  "Der Vorsprung ist recht schmal, aber doch recht lang.");
  AD(({"klippe","klippen"}),
"Die Klippen fallen hier enorm steil nach unten ab. Nach oben "
"koennte man unter Umstaenden klettern.");
AD(({"umstaende","umstaenden"}),
"Es geht sicher, oder doch nicht...");

  AD(({"wand","waende","felswand","felswaende"}),
  "Die Felswaende sind schroff und sehr hart. Sie fallen steil ab "
  "zum Strand. Hinter Dir geht es aber nicht ganz so steil nach oben! Kletter rauf!");
  AD("fluss",
  "Von hier sieht der Fluss extrem imposant aus!");
  AD("wasser",
  "Das Wasser leuchtet hell und ist sehr gruen. Teilweise aber auch blau.");
  AD("wasserfall",
  "Er liegt weiter oben am Fluss. Man sieht ihn von hier recht gut. "
  "Beeindruckend wie das Wasser herabstuerzt. He! Fliegt da nicht "
  "gerade Dante den Wasserfall herab?!");
  AD("dante",
  "JA! Es ist der volltrunkene Dante der den Wasserfall herabfaellt und laut groellt!");
  
  AD("strand",
  "Der Strand sieht von hier oben sehr schoen aus. Flach, gleichmaessig, "
  "fast idyllisch.");
  AD("westen",
 "Der Grat im Westen ist total eingestuerzt! Niemals kommt man da hin!");
  AD("osten",
"Der Grat ist zwar eingestuerzt, aber man kann hin springen!");
  AD("grat",
  "Sowohl nach Osten als auch nach Westen konnte man frueher einmal "
  "gehen, doch nun ist der Grat eingestuerzt. Nach Westen scheint man "
  "nicht zu gelangen! Nach Osten kann man springen.");
  AD("boden",
  "Der Boden ist hier weicher und teils aus Erde und teils aus Fels.");
AD("fels",
"Der Fels ist recht glatt, fast zu glatt.");  
  AD("erde",
  "Die Erde ist scheinbar weich und feucht. Ah! Da steht ja sogar ein "
  "kleiner Baum.");
  AD("baum",
  "Einsam und verlassen trotzt er allen Winden!");
  AD(({"wind","winden","winde"}),
  "Der Wind schuettelt ihn oft wild hin und her. Sollte man es dem "
  "Wind gleichtun?!");
  
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
ACD(({"spring", "springe"}), "jump");
ACD(({"nimm", "nehme"}), "get_speed");
ACD(({"kletter", "klettere"}), "up");

ACD(({"schuettle","schuettel"}), "get_hai");



AIT("d/dschungel/dante/hoehle/npc/dviper", REFRESH_DESTRUCT);
   
ASE("osten", "down");
ASE("westen", "down");
SP(P_KILL_NAME, "Dummheit und die Schwerkraft");
}


int get_hai(string str)  {
	object ob;
	NF("Was willst Du schuetteln?!\n");
	if(!str) return 0;
   if(str=="baum"||str=="an baum"||str=="am baum")  {
    write(BS(
    "Du schuettelst den Baum."));
    say(BS(
    CAP_TPN+" macht sich am Baum zu schaffen."));
  
   if(!deep_present("DANTE_FISCH_LISTE_ZWEI", TP))  {
   	write(BS(
   "Nichts passiert."));
   return 1; }
  
  if(deep_present("STEINHAI", TP))  {
  	write(BS(
  "Ein versteinerter Hai genuegt doch..."));
  return 1; }
  else {
 
  	ob=CLONEOB(FO"stoneh");
  	ob->move(TP, M_NOCHECK);
  write(BS(
  "Ein versteinerter, kleiner Hai faellt heraus. Du steckst ihn ein."));
  return 1; }
 return 0; }
 return 0; }
  		 	 
    		

get_speed(string str)   {

NF("Was willst Du nehmen?!\n");
   if(str=="anlauf")  {
          if(SPEED)   {
          write("Wieviel Anlauf noch?!\n");
          say(CAP_TPN+" holt schon wieder Anlauf!\n");
          return 1; }
          
          if(!SPEED)   {
          write("Du nimmst Anlauf. Nun gehts aber los!\n");
          say(CAP_TPN+" nimmt grossen Anlauf!\n");
          speed += ({getuid(this_player())});   
          
          call_out("anlauf_weg", 10);
          return 1;
          }
          return 0;  }
          return 0; }
          
anlauf_weg()   {
if(!SPEED) return ;
          speed -= ({getuid(this_player())});
write("Der positive Effekt Deines Anlaufs ist weg!\n");
 }
 





down()  {
 write(BS("Du Idiot willst den Grat weitergehen! Der schmale Grat ist aber "
"eingestuerzt. Also stuerzt Du nach unten in die Tiefe und wirst "
"dort zu Brei! In Zukunft MITDENKEN!!!"));
 say(CAP_TPN+" stuerzt in die Tiefe und zerplatzt dort fast!\n");
 TPM("d/dschungel/dante/fisch/room/sand1", M_GO+M_NO_SHOW,
 "in die Tiefe", "stuerzt", "stuerzt von oben herab");
 write("Du hast Glueck, der weiche Sand daempft Deinen Sturz ab!\n");
 say(CAP_TPN+" hat grosses Glueck. " 
 "Der Sand bremst "+TP->name(WESSEN)+" Sturz ab!\n");
 TP->do_damage(10+random(10));
 return 1 ;   }
 
 


int up(string str)  {
   NF("Wo willst Du hin klettern?\n");
if(str=="klippe rauf"||str=="klippen nach oben" ||str=="nach oben"||
str=="rauf"||str=="hinauf")   {

   write("Du kletterst die Klippe rauf.\n");
   TPM("/d/dschungel/dante/fisch/room/oben3", M_GO, 
   "die Klippe rauf", "klettert", "kommt hereingeklettert");
   return 1; }
   return 0; }








int jump(string str)  {
   NF("Wo willst Du hinspringen?\n");

if(!str) return 0; 
if(str=="nach osten"||str=="ostwaerts"||str=="nach o"||
str=="osten")   {



if(SPEED)   {
             speed -= ({getuid(this_player())});
   write("Du springst nach Osten.\n");
   TPM("/d/dschungel/dante/fisch/room/oben", M_GO, 
   "nach Osten", "springt", "kommt hereingesprungen");
   return 1; }

if(!SPEED)   {
       write(BS(
       "Du versuchst nach Osten zu springen, doch Du bist zu langsam. "
       "Hmm, Anlauf waere gut..."));
       say(CAP_TPN+" schafft es nicht nach Osten zu springen!\n");
       return 1; }
   return 0; }
   return 0; }




       
