//gang
//dante sl 99
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

 inherit "/d/dschungel/dante/fisch/room/gang_inh";
 

create()
{
make_room();
 SetProp( P_INT_LONG, BS(
  "Ein dunkler Gang fuehrt hier steil von Suedosten nach Nordwesten "
  "hinauf. Die Waende sind aus rauhem Stein, geschaffen von einem "
  "unterirdischen Fluss, der hier vor sehr langer Zeit geflossen ist. "
  "Nun ist er aber schon seit langem versiegt und so kannst "
  "Du problemlos sein ehemaliges Flussbett betreten. "
  "Fackeln stecken in Spalten in den Waenden und spenden Dir "
  "genug Licht um Dich orientieren zu koennen. "
  "Von der Decke "
  "haengen duenne Schnuere herab, an die Knochen geknuepft sind. Ein "
  "schauriger Anblick! Wer sie hier wohl aufgehaengt hat? "
  "Durch das Loch, durch das Du hier hereingeklettert bist, kannst "
  "Du auch wieder hinaus auf den Strand klettern."));

  AD("loch",
  "Du kannst durch das Loch rausklettern.");
  
AE("nordwesten", "./gang2");
AIT("/d/dschungel/dante/fisch/kannibalen/npc/kman", REFRESH_DESTRUCT);
ACD(({"kletter", "klettere"}), "hoehle");
}

int hoehle(string str)  {
   NF("Wo willst Du hinein klettern?\n");
if(str=="aus loch"||str=="aus loch hinaus"||str=="raus"||str=="aus loch hinaus"||str=="durch loch"||str=="durch loch raus")   {
   
   write("Du kletterst aus dem schwarzen Loch raus.\n");
   TPM("/d/dschungel/dante/fisch/room/sand3", M_GO, 
   "aus dem schwarzen Loch", "klettert", "kommt hereingeklettert");
   return 1; }
   return 0; }
   
