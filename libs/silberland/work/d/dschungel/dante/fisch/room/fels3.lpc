inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

int fische=0;
#define MAX 30
#define TI  0   //2+random(4)

/*
hier GROSSE FISCHE usw
*/



#define Z write("\n");


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsen mitten im Fluss" );
  SetProp( P_INT_LONG, BS(
  "Dieser Felsen hier ist nicht so rutschig und auch nicht so nass. "
  "Der Fluss ist hier viel ruhiger und das Wasser fliesst mittel stark "
  "und glucksend an Dir vorueber. Die wilde Stroemung die der Wasserfall "
  "erzeugt, scheint hier nicht zu wirken. Direkt im Norden stosst "
  "der Fluss an die hohen Klippen, im Suedwesten liegt der Wasserfall "
  "und weit im Osten der Strand. Der Felsen von dem Du gekommen bist, "
  "liegt im Sueden von hier. Zum Strand und zu dem anderen Felsen "
  "kannst Du muehelos schwimmen."));


AD("suedwesten",
"Im Suedwesten liegt der grosse Wasserfall.");
AD("wasserfall",
"Der Wasserfall rauscht gigantisch herab und erfuellt den Fluss mit neuem Leben.");
AD("leben",
"Untersuch mal den Fluss genauer. Da leben viele Fische!");


AD("sueden",
"Dort ist der andere Felsen!");

AD(({"anderer felsen","anderer fels"}),
"Dorthin kannst Du schwimmen.");

AD("osten",
"Da ist der Strand.");
AD("strand",
"Zu dem kannst Du schwimmen.");

AD("norden",
"Im Norden ragen die Klippen direkt vom Wasser nach oben.");
AD(({"klippe","klippen"}),
"Die Klippen wachsen direkt aus dem Fluss heraus.");

AD("felsen",
"Der Felsen liegt schon etwas noerdlich vom Wasserfall und daher ist "
"der Fluss hier auch viel ruhiger.");
AD("fluss",
"Der Fluss ist hier recht ruhig, scheint aber enorm tief zu sein.");
AD("wasser",
"Das Wasser ist hier angenehm ruhig und doch fliesst es. "
"Man koennte sagen die Stroemung ist mittel. Der Grund ist nicht zu sehen, "
"denn der Fluss ist hier angeblich tief!!!");



AD("grund",
"Nicht zu sehen!");
AD(({"decke","himmel"}),
"Blau, tief blau.");
AD("boden",
"Der Boden des Felsens ist hier trocken.");
AD(({"wand","waende"}),
"Die Waende sind hier nicht hier!!!");

AD("stroemung",
"Sie ist mittelmaessig stark.");


     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );



//aendern in ruhig und tief usw



SHOW_FISCH








  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht hier nicht ganz so laut.");
    AddSound("wasserfall",
    "Wummmm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
AddSmell("luft",
"Nass.");

DO_ANGEL





AIT("d/dschungel/feyaria/felseninsel/npc/wsk", REFRESH_DESTRUCT);
   


ACD(({"schwimm", "schwimme"}), "swim");
}

int do_angel()   {
	object oba, obb;
	obb=present("DANTE_ANGEL_KREBS", TP);
	oba=present("DANTE_ANGEL", TP);
	
if(present("fishingaction", TP))   {
	write("Aber Du angelst doch schon!!!\n");
	return 1; }
		
	
     if(!oba)  {
     	write("Du hast keine geeignete Angel!\n");
     	return 1; }

    if((oba) &&(!obb))  {
   	write(BS("Du wirfst Deine Angel gekonnt aus und wartest."));
   	call_out("fail", TI);
   	  oba->AddId("fishingaction");
   	say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
   	return 1; }

        if(obb)  {	   
     	write("Du wirfst Deine Angel gekonnt aus und wartest.\n");
        say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
        call_out("ok", TI);
        obb->AddId("fishingaction");
           return 1; }
        return 0; }
 
 
 //das hier muss sein damit die spieler nicht 100000000
 //fische erzeugen koennen
 reset()  {
 	::reset();
  fische=MAX;   }
  	
 
 
        
    fail()   {object ob;
    	ob=present("DANTE_ANGEL", TP);
    	if(ob)  {  
    	ob->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    else  {
    write(BS(
  "Du holst die Angel wieder ein, irgendetwas scheint nicht zu stimmen. "
  "Der Koeder, der Ort..."));
    return ; }
}

 
        
        
    ok()   {object obb, ob;
    	obb=present("DANTE_ANGEL_KREBS", TP);
    	if(obb)  {  
    	obb->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    		
    	if(fische>= MAX)  {
    		write(BS(
    "Du ziehst die Angel aus dem Wasser, das Gewaesser scheint "
    "leer gefischt zu sein. Warte ein wenig bitte!"));
    return ; }
    			
    		
    else  {
    write(BS(
"Irgendetwas zieht an Deiner Angel! Du reisst sie aus dem Wasser!"));
    
    switch(random(22))  {
/*
  "Ein grosser Thunfisch",!
   "Ein Silberbarsch",!
     "Ein Zackenbarsch",!
     "Ein Alligatorbarsch",!
   "Ein Kannibalenbarsch",!
   "Ein Kannibalenhecht",!
   
  "Ein Seeteufel",!
  "Ein Seewolf",!
   "Ein Saegefisch",!
    "Ein Kabeljau",!
   "Ein Palmendorsch",!
   "Ein Schwertfisch", !
   "Ein Haiwels",!alle welse da!!!
   "Ein Bartelwels",
   "Ein Grundelwels",
   "Ein Panzerwels",
   "Ein Silberwels",
   "Ein Midaswels",
   "Ein Bodenwels",
    "Ein Tijarawels",
   "Ein Schlammwels",
   "Ein Wuehlwels",!alle da
   "Ein Silberwels",!!!
*/

      case 0: 
      write("Leider ist der Haken leer!\n"); return ;
      break;
    case 1..4:
    ob=clone_object("/d/dschungel/dante/fisch/obj/stdbarsch");
    break;
    case 5..14:
     ob=clone_object("/d/dschungel/dante/fisch/obj/stdwels");
     break;
     case 15:
      ob=clone_object("/d/dschungel/dante/fisch/obj/schwert");
      break;
     case 16: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/seewolf");
     break;
       case 17: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/seeteuf");
     break;
       case 18: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/dorsch");
     break;
       case 19: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/kjau");
     break;
       case 20: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/thun");
     break;
      case 21: 
      ob=clone_object("/d/dschungel/dante/fisch/obj/saegefisch");
     break;     
      default:   ob=clone_object("/d/dschungel/dante/fisch/obj/stdwels");
}

fische++;
  write(BS("Ein Fisch zappelt am Haken! "
  ""+ob->short()+"Du nimmst den Fisch"
  " sofort vom Haken und steckst ihn ein!!!"));
  write("Dein Koeder scheint noch gut zu sein!!!\n");
  
//der koeder bleibt absichtlich gut wuerde die spieler nur nerven
//dauernd koeder raufstecken und sammeln zu muessen!!!!
  ob->move(TP, M_GET);
}

    }



//GROSSE fische hier rein!!!!!!!!!!!!!!!!!!

    
 string show_fisch()   {
    switch(random(7))   {
    case 0:
    write("Du glaubst fuer den Bruchteil einer Sekunde einen Wels zu sehen!\n");
    break;
    case 1:
    write("Ein grosser Fisch springt gerade wild durch das Wasser!\n");
    break;
    case 3:
    write("Im Moment siehst Du leider keinen Fisch!\n");
    break;
    case 4:
    write("Du glaubst einen sehr grossen Fisch zu sehen!\n");
    break;
    case 5:
    write("Die Sprudel sind momentan zu stark!\n");
    break;
    case 6:
    write("Du glaubst einen Hecht zu sehen!\n");
    break;
    default: write("Du siehst einen grossen Fisch!!!\n");}
     return"";}
    
 
int swim(string str)  {
 NF("Wohin willst Du schwimmen?!\n");

  if(str=="zum strand"||str=="zu strand"||
  str=="zum sandstrand"||str=="zu sandstrand")  {
   write(BS(
   "Du springst ins Wasser und schwimmst mit der Stroemung sehr schnell "
   "zum Strand zurueck!"));Z
    say(CAP_TPN+" springt ins Wasser!\n");
    TPM("/d/dschungel/dante/fisch/room/sand3",M_GO,
    "bis zum Strand zurueck", "schwimmt", "kommt aus dem Wasser gestiegen");
    return 1; }
    
    if(str=="zu fels"||str=="zum felsen")  {
	write("Du stuerzt Dich ins Wasser und schwimmst zum anderen Felsen");
TPM("/d/dschungel/dante/fisch/room/fels2", M_GO,
"zum anderen Felsen","schwimmt","kommt heraufgeklettert");
   return 1;  }
   	
    
    return 0; }
       
