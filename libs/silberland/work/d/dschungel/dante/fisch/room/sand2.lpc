//hier lebt die krake wenn sie an land ist....aufstieg per leiter nach
///weg/room/bruecke2.c
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Sandstrand" );
  SetProp( P_INT_LONG, BS(
  "Der Sandstrand erstreckt sich hier nach Westen, Sueden und Osten. " 
  "Im Norden wird er durch hohe Klippen begrenzt. Die Bruecke mit der "
  "rettenden Leiter liegt etwas weiter im Osten."));



AD("osten",
"Im Osten liegt Sand und hoch in der Luft die Bruecke.");
AD("leiter",
"Die Leiter liegt schon etwas weiter im Osten.");
AD("bruecke",
"Die liegt hoch ueber Dir im Osten.");

AD("norden",
"Im Norden begrenzen hohe Klippen die Sandbank. Du erkennst "
"eine gigantische Zeichnung. Darunter sieht man eine Schrift.");
AD("schrift",
"Irgendjemand hat sie hier eingemeiselt. Lies sie! ");
AddReadDetail("schrift",
"\nAlle heiligen Zeiten beschwoeren wir die\n"
"gigantische Krake TANTALUS, um ihr grausige\n"
"Opfer zu bringen.\n"
"Dieses Jahr hat unsere Kannibalenpriester\n"
"jemanden ganz besonderen auserwaehlt:\n"
"               DICH                  \n"
"Wehre Dich nicht, denn Du bist verdammmt!\n");

AD("zeichung",
"Die Zeichnung stellt eine gigantische Krake dar.");
AD("krake",
"Sie ist fast so hoch wie die Klippen und hat enorm viele Tentakel.");
AD("tentakel",
"Die Tentakel bilden hier ein Muster.");
AD("muster",
"Das Muster stellt abstrakt einen Vogel dar.");
AD("vogel",
"Der Vogel ist eine Harpye.");
AD("harpye",
"Die Harpye ist ein magischer Vogel. Ihr Kopf wiegt hin und her. Wo sie "
"wohl leben mag? Angeblich holt sie jeden, der es ihr gleichtut.");
AD("kopf",
"Der Kopf wiegt hin und her.");
AD("westen",
"Im Westen sieht man nur Sand und noch weiter im Westen den Wasserfall.");
AD("wasser",
"Das Wasser des Fluss raucht an Dir vorueber.");
AD("wasserfall",
"Der Wasserfall stuerzt im Westen ueber eine enorm hohe Klippe. Er rauscht "
"so laut, dass man sein eigens Wort nicht mehr verstehen kann.");
AD("wort",
"Wie bitte?!?!??!Ich verstehe nichts?");
AD(({"klippe", "klippen"}),
"Die Klippen liegen direkt neben Dir im Norden. Im Westen stuerzt ein "
"Wasserfall ueber eine enorm hohe Klippe.");
AD("sueden",
"Im Sueden liegt Sand. Dahinter fliesst der Fluss.");

AD("fluss",
"Der Fluss rauscht an der Sandbank vorbei.");

AD(({"urlaub","urlaubsgefuehle"}),
"Hier sicher nicht!");
AD(({"strand","sandstrand"}),
"Der Sandstrand ist sehr flach. Weisser Sand, in dem man leicht einsinkt. ");
AD("sand",
"Der Sand ist weiss und warm. Ab und zu sinkt man ein. Teilweise ist er "
"auch so tief und weich, dass man ihn nicht betreten kann. Versuchs mal mit graben...");
AD("boden",
"Der Boden besteht aus weichem Sand.");
AD("decke",
"Decke gibt nicht.");
AD("himmel",
"Der Himmel ist blau und wunderschoen anzusehen. Wolkenlos!");

AD("sandbank",
"Die Sandbank erstreckt sich hier nach Sueden ,Westen und Osten.");

     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");




AIT("d/dschungel/dante/fisch/npc/raubmoewe", REFRESH_DESTRUCT);



AE("westen", "./sand3");
ASE("sueden", "nix");

AE("osten", "./sand1");
ACD(({"wiege", "wieg"}), "bird");
DO_ANGEL





AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   

if(!random(2)) {


AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   }
   
   


AIT("d/dschungel/feyaria/kueste/npc/sandfloh", REFRESH_DESTRUCT,
 ([P_MNPC_FLAGS: MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT,
      P_MNPC_AREA:"/d/dschungel/dante/fisch/room/sand",
     P_MNPC_WAIT: ({ 3, 3, 3}),
     P_MNPC_DEFAULTROOM: "/d/dschungel/dante/fisch/room/sand2"]) );
   
   
   
   
ACD(({"grab","grabe"}), "get_koeder");
}


  int do_angel()   {
  write (BS(
  "Hier ist kein geeigneter Platz zum Angeln! Versuch es woanders!")); 
  return 1;
  }

int get_koeder(string str)  {
	
	object ob;
	
	NF("Wo willst Du hier graben?!\n");
  if(str=="im sand"||str=="in sand")  {
  	write(BS(
  "Du beginnst im Sand zu graben."));
  say(BS(
  CAP_TPN+" graebt im Sand herum."));
   
   if ( (!present("DANTE_FISCH_LISTE", TP)) ||
        (deep_present("mehlwurm", TP))||
        (deep_present("DANTE_ANGEL_MEHLWURM", TP))  )  

          {
   	write(BS(
   "Du findest leider nichts, deswegen hoerst Du auch auf zu graben."));
   return 1; }
   
   
  else  {
  	ob=clone_object(FO"mehlwurm");
  	ob->move(TP, M_NOCHECK);
  write(BS(
  "Du findest einen Mehlwurm, den Du sofort einsteckst."));
     return 1; }
  return 0; }
return 0; }
  	
  
  


int bird (string str)  {
NF("Was willst Du hin und her wiegen?!\n");
 if(member(({"kopf hin und her", "mit kopf hin und her"}),str)!=-1)  {


  if(!present("DANTE_FISCH_LISTE_DREI", TP))  {
  write("Nein, leider zuerst musst Du zwei Aufgaben fuer Doby Mick erledigen!\n");
  return 1; }
 else
 
    {
 write(BS("Du wiegst mit dem Kopf hin und her und wartest! Du solltest warten und "
 "Dich nicht von hier fortbewegen!")); 
  call_out("bird1", 5);
  return 1; }
  return 0; }
  return 0; }
  

bird1()   {
if(environment(TP)!=TO) return ;
   write("Du glaubst das Surren und Sausen von grossen Fluegeln zu hoeren!\n");
  call_out("bird2", 5); 
   }
   
  

bird2()   {
if(environment(TP)!=TO) return ;
   write("Ein grosser Vogel naehert sich Dir von oben!\n");
  call_out("bird3", 3); 
   }
   


bird3()   {
if(environment(TP)!=TO) return ;
   write(BS(
   "Eine gigantische Harpye stuerzt von oben auf Dich herab, packt Dich "
   "und schleppt Dich fort!!!"));
  TPM("d/dschungel/dante/fisch/room/flug", M_GO,
  "von einer grossen Harpye gepackt und mitgerissen", "wird",
  "wird von einer grossen Harpye hereingeworfen");
   }
   
     
   

int nix()
  {
NF("Du bleibst im tiefen Sand stecken!\n");
return 0; }       
