//dante sl 99-2000

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
 
#include <wizlevels.h>

#define NIX  if(environment(TP)!=TO || !TP) return 0;     

int swim=0;


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem wilden Fluss treibend" );
  SetProp( P_INT_LONG, BS(
  "Nun bist Du in den Fluss gesprungen. Die Stroemung ist so stark, dass "
  "sie Dich wie ein Blatt mitreisst. In wilder Fahrt geht es flussabwaerts. "
  "Ab und zu wirst Du unter Wasser gedrueckt und schluckst einiges davon. "
  "Auf und nieder reissen Dich die Wellen und Du bangst um Dein Leben."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_WATER]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no()
 {
 
 if(query_verb()=="schwimme"||
    query_verb()=="schwimm"||
    query_verb()=="schwimmen")  {
    
    write(BS(
    "Du schwimmst um Dein Leben! Gut so! Immer weiter schwimmen!!!"));
    swim++; 
    return 1; }
    
    else
      
   write (BS(
   "Daran solltest Du nicht denken, schau lieber, dass Du nicht absaeufst! "
   "Schwimm um Dein Leben! Los! Schwimm!"));
     return 1;
   }
     

  init()
  {
  
  ::init();

  if(query_once_interactive(this_player())){
  call_out("a1", 2);}
  }
  

  a1()
    {
    NIX
    write("WOW!!! Die Stroemung reisst Dich sofort mit sich!!!\n\n");
    call_out("a2", 2);
    }
    
   a2()
   {NIX
   write("In wilder Fahrt geht es flussabwaerts!\n\n");
   call_out("a3", 2);
     }
     
     a3()
     { NIX  
     write("Die Gischt spritzt auf und nieder!\n\n");
     call_out("a4", 3);
     }
     
     a4()
     {NIX
     write("Die Wellen druecken Dich unter Wasser! Hilfe Luft!\n\n");
     
     if(swim<5)  {
     call_out("ersoffen", 1); swim=0; }
      
      if(swim>=5)  {
 call_out("a5", 3);
       }
      }     
     
      a5()
      {
      NIX
     write("Du wirst wild nach oben geschwemmt und saust kurz durch die Luft!\n\n");
     call_out("a6", 3);
      }
      
     a6()
       {NIX
       write("Du wirst direkt auf einen Felsen zugetrieben!\n\n");
       call_out("a7", 3);
       }
       
       a7()
       {NIX
       
       write("WAH!!! Fast waerst Du am Felsen zerquetscht worden!\n\n");
       
         if(swim<10)  {
     call_out("ersoffen", 1); swim=0; }
       
        if(swim>=10)  {
 call_out("a8", 3);
       
       }  
      }    
 
 
 a8()
 {NIX
 write("Weiter geht die wilde Fahrt am Fluss!!!\n\n");
 call_out("a9", 2);
 }
    
 a9()
 {NIX
 write("PLATSCH!!! Eine Welle trifft Dich voll im Gesicht!\n\n");
 call_out("a10", 2);
 }

 a10()
 {
 NIX
 write("Du glaubst, dass irgendetwas unter Dir schwimmt.\n\n");
 
   if(swim<15)  {
     call_out("ersoffen", 1); swim=0; }
 
 if(swim>=15)  {
 call_out("a11", 3);
     }
 
    }
 
 a11()
  {
  NIX
  write("Ein dunkler Schatten naehert sich Dir schnell! PANIK!!!\n\n");
  call_out("a12", 3);
  }
  
  
  a12()
  {
  NIX
  write("Ploetzlich schiesst ein gigantisches Maul aus dem Wasser!!!\n"
  "Du hast Glueck! Es verfehlt Dich und taucht wieder ab!\n\n");
  call_out("a13", 3);
  }
  
  
  a13()
  {
  NIX
  write("Die Stroemung wird immer staerker und das Rauschen immer lauter!\n\n");
  call_out("a14", 3);
  }
  
  
  
  a14()
  {
  NIX
  write("Solltest Du etwas auf einen Wasserfall zutreiben?!!\n"
  "Das waere Dein sicherer Tod!\n\n");
  call_out("a15", 3);
  }
  
  
  a15(){
  NIX
  write("Das Rauschen wird immer bedrohlicher und lauter! ANGST!!!\n\n");
  
    if(swim<20)  {
     call_out("ersoffen", 1); swim=0; }
  
  
   if(swim>=20)  {
  call_out("a16", 3);
           }
    }


  
  a16(){NIX
  write("Du glaubst vor Dir einen Wasserfall zu entdecken!!!!\n"
  "Schwimm um Dein Leben! \n\n");
  call_out("a17", 3);}
   
   a17(){NIX
  write("Die Stroemung wird so stark, dass Du keine Chance zu haben scheinst!\n\n");
  call_out("a18", 3);}
  
   a18(){NIX
  write("Immer mehr Unterwasserstrudel zerren an Deinen Beinen! Du ertrinkst!!!\n\n");
  call_out("a19", 3);}
  
 
   a19(){NIX
  write("Ein Unterwasserstrudel zerrt gewaltig an Dir!!\n"
  "Ersaufen oder beim Wasserfall zerschmettert werden, was ist Dir lieber!!!\n\n");
  call_out("a20", 3);}
  
  
   a20(){NIX
   write(
  "Der Untwerwasserstrudel reisst Dich nach unten in Dein kuehles Grab!\n"
  "Schoenes Ersaufen wuensche ich Dir!\n\n");
  
    if(swim<25)  {
     call_out("ersoffen", 1); swim=0; }
  
  
   if(swim>=25)  {
       call_out("a21", 3);    }
  
          }
 
 
 
   a21(){NIX
   write(
   "Der Strudel schleudert Dich hin und her, Dein Kopf schlaegt gegen Felsen!\n\n");
  call_out("a22", 4);}
   
 
   a22(){NIX
  write("Du schliesst mit Deinem Leben ab! Lars lacht Dich an!\n\n");
  call_out("a23", 5);}
   
   a23(){NIX
  write("Lars sagt: Tja, bloed gelaufen! \n"
  "Lars sagt: Aber was erwartest Du im Dschungel?!?\n\n");
  call_out("a24", 5);}
   
   a24(){NIX
  write("Lars sagt: Naja, diesmal bin ich gnaedig!\n"
  "Du erwachst wieder in einer fremden Umgebung...\n");
  call_out("weg", 1);}
   
   
   
   
   ersoffen()  {
   NIX
   swim=0;
   write(BS(
   "Du schwimmst viel zu wenig und bist gerade am ersaufen!!!"));
   call_out("ersoffen2", 1);
   }
   
   ersoffen2() {
  
   NIX
   write(BS(
   "Als Du gerade am Absaufen bist, siehst Du wie ein Rettungsring direkt "
   "neben Dir im Wasser landet! Dann lautes Bruellen und dann schwinden Dir "
   "die Sinne!"));
   
     TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 10,
  PARALYZE_MSG: "Du bist leider ersoffen! Oder?!\n",
  PARALYZE_MSG_OTHER: "%s wird bewusstlos, aber von Doby Mick gerettet.\n",
  PARALYZE_END: "Du kommst wieder zu Sinnen!\n",
  PARALYZE_END_OTHER: "%s kommt dumm guckend wieder zu sich!\n"]));
   call_out("ersoffen3", 9);
  
  }
  
  
   
  ersoffen3()  {
  NIX
  TPM("d/dschungel/dante/fisch/room/fischer", M_NOCHECK+M_NO_SHOW+M_SILENT);
  write(BSA(
  "HEIA! PIET! Das war knapp! Fast waerst Du ersoffen! In letzter Sekunde "
  "konnte ich Dich noch an Land ziehen!!! Merk Dir folgendes! Du musst "
  "wie ein wilder Fisch schwimmen! Los versuchs nochmal!",
  "Doby raet Dir: "));
  }
  
 weg()
 {
 TP->move("d/dschungel/dante/fisch/room/jump4", M_GO+M_SILENT+M_NO_SHOW);
 remove();
 }
 
  
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/dante/fisch/room/jump2",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  