
#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
 
#include <wizlevels.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Seil" );
  SetProp( P_INT_LONG, BS(
  "Du haengst nun an einem Seil, dass von der Bruecke nach unten haengt. "
  "Es schwankt und schaukelt wild, und Du hast grosse Muehe nicht "
  "in die Tiefe zu stuerzen. Unter Dir rauscht der Fluss vorbei. Die "
  "Stroemung ist sehr stark, und wuerde Dich sicher mitreissen, solltest "
  "Du hinabstuerzen..."));  
AD("muehe",
"Anstrengend...");
AD("stroemung",
"Irgendwie reizt Dich die Stroemung. Spring doch einfach in den Fluss.");
 AD("himmel",
 "Blau und wolkenlos.");
 AD("boden",
 "Boden gibts hier keinen..");
 AD("holz",
 "Das Holz ist ober Dir und nicht interessant.");
 AD(({"seil","seile"}),
  "Du haengst am Seil...");
 AD("decke",
 "Gibts es hier auch nicht.");
AddDetail("plattform",
"Die Plattform ist ober Dir. Du kannst nach oben klettern.");
AD("brett",
"Das Brett ist ueber Dir. Von ihm aus geht das Seil, an dem Du haengst.");
AD("fluss",
"Gruen und blau schimmert er unter Dir. Das Wasser rauscht wild an Dir vorbei.");
AD("wasser",
"Das Wasser sieht herrlich sauber aus.");
AD("tiefe",
"Hier ist es noch immer sehr hoch, aber bei weitem nicht mehr so hoch "
"wie oben bei der Bruecke.");
AD("sturz",
"Nicht anzuraten, oder doch...");
    AddDetail(("westen"),
    "Der Wasserfall liegt weiter flussaufwaerts im Westen.");
    AddDetail(("wasserfall"),
    "Gewaltig wie der Wasserfall in die Tiefe stuerzt.");                                                                        
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(({"bruecke","haengebruecke"}),
"Die Bruecke ist ober Dir.");
  AddDetail(("dschungel"),
  "Der Dschungel liegt zu beiden Seiten der Schlucht.");
  AddDetail(("wind"),
  "Der Wind laesst die Bruecke und das Seil hin und herschwanken...");
  AddDetail(({"ohr","ohren"}),
  "Du hoerst den Fluss rauschen und den Wind pfeiffen...");
  AddDetail(("sonne"),
  "Die Sonne strahlt hell herab.");
AddDetail(("schlucht"),
 "Du haengst sozusagen mitten in der Schlucht.");
  AddSound( DEFAULT_SOUND,
    "In der Tiefe rauscht das Wasser.");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
AddSmell("luft",
"Die Luft ist hier erfrischend gut.");


ACD(({"spring","springe"}), "get_trip");
ACD(({"kletter","klettere","steige","steig"}), "go_up");

}
  
  int go_up(string str)
     {
     NF("Wo willst Du hinauf klettern/steigen?\n");
if(member(({"rauf","nach oben", "hinauf","am seil nach oben", "am seil hoch"}),str)!=-1)
     {
        write("Du kletterst nach oben!\n");
        TP->move("/d/dschungel/dante/fisch/room/jump", M_GO,
        "am Seil nach oben", "klettert", "kommt von unten heraufgeklettert");
        return 1;
        }
    return 0;
    }
                 
     
     
     
  int get_trip(string str)
    {
    NF("Wohin oder wohinunter willst Du springen?\n");
  if(member(({"runter", "in fluss","nach unten","hinab"}),str)!=-1)
    {
  
  
  if(TP->QueryProp(P_GHOST, 1))    
      {
      write("Nein, als Geist geht das nicht.\n");
      return 1;
      }
    if(TP->QueryProp(P_WIMPY)!=0)
      {
      write("Nein, Du bist zu feig dafuer! Aendere das!!!\n");
      return 1;
      }
   else
       {
    write("Du nimmst Deinen ganzen Mut zusammen und springst in den "
    "reissenden Fluss!!!\n");
    TP->move("d/dschungel/dante/fisch/room/jump3", M_GO + M_NO_SHOW,
    "in den wilden Fluss hinab", "springt");//absicht
    return 1;
       }
    return 0;
    }
 return 0;
 }
       
init ()  {
	::init();
if(interactive(TP))  {
	call_out("gag", 10);  }}
	
	gag()  {
		if(environment(TP)!=TO) return;

		switch(random(3))  {
		case 0:
	write(BS(
	"Das Seil schwingt hin und her. Dir wird uebel und so kletterst Du wieder "
	"zurueck hinauf."));
	TPM("d/dschungel/dante/fisch/room/jump", M_GO,
	"wieder zurueck hinauf", "klettert",
	"kommt heraufgeklettert");
	break;
	case 1..2: break;  
	default: write("\n");			     
}}
