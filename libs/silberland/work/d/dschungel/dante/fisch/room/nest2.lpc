//dante sl 99

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"

#define CLEAN  (member(clean, getuid(this_player()))!=-1)
 string *clean=({});

int rennt=0;
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Nest der Harpye" );
  SetProp( P_INT_LONG, BS(
"Die Hoehle wird hier enger und ist nicht mehr so feucht. Der Boden "
"ist uebersaeht mit Holz und voller Kot. Irgendwie sieht das ganze "
"einem Nest aehnlich. Einem sehr schmutzigen Nest! Sogar die Waende sind voller "
"Dreck. Im Sueden kommst Du wieder zum Wasserfall."));

AD("boden",
"Der Boden ist voll von Aesten und anderem Holz. Total verdreckt alles!");
AD(({"ast","aeste"}),
"Die Aeste liegen wild verstreut herum. Sie sind voller Kot!");
AD("sueden",
"Da ist der Wasserfall.");

AD("holz",
"Das Holz ist voller Kot und Dreck! Einfach ekelhaft, diese Harpye! Das Holz "
"sieht ja recht brauchbar aus. Wenn es nur nicht so verdreckt waere, wuerdest "
"Du es ja gerne einsammeln, aber so...");
AD("dreck",
"Ueberall liegt Dreck und Kot herum. Einfach ekelig!");
AD("kot",
"Die Harpyen scheinen nicht allzu hygienisch zu sein, denn ihr "
"Kot ist ueberall. Sie sollten wirklich einmal ihr Nest saeubern!");

AD(({"wasser","wasserfall"}),
"Der Wasserfall rauscht im Sueden dahin.");

AD(({"wand","waende"}),
"Sogar die Waende sind voller Dreck und Kot! PFUI!!! EXTRA PFUI!!! "
"PFUI 2000!!!");


AD("hoehle",
"Hier scheint die Hoehle zu einem Nest umfunktioniert worden zu sein!");
AD("nest",
"Du stehst mitten im Nest einer Harpye.");
AD("harpye",
"Es gibt viele veschiedene davon. Hier lebt eine nachtschwarze Harpye.");

 
AD("decke", "Von der Decke baumelt Etwas herab.");
AD("etwas", "Hmm, sollte man daran ziehen?! Koennte gefaehrlich werden?!");
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");

AIT(FN"harp");  //absichtlich so!!!

AD("luft", "Feucht und heiss.");


AE("sueden", "./nest");

ACD(({"saeuber", "putze", "raeum", "putz", "saeubere"}), "get_clean");
ACD(({"sammle", "sammel"}), "get_wood");

ACD(({"zieh","ziehe"}), "get_schnur");
}



init()  {
	::init();
	
	if ( (interactive(TP)) &&
	     (!IS_WIZARD(TP))  &&
	     (!present("DANTE_FISCH_LISTE_DREI", TP)) ) {
	 TPM("gilden/abenteurer", M_GO+M_SILENT);
	 }}    	


int get_schnur(string str)   {
  object ob;
  NF("Woran willst Du ziehen? Was?!\n");
if(str=="etwas"||str=="an etwas")  {
   if((deep_present("DANTE_SCHNUR", TP)) ||
   (deep_present("DANTE_TONNE", TP))) {
   write("Du ziehst daran, aber nichts passiert...!\n");
   say(CAP_TPN+" stellt sich dumm an!\n");
   return 1; }   
  
  else  {
  write(BS(
  "Du ziehst daran und irgendetwas faellt von oben genau auf Dich!"));	
  say(CAP_TPN+" macht irgendetwas im Nest.\n");
  ob=clone_object(FO"schnur");
  ob->move(TP, M_GET);
  return 1; }
  return 0; }
  return 0; }
    







      
int get_clean(string str)  {
       NF("Was willst Du saeubern?\n");
     if(str=="nest"||str=="nest von dreck"
     ||str=="nest von kot")   {
  
  if(CLEAN)  {
    write("Aber Du hast hast doch das Nest schon einmal gesaeubert!\n");
    say(CAP_TPN+" macht sich nur schmutzig!\n");
    return 1;               }
   
    if(!CLEAN)           {
     write(BS(
     "Du machst Dir die Muehe und beginnst das Nest vom Kot und Dreck "
     "zu saeubern. Du gibst aber bald wieder auf, denn Du wuerdest nie "
     "damit fertig werden. Trotzdem, Du fuehlst Dich nun bereit fuer "
     "irgendetwas, aber was..."));
  clean += ({getuid(this_player())});   
   say(CAP_TPN+" arbeit wie wild am Nest herum!\n");
   return 1; }
   return 0; }
   return 0; }
       




int get_wood(string str)   {
  object ob;
  NF("Was willst Du sammeln?!\n");
   if(str=="holz"||str=="holz ein"||str=="holz auf")  {
   if((deep_present("DANTE_WOOD", TP))||
   (deep_present("DANTE_TONNE", TP))) {
   write("Du sammelst und sammelst, wozu das?!\n");
   say(CAP_TPN+" stellt sich dumm an!\n");
   return 1; }   
  
  if(!CLEAN)    {
  write(BS("Du versuchst etwas Holz zu sammeln, doch das Nest ist "
  "zu verschmutzt. Man sollte es vielleicht saeubern, aber wer tut das schon!"));
  say(CAP_TPN+" sammelt sich dumm!\n");
  return 1; }
  
  else {
  write("Du sammelst etwas Holz vom Boden des Nestes auf!\n");
  say(CAP_TPN+" macht irgendetwas im Nest.\n");
  ob=clone_object(FO"wood");
  ob->move(TP, M_GET);
  return 1; }
  return 0; }
  return 0; }
    

reset()  {
::reset();  
if(!rennt)   {
   if(!present("harpye", TO))   {
   object ob;
ob=clone_object("/d/dschungel/dante/fisch/npc/harp");
ob->move(TO, M_TPORT);
}}}


   new_bird()  {
   rennt=1;
call_out("nunaberecht", 30);  }

nunaberecht()  {
object ob;
if(!present("harpye", TO))   {
ob=clone_object("/d/dschungel/dante/fisch/npc/harp");
ob->move(TO, M_TPORT);
rennt=0;
//diese doch recht bloede konstruktion mit dem rennt dient nur
//dazu zu verhindern, das wenn reset is und gerade das callout laeuft keine
//zwei haie/voegel kommen, die wahrscheinlichkeit is klein aber naja
}}

