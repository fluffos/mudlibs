//verbindungsgang vom strand zu den kannibalen
//dante sl 99-97-2000!!!


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

void make_room()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem dunklen Gang in den Klippen" );
  SetProp( P_INT_LONG, BS(
  "Ein dunkler Gang fuehrt hier steil von Suedosten nach Nordwesten "
  "hinauf. Die Waende sind aus rauhem Stein, geschaffen von einem "
  "unterirdischen Fluss, der hier vor sehr langer Zeit geflossen ist. "
  "Nun ist er aber schon seit langem versiegt und so kannst "
  "Du problemlos sein ehemaliges Flussbett betreten. "
  "Fackeln stecken in Spalten in den Waenden und spenden Dir "
  "genug Licht um Dich orientieren zu koennen. "
  "Von der Decke "
  "haengen duenne Schnuere herab, an die Knochen geknuepft sind. Ein "
  "schauriger Anblick! Wer sie hier wohl aufgehaengt hat?"));
  
AD("anblick",  
"Er gefaellt Dir gar nicht und Du wuerdest lieber umdrehen!");
AD("himmel",
"NIX!");

  AD("decke",
  "Duenne Schnuere haengen von der Decke herab. Knochen wurden an ihnen befestigt?!");
  AD(({"schnur","schnuere"}),
  "Die Schnuere baumeln sanft hin und her.");
  AD(({"knochen"}),
  "Die Knochen sond teilweise zertruemmert und tief eingekerbt.");
  AD(({"schnur","schnuere"}),
  "Die Schnuere haengen von der Decke herab. Sie sind duenn und braun. "
  "Ob man an ihnen ziehen kann?!");
  
  AD("boden",
  "Der steinerne Boden ist rauh und zerklueftet.");
  AD(({"wand","waende"}),
  "Die Waende bestehen aus rauhem Stein. Fackeln stecken in "
  "tiefen Spalten und spenden etwas Licht.");
  AD("licht",
  "Viel ist es nicht, aber es genuegt.");
  AD("stein",
  "Der Stein wurde vom Fluss so geformt.");
  AD(({"spalte","spalten","spalt"}),
  "In den Spalten stecken die Fackeln. Ob man nicht auch "
  "in die Spalten greifen kann?!");
  
  
  AD("suedosten",
  "Der Gang fuehrt von Suedosten nach Nordwesten.");
  AD("nordwesten",
  "Irgendetwas liegt sicher im Nordwesten, aber was?!");
  AD("irgendetwas",
  "Was das wohl sein koennte?");

AD(({"fackel","fackeln"}),
"Die Fackeln brennen nicht sehr hell, aber es scheint zu genuegen.");
  
  AD("gang",
  "Der Gang ist eigentlich ein altes Flussbett. Er scheint vom Strand "
  "durch die Klippen irgendwo anders hin zu fuehren.");
  AD(({"fluss","flussbett","bett"}),
  "Der Fluss fliesst hier schon seit langer Zeit nicht mehr und "
  "so kannst Du in seinem Flussbett bequem gehen.");
  AD("zeit",
  "Sehr langer Zeit.");
  
  
  AD(({"klippe","klippen"}),
  "Du befindest Dich mitten in den Klippen.");
  AD("strand",
  "Der Strand liegt im Suedosten von hier.");
  
  



     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );

  AddSound( DEFAULT_SOUND,
    "Hier ist es sehr still.");
  AddSmell( DEFAULT_SMELL,
"Es riecht hier nicht angenehm. Aber warum?!");

ACD(({"greife","greif"}), "gag1");
ACD(({"zieh","ziehe"}), "gag2");

}


int gag2(string str)  {
	 object ob;
	 NF(BS("Was willst Du hier ziehen?!"));
	 
	if(str=="schnur"||str=="an schnur")  {
	write(BS("Du ziehst an einer der Schnuere!"));
	say(BS(CAP_TPN+" zieht an einer der Schnuere."));
		 
	if(present("kannibale", environment(TP)))  {
		write(BS(
	"Der Kannibale bruellt: Kiluz Trjdj Hertoplehj!"));
	say(BS("Der Kannibale bruellt: Kiluz Trjdj Hertoplehj!"));
	return 1; }
	
	else {
ob=clone_object("/d/dschungel/dante/fisch/kannibalen/npc/kanni");
ob->move(environment(TP), M_GO);	 
write(BS(
"Ein Kannibale stuermt herein und bruellt Dich laut an!"));
ob->SP(P_AGGRESSIVE, 0);
ob->Kill(TP);
say(BS(
"Ein Kannibale stuerzt herein und greift "+TPN+" an!"));
      return 1; }
   return 0;}
return 0; }


int gag1(string str)  {
	NF("Wo willst Du hier reingreifen?!\n");
  
  if(str=="in spalt"||str=="in spalte")   {
  	
  	write(BS(
  	"Du greifst in eine der vielen Spalten."));
  	say(BS(CAP_TPN+" greift in eine der vielen Spalten."));
  switch(random(7))   {
  	case 0..1:
  	write(BS("AHHH!!! Irgendetwas sticht Dich! AUA!"));
  	say(BS("Irgendetwas stich "+TPN+"!"));
  	TP->do_damage(5);
  	break;
  	case 2:
  	write(BS("Du findest einige Muenzen!"));
  	say(BS(CAP_TPN+" findet einige Muenzen!"));
  	TP->AddMoney(1+random(10));
  	break;
  	case 3..4:
  	write(BS("AHHH!!! Irgendetwas giftiges sticht Dich! AUA!"));
  	say(BS("Irgendetwas giftiges stich "+TPN+"!"));	
        TP->AddPoison(1);
        break;
        case 5..6:
        write(BS(
        "Leider ist die Spalte leer."));
        say(BS(
        CAP_TPN+" findet leider nichts."));
        break;
        default:  write(BS(
        "Leider ist die Spalte leer."));
        say(BS(
        CAP_TPN+" findet leider nichts."));
        }
     return 1; }
    return 0; }
     