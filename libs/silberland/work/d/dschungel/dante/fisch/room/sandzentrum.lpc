//zentrum der sandbank nur ueber weg im osten flucht moeglich

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Zentrum der Sandbank" );
  SetProp( P_INT_LONG, BS(
  "Du bist also lebendig im Zentrum der Sandbank angelangt. Was Dich hier "
  "erwartet, weiss kein Sterblicher. Rings um Dich herum nur Sand, sonst nichts. "
  "Starker Wind blaest den Sand immer wieder hoch, sodass man nichts erkennen "
  "kann..."));
AD("tantalus",
"Hmm, scheint nicht hier zu sein.");
AD("schreckliches",
"TANTALUS, der Krake!");
AD("krake",
"TANTALUS!");
AD("boden",
"Der Boden ist Sand!");
AD("wind",
"Der Wind wirbelt immer wieder Sand auf, sodass man nichts erkennen kann.");
AD("zentrum",
"Hier ist das Zentrum!");
AD("tod",
"Der Tod erwartet Dich!");

AD("osten",
"Der Weg im Osten scheint brauchbar zu sein....");
AD("leiter",
"Die Leiter liegt enorm weit weg.");
AD("bruecke",
"Die Bruecke liegt hoch ueber Dir im Osten.");
AD(({"klippe","klippen"}),
"Sie liegen im Norden, sind aber nicht zu erkennen.");
AD(({"sueden","norden","westen","fluss","wasserfall"}),
"Der wirbelnde Sand versperrt Dir die Sicht!\n");
AD("sandbank",
"Die Sandbank erstreckt sich hier nach Westen, Sueden, Norden und Osten.");
AD("sand",
"Wild wirbelt er in der Luft herum und versperrt Dir jede Sicht.");
AD("luft",
"Die Luft is voll von Sand.");
AD("himmel",
"Der Sand versperrt Dir die Sicht!");
AD("sicht",
"Keine!");
AD(({"sandstrand","strand"}),
"Das hier ist sein Zentrum!");
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist voller Sand.");


ASE("sueden", "go_nix");
ASE("norden", "go_nix");
ASE("westen", "go_nix");
ASE("nordosten", "go_nix");
ASE("suedosten", "go_nix");
ASE("nordwesten", "go_nix");
ASE("suedwesten", "go_nix");

ASE("osten", "go_o");


AIT("/d/dschungel/dante/fisch/npc/bkrak", REFRESH_DESTRUCT);


}

int go_nix()
   {
     NF("Du versuchst diesem verfluchten Ort zu entkommen.\n"
     "Der Sand jedoch haelt Dich einfach zurueck!\n");
     return 0;
     }

  int go_o()
     {
     return  TP->move("d/dschungel/dante/fisch/room/sand8", M_GO,
     "nach Osten", "fluechtet", "flieht aus dem Westen hierher");            
   }
//der fluchtweg
   
       
