//hier lebt die krake wenn sie an land ist....aufstieg per leiter nach
///weg/room/bruecke2.c
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

int rennt=0;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im halbhohen Wasser" );
  SetProp( P_INT_LONG, BS(
"Du watest nun im halbhohen Wasser umher und fuehlst Dich nicht wohl "
"dabei. Das Wasser ist tief genug zum ertrinken und sicher auch tief "
"genug fuer Haie. Der Strand liegt westlich von Dir und Du kannst dorthin "
"zurueck waten."));


AD(({"hai","haie"}),
"Hier soll der legendaere, grosse, gruene Dschungelhai sehr oft sein!");
AD("dschungelhai",
"Seine Flosse soll sehr begehrt sein!");
AD("flosse",
"Hol sie Dir!");

AD("wasser",
"Das Wasser ist gruen und teilweise auch dunkelblau! HE! Da war doch was! Blut treibt auf dem Wasser!");

AD("blut", "Hmm, deswegen sind die Haie also hier.");


AD("strand",
"Der Strand ist im Westen.");
AD("westen",
"Dort waerst Du sicher.");
AD("boden",
"Das Wasser ist zu tief um den Boden zu erkennen.");
AD("himmel",
"Der Himmel ist fast so blau wie das Wasser.");
AD("decke",
"Keine da.");
AD(({"wand","waende"}),
"Keine.");


     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
 AIT("/d/dschungel/dante/fisch/npc/dschungelhai");

ACD(({"wate"}), "water");
}





reset()  {
::reset();  
if(!rennt)   {
   if(!present("dschungelhai", TO))   {
   object ob;
ob=clone_object("/d/dschungel/dante/fisch/npc/dschungelhai");
ob->SetProp(P_LONG, BS(
"Das ist einer der legendaeren, grossen, gruenen Dschungelhaie! "
"Seine Flossen leuchten gruen-blau, aber das ist durch das Wasser nicht "
"so genau zu erkennen. Du siehst ja nicht den ganzen Hai, sondern nur "
"seine Flossen! Der Moerder des letzen Dschungelhais ist unbekannt!"));
ob->move(TO, M_TPORT);
}}}


   new_shark()  {
   rennt=1;
call_out("nunaberecht", 30);  }

nunaberecht()  {
object ob;
if(!present("dschungelhai", TO))   {
ob=clone_object("/d/dschungel/dante/fisch/npc/dschungelhai");
ob->SetProp(P_LONG, BS(
"Das ist einer der legendaeren, grossen, gruenen Dschungelhaie! "
"Seine Flossen leuchten gruen-blau, aber das ist durch das Wasser nicht "
"so genau zu erkennen. Du siehst ja nicht den ganzen Hai, sondern nur "
"seine Flossen! Der letze Dschungelhai wurde von "+TP->name()+" getoetet!"));
ob->move(TO, M_TPORT);
rennt=0;
//diese doch recht bloede konstruktion mit dem rennt dient nur
//dazu zu verhindern, das wenn reset is und gerade das callout laeuft keine
//zwei haie kommen, die wahrscheinlichkeit is klein aber naja
}}




int water(string str)   {
   NF("Wohin willst Du waten?!\n");
    if(str=="zu sand"||str=="zum sand"||str=="nach westen"||
    str=="an strand"||str=="zurueck"||str=="raus")   {
  write("Du watest an den Strand zurueck!\n");
  TPM("d/dschungel/dante/fisch/room/sand8", M_GO,
  "an den Strand zurueck", "watet", "kommt aus dem Wasser gewatet");
  return 1; }
  return 0; }
  
