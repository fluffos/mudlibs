
#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define Z write("\n\n"); 
#include <wizlevels.h>

#define NIX  if(environment(TP)!=TO || !TP) return 0;     

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In den Klauen einer grossen Harpye" );
  SetProp( P_INT_LONG, BS(
  "Die gigantische Harpye haelt Dich fest in ihren Klauen und "
  "fliegt mit Dir die Klippen entlang immer hoeher und hoeher. "
  "Wo mag diese absonderliche Reise wohl enden?!"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no()
 {
   write (
   "Daran solltest Du nicht denken, schau lieber, dass Du nicht zu Boden faellst!\n");
     return 1;
   }
     

  init()
  {::init();

  if(query_once_interactive(this_player())){
  call_out("a1", 3);}
  }
  

  a1()
    {
    NIX
    Z
    write(BS(
    "Die Harpye schlaegt einige Male mit ihren Fluegeln und schon "
    "geht es nach oben in schwindelnde Hoehen!"));
    call_out("a2", 5);
    }
    
   a2()
   {NIX
   Z
   write(BS(
   "Die Harpye haelt Dich fest in ihren Klauen waehrend sie immer hoeher "
   "der Sonne entgegen steigt."));
   call_out("a3", 5);
     }
 
 
    
   a3()
   {NIX
   Z
   write(BS(
   "Nun liegen auch die Klippen schon tief unter Dir. Die Harpye kraechzt "
   "laut und scheint nun ihren Kurs etwas zu aendern. Schau lieber "
   "nicht nach unten..."));
   call_out("a4", 5);
     }
 
    
   a4()
   {NIX
   Z
   write(BS(
   "Die Harpye fliegt nun mit ihrer seltsamen Fracht, das bist Du, "
   "den Fluss entlang direkt auf den Wasserfall zu."));
   call_out("a5", 5);
     }
    
   a5()
   {NIX
   Z
   write(BS(
    "Der Wasserfall kommt immer naeher, der doofe Vogel wird doch nicht etwa "
    "direkt in das Wasser fliegen?!?!\n"));
   call_out("a6", 4);
     }
 
 
    
   a6()
   {NIX
   Z
   write(BS(
    "SCHHHHHHHHH!!! Die Harpye haelt Dich noch fester mit ihren Klauen "
    "und stuerzt sich direkt in den Wasserfall!!! Wenn das nur gut geht?!?"));
   call_out("a7", 4);
     }
    
   a7()
   {NIX
   Z
   write(BS(
    "SCHHHHHHHHHHHHHHHHH!!! Der Wasserfall rauscht brutal laut als sich "
    "Dein seltsamer Flugdienst in das Wasser stuerzt. Die Gischt "
    "spritzt auf!"));
   call_out("a8", 3);
     }
 
    
   a8()
   {NIX
   Z
   write(BS(
   "Wie durch ein Wunder fliegt der Vogel mit Dir unversehrt durch den Wasserfall "
   "hindurch und landet in einer geraeumigen Hoehle, die scheinbar "
   "verborgen hinter dem Wasserfall liegt!!!"));
   call_out("weg", 4);
     }
 
 
 
 
 weg()
 {NIX
   Z
 write(BS(
 "Der Vogel kraechzt noch einmal laut, dann schlaegt er wild "
 "mit den Fluegeln und fliegt wieder durch den Wasserfall hindurch. "
 "Dann ist er verschwunden?!?"));
 TP->move("d/dschungel/dante/fisch/room/nest", M_GO+M_SILENT+M_NO_SHOW);
 }
 
  
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/dante/fisch/room/sand2",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  