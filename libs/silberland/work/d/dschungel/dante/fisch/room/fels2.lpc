//dante sl 99 98

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

int fische=0;
#define MAX 30
#define TI 2+random(4)


/*
hier forellen lachse usw
*/
#define Z write("\n");

init()  {
  ::init();
  if(interactive(TP)) {
  
  call_out("spass", 1);  }}
  
  spass()   {
  
  if(environment(TP)!=TO) {return 1; }
  else
  {
  switch(random(15))  {
  case 0..2:
  write(BS(
  "Du rutscht auf dem Felsen aus und schlaegst Dir den Kopf an!"));
  Z
  TP->do_damage(5);
  break;
  case 3..4:
  write(BS(
  "Du rutscht auf dem Felsen aus und faellst wieder zurueck ins Wasser! "
  "Die starke Stroemung treibt Dich sofort wieder an den Sandstrand!"));
  Z
  TPM("/d/dschungel/dante/fisch/room/sand5", M_GO,
  "vom Felsen und wird von der Stroemung weggerissen!", "faellt",
  "wird angespuelt");
  break;
 case 5..10:
  write(BS(
  "Du rutscht auf dem Felsen aus, faellst aber nicht ins Wasser!"));
  Z
  break;
 case 11..13:
  write(BS(
  "Du bist geschickt und rutscht auf dem Felsen nicht aus!"));Z
  break;
  case 14:
  write(BS("Du wirst von einer grossen Welle getroffen, die gerade "
  "in dem Moment wo Du auf den Felsen kletterst, den Felsen ueberrollt! "
  "Die Welle spuelt Dich brutal in den Fluss, und der Fluss auf einen "
  "anderen Felsen! AUA!!!"));
  Z
  TP->do_damage(10);
  TPM("/d/dschungel/dante/fisch/room/fels", M_GO,
  "von einer Welle weitweg geschleudert", "wird",
  "wird von einer Welle hereingeschleudert");
  break;
  default: write("tja!\n");
  }   }  }
    


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsen mitten im Fluss" );
  SetProp( P_INT_LONG, BS(
  "Der Felsen auf dem Du nun stehst liegt schon recht nahe beim "
  "Wasserfall. Das Wasser spritzt schnell an Dir vorueber, die "
  "Wellen schlagen fast bis zu Dir herauf. Eine weisse Gischt "
  "kraeuselt sich rings um den Felsen und das Tosen der nahen "
  "herabstuerzenden Wassermassen laesst Dich kaum Dein eigenes Wort "
  "verstehen. Du kannst von hier entweder zurueck an den Strand "
  "oder aber auch zu einem anderen nahen Felsen schwimmen."));
  
AD(({"wassermassen","massen"}),
"Gigantische Massen von Wasser rasen im Westen herab.");


AD(({"welle","wellen"}),
"Die Wellen schlagen hoch herauf. Ab und zu spritzt etwas Wasser auf Dich.");
AD("gischt",
"Die Gischt tobt unter Dir nach Osten weiter.");
AD("osten",
"Im Osten liegt der Strand.");
AD("strand",
"Der Strand ist im Osten. Du kannst dorthin schwimmen.");
AD("tosen",
"WUMMMMMMMMMMMMMMMMMMMMM!!!");

AD("wort",
"Wie bitte?! Verstehe nix!");


AD(({"fels","felsen"}),
"Der Felsen ist sehr rutschig und nass. Er schuetzt Dich aber vor "
"der wilden, weissen Gischt. Du siehst in aber auch noch einen "
"anderen Felsen ganz nahe bei dem, auf dem Du gerade stehst!!!");

AD(({"anderer fels","anderer felsen"}),
"Du kannst dorthin schwimmen. Es scheint dort etwas ruhiger zu sein!");

AD("boden",
"Der Boden des Felsens ist sehr rutschig.");
AD(({"decke","himmel"}),
"Der Himmel ist strahlendblau.");
AD(({"wand","waende"}),
"Nicht hier.");




AD("fluss",
"Der Fluss ist hier noch sehr wild. Im Westen liegt ja auch der "
"Wasserfall.");
AD("westen",
"Im Westen stuerzt der gigantische Wasserfall herab.");
AD(({"wasserfall","fall"}),
"Der Wasserfall scheint wirklich enorm hoch zu sein. Er rast tosend "
"herab und wuehlt hier unten das Wasser auf.");


     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );


AD("wasser",
"Das Wasser rauscht hier knapp neben Dir von oben kommend vorbei, um "
"sich unten in tosenden Sprudeln zu beruhigen. Das Wasser ist hier "
"sehr sauerstoffreich. Ideal fuer Fische, die klares, sauberes, sauerstoffreiches, wildes "
"Wasser lieben.");
AD(({"sprudeln", "sprudel"}),
"Wild tost das Wasser von oben herab und bildet direkt unter Deinem Felsen "
"Sprudel. Es zischt und brodelt wild.");



SHOW_FISCH








  AddSound( DEFAULT_SOUND,
    "Der Wasserfall rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
AddSmell("luft",
"Feucht.");
AddSound(({"tosen","wasserfall"}),
"WUMMMMMMMMMMMMMMMMMM!!!");

DO_ANGEL



AIT("d/dschungel/feyaria/felseninsel/npc/moewe", REFRESH_DESTRUCT);
   

ACD(({"schwimm", "schwimme"}), "swim");
}

int do_angel()   {
	object oba, obb;
	obb=present("DANTE_ANGEL_WATTWURM", TP);
	oba=present("DANTE_ANGEL", TP);
	
if(present("fishingaction", TP))   {
	write("Aber Du angelst doch schon!!!\n");
	return 1; }
		
	
     if(!oba)  {
     	write("Du hast keine geeignete Angel!\n");
     	return 1; }

    if((oba) &&(!obb))  {
   	write(BS("Du wirfst Deine Angel gekonnt aus und wartest."));
   	call_out("fail", TI);
   	  oba->AddId("fishingaction");
   	say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
   	return 1; }

        if(obb)  {	   
     	write("Du wirfst Deine Angel gekonnt aus und wartest.\n");
        say(CAP_TPN+" wirft die Angel gekonnt aus.\n");
        call_out("ok", TI);
        obb->AddId("fishingaction");
           return 1; }
        return 0; }
 
 
 //das hier muss sein damit die spieler nicht 100000000
 //fische erzeugen koennen
 reset()  {
 	::reset();
  fische=MAX;   }
  	
 
 
        
    fail()   {object ob;
    	ob=present("DANTE_ANGEL", TP);
    	if(ob)  {  
    	ob->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    else  {
    write(BS(
  "Du holst die Angel wieder ein, irgendetwas scheint nicht zu stimmen. "
  "Der Koeder, der Ort..."));
    return ; }
}

 
        
        
    ok()   {object obb, ob;
    	obb=present("DANTE_ANGEL_WATTWURM", TP);
    	if(obb)  {  
    	obb->RemoveId("fishingaction");}
    	
    		if(environment(TP)!=TO) {
    write(BS("Da Du den Angelplatz verlassen hast, kannst "
    		"Du natuerlich nichts fangen..."));
    		return ;   }
    		
    	if(fische>= MAX)  {
    		write(BS(
    "Du ziehst die Angel aus dem Wasser, das Gewaesser scheint "
    "leer gefischt zu sein. Warte ein wenig bitte!"));
    return ; }
    			
    		
    else  {
    write(BS(
"Irgendetwas zieht an Deiner Angel! Du reisst sie aus dem Wasser!"));
    
    switch(random(10))  {
      case 0: 
      write("Leider ist der Haken leer!\n"); return ;
      break;
    case 1..7:
    ob=clone_object("/d/dschungel/dante/fisch/obj/lachs");
    break;
    case 8..9:
     ob=clone_object("/d/dschungel/dante/fisch/obj/stdfore");
     break;
      default:ob=clone_object("/d/dschungel/dante/fisch/obj/lachs");
}

fische++;
  write(BS("Ein Fisch zappelt am Haken! "
  ""+ob->short()+"Du nimmst den Fisch"
  " sofort vom Haken und steckst ihn ein!!!"));
  write("Dein Koeder scheint noch gut zu sein!!!\n");
  
//der koeder bleibt absichtlich gut wuerde die spieler nur nerven
//dauernd koeder raufstecken und sammeln zu muessen!!!!
  ob->move(TP, M_GET);
}

    }





    
 string show_fisch()   {
    switch(random(7))   {
    case 0:
    write("Du glaubst fuer den Bruchteil einer Sekunde eine Forelle zu sehen!\n");
    break;
    case 1:
    write("Ein Lachs versucht den Wasserfall zu ueberwinden!\n");
    break;
    case 3:
    write("Im Moment siehst Du leider keinen Fisch!\n");
    break;
    case 4:
    write("Du glaubst einen roten Lachs zu sehen!\n");
    break;
    case 5:
    write("Die Sprudel sind momentan zu stark!\n");
    break;
    case 6:
    write("Du glaubst eine Regenbogenforelle zu sehen!\n");
    break;
    default: write("Ein Lachs springt kurz aus dem Wasser hoch!\n");}
     return"";}
    
 
int swim(string str)  {
 NF("Wohin willst Du schwimmen?!\n");

  if(str=="zum strand"||str=="zu strand"||
  str=="zum sandstrand"||str=="zu sandstrand")  {
   write(BS(
   "Du springst ins Wasser und schwimmst mit der Stroemung sehr schnell "
   "zum Strand zurueck!"));Z
    say(CAP_TPN+" springt ins Wasser!\n");
    TPM("/d/dschungel/dante/fisch/room/sand5",M_GO,
    "bis zum Strand zureuck", "schwimmt", "kommt aus dem Wasser gestiegen");
    return 1; }


if(str=="zu fels"||str=="zum felsen"||str=="zu felsen"||
str=="zu anderen felsen"||str=="zu anderem fels"||
str=="zum anderen felsen")  {

	write("Du stuerzt Dich ins Wasser und schwimmst zum anderen Felsen");
TPM("/d/dschungel/dante/fisch/room/fels3", M_GO,
"zum anderen Felsen","schwimmt","kommt heraufgeklettert");
   return 1;  }
   	

    return 0; }
       
