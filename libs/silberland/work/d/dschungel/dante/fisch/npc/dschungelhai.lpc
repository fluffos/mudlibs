// dante@SilberLand
//grosser gruener dschungelhai
//Nur mit spez waffe zu toeten
 
inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"
int hai;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser, gruener Dschungelhai");
  SetProp(P_LONG, BS(
  "Das ist einer der legendaeren, grossen, gruenen Dschungelhaie. "
   "Seine Flossen leuchten "
  "gruen-blau, aber das ist durch das Wasser nicht so genau zu erkennen, "
  "Du siehst ja nicht den ganzen Hai, sondern nur seine Flossen!"));
  AddDetail(({"flossen","flosse"}),
 "Gruen und blau leuchten sie durch das Wsser hindurch, ein schoener Anblick!");
  SetProp(P_NAME, "Dschungelhai");
  SetProp(P_GENDER, MALE);
  SP(P_NAME_ADJ, ({"gross", "gruen"}));
  AddId(({"DANTE_DSCHUNGELHAI", "hai", "dschungelhai"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(17);
  SetProp(P_BODY, 70);
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -500);
  SetProp( P_RESISTANCE_STRENGTHS,
  ([ DT_SLASH:0.6,DT_HOLY: 0.1, DT_TERROR:-1.0, DT_BLUDGEON:0.5]));
   
   SP(P_KILL_NAME, "Der grosse, gruene Dschungelhai");
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schiesst ploetzlich aus der Tiefe hervor");
  SetProp(P_MMSGOUT, "schiesst davon");
  
  SetProp(P_DIE_MSG,  " versinkt blutend in den Fluten!\n");
  
  
  
    
  AddInfo(DEFAULT_INFO, "schlaegt mit den Flossen!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Hai damit?!\n" }) );



SetChats(15,({
//absichtlich hoch
 "Der Dschungelhai umkreist Dich!\n",
 "Der Dschungelhai bleckt seine Zaehne!\n",
 "Du fuehlst Dich nicht gut hier!\n",
 "Hau lieber ab!\n",
 "Der Dschungelhai schlaegt wild mit seinen Flossen!\n"})); 
  
  } 


die(arg)
  {
  object ob, harpune;
  harpune=present("DANTE_HARPUNE", TP);
  call_other("/d/dschungel/dante/fisch/room/hairaum", "new_shark", TP);
  if((!deep_present("DANTE_FLOSSEN", TP)) &&
  (present("DANTE_FISCH_LISTE_ZWEI", TP))&& (harpune))
     {

  write("Sterbend reisst der Hai Dir die Harpune aus der Hand!\n"
  "Du schneidest ihm dafuer schnell noch eine Flosse ab!\n");  
  ob=CLONEOB(FO"haiflosse");
  ob->move(TP, M_GET);
  harpune->remove(1);
        }
        
  ::die(arg);
}

  
 Defend(int dam, string dtype, int spell, object enemy)
   {
   object harpune;
   harpune=present("DANTE_HARPUNE", TP);

if(!harpune)  {
   	   tell_object(enemy,
   	   "Dein Angriff verfehlt den Dschungelhai!\n"
   "Der Dschungelhai schlaegt seine Zaehne in Dein Bein!\n");
   TP->do_damage(10+random(20));  
 return ::Defend(0, dtype, spell, enemy);}

 
 if(harpune)  {

 	if(harpune->QP(P_WIELDED))   {
 

   tell_object(enemy,
   "Du bohrst Deine Harpune in den Dschungelhai!\n");
 return ::Defend(dam*2, dtype, spell, enemy);
     }
   else
   {
tell_object(enemy,
"IDIOT! Wofuer ist wohl Deine Harpune!!!\n");
  return ::Defend(0, dtype, spell, enemy);}
          }
    }





  heart_beat()
  {
    ::heart_beat();
        return ::heart_beat();
          }




Attack(object enemy)
{
SetProp(P_HANDS,({" mit seinen "+((hai=!hai)?"scharfen":"scharfen")+" Zaehnen",
 200+random(20),({DT_RIP,DT_PIERCE}) }));             
    return ::Attack(enemy);
    }          

