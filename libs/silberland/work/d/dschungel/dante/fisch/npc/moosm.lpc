// dante@SilberLand

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


int moos;
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein vierarmiges, zweikoepfiges Moosmonster");
  SetProp(P_LONG, BS(
  "Das Moosmonster hat einen gedrungenen, kraeftigen Koerper, "
  "der rund um mit Moos ueberwuchert ist. Vier Arme, zwei Koepfe "
  "hauen sicherlich gewaltig zu."));
  AddDetail(({"koepfe","kopf"}),
  "Zwei!");
  AddDetail(({"arm","arme"}),
  "Vier!");
  AddDetail("moos",
  "Ueber und ueber ist es damit bewachsen!\n");
  AddDetail("koerper",
  "Bullig und mit Moos ueberzogen!\n");  
  SetProp(P_NAME, "Moosmonster");
  SetProp(P_GENDER, NEUTER);
  AddId(({"monster", "moosmonster", "MOOS"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(20);
  SetProp(P_BODY, 60);
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 4);
  SetProp( P_RESISTANCE_STRENGTHS,([ DT_SLASH:0.6,DT_HOLY: 1.0, DT_TERROR:-1.0, DT_BLUDGEON:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "schiesst herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "schiesst ploetzlich aus dem Moos hervor");
  SetProp(P_MMSGOUT, "schiesst davon");
  
  SetProp(P_DIE_MSG,  " bricht bruellend und tobend nieder!\n");
  
    
  AddInfo(DEFAULT_INFO, "bruellt laut!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll das Moosmonster damit?!\n" }) );

  SetProp(P_SPELLRATE,40);
  
  AddSpell(3,300,
    "Das Moosmonster stoesst mit einem Kopf nach Dir.\n",
    "Das Moosmonster stoest mit einem Kopf nach @WEM.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Das Moosmosnter schnappt mit seinem linkem Kopf nach Dir.\n",
    "Das Moosmonster schnappt mit seinem linkem Kopf nach @WEM.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Das Moosmonster schnappt mit seinem rechtem Kopf nach Dir.\n",
    "Das Moosmonster schnappt mit seinem rechtem Kopf nach @WEM.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,400,
  "Das Moosmonster stopft Dir Moos in den Mund!\n",
  "Das Moosmonster stopft Dir Moos in den Mund!\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,500,
    "Das Moosmonster rammt Dich brutal.\n",
    "Das Moosmonster rammt Dich brutal.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

SetChats(15,({
//absichtlich hoch
 "Der rechte Kopf des Moosmonsters dreht sich zu Dir.\n",
 "Der linke Kopf des Moosmonsters dreht sich zu Dir.\n",
 "Die vier Arme sehen ziemlich bedrohlich aus.\n",
 "Das Moosmonster bedraengt Dich.\n",
 "Das Moosmonster bruellt auf einmal laut auf.\n",
 "Das Moosmonster grunzt angressiv.\n"}));
 
  
  } 


die(arg)
  {
  object ob;
  if(present("DANTE_FISCH_LISTE_DREI", TP))  {
  ob=clone_object("d/dschungel/dante/fisch/obj/moosbone");
  ob->move(TP, M_NOCHECK);  
  write(BS(
  "Das Moosmonster schleudert sterbend einen eigenen Knochen auf Dich!"));
  }
  ::die(arg);
  }
  

 Defend(int dam, string dtype, int spell, object enemy)
   {
       if (!pointerp(dtype))
           dtype = ({ dtype });
  
  
  
          if (sizeof(dtype & ({ DT_WATER }) ))
          
                  {
   tell_room(environment(), "Das Moosmonster lacht laut!\n");
    heal_self(dam);
      return ::Defend(0, dtype, spell, enemy);
                                        }         
  


  
   if (sizeof(dtype & ({ DT_FIRE }) ))
          //abenteuerer vor!!!
                  {
 tell_room(environment(), "Das Moosmonster bruellt vor Schmerz!\n");
                           
                                
 return ::Defend(dam*2, dtype, spell, enemy);
   }         
  

 return ::Defend(dam, dtype, spell, enemy);
          }

  
  heart_beat()
  {
    ::heart_beat();
        return ::heart_beat();
          }



Attack(object enemy)
{
SetProp(P_HANDS,({" mit dem "+((moos=!moos)?"linkem":"rechtem")+" Kopf",
 100+random(20),({DT_RIP,DT_UNHOLY}) }));             
    return ::Attack(enemy);
    }          

