//dante harpye fuer quest fische!
inherit "std/npc";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine nachtschwarze Harpye");
  SetProp(P_LONG, BS (
    "Die Harpye ist ein gewaltiger Vogel mit maechtigen Klauen. Sie hat die "
    "Gestalt eines Uhus, nur ist sie viel, viel gewaltiger. Ihr spitzer stein"
    "harter Schnabel hat so manchen Angreifer das Fuerchten gelehrt. An ihrem"
    " maechtigen Schaedel fallen Dir besonders die dunkeln, unheimlichen Augen"
    " auf."));
  AddDetail(({"schaedel","augen"}),
    "Die Augen der Harpye blicken Dich durchdringend an und Du hast das un"
    "angenehme Gefuehl, dass in diesem Vogelkoerper mehr steckt...\n");                                                                                             
  SetProp(P_NAME, "Harpye");
  SetProp(P_GENDER, FEMALE);
  AddId( ("harpye") );
  AddId("vogel");
  SP(P_NAME_ADJ, "nachtschwarz");
  
  AddDetail( ({"klaue", "klauen"}),
    "So gigantische Klauen hast Du bei einem Vogel noch nie gesehen.");
  AddDetail(("schnabel"),
    "Der Schnabel der Harpye koennte Dir muehelos den Arm abreissen.\n");
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren furchtbaren Klauen", 160, DT_RIP,DT_MAGIC}));
  SetProp(P_MAX_HP, 300);
  SetProp(P_BODY,40);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, " schaut Dich nur wissend an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Harpye will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " stuerzt toedlich verwundet ab.\n");
  SetProp(P_KILL_MSG, ("Die Harpye zerfetzt Deinen Kadaver.\n")); 
  SetProp(P_INFO, ("Die Harpye ist ein magischer Vogel."));
  SetProp(P_HEAL,30);
  SetProp( P_RESISTANCE_STRENGTHS,([DT_MAGIC:-0.9, DT_BLUDGEON:-0.3,
  DT_FIRE:0.5, DT_WATER:-0.8,DT_COLD:-1.0]));      
  SetProp(P_NOMAGIC, 3);
  SetProp(P_SPELLRATE, 40);
  
  AddSpell(5, 300, 
    "Die Harpye greift Dich mit ihrem spitzen Schnabel an.\n",
    "Der Harpye greift @WEN mit seinem spitzen Schnabel an.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));      
                                                                   
  AddSpell(2, 300, 
    "Der Harpye zerfetzt Deinen Koerper.\n",
    "Der Harpye zerfetzt @WESSEN Koerper.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));      
    
  AddSpell(5, 300,
    "Die Harpye reisst Dir einen Arm ab.\n",
    "Die Harpye reisst @WEM einen Arm ab.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));      
    
  AddSpell(4, 200,
    "Die Harpye hackt ein Stueck Fleisch aus Deinem Arm.\n",
    "Die Harpye hackt ein Stueck Fleisch aus @WESSEN Arm.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));      
    
  AddSpell(1, 500,
    "Der boese Blick der Harpye trifft Dich.\n",
    "Der boese Blick der Harpye trifft @WEN.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));      
    
  AddSpell(2, 350,
    "Ein Blitz faehrt aus den Augen der Harpye auf Dich herab.\n",
    "Ein Blitz faehrt aus den Augen der Harpye auf @WENN herab.\n",
      DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));      
    
    
      SetProp(P_MSGIN, "taucht auf");
      SetProp(P_MSGOUT, "segelt herein");
      SetProp(P_MMSGIN, "taucht auf");
      SetProp(P_MMSGOUT, "schnellt davon");
          
  

 SetChats(4, ({
    "Die Harpye funkelt Dich mit ihren tiefgruendigen Augen an.\n",
    "Die Harpye fluestert etwas in einer fremdartigen Sprache.\n",
    "Die Harpye wendet ihren Kopf um 180 Grad.\n",
    "Neben diesem gigantischen Vogel kommst Du Dir sehr mickrig vor.\n",
    "Die Harpye versucht Dir etwas mit zu teilen.\n",
    "Die Harpye versinkt in eine totenaehnliche Trance.\n",
    "Die Harpye fluestert 'Nelabinnak'...\n",
    "Die Harpye gurrt 'Huete Dich vor dem Boesen'\n",
    "Die Harpye wetzt ihre gewaltigen Klauen.\n",
    "Die Harpye reisst ihren maechtigen Schnabel auf.\n"}));
 SetAttackChats(20, ({
    "Die Harpye kreischt: Das war ein Fehler, Du Unwissender.\n",
    "Die Harpye versucht Dir den Schaedel zu knacken.\n",
    "Die Harpye stoesst von oben auf Dich herab.\n",
    "Die Harpye will Dich zerreissen.\n",
    "Du beginnst zu taummeln.\n",
    "Du stolperst und faellst hin.\n",
    "Fluechte Sterblicher, fluechte...\n"}));
 
 
 
 AddInfo(({"krake"}),
 "Hmm, ja angeblich soll die irgendwo leben. Irgendwie "
 "soll man auch zu ihr gelangen koennen. Angeblich muss "
 "man irgendwo ein Feuer entzuenden oder so...", "sagt: ");
 AddInfo("dante",
 "sagt: Der macht mir nur Sorgen!\n");   
 AddInfo("dschungel",
    "sagt: Der Dschungel steckt voller Gefahren....\n");
 AddInfo("medaillon",
    "kreischt: Das besitzt nur Tantalus!\n");
AddInfo("feuer",
"Das Feuer kann man nur als Wissender und nur an einer bestimmte Stelle "
"entfachen!", "sagt leise: ");
AI("stelle",
"Dort wo der Boden nachtschwarz ist und die Waende nichts heller!",
"sagt: ");
AI("wissender",
"Wenn Du dem alten Fischer geholfen hast, wird er Dir mehr verraten!",
"sagt weise: ");
AI("fischer",
"Der alte Fischer lebt in einer Hoehle in den Klippen.",
"sagt: ");
AI("hoehle",
"Direkt in den Klippen!", "sagt: ");
AI("klippen",
"Na, wo die sind solltest Du aber wissen?!?!", "lacht: ");
AI(({"schwarze kerze","kerze"}),
"Hmm, ich hab eine. Bekommst Du aber nicht!", "sagt: ");


AI(({"krakenauge", "auge"}),
"Soso, Du willst ein Krakenauge holen. Du Wicht?! Nun gut, dazu braucht man eine "
"schwarze, magische Kerze und dann muss man zum Moosmonster.", "sagt: ");
AI(({"moosmonster","monster"}),
"Frag lieber den alten Fischer, der weiss das sicher...", "sagt: ");



AddCmd(({"saeubere","saeuber", "sammle", "sammel", "putze", "putz",
 "ziehe", "zieh","mach", "raeume"}), "nix", 1);
  }


  
 Defend(int dam, string dtype, int spell, object enemy)
   {
    if(!present("DANTE_FISCH_LISTE_DREI", TP))  {
    write("Die Harpye ist von Dir nicht zu treffen!\n");
     return ::Defend(0, dtype, spell, enemy); }
     else{
      return ::Defend(dam, dtype, spell, enemy); }
          }





int nix()
   {
   write("Die Harpye hackt Dir ins Bein!\n");
   TP->do_damage(10);
   return 1;
   }
   

  init(){
    ::init();
      if(interactive(TP)){
      write("Die Harypye kraechzt: Hallo "+CAP_TPN+", was treibt Dich hier her.\n");
      }
    }  

die(arg) {
object ob;
 call_other("d/dschungel/dante/fisch/room/nest2", "new_bird");
if((!deep_present("vkerze", TP))&&
    (present("DANTE_FISCH_LISTE_DREI", TP))) {
     ob=clone_object("/d/dschungel/dante/fisch/obj/vkerze");
     ob->move(TP, M_GET);
     write("Du durchwuehlst die Leiche und findest eine schwarze Kerze!\n");
     }
 ::die(arg);}
  
