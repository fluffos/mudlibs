// dante@SilberLand

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


string *liste;

int anzahl=5;
int preis=1000+random(1000);

int info_liste();
object money;

init(){
::init();
if(interactive(TP))  {
call_out("hallo", 1); }}

hallo() {
	
if(environment(TO)!=environment(TP)) return ;

write(BSA(
"Hallo, "+TPN+"! Was machst das Fischen?!",
"Gus sagt: ")); }





void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Fischer namens Gus");
  SetProp(P_LONG, BS(
"Das ist Gus. Er fischt hier schon lange, verraet aber kaum etwas ueber "
"Fische oder Koeder. Also frag ihn gar nicht danach. Er kann Dir aber "
"Fische verkaufen. Du hast die Moeglichkeit gegen einen Preis von "
""+preis+" Muenzen bei ihm "+anzahl+" Fische zu kaufen. Frag ihn einfach nach "
"Fisch."));

  SetProp(P_NAME, "Gus");
  SetProp(P_GENDER, MALE);
  AddId(({"gus", "fischer"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(40);
  SetProp(P_BODY, 100);
  SetProp(P_MAX_HP, 2000);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 100);
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 100);
  SetProp(P_MSGIN, "kommt pfeiffend herein");
  SetProp(P_MSGOUT, "geht singend");
  SetProp(P_MMSGIN, "kommt pfeiffend hier her");
  SetProp(P_MMSGOUT, "laeuft davon");
  

    SetProp(P_MNPC_WAIT, ({10, 30 , 30}));
 
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS + 
  MOV_OUTDOORS+MOV_SPECIAL+MOV_INFIGHT); 
   SetProp(P_MNPC_AREA, "/d/dschungel/dante/fisch/room/");
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fisch/room/sand3");
 
  SetProp(P_DIE_MSG,  " bricht sternd nieder!\n");
  
  
  money=clone_object("obj/money");
  money->AddAmount(preis*random(1+3) );
  money->move(TO, M_NOCHECK);
  
  AI(({"fisch","fische"}),
  "Ich kann Dir genau "+anzahl+" verkaufen! Frag mich mal nach Liste!",
  "sagt: ");
  
    
  AddInfo(DEFAULT_INFO, "sagt: Gib Ruhe! Ich sage Dir nichts!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll Gus damit?!\n" }) );

  SetProp(P_SPELLRATE,60);
  
 AddSpell(1,400,
  "Das Gus, der alte Fischer stopft Dir einen Fisch in den Mund!\n",
  "Das Gus, der alte Fischer stopft Dir einen Fisch in den Mund!\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,500,
    "Das Gus, der alte Fischer rammt Dich brutal.\n",
    "Das Gus, der alte Fischer rammt Dich brutal.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

SetChats(5,({
 "Gus sagt: Die Fische werden immer kleiner.\n",
 "Gus ruelpst laut.\n"
 "Gus stinkt nach Fisch.\n",
 "Gus sagt: Fischen ist eine Kunst!\n",
 "Gus sagt: Du siehst ja aus wie ein alter Hering.\n",
 "Gus sagt: Dieser verfluchte Tantalus.\n",
 "Gus zeigt Dir einen grossen Fisch.\n",
 "Gus sagt: Beim Fischen braucht man Geduld.\n"}));
  
  
  
  AddInfo( ({"liste"}), #'info_liste, "sagt: "); 
  
 ACD(({"kaufe","kauf"}), "get_fisch");
  
liste=({
