int get_fisch(string str)  {
object fisch;
string iden;
object muetze;

    NF("Gus sagt: Welchen Fisch willst Du genau kaufen!?\n");
    if(!str) return 0;



muetze=deep_present("DANTE_FISCH_LISTE", TP);

if(!muetze)  {
	
	write(BSA(
"Du kannst bei mir leider gar nichts kaufen! Tut mir leid!",
"Gus sagt: "));
return 1; }


if(deep_present("KEIN_KAUF_MEHR", TP))  {

write(BSA(
"AH! Hier hast Du...NEIN! Moment! Du hast schon "+anzahl+" Fische bei mir "
"gekauft. Das reicht!", 
"Gus sagt: "));


	return 1; }
	
	




if(TP->QueryMoney()< preis)  {
    write(BSA(
    "Du hast leider weniger als "+preis+" Muenzen bei Dir! Du "
    "kannst also den Fisch nicht bezahlen. Tut mir leid!",
    "Gus sagt: "));
    return 1; }



iden=str;  //kleiner hack um dann ne id aus der short zu kriegen

   str=this_player()->_unparsed_args(); 
if(member_array(str, liste)==-1)   {
    write(BSA(
    "Sorry, aber diesen Fisch habe ich nicht! Hast Du Dich vielleicht geirrt?!",
    "Gus sagt: "));
                
                return 1;               
                           }

    
  if(member_array(str, liste)!=-1)   {  
    write(BSA(
   ""+str+"! Sehr gut! Soetwas habe ich bei mir! Hier hast Du!",
   "Gus sagt: "));
   write(BS(
   "Du gibst Gus "+preis+" Muenzen."));
   TP->AddMoney(-preis);
   TO->AddMoney(preis);
   write("Gus gibt Dir den Fisch.\n");
   
   fisch=clone_object("d/dschungel/dante/fisch/obj/gus_fisch");
   
   fisch->SetProp(P_NAME, "Fisch");
   
   fisch->SetProp(P_SHORT, ""+str+"");
   fisch->SetProp(P_LONG, BS(
   "Diesen Fisch hat "+CAP(getuid(TP))+" von Gus dem alten Fischer gekauft. "
   "Es handelt sich hierbei um: "+str+". Hoffentlich wird Doby Mick nicht "
   "erkennen, dass Du diesen Fisch nicht selbst gefangen hast."));


muetze->spieler_kauft_fisch();






   
  fisch->AddId(""+iden+"");
   
   if(strstr(str, "aal"))  {
       fisch->AddId("aal");  
                           }
 if(strstr(str, "lachs"))  {
       fisch->AddId("lachs");  
                           }
 if(strstr(str, "wels"))  {
       fisch->AddId("wels");  
                           }

 if(strstr(str, "forelle"))  {
       fisch->AddId("forelle");  
                           }
 if(strstr(str, "hai"))  {
       fisch->AddId("hai");  
                           }
 if(strstr(str, "karpfen"))  {
       fisch->AddId("karpfen");  
                           }
 if(strstr(str, "orfe"))  {
       fisch->AddId("orfe");  
                           }
 if(strstr(str, "flunder"))  {
       fisch->AddId("flunder");  
           } 

      if(strstr(str, "scholle"))  {
       fisch->AddId("scholle");  
                           }
 if(strstr(str, "barsch"))  {
       fisch->AddId("barsch");  
                           }

 if(strstr(str, "rochen"))  {
       fisch->AddId("rochen");  
                           }

 if(strstr(str, "saibling"))  {
       fisch->AddId("saibling");  
                           }




   	
   
   fisch->move(TP, M_NOCHECK);
   
   
   
          return 1;       
                          }
   write(""+str+"\n");
   
      return 0; }
   	




int info_liste()  {
int i;



write(BSA(
"Momentan habe ich folgende Fische zu verkaufen:","Gus sagt: "));

write("\n");

  for (i=sizeof(liste)-1;i>=0;i--)    {
    write(sprintf( "%s", capitalize(liste[i]))+(i==0?" !":", ")); 
 }
 
write("\n");






write(BSA(
"Die Syntax ist: <kaufe name>. Wobei der Name genau so sein muss wie "
"in der Liste oder in wie in der Muetze aufgefuehrt! <Also z.B.: Ein duenner Aal>.",
"Gus sagt: "));


      return 1;
   }	