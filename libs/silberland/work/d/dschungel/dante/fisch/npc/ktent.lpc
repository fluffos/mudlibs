//die tentakel des kraken tantalus

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Tentakel von Tantalus");
  SetProp(P_LONG, BS(
  "Dieser Tentakel gehoert zu Tantalus. Saugnaepfe so gross wie Dein Kopf und "
  "spitze, giftige Haken machen ihn zu einer toedlichen Bedrohung."));
  SetProp(P_NAME, "Tentakel");
  SetProp(P_GENDER, MALE);
  AddId(({"tentakel", "KTENT"}));
  SetProp(P_ARTICLE, 1);
  set_living_name("KTENT");
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 51]));
  create_default_npc(5);
  SetProp(P_HANDS, ({" mit giftigen Saugnaepfen",100,DT_POISON}));
  SetProp(P_BODY, 30);
  SetProp(P_SIZE, 10000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL,-20);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  
  SetProp(P_NOCORPSE, 0);
     
  SetProp(P_MSGIN, "schnellt bedrohlich surrend herein");
  SetProp(P_MSGOUT, "schnellt bedrohlich surrend");
  SetProp(P_MMSGIN, "schnellt bedrohlich surrend herein");
  SetProp(P_MMSGOUT, "schnellt surrend davon");
  
  
  SetProp(P_DIE_MSG,  " wird von Dir vom Koerper abgeschlagen!\n");
  
  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen!\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Tentakel damit?!\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(3,100,
    "Der Tentakel saugt sich an Dir fest.\n",
    "Der Tentakel saugt sich an @WEM fest.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,150,
    "Der Tentakel saugt an Deinem Auge.\n",
    "Der Tentakel saugt an Deinem Auge.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));


  AddSpell(1,170,
    "Der Tentakel spritzt Dir Saeure ins Gesicht.\n",
    "Der Tentakel spritzt @WEM Saeure ins Gesicht.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));

  
  } 



 Defend(int dam, string dtype, int spell, object enemy)
   {
   	object waf;
   waf=present("krakenwaffe", enemy);	
  
  if(!waf)  {
 return ::Defend(0, dtype, spell, enemy);    
                    
                    }

 
 if(waf)  {

 	if(waf->QP(P_WIELDED))   {
 return ::Defend(dam*3, dtype, spell, enemy);
     }
   else
      
      
      {
  return ::Defend(0, dtype, spell, enemy);}

          }
    }



   _query_wimpy()  {
   	return 0; }
   	