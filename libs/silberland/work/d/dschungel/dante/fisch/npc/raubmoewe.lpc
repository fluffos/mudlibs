inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define AREA "/d/dschungel/dante/fisch/room/"
#define TIME 10

int flug=0;

init()  {
    object env;
     ::init();

if(!environment(TO)) {return;}	


env=present("fisch", environment(TO));


if(!env || interactive(env) )  { call_out("fliegen", TIME); return; }


	
  if(env)  {
  call_out("vertilgen1", 2);
           }
  	
  }




vertilgen1()  {
 	
     object env;
     env=present("fisch", environment(TO));


if(!env || interactive(env) )  { call_out("fliegen", TIME); return; }

if(env)      {
	
  env->remove();
  say(BS(
"Die Raubmoewe stuerzt sich sofort auf alles Fischaehnliche und verschlingt es."));
  
   vertilgen();
           }
  	
  }





vertilgen()  {
 	
     object env;
     env=present("fisch", environment(TO));


if(!env || interactive(env) )  { call_out("fliegen", TIME); return; }

if(env)      {
	
  env->remove();
   vertilgen();
           }
  	
  }







fliegen()  {

//object dante;
//dante=find_living("dante");

/*if(dante)  {
 tell_object(dante,
 "flug: "+flug+" hier anfang\n"); }
 */
 
if(find_call_out("fliegen")!=-1 )  { remove_call_out("fliegen");  }


switch(flug)  {
 case 0:
TO->move(AREA"fels", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
   if(find_call_out("fliegen")!=-1 )  { remove_call_out("fliegen");  }
        break;
 case 1:
