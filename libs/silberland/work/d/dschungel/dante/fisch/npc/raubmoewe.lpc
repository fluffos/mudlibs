"kreischend davon", "segelt","kommt kreischend hereingeflogen");

        break;  
   case 4:
TO->move(AREA"hairaum", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;       
   case 5:
TO->move(AREA"tauch2", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;      
case 6:
TO->move(AREA"sand1", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;  
case 7:
TO->move(AREA"sand2", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");       
 break;  
case 8:
TO->move(AREA"sand3", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;  
case 9:
TO->move(AREA"sand4", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;  
case 10:
TO->move(AREA"sand5", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;     
case 11:
TO->move(AREA"sand6", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;     
case 12:
TO->move(AREA"sand7", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;
case 13:
