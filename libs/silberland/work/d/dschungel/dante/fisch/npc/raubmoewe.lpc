"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;    
case 14:
TO->move(AREA"bruecke4", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
        break;                                    
default: 
TO->move(AREA"sand1", M_GO+M_NOCHECK,
"kreischend davon", "segelt","kommt kreischend hereingeflogen");
      
       }
       

       
flug++;

/*if(dante)  {
 tell_object(dante,
 "flug: "+flug+" mitte \n"); }
*/

if(flug>=15)  {
flug=0;  

/*if(dante)  {
 tell_object(dante,
 "flug: "+flug+" hier ende \n"); 
}
*/
              }	
      }
 







create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine gewaltiggrosse Raubmoewe");
  SetProp(P_LONG, BS(
 "Die Raubmoewe ist ein gewaltig-grosser Vogel, der Fische sehr schnell "
 "aufspuert und sofort frisst! Diese hier ist so gross, das sie fast einem "
 "Drachen aehnelt! Greife sie besser nie an!!!"));
  SetProp(P_NAME, "Raubmoewe");
  SP(P_NAME_ADJ, "gewaltiggross");
  SetProp(P_GENDER, FEMALE);
  AddId(({"moewe","raubmoewe"}));
  set_living_name("raubmoewe");
  create_default_npc(99);
  SetProp(P_HANDS, ({" mit ihrem spitzen Schnabel", 777, DT_PIERCE}));
  SetProp(P_ALIGN, -100);  // frech
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 340+random(100));
  SetProp(P_HEAL, 5+random(5) );
  
  
   SetProp(P_MSGIN, "landet ploetzlich neben Dir");
  SetProp(P_MSGOUT, "segelt auf und davon");
  SetProp(P_MMSGIN, "landet ploetzlich kreischend neben Dir");
  SetProp(P_MMSGOUT, "segelt kreischend auf und davon");

  SetProp(P_MNPC_AREA, AREA);
  


//  SetProp(P_MNPC_WAIT, ({7, 5 , 5}));
 
 /* SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS + 
  MOV_OUTDOORS+MOV_SPECIAL+MOV_MAYLOAD+MOV_INFIGHT); 
 
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/fisch/room/sand1");
 */
  
  
  
  
  
  SetAttackChats(10, ({"Die Raubmoewe kreischt ganz laut.\n",
    "Die Raubmoewe schlaegt ganz wild mit ihren Fluegeln.\n"}) );
   
  SetProp(P_SPELLRATE,60);
  AddSpell(4,500,
    "Die Raubmoewe pickt wie wild auf deinen Kopf ein.\n",
    "Die Raubmoewe pickt wie wild auf @WESSEN Kopf ein.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]) );
  AddSpell(3,750,
    "Die Raubmoewe pickt Dir fast ein Auge aus.\n",
    "Die Raubmoewe pickt @WEM fast ein Auge aus.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Raubmoewe will Deine Sachen nicht tragen.\n" }) );

}


