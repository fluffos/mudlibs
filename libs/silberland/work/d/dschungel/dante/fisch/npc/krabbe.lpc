inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();     
  
  SetProp (P_SHORT, "Eine Riesenkrabbe");
  SetProp(P_LONG,BS(
    "Diese Riesenkrabbe ist ueber einen Meter gross. Solch grosse Exemplare "
    "gibt es nur hier. Mit ihren sechs langen Beinen wirkt sie sehr bedrohlich. "
    "Ihre feurigen Augen haben Dich genau fixiert. Eine kleine Bewegung und "
    "Du wirst Ihr naechstes Opfer sein. Der rote Schimmer Ihres Panzers laesst "
    "Dich erschaudern. Vielleicht solltes Du hier lieber schnell verschwinden."
  ));
  SetProp (P_NAME, "Riesenkrabbe");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Krabbe");
  AddId(({"riesenkrabbe", "krabbe", "NOWIMPY"}));
  create_default_npc (10+random(3));
  
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 150);
  SetProp(P_HANDS, ({" mit ihrem Kiefer", 90, DT_BLUDGEON}));
  SetProp(P_ALIGN,  0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_DIE_MSG, " faellt mit einem fuerchterlichen Schrei in den Sand.\n");

 //Ruestung
 clone_object("/d/dschungel/dante/fisch/armour/krapanz")->move(this_object());
  command("trage panzer");
}
