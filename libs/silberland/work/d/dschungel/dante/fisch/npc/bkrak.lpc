//der koerper bzw kopf der gigantischen krake
//erzeugt tentakel...

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define ARME 10

int i, tentakel;

 create()
{

  if (!is_clone(TO)) return;
    ::create();

  ::create();

  SetProp(P_SHORT, "Der Krake Tantalus");
  SetProp(P_LONG, BS(
  "Vor Dir steht der sagenumwobene Krake Tantalus. Normalerweise muesstest Du "
  "schon tot sein, denn bisher hat es kein Sterblicher nur in seine Naehe "
  "geschafft, ohne mit dem Leben zu bezahlen. Dieses Schicksal wird Dich "
  "jedoch auch gleich ereilen. Seine Haut ist schwarz wie der Tod. Unzaehlige "
  "Narben zeugen von vielen Kaempfen epischen Ausmasses, die Tantalus seit "
  "Aeonen gegen jegliches Leben fuehrt. Normalerweise ist er der Herrscher "
  "ueber ein unterirdisches Meer, doch ab und zu, taucht er, gerufen von "
  "wagemutigen Helden, nach oben, ans Tageslicht, um allen, die sich ihm "
  "in den Weg stellen ein kuehles Grab zu bereiten."));




  
  set_living_name("tantalus");
  
 
  
  
  AddDetail(({"haut"}),
  "Schwarz und mit Narben uebersaeht.");
  AD(({"narbe","narben"}),
  "Seine Gegner muessen grausige Waffen besitzen...");
  AddDetail(({"arm","arme"}),
  "Vier!");
  AddDetail("moos",
  "Ueber und ueber ist es damit bewachsen!\n");
  AddDetail("koerper",
  "Bullig und mit Moos ueberzogen!\n");  
  SetProp(P_NAME, ({
  "Krake Tantalus", "des Kraken Tantalus",
  "dem Kraken Tantalus","den Kraken Tantalus"}));
  SetProp(P_GENDER, MALE);
  AddId(({"tantalus", "krake"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 51]));
  create_default_npc(20);
  SetProp(P_BODY, 111);
  SetProp(P_SIZE, 30000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 12);
   SetProp( P_RESISTANCE_STRENGTHS,([ DT_SLASH:0.6,DT_HOLY: 0.3, DT_TERROR:-1.0, DT_BLUDGEON:-0.4]));
  SetProp(P_HANDS, ({" mit seinem messerscharfen Schnabel", 250+random(100),
  ({DT_RIP, DT_PIERCE, DT_POISON}) }));  
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "wird von einer Springflut hereingeschwemmt");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "wird von einer gigantischen Springflut heraufgehoben");
  SetProp(P_MMSGOUT, "verschwindet wieder in den Tiefen der Meere");
  
  SetProp(P_DIE_MSG,  " tuermt sich tobend vor Dir wie ein Gebirge auf, und "
  "bricht dann mit lautem Bruellen nieder! Ein Strahl heissen, dunkelroten "
  " Blutes schiesst aus dem sterbenden Unwesen hervor, ein letzes Aufbaeumen, "
  "und schliesslich ein Schrei, so markerschuetternd schrecklich, dass er " 
  "nicht von dieser Welt sein kann.\n"
  "Der Krake Tantalus ist wirklich tot!!!\n");
  
  
   SetProp(P_MURDER_MSG, "Die Meere dieser Welt faerben sich blutrot!");
   SetProp(P_KILL_NAME, "Der Krake Tantalus");
   SetProp(P_KILL_MSG, "Dein Tod ist mein Leben!!!");
   SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));


    
  AddInfo(DEFAULT_INFO, "grunzt und tobt!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Krake tobt und bruellt laut. Dann zerquescht er @WEN einfach.\n"}));

  SetProp(P_SPELLRATE,50);
  
  AddSpell(2,500,
   "Der Krake Tantalus hackt mit seinem Schnabel auf Dich ein.\n",
   "Der Krake Tantalus hackt mit seinem Schnabel auf @WEN ein.\n", 
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  call_out("arme", 0);
  } 

arme()  {

  
  for(i=0;i<ARME;i++)
  {	
 tentakel=clone_object("d/dschungel/dante/fisch/npc/ktent");
   tentakel->move(environment(TO), M_GO+M_SILENT);
  }
}

_query_wimpy()  { return 0; }



die(arg)
  {
  	object ob, waf;
object ob4;
  object tent;
  tent=present("tentakel", environment(TP));
  
  ob4=deep_present("DANTE_FISCH_LISTE_VIER", TP);
  
  if(!ob4)  {
  	heal_self(1000);
  	return 1; }
  
  waf=deep_present("krakenwaffe", TP);  
  if(!waf)  {
  heal_self(1000);
  	return 1; }		
   
if(tent)  {
 write("Tantalus wehrt Deinen Todesschlag mit einem Tentakel ab!\n");
 return 1;
}

if(!deep_present("DANTE_FISCH_FERTIG", TP))  {

ob=clone_object("/d/dschungel/dante/fisch/obj/questobj5");
ob->move(TP, M_NOCHECK);
ob->AddId(""+getuid(TP)+"fertig");
ob4->remove();
waf->remove();

}


  ::die(arg);
  }
  


 Defend(int dam, string dtype, int spell, object enemy)
   {
   	object waf;
   waf=present("krakenwaffe", enemy);	
  
  
  if(!waf)  {
   	   tell_object(enemy,
"Dein laecherlicher Angriff verfehlt die Krake!\n"
"Tantalus schnappt wild nach Dir!\n");

   TP->do_damage(20+random(20));  
 return ::Defend(0, dtype, spell, enemy);    
                    
                    }

 
 if(waf)  {

 	if(waf->QP(P_WIELDED))   {
 

   tell_object(enemy,
   "Du bohrst Deine Stangenwaffe in den Koerper des Kraken!\n"
   "Tantalus bruellt vor Schmerzen auf!\n");
 return ::Defend(dam*3, dtype, spell, enemy);
     }
   else
      
      
      {
tell_object(enemy,
"Wofuer ist wohl Deine Stangenwaffe!!!\n");
  return ::Defend(0, dtype, spell, enemy);}

          }
    }




  
  
