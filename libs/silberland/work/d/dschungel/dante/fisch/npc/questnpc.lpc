//questnpc by dante

/*
   fuer die fischerquest....


*/



inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include "/d/dschungel/dante/fisch/fisch.h"

#define NEEDED_FISCH 13+random(5)


#define QUESTKEY "Die Abenteuer des Piraten Piet van Kielhol"

string questanfang(string str);
int wert;


void init(){
  ::init();
  if(interactive(TP))  {
    call_out("hallo", 0); 
  }
}

void hallo() {
  object ob, med, rohr;

  if(environment(TO)!=environment(TP)) return ;


  ob=deep_present("DANTE_FISCH_FERTIG", TP);

  if( ob 
      && deep_present(""+getuid(TP)+"fertig", TP) )     {


    write(BSA(
          "HEISA! Piet van Kielhol! Du hast ja wahrlich Tantalus besiegt! "
          "Sowas auch! Verflucht seien alle Seeungeheuer! Hier eine kleine "
          "Belohnung! Ein Medaillon und ein magisches Fernrohr! Du kannst, "
          "solltest Du die beiden Dinge einmal verlieren immer wieder zu "
          "Tantalus gehen und sie Dir holen! Wenn Du mutig genug bist!",
          "Doby Mick sagt: "));

    shout(BS(
          "Piet van Kielhol alias "+CAP(getuid(TP))+" hat alle Abenteuer von Doby Mick bestanden! HEISA!"));


    med=clone_object("d/dschungel/dante/fisch/armour/med");
    med->move(TP, M_NOCHECK);

    ob->remove();

    rohr=clone_object("/d/dschungel/dante/fisch/obj/rohr");
    rohr->move(TP, M_NOCHECK);

    /*

       wert=TP->GiveQuest(QUESTKEY);

       if (wert != 1)  {

       write("FEHLER: "+wert+", bitte Magier verstaendigen...\n");
       }

       if(wert==1)  {
       this_player()->GiveQuest(QUESTKEY);
       write_file("/log/quests/piet_van",
       dtime(time())+": "+getuid(this_player())+ " loest die Quest.\n");


*/      
    return;

  }





  if(TP->QueryQuest(QUESTKEY))  {
    write(BSA(
          "HEIA! Alter Piet! Wie gehts Dir so! Na, wieder mal Tantalus umlegen!",
          "Doby sagt: "));
    return ; 
  }


  if(present("DANTE_FISCH_LISTE_VIER", TP))  {
    write(BSA(
          "Heija, alter Piet! Na, lebt Tantalus noch?!",
          "Doby Mick sagt grinsend: ")); return; 
  }


  if(present("DANTE_FISCH_LISTE_DREI", TP))  {
    write(BSA(
          "Heija, Piet van Kielhol! Na, wo ist das Krakenauge?!",
          "Doby Mick sagt grinsend: ")); return; 
  }


  if(present("DANTE_FISCH_LISTE_ZWEI", TP))  {
    write(BSA(
          "Heija, alter van Kielhol! Wo ist die Haiflosse?!", 
          "Doby Mick sagt: ")); return ; 
  }

  if(present("DANTE_FISCH_LISTE", TP))  {
    write(BSA(
          "Heija, Piet van Kielhol! Haste schon alle Fische fuer mich!?",
          "Doby Mick sagt: ")); return ; 
  }
  else  {

    write(BSA(
          "Heija! Der einaeugige Piet van Kielhol! Die toten Piraten seien Dir gnaedig! "
          "Du lebst ja noch!!! Ich dachte Du seist laengst ersoffen! Bist Du ein Geist!?",
          "Doby Mick sagt zu Dir: ")); return ; 
  }

}


void create()
{

  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(20);
  SetProp(P_SHORT, "Ein alter Fischer namens Doby Mick");
  SetProp(P_LONG, BS(
        "Das ist der legendaere Doby Mick. Ein uralter Fischer, der sein "
        "ganzes Leben auf hoher See zugebracht hat. Sein Gesicht ist "
        "zerfurcht und seine Haut dick und braun wie Leder. Ein langer, "
        "wild zerzauster Bart gibt ihm ein noch wilderes Aussehen, doch "
        "keine Angst, Doby Mick ist schon lange kein brutaler Seeman mehr. "
        "Er lebt seit Jahren hier und geht nur mehr ab und zu an den Fluss "
        "angeln. Irgendwie muss ihm der Sturm und die See aber sehr zugesetzt"
        "haben, denn er ist leicht verwirrt und denkt, Du waerst der legendaere "
        "einaeugige Piet van Kielhol, ein Pirat der seit Ewigkeiten tot ist?!?!"
        "Lass dem alten Matrosen seinen Glauben und rede doch einfach mit ihm!"));

  AD("gesicht",
      "Braungebrannt von der Sonne.");
  AD("bart",
      "Ein wilder, weisser Bart haengt Doby von seinem Kinn herab.");
  SetProp(P_NAME, "Doby Mick");
  SetProp(P_GENDER, MALE);
  AddId( ({"seemann", "fischer", "doby", "mick", "doby mick" }));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 210);
  SetProp(P_ALIGN, 100);
  SP(P_INFO, BS("Doby Mick weiss viel! Also Fragen lohnt hier! "
        "Frag ihn doch nach Hilfe. Solltest Du die syntax vergessen haben frag ihn "
        "danach."));



  AI(({"piet", "kielhol","piet van kielhol"}),
      "Was fragst Du mich denn sowas?!?! Du bist doch der einaeugige Piet van "
      "Kielhol! Ein legendaerer Pirat, gefuerchtet von allen und total versoffen!",
      "lacht laut: ");

  AI(({"quest","aufgabe"}),
      "Tja, ich haette schon was fuer Dich zu tun, alter Piet. Frag mich einfach nach Hilfe!", 
      "brummt: ");



  AI(({"buch","buecher"}),
      "Hmm, das Buch ueber die Fische liegt hier irgenwo. Suche es, Piet...",
      "sagt: ");  


  AI("syntax",
      "Wenn Du das Krakenauge hast, so tippe einfach <krakenauge>, "
      "wenn Du die Flosse des Dschungelhaies hast tippe <dschungelhai>!",
      "Doby sagt: ");


  SetProp(P_MAX_HANDS, 2);
  SP(P_ARTICLE, 0);


  AI(({"pirat", "piraten"}),
      "Na! Du bist doch einer! der beruehmte Piet van Kielhol!", "sagt: ");
  AI("krake", 
      "Piet, Du meinst Tantalus?!", "sagt: ");
  AI("tantalus", 
      "Der Krake Tantalus ist ein magisches Wesen. Er wohnt irgendwo "
      "in den Tiefen der Meere und Fluesse. Man kann ihn rufen, muss aber "
      "zuerst einige Aufgaben erfuellen, alter Kielhol! Dann wird er erscheinen, im "
      "Zentrum der Sandbank, wo ewiger Wind weht. Angeblich gibt es da irgendwo "
      "eine Hoehle, einen Altar, Kannibalen und so, na was weiss ich...", "sagt: ");

  AI("hoehle",
      "Ach, Hoehlen gibt es viele.", "sagt: ");
  AI(({"altar","altaere"}),
      "Hmm, der Altar ist demHaigott gewidmet.", "sagt leise: ");
  AI("gott",
      "Du meinst den Haigott, van Kielhol?!", "fragt: ");
  AI("haigott",
      "Hoch ueber den Klippen soll es eine Art Altar fuer ihn geben. "
      "Dort muss man angeblich opfern, huldigen...", "sagt: ");
  AI(({"klippe", "klippen"}),
      "Die Klippen sind nicht ungefaehrlich. Ich warne Dich, Piet!", "sagt: ");
  AI("vogel",
      "Tja, das ist etwas ungenau...", "sagt: ");

  AI("harpye",
      "Die Harpye ist ein magischer Vogel. Sie soll Dinge besitzen, die, "
      "wenn man das Krakenauge holen will, nuetzlich sind. Aber das weisst Du doch Kielhol!",
      "sagt: ");


  AI(({"auge", "krakenauge", "augen"}),
      "Hmm, tja das Krakenauge. Ich hatte mal eines, aber das ging "
      "verloren. Ich haette so gerne wieder eines. Solltest Du eines finden, "
      "so bring es mir wieder, Piet. Es wird Dein Schaden nicht sein! Wenn Du es "
      "hast, so komm wieder her und tippe einfach <krakenauge>!!! "
      "Ah, da faellt mir noch was ein. Du wirst eine Harpye finden muessen. Die kann Dir sicher weiter helfen!",
      "sagt: ");


  AI(({"kerze", "schwarze kerze"}),
      "Hmm, diese schwarzen Kerzen sind sehr selten. Man soll sie verwenden "
      "koennen um irgendwie an das Krakenauge heranzukommen.", "sagt: ");

  AI("moosmonster",
      "Das Moosmonster wohnt in einer Unterwasserhoehle. Da faellt mir was ein. "
      "Willst Du das Krakenauge kriegen, musst Du es besiegen oder doch tot "
      "darniederliegen. HAHAAA!!PIET! Naja, ist ein alter Seemansreim!", "sagt: ");

  AI("knochen",
      "Der einzige Knochen, der mir etwas sagt, ist der des Moosmonsters. "
      "Der soll auch was mit dem Krakenauge zu tun haben.", "sagt: ");


  AI("angel",
      "Hmm, van Kielhol. Meine alte Angel bestand aus zwei Teilen. Dann braucht man noch "
      "eine Schnur und einen Haken.", "sagt: ");
  AI("haken",
      "Hmm, liegt hier irgendwo herum.", "sagt: ");
  AI("schnur",
      "Gute Frage! Habe ich verloren, hier irgendwo, oder woanders.", "sagt: ");
  AI(({"teile", "teilen", "teil"}),
      "Naja, der Griff und die eigentliche Angel.", "sagt: ");
  AI("griff",
      "Der Griff ist...VERDAMMMT!!! Vergessen! Altes Piratenschwein Piet!", "sagt: ");
  AI(({"sandstrand", "strand"}),
      "Naja, der ist draussen. Teilweise kann man dort fischen, teilweise "
      "lohnt es sich nicht. Im Sand kann man oefters graben und Koeder finden.",
      "sagt: ");
  AI("dschungel",
      "Der Dschungel lebt!", "sagt: ");



  AI(({"fisch","fische","rochen","aal", "barsch", "lachs",
        "hering", "karpfen","wels", "hai", "stichling", "goldfisch",
        "seezunge", "seeteufel"}),
      "Es gibt soviele verschiedene, ich habe das alles leider schon "
      "vor langer Zeit vergessen. Irgendwann habe ich aber ein "
      "Buch darueber geschrieben, alter Kielhol. Es muss hier irgendwo herumliegen. "
      "Da sollte alles drinnenstehen, was Du brauchst. Hoffe ich jedenfalls...",
      "sagt: ");

  AI("koeder",
      "Hmm, ein kompliziertes Thema, Piet. Jeder Fisch braucht einen speziellen "
      "Koeder. Naja, nicht jeder, aber man benoetigt auf jeden Fall einige "
      "verschiedene Koeder fuer all die Fische die es da so gibt. Schau Dir mal den Strand genauer an...",
      "sagt: ");
  AI(({"muetze","seemuetze"}),
      "Tja, das ist meine alte, magische Seemuetze. Sie weiss immer wieviele "
      "Fische man bereits gefangen und mir gegeben hat und wieviele noch fehlen. Am besten ist "
      "wohl, wenn Du sie identifizierst.", "raet Dir, Piet: ");  
  AI("meer",
      "Weit ist das Meer, so weit ist das Meer! Aber das weisst Du doch besser, Piet!", "singt: "),
  AI("fluss",
      "Im Fluss leben sehr viele Fische. Doch nicht alle ueberall. Je nach Tiefe "
      "und Stroemung. Doch ich weiss das alles nicht mehr. In meinem Buch steht "
      "sicher mehr darueber.", "seufzt: ");
  AI("tiefe",
      "Tja, oft ist das Wasser tiefer als Du gross bist.", "grinst: ");
  AI("wasser",
      "Meistens ist es nass...", "lacht: ");
  AI("stroemung",
      "Hmm, steht alles in meinem Buch.", "sagt: ");



  AI("forscher",
      "Hmm, ich habe ihn ewig nicht mehr gesehen. Aber ich hoffe, er kann Dir weiterhelfen!",
      "sagt: ");



  AI(({"dschungelhai", "grosser dschungelhai"}),
      "HAHA! Alte Seesau van Kielhol! "
      "Der grosse, gruene Dschungelhai. HA! Ein toller Fisch! Sehr selten! "
      "Viel zu gross um ihn mit einer Angel zu fangen! Muss man harpunieren. "
      "Mit einer speziellen Harpune! Aber huete Dich vor ihm! Wenn Du einen "
      "findest und es ueberlebst, bring mir seine Flosse! Soll Dein Schaden "
      "nicht sein! Tipp dann einfach <dschungelhai>!!!", "sagt: ");

  AI(({"flosse", "flossen"}),
      "Voegel haben selten Flossen. Fische meist. Mich interessiert aber "
      "nur die Flosse vom grossen, gruenen Dschungelhai!", "sagt: ");
  AI("harpune",
      "Fuer den Dschungelhai benoetigt man eine spezielle Harpune. Angeblich "
      "hat sie der Haigott. Aber wers glaubt...", "sagt: ");
  AI("geschichte",
      "Also gut, alter Piet! Irgendwann war ich mal mit Dante Rum trinken und der "
      "Rum hat dem alten Magier die Lippen geoeffnet. Er erzaehlte mir von dem geheimen "
      "Teil des Dschungels. Dort soll ein Priester der Kannibalen hausen und nur wer ihn "
      "besiegt kann die Waffe durch das Feuer erlangen, mit dem man dann Tantalus besiegen "
      "kann. Leider ist Dante dann mit einer billigen Elfenschlampe abgehauen und daher "
      "weiss ich nicht mehr darueber. Frag mich also nicht weiter.", "sagt: ");

  AI(({"priester","waffe","dante"}),
      "Ich sagte doch schon, ich weiss nichts mehr darueber. Naja doch, etwas noch. "
      "Im Norden des geheimen Dschungels gibt es eine Kneipe.", "sagt: ");
  AI("kneipe",
      "Geh nach Norden!", "sagt: ");
  AI("rum",
      "Zuviel Rum macht dumm!", "sagt: ");



  AddInfo(DEFAULT_INFO, ({
        "sagt: Der Sturm war unglaublich brutal!\n",
        "sagt: Der alte Piet van Kielhol lebt!!!\n",
        "lacht und bruellt: Van Kielhol, alte Seesau!\n",
        "sagt: Hohoho! Das waren Zeiten damals! Was Piet!\n",
        "sagt: Bring mir lieber die Fische, van Kielhol!\n",
        "sagt: Kennst Du Tantalus?!\n",
        "singt 'Haengt den Kielhol auf, haengt ihn auf!'.\n",
        "ruelpst enorm laut!\n"})); 


  AI(({"feuerstelle","heiliges feuer", "feuer", "opferstelle","opfer","ritual"}),
      "Irgendwo in den Klippen soll es eine Opferstelle geben und eine heilige "
      "Feuerstelle. Suche sie, alter Kielhol. Aber sie wird von Kannibalen bewacht. Ich war noch nie dort. denn "
      "es soll dort sehr gefaehrlich sein. Es gibt auch Geruechte darueber!!!", "sagt: ");
  AI(({"geruecht", "geruechte"}),
      "Hmm, in den Klippen soll es einen geheimen Teil des Dschungels geben, der nur durch "
      "das Loch in den Klippen zugaenglich ist. Dort leben Kannibalen, also huete Dich!!! "
      "Suche den verschollenen Forscher!", 
      "sagt: ");
  AI(({"teil","kannibalen", "kannibale"}),
      "Hmm, die Kannibalen die hinter den Klippen leben sollen sehr boesartig sein. "
      "Sie werden sich sicher nicht freuen Dich zu treffen, Piet!", "mahnt: ");



  AddInfo( ({"hilfe"}), #'questanfang, "sagt: "); 

  SP(P_NOATTACK, "Doby sagt: Nana, was soll das!\n");

  //infos aus  


  //  SUID;

  ACD("dschungelhai", "flosse_erledigt");
  ACD("krakenauge", "auge_erledigt");
  ACD("medaillon", "quest_fertig");

}

int auge_erledigt()  {
  object ob, questob, neuesquestob;
  ob=present("DANTE_KRAKENAUGE", TP);
  questob=present("DANTE_FISCH_LISTE_DREI", TP);

  if(!questob)  {
    write(BS(
          "Doby Mick sagt: Na, da stimmt was nicht, so geht das sicher nicht!"));
    return 1; 
  }

  else		

    if(!ob)  {
      write(BSA(
            "Aber van Kielhol, Du hast gar kein oder nicht das richtige Krakenauge!"
            " Komm erst wieder, wenn Du es hast!", "Doby Mick murrt: "));
      return 1; 
    }

  if(ob)  {
    ob->remove();


    //aendern wegen der kannis usw

    write(BSA(
          "Verfluchte tote Piraten! Du hast ja wahrlich ein Krakenauge! Heisa! "
          "Gratuliere, alter Piet! Nun hoer zu! Das letze aber sicher gefaehrlichste Abenteuer "
          "beginnt erst! Du musst den Kraken Tantalus toeten! Aber so einfach geht das eben nicht! "
          " Angeblich gibt es in den Klippen irgendeine heilige "
          "Feuerstelle. Kannibalen sollen dort hausen! Ich kenn mich da nicht so aus! "
          "Suche einen Weg nach norden in die Klippen hinein. Dort irgendwo lebt ein "
          "Forscher, der kann Dir sicher weiterhelfen. AJA! Noch was Piet! Mir faellt da "
          "noch eine Geschichte ein. Frage mich danach.",
          "Doby Mick sagt: "));

    write(BS(
          "Doby Mick nimmt Dir freundlich das Krakenauge weg."));


    questob->remove();
    neuesquestob=clone_object(FO"questobj4");
    neuesquestob->move(TP, M_NOCHECK);

    return 1; 
  }
  return 0; 
}





int flosse_erledigt()  {
  object ob, questob, neuesquestob;
  ob=present("DANTE_HAIFLOSSE", TP);
  questob=present("DANTE_FISCH_LISTE_ZWEI", TP);

  if(!questob)  {
    write(BS(
          "Doby Mick sagt: Na, da stimmt was nicht Piet, so geht das sicher nicht!"));
    return 1; 
  }

  else		

    if(!ob)  {
      write(BSA(
            "Aber van Keilhol, Du hast gar keine oder nicht die richtige Haiflosse!"
            " Komm erst wieder, wenn Du sie hast!", "Doby Mick murrt: "));
      return 1; 
    }

  if(ob)  {
    ob->remove();
    write(BSA(
          "Hijaho Piet van Kielhol! Du hast ja wirklich einen grossen, gruenen Dschungelhai "
          "erschlagen! Gratuliere! Her mit der Flosse! Nun pass aber gut auf! "
          "Als naechstes haette ich so gerne ein Krakenauge. Diese Aufgabe wird aber nicht so einfach sein! "
          "Wenn Du es hast komm her und tippe <krakenauge>!",
          "Doby Mick sagt: "));
    write(BS(
          "Doby Mick nimmt Dir freundlich die Haiflosse weg."));

    questob->remove(); 
    neuesquestob=clone_object(FO"questobj3");
    neuesquestob->move(TP, M_NOCHECK);
    return 1; 
  }
  return 0; 
}






