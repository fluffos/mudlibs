string questanfang(string str)
{
  object liste;
  string *zutaten;



  if(present("SEC_OBJ", TP))  {
    return 
      "Aber das hast Du doch schon lange fuer mich erledigt! " +
      "Ich hatte Dir doch schon eine Muetze gegeben und Du hast "+
      "alle Fische bereits abgeliefert! Piet?!?!";

  }

  if(present("DANTE_FISCH_LISTE", TP))
  {
    return 
      "Aber Du hast doch schon eine Seemuetze von mir bekommen! " +
      "Geh und fange lieber alle Fische, van Kielhol!";
  }


  liste=clone_object("/d/dschungel/dante/fisch/obj/questobj");
  liste->move(TP, M_NOCHECK);
  liste->SetZutaten(ZutatenAuswahl());




  /*
     if(!(TP->QueryQuest(QUESTKEY)))
     write_file("log/quests/piet_van", 
     dtime(time())+": "+CAP(getuid(TP))+" beginnt die Quest.\n" );
     */





  return
    "Die Sache ist ganz einfach, Piet! Hier hast Du diese alte Seemuetze. "+
    "Wenn Du, van Kielhol, alle oder auch nur einen Fisch gefangen "+
    " hast, komm einfach zu mir zurueck und gib ihn, den Fisch mir! "+
    "Ich merke mir dann genau welche Du mir gegeben hast. Zur Sicherheit "+
    "tut das die Muetze auch, denn ich bin alt und sehr vergesslich. Die "+
    "Muetze kann Dir auch sagen, welche Du noch fangen und bringen musst!";
}





give_notify(object ob)
{

  object sec_ob;
  object liste;
  string ob_short;

  if(objectp(liste=present("DANTE_FISCH_LISTE", TP)) && 
      member(liste->QueryZutaten(), ob_short=ob->QueryProp(P_SHORT)) > -1)
  {
    if(liste->QueryZutatErledigt(ob_short))
    {
      write(BS(
            "Doby Mick sagt: Aber diesen Fisch hast Du mir doch bereits gebracht!\n"));
      ob->remove();

      tell_room(environment(TO),(BS(
              "Doby Mick holt weit aus und wirft einen Fisch in hohen "
              "Bogen wieder in den Fluss zurueck!")));
    }
    else
    {

      say(BS(
            "Doby Mick sagt: Danke Piet, dieser Fisch ist genau richtig!"));
      liste->SetZutatErledigt(ob_short);
      ob->remove();

      if(liste->QueryErledigt())
      {
        write(BSA(
              "Heija! Van Kielhol! Du hast mir alle Fische gebracht! Aber nun habe ich eine "
              "schwierigere Aufgabe fuer Dich. Hoer gut zu! Irgendwo im Fluss lebt ein "
              "grosser, gruener Dschungelhai. Ein sehr seltenes Tier! Er hat gruene, sehr "
              "spitze Flossen. Bring mir eine davon! Aber sei vorsichtig! Wenn Du sie hast tippe einfach "
              "<dschungelhai>. Solltest Du einmal irgendeine Syntax vergessen so frage mich einfach nach Syntax! Viel Erfolg!",
              "Doby Mick sagt: "));
        write(BS(
              "Dann nimmt Doby Dir die Muetze wieder weg."));

        say(BS(
              "Doby Mick sagt: Piet, danke! Und nun weiter!"));
        liste->remove(1);
        sec_ob=CLONEOB(FO"questobj2");
        sec_ob->move(TP, M_NOCHECK);
        //id: dante_fisch_liste_zwei

      }
    }
  }

  else
  {
    say("Doby Mick sagt: Was soll ich damit, Kielhol!!?\n");
    ob->remove();
    write("Doby Mick schleudert irgendetwas sehr weit weg!\n");
  }
}

