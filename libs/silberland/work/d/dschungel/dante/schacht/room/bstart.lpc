
#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
int nummer=0;

create()
{
  ::create();
  SetProp(P_INT_LONG,BS(
"Hier wird der Kessel aus Fels noch enger und bedrohlicher. Der Fels scheint "
"noch dunkler und hoeher zu sein. Die Waende tuermen sich ueber Dir auf, "
"und drohen beinahe auf Dich herab zu fallen. Eine grosse, umgefallene oder "
"vielleicht auch umgestossene Statue liegt am Boden und beherrscht diesen "
"einengenden Ort. "
"Etwas abseits siehst Du im Boden eine Oeffnung, aus der helles, gleissendes "
"Licht kommt. Sie wirkt sehr freundlich. "
"Durch den Spalt im Suedosten kannst Du wieder zurueck kriechen."));

SetProp(P_INT_SHORT, "In einem engen Felskessel");

AD("oeffnung",
"Das Licht ist so hell, dass Du nichts erkennen kannst.");
AD("licht",
"Vom Licht geht Liebe aus.");
AD("liebe",
"Kuemmere Dich momentan nicht weiter um das Licht, spaeter wird es Dich retten...");

      
      AddDetail("boden",
      "Am Boden liegt eine grosse, umgefallene Statue.");
      AddDetail("statue",
      "Die Statue ist sehr lang und liegt laengs am Boden. Die stellt einen "
      "Daemonen dar, dessen oeffenes Maul nach oben zeigt.");
      AddDetail(({"daemon","daemonen"}),
      "Der Daemon steht auf einem Sockel, mitsamt dem er umgestuerzt ist. "
      "Er hat sein riesiges Maul weit aufgerissen und wirkt sehr bedrohlich.");
      AddDetail("maul",
      "Das Maul ist riesengross. Man kann direkt hineinschauen und erkennt, "
      "dass man durch das Maul der umgestuerzten Statue ganz einfach nach unten "
     " in einen Schacht klettern kann.");
     AddDetail("schacht",
     "Der Schacht sieht dunkel und duester aus. Wohin er fuehrt, sieht man nicht.");
     AddDetail("sockel",
     "Der Sockel ist quadratisch und zeigt eine Inschrift.");
     AddDetail("inschrift",
     "Lies sie!");
     AddReadDetail("inschrift",BS(
 "Dieser Sockel versperrt den Ausgang des Schachtes, der zum Nest der Daemonenbrut "
"fuehrt. Durch ihn steigen "
     "immer neue Unwesen des Grauens aus der Tiefe empor. Wir, die Daemonenjaeger "
     "haben Sockel und Statue erbaut, um die Daemonen fuer immer zu verbannen. "
 "Weh dem, der diese Statue stuerzt! Gezeichnet Cristof Feuerwind "));
     
          AddSound( DEFAULT_SOUND,
    "Von draussen hoerst Du die Geraeusche des Dschungels.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier eigentlich nicht besonders auffaelig.");
  
  
  
  AD("plateau",
"Einladend sieht dieses felserne Plateau nicht gerade aus.");
AD("fels",
"Kalt, hart und grau. Unueberwindbare Mauern bildet er hier.");
AD(({"wand","waende"}),
"Die Waende tuermen sich hier hoch auf, fast erdrueckend wirken sie.");

AD("kessel",
"Rings um Dich herum nur Fels!");
AD("gefaengnis",
"Oede und trostlos ist es hier.");
AD("himmel",
"Die Waende aus Stein sind so hoch, dass man den Himmel kaum erkennen kann.");
AD("ort",
"Ein unheimlicher Ort.");
AD("stein",
"Der Stein scheint jedes Leben hier zu unterbinden.");
    AD("leben",
 "Naja, die Liane sieht man auch hier.");
    AD("suedosten",
    "Du entdeckst einen schmalen Spalt.");
    AD("liane",
    "Eine duenne, braune Liane scheint Dir den Weg zu weisen.");
    AD(({"weg","spalt"}),
    "Du kannst ja versuchen durch den Spalt zu kriechen."); 
   AD(({"mauer","mauern"}),
   "Die Mauern sind sehr hoch.");  
  
  
  
  
  
AddItem("d/dschungel/dante/schacht/npc/crifire", REFRESH_DESTRUCT);
  
  
  
  
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_MOUNTAIN]) );  
      
          
  
  
AddCmd(({"kletter","klettere", "kriech","krieche"}), "down");


}

int down(string str)  {
  notify_fail("Wo willst Du hineinklettern oder kriechen?!\n");

  if(member(({"in schacht","in maul", "runter", "nach unten",
  "durch maul nach unten", "in schacht runter"}),str)!=-1)   {
  
  write("Du kletterst behende durch das Maul der Statue nach unten in den Schacht.\n");
TP->move(
"d/dschungel/dante/schacht/room/std:BADPL:"+getuid(this_player())+"NUM:"+(nummer+1),
M_GO,
  "durch das Maul der Statue in den Schacht nach unten", "klettert",
  "kommt durch das Maul der Statue herunter geklettert");
  
  
       return 1; }

 if(member(({ "raus", "nach suedosten","durch spalt","in spalt",
 "durch spalte"
   "hinaus"}),str)!=-1)   {
 write("Du kletterst behende durch den Spalt nach drausen.\n");
  TP->move("/d/dschungel/dante/schacht/room/bstart0", M_GO, 
  "behende nach oben", "klettert",
  "kommt heraufgeklettert");
       return 1; }


     return 0; }
     



