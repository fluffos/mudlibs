//code by dante@sl and iwo@sl


inherit "/d/dschungel/dante/schacht/room/b_inh";
inherit "/d/dschungel/dante/schacht/room/g_inh";

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#define MAX_NUMMER 15

object npc, da;
int my_level;
string string_align;


	

create ()
{
 
  if (!is_clone(this_object())) return;

  ::create ();
previous_object ()->CustomizeObject ();

if(string_align=="BAD") { //boese
  make_b_schacht();

  if (npc = clone_object("/d/dschungel/dante/schacht/npc/bad"))
    {
      npc->move(ME, M_NOCHECK);
      npc->setze_wert(my_level);
    }                            
}


if(string_align =="GOOD") { //gut

  make_g_schacht();

if (npc = clone_object("/d/dschungel/dante/schacht/npc/good"))
    {
      npc->move(ME, M_NOCHECK);
      npc->setze_wert(my_level);
    }                            
        }


  AddSpecialExit ("oben", "raufrunter");
  AddSpecialExit ("unten", "raufrunter");

  
if(da=find_player("dante"))  {tell_object(da,
"string_align aus create: "+string_align+"\n"); }
}




string set_align(string align)  {
	int len;
	 len=strlen(align);
    align=align[4..(len-1)];
	 string_align=align;
	  if(da=find_player("dante"))  {tell_object(da,
"string_align: "+string_align+" align:"+align+"\n"); }
	  
	  }

int SetLevel(int lvl)
{
	if(da=find_player("dante"))  {tell_object(da,
"lvl: "+lvl+"\n"); }
  return my_level = lvl;
}


// Fuer dinger... if (ENV(TP)->Schachtlevel()==5)
int Schachtlevel()
{
  return my_level;
}



int
raufrunter ()
//
// Originalcode by Dante@SL, safety checks by Iwo@SL
//
{
  string verb, ziel;
  object npc, waechter;
  int nummer;
 
  nummer = my_level;
  waechter=present ("waechter", TO);
  verb = query_verb();

  if( (waechter && query_verb()=="unten" && string_align=="BAD") ||
      (waechter && query_verb()=="oben" && string_align=="GOOD") )
    {
      tell_room(ENV(TP), BS("Der "+waechter->name(WER)+" sagt: Niemals! Du sterblicher Wurm!!!\n"));
      return 1;
    }


  write (BS ("Du gehst nach "+(verb=="unten"?"unten":"oben")+"!"));


  // Rauf oder runter? Nummer setzen

// wenn im daemonen schacht nummer hoeher je weiter unten
//wenn im lichtschacht nummer hoeher je weiter oben!!!!

if(string_align == "GOOD" )   {
	verb=="unten"?nummer--:nummer++;
	}
else {
  verb=="unten"?nummer++:nummer--;
  }
	
  // Sicherstellen, dass nummer nicht zu hoch wird
  
  //wenn spieler im daemschacht und nummer zu GROSS---dnest
  if (nummer >= MAX_NUMMER && string_align== "BAD") {

    ziel = sprintf("/d/dschungel/dante/schacht/room/dnest:%s",
                   getuid(this_player()));
  call_other(ziel, "???", 0);
   return TP->move(ziel, M_NOCHECK);
 }
 
 //also aus dem lichtschacht nach oben ...bstart2!!!!!!1
 if (nummer >= MAX_NUMMER && string_align=="GOOD" ) {
    ziel = sprintf("/d/dschungel/dante/schacht/room/bstart",
                   getuid(this_player()));
 call_other(ziel, "???", 0);
   return TP->move(ziel, M_NOCHECK);
 }
  
  //wenn spieler im daemonenschacht und nummer zu klein->anfangsraum
   if (nummer<=0 && string_align=="BAD" ) {
    ziel = sprintf("/d/dschungel/dante/schacht/room/bstart"); 
     call_other(ziel, "???", 0);
   return TP->move(ziel, M_NOCHECK);
    }
  
  //wenn spieler im lichtschacht und nummer zu klein->dnest
   if (nummer<=0 && string_align == "GOOD" ) {
ziel = sprintf("/d/dschungel/dante/schacht/room/dnest:%s",
 getuid(this_player()));     
  call_other(ziel, "???", 0);
   return TP->move(ziel, M_NOCHECK);
 }
  
  else
    // Ok, Nummer ist erlaubt aber welcher schacht ???
    ziel = sprintf("/d/dschungel/dante/schacht/room/std:%sPL:%sNUM:%d",
                   string_align,getuid(this_player()), nummer) ;

    call_other(ziel, "???", 0);
  
  
  // Wenn nu aber was schiefgeht? Eigene Debug-Meldung
  // Ums besser zu verstehen
  if (!objectp(find_object(ziel)))
    raise_error(
      sprintf(
        "Konnte naechsten Raum nicht laden!!\nPos:%O\nZiel:%O\nTP:%O\nAlign:%s",
        file_name(TO), ziel, this_player(), string_align));


  // Gut, nun sollte moven problemlos gehen
  
  
  return TP->move(ziel, M_NOCHECK);

}
