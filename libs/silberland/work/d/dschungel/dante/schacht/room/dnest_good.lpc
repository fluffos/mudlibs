
inherit "/d/dschungel/dante/schacht/room/b_inh";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     

int npc, oben;
string *richtungen;

create()  {
::create();


AddSpecialExit("oben", "oben");
AddSpecialExit("osten", "exit_fun");
AddSpecialExit("norden", "exit_fun");
AddSpecialExit("sueden", "exit_fun");
AddSpecialExit("westen", "exit_fun");
AddSpecialExit("nordwesten", "exit_fun");
AddSpecialExit("nordosten", "exit_fun");
AddSpecialExit("suedwesten", "exit_fun");
AddSpecialExit("suedosten", "exit_fun");
AddSpecialExit("unten", "exit_fun2");

npc=1+random(8);//1-8
oben=npc*2;
if(oben > 8 )  {
	oben=npc/2;
	}

richtungen=({
	"norden", "sueden","osten","westen",
	"nordwesten","nordosten","suedwesten","suedosten"});

write("npc: "+npc+"   oben: "+oben+"\n");

}

int exit_fun2()  {

 TP->move("/d/dschungel/dante/schacht/room/dnest2:"+getuid(TP) ,
 M_GO,"nach unten", "geht", "kommt herein");   
return 1;
 }	
      	


int exit_fun() {

write("Du gehst nach "+CAP(query_verb())+".\n");

//der pl geht in den raum mit DEM npc!!! also fun aurufen dort!

if(query_verb()==richtungen[npc-1] )  {

TP->move("/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":NPC:"+query_verb()+"" ,
 M_NOCHECK,"nach "+CAP(query_verb())+"", "geht", "kommt herein");

if( TP && environment(TP) && file_name(environment(TP))==
"/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":NPC:"+query_verb()+"")  {

	environment(TP)->make_npc();

	}

return 1;
	  }

//pl geht in raum wo exit rauf..also exit erzeugen!

if(query_verb()==richtungen[oben-1] )  {	

TP->move("/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":aufgang:"+query_verb()+"" ,
 M_NOCHECK,"nach "+CAP(query_verb())+"", "geht", "kommt herein");

if( TP && environment(TP) && file_name(environment(TP))==
"/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":aufgang:"+query_verb()+"")  {

	environment(TP)->set_aufgang();

	}

return 1;
	}
	
	else
	
 TP->move(
"/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+"DIR:"+query_verb()+"",
 M_NOCHECK,"nach "+CAP(query_verb())+"", "geht", "kommt herein");     

return 1;
 }
	



int oben()  {
   write( BS(
   "Du versuchst nach oben zu gehen, doch irgendetwas haelt Dich zurueck!"));
   return 1;
   }	
