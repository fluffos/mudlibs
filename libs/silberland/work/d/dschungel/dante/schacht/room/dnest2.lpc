//code by dante@sl and iwo@sl


inherit "/d/dschungel/dante/schacht/room/b_inh";

#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#define MAX_NUMMER 11 //10 ebenen weils 10 verschiedene dinge gibt
//die manbraucht auf jeder ebene is was anderes per random

object da;
int my_level;
string *richtungen;

create ()
{
 
  if (!is_clone(this_object())) return;

  ::create ();

previous_object ()->CustomizeObject ();

  //make_b_schacht();
//spaeter durch anderes ersetzen


  AddSpecialExit ("oben", "raufrunter");
  AddSpecialExit ("unten", "raufrunter");

  
AddSpecialExit("osten", "exit_fun");
AddSpecialExit("norden", "exit_fun");
AddSpecialExit("sueden", "exit_fun");
AddSpecialExit("westen", "exit_fun");
AddSpecialExit("nordwesten", "exit_fun");
AddSpecialExit("nordosten", "exit_fun");
AddSpecialExit("suedwesten", "exit_fun");
AddSpecialExit("suedosten", "exit_fun");

richtungen=({
	"norden", "sueden","osten","westen",
	"nordwesten","nordosten","suedwesten","suedosten"});
	
}



int SetLevel(int lvl)
{
	if(da=find_player("dante"))  {tell_object(da,
"junklvl: "+lvl+"\n"); }
  return my_level = lvl;
}


// Fuer dinger... if (ENV(TP)->Schachtlevel()==5)
int Schachtlevel()
{
  return my_level;
}


int
raufrunter ()

{
  string verb, ziel;
  int nummer;
 
  nummer = my_level;
  verb = query_verb();


  write (BS ("Du gehst nach "+(verb=="unten"?"unten":"oben")+"!"));


  // Rauf oder runter? Nummer setzen
  

if(verb=="unten") nummer++;
if(verb=="oben") nummer--;
	
	
  // Sicherstellen, dass nummer nicht zu hoch wird
  //wenn spieler im schacht und nummer zu GROSS---dnest2 also ziel da
  //is baddante
  
  if (nummer >= MAX_NUMMER )  {
    ziel = sprintf("/d/dschungel/dante/schacht/room/dnest2:%sTESTZIEL",
                   getuid(this_player()));
  call_other(ziel, "???", 0);
   return TP->move(ziel, M_NOCHECK);
              }
 
  
  //wenn spieler im schacht und nummer zu klein->dnest
   if (nummer <= 0 ) {
ziel = sprintf("/d/dschungel/dante/schacht/room/dnest:%s",
 getuid(this_player()));     
  call_other(ziel, "???", 0);
   return TP->move(ziel, M_NOCHECK);
                    }
  
  else
    // Ok, Nummer ist erlaubt aber welcher schacht ???

    ziel = sprintf("/d/dschungel/dante/schacht/room/dnest2:PL:%sNUM:%d",
                                        getuid(this_player()), nummer) ;
    call_other(ziel, "???", 0);
  
 
  // Wenn nu aber was schiefgeht? Eigene Debug-Meldung
  // Ums besser zu verstehen
  if (!objectp(find_object(ziel)))
    raise_error(
      sprintf(
        "Konnte naechsten Raum nicht laden!!\nPos:%O\nZiel:%O\nTP:%O\n",
        file_name(TO), ziel, this_player()));


  
  return TP->move(ziel, M_NOCHECK);

}






//********************************************************************

int exit_fun() {
string sec_exit;
int nummer;

write("Du gehst nach "+CAP(query_verb())+".\n");


if(query_verb()=="norden" )  { sec_exit="sueden"; }
if(query_verb()=="sueden" )  { sec_exit="norden"; }
if(query_verb()=="osten" )  { sec_exit="westen"; }
if(query_verb()=="westen" )  { sec_exit="osten"; }
if(query_verb()=="nordwesten" )  { sec_exit="suedosten"; }
if(query_verb()=="suedosten" )  { sec_exit="nordwesten"; }
if(query_verb()=="suedwesten" )  { sec_exit="nordosten"; }
if(query_verb()=="nordosten" )  { sec_exit="suedwesten"; }




if(TP) {	
 TP->move(
"/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+"NUM:"+my_level+"DIR:"+query_verb()+"",
 M_NOCHECK+M_NO_SHOW,"nach "+CAP(query_verb())+"", "geht", "kommt herein");     
}

if(TP && environment(TP) ) {
environment(TP)->set_ausgang(sec_exit);
environment(TP)->set_ebene(my_level);
}
return 1;
 }
	
