
inherit "/d/dschungel/dante/schacht/room/b_inh";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     

int npc, oben;
string *richtungen;

create()  {
::create();


AddSpecialExit("oben", "exit_fun");
AddSpecialExit("osten", "exit_fun");
AddSpecialExit("norden", "exit_fun");
AddSpecialExit("sueden", "exit_fun");
AddSpecialExit("westen", "exit_fun");
AddSpecialExit("nordwesten", "exit_fun");
AddSpecialExit("nordosten", "exit_fun");
AddSpecialExit("suedwesten", "exit_fun");
AddSpecialExit("suedosten", "exit_fun");
AddSpecialExit("unten", "exit_fun");

npc=1+random(8);//1-8
oben=npc*2;
if(oben > 8 )  {
	oben=npc/2;
	}

richtungen=({
	"norden", "sueden","osten","westen",
	"nordwesten","nordosten","suedwesten","suedosten"});

write("npc: "+npc+"   oben: "+oben+"\n");

}


int exit_fun() {
string sec_exit;
int nummer;

write("Du gehst nach "+CAP(query_verb())+".\n");

if(query_verb()=="unten")  {
nummer=1;
 TP->move("/d/dschungel/dante/schacht/room/dnest2:PL:"+getuid(TP)+"NUM:"+nummer ,
 M_GO,"nach unten", "geht", "kommt herein");   
 return 1;
 }	

if(query_verb()=="oben")  {
	 write( BS(
   "Du versuchst nach oben zu gehen, doch irgendetwas haelt Dich zurueck!"));
   return 1;
   }	
	
	

if(query_verb()=="norden" )  { sec_exit="sueden"; }
if(query_verb()=="sueden" )  { sec_exit="norden"; }
if(query_verb()=="osten" )  { sec_exit="westen"; }
if(query_verb()=="westen" )  { sec_exit="osten"; }
if(query_verb()=="nordwesten" )  { sec_exit="suedosten"; }
if(query_verb()=="suedosten" )  { sec_exit="nordwesten"; }
if(query_verb()=="suedwesten" )  { sec_exit="nordosten"; }
if(query_verb()=="nordosten" )  { sec_exit="suedwesten"; }



//der pl geht in den raum mit DEM waechternpc zur kneipe!!! also fun aurufen dort!

if(query_verb()==richtungen[npc-1] )  {

TP->move("/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":kneipe:"+query_verb()+"" ,
 M_NOCHECK+M_NO_SHOW,"nach "+CAP(query_verb())+"", "geht", "kommt herein");

if( TP && environment(TP) && file_name(environment(TP))==
"/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":kneipe:"+query_verb()+"")  {

	environment(TP)->make_kneipe();
        environment(TP)->set_ausgang(sec_exit);

	}

return 1;
	  }

//pl geht in raum wo exit rauf..also exit erzeugen!

if(query_verb()==richtungen[oben-1] )  {	

TP->move("/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":aufgang:"+query_verb()+"" ,
 M_NOCHECK+M_NO_SHOW,"nach "+CAP(query_verb())+"", "geht", "kommt herein");

if( TP && environment(TP) && file_name(environment(TP))==
"/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+":aufgang:"+query_verb()+"")  {

	environment(TP)->set_aufgang();
        environment(TP)->set_ausgang(sec_exit);
        
	}

return 1;
	}
	
	else
	
 TP->move(
"/d/dschungel/dante/schacht/room/junk:"+getuid(TP)+"DIR:"+query_verb()+"",
 M_NOCHECK+M_NO_SHOW,"nach "+CAP(query_verb())+"", "geht", "kommt herein");     

environment(TP)->set_ausgang(sec_exit);

return 1;
 }
	



  
