inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

#define P_VALID_NAME "valid_name"



create()
{
  ::create();
  SetProp(P_COMPILER_PATH, "/d/dschungel/dante/schacht/room/" );
  SetProp(P_STD_OBJECT, "/d/dschungel/dante/schacht/room/bstart");
  SetProp(P_VALID_NAME, ({"std","dnest", "junk", "junk2","dnest2"}) );
}


string Validate(string file)
{
  string path, who, name, align;

  file = ::Validate(file);
  if ((sscanf(file, "%s%s:%s",align, name, who) == 3) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, "/d/dschungel/dante/schacht/room/"+name);
    return file;
  }
}


int CustomizeObject()
{
  object npc;
  string name,wer,level, align;

  if (!(name = ::CustomizeObject()) || sscanf(name,"%sPL:%sNUM:%s",align,wer,level)!=3)
    return 0;
    
   
	PO->set_align(align); 
        PO->SetLevel(to_int(level));
  
  return 1;
}



