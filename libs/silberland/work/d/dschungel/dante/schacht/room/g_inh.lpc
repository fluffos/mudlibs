
inherit "std/room";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     


void make_g_schacht()  {

SP(P_INT_SHORT, "Im Lichtschacht");
SP(P_LIGHT, 1);
SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));

SP(P_INT_LONG, BS(
"Dieser Schacht ist sehr hell und sieht fast freundlich aus. "
"Die Waende scheinen warmes Licht abzustrahlen, und ueberall wurden "
"Kerzen aufgestellt, die voellig ruhig brennen. Der Schacht fuehrt wieder "
"hinauf an die Oberflaeche und Du wirst froh sein, wenn Du heil nach "
"oben kommst. Eine Leister, aus glaenzendem Eisen fueher nach oben oder "
"eben nach unten."));



AddSound(DEFAULT_SOUND,
"Von unten hoerst Du ein schreckliches Bruellen.\n");
AddSound("bruellen",
"Das Bruellen stammt sicher von einem Daemon.\n");
AddSmell(DEFAULT_SMELL,
"Es riecht hier sehr gut.\n");

}
