//code by dante@sl and iwo@sl


inherit "/d/dschungel/dante/schacht/room/b_inh";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>

string *junk;
int max_nummer = 15;
string fname;
object npc;

int my_level;

int welche_ebene (string fname);
void make_waechter ();


create ()
{
  object npc;
  string path;

  if (!is_clone(this_object())) return;

  ::create ();

  make_schacht ();

  AddSpecialExit ("oben", "raufrunter");
  AddSpecialExit ("unten", "raufrunter");
  previous_object ()->CustomizeObject ();

  if (npc = clone_object("/d/dschungel/dante/schacht/npc/bad"))
    {
      npc->move(ME, M_NOCHECK);
      npc->setze_wert(my_level);
    }                            

}


int SetLevel(int lvl)
{
  return my_level = lvl;
}


// Fuer dinger... if (ENV(TP)->Schachtlevel()==5)
int Schachtlevel()
{
  return my_level;
}



int
raufrunter ()
//
// Originalcode by Dante@SL, safety checks by Iwo@SL
//
{
  string verb, ziel;
  object npc;
  int nummer;
 
  nummer = my_level;

  // Welchen Befehl hat der user eingegeben?
  verb = query_verb();

  if (present ("daemon", TO))
    {
      tell_room(ENV(TP), BS("Der Waechterdaemon sagt: Niemals! Du sterblicher Wurm!!!\n"));
      return 1;
    }


  write (BS ("Du gehst nach "+(verb=="unten"?"unten":"oben")+"!"));


  // Rauf oder runter? Nummer setzen
  verb=="unten"?nummer++:nummer--;


  // Sicherstellen, dass nummer nicht zu hoch wird
  if (nummer >= max_nummer)
    ziel = sprintf("/d/dschungel/dante/schacht/room/dnest:%s",
                   getuid(this_player()));
  // In dem fall waerma ganz oben
  else if (nummer<=0)
    ziel = sprintf("/d/dschungel/dante/schacht/room/bstart");
  else
    // Ok, Nummer ist erlaubt
    ziel = sprintf("/d/dschungel/dante/schacht/room/std:%sNUM:%d",
                   getuid(this_player()), nummer) ;

  // Zur sicherheit Ziel vorher laden
  call_other(ziel, "???", 0);


  // Wenn nu aber was schiefgeht? Eigene Debug-Meldung
  // Ums besser zu verstehen
  if (!objectp(find_object(ziel)))
    raise_error(
      sprintf(
        "Konnte naechsten Raum nicht laden!!\nPos:%O\nZiel:%O\nTP:%O\n",
        file_name(TO), ziel, this_player()));


  // Gut, nun sollte moven problemlos gehen
  return TP->move(ziel, M_NOCHECK);

}
