
inherit "/d/dschungel/dante/schacht/room/b_inh";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     

int exit=0;
int nummer=0;

create()  {
::create();


AddSpecialExit("raus", "raus");
AddSpecialExit("oben", "oben");
}


string raus()  {

return TP->move("/d/dschungel/dante/schacht/room/dnest:"+getuid(TP) ,
 M_GO,"nach hinaus", "geht", "kommt herein");   
 }	


make_npc()  {
	object npc;
if(!present("mamba", TO))  {
	if( npc=clone_object("d/dschungel/dante/weg/npc/gmamba")){
      npc->move(ME, M_NOCHECK+M_SILENT);}}

exit=2;

           }


int oben()  {

  if(exit==1)  {

 TP->move(
 "/d/dschungel/dante/schacht/room/std:GOODPL:"+getuid(TP)+"NUM:"+(nummer+1) ,
  M_GO,"nach oben", "geht", "kommt herein");   
return 1;
             }	

if(exit==2)  {

 TP->move(
 "/d/dschungel/dante/schacht/room/kneipe" ,
  M_GO,"nach oben", "geht", "kommt herein");   
return 1;
             }	



else

write(BS(
     "Du versuchst nach oben zu gelangen, schaffst es aber nicht!"));
     return 1;
           }

set_aufgang()  {
	exit=1;
	}
