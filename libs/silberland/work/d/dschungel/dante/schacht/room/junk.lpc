
inherit "/d/dschungel/dante/schacht/room/b_inh";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     

int exit=0;
int nummer=0;
int ebene=0;

init()  {
	::init();
	call_out("get_room", 0);
}

void get_room() {
if(TP && interactive(TP) && TP->QP(P_BLIND)==0 && environment(TP) )  {
 tell_object(TP,
 ""+environment(TP)->int_long(TP, TP, 0)+"\n");
	}
}


create()  {
::create();

SP(P_INT_LONG, "TEST!\n");


AddItem("/d/dschungel/dante/schacht/npc/stddam", REFRESH_DESTRUCT);

}


set_ausgang(string wohin)  {
	
AddSpecialExit( wohin, "raus");	
}	

set_ebene(my_level) {
	ebene=my_level;
	}
	
string raus()  {

if(ebene==0)  {
return TP->move("/d/dschungel/dante/schacht/room/dnest:"+getuid(TP) ,
 M_GO,"nach hinaus", "geht", "kommt herein");   
 }	

else
//dnest2:PL:danteNUM:3  

return TP->move(
"/d/dschungel/dante/schacht/room/dnest2:PL:"+getuid(TP)+"NUM:"+ebene,
 M_GO,"nach hinaus", "geht", "kommt herein");   
 }	



make_kneipe()  {
	object npc;
if(!present("mamba", TO))  {
	if( npc=clone_object("d/dschungel/dante/weg/npc/gmamba")){
      npc->move(ME, M_NOCHECK+M_SILENT);}}
AddSpecialExit("oben", "oben");
exit=2;

           }


int oben()  {

  if(exit==1)  {

 TP->move(
 "/d/dschungel/dante/schacht/room/std:GOODPL:"+getuid(TP)+"NUM:"+(nummer+1) ,
  M_GO,"nach oben", "geht", "kommt herein");   
return 1;
             }	

if(exit==2)  {

 TP->move(
 "/d/dschungel/dante/schacht/room/kneipe" ,
  M_GO,"nach oben", "geht", "kommt herein");   
//der einzige raum in dem sich pls treffen koennen hier!!!
return 1;
             }	



else

write(BS(
     "Du versuchst nach oben zu gelangen, schaffst es aber nicht!"));
     return 1;
           }

set_aufgang()  {
	exit=1;
	AddSpecialExit("oben", "oben");
	}
