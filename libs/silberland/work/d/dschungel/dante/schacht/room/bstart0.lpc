
#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_LONG,BS(
"Du befindest Dich nun scheinbar auf einem Plateau aus blankem Fels. "
"Rings um Dich herum nur Waende aus grauen Stein. Im Osten ist die Oeffnung, "
"durch die Du gekommen bist. Der felsene Kessel umgibt Dich wie ein "
"Gefaengnis, wohl fuehlt man sich hier nicht, sogar der Himmel scheint grau "
"zu sein und auch der Boden bietet keinerlei Abwechslung."));
 
  SetProp(P_INT_SHORT, "In einem engen Felskessel");
      
      AddDetail("boden",
"Der Boden ist hart und felsig.");
AD("plateau",
"Einladend sieht dieses felserne Plateau nicht gerade aus.");
AD("fels",
"Kalt, hart und grau. Unueberwindbare Mauern bildet er hier.");
AD(({"wand","waende"}),
"Die Waende tuermen sich hier hoch auf, fast erdrueckend wirken sie.");

AD("kessel",
"Rings um Dich herum nur Fels!");
AD("gefaengnis",
"Oede und trostlos ist es hier.");
AD("himmel",
"Die Waende aus Stein sind so hoch, dass man den Himmel kaum erkennen kann.");
AD("abwechslung",
"Ausser der Oeffnung im Osten scheint hier nichts interesantes zu sein.");
AD(({"osten","oeffnung"}),
"Die fuehrt Dich wieder zurueck.");
AD("stein",
"Der Stein scheint jedes Leben hier zu unterbinden.");
    AD("leben",
    "Doch etwas Leben hat sich hier her verwirrt. Eine Liane schlaengelt "
    "sich aus dem Nordwesten durch einen Spalt herein.");
    AD("nordwesten",
    "Du entdeckst einen schmalen Spalt.");
    AD("liane",
    "Eine duenne, braune Liane scheint Dir den Weg zu weisen.");
    AD(({"weg","spalt"}),
    "Du kannst ja versuchen durch den Spalt zu schluepfen."); 
   AD(({"mauer","mauern"}),
   "Die Mauern sind sehr hoch.");  
      
          AddSound( DEFAULT_SOUND,
    "Von draussen hoerst Du die Geraeusche des Dschungels.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier eigentlich nicht besonders auffaelig.");
  
  
AE("osten", "/d/dschungel/dante/hoehle/room/hoehle7");
 SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_MOUNTAIN]) );

AddCmd(({"schluepfe","schluepf"}), "schluepfen");

 }
 
 schluepfen (string str)
 {
 notify_fail("Wo willst Du hinein schluepfen ?\n");
if ( !str ) return 0;  
 if ( member( ({"in spalt", "durch spalt", "in spalte","durch spalte"}),str) !=-1 )
{
write("Du schluepfst mit grosser Muehe durch den Spalt.\n");
      
      TP->move("/d/dschungel/dante/schacht/room/bstart", M_GO,
      "mit grosser Muehe durch den Spalt","kriecht",
      "kommt durch den Spalt gekrochen");
      return 1;
      }
      return 0;
      }
     



