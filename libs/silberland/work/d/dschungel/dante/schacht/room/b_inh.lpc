
inherit "std/room";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     


void make_b_schacht()  {

SP(P_INT_SHORT, "Im Daemonenschacht");
SP(P_LIGHT, 0);
SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));

SP(P_INT_LONG, BS(
"Der Schacht fuehrt tief nach unten und scheint im Nirgendwo zu enden. "
"Von den Waenden grinsen Dich haessliche Fratzen an, die Dir deuten "
"schnell nach oben zu verschwinden. Bizzare Fresken stellen Daemone dar, "
"die mit grausamen Methoden ihre Opfer abschlachten. Eine alte, rostige "
"Leiter fuehrt durch ein Loch in Decke und Boden nach unten und oben."));

AD("rost",
"Der Rost zerfrisst die Leiter. Sie muss uralt sein. Einst stiegen die "
"Daemonenjaeger hinab, doch das sollte ihr Ende sein. Der Namenlose befahl "
"ihre totale Vernichtung.");
AD(({"daemonenjaeger","jaeger"}),
"Einige haben ueberlebt.");
AD("ende",
"Fast alle Daemonenjaeger wurden damals durch die Daemone vernichtet.");
AD("vernichtung",
"Der Namenlose wollte das Ende aller Daemonenjaeger, da sie die Brutstaette "
"der Daemonen entdeckt hatten. Als die Daemonenjaeger nicht nach unten "
"vordringen konnten, erbauten sie die Statue ueber dem Schacht. Doch die "
"wurde, wie Du weisst, von den Daemonen gestuerzt.");
AD("statue",
"Sie liegt oben auf dem Schacht.");
AD(({"namenlose","namenloser"}),
"Der Herrscher ueber alle Daemonen.");
AD("herrscher",
"Du solltest Dich vor ihm hueten.");

AD("leiter",
"Eine alte, von Rost zerfressene Leiter fuehrt nach unten und oben.");
AD("himmel",
"Der Himmel hilft Dir hier auch nicht mehr.");


AD(({"wand","waende"}),
"Die Waende sind uebersaeht mit Fresken und eingemeisselten Fratzen.");
AD(({"fratze","fratze"}),
"Die Fratzen aengstigen Dich, sehen sie doch alle irgendwie Dir aehnlich. "
"Sollte das ein Spiegel Deiner selbst sein...");
AD("spiegel",
"All das Boese und Schlechte in Dir zeigt sich hier.");
AD("boese",
"Das Boese steckt in Dir.");
AD("schlechte",
"Du bist schlecht und gemein.");
AD(({"methode","methoden"}),
"Die Methoden sind so brutal und grausam, dass Du Dich abwendest und ueberlegst, "
"dass Du eigentlich wieder umkehren solltest.");

AD("opfer",
"Die Opfer scheinen sich zu wehren, sind aber machtlos.");
AD("decke",
"In der Decke ist ein Loch, durch das die Leiter nach oben fuehrt.");
AD("boden",
"Der Boden ist voller Staub. Eine Leiter fuehrt durch ein Loch nach unten.");
AD("loch",
"Ein Loch im Boden, eines in der Decke.");
AD(({"loecher"}),
"Die Loecher sind jeweils in Boden und Decke.");
AD("fresken",
"Die Fresken stellen grausame Daemone dar, die ihre Opfer quaelen.");


AD("nirgendwo",
"Tief unten irgendwo muss der Schacht einen Boden haben. Dort ist angeblich "
"die Brutstaette aller Daemone.");
AD(({"daemon","daemone"}),
"Die Fresken stellen Daemone aller Arten dar, die gerade dabei sind "
"Sterbliche zu zerfetzen.");
AD(({"art","arten"}),
"Saemtliche Daemone die Du jemals erblickt hast und noch viele mehr "
"werden auf den Fresken gezeigt.");
AD("fresko",
"Wow, Du bist gebildet."),

AD("schacht",
"Der Schacht ist dunkel und duester und es sieht so aus, als ob schon "
"lange kein Sterblicher wie Du hier war. Alles ist staubig und evrfallen.");
AD("staub",
"Der Staub ist sehr hoch.");
AD(({"sterblicher","sterbliche"}),
"Keiner der jemals den Boden des Schachtes erblickt hat, ist wiedergekehrt.");

AD("brutstaette",
"Tief unten, am Boden des Schachtes, liegt angeblich die Brutstaette der Daemone.");



AddSound(DEFAULT_SOUND,
"Von unten hoerst Du ein schreckliches Bruellen.\n");
AddSound("bruellen",
"Das Bruellen stammt sicher von einem Daemon.\n");
AddSmell(DEFAULT_SMELL,
"Es riecht nach jungen Daemonen.\n");

}
