
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <properties.h> 
#include "/players/dante/myowndefine.h"
#include <moving.h>
#include <wizlevels.h>
#include <moving.h>

#define ANZAHL 10
#define ZUFALL 1+random(88)
#define MAX 88

int nr=0;

object rue, da;
int zufall, i;
int *treffer;  //das array mit den glueckzahlen
int *alle;  //da kommen alle zahlen rein die die npcs erzeugen
string list;
string *liste;
     

erzeuge_gute_nummer();
aufruf_aus_npc(object npc, object spieler);


create()
{
  if (!is_clone(this_object())) return;
        ::create();

treffer=({});
alle=({});


        SetProp(P_WEIGHT, 10);
        SetProp(P_VALUE, 0);
        SetProp(P_GENDER, NEUTER);
        SetProp (P_SHORT, "Ein Kreuz");
        SetProp (P_LONG, BS(
                            "sie anzufassen."));
        SetProp (P_NAME, "Kreuz");

        AddId (({"kreuz", "DANTE_DAEM_KREUZ"}));

da=find_living("dante");
ACD("erzeuge", "erzeuge_gute_nummer");
ACD("qq", "qq");

liste=({
"badcloak",
"badglove",
"badpanzer",
"badtrouser",
"badbracers",
"badamulett",
"badshield",
"badring",
"badshoes",
"badhelm"});

erzeuge_gute_nummer();
}

int qq()  {
	
aufruf_aus_npc(TP , TP);
return 1;  }

int aufruf_aus_npc(object npc, object spieler)  {

zufall=ZUFALL;  //also 88 nummern	
if(sizeof(alle) >= MAX || !sizeof(liste) )  { return 1; }
//liste leer also alle erzeugt
//maximal 88 zahlen weil max 88 npcs dann muessen alle erzeugt sein!!

if( sizeof(alle) ) {
	
while(member_array(zufall, alle)!=-1 ) {
	zufall=ZUFALL;  } }
	
	//wir brauchen ja ne zahl die noch nicht drin ist!!!!

//ok: alle is noch leer also erste zahl
// bzw noch nicht drin also ne neue zahl..also nachschauen
if( (!sizeof(alle)) || (member_array(zufall, alle)==-1) )
       {
nr++;

tell_object(da,
"wieviel: "+nr+" zufall: "+zufall+"\n");

       	//die zahl IST ein glueckstreffer...
if( sizeof(treffer) && member_array(zufall, treffer)!=-1  && 
 npc && spieler )  {
         
         tell_object(spieler,
         "Du hast grosses Glueck.\n");
//ok was clonen wir ??? und hats der spieler irgendwie schon,
// duerfte zwar nie passieren aber wer weiss....


list=liste[random(sizeof(liste))];

while(rue=deep_present(list, spieler) )  {
 list=liste[random(sizeof(liste))];
 }
 tell_object(da,
 "liste: "+list+"\n");
 
 rue=clone_object("/d/dschungel/dante/schacht/armour/"+list+"");
 rue->move(spieler, M_NOCHECK);
 
 //spaeter npc!!!!!!!!!
 
 tell_object(spieler,
 "Der Daemon wirft Dir sterbend "+rue->name(WEN)+" zu!\n");
  liste-=({list}); //raus aus der liste!!!
  alle+=({zufall}); //eintrag in alle
  return 1;  }
  
  alle+=({zufall}); 
 tell_object(spieler,
         "Der Daemon lacht Dich noch einmal laut aus.\n");
  
 return 1; }
   tell_object(spieler,
         "Irgendwas lief faul! BUG! Dante melden! Danke!\n");
return 1; }








int erzeuge_gute_nummer()   {

zufall=ZUFALL;

if(sizeof(treffer) >=ANZAHL )  {
	 
for(i=0; i<sizeof(treffer);i++)  {
	 if(da)  {tell_object(da,
	 "nummer "+i+": "+treffer[i]+"\n"); }	 
	 }
return 1;
}
//wenn schon was da und drinnen
if( sizeof(treffer) ) {
	while(member_array(zufall, treffer)!=-1)  {
        zufall=ZUFALL;
        }}		


//wenn leer oder nicht gefunden-> eintrag und neuer aufruf
if( (!sizeof(treffer)) || (member_array(zufall, treffer)==-1) )
       {

  treffer+=({zufall});
  erzeuge_gute_nummer();
   return 1;
      }

return 1;
}   