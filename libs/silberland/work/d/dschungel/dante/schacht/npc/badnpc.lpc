

inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#include <class.h>

 
void create()
  {   
  if (!is_clone(TO)) return;
 ::create();
  
  AddId(({"daemon","waechterdaemon","waechter", "NOWIMPY"}));
  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "verschwindet mit einer Explosion");
  SetProp(P_RACE, "Daemon");
  SetProp(P_MAX_HANDS, 2);
  AddClass(CL_DEMON);
  SP(P_NAME, "Waechterdaemon");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 50]));
  SetProp(P_ALIGN, -500);
  

SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:0.4, DT_BLUDGEON:-0.3,
DT_SLASH:-0.2, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:0.6, DT_RIP:-0.3
, DT_PIERCE:-0.1,DT_LIGHTNING:0.7, DT_ELECTRIC:-0.2]));
  

SetProp(P_AGGRESSIVE, 1);
SetProp(P_WIMPY, 0);
SetProp(P_NOCORPSE, 0);
 SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Ein Waechterdaemon");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt! ");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ])); 
 
 SetChats(10,({
"Der Waechterdaemon sagt: Stop!\n",
"Der Waechterdaemon sagt: Halt! Wer da!\n",
"Der Waechterdaemon sagt: Hau ab!\n",
"Der Waechterdaemon sagt: Nein! Das geht so nicht!\n",
"Der Waechterdaemon tritt Dich!\n",
"Der Waechterdaemon sagt: Verschwinde!\n",
"Der Waechterdaemon sagt: Dreh um, Du Kind eines Erzmagiers!\n"}));
  }



void create_waechter(int level)  {
string art;
object cash;

if(level <= 0 )  { level=1; }
if(level > 15)  { level=15; }

switch(level) {
	case 1:
	art="sehr winzig";
	break;
	case 2:
	art="winzig";
	break;
	case 3:
	art="sehr klein";
	break;
	case 4:
	art="klein";
	break;
        case 5:
	art="sehr schmaechtig";
	break;
	case 6:
	art="schmaechtig";
	break;
	case 7:
	art="halbstark";
	break;
	case 8:
	art="stark";
	break;
	case 9:
	art="sehr stark";
	break;
	case 10:
	art="gross";
	break;
       case 11:
	art="gross";
	break;
	case 12:
	art="sehr gross";
	break;
	case 13:
	art="maechtig";
	break;
	case 14:
	art="bombastisch";
	break;
	case 15:
	art="gewaltig";
	break;
	default: art="gross";
	         level=10;
	}
	
	
SP(P_LONG, BS(
"Dieser Waechterdaemon hat nur eines im Sinn. Dich aufzuhalten und "
"wenn moeglich dabei zu toeten. Grimmig blickt er Dich an und deutet Dir "
"zu verschwinden. Dieser hier ist ein "+art+"es Exemplar!"));
SP(P_SHORT, "Ein "+art+"er Waechterdaemon");
SP(P_NAME_ADJ, art );
                   
create_default_npc(5+level*2);

 SetProp(P_HANDS, ({" mit seinen spitzen Klauen ",20*level ,
      ({DT_PIERCE,DT_TERROR}) }));

SetProp(P_SPELLRATE,level*4+10);


AddSpell(4,level*15,
"Der "+art+"e Waechterdaemon versucht Dich zu zerfetzen.\n",
"Der Waechterdaemon versucht @WEN zu zerfetzen.\n",
DT_RIP, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, level*20,
"Der "+art+"e Waechterdaemon pruegelt auf Dich ein!\n",
"Der Waechterdaemon pruegelt auf @WEN ein!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, level*25,
"Der "+art+"e Waechterdaemon schleudert eine Feuerwalze nach Dir!\n",
"Der Waechterdaemon schleudert eine Feuerwalze nach @WEM!\n",
DT_FIRE, ([SP_SHOW_DAMAGE: 1]));



SUID;
 cash=CLONEOB("/obj/money");
    cash->SetProp(P_AMOUNT, level*level*5);
         cash->move(ME);  
         
}
           


 Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Waechterdaemon lacht Dich aus!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}
