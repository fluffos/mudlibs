inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Jona Furchtlos, der Daemonenschlaechter");
SetProp(P_LONG, BS(
"Das ist Jona Furchtlos, seines Zeichens  Monsterschlaechter und Spezialist "
"fuer  Monster aller Art. Er lebt seit langem hier und hat es sich zur "
"Aufgabe gemacht mutige Helden im Kampf gegen die Daemone mit Speis und "
"Trank zu unterstuetzen."));

SetProp(P_NAME,"Jona Furchtlos");
SetProp(P_GENDER, MALE);
AddId(({"daemonenjaeger","furchtlos","jona", "NOWIMPY"}));
SetProp(P_ARTICLE, 0);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(45);
SetProp(P_HANDS, ({" mit seinem Monsterangriff geschickt",
200+random(100),DT_SLASH}));
SetProp(P_BODY, 100);
SetProp(P_SIZE, 200);
SetProp(P_ALIGN, 500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: 0.6, DT_TERROR:1.0,
DT_BLUDGEON:-0.3, DT_MAGIC:-0.5, DT_WATER:0.3, DT_COLD:-0.7]));

set_living_name("jona");


SetProp(P_HEAL,10);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC, 7);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt auf der Jagd nach Monstern herein");
SetProp(P_MSGOUT, "stuermt auf der Jagd nach Monstern");
SetProp(P_MMSGIN, "taucht ploetzlich neben Dir auf");
SetProp(P_MMSGOUT, "verschwindet ");
SetProp(P_DIE_MSG, "faellt betend fuer das Gute tot um!");
SetProp(P_MURDER_MSG, "Ohne mich seid Ihr verloren!");
SetProp(P_KILL_NAME, "Jona Furchtlos, der Monsterschlaechter");
SetProp(P_KILL_MSG, "Ich toete nicht nur Monster!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));




SetChats(5,({
"Jona Furchtlos sagt: Komm, lass uns was trinken toeten!\n",
"Jona Furchtlos sagt: Ich habe bisher ueber 1000 Daemone erlegt!\n",
"Jona Furchtlos sagt: Neulich toete ich einen Blutvampir!\n",
"Jona Furchtlos sagt: Morgen toete ich den Vampirdrachen!\n",
"Jona Furchtlos sagt: Die Spieler sind auch nicht mehr das was sie einmal waren!\n",
"Jona Furchtlos grinst wissend.\n",
"Jona Furchtlos sagt: Hmm, die grosse Statue ist sehr interessant.\n",
}));


SetProp(P_SPELLRATE,70);

SUID;
CLONEME("/p/armour/lederschuhe");
CLONEME("/p/armour/mithrilpanzer");
CLONEME("/p/armour/umhang");
CLONEME("/p/armour/hose");
CLONEME("/p/armour/guertel");
CLONEME("/p/weapon/langschwert");
command("zuecke schwert");
command("zieh alles an");


AI(({"cristof","feuerwind"}),
"Das ist der beruehmte Jaeger der Daemonen! Wenn Du ihn triffst,"
"so richte ihm schoene Gruesse von mir aus!!!", "sagt: ");
AI(({"daemon","daemone"}),
"Daemone toete ich gerne!", "sagt ernst: ");
AI(({"jona","furchtlos"}),
"Der groesste aller Helden!!!", "sagt ernst: ");
AI("dante",
"Der hat all das hier verbrochen. Er ist das personifizierte BOESE!!!\n", "sagt: ");

AddInfo(DEFAULT_INFO,({
"sagt: Hmm, gute Frage!\n",
"lacht wissend.\n",
"grinst bloed.\n",
"sagt: Bedenke, Du bist nur ein Wurm!\n"}));


AddSpell(4,450,
"Jona Furchtlos greift Dich mit einem grossen Feuerball an.\n",
"Jona Furchtlos greift @WEN mit einem grossen Feuerball an.\n",
DT_FIRE, ([SP_SHOW_DAMAGE:1]));


AddSpell(2,600,
"Jona Furchtlos schlaegt Dir ins Gesicht.\n",
"Jona Furchtlos schlaegt @WEM ins Gesicht.\n",
DT_SLASH, ([SP_SHOW_DAMAGE:1]));


AddSpell(1,1000,
"Jona Furchtlos schleudert einen Furchtfluch nach Dir.\n",
"Jona Furchtlos schleudert einen Furchtfluch nach @WEM!\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

}

init()
{
object ob;
::init();
ob=present("daemon", environment(TO));
if(ob) ob->Kill();
if(interactive(TP))  { call_out("tag", 1);}
}

void tag()  {
 if(environment(TP)!=environment(TO))   return ;
 else
 write("Jona Furchtlos sagt: "+TPN+", willkommen bei der Daemonenkneipe!\n");  }
 


HitFunc(int dam, string dtype, mixed spell, object enemy)
{
if(getuid(enemy)=="daemon")  {
return -1000;
} }


Defend(int dam, string dtype, mixed spell, object enemy)
{


if(getuid(enemy)=="daemon")  {
return ::Defend(0, dtype, spell, enemy);

}



if (!pointerp(dtype))
dtype = ({ dtype });

if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_object(enemy,
"Dein Angriff prallt von Jona einfach ab\n");
enemy->Defend(dam, DT_TERROR, ([SP_SHOW_DAMAGE:1]));

return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
write_file("/d/dschungel/dante/schacht/log/jona",
ctime()+": CrisF "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write_file("/d/dschungel/dante/schacht/log/jona",
ctime()+": CrisF wurde von "+CAP(getuid(PL))+" umgebracht.\n");

::die(arg);
}



