

inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#include <class.h>

 
void create()
  {   
  if (!is_clone(TO)) return;
 ::create();
  
  AddId(({"engel","lichtengel","waechter", "NOWIMPY"}));
  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "verschwindet mit einer Explosion");
  SetProp(P_RACE, "Engel");
  SetProp(P_MAX_HANDS, 2);
  SP(P_NAME, "Lichtengel");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 50]));
  SetProp(P_ALIGN, 500);
  

SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: -1.0,DT_UNHOLY:0.7, DT_TERROR: 1.0, DT_FIRE:-0.4, DT_BLUDGEON:0.2,
DT_SLASH:-0.2, DT_WHIP:0.4,DT_COLD:0.4, DT_AIR:0.1, DT_RIP:-0.3
, DT_PIERCE:-0.1,DT_LIGHTNING:-0.7, DT_ELECTRIC:-0.6]));
  

SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOCORPSE, 0);
 SetProp(P_MURDER_MSG, "Ich wollte doch nur die Welt vor dem Boesen retten!!!");
SetProp(P_KILL_NAME, "Ein Lichtengel");
SetProp(P_KILL_MSG, "Das Boese wird uns nie besiegen!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ])); 
 
 SetChats(10,({
"Der Lichtengel sagt: Stop! Du darfst nicht nach oben!\n",
"Der Lichtengel sagt: Halt! Wer da!\n",
"Der Lichtengel sagt: Verzeih mir bitte, aber ich muss dich aufhalten!\n",
"Der Lichtengel sagt: Das Boese wird nie siegen!\n",
"Der Lichtengel laechelt Dich an!\n",
"Der Lichtengel sagt: Die Welt muss vor dem Boesen beschuetzt werden!\n",
"Der Lichtengel sagt: Dreh um, tue Busse!\n"}));
  }



void create_waechter(int level)  {
string art;
object cash;

if(level <= 0 )  { level=1; }
if(level > 15)  { level=15; }

switch(level) {
	case 1:
	art="sehr jung";
	break;
	case 2:
	art="jung";
	break;
	case 3:
	art="sehr unerfahren";
	break;
	case 4:
	art="unerfahren";
	break;
        case 5:
	art="heranwachsend";
	break;
	case 6:
	art="erfahren";
	break;
	case 7:
	art="sehr erfahren";
	break;
	case 8:
	art="stark";
	break;
	case 9:
	art="sehr stark";
	break;
	case 10:
	art="fast gross";
	break;
       case 11:
	art="gross";
	break;
	case 12:
	art="sehr gross";
	break;
	case 13:
	art="maechtig";
	break;
	case 14:
	art="himmelsgleich";
	break;
	case 15:
	art="himmlisch";
	break;
	default: art="gross";
	         level=10;
	}
	
	
SP(P_LONG, BS(
"Dieser Lichtengel will Dir nichts Boeses tun, doch er wird Dich "
"niemals nach oben lassen! Du wirst ihn besiegen muessen, denn er sieht "
"es als heilige Pflicht die Welt vor dem Boesen zu schuetzen! "
"Freundlich aber bestimmt weist er Dir den Weg nach unten! "
"Dieser hier ist ein "+art+"er Lichtengel!"));
SP(P_SHORT, "Ein "+art+"er Lichtengel");
SP(P_NAME_ADJ, art );
                   
create_default_npc(5+level*2);

 SetProp(P_HANDS, ({" mit leuchtenden Haenden ",20*level ,
      ({DT_HOLY, DT_LIGHTNING}) }));

SetProp(P_SPELLRATE,level*4+10);

AddSpell(4,level*15,
"Der "+art+"e Lichtengel versucht Dich mit Gewalt zu bekehren.\n",
"Der Lichtengel versucht @WEN zu bekehren.\n",
DT_HOLY, ([SP_SHOW_DAMAGE:1]));

AddSpell(4,level*15,
"Der "+art+"e Lichtengel versucht Dich in Licht umzuwandeln.\n",
"Der Lichtengel versucht @WEN umzuwandeln.\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, level*20,
"Der "+art+"e Lichtengel wirft mit Blitzen um sich!\n",
"Der Lichtengel wirft mit Blitzen auf @WEN!\n",
DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, level*25,
"Der "+art+"e Lichtengel schleudert eine grossen Lichtblitz nach Dir!\n",
"Der Lichtengel schleudert einen grossen Lichtblitz nach @WEM!\n",
DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));



SUID;
 cash=CLONEOB("/obj/money");
    cash->SetProp(P_AMOUNT, level*level*5);
         cash->move(ME);  
         
}
           


 Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_HOLY }) ))
{

tell_room(environment(),
"Der Lichtengel lacht Dich aus!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}
