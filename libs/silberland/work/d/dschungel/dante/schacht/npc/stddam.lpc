//npc by dante


inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#include <class.h>
int x, y, z;

string *was;
string *wie;
string *typ;



void create()
{
if (!is_clone(TO)) return;
::create();
was=({"jung","sehr jung","neugeboren","blutjung", "frischgeschluepft"});
wie=({"grau","schwarz","blau","schlammfarben","stahlblau",
"feuerrot"});
typ=({"Feuer","Eis","Erd","Wasser","Luft",
       "Panzer","Wolken","Erdbeben","Pest","Gewitter",
       "Hoellen"});
x=random(sizeof(was));
y=random(sizeof(wie));
z=random(sizeof(typ));


SetProp(P_SHORT, "Ein "+was[x]+"er "+wie[y]+"er "+typ[z]+"daemon");

SP(P_LONG, BS(
"Das ist einer der hier geborenen Daemone. Dieser hier ist "
""+was[x]+". Er ist vom Typ der "+typ[z]+"daemonen und noch nicht allzu "
"gefaehrlich. Hier lebt er bis er groesser und staerker ist und dann "
"erst steigt er nach oben, um Schrecken und Tod zu verbreiten. "
"Er schillert in "+wie[y]+"er Farbe."));



SetProp(P_NAME,""+typ[z]+"daemon");
SP(P_NAME_ADJ, ({was[x], wie[y]}));
SetProp(P_GENDER, MALE);
AddId(({"daemon","jung_daemon", ""+lower_case(typ[z])+"daemon"}));
SetProp(P_ARTICLE, 1);
AddClass(CL_DEMON);



SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));
create_default_npc(4+random(3));


SetProp(P_HANDS, ({" mit seinen kleinen Klauen",150,({DT_TERROR,DT_RIP})}));
SetProp(P_BODY, 20+random(10));
SetProp(P_SIZE, 40+random(20));
SetProp(P_ALIGN, -300);

SetProp(P_MAX_HANDS, 2);


SetProp(P_HEAL, -5);
SetProp(P_AGGRESSIVE, 1);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,0);
SetProp(P_NOCORPSE, 0);
SP(P_DIE_MSG, " krepiert bruellend!\n");

SetProp(P_MSGIN, "kriecht bruellend herein");
SetProp(P_MSGOUT, "kriecht bruellend davon");
SetProp(P_MMSGIN, "taucht ploetzlich auf");
SetProp(P_MMSGOUT, "verschwindet in einem Loch");




SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Ein "+was[x]+"er "+wie[y]+"er "+typ[z]+"daemon");
SetProp(P_KILL_MSG, "Sogar wir "+was[x]+"en Daemone sind besser als Du Wurm!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));



SetProp(P_SPELLRATE,60);


AddSpell(4,150,
"Der "+typ[z]+"daemon versucht Dich zu kratzen.",
"Der "+typ[z]+"daemon versucht @WEN zu kratzen.",
 DT_RIP, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, 200,
"Der "+typ[z]+"daemon spuckt Dich an.",
"Der "+typ[z]+"daemon spuckt @WEN an!\n",
DT_POISON, ([SP_SHOW_DAMAGE: 1]));




}

die(arg)  {
	object master;
	if(TP && interactive(TP))  {
		if(master=deep_present("DANTE_DAEM_KREUZ", TP)) {
			master->aufruf_aus_npc(TO, TP);
return ::die(arg);
			} }
return; }


			
