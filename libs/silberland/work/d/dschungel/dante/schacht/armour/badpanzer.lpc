// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
if (!is_clone(this_object()))
return;
::create();
SP(P_LIGHT, -1);
SetProp (P_SHORT, "Ein schwarzer Panzer");
SetProp (P_LONG, BS(
"Der schwarze Panzer besteht aus purer Magie. Er ist ist voellig schwarz und absorbiert"
" das Licht fast vollstaendig."));
SetProp (P_INFO, "Dieser Panzer rettet Dein Leben!\n");
SetProp (P_NAME, "Panzer");
SP(P_NAME_ADJ, "schwarz");
SetProp (P_GENDER, MALE);
AddId (({"BAD_PANZER","panzer","badpanzer"}));
SetProp (P_WEIGHT, 1200);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 5000);
SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
SetProp (P_AC, 33);
SetProp(P_RESISTANCE, ({DT_AIR, DT_TERROR, DT_UNHOLY}));
SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
SP(P_WEAR_FUNC, TO);

SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);


}

int WearFunc(object me , int silent)
{
tell_object(environment(TO),
"Der schwarze Panzer fluestert: Ich bin bereit fuer das Boese Ich!\n");
return 1;
}


