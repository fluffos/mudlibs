// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
if (!is_clone(this_object()))
return;
::create();

SetProp (P_SHORT, "Ein schwarzer Ring");
SetProp (P_LONG, BS(
"Dieser Helm besteht aus purer Magier. Er ist voellig schwarz und absorbiert das Licht fast vollstaendig."));
SetProp (P_INFO, "Dieser Helm koennte Dir und Deinem Hohlkopf gute Dienste leisten.\n");
SetProp (P_NAME, "Ring");
SP(P_NAME_ADJ, "schwarz");
SetProp (P_GENDER, MALE);
AddId (({"ring","BAD_RING","badring"}));
SetProp (P_WEIGHT, 300);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 3000);
SetProp (P_ARMOUR_TYPE, AT_HELMET);
SetProp (P_AC, 7);
SetProp(P_RESISTANCE, ({DT_AIR, DT_TERROR, DT_UNHOLY}));
SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
SP(P_WEAR_FUNC, TO);

SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);



}

int WearFunc(object me , int silent)
{
tell_object(environment(TO),
"Der schwarze Helm fluestert: Ich bin bereit fuer das Boese Ich!\n");
return 1;
}


