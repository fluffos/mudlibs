/*
** pesthandschuhe fuer meinen daemon
** dante 97
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"handschuhe","pestdaemonhandschuhe"}));
  SetProp (P_SHORT, "Ein Paar Pestdaemonhandschuhe");
  SetProp (P_LONG, "Diese Handschuhe gehoerten einst einem maechtigen "
  "Pestdaemon. Er trug sie selbst als Schutz vor seiner toedlichen Krankheit.");
  SetProp (P_NAME, "Paar Pestdaemonhandschuhe");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 3700);
  SetProp(P_RESISTANCE , ({DT_ACID, DT_TERROR, DT_UNHOLY,DT_POISON}));
  
  SetProp (P_ARMOUR_TYPE, AT_GLOVE);  // siehe sys/combat.h
  SetProp (P_AC, 9);
  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, A_INT:17, SR_GOOD:0]) );
  SetProp(P_NOBUY, 1);
}

