//erdbebenheln dante 97 

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"helm", "erdbebenhelm"}));
  SetProp (P_SHORT, "Ein Erdbebenhelm");
  SetProp (P_LONG, "Dieser Helm gehoerte einst einem maechtigen Erdbebendaemonen. "
     " Er selbst trug ihn zum Schutz gegen seine eigenen Erdbeben.");
  SetProp (P_NAME, "Erdbebenhelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 5800+random(1000));
  SetProp (P_INFO, ("Dieser Helm ist ein herrvorragender Schutz. \n"));
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  
  SetProp (P_AC, 13+random(3));
  SetProp(P_RESISTANCE, ({DT_TERROR,DT_UNHOLY,DT_BLUDGEON}));
  SetProp (P_MATERIAL, MAT_MAGIC);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, SR_GOOD:0 ,A_INT:14]) );
}

