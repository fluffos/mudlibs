// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <moving.h>

create()
{
if (!is_clone(this_object()))
return;
::create();
SetProp (P_SHORT, "Ein Paar daemonische Luftstiefel");
SetProp (P_LONG, (
"Dieses Paar Luftstiefel ist so leicht, dass man sie fast festhalten muss, damit sie nicht "
"davonlaufen. Einst gehoerten sie einem maechtigen Luftdaemonen, der sie ohnehin "
"auch nur gestohlen hatte."));
SetProp (P_NAME, "Paar Luftstiefel");
SP(P_NAME_ADJ, "daemonisch");

SetProp (P_GENDER, NEUTER );
AddId (({"luftstiefel","paar","stiefel","daemonische luftstiefel"}));
SetProp (P_WEIGHT, 300);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 3600+random(1000));
SetProp (P_ARMOUR_TYPE, AT_BOOT);
SetProp (P_AC, 10);
SetProp(P_RESISTANCE, ({DT_HOLY, DT_TERROR, DT_UNHOLY, DT_AIR}));
SetProp(P_MATERIAL, ([MAT_LEATHER:80, MAT_SILK: 10, MAT_AIR:10]));
SetProp(P_WEAR_RESTRICTIONS, ([A_INT:14]) );
SP(P_INFO, "Diese Stiefel haben einen maechtigen Zauber. Sie koennen Dich "
"an bestimmet Orte tragen. Das Kommando ist <luftstiefel ort>.\n");
ACD("luftstiefel", "go");
}


int go(string str)
{
object ob, mp;
mp=TP->QueryProp(P_SP);
NF("Wohin willt Du laufen?\n");

ob=TO;
if(!ob->QueryProp(P_WORN) )  {
write("Die Stiefel geben Dir einen Tritt!\n");  return 1;  }

if(mp<100)  {
write("Deine Magie ist zu schwach!\n");
return 1;  }

if(!str) {
write("Naja, da kann man nicht hingehen.\n"); return 1; }


else

{
TP->restore_spell_points(-100);
if(str=="midas")  {
write("Du willst nach Midas laufen.\n"
"Die Stiefel scharren kurz am Boden und ab gehts es!!!\n");
TP->move("/gilden/abenteurer", M_TPORT, 
"von daemonischen Luftstiefeln nach Midas gebracht", 
"wird", "wird von daemonischen Luftstiefeln hier her gebracht");
return 1;
}
//hier alle oeglichen dests....

else
{write(
"Du willst nach "+str+" laufen, doch dahin wollen die Stiefel nicht.\n");
return 1;
}
return 0;
}
return 0;
}




