/* eine leckere banane
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Karotte");
  SetProp (P_LONG, "Eine leckere, reife Karotte.\n");
  SetProp (P_NAME, "Karotte");
  SetProp (P_GENDER, FEMALE);
  AddId (({"karotte", "gemuese"}));
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 20);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 5, F_SOAK: 2, F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst die Karotte mit grossem Genuss.\n");
  say (TPN+" verspeisst die Karotte und grinst.\n");
  return ::BeimEssen();
}
