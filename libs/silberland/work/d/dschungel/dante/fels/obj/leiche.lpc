// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine halbverdaute Vogelleiche");
  SetProp(P_LONG, BS(
  "Das ist die halbverdaute, stinkende Leiche eines unvorsichtigen Kolibris, "
  "welcher der Vogelfalle zum Opfer fiel.")); 
  SetProp(P_NAME, "Vogelleiche");
  SetProp(P_GENDER, FEMALE);
  AddId(({"leiche","vogeleiche"}));

  SetProp(P_MATERIAL, ({MAT_ANIMAL}));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_SMELL, "Die Vogelleiche stinkt erbaermlich.\n");
}
