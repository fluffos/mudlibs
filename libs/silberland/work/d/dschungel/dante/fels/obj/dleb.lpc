/* en ueble leber dante 97 jaenner
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Leber");
  SetProp (P_LONG, "AH!!! Was Du vor Dir siehts ist die nicht mehr ganz frische Leber eines Menschen."
          " Ihre Oberflaeche ist rauh und vernarbt und ueberhaupt fuellt sich das Organ eher "
          "wie ein Stein an.\n");  
  AddDetail(({"stein","oberflaeche"}),
  "Der ehemalige Besitzer dieses Organs scheint nicht besonders gesund gewesen zu sein....\n");
  SetProp (P_NAME, "Leber");
  SetProp (P_GENDER, FEMALE);
  AddId ("leber");
  SetProp (P_INFO, ("Diese Leber stammt von Harald Juhnke..."));
  SetProp (P_VALUE, 300);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: -15, F_SOAK: 8, F_ALCOHOL: 20, F_POISON:1]));
}

BeimEssen()
{
  write ("Du isst die Leber mit einem schlechten Gefuehl.\n");
  say (TPN+" verspeisst die Leber mit seltsamen Gesichtsausdruck.\n");
  return ::BeimEssen();
}
