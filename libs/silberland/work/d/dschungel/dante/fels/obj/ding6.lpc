//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein grosser Giftzahn");
  SetProp(P_LONG,BS(
  "Das ist ein grosser Giftzahn einer Kobra. Er ist so gross, dass Du dir "
  "gar nicht vorstellen willst, wie gross die Schlange sein muss, die ihn "
  "verloren hat.\n"));
  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Giftzahn");
  SetProp(P_MATERIAL, ({MAT_BONE,MAT_MAGIC, MAT_METAL}));
  SetProp(P_INFO, ("Wem hat der Giftzahn wohl gehoert...\n"));
  AddId(({"gzahnk","giftzahn","zahn"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);//hmmmmm
  SetProp(P_NEVERDROP, 1);
  
  
}
