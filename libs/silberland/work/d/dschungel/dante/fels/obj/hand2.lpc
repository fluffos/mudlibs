//dante 97 dez
//hand

inherit "std/food"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <food.h>
#include <moving.h>
#include "files.h"

create()

{ 
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, 0);
  AddId(({"hand"}));
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_MATERIAL, ({MAT_FLESH}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 5, F_SOAK: 3, F_ALCOHOL: 0, F_POISON: 0])); 
 SetProp(P_INFO, "Die Hand kann man essen!\n");
}

BeimEssen()
{
write("Du isst die Hand. Hmm, schmeckt gar nicht schlecht!\n");
say(CAP_TPN+" ist eine Hand auf und schaut Dich dann hungrig an.\n");
shout(CAP_TPN+" ist "+TO->QueryProp(P_NAME)+" auf!\n");

return ::BeimEssen();
}

