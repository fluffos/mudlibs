// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein alter, loechriger Schuh");
  SetProp(P_LONG, BS(
  "Diesen alten loechrigen Schuh hat irgenein Umweltsuender im Dschungel "
  "weggeworfen. Anziehn kann man ihn auf keinen Fall mehr."));
  SetProp(P_NAME, "Schuh");
  SetProp(P_GENDER, MALE);
  AddId("schuh");

  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 30);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NODROP, 0);
   SetProp(P_MATERIAL, MAT_LEATHER);
}
