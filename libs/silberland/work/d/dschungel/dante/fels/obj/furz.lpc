#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
//  SetProp(P_LONG, 0); 
  AddId(({"bernd"}));
  SetProp(P_INVIS, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, 1);
  SetProp(P_NODROP, 0);
  call_out("st1", 100);
}
st1()
{
write("Du furzt laut.\n");
say(""+TPN+" furzt laut und lacht dabei.\n");
call_out("st2", 10);
}

st2()
{
write("Du stinkst erbaermlich.\n");
say(""+TPN+" stinkt erbaermlich.\n");
call_out("st3", 10);
}
