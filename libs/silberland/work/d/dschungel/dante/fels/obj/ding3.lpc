//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine seltsame Muenze");
  SetProp(P_LONG,BS(
  "Diese Muenze weist Dir unbekannte Symbole auf. Wozu die wohl dient?"));
  SetProp(P_VALUE,1000);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Muenze");
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_METAL}));
  SetProp(P_INFO, ("Irgendeinen Sinn wird die Muenze schon haben.\n"));
  
  AddDetail(({"symbole","symbol"}),
  "Dir sagen diese Symbole nichts.");
  
  AddId(({"muenze","symbolmuenze"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
// nicht fertig da quest auc nicht fertig

}

