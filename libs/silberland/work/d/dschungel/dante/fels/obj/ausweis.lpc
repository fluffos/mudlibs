// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Augusts Ausweis");
  SetProp(P_LONG, BS( 
    "Das ist der schon etwas verblichene Miedgliedsausweis von August, "
    "dem irren Jojofreak. Er ist auf die Nummer eins ausgestellt und "
    "auch der einzige seiner Art, denn August ist Praesident, stellvertretender "
    "Praesident, Kassier, Schriftfuehrer und einziges Mitglied des 1.Jojovereines "
    "des Silberland in einer Person. Du kannst ihn entziffern."));
  SetProp(P_INFO, "Dieser Ausweis koennte Dir im Dschungel nuetzlich sein. ");
  SetProp(P_NAME, "Ausweis");
  SetProp(P_GENDER, MALE);
  AddId(({"ausweis","karte","vereinsausweis"}));

  SetProp(P_MATERIAL, ({MAT_PAPER,MAT_GUM}));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  AddCmd(({"entziffere","entziffer"}), "lesen");
}

int lesen(string str)
{
notify_fail("Was willst Du entziffern ?\n");
if (!str) return 0;
if (str!="ausweis") return 0;
{
write( " \n"
"                        +-----------------------+\n"
"                        |                       |\n"
"                        |   Mietgliedsausweis   |\n"
"                        |          des          |\n"
"                        |        ersten         |\n"
"                        |     Jojovereines      |\n"
"                        |          des          |\n"
"                        |      Silberland       |\n"
"                        |                       |\n"
"                        | Name: August von Jojo |\n"
"                        | Ausweisnr.: Eins      |\n"
"                        |                       |\n"
"                        | Unterschrift: August  |\n"
"                        |                       |\n"
"                        | Beglaubigt: August    |\n"
"                        |                       |\n"
"                        +-----------------------+\n");
return 1;
  }
 } 
   