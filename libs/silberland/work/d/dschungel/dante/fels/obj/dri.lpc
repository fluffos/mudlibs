// rippe von dante97 jaenner sl

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Rippe");
  SetProp(P_LONG, BS( 
    "Dieser Rippe war einst Teil einer schoenen Elfin. Sie war ein zartes, feines "
    "Wesen und hat den Kannibalen besonders gut geschmeckt.\n")); 
    AddDetail(({"elfin","wesen","elfen","elf"}),
    "Die Elfen gelten als eine Delikatesse mit ihrem zarten, mageren Fleisch. \n");
  
  SetProp(P_INFO, "Die Elfin haette auch Dir gefallen.\n");
  SetProp(P_NAME, "Rippe");
  SetProp(P_GENDER,FEMALE);
  AddId(({"rippe","knochen"}));

  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 0);

}
