//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Handbohrer(aus)");
  SetProp(P_LONG,BS(
  "Das ist ein kleiner Handbohrer, so wie man ihn zum Beispiel beim "
  "Zahnarzt braucht. Eine schreckliche Vorstellung! KREISCH!!!\n"
  "Du kannst ihn ein- und ausschalten.\n"));
  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Handbohrer");
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_METAL}));
  SetProp(P_INFO, ("SURRRRRRR!!!KREISCH!!!!!QIETSCHHHHHHHHH!!!!\n"));
  AddId(({"bohrer","handbohrer","zahnbohrer"}));
  SetProp(P_NOBUY, 1);
   SetProp(P_SOUND, ("Der Bohrer gibt kein Geraeusch von sich.\n"));
  SetProp(P_NODROP, 1);//hmmmmm
  SetProp(P_NEVERDROP, 1);
  AddCmd(({"schalte","schalt"}), "act");
  
  
}

act(string str)
   {
   notify_fail("Was willst Du ein oder ausschalten?\n");
   if (!str) return 0;
   
   if (str=="bohrer aus")
      {
      write("Du schaltest den Bohrer aus.\n");
      say(""+TPN+" schaltet einen Bohrer aus.\n");
      SetProp(P_SHORT, "Ein Handbohrer(aus)");
      SetProp(P_SOUND, ("Der Bohrer gibt kein Geraeusch von sich.\n"));
 //    AddId(({"bohrer","handbohrer","zahnbohrer"}));
     RemoveId("bohr");
     
     return 1;
     }
 
 
   
   if (str=="bohrer ein")
      {
      write("Du schaltest den Bohrer ein, er surrt, doch viel scheint "
      "da nicht zu passieren.\n");
      say(""+TPN+" schaltet einen Bohrer ein.\n");
      SetProp(P_SHORT, "Ein Handbohrer(ein)");
      SetProp(P_SOUND, ("Der Boher summt leise.\n"));
     AddId(({"bohr","bohrer","handbohrer","zahnbohrer"}));
     return 1;
     
     }
     return 0;
  }
     