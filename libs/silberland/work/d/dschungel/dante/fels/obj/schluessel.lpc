/*
** schlueysel fuer tuer/erde
** 
** 2. 4 97 dante
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../files.h"


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein kleiner Messingschluessel");
  SetProp (P_LONG, BS(
               "Der Schluesel besteht aus Messing."));  
  SetProp (P_NAME, "Messingschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  AddId (({"messingschluessel", "schluessel"}));
  
SetProp(P_MATERIAL, MAT_METAL);
}
string QueryDoorKey()
{
return ("/d/dschungel/dante/fels/room/huette1")+":"+("/d/dschungel/dante/fels/room/huette2");
}


