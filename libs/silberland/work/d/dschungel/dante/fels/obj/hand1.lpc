//dante 97 dez
//macht spieler fuer einen zeitlang 1 haendig da schlangenbiss

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"
int x;

create()

{ 
  x=0;
  if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  AddId(({"hands","nohands"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  call_out("check", 1);
}


check()
{
 object ob, pl;
 if(living(pl=ENV(ME))) {
   call_out("weg", 1000, pl);
   //tell_object(pl, "\n1\n");
 }
 else {
   call_out("rem_me", 0);
   return;
 }
 if((ob=pl->QueryProp(P_WEAPON)))
  {
    ob->move(environment(pl));
    tell_object(pl, BS("Deine Waffe faellt zu Boden, da Du sie "
          +"wegen dem Schlangebiss nicht nicht mehr halten kannst. Diese "
          +"Hand wirst Du nun laenger Zeit nicht mehr verwenden koennen!"));
  }
 pl->Set(P_MAX_HANDS, symbol_function("hands", TO), F_QUERY_METHOD);  
}
 
hands()
{
 return 1;
}  
 
weg(object pl)
{
 object ob;
 pl->SetProp(P_MAX_HANDS, 2);
 tell_object(pl,
 "Du kannst Deine zweite Hand nun wieder verwenden. Die Verletzung "
 "scheint sich gebessert zu haben.\n");
 pl->Set(P_HANDS, 0, F_QUERY_METHOD);
 call_out("rem_me", 0);
 }
 
rem_me()
{
   remove();
}

