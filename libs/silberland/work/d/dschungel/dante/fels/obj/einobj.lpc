#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Heft");
  SetProp(P_LONG,BS(
  "Dieses Heft gehoert dem Einsiedler, der hat es aber schon vor laengerer "
  "Zeit verloren. Es ist ein Heft mit ziemlich anruechigem Inhalt, manche "
  "Leute wuerden es Pornographie nennen."));
  AddDetail("inhalt",
  "Lies mal...");
  AddReadDetail(({"inhalt","heft"}),"@@sho@@");
  
  
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,300);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Heft");
  SetProp(P_MATERIAL, ({MAT_PAPER}));
  SetProp(P_INFO, ("Wirklich schweinisch dieses Heft.\n"));
  
  AddId(({"porno","heft"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
// nicht fertig da quest auc nicht fertig
