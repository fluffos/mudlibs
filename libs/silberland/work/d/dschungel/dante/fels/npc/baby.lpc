// ein drachenbaby fuer nairolf!!!!!!!!!!!!!

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <mnpc.h>
#include <new_skills.h>



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Nairolfs suesses Drachenbaby");
  SetProp(P_LONG, BS(
    "Das ist das Drachenbaby von Nairolf. Es schaut Dich neugierig aus grossen "
    "Augen an und laechelt freundlich."));
    AddDetail(({"auge","augen"}),
    "Grosse, runde Drachenbabyaugen.");
  SetProp(P_NAME, "Drachenbaby");
  SetProp(P_GENDER, NEUTER);
  AddId(({"drachenbaby", "baby"}));

  create_default_npc(10+random(2));
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen kleinen Drachenklauen",100,({DT_FIRE,DT_RIP,DT_BLUDGEON}) }));
  SetProp(P_MAX_HP, 1000+random(100));
  SetProp(P_BODY, 80+random(10));
 // SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "drache");
  SetProp(P_MAX_SP, 1000);
  SetProp(P_SIZE, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_NOATTACK, (" sagt: Aber du wirst doch so ein kleines, suesse Drachenbaby "
  "nicht angreifen wollen, oder? Du Schuft!!!\n"));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 100);
  SetProp(P_RESISTANCE, ({ DT_FIRE,DT_MAGIC })); 
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "wuselt herein");
  SetProp(P_MMSGOUT, "laeuft davon");
  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/fels/room/fels"));
  SetProp(P_MNPC_WAIT, ({1000,10,10}));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_OUTDOORS);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "fels2");

  SetProp(P_DIE_MSG,  " beendet sein kurzes Leben.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "laechelt Dich freundlich an.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AddInfo("nairolf", "Nairolf ist sozusagen mein Erfinder.","sagt: ");
  AddInfo("nesaja", "Nesaja ist ein Verwandter von mir und ein suesses Reptil!","sagt freundlich: ");
  

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Das Drachenbaby bedankt sich bei Dir.\n" }) );

  SetProp(P_SPELLRATE,90);
  AddSpell(5,200,
    "Das Drachenbaby speit Feuer auf Dich.\n",
    "Das Drachenbaby speit Feuer auf @WEN.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,500,
    "Aus dem Maul des Drachenbabys faehrt ein Feuerstrahl auf Dich herab.\n",
    "Aus dem Maul des Drachenbabys faehrt ein Feuerstrahl auf @WEN herab.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  SetChats(3, ({
  "Das Drachenbaby putzt seinen Panzer.\n",
  "Das Drachenbaby fragt: Hast Du meine Mami gesehen ?\n",
  "Das Drachenbaby will mit Dir spielen.\n",
  "Das Drachenbaby sagt: Musst mich liebhaben!\n",
  "Das Drachenbaby sagt: Streichle mich.\n",
  "Das Drachenbaby laechelt freundlich.\n"}) );
  SetAttackChats(10, ({
  "Das Drachenbaby will fluechten...\n",
  "Das Drachenbaby ruft um Hilfe!\n",
  "Das Drachenbaby weint laut.\n",
  "Das Drachenbaby sagt: das erzaehle ich meiner Mami.\n"}) );
   
   
     AddCmd(({"tritt","trete","knuddle","kitzle","liebe","spucke","wuerge","umarme",
       "kuesse"}),"lieb");    
   
  //SUID;
  //CLONEME(ARMOUR "schuppe" );  command("trage alles");
}


   lieb(str)
     {
     say("Das Drachenbaby freut sich und knuddelt "+TPN+" wie wild.\n"); 
       write("Das Drachenbaby freut sich und knuddelt Dich wie wild!\n");
         }
         
         void init()
         {
           ::init();
               if(interactive(TP)) call_out("hallo",0);
                   }
                                    
                                    
  void hallo()
      {
  if(TP->Queryprop(P_NAME) ==("Nairolf"))
  {
  command("emote freut sich wild, dass nairolf hier ist uns sagt: "
  "Nairolf, mein Erfinder ist da!!!Hurra!\n");    
  }
  
  if (TP->QueryProp(P_NAME)==("Nesaja"))
  {
  command("emote grinst und sagt: Nesaja, suesses Reptil! Wie gehts Dir, ich hoffe gut?!\n");
  }
   else 
     
     command("emote laechelt Dich an und sagt: "+ TP->name(RAW) +", Du bist weder Nairolf noch Nesaja, also gruess ich Dich gar nicht!\n");
                 
                 }
                         