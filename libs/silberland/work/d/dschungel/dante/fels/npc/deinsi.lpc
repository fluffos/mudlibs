// einsiedler
//stark da er fuer quest wichtig

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"

init() 
{
  object defender;
  ::init();
  if (defender = present("Wolfshund")) AddDefender(defender);
  
   if(interactive(TP)) call_out("hi", 0);
}

void create()
{
  object cash;
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Einsiedler");
  SetProp(P_LONG, BS(
    "Der Einsiedler ist ein alter Mann mit einer derben, braungebrannten "
    "Haut. Sein langer Bart beginnt bereits grau zu werden, was ihn aber "
    "eher wuerdevoll als greis erscheinen laesst. Seine kleinen, dunklen "
    "Augen blicken Dich freundlich, aber sehr wachsam und erfahren an."
    " Sein Koerper ist kraeftig aber trotzdem drahtig und flink, gestaehlt "
    "durch den brutalen Ueberlebenskampf des Dschungels. Eine lange Narbe "
    "zieht sich quer vom rechten Ohr ueber die Wange nach vorne.\n"));
  AddDetail(({"narbe","wange","ohr"}),
  "Diese Verletzung ruehrt von einem Kampf mit den Kannibalen her, denen "
  "der Einsiedler offensichtlich aber entkommen konnte...\n");
  
  AddDetail(({"auge","augen"}),
  "Diese hellwachen, funkelnden Augen zeugen vom harten, schonungslosen "
  "Leben in der Wildnis. Irgendwie scheinen sie aber auch voller Kummer "
  "und Sorge zu sein.\n");  
  AddDetail(({"bart","mann"}),
  "Der Bart des Einsiedler wallt herab ueber das Kinn bis zu seiner Brust.\n");  
  AddDetail(("haut"),
  "Die stechende Sonne des tiefen Suedens hat ueber viele Jahre hinweg dem "
  "Einsiedler dieses ausgezehrte Aussehen verliehen.\n");
  AddDetail(({"kampf","ueberleben","ueberlebenskampf"}),
  "Das harte Leben in der Wildnis verlangt dem Einsiedler alles ab.\n");
  AddDetail(("koerper"),
  "Der Einsiedler sieht kraeftig und schnell aus. Er waere ein nicht zu "
  "unterschaetzender Gegner fuer Dich.\n");
  SetProp(P_NAME, "Einsiedler");
  SetProp(P_GENDER, MALE);
  AddId(({ "einsiedler", "mann","Einsiedler"}));

  create_default_npc(19);
  
  SetProp(P_HANDS, ({" mit seinen harten Faeusten ",230+random(30),({DT_HOLY,DT_BLUDGEON})}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 184);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 80);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:-2.0,DT_MAGIC:-2.0,DT_SLASH:-2.0,
  DT_HOLY:-2.0, DT_AIR:-1.0, DT_ACID:1.0, DT_RIP:-2.0])); 
  SetProp(P_NOMAGIC,10);
  SetProp(P_INFO, ("Der Einsiedler kennt sich im Dschungel sehr gut aus.\n"));
  SetProp(P_MSGIN, "geht murmelnd herein");
  SetProp(P_MSGOUT, "geht murmelnd");
  SetProp(P_MMSGIN, "kommt murmelnd herein");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " bricht einsam nieder.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Jetz bin ich wirklich einsam, %s!");
  SetProp(P_KILL_NAME, "Einsiedler");
  SetProp(P_KILL_MSG, "Jetzt bist DU einsam!");

  SetProp(P_SMELL, ("Der Einsiedler riecht nach starkem Tabak.\n"));
 SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
  SetProp(P_LOG_INFO, "deinsielder");
  AddInfo(DEFAULT_INFO, "grummelt nur in seinen Bart.\n");
  AddInfo("dante", "Dante ist mein Freund.","sagt: ");
  AddInfo(({"kannibale","kannibalen"}),
  "sagt: Sie wohnen in einem Dorf, das nahe von hier liegt!\n");
  AddInfo("huette",
  "Ja, die gehoert mir!","sagt: ");
  AddInfo("schluessel",
  "Der Messingschluessel?", "fragt: ");
  AddInfo("messingschluessel",
  "Ich haette gerne wieder mal Sex!", "lacht Dich aus: ");
  AddInfo("jojo",
  "Das haben wir zerlegt und versteckt.","sagt: ");
  AddInfo("augustin",
  "Der war sehr laestig mit seinem Jojo. Ich weiss aber wo einer der Teile ist."
 , "sagt: ");
  AddInfo(({"teil","teile"}),
  "Hmmm, bring mir mein Heft und ich helfe Dir.", "sagt: ");
  
  AddInfo("dschungel",
  "sagt: Der Dschungel ist voller Gefahren...\n");
  AddInfo("vogel",
  "sagt: Voegel gibt es hier sehr viele verschiedene.\n");
  AddInfo("tiger",
  "sagt: Der Tiger ist eines der maechtigsten Tiere des Dschungels!\n");
  AddInfo("harpye",
  "sagt: Die Harpye ist ein sehr kluger, geheimnisvoller Vogel.\n");
  AddInfo(({"frau","frauen","weiber","weib"}),
  "stoehnt: Ach, Frau hatte ich schon lange keine mehr...\n");
  AddInfo("hund",
  "sagt: Er ist mein treuester und einziger Freund.\n");
  AddInfo("zaubertrank",
  "fluestert: Frag die Kannibalen danach!\n");
  AddInfo("hoehle",
  "sagt: Welche meinst du? Hoehlen gibt es viele.\n");
  AddInfo("leben",
  "sagt: Jeder muss fuer sich die richtige Lebensart finden!\n");
  AddInfo("einsamkeit",
  "sagt: Ja, die kenne ich gut...\n");
  AddInfo("sex",
  "Ich hatte mal ein ziemlich scharfes Heft, das hab ich aber verloren.",
  "sagt: ");
  AddInfo("heft",
  "Hmm, brings mir wieder und ich helfe Dir. Es ist irgendwo hier im Dschungel.",
  "sagt: ");
  
  AddInfo("tijara",
  "sagt: Tijara ist eine Stadt noerdlich von hier.\n");
  AddInfo("gold",
  "sagt: Irgendwo soll es eine Goldmine geben...\n");
  AddInfo(({"edelsteine","edelstein"}),
  "sagt: Die Kannibalen haben viele davon.\n");
  AddInfo("elsurion",
  "sagt: Er ist ein maechtiger Zauberer aus Tijara.\n");
  AddInfo("friedhof",
  "sagt: Um den Friedhof kuemmere ich mich von Zeit zu Zeit...\n");
  AddInfo("pyramide",
  "sagt: Tief im Sueden soll es eine geben....\n");
  AddInfo("freiheit",
  "sagt: Die Suche nach ihr hat mich hier hergefuehrt..\n");
  AddInfo("priester",
  "sagt: Meinst Du den boesen Kannibalenpriester?\n");
  AddInfo("kannibalenpriester",
  "fluestert: Huete Dich vor ihm! Er ist boese und grausam!\n");
  AddInfo("midas",
  "sagt: Aus dieser Stadt stamme ich urspruenglich.\n");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Einsiedler bedankt sich bei Dir.\n" }) );

  SetProp(P_SPELLRATE,70);
  AddSpell(5,500,
    "Der Einsiedler greift Dich mit der Kraft der Stille an.\n",
    "Der Einsiedler greift @WEN mit der Kraft der Stille an.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,650,
    "Der Einsiedler schlaegt Dich mit seiner grossen Erfahrung.\n",
    "Der Einsiedler schlaegt @WEN mit seiner grossen Erfahrung.\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 500,
    "Der Einsiedler schlaegt Dir mit seiner knochigen Faust ins Gesicht.\n",
    "Der Einsiedler schlaegt @WEM mit seiner knochigen Faust ins Gesicht.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 100,
  "Der Einsiedler sprueht Dir etwas ins Gesicht.\n",
  "Der Einsiedler sprueht @WEM etwas ins Gesicht.\n",
  DT_POISON, "spell_poison");
  
  SetChats(3, ({
  "Der Einsiedler streicht sich durch den Bart.\n",
  "Der Einsiedler grummelt etwas unverstaendliches.\n",
  "Der Einsiedler krammt in einer Kiste herum.\n",
  "Der Einsiedler laechelt freundlich.\n",
  "Der Einsiedler kratzt sich am Kopf.\n",
  "Der Einsiedler geht auf und ab.\n",
  "Der Einsiedler ruft seinen Hund.\n",
  "Der Einsiedler starrt in die Luft.\n",
  "Der Einsiedler fuehrt Selbstgespraeche.\n",
  "Der Einsiedler versinkt in seinen Gedanken.\n",
  "Ploetzlich flucht der Einsiedler laut.\n",
  "Du wunderst Dich ueber diesen seltsamen alten Mann.\n",
  "Der Einsiedler pfeift eine froehliche Melodie.\n",
  "Der Einsiedler mustert Dich genau.\n",
  "Der Einsiedler summt eine leise Melodie.\n",
  "Unter Dir knarrt der Holzboden.\n",
  "Von draussen hoerst Du die Geraeusche des Dschungels.\n",
  "Du denkst . o O So ein Leben waere nichts fuer Dich!\n",
  "Der Einsiedler freut sich ueber Deine Gesellschaft.\n",
  "Der Wind ruettelt an der kleinen Huette.\n",
  "Der Einsiedler richtet Futter fuer seinen Hund.\n",
  "Der Einsiedler schnitzt eine kleine Holzfigur.\n",
  "Du denkst . o O Eigentlich recht gemuetlich hier...\n",
  "Der Einsiedler murmelt etwas von Kannibalen.\n",
  "Der Einsiedler scheint zu meditieren...\n"}) );
  
  SetAttackChats(10, ({
  "Der Einsiedler schreit: Verschwinde von hier!!!\n",
  "Der Einsiedler verflucht Dich.\n",
  "Der Einsiedler will Dich aus der Huette draengen.\n",
  "Der Einsiedler spuckt Dich an.\n",
  "Der Einsiedler wuenscht Dir die Kannibalen an den Hals.\n",
  "Der Einsiedler tritt Dir in den Bauch.\n",
  "Der Einsiedler bruellt: Stoere meine Ruhe nicht!!!\n",
  "Der Einsiedler wuenscht Dir die Pest an den Hals.\n",
  "Der Einsiedler schreit: Du mieser Staedter!!!\n"}) );

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(300));
  cash->move(ME);
  CLONEME(WEAPON "dmachete");
  command("zuecke machete");
 CLONEME(OBJ "schluessel");
  CLONEME(ARMOUR "dleggins");
  CLONEME(ARMOUR "dlederhut");
  CLONEME(ARMOUR "dleinenhemd");
  CLONEME(ARMOUR "dledergamaschen");
  command("trage alles");
}


void InformDefend(object enemy) 
{
  Kill(enemy);
  }
  

spell_poison(object enemy, int damage, mixed dam_type)
  {
  switch(random(100))
     {
     case 0 .. 33:
     TP->do_damage(5);
       enemy->AddPoison(1);
       tell_object(enemy,
       "AHH!Das Zeug brennt im Gesicht!\n");
       break;
       
       
    case 34 .. 60:
    enemy->AddPoison(3);
    TP->do_damage(10);
    tell_object(enemy,
           "AHH!Das Zeug brennt schrecklich im Gesicht!\n");
                  break;   
  case 61 .. 75:
    enemy->AddPoison(5);
    TP->do_damage(15);
    tell_object(enemy,
           "AHH!Dein Gesicht wird fast weggeaetzt!\n");
                  break;
                  
  case 76 .. 99:
    tell_object(enemy,
    "Du hast grosses Glueck. Die Fluessigkeit richtete keinen Schaden an!\n");
     }
 }
 
  
  void give_notify(object ob)
     {
         if( (ob->id("porno") ) )
                 {
       write("Der Einsiedler freut sich sehr ueber sein Heft, grinst anzueglich "
       "und kramt in einer seiner vielen Taschen umher. Er gibt Dir darauf einen "
       "kleinen Schluessel und sagt: Pass darauf auf, ist mein Zweitschluessel!\n");
       say(""+TPN+" freut sich sehr.\n");
       CLONE(OBJ"schluessel", TP);
       TP->heal_self(100);
       write("Du fuehlst Dich wirklich gut und hast das Gefuehl geholgen zu haben.\n");
       
       ob->remove();
       return;
       }
   ::give_notify(ob);
   }


   void hi()
   {
   command("emote sagt freundlich: "+ TP->name(RAW) +", was fuehrt Dich in die Einsamkeit!\n");
   }
   