// kannibale 

inherit "std/npc";
inherit "std/inpc/select";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
#include <inpc.h>

init()
{
  object defender;
  ::init();
  if (defender = present("Kmann")) AddDefender(defender);
  if (defender = present("Kmann 2")) AddDefender(defender);
  if (defender = present("Kmann 3")) AddDefender(defender);
}

create()
{
 
  if (!is_clone(TO)) return;
  npc::create();

  SetProp(P_SHORT, "Ein Kannibale");
  SetProp(P_LONG, BS(
    "Du siehst einen wild dreinblickenden sehnigen Kannibalen vor Dir, dem "
    "man die Mordlust direkt ansehen kann!\n"));
  SetProp(P_NAME, "Kannibale");
  SetProp(P_GENDER, MALE);
  AddId(({"kannibale","mann", "kannibalenmann", "Kmann"}));

  create_default_npc(15+random(5));
  SetProp(P_HANDS, ({" mit seinen Faeusten",140+random(20),DT_BLUDGEON}));
  SetProp(P_RACE, "Kannibale");
  SetProp(P_SIZE, 180+random(20));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "springt hinter einem Busch hervor");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " haucht sein Kannibalenleben aus.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_LOG_INFO, "dkannibalen");
  AddInfo(DEFAULT_INFO, "schreit: Verschwinde aus dem Dorf, oder wir fressen Dich.\n");
  AddInfo("priester", "Er ist der maechtigste Mann im Dorf.","sagt: ");
  AddInfo("kannibale", "Ich bin einer davon, Du Idiot!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Kannibale sagt: Erwartest Du fuer den Muell auch noch Dank?\n" }) );
  SetProp(P_SPELLRATE, 50);
  
  AddSpell(1, 500,
    "Der Kannibale schlaegt Dir den Schaedel ein.\n",
    "Der Kannibale schlaegt @WEM den Schaedel ein.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3,400,
    "Der Kannibale schlitzt Dich auf.\n",
    "Der Kannibale schlitzt @WENN auf.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4,300,
    "Der Kannibale tritt Dir in den Bauch.\n",
    "Der Kannibale tritt Dir in den Bauch.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5,250,
    "Der Kannibale schleudert giftige Pfeile nach Dir.\n",
    "Der Kannibale schleudert giftige Pfeile nach Dir.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
  if( QueryProp(P_LEVEL)>17 )
  {
    AddSpell(1,666,
      "Der Kannibale streut Dir Sand ins Gesicht.\n",
      "Der Kannibale streut @WEM Sand ins Gesicht.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  }

  SetChats(3, ({
  "Der Kannibale furzt hemmungslos.\n",
  "Der Kannibale ruelpst laut.\n",
  "Der Kannibale tritt Dich.\n",
  "Der Kannibale will ein Stueck Fleisch von Dir abschneiden.\n",
  "Der Kannibale schaut Dich hungrig an.\n",
  "Der Kannibale tobt.\n",
  "Der Kannibale schwingt sein Knochenschwert.\n",
  "Der Kannibale baut sich vor Dir drohend auf.\n",
  "Der Kannibale kratzt sich am Knie.\n",
  "Der Kannibale deutet Dir zu verschwinden.\n",
  "Der Kannibale schreit Dich an.\n"}) );
  
  SetAttackChats(10, ({
  "Der Kannibale versucht Dich zu erwuergen!\n",
  "Der Kannibale will Dich roh fressen!\n",
  "Der Kannibale ruft seine Stammesbrueder zu Hilfe.\n",
  "Der Kannibale freut sich auf Deine Leber.\n",
  "Der Kannibale verflucht Dich.\n",
  "Der Kannibale draegt Dich zurueck.\n"}) );

  SUID;
  switch(random(3))
  {
    case 0: 
      CLONEME(WEAPON "dkschwert"); 
      command("zuecke schwert");
      break;
    case 1: 
      CLONEME(WEAPON "dschkeule"); 
      command("zuecke keule");
      break;
    case 2:
     CLONEME(WEAPON "dspeer");
     command("zuecke speer");
     break;
  }
  switch(random(8))
  {
    case 0:
      CLONEME(OBJ "dmilz");
      break;
    case 1:
      CLONEME(OBJ "dri");
      break;
    case 2:
      CLONEME(OBJ "dun");
      break;
    case 3:
      CLONEME(OBJ "dhirn");
      break;
    case 4:
      CLONEME(OBJ "dleb");
      break;
  }
     
  if( random(100) < 45 ) CLONEME(ARMOUR "dledergamaschen");
  if( random(100) < 85 ) CLONEME(ARMOUR "dkschild");
  if( random(100) < 55 ) CLONEME(ARMOUR "dkhelm");
  if( random(100) < 75 ) CLONEME(ARMOUR "dschurz");
  if( random(100) < 25 ) CLONEME(ARMOUR_WEG "dlumpen");
  if( QueryProp(P_LEVEL) == 19 && !random(4) ) CLONEME(ARMOUR_WEG "dtigerfell");

 
  command("trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("nimm alles aus leiche");
  command_me("ziehe alles aus");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe");
  command_me("trage alles");
}

