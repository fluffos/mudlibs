// kannibalenfrau

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

init()
{
  object defender;
  ::init();
  if (defender = present("Kmann") ) AddDefender(defender);
  if (defender = present("Kfrau")) AddDefender(defender);
  if (defender = present("Kfrau 2")) AddDefender(defender);
}

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Kannibalenfrau");
  SetProp(P_LONG, BS(
    "Vor Dir steht eine braungebrannte halbnackte Kannibalenfrau. Ihr kraeftiger "
    "Koerperbau verraet die taegliche harte Arbeit, die sie verrichten muss.\n"));
  AddDetail(({"koerper","bau","arbeit","koerperbau"}),
    "Der Koerper der Kannibalenfrau ist muskuloes und sehnig. Irgenwie findest Du "
    "Gefallen an ihr...");
  SetProp(P_NAME, "Kannibalenfrau");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kannibalenfrau", "frau", "Kfrau"}));

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit ihren Faeusten Faeusten",110+random(30),DT_BLUDGEON}));
  SetProp(P_RACE, "Kannibale");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 30);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_LOG_INFO, "dkannibalen");
  AddInfo(DEFAULT_INFO, "schreit: Verschwinde aus unserem Dorf solange Du noch kannst!\n");
  AddInfo("priester", "Er ist der maechtigste Mann im Dorf.","sagt: ");
  AddInfo("dante", "Oh, war das ein toller Mann.","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Kannibalenfrau sagt: Ach, verschwinde bloss von hier...\n" }) );


  SetChats(3, ({
  "Die Kannibalenfrau sagt: Verschwinde aus dem Dorf.\n",
  "Die Kannibalenfrau begutachtet Deine Schenkel.\n",
  "Die Kannibalenfrau tritt Dich.\n",
  "Die Kannibalenfrau bestaunt Deine weisse Haut.\n",
  "Die Kannibalenfrau ruft nach ihrem Mann.\n",
  "Die Kannibalenfrau beruehrt Deinen Bauch.\n",
  "Die Kannibalenfrau nagt an einem Knochen.\n",
  "Die Kannibalenfrau furzt.\n",
  "Die Kannibalenfrau kratzt sich am Knie.\n",
  "Die Kannibalenfrau lacht Dich aus.\n",
  "Die Kannibalenfrau macht Dir schoene Augen.\n"}) );
  
  SetAttackChats(10, ({
  "Die Kannibalenfrau schreit um Hilfe!\n",
  "Die Kannibalenfrau kaempft verzweifelt um sein Leben.\n",
  "Die Kannibalenfrau tritt Dir zwischen die Beine.\n",
  "Die Kannibalenfrau beisst Dir in dem Arm.\n",
  "Die Kannibalenfrau kreischt laut.\n"}) );

  SUID;
  CLONEME(WEAPON_WEG "dknochen");
  command("zuecke knochen");
  CLONEME(OBJ "dun");
  CLONEME(ARMOUR "dschurz");
  command("trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

