void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boesartiger Pflanzentrollmagier");
  SetProp(P_LONG, BS(
    "Der Pflanzentrollmagier ist ein kleines, aber sehr hinterlistiges Wesen. Seine dunklen "
    "Augen funkeln Dich listig an. Du solltest Dich vor ihm in Acht nehmen, denn "
    "schon viele Abenteurer machten den Fehler ihn zu unterschaetzen..."));

  AddDetail(({"auge","augen"}),
  "Dunkel und hinterlistig blinzeln Dich die Augen des Pflanzentrollmagier an.");
    
  SetProp(P_NAME, "Pflanzentrollmagier");
  SetProp(P_GENDER, MALE);
  AddId(({"pflanzentroll", "troll","magier","pflanzentrollmagier"}));
  set_living_name("pflanzentrollmagier");
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen dreckigen Klauen",190+random(20),({DT_MAGIC,DT_ACID,DT_BLUDGEON})}));
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_ALIGN, -300);
  SetProp(P_BODY, 80+random(20));
   SetProp(P_ATTRIBUTES, ([A_INT:60, A_DEX:40, A_STR:15, A_CON:25]) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 100);
//  SetProp(P_RESISTANCE_STRENGTHS, ([DT_MAGIC:-3.0, DT_FIRE:-2.0, DT_BLUDGEON:1.0,
 // DT_TERROR:-2.0, DT_HOLY:1.0]));
   
//  SetProp(P_NOMAGIC,30);

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft davon");

  SetProp(P_DIE_MSG,  " grinst noch einmal listig und faellt dann tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, " bruellt: Dich verspeise ich mit Bambussprossen!\n");
  
  AddCmd(({"tritt","spuck","kitzl","wuerg","lach"}),"kill",1); 
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Du stellst aber kluge Fragen!\n",
  "spuckt vor Deine Fuesse.\n",
  "lacht nur ueber Dich.\n",
  "sagt: Ich habe fliegende Schweine gesehen.\n",
  "sagt: macht eine abwehrende Geste.\n",
  "staunt ueber so eine dumme Frage.\n",
  "gratuliert zu deinem Wissen.\n",
  "sagt: Ja, Du hast vollkommen Recht.\n",
  "antwortet: Meine Mutter sagte das auch immer...\n",
  "fluestert: Bohr Dir doch ein Loch ins Knie...\n",
  "grinst Dich nur an.\n",
  "sagt: Hmm, Deine Ausruestung gefaellt mir.\n",
  "schaut Dich boese an.\n",
  "sagt: Naja, gib mir Geld, dann...\n"}));
  
  
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");


  SetProp(P_SPELLRATE,70);
  

 AddInfo("jojo",
 "Der doofe August hat uns so genervt, das wir schliesslich "
 "sein Jojo zerlegt haben und es ueberall versteckt haben. "
 "Wenn ich Dir darueber was sagen soll, so frage mich nach Hilfe.",
 "sagt: ");
 AddInfo("august",
 "Der wahnsinnige August mit dem Jojo!", "lacht");
 
 
 
 AddSpell(1,1,
"Der Pflanzentrollmagier versucht Dir Deine Waffe aus der Hand zu reissen!\n",
"Der Pflanzentrollmagier versucht @WEM die Waffe aus der Hand zu reissen!\n",
DT_MAGIC, "spell_zwing");

 AddSpell(1,1,
"Der Pflanzentrollmagier haelt Dir Deine Augen zu!\n",
"Der Pflanzentrollmagier haelt @WESSEN Augen zu!\n",
DT_MAGIC, "spell_blind");

 AddSpell(1,1,
"Der Pflanzentrollmagier saugt dir Lebensenergie ab und heilt sich damit!\n",
"Der Pflanzentrollmagier saugt @WEM Lebensenergie ab und heilt sich damit!\n",
DT_MAGIC, "spell_zwing2");

 AddSpell(1,1,
"Der Pflanzentrollmagier schreit: Eine Ruestung muss her!\n",
"Der Pflanzentrollmagier schreit @WEN an: Eine Ruestung muss her!\n",
DT_MAGIC, "spell_zwing3");

 AddSpell(1,1,
"Der Pflanzentrollmagier schreit: GIB MIR DEIN GELD!\n",
"Der Pflanzentrollmagier schreit @WEN an: GIB MIR DEIN GELD!\n",
DT_MAGIC, "spell_muenzen");


  AddSpell(1,2,
"Der Pflanzentrollmagier murmelt irgendeine seltsame Formel.\n",
"Der Pflanzentrollmagier murmelt irgendeine seltsame Formel.\n",
DT_MAGIC, "spell_unfug");
  
  AddSpell(1,1,
"Der Pflanzentrollmagier dreht sich im Kreis und dir schwinden alle Sinne.\n",
"Der Pflanzentrollmagier dreht sich im Kreis und @WEM schwinden alle Sinne.\n",
DT_MAGIC, "spell_trans");
   
  AddSpell(1,1,
"Der Pflanzentrollnagier haelt eine eklige Kroete vor Dein Gesicht.\n",
"Der Pflanzentrollmagier haelt @WEM eine Kroete vor das Gesicht.\n",
DT_MAGIC, "spell_frog");

    AddSpell(5,300,
"Der Pflanzentrollmagier wuergt Dich!\n",
"Der Pflanzentrollmagier wuergt @WEN.\n",
DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

    AddSpell(5,350,
"Der Pflanzentrollmagier schlaegt Dir mir der Faust auf die Nase.\n",
"Der Pflanzentrollmagier schlaegt @WEM mit der Faust auf die Nase.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

    AddSpell(5,300,
"Der Pflanzentrollmagier bruellt Dich an.\n",
"Der Pflanzentrollmagier bruellt @WEN an.\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5,500,
"Der Pflanzentrollmagier schleudert Baeume auf Dich.\n",
"Der Pflanzentrollmagier schleudert Baeume auf @WEN.\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

 AddSpell(5,400,
"Der Pflanzentrollmagier zaubert Dir einen Quellsamen in Deinen Magen.\n",
"Der Pflanzentrollmagier zaubert einen Quellsamen in @WESSEN Magen.\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
  "Der Pflanzentrollmagier grinst Dich boesartig an.\n",
  "Der Pflanzentrollmagier scheint etwas auszuhecken...\n",
  "Der Pflanzentrollmagier lacht laut.\n",
  "Der Pflanzentrollmagier sagt: Du bist ziemlich doof.\n",
  "Der Pflanzentrollmagier sagt: Gegen mich ist Elsurion ein Weichei!\n",
  "Der Pflanzentrollmagier kratzt seinen Buckel.\n",
  "Der Pflantentrollmagier geht im Kreis.\n",
  "Der Pflanzentrollmagier graebt im Boden.\n", 
  "Der Pflanzentrollmagier stinkt ziemlich.\n"}) );
  
 
 
 AddInfo("hilfe", "@@help@@"); 
 
 
 
 SUID;
 CLONEME(WEAPON"st2");
 //absichtlich keinzuecken 
  
}


Defend(int dam, string dtype, int spell, object enemy)    
  {


  if (!pointerp(dtype))
      dtype = ({ dtype });
        if (sizeof(dtype & ({ DT_FIRE }) ))
          {
              tell_room(environment(), "Der Pflanzentrollmagier freut sich.\n");
              heal_self(dam/2);
            return ::Defend(0, dtype, spell, enemy);
     }
     
     
       if (sizeof(dtype & ({ DT_MAGIC }) ))
         {
         heal_self(dam);
             tell_room(environment(), "Der Pflanzetrollmagier bedankt sich.\n");
                 return ::Defend(0, dtype, spell, enemy);
                   }

 if (sizeof(dtype & ({ DT_HOLY }) ))
         {
             tell_room(environment(), "Der Pflanzetrollmagier windet sich vor Schmerzen.\n");
                 return ::Defend(2*dam, dtype, spell, enemy);
                   }


 if (sizeof(dtype & ({ DT_AIR }) ))
         {
             tell_room(environment(), "Der Pflanzetrollmagier lacht sehr laut ueber diesen Angriff!\n");
                 return ::Defend(0, dtype, spell, enemy);
                   }


 if (sizeof(dtype & ({ DT_WATER }) ))
         {
             tell_room(environment(), "Der Pflanzetrollmagier lacht ueber diesen Angriff!\n");
                 return ::Defend(dam/4, dtype, spell, enemy);
                   }

 if (sizeof(dtype & ({ DT_COLD }) ))
         {
             tell_room(environment(), "Der Pflanzetrollmagier schreit laut auf!\n");
                 return ::Defend(dam+random(20), dtype, spell, enemy);
                   }



   return ::Defend(dam, dtype, spell, enemy);    
   }
   
   












       
 help()
 {
 object ob1;
 object ob2;
 object ob3;
 object ob4;
 
 if((present( "symbolmuenze", TP)) && (present("pflanzenbuch", TP)) && 
 (present("hexenblut", TP)))
     {
  return("sagt: Hurra! "+TPN+", dafuer bin ich Dir "
  "wirklich dankbar. Hier hast Du eine Belohnung! Und nun hau ab!\n"
  "\n"
  "Dann nimmt der Pflanzentrollmagier Dir die besagten 3 Dinge weg "
  "und scheint sie irgendwo zu verstecken.\n");
 ob1=present("kraut", TP);
 ob2=present("pflanzenbuch", TP);
 ob3=present("symbolmuenze", TP);
 ob1->remove(1);
 ob2->remove(1);
 ob3->remove(1);
 ob4=clone_object("/d/dschungel/dante/fels/obj/teil5.lpc");
 ob4->move(TP, M_NOCHECK);
  
     }
  
  else 
  
     {
     return("grinst boesartig und sagt:\n"
     "Bring mir eine Symbolmuenze, ein Hexenblut und ein Pflanzenbuch!\n"
     "Dann werde ich Dir weiterhelfen! Frag mich dann noch mal nach Hilfe!\n");
     }
     
     }
     
  init()
  {
  ::init();
  if(interactive(TP)) call_out("hallo",0);
  }

 void hallo()
 {
 command("emote mustert Dich und sagt: Gruess Dich "+ TP->name(RAW) +".");
 command("emote fragt Dich: Was fuehrt Dich in diese einsame Gegend?");
   
 }



       
void spell_zwing(object enemy, int damage, mixed dam_type)
{

object ob1;
string waffenname;
ob1= enemy->QueryProp(P_WEAPON);
if (ob1 && !(ob1->QueryProp(P_CURSED)))
{
ob1->UnWield();
ob1->move(ENV(ME), M_NOCHECK);

}
else

tell_object(enemy,
"Der Pflanzetrollmagier schlaegt Dir aus Zorn in den Bauch.\n");
 enemy->do_damage(10)+random(5);       
    }
       
       
 void spell_muenzen(object enemy, int damage, mixed dam_type)
 {
 object ob;
 if (ob=present("muenzen",enemy) )
 {
 enemy->command_me("!\gib muenzen an troll");
 }
 else
 {
 enemy->do_damage(10)+random(5);
 tell_object(enemy,
 "Der Pflanzentrollmagier schlaegt Dir aus Wut ueber Deine Armut ins Gesicht.\n");
 }
 }
 
void spell_unfug(object enemy)
{
switch(random(100))
{
case 0 .. 16 :
     enemy->SetProp(P_WIMPY_DIRECTION, "TOD");
     break;
case 17 .. 35:
     enemy->SetProp(P_WIMPY, 0);
     tell_object(enemy,
     "Unglaublicher Mut ueberkommt Dich!\n");
     break;
case 36 .. 47:
     tell_object(enemy,
     "Der Pflanzentroll bruellt: Das naechste Mal erwisch Ich Dich!!!\n");
     break;     
case 48 .. 58:
     enemy->command_me("!\rufe Ich bin ein Feigling!\n");
     break;
case 59 .. 73:
     enemy->command_me("!\zieh alles aus");
     break;
case 74 .. 95:
     enemy->comand_me("!\wirf alles weg");
     break;
case 96 .. 100:
     enemy->command_me("!\gib alles an troll");
     command("zieh alles an");             
     }
 }
 
void spell_trans(object enemy)
{
switch(random(100))
{
case 0 .. 20:
     enemy->move("/d/dschungel/dante/weg/room/wegp3",M_NO_SHOW + M_TPORT);
     break;
case 21.. 40:
     enemy->move("/d/dschungel/dante/weg/room/vorsprung",M_NO_SHOW + M_TPORT);
     break;
case 41 .. 65:
     enemy->move("/d/dschungel/dante/fels/room/fels24",M_NO_SHOW + M_TPORT);
     break;
case 66 .. 85:
     tell_object (enemy,
     "Der Pflanzentrollmagier schreit: Du Wurm hast nur Glueck gehabt!\n");
     break;
          
case 86 .. 95:
     enemy->move("/d/gebirge/eros/room/berg_d18",M_NO_SHOW + M_TPORT);
     break;
case 96 .. 100:
     enemy->move("/d/ebene/lamuerte/wwald/room/18y_29x", M_TPORT);          
     }
 }
 
 
 
  void spell_zwing2 (object enemy, int damage, mixed dam_type)
 {
  switch(random(100))
  {
   case 0 .. 35 :
                 enemy->do_damage(10);
                 heal_self(10);
                 break;
                 
   case 36 .. 60 :
                 enemy->do_damage(20);
                 heal_self(20);
                 break;
                 
   case 61 .. 77 :
                 enemy->do_damage(30);
                 heal_self(30);
                 break;
                 
   case 78 .. 91 :
                 enemy->do_damage(40);
                 heal_self(40);
                 break;
                 
   case 92 .. 100 :
                 enemy->do_damage(50);                                            
                 heal_self(50);
     }
  }
 
 
 
 
 
  void spell_zwing3 (object enemy, int damage, mixed dam_type)
 {
 object ob;
 
 if (ob=present("ruestung", enemy) )
 {
 enemy->command_me("gib ruestung an troll");
 command("zieh ruestung an");
 }
 
 if (ob=present("panzer", enemy) )
 {
 enemy->command_me("gib panzer an troll");
 command("zieh panzer an");
 }
 
 else
 {
 enemy->do_damage(10)+random(5);
 tell_object(enemy,
 "Der Pflanzentrollmagier schreit: Du bist ja fast nackt!\n");
 }
 }
 
void spell_blind(object enemy)
{
switch(random(100))
{
case 0 .. 50:
     enemy->SetProp(P_BLIND, 1);
     break;
case 51.. 100:
     write("Der Pflanzentrollmagier schreit: Du hast nochmal Glueck gehabt!!!\n");
     }
 }
 
void spell_frog(object enemy)
{
switch(random(100))
{
case 0 .. 50:
     enemy->SetProp(P_FROG, 1);
     break;
case 51 .. 100:
     write("Der Pflanzentrollmagier schreit: Du hast nochmal Glueck gehabt!!!\n");
     }
 }
 
 
 void NotifyPlayerDeath(object player, object killer, int lostexp)
 {
// write_file(LOG "troll",
 // ctime()+": Der Pflanzentrollmagier hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  command("nimm alles aus leiche");
  command("zieh alles an");
  heal_self(100);
  }
  
int kill(string str)
{
  if( id(str) )
    call_out("kill2", 0);
}
  
void kill2()
{
  write("Der Pflanzentrollmagier laesst sich sowas von Dir nicht gefallen.\n");
  Kill(TP);
}
 
