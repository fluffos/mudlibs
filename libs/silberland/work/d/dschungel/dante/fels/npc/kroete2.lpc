// ein kleiner guter ekliger schleimiger frosch by dante97 jaenner
// 
// 
// 

inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "files.h"
#include <mnpc.h>
create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine graue Dschungelkroete");
  SetProp(P_LONG, BS(
  "Die graue Dschungelkroete ist ein ekliges Tier, das ihre gewohnte Umgebung "
  "nie verlaesst. Sie ernaehrt sich von Wuermern und Larven. Ihr Koerper "
  "ist ueber und ueber mit Warzen bedeckt."));
     
  AddDetail(({"koerper","warzen","warze"}),
  "Du ekelst Dich vor den Warzen.");  
     
  SetProp(P_NAME, "Dschungelkroete");
  SetProp(P_GENDER, FEMALE);
  AddId (({"kroete","dschungelkroete"}));
  SetProp(P_INFO, ("Diese Dschungelkroete schmeckt sehr schlecht."));
  SetProp(P_DIE_MSG, " huepft ein allerletztes Mal.\n");
  
  create_default_npc (6);
  SetProp(P_HANDS, ({" mit ihrer langen Zunge", 50+random(20), DT_WHIP}));
  SetProp(P_RACE, "Kroete");
  SetProp(P_SIZE, 25);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  
  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft");
  SetProp(P_MMSGIN, "springt herein.");
  SetProp(P_MMSGOUT, "springt weit fort.");
  SetProp(P_MNPC_AREA, ROOM "fels");
  SetProp(P_MNPC_WAIT, ({5,10, 10}));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS + MOV_OUTDOORS); 
  SetProp(P_MNPC_DEFAULTROOM, ROOM "fels30");
  
  
  AddInfo(DEFAULT_INFO, (" Die Kroete quakt nur und springt vergnuegt herum.\n"));
  SetProp(P_HEAL, -5);
  AddInfo("dante",
          "quakt: Ich kann viel besser quaken als her...\n"); 
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Die Dschungelkroete springt quackend ueber @WEN hinweg.\n"}));
  
  
}

