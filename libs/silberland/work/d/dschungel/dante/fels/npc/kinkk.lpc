//kobra fuer quest!! dante 97
//kommt nur wenn gerufen....
//gibt kletzen teil wenn man frage beantwortet oder nur so hmm


inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Koenig der Kobras");
  SetProp(P_LONG, BS(
  "Das ist der Koenig der Kobras. Er ist groesser, staerker und natuerlich "
  "auch viel laenger als Du! Sei freundlich zu ihm, dann wird auch er Dir helfen.\n"));
  
  
  SetProp(P_NAME, "Koenig der Kobra");
  SetProp(P_GENDER, MALE);
  AddId(({"schlange", "kobra","koenig", "koenigskobra"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Giftzaehnen",450+random(20),({DT_POISON,DT_PIERCE}) }) );
  SetProp(P_SIZE, 10000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 15);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC,20);
  SetProp( P_RESISTANCE, ALL_DAMAGE_TYPES );
  
  
  SetProp(P_ATTRIBUTES, ([A_INT:30, A_DEX:50, A_STR:40, A_CON:50]) );  
  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "schlaengelt herein");
  SetProp(P_MMSGOUT, "schlaengelt hinaus");

  SetProp(P_DIE_MSG,  " zischt Dich nie wieder an.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "zischt Dich nur boese an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Speikobra braucht Deinen Muell nicht.\n" }) );

  AddInfo("zahn",
  "Du meinst meinen Giftzahn!?","sagt: ");
  AddInfo("giftzahn",
  "Ich hatte einmal zwei, aber einen hat mir dieser verdammte Mungokoenig "
  "gestohlen!", "sagt: ");
  AddInfo(({"mungo","mungos"}),
  "Der schlimmste von ihnen ist ihr Koenig.","sagt: ");
  AddInfo(({"koenig", "mungokoenig"}), "@@come@@");
  AddInfo("jojo",
  "Mich interessiert Dein Jojo nicht! Mein Problem sind sie Mungos!",
  "sagt: ");
  AddInfo("august",
  "Ach, lass mich mit dem zufrieden!", "sagt: ");
//haha
  
  SetProp(P_SPELLRATE,80);
  AddSpell(4,600,
    "Der Koenig der Kobras schlaegt seine Zaehne in Dein Fleisch.\n",
    "Der Koenig der Kobras schlaegt seine Zaehne in @WESSEN Fleisch.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,900,   
    "Der Koenig der Kobras spuckt Dir Gift in die Augen.\n",
    "Der Koenig der Kobras spuckt @WEM Gift in die Augen.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
     AddSpell(1,900,   
    "Der Koenig der Kobras erwuergt Dich beinahe.\n",
    "Die Koenig der Kobras erwuergt @WEN beinahe.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
     AddSpell(5,700,   
    "Der Koenig der Kobras zerfetzt Dein Bein.\n",
    "Der Koenig der Kobras zerfetzt @WESSEN Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(2,1,DS_POISON);
  
  SetChats(3, ({
  "Der Koenig der Kobras zischt Dich boese an.\n",
  "Der koenig der KObras richtet sich auf.\n",
  "Der koenig der Kobras schnappt nach Dir.\n",
  "Du bekreuzigst Dich aengstlich.\n",
  "Der Koenig der Kobras beobachtet Dich genau.\n",
  "Der Koenig der Kobras pfaucht Dich an.\n",
  "Der Koenig der Kobras beisst sich in den Schwanz.\n",
  "Der Koenig der Kobras schlaengelt naeher an Dich heran.\n",
  "Der Koenig der Kobras schlaengelt zwischen Deinen Beinen durch.\n"}) );
  
}

come()
  {
  object z;
  object ob;
  if(present("gzahnk", TP))
   {
   
     ob=clone_object("/d/dschungel/dante/fels/obj/teil4.lpc");
     ob->move(TP, M_NOCHECK);
     z=present("gzahnk", TP);
     z->remove(1);
   
   
     call_out("weg", 0);
     return("sagt: "+TPN+", ich danke Dir!\n"
     "Als Belohnung, dafuer, dass Du mir meinen Giftzahn widergebracht\n"
     "hast, schenke ich Dir einen Teil vom Jojo!\n"
    
     "\n"
     "Der Koenig der Kobras gibt Dir einen Teil vom Jojo und verschwindet "
     "dann wieder Dschungel.\n");
     
     
     }
 else
    {
    call_out("weg", 0);
    return("laechelt und sagt freundlich:\n"
    ""+TPN+", ist ja sehr gut, dass Du zu mir betest, aber\n"
    "mein Problem ist, das mir der Koenig der Mungos einen meiner\n"
    "Giftzaehne gestohlen hat. bring ihn mir wieder, und dann werde\n"
    "ich Dich belohnen. Frag mich dann einfach nochmal.\n"
    "\n"
    "Darauf hin verschwindet der Koenig der Kobras im Dschungel.\n");
    
    
    }
    
   } 
  
  weg()
  {
  remove();
  }
        
