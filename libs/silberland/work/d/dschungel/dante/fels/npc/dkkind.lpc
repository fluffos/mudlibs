// kannibalnekind

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

init()
{
  object defender;
  ::init();
  if (defender = present("Kmann")) AddDefender(defender);
  if (defender = present("Kfrau")) AddDefender(defender);
  if (defender = present("Kkind"))  AddDefender(defender);
  if (defender = present("Kkind 2")) AddDefender(defender);
}

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kannibalenkind");
  SetProp(P_LONG, BS(
    "Das Kannibalenkind sieht noch genauso unschuldig aus wie normale Kinder, "
    "aber tief in seinem Inneren schlummert bereits die Bestie...\n"));
  SetProp(P_NAME, "Kannibalenkind");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kannibalenkind", "kind", "Kkind"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen kleinen Faeusten",70+random(30),DT_BLUDGEON}));
  SetProp(P_RACE, "Kannibale");
  SetProp(P_SIZE, 130);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 30);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt hinter einem Busch hervor");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " haucht sein junges Leben aus.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_LOG_INFO, "dkannibalen");
  AddInfo(DEFAULT_INFO, "schreit: Mami, Mami!!!HILFE!!!\n");
  AddInfo("priester", "Er ist der maechtigste Mann im Dorf.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Kannibalenkind sagt: Ich darf von Fremden nichts annehmen.\n" }) );


  SetChats(3, ({
  "Das Kannibalenkind spielt im Sand.\n",
  "Das Kannibalenkind schaut Dich unschuldig an.\n",
  "Das Kannibalenkind will Spielzeug von Dir.\n",
  "Das Kannibalenkind bestaunt Deine weisse Haut.\n",
  "Das Kannibalenkind weint.\n",
  "Das Kannibalenkind zieht an Deinem Hosenbein.\n",
  "Das Kannibalenkind nagt an einem Knochen.\n",
  "Das Kannibalenkind furzt.\n",
  "Das Kannibalenkind kratzt sich am Knie.\n",
  "Das Kannibalenkind macht einen Purzelbaum.\n",
  "Das Kannibalenkind spielt opfert die Abenteurer.\n"}) );
  
  SetAttackChats(10, ({
  "Das Kannibalenkind schreit um Hilfe!\n",
  "Das Kannibalenkind kaempft verzweifelt um sein Leben.\n",
  "Das Kannibalenkind beisst Dir ins Bein.\n",
  "Das Kannibalenkind kreischt laut.\n"}) );

  SUID;
  switch( random(3) )
  {
    case 0:
      CLONEME(WEAPON_WEG "dknochen");
      command("zuecke knochen");
      break;
    case 1:
      CLONEME( WEAPON_WEG "dknueppel");
      command("zuecke knueppel");
      break;
  }
  CLONEME(ARMOUR "dschurz");
  command("trage alles");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

