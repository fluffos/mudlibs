//dante dante tante dante 97


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <mnpc.h>
#include <new_skills.h>
#include "files.h"




create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine kleine Spinne");
  SetProp(P_LONG, BS(
  "Diese Spinne ist wirklich nur sehr klein und harmlos."));   
  SetProp(P_NAME,"Spinne");
  AddId(({"spinne"}));
  SetProp(P_GENDER, FEMALE);
  create_default_npc(5);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HANDS, ({" mit ihren kleinen Zangen", 50+random(10), ({DT_SQUEEZE,DT_BLUDGEON})}));
  SetProp(P_ALIGN, 0);
  SetProp(P_SIZE, 20);
  SetProp(P_RACE, "Spinne");
  SetProp(P_NOCORPSE, 0);
  SetProp( P_REJECT, ({ REJECT_DROP, "Die Spinne ist doch viel zu klein.\n" }) );
  SetProp( P_DIE_MSG, " bricht leise zusammen.\n");
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_MSGIN, "laesst sich von der Decke herab");
  SetProp(P_MMSGIN, "laesst sich von der Decke herab");
  SetProp(P_MMSGOUT, "krabbelt hinaus");
  SetProp(P_MSGOUT, "krabbelt");
    
}

