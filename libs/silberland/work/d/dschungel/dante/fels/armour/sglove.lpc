//hanschuhe fuer quest dante

inherit "/std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"
#include <thing/material.h>
#include <new_skills.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Schlangenhandschuhe");
  SetProp(P_LONG,BS(
  "Das sind Handschuhe die aus Mungoleder gemacht wurden. Der Mungo ist "
  "der groesste Feind der Schlangen."));
  SetProp(P_NAME, "Schlangenhandschuhe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,0);
  AddId("handschuhe");
  SetProp(P_INFO, "Diese Handschuhe koennten Dir noch sehr nuetzlich sein.\n");
  AddId("sglove"); 
  AddId("schlangenhandschuhe");
  AddId("lederhandschuhe");
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY,1);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_SLASH:-0.5, DT_MAGIC:-1, DT_BLUDGEON:-1, DT_FIRE:-0.5]));
  SetProp(P_MATERIAL,([MAT_LEATHER:100,MAT_MISC_MAGIC:100]));
}
