/*
** 
** knochenhelm fuer die kannibalen waechter dante 97 jaenner
*/
#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"helm", "eisenhelm"}));
  SetProp (P_SHORT, "Ein alter, schwerer Eisenhelm");
  SetProp (P_LONG, BS("Der Helm bsteht aus Eisen und ist eigentlich noch in einem "
     "recht guten Zustand. Er ist sehr schwer."));
  SetProp (P_NAME, "Eisenhelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 2000);
   SetProp (P_MATERIAL, MAT_IRON);
  SetProp (P_VALUE, 100);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  
  SetProp (P_AC, 6);
  SetProp (P_MATERIAL, MAT_IRON);

}
