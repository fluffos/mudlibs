/*
** mutantenspinnenpanzer dante sl jaenner 97
** 
*/
#include <thing/material.h>
inherit "std/armour";
#include <new_skills.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "files.h"
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer","mutantenspinnenpanzer","spinnenpanzer"}));
  SetProp (P_SHORT, "Ein Mutantenspinnenpanzer");
  SetProp (P_LONG, BS("Das ist der Panzer der dreikoepfigen Mutantenspinne. Er passt"
  " Dir sehr gut, denn fuer Deinen Kopf und Deine beiden Arme sind ja die Loecher"
  " der drei Koepfe da."));
  SetProp (P_NAME, "Mutantenspinnenpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1800);
  SetProp(P_INFO, "Der Panzer ist ein sehr guter Schutz.\n");
  SetProp (P_VALUE, 4000);
  SetProp (P_MATERIAL, MAT_HORN);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 38);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 15 ,A_STR: 15]));
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_POISON:-2.0,DT_ACID:-2.0, DT_TERROR:-1.0,
  DT_BLUDGEON:-1.0,DT_SLASH:1.0,DT_AIR:-1.0, DT_PIERCE: 1.0]));
  
  
  
}
