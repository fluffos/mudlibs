/*schild fuer die dummen kanis....schklechtes schild!!!!
** 
** 
*/

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"schild","Khaokoschild"}));
  SetProp (P_SHORT, "Ein Khaokoschild");
  SetProp (P_LONG, BS("Dieses Schild ist aus Khaoko gemacht. Einer sehr harten"
                   " Holzart des hiesigen Dschungels."));
  SetProp (P_NAME, "Khaokoschild");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 550);
  SetProp (P_VALUE, 200);

  SetProp (P_ARMOUR_TYPE, AT_SHIELD);  
  SetProp (P_AC, 15);
}
