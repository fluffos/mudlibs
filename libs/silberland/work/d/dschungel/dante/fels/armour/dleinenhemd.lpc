/*
** leinenhemd
** fuer den einsiedler dante 97 jaenner
*/
#include "../def.h"
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"hemd","leinenhemd"}));
  SetProp (P_SHORT, "Ein Leinenhemd");
  SetProp (P_LONG, BS(
    "Das Hemd ist aus groben Leinen gesponnen. Es hat zwei Brusttaschen, die "
    "aber komischwerweise zugenaeht sind. An den Ellbeugen verdecken grosse "
    "Lederflicken zwei faustgrosse Loecher. Ueberhaupt ist es in einem "
    "jaemmerlichen Zustand."));
  AddDetail(({"loecher","flicken","loch","lederflicken","leder"}),
    "Der Einsiedler hat die Loecher mit zwei grossen Flicken aus "
    "Warzenschweinleder ueberdeckt.");
  AddDetail(({"taschen","brusttaschen"}),
    "Warum hat der Einsiedler die wohl zugenaeht?\n");
  
   
  SetProp (P_NAME, "Leinenhemd");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 800);
  SetProp (P_VALUE, 600);
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 16);
  SetProp (P_MATERIAL, MAT_CLOTH);
}
