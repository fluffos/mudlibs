//eine zueckschlange fuer mungo

#include "files.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>

create()
{
  if( !is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Schlangenwaffe");
  SetProp(P_LONG, BS(
  "Diese Schlange ist keine Schlange, sondern eine Waffe die einer Schlange "
  "aehnelt. Wofuer sie wohl zu verwenden ist?"));
  SetProp(P_NAME, "Schlangenwaffe");
  SetProp(P_INFO, BS(
  "Die Schlangenwaffe hasst, nein, verrate ich nicht!"));
  
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEAPON_TYPE, WT_MAGIC );
  SetProp(P_DAM_TYPE, "mungotod");
  SetProp(P_WC, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({ MAT_METAL, MAT_MAGIC}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:8]) );
  SetProp(P_HIT_FUNC, TO);

  AddId(({"schlange","schlangenwaffe"}));
}

int HitFunc(object enemy)
{
  int schaden;
  if( enemy->id("mungo") )
  {
    schaden=random(600);
    if( schaden>400)
      write("Die Schlangenwaffe zischt und wendet ihre Magie gegen "+
       enemy->name(WEN)+".\n");
    return 10*enemy->QueryProp(P_LEVEL)+schaden;
  }
  write(CAP(enemy->name(WER) )+" ist mit der Schlangenwaffe nicht zu verwunden.\n");
  return -250;      
}
