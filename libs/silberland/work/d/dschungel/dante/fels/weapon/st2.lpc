//waffe fuer trollmagier fuer druiden gut, ann schlaege anbwehren z.b
// al sehn 98
//hmmmmm was noch?

inherit "/std/weapon";
inherit "/std/armour/combat";
//inherit "/secure/exploration";

#include <wizlevels.h>
#include <properties.h>
#include <combat.h>
#include <weapon.h>
#include "../def.h"
#include <language.h>
#include <moving.h>
#include <attributes.h>

object wer;

void create()
{

  if (!is_clone(this_object())) return;
  weapon::create();
  combat::create();

  SetProp( P_SHORT, "Ein Druidenstock" );
  SetProp( P_LONG,BS(
  "Dieser Stock hat einst dem boesen Pflanzentrollmagier gehoert. Er hat ihn "
  "einem unvorsichtigen Druiden abgenommen. Eigentlich sieht er aus wie ein "
  "ganz normaler Nikolostock, also am oberen Ende wie eine Schnecke eingerollt.\n"));
  SetProp( P_NAME,   "Druidenstock" );
  SetProp( P_GENDER, MALE );
  SetProp( P_WEIGHT, 500 );
  SetProp( P_SIZE, 170 );
  SetProp( P_VALUE, 7000 );
  SetProp (P_DAM_TYPE, ({DT_BLUDGEON,DT_HOLY,DT_MAGIC}));
  SetProp( P_NR_HANDS, 1 );                       // Einhaendige Waffe
  SetProp( P_WEAPON_TYPE, WT_CLUB );
  //SetProp (P_WC_BONUS,(["DRUIDE":200]));
SetProp(P_MATERIAL, ([ MAT_MAGIC:100, MAT_WOOD: 100]) );
  AddId(({"druidenstock","stock"}));
  SetProp(P_WC, 300);
  SetProp(P_INFO, ("Dieser Druidenstock ist fuer Druiden eine sehr gute Waffe.\n "));
    SetProp(P_HIT_FUNC, TO);
//  SetProp(P_WEAR_RESTRICTIONS,([ A_INT: 15, A_DEX: 15, P_FROG: 1]));
  SetProp(P_AC, 0);
  SetProp(P_ARMOUR_TYPE, AT_MISC);

  SetProp(P_DEFEND_FUNC, TO);
 SetProp(P_WIELD_FUNC, TO);
 // SetProp(P_UNWIELD_FUNC, TO);
  
   }
   



  int DefendFunc(string *dtype, mixed spell, object enemy)
  {
   int inte, dext, lev, pow, con, leben, magie;
   
     string *abwehrschaden;

       abwehrschaden = ({DT_TERROR,DT_UNHOLY,DT_LIGHTNING,DT_EXPLOSION,DT_FIRE,DT_BLUDGEON,DT_MAGIC});
       if(sizeof(dtype - abwehrschaden))
//die schaeden muesste man halt aendern

       
   {
       switch(random(6))

             {
                 
   
    case 0: 
    
     return 0;
      break;

  case 1: 
  
      lev=TP->QueryProp(P_LEVEL);
       tell_object(wer,
       "Dein Druidenstock versucht den Angriff anzuwehren.\n");
       return (lev);
       break;
            
  
  
  
       
   case 2:
   
   leben=TP->QueryProp(P_HP);
    magie=TP->QueryProp(P_SP);
                       
       tell_object(wer,
     "Dein Druidenstock versucht den Angriff abzuwehren.\n");
     return (leben+magie);
     break;
     
     case 3:
     
       inte=TP->QueryProp(A_INT);
    dext=TP->QueryProp(A_DEX);
    pow=TP->QueryProp(A_STR);
   con=TP->QueryProp(A_CON);   
                               
    tell_object(wer,
    "Dein Druidenstock versucht den Angriff abzuwehren.\n");
     return (dext+inte+pow+con);
           break; 
                    
 
     case 4:     
      
      magie=TP->QueryProp(P_SP);                 
     tell_object(wer,
     "Dein Druidenstock versucht den Angriff abzuwehren.\n");
            return (magie);
        break;
        
         
    case  5:
    leben=TP->QueryProp(P_HP);              
    tell_object(wer,
    "Dein Druidenstock versucht den Angriff abzuwehren.\n");
    return (leben);
    break;
                   
                   
     default: write("BUG!\n");
     
        }//switch zu
     
        
     }  //schadenstyp zubledsinn

    return 0;
 }



 int HitFunc(object enemy)
 {
 if ( enemy->id("pflanzentrollmagier") )
    {
       write(CAP(enemy->name(WER) )+" ist mit seinem Stock nicht zu treffen.\n");
       return -250;
       }
         }

int WieldFunc(object waffe)
 {


  if(TP->QueryProp(P_GUILD)=="abenteurer")

    {
    wer=TP;
    write("Du als Druide kannst den Druidenstock zuecken.\n");
    DoWear(M_SILENT);
    return 1;
    }


    else
       {
       write("Du als Nicht-Druide kannst diesen Stock nicht zuecken.\n");
       say(""+TPN+" wuerde gerne den Druidenstock zuecken, kann aber nicht.\n");
       return 0;
       }

     }


DoUnwield( silent )
 {
  int res;

  res=(::DoUnwield(silent));
  if (res)
    DoUnwear (M_SILENT);
  return res;
}

