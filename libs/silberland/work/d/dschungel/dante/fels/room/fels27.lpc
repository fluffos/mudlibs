// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du folgst dem kleinen Pfad und gelangst mitten ins wildeste Dickicht.\n"
  "Rings um Dich undurchdringbarer Dschungel, nur der Pfad gibt Dir einen "
  "Anhaltspunkt. Am Boden sieht man seltsame Abdruecke..."));
  AddDetail(("boden"),
  "Der Boden ist hier sehr weich und weisst grosse, tiefe Abdruecke auf.");
  AddDetail(({"abdruck", "abdruecke"}),
  "Die tiefen Abdruecke sehen so aus, als ob hier manchmal schwere Koerper "
  "einschlagen.");
  AddDetail(("koerper"),
  "Was koennte das wohl sein...");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(("pfad"),
  "Der Pfad endet hier und fuehrt nur mehr nach Nordwesten.");
  AddDetail(("anhaltspunkt"),
  "Ein dummes Wort...");
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht. Inmitten der Pflanzen siehst Du "
  "hoch oben eine grosse Schneise...");
  AddDetail(({"pflanzen","pflanze"}),
  "Hier wachsen eigentlich ganz normale Dschungelpflanzen.");
  AddDetail(("schneise"),
  "Sieht aus, als ob hier machmal irgendetwas oder irgendjemand durchgeflogen kommt."
  "Was hat das wohl zu bedeuten ?");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die Affen von weitem schon kreischen.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Affen.");

  AddItem(OBJ_WEG"dbana" , REFRESH_REMOVE);
  AddExit( "nordwesten", "./fels26");
}
