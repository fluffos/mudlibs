// a, felsen by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Rand des Hochplateaus" );
  SetProp( P_INT_LONG, BS(
  "Du stehst am Rand des kleinen Plateaus. Westlich von Dir faellt der Urwald"
  " steil nach unten ab und scheint keine Moeglichkeit zum Abstieg zu bieten."
  " Im Norden baut sich eine Wand aus umgestuerzten Baeumen, vermoderten "
  "Pflanzen und Geroell vor Dir auf.\n"));
  
  AddDetail(("rand"),
  "Das Plateau erstreckt sich weiter suedlich und oestlich...\n");
  AddDetail(({"plateau","hochplateau"}),
  "Das kleine, verborgen gelegene Plateau ist eine stille Idylle im sonst so"
  "feindlichen Urwald.\n");
  AddDetail(("urwald"),
  "Der Dschungel hier scheint voellig unberuehrt zu sein.\n");
  AddDetail(("moeglichkeit"),
  "Du probierst Dir einen Weg nach unten zu bahnen, gibst aber gleich\n"
  " wieder auf.\n");
  AddDetail(("abstieg"),
  "Der Hang faellt hier fast senkrecht nach unten in die Tiefe und ist mit"
  "vielen glitschigen Pflanzen bewachsen.\n");
  AddDetail(("tiefe"),
  "Als Du so ueber den Rand nach unten blickst, wird Dir ziemlich schwindlig.\n");
  AddDetail(("norden"),
  "Vor Dir beginnt der wild wuchernde Dschungel, der undurchdringbar scheint.\n");
  AddDetail(("wand"),
  "Der Urwald bildet hier eine natuerliche Barriere gegenueber laestigen \n"
  "Eindringlingen, wie Du einer bist.\n");
  AddDetail(("baeume","baum"),
  "Viele umgefallene tote  Baeume liegen hier wild verstreut "
  "uebereinander. Ein richtiges Durcheinander...\n");
  AddDetail(("geroell"),
  "Truemmer von grossen Felsen tuermen sich vor Dir auf.\n");
  AddDetail(("truemmer"),
  "Grosse, kleine und mittlere Gesteinsbrocken liegen wahllos verstreut herum.\n");
  AddDetail(({"gesteinsbrocken","brocken","gestein"}),
  "Das Chaos erinnert dich an Dein Zimmer...\n");
  AddDetail(("durcheinander"),
  "Als Du dir alles genauer ansiehst, findest Du...NEIN!Doch nichts...\n");
  AddDetail(({"pflanze","pflanzen"}),
  "Von den ehemals bunten Pflanzen, scheint keine einzige mehr zu leben.\n"
  "Sie haengen traurig in braunen und grauen Farbtoenen welk herab.\n");
  AddDetail(({"farben","toene","farbtoene"}),
  "Braun, Grau, Schwarz.....\n");
  AddDetail(("Dschungel"),
  "Du steckst mitten drinnen.\n");
  AddDetail(("chaos"),
  "Bei genauerer Untersuchung des Chaos faellt Dir eine kleine Luecke auf.\n");
  AddDetail(("luecke"),
  "Sie scheint nach Nordwesten zu fuehren...\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  
  AddSound( DEFAULT_SOUND,
    "Du hoerst des Gesang vieler verschiedener Voegel.");
    
  AddSmell( DEFAULT_SMELL,
    "AHHH!!!Herrlich diese gute Luft...");

  SetProp(P_HIDE_EXITS, ({"nordwesten"}) );
  
  AddItem( ({NPC_WEG"dztapir", NPC_WEG "dratte", NPC_WEG "dschimp",
             NPC_WEG "dmoskito", NPC_WEG "bmamba"}) , REFRESH_DESTRUCT);
  
  AddExit( "sueden", "./fels5");
  AddExit( "nordwesten", "./fels7");
  AddExit( "osten", "./fels4");
}
