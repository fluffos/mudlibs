// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

// nosave int king;
 
create()
{
  ::create();

 // king= 1;

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du folgst dem kleinen Pfad und gelangst mitten ins wildeste Dickicht.\n"
  "Rings um Dich undurchdringbarer Dschungel, nur der Pfad gibt Dir einen "
  "Anhaltspunkt.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  AddDetail(("himmel"),
  "Der Himmel ist strahlendblau.");
  AddDetail(("boden"),
  "Der Boden weist keinerlei Besonderheiten auf.");
  AddDetail(({"besonderheiten","besonderheit"}),
  "Du siehst keine Besonderheiten.");
  AddDetail(({"pflanze", "pflanzen"}),
  "Die Pflanzen scheinen hier etwas merkwuerdig zu sein. Ein besonders "
  "seltsamer Strauch faellt Dir hier auf.");
  AddDetail("strauch",
  "Der Strauch ist ein sogennanter Arbokstrauch.");
  AddDetail(({"arbok","arbokstrauch"}),
  "Der Arbokstrauch ist eigentlich nichts besonders. Kobras halten sich "
  "sehr gerne in seiner Naehe auf.");
  AddDetail(({"kobra","kobras"}),
  "Du schaust, sieht aber keine, zumindest im Moment. Was Du aber entdeckst "
  "laest Deinen Atem stocken. Voll ueberwuchert von Pflanzen siehst Du einen "
  "kleinen Altar.");
  
  AddDetail("altar",
  "Der Altar zeigt eine gewaltige Koenigskobra, die sich fauchend aufrichtet "
  "und einen Mungo bedroht. Unter Mungo und Koenigskobra siehst Du auch einige Zeichen.");
  AddDetail("koenigskobra",
  "Der Koenigskobra scheint ein Zahn zu fehlen.");
  AddDetail("zeichen",
  "Die Zeichen kannst Du nicht verstehen, aber Dich ueberkommt ein Gefuehl der Suende.");
  AddDetail("gefuehl",
  "Du fuehlst Dich schuldig!");
  AddDetail("suende",
  "Was tut man wenn man sich suendig fuehlt...");
  AddDetail("zahn",
  "Es scheint sich um einen gewaltigen Giftzahn zu handeln.");
  AddDetail("giftzahn",
  "Spitz und gefaehrlich sieht er aus.");
  AddDetail("mungo",
  "Der Mungo ist der groesste Feind der Kobras. Er scheint einen spitzen ,langen "
  "Gegenstand zu halten und grinst triumphierend.");
  AddDetail("feind",
  "Die Kobras fuerchten ihn sehr.");
  AddDetail("gegenstand",
  "Hmm, es koennte ein Zahn sein.");
  AddDetail("atem",
  "Einatmen nicht vergessen!\n");
  AddDetail("naehe",
  "Sei froh!\n");
  AddDetail("dickicht",
  "Undurchdringbar abseits des Pfads.");
  AddDetail("pfad",
  "Der Pfad schlaengelt sich immer weiter zwischen den Pflanzen in den Dschungel.");
  AddDetail("anhaltspunkt",
  "Hast Du hier keinen.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein lautes Trommeln...");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Affen.");


  AddItem( ({NPC_WEG"dgorilla2", NPC_WEG "dpavian", NPC_WEG "dschimp",
             NPC_WEG"dratte"}) , REFRESH_DESTRUCT);
  
  AddExit( "westen", "./fels48");
  AddExit( "nordosten", "./fels39");
  AddExit( "suedosten", "./fels27");

AddCmd(({"beichte","beicht"}), "no");
AddCmd(({"bete", "bet","huldige","huldig"}),"yes");

  
}

yes(string str)
  {
  
  object ob;
  notify_fail("Zu wem willst Du hier beten?\n");
  if (!str)
     {
  write("Du betest, fuehlst Dich etwas besser, aber passieren tut auch nichts.\n");
  say(""+TPN+" betet, hoert aber gleich wieder auf.\n");
  return 1;
     }
  
  if(str=="zu kobra" ||str== "zu kobras" ||str== "zu schlangen"||str=="zu schlange")
     {
     write("Du betest zu Kobras und Schlangen, doch nichts passiert.\n");
     say(""+TPN+" betet zu Kobras und Schlangen.\n");
     return 1;
     }
     
  if(str=="zu koenigskobra" || str=="zu koenig der kobras" || str=="zu koenig der schlangen")
     {
      if(present("kobramul", TP))//kobraamulett
        {
        write("Du betest zum Koenig der Kobras und ploetzlich raschelt es "
        "im Dschungel, Voegel fliegen erschrsckt auf und...\n");
        say(""+TPN+" betet zum Koenig der Kobras.\n");
        ob=clone_object("d/dschungel/dante/fels/npc/kinkk.lpc");
        ob->move(environment(TP), M_GO);
        return 1;
        }   
   else
      {
  write("Du betest zum Koenig der Kobras...\n");
  write("Eine Kobra schlaengelt herein, untersucht Dich und sagt:\n"
  "HMMM, nein, so kannst Du unserem Koenig nicht gegenuebertreten.\n"
  "So gehoert Du nicht zu uns! Such Dir was passendes, dann komm wieder.\n"
  "\n"
  "Darauf schlaengelt die Kobra wieder zurueck in den Dschungel.\n");
  say(""+TPN+" betet zum Koenig der Kobras, doch auch das hilft "+TPN+" "
  "im Moment nicht viel.\n");
  return 1;
  }
  return 0;
  }
return 0;
}  
 

 no ()
   {
   write("Du beichtest, gibst aber gleich auf, denn hier ist niemand dem "
   "Du beichten koenntest.\n");
   say(""+TPN+" wuerde gerne beichten, kan aber nicht.\n");
   return 1;
   }
   

