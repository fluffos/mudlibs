// a, felsen 2  by dante 97
//huette des einsiedlers
#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define offen 1  //fuer spind
#define zu 0
#define da 1
#define weg 0

#define open 1  //fuer truhe
#define close 0
#define hier 1
#define nichtda 0

int truhe, sache;
int spind, ding;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Huette des Einsiedlers" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich hier in der kleinen Schlafkammer des Einsiedlers. "
  "Ein schmales Holzbett, ein kleiner Spind und eine Truhe sind die gesamte "
  "Einrichtung. Der Boden besteht aus rohen Holzplanken, an den Waenden "
  "haengen einige kleine Bilder. Fenster gibts es hier keine, wozu auch "
  "der Einsiedler will hier ja nur schlafen..."));
  
  
  AddDetail(("raum"),
  "Das hier ist die Schlafkammer des Einsiedlers.");
   AddDetail(("bett"),
   "Du meinst das Holzbett *grins*");
   AddDetail(("holzbett"),
   "Das Bett ist eher klein und flach. Es sieht ungemuetlich aus, nur eine "
   "kratzige Wolldecke liegt auf dem sonst harten Bett.");
   AddDetail(("wolldecke"),
   "Die Decke besteht aus Wolle, ist aber schon sehr abgenutzt und alt.");
   AddDetail(("wolle"),
   "Die einst so weisse Wolle, ist nun grau und braun."); 
  AddDetail(("ausgang"),
  "Im Osten kommst Du aus der Schlafkammer wieder hinaus.");
  AddDetail(({"wand","waende"}),
  "An den Waenden haengen einige kleine Bilder.");
  AddDetail(("truhe"),
  "Diese Truhe weist im Gegensatz zu der Truhe im Hauptraum kein Schloss "
  "auf. Du versuchst sie zu oeffnen, aber so geht diese Truhe sicher nicht auf...");
  AddDetail(({"zimmer","hauptraum"}),
  "Im Osten liegt der Hauptraum der Huette.");
  
  AddDetail(("schloss"),
  "Diese Truhe hat kein Schloss.");
  AddDetail(("boden"),
  "Der Boden besteht aus rohen Holzplanken, die schon ziemlich mit "
  "Staub bedeckt sind.");
  AddDetail(("staub"),
  "Der Einsiedler koennte ruhig wieder einmal staubwischen.");
  AddDetail(("gegensatz"),
  "Im anderen Raum hat die Truhe ja ein Schloss.");
  AddDetail(({"planke","planken"}),
  "Lange, rohe Holzplanken bilden den Boden.");
  AddDetail(({"holzplanke","holzplanken"}),
  "Es muss dem Einsiedler viel Arbeit gekostet haben sie zu schneiden und zu verlegen.");
  AddDetail(("decke"),
  "Die Decke besteht ebenfalls aus rohen Holzplanken, sonst ist an ihr nichts "
  "Besonderes zu entdecken.");
  AddDetail(("besonderes"),
  "An der Decke gibt es doch etwas besonderes, Spinnweben...");
  AddDetail(({"spinnweben","spinnwebe"}),
  "Du glaubst auch eine kleine Spinne zu sehen...");
  
  AddDetail(({"spind"}),
  "Der Spind ist ebenfalls aus Holz gefertigt. Du erkennst eine kleine "
  "Einkerbung.");
  AddDetail(("einkerbung"),
  "Die Einkerbung ist eher eine Schnitzerei.");
  AddDetail(("schnitzerei"),
  "Du erkennst den Einsiedler der mit einigen anderen Maennern kaempft.");
  AddDetail(("einsiedler"),
  "Der Einsiedler scheint zu siegen...");
  AddDetail(({"mann","maenner"}),
  "Die Maenner schauen wie Kannibalen aus...");
  AddDetail(({"kanibalen","kannibale"}),
  "Du zuckst zusammen; sollte es hier etwa Kannibalen geben...");
  AddDetail(({"bild","bilder"}),
  "Die Bilder an der Wand zeigen verschieden Erlebnisse des Einsiedlers. "
  "Er hat sie wohl selbst gemalt...");
  AddDetail(("dschungel"),
  "Der Dschungel ist draussen vor der Tuer.");
  AddDetail(({"erlebnisse","erlebniss"}),
  "Sicher hat der Einsiedler einige Abenteuer erlebt.");
  AddDetail(({"abenteuer"}),
  "Du moechtest auch Abenteuer erleben, also steh hier nicht bloed rum!");
  AddDetail(({"tuer","tuere"}),
  "Welche Tuere meinst Du ? Die Baobabtuer ?");
  AddDetail(("baobab"),
  "Baobab ist eine sehr besondere Holzart des Dschungels.");
  AddDetail(({"holzart","art"}),
  "Sehr hart, trotzdem gut zu bearbeiten.");
    
  
  AddDetail(({"garten","vorgarten"}),
  "Der Garten ist draussen vor der Huette.");
  AddDetail(("holz"),
  "Die Staemme, aus denen die Huette gebaut wurde, sind aus hartem Holz hiesiger Baeume.");
  AddDetail(({"baum","baeume"}),
  "Die Baeume wurden gefaellt, also sind sie kaum mehr hier.");
  AddDetail(({"kammer","schlafkammer"}),
  "Erstaunlicherweise steht in der Schlafkammer ein Bett...");
  AddDetail(("osten"),
  "Im Osten liegt der Hauptraum des Zimmers.");
  AddDetail(("blockhuette"),
  "Die Blockhuette wurde aus groben Staemmen gezimmert und trotz hier schon "
  "viele Jahre dem Dschungel. Eine kleine Tuer fuehrt wieder hinaus in den "
  "Dschungel");
  
  AddDetail(("huette"),
  "Du stehst mitten in der Huette.");
  AddDetail(({"stamm","staemme"}),
  "Hartes Holz aus dem Dschungel hat man fuer diese Blockhuette verwendet.");  
  AddDetail(({"fenster"}),
  "Fenster gibt er hier keines.");
  AddDetail(("innere"),
  "Du befindest Dich im Inneren der Huette.");
  
  
  
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_HOUSE]) );
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Knarren der Huette.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Tabak, einem Hund, Schweiss, Fleisch...");
  
  
   NewDoor("osten", ("/d/dschungel/dante/fels/room/huette1"),
    ({"holztuer","baobabtuer"}),
     
      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED | DOOR_NEEDKEY,
        D_LONG, "Die Baobabtuer ist klein und niedrig.\n",
         D_GENDER, FEMALE,
          D_SHORT, "Eine %se Baobabtuer.",
           D_NAME, "Baobatuer",
            } ));
  
  AddSpecialDetail(({"spinne"}), "d_attack");
  
  AddSpecialDetail(({"ding"}), "xding");
  
  AddSpecialDetail(({"sache"}), "xsache");
  
  AddCmd(({"oeffne"}), "xoeffne");
  AddCmd(({"schliess","schliesse"}),"xschliess");
  AddCmd(({"hole"}), "xnimm");//absichlich hole!!!
  
  AddCmd(({"brich","breche"}), "xbreak");
  AddCmd(({"nimm","nehme"}), "xget");
    
 spind=zu;
 ding=da;
 
 truhe=close;
 sache=hier;
             
}  


//truhe beginn

xbreak(str)
 {
 notify_fail( "Was willst Du aufbrechen?\n" );
  if( str=="truhe auf" )
   {
  if( truhe==close )
   {
   if(sache==da)
   {
  write(BS(
  "Du brichst mit aller Gewalt die Truhe auf und siehst darin ein Buch.") );
  say(BS(TP->name()+" macht sich an der Truhe zu schaffen.") );
  truhe=open;
  return 1;
  }
  write(BS("Du brichst die Truhe auf, sie ist aber leider leer."));
  return 1;
  }
  write(BS("Aber die Truhe ist doch schon augebrochen.") );
  return 1;
  }
  return 0;
  }

  xsache()
   {
    if( truhe==open )
     {
        return BS(
    "Das Buch liegt einfach in der Truhe.");
      }
      return 0;
     }

xget(str)
 {
  
    
  if( truhe==close )
   return 0; 
   notify_fail( "Was willst Du nehmen?\n" );
  
   
   if( str=="buch aus truhe" )
    {
    if( sache==hier )
     {
     CLONE(OBJ"ding4",TP );
   say(BS(TP->name()+" nimmt was aus der Truhe.") );
   write(BS("Du nimmst das Buch aus der Truhe.") );
   sache=nichtda;
   return 1;
   }
  write("Die Truhe ist doch leer.\n");
  return 1;
  }
   
  return 0;
  }
  

//beginn spind


xoeffne(str)
 {
 notify_fail( "Was willst Du oeffnen?\n" );
  if( str=="spind" )
   {
  if( spind==zu )
   {
   if(ding==da)
   {
  write(BS(
  "Du oeffnest den Spind und siehst eine Muenze darin liegen.") );
  say(BS(TP->name()+" oeffnet einen Spind. ") );
  spind=offen;
  return 1;
  }
  write(BS("Du oeffnest den Spind aber er ist leider leer."));
  return 1;
  }
  write(BS("Aber der Spind ist doch schon offen.") );
  return 1;
  }
  return 0;
  }
  
  xding()
   {
    if( spind==offen )
     {
        return BS(
    "Die Muenze liegt im Spind");
      }
      return 0;
     }
                                                                                                  

xnimm(str)
 {
  
    
  if( spind==zu )
   return 0; 
   notify_fail( "Was willst Du aus dem Spind holen?\n" );
  
   
   if( str=="muenze aus spind" )
    {
    if( ding==da )
     {
     CLONE(OBJ"ding3",TP );
   say(BS(TP->name()+" nimmt was aus dem Spind.") );
   write(BS("Du holst die Muenze aus dem Spind.") );
   ding=weg;
   return 1;
   }
  write("Der Spind ist doch leer.\n");
  return 1;
  }
   
  return 0;
  }


xschliess(str)
 {
  notify_fail( "Was willst Du schliessen?\n" );
  
    if( str=="spind" )
     {
        if( spind==zu )
         {
        write(BS(
        "Der Spind ist schon zu. ") );
         return 1;
         }
        write(BS(
       "Du schliesst den Spind. ") );
        say(BS(TP->name()+" schliesst den Spind. ") );
        spind=zu;
        return 1;
     }
   return 0;
   }
          

  string d_attack()
{
   object ob;
   write("Du starrst in die Spinnweben und...\n");
   ob = clone_object ("d/dschungel/dante/fels/npc/spinne3.lpc");
   ob->move(environment(TP), M_TPORT);
   return ("");
 
 }
 
 reset()
 {
 spind=zu;
 ding=da;//spind
 
 truhe=close;
 sache=hier;//truhe
 ::reset();
 }   
 
