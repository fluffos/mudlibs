// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int gold;
create()
{
  ::create();
  gold = 1;
  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du folgst dem kleinen Pfad und gelangst mitten ins wildeste Dickicht.\n"
  "Rings um Dich undurchdringbarer Dschungel, nur der Pfad gibt Dir einen "
  "Anhaltspunkt. Der Boden ist hier besonders weich und saftig.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(({"wurzel","wurzeln"}),
  "An einer der Wurzeln kannst du einen tiefen Riss sehen.\n");
  AddDetail(("riss"),
  "In diesen Riss kann man hineingreifen, aber ob das klug ist?\n");
  AddDetail(("boden"),
  "Der Boden ist hier mit Wurzeln uebersaeht.\n");
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein lautes Trommeln...");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Affen.");

  AddCmd(({"greifen", "greife", "greif"}), "greifen");
  
  AddItem( ({NPC_WEG"dztapir", NPC_WEG "dkoli", NPC_WEG "dkakadu",
             NPC "kroete2"}) , REFRESH_DESTRUCT);
  AddExit( "nordwesten", "./fels24");
  AddExit( "osten", "./fels47");
}
reset()
{
 gold=1;
 ::reset();
 }

int greifen ( string str )
{
  notify_fail("Wo willst Du hinein greifen?\n");
  if(str != "in riss") return 0;
  if (!gold) 
  { 
    write("Du greifst in den Riss und verspuerst einen stechenden Schmerz.\n");
    TP->reduce_hit_point(10+random(5));
    return 1;
  }
  write (BS("Du greifst in den Riss der Wurzel und findest einen schweren "
         "Gegenstand, den Du sofort einsteckst."));
  say (BS(CAP_TPN+" greift an einer Wurzel herum und findet etwas Glaenzendes, "
       "das "+TPP(WER)+ " sofort einsteckt."));
  CLONE(OBJ_STEIN"dgo", TP);
  gold--;
  return 1;
}
 
