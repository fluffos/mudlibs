// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Schlangengrube der Kannibalen" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich hier mitten in der Schlangengrube der Kannibalen. "
  "Die Reste der letzten Opfer liegen noch wild versrtreut am Boden herum "
  "und schon sollst Du die naechste Mahlzeit fuer die Schlangen, die ueberall "
  "hier auf Dich lauern sein. Verschwinde lieber schnell aus der Grube..."));
 
  AddDetail(("ort"),
  "Dieser Ort wird von den Kannibalen fuer ihre grausam Opferungen verwendet.");
  AddDetail(("opferung"),
  "Sie werfen dabei Gefangene in diese Schlangengrube.");
  
  AddDetail(({"gefangene","gefangener"}),
  "Unvorsichtige Abenteurer verlieren so oft zuerst ihr Fleisch und dann ihr Leben...");
  AddDetail(("leben"),
  "Auch Deines ist hier in Gefahr...");
  AddDetail(("gefahr"),
  "Die Gefahr lauert hier ueberall!");
  AddDetail(({"rituale","ritual"}),
  "Mehrmals im Jahr werfen sie ihre Gefangenen den Schlangen, Vipern, Nattern "
  "und Ottern zum Frasse vor.");
  AddDetail(("frasse"),
  "Grausam und brutal zerfetzen die Schlangen ihre Opfer.");
  AddDetail(({"schlange","schlangen","vipern","viper","natter","nattern"}),
  "Sie kriechen immer naeher an Dich heran...");
  AddDetail(({"otter","ottern"}),
  "Eine Hoellenotter hat es besonders auf Dich abgesehen..");
  AddDetail(({"wand"," waende"}),
  "Die Waende bestehen aud glattem Lehm, und sind ziemlich hoch. An der Suedwand "
  "faellt Dir ein merkwuerdiges Symbol auf.");
  AddDetail("symbol",
  "Das Symbol zeigt einen Mungo.");
  AddDetail("mungo",
  "Der Mungo hat sein Maul aufgerissen und Du bist froh, dass Du keine "
  "Schlange bist.");
  AddDetail("schlange",
  "Scheint grad keine hier zu sein, Dein Glueck.");
  AddDetail("maul",
  "Das Maul ist weit offen. Die Zaehne blinken Dich an.");
  AddDetail(({"zahn","zaehne"}),
  "Die Zaehne sehen verdammt gefaehrlich aus. Einer der Zaehne faellt "
  "Dir besonders auf. Es ist ein Reisszahn.");
  AddDetail("reisszahn",
  "Er scheint faul zu sein. Eklig. Karies scheint ihn zu zerfressen.");
  AddDetail("karies",
  "Hmm, was macht man mit so einem Zahn!?");  
  AddDetail(("lehm"),
  "Der Lehm weist hier viele Kratzer und Loecher auf.");
  AddDetail(({"kratzer"}),
  "Doe Verzweifelten Opfer versuchen hier noch einmal ihr Leben zu retten.");
  AddDetail(({"loecher","loch"}),
  "Bei diesen Loechern in der Wand kann man vielleicht aus der Grube klettern... ");
  AddDetail(("gott"),
  "Dein Gott kann Dir hier auh nicht mehr weiterhelfen... ");
  AddDetail(("schlangengott"),
  "Dem Schlangengott wirst Du gerade geopfert.");
  AddDetail(("opfer"),
  "Unbewaffnet werden sie in die Schlangengrube geworfen, um dort unten "
  "einen qualvollen, aber sicheren Tod zu finden.");
  
  AddDetail(("zischen"),
  "Die Schlangen kommen immer naeher...");
  AddDetail(("klappern"),
  "War da nicht eben eine grosse Klapperschlange hinter Dir...");
  AddDetail(("grube"),
  "Du stehst mitten in der Schlangegrube...");
  AddDetail(("kannibalen"),
  "Die Kannibalen werfen, wenn sie satt sind manchmal wehrlose Opfer "
  "in diese Grube. Pass bloss auf, dass sie Dich hier nicht finden...");
  AddDetail(("schlangengrube"),
  "Wehrlose Opfer werden hier dem Schlangengott geopfert...");
AddDetail(("dschungel"),
"Aus der Grube heraus kannst Du nur mehr die Geraeusche des Dschungels hoeren..."); 
AddDetail(("boden"),
"Der Boden ist mit Sand bestreut und ueberall sieht man Blut und Leichenteile.");
AddDetail(("blut"),
"Langsam versiegt es im Boden...");
  AddDetail(("himmel"),
  "Der Himmel ist strahlendblau. Ein schoener Tag zum Sterben...");
  AddDetail(({"teil","teile","leichenteile","leichenteil"}),
  "Hat sich da nicht eben einer noch bewegt...");
   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die wuetenden Schlangen zischen...");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Verwesung.");
  
  AddItem(OBJ"dun", REFRESH_REMOVE);
  
  AddItem(NPC_WEG"dkobra", REFRESH_DESTRUCT);
  AddItem(NPC_WEG"dschlange", REFRESH_DESTRUCT);
  AddItem(NPC_HOEHLE"dviper", REFRESH_DESTRUCT);
  AddCmd(({"kletter","klettere","steig"}), "klettern");
  AddCmd(({"bohre","bohr"}), "get"); 
   
   
  AddCmd(({"ziehe","zieh","reiss","reisse"}),"pull"); 
   
   AddExit("nordwesten","./grube3");
  AddExit( "nordosten", "./grube1");
  AddExit( "norden", "./grube");
}



int get(string str)
   {
   notify_fail("Wo und womit willst du bohren!\n");
   if (!str) return 0;
      if(  (member(({"in zahn", "auf zahn","zahn"}),
        str) !=-1) && (present("bohr", TP)))
              {
        write("Du bohrst mit Deinem Bohrer am faulen Reisszahn herum und ploetzlich "
          "saugt Dich eine geheime Macht, gennant rekursiver Mundgeruch, in das "
          "Maul des Mungos. Eklig!\n");
          TP->move("/d/dschungel/dante/fels/room/maul.lpc", M_GO,
          "durch das Maul des Mungo gesaugt", "wird",
          "wird von draussen reingesaugt");
          return 1;
          }
          
             
         
     if(  (member(({"in zahn", "auf zahn","zahn"}),
        str) !=-1) && (!present("bohr", TP)))
        {
        
       write("Du bohrst mit Deinen Fingern am Reisszahn herum, "
       "das einzige das passiert ist, dass Du Dir Deinen Finger abschneidest.\n");
       TP->do_damage(10);
       say(""+TPN+" schneidet sich einen Finger ab.\n");
       return 1;
       }
   //hier muss eben der finger gecloned werden und abgefragt ob finger wg usw.
   return 0;
   }
           

  pull(string str)
    {
    notify_fail("Woran willst Du hier reissen?\n");
    if(!str) return 0;
    
    if (str=="an zahn" || str =="zahn" || str=="reisszahn" || str =="an reisszahn")
          {
          write("Du reisst am Reisszahn herum, aber es passiert nichts.\n");
          say(""+TPN+" reisst an den Zaehnen herum.\n");
          return 1;
          }
          return 0;
          }
          


int klettern(string str)
{
notify_fail ("Wohin willst Du hinklettern ?\n");
if ( !str) 
return 0;

if ( member ( ({"raus","nach draussen","nach oben","aus grube","aus schlangengrube"}), str) !=-1 )
{
write
( " \n"
"Du versuchst verzweifelt an der glatten Lehmwand aus der Grube zu klettern, rutscht aber immer wieder ab...\n");
say(""+TPN+" versucht aus der Grube zu klettern, rutscht an der glatten lehmwand aber immer wieder ab.\n");

return 1;
}
return 0;
}
