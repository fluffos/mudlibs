// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich am noerdlichen Rand des kleinen Felsplateaus. Hohe\n"
  "Pflanzen umgeben Dich, doch scheint der Dschungel hier nicht so dicht\n"
  "wie an anderen Stellen zu sein. Ein kleiner Trampelpfad fuehrt weiter\n"
  "nach Nordosten in das Dickicht.\n"));
  
  AddDetail( ({"boden"}),
    "Der Boden ist felsig.");
  AddDetail(("rand"),
    "Das Plateau endet hier an steil abfallenden Haengen.\n");
  AddDetail(({"haenge","haengen","hang"}),
  "Keine Chance hier runter zu kommen!\n");
  AddDetail(({"pflanze","pflanzen"}),
  "Die Vegetation hier ist nahezu ueberwaeltigend.\n");
  AddDetail(({"stelle","stellen"}),
  "Dieser Ort gefaellt Dir eigentlich sehr gut.\n");
  AddDetail(({"pfad","trampelpfad"}),
  "Irgendetwas schweres muss hier des oefteren umher laufen.\n");
  AddDetail(("dickicht"),
  "Von hier aus kann man ausser gruen kaum etwas erkennen. Du musst schon\n"
  "weiter gehen.\n");
  
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block", "felsen", "tafelberg"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","felsplateau", "insel", "hochplateau"}),
  "Du stehst am Rande eines kleinen Hochplateaus, einer Insel inmitten des\n"
  "ewigen Gruens...\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedich durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Die Vegetation scheint doch etwas anders als am Boden zu sein...\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein lautes trommelartiges Geraeusch...");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riechts nach Affen...");

  AddItem( ({NPC_WEG"dfrosch2", NPC "kroete2"}) , REFRESH_DESTRUCT);
  AddExit( "sueden", "./fels1");
  AddExit( "westen", "./fels4");
  AddExit( "nordosten", "./fels8");
}
