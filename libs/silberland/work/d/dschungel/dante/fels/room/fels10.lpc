// a, felsen by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor dem Felstor" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun vor den beiden Steinen. Sie ragen einige Meter in die Hoehe\n"
  "und symbolisieren scheinbar ein Tor. Auf beiden Steinen kannst Du einge\n"
  "meiselte Schriftzeichen erkennen. Was ginter dem Tor liegt, kannst Du von\n"
  "hier nicht erkennen, da der Weg scharf abbiegt.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({"meter","hoehe"}),
    "Die beiden Steine muessen von jemanden so aufgestellt worden sein. Du \n"
    "fragst Dich nach dem Sinn?\n");
  AddDetail(("tor"),
  "Zwischen den beiden Steinen kann man muehelos hindurchgehen, wie eben \n"
  "durch ein Tor.\n");
  AddDetail(("weg"),
  "Der Weg biegt gleich nach dem Steintor nach Suedwesten ab. Was dich da \n"
  "wohl erwartet?\n");
  AddDetail(({"steine","stein"}),
  "Zwei hohe Granitbloecke wurden hier von irgendjemanden aufgestellt.\n");
  AddDetail(({"zeichen","schriftzeichen"}),
  "Leider kannst Du keines dieser Zeichen deuten. Aber Dir schwant nichts\n"
  "gutes....\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst am Rande eines kleinen Hochplateaus, einer Insel inmitten des\n"
  "ewigen Gruens...\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedich durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Die Vegetation scheint doch etwas anders als am Boden zu sein...\n");
  AddDetail(("vegetation"),
  "Dieser Teil des Plateaus ist nicht so dicht bewachsen. Irgendwie schaut er\n"
  "gerodet aus.\n");
  AddDetail("himmel",
  "Der Himmel ist strahlenblau.");
  AddDetail("sinn",
  "Muss immer alles einen Sinn haben?");
  AddDetail("boden",
  "Der Boden scheint ziemlich oft begangen zu werden.");
  AddDetail("steintor",
  "Naja, richtiges Tor ist es ja keines, nur bene zwei Steine.");
  AddDetail(({"block","bloecke","granitbloecke","granitblock"}),
  "Gewaltige Steine bilden ein Steintor.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst kehlige Laute von hinter dem Tor.");
    
  AddSmell( DEFAULT_SMELL,
    "Du glaubst Fleisch und Feuer riechen zu koennen.");

AddItem( ({NPC_WEG"dstechmuecke", NPC_WEG "dkoli", NPC_WEG "dmoskito"}),
     REFRESH_DESTRUCT);
  
  AddExit( "norden", "./fels5");
  AddExit( "suedwesten", "./fels11");
}
