// dante@SilberLand

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Grab" );
  SetProp( P_INT_LONG, BS(
    "Du steckst mitten in einem dunklen, duesteren Grab. Es ist dunkel und es riecht "
    "modrig. Ausser Erde ist hier kaum etwas zu erkennen.")); 
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({ "erde" }),
    "Ueber Dir, unter Dir, ueberall ist Erde...");
AddDetail(("grab"),
   "Du steckst sizusagen mitten zwischen den Toten.");
   AddDetail(({"tote","toter","toten"}),
   "Vielleicht kommt ja bald einer zu Dir.");
  AddDetail(("boden"),
  "Der Boden ist weich und modrig.");
  AddDetail(("wand"),
  "Die Waende sind wegen der Dunkelheit kaum zu erkennen.");
  AddDetail(("decke"),
  "Die Decke ist sehr niedrig. Man kann ein Loch erkennen.");
  AddDetail(("loch"),
  "Durch das Loch kommst du hier wieder hinaus.");
  AddSound( DEFAULT_SOUND,
    "Hier ist es totenstill.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Tod, Moder und Verwesung.");

  AddItem(NPC "dmumie" , REFRESH_DESTRUCT);

  AddExit( "raus", "./fels47" );
}
