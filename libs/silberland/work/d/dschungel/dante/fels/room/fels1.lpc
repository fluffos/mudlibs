// a, felsen by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>

int tiger;

create()
{
  ::create();
  tiger=1;

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun auf einem gewaltigen Felsblock, der hoch ueber den Boden "
  "des Dschungels empor ragt. Im Osten erhebt sich eine Felswand steil "
  "nach oben. Nur eine kleine Oeffnung scheint hier weiter zu fuehren. "
  "Nach Norden und Westen erstreckt sich ein kleines Hochplateau. Der "
  "Boden ist hier weich und saftig."));
  AddDetail(("boden"),
  "Der Boden weist grosse, tiefe Abdruecke auf...");
  AddDetail(({"abdruecke","abdruck"}),
  "Es scheint sich um die Spuren eines Tigers zu handeln...");
  AddDetail(({"spur","spuren"}),
  "Man kann die Tatzen eines Tigers deutlich erkennen.\n");
  AddDetail( ({"tiger"}),
    "Zum Glueck ist gerade kein Tiger da."); 
  AddSpecialDetail(({"tatze","tatzen"}), "d_tatze");
                                                    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({"felsblock","block", "tafelberg", "felsen"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel gegen die Korrosion behauptet.\n");
  AddDetail(({"oeffnung", "loch"}),
  "Das Loch im Fels scheint tief weiter hinein zu fuehren,\n");
  AddDetail(("osten"),
  "Im Osten erhebt sich eine hohe unbezwingbare Felswand.\n");
  AddDetail(({"fels","wand","felswand", "spitze"}),
  "Die Felswand fuehrt weiter nach oben auf die Spitze des Felsens. Wie man\n"
  "da wohl hinauf gelangen kann?\n");
  AddDetail(({"norden","westen"}),
  "Sowohl nach Norden als auch nach Westen kann man seinen Weg muehelos\n"
  " fortsetzen.\n");
  AddDetail(({"plateau","hochplateau", "insel"}),
  "Du stehst am Rande eines kleinen Hochplateaus, einer Insel inmitten des\n"
  "ewigen Gruens...\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedich durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Die Vegetation scheint doch etwas anders als am Boden zu sein...\n");
  AddDetail(("vegetation"),
  "Von der ist so nahe am Felsen wenig zu bemerken nur eine lange Liane\n"
  "haengt von oben die Felswand herab.\n");
  AddDetail(("liane"),
  "Die Liane ist alt und morsch...\n");
  AddDetail(({"blatt","blaetter"}),
  "Seltsam, auf einem der Blaetter steht 'Ac tung Mensc  nfre ss r'.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst des Gesang vieler verschiedener Voegel.");
    
  AddSmell( DEFAULT_SMELL,
    "Du glaubst irgendwelche Fruechte zu riechen.");


  AddItem(OBJ"dri" , REFRESH_REMOVE);
  
  AddExit( "norden", "./fels2");
  AddExit( "westen", "./fels3");
  AddExit( "osten", "/d/dschungel/dante/hoehle/room/hoehle7");
}

string d_tatze()
{
  object ob;
  if(tiger && !present("tiger") && !random(10) )
  {
    write( "Du betrachtest die Abdruecke im Boden genauer und ploetzlich...\n");
    ob = clone_object("/d/dschungel/dante/weg/npc/dtiger.lpc");
    ob->SetProp(P_MNPC_AREA, ("/d/dschungel/dante/fels/room/fels"));
    ob->SetProp(P_MNPC_DEFAULTROOM, ROOM "fels36");
    ob->move(environment(TP),M_TPORT);
    tiger=0;
    return "";
  }
  else
  {
    return BS(
      "Du betrachtest die Abdruecke im Boden genauer und stellst fest, dass "
      "vor kurzer Zeit ein Tiger hier war. Sei lieber vorsichtig!");
  }
}

void reset()
{
  ::reset();
  if( !random(5) ) tiger=1;
}

