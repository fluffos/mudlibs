// fels 5 mit quellee heilstelle  by dante 97

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

int wasser;

create()
{
  ::create();
  wasser=3+random(2);
  SetProp( P_INT_SHORT, "An einer Quelle" );
  SetProp( P_INT_LONG, 
  "Du stehst nun am westlichen Rand des kleinen Hochplateaus. Nahe an der "
  "steil abfallenden Boeschung siehst Du eine Quelle, die munter aus dem "
  "Boden hervorsprudelt und kleine Baeche die Haenge hinab schickt. Im "
  "Sueden erkennst Du zwei auffaellige, grosse Steine.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail("himmel",
  "Der Himmel ist strahlendblau, teilweise aber durch den dichten "
  "Dschungel verdeckt.");
  AddDetail(("quelle"),
  "Glucksend tritt das Wasser aus dem Erdreich...");
  AddDetail(({"erdreich","boden"}),
  "Der Boden ist hier sehr feucht und weich...");
  AddDetail( ({"hochplateau","rand","plateau"}),
    "Am westlichen Ende des Plateaus faellt der Fels steil nach unten ab. "
    "Obwohl er sehr dicht bewachsen ist, siehst Du keine Moeglichkeit "
    "nach unten zu gelangen.");
    
  AddDetail(({"sueden","stein","steine"}),
  "Von hier kannst du wenig erkennen, aber natuerlichen Ursprungs scheinen "
  "sie nicht zu sein...");
  AddDetail(("boeschung"),
  "Die Boeschung faellt fast senkrecht nacht unten ab. Runter kommst Du hier "
  "auf keinen Fall.");
  AddDetail(({"baeche","haenge","hang","bach"}),
  "Viele kleine Rinnsale sammeln sich auf dem Weg nach unten zu immer "
  "groesser werdenden Baechen.");
  AddDetail(({"fels","felsen"}),
  "Die Felsen fallen im Osten steil die Boeschung ab.");
  AddDetail("osten",
  "Im Osten endet der Fels jaeh.");
AddDetail("ursprung",
"Du wirst schon naeher ran gehen muessen.");
AddDetail("moeglichkeit",
"Keine!");  
  AddDetail(({"rinnsal","rinnsale"}),
  "Ein Rinnsal ist ein sehr kleiner Bach...\n");
  
  AddDetail("wasser", "Im Wasser kannst Du Dein eigenes Spiegelbild erkennen.");

  AddDetail(({"bild","spiegelbild"}),
  "Du erkennst wie Du Dich am koestlichen Nass labst...\n");
  
 
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedich durch den leichten "
  "Wind ertraeglicher gemacht.");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.");
  AddDetail(("dschungel"),
  "Die Vegetation scheint doch etwas anders als am Boden zu sein...");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.");
  
  AddSound( DEFAULT_SOUND,
    "Das Wasser gluckst uns plaetschert...");
    
  AddSmell( DEFAULT_SMELL,
    "Die Luft ist hier angenehm frisch...");


  AddItem( ({NPC_WEG"dkakadu", NPC_WEG "dkoli", NPC "kroete2", 
             NPC_WEG "dbiene", NPC_WEG "dstechmuecke", NPC_WEG "dmoskito"}), 
           REFRESH_DESTRUCT);
  
  AddExit( "norden", "./fels6");
  AddExit( "osten", "./fels3");
  AddExit( "sueden", "./fels10");

 AddCmd(({"trink", "trinke"}), "trinken");
}

reset()
 {
 ::reset();
 wasser=3+random(2);
 }



trinken (string str)
{
  notify_fail("Scheint wohl nicht zu funktionieren...\n");
   if( !str) return 0;
   if ( member( ({"wasser","von wasser","aus quelle","von quelle"}),str) !=-1 )
     {
       if(wasser)
	 {
         write(BS("Du trinkst einen koestlichen Schluck frisches Quellwasser.\n"));
         say(TPN+BS(" trinkt einen koestlichen Schluck Quellwasser."));
         this_player()->heal_self(35+random(10));                                                  
         wasser--;
                                                           
         return 1;
         
	 }
      write(BS("Du trinkst aber nix passiert.\n"));
      say (TPN+BS(" trinkt eine Schluck Wasser aber nix passiert.\n"));
    }
 return 0;
    }
  
    
