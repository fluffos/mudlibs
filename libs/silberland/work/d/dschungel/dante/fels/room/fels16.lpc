// ein felsvorsprung

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsvorsprung" );
  SetProp( P_INT_LONG, BS(
    "Vorsichtig balancierst Du auf dem aeussersten Rand des Felsvorsprungs\n"
    "und Dir wird ziemlich schwindlig als Du in den gaehnenden Abgrund blickst.\n"
    "Trotzdem hat man von hier oben eine sehr schoene Aussicht...\n"));
   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail(({"richtung","himmelsrichtung","richtungen","himmelsrichtungen"}),
  "Norden, Westen,...\n");
  
  AddDetail(("abgrund"),
  "Du scheinst nicht einmal bis zum Boden zu sehen..\n");
  AddDetail( ("boden"),
  "Den Boden kannst Du von hier oben nicht erkennen. Die vielen Pflanzen\n"
  "versperren Dir jegliche Sicht nach unten.\n");
  AddDetail(({"sicht","pflanzen"}),
  "Die vielen Schichten von Blaettern und Aesten machen es unmoeglich weit\n"
  " nach unten zu sehn.\n");
  AddDetail(("sonne"),
  "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich\n"
   "herab.\n");
  AddDetail(({"blaetter","ast","aeste","blaettern","aesten","pflanze","pflanzen"}),
   "Gruen, gruen, gruen, alles nur gruen...\n");
  AddDetail(("aussicht"),
   "Du erkennst von hier oben im Norden die Stadt Tijara, im Sueden glaubst\n"
   "Du eine breite Schlucht zu sehen und noch suedlicher ein Dorf.\n"
   "Im Westen erstreckt sich das Meer und nach Osten nichts als der gruene\n"
   "Dschungel so weit Dein Auge reicht.\n");   
  AddDetail(({"norden","stadt","tijara"}),
   "Du erkennst die Stadtmauer und das Suedtor, aber sonst nichts.\n");
  AddDetail(({"westen","meer"}),
   "Blau, blau und unendlich weit...\n");
  AddDetail(({"sueden","schlucht"}),
   "Der Pfad scheint direkt zur Schlucht und noch weiter zu fuehren.\n");
  AddDetail(("dorf"),
   "Wer wohl in dem Dorf wohnen mag?\n");
  AddDetail(({"dschungel","osten"}),
   "Bis zum Horizont kannst Du nur den scheinbar unendlich grossen Dschungel\n"
 "erblicken.\n");
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Pfeifen des Windes...");
    
  AddSmell( DEFAULT_SMELL,
    "AHH! Hier ist die Luft schon viel besser!");

  AddRoomMessage( 
    ({"Der Wind pfeifft um Deine Ohren...\n",
      "Spring hier lieber nicht runter!\n",
      "Die Sonne brennt erbarmunglos auf Dich herab.\n"
      "Hier geht es verdammt weit nach unten!\n",
      "Eine innere Stimme warnt Dich...\n",
      "Du taumelst gefaehrlich nahe am Abgrund...\n",
      "Dir wird schwindlig...\n"}),45 );
 
 AddItem(OBJ"dmango", REFRESH_REMOVE);
 AddItem(OBJ"dmilz" , REFRESH_REMOVE);
 AddItem( ({NPC_WEG"dkoli", NPC_WEG "dkakadu", NPC_WEG "dbiene"}), REFRESH_DESTRUCT);
 
 AddExit( "westen", "./fels15");
 
 AddCmd(( {"spring", "springe"}), "springen");
     
  
}

 int springen(string str )
{
  notify_fail( "Wohin willst Du ?\n" );
  if( !str ) return 0; 
  if( member( ({"unten", "nach unten", "runter", "hinunter", "zu boden",
                "hinab", "in abgrund", "in dschungel"}),str) !=-1 )
    
    {
    write("    AAAA...\n"
          "         AAAA...\n"  
          "               AAAA...\n"
          "                     AAAA...\n"
          "                           AAHH...\n"
          "                                    \n"
          "                                    \n"
          "                                    \n"
          "                                        PLAAATTTSCHHHH....\n"); 
    
    
    
    TP->move("/d/dschungel/dante/weg/room/tuempel2", M_GO, "in die Tiefe.","springt",
    "stuerzt von oben herab genau vor Deine Beine.");
    SetProp(P_KILL_NAME, "Ein gewagter Sprung");  
    TP->do_damage(20+random(10));
    
    return 1;
    
    }
    return 0;
    }
    
      
