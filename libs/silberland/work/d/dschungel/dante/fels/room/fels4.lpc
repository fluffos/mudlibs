// a, felsen by dante 97

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <wizlevels.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Rand des Hochplateaus" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun mitten im dichtesten Dschungel des Plateaus. Vor Dir,\n"
  "hinter Dir, ueberall bist Du von Pflanzen umgeben. Sie wuchern so dicht,\n"
  "dass Du den Boden kaum erkennen kannst auf dem Du stehst. Auch den Himmel\n"
  "und die Sonne kann man durch das dichte Blaetterdach kaum mehr sehen.\n"));

  AddDetail(({"pflanzen","pflanze"}),
  "Bunte, grosse Baeume ragen in den Himmel. Farne kitzeln Dich und exotisch\n"
  "anmutende Blumen erfreuen Dein Herz.\n");
  AddDetail(({"baeume","baum"}),
  "Du kannst an den Baeumen nicht aussergewoehnliches erkennen.\n");
  AddDetail(({"farn","farne"}),
  "Die Farne ueberragen Dich um einiges.\n");
  AddDetail(({"blumen","blume"}),
  "Sie duften wunderbar...\n");
  AddDetail(("himmel"),
  "Er scheint blau und voellig klar zu sein.\n");
  AddDetail(("sonne"),
  "Die Sonne schickt ihre waermenden Strahlen auf die Erde, doch hier dringen\n"
  "nur sehr wenige ein.\n");
  AddDetail(({"blaetterdach","dach"}),
  "Die vielen Pflanzen bilden beinahe ein Dach ueber Deinen Kopf.\n");
  AddDetail(({"blatt","blaetter"}),
  "Zaehl sie bitte fuer mich ab...\n");
  AddDetail(("boden"),
  "Der Boden scheint trocken aber weich zu sein.\n");
  AddDetail(({"strahl","strahlen","sonnenstrahlen","sonnenstrahl"}),
 "Die Sonnenstrahlen fallen durch das dichte Blaetterdach auf den Boden und\n"
 "bilden merkwuerdigerweise einen kleinen Kreis auf der Erde.\n");
 AddDetail(("kreis"),
 "Dieser Kreis ist von einem Druiden hier angelegt worden. Welche Bedeutung\n"
 "mag er wohl haben? Im Moment leider noch keine aber bald...\n");
 AddDetail(({"druide","druiden"}),
 "Der ist schon lange nicht mehr hier...\n");
 
  AddDetail(({"plateau","hochplateau"}),
  "Das kleine, verborgen gelegene Plateau ist eine stille Idylle im sonst so"
  "feindlichen Urwald.\n");
  AddDetail(("urwald"),
  "Der Dschungel hier scheint voellig unberuehrt zu sein.\n");
  
  
  SetProp( P_LIGHT, 1 );
  
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  
  AddSound( DEFAULT_SOUND,
    "Du hoerst des Gesang vieler verschiedener Voegel.");
    
  AddSmell( DEFAULT_SMELL,
    "AHHH!!!Herrlich diese gute Luft...");

  AddItem( ({NPC_WEG"darcheo", NPC_WEG "dkakadu", NPC_WEG "dkoli",
             NPC_WEG "dkobra"}), REFRESH_DESTRUCT);
  
  AddExit( "westen", "./fels6");
  AddExit( "osten", "./fels2");

// AddCmd( ({"betrete", "betritt"}), "tele");


}

 int tele(string str)
 {
 notify_fail("Was willst Du hier machen?\n");
 if( !str ) return 0;
 if( member( ({"kreis", "druidenkreis"}),str) !=-1 )
 {
  if(!IS_SEER(TP))
  {
    write("Du hast nicht die noetige Erfahrung im Umgang mit Druidenkreisen.\n");
    return 1;
  }
  write(" \n"
  
         "Du betrittst den Druidenkreis und Dir schwinden fuer kurze Zeit die Sinne.\n"
         "Du erwachst etwas verwirrt in einer neuen Umgebung...                      \n"
         "  \n");
  TP->move("/d/dschungel/dante/geist/room/geist1",M_NO_SHOW + M_GO, "sich vor Deinen Augen",
  "dematerialisiert", "materialisiert sich vor Deinen Augen.");
 
  TP->restore_spell_points(-10)-random(10);
  return 1;
  }
  return 0;
  }
          
